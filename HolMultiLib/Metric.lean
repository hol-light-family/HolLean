/- Imbedding in a locally connected continuum.  (metric.ml 37774-38000)      -/
/- ------------------------------------------------------------------------- -/

structure IMB where
  MCOMPLETE_IMBEDDING_IN_LC_CONTINUUM : thm
  MCOMPLETE_IMBEDDING_IN_LC_CONTINUUM_IN : thm
  deriving Inhabited

@[nospecialize]
def setupIMB [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BCompact1 : Compact1) (BCompact3 : Compact3)
    (BHausdorff1 : Hausdorff1) (BHausdorff2 : Hausdorff2) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricHaus : MetricHaus) (BConnected1 : Connected1)
    (BConnected3 : Connected3) (BRealTop1 : RealTop1) (BRealTop2 : RealTop2)
    (BRealConn1 : RealConn1) (BLC1 : LC1) (BLC2 : LC2) (BUC1 : UC1) (BCC2 : CC2) (BCE3 : CE3)
    (BSLC3 : SLC3) (BMDA : MDA) : ExceptT String IO IMB := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH_TAC, REAL_FIELD, SET_RULE,
        SET_TAC, NUM_REDUCE_CONV, .. } := D
  let { ARITH_EQ, EXP_ADD, FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIV, LE_0, LE_CASES, LE_MULT_LCANCEL,
        LE_REFL, LE_TRANS, MONO_EXISTS, .. } := D.core2
  let { REAL_ABS_SUB, REAL_ARCH_POW_INV, REAL_LT_POW2, REAL_LT_TRANS, REAL_OF_NUM_EQ,
        REAL_OF_NUM_MUL, REAL_OF_NUM_POW, REAL_POW_INV, REAL_POW_SUB, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, .. } := D.core4
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := BContMap1
  let { CONTINUOUS_MAP_INTO_SUBTOPOLOGY, .. } := BContMap2
  let { COMPACT_IN_SUBTOPOLOGY, COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { CONTINUOUS_IMP_QUOTIENT_MAP, .. } := BHausdorff2
  let { SUBMETRIC, .. } := BMetricSpace
  let { MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { CONNECTED_IN_SUBSET_TOPSPACE, CONNECTED_IN_SUBTOPOLOGY, connected_in, .. } :=
    BConnected1
  let { CONNECTED_IN_CONTINUOUS_MAP_IMAGE, .. } := BConnected3
  let { TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { COMPACT_IN_EUCLIDEANREAL_INTERVAL, CONNECTED_IN_EUCLIDEANREAL_INTERVAL, .. } :=
    BRealConn1
  let { LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE, .. } := BLC1
  let { LOCALLY_CONNECTED_REAL_INTERVAL, .. } := BLC2
  let { uniformly_continuous_map, .. } := BUC1
  let { UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP, .. } := BCC2
  let { UNIFORMLY_CONTINUOUS_MAP_EXTENDS_TO_CLOSURE_OF, .. } := BCE3
  let { CLOSURE_OF_DYADIC_RATIONALS_IN_UNIT_INTERVAL, .. } := BSLC3
  let { MCOMPLETE_DYADIC_APPROXIMATION, .. } := BMDA
  -- @@SCOPE END

  -- Imbedding Theorem: Whyburn, Analytic Topology, Theorem (4.2).
  -- In a complete, connected, locally connected metric space, any two points
  -- are contained in a locally connected continuum (compact connected locally
  -- connected subset). Build a uniformly continuous function on dyadics via
  -- the chain construction, extend to [0,1] by completeness, and observe
  -- that the image is compact, connected, and locally connected.

  let MCOMPLETE_IMBEDDING_IN_LC_CONTINUUM ← do
    let DYADIC_PRECISION_RAISE ← prove
     r"!k n n'. n <= n' /\ k <= 2 EXP n
              ==> 2 EXP (n' - n) * k <= 2 EXP n' /\
                  &(2 EXP (n' - n) * k) / &2 pow n' =
                  &k / &2 pow n"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN CONJ_TAC THENL
       [TRANS_TAC LE_TRANS (← q r"2 EXP (n' - n) * 2 EXP n") THEN
        ASM_REWRITE_TAC [LE_MULT_LCANCEL, ← GSYM EXP_ADD] THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q
          r"n <= n' ==> (n' - n) + n = n':num"), LE_REFL],
        REWRITE_TAC [← GSYM REAL_OF_NUM_MUL,
                     ← GSYM REAL_OF_NUM_POW] THEN
        ASM_SIMP_TAC [REAL_POW_SUB,
                      REAL_OF_NUM_EQ, ARITH_EQ] THEN
        SIMP_TAC [REAL_LT_POW2, ← REAL_FIELD (← q
         r"&0 < a /\ &0 < b
          ==> (a / b * m) / a = m / b")]])
    prove
     r"!m:A metric a b.
        mcomplete m /\
        connected_space (mtopology m) /\
        locally_connected_space (mtopology m) /\
        a IN mspace m /\
        b IN mspace m
        ==> ?K. compact_in (mtopology m) K /\
                connected_in (mtopology m) K /\
                locally_connected_space
                  (subtopology (mtopology m) K) /\
                a IN K /\ b IN K"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      /- Build uniformly continuous f on dyadics -/
      SUBGOAL_THEN (← q r"?f:real->A.
        f(&0) = a /\ f(&1) = b /\
        (!x. x IN {&k / &2 pow n | k <= 2 EXP n} ==> f x IN mspace m) /\
        uniformly_continuous_map
          (submetric real_euclidean_metric {&k / &2 pow n | k <= 2 EXP n},
           m) f")
      STRIP_ASSUME_TAC THENL
       [SUBGOAL_THEN (← q r"?f:real->A. f(&0) = a /\ f(&1) = b /\
          (!m' n. m' <= 2 EXP n ==> f(&m' / &2 pow n) IN mspace m) /\
          (!j. ?d. &0 < d /\
            !n m1 m2. m1 <= 2 EXP n /\ m2 <= 2 EXP n /\
              abs(&m1 / &2 pow n - &m2 / &2 pow n) < d
              ==> mdist m (f(&m1 / &2 pow n),f(&m2 / &2 pow n):A)
                   < inv(&2 pow j))")
        STRIP_ASSUME_TAC THENL
         [MATCH_MP_TAC MCOMPLETE_DYADIC_APPROXIMATION THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        EXISTS_TAC (← q r"f:real->A") THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL [ASM_REWRITE_TAC [FORALL_IN_GSPEC], ALL_TAC] THEN
        REWRITE_TAC [uniformly_continuous_map, SUBMETRIC,
                     REAL_EUCLIDEAN_METRIC, IN_INTER, IN_UNIV] THEN
        CONJ_TAC THENL
         [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTER, IN_UNIV] THEN
          ASM_REWRITE_TAC [FORALL_IN_GSPEC], ALL_TAC] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
        REWRITE_TAC [REAL_POW_INV] THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"j:num")) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [IN_INTER, IN_UNIV, IMP_CONJ,
                     RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
        MAP_EVERY X_GEN_TAC [← q r"k1:num", ← q r"n1:num"] THEN DISCH_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"k2:num", ← q r"n2:num"] THEN
        DISCH_TAC THEN DISCH_TAC THEN
        TRANS_TAC REAL_LT_TRANS (← q r"inv(&2 pow j)") THEN ASM_REWRITE_TAC [] THEN
        DISJ_CASES_TAC (← SPECL [← q r"n1:num", ← q r"n2:num"] LE_CASES) THENL
         [FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"n2:num", ← q r"k2:num", ← q r"2 EXP (n2 - n1) * k1"]) THEN
          SUBGOAL_THEN (← q r"&(2 EXP (n2 - n1) * k1) / &2 pow n2 =
                         &k1 / &2 pow n1")
            (fun th => REWRITE_TAC [th]) THENL
           [ASM_MESON_TAC [DYADIC_PRECISION_RAISE], ALL_TAC] THEN
          DISCH_THEN MATCH_MP_TAC THEN REPEAT CONJ_TAC THENL
           [ASM_REWRITE_TAC [],
            ASM_MESON_TAC [DYADIC_PRECISION_RAISE],
            ONCE_REWRITE_TAC [REAL_ABS_SUB] THEN ASM_REWRITE_TAC []],
          FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"n1:num", ← q r"2 EXP (n1 - n2) * k2", ← q r"k1:num"]) THEN
          SUBGOAL_THEN (← q r"&(2 EXP (n1 - n2) * k2) / &2 pow n1 =
                         &k2 / &2 pow n2")
            (fun th => REWRITE_TAC [th]) THENL
           [ASM_MESON_TAC [DYADIC_PRECISION_RAISE], ALL_TAC] THEN
          DISCH_THEN MATCH_MP_TAC THEN REPEAT CONJ_TAC THENL
           [ASM_MESON_TAC [DYADIC_PRECISION_RAISE],
            ASM_REWRITE_TAC [],
            ONCE_REWRITE_TAC [REAL_ABS_SUB] THEN ASM_REWRITE_TAC []]],
        ALL_TAC] THEN
      /- Extend f to g on [0,1] using mcomplete -/
      MP_TAC (← ISPECL [← q r"real_euclidean_metric", ← q r"m:A metric",
                        ← q r"f:real->A", ← q r"{&k / &2 pow n | k <= 2 EXP n}"]
        UNIFORMLY_CONTINUOUS_MAP_EXTENDS_TO_CLOSURE_OF) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      REWRITE_TAC [MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
                   CLOSURE_OF_DYADIC_RATIONALS_IN_UNIT_INTERVAL] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->A") STRIP_ASSUME_TAC) THEN
      /- K = IMAGE g [0,1] is our locally connected continuum -/
      EXISTS_TAC (← q r"IMAGE (g:real->A) (real_interval[&0,&1])") THEN
      ABBREV_TAC (← q r"sub = subtopology euclideanreal
                          (real_interval[&0:real,&1])") THEN
      SUBGOAL_THEN (← q r"continuous_map (sub,mtopology m) (g:real->A)")
        ASSUME_TAC THENL
       [EXPAND_TAC "sub" THEN
        REWRITE_TAC [← GSYM MTOPOLOGY_SUBMETRIC,
                     ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
        MATCH_MP_TAC UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"topspace (sub:real topology) = real_interval[&0:real,&1]")
        ASSUME_TAC THENL
       [EXPAND_TAC "sub" THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"IMAGE (g:real->A) (real_interval[&0,&1]) SUBSET mspace m")
        ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP
          CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
        ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
      REPEAT CONJ_TAC THENL
       [/- compact: continuous image of compact -/
        MATCH_MP_TAC IMAGE_COMPACT_IN THEN
        EXISTS_TAC (← q r"sub:real topology") THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "sub" THEN
        REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY,
                     COMPACT_IN_EUCLIDEANREAL_INTERVAL, SUBSET_REFL],
        /- connected: continuous image of connected -/
        MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
        EXISTS_TAC (← q r"sub:real topology") THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "sub" THEN
        REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY,
                     CONNECTED_IN_EUCLIDEANREAL_INTERVAL, SUBSET_REFL],
        /- locally connected: quotient image of LC -/
        SUBGOAL_THEN (← q r"locally_connected_space (sub:real topology)")
          ASSUME_TAC THENL
         [EXPAND_TAC "sub" THEN
          REWRITE_TAC [LOCALLY_CONNECTED_REAL_INTERVAL], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"compact_space (sub:real topology)") ASSUME_TAC THENL
         [EXPAND_TAC "sub" THEN MATCH_MP_TAC COMPACT_SPACE_SUBTOPOLOGY THEN
          REWRITE_TAC [COMPACT_IN_EUCLIDEANREAL_INTERVAL], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"quotient_map(sub,
          subtopology (mtopology m)
            (IMAGE (g:real->A) (real_interval[&0,&1]))) g")
          ASSUME_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_IMP_QUOTIENT_MAP THEN
          ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
           [MATCH_MP_TAC HAUSDORFF_SPACE_SUBTOPOLOGY THEN
            REWRITE_TAC [HAUSDORFF_SPACE_MTOPOLOGY],
            MATCH_MP_TAC CONTINUOUS_MAP_INTO_SUBTOPOLOGY THEN
            ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [SUBSET_REFL],
            ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN
            ASM SET_TAC []], ALL_TAC] THEN
        MATCH_MP_TAC (← ISPECL
         [← q r"sub:real topology",
          ← q r"subtopology (mtopology (m:A metric))
            (IMAGE (g:real->A) (real_interval[&0,&1]))",
          ← q r"g:real->A"]
          LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE) THEN
        ASM_REWRITE_TAC [],
        /- a IN IMAGE g [0,1] -/
        REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"&0") THEN CONJ_TAC THENL
         [SUBGOAL_THEN (← q r"(g:real->A)(&0) = f(&0)") SUBST1_TAC THENL
           [FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
            MAP_EVERY EXISTS_TAC [← q r"0", ← q r"0"] THEN
            REWRITE_TAC [LE_0] THEN REAL_ARITH_TAC,
            ASM_REWRITE_TAC []],
          REWRITE_TAC [IN_REAL_INTERVAL] THEN REAL_ARITH_TAC],
        /- b IN IMAGE g [0,1] -/
        REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"&1") THEN CONJ_TAC THENL
         [SUBGOAL_THEN (← q r"(g:real->A)(&1) = f(&1)") SUBST1_TAC THENL
           [FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
            MAP_EVERY EXISTS_TAC [← q r"1", ← q r"0"] THEN
            CONV_TAC NUM_REDUCE_CONV THEN REAL_ARITH_TAC,
            ASM_REWRITE_TAC []],
          REWRITE_TAC [IN_REAL_INTERVAL] THEN REAL_ARITH_TAC]])

  -- Localized version: imbedding theorem for a complete
  -- metric subspace.

  let MCOMPLETE_IMBEDDING_IN_LC_CONTINUUM_IN ← prove
   r"!m:A metric s a b.
        mcomplete(submetric m s) /\
        connected_in (mtopology m) s /\
        locally_connected_space (subtopology (mtopology m) s) /\
        a IN s /\ b IN s
        ==> ?K. compact_in (mtopology m) K /\
                connected_in (mtopology m) K /\
                locally_connected_space
                  (subtopology (mtopology m) K) /\
                K SUBSET s /\ a IN K /\ b IN K"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(s:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [CONNECTED_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(a:A) IN mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(b:A) IN mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"submetric m (s:A->bool)", ← q r"a:A", ← q r"b:A"]
      MCOMPLETE_IMBEDDING_IN_LC_CONTINUUM) THEN
    ASM_SIMP_TAC [MTOPOLOGY_SUBMETRIC,
      ← SET_RULE (← q r"s SUBSET t ==> t INTER s = (s:A->bool)"),
      SUBMETRIC, IN_INTER] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [connected_in], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"K:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"K:A->bool") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"(K:A->bool) SUBSET s") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_SUBTOPOLOGY], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_SUBTOPOLOGY],
      ASM_MESON_TAC [CONNECTED_IN_SUBTOPOLOGY],
      SUBGOAL_THEN (← q r"s INTER (K:A->bool) = K")
        (fun eq_th =>
          FIRST_X_ASSUM (ACCEPT_TAC o
            REWRITE_RULE [SUBTOPOLOGY_SUBTOPOLOGY, eq_th])) THEN
      ASM SET_TAC []])

  return { MCOMPLETE_IMBEDDING_IN_LC_CONTINUUM, MCOMPLETE_IMBEDDING_IN_LC_CONTINUUM_IN }

/- ------------------------------------------------------------------------- -/
/- "Capped" equivalent bounded metrics and general product metrics.          -/
/- (metric.ml 38002-38146)                                                    -/
/- ------------------------------------------------------------------------- -/

structure CAP where
  capped_metric : thm
  CAPPED_METRIC : thm
  MDIST_CAPPED : thm
  MTOPOLOGY_CAPPED_METRIC : thm
  CAUCHY_IN_CAPPED_METRIC : thm
  MCOMPLETE_CAPPED_METRIC : thm
  BOUNDED_EQUIVALENT_METRIC : thm
  SUP_METRIC_CARTESIAN_PRODUCT : thm
  deriving Inhabited

@[nospecialize]
def setupCAP [HolBase] (D : MetricDeps) (BTopology : Topology) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricArith : MetricArithB) (BCauchy1 : Cauchy1) :
    ExceptT String IO CAP := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D
  let { CARTESIAN_PRODUCT_EQ_MEMBERS_EQ, ELEMENT_LE_SUP, ETA_AX, EXISTS_IN_GSPEC,
        FORALL_IN_GSPEC, FUN_EQ_THM, .. } := D.core1
  let { IN_ELIM_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { REAL_LE_ADD2, REAL_LE_ANTISYM, REAL_LE_SUP, REAL_LE_TRANS, REAL_LT_MIN, REAL_MIN_LT,
        REAL_NOT_LE, REAL_NOT_LT, .. } := D.core3
  let { REAL_SUP_LE_EQ, SUBSET, cartesian_product, o_DEF, o_THM, .. } := D.core4
  let { PAIRED_ETA_THM, PAIR_EQ, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { TOPOLOGY_EQ, .. } := BTopology
  let { IN_MBALL, MDIST_0, MDIST_POS_LE, MDIST_SYM, MDIST_TRIANGLE, is_metric_space, mdist,
        metric_tybij, mspace, .. } := BMetricSpace
  let { OPEN_IN_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { cauchy_in, mcomplete, .. } := BCauchy1
  -- @@SCOPE END

  let capped_metric ← new_definition
   r"capped_metric d (m:A metric) =
        if d <= &0 then m
        else metric(mspace m,(\(x,y). min d (mdist m (x,y))))"

  let CAPPED_METRIC ← prove
   r"!d m:A metric.
        mspace (capped_metric d m) = mspace m /\
        mdist (capped_metric d m) =
           \(x,y). if d <= &0 then mdist m (x,y) else min d (mdist m (x,y))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"d:real <= &0") THEN
    ASM_REWRITE_TAC [capped_metric, PAIRED_ETA_THM, ETA_AX] THEN
    REWRITE_TAC [capped_metric, mspace, mdist, ← GSYM PAIR_EQ] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 metric_tybij)] THEN
    REWRITE_TAC [is_metric_space, ← GSYM mspace, ← GSYM mdist] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"~(d <= &0) ==> (&0 <= min d x <=> &0 <= x)")] THEN
    ASM_SIMP_TAC [MDIST_POS_LE, MDIST_0, ← REAL_ARITH (← q
      r"~(d <= &0) /\ &0 <= x  ==> (min d x = &0 <=> x = &0)")] THEN
    CONJ_TAC THENL [MESON_TAC [MDIST_SYM], REPEAT STRIP_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q
     r"~(d <= &0) /\ &0 <= y /\ &0 <= z /\ x <= y + z
      ==> min d x <= min d y + min d z")) THEN
    ASM_MESON_TAC [MDIST_POS_LE, MDIST_TRIANGLE])

  let MDIST_CAPPED ← prove
   r"!d m x y:A. &0 < d ==> mdist(capped_metric d m) (x,y) <= d"
   (SIMP_TAC [CAPPED_METRIC, ← GSYM REAL_NOT_LT] THEN REAL_ARITH_TAC)

  let MTOPOLOGY_CAPPED_METRIC ← prove
   r"!d m:A metric. mtopology(capped_metric d m) = mtopology m"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"d <= &0") THENL
     [ASM_MESON_TAC [capped_metric],
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LE])] THEN
    REWRITE_TAC [TOPOLOGY_EQ] THEN
    X_GEN_TAC (← q r"s:A->bool") THEN ASM_REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET mspace m") THEN
    ASM_REWRITE_TAC [CAPPED_METRIC] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN ASM_CASES_TAC (← q r"(a:A) IN s") THEN ASM_REWRITE_TAC [] THEN
    ASM_REWRITE_TAC [SUBSET, IN_MBALL] THEN
    ASM_CASES_TAC (← q r"(a:A) IN mspace m") THENL
     [ASM_REWRITE_TAC [CAPPED_METRIC], ASM SET_TAC []] THEN
    EQ_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min (d / &2) r") THEN
    ASM_REWRITE_TAC [REAL_LT_MIN, REAL_HALF] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let CAUCHY_IN_CAPPED_METRIC ← prove
   r"!d (m:A metric) x.
        cauchy_in (capped_metric d m) x <=> cauchy_in m x"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"d <= &0") THENL
     [ASM_MESON_TAC [capped_metric], ALL_TAC] THEN
    ASM_REWRITE_TAC [cauchy_in, CAPPED_METRIC, REAL_MIN_LT] THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"~(d < min d e)"), REAL_LT_MIN, REAL_NOT_LE])

  let MCOMPLETE_CAPPED_METRIC ← prove
   r"!d (m:A metric). mcomplete(capped_metric d m) <=> mcomplete m"
   (REWRITE_TAC [mcomplete, CAUCHY_IN_CAPPED_METRIC, MTOPOLOGY_CAPPED_METRIC])

  let BOUNDED_EQUIVALENT_METRIC ← prove
   r"!m:A metric d.
        &0 < d
        ==> ?m'. mspace m' = mspace m /\
                 mtopology m' = mtopology m /\
                 !x y. mdist m' (x,y) < d"
   (REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"capped_metric (d / &2) m:A metric") THEN
    ASM_REWRITE_TAC [MTOPOLOGY_CAPPED_METRIC, CAPPED_METRIC] THEN
    ASM_REAL_ARITH_TAC)

  let SUP_METRIC_CARTESIAN_PRODUCT ← prove
   r"!k (m:K->(A)metric) m'.
        metric(cartesian_product k (mspace o m),
               \(x,y). sup {mdist(m i) (x i,y i) | i IN k}) = m' /\
        ~(k = {}) /\
        (?c. !i x y. i IN k /\ x IN mspace(m i) /\ y IN mspace(m i)
                      ==> mdist(m i) (x,y) <= c)
        ==> mspace m' = cartesian_product k (mspace o m) /\
            mdist m' = (\(x,y). sup {mdist(m i) (x i,y i) | i IN k}) /\
            !x y b. x IN cartesian_product k (mspace o m) /\
                    y IN cartesian_product k (mspace o m)
                    ==> (mdist m' (x,y) <= b <=>
                         !i. i IN k ==> mdist (m i) (x i,y i) <= b)"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ABBREV_TAC (← q r"M = \(x,y). sup {mdist(m i) (x i:A,y i) | (i:K) IN k}") THEN
    SUBGOAL_THEN
     (← q r"!x (y:K->A) b.
          x IN cartesian_product k (mspace o m) /\
          y IN cartesian_product k (mspace o m)
          ==> (M(x,y) <= b <=> !i. i IN k ==> mdist (m i) (x i,y i) <= b)")
    ASSUME_TAC THENL
     [REWRITE_TAC [cartesian_product, o_DEF, IN_ELIM_THM] THEN
      REPEAT STRIP_TAC THEN EXPAND_TAC "M" THEN REWRITE_TAC [] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) REAL_SUP_LE_EQ o lhand o snd) THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← MESON [] (← q
     r"m = m' ==> mspace m = mspace m' /\ mdist m = mdist m'"))) THEN
    REWRITE_TAC [← GSYM PAIR_EQ, mspace, mdist] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) (← CONJUNCT2 metric_tybij) o
      lhand o lhand o snd) THEN
    DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1)) THEN ANTS_TAC THENL
     [ALL_TAC,
      DISCH_THEN SUBST1_TAC THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [← GSYM mdist]] THEN
    REWRITE_TAC [is_metric_space] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN EXPAND_TAC "M" THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_LE_SUP THEN
      ASM_SIMP_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [cartesian_product, IN_ELIM_THM, o_THM]) THEN
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"c:real")) THEN EXISTS_TAC (← q r"c:real") THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN ASM_SIMP_TAC [MDIST_POS_LE],
      DISCH_TAC] THEN
    REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [← GSYM REAL_LE_ANTISYM] THEN REPEAT GEN_TAC THEN
      DISCH_THEN (fun th => tactic_of do
        pure (SUBST1_TAC (← MATCH_MP CARTESIAN_PRODUCT_EQ_MEMBERS_EQ th) THEN
        MP_TAC th)) THEN
      REWRITE_TAC [cartesian_product, o_THM, IN_ELIM_THM] THEN
      SIMP_TAC [← METRIC_ARITH (← q
       r"x IN mspace m /\ y IN mspace m ==> (mdist m (x,y) <= &0 <=> x = y)")],
      REPEAT STRIP_TAC THEN EXPAND_TAC "M" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      AP_TERM_TAC THEN MATCH_MP_TAC (← SET_RULE (← q
       r"(!i. i IN w ==> f i = g i) ==> {f i | i IN w} = {g i | i IN w}")) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [cartesian_product, IN_ELIM_THM, o_THM]) THEN
      ASM_MESON_TAC [MDIST_SYM],
      MAP_EVERY X_GEN_TAC [← q r"x:K->A", ← q r"y:K->A", ← q r"z:K->A"] THEN
      ASM_SIMP_TAC [] THEN STRIP_TAC THEN X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
      TRANS_TAC REAL_LE_TRANS
        (← q r"mdist (m i) ((x:K->A) i,y i) + mdist (m i) (y i,z i)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC MDIST_TRIANGLE THEN
        RULE_ASSUM_TAC (REWRITE_RULE [cartesian_product, IN_ELIM_THM, o_THM]) THEN
        ASM_SIMP_TAC [],
        MATCH_MP_TAC REAL_LE_ADD2 THEN EXPAND_TAC "M" THEN
        REWRITE_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC ELEMENT_LE_SUP THEN
        RULE_ASSUM_TAC (REWRITE_RULE [cartesian_product, IN_ELIM_THM, o_THM]) THEN
        ASM SET_TAC []]])

  return { capped_metric, CAPPED_METRIC, MDIST_CAPPED, MTOPOLOGY_CAPPED_METRIC,
           CAUCHY_IN_CAPPED_METRIC, MCOMPLETE_CAPPED_METRIC, BOUNDED_EQUIVALENT_METRIC,
           SUP_METRIC_CARTESIAN_PRODUCT }

/- ------------------------------------------------------------------------- -/
/- Metrizability of product topologies.  (metric.ml 38148-38503)             -/
/- ------------------------------------------------------------------------- -/

structure MSPT where
  METRIZABLE_SPACE_PRODUCT_TOPOLOGY : thm
  COMPLETELY_METRIZABLE_SPACE_PRODUCT_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupMSPT [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BBases : Bases) (BProduct1 : Product1) (BProduct3 : Product3) (BHomeoSpace : HomeoSpace)
    (BT1a : T1a) (BT1b : T1b) (BNets : Nets) (BSequential : Sequential)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BMetrizable : Metrizable)
    (BLimits2 : Limits2) (BCauchy1 : Cauchy1) (BCMS1 : CMS1) (BCAP : CAP) :
    ExceptT String IO MSPT := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, CARTESIAN_PRODUCT_EQ, CONJ_ASSOC, EMPTY_GSPEC, EXISTS_IN_GSPEC,
        EXTENSIONAL, FINITE_IMAGE, FINITE_INSERT, FINITE_INTER, FINITE_NUMSEG, FINITE_SUBSET,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN, INJECTIVE_ON_LEFT_INVERSE, IN_ELIM_THM,
        IN_NUMSEG, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_0, MEMBER_NOT_EMPTY, MONO_EXISTS,
        MONO_FORALL, NOT_INSERT_EMPTY, NOT_IN_EMPTY, NOT_LE, .. } := D.core2
  let { REAL_ARCH, REAL_INV_LE_1, REAL_LET_TRANS, REAL_LE_INF_FINITE, REAL_LE_REFL,
        REAL_LT_IMP_LE, REAL_LT_INF_FINITE, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ,
        REAL_LT_MIN, REAL_MIN_LE, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_ADD,
        REAL_OF_NUM_LT, .. } := D.core3
  let { RESTRICTION, RESTRICTION_IN_EXTENSIONAL, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_REFL, UNIONS_GSPEC, cartesian_product, o_DEF,
        o_THM, .. } := D.core4
  let { CONTRAPOS_THM, EQ_SYM_EQ, MONO_AND, RIGHT_EXISTS_IMP_THM, RIGHT_IMP_EXISTS_THM, .. } :=
    D.core5
  let { REAL_HALF, REAL_LT_BETWEEN, .. } := D.misc
  let { COUNTABLE_AS_INJECTIVE_IMAGE_SUBSET, COUNTABLE_EMPTY, COUNTABLE_IMAGE,
        COUNTABLE_SUBSET, COUNTABLE_UNIONS, FINITE_IMP_COUNTABLE, NUM_COUNTABLE, .. } := D.lib
  let { CLOSED_IN_TOPSPACE, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY, .. } := BDiscrete
  let { TOPOLOGY_BASES_EQ, .. } := BBases
  let { OPEN_IN_PRODUCT_TOPOLOGY_ALT, PRODUCT_TOPOLOGY_BASE_ALT, PRODUCT_TOPOLOGY_EMPTY_DISCRETE,
        TOPSPACE_PRODUCT_TOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY_ALT, product_topology, .. } :=
    BProduct1
  let { CLOSED_IN_CARTESIAN_PRODUCT, .. } := BProduct3
  let { TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT, .. } := BHomeoSpace
  let { T1_SPACE_CLOSED_IN_SING, .. } := BT1a
  let { T1_SPACE_PRODUCT_TOPOLOGY, .. } := BT1b
  let { EVENTUALLY_TRUE, .. } := BNets
  let { ARCH_EVENTUALLY_INV1, EVENTUALLY_HAPPENS_SEQUENTIALLY, .. } := BSequential
  let { CENTRE_IN_MBALL, IN_MBALL, MDIST_POS_LE, MDIST_POS_LT, MDIST_REFL, .. } := BMetricSpace
  let { MTOPOLOGY_BASE, OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { HOMEOMORPHIC_METRIZABLE_SPACE, METRIZABLE_IMP_T1_SPACE,
        METRIZABLE_SPACE_DISCRETE_TOPOLOGY, METRIZABLE_SPACE_SUBTOPOLOGY, metrizable_space, .. } :=
    BMetrizable
  let { LIMIT_COMPONENTWISE, .. } := BLimits2
  let { cauchy_in, mcomplete, .. } := BCauchy1
  let { COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE, COMPLETELY_METRIZABLE_SPACE_CLOSED_IN,
        COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY, HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE,
        completely_metrizable_space, .. } := BCMS1
  let { CAPPED_METRIC, SUP_METRIC_CARTESIAN_PRODUCT, .. } := BCAP
  -- @@SCOPE END

  let (METRIZABLE_SPACE_PRODUCT_TOPOLOGY,
       COMPLETELY_METRIZABLE_SPACE_PRODUCT_TOPOLOGY) ← CONJ_PAIR (← prove
   r"(!(tops:K->A topology) k.
        metrizable_space (product_topology k tops) <=>
        topspace (product_topology k tops) = {} \/
        COUNTABLE {i | i IN k /\ ~(?a. topspace(tops i) SUBSET {a})} /\
        !i. i IN k ==> metrizable_space (tops i)) /\
   (!(tops:K->A topology) k.
        completely_metrizable_space (product_topology k tops) <=>
        topspace (product_topology k tops) = {} \/
        COUNTABLE {i | i IN k /\ ~(?a. topspace(tops i) SUBSET {a})} /\
        !i. i IN k ==> completely_metrizable_space (tops i))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(n ==> m) /\ (t ==> n) /\ (m ==> t \/ m') /\ (n ==> t \/ n') /\
      (~t ==> m /\ m' ==> c) /\ (~t ==> c ==> (m' ==> m) /\ (n' ==> n))
      ==> (m <=> t \/ c /\ m') /\ (n <=> t \/ c /\ n')")) THEN
    REWRITE_TAC [COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE] THEN CONJ_TAC THENL
     [SIMP_TAC [← GSYM SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY] THEN
      REWRITE_TAC [COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY],
      GEN_REWRITE_TAC id [CONJ_ASSOC]] THEN
    CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE,
                   HOMEOMORPHIC_METRIZABLE_SPACE] THEN
      ASM_SIMP_TAC [METRIZABLE_SPACE_SUBTOPOLOGY] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_CLOSED_IN THEN
      ASM_REWRITE_TAC [CLOSED_IN_CARTESIAN_PRODUCT] THEN
      DISJ2_TAC THEN REPEAT STRIP_TAC THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [CLOSED_IN_TOPSPACE] THEN
      FIRST_ASSUM (MP_TAC o
        MATCH_MP COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE) THEN
      DISCH_THEN (MP_TAC o MATCH_MP METRIZABLE_IMP_T1_SPACE) THEN
      REWRITE_TAC [T1_SPACE_PRODUCT_TOPOLOGY] THEN
      REWRITE_TAC [T1_SPACE_CLOSED_IN_SING, RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
      STRIP_TAC THENL [ASM SET_TAC [], FIRST_X_ASSUM MATCH_MP_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE
       [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product, o_DEF, IN_ELIM_THM]) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN ABBREV_TAC
       (← q r"l = {i:K | i IN k /\ ~(?a:A. topspace(tops i) SUBSET {a})}") THEN
      SUBGOAL_THEN
       (← q r"!i:K. ?p q:A.
          i IN l ==> p IN topspace(tops i) /\ q IN topspace(tops i) /\ ~(p = q)")
      MP_TAC THENL [EXPAND_TAC "l" THEN SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:K->A", ← q r"b:K->A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, o_DEF, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"z:K->A") THEN DISCH_TAC THEN
      ABBREV_TAC (← q r"p:K->A = \i. if i IN l then a i else z i") THEN
      ABBREV_TAC (← q r"q:K->K->A = \i j. if j = i then b i else p j") THEN
      SUBGOAL_THEN
       (← q r"p IN topspace(product_topology k (tops:K->A topology)) /\
        (!i:K. i IN l
               ==> q i IN topspace(product_topology k (tops:K->A topology)))")
      STRIP_ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"(z:K->A) IN cartesian_product k (\x. topspace(tops x))") THEN
        MAP_EVERY EXPAND_TAC ["q", "p"] THEN
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product, o_THM] THEN
        REWRITE_TAC [EXTENSIONAL, IN_ELIM_THM] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!u:(K->A)->bool.
          open_in (product_topology k tops) u /\ p IN u
          ==> FINITE {i:K | i IN l /\ ~(q i IN u)}")
      ASSUME_TAC THENL
       [X_GEN_TAC (← q r"u:(K->A)->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
        REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY_ALT] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"p:K->A")) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"v:K->A->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"i:K") THEN
        MATCH_MP_TAC (← TAUT (← q
         r"(l ==> k) /\ (k /\ l ==> p ==> q) ==> l /\ ~q ==> k /\ ~p")) THEN
        CONJ_TAC THENL [ASM SET_TAC [], REPEAT STRIP_TAC] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
        EXPAND_TAC "q" THEN UNDISCH_TAC (← q r"(p:K->A) IN cartesian_product k v") THEN
        REWRITE_TAC [cartesian_product, IN_ELIM_THM, EXTENSIONAL] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [metrizable_space]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"m:(K->A)metric")) THEN
      MATCH_MP_TAC COUNTABLE_SUBSET THEN
      EXISTS_TAC (← q r"UNIONS {{i | i IN l /\
                               ~((q:K->K->A) i IN mball m (p,inv(&n + &1)))} |
                          n IN (:num)}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC COUNTABLE_UNIONS THEN REWRITE_TAC [SIMPLE_IMAGE] THEN
        SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
        MATCH_MP_TAC FINITE_IMP_COUNTABLE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [OPEN_IN_MBALL] THEN MATCH_MP_TAC CENTRE_IN_MBALL THEN
        REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        ASM_MESON_TAC [TOPSPACE_MTOPOLOGY],
        REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
        X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN MP_TAC (← EQ_IMP_RULE (← ISPEC
         (← q r"mdist (m:(K->A)metric) (p,q(i:K))") ARCH_EVENTUALLY_INV1)).2 THEN
        ANTS_TAC THENL
         [MATCH_MP_TAC MDIST_POS_LT THEN REPEAT
           (CONJ_TAC THENL [ASM_MESON_TAC [TOPSPACE_MTOPOLOGY], ALL_TAC]) THEN
          DISCH_THEN (MP_TAC o (fun (th : thm) =>
            (do AP_THM th (← q r"i:K") : ExceptT String IO thm))) THEN
          MAP_EVERY EXPAND_TAC ["q", "p"] THEN REWRITE_TAC [] THEN
          ASM_SIMP_TAC [],
          DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS_SEQUENTIALLY) THEN
          MATCH_MP_TAC MONO_EXISTS THEN
          ASM_REWRITE_TAC [IN_MBALL] THEN REAL_ARITH_TAC]],
      ALL_TAC] THEN
    DISCH_TAC THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"k:K->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, EMPTY_GSPEC, COUNTABLE_EMPTY] THEN
      REWRITE_TAC [PRODUCT_TOPOLOGY_EMPTY_DISCRETE,
                   METRIZABLE_SPACE_DISCRETE_TOPOLOGY,
                   COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY],
      ALL_TAC] THEN
    REWRITE_TAC [metrizable_space, completely_metrizable_space] THEN
    GEN_REWRITE_TAC (BINOP_CONV o LAND_CONV o BINDER_CONV)
        [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, AND_FORALL_THM] THEN
    X_GEN_TAC (← q r"m:K->A metric") THEN ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN
    ASM_CASES_TAC (← q r"!i. i IN k ==> mtopology(m i) = (tops:K->A topology) i") THEN
    ASM_SIMP_TAC [] THENL [ALL_TAC, ASM_MESON_TAC []] THEN MATCH_MP_TAC (← MESON [] (← q
     r"!m. P m /\ (Q ==> C m) ==> (?m. P m) /\ (Q ==> ?m. C m /\ P m)")) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
     [COUNTABLE_AS_INJECTIVE_IMAGE_SUBSET]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, INJECTIVE_ON_LEFT_INVERSE] THEN
    MAP_EVERY X_GEN_TAC [← q r"nk:num->K", ← q r"c:num->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_TAC (← q r"kn:K->num"))) THEN
    MP_TAC (← ISPECL
     [← q r"k:K->bool",
      ← q r"\i. capped_metric (inv(&(kn i) + &1)) ((m:K->A metric) i)"]
     SUP_METRIC_CARTESIAN_PRODUCT) THEN
    REWRITE_TAC [o_DEF, ← CONJUNCT1 (← SPEC_ALL CAPPED_METRIC)] THEN
    MATCH_MP_TAC (← MESON [] (← q
     r"Q /\ (!m. P m ==> R m)
      ==> (!m. a = m /\ Q ==> P m) ==> ?m. R m")) THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"&1:real") THEN
      REWRITE_TAC [CAPPED_METRIC, ← GSYM REAL_NOT_LT] THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      REWRITE_TAC [REAL_NOT_LT, REAL_MIN_LE] THEN REPEAT STRIP_TAC THEN
      DISJ1_TAC THEN MATCH_MP_TAC REAL_INV_LE_1 THEN REAL_ARITH_TAC,
      X_GEN_TAC (← q r"M:(K->A)metric")] THEN
    SUBGOAL_THEN
     (← q r"cartesian_product k (\i. mspace (m i)) =
      topspace(product_topology k (tops:K->A topology))")
    SUBST1_TAC THENL
