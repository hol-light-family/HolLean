          ASM_SIMP_TAC [REAL_LT_INF_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
          ASM_REWRITE_TAC [FORALL_IN_IMAGE, REAL_SUB_LT] THEN
          X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"d <= b ==> d <= max a b")) THEN
          ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a <= b - c <=> c <= b - a")] THEN
