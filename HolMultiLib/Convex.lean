            MATCH_MP_TAC LE_TRANS THEN EXISTS_TAC (← q r"CARD(s:real^N->bool)") THEN
            ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CARD_SUBSET THEN
            ASM SET_TAC []]]])

  return { JUNG }

