                   ← q r"a:real^N"]) THEN
          ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < r ==> (r <= max (&0) a <=> r <= a)")] THEN
          REWRITE_TAC [SUBSET, IN_CBALL, ← REAL_ARITH (← q r"a <= max a b")] THEN
