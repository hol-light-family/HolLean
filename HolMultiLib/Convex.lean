          SIMP_TAC [NORM_EQ_SQUARE, NORM_POW_2] THEN REAL_ARITH_TAC] THEN
        REWRITE_TAC [← REAL_ARITH
          (← q r"x * (&2 * y - &2 * z) = &2 * (x * y - x * z)")] THEN
        REWRITE_TAC [SUM_LMUL] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
