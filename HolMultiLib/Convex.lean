structure CNA where
  CONVEX_IMP_LOCALLY_BOUNDED : thm
  CONVEX_IMP_LOCALLY_LIPSCHITZ : thm
  deriving Inhabited

@[nospecialize]
def setupCNA [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BCVF : CVF) (BCVB : CVB)
    (BCLH : CLH) (BADA : ADA) (BADB : ADB) (BADC : ADC) (BCHB : CHB) (BSEC : SEC) (BRIA : RIA)
    (BRIB : RIB) (BRIE : RIE) (BBAR : BAR) (BRPB : RPB) : ExceptT String IO CNA := do
  -- @@SCOPE BEGIN
  let { ASM_INT_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH, MESON, MESON_TAC,
        REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH,
        NORM_ARITH, .. } := D
  let { CARD_CLAUSES, .. } := D.core1
  let { HAS_SIZE, IMP_CONJ, IMP_CONJ_ALT, INTER_SUBSET, INT_EQ_SUB_LADD, INT_LE_REFL,
        INT_LE_SUB_RADD, INT_OF_NUM_EQ, INT_OF_NUM_EXISTS, INT_OF_NUM_LT, INT_SUB_ADD,
        INT_SUB_LZERO, .. } := D.core2
  let { IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM, MONO_EXISTS, REAL_ABS_POS,
        REAL_ABS_SUB, .. } := D.core3
  let { REAL_INV_LE_1, REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_DIV, REAL_LE_INV_EQ,
        REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_RMUL, REAL_LE_TOTAL, REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_MUL, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_RZERO, REAL_NOT_LT, REAL_POS, REAL_SUB_REFL, SUBSET,
        SUBSET_INTER, SUBSET_TRANS, .. } := D.core5
  let { HULL_HULL, HULL_INC, HULL_MINIMAL, HULL_MONO, REAL_HALF,
        UPPER_BOUND_FINITE_SET_REAL, .. } := D.misc
  let { DIST_SYM, .. } := D.vec1
  let { NORM_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_SUB, .. } := D.vec3
  let { VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, VECTOR_SUB_REFL, dist, .. } := D.vec4
  let { BOUNDED_CBALL, .. } := D.top1
  let { FRONTIER_CBALL, .. } := D.top3
  let { INTERIOR_CBALL, IN_BALL, IN_CBALL, IN_SEGMENT, IN_SPHERE, .. } := D.top4
  let { SUBSET_CBALL, .. } := D.top5
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF, IN_AFFINE_MUL_DIFF_ADD, .. } := BAFF
  let { AFFINE_HULL_SING, .. } := BAFS
  let { convex_on, CONVEX_ON_SUBSET, .. } := BCVF
  let { CONVEX_CBALL, .. } := BCVB
  let { CONVEX_HULL_SUBSET_AFFINE_HULL, .. } := BCLH
  let { AFF_DIM_AFFINE_HULL, .. } := BADA
  let { AFF_DIM_UNIQUE, AFF_DIM_GE, .. } := BADB
  let { AFF_DIM_EQ_MINUS1, AFF_DIM_EQ_0, AFF_DIM_EQ_AFFINE_HULL, .. } := BADC
  let { CONVEX_ON_CONVEX_HULL_BOUND, .. } := BCHB
  let { CONVEX_ON_LEFT_SECANT_MUL, .. } := BSEC
  let { IN_RELATIVE_INTERIOR_CBALL, .. } := BRIA
  let { AFFINE_HULL_CONVEX_HULL, .. } := BRIB
  let { RAY_TO_FRONTIER, .. } := BRIE
  let { BARYCENTRE_IN_RELATIVE_INTERIOR, .. } := BBAR
  let { REGULAR_POLYTOPE_WITH_BARYCENTRE_EXISTS, .. } := BRPB
  -- @@SCOPE END

  let CONVEX_IMP_LOCALLY_BOUNDED ← prove
   r"!f s a:real^N.
          f convex_on s /\ a IN relative_interior s
          ==> ?e B. &0 < e /\ &0 < B /\
                    cball(a,e) INTER affine hull s SUBSET s /\
                    !x. x IN cball(a,e) INTER affine hull s ==> abs(f x) <= B"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR_CBALL]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"e:real")
      STRIP_ASSUME_TAC)) THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"aff_dim(s:real^N->bool) = &0") THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [AFF_DIM_EQ_0]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N") SUBST_ALL_TAC) THEN
      ASM_CASES_TAC (← q r"b:real^N = a") THEN ASM_REWRITE_TAC [IN_SING] THEN
      REWRITE_TAC [AFFINE_HULL_SING, INTER_SUBSET, IN_INTER, IN_SING] THEN
      MESON_TAC [← REAL_ARITH (← q r"abs x <= abs x + &1 /\ &0 < abs x + &1")],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&1 <= aff_dim(s:real^N->bool)") ASSUME_TAC THENL
     [MATCH_MP_TAC (← INT_ARITH
       (← q r"-- &1:int <= x /\ ~(x = &0) /\ ~(x = -- &1) ==> &1 <= x")) THEN
      ASM_REWRITE_TAC [AFF_DIM_GE, AFF_DIM_EQ_MINUS1],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?n. aff_dim(s:real^N->bool) = &n - &1") STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [INT_EQ_SUB_LADD, INT_OF_NUM_EXISTS] THEN
      REWRITE_TAC [← GSYM INT_LE_SUB_RADD, AFF_DIM_GE, INT_SUB_LZERO],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"1 < n /\ ~(n = 0)") STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM INT_OF_NUM_EQ, ← GSYM INT_OF_NUM_LT] THEN ASM_INT_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"e:real", ← q r"s:real^N->bool", ← q r"a:real^N", ← q r"n:num"]
          REGULAR_POLYTOPE_WITH_BARYCENTRE_EXISTS) THEN
    ASM_SIMP_TAC [HULL_INC, INT_SUB_ADD, INT_LE_REFL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^N->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real", ← q r"k:real^N->bool"]
          UPPER_BOUND_FINITE_SET_REAL) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [HAS_SIZE], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
      CONVEX_ON_CONVEX_HULL_BOUND)) THEN
    SUBGOAL_THEN (← q r"(f:real^N->real) convex_on convex hull k") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONVEX_ON_SUBSET)) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          SUBSET_TRANS)) THEN
      REWRITE_TAC [SUBSET_INTER] THEN CONJ_TAC THENL
       [MATCH_MP_TAC HULL_MINIMAL THEN
        ASM_SIMP_TAC [CONVEX_CBALL, SUBSET, IN_CBALL, REAL_LE_REFL],
        ASM_MESON_TAC [HULL_MONO, HULL_HULL, SUBSET,
                       CONVEX_HULL_SUBSET_AFFINE_HULL]],
      ASM_REWRITE_TAC [] THEN DISCH_TAC] THEN
    MP_TAC (← SPEC (← q r"k:real^N->bool") BARYCENTRE_IN_RELATIVE_INTERIOR) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [HAS_SIZE, CARD_CLAUSES], ASM_SIMP_TAC []] THEN
    REWRITE_TAC [IN_RELATIVE_INTERIOR_CBALL, AFFINE_HULL_CONVEX_HULL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    SUBGOAL_THEN (← q r"affine hull k:real^N->bool = affine hull s") ASSUME_TAC THENL
     [GEN_REWRITE_TAC RAND_CONV [← GSYM HULL_HULL] THEN
      MATCH_MP_TAC AFF_DIM_EQ_AFFINE_HULL THEN
      ASM_REWRITE_TAC [AFF_DIM_AFFINE_HULL] THEN
      MP_TAC (← ISPECL [← q r"k:real^N->bool", ← q r"k:real^N->bool"] AFF_DIM_UNIQUE) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN ASM_SIMP_TAC [INT_LE_REFL],
      ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"&1 + abs(b + &2 * abs(f(a:real^N)))") THEN
    REPEAT CONJ_TAC THENL
     [REAL_ARITH_TAC,
      SUBGOAL_THEN (← q r"convex hull k SUBSET cball(a:real^N,e)") MP_TAC THENL
       [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC HULL_MINIMAL THEN
      ASM_SIMP_TAC [CONVEX_CBALL, SUBSET, IN_CBALL, REAL_LE_REFL],
      X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"f convex_on cball(a:real^N,d) INTER affine hull s")
      MP_TAC THENL [ASM_MESON_TAC [CONVEX_ON_SUBSET], SIMP_TAC [convex_on]] THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"x:real^N", ← q r"&2 % a - x:real^N", ← q r"&1 / &2", ← q r"&1 / &2"]) THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [IN_INTER] THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"&1 / &2 % x + &1 / &2 % (&2 % a - x):real^N = a")] THEN
      UNDISCH_TAC (← q r"!x:real^N. x IN convex hull k ==> f x <= b") THEN
      DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"&2 % a - x:real^N") th) THEN
              MP_TAC (← SPEC (← q r"x:real^N") th) THEN
              MP_TAC (← SPEC (← q r"a:real^N") th))) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
      SUBGOAL_THEN (← q r"&2 % a - x IN cball(a:real^N,d) /\
                    &2 % a - x IN affine hull s")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [IN_CBALL, ← NORM_ARITH
         (← q r"dist(a:real^N,&2 % a - x) = dist(a,x)")] THEN
        ASM_REWRITE_TAC [← GSYM IN_CBALL] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"&2 % a - x:real^N = &1 % (a - x) + a")] THEN
        MATCH_MP_TAC IN_AFFINE_MUL_DIFF_ADD THEN
        ASM_REWRITE_TAC [AFFINE_AFFINE_HULL] THEN
        ASM_MESON_TAC [SUBSET, CONVEX_HULL_SUBSET_AFFINE_HULL],
        ANTS_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC]])

  let CONVEX_IMP_LOCALLY_LIPSCHITZ ← prove
   r"!f s a:real^N.
          f convex_on s /\ a IN relative_interior s
          ==> ?e B. &0 < e /\ &0 < B /\
                    cball(a,e) INTER affine hull s SUBSET s /\
                    !x y. x IN cball(a,e) INTER affine hull s /\
                          y IN cball(a,e) INTER affine hull s
                          ==> abs(f x - f y) <= B * norm(x - y)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real", ← q r"s:real^N->bool", ← q r"a:real^N"]
      CONVEX_IMP_LOCALLY_BOUNDED) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"e:real", ← q r"B:real"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"e / &2") THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    EXISTS_TAC (← q r"&4 * B / e") THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_MUL, ← REAL_ARITH (← q r"&0 < &4")] THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"e / &2", ← q r"e:real"] SUBSET_CBALL) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, DISCH_TAC] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"!i. (!x y. i x y \/ i y x) /\ (!x y. P x y ==> P y x) /\
          (!x y. i x y ==> P x y)
          ==> !x y. P x y")) THEN
    EXISTS_TAC (← q r"\x y. (f:real^N->real) x <= f y") THEN
    REWRITE_TAC [REAL_LE_TOTAL] THEN CONJ_TAC THENL
     [REWRITE_TAC [NORM_SUB, REAL_ABS_SUB] THEN MESON_TAC [], ALL_TAC] THEN
    SIMP_TAC [← REAL_ARITH (← q r"x <= y ==> abs(x - y) = y - x")] THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"y:real^N = x") THEN
    ASM_REWRITE_TAC [REAL_SUB_REFL, VECTOR_SUB_REFL, NORM_0,
                     REAL_MUL_RZERO, REAL_LE_REFL] THEN
    SUBGOAL_THEN
     (← q r"?z:real^N. dist(a,z) = e /\ z IN affine hull s /\ y IN segment[x,z]")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"cball(a:real^N,e)", ← q r"x:real^N", ← q r"y - x:real^N"]
          RAY_TO_FRONTIER) THEN
      REWRITE_TAC [INTERIOR_CBALL, FRONTIER_CBALL] THEN
      ASM_REWRITE_TAC [IN_BALL, VECTOR_SUB_EQ, BOUNDED_CBALL] THEN ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTER, IN_CBALL]) THEN ASM_REAL_ARITH_TAC,
        DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC)] THEN
      EXISTS_TAC (← q r"x + d % (y - x):real^N") THEN
      ASM_REWRITE_TAC [← GSYM IN_SPHERE] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [IN_INTER, AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF],
        REWRITE_TAC [IN_SEGMENT]] THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, ← VECTOR_ARITH
       (← q r"y:real^N = (&1 - u) % x + u % (x + d % (y - x)) <=>
        (u * d - &1) % (y - x) = vec 0")] THEN
      EXISTS_TAC (← q r"inv(d):real") THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_MUL_LINV,
                    REAL_SUB_REFL, REAL_LE_INV_EQ] THEN
      MATCH_MP_TAC REAL_INV_LE_1 THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_SPHERE]) THEN
      REWRITE_TAC [dist, ← VECTOR_ARITH
       (← q r"a - (x + d % (y - x)) = --((&1 - d) % (x - a) + d % (y - a))")] THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(x:real^N) + norm(y) < e ==> ~(norm(--(x + y)) = e)")) THEN
      REWRITE_TAC [NORM_MUL] THEN TRANS_TAC REAL_LET_TRANS
       (← q r"abs(&1 - d) * e / &2 + abs d * e / &2") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM dist)] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTER, IN_CBALL]) THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONVEX_ON_LEFT_SECANT_MUL]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x:real^N", ← q r"z:real^N", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
      ASM_MESON_TAC [SUBSET, IN_CBALL, REAL_LE_REFL, IN_INTER],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"e / &2 <= norm(z - x:real^N)") MP_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← NORM_ARITH
       (← q r"dist(a:real^N,z) = e
        ==> dist(a,x) <= e / &2 ==> e / &2 <= norm(z - x)"))) THEN
      ASM_MESON_TAC [IN_INTER, IN_CBALL],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"z:real^N = x") THENL
     [ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN ASM_REAL_ARITH_TAC,
      DISCH_TAC] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"(a * b) / c:real = a / c * b")] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [NORM_SUB] THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"(&4 * B / e) * e / &2") THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < e ==>  (&4 * B / e) * e / &2 = &2 * B")] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs(x) <= B /\ abs(y) <= B ==> x - y <= &2 * B")) THEN
      CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [SUBSET, IN_CBALL, REAL_LE_REFL, IN_INTER],
      MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [REAL_LE_DIV, REAL_LE_MUL, REAL_POS, REAL_LT_IMP_LE]])

  return { CONVEX_IMP_LOCALLY_BOUNDED, CONVEX_IMP_LOCALLY_LIPSCHITZ }

/- ------------------------------------------------------------------------- -/
/- Continuity of convex functions and related results, continued.            -/
/- (convex.ml 18089-18210)                                                   -/
/- ------------------------------------------------------------------------- -/

structure CNB where
  CONVEX_ON_CONTINUOUS_ON_RELATIVE_INTERIOR : thm
  CONVEX_ON_CONTINUOUS : thm
  CONVEX_IMP_LIPSCHITZ : thm
  deriving Inhabited

@[nospecialize]
def setupCNB [HolBase] (D : ConvexDeps) (BRIA : RIA) (BRIB : RIB) (BCNA : CNA) :
    ExceptT String IO CNB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_TAC,
        VECTOR_ARITH, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, FORALL_AND_THM, .. } := D.core1
  let { IN_INTER, LEFT_IMP_EXISTS_THM, LE_1, NOT_FORALL_THM, NOT_IMP, REAL_ABS_SUB,
        REAL_ARCH_SIMPLE, .. } := D.core3
  let { REAL_LE_RDIV_EQ, REAL_LE_RMUL, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_MIN,
        REAL_LT_RDIV_EQ, REAL_MAX_LE, .. } := D.core4
  let { REAL_MUL_SYM, REAL_NOT_LE, REAL_OF_NUM_LE, REAL_OF_NUM_LT, SKOLEM_THM, SUBSET, .. } :=
    D.core5
  let { o_ASSOC, o_DEF, o_THM, real_div, .. } := D.core6
  let { HULL_INC, MONOTONE_BIGGER, .. } := D.misc
  let { DIST_LIFT, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { LIFT_CMUL, LIFT_SUB, .. } := D.vec2
  let { NORM_LIFT, NORM_POS_LE, NORM_SUB, .. } := D.vec3
  let { VECTOR_SUB_EQ, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_WITHIN_SEQUENTIALLY, .. } := D.top3
  let { IN_CBALL, LIM_MUL, LIM_NORM, LIM_NULL_COMPARISON, LIM_SEQUENTIALLY, LIM_SUB,
        LIM_SUBSEQUENCE, LIM_UNIQUE, .. } := D.top4
  let { SEQ_HARMONIC, compact, continuous_on, .. } := D.top5
  let { RELATIVE_INTERIOR_SUBSET, IN_RELATIVE_INTERIOR, .. } := BRIA
  let { RELATIVE_INTERIOR_OPEN, .. } := BRIB
  let { CONVEX_IMP_LOCALLY_LIPSCHITZ, .. } := BCNA
  -- @@SCOPE END

  let CONVEX_ON_CONTINUOUS_ON_RELATIVE_INTERIOR ← prove
   r"!f s:real^N->bool.
          f convex_on s ==> lift o f continuous_on relative_interior s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [continuous_on] THEN
    X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real", ← q r"s:real^N->bool", ← q r"a:real^N"]
          CONVEX_IMP_LOCALLY_LIPSCHITZ) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:real", ← q r"B:real"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"min d (e / B)") THEN
    ASM_SIMP_TAC [REAL_LT_MIN, REAL_LT_DIV, o_DEF, DIST_LIFT] THEN
    X_GEN_TAC (← q r"b:real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_RELATIVE_INTERIOR]) THEN
    ASM_SIMP_TAC [IN_INTER, HULL_INC, IN_CBALL, DIST_REFL] THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH
      (← q r"d < e ==> abs(a - b) <= d ==> abs(b - a) < e")) THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ] THEN
    ASM_REWRITE_TAC [← NORM_ARITH (← q r"norm(a - b:real^N) = dist(b,a)")])

  let CONVEX_ON_CONTINUOUS ← prove
   r"!f s:real^N->bool. open s /\ f convex_on s ==> lift o f continuous_on s"
   (MESON_TAC [RELATIVE_INTERIOR_OPEN,
               CONVEX_ON_CONTINUOUS_ON_RELATIVE_INTERIOR])

  let CONVEX_IMP_LIPSCHITZ ← prove
   r"!f:real^N->real s t.
          f convex_on t /\ compact s /\ s SUBSET relative_interior t
          ==> ?B. &0 < B /\
                  !x y. x IN s /\ y IN s ==> abs(f x - f y) <= B * norm(x - y)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← MESON [] (← q r"(?x. P x) <=> ~(!x. ~P x)")] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?x y a b:real^N.
          (!n. x n IN s) /\ (!n. y n IN s) /\ a IN s /\ b IN s /\
          (x --> a) sequentially /\ (y --> b) sequentially /\
          (!n. abs(f(x n) - f(y n)) > &n * norm(x n - y n))")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"&n + &1:real")) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&0 < &n + &1"), NOT_FORALL_THM, NOT_IMP] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, ← GSYM CONJ_ASSOC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:num->real^N", ← q r"y:num->real^N"] THEN
      REWRITE_TAC [FORALL_AND_THM, REAL_NOT_LE] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"x:num->real^N") o
          GEN_REWRITE_RULE id [compact]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"r:num->num"] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"(y:num->real^N) o (r:num->num)") o
          GEN_REWRITE_RULE id [compact]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, o_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"q:num->num"] THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"(x:num->real^N) o (r:num->num) o (q:num->num)",
        ← q r"(y:num->real^N) o (r:num->num) o (q:num->num)",
        ← q r"a:real^N", ← q r"b:real^N"] THEN
      ASM_SIMP_TAC [o_ASSOC, o_THM, LIM_SUBSEQUENCE] THEN X_GEN_TAC (← q r"n:num") THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_NOT_LE] o
        SPEC (← q r"(r:num->num) ((q:num->num) n)")) THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"b <= a ==> ~(x <= a) ==> x > b")) THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> a <= b + &1")) THEN
      REWRITE_TAC [REAL_OF_NUM_LE] THEN SPEC_TAC ((← q r"n:num"), (← q r"n:num")) THEN
      MATCH_MP_TAC MONOTONE_BIGGER THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"b:real^N = a") SUBST_ALL_TAC THENL
     [ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"\n. (y:num->real^N) n - x n") THEN
      ASM_SIMP_TAC [LIM_SUB, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      MATCH_MP_TAC LIM_NULL_COMPARISON THEN
      EXISTS_TAC (← q r"\n. abs(f(y n) - f(x n:real^N)) / &n") THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"1") THEN SIMP_TAC [REAL_LE_RDIV_EQ, REAL_OF_NUM_LT, LE_1] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ONCE_REWRITE_TAC [NORM_SUB, REAL_ABS_SUB] THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"b:real > a ==> a <= b")],
        REWRITE_TAC [real_div, LIFT_CMUL] THEN SUBST1_TAC (← VECTOR_ARITH
         (← q r"vec 0:real^1 = abs(f(b:real^N) - f a) % vec 0")) THEN
        MATCH_MP_TAC LIM_MUL THEN REWRITE_TAC [SEQ_HARMONIC, o_DEF] THEN
        REWRITE_TAC [← GSYM NORM_LIFT, LIFT_SUB] THEN
        MATCH_MP_TAC LIM_NORM THEN MATCH_MP_TAC LIM_SUB THEN
        CONJ_TAC THEN MP_TAC (← ISPECL
         [← q r"lift o (f:real^N->real)", ← q r"relative_interior t:real^N->bool"]
         CONTINUOUS_WITHIN_SEQUENTIALLY) THEN
        REWRITE_TAC [o_DEF] THENL
         [DISCH_THEN (MP_TAC o SPEC (← q r"b:real^N")),
          DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N"))] THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1)) THEN
        (ANTS_TAC THENL
          [ALL_TAC, DISCH_THEN MATCH_MP_TAC THEN ASM_MESON_TAC [SUBSET]]) THEN
        FIRST_ASSUM (MP_TAC o
          MATCH_MP CONVEX_ON_CONTINUOUS_ON_RELATIVE_INTERIOR) THEN
        REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, o_DEF] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_MESON_TAC [SUBSET]],
      ALL_TAC] THEN
    MP_TAC (← SPECL [← q r"f:real^N->real", ← q r"t:real^N->bool", ← q r"a:real^N"]
        CONVEX_IMP_LOCALLY_LIPSCHITZ) THEN
    ANTS_TAC THENL [ASM SET_TAC [], SIMP_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:real", ← q r"B:real"] THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY])) THEN
    REWRITE_TAC [← TAUT (← q r"a ==> ~b <=> ~(a /\ b)"), AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"d:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2
      (X_CHOOSE_TAC (← q r"N1:num")) (X_CHOOSE_TAC (← q r"N2:num"))) THEN
    MP_TAC (← SPEC (← q r"max B (max (&N1) (&N2))") REAL_ARCH_SIMPLE) THEN
    REWRITE_TAC [REAL_MAX_LE, REAL_OF_NUM_LE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num"))) THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"(x:num->real^N) n", ← q r"(y:num->real^N) n"]) THEN
    ASM_REWRITE_TAC [IN_CBALL, IN_INTER] THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_SIMP_TAC [REAL_LT_IMP_LE, NOT_IMP] THEN
    CONJ_TAC THENL
      [ASM_MESON_TAC [SUBSET, HULL_INC, RELATIVE_INTERIOR_SUBSET],
       FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"x > a ==> b <= a ==> ~(x <= b)"))) THEN
       ASM_SIMP_TAC [REAL_LE_RMUL, NORM_POS_LE]])

  return { CONVEX_ON_CONTINUOUS_ON_RELATIVE_INTERIOR, CONVEX_ON_CONTINUOUS,
           CONVEX_IMP_LIPSCHITZ }

/- ------------------------------------------------------------------------- -/
/- Continuity of convex functions, continued; a convex function on R^1 is    -/
/- "piecewise monotone". (convex.ml 18212-18329)                             -/
/- ------------------------------------------------------------------------- -/

structure CNC where
  CONVEX_BOUNDS_LEMMA : thm
  CONVEX_IMP_BOUNDED_ON_INTERVAL : thm
  CONVEX_IMP_PIECEWISE_MONOTONE : thm
  deriving Inhabited

@[nospecialize]
def setupCNC [HolBase] (D : ConvexDeps) (BCVF : CVF) (BMCG : MCG) (BONE : ONE) (BCHB : CHB)
    (BSTL : STL) (BCNB : CNB) : ExceptT String IO CNC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, .. } := D
  let { ARITH, DISJ_ASSOC, .. } := D.core1
  let { FORALL_IN_INSERT, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IMP, NOT_IN_EMPTY, REAL_ADD_LDISTRIB, .. } :=
    D.core3
  let { REAL_LE_LT, REAL_LE_RDIV_EQ, REAL_LE_TRANS, REAL_LT_01, REAL_LT_LE, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_SYM, REAL_NOT_LE, REAL_OF_NUM_LT, SUBSET, .. } := D.core5
  let { real_div, real_max, .. } := D.core6
  let { REAL_NON_MONOTONE, .. } := D.misc
  let { DIST_POS_LE, .. } := D.vec1
  let { DROP_EQ, FORALL_DROP, FORALL_LIFT, INTERVAL_OPEN_SUBSET_CLOSED, LIFT_DROP, .. } :=
    D.vec2
  let { NORM_SUB, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, dist, .. } := D.vec4
  let { CENTRE_IN_CBALL, .. } := D.top1
  let { COMPACT_INTERVAL, CONTINUOUS_ATTAINS_INF, .. } := D.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.top3
  let { INTERIOR_SUBSET, INTERVAL_1, INTERVAL_NE_EMPTY_1, INTERVAL_SUBSET_IS_INTERVAL,
        IN_CBALL, IN_INTERVAL_1, .. } := D.top4
  let { OPEN_INTERIOR, OPEN_INTERVAL, SEGMENT_1, .. } := D.top5
  let { convex_on, CONVEX_ON_SUBSET, CONVEX_LOWER_SEGMENT, CONVEX_LOCAL_GLOBAL_MINIMUM, .. } :=
    BCVF
  let { CONVEX_INTERIOR, .. } := BMCG
  let { IS_INTERVAL_CONVEX_1, .. } := BONE
  let { CONVEX_ON_CONVEX_HULL_BOUND, .. } := BCHB
  let { SEGMENT_CONVEX_HULL, .. } := BSTL
  let { CONVEX_ON_CONTINUOUS, .. } := BCNB
  -- @@SCOPE END

  let CONVEX_BOUNDS_LEMMA ← prove
   r"!f x:real^N e.
          f convex_on cball(x,e) /\
          (!y. y IN cball(x,e) ==> f(y) <= b)
          ==> !y. y IN cball(x,e) ==> abs(f(y)) <= b + &2 * abs(f(x))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"&0 <= e") THENL
     [ALL_TAC,
      REWRITE_TAC [IN_CBALL] THEN ASM_MESON_TAC [DIST_POS_LE, REAL_LE_TRANS]] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [convex_on]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"y:real^N", ← q r"&2 % x - y:real^N", ← q r"&1 / &2", ← q r"&1 / &2"]) THEN
    REWRITE_TAC [← GSYM VECTOR_ADD_LDISTRIB, ← GSYM REAL_ADD_LDISTRIB] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"y + x - y = x:real^N")] THEN
    REWRITE_TAC [VECTOR_MUL_ASSOC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ABBREV_TAC (← q r"z = &2 % x - y:real^N") THEN
    SUBGOAL_THEN (← q r"z:real^N IN cball(x,e)") ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"y:real^N IN cball(x,e)")  THEN
      EXPAND_TAC "z" THEN REWRITE_TAC [dist, IN_CBALL] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"x - (&2 % x - y) = y - x")] THEN
      REWRITE_TAC [NORM_SUB],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LID] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [real_div, REAL_MUL_LID] THEN REWRITE_TAC [← GSYM real_div] THEN
    ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_OF_NUM_LT, ARITH] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (MAP_EVERY (MP_TAC o C SPEC th) [← q r"y:real^N", ← q r"z:real^N"])) THEN
    ASM_REWRITE_TAC [CENTRE_IN_CBALL] THEN REAL_ARITH_TAC)

  let CONVEX_IMP_BOUNDED_ON_INTERVAL ← prove
   r"!f:real^1->real a b.
          f convex_on interval[a,b]
          ==> ?B. &0 < B /\ !x. x IN interval[a,b] ==> abs(f x) <= B"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THENL
     [ASM_MESON_TAC [NOT_IN_EMPTY, REAL_LT_01], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
    SUBGOAL_THEN (← q r"?B. !x:real^1. x IN interval[a,b] ==> f(x) <= B")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"max (f(a:real^1)) (f b)") THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real", ← q r"{a:real^1,b}",
                        ← q r"max (f(a:real^1)) (f b)"] CONVEX_ON_CONVEX_HULL_BOUND) THEN
      ASM_REWRITE_TAC [← GSYM SEGMENT_CONVEX_HULL, SEGMENT_1] THEN
      DISCH_THEN MATCH_MP_TAC THEN SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
      REAL_ARITH_TAC,
      EXISTS_TAC (← q r"(&1 + abs B) + &2 * abs(f(midpoint(a,b):real^1))") THEN
      CONJ_TAC THENL [REAL_ARITH_TAC, ASM_REWRITE_TAC [INTERVAL_1]] THEN
      MATCH_MP_TAC CONVEX_BOUNDS_LEMMA THEN MAP_EVERY UNDISCH_TAC
       [← q r"f convex_on interval[a:real^1,b]",
        ← q r"!x:real^1. x IN interval[a,b] ==> f x <= B"] THEN
      ASM_SIMP_TAC [INTERVAL_1, ← REAL_ARITH (← q r"x <= b ==> x <= &1 + abs b")]])

  -- A convex function on R^1 is "piecewise monotone" in this precise sense.

  let CONVEX_IMP_PIECEWISE_MONOTONE ← prove
   r"!f s. f convex_on s /\ is_interval s
           ==> (!x y. x IN interior s /\ y IN interior s /\ drop x <= drop y
                      ==> f x <= f y) \/
               (!x y. x IN interior s /\ y IN interior s /\ drop x <= drop y
                      ==> f y <= f x) \/
               ?a. a IN interior s /\
                   (!x y. x IN s /\ y IN s /\
                          drop x <= drop y /\ drop y <= drop a
                          ==> f y <= f x) /\
                   (!x y. x IN s /\ y IN s /\
                          drop a <= drop x /\ drop x <= drop y
                          ==> f x <= f y)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [FORALL_LIFT, LIFT_DROP, DISJ_ASSOC] THEN
    REWRITE_TAC [REAL_NON_MONOTONE] THEN
    REWRITE_TAC [← TAUT (← q r"~p \/ q <=> p ==> q"), LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"b:real^1", ← q r"v:real^1"] THEN
    STRIP_TAC THENL
     [MATCH_MP_TAC (← TAUT (← q r"F ==> p")) THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real", ← q r"s:real^1->bool",
                        ← q r"u:real^1", ← q r"v:real^1", ← q r"b:real^1"]
          CONVEX_LOWER_SEGMENT) THEN
      ASM_SIMP_TAC [NOT_IMP, ← REWRITE_RULE [SUBSET] INTERIOR_SUBSET] THEN
      REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"interval[u:real^1,v] SUBSET interior s") ASSUME_TAC THENL
     [ASM_MESON_TAC [INTERVAL_SUBSET_IS_INTERVAL, IS_INTERVAL_CONVEX_1,
                     CONVEX_INTERIOR],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real", ← q r"interval[u:real^1,v]"] CONTINUOUS_ATTAINS_INF) THEN
    REWRITE_TAC [COMPACT_INTERVAL] THEN ANTS_TAC THENL
     [REWRITE_TAC [INTERVAL_NE_EMPTY_1] THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"interior s:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONVEX_ON_CONTINUOUS THEN
      ASM_MESON_TAC [CONVEX_ON_SUBSET, INTERIOR_SUBSET, OPEN_INTERIOR],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^1")] THEN
    STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
    CONJ_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"!x. x IN s ==> (f:real^1->real) a <= f x") ASSUME_TAC THENL
     [MATCH_MP_TAC CONVEX_LOCAL_GLOBAL_MINIMUM THEN
      EXISTS_TAC (← q r"interval(u:real^1,v)") THEN ASM_REWRITE_TAC [OPEN_INTERVAL] THEN
      CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        ASM_SIMP_TAC [IN_INTERVAL_1, REAL_LT_LE, DROP_EQ] THEN
        ASM_MESON_TAC [REAL_LE_LT, REAL_NOT_LE],
        ASM_MESON_TAC [INTERVAL_OPEN_SUBSET_CLOSED, SUBSET, INTERIOR_SUBSET]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN s /\ y IN s /\ x IN segment[a,y] ==> (f:real^1->real) x <= f y")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real", ← q r"s:real^1->bool",
              ← q r"a:real^1", ← q r"y:real^1", ← q r"x:real^1"] CONVEX_LOWER_SEGMENT) THEN
      ASM_SIMP_TAC [real_max] THEN ASM_MESON_TAC [INTERIOR_SUBSET, SUBSET],
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC])

  return { CONVEX_BOUNDS_LEMMA, CONVEX_IMP_BOUNDED_ON_INTERVAL, CONVEX_IMP_PIECEWISE_MONOTONE }

end HolMultiLib.Convex
