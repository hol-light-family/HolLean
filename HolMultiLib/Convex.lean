        DISCH_THEN (SUBST_ALL_TAC o SYM) THEN X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
        ASM_SIMP_TAC [DOT_LMUL, DOT_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [real_gt, ← GSYM REAL_LT_LDIV_EQ] THEN
        SUBGOAL_THEN (← q r"&0 < b / m") MP_TAC THENL
         [ASM_SIMP_TAC [REAL_LT_DIV],
          UNDISCH_THEN (← q r"&0 < b") (K ALL_TAC : thm → tactic) THEN
          SPEC_TAC ((← q r"b / m:real"), (← q r"b:real"))] THEN
        X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN DISCH_TAC THEN
        SUBGOAL_THEN
         (← q r"!x:real^N e. &0 < e /\ e < b /\ x IN t ==> norm(x - e % basis 1) < r")
        ASSUME_TAC THENL
         [MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"e:real"] THEN STRIP_TAC THEN
          SUBGOAL_THEN (← q r"r = norm(x:real^N)") SUBST1_TAC THENL
