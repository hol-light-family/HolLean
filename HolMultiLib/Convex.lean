/- ------------------------------------------------------------------------- -/
/- Some miscelleneous things that are convenient to prove here; affine set   -/
/- and affine hull; some convenient lemmas about common affine combinations. -/
/- (convex.ml 15-286)                                                        -/
/- ------------------------------------------------------------------------- -/

structure AFF where
  TRANSLATION_EQ_IMP : thm
  DIM_HYPERPLANE : thm
  DIM_EQ_HYPERPLANE : thm
  affine : thm
  AFFINE_ALT : thm
  AFFINE_SCALING : thm
  AFFINE_NEGATIONS : thm
  AFFINE_SUMS : thm
  AFFINE_DIFFERENCES : thm
  AFFINE_TRANSLATION_EQ : thm
  AFFINE_TRANSLATION : thm
  AFFINE_LINEAR_IMAGE : thm
  AFFINE_LINEAR_IMAGE_EQ : thm
  AFFINE_LINEAR_PREIMAGE : thm
  AFFINE_EMPTY : thm
  AFFINE_SING : thm
  AFFINE_SCALING_EQ : thm
  AFFINE_AFFINITY_EQ : thm
  AFFINE_AFFINITY : thm
  AFFINE_UNIV : thm
  AFFINE_HYPERPLANE : thm
  AFFINE_STANDARD_HYPERPLANE : thm
  AFFINE_INTERS : thm
  AFFINE_INTER : thm
  AFFINE_AFFINE_HULL : thm
  AFFINE_HULL_EQ : thm
  IS_AFFINE_HULL : thm
  AFFINE_HULL_UNIV : thm
  AFFINE_HULLS_EQ : thm
  AFFINE_HULL_TRANSLATION : thm
  AFFINE_HULL_LINEAR_IMAGE : thm
  IN_AFFINE_HULL_LINEAR_IMAGE : thm
  SAME_DISTANCES_TO_AFFINE_HULL : thm
  BILINEAR_IN_AFFINE_HULL : thm
  IN_AFFINE_ADD_MUL : thm
  IN_AFFINE_ADD_MUL_DIFF : thm
  IN_AFFINE_MUL_DIFF_ADD : thm
  IN_AFFINE_SUB_MUL_DIFF : thm
  AFFINE_DIFFS_SUBSPACE : thm
  deriving Inhabited

@[nospecialize]
def setupAFF [HolBase] (D : ConvexDeps) : ExceptT String IO AFF := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RING,
        SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, LINEAR_INVARIANT_RULE,
        add_linear_invariants, add_translation_invariants, GEOM_BASIS_MULTIPLE_TAC,
        GEOM_TRANSLATE_TAC, .. } := D
  let { DE_MORGAN_THM, DIMINDEX_GE_1, FINITE_INDEX_INRANGE, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMAGE_CONST, IMAGE_ID, IMAGE_o, IMP_CONJ, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_INTERS, IN_SING, IN_UNIV, LE_REFL,
        NOT_IN_EMPTY, .. } := D.core3
  let { REAL_ENTIRE, .. } := D.core4
  let { REAL_MUL_LINV, REAL_SUB_ADD, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM, .. } := D.core5
  let { UNWIND_THM1, o_DEF, .. } := D.core6
  let { HULLS_EQ, HULL_EQ, HULL_INC, HULL_INDUCT, IS_HULL, P_HULL, hull, .. } := D.misc
  let { AFFINITY_SCALING_TRANSLATION, DIM_SPAN, DIM_SPECIAL_HYPERPLANE, DOT_BASIS, DOT_LMUL,
        DOT_LSUB, DOT_RADD, DOT_RMUL, DOT_RSUB, .. } := D.vec1
  let { DOT_SYM, LINEAR_ADD, LINEAR_CMUL, LOWDIM_EQ_HYPERPLANE, NORM_EQ_SQUARE, .. } := D.vec2
  let { NORM_POS_LE, NORM_POW_2, .. } := D.vec3
  let { VECTOR_ADD_RDISTRIB, VECTOR_ADD_SYM, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, bilinear, dist, linear, subspace, .. } := D.vec4
  -- @@SCOPE END

  let TRANSLATION_EQ_IMP ← prove
   r"!P:(real^N->bool)->bool.
        (!a s. P(IMAGE (\x. a + x) s) <=> P s) <=>
        (!a s. P s ==> P (IMAGE (\x. a + x) s))"
   (REPEAT GEN_TAC THEN EQ_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"s:real^N->bool"] THEN
    EQ_TAC THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN FIRST_X_ASSUM
     (MP_TAC o SPECL [← q r"--a:real^N", ← q r"IMAGE (\x:real^N. a + x) s"]) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_o, o_DEF, IMAGE_ID,
                     ← VECTOR_ARITH (← q r"--a + a + x:real^N = x")])

  let DIM_HYPERPLANE ← prove
   r"!a:real^N. ~(a = vec 0) ==> dim {x | a dot x = &0} = dimindex(:N) - 1"
   (GEOM_BASIS_MULTIPLE_TAC 1 (← q r"a:real^N") THEN
    SIMP_TAC [VECTOR_MUL_EQ_0, DE_MORGAN_THM, DOT_LMUL, DOT_BASIS,
              DIMINDEX_GE_1, LE_REFL, REAL_ENTIRE, DIM_SPECIAL_HYPERPLANE])

  let DIM_EQ_HYPERPLANE ← prove
   r"!s. dim s = dimindex(:N) - 1 <=>
       ?a:real^N. ~(a = vec 0) /\ span s = {x | a dot x = &0}"
   (MESON_TAC [DIM_HYPERPLANE, LOWDIM_EQ_HYPERPLANE, DIM_SPAN])

  let affine ← new_definition
   r"affine s <=> !x y u v. x IN s /\ y IN s /\ (u + v = &1)
                          ==> (u % x + v % y) IN s"

  let AFFINE_ALT ← prove
   r"affine s <=> !x y u. x IN s /\ y IN s ==> ((&1 - u) % x + u % y) IN s"
   (REWRITE_TAC [affine] THEN
    MESON_TAC [← REAL_ARITH (← q r"(u + v = &1) <=> (u = &1 - v)")])

  let AFFINE_SCALING ← prove
   r"!s c. affine s ==> affine (IMAGE (\x. c % x) s)"
   (REWRITE_TAC [affine, IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
     (← q r"u % c % x + v % c % y = c % (u % x + v % y)")] THEN
    ASM_MESON_TAC [])

  let AFFINE_NEGATIONS ← prove
   r"!s. affine s ==> affine (IMAGE (--) s)"
   (REWRITE_TAC [affine, IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
     (← q r"u % --x + v % --y = --(u % x + v % y)")] THEN
    ASM_MESON_TAC [])

  let AFFINE_SUMS ← prove
   r"!s t. affine s /\ affine t ==> affine {x + y | x IN s /\ y IN t}"
   (REWRITE_TAC [affine, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
      (← q r"u % (a + b) + v % (c + d) = (u % a + v % c) + (u % b + v % d)")] THEN
    ASM_MESON_TAC [])

  let AFFINE_DIFFERENCES ← prove
   r"!s t. affine s /\ affine t ==> affine {x - y | x IN s /\ y IN t}"
   (REWRITE_TAC [affine, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
      (← q r"u % (a - b) + v % (c - d) = (u % a + v % c) - (u % b + v % d)")] THEN
    ASM_MESON_TAC [])

  let AFFINE_TRANSLATION_EQ ← prove
   r"!a:real^N s. affine (IMAGE (\x. a + x) s) <=> affine s"
   (REWRITE_TAC [AFFINE_ALT, IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_IMAGE, UNWIND_THM1, ← VECTOR_ARITH
     (← q r"(&1 - u) % (a + x) + u % (a + y) = a + z <=> (&1 - u) % x + u % y = z")])

  add_translation_invariants [AFFINE_TRANSLATION_EQ]

  let AFFINE_TRANSLATION ← prove
   r"!s a:real^N. affine s ==> affine (IMAGE (\x. a + x) s)"
   (REWRITE_TAC [AFFINE_TRANSLATION_EQ])

  let AFFINE_LINEAR_IMAGE ← prove
   r"!f s. affine s /\ linear f ==> affine(IMAGE f s)"
   (REWRITE_TAC [affine, FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [IN_IMAGE, linear] THEN MESON_TAC [])

  let AFFINE_LINEAR_IMAGE_EQ ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (affine (IMAGE f s) <=> affine s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE AFFINE_LINEAR_IMAGE))

  add_linear_invariants [AFFINE_LINEAR_IMAGE_EQ]

  let AFFINE_LINEAR_PREIMAGE ← prove
   r"!f:real^M->real^N s. linear f /\ affine s ==> affine {x | f(x) IN s}"
   (REWRITE_TAC [affine, IN_ELIM_THM] THEN SIMP_TAC [LINEAR_ADD, LINEAR_CMUL])

  let AFFINE_EMPTY ← prove
   r"affine {}"
   (REWRITE_TAC [affine, NOT_IN_EMPTY])

  let AFFINE_SING ← prove
   r"!x. affine {x}"
   (SIMP_TAC [AFFINE_ALT, IN_SING] THEN
    REWRITE_TAC [← GSYM VECTOR_ADD_RDISTRIB] THEN
    REWRITE_TAC [REAL_SUB_ADD, VECTOR_MUL_LID])

  let AFFINE_SCALING_EQ ← prove
   r"!s:real^N->bool c. affine (IMAGE (\x. c % x) s) <=> c = &0 \/ affine s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      MESON_TAC [AFFINE_SING, AFFINE_EMPTY],
      EQ_TAC THEN REWRITE_TAC [AFFINE_SCALING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP AFFINE_SCALING) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, IMAGE_ID]])

  let AFFINE_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        affine (IMAGE (\x. m % x + c) s) <=> m = &0 \/ affine s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, AFFINE_TRANSLATION_EQ,
                 AFFINE_SCALING_EQ, IMAGE_o])

  let AFFINE_AFFINITY ← prove
   r"!s m c:real^N. affine s ==> affine (IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [AFFINE_AFFINITY_EQ])

  let AFFINE_UNIV ← prove
   r"affine(UNIV:real^N->bool)"
   (REWRITE_TAC [affine, IN_UNIV])

  let AFFINE_HYPERPLANE ← prove
   r"!a b. affine {x | a dot x = b}"
   (REWRITE_TAC [affine, IN_ELIM_THM, DOT_RADD, DOT_RMUL] THEN
    CONV_TAC (fun t => REAL_RING t))

  let AFFINE_STANDARD_HYPERPLANE ← prove
   r"!b k. affine {x:real^N | x$k = b}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"b:real"] AFFINE_HYPERPLANE) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let AFFINE_INTERS ← prove
   r"(!s. s IN f ==> affine s) ==> affine(INTERS f)"
   (REWRITE_TAC [affine, IN_INTERS] THEN MESON_TAC [])

  let AFFINE_INTER ← prove
   r"!s t. affine s /\ affine t ==> affine(s INTER t)"
   (REWRITE_TAC [affine, IN_INTER] THEN MESON_TAC [])

  let AFFINE_AFFINE_HULL ← prove
   r"!s. affine(affine hull s)"
   (SIMP_TAC [P_HULL, AFFINE_INTERS])

  let AFFINE_HULL_EQ ← prove
   r"!s. (affine hull s = s) <=> affine s"
   (SIMP_TAC [HULL_EQ, AFFINE_INTERS])

  let IS_AFFINE_HULL ← prove
   r"!s. affine s <=> ?t. s = affine hull t"
   (GEN_TAC THEN MATCH_MP_TAC IS_HULL THEN SIMP_TAC [AFFINE_INTERS])

  let AFFINE_HULL_UNIV ← prove
   r"affine hull (:real^N) = (:real^N)"
   (REWRITE_TAC [AFFINE_HULL_EQ, AFFINE_UNIV])

  let AFFINE_HULLS_EQ ← prove
   r"!s t. s SUBSET affine hull t /\ t SUBSET affine hull s
         ==> affine hull s = affine hull t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HULLS_EQ THEN
    ASM_SIMP_TAC [AFFINE_INTERS])

  let AFFINE_HULL_TRANSLATION ← prove
   r"!a s. affine hull (IMAGE (\x. a + x) s) =
         IMAGE (\x. a + x) (affine hull s)"
   (REWRITE_TAC [hull] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [AFFINE_HULL_TRANSLATION]

  let AFFINE_HULL_LINEAR_IMAGE ← prove
   r"!f s. linear f
         ==> affine hull (IMAGE f s) = IMAGE f (affine hull s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    CONJ_TAC THEN MATCH_MP_TAC HULL_INDUCT THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN SIMP_TAC [FUN_IN_IMAGE, HULL_INC] THEN
    REWRITE_TAC [affine, IN_ELIM_THM] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THENL
     [FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_CMUL th)])) THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_ADD th)])) THEN
      REWRITE_TAC [IN_IMAGE] THEN
      MESON_TAC [← REWRITE_RULE [affine] AFFINE_AFFINE_HULL],
      ASM_SIMP_TAC [LINEAR_ADD, LINEAR_CMUL] THEN
      MESON_TAC [← REWRITE_RULE [affine] AFFINE_AFFINE_HULL]])

  add_linear_invariants [AFFINE_HULL_LINEAR_IMAGE]

  let IN_AFFINE_HULL_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s x.
        linear f /\ x IN affine hull s ==> (f x) IN affine hull (IMAGE f s)"
   (SIMP_TAC [AFFINE_HULL_LINEAR_IMAGE] THEN SET_TAC [])

  let SAME_DISTANCES_TO_AFFINE_HULL ← prove
   r"!s a b:real^N.
        (!x. x IN s ==> dist(x,a) = dist(x,b))
        ==> (!x. x IN affine hull s ==> dist(x,a) = dist(x,b))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC HULL_INDUCT THEN
    ASM_REWRITE_TAC [AFFINE_ALT, IN_ELIM_THM] THEN
    REWRITE_TAC [dist, NORM_EQ_SQUARE, NORM_POS_LE, ← VECTOR_ARITH
     (← q r"((&1 - u) % x + u % y) - a:real^N = (&1 - u) % (x - a) + u % (y - a)")] THEN
    REWRITE_TAC [NORM_POW_2, DOT_LMUL, DOT_RMUL, ← VECTOR_ARITH
     (← q r"(x + y) dot (x + y):real^N = (x dot x + y dot y) + &2 * x dot y")] THEN
    SIMP_TAC [DOT_LSUB, DOT_RSUB, DOT_SYM] THEN CONV_TAC (fun t => REAL_RING t))

  let BILINEAR_IN_AFFINE_HULL ← prove
   r"!(f:real^M->real^N->real^P) s t x y.
        bilinear f /\ x IN affine hull s /\ y IN affine hull t
        ==> f x y IN affine hull { f a b | a IN s /\ b IN t}"
   (REWRITE_TAC [bilinear, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    GEN_TAC THEN REPEAT DISCH_TAC THEN GEN_TAC THEN GEN_TAC THEN
    MATCH_MP_TAC HULL_INDUCT THEN CONJ_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC HULL_INDUCT THEN
      ASM_SIMP_TAC [AFFINE_LINEAR_PREIMAGE, AFFINE_AFFINE_HULL] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC HULL_INC THEN ASM SET_TAC [],
      REWRITE_TAC [← SET_RULE
       (← q r"{x | !y. y IN k ==> P x y} = INTERS {{x | P x y} | y IN k}")] THEN
      MATCH_MP_TAC AFFINE_INTERS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ASM_SIMP_TAC [AFFINE_LINEAR_PREIMAGE, AFFINE_AFFINE_HULL]])

  let IN_AFFINE_ADD_MUL ← prove
   r"!s a x:real^N d. affine s /\ a IN s /\ (a + x) IN s ==> (a + d % x) IN s"
   (REWRITE_TAC [affine] THEN REPEAT STRIP_TAC THEN
    SUBST1_TAC (← VECTOR_ARITH (← q r"a + d % x:real^N = (&1 - d) % a + d % (a + x)")) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let IN_AFFINE_ADD_MUL_DIFF ← prove
   r"!s a x y z:real^N.
        affine s /\ x IN s /\ y IN s /\ z IN s ==> (x + a % (y - z)) IN s"
   (REWRITE_TAC [affine] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"x + a % (y - z):real^N =
      &1 / &2 % ((&1 - &2 * a) % x + (&2 * a) % y) +
      &1 / &2 % ((&1 + &2 * a) % x + (-- &2 * a) % z)")] THEN
    FIRST_ASSUM MATCH_MP_TAC THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    CONJ_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    REAL_ARITH_TAC)

  let IN_AFFINE_MUL_DIFF_ADD ← prove
   r"!s a x y z:real^N.
        affine s /\ x IN s /\ y IN s /\ z IN s ==> a % (x - y) + z IN s"
   (ONCE_REWRITE_TAC [VECTOR_ADD_SYM] THEN
    SIMP_TAC [IN_AFFINE_ADD_MUL_DIFF])

  let IN_AFFINE_SUB_MUL_DIFF ← prove
   r"!s a x y z:real^N.
        affine s /\ x IN s /\ y IN s /\ z IN s ==> x - a % (y - z) IN s"
   (REWRITE_TAC [← VECTOR_ARITH (← q r"x - a % (y - z):real^N = x + a % (z - y)")] THEN
    SIMP_TAC [IN_AFFINE_ADD_MUL_DIFF])

  let AFFINE_DIFFS_SUBSPACE ← prove
   r"!s:real^N->bool a.
        affine s /\ a IN s ==> subspace {x - a | x IN s}"
   (REWRITE_TAC [subspace, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"vec 0:real^N = x - a <=> x = a"),
                 ← VECTOR_ARITH (← q r"x - a + y - a:real^N = z - a <=>
                              z = (a + &1 % (x - a)) + &1 % (y - a)"),
                 ← VECTOR_ARITH (← q r"c % (x - a):real^N = y - a <=>
                              y = a + c % (x - a)")] THEN
    MESON_TAC [IN_AFFINE_ADD_MUL_DIFF])

  return { TRANSLATION_EQ_IMP, DIM_HYPERPLANE, DIM_EQ_HYPERPLANE, affine, AFFINE_ALT,
           AFFINE_SCALING, AFFINE_NEGATIONS, AFFINE_SUMS, AFFINE_DIFFERENCES,
           AFFINE_TRANSLATION_EQ, AFFINE_TRANSLATION, AFFINE_LINEAR_IMAGE,
           AFFINE_LINEAR_IMAGE_EQ, AFFINE_LINEAR_PREIMAGE, AFFINE_EMPTY, AFFINE_SING,
           AFFINE_SCALING_EQ, AFFINE_AFFINITY_EQ, AFFINE_AFFINITY, AFFINE_UNIV,
           AFFINE_HYPERPLANE, AFFINE_STANDARD_HYPERPLANE, AFFINE_INTERS, AFFINE_INTER,
           AFFINE_AFFINE_HULL, AFFINE_HULL_EQ, IS_AFFINE_HULL, AFFINE_HULL_UNIV,
           AFFINE_HULLS_EQ, AFFINE_HULL_TRANSLATION, AFFINE_HULL_LINEAR_IMAGE,
           IN_AFFINE_HULL_LINEAR_IMAGE, SAME_DISTANCES_TO_AFFINE_HULL,
           BILINEAR_IN_AFFINE_HULL, IN_AFFINE_ADD_MUL, IN_AFFINE_ADD_MUL_DIFF,
           IN_AFFINE_MUL_DIFF_ADD, IN_AFFINE_SUB_MUL_DIFF, AFFINE_DIFFS_SUBSPACE }

/- ------------------------------------------------------------------------- -/
/- Explicit formulations for affine combinations.  (convex.ml 287-526)       -/
/- ------------------------------------------------------------------------- -/

structure AFX where
  AFFINE_VSUM : thm
  AFFINE_VSUM_STRONG : thm
  AFFINE_INDEXED : thm
  AFFINE_HULL_INDEXED : thm
  AFFINE : thm
  AFFINE_EXPLICIT : thm
  AFFINE_HULL_EXPLICIT : thm
  AFFINE_HULL_EXPLICIT_ALT : thm
  AFFINE_HULL_FINITE : thm
  AFFINE_HULL_0_EXPLICIT : thm
  deriving Inhabited

@[nospecialize]
def setupAFX [HolBase] (D : ConvexDeps) (BAFF : AFF) : ExceptT String IO AFX := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, REAL_RAT_REDUCE_CONV, num_CONV, VECTOR_ARITH, .. } := D
  let { ADD_SUB2, ADD_SYM, ARITH, ARITH_EQ, COND_RAND, COND_RATOR, CONTRAPOS_THM,
        DISJOINT_NUMSEG, EMPTY_SUBSET, EQ_ADD_LCANCEL, EXTENSION, FINITE_INTER, FINITE_NUMSEG,
        FINITE_RULES, FINITE_UNION, .. } := D.core1
  let { FUN_EQ_THM, INTER_COMM, INTER_IDEMPOT, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_NUMSEG, IN_SING, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, NEUTRAL_REAL_ADD, NOT_EXISTS_THM, NOT_IN_EMPTY, NUMSEG_ADD_SPLIT,
        NUMSEG_OFFSET_IMAGE, NUMSEG_SING, .. } := D.core3
  let { REAL_LE_MUL, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_OF_NUM_EQ, REAL_POS, RIGHT_AND_EXISTS_THM, SUBSET,
        SUBSET_EMPTY, .. } := D.core5
  let { SUM_ADD, SUM_CLAUSES, SUM_CLAUSES_NUMSEG, SUM_DEGENERATE, SUM_IMAGE, SUM_INCL_EXCL,
        SUM_LMUL, SUM_RESTRICT_SET, SUM_SING, SUM_SUPERSET, SUM_SUPPORT, SUM_UNION,
        SUPPORT_SUBSET, UNION_SUBSET, iterate, o_DEF, sum, support, .. } := D.core6
  let { HULL_UNIQUE, .. } := D.misc
  let { SUBSPACE_MUL, SUBSPACE_VSUM, .. } := D.vec3
  let { VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_SUB_LDISTRIB, VSUM_ADD, VSUM_CLAUSES, VSUM_CLAUSES_NUMSEG,
        VSUM_IMAGE, VSUM_INCL_EXCL, VSUM_LMUL, VSUM_RESTRICT_SET, VSUM_RMUL, VSUM_SING,
        VSUM_SUB, VSUM_SUPERSET, VSUM_UNION, .. } := D.vec4
  let { affine, AFFINE_DIFFS_SUBSPACE, .. } := BAFF
  -- @@SCOPE END

  let AFFINE_VSUM ← prove
   r"!s k u x:A->real^N.
        FINITE k /\ affine s /\ sum k u = &1 /\ (!i. i IN k ==> x i IN s)
        ==> vsum k (\i. u i % x i) IN s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, ← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
      ASM_CASES_TAC (← q r"k:A->bool = {}") THEN ASM_REWRITE_TAC [SUM_CLAUSES] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N"] AFFINE_DIFFS_SUBSPACE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"{x - a:real^N | x IN s}",
                      ← q r"(\i. u i % (x i - a)):A->real^N",
                      ← q r"k:A->bool"] SUBSPACE_VSUM) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC SUBSPACE_MUL THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      ASM_SIMP_TAC [VSUM_SUB, IN_ELIM_THM, VECTOR_SUB_LDISTRIB, VSUM_RMUL] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"x - &1 % a:real^N = y - a <=> x = y")] THEN
      ASM_MESON_TAC []])

  let AFFINE_VSUM_STRONG ← prove
   r"!s k u x:A->real^N.
        affine s /\
        sum k u = &1 /\
        (!i. i IN k ==> u i = &0 \/ x i IN s)
        ==> vsum k (\i. u i % x i) IN s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"vsum k (\i. u i % (x:A->real^N) i) =
      vsum {i | i IN k /\ ~(u i = &0)} (\i. u i % x i)")
    SUBST1_TAC THENL
     [MATCH_MP_TAC VSUM_SUPERSET THEN REWRITE_TAC [VECTOR_MUL_EQ_0] THEN
      SET_TAC [],
      MATCH_MP_TAC AFFINE_VSUM THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [SUM_DEGENERATE, ← REAL_ARITH (← q r"~(&1 = &0)")],
        FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_SUPERSET THEN ASM SET_TAC [],
        ASM SET_TAC []]])

  let AFFINE_INDEXED ← prove
   r"!s:real^N->bool.
        affine s <=>
            !k u x. (!i:num. 1 <= i /\ i <= k ==> x(i) IN s) /\
                    (sum (1..k) u = &1)
                    ==> vsum (1..k) (\i. u(i) % x(i)) IN s"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC AFFINE_VSUM THEN
      ASM_REWRITE_TAC [IN_NUMSEG, FINITE_NUMSEG],
      DISCH_TAC THEN REWRITE_TAC [affine] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"2")) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\n. if n = 1 then u else v:real")) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\n. if n = 1 then x else y:real^N")) THEN
      REWRITE_TAC [← ExceptT.mk (num_CONV (← q r"2")), SUM_CLAUSES_NUMSEG, VSUM_CLAUSES_NUMSEG,
        NUMSEG_SING, VSUM_SING, SUM_SING] THEN REWRITE_TAC [ARITH] THEN
      ASM_MESON_TAC []])

  let AFFINE_HULL_INDEXED ← prove
   r"!s. affine hull s =
        {y:real^N | ?k u x. (!i. 1 <= i /\ i <= k ==> x i IN s) /\
                            (sum (1..k) u = &1) /\
                            (vsum (1..k) (\i. u i % x i) = y)}"
   (GEN_TAC THEN MATCH_MP_TAC HULL_UNIQUE THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"1", ← q r"\i:num. &1", ← q r"\i:num. x:real^N"] THEN
      ASM_SIMP_TAC [FINITE_RULES, IN_SING, SUM_SING, VECTOR_MUL_LID, VSUM_SING,
                    REAL_POS, NUMSEG_SING],
      ALL_TAC,
      REWRITE_TAC [AFFINE_INDEXED, SUBSET, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      MESON_TAC []] THEN
    REWRITE_TAC [affine, IN_ELIM_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
     [← q r"k1:num", ← q r"u1:num->real", ← q r"x1:num->real^N",
      ← q r"k2:num", ← q r"u2:num->real", ← q r"x2:num->real^N"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"k1 + k2:num") THEN
    EXISTS_TAC (← q r"\i:num. if i <= k1 then u * u1(i) else v * u2(i - k1):real") THEN
    EXISTS_TAC (← q r"\i:num. if i <= k1 then x1(i) else x2(i - k1):real^N") THEN
    ASM_SIMP_TAC [NUMSEG_ADD_SPLIT, ← ARITH_RULE (← q r"1 <= x + 1 /\ x < x + 1"),
     IN_NUMSEG, SUM_UNION, VSUM_UNION, FINITE_NUMSEG, DISJOINT_NUMSEG,
     ← ARITH_RULE (← q r"k1 + 1 <= i ==> ~(i <= k1)")] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [ADD_SYM] NUMSEG_OFFSET_IMAGE] THEN
    ASM_SIMP_TAC [SUM_IMAGE, VSUM_IMAGE, EQ_ADD_LCANCEL, FINITE_NUMSEG] THEN
    ASM_SIMP_TAC [o_DEF, ADD_SUB2, SUM_LMUL, VSUM_LMUL, ← GSYM VECTOR_MUL_ASSOC,
                  FINITE_NUMSEG, REAL_MUL_RID] THEN
    ASM_MESON_TAC [REAL_LE_MUL, ← ARITH_RULE
      (← q r"i <= k1 + k2 /\ ~(i <= k1) ==> 1 <= i - k1 /\ i - k1 <= k2")])

  let AFFINE ← prove
   r"!V:real^N->bool.
     affine V <=>
         !(s:real^N->bool) (u:real^N->real).
             FINITE s /\ ~(s = {}) /\ s SUBSET V /\ sum s u = &1
             ==> vsum s (\x. u x % x) IN V"
   (GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC AFFINE_VSUM THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      REWRITE_TAC [affine] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
      STRIP_TAC THEN ASM_CASES_TAC (← q r"x:real^N = y") THENL
       [FIRST_X_ASSUM SUBST_ALL_TAC THEN
        ASM_REWRITE_TAC [← GSYM VECTOR_ADD_RDISTRIB, VECTOR_MUL_LID], ALL_TAC] THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{x:real^N,y}")) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\w. if w = x:real^N then u else v:real")) THEN
      ASM_SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, FINITE_RULES, NUMSEG_SING,
                    VSUM_SING, SUM_SING, SUBSET, IN_INSERT, NOT_IN_EMPTY] THEN
      ASM SET_TAC []])

  let AFFINE_EXPLICIT ← prove
   r"!s:real^N->bool.
        affine s <=>
            !t u. FINITE t /\ t SUBSET s /\ sum t u = &1
                  ==> vsum t (\x. u(x) % x) IN s"
   (GEN_TAC THEN REWRITE_TAC [AFFINE] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SUM_CLAUSES] THEN CONV_TAC REAL_RAT_REDUCE_CONV)

  let AFFINE_HULL_EXPLICIT ← prove
   r"!(p:real^N -> bool).
        affine hull p =
         {y | ?s u. FINITE s /\ ~(s = {}) /\ s SUBSET p /\
                    sum s u = &1 /\ vsum s (\v. u v % v) = y}"
   (GEN_TAC THEN MATCH_MP_TAC HULL_UNIQUE THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"{x:real^N}", ← q r"\v:real^N. &1:real"] THEN
      ASM_SIMP_TAC [FINITE_RULES, IN_SING, SUM_SING, VSUM_SING, VECTOR_MUL_LID] THEN
      SET_TAC [],
      REWRITE_TAC [affine, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
      EXISTS_TAC (← q r"(s UNION s'):real^N->bool") THEN
      EXISTS_TAC
        (← q r"\a:real^N. (\b:real^N.if (b IN s) then (u * (u' b)) else &0) a +
                    (\b:real^N.if (b IN s') then v * (u'' b) else &0) a") THEN
      REPEAT CONJ_TAC THENL
       [ASM_REWRITE_TAC [FINITE_UNION],
        ASM SET_TAC [],
        ASM_REWRITE_TAC [UNION_SUBSET],
        ASM_SIMP_TAC [← REWRITE_RULE [← REAL_ARITH (← q r"a + b = c + d <=> c = a + b - d")]
                       SUM_INCL_EXCL, ← GSYM SUM_RESTRICT_SET,
                      ← SET_RULE (← q r"{a | a IN (s:A->bool) /\ a IN s'} = s INTER s'"),
                      SUM_ADD, SUM_LMUL, REAL_MUL_RID,
                      FINITE_INTER, INTER_IDEMPOT] THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"(a INTER b) INTER a = a INTER b"),
                       ← SET_RULE (← q r"(a INTER b) INTER b = a INTER b"),
                       ← REAL_ARITH (← q r"(a + b) + (c + d) - (e + b) = (a + d) + c - e"),
                       ← REAL_ARITH (← q r"a + b - c = a <=> b = c")] THEN
      AP_TERM_TAC THEN REWRITE_TAC [INTER_COMM],
      ASM_SIMP_TAC [← REWRITE_RULE
                     [← VECTOR_ARITH (← q r"(a:real^N) + b = c + d <=> c = a + b - d")]
                     VSUM_INCL_EXCL, ← GSYM VSUM_RESTRICT_SET,
                    ← SET_RULE (← q r"{a | a IN (s:A->bool) /\ a IN s'} = s INTER s'"),
                    VSUM_ADD, FINITE_INTER, INTER_IDEMPOT, VECTOR_ADD_RDISTRIB,
                    ← GSYM VECTOR_MUL_ASSOC, VSUM_LMUL,
                    ← MESON [] (← q r"(if P then a else b) % (x:real^N) =
                             (if P then a % x else b % x)"),
                    VECTOR_MUL_LZERO, ← GSYM VSUM_RESTRICT_SET] THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"(a INTER b) INTER a = a INTER b"),
                       ← SET_RULE (← q r"(a INTER b) INTER b = a INTER b"),
                       ← VECTOR_ARITH
                        (← q r"((a:real^N) + b) + (c + d) - (e + b) = (a + d) + c - e"),
                       ← VECTOR_ARITH (← q r"(a:real^N) + b - c = a <=> b = c")] THEN
      AP_TERM_TAC THEN REWRITE_TAC [INTER_COMM]],
      ASM_CASES_TAC (← q r"(p:real^N->bool) = {}") THENL
        [FIRST_X_ASSUM SUBST_ALL_TAC THEN
         REWRITE_TAC [SUBSET_EMPTY, EMPTY_SUBSET] THEN ASM SET_TAC [],
         ALL_TAC] THEN
      REWRITE_TAC [AFFINE, SUBSET, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      ASM SET_TAC []])

  let AFFINE_HULL_EXPLICIT_ALT ← prove
   r"!(p:real^N -> bool).
        affine hull p =
         {y | ?s u. FINITE s /\ s SUBSET p /\
                    sum s u = &1 /\ vsum s (\v. u v % v) = y}"
   (GEN_TAC THEN REWRITE_TAC [AFFINE_HULL_EXPLICIT] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    GEN_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
    EQ_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM MP_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    SIMP_TAC [SUM_CLAUSES, REAL_OF_NUM_EQ, ARITH_EQ])

  let AFFINE_HULL_FINITE ← prove
   r"!s:real^N->bool.
        affine hull s = {y | ?u. sum s u = &1 /\ vsum s (\v. u v % v) = y}"
   (GEN_TAC THEN GEN_REWRITE_TAC id [EXTENSION] THEN
    REWRITE_TAC [AFFINE_HULL_EXPLICIT, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
     [MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"f:real^N->real"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"\x:real^N. if x IN t then f x else &0") THEN
      REWRITE_TAC [COND_RAND, COND_RATOR, VECTOR_MUL_LZERO] THEN
      REWRITE_TAC [← GSYM SUM_RESTRICT_SET, ← GSYM VSUM_RESTRICT_SET] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"t SUBSET s ==> {x | x IN s /\ x IN t} = t")],
      X_GEN_TAC (← q r"f:real^N->real") THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [SUM_CLAUSES, REAL_OF_NUM_EQ, ARITH] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"support (+) (f:real^N->real) s") THEN
      EXISTS_TAC (← q r"f:real^N->real") THEN
      MP_TAC (← ASSUME (← q r"sum s (f:real^N->real) = &1")) THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [sum] THEN
      REWRITE_TAC [iterate] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [NEUTRAL_REAL_ADD, REAL_OF_NUM_EQ, ARITH] THEN
      DISCH_THEN (K ALL_TAC) THEN
      UNDISCH_TAC (← q r"sum s (f:real^N->real) = &1") THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM SUM_SUPPORT] THEN
      ASM_CASES_TAC (← q r"support (+) (f:real^N->real) s = {}") THEN
      ASM_SIMP_TAC [SUM_CLAUSES, REAL_OF_NUM_EQ, ARITH] THEN
      DISCH_TAC THEN REWRITE_TAC [SUPPORT_SUBSET] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC VSUM_SUPERSET THEN
      REWRITE_TAC [SUPPORT_SUBSET] THEN
      REWRITE_TAC [support, IN_ELIM_THM, NEUTRAL_REAL_ADD] THEN
      MESON_TAC [VECTOR_MUL_LZERO]])

  let AFFINE_HULL_0_EXPLICIT ← prove
   r"!s:real^N->bool.
        vec 0 IN affine hull s <=>
        ?t u. FINITE t /\ ~(t = {}) /\ t SUBSET s /\
              ~(sum t u = &0) /\ vsum t (\x. u x % x) = vec 0"
   (GEN_TAC THEN REWRITE_TAC [AFFINE_HULL_EXPLICIT, IN_ELIM_THM] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN REWRITE_TAC [] THEN
    EQ_TAC THENL [MESON_TAC [← ExceptT.mk (REAL_RAT_REDUCE_CONV (← q r"&1 = &0"))], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x:real^N. inv(sum t u) * u x") THEN
    ASM_REWRITE_TAC [SUM_LMUL, VSUM_LMUL, ← GSYM VECTOR_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_RZERO])

  return { AFFINE_VSUM, AFFINE_VSUM_STRONG, AFFINE_INDEXED, AFFINE_HULL_INDEXED, AFFINE,
           AFFINE_EXPLICIT, AFFINE_HULL_EXPLICIT, AFFINE_HULL_EXPLICIT_ALT, AFFINE_HULL_FINITE,
           AFFINE_HULL_0_EXPLICIT }

/- ------------------------------------------------------------------------- -/
/- Stepping theorems and hence small special cases; some relations between  -/
/- affine hull and subspaces.  (convex.ml 532-786)                           -/
/- ------------------------------------------------------------------------- -/

structure AFS where
  AFFINE_HULL_EMPTY : thm
  AFFINE_HULL_EQ_EMPTY : thm
  AFFINE_HULL_FINITE_STEP_GEN : thm
  AFFINE_HULL_FINITE_STEP : thm
  AFFINE_HULL_2 : thm
  AFFINE_HULL_2_ALT : thm
  AFFINE_HULL_3 : thm
  AFFINE_HULL_0_2_EXPLICIT : thm
  AFFINE_HULL_0_3_EXPLICIT : thm
  AFFINE_HULL_INSERT_SUBSET_SPAN : thm
  AFFINE_HULL_INSERT_SPAN : thm
  AFFINE_HULL_SPAN : thm
  DIFFS_AFFINE_HULL_SPAN : thm
  AFFINE_HULL_SING : thm
  AFFINE_HULL_EQ_SING : thm
  AFFINE_HULL_SCALING : thm
  AFFINE_HULL_AFFINITY : thm
  deriving Inhabited

@[nospecialize]
def setupAFS [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFX : AFX) :
    ExceptT String IO AFS := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D
  let { COND_RAND, COND_RATOR, CONJ_ASSOC, DELETE, EMPTY_SUBSET, EQ_TRANS, FINITE_DELETE,
        FINITE_INSERT, FINITE_RULES, FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_UNWIND_THM2, IMAGE_CONST, IMAGE_DELETE_INJ, IMAGE_ID, IMAGE_o,
        IN_DELETE, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_UNIV, LEFT_IMP_EXISTS_THM, NOT_IMP, NOT_INSERT_EMPTY,
        NOT_IN_EMPTY, REAL_ADD_LDISTRIB, REAL_ADD_RID, .. } := D.core3
  let { REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_SYM, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM,
        SUBSET_EMPTY, SUBSET_REFL, .. } := D.core5
  let { SUM_CASES, SUM_CLAUSES, SUM_DELETE, SUM_SING, UNWIND_THM2, o_DEF, real_div, .. } :=
    D.core6
  let { HULL_IMAGE, HULL_SUBSET, HULL_UNIQUE, .. } := D.misc
  let { AFFINITY_SCALING_TRANSLATION, .. } := D.vec1
  let { SPAN_DELETE_0, SPAN_EMPTY, SPAN_EXPLICIT, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_RID, VECTOR_ADD_SUB, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0,
        VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_SUB_ADD, VECTOR_SUB_EQ,
        VECTOR_SUB_LDISTRIB, VECTOR_SUB_REFL, VSUM_CASES, VSUM_CLAUSES, VSUM_DELETE,
        VSUM_IMAGE, VSUM_RMUL, VSUM_SING, VSUM_SUB, VSUM_SUPERSET, .. } := D.vec4
  let { AFFINE_EMPTY, AFFINE_SCALING_EQ, AFFINE_AFFINE_HULL, AFFINE_HULL_TRANSLATION, .. } :=
    BAFF
  let { AFFINE_HULL_EXPLICIT, AFFINE_HULL_FINITE, .. } := BAFX
  -- @@SCOPE END

  let AFFINE_HULL_EMPTY ← prove
   r"affine hull {} = {}"
   (MATCH_MP_TAC HULL_UNIQUE THEN
    REWRITE_TAC [SUBSET_REFL, AFFINE_EMPTY, EMPTY_SUBSET])

  let AFFINE_HULL_EQ_EMPTY ← prove
   r"!s. (affine hull s = {}) <=> (s = {})"
   (GEN_TAC THEN EQ_TAC THEN
    MESON_TAC [SUBSET_EMPTY, HULL_SUBSET, AFFINE_HULL_EMPTY])

  let AFFINE_HULL_FINITE_STEP_GEN ← prove
   r"!P:real^N->real->bool.
        ((?u. (!x. x IN {} ==> P x (u x)) /\
              sum {} u = w /\ vsum {} (\x. u(x) % x) = y) <=>
         w = &0 /\ y = vec 0) /\
        (FINITE(s:real^N->bool) /\
         (!y. a IN s /\ P a y ==> P a (y / &2)) /\
         (!x y. a IN s /\ P a x /\ P a y ==> P a (x + y))
         ==> ((?u. (!x. x IN (a INSERT s) ==> P x (u x)) /\
                   sum (a INSERT s) u = w /\
                   vsum (a INSERT s) (\x. u(x) % x) = y) <=>
              ?v u. P a v /\ (!x. x IN s ==> P x (u x)) /\
                    sum s u = w - v /\
                    vsum s (\x. u(x) % x) = y - v % a))"
   (GEN_TAC THEN SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, NOT_IN_EMPTY] THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN s") THEN ASM_REWRITE_TAC [] THENL
     [ASM_SIMP_TAC [← SET_RULE (← q r"a IN s ==> a INSERT s = s")] THEN EQ_TAC THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
       [X_GEN_TAC (← q r"u:real^N->real") THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"(u:real^N->real) a / &2") THEN
        EXISTS_TAC (← q r"\x:real^N. if x = a then u x / &2 else u x"),
        MAP_EVERY X_GEN_TAC [← q r"v:real", ← q r"u:real^N->real"] THEN
        STRIP_TAC THEN
        EXISTS_TAC (← q r"\x:real^N. if x = a then u x + v else u x")] THEN
      ASM_SIMP_TAC [] THEN (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      ASM_SIMP_TAC [VSUM_CASES, SUM_CASES] THEN
      ASM_SIMP_TAC [← GSYM DELETE, SUM_DELETE, VSUM_DELETE] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"a IN s ==> {x | x IN s /\ x = a} = {a}")] THEN
      REWRITE_TAC [SUM_SING, VSUM_SING] THEN
      (CONJ_TAC THENL [REAL_ARITH_TAC, VECTOR_ARITH_TAC]),
      EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
       [X_GEN_TAC (← q r"u:real^N->real") THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"(u:real^N->real) a") THEN
        EXISTS_TAC (← q r"u:real^N->real") THEN ASM_SIMP_TAC [IN_INSERT] THEN
        REPEAT (FIRST_X_ASSUM (SUBST1_TAC o SYM)) THEN
        CONJ_TAC THENL [REAL_ARITH_TAC, VECTOR_ARITH_TAC],
        MAP_EVERY X_GEN_TAC [← q r"v:real", ← q r"u:real^N->real"] THEN
        STRIP_TAC THEN
        EXISTS_TAC (← q r"\x:real^N. if x = a then v:real else u x") THEN
        ASM_SIMP_TAC [IN_INSERT] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [], ALL_TAC] THEN
        ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
        ASM_SIMP_TAC [VSUM_CASES, SUM_CASES] THEN
        ASM_SIMP_TAC [← GSYM DELETE, SUM_DELETE, VSUM_DELETE] THEN
        ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> {x | x IN s /\ x = a} = {}")] THEN
        ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> s DELETE a = s")] THEN
        REWRITE_TAC [SUM_CLAUSES, VSUM_CLAUSES] THEN
        CONJ_TAC THENL [REAL_ARITH_TAC, VECTOR_ARITH_TAC]]])

  let AFFINE_HULL_FINITE_STEP ← prove
   r"((?u. sum {} u = w /\ vsum {} (\x. u(x) % x) = y) <=>
    w = &0 /\ y = vec 0) /\
   (FINITE(s:real^N->bool)
    ==> ((?u. sum (a INSERT s) u = w /\
              vsum (a INSERT s) (\x. u(x) % x) = y) <=>
         ?v u.  sum s u = w - v /\
                vsum s (\x. u(x) % x) = y - v % a))"
   (MATCH_ACCEPT_TAC (← REWRITE_RULE []
     (← ISPEC (← q r"\x:real^N y:real. T") AFFINE_HULL_FINITE_STEP_GEN)))

  let AFFINE_HULL_2 ← prove
   r"!a b. affine hull {a,b} =
         {u % a + v % b | u + v = &1}"
   (SIMP_TAC [AFFINE_HULL_FINITE, FINITE_INSERT, FINITE_RULES] THEN
    SIMP_TAC [AFFINE_HULL_FINITE_STEP, FINITE_INSERT, FINITE_RULES] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x - y = z:real <=> x = y + z"),
                 ← VECTOR_ARITH (← q r"x - y = z:real^N <=> x = y + z")] THEN
    REWRITE_TAC [VECTOR_ADD_RID, REAL_ADD_RID] THEN SET_TAC [])

  let AFFINE_HULL_2_ALT ← prove
   r"!a b. affine hull {a,b} = {a + u % (b - a) | u IN (:real)}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [AFFINE_HULL_2] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_UNIV, ← ARITH_RULE (← q r"u + v = &1 <=> v = &1 - u"),
      FORALL_UNWIND_THM2, UNWIND_THM2] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"u:real") THEN EXISTS_TAC (← q r"&1 - u") THEN
    VECTOR_ARITH_TAC)

  let AFFINE_HULL_3 ← prove
   r"affine hull {a,b,c} =
    { u % a + v % b + w % c | u + v + w = &1}"
   (SIMP_TAC [AFFINE_HULL_FINITE, FINITE_INSERT, FINITE_RULES] THEN
    SIMP_TAC [AFFINE_HULL_FINITE_STEP, FINITE_INSERT, FINITE_RULES] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x - y = z:real <=> x = y + z"),
                 ← VECTOR_ARITH (← q r"x - y = z:real^N <=> x = y + z")] THEN
    REWRITE_TAC [VECTOR_ADD_RID, REAL_ADD_RID] THEN SET_TAC [])

  let AFFINE_HULL_0_2_EXPLICIT ← prove
   r"!x y:real^N. vec 0 IN affine hull {x,y} <=>
                  ?a b. a % x + b % y = vec 0 /\ ~(a + b = &0)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [AFFINE_HULL_2, IN_ELIM_THM] THEN
    EQ_TAC THENL [MESON_TAC [← REAL_ARITH (← q r"~(&1 = &0)")], ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"a / (a + b):real", ← q r"b / (a + b):real"] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div] THEN
    ASM_REWRITE_TAC [← GSYM REAL_ADD_LDISTRIB, ← GSYM VECTOR_MUL_ASSOC,
                     ← GSYM VECTOR_ADD_LDISTRIB, VECTOR_MUL_RZERO] THEN
    ASM_SIMP_TAC [REAL_MUL_LINV])

  let AFFINE_HULL_0_3_EXPLICIT ← prove
   r"!x y z:real^N. vec 0 IN affine hull {x,y,z} <=>
                  ?a b c. a % x + b % y + c % z = vec 0 /\ ~(a + b + c = &0)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [AFFINE_HULL_3, IN_ELIM_THM] THEN
    EQ_TAC THENL [MESON_TAC [← REAL_ARITH (← q r"~(&1 = &0)")], ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"c:real"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"a / (a + b + c):real", ← q r"b / (a + b + c):real",
      ← q r"c / (a + b + c):real"] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div] THEN
    ASM_REWRITE_TAC [← GSYM REAL_ADD_LDISTRIB, ← GSYM VECTOR_MUL_ASSOC,
                     ← GSYM VECTOR_ADD_LDISTRIB, VECTOR_MUL_RZERO] THEN
    ASM_SIMP_TAC [REAL_MUL_LINV])

  let AFFINE_HULL_INSERT_SUBSET_SPAN ← prove
   r"!a:real^N s.
     affine hull (a INSERT s) SUBSET {a + v | v | v IN span {x - a | x IN s}}"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC id [SUBSET] THEN
    REWRITE_TAC [AFFINE_HULL_EXPLICIT, SPAN_EXPLICIT, IN_ELIM_THM] THEN
    REWRITE_TAC [SIMPLE_IMAGE, CONJ_ASSOC, FINITE_SUBSET_IMAGE] THEN
    REWRITE_TAC [← MESON []
     (← q r"(?s u. (?t. P t /\ s = f t) /\ Q s u) <=>
      (?t u. P t /\ Q (f t) u)")] THEN
    REWRITE_TAC [← MESON []
     (← q r"(?v. (?s u. P s /\ f s u = v) /\ (x = g a v)) <=>
      (?s u. ~(P s ==> ~(g a (f s u) = x)))")] THEN
    SIMP_TAC [VSUM_IMAGE, ← VECTOR_ARITH (← q r"x - a:real^N = y - a <=> x = y")] THEN
    REWRITE_TAC [o_DEF] THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"u:real^N->real"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC (SUBST1_TAC o SYM)) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"t DELETE (a:real^N)", ← q r"\x. (u:real^N->real)(x + a)"] THEN
    ASM_SIMP_TAC [FINITE_DELETE, VECTOR_SUB_ADD, ← SET_RULE
     (← q r"t SUBSET (a INSERT s) ==> t DELETE a SUBSET s")] THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"a + vsum t (\x. u x % (x - a)):real^N") THEN CONJ_TAC THENL
     [AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC VSUM_SUPERSET THEN
      REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ] THEN SET_TAC [],
      ASM_SIMP_TAC [VECTOR_SUB_LDISTRIB, FINITE_DELETE, VSUM_SUB] THEN
      ASM_REWRITE_TAC [VSUM_RMUL] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a + x - &1 % a:real^N = x")]])

  let AFFINE_HULL_INSERT_SPAN ← prove
   r"!a:real^N s.
        ~(a IN s)
        ==> affine hull (a INSERT s) =
            {a + v | v | v IN span {x - a | x IN s}}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [AFFINE_HULL_INSERT_SUBSET_SPAN] THEN REWRITE_TAC [SUBSET] THEN
    REWRITE_TAC [AFFINE_HULL_EXPLICIT, SPAN_EXPLICIT, IN_ELIM_THM] THEN
    REWRITE_TAC [SIMPLE_IMAGE, CONJ_ASSOC, FINITE_SUBSET_IMAGE] THEN
    REWRITE_TAC [← MESON []
     (← q r"(?s u. (?t. P t /\ s = f t) /\ Q s u) <=>
      (?t u. P t /\ Q (f t) u)")] THEN
    REWRITE_TAC [← MESON []
     (← q r"(?v. (?s u. P s /\ f s u = v) /\ (x = g a v)) <=>
      (?s u. ~(P s ==> ~(g a (f s u) = x)))")] THEN
    SIMP_TAC [VSUM_IMAGE, ← VECTOR_ARITH (← q r"x - a:real^N = y - a <=> x = y")] THEN
    REWRITE_TAC [o_DEF] THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"u:real^N->real"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC (SUBST1_TAC o SYM)) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(a:real^N) INSERT t",
      ← q r"\x. if x = a then &1 - sum t (\x. u(x - a))
           else (u:real^N->real)(x - a)"] THEN
    ASM_SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES] THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN t") THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    ASM_SIMP_TAC [FINITE_INSERT, NOT_INSERT_EMPTY,
                  ← SET_RULE (← q r"s SUBSET t ==> (a INSERT s) SUBSET (a INSERT t)")] THEN
    SUBGOAL_THEN (← q r"!x:real^N. x IN t ==> ~(x = a)") MP_TAC THENL
     [ASM SET_TAC [], SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC)] THEN
    CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_SIMP_TAC [VECTOR_SUB_LDISTRIB, FINITE_DELETE, VSUM_SUB] THEN
    ASM_REWRITE_TAC [VSUM_RMUL] THEN VECTOR_ARITH_TAC)

  let AFFINE_HULL_SPAN ← prove
   r"!a:real^N s.
        a IN s
        ==> (affine hull s =
             {a + v | v | v IN span {x - a | x | x IN (s DELETE a)}})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"s DELETE (a:real^N)"]
      AFFINE_HULL_INSERT_SPAN) THEN
    ASM_REWRITE_TAC [IN_DELETE] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let DIFFS_AFFINE_HULL_SPAN ← prove
   r"!a:real^N s.
        a IN s ==> {x - a | x IN affine hull s} = span {x - a | x IN s}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP AFFINE_HULL_SPAN) THEN
    REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o, o_DEF, VECTOR_ADD_SUB, IMAGE_ID] THEN
    SIMP_TAC [IMAGE_DELETE_INJ,
              ← VECTOR_ARITH (← q r"x - a:real^N = y - a <=> x = y")] THEN
    REWRITE_TAC [VECTOR_SUB_REFL, SPAN_DELETE_0])

  let AFFINE_HULL_SING ← prove
   r"!a. affine hull {a} = {a}"
   (SIMP_TAC [AFFINE_HULL_INSERT_SPAN, NOT_IN_EMPTY] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x | x | F} = {}"), SPAN_EMPTY] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x | x IN {a}} = {f a}"), VECTOR_ADD_RID])

  let AFFINE_HULL_EQ_SING ← prove
   r"!s a:real^N. affine hull s = {a} <=> s = {a}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [AFFINE_HULL_EMPTY] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [AFFINE_HULL_SING] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"~(s = {}) /\ s SUBSET {a} ==> s = {a}")) THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [HULL_SUBSET])

  let AFFINE_HULL_SCALING ← prove
   r"!s:real^N->bool c.
        affine hull (IMAGE (\x. c % x) s) =
        IMAGE (\x. c % x) (affine hull s)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THENL
     [ASM_SIMP_TAC [IMAGE_CONST, VECTOR_MUL_LZERO, AFFINE_HULL_EQ_EMPTY] THEN
      COND_CASES_TAC THEN REWRITE_TAC [AFFINE_HULL_EMPTY, AFFINE_HULL_SING],
      ALL_TAC] THEN
    MATCH_MP_TAC HULL_IMAGE THEN
    ASM_SIMP_TAC [AFFINE_SCALING_EQ, AFFINE_AFFINE_HULL] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"c % x = c % y <=> c % (x - y) = vec 0")] THEN
    ASM_SIMP_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EXISTS_TAC (← q r"inv c % x:real^N") THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, VECTOR_MUL_LID])

  let AFFINE_HULL_AFFINITY ← prove
   r"!s a:real^N c.
        affine hull (IMAGE (\x. c % x + a) s) =
        IMAGE (\x. c % x + a) (affine hull s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [AFFINITY_SCALING_TRANSLATION] THEN
    ASM_SIMP_TAC [IMAGE_o, AFFINE_HULL_TRANSLATION, AFFINE_HULL_SCALING])

  return { AFFINE_HULL_EMPTY, AFFINE_HULL_EQ_EMPTY, AFFINE_HULL_FINITE_STEP_GEN,
           AFFINE_HULL_FINITE_STEP, AFFINE_HULL_2, AFFINE_HULL_2_ALT, AFFINE_HULL_3,
           AFFINE_HULL_0_2_EXPLICIT, AFFINE_HULL_0_3_EXPLICIT, AFFINE_HULL_INSERT_SUBSET_SPAN,
           AFFINE_HULL_INSERT_SPAN, AFFINE_HULL_SPAN, DIFFS_AFFINE_HULL_SPAN, AFFINE_HULL_SING,
           AFFINE_HULL_EQ_SING, AFFINE_HULL_SCALING, AFFINE_HULL_AFFINITY }

/- ------------------------------------------------------------------------- -/
/- Convexity; some invariance theorems for convex sets.                      -/
/- (convex.ml 789-1049)                                                      -/
/- ------------------------------------------------------------------------- -/

structure CVX where
  convex : thm
  CONVEX_ALT : thm
  IN_CONVEX_SET : thm
  MIDPOINT_IN_CONVEX : thm
  CONVEX_CONTAINS_SEGMENT : thm
  CONVEX_CONTAINS_OPEN_SEGMENT : thm
  CONVEX_CONTAINS_SEGMENT_EQ : thm
  CONVEX_CONTAINS_SEGMENT_IMP : thm
  SEGMENT_SUBSET_CONVEX : thm
  CONVEX_CONTAINS : thm
  CONVEX_EMPTY : thm
  CONVEX_SING : thm
  CONVEX_UNIV : thm
  CONVEX_INTERS : thm
  CONVEX_INTER : thm
  CONVEX_HALFSPACE_LE : thm
  CONVEX_HALFSPACE_COMPONENT_LE : thm
  CONVEX_HALFSPACE_GE : thm
  CONVEX_HALFSPACE_COMPONENT_GE : thm
  CONVEX_HYPERPLANE : thm
  CONVEX_STANDARD_HYPERPLANE : thm
  CONVEX_HALFSPACE_LT : thm
  CONVEX_HALFSPACE_COMPONENT_LT : thm
  CONVEX_HALFSPACE_GT : thm
  CONVEX_HALFSPACE_COMPONENT_GT : thm
  CONVEX_STRIP_COMPONENT_LE : thm
  CONVEX_STRIP_COMPONENT_LT : thm
  CONVEX_HALFSPACE_SGN : thm
  CONVEX_HALFSPACE_COMPONENT_SGN : thm
  CONVEX_POSITIVE_ORTHANT : thm
  LIMPT_OF_CONVEX : thm
  TRIVIAL_LIMIT_WITHIN_CONVEX : thm
  CONVEX_TRANSLATION_EQ : thm
  CONVEX_TRANSLATION : thm
  CONVEX_LINEAR_IMAGE : thm
  CONVEX_LINEAR_IMAGE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupCVX [HolBase] (D : ConvexDeps) : ExceptT String IO CVX := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH,
        LINEAR_INVARIANT_RULE, add_linear_invariants, add_translation_invariants, .. } := D
  let { EQ_IMP, EXTENSION, FINITE_INDEX_INRANGE, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_INTERS, IN_SING, IN_UNIV, NOT_IN_EMPTY,
        REAL_ADD_RDISTRIB, REAL_CONVEX_BOUND_LT, .. } := D.core3
  let { REAL_LE_ADD, REAL_LE_ADD2, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_MIN, REAL_MIN_LT, .. } := D.core4
  let { REAL_MUL_LID, REAL_SGN_CASES, REAL_SGN_EQ, RIGHT_FORALL_IMP_THM, SUBSET, .. } :=
    D.core5
  let { UNWIND_THM1, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DOT_BASIS, DOT_LNEG, DOT_RADD, DOT_RMUL, .. } := D.vec1
  let { NORM_MUL, NORM_POS_LT, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_RDISTRIB, VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0,
        VECTOR_MUL_LID, VECTOR_SUB_EQ, dist, linear, midpoint, .. } := D.vec4
  let { ENDS_IN_SEGMENT, .. } := D.top3
  let { LIMPT_APPROACHABLE, LIMPT_SING, .. } := D.top4
  let { TRIVIAL_LIMIT_WITHIN, segment, .. } := D.top5
  -- @@SCOPE END

  let convex ← new_definition
   r"convex s <=>
        !x y u v. x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ (u + v = &1)
                  ==> (u % x + v % y) IN s"

  let CONVEX_ALT ← prove
   r"convex s <=> !x y u. x IN s /\ y IN s /\ &0 <= u /\ u <= &1
                        ==> ((&1 - u) % x + u % y) IN s"
   (REWRITE_TAC [convex] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 <= u /\ &0 <= v /\ (u + v = &1)
                          ==> v <= &1 /\ (u = &1 - v)"),
               ← REAL_ARITH (← q r"u <= &1 ==> &0 <= &1 - u /\ ((&1 - u) + u = &1)")])

  let IN_CONVEX_SET ← prove
   r"!s a b u.
        convex s /\ a IN s /\ b IN s /\ &0 <= u /\ u <= &1
        ==> ((&1 - u) % a + u % b) IN s"
   (MESON_TAC [CONVEX_ALT])

  let MIDPOINT_IN_CONVEX ← prove
   r"!s x y:real^N.
        convex s /\ x IN s /\ y IN s ==> midpoint(x,y) IN s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N", ← q r"y:real^N", ← q r"&1 / &2"]
          IN_CONVEX_SET) THEN
    ASM_REWRITE_TAC [midpoint] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    CONV_TAC (fun t => VECTOR_ARITH t))

  let CONVEX_CONTAINS_SEGMENT ← prove
   r"!s. convex s <=> !a b. a IN s /\ b IN s ==> segment[a,b] SUBSET s"
   (REWRITE_TAC [CONVEX_ALT, segment, SUBSET, IN_ELIM_THM] THEN MESON_TAC [])

  let CONVEX_CONTAINS_OPEN_SEGMENT ← prove
   r"!s. convex s <=> !a b. a IN s /\ b IN s ==> segment(a,b) SUBSET s"
   (ONCE_REWRITE_TAC [segment] THEN REWRITE_TAC [CONVEX_CONTAINS_SEGMENT] THEN
    SET_TAC [])

  let CONVEX_CONTAINS_SEGMENT_EQ ← prove
   r"!s:real^N->bool.
        convex s <=> !a b. segment[a,b] SUBSET s <=> a IN s /\ b IN s"
   (REWRITE_TAC [CONVEX_CONTAINS_SEGMENT, SUBSET] THEN
    MESON_TAC [ENDS_IN_SEGMENT])

  let CONVEX_CONTAINS_SEGMENT_IMP ← prove
   r"!s a b. convex s ==> (segment[a,b] SUBSET s <=> a IN s /\ b IN s)"
   (SIMP_TAC [CONVEX_CONTAINS_SEGMENT_EQ])

  let SEGMENT_SUBSET_CONVEX ← prove
   r"!s a b:real^N.
        convex s /\ a IN s /\ b IN s ==> segment[a,b] SUBSET s"
   (MESON_TAC [CONVEX_CONTAINS_SEGMENT])

  let CONVEX_CONTAINS ← prove
   r"!s a b x:real^N.
        convex s /\ a IN s /\ b IN s /\ x IN segment[a,b] ==> x IN s"
   (MESON_TAC [SEGMENT_SUBSET_CONVEX, SUBSET])

  let CONVEX_EMPTY ← prove
   r"convex {}"
   (REWRITE_TAC [convex, NOT_IN_EMPTY])

  let CONVEX_SING ← prove
   r"!a. convex {a}"
   (SIMP_TAC [convex, IN_SING, ← GSYM VECTOR_ADD_RDISTRIB, VECTOR_MUL_LID])

  let CONVEX_UNIV ← prove
   r"convex(UNIV:real^N->bool)"
   (REWRITE_TAC [convex, IN_UNIV])

  let CONVEX_INTERS ← prove
   r"(!s. s IN f ==> convex s) ==> convex(INTERS f)"
   (REWRITE_TAC [convex, IN_INTERS] THEN MESON_TAC [])

  let CONVEX_INTER ← prove
   r"!s t. convex s /\ convex t ==> convex(s INTER t)"
   (REWRITE_TAC [convex, IN_INTER] THEN MESON_TAC [])

  let CONVEX_HALFSPACE_LE ← prove
   r"!a b. convex {x | a dot x <= b}"
   (REWRITE_TAC [convex, IN_ELIM_THM, DOT_RADD, DOT_RMUL] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"(u + v) * b") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_ADD_RDISTRIB, REAL_LE_ADD2, REAL_LE_LMUL],
      ASM_MESON_TAC [REAL_MUL_LID, REAL_LE_REFL]])

  let CONVEX_HALFSPACE_COMPONENT_LE ← prove
   r"!a k. convex {x:real^N | x$k <= a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CONVEX_HALFSPACE_LE) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let CONVEX_HALFSPACE_GE ← prove
   r"!a b. convex {x:real^N | a dot x >= b}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"{x:real^N | a dot x >= b} = {x | --a dot x <= --b}")
     (fun th => REWRITE_TAC [th, CONVEX_HALFSPACE_LE]) THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, DOT_LNEG] THEN REAL_ARITH_TAC)

  let CONVEX_HALFSPACE_COMPONENT_GE ← prove
   r"!a k. convex {x:real^N | x$k >= a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CONVEX_HALFSPACE_GE) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let CONVEX_HYPERPLANE ← prove
   r"!a b. convex {x:real^N | a dot x = b}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"{x:real^N | a dot x = b} = {x | a dot x <= b} INTER {x | a dot x >= b}")
     (fun th => SIMP_TAC [th, CONVEX_INTER,
                          CONVEX_HALFSPACE_LE, CONVEX_HALFSPACE_GE]) THEN
    REWRITE_TAC [EXTENSION, IN_INTER, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  let CONVEX_STANDARD_HYPERPLANE ← prove
   r"!k a. convex {x:real^N | x$k = a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CONVEX_HYPERPLANE) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let CONVEX_HALFSPACE_LT ← prove
   r"!a b. convex {x | a dot x < b}"
   (REWRITE_TAC [convex, IN_ELIM_THM, DOT_RADD, DOT_RMUL] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CONVEX_BOUND_LT THEN
    ASM_REWRITE_TAC [])

  let CONVEX_HALFSPACE_COMPONENT_LT ← prove
   r"!a k. convex {x:real^N | x$k < a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CONVEX_HALFSPACE_LT) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let CONVEX_HALFSPACE_GT ← prove
   r"!a b. convex {x | a dot x > b}"
   (REWRITE_TAC [← REAL_ARITH (← q r"ax > b <=> --ax < --b")] THEN
    REWRITE_TAC [← GSYM DOT_LNEG, CONVEX_HALFSPACE_LT])

  let CONVEX_HALFSPACE_COMPONENT_GT ← prove
   r"!a k. convex {x:real^N | x$k > a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CONVEX_HALFSPACE_GT) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let CONVEX_STRIP_COMPONENT_LE ← prove
   r"!a k. convex {x:real^N | abs(x$k) <= a}"
   (REWRITE_TAC [← REAL_ARITH (← q r"abs(x) <= a <=> x <= a /\ x >= --a")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
    SIMP_TAC [CONVEX_HALFSPACE_COMPONENT_LE, CONVEX_HALFSPACE_COMPONENT_GE,
              CONVEX_INTER])

  let CONVEX_STRIP_COMPONENT_LT ← prove
   r"!a k. convex {x:real^N | abs(x$k) < a}"
   (REWRITE_TAC [← REAL_ARITH (← q r"abs(x) < a <=> x < a /\ x > --a")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
    SIMP_TAC [CONVEX_HALFSPACE_COMPONENT_LT, CONVEX_HALFSPACE_COMPONENT_GT,
              CONVEX_INTER])

  let CONVEX_HALFSPACE_SGN ← prove
   r"!a b. convex {x:real^N | real_sgn(a dot x) = b}"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"b = &0") THEN
    ASM_REWRITE_TAC [CONVEX_HYPERPLANE, REAL_SGN_EQ] THEN
    ASM_CASES_TAC (← q r"b = -- &1") THEN
    ASM_REWRITE_TAC [CONVEX_HALFSPACE_LT, REAL_SGN_EQ] THEN
    ASM_CASES_TAC (← q r"b = &1") THEN
    ASM_REWRITE_TAC [CONVEX_HALFSPACE_GT, REAL_SGN_EQ] THEN
    ASM_SIMP_TAC [CONVEX_EMPTY, ← MATCH_MP (← SET_RULE
     (← q r"(!x. P(real_sgn x)) ==> ~(P b) ==> {x | real_sgn(f x) = b} = {}"))
      REAL_SGN_CASES])

  let CONVEX_HALFSPACE_COMPONENT_SGN ← prove
   r"!a k. convex {x:real^N | real_sgn(x$k) = a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CONVEX_HALFSPACE_SGN) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let CONVEX_POSITIVE_ORTHANT ← prove
   r"convex {x:real^N | !i. 1 <= i /\ i <= dimindex(:N)
                          ==> &0 <= x$i}"
   (SIMP_TAC [convex, IN_ELIM_THM, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
              REAL_LE_MUL, REAL_LE_ADD])

  let LIMPT_OF_CONVEX ← prove
   r"!s x:real^N.
        convex s /\ x IN s ==> (x limit_point_of s <=> ~(s = {x}))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s = {x:real^N}") THEN ASM_REWRITE_TAC [LIMPT_SING] THEN
    SUBGOAL_THEN (← q r"?y:real^N. y IN s /\ ~(y = x)") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [LIMPT_APPROACHABLE] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    ABBREV_TAC (← q r"u = min (&1 / &2) (e / &2 / norm(y - x:real^N))") THEN
    SUBGOAL_THEN (← q r"&0 < u /\ u < &1") STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "u" THEN REWRITE_TAC [REAL_LT_MIN, REAL_MIN_LT] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_SIMP_TAC [REAL_HALF, REAL_LT_DIV, NORM_POS_LT, VECTOR_SUB_EQ],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"(&1 - u) % x + u % y:real^N") THEN REPEAT CONJ_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONVEX_ALT]) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE],
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, ← VECTOR_ARITH
       (← q r"(&1 - u) % x + u % y:real^N = x <=> u % (y - x) = vec 0")] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [dist, NORM_MUL, ← VECTOR_ARITH
       (← q r"((&1 - u) % x + u % y) - x:real^N = u % (y - x)")] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < u ==> abs u = u")] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= e / &2 /\ &0 < e ==> x < e")) THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
      ASM_REAL_ARITH_TAC])

  let TRIVIAL_LIMIT_WITHIN_CONVEX ← prove
   r"!s x:real^N.
        convex s /\ x IN s ==> (trivial_limit(at x within s) <=> s = {x})"
   (SIMP_TAC [TRIVIAL_LIMIT_WITHIN, LIMPT_OF_CONVEX])

  let CONVEX_TRANSLATION_EQ ← prove
   r"!a:real^N s. convex (IMAGE (\x. a + x) s) <=> convex s"
   (REWRITE_TAC [CONVEX_ALT, IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_IMAGE, UNWIND_THM1, ← VECTOR_ARITH
     (← q r"(&1 - u) % (a + x) + u % (a + y) = a + z <=> (&1 - u) % x + u % y = z")])

  add_translation_invariants [CONVEX_TRANSLATION_EQ]

  let CONVEX_TRANSLATION ← prove
   r"!s a:real^N. convex s ==> convex (IMAGE (\x. a + x) s)"
   (REWRITE_TAC [CONVEX_TRANSLATION_EQ])

  let CONVEX_LINEAR_IMAGE ← prove
   r"!f s. convex s /\ linear f ==> convex(IMAGE f s)"
   (REWRITE_TAC [convex, FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [IN_IMAGE, linear] THEN MESON_TAC [])

  let CONVEX_LINEAR_IMAGE_EQ ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (convex (IMAGE f s) <=> convex s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE CONVEX_LINEAR_IMAGE))

  add_linear_invariants [CONVEX_LINEAR_IMAGE_EQ]

  return { convex, CONVEX_ALT, IN_CONVEX_SET, MIDPOINT_IN_CONVEX, CONVEX_CONTAINS_SEGMENT,
           CONVEX_CONTAINS_OPEN_SEGMENT, CONVEX_CONTAINS_SEGMENT_EQ,
           CONVEX_CONTAINS_SEGMENT_IMP, SEGMENT_SUBSET_CONVEX, CONVEX_CONTAINS, CONVEX_EMPTY,
           CONVEX_SING, CONVEX_UNIV, CONVEX_INTERS, CONVEX_INTER, CONVEX_HALFSPACE_LE,
           CONVEX_HALFSPACE_COMPONENT_LE, CONVEX_HALFSPACE_GE, CONVEX_HALFSPACE_COMPONENT_GE,
           CONVEX_HYPERPLANE, CONVEX_STANDARD_HYPERPLANE, CONVEX_HALFSPACE_LT,
           CONVEX_HALFSPACE_COMPONENT_LT, CONVEX_HALFSPACE_GT, CONVEX_HALFSPACE_COMPONENT_GT,
           CONVEX_STRIP_COMPONENT_LE, CONVEX_STRIP_COMPONENT_LT, CONVEX_HALFSPACE_SGN,
           CONVEX_HALFSPACE_COMPONENT_SGN, CONVEX_POSITIVE_ORTHANT, LIMPT_OF_CONVEX,
           TRIVIAL_LIMIT_WITHIN_CONVEX, CONVEX_TRANSLATION_EQ, CONVEX_TRANSLATION,
           CONVEX_LINEAR_IMAGE, CONVEX_LINEAR_IMAGE_EQ }

/- ------------------------------------------------------------------------- -/
/- Explicit expressions for convexity in terms of arbitrary sums.            -/
/- (convex.ml 1053-1241)                                                     -/
/- ------------------------------------------------------------------------- -/

structure CVS where
  CONVEX_VSUM : thm
  CONVEX_VSUM_STRONG : thm
  CONVEX_INDEXED : thm
  CONVEX_EXPLICIT : thm
  CONVEX : thm
  CONVEX_FINITE : thm
  AFFINE_PCROSS : thm
  AFFINE_PCROSS_EQ : thm
  CONVEX_PCROSS : thm
  CONVEX_PCROSS_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupCVS [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) :
    ExceptT String IO CVS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV,
        num_CONV, .. } := D
  let { ARITH, COND_ID, COND_RAND, COND_RATOR, EQ_IMP, EXISTS_PASTECART, EXTENSION,
        FINITE_INDUCT_STRONG, FINITE_INSERT, FINITE_NUMSEG, FINITE_RULES, .. } := D.core1
  let { FORALL_IN_INSERT, FORALL_IN_PCROSS, FSTCART_PASTECART, FUN_EQ_THM, IMP_CONJ,
        IMP_IMP, .. } := D.core2
  let { IN_IMAGE, IN_INSERT, IN_NUMSEG, NOT_IN_EMPTY, NUMSEG_SING, PASTECART_IN_PCROSS,
        PCROSS_EMPTY, REAL_ADD_RID, REAL_ADD_SYM, .. } := D.core3
  let { REAL_EQ_LDIV_EQ, REAL_EQ_SUB_LADD, REAL_LE_DIV, REAL_LE_REFL, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_RINV, REAL_MUL_SYM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SNDCART_PASTECART, SUBSET, SUBSET_REFL, .. } := D.core5
  let { SUM_CLAUSES, SUM_CLAUSES_NUMSEG, SUM_DEGENERATE, SUM_LMUL, SUM_POS_EQ_0, SUM_POS_LE,
        SUM_RESTRICT_SET, SUM_SING, SUM_SUPERSET, real_div, .. } := D.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { PASTECART_ADD, PASTECART_CMUL, .. } := D.vec3
  let { VECTOR_ADD_RDISTRIB, VECTOR_ADD_RID, VECTOR_ADD_SYM, VECTOR_MUL_ASSOC,
        VECTOR_MUL_EQ_0, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VSUM_CLAUSES, VSUM_CLAUSES_NUMSEG,
        VSUM_EQ_0, VSUM_LMUL, VSUM_RESTRICT_SET, VSUM_SING, VSUM_SUPERSET, .. } := D.vec4
  let { affine, AFFINE_LINEAR_IMAGE, AFFINE_EMPTY, .. } := BAFF
  let { convex, CONVEX_EMPTY, CONVEX_LINEAR_IMAGE, .. } := BCVX
  -- @@SCOPE END

  let CONVEX_VSUM ← prove
   r"!s k u x:A->real^N.
        FINITE k /\ convex s /\ sum k u = &1 /\
        (!i. i IN k ==> &0 <= u i /\ x i IN s)
        ==> vsum k (\i. u i % x i) IN s"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"convex(s:real^N->bool)") THEN
    ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, FORALL_IN_INSERT] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    MAP_EVERY X_GEN_TAC [← q r"i:A", ← q r"k:A->bool"] THEN
    GEN_REWRITE_TAC (BINOP_CONV o DEPTH_CONV) [RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [IMP_IMP] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->real", ← q r"x:A->real^N"] THEN
    ASM_CASES_TAC (← q r"(u:A->real) i = &1") THENL
     [ASM_REWRITE_TAC [← REAL_ARITH (← q r"&1 + a  = &1 <=> a = &0")] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"vsum k (\i:A. u i % x(i):real^N) = vec 0")
       (fun th => ASM_SIMP_TAC [th, VECTOR_ADD_RID, VECTOR_MUL_LID]) THEN
      MATCH_MP_TAC VSUM_EQ_0 THEN REWRITE_TAC [VECTOR_MUL_EQ_0] THEN
      REPEAT STRIP_TAC THEN DISJ1_TAC THEN
      ASM_MESON_TAC [SUM_POS_EQ_0],
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\j:A. u(j) / (&1 - u(i))")) THEN
      ASM_REWRITE_TAC [real_div] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [SUM_LMUL, VSUM_LMUL, ← GSYM VECTOR_MUL_ASSOC] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [← GSYM real_div] THEN
      SUBGOAL_THEN (← q r"&0 < &1 - u(i:A)") ASSUME_TAC THENL
       [ASM_MESON_TAC [SUM_POS_LE, REAL_ADD_SYM, ← REAL_ARITH
         (← q r"&0 <= a /\ &0 <= b /\ b + a = &1 /\ ~(a = &1) ==> &0 < &1 - a")],
        ALL_TAC] THEN
      ASM_SIMP_TAC [REAL_LE_DIV, REAL_LT_IMP_LE] THEN
      ASM_SIMP_TAC [REAL_EQ_LDIV_EQ, REAL_MUL_LID, REAL_EQ_SUB_LADD] THEN
      DISCH_TAC THEN ONCE_REWRITE_TAC [VECTOR_ADD_SYM] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [convex]) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"vsum k (\j. (u j / (&1 - u(i:A))) % x(j) :real^N)",
        ← q r"x(i:A):real^N", ← q r"&1 - u(i:A)", ← q r"u(i:A):real"]) THEN
      REWRITE_TAC [real_div] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM VECTOR_MUL_ASSOC, VSUM_LMUL] THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, REAL_LT_IMP_NZ] THEN
      REWRITE_TAC [VECTOR_MUL_LID] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, VSUM_LMUL] THEN
      CONJ_TAC THENL [FIRST_X_ASSUM MATCH_MP_TAC, REAL_ARITH_TAC] THEN
      ASM_MESON_TAC [REAL_ADD_SYM]])

  let CONVEX_VSUM_STRONG ← prove
   r"!s k u x:A->real^N.
        convex s /\
        sum k u = &1 /\
        (!i. i IN k ==> &0 <= u i /\ (u i = &0 \/ x i IN s))
        ==> vsum k (\i. u i % x i) IN s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"vsum k (\i. u i % (x:A->real^N) i) =
      vsum {i | i IN k /\ ~(u i = &0)} (\i. u i % x i)")
    SUBST1_TAC THENL
     [MATCH_MP_TAC VSUM_SUPERSET THEN REWRITE_TAC [VECTOR_MUL_EQ_0] THEN
      SET_TAC [],
      MATCH_MP_TAC CONVEX_VSUM THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [SUM_DEGENERATE, ← REAL_ARITH (← q r"~(&1 = &0)")],
        FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_SUPERSET THEN ASM SET_TAC [],
        ASM SET_TAC []]])

  let CONVEX_INDEXED ← prove
   r"!s:real^N->bool.
        convex s <=>
            !k u x. (!i:num. 1 <= i /\ i <= k ==> &0 <= u(i) /\ x(i) IN s) /\
                    (sum (1..k) u = &1)
                    ==> vsum (1..k) (\i. u(i) % x(i)) IN s"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC CONVEX_VSUM THEN
      ASM_REWRITE_TAC [IN_NUMSEG, FINITE_NUMSEG],
      DISCH_TAC THEN REWRITE_TAC [convex] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"2")) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\n. if n = 1 then u else v:real")) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\n. if n = 1 then x else y:real^N")) THEN
      REWRITE_TAC [← ExceptT.mk (num_CONV (← q r"2")), SUM_CLAUSES_NUMSEG, VSUM_CLAUSES_NUMSEG,
        NUMSEG_SING, VSUM_SING, SUM_SING] THEN REWRITE_TAC [ARITH] THEN
      ASM_MESON_TAC []])

  let CONVEX_EXPLICIT ← prove
   r"!s:real^N->bool.
        convex s <=>
        !t u. FINITE t /\ t SUBSET s /\ (!x. x IN t ==> &0 <= u x) /\
              sum t u = &1
              ==> vsum t (\x. u(x) % x) IN s"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC CONVEX_VSUM THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      DISCH_TAC THEN REWRITE_TAC [convex] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
      ASM_CASES_TAC (← q r"x:real^N = y") THENL
       [ASM_SIMP_TAC [← GSYM VECTOR_ADD_RDISTRIB, VECTOR_MUL_LID], ALL_TAC] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{x:real^N,y}")) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\z:real^N. if z = x then u else v:real")) THEN
      ASM_SIMP_TAC [FINITE_INSERT, FINITE_RULES, SUM_CLAUSES, VSUM_CLAUSES,
                    NOT_IN_EMPTY] THEN
      ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY, REAL_ADD_RID, SUBSET] THEN
      REWRITE_TAC [VECTOR_ADD_RID] THEN ASM_MESON_TAC []])

  let CONVEX ← prove
   r"!V:real^N->bool.
     convex V <=>
         !(s:real^N->bool) (u:real^N->real).
             FINITE s /\ ~(s = {}) /\ s SUBSET V /\
             (!x. x IN s ==> &0 <= u x) /\ sum s u = &1
             ==> vsum s (\x. u x % x) IN V"
   (GEN_TAC THEN REWRITE_TAC [CONVEX_EXPLICIT] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SUM_CLAUSES] THEN CONV_TAC REAL_RAT_REDUCE_CONV)

  let CONVEX_FINITE ← prove
   r"!s:real^N->bool.
        FINITE s
        ==> (convex s <=>
                !u. (!x. x IN s ==> &0 <= u x) /\
                    sum s u = &1
                    ==> vsum s (\x. u(x) % x) IN s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONVEX_EXPLICIT] THEN
    EQ_TAC THENL [ASM_MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
    DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"u:real^N->real"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\x:real^N. if x IN t then u x else &0")) THEN
    ASM_SIMP_TAC [← GSYM SUM_RESTRICT_SET] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
    ASM_SIMP_TAC [VECTOR_MUL_LZERO, REAL_LE_REFL, ← GSYM VSUM_RESTRICT_SET] THEN
    ASM_SIMP_TAC [COND_ID, ← SET_RULE (← q r"t SUBSET s ==> {x | x IN s /\ x IN t} = t")])

  let AFFINE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        affine s /\ affine t ==> affine(s PCROSS t)"
   (REWRITE_TAC [affine, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [FORALL_IN_PCROSS, ← GSYM PASTECART_CMUL, PASTECART_ADD] THEN
    SIMP_TAC [PASTECART_IN_PCROSS])

  let AFFINE_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        affine(s PCROSS t) <=> s = {} \/ t = {} \/ affine s /\ affine t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, AFFINE_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, AFFINE_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [AFFINE_PCROSS] THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"fstcart:real^(M,N)finite_sum->real^M",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] AFFINE_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_FSTCART],
      MP_TAC (← ISPECL [← q r"sndcart:real^(M,N)finite_sum->real^N",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] AFFINE_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_SNDCART]] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART, PASTECART_IN_PCROSS,
                 FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ASM SET_TAC [])

  let CONVEX_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        convex s /\ convex t ==> convex(s PCROSS t)"
   (REWRITE_TAC [convex, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [FORALL_IN_PCROSS, ← GSYM PASTECART_CMUL, PASTECART_ADD] THEN
    SIMP_TAC [PASTECART_IN_PCROSS])

  let CONVEX_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        convex(s PCROSS t) <=> s = {} \/ t = {} \/ convex s /\ convex t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, CONVEX_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, CONVEX_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [CONVEX_PCROSS] THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"fstcart:real^(M,N)finite_sum->real^M",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] CONVEX_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_FSTCART],
      MP_TAC (← ISPECL [← q r"sndcart:real^(M,N)finite_sum->real^N",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] CONVEX_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_SNDCART]] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART, PASTECART_IN_PCROSS,
                 FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ASM SET_TAC [])

  return { CONVEX_VSUM, CONVEX_VSUM_STRONG, CONVEX_INDEXED, CONVEX_EXPLICIT, CONVEX,
           CONVEX_FINITE, AFFINE_PCROSS, AFFINE_PCROSS_EQ, CONVEX_PCROSS, CONVEX_PCROSS_EQ }

/- ------------------------------------------------------------------------- -/
/- Conic sets and conic hull.  (convex.ml 1245-1611)                         -/
/- ------------------------------------------------------------------------- -/

structure CON where
  conic : thm
  SUBSPACE_IMP_CONIC : thm
  CONIC_EMPTY : thm
  CONIC_UNIV : thm
  CONIC_INTERS : thm
  CONIC_LINEAR_IMAGE : thm
  CONIC_LINEAR_IMAGE_EQ : thm
  CONIC_MUL : thm
  CONIC_CONIC_HULL : thm
  CONIC_HULL_EQ : thm
  CONIC_HULL_UNIV : thm
  CONIC_NEGATIONS : thm
  CONIC_SPAN : thm
  CONIC_HULL_EXPLICIT : thm
  CONIC_HULL_AS_IMAGE : thm
  CONIC_HULL_POINTLESS_AS_IMAGE : thm
  CONIC_HULL_LINEAR_IMAGE : thm
  CONIC_HULL_IMAGE_SCALE : thm
  CONVEX_CONIC_HULL : thm
  CONIC_HALFSPACE_LE : thm
  CONIC_HALFSPACE_GE : thm
  CONIC_HULL_EMPTY : thm
  CONIC_CONTAINS_0 : thm
  CONIC_HULL_EQ_EMPTY : thm
  CONIC_SUMS : thm
  CONIC_PCROSS : thm
  CONIC_PCROSS_EQ : thm
  CONIC_POSITIVE_ORTHANT : thm
  CONIC_HULL_0 : thm
  CONIC_HULL_CONTAINS_0 : thm
  CONIC_HULL_EQ_SING : thm
  CONIC_HULL_INTER_AFFINE_HULL : thm
  SEPARATE_CLOSED_CONES : thm
  CONTINUOUS_ON_COMPACT_SURFACE_PROJECTION : thm
  deriving Inhabited

@[nospecialize]
def setupCON [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) :
    ExceptT String IO CON := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, SET_RULE, SET_TAC, SIMP_RULE, NORM_ARITH_TAC,
        LINEAR_INVARIANT_RULE, add_linear_invariants, .. } := D
  let { CONTRAPOS_THM, EMPTY_SUBSET, EQ_IMP, EXISTS_PASTECART, EXTENSION,
        FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FSTCART_PASTECART, FUN_EQ_THM, IMP_CONJ, IMP_IMP,
        INTER_COMM, IN_DELETE, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_INTERS, IN_SING, IN_UNIV, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_INSERT_EMPTY, NOT_IN_EMPTY,
        PASTECART_IN_PCROSS, PCROSS_EMPTY, REAL_ABS_INV, REAL_DIV_LMUL, REAL_DIV_REFL, .. } :=
    D.core3
  let { REAL_INV_EQ_0, REAL_INV_MUL, REAL_LE_ADD, REAL_LE_ADDL, REAL_LE_INV_EQ,
        REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_RMUL, REAL_LE_TRANS,
        REAL_LTE_ADD, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LE, REAL_LT_MIN,
        REAL_LT_MUL, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RNEG, REAL_MUL_RZERO, REAL_POS,
        REAL_SUB_LE, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SNDCART_PASTECART, SUBSET,
        SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_EMPTY, SUBSET_INTER, SUBSET_REFL,
        SUBSET_TRANS, .. } := D.core5
  let { o_DEF, real_abs, real_div, real_ge, real_max, .. } := D.core6
  let { HULL_EQ, HULL_INC, HULL_MINIMAL, HULL_MONO, HULL_SUBSET, HULL_UNIQUE, HULL_UNIV,
        P_HULL, .. } := D.misc
  let { DIST_POS_LE, DIST_SYM, DOT_RMUL, .. } := D.vec1
  let { EXISTS_DROP, LINEAR_CMUL, LINEAR_FSTCART, LINEAR_SNDCART, NORM_0, NORM_EQ_0, .. } :=
    D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, PASTECART_ADD, PASTECART_CMUL, REAL_ABS_NORM,
        SUBSPACE_SPAN, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_MUL_RNEG, VECTOR_MUL_RZERO, VECTOR_SUB_LDISTRIB, dist, subspace, .. } := D.vec4
  let { CLOSED_INTER_COMPACT, .. } := D.top1
  let { COMPACT_SPHERE, .. } := D.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_EQ, CONTINUOUS_ON_ID, CONTINUOUS_ON_INV,
        CONTINUOUS_ON_INVERSE, CONTINUOUS_ON_LIFT_NORM, CONTINUOUS_ON_MUL,
        CONTINUOUS_ON_SUBSET, .. } := D.top3
  let { IN_SPHERE_0, .. } := D.top4
  let { SEPARATE_COMPACT_CLOSED, .. } := D.top5
  let { affine, AFFINE_AFFINE_HULL, .. } := BAFF
  let { CONVEX_ALT, .. } := BCVX
  -- @@SCOPE END

  let conic ← new_definition
   r"conic s <=> !x c. x IN s /\ &0 <= c ==> (c % x) IN s"

  let SUBSPACE_IMP_CONIC ← prove
   r"!s. subspace s ==> conic s"
   (SIMP_TAC [subspace, conic])

  let CONIC_EMPTY ← prove
   r"conic {}"
   (REWRITE_TAC [conic, NOT_IN_EMPTY])

  let CONIC_UNIV ← prove
   r"conic (UNIV:real^N->bool)"
   (REWRITE_TAC [conic, IN_UNIV])

  let CONIC_INTERS ← prove
   r"(!s. s IN f ==> conic s) ==> conic(INTERS f)"
   (REWRITE_TAC [conic, IN_INTERS] THEN MESON_TAC [])

  let CONIC_LINEAR_IMAGE ← prove
   r"!f s. conic s /\ linear f ==> conic(IMAGE f s)"
   (REWRITE_TAC [conic, IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_IMAGE] THEN MESON_TAC [LINEAR_CMUL])

  let CONIC_LINEAR_IMAGE_EQ ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (conic (IMAGE f s) <=> conic s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE CONIC_LINEAR_IMAGE))

  add_linear_invariants [CONIC_LINEAR_IMAGE_EQ]

  let CONIC_MUL ← prove
   r"!s c x:real^N. conic s /\ x IN s /\ &0 <= c ==> (c % x) IN s"
   (REWRITE_TAC [conic] THEN MESON_TAC [])

  let CONIC_CONIC_HULL ← prove
   r"!s. conic(conic hull s)"
   (SIMP_TAC [P_HULL, CONIC_INTERS])

  let CONIC_HULL_EQ ← prove
   r"!s. (conic hull s = s) <=> conic s"
   (SIMP_TAC [HULL_EQ, CONIC_INTERS])

  let CONIC_HULL_UNIV ← prove
   r"conic hull (:real^N) = (:real^N)"
   (REWRITE_TAC [HULL_UNIV])

  let CONIC_NEGATIONS ← prove
   r"!s. conic s ==> conic (IMAGE (--) s)"
   (REWRITE_TAC [conic, RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_IMAGE, VECTOR_MUL_RNEG] THEN MESON_TAC [])

  let CONIC_SPAN ← prove
   r"!s. conic(span s)"
   (SIMP_TAC [SUBSPACE_IMP_CONIC, SUBSPACE_SPAN])

  let CONIC_HULL_EXPLICIT ← prove
   r"!s:real^N->bool. conic hull s = {c % x | &0 <= c /\ x IN s}"
   (GEN_TAC THEN MATCH_MP_TAC HULL_UNIQUE THEN
    REWRITE_TAC [conic, SUBSET, RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, IN_ELIM_THM] THEN
    REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"&1", ← q r"x:real^N"] THEN
      ASM_SIMP_TAC [REAL_POS, VECTOR_MUL_LID],
      REWRITE_TAC [VECTOR_MUL_ASSOC] THEN MESON_TAC [REAL_LE_MUL],
      MESON_TAC []])

  let CONIC_HULL_AS_IMAGE ← prove
   r"!s:real^N->bool.
        conic hull s = IMAGE (\z. drop(fstcart z) % sndcart z)
                             ({t | &0 <= drop t} PCROSS s)"
   (REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART, PASTECART_IN_PCROSS] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, CONIC_HULL_EXPLICIT] THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM EXISTS_DROP] THEN MESON_TAC [])

  let CONIC_HULL_POINTLESS_AS_IMAGE ← prove
   r"!s:real^N->bool.
        conic hull s DELETE vec 0 =
        IMAGE (\z. drop(fstcart z) % sndcart z)
              ({t | &0 < drop t} PCROSS (s DELETE vec 0))"
   (GEN_TAC THEN REWRITE_TAC [CONIC_HULL_AS_IMAGE, EXTENSION] THEN
    X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_IMAGE, IN_DELETE] THEN
    REWRITE_TAC [EXISTS_PASTECART, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    REWRITE_TAC [PASTECART_IN_PCROSS, IN_DELETE, IN_ELIM_THM] THEN
    REWRITE_TAC [← GSYM EXISTS_DROP, LEFT_AND_EXISTS_THM] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"a:real") THEN
    REWRITE_TAC [] THEN AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"b:real^N") THEN
    ASM_CASES_TAC (← q r"y:real^N = a % b") THEN ASM_REWRITE_TAC [VECTOR_MUL_EQ_0] THEN
    REWRITE_TAC [REAL_LT_LE] THEN MESON_TAC [])

  let CONIC_HULL_LINEAR_IMAGE ← prove
   r"!f s. linear f ==> conic hull (IMAGE f s) = IMAGE f (conic hull s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONIC_HULL_EXPLICIT] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE f {c % x | P c x} = {f(c % x) | P c x}")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{c % x | &0 <= c /\ x IN IMAGE f s} =
                          {c % f(x) | &0 <= c /\ x IN s}")] THEN
    DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← MATCH_MP LINEAR_CMUL th])))

  add_linear_invariants [CONIC_HULL_LINEAR_IMAGE]

  let CONIC_HULL_IMAGE_SCALE ← prove
   r"!c s:real^N->bool.
        (!x. x IN s ==> &0 < c x)
        ==> conic hull (IMAGE (\x. c x % x) s) = conic hull s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    CONJ_TAC THEN MATCH_MP_TAC HULL_MINIMAL THEN
    REWRITE_TAC [CONIC_CONIC_HULL, SUBSET, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [HULL_INC, CONIC_MUL, CONIC_CONIC_HULL, REAL_LT_IMP_LE] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"x:real^N = inv(c x) % c x % x") SUBST1_TAC THENL
     [REWRITE_TAC [VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, REAL_LT_IMP_NZ],
      MATCH_MP_TAC CONIC_MUL THEN
      ASM_SIMP_TAC [CONIC_CONIC_HULL, REAL_LE_INV_EQ, REAL_LT_IMP_LE] THEN
      MATCH_MP_TAC HULL_INC THEN ASM SET_TAC []])

  let CONVEX_CONIC_HULL ← prove
   r"!s:real^N->bool. convex s ==> convex (conic hull s)"
   (REWRITE_TAC [CONIC_HULL_EXPLICIT] THEN
    REWRITE_TAC [CONVEX_ALT, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_THM, IMP_IMP] THEN
    X_GEN_TAC (← q r"s:real^N->bool") THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^N"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"d:real", ← q r"y:real^N"] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"u:real") THEN STRIP_TAC THEN REWRITE_TAC [VECTOR_MUL_ASSOC] THEN
    ASM_CASES_TAC (← q r"(&1 - u) * c = &0") THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN
      ASM_MESON_TAC [REAL_LE_MUL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < (&1 - u) * c + u * d") ASSUME_TAC THENL
     [MATCH_MP_TAC REAL_LTE_ADD THEN ASM_REWRITE_TAC [REAL_LT_LE] THEN
      CONJ_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    EXISTS_TAC (← q r"(&1 - u) * c + u * d:real") THEN
    EXISTS_TAC (← q r"((&1 - u) * c) / ((&1 - u) * c + u * d) % x +
                (u * d) / ((&1 - u) * c + u * d) % y:real^N") THEN
    REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_DIV_LMUL, REAL_LT_IMP_NZ] THEN
    ASM_SIMP_TAC [REAL_LE_ADD, REAL_LE_MUL, REAL_SUB_LE] THEN
    ASM_SIMP_TAC [← REAL_FIELD
     (← q r"&0 < u + v ==> u / (u + v) = &1 - (v / (u + v))")] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ] THEN
    ASM_SIMP_TAC [REAL_MUL_LZERO, REAL_LE_MUL, REAL_MUL_LID, REAL_LE_ADDL,
                  REAL_SUB_LE])

  let CONIC_HALFSPACE_LE ← prove
   r"!a. conic {x | a dot x <= &0}"
   (REWRITE_TAC [conic, IN_ELIM_THM, DOT_RMUL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a <= &0 <=> &0 <= --a")] THEN
    SIMP_TAC [← GSYM REAL_MUL_RNEG, REAL_LE_MUL])

  let CONIC_HALFSPACE_GE ← prove
   r"!a. conic {x | a dot x >= &0}"
   (SIMP_TAC [conic, IN_ELIM_THM, DOT_RMUL, real_ge, REAL_LE_MUL])

  let CONIC_HULL_EMPTY ← prove
   r"conic hull {} = {}"
   (MATCH_MP_TAC HULL_UNIQUE THEN
    REWRITE_TAC [SUBSET_REFL, CONIC_EMPTY, EMPTY_SUBSET])

  let CONIC_CONTAINS_0 ← prove
   r"!s:real^N->bool. conic s ==> (vec 0 IN s <=> ~(s = {}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"x:real^N")) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [conic]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x:real^N", ← q r"&0"]) THEN
    ASM_REWRITE_TAC [REAL_POS, VECTOR_MUL_LZERO])

  let CONIC_HULL_EQ_EMPTY ← prove
   r"!s. (conic hull s = {}) <=> (s = {})"
   (GEN_TAC THEN EQ_TAC THEN
    MESON_TAC [SUBSET_EMPTY, HULL_SUBSET, CONIC_HULL_EMPTY])

  let CONIC_SUMS ← prove
   r"!s t. conic s /\ conic t ==> conic {x + y:real^N | x IN s /\ y IN t}"
   (REWRITE_TAC [conic, IN_ELIM_THM] THEN
    MESON_TAC [VECTOR_ADD_LDISTRIB])

  let CONIC_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        conic s /\ conic t ==> conic(s PCROSS t)"
   (REWRITE_TAC [conic, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [FORALL_IN_PCROSS, ← GSYM PASTECART_CMUL, PASTECART_ADD] THEN
    SIMP_TAC [PASTECART_IN_PCROSS])

  let CONIC_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        conic(s PCROSS t) <=> s = {} \/ t = {} \/ conic s /\ conic t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, CONIC_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, CONIC_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [CONIC_PCROSS] THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"fstcart:real^(M,N)finite_sum->real^M",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] CONIC_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_FSTCART],
      MP_TAC (← ISPECL [← q r"sndcart:real^(M,N)finite_sum->real^N",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] CONIC_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_SNDCART]] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART, PASTECART_IN_PCROSS,
                 FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ASM SET_TAC [])

  let CONIC_POSITIVE_ORTHANT ← prove
   r"conic {x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> &0 <= x$i}"
   (SIMP_TAC [conic, IN_ELIM_THM, REAL_LE_MUL, VECTOR_MUL_COMPONENT])

  let CONIC_HULL_0 ← prove
   r"conic hull {vec 0} = {vec 0}"
   (REWRITE_TAC [EXTENSION, IN_SING, CONIC_HULL_EXPLICIT, IN_ELIM_THM] THEN
    MESON_TAC [VECTOR_MUL_RZERO, REAL_POS])

  let CONIC_HULL_CONTAINS_0 ← prove
   r"!s:real^N->bool. vec 0 IN conic hull s <=> ~(s = {})"
   (SIMP_TAC [CONIC_CONTAINS_0, CONIC_HULL_EQ_EMPTY, CONIC_CONIC_HULL])

  let CONIC_HULL_EQ_SING ← prove
   r"!s x:real^N. conic hull s = {x} <=> s = {vec 0} /\ x = vec 0"
   (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [CONIC_HULL_0] THEN
    ASM_CASES_TAC (← q r"s SUBSET {x:real^N}") THENL
     [ALL_TAC, ASM_MESON_TAC [HULL_SUBSET]] THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o MATCH_MP (← SET_RULE
     (← q r"s SUBSET {a} ==> s = {} \/ s = {a}"))) THEN
    ASM_REWRITE_TAC [CONIC_HULL_EMPTY, NOT_INSERT_EMPTY] THEN
    ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN MP_TAC (← ISPEC (← q r"{x:real^N}") CONIC_HULL_CONTAINS_0) THEN
    ASM_REWRITE_TAC [IN_SING, NOT_INSERT_EMPTY])

  let CONIC_HULL_INTER_AFFINE_HULL ← prove
   r"!s f:real^N->bool.
        f SUBSET s /\ ~(vec 0 IN affine hull s)
        ==> (conic hull f) INTER (affine hull s) = f"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET_INTER, HULL_SUBSET] THEN
    CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [HULL_MONO, HULL_SUBSET, SUBSET_TRANS]] THEN
    REWRITE_TAC [SUBSET, IN_INTER, CONIC_HULL_EXPLICIT,
                 IMP_CONJ, FORALL_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^N"] THEN
    ASM_CASES_TAC (← q r"c = &1") THEN ASM_SIMP_TAC [VECTOR_MUL_LID] THEN
    REPEAT STRIP_TAC THEN
    UNDISCH_TAC (← q r"~((vec 0:real^N) IN affine hull s)") THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_THEN (K ALL_TAC) THEN
    SUBGOAL_THEN (← q r"vec 0:real^N = inv(&1 - c) % c % x + (&1 - inv(&1 - c)) % x")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC, ← GSYM VECTOR_ADD_RDISTRIB] THEN
      REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ1_TAC THEN
      UNDISCH_TAC (← q r"~(c = &1)") THEN CONV_TAC (fun t => REAL_FIELD t),
      MP_TAC (← ISPEC (← q r"affine hull s:real^N->bool") affine) THEN
      REWRITE_TAC [AFFINE_AFFINE_HULL] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [HULL_INC, SUBSET],
        UNDISCH_TAC (← q r"~(c = &1)") THEN CONV_TAC (fun t => REAL_FIELD t)]])

  let SEPARATE_CLOSED_CONES ← prove
   r"!c d:real^N->bool.
        conic c /\ closed c /\ conic d /\ closed d /\ c INTER d SUBSET {vec 0}
        ==> ?e. &0 < e /\
                !x y. x IN c /\ y IN d
                      ==> dist(x,y) >= e * max (norm x) (norm y)"
   (SUBGOAL_THEN
     (← q r"!c d:real^N->bool.
          conic c /\ closed c /\ conic d /\ closed d /\ c INTER d SUBSET {vec 0}
          ==> ?e. &0 < e /\
                  !x y. x IN c /\ y IN d ==> dist(x,y)
                        >= e * norm x")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [real_ge] THEN
      MP_TAC (← ISPECL [← q r"c INTER sphere(vec 0:real^N,&1)", ← q r"d:real^N->bool"]
        SEPARATE_COMPACT_CLOSED) THEN
      ASM_SIMP_TAC [CLOSED_INTER_COMPACT, COMPACT_SPHERE] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"c INTER d SUBSET {a} ==> ~(a IN s) ==> (c INTER s) INTER d = {}"))) THEN
        REWRITE_TAC [IN_SPHERE_0, NORM_0] THEN REAL_ARITH_TAC,
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
        REWRITE_TAC [IN_INTER, IN_SPHERE_0] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
        ASM_REWRITE_TAC [DIST_POS_LE, REAL_MUL_RZERO, NORM_0] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"inv(norm x) % x:real^N", ← q r"inv(norm(x:real^N)) % y:real^N"]) THEN
        REWRITE_TAC [dist, NORM_MUL, ← GSYM VECTOR_SUB_LDISTRIB] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"abs x * a = a * abs x")] THEN
        REWRITE_TAC [REAL_ABS_INV, ← GSYM real_div, REAL_ABS_NORM] THEN
        ASM_SIMP_TAC [REAL_LE_RDIV_EQ, NORM_POS_LT] THEN
        DISCH_THEN MATCH_MP_TAC THEN
        ASM_SIMP_TAC [REAL_DIV_REFL, NORM_EQ_0] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [conic]) THEN
        CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_SIMP_TAC [REAL_LE_INV_EQ, NORM_POS_LE]],
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPECL [← q r"c:real^N->bool", ← q r"d:real^N->bool"] th) THEN
              MP_TAC (← SPECL [← q r"d:real^N->bool", ← q r"c:real^N->bool"] th))) THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, real_ge] THEN
      X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"min d e:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
      REWRITE_TAC [real_max] THEN COND_CASES_TAC THEN
      MATCH_MP_TAC REAL_LE_TRANS THENL
       [EXISTS_TAC (← q r"d * norm(y:real^N)") THEN ONCE_REWRITE_TAC [DIST_SYM],
        EXISTS_TAC (← q r"e * norm(x:real^N)")] THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC REAL_LE_RMUL THEN NORM_ARITH_TAC])

  let CONTINUOUS_ON_COMPACT_SURFACE_PROJECTION ← do
    let lemma ← prove
     r"!s:real^N->real^N p srf:real^N->bool pnc.
            compact srf /\ srf SUBSET pnc /\
            IMAGE s pnc SUBSET srf /\ (!x. x IN srf ==> s x = x) /\
            p continuous_on pnc /\
            (!x. x IN pnc ==> s(p x) = s x /\ p(s x) = p x)
            ==> s continuous_on pnc"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_EQ THEN
      EXISTS_TAC (← q r"(s:real^N->real^N) o (p:real^N->real^N)") THEN
      CONJ_TAC THENL [ASM_SIMP_TAC [o_DEF], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"IMAGE (p:real^N->real^N) pnc = IMAGE p srf") SUBST1_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_ON_INVERSE THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ASM SET_TAC []]])
    prove
     r"!s:real^N->bool v d:real^N->real.
          compact s /\ s SUBSET (v DELETE (vec 0)) /\ conic v /\
          (!x k. x IN v DELETE (vec 0) ==> (&0 < k /\ (k % x) IN s <=> d x = k))
          ==> (\x. d x % x) continuous_on (v DELETE (vec 0))"
     (REWRITE_TAC [conic, IN_DELETE, SUBSET] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma THEN
      MAP_EVERY EXISTS_TAC [← q r"\x:real^N. inv(norm x) % x", ← q r"s:real^N->bool"] THEN
      ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_MUL THEN SIMP_TAC [o_DEF, CONTINUOUS_ON_ID] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        SIMP_TAC [IN_DELETE, NORM_EQ_0, ← SIMP_RULE [o_DEF] CONTINUOUS_ON_LIFT_NORM],
        REWRITE_TAC [IN_UNIV, IN_DELETE]] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"&1"]) THEN
        ASM_REWRITE_TAC [VECTOR_MUL_LID, REAL_LT_01, IN_DELETE] THEN
        ASM_MESON_TAC [VECTOR_MUL_LID, SUBSET, IN_DELETE],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN CONJ_TAC THENL
       [FIRST_ASSUM (MP_TAC o SPECL
         [← q r"inv(norm x) % x:real^N", ← q r"norm x * (d:real^N->real) x"]) THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"(d:real^N->real) x"]) THEN
        ASM_SIMP_TAC [VECTOR_MUL_EQ_0, REAL_INV_EQ_0, NORM_EQ_0] THEN STRIP_TAC THEN
        ASM_SIMP_TAC [REAL_LE_INV_EQ, NORM_POS_LE, REAL_LT_MUL, NORM_POS_LT] THEN
        ASM_SIMP_TAC [VECTOR_MUL_ASSOC, NORM_EQ_0, ← REAL_FIELD
         (← q r"~(n = &0) ==> (n * d) * inv n = d")],
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"(d:real^N->real) x"]) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
        ASM_SIMP_TAC [NORM_MUL, VECTOR_MUL_ASSOC, REAL_INV_MUL] THEN
        ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE] THEN
        ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < x ==> (inv(x) * y) * x = y")]])

  return { conic, SUBSPACE_IMP_CONIC, CONIC_EMPTY, CONIC_UNIV, CONIC_INTERS,
           CONIC_LINEAR_IMAGE, CONIC_LINEAR_IMAGE_EQ, CONIC_MUL, CONIC_CONIC_HULL,
           CONIC_HULL_EQ, CONIC_HULL_UNIV, CONIC_NEGATIONS, CONIC_SPAN, CONIC_HULL_EXPLICIT,
           CONIC_HULL_AS_IMAGE, CONIC_HULL_POINTLESS_AS_IMAGE, CONIC_HULL_LINEAR_IMAGE,
           CONIC_HULL_IMAGE_SCALE, CONVEX_CONIC_HULL, CONIC_HALFSPACE_LE, CONIC_HALFSPACE_GE,
           CONIC_HULL_EMPTY, CONIC_CONTAINS_0, CONIC_HULL_EQ_EMPTY, CONIC_SUMS, CONIC_PCROSS,
           CONIC_PCROSS_EQ, CONIC_POSITIVE_ORTHANT, CONIC_HULL_0, CONIC_HULL_CONTAINS_0,
           CONIC_HULL_EQ_SING, CONIC_HULL_INTER_AFFINE_HULL, SEPARATE_CLOSED_CONES,
           CONTINUOUS_ON_COMPACT_SURFACE_PROJECTION }

/- ------------------------------------------------------------------------- -/
/- Affine dependence and consequential theorems (from Lars Schewe).         -/
/- (convex.ml 1615-1760)                                                     -/
/- ------------------------------------------------------------------------- -/

structure AFD where
  affine_dependent : thm
  AFFINE_DEPENDENT_EXPLICIT : thm
  AFFINE_DEPENDENT_EXPLICIT_FINITE : thm
  AFFINE_DEPENDENT_TRANSLATION_EQ : thm
  AFFINE_DEPENDENT_TRANSLATION : thm
  AFFINE_DEPENDENT_LINEAR_IMAGE_EQ : thm
  AFFINE_DEPENDENT_LINEAR_IMAGE : thm
  AFFINE_DEPENDENT_MONO : thm
  AFFINE_INDEPENDENT_EMPTY : thm
  AFFINE_INDEPENDENT_1 : thm
  AFFINE_INDEPENDENT_2 : thm
  AFFINE_INDEPENDENT_SUBSET : thm
  AFFINE_INDEPENDENT_DELETE : thm
  deriving Inhabited

@[nospecialize]
def setupAFD [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFX : AFX) (BAFS : AFS) :
    ExceptT String IO AFD := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_RULE,
        SET_TAC, VECTOR_ARITH, add_linear_invariants, add_translation_invariants,
        GEOM_TRANSFORM_TAC, GEOM_TRANSLATE_TAC, .. } := D
  let { COND_RAND, COND_RATOR, CONTRAPOS_THM, EQ_TRANS, EXISTS_IN_IMAGE, EXISTS_IN_INSERT,
        FINITE_DELETE, FINITE_INSERT, .. } := D.core1
  let { FUN_IN_IMAGE, IMP_CONJ_ALT, INSERT_AC, INSERT_SUBSET, .. } := D.core2
  let { IN_ELIM_THM, IN_SING, MONO_AND, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_MUL_RZERO, SUBSET_REFL, .. } := D.core5
  let { SUM_CASES, SUM_CLAUSES, SUM_DELETE, SUM_LMUL, SUM_RESTRICT_SET, SUM_SING, .. } :=
    D.core6
  let { HULL_MONO, .. } := D.misc
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VSUM_CLAUSES,
        VSUM_DELETE_CASES, VSUM_EQ, VSUM_LMUL, VSUM_RESTRICT_SET, .. } := D.vec4
  let { AFFINE_HULL_LINEAR_IMAGE, .. } := BAFF
  let { AFFINE_HULL_EXPLICIT, .. } := BAFX
  let { AFFINE_HULL_EMPTY, AFFINE_HULL_SING, .. } := BAFS
  -- @@SCOPE END

  let affine_dependent ← new_definition
   r"affine_dependent (s:real^N -> bool) <=>
        ?x. x IN s /\ x IN (affine hull (s DELETE x))"

  let AFFINE_DEPENDENT_EXPLICIT ← prove
   r"!p. affine_dependent (p:real^N -> bool) <=>
            (?s u. FINITE s /\ s SUBSET p /\
                   sum s u = &0 /\
                   (?v. v IN s /\ ~(u v = &0)) /\
                   vsum s (\v. u v % v) = (vec 0):real^N)"
   (X_GEN_TAC (← q r"p:real^N->bool") THEN EQ_TAC THENL
     [REWRITE_TAC [affine_dependent, AFFINE_HULL_EXPLICIT,
                   IN_ELIM_THM] THEN
      REPEAT STRIP_TAC THEN
      EXISTS_TAC (← q r"(x:real^N) INSERT s") THEN
      EXISTS_TAC (← q r"\v:real^N.if v = x then -- &1 else u v") THEN
        ASM_SIMP_TAC [FINITE_INSERT, SUM_CLAUSES, VSUM_CLAUSES, INSERT_SUBSET] THEN
        REPEAT CONJ_TAC THENL
        [ASM SET_TAC [],
         COND_CASES_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
           ASM_SIMP_TAC [SUM_CASES, SUM_CLAUSES, ← SET_RULE
            (← q r"~((x:real^N) IN s) ==> {v | v IN s /\ v = x} = {} /\
                                    {v | v IN s /\ ~(v = x)} = s")] THEN
           REAL_ARITH_TAC,
         SET_TAC [← REAL_ARITH (← q r"~(-- &1 = &0)")],
         MP_TAC (← SET_RULE (← q r"s SUBSET p DELETE (x:real^N) ==> ~(x IN s)")) THEN
         ASM_REWRITE_TAC [] THEN
         DISCH_TAC THEN
         ASM_SIMP_TAC [← VECTOR_ARITH
          (← q r"(-- &1 % (x:real^N)) + a = vec 0 <=> a = x")] THEN
         MATCH_MP_TAC EQ_TRANS THEN
         EXISTS_TAC (← q r"vsum s (\v:real^N. u v % v)") THEN
         CONJ_TAC THENL [
         MATCH_MP_TAC VSUM_EQ THEN
           ASM_SIMP_TAC [] THEN
           ASM SET_TAC [],
         ASM_REWRITE_TAC []]],
         ALL_TAC] THEN
      REWRITE_TAC [affine_dependent, AFFINE_HULL_EXPLICIT, IN_ELIM_THM] THEN
      REPEAT STRIP_TAC THEN
      EXISTS_TAC (← q r"v:real^N") THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      EXISTS_TAC (← q r"s DELETE (v:real^N)") THEN
      EXISTS_TAC (← q r"\x:real^N. -- (&1 / (u v)) * u x") THEN
      ASM_SIMP_TAC [FINITE_DELETE, SUM_DELETE, VSUM_DELETE_CASES] THEN
      ASM_SIMP_TAC [SUM_LMUL, ← GSYM VECTOR_MUL_ASSOC, VSUM_LMUL,
              VECTOR_MUL_RZERO, ← VECTOR_ARITH (← q r"vec 0 - -- a % x = a % x:real^N"),
              REAL_MUL_RZERO, ← REAL_ARITH (← q r"&0 - -- a * b = a * b")] THEN
      ASM_SIMP_TAC [← REAL_FIELD (← q r"~(x = &0) ==> &1 / x * x = &1"),
                   VECTOR_MUL_ASSOC, VECTOR_MUL_LID] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"v IN s ==> (s DELETE v = {} <=> s = {v})")] THEN
      ASM_CASES_TAC (← q r"s = {v:real^N}") THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM SUBST_ALL_TAC THEN
      HolCore.Tactics.FIND_ASSUM MP_TAC (← q r"sum {v:real^N} u = &0") THEN
      REWRITE_TAC [SUM_SING]
      THEN ASM_REWRITE_TAC [])

  let AFFINE_DEPENDENT_EXPLICIT_FINITE ← prove
   r"!s. FINITE(s:real^N -> bool)
       ==> (affine_dependent s <=>
            ?u. sum s u = &0 /\
                (?v. v IN s /\ ~(u v = &0)) /\
                vsum s (\v. u v % v) = vec 0)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [AFFINE_DEPENDENT_EXPLICIT] THEN
    EQ_TAC THENL [ALL_TAC, ASM_MESON_TAC [SUBSET_REFL]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool")
     (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"\x:real^N. if x IN t then u(x) else &0") THEN
    REWRITE_TAC [COND_RAND, COND_RATOR, VECTOR_MUL_LZERO] THEN
    ASM_SIMP_TAC [← GSYM SUM_RESTRICT_SET, ← GSYM VSUM_RESTRICT_SET] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"t SUBSET s ==> {x | x IN s /\ x IN t} = t")] THEN
    ASM SET_TAC [])

  let AFFINE_DEPENDENT_TRANSLATION_EQ ← prove
   r"!a s. affine_dependent (IMAGE (\x. a + x) s) <=> affine_dependent s"
   (REWRITE_TAC [affine_dependent] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [AFFINE_DEPENDENT_TRANSLATION_EQ]

  let AFFINE_DEPENDENT_TRANSLATION ← prove
   r"!s a. affine_dependent s ==> affine_dependent (IMAGE (\x. a + x) s)"
   (REWRITE_TAC [AFFINE_DEPENDENT_TRANSLATION_EQ])

  let AFFINE_DEPENDENT_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (affine_dependent(IMAGE f s) <=> affine_dependent s)"
   (REWRITE_TAC [affine_dependent] THEN GEOM_TRANSFORM_TAC [])

  add_linear_invariants [AFFINE_DEPENDENT_LINEAR_IMAGE_EQ]

  let AFFINE_DEPENDENT_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
        affine_dependent(s)
        ==> affine_dependent(IMAGE f s)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [affine_dependent, EXISTS_IN_IMAGE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^M") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"IMAGE (f:real^M->real^N) s DELETE f a = IMAGE f (s DELETE a)")
     (fun t => ASM_SIMP_TAC [FUN_IN_IMAGE, AFFINE_HULL_LINEAR_IMAGE, t]) THEN
    ASM SET_TAC [])

  let AFFINE_DEPENDENT_MONO ← prove
   r"!s t:real^N->bool. affine_dependent s /\ s SUBSET t ==> affine_dependent t"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [affine_dependent] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"x:real^N") THEN MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HULL_MONO o SPEC (← q r"x:real^N") o MATCH_MP
     (← SET_RULE (← q r"!x. s SUBSET t ==> (s DELETE x) SUBSET (t DELETE x)"))) THEN
    ASM SET_TAC [])

  let AFFINE_INDEPENDENT_EMPTY ← prove
   r"~(affine_dependent {})"
   (REWRITE_TAC [affine_dependent, NOT_IN_EMPTY])

  let AFFINE_INDEPENDENT_1 ← prove
   r"!a:real^N. ~(affine_dependent {a})"
   (REWRITE_TAC [affine_dependent, EXISTS_IN_INSERT, NOT_IN_EMPTY] THEN
    REWRITE_TAC [← SET_RULE (← q r"{a} DELETE a = {}"), AFFINE_HULL_EMPTY, NOT_IN_EMPTY])

  let AFFINE_INDEPENDENT_2 ← prove
   r"!a b:real^N. ~(affine_dependent {a,b})"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"b:real^N = a") THENL
     [ASM_REWRITE_TAC [INSERT_AC, AFFINE_INDEPENDENT_1],
      REWRITE_TAC [affine_dependent, EXISTS_IN_INSERT, NOT_IN_EMPTY] THEN
      ASM_SIMP_TAC [← SET_RULE
       (← q r"~(a = b) ==> {a,b} DELETE a = {b} /\ {a,b} DELETE b = {a}")] THEN
      ASM_REWRITE_TAC [AFFINE_HULL_SING, IN_SING]])

  let AFFINE_INDEPENDENT_SUBSET ← prove
   r"!s t. ~affine_dependent t /\ s SUBSET t ==> ~affine_dependent s"
   (REWRITE_TAC [IMP_CONJ_ALT, CONTRAPOS_THM] THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT, AFFINE_DEPENDENT_MONO])

  let AFFINE_INDEPENDENT_DELETE ← prove
   r"!s a. ~affine_dependent s ==> ~affine_dependent(s DELETE a)"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] AFFINE_INDEPENDENT_SUBSET) THEN
    SET_TAC [])

  return { affine_dependent, AFFINE_DEPENDENT_EXPLICIT, AFFINE_DEPENDENT_EXPLICIT_FINITE,
           AFFINE_DEPENDENT_TRANSLATION_EQ, AFFINE_DEPENDENT_TRANSLATION,
           AFFINE_DEPENDENT_LINEAR_IMAGE_EQ, AFFINE_DEPENDENT_LINEAR_IMAGE,
           AFFINE_DEPENDENT_MONO, AFFINE_INDEPENDENT_EMPTY, AFFINE_INDEPENDENT_1,
           AFFINE_INDEPENDENT_2, AFFINE_INDEPENDENT_SUBSET, AFFINE_INDEPENDENT_DELETE }

/- ------------------------------------------------------------------------- -/
/- Coplanarity, and collinearity in terms of affine hull; a general lemma.   -/
/- (convex.ml 1764-1979)                                                     -/
/- ------------------------------------------------------------------------- -/

structure COP where
  coplanar : thm
  COLLINEAR_AFFINE_HULL : thm
  COLLINEAR_IMP_COPLANAR : thm
  COPLANAR_SMALL : thm
  COPLANAR_EMPTY : thm
  COPLANAR_SING : thm
  COPLANAR_2 : thm
  COPLANAR_3 : thm
  COLLINEAR_AFFINE_HULL_COLLINEAR : thm
  COPLANAR_AFFINE_HULL_COPLANAR : thm
  COPLANAR_TRANSLATION_EQ : thm
  COPLANAR_TRANSLATION : thm
  COPLANAR_LINEAR_IMAGE : thm
  COPLANAR_LINEAR_IMAGE_EQ : thm
  COPLANAR_SUBSET : thm
  AFFINE_HULL_3_IMP_COLLINEAR : thm
  COLLINEAR_3_AFFINE_HULL : thm
  COLLINEAR_3_EQ_AFFINE_DEPENDENT : thm
  AFFINE_DEPENDENT_IMP_COLLINEAR_3 : thm
  COLLINEAR_3_IN_AFFINE_HULL : thm
  COLLINEAR_3_EXPLICIT : thm
  CONVEX_CONNECTED : thm
  deriving Inhabited

@[nospecialize]
def setupCOP [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BCVX : CVX) (BAFD : AFD) :
    ExceptT String IO COP := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, HAS_SIZE_CONV, REAL_RAT_REDUCE_CONV, VECTOR_ARITH,
        VECTOR_ARITH_TAC, LINEAR_INVARIANT_RULE, add_linear_invariants,
        add_translation_invariants, GEOM_ORIGIN_TAC, GEOM_TRANSLATE_TAC, .. } := D
  let { CARD_CLAUSES, CONJ_ACI, EMPTY_SUBSET, EXISTS_IN_INSERT, EXISTS_OR_THM, FINITE_EMPTY,
        FINITE_INSERT, FINITE_RULES, .. } := D.core1
  let { HAS_SIZE, IMAGE_SUBSET, INSERT_AC, INSERT_SUBSET, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, LEFT_IMP_EXISTS_THM, LEFT_OR_DISTRIB, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_IN_EMPTY, REAL_ADD_AC, REAL_ADD_RID, REAL_DIV_RMUL, .. } := D.core3
  let { RIGHT_OR_DISTRIB, SUBSET, .. } := D.core5
  let { SUM_CLAUSES, UNWIND_THM1, UNWIND_THM2, .. } := D.core6
  let { HULL_HULL, HULL_INC, HULL_MONO, HULL_REDUNDANT_EQ, .. } := D.misc
  let { COLLINEAR_2, COLLINEAR_EMPTY, COLLINEAR_LEMMA, COLLINEAR_SING, COLLINEAR_SMALL, .. } :=
    D.vec1
  let { VECTOR_ADD_AC, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC,
        VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VSUM_CLAUSES, collinear, .. } := D.vec4
  let { CONNECTED_IFF_CONNECTABLE_POINTS, CONNECTED_SEGMENT, .. } := D.top2
  let { ENDS_IN_SEGMENT, .. } := D.top3
  let { AFFINE_HULL_LINEAR_IMAGE, .. } := BAFF
  let { AFFINE_HULL_2, .. } := BAFS
  let { SEGMENT_SUBSET_CONVEX, .. } := BCVX
  let { affine_dependent, AFFINE_DEPENDENT_EXPLICIT_FINITE, .. } := BAFD
  -- @@SCOPE END

  let coplanar ← new_definition
   r"coplanar s <=> ?u v w. s SUBSET affine hull {u,v,w}"

  let COLLINEAR_AFFINE_HULL ← prove
   r"!s:real^N->bool. collinear s <=> ?u v. s SUBSET affine hull {u,v}"
   (GEN_TAC THEN REWRITE_TAC [collinear, AFFINE_HULL_2] THEN EQ_TAC THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"u + v = &1 <=> &1 - u = v"), UNWIND_THM1] THENL
     [X_GEN_TAC (← q r"u:real^N") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"x + u:real^N") THEN X_GEN_TAC (← q r"y:real^N") THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"x - y:real^N = z <=> x = y + z")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:real") SUBST1_TAC) THEN
      EXISTS_TAC (← q r"&1 + c") THEN VECTOR_ARITH_TAC,
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"b - a:real^N") THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"y:real^N") th) THEN MP_TAC (← SPEC (← q r"x:real^N") th))) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"r:real") THEN DISCH_THEN SUBST1_TAC THEN
      X_GEN_TAC (← q r"s:real") THEN DISCH_THEN SUBST1_TAC THEN
      EXISTS_TAC (← q r"s - r:real") THEN VECTOR_ARITH_TAC])

  let COLLINEAR_IMP_COPLANAR ← prove
   r"!s. collinear s ==> coplanar s"
   (REWRITE_TAC [coplanar, COLLINEAR_AFFINE_HULL] THEN MESON_TAC [INSERT_AC])

  let COPLANAR_SMALL ← prove
   r"!s. FINITE s /\ CARD s <= 3 ==> coplanar s"
   (GEN_TAC THEN REWRITE_TAC [← ARITH_RULE (← q r"s <= 3 <=> s <= 2 \/ s = 3")] THEN
    REWRITE_TAC [LEFT_OR_DISTRIB, ← GSYM HAS_SIZE] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN
    SIMP_TAC [COLLINEAR_IMP_COPLANAR, COLLINEAR_SMALL] THEN
    CONV_TAC (LAND_CONV HAS_SIZE_CONV) THEN REWRITE_TAC [coplanar] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [HULL_INC, SUBSET])

  let COPLANAR_EMPTY ← prove
   r"coplanar {}"
   (SIMP_TAC [COLLINEAR_IMP_COPLANAR, COLLINEAR_EMPTY])

  let COPLANAR_SING ← prove
   r"!a. coplanar {a}"
   (SIMP_TAC [COLLINEAR_IMP_COPLANAR, COLLINEAR_SING])

  let COPLANAR_2 ← prove
   r"!a b. coplanar {a,b}"
   (SIMP_TAC [COLLINEAR_IMP_COPLANAR, COLLINEAR_2])

  let COPLANAR_3 ← prove
   r"!a b c. coplanar {a,b,c}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC COPLANAR_SMALL THEN
    SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_RULES] THEN ARITH_TAC)

  let COLLINEAR_AFFINE_HULL_COLLINEAR ← prove
   r"!s. collinear(affine hull s) <=> collinear s"
   (REWRITE_TAC [COLLINEAR_AFFINE_HULL] THEN
    MESON_TAC [HULL_HULL, HULL_MONO, HULL_INC, SUBSET])

  let COPLANAR_AFFINE_HULL_COPLANAR ← prove
   r"!s. coplanar(affine hull s) <=> coplanar s"
   (REWRITE_TAC [coplanar] THEN
    MESON_TAC [HULL_HULL, HULL_MONO, HULL_INC, SUBSET])

  let COPLANAR_TRANSLATION_EQ ← prove
   r"!a:real^N s. coplanar(IMAGE (\x. a + x) s) <=> coplanar s"
   (REWRITE_TAC [coplanar] THEN GEOM_TRANSLATE_TAC [])

  let COPLANAR_TRANSLATION ← prove
   r"!a:real^N s. coplanar s ==> coplanar(IMAGE (\x. a + x) s)"
   (REWRITE_TAC [COPLANAR_TRANSLATION_EQ])

  add_translation_invariants [COPLANAR_TRANSLATION_EQ]

  let COPLANAR_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s. coplanar s /\ linear f ==> coplanar(IMAGE f s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [coplanar, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M", ← q r"c:real^M"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
    [← q r"(f:real^M->real^N) a", ← q r"(f:real^M->real^N) b", ← q r"(f:real^M->real^N) c"] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f a,f b,f c} = IMAGE f {a,b,c}")] THEN
    ASM_SIMP_TAC [AFFINE_HULL_LINEAR_IMAGE, IMAGE_SUBSET])

  let COPLANAR_LINEAR_IMAGE_EQ ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (coplanar (IMAGE f s) <=> coplanar s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE COPLANAR_LINEAR_IMAGE))

  add_linear_invariants [COPLANAR_LINEAR_IMAGE_EQ]

  let COPLANAR_SUBSET ← prove
   r"!s t. coplanar t /\ s SUBSET t ==> coplanar s"
   (REWRITE_TAC [coplanar] THEN SET_TAC [])

  let AFFINE_HULL_3_IMP_COLLINEAR ← prove
   r"!a b c. c IN affine hull {a,b} ==> collinear {a,b,c}"
   (ONCE_REWRITE_TAC [← GSYM COLLINEAR_AFFINE_HULL_COLLINEAR] THEN
    SIMP_TAC [HULL_REDUNDANT_EQ, INSERT_AC] THEN
    REWRITE_TAC [COLLINEAR_AFFINE_HULL_COLLINEAR, COLLINEAR_2])

  let COLLINEAR_3_AFFINE_HULL ← prove
   r"!a b c:real^N.
        ~(a = b) ==> (collinear {a,b,c} <=> c IN affine hull {a,b})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [AFFINE_HULL_3_IMP_COLLINEAR] THEN
    REWRITE_TAC [collinear] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPECL [← q r"b:real^N", ← q r"a:real^N"] th) THEN
            MP_TAC (← SPECL [← q r"c:real^N", ← q r"a:real^N"] th))) THEN
    REWRITE_TAC [IN_INSERT, AFFINE_HULL_2, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a - b:real^N = c <=> a = b + c")] THEN
    X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN X_GEN_TAC (← q r"y:real") THEN
    ASM_CASES_TAC (← q r"y = &0") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_RID] THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY EXISTS_TAC [← q r"&1 - x / y", ← q r"x / y:real"] THEN
    CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_DIV_RMUL] THEN VECTOR_ARITH_TAC)

  let COLLINEAR_3_EQ_AFFINE_DEPENDENT ← prove
   r"!a b c:real^N.
        collinear{a,b,c} <=>
                a = b \/ a = c \/ b = c \/ affine_dependent {a,b,c}"
   (REPEAT GEN_TAC THEN
    MAP_EVERY (fun t =>
      ASM_CASES_TAC t THENL [ASM_REWRITE_TAC [INSERT_AC, COLLINEAR_2], ALL_TAC])
     [← q r"a:real^N = b", ← q r"a:real^N = c", ← q r"b:real^N = c"] THEN
    ASM_REWRITE_TAC [affine_dependent] THEN EQ_TAC THENL
     [ASM_SIMP_TAC [COLLINEAR_3_AFFINE_HULL] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"c:real^N") THEN REWRITE_TAC [IN_INSERT],
      REWRITE_TAC [EXISTS_IN_INSERT, NOT_IN_EMPTY] THEN STRIP_TAC THENL
       [ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b,c} = {b,c,a}")],
        ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b,c} = {c,a,b}")],
        ALL_TAC] THEN
      ASM_SIMP_TAC [COLLINEAR_3_AFFINE_HULL]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
    MATCH_MP_TAC HULL_MONO THEN ASM SET_TAC [])

  let AFFINE_DEPENDENT_IMP_COLLINEAR_3 ← prove
   r"!a b c:real^N. affine_dependent {a,b,c} ==> collinear{a,b,c}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [affine_dependent] THEN
    REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY, RIGHT_OR_DISTRIB] THEN
    REWRITE_TAC [EXISTS_OR_THM, UNWIND_THM2, COLLINEAR_AFFINE_HULL] THEN
    STRIP_TAC THENL
     [MAP_EVERY EXISTS_TAC [← q r"b:real^N", ← q r"c:real^N"],
      MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"c:real^N"],
      MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"b:real^N"]] THEN
    SIMP_TAC [INSERT_SUBSET, EMPTY_SUBSET, HULL_INC, IN_INSERT] THEN
    POP_ASSUM MP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> a IN s ==> a IN t")) THEN
    MATCH_MP_TAC HULL_MONO THEN SET_TAC [])

  let COLLINEAR_3_IN_AFFINE_HULL ← prove
   r"!v0 v1 x:real^N.
        ~(v1 = v0)
        ==> (collinear {v0,v1,x} <=> x IN affine hull {v0,v1})"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"v0:real^N") THEN
    REWRITE_TAC [COLLINEAR_LEMMA, AFFINE_HULL_2] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID, IN_ELIM_THM] THEN
    ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN ASM_REWRITE_TAC [] THENL
     [MAP_EVERY EXISTS_TAC [← q r"&1", ← q r"&0"] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      VECTOR_ARITH_TAC,
      MESON_TAC [← REAL_ARITH (← q r"u + v = &1 <=> u = &1 - v")]])

  let COLLINEAR_3_EXPLICIT ← prove
   r"!x y z:real^N.
        collinear {x,y,z} <=>
        ?a b c. a % x + b % y + c % z = vec 0 /\
                a + b + c = &0 /\ ~(a = &0 /\ b = &0 /\ c = &0)"
   (MATCH_MP_TAC (← MESON []
     (← q r"(!x y z. P x y z ==> P y z x) /\
      (!x z. P x x z) /\
      (!x y z. ~(x = y) /\ ~(x = z) /\ ~(y = z) ==> P x y z)
      ==> !x y z. P x y z")) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [INSERT_AC, REAL_ADD_AC, VECTOR_ADD_AC, CONJ_ACI] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MESON_TAC [REAL_ADD_AC, VECTOR_ADD_AC],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REPEAT GEN_TAC THEN REWRITE_TAC [INSERT_AC, COLLINEAR_2] THEN
      MAP_EVERY EXISTS_TAC [← q r"&1", ← q r"-- &1", ← q r"&0"] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [COLLINEAR_3_EQ_AFFINE_DEPENDENT] THEN
    SIMP_TAC [AFFINE_DEPENDENT_EXPLICIT_FINITE, FINITE_INSERT, FINITE_EMPTY,
              SUM_CLAUSES, VSUM_CLAUSES, EXISTS_IN_INSERT, NOT_IN_EMPTY] THEN
    ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY, VECTOR_ADD_RID, REAL_ADD_RID] THEN
    EQ_TAC THENL [MESON_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"c:real"] THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"(\w. if w = x then a else if w = y then b else c):real^N->real") THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  let CONVEX_CONNECTED ← prove
   r"!s:real^N->bool. convex s ==> connected s"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [CONNECTED_IFF_CONNECTABLE_POINTS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"segment[a:real^N,b]") THEN
    ASM_SIMP_TAC [CONNECTED_SEGMENT, ENDS_IN_SEGMENT, SEGMENT_SUBSET_CONVEX])

  return { coplanar, COLLINEAR_AFFINE_HULL, COLLINEAR_IMP_COPLANAR, COPLANAR_SMALL,
           COPLANAR_EMPTY, COPLANAR_SING, COPLANAR_2, COPLANAR_3,
           COLLINEAR_AFFINE_HULL_COLLINEAR, COPLANAR_AFFINE_HULL_COPLANAR,
           COPLANAR_TRANSLATION_EQ, COPLANAR_TRANSLATION, COPLANAR_LINEAR_IMAGE,
           COPLANAR_LINEAR_IMAGE_EQ, COPLANAR_SUBSET, AFFINE_HULL_3_IMP_COLLINEAR,
           COLLINEAR_3_AFFINE_HULL, COLLINEAR_3_EQ_AFFINE_DEPENDENT,
           AFFINE_DEPENDENT_IMP_COLLINEAR_3, COLLINEAR_3_IN_AFFINE_HULL, COLLINEAR_3_EXPLICIT,
           CONVEX_CONNECTED }

/- ------------------------------------------------------------------------- -/
/- Convex functions into the reals.  (convex.ml 1982-2290)                   -/
/- ------------------------------------------------------------------------- -/

structure CVF where
  convex_on : thm
  CONVEX_ON_EMPTY : thm
  CONVEX_ON_SUBSET : thm
  CONVEX_ON_EQ : thm
  CONVEX_ON_CONST : thm
  LINEAR_IMP_CONVEX_ON : thm
  CONVEX_ON_SING : thm
  CONVEX_ADD : thm
  CONVEX_ADD_EQ : thm
  CONVEX_CMUL : thm
  CONVEX_MAX : thm
  CONVEX_ON_SUM : thm
  CONVEX_ON_IMP_MIDPOINT_CONVEX : thm
  CONVEX_LOWER : thm
  CONVEX_LOWER_SEGMENT : thm
  CONVEX_LOWER_SEGMENT_LT : thm
  CONVEX_LOCAL_GLOBAL_MINIMUM_SEGMENT : thm
  CONVEX_LOCAL_GLOBAL_MINIMUM_GEN : thm
  CONVEX_LOCAL_GLOBAL_MINIMUM : thm
  CONVEX_DISTANCE : thm
  CONVEX_NORM : thm
  CONVEX_ON_COMPOSE_LINEAR : thm
  CONVEX_ON_TRANSLATION : thm
  LINEAR_CONVEX_ON_1 : thm
  CONVEX_CONCAVE_EQ_AFFINE : thm
  deriving Inhabited

@[nospecialize]
def setupCVF [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) :
    ExceptT String IO CVF := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC,
        REAL_ARITH, REAL_ARITH_TAC, SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH,
        VECTOR_ARITH_TAC, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, ETA_AX, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } :=
    D.core2
  let { IN_SING, IN_UNIV, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, REAL_ABS_REFL,
        REAL_ADD_LINV, REAL_ADD_RDISTRIB, .. } := D.core3
  let { REAL_INV_LE_1, REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_ANTISYM, REAL_LE_DIV,
        REAL_LE_INV_EQ, REAL_LE_LMUL, REAL_LE_MIN, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_LMUL, REAL_LT_RDIV_EQ, REAL_MAX_LE, REAL_MAX_MAX,
        REAL_MIN_LE, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_RINV, REAL_NEG_ADD, REAL_POS, REAL_SUB_LT,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_TRANS, .. } := D.core5
  let { SUM_CLAUSES, o_DEF, o_THM, .. } := D.core6
  let { HULL_INC, HULL_SUBSET, REAL_HALF, .. } := D.misc
  let { DIST_0, DOT_LNEG, .. } := D.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, LIFT_DROP, LIFT_NUM, LINEAR_0, LINEAR_ADD, LINEAR_CMUL,
        LINEAR_LIFT_DOT, LINEAR_TO_1, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_TRIANGLE, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_RID, VECTOR_EQ_NEG2, VECTOR_MUL_ASSOC,
        VECTOR_MUL_EQ_0, VECTOR_MUL_LID, VECTOR_MUL_LNEG, VECTOR_MUL_RZERO, VECTOR_SUB_EQ,
        dist, linear, midpoint, .. } := D.vec4
  let { IN_OPEN_SEGMENT, IN_SEGMENT, .. } := D.top4
  let { OPEN_SUBSET, SEGMENT_OPEN_SUBSET_CLOSED, SEGMENT_SYM, open_in, .. } := D.top5
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { convex, CONVEX_SING, .. } := BCVX
  -- @@SCOPE END

  parse_as_infix ("convex_on", (12, "right"))

  let convex_on ← new_definition
   r"f convex_on s <=>
        !x y u v. x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ (u + v = &1)
                  ==> f(u % x + v % y) <= u * f(x) + v * f(y)"

  let CONVEX_ON_EMPTY ← prove
   r"!f:real^N->real. f convex_on {}"
   (REWRITE_TAC [convex_on, NOT_IN_EMPTY])

  let CONVEX_ON_SUBSET ← prove
   r"!f s t. f convex_on t /\ s SUBSET t ==> f convex_on s"
   (REWRITE_TAC [convex_on, SUBSET] THEN MESON_TAC [])

  let CONVEX_ON_EQ ← prove
   r"!f g s. convex s /\ (!x. x IN s ==> f x = g x) /\ f convex_on s
           ==> g convex_on s"
   (REWRITE_TAC [convex_on, convex] THEN MESON_TAC [])

  let CONVEX_ON_CONST ← prove
   r"!s a. (\x. a) convex_on s"
   (SIMP_TAC [convex_on, ← GSYM REAL_ADD_RDISTRIB, REAL_MUL_LID, REAL_LE_REFL])

  let LINEAR_IMP_CONVEX_ON ← prove
   r"!f s:real^N->bool. linear (lift o f) ==> f convex_on s"
   (REWRITE_TAC [linear, convex_on] THEN
    SIMP_TAC [← GSYM DROP_EQ, DROP_ADD, o_DEF, LIFT_DROP, DROP_CMUL] THEN
    REWRITE_TAC [REAL_LE_REFL])

  let CONVEX_ON_SING ← prove
   r"!f a:real^N. f convex_on {a}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC CONVEX_ON_EQ THEN
    EXISTS_TAC (← q r"\x:real^N. (f:real^N->real) a") THEN
    SIMP_TAC [IN_SING, CONVEX_SING, CONVEX_ON_CONST])

  let CONVEX_ADD ← prove
   r"!s f g. f convex_on s /\ g convex_on s ==> (\x. f(x) + g(x)) convex_on s"
   (REWRITE_TAC [convex_on, AND_FORALL_THM] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL ORELSE GEN_TAC) THEN
    MATCH_MP_TAC (← TAUT
      (← q r"(b /\ c ==> d) ==> (a ==> b) /\ (a ==> c) ==> a ==> d")) THEN
    REAL_ARITH_TAC)

  let CONVEX_ADD_EQ ← prove
   r"!a f s:real^N->bool. (\x. a + f x) convex_on s <=> f convex_on s"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    SIMP_TAC [CONVEX_ADD, CONVEX_ON_CONST] THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"(\x. --a):real^N->real") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] CONVEX_ADD)) THEN
    REWRITE_TAC [CONVEX_ON_CONST, ETA_AX, ← REAL_ARITH (← q r"--a + a + x:real = x")])

  let CONVEX_CMUL ← prove
   r"!s c f. &0 <= c /\ f convex_on s ==> (\x. c * f(x)) convex_on s"
   (SIMP_TAC [convex_on, REAL_LE_LMUL,
              ← REAL_ARITH (← q r"u * c * fx + v * c * fy = c * (u * fx + v * fy)")])

  let CONVEX_MAX ← prove
   r"!f g s. f convex_on s /\ g convex_on s
           ==> (\x. max (f x) (g x)) convex_on s"
   (REWRITE_TAC [convex_on, REAL_MAX_LE] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (fun th =>
      W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o snd)) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THEN
    MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REAL_ARITH_TAC)

  let CONVEX_ON_SUM ← prove
   r"!t f:A->real^N->real s.
         FINITE s /\ (!a. a IN s ==> f a convex_on t)
         ==> (\x. sum s (\a. f a x)) convex_on t"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, CONVEX_ON_CONST, FORALL_IN_INSERT] THEN
    SIMP_TAC [CONVEX_ADD, ETA_AX])

  let CONVEX_ON_IMP_MIDPOINT_CONVEX ← prove
   r"!f s x y:real^N.
        f convex_on s /\ x IN s /\ y IN s
        ==> f(midpoint(x,y)) <= (f x + f y) / &2"
   (REWRITE_TAC [convex_on] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [midpoint, VECTOR_ADD_LDISTRIB,
                 ← REAL_ARITH (← q r"(x + y) / &2 = inv(&2) * x + inv(&2) * y")] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_REWRITE_TAC [])

  let CONVEX_LOWER ← prove
   r"!f s x y:real^N u v.
        f convex_on s /\
        x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ (u + v = &1)
        ==> f(u % x + v % y) <= max (f(x)) (f(y))"
   (REWRITE_TAC [convex_on] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← SYM th])) THEN
    REWRITE_TAC [REAL_ADD_RDISTRIB] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    ASM_MESON_TAC [REAL_LE_ADD2, REAL_LE_LMUL, REAL_MAX_MAX])

  let CONVEX_LOWER_SEGMENT ← prove
   r"!f s a b x:real^N.
        f convex_on s /\ a IN s /\ b IN s /\ x IN segment[a,b]
        ==> f(x) <= max (f a) (f b)"
   (REWRITE_TAC [IN_SEGMENT] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONVEX_LOWER THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let CONVEX_LOWER_SEGMENT_LT ← prove
   r"!f s a b x:real^N.
        f convex_on s /\ a IN s /\ b IN s /\
        x IN segment[a,b] /\ ~(x = b) /\ f a < f b
        ==> f x < f b"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_SEGMENT]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") (STRIP_ASSUME_TAC o GSYM)) THEN
    FIRST_X_ASSUM (MP_TAC o
     SPECL [← q r"a:real^N", ← q r"b:real^N", ← q r"&1 - u:real", ← q r"u:real"] o
     GEN_REWRITE_RULE id [convex_on]) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a + u * b < b <=> a < (&1 - u) * b")] THEN
    MATCH_MP_TAC REAL_LT_LMUL THEN ASM_REWRITE_TAC [REAL_SUB_LT] THEN
    ASM_CASES_TAC (← q r"u = &1") THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    UNDISCH_TAC (← q r"~(x:real^N = b)") THEN EXPAND_TAC "x" THEN
    MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN
    REWRITE_TAC [← ASSUME (← q r"u = &1")] THEN
    VECTOR_ARITH_TAC)

  let CONVEX_LOCAL_GLOBAL_MINIMUM_SEGMENT ← prove
   r"!f s x:real^N.
        f convex_on s /\ x IN s /\
        (!z. z IN s /\ ~(z = x)
             ==> ?y. y IN segment[x,z] /\ y IN s /\ ~(y = x) /\ f(x) <= f(y))
        ==> !z. z IN s ==> f(x) <= f(z)"
   (REWRITE_TAC [IN_OPEN_SEGMENT] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:real^N")) THEN
    ASM_CASES_TAC (← q r"z:real^N = x") THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real", ← q r"s:real^N->bool", ← q r"z:real^N",
                      ← q r"x:real^N", ← q r"y:real^N"] CONVEX_LOWER_SEGMENT_LT) THEN
    ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] SEGMENT_OPEN_SUBSET_CLOSED] THEN
    ONCE_REWRITE_TAC [SEGMENT_SYM] THEN ASM_REWRITE_TAC [] THEN
    ASM_REAL_ARITH_TAC)

  let CONVEX_LOCAL_GLOBAL_MINIMUM_GEN ← prove
   r"!f s t x:real^N.
       f convex_on s /\ x IN t /\
       open_in (subtopology euclidean (affine hull s)) t /\
       t SUBSET s /\
       (!y. y IN t ==> f(x) <= f(y))
       ==> !y. y IN s ==> f(x) <= f(y)"
   (REWRITE_TAC [open_in] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CONVEX_LOCAL_GLOBAL_MINIMUM_SEGMENT THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"z:real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"x:real^N") th) THEN ASM_REWRITE_TAC [] THEN
            DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC))) THEN
    EXISTS_TAC (← q r"x + min (&1) (d / &2 / norm(z - x:real^N)) % (z - x)") THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [IN_SEGMENT] THEN
      EXISTS_TAC (← q r"min (&1) (d / &2 / norm(z - x:real^N))") THEN
      REWRITE_TAC [REAL_MIN_LE, REAL_LE_MIN, REAL_LE_REFL, REAL_POS] THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LE_DIV, REAL_POS, NORM_POS_LE] THEN
      VECTOR_ARITH_TAC,
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]),
      REWRITE_TAC [← VECTOR_ARITH (← q r"x + a:real^N = x <=> a = vec 0")] THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> ~(min (&1) x = &0)")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_HALF, NORM_POS_LT, VECTOR_SUB_EQ],
      FIRST_X_ASSUM MATCH_MP_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [IN_AFFINE_ADD_MUL_DIFF, HULL_INC, AFFINE_AFFINE_HULL] THEN
    REWRITE_TAC [← NORM_ARITH (← q r"dist(x + a:real^N,x) = norm a")] THEN
    ASM_SIMP_TAC [NORM_MUL, ← GSYM REAL_LT_RDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"&0 < x /\ x < d ==> abs(min (&1) x) < d")) THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"&0 < x / y ==> &0 < x / &2 / y /\ x / &2 / y < x / y")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT, VECTOR_SUB_EQ])

  let CONVEX_LOCAL_GLOBAL_MINIMUM ← prove
   r"!f s t x:real^N.
       f convex_on s /\ x IN t /\ open t /\ t SUBSET s /\
       (!y. y IN t ==> f(x) <= f(y))
       ==> !y. y IN s ==> f(x) <= f(y)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CONVEX_LOCAL_GLOBAL_MINIMUM_GEN THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC OPEN_SUBSET THEN
    ASM_REWRITE_TAC [] THEN TRANS_TAC SUBSET_TRANS (← q r"s:real^N->bool") THEN
    ASM_REWRITE_TAC [HULL_SUBSET])

  let CONVEX_DISTANCE ← prove
   r"!s a. (\x. dist(a,x)) convex_on s"
   (REWRITE_TAC [convex_on, dist] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o LAND_CONV)
     [← GSYM VECTOR_MUL_LID] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"(u + v) % z - (u % x + v % y) = u % (z - x) + v % (z - y)")] THEN
    ASM_MESON_TAC [NORM_TRIANGLE, NORM_MUL, REAL_ABS_REFL])

  let CONVEX_NORM ← prove
   r"!s:real^N->bool. norm convex_on s"
   (GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"vec 0:real^N"] CONVEX_DISTANCE) THEN
    REWRITE_TAC [DIST_0, ETA_AX])

  let CONVEX_ON_COMPOSE_LINEAR ← prove
   r"!f g:real^M->real^N s.
        f convex_on (IMAGE g s) /\ linear g ==> (f o g) convex_on s"
   (REWRITE_TAC [convex_on, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, o_THM] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do pure (REWRITE_TAC [← MATCH_MP LINEAR_ADD th])) THEN
    FIRST_ASSUM (fun th => tactic_of do pure (REWRITE_TAC [← MATCH_MP LINEAR_CMUL th])) THEN
    ASM_SIMP_TAC [])

  let CONVEX_ON_TRANSLATION ← prove
   r"!f a:real^N.
        f convex_on (IMAGE (\x. a + x) s) <=> (\x. f(a + x)) convex_on s"
   (REWRITE_TAC [convex_on, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, o_THM] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"u % (a + x) + v % (a + y):real^N = (u + v) % a + u % x + v % y")] THEN
    SIMP_TAC [VECTOR_MUL_LID])

  let LINEAR_CONVEX_ON_1 ← prove
   r"!f:real^N->real^1.
        linear f <=>
        f(vec 0) = vec 0 /\
        (drop o f) convex_on UNIV /\
        ((--) o drop o f) convex_on UNIV"
   (GEN_TAC THEN REWRITE_TAC [convex_on, IN_UNIV, o_THM] THEN
    REWRITE_TAC [AND_FORALL_THM, ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r"),
      ← REAL_ARITH (← q r"--a <= u * --x + v * --y <=> u * x + v * y <= a")] THEN
    REWRITE_TAC [REAL_LE_ANTISYM] THEN
    REWRITE_TAC [← GSYM DROP_CMUL, ← GSYM DROP_ADD, DROP_EQ] THEN
    EQ_TAC THENL
     [MESON_TAC [LINEAR_ADD, LINEAR_CMUL, LINEAR_0],
      STRIP_TAC THEN REWRITE_TAC [linear]] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPECL [← q r"x:real^N", ← q r"y:real^N", ← q r"&1 / &2",
                               ← q r"&1 / &2"] th) THEN
              MP_TAC (← SPECL [← q r"x + y:real^N", ← q r"vec 0:real^N",
                               ← q r"&1 / &2", ← q r"&1 / &2"] th))) THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_RID] THEN
      REWRITE_TAC [VECTOR_ADD_LDISTRIB] THEN
      DISCH_THEN SUBST1_TAC THEN CONV_TAC (fun t => VECTOR_ARITH t),
      DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!c x:real^N. &0 <= c /\ c <= &1 ==> (f:real^N->real^1)(c % x) = c % f x")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o
        SPECL [← q r"x:real^N", ← q r"vec 0:real^N", ← q r"c:real", ← q r"&1 - c"]) THEN
      ASM_REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_RID] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!c x:real^N. &0 <= c ==> (f:real^N->real^1)(c % x) = c % f x")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"c <= &1") THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"inv c:real", ← q r"c % x:real^N"]) THEN
      SUBGOAL_THEN (← q r"&1 <= c /\ ~(c = &0)") STRIP_ASSUME_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      ASM_SIMP_TAC [REAL_INV_LE_1, REAL_LE_INV_EQ] THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, VECTOR_MUL_LID] THEN
      ASM_SIMP_TAC [REAL_MUL_RINV, VECTOR_MUL_LID],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!x. (f:real^N->real^1) (--x) = --(f x)") ASSUME_TAC THENL
     [GEN_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"x:real^N", ← q r"--x:real^N", ← q r"inv(&2)", ← q r"inv(&2)"]) THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a % x + a % --x:real^N = vec 0")] THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => VECTOR_ARITH t),
      ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^N"] THEN
      ASM_CASES_TAC (← q r"&0 <= c") THEN ASM_SIMP_TAC [] THEN
      SUBGOAL_THEN (← q r"(f:real^N->real^1)(--c % x) = --c % f x") MP_TAC THENL
       [ASM_SIMP_TAC [← REAL_ARITH (← q r"~(&0 <= c) ==> &0 <= --c")],
        ASM_REWRITE_TAC [VECTOR_MUL_LNEG, VECTOR_EQ_NEG2]])

  let CONVEX_CONCAVE_EQ_AFFINE ← prove
   r"!f:real^N->real.
        f convex_on UNIV /\ ((--) o f) convex_on UNIV <=>
        (?a b. f = \x. a dot x + b)"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [MP_TAC (← ISPEC (← q r"\x. lift(--f(vec 0) + (f:real^N->real) x)")
          LINEAR_CONVEX_ON_1) THEN
      REWRITE_TAC [o_DEF, LIFT_DROP, REAL_ADD_LINV, LIFT_NUM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [o_DEF]) THEN
      ASM_SIMP_TAC [CONVEX_ADD, CONVEX_ON_CONST, REAL_NEG_ADD] THEN
      REWRITE_TAC [LINEAR_TO_1] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
      REWRITE_TAC [FUN_EQ_THM, ← GSYM DROP_EQ, LIFT_DROP] THEN
      DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
      EXISTS_TAC (← q r"(f:real^N->real) (vec 0)") THEN REAL_ARITH_TAC,
      REWRITE_TAC [o_DEF, REAL_NEG_ADD, ← GSYM DOT_LNEG] THEN CONJ_TAC THEN
      MATCH_MP_TAC CONVEX_ADD THEN REWRITE_TAC [CONVEX_ON_CONST] THEN
      MATCH_MP_TAC LINEAR_IMP_CONVEX_ON THEN
      REWRITE_TAC [o_DEF, LINEAR_LIFT_DOT]])

  return { convex_on, CONVEX_ON_EMPTY, CONVEX_ON_SUBSET, CONVEX_ON_EQ, CONVEX_ON_CONST,
           LINEAR_IMP_CONVEX_ON, CONVEX_ON_SING, CONVEX_ADD, CONVEX_ADD_EQ, CONVEX_CMUL,
           CONVEX_MAX, CONVEX_ON_SUM, CONVEX_ON_IMP_MIDPOINT_CONVEX, CONVEX_LOWER,
           CONVEX_LOWER_SEGMENT, CONVEX_LOWER_SEGMENT_LT, CONVEX_LOCAL_GLOBAL_MINIMUM_SEGMENT,
           CONVEX_LOCAL_GLOBAL_MINIMUM_GEN, CONVEX_LOCAL_GLOBAL_MINIMUM, CONVEX_DISTANCE,
           CONVEX_NORM, CONVEX_ON_COMPOSE_LINEAR, CONVEX_ON_TRANSLATION, LINEAR_CONVEX_ON_1,
           CONVEX_CONCAVE_EQ_AFFINE }

/- ------------------------------------------------------------------------- -/
/- Open and closed balls are convex and hence connected.                     -/
/- (convex.ml 2294-2461)                                                     -/
/- ------------------------------------------------------------------------- -/

structure CVB where
  CONVEX_BALL : thm
  CONNECTED_BALL : thm
  CONVEX_CBALL : thm
  CONNECTED_CBALL : thm
  CONVEX_INTERMEDIATE_BALL : thm
  FRONTIER_OF_CONNECTED_COMPONENT_SUBSET : thm
  FRONTIER_OF_COMPONENTS_SUBSET : thm
  FRONTIER_OF_COMPONENTS_CLOSED_COMPLEMENT : thm
  CONTAINS_COMPONENT_OF_COMPACT_FRONTIER : thm
  CARD_LE_COMPONENTS_FRONTIER : thm
  CONTAINS_COMPONENT_OF_CLOSURE_FRONTIER : thm
  CARD_LE_COMPONENTS_CLOSURE_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupCVB [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCOP : COP) (BCVF : CVF) :
    ExceptT String IO CVB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D
  let { CONJ_ASSOC, DE_MORGAN_THM, EMPTY_UNIONS, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INTER_COMM, INTER_UNIONS, IN_DIFF, .. } := D.core2
  let { IN_UNIV, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, REAL_ABS_POS, REAL_CONVEX_BOUND_LE,
        REAL_CONVEX_BOUND_LT, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_TRANS, REAL_LTE_TRANS, .. } := D.core4
  let { SUBSET, SUBSET_TRANS, .. } := D.core5
  let { CARD_LE_RELATIONAL_FULL, .. } := D.lib
  let { DIST_SYM, .. } := D.vec1
  let { NORM_MUL, NORM_TRIANGLE, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { CENTRE_IN_BALL, CLOSURE_APPROACHABLE, .. } := D.top1
  let { COMPACT_CLOSURE, COMPACT_COMPONENTS, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_CLOSED,
        COMPONENTS_EQ, COMPONENTS_MAXIMAL, CONNECTED_COMPONENT_MAXIMAL,
        CONNECTED_COMPONENT_OVERLAP, CONNECTED_COMPONENT_SUBSET, .. } := D.top2
  let { DIST_DECREASES_OPEN_SEGMENT, FRONTIER_CLOSURE_SUBSET, FRONTIER_COMPLEMENT,
        FRONTIER_EQ_EMPTY, FRONTIER_SUBSET_EQ, .. } := D.top3
  let { IN_BALL, IN_CBALL, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY,
        IN_COMPONENTS_SUBSET, IN_INTERIOR, NOT_BOUNDED_UNIV, .. } := D.top4
  let { SUBSET_CLOSURE, UNIONS_COMPONENTS, components, frontier, .. } := D.top5
  let { convex, CONVEX_CONTAINS_OPEN_SEGMENT, .. } := BCVX
  let { CONVEX_CONNECTED, .. } := BCOP
  let { convex_on, CONVEX_DISTANCE, .. } := BCVF
  -- @@SCOPE END

  let CONVEX_BALL ← do
    let lemma ← REWRITE_RULE [convex_on, IN_UNIV]
     (← ISPEC (← q r"(:real^N)") CONVEX_DISTANCE)
    prove
     r"!x:real^N e. convex(ball(x,e))"
     (REWRITE_TAC [convex, IN_BALL] THEN REPEAT STRIP_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand) lemma o lhand o snd) THEN
      ASM_MESON_TAC [REAL_LET_TRANS, REAL_CONVEX_BOUND_LT])

  let CONNECTED_BALL ← prove
   r"!x:real^N e. connected(ball(x,e))"
   (SIMP_TAC [CONVEX_CONNECTED, CONVEX_BALL])

  let CONVEX_CBALL ← prove
   r"!x:real^N e. convex(cball(x,e))"
   (REWRITE_TAC [convex, IN_CBALL, dist] THEN MAP_EVERY X_GEN_TAC
     [← q r"x:real^N", ← q r"e:real", ← q r"y:real^N", ← q r"z:real^N", ← q r"u:real",
      ← q r"v:real"] THEN
    STRIP_TAC THEN ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"a - b = &1 % a - b")] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"(a + b) % x - (a % y + b % z) = a % (x - y) + b % (x - z)")] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"norm(u % (x - y)) + norm(v % (x - z):real^N)") THEN
    REWRITE_TAC [NORM_TRIANGLE, NORM_MUL] THEN
    MATCH_MP_TAC REAL_CONVEX_BOUND_LE THEN ASM_REWRITE_TAC [REAL_ABS_POS] THEN
    ASM_SIMP_TAC [← REAL_ARITH
     (← q r"&0 <= u /\ &0 <= v /\ (u + v = &1) ==> (abs(u) + abs(v) = &1)")])

  let CONNECTED_CBALL ← prove
   r"!x:real^N e. connected(cball(x,e))"
   (SIMP_TAC [CONVEX_CONNECTED, CONVEX_CBALL])

  let CONVEX_INTERMEDIATE_BALL ← prove
   r"!a:real^N r t. ball(a,r) SUBSET t /\ t SUBSET cball(a,r) ==> convex t"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONVEX_CONTAINS_OPEN_SEGMENT] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
      SUBSET_TRANS)) THEN
    REWRITE_TAC [SUBSET, IN_BALL, IN_CBALL] THEN GEN_TAC THEN DISCH_THEN
     (MP_TAC o SPEC (← q r"a:real^N") o MATCH_MP DIST_DECREASES_OPEN_SEGMENT) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
    REWRITE_TAC [IN_CBALL] THEN ASM_MESON_TAC [REAL_LTE_TRANS])

  let FRONTIER_OF_CONNECTED_COMPONENT_SUBSET ← prove
   r"!s x:real^N. frontier(connected_component s x) SUBSET frontier s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [frontier, SUBSET, IN_DIFF] THEN
    X_GEN_TAC (← q r"y:real^N") THEN REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"y IN s ==> s SUBSET t ==> y IN t"))) THEN
      MATCH_MP_TAC SUBSET_CLOSURE THEN REWRITE_TAC [CONNECTED_COMPONENT_SUBSET],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERIOR]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"ball(y:real^N,e) SUBSET connected_component s y")
      ASSUME_TAC THENL
       [MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
        ASM_REWRITE_TAC [CONNECTED_BALL, CENTRE_IN_BALL],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CLOSURE_APPROACHABLE]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
        ASM_REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM IN_BALL)] THEN
        STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
        REWRITE_TAC [IN_INTERIOR] THEN EXISTS_TAC (← q r"e:real") THEN
        MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N", ← q r"y:real^N"]
          CONNECTED_COMPONENT_OVERLAP) THEN
        MATCH_MP_TAC (← TAUT (← q r"p /\ (q ==> r) ==> (p <=> q) ==> r")) THEN
        ASM_SIMP_TAC [] THEN ASM SET_TAC []]])

  let FRONTIER_OF_COMPONENTS_SUBSET ← prove
   r"!s c:real^N->bool.
        c IN components s ==> frontier c SUBSET frontier s"
   (SIMP_TAC [components, FORALL_IN_GSPEC,
              FRONTIER_OF_CONNECTED_COMPONENT_SUBSET])

  let FRONTIER_OF_COMPONENTS_CLOSED_COMPLEMENT ← prove
   r"!s c. closed s /\ c IN components ((:real^N) DIFF s)
         ==> frontier c SUBSET s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FRONTIER_OF_COMPONENTS_SUBSET) THEN
    REWRITE_TAC [FRONTIER_COMPLEMENT] THEN
    ASM_MESON_TAC [FRONTIER_SUBSET_EQ, SUBSET_TRANS])

  let CONTAINS_COMPONENT_OF_COMPACT_FRONTIER ← prove
   r"!s:real^N->bool c.
        compact s /\ c IN components s
        ==> ?d. d IN components(frontier s) /\ d SUBSET c"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"~(UNIONS(components(frontier s)) INTER c:real^N->bool = {})")
     MP_TAC THENL
      [REWRITE_TAC [← GSYM UNIONS_COMPONENTS] THEN
       FIRST_ASSUM (MP_TAC o MATCH_MP FRONTIER_OF_COMPONENTS_SUBSET) THEN
       MATCH_MP_TAC (← SET_RULE
        (← q r"f SUBSET c /\ ~(f = {}) ==> f SUBSET s ==> ~(s INTER c = {})")) THEN
       REWRITE_TAC [FRONTIER_SUBSET_EQ, FRONTIER_EQ_EMPTY, DE_MORGAN_THM] THEN
       MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"c:real^N->bool"]
         COMPACT_COMPONENTS) THEN
       ASM_REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN REPEAT STRIP_TAC THEN
       ASM_REWRITE_TAC [] THENL
        [ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY],
         ASM_MESON_TAC [NOT_BOUNDED_UNIV]],
       REWRITE_TAC [INTER_UNIONS, EMPTY_UNIONS, FORALL_IN_GSPEC] THEN
       REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN MATCH_MP_TAC MONO_EXISTS THEN
       X_GEN_TAC (← q r"d:real^N->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
       MATCH_MP_TAC COMPONENTS_MAXIMAL THEN
       EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
       ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REWRITE_TAC [] THEN
       CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED], ALL_TAC] THEN
       TRANS_TAC SUBSET_TRANS (← q r"frontier s:real^N->bool") THEN
       ASM_SIMP_TAC [FRONTIER_SUBSET_EQ, COMPACT_IMP_CLOSED] THEN
       ASM_MESON_TAC [IN_COMPONENTS_SUBSET]])

  let CARD_LE_COMPONENTS_FRONTIER ← prove
   r"!s:real^N->bool. compact s ==> components s <=_c components(frontier s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"\s t:real^N->bool. s SUBSET t") THEN
    ASM_SIMP_TAC [CONTAINS_COMPONENT_OF_COMPACT_FRONTIER] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"c:real^N->bool", ← q r"d:real^N->bool", ← q r"e:real^N->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP COMPONENTS_EQ) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
    SET_TAC [])

  let CONTAINS_COMPONENT_OF_CLOSURE_FRONTIER ← prove
   r"!s:real^N->bool c.
        bounded s /\ c IN components(closure s)
        ==> ?d. d IN components(frontier s) /\ d SUBSET c"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"closure s:real^N->bool", ← q r"c:real^N->bool"]
          CONTAINS_COMPONENT_OF_COMPACT_FRONTIER) THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"~(UNIONS(components(frontier s)) INTER c:real^N->bool = {})")
    MP_TAC THENL
     [REWRITE_TAC [← GSYM UNIONS_COMPONENTS] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") FRONTIER_CLOSURE_SUBSET) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"(?d. P d) ==> (!d. P d ==> ~(d = {}) /\ d SUBSET f /\ d SUBSET c)
        ==> f SUBSET g ==> ~(g INTER c = {})"))) THEN
      MESON_TAC [IN_COMPONENTS_SUBSET, IN_COMPONENTS_NONEMPTY],
      REWRITE_TAC [INTER_UNIONS, EMPTY_UNIONS, FORALL_IN_GSPEC] THEN
       REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN MATCH_MP_TAC MONO_EXISTS THEN
       X_GEN_TAC (← q r"d:real^N->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
       MATCH_MP_TAC COMPONENTS_MAXIMAL THEN
       EXISTS_TAC (← q r"closure s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
       ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REWRITE_TAC [] THEN
       CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED], ALL_TAC] THEN
       TRANS_TAC SUBSET_TRANS (← q r"frontier s:real^N->bool") THEN
       CONJ_TAC THENL
        [ASM_MESON_TAC [IN_COMPONENTS_SUBSET],
         REWRITE_TAC [frontier] THEN SET_TAC []]])

  let CARD_LE_COMPONENTS_CLOSURE_FRONTIER ← prove
   r"!s:real^N->bool.
        bounded s ==> components(closure s) <=_c components(frontier s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"\s t:real^N->bool. s SUBSET t") THEN
    ASM_SIMP_TAC [CONTAINS_COMPONENT_OF_CLOSURE_FRONTIER] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"c:real^N->bool", ← q r"d:real^N->bool", ← q r"e:real^N->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP COMPONENTS_EQ) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
    SET_TAC [])

  return { CONVEX_BALL, CONNECTED_BALL, CONVEX_CBALL, CONNECTED_CBALL, CONVEX_INTERMEDIATE_BALL,
           FRONTIER_OF_CONNECTED_COMPONENT_SUBSET, FRONTIER_OF_COMPONENTS_SUBSET,
           FRONTIER_OF_COMPONENTS_CLOSED_COMPLEMENT, CONTAINS_COMPONENT_OF_COMPACT_FRONTIER,
           CARD_LE_COMPONENTS_FRONTIER, CONTAINS_COMPONENT_OF_CLOSURE_FRONTIER,
           CARD_LE_COMPONENTS_CLOSURE_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- A couple of lemmas about components (see Newman IV, 3.3 and 3.4);       -/
/- condition for an open map's image to contain a ball.                      -/
/- (convex.ml 2465-2665)                                                     -/
/- ------------------------------------------------------------------------- -/

structure CMP where
  CONNECTED_UNION_CLOPEN_IN_COMPLEMENT : thm
  COMPONENT_COMPLEMENT_CONNECTED : thm
  BALL_SUBSET_OPEN_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupCMP [HolBase] (D : ConvexDeps) (BCVB : CVB) : ExceptT String IO CMP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, DE_MORGAN_THM, FORALL_AND_THM, .. } := D.core1
  let { FUN_EQ_THM, IMAGE_SUBSET, INTER_COMM, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_EXISTS_THM, NOT_IMP, .. } := D.core3
  let { REAL_LE_TRANS, .. } := D.core4
  let { REAL_NOT_LT, SKOLEM_THM, SUBSET, .. } := D.core5
  let { UNION_COMM, o_ASSOC, o_DEF, o_THM, .. } := D.core6
  let { NORM_SUB, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { CLOSED_IN_SUBTOPOLOGY_UNION, CLOSED_IN_TRANS, OPEN_IN_CLOSED_IN_EQ,
        OPEN_IN_SUBTOPOLOGY_UNION, OPEN_IN_TRANS, TRIVIAL_LIMIT_SEQUENTIALLY, closed_in, .. } :=
    D.met
  let { BOUNDED_SUBSET, CENTRE_IN_BALL, CLOSED_IN_CLOSED, .. } := D.top1
  let { CLOSURE_SEQUENTIAL, CLOSURE_SUBSET, COMPACT_CLOSURE, COMPACT_CONTINUOUS_IMAGE,
        COMPACT_IMP_BOUNDED, COMPONENTS_MAXIMAL, CONNECTED_CLOPEN, CONNECTED_CLOSED_IN,
        CONNECTED_CLOSED_IN_EQ, CONNECTED_INTER_FRONTIER, .. } := D.top2
  let { CONTINUOUS_ON_CLOSURE_SEQUENTIALLY, DISTANCE_ATTAINS_INF, FRONTIER_CLOSED,
        FRONTIER_COMPLEMENT, FRONTIER_EQ_EMPTY, .. } := D.top3
  let { INTERIOR_SUBSET, IN_BALL, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY,
        IN_COMPONENTS_SUBSET, LIM_SUBSEQUENCE, LIM_UNIQUE, NOT_BOUNDED_UNIV, .. } := D.top4
  let { OPEN_IN_OPEN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, compact, frontier, interior,
        open_in, .. } := D.top5
  let { CONNECTED_BALL, .. } := BCVB
  -- @@SCOPE END

  let CONNECTED_UNION_CLOPEN_IN_COMPLEMENT ← prove
   r"!s t u:real^N->bool.
        connected s /\ connected u /\ s SUBSET u /\
        open_in (subtopology euclidean (u DIFF s)) t /\
        closed_in (subtopology euclidean (u DIFF s)) t
        ==> connected (s UNION t)"
   (MAP_EVERY X_GEN_TAC
     [← q r"c:real^N->bool", ← q r"h:real^N->bool", ← q r"s:real^N->bool"] THEN
    STRIP_TAC THEN
    REWRITE_TAC [CONNECTED_CLOSED_IN_EQ, NOT_EXISTS_THM] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"!Q. (!x y. P x y <=> P y x) /\
          (!x y. P x y ==> Q x \/ Q y) /\
          (!x y. P x y /\ Q x ==> F)
          ==> (!x y. ~(P x y))")) THEN
    EXISTS_TAC (← q r"\x:real^N->bool. c SUBSET x") THEN
    CONJ_TAC THENL [MESON_TAC [INTER_COMM, UNION_COMM], ALL_TAC] THEN
    REWRITE_TAC [] THEN CONJ_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"h1:real^N->bool", ← q r"h2:real^N->bool"] THENL
     [STRIP_TAC THEN UNDISCH_TAC (← q r"connected(c:real^N->bool)") THEN
      REWRITE_TAC [CONNECTED_CLOSED_IN, NOT_EXISTS_THM] THEN
      DISCH_THEN (MP_TAC o
        SPECL [← q r"c INTER h1:real^N->bool", ← q r"c INTER h2:real^N->bool"]) THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(p /\ q) /\ (~r ==> s) ==> ~(p /\ q /\ r) ==> s")) THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN CONJ_TAC THENL
       [UNDISCH_TAC
          (← q r"closed_in(subtopology euclidean (c UNION h)) (h1:real^N->bool)"),
        UNDISCH_TAC
          (← q r"closed_in(subtopology euclidean (c UNION h)) (h2:real^N->bool)")] THEN
      REWRITE_TAC [CLOSED_IN_CLOSED] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM SET_TAC [],
      STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [open_in]) THEN
      SUBGOAL_THEN (← q r"(h2:real^N->bool) SUBSET h") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      UNDISCH_TAC (← q r"connected(s:real^N->bool)") THEN
      REWRITE_TAC [CONNECTED_CLOPEN] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"h2:real^N->bool")) THEN REWRITE_TAC [NOT_IMP] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      SUBGOAL_THEN (← q r"s:real^N->bool = (s DIFF c) UNION (c UNION h)")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_UNION THEN
        MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN CONJ_TAC THENL
         [REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
          CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
          SUBGOAL_THEN (← q r"(c UNION h) DIFF h2:real^N->bool = h1")
           (fun th => ASM_REWRITE_TAC [th]) THEN ASM SET_TAC [],
          DISCH_TAC THEN MATCH_MP_TAC OPEN_IN_TRANS THEN
          EXISTS_TAC (← q r"h:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
          UNDISCH_TAC
           (← q r"open_in(subtopology euclidean (c UNION h)) (h2:real^N->bool)") THEN
          REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN
          ASM SET_TAC []],
        MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_UNION THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_TRANS THEN EXISTS_TAC (← q r"h:real^N->bool") THEN
        ASM_REWRITE_TAC [] THEN
        UNDISCH_TAC
         (← q r"closed_in(subtopology euclidean (c UNION h)) (h2:real^N->bool)") THEN
        REWRITE_TAC [CLOSED_IN_CLOSED] THEN MATCH_MP_TAC MONO_EXISTS THEN
        ASM SET_TAC []]])

  let COMPONENT_COMPLEMENT_CONNECTED ← prove
   r"!s u c:real^N->bool.
        connected s /\ connected u /\ s SUBSET u /\ c IN components (u DIFF s)
        ==> connected(u DIFF c)"
   (MAP_EVERY X_GEN_TAC
     [← q r"a:real^N->bool", ← q r"s:real^N->bool", ← q r"c:real^N->bool"] THEN
    STRIP_TAC THEN UNDISCH_TAC (← q r"connected(a:real^N->bool)") THEN
    REWRITE_TAC [CONNECTED_CLOSED_IN_EQ, NOT_EXISTS_THM] THEN
    DISCH_TAC THEN MAP_EVERY X_GEN_TAC
     [← q r"h3:real^N->bool", ← q r"h4:real^N->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"a INTER h3:real^N->bool", ← q r"a INTER h4:real^N->bool"]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
    EVERY_ASSUM (fun th => tactic_of (tryWith
          (do pure (MP_TAC (← CONJUNCT1 (← GEN_REWRITE_RULE id [closed_in] th))))
          (pure ALL_TAC))) THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN REPEAT DISCH_TAC THEN
    REPEAT CONJ_TAC THENL
     [UNDISCH_TAC (← q r"closed_in (subtopology euclidean (s DIFF c))
                             (h3:real^N->bool)") THEN
      REWRITE_TAC [CLOSED_IN_CLOSED] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM SET_TAC [],
      UNDISCH_TAC (← q r"closed_in (subtopology euclidean (s DIFF c))
                             (h4:real^N->bool)") THEN
      REWRITE_TAC [CLOSED_IN_CLOSED] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM SET_TAC [],
      ASM SET_TAC [],
      ASM SET_TAC [],
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"s DIFF a:real^N->bool", ← q r"c UNION h3:real^N->bool",
                 ← q r"c:real^N->bool"] COMPONENTS_MAXIMAL) THEN
      ASM_REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CONNECTED_UNION_CLOPEN_IN_COMPLEMENT THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED],
        ASM SET_TAC [],
        REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"s DIFF c DIFF h3:real^N->bool = h4") SUBST1_TAC THEN
        ASM SET_TAC []],
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"s DIFF a:real^N->bool", ← q r"c UNION h4:real^N->bool",
                 ← q r"c:real^N->bool"] COMPONENTS_MAXIMAL) THEN
      ASM_REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CONNECTED_UNION_CLOPEN_IN_COMPLEMENT THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED],
        ASM SET_TAC [],
        REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"s DIFF c DIFF h4:real^N->bool = h3") SUBST1_TAC THEN
        ASM SET_TAC []]])

  let BALL_SUBSET_OPEN_MAP_IMAGE ← prove
   r"!f:real^M->real^N s a r.
        bounded s /\ f continuous_on closure s /\ open(IMAGE f (interior s)) /\
        a IN s /\ &0 < r /\ (!z. z IN frontier s ==> r <= norm(f z - f a))
        ==> ball(f(a),r) SUBSET IMAGE f s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"ball((f:real^M->real^N) a,r)",
                      ← q r"(:real^N) DIFF IMAGE (f:real^M->real^N) s"]
      CONNECTED_INTER_FRONTIER) THEN
    REWRITE_TAC [CONNECTED_BALL] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"~(b INTER s = {}) /\ b INTER f = {} ==>
      (~(b INTER (UNIV DIFF s) = {}) /\ ~(b DIFF (UNIV DIFF s) = {})
       ==> ~(b INTER f = {}))
      ==> b SUBSET s")) THEN
    REWRITE_TAC [FRONTIER_COMPLEMENT] THEN CONJ_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
      EXISTS_TAC (← q r"(f:real^M->real^N) a") THEN
      ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN ASM SET_TAC [],
      REWRITE_TAC [← SET_RULE (← q r"s INTER t = {} <=> !x. x IN t ==> ~(x IN s)")] THEN
      REWRITE_TAC [IN_BALL, REAL_NOT_LT]] THEN
    MP_TAC (← ISPECL [← q r"frontier(IMAGE (f:real^M->real^N) s)", ← q r"(f:real^M->real^N) a"]
      DISTANCE_ATTAINS_INF) THEN
    REWRITE_TAC [FRONTIER_CLOSED, FRONTIER_EQ_EMPTY] THEN ANTS_TAC THENL
     [SIMP_TAC [DE_MORGAN_THM] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← MESON [NOT_BOUNDED_UNIV] (← q r"bounded s ==> ~(s = UNIV)")) THEN
      MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (closure s)") THEN
      SIMP_TAC [IMAGE_SUBSET, CLOSURE_SUBSET] THEN
      MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      ASM_REWRITE_TAC [COMPACT_CLOSURE],
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N") STRIP_ASSUME_TAC)] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [frontier]) THEN
    REWRITE_TAC [IN_DIFF] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [CLOSURE_SEQUENTIAL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:num->real^N")
     (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)) THEN
    REWRITE_TAC [IN_IMAGE, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:num->real^M") THEN REWRITE_TAC [FORALL_AND_THM] THEN
    ONCE_REWRITE_TAC [← GSYM FUN_EQ_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM COMPACT_CLOSURE]) THEN
    REWRITE_TAC [compact] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:num->real^M")) THEN
    ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"y:real^M", ← q r"r:num->num"] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(((\n. (f:real^M->real^N)(z n)) o (r:num->num)) --> w) sequentially")
    MP_TAC THENL
     [MATCH_MP_TAC LIM_SUBSEQUENCE THEN ASM_REWRITE_TAC [],
      ONCE_REWRITE_TAC [← GSYM o_DEF] THEN REWRITE_TAC [← GSYM o_ASSOC]] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"!n. ((z:num->real^M) o (r:num->num)) n IN s") MP_TAC THENL
     [ASM_REWRITE_TAC [o_THM],
      UNDISCH_THEN (← q r"((\n. (f:real^M->real^N) ((z:num->real^M) n)) --> w)
                    sequentially") (K ALL_TAC) THEN
      UNDISCH_THEN (← q r"!n. (z:num->real^M) n IN s") (K ALL_TAC)] THEN
    POP_ASSUM_LIST (MP_TAC o end_itlist CONJ o HolLight.rev) THEN
    SPEC_TAC ((← q r"(z:num->real^M) o (r:num->num)"), (← q r"z:num->real^M")) THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"w = (f:real^M->real^N) y") SUBST_ALL_TAC THENL
     [MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"(f:real^M->real^N) o (z:num->real^M)") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_CLOSURE_SEQUENTIALLY],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"norm(f y - (f:real^M->real^N) a)") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC, ASM_MESON_TAC [dist, NORM_SUB]] THEN
    ASM_REWRITE_TAC [frontier, IN_DIFF] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
    REWRITE_TAC [interior, IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (interior s)") THEN
    ASM_SIMP_TAC [IMAGE_SUBSET, INTERIOR_SUBSET] THEN ASM SET_TAC [])

  return { CONNECTED_UNION_CLOPEN_IN_COMPLEMENT, COMPONENT_COMPLEMENT_CONNECTED,
           BALL_SUBSET_OPEN_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Arithmetic operations on sets preserve convexity; some interesting        -/
/- "cancellation" properties for sum-sets.  (convex.ml 2669-2858)            -/
/- ------------------------------------------------------------------------- -/

structure CVA where
  CONVEX_SCALING : thm
  CONVEX_SCALING_EQ : thm
  CONVEX_NEGATIONS : thm
  CONVEX_SUMS : thm
  CONVEX_DIFFERENCES : thm
  CONVEX_AFFINITY_EQ : thm
  CONVEX_AFFINITY : thm
  CONVEX_LINEAR_PREIMAGE : thm
  CONVEX_SUMS_MULTIPLES : thm
  CONVEX_TRANSLATION_SUBSET_PREIMAGE : thm
  CONVEX_TRANSLATION_SUPERSET_PREIMAGE : thm
  SUBSET_SUMS_LCANCEL : thm
  SUBSET_SUMS_RCANCEL : thm
  EQ_SUMS_LCANCEL : thm
  EQ_SUMS_RCANCEL : thm
  deriving Inhabited

@[nospecialize]
def setupCVA [HolBase] (D : ConvexDeps) (BCVX : CVX) : ExceptT String IO CVA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D
  let { EMPTY_SUBSET, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_CONST, IMAGE_ID, IMAGE_o, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        REAL_ADD_LID, REAL_ARCH, REAL_DIV_LMUL, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_DIV, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_LCANCEL_IMP, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_LZERO, REAL_OF_NUM_SUC, SUBSET, SUBSET_ANTISYM,
        SUBSET_ANTISYM_EQ, SUBSET_EMPTY, .. } := D.core5
  let { SWAP_EXISTS_THM, num_INDUCTION, o_DEF, .. } := D.core6
  let { AFFINITY_SCALING_TRANSLATION, DIST_SYM, .. } := D.vec1
  let { LINEAR_ADD, LINEAR_CMUL, .. } := D.vec2
  let { NORM_MUL, SUMS_SYM, TRANSLATION_SUBSET_GALOIS_RIGHT, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC,
        VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_NEG_NEG, dist, .. } := D.vec4
  let { BOUNDED_DIFFS, BOUNDED_POS, CLOSED_APPROACHABLE, .. } := D.top1
  let { convex, CONVEX_ALT, CONVEX_EMPTY, CONVEX_SING, CONVEX_TRANSLATION_EQ, .. } := BCVX
  -- @@SCOPE END

  let CONVEX_SCALING ← prove
   r"!s c. convex s ==> convex (IMAGE (\x. c % x) s)"
   (REWRITE_TAC [convex, IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
     (← q r"u % c % x + v % c % y = c % (u % x + v % y)")] THEN
    ASM_MESON_TAC [])

  let CONVEX_SCALING_EQ ← prove
   r"!s:real^N->bool c. convex (IMAGE (\x. c % x) s) <=> c = &0 \/ convex s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      MESON_TAC [CONVEX_SING, CONVEX_EMPTY],
      EQ_TAC THEN REWRITE_TAC [CONVEX_SCALING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP CONVEX_SCALING) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, IMAGE_ID]])

  let CONVEX_NEGATIONS ← prove
   r"!s. convex s ==> convex (IMAGE (--) s)"
   (REWRITE_TAC [convex, IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
     (← q r"u % --x + v % --y = --(u % x + v % y)")] THEN
    ASM_MESON_TAC [])

  let CONVEX_SUMS ← prove
   r"!s t. convex s /\ convex t ==> convex {x + y | x IN s /\ y IN t}"
   (REWRITE_TAC [convex, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
      (← q r"u % (a + b) + v % (c + d) = (u % a + v % c) + (u % b + v % d)")] THEN
    ASM_MESON_TAC [])

  let CONVEX_DIFFERENCES ← prove
   r"!s t. convex s /\ convex t ==> convex {x - y | x IN s /\ y IN t}"
   (REWRITE_TAC [convex, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
      (← q r"u % (a - b) + v % (c - d) = (u % a + v % c) - (u % b + v % d)")] THEN
    ASM_MESON_TAC [])

  let CONVEX_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        convex (IMAGE (\x. m % x + c) s) <=> m = &0 \/ convex s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, CONVEX_TRANSLATION_EQ,
                 CONVEX_SCALING_EQ, IMAGE_o])

  let CONVEX_AFFINITY ← prove
   r"!s m c:real^N. convex s ==> convex (IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [CONVEX_AFFINITY_EQ])

  let CONVEX_LINEAR_PREIMAGE ← prove
   r"!f:real^M->real^N.
     linear f /\ convex s ==> convex {x | f(x) IN s}"
   (REWRITE_TAC [CONVEX_ALT, IN_ELIM_THM] THEN
    SIMP_TAC [LINEAR_ADD, LINEAR_CMUL])

  let CONVEX_SUMS_MULTIPLES ← prove
   r"!s:real^N->bool c d.
        convex s /\ &0 <= c /\ &0 <= d
        ==> {c % x + d % y | x IN s /\ y IN s} = IMAGE (\x. (c + d) % x) s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [VECTOR_ADD_RDISTRIB] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
    SUBGOAL_THEN (← q r"c = &0 /\ d = &0 \/ &0 < c + d") STRIP_ASSUME_TAC THENL
     [ASM_REAL_ARITH_TAC,
      ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN SET_TAC [],
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, ← GSYM VECTOR_ADD_RDISTRIB] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
      REWRITE_TAC [IN_IMAGE] THEN
      EXISTS_TAC (← q r"c / (c + d) % x + d / (c + d) % y:real^N") THEN CONJ_TAC THENL
       [REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC] THEN
        ASM_SIMP_TAC [REAL_DIV_LMUL, REAL_LT_IMP_NZ],
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [convex]) THEN
        ASM_SIMP_TAC [REAL_LE_DIV, REAL_LT_IMP_LE] THEN
        UNDISCH_TAC (← q r"&0 < c + d") THEN CONV_TAC (fun t => REAL_FIELD t)]])

  let CONVEX_TRANSLATION_SUBSET_PREIMAGE ← prove
   r"!s t:real^N->bool.
        convex t ==> convex {a | IMAGE (\x. a + x) s SUBSET t}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONVEX_ALT] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N", ← q r"u:real"] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, FORALL_IN_IMAGE] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN ONCE_REWRITE_TAC [← VECTOR_ARITH
     (← q r"((&1 - u) % a + u % b) + x:real^N = (&1 - u) % (a + x) + u % (b + x)")] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [])

  let CONVEX_TRANSLATION_SUPERSET_PREIMAGE ← prove
   r"!s t:real^N->bool.
        convex t ==> convex {a | s SUBSET IMAGE (\x. a + x) t}"
   (REWRITE_TAC [TRANSLATION_SUBSET_GALOIS_RIGHT] THEN
    ASM_SIMP_TAC [VECTOR_NEG_NEG, CONVEX_NEGATIONS,
                  CONVEX_TRANSLATION_SUBSET_PREIMAGE, ← SET_RULE
    (← q r"(!x:real^N. --(--x) = x) ==> {a:real^N | P(--a)} = IMAGE (--) {a | P a}")])

  let SUBSET_SUMS_LCANCEL ← prove
   r"!s t u:real^N->bool.
        ~(s = {}) /\ bounded s /\ closed u /\ convex u /\
        {x + y | x IN s /\ y IN t} SUBSET {x + z | x IN s /\ z IN u}
        ==> t SUBSET u"
   (REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN X_GEN_TAC (← q r"b:real^N") THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!n. ?w z:real^N. w IN s /\ z IN u /\ (&n + &1) % (b - z) = w - a")
    MP_TAC THENL
     [INDUCT_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) THEN
        ASM_REWRITE_TAC [REAL_ADD_LID, VECTOR_MUL_LID] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"b - z:real^N = w - a <=> a + b = w + z")] THEN
        MESON_TAC [],
        FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"a':real^N") (X_CHOOSE_THEN (← q r"c':real^N")
          STRIP_ASSUME_TAC)) THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a':real^N", ← q r"b:real^N"]) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"a'':real^N", ← q r"c'':real^N"] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"a'':real^N") THEN EXISTS_TAC
         (← q r"(&1 - &1 / (&n + &2)) % c' + &1 / (&n + &2) % c'':real^N") THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [CONVEX_ALT]) THEN
          ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ,
                        ← REAL_ARITH (← q r"&0 < &n + &2")] THEN
          REAL_ARITH_TAC,
          FIRST_X_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE id
           [← VECTOR_ARITH (← q r"a' + b:real^N = a'' + c <=> a'' = (a' + b) - c")]) THEN
          REWRITE_TAC [← VECTOR_ARITH
           (← q r"(&n + &1) % (b - c):real^N = (a' + b) - c'' - a <=>
            &n % b - (&n + &1) % c = (a' - c'') - a")] THEN
          SIMP_TAC [← GSYM REAL_OF_NUM_SUC, VECTOR_MUL_ASSOC, VECTOR_ADD_LDISTRIB,
                    ← REAL_ARITH (← q r"(n + &1) + &1 = n + &2")] THEN
          REWRITE_TAC [VECTOR_MUL_LID, ← REAL_FIELD
           (← q r"(&n + &2) * (&1 - (&1 / (&n + &2))) = &n + &1 /\
            (&n + &2) * &1 / (&n + &2) = &1")] THEN
          ASM_REWRITE_TAC [← VECTOR_ARITH
           (← q r"n % b - (n % c + d):real^N = n % (b - c) - d")] THEN
          CONV_TAC (fun t => VECTOR_ARITH t)]],
        FIRST_X_ASSUM (fun th => tactic_of do
          let _ ← liftExcept (check HolCore.Basics.is_forall (concl th))
          pure ALL_TAC) THEN
        MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"s:real^N->bool"] BOUNDED_DIFFS) THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [BOUNDED_POS, FORALL_IN_GSPEC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
        DISCH_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
          pure (ONCE_REWRITE_TAC [← GSYM (← MATCH_MP CLOSED_APPROACHABLE th)])) THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← SPEC (← q r"e:real") REAL_ARCH) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"B:real")) THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MATCH_MP_TAC num_INDUCTION THEN REWRITE_TAC [REAL_MUL_LZERO] THEN
        CONJ_TAC THENL [ASM_REAL_ARITH_TAC, X_GEN_TAC (← q r"n:num")] THEN
        DISCH_THEN (K ALL_TAC) THEN REWRITE_TAC [← GSYM REAL_OF_NUM_SUC] THEN
        DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"c:real^N") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^N") STRIP_ASSUME_TAC) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LT_LCANCEL_IMP THEN
        EXISTS_TAC (← q r"abs(&n + &1)") THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
        CONJ_TAC THENL [REAL_ARITH_TAC, REWRITE_TAC [dist]] THEN
        ASM_REWRITE_TAC [← GSYM NORM_MUL] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"abs(&n + &1) = &n + &1")] THEN
        ASM_MESON_TAC [REAL_LET_TRANS]])

  let SUBSET_SUMS_RCANCEL ← prove
   r"!s t u:real^N->bool.
        closed t /\ convex t /\ bounded u /\ ~(u = {}) /\
        {x + z | x IN s /\ z IN u} SUBSET {y + z | y IN t /\ z IN u}
        ==> s SUBSET t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_SUMS_LCANCEL THEN
    EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [SUMS_SYM] THEN ASM_REWRITE_TAC [])

  let EQ_SUMS_LCANCEL ← prove
   r"!s t u.
        ~(s = {}) /\ bounded s /\
        closed t /\ convex t /\ closed u /\ convex u /\
        {x + y | x IN s /\ y IN t} = {x + z | x IN s /\ z IN u}
        ==> t = u"
   (REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, EMPTY_SUBSET] THEN
    REWRITE_TAC [SUBSET_EMPTY] THEN MESON_TAC [SUBSET_SUMS_LCANCEL])

  let EQ_SUMS_RCANCEL ← prove
   r"!s t u.
        closed s /\ convex s /\ closed t /\ convex t /\
        bounded u /\ ~(u = {}) /\
        {x + z | x IN s /\ z IN u} = {y + z | y IN t /\ z IN u}
        ==> s = t"
   (REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, EMPTY_SUBSET] THEN
    REWRITE_TAC [SUBSET_EMPTY] THEN MESON_TAC [SUBSET_SUMS_RCANCEL])

  return { CONVEX_SCALING, CONVEX_SCALING_EQ, CONVEX_NEGATIONS, CONVEX_SUMS, CONVEX_DIFFERENCES,
           CONVEX_AFFINITY_EQ, CONVEX_AFFINITY, CONVEX_LINEAR_PREIMAGE, CONVEX_SUMS_MULTIPLES,
           CONVEX_TRANSLATION_SUBSET_PREIMAGE, CONVEX_TRANSLATION_SUPERSET_PREIMAGE,
           SUBSET_SUMS_LCANCEL, SUBSET_SUMS_RCANCEL, EQ_SUMS_LCANCEL, EQ_SUMS_RCANCEL }

/- ------------------------------------------------------------------------- -/
/- Convex hull; stepping theorems for convex hulls of finite sets.           -/
/- (convex.ml 2862-3011)                                                     -/
/- ------------------------------------------------------------------------- -/

structure CVH where
  CONVEX_CONVEX_HULL : thm
  CONVEX_HULL_EQ : thm
  CONVEX_HULLS_EQ : thm
  IS_CONVEX_HULL : thm
  CONVEX_HULL_CONTAINS : thm
  MIDPOINTS_IN_CONVEX_HULL : thm
  CONVEX_HULL_UNIV : thm
  BOUNDED_CONVEX_HULL : thm
  BOUNDED_CONVEX_HULL_EQ : thm
  FINITE_IMP_BOUNDED_CONVEX_HULL : thm
  CONVEX_HULL_EMPTY : thm
  CONVEX_HULL_EQ_EMPTY : thm
  CONVEX_HULL_SING : thm
  CONVEX_HULL_EQ_SING : thm
  CONVEX_HULL_INSERT : thm
  CONVEX_HULL_INSERT_ALT : thm
  CONVEX_HULL_INSERT_SEGMENTS : thm
  deriving Inhabited

@[nospecialize]
def setupCVH [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVB : CVB) : ExceptT String IO CVH := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV,
        VECTOR_ARITH, .. } := D
  let { EMPTY_SUBSET, .. } := D.core1
  let { IN_ELIM_THM, IN_INSERT, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        REAL_ADD_LID, REAL_ADD_RDISTRIB, REAL_DIV_LMUL, .. } := D.core3
  let { REAL_LE_ADD, REAL_LE_DIV, REAL_LE_MUL, .. } := D.core4
  let { REAL_MUL_RID, REAL_MUL_RINV, REAL_SUB_LE, RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM,
        SUBSET, SUBSET_ANTISYM, SUBSET_EMPTY, SUBSET_REFL, .. } := D.core5
  let { SWAP_EXISTS_THM, UNIONS_GSPEC, UNWIND_THM2, real_div, .. } := D.core6
  let { HULLS_EQ, HULL_EQ, HULL_MINIMAL, HULL_MONO, HULL_SUBSET, HULL_UNIQUE, IS_HULL, P_HULL,
        SUBSET_HULL, .. } := D.misc
  let { NORM_NEG, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, VECTOR_SUB_LZERO, dist, .. } := D.vec4
  let { BOUNDED_CBALL, BOUNDED_SUBSET, .. } := D.top1
  let { FINITE_IMP_BOUNDED, .. } := D.top3
  let { IN_CBALL, IN_SEGMENT, .. } := D.top4
  let { bounded, .. } := D.top5
  let { convex, MIDPOINT_IN_CONVEX, CONVEX_CONTAINS, CONVEX_EMPTY, CONVEX_SING, CONVEX_UNIV,
        CONVEX_INTERS, .. } := BCVX
  let { CONVEX_CBALL, .. } := BCVB
  -- @@SCOPE END

  let CONVEX_CONVEX_HULL ← prove
   r"!s. convex(convex hull s)"
   (SIMP_TAC [P_HULL, CONVEX_INTERS])

  let CONVEX_HULL_EQ ← prove
   r"!s. (convex hull s = s) <=> convex s"
   (SIMP_TAC [HULL_EQ, CONVEX_INTERS])

  let CONVEX_HULLS_EQ ← prove
   r"!s t. s SUBSET convex hull t /\ t SUBSET convex hull s
         ==> convex hull s = convex hull t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HULLS_EQ THEN
    ASM_SIMP_TAC [CONVEX_INTERS])

  let IS_CONVEX_HULL ← prove
   r"!s. convex s <=> ?t. s = convex hull t"
   (GEN_TAC THEN MATCH_MP_TAC IS_HULL THEN SIMP_TAC [CONVEX_INTERS])

  let CONVEX_HULL_CONTAINS ← prove
   r"!s a b x:real^N.
        a IN convex hull s /\ b IN convex hull s /\ x IN segment[a,b]
        ==> x IN convex hull s"
   (MESON_TAC [CONVEX_CONTAINS, CONVEX_CONVEX_HULL])

  let MIDPOINTS_IN_CONVEX_HULL ← prove
   r"!x:real^N s. x IN convex hull s /\ y IN convex hull s
         ==> midpoint(x,y) IN convex hull s"
   (MESON_TAC [MIDPOINT_IN_CONVEX, CONVEX_CONVEX_HULL])

  let CONVEX_HULL_UNIV ← prove
   r"convex hull (:real^N) = (:real^N)"
   (REWRITE_TAC [CONVEX_HULL_EQ, CONVEX_UNIV])

  let BOUNDED_CONVEX_HULL ← prove
   r"!s:real^N->bool. bounded s ==> bounded(convex hull s)"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [bounded] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN EXISTS_TAC (← q r"cball(vec 0:real^N,B)") THEN
    SIMP_TAC [BOUNDED_CBALL, SUBSET_HULL, CONVEX_CBALL] THEN
    ASM_REWRITE_TAC [IN_CBALL, SUBSET, dist, VECTOR_SUB_LZERO, NORM_NEG])

  let BOUNDED_CONVEX_HULL_EQ ← prove
   r"!s. bounded(convex hull s) <=> bounded s"
   (MESON_TAC [BOUNDED_CONVEX_HULL, HULL_SUBSET, BOUNDED_SUBSET])

  let FINITE_IMP_BOUNDED_CONVEX_HULL ← prove
   r"!s. FINITE s ==> bounded(convex hull s)"
   (SIMP_TAC [BOUNDED_CONVEX_HULL, FINITE_IMP_BOUNDED])

  let CONVEX_HULL_EMPTY ← prove
   r"convex hull {} = {}"
   (MATCH_MP_TAC HULL_UNIQUE THEN
    REWRITE_TAC [SUBSET_REFL, CONVEX_EMPTY, EMPTY_SUBSET])

  let CONVEX_HULL_EQ_EMPTY ← prove
   r"!s. (convex hull s = {}) <=> (s = {})"
   (GEN_TAC THEN EQ_TAC THEN
    MESON_TAC [SUBSET_EMPTY, HULL_SUBSET, CONVEX_HULL_EMPTY])

  let CONVEX_HULL_SING ← prove
   r"!a. convex hull {a} = {a}"
   (REWRITE_TAC [CONVEX_HULL_EQ, CONVEX_SING])

  let CONVEX_HULL_EQ_SING ← prove
   r"!s a:real^N. convex hull s = {a} <=> s = {a}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [CONVEX_HULL_EMPTY] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [CONVEX_HULL_SING] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"~(s = {}) /\ s SUBSET {a} ==> s = {a}")) THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [HULL_SUBSET])

  let CONVEX_HULL_INSERT ← prove
   r"!s a. ~(s = {})
         ==> convex hull (a INSERT s) =
               {x:real^N | ?u v b. &0 <= u /\ &0 <= v /\ u + v = &1 /\
                                    b IN (convex hull s) /\
                                    x = u % a + v % b}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC HULL_MINIMAL THEN CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INSERT] THEN
        X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THENL
         [MAP_EVERY EXISTS_TAC [← q r"&1", ← q r"&0"],
          MAP_EVERY EXISTS_TAC [← q r"&0", ← q r"&1"]] THEN
        ASM_REWRITE_TAC [VECTOR_MUL_LID, VECTOR_MUL_LZERO] THEN
        ASM_REWRITE_TAC [VECTOR_ADD_LID, VECTOR_ADD_RID] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_MESON_TAC [MEMBER_NOT_EMPTY, HULL_SUBSET, SUBSET],
        ALL_TAC],
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [convex] CONVEX_CONVEX_HULL) THEN
      ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [HULL_SUBSET, SUBSET, IN_INSERT, HULL_MONO]] THEN
    REWRITE_TAC [convex, IN_ELIM_THM] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real", ← q r"u1:real",
      ← q r"v1:real", ← q r"b1:real^N", ← q r"u2:real", ← q r"v2:real",
      ← q r"b2:real^N"] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY EXISTS_TAC [← q r"u * u1 + v * u2", ← q r"u * v1 + v * v2"] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"u % (u1 % a + v1 % b1) + v % (u2 % a + v2 % b2):real^N =
      (u * u1 + v * u2) % a + (u * v1) % b1 + (v * v2) % b2")] THEN
    ASM_SIMP_TAC [REAL_LE_ADD, REAL_LE_MUL] THEN
    ASM_REWRITE_TAC [REAL_MUL_RID, ← REAL_ARITH
     (← q r"(u * u1 + v * u2) + (u * v1 + v * v2) =
      u * (u1 + v1) + v * (u2 + v2)")] THEN
    ASM_CASES_TAC (← q r"u * v1 + v * v2 = &0") THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"(a + b = &0) ==> &0 <= a /\ &0 <= b ==> (a = &0) /\ (b = &0)"))) THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_ADD_LID, VECTOR_MUL_LZERO,
                    VECTOR_ADD_RID] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"(u * v1) / (u * v1 + v * v2) % b1 +
                (v * v2) / (u * v1 + v * v2) % b2 :real^N") THEN
    ASM_SIMP_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, REAL_DIV_LMUL] THEN
    MATCH_MP_TAC (← REWRITE_RULE [convex] CONVEX_CONVEX_HULL) THEN
    ASM_SIMP_TAC [REAL_LE_DIV, REAL_LE_MUL, REAL_LE_ADD] THEN
    ASM_SIMP_TAC [real_div, ← GSYM REAL_ADD_RDISTRIB, REAL_MUL_RINV])

  let CONVEX_HULL_INSERT_ALT ← prove
   r"!s a:real^N.
      convex hull (a INSERT s) =
      if s = {} then {a}
      else {(&1 - u) % a + u % x | &0 <= u /\ u <= &1 /\ x IN convex hull s}"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [CONVEX_HULL_SING] THEN
    ASM_SIMP_TAC [CONVEX_HULL_INSERT] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c /\ d <=> b /\ c /\ a /\ d")] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, UNWIND_THM2, REAL_SUB_LE,
                 ← REAL_ARITH (← q r"u + v = &1 <=> u = &1 - v")] THEN
    SET_TAC [])

  let CONVEX_HULL_INSERT_SEGMENTS ← prove
   r"!s a:real^N.
        convex hull (a INSERT s) =
        if s = {} then {a} else  UNIONS {segment[a,x] | x IN convex hull s}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONVEX_HULL_INSERT_ALT] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [UNIONS_GSPEC, IN_SEGMENT] THEN
    SET_TAC [])

  return { CONVEX_CONVEX_HULL, CONVEX_HULL_EQ, CONVEX_HULLS_EQ, IS_CONVEX_HULL,
           CONVEX_HULL_CONTAINS, MIDPOINTS_IN_CONVEX_HULL, CONVEX_HULL_UNIV,
           BOUNDED_CONVEX_HULL, BOUNDED_CONVEX_HULL_EQ, FINITE_IMP_BOUNDED_CONVEX_HULL,
           CONVEX_HULL_EMPTY, CONVEX_HULL_EQ_EMPTY, CONVEX_HULL_SING, CONVEX_HULL_EQ_SING,
           CONVEX_HULL_INSERT, CONVEX_HULL_INSERT_ALT, CONVEX_HULL_INSERT_SEGMENTS }

/- ------------------------------------------------------------------------- -/
/- Explicit expressions for convex hull; another formulation from Lars       -/
/- Schewe; a stepping theorem for that expansion.  (convex.ml 3015-3412)     -/
/- ------------------------------------------------------------------------- -/

structure CVE where
  CONVEX_HULL_INDEXED : thm
  CONVEX_HULL_FINITE_IMAGE_EXPLICIT : thm
  CONVEX_HULL_EXPLICIT : thm
  CONVEX_HULL_FINITE : thm
  CONVEX_HULL_IMAGE : thm
  CONVEX_HULL_IMAGE_LT : thm
  CONVEX_HULL_UNION_EXPLICIT : thm
  CONVEX_HULL_UNION_NONEMPTY_EXPLICIT : thm
  CONVEX_HULL_UNION_UNIONS : thm
  CONVEX_HULL_FINITE_STEP : thm
  deriving Inhabited

@[nospecialize]
def setupCVE [HolBase] (D : ConvexDeps) (BAFS : AFS) (BCVX : CVX) (BCVS : CVS) (BCVH : CVH) :
    ExceptT String IO CVE := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_FIELD, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, ASM_REWRITE_RULE, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D
  let { ADD_SUB2, ADD_SYM, ARITH, ARITH_EQ, COND_ID, COND_RAND, COND_RATOR, CONJ_ASSOC,
        CONJ_SYM, DISJOINT_NUMSEG, EMPTY_GSPEC, EQ_ADD_LCANCEL, EQ_TRANS, EXISTS_IN_GSPEC,
        EXTENSION, FINITE_DIFF, FINITE_IMAGE, FINITE_INDEX_NUMSEG, FINITE_INDUCT_STRONG,
        FINITE_INTER, FINITE_NUMSEG, FINITE_RESTRICT, FINITE_RULES,
        FORALL_FINITE_SUBSET_IMAGE_INJ, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_IN_UNIONS, FUN_EQ_THM, IMAGE, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, INTER_SUBSET, IN_DIFF, .. } :=
    D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_SING, IN_UNION, IN_UNIONS,
        LEFT_AND_EXISTS_THM, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NEUTRAL_REAL_ADD, NOT_IN_EMPTY, NUMSEG_ADD_SPLIT, NUMSEG_OFFSET_IMAGE,
        NUMSEG_SING, REAL_ADD_LID, REAL_ADD_RID, REAL_DIV_REFL, .. } := D.core3
  let { REAL_LE_ADD, REAL_LE_DIV, REAL_LE_INV_EQ, REAL_LE_MUL, REAL_LE_REFL, REAL_LT_IMP_LE,
        REAL_LT_LE, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_RID, REAL_MUL_RINV, REAL_MUL_SYM, REAL_OF_NUM_EQ, REAL_POS,
        REAL_SUB_0, REAL_SUB_REFL, REAL_SUB_RZERO, RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM,
        SUBSET, SUBSET_ANTISYM, SUBSET_DIFF, SUBSET_RESTRICT, SUBSET_TRANS, SUBSET_UNION, .. } :=
    D.core5
  let { SUM_CLAUSES, SUM_DELTA, SUM_IMAGE, SUM_IMAGE_GEN, SUM_LMUL, SUM_POS_EQ_0, SUM_POS_LE,
        SUM_RESTRICT_SET, SUM_RMUL, SUM_SING, SUM_SUPERSET, SUM_SUPPORT, SUM_UNION,
        SUPPORT_SUBSET, SWAP_EXISTS_THM, UNIONS_SUBSET, UNION_ASSOC, UNION_EMPTY, UNION_SUBSET,
        UNWIND_THM1, iterate, o_DEF, o_THM, real_div, sum, support, .. } := D.core6
  let { HULL_INC, HULL_MONO, HULL_P, HULL_SUBSET, HULL_UNION_LEFT, HULL_UNIQUE, .. } := D.misc
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VSUM_0, VSUM_CLAUSES, VSUM_EQ, VSUM_IMAGE, VSUM_IMAGE_GEN, VSUM_LMUL,
        VSUM_RESTRICT_SET, VSUM_RMUL, VSUM_SING, VSUM_SUPERSET, VSUM_UNION, VSUM_VMUL, .. } :=
    D.vec4
  let { AFFINE_HULL_FINITE_STEP_GEN, .. } := BAFS
  let { convex, CONVEX_ALT, .. } := BCVX
  let { CONVEX_INDEXED, CONVEX_EXPLICIT, .. } := BCVS
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EMPTY, CONVEX_HULL_EQ_EMPTY, CONVEX_HULL_SING,
        CONVEX_HULL_INSERT, .. } := BCVH
  -- @@SCOPE END

  let CONVEX_HULL_INDEXED ← prove
   r"!s. convex hull s =
        {y:real^N | ?k u x. (!i. 1 <= i /\ i <= k ==> &0 <= u i /\ x i IN s) /\
                            (sum (1..k) u = &1) /\
                            (vsum (1..k) (\i. u i % x i) = y)}"
   (GEN_TAC THEN MATCH_MP_TAC HULL_UNIQUE THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"1", ← q r"\i:num. &1", ← q r"\i:num. x:real^N"] THEN
      ASM_SIMP_TAC [FINITE_RULES, IN_SING, SUM_SING, VECTOR_MUL_LID, VSUM_SING,
                    REAL_POS, NUMSEG_SING],
      ALL_TAC,
      REWRITE_TAC [CONVEX_INDEXED, SUBSET, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      MESON_TAC []] THEN
    REWRITE_TAC [convex, IN_ELIM_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
     [← q r"k1:num", ← q r"u1:num->real", ← q r"x1:num->real^N",
      ← q r"k2:num", ← q r"u2:num->real", ← q r"x2:num->real^N"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"k1 + k2:num") THEN
    EXISTS_TAC (← q r"\i:num. if i <= k1 then u * u1(i) else v * u2(i - k1):real") THEN
    EXISTS_TAC (← q r"\i:num. if i <= k1 then x1(i) else x2(i - k1):real^N") THEN
    ASM_SIMP_TAC [NUMSEG_ADD_SPLIT, ← ARITH_RULE (← q r"1 <= x + 1 /\ x < x + 1"),
     IN_NUMSEG, SUM_UNION, VSUM_UNION, FINITE_NUMSEG, DISJOINT_NUMSEG,
     ← ARITH_RULE (← q r"k1 + 1 <= i ==> ~(i <= k1)")] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [ADD_SYM] NUMSEG_OFFSET_IMAGE] THEN
    ASM_SIMP_TAC [SUM_IMAGE, VSUM_IMAGE, EQ_ADD_LCANCEL, FINITE_NUMSEG] THEN
    ASM_SIMP_TAC [o_DEF, ADD_SUB2, SUM_LMUL, VSUM_LMUL, ← GSYM VECTOR_MUL_ASSOC,
                  FINITE_NUMSEG, REAL_MUL_RID] THEN
    ASM_MESON_TAC [REAL_LE_MUL, ← ARITH_RULE
      (← q r"i <= k1 + k2 /\ ~(i <= k1) ==> 1 <= i - k1 /\ i - k1 <= k2")])

  let CONVEX_HULL_FINITE_IMAGE_EXPLICIT ← prove
   r"!f:A->real^N k.
        FINITE k
        ==> convex hull (IMAGE f k) =
             {y | ?u. (!a. a IN k ==> &0 <= u a) /\
                      sum k u = &1 /\
                      vsum k (\a. u a % f a) = y}"
   (GEN_TAC THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [SUM_CLAUSES, REAL_OF_NUM_EQ, CONVEX_HULL_EMPTY,
                 ARITH_EQ, IMAGE_CLAUSES, EMPTY_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q r"b:A", ← q r"k:A->bool"] THEN
    ASM_CASES_TAC (← q r"k:A->bool = {}") THENL
     [ASM_REWRITE_TAC [IMAGE_CLAUSES, SUM_SING, VSUM_SING, CONVEX_HULL_SING] THEN
      REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
      REWRITE_TAC [← MESON [] (← q r"&0 <= u /\ u = &1 /\ u % x:real^N = y <=>
                           u = &1 /\ &0 <= &1 /\ &1 % x = y")] THEN
      REWRITE_TAC [REAL_POS, VECTOR_MUL_LID, LEFT_EXISTS_AND_THM] THEN
      DISCH_THEN (K ALL_TAC) THEN
      SUBGOAL_THEN (← q r"?u:A->real. u b = &1")
       (fun th => REWRITE_TAC [th] THEN SET_TAC []) THEN
      EXISTS_TAC (← q r"\a:A. &1") THEN REWRITE_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [CONVEX_HULL_INSERT, IMAGE_EQ_EMPTY] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [IN_ELIM_THM, SUM_CLAUSES, VSUM_CLAUSES] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN REWRITE_TAC [FORALL_IN_INSERT] THEN
    X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
    EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
     [MAP_EVERY X_GEN_TAC [← q r"u:real", ← q r"v:real", ← q r"z:real^N", ← q r"c:A->real"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"\a. if a = b then u else v * (c:A->real) a") THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE
       (← q r"~(b IN k) ==> !a. a IN k ==> ~(a = b)"))) THEN
      ASM_SIMP_TAC [← GSYM VECTOR_MUL_ASSOC, VSUM_LMUL, SUM_LMUL] THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_MUL_RID],
      X_GEN_TAC (← q r"c:A->real") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"(c:A->real) b = &1") THENL
       [UNDISCH_TAC (← q r"c(b:A) + sum k c = &1") THEN
        ASM_REWRITE_TAC [← REAL_ARITH (← q r"&1 + x = &1 <=> x = &0")] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
         (← REWRITE_RULE [CONJ_ASSOC] SUM_POS_EQ_0))) THEN
        ASM_SIMP_TAC [] THEN DISCH_TAC THEN
        MAP_EVERY EXISTS_TAC [← q r"&1", ← q r"&0"] THEN
        EXPAND_TAC "y" THEN REWRITE_TAC [← VECTOR_ARITH
          (← q r"c % f + v:real^N = &1 % f + &0 % b <=> v = (&1 - c) % f")] THEN
        ASM_SIMP_TAC [VECTOR_MUL_LZERO, VSUM_0, REAL_SUB_REFL] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [CONJ_ASSOC] THEN
        ONCE_REWRITE_TAC [CONJ_SYM] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
        REWRITE_TAC [UNWIND_THM1] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"d:A")) THEN
        EXISTS_TAC (← q r"\a:A. if a = d then &1 else &0") THEN
        ASM_REWRITE_TAC [SUM_DELTA] THEN MESON_TAC [REAL_POS],
        MAP_EVERY EXISTS_TAC
         [← q r"(c:A->real) b", ← q r"&1 - (c:A->real) b",
          ← q r"vsum k (\a. (c:A->real) a / (&1 - c b) % f a):real^N",
          ← q r"\a. (c:A->real) a / (&1 - c b)"] THEN
        ASM_REWRITE_TAC [← REAL_ARITH (← q r"x + &1 - x = &1")] THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div] THEN
        REWRITE_TAC [← GSYM VECTOR_MUL_ASSOC, SUM_LMUL, VSUM_LMUL] THEN
        ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, REAL_SUB_0] THEN
        ASM_REWRITE_TAC [VECTOR_MUL_LID] THEN
        ASM_SIMP_TAC [← REAL_FIELD
         (← q r"~(c = &1) ==> (inv(&1 - c) * b = &1 <=> c + b = &1)")] THEN
        MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
        ASM_SIMP_TAC [REAL_LE_MUL, REAL_LE_INV_EQ] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"c + s = &1 ==> &0 <= s ==> &0 <= &1 - c"))) THEN
        ASM_SIMP_TAC [SUM_POS_LE]]])

  let CONVEX_HULL_EXPLICIT ← prove
   r"!p. convex hull p =
        {y:real^N | ?s u. FINITE s /\ s SUBSET p /\
             (!x. x IN s ==> &0 <= u x) /\
             sum s u = &1 /\ vsum s (\v. u v % v) = y}"
   (REWRITE_TAC [CONVEX_HULL_INDEXED, EXTENSION, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
    [MAP_EVERY EXISTS_TAC [← q r"IMAGE (x':num->real^N) (1..k)",
                           ← q r"\v:real^N.sum {i | i IN (1..k) /\ x' i = v} u"]
     THEN ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, IN_IMAGE] THEN
     REPEAT STRIP_TAC THENL
     [REWRITE_TAC [IMAGE, SUBSET, IN_ELIM_THM, IN_NUMSEG] THEN
        ASM_MESON_TAC [],
      MATCH_MP_TAC SUM_POS_LE THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, FINITE_RESTRICT, IN_ELIM_THM, IN_NUMSEG],
      ASM_SIMP_TAC [← GSYM SUM_IMAGE_GEN, FINITE_IMAGE, FINITE_NUMSEG],
      FIRST_X_ASSUM (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
      ASM_SIMP_TAC [← GSYM VSUM_IMAGE_GEN, FINITE_IMAGE,
                    FINITE_NUMSEG, VSUM_VMUL, FINITE_RESTRICT] THEN
        MP_TAC (← ISPECL [← q r"x':num->real^N", ← q r"\i:num.u i % (x' i):real^N",
                          ← q r"(1..k)"]
                        (← GSYM VSUM_IMAGE_GEN)) THEN
        ASM_SIMP_TAC [FINITE_NUMSEG]], ALL_TAC] THEN
    STRIP_ASSUME_TAC (← ASM_REWRITE_RULE [← ASSUME (← q r"FINITE (s:real^N->bool)")]
     (← ISPEC (← q r"s:real^N->bool") FINITE_INDEX_NUMSEG)) THEN
    MAP_EVERY EXISTS_TAC [← q r"CARD (s:real^N->bool)",
                          ← q r"(u:real^N->real) o (f:num->real^N)",
                          ← q r"(f:num->real^N)"] THEN
    REPEAT STRIP_TAC THENL
    [REWRITE_TAC [o_DEF] THEN FIRST_ASSUM MATCH_MP_TAC THEN
       FIRST_ASSUM SUBST1_TAC THEN
       REWRITE_TAC [IN_IMAGE, IN_NUMSEG] THEN
       ASM_MESON_TAC [],
     MATCH_MP_TAC (← REWRITE_RULE [SUBSET]
       (← ASSUME (← q r"(s:real^N->bool) SUBSET p"))) THEN
       FIRST_ASSUM SUBST1_TAC THEN
       REWRITE_TAC [IN_IMAGE, IN_NUMSEG] THEN
       ASM_MESON_TAC [],
     MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC (← q r"sum (s:real^N->bool) u") THEN
       CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC []] THEN
       GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
        [← ASSUME (← q r"(s:real^N->bool) = IMAGE f (1..CARD s)")] THEN
       MATCH_MP_TAC (← GSYM SUM_IMAGE) THEN
       ASM_MESON_TAC [],
     REWRITE_TAC [← MESON [o_THM, FUN_EQ_THM]
      (← q r"(\i:num. (u o f) i % f i) = (\v:real^N. u v % v) o f")] THEN
       MATCH_MP_TAC EQ_TRANS THEN
       EXISTS_TAC (← q r"vsum (s:real^N->bool) (\v. u v % v)") THEN
       CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC []] THEN
       GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
        [← ASSUME (← q r"(s:real^N->bool) = IMAGE f (1..CARD s)")] THEN
       MATCH_MP_TAC (← GSYM VSUM_IMAGE) THEN
       ASM SET_TAC [FINITE_NUMSEG]])

  let CONVEX_HULL_FINITE ← prove
   r"!s:real^N->bool.
        convex hull s =
          {y | ?u. (!x. x IN s ==> &0 <= u x) /\
                   sum s u = &1 /\
                   vsum s (\x. u x % x) = y}"
   (GEN_TAC THEN GEN_REWRITE_TAC id [EXTENSION] THEN
    REWRITE_TAC [CONVEX_HULL_EXPLICIT, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
     [MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"f:real^N->real"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"\x:real^N. if x IN t then f x else &0") THEN
      REWRITE_TAC [COND_RAND, COND_RATOR, VECTOR_MUL_LZERO] THEN
      REWRITE_TAC [← GSYM SUM_RESTRICT_SET, ← GSYM VSUM_RESTRICT_SET] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"t SUBSET s ==> {x | x IN s /\ x IN t} = t")] THEN
      REWRITE_TAC [REAL_LE_REFL, COND_ID],
      X_GEN_TAC (← q r"f:real^N->real") THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [SUM_CLAUSES, REAL_OF_NUM_EQ, ARITH] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"support (+) (f:real^N->real) s") THEN
      EXISTS_TAC (← q r"f:real^N->real") THEN
      MP_TAC (← ASSUME (← q r"sum s (f:real^N->real) = &1")) THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [sum] THEN
      REWRITE_TAC [iterate] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [NEUTRAL_REAL_ADD, REAL_OF_NUM_EQ, ARITH] THEN
      DISCH_THEN (K ALL_TAC) THEN
      UNDISCH_TAC (← q r"sum s (f:real^N->real) = &1") THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM SUM_SUPPORT] THEN
      ASM_CASES_TAC (← q r"support (+) (f:real^N->real) s = {}") THEN
      ASM_SIMP_TAC [SUM_CLAUSES, REAL_OF_NUM_EQ, ARITH] THEN
      DISCH_TAC THEN REWRITE_TAC [SUPPORT_SUBSET] THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [support, IN_ELIM_THM], ALL_TAC] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC VSUM_SUPERSET THEN
      REWRITE_TAC [SUPPORT_SUBSET] THEN
      REWRITE_TAC [support, IN_ELIM_THM, NEUTRAL_REAL_ADD] THEN
      MESON_TAC [VECTOR_MUL_LZERO]])

  let CONVEX_HULL_IMAGE ← prove
   r"!f:A->real^N k.
        convex hull (IMAGE f k) =
             {y | ?c u. FINITE c /\ c SUBSET k /\
                        (!a. a IN c ==> &0 <= u a) /\
                        sum c u = &1 /\
                        vsum c (\a. u a % f a) = y}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONVEX_HULL_EXPLICIT] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN EQ_TAC THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
     [ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE_INJ] THEN
      X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"u:real^N->real") THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) SUM_IMAGE o
          lhand o lhand o rand o lhand o snd) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN SUBST1_TAC] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) VSUM_IMAGE o
          lhand o rand o rand o lhand o snd) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"c:A->bool", ← q r"(u:real^N->real) o (f:A->real^N)"] THEN
      ASM_SIMP_TAC [← GSYM SUM_IMAGE, ← GSYM VSUM_IMAGE] THEN ASM_SIMP_TAC [o_DEF],
      MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"u:A->real"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE (f:A->real^N) c") THEN
      EXISTS_TAC (← q r"\y. sum {a | a IN c /\ (f:A->real^N) a = y} u") THEN
      ASM_SIMP_TAC [← GSYM SUM_IMAGE_GEN, FINITE_IMAGE, IMAGE_SUBSET] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC SUM_POS_LE THEN ASM SET_TAC [],
        FIRST_X_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
        MP_TAC (← GEN (← q r"g:A->real^N")
         (← ISPECL [← q r"f:A->real^N", ← q r"g:A->real^N", ← q r"c:A->bool"]
           VSUM_IMAGE_GEN)) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
        MATCH_MP_TAC VSUM_EQ THEN SIMP_TAC [FORALL_IN_IMAGE, ← GSYM VSUM_RMUL] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC VSUM_EQ THEN SET_TAC []]])

  let CONVEX_HULL_IMAGE_LT ← prove
   r"!f:A->real^N k.
        convex hull (IMAGE f k) =
             {y | ?c u. FINITE c /\ c SUBSET k /\
                        (!a. a IN c ==> &0 < u a) /\
                        sum c u = &1 /\
                        vsum c (\a. u a % f a) = y}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONVEX_HULL_IMAGE] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN EQ_TAC THENL
     [ONCE_REWRITE_TAC [SWAP_EXISTS_THM], MESON_TAC [REAL_LT_IMP_LE]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->real") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"{a | a IN c /\ &0 < (u:A->real) a}") THEN
    ASM_SIMP_TAC [FINITE_RESTRICT, IN_ELIM_THM] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
    CONV_TAC SYM_CONV THENL
     [MATCH_MP_TAC SUM_SUPERSET, MATCH_MP_TAC VSUM_SUPERSET] THEN
    REWRITE_TAC [SUBSET_RESTRICT, IN_ELIM_THM] THEN
    ASM_SIMP_TAC [IMP_CONJ, REAL_LT_LE] THEN MESON_TAC [VECTOR_MUL_LZERO])

  let CONVEX_HULL_UNION_EXPLICIT ← prove
   r"!s t:real^N->bool.
        convex s /\ convex t
        ==> convex hull (s UNION t) =
             s UNION t UNION
             {(&1 - u) % x + u % y | x IN s /\ y IN t /\ &0 <= u /\ u <= &1}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [CONVEX_HULL_EXPLICIT] THEN GEN_REWRITE_TAC id [SUBSET] THEN
      REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"y:real^N", ← q r"u:real^N->bool", ← q r"f:real^N->real"] THEN
      REPLICATE_TAC 3 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      SUBST1_TAC (← SET_RULE (← q r"u:real^N->bool = (u INTER s) UNION (u DIFF s)")) THEN
      ASM_SIMP_TAC [SUM_UNION, VSUM_UNION, FINITE_INTER, FINITE_DIFF,
                    ← SET_RULE (← q r"DISJOINT (u INTER s) (u DIFF s)")] THEN
      ASM_CASES_TAC (← q r"sum (u INTER s) (f:real^N->real) = &0") THENL
       [SUBGOAL_THEN (← q r"!x. x IN (u INTER s) ==> (f:real^N->real) x = &0")
        ASSUME_TAC THENL
         [ASM_MESON_TAC [SUM_POS_EQ_0, FINITE_INTER, IN_INTER],
          ASM_SIMP_TAC [VECTOR_MUL_LZERO, VSUM_0] THEN
          REWRITE_TAC [VECTOR_ADD_LID, REAL_ADD_LID] THEN
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
          REWRITE_TAC [IN_UNION] THEN DISJ2_TAC THEN DISJ1_TAC THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONVEX_EXPLICIT]) THEN
          ASM_SIMP_TAC [FINITE_DIFF, IN_DIFF] THEN ASM SET_TAC []],
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"sum (u DIFF s) (f:real^N->real) = &0") THENL
       [SUBGOAL_THEN (← q r"!x. x IN (u DIFF s) ==> (f:real^N->real) x = &0")
        ASSUME_TAC THENL
         [ASM_MESON_TAC [SUM_POS_EQ_0, FINITE_DIFF, IN_DIFF],
          ASM_SIMP_TAC [VECTOR_MUL_LZERO, VSUM_0] THEN
          REWRITE_TAC [VECTOR_ADD_RID, REAL_ADD_RID] THEN
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
          REWRITE_TAC [IN_UNION] THEN DISJ1_TAC THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONVEX_EXPLICIT]) THEN
          ASM_SIMP_TAC [FINITE_INTER, IN_INTER] THEN ASM SET_TAC []],
        ALL_TAC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
      REWRITE_TAC [IN_UNION, IN_ELIM_THM] THEN DISJ2_TAC THEN DISJ2_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"vsum(u INTER s) (\v:real^N. (f v / sum(u INTER s) f) % v)",
        ← q r"sum(u DIFF s) (f:real^N->real)",
        ← q r"vsum(u DIFF s) (\v:real^N. (f v / sum(u DIFF s) f) % v)"] THEN
      REPEAT CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONVEX_EXPLICIT]) THEN
        ASM_SIMP_TAC [INTER_SUBSET, FINITE_INTER, SUM_POS_LE, REAL_LE_DIV,
                      IN_INTER, real_div, SUM_RMUL, REAL_MUL_RINV],
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONVEX_EXPLICIT]) THEN
        ASM_SIMP_TAC [SUBSET_DIFF, FINITE_DIFF, SUM_POS_LE, REAL_LE_DIV,
                      IN_DIFF, real_div, SUM_RMUL, REAL_MUL_RINV] THEN
        ASM SET_TAC [],
        ASM_SIMP_TAC [SUM_POS_LE, IN_DIFF, FINITE_DIFF],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"a + b = &1 ==> &0 <= a ==> b <= &1"))) THEN
        ASM_SIMP_TAC [SUM_POS_LE, IN_INTER, FINITE_INTER],
        ASM_SIMP_TAC [← GSYM VSUM_LMUL, FINITE_INTER, FINITE_DIFF] THEN
        SIMP_TAC [VECTOR_MUL_ASSOC, ← REAL_ARITH (← q r"a * b / c:real = a / c * b")] THEN
        FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← REAL_ARITH
         (← q r"a + b = &1 ==> &1 - b = a"))) THEN
        ASM_SIMP_TAC [REAL_DIV_REFL, REAL_MUL_LID]],
      REWRITE_TAC [← GSYM UNION_ASSOC] THEN ONCE_REWRITE_TAC [UNION_SUBSET] THEN
      REWRITE_TAC [HULL_SUBSET] THEN REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"u:real", ← q r"y:real^N"] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [CONVEX_ALT] CONVEX_CONVEX_HULL) THEN
      ASM_SIMP_TAC [HULL_INC, IN_UNION]])

  let CONVEX_HULL_UNION_NONEMPTY_EXPLICIT ← prove
   r"!s t:real^N->bool.
        convex s /\ ~(s = {}) /\ convex t /\ ~(t = {})
        ==> convex hull (s UNION t) =
             {(&1 - u) % x + u % y | x IN s /\ y IN t /\ &0 <= u /\ u <= &1}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [CONVEX_HULL_UNION_EXPLICIT] THEN
    SIMP_TAC [← SET_RULE (← q r"s UNION t UNION u = u <=> s SUBSET u /\ t SUBSET u")] THEN
    CONJ_TAC THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"z:real^N") THEN
    DISCH_TAC THENL
     [MAP_EVERY EXISTS_TAC [← q r"z:real^N", ← q r"&0"] THEN
      REWRITE_TAC [REAL_SUB_RZERO, VECTOR_MUL_LID, REAL_POS, VECTOR_MUL_LZERO,
                   VECTOR_ADD_RID] THEN
      ASM SET_TAC [],
      SUBGOAL_THEN (← q r"?a:real^N. a IN s") MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"&1", ← q r"z:real^N"] THEN
      ASM_REWRITE_TAC [REAL_POS, REAL_LE_REFL] THEN VECTOR_ARITH_TAC])

  let CONVEX_HULL_UNION_UNIONS ← prove
   r"!f s:real^N->bool.
        convex(UNIONS f) /\ ~(f = {})
        ==> convex hull (s UNION UNIONS f) =
            UNIONS {convex hull (s UNION t) | t IN f}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC HULL_MONO THEN ASM SET_TAC []] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_SIMP_TAC [UNION_EMPTY, HULL_P, UNIONS_SUBSET] THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"convex hull u:real^N->bool") THEN
      REWRITE_TAC [HULL_SUBSET] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"UNIONS f :real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [UNION_EMPTY] THEN
      SUBGOAL_THEN (← q r"?u:real^N->bool. u IN f") CHOOSE_TAC THENL
       [ASM_REWRITE_TAC [MEMBER_NOT_EMPTY], ALL_TAC] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"convex hull (s UNION u:real^N->bool)") THEN
      ASM_SIMP_TAC [HULL_MONO, SUBSET_UNION] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [HULL_UNION_LEFT] THEN
    ASM_SIMP_TAC [CONVEX_HULL_UNION_NONEMPTY_EXPLICIT, CONVEX_HULL_EQ_EMPTY,
                  CONVEX_CONVEX_HULL] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_UNIONS] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"u:real^N->bool"] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"y:real^N") THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [IN_UNIONS, EXISTS_IN_GSPEC] THEN
    EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [CONVEX_ALT] CONVEX_CONVEX_HULL) THEN
    ASM_MESON_TAC [HULL_MONO, IN_UNION, SUBSET, HULL_INC])

  let CONVEX_HULL_FINITE_STEP ← prove
   r"((?u. (!x. x IN {} ==> &0 <= u x) /\
         sum {} u = w /\
         vsum {} (\x. u(x) % x) = y) <=> w = &0 /\ y = vec 0) /\
   (FINITE(s:real^N->bool)
    ==> ((?u. (!x. x IN (a INSERT s) ==> &0 <= u x) /\
              sum (a INSERT s) u = w /\
              vsum (a INSERT s) (\x. u(x) % x) = y) <=>
         ?v. &0 <= v /\
             ?u. (!x. x IN s ==> &0 <= u x) /\
              sum s u = w - v /\
              vsum s (\x. u(x) % x) = y - v % a))"
   (MP_TAC (← ISPEC (← q r"\x:real^N y:real. &0 <= y") AFFINE_HULL_FINITE_STEP_GEN) THEN
    SIMP_TAC [← REAL_ARITH (← q r"&0 <= x / &2 <=> &0 <= x"), REAL_LE_ADD] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM])

  return { CONVEX_HULL_INDEXED, CONVEX_HULL_FINITE_IMAGE_EXPLICIT, CONVEX_HULL_EXPLICIT,
           CONVEX_HULL_FINITE, CONVEX_HULL_IMAGE, CONVEX_HULL_IMAGE_LT,
           CONVEX_HULL_UNION_EXPLICIT, CONVEX_HULL_UNION_NONEMPTY_EXPLICIT,
           CONVEX_HULL_UNION_UNIONS, CONVEX_HULL_FINITE_STEP }

/- ------------------------------------------------------------------------- -/
/- Hence some special cases.  (convex.ml 3417-3589)                          -/
/- ------------------------------------------------------------------------- -/

structure CVP where
  CONVEX_HULL_2 : thm
  CONVEX_HULL_2_ALT : thm
  CONVEX_HULL_3 : thm
  CONVEX_HULL_3_ALT : thm
  CONVEX_HULL_SUMS : thm
  AFFINE_HULL_SUMS : thm
  AFFINE_HULL_PCROSS : thm
  CONVEX_HULL_PCROSS : thm
  BILINEAR_IN_CONVEX_HULL : thm
  deriving Inhabited

@[nospecialize]
def setupCVP [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFX : AFX) (BCVX : CVX) (BCVS : CVS)
    (BCVA : CVA) (BCVH : CVH) (BCVE : CVE) : ExceptT String IO CVP := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH,
        VECTOR_ARITH_TAC, .. } := D
  let { CONJ_ASSOC, EXTENSION, FINITE_INSERT, FINITE_NUMSEG, FINITE_RULES,
        FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_PCROSS, IMP_CONJ, INTERS_GSPEC, .. } := D.core2
  let { IN_ELIM_THM, IN_NUMSEG, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, PASTECART_IN_PCROSS,
        PCROSS_MONO, REAL_ADD_ASSOC, REAL_ADD_RID, .. } := D.core3
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM, .. } := D.core5
  let { UNWIND_THM2, .. } := D.core6
  let { HULL_INC, HULL_INDUCT, HULL_MINIMAL, HULL_SUBSET, .. } := D.misc
  let { PASTECART_ADD, PASTECART_CMUL, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_RDISTRIB, VECTOR_ADD_RID, VECTOR_MUL_LID,
        VSUM_ADD_NUMSEG, VSUM_LMUL, VSUM_RMUL, bilinear, .. } := D.vec4
  let { affine, AFFINE_SUMS, AFFINE_INTERS, AFFINE_AFFINE_HULL, .. } := BAFF
  let { AFFINE_VSUM, AFFINE_HULL_INDEXED, .. } := BAFX
  let { convex, CONVEX_INTERS, .. } := BCVX
  let { CONVEX_VSUM, AFFINE_PCROSS, CONVEX_PCROSS, .. } := BCVS
  let { CONVEX_SUMS, CONVEX_LINEAR_PREIMAGE, .. } := BCVA
  let { CONVEX_CONVEX_HULL, .. } := BCVH
  let { CONVEX_HULL_INDEXED, CONVEX_HULL_FINITE, CONVEX_HULL_FINITE_STEP, .. } := BCVE
  -- @@SCOPE END

  let CONVEX_HULL_2 ← prove
   r"!a b. convex hull {a,b} =
         {u % a + v % b | &0 <= u /\ &0 <= v /\ u + v = &1}"
   (SIMP_TAC [CONVEX_HULL_FINITE, FINITE_INSERT, FINITE_RULES] THEN
    SIMP_TAC [CONVEX_HULL_FINITE_STEP, FINITE_INSERT, FINITE_RULES] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x - y = z:real <=> x = y + z"),
                 ← VECTOR_ARITH (← q r"x - y = z:real^N <=> x = y + z")] THEN
    REWRITE_TAC [VECTOR_ADD_RID, REAL_ADD_RID] THEN SET_TAC [])

  let CONVEX_HULL_2_ALT ← prove
   r"!a b. convex hull {a,b} = {a + u % (b - a) | &0 <= u /\ u <= &1}"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b} = {b,a}")] THEN
    REWRITE_TAC [CONVEX_HULL_2, EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [REAL_ADD_ASSOC, CONJ_ASSOC] THEN
    REWRITE_TAC [← TAUT (← q r"(a /\ x + y = &1) /\ b <=> x + y = &1 /\ a /\ b")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x + y = &1 <=> y = &1 - x"), UNWIND_THM2] THEN
    REPEAT GEN_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
    BINOP_TAC THENL [REAL_ARITH_TAC, VECTOR_ARITH_TAC])

  let CONVEX_HULL_3 ← prove
   r"convex hull {a,b,c} =
    { u % a + v % b + w % c |
      &0 <= u /\ &0 <= v /\ &0 <= w /\ u + v + w = &1}"
   (SIMP_TAC [CONVEX_HULL_FINITE, FINITE_INSERT, FINITE_RULES] THEN
    SIMP_TAC [CONVEX_HULL_FINITE_STEP, FINITE_INSERT, FINITE_RULES] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x - y = z:real <=> x = y + z"),
                 ← VECTOR_ARITH (← q r"x - y = z:real^N <=> x = y + z")] THEN
    REWRITE_TAC [VECTOR_ADD_RID, REAL_ADD_RID] THEN SET_TAC [])

  let CONVEX_HULL_3_ALT ← prove
   r"!a b c. convex hull {a,b,c} =
                {a + u % (b - a) + v % (c - a) |
                   &0 <= u /\ &0 <= v /\ u + v <= &1}"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b,c} = {b,c,a}")] THEN
    REWRITE_TAC [CONVEX_HULL_3, EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [REAL_ADD_ASSOC, CONJ_ASSOC] THEN
    REWRITE_TAC [← TAUT (← q r"(a /\ x + y = &1) /\ b <=> x + y = &1 /\ a /\ b")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x + y = &1 <=> y = &1 - x"), UNWIND_THM2] THEN
    REPEAT GEN_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
    BINOP_TAC THENL [REAL_ARITH_TAC, VECTOR_ARITH_TAC])

  let CONVEX_HULL_SUMS ← prove
   r"!s t:real^N->bool.
        convex hull {x + y | x IN s /\ y IN t} =
        {x + y | x IN convex hull s /\ y IN convex hull t}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC HULL_MINIMAL THEN
      SIMP_TAC [CONVEX_SUMS, CONVEX_CONVEX_HULL] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [HULL_INC],
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [CONVEX_HULL_INDEXED] THEN
      REWRITE_TAC [IN_ELIM_THM, LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"k1:num", ← q r"u1:num->real", ← q r"x1:num->real^N",
        ← q r"k2:num", ← q r"u2:num->real", ← q r"x2:num->real^N"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"x + y:real^N =
        vsum(1..k1) (\i. vsum(1..k2) (\j. u1 i % u2 j % (x1 i + x2 j)))")
      SUBST1_TAC THENL
       [REWRITE_TAC [VECTOR_ADD_LDISTRIB, VSUM_ADD_NUMSEG] THEN
        ASM_SIMP_TAC [VSUM_LMUL, VSUM_RMUL, VECTOR_MUL_LID],
        REWRITE_TAC [VSUM_LMUL] THEN MATCH_MP_TAC CONVEX_VSUM THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, CONVEX_CONVEX_HULL, IN_NUMSEG] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC CONVEX_VSUM THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, CONVEX_CONVEX_HULL, IN_NUMSEG] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC HULL_INC THEN ASM SET_TAC []]])

  let AFFINE_HULL_SUMS ← prove
   r"!s t:real^N->bool.
        affine hull {x + y | x IN s /\ y IN t} =
        {x + y | x IN affine hull s /\ y IN affine hull t}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC HULL_MINIMAL THEN
      SIMP_TAC [AFFINE_SUMS, AFFINE_AFFINE_HULL] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [HULL_INC],
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [AFFINE_HULL_INDEXED] THEN
      REWRITE_TAC [IN_ELIM_THM, LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"k1:num", ← q r"u1:num->real", ← q r"x1:num->real^N",
        ← q r"k2:num", ← q r"u2:num->real", ← q r"x2:num->real^N"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"x + y:real^N =
        vsum(1..k1) (\i. vsum(1..k2) (\j. u1 i % u2 j % (x1 i + x2 j)))")
      SUBST1_TAC THENL
       [REWRITE_TAC [VECTOR_ADD_LDISTRIB, VSUM_ADD_NUMSEG] THEN
        ASM_SIMP_TAC [VSUM_LMUL, VSUM_RMUL, VECTOR_MUL_LID],
        REWRITE_TAC [VSUM_LMUL] THEN MATCH_MP_TAC AFFINE_VSUM THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, AFFINE_AFFINE_HULL, IN_NUMSEG] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC AFFINE_VSUM THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, AFFINE_AFFINE_HULL, IN_NUMSEG] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC HULL_INC THEN ASM SET_TAC []]])

  let (AFFINE_HULL_PCROSS, CONVEX_HULL_PCROSS) ← do
    let lemma1 ← prove
     r"!u v x y:real^M z:real^N.
         u + v = &1
            ==> pastecart z (u % x + v % y) =
                u % pastecart z x + v % pastecart z y /\
                pastecart (u % x + v % y) z =
                u % pastecart x z + v % pastecart y z"
     (REWRITE_TAC [PASTECART_ADD, ← GSYM PASTECART_CMUL] THEN
      SIMP_TAC [← GSYM VECTOR_ADD_RDISTRIB, VECTOR_MUL_LID])
    let lemma2 ← prove
     r"INTERS {{x | pastecart x y IN u} | y IN t} =
       {x | !y. y IN t ==> pastecart x y IN u}"
     (REWRITE_TAC [INTERS_GSPEC, EXTENSION, IN_ELIM_THM] THEN SET_TAC [])
    CONJ_PAIR (← prove
     r"(!s:real^M->bool t:real^N->bool.
          affine hull (s PCROSS t) =
          (affine hull s) PCROSS (affine hull t)) /\
     (!s:real^M->bool t:real^N->bool.
          convex hull (s PCROSS t) =
          (convex hull s) PCROSS (convex hull t))"
     (CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
         [MATCH_MP_TAC HULL_MINIMAL THEN
          SIMP_TAC [AFFINE_PCROSS, AFFINE_AFFINE_HULL, HULL_SUBSET, PCROSS_MONO],
          REWRITE_TAC [SUBSET, FORALL_IN_PCROSS] THEN
          REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
          MATCH_MP_TAC HULL_INDUCT THEN CONJ_TAC THENL
           [X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
            MATCH_MP_TAC HULL_INDUCT THEN CONJ_TAC THENL
             [X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
              SUBGOAL_THEN (← q r"pastecart (x:real^M) (y:real^N) IN s PCROSS t") MP_TAC
              THENL [ASM_REWRITE_TAC [PASTECART_IN_PCROSS], ALL_TAC] THEN
              REWRITE_TAC [HULL_INC],
              ALL_TAC],
            REWRITE_TAC [← GSYM lemma2] THEN MATCH_MP_TAC AFFINE_INTERS THEN
            REWRITE_TAC [FORALL_IN_GSPEC]] THEN
          SIMP_TAC [affine, IN_ELIM_THM, lemma1,
                    ← ONCE_REWRITE_RULE [affine] AFFINE_AFFINE_HULL]],
        REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
         [MATCH_MP_TAC HULL_MINIMAL THEN
          SIMP_TAC [CONVEX_PCROSS, CONVEX_CONVEX_HULL, HULL_SUBSET, PCROSS_MONO],
          REWRITE_TAC [SUBSET, FORALL_IN_PCROSS] THEN
          REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
          MATCH_MP_TAC HULL_INDUCT THEN CONJ_TAC THENL
           [X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
            MATCH_MP_TAC HULL_INDUCT THEN CONJ_TAC THENL
             [X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
              SUBGOAL_THEN (← q r"pastecart (x:real^M) (y:real^N) IN s PCROSS t") MP_TAC
              THENL [ASM_REWRITE_TAC [PASTECART_IN_PCROSS], ALL_TAC] THEN
              REWRITE_TAC [HULL_INC],
              ALL_TAC],
            REWRITE_TAC [← GSYM lemma2] THEN MATCH_MP_TAC CONVEX_INTERS THEN
            REWRITE_TAC [FORALL_IN_GSPEC]] THEN
          SIMP_TAC [convex, IN_ELIM_THM, lemma1,
                    ← ONCE_REWRITE_RULE [convex] CONVEX_CONVEX_HULL]]]))

  let BILINEAR_IN_CONVEX_HULL ← prove
   r"!(f:real^M->real^N->real^P) s t x y.
        bilinear f /\ x IN convex hull s /\ y IN convex hull t
        ==> f x y IN convex hull { f a b | a IN s /\ b IN t}"
   (REWRITE_TAC [bilinear, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    GEN_TAC THEN REPEAT DISCH_TAC THEN GEN_TAC THEN GEN_TAC THEN
    MATCH_MP_TAC HULL_INDUCT THEN CONJ_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC HULL_INDUCT THEN
      ASM_SIMP_TAC [CONVEX_LINEAR_PREIMAGE, CONVEX_CONVEX_HULL] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC HULL_INC THEN ASM SET_TAC [],
      REWRITE_TAC [← SET_RULE
       (← q r"{x | !y. y IN k ==> P x y} = INTERS {{x | P x y} | y IN k}")] THEN
      MATCH_MP_TAC CONVEX_INTERS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ASM_SIMP_TAC [CONVEX_LINEAR_PREIMAGE, CONVEX_CONVEX_HULL]])

  return { CONVEX_HULL_2, CONVEX_HULL_2_ALT, CONVEX_HULL_3, CONVEX_HULL_3_ALT,
           CONVEX_HULL_SUMS, AFFINE_HULL_SUMS, AFFINE_HULL_PCROSS, CONVEX_HULL_PCROSS,
           BILINEAR_IN_CONVEX_HULL }

/- ------------------------------------------------------------------------- -/
/- Relations among closure notions and corresponding hulls.                  -/
/- (convex.ml 3593-3923)                                                     -/
/- ------------------------------------------------------------------------- -/

structure CLH where
  SUBSPACE_IMP_AFFINE : thm
  AFFINE_IMP_CONVEX : thm
  SUBSPACE_IMP_CONVEX : thm
  AFFINE_HULL_SUBSET_SPAN : thm
  CONVEX_HULL_SUBSET_SPAN : thm
  CONVEX_HULL_SUBSET_AFFINE_HULL : thm
  COLLINEAR_CONVEX_HULL_COLLINEAR : thm
  AFFINE_SPAN : thm
  CONVEX_SPAN : thm
  SEGMENT_SUBSET_LINE : thm
  SPAN_CONVEX_HULL : thm
  DIM_CONVEX_HULL : thm
  AFFINE_EQ_SUBSPACE : thm
  AFFINE_IMP_SUBSPACE : thm
  SUBSPACE_EQ_AFFINE : thm
  AFFINE_HULL_EQ_SPAN : thm
  SPAN_AFFINE_HULL_INSERT : thm
  CLOSED_AFFINE : thm
  CLOSED_AFFINE_HULL : thm
  CLOSURE_SUBSET_AFFINE_HULL : thm
  AFFINE_HULL_CLOSURE : thm
  AFFINE_HULL_EQ_SPAN_EQ : thm
  AFFINE_DEPENDENT_IMP_DEPENDENT : thm
  DEPENDENT_AFFINE_DEPENDENT_CASES : thm
  DEPENDENT_IMP_AFFINE_DEPENDENT : thm
  AFFINE_DEPENDENT_BIGGERSET : thm
  AFFINE_DEPENDENT_BIGGERSET_GENERAL : thm
  AFFINE_INDEPENDENT_IMP_FINITE : thm
  AFFINE_INDEPENDENT_CARD_LE : thm
  AFFINE_INDEPENDENT_CONVEX_AFFINE_HULL : thm
  DISJOINT_AFFINE_HULL : thm
  deriving Inhabited

@[nospecialize]
def setupCLH [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFX : AFX) (BCVX : CVX) (BAFD : AFD)
    (BCOP : COP) (BCVE : CVE) : ExceptT String IO CLH := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D
  let { ARITH_EQ, CARD_CLAUSES, CARD_IMAGE_INJ, CONJ_ASSOC, CONTRAPOS_THM, DIFF, EMPTY_GSPEC,
        EQ_IMP, EXISTS_IN_IMAGE, FINITE_DELETE, FINITE_IMAGE_INJ_EQ, FINITE_INSERT,
        FINITE_RULES, FINITE_SUBSET, FINITE_SUBSET_IMAGE, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, GE, IN, IN_DELETE, IN_DISJOINT, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, LEFT_AND_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM, OR_EXISTS_THM, .. } := D.core3
  let { REAL_MUL_LINV, REAL_OF_NUM_EQ, REAL_SUB_0, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM,
        SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_TRANS, .. } := D.core5
  let { SUM_0, SUM_CASES, SUM_CLAUSES, SUM_DIFF, SUM_EQ, SUM_EQ_0, SUM_LMUL, SUM_NEG, SUM_SUB,
        SWAP_EXISTS_THM, UNWIND_THM2, o_DEF, .. } := D.core6
  let { HULL_ANTIMONO, HULL_INC, HULL_MINIMAL, HULL_MONO, HULL_SUBSET, HULL_UNIQUE, .. } :=
    D.misc
  let { COLLINEAR_SUBSET, DEPENDENT_BIGGERSET, DEPENDENT_BIGGERSET_GENERAL, DEPENDENT_EXPLICIT,
        DIM_SPAN, .. } := D.vec1
  let { SPAN_0, SPAN_INC, SPAN_INDUCT, SPAN_INSERT_0, SPAN_MONO, SPAN_SUB,
        SPAN_SUBSET_SUBSPACE, SPAN_SUPERSET, SUBSET_LE_DIM, SUBSPACE_0, SUBSPACE_SPAN, .. } :=
    D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LNEG, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO,
        VECTOR_SUB_LDISTRIB, VECTOR_SUB_RDISTRIB, VSUM_0, VSUM_CASES, VSUM_CLAUSES, VSUM_DIFF,
        VSUM_EQ, VSUM_IMAGE, VSUM_LMUL, VSUM_NEG, VSUM_RMUL, VSUM_SUB, dependent, span,
        subspace, .. } := D.vec4
  let { CLOSED_EMPTY, CLOSED_SUBSPACE, CLOSED_TRANSLATION_EQ, .. } := D.top1
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, .. } := D.top2
  let { open_segment, .. } := D.top5
  let { affine, AFFINE_TRANSLATION_EQ, AFFINE_AFFINE_HULL, .. } := BAFF
  let { AFFINE_HULL_EXPLICIT_ALT, AFFINE_HULL_FINITE, .. } := BAFX
  let { convex, CONVEX_CONTAINS_SEGMENT_IMP, .. } := BCVX
  let { affine_dependent, AFFINE_DEPENDENT_EXPLICIT, .. } := BAFD
  let { COLLINEAR_AFFINE_HULL_COLLINEAR, .. } := BCOP
  let { CONVEX_HULL_FINITE, .. } := BCVE
  -- @@SCOPE END

  let SUBSPACE_IMP_AFFINE ← prove
   r"!s. subspace s ==> affine s"
   (REWRITE_TAC [subspace, affine] THEN MESON_TAC [])

  let AFFINE_IMP_CONVEX ← prove
   r"!s. affine s ==> convex s"
   (REWRITE_TAC [affine, convex] THEN MESON_TAC [])

  let SUBSPACE_IMP_CONVEX ← prove
   r"!s. subspace s ==> convex s"
   (MESON_TAC [SUBSPACE_IMP_AFFINE, AFFINE_IMP_CONVEX])

  let AFFINE_HULL_SUBSET_SPAN ← prove
   r"!s. (affine hull s) SUBSET (span s)"
   (GEN_TAC THEN REWRITE_TAC [span] THEN MATCH_MP_TAC HULL_ANTIMONO THEN
    REWRITE_TAC [SUBSET, IN, SUBSPACE_IMP_AFFINE])

  let CONVEX_HULL_SUBSET_SPAN ← prove
   r"!s. (convex hull s) SUBSET (span s)"
   (GEN_TAC THEN REWRITE_TAC [span] THEN MATCH_MP_TAC HULL_ANTIMONO THEN
    REWRITE_TAC [SUBSET, IN, SUBSPACE_IMP_CONVEX])

  let CONVEX_HULL_SUBSET_AFFINE_HULL ← prove
   r"!s. (convex hull s) SUBSET (affine hull s)"
   (GEN_TAC THEN REWRITE_TAC [span] THEN MATCH_MP_TAC HULL_ANTIMONO THEN
    REWRITE_TAC [SUBSET, IN, AFFINE_IMP_CONVEX])

  let COLLINEAR_CONVEX_HULL_COLLINEAR ← prove
   r"!s:real^N->bool. collinear(convex hull s) <=> collinear s"
   (MESON_TAC [COLLINEAR_SUBSET, HULL_SUBSET, SUBSET_TRANS,
               COLLINEAR_AFFINE_HULL_COLLINEAR, CONVEX_HULL_SUBSET_AFFINE_HULL])

  let AFFINE_SPAN ← prove
   r"!s. affine(span s)"
   (SIMP_TAC [SUBSPACE_IMP_AFFINE, SUBSPACE_SPAN])

  let CONVEX_SPAN ← prove
   r"!s. convex(span s)"
   (SIMP_TAC [SUBSPACE_IMP_CONVEX, SUBSPACE_SPAN])

  let SEGMENT_SUBSET_LINE ← prove
   r"(!a b:real^N. segment[a,b] SUBSET affine hull {a,b}) /\
   (!a b:real^N. segment(a,b) SUBSET affine hull {a,b})"
   (REWRITE_TAC [open_segment] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN
    CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    SIMP_TAC [CONVEX_CONTAINS_SEGMENT_IMP, AFFINE_AFFINE_HULL, AFFINE_IMP_CONVEX,
              HULL_INC, IN_INSERT])

  let SPAN_CONVEX_HULL ← prove
   r"!s:real^N->bool. span(convex hull s) = span s"
   (GEN_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    SIMP_TAC [SPAN_MONO, HULL_SUBSET] THEN
    MATCH_MP_TAC SPAN_SUBSET_SUBSPACE THEN REWRITE_TAC [SUBSPACE_SPAN] THEN
    MATCH_MP_TAC HULL_MINIMAL THEN
    REWRITE_TAC [SPAN_INC, CONVEX_SPAN])

  let DIM_CONVEX_HULL ← prove
   r"!s:real^N->bool. dim(convex hull s) = dim s"
   (MESON_TAC [SPAN_CONVEX_HULL, DIM_SPAN])

  let AFFINE_EQ_SUBSPACE ← prove
   r"!s:real^N->bool. vec 0 IN s ==> (affine s <=> subspace s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [subspace, affine] THEN
    DISCH_TAC THEN MATCH_MP_TAC (← TAUT (← q r"b /\ (b ==> a) ==> a /\ b")) THEN
    CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^N"] THEN STRIP_TAC THEN
      SUBST1_TAC (← VECTOR_ARITH (← q r"c % x:real^N = c % x + (&1 - c) % vec 0")) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
      DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
      STRIP_TAC THEN SUBST1_TAC (← VECTOR_ARITH
       (← q r"x + y:real^N = &2 % (&1 / &2 % x + &1 / &2 % y)")) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC])

  let AFFINE_IMP_SUBSPACE ← prove
   r"!s. affine s /\ vec 0 IN s ==> subspace s"
   (SIMP_TAC [← GSYM AFFINE_EQ_SUBSPACE])

  let SUBSPACE_EQ_AFFINE ← prove
   r"!s:real^N->bool. subspace s <=> affine s /\ vec 0 IN s"
   (MESON_TAC [AFFINE_IMP_SUBSPACE, SUBSPACE_IMP_AFFINE, SUBSPACE_0])

  let AFFINE_HULL_EQ_SPAN ← prove
   r"!s:real^N->bool. (vec 0) IN affine hull s ==> affine hull s = span s"
   (GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [AFFINE_HULL_SUBSET_SPAN] THEN
    REWRITE_TAC [SUBSET] THEN MATCH_MP_TAC SPAN_INDUCT THEN
    ASM_REWRITE_TAC [SUBSET, subspace, IN_ELIM_THM, HULL_INC] THEN
    REPEAT STRIP_TAC THENL
     [SUBST1_TAC (← VECTOR_ARITH
       (← q r"x + y:real^N = &2 % (&1 / &2 % x + &1 / &2 % y) + --(&1) % vec 0")) THEN
      MATCH_MP_TAC (← REWRITE_RULE [affine] AFFINE_AFFINE_HULL) THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [affine] AFFINE_AFFINE_HULL) THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [],
      SUBST1_TAC (← VECTOR_ARITH
       (← q r"c % x:real^N = c % x + (&1 - c) % vec 0")) THEN
      MATCH_MP_TAC (← REWRITE_RULE [affine] AFFINE_AFFINE_HULL) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC])

  let SPAN_AFFINE_HULL_INSERT ← prove
   r"!s:real^N->bool. span s = affine hull (vec 0 INSERT s)"
   (SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC, IN_INSERT, SPAN_INSERT_0])

  let CLOSED_AFFINE ← prove
   r"!s:real^N->bool. affine s ==> closed s"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [CLOSED_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
    SUBGOAL_THEN (← q r"affine (IMAGE (\x:real^N. --a + x) s)
                  ==> closed (IMAGE (\x:real^N. --a + x) s)")
    MP_TAC THENL
     [DISCH_THEN (fun th => MATCH_MP_TAC CLOSED_SUBSPACE THEN MP_TAC th) THEN
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC AFFINE_EQ_SUBSPACE THEN
      REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"a:real^N") THEN
      ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC,
      REWRITE_TAC [AFFINE_TRANSLATION_EQ, CLOSED_TRANSLATION_EQ]])

  let CLOSED_AFFINE_HULL ← prove
   r"!s. closed(affine hull s)"
   (SIMP_TAC [CLOSED_AFFINE, AFFINE_AFFINE_HULL])

  let CLOSURE_SUBSET_AFFINE_HULL ← prove
   r"!s. closure s SUBSET affine hull s"
   (GEN_TAC THEN MATCH_MP_TAC CLOSURE_MINIMAL THEN
    REWRITE_TAC [CLOSED_AFFINE_HULL, HULL_SUBSET])

  let AFFINE_HULL_CLOSURE ← prove
   r"!s:real^N->bool. affine hull (closure s) = affine hull s"
   (GEN_TAC THEN MATCH_MP_TAC HULL_UNIQUE THEN
    REWRITE_TAC [CLOSURE_SUBSET_AFFINE_HULL, AFFINE_AFFINE_HULL] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
    MATCH_MP_TAC HULL_MINIMAL THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [CLOSURE_SUBSET, SUBSET])

  let AFFINE_HULL_EQ_SPAN_EQ ← prove
   r"!s:real^N->bool. (affine hull s = span s) <=> (vec 0) IN affine hull s"
   (GEN_TAC THEN EQ_TAC THEN SIMP_TAC [SPAN_0, AFFINE_HULL_EQ_SPAN])

  let AFFINE_DEPENDENT_IMP_DEPENDENT ← prove
   r"!s. affine_dependent s ==> dependent s"
   (REWRITE_TAC [affine_dependent, dependent] THEN
    MESON_TAC [SUBSET, AFFINE_HULL_SUBSET_SPAN])

  let DEPENDENT_AFFINE_DEPENDENT_CASES ← prove
   r"!s:real^N->bool.
        dependent s <=> affine_dependent s \/ (vec 0) IN affine hull s"
   (REWRITE_TAC [DEPENDENT_EXPLICIT, AFFINE_DEPENDENT_EXPLICIT,
                 AFFINE_HULL_EXPLICIT_ALT, IN_ELIM_THM] THEN
    GEN_TAC THEN ONCE_REWRITE_TAC [OR_EXISTS_THM] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN
    ASM_CASES_TAC (← q r"FINITE(t:real^N->bool)") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN DISCH_THEN (REPEAT_TCL DISJ_CASES_THEN
     (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC))
    THENL
     [ASM_CASES_TAC (← q r"sum t (u:real^N->real) = &0") THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      DISJ2_TAC THEN EXISTS_TAC (← q r"\v:real^N. inv(sum t u) * u v") THEN
      ASM_SIMP_TAC [SUM_LMUL, VSUM_LMUL, ← GSYM VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [VECTOR_MUL_RZERO, REAL_MUL_LINV],
      EXISTS_TAC (← q r"u:real^N->real") THEN ASM_MESON_TAC [],
      EXISTS_TAC (← q r"u:real^N->real") THEN
      ASM_REWRITE_TAC [← SET_RULE
       (← q r"(?v. v IN t /\ ~p v) <=> ~(!v. v IN t ==> p v)")] THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x = &1 ==> x = &0 ==> F"))) THEN
      ASM_MESON_TAC [SUM_EQ_0]])

  let DEPENDENT_IMP_AFFINE_DEPENDENT ← prove
   r"!a:real^N s. dependent {x - a | x IN s} /\ ~(a IN s)
                ==> affine_dependent(a INSERT s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [DEPENDENT_EXPLICIT, AFFINE_DEPENDENT_EXPLICIT] THEN
    REWRITE_TAC [SIMPLE_IMAGE, CONJ_ASSOC, FINITE_SUBSET_IMAGE] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [SWAP_EXISTS_THM] THEN
    REWRITE_TAC [← TAUT (← q r"a /\ x = IMAGE f s /\ b <=> x = IMAGE f s /\ a /\ b")] THEN
    REWRITE_TAC [UNWIND_THM2, EXISTS_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->real") (X_CHOOSE_THEN (← q r"t:real^N->bool")
      STRIP_ASSUME_TAC)) THEN
    FIRST_X_ASSUM (MP_TAC o check (is_eq o concl)) THEN
    ASM_SIMP_TAC [VSUM_IMAGE, ← VECTOR_ARITH (← q r"x - a:real^N = y - a <=> x = y")] THEN
    ASM_SIMP_TAC [o_DEF, VECTOR_SUB_LDISTRIB, VSUM_SUB, VSUM_RMUL] THEN
    STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(a:real^N) INSERT t",
      ← q r"\x. if x = a then --sum t (\x. u (x - a))
           else (u:real^N->real) (x - a)"] THEN
    ASM_REWRITE_TAC [FINITE_INSERT, SUBSET_REFL] THEN
    ASM_SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL [ASM SET_TAC [], ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> --x + y = &0")) THEN
      MATCH_MP_TAC SUM_EQ THEN ASM_MESON_TAC [],
      EXISTS_TAC (← q r"x:real^N") THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
      MATCH_MP_TAC (← VECTOR_ARITH
       (← q r"!s. s - t % a = vec 0 /\ s = u ==> --t % a + u = vec 0")) THEN
      EXISTS_TAC (← q r"vsum t (\x:real^N. u(x - a) % x)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC VSUM_EQ THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC []])

  let AFFINE_DEPENDENT_BIGGERSET ← prove
   r"!s:real^N->bool.
        (FINITE s ==> CARD s >= dimindex(:N) + 2) ==> affine_dependent s"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_SIMP_TAC [CARD_CLAUSES, ← ARITH_RULE (← q r"~(0 >= n + 2)"), FINITE_RULES] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← SET_RULE
     (← q r"x IN s ==> s = x INSERT (s DELETE x)"))) THEN
    SIMP_TAC [FINITE_INSERT, CARD_CLAUSES, IN_DELETE] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"SUC x >= n + 2 <=> x > n")] THEN DISCH_TAC THEN
    MATCH_MP_TAC DEPENDENT_IMP_AFFINE_DEPENDENT THEN
    REWRITE_TAC [IN_DELETE] THEN MATCH_MP_TAC DEPENDENT_BIGGERSET THEN
    REWRITE_TAC [← SET_RULE (← q r"{x - a:real^N | x | x IN s /\ ~(x = a)} =
                          IMAGE (\x. x - a) (s DELETE a)")] THEN
    ASM_SIMP_TAC [FINITE_IMAGE_INJ_EQ,
                  ← VECTOR_ARITH (← q r"x - a = y - a <=> x:real^N = y"),
                  CARD_IMAGE_INJ])

  let AFFINE_DEPENDENT_BIGGERSET_GENERAL ← prove
   r"!s:real^N->bool. (FINITE s ==> CARD s >= dim s + 2) ==> affine_dependent s"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_SIMP_TAC [CARD_CLAUSES, ← ARITH_RULE (← q r"~(0 >= n + 2)"), FINITE_RULES] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← SET_RULE
     (← q r"x IN s ==> s = x INSERT (s DELETE x)"))) THEN
    SIMP_TAC [FINITE_INSERT, CARD_CLAUSES, IN_DELETE] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"SUC x >= n + 2 <=> x > n")] THEN DISCH_TAC THEN
    MATCH_MP_TAC DEPENDENT_IMP_AFFINE_DEPENDENT THEN
    REWRITE_TAC [IN_DELETE] THEN
    MATCH_MP_TAC DEPENDENT_BIGGERSET_GENERAL THEN
    REWRITE_TAC [← SET_RULE (← q r"{x - a:real^N | x | x IN s /\ ~(x = a)} =
                          IMAGE (\x. x - a) (s DELETE a)")] THEN
    ASM_SIMP_TAC [FINITE_IMAGE_INJ_EQ, FINITE_DELETE,
                  ← VECTOR_ARITH (← q r"x - a = y - a <=> x:real^N = y"),
                  CARD_IMAGE_INJ] THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_imp o concl)) THEN
    ASM_REWRITE_TAC [FINITE_DELETE] THEN
    MATCH_MP_TAC (← ARITH_RULE (← q r"c:num <= b ==> (a > b ==> a > c)")) THEN
    MATCH_MP_TAC SUBSET_LE_DIM THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    SIMP_TAC [SPAN_SUB, SPAN_SUPERSET, IN_INSERT])

  let AFFINE_INDEPENDENT_IMP_FINITE ← prove
   r"!s:real^N->bool. ~(affine_dependent s) ==> FINITE s"
   (MESON_TAC [AFFINE_DEPENDENT_BIGGERSET])

  let AFFINE_INDEPENDENT_CARD_LE ← prove
   r"!s:real^N->bool. ~(affine_dependent s) ==> CARD s <= dimindex(:N) + 1"
   (REWRITE_TAC [← ARITH_RULE (← q r"s <= n + 1 <=> ~(n + 2 <= s)"), CONTRAPOS_THM] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC AFFINE_DEPENDENT_BIGGERSET THEN
    ASM_REWRITE_TAC [GE])

  let AFFINE_INDEPENDENT_CONVEX_AFFINE_HULL ← prove
   r"!s t:real^N->bool.
        ~affine_dependent s /\ t SUBSET s
        ==> convex hull t = affine hull t INTER convex hull s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    SUBGOAL_THEN (← q r"FINITE(t:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"ct SUBSET a /\ ct SUBSET cs /\ a INTER cs SUBSET ct
      ==> ct = a INTER cs")) THEN
    ASM_SIMP_TAC [HULL_MONO, CONVEX_HULL_SUBSET_AFFINE_HULL] THEN
    REWRITE_TAC [SUBSET, IN_INTER, CONVEX_HULL_FINITE, AFFINE_HULL_FINITE] THEN
    X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"v:real^N->real") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"u:real^N->real") THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
      [AFFINE_DEPENDENT_EXPLICIT]) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"s:real^N->bool",
          ← q r"\x:real^N. if x IN t then v x - u x:real else v x"]) THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN REWRITE_TAC [← MESON []
     (← q r"(if p then a else b) % x = if p then a % x else b % x")] THEN
    ASM_SIMP_TAC [VSUM_CASES, SUM_CASES, ← SET_RULE
     (← q r"t SUBSET s ==> {x | x IN s /\ x IN t} = t")] THEN
    ASM_SIMP_TAC [← GSYM DIFF, SUM_DIFF, VSUM_DIFF, VECTOR_SUB_RDISTRIB,
                  SUM_SUB, VSUM_SUB] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a - b + b - a = &0"), NOT_EXISTS_THM,
                 ← VECTOR_ARITH (← q r"a - b + b - a:real^N = vec 0")] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
    ASM_REWRITE_TAC [REAL_SUB_0] THEN ASM SET_TAC [])

  let DISJOINT_AFFINE_HULL ← prove
   r"!s t u:real^N->bool.
        ~affine_dependent s /\ t SUBSET s /\ u SUBSET s /\ DISJOINT t u
        ==> DISJOINT (affine hull t) (affine hull u)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    SUBGOAL_THEN (← q r"FINITE(t:real^N->bool) /\ FINITE (u:real^N->bool)") ASSUME_TAC
    THENL [ASM_MESON_TAC [FINITE_SUBSET], ALL_TAC] THEN
    REWRITE_TAC [IN_DISJOINT, AFFINE_HULL_FINITE, IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"a:real^N->real") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"b:real^N->real") STRIP_ASSUME_TAC)) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
      [AFFINE_DEPENDENT_EXPLICIT]) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"s:real^N->bool",
      ← q r"\x:real^N. if x IN t then a x else if x IN u then --(b x) else &0"] THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN REWRITE_TAC [← MESON []
     (← q r"(if p then a else b) % x = if p then a % x else b % x")] THEN
    ASM_SIMP_TAC [SUM_CASES, SUBSET_REFL, VSUM_CASES, ← GSYM DIFF, SUM_DIFF,
        VSUM_DIFF, ← SET_RULE (← q r"t SUBSET s ==> {x | x IN s /\ x IN t} = t")] THEN
    ASM_SIMP_TAC [SUM_0, VSUM_0, VECTOR_MUL_LZERO, SUM_NEG, VSUM_NEG,
      VECTOR_MUL_LNEG, ← SET_RULE (← q r"DISJOINT t u ==> ~(x IN t /\ x IN u)")] THEN
    REWRITE_TAC [EMPTY_GSPEC, SUM_CLAUSES, VSUM_CLAUSES] THEN
    CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
    CONJ_TAC THENL [ALL_TAC, VECTOR_ARITH_TAC] THEN
    UNDISCH_TAC (← q r"sum t (a:real^N->real) = &1") THEN
    ASM_CASES_TAC (← q r"!x:real^N. x IN t ==> a x = &0") THEN
    ASM_SIMP_TAC [SUM_EQ_0, REAL_OF_NUM_EQ, ARITH_EQ] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  return { SUBSPACE_IMP_AFFINE, AFFINE_IMP_CONVEX, SUBSPACE_IMP_CONVEX, AFFINE_HULL_SUBSET_SPAN,
           CONVEX_HULL_SUBSET_SPAN, CONVEX_HULL_SUBSET_AFFINE_HULL,
           COLLINEAR_CONVEX_HULL_COLLINEAR, AFFINE_SPAN, CONVEX_SPAN, SEGMENT_SUBSET_LINE,
           SPAN_CONVEX_HULL, DIM_CONVEX_HULL, AFFINE_EQ_SUBSPACE, AFFINE_IMP_SUBSPACE,
           SUBSPACE_EQ_AFFINE, AFFINE_HULL_EQ_SPAN, SPAN_AFFINE_HULL_INSERT, CLOSED_AFFINE,
           CLOSED_AFFINE_HULL, CLOSURE_SUBSET_AFFINE_HULL, AFFINE_HULL_CLOSURE,
           AFFINE_HULL_EQ_SPAN_EQ, AFFINE_DEPENDENT_IMP_DEPENDENT,
           DEPENDENT_AFFINE_DEPENDENT_CASES, DEPENDENT_IMP_AFFINE_DEPENDENT,
           AFFINE_DEPENDENT_BIGGERSET, AFFINE_DEPENDENT_BIGGERSET_GENERAL,
           AFFINE_INDEPENDENT_IMP_FINITE, AFFINE_INDEPENDENT_CARD_LE,
           AFFINE_INDEPENDENT_CONVEX_AFFINE_HULL, DISJOINT_AFFINE_HULL }

/- ------------------------------------------------------------------------- -/
/- Affine independence, spans of conic hulls; nonempty affine sets are       -/
/- translates of (unique) subspaces.  (convex.ml 3924-4128)                  -/
/- ------------------------------------------------------------------------- -/

structure AFI where
  AFFINE_INDEPENDENT_SPAN_EQ : thm
  AFFINE_INDEPENDENT_SPAN_GT : thm
  EMPTY_INTERIOR_AFFINE_HULL : thm
  EMPTY_INTERIOR_CONVEX_HULL : thm
  AFFINE_DEPENDENT_CHOOSE : thm
  AFFINE_INDEPENDENT_INSERT : thm
  AFFINE_HULL_EXPLICIT_UNIQUE : thm
  INDEPENDENT_IMP_AFFINE_DEPENDENT_0 : thm
  AFFINE_INDEPENDENT_STDBASIS : thm
  SPAN_CONIC_HULL : thm
  CONIC_HULLS_EQ_IMP_SPANS_EQ : thm
  DIM_CONIC_HULL : thm
  CONIC_HULL_SUBSET_SPAN : thm
  CONIC_IMAGE_MULTIPLE_EQ : thm
  CONIC_IMAGE_MULTIPLE : thm
  AFFINE_TRANSLATION_SUBSPACE : thm
  AFFINE_TRANSLATION_UNIQUE_SUBSPACE : thm
  AFFINE_TRANSLATION_SUBSPACE_EXPLICIT : thm
  deriving Inhabited

@[nospecialize]
def setupAFI [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFX : AFX) (BAFS : AFS) (BCON : CON)
    (BAFD : AFD) (BCLH : CLH) : ExceptT String IO AFI := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE,
        VECTOR_ARITH, VECTOR_ARITH_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { CARD_CLAUSES, CONJ_SYM, CONTRAPOS_THM, DE_MORGAN_THM, EXISTS_IN_INSERT,
        FINITE_INDUCT_STRONG, FINITE_INSERT, .. } := D.core1
  let { FORALL_IN_IMAGE, HAS_SIZE, IMAGE_EQ_EMPTY, IMAGE_ID, IMAGE_o, IMP_CONJ, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, LET_TRANS, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_EXISTS_THM, REAL_ADD_LID, .. } := D.core3
  let { REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, .. } := D.core4
  let { REAL_MUL_LINV, REAL_SUB_0, REAL_SUB_REFL, SET_PROVE_CASES, SIMPLE_IMAGE, SUBSET,
        SUBSET_ANTISYM_EQ, .. } := D.core5
  let { SUBSET_UNIV, SUM_CLAUSES, SUM_LMUL, SUM_SUB, UNIV_SUBSET, UNWIND_THM2, o_DEF, .. } :=
    D.core6
  let { HULL_INC, HULL_SUBSET, .. } := D.misc
  let { CARD_GE_DIM_INDEPENDENT, DIM_LE_CARD, DIM_SPAN, DIM_UNIV, .. } := D.vec1
  let { INDEPENDENT_STDBASIS, LINEAR_SCALING, .. } := D.vec2
  let { SPAN_INC, SPAN_INSERT_0, SPAN_MONO, SPAN_MUL, SPAN_SUBSET_SUBSPACE, SPAN_SUPERSET,
        SUBSPACE_0, SUBSPACE_IMP_NONEMPTY, SUBSPACE_NEG, SUBSPACE_SPAN,
        SUBSPACE_TRANSLATION_SELF, TRANSLATION_GALOIS, .. } := D.vec3
  let { VECTOR_ADD_ASSOC, VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LNEG,
        VECTOR_MUL_LZERO, VECTOR_SUB_ADD2, VECTOR_SUB_EQ, VECTOR_SUB_RDISTRIB, VECTOR_SUB_REFL,
        VECTOR_SUB_RZERO, VSUM_CLAUSES, VSUM_LMUL, VSUM_SUB, independent, .. } := D.vec4
  let { EMPTY_INTERIOR_LOWDIM, .. } := D.top3
  let { INTERIOR_EMPTY, .. } := D.top4
  let { SUBSET_INTERIOR, .. } := D.top5
  let { AFFINE_TRANSLATION_EQ, AFFINE_TRANSLATION, AFFINE_DIFFS_SUBSPACE, .. } := BAFF
  let { AFFINE_HULL_FINITE, .. } := BAFX
  let { AFFINE_HULL_EMPTY, .. } := BAFS
  let { conic, CONIC_LINEAR_IMAGE, CONIC_HULL_EXPLICIT, .. } := BCON
  let { affine_dependent, AFFINE_DEPENDENT_EXPLICIT_FINITE, .. } := BAFD
  let { SUBSPACE_IMP_AFFINE, CONVEX_HULL_SUBSET_AFFINE_HULL, AFFINE_IMP_SUBSPACE,
        AFFINE_HULL_EQ_SPAN, DEPENDENT_AFFINE_DEPENDENT_CASES, DEPENDENT_IMP_AFFINE_DEPENDENT,
        AFFINE_DEPENDENT_BIGGERSET, AFFINE_INDEPENDENT_IMP_FINITE, .. } := BCLH
  -- @@SCOPE END

  let AFFINE_INDEPENDENT_SPAN_EQ ← prove
   r"!s. ~(affine_dependent s) /\ CARD s = dimindex(:N) + 1
       ==> affine hull s = (:real^N)"
   (MATCH_MP_TAC SET_PROVE_CASES THEN
    REWRITE_TAC [CARD_CLAUSES, ← ARITH_RULE (← q r"~(0 = n + 1)")] THEN
    SIMP_TAC [IMP_CONJ, AFFINE_INDEPENDENT_IMP_FINITE, ← MESON [HAS_SIZE]
     (← q r"FINITE s ==> (CARD s = n <=> s HAS_SIZE n)")] THEN
    X_GEN_TAC (← q r"orig:real^N") THEN GEOM_ORIGIN_TAC (← q r"orig:real^N") THEN
    SIMP_TAC [AFFINE_HULL_EQ_SPAN, IN_INSERT, SPAN_INSERT_0, HULL_INC] THEN
    SIMP_TAC [HAS_SIZE, CARD_CLAUSES, FINITE_INSERT, IMP_CONJ] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"SUC n = m + 1 <=> n = m"), ← GSYM UNIV_SUBSET] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CARD_GE_DIM_INDEPENDENT THEN
    ASM_REWRITE_TAC [DIM_UNIV, SUBSET_UNIV, LE_REFL, independent] THEN
    UNDISCH_TAC (← q r"~affine_dependent((vec 0:real^N) INSERT s)") THEN
    REWRITE_TAC [CONTRAPOS_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC DEPENDENT_IMP_AFFINE_DEPENDENT THEN
    ASM_REWRITE_TAC [VECTOR_SUB_RZERO, ← SET_RULE (← q r"{x | x IN s} = s")])

  let AFFINE_INDEPENDENT_SPAN_GT ← prove
   r"!s:real^N->bool.
        ~(affine_dependent s) /\ dimindex(:N) < CARD s
        ==> affine hull s = (:real^N)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC AFFINE_INDEPENDENT_SPAN_EQ THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← SPEC (← q r"s:real^N->bool") AFFINE_DEPENDENT_BIGGERSET) THEN
    ASM_SIMP_TAC [AFFINE_INDEPENDENT_IMP_FINITE] THEN ASM_ARITH_TAC)

  let EMPTY_INTERIOR_AFFINE_HULL ← prove
   r"!s:real^N->bool.
        FINITE s /\ CARD(s) <= dimindex(:N)
        ==> interior(affine hull s) = {}"
   (REWRITE_TAC [IMP_CONJ] THEN  MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [AFFINE_HULL_EMPTY, INTERIOR_EMPTY] THEN
    SUBGOAL_THEN
     (← q r"!x s:real^N->bool n.
          ~(x IN s) /\ (x INSERT s) HAS_SIZE n /\ n <= dimindex(:N)
          ==> interior(affine hull(x INSERT s)) = {}")
     (fun th => MESON_TAC [th, HAS_SIZE, FINITE_INSERT]) THEN
    X_GEN_TAC (← q r"orig:real^N") THEN GEOM_ORIGIN_TAC (← q r"orig:real^N") THEN
    SIMP_TAC [AFFINE_HULL_EQ_SPAN, IN_INSERT, SPAN_INSERT_0, HULL_INC] THEN
    REWRITE_TAC [HAS_SIZE, FINITE_INSERT, IMP_CONJ] THEN
    SIMP_TAC [CARD_CLAUSES] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC EMPTY_INTERIOR_LOWDIM THEN
    MATCH_MP_TAC LET_TRANS THEN EXISTS_TAC (← q r"CARD(s:real^N->bool)") THEN
    ASM_SIMP_TAC [DIM_LE_CARD, DIM_SPAN] THEN ASM_ARITH_TAC)

  let EMPTY_INTERIOR_CONVEX_HULL ← prove
   r"!s:real^N->bool.
        FINITE s /\ CARD(s) <= dimindex(:N)
        ==> interior(convex hull s) = {}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!t. s SUBSET t /\ t = {} ==> s = {}")) THEN
    EXISTS_TAC (← q r"interior(affine hull s):real^N->bool") THEN
    SIMP_TAC [SUBSET_INTERIOR, CONVEX_HULL_SUBSET_AFFINE_HULL] THEN
    ASM_SIMP_TAC [EMPTY_INTERIOR_AFFINE_HULL])

  let AFFINE_DEPENDENT_CHOOSE ← prove
   r"!s a:real^N.
       ~(affine_dependent s)
       ==> (affine_dependent(a INSERT s) <=> ~(a IN s) /\ a IN affine hull s)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN s") THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"a IN s ==> a INSERT s = s")] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    EQ_TAC THENL
     [UNDISCH_TAC (← q r"~(affine_dependent(s:real^N->bool))") THEN
      ASM_SIMP_TAC [AFFINE_DEPENDENT_EXPLICIT_FINITE, AFFINE_HULL_FINITE,
                    FINITE_INSERT, IN_ELIM_THM, SUM_CLAUSES, VSUM_CLAUSES] THEN
      DISCH_TAC THEN REWRITE_TAC [EXISTS_IN_INSERT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->real") MP_TAC) THEN
      ASM_CASES_TAC (← q r"(u:real^N->real) a = &0") THEN ASM_REWRITE_TAC [] THENL
       [REWRITE_TAC [REAL_ADD_LID, VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN
        DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"u:real^N->real")) THEN ASM_REWRITE_TAC [],
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"ua + sa = &0 <=> sa = --ua"),
                     ← VECTOR_ARITH (← q r"va + sa:real^N = vec 0 <=> sa = --va")] THEN
        STRIP_TAC THEN EXISTS_TAC (← q r"(\x. --(inv(u a)) * u x):real^N->real") THEN
        ASM_SIMP_TAC [SUM_LMUL, ← GSYM VECTOR_MUL_ASSOC, VSUM_LMUL] THEN
        ASM_REWRITE_TAC [VECTOR_MUL_ASSOC, ← GSYM VECTOR_MUL_LNEG] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"--a * --b:real = a * b")] THEN
        ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID]],
      DISCH_TAC THEN REWRITE_TAC [affine_dependent] THEN
      EXISTS_TAC (← q r"a:real^N") THEN
      ASM_SIMP_TAC [IN_INSERT, ← SET_RULE
       (← q r"~(a IN s) ==> (a INSERT s) DELETE a = s")]])

  let AFFINE_INDEPENDENT_INSERT ← prove
   r"!s a:real^N.
        ~(affine_dependent s) /\ ~(a IN affine hull s)
        ==> ~(affine_dependent(a INSERT s))"
   (SIMP_TAC [AFFINE_DEPENDENT_CHOOSE])

  let AFFINE_HULL_EXPLICIT_UNIQUE ← prove
   r"!s:real^N->bool u u'.
      ~(affine_dependent s) /\
      sum s u = &1 /\ sum s u' = &1 /\
      vsum s (\x. u x % x) = vsum s (\x. u' x % x)
      ==> !x. x IN s ==> u x = u' x"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP AFFINE_DEPENDENT_EXPLICIT_FINITE) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(\x. u x - u' x):real^N->real")) THEN
    ASM_SIMP_TAC [VSUM_SUB, SUM_SUB, REAL_SUB_REFL, VECTOR_SUB_RDISTRIB,
                  VECTOR_SUB_REFL, VECTOR_SUB_EQ, REAL_SUB_0] THEN
    MESON_TAC [])

  let INDEPENDENT_IMP_AFFINE_DEPENDENT_0 ← prove
   r"!s. independent s ==> ~(affine_dependent(vec 0 INSERT s))"
   (REWRITE_TAC [independent, DEPENDENT_AFFINE_DEPENDENT_CASES] THEN
    SIMP_TAC [DE_MORGAN_THM, AFFINE_INDEPENDENT_INSERT])

  let AFFINE_INDEPENDENT_STDBASIS ← prove
   r"~(affine_dependent
      ((vec 0:real^N) INSERT {basis i | 1 <= i /\ i <= dimindex (:N)}))"
   (SIMP_TAC [INDEPENDENT_IMP_AFFINE_DEPENDENT_0, INDEPENDENT_STDBASIS])

  let SPAN_CONIC_HULL ← prove
   r"!s:real^N->bool. span(conic hull s) = span s"
   (GEN_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    SIMP_TAC [HULL_SUBSET, SPAN_MONO] THEN MATCH_MP_TAC SPAN_SUBSET_SUBSPACE THEN
    REWRITE_TAC [SUBSPACE_SPAN, CONIC_HULL_EXPLICIT] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MESON_TAC [SPAN_SUPERSET, SPAN_MUL])

  let CONIC_HULLS_EQ_IMP_SPANS_EQ ← prove
   r"!s t:real^N->bool.
        conic hull s = conic hull t ==> span s = span t"
   (MESON_TAC [SPAN_CONIC_HULL])

  let DIM_CONIC_HULL ← prove
   r"!s:real^N->bool. dim(conic hull s) = dim s"
   (MESON_TAC [DIM_SPAN, SPAN_CONIC_HULL])

  let CONIC_HULL_SUBSET_SPAN ← prove
   r"!s:real^N->bool. conic hull s SUBSET span s"
   (MESON_TAC [SPAN_CONIC_HULL, SPAN_INC])

  let CONIC_IMAGE_MULTIPLE_EQ ← prove
   r"!s:real^N->bool. conic s <=> !a. &0 <= a ==> IMAGE (\x. a % x) s SUBSET s"
   (SIMP_TAC [conic, SUBSET, FORALL_IN_IMAGE] THEN MESON_TAC [])

  let CONIC_IMAGE_MULTIPLE ← prove
   r"!s:real^N->bool a. conic s /\ &0 < a ==> IMAGE (\x. a % x) s = s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_LT_IMP_LE, CONIC_IMAGE_MULTIPLE_EQ], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\x:real^N. a % x) s") CONIC_IMAGE_MULTIPLE_EQ) THEN
    ASM_SIMP_TAC [CONIC_LINEAR_IMAGE, LINEAR_SCALING] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv a:real")) THEN
    ASM_SIMP_TAC [REAL_LT_INV_EQ, REAL_LT_IMP_LE, ← GSYM IMAGE_o] THEN
    ASM_SIMP_TAC [o_DEF, VECTOR_MUL_ASSOC, REAL_MUL_LINV, REAL_LT_IMP_NZ] THEN
    REWRITE_TAC [VECTOR_MUL_LID, IMAGE_ID])

  let AFFINE_TRANSLATION_SUBSPACE ← prove
   r"!t:real^N->bool.
        affine t /\ ~(t = {}) <=> ?a s. subspace s /\ t = IMAGE (\x. a + x) s"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [SUBSPACE_IMP_NONEMPTY, IMAGE_EQ_EMPTY,
                  AFFINE_TRANSLATION, SUBSPACE_IMP_AFFINE] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [TRANSLATION_GALOIS] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    REWRITE_TAC [UNWIND_THM2] THEN MATCH_MP_TAC AFFINE_IMP_SUBSPACE THEN
    ASM_REWRITE_TAC [AFFINE_TRANSLATION_EQ, IN_IMAGE] THEN
    EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC)

  let AFFINE_TRANSLATION_UNIQUE_SUBSPACE ← prove
   r"!t:real^N->bool.
        affine t /\ ~(t = {}) <=>
        ?!s. ?a. subspace s /\ t = IMAGE (\x. a + x) s"
   (GEN_TAC THEN REWRITE_TAC [AFFINE_TRANSLATION_SUBSPACE] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!a a' s s'. P s a /\ P s' a' ==> s = s')
      ==> ((?a s. P s a) <=> (?!s. ?a. P s a))")) THEN
    REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [TRANSLATION_GALOIS] THEN
    DISCH_THEN SUBST1_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_ADD_ASSOC] THEN
    MATCH_MP_TAC SUBSPACE_TRANSLATION_SELF THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"--a' + a:real^N = --(a' - a)")] THEN
    MATCH_MP_TAC SUBSPACE_NEG THEN ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"t = IMAGE (\x:real^N. a' + x) s'") THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"\s. (a':real^N) IN s")) THEN
    REWRITE_TAC [IN_IMAGE, ← VECTOR_ARITH (← q r"a:real^N = a + x <=> x = vec 0")] THEN
    ASM_SIMP_TAC [UNWIND_THM2, SUBSPACE_0] THEN
    REWRITE_TAC [IN_IMAGE, ← VECTOR_ARITH (← q r"a':real^N = a + x <=> x = a' - a")] THEN
    REWRITE_TAC [UNWIND_THM2])

  let AFFINE_TRANSLATION_SUBSPACE_EXPLICIT ← prove
   r"!t:real^N->bool a.
        affine t /\ a IN t
        ==> subspace {x - a | x IN t} /\
            t = IMAGE (\x. a + x) {x - a | x IN t}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [AFFINE_DIFFS_SUBSPACE] THEN
    ASM_REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o] THEN
    REWRITE_TAC [o_DEF, VECTOR_SUB_ADD2, IMAGE_ID])

  return { AFFINE_INDEPENDENT_SPAN_EQ, AFFINE_INDEPENDENT_SPAN_GT, EMPTY_INTERIOR_AFFINE_HULL,
           EMPTY_INTERIOR_CONVEX_HULL, AFFINE_DEPENDENT_CHOOSE, AFFINE_INDEPENDENT_INSERT,
           AFFINE_HULL_EXPLICIT_UNIQUE, INDEPENDENT_IMP_AFFINE_DEPENDENT_0,
           AFFINE_INDEPENDENT_STDBASIS, SPAN_CONIC_HULL, CONIC_HULLS_EQ_IMP_SPANS_EQ,
           DIM_CONIC_HULL, CONIC_HULL_SUBSET_SPAN, CONIC_IMAGE_MULTIPLE_EQ, CONIC_IMAGE_MULTIPLE,
           AFFINE_TRANSLATION_SUBSPACE, AFFINE_TRANSLATION_UNIQUE_SUBSPACE,
           AFFINE_TRANSLATION_SUBSPACE_EXPLICIT }

/- ------------------------------------------------------------------------- -/
/- If we take a slice out of a set, we can do it perpendicularly, with the  -/
/- normal vector to the slice parallel to the affine hull; affine dimension. -/
/- (convex.ml 4132-4285)                                                     -/
/- ------------------------------------------------------------------------- -/

structure ADA where
  AFFINE_PARALLEL_SLICE : thm
  MAXIMAL_AFFINE_INDEPENDENT_SUBSET : thm
  MAXIMAL_AFFINE_INDEPENDENT_SUBSET_AFFINE : thm
  EXTEND_TO_AFFINE_BASIS : thm
  AFFINE_BASIS_EXISTS : thm
  aff_dim : thm
  AFF_DIM : thm
  AFF_DIM_EMPTY : thm
  AFF_DIM_AFFINE_HULL : thm
  AFF_DIM_TRANSLATION_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupADA [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BAFD : AFD) (BCLH : CLH)
    (BAFI : AFI) : ExceptT String IO ADA := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, INT_ARITH, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, SET_TAC, SELECT_CONV, VECTOR_ARITH, add_translation_invariants,
        GEN_GEOM_ORIGIN_TAC, GEOM_TRANSLATE_TAC, .. } := D
  let { CARD_CLAUSES, CARD_IMAGE_INJ, CARD_SUBSET_LE, CONTRAPOS_THM, EMPTY_SUBSET, EXISTS_REFL,
        EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, INSERT_SUBSET, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_FORALL_THM, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_LE, .. } := D.core4
  let { REAL_NOT_LE, RIGHT_EXISTS_AND_THM, SELECT_REFL, SUBSET, SUBSET_ANTISYM,
        SUBSET_REFL, .. } := D.core5
  let { SWAP_EXISTS_THM, UNWIND_THM2, num_MAX, .. } := D.core6
  let { HULL_HULL, HULL_INC, HULL_MINIMAL, HULL_MONO, HULL_P, .. } := D.misc
  let { DOT_LADD, DOT_RADD, DOT_RMUL, DOT_RSUB, .. } := D.vec1
  let { ORTHOGONAL_SUBSPACE_DECOMP_EXISTS, SPAN_EQ_SELF, SUBSPACE_ADD, .. } := D.vec3
  let { VECTOR_ADD_ASSOC, VECTOR_ADD_LID, VECTOR_ADD_RID, orthogonal, .. } := D.vec4
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { AFFINE_HULL_EMPTY, AFFINE_HULL_EQ_EMPTY, .. } := BAFS
  let { AFFINE_INDEPENDENT_EMPTY, .. } := BAFD
  let { AFFINE_IMP_SUBSPACE, AFFINE_INDEPENDENT_IMP_FINITE, AFFINE_INDEPENDENT_CARD_LE, .. } :=
    BCLH
  let { AFFINE_INDEPENDENT_INSERT, .. } := BAFI
  -- @@SCOPE END

  let AFFINE_PARALLEL_SLICE ← prove
   r"!s a:real^N b.
       affine s
       ==> s INTER {x | a dot x <= b} = {} \/ s SUBSET {x | a dot x <= b} \/
           ?a' b'. ~(a' = vec 0) /\
                   s INTER {x | a' dot x <= b'} = s INTER {x | a dot x <= b} /\
                   s INTER {x | a' dot x = b'} = s INTER {x | a dot x = b} /\
                   !w. w IN s ==> (w + a') IN s"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s INTER {x:real^N | a dot x = b} = {}") THENL
     [MATCH_MP_TAC (← TAUT (← q r"~(~p /\ ~q) ==> p \/ q \/ r")) THEN
      REPEAT STRIP_TAC THEN SUBGOAL_THEN
       (← q r"?u v:real^N. u IN s /\ v IN s /\
                     a dot u <= b /\ ~(a dot v <= b)")
      STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(a:real^N) dot u < b") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [REAL_LT_LE] THEN ASM SET_TAC [], ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LE]) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EXTENSION]) THEN
      REWRITE_TAC [NOT_IN_EMPTY, IN_INTER, NOT_FORALL_THM, IN_ELIM_THM] THEN
      EXISTS_TAC
       (← q r"u + (b - a dot u) / (a dot v - a dot u) % (v - u):real^N") THEN
      ASM_SIMP_TAC [IN_AFFINE_ADD_MUL_DIFF] THEN
      REWRITE_TAC [DOT_RADD, DOT_RMUL, DOT_RSUB] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => REAL_FIELD t),
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") MP_TAC) THEN
      REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN POP_ASSUM MP_TAC THEN
      GEN_GEOM_ORIGIN_TAC (← q r"z:real^N") ["a", "a'", "b'", "w"] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [VECTOR_ADD_RID, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [DOT_RADD, ← REAL_ARITH (← q r"a + x <= a <=> x <= &0")] THEN
      SUBGOAL_THEN (← q r"subspace(s:real^N->bool) /\ span s = s")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [AFFINE_IMP_SUBSPACE, SPAN_EQ_SELF], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N"]
            ORTHOGONAL_SUBSPACE_DECOMP_EXISTS) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, orthogonal] THEN
      MAP_EVERY X_GEN_TAC [← q r"a':real^N", ← q r"a'':real^N"] THEN
      ASM_CASES_TAC (← q r"a':real^N = vec 0") THENL
       [ASM_REWRITE_TAC [VECTOR_ADD_LID] THEN
        ASM_CASES_TAC (← q r"a'':real^N = a") THEN ASM_REWRITE_TAC [] THEN
        SIMP_TAC [SUBSET, IN_ELIM_THM, REAL_LE_REFL],
        ALL_TAC] THEN
      STRIP_TAC THEN REPEAT DISJ2_TAC THEN
      EXISTS_TAC (← q r"a':real^N") THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"(a':real^N) dot z") THEN
      REPEAT (CONJ_TAC THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s ==> (p x <=> q x))
          ==> s INTER {x | p x} = s INTER {x | q x}")) THEN
        ASM_SIMP_TAC [DOT_LADD] THEN REAL_ARITH_TAC,
        ALL_TAC]) THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN REWRITE_TAC [IN_IMAGE] THEN
      EXISTS_TAC (← q r"x + a':real^N") THEN
      ASM_SIMP_TAC [SUBSPACE_ADD, VECTOR_ADD_ASSOC]])

  let MAXIMAL_AFFINE_INDEPENDENT_SUBSET ← prove
   r"!s b:real^N->bool.
        b SUBSET s /\ ~(affine_dependent b) /\
        (!b'. b SUBSET b' /\ b' SUBSET s /\ ~(affine_dependent b') ==> b' = b)
        ==> s SUBSET (affine hull b)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"(!a. a IN t /\ ~(a IN s) ==> F) ==> t SUBSET s")) THEN
    X_GEN_TAC (← q r"a:real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(a:real^N) INSERT b")) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP
     (← ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM] HULL_INC)) THEN
    ASM_SIMP_TAC [AFFINE_INDEPENDENT_INSERT, INSERT_SUBSET] THEN
    ASM SET_TAC [])

  let MAXIMAL_AFFINE_INDEPENDENT_SUBSET_AFFINE ← prove
   r"!s b:real^N->bool.
        affine s /\ b SUBSET s /\ ~(affine_dependent b) /\
        (!b'. b SUBSET b' /\ b' SUBSET s /\ ~(affine_dependent b') ==> b' = b)
        ==> affine hull b = s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [ASM_MESON_TAC [HULL_MONO, HULL_P],
      ASM_MESON_TAC [MAXIMAL_AFFINE_INDEPENDENT_SUBSET]])

  let EXTEND_TO_AFFINE_BASIS ← prove
   r"!s u:real^N->bool.
        ~(affine_dependent s) /\ s SUBSET u
        ==> ?t. ~(affine_dependent t) /\ s SUBSET t /\ t SUBSET u /\
                affine hull t = affine hull u"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPEC (← q r"\n. ?t:real^N->bool. ~(affine_dependent t) /\ s SUBSET t /\
                                      t SUBSET u /\ CARD t = n")
     num_MAX) THEN
    DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1)) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SUBSET_REFL, AFFINE_INDEPENDENT_CARD_LE], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [ASM_MESON_TAC [HULL_MONO, HULL_P], ALL_TAC] THEN
    MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [AFFINE_AFFINE_HULL] THEN
    MATCH_MP_TAC MAXIMAL_AFFINE_INDEPENDENT_SUBSET THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"CARD(c:real^N->bool)")) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARD_SUBSET_LE THEN
    ASM_MESON_TAC [AFFINE_INDEPENDENT_IMP_FINITE])

  let AFFINE_BASIS_EXISTS ← prove
   r"!s:real^N->bool.
      ?b. ~(affine_dependent b) /\ b SUBSET s /\
          affine hull b = affine hull s"
   (GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"{}:real^N->bool", ← q r"s:real^N->bool"]
      EXTEND_TO_AFFINE_BASIS) THEN
    REWRITE_TAC [AFFINE_INDEPENDENT_EMPTY, EMPTY_SUBSET])

  let aff_dim ← new_definition
   r"aff_dim s =
        @d:int. ?b. affine hull b = affine hull s /\ ~(affine_dependent b) /\
                    &(CARD b) = d + &1"

  let AFF_DIM ← prove
   r"!s. ?b. affine hull b = affine hull s /\
           ~(affine_dependent b) /\
           aff_dim s = &(CARD b) - &1"
   (GEN_TAC THEN
    REWRITE_TAC [aff_dim, ← INT_ARITH (← q r"y:int = x + &1 <=> x = y - &1")] THEN
    CONV_TAC SELECT_CONV THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, EXISTS_REFL] THEN
    MESON_TAC [AFFINE_BASIS_EXISTS])

  let AFF_DIM_EMPTY ← prove
   r"aff_dim {} = -- &1"
   (REWRITE_TAC [aff_dim, AFFINE_HULL_EMPTY, AFFINE_HULL_EQ_EMPTY] THEN
    REWRITE_TAC [UNWIND_THM2, AFFINE_INDEPENDENT_EMPTY, CARD_CLAUSES] THEN
    REWRITE_TAC [← INT_ARITH (← q r"&0 = d + &1 <=> d:int = -- &1"), SELECT_REFL])

  let AFF_DIM_AFFINE_HULL ← prove
   r"!s. aff_dim(affine hull s) = aff_dim s"
   (REWRITE_TAC [aff_dim, HULL_HULL])

  let AFF_DIM_TRANSLATION_EQ ← prove
   r"!a:real^N s. aff_dim (IMAGE (\x. a + x) s) = aff_dim s"
   (REWRITE_TAC [aff_dim] THEN GEOM_TRANSLATE_TAC [] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> ~(a /\ b ==> ~c)")] THEN
    SIMP_TAC [AFFINE_INDEPENDENT_IMP_FINITE, CARD_IMAGE_INJ,
              ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")])

  add_translation_invariants [AFF_DIM_TRANSLATION_EQ]

  return { AFFINE_PARALLEL_SLICE, MAXIMAL_AFFINE_INDEPENDENT_SUBSET,
           MAXIMAL_AFFINE_INDEPENDENT_SUBSET_AFFINE, EXTEND_TO_AFFINE_BASIS,
           AFFINE_BASIS_EXISTS, aff_dim, AFF_DIM, AFF_DIM_EMPTY, AFF_DIM_AFFINE_HULL,
           AFF_DIM_TRANSLATION_EQ }

/- ------------------------------------------------------------------------- -/
/- Affine dimension, continued.  (convex.ml 4285-4467)                       -/
/- ------------------------------------------------------------------------- -/

structure ADB where
  AFFINE_HULL_CONIC_HULL : thm
  AFFINE_INDEPENDENT_CARD_DIM_DIFFS : thm
  AFF_DIM_DIM_0 : thm
  AFF_DIM_DIM_SUBSPACE : thm
  AFF_DIM_DIM_AFFINE_DIFFS_STRONG : thm
  AFF_DIM_DIM_AFFINE_DIFFS : thm
  AFF_DIM_LINEAR_IMAGE_LE : thm
  AFF_DIM_INJECTIVE_LINEAR_IMAGE : thm
  AFF_DIM_AFFINE_INDEPENDENT : thm
  AFF_DIM_UNIQUE : thm
  AFF_DIM_SING : thm
  AFF_DIM_LE_CARD : thm
  AFF_DIM_GE : thm
  AFF_DIM_SUBSET : thm
  AFF_DIM_LE_DIM : thm
  deriving Inhabited

@[nospecialize]
def setupADB [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BCON : CON) (BAFD : AFD)
    (BCLH : CLH) (BAFI : AFI) (BADA : ADA) : ExceptT String IO ADB := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INT_ARITH, INT_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC,
        INT_REDUCE_CONV, VECTOR_ARITH, add_linear_invariants, GEOM_ORIGIN_TAC, .. } := D
  let { ADD1, ARITH, CARD_CLAUSES, CARD_DELETE, CARD_EQ_0, CARD_IMAGE_INJ, CONTRAPOS_THM,
        EQ_IMP, EQ_TRANS, FINITE_DELETE, FINITE_INSERT, FINITE_RULES, FORALL_IN_GSPEC, .. } :=
    D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, FUN_IN_IMAGE, HAS_SIZE, HAS_SIZE_IMAGE_INJ, IMAGE_CLAUSES,
        IMAGE_ID, IMAGE_o, INT_ADD_LINV, INT_EQ_SUB_RADD, INT_LE_ANTISYM, INT_LE_REFL,
        INT_LE_SUB_LADD, INT_LE_TRANS, INT_OF_NUM_ADD, INT_OF_NUM_EQ, INT_OF_NUM_LE, INT_POS,
        INT_SUB_REFL, IN_DELETE, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, I_THM, LE_ADD_RCANCEL, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } :=
    D.core3
  let { SET_PROVE_CASES, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, .. } := D.core5
  let { o_DEF, o_THM, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { DIM_INSERT_0, DIM_LE_CARD, DIM_LINEAR_IMAGE_LE, DIM_SPAN, DIM_SUBSET, DIM_UNIQUE, .. } :=
    D.vec1
  let { LINEAR_INJECTIVE_LEFT_INVERSE, LINEAR_SUB, .. } := D.vec2
  let { SPAN_0, SPAN_INC, SPAN_INSERT_0, SPAN_SUPERSET, SUBSPACE_0, SUBSPACE_SPAN, .. } := D.vec3
  let { VECTOR_SUB_REFL, VECTOR_SUB_RZERO, independent, .. } := D.vec4
  let { AFFINE_LINEAR_IMAGE, AFFINE_AFFINE_HULL, AFFINE_HULL_EQ, AFFINE_HULL_LINEAR_IMAGE,
        IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { AFFINE_HULL_EMPTY, AFFINE_HULL_EQ_EMPTY, DIFFS_AFFINE_HULL_SPAN, .. } := BAFS
  let { CONIC_HULL_EMPTY, CONIC_HULL_CONTAINS_0, .. } := BCON
  let { AFFINE_INDEPENDENT_1, .. } := BAFD
  let { AFFINE_HULL_EQ_SPAN, DEPENDENT_IMP_AFFINE_DEPENDENT, AFFINE_INDEPENDENT_IMP_FINITE, .. } :=
    BCLH
  let { SPAN_CONIC_HULL, .. } := BAFI
  let { AFF_DIM, AFF_DIM_EMPTY, AFF_DIM_AFFINE_HULL, .. } := BADA
  -- @@SCOPE END

  let AFFINE_HULL_CONIC_HULL ← prove
   r"!s:real^N->bool.
        affine hull (conic hull s) =
        if s = {} then {} else affine hull (vec 0 INSERT s)"
   (GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [CONIC_HULL_EMPTY, AFFINE_HULL_EMPTY] THEN
    ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, IN_INSERT, CONIC_HULL_CONTAINS_0,
                  HULL_INC, SPAN_INSERT_0, SPAN_CONIC_HULL])

  let AFFINE_INDEPENDENT_CARD_DIM_DIFFS ← prove
   r"!s a:real^N.
        ~affine_dependent s /\ a IN s
        ==> CARD s = dim {x - a | x IN s} + 1"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    MATCH_MP_TAC (← ARITH_RULE (← q r"~(s = 0) /\ v = s - 1 ==> s = v + 1")) THEN
    ASM_SIMP_TAC [CARD_EQ_0] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC DIM_UNIQUE THEN
    EXISTS_TAC (← q r"{b - a:real^N |b| b IN (s DELETE a)}") THEN REPEAT CONJ_TAC THENL
     [SET_TAC [],
      REWRITE_TAC [SIMPLE_IMAGE, SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"x:real^N = a") THENL
       [ASM_REWRITE_TAC [VECTOR_SUB_REFL, SPAN_0],
        MATCH_MP_TAC SPAN_SUPERSET THEN ASM SET_TAC []],
      UNDISCH_TAC (← q r"~affine_dependent(s:real^N->bool)") THEN
      REWRITE_TAC [independent, CONTRAPOS_THM] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"s = (a:real^N) INSERT (s DELETE a)") SUBST1_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC DEPENDENT_IMP_AFFINE_DEPENDENT THEN
      ASM_REWRITE_TAC [IN_DELETE],
      REWRITE_TAC [SIMPLE_IMAGE] THEN MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN
      SIMP_TAC [← VECTOR_ARITH (← q r"x - a:real^N = y - a <=> x = y")] THEN
      ASM_SIMP_TAC [HAS_SIZE, FINITE_DELETE, CARD_DELETE]])

  let AFF_DIM_DIM_0 ← do
    let lemma ← prove
     r"!a:real^N s. affine s /\ a IN s ==> aff_dim s = &(dim {x - a | x IN s})"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") AFF_DIM) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool") MP_TAC) THEN
      ASM_CASES_TAC (← q r"b:real^N->bool = {}") THENL
       [ASM_MESON_TAC [AFFINE_HULL_EQ_EMPTY, NOT_IN_EMPTY], ALL_TAC] THEN
      STRIP_TAC THEN
      ASM_REWRITE_TAC [INT_EQ_SUB_RADD, INT_OF_NUM_ADD, INT_OF_NUM_EQ] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"c:real^N")) THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"dim {x - c:real^N | x IN b} + 1") THEN CONJ_TAC THENL
       [MATCH_MP_TAC AFFINE_INDEPENDENT_CARD_DIM_DIFFS THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"dim {x - c:real^N | x IN affine hull b} + 1") THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [DIFFS_AFFINE_HULL_SPAN, DIM_SPAN], ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      SUBGOAL_THEN (← q r"affine hull s:real^N->bool = s") SUBST1_TAC THENL
       [ASM_MESON_TAC [AFFINE_HULL_EQ], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(c:real^N) IN s") ASSUME_TAC THENL
       [ASM_MESON_TAC [AFFINE_HULL_EQ, HULL_INC], ALL_TAC] THEN
      MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      SIMP_TAC [← VECTOR_ARITH (← q r"x - c:real^N = y - a <=> y = x + &1 % (a - c)")] THEN
      ASM_MESON_TAC [IN_AFFINE_ADD_MUL_DIFF])
    prove
     r"!s:real^N->bool. vec 0 IN affine hull s ==> aff_dim s = &(dim s)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"vec 0:real^N", ← q r"affine hull s:real^N->bool"] lemma) THEN
      ASM_REWRITE_TAC [AFFINE_AFFINE_HULL, VECTOR_SUB_RZERO] THEN
      REWRITE_TAC [AFF_DIM_AFFINE_HULL, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
      ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, DIM_SPAN])

  let AFF_DIM_DIM_SUBSPACE ← prove
   r"!s:real^N->bool. subspace s ==> aff_dim s = &(dim s)"
   (MESON_TAC [AFF_DIM_DIM_0, SUBSPACE_0, HULL_INC])

  let AFF_DIM_DIM_AFFINE_DIFFS_STRONG ← prove
   r"!a:real^N s. a IN affine hull s ==> aff_dim s = &(dim {x - a | x IN s})"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    REWRITE_TAC [VECTOR_SUB_RZERO, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
    REWRITE_TAC [AFF_DIM_DIM_0])

  let AFF_DIM_DIM_AFFINE_DIFFS ← prove
   r"!a:real^N s. a IN s ==> aff_dim s = &(dim {x - a | x IN s})"
   (SIMP_TAC [AFF_DIM_DIM_AFFINE_DIFFS_STRONG, HULL_INC])

  let AFF_DIM_LINEAR_IMAGE_LE ← prove
   r"!f:real^M->real^N s. linear f ==> aff_dim(IMAGE f s) <= aff_dim s"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    ASM_SIMP_TAC [AFFINE_HULL_LINEAR_IMAGE] THEN
    MP_TAC (← ISPEC (← q r"s:real^M->bool") AFFINE_AFFINE_HULL) THEN
    SPEC_TAC ((← q r"affine hull s:real^M->bool"), (← q r"s:real^M->bool")) THEN
    GEN_TAC THEN DISCH_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, AFF_DIM_EMPTY, INT_LE_REFL] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^M")) THEN
    SUBGOAL_THEN (← q r"dim {x - f(a) |x| x IN IMAGE (f:real^M->real^N) s} <=
                  dim {x - a | x IN s}")
    MP_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"{f x | x IN IMAGE g s} = {f (g x) | x IN s}")] THEN
      ASM_SIMP_TAC [← GSYM LINEAR_SUB] THEN REWRITE_TAC [SIMPLE_IMAGE] THEN
      ONCE_REWRITE_TAC [← GSYM o_DEF] THEN REWRITE_TAC [IMAGE_o] THEN
      MATCH_MP_TAC DIM_LINEAR_IMAGE_LE THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC EQ_IMP THEN REWRITE_TAC [← GSYM INT_OF_NUM_LE] THEN
      BINOP_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC AFF_DIM_DIM_AFFINE_DIFFS THEN
      ASM_SIMP_TAC [AFFINE_LINEAR_IMAGE, FUN_IN_IMAGE]])

  let AFF_DIM_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> aff_dim(IMAGE f s) = aff_dim s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM INT_LE_ANTISYM] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [AFF_DIM_LINEAR_IMAGE_LE], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    ASM_REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^M") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC INT_LE_TRANS THEN EXISTS_TAC
     (← q r"aff_dim(IMAGE (g:real^N->real^M) (IMAGE (f:real^M->real^N) s))") THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [← GSYM IMAGE_o, o_DEF, IMAGE_ID, INT_LE_REFL],
      MATCH_MP_TAC AFF_DIM_LINEAR_IMAGE_LE THEN ASM_REWRITE_TAC []])

  add_linear_invariants [AFF_DIM_INJECTIVE_LINEAR_IMAGE]

  let AFF_DIM_AFFINE_INDEPENDENT ← prove
   r"!b:real^N->bool.
        ~(affine_dependent b) ==> aff_dim b = &(CARD b) - &1"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"b:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [CARD_CLAUSES, AFF_DIM_EMPTY] THEN INT_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"b:real^N->bool", ← q r"a:real^N"]
     AFFINE_INDEPENDENT_CARD_DIM_DIFFS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [← GSYM INT_OF_NUM_ADD, ← INT_ARITH (← q r"(a + b) - b:int = a")] THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"affine hull b:real^N->bool"]
     AFF_DIM_DIM_AFFINE_DIFFS) THEN
    ASM_SIMP_TAC [AFFINE_AFFINE_HULL, HULL_INC, AFF_DIM_AFFINE_HULL] THEN
    DISCH_THEN (K ALL_TAC) THEN AP_TERM_TAC THEN
    ASM_MESON_TAC [DIFFS_AFFINE_HULL_SPAN, DIM_SPAN])

  let AFF_DIM_UNIQUE ← prove
   r"!s b:real^N->bool.
        affine hull b = affine hull s /\ ~(affine_dependent b)
        ==> aff_dim s = &(CARD b) - &1"
   (MESON_TAC [AFF_DIM_AFFINE_HULL, AFF_DIM_AFFINE_INDEPENDENT])

  let AFF_DIM_SING ← prove
   r"!a:real^N. aff_dim {a} = &0"
   (GEN_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"&(CARD {a:real^N}) - &1:int") THEN CONJ_TAC THENL
     [MATCH_MP_TAC AFF_DIM_AFFINE_INDEPENDENT THEN
      REWRITE_TAC [AFFINE_INDEPENDENT_1],
      SIMP_TAC [CARD_CLAUSES, FINITE_RULES, ARITH, NOT_IN_EMPTY, INT_SUB_REFL]])

  let AFF_DIM_LE_CARD ← prove
   r"!s:real^N->bool. FINITE s ==> aff_dim s <= &(CARD s) - &1"
   (MATCH_MP_TAC SET_PROVE_CASES THEN
    SIMP_TAC [AFF_DIM_EMPTY, CARD_CLAUSES] THEN CONV_TAC INT_REDUCE_CONV THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    SIMP_TAC [AFF_DIM_DIM_0, IN_INSERT, HULL_INC] THEN
    SIMP_TAC [CARD_IMAGE_INJ, ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
    SIMP_TAC [DIM_INSERT_0, INT_LE_SUB_LADD, CARD_CLAUSES, FINITE_INSERT] THEN
    REWRITE_TAC [INT_OF_NUM_ADD, INT_OF_NUM_LE, ADD1, LE_ADD_RCANCEL] THEN
    SIMP_TAC [DIM_LE_CARD])

  let AFF_DIM_GE ← prove
   r"!s:real^N->bool. -- &1 <= aff_dim s"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q r"s:real^N->bool") AFF_DIM) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [INT_LE_SUB_LADD, INT_ADD_LINV, INT_POS])

  let AFF_DIM_SUBSET ← prove
   r"!s t:real^N->bool. s SUBSET t ==> aff_dim s <= aff_dim t"
   (MATCH_MP_TAC SET_PROVE_CASES THEN REWRITE_TAC [AFF_DIM_GE, AFF_DIM_EMPTY] THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(vec 0:real^N) IN t") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [AFF_DIM_DIM_0, IN_INSERT, HULL_INC, INT_OF_NUM_LE, DIM_SUBSET])

  let AFF_DIM_LE_DIM ← prove
   r"!s:real^N->bool. aff_dim s <= &(dim s)"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM DIM_SPAN] THEN
    ASM_SIMP_TAC [← GSYM AFF_DIM_DIM_SUBSPACE, SUBSPACE_SPAN] THEN
    MATCH_MP_TAC AFF_DIM_SUBSET THEN REWRITE_TAC [SPAN_INC])

  return { AFFINE_HULL_CONIC_HULL, AFFINE_INDEPENDENT_CARD_DIM_DIFFS, AFF_DIM_DIM_0,
           AFF_DIM_DIM_SUBSPACE, AFF_DIM_DIM_AFFINE_DIFFS_STRONG, AFF_DIM_DIM_AFFINE_DIFFS,
           AFF_DIM_LINEAR_IMAGE_LE, AFF_DIM_INJECTIVE_LINEAR_IMAGE, AFF_DIM_AFFINE_INDEPENDENT,
           AFF_DIM_UNIQUE, AFF_DIM_SING, AFF_DIM_LE_CARD, AFF_DIM_GE, AFF_DIM_SUBSET,
           AFF_DIM_LE_DIM }

/- ------------------------------------------------------------------------- -/
/- Affine dimension, continued.  (convex.ml 4468-4664)                       -/
/- ------------------------------------------------------------------------- -/

structure ADC where
  AFF_DIM_CONVEX_HULL : thm
  AFF_DIM_CLOSURE : thm
  AFF_DIM_2 : thm
  AFF_DIM_EQ_MINUS1 : thm
  AFF_DIM_POS_LE : thm
  AFF_DIM_EQ_0 : thm
  CONNECTED_IMP_PERFECT_AFF_DIM : thm
  AFF_DIM_UNIV : thm
  AFF_DIM_EQ_AFFINE_HULL : thm
  AFF_DIM_SUMS_INTER : thm
  AFF_DIM_PSUBSET : thm
  AFF_DIM_EQ_FULL_GEN : thm
  AFF_DIM_EQ_FULL : thm
  AFF_DIM_LE_UNIV : thm
  AFFINE_INDEPENDENT_IFF_CARD : thm
  AFFINE_HULL_CONVEX_INTER_NONEMPTY_INTERIOR : thm
  AFFINE_HULL_CONVEX_INTER_OPEN : thm
  AFFINE_HULL_AFFINE_INTER_NONEMPTY_INTERIOR : thm
  AFFINE_HULL_AFFINE_INTER_OPEN : thm
  deriving Inhabited

@[nospecialize]
def setupADC [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BAFD : AFD) (BCLH : CLH)
    (BADA : ADA) (BADB : ADB) : ExceptT String IO ADC := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH, INT_ARITH_TAC, MESON_TAC,
        SET_RULE, INT_REDUCE_CONV, NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV, SIMP_RULE,
        VECTOR_ARITH, GEOM_ORIGIN_TAC, .. } := D
  let { CARD_CLAUSES, CARD_PSUBSET, CONTRAPOS_THM, EQ_TRANS, EXTENSION, FINITE_RULES,
        FINITE_SUBSET, .. } := D.core1
  let { IMP_CONJ, INSERT_AC, INSERT_SUBSET, INTER_SUBSET, INT_EQ_IMP_LE, INT_EQ_SUB_LADD,
        INT_LE_REFL, INT_LE_TRANS, INT_LT_LE, INT_OF_NUM_ADD, INT_OF_NUM_EQ, INT_OF_NUM_LE,
        INT_OF_NUM_LT, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_IN_EMPTY, PSUBSET, .. } := D.core3
  let { REAL_LE_RDIV_EQ, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_MIN,
        REAL_MIN_LT, .. } := D.core4
  let { REAL_MUL_LINV, RIGHT_AND_EXISTS_THM, SET_PROVE_CASES, SING_SUBSET, SUBSET,
        SUBSET_ANTISYM, .. } := D.core5
  let { SUBSET_UNIV, SWAP_FORALL_THM, .. } := D.core6
  let { HULL_HULL, HULL_INC, HULL_MONO, HULL_P, HULL_SUBSET, SUBSET_HULL, .. } := D.misc
  let { DIM_EQ_SPAN, DIM_SUMS_INTER, DIM_UNIV, .. } := D.vec1
  let { NORM_MUL, NORM_POS_LT, SPAN_MUL, SPAN_SUPERSET, SUBSPACE_UNIV, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, .. } := D.vec4
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, CONNECTED_IMP_PERFECT, .. } := D.top2
  let { INTERIOR_OPEN, INTERIOR_SUBSET, IN_CBALL_0, IN_INTERIOR_CBALL, .. } := D.top4
  let { AFFINE_AFFINE_HULL, AFFINE_HULL_UNIV, .. } := BAFF
  let { IN_CONVEX_SET, .. } := BCVX
  let { AFFINE_INDEPENDENT_2, .. } := BAFD
  let { AFFINE_IMP_CONVEX, CONVEX_HULL_SUBSET_AFFINE_HULL, AFFINE_IMP_SUBSPACE,
        AFFINE_HULL_EQ_SPAN, CLOSED_AFFINE_HULL, AFFINE_INDEPENDENT_IMP_FINITE, .. } := BCLH
  let { AFFINE_BASIS_EXISTS, AFF_DIM_EMPTY, AFF_DIM_AFFINE_HULL, AFF_DIM_TRANSLATION_EQ, .. } :=
    BADA
  let { AFF_DIM_DIM_0, AFF_DIM_DIM_SUBSPACE, AFF_DIM_AFFINE_INDEPENDENT, AFF_DIM_SING,
        AFF_DIM_LE_CARD, AFF_DIM_GE, AFF_DIM_SUBSET, .. } := BADB
  -- @@SCOPE END

  let AFF_DIM_CONVEX_HULL ← prove
   r"!s:real^N->bool. aff_dim(convex hull s) = aff_dim s"
   (GEN_TAC THEN MATCH_MP_TAC (← INT_ARITH
     (← q r"!c:int. c = a /\ a <= b /\ b <= c ==> b = a")) THEN
    EXISTS_TAC (← q r"aff_dim(affine hull s:real^N->bool)") THEN
    SIMP_TAC [AFF_DIM_AFFINE_HULL, AFF_DIM_SUBSET, HULL_SUBSET,
              CONVEX_HULL_SUBSET_AFFINE_HULL])

  let AFF_DIM_CLOSURE ← prove
   r"!s:real^N->bool. aff_dim(closure s) = aff_dim s"
   (GEN_TAC THEN MATCH_MP_TAC (← INT_ARITH
     (← q r"!h. h = s /\ s <= c /\ c <= h ==> c:int = s")) THEN
    EXISTS_TAC (← q r"aff_dim(affine hull s:real^N->bool)") THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [AFF_DIM_AFFINE_HULL],
      MATCH_MP_TAC AFF_DIM_SUBSET THEN REWRITE_TAC [CLOSURE_SUBSET],
      MATCH_MP_TAC AFF_DIM_SUBSET THEN
      MATCH_MP_TAC CLOSURE_MINIMAL THEN
      REWRITE_TAC [CLOSED_AFFINE_HULL, HULL_SUBSET]])

  let AFF_DIM_2 ← prove
   r"!a b:real^N. aff_dim {a,b} = if a = b then &0 else &1"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THENL
     [ASM_REWRITE_TAC [INSERT_AC, AFF_DIM_SING], ALL_TAC] THEN
    MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC (← q r"&(CARD {a:real^N,b}) - &1:int") THEN
    ASM_SIMP_TAC [AFF_DIM_AFFINE_INDEPENDENT, AFFINE_INDEPENDENT_2] THEN
    ASM_SIMP_TAC [CARD_CLAUSES, FINITE_RULES, IN_INSERT, NOT_IN_EMPTY] THEN
    CONV_TAC NUM_REDUCE_CONV THEN INT_ARITH_TAC)

  let AFF_DIM_EQ_MINUS1 ← prove
   r"!s:real^N->bool. aff_dim s = -- &1 <=> s = {}"
   (GEN_TAC THEN EQ_TAC THEN SIMP_TAC [AFF_DIM_EMPTY] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← INT_ARITH (← q r"&0:int <= n ==> ~(n = -- &1)")) THEN
    MATCH_MP_TAC INT_LE_TRANS THEN EXISTS_TAC (← q r"aff_dim {a:real^N}") THEN
    ASM_SIMP_TAC [AFF_DIM_SUBSET, SING_SUBSET] THEN
    REWRITE_TAC [AFF_DIM_SING, INT_LE_REFL])

  let AFF_DIM_POS_LE ← prove
   r"!s:real^N->bool. &0 <= aff_dim s <=> ~(s = {})"
   (GEN_TAC THEN REWRITE_TAC [← GSYM AFF_DIM_EQ_MINUS1] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") AFF_DIM_GE) THEN INT_ARITH_TAC)

  let AFF_DIM_EQ_0 ← prove
   r"!s:real^N->bool. aff_dim s = &0 <=> ?a. s = {a}"
   (GEN_TAC THEN EQ_TAC THEN SIMP_TAC [AFF_DIM_SING, LEFT_IMP_EXISTS_THM] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN ASM_REWRITE_TAC [AFF_DIM_EMPTY] THEN
    CONV_TAC INT_REDUCE_CONV THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!b. ~(b = a) /\ {a,b} SUBSET s ==> F) ==> a IN s ==> s = {a}")) THEN
    X_GEN_TAC (← q r"b:real^N") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP AFF_DIM_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N"] AFF_DIM_2) THEN
    ASM_SIMP_TAC [] THEN INT_ARITH_TAC)

  let CONNECTED_IMP_PERFECT_AFF_DIM ← prove
   r"!s x:real^N.
        connected s /\ ~(aff_dim s = &0) /\ x IN s ==> x limit_point_of s"
   (REWRITE_TAC [AFF_DIM_EQ_0, CONNECTED_IMP_PERFECT])

  let AFF_DIM_UNIV ← prove
   r"aff_dim(:real^N) = &(dimindex(:N))"
   (SIMP_TAC [AFF_DIM_DIM_SUBSPACE, SUBSPACE_UNIV, DIM_UNIV])

  let AFF_DIM_EQ_AFFINE_HULL ← prove
   r"!s t:real^N->bool.
        s SUBSET t /\ aff_dim t <= aff_dim s
        ==> affine hull s = affine hull t"
   (MATCH_MP_TAC SET_PROVE_CASES THEN
    SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, AFF_DIM_GE,
              ← INT_ARITH (← q r"a:int <= x ==> (x <= a <=> x = a)")] THEN
    X_GEN_TAC (← q r"a:real^N") THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    SIMP_TAC [INSERT_SUBSET, IMP_CONJ, AFF_DIM_DIM_0, IN_INSERT, DIM_EQ_SPAN,
              HULL_INC, AFFINE_HULL_EQ_SPAN, INT_OF_NUM_LE])

  let AFF_DIM_SUMS_INTER ← prove
   r"!s t:real^N->bool.
        affine s /\ affine t /\ ~(s INTER t = {})
        ==> aff_dim {x + y | x IN s /\ y IN t} =
                (aff_dim s + aff_dim t) - aff_dim(s INTER t)"
   (REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> c ==> a /\ b ==> d")] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
    GEN_REWRITE_TAC BINDER_CONV [SWAP_FORALL_THM] THEN
    GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN X_GEN_TAC (← q r"a:real^N") THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) + (a + y):real^N = &2 % a + (x + y)")] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"{a + x + y:real^N | x IN s /\ y IN t} =
                              IMAGE (\x. a + x) {x + y | x IN s /\ y IN t}")] THEN
    REWRITE_TAC [AFF_DIM_TRANSLATION_EQ, IN_INTER] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"t:real^N->bool"] THEN STRIP_TAC THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(vec 0:real^N) IN {x + y | x IN s /\ y IN t}") ASSUME_TAC THENL
     [REWRITE_TAC [IN_ELIM_THM] THEN REPEAT (EXISTS_TAC (← q r"vec 0:real^N")) THEN
      ASM_REWRITE_TAC [VECTOR_ADD_LID],
      ALL_TAC] THEN
    ASM_SIMP_TAC [AFF_DIM_DIM_0, HULL_INC, IN_INTER] THEN
    REWRITE_TAC [INT_EQ_SUB_LADD, INT_OF_NUM_ADD, INT_OF_NUM_EQ] THEN
    MATCH_MP_TAC DIM_SUMS_INTER THEN ASM_SIMP_TAC [AFFINE_IMP_SUBSPACE])

  let AFF_DIM_PSUBSET ← prove
   r"!s t. (affine hull s) PSUBSET (affine hull t) ==> aff_dim s < aff_dim t"
   (ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    SIMP_TAC [PSUBSET, AFF_DIM_SUBSET, INT_LT_LE] THEN
    MESON_TAC [INT_EQ_IMP_LE, AFF_DIM_EQ_AFFINE_HULL, HULL_HULL])

  let AFF_DIM_EQ_FULL_GEN ← prove
   r"!s t:real^N->bool.
        s SUBSET t
        ==> (aff_dim s = aff_dim t <=> affine hull s = affine hull t)"
   (REPEAT STRIP_TAC THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC [AFF_DIM_AFFINE_HULL]] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC AFF_DIM_EQ_AFFINE_HULL THEN
    ASM_REWRITE_TAC [INT_LE_REFL])

  let AFF_DIM_EQ_FULL ← prove
   r"!s. aff_dim s = &(dimindex(:N)) <=> affine hull s = (:real^N)"
   (SIMP_TAC [← GSYM AFF_DIM_UNIV, SUBSET_UNIV, AFF_DIM_EQ_FULL_GEN] THEN
    REWRITE_TAC [AFFINE_HULL_UNIV])

  let AFF_DIM_LE_UNIV ← prove
   r"!s:real^N->bool. aff_dim s <= &(dimindex(:N))"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM AFF_DIM_UNIV] THEN
    MATCH_MP_TAC AFF_DIM_SUBSET THEN REWRITE_TAC [SUBSET_UNIV])

  let AFFINE_INDEPENDENT_IFF_CARD ← prove
   r"!s:real^N->bool.
        ~affine_dependent s <=> FINITE s /\ aff_dim s = &(CARD s) - &1"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [AFF_DIM_AFFINE_INDEPENDENT, AFFINE_INDEPENDENT_IMP_FINITE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [] THEN DISCH_TAC THEN
    X_CHOOSE_THEN (← q r"b:real^N->bool") STRIP_ASSUME_TAC
     (← ISPEC (← q r"s:real^N->bool") AFFINE_BASIS_EXISTS) THEN
    MATCH_MP_TAC (← ARITH_RULE
      (← q r"!b:int. a <= b - &1 /\ b < s ==> ~(a = s - &1)")) THEN
    EXISTS_TAC (← q r"&(CARD(b:real^N->bool)):int") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [AFF_DIM_LE_CARD, FINITE_SUBSET, AFF_DIM_AFFINE_HULL],
      REWRITE_TAC [INT_OF_NUM_LT] THEN MATCH_MP_TAC CARD_PSUBSET THEN
      ASM_REWRITE_TAC [PSUBSET] THEN ASM_MESON_TAC []])

  let AFFINE_HULL_CONVEX_INTER_NONEMPTY_INTERIOR ← prove
   r"!s t:real^N->bool.
        convex s /\ ~(s INTER interior t = {})
        ==> affine hull (s INTER t) = affine hull s"
   (REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, RIGHT_AND_EXISTS_THM,
                 LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"t:real^N->bool", ← q r"a:real^N"] THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REWRITE_TAC [IN_INTER] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [HULL_MONO, INTER_SUBSET] THEN
    SIMP_TAC [SUBSET_HULL, AFFINE_AFFINE_HULL] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← SIMP_RULE [SUBSET] INTERIOR_SUBSET)) THEN
    ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC, IN_INTER] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERIOR_CBALL]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, SUBSET, IN_CBALL_0] THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN REWRITE_TAC [EXTENSION, IN_UNIV] THEN
    X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
    ASM_SIMP_TAC [SPAN_SUPERSET, IN_INTER] THEN DISCH_TAC THEN
    ABBREV_TAC (← q r"k = min (&1 / &2) (e / norm(x:real^N))") THEN
    SUBGOAL_THEN (← q r"&0 < k /\ k < &1") STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "k" THEN
      ASM_SIMP_TAC [REAL_LT_MIN, REAL_LT_DIV, NORM_POS_LT, REAL_MIN_LT] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"x:real^N = inv k % k % x") SUBST1_TAC THENL
     [ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, VECTOR_MUL_LID,
                    REAL_LT_IMP_NZ],
      ALL_TAC] THEN
    MATCH_MP_TAC SPAN_MUL THEN MATCH_MP_TAC SPAN_SUPERSET THEN
    REWRITE_TAC [IN_INTER] THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← VECTOR_ARITH
       (← q r"k % x:real^N = (&1 - k) % vec 0 + k % x")] THEN
      MATCH_MP_TAC IN_CONVEX_SET THEN ASM_SIMP_TAC [REAL_LT_IMP_LE],
      FIRST_X_ASSUM MATCH_MP_TAC THEN EXPAND_TAC "k" THEN
      ASM_SIMP_TAC [NORM_MUL, ← GSYM REAL_LE_RDIV_EQ, NORM_POS_LT] THEN
      ASM_REAL_ARITH_TAC])

  let AFFINE_HULL_CONVEX_INTER_OPEN ← prove
   r"!s t:real^N->bool.
        convex s /\ open t /\ ~(s INTER t = {})
        ==> affine hull (s INTER t) = affine hull s"
   (ASM_SIMP_TAC [AFFINE_HULL_CONVEX_INTER_NONEMPTY_INTERIOR, INTERIOR_OPEN])

  let AFFINE_HULL_AFFINE_INTER_NONEMPTY_INTERIOR ← prove
   r"!s t:real^N->bool.
        affine s /\ ~(s INTER interior t = {})
        ==> affine hull (s INTER t) = s"
   (SIMP_TAC [AFFINE_HULL_CONVEX_INTER_NONEMPTY_INTERIOR, AFFINE_IMP_CONVEX,
              HULL_P])

  let AFFINE_HULL_AFFINE_INTER_OPEN ← prove
   r"!s t:real^N->bool.
        affine s /\ open t /\ ~(s INTER t = {})
        ==> affine hull (s INTER t) = s"
   (SIMP_TAC [AFFINE_HULL_AFFINE_INTER_NONEMPTY_INTERIOR, INTERIOR_OPEN])

  return { AFF_DIM_CONVEX_HULL, AFF_DIM_CLOSURE, AFF_DIM_2, AFF_DIM_EQ_MINUS1, AFF_DIM_POS_LE,
           AFF_DIM_EQ_0, CONNECTED_IMP_PERFECT_AFF_DIM, AFF_DIM_UNIV, AFF_DIM_EQ_AFFINE_HULL,
           AFF_DIM_SUMS_INTER, AFF_DIM_PSUBSET, AFF_DIM_EQ_FULL_GEN, AFF_DIM_EQ_FULL,
           AFF_DIM_LE_UNIV, AFFINE_INDEPENDENT_IFF_CARD,
           AFFINE_HULL_CONVEX_INTER_NONEMPTY_INTERIOR, AFFINE_HULL_CONVEX_INTER_OPEN,
           AFFINE_HULL_AFFINE_INTER_NONEMPTY_INTERIOR, AFFINE_HULL_AFFINE_INTER_OPEN }

/- ------------------------------------------------------------------------- -/
/- Affine dimension, continued.  (convex.ml 4667-4880)                       -/
/- ------------------------------------------------------------------------- -/

structure ADD where
  CONVEX_AND_AFFINE_INTER_OPEN : thm
  AFFINE_HULL_CONVEX_INTER_OPEN_IN : thm
  AFFINE_HULL_AFFINE_INTER_OPEN_IN : thm
  AFFINE_HULL_OPEN_IN_CONVEX : thm
  AFFINE_HULL_OPEN_IN : thm
  AFFINE_HULL_OPEN_IN_AFFINE : thm
  AFFINE_HULL_OPEN : thm
  AFFINE_HULL_NONEMPTY_INTERIOR : thm
  AFF_DIM_OPEN : thm
  AFF_DIM_NONEMPTY_INTERIOR : thm
  EMPTY_INTERIOR_AFF_DIM : thm
  SPAN_OPEN : thm
  DIM_OPEN : thm
  AFF_DIM_INSERT : thm
  AFF_DIM_DIM : thm
  AFF_DIM_CONIC_HULL_DIM : thm
  AFFINE_BOUNDED_EQ_TRIVIAL : thm
  AFFINE_BOUNDED_EQ_LOWDIM : thm
  COLLINEAR_AFF_DIM : thm
  COPLANAR_AFF_DIM : thm
  HOMEOMORPHIC_AFFINE_SETS : thm
  deriving Inhabited

@[nospecialize]
def setupADD [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BCVX : CVX) (BCOP : COP)
    (BCLH : CLH) (BAFI : AFI) (BADA : ADA) (BADB : ADB) (BADC : ADC) :
    ExceptT String IO ADD := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_INT_ARITH_TAC, ASM_MESON_TAC, INT_ARITH, INT_ARITH_TAC, MESON, MESON_TAC,
        SET_RULE, SET_TAC, INT_REDUCE_CONV, GEOM_ORIGIN_TAC, .. } := D
  let { CARD_CLAUSES, EQ_SYM_EQ, FINITE_EMPTY, FINITE_INSERT, .. } := D.core1
  let { INT_LE_TRANS, INT_LT_ANTISYM, INT_OF_NUM_ADD, INT_OF_NUM_EQ, INT_OF_NUM_LE,
        INT_SUB_LZERO, .. } := D.core2
  let { IN_INSERT, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core3
  let { RIGHT_IMP_FORALL_THM, SET_PROVE_CASES, .. } := D.core5
  let { SWAP_FORALL_THM, .. } := D.core6
  let { HULL_HULL, HULL_INC, HULL_MONO, HULL_P, HULL_SUBSET, .. } := D.misc
  let { COLLINEAR_SMALL, DIM_EMPTY, DIM_EQ_FULL, DIM_INSERT, DIM_INSERT_0, .. } := D.vec1
  let { SPAN_0, SPAN_INSERT_0, SUBSPACE_0, .. } := D.vec3
  let { BOUNDED_EMPTY, .. } := D.top1
  let { HOMEOMORPHIC_EMPTY, HOMEOMORPHIC_SUBSPACES, .. } := D.top3
  let { INTERIOR_SUBSET, .. } := D.top4
  let { OPEN_INTERIOR, OPEN_IN_OPEN, SUBSPACE_BOUNDED_EQ_TRIVIAL, .. } := D.top5
  let { AFFINE_AFFINE_HULL, AFFINE_HULL_EQ, AFFINE_HULL_UNIV, .. } := BAFF
  let { AFFINE_HULL_EMPTY, .. } := BAFS
  let { CONVEX_UNIV, .. } := BCVX
  let { coplanar, COLLINEAR_AFFINE_HULL, COPLANAR_SMALL, COLLINEAR_AFFINE_HULL_COLLINEAR,
        COPLANAR_AFFINE_HULL_COPLANAR, .. } := BCOP
  let { AFFINE_IMP_CONVEX, AFFINE_HULL_SUBSET_SPAN, AFFINE_EQ_SUBSPACE, AFFINE_HULL_EQ_SPAN,
        AFFINE_INDEPENDENT_IMP_FINITE, .. } := BCLH
  let { DIM_CONIC_HULL, .. } := BAFI
  let { AFFINE_BASIS_EXISTS, AFF_DIM, AFF_DIM_EMPTY, AFF_DIM_AFFINE_HULL, .. } := BADA
  let { AFFINE_HULL_CONIC_HULL, AFF_DIM_DIM_0, AFF_DIM_SING, AFF_DIM_LE_CARD, AFF_DIM_GE,
        AFF_DIM_SUBSET, .. } := BADB
  let { AFF_DIM_EQ_MINUS1, AFF_DIM_EQ_0, AFF_DIM_EQ_FULL, AFFINE_INDEPENDENT_IFF_CARD,
        AFFINE_HULL_CONVEX_INTER_OPEN, .. } := BADC
  -- @@SCOPE END

  let CONVEX_AND_AFFINE_INTER_OPEN ← prove
   r"!s t u:real^N->bool.
        convex s /\ affine t /\ open u /\
        s INTER u = t INTER u /\ ~(s INTER u = {})
        ==> affine hull s = t"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← MESON [] (← q r"!u v. x = u /\ u = v /\ v = y ==> x = y")) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"affine hull (s INTER u:real^N->bool)",
      ← q r"affine hull t:real^N->bool"] THEN
    REPEAT CONJ_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC AFFINE_HULL_CONVEX_INTER_OPEN THEN
      ASM_REWRITE_TAC [],
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC AFFINE_HULL_CONVEX_INTER_OPEN THEN
      ASM_SIMP_TAC [AFFINE_IMP_CONVEX] THEN ASM SET_TAC [],
      ASM_REWRITE_TAC [AFFINE_HULL_EQ]])

  let AFFINE_HULL_CONVEX_INTER_OPEN_IN ← prove
   r"!s t:real^N->bool.
        convex s /\ open_in (subtopology euclidean (affine hull s)) t /\
        ~(s INTER t = {})
        ==> affine hull (s INTER t) = affine hull s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET t ==> s INTER t INTER u = s INTER u"),
                  HULL_SUBSET] THEN
    MATCH_MP_TAC AFFINE_HULL_CONVEX_INTER_OPEN THEN ASM SET_TAC [])

  let AFFINE_HULL_AFFINE_INTER_OPEN_IN ← prove
   r"!s t:real^N->bool.
        affine s /\ open_in (subtopology euclidean s) t /\ ~(s INTER t = {})
        ==> affine hull (s INTER t) = s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"affine hull s:real^N->bool", ← q r"t:real^N->bool"]
          AFFINE_HULL_CONVEX_INTER_OPEN_IN) THEN
    ASM_SIMP_TAC [HULL_HULL, AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL, HULL_P])

  let AFFINE_HULL_OPEN_IN_CONVEX ← prove
   r"!s t:real^N->bool.
        convex s /\ open_in (subtopology euclidean s) t /\ ~(t = {})
        ==> affine hull t = affine hull s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC AFFINE_HULL_CONVEX_INTER_OPEN THEN
    REWRITE_TAC [AFFINE_AFFINE_HULL] THEN ASM SET_TAC [])

  let AFFINE_HULL_OPEN_IN ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean (affine hull t)) s /\ ~(s = {})
        ==> affine hull s = affine hull t"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM HULL_HULL] THEN
    MATCH_MP_TAC AFFINE_HULL_OPEN_IN_CONVEX THEN
    ASM_SIMP_TAC [AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL])

  let AFFINE_HULL_OPEN_IN_AFFINE ← prove
   r"!u s:real^N->bool.
        affine u /\ open_in (subtopology euclidean u) s /\ ~(s = {})
        ==> affine hull s = u"
   (MESON_TAC [AFFINE_HULL_OPEN_IN, AFFINE_HULL_EQ])

  let AFFINE_HULL_OPEN ← prove
   r"!s. open s /\ ~(s = {}) ==> affine hull s = (:real^N)"
   (GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    SUBST1_TAC (← SET_RULE (← q r"s = (:real^N) INTER s")) THEN
    ASM_SIMP_TAC [AFFINE_HULL_CONVEX_INTER_OPEN, CONVEX_UNIV] THEN
    REWRITE_TAC [AFFINE_HULL_UNIV])

  let AFFINE_HULL_NONEMPTY_INTERIOR ← prove
   r"!s. ~(interior s = {}) ==> affine hull s = (:real^N)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ s = UNIV ==> t = UNIV")) THEN
    EXISTS_TAC (← q r"affine hull (interior s:real^N->bool)") THEN
    SIMP_TAC [HULL_MONO, INTERIOR_SUBSET] THEN
    ASM_SIMP_TAC [AFFINE_HULL_OPEN, OPEN_INTERIOR])

  let AFF_DIM_OPEN ← prove
   r"!s:real^N->bool. open s /\ ~(s = {}) ==> aff_dim s = &(dimindex(:N))"
   (SIMP_TAC [AFF_DIM_EQ_FULL, AFFINE_HULL_OPEN])

  let AFF_DIM_NONEMPTY_INTERIOR ← prove
   r"!s:real^N->bool. ~(interior s = {}) ==> aff_dim s = &(dimindex(:N))"
   (SIMP_TAC [AFF_DIM_EQ_FULL, AFFINE_HULL_NONEMPTY_INTERIOR])

  let EMPTY_INTERIOR_AFF_DIM ← prove
   r"!s:real^N->bool. aff_dim s < &(dimindex(:N)) ==> interior s = {}"
   (MESON_TAC [AFF_DIM_NONEMPTY_INTERIOR, INT_LT_ANTISYM])

  let SPAN_OPEN ← prove
   r"!s. open s /\ ~(s = {}) ==> span s = (:real^N)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ s = UNIV ==> t = UNIV")) THEN
    EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
    ASM_SIMP_TAC [AFFINE_HULL_OPEN, AFFINE_HULL_SUBSET_SPAN])

  let DIM_OPEN ← prove
   r"!s:real^N->bool. open s /\ ~(s = {}) ==> dim s = dimindex(:N)"
   (SIMP_TAC [DIM_EQ_FULL, SPAN_OPEN])

  let AFF_DIM_INSERT ← prove
   r"!a:real^N s.
        aff_dim (a INSERT s) =
        if a IN affine hull s then aff_dim s else aff_dim s + &1"
   (ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN MATCH_MP_TAC SET_PROVE_CASES THEN
    SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_SING, AFFINE_HULL_EMPTY, NOT_IN_EMPTY] THEN
    CONV_TAC INT_REDUCE_CONV THEN REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"s:real^N->bool", ← q r"a:real^N"] THEN
    GEOM_ORIGIN_TAC (← q r"b:real^N") THEN
    SIMP_TAC [AFFINE_HULL_EQ_SPAN, AFF_DIM_DIM_0, HULL_INC, IN_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"s:real^N->bool"] THEN
    DISCH_THEN (K ALL_TAC) THEN
    SPEC_TAC ((← q r"(vec 0:real^N) INSERT s"), (← q r"s:real^N->bool")) THEN
    SIMP_TAC [DIM_INSERT, INT_OF_NUM_ADD] THEN MESON_TAC [])

  let AFF_DIM_DIM ← prove
   r"!s:real^N->bool.
        aff_dim s = if vec 0 IN affine hull s then &(dim s)
                    else &(dim s) - &1"
   (GEN_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [AFF_DIM_DIM_0] THEN
    MP_TAC (← ISPECL [← q r"vec 0:real^N", ← q r"s:real^N->bool"] AFF_DIM_INSERT) THEN
    ASM_SIMP_TAC [AFF_DIM_DIM_0, IN_INSERT, HULL_INC, DIM_INSERT_0] THEN
    INT_ARITH_TAC)

  let AFF_DIM_CONIC_HULL_DIM ← prove
   r"!s:real^N->bool.
        aff_dim (conic hull s) = if s = {} then -- &1 else &(dim s)"
   (GEN_TAC THEN
    REWRITE_TAC [AFF_DIM_DIM, AFFINE_HULL_CONIC_HULL] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, SPAN_INSERT_0, HULL_INC, IN_INSERT, SPAN_0,
                  DIM_CONIC_HULL, NOT_IN_EMPTY, DIM_EMPTY, INT_SUB_LZERO])

  let AFFINE_BOUNDED_EQ_TRIVIAL ← prove
   r"!s:real^N->bool.
        affine s ==> (bounded s <=> s = {} \/ ?a. s = {a})"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [BOUNDED_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N") MP_TAC) THEN
    GEOM_ORIGIN_TAC (← q r"b:real^N") THEN SIMP_TAC [AFFINE_EQ_SUBSPACE] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [SUBSPACE_BOUNDED_EQ_TRIVIAL] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SUBSPACE_0) THEN SET_TAC [])

  let AFFINE_BOUNDED_EQ_LOWDIM ← prove
   r"!s:real^N->bool.
        affine s ==> (bounded s <=> aff_dim s <= &0)"
   (SIMP_TAC [AFF_DIM_GE, ← INT_ARITH
     (← q r"--(&1):int <= x ==> (x <= &0 <=> x = --(&1) \/ x = &0)")] THEN
    SIMP_TAC [AFF_DIM_EQ_0, AFF_DIM_EQ_MINUS1, AFFINE_BOUNDED_EQ_TRIVIAL])

  let COLLINEAR_AFF_DIM ← prove
   r"!s:real^N->bool. collinear s <=> aff_dim s <= &1"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [COLLINEAR_AFFINE_HULL, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN STRIP_TAC THEN
      MATCH_MP_TAC INT_LE_TRANS THEN EXISTS_TAC (← q r"aff_dim{u:real^N,v}") THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [AFF_DIM_SUBSET, AFF_DIM_AFFINE_HULL],
        MATCH_MP_TAC INT_LE_TRANS THEN
        EXISTS_TAC (← q r"&(CARD{u:real^N,v}) - &1:int") THEN
        SIMP_TAC [AFF_DIM_LE_CARD, FINITE_INSERT, FINITE_EMPTY] THEN
        REWRITE_TAC [← INT_ARITH (← q r"x - &1:int <= &1 <=> x <= &2"), INT_OF_NUM_LE] THEN
        SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN ARITH_TAC],
      ONCE_REWRITE_TAC [← GSYM COLLINEAR_AFFINE_HULL_COLLINEAR,
                        ← GSYM AFF_DIM_AFFINE_HULL] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") AFFINE_BASIS_EXISTS) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool") (STRIP_ASSUME_TAC o GSYM)) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [AFFINE_INDEPENDENT_IFF_CARD]) THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [COLLINEAR_AFFINE_HULL_COLLINEAR,
                       AFF_DIM_AFFINE_HULL] THEN
      REWRITE_TAC [← INT_ARITH (← q r"x - &1:int <= &1 <=> x <= &2"), INT_OF_NUM_LE] THEN
      ASM_SIMP_TAC [COLLINEAR_SMALL]])

  let COPLANAR_AFF_DIM ← prove
   r"!s:real^N->bool. coplanar s <=> aff_dim s <= &2"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [coplanar, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N", ← q r"c:real^N"] THEN
      DISCH_TAC THEN
      TRANS_TAC INT_LE_TRANS (← q r"aff_dim(affine hull {a:real^N,b,c})") THEN
      ASM_SIMP_TAC [AFF_DIM_SUBSET] THEN
      REWRITE_TAC [AFF_DIM_AFFINE_HULL, AFF_DIM_INSERT] THEN
      REWRITE_TAC [AFFINE_HULL_EMPTY, NOT_IN_EMPTY, AFF_DIM_EMPTY] THEN
      INT_ARITH_TAC,
      DISCH_TAC THEN ONCE_REWRITE_TAC [← GSYM COPLANAR_AFFINE_HULL_COPLANAR] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") AFF_DIM) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool") MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 (SUBST1_TAC o SYM) MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 (ASSUME_TAC o MATCH_MP
        AFFINE_INDEPENDENT_IMP_FINITE) SUBST_ALL_TAC) THEN
      REWRITE_TAC [COPLANAR_AFFINE_HULL_COPLANAR] THEN
      MATCH_MP_TAC COPLANAR_SMALL THEN
      ASM_REWRITE_TAC [← GSYM INT_OF_NUM_LE] THEN ASM_INT_ARITH_TAC])

  let HOMEOMORPHIC_AFFINE_SETS ← prove
   r"!s:real^M->bool t:real^N->bool.
        affine s /\ affine t /\ aff_dim s = aff_dim t ==> s homeomorphic t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, HOMEOMORPHIC_EMPTY] THEN
    POP_ASSUM MP_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, HOMEOMORPHIC_EMPTY] THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC
     [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^N"] THEN
    GEOM_ORIGIN_TAC (← q r"a:real^M") THEN GEOM_ORIGIN_TAC (← q r"b:real^N") THEN
    SIMP_TAC [AFFINE_EQ_SUBSPACE, AFF_DIM_DIM_0, HULL_INC, INT_OF_NUM_EQ] THEN
    MESON_TAC [HOMEOMORPHIC_SUBSPACES])

  return { CONVEX_AND_AFFINE_INTER_OPEN, AFFINE_HULL_CONVEX_INTER_OPEN_IN,
           AFFINE_HULL_AFFINE_INTER_OPEN_IN, AFFINE_HULL_OPEN_IN_CONVEX, AFFINE_HULL_OPEN_IN,
           AFFINE_HULL_OPEN_IN_AFFINE, AFFINE_HULL_OPEN, AFFINE_HULL_NONEMPTY_INTERIOR,
           AFF_DIM_OPEN, AFF_DIM_NONEMPTY_INTERIOR, EMPTY_INTERIOR_AFF_DIM, SPAN_OPEN,
           DIM_OPEN, AFF_DIM_INSERT, AFF_DIM_DIM, AFF_DIM_CONIC_HULL_DIM,
           AFFINE_BOUNDED_EQ_TRIVIAL, AFFINE_BOUNDED_EQ_LOWDIM, COLLINEAR_AFF_DIM,
           COPLANAR_AFF_DIM, HOMEOMORPHIC_AFFINE_SETS }

/- ------------------------------------------------------------------------- -/
/- Affine dimension, continued.  (convex.ml 4881-5197)                       -/
/- ------------------------------------------------------------------------- -/

structure ADE where
  AFF_DIM_OPEN_IN : thm
  DIM_OPEN_IN : thm
  AFF_DIM_CONVEX_INTER_NONEMPTY_INTERIOR : thm
  AFF_DIM_CONVEX_INTER_OPEN : thm
  AFF_DIM_NONEMPTY_INTERIOR_OF : thm
  EMPTY_INTERIOR_OF_AFF_DIM : thm
  AFFINE_HULL_HALFSPACE_LT : thm
  AFFINE_HULL_HALFSPACE_LE : thm
  AFFINE_HULL_HALFSPACE_GT : thm
  AFFINE_HULL_HALFSPACE_GE : thm
  AFF_DIM_HALFSPACE_LT : thm
  AFF_DIM_HALFSPACE_LE : thm
  AFF_DIM_HALFSPACE_GT : thm
  AFF_DIM_HALFSPACE_GE : thm
  CHOOSE_AFFINE_SUBSET : thm
  NONEMPTY_AFFINE_EXISTS : thm
  AFFINE_EXISTS : thm
  AFF_DIM_CONIC_HULL : thm
  AFF_DIM_PCROSS : thm
  AFF_DIM_UNION : thm
  COPLANAR_INTERSECTING_LINES : thm
  ISOMETRIC_HOMEOMORPHISM_AFFINE : thm
  deriving Inhabited

@[nospecialize]
def setupADE [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BCLH : CLH) (BAFI : AFI)
    (BADA : ADA) (BADB : ADB) (BADC : ADC) (BADD : ADD) : ExceptT String IO ADE := do
  -- @@SCOPE BEGIN
  let { ASM_INT_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH, INT_ARITH_TAC,
        MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH, NORM_ARITH,
        GEOM_ORIGIN_TAC, .. } := D
  let { CARD_IMAGE_INJ, CONJ_ASSOC, EMPTY_SUBSET, EQ_TRANS, EXISTS_PASTECART,
        EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, FORALL_PASTECART, HAS_SIZE, IMAGE_o, IMP_CONJ,
        INSERT_SUBSET, INTER_SUBSET, INT_EQ_IMP_LE, INT_LE_ANTISYM, INT_LE_TRANS,
        INT_OF_NUM_ADD, INT_OF_NUM_EQ, INT_OF_NUM_EXISTS, INT_OF_NUM_LE, .. } := D.core2
  let { IN_IMAGE, IN_INSERT, IN_INTER, IN_UNION, LEFT_IMP_EXISTS_THM, LE_ANTISYM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, PASTECART_INJ, PASTECART_IN_PCROSS, .. } :=
    D.core3
  let { REAL_LE_NEG2, REAL_LT_IMP_NZ, .. } := D.core4
  let { RIGHT_AND_EXISTS_THM, RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.core5
  let { o_DEF, real_ge, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { CHOOSE_SUBSPACE_OF_SUBSPACE, DIM_PCROSS_STRONG, DIM_SUBSET, DIM_UNION_INTER, DOT_LNEG,
        DOT_LZERO, .. } := D.vec1
  let { HALFSPACE_EQ_EMPTY_GT, HALFSPACE_EQ_EMPTY_LT, INDEPENDENT_CARD_LE_DIM,
        INDEPENDENT_INJECTIVE_IMAGE, ISOMETRIES_SUBSPACES, LINEAR_SCALING, LINEAR_SUB, .. } :=
    D.vec2
  let { NORM_MUL, ORTHONORMAL_BASIS_SUBSPACE, PASTECART_ADD, PASTECART_VEC, SPAN_OF_SUBSPACE,
        SUBSPACE_0, SUBSPACE_EXISTS, SUBSPACE_MUL, SUBSPACE_SUB, .. } := D.vec3
  let { VECTOR_MUL_LCANCEL, VECTOR_NEG_EQ_0, dist, .. } := D.vec4
  let { INTERIOR_OF_RESTRICT, INTERIOR_OF_SUBSET, OPEN_IN_IMP_SUBSET, OPEN_IN_INTERIOR_OF, .. } :=
    D.met
  let { CLOSURE_HALFSPACE_LT, .. } := D.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        HOMEOMORPHIC_EMPTY, .. } := D.top3
  let { HOMEOMORPHISM, IN_CBALL_0, LINEAR_CONTINUOUS_ON, OPEN_CONTAINS_CBALL,
        OPEN_HALFSPACE_GT, .. } := D.top4
  let { OPEN_HALFSPACE_LT, OPEN_IN_OPEN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, homeomorphic, .. } :=
    D.top5
  let { AFFINE_EMPTY, AFFINE_AFFINE_HULL, AFFINE_HULL_UNIV, .. } := BAFF
  let { AFFINE_HULL_EMPTY, AFFINE_HULL_EQ_EMPTY, .. } := BAFS
  let { SUBSPACE_IMP_AFFINE, AFFINE_EQ_SUBSPACE, AFFINE_HULL_CLOSURE, .. } := BCLH
  let { AFFINE_TRANSLATION_SUBSPACE, .. } := BAFI
  let { AFF_DIM_EMPTY, AFF_DIM_AFFINE_HULL, AFF_DIM_TRANSLATION_EQ, .. } := BADA
  let { AFFINE_HULL_CONIC_HULL, AFF_DIM_DIM_0, AFF_DIM_DIM_SUBSPACE, AFF_DIM_SUBSET,
        AFF_DIM_LE_DIM, .. } := BADB
  let { AFF_DIM_EQ_MINUS1, AFF_DIM_POS_LE, AFF_DIM_UNIV,
        AFFINE_HULL_CONVEX_INTER_NONEMPTY_INTERIOR, AFFINE_HULL_CONVEX_INTER_OPEN, .. } := BADC
  let { AFFINE_HULL_OPEN, AFF_DIM_INSERT, COLLINEAR_AFF_DIM, COPLANAR_AFF_DIM, .. } := BADD
  -- @@SCOPE END

  let AFF_DIM_OPEN_IN ← prove
   r"!s t:real^N->bool.
        ~(s = {}) /\ open_in (subtopology euclidean t) s /\ affine t
        ==> aff_dim s = aff_dim t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, ← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real^N") THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    SUBGOAL_THEN (← q r"(vec 0:real^N) IN t") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [AFF_DIM_DIM_0, HULL_INC, AFFINE_EQ_SUBSPACE] THEN
    DISCH_TAC THEN AP_TERM_TAC THEN
    ASM_SIMP_TAC [← GSYM LE_ANTISYM, DIM_SUBSET] THEN
    SUBGOAL_THEN (← q r"?e. &0 < e /\ cball(vec 0:real^N,e) INTER t SUBSET s")
    MP_TAC THENL
     [FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o
        GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
      ASM SET_TAC [],
      REWRITE_TAC [SUBSET, IN_INTER, IN_CBALL_0] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC)] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ORTHONORMAL_BASIS_SUBSPACE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"IMAGE (\x:real^N. e % x) b"]
     INDEPENDENT_CARD_LE_DIM) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
    ASM_SIMP_TAC [CARD_IMAGE_INJ, VECTOR_MUL_LCANCEL, REAL_LT_IMP_NZ] THEN
    ANTS_TAC THENL [REWRITE_TAC [SUBSET], MESON_TAC []] THEN CONJ_TAC THENL
     [REWRITE_TAC [FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [NORM_MUL] THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, MATCH_MP_TAC SUBSPACE_MUL] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC INDEPENDENT_INJECTIVE_IMAGE THEN
      ASM_SIMP_TAC [VECTOR_MUL_LCANCEL, REAL_LT_IMP_NZ, LINEAR_SCALING]])

  let DIM_OPEN_IN ← prove
   r"!s t:real^N->bool.
        ~(s = {}) /\ open_in (subtopology euclidean t) s /\ subspace t
        ==> dim s = dim t"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    ASM_SIMP_TAC [← GSYM LE_ANTISYM, DIM_SUBSET] THEN
    REWRITE_TAC [← GSYM INT_OF_NUM_LE] THEN
    MATCH_MP_TAC INT_LE_TRANS THEN EXISTS_TAC (← q r"aff_dim(s:real^N->bool)") THEN
    REWRITE_TAC [AFF_DIM_LE_DIM] THEN ASM_SIMP_TAC [← GSYM AFF_DIM_DIM_SUBSPACE] THEN
    MATCH_MP_TAC INT_EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC AFF_DIM_OPEN_IN THEN ASM_SIMP_TAC [SUBSPACE_IMP_AFFINE])

  let AFF_DIM_CONVEX_INTER_NONEMPTY_INTERIOR ← prove
   r"!s t:real^N->bool.
        convex s /\ ~(s INTER interior t = {})
        ==> aff_dim(s INTER t) = aff_dim s"
   (ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    ASM_SIMP_TAC [AFFINE_HULL_CONVEX_INTER_NONEMPTY_INTERIOR] THEN
    REWRITE_TAC [AFF_DIM_AFFINE_HULL])

  let AFF_DIM_CONVEX_INTER_OPEN ← prove
   r"!s t:real^N->bool.
        convex s /\ open t /\ ~(s INTER t = {})
        ==> aff_dim(s INTER t) = aff_dim s"
   (ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    ASM_SIMP_TAC [AFFINE_HULL_CONVEX_INTER_OPEN] THEN
    REWRITE_TAC [AFF_DIM_AFFINE_HULL])

  let AFF_DIM_NONEMPTY_INTERIOR_OF ← prove
   r"!u s:real^N->bool.
        s SUBSET u /\ affine u /\
        ~((subtopology euclidean u) interior_of s = {})
        ==> aff_dim s = aff_dim u"
   (SIMP_TAC [← GSYM INT_LE_ANTISYM, AFF_DIM_SUBSET] THEN REPEAT STRIP_TAC THEN
    TRANS_TAC INT_LE_TRANS
     (← q r"aff_dim((subtopology euclidean u) interior_of s:real^N->bool)") THEN
    SIMP_TAC [AFF_DIM_SUBSET, INTERIOR_OF_SUBSET] THEN
    MATCH_MP_TAC INT_EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC AFF_DIM_OPEN_IN THEN ASM_REWRITE_TAC [OPEN_IN_INTERIOR_OF])

  let EMPTY_INTERIOR_OF_AFF_DIM ← prove
   r"!u s:real^N->bool.
        affine u /\ aff_dim s < aff_dim u
        ==> (subtopology euclidean u) interior_of s = {}"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [INTERIOR_OF_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"u INTER s:real^N->bool"]
          AFF_DIM_NONEMPTY_INTERIOR_OF) THEN
    ASM_REWRITE_TAC [INTER_SUBSET] THEN
    MATCH_MP_TAC (← TAUT (← q r"~q ==> (~p ==> q) ==> p")) THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
     (← q r"s:int < u ==> t <= s ==> ~(t = u)"))) THEN
    SIMP_TAC [AFF_DIM_SUBSET, INTER_SUBSET])

  let AFFINE_HULL_HALFSPACE_LT ← prove
   r"!a b. affine hull {x | a dot x < b} =
         if a = vec 0 /\ b <= &0 then {} else (:real^N)"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [AFFINE_HULL_EQ_EMPTY, HALFSPACE_EQ_EMPTY_LT,
                  AFFINE_HULL_OPEN, OPEN_HALFSPACE_LT])

  let AFFINE_HULL_HALFSPACE_LE ← prove
   r"!a b. affine hull {x | a dot x <= b} =
         if a = vec 0 /\ b < &0 then {} else (:real^N)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = vec 0") THENL
     [ASM_SIMP_TAC [DOT_LZERO, ← SET_RULE (← q r"{x | p} = if p then UNIV else {}")] THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [AFFINE_HULL_EMPTY, AFFINE_HULL_UNIV] THEN
      COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ASM_SIMP_TAC [← GSYM CLOSURE_HALFSPACE_LT, AFFINE_HULL_CLOSURE] THEN
      ASM_REWRITE_TAC [AFFINE_HULL_HALFSPACE_LT]])

  let AFFINE_HULL_HALFSPACE_GT ← prove
   r"!a b. affine hull {x | a dot x > b} =
         if a = vec 0 /\ b >= &0 then {} else (:real^N)"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [AFFINE_HULL_EQ_EMPTY, HALFSPACE_EQ_EMPTY_GT,
                  AFFINE_HULL_OPEN, OPEN_HALFSPACE_GT])

  let AFFINE_HULL_HALFSPACE_GE ← prove
   r"!a b. affine hull {x | a dot x >= b} =
         if a = vec 0 /\ b > &0 then {} else (:real^N)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"--a:real^N", ← q r"--b:real"] AFFINE_HULL_HALFSPACE_LE) THEN
    SIMP_TAC [real_ge, DOT_LNEG, REAL_LE_NEG2, VECTOR_NEG_EQ_0] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"--b < &0 <=> b > &0")])

  let AFF_DIM_HALFSPACE_LT ← prove
   r"!a:real^N b.
        aff_dim {x | a dot x < b} =
        if a = vec 0 /\ b <= &0 then --(&1) else &(dimindex(:N))"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    SIMP_TAC [AFFINE_HULL_HALFSPACE_LT] THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [AFF_DIM_EMPTY, AFF_DIM_UNIV])

  let AFF_DIM_HALFSPACE_LE ← prove
   r"!a:real^N b.
        aff_dim {x | a dot x <= b} =
        if a = vec 0 /\ b < &0 then --(&1) else &(dimindex(:N))"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    SIMP_TAC [AFFINE_HULL_HALFSPACE_LE] THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [AFF_DIM_EMPTY, AFF_DIM_UNIV])

  let AFF_DIM_HALFSPACE_GT ← prove
   r"!a:real^N b.
        aff_dim {x | a dot x > b} =
        if a = vec 0 /\ b >= &0 then --(&1) else &(dimindex(:N))"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    SIMP_TAC [AFFINE_HULL_HALFSPACE_GT] THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [AFF_DIM_EMPTY, AFF_DIM_UNIV])

  let AFF_DIM_HALFSPACE_GE ← prove
   r"!a:real^N b.
        aff_dim {x | a dot x >= b} =
        if a = vec 0 /\ b > &0 then --(&1) else &(dimindex(:N))"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    SIMP_TAC [AFFINE_HULL_HALFSPACE_GE] THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [AFF_DIM_EMPTY, AFF_DIM_UNIV])

  let CHOOSE_AFFINE_SUBSET ← prove
   r"!s:real^N->bool d.
        affine s /\ --(&1) <= d /\ d <= aff_dim s
        ==> ?t. affine t /\ t SUBSET s /\ aff_dim t = d"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"d:int = --(&1)") THENL
     [STRIP_TAC THEN EXISTS_TAC (← q r"{}:real^N->bool") THEN
      ASM_REWRITE_TAC [EMPTY_SUBSET, AFFINE_EMPTY, AFF_DIM_EMPTY],
      ASM_SIMP_TAC [← INT_ARITH
       (← q r"~(d:int = --(&1)) ==> (--(&1) <= d <=> &0 <= d)")] THEN
      POP_ASSUM (K ALL_TAC)] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [AFF_DIM_EMPTY] THEN INT_ARITH_TAC,
      POP_ASSUM MP_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM MEMBER_NOT_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") MP_TAC) THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    SIMP_TAC [IMP_CONJ, AFF_DIM_DIM_SUBSPACE, AFFINE_EQ_SUBSPACE] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [← GSYM INT_OF_NUM_EXISTS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") SUBST1_TAC) THEN
    REWRITE_TAC [INT_OF_NUM_LE] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"n:num"]
          CHOOSE_SUBSPACE_OF_SUBSPACE) THEN
    ASM_SIMP_TAC [SPAN_OF_SUBSPACE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
    ASM_SIMP_TAC [AFF_DIM_DIM_SUBSPACE, SUBSPACE_IMP_AFFINE])

  let NONEMPTY_AFFINE_EXISTS ← prove
   r"!n a:real^N.
        &0 <= n /\ n <= &(dimindex(:N))
        ==> ?s. affine s /\ a IN s /\ aff_dim s = n"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    X_GEN_TAC (← q r"n:int") THEN REWRITE_TAC [IMP_CONJ, ← GSYM INT_OF_NUM_EXISTS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") SUBST1_TAC) THEN
    REWRITE_TAC [INT_OF_NUM_LE] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?s:real^N->bool. subspace s /\ dim s = m") MP_TAC THENL
     [ASM_SIMP_TAC [SUBSPACE_EXISTS], MATCH_MP_TAC MONO_EXISTS] THEN
    SIMP_TAC [AFF_DIM_DIM_SUBSPACE, SUBSPACE_IMP_AFFINE, SUBSPACE_0])

  let AFFINE_EXISTS ← prove
   r"!n. -- &1 <= n /\ n <= &(dimindex(:N))
       ==> ?s:real^N->bool. affine s /\ aff_dim s = n"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"&0:int <= n") THENL
     [ASM_MESON_TAC [NONEMPTY_AFFINE_EXISTS], ALL_TAC] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"{}:real^N->bool") THEN
    REWRITE_TAC [AFFINE_EMPTY, AFF_DIM_EMPTY] THEN
    ASM_INT_ARITH_TAC)

  let AFF_DIM_CONIC_HULL ← prove
   r"!s:real^N->bool.
        aff_dim(conic hull s) =
        if s = {} \/ vec 0 IN affine hull s
        then aff_dim s else aff_dim s + &1"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM AFF_DIM_AFFINE_HULL] THEN
    REWRITE_TAC [AFFINE_HULL_CONIC_HULL] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [AFFINE_HULL_EMPTY, NOT_IN_EMPTY] THEN
    REWRITE_TAC [AFF_DIM_AFFINE_HULL, AFF_DIM_INSERT])

  let AFF_DIM_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        ~(s = {}) /\ ~(t = {})
        ==> aff_dim(s PCROSS t) = aff_dim s + aff_dim t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^N"] THEN
    GEOM_ORIGIN_TAC (← q r"a:real^M") THEN GEOM_ORIGIN_TAC (← q r"b:real^N") THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [AFF_DIM_DIM_0, HULL_INC] THEN
    ASM_REWRITE_TAC [INT_OF_NUM_ADD] THEN
    W (MP_TAC o PART_MATCH (rand o rand)
       DIM_PCROSS_STRONG o rand o rand o snd) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    TRANS_TAC EQ_TRANS
     (← q r"aff_dim(IMAGE (\z. pastecart (a:real^M) (b:real^N) + z) (s PCROSS t))") THEN
    CONJ_TAC THENL
     [AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_IMAGE, FORALL_PASTECART, PASTECART_IN_PCROSS,
                   EXISTS_PASTECART, PASTECART_ADD, PASTECART_INJ] THEN
      MESON_TAC [],
      REWRITE_TAC [AFF_DIM_TRANSLATION_EQ] THEN
      MATCH_MP_TAC AFF_DIM_DIM_0 THEN MATCH_MP_TAC HULL_INC THEN
      ASM_REWRITE_TAC [← GSYM PASTECART_VEC, PASTECART_IN_PCROSS]])

  let AFF_DIM_UNION ← prove
   r"!s t:real^N->bool.
        affine s /\ affine t /\ ~(s INTER t = {})
        ==> aff_dim(s UNION t) =
            (aff_dim s + aff_dim t) - aff_dim(s INTER t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:real^N") THEN GEOM_ORIGIN_TAC (← q r"z:real^N") THEN
    REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    REWRITE_TAC [IN_INTER] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    ASM_SIMP_TAC [AFFINE_EQ_SUBSPACE, AFF_DIM_DIM_0,
                  HULL_INC, IN_INTER, IN_UNION] THEN
    REWRITE_TAC [← INT_ARITH (← q r"a:int = b - c <=> a + c = b")] THEN
    REWRITE_TAC [INT_OF_NUM_ADD, INT_OF_NUM_EQ, DIM_UNION_INTER])

  let COPLANAR_INTERSECTING_LINES ← prove
   r"!a b c d z:real^N.
        collinear {a,z,b} /\ collinear {c,z,d} ==> coplanar {z,a,b,c,d}"
   (REWRITE_TAC [COPLANAR_AFF_DIM] THEN REPEAT STRIP_TAC THEN
    TRANS_TAC INT_LE_TRANS
     (← q r"aff_dim(affine hull {a:real^N,z,b} UNION affine hull {c,z,d})") THEN
    SIMP_TAC [AFF_DIM_SUBSET, INSERT_SUBSET, EMPTY_SUBSET, IN_UNION,
              HULL_INC, IN_INSERT] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) AFF_DIM_UNION o lhand o snd) THEN
    REWRITE_TAC [AFFINE_AFFINE_HULL, AFF_DIM_AFFINE_HULL] THEN
    SUBGOAL_THEN
     (← q r"z IN affine hull {a:real^N,z,b} /\ z IN affine hull {c,z,d}")
    STRIP_ASSUME_TAC THENL [SIMP_TAC [HULL_INC, IN_INSERT], ALL_TAC] THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC (← INT_ARITH
     (← q r"a:int <= &1 /\ b <= &1 /\ &0 <= c ==> (a + b) - c <= &2")) THEN
    ASM_REWRITE_TAC [← GSYM COLLINEAR_AFF_DIM, AFF_DIM_POS_LE] THEN ASM SET_TAC [])

  let ISOMETRIC_HOMEOMORPHISM_AFFINE ← prove
   r"!s:real^M->bool t:real^N->bool.
        affine s /\ affine t /\ aff_dim s = aff_dim t
        ==> ?f g. homeomorphism (s,t) (f,g) /\
                  (!x y. x IN s /\ y IN s ==> dist(f x,f y) = dist(x,y)) /\
                  (!x y. x IN t /\ y IN t ==> dist(g x,g y) = dist(x,y))"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, NOT_IN_EMPTY] THEN
      REWRITE_TAC [HOMEOMORPHIC_EMPTY, ← GSYM homeomorphic],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THENL
     [ASM_MESON_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1], STRIP_TAC] THEN
    MP_TAC (← ISPEC (← q r"t:real^N->bool") AFFINE_TRANSLATION_SUBSPACE) THEN
    MP_TAC (← ISPEC (← q r"s:real^M->bool") AFFINE_TRANSLATION_SUBSPACE) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"s':real^M->bool"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"t':real^N->bool"] THEN STRIP_TAC THEN
    UNDISCH_TAC (← q r"aff_dim(s:real^M->bool) = aff_dim(t:real^N->bool)") THEN
    ASM_REWRITE_TAC [AFF_DIM_TRANSLATION_EQ] THEN
    ASM_SIMP_TAC [AFF_DIM_DIM_SUBSPACE, INT_OF_NUM_EQ] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s':real^M->bool", ← q r"t':real^N->bool"]
      ISOMETRIES_SUBSPACES) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"\x. b + (f:real^M->real^N) (--a + x)") THEN
    EXISTS_TAC (← q r"\x. a + (g:real^N->real^M) (--b + x)") THEN
    REWRITE_TAC [HOMEOMORPHISM, FORALL_IN_IMAGE_2, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"--a + a + x:real^N = x")] THEN
    ASM_SIMP_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
    REWRITE_TAC [← NORM_ARITH (← q r"dist(a + x:real^N,a + y) = dist(x,y)")] THEN
    ASM_SIMP_TAC [dist, ← GSYM LINEAR_SUB, SUBSPACE_SUB] THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THEN
    (CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []]) THEN
    MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN
    MATCH_MP_TAC CONTINUOUS_ON_ADD THEN
    REWRITE_TAC [CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID])

  return { AFF_DIM_OPEN_IN, DIM_OPEN_IN, AFF_DIM_CONVEX_INTER_NONEMPTY_INTERIOR,
           AFF_DIM_CONVEX_INTER_OPEN, AFF_DIM_NONEMPTY_INTERIOR_OF, EMPTY_INTERIOR_OF_AFF_DIM,
           AFFINE_HULL_HALFSPACE_LT, AFFINE_HULL_HALFSPACE_LE, AFFINE_HULL_HALFSPACE_GT,
           AFFINE_HULL_HALFSPACE_GE, AFF_DIM_HALFSPACE_LT, AFF_DIM_HALFSPACE_LE,
           AFF_DIM_HALFSPACE_GT, AFF_DIM_HALFSPACE_GE, CHOOSE_AFFINE_SUBSET,
           NONEMPTY_AFFINE_EXISTS, AFFINE_EXISTS, AFF_DIM_CONIC_HULL, AFF_DIM_PCROSS,
           AFF_DIM_UNION, COPLANAR_INTERSECTING_LINES, ISOMETRIC_HOMEOMORPHISM_AFFINE }

/- ------------------------------------------------------------------------- -/
/- Existence of a rigid transform between congruent sets.                    -/
/- (convex.ml 5201-5409)                                                     -/
/- ------------------------------------------------------------------------- -/

structure RGD where
  RIGID_TRANSFORMATION_BETWEEN_CONGRUENT_SETS : thm
  RIGID_TRANSFORMATION_BETWEEN_CONGRUENT_SETS_STRONG : thm
  RIGID_TRANSFORMATION_BETWEEN_3 : thm
  RIGID_TRANSFORMATION_BETWEEN_2 : thm
  deriving Inhabited

@[nospecialize]
def setupRGD [HolBase] (D : ConvexDeps) (BAFF : AFF) (BADA : ADA) (BADC : ADC) :
    ExceptT String IO RGD := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_ARITH, REAL_ARITH, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { CART_EQ, DIMINDEX_1, DIMINDEX_FINITE_SUM, DIMINDEX_GE_1, EQ_TRANS,
        FINITE_INDEX_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_SUBSET, IMAGE_o, IMP_CONJ, IMP_IMP,
        INT_LE_RADD, INT_OF_NUM_ADD, INT_OF_NUM_LE, .. } := D.core2
  let { IN_IMAGE, IN_NUMSEG, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, LE_REFL, LE_TRANS,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IMP, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_SUB_LDISTRIB, RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM_EQ, .. } := D.core5
  let { SUM_SUB_NUMSEG, o_THM, pairwise, .. } := D.core6
  let { HULL_INC, HULL_MONO, .. } := D.misc
  let { DIST_EQ_0, DIST_REFL, DIST_SYM, DOT_NORM_SUB, .. } := D.vec1
  let { LINEAR_SUB, MATRIX_EQUAL_COLUMNS, MATRIX_MUL_ASSOC, MATRIX_MUL_RID,
        MATRIX_OF_MATRIX_VECTOR_MUL, MATRIX_TRANSP_MUL, MATRIX_VECTOR_MUL_LINEAR, MATRIX_WORKS,
        NORM_EQ, .. } := D.vec2
  let { TRANSP_TRANSP, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT, column, dist, dot, matrix_mul,
        matrix_vector_mul, orthogonal, symmetric_matrix, .. } := D.vec4
  let { MATRIX_MUL_LTRANSP_DOT_COLUMN, ORTHOGONAL_TRANSFORMATION,
        ORTHOGONAL_TRANSFORMATION_BETWEEN_ORTHOGONAL_SETS, ORTHOGONAL_TRANSFORMATION_ID,
        ORTHOGONAL_TRANSFORMATION_ISOMETRY, ORTHOGONAL_TRANSFORMATION_MATRIX, orthogonal_matrix,
        orthogonal_transformation, .. } := D.det
  let { SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT, .. } := D.top5
  let { SAME_DISTANCES_TO_AFFINE_HULL, .. } := BAFF
  let { AFFINE_BASIS_EXISTS, .. } := BADA
  let { AFF_DIM_LE_UNIV, AFFINE_INDEPENDENT_IFF_CARD, .. } := BADC
  -- @@SCOPE END

  let RIGID_TRANSFORMATION_BETWEEN_CONGRUENT_SETS ← do
    let lemma ← prove
     r"!x:(real^N)^M y:(real^N)^M.
            (!i j. 1 <= i /\ i <= dimindex(:M) /\
                   1 <= j /\ j <= dimindex(:M)
                   ==> dist(x$i,x$j) = dist(y$i,y$j))
            ==> ?a f. orthogonal_transformation f /\
                      !i. 1 <= i /\ i <= dimindex(:M)
                          ==> y$i = a + f(x$i)"
     (REPEAT STRIP_TAC THEN
      ABBREV_TAC (← q r"(X:real^M^N) = lambda i j. (x:real^N^M)$j$i - x$1$i") THEN
      ABBREV_TAC (← q r"(Y:real^M^N) = lambda i j. (y:real^N^M)$j$i - y$1$i") THEN
      SUBGOAL_THEN (← q r"transp(X:real^M^N) ** X = transp(Y:real^M^N) ** Y")
      ASSUME_TAC THENL
       [REWRITE_TAC [MATRIX_MUL_LTRANSP_DOT_COLUMN] THEN
        MAP_EVERY EXPAND_TAC ["X", "Y"] THEN
        SIMP_TAC [CART_EQ, column, LAMBDA_BETA, dot] THEN
        REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT, ← GSYM dot] THEN
        REWRITE_TAC [DOT_NORM_SUB, ← VECTOR_ARITH
         (← q r"(x - a) - (y - a):real^N = x - y")] THEN
        ASM_SIMP_TAC [← GSYM dist, DIMINDEX_GE_1, LE_REFL],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?M:real^N^N. orthogonal_matrix M /\ (Y:real^M^N) = M ** (X:real^M^N)")
      (CHOOSE_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THENL
       [ALL_TAC,
        GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [CART_EQ] THEN
        MAP_EVERY EXPAND_TAC ["X", "Y"] THEN
        SIMP_TAC [LAMBDA_BETA, matrix_mul] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"x - y:real = z <=> x = y + z")] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"(y:real^N^M)$1 - (M:real^N^N) ** (x:real^N^M)$1") THEN
        EXISTS_TAC (← q r"\x:real^N. (M:real^N^N) ** x") THEN
        ASM_SIMP_TAC [ORTHOGONAL_TRANSFORMATION_MATRIX,
                      MATRIX_OF_MATRIX_VECTOR_MUL, MATRIX_VECTOR_MUL_LINEAR] THEN
        SIMP_TAC [CART_EQ, matrix_vector_mul, LAMBDA_BETA,
                  VECTOR_ADD_COMPONENT] THEN
        ASM_SIMP_TAC [REAL_SUB_LDISTRIB, SUM_SUB_NUMSEG] THEN
        REWRITE_TAC [VECTOR_SUB_COMPONENT, ← REAL_ARITH
         (← q r"a + y - b:real = a - z + y <=> z = b")] THEN
        SIMP_TAC [LAMBDA_BETA]] THEN
      MP_TAC (← ISPEC (← q r"transp(X:real^M^N) ** X")
        SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT) THEN
      REWRITE_TAC [symmetric_matrix] THEN
      REWRITE_TAC [MATRIX_TRANSP_MUL, TRANSP_TRANSP, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"P:real^M^M", ← q r"d:num->real"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (fun th => MP_TAC th THEN ASM_REWRITE_TAC [] THEN MP_TAC th) THEN
      REWRITE_TAC [MATRIX_MUL_ASSOC, ← GSYM MATRIX_TRANSP_MUL] THEN
      REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, LEFT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [IMP_IMP] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [CART_EQ] THEN
      SIMP_TAC [MATRIX_MUL_LTRANSP_DOT_COLUMN, LAMBDA_BETA] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"\i. column i ((X:real^M^N) ** (P:real^M^M))",
                        ← q r"\i. column i ((Y:real^M^N) ** (P:real^M^M))",
                        ← q r"1..dimindex(:M)"]
                    ORTHOGONAL_TRANSFORMATION_BETWEEN_ORTHOGONAL_SETS) THEN
      REWRITE_TAC [IN_NUMSEG] THEN ANTS_TAC THENL
       [ASM_SIMP_TAC [pairwise, IN_NUMSEG, NORM_EQ, orthogonal], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:real^N->real^N") (STRIP_ASSUME_TAC o GSYM)) THEN
      EXISTS_TAC (← q r"matrix(f:real^N->real^N)") THEN CONJ_TAC THENL
       [ASM_MESON_TAC [ORTHOGONAL_TRANSFORMATION_MATRIX], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!M:real^M^N. M = M ** (P:real^M^M) ** transp P")
       (fun th => GEN_REWRITE_TAC BINOP_CONV [th])
      THENL
       [ASM_MESON_TAC [orthogonal_matrix, MATRIX_MUL_RID],
        REWRITE_TAC [MATRIX_MUL_ASSOC] THEN AP_THM_TAC THEN AP_TERM_TAC] THEN
      REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
      ASM_SIMP_TAC [MATRIX_EQUAL_COLUMNS] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [orthogonal_transformation]) THEN
      DISCH_THEN (ASSUME_TAC o GSYM o MATCH_MP MATRIX_WORKS o CONJUNCT1) THEN
      ASM_REWRITE_TAC [] THEN
      SIMP_TAC [CART_EQ, matrix_vector_mul, column, LAMBDA_BETA] THEN
      X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [matrix_mul] THEN
      ASM_SIMP_TAC [LAMBDA_BETA])
    prove
     r"!x:A->real^N y:A->real^N s.
          (!i j. i IN s /\ j IN s ==> dist(x i,x j) = dist(y i,y j))
          ==> ?a f. orthogonal_transformation f /\
                    !i. i IN s ==> y i = a + f(x i)"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
       [REPEAT STRIP_TAC THEN
        MAP_EVERY EXISTS_TAC [← q r"vec 0:real^N", ← q r"\x:real^N. x"] THEN
        ASM_REWRITE_TAC [NOT_IN_EMPTY, ORTHOGONAL_TRANSFORMATION_ID],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"m:A")) THEN DISCH_TAC] THEN
      SUBGOAL_THEN
        (← q r"?r. IMAGE r (1..dimindex(:(N,1)finite_sum)) SUBSET s /\
             affine hull (IMAGE (y o r) (1..dimindex(:(N,1)finite_sum))) =
             affine hull (IMAGE (y:A->real^N) s)")
      MP_TAC THENL
       [REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
        SIMP_TAC [IMAGE_o, ← TAUT (← q r"p /\ q <=> ~(p ==> ~q)"),
                  HULL_MONO, IMAGE_SUBSET] THEN REWRITE_TAC [NOT_IMP] THEN
        MP_TAC (← ISPEC (← q r"IMAGE (y:A->real^N) s") AFFINE_BASIS_EXISTS) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool") STRIP_ASSUME_TAC) THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [AFFINE_INDEPENDENT_IFF_CARD]) THEN
        STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FINITE_INDEX_NUMSEG]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN (← q r"CARD(b:real^N->bool) <= dimindex(:(N,1)finite_sum)")
        ASSUME_TAC THENL
         [REWRITE_TAC [← GSYM INT_OF_NUM_LE] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
           (← q r"a:int = c - &1 ==> a + &1 <= n ==> c <= n"))) THEN
          REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1, ← GSYM INT_OF_NUM_ADD] THEN
          REWRITE_TAC [INT_LE_RADD, AFF_DIM_LE_UNIV],
          ALL_TAC] THEN
        UNDISCH_TAC (← q r"b SUBSET IMAGE (y:A->real^N) s") THEN
        ONCE_ASM_REWRITE_TAC [] THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        REWRITE_TAC [IN_IMAGE] THEN
        GEN_REWRITE_TAC (LAND_CONV o DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [SKOLEM_THM, IN_NUMSEG] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->A") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"\i. if i <= CARD(b:real^N->bool) then r i else (m:A)") THEN
        CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        UNDISCH_THEN (← q r"affine hull b:real^N->bool = affine hull IMAGE y (s:A->bool)")
         (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [← GSYM SUBSET] THEN MATCH_MP_TAC HULL_MONO THEN
        ONCE_ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_NUMSEG] THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN REWRITE_TAC [← GSYM IMAGE_o] THEN
        REWRITE_TAC [IN_IMAGE, IN_NUMSEG] THEN EXISTS_TAC (← q r"i:num") THEN
        ASM_REWRITE_TAC [o_THM] THEN ASM_MESON_TAC [LE_TRANS],
        REWRITE_TAC [SUBSET, IN_NUMSEG, FORALL_IN_IMAGE] THEN
        STRIP_TAC THEN MP_TAC (← ISPECL
         [← q r"(lambda i. x(r i:A)):real^N^(N,1)finite_sum",
          ← q r"(lambda i. y(r i:A)):real^N^(N,1)finite_sum"] lemma) THEN
        ASM_SIMP_TAC [LAMBDA_BETA] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^N->real^N") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"k:A") THEN STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"!z. z IN
              affine hull IMAGE (y o (r:num->A)) (1..dimindex(:(N,1)finite_sum))
              ==> dist(z,y k) = dist(z,a + (f:real^N->real^N)(x k))")
        MP_TAC THENL
         [MATCH_MP_TAC SAME_DISTANCES_TO_AFFINE_HULL THEN
          REWRITE_TAC [FORALL_IN_IMAGE, o_THM, IN_NUMSEG] THEN
          X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
          EXISTS_TAC (← q r"dist(x(r(j:num)),(x:A->real^N) k)") THEN CONJ_TAC THENL
           [CONV_TAC SYM_CONV THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [],
            REWRITE_TAC [dist] THEN ASM_SIMP_TAC [← NORM_ARITH
             (← q r"(a + x) - (a + y):real^N = x - y")] THEN
            ASM_MESON_TAC [ORTHOGONAL_TRANSFORMATION, LINEAR_SUB]],
          ASM_SIMP_TAC [← NORM_ARITH
           (← q r"a:real^N = b <=> dist(a:real^N,a) = dist(a,b)")] THEN
          DISCH_THEN MATCH_MP_TAC THEN  MATCH_MP_TAC HULL_INC THEN
          REWRITE_TAC [IN_IMAGE, IN_NUMSEG] THEN ASM_MESON_TAC []]])

  let RIGID_TRANSFORMATION_BETWEEN_CONGRUENT_SETS_STRONG ← prove
   r"!x:A->real^N y:A->real^N s t.
        t SUBSET s /\ affine hull (IMAGE y t) = affine hull (IMAGE y s) /\
        (!i j. i IN s /\ j IN t ==> dist(x i,x j) = dist(y i,y j))
        ==> ?a f. orthogonal_transformation f /\
                  !i. i IN s ==> y i = a + f(x i)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"x:A->real^N", ← q r"y:A->real^N", ← q r"t:A->bool"]
          RIGID_TRANSFORMATION_BETWEEN_CONGRUENT_SETS) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^N->real^N") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"i:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!z. z IN affine hull (IMAGE (y:A->real^N) t)
          ==> dist(z,y i) = dist(z,a + (f:real^N->real^N)(x i))")
    MP_TAC THENL
     [MATCH_MP_TAC SAME_DISTANCES_TO_AFFINE_HULL THEN
      REWRITE_TAC [FORALL_IN_IMAGE, o_THM, IN_NUMSEG] THEN
      X_GEN_TAC (← q r"j:A") THEN STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"dist(a + f(x(j:A):real^N):real^N,a + f(x i))") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a + x:real^N,a + y) = dist(x,y)")] THEN
      ASM_MESON_TAC [ORTHOGONAL_TRANSFORMATION_ISOMETRY, DIST_SYM],
      ASM_SIMP_TAC [← NORM_ARITH
       (← q r"a:real^N = b <=> dist(a:real^N,a) = dist(a,b)")] THEN
      DISCH_THEN MATCH_MP_TAC THEN  MATCH_MP_TAC HULL_INC THEN
      REWRITE_TAC [IN_IMAGE] THEN ASM_MESON_TAC []])

  let RIGID_TRANSFORMATION_BETWEEN_3 ← prove
   r"!a b c a' b' c':real^N.
        dist(a,b) = dist(a',b') /\
        dist(b,c) = dist(b',c') /\
        dist(c,a) = dist(c',a')
        ==> ?k f. orthogonal_transformation f /\
                  a' = k + f a /\ b' = k + f b /\ c' = k + f c"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"FST:real^N#real^N->real^N", ← q r"SND:real^N#real^N->real^N",
      ← q r"{(a:real^N,a':real^N), (b,b'), (c,c')}"]
          RIGID_TRANSFORMATION_BETWEEN_CONGRUENT_SETS) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_INSERT] THEN
    REWRITE_TAC [NOT_IN_EMPTY, IMP_IMP] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_MESON_TAC [DIST_REFL, DIST_SYM])

  let RIGID_TRANSFORMATION_BETWEEN_2 ← prove
   r"!a b a' b':real^N.
        dist(a,b) = dist(a',b')
        ==> ?k f. orthogonal_transformation f /\
                  a' = k + f a /\ b' = k + f b"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N", ← q r"a:real^N",
                      ← q r"a':real^N", ← q r"b':real^N", ← q r"a':real^N"]
          RIGID_TRANSFORMATION_BETWEEN_3) THEN
    ASM_MESON_TAC [DIST_EQ_0, DIST_SYM])

  return { RIGID_TRANSFORMATION_BETWEEN_CONGRUENT_SETS,
           RIGID_TRANSFORMATION_BETWEEN_CONGRUENT_SETS_STRONG, RIGID_TRANSFORMATION_BETWEEN_3,
           RIGID_TRANSFORMATION_BETWEEN_2 }

/- ------------------------------------------------------------------------- -/
/- Caratheodory's theorem.  (convex.ml 5413-5532)                            -/
/- ------------------------------------------------------------------------- -/

structure CAR where
  CONVEX_HULL_CARATHEODORY_AFF_DIM : thm
  CARATHEODORY_AFF_DIM : thm
  CONVEX_HULL_CARATHEODORY : thm
  CARATHEODORY : thm
  deriving Inhabited

@[nospecialize]
def setupCAR [HolBase] (D : ConvexDeps) (BCVS : CVS) (BAFD : AFD) (BCVH : CVH) (BCVE : CVE)
    (BADB : ADB) (BADC : ADC) : ExceptT String IO CAR := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INT_ARITH, INT_ARITH_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, SET_TAC, VECTOR_ARITH_TAC, .. } := D
  let { CARD_DELETE, EXTENSION, FINITE_DELETE, FINITE_IMAGE, FINITE_RESTRICT, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, INF_FINITE, INT_NOT_LT, INT_OF_NUM_ADD,
        INT_OF_NUM_LE, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IMP, .. } := D.core3
  let { REAL_LE_ADD, REAL_LE_DIV, REAL_LE_MUL, REAL_LE_RDIV_EQ, .. } := D.core4
  let { SUBSET, .. } := D.core5
  let { SUM_ADD, SUM_DELETE, SUM_LMUL, SUM_ZERO_EXISTS, num_WOP, real_ge, .. } := D.core6
  let { HULL_MONO, HULL_SUBSET, .. } := D.misc
  let { VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC, VSUM_ADD, VSUM_DELETE, VSUM_LMUL, .. } := D.vec4
  let { CONVEX_EXPLICIT, .. } := BCVS
  let { AFFINE_DEPENDENT_EXPLICIT_FINITE, .. } := BAFD
  let { CONVEX_CONVEX_HULL, .. } := BCVH
  let { CONVEX_HULL_EXPLICIT, .. } := BCVE
  let { AFF_DIM_AFFINE_INDEPENDENT, AFF_DIM_GE, AFF_DIM_SUBSET, .. } := BADB
  let { AFF_DIM_LE_UNIV, .. } := BADC
  -- @@SCOPE END

  let CONVEX_HULL_CARATHEODORY_AFF_DIM ← prove
   r"!p. convex hull p =
        {y:real^N | ?s u. FINITE s /\ s SUBSET p /\
                          &(CARD s) <= aff_dim p + &1 /\
                          (!x. x IN s ==> &0 <= u x) /\
                          sum s u = &1 /\ vsum s (\v. u v % v) = y}"
   (GEN_TAC THEN REWRITE_TAC [CONVEX_HULL_EXPLICIT] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"y:real^N") THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    MATCH_MP_TAC (← TAUT (← q r"!q. (p ==> q) /\ (q ==> r) ==> (p ==> r)")) THEN
    EXISTS_TAC (← q r"?n s u. CARD s = n /\
                        FINITE s /\ s SUBSET p /\
                        (!x. x IN s ==> &0 <= u x) /\
                        sum s u = &1 /\ vsum s (\v. u v % v) = (y:real^N)") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC id [← GSYM INT_NOT_LT] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n - 1")) THEN REWRITE_TAC [NOT_IMP] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← ARITH_RULE (← q r"~(n = 0) ==> n - 1 < n")) THEN
      DISCH_THEN SUBST_ALL_TAC THEN
      UNDISCH_TAC (← q r"aff_dim(p:real^N->bool) + &1 < &0") THEN
      REWRITE_TAC [← INT_ARITH (← q r"p + &1:int < &0 <=> ~(-- &1 <= p)")] THEN
      REWRITE_TAC [AFF_DIM_GE],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") AFF_DIM_AFFINE_INDEPENDENT) THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"~(aff_dim(s:real^N->bool) = &n - &1)") ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP AFF_DIM_SUBSET) THEN
      UNDISCH_TAC (← q r"aff_dim(p:real^N->bool) + &1 < &n") THEN
      INT_ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [AFFINE_DEPENDENT_EXPLICIT_FINITE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N->real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"?t. (!v:real^N. v IN s ==> u(v) + t * w(v) >= &0) /\
          ?a. a IN s /\ u(a) + t * w(a) = &0")
    STRIP_ASSUME_TAC THENL
     [ABBREV_TAC
       (← q r"i = IMAGE (\v. u(v) / --w(v)) {v:real^N | v IN s /\ w v < &0}") THEN
      EXISTS_TAC (← q r"inf i") THEN MP_TAC (← SPEC (← q r"i:real->bool") INF_FINITE) THEN
      ANTS_TAC THENL
       [EXPAND_TAC "i" THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FINITE_RESTRICT, IMAGE_EQ_EMPTY] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
        MP_TAC (← ISPECL [← q r"w:real^N->real", ← q r"s:real^N->bool"] SUM_ZERO_EXISTS) THEN
        ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      ABBREV_TAC (← q r"t = inf i") THEN
      EXPAND_TAC "i" THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      REWRITE_TAC [IN_IMAGE, IN_ELIM_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"a:real^N")
        STRIP_ASSUME_TAC) MP_TAC) THEN
      SIMP_TAC [REAL_LE_RDIV_EQ, ← REAL_ARITH (← q r"x < &0 ==> &0 < --x"), real_ge] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"t * --w <= u <=> &0 <= u + t * w")] THEN
      STRIP_TAC THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        DISJ_CASES_TAC (← REAL_ARITH (← q r"(w:real^N->real) x < &0 \/ &0 <= w x")) THEN
        ASM_SIMP_TAC [] THEN MATCH_MP_TAC REAL_LE_ADD THEN ASM_SIMP_TAC [] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_LE_DIV THEN ASM_SIMP_TAC [] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"w < &0 ==> &0 <= --w")) THEN ASM_REWRITE_TAC [],
        EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [] THEN
        UNDISCH_TAC (← q r"w(a:real^N) < &0") THEN CONV_TAC (fun t => REAL_FIELD t)],
      ALL_TAC] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"s DELETE (a:real^N)", ← q r"(\v. u(v) + t * w(v)):real^N->real"] THEN
    ASM_SIMP_TAC [SUM_DELETE, VSUM_DELETE, CARD_DELETE, FINITE_DELETE] THEN
    ASM_SIMP_TAC [SUM_ADD, VECTOR_ADD_RDISTRIB, VSUM_ADD] THEN
    ASM_SIMP_TAC [← GSYM VECTOR_MUL_ASSOC, SUM_LMUL, VSUM_LMUL] THEN
    REPEAT CONJ_TAC THENL
     [ASM SET_TAC [], ASM SET_TAC [real_ge], REAL_ARITH_TAC, VECTOR_ARITH_TAC])

  let CARATHEODORY_AFF_DIM ← prove
   r"!p. convex hull p =
        {x:real^N | ?s. FINITE s /\ s SUBSET p /\
                         &(CARD s) <= aff_dim p + &1 /\
                        x IN convex hull s}"
   (REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN REPEAT GEN_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
       [CONVEX_HULL_CARATHEODORY_AFF_DIM] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM_MESON_TAC [HULL_SUBSET, CONVEX_EXPLICIT, CONVEX_CONVEX_HULL],
      MESON_TAC [SUBSET, HULL_MONO]])

  let CONVEX_HULL_CARATHEODORY ← prove
   r"!p. convex hull p =
        {y:real^N | ?s u. FINITE s /\ s SUBSET p /\
                          CARD(s) <= dimindex(:N) + 1 /\
                          (!x. x IN s ==> &0 <= u x) /\
                          sum s u = &1 /\ vsum s (\v. u v % v) = y}"
   (GEN_TAC THEN REWRITE_TAC [EXTENSION] THEN X_GEN_TAC (← q r"y:real^N") THEN
    EQ_TAC THENL
     [REWRITE_TAC [CONVEX_HULL_CARATHEODORY_AFF_DIM, IN_ELIM_THM] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      STRIP_TAC THEN
      ASM_REWRITE_TAC [← GSYM INT_OF_NUM_LE, ← GSYM INT_OF_NUM_ADD] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
       (← q r"a:int <= x + &1 ==> x <= y ==> a <= y + &1"))) THEN
      REWRITE_TAC [AFF_DIM_LE_UNIV],
      REWRITE_TAC [CONVEX_HULL_EXPLICIT, IN_ELIM_THM] THEN MESON_TAC []])

  let CARATHEODORY ← prove
   r"!p. convex hull p =
        {x:real^N | ?s. FINITE s /\ s SUBSET p /\
                        CARD(s) <= dimindex(:N) + 1 /\
                        x IN convex hull s}"
   (REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN REPEAT GEN_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
       [CONVEX_HULL_CARATHEODORY] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM_MESON_TAC [HULL_SUBSET, CONVEX_EXPLICIT, CONVEX_CONVEX_HULL],
      MESON_TAC [SUBSET, HULL_MONO]])

  return { CONVEX_HULL_CARATHEODORY_AFF_DIM, CARATHEODORY_AFF_DIM, CONVEX_HULL_CARATHEODORY,
           CARATHEODORY }

/- ------------------------------------------------------------------------- -/
/- Some results on decomposing convex hulls, e.g. simplicial subdivision.    -/
/- (convex.ml 5537-5657)                                                     -/
/- ------------------------------------------------------------------------- -/

structure DCH where
  AFFINE_HULL_INTER : thm
  CONVEX_HULL_INTER : thm
  AFFINE_HULL_INTERS : thm
  CONVEX_HULL_INTERS : thm
  deriving Inhabited

@[nospecialize]
def setupDCH [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFX : AFX) (BAFD : AFD) (BCVH : CVH)
    (BCVE : CVE) (BCLH : CLH) : ExceptT String IO DCH := do
  -- @@SCOPE BEGIN
  let { MESON, REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH_TAC, .. } := D
  let { CONTRAPOS_THM, EQ_TRANS, FINITE_INDUCT_STRONG, FINITE_INTER, FINITE_UNION,
        FINITE_UNIONS, .. } := D.core1
  let { FORALL_IN_INSERT, IMP_CONJ, IMP_CONJ_ALT, INTERS_0, INTERS_1, INTERS_INSERT,
        INTER_SUBSET, INTER_UNIV, .. } := D.core2
  let { IN_ELIM_THM, IN_INTER, IN_SING, NOT_EXISTS_THM, .. } := D.core3
  let { REAL_SUB_RZERO, SUBSET, SUBSET_ANTISYM, SUBSET_INTER, SUBSET_REFL, .. } := D.core5
  let { SUM_0, SUM_CASES, SUM_EQ_SUPERSET, SUM_SUB, UNIONS_0, UNIONS_INSERT, .. } := D.core6
  let { HULL_MONO, .. } := D.misc
  let { VECTOR_MUL_EQ_0, VECTOR_MUL_LZERO, VECTOR_SUB_RDISTRIB, VSUM_0, VSUM_CASES,
        VSUM_EQ_SUPERSET, VSUM_SUB, .. } := D.vec4
  let { AFFINE_HULL_UNIV, .. } := BAFF
  let { AFFINE_HULL_FINITE, .. } := BAFX
  let { AFFINE_DEPENDENT_EXPLICIT, AFFINE_DEPENDENT_MONO, .. } := BAFD
  let { CONVEX_HULL_UNIV, .. } := BCVH
  let { CONVEX_HULL_FINITE, .. } := BCVE
  let { AFFINE_INDEPENDENT_IMP_FINITE, .. } := BCLH
  -- @@SCOPE END

  let (AFFINE_HULL_INTER, CONVEX_HULL_INTER) ← CONJ_PAIR (← prove
   r"(!s t:real^N->bool.
        ~(affine_dependent(s UNION t))
        ==> affine hull s INTER affine hull t = affine hull (s INTER t)) /\
   (!s t:real^N->bool.
        ~(affine_dependent (s UNION t))
        ==> convex hull s INTER convex hull t = convex hull (s INTER t))"
   (CONJ_TAC THEN
    (REPEAT STRIP_TAC THEN
     FIRST_ASSUM (MP_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
     REWRITE_TAC [FINITE_UNION] THEN STRIP_TAC THEN
     MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [SUBSET_INTER] THEN
     SIMP_TAC [HULL_MONO, INTER_SUBSET] THEN
     REWRITE_TAC [SUBSET, AFFINE_HULL_FINITE, CONVEX_HULL_FINITE,
                  IN_ELIM_THM, IN_INTER] THEN
     X_GEN_TAC (← q r"y:real^N") THEN DISCH_THEN (CONJUNCTS_THEN2
      (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC)
      (X_CHOOSE_THEN (← q r"v:real^N->real") STRIP_ASSUME_TAC)) THEN
     FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
       [AFFINE_DEPENDENT_EXPLICIT]) THEN
     REWRITE_TAC [NOT_EXISTS_THM] THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"(s UNION t):real^N->bool")) THEN
     ASM_REWRITE_TAC [SUBSET_REFL] THEN
     DISCH_THEN (MP_TAC o SPEC
      (← q r"\x:real^N. (if x IN s then u x else &0) -
                  (if x IN t then v x else &0)")) THEN
     ASM_SIMP_TAC [SUM_SUB, FINITE_UNION, VSUM_SUB, VECTOR_SUB_RDISTRIB] THEN
     REWRITE_TAC [← MESON []
      (← q r"(if p then a else b) % x = (if p then a % x else b % x)")] THEN
     ASM_SIMP_TAC [SUM_CASES, VSUM_CASES, VECTOR_MUL_LZERO, FINITE_UNION] THEN
     ASM_REWRITE_TAC [SUM_0, VSUM_0,
       ← SET_RULE (← q r"{x | x IN (s UNION t) /\ x IN s} = s"),
       ← SET_RULE (← q r"{x | x IN (s UNION t) /\ x IN t} = t")] THEN
     MATCH_MP_TAC (← TAUT (← q r"a /\ c /\ (~b ==> d) ==> ~(a /\ b /\ c) ==> d")) THEN
     REPEAT CONJ_TAC THENL [REAL_ARITH_TAC, VECTOR_ARITH_TAC, ALL_TAC] THEN
     DISCH_TAC THEN EXISTS_TAC (← q r"u:real^N->real") THEN ASM_SIMP_TAC [] THEN
     CONJ_TAC THEN MATCH_MP_TAC EQ_TRANS THENL
      [EXISTS_TAC (← q r"sum s (u:real^N->real)"),
       EXISTS_TAC (← q r"vsum s (\x. (u:real^N->real) x % x)")] THEN
     (CONJ_TAC THENL [ALL_TAC, FIRST_X_ASSUM ACCEPT_TAC]) THEN
     CONV_TAC SYM_CONV THENL
      [MATCH_MP_TAC SUM_EQ_SUPERSET, MATCH_MP_TAC VSUM_EQ_SUPERSET] THEN
     ASM_SIMP_TAC [FINITE_INTER, INTER_SUBSET, IN_INTER] THEN
     X_GEN_TAC (← q r"x:real^N") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
     ASM_REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISCH_TAC THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
     ASM_REWRITE_TAC [REAL_SUB_RZERO] THEN ASM SET_TAC [])))

  let AFFINE_HULL_INTERS ← prove
   r"!s:(real^N->bool)->bool.
        ~(affine_dependent(UNIONS s))
        ==> affine hull (INTERS s) = INTERS {affine hull t | t IN s}"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
     pure (MP_TAC th THEN MP_TAC (← MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE th))) THEN
    SPEC_TAC ((← q r"s:(real^N->bool)->bool"), (← q r"s:(real^N->bool)->bool")) THEN
    REWRITE_TAC [FINITE_UNIONS, IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, INTERS_0, UNIONS_INSERT, INTERS_INSERT,
                 ← SET_RULE (← q r"{f x | x IN {}} = {}"), AFFINE_HULL_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"f:(real^N->bool)->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [FORALL_IN_INSERT] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [UNDISCH_TAC (← q r"~affine_dependent((s UNION UNIONS f):real^N->bool)") THEN
      REWRITE_TAC [CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] AFFINE_DEPENDENT_MONO) THEN
      SET_TAC [],
      DISCH_TAC] THEN
    ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THENL
     [ASM_REWRITE_TAC [INTERS_0, INTER_UNIV, IN_SING] THEN
      REWRITE_TAC [← SET_RULE (← q r"{f x | x = a} = {f a}"), INTERS_1],
      ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (rhs o rand) AFFINE_HULL_INTER o lhand o snd) THEN
    ANTS_TAC THENL
     [UNDISCH_TAC (← q r"~affine_dependent((s UNION UNIONS f):real^N->bool)") THEN
      REWRITE_TAC [CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] AFFINE_DEPENDENT_MONO) THEN
      UNDISCH_TAC (← q r"~(f:(real^N->bool)->bool = {})") THEN SET_TAC [],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{f x | x IN (a INSERT s)} = (f a) INSERT {f x | x IN s}")] THEN
    ASM_REWRITE_TAC [INTERS_INSERT])

  let CONVEX_HULL_INTERS ← prove
   r"!s:(real^N->bool)->bool.
        ~(affine_dependent(UNIONS s))
        ==> convex hull (INTERS s) = INTERS {convex hull t | t IN s}"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
     pure (MP_TAC th THEN MP_TAC (← MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE th))) THEN
    SPEC_TAC ((← q r"s:(real^N->bool)->bool"), (← q r"s:(real^N->bool)->bool")) THEN
    REWRITE_TAC [FINITE_UNIONS, IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, INTERS_0, UNIONS_INSERT, INTERS_INSERT,
                 ← SET_RULE (← q r"{f x | x IN {}} = {}"), CONVEX_HULL_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"f:(real^N->bool)->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [FORALL_IN_INSERT] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [UNDISCH_TAC (← q r"~affine_dependent((s UNION UNIONS f):real^N->bool)") THEN
      REWRITE_TAC [CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] AFFINE_DEPENDENT_MONO) THEN
      SET_TAC [],
      DISCH_TAC] THEN
    ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THENL
     [ASM_REWRITE_TAC [INTERS_0, INTER_UNIV, IN_SING] THEN
      REWRITE_TAC [← SET_RULE (← q r"{f x | x = a} = {f a}"), INTERS_1],
      ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (rhs o rand) CONVEX_HULL_INTER o lhand o snd) THEN
    ANTS_TAC THENL
     [UNDISCH_TAC (← q r"~affine_dependent((s UNION UNIONS f):real^N->bool)") THEN
      REWRITE_TAC [CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] AFFINE_DEPENDENT_MONO) THEN
      UNDISCH_TAC (← q r"~(f:(real^N->bool)->bool = {})") THEN SET_TAC [],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{f x | x IN (a INSERT s)} = (f a) INSERT {f x | x IN s}")] THEN
    ASM_REWRITE_TAC [INTERS_INSERT])

  return { AFFINE_HULL_INTER, CONVEX_HULL_INTER, AFFINE_HULL_INTERS, CONVEX_HULL_INTERS }

/- ------------------------------------------------------------------------- -/
/- Exchange lemmas for convex hulls.  (convex.ml 5659-5862)                  -/
/- ------------------------------------------------------------------------- -/

structure EXC where
  IN_CONVEX_HULL_EXCHANGE : thm
  IN_CONVEX_HULL_EXCHANGE_UNIQUE : thm
  CONVEX_HULL_EXCHANGE_UNION : thm
  CONVEX_HULL_EXCHANGE_INTER : thm
  deriving Inhabited

@[nospecialize]
def setupEXC [HolBase] (D : ConvexDeps) (BAFS : AFS) (BAFD : AFD) (BCVH : CVH) (BCVE : CVE)
    (BCLH : CLH) (BCAR : CAR) (BDCH : DCH) : ExceptT String IO EXC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D
  let { COND_ID, COND_RAND, COND_RATOR, CONTRAPOS_THM, FINITE_DELETE, FINITE_IMAGE,
        FINITE_INTER, FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_IN_UNIONS, IMAGE_EQ_EMPTY, IMP_CONJ,
        IMP_CONJ_ALT, INSERT_DELETE, INSERT_SUBSET, INTER_SUBSET, IN_DELETE, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_OR,
        NOT_EXISTS_THM, NOT_IN_EMPTY, REAL_ADD_LID, REAL_DIV_RMUL, .. } := D.core3
  let { REAL_INV_DIV, REAL_LE_ADD, REAL_LE_ANTISYM, REAL_LE_DIV, REAL_LE_INV2, REAL_LE_LDIV_EQ,
        REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_LE, .. } := D.core4
  let { REAL_MUL_LNEG, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_NEG_SUB, REAL_SUB_LE,
        REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM,
        SUBSET_INTER, SUBSET_REFL, .. } := D.core5
  let { SUM_0, SUM_ADD, SUM_CASES, SUM_CLAUSES, SUM_DELETE, SUM_EQ_0, SUM_EQ_SUPERSET,
        SUM_LMUL, SUM_SUB, SUP_FINITE, UNIONS_IMAGE, real_div, .. } := D.core6
  let { HULL_INC, HULL_MONO, SUBSET_HULL, .. } := D.misc
  let { VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0,
        VECTOR_MUL_LZERO, VECTOR_SUB_RDISTRIB, VSUM_0, VSUM_ADD, VSUM_CASES, VSUM_CLAUSES,
        VSUM_DELETE, VSUM_EQ_SUPERSET, VSUM_LMUL, VSUM_SUB, .. } := D.vec4
  let { AFFINE_HULL_FINITE_STEP_GEN, .. } := BAFS
  let { AFFINE_DEPENDENT_EXPLICIT, AFFINE_DEPENDENT_MONO, .. } := BAFD
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EMPTY, .. } := BCVH
  let { CONVEX_HULL_FINITE, .. } := BCVE
  let { AFFINE_INDEPENDENT_IMP_FINITE, .. } := BCLH
  let { CARATHEODORY, .. } := BCAR
  let { CONVEX_HULL_INTER, .. } := BDCH
  -- @@SCOPE END

  let IN_CONVEX_HULL_EXCHANGE ← prove
   r"!s a x:real^N.
        a IN convex hull s /\ x IN convex hull s
        ==> ?b. b IN s /\ x IN convex hull (a INSERT (s DELETE b))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN s") THENL
     [EXISTS_TAC (← q r"a:real^N") THEN ASM_SIMP_TAC [INSERT_DELETE], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"FINITE(s:real^N->bool) /\ CARD s <= dimindex(:N) + 1") THENL
     [ALL_TAC,
      UNDISCH_TAC (← q r"(x:real^N) IN convex hull s") THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [CARATHEODORY] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"t:real^N->bool = s") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"?b:real^N. b IN s /\ ~(b IN t)") MP_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:real^N") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      UNDISCH_TAC (← q r"(x:real^N) IN convex hull t") THEN
      SPEC_TAC ((← q r"x:real^N"), (← q r"x:real^N")) THEN REWRITE_TAC [← GSYM SUBSET] THEN
      MATCH_MP_TAC HULL_MONO THEN ASM SET_TAC []] THEN
    MP_TAC (← ASSUME (← q r"(a:real^N) IN convex hull s")) THEN
    MP_TAC (← ASSUME (← q r"(x:real^N) IN convex hull s")) THEN
    REWRITE_TAC [CONVEX_HULL_FINITE, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"v:real^N->real") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"u:real^N->real") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"?b. b IN s /\ (v:real^N->real) b = &0") THENL
     [FIRST_X_ASSUM (fun th => MP_TAC th THEN MATCH_MP_TAC MONO_EXISTS) THEN
      X_GEN_TAC (← q r"b:real^N") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"\x:real^N. if x = a then &0 else v x") THEN
      ASM_SIMP_TAC [FORALL_IN_INSERT, REAL_LE_REFL] THEN
      ASM_SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, FINITE_DELETE] THEN
      ASM_REWRITE_TAC [IN_DELETE] THEN
      ASM_SIMP_TAC [SUM_DELETE, VSUM_DELETE, COND_ID] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      ASM_SIMP_TAC [SUM_CASES, VSUM_CASES, REAL_LE_REFL, COND_ID] THEN
      REWRITE_TAC [VECTOR_MUL_LZERO, SUM_0, VSUM_0] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> {x | x IN s /\ ~(x = a)} = s")] THEN
      CONJ_TAC THENL [REAL_ARITH_TAC, VECTOR_ARITH_TAC],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
    REWRITE_TAC [← TAUT (← q r"~(a /\ b) <=> a ==> ~b")] THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\b. (u:real^N->real) b / v b) s") SUP_FINITE) THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_MESON_TAC [CONVEX_HULL_EMPTY, NOT_IN_EMPTY], ALL_TAC] THEN
    ASM_SIMP_TAC [FINITE_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [IN_IMAGE] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"b:real^N") THEN
    DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"!b. b IN s ==> &0 < (v:real^N->real) b") ASSUME_TAC THENL
     [ASM_SIMP_TAC [REAL_LT_LE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < (u:real^N->real) b /\ &0 < v b") STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [REAL_LT_LE] THEN
      UNDISCH_TAC (← q r"!x. x IN s ==> (u:real^N->real) x / v x <= u b / v b") THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_SIMP_TAC [REAL_LE_LDIV_EQ] THEN
      REWRITE_TAC [real_div, REAL_MUL_LZERO] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= x ==> (x <= &0 <=> x = &0)")] THEN
      DISCH_TAC THEN UNDISCH_TAC (← q r"sum s (u:real^N->real) = &1") THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 ==> x = &1 ==> F")) THEN
      ASM_SIMP_TAC [SUM_EQ_0],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"(\x. if x = a then v b / u b else v x - (v b / u b) * u x):
                real^N->real") THEN
    ASM_SIMP_TAC [FORALL_IN_INSERT, REAL_LE_DIV, REAL_LT_IMP_LE] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
    ASM_SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, FINITE_DELETE] THEN
    ASM_SIMP_TAC [SUM_DELETE, VSUM_DELETE, IN_DELETE] THEN
    ASM_SIMP_TAC [SUM_CASES, VSUM_CASES, FINITE_DELETE] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> {x | x IN s /\ ~(x = a)} = s"),
                  ← SET_RULE (← q r"~(a IN s) ==> {x | x IN s /\ x = a} = {}")] THEN
    REWRITE_TAC [VSUM_CLAUSES, SUM_CLAUSES] THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THENL [ASM_MESON_TAC [], ASM_REWRITE_TAC []] THEN
    ASM_SIMP_TAC [VECTOR_SUB_RDISTRIB, VSUM_SUB, SUM_SUB] THEN
    REWRITE_TAC [← GSYM VECTOR_MUL_ASSOC, VECTOR_ADD_LID, REAL_ADD_LID] THEN
    ASM_SIMP_TAC [SUM_LMUL, VSUM_LMUL] THEN REWRITE_TAC [VECTOR_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_DIV_RMUL, REAL_LT_IMP_NZ] THEN REPEAT CONJ_TAC THENL
     [ALL_TAC, REAL_ARITH_TAC, VECTOR_ARITH_TAC] THEN
    X_GEN_TAC (← q r"c:real^N") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN ASM_CASES_TAC (← q r"(u:real^N->real) c = &0") THENL
     [ASM_SIMP_TAC [REAL_MUL_RZERO, REAL_SUB_RZERO], ALL_TAC] THEN
    REWRITE_TAC [REAL_SUB_LE] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_LT_LE] THEN
    ONCE_REWRITE_TAC [← GSYM REAL_INV_DIV] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_LE])

  let IN_CONVEX_HULL_EXCHANGE_UNIQUE ← prove
   r"!s t t' a x:real^N.
        ~(affine_dependent s) /\
        a IN convex hull s /\
        t SUBSET s /\ t' SUBSET s /\
        x IN convex hull (a INSERT t) /\
        x IN convex hull (a INSERT t')
        ==> x IN convex hull (a INSERT (t INTER t'))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN s") THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [← SET_RULE
       (← q r"a INSERT (s INTER t) = (a INSERT s) INTER (a INSERT t)")] THEN
      W (MP_TAC o PART_MATCH (rand o rand)  CONVEX_HULL_INTER o rand o snd) THEN
      ANTS_TAC THENL
       [UNDISCH_TAC (← q r"~(affine_dependent(s:real^N->bool))") THEN
        REWRITE_TAC [CONTRAPOS_THM] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] AFFINE_DEPENDENT_MONO),
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    REWRITE_TAC [CONVEX_HULL_FINITE, IN_ELIM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"b:real^N->real") STRIP_ASSUME_TAC)
      MP_TAC) THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    SUBGOAL_THEN (← q r"~((a:real^N) IN t) /\ ~(a IN t')") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"FINITE(t:real^N->bool) /\ FINITE(t':real^N->bool)")
    STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [FINITE_SUBSET], ALL_TAC] THEN
    ASM_SIMP_TAC [AFFINE_HULL_FINITE_STEP_GEN, REAL_LE_ADD,
                  ← REAL_ARITH (← q r"&0 <= a / &2 <=> &0 <= a")] THEN
    REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u':real", ← q r"u:real^N->real"] THEN REPEAT DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"v':real", ← q r"v:real^N->real"] THEN REPEAT DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
      [AFFINE_DEPENDENT_EXPLICIT]) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"\x:real^N. (if x IN t then u x else &0) - (if x IN t' then v x else &0) +
                 (u' - v') * b x")) THEN
    ASM_SIMP_TAC [SUM_ADD, VSUM_ADD, SUM_LMUL, VSUM_LMUL, VECTOR_ADD_RDISTRIB] THEN
    ASM_SIMP_TAC [SUM_SUB, VSUM_SUB, VECTOR_SUB_RDISTRIB] THEN
    REWRITE_TAC [← MESON []
     (← q r"(if p then a else b) % x = (if p then a % x else b % x)")] THEN
    ASM_SIMP_TAC [SUM_CASES, VSUM_CASES, VECTOR_MUL_LZERO, SUM_0, VSUM_0] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"t SUBSET s ==> {x | x IN s /\ x IN t} = t")] THEN
    ASM_SIMP_TAC [SUM_ADD, SUM_LMUL, VSUM_ADD, VSUM_LMUL, VECTOR_ADD_RDISTRIB,
                  ← GSYM VECTOR_MUL_ASSOC] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ c /\ (~b ==> d) ==> ~(a /\ b /\ c) ==> d")) THEN
    REPEAT CONJ_TAC THENL [REAL_ARITH_TAC, VECTOR_ARITH_TAC, ALL_TAC] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"(!x. x IN s ==> (if x IN t then u x else &0) <=
                      (if x IN t' then v x else &0)) \/
      (!x:real^N. x IN s ==> (if x IN t' then v x else &0) <=
                             (if x IN t then u x else &0))")
    (DISJ_CASES_THEN (LABEL_TAC "*")) THENL
     [MP_TAC (← REAL_ARITH (← q r"&0 <= (u' - v') \/ &0 <= (v' - u')")) THEN
      MATCH_MP_TAC MONO_OR THEN CONJ_TAC THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"y:real^N")) THEN ASM_REWRITE_TAC [] THENL
       [MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= c ==> a - b + c = &0 ==> a <= b")),
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= --c ==> a - b + c = &0 ==> b <= a"))] THEN
      ASM_SIMP_TAC [REAL_LE_MUL, ← GSYM REAL_MUL_LNEG, REAL_NEG_SUB],
      EXISTS_TAC (← q r"(\x. if x = a then u' else u x):real^N->real"),
      EXISTS_TAC (← q r"(\x. if x = a then v' else v x):real^N->real")] THEN
    ASM_SIMP_TAC [FORALL_IN_INSERT] THEN
    (CONJ_TAC THENL [ASM_MESON_TAC [IN_INTER], ALL_TAC]) THEN
    ASM_SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, FINITE_INTER] THEN
    ASM_REWRITE_TAC [IN_INTER] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"u' + u = &1 <=> u = &1 - u'"),
                 ← VECTOR_ARITH (← q r"u' + u:real^N = y <=> u = y - u'")] THEN
    (CONJ_TAC THEN
     FIRST_X_ASSUM (fun th => tactic_of do
       pure (GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THEN
     CONV_TAC SYM_CONV THENL
      [MATCH_MP_TAC SUM_EQ_SUPERSET, MATCH_MP_TAC VSUM_EQ_SUPERSET]) THEN
    ASM_SIMP_TAC [FINITE_INTER, INTER_SUBSET, IN_INTER] THEN
    (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    X_GEN_TAC (← q r"y:real^N") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISCH_TAC THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"y:real^N")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN ASM SET_TAC [])

  let CONVEX_HULL_EXCHANGE_UNION ← prove
   r"!s a:real^N.
        a IN convex hull s
        ==> convex hull s =
            UNIONS {convex hull (a INSERT (s DELETE b)) |b| b IN s}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN REWRITE_TAC [UNIONS_IMAGE] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      ASM_MESON_TAC [IN_CONVEX_HULL_EXCHANGE],
      REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, FORALL_IN_GSPEC,
                   IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [← GSYM SUBSET] THEN
      ASM_SIMP_TAC [SUBSET_HULL, CONVEX_CONVEX_HULL] THEN
      ASM_REWRITE_TAC [INSERT_SUBSET] THEN
      MESON_TAC [HULL_INC, SUBSET, IN_DELETE]])

  let CONVEX_HULL_EXCHANGE_INTER ← prove
   r"!s a:real^N t t'.
         ~affine_dependent s /\
         a IN convex hull s /\
         t SUBSET s /\
         t' SUBSET s
         ==> (convex hull (a INSERT t)) INTER (convex hull (a INSERT t')) =
             convex hull (a INSERT (t INTER t'))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_INTER] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC IN_CONVEX_HULL_EXCHANGE_UNIQUE THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [SUBSET_INTER] THEN CONJ_TAC THEN
      MATCH_MP_TAC HULL_MONO THEN SET_TAC []])

  return { IN_CONVEX_HULL_EXCHANGE, IN_CONVEX_HULL_EXCHANGE_UNIQUE, CONVEX_HULL_EXCHANGE_UNION,
           CONVEX_HULL_EXCHANGE_INTER }

/- ------------------------------------------------------------------------- -/
/- Representing affine hull as hyperplane or finite intersection of them.    -/
/- (convex.ml 5866-6108)                                                     -/
/- ------------------------------------------------------------------------- -/

structure HYP where
  AFF_DIM_EQ_INTER_HYPERPLANE : thm
  AFF_DIM_EQ_HYPERPLANE : thm
  AFF_DIM_HYPERPLANE : thm
  BOUNDED_HYPERPLANE_EQ_TRIVIAL : thm
  AFFINE_HULL_FINITE_INTERSECTION_HYPERPLANES : thm
  AFFINE_HYPERPLANE_SUMS_EQ_UNIV : thm
  AFF_DIM_AFFINE_INTER_HYPERPLANE : thm
  AFF_DIM_LT_FULL : thm
  AFF_LOWDIM_SUBSET_HYPERPLANE : thm
  COLLINEAR_HYPERPLANE_2 : thm
  COLLINEAR_STANDARD_HYPERPLANE_2 : thm
  deriving Inhabited

@[nospecialize]
def setupHYP [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BAFD : AFD) (BCLH : CLH)
    (BADA : ADA) (BADB : ADB) (BADC : ADC) (BADD : ADD) (BDCH : DCH) :
    ExceptT String IO HYP := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, INT_ARITH, INT_ARITH_TAC, MESON, REAL_ARITH,
        SET_RULE, SET_TAC, VECTOR_ARITH, GEN_GEOM_ORIGIN_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { CARD_CLAUSES, CARD_DELETE, CARD_DIFF, CARD_EQ_0, CARD_IMAGE_INJ, CARD_SUBSET,
        DIFF_EQ_EMPTY, DIMINDEX_GE_1, EMPTY_GSPEC, EMPTY_SUBSET, EXTENSION, FINITE_DIFF,
        FINITE_IMAGE, FINITE_INDEX_INRANGE, FINITE_RULES, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FUN_EQ_THM, IMAGE_o, IMP_CONJ, INTERS_0,
        INTER_EMPTY, INTER_UNIV, INT_OF_NUM_ADD, INT_OF_NUM_EQ, INT_OF_NUM_LE, INT_OF_NUM_LT,
        INT_OF_NUM_SUB, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_INTERS, IN_UNIV, LEFT_IMP_EXISTS_THM, LET_TRANS,
        LE_1, LE_ANTISYM, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IN_EMPTY, PSUBSET, REAL_DIV_RMUL, .. } := D.core3
  let { REAL_EQ_ADD_LCANCEL_0, .. } := D.core4
  let { REAL_SUB_REFL, RIGHT_FORALL_IMP_THM, SET_PROVE_CASES, SIMPLE_IMAGE, SUBSET,
        SUBSET_TRANS, .. } := D.core5
  let { SUBSET_UNIV, o_DEF, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { BASIS_NONZERO, DIM_EQ_FULL, DIM_PSUBSET, DIM_SUBSET_UNIV, DOT_BASIS, DOT_EQ_0,
        DOT_LZERO, DOT_RADD, DOT_RMUL, DOT_RZERO, .. } := D.vec1
  let { LOWDIM_EQ_INTER_HYPERPLANE, LOWDIM_SUBSET_HYPERPLANE, .. } := D.vec2
  let { SPAN_EQ_SELF, SPAN_INC, SPAN_SUPERSET, SUBSPACE_0, SUBSPACE_HYPERPLANE,
        SUBSPACE_SUMS, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, .. } := D.vec4
  let { BOUNDED_EMPTY, .. } := D.top1
  let { NOT_BOUNDED_UNIV, .. } := D.top4
  let { DIM_HYPERPLANE, DIM_EQ_HYPERPLANE, AFFINE_HYPERPLANE, AFFINE_HULL_EQ,
        AFFINE_HULL_UNIV, .. } := BAFF
  let { AFFINE_HULL_EMPTY, .. } := BAFS
  let { affine_dependent, AFFINE_INDEPENDENT_SUBSET, AFFINE_INDEPENDENT_DELETE, .. } := BAFD
  let { AFFINE_EQ_SUBSPACE, AFFINE_HULL_EQ_SPAN, AFFINE_INDEPENDENT_IMP_FINITE, .. } := BCLH
  let { EXTEND_TO_AFFINE_BASIS, AFFINE_BASIS_EXISTS, AFF_DIM_EMPTY, AFF_DIM_AFFINE_HULL, .. } :=
    BADA
  let { AFF_DIM_DIM_0, AFF_DIM_AFFINE_INDEPENDENT, .. } := BADB
  let { AFF_DIM_EQ_0, AFF_DIM_UNIV, AFF_DIM_SUMS_INTER, AFF_DIM_EQ_FULL, AFF_DIM_LE_UNIV, .. } :=
    BADC
  let { AFF_DIM_DIM, AFFINE_BOUNDED_EQ_LOWDIM, COLLINEAR_AFF_DIM, .. } := BADD
  let { AFFINE_HULL_INTERS, .. } := BDCH
  -- @@SCOPE END

  let AFF_DIM_EQ_INTER_HYPERPLANE ← prove
   r"!s t:real^N->bool.
        affine s /\ affine t /\ t SUBSET s /\ aff_dim t + &1 = aff_dim s
        ==> ?a b. ~(a = vec 0) /\ {x | a dot x = b} INTER s = t"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [AFF_DIM_EMPTY, ← INT_ARITH (← q r"--a + a:int = b <=> b = &0")] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (fun th => tactic_of do
        pure (MP_TAC (← liftExcept (last (CONJUNCTS th)))))) THEN
      REWRITE_TAC [AFF_DIM_EQ_0, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:real^N") THEN DISCH_THEN SUBST1_TAC THEN MAP_EVERY EXISTS_TAC
       [← q r"basis 1:real^N", ← q r"basis 1 dot (a:real^N) + &1"] THEN
      SIMP_TAC [BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1,
                ← REAL_ARITH (← q r"x:real = x + &1 <=> F"), IN_ELIM_THM,
                ← SET_RULE (← q r"s INTER {a} = {} <=> ~(a IN s)")],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"z:real^N") THEN
      GEN_GEOM_ORIGIN_TAC (← q r"z:real^N") ["a"] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"(vec 0:real^N) IN s") THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_SIMP_TAC [AFFINE_EQ_SUBSPACE, AFF_DIM_DIM, HULL_INC] THEN
      REWRITE_TAC [INT_OF_NUM_ADD, INT_OF_NUM_EQ] THEN
      DISCH_THEN (MP_TAC o MATCH_MP LOWDIM_EQ_INTER_HYPERPLANE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [DOT_RADD] THEN
      EXISTS_TAC (← q r"(a:real^N) dot z") THEN
      REWRITE_TAC [REAL_EQ_ADD_LCANCEL_0]])

  let AFF_DIM_EQ_HYPERPLANE ← prove
   r"!s. aff_dim s = &(dimindex(:N)) - &1 <=>
       ?a b. ~(a = vec 0) /\ affine hull s = {x:real^N | a dot x = b}"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [AFF_DIM_EMPTY, ← INT_ARITH (← q r"--a:int = b - a <=> b = &0")] THEN
      SIMP_TAC [INT_OF_NUM_EQ, LE_1, DIMINDEX_GE_1, AFFINE_HULL_EMPTY] THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY, NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(b / (a dot a)) % a:real^N")) THEN
      ASM_SIMP_TAC [DOT_RMUL, REAL_DIV_RMUL, DOT_EQ_0],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"c:real^N") THEN
      GEN_GEOM_ORIGIN_TAC (← q r"c:real^N") ["a"] THEN
      SIMP_TAC [AFF_DIM_DIM_0, HULL_INC] THEN
      SIMP_TAC [INT_OF_NUM_SUB, DIMINDEX_GE_1, INT_OF_NUM_EQ] THEN
      SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC, DIM_EQ_HYPERPLANE] THEN
      REPEAT STRIP_TAC THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"a:real^N") THEN
      REWRITE_TAC [] THEN ASM_CASES_TAC (← q r"a:real^N = vec 0") THEN
      ASM_REWRITE_TAC [DOT_RADD, ← REAL_ARITH (← q r"a + b:real = c <=> b = c - a")] THEN
      EQ_TAC THEN STRIP_TAC THENL
       [EXISTS_TAC (← q r"(a:real^N) dot c") THEN ASM_REWRITE_TAC [REAL_SUB_REFL],
        ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"\s. (vec 0:real^N) IN s")) THEN
        ASM_SIMP_TAC [SPAN_SUPERSET, IN_ELIM_THM, DOT_RZERO]]])

  let AFF_DIM_HYPERPLANE ← prove
   r"!a b. ~(a = vec 0)
         ==> aff_dim {x:real^N | a dot x = b} = &(dimindex(:N)) - &1"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [AFF_DIM_EQ_HYPERPLANE] THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"b:real"] THEN
    ASM_REWRITE_TAC [AFFINE_HULL_EQ, AFFINE_HYPERPLANE])

  let BOUNDED_HYPERPLANE_EQ_TRIVIAL ← prove
   r"!a b. bounded {x:real^N | a dot x = b} <=>
         if a = vec 0 then ~(b = &0) else dimindex(:N) = 1"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = vec 0") THEN
    ASM_REWRITE_TAC [DOT_LZERO] THENL
     [ASM_CASES_TAC (← q r"b = &0") THEN
      ASM_REWRITE_TAC [EMPTY_GSPEC, BOUNDED_EMPTY] THEN
      REWRITE_TAC [NOT_BOUNDED_UNIV, ← SET_RULE (← q r"{x | T} = UNIV")],
      ASM_SIMP_TAC [AFFINE_BOUNDED_EQ_LOWDIM, AFF_DIM_HYPERPLANE,
                    AFFINE_HYPERPLANE] THEN
      REWRITE_TAC [← INT_ARITH (← q r"a - &1:int <= &0 <=> a <= &1"), INT_OF_NUM_LE] THEN
      MATCH_MP_TAC (← ARITH_RULE (← q r"1 <= n ==> (n <= 1 <=> n = 1)")) THEN
      REWRITE_TAC [DIMINDEX_GE_1]])

  let AFFINE_HULL_FINITE_INTERSECTION_HYPERPLANES ← prove
   r"!s:real^N->bool.
        ?f. FINITE f /\
            &(CARD f) + aff_dim s = &(dimindex(:N)) /\
            affine hull s = INTERS f /\
            (!h. h IN f ==> ?a b. ~(a = vec 0) /\ h = {x | a dot x = b})"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") AFFINE_BASIS_EXISTS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MP_TAC (← ISPECL [← q r"b:real^N->bool", ← q r"(:real^N)"] EXTEND_TO_AFFINE_BASIS) THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, AFFINE_HULL_UNIV] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"FINITE(c:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [AFFINE_INDEPENDENT_IMP_FINITE], ALL_TAC] THEN
    REWRITE_TAC [← GSYM AFF_DIM_UNIV] THEN FIRST_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [AFF_DIM_AFFINE_HULL] THEN
    ASM_SIMP_TAC [AFF_DIM_AFFINE_INDEPENDENT, CARD_DIFF] THEN
    REWRITE_TAC [← INT_ARITH (← q r"f + b - &1:int = c - &1 <=> f = c - b")] THEN
    ASM_SIMP_TAC [INT_OF_NUM_SUB, CARD_SUBSET, ← GSYM CARD_DIFF, INT_OF_NUM_EQ] THEN
    ASM_CASES_TAC (← q r"c:real^N->bool = b") THENL
     [EXISTS_TAC (← q r"{}:(real^N->bool)->bool") THEN
      ASM_REWRITE_TAC [CARD_CLAUSES, FINITE_RULES, NOT_IN_EMPTY, INTERS_0,
                       DIFF_EQ_EMPTY] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"{affine hull (c DELETE a) |a| (a:real^N) IN (c DIFF b)}") THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN REWRITE_TAC [SIMPLE_IMAGE] THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FINITE_DIFF] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CARD_IMAGE_INJ THEN ASM_SIMP_TAC [FINITE_DIFF] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN REWRITE_TAC [IN_DIFF] THEN
      STRIP_TAC THEN ASM_CASES_TAC (← q r"x:real^N = y") THEN ASM_REWRITE_TAC [] THEN
      UNDISCH_TAC (← q r"~affine_dependent(c:real^N->bool)") THEN
      REWRITE_TAC [affine_dependent] THEN EXISTS_TAC (← q r"x:real^N") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HULL_INC THEN ASM SET_TAC [],
      ONCE_REWRITE_TAC [← GSYM o_DEF] THEN REWRITE_TAC [IMAGE_o] THEN
      ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
      W (MP_TAC o PART_MATCH (rhs o rand) AFFINE_HULL_INTERS o rand o snd) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC AFFINE_INDEPENDENT_SUBSET THEN
        EXISTS_TAC (← q r"c:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, FORALL_IN_IMAGE,
                     IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN SET_TAC [],
        DISCH_THEN (SUBST1_TAC o SYM) THEN AP_TERM_TAC THEN
        GEN_REWRITE_TAC id [EXTENSION] THEN
        REWRITE_TAC [IN_INTERS, FORALL_IN_IMAGE] THEN ASM SET_TAC []],
      REWRITE_TAC [← GSYM AFF_DIM_EQ_HYPERPLANE] THEN
      ASM_SIMP_TAC [IN_DIFF, AFFINE_INDEPENDENT_DELETE,
                    AFF_DIM_AFFINE_INDEPENDENT, CARD_DELETE] THEN
      REWRITE_TAC [← GSYM AFF_DIM_UNIV] THEN FIRST_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [AFF_DIM_AFFINE_HULL] THEN
      ASM_SIMP_TAC [AFF_DIM_AFFINE_INDEPENDENT, CARD_DIFF] THEN
      REPEAT STRIP_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      MATCH_MP_TAC (← GSYM INT_OF_NUM_SUB) THEN
      MATCH_MP_TAC (← ARITH_RULE (← q r"~(c = 0) ==> 1 <= c")) THEN
      ASM_SIMP_TAC [CARD_EQ_0] THEN ASM SET_TAC []])

  let AFFINE_HYPERPLANE_SUMS_EQ_UNIV ← prove
   r"!a b s.
        affine s /\
        ~(s INTER {v | a dot v = b} = {}) /\
        ~(s DIFF {v | a dot v = b} = {})
        ==> {x + y | x IN s /\ y IN {v | a dot v = b}} = (:real^N)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = vec 0") THENL
     [ASM_REWRITE_TAC [DOT_LZERO] THEN SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> b ==> a /\ c ==> d")] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN X_GEN_TAC (← q r"c:real^N") THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x + y:real^N | x IN s /\ P y} =
          {z | ?x y. x IN s /\ P y /\ z = x + y}")] THEN
    GEOM_ORIGIN_TAC (← q r"c:real^N") THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [DOT_RADD, ← REAL_ARITH (← q r"b dot c + a = d <=> a = d - b dot c")] THEN
    REWRITE_TAC [IN_INTER, IN_ELIM_THM, DOT_RZERO] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
    ASM_SIMP_TAC [AFFINE_EQ_SUBSPACE, HULL_INC] THEN STRIP_TAC THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"c + z:real^N = (c + x) + (c + y) <=>
                              z = c + x + y")] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{z | ?x y. x IN s /\ P y /\ z = c + x + y} =
      IMAGE (\x. c + x) {x + y:real^N | x IN s /\ y IN {v | P v}}")] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!f. (!x. g(f x) = x) /\ s = UNIV ==> IMAGE g s = UNIV")) THEN
    EXISTS_TAC (← q r"\x:real^N. x - c") THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"c + x - c:real^N = x")] THEN
    MATCH_MP_TAC (← MESON [SPAN_EQ_SELF] (← q r"subspace s /\ span s = t ==> s = t")) THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [SUBSPACE_SUMS, SUBSPACE_HYPERPLANE],
      ALL_TAC] THEN
    REWRITE_TAC [← GSYM DIM_EQ_FULL] THEN
    REWRITE_TAC [← GSYM LE_ANTISYM, DIM_SUBSET_UNIV] THEN
    MATCH_MP_TAC (← ARITH_RULE (← q r"m - 1 < n ==> m <= n")) THEN
    MATCH_MP_TAC LET_TRANS THEN EXISTS_TAC (← q r"dim {x:real^N | a dot x = &0}") THEN
    CONJ_TAC THENL [ASM_SIMP_TAC [DIM_HYPERPLANE, LE_REFL], ALL_TAC] THEN
    MATCH_MP_TAC DIM_PSUBSET THEN
    ASM_SIMP_TAC [(← EQ_IMP_RULE (← SPEC_ALL SPAN_EQ_SELF)).2,
                  SUBSPACE_SUMS, SUBSPACE_HYPERPLANE] THEN
    REWRITE_TAC [PSUBSET, SUBSET, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"vec 0:real^N", ← q r"x:real^N"] THEN
      ASM_SIMP_TAC [SUBSPACE_0, VECTOR_ADD_LID],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [NOT_FORALL_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"x:real^N") THEN SIMP_TAC [IN_DIFF, IN_ELIM_THM] THEN
      DISCH_TAC THEN MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"vec 0:real^N"] THEN
      ASM_REWRITE_TAC [DOT_RZERO, VECTOR_ADD_RID]])

  let AFF_DIM_AFFINE_INTER_HYPERPLANE ← prove
   r"!a b s:real^N->bool.
        affine s
        ==> aff_dim(s INTER {x | a dot x = b}) =
                if s INTER {v | a dot v = b} = {} then -- &1
                else if s SUBSET {v | a dot v = b} then aff_dim s
                else aff_dim s - &1"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = vec 0") THENL
     [ASM_REWRITE_TAC [DOT_LZERO] THEN ASM_CASES_TAC (← q r"b = &0") THEN
      ASM_REWRITE_TAC [EMPTY_GSPEC, INTER_EMPTY, AFF_DIM_EMPTY] THEN
      SIMP_TAC [← SET_RULE (← q r"{x | T} = UNIV"), IN_UNIV, INTER_UNIV, SUBSET_UNIV] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [AFF_DIM_EMPTY],
      STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [AFF_DIM_EMPTY] THEN
      COND_CASES_TAC THENL [AP_TERM_TAC THEN ASM SET_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"{x:real^N | a dot x = b}"]
          AFF_DIM_SUMS_INTER) THEN
      ASM_SIMP_TAC [AFFINE_HYPERPLANE, AFF_DIM_HYPERPLANE] THEN
      ASM_SIMP_TAC [AFFINE_HYPERPLANE_SUMS_EQ_UNIV, AFF_DIM_UNIV,
                    ← SET_RULE (← q r"~(s SUBSET t) ==> ~(s DIFF t = {})")] THEN
      SPEC_TAC ((← q r"aff_dim (s INTER {x:real^N | a dot x = b})"), (← q r"i:int")) THEN
      INT_ARITH_TAC])

  let AFF_DIM_LT_FULL ← prove
   r"!s. aff_dim s < &(dimindex(:N)) <=> ~(affine hull s = (:real^N))"
   (GEN_TAC THEN REWRITE_TAC [← GSYM AFF_DIM_EQ_FULL] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") AFF_DIM_LE_UNIV) THEN ARITH_TAC)

  let AFF_LOWDIM_SUBSET_HYPERPLANE ← do
    let a_tm ← q r"a:real^N"
    prove
     r"!s:real^N->bool.
          aff_dim s < &(dimindex(:N))
          ==> ?a b. ~(a = vec 0) /\ s SUBSET {x | a dot x = b}"
     (MATCH_MP_TAC SET_PROVE_CASES THEN CONJ_TAC THENL
       [DISCH_TAC THEN EXISTS_TAC (← q r"basis 1:real^N") THEN
        SIMP_TAC [EMPTY_SUBSET, BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1],
        MAP_EVERY X_GEN_TAC [← q r"c:real^N", ← q r"s:real^N->bool"] THEN
        CONV_TAC (ONCE_DEPTH_CONV
          (fun t => pure (HolCore.Equal.GEN_ALPHA_CONV a_tm t))) THEN
        GEN_GEOM_ORIGIN_TAC (← q r"c:real^N") ["a"] THEN
        SIMP_TAC [AFF_DIM_DIM_0, HULL_INC, IN_INSERT, INT_OF_NUM_LT] THEN
        REPEAT GEN_TAC THEN DISCH_TAC THEN
        DISCH_THEN (MP_TAC o MATCH_MP LOWDIM_SUBSET_HYPERPLANE) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N") THEN
        STRIP_TAC THEN EXISTS_TAC (← q r"(u:real^N) dot c") THEN
        ASM_REWRITE_TAC [DOT_RADD, REAL_EQ_ADD_LCANCEL_0] THEN
        ASM_MESON_TAC [SPAN_INC, SUBSET_TRANS]])

  let COLLINEAR_HYPERPLANE_2 ← prove
   r"!a:real^N b.
     dimindex(:N) <= 2 /\ ~(a = vec 0) ==> collinear {x | a dot x = b}"
   (SIMP_TAC [COLLINEAR_AFF_DIM, AFF_DIM_HYPERPLANE, ← GSYM INT_OF_NUM_LE] THEN
    INT_ARITH_TAC)

  let COLLINEAR_STANDARD_HYPERPLANE_2 ← prove
   r"!k b. dimindex(:N) <= 2 ==> collinear {x:real^N | x$k = b}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"b:real"] COLLINEAR_HYPERPLANE_2) THEN
    ASM_SIMP_TAC [DOT_BASIS, BASIS_NONZERO])

  return { AFF_DIM_EQ_INTER_HYPERPLANE, AFF_DIM_EQ_HYPERPLANE, AFF_DIM_HYPERPLANE,
           BOUNDED_HYPERPLANE_EQ_TRIVIAL, AFFINE_HULL_FINITE_INTERSECTION_HYPERPLANES,
           AFFINE_HYPERPLANE_SUMS_EQ_UNIV, AFF_DIM_AFFINE_INTER_HYPERPLANE, AFF_DIM_LT_FULL,
           AFF_LOWDIM_SUBSET_HYPERPLANE, COLLINEAR_HYPERPLANE_2,
           COLLINEAR_STANDARD_HYPERPLANE_2 }

/- ------------------------------------------------------------------------- -/
/- Existence of rotation into general position w.r.t the axes.               -/
/- (convex.ml 6112-6431)                                                     -/
/- ------------------------------------------------------------------------- -/

structure ROT where
  ROTATION_TO_GENERAL_POSITION_EXISTS_GEN : thm
  ROTATION_TO_GENERAL_POSITION_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupROT [HolBase] (D : ConvexDeps) (BCLH : CLH) (BADA : ADA) (BADB : ADB) (BADC : ADC)
    (BADE : ADE) (BHYP : HYP) : ExceptT String IO ROT := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_INT_ARITH_TAC, ASM_MESON_TAC, INT_ARITH,
        MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, INT_REDUCE_CONV, NUMSEG_CONV,
        NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, .. } := D
  let { AND_FORALL_THM, CARD_NUMSEG_1, CART_EQ, COND_RAND, COND_RATOR, CONJ_ASSOC,
        CONTRAPOS_THM, DE_MORGAN_THM, DIFF_EQ_EMPTY, DIMINDEX_GE_1, EQ_TRANS,
        FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNION, FUN_IN_IMAGE, IMAGE_CLAUSES, IMAGE_ID, IMAGE_UNION,
        IMAGE_o, IMP_CONJ, IMP_IMP, INSERT_AC, INTER_NUMSEG, INTER_SUBSET, INT_LET_TRANS,
        INT_LT_LE, INT_OF_NUM_LE, IN_DELETE, .. } := D.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNION, IN_UNIV, LE, LEFT_IMP_EXISTS_THM, LE_1, LE_ANTISYM,
        LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, NOT_IN_EMPTY, NUMSEG_CLAUSES, PAIRWISE_IMP, REAL_ABS_INV, .. } := D.core3
  let { REAL_ENTIRE, REAL_EQ_NEG2, REAL_INV_EQ_0, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_RZERO, REAL_NEG_EQ_0, REAL_SUB_0, REAL_SUB_REFL,
        REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SUBSET,
        SUBSET_DELETE, SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.core5
  let { SUBSET_UNIV, SUM_EQ_0, SURJECTIVE_IMAGE_EQ, UNIONS_GSPEC, UNIONS_SUBSET, UNIONS_UNION,
        num_INDUCTION, o_THM, pairwise, .. } := D.core6
  let { COUNTABLE_DELETE, COUNTABLE_IMAGE, COUNTABLE_PRODUCT_DEPENDENT, COUNTABLE_UNION, .. } :=
    D.lib
  let { BASIS_COMPONENT, BASIS_NONZERO, COLLINEAR_SPAN, DIM_BASIS_IMAGE, DIM_SING, DIM_SPAN,
        DOT_BASIS, DOT_LMUL, DOT_LZERO, .. } := D.vec1
  let { FORALL_1, IN_SPAN_IMAGE_BASIS, LINEAR_ADD, LINEAR_CMUL, LINEAR_SUB, MATRIX_COMPOSE,
        MATRIX_ID, NONEMPTY_SPAN, NORM_BASIS, NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, ORTHOGONAL_BASIS, ORTHOGONAL_MUL, ORTHOGONAL_REFL, ORTHOGONAL_SYM,
        REAL_ABS_NORM, SPAN_EMPTY, SPAN_MUL, SPAN_SING, SPAN_STDBASIS, SPAN_SUB, SPAN_SUPERSET,
        SPAN_UNION, SUBSPACE_SPAN, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT,
        VECTOR_SUB_EQ, VEC_COMPONENT, dot, orthogonal, .. } := D.vec4
  let { DET_I, DET_MATRIX_REFLECT_ALONG, DET_MUL, DET_ORTHOGONAL_MATRIX, LINEAR_REFLECT_ALONG,
        ORTHOGONAL_MATRIX_MATRIX, ORTHOGONAL_TRANSFORMATION_COMPOSE,
        ORTHOGONAL_TRANSFORMATION_EXISTS_GEN, ORTHOGONAL_TRANSFORMATION_ID,
        ORTHOGONAL_TRANSFORMATION_INJECTIVE, ORTHOGONAL_TRANSFORMATION_LINEAR,
        ORTHOGONAL_TRANSFORMATION_REFLECT_ALONG, REFLECT_ALONG_BASIS_COMPONENT,
        REFLECT_ALONG_INVOLUTION, orthogonal_transformation, .. } := D.det
  let { CLOSURE_OF_EMPTY, INTERIOR_OF_EQ_EMPTY_COMPLEMENT, INTERIOR_OF_MONO, .. } := D.met
  let { CLOSED_HYPERPLANE, CLOSED_IMP_LOCALLY_COMPACT, CLOSED_IN_CLOSED_INTER,
        CLOSED_SPAN, .. } := D.top1
  let { NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED_IN, .. } := D.top4
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.top5
  let { SUBSPACE_IMP_AFFINE, CLOSED_AFFINE, .. } := BCLH
  let { AFF_DIM_EMPTY, .. } := BADA
  let { AFF_DIM_DIM_SUBSPACE, AFF_DIM_GE, AFF_DIM_SUBSET, .. } := BADB
  let { AFF_DIM_EQ_MINUS1, .. } := BADC
  let { EMPTY_INTERIOR_OF_AFF_DIM, .. } := BADE
  let { AFF_DIM_AFFINE_INTER_HYPERPLANE, .. } := BHYP
  -- @@SCOPE END

  let ROTATION_TO_GENERAL_POSITION_EXISTS_GEN ← do
    let lemma0 ← prove
     r"!s:real^N->bool k.
            affine s /\ &2 <= aff_dim s /\ COUNTABLE k /\
            (!a. a IN k ==> ~(s SUBSET {x | orthogonal a x}))
            ==> UNIONS {{x | x IN s /\ orthogonal a x} | a IN k} UNION
                UNIONS {{x | x IN s /\ x IN span {a}} | a IN k} PSUBSET s"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [AFF_DIM_EMPTY] THEN CONV_TAC INT_REDUCE_CONV THEN
      STRIP_TAC THEN REWRITE_TAC [← GSYM UNIONS_UNION] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"t SUBSET s /\ ~(s SUBSET t) ==> t PSUBSET s")) THEN
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC, FORALL_IN_UNION,
                   SUBSET_RESTRICT] THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"subtopology euclidean (s:real^N->bool)") o
            MATCH_MP INTERIOR_OF_MONO) THEN
      MATCH_MP_TAC (← SET_RULE (← q r"~(s = {}) /\ t = {} ==> s SUBSET t ==> F")) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [INTERIOR_OF_EQ_EMPTY_COMPLEMENT] THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        ASM_REWRITE_TAC [DIFF_EQ_EMPTY, CLOSURE_OF_EMPTY],
        ALL_TAC] THEN
      MATCH_MP_TAC NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED_IN THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE,
                    COUNTABLE_UNION, FORALL_IN_UNION] THEN
      ASM_SIMP_TAC [CLOSED_IMP_LOCALLY_COMPACT, CLOSED_AFFINE] THEN
      REWRITE_TAC [orthogonal, ← SET_RULE
       (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
      REWRITE_TAC [← SET_RULE (← q r"{x | x IN s} = s")] THEN
      SIMP_TAC [CLOSED_IN_CLOSED_INTER, CLOSED_HYPERPLANE, CLOSED_SPAN] THEN
      REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"a:real^N") THEN
      ASM_CASES_TAC (← q r"(a:real^N) IN k") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THEN
      MATCH_MP_TAC EMPTY_INTERIOR_OF_AFF_DIM THEN ASM_REWRITE_TAC [] THENL
       [ASM_SIMP_TAC [AFF_DIM_AFFINE_INTER_HYPERPLANE] THEN
        ASM_SIMP_TAC [← GSYM orthogonal] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [← INT_ARITH (← q r"x - &1:int < x")] THEN
        REWRITE_TAC [INT_LT_LE, AFF_DIM_GE] THEN ASM_MESON_TAC [AFF_DIM_EQ_MINUS1],
        TRANS_TAC INT_LET_TRANS (← q r"aff_dim(span{a:real^N})") THEN
        SIMP_TAC [AFF_DIM_SUBSET, INTER_SUBSET] THEN
        SIMP_TAC [AFF_DIM_DIM_SUBSPACE, SUBSPACE_SPAN] THEN
        REWRITE_TAC [DIM_SPAN, DIM_SING] THEN
        COND_CASES_TAC THEN ASM_INT_ARITH_TAC])
    let lemma1 ← prove
     r"!n s:real^N->bool.
          n <= dimindex(:N) /\ COUNTABLE s /\
          s SUBSET span(IMAGE basis (1..n)) DELETE vec 0
          ==> ?f. orthogonal_transformation f /\
                  (!x. (!i. 1 <= i /\ i <= n ==> x$i = &0) ==> f x = x) /\
                  IMAGE f (span(IMAGE basis (1..n))) =
                  span(IMAGE basis (1..n)) /\
                  !x i. x IN s /\ 1 <= i /\ i <= n ==> ~(f x$i = &0)"
     (MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
       [CONV_TAC (ONCE_DEPTH_CONV NUMSEG_CONV) THEN
        REWRITE_TAC [IMAGE_CLAUSES, SPAN_EMPTY] THEN REPEAT STRIP_TAC THEN
        REWRITE_TAC [← ARITH_RULE (← q r"~(1 <= i /\ i <= 0)")] THEN
        EXISTS_TAC (← q r"\x:real^N. x") THEN REWRITE_TAC [ORTHOGONAL_TRANSFORMATION_ID],
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [SUBSET_DELETE] THEN STRIP_TAC] THEN
      X_GEN_TAC (← q r"s:real^N->bool") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
       [EXISTS_TAC (← q r"\x:real^N. x") THEN
        ASM_REWRITE_TAC [IMAGE_ID, NOT_IN_EMPTY, ORTHOGONAL_TRANSFORMATION_ID],
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"n = 0") THENL
       [EXISTS_TAC (← q r"\x:real^N. x") THEN
        ASM_REWRITE_TAC [ORTHOGONAL_TRANSFORMATION_ID, IMAGE_ID] THEN
        ONCE_REWRITE_TAC [IMP_CONJ] THEN CONV_TAC NUM_REDUCE_CONV THEN
        REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_1] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o REWRITE_RULE [SUBSET]) THEN
        ASM_REWRITE_TAC [IN_SPAN_IMAGE_BASIS] THEN
        SUBGOAL_THEN (← q r"~(x:real^N = vec 0)") MP_TAC THENL
         [ASM SET_TAC [], REWRITE_TAC [CART_EQ]] THEN
        REWRITE_TAC [VEC_COMPONENT, IN_NUMSEG, VEC_COMPONENT] THEN
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN CONV_TAC NUM_REDUCE_CONV THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"i:num")) THEN
        ASM_REWRITE_TAC [LE_ANTISYM] THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"span(IMAGE basis (1..SUC n)):real^N->bool", ← q r"s:real^N->bool"]
       lemma0) THEN
      SIMP_TAC [SUBSPACE_IMP_AFFINE, SUBSPACE_SPAN, NONEMPTY_SPAN] THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [SIMP_TAC [AFF_DIM_DIM_SUBSPACE, SUBSPACE_SPAN, DIM_SPAN] THEN
        REWRITE_TAC [DIM_BASIS_IMAGE, INT_OF_NUM_LE] THEN
        REWRITE_TAC [CARD_NUMSEG_1, INTER_NUMSEG, ← ARITH_RULE (← q r"MAX 1 1 = 1")] THEN
        CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"s SUBSET u /\ (!a. a IN s ==> ~(a IN f a))
          ==> !a. a IN s ==> ~(u SUBSET f a)")) THEN
        ASM_REWRITE_TAC [IN_ELIM_THM, ORTHOGONAL_REFL] THEN ASM SET_TAC [],
        DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
         (← q r"t PSUBSET s ==> ?a. a IN s /\ ~(a IN t)"))) THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_UNION, DE_MORGAN_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N")
         (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        ASM_REWRITE_TAC [NOT_EXISTS_THM, ← TAUT (← q r"~(p /\ q) <=> p ==> ~q")]] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [ORTHOGONAL_SYM] orthogonal] THEN
      ASM_CASES_TAC (← q r"a:real^N = vec 0") THENL
       [ASM_MESON_TAC [DOT_LZERO, MEMBER_NOT_EMPTY], STRIP_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"span(IMAGE basis (1..SUC n)):real^N->bool",
        ← q r"inv(norm a) % a:real^N", ← q r"basis(SUC n):real^N"]
       ORTHOGONAL_TRANSFORMATION_EXISTS_GEN) THEN
      REWRITE_TAC [SUBSPACE_SPAN] THEN ANTS_TAC THENL
       [ASM_SIMP_TAC [SPAN_MUL, NORM_BASIS, ← ARITH_RULE (← q r"1 <= SUC n")] THEN
        REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
        ASM_SIMP_TAC [REAL_MUL_LINV, NORM_EQ_0] THEN
        MATCH_MP_TAC SPAN_SUPERSET THEN
        MATCH_MP_TAC FUN_IN_IMAGE THEN REWRITE_TAC [IN_NUMSEG] THEN ARITH_TAC,
        DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^N->real^N") STRIP_ASSUME_TAC)] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"IMAGE (\x. x - x$(SUC n) % basis(SUC n))
              (IMAGE (h:real^N->real^N) s)")) THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN CONJ_TAC THENL
         [REWRITE_TAC [VECTOR_SUB_EQ, ← SET_RULE
           (← q r"~(a IN IMAGE f (IMAGE g s)) <=> !x. x IN s ==> ~(f(g x) = a)")] THEN
          X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
          SPEC_TAC ((← q r"(h:real^N->real^N) x$(SUC n)"), (← q r"b:real")) THEN GEN_TAC THEN
          FIRST_X_ASSUM (fun th => tactic_of do
            pure (GEN_REWRITE_TAC (funpow 3 RAND_CONV) [← SYM th])) THEN
          ASM_SIMP_TAC [← GSYM LINEAR_CMUL, ORTHOGONAL_TRANSFORMATION_LINEAR] THEN
          REWRITE_TAC [VECTOR_MUL_ASSOC] THEN DISCH_TAC THEN
          SUBGOAL_THEN (← q r"(x:real^N) IN span {a} /\ ~(a IN span {x})") MP_TAC THENL
           [ASM_SIMP_TAC [] THEN REWRITE_TAC [SPAN_SING, IN_ELIM_THM, IN_UNIV] THEN
            ASM_MESON_TAC [ORTHOGONAL_TRANSFORMATION_INJECTIVE],
            MP_TAC (← MESON [INSERT_AC]
             (← q r"collinear{vec 0:real^N,a,x} <=> collinear{vec 0,x,a}")) THEN
            REWRITE_TAC [COLLINEAR_SPAN] THEN ASM_MESON_TAC []],
          TRANS_TAC SUBSET_TRANS
           (← q r"IMAGE (\x:real^N. x - x$(SUC n) % basis(SUC n))
                  (span (IMAGE basis (1..SUC n)))") THEN
          CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_SPAN_IMAGE_BASIS] THEN
          REWRITE_TAC [VECTOR_SUB_COMPONENT, IN_NUMSEG] THEN
          X_GEN_TAC (← q r"x:real^N") THEN
          SIMP_TAC [VECTOR_MUL_COMPONENT, BASIS_COMPONENT] THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
          COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_MUL_RID] THEN
          REWRITE_TAC [REAL_SUB_RZERO, REAL_MUL_RZERO] THEN
          REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC],
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:real^N->real^N") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(f:real^N->real^N) o (h:real^N->real^N)") THEN
        ASM_SIMP_TAC [IMAGE_o, ORTHOGONAL_TRANSFORMATION_COMPOSE] THEN
        ASM_REWRITE_TAC [o_THM] THEN REPEAT CONJ_TAC THENL
         [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
          TRANS_TAC EQ_TRANS (← q r"(f:real^N->real^N) x") THEN CONJ_TAC THENL
           [AP_TERM_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
            ASM_SIMP_TAC [ORTHOGONAL_BASIS, ← ARITH_RULE (← q r"1 <= SUC n"), LE_REFL] THEN
            REWRITE_TAC [ORTHOGONAL_MUL] THEN DISJ2_TAC THEN
            FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_SPAN_IMAGE_BASIS]) THEN
            REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
            REWRITE_TAC [orthogonal, dot] THEN MATCH_MP_TAC SUM_EQ_0 THEN
            X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
            ASM_MESON_TAC [REAL_ENTIRE],
            ASM_MESON_TAC [← ARITH_RULE (← q r"i <= n ==> i <= SUC n")]],
          REWRITE_TAC [NUMSEG_CLAUSES, ← ARITH_RULE (← q r"1 <= SUC n")] THEN
          ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = s UNION {a}")] THEN
          REWRITE_TAC [SPAN_UNION, IMAGE_UNION] THEN
          REWRITE_TAC [← SET_RULE
           (← q r"IMAGE f {p x y | P x y} = {f(p x y) | P x y}")] THEN
          ASM_SIMP_TAC [LINEAR_ADD, ORTHOGONAL_TRANSFORMATION_LINEAR] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"IMAGE f s = u /\ (!x. x IN t ==> f x = x)
            ==> {(f:real^N->real^N) x + f y | x IN s /\ y IN t} =
                {x + y | x IN u /\ y IN t}")) THEN
          ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [IMAGE_CLAUSES, SPAN_SING, FORALL_IN_GSPEC, IN_UNIV] THEN
          ASM_SIMP_TAC [LINEAR_CMUL, ORTHOGONAL_TRANSFORMATION_LINEAR] THEN
          GEN_TAC THEN AP_TERM_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          SUBGOAL_THEN (← q r"!i. i <= n ==> i <= dimindex(:N)") MP_TAC THENL
           [ASM_ARITH_TAC, SIMP_TAC [BASIS_COMPONENT]] THEN
          SIMP_TAC [← ARITH_RULE (← q r"i <= n ==> ~(i = SUC n)")],
          MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"i:num"] THEN
          REWRITE_TAC [LE] THEN STRIP_TAC THENL
           [ALL_TAC,
            RULE_ASSUM_TAC (REWRITE_RULE
             [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE]) THEN
            RULE_ASSUM_TAC (REWRITE_RULE
             [IMP_IMP, RIGHT_IMP_FORALL_THM, ← GSYM CONJ_ASSOC]) THEN
            FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"i:num"]) THEN
            ASM_REWRITE_TAC [CONTRAPOS_THM, VECTOR_SUB_COMPONENT] THEN
            ASM_SIMP_TAC [LINEAR_SUB, ORTHOGONAL_TRANSFORMATION_LINEAR,
                          VECTOR_SUB_COMPONENT] THEN
            DISCH_THEN (K ALL_TAC) THEN MATCH_MP_TAC (← REAL_ARITH
             (← q r"y$i = &0 /\ (f:real^N->real^N)(y)$i = y$i
              ==> &0 - f(y)$i = &0")) THEN
            CONJ_TAC THENL
             [SUBGOAL_THEN (← q r"i <= dimindex(:N)") MP_TAC THENL
               [ASM_ARITH_TAC, ALL_TAC],
              AP_THM_TAC THEN AP_TERM_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
              SUBGOAL_THEN (← q r"!j. j <= n ==> j <= dimindex(:N)") MP_TAC THENL
               [ASM_ARITH_TAC, ALL_TAC]] THEN
            ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, BASIS_COMPONENT, REAL_MUL_RZERO,
                          ← ARITH_RULE (← q r"i <= n ==> ~(i = SUC n)")]] THEN
          SUBGOAL_THEN (← q r"(f:real^N->real^N)(h(x:real^N)) =
                        f(h x - h x$(SUC n) % basis(SUC n)) +
                        h x$(SUC n) % basis(SUC n)")
          SUBST1_TAC THENL
           [W (MP_TAC o PART_MATCH (lhand o rand) LINEAR_SUB o
              lhand o rand o snd) THEN
            ASM_SIMP_TAC [ORTHOGONAL_TRANSFORMATION_LINEAR] THEN
            DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC (← VECTOR_ARITH
             (← q r"y:real^N = z ==> x = x - y + z")) THEN
            FIRST_X_ASSUM MATCH_MP_TAC THEN
            SUBGOAL_THEN (← q r"!j. j <= n ==> j <= dimindex(:N)") MP_TAC THENL
             [ASM_ARITH_TAC, ALL_TAC] THEN
            ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, BASIS_COMPONENT, REAL_MUL_RZERO,
                          ← ARITH_RULE (← q r"i <= n ==> ~(i = SUC n)")],
            ASM_REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
            ASM_SIMP_TAC [BASIS_COMPONENT, ← ARITH_RULE (← q r"1 <= SUC n")] THEN
            MATCH_MP_TAC (← REAL_ARITH
             (← q r"x = &0 /\ ~(y = &0) ==> ~(x + y * &1 = &0)")) THEN
            CONJ_TAC THENL
             [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
               (← q r"IMAGE f b = b ==> x IN b /\ (!y. y IN b ==> y$SUC n = &0)
                ==> (f:real^N->real^N) x $SUC n = &0"))) THEN
              REWRITE_TAC [IN_SPAN_IMAGE_BASIS] THEN
              ASM_SIMP_TAC [IN_NUMSEG, ← ARITH_RULE
               (← q r"1 <= SUC n /\ ~(SUC n <= n)")] THEN
              SUBGOAL_THEN (← q r"(h:real^N->real^N) x IN span(IMAGE basis (1..SUC n))")
              MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
              ASM_SIMP_TAC [IN_SPAN_IMAGE_BASIS] THEN
              MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"j:num") THEN
              ASM_CASES_TAC (← q r"1 <= j") THEN
              ASM_REWRITE_TAC [VECTOR_SUB_COMPONENT] THEN
              ASM_CASES_TAC (← q r"j <= dimindex(:N)") THEN
              ASM_REWRITE_TAC [VECTOR_MUL_COMPONENT, IN_NUMSEG] THEN
              ASM_SIMP_TAC [BASIS_COMPONENT] THEN COND_CASES_TAC THEN
              ASM_REWRITE_TAC [REAL_MUL_RID, REAL_SUB_REFL] THEN
              REPEAT STRIP_TAC THEN
              REWRITE_TAC [REAL_MUL_RZERO, REAL_SUB_RZERO] THEN
              FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
              SUBGOAL_THEN (← q r"~(h(inv(norm a) % a) dot (h:real^N->real^N) x = &0)")
              MP_TAC THENL
               [ALL_TAC, ASM_SIMP_TAC [DOT_BASIS, ← ARITH_RULE (← q r"1 <= SUC n")]] THEN
              RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_transformation]) THEN
              ASM_REWRITE_TAC [DOT_LMUL, REAL_ENTIRE,
                               REAL_INV_EQ_0, NORM_EQ_0] THEN
              ASM_MESON_TAC [orthogonal]]]]])
    prove
     r"!n s:real^N->bool.
        n <= dimindex(:N) /\ COUNTABLE s /\
        s SUBSET span(IMAGE basis (1..n))
        ==> ?f. orthogonal_transformation f /\
                det(matrix f) = &1 /\
                (!x. (!i. 1 <= i /\ i <= n ==> x$i = &0) ==> f x = x) /\
                IMAGE f (span(IMAGE basis (1..n))) = span(IMAGE basis (1..n)) /\
                pairwise (\x y. !i. 1 <= i /\ i <= n ==> ~(f x$i = f y$i)) s"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"n = 0") THENL
       [EXISTS_TAC (← q r"\x:real^N. x") THEN
        ASM_REWRITE_TAC [ORTHOGONAL_TRANSFORMATION_ID, MATRIX_ID, DET_I] THEN
        CONV_TAC (ONCE_DEPTH_CONV NUMSEG_CONV) THEN
        REWRITE_TAC [IMAGE_CLAUSES, SPAN_EMPTY] THEN
        REWRITE_TAC [pairwise] THEN ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"(!f. P f /\ R f ==> ?f'. P f' /\ Q f' /\ R f') /\ (?f. P f /\ R f)
        ==> ?f. P f /\ Q f /\ R f")) THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"f:real^N->real^N") THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP ORTHOGONAL_MATRIX_MATRIX) THEN
        DISCH_THEN (STRIP_ASSUME_TAC o MATCH_MP DET_ORTHOGONAL_MATRIX) THENL
         [ASM_MESON_TAC [], ALL_TAC] THEN
        EXISTS_TAC (← q r"reflect_along (basis 1:real^N) o (f:real^N->real^N)") THEN
        ASM_SIMP_TAC [ORTHOGONAL_TRANSFORMATION_COMPOSE,
                      ORTHOGONAL_TRANSFORMATION_REFLECT_ALONG] THEN
        ASM_SIMP_TAC [MATRIX_COMPOSE, ORTHOGONAL_TRANSFORMATION_LINEAR,
                      LINEAR_REFLECT_ALONG, DET_MUL] THEN
        SUBGOAL_THEN (← q r"!i. i <= n ==> i <= dimindex(:N)")
        MP_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        ASM_SIMP_TAC [DET_MATRIX_REFLECT_ALONG, BASIS_NONZERO, o_THM, IMAGE_o,
          CART_EQ, DIMINDEX_GE_1, LE_REFL, REFLECT_ALONG_BASIS_COMPONENT] THEN
        DISCH_TAC THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN REPEAT CONJ_TAC THENL
         [GEN_TAC THEN MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
          COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
          ASM_SIMP_TAC [LE_1, LE_REFL] THEN CONV_TAC REAL_RAT_REDUCE_CONV,
          MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
          CONJ_TAC THENL [MESON_TAC [REFLECT_ALONG_INVOLUTION], ALL_TAC] THEN
          REWRITE_TAC [IN_SPAN_IMAGE_BASIS] THEN
          SIMP_TAC [REFLECT_ALONG_BASIS_COMPONENT, DIMINDEX_GE_1, LE_REFL] THEN
          ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
          REWRITE_TAC [REAL_NEG_EQ_0] THEN
          GEN_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
          COND_CASES_TAC THEN ASM_REWRITE_TAC [],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            PAIRWISE_IMP)) THEN
          REWRITE_TAC [] THEN REPEAT GEN_TAC THEN REPEAT DISCH_TAC THEN
          GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_EQ_NEG2]],
        MP_TAC (← ISPECL [← q r"n:num",
                          ← q r"{x - y:real^N | x IN s /\ y IN s} DELETE (vec 0)"]
         lemma1) THEN
        ASM_REWRITE_TAC [IN_DELETE] THEN
        ASM_SIMP_TAC [COUNTABLE_PRODUCT_DEPENDENT, COUNTABLE_DELETE] THEN
        ANTS_TAC THENL
         [MATCH_MP_TAC (← SET_RULE
            (← q r"s SUBSET t ==> s DELETE a SUBSET t DELETE a")) THEN
          REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC SPAN_SUB THEN ASM SET_TAC [],
          MATCH_MP_TAC MONO_EXISTS THEN
          REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
          REWRITE_TAC [VECTOR_SUB_EQ, pairwise] THEN
          GEN_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
          FIRST_ASSUM (MP_TAC o MATCH_MP LINEAR_SUB o MATCH_MP
           ORTHOGONAL_TRANSFORMATION_LINEAR) THEN
          DISCH_THEN (fun th => REWRITE_TAC [th, VECTOR_SUB_COMPONENT]) THEN
          REWRITE_TAC [REAL_SUB_0] THEN MESON_TAC []]])

  let ROTATION_TO_GENERAL_POSITION_EXISTS ← prove
   r"!s:real^N->bool.
        COUNTABLE s
        ==> ?f. orthogonal_transformation f /\ det(matrix f) = &1 /\
                pairwise (\x y. !i. 1 <= i /\ i <= dimindex(:N)
                                    ==> ~(f x$i = f y$i)) s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"dimindex(:N)", ← q r"s:real^N->bool"]
          ROTATION_TO_GENERAL_POSITION_EXISTS_GEN) THEN
    ASM_REWRITE_TAC [LE_REFL] THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, IN_NUMSEG, SPAN_STDBASIS, SUBSET_UNIV] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [])

  return { ROTATION_TO_GENERAL_POSITION_EXISTS_GEN, ROTATION_TO_GENERAL_POSITION_EXISTS }

/- ------------------------------------------------------------------------- -/
/- Openness and compactness are preserved by convex hull operation.          -/
/- (convex.ml 6434-6606)                                                     -/
/- ------------------------------------------------------------------------- -/

structure OCH where
  OPEN_CONVEX_HULL : thm
  COMPACT_CONVEX_COMBINATIONS : thm
  COMPACT_CONVEX_HULL : thm
  FINITE_IMP_COMPACT_CONVEX_HULL : thm
  CONVEX_HULL_INTERIOR_SUBSET : thm
  deriving Inhabited

@[nospecialize]
def setupOCH [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVH : CVH) (BCVE : CVE) (BCAR : CAR) :
    ExceptT String IO OCH := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH,
        SET_RULE, SET_TAC, UNWIND_CONV, num_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC,
        NORM_ARITH, .. } := D
  let { CARD_CLAUSES, CARD_EQ_0, EQ_IMP, ETA_AX, EXISTS_OR_THM, EXTENSION, FINITE_IMAGE,
        FINITE_INSERT, FINITE_RULES, .. } := D.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, HAS_SIZE, HAS_SIZE_CLAUSES, IMAGE_EQ_EMPTY,
        INF_FINITE, INSERT_SUBSET, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_SING, LE, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, LE_SUC, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, PCROSS, .. } := D.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, .. } := D.core4
  let { REAL_POS, RIGHT_AND_EXISTS_THM, SKOLEM_THM, SNDCART_PASTECART, SUBSET,
        SUBSET_EMPTY, .. } := D.core5
  let { SUM_CLAUSES, SUM_IMAGE, o_DEF, .. } := D.core6
  let { HULL_MONO, HULL_SUBSET, .. } := D.misc
  let { DROP_VEC, EXISTS_DROP, LIFT_DROP, LIFT_SUB, LINEAR_COMPOSE, LINEAR_FSTCART,
        LINEAR_SNDCART, .. } := D.vec2
  let { VECTOR_ADD_LDISTRIB, VSUM_ADD, VSUM_IMAGE, VSUM_RMUL, dist, .. } := D.vec4
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_EMPTY, COMPACT_INTERVAL, COMPACT_PCROSS,
        CONTINUOUS_ADD, CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.top2
  let { CONTINUOUS_CONST, CONTINUOUS_MUL, CONTINUOUS_SUB, FINITE_IMP_COMPACT, .. } := D.top3
  let { INTERIOR_MAXIMAL, INTERIOR_SUBSET, IN_CBALL, IN_INTERVAL_1, LINEAR_CONTINUOUS_AT,
        OPEN_CONTAINS_CBALL, .. } := D.top4
  let { OPEN_INTERIOR, .. } := D.top5
  let { IN_CONVEX_SET, .. } := BCVX
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EMPTY, CONVEX_HULL_SING, CONVEX_HULL_INSERT, .. } :=
    BCVH
  let { CONVEX_HULL_EXPLICIT, .. } := BCVE
  let { CARATHEODORY, .. } := BCAR
  -- @@SCOPE END

  let OPEN_CONVEX_HULL ← prove
   r"!s:real^N->bool. open s ==> open(convex hull s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONVEX_HULL_EXPLICIT, OPEN_CONTAINS_CBALL] THEN
    REWRITE_TAC [IN_ELIM_THM, SUBSET, LEFT_IMP_EXISTS_THM] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"t:real^N->bool", ← q r"u:real^N->real"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?b. !x:real^N. x IN t ==> &0 < b(x) /\ cball(x,b(x)) SUBSET s")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM SKOLEM_THM] THEN ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    ABBREV_TAC (← q r"i = IMAGE (b:real^N->real) t") THEN
    EXISTS_TAC (← q r"inf i") THEN MP_TAC (← SPEC (← q r"i:real->bool") INF_FINITE) THEN
    EXPAND_TAC "i" THEN ASM_REWRITE_TAC [FORALL_IN_IMAGE, IN_IMAGE] THEN
    ANTS_TAC THENL
     [EXPAND_TAC "i" THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [FINITE_IMAGE], ALL_TAC] THEN
      REWRITE_TAC [IMAGE_EQ_EMPTY] THEN
      ASM_MESON_TAC [SUM_CLAUSES, ← REAL_ARITH (← q r"~(&1 = &0)")],
      ALL_TAC] THEN
    STRIP_TAC THEN CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_CBALL, dist] THEN
    DISCH_TAC THEN EXISTS_TAC (← q r"IMAGE (\v:real^N. v + (y - a)) t") THEN
    EXISTS_TAC (← q r"\v. (u:real^N->real)(v - (y - a))") THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE, SUM_IMAGE, VSUM_IMAGE,
                  ← VECTOR_ARITH (← q r"v + a:real^N = w + a <=> v = w")] THEN
    ASM_REWRITE_TAC [o_DEF, ← VECTOR_ARITH (← q r"(v + a) - a:real^N = v")] THEN
    ASM_REWRITE_TAC [VECTOR_ADD_LDISTRIB, ETA_AX] THEN
    ASM_SIMP_TAC [VSUM_ADD, VSUM_RMUL] THEN
    CONJ_TAC THENL [ALL_TAC, VECTOR_ARITH_TAC] THEN
    X_GEN_TAC (← q r"z:real^N") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"z + (y - a) IN cball(z:real^N,b z)")
     (fun th => ASM_MESON_TAC [th, SUBSET]) THEN
    REWRITE_TAC [IN_CBALL, dist, ← NORM_ARITH
     (← q r"norm(z - (z + a - y)) = norm(y - a)")] THEN
    ASM_MESON_TAC [REAL_LE_TRANS])

  let COMPACT_CONVEX_COMBINATIONS ← prove
   r"!s t. compact s /\ compact t
         ==> compact { (&1 - u) % x + u % y :real^N |
                      &0 <= u /\ u <= &1 /\ x IN s /\ y IN t}"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"{ (&1 - u) % x + u % y :real^N | &0 <= u /\ u <= &1 /\ x IN s /\ y IN t} =
      IMAGE (\z. (&1 - drop(fstcart z)) % fstcart(sndcart z) +
                 drop(fstcart z) % sndcart(sndcart z))
            { pastecart u w | u IN interval[vec 0,vec 1] /\
                              w IN { pastecart x y | x IN s /\ y IN t} }")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^N") THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_AND_EXISTS_THM] THEN
      CONV_TAC (ONCE_DEPTH_CONV UNWIND_CONV) THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      REWRITE_TAC [IN_INTERVAL_1, ← GSYM EXISTS_DROP, DROP_VEC] THEN MESON_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
    ASM_SIMP_TAC [COMPACT_PCROSS, ← GSYM PCROSS, COMPACT_INTERVAL] THEN
    MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
    X_GEN_TAC (← q r"z:real^(1,(N,N)finite_sum)finite_sum") THEN
    DISCH_THEN (K ALL_TAC) THEN REWRITE_TAC [PCROSS] THEN
    MATCH_MP_TAC CONTINUOUS_ADD THEN CONJ_TAC THEN
    MATCH_MP_TAC CONTINUOUS_MUL THEN REWRITE_TAC [o_DEF, LIFT_SUB, LIFT_DROP] THEN
    CONJ_TAC THEN TRY (MATCH_MP_TAC CONTINUOUS_SUB) THEN
    REWRITE_TAC [CONTINUOUS_CONST] THEN
    MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
    REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART, ETA_AX] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC LINEAR_COMPOSE THEN
    REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART])

  let COMPACT_CONVEX_HULL ← prove
   r"!s:real^N->bool. compact s ==> compact(convex hull s)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [CARATHEODORY] THEN
    SPEC_TAC ((← q r"dimindex(:N) + 1"), (← q r"n:num")) THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [SUBSET_EMPTY] THEN
      CONV_TAC (ONCE_DEPTH_CONV UNWIND_CONV) THEN
      REWRITE_TAC [CONVEX_HULL_EMPTY, NOT_IN_EMPTY] THEN
      REWRITE_TAC [← SET_RULE (← q r"{x | F} = {}"), COMPACT_EMPTY],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"w:real^N")) THEN INDUCT_TAC THENL
     [SUBGOAL_THEN
       (← q r"{x:real^N | ?t. FINITE t /\ t SUBSET s /\ CARD t <= 0 /\
                        x IN convex hull t} = {}")
       (fun th => REWRITE_TAC [th, COMPACT_EMPTY]) THEN
      REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, LE, IN_ELIM_THM] THEN
      MESON_TAC [CARD_EQ_0, CONVEX_HULL_EMPTY, NOT_IN_EMPTY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"n = 0") THENL
     [ASM_REWRITE_TAC [← ARITH_RULE (← q r"s <= SUC 0 <=> s = 0 \/ s = 1")] THEN
      UNDISCH_TAC (← q r"compact(s:real^N->bool)") THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
      REWRITE_TAC [← TAUT (← q r"a /\ b /\ (c \/ d) /\ e <=>
                        (a /\ c) /\ (b /\ e) \/ (a /\ d) /\ (b /\ e)")] THEN
      REWRITE_TAC [← GSYM HAS_SIZE, ← ExceptT.mk (num_CONV (← q r"1")), HAS_SIZE_CLAUSES] THEN
      REWRITE_TAC [EXISTS_OR_THM, LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
      CONV_TAC (TOP_DEPTH_CONV UNWIND_CONV) THEN
      REWRITE_TAC [NOT_IN_EMPTY, CONVEX_HULL_EMPTY] THEN
      REWRITE_TAC [CONVEX_HULL_SING] THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"{x:real^N | ?t. FINITE t /\ t SUBSET s /\ CARD t <= SUC n /\
                      x IN convex hull t} =
      { (&1 - u) % x + u % y :real^N |
                        &0 <= u /\ u <= &1 /\ x IN s /\
                        y IN {x | ?t. FINITE t /\ t SUBSET s /\
                                      CARD t <= n /\ x IN convex hull t}}")
     (fun th => ASM_SIMP_TAC [th, COMPACT_CONVEX_COMBINATIONS]) THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EQ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, RIGHT_AND_EXISTS_THM,
                   LEFT_AND_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"c:real", ← q r"v:real^N",
                           ← q r"t:real^N->bool"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"(u:real^N) INSERT t") THEN
      ASM_REWRITE_TAC [FINITE_INSERT, INSERT_SUBSET] THEN
      ASM_SIMP_TAC [CARD_CLAUSES] THEN CONJ_TAC THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC IN_CONVEX_SET THEN
      ASM_REWRITE_TAC [CONVEX_CONVEX_HULL] THEN CONJ_TAC THEN
      ASM_MESON_TAC [HULL_SUBSET, SUBSET, IN_INSERT, HULL_MONO]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"CARD(t:real^N->bool) <= n") THENL
     [MAP_EVERY EXISTS_TAC [← q r"w:real^N", ← q r"&1", ← q r"x:real^N"] THEN
      ASM_REWRITE_TAC [REAL_POS, REAL_LE_REFL] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], VECTOR_ARITH_TAC],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(t:real^N->bool) HAS_SIZE (SUC n)") MP_TAC THENL
     [ASM_REWRITE_TAC [HAS_SIZE] THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [HAS_SIZE_CLAUSES] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") (X_CHOOSE_THEN (← q r"u:real^N->bool")
      STRIP_ASSUME_TAC)) THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    UNDISCH_TAC (← q r"(x:real^N) IN convex hull (a INSERT u)") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [FINITE_INSERT]) THEN
    ASM_CASES_TAC (← q r"(u:real^N->bool) = {}") THENL
     [ASM_REWRITE_TAC [CONVEX_HULL_SING, IN_SING] THEN
      DISCH_THEN SUBST_ALL_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"&1", ← q r"a:real^N"] THEN
      ASM_REWRITE_TAC [REAL_POS, REAL_LE_REFL] THEN
      CONJ_TAC THENL [ALL_TAC, VECTOR_ARITH_TAC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      EXISTS_TAC (← q r"{a:real^N}") THEN SIMP_TAC [FINITE_RULES] THEN
      REWRITE_TAC [CONVEX_HULL_SING, IN_SING] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SIMP_TAC [CARD_CLAUSES, FINITE_RULES, NOT_IN_EMPTY] THEN
      UNDISCH_TAC (← q r"~(n = 0)") THEN ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [CONVEX_HULL_INSERT, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"d:real", ← q r"z:real^N"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"d:real", ← q r"z:real^N"] THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o MATCH_MP (← REAL_ARITH
     (← q r"c + d = &1 ==> c = (&1 - d)"))) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"d <= &1 <=> &0 <= &1 - d")] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    UNDISCH_TAC (← q r"CARD ((a:real^N) INSERT u) <= SUC n") THEN
    ASM_SIMP_TAC [CARD_CLAUSES, LE_SUC])

  let FINITE_IMP_COMPACT_CONVEX_HULL ← prove
   r"!s:real^N->bool. FINITE s ==> compact(convex hull s)"
   (SIMP_TAC [FINITE_IMP_COMPACT, COMPACT_CONVEX_HULL])

  let CONVEX_HULL_INTERIOR_SUBSET ← prove
   r"!s:real^N->bool. convex hull (interior s) SUBSET interior (convex hull s)"
   (GEN_TAC THEN MATCH_MP_TAC INTERIOR_MAXIMAL THEN
    SIMP_TAC [OPEN_CONVEX_HULL, OPEN_INTERIOR, HULL_MONO, INTERIOR_SUBSET])

  return { OPEN_CONVEX_HULL, COMPACT_CONVEX_COMBINATIONS, COMPACT_CONVEX_HULL,
           FINITE_IMP_COMPACT_CONVEX_HULL, CONVEX_HULL_INTERIOR_SUBSET }

/- ------------------------------------------------------------------------- -/
/- Extremal points of a simplex are some vertices.  (convex.ml 6610-6733)    -/
/- ------------------------------------------------------------------------- -/

structure SPX where
  SIMPLEX_FURTHEST_LT : thm
  SIMPLEX_FURTHEST_LT_EXISTS : thm
  SIMPLEX_FURTHEST_LE_EXISTS : thm
  SIMPLEX_FURTHEST_LE : thm
  SIMPLEX_EXTREMAL_LE : thm
  SIMPLEX_EXTREMAL_LE_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupSPX [HolBase] (D : ConvexDeps) (BCVB : CVB) (BCVH : CVH) (BCAR : CAR) (BOCH : OCH) :
    ExceptT String IO SPX := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC,
        NORM_ARITH, .. } := D
  let { CONTRAPOS_THM, DE_MORGAN_THM, FINITE_INDUCT_STRONG, .. } := D.core1
  let { IN_ELIM_THM, IN_INSERT, IN_SING, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        NOT_EXISTS_THM, NOT_IN_EMPTY, REAL_ADD_LID, REAL_ADD_RID, REAL_DOWN2, .. } := D.core3
  let { REAL_LE_ADD, REAL_LE_LT, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LE, .. } := D.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_POS, REAL_SUB_LE, SUBSET, SUBSET_EMPTY, .. } := D.core5
  let { real_gt, .. } := D.core6
  let { HULL_INDUCT, HULL_MONO, HULL_SUBSET, .. } := D.misc
  let { DIST_INCREASES_ONLINE, DIST_SYM, .. } := D.vec1
  let { NORM_SUB, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB, VECTOR_ADD_RID, VECTOR_MUL_EQ_0, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, dist, .. } := D.vec4
  let { COMPACT_SUP_MAXDISTANCE, .. } := D.top2
  let { DISTANCE_ATTAINS_SUP, .. } := D.top3
  let { cball, .. } := D.top5
  let { CONVEX_CBALL, .. } := BCVB
  let { CONVEX_HULL_EMPTY, CONVEX_HULL_SING, CONVEX_HULL_INSERT, .. } := BCVH
  let { CARATHEODORY, .. } := BCAR
  let { FINITE_IMP_COMPACT_CONVEX_HULL, .. } := BOCH
  -- @@SCOPE END

  let SIMPLEX_FURTHEST_LT ← prove
   r"!a:real^N s x.
        x IN (convex hull s) /\ ~(x IN s)
        ==> ?y. y IN (convex hull s) /\ norm(x - a) < norm(y - a)"
   (GEN_TAC THEN MATCH_MP_TAC (← MESON []
     (← q r"((!s. FINITE s ==> P s) ==> !s. P s) /\ (!s. FINITE s ==> P s)
      ==> !s. P s")) THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CARATHEODORY]) THEN
      REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_MESON_TAC [SUBSET, HULL_MONO],
      ALL_TAC] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [CONVEX_HULL_EMPTY, NOT_IN_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"s:real^N->bool"] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [CONVEX_HULL_SING, IN_SING] THEN MESON_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [CONVEX_HULL_INSERT] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [IN_ELIM_THM, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real", ← q r"v:real", ← q r"b:real^N"] THEN
    ASM_CASES_TAC (← q r"y:real^N IN (convex hull s)") THENL
     [REWRITE_TAC [IN_INSERT, DE_MORGAN_THM] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"c:real^N") THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"&0", ← q r"&1", ← q r"c:real^N"] THEN
      ASM_REWRITE_TAC [REAL_ADD_LID, REAL_POS] THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"u = &0") THENL
     [ASM_SIMP_TAC [REAL_ADD_LID, VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN
      ASM_MESON_TAC [VECTOR_MUL_LID],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"v = &0") THENL
     [ASM_SIMP_TAC [REAL_ADD_RID, VECTOR_MUL_LZERO, VECTOR_ADD_RID] THEN
      ASM_CASES_TAC (← q r"u = &1") THEN ASM_REWRITE_TAC [VECTOR_MUL_LID] THEN
      ASM_CASES_TAC (← q r"y = a:real^N") THEN ASM_REWRITE_TAC [IN_INSERT] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [IN_INSERT, DE_MORGAN_THM] THEN STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"u:real", ← q r"v:real"] REAL_DOWN2) THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [REAL_LT_LE], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"y:real^N", ← q r"w % (x - b):real^N"]
                  DIST_INCREASES_ONLINE) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [VECTOR_MUL_EQ_0, REAL_LT_IMP_NZ] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"(x - y = vec 0) <=> (x = y)")] THEN
      DISCH_THEN SUBST_ALL_TAC THEN
      UNDISCH_TAC (← q r"~(y:real^N IN convex hull s)") THEN
      ASM_REWRITE_TAC [← GSYM VECTOR_ADD_RDISTRIB, VECTOR_MUL_LID],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [dist, real_gt] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"((u % x + v % b) + w % (x - b) = (u + w) % x + (v - w) % b) /\
      ((u % x + v % b) - w % (x - b) = (u - w) % x + (v + w) % b)")] THEN
    STRIP_TAC THENL
     [MAP_EVERY EXISTS_TAC
       [← q r"(u + w) % x + (v - w) % b:real^N", ← q r"u + w", ← q r"v - w",
        ← q r"b:real^N"],
      MAP_EVERY EXISTS_TAC
       [← q r"(u - w) % x + (v + w) % b:real^N", ← q r"u - w", ← q r"v + w",
        ← q r"b:real^N"]] THEN
    ONCE_REWRITE_TAC [NORM_SUB] THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [REAL_LE_ADD, REAL_LT_IMP_LE, REAL_SUB_LE] THEN
    UNDISCH_TAC (← q r"u + v = &1") THEN REAL_ARITH_TAC)

  let SIMPLEX_FURTHEST_LT_EXISTS ← prove
   r"!a:real^N s x.
        x IN convex hull s /\ ~(x IN s)
        ==> ?y. y IN s /\ norm(x - a) < norm(y - a)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N") o MATCH_MP SIMPLEX_FURTHEST_LT) THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [NOT_EXISTS_THM, REAL_NOT_LT, ← TAUT (← q r"~(p /\ q) <=> p ==> ~q")] THEN
    DISCH_TAC THEN MATCH_MP_TAC HULL_INDUCT THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← NORM_ARITH (← q r"norm(y - a:real^N) = dist(a,y)")] THEN
    REWRITE_TAC [CONVEX_CBALL, ← GSYM cball])

  let SIMPLEX_FURTHEST_LE_EXISTS ← prove
   r"!a:real^N s x.
        x IN convex hull s
        ==> ?y. y IN s /\ norm(x - a) <= norm(y - a)"
   (MESON_TAC [SIMPLEX_FURTHEST_LT_EXISTS, REAL_LE_LT])

  let SIMPLEX_FURTHEST_LE ← prove
   r"!a:real^N s.
        FINITE s /\ ~(s = {})
        ==> ?y. y IN s /\
                !x. x IN (convex hull s) ==> norm(x - a) <= norm(y - a)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"convex hull (s:real^N->bool)") DISTANCE_ATTAINS_SUP) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_IMP_COMPACT_CONVEX_HULL] THEN
      ASM_MESON_TAC [SUBSET_EMPTY, HULL_SUBSET],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN REWRITE_TAC [dist] THEN
    ASM_MESON_TAC [SIMPLEX_FURTHEST_LT, REAL_NOT_LE])

  let SIMPLEX_EXTREMAL_LE ← prove
   r"!s:real^N->bool.
        FINITE s /\ ~(s = {})
         ==> ?u v. u IN s /\ v IN s /\
                   !x y. x IN convex hull s /\ y IN convex hull s
                         ==> norm(x - y) <= norm(u - v)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"convex hull (s:real^N->bool)") COMPACT_SUP_MAXDISTANCE) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_IMP_COMPACT_CONVEX_HULL] THEN
      ASM_MESON_TAC [SUBSET_EMPTY, HULL_SUBSET],
      ALL_TAC] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    SIMP_TAC [] THEN ASM_MESON_TAC [SIMPLEX_FURTHEST_LT, REAL_NOT_LE, NORM_SUB])

  let SIMPLEX_EXTREMAL_LE_EXISTS ← prove
   r"!s:real^N->bool x y. FINITE s /\ x IN convex hull s /\ y IN convex hull s
                        ==> ?u v. u IN s /\ v IN s /\
                                  norm(x - y) <= norm(u - v)"
   (MESON_TAC [NOT_IN_EMPTY, CONVEX_HULL_EMPTY, SIMPLEX_EXTREMAL_LE])

  return { SIMPLEX_FURTHEST_LT, SIMPLEX_FURTHEST_LT_EXISTS, SIMPLEX_FURTHEST_LE_EXISTS,
           SIMPLEX_FURTHEST_LE, SIMPLEX_EXTREMAL_LE, SIMPLEX_EXTREMAL_LE_EXISTS }

/- ------------------------------------------------------------------------- -/
/- Closest point of a convex set is unique, with a continuous projection;   -/
/- relating closest points and orthogonality.  (convex.ml 6737-6918)         -/
/- ------------------------------------------------------------------------- -/

structure CLP where
  CLOSER_POINTS_LEMMA : thm
  CLOSER_POINT_LEMMA : thm
  ANY_CLOSEST_POINT_DOT : thm
  ANY_CLOSEST_POINT_UNIQUE : thm
  CLOSEST_POINT_UNIQUE : thm
  CLOSEST_POINT_DOT : thm
  CLOSEST_POINT_LT : thm
  CLOSEST_POINT_LIPSCHITZ : thm
  CONTINUOUS_AT_CLOSEST_POINT : thm
  CONTINUOUS_ON_CLOSEST_POINT : thm
  CLOSEST_POINT_TRANSLATION : thm
  ANY_CLOSEST_POINT_AFFINE_ORTHOGONAL : thm
  ORTHOGONAL_ANY_CLOSEST_POINT : thm
  CLOSEST_POINT_AFFINE_ORTHOGONAL : thm
  CLOSEST_POINT_AFFINE_ORTHOGONAL_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupCLP [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BCLH : CLH) :
    ExceptT String IO CLP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, INTRO_TAC,
        VECTOR_ARITH, NORM_ARITH_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { CONTRAPOS_THM, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, .. } := D.core2
  let { IN_IMAGE, MEMBER_NOT_EMPTY, REAL_ADD_LDISTRIB, REAL_DIV_RMUL, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_LMUL_EQ, REAL_LT_MIN, REAL_LT_MUL, REAL_LT_REFL,
        REAL_MIN_LE, .. } := D.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LDISTRIB, RIGHT_FORALL_IMP_THM, .. } := D.core5
  let { real_gt, .. } := D.core6
  let { DIST_0, DIST_SYM, DOT_EQ_0, DOT_LMUL, DOT_LSUB, DOT_POS_LE, DOT_POS_LT, DOT_RMUL,
        DOT_RSUB, DOT_RZERO, .. } := D.vec1
  let { DOT_SYM, NORM_LE, .. } := D.vec2
  let { NORM_LE_0, NORM_LE_SQUARE, NORM_LT, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_SUB_EQ, VECTOR_SUB_RZERO, dist, orthogonal, .. } := D.vec4
  let { CLOSED_TRANSLATION, CLOSEST_POINT_EXISTS, CLOSEST_POINT_IN_SET, CLOSEST_POINT_LE, .. } :=
    D.top1
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.top2
  let { continuous_at, .. } := D.top5
  let { IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { IN_CONVEX_SET, CONVEX_TRANSLATION, .. } := BCVX
  let { AFFINE_IMP_CONVEX, CLOSED_AFFINE, .. } := BCLH
  -- @@SCOPE END

  let CLOSER_POINTS_LEMMA ← prove
   r"!y:real^N z.
        y dot z > &0
        ==> ?u. &0 < u /\
                !v. &0 < v /\ v <= u ==> norm(v % z - y) < norm y"
   (REWRITE_TAC [NORM_LT, DOT_LSUB, DOT_RSUB, DOT_LMUL, DOT_RMUL,
                 REAL_SUB_LDISTRIB, real_gt] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"(a - b) - (c - d) < d <=> a < b + c")] THEN
    STRIP_TAC THEN SUBST1_TAC (← VECTOR_ARITH (← q r"(z:real^N) dot y = y dot z")) THEN
    SIMP_TAC [← GSYM REAL_ADD_LDISTRIB, REAL_LT_LMUL_EQ] THEN
    EXISTS_TAC (← q r"(y dot (z:real^N)) / (z dot z)") THEN
    SUBGOAL_THEN (← q r"&0 < z dot (z:real^N)") ASSUME_TAC THENL
     [ASM_MESON_TAC [DOT_POS_LT, DOT_RZERO, REAL_LT_REFL], ALL_TAC] THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_LE_RDIV_EQ] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < y /\ x <= y ==> x < y + y"), REAL_LT_MUL])

  let CLOSER_POINT_LEMMA ← prove
   r"!x y z. (y - x) dot (z - x) > &0
           ==> ?u. &0 < u /\ u <= &1 /\ dist(x + u % (z - x),y) < dist(x,y)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP CLOSER_POINTS_LEMMA) THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN REWRITE_TAC [dist, NORM_LT] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"(y - (x + z)) dot (y - (x + z)) = (z - (y - x)) dot (z - (y - x))")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min u (&1)") THEN
    ASM_SIMP_TAC [REAL_LT_MIN, REAL_MIN_LE, REAL_LT_01, REAL_LE_REFL])

  let ANY_CLOSEST_POINT_DOT ← prove
   r"!s a x y:real^N.
        convex s /\ closed s /\ x IN s /\ y IN s /\
        (!z. z IN s ==> dist(a,x) <= dist(a,z))
        ==> (a - x) dot (y - x) <= &0"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"x <= &0 <=> ~(x > &0)")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CLOSER_POINT_LEMMA) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [REAL_NOT_LT] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"x + u % (y - x) = (&1 - u) % x + u % y")] THEN
    MATCH_MP_TAC IN_CONVEX_SET THEN ASM_SIMP_TAC [REAL_LT_IMP_LE])

  let ANY_CLOSEST_POINT_UNIQUE ← prove
   r"!s a x y:real^N.
        convex s /\ closed s /\ x IN s /\ y IN s /\
        (!z. z IN s ==> dist(a,x) <= dist(a,z)) /\
        (!z. z IN s ==> dist(a,y) <= dist(a,z))
        ==> x = y"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
    REWRITE_TAC [← GSYM NORM_LE_0, NORM_LE_SQUARE] THEN
    SUBGOAL_THEN (← q r"(a - x:real^N) dot (y - x) <= &0 /\ (a - y) dot (x - y) <= &0")
    MP_TAC THENL [ASM_MESON_TAC [ANY_CLOSEST_POINT_DOT], ALL_TAC] THEN
    REWRITE_TAC [NORM_LT, DOT_LSUB, DOT_RSUB] THEN REAL_ARITH_TAC)

  let CLOSEST_POINT_UNIQUE ← prove
   r"!s a x:real^N.
        convex s /\ closed s /\ x IN s /\
        (!z. z IN s ==> dist(a,x) <= dist(a,z))
        ==> x = closest_point s a"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC ANY_CLOSEST_POINT_UNIQUE THEN
    MAP_EVERY EXISTS_TAC [← q r"s:real^N->bool", ← q r"a:real^N"] THEN
    ASM_MESON_TAC [CLOSEST_POINT_EXISTS, MEMBER_NOT_EMPTY])

  let CLOSEST_POINT_DOT ← prove
   r"!s a x:real^N.
        convex s /\ closed s /\ x IN s
        ==> (a - closest_point s a) dot (x - closest_point s a) <= &0"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC ANY_CLOSEST_POINT_DOT THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN
    ASM_MESON_TAC [CLOSEST_POINT_EXISTS, MEMBER_NOT_EMPTY])

  let CLOSEST_POINT_LT ← prove
   r"!s a x. convex s /\ closed s /\ x IN s /\ ~(x = closest_point s a)
           ==> dist(a,closest_point s a) < dist(a,x)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [← GSYM REAL_NOT_LE, CONTRAPOS_THM] THEN
    DISCH_TAC THEN MATCH_MP_TAC CLOSEST_POINT_UNIQUE THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [CLOSEST_POINT_LE, REAL_LE_TRANS])

  let CLOSEST_POINT_LIPSCHITZ ← prove
   r"!s x y:real^N.
        convex s /\ closed s /\ ~(s = {})
        ==> dist(closest_point s x,closest_point s y) <= dist(x,y)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [dist, NORM_LE] THEN
    SUBGOAL_THEN
     (← q r"(x - closest_point s x :real^N) dot
      (closest_point s y - closest_point s x) <= &0 /\
      (y - closest_point s y) dot
      (closest_point s x - closest_point s y) <= &0")
    MP_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC ANY_CLOSEST_POINT_DOT THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_MESON_TAC [CLOSEST_POINT_EXISTS],
      MP_TAC (← ISPEC (← q r"(x - closest_point s x :real^N) - (y - closest_point s y)")
                   DOT_POS_LE) THEN
      REWRITE_TAC [NORM_LT, DOT_LSUB, DOT_RSUB, DOT_SYM] THEN REAL_ARITH_TAC])

  let CONTINUOUS_AT_CLOSEST_POINT ← prove
   r"!s x. convex s /\ closed s /\ ~(s = {})
         ==> (closest_point s) continuous (at x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [continuous_at] THEN
    ASM_MESON_TAC [CLOSEST_POINT_LIPSCHITZ, REAL_LET_TRANS])

  let CONTINUOUS_ON_CLOSEST_POINT ← prove
   r"!s t. convex s /\ closed s /\ ~(s = {})
         ==> (closest_point s) continuous_on t"
   (MESON_TAC [CONTINUOUS_AT_IMP_CONTINUOUS_ON, CONTINUOUS_AT_CLOSEST_POINT])

  let CLOSEST_POINT_TRANSLATION ← prove
   r"!s a:real^N.
     convex s /\ closed s /\ ~(s = {})
     ==> closest_point (IMAGE (\x. a + x) s) (a + x) =
         a + closest_point s x"
   (INTRO_TAC "!s a; cvx cld nempty" THEN
    MATCH_MP_TAC (← GSYM CLOSEST_POINT_UNIQUE) THEN
    ASM_SIMP_TAC [CONVEX_TRANSLATION, CLOSED_TRANSLATION, IN_IMAGE] THEN
    CONJ_TAC THENL
    [EXISTS_TAC (← q r"closest_point s (x:real^N)") THEN
     ASM_SIMP_TAC [CLOSEST_POINT_IN_SET],
     ALL_TAC] THEN
    INTRO_TAC "!z; @y. zdef yhp" THEN REMOVE_THEN "zdef" SUBST1_TAC THEN
    SUBGOAL_THEN (← q r"dist(x:real^N,closest_point s x) <= dist(x,y)") MP_TAC THENL
    [ASM_SIMP_TAC [CLOSEST_POINT_LE], ALL_TAC] THEN NORM_ARITH_TAC)

  let ANY_CLOSEST_POINT_AFFINE_ORTHOGONAL ← prove
   r"!s a b:real^N.
        affine s /\ b IN s /\ (!x. x IN s ==> dist(a,b) <= dist(a,x))
        ==> (!x. x IN s ==> orthogonal (x - b) (a - b))"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"b:real^N") THEN
    REWRITE_TAC [DIST_0, VECTOR_SUB_RZERO, orthogonal, dist, NORM_LE] THEN
    REWRITE_TAC [DOT_LSUB] THEN REWRITE_TAC [DOT_RSUB] THEN
    REWRITE_TAC [DOT_SYM, ← REAL_ARITH (← q r"a <= a - y - (y - x) <=> &2 * y <= x")] THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
    ASM_REWRITE_TAC [DOT_RZERO] THEN FIRST_X_ASSUM (fun th => tactic_of do
     pure (MP_TAC (← SPEC (← q r"vec 0 + --((a dot x) / (x dot x)) % (x - vec 0:real^N)") th) THEN
           MP_TAC (← SPEC (← q r"vec 0 + (a dot x) / (x dot x) % (x - vec 0:real^N)") th))) THEN
    ASM_SIMP_TAC [IN_AFFINE_ADD_MUL_DIFF] THEN
    REWRITE_TAC [VECTOR_SUB_RZERO, VECTOR_ADD_LID, DOT_RMUL] THEN
    REWRITE_TAC [DOT_LMUL, IMP_IMP] THEN DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"&2 * x * a <= b * c * z /\ &2 * --x * a <= --b * --c * z
      ==> &2 * abs(x * a) <= b * c * z"))) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [REAL_NOT_LE, REAL_DIV_RMUL, DOT_EQ_0] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"~(x = &0) ==> x < &2 * abs x")) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DOT_EQ_0]) THEN
    REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => REAL_FIELD t))

  let ORTHOGONAL_ANY_CLOSEST_POINT ← prove
   r"!s a b:real^N.
        b IN s /\ (!x. x IN s ==> orthogonal (x - b) (a - b))
        ==> (!x. x IN s ==> dist(a,b) <= dist(a,x))"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"b:real^N") THEN
    REWRITE_TAC [dist, NORM_LE, orthogonal, VECTOR_SUB_RZERO] THEN
    SIMP_TAC [DOT_LSUB, DOT_RSUB, DOT_SYM] THEN
    REWRITE_TAC [DOT_POS_LE, ← REAL_ARITH (← q r"a <= a - &0 - (&0 - x) <=> &0 <= x")])

  let CLOSEST_POINT_AFFINE_ORTHOGONAL ← prove
   r"!s a:real^N x.
        affine s /\ ~(s = {}) /\ x IN s
        ==> orthogonal (x - closest_point s a) (a - closest_point s a)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    DISCH_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    MATCH_MP_TAC ANY_CLOSEST_POINT_AFFINE_ORTHOGONAL THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSEST_POINT_EXISTS THEN
    ASM_SIMP_TAC [CLOSED_AFFINE])

  let CLOSEST_POINT_AFFINE_ORTHOGONAL_EQ ← prove
   r"!s a b:real^N.
        affine s /\ b IN s
        ==> (closest_point s a = b <=>
             !x. x IN s ==> orthogonal (x - b) (a - b))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [CLOSEST_POINT_AFFINE_ORTHOGONAL, MEMBER_NOT_EMPTY],
      DISCH_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC CLOSEST_POINT_UNIQUE THEN
      ASM_SIMP_TAC [CLOSED_AFFINE, AFFINE_IMP_CONVEX] THEN
      MATCH_MP_TAC ORTHOGONAL_ANY_CLOSEST_POINT THEN ASM_REWRITE_TAC []])

  return { CLOSER_POINTS_LEMMA, CLOSER_POINT_LEMMA, ANY_CLOSEST_POINT_DOT,
           ANY_CLOSEST_POINT_UNIQUE, CLOSEST_POINT_UNIQUE, CLOSEST_POINT_DOT, CLOSEST_POINT_LT,
           CLOSEST_POINT_LIPSCHITZ, CONTINUOUS_AT_CLOSEST_POINT, CONTINUOUS_ON_CLOSEST_POINT,
           CLOSEST_POINT_TRANSLATION, ANY_CLOSEST_POINT_AFFINE_ORTHOGONAL,
           ORTHOGONAL_ANY_CLOSEST_POINT, CLOSEST_POINT_AFFINE_ORTHOGONAL,
           CLOSEST_POINT_AFFINE_ORTHOGONAL_EQ }

/- ------------------------------------------------------------------------- -/
/- Using "closest_point" to give orthogonal projection onto a subspace;      -/
/- stronger separating hyperplane results for affine sets / affine hulls.    -/
/- (convex.ml 6922-7066)                                                     -/
/- ------------------------------------------------------------------------- -/

structure CPS where
  CLOSEST_POINT_SUBSPACE_ORTHOGONAL_EQ : thm
  CLOSEST_POINT_SUBSPACE_ORTHOGONAL : thm
  LINEAR_CLOSEST_POINT : thm
  SELF_ADJOINT_CLOSEST_POINT : thm
  CLOSEST_POINT_IDEMPOTENT : thm
  MATRIX_INV_PROJECTION_IMAGE : thm
  MATRIX_INV_PROJECTION_IMAGE_ALT : thm
  SEPARATING_HYPERPLANE_AFFINE_AFFINE : thm
  SEPARATING_HYPERPLANE_AFFINE_HULLS : thm
  deriving Inhabited

@[nospecialize]
def setupCPS [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BCLH : CLH) (BCLP : CLP) :
    ExceptT String IO CPS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_TAC, VECTOR_ARITH, .. } := D
  let { ETA_AX, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, .. } :=
    D.core3
  let { REAL_EQ_NEG2, REAL_LT_NEG2, .. } := D.core4
  let { REAL_SUB_0, RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { o_THM, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { DIST_0, DIST_SYM, DOT_EQ_0, DOT_LNEG, DOT_RSUB, .. } := D.vec1
  let { MATRIX_EQ, MATRIX_VECTOR_MUL_ASSOC, MATRIX_VECTOR_MUL_LINEAR, MATRIX_WORKS,
        MOORE_PENROSE_PSEUDOINVERSE, .. } := D.vec2
  let { ORTHOGONAL_CLAUSES, ORTHOGONAL_LNEG, ORTHOGONAL_MUL, ORTHOGONAL_PROJECTION_ALT,
        ORTHOGONAL_PROJECTION_EQ_SELF_ADJOINT_IDEMPOTENT, ORTHOGONAL_SYM, SUBSPACE_ADD,
        SUBSPACE_IMP_NONEMPTY, SUBSPACE_LINEAR_IMAGE, SUBSPACE_MUL, SUBSPACE_SUB,
        SUBSPACE_UNIV, .. } := D.vec3
  let { VECTOR_ADD_SUB, VECTOR_NEG_EQ_0, VECTOR_NEG_SUB, VECTOR_SUB_EQ, VECTOR_SUB_LDISTRIB,
        dist, linear, orthogonal, .. } := D.vec4
  let { CLOSED_SUBSPACE, CLOSEST_POINT_EXISTS, CLOSEST_POINT_IN_SET, CLOSEST_POINT_SELF, .. } :=
    D.top1
  let { closest_point, .. } := D.top5
  let { AFFINE_DIFFERENCES, AFFINE_AFFINE_HULL, .. } := BAFF
  let { AFFINE_HULL_EQ_EMPTY, .. } := BAFS
  let { SUBSPACE_IMP_AFFINE, CLOSED_AFFINE, .. } := BCLH
  let { ANY_CLOSEST_POINT_AFFINE_ORTHOGONAL, CLOSEST_POINT_AFFINE_ORTHOGONAL_EQ, .. } := BCLP
  -- @@SCOPE END

  let CLOSEST_POINT_SUBSPACE_ORTHOGONAL_EQ ← prove
   r"!s a b:real^N.
         subspace s
         ==> (closest_point s a = b <=>
              b IN s /\ (!x. x IN s ==> orthogonal (a - b) x))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(b:real^N) IN s") THENL
     [ASM_SIMP_TAC [CLOSEST_POINT_AFFINE_ORTHOGONAL_EQ, SUBSPACE_IMP_AFFINE],
      ASM_MESON_TAC [CLOSEST_POINT_IN_SET, CLOSED_SUBSPACE,
                     SUBSPACE_IMP_NONEMPTY]] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [ORTHOGONAL_SYM] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b + x:real^N")),
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x - b:real^N"))] THEN
    ASM_SIMP_TAC [SUBSPACE_SUB, SUBSPACE_ADD, VECTOR_ADD_SUB])

  let CLOSEST_POINT_SUBSPACE_ORTHOGONAL ← prove
   r"!s a b:real^N.
        subspace s /\ b IN s ==> orthogonal (a - closest_point s a) b"
   (MESON_TAC [CLOSEST_POINT_SUBSPACE_ORTHOGONAL_EQ])

  let LINEAR_CLOSEST_POINT ← prove
   r"!s:real^N->bool. subspace s ==> linear(closest_point s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [linear] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [CLOSEST_POINT_SUBSPACE_ORTHOGONAL_EQ] THEN
    ASM_SIMP_TAC [SUBSPACE_ADD, SUBSPACE_MUL, CLOSEST_POINT_IN_SET,
                  CLOSED_SUBSPACE, SUBSPACE_IMP_NONEMPTY]
    THENL
     [REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← VECTOR_ARITH
       (← q r"(x + y) - (a + b):real^N = (x - a) + (y - b)")] THEN
      MATCH_MP_TAC (← liftExcept (el 8 (CONJUNCTS ORTHOGONAL_CLAUSES))),
      REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, ORTHOGONAL_MUL]] THEN
    ASM_MESON_TAC [CLOSEST_POINT_SUBSPACE_ORTHOGONAL_EQ])

  let SELF_ADJOINT_CLOSEST_POINT ← prove
   r"!s:real^N->bool.
        subspace s ==> adjoint(closest_point s) = closest_point s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"closest_point(s:real^N->bool)")
     ORTHOGONAL_PROJECTION_EQ_SELF_ADJOINT_IDEMPOTENT) THEN
    ASM_SIMP_TAC [ORTHOGONAL_PROJECTION_ALT, LINEAR_CLOSEST_POINT, ETA_AX] THEN
    MATCH_MP_TAC (← TAUT (← q r"p ==> (p <=> q /\ r) ==> q")) THEN
    REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM VECTOR_NEG_SUB] THEN
    REWRITE_TAC [ORTHOGONAL_LNEG] THEN
    MATCH_MP_TAC CLOSEST_POINT_SUBSPACE_ORTHOGONAL THEN
    ASM_SIMP_TAC [CLOSEST_POINT_IN_SET, CLOSED_SUBSPACE,
                  SUBSPACE_IMP_NONEMPTY])

  let CLOSEST_POINT_IDEMPOTENT ← prove
   r"!s:real^N->bool.
        closed s ==> closest_point s o closest_point s = closest_point s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM, o_THM] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [closest_point, NOT_IN_EMPTY],
      ASM_SIMP_TAC [CLOSEST_POINT_SELF, CLOSEST_POINT_IN_SET]])

  let (MATRIX_INV_PROJECTION_IMAGE, MATRIX_INV_PROJECTION_IMAGE_ALT) ← CONJ_PAIR (← prove
   r"(!A:real^M^N. A ** matrix_inv A =
                 matrix(closest_point (IMAGE (\x. A ** x) UNIV))) /\
   (!A:real^M^N x. (A ** matrix_inv A) ** x =
                  closest_point (IMAGE (\x. A ** x) UNIV) x)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    SIMP_TAC [MATRIX_EQ, MATRIX_WORKS, ← GSYM MATRIX_VECTOR_MUL_ASSOC,
              LINEAR_CLOSEST_POINT, MATRIX_VECTOR_MUL_LINEAR,
              SUBSPACE_LINEAR_IMAGE, SUBSPACE_UNIV,
              CLOSEST_POINT_SUBSPACE_ORTHOGONAL_EQ] THEN
    REPEAT GEN_TAC THEN
    (CONJ_TAC THENL [SET_TAC [], REWRITE_TAC [FORALL_IN_IMAGE]]) THEN
    REWRITE_TAC [MOORE_PENROSE_PSEUDOINVERSE]))

  let SEPARATING_HYPERPLANE_AFFINE_AFFINE ← prove
   r"!s t:real^N->bool.
        affine s /\ affine t /\ ~(s = {}) /\ ~(t = {}) /\ DISJOINT s t
        ==> ?a b c. ~(a = vec 0) /\ b < c /\
                    (!x. x IN s ==> a dot x = b) /\
                    (!x. x IN t ==> a dot x = c)"
   (SUBGOAL_THEN
     (← q r"!s t:real^N->bool.
          affine s /\ affine t /\ ~(s = {}) /\ ~(t = {}) /\ DISJOINT s t
          ==> ?a b c. ~(a = vec 0) /\ ~(b = c) /\
                      (!x. x IN s ==> a dot x = b) /\
                      (!x. x IN t ==> a dot x = c)")
    MP_TAC THENL
     [ALL_TAC,
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real", ← q r" c:real"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
       (← q r"~(x = y) ==> x < y \/ y < x")))
      THENL
       [MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"b:real", ← q r"c:real"],
        MAP_EVERY EXISTS_TAC [← q r"--a:real^N", ← q r"--b:real", ← q r"--c:real"]] THEN
      ASM_REWRITE_TAC [REAL_LT_NEG2, DOT_LNEG, REAL_EQ_NEG2] THEN
      ASM_REWRITE_TAC [VECTOR_NEG_EQ_0]] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?u v. u IN s /\ v IN t /\
            !x y:real^N. x IN s /\ y IN t ==> dist(u,v) <= dist(x,y)")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"{x - y:real^N | x IN s /\ y IN t}", ← q r"vec 0:real^N"]
        CLOSEST_POINT_EXISTS) THEN
      ASM_SIMP_TAC [CLOSED_AFFINE, AFFINE_DIFFERENCES, DIST_0] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, dist] THEN REWRITE_TAC [IN_ELIM_THM] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"d:real^N = u - v") THEN EXISTS_TAC (← q r"d:real^N") THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [EXPAND_TAC "d" THEN REWRITE_TAC [VECTOR_SUB_EQ] THEN ASM SET_TAC [],
      DISCH_TAC] THEN
    MAP_EVERY EXISTS_TAC [← q r"(d:real^N) dot u", ← q r"(d:real^N) dot v"] THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SUB_0] THEN REWRITE_TAC [← GSYM DOT_RSUB] THEN
    ASM_REWRITE_TAC [DOT_EQ_0] THEN CONJ_TAC THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"v:real^N", ← q r"u:real^N"]
          ANY_CLOSEST_POINT_AFFINE_ORTHOGONAL),
      MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"u:real^N", ← q r"v:real^N"]
          ANY_CLOSEST_POINT_AFFINE_ORTHOGONAL)] THEN
    (ANTS_TAC THENL [ASM_MESON_TAC [DIST_SYM], ALL_TAC]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [ORTHOGONAL_SYM] THEN
    ASM_REWRITE_TAC [← GSYM orthogonal] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM ORTHOGONAL_LNEG] THEN
    ASM_REWRITE_TAC [VECTOR_NEG_SUB])

  let SEPARATING_HYPERPLANE_AFFINE_HULLS ← prove
   r"!s t:real^N->bool.
        ~(s = {}) /\ ~(t = {}) /\ DISJOINT (affine hull s) (affine hull t)
        ==> ?a b c. ~(a = vec 0) /\ b < c /\
                    (!x. x IN s ==> a dot x = b) /\
                    (!x. x IN t ==> a dot x = c)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"affine hull s:real^N->bool", ← q r"affine hull t:real^N->bool"]
          SEPARATING_HYPERPLANE_AFFINE_AFFINE) THEN
    ASM_REWRITE_TAC [AFFINE_HULL_EQ_EMPTY, AFFINE_AFFINE_HULL] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN MESON_TAC [HULL_INC])

  return { CLOSEST_POINT_SUBSPACE_ORTHOGONAL_EQ, CLOSEST_POINT_SUBSPACE_ORTHOGONAL,
           LINEAR_CLOSEST_POINT, SELF_ADJOINT_CLOSEST_POINT, CLOSEST_POINT_IDEMPOTENT,
           MATRIX_INV_PROJECTION_IMAGE, MATRIX_INV_PROJECTION_IMAGE_ALT,
           SEPARATING_HYPERPLANE_AFFINE_AFFINE, SEPARATING_HYPERPLANE_AFFINE_HULLS }

/- ------------------------------------------------------------------------- -/
/- Various point-to-set separating/supporting hyperplane theorems.           -/
/- (convex.ml 7068-7190)                                                     -/
/- ------------------------------------------------------------------------- -/

structure SEP where
  SUPPORTING_HYPERPLANE_COMPACT_POINT_SUP : thm
  SUPPORTING_HYPERPLANE_COMPACT_POINT_INF : thm
  SUPPORTING_HYPERPLANE_CLOSED_POINT : thm
  SEPARATING_HYPERPLANE_CLOSED_POINT_INSET : thm
  SEPARATING_HYPERPLANE_CLOSED_0_INSET : thm
  SEPARATING_HYPERPLANE_CLOSED_POINT : thm
  SEPARATING_HYPERPLANE_CLOSED_0 : thm
  deriving Inhabited

@[nospecialize]
def setupSEP [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCLP : CLP) : ExceptT String IO SEP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, VECTOR_ARITH, .. } := D
  let { ARITH, CONTRAPOS_THM, DIMINDEX_GE_1, .. } := D.core1
  let { LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LT_01, REAL_LT_ADDR, REAL_LT_ANTISYM, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_LDIV_EQ, .. } := D.core4
  let { REAL_NEG_EQ, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_LT, REAL_POW_LT,
        REAL_SUB_LT, .. } := D.core5
  let { o_ASSOC, o_DEF, real_ge, real_gt, .. } := D.core6
  let { DIST_SYM, DOT_LNEG, DOT_LZERO, DOT_POS_LE, DOT_POS_LT, DOT_RSUB, DOT_RZERO, .. } :=
    D.vec1
  let { NORM_BASIS, .. } := D.vec2
  let { NORM_POS_LT, NORM_POW_2, .. } := D.vec3
  let { VECTOR_NEG_SUB, VECTOR_SUB_EQ, VECTOR_SUB_RZERO, .. } := D.vec4
  let { CONTINUOUS_ATTAINS_SUP, .. } := D.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_LIFT_DOT,
        CONTINUOUS_ON_SUB, DISTANCE_ATTAINS_INF, .. } := D.top3
  let { CONVEX_ALT, .. } := BCVX
  let { CLOSER_POINT_LEMMA, .. } := BCLP
  -- @@SCOPE END

  let SUPPORTING_HYPERPLANE_COMPACT_POINT_SUP ← prove
   r"!a c s:real^N->bool.
        compact s /\ ~(s = {})
        ==> ?b y. y IN s /\ a dot (y - c) = b /\
                  (!x. x IN s ==> a dot (x - c) <= b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x:real^N. a dot (x - c)", ← q r"s:real^N->bool"]
          CONTINUOUS_ATTAINS_SUP) THEN
    ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    SUBGOAL_THEN (← q r"(\x:real^N. a dot (x - c)) = (\x. a dot x) o (\x. x - c)")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    REWRITE_TAC [o_ASSOC] THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [CONTINUOUS_ON_LIFT_DOT, CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST,
              CONTINUOUS_ON_ID])

  let SUPPORTING_HYPERPLANE_COMPACT_POINT_INF ← prove
   r"!a c s:real^N->bool.
        compact s /\ ~(s = {})
        ==> ?b y. y IN s /\ a dot (y - c) = b /\
                  (!x. x IN s ==> a dot (x - c) >= b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"--a:real^N", ← q r"c:real^N", ← q r"s:real^N->bool"]
      SUPPORTING_HYPERPLANE_COMPACT_POINT_SUP) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real")
     (fun th => tactic_of do pure (EXISTS_TAC (← q r"--b:real") THEN MP_TAC th))) THEN
    REWRITE_TAC [DOT_LNEG, ← REAL_ARITH (← q r"x >= -- b <=> --x <= b")] THEN
    REWRITE_TAC [REAL_NEG_EQ])

  let SUPPORTING_HYPERPLANE_CLOSED_POINT ← prove
   r"!s z:real^N. convex s /\ closed s /\ ~(s = {}) /\ ~(z IN s)
                ==> ?a b y. a dot z < b /\ y IN s /\ (a dot y = b) /\
                            (!x. x IN s ==> a dot x >= b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"z:real^N"] DISTANCE_ATTAINS_INF) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"y - z:real^N") THEN EXISTS_TAC (← q r"(y - z:real^N) dot y") THEN
    EXISTS_TAC (← q r"y:real^N") THEN ONCE_REWRITE_TAC [← GSYM REAL_SUB_LT] THEN
    ASM_REWRITE_TAC [← GSYM DOT_RSUB, DOT_POS_LT, VECTOR_SUB_EQ] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_TAC THEN SUBGOAL_THEN
     (← q r"!u. &0 <= u /\ u <= &1 ==> dist(z:real^N,y) <= dist(z,(&1 - u) % y + u % x)")
    MP_TAC THENL [ASM_MESON_TAC [CONVEX_ALT], ALL_TAC] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
    REWRITE_TAC [real_ge, REAL_NOT_LE, NOT_FORALL_THM, NOT_IMP] THEN
    GEN_REWRITE_TAC LAND_CONV [← REAL_ARITH (← q r"x < y <=> y - x > &0")] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"(a - b) dot x - (a - b) dot y = (b - a) dot (y - x)")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CLOSER_POINT_LEMMA) THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"y + u % (x - y) = (&1 - u) % y + u % x")] THEN
    MESON_TAC [REAL_LT_IMP_LE])

  let SEPARATING_HYPERPLANE_CLOSED_POINT_INSET ← prove
   r"!s z:real^N. convex s /\ closed s /\ ~(s = {}) /\ ~(z IN s)
                ==> ?a b. a IN s /\
                          (a - z) dot z < b /\
                          (!x. x IN s ==> (a - z) dot x > b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"z:real^N"] DISTANCE_ATTAINS_INF) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"y:real^N") THEN ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"(y - z:real^N) dot z + norm(y - z) pow 2 / &2") THEN
    SUBGOAL_THEN (← q r"&0 < norm(y - z:real^N)") ASSUME_TAC THENL
     [ASM_MESON_TAC [NORM_POS_LT, VECTOR_SUB_EQ], ALL_TAC] THEN
    ASM_SIMP_TAC [REAL_LT_ADDR, REAL_LT_DIV, REAL_POW_LT,
                  REAL_OF_NUM_LT, ARITH] THEN
    REWRITE_TAC [NORM_POW_2, ← REAL_ARITH (← q r"a > b + c <=> c < a - b")] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SIMP_TAC [REAL_LT_LDIV_EQ, REAL_OF_NUM_LT, ARITH] THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SUB_LT] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"((y - z) dot x - (y - z) dot z) * &2 - (y - z) dot (y - z) =
      &2 * ((y - z) dot (x - y)) + (y - z) dot (y - z)")] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"~(--x > &0) /\ &0 < y ==> &0 < &2 * x + y")) THEN
    ASM_SIMP_TAC [← GSYM NORM_POW_2, REAL_POW_LT] THEN
    REWRITE_TAC [← GSYM DOT_LNEG, VECTOR_NEG_SUB] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CLOSER_POINT_LEMMA) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
    GEN_TAC THEN REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [REAL_NOT_LT] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"y + u % (x - y) = (&1 - u) % y + u % x")] THEN
    ASM_MESON_TAC [CONVEX_ALT, REAL_LT_IMP_LE])

  let SEPARATING_HYPERPLANE_CLOSED_0_INSET ← prove
   r"!s:real^N->bool.
        convex s /\ closed s /\ ~(s = {}) /\ ~(vec 0 IN s)
        ==> ?a b. a IN s /\ ~(a = vec 0) /\ &0 < b /\
                  (!x. x IN s ==> a dot x > b)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SEPARATING_HYPERPLANE_CLOSED_POINT_INSET) THEN
    REWRITE_TAC [DOT_RZERO, real_gt] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    SIMP_TAC [VECTOR_SUB_RZERO] THEN ASM_MESON_TAC [])

  let SEPARATING_HYPERPLANE_CLOSED_POINT ← prove
   r"!s z:real^N. convex s /\ closed s /\ ~(z IN s)
                ==> ?a b. a dot z < b /\ (!x. x IN s ==> a dot x > b)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [MAP_EVERY EXISTS_TAC [← q r"--z:real^N", ← q r"&1"] THEN
      SIMP_TAC [DOT_LNEG, ← REAL_ARITH (← q r"&0 <= x ==> --x < &1"), DOT_POS_LE] THEN
      ASM_MESON_TAC [NOT_IN_EMPTY],
      ALL_TAC] THEN
    ASM_MESON_TAC [SEPARATING_HYPERPLANE_CLOSED_POINT_INSET])

  let SEPARATING_HYPERPLANE_CLOSED_0 ← prove
   r"!s:real^N->bool.
        convex s /\ closed s /\ ~(vec 0 IN s)
        ==> ?a b. ~(a = vec 0) /\ &0 < b /\ (!x. x IN s ==> a dot x > b)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [EXISTS_TAC (← q r"basis 1:real^N") THEN EXISTS_TAC (← q r"&1") THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY, REAL_LT_01, ← GSYM NORM_POS_LT] THEN
      ASM_SIMP_TAC [NORM_BASIS, DIMINDEX_GE_1, LE_REFL, REAL_LT_01],
      FIRST_X_ASSUM (MP_TAC o MATCH_MP SEPARATING_HYPERPLANE_CLOSED_POINT) THEN
      REWRITE_TAC [DOT_RZERO, real_gt] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      ASM_MESON_TAC [MEMBER_NOT_EMPTY, DOT_LZERO, REAL_LT_ANTISYM]])

  return { SUPPORTING_HYPERPLANE_COMPACT_POINT_SUP, SUPPORTING_HYPERPLANE_COMPACT_POINT_INF,
           SUPPORTING_HYPERPLANE_CLOSED_POINT, SEPARATING_HYPERPLANE_CLOSED_POINT_INSET,
           SEPARATING_HYPERPLANE_CLOSED_0_INSET, SEPARATING_HYPERPLANE_CLOSED_POINT,
           SEPARATING_HYPERPLANE_CLOSED_0 }

/- ------------------------------------------------------------------------- -/
/- Now set-to-set for closed/compact sets.  (convex.ml 7194-7315)            -/
/- ------------------------------------------------------------------------- -/

structure SSC where
  SEPARATING_HYPERPLANE_CLOSED_COMPACT : thm
  SEPARATING_HYPERPLANE_COMPACT_CLOSED : thm
  SEPARATING_HYPERPLANE_COMPACT_CLOSED_NONZERO : thm
  SEPARATING_HYPERPLANE_COMPACT_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupSSC [HolBase] (D : ConvexDeps) (BCVA : CVA) (BSEP : SEP) : ExceptT String IO SSC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, .. } := D
  let { ARITH, DIMINDEX_GE_1, DISJOINT, DISJOINT_SYM, EQ_SYM_EQ, EXISTS_REFL,
        EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ, .. } := D.core2
  let { IN_ELIM_THM, IN_INTER, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, LE_REFL,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LT_ANTISYM, REAL_LT_DIV, REAL_LT_NEG2, REAL_LT_SUB_LADD, .. } := D.core4
  let { REAL_OF_NUM_LT, RIGHT_FORALL_IMP_THM, .. } := D.core5
  let { SUP, SWAP_FORALL_THM, o_DEF, real_gt, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { BASIS_NONZERO, DOT_LNEG, DOT_LZERO, DOT_RSUB, DOT_RZERO, .. } := D.vec1
  let { NORM_LIFT, .. } := D.vec3
  let { VECTOR_CHOOSE_SIZE, VECTOR_NEG_EQ_0, VECTOR_SUB_EQ, .. } := D.vec4
  let { BOUNDED_POS, BOUNDED_POS_LT, CLOSED_COMPACT_DIFFERENCES, .. } := D.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := D.top2
  let { CONTINUOUS_ON_LIFT_DOT, .. } := D.top3
  let { CONVEX_DIFFERENCES, .. } := BCVA
  let { SEPARATING_HYPERPLANE_CLOSED_POINT, .. } := BSEP
  -- @@SCOPE END

  let SEPARATING_HYPERPLANE_CLOSED_COMPACT ← prove
   r"!s t. convex s /\ closed s /\
         convex t /\ compact t /\ ~(t = {}) /\ DISJOINT s t
         ==> ?a:real^N b. (!x. x IN s ==> a dot x < b) /\
                          (!x. x IN t ==> a dot x > b)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
      REWRITE_TAC [BOUNDED_POS] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"?z:real^N. norm(z) = b + &1") CHOOSE_TAC THENL
       [ASM_SIMP_TAC [VECTOR_CHOOSE_SIZE, ← REAL_ARITH (← q r"&0 < b ==> &0 <= b + &1")],
        ALL_TAC] THEN
      MP_TAC (← SPECL [← q r"t:real^N->bool", ← q r"z:real^N"]
         SEPARATING_HYPERPLANE_CLOSED_POINT) THEN
      ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
      ASM_MESON_TAC [← REAL_ARITH (← q r"~(b + &1 <= b)")],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"{x - y:real^N | x IN s /\ y IN t}", ← q r"vec 0 :real^N"]
                  SEPARATING_HYPERPLANE_CLOSED_POINT) THEN
    ASM_SIMP_TAC [CLOSED_COMPACT_DIFFERENCES, CONVEX_DIFFERENCES] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [IN_ELIM_THM] THEN ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN
      REWRITE_TAC [VECTOR_SUB_EQ] THEN
      ASM_MESON_TAC [DISJOINT, NOT_IN_EMPTY, IN_INTER, EXTENSION],
      ALL_TAC] THEN
    SIMP_TAC [DOT_RZERO, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [SWAP_FORALL_THM] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [LEFT_FORALL_IMP_THM, EXISTS_REFL, DOT_RSUB] THEN
    REWRITE_TAC [real_gt, REAL_LT_SUB_LADD] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"--a:real^N") THEN
    MP_TAC (← SPEC (← q r"IMAGE (\x:real^N. a dot x) t") SUP) THEN
    ABBREV_TAC (← q r"k = sup (IMAGE (\x:real^N. a dot x) t)") THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [← REAL_ARITH (← q r"b + x < y ==> x <= y - b"), MEMBER_NOT_EMPTY],
      ALL_TAC] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"--(k + b / &2)") THEN
    REWRITE_TAC [DOT_LNEG, REAL_LT_NEG2] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH,
                  ← REAL_ARITH (← q r"&0 < b /\ x <= k ==> x < k + b")] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k - b / &2")) THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"k <= k - b2 <=> ~(&0 < b2)"), REAL_LT_DIV,
       REAL_OF_NUM_LT, ARITH, NOT_FORALL_THM, LEFT_IMP_EXISTS_THM, NOT_IMP] THEN
    X_GEN_TAC (← q r"y:real^N") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"!b. (b2 + b2 = b) /\ b + ay < ax ==> ~(ay <= k - b2) ==> k + b2 < ax")) THEN
    ASM_MESON_TAC [REAL_HALF])

  let SEPARATING_HYPERPLANE_COMPACT_CLOSED ← prove
   r"!s t. convex s /\ compact s /\ ~(s = {}) /\
         convex t /\ closed t /\ DISJOINT s t
         ==> ?a:real^N b. (!x. x IN s ==> a dot x < b) /\
                          (!x. x IN t ==> a dot x > b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"s:real^N->bool"]
        SEPARATING_HYPERPLANE_CLOSED_COMPACT) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [DISJOINT_SYM], ALL_TAC] THEN
    REWRITE_TAC [real_gt] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") (X_CHOOSE_THEN (← q r"b:real")
      STRIP_ASSUME_TAC)) THEN
    MAP_EVERY EXISTS_TAC [← q r"--a:real^N", ← q r"--b:real"] THEN
    ASM_REWRITE_TAC [REAL_LT_NEG2, DOT_LNEG])

  let SEPARATING_HYPERPLANE_COMPACT_CLOSED_NONZERO ← prove
   r"!s t:real^N->bool.
           convex s /\ compact s /\ ~(s = {}) /\
           convex t /\ closed t /\ DISJOINT s t
           ==> ?a b. ~(a = vec 0) /\
                     (!x. x IN s ==> a dot x < b) /\
                     (!x. x IN t ==> a dot x > b)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"basis 1:real^N") THEN
      SUBGOAL_THEN
       (← q r"bounded(IMAGE (\x:real^N. lift(basis 1 dot x)) s)")
      MP_TAC THENL
       [MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
        MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
        ASM_SIMP_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_ON_LIFT_DOT],
        REWRITE_TAC [BOUNDED_POS_LT, FORALL_IN_IMAGE, NORM_LIFT] THEN
        SIMP_TAC [BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
        MESON_TAC [← REAL_ARITH (← q r"abs x < b ==> x < b")]],
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]
          SEPARATING_HYPERPLANE_COMPACT_CLOSED) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      ASM_CASES_TAC (← q r"a:real^N = vec 0") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [DOT_LZERO, real_gt] THEN
      ASM_MESON_TAC [REAL_LT_ANTISYM, MEMBER_NOT_EMPTY]])

  let SEPARATING_HYPERPLANE_COMPACT_COMPACT ← prove
   r"!s t:real^N->bool.
           convex s /\ compact s /\ convex t /\ compact t /\ DISJOINT s t
           ==> ?a b. ~(a = vec 0) /\
                     (!x. x IN s ==> a dot x < b) /\
                     (!x. x IN t ==> a dot x > b)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"--basis 1:real^N") THEN
      SUBGOAL_THEN
       (← q r"bounded(IMAGE (\x:real^N. lift(basis 1 dot x)) t)")
      MP_TAC THENL
       [MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
        MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
        ASM_SIMP_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_ON_LIFT_DOT],
        REWRITE_TAC [BOUNDED_POS_LT, FORALL_IN_IMAGE, NORM_LIFT] THEN
        SIMP_TAC [VECTOR_NEG_EQ_0, BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"--b:real") THEN REWRITE_TAC [DOT_LNEG] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"--x > --y <=> x < y")] THEN
        ASM_MESON_TAC [← REAL_ARITH (← q r"abs x < b ==> x < b")]],
      STRIP_TAC THEN
      MATCH_MP_TAC SEPARATING_HYPERPLANE_COMPACT_CLOSED_NONZERO THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED]])

  return { SEPARATING_HYPERPLANE_CLOSED_COMPACT, SEPARATING_HYPERPLANE_COMPACT_CLOSED,
           SEPARATING_HYPERPLANE_COMPACT_CLOSED_NONZERO, SEPARATING_HYPERPLANE_COMPACT_COMPACT }

/- ------------------------------------------------------------------------- -/
/- General case without assuming closure and getting non-strict separation. -/
/- (convex.ml 7319-7433)                                                     -/
/- ------------------------------------------------------------------------- -/

structure GNS where
  SEPARATING_HYPERPLANE_SET_0_INSPAN : thm
  SEPARATING_HYPERPLANE_SET_POINT_INAFF : thm
  SEPARATING_HYPERPLANE_SET_0 : thm
  SEPARATING_HYPERPLANE_SETS : thm
  deriving Inhabited

@[nospecialize]
def setupGNS [HolBase] (D : ConvexDeps) (BAFS : AFS) (BCVX : CVX) (BCVA : CVA) (BCVH : CVH)
    (BOCH : OCH) (BSEP : SEP) : ExceptT String IO GNS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_TAC, VECTOR_ARITH, .. } := D
  let { DIMINDEX_GE_1, DISJOINT, EQ_SYM_EQ, EXISTS_REFL, EXTENSION, FINITE_SUBSET_IMAGE, .. } :=
    D.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMP_CONJ, INTERS_0, INTER_UNIV, .. } :=
    D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_INTERS, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM,
        LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IN_EMPTY,
        REAL_ABS_INV, .. } := D.core3
  let { REAL_EQ_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01,
        REAL_LT_IMP_LE, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_SYM, REAL_SUB_LE,
        RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, .. } := D.core5
  let { SUP, SWAP_FORALL_THM, UNWIND_THM2, real_div, real_ge, real_gt, .. } := D.core6
  let { HULL_MINIMAL, HULL_SUBSET, SUBSET_HULL, .. } := D.misc
  let { BASIS_NONZERO, DIST_0, DOT_RMUL, DOT_RSUB, DOT_RZERO, .. } := D.vec1
  let { DOT_SYM, NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_NEG, NORM_POS_LT, REAL_ABS_NORM, SPAN_CLAUSES, .. } := D.vec3
  let { VECTOR_SUB_EQ, VECTOR_SUB_LZERO, dist, .. } := D.vec4
  let { CLOSED_HALFSPACE_GE, CLOSED_INTER_COMPACT, CLOSED_SPAN, .. } := D.top1
  let { COMPACT_CBALL, COMPACT_FRONTIER, COMPACT_IMP_CLOSED, COMPACT_IMP_FIP, .. } := D.top2
  let { FRONTIER_CBALL, .. } := D.top3
  let { IN_SPHERE_0, .. } := D.top4
  let { AFFINE_HULL_INSERT_SPAN, .. } := BAFS
  let { CONVEX_TRANSLATION, .. } := BCVX
  let { CONVEX_DIFFERENCES, .. } := BCVA
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EQ_EMPTY, .. } := BCVH
  let { FINITE_IMP_COMPACT_CONVEX_HULL, .. } := BOCH
  let { SEPARATING_HYPERPLANE_CLOSED_0_INSET, .. } := BSEP
  -- @@SCOPE END

  let SEPARATING_HYPERPLANE_SET_0_INSPAN ← prove
   r"!s:real^N->bool.
        convex s /\ ~(s = {}) /\ ~(vec 0 IN s)
        ==> ?a b. a IN span s /\ ~(a = vec 0) /\
                  !x. x IN s ==> &0 <= a dot x"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"k = \c:real^N. {x | &0 <= c dot x}") THEN
    SUBGOAL_THEN
     (← q r"~((span s INTER frontier(cball(vec 0:real^N,&1))) INTER
        (INTERS (IMAGE k (s:real^N->bool))) = {})")
    MP_TAC THENL
     [ALL_TAC,
      SIMP_TAC [EXTENSION, NOT_IN_EMPTY, IN_INTER, IN_INTERS, NOT_FORALL_THM,
                FORALL_IN_IMAGE, FRONTIER_CBALL, REAL_LT_01] THEN
      EXPAND_TAC "k" THEN REWRITE_TAC [IN_SPHERE_0, IN_ELIM_THM, NORM_NEG] THEN
      MESON_TAC [NORM_EQ_0, ← REAL_ARITH (← q r"~(&1 = &0)"), DOT_SYM]] THEN
    MATCH_MP_TAC COMPACT_IMP_FIP THEN
    SIMP_TAC [COMPACT_CBALL, COMPACT_FRONTIER, FORALL_IN_IMAGE,
              CLOSED_INTER_COMPACT, CLOSED_SPAN] THEN
    CONJ_TAC THENL
     [EXPAND_TAC "k" THEN REWRITE_TAC [← GSYM real_ge, CLOSED_HALFSPACE_GE],
      ALL_TAC] THEN
    REWRITE_TAC [FINITE_SUBSET_IMAGE] THEN GEN_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N->bool") MP_TAC) THEN
    ASM_CASES_TAC (← q r"c:real^N->bool = {}") THENL
     [ASM_SIMP_TAC [INTERS_0, INTER_UNIV, IMAGE_CLAUSES] THEN
      DISCH_THEN (K ALL_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
      SUBGOAL_THEN (← q r"~(a:real^N = vec 0)") ASSUME_TAC THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"inv(norm a) % a:real^N") THEN
      ASM_SIMP_TAC [IN_INTER, FRONTIER_CBALL, SPAN_CLAUSES, IN_SPHERE_0] THEN
      REWRITE_TAC [DIST_0, NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, NORM_EQ_0],
      ALL_TAC] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPEC (← q r"convex hull (c:real^N->bool)")
        SEPARATING_HYPERPLANE_CLOSED_0_INSET) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [CONVEX_HULL_EQ_EMPTY] THEN
      ASM_MESON_TAC [CONVEX_CONVEX_HULL, SUBSET, SUBSET_HULL, HULL_SUBSET,
                     FINITE_IMP_COMPACT_CONVEX_HULL, COMPACT_IMP_CLOSED],
      ALL_TAC] THEN
    REWRITE_TAC [DOT_RZERO, real_gt] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") (X_CHOOSE_THEN (← q r"b:real")
      STRIP_ASSUME_TAC)) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_INTERS, FORALL_IN_IMAGE] THEN
    EXPAND_TAC "k" THEN SIMP_TAC [IN_ELIM_THM, FRONTIER_CBALL, REAL_LT_01] THEN
    REWRITE_TAC [dist, VECTOR_SUB_LZERO, NORM_NEG] THEN
    EXISTS_TAC (← q r"inv(norm(a)) % a:real^N") THEN REWRITE_TAC [DOT_RMUL] THEN
    SUBGOAL_THEN (← q r"(a:real^N) IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, HULL_MINIMAL], ASM_SIMP_TAC [SPAN_CLAUSES]] THEN
    REWRITE_TAC [IN_SPHERE_0, VECTOR_SUB_LZERO, NORM_NEG, NORM_MUL] THEN
    REWRITE_TAC [REAL_ABS_INV, REAL_ABS_NORM] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [← GSYM real_div] THEN
    ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_EQ_LDIV_EQ, NORM_POS_LT] THEN
    REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_LID] THEN
    ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_LE_TRANS, HULL_SUBSET, SUBSET, DOT_SYM])

  let SEPARATING_HYPERPLANE_SET_POINT_INAFF ← prove
   r"!s z:real^N.
        convex s /\ ~(s = {}) /\ ~(z IN s)
        ==> ?a b. (z + a) IN affine hull (z INSERT s) /\ ~(a = vec 0) /\
                  a dot z <= b /\ (!x. x IN s ==> a dot x >= b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\x:real^N. --z + x) s")
       SEPARATING_HYPERPLANE_SET_0_INSPAN) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, CONVEX_TRANSLATION, IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [IN_IMAGE, ← VECTOR_ARITH (← q r"vec 0:real^N = --z + x <=> x = z")] THEN
    ASM_SIMP_TAC [UNWIND_THM2, AFFINE_HULL_INSERT_SPAN, IN_ELIM_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, ← VECTOR_ARITH (← q r"--x + y:real^N = y - x")] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q r"(a:real^N) dot z") THEN REWRITE_TAC [REAL_LE_REFL] THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"x >= y <=> &0 <= x - y"), ← GSYM DOT_RSUB])

  let SEPARATING_HYPERPLANE_SET_0 ← prove
   r"!s:real^N->bool.
        convex s /\ ~(vec 0 IN s)
        ==> ?a. ~(a = vec 0) /\ !x. x IN s ==> &0 <= a dot x"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
      MESON_TAC [BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1],
      ASM_MESON_TAC [SEPARATING_HYPERPLANE_SET_0_INSPAN]])

  let SEPARATING_HYPERPLANE_SETS ← prove
   r"!s t. convex s /\ convex t /\ ~(s = {}) /\ ~(t = {}) /\ DISJOINT s t
         ==> ?a:real^N b. ~(a = vec 0) /\
                          (!x. x IN s ==> a dot x <= b) /\
                          (!x. x IN t ==> a dot x >= b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"{y - x:real^N | y IN t /\ x IN s}")
                  SEPARATING_HYPERPLANE_SET_0) THEN
    ASM_SIMP_TAC [CONVEX_DIFFERENCES] THEN ANTS_TAC THENL
     [REWRITE_TAC [IN_ELIM_THM] THEN ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN
      REWRITE_TAC [VECTOR_SUB_EQ] THEN
      ASM_MESON_TAC [DISJOINT, NOT_IN_EMPTY, IN_INTER, EXTENSION],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
    SIMP_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [SWAP_FORALL_THM] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [LEFT_FORALL_IMP_THM, EXISTS_REFL, DOT_RSUB, REAL_SUB_LE] THEN
    DISCH_TAC THEN
    MP_TAC (← SPEC (← q r"IMAGE (\x:real^N. a dot x) s") SUP) THEN
    ABBREV_TAC (← q r"k = sup (IMAGE (\x:real^N. a dot x) s)") THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, real_ge] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [MEMBER_NOT_EMPTY], ASM_MESON_TAC []])

  return { SEPARATING_HYPERPLANE_SET_0_INSPAN, SEPARATING_HYPERPLANE_SET_POINT_INAFF,
           SEPARATING_HYPERPLANE_SET_0, SEPARATING_HYPERPLANE_SETS }

/- ------------------------------------------------------------------------- -/
/- More convexity generalities.  (convex.ml 7437-7683)                       -/
/- ------------------------------------------------------------------------- -/

structure MCG where
  UNBOUNDED_COMPLEMENT_COMPONENT_CONVEX : thm
  UNBOUNDED_COMPLEMENT_CONVEX : thm
  COMPONENTS_CONVEX_COMPLEMENT_CONTAINS_HALFSPACE : thm
  CARD_COMPONENTS_COMPLEMENT_CONVEX : thm
  FINITE_COMPONENTS_COMPLEMENT_CONVEX : thm
  CONVEX_CLOSURE : thm
  CONVEX_INTERIOR : thm
  CONVEX_HULL_CLOSURE_SUBSET : thm
  CONVEX_HULL_CLOSURE : thm
  SUPPORTING_HYPERPLANE_POINT : thm
  CONVEX_ON_SETDIST : thm
  deriving Inhabited

@[nospecialize]
def setupMCG [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCOP : COP) (BCVF : CVF) (BCVH : CVH)
    (BOCH : OCH) (BSEP : SEP) (BGNS : GNS) : ExceptT String IO MCG := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, SET_TAC, HAS_SIZE_CONV, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, CHOOSE_SUBSET_STRONG, CONTRAPOS_THM, DIFF_EMPTY, DIMINDEX_GE_1,
        DISJOINT, EMPTY_SUBSET, EXTENSION, .. } := D.core1
  let { FORALL_IN_INSERT, IMP_CONJ, IMP_CONJ_ALT, INSERT_SUBSET, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_SING, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_IMP, NOT_INSERT_EMPTY, NOT_IN_EMPTY,
        REAL_ADD_RID, .. } := D.core3
  let { REAL_INV_NEG, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_IMP_LE,
        REAL_LT_INV_EQ, REAL_LT_MIN, REAL_LT_MUL, REAL_LT_REFL, .. } := D.core4
  let { REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NOT_LE, REAL_NOT_LT, RIGHT_AND_EXISTS_THM,
        RIGHT_EXISTS_AND_THM, SUBSET, SUBSET_ANTISYM, SUBSET_TRANS, .. } := D.core5
  let { SUBSET_UNIV, UNWIND_THM2, real_abs, real_ge, real_gt, .. } := D.core6
  let { HULL_MINIMAL, HULL_MONO, HULL_SUBSET, .. } := D.misc
  let { BASIS_NONZERO, COLLINEAR_LEMMA_ALT, DOT_LMUL, DOT_LZERO, .. } := D.vec1
  let { HALFSPACE_EQ_EMPTY_LE, .. } := D.vec2
  let { NORM_MUL, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LZERO, VECTOR_MUL_RCANCEL, VECTOR_SUB_LDISTRIB,
        dist, .. } := D.vec4
  let { DISJOINT_HALFSPACES_IMP_COLLINEAR, .. } := D.det
  let { BOUNDED_HALFSPACE_GT, BOUNDED_INSERT, BOUNDED_SUBSET, CLOSED_CLOSURE,
        CLOSED_HALFSPACE_GE, .. } := D.top1
  let { CLOSURE_EQ_EMPTY, CLOSURE_HALFSPACE_GT, CLOSURE_HALFSPACE_LT, CLOSURE_MINIMAL,
        CLOSURE_SEQUENTIAL, CLOSURE_SUBSET, COMPACT_CLOSURE, COMPACT_IMP_CLOSED, COMPACT_SING,
        COMPONENTS_EQ, COMPONENTS_EQ_EMPTY, COMPONENTS_MAXIMAL, COMPONENTS_UNIV,
        CONNECTED_INSERT, .. } := D.top2
  let { CONTINUOUS_ON_ID, FORALL_IN_CLOSURE, .. } := D.top3
  let { IN_BALL, IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET, IN_INTERIOR, LIM_ADD, LIM_CMUL,
        NOT_BOUNDED_UNIV, .. } := D.top4
  let { SETDIST_CLOSURE, SETDIST_COMPACT_CLOSED, SETDIST_EMPTY, SETDIST_LE_DIST,
        SUBSET_CLOSURE, .. } := D.top5
  let { convex, CONVEX_ALT, CONVEX_SING, CONVEX_HALFSPACE_LT, CONVEX_HALFSPACE_GT, .. } := BCVX
  let { CONVEX_CONNECTED, .. } := BCOP
  let { convex_on, .. } := BCVF
  let { CONVEX_CONVEX_HULL, .. } := BCVH
  let { COMPACT_CONVEX_HULL, .. } := BOCH
  let { SUPPORTING_HYPERPLANE_CLOSED_POINT, .. } := BSEP
  let { SEPARATING_HYPERPLANE_SET_POINT_INAFF, SEPARATING_HYPERPLANE_SETS, .. } := BGNS
  -- @@SCOPE END

  let UNBOUNDED_COMPLEMENT_COMPONENT_CONVEX ← prove
   r"!s c:real^N->bool.
        convex s /\ c IN components((:real^N) DIFF s) ==> ~bounded c"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_SIMP_TAC [DIFF_EMPTY, COMPONENTS_UNIV, IN_SING, NOT_BOUNDED_UNIV] THEN
    STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM MEMBER_NOT_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN s") THENL [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"{a:real^N}"]
          SEPARATING_HYPERPLANE_SETS) THEN
    ASM_REWRITE_TAC [CONVEX_SING, NOT_IMP] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N", ← q r"d:real"] THEN STRIP_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] BOUNDED_SUBSET)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a INSERT {x:real^N | ~(v dot x <= d)}")) THEN
    REWRITE_TAC [BOUNDED_INSERT] THEN
    ASM_REWRITE_TAC [BOUNDED_HALFSPACE_GT, ← GSYM real_gt, REAL_NOT_LE] THEN
    MATCH_MP_TAC COMPONENTS_MAXIMAL THEN EXISTS_TAC (← q r"(:real^N) DIFF s") THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [SIMP_TAC [CONNECTED_INSERT, CONVEX_HALFSPACE_GT, CONVEX_CONNECTED] THEN
      DISJ2_TAC THEN ASM_SIMP_TAC [CLOSURE_HALFSPACE_GT] THEN ASM SET_TAC [],
      ASM_REWRITE_TAC [INSERT_SUBSET, IN_DIFF, IN_UNIV] THEN
      ASM_REWRITE_TAC [real_gt, IN_ELIM_THM, REAL_NOT_LT, ← SET_RULE
       (← q r"s SUBSET UNIV DIFF t <=> !x. x IN t ==> ~(x IN s)")],
      ASM SET_TAC []])

  let UNBOUNDED_COMPLEMENT_CONVEX ← prove
   r"!c. convex c /\ ~(c = (:real^N)) ==> ~bounded((:real^N) DIFF c)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"(:real^N) DIFF c") COMPONENTS_EQ_EMPTY) THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF s = {} <=> s = UNIV")] THEN
    REWRITE_TAC [EXTENSION, NOT_IN_EMPTY] THEN X_GEN_TAC (← q r"k:real^N->bool") THEN
    DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          UNBOUNDED_COMPLEMENT_COMPONENT_CONVEX)) THEN
    ASM_MESON_TAC [BOUNDED_SUBSET, IN_COMPONENTS_SUBSET])

  let COMPONENTS_CONVEX_COMPLEMENT_CONTAINS_HALFSPACE ← prove
   r"!s c. convex s /\ c IN components((:real^N) DIFF s)
         ==> ?a b. ~(a = vec 0) /\ {x | a dot x <= b} SUBSET c"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_SIMP_TAC [DIFF_EMPTY, COMPONENTS_UNIV, IN_SING, SUBSET_UNIV] THEN
      MESON_TAC [BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL],
      STRIP_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, ← GSYM MEMBER_NOT_EMPTY] THEN
    X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN FIRST_ASSUM
     (MP_TAC o REWRITE_RULE [SUBSET] o MATCH_MP IN_COMPONENTS_SUBSET) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:real^N")) THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_UNIV] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"z:real^N"]
          SEPARATING_HYPERPLANE_SET_POINT_INAFF) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"b - &1") THEN ASM_REWRITE_TAC [] THEN
    TRANS_TAC SUBSET_TRANS (← q r"z INSERT {x:real^N | a dot x < b}") THEN
    CONJ_TAC THENL
     [SIMP_TAC [SUBSET, IN_ELIM_THM, IN_INSERT] THEN REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC COMPONENTS_MAXIMAL THEN EXISTS_TAC (← q r"(:real^N) DIFF s") THEN
    ASM_SIMP_TAC [CONVEX_HALFSPACE_LT, CONVEX_CONNECTED, CONNECTED_INSERT,
                  CLOSURE_HALFSPACE_LT, IN_ELIM_THM] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    ASM_REWRITE_TAC [INSERT_SUBSET, IN_UNIV, IN_DIFF] THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | P x} SUBSET UNIV DIFF s <=> s SUBSET {x | ~P x}")] THEN
    ASM_REWRITE_TAC [SUBSET, IN_ELIM_THM, ← REAL_ARITH (← q r"~(a < b) <=> a >= b")])

  let (CARD_COMPONENTS_COMPLEMENT_CONVEX, FINITE_COMPONENTS_COMPLEMENT_CONVEX) ←
    CONJ_PAIR (← prove
   r"(!s. convex s ==> CARD(components((:real^N) DIFF s)) <= 2) /\
   (!s. convex s ==> FINITE(components((:real^N) DIFF s)))"
   (REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    ASM_CASES_TAC (← q r"convex(s:real^N->bool)") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"x <= 2 <=> ~(3 <= x)")] THEN
    REWRITE_TAC [← TAUT (← q r"~p /\ q <=> ~(q ==> p)")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CHOOSE_SUBSET_STRONG) THEN
    REWRITE_TAC [← ExceptT.mk (HAS_SIZE_CONV (← q r"s HAS_SIZE 3"))] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"t:(real^N->bool)->bool", ← q r"c1:real^N->bool",
      ← q r"c2:real^N->bool", ← q r"c3:real^N->bool"] THEN
    ASM_CASES_TAC (← q r"t = {c1:real^N->bool,c2,c3}") THEN
    ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET] THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"(:real^N) DIFF s") COMPONENTS_EQ) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPECL [← q r"c1:real^N->bool", ← q r"c2:real^N->bool"] th) THEN
            MP_TAC (← SPECL [← q r"c2:real^N->bool", ← q r"c3:real^N->bool"] th) THEN
            MP_TAC (← SPECL [← q r"c3:real^N->bool", ← q r"c1:real^N->bool"] th))) THEN
    ASM_REWRITE_TAC [← GSYM DISJOINT] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool")
      COMPONENTS_CONVEX_COMPLEMENT_CONTAINS_HALFSPACE) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"c3:real^N->bool") th) THEN
            MP_TAC (← SPEC (← q r"c2:real^N->bool") th) THEN
            MP_TAC (← SPEC (← q r"c1:real^N->bool") th))) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a1:real^N", ← q r"b1:real"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a2:real^N", ← q r"b2:real"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a3:real^N", ← q r"b3:real"] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?c. &0 < c /\
          (a3:real^N = c % a1 \/ a2 = c % a1 \/ a3:real^N = c % a2)")
    MP_TAC THENL
     [MP_TAC (← ISPECL [← q r"a1:real^N", ← q r"a3:real^N", ← q r"b1:real", ← q r"b3:real"]
          (← liftExcept (el 6 (CONJUNCTS DISJOINT_HALFSPACES_IMP_COLLINEAR)))) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"a1:real^N", ← q r"a2:real^N", ← q r"b1:real", ← q r"b2:real"]
          (← liftExcept (el 6 (CONJUNCTS DISJOINT_HALFSPACES_IMP_COLLINEAR)))) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [COLLINEAR_LEMMA_ALT, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c2:real") THEN
      ASM_CASES_TAC (← q r"c2 = &0") THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO] THEN
      DISCH_THEN (ASSUME_TAC o SYM) THEN
      X_GEN_TAC (← q r"c3:real") THEN
      ASM_CASES_TAC (← q r"c3 = &0") THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO] THEN
      DISCH_THEN (ASSUME_TAC o SYM) THEN
      ASM_CASES_TAC (← q r"&0 < c2") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      ASM_CASES_TAC (← q r"&0 < c3") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      EXISTS_TAC (← q r"c3 / c2:real") THEN CONJ_TAC THENL
       [REWRITE_TAC [← REAL_ARITH (← q r"&0 < x / y <=> &0 < --x * --inv y")] THEN
        MATCH_MP_TAC REAL_LT_MUL THEN
        REWRITE_TAC [← GSYM REAL_INV_NEG, REAL_LT_INV_EQ] THEN ASM_REAL_ARITH_TAC,
        REPEAT DISJ2_TAC THEN MAP_EVERY EXPAND_TAC ["a2", "a3"] THEN
        REWRITE_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_RCANCEL] THEN DISJ1_TAC THEN
        UNDISCH_TAC (← q r"~(c2 = &0)") THEN CONV_TAC (fun t => REAL_FIELD t)],
      ALL_TAC] THEN
    STRIP_TAC THENL
     [SUBGOAL_THEN
       (← q r"DISJOINT {x:real^N | a1 dot x <= b1} {x | a3 dot x <= b3}")
      MP_TAC THENL [ASM SET_TAC [], ASM_REWRITE_TAC []],
      SUBGOAL_THEN
       (← q r"DISJOINT {x:real^N | a1 dot x <= b1} {x | a2 dot x <= b2}")
      MP_TAC THENL [ASM SET_TAC [], ASM_REWRITE_TAC []],
      SUBGOAL_THEN
       (← q r"DISJOINT {x:real^N | a2 dot x <= b2} {x | a3 dot x <= b3}")
      MP_TAC THENL [ASM SET_TAC [], ASM_REWRITE_TAC []]] THEN
    REWRITE_TAC [DOT_LMUL] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"{x | f x <= min a b} SUBSET {x | f x <= a} /\
      {x | f x <= min a b} SUBSET {x | f x <= b} /\
      ~({x | f x <= min a b} = {})
      ==> ~DISJOINT {x | f x <= a} {x | f x <= b}")) THEN
    ASM_REWRITE_TAC [HALFSPACE_EQ_EMPTY_LE, SUBSET, IN_ELIM_THM] THEN
    REAL_ARITH_TAC))

  let CONVEX_CLOSURE ← prove
   r"!s:real^N->bool. convex s ==> convex(closure s)"
   (REWRITE_TAC [convex, CLOSURE_SEQUENTIAL] THEN
    GEN_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"a:num->real^N")) MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"b:num->real^N")) MP_TAC) THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"\n:num. u % a(n) + v % b(n) :real^N") THEN
    ASM_SIMP_TAC [LIM_ADD, LIM_CMUL])

  let CONVEX_INTERIOR ← prove
   r"!s:real^N->bool. convex s ==> convex(interior s)"
   (REWRITE_TAC [CONVEX_ALT, IN_INTERIOR, SUBSET, IN_BALL, dist] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"d:real")) MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"e:real")) STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d e") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    X_GEN_TAC (← q r"z:real^N") THEN STRIP_TAC THEN
    SUBST1_TAC (← VECTOR_ARITH (← q r"z:real^N =
     (&1 - u) % (z - u % (y - x)) + u % (z + (&1 - u) % (y - x))")) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [← VECTOR_ARITH (← q r"x - (z - u % (y - x)) =
                                  ((&1 - u) % x + u % y) - z:real^N"),
                   ← VECTOR_ARITH (← q r"y - (z + (&1 - u) % (y - x)) =
                                  ((&1 - u) % x + u % y) - z:real^N")])

  let CONVEX_HULL_CLOSURE_SUBSET ← prove
   r"!s:real^N->bool. convex hull (closure s) SUBSET closure(convex hull s)"
   (GEN_TAC THEN MATCH_MP_TAC HULL_MINIMAL THEN
    SIMP_TAC [SUBSET_CLOSURE, HULL_SUBSET, CONVEX_CLOSURE, CONVEX_CONVEX_HULL])

  let CONVEX_HULL_CLOSURE ← prove
   r"!s. bounded s ==> convex hull (closure s) = closure(convex hull s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [CONVEX_HULL_CLOSURE_SUBSET] THEN MATCH_MP_TAC CLOSURE_MINIMAL THEN
    SIMP_TAC [HULL_MONO, CLOSURE_SUBSET] THEN
    MATCH_MP_TAC COMPACT_IMP_CLOSED THEN MATCH_MP_TAC COMPACT_CONVEX_HULL THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE])

  let SUPPORTING_HYPERPLANE_POINT ← prove
   r"!s z:real^N.
        convex s /\ ~(s = {}) /\ ~(z IN s)
        ==> ?a b y. ~(a = vec 0) /\
                    a dot z <= b /\
                    y IN closure s /\
                    a dot y = b /\
                    !x. x IN closure s ==> a dot x >= b"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(z:real^N) IN closure s") THENL
     [MP_TAC (← ISPECL [← q r"{z:real^N}", ← q r"s:real^N->bool"]
          SEPARATING_HYPERPLANE_SETS) THEN
      ASM_REWRITE_TAC [CONVEX_SING] THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real"] THEN
      REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY] THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"a dot (z:real^N)", ← q r"z:real^N"] THEN
      ASM_REWRITE_TAC [REAL_LE_REFL] THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"a dot x >= b <=> x IN {x | a dot x >= b}")] THEN
      MATCH_MP_TAC FORALL_IN_CLOSURE THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, CONTINUOUS_ON_ID, CLOSED_HALFSPACE_GE] THEN
      ASM_MESON_TAC [real_ge, REAL_LE_TRANS],
      MP_TAC (← ISPECL [← q r"closure s:real^N->bool", ← q r"z:real^N"]
       SUPPORTING_HYPERPLANE_CLOSED_POINT) THEN
      ASM_SIMP_TAC [CLOSED_CLOSURE, CONVEX_CLOSURE, CLOSURE_EQ_EMPTY] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      SIMP_TAC [REAL_LT_IMP_LE] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN SIMP_TAC [DOT_LZERO] THEN
      MESON_TAC [REAL_LT_REFL]])

  let CONVEX_ON_SETDIST ← prove
   r"!s t:real^N->bool. convex t ==> (\x. setdist ({x},t)) convex_on s"
   (SUBGOAL_THEN
     (← q r"!s t:real^N->bool. convex t /\ closed t
                         ==> (\x. setdist ({x},t)) convex_on s")
    MP_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o
        SPECL [← q r"s:real^N->bool", ← q r"closure t:real^N->bool"]) THEN
      ASM_SIMP_TAC [CLOSED_CLOSURE, SETDIST_CLOSURE, CONVEX_CLOSURE]] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [convex_on] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [SETDIST_EMPTY, REAL_MUL_RZERO, REAL_ADD_RID, REAL_LE_REFL] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{x:real^N}", ← q r"t:real^N->bool"] SETDIST_COMPACT_CLOSED) THEN
    MP_TAC (← ISPECL [← q r"{y:real^N}", ← q r"t:real^N->bool"] SETDIST_COMPACT_CLOSED) THEN
    ASM_REWRITE_TAC [NOT_INSERT_EMPTY, COMPACT_SING, UNWIND_THM2, SETDIST_CLOSURE,
                     CLOSURE_EQ_EMPTY, RIGHT_EXISTS_AND_THM, IN_SING] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y':real^N") (STRIP_ASSUME_TAC o GSYM)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x':real^N") (STRIP_ASSUME_TAC o GSYM)) THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"dist(u % x + v % y:real^N,u % x' + v % y')") THEN CONJ_TAC THENL
     [MATCH_MP_TAC SETDIST_LE_DIST THEN REWRITE_TAC [IN_SING] THEN
      ASM_MESON_TAC [convex],
      REWRITE_TAC [dist] THEN MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(a - a':real^N) + norm(b - b') <= r
        ==> norm((a + b) - (a' + b')) <= r")) THEN
      ASM_REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, NORM_MUL, dist] THEN
      ASM_REWRITE_TAC [real_abs, REAL_LE_REFL]])

  return { UNBOUNDED_COMPLEMENT_COMPONENT_CONVEX, UNBOUNDED_COMPLEMENT_CONVEX,
           COMPONENTS_CONVEX_COMPLEMENT_CONTAINS_HALFSPACE, CARD_COMPONENTS_COMPLEMENT_CONVEX,
           FINITE_COMPONENTS_COMPLEMENT_CONVEX, CONVEX_CLOSURE, CONVEX_INTERIOR,
           CONVEX_HULL_CLOSURE_SUBSET, CONVEX_HULL_CLOSURE, SUPPORTING_HYPERPLANE_POINT,
           CONVEX_ON_SETDIST }

/- ------------------------------------------------------------------------- -/
/- Moving and scaling convex hulls; convex set as intersection of            -/
/- halfspaces.  (convex.ml 7687-7742)                                        -/
/- ------------------------------------------------------------------------- -/

structure MSH where
  CONVEX_HULL_TRANSLATION : thm
  CONVEX_HULL_SCALING : thm
  CONVEX_HULL_AFFINITY : thm
  CONVEX_HALFSPACE_INTERSECTION : thm
  deriving Inhabited

@[nospecialize]
def setupMSH [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVA : CVA) (BCVH : CVH) (BSEP : SEP) :
    ExceptT String IO MSH := do
  -- @@SCOPE BEGIN
  let { MESON, REAL_ARITH, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC,
        add_translation_invariants, .. } := D
  let { EXISTS_REFL, EXTENSION, .. } := D.core1
  let { IMAGE_CONST, IMAGE_o, .. } := D.core2
  let { IN_ELIM_THM, IN_INTERS, NOT_EXISTS_THM, NOT_IMP, .. } := D.core3
  let { REAL_LE_NEG2, REAL_LT_NEG2, .. } := D.core4
  let { REAL_MUL_RINV, REAL_NOT_LE, SUBSET, .. } := D.core5
  let { HULL_IMAGE, .. } := D.misc
  let { AFFINITY_SCALING_TRANSLATION, DOT_LNEG, .. } := D.vec1
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_SUB_EQ, .. } := D.vec4
  let { CONVEX_TRANSLATION_EQ, .. } := BCVX
  let { CONVEX_SCALING_EQ, .. } := BCVA
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EMPTY, CONVEX_HULL_EQ_EMPTY, CONVEX_HULL_SING, .. } :=
    BCVH
  let { SEPARATING_HYPERPLANE_CLOSED_POINT, .. } := BSEP
  -- @@SCOPE END

  let CONVEX_HULL_TRANSLATION ← prove
   r"!a:real^N s.
       convex hull (IMAGE (\x. a + x) s) = IMAGE (\x. a + x) (convex hull s)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HULL_IMAGE THEN
    REWRITE_TAC [CONVEX_TRANSLATION_EQ, CONVEX_CONVEX_HULL] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = y <=> x = y - a"), EXISTS_REFL] THEN
    VECTOR_ARITH_TAC)

  add_translation_invariants [CONVEX_HULL_TRANSLATION]

  let CONVEX_HULL_SCALING ← prove
   r"!s:real^N->bool c.
       convex hull (IMAGE (\x. c % x) s) = IMAGE (\x. c % x) (convex hull s)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THENL
     [ASM_SIMP_TAC [IMAGE_CONST, VECTOR_MUL_LZERO, CONVEX_HULL_EQ_EMPTY] THEN
      COND_CASES_TAC THEN REWRITE_TAC [CONVEX_HULL_EMPTY, CONVEX_HULL_SING],
      ALL_TAC] THEN
    MATCH_MP_TAC HULL_IMAGE THEN
    ASM_SIMP_TAC [CONVEX_SCALING_EQ, CONVEX_CONVEX_HULL] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"c % x = c % y <=> c % (x - y) = vec 0")] THEN
    ASM_SIMP_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EXISTS_TAC (← q r"inv c % x:real^N") THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, VECTOR_MUL_LID])

  let CONVEX_HULL_AFFINITY ← prove
   r"!s a:real^N c.
        convex hull (IMAGE (\x. c % x + a) s) =
        IMAGE (\x. c % x + a) (convex hull s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [AFFINITY_SCALING_TRANSLATION] THEN
    ASM_SIMP_TAC [IMAGE_o, CONVEX_HULL_TRANSLATION, CONVEX_HULL_SCALING])

  let CONVEX_HALFSPACE_INTERSECTION ← prove
   r"!s. closed(s:real^N->bool) /\ convex s
       ==> s = INTERS {h | s SUBSET h /\ ?a b. h = {x | a dot x <= b}}"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN REWRITE_TAC [IN_INTERS] THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    REWRITE_TAC [← MESON [] (← q r"(!t. (P t /\ ?a b. t = x a b) ==> Q t) <=>
                         (!a b. P(x a b) ==> Q(x a b))")] THEN
    EQ_TAC THENL [SET_TAC [], ALL_TAC] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N"]
      SEPARATING_HYPERPLANE_CLOSED_POINT) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"--a:real^N", ← q r"--b:real"]) THEN
    ASM_SIMP_TAC [SUBSET, IN_ELIM_THM, DOT_LNEG, NOT_IMP] THEN
    ASM_SIMP_TAC [REAL_LE_NEG2, REAL_LT_NEG2, REAL_NOT_LE,
                  ← REAL_ARITH (← q r"a > b ==> b <= a")])

  return { CONVEX_HULL_TRANSLATION, CONVEX_HULL_SCALING, CONVEX_HULL_AFFINITY,
           CONVEX_HALFSPACE_INTERSECTION }

/- ------------------------------------------------------------------------- -/
/- Polar dual of a set.  (convex.ml 7744-7905)                               -/
/- ------------------------------------------------------------------------- -/

structure POL where
  polar_dual : thm
  POLAR_DUAL : thm
  CLOSED_POLAR_DUAL : thm
  CONVEX_POLAR_DUAL : thm
  POLAR_DUAL_0 : thm
  POLAR_DUAL_EMPTY : thm
  POLAR_DUAL_SING : thm
  POLAR_DUAL_UNIV : thm
  POLAR_DUAL_ANTIMONO : thm
  POLAR_DUAL_UNION : thm
  POLAR_DUAL_SCALING : thm
  POLAR_DUAL_UNIT_CBALL : thm
  POLAR_DUAL_CBALL : thm
  POLAR_DUAL_POLAR_DUAL_GEN : thm
  POLAR_DUAL_POLAR_DUAL_EQ : thm
  POLAR_DUAL_POLAR_DUAL : thm
  deriving Inhabited

@[nospecialize]
def setupPOL [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVH : CVH) (BSEP : SEP) (BMCG : MCG) :
    ExceptT String IO POL := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { CONTRAPOS_THM, EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, INSERT_SUBSET, INTERS_GSPEC, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_SING, IN_UNIV, NOT_EXISTS_THM, NOT_IN_EMPTY,
        REAL_DIV_RMUL, .. } := D.core3
  let { REAL_LE_MUL2, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, .. } :=
    D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_RID, REAL_NEG_NEG, REAL_NOT_LT,
        REAL_POS, REAL_POW_2, REAL_POW_INV, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SUBSET,
        SUBSET_ANTISYM, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, UNIV_GSPEC, real_ge, real_gt, .. } := D.core6
  let { ABS_SQUARE_LE_1, HULL_INC, HULL_MINIMAL, HULL_P, HULL_SUBSET, .. } := D.misc
  let { DOT_EQ_0, DOT_LMUL, DOT_LNEG, DOT_LZERO, DOT_RMUL, DOT_RNEG, DOT_RZERO, .. } := D.vec1
  let { DOT_SYM, NORM_CAUCHY_SCHWARZ, NORM_EQ_0, .. } := D.vec2
  let { NORM_LE_SQUARE, NORM_POS_LE, NORM_POW_2, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_RZERO, VECTOR_NEG_NEG, .. } := D.vec4
  let { CBALL_SCALING, CLOSED_CLOSURE, CLOSED_HALFSPACE_GE, CLOSED_INTERS, CLOSURE_CLOSED,
        CLOSURE_EQ, .. } := D.top1
  let { CLOSURE_INC, CLOSURE_MINIMAL, CLOSURE_SUBSET, .. } := D.top2
  let { IN_CBALL_0, .. } := D.top4
  let { CONVEX_INTERS, CONVEX_HALFSPACE_GE, .. } := BCVX
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EQ, .. } := BCVH
  let { SEPARATING_HYPERPLANE_CLOSED_POINT, .. } := BSEP
  let { CONVEX_CLOSURE, .. } := BMCG
  -- @@SCOPE END

  let polar_dual ← new_definition
   r"polar_dual s = {x:real^N | !u. u IN s ==> u dot x >= -- &1}"

  let POLAR_DUAL ← prove
   r"!s:real^N->bool.
        polar_dual s = INTERS {{x | u dot x >= -- &1} | u IN s}"
   (REWRITE_TAC [polar_dual, INTERS_GSPEC] THEN SET_TAC [])

  let CLOSED_POLAR_DUAL ← prove
   r"!s:real^N->bool. closed(polar_dual s)"
   (GEN_TAC THEN REWRITE_TAC [POLAR_DUAL] THEN
    MATCH_MP_TAC CLOSED_INTERS THEN
    REWRITE_TAC [FORALL_IN_GSPEC, CLOSED_HALFSPACE_GE])

  let CONVEX_POLAR_DUAL ← prove
   r"!s:real^N->bool. convex(polar_dual s)"
   (GEN_TAC THEN REWRITE_TAC [POLAR_DUAL] THEN
    MATCH_MP_TAC CONVEX_INTERS THEN
    REWRITE_TAC [FORALL_IN_GSPEC, CONVEX_HALFSPACE_GE])

  let POLAR_DUAL_0 ← prove
   r"!s:real^N->bool. vec 0 IN polar_dual s"
   (REWRITE_TAC [polar_dual, IN_ELIM_THM, DOT_RZERO] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let POLAR_DUAL_EMPTY ← prove
   r"polar_dual {} = (:real^N)"
   (REWRITE_TAC [polar_dual, NOT_IN_EMPTY, UNIV_GSPEC])

  let POLAR_DUAL_SING ← prove
   r"polar_dual {vec 0} = (:real^N)"
   (REWRITE_TAC [polar_dual, FORALL_IN_INSERT, NOT_IN_EMPTY, DOT_LZERO] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN SET_TAC [])

  let POLAR_DUAL_UNIV ← prove
   r"polar_dual (:real^N) = {vec 0}"
   (REWRITE_TAC [polar_dual, IN_UNIV, EXTENSION, IN_ELIM_THM, IN_SING] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EQ_TAC THEN
    SIMP_TAC [DOT_RZERO] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"--(&2 / (x dot x)) % x:real^N")) THEN
    REWRITE_TAC [DOT_LMUL, ← REAL_ARITH (← q r"~(--x * y >= --a) <=> a < x * y")] THEN
    ASM_SIMP_TAC [REAL_DIV_RMUL, DOT_EQ_0] THEN REAL_ARITH_TAC)

  let POLAR_DUAL_ANTIMONO ← prove
   r"!s t:real^N->bool.
        s SUBSET t ==> polar_dual t SUBSET polar_dual s"
   (REWRITE_TAC [polar_dual] THEN SET_TAC [])

  let POLAR_DUAL_UNION ← prove
   r"!s t:real^N->bool. polar_dual(s UNION t) = polar_dual s INTER polar_dual t"
   (REWRITE_TAC [polar_dual] THEN SET_TAC [])

  let POLAR_DUAL_SCALING ← prove
   r"!a s:real^N->bool.
        ~(a = &0)
        ==> polar_dual {a % x | x IN s} = {inv a % x | x IN polar_dual s}"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [SIMPLE_IMAGE] THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN EXISTS_TAC (← q r"a % y:real^N") THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_LID, REAL_MUL_LINV],
      REWRITE_TAC [polar_dual, FORALL_IN_IMAGE, IN_ELIM_THM, DOT_RMUL] THEN
      ASM_SIMP_TAC [DOT_LMUL, ← REAL_FIELD (← q r"~(a = &0) ==> inv a * a * b = b")]])

  let POLAR_DUAL_UNIT_CBALL ← prove
   r"polar_dual(cball(vec 0:real^N,&1)) = cball(vec 0,&1)"
   (REWRITE_TAC [polar_dual, IN_CBALL_0, EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [NORM_LE_SQUARE] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    GEN_REWRITE_TAC id
     [← MESON [VECTOR_NEG_NEG] (← q r"(!x:real^N. P x) <=> (!x. P(--x))")] THEN
    REWRITE_TAC [DOT_RNEG, DOT_LNEG, REAL_NEG_NEG] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"--x >= -- &1 <=> x <= &1")] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EQ_TAC THENL
     [ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
      ASM_REWRITE_TAC [DOT_LZERO, REAL_POS] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(norm x) % x:real^N")) THEN
      REWRITE_TAC [DOT_LMUL, DOT_RMUL, ← GSYM REAL_POW_2, REAL_MUL_ASSOC] THEN
      REWRITE_TAC [REAL_POW_INV, NORM_POW_2] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, DOT_EQ_0, REAL_LE_REFL] THEN
      ASM_SIMP_TAC [← GSYM NORM_POW_2, NORM_EQ_0, ← REAL_FIELD
       (← q r"~(x = &0) ==> inv x * x pow 2 = x")] THEN
      REWRITE_TAC [ABS_SQUARE_LE_1, REAL_ABS_NORM],
      REWRITE_TAC [← GSYM NORM_POW_2, ABS_SQUARE_LE_1, REAL_ABS_NORM] THEN
      REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"y <= u * x /\ (u <= &1 /\ x <= &1 ==> u * x <= &1 * &1)
        ==> x <= &1 ==> u <= &1 ==> y <= &1")) THEN
      REWRITE_TAC [NORM_CAUCHY_SCHWARZ] THEN
      SIMP_TAC [REAL_LE_MUL2, NORM_POS_LE]])

  let POLAR_DUAL_CBALL ← prove
   r"!r. &0 < r ==> polar_dual(cball(vec 0:real^N,r)) = cball(vec 0,inv r)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← MESON [CBALL_SCALING, REAL_MUL_RID, VECTOR_MUL_RZERO]
     (← q r"&0 < r ==> cball(vec 0,r) = IMAGE (\x. r % x) (cball(vec 0,&1))")] THEN
    ASM_SIMP_TAC [← GSYM SIMPLE_IMAGE, POLAR_DUAL_SCALING, REAL_LT_IMP_NZ] THEN
    REWRITE_TAC [POLAR_DUAL_UNIT_CBALL] THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, ← GSYM CBALL_SCALING, REAL_LT_INV_EQ] THEN
    REWRITE_TAC [REAL_MUL_RID, VECTOR_MUL_RZERO])

  let POLAR_DUAL_POLAR_DUAL_GEN ← prove
   r"!s:real^N->bool.
        polar_dual(polar_dual s) = closure(convex hull (vec 0 INSERT s))"
   (GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN
      REWRITE_TAC [← TAUT (← q r"p ==> q <=> ~(p /\ ~q)")] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"closure (convex hull (vec 0 INSERT s)):real^N->bool", ← q r"x:real^N"]
       SEPARATING_HYPERPLANE_CLOSED_POINT) THEN
      ASM_SIMP_TAC [CLOSED_CLOSURE, CONVEX_CONVEX_HULL, CONVEX_CLOSURE] THEN
      REWRITE_TAC [NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real"] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N")) THEN
      SIMP_TAC [IN_INSERT, HULL_INC, CLOSURE_INC] THEN
      REWRITE_TAC [real_gt, DOT_RZERO] THEN STRIP_TAC THEN
      UNDISCH_TAC (← q r"(x:real^N) IN polar_dual(polar_dual s)") THEN
      REWRITE_TAC [polar_dual, IN_ELIM_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(-- b) % a:real^N")) THEN
      REWRITE_TAC [DOT_LMUL, DOT_RMUL] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"inv x * y:real = y / x")] THEN
      ASM_SIMP_TAC [real_ge, REAL_LE_RDIV_EQ, ← REAL_ARITH (← q r"&0 < --b <=> b < &0"),
                    ← REAL_ARITH (← q r"--x * --y:real = x * y"), REAL_MUL_LID] THEN
      ASM_REWRITE_TAC [← GSYM REAL_NOT_LT] THEN X_GEN_TAC (← q r"u:real^N") THEN
      DISCH_TAC THEN MATCH_MP_TAC (← REAL_ARITH (← q r"a > b ==> ~(a < b)")) THEN
      ONCE_REWRITE_TAC [DOT_SYM] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [IN_INSERT, CLOSURE_INC, HULL_INC],
      MATCH_MP_TAC CLOSURE_MINIMAL THEN REWRITE_TAC [CLOSED_POLAR_DUAL] THEN
      MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_POLAR_DUAL] THEN
      REWRITE_TAC [INSERT_SUBSET, POLAR_DUAL_0] THEN
      REWRITE_TAC [SUBSET, polar_dual, IN_ELIM_THM] THEN
      MESON_TAC [DOT_SYM]])

  let POLAR_DUAL_POLAR_DUAL_EQ ← prove
   r"!s:real^N->bool.
        polar_dual(polar_dual s) = s <=>
        closed s /\ convex s /\ vec 0 IN s"
   (GEN_TAC THEN REWRITE_TAC [POLAR_DUAL_POLAR_DUAL_GEN] THEN EQ_TAC THENL
     [DISCH_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"closure t = s
        ==> (!x. x IN s ==> x IN t) /\ t SUBSET closure t
            ==> t = s"))) THEN
      SIMP_TAC [IN_INSERT, HULL_INC, CLOSURE_SUBSET] THEN DISCH_TAC THEN
      CONJ_TAC THENL [ASM_MESON_TAC [CLOSURE_EQ], ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"convex hull t = s
        ==> (!x. x IN s ==> x IN t) /\ t SUBSET convex hull t
            ==> t = s"))) THEN
      SIMP_TAC [HULL_SUBSET, IN_INSERT] THEN
      REWRITE_TAC [← GSYM CONVEX_HULL_EQ] THEN
      REPEAT STRIP_TAC THENL [ASM_MESON_TAC [], ASM SET_TAC []],
      SIMP_TAC [← SET_RULE (← q r"a IN s ==> a INSERT s = s"), HULL_P] THEN
      SIMP_TAC [CLOSURE_CLOSED]])

  let POLAR_DUAL_POLAR_DUAL ← prove
   r"!s:real^N->bool.
        closed s /\ convex s /\ vec 0 IN s
        ==> polar_dual(polar_dual s) = s"
   (REWRITE_TAC [POLAR_DUAL_POLAR_DUAL_EQ])

  return { polar_dual, POLAR_DUAL, CLOSED_POLAR_DUAL, CONVEX_POLAR_DUAL, POLAR_DUAL_0,
           POLAR_DUAL_EMPTY, POLAR_DUAL_SING, POLAR_DUAL_UNIV, POLAR_DUAL_ANTIMONO,
           POLAR_DUAL_UNION, POLAR_DUAL_SCALING, POLAR_DUAL_UNIT_CBALL, POLAR_DUAL_CBALL,
           POLAR_DUAL_POLAR_DUAL_GEN, POLAR_DUAL_POLAR_DUAL_EQ, POLAR_DUAL_POLAR_DUAL }

/- ------------------------------------------------------------------------- -/
/- Radon's theorem (from Lars Schewe).  (convex.ml 7909-8111)                -/
/- ------------------------------------------------------------------------- -/

structure RAD where
  RADON_EX_LEMMA : thm
  RADON_S_LEMMA : thm
  RADON_V_LEMMA : thm
  RADON_PARTITION : thm
  RADON : thm
  deriving Inhabited

@[nospecialize]
def setupRAD [HolBase] (D : ConvexDeps) (BAFD : AFD) (BCVE : CVE) : ExceptT String IO RAD := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_RULE,
        SET_TAC, VECTOR_ARITH, .. } := D
  let { COND_ID, COND_RAND, COND_RATOR, DISJOINT, EXTENSION, FINITE_RESTRICT,
        FINITE_UNION, .. } := D.core1
  let { IMP_IMP, INTER, .. } := D.core2
  let { IN_ELIM_THM, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_01, REAL_LE_DIV, REAL_LE_LT, REAL_LE_MUL, REAL_LT_TOTAL, .. } := D.core4
  let { REAL_MUL_RID, REAL_NEG_GE0, REAL_NOT_LT, SUBSET, .. } := D.core5
  let { SUM_0, SUM_LMUL, SUM_LT, SUM_LT_ALL, SUM_NEG, SUM_POS_LE, SUM_RESTRICT_SET,
        SUM_UNION, UNION, .. } := D.core6
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LCANCEL, VECTOR_MUL_LNEG, VECTOR_MUL_LZERO, VSUM_0,
        VSUM_LMUL, VSUM_NEG, VSUM_RESTRICT_SET, VSUM_UNION, .. } := D.vec4
  let { AFFINE_DEPENDENT_EXPLICIT, .. } := BAFD
  let { CONVEX_HULL_EXPLICIT, .. } := BCVE
  -- @@SCOPE END

  let RADON_EX_LEMMA ← prove
   r"!(c:real^N->bool).
        FINITE c /\ affine_dependent c
        ==> (?u. sum c u = &0 /\ (?v. v IN c /\ ~(u v = &0)) /\
                                      vsum c (\v. u v % v) = (vec 0):real^N)"
   (REWRITE_TAC [AFFINE_DEPENDENT_EXPLICIT] THEN
    REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\v:real^N. if v IN s then u v else &0") THEN
    ASM_SIMP_TAC [← GSYM SUM_RESTRICT_SET] THEN
    ASM_SIMP_TAC [COND_RAND, COND_RATOR,
                  VECTOR_MUL_LZERO, ← GSYM VSUM_RESTRICT_SET] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET c ==> {x | x IN c /\ x IN s} = s")] THEN
    EXISTS_TAC (← q r"v:real^N") THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let RADON_S_LEMMA ← prove
   r"!(s:A->bool) f.
        FINITE s /\ sum s f = &0
        ==> sum {x | x IN s /\ &0 < f x} f =
            -- sum {x | x IN s /\ f x < &0} f"
   (REWRITE_TAC [← REAL_ARITH (← q r"a = --b <=> a + b = &0")] THEN
    REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [FINITE_RESTRICT, ← GSYM SUM_UNION,
      ← REWRITE_RULE [← REAL_ARITH (← q r"&0 < f x ==> ~(f x < &0)")]
       (← SET_RULE (← q r"(!x:A. &0 < f x ==> ~(f x < &0))
                  ==>  DISJOINT {x | x IN s /\ &0 < f x}
                                {x | x IN s /\ f x < &0}"))] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"!a b.a = &0 /\ a + b = &0 ==> b = &0")) THEN
    EXISTS_TAC (← q r"sum {x:A | x IN s /\ f x = &0} f") THEN
    CONJ_TAC THENL
    [ASM_SIMP_TAC [SUM_RESTRICT_SET] THEN REWRITE_TAC [COND_ID, SUM_0],
     ALL_TAC] THEN
    SUBGOAL_THEN (← q r"DISJOINT {x:A | x IN s /\ f x = &0}
                           ({x | x IN s /\ &0 < f x} UNION
                            {x | x IN s /\ f x < &0})") ASSUME_TAC THENL
    [REWRITE_TAC [DISJOINT, UNION, INTER, IN_ELIM_THM, EXTENSION, NOT_IN_EMPTY] THEN
     REAL_ARITH_TAC,
     ALL_TAC] THEN
     ASM_SIMP_TAC [FINITE_UNION, FINITE_RESTRICT, ← GSYM SUM_UNION] THEN
    FIRST_X_ASSUM (SUBST1_TAC o GSYM) THEN
    MATCH_MP_TAC (← MESON [] (← q r"a = b ==> sum a f = sum b f")) THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, UNION] THEN
    MESON_TAC [REAL_LT_TOTAL])

  let RADON_V_LEMMA ← prove
   r"!(s:A->bool) f g.
        FINITE s /\ vsum s f = vec 0 /\ (!x. g x = &0 ==> f x = vec 0)
        ==> (vsum {x | x IN s /\ &0 < g x} f) :real^N =
             -- vsum {x | x IN s /\ g x < &0} f"
   (REWRITE_TAC [← VECTOR_ARITH (← q r"a:real^N = --b <=> a + b = vec 0")] THEN
    REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [FINITE_RESTRICT, ← GSYM VSUM_UNION,
                  ← REWRITE_RULE [← REAL_ARITH (← q r"&0 < f x ==> ~(f x < &0)")]
                    (← SET_RULE (← q r"(!x:A. &0 < f x ==> ~(f x < &0))
                              ==>  DISJOINT {x | x IN s /\ &0 < f x}
                                            {x | x IN s /\ f x < &0}"))] THEN
    MATCH_MP_TAC (← VECTOR_ARITH
      (← q r"!a b. (a:real^N) = vec 0 /\ a + b = vec 0 ==> b = vec 0")) THEN
    EXISTS_TAC (← q r"(vsum {x:A | x IN s /\ g x = &0} f):real^N") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [VSUM_RESTRICT_SET, COND_ID, VSUM_0], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"DISJOINT {x:A | x IN s /\ g x = &0}
                             ({x | x IN s /\ &0 < g x} UNION
                              {x | x IN s /\ g x < &0})") ASSUME_TAC THENL
       [REWRITE_TAC [DISJOINT, UNION, INTER, IN_ELIM_THM, EXTENSION, NOT_IN_EMPTY] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
    ASM_SIMP_TAC [FINITE_UNION, FINITE_RESTRICT, ← GSYM VSUM_UNION] THEN
    FIRST_X_ASSUM (SUBST1_TAC o GSYM) THEN
    MATCH_MP_TAC (← MESON [] (← q r"a = b ==> vsum a f = vsum b f")) THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, UNION] THEN
    MESON_TAC [REAL_LT_TOTAL])

  let RADON_PARTITION ← prove
   r"!(c:real^N->bool).
        FINITE c /\ affine_dependent c
        ==> ?(m:real^N->bool) (p:real^N->bool).
                (DISJOINT m p) /\
                (m UNION p = c) /\
                ~(DISJOINT (convex hull m) (convex hull p))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"c:real^N->bool") RADON_EX_LEMMA) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"{v:real^N | v IN c /\ u v <= &0}",
                          ← q r"{v:real^N | v IN c /\ u v > &0}"] THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [DISJOINT, INTER,
                   IN_ELIM_THM, ← REAL_ARITH (← q r"x <= &0 <=> ~(x > &0)")] THEN
      SET_TAC [],
      REWRITE_TAC [UNION, IN_ELIM_THM, ← REAL_ARITH (← q r"x <= &0 <=> ~(x > &0)")] THEN
      SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(sum {x:real^N | x IN c /\ u x > &0} u = &0)") ASSUME_TAC THENL
     [MATCH_MP_TAC (← REAL_ARITH (← q r"a > &0 ==> ~(a = &0)")) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a > &0 <=> &0 < a")]        THEN
      MATCH_MP_TAC (← REWRITE_RULE [SUM_0] (← ISPEC (← q r"\x. &0") SUM_LT_ALL)) THEN
      ASM_SIMP_TAC [FINITE_RESTRICT, IN_ELIM_THM, EXTENSION, NOT_IN_EMPTY] THEN
      REWRITE_TAC [← MESON [] (← q r"~(!x. ~(P x /\ Q x)) = ?x. P x /\ Q x")] THEN
         ASM_CASES_TAC (← q r"&0 < u (v:real^N)") THENL
      [ASM SET_TAC [], ALL_TAC] THEN
      POP_ASSUM MP_TAC THEN POP_ASSUM (K ALL_TAC) THEN POP_ASSUM MP_TAC THEN
      REWRITE_TAC [IMP_IMP, ← REAL_ARITH (← q r"~(a = &0) /\ ~(&0 < a) <=> a < &0")] THEN
      DISCH_TAC THEN
      REWRITE_TAC [← MESON [REAL_NOT_LT]
       (← q r"(?x:real^N. P x /\ &0 < u x) <=> (!x. P x ==> u x <= &0) ==> F")]  THEN
      DISCH_TAC THEN
         MP_TAC (← ISPECL [← q r"u:real^N->real", ← q r"\x:real^N. &0",
                           ← q r"c:real^N->bool"]
                        SUM_LT) THEN
      ASM_REWRITE_TAC [SUM_0, ← REAL_ARITH (← q r"~(&0 < &0)")] THEN
      ASM_MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"~DISJOINT a b <=> ?y. y IN a /\ y IN b")] THEN
    EXISTS_TAC (← q r"&1 / (sum {x:real^N | x IN c /\ u x > &0} u) %
                vsum {x:real^N | x IN c /\ u x > &0} (\x. u x % x)") THEN
    REWRITE_TAC [CONVEX_HULL_EXPLICIT, IN_ELIM_THM] THEN
    CONJ_TAC THENL
    [MAP_EVERY EXISTS_TAC [← q r"{v:real^N | v IN c /\ u v < &0}",
                           ← q r"\y:real^N.
                           &1 / (sum {x:real^N | x IN c /\ u x > &0} u) *
                             (--(u y))"] THEN
     ASM_SIMP_TAC [FINITE_RESTRICT, SUBSET, IN_ELIM_THM] THEN
     REPEAT CONJ_TAC THENL
      [REAL_ARITH_TAC,
       REPEAT STRIP_TAC THEN
       MATCH_MP_TAC REAL_LE_MUL THEN
       CONJ_TAC THENL [ALL_TAC,
                       ASM_REWRITE_TAC [REAL_NEG_GE0, REAL_LE_LT]] THEN
       MATCH_MP_TAC REAL_LE_DIV THEN
       REWRITE_TAC [REAL_LE_01] THEN
       MATCH_MP_TAC SUM_POS_LE THEN
       ASM_SIMP_TAC [FINITE_RESTRICT, IN_ELIM_THM] THEN
       REAL_ARITH_TAC,
       ASM_SIMP_TAC [FINITE_RESTRICT, SUM_LMUL] THEN
       MATCH_MP_TAC (← REAL_FIELD (← q r"!a. ~(a = &0) /\ a * b = a * c ==> b = c")) THEN
       EXISTS_TAC (← q r"sum {x:real^N | x IN c /\ u x > &0} u") THEN
       REWRITE_TAC [SUM_LMUL] THEN
       ASM_SIMP_TAC [← REAL_FIELD (← q r"~(a = &0) ==> a * &1 / a * b = b")]  THEN
       REWRITE_TAC [SUM_NEG, REAL_MUL_RID] THEN
       REWRITE_TAC [← REAL_ARITH (← q r"a > &0 <=> &0 < a")] THEN
       MATCH_MP_TAC (← GSYM RADON_S_LEMMA) THEN
       ASM_REWRITE_TAC [],
       ALL_TAC] THEN
      REWRITE_TAC [← GSYM VECTOR_MUL_ASSOC, VSUM_LMUL, VECTOR_MUL_LCANCEL] THEN
      REWRITE_TAC [VECTOR_MUL_LNEG, VSUM_NEG] THEN
      DISJ2_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [← REAL_ARITH (← q r"&0 < a <=>  a > &0")]
       (← GSYM RADON_V_LEMMA)) THEN
      ASM_REWRITE_TAC [] THEN
      MESON_TAC [VECTOR_MUL_LZERO], ALL_TAC] THEN
    MAP_EVERY EXISTS_TAC [← q r"{v:real^N | v IN c /\ u v > &0}",
                          ← q r"\y:real^N.
                             &1 / (sum {x:real^N | x IN c /\ u x > &0} u) *
                             (u y)"] THEN
    ASM_SIMP_TAC [FINITE_RESTRICT, SUBSET, IN_ELIM_THM] THEN
    REPEAT CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC REAL_LE_MUL THEN
      CONJ_TAC THENL [ALL_TAC,
                      ASM_SIMP_TAC [← REAL_ARITH (← q r"a > &0 ==> &0 <= a")]] THEN
      MATCH_MP_TAC REAL_LE_DIV THEN
      REWRITE_TAC [REAL_LE_01] THEN
      MATCH_MP_TAC SUM_POS_LE THEN
      ASM_SIMP_TAC [FINITE_RESTRICT, IN_ELIM_THM] THEN
      REAL_ARITH_TAC,
      ASM_SIMP_TAC [FINITE_RESTRICT, SUM_LMUL] THEN
      MATCH_MP_TAC (← REAL_FIELD (← q r"!a. ~(a = &0) /\ a * b = a * c ==> b = c")) THEN
      EXISTS_TAC (← q r"sum {x:real^N | x IN c /\ u x > &0} u") THEN
      REWRITE_TAC [SUM_LMUL] THEN
      ASM_SIMP_TAC [← REAL_FIELD (← q r"~(a = &0) ==> a * &1 / a * b = b")]  THEN
      REWRITE_TAC [SUM_NEG, REAL_MUL_RID] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a > &0 <=> &0 < a")] THEN
      MATCH_MP_TAC (← GSYM RADON_S_LEMMA) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [← GSYM VECTOR_MUL_ASSOC, VSUM_LMUL, VECTOR_MUL_LCANCEL] THEN
    REWRITE_TAC [VECTOR_MUL_LNEG, VSUM_NEG] THEN
    DISJ2_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [← REAL_ARITH (← q r"&0 < a <=>  a > &0")]
      (← GSYM RADON_V_LEMMA)) THEN
    ASM_REWRITE_TAC [] THEN
    MESON_TAC [VECTOR_MUL_LZERO])

  let RADON ← prove
   r"!(c:real^N->bool).
        affine_dependent c
        ==> ?(m:real^N->bool) (p:real^N->bool).
                m SUBSET c /\
                p SUBSET c /\
                DISJOINT m p /\
                ~(DISJOINT (convex hull m) (convex hull p))"
   (REPEAT STRIP_TAC THEN MP_TAC
      (← ISPEC (← q r"c:real^N->bool") AFFINE_DEPENDENT_EXPLICIT) THEN
    ASM_SIMP_TAC [] THEN REPEAT STRIP_TAC THEN MP_TAC
    (← ISPEC (← q r"s:real^N->bool") RADON_PARTITION) THEN
    ANTS_TAC THENL
    [ASM_SIMP_TAC [AFFINE_DEPENDENT_EXPLICIT] THEN
       MAP_EVERY EXISTS_TAC [← q r"s:real^N->bool", ← q r"u:real^N->real"] THEN
       ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN STRIP_ASSUME_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"m:real^N->bool", ← q r"p:real^N->bool"] THEN
    ASM SET_TAC [])

  return { RADON_EX_LEMMA, RADON_S_LEMMA, RADON_V_LEMMA, RADON_PARTITION, RADON }

/- ------------------------------------------------------------------------- -/
/- Helly's theorem.  (convex.ml 8115-8272)                                   -/
/- ------------------------------------------------------------------------- -/

structure HEL where
  HELLY_INDUCT : thm
  HELLY : thm
  HELLY_ALT : thm
  HELLY_CLOSED_ALT : thm
  HELLY_COMPACT_ALT : thm
  HELLY_CLOSED : thm
  HELLY_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupHEL [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCLH : CLH) (BRAD : RAD) :
    ExceptT String IO HEL := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, SET_RULE, SET_TAC, .. } := D
  let { CARD_CLAUSES, CARD_DELETE, CARD_IMAGE_INJ, CHOOSE_SUBSET_BETWEEN, DISJOINT, DISJ_SYM,
        FINITE_DELETE, FINITE_IMAGE, FINITE_SUBSET, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, GE, HAS_SIZE, HAS_SIZE_SUC, INTERS_0, .. } := D.core2
  let { IN_IMAGE, IN_INTER, IN_INTERS, IN_UNION, LE_REFL, LT_IMP_LE, MEMBER_NOT_EMPTY,
        MONO_OR, NOT_LT, .. } := D.core3
  let { RIGHT_EXISTS_IMP_THM, SKOLEM_THM, SUBSET, SUBSET_ANTISYM, SUBSET_IMAGE, SUBSET_REFL,
        SUBSET_TRANS, .. } := D.core5
  let { UNION_SUBSET, UNIV_NOT_EMPTY, .. } := D.core6
  let { HULL_MINIMAL, .. } := D.misc
  let { CLOSED_FIP, .. } := D.top1
  let { COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := D.top2
  let { CONVEX_INTERS, .. } := BCVX
  let { AFFINE_DEPENDENT_BIGGERSET, .. } := BCLH
  let { RADON_PARTITION, .. } := BRAD
  -- @@SCOPE END

  let HELLY_INDUCT ← prove
   r"!n f. f HAS_SIZE n /\ n >= dimindex(:N) + 1 /\
         (!s:real^N->bool. s IN f ==> convex s) /\
         (!t. t SUBSET f /\ CARD(t) = dimindex(:N) + 1
              ==> ~(INTERS t = {}))
         ==> ~(INTERS f = {})"
   (INDUCT_TAC THEN REWRITE_TAC [← ARITH_RULE (← q r"~(0 >= n + 1)")] THEN GEN_TAC THEN
    POP_ASSUM (LABEL_TAC "*") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HAS_SIZE_SUC]) THEN
    STRIP_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
    FIRST_X_ASSUM (DISJ_CASES_TAC o MATCH_MP (← ARITH_RULE
      (← q r"SUC n >= m + 1 ==> m = n \/ n >= m + 1")))
    THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
      ASM_SIMP_TAC [CARD_CLAUSES, SUBSET_REFL] THEN ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?X. !s:real^N->bool. s IN f ==> X(s) IN INTERS (f DELETE s)")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM SKOLEM_THM, MEMBER_NOT_EMPTY, RIGHT_EXISTS_IMP_THM] THEN
      GEN_TAC THEN STRIP_TAC THEN REMOVE_THEN "*" MATCH_MP_TAC THEN
      ASM_SIMP_TAC [FINITE_DELETE, CARD_DELETE] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC
     (← q r"?s t:real^N->bool. s IN f /\ t IN f /\ ~(s = t) /\ X s:real^N = X t")
    THENL
     [FIRST_X_ASSUM (CHOOSE_THEN STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"(X:(real^N->bool)->real^N) t") THEN
      FIRST_X_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC ONCE_DEPTH_CONV
       [← MATCH_MP
         (← SET_RULE (← q r"~(s = t)
                 ==> INTERS f = INTERS(f DELETE s) INTER INTERS(f DELETE t)"))
         th])) THEN
      REWRITE_TAC [IN_INTER] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"IMAGE (X:(real^N->bool)->real^N) f") RADON_PARTITION) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_IMAGE] THEN
      MATCH_MP_TAC AFFINE_DEPENDENT_BIGGERSET THEN
      ASM_SIMP_TAC [FINITE_IMAGE] THEN
      MATCH_MP_TAC (← ARITH_RULE
       (← q r"!f n. n >= d + 1 /\ f = SUC n /\ c = f ==> c >= d + 2")) THEN
      MAP_EVERY EXISTS_TAC [← q r"CARD(f:(real^N->bool)->bool)", ← q r"n:num"] THEN
      REPEAT (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
      MATCH_MP_TAC CARD_IMAGE_INJ THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"P /\ m UNION p = s /\ Q <=>
      m SUBSET s /\ p SUBSET s /\ m UNION p = s /\ P /\ Q")] THEN
    REWRITE_TAC [SUBSET_IMAGE, DISJOINT] THEN
    REWRITE_TAC [← MESON []
     (← q r"(?m p. (?u. P u /\ m = t u) /\ (?u. P u /\ p = t u) /\ Q m p) ==> r <=>
      (!u v. P u /\ P v /\ Q (t u) (t v) ==> r)")] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:(real^N->bool)->bool", ← q r"h:(real^N->bool)->bool"] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    SUBGOAL_THEN (← q r"(f:(real^N->bool)->bool) = h UNION g") SUBST1_TAC THENL
     [MATCH_MP_TAC SUBSET_ANTISYM THEN ASM_REWRITE_TAC [UNION_SUBSET] THEN
      REWRITE_TAC [SUBSET, IN_UNION] THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
      DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"X:(real^N->bool)->real^N") o
        MATCH_MP FUN_IN_IMAGE) THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM th])) THEN
      ONCE_REWRITE_TAC [DISJ_SYM] THEN REWRITE_TAC [IN_UNION, IN_IMAGE] THEN
      MATCH_MP_TAC MONO_OR THEN ASM_MESON_TAC [SUBSET],
      ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"g SUBSET INTERS g' /\ h SUBSET INTERS h'
      ==> ~(g INTER h = {}) ==> ~(INTERS(g' UNION h') = {})")) THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE
     (← q r"IMAGE X s INTER IMAGE X t = {} ==> s INTER t = {}"))) THEN
    CONJ_TAC THEN MATCH_MP_TAC HULL_MINIMAL THEN
    (CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [SUBSET, CONVEX_INTERS]]) THEN
    REWRITE_TAC [SUBSET, IN_INTERS, FORALL_IN_IMAGE] THEN ASM SET_TAC [])

  let HELLY ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f /\ CARD(f) >= dimindex(:N) + 1 /\
        (!s. s IN f ==> convex s) /\
        (!t. t SUBSET f /\ CARD(t) = dimindex(:N) + 1 ==> ~(INTERS t = {}))
        ==> ~(INTERS f = {})"
   (GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC HELLY_INDUCT THEN
    ASM_REWRITE_TAC [HAS_SIZE] THEN ASM_MESON_TAC [])

  let HELLY_ALT ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f /\
        (!s. s IN f ==> convex s) /\
        (!t. t SUBSET f /\ CARD(t) <= dimindex(:N) + 1 ==> ~(INTERS t = {}))
        ==> ~(INTERS f = {})"
   (GEN_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"CARD(f:(real^N->bool)->bool) < dimindex(:N) + 1") THEN
    ASM_SIMP_TAC [SUBSET_REFL, LT_IMP_LE] THEN MATCH_MP_TAC HELLY THEN
    ASM_SIMP_TAC [GE, ← GSYM NOT_LT] THEN ASM_MESON_TAC [LE_REFL])

  let HELLY_CLOSED_ALT ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> convex s /\ closed s) /\ (?s. s IN f /\ bounded s) /\
        (!t. t SUBSET f /\ FINITE t /\ CARD(t) <= dimindex(:N) + 1
             ==> ~(INTERS t = {}))
        ==> ~(INTERS f = {})"
   (GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC CLOSED_FIP THEN ASM_SIMP_TAC [] THEN
    X_GEN_TAC (← q r"g:(real^N->bool)->bool") THEN STRIP_TAC THEN
    MATCH_MP_TAC HELLY_ALT THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM SET_TAC [],
      ASM_MESON_TAC [SUBSET_TRANS, FINITE_SUBSET]])

  let HELLY_COMPACT_ALT ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> convex s /\ compact s) /\
        (!t. t SUBSET f /\ FINITE t /\ CARD(t) <= dimindex(:N) + 1
             ==> ~(INTERS t = {}))
        ==> ~(INTERS f = {})"
   (GEN_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [INTERS_0, UNIV_NOT_EMPTY] THEN
    MATCH_MP_TAC HELLY_CLOSED_ALT THEN
    ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
    ASM_MESON_TAC [MEMBER_NOT_EMPTY, COMPACT_IMP_BOUNDED])

  let HELLY_CLOSED ← prove
   r"!f:(real^N->bool)->bool.
        (FINITE f ==> CARD f >= dimindex (:N) + 1) /\
        (!s. s IN f ==> convex s /\ closed s) /\ (?s. s IN f /\ bounded s) /\
        (!t. t SUBSET f /\ FINITE t /\ CARD(t) = dimindex(:N) + 1
             ==> ~(INTERS t = {}))
        ==> ~(INTERS f = {})"
   (GEN_TAC THEN REWRITE_TAC [GE] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC HELLY_CLOSED_ALT THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"g:(real^N->bool)->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"dimindex(:N) + 1", ← q r"g:(real^N->bool)->bool",
                      ← q r"f:(real^N->bool)->bool"] CHOOSE_SUBSET_BETWEEN) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ ~(s = {}) ==> ~(t = {})")) THEN
    EXISTS_TAC (← q r"INTERS h: real^N->bool") THEN
    CONJ_TAC THENL [ASM SET_TAC [], FIRST_X_ASSUM MATCH_MP_TAC] THEN
    ASM_MESON_TAC [HAS_SIZE])

  let HELLY_COMPACT ← prove
   r"!f:(real^N->bool)->bool.
        (FINITE f ==> CARD f >= dimindex (:N) + 1) /\
        (!s. s IN f ==> convex s /\ compact s) /\
        (!t. t SUBSET f /\ FINITE t /\ CARD(t) = dimindex(:N) + 1
             ==> ~(INTERS t = {}))
        ==> ~(INTERS f = {})"
   (GEN_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [INTERS_0, UNIV_NOT_EMPTY] THEN
    MATCH_MP_TAC HELLY_CLOSED THEN
    ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
    ASM_MESON_TAC [MEMBER_NOT_EMPTY, COMPACT_IMP_BOUNDED])

  return { HELLY_INDUCT, HELLY, HELLY_ALT, HELLY_CLOSED_ALT, HELLY_COMPACT_ALT, HELLY_CLOSED,
           HELLY_COMPACT }

/- ------------------------------------------------------------------------- -/
/- Kirchberger's theorem.  (convex.ml 8276-8382)                             -/
/- ------------------------------------------------------------------------- -/

structure KIR where
  KIRCHBERGER : thm
  deriving Inhabited

@[nospecialize]
def setupKIR [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVH : CVH) (BCAR : CAR) (BOCH : OCH)
    (BSSC : SSC) (BHEL : HEL) : ExceptT String IO KIR := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } :=
    D
  let { CARD_IMAGE_INJ, CARD_UNION, CONJ_ASSOC, DIMINDEX_1, DIMINDEX_FINITE_SUM,
        EXISTS_PASTECART, EXTENSION, FINITE_IMAGE, FINITE_SUBSET, FINITE_UNION, FORALL_AND_THM,
        FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FORALL_SUBSET_IMAGE, FORALL_SUBSET_UNION,
        FSTCART_PASTECART, IMP_CONJ, IMP_IMP, INTERS_IMAGE, INTERS_UNION,
        IN_ELIM_PASTECART_THM, .. } := D.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNION, MEMBER_NOT_EMPTY, REAL_ADD_LID, REAL_ADD_RID, .. } :=
    D.core3
  let { REAL_LT_ADD2, REAL_LT_ANTISYM, REAL_LT_LMUL_EQ, REAL_LT_REFL, REAL_LT_TOTAL, .. } :=
    D.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SNDCART_PASTECART, SUBSET, .. } := D.core5
  let { real_gt, .. } := D.core6
  let { SUBSET_HULL, .. } := D.misc
  let { DOT_LADD, DOT_LMUL, DOT_LZERO, DOT_RNEG, .. } := D.vec1
  let { DROP_ADD, DROP_CMUL, EXISTS_DROP, FORALL_DROP, .. } := D.vec2
  let { PASTECART_ADD, PASTECART_CMUL, .. } := D.vec3
  let { VECTOR_EQ_LDOT, .. } := D.vec4
  let { convex, CONVEX_HALFSPACE_LT, CONVEX_HALFSPACE_GT, .. } := BCVX
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EQ_EMPTY, .. } := BCVH
  let { CARATHEODORY, .. } := BCAR
  let { COMPACT_CONVEX_HULL, .. } := BOCH
  let { SEPARATING_HYPERPLANE_COMPACT_COMPACT, .. } := BSSC
  let { HELLY_ALT, .. } := BHEL
  -- @@SCOPE END

  let KIRCHBERGER ← do
    let lemma ← prove
     r"(!x. x IN convex hull s ==> a dot x < b) /\
       (!x. x IN convex hull t ==> a dot x > b) <=>
       (!x. x IN s ==> a dot x < b) /\ (!x. x IN t ==> a dot x > b)"
     (REWRITE_TAC [← SET_RULE (← q r"(!x. x IN s ==> P x) <=> s SUBSET {x | P x}")] THEN
      SIMP_TAC [SUBSET_HULL, CONVEX_HALFSPACE_LT, CONVEX_HALFSPACE_GT])
    let KIRCH_LEMMA ← prove
     r"!s t:real^N->bool.
            FINITE s /\ FINITE t /\
            (!s' t'. s' SUBSET s /\ t' SUBSET t /\
                     CARD(s') + CARD(t') <= dimindex(:N) + 2
                     ==> ?a b. (!x. x IN s' ==> a dot x < b) /\
                               (!x. x IN t' ==> a dot x > b))
            ==> ?a b. (!x. x IN s ==> a dot x < b) /\
                      (!x. x IN t ==> a dot x > b)"
     (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
       [← q r"IMAGE (\r. {z:real^(N,1)finite_sum |
                            fstcart z dot r < drop(sndcart z)}) s UNION
         IMAGE (\r. {z:real^(N,1)finite_sum |
                            fstcart z dot r > drop(sndcart z)}) t"]
       HELLY_ALT) THEN
      REWRITE_TAC [FORALL_SUBSET_UNION, IN_UNION, IMP_CONJ] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_SUBSET_IMAGE] THEN
      ASM_SIMP_TAC [FINITE_UNION, FINITE_IMAGE, INTERS_UNION] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERS_IMAGE, IN_INTER,
                   EXISTS_PASTECART, IN_ELIM_PASTECART_THM,
                   FSTCART_PASTECART, SNDCART_PASTECART] THEN
      REWRITE_TAC [← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)")] THEN
      REWRITE_TAC [FORALL_AND_THM, FORALL_IN_IMAGE, RIGHT_IMP_FORALL_THM] THEN
      REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC, ← GSYM EXISTS_DROP] THEN
      DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [REWRITE_TAC [← REAL_ARITH (← q r"a > b <=> --a < --b"), ← GSYM DOT_RNEG] THEN
        REWRITE_TAC [convex, IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
        SIMP_TAC [PASTECART_ADD, ← GSYM PASTECART_CMUL, IN_ELIM_PASTECART_THM] THEN
        SIMP_TAC [DOT_LADD, DOT_LMUL, DROP_ADD, DROP_CMUL, ← GSYM FORALL_DROP] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"--(a * x + b * y):real = a * --x + b * --y")] THEN
        REPEAT STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"u + v = &1
          ==> &0 <= u /\ &0 <= v
             ==> u = &0 /\ v = &1 \/ u = &1 /\ v = &0 \/ &0 < u /\ &0 < v"))) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_LID,
                         REAL_ADD_LID, REAL_ADD_RID] THEN
        MATCH_MP_TAC REAL_LT_ADD2 THEN ASM_SIMP_TAC [REAL_LT_LMUL_EQ],
        REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1,
                     ← ARITH_RULE (← q r"(n + 1) + 1 = n + 2")] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
        DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
        SUBGOAL_THEN (← q r"FINITE(u:real^N->bool) /\ FINITE(v:real^N->bool)")
        STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [FINITE_SUBSET], ALL_TAC] THEN
        W (MP_TAC o PART_MATCH (lhs o rand) CARD_UNION o lhand o lhand o snd) THEN
        ASM_SIMP_TAC [FINITE_IMAGE] THEN ANTS_TAC THENL
         [REWRITE_TAC [← SET_RULE (← q r"IMAGE f s INTER IMAGE g t = {} <=>
                                !x y. x IN s /\ y IN t ==> ~(f x = g y)")] THEN
          MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
          REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^N")) THEN
          REWRITE_TAC [← GSYM FORALL_DROP, DOT_LZERO] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN REAL_ARITH_TAC,
          DISCH_THEN SUBST1_TAC] THEN
        DISCH_THEN (fun th => FIRST_X_ASSUM MATCH_MP_TAC THEN MP_TAC th) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← ARITH_RULE
         (← q r"a = a' /\ b = b' ==> a + b <= n + 2 ==> a' + b' <= n + 2")) THEN
        CONJ_TAC THEN MATCH_MP_TAC CARD_IMAGE_INJ THEN
        ASM_REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
        SIMP_TAC [← GSYM FORALL_DROP, real_gt, VECTOR_EQ_LDOT,
          ← MESON [REAL_LT_TOTAL, REAL_LT_REFL]
           (← q r"((!y:real. a < y <=> b < y) <=> a = b) /\
            ((!y:real. y < a <=> y < b) <=> a = b)")]])
    prove
     r"!s t:real^N->bool.
          compact s /\ compact t /\
          (!s' t'. s' SUBSET s /\ t' SUBSET t /\ FINITE s' /\ FINITE t' /\
                   CARD(s') + CARD(t') <= dimindex(:N) + 2
                   ==> ?a b. (!x. x IN s' ==> a dot x < b) /\
                             (!x. x IN t' ==> a dot x > b))
          ==> ?a b. ~(a = vec 0) /\
                    (!x. x IN s ==> a dot x < b) /\
                    (!x. x IN t ==> a dot x > b)"
     (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM lemma] THEN
      MATCH_MP_TAC SEPARATING_HYPERPLANE_COMPACT_COMPACT THEN
      ASM_SIMP_TAC [CONVEX_CONVEX_HULL, COMPACT_CONVEX_HULL,
                    CONVEX_HULL_EQ_EMPTY] THEN
      SUBGOAL_THEN
       (← q r"!s' t'. (s':real^N->bool) SUBSET s /\ t' SUBSET t /\
                FINITE s' /\ CARD(s') <= dimindex(:N) + 1 /\
                FINITE t' /\ CARD(t') <= dimindex(:N) + 1
                ==> DISJOINT (convex hull s') (convex hull t')")
      MP_TAC THENL
       [REPEAT STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"s':real^N->bool", ← q r"t':real^N->bool"] KIRCH_LEMMA) THEN
        ANTS_TAC THENL
         [ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [SUBSET, FINITE_SUBSET],
          ONCE_REWRITE_TAC [← GSYM lemma] THEN SET_TAC [REAL_LT_ANTISYM, real_gt]],
        POP_ASSUM_LIST (K ALL_TAC) THEN STRIP_TAC THEN
        REWRITE_TAC [← SET_RULE (← q r"DISJOINT s t <=> !x. x IN s /\ x IN t ==> F")] THEN
        X_GEN_TAC (← q r"x:real^N") THEN ONCE_REWRITE_TAC [CARATHEODORY] THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        DISCH_THEN (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"s':real^N->bool") STRIP_ASSUME_TAC)
          (X_CHOOSE_THEN (← q r"t':real^N->bool") STRIP_ASSUME_TAC)) THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"s':real^N->bool", ← q r"t':real^N->bool"]) THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  return { KIRCHBERGER }

/- ------------------------------------------------------------------------- -/
/- Convex hull is "preserved" by a linear function; convexity of general     -/
/- and special intervals.  (convex.ml 8386-8580)                             -/
/- ------------------------------------------------------------------------- -/

structure LIN where
  CONVEX_HULL_LINEAR_IMAGE : thm
  IN_CONVEX_HULL_LINEAR_IMAGE : thm
  CONIC_CONVEX_HULL : thm
  CONIC_HULL_CONVEX_HULL : thm
  IS_INTERVAL_CONVEX : thm
  IS_INTERVAL_CONNECTED : thm
  IS_INTERVAL_CONNECTED_1 : thm
  CONVEX_INTERVAL : thm
  CONNECTED_INTERVAL : thm
  LIMIT_POINT_OF_INTERVAL : thm
  CONVEX_CONNECTED_COLLINEAR : thm
  CONVEX_EQ_CONVEX_LINE_INTERSECTION : thm
  CONVEX_EQ_CONNECTED_LINE_INTERSECTION : thm
  deriving Inhabited

@[nospecialize]
def setupLIN [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BCON : CON) (BCOP : COP)
    (BCVH : CVH) (BCLH : CLH) (BAFI : AFI) : ExceptT String IO LIN := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH,
        add_linear_invariants, GEOM_BASIS_MULTIPLE_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { AND_FORALL_THM, ARITH, CONJ_ASSOC, CONTRAPOS_THM, DIMINDEX_1, DIMINDEX_GE_1, EXTENSION,
        FINITE_EMPTY, FINITE_SING, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMP_CONJ, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_UNION, LEFT_IMP_EXISTS_THM, LE_REFL,
        NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_LADD, REAL_LE_LMUL, REAL_LE_LT, REAL_LE_RADD, REAL_LE_TOTAL, REAL_LT_LE,
        REAL_LT_MUL, REAL_LT_TOTAL, .. } := D.core4
  let { REAL_MUL_RID, REAL_SUB_0, REAL_SUB_LT, REAL_SUB_REFL, REAL_SUB_RZERO,
        RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM, .. } := D.core5
  let { UNWIND_THM1, real_gt, .. } := D.core6
  let { HULL_INC, HULL_INDUCT, HULL_MINIMAL, HULL_MONO, HULL_SUBSET, .. } := D.misc
  let { BASIS_NONZERO, COLLINEAR_2, COLLINEAR_SUBSET, DOT_BASIS, DOT_BASIS_BASIS, DOT_RADD,
        DOT_RMUL, DOT_RSUB, .. } := D.vec1
  let { FORALL_LIFT, INTERVAL_SING, LIFT_DROP, LINEAR_ADD, LINEAR_CMUL, LINEAR_SCALING, .. } :=
    D.vec2
  let { SPAN_ADD, SPAN_EMPTY, SPAN_INSERT_0, SPAN_MUL, SPAN_SING, SPAN_SPECIAL_SCALE, .. } :=
    D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB, VECTOR_ADD_RID,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_LID, VECTOR_MUL_LZERO, drop, .. } := D.vec4
  let { CLOSED_INTERVAL, .. } := D.top1
  let { CLOSURE_INTERVAL, CONNECTED_IMP_PERFECT_CLOSED, .. } := D.top2
  let { INTERVAL_EQ_SING, IN_SEGMENT, IS_INTERVAL_1, IS_INTERVAL_INTERVAL, LIMIT_POINT_FINITE,
        LIMPT_EMPTY, LIMPT_OF_CLOSURE, OPEN_HALFSPACE_GT, .. } := D.top4
  let { OPEN_HALFSPACE_LT, SEGMENT_REFL, connected, is_interval, .. } := D.top5
  let { AFFINE_AFFINE_HULL, .. } := BAFF
  let { convex, CONVEX_CONTAINS_SEGMENT, CONVEX_EMPTY, CONVEX_SING, CONVEX_INTER, .. } := BCVX
  let { CONIC_CONIC_HULL, CONVEX_CONIC_HULL, .. } := BCON
  let { COLLINEAR_AFFINE_HULL, COLLINEAR_AFFINE_HULL_COLLINEAR, CONVEX_CONNECTED, .. } := BCOP
  let { CONVEX_CONVEX_HULL, .. } := BCVH
  let { AFFINE_IMP_CONVEX, AFFINE_HULL_EQ_SPAN, .. } := BCLH
  let { CONIC_IMAGE_MULTIPLE_EQ, .. } := BAFI
  -- @@SCOPE END

  let CONVEX_HULL_LINEAR_IMAGE ← prove
   r"!f s. linear f ==> convex hull (IMAGE f s) = IMAGE f (convex hull s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    CONJ_TAC THEN MATCH_MP_TAC HULL_INDUCT THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN SIMP_TAC [FUN_IN_IMAGE, HULL_INC] THEN
    REWRITE_TAC [convex, IN_ELIM_THM] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THENL
     [FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_CMUL th)])) THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_ADD th)])) THEN
      REWRITE_TAC [IN_IMAGE] THEN
      MESON_TAC [← REWRITE_RULE [convex] CONVEX_CONVEX_HULL],
      ASM_SIMP_TAC [LINEAR_ADD, LINEAR_CMUL] THEN
      MESON_TAC [← REWRITE_RULE [convex] CONVEX_CONVEX_HULL]])

  add_linear_invariants [CONVEX_HULL_LINEAR_IMAGE]

  let IN_CONVEX_HULL_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s x.
        linear f /\ x IN convex hull s ==> (f x) IN convex hull (IMAGE f s)"
   (SIMP_TAC [CONVEX_HULL_LINEAR_IMAGE] THEN SET_TAC [])

  let CONIC_CONVEX_HULL ← prove
   r"!s:real^N->bool. conic s ==> conic(convex hull s)"
   (SIMP_TAC [CONIC_IMAGE_MULTIPLE_EQ, ← GSYM CONVEX_HULL_LINEAR_IMAGE,
              LINEAR_SCALING, HULL_MONO])

  let CONIC_HULL_CONVEX_HULL ← prove
   r"!s:real^N->bool. conic hull (convex hull s) = convex hull (conic hull s)"
   (GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THEN
    MATCH_MP_TAC HULL_MINIMAL THEN
    SIMP_TAC [CONVEX_CONIC_HULL, HULL_SUBSET, CONVEX_CONVEX_HULL, HULL_MONO,
              CONIC_CONVEX_HULL, CONIC_CONIC_HULL])

  let IS_INTERVAL_CONVEX ← prove
   r"!s:real^N->bool. is_interval s ==> convex s"
   (REWRITE_TAC [is_interval, convex] THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    ASM_SIMP_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
    GEN_TAC THEN STRIP_TAC THEN
    DISJ_CASES_TAC (← SPECL [← q r"(x:real^N)$i", ← q r"(y:real^N)$i"] REAL_LE_TOTAL) THENL
     [DISJ1_TAC, DISJ2_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"&1 * a <= b /\ b <= &1 * c ==> a <= b /\ b <= c")) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [← GSYM VECTOR_MUL_COMPONENT,
                  VECTOR_ADD_RDISTRIB, VECTOR_ADD_COMPONENT] THEN
    ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, REAL_LE_LMUL,
                  REAL_LE_LADD, REAL_LE_RADD])

  let IS_INTERVAL_CONNECTED ← prove
   r"!s:real^N->bool. is_interval s ==> connected s"
   (MESON_TAC [IS_INTERVAL_CONVEX, CONVEX_CONNECTED])

  let IS_INTERVAL_CONNECTED_1 ← prove
   r"!s:real^1->bool. is_interval s <=> connected s"
   (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [IS_INTERVAL_CONNECTED] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [IS_INTERVAL_1, connected, NOT_FORALL_THM, LEFT_IMP_EXISTS_THM,
                 NOT_IMP, FORALL_LIFT, LIFT_DROP] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"x:real"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{z:real^1 | basis 1 dot z < x}", ← q r"{z:real^1 | basis 1 dot z > x}"] THEN
    REWRITE_TAC [OPEN_HALFSPACE_LT, OPEN_HALFSPACE_GT] THEN
    SIMP_TAC [SUBSET, EXTENSION, IN_UNION, IN_INTER, ← GSYM drop, NOT_FORALL_THM,
     real_gt, NOT_IN_EMPTY, IN_ELIM_THM, DOT_BASIS, DIMINDEX_1, ARITH] THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_LT_TOTAL, LIFT_DROP],
      REAL_ARITH_TAC,
      EXISTS_TAC (← q r"lift a"),
      EXISTS_TAC (← q r"lift b")] THEN
    ASM_REWRITE_TAC [REAL_LT_LE, LIFT_DROP] THEN ASM_MESON_TAC [])

  let CONVEX_INTERVAL ← prove
   r"!a b:real^N. convex(interval [a,b]) /\ convex(interval (a,b))"
   (SIMP_TAC [IS_INTERVAL_CONVEX, IS_INTERVAL_INTERVAL])

  let CONNECTED_INTERVAL ← prove
   r"(!a b:real^N. connected(interval[a,b])) /\
   (!a b:real^N. connected(interval(a,b)))"
   (SIMP_TAC [CONVEX_CONNECTED, CONVEX_INTERVAL])

  let LIMIT_POINT_OF_INTERVAL ← prove
   r"(!a b x:real^N.
        x limit_point_of interval[a,b] <=>
        ~(a = b) /\ x IN interval[a,b]) /\
   (!a b x:real^N.
        x limit_point_of interval(a,b) <=>
        ~(interval(a,b) = {}) /\ x IN interval[a,b])"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"a:real^N = b") THEN ASM_REWRITE_TAC [INTERVAL_SING] THEN
    SIMP_TAC [LIMIT_POINT_FINITE, FINITE_SING, FINITE_EMPTY] THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← GSYM LIMPT_OF_CLOSURE] THEN
    REWRITE_TAC [CLOSURE_INTERVAL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [LIMPT_EMPTY] THEN
    MATCH_MP_TAC CONNECTED_IMP_PERFECT_CLOSED THEN
    REWRITE_TAC [CONNECTED_INTERVAL, CLOSED_INTERVAL] THEN
    ASM_REWRITE_TAC [INTERVAL_EQ_SING, UNWIND_THM1])

  let CONVEX_CONNECTED_COLLINEAR ← prove
   r"!s:real^N->bool. collinear s ==> (convex s <=> connected s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [CONVEX_CONNECTED] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [COLLINEAR_AFFINE_HULL]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN
    GEOM_ORIGIN_TAC (← q r"u:real^N") THEN
    SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC, IN_INSERT, SPAN_INSERT_0] THEN
    GEOM_BASIS_MULTIPLE_TAC 1 (← q r"v:real^N") THEN
    GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    REWRITE_TAC [SPAN_SPECIAL_SCALE] THEN COND_CASES_TAC THENL
     [REWRITE_TAC [SPAN_EMPTY, ← SET_RULE (← q r"s SUBSET {a} <=> s = {} \/ s = {a}")] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [CONVEX_EMPTY, CONVEX_SING],
      DISCH_TAC THEN
      REWRITE_TAC [CONVEX_CONTAINS_SEGMENT, connected, NOT_EXISTS_THM] THEN
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"a:real^N = b") THEN
      ASM_REWRITE_TAC [SEGMENT_REFL, SING_SUBSET] THEN
      REWRITE_TAC [SUBSET, IN_SEGMENT, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"u:real"] THEN
      MAP_EVERY ASM_CASES_TAC [← q r"u = &0", ← q r"u = &1"] THEN
      ASM_SIMP_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_LID, REAL_SUB_REFL,
                    REAL_SUB_RZERO, VECTOR_ADD_LID, VECTOR_ADD_RID] THEN
      ASM_REWRITE_TAC [REAL_LE_LT] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"{y:real^N | basis 1 dot y < basis 1 dot (x:real^N)}",
        ← q r"{y:real^N | basis 1 dot y > basis 1 dot (x:real^N)}"]) THEN
      REWRITE_TAC [OPEN_HALFSPACE_LT, OPEN_HALFSPACE_GT] THEN
      MATCH_MP_TAC (← TAUT (← q r"q /\ r /\ (~p ==> s) ==> ~(p /\ q /\ r) ==> s")) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_INTER, IN_ELIM_THM, NOT_IN_EMPTY] THEN
        REWRITE_TAC [CONJ_ASSOC, ← REAL_ARITH (← q r"~(x:real < a /\ x > a)")],
        ALL_TAC] THEN
      REWRITE_TAC [real_gt] THEN ONCE_REWRITE_TAC [← GSYM REAL_SUB_LT] THEN
      REWRITE_TAC [← GSYM DOT_RSUB, ← SET_RULE
       (← q r"~(s SUBSET {x | P x} UNION {x | Q x}) <=>
        ?x. x IN s /\ ~(P x \/ Q x)")] THEN
      SUBGOAL_THEN
       (← q r"!p q:real^N. p IN span {basis 1} /\ q IN span {basis 1} /\
                     basis 1 dot p = basis 1 dot q
                     ==> p = q")
      ASSUME_TAC THENL
       [SIMP_TAC [SPAN_SING, IMP_CONJ, LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN
        SIMP_TAC [DOT_RMUL, BASIS_NONZERO, DOT_BASIS_BASIS, DIMINDEX_GE_1,
                  LE_REFL, REAL_MUL_RID],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(x:real^N) IN span {basis 1}") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SPAN_ADD THEN CONJ_TAC THEN
        MATCH_MP_TAC SPAN_MUL THEN ASM SET_TAC [],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC (← SET_RULE
         (← q r"(a:real^N) IN s \/ b IN s ==> ~(s = {})")) THEN
        ASM_REWRITE_TAC [IN_INTER, IN_ELIM_THM, DOT_RADD, DOT_RMUL,
          ← VECTOR_ARITH (← q r"((&1 - u) % a + u % b) - b:real^N = (u - &1) % (b - a)"),
          ← VECTOR_ARITH (← q r"((&1 - u) % a + u % b) - a:real^N = u % (b - a)"),
          ← VECTOR_ARITH (← q r"b - ((&1 - u) % a + u % b):real^N = (u - &1) % (a - b)"),
          ← VECTOR_ARITH (← q r"a - ((&1 - u) % a + u % b):real^N = u % (a - b)")] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"(&0 < x ==> &0 < u * x) /\ (&0 < --x ==> &0 < (&1 - u) * --x) /\
          ~(x = &0)
          ==>  &0 < u * x \/ &0 < (u - &1) * x")) THEN
        ASM_SIMP_TAC [REAL_LT_MUL, REAL_SUB_LT] THEN
        REWRITE_TAC [DOT_RSUB, REAL_SUB_0],
        REWRITE_TAC [DOT_RSUB, ← REAL_ARITH
         (← q r"~(&0 < x - y \/ &0 < y - x) <=> y = x")]] THEN
      ASM SET_TAC []])

  let CONVEX_EQ_CONVEX_LINE_INTERSECTION ← prove
   r"!s:real^N->bool. convex s <=> !a b. convex(s INTER affine hull {a,b})"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [CONVEX_INTER, AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL] THEN
    REWRITE_TAC [CONVEX_CONTAINS_SEGMENT] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"a:real^N", ← q r"b:real^N", ← q r"a:real^N", ← q r"b:real^N"]) THEN
    ASM_SIMP_TAC [IN_INTER, HULL_INC, IN_INSERT] THEN SET_TAC [])

  let CONVEX_EQ_CONNECTED_LINE_INTERSECTION ← prove
   r"!s:real^N->bool. convex s <=> !a b. connected(s INTER affine hull {a,b})"
   (GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [CONVEX_EQ_CONVEX_LINE_INTERSECTION] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
    MATCH_MP_TAC CONVEX_CONNECTED_COLLINEAR THEN
    MATCH_MP_TAC COLLINEAR_SUBSET THEN
    EXISTS_TAC (← q r"affine hull {a:real^N,b}") THEN
    REWRITE_TAC [COLLINEAR_AFFINE_HULL_COLLINEAR, COLLINEAR_2] THEN
    SET_TAC [])

  return { CONVEX_HULL_LINEAR_IMAGE, IN_CONVEX_HULL_LINEAR_IMAGE, CONIC_CONVEX_HULL,
           CONIC_HULL_CONVEX_HULL, IS_INTERVAL_CONVEX, IS_INTERVAL_CONNECTED,
           IS_INTERVAL_CONNECTED_1, CONVEX_INTERVAL, CONNECTED_INTERVAL,
           LIMIT_POINT_OF_INTERVAL, CONVEX_CONNECTED_COLLINEAR,
           CONVEX_EQ_CONVEX_LINE_INTERSECTION, CONVEX_EQ_CONNECTED_LINE_INTERSECTION }

/- ------------------------------------------------------------------------- -/
/- On real^1, is_interval, convex and connected are all equivalent.          -/
/- (convex.ml 8584-8688)                                                     -/
/- ------------------------------------------------------------------------- -/

structure ONE where
  IS_INTERVAL_CONVEX_1 : thm
  CONVEX_CONNECTED_1 : thm
  CONNECTED_CONVEX_1 : thm
  CONNECTED_COMPACT_INTERVAL_1 : thm
  CONVEX_CONNECTED_1_GEN : thm
  CONNECTED_CONVEX_1_GEN : thm
  COMPACT_CONVEX_COLLINEAR_SEGMENT_ALT : thm
  COMPACT_CONVEX_COLLINEAR_SEGMENT : thm
  IN_CONVEX_HULL_SEGMENT_1 : thm
  IN_CONVEX_HULL_INTERVAL_1 : thm
  deriving Inhabited

@[nospecialize]
def setupONE [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BCOP : COP) (BCVH : CVH)
    (BLIN : LIN) : ExceptT String IO ONE := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, GEOM_BASIS_MULTIPLE_TAC,
        GEOM_EQUAL_DIMENSION_RULE, GEOM_ORIGIN_TAC, .. } := D
  let { AND_FORALL_THM, DIMINDEX_1, DIMINDEX_GE_1, .. } := D.core1
  let { FORALL_IN_INSERT, IMAGE_EQ_EMPTY, .. } := D.core2
  let { IN_ELIM_THM, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, LE_REFL, NOT_IN_EMPTY, .. } :=
    D.core3
  let { REAL_LT_REFL, .. } := D.core4
  let { REAL_MUL_RID, REAL_NOT_LE, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SUBSET, .. } :=
    D.core5
  let { HULL_INC, HULL_INDUCT, HULL_MONO, HULL_P, .. } := D.misc
  let { BASIS_COMPONENT, .. } := D.vec1
  let { LIFT_DROP, LINEAR_LIFT_COMPONENT, .. } := D.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_LZERO, VEC_COMPONENT, .. } := D.vec4
  let { COMPACT_CONTINUOUS_IMAGE, CONNECTED_CONTINUOUS_IMAGE, .. } := D.top2
  let { INTERVAL_NE_EMPTY_1, INTERVAL_SUBSET_SEGMENT_1, IN_INTERVAL_1, IS_INTERVAL_1,
        IS_INTERVAL_COMPACT, LINEAR_CONTINUOUS_ON, .. } := D.top4
  let { SEGMENT_SCALAR_MULTIPLE, .. } := D.top5
  let { affine, .. } := BAFF
  let { CONVEX_CONTAINS_SEGMENT, .. } := BCVX
  let { COLLINEAR_AFFINE_HULL, CONVEX_CONNECTED, .. } := BCOP
  let { CONVEX_CONVEX_HULL, .. } := BCVH
  let { IS_INTERVAL_CONVEX, IS_INTERVAL_CONNECTED_1, CONVEX_CONNECTED_COLLINEAR, .. } := BLIN
  -- @@SCOPE END

  let IS_INTERVAL_CONVEX_1 ← prove
   r"!s:real^1->bool. is_interval s <=> convex s"
   (MESON_TAC [IS_INTERVAL_CONVEX, CONVEX_CONNECTED, IS_INTERVAL_CONNECTED_1])

  let CONVEX_CONNECTED_1 ← prove
   r"!s:real^1->bool. convex s <=> connected s"
   (REWRITE_TAC [← GSYM IS_INTERVAL_CONVEX_1, ← GSYM IS_INTERVAL_CONNECTED_1])

  let CONNECTED_CONVEX_1 ← prove
   r"!s:real^1->bool. connected s <=> convex s"
   (REWRITE_TAC [← GSYM IS_INTERVAL_CONVEX_1, ← GSYM IS_INTERVAL_CONNECTED_1])

  let CONNECTED_COMPACT_INTERVAL_1 ← prove
   r"!s:real^1->bool. connected s /\ compact s <=> ?a b. s = interval[a,b]"
   (REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1, IS_INTERVAL_COMPACT])

  let CONVEX_CONNECTED_1_GEN ← prove
   r"!s:real^N->bool.
        dimindex(:N) = 1 ==> (convex s <=> connected s)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← GSYM DIMINDEX_1] THEN
    DISCH_THEN (ACCEPT_TAC o C GEOM_EQUAL_DIMENSION_RULE CONVEX_CONNECTED_1))

  let CONNECTED_CONVEX_1_GEN ← prove
   r"!s:real^N->bool.
        dimindex(:N) = 1 ==> (connected s <=> convex s)"
   (SIMP_TAC [CONVEX_CONNECTED_1_GEN])

  let COMPACT_CONVEX_COLLINEAR_SEGMENT_ALT ← prove
   r"!s:real^N->bool.
        ~(s = {}) /\ compact s /\ connected s /\ collinear s
        ==> ?a b. s = segment[a,b]"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [COLLINEAR_AFFINE_HULL]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"z:real^N", ← q r"w:real^N"] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN GEOM_ORIGIN_TAC (← q r"z:real^N") THEN
    REPEAT GEN_TAC THEN GEOM_BASIS_MULTIPLE_TAC 1 (← q r"w:real^N") THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\x:real^N. lift(x$1)) s")
          CONNECTED_COMPACT_INTERVAL_1) THEN
    ASM_SIMP_TAC [CONNECTED_CONTINUOUS_IMAGE, COMPACT_CONTINUOUS_IMAGE,
                  LINEAR_LIFT_COMPONENT, LINEAR_CONTINUOUS_ON] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
    ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
    ASM_REWRITE_TAC [IMAGE_EQ_EMPTY] THEN STRIP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"drop a % basis 1:real^N", ← q r"drop b % basis 1:real^N"] THEN
    ASM_SIMP_TAC [SEGMENT_SCALAR_MULTIPLE, ← REAL_ARITH
     (← q r"a <= b
      ==> (a <= x /\ x <= b \/ b <= x /\ x <= a <=> a <= x /\ x <= b)")] THEN
    ONCE_REWRITE_TAC [← MESON [LIFT_DROP]
     (← q r"a <= x /\ x <= b <=> a <= drop(lift x) /\ drop(lift x) <= b")] THEN
    REWRITE_TAC [← GSYM IN_INTERVAL_1] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. lift(drop x) = x) /\ (!x. drop(lift x) = x) /\
       (!x. x IN s ==> f(drop(g x)) = x)
      ==> s = {f y | lift y IN IMAGE g s}")) THEN
    REWRITE_TAC [LIFT_DROP] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← SET_RULE (← q r"s SUBSET t
                ==> (!x. x IN t ==> P x) ==> (!x. x IN s ==> P x)"))) THEN
    MATCH_MP_TAC HULL_INDUCT THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, VECTOR_MUL_COMPONENT,
              VEC_COMPONENT, DIMINDEX_GE_1, LE_REFL, VECTOR_MUL_LZERO,
              BASIS_COMPONENT, REAL_MUL_RID, affine, IN_ELIM_THM,
              VECTOR_ADD_COMPONENT, VECTOR_ADD_RDISTRIB, ← GSYM VECTOR_MUL_ASSOC])

  let COMPACT_CONVEX_COLLINEAR_SEGMENT ← prove
   r"!s:real^N->bool.
        ~(s = {}) /\ compact s /\ convex s /\ collinear s
        ==> ?a b. s = segment[a,b]"
   (MESON_TAC [COMPACT_CONVEX_COLLINEAR_SEGMENT_ALT,
               CONVEX_CONNECTED_COLLINEAR])

  let (IN_CONVEX_HULL_SEGMENT_1, IN_CONVEX_HULL_INTERVAL_1) ← CONJ_PAIR (← prove
   r"(!s:real^1->bool x.
        x IN convex hull s <=>
        ?a b. a IN s /\ b IN s /\ x IN segment[a,b]) /\
   (!s:real^1->bool x.
        x IN convex hull s <=>
        ?a b. a IN s /\ b IN s /\ x IN interval[a,b])"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(r ==> q) /\ (q ==> p) /\ (p ==> r)
      ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [SUBSET, INTERVAL_SUBSET_SEGMENT_1],
      MESON_TAC [← REWRITE_RULE [SUBSET] CONVEX_CONTAINS_SEGMENT,
                 HULL_INC, CONVEX_CONVEX_HULL],
      DISCH_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ p /\ q <=> (a /\ p) /\ (b /\ q)")] THEN
      REWRITE_TAC [RIGHT_EXISTS_AND_THM, LEFT_EXISTS_AND_THM] THEN
      ONCE_REWRITE_TAC [← SET_RULE
       (← q r"(?x. x IN s /\ P x) <=> ~(s SUBSET {x | ~P x})")] THEN
      CONJ_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← MESON [HULL_MONO]
        (← q r"s SUBSET t ==> convex hull s SUBSET convex hull t"))) THEN
      REWRITE_TAC [SUBSET, REAL_NOT_LE] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^1")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← MESON []
       (← q r"convex hull s = s /\ ~(x IN s) ==> ~(x IN convex hull s)")) THEN
      REWRITE_TAC [IN_ELIM_THM, REAL_LT_REFL] THEN MATCH_MP_TAC HULL_P THEN
      REWRITE_TAC [← GSYM IS_INTERVAL_CONVEX_1, IS_INTERVAL_1, IN_ELIM_THM] THEN
      REAL_ARITH_TAC]))

  return { IS_INTERVAL_CONVEX_1, CONVEX_CONNECTED_1, CONNECTED_CONVEX_1,
           CONNECTED_COMPACT_INTERVAL_1, CONVEX_CONNECTED_1_GEN, CONNECTED_CONVEX_1_GEN,
           COMPACT_CONVEX_COLLINEAR_SEGMENT_ALT, COMPACT_CONVEX_COLLINEAR_SEGMENT,
           IN_CONVEX_HULL_SEGMENT_1, IN_CONVEX_HULL_INTERVAL_1 }

/- ------------------------------------------------------------------------- -/
/- Jung's theorem.  (convex.ml 8695-9001)                                    -/
/- Proof taken from http://cstheory.wordpress.com/2010/08/07/jungs-theorem/  -/
/- ------------------------------------------------------------------------- -/

structure JUN where
  JUNG : thm
  deriving Inhabited

@[nospecialize]
def setupJUN [HolBase] (D : ConvexDeps) (BCVB : CVB) (BCVH : CVH) (BCVE : CVE) (BOCH : OCH)
    (BSEP : SEP) (BHEL : HEL) : ExceptT String IO JUN := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, NORM_ARITH_TAC,
        GEOM_BASIS_MULTIPLE_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { ARITH, CARD_EQ_0, CARD_IMAGE_INJ, CARD_SUBSET, DIMINDEX_GE_1, ETA_AX, EXISTS_IN_IMAGE,
        FINITE_DELETE, FINITE_DIFF, FINITE_IMAGE, FINITE_RESTRICT,
        FORALL_FINITE_SUBSET_IMAGE, .. } := D.core1
  let { FORALL_IN_IMAGE, HAS_SIZE, IMAGE_EQ_EMPTY, IMP_CONJ_ALT, INF, INTERS_IMAGE, IN_DELETE,
        IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, LE_ADD, LE_REFL, LE_TRANS, MEMBER_NOT_EMPTY,
        MONO_EXISTS, MULT_CLAUSES, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY,
        POW_2_SQRT, REAL_ARCH_INV, .. } := D.core3
  let { REAL_EQ_IMP_LE, REAL_INF_LE_FINITE, REAL_INV_LE_1, REAL_INV_MUL, REAL_LET_TRANS,
        REAL_LE_DIV, REAL_LE_INV2, REAL_LE_LADD, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_MUL,
        REAL_LE_POW_2, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_RSQRT, REAL_LE_TRANS,
        REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INF_FINITE,
        REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_LE, REAL_LT_RADD, REAL_LT_SQUARE_ABS, .. } :=
    D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NOT_LE, REAL_NOT_LT,
        REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_MUL, REAL_POS, REAL_POW_2,
        REAL_POW_LE, REAL_POW_LE2, REAL_SUB_LT, REAL_SUB_RZERO, RIGHT_AND_EXISTS_THM,
        SKOLEM_THM, SQRT_MUL, SQRT_POS_LE, SUBSET, SUBSET_TRANS, .. } := D.core5
  let { SUM_CLAUSES_LEFT, SUM_CONST, SUM_DELETE, SUM_EQ, SUM_EQ_SUPERSET, SUM_LE, SUM_LMUL,
        SUM_RMUL, SUM_SUB, o_THM, real_div, real_gt, .. } := D.core6
  let { HULL_INC, MONOTONE_BIGGER, REAL_HALF, .. } := D.misc
  let { BASIS_COMPONENT, BASIS_NONZERO, DIST_SYM, DOT_BASIS, DOT_LMUL, DOT_RMUL, DOT_RSUM,
        DOT_RZERO, .. } := D.vec1
  let { NORM_0, NORM_BASIS, NORM_EQ_SQUARE, .. } := D.vec2
  let { NORM_LT, NORM_MUL, NORM_POS_LE, NORM_POW_2, NORM_SUB, .. } := D.vec3
  let { VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0, VECTOR_SUB_COMPONENT, VECTOR_SUB_REFL, dist,
        dot, .. } := D.vec4
  let { BOUNDED_SUBSET, BOUNDED_SUBSET_CBALL, .. } := D.top1
  let { COMPACT_CBALL, COMPACT_IMP_CLOSED, .. } := D.top2
  let { DIAMETER_BOUNDED_BOUND, DIAMETER_POS_LE, DIAMETER_SUBSET, EQ_BALLS,
        FINITE_IMP_COMPACT, .. } := D.top3
  let { IN_CBALL, IN_CBALL_0, LIM_SEQUENTIALLY, .. } := D.top4
  let { SUBSET_CBALL, compact, .. } := D.top5
  let { CONVEX_CBALL, .. } := BCVB
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EMPTY, .. } := BCVH
  let { CONVEX_HULL_FINITE, .. } := BCVE
  let { COMPACT_CONVEX_HULL, .. } := BOCH
  let { SEPARATING_HYPERPLANE_CLOSED_0, .. } := BSEP
  let { HELLY_COMPACT_ALT, .. } := BHEL
  -- @@SCOPE END

  let JUNG ← do
    let lemma ← prove
     r"&0 < x /\ x <= y ==> (x - &1) / x <= (y - &1) / y"
     (SIMP_TAC [REAL_LE_LDIV_EQ] THEN REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← REAL_ARITH (← q r"x / y * z:real = (x * z) / y")] THEN
      SUBGOAL_THEN (← q r"&0 < y") ASSUME_TAC THENL
       [ASM_REAL_ARITH_TAC, ASM_SIMP_TAC [REAL_LE_RDIV_EQ]] THEN
      ASM_REAL_ARITH_TAC)
    prove
     r"!s:real^N->bool r.
          bounded s /\
          sqrt(&(dimindex(:N)) / &(2 * dimindex(:N) + 2)) * diameter s <= r
          ==> ?a. s SUBSET cball(a,r)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"&0 <= r") ASSUME_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            REAL_LE_TRANS)) THEN
        MATCH_MP_TAC REAL_LE_MUL THEN ASM_SIMP_TAC [DIAMETER_POS_LE] THEN
        SIMP_TAC [SQRT_POS_LE, REAL_LE_DIV, REAL_POS],
        ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"IMAGE (\x:real^N. cball(x,r)) s") HELLY_COMPACT_ALT) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, COMPACT_CBALL, CONVEX_CBALL] THEN
      REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> q /\ p ==> r ==> s")] THEN
      REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
      REWRITE_TAC [INTERS_IMAGE, ← GSYM MEMBER_NOT_EMPTY] THEN
      REWRITE_TAC [SUBSET, IN_CBALL, IN_ELIM_THM] THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC [DIST_SYM]] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN REWRITE_TAC [← GSYM SUBSET] THEN
      STRIP_TAC THEN
      ASM_SIMP_TAC [CARD_IMAGE_INJ, EQ_BALLS, ← GSYM REAL_NOT_LE] THEN
      UNDISCH_TAC (← q r"FINITE(t:real^N->bool)") THEN
      SUBGOAL_THEN (← q r"bounded(t:real^N->bool)") MP_TAC THENL
       [ASM_MESON_TAC [BOUNDED_SUBSET], ALL_TAC] THEN
      UNDISCH_TAC (← q r"&0 <= r") THEN
      SUBGOAL_THEN
       (← q r"sqrt(&(dimindex(:N)) / &(2 * dimindex(:N) + 2)) *
        diameter(t:real^N->bool) <= r")
      MP_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            REAL_LE_TRANS)) THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN
        ASM_SIMP_TAC [DIAMETER_SUBSET, SQRT_POS_LE, REAL_POS, REAL_LE_DIV],
        POP_ASSUM_LIST (K ALL_TAC) THEN
        SPEC_TAC ((← q r"t:real^N->bool"), (← q r"s:real^N->bool")) THEN
        REPEAT STRIP_TAC] THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
      MP_TAC (← ISPEC (← q r"{d | &0 <= d /\ ?a:real^N. s SUBSET cball(a,d)}") INF) THEN
      ABBREV_TAC (← q r"d = inf {d | &0 <= d /\ ?a:real^N. s SUBSET cball(a,d)}") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN ANTS_TAC THENL
       [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
        ASM_MESON_TAC [BOUNDED_SUBSET_CBALL, REAL_LT_IMP_LE],
        DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "P") (LABEL_TAC "M"))] THEN
      SUBGOAL_THEN (← q r"&0 <= d") ASSUME_TAC THENL
       [ASM_MESON_TAC [REAL_LE_REFL], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"?a:real^N. s SUBSET cball(a,d)") MP_TAC THENL
       [SUBGOAL_THEN
         (← q r"!n. ?a:real^N. s SUBSET cball(a,d + inv(&n + &1))")
        MP_TAC THENL
         [X_GEN_TAC (← q r"n:num") THEN
          REMOVE_THEN "M" (MP_TAC o SPEC (← q r"d + inv(&n + &1)")) THEN
          REWRITE_TAC [← REAL_ARITH (← q r"d + i <= d <=> ~(&0 < i)")] THEN
          REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
          REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, REAL_NOT_LE] THEN
          MESON_TAC [SUBSET_CBALL, REAL_LT_IMP_LE, SUBSET_TRANS],
          ALL_TAC] THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM, SKOLEM_THM] THEN
        X_GEN_TAC (← q r"aa:num->real^N") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"?t. compact t /\ !n. (aa:num->real^N) n IN t") MP_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o
            MATCH_MP BOUNDED_SUBSET_CBALL) THEN
          REWRITE_TAC [LEFT_IMP_EXISTS_THM, SUBSET, IN_CBALL_0] THEN
          X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN
          EXISTS_TAC (← q r"cball(vec 0:real^N,B + d + &1)") THEN
          REWRITE_TAC [COMPACT_CBALL, IN_CBALL_0] THEN X_GEN_TAC (← q r"n:num") THEN
          RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, IN_CBALL]) THEN
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"(?x:real^N. norm(x) <= B /\ dist(a,x) <= d) ==> norm(a) <= B + d")) THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
          MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN ASM_SIMP_TAC [] THEN
          MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"d + inv(&n + &1)") THEN
          ASM_SIMP_TAC [REAL_LE_LADD] THEN
          MATCH_MP_TAC REAL_INV_LE_1 THEN REAL_ARITH_TAC,
          ALL_TAC] THEN
        REWRITE_TAC [compact, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"t:real^N->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"aa:num->real^N")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
        REWRITE_TAC [SUBSET, IN_CBALL] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
        MP_TAC (← SPEC (← q r"(dist(a:real^N,x) - d) / &2") REAL_ARCH_INV) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"(dist(a:real^N,x) - d) / &2")) THEN
        ASM_SIMP_TAC [REAL_SUB_LT, REAL_HALF, o_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N1:num") STRIP_ASSUME_TAC) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N2:num") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [SUBSET]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"(r:num->num)(N1 + N2)", ← q r"x:real^N"]) THEN
        ASM_REWRITE_TAC [IN_CBALL, REAL_NOT_LE] THEN
