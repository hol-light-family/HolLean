      ANTS_TAC THENL [ASM_MESON_TAC [REAL_MUL_SYM], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\x. B % (g:real^M->real^N) x") THEN
      REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, NORM_MUL] THEN
      ASM_SIMP_TAC [real_abs, REAL_LE_INV_EQ, REAL_LT_IMP_LE] THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_RINV, REAL_LT_IMP_NZ, VECTOR_MUL_LID])

  let LIPSCHITZ_EXTENSION_EXISTS ← prove
   r"!f:real^M->real^N s.
        (?B. !x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y))
        ==> ?g. (?B. !x y. norm(g x - g y) <= B * norm(x - y)) /\
                (!x. x IN s ==> g x = f x)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"abs B + &1"]
         KIRSZBRAUN) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    ASM_MESON_TAC [REAL_LE_RMUL, REAL_LE_TRANS, NORM_POS_LE,
                   ← REAL_ARITH (← q r"&0 <= abs B + &1 /\ B <= abs B + &1")])

  return { KIRSZBRAUN, LIPSCHITZ_EXTENSION_EXISTS }

/- ------------------------------------------------------------------------- -/
/- The Dugundji extension theorem, and Tietze variants as corollaries.       -/
/- (convex.ml 9652-9881)                                                     -/
/- ------------------------------------------------------------------------- -/

structure DUG where
  DUGUNDJI : thm
  TIETZE : thm
  TIETZE_CLOSED_INTERVAL : thm
  TIETZE_CLOSED_INTERVAL_1 : thm
  TIETZE_OPEN_INTERVAL : thm
  TIETZE_OPEN_INTERVAL_1 : thm
  TIETZE_UNBOUNDED : thm
  deriving Inhabited

@[nospecialize]
def setupDUG [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVS : CVS) (BCVB : CVB) (BLIN : LIN) :
    ExceptT String IO DUG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        NORM_ARITH, .. } := D
  let { EQ_IMP, ETA_AX, EXISTS_IN_GSPEC, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_INSERT_EMPTY, .. } := D.core3
  let { REAL_LT_IMP_LE, .. } := D.core4
  let { REAL_NOT_LT, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, .. } := D.core5
  let { SUBSET_UNIV, UNIONS_GSPEC, UNIV_NOT_EMPTY, .. } := D.core6
  let { DIST_SYM, .. } := D.vec1
  let { VECTOR_MUL_EQ_0, VSUM_SUPERSET, .. } := D.vec4
  let { OPEN_IN_DIFF, .. } := D.met
  let { CBALL_EQ_EMPTY, CENTRE_IN_BALL, .. } := D.top1
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
        CONTINUOUS_TRANSFORM_WITHIN_OPEN_IN, CONTINUOUS_VMUL, CONTINUOUS_VSUM,
        CONTINUOUS_WITHIN, CONTINUOUS_WITHIN_OPEN, EVENTUALLY_AT, .. } := D.top3
  let { INTERVAL_NE_EMPTY_1, IN_BALL, IN_CBALL_0, LIM_TRANSFORM_WITHIN_SET, OPEN_BALL,
        OPEN_CONTAINS_BALL, .. } := D.top4
  let { OPEN_IN_CONTAINS_BALL, OPEN_IN_INTER_OPEN, OPEN_IN_REFL, PARACOMPACT,
        REAL_SETDIST_LT_EXISTS, SETDIST_EQ_0_CLOSED_IN, SETDIST_LE_DIST, SETDIST_POS_LE,
        SETDIST_SING_TRIANGLE, SUBORDINATE_PARTITION_OF_UNITY, continuous_within, .. } :=
    D.top5
  let { CONVEX_UNIV, .. } := BCVX
  let { CONVEX_VSUM_STRONG, .. } := BCVS
  let { CONVEX_BALL, CONVEX_CBALL, .. } := BCVB
  let { CONVEX_INTERVAL, .. } := BLIN
  -- @@SCOPE END

  let DUGUNDJI ← prove
   r"!f:real^M->real^N c u s.
        convex c /\ ~(c = {}) /\
        closed_in (subtopology euclidean u) s /\
        f continuous_on s /\ IMAGE f s SUBSET c
        ==> ?g. g continuous_on u /\ IMAGE g u SUBSET c /\
                !x. x IN s ==> g x = f x"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"y:real^N")) THEN
      EXISTS_TAC (← q r"(\x. y):real^M->real^N") THEN
      REWRITE_TAC [CONTINUOUS_ON_CONST] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"u DIFF s:real^M->bool",
                      ← q r"{ ball(x:real^M,setdist({x},s) / &2) |x| x IN u DIFF s}"]
          PARACOMPACT) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC, OPEN_BALL] THEN ANTS_TAC THENL
     [REWRITE_TAC [SUBSET, IN_DIFF, IN_ELIM_THM, UNIONS_GSPEC] THEN
      X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN EXISTS_TAC (← q r"x:real^M") THEN
      ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ ~(x = &0) ==> &0 < x / &2")) THEN
      ASM_MESON_TAC [SETDIST_POS_LE, SETDIST_EQ_0_CLOSED_IN],
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:(real^M->bool)->bool") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN
     (← q r"!t. t IN c
          ==> ?v a:real^M. v IN u /\ ~(v IN s) /\ a IN s /\
                           t SUBSET ball(v,setdist({v},s) / &2) /\
                           dist(v,a) <= &2 * setdist({v},s)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"t:real^M->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^M->bool")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^M") THEN
      REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"{v:real^M}", ← q r"s:real^M->bool",
                        ← q r"&2 * setdist({v:real^M},s)"]
          REAL_SETDIST_LT_EXISTS) THEN
      ASM_SIMP_TAC [NOT_INSERT_EMPTY, SETDIST_POS_LE, ← REAL_ARITH
        (← q r"&0 <= x ==> (x < &2 * x <=> ~(x = &0))")] THEN
      ASM_MESON_TAC [REAL_LT_IMP_LE, IN_SING, SETDIST_EQ_0_CLOSED_IN],
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
       [← q r"vv:(real^M->bool)->real^M", ← q r"aa:(real^M->bool)->real^M"] THEN
      STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"!t v:real^M. t IN c /\ v IN t ==> setdist({vv t},s) <= &2 * setdist({v},s)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^M->bool")) THEN
      ASM_REWRITE_TAC [SUBSET] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC (← liftExcept (el 3 (CONJUNCTS th))))) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"v:real^M")) THEN ASM_REWRITE_TAC [IN_BALL] THEN
      MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"(vv:(real^M->bool)->real^M) t",
                        ← q r"v:real^M"] SETDIST_SING_TRIANGLE) THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!t v a:real^M. t IN c /\ v IN t /\ a IN s
                     ==> dist(a,aa t) <= &6 * dist(a,v)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"t:real^M->bool", ← q r"v:real^M"]) THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^M->bool")) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC (← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 th))))) THEN
      REWRITE_TAC [IMP_CONJ, SUBSET, IN_BALL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"v:real^M")) THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"{v:real^M}", ← q r"s:real^M->bool", ← q r"v:real^M",
                        ← q r"a:real^M"]
          SETDIST_LE_DIST) THEN
      ASM_REWRITE_TAC [IN_SING] THEN CONV_TAC (fun t => NORM_ARITH t),
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"c:(real^M->bool)->bool", ← q r"u DIFF s:real^M->bool"]
          SUBORDINATE_PARTITION_OF_UNITY) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:(real^M->bool)->real^M->real") THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"\x. if x IN s then (f:real^M->real^N) x
          else vsum c (\t:real^M->bool. h t x % f(aa t))") THEN
    SIMP_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      COND_CASES_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CONVEX_VSUM_STRONG THEN ASM SET_TAC []] THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    X_GEN_TAC (← q r"a:real^M") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(a:real^M) IN s") THENL
     [ALL_TAC,
      MATCH_MP_TAC CONTINUOUS_TRANSFORM_WITHIN_OPEN_IN THEN
      MAP_EVERY EXISTS_TAC
       [← q r"\x:real^M.
          vsum c (\t:real^M->bool. h t x % (f:real^M->real^N) (aa t))",
        ← q r"u DIFF s:real^M->bool"] THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL, IN_DIFF] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^M")) THEN
      ASM_REWRITE_TAC [IN_DIFF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:real^M->bool") STRIP_ASSUME_TAC) THEN
      MATCH_MP_TAC CONTINUOUS_TRANSFORM_WITHIN_OPEN_IN THEN MAP_EVERY EXISTS_TAC
       [← q r"\x. vsum {u | u IN c /\ ~(!x:real^M. x IN n ==> h u x = &0)}
                  (\t:real^M->bool. h t x % (f:real^M->real^N) (aa t))",
        ← q r"(u DIFF s) INTER n:real^M->bool"] THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL, OPEN_IN_INTER_OPEN,
                    IN_INTER, IN_DIFF] THEN
      CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC VSUM_SUPERSET THEN
        REWRITE_TAC [VECTOR_MUL_EQ_0] THEN ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_VSUM THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_VMUL THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^M->bool")) THEN
        ASM_REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a:real^M") o CONJUNCT1) THEN
        ASM_REWRITE_TAC [IN_DIFF, ETA_AX] THEN
        REWRITE_TAC [CONTINUOUS_WITHIN] THEN MATCH_MP_TAC EQ_IMP THEN
        MATCH_MP_TAC LIM_TRANSFORM_WITHIN_SET THEN
        SUBGOAL_THEN
          (← q r"open_in (subtopology euclidean u) (u DIFF s:real^M->bool)")
        MP_TAC THENL [ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL], ALL_TAC] THEN
        REWRITE_TAC [EVENTUALLY_AT, OPEN_IN_CONTAINS_BALL] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a:real^M") o CONJUNCT2) THEN
        ASM_REWRITE_TAC [IN_DIFF] THEN MATCH_MP_TAC MONO_EXISTS THEN
        REWRITE_TAC [SUBSET, IN_BALL, IN_INTER, IN_DIFF] THEN
        MESON_TAC [DIST_SYM]]] THEN
    ASM_REWRITE_TAC [CONTINUOUS_WITHIN_OPEN] THEN
    X_GEN_TAC (← q r"w:real^N->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^M->real^N) a")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
     [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^M")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [continuous_within] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"ball(a:real^M,d / &6)") THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL, OPEN_BALL] THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &6 <=> &0 < e")] THEN
    X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_BALL] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
    COND_CASES_TAC THENL
     [REWRITE_TAC [IN_BALL] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC CONVEX_VSUM_STRONG THEN
    ASM_SIMP_TAC [CONVEX_BALL, IN_DIFF] THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(x:real^M) IN t") THENL [DISJ2_TAC, ASM SET_TAC []] THEN
    REWRITE_TAC [IN_BALL] THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← NORM_ARITH
     (← q r"dist(a:real^M,v) < d / &6
      ==> dist(a,a') <= &6 * dist(a,v) ==> dist(a',a) < d"))) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let TIETZE ← prove
   r"!f:real^M->real^N u s B.
        &0 <= B /\
        closed_in (subtopology euclidean u) s /\
        f continuous_on s /\
        (!x. x IN s ==> norm(f x) <= B)
        ==> ?g. g continuous_on u /\
                (!x. x IN s ==> g x = f x) /\
                (!x. x IN u ==> norm(g x) <= B)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"cball(vec 0:real^N,B)",
                      ← q r"u:real^M->bool", ← q r"s:real^M->bool"] DUGUNDJI) THEN
    ASM_REWRITE_TAC [CONVEX_CBALL, CBALL_EQ_EMPTY, REAL_NOT_LT] THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_CBALL_0] THEN
    MESON_TAC [])

  let TIETZE_CLOSED_INTERVAL ← prove
   r"!f:real^M->real^N u s a b.
        ~(interval[a,b] = {}) /\
        closed_in (subtopology euclidean u) s /\
        f continuous_on s /\
        (!x. x IN s ==> f x IN interval[a,b])
        ==> ?g. g continuous_on u /\
                (!x. x IN s ==> g x = f x) /\
                (!x. x IN u ==> g(x) IN interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"interval[a:real^N,b]",
                      ← q r"u:real^M->bool", ← q r"s:real^M->bool"] DUGUNDJI) THEN
    ASM_REWRITE_TAC [CONVEX_INTERVAL, SUBSET, FORALL_IN_IMAGE] THEN
    MESON_TAC [])

  let TIETZE_CLOSED_INTERVAL_1 ← prove
   r"!f:real^N->real^1 u s a b.
        drop a <= drop b /\
        closed_in (subtopology euclidean u) s /\
        f continuous_on s /\
        (!x. x IN s ==> f x IN interval[a,b])
        ==> ?g. g continuous_on u /\
                (!x. x IN s ==> g x = f x) /\
                (!x. x IN u ==> g(x) IN interval[a,b])"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC TIETZE_CLOSED_INTERVAL THEN
    ASM_REWRITE_TAC [INTERVAL_NE_EMPTY_1])

  let TIETZE_OPEN_INTERVAL ← prove
   r"!f:real^M->real^N u s a b.
        ~(interval(a,b) = {}) /\
        closed_in (subtopology euclidean u) s /\
        f continuous_on s /\
        (!x. x IN s ==> f x IN interval(a,b))
        ==> ?g. g continuous_on u /\
                (!x. x IN s ==> g x = f x) /\
                (!x. x IN u ==> g(x) IN interval(a,b))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"interval(a:real^N,b)",
                      ← q r"u:real^M->bool", ← q r"s:real^M->bool"] DUGUNDJI) THEN
    ASM_REWRITE_TAC [CONVEX_INTERVAL, SUBSET, FORALL_IN_IMAGE] THEN
    MESON_TAC [])

  let TIETZE_OPEN_INTERVAL_1 ← prove
   r"!f:real^N->real^1 u s a b.
        drop a < drop b /\
        closed_in (subtopology euclidean u) s /\
        f continuous_on s /\
        (!x. x IN s ==> f x IN interval(a,b))
        ==> ?g. g continuous_on u /\
                (!x. x IN s ==> g x = f x) /\
                (!x. x IN u ==> g(x) IN interval(a,b))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC TIETZE_OPEN_INTERVAL THEN
    ASM_REWRITE_TAC [INTERVAL_NE_EMPTY_1])

  let TIETZE_UNBOUNDED ← prove
   r"!f:real^M->real^N u s.
        closed_in (subtopology euclidean u) s /\ f continuous_on s
        ==> ?g. g continuous_on u /\
                (!x. x IN s ==> g x = f x)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(:real^N)", ← q r"u:real^M->bool",
                      ← q r"s:real^M->bool"] DUGUNDJI) THEN
    ASM_REWRITE_TAC [CONVEX_UNIV, UNIV_NOT_EMPTY, SUBSET_UNIV])

  return { DUGUNDJI, TIETZE, TIETZE_CLOSED_INTERVAL, TIETZE_CLOSED_INTERVAL_1,
           TIETZE_OPEN_INTERVAL, TIETZE_OPEN_INTERVAL_1, TIETZE_UNBOUNDED }

/- ------------------------------------------------------------------------- -/
/- Convex cones and corresponding hulls.  (convex.ml 9887-10145)             -/
/- ------------------------------------------------------------------------- -/

structure CCN where
  convex_cone : thm
  CONVEX_CONE : thm
  CONVEX_CONE_ADD : thm
  CONVEX_CONE_MUL : thm
  CONVEX_CONE_NONEMPTY : thm
  CONVEX_CONE_LINEAR_IMAGE : thm
  CONVEX_CONE_LINEAR_IMAGE_EQ : thm
  CONVEX_CONE_HALFSPACE_GE : thm
  CONVEX_CONE_HALFSPACE_LE : thm
  CONVEX_CONE_CONTAINS_0 : thm
  CONVEX_CONE_INTERS : thm
  CONVEX_CONE_CONVEX_CONE_HULL : thm
  CONVEX_CONVEX_CONE_HULL : thm
  CONIC_CONVEX_CONE_HULL : thm
  CONVEX_CONE_HULL_NONEMPTY : thm
  CONVEX_CONE_HULL_CONTAINS_0 : thm
  CONVEX_CONE_HULL_ADD : thm
  CONVEX_CONE_HULL_MUL : thm
  CONVEX_CONE_SUMS : thm
  CONVEX_CONE_PCROSS : thm
  CONVEX_CONE_PCROSS_EQ : thm
  CONVEX_CONE_HULL_UNION : thm
  CONVEX_CONE_SING : thm
  CONVEX_HULL_SUBSET_CONVEX_CONE_HULL : thm
  CONIC_HULL_SUBSET_CONVEX_CONE_HULL : thm
  CONVEX_CONE_HULL_SEPARATE_NONEMPTY : thm
  CONVEX_CONE_HULL_EMPTY : thm
  CONVEX_CONE_HULL_SEPARATE : thm
  CONVEX_CONE_HULL_CONVEX_HULL_NONEMPTY : thm
  CONVEX_CONE_HULL_CONVEX_HULL : thm
  CONVEX_CONE_HULL_LINEAR_IMAGE : thm
  SUBSPACE_IMP_CONVEX_CONE : thm
  CONVEX_CONE_SPAN : thm
  CONVEX_CONE_NEGATIONS : thm
  SUBSPACE_CONVEX_CONE_SYMMETRIC : thm
  SPAN_CONVEX_CONE_ALLSIGNS : thm
  deriving Inhabited

@[nospecialize]
def setupCCN [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVS : CVS) (BCON : CON) (BCVA : CVA)
    (BCVH : CVH) (BCLH : CLH) (BLIN : LIN) : ExceptT String IO CCN := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, add_linear_invariants, .. } := D
  let { EMPTY_SUBSET, EQ_IMP, EXISTS_PASTECART, EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IN, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTERS, IN_SING, IN_UNION, MEMBER_NOT_EMPTY,
        PASTECART_IN_PCROSS, PCROSS_EMPTY, PCROSS_EQ_EMPTY, .. } := D.core3
  let { REAL_LE_ADD, REAL_LE_MUL, REAL_LE_NEGTOTAL, REAL_LE_REFL, .. } := D.core4
  let { REAL_POS, REAL_SUB_LE, SNDCART_PASTECART, SUBSET, SUBSET_ANTISYM, SUBSET_REFL,
        SUBSET_TRANS, SUBSET_UNION, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, UNION_SUBSET, real_ge, .. } := D.core6
  let { HULL_ANTIMONO, HULL_INC, HULL_INDUCT, HULL_MINIMAL, HULL_MONO, HULL_SUBSET,
        HULL_UNIQUE, P_HULL, .. } := D.misc
  let { DOT_LNEG, DOT_RADD, DOT_RMUL, DOT_RZERO, .. } := D.vec1
  let { LINEAR_0, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { SPAN_0, SPAN_INC, SPAN_NEG, SPAN_SUBSET_SUBSPACE, SPAN_SUPERSET, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_RZERO,
        VECTOR_NEG_NEG, subspace, .. } := D.vec4
  let { convex, CONVEX_INTERS, CONVEX_LINEAR_IMAGE, CONVEX_LINEAR_IMAGE_EQ, .. } := BCVX
  let { CONVEX_PCROSS, .. } := BCVS
  let { conic, CONIC_INTERS, CONIC_LINEAR_IMAGE, CONIC_LINEAR_IMAGE_EQ, CONIC_CONIC_HULL,
        CONIC_NEGATIONS, CONIC_SPAN, CONIC_HULL_EXPLICIT, CONIC_HULL_LINEAR_IMAGE,
        CONVEX_CONIC_HULL, CONIC_HULL_EMPTY, CONIC_CONTAINS_0, CONIC_HULL_EQ_EMPTY,
        CONIC_SUMS, CONIC_PCROSS, .. } := BCON
  let { CONVEX_NEGATIONS, CONVEX_SUMS, .. } := BCVA
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EMPTY, CONVEX_HULL_EQ_EMPTY, .. } := BCVH
  let { CONVEX_SPAN, .. } := BCLH
  let { CONVEX_HULL_LINEAR_IMAGE, .. } := BLIN
  -- @@SCOPE END

  let convex_cone ← new_definition
   r"convex_cone s <=> ~(s = {}) /\ convex s /\ conic s"

  let CONVEX_CONE ← prove
   r"!s:real^N->bool.
     convex_cone s <=>
        vec 0 IN s /\
        (!x y. x IN s /\ y IN s ==> (x + y) IN s) /\
        (!x c. x IN s /\ &0 <= c ==> (c % x) IN s)"
   (GEN_TAC THEN REWRITE_TAC [convex_cone, ← GSYM conic] THEN
    ASM_CASES_TAC (← q r"conic(s:real^N->bool)") THEN
    ASM_SIMP_TAC [CONIC_CONTAINS_0] THEN AP_TERM_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [conic]) THEN
    REWRITE_TAC [convex] THEN EQ_TAC THEN
    ASM_SIMP_TAC [REAL_SUB_LE] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"&2 % (x:real^N)", ← q r"&2 % (y:real^N)", ← q r"&1 / &2", ← q r"&1 / &2"]) THEN
    REWRITE_TAC [VECTOR_MUL_ASSOC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_SIMP_TAC [VECTOR_MUL_LID, REAL_POS])

  let CONVEX_CONE_ADD ← prove
   r"!s x y. convex_cone s /\ x IN s /\ y IN s ==> (x + y) IN s"
   (MESON_TAC [CONVEX_CONE])

  let CONVEX_CONE_MUL ← prove
   r"!s c x. convex_cone s /\ &0 <= c /\ x IN s ==> (c % x) IN s"
   (MESON_TAC [CONVEX_CONE])

  let CONVEX_CONE_NONEMPTY ← prove
   r"!s. convex_cone s ==> ~(s = {})"
   (MESON_TAC [CONVEX_CONE, MEMBER_NOT_EMPTY])

  let CONVEX_CONE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        convex_cone s /\ linear f ==> convex_cone(IMAGE f s)"
   (SIMP_TAC [convex_cone, CONVEX_LINEAR_IMAGE, IMAGE_EQ_EMPTY,
              CONIC_LINEAR_IMAGE])

  let CONVEX_CONE_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (convex_cone(IMAGE f s) <=> convex_cone s)"
   (REWRITE_TAC [convex_cone] THEN
    MESON_TAC [IMAGE_EQ_EMPTY, CONVEX_LINEAR_IMAGE_EQ, CONIC_LINEAR_IMAGE_EQ])

  add_linear_invariants [CONVEX_CONE_LINEAR_IMAGE_EQ]

  let CONVEX_CONE_HALFSPACE_GE ← prove
   r"!a. convex_cone {x | a dot x >= &0}"
   (SIMP_TAC [CONVEX_CONE, real_ge, IN_ELIM_THM, DOT_RZERO, DOT_RADD, DOT_RMUL,
              REAL_LE_ADD, REAL_LE_MUL, REAL_LE_REFL])

  let CONVEX_CONE_HALFSPACE_LE ← prove
   r"!a. convex_cone {x | a dot x <= &0}"
   (REWRITE_TAC [← REAL_ARITH (← q r"x <= &0 <=> &0 <= --x"), ← GSYM DOT_LNEG] THEN
    REWRITE_TAC [← GSYM real_ge, CONVEX_CONE_HALFSPACE_GE])

  let CONVEX_CONE_CONTAINS_0 ← prove
   r"!s:real^N->bool. convex_cone s ==> vec 0 IN s"
   (SIMP_TAC [CONVEX_CONE])

  let CONVEX_CONE_INTERS ← prove
   r"!f. (!s:real^N->bool. s IN f ==> convex_cone s) ==> convex_cone(INTERS f)"
   (SIMP_TAC [convex_cone, CONIC_INTERS, CONVEX_INTERS] THEN
    REWRITE_TAC [← GSYM convex_cone] THEN GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"vec 0:real^N") THEN
    ASM_SIMP_TAC [IN_INTERS, CONVEX_CONE_CONTAINS_0])

  let CONVEX_CONE_CONVEX_CONE_HULL ← prove
   r"!s. convex_cone(convex_cone hull s)"
   (SIMP_TAC [P_HULL, CONVEX_CONE_INTERS])

  let CONVEX_CONVEX_CONE_HULL ← prove
   r"!s. convex(convex_cone hull s)"
   (MESON_TAC [CONVEX_CONE_CONVEX_CONE_HULL, convex_cone])

  let CONIC_CONVEX_CONE_HULL ← prove
   r"!s. conic(convex_cone hull s)"
   (MESON_TAC [CONVEX_CONE_CONVEX_CONE_HULL, convex_cone])

  let CONVEX_CONE_HULL_NONEMPTY ← prove
   r"!s. ~(convex_cone hull s = {})"
   (MESON_TAC [CONVEX_CONE_CONVEX_CONE_HULL, convex_cone])

  let CONVEX_CONE_HULL_CONTAINS_0 ← prove
   r"!s. vec 0 IN convex_cone hull s"
   (MESON_TAC [CONVEX_CONE_CONVEX_CONE_HULL, CONVEX_CONE])

  let CONVEX_CONE_HULL_ADD ← prove
   r"!s x y:real^N.
        x IN convex_cone hull s /\ y IN convex_cone hull s
        ==> x + y IN convex_cone hull s"
   (MESON_TAC [CONVEX_CONE, CONVEX_CONE_CONVEX_CONE_HULL])

  let CONVEX_CONE_HULL_MUL ← prove
   r"!s c x:real^N.
        &0 <= c /\ x IN convex_cone hull s
        ==> (c % x) IN convex_cone hull s"
   (MESON_TAC [CONVEX_CONE, CONVEX_CONE_CONVEX_CONE_HULL])

  let CONVEX_CONE_SUMS ← prove
   r"!s t. convex_cone s /\ convex_cone t
         ==> convex_cone {x + y:real^N | x IN s /\ y IN t}"
   (SIMP_TAC [convex_cone, CONIC_SUMS, CONVEX_SUMS] THEN SET_TAC [])

  let CONVEX_CONE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        convex_cone s /\ convex_cone t ==> convex_cone(s PCROSS t)"
   (SIMP_TAC [convex_cone, CONVEX_PCROSS, CONIC_PCROSS, PCROSS_EQ_EMPTY])

  let CONVEX_CONE_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        convex_cone(s PCROSS t) <=> convex_cone s /\ convex_cone t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THENL
     [ASM_REWRITE_TAC [PCROSS_EMPTY, convex_cone], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [PCROSS_EMPTY, convex_cone], ALL_TAC] THEN
    EQ_TAC THEN REWRITE_TAC [CONVEX_CONE_PCROSS] THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"fstcart:real^(M,N)finite_sum->real^M",
       ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] CONVEX_CONE_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_FSTCART],
      MP_TAC (← ISPECL [← q r"sndcart:real^(M,N)finite_sum->real^N",
       ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] CONVEX_CONE_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_SNDCART]] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART, PASTECART_IN_PCROSS,
                 FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ASM SET_TAC [])

  let CONVEX_CONE_HULL_UNION ← prove
   r"!s t. convex_cone hull(s UNION t) =
         {x + y:real^N | x IN convex_cone hull s /\ y IN convex_cone hull t}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC HULL_MINIMAL THEN
      SIMP_TAC [CONVEX_CONE_SUMS, CONVEX_CONE_CONVEX_CONE_HULL] THEN
      REWRITE_TAC [SUBSET, IN_UNION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THENL
       [MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"vec 0:real^N"] THEN
        ASM_SIMP_TAC [HULL_INC, CONVEX_CONE_HULL_CONTAINS_0, VECTOR_ADD_RID],
        MAP_EVERY EXISTS_TAC [← q r"vec 0:real^N", ← q r"x:real^N"] THEN
        ASM_SIMP_TAC [HULL_INC, CONVEX_CONE_HULL_CONTAINS_0, VECTOR_ADD_LID]],
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC CONVEX_CONE_HULL_ADD THEN
      ASM_MESON_TAC [HULL_MONO, SUBSET_UNION, SUBSET]])

  let CONVEX_CONE_SING ← prove
   r"convex_cone {vec 0}"
   (SIMP_TAC [CONVEX_CONE, IN_SING, VECTOR_ADD_LID, VECTOR_MUL_RZERO])

  let CONVEX_HULL_SUBSET_CONVEX_CONE_HULL ← prove
   r"!s. convex hull s SUBSET convex_cone hull s"
   (GEN_TAC THEN MATCH_MP_TAC HULL_ANTIMONO THEN
    SIMP_TAC [convex_cone, SUBSET, IN])

  let CONIC_HULL_SUBSET_CONVEX_CONE_HULL ← prove
   r"!s. conic hull s SUBSET convex_cone hull s"
   (GEN_TAC THEN MATCH_MP_TAC HULL_ANTIMONO THEN
    SIMP_TAC [convex_cone, SUBSET, IN])

  let CONVEX_CONE_HULL_SEPARATE_NONEMPTY ← prove
   r"!s:real^N->bool.
    ~(s = {})
    ==> convex_cone hull s = conic hull (convex hull s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THEN
    MATCH_MP_TAC HULL_MINIMAL THEN
    REWRITE_TAC [CONIC_CONVEX_CONE_HULL, CONVEX_HULL_SUBSET_CONVEX_CONE_HULL] THEN
    ASM_SIMP_TAC [CONVEX_CONIC_HULL, CONVEX_CONVEX_HULL, CONIC_CONIC_HULL,
                  convex_cone, CONIC_HULL_EQ_EMPTY, CONVEX_HULL_EQ_EMPTY] THEN
    ASM_MESON_TAC [HULL_SUBSET, SUBSET_REFL, SUBSET_TRANS])

  let CONVEX_CONE_HULL_EMPTY ← prove
   r"convex_cone hull {} = {vec 0}"
   (MATCH_MP_TAC HULL_UNIQUE THEN
    REWRITE_TAC [CONVEX_CONE_CONTAINS_0, EMPTY_SUBSET, CONVEX_CONE_SING,
                 ← SET_RULE (← q r"{a} SUBSET s <=> a IN s"), CONVEX_CONE_CONTAINS_0])

  let CONVEX_CONE_HULL_SEPARATE ← prove
   r"!s:real^N->bool.
    convex_cone hull s = vec 0 INSERT conic hull (convex hull s)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_SIMP_TAC [CONVEX_CONE_HULL_EMPTY, CONVEX_HULL_EMPTY, CONIC_HULL_EMPTY] THEN
    ASM_SIMP_TAC [CONVEX_CONE_HULL_SEPARATE_NONEMPTY] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"a IN s ==> s = a INSERT s")) THEN
    ASM_SIMP_TAC [CONIC_CONTAINS_0, CONIC_CONIC_HULL] THEN
    ASM_REWRITE_TAC [CONIC_HULL_EQ_EMPTY, CONVEX_HULL_EQ_EMPTY])

  let CONVEX_CONE_HULL_CONVEX_HULL_NONEMPTY ← prove
   r"!s:real^N->bool.
        ~(s = {})
        ==> convex_cone hull s = {c % x | &0 <= c /\ x IN convex hull s}"
   (SIMP_TAC [CONVEX_CONE_HULL_SEPARATE_NONEMPTY, CONIC_HULL_EXPLICIT])

  let CONVEX_CONE_HULL_CONVEX_HULL ← prove
   r"!s:real^N->bool.
        convex_cone hull s =
        vec 0 INSERT {c % x | &0 <= c /\ x IN convex hull s}"
   (REWRITE_TAC [CONVEX_CONE_HULL_SEPARATE, CONIC_HULL_EXPLICIT])

  let CONVEX_CONE_HULL_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f
        ==> convex_cone hull (IMAGE f s) = IMAGE f (convex_cone hull s)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M-> bool = {}") THEN
    ASM_SIMP_TAC [CONVEX_CONE_HULL_SEPARATE_NONEMPTY, IMAGE_EQ_EMPTY,
                  CONVEX_HULL_LINEAR_IMAGE, CONIC_HULL_LINEAR_IMAGE] THEN
    REWRITE_TAC [IMAGE_CLAUSES, CONVEX_CONE_HULL_EMPTY] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"f x = y ==> {y} = {f x}")) THEN
    ASM_MESON_TAC [LINEAR_0])

  add_linear_invariants [CONVEX_CONE_HULL_LINEAR_IMAGE]

  let SUBSPACE_IMP_CONVEX_CONE ← prove
   r"!s. subspace s ==> convex_cone s"
   (SIMP_TAC [subspace, CONVEX_CONE])

  let CONVEX_CONE_SPAN ← prove
   r"!s. convex_cone(span s)"
   (SIMP_TAC [convex_cone, CONVEX_SPAN, CONIC_SPAN, ← GSYM MEMBER_NOT_EMPTY] THEN
    MESON_TAC [SPAN_0])

  let CONVEX_CONE_NEGATIONS ← prove
   r"!s. convex_cone s ==> convex_cone (IMAGE (--) s)"
   (SIMP_TAC [convex_cone, IMAGE_EQ_EMPTY, CONIC_NEGATIONS, CONVEX_NEGATIONS])

  let SUBSPACE_CONVEX_CONE_SYMMETRIC ← prove
   r"!s:real^N->bool.
        subspace s <=> convex_cone s /\ (!x. x IN s ==> --x IN s)"
   (GEN_TAC THEN REWRITE_TAC [subspace, CONVEX_CONE] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [] THENL
     [ASM_MESON_TAC [← VECTOR_ARITH (← q r"--x:real^N = -- &1 % x")],
      MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^N"] THEN DISCH_TAC THEN
      DISJ_CASES_TAC (← SPEC (← q r"c:real") REAL_LE_NEGTOTAL) THEN ASM_SIMP_TAC [] THEN
      ASM_MESON_TAC [← VECTOR_ARITH (← q r"c % x:real^N = --(--c % x)")]])

  let SPAN_CONVEX_CONE_ALLSIGNS ← prove
   r"!s:real^N->bool. span s = convex_cone hull (s UNION IMAGE (--) s)"
   (GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC SPAN_SUBSET_SUBSPACE THEN CONJ_TAC THENL
       [MESON_TAC [HULL_SUBSET, SUBSET_UNION, SUBSET_TRANS], ALL_TAC] THEN
      REWRITE_TAC [SUBSPACE_CONVEX_CONE_SYMMETRIC,
                   CONVEX_CONE_CONVEX_CONE_HULL] THEN
      MATCH_MP_TAC HULL_INDUCT THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_UNION, IN_IMAGE] THEN
        DISCH_TAC THEN MATCH_MP_TAC HULL_INC THEN
        REWRITE_TAC [IN_UNION, IN_IMAGE] THEN ASM_MESON_TAC [VECTOR_NEG_NEG],
        SUBGOAL_THEN (← q r"!s. {x:real^N | (--x) IN s} = IMAGE (--) s")
         (fun th => SIMP_TAC [th, CONVEX_CONE_NEGATIONS,
                              CONVEX_CONE_CONVEX_CONE_HULL]) THEN
        GEN_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
        REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [VECTOR_NEG_NEG]],
      MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_CONE_SPAN] THEN
      REWRITE_TAC [UNION_SUBSET, SPAN_INC] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      MESON_TAC [SPAN_SUPERSET, SPAN_NEG]])

  return { convex_cone, CONVEX_CONE, CONVEX_CONE_ADD, CONVEX_CONE_MUL, CONVEX_CONE_NONEMPTY,
           CONVEX_CONE_LINEAR_IMAGE, CONVEX_CONE_LINEAR_IMAGE_EQ, CONVEX_CONE_HALFSPACE_GE,
           CONVEX_CONE_HALFSPACE_LE, CONVEX_CONE_CONTAINS_0, CONVEX_CONE_INTERS,
           CONVEX_CONE_CONVEX_CONE_HULL, CONVEX_CONVEX_CONE_HULL, CONIC_CONVEX_CONE_HULL,
           CONVEX_CONE_HULL_NONEMPTY, CONVEX_CONE_HULL_CONTAINS_0, CONVEX_CONE_HULL_ADD,
           CONVEX_CONE_HULL_MUL, CONVEX_CONE_SUMS, CONVEX_CONE_PCROSS, CONVEX_CONE_PCROSS_EQ,
           CONVEX_CONE_HULL_UNION, CONVEX_CONE_SING, CONVEX_HULL_SUBSET_CONVEX_CONE_HULL,
           CONIC_HULL_SUBSET_CONVEX_CONE_HULL, CONVEX_CONE_HULL_SEPARATE_NONEMPTY,
           CONVEX_CONE_HULL_EMPTY, CONVEX_CONE_HULL_SEPARATE,
           CONVEX_CONE_HULL_CONVEX_HULL_NONEMPTY, CONVEX_CONE_HULL_CONVEX_HULL,
           CONVEX_CONE_HULL_LINEAR_IMAGE, SUBSPACE_IMP_CONVEX_CONE, CONVEX_CONE_SPAN,
           CONVEX_CONE_NEGATIONS, SUBSPACE_CONVEX_CONE_SYMMETRIC, SPAN_CONVEX_CONE_ALLSIGNS }

/- ------------------------------------------------------------------------- -/
/- Epigraphs of convex functions; general bound property of convex           -/
/- functions; another intermediate value theorem formulation.                -/
/- (convex.ml 10149-10332)                                                   -/
/- ------------------------------------------------------------------------- -/

structure EPI where
  epigraph : thm
  IN_EPIGRAPH : thm
  CONVEX_EPIGRAPH : thm
  CONVEX_EPIGRAPH_CONVEX : thm
  CONVEX_ON_EPIGRAPH_SLICE_LE : thm
  CONVEX_ON_EPIGRAPH_SLICE_LT : thm
  CONVEX_ON_SUP : thm
  FORALL_OF_PASTECART : thm
  FORALL_OF_DROP : thm
  CONVEX_ON_JENSEN : thm
  CONVEX_ON_IMP_JENSEN : thm
  IVT_INCREASING_COMPONENT_ON_1 : thm
  IVT_INCREASING_COMPONENT_1 : thm
  IVT_DECREASING_COMPONENT_ON_1 : thm
  IVT_DECREASING_COMPONENT_1 : thm
  deriving Inhabited

@[nospecialize]
def setupEPI [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVS : CVS) (BCOP : COP) (BCVF : CVF)
    (BLIN : LIN) : ExceptT String IO EPI := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { EQ_IMP, ETA_AX, EXISTS_IN_IMAGE, EXTENSION, FINITE_INDEX_NUMSEG, FINITE_NUMSEG,
        FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ, IMP_CONJ_ALT, INJECTIVE_ON_ALT,
        INTERS_GSPEC, .. } := D.core2
  let { IN_ELIM_THM, IN_NUMSEG, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, REAL_CONVEX_BOUND_LE,
        REAL_CONVEX_BOUND_LT, .. } := D.core3
  let { REAL_EQ_NEG2, REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_LMUL, REAL_LE_NEG2, REAL_LE_REFL,
        REAL_LE_TRANS, .. } := D.core4
  let { REAL_SUP_LE_EQ, RIGHT_EXISTS_AND_THM, SNDCART_PASTECART, .. } := D.core5
  let { SUM_IMAGE, SUM_LE_NUMSEG, o_DEF, o_THM, .. } := D.core6
  let { DROP_ADD, DROP_CMUL, DROP_VSUM, FORALL_DROP, FSTCART_ADD, FSTCART_CMUL, FSTCART_VSUM,
        LIFT_DROP, .. } := D.vec2
  let { SNDCART_ADD, SNDCART_CMUL, SNDCART_VSUM, .. } := D.vec3
  let { VECTOR_NEG_COMPONENT, VSUM_IMAGE, .. } := D.vec4
  let { CONNECTED_CONTINUOUS_IMAGE, CONNECTED_IVT_COMPONENT,
        CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.top2
  let { CONTINUOUS_ON_NEG, .. } := D.top3
  let { IN_INTERVAL_1, .. } := D.top4
  let { convex, CONVEX_INTERS, .. } := BCVX
  let { CONVEX_INDEXED, .. } := BCVS
  let { CONVEX_CONNECTED, .. } := BCOP
  let { convex_on, CONVEX_ON_CONST, .. } := BCVF
  let { CONVEX_INTERVAL, .. } := BLIN
  -- @@SCOPE END

  let epigraph ← new_definition
   r"epigraph s (f:real^N->real) =
       {xy:real^((N,1)finite_sum) |
             fstcart xy IN s /\ f(fstcart xy) <= drop(sndcart xy)}"

  let IN_EPIGRAPH ← prove
   r"!x y. (pastecart x (lift y)) IN epigraph s f <=> x IN s /\ f(x) <= y"
   (REWRITE_TAC [epigraph, IN_ELIM_THM, FSTCART_PASTECART, SNDCART_PASTECART,
                 LIFT_DROP])

  let CONVEX_EPIGRAPH ← prove
   r"!f s. f convex_on s /\ convex s <=> convex(epigraph s f)"
   (REWRITE_TAC [convex, convex_on, IN_ELIM_THM, SNDCART_ADD, SNDCART_CMUL,
     epigraph, FSTCART_ADD, FSTCART_CMUL, FORALL_PASTECART, FSTCART_PASTECART,
     SNDCART_PASTECART] THEN
    REWRITE_TAC [← GSYM FORALL_DROP, DROP_ADD, DROP_CMUL] THEN
    MESON_TAC [REAL_LE_REFL, REAL_LE_ADD2, REAL_LE_LMUL, REAL_LE_TRANS])

  let CONVEX_EPIGRAPH_CONVEX ← prove
   r"!f s. convex s ==> (f convex_on s <=> convex(epigraph s f))"
   (REWRITE_TAC [← GSYM CONVEX_EPIGRAPH] THEN CONV_TAC (fun t => TAUT t))

  let CONVEX_ON_EPIGRAPH_SLICE_LE ← prove
   r"!f:real^N->real s a.
        f convex_on s /\ convex s ==> convex {x | x IN s /\ f(x) <= a}"
   (SIMP_TAC [convex_on, convex, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (fun th =>
      W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o snd)) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_CONVEX_BOUND_LE THEN ASM_REWRITE_TAC [])

  let CONVEX_ON_EPIGRAPH_SLICE_LT ← prove
   r"!f:real^N->real s a.
        f convex_on s /\ convex s ==> convex {x | x IN s /\ f(x) < a}"
   (SIMP_TAC [convex_on, convex, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (fun th =>
      W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o snd)) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
    MATCH_MP_TAC REAL_CONVEX_BOUND_LT THEN ASM_REWRITE_TAC [])

  let CONVEX_ON_SUP ← prove
   r"!t:A->bool s:real^N->bool.
        convex s /\
        (!i. i IN t ==> f i convex_on s) /\
        (!x. x IN s ==> ?B. !i. i IN t ==> f i x <= B)
        ==> (\x. sup {f i x | i IN t}) convex_on s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"t:A->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, CONVEX_ON_CONST, ← SET_RULE
     (← q r"{f i x | i | F} = {}")] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    ASM_SIMP_TAC [CONVEX_EPIGRAPH_CONVEX] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"convex(INTERS {epigraph (s:real^N->bool) (f i) | (i:A) IN t})")
    MP_TAC THENL [ASM_SIMP_TAC [CONVEX_INTERS, FORALL_IN_GSPEC], ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, FORALL_PASTECART, INTERS_GSPEC, IN_ELIM_THM] THEN
    REWRITE_TAC [epigraph, IN_ELIM_THM, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    REWRITE_TAC [← GSYM FORALL_DROP] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real"] THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THENL
     [CONV_TAC SYM_CONV, ASM_MESON_TAC [MEMBER_NOT_EMPTY]] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) REAL_SUP_LE_EQ o lhand o snd) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM SET_TAC [])

  let FORALL_OF_PASTECART ← prove
   r"(!p. P (fstcart o p) (sndcart o p)) <=> (!x:A->B^M y:A->B^N. P x y)"
   (EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"\a:A. pastecart (x a :B^M) (y a :B^N)")) THEN
    REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART, ETA_AX])

  let FORALL_OF_DROP ← prove
   r"(!v. P (drop o v)) <=> (!x:A->real. P x)"
   (EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"\a:A. lift(x a)")) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX])

  let CONVEX_ON_JENSEN ← do
    let lemma ← prove
     r"(!x. P x ==> (Q x = R x)) ==> (!x. P x) ==> ((!x. Q x) <=> (!x. R x))"
     (MESON_TAC [])
    prove
     r"!f:real^N->real s.
          convex s
          ==> (f convex_on s <=>
                  !k u x.
                     (!i:num. 1 <= i /\ i <= k ==> &0 <= u(i) /\ x(i) IN s) /\
                     (sum (1..k) u = &1)
                     ==> f(vsum (1..k) (\i. u(i) % x(i)))
                             <= sum (1..k) (\i. u(i) * f(x(i))))"
     (REPEAT STRIP_TAC THEN FIRST_ASSUM
       (fun th => tactic_of do
         pure (REWRITE_TAC [← MATCH_MP CONVEX_EPIGRAPH_CONVEX th])) THEN
      REWRITE_TAC [CONVEX_INDEXED, epigraph] THEN
      SIMP_TAC [IN_ELIM_THM, SNDCART_ADD, SNDCART_CMUL, FINITE_NUMSEG,
                FSTCART_ADD, FSTCART_CMUL, FORALL_PASTECART, DROP_CMUL,
                FSTCART_PASTECART, SNDCART_PASTECART,
                FSTCART_VSUM, SNDCART_VSUM, DROP_VSUM, o_DEF] THEN
      REWRITE_TAC [← GSYM (← ISPEC (← q r"fstcart") o_THM),
                   ← GSYM (← ISPEC (← q r"sndcart") o_THM)] THEN
      REWRITE_TAC [← GSYM (← ISPEC (← q r"drop") o_THM)] THEN
      REWRITE_TAC [FORALL_OF_PASTECART, FORALL_OF_DROP] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONVEX_INDEXED]) THEN
      REPEAT (MATCH_MP_TAC lemma THEN GEN_TAC) THEN SIMP_TAC [] THEN
      REWRITE_TAC [← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN DISCH_THEN (K ALL_TAC) THEN
      EQ_TAC THEN SIMP_TAC [REAL_LE_REFL] THEN
      DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> x <= a ==> x <= b")) THEN
      ASM_SIMP_TAC [SUM_LE_NUMSEG, REAL_LE_LMUL])

  let CONVEX_ON_IMP_JENSEN ← prove
   r"!f:real^N->real s k:A->bool u x.
        f convex_on s /\ convex s /\ FINITE k /\
        (!i. i IN k ==> &0 <= u i /\ x i IN s) /\ sum k u = &1
        ==> f(vsum k (\i. u i % x i)) <= sum k (\i. u i * f(x i))"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FINITE_INDEX_NUMSEG]) THEN
    ABBREV_TAC (← q r"n = CARD(k:A->bool)") THEN
    REWRITE_TAC [INJECTIVE_ON_ALT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->A")
     (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC)) THEN
    ASM_SIMP_TAC [VSUM_IMAGE, SUM_IMAGE, FINITE_NUMSEG, IMP_CONJ, o_DEF] THEN
    DISCH_TAC THEN MP_TAC (← ISPECL [← q r"f:real^N->real", ← q r"s:real^N->bool"]
          CONVEX_ON_JENSEN) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [← GSYM IN_NUMSEG] THEN ASM SET_TAC [])

  let IVT_INCREASING_COMPONENT_ON_1 ← prove
   r"!f:real^1->real^N a b y k.
        drop a <= drop b /\ 1 <= k /\ k <= dimindex(:N) /\
        f continuous_on interval[a,b] /\
        f(a)$k <= y /\ y <= f(b)$k
        ==> ?x. x IN interval[a,b] /\ f(x)$k = y"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"IMAGE (f:real^1->real^N) (interval[a,b])"]
          CONNECTED_IVT_COMPONENT) THEN
    REWRITE_TAC [EXISTS_IN_IMAGE] THEN DISCH_THEN MATCH_MP_TAC THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, EXISTS_IN_IMAGE] THEN
    ASM_SIMP_TAC [CONNECTED_CONTINUOUS_IMAGE, CONVEX_CONNECTED,
                  CONVEX_INTERVAL] THEN
    EXISTS_TAC (← q r"a:real^1") THEN ASM_REWRITE_TAC [IN_INTERVAL_1, REAL_LE_REFL] THEN
    EXISTS_TAC (← q r"b:real^1") THEN ASM_REWRITE_TAC [IN_INTERVAL_1, REAL_LE_REFL])

  let IVT_INCREASING_COMPONENT_1 ← prove
   r"!f:real^1->real^N a b y k.
        drop a <= drop b /\ 1 <= k /\ k <= dimindex(:N) /\
        (!x. x IN interval[a,b] ==> f continuous at x) /\
        f(a)$k <= y /\ y <= f(b)$k
        ==> ?x. x IN interval[a,b] /\ f(x)$k = y"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC IVT_INCREASING_COMPONENT_ON_1 THEN
    ASM_SIMP_TAC [CONTINUOUS_AT_IMP_CONTINUOUS_ON])

  let IVT_DECREASING_COMPONENT_ON_1 ← prove
   r"!f:real^1->real^N a b y k.
        drop a <= drop b /\ 1 <= k /\ k <= dimindex(:N) /\
        f continuous_on interval[a,b] /\
        f(b)$k <= y /\ y <= f(a)$k
        ==> ?x. x IN interval[a,b] /\ f(x)$k = y"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM REAL_EQ_NEG2] THEN
    ASM_SIMP_TAC [← GSYM VECTOR_NEG_COMPONENT] THEN
    MATCH_MP_TAC IVT_INCREASING_COMPONENT_ON_1 THEN
    ASM_SIMP_TAC [VECTOR_NEG_COMPONENT, CONTINUOUS_ON_NEG, REAL_LE_NEG2])

  let IVT_DECREASING_COMPONENT_1 ← prove
   r"!f:real^1->real^N a b y k.
        drop a <= drop b /\ 1 <= k /\ k <= dimindex(:N) /\
        (!x. x IN interval[a,b] ==> f continuous at x) /\
        f(b)$k <= y /\ y <= f(a)$k
        ==> ?x. x IN interval[a,b] /\ f(x)$k = y"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC IVT_DECREASING_COMPONENT_ON_1 THEN
    ASM_SIMP_TAC [CONTINUOUS_AT_IMP_CONTINUOUS_ON])

  return { epigraph, IN_EPIGRAPH, CONVEX_EPIGRAPH, CONVEX_EPIGRAPH_CONVEX,
           CONVEX_ON_EPIGRAPH_SLICE_LE, CONVEX_ON_EPIGRAPH_SLICE_LT, CONVEX_ON_SUP,
           FORALL_OF_PASTECART, FORALL_OF_DROP, CONVEX_ON_JENSEN, CONVEX_ON_IMP_JENSEN,
           IVT_INCREASING_COMPONENT_ON_1, IVT_INCREASING_COMPONENT_1,
           IVT_DECREASING_COMPONENT_ON_1, IVT_DECREASING_COMPONENT_1 }

/- ------------------------------------------------------------------------- -/
/- A bound within a convex hull, and so an interval; representation of any   -/
/- interval as a finite convex hull.  (convex.ml 10336-10554)                -/
/- ------------------------------------------------------------------------- -/

structure CHB where
  CONVEX_ON_CONVEX_HULL_BOUND : thm
  CONVEX_ON_CONVEX_HULL_BOUND_EQ : thm
  DIST_CONVEX_HULL_BOUND_EQ : thm
  DIST_CONVEX_HULL_BOUND_2 : thm
  DIAMETER_CONVEX_HULL : thm
  DIAMETER_SIMPLEX : thm
  UNIT_INTERVAL_CONVEX_HULL : thm
  CLOSED_INTERVAL_AS_CONVEX_HULL : thm
  deriving Inhabited

@[nospecialize]
def setupCHB [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVF : CVF) (BCVH : CVH) (BCVE : CVE)
    (BMSH : MSH) (BLIN : LIN) (BEPI : EPI) : ExceptT String IO CHB := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, .. } := D
  let { BETA_THM, CARD_DELETE, CARD_EQ_0, CARD_NUMSEG, CARD_SUBSET, CART_EQ, CONTRAPOS_THM,
        EXTENSION, FINITE_DELETE, FINITE_EMPTY, FINITE_IMAGE, FINITE_NUMSEG, FINITE_POWERSET,
        FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, INF_FINITE, IN_DELETE, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, LAMBDA_BETA, LE, LEFT_IMP_EXISTS_THM, LE_REFL,
        LE_TRANS, NOT_IN_EMPTY, REAL_ADD_LID, REAL_DIV_LMUL, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_TRANS, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_POS,
        REAL_SUB_LE, REAL_SUB_REFL, SUBSET, SUBSET_ANTISYM, .. } := D.core5
  let { SUM_LE_NUMSEG, SUM_LMUL, SUP_EQ, real_div, .. } := D.core6
  let { HULL_INC, HULL_MINIMAL, HULL_SUBSET, .. } := D.misc
  let { DIST_SYM, .. } := D.vec1
  let { IN_INTERVAL, .. } := D.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT, dist, linear, .. } := D.vec4
  let { CLOSED_INTERVAL_IMAGE_UNIT_INTERVAL, .. } := D.top1
  let { diameter, .. } := D.top5
  let { convex, .. } := BCVX
  let { CONVEX_DISTANCE, .. } := BCVF
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EMPTY, CONVEX_HULL_EQ_EMPTY, .. } := BCVH
  let { CONVEX_HULL_INDEXED, .. } := BCVE
  let { CONVEX_HULL_TRANSLATION, .. } := BMSH
  let { CONVEX_HULL_LINEAR_IMAGE, CONVEX_INTERVAL, .. } := BLIN
  let { CONVEX_ON_JENSEN, .. } := BEPI
  -- @@SCOPE END

  let CONVEX_ON_CONVEX_HULL_BOUND ← prove
   r"!f s b. f convex_on (convex hull s) /\
           (!x:real^N. x IN s ==> f(x) <= b)
           ==> !x. x IN convex hull s ==> f(x) <= b"
   (REPEAT GEN_TAC THEN SIMP_TAC [CONVEX_ON_JENSEN, CONVEX_CONVEX_HULL] THEN
    STRIP_TAC THEN GEN_TAC THEN REWRITE_TAC [CONVEX_HULL_INDEXED] THEN
    REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:num", ← q r"u:num->real", ← q r"v:num->real^N"] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum(1..k) (\i. u i * f(v i :real^N))") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [SUBSET, HULL_SUBSET],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"sum(1..k) (\i. u i * b)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE_NUMSEG THEN ASM_SIMP_TAC [REAL_LE_LMUL],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [SUM_LMUL] THEN
    ASM_MESON_TAC [REAL_LE_REFL, REAL_MUL_RID])

  let CONVEX_ON_CONVEX_HULL_BOUND_EQ ← prove
   r"!f s:real^N->bool b.
       f convex_on convex hull s
       ==> ((!x. x IN convex hull s ==> f x <= b) <=>
            (!x. x IN s ==> f x <= b))"
   (MESON_TAC [CONVEX_ON_CONVEX_HULL_BOUND, HULL_INC])

  let DIST_CONVEX_HULL_BOUND_EQ ← prove
   r"!s a:real^N d.
        (!x. x IN convex hull s ==> dist(a,x) <= d) <=>
        (!x. x IN s ==> dist(a,x) <= d)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONVEX_ON_CONVEX_HULL_BOUND_EQ THEN
    REWRITE_TAC [CONVEX_DISTANCE])

  let DIST_CONVEX_HULL_BOUND_2 ← prove
   r"!s:real^N->bool d.
        (!x y. x IN convex hull s /\ y IN convex hull s ==> dist(x,y) <= d) <=>
        (!x y. x IN s /\ y IN s ==> dist(x,y) <= d)"
   (MESON_TAC [DIST_CONVEX_HULL_BOUND_EQ, DIST_SYM])

  let DIAMETER_CONVEX_HULL ← prove
   r"!s:real^N->bool. diameter(convex hull s) = diameter s"
   (GEN_TAC THEN REWRITE_TAC [diameter, CONVEX_HULL_EQ_EMPTY] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUP_EQ THEN
    REWRITE_TAC [FORALL_IN_GSPEC, ← GSYM dist, DIST_CONVEX_HULL_BOUND_2])

  let DIAMETER_SIMPLEX ← prove
   r"!s:real^N->bool.
        ~(s = {})
        ==> diameter(convex hull s) = sup { dist(x,y) | x IN s /\ y IN s}"
   (REWRITE_TAC [DIAMETER_CONVEX_HULL] THEN SIMP_TAC [diameter, dist])

  let UNIT_INTERVAL_CONVEX_HULL ← do
    let lemma ← prove
     r"FINITE {i | 1 <= i /\ i <= n /\ P(i)} /\
       CARD {i | 1 <= i /\ i <= n /\ P(i)} <= n"
     (CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"1..n"),
        GEN_REWRITE_TAC RAND_CONV [← ARITH_RULE (← q r"x = (x + 1) - 1")] THEN
        REWRITE_TAC [← GSYM CARD_NUMSEG] THEN MATCH_MP_TAC CARD_SUBSET] THEN
      SIMP_TAC [FINITE_NUMSEG, IN_NUMSEG, SUBSET, IN_ELIM_THM])
    prove
     r"interval [vec 0,vec 1:real^N] =
       convex hull
         {x:real^N | !i. 1 <= i /\ i <= dimindex(:N)
                             ==> ((x$i = &0) \/ (x$i = &1))}"
     (MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC HULL_MINIMAL THEN
        REWRITE_TAC [CONVEX_INTERVAL, SUBSET, IN_INTERVAL, IN_ELIM_THM] THEN
        SIMP_TAC [VEC_COMPONENT] THEN MESON_TAC [REAL_LE_REFL, REAL_POS]] THEN
      SUBGOAL_THEN
       (← q r"!n x:real^N.
            x IN interval[vec 0,vec 1] /\
            n <= dimindex(:N) /\
            CARD {i | 1 <= i /\ i <= dimindex(:N) /\ ~(x$i = &0)} <= n
            ==> x IN convex hull
                      {x:real^N | !i. 1 <= i /\ i <= dimindex(:N)
                                      ==> ((x$i = &0) \/ (x$i = &1))}")
      MP_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"dimindex(:N)") THEN
        ASM_REWRITE_TAC [LE_REFL, lemma]] THEN
      INDUCT_TAC THEN X_GEN_TAC (← q r"x:real^N") THENL
       [SIMP_TAC [LE, lemma, CARD_EQ_0] THEN
        GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
         [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY, BETA_THM] THEN
        REWRITE_TAC [← TAUT (← q r"~(a /\ b /\ c) <=> a /\ b ==> ~c")] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"x = vec 0:real^N") SUBST1_TAC THENL
         [ASM_SIMP_TAC [CART_EQ, VEC_COMPONENT], ALL_TAC] THEN
        MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN
        SIMP_TAC [IN_ELIM_THM, VEC_COMPONENT],
        ALL_TAC] THEN
      ASM_CASES_TAC
       (← q r"{i | 1 <= i /\ i <= dimindex(:N) /\ ~((x:real^N)$i = &0)} = {}")
      THENL
       [DISCH_THEN (K ALL_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EXTENSION]) THEN
        GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
         [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY, BETA_THM] THEN
        REWRITE_TAC [← TAUT (← q r"~(a /\ b /\ c) <=> a /\ b ==> ~c")] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"x = vec 0:real^N") SUBST1_TAC THENL
         [ASM_SIMP_TAC [CART_EQ, VEC_COMPONENT], ALL_TAC] THEN
        MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN
        SIMP_TAC [IN_ELIM_THM, VEC_COMPONENT],
        ALL_TAC] THEN
      MP_TAC (← ISPEC
       (← q r"IMAGE (\i. x$i)
          {i | 1 <= i /\ i <= dimindex(:N) /\ ~((x:real^N)$i = &0)}")
       INF_FINITE) THEN
      ABBREV_TAC (← q r"xi = inf
       (IMAGE (\i. x$i)
         {i | 1 <= i /\ i <= dimindex(:N) /\ ~((x:real^N)$i = &0)})") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, IMAGE_EQ_EMPTY, lemma] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [IN_IMAGE, IN_ELIM_THM] THEN
      REWRITE_TAC [] THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"i:num") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM SUBST_ALL_TAC THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"&0 <= (x:real^N)$i /\ x$i <= &1") STRIP_ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"x:real^N IN interval [vec 0,vec 1]") THEN
        ASM_SIMP_TAC [IN_INTERVAL, VEC_COMPONENT],
        ALL_TAC] THEN
      FIRST_X_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x <= &1 ==> (x = &1) \/ x < &1")))
      THENL
       [SUBGOAL_THEN
         (← q r"x = lambda i. if (x:real^N)$i = &0 then &0 else &1")
        SUBST1_TAC THENL
         [UNDISCH_TAC (← q r"x:real^N IN interval [vec 0,vec 1]") THEN
          ASM_SIMP_TAC [CART_EQ, IN_INTERVAL, VEC_COMPONENT, LAMBDA_BETA] THEN
          ASM_MESON_TAC [REAL_LE_ANTISYM],
          ALL_TAC] THEN
        MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN
        SIMP_TAC [IN_ELIM_THM, LAMBDA_BETA] THEN MESON_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"x:real^N =
            x$i % (lambda j. if x$j = &0 then &0 else &1) +
            (&1 - x$i) %
            (lambda j. if x$j = &0 then &0 else (x$j - x$i) / (&1 - x$i))")
      SUBST1_TAC THENL
       [SIMP_TAC [CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                  LAMBDA_BETA, VEC_COMPONENT] THEN
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [REAL_MUL_RZERO, REAL_ADD_LID] THEN
        ASM_SIMP_TAC [REAL_DIV_LMUL, ← ARITH_RULE (← q r"x < &1 ==> ~(&1 - x = &0)")] THEN
        REPEAT STRIP_TAC THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC (← REWRITE_RULE [convex] CONVEX_CONVEX_HULL) THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"x < &1 ==> &0 <= &1 - x"),
                    ← REAL_ARITH (← q r"x + &1 - x = &1")] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN
        SIMP_TAC [LAMBDA_BETA, IN_ELIM_THM] THEN MESON_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"SUC k <= n ==> k <= n")] THEN CONJ_TAC THENL
       [SIMP_TAC [IN_INTERVAL, LAMBDA_BETA, VEC_COMPONENT] THEN
        GEN_TAC THEN STRIP_TAC THEN
        COND_CASES_TAC THEN REWRITE_TAC [REAL_LE_REFL, REAL_POS] THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ,
                      ← REAL_ARITH (← q r"x < &1 ==> &0 < &1 - x")] THEN
        ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_SUB_LE, REAL_MUL_LID] THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"a - b <= &1 - b <=> a <= &1")] THEN
        UNDISCH_TAC (← q r"x:real^N IN interval [vec 0,vec 1]") THEN
        ASM_SIMP_TAC [CART_EQ, IN_INTERVAL, VEC_COMPONENT, LAMBDA_BETA],
        ALL_TAC] THEN
      MATCH_MP_TAC LE_TRANS THEN
      EXISTS_TAC
       (← q r"CARD({i | 1 <= i /\ i <= dimindex(:N) /\ ~((x:real^N)$i = &0)}
             DELETE i)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CARD_SUBSET THEN REWRITE_TAC [lemma, FINITE_DELETE] THEN
        REWRITE_TAC [SUBSET, IN_DELETE, IN_ELIM_THM] THEN
        GEN_TAC THEN REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        ASM_SIMP_TAC [LAMBDA_BETA] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [CONTRAPOS_THM] THEN
        SIMP_TAC [real_div, REAL_SUB_REFL, REAL_MUL_LZERO],
        SIMP_TAC [lemma, CARD_DELETE] THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"x <= SUC n ==> x - 1 <= n")] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_ELIM_THM]) THEN
        ASM_MESON_TAC []])

  let CLOSED_INTERVAL_AS_CONVEX_HULL ← prove
   r"!a b:real^N. ?s. FINITE s /\ interval[a,b] = convex hull s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THENL
     [ASM_MESON_TAC [CONVEX_HULL_EMPTY, FINITE_EMPTY], ALL_TAC] THEN
    ASM_SIMP_TAC [CLOSED_INTERVAL_IMAGE_UNIT_INTERVAL] THEN
    SUBGOAL_THEN
     (← q r"?s:real^N->bool. FINITE s /\ interval[vec 0,vec 1] = convex hull s")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC
       (← q r"{x:real^N | !i. 1 <= i /\ i <= dimindex(:N)
                        ==> ((x$i = &0) \/ (x$i = &1))}") THEN
      REWRITE_TAC [UNIT_INTERVAL_CONVEX_HULL] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
       (← q r"IMAGE (\s. (lambda i. if i IN s then &1 else &0):real^N)
              {t | t SUBSET (1..dimindex(:N))}") THEN
      ASM_SIMP_TAC [FINITE_POWERSET, FINITE_IMAGE, FINITE_NUMSEG] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN EXISTS_TAC
       (← q r"{i | 1 <= i /\ i <= dimindex(:N) /\ ((x:real^N)$i = &1)}") THEN
      SIMP_TAC [CART_EQ, IN_ELIM_THM, IN_NUMSEG, LAMBDA_BETA] THEN
      ASM_MESON_TAC [],
      EXISTS_TAC (← q r"IMAGE (\x:real^N. a + x)
                        (IMAGE (\x. (lambda i. ((b:real^N)$i - a$i) * x$i))
                               (s:real^N->bool))") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, CONVEX_HULL_TRANSLATION] THEN
      AP_TERM_TAC THEN MATCH_MP_TAC (← GSYM CONVEX_HULL_LINEAR_IMAGE) THEN
      SIMP_TAC [linear, CART_EQ, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                VECTOR_MUL_COMPONENT] THEN
      REPEAT STRIP_TAC THEN REAL_ARITH_TAC])

  return { CONVEX_ON_CONVEX_HULL_BOUND, CONVEX_ON_CONVEX_HULL_BOUND_EQ,
           DIST_CONVEX_HULL_BOUND_EQ, DIST_CONVEX_HULL_BOUND_2, DIAMETER_CONVEX_HULL,
           DIAMETER_SIMPLEX, UNIT_INTERVAL_CONVEX_HULL, CLOSED_INTERVAL_AS_CONVEX_HULL }

/- ------------------------------------------------------------------------- -/
/- Characterizations of convex functions in terms of secants.                -/
/- (convex.ml 10558-10700)                                                   -/
/- ------------------------------------------------------------------------- -/

structure SEC where
  CONVEX_ON_LEFT_SECANT_MUL : thm
  CONVEX_ON_RIGHT_SECANT_MUL : thm
  CONVEX_ON_MID_SECANT_MUL : thm
  CONVEX_ON_LEFT_SECANT : thm
  CONVEX_ON_RIGHT_SECANT : thm
  CONVEX_ON_MID_SECANT : thm
  CONVEX_ON_SECANTS_1_IMP : thm
  CONVEX_ON_SECANTS_1 : thm
  deriving Inhabited

@[nospecialize]
def setupSEC [HolBase] (D : ConvexDeps) (BCVF : CVF) : ExceptT String IO SEC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        VECTOR_ARITH, .. } := D
  let { FORALL_UNWIND_THM2, FUN_EQ_THM, IMP_CONJ, IN_DIFF, .. } := D.core2
  let { IN_INSERT, IN_SING, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_RMUL_EQ, REAL_LE_TRANS,
        REAL_LT_IMP_LE, REAL_LT_LE, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_NEG_SUB, REAL_SUB_LE,
        REAL_SUB_LT, REAL_SUB_REFL, .. } := D.core5
  let { SWAP_FORALL_THM, real_abs, .. } := D.core6
  let { DROP_EQ, DROP_SUB, NORM_0, NORM_1, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LT, .. } := D.vec3
  let { VECTOR_SUB_EQ, VECTOR_SUB_REFL, .. } := D.vec4
  let { IN_INTERVAL_1, IN_SEGMENT, IS_INTERVAL_1, .. } := D.top4
  let { SEGMENT_1, SEGMENT_REFL, open_segment, .. } := D.top5
  let { convex_on, .. } := BCVF
  -- @@SCOPE END

  let [CONVEX_ON_LEFT_SECANT_MUL,
       CONVEX_ON_RIGHT_SECANT_MUL,
       CONVEX_ON_MID_SECANT_MUL] := CONJUNCTS (← prove
   r"(!f s:real^N->bool.
        f convex_on s <=>
        !a b x. a IN s /\ b IN s /\ x IN segment[a,b]
                ==> (f x - f a) * norm(b - a) <= (f b - f a) * norm(x - a)) /\
   (!f s:real^N->bool.
        f convex_on s <=>
        !a b x. a IN s /\ b IN s /\ x IN segment[a,b]
                ==> (f b - f a) * norm(b - x) <= (f b - f x) * norm(b - a)) /\
   (!f s:real^N->bool.
        f convex_on s <=>
        !a b x. a IN s /\ b IN s /\ x IN segment[a,b]
                ==> (f x - f a) * norm (b - x) <= (f b - f x) * norm(x - a))"
   (REPEAT CONJ_TAC THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [convex_on] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"a:real^N") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"b:real^N") THEN REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(b:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IN_SEGMENT, LEFT_IMP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:real") THEN REWRITE_TAC [] THEN
    REWRITE_TAC [← TAUT (← q r"a /\ x = y <=> x = y /\ a"),
                 ← TAUT (← q r"a /\ x = y /\ b <=> x = y /\ a /\ b")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"v + u = &1 <=> v = &1 - u")] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2, IMP_CONJ] THEN
    REWRITE_TAC [REAL_SUB_LE] THEN
    ASM_CASES_TAC (← q r"&0 <= u") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"u <= &1") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"((&1 - u) % a + u % b) - a:real^N = u % (b - a)"),
     ← VECTOR_ARITH (← q r"b - ((&1 - u) % a + u % b):real^N = (&1 - u) % (b - a)")] THEN
    REWRITE_TAC [NORM_MUL, REAL_MUL_ASSOC] THEN
    (ASM_CASES_TAC (← q r"b:real^N = a") THENL
     [ASM_REWRITE_TAC [VECTOR_SUB_REFL, REAL_SUB_REFL,
                       ← VECTOR_ARITH (← q r"(&1 - u) % a + u % a:real^N = a")] THEN
      REAL_ARITH_TAC,
      ASM_SIMP_TAC [REAL_LE_RMUL_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
      ASM_SIMP_TAC [← REAL_ARITH
       (← q r"&0 <= u /\ u <= &1 ==> abs u = u /\ abs(&1 - u) = &1 - u")] THEN
      REAL_ARITH_TAC])))
    | throw "CONVEX_ON_LEFT_SECANT_MUL: CONJUNCTS"

  let [CONVEX_ON_LEFT_SECANT,
       CONVEX_ON_RIGHT_SECANT,
       CONVEX_ON_MID_SECANT] := CONJUNCTS (← prove
   r"(!f s:real^N->bool.
      f convex_on s <=>
        !a b x. a IN s /\ b IN s /\ x IN segment(a,b)
                ==> (f x - f a) / norm(x - a) <= (f b - f a) / norm(b - a)) /\
   (!f s:real^N->bool.
      f convex_on s <=>
        !a b x. a IN s /\ b IN s /\ x IN segment(a,b)
                ==> (f b - f a) / norm(b - a) <= (f b - f x) / norm(b - x)) /\
   (!f s:real^N->bool.
      f convex_on s <=>
        !a b x. a IN s /\ b IN s /\ x IN segment(a,b)
                ==> (f x - f a) / norm (x - a) <= (f b - f x) / norm(b - x))"
   (REPEAT CONJ_TAC THEN REPEAT GEN_TAC THENL
     [REWRITE_TAC [CONVEX_ON_LEFT_SECANT_MUL],
      REWRITE_TAC [CONVEX_ON_RIGHT_SECANT_MUL],
       REWRITE_TAC [CONVEX_ON_MID_SECANT_MUL]] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"a:real^N") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"b:real^N") THEN REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(b:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, NOT_IN_EMPTY, REAL_SUB_REFL, VECTOR_SUB_REFL,
                     NORM_0, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_LE_REFL] THEN
    REWRITE_TAC [IN_SING, FORALL_UNWIND_THM2, REAL_LE_REFL] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [] THEN
    REWRITE_TAC [open_segment, IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
    MAP_EVERY ASM_CASES_TAC [← q r"x:real^N = a", ← q r"x:real^N = b"] THEN
    ASM_REWRITE_TAC [REAL_LE_REFL, REAL_SUB_REFL, VECTOR_SUB_REFL, NORM_0,
                     REAL_MUL_LZERO, REAL_MUL_RZERO] THEN
    ASM_SIMP_TAC [REAL_LE_RDIV_EQ, ← GSYM REAL_LE_LDIV_EQ, NORM_POS_LT,
                  VECTOR_SUB_EQ] THEN
    AP_TERM_TAC THEN REAL_ARITH_TAC))
    | throw "CONVEX_ON_LEFT_SECANT: CONJUNCTS"

  let CONVEX_ON_SECANTS_1_IMP ← prove
   r"!f s a b c d.
        f convex_on s /\
        a IN s /\ b IN s /\ c IN s /\ d IN s /\
        drop a < drop b /\ drop b <= drop c /\ drop c < drop d
        ==> (f b - f a) / (drop b - drop a)
            <= (f d - f c) / (drop d - drop c)"
   (REWRITE_TAC [CONVEX_ON_MID_SECANT] THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"c:real^1 = b") THENL
     [FIRST_X_ASSUM SUBST_ALL_TAC THEN
      SUBGOAL_THEN (← q r"drop a <= drop d") ASSUME_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"d:real^1", ← q r"b:real^1"]) THEN
      ASM_SIMP_TAC [SEGMENT_1, NORM_1, DROP_SUB, REAL_LT_IMP_LE, real_abs,
                    REAL_SUB_LT, IN_INTERVAL_1],
      SUBGOAL_THEN (← q r"drop b < drop c") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [REAL_LT_LE, DROP_EQ], ALL_TAC]] THEN
    SUBGOAL_THEN (← q r"drop a <= drop c /\ drop b <= drop d") ASSUME_TAC THENL
     [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"(f c - f b) / (drop c - drop b)") THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"c:real^1", ← q r"b:real^1"]),
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"b:real^1", ← q r"d:real^1", ← q r"c:real^1"])] THEN
    ASM_SIMP_TAC [SEGMENT_1, NORM_1, DROP_SUB, REAL_LT_IMP_LE, real_abs,
                  REAL_SUB_LT, IN_INTERVAL_1])

  let CONVEX_ON_SECANTS_1 ← prove
   r"!f s. is_interval s
         ==> (f convex_on s <=>
              !a b c d. a IN s /\ b IN s /\ c IN s /\ d IN s /\
                         drop a < drop b /\ drop b <= drop c /\ drop c < drop d
                         ==> (f b - f a) / (drop b - drop a)
                             <= (f d - f c) / (drop d - drop c))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [CONVEX_ON_SECANTS_1_IMP], DISCH_TAC] THEN
    REWRITE_TAC [CONVEX_ON_MID_SECANT] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1", ← q r"x:real^1"] THEN
    DISJ_CASES_THEN MP_TAC (← REAL_ARITH
     (← q r"drop a = drop b \/ drop a < drop b \/ drop b < drop a"))
    THENL [ASM_MESON_TAC [DROP_EQ, SEGMENT_REFL, NOT_IN_EMPTY], ALL_TAC] THEN
    STRIP_TAC THEN
    ASM_SIMP_TAC [SEGMENT_1, IN_INTERVAL_1, REAL_LT_IMP_LE,
       ← REAL_ARITH (← q r"a < b ==> ~(b <= a)")] THEN
    STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL
        [← q r"a:real^1", ← q r"x:real^1", ← q r"x:real^1", ← q r"b:real^1"]) THEN
      ASM_SIMP_TAC [NORM_1, DROP_SUB, REAL_LT_IMP_LE, real_abs,
                    REAL_SUB_LT, REAL_LE_REFL] THEN
      ASM_MESON_TAC [IS_INTERVAL_1, REAL_LT_IMP_LE],
      FIRST_X_ASSUM (MP_TAC o SPECL
        [← q r"b:real^1", ← q r"x:real^1", ← q r"x:real^1", ← q r"a:real^1"]) THEN
      ASM_SIMP_TAC [NORM_1, DROP_SUB, REAL_LT_IMP_LE, real_abs,
                    REAL_SUB_LT, REAL_LE_REFL, REAL_SUB_LE,
                    ← REAL_ARITH (← q r"a < b ==> ~(b <= a)")] THEN
      REWRITE_TAC [REAL_NEG_SUB] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [IS_INTERVAL_1, REAL_LT_IMP_LE], REAL_ARITH_TAC]])

  return { CONVEX_ON_LEFT_SECANT_MUL, CONVEX_ON_RIGHT_SECANT_MUL, CONVEX_ON_MID_SECANT_MUL,
           CONVEX_ON_LEFT_SECANT, CONVEX_ON_RIGHT_SECANT, CONVEX_ON_MID_SECANT,
           CONVEX_ON_SECANTS_1_IMP, CONVEX_ON_SECANTS_1 }

/- ------------------------------------------------------------------------- -/
/- Starlike sets and more stuff about line segments.  (convex.ml 10704-10940) -/
/- ------------------------------------------------------------------------- -/

structure STL where
  starlike : thm
  CONVEX_IMP_STARLIKE : thm
  CONIC_IMP_STARLIKE : thm
  SEGMENT_CONVEX_HULL : thm
  CONTINUOUS_INCREASING_IMAGE_INTERVAL_1 : thm
  CONTINUOUS_DECREASING_IMAGE_INTERVAL_1 : thm
  SEGMENT_FURTHEST_LE : thm
  SEGMENT_BOUND : thm
  BETWEEN_IN_CONVEX_HULL : thm
  STARLIKE_LINEAR_IMAGE : thm
  STARLIKE_LINEAR_IMAGE_EQ : thm
  STARLIKE_TRANSLATION_EQ : thm
  BETWEEN_LINEAR_IMAGE_EQ : thm
  STARLIKE_CLOSURE : thm
  STARLIKE_UNIV : thm
  STARLIKE_PCROSS : thm
  STARLIKE_PCROSS_EQ : thm
  BETWEEN_DIST_LT : thm
  BETWEEN_DIST_LE : thm
  BETWEEN_NORM_LT : thm
  BETWEEN_NORM_LE : thm
  UNION_SEGMENT : thm
  CONVEX_STARCENTRES : thm
  deriving Inhabited

@[nospecialize]
def setupSTL [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCON : CON) (BCVB : CVB) (BCVH : CVH)
    (BEXC : EXC) (BSPX : SPX) (BLIN : LIN) (BONE : ONE) : ExceptT String IO STL := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE,
        SET_TAC, DESTRUCT_TAC, VECTOR_ARITH, LINEAR_INVARIANT_RULE, add_linear_invariants,
        add_translation_invariants, GEOM_TRANSLATE_TAC, .. } := D
  let { CONJ_ASSOC, EMPTY_SUBSET, EQ_IMP, EXISTS_IN_IMAGE, EXISTS_IN_PCROSS, EXISTS_PASTECART,
        EXTENSION, FINITE_INSERT, FINITE_RULES, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_UNWIND_THM2, FSTCART_PASTECART,
        FUN_IN_IMAGE, IMAGE_CLAUSES, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INSERT_SUBSET, .. } :=
    D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_SING, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_INSERT_EMPTY, NOT_IN_EMPTY, PASTECART_IN_PCROSS, PCROSS_EMPTY,
        REAL_ADD_LID, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_MUL, REAL_LE_REFL, REAL_LE_SUB_LADD, REAL_LE_TRANS, .. } :=
    D.core4
  let { RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SNDCART_PASTECART, SUBSET, SUBSET_ANTISYM_EQ,
        SUBSET_REFL, SUBSET_TRANS, .. } := D.core5
  let { SWAP_EXISTS_THM, SWAP_FORALL_THM, UNIONS_2, UNION_COMM, UNION_IDEMPOT,
        UNWIND_THM2, .. } := D.core6
  let { HULL_MINIMAL, .. } := D.misc
  let { DIST_0, .. } := D.vec1
  let { ENDS_IN_INTERVAL, LINEAR_FSTCART, LINEAR_SNDCART, NORM_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_SUB, PASTECART_ADD, PASTECART_CMUL, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_RZERO, VECTOR_SUB_REFL, dist, .. } := D.vec4
  let { BETWEEN_IN_SEGMENT, BOUNDED_EMPTY, CLOSED_SEGMENT_LINEAR_IMAGE,
        CLOSURE_APPROACHABLE, .. } := D.top1
  let { CLOSURE_SUBSET, CONNECTED_CONTINUOUS_IMAGE, .. } := D.top2
  let { INTERVAL_NE_EMPTY_1, IN_BALL, IN_CBALL, IN_INTERVAL_1, IN_SEGMENT,
        NOT_BOUNDED_UNIV, .. } := D.top4
  let { SEGMENT_1, SEGMENT_REFL, SEGMENT_SYM, segment, .. } := D.top5
  let { CONVEX_CONTAINS_SEGMENT, CONVEX_UNIV, .. } := BCVX
  let { conic, CONIC_CONTAINS_0, .. } := BCON
  let { CONVEX_BALL, CONVEX_CBALL, .. } := BCVB
  let { CONVEX_HULL_SING, CONVEX_HULL_INSERT, CONVEX_HULL_INSERT_SEGMENTS, .. } := BCVH
  let { CONVEX_HULL_EXCHANGE_UNION, .. } := BEXC
  let { SIMPLEX_FURTHEST_LE, .. } := BSPX
  let { CONNECTED_INTERVAL, .. } := BLIN
  let { CONVEX_CONNECTED_1, .. } := BONE
  -- @@SCOPE END

  let starlike ← new_definition
   r"starlike s <=> ?a. a IN s /\ !x. x IN s ==> segment[a,x] SUBSET s"

  let CONVEX_IMP_STARLIKE ← prove
   r"!s. convex s /\ ~(s = {}) ==> starlike s"
   (REWRITE_TAC [CONVEX_CONTAINS_SEGMENT, starlike, ← GSYM MEMBER_NOT_EMPTY] THEN
    MESON_TAC [])

  let CONIC_IMP_STARLIKE ← prove
   r"!s:real^N->bool. conic s /\ ~(s = {}) ==> starlike s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [starlike] THEN
    EXISTS_TAC (← q r"vec 0:real^N") THEN
    SUBGOAL_THEN (← q r"(vec 0:real^N) IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [CONIC_CONTAINS_0], ASM_REWRITE_TAC []] THEN
    REWRITE_TAC [SUBSET, segment, FORALL_IN_GSPEC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [conic]) THEN
    ASM_SIMP_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID])

  let SEGMENT_CONVEX_HULL ← prove
   r"!a b. segment[a,b] = convex hull {a,b}"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [CONVEX_HULL_INSERT, CONVEX_HULL_SING, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [IN_SING, RIGHT_EXISTS_AND_THM, UNWIND_THM2] THEN
    REWRITE_TAC [segment, EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"u + v = &1 <=> u = &1 - v")] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c /\ d <=> c /\ a /\ b /\ d")] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN REWRITE_TAC [UNWIND_THM2] THEN
    REWRITE_TAC [REAL_LE_SUB_LADD, REAL_ADD_LID] THEN MESON_TAC [])

  let CONTINUOUS_INCREASING_IMAGE_INTERVAL_1 ← prove
   r"!f:real^1->real^1 a b.
        ~(interval[a,b] = {}) /\ f continuous_on interval[a,b] /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y))
        ==> IMAGE f (interval[a,b]) = interval[f a,f b]"
   (REWRITE_TAC [INTERVAL_NE_EMPTY_1, IN_INTERVAL_1] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1] THEN
      ASM_MESON_TAC [REAL_LE_REFL, REAL_LE_TRANS],
      ALL_TAC] THEN
    TRANS_TAC SUBSET_TRANS (← q r"segment[(f:real^1->real^1) a,f b]") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [SEGMENT_1, REAL_LE_REFL, SUBSET_REFL], ALL_TAC] THEN
    REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
    ASM_SIMP_TAC [INSERT_SUBSET, EMPTY_SUBSET, FUN_IN_IMAGE, ENDS_IN_INTERVAL,
                  INTERVAL_NE_EMPTY_1, CONVEX_CONNECTED_1] THEN
    ASM_SIMP_TAC [CONNECTED_CONTINUOUS_IMAGE, CONNECTED_INTERVAL])

  let CONTINUOUS_DECREASING_IMAGE_INTERVAL_1 ← prove
   r"!f:real^1->real^1 a b.
        ~(interval[a,b] = {}) /\ f continuous_on interval[a,b] /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f y) <= drop(f x))
        ==> IMAGE f (interval[a,b]) = interval[f b,f a]"
   (REWRITE_TAC [INTERVAL_NE_EMPTY_1, IN_INTERVAL_1] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1] THEN
      ASM_MESON_TAC [REAL_LE_REFL, REAL_LE_TRANS],
      ALL_TAC] THEN
    TRANS_TAC SUBSET_TRANS (← q r"segment[(f:real^1->real^1) b,f a]") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [SEGMENT_1, REAL_LE_REFL, SUBSET_REFL], ALL_TAC] THEN
    REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
    ASM_SIMP_TAC [INSERT_SUBSET, EMPTY_SUBSET, FUN_IN_IMAGE, ENDS_IN_INTERVAL,
                  INTERVAL_NE_EMPTY_1, CONVEX_CONNECTED_1] THEN
    ASM_SIMP_TAC [CONNECTED_CONTINUOUS_IMAGE, CONNECTED_INTERVAL])

  let SEGMENT_FURTHEST_LE ← prove
   r"!a b x y:real^N.
        x IN segment[a,b] ==> norm(y - x) <= norm(y - a) \/
                              norm(y - x) <= norm(y - b)"
   (REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"y:real^N", ← q r"{a:real^N,b}"] SIMPLEX_FURTHEST_LE) THEN
    ASM_REWRITE_TAC [FINITE_INSERT, FINITE_RULES, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
    ASM_MESON_TAC [NORM_SUB])

  let SEGMENT_BOUND ← prove
   r"!a b x:real^N.
        x IN segment[a,b] ==> norm(x - a) <= norm(b - a) /\
                              norm(x - b) <= norm(b - a)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"a:real^N", ← q r"b:real^N", ← q r"x:real^N"]
      SEGMENT_FURTHEST_LE) THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")),
      DISCH_THEN (MP_TAC o SPEC (← q r"b:real^N"))] THEN
    REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
    ASM_MESON_TAC [NORM_POS_LE, REAL_LE_TRANS, NORM_SUB])

  let BETWEEN_IN_CONVEX_HULL ← prove
   r"!x a b:real^N. between x (a,b) <=> x IN convex hull {a,b}"
   (REWRITE_TAC [BETWEEN_IN_SEGMENT, SEGMENT_CONVEX_HULL])

  let STARLIKE_LINEAR_IMAGE ← prove
   r"!f s. starlike s /\ linear f ==> starlike(IMAGE f s)"
   (REWRITE_TAC [starlike, FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
    SIMP_TAC [CLOSED_SEGMENT_LINEAR_IMAGE] THEN SET_TAC [])

  let STARLIKE_LINEAR_IMAGE_EQ ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (starlike (IMAGE f s) <=> starlike s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE STARLIKE_LINEAR_IMAGE))

  add_linear_invariants [STARLIKE_LINEAR_IMAGE_EQ]

  let STARLIKE_TRANSLATION_EQ ← prove
   r"!a s. starlike (IMAGE (\x. a + x) s) <=> starlike s"
   (REWRITE_TAC [starlike] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [STARLIKE_TRANSLATION_EQ]

  let BETWEEN_LINEAR_IMAGE_EQ ← prove
   r"!f x y z. linear f /\ (!x y. f x = f y ==> x = y)
             ==> (between (f x) (f y,f z) <=> between x (y,z))"
   (SIMP_TAC [BETWEEN_IN_SEGMENT, CLOSED_SEGMENT_LINEAR_IMAGE] THEN SET_TAC [])

  add_linear_invariants [BETWEEN_LINEAR_IMAGE_EQ]

  let STARLIKE_CLOSURE ← prove
   r"!s:real^N->bool. starlike s ==> starlike(closure s)"
   (GEN_TAC THEN REWRITE_TAC [starlike, SUBSET, segment, FORALL_IN_GSPEC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
    STRIP_TAC THEN ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [SUBSET, CLOSURE_APPROACHABLE] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"u:real") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(&1 - u) % a + u % y:real^N") THEN
    ASM_SIMP_TAC [dist, NORM_MUL, ← VECTOR_ARITH
     (← q r"(v % a + u % y) - (v % a + u % z):real^N = u % (y - z)")] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          REAL_LET_TRANS)) THEN
    REWRITE_TAC [dist, ← REAL_ARITH (← q r"u * n <= n <=> &0 <= n * (&1 - u)")] THEN
    MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [NORM_POS_LE] THEN
    ASM_REAL_ARITH_TAC)

  let STARLIKE_UNIV ← prove
   r"starlike(:real^N)"
   (MESON_TAC [CONVEX_IMP_STARLIKE, CONVEX_UNIV,
               BOUNDED_EMPTY, NOT_BOUNDED_UNIV])

  let STARLIKE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        starlike s /\ starlike t ==> starlike(s PCROSS t)"
   (SIMP_TAC [starlike, EXISTS_IN_PCROSS, SUBSET, IN_SEGMENT] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    REWRITE_TAC [FORALL_IN_PCROSS, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2, IMP_IMP] THEN
    REWRITE_TAC [← GSYM PASTECART_CMUL, PASTECART_ADD] THEN
    REWRITE_TAC [PASTECART_IN_PCROSS] THEN MESON_TAC [])

  let STARLIKE_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        starlike(s PCROSS t) <=> starlike s /\ starlike t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THENL
     [ASM_REWRITE_TAC [PCROSS_EMPTY] THEN MESON_TAC [starlike, NOT_IN_EMPTY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [PCROSS_EMPTY] THEN MESON_TAC [starlike, NOT_IN_EMPTY],
      ALL_TAC] THEN
    EQ_TAC THEN REWRITE_TAC [STARLIKE_PCROSS] THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"fstcart:real^(M,N)finite_sum->real^M",
       ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] STARLIKE_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_FSTCART],
      MP_TAC (← ISPECL [← q r"sndcart:real^(M,N)finite_sum->real^N",
       ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"] STARLIKE_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_SNDCART]] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART, PASTECART_IN_PCROSS,
                 FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ASM SET_TAC [])

  let BETWEEN_DIST_LT ← prove
   r"!r a b c:real^N.
        dist(c,a) < r /\ dist(c,b) < r /\ between x (a,b) ==> dist(c,x) < r"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"convex hull {a,b} SUBSET ball(c:real^N,r)") MP_TAC THENL
     [MATCH_MP_TAC HULL_MINIMAL THEN
      ASM_REWRITE_TAC [CONVEX_BALL, INSERT_SUBSET, EMPTY_SUBSET, IN_BALL],
      ASM_SIMP_TAC [SUBSET, ← GSYM BETWEEN_IN_CONVEX_HULL, IN_BALL]])

  let BETWEEN_DIST_LE ← prove
   r"!r a b c:real^N.
      dist(c,a) <= r /\ dist(c,b) <= r /\ between x (a,b) ==> dist(c,x) <= r"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"convex hull {a,b} SUBSET cball(c:real^N,r)") MP_TAC THENL
     [MATCH_MP_TAC HULL_MINIMAL THEN
      ASM_REWRITE_TAC [CONVEX_CBALL, INSERT_SUBSET, EMPTY_SUBSET, IN_CBALL],
      ASM_SIMP_TAC [SUBSET, ← GSYM BETWEEN_IN_CONVEX_HULL, IN_CBALL]])

  let BETWEEN_NORM_LT ← prove
   r"!r a b x:real^N.
        norm a < r /\ norm b < r /\ between x (a,b) ==> norm x < r"
   (REWRITE_TAC [← GSYM (← CONJUNCT2 (← SPEC_ALL DIST_0)), BETWEEN_DIST_LT])

  let BETWEEN_NORM_LE ← prove
   r"!r a b x:real^N.
        norm a <= r /\ norm b <= r /\ between x (a,b) ==> norm x <= r"
   (REWRITE_TAC [← GSYM (← CONJUNCT2 (← SPEC_ALL DIST_0)), BETWEEN_DIST_LE])

  let UNION_SEGMENT ← prove
   r"!a b c:real^N.
        b IN segment[a,c]
        ==> segment[a,b] UNION segment[b,c] = segment[a,c]"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c:real^N = a") THENL
     [ASM_SIMP_TAC [SEGMENT_REFL, IN_SING, UNION_IDEMPOT],
      ONCE_REWRITE_TAC [UNION_COMM] THEN REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
      DISCH_THEN (SUBST1_TAC o MATCH_MP CONVEX_HULL_EXCHANGE_UNION) THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
      REWRITE_TAC [IMAGE_CLAUSES, UNIONS_2] THEN
      BINOP_TAC THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let CONVEX_STARCENTRES ← prove
   r"!s:real^N->bool.
        convex {a | a IN s /\ !x. x IN s ==> segment[a,x] SUBSET s}"
   (GEN_TAC THEN REWRITE_TAC [CONVEX_CONTAINS_SEGMENT, IN_ELIM_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    REWRITE_TAC [SUBSET, RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    X_GEN_TAC (← q r"c:real^N") THEN DISCH_THEN (DESTRUCT_TAC "a aseg b bseg c") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"y:real^N", ← q r"z:real^N"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(z:real^N) IN convex hull {a,b,y}") MP_TAC THENL
     [ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b,y} = {y,b,a}")], ALL_TAC] THEN
    ONCE_REWRITE_TAC [CONVEX_HULL_INSERT_SEGMENTS] THEN
    REWRITE_TAC [NOT_INSERT_EMPTY, ← GSYM SEGMENT_CONVEX_HULL] THENL
     [ONCE_REWRITE_TAC [SEGMENT_SYM], ALL_TAC] THEN
    ASM SET_TAC [])

  return { starlike, CONVEX_IMP_STARLIKE, CONIC_IMP_STARLIKE, SEGMENT_CONVEX_HULL,
           CONTINUOUS_INCREASING_IMAGE_INTERVAL_1, CONTINUOUS_DECREASING_IMAGE_INTERVAL_1,
           SEGMENT_FURTHEST_LE, SEGMENT_BOUND, BETWEEN_IN_CONVEX_HULL, STARLIKE_LINEAR_IMAGE,
           STARLIKE_LINEAR_IMAGE_EQ, STARLIKE_TRANSLATION_EQ, BETWEEN_LINEAR_IMAGE_EQ,
           STARLIKE_CLOSURE, STARLIKE_UNIV, STARLIKE_PCROSS, STARLIKE_PCROSS_EQ,
           BETWEEN_DIST_LT, BETWEEN_DIST_LE, BETWEEN_NORM_LT, BETWEEN_NORM_LE, UNION_SEGMENT,
           CONVEX_STARCENTRES }

/- ------------------------------------------------------------------------- -/
/- It might occasionally be handy to use midpoint convexity only; eliminate  -/
/- scalings when 0 is not in the affine hull.  (convex.ml 10944-11139)       -/
/- ------------------------------------------------------------------------- -/

structure MPC where
  MIDPOINT_CONVEX_SET : thm
  COLLINEAR_DESCALE : thm
  CLOSED_SEGMENT_DESCALE : thm
  OPEN_SEGMENT_DESCALE : thm
  deriving Inhabited

@[nospecialize]
def setupMPC [HolBase] (D : ConvexDeps) (BAFS : AFS) (BCVX : CVX) (BCOP : COP) (BCVP : CVP)
    (BSTL : STL) : ExceptT String IO MPC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_FIELD, REAL_RING, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH,
        NORM_ARITH, .. } := D
  let { CONJ_ASSOC, CONTRAPOS_THM, .. } := D.core1
  let { IMP_CONJ, INSERT_AC, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_UNION, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_EXISTS_THM,
        NOT_IN_EMPTY, REAL_ADD_LID, REAL_ARCH_POW_INV, REAL_DIV_1, .. } := D.core3
  let { REAL_ENTIRE, REAL_INV_MUL, REAL_LE_DIV, REAL_LE_MUL, REAL_LE_REFL, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_MIN, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_AC, REAL_MUL_LINV, REAL_MUL_RNEG, REAL_MUL_SYM, REAL_NEG_0, REAL_POW_INV,
        SING_SUBSET, SUBSET, .. } := D.core5
  let { real_div, real_pow, .. } := D.core6
  let { DIST_MIDPOINT, DIST_POS_LT, DIST_SYM, .. } := D.vec1
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_LCANCEL,
        VECTOR_MUL_RZERO, midpoint, .. } := D.vec4
  let { BALL_MIN_INTER, CLOSED_APPROACHABLE, .. } := D.top1
  let { DIST_IN_CLOSED_SEGMENT, ENDS_NOT_IN_SEGMENT, .. } := D.top3
  let { IN_BALL, IN_SEGMENT, MIDPOINT_IN_SEGMENT, OPEN_CONTAINS_BALL, .. } := D.top4
  let { SEGMENT_REFL, SEGMENT_SYM, segment, .. } := D.top5
  let { AFFINE_HULL_0_2_EXPLICIT, AFFINE_HULL_0_3_EXPLICIT, .. } := BAFS
  let { MIDPOINT_IN_CONVEX, CONVEX_CONTAINS_SEGMENT, .. } := BCVX
  let { COLLINEAR_3_EXPLICIT, .. } := BCOP
  let { CONVEX_HULL_2, .. } := BCVP
  let { SEGMENT_CONVEX_HULL, UNION_SEGMENT, .. } := BSTL
  -- @@SCOPE END

  let MIDPOINT_CONVEX_SET ← prove
   r"!s:real^N->bool.
        open s \/ closed s
        ==> (convex s <=> !a b. a IN s /\ b IN s ==> midpoint(a,b) IN s)"
   (GEN_TAC THEN DISCH_TAC THEN EQ_TAC THEN SIMP_TAC [MIDPOINT_IN_CONVEX] THEN
    DISCH_TAC THEN REWRITE_TAC [CONVEX_CONTAINS_SEGMENT] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THENL
     [ASM_REWRITE_TAC [SEGMENT_REFL, SING_SUBSET], ALL_TAC] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM DISJ_CASES_TAC THENL
     [SUBGOAL_THEN
      (← q r"?e. &0 < e /\ ball(a:real^N,e) SUBSET s /\ ball(b,e) SUBSET s")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
        DISCH_THEN (fun th => tactic_of do
          pure (MP_TAC (← SPEC (← q r"b:real^N") th) THEN
                MP_TAC (← SPEC (← q r"a:real^N") th))) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"min d e:real") THEN
        ASM_REWRITE_TAC [BALL_MIN_INTER, REAL_LT_MIN] THEN ASM SET_TAC [],
        ALL_TAC],
      FIRST_ASSUM (fun th => tactic_of do
        pure (ONCE_REWRITE_TAC [← GSYM (← MATCH_MP CLOSED_APPROACHABLE th)])) THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e / dist(a:real^N,b)"] REAL_ARCH_POW_INV) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, DIST_POS_LT, REAL_POW_INV] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THENL
     [SUBGOAL_THEN
       (← q r"!n. ?c d:real^N. ball(c,e) SUBSET s /\ ball(d,e) SUBSET s /\
                         x IN segment[c,d] /\
                         dist(c,d) <= dist(a:real^N,b) / &2 pow n")
       (MP_TAC o SPEC (← q r"N:num"))
      THENL
       [INDUCT_TAC THEN REWRITE_TAC [real_pow, REAL_DIV_1] THENL
         [ASM_MESON_TAC [REAL_LE_REFL], ALL_TAC] THEN
        FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"c:real^N") MP_TAC) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^N") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL [← q r"c:real^N", ← q r"midpoint(c:real^N,d)", ← q r"d:real^N"]
            UNION_SEGMENT) THEN
        REWRITE_TAC [MIDPOINT_IN_SEGMENT] THEN
        DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_UNION]) THEN
        DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN MATCH_MP_TAC (← MESON []
        (← q r"(x IN segment[a,b] ==> P a b)
         ==> x IN segment[a,b] ==> ?c d. P c d")) THEN
        DISCH_TAC THEN ASM_SIMP_TAC [DIST_MIDPOINT, real_div, REAL_INV_MUL] THEN
        (CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC]) THEN
        REWRITE_TAC [SUBSET, IN_BALL] THEN X_GEN_TAC (← q r"y:real^N") THEN
        DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"c + (y - midpoint(c,d)):real^N",
          ← q r"d + (y - midpoint(c,d)):real^N"]) THEN
        REWRITE_TAC [midpoint, ← VECTOR_ARITH
         (← q r"inv(&2) % ((c + y - inv (&2) % (c + d)) + d + y - inv (&2) % (c + d)) =
          (y:real^N)")] THEN
        DISCH_THEN MATCH_MP_TAC THEN
        (CONJ_TAC THENL
          [UNDISCH_TAC (← q r"ball(c:real^N,e) SUBSET s"),
           UNDISCH_TAC (← q r"ball(d:real^N,e) SUBSET s")] THEN
         REWRITE_TAC [SUBSET, IN_BALL] THEN DISCH_THEN MATCH_MP_TAC THEN
         ASM_REWRITE_TAC [← GSYM midpoint, ← NORM_ARITH
          (← q r"dist(c:real^N,c + x - y) = dist(y,x)")]),
         REWRITE_TAC [LEFT_IMP_EXISTS_THM, SUBSET, IN_BALL] THEN
         MAP_EVERY X_GEN_TAC [← q r"c:real^N", ← q r"d:real^N"] THEN
         DISCH_THEN (CONJUNCTS_THEN2 MATCH_MP_TAC STRIP_ASSUME_TAC)],
      SUBGOAL_THEN
       (← q r"!n. ?c d:real^N. c IN s /\ d IN s /\ x IN segment[c,d] /\
                         dist(c,d) <= dist(a:real^N,b) / &2 pow n")
       (MP_TAC o SPEC (← q r"N:num"))
      THENL
       [INDUCT_TAC THEN REWRITE_TAC [real_pow, REAL_DIV_1] THENL
         [ASM_MESON_TAC [REAL_LE_REFL], ALL_TAC] THEN
        FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"c:real^N") MP_TAC) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^N") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL [← q r"c:real^N", ← q r"midpoint(c:real^N,d)", ← q r"d:real^N"]
            UNION_SEGMENT) THEN
        REWRITE_TAC [MIDPOINT_IN_SEGMENT] THEN
        DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_UNION]) THEN
        DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN MATCH_MP_TAC (← MESON []
        (← q r"(x IN segment[a,b] ==> P a b)
         ==> x IN segment[a,b] ==> ?c d. P c d")) THEN
        DISCH_TAC THEN ASM_SIMP_TAC [DIST_MIDPOINT, real_div, REAL_INV_MUL] THEN
        ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^N") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^N") STRIP_ASSUME_TAC) THEN
        ASM_REWRITE_TAC []]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REAL_ARITH (← q r"dist(c,d) <= m ==> dist(c,x) <= dist(c,d) /\ m < e
                  ==> dist(c:real^N,x) < e"))) THEN
    (CONJ_TAC THENL
     [ASM_MESON_TAC [DIST_IN_CLOSED_SEGMENT, DIST_SYM],
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div] THEN
      ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, DIST_POS_LT]]))

  let COLLINEAR_DESCALE ← prove
   r"!a b c x y z:real^N.
        ~(a = &0) /\ ~(c = &0) /\
        collinear {a % x,b % y,c % z} /\
        ~(vec 0 IN affine hull {x,y,z})
        ==> collinear {x,y,z}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [AFFINE_HULL_0_3_EXPLICIT, COLLINEAR_3_EXPLICIT] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ, VECTOR_MUL_ASSOC] THEN
    DISCH_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a':real", ← q r"b':real", ← q r"c':real"] THEN
    REPEAT STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"a' * a:real", ← q r"b' * b:real", ← q r"c' * c:real"] THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_THEN (MP_TAC o SPECL
     [← q r"a' * a:real", ← q r"b' * b:real", ← q r"c' * c:real"]) THEN
    ASM_SIMP_TAC [] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let v0 ← q r"vec 0:real^N"
      let _ ← liftExcept (check (fun (t : thm) =>
        match HolCore.Kernel.rand (concl t) with
        | .ok r => r == v0
        | .error _ => false) th)
      pure ALL_TAC) THEN
    REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => REAL_RING t))

  let CLOSED_SEGMENT_DESCALE ← prove
   r"!a b c x y z:real^N.
        &0 < a /\ &0 <= b /\ &0 < c /\
        (b % y) IN segment[a % x,c % z] /\
        ~(vec 0 IN affine hull {x,y,z})
        ==> y IN segment[x,z]"
   (REPEAT GEN_TAC THEN REWRITE_TAC [AFFINE_HULL_0_3_EXPLICIT] THEN
    REWRITE_TAC [CONVEX_HULL_2, SEGMENT_CONVEX_HULL, IN_ELIM_THM] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ, VECTOR_MUL_ASSOC] THEN
    REPLICATE_TAC 3 DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real", ← q r"v:real"] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"b % y:real^N = a + c <=> a + (--b) % y + c = vec 0")] THEN
    REPEAT STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"u * a / b:real", ← q r"v * c / b:real"] THEN
    ASM_SIMP_TAC [REAL_LE_MUL, REAL_LE_DIV, REAL_LT_IMP_LE] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_THEN (MP_TAC o SPECL
     [← q r"u * a:real", ← q r"--b:real", ← q r"v * c:real"]) THEN
    ASM_SIMP_TAC [] THEN ASM_CASES_TAC (← q r"b = &0") THENL
     [ASM_SIMP_TAC [REAL_NEG_0, REAL_ADD_LID, REAL_LE_MUL, REAL_LT_IMP_LE,
       ← REAL_ARITH (← q r"&0 <= x /\ &0 <= y ==> (x + y = &0 <=> x = &0 /\ y = &0)"),
       REAL_ENTIRE, REAL_LT_IMP_NZ] THEN
      ASM_REAL_ARITH_TAC,
      DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THENL
       [UNDISCH_TAC (← q r"~(b = &0)") THEN CONV_TAC (fun t => REAL_FIELD t),
        DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"(%) (inv b):real^N->real^N")) THEN
        REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC] THEN
        ASM_SIMP_TAC [REAL_MUL_RNEG, REAL_MUL_LINV] THEN
        REWRITE_TAC [real_div, REAL_MUL_AC] THEN CONV_TAC (fun t => VECTOR_ARITH t)]])

  let OPEN_SEGMENT_DESCALE ← prove
   r"!a b c x y z:real^N.
        &0 < a /\ &0 <= b /\ &0 < c /\
        (b % y) IN segment(a % x,c % z) /\
        ~(vec 0 IN affine hull {x,y,z}) /\
        ~(x = y /\ z = y)
        ==> y IN segment(x,z)"
   (REWRITE_TAC [CONJ_ASSOC] THEN MATCH_MP_TAC (← MESON []
     (← q r"(!a b c x y z. P a b c x y z ==> P c b a z y x) /\
      (!a b c x y z. P a b c x y z /\ x = y ==> z = y) /\
      (!a b c x y z. P a b c x y z /\ ~(x = y) /\ ~(z = y) ==> Q x y z)
      ==> !a b c x y z. P a b c x y z /\ ~(x = y /\ z = y) ==> Q x y z")) THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN REPEAT CONJ_TAC THENL
     [MESON_TAC [SEGMENT_SYM, INSERT_AC],
      REPEAT GEN_TAC THEN
      ASM_CASES_TAC (← q r"y:real^N = x") THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"b % x:real^N = c % z") THEN
      ASM_REWRITE_TAC [ENDS_NOT_IN_SEGMENT] THEN
      ASM_CASES_TAC (← q r"z:real^N = x") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← SET_RULE (← q r"{x,x,z} = {x,z}"), AFFINE_HULL_0_2_EXPLICIT] THEN
      REWRITE_TAC [NOT_EXISTS_THM, IN_SEGMENT] THEN
      DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"(&1 - u) * a - b", ← q r"u * c:real"]) THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH
       (← q r"(a - b) % x + z:real^N = vec 0 <=> b % x = a % x + z")] THEN
      CONJ_TAC THENL [CONV_TAC (fun t => VECTOR_ARITH t), ALL_TAC] THEN
      UNDISCH_TAC (← q r"~(b % x:real^N = c % z)") THEN
      ASM_REWRITE_TAC [CONTRAPOS_THM, ← VECTOR_ARITH
       (← q r"y + u % c % z = c % z <=> y = (&1 - u) % c % z")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a - b + c = &0 <=> b = a + c")] THEN
      DISCH_TAC THEN
      UNDISCH_TAC (← q r"b % x:real^N = (&1 - u) % a % x + u % c % z") THEN
      ASM_REWRITE_TAC [VECTOR_ADD_RDISTRIB, ← GSYM VECTOR_MUL_ASSOC] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
      REWRITE_TAC [VECTOR_MUL_LCANCEL] THEN ASM_SIMP_TAC [REAL_LT_IMP_NZ],
      ONCE_REWRITE_TAC [segment] THEN
      REWRITE_TAC [IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [CLOSED_SEGMENT_DESCALE]])

  return { MIDPOINT_CONVEX_SET, COLLINEAR_DESCALE, CLOSED_SEGMENT_DESCALE,
           OPEN_SEGMENT_DESCALE }

/- ------------------------------------------------------------------------- -/
/- Shrinking towards the interior of a convex set.  (convex.ml 11143-11229)  -/
/- ------------------------------------------------------------------------- -/

structure SHR where
  IN_INTERIOR_CONVEX_SHRINK : thm
  IN_INTERIOR_CLOSURE_CONVEX_SHRINK : thm
  IN_INTERIOR_CLOSURE_CONVEX_SEGMENT : thm
  deriving Inhabited

@[nospecialize]
def setupSHR [HolBase] (D : ConvexDeps) (BCVX : CVX) : ExceptT String IO SHR := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, VECTOR_ARITH,
        VECTOR_ARITH_TAC, NORM_ARITH, .. } := D
  let { IN_ELIM_THM, IN_UNION, MONO_EXISTS, REAL_ABS_DIV, REAL_DIV_LMUL, .. } := D.core3
  let { REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ,
        REAL_LT_MUL, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_MUL_SYM,
        REAL_SUB_LE, REAL_SUB_LT, REAL_SUB_REFL, SUBSET, .. } := D.core5
  let { real_abs, real_div, .. } := D.core6
  let { NORM_0, .. } := D.vec2
  let { NORM_MUL, NORM_SUB, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, VECTOR_SUB_LDISTRIB, VECTOR_SUB_REFL,
        dist, .. } := D.vec4
  let { INTERIOR_OPEN, IN_BALL, IN_INTERIOR, IN_SEGMENT, LIMPT_APPROACHABLE,
        OPEN_BALL, .. } := D.top4
  let { SUBSET_INTERIOR, closure, .. } := D.top5
  let { CONVEX_ALT, .. } := BCVX
  -- @@SCOPE END

  let IN_INTERIOR_CONVEX_SHRINK ← prove
   r"!s e x c:real^N.
     convex s /\ c IN interior s /\
     x IN s /\ &0 < e /\ e <= &1
     ==> x - e % (x - c) IN interior s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERIOR]) THEN
    REWRITE_TAC [IN_INTERIOR, SUBSET, IN_BALL, dist] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"e * d:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    X_GEN_TAC (← q r"y':real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(&1 / e) % y' - ((&1 - e) / e) % x:real^N")) THEN
    ANTS_TAC THENL
     [UNDISCH_TAC (← q r"norm (x - e % (x - c) - y':real^N) < e * d") THEN
      SUBGOAL_THEN (← q r"x - e % (x - c) - y':real^N =
                    e % (c - (&1 / e % y' - (&1 - e) / e % x))")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [VECTOR_SUB_LDISTRIB, VECTOR_MUL_ASSOC,
                      REAL_DIV_LMUL, REAL_LT_IMP_NZ] THEN VECTOR_ARITH_TAC,
        ASM_SIMP_TAC [NORM_MUL, REAL_LT_LMUL_EQ, real_abs, REAL_LT_IMP_LE]],
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"y' = (&1 - (&1 - e)) % (&1 / e % y' - (&1 - e) / e % x) +
                         (&1 - e) % x:real^N")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [← REAL_ARITH (← q r"&1 - (&1 - e) = e"), VECTOR_SUB_LDISTRIB,
                      VECTOR_MUL_ASSOC, REAL_DIV_LMUL, REAL_LT_IMP_NZ] THEN
        VECTOR_ARITH_TAC,
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONVEX_ALT]) THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC]])

  let IN_INTERIOR_CLOSURE_CONVEX_SHRINK ← prove
   r"!s e x c:real^N.
     convex s /\ c IN interior s /\
     x IN closure s /\ &0 < e /\ e <= &1
     ==> x - e % (x - c) IN interior s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERIOR]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"?y:real^N. y IN s /\ norm(y - x) * (&1 - e) < e * d")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"(x:real^N) IN s") THENL
       [EXISTS_TAC (← q r"x:real^N") THEN
        ASM_SIMP_TAC [REAL_LT_MUL, VECTOR_SUB_REFL, NORM_0, REAL_MUL_LZERO],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [closure]) THEN
      ASM_REWRITE_TAC [IN_UNION, IN_ELIM_THM, LIMPT_APPROACHABLE, dist] THEN
      FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
       (← q r"e <= &1 ==> e = &1 \/ e < &1"))) THEN
      ASM_SIMP_TAC [REAL_SUB_REFL, ← GSYM REAL_LT_RDIV_EQ, REAL_SUB_LT] THENL
       [DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN
        REWRITE_TAC [REAL_MUL_RZERO, REAL_LT_01],
        DISCH_THEN (MP_TAC o SPEC (← q r"(e * d) / (&1 - e)"))] THEN
      ASM_SIMP_TAC [REAL_LT_RDIV_EQ, REAL_SUB_LT, REAL_MUL_LZERO, REAL_LT_MUL,
                    REAL_MUL_LID] THEN
      MATCH_MP_TAC MONO_EXISTS THEN MESON_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"z:real^N = c + ((&1 - e) / e) % (x - y)") THEN
    SUBGOAL_THEN (← q r"x - e % (x - c):real^N = y - e % (y - z)") SUBST1_TAC THENL
     [EXPAND_TAC "z" THEN
      REWRITE_TAC [VECTOR_SUB_LDISTRIB, VECTOR_ADD_LDISTRIB] THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_DIV_LMUL, REAL_LT_IMP_NZ] THEN
      VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC IN_INTERIOR_CONVEX_SHRINK THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET] o
       MATCH_MP SUBSET_INTERIOR) THEN
    SIMP_TAC [INTERIOR_OPEN, OPEN_BALL] THEN
    REWRITE_TAC [IN_BALL, dist] THEN EXPAND_TAC "z" THEN
    REWRITE_TAC [← NORM_ARITH (← q r"norm(c - (c + x)) = norm(x)")] THEN
    REWRITE_TAC [NORM_MUL, REAL_ABS_DIV] THEN
    ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE, REAL_SUB_LE] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [real_div, REAL_MUL_ASSOC] THEN
    ASM_SIMP_TAC [← GSYM real_div, REAL_LT_LDIV_EQ] THEN
    ASM_MESON_TAC [REAL_MUL_SYM, NORM_SUB])

  let IN_INTERIOR_CLOSURE_CONVEX_SEGMENT ← prove
   r"!s a b:real^N.
        convex s /\ a IN interior s /\ b IN closure s
        ==> segment(a,b) SUBSET interior s"
   (REWRITE_TAC [SUBSET, IN_SEGMENT] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
     (← q r"(&1 - u) % a + u % b:real^N = b - (&1 - u) % (b - a)")] THEN
    MATCH_MP_TAC IN_INTERIOR_CLOSURE_CONVEX_SHRINK THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  return { IN_INTERIOR_CONVEX_SHRINK, IN_INTERIOR_CLOSURE_CONVEX_SHRINK,
           IN_INTERIOR_CLOSURE_CONVEX_SEGMENT }

/- ------------------------------------------------------------------------- -/
/- Relative interior of a set (part 1).  (convex.ml 11233-11429)             -/
/- ------------------------------------------------------------------------- -/

structure RIA where
  relative_interior : thm
  relative_frontier : thm
  RELATIVE_INTERIOR_INTERIOR_OF : thm
  RELATIVE_FRONTIER_FRONTIER_OF : thm
  RELATIVE_INTERIOR : thm
  RELATIVE_INTERIOR_EQ : thm
  RELATIVE_INTERIOR_OPEN_IN : thm
  RELATIVE_INTERIOR_EMPTY : thm
  RELATIVE_FRONTIER_EMPTY : thm
  RELATIVE_INTERIOR_AFFINE : thm
  RELATIVE_INTERIOR_UNIV : thm
  OPEN_IN_RELATIVE_INTERIOR : thm
  RELATIVE_INTERIOR_SUBSET : thm
  RELATIVE_FRONTIER_SUBSET : thm
  RELATIVE_FRONTIER_SUBSET_EQ : thm
  BOUNDED_RELATIVE_INTERIOR : thm
  OPEN_IN_SET_RELATIVE_INTERIOR : thm
  SUBSET_RELATIVE_INTERIOR : thm
  RELATIVE_INTERIOR_CLOSURE_SUBSET : thm
  RELATIVE_INTERIOR_MAXIMAL : thm
  RELATIVE_INTERIOR_UNIQUE : thm
  IN_RELATIVE_INTERIOR : thm
  IN_RELATIVE_INTERIOR_CBALL : thm
  RELATIVE_INTERIOR_CONVEX_INTER_OPEN : thm
  CONIC_HULL_EQ_SPAN : thm
  CONIC_HULL_EQ_AFFINE_HULL : thm
  deriving Inhabited

@[nospecialize]
def setupRIA [HolBase] (D : ConvexDeps) (BCON : CON) (BCLH : CLH) (BAFI : AFI) (BADC : ADC) :
    ExceptT String IO RIA := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_FIELD, SET_RULE,
        SET_TAC, .. } := D
  let { AND_FORALL_THM, EMPTY_DIFF, EXTENSION, .. } := D.core1
  let { INTER_SUBSET, .. } := D.core2
  let { IN_ELIM_THM, IN_INTER, LEFT_AND_EXISTS_THM, REAL_ABS_DIV, REAL_DIV_RMUL, .. } :=
    D.core3
  let { REAL_LE_DIV, REAL_LT_IMP_LE, .. } := D.core4
  let { RIGHT_AND_EXISTS_THM, SUBSET, SUBSET_ANTISYM, SUBSET_INTER, SUBSET_TRANS, .. } :=
    D.core5
  let { SUBSET_UNIV, SWAP_EXISTS_THM, UNWIND_THM2, .. } := D.core6
  let { HULL_HULL, HULL_INC, HULL_P, HULL_SUBSET, REAL_HALF, .. } := D.misc
  let { NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, REAL_ABS_NORM, SPAN_MUL, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, .. } := D.vec4
  let { CLOSURE_OF_SUBTOPOLOGY, OPEN_IN_EMPTY, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET_TRANS,
        OPEN_IN_SUBTOPOLOGY_REFL, frontier_of, interior_of, .. } := D.met
  let { BOUNDED_SUBSET, CENTRE_IN_BALL, CLOSURE_EMPTY, .. } := D.top1
  let { CLOSURE_SUBSET, CLOSURE_SUBSET_EQ, .. } := D.top2
  let { EUCLIDEAN_CLOSURE_OF, .. } := D.top3
  let { IN_BALL, IN_CBALL, IN_CBALL_0, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := D.top4
  let { OPEN_INTER, OPEN_IN_OPEN, TOPSPACE_EUCLIDEAN, .. } := D.top5
  let { CONIC_HULL_EXPLICIT, .. } := BCON
  let { AFFINE_HULL_EQ_SPAN, CLOSURE_SUBSET_AFFINE_HULL, AFFINE_HULL_CLOSURE,
        AFFINE_HULL_EQ_SPAN_EQ, .. } := BCLH
  let { CONIC_HULL_SUBSET_SPAN, .. } := BAFI
  let { AFFINE_HULL_CONVEX_INTER_OPEN, .. } := BADC
  -- @@SCOPE END

  let relative_interior ← new_definition
   r"relative_interior s =
     {x | ?t. open_in (subtopology euclidean (affine hull s)) t /\
              x IN t /\ t SUBSET s}"

  let relative_frontier ← new_definition
   r"relative_frontier s = closure s DIFF relative_interior s"

  let RELATIVE_INTERIOR_INTERIOR_OF ← prove
   r"!s:real^N->bool.
        relative_interior s =
        subtopology euclidean (affine hull s) interior_of s"
   (REWRITE_TAC [interior_of, relative_interior])

  let RELATIVE_FRONTIER_FRONTIER_OF ← prove
   r"!s:real^N->bool.
        relative_frontier s =
        subtopology euclidean (affine hull s) frontier_of s"
   (GEN_TAC THEN REWRITE_TAC [relative_frontier] THEN
    REWRITE_TAC [frontier_of, RELATIVE_INTERIOR_INTERIOR_OF] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
    SIMP_TAC [HULL_SUBSET, ← SET_RULE (← q r"s SUBSET t ==> t INTER s = s"),
              CLOSURE_SUBSET_AFFINE_HULL])

  let RELATIVE_INTERIOR ← prove
   r"!s. relative_interior s =
          {x | x IN s /\
               ?t. open t /\ x IN t /\ t INTER (affine hull s) SUBSET s}"
   (REWRITE_TAC [EXTENSION, relative_interior, IN_ELIM_THM] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_OPEN, LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b) /\ c /\ d <=> b /\ a /\ c /\ d")] THEN
    REWRITE_TAC [UNWIND_THM2, SUBSET, IN_INTER, RIGHT_AND_EXISTS_THM] THEN
    AP_TERM_TAC THEN ABS_TAC THEN MESON_TAC [HULL_INC])

  let RELATIVE_INTERIOR_EQ ← prove
   r"!s. relative_interior s = s <=>
       open_in(subtopology euclidean (affine hull s)) s"
   (GEN_TAC THEN REWRITE_TAC [EXTENSION, relative_interior, IN_ELIM_THM] THEN
    GEN_REWRITE_TAC RAND_CONV [OPEN_IN_SUBOPEN] THEN MESON_TAC [SUBSET])

  let RELATIVE_INTERIOR_OPEN_IN ← prove
   r"!s. open_in(subtopology euclidean (affine hull s)) s
       ==> relative_interior s = s"
   (REWRITE_TAC [RELATIVE_INTERIOR_EQ])

  let RELATIVE_INTERIOR_EMPTY ← prove
   r"relative_interior {} = {}"
   (SIMP_TAC [RELATIVE_INTERIOR_OPEN_IN, OPEN_IN_EMPTY])

  let RELATIVE_FRONTIER_EMPTY ← prove
   r"relative_frontier {} = {}"
   (REWRITE_TAC [relative_frontier, CLOSURE_EMPTY, EMPTY_DIFF])

  let RELATIVE_INTERIOR_AFFINE ← prove
   r"!s:real^N->bool. affine s ==> relative_interior s = s"
   (SIMP_TAC [RELATIVE_INTERIOR_EQ, OPEN_IN_SUBTOPOLOGY_REFL, HULL_P] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let RELATIVE_INTERIOR_UNIV ← prove
   r"!s. relative_interior(affine hull s) = affine hull s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RELATIVE_INTERIOR_OPEN_IN THEN
    REWRITE_TAC [HULL_HULL, OPEN_IN_SUBTOPOLOGY_REFL] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let OPEN_IN_RELATIVE_INTERIOR ← prove
   r"!s. open_in (subtopology euclidean (affine hull s))
               (relative_interior s)"
   (GEN_TAC THEN REWRITE_TAC [relative_interior] THEN
    GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MESON_TAC [])

  let RELATIVE_INTERIOR_SUBSET ← prove
   r"!s. (relative_interior s) SUBSET s"
   (REWRITE_TAC [SUBSET, relative_interior, IN_ELIM_THM] THEN MESON_TAC [])

  let RELATIVE_FRONTIER_SUBSET ← prove
   r"!s:real^N->bool. closed s ==> relative_frontier s SUBSET s"
   (REWRITE_TAC [← GSYM CLOSURE_SUBSET_EQ, relative_frontier] THEN SET_TAC [])

  let RELATIVE_FRONTIER_SUBSET_EQ ← prove
   r"!s:real^N->bool. relative_frontier s SUBSET s <=> closed s"
   (GEN_TAC THEN REWRITE_TAC [← GSYM CLOSURE_SUBSET_EQ, relative_frontier] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN SET_TAC [])

  let BOUNDED_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool. bounded s ==> bounded(relative_interior s)"
   (MESON_TAC [BOUNDED_SUBSET, RELATIVE_INTERIOR_SUBSET])

  let OPEN_IN_SET_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool. open_in (subtopology euclidean s) (relative_interior s)"
   (GEN_TAC THEN MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
    EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
    REWRITE_TAC [OPEN_IN_RELATIVE_INTERIOR, RELATIVE_INTERIOR_SUBSET,
                 HULL_SUBSET])

  let SUBSET_RELATIVE_INTERIOR ← prove
   r"!s t. s SUBSET t /\ affine hull s = affine hull t
         ==> (relative_interior s) SUBSET (relative_interior t)"
   (REWRITE_TAC [relative_interior, SUBSET, IN_ELIM_THM] THEN MESON_TAC [])

  let RELATIVE_INTERIOR_CLOSURE_SUBSET ← prove
   r"!s. relative_interior s SUBSET relative_interior(closure s)"
   (SIMP_TAC [SUBSET_RELATIVE_INTERIOR, CLOSURE_SUBSET,
              AFFINE_HULL_CLOSURE])

  let RELATIVE_INTERIOR_MAXIMAL ← prove
   r"!s t. t SUBSET s /\
         open_in(subtopology euclidean (affine hull s)) t
         ==> t SUBSET (relative_interior s)"
   (REWRITE_TAC [relative_interior, SUBSET, IN_ELIM_THM] THEN MESON_TAC [])

  let RELATIVE_INTERIOR_UNIQUE ← prove
   r"!s t. t SUBSET s /\
         open_in(subtopology euclidean (affine hull s)) t /\
         (!t'. t' SUBSET s /\
               open_in(subtopology euclidean (affine hull s)) t'
               ==> t' SUBSET t)
         ==> (relative_interior s = t)"
   (MESON_TAC [SUBSET_ANTISYM, RELATIVE_INTERIOR_MAXIMAL, RELATIVE_INTERIOR_SUBSET,
               OPEN_IN_RELATIVE_INTERIOR])

  let IN_RELATIVE_INTERIOR ← prove
   r"!x:real^N s.
        x IN relative_interior s <=>
        x IN s /\ ?e. &0 < e /\ (ball(x,e) INTER (affine hull s)) SUBSET s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [relative_interior, IN_ELIM_THM] THEN
    REWRITE_TAC [OPEN_IN_OPEN, LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b) /\ c /\ d <=> b /\ a /\ c /\ d")] THEN
    REWRITE_TAC [UNWIND_THM2, SUBSET, IN_INTER] THEN EQ_TAC THENL
     [ASM_MESON_TAC [SUBSET, OPEN_CONTAINS_BALL],
      STRIP_TAC THEN EXISTS_TAC (← q r"ball(x:real^N,e)") THEN
      ASM_SIMP_TAC [OPEN_BALL, CENTRE_IN_BALL, HULL_INC]])

  let IN_RELATIVE_INTERIOR_CBALL ← prove
   r"!x:real^N s.
        x IN relative_interior s <=>
        x IN s /\ ?e. &0 < e /\ (cball(x,e) INTER affine hull s) SUBSET s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IN_RELATIVE_INTERIOR] THEN
    AP_TERM_TAC THEN EQ_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THENL
     [EXISTS_TAC (← q r"e / &2") THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"ball(x:real^N,e) INTER affine hull s") THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET, IN_INTER, IN_BALL, IN_CBALL] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")],
      EXISTS_TAC (← q r"e:real") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"cball(x:real^N,e) INTER affine hull s") THEN
      ASM_REWRITE_TAC [] THEN
      SIMP_TAC [SUBSET, IN_INTER, IN_BALL, IN_CBALL, REAL_LT_IMP_LE]])

  let RELATIVE_INTERIOR_CONVEX_INTER_OPEN ← prove
   r"!s t:real^N->bool.
        convex s /\ open t /\ ~(s INTER t = {})
        ==> relative_interior(s INTER t) = relative_interior s INTER t"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC RELATIVE_INTERIOR_UNIQUE THEN
    ASM_SIMP_TAC [AFFINE_HULL_CONVEX_INTER_OPEN, SUBSET_INTER, INTER_SUBSET] THEN
    REPEAT CONJ_TAC THENL
     [MP_TAC (← ISPEC (← q r"s:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN SET_TAC [],
      MP_TAC (← ISPEC (← q r"s:real^N->bool") OPEN_IN_RELATIVE_INTERIOR) THEN
      REWRITE_TAC [OPEN_IN_OPEN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"t INTER u:real^N->bool") THEN
      ASM_SIMP_TAC [OPEN_INTER] THEN ASM SET_TAC [],
      MESON_TAC [RELATIVE_INTERIOR_MAXIMAL]])

  let (CONIC_HULL_EQ_SPAN, CONIC_HULL_EQ_AFFINE_HULL) ← CONJ_PAIR (← prove
   r"(!s:real^N->bool.
        vec 0 IN relative_interior s ==> conic hull s = span s) /\
   (!s:real^N->bool.
        vec 0 IN relative_interior s ==> conic hull s = affine hull s)"
   (SIMP_TAC [AND_FORALL_THM, ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    GEN_TAC THEN DISCH_TAC THEN FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC o
      GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR_CBALL]) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"a = s /\ c SUBSET s /\ a SUBSET c ==> c = s /\ c = a")) THEN
    ASM_SIMP_TAC [CONIC_HULL_SUBSET_SPAN, AFFINE_HULL_EQ_SPAN_EQ, HULL_INC] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN ASM_SIMP_TAC [HULL_INC] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / norm x % x:real^N") o
      REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [IN_INTER, IN_CBALL_0, NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM,
                  REAL_DIV_RMUL, NORM_EQ_0] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> abs e <= e")] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SPAN_MUL, AFFINE_HULL_EQ_SPAN, HULL_INC], DISCH_TAC] THEN
    REWRITE_TAC [CONIC_HULL_EXPLICIT, IN_ELIM_THM] THEN
    MAP_EVERY EXISTS_TAC [← q r"norm(x:real^N) / e", ← q r"e / norm x % x:real^N"] THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_LE_DIV, NORM_POS_LE, REAL_LT_IMP_LE] THEN
    ASM_SIMP_TAC [VECTOR_MUL_LID, NORM_EQ_0, ← REAL_FIELD
     (← q r"~(x = &0) /\ &0 < e ==> x / e * e / x = &1")]))

  return { relative_interior, relative_frontier, RELATIVE_INTERIOR_INTERIOR_OF,
           RELATIVE_FRONTIER_FRONTIER_OF, RELATIVE_INTERIOR, RELATIVE_INTERIOR_EQ,
           RELATIVE_INTERIOR_OPEN_IN, RELATIVE_INTERIOR_EMPTY, RELATIVE_FRONTIER_EMPTY,
           RELATIVE_INTERIOR_AFFINE, RELATIVE_INTERIOR_UNIV, OPEN_IN_RELATIVE_INTERIOR,
           RELATIVE_INTERIOR_SUBSET, RELATIVE_FRONTIER_SUBSET, RELATIVE_FRONTIER_SUBSET_EQ,
           BOUNDED_RELATIVE_INTERIOR, OPEN_IN_SET_RELATIVE_INTERIOR, SUBSET_RELATIVE_INTERIOR,
           RELATIVE_INTERIOR_CLOSURE_SUBSET, RELATIVE_INTERIOR_MAXIMAL,
           RELATIVE_INTERIOR_UNIQUE, IN_RELATIVE_INTERIOR, IN_RELATIVE_INTERIOR_CBALL,
           RELATIVE_INTERIOR_CONVEX_INTER_OPEN, CONIC_HULL_EQ_SPAN,
           CONIC_HULL_EQ_AFFINE_HULL }

/- ------------------------------------------------------------------------- -/
/- Relative interior of a set (part 2).  (convex.ml 11431-11634)             -/
/- ------------------------------------------------------------------------- -/

structure RIB where
  CONIC_HULL_EQ_SPAN_EQ : thm
  OPEN_IN_SUBSET_RELATIVE_INTERIOR : thm
  RELATIVE_INTERIOR_TRANSLATION : thm
  RELATIVE_FRONTIER_TRANSLATION : thm
  RELATIVE_INTERIOR_INJECTIVE_LINEAR_IMAGE : thm
  RELATIVE_FRONTIER_INJECTIVE_LINEAR_IMAGE : thm
  RELATIVE_INTERIOR_RELATIVE_INTERIOR : thm
  RELATIVE_INTERIOR_EQ_EMPTY : thm
  AFF_DIM_NONEMPTY_INTERIOR_OF_EQ : thm
  RELATIVE_INTERIOR_INTERIOR : thm
  RELATIVE_INTERIOR_OPEN : thm
  RELATIVE_INTERIOR_NONEMPTY_INTERIOR : thm
  RELATIVE_FRONTIER_NONEMPTY_INTERIOR : thm
  RELATIVE_FRONTIER_FRONTIER : thm
  RELATIVE_FRONTIER_OPEN : thm
  AFFINE_HULL_CONVEX_HULL : thm
  deriving Inhabited

@[nospecialize]
def setupRIB [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BCVS : CVS) (BCLH : CLH)
    (BAFI : AFI) (BADC : ADC) (BADD : ADD) (BADE : ADE) (BRIA : RIA) :
    ExceptT String IO RIB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        VECTOR_ARITH_TAC, NORM_ARITH, add_linear_invariants, add_translation_invariants,
        GEOM_TRANSFORM_TAC, GEOM_TRANSLATE_TAC, .. } := D
  let { EQ_IMP, EXISTS_SUBSET_IMAGE, FINITE_INSERT, .. } := D.core1
  let { HAS_SIZE, IMAGE_EQ_EMPTY, IMP_CONJ_ALT, INSERT_SUBSET, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, .. } := D.core3
  let { REAL_LE_INV_EQ, REAL_LE_LDIV_EQ, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ, .. } :=
    D.core4
  let { REAL_MUL_ASSOC, REAL_NOT_LE, REAL_SUB_LE, REAL_SUB_LT, SUBSET, SUBSET_ANTISYM_EQ,
        SUBSET_EMPTY, SUBSET_TRANS, .. } := D.core5
  let { SUM_BOUND, SUM_CLAUSES, SUM_CONST, SUM_EQ, real_div, .. } := D.core6
  let { HULL_HULL, HULL_INC, HULL_MINIMAL, HULL_MONO, HULL_P, HULL_SUBSET, HULL_UNIQUE, .. } :=
    D.misc
  let { BASIS_EXISTS, .. } := D.vec1
  let { INDEPENDENT_NONZERO, .. } := D.vec2
  let { SPAN_0, SPAN_EQ, SPAN_FINITE, SPAN_INC, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_RZERO, VECTOR_SUB_RDISTRIB, VSUM_CLAUSES, VSUM_EQ,
        VSUM_SUB, dist, .. } := D.vec4
  let { SUBTOPOLOGY_UNIV, .. } := D.met
  let { BASIS_COORDINATES_CONTINUOUS, .. } := D.top1
  let { FRONTIER_EMPTY, .. } := D.top3
  let { INTERIOR_EQ, INTERIOR_OPEN, IN_BALL, .. } := D.top4
  let { OPEN_IN, OPEN_IN_INJECTIVE_LINEAR_IMAGE, OPEN_IN_OPEN, frontier, interior, .. } :=
    D.top5
  let { AFFINE_AFFINE_HULL, AFFINE_HULL_LINEAR_IMAGE, .. } := BAFF
  let { CONVEX_TRANSLATION_EQ, .. } := BCVX
  let { CONVEX_EXPLICIT, .. } := BCVS
  let { CONVEX_HULL_SUBSET_AFFINE_HULL, AFFINE_SPAN, AFFINE_HULL_EQ_SPAN, .. } := BCLH
  let { SPAN_CONIC_HULL, .. } := BAFI
  let { AFF_DIM_EQ_MINUS1, AFF_DIM_EQ_FULL_GEN, .. } := BADC
  let { AFFINE_HULL_OPEN, AFFINE_HULL_NONEMPTY_INTERIOR, .. } := BADD
  let { AFF_DIM_NONEMPTY_INTERIOR_OF, .. } := BADE
  let { relative_interior, relative_frontier, RELATIVE_INTERIOR_INTERIOR_OF,
        RELATIVE_INTERIOR_EMPTY, RELATIVE_FRONTIER_EMPTY, RELATIVE_INTERIOR_AFFINE,
        RELATIVE_INTERIOR_SUBSET, RELATIVE_INTERIOR_MAXIMAL, IN_RELATIVE_INTERIOR,
        CONIC_HULL_EQ_SPAN, .. } := BRIA
  -- @@SCOPE END

  let CONIC_HULL_EQ_SPAN_EQ ← prove
   r"!s:real^N->bool.
        vec 0 IN relative_interior(conic hull s) <=> conic hull s = span s"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [MP_TAC (← ISPEC (← q r"conic hull s:real^N->bool") CONIC_HULL_EQ_SPAN) THEN
      ASM_REWRITE_TAC [SPAN_CONIC_HULL, HULL_HULL],
      ASM_SIMP_TAC [RELATIVE_INTERIOR_AFFINE, AFFINE_SPAN, SPAN_0]])

  let OPEN_IN_SUBSET_RELATIVE_INTERIOR ← prove
   r"!s t. open_in(subtopology euclidean (affine hull t)) s
         ==> (s SUBSET relative_interior t <=> s SUBSET t)"
   (MESON_TAC [RELATIVE_INTERIOR_MAXIMAL, RELATIVE_INTERIOR_SUBSET,
               SUBSET_TRANS])

  let RELATIVE_INTERIOR_TRANSLATION ← prove
   r"!a:real^N s.
        relative_interior (IMAGE (\x. a + x) s) =
        IMAGE (\x. a + x) (relative_interior s)"
   (REWRITE_TAC [relative_interior, OPEN_IN_OPEN] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [RELATIVE_INTERIOR_TRANSLATION]

  let RELATIVE_FRONTIER_TRANSLATION ← prove
   r"!a:real^N s.
        relative_frontier (IMAGE (\x. a + x) s) =
        IMAGE (\x. a + x) (relative_frontier s)"
   (REWRITE_TAC [relative_frontier] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [RELATIVE_FRONTIER_TRANSLATION]

  let RELATIVE_INTERIOR_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> relative_interior(IMAGE f s) = IMAGE f (relative_interior s)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [relative_interior, AFFINE_HULL_LINEAR_IMAGE] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> c /\ a /\ b")] THEN
    REWRITE_TAC [EXISTS_SUBSET_IMAGE] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_INJECTIVE_LINEAR_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  add_linear_invariants [RELATIVE_INTERIOR_INJECTIVE_LINEAR_IMAGE]

  let RELATIVE_FRONTIER_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> relative_frontier(IMAGE f s) = IMAGE f (relative_frontier s)"
   (REWRITE_TAC [relative_frontier] THEN GEOM_TRANSFORM_TAC [])

  add_linear_invariants [RELATIVE_FRONTIER_INJECTIVE_LINEAR_IMAGE]

  let RELATIVE_INTERIOR_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool.
        relative_interior(relative_interior s) = relative_interior s"
   (GEN_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, RELATIVE_INTERIOR_SUBSET] THEN
    REWRITE_TAC [SUBSET] THEN SIMP_TAC [IN_RELATIVE_INTERIOR] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"a' SUBSET a /\ (b INTER a SUBSET s ==> b INTER a SUBSET i)
      ==> b INTER a SUBSET s ==> b INTER a' SUBSET i")) THEN
    SIMP_TAC [HULL_MONO, RELATIVE_INTERIOR_SUBSET] THEN
    REWRITE_TAC [SUBSET, IN_INTER, IN_BALL] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [IN_RELATIVE_INTERIOR] THEN
    EXISTS_TAC (← q r"e - dist(x:real^N,y)") THEN ASM_REWRITE_TAC [REAL_SUB_LT] THEN
    REWRITE_TAC [IN_BALL, IN_INTER, SUBSET] THEN X_GEN_TAC (← q r"z:real^N") THEN
    STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_NOT_LE])) THEN
    CONV_TAC (fun t => NORM_ARITH t))

  let RELATIVE_INTERIOR_EQ_EMPTY ← prove
   r"!s:real^N->bool.
        convex s ==> (relative_interior s = {} <=> s = {})"
   (SUBGOAL_THEN
     (← q r"!s:real^N->bool.
          vec 0 IN s /\ convex s ==> ~(relative_interior s = {})")
    ASSUME_TAC THENL
     [ALL_TAC,
      GEN_TAC THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [RELATIVE_INTERIOR_EMPTY] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (\x:real^N. --a + x) s")) THEN
      REWRITE_TAC [CONVEX_TRANSLATION_EQ, RELATIVE_INTERIOR_TRANSLATION] THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, IN_IMAGE] THEN
      DISCH_THEN MATCH_MP_TAC THEN EXISTS_TAC (← q r"a:real^N") THEN
      ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC] THEN
    GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_RELATIVE_INTERIOR] THEN
    ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC] THEN
    X_CHOOSE_THEN (← q r"b:real^N->bool") STRIP_ASSUME_TAC
     (← ISPEC (← q r"s:real^N->bool") BASIS_EXISTS) THEN
    SUBGOAL_THEN (← q r"span(s:real^N->bool) = span b") SUBST_ALL_TAC THENL
     [ASM_SIMP_TAC [SPAN_EQ] THEN ASM_MESON_TAC [SPAN_INC, SUBSET_TRANS],
      ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
    ABBREV_TAC (← q r"n = dim(s:real^N->bool)") THEN
    SUBGOAL_THEN
     (← q r"!c. (!v. v IN b ==> &0 <= c(v)) /\ sum b c <= &1
          ==> vsum b (\v:real^N. c(v) % v) IN s")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN SUBGOAL_THEN
       (← q r"vsum (vec 0 INSERT b :real^N->bool)
             (\v. (if v = vec 0 then &1 - sum b c else c v) % v) IN s")
      MP_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONVEX_EXPLICIT]) THEN
        ASM_SIMP_TAC [INSERT_SUBSET, FINITE_INSERT, SUM_CLAUSES,
                      INDEPENDENT_NONZERO, IN_INSERT] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [REAL_SUB_LE], ALL_TAC] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&1 - x + y = &1 <=> x = y")] THEN
        MATCH_MP_TAC SUM_EQ THEN ASM_MESON_TAC [INDEPENDENT_NONZERO],
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        ASM_SIMP_TAC [VSUM_CLAUSES, INDEPENDENT_NONZERO] THEN
        REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
        MATCH_MP_TAC VSUM_EQ THEN ASM_MESON_TAC [INDEPENDENT_NONZERO]],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"a:real^N = vsum b (\v. inv(&2 * &n + &1) % v)") THEN
    EXISTS_TAC (← q r"a:real^N") THEN CONJ_TAC THENL
     [EXPAND_TAC "a" THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [SUM_CONST, REAL_LE_INV_EQ, ← REAL_ARITH (← q r"&0 < &2 * &n + &1"),
                    ← GSYM real_div, REAL_LT_IMP_LE, REAL_LE_LDIV_EQ] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"b:real^N->bool", ← q r"inv(&2 * &n + &1)"]
          BASIS_COORDINATES_CONTINUOUS) THEN
    ASM_REWRITE_TAC [REAL_LT_INV_EQ] THEN
    ANTS_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [SUBSET, IN_INTER, IMP_CONJ_ALT] THEN
    ASM_SIMP_TAC [SPAN_FINITE, LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN
    GEN_TAC THEN X_GEN_TAC (← q r"u:real^N->real") THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [IN_BALL, dist] THEN
    EXPAND_TAC "a" THEN ASM_SIMP_TAC [← GSYM VSUM_SUB] THEN
    DISCH_THEN (fun th => FIRST_X_ASSUM MATCH_MP_TAC THEN MP_TAC th) THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_RDISTRIB] THEN
    DISCH_THEN (fun th => FIRST_X_ASSUM (MP_TAC o C MATCH_MP th)) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"abs(x - y) < x <=> &0 < y /\ abs(y) < &2 * x")] THEN
    SIMP_TAC [REAL_LT_IMP_LE] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"&(CARD(b:real^N->bool)) * &2 * inv(&2 * &n + &1)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_BOUND THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"abs x < a ==> x <= a")],
      ASM_REWRITE_TAC [REAL_MUL_ASSOC] THEN REWRITE_TAC [← GSYM real_div] THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &2 * &n + &1")] THEN
      REAL_ARITH_TAC])

  let AFF_DIM_NONEMPTY_INTERIOR_OF_EQ ← prove
   r"!u s:real^N->bool.
        convex s /\ affine u /\ s SUBSET u
        ==> (aff_dim s = aff_dim u <=>
             s = {} /\ u = {} \/
             ~((subtopology euclidean u) interior_of s = {}))"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"u:real^N->bool = {}") THEN
    ASM_SIMP_TAC [SUBSET_EMPTY] THEN REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [AFF_DIM_NONEMPTY_INTERIOR_OF]] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_MESON_TAC [AFF_DIM_EQ_MINUS1], ALL_TAC] THEN
    ASM_SIMP_TAC [AFF_DIM_EQ_FULL_GEN, HULL_P] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← GSYM RELATIVE_INTERIOR_INTERIOR_OF] THEN
    ASM_SIMP_TAC [RELATIVE_INTERIOR_EQ_EMPTY])

  let RELATIVE_INTERIOR_INTERIOR ← prove
   r"!s. affine hull s = (:real^N)
       ==> relative_interior s = interior s"
   (SIMP_TAC [relative_interior, interior, SUBTOPOLOGY_UNIV, OPEN_IN])

  let RELATIVE_INTERIOR_OPEN ← prove
   r"!s:real^N->bool. open s ==> relative_interior s = s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [RELATIVE_INTERIOR_EMPTY] THEN
    ASM_SIMP_TAC [RELATIVE_INTERIOR_INTERIOR, AFFINE_HULL_OPEN, INTERIOR_EQ])

  let RELATIVE_INTERIOR_NONEMPTY_INTERIOR ← prove
   r"!s. ~(interior s = {}) ==> relative_interior s = interior s"
   (MESON_TAC [RELATIVE_INTERIOR_INTERIOR, AFFINE_HULL_NONEMPTY_INTERIOR])

  let RELATIVE_FRONTIER_NONEMPTY_INTERIOR ← prove
   r"!s. ~(interior s = {}) ==> relative_frontier s = frontier s"
   (SIMP_TAC [relative_frontier, frontier, RELATIVE_INTERIOR_NONEMPTY_INTERIOR])

  let RELATIVE_FRONTIER_FRONTIER ← prove
   r"!s. affine hull s = (:real^N) ==> relative_frontier s = frontier s"
   (SIMP_TAC [relative_frontier, frontier, RELATIVE_INTERIOR_INTERIOR])

  let RELATIVE_FRONTIER_OPEN ← prove
   r"!s:real^N->bool. open s ==> relative_frontier s = frontier s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [FRONTIER_EMPTY, RELATIVE_FRONTIER_EMPTY] THEN
    MATCH_MP_TAC RELATIVE_FRONTIER_NONEMPTY_INTERIOR THEN
    ASM_SIMP_TAC [INTERIOR_OPEN])

  let AFFINE_HULL_CONVEX_HULL ← prove
   r"!s. affine hull (convex hull s) = affine hull s"
   (GEN_TAC THEN MATCH_MP_TAC HULL_UNIQUE THEN
    REWRITE_TAC [AFFINE_AFFINE_HULL, CONVEX_HULL_SUBSET_AFFINE_HULL] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HULL_MINIMAL THEN
    ASM_MESON_TAC [SUBSET_TRANS, HULL_SUBSET])

  return { CONIC_HULL_EQ_SPAN_EQ, OPEN_IN_SUBSET_RELATIVE_INTERIOR,
           RELATIVE_INTERIOR_TRANSLATION, RELATIVE_FRONTIER_TRANSLATION,
           RELATIVE_INTERIOR_INJECTIVE_LINEAR_IMAGE, RELATIVE_FRONTIER_INJECTIVE_LINEAR_IMAGE,
           RELATIVE_INTERIOR_RELATIVE_INTERIOR, RELATIVE_INTERIOR_EQ_EMPTY,
           AFF_DIM_NONEMPTY_INTERIOR_OF_EQ, RELATIVE_INTERIOR_INTERIOR, RELATIVE_INTERIOR_OPEN,
           RELATIVE_INTERIOR_NONEMPTY_INTERIOR, RELATIVE_FRONTIER_NONEMPTY_INTERIOR,
           RELATIVE_FRONTIER_FRONTIER, RELATIVE_FRONTIER_OPEN, AFFINE_HULL_CONVEX_HULL }

/- ------------------------------------------------------------------------- -/
/- Relative interior of a set (part 3).  (convex.ml 11635-11840)             -/
/- ------------------------------------------------------------------------- -/

structure RIC where
  INTERIOR_SIMPLEX_NONEMPTY : thm
  INTERIOR_SUBSET_RELATIVE_INTERIOR : thm
  RELATIVE_FRONTIER_SUBSET_FRONTIER : thm
  CONVEX_RELATIVE_INTERIOR : thm
  IN_RELATIVE_INTERIOR_CONVEX_SHRINK : thm
  IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK : thm
  IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT : thm
  INTER_RELATIVE_FRONTIER_CONIC_HULL : thm
  deriving Inhabited

@[nospecialize]
def setupRIC [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BCON : CON) (BCVH : CVH)
    (BCLH : CLH) (BRIA : RIA) (BRIB : RIB) : ExceptT String IO RIC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        VECTOR_ARITH, VECTOR_ARITH_TAC, NORM_ARITH, NORM_ARITH_TAC, .. } := D
  let { EQ_IMP, FORALL_IN_GSPEC, .. } := D.core1
  let { HAS_SIZE, IMP_CONJ_ALT, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNION, LE_REFL, MEMBER_NOT_EMPTY, MONO_AND,
        MONO_EXISTS, NOT_INSERT_EMPTY, REAL_ABS_DIV, REAL_DIV_LMUL, .. } := D.core3
  let { REAL_INV_LT_1, REAL_LE_LT, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_IMP_NZ,
        REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ, REAL_LT_MIN, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, REAL_LT_TOTAL, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RINV, REAL_MUL_RZERO,
        REAL_SUB_LE, REAL_SUB_LT, REAL_SUB_RDISTRIB, REAL_SUB_REFL, SUBSET, SUBSET_ANTISYM_EQ,
        SUBSET_INTER, SUBSET_TRANS, .. } := D.core5
  let { SUBSET_UNIV, real_abs, real_div, .. } := D.core6
  let { HULL_INC, HULL_SUBSET, .. } := D.misc
  let { CARD_GE_DIM_INDEPENDENT, DIM_UNIV, .. } := D.vec1
  let { NORM_0, .. } := D.vec2
  let { NORM_MUL, NORM_SUB, SPAN_MONO, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_SUB_LDISTRIB, VECTOR_SUB_REFL, dist, .. } :=
    D.vec4
  let { CENTRE_IN_BALL, CLOSURE_EQ, .. } := D.top1
  let { IN_BALL, IN_INTERIOR, IN_SEGMENT, LIMPT_APPROACHABLE, .. } := D.top4
  let { SUBSET_CLOSURE, closure, frontier, .. } := D.top5
  let { AFFINE_ALT, AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { convex, CONVEX_ALT, .. } := BCVX
  let { CONIC_HULL_EXPLICIT, .. } := BCON
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EQ_EMPTY, .. } := BCVH
  let { AFFINE_HULL_EQ_SPAN, CLOSED_AFFINE_HULL, .. } := BCLH
  let { relative_frontier, IN_RELATIVE_INTERIOR, .. } := BRIA
  let { RELATIVE_INTERIOR_EQ_EMPTY, RELATIVE_INTERIOR_INTERIOR, AFFINE_HULL_CONVEX_HULL, .. } :=
    BRIB
  -- @@SCOPE END

  let INTERIOR_SIMPLEX_NONEMPTY ← prove
   r"!s:real^N->bool.
        independent s /\ s HAS_SIZE (dimindex(:N))
        ==> ?a. a IN interior(convex hull (vec 0 INSERT s))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"convex hull (vec 0 INSERT s):real^N->bool")
      RELATIVE_INTERIOR_EQ_EMPTY) THEN
    ASM_SIMP_TAC [AFFINE_HULL_CONVEX_HULL] THEN
    REWRITE_TAC [CONVEX_HULL_EQ_EMPTY, CONVEX_CONVEX_HULL, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC RELATIVE_INTERIOR_INTERIOR THEN
    SIMP_TAC [AFFINE_HULL_EQ_SPAN, IN_INSERT, HULL_INC] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ s = UNIV ==> t = UNIV")) THEN
    EXISTS_TAC (← q r"span s:real^N->bool") THEN CONJ_TAC THENL
     [MATCH_MP_TAC SPAN_MONO THEN MATCH_MP_TAC (← SET_RULE
       (← q r"(a INSERT s) SUBSET P hull (a INSERT s)
        ==> s SUBSET P hull (a INSERT s)")) THEN REWRITE_TAC [HULL_SUBSET],
      MATCH_MP_TAC (← SET_RULE (← q r"UNIV SUBSET s ==> s = UNIV")) THEN
      MATCH_MP_TAC CARD_GE_DIM_INDEPENDENT THEN
      ASM_REWRITE_TAC [DIM_UNIV, SUBSET_UNIV] THEN
      ASM_MESON_TAC [LE_REFL, HAS_SIZE]])

  let INTERIOR_SUBSET_RELATIVE_INTERIOR ← prove
   r"!s. interior s SUBSET relative_interior s"
   (REWRITE_TAC [SUBSET, IN_INTERIOR, IN_RELATIVE_INTERIOR, IN_INTER] THEN
    MESON_TAC [CENTRE_IN_BALL])

  let RELATIVE_FRONTIER_SUBSET_FRONTIER ← prove
   r"!s:real^N->bool. relative_frontier s SUBSET frontier s"
   (GEN_TAC THEN REWRITE_TAC [relative_frontier, frontier] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET_RELATIVE_INTERIOR) THEN
    SET_TAC [])

  let CONVEX_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool. convex s ==> convex(relative_interior s)"
   (REWRITE_TAC [CONVEX_ALT, IN_RELATIVE_INTERIOR, IN_INTER,
                 SUBSET, IN_BALL, dist] THEN
    GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [← TAUT (← q r"(a /\ b) /\ (c /\ d) /\ e ==> f <=>
                      a /\ c /\ e ==> b /\ d ==> f")] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC (← MESON [] (← q r"(!d e. P d /\ Q e ==> R(min d e))
                          ==> (?e. P e) /\ (?e. Q e) ==> (?e. R e)")) THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    X_GEN_TAC (← q r"z:real^N") THEN STRIP_TAC THEN
    SUBST1_TAC (← VECTOR_ARITH (← q r"z:real^N =
     (&1 - u) % (z - u % (y - x)) + u % (z + (&1 - u) % (y - x))")) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN MATCH_MP_TAC MONO_AND THEN
    CONJ_TAC THEN DISCH_THEN MATCH_MP_TAC THEN
    (CONJ_TAC THENL
      [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
        (← q r"norm x < e ==> norm x = y ==> y < e"))) THEN
       AP_TERM_TAC THEN VECTOR_ARITH_TAC,
       REWRITE_TAC [← VECTOR_ARITH (← q r"a - b % c:real^N = a + --b % c")] THEN
       MATCH_MP_TAC IN_AFFINE_ADD_MUL_DIFF THEN
       ASM_SIMP_TAC [AFFINE_AFFINE_HULL, HULL_INC]]))

  let IN_RELATIVE_INTERIOR_CONVEX_SHRINK ← prove
   r"!s e x c:real^N.
     convex s /\ c IN relative_interior s /\
     x IN s /\ &0 < e /\ e <= &1
     ==> x - e % (x - c) IN relative_interior s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR]) THEN
    REWRITE_TAC [IN_RELATIVE_INTERIOR, SUBSET, IN_INTER, IN_BALL, dist] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN CONJ_TAC THENL
     [REWRITE_TAC [← VECTOR_ARITH
       (← q r"x - e % (x - c):real^N = (&1 - e) % x + e % c")] THEN
      FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [convex]) THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    EXISTS_TAC (← q r"e * d:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    X_GEN_TAC (← q r"y':real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(&1 / e) % y' - ((&1 - e) / e) % x:real^N")) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [UNDISCH_TAC (← q r"norm (x - e % (x - c) - y':real^N) < e * d") THEN
        SUBGOAL_THEN (← q r"x - e % (x - c) - y':real^N =
                      e % (c - (&1 / e % y' - (&1 - e) / e % x))")
        SUBST1_TAC THENL
         [ASM_SIMP_TAC [VECTOR_SUB_LDISTRIB, VECTOR_MUL_ASSOC,
                        REAL_DIV_LMUL, REAL_LT_IMP_NZ] THEN VECTOR_ARITH_TAC,
          ASM_SIMP_TAC [NORM_MUL, REAL_LT_LMUL_EQ, real_abs, REAL_LT_IMP_LE]],
        REWRITE_TAC [real_div, REAL_SUB_RDISTRIB] THEN
        ASM_SIMP_TAC [REAL_MUL_RINV, REAL_LT_IMP_NZ] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"a % y - (b - c) % x:real^N =
                                  (c - b) % x + a % y")] THEN
        MATCH_MP_TAC (← REWRITE_RULE [AFFINE_ALT] AFFINE_AFFINE_HULL) THEN
        ASM_SIMP_TAC [HULL_INC]],
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"y' = (&1 - (&1 - e)) % (&1 / e % y' - (&1 - e) / e % x) +
                         (&1 - e) % x:real^N")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [← REAL_ARITH (← q r"&1 - (&1 - e) = e"), VECTOR_SUB_LDISTRIB,
                      VECTOR_MUL_ASSOC, REAL_DIV_LMUL, REAL_LT_IMP_NZ] THEN
        VECTOR_ARITH_TAC,
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONVEX_ALT]) THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC]])

  let IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK ← prove
   r"!s e x c:real^N.
     convex s /\ c IN relative_interior s /\
     x IN closure s /\ &0 < e /\ e <= &1
     ==> x - e % (x - c) IN relative_interior s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"?y:real^N. y IN s /\ norm(y - x) * (&1 - e) < e * d")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"(x:real^N) IN s") THENL
       [EXISTS_TAC (← q r"x:real^N") THEN
        ASM_SIMP_TAC [REAL_LT_MUL, VECTOR_SUB_REFL, NORM_0, REAL_MUL_LZERO],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [closure]) THEN
      ASM_REWRITE_TAC [IN_UNION, IN_ELIM_THM, LIMPT_APPROACHABLE, dist] THEN
      FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
       (← q r"e <= &1 ==> e = &1 \/ e < &1"))) THEN
      ASM_SIMP_TAC [REAL_SUB_REFL, ← GSYM REAL_LT_RDIV_EQ, REAL_SUB_LT] THENL
       [DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN
        REWRITE_TAC [REAL_MUL_RZERO, REAL_LT_01],
        DISCH_THEN (MP_TAC o SPEC (← q r"(e * d) / (&1 - e)"))] THEN
      ASM_SIMP_TAC [REAL_LT_RDIV_EQ, REAL_SUB_LT, REAL_MUL_LZERO, REAL_LT_MUL,
                    REAL_MUL_LID] THEN
      MATCH_MP_TAC MONO_EXISTS THEN MESON_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"z:real^N = c + ((&1 - e) / e) % (x - y)") THEN
    SUBGOAL_THEN (← q r"x - e % (x - c):real^N = y - e % (y - z)") SUBST1_TAC THENL
     [EXPAND_TAC "z" THEN
      REWRITE_TAC [VECTOR_SUB_LDISTRIB, VECTOR_ADD_LDISTRIB] THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_DIV_LMUL, REAL_LT_IMP_NZ] THEN
      VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC IN_RELATIVE_INTERIOR_CONVEX_SHRINK THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"dist(c:real^N,z) < d") ASSUME_TAC THENL
     [EXPAND_TAC "z" THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(c:real^N,c + x) = norm x")] THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_DIV] THEN ONCE_REWRITE_TAC [NORM_SUB] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a / b * c:real = (c * a) / b")] THEN
      ASM_SIMP_TAC [real_abs, REAL_SUB_LE, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(z:real^N) IN affine hull s") ASSUME_TAC THENL
     [EXPAND_TAC "z" THEN MATCH_MP_TAC IN_AFFINE_ADD_MUL_DIFF THEN
      ASM_SIMP_TAC [AFFINE_AFFINE_HULL, HULL_INC] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"!t. x IN t /\ t = s ==> x IN s")) THEN
      EXISTS_TAC (← q r"closure(affine hull s):real^N->bool") THEN
      SIMP_TAC [CLOSURE_EQ, CLOSED_AFFINE_HULL] THEN
      ASM_MESON_TAC [SUBSET_CLOSURE, HULL_INC, SUBSET],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [IN_RELATIVE_INTERIOR] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [IN_BALL, IN_INTER, SUBSET], ALL_TAC] THEN
    EXISTS_TAC (← q r"d - dist(c:real^N,z)") THEN ASM_REWRITE_TAC [REAL_SUB_LT] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS)) THEN
    REWRITE_TAC [SUBSET, IN_INTER] THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"dist(c:real^N,z) < d") THEN REWRITE_TAC [IN_BALL] THEN
    NORM_ARITH_TAC)

  let IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT ← prove
   r"!s a b:real^N.
        convex s /\ a IN relative_interior s /\ b IN closure s
        ==> segment(a,b) SUBSET relative_interior s"
   (REWRITE_TAC [SUBSET, IN_SEGMENT] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
     (← q r"(&1 - u) % a + u % b:real^N = b - (&1 - u) % (b - a)")] THEN
    MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let INTER_RELATIVE_FRONTIER_CONIC_HULL ← prove
   r"!s t:real^N->bool.
     convex s /\ vec 0 IN relative_interior s /\ t SUBSET relative_frontier s
     ==> t = relative_frontier s INTER conic hull t"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET_INTER, HULL_SUBSET] THEN
    REWRITE_TAC [SUBSET, IN_INTER, CONIC_HULL_EXPLICIT, IMP_CONJ_ALT] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^N"] THEN
    ASM_CASES_TAC (← q r"c = &0") THENL
     [ASM_REWRITE_TAC [relative_frontier, IN_DIFF, VECTOR_MUL_LZERO],
      ASM_REWRITE_TAC [REAL_LE_LT]] THEN
    REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
     (← ISPECL [← q r"c:real", ← q r"&1"] REAL_LT_TOTAL) THEN
    ASM_SIMP_TAC [VECTOR_MUL_LID] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"F ==> p")) THEN MP_TAC (← ISPECL
     [← q r"s:real^N->bool", ← q r"vec 0:real^N"]
     IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
    ASM_REWRITE_TAC [] THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")),
      DISCH_THEN (MP_TAC o SPEC (← q r"c % x:real^N"))] THEN
    (ANTS_TAC THENL
      [ASM_MESON_TAC [relative_frontier, IN_DIFF, SUBSET], ALL_TAC]) THEN
    REWRITE_TAC [SUBSET, IN_SEGMENT, VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"P /\ (?u. &0 < u /\ u < &1 /\ ~Q(u % y))
      ==> ~(!x. P /\ (?u. &0 < u /\ u < &1 /\ x = u % y) ==> Q x)")) THEN
    (CONJ_TAC THENL [ASM_MESON_TAC [relative_frontier, IN_DIFF, SUBSET], ALL_TAC])
    THENL [EXISTS_TAC (← q r"c:real"), EXISTS_TAC (← q r"inv c:real")] THEN
    ASM_SIMP_TAC [REAL_LT_INV_EQ, REAL_INV_LT_1, VECTOR_MUL_ASSOC,
                  VECTOR_MUL_LID, REAL_MUL_LINV] THEN
    ASM_MESON_TAC [relative_frontier, IN_DIFF, SUBSET])

  return { INTERIOR_SIMPLEX_NONEMPTY, INTERIOR_SUBSET_RELATIVE_INTERIOR,
           RELATIVE_FRONTIER_SUBSET_FRONTIER, CONVEX_RELATIVE_INTERIOR,
           IN_RELATIVE_INTERIOR_CONVEX_SHRINK, IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK,
           IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, INTER_RELATIVE_FRONTIER_CONIC_HULL }

/- ------------------------------------------------------------------------- -/
/- Relative interior of a set (part 4).  (convex.ml 11840-12058)             -/
/- ------------------------------------------------------------------------- -/

structure RID where
  INTER_CONVEX_HULL_INSERT_RELATIVE_EXTERIOR : thm
  CONVEX_OPEN_SEGMENT_CASES : thm
  CONVEX_OPEN_SEGMENT_CASES_ALT : thm
  EXTEND_CONVEX_RELATIVE_FRONTIER_SEGMENT : thm
  SEGMENT_SUBSET_RELATIVE_FRONTIER_CONVEX : thm
  EXTEND_CONVEX_FRONTIER_SEGMENT : thm
  RELATIVE_INTERIOR_SING : thm
  RELATIVE_FRONTIER_SING : thm
  RELATIVE_INTERIOR_CBALL : thm
  RELATIVE_INTERIOR_BALL : thm
  RELATIVE_FRONTIER_CBALL : thm
  RELATIVE_FRONTIER_BALL : thm
  DIFFERENT_NORM_3_COLLINEAR_POINTS : thm
  OPEN_SEGMENT_SUBSET_BALL : thm
  deriving Inhabited

@[nospecialize]
def setupRID [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVB : CVB) (BCVH : CVH) (BMCG : MCG)
    (BSTL : STL) (BSHR : SHR) (BRIA : RIA) (BRIB : RIB) (BRIC : RIC) :
    ExceptT String IO RID := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_RING, SET_RULE, SET_TAC, VECTOR_ARITH,
        GEOM_ORIGIN_TAC, .. } := D
  let { DE_MORGAN_THM, DIFF_EMPTY, EMPTY_SUBSET, .. } := D.core1
  let { INSERT_SUBSET, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_SING, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_IMP_LE, REAL_LT_IMP_NE, .. } := D.core4
  let { REAL_NOT_LT, SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core5
  let { UNIONS_GSPEC, UNION_SUBSET, .. } := D.core6
  let { HULL_MINIMAL, HULL_MONO, .. } := D.misc
  let { DOT_EQ_0, DOT_LMUL, DOT_RMUL, .. } := D.vec1
  let { NORM_EQ, .. } := D.vec2
  let { VECTOR_SUB_EQ, .. } := D.vec4
  let { BALL_EMPTY, BALL_EQ_EMPTY, CBALL_EMPTY, CBALL_SING, CLOSURE_BALL, .. } := D.top1
  let { CLOSURE_SING, CLOSURE_SUBSET, .. } := D.top2
  let { FRONTIER_BALL, FRONTIER_CBALL, .. } := D.top3
  let { INTERIOR_CBALL, INTERIOR_OPEN, IN_BALL_0, IN_CBALL_0, IN_SPHERE_0,
        MIDPOINT_IN_SEGMENT, OPEN_BALL, .. } := D.top4
  let { OPEN_SEGMENT_ALT, SEGMENT_CLOSED_OPEN, SEGMENT_REFL, SEGMENT_SYM, SPHERE_EMPTY,
        frontier, segment, .. } := D.top5
  let { CONVEX_CONTAINS_OPEN_SEGMENT, CONVEX_SING, .. } := BCVX
  let { CONVEX_BALL, .. } := BCVB
  let { CONVEX_HULL_INSERT_SEGMENTS, .. } := BCVH
  let { CONVEX_CLOSURE, .. } := BMCG
  let { UNION_SEGMENT, .. } := BSTL
  let { IN_INTERIOR_CLOSURE_CONVEX_SEGMENT, .. } := BSHR
  let { relative_frontier, RELATIVE_INTERIOR_EMPTY, RELATIVE_FRONTIER_EMPTY,
        RELATIVE_INTERIOR_SUBSET, .. } := BRIA
  let { RELATIVE_INTERIOR_EQ_EMPTY, RELATIVE_INTERIOR_OPEN,
        RELATIVE_INTERIOR_NONEMPTY_INTERIOR, RELATIVE_FRONTIER_NONEMPTY_INTERIOR, .. } := BRIB
  let { IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, .. } := BRIC
  -- @@SCOPE END

  let INTER_CONVEX_HULL_INSERT_RELATIVE_EXTERIOR ← prove
   r"!c t s z:real^N.
        convex c /\ t SUBSET c /\ z IN relative_interior c /\
        DISJOINT s (relative_interior c)
        ==> s INTER (convex hull (z INSERT t)) =
            s INTER (convex hull t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    SIMP_TAC [HULL_MONO, ← SET_RULE (← q r"s SUBSET a INSERT s"),
              ← SET_RULE (← q r"t SUBSET u ==> s INTER t SUBSET s INTER u")] THEN
    REWRITE_TAC [CONVEX_HULL_INSERT_SEGMENTS, SUBSET] THEN
    X_GEN_TAC (← q r"x:real^N") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [IN_INTER, UNIONS_GSPEC, IN_ELIM_THM] THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"c:real^N->bool", ← q r"z:real^N", ← q r"y:real^N"]
          IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [SUBSET] CLOSURE_SUBSET) THEN
      ASM_MESON_TAC [HULL_MINIMAL, SUBSET],
      REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ONCE_REWRITE_TAC [segment] THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN ASM SET_TAC []])

  let CONVEX_OPEN_SEGMENT_CASES ← prove
   r"!s a b:real^N.
        convex s /\ a IN closure s /\ b IN closure s
        ==> segment(a,b) SUBSET relative_frontier s \/
            segment(a,b) SUBSET relative_interior s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [relative_frontier] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET c /\ (!a. a IN i /\ a IN s ==> s SUBSET i)
      ==> s SUBSET c DIFF i \/ s SUBSET i")) THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [CONVEX_CONTAINS_OPEN_SEGMENT, CONVEX_CLOSURE],
      X_GEN_TAC (← q r"c:real^N") THEN ONCE_REWRITE_TAC [segment]] THEN
    REWRITE_TAC [IN_DIFF, IN_INSERT, DE_MORGAN_THM, NOT_IN_EMPTY] THEN
    STRIP_TAC THEN FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP UNION_SEGMENT) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"c:real^N"]
          IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"b:real^N") th) THEN
            MP_TAC (← SPEC (← q r"a:real^N") th))) THEN
    ASM_REWRITE_TAC [SEGMENT_SYM, ← CONJUNCT2 segment] THEN ASM SET_TAC [])

  let CONVEX_OPEN_SEGMENT_CASES_ALT ← prove
   r"!s a b:real^N.
         convex s /\ a IN closure s /\ b IN closure s
         ==> segment (a,b) SUBSET frontier s \/
             segment (a,b) SUBSET interior s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"interior s:real^N->bool = {}") THENL
     [DISJ1_TAC THEN ASM_REWRITE_TAC [frontier, DIFF_EMPTY] THEN
      ASM_MESON_TAC [CONVEX_CONTAINS_OPEN_SEGMENT, CONVEX_CLOSURE],
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N", ← q r"b:real^N"]
          CONVEX_OPEN_SEGMENT_CASES) THEN
      ASM_SIMP_TAC [RELATIVE_INTERIOR_NONEMPTY_INTERIOR,
                    RELATIVE_FRONTIER_NONEMPTY_INTERIOR]])

  let EXTEND_CONVEX_RELATIVE_FRONTIER_SEGMENT ← prove
   r"!s a b x:real^N.
        convex s /\ a IN closure s /\ b IN closure s /\
        x IN segment(a,b) /\ x IN relative_frontier s
        ==> segment[a,b] SUBSET relative_frontier s"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN relative_interior s") THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N", ← q r"b:real^N"]
          IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [relative_frontier, IN_DIFF, SUBSET],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"(b:real^N) IN relative_interior s") THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"b:real^N", ← q r"a:real^N"]
          IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
      ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [relative_frontier, IN_DIFF, SUBSET, SEGMENT_SYM],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [SEGMENT_CLOSED_OPEN, UNION_SUBSET, INSERT_SUBSET,
                     EMPTY_SUBSET] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N", ← q r"b:real^N"]
      CONVEX_OPEN_SEGMENT_CASES) THEN
    ASM_SIMP_TAC [] THEN ASM_MESON_TAC [relative_frontier, IN_DIFF, SUBSET])

  let SEGMENT_SUBSET_RELATIVE_FRONTIER_CONVEX ← prove
   r"!s a b c:real^N.
        convex s /\ c IN segment(a,b) /\ {a,b,c} SUBSET relative_frontier s
        ==> segment[a,b] SUBSET relative_frontier s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC EXTEND_CONVEX_RELATIVE_FRONTIER_SEGMENT THEN
    EXISTS_TAC (← q r"c:real^N") THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") relative_frontier) THEN ASM SET_TAC [])

  let EXTEND_CONVEX_FRONTIER_SEGMENT ← prove
   r"!s a b x:real^N.
        convex s /\ a IN closure s /\ b IN closure s /\
        x IN segment(a,b) /\ x IN frontier s
        ==> segment[a,b] SUBSET frontier s"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN interior s") THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N", ← q r"b:real^N"]
          IN_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [frontier, IN_DIFF, SUBSET],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"(b:real^N) IN interior s") THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"b:real^N", ← q r"a:real^N"]
          IN_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
      ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [frontier, IN_DIFF, SUBSET, SEGMENT_SYM],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [SEGMENT_CLOSED_OPEN, UNION_SUBSET, INSERT_SUBSET,
                     EMPTY_SUBSET] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N", ← q r"b:real^N"]
      CONVEX_OPEN_SEGMENT_CASES_ALT) THEN
    ASM_SIMP_TAC [] THEN ASM_MESON_TAC [frontier, IN_DIFF, SUBSET])

  let RELATIVE_INTERIOR_SING ← prove
   r"!a. relative_interior {a} = {a}"
   (GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET {a} /\ ~(s = {}) ==> s = {a}")) THEN
    SIMP_TAC [RELATIVE_INTERIOR_SUBSET, RELATIVE_INTERIOR_EQ_EMPTY,
              CONVEX_SING] THEN
    SET_TAC [])

  let RELATIVE_FRONTIER_SING ← prove
   r"!a:real^N. relative_frontier {a} = {}"
   (REWRITE_TAC [relative_frontier, RELATIVE_INTERIOR_SING, CLOSURE_SING] THEN
    SET_TAC [])

  let RELATIVE_INTERIOR_CBALL ← prove
   r"!a r. relative_interior(cball(a,r)) = if r = &0 then {a} else ball(a,r)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [REAL_LT_IMP_NE, CBALL_EMPTY, BALL_EMPTY,
                  RELATIVE_INTERIOR_EMPTY, REAL_LT_IMP_LE] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [CBALL_SING, RELATIVE_INTERIOR_SING] THEN
    REWRITE_TAC [← GSYM INTERIOR_CBALL] THEN
    MATCH_MP_TAC RELATIVE_INTERIOR_NONEMPTY_INTERIOR THEN
    ASM_REWRITE_TAC [INTERIOR_CBALL, BALL_EQ_EMPTY] THEN ASM_REAL_ARITH_TAC)

  let RELATIVE_INTERIOR_BALL ← prove
   r"!a r. relative_interior(ball(a,r)) = ball(a,r)"
   (SIMP_TAC [RELATIVE_INTERIOR_OPEN, OPEN_BALL])

  let RELATIVE_FRONTIER_CBALL ← prove
   r"!a:real^N r. relative_frontier(cball(a,r)) =
                if r = &0 then {} else sphere(a,r)"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [CBALL_SING, RELATIVE_FRONTIER_SING] THEN
    ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [CBALL_EMPTY, SPHERE_EMPTY, RELATIVE_FRONTIER_EMPTY] THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_SIMP_TAC [RELATIVE_FRONTIER_NONEMPTY_INTERIOR, INTERIOR_CBALL,
                  BALL_EQ_EMPTY, ← GSYM REAL_NOT_LT, FRONTIER_CBALL])

  let RELATIVE_FRONTIER_BALL ← prove
   r"!a:real^N r. relative_frontier(ball(a,r)) =
                if r = &0 then {} else sphere(a,r)"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [BALL_EMPTY, REAL_LE_REFL, RELATIVE_FRONTIER_EMPTY] THEN
    ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [BALL_EMPTY, REAL_LT_IMP_LE, SPHERE_EMPTY,
                  RELATIVE_FRONTIER_EMPTY] THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_SIMP_TAC [RELATIVE_FRONTIER_NONEMPTY_INTERIOR, INTERIOR_OPEN, OPEN_BALL,
                  BALL_EQ_EMPTY, ← GSYM REAL_NOT_LT, FRONTIER_BALL])

  let DIFFERENT_NORM_3_COLLINEAR_POINTS ← prove
   r"!a b x:real^N.
     ~(x IN segment(a,b) /\ norm(a) = norm(b) /\ norm(x) = norm(b))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_SIMP_TAC [SEGMENT_REFL, NOT_IN_EMPTY, OPEN_SEGMENT_ALT] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN DISCH_THEN
     (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) MP_TAC) THEN
    ASM_REWRITE_TAC [NORM_EQ] THEN REWRITE_TAC [← VECTOR_ARITH
     (← q r"(x + y:real^N) dot (x + y) = x dot x + &2 * x dot y + y dot y")] THEN
    REWRITE_TAC [DOT_LMUL, DOT_RMUL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (ASSUME_TAC o SYM) MP_TAC) THEN
    UNDISCH_TAC (← q r"~(a:real^N = b)") THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM VECTOR_SUB_EQ] THEN
    REWRITE_TAC [← GSYM DOT_EQ_0, ← VECTOR_ARITH
     (← q r"(a - b:real^N) dot (a - b) = a dot a + b dot b - &2 * a dot b")] THEN
    ASM_REWRITE_TAC [← REAL_RING (← q r"a + a - &2 * ab = &0 <=> ab = a")] THEN
    SIMP_TAC [← REAL_RING
     (← q r"(&1 - u) * (&1 - u) * a + &2 * (&1 - u) * u * x + u * u * a = a <=>
      x = a \/ u = &0 \/ u = &1")] THEN
    ASM_REAL_ARITH_TAC)

  let OPEN_SEGMENT_SUBSET_BALL ← prove
   r"!a r u v:real^N.
      u IN cball(a,r) /\ v IN cball(a,r) ==> segment(u,v) SUBSET ball(a,r)"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"u:real^N = v") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, EMPTY_SUBSET] THEN
    ASM_CASES_TAC (← q r"r < &0") THEN ASM_SIMP_TAC [CBALL_EMPTY, NOT_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN ASM_SIMP_TAC [CBALL_SING, IN_SING] THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, STRIP_TAC] THEN
    ASM_CASES_TAC (← q r"u IN ball(vec 0:real^N,r)") THENL
     [MP_TAC (← ISPECL [← q r"ball(vec 0:real^N,r)", ← q r"u:real^N", ← q r"v:real^N"]
        IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
      ASM_SIMP_TAC [CONVEX_BALL, RELATIVE_INTERIOR_BALL, CLOSURE_BALL],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"v IN ball(vec 0:real^N,r)") THENL
     [MP_TAC (← ISPECL [← q r"ball(vec 0:real^N,r)", ← q r"v:real^N", ← q r"u:real^N"]
        IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
      ASM_SIMP_TAC [CONVEX_BALL, RELATIVE_INTERIOR_BALL, CLOSURE_BALL] THEN
      REWRITE_TAC [SEGMENT_SYM],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"ball(vec 0:real^N,r)", ← q r"u:real^N", ← q r"v:real^N"]
          CONVEX_OPEN_SEGMENT_CASES) THEN
    ASM_SIMP_TAC [CLOSURE_BALL, CONVEX_BALL] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN
    ASM_REWRITE_TAC [RELATIVE_INTERIOR_BALL, RELATIVE_FRONTIER_BALL] THEN
    REWRITE_TAC [SUBSET] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"midpoint(u,v):real^N")) THEN
    ASM_REWRITE_TAC [MIDPOINT_IN_SEGMENT] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"u:real^N", ← q r"v:real^N", ← q r"midpoint(u,v):real^N"]
          DIFFERENT_NORM_3_COLLINEAR_POINTS) THEN
    ASM_REWRITE_TAC [MIDPOINT_IN_SEGMENT] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_SPHERE_0, IN_BALL_0, IN_CBALL_0]) THEN
    ASM_REAL_ARITH_TAC)

  return { INTER_CONVEX_HULL_INSERT_RELATIVE_EXTERIOR, CONVEX_OPEN_SEGMENT_CASES,
           CONVEX_OPEN_SEGMENT_CASES_ALT, EXTEND_CONVEX_RELATIVE_FRONTIER_SEGMENT,
           SEGMENT_SUBSET_RELATIVE_FRONTIER_CONVEX, EXTEND_CONVEX_FRONTIER_SEGMENT,
           RELATIVE_INTERIOR_SING, RELATIVE_FRONTIER_SING, RELATIVE_INTERIOR_CBALL,
           RELATIVE_INTERIOR_BALL, RELATIVE_FRONTIER_CBALL, RELATIVE_FRONTIER_BALL,
           DIFFERENT_NORM_3_COLLINEAR_POINTS, OPEN_SEGMENT_SUBSET_BALL }

/- ------------------------------------------------------------------------- -/
/- Relative interior of a set (part 5).  (convex.ml 12060-12269)             -/
/- ------------------------------------------------------------------------- -/

structure RIE where
  STARLIKE_CONVEX_TWEAK_BOUNDARY_POINTS : thm
  RELATIVE_INTERIOR_PROLONG : thm
  RELATIVE_INTERIOR_CONVEX_PROLONG : thm
  RELATIVE_INTERIOR_EQ_CLOSURE : thm
  RAY_TO_RELATIVE_FRONTIER : thm
  RAY_TO_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupRIE [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCOP : COP) (BCLH : CLH) (BADD : ADD)
    (BSTL : STL) (BRIA : RIA) (BRIB : RIB) (BRIC : RIC) : ExceptT String IO RIE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, NORM_ARITH, .. } := D
  let { CONTRAPOS_THM, EXTENSION, .. } := D.core1
  let { INF, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IMP, NOT_IN_EMPTY,
        REAL_ABS_DIV, REAL_DIV_RMUL, .. } := D.core3
  let { REAL_INV_LT_1, REAL_LE_LT, REAL_LTE_TRANS, REAL_LT_ADDR, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_RINV, REAL_NOT_LE, REAL_NOT_LT, SUBSET, .. } := D.core5
  let { HULL_INC, HULL_SUBSET, REAL_HALF, .. } := D.misc
  let { NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, VECTOR_SUB_RDISTRIB, .. } := D.vec4
  let { BOUNDED_SUBSET_BALL, CLOSED_SUBSET, CLOSURE_APPROACHABLE, CLOSURE_CLOSED,
        CLOSURE_EMPTY, CLOSURE_EQ, .. } := D.top1
  let { CLOSURE_SUBSET, CONNECTED_CLOPEN, .. } := D.top2
  let { IN_BALL, IN_CBALL, IN_SEGMENT, .. } := D.top4
  let { frontier, open_in, open_segment, .. } := D.top5
  let { AFFINE_EMPTY, AFFINE_AFFINE_HULL, AFFINE_HULL_EQ, IN_AFFINE_ADD_MUL,
        IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { CONVEX_CONNECTED, .. } := BCOP
  let { AFFINE_IMP_CONVEX, CLOSED_AFFINE, .. } := BCLH
  let { AFFINE_HULL_NONEMPTY_INTERIOR, .. } := BADD
  let { starlike, .. } := BSTL
  let { relative_frontier, RELATIVE_INTERIOR_EQ, RELATIVE_INTERIOR_EMPTY,
        RELATIVE_INTERIOR_AFFINE, OPEN_IN_RELATIVE_INTERIOR, RELATIVE_INTERIOR_SUBSET,
        IN_RELATIVE_INTERIOR_CBALL, .. } := BRIA
  let { RELATIVE_INTERIOR_EQ_EMPTY, RELATIVE_INTERIOR_NONEMPTY_INTERIOR, .. } := BRIB
  let { IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, .. } := BRIC
  -- @@SCOPE END

  let STARLIKE_CONVEX_TWEAK_BOUNDARY_POINTS ← prove
   r"!s t:real^N->bool.
        convex s /\ ~(s = {}) /\
        relative_interior s SUBSET t /\ t SUBSET closure s
        ==> starlike t"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(relative_interior s:real^N->bool = {})") MP_TAC THENL
     [ASM_SIMP_TAC [RELATIVE_INTERIOR_EQ_EMPTY], REWRITE_TAC [starlike]] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"a:real^N") THEN
    REPEAT STRIP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"a IN s /\ b IN s /\ segment[a,b] DIFF {a,b} SUBSET s
      ==> segment[a:real^N,b] SUBSET s")) THEN
    ASM_REWRITE_TAC [← GSYM open_segment] THEN
    ASM_MESON_TAC [IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, SUBSET])

  let RELATIVE_INTERIOR_PROLONG ← prove
   r"!s x y:real^N.
        x IN relative_interior s /\ y IN s
        ==> ?t. &1 < t /\ (y + t % (x - y)) IN s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [IN_RELATIVE_INTERIOR_CBALL, IN_ELIM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"e:real")
    STRIP_ASSUME_TAC)) THEN
    ASM_CASES_TAC (← q r"y:real^N = x") THENL
     [ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"y + t % (x - x):real^N = y")] THEN
      EXISTS_TAC (← q r"&2") THEN CONV_TAC REAL_RAT_REDUCE_CONV,
      EXISTS_TAC (← q r"&1 + e / norm(x - y:real^N)") THEN
      ASM_SIMP_TAC [REAL_LT_ADDR, REAL_LT_DIV, NORM_POS_LT, VECTOR_SUB_EQ] THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"y + (&1 + e) % (x - y):real^N = x + e % (x - y)")] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [AFFINE_AFFINE_HULL, IN_INTER, IN_AFFINE_ADD_MUL_DIFF,
                    HULL_INC, IN_CBALL] THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(x:real^N,x + y) = norm y")] THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ] THEN
      ASM_REAL_ARITH_TAC])

  let RELATIVE_INTERIOR_CONVEX_PROLONG ← prove
   r"!s. convex s
       ==> relative_interior s =
           {x:real^N | x IN s /\
                       !y. y IN s ==> ?t. &1 < t /\ (y + t % (x - y)) IN s}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EQ_TAC THENL
     [SIMP_TAC [RELATIVE_INTERIOR_PROLONG] THEN
      MESON_TAC [SUBSET, RELATIVE_INTERIOR_SUBSET],
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"?y:real^N. y IN relative_interior s") STRIP_ASSUME_TAC THENL
       [ASM_SIMP_TAC [MEMBER_NOT_EMPTY, RELATIVE_INTERIOR_EQ_EMPTY] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN ANTS_TAC THENL
       [ASM_MESON_TAC [RELATIVE_INTERIOR_SUBSET, SUBSET], ALL_TAC] THEN
      ASM_CASES_TAC (← q r"y:real^N = x") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"y:real^N",
                        ← q r"y + t % (x - y):real^N"]
          IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [SUBSET, CLOSURE_SUBSET], ALL_TAC] THEN
      REWRITE_TAC [SUBSET] THEN DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [IN_SEGMENT, IN_ELIM_THM] THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"y:real^N = y + x <=> x = vec 0"),
        ← VECTOR_ARITH (← q r"(&1 - u) % y + u % (y + t % (x - y)):real^N =
                      y + t % u % (x - y)")] THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ] THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      EXISTS_TAC (← q r"inv t:real") THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, REAL_LT_INV_EQ,
        REAL_INV_LT_1, REAL_LT_IMP_NZ, ← REAL_ARITH (← q r"&1 < x ==> &0 < x")] THEN
      VECTOR_ARITH_TAC])

  let RELATIVE_INTERIOR_EQ_CLOSURE ← prove
   r"!s:real^N->bool.
        relative_interior s = closure s <=> affine s"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [RELATIVE_INTERIOR_EMPTY, CLOSURE_EMPTY, AFFINE_EMPTY] THEN
    EQ_TAC THEN
    SIMP_TAC [RELATIVE_INTERIOR_AFFINE, CLOSURE_CLOSED, CLOSED_AFFINE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"relative_interior s = closure s
      ==> relative_interior s SUBSET s /\ s SUBSET closure s
          ==> relative_interior s = s /\ closure s = s"))) THEN
    REWRITE_TAC [RELATIVE_INTERIOR_SUBSET, CLOSURE_SUBSET] THEN
    REWRITE_TAC [RELATIVE_INTERIOR_EQ, CLOSURE_EQ, ← GSYM AFFINE_HULL_EQ] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(s = {}) ==> s = {} \/ s = a ==> a = s"))) THEN
    MP_TAC (← ISPEC (← q r"affine hull s:real^N->bool") CONNECTED_CLOPEN) THEN
    SIMP_TAC [AFFINE_IMP_CONVEX, CONVEX_CONNECTED, AFFINE_AFFINE_HULL] THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CLOSED_SUBSET THEN ASM_REWRITE_TAC [HULL_SUBSET])

  let RAY_TO_RELATIVE_FRONTIER ← prove
   r"!s a l:real^N.
        bounded s /\ a IN relative_interior s /\
        (a + l) IN affine hull s /\ ~(l = vec 0)
        ==> ?d. &0 < d /\
                (a + d % l) IN relative_frontier s /\
                !e. &0 <= e /\ e < d ==> (a + e % l) IN relative_interior s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [relative_frontier] THEN
    MP_TAC (← ISPEC
     (← q r"{d | &0 < d /\ ~((a + d % l:real^N) IN relative_interior(s))}") INF) THEN
    ABBREV_TAC
     (← q r"d = inf {d | &0 < d /\ ~((a + d % l:real^N) IN relative_interior(s))}") THEN
    SUBGOAL_THEN
     (← q r"?e. &0 < e /\ !d. &0 <= d /\ d < e
                        ==> (a + d % l:real^N) IN relative_interior s")
     (X_CHOOSE_THEN (← q r"k:real") (LABEL_TAC "0"))
    THENL
     [MP_TAC (← ISPEC (← q r"s:real^N->bool") OPEN_IN_RELATIVE_INTERIOR) THEN
      REWRITE_TAC [open_in, ← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N") o CONJUNCT2) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"e / norm(l:real^N)") THEN
      ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT] THEN X_GEN_TAC (← q r"x:real") THEN
      STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
       [MATCH_MP_TAC IN_AFFINE_ADD_MUL THEN
        ASM_REWRITE_TAC [AFFINE_AFFINE_HULL] THEN
        ASM_MESON_TAC [SUBSET, HULL_SUBSET, RELATIVE_INTERIOR_SUBSET],
        REWRITE_TAC [← NORM_ARITH (← q r"dist(a + x:real^N,a) = norm x")] THEN
        ASM_SIMP_TAC [NORM_MUL, ← GSYM REAL_LT_RDIV_EQ, NORM_POS_LT] THEN
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL_NOT_LT, REAL_LT_IMP_LE]] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^N") o
         MATCH_MP BOUNDED_SUBSET_BALL) THEN
      REWRITE_TAC [SUBSET, IN_BALL] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"B / norm(l:real^N)") THEN
      ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT] THEN
      DISCH_THEN (MP_TAC o MATCH_MP
       (← REWRITE_RULE [SUBSET] RELATIVE_INTERIOR_SUBSET)) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV
       [← GSYM CONTRAPOS_THM]) THEN
      REWRITE_TAC [REAL_NOT_LT] THEN DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a:real^N,a + x) = norm x")] THEN
      ASM_SIMP_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM,
                    REAL_DIV_RMUL, NORM_EQ_0] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "1") (LABEL_TAC "2")) THEN
      EXISTS_TAC (← q r"d:real") THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LTE_TRANS THEN EXISTS_TAC (← q r"k:real") THEN
        ASM_MESON_TAC [REAL_NOT_LT, REAL_LT_IMP_LE],
        DISCH_TAC] THEN
      MATCH_MP_TAC (← TAUT (← q r"b /\ (b ==> a) ==> a /\ b")) THEN CONJ_TAC THENL
       [REWRITE_TAC [REAL_LE_LT] THEN
        ASM_MESON_TAC [← VECTOR_ARITH (← q r"a + &0 % l:real^N = a"),
                       REAL_NOT_LT, REAL_LT_IMP_LE],
        DISCH_TAC] THEN
      REWRITE_TAC [IN_DIFF] THEN CONJ_TAC THENL
       [REWRITE_TAC [CLOSURE_APPROACHABLE] THEN
        X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"a + (d - min d (x / &2 / norm(l:real^N))) % l") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC (← REWRITE_RULE [SUBSET] RELATIVE_INTERIOR_SUBSET) THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x /\ &0 < d ==> d - min d x < d")) THEN
          ASM_SIMP_TAC [REAL_HALF, REAL_LT_DIV, NORM_POS_LT],
          REWRITE_TAC [← NORM_ARITH (← q r"dist(a + x:real^N,a + y) = norm(x - y)")] THEN
          REWRITE_TAC [← GSYM VECTOR_SUB_RDISTRIB, NORM_MUL] THEN
          ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, NORM_POS_LT] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"&0 < x /\ x < y /\ &0 < d ==> abs((d - min d x) - d) < y")) THEN
          REWRITE_TAC [← REAL_ARITH (← q r"x / &2 / y < x / y <=> &0 < x / y")] THEN
          ASM_SIMP_TAC [REAL_HALF, REAL_LT_DIV, NORM_POS_LT]],
        DISCH_TAC THEN
        MP_TAC (← ISPEC (← q r"s:real^N->bool") OPEN_IN_RELATIVE_INTERIOR) THEN
        REWRITE_TAC [open_in, ← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a + d % l:real^N") o CONJUNCT2) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"e:real")
         (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "3"))) THEN
        REMOVE_THEN "2" (MP_TAC o SPEC (← q r"d + e / norm(l:real^N)")) THEN
        ASM_SIMP_TAC [NOT_IMP, ← REAL_ARITH (← q r"~(d + l <= d) <=> &0 < l"),
                      REAL_LT_DIV, NORM_POS_LT] THEN
        X_GEN_TAC (← q r"x:real") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [REAL_NOT_LE] THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"x < d") THEN ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
        REMOVE_THEN "3" MATCH_MP_TAC THEN CONJ_TAC THENL
         [MATCH_MP_TAC IN_AFFINE_ADD_MUL THEN
          ASM_REWRITE_TAC [AFFINE_AFFINE_HULL] THEN
          ASM_MESON_TAC [SUBSET, HULL_SUBSET, RELATIVE_INTERIOR_SUBSET],
          REWRITE_TAC [← NORM_ARITH (← q r"dist(a + x:real^N,a + y) = norm(x - y)")] THEN
          REWRITE_TAC [← GSYM VECTOR_SUB_RDISTRIB, NORM_MUL] THEN
          ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, NORM_POS_LT] THEN
          ASM_REAL_ARITH_TAC]]])

  let RAY_TO_FRONTIER ← prove
   r"!s a l:real^N.
        bounded s /\ a IN interior s /\ ~(l = vec 0)
        ==> ?d. &0 < d /\ (a + d % l) IN frontier s /\
                !e. &0 <= e /\ e < d ==> (a + e % l) IN interior s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [frontier] THEN
    SUBGOAL_THEN (← q r"interior s:real^N->bool = relative_interior s") SUBST1_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [← GSYM relative_frontier] THEN
      MATCH_MP_TAC RAY_TO_RELATIVE_FRONTIER THEN ASM_REWRITE_TAC []] THEN
    ASM_MESON_TAC [NOT_IN_EMPTY, RELATIVE_INTERIOR_NONEMPTY_INTERIOR, IN_UNIV,
                   AFFINE_HULL_NONEMPTY_INTERIOR])

  return { STARLIKE_CONVEX_TWEAK_BOUNDARY_POINTS, RELATIVE_INTERIOR_PROLONG,
           RELATIVE_INTERIOR_CONVEX_PROLONG, RELATIVE_INTERIOR_EQ_CLOSURE,
           RAY_TO_RELATIVE_FRONTIER, RAY_TO_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Relative interior of a set (part 6).  (convex.ml 12270-12486)             -/
/- ------------------------------------------------------------------------- -/

structure RIF where
  SEGMENT_TO_RELATIVE_FRONTIER : thm
  SEGMENT_TO_RELATIVE_FRONTIER_SIMPLE : thm
  SEGMENT_TO_FRONTIER_SIMPLE : thm
  SEGMENT_OUT_TO_FRONTIER : thm
  SUBSET_CONVEX_HULL_RELATIVE_FRONTIER : thm
  SUBSET_CONVEX_HULL_FRONTIER : thm
  AFFINE_HULL_RELATIVE_FRONTIER_BOUNDED : thm
  KREIN_MILMAN_RELATIVE_FRONTIER : thm
  KREIN_MILMAN_RELATIVE_BOUNDARY : thm
  KREIN_MILMAN_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupRIF [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVH : CVH) (BCLH : CLH) (BSTL : STL)
    (BRIA : RIA) (BRIC : RIC) (BRIE : RIE) : ExceptT String IO RIF := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_FIELD, SET_RULE,
        SET_TAC, VECTOR_ARITH, GEOM_ORIGIN_TAC, .. } := D
  let { EMPTY_SUBSET, .. } := D.core1
  let { INSERT_SUBSET, IN_DIFF, .. } := D.core2
  let { IN_SING, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IMP, .. } := D.core3
  let { REAL_INV_LE_1, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LT_ADD,
        REAL_LT_IMP_LE, REAL_LT_IMP_NZ, .. } := D.core4
  let { REAL_MUL_LINV, REAL_NOT_LT, SUBSET, SUBSET_ANTISYM, SUBSET_TRANS, .. } := D.core5
  let { HULL_INC, HULL_MINIMAL, HULL_MONO, SUBSET_HULL, .. } := D.misc
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC,
        VECTOR_MUL_EQ_0, VECTOR_MUL_LNEG, VECTOR_MUL_RNEG, VECTOR_NEG_EQ_0,
        VECTOR_SUB_EQ, .. } := D.vec4
  let { CLOSURE_CLOSED, .. } := D.top1
  let { CLOSURE_INC, CLOSURE_SUBSET, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := D.top2
  let { ENDS_IN_SEGMENT, FRONTIER_SING, .. } := D.top3
  let { IN_SEGMENT, .. } := D.top4
  let { SEGMENT_REFL, frontier, .. } := D.top5
  let { AFFINE_AFFINE_HULL, IN_AFFINE_SUB_MUL_DIFF, .. } := BAFF
  let { CONVEX_CONVEX_HULL, .. } := BCVH
  let { CONVEX_HULL_SUBSET_AFFINE_HULL, AFFINE_HULL_CLOSURE, .. } := BCLH
  let { SEGMENT_CONVEX_HULL, .. } := BSTL
  let { relative_frontier, .. } := BRIA
  let { IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, .. } := BRIC
  let { RAY_TO_RELATIVE_FRONTIER, RAY_TO_FRONTIER, .. } := BRIE
  -- @@SCOPE END

  let SEGMENT_TO_RELATIVE_FRONTIER ← prove
   r"!s x y:real^N.
        convex s /\ bounded s /\ x IN relative_interior s /\ y IN s /\
        ~(x = y /\ s = {x})
        ==> ?z. z IN relative_frontier s /\ y IN segment[x,z] /\
                segment(x,z) SUBSET relative_interior s"
   (SUBGOAL_THEN
     (← q r"!s x y:real^N.
          convex s /\ bounded s /\ x IN relative_interior s /\ y IN s /\ ~(x = y)
          ==> ?z. z IN relative_frontier s /\ y IN segment[x,z] /\
                  segment(x,z) SUBSET relative_interior s")
    ASSUME_TAC THENL
     [ALL_TAC,
      REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"x:real^N = y") THEN
      ASM_SIMP_TAC [] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(s = {a}) ==> a IN s ==> ?b. ~(b = a) /\ b IN s"))) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"w:real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"s:real^N->bool", ← q r"y:real^N", ← q r"w:real^N"]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      SIMP_TAC [ENDS_IN_SEGMENT]] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"s:real^N->bool", ← q r"x:real^N", ← q r"y - x:real^N"]
          RAY_TO_RELATIVE_FRONTIER) THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"x + (y - x):real^N = y"), VECTOR_SUB_EQ] THEN
    ASM_SIMP_TAC [HULL_INC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"x + d % (y - x):real^N") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [relative_frontier, IN_DIFF]] THEN
    REWRITE_TAC [IN_SEGMENT] THEN EXISTS_TAC (← q r"inv(d:real)") THEN
    ASM_SIMP_TAC [VECTOR_ADD_LDISTRIB, REAL_LE_INV_EQ, REAL_LT_IMP_LE,
                  VECTOR_MUL_ASSOC, REAL_MUL_LINV, REAL_LT_IMP_NZ] THEN
    CONJ_TAC THENL [MATCH_MP_TAC REAL_INV_LE_1, CONV_TAC (fun t => VECTOR_ARITH t)] THEN
    REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N", ← q r"y:real^N"]
          IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
    ASM_SIMP_TAC [NOT_IMP, ← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN
    REWRITE_TAC [SUBSET, IN_SEGMENT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x + d % (y - x):real^N")) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_DIFF, relative_frontier]) THEN
    ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"d:real") THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => VECTOR_ARITH t))

  let SEGMENT_TO_RELATIVE_FRONTIER_SIMPLE ← prove
   r"!s x:real^N.
        bounded s /\ x IN s /\ ~(s = {x})
        ==> ?a b. a IN relative_frontier s /\
                  b IN relative_frontier s /\
                  x IN segment[a,b]"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"x:real^N") THEN
    REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(vec 0:real^N) IN relative_frontier s") THENL
     [ASM_MESON_TAC [SEGMENT_REFL, IN_SING], ALL_TAC] THEN
    UNDISCH_TAC (← q r"~((vec 0:real^N) IN relative_frontier s)") THEN
    ASM_SIMP_TAC [relative_frontier, IN_DIFF, CLOSURE_INC] THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(s = {a}) ==> a IN s ==> ?b. b IN s /\ ~(b = a)"))) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:real^N") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"vec 0:real^N", ← q r"z:real^N"]
          RAY_TO_RELATIVE_FRONTIER) THEN
    ASM_SIMP_TAC [VECTOR_ADD_LID, HULL_INC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"u % z:real^N") THEN
    ASM_REWRITE_TAC [← GSYM relative_frontier, ← GSYM IN_DIFF] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"vec 0:real^N", ← q r"--z:real^N"]
          RAY_TO_RELATIVE_FRONTIER) THEN
    ASM_SIMP_TAC [VECTOR_ADD_LID, HULL_INC, VECTOR_NEG_EQ_0] THEN ANTS_TAC THENL
     [SUBST1_TAC (← VECTOR_ARITH (← q r"--z:real^N = vec 0 - &1 % (z - vec 0)")) THEN
      ASM_SIMP_TAC [IN_AFFINE_SUB_MUL_DIFF, AFFINE_AFFINE_HULL, HULL_INC],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"v % (--z):real^N") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IN_SEGMENT] THEN EXISTS_TAC (← q r"u:real / (u + v)") THEN
    REWRITE_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_RNEG] THEN
    REWRITE_TAC [← GSYM VECTOR_MUL_LNEG, ← GSYM VECTOR_ADD_RDISTRIB] THEN
    ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, REAL_LT_ADD] THEN
    CONV_TAC (RAND_CONV (RAND_CONV SYM_CONV)) THEN
    ASM_REWRITE_TAC [VECTOR_MUL_EQ_0] THEN
    MAP_EVERY UNDISCH_TAC [← q r"&0 < u", ← q r"&0 < v"] THEN
    CONV_TAC (fun t => REAL_FIELD t))

  let SEGMENT_TO_FRONTIER_SIMPLE ← prove
   r"!s x:real^N.
        bounded s /\ x IN s
        ==> ?a b. a IN frontier s /\
                  b IN frontier s /\
                  x IN segment[a,b]"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"x:real^N") THEN
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s = {vec 0:real^N}") THENL
     [ASM_REWRITE_TAC [FRONTIER_SING, IN_SING] THEN
      MESON_TAC [SEGMENT_REFL, IN_SING],
      REPEAT STRIP_TAC] THEN
    ASM_CASES_TAC (← q r"(vec 0:real^N) IN frontier s") THENL
     [ASM_MESON_TAC [SEGMENT_REFL, IN_SING], ALL_TAC] THEN
    UNDISCH_TAC (← q r"~((vec 0:real^N) IN frontier s)") THEN
    ASM_SIMP_TAC [frontier, IN_DIFF, CLOSURE_INC] THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(s = {a}) ==> a IN s ==> ?b. b IN s /\ ~(b = a)"))) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:real^N") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"vec 0:real^N", ← q r"z:real^N"]
          RAY_TO_FRONTIER) THEN
    ASM_SIMP_TAC [VECTOR_ADD_LID, HULL_INC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"u % z:real^N") THEN
    ASM_REWRITE_TAC [← GSYM frontier, ← GSYM IN_DIFF] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"vec 0:real^N", ← q r"--z:real^N"]
          RAY_TO_FRONTIER) THEN
    ASM_SIMP_TAC [VECTOR_ADD_LID, HULL_INC, VECTOR_NEG_EQ_0] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"v % (--z):real^N") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IN_SEGMENT] THEN EXISTS_TAC (← q r"u:real / (u + v)") THEN
    REWRITE_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_RNEG] THEN
    REWRITE_TAC [← GSYM VECTOR_MUL_LNEG, ← GSYM VECTOR_ADD_RDISTRIB] THEN
    ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, REAL_LT_ADD] THEN
    CONV_TAC (RAND_CONV (RAND_CONV SYM_CONV)) THEN
    ASM_REWRITE_TAC [VECTOR_MUL_EQ_0] THEN
    MAP_EVERY UNDISCH_TAC [← q r"&0 < u", ← q r"&0 < v"] THEN
    CONV_TAC (fun t => REAL_FIELD t))

  let SEGMENT_OUT_TO_FRONTIER ← prove
   r"!s a b:real^N.
        bounded s /\ b IN closure s /\ ~(b = a)
        ==> ?c. ~(c = a) /\ c IN frontier s /\ b IN segment[a,c]"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(b:real^N) IN frontier s") THENL
     [ASM_MESON_TAC [ENDS_IN_SEGMENT], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o
     GEN_REWRITE_RULE (RAND_CONV o RAND_CONV) [frontier]) THEN
    ASM_REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"b:real^N", ← q r"b - a:real^N"]
     RAY_TO_FRONTIER) THEN
    ASM_REWRITE_TAC [VECTOR_SUB_EQ] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"b + d % (b - a):real^N") THEN ASM_REWRITE_TAC [] THEN
    ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, ← VECTOR_ARITH
     (← q r"b + d % (b - a):real^N = a <=> (&1 + d) % (b - a) = vec 0")] THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_REWRITE_TAC [IN_SEGMENT, VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, ← VECTOR_ARITH
     (← q r"b:real^N = (&1 - u) % a + u % (b + d % (b - a)) <=>
      (u * (&1 + d) - &1) % (b - a) = vec 0")] THEN
    EXISTS_TAC (← q r"inv(&1 + d)") THEN REWRITE_TAC [REAL_LE_INV_EQ] THEN
    ASM_SIMP_TAC [REAL_INV_LE_1, ← REAL_ARITH (← q r"&0 < d ==> &1 <= &1 + d")] THEN
    UNDISCH_TAC (← q r"&0 < d") THEN CONV_TAC (fun t => REAL_FIELD t))

  let SUBSET_CONVEX_HULL_RELATIVE_FRONTIER ← prove
   r"!s:real^N->bool.
        bounded s /\ ~(?a. s = {a})
        ==> s SUBSET convex hull (relative_frontier s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET] THEN
    X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N"]
      SEGMENT_TO_RELATIVE_FRONTIER_SIMPLE) THEN
    ANTS_TAC THENL [ASM SET_TAC [], STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"segment[a:real^N,b] SUBSET convex hull (relative_frontier s)")
     (fun th => MP_TAC th THEN ASM SET_TAC []) THEN
    REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
    ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, CONVEX_CONVEX_HULL] THEN
    ASM_SIMP_TAC [HULL_INC])

  let SUBSET_CONVEX_HULL_FRONTIER ← prove
   r"!s:real^N->bool.
        bounded s ==> s SUBSET convex hull (frontier s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET] THEN
    X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N"]
      SEGMENT_TO_FRONTIER_SIMPLE) THEN
    ANTS_TAC THENL [ASM SET_TAC [], STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"segment[a:real^N,b] SUBSET convex hull (frontier s)")
     (fun th => MP_TAC th THEN ASM SET_TAC []) THEN
    REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
    ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, CONVEX_CONVEX_HULL] THEN
    ASM_SIMP_TAC [HULL_INC])

  let AFFINE_HULL_RELATIVE_FRONTIER_BOUNDED ← prove
   r"!s:real^N->bool.
        bounded s /\ ~(?a. s = {a})
        ==> affine hull (relative_frontier s) = affine hull s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC RAND_CONV [← GSYM AFFINE_HULL_CLOSURE] THEN
      MATCH_MP_TAC HULL_MONO THEN REWRITE_TAC [relative_frontier] THEN SET_TAC [],
      MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [AFFINE_AFFINE_HULL] THEN
      TRANS_TAC SUBSET_TRANS
       (← q r"convex hull (relative_frontier s):real^N->bool") THEN
      REWRITE_TAC [CONVEX_HULL_SUBSET_AFFINE_HULL] THEN
      MATCH_MP_TAC SUBSET_CONVEX_HULL_RELATIVE_FRONTIER THEN
      ASM_REWRITE_TAC []])

  let KREIN_MILMAN_RELATIVE_FRONTIER ← prove
   r"!s:real^N->bool.
        convex s /\ compact s /\ ~(?a. s = {a})
        ==> s = convex hull (relative_frontier s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [SUBSET_CONVEX_HULL_RELATIVE_FRONTIER, COMPACT_IMP_BOUNDED] THEN
    ASM_SIMP_TAC [SUBSET_HULL] THEN
    ASM_SIMP_TAC [relative_frontier, CLOSURE_CLOSED, COMPACT_IMP_CLOSED] THEN
    SET_TAC [])

  let KREIN_MILMAN_RELATIVE_BOUNDARY ← prove
   r"!s:real^N->bool.
        convex s /\ compact s /\ ~(?a. s = {a})
        ==> s = convex hull (s DIFF relative_interior s)"
   (GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP KREIN_MILMAN_RELATIVE_FRONTIER) THEN
    ASM_SIMP_TAC [relative_frontier, CLOSURE_CLOSED, COMPACT_IMP_CLOSED])

  let KREIN_MILMAN_FRONTIER ← prove
   r"!s:real^N->bool.
        convex s /\ compact s ==> s = convex hull (frontier s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [SUBSET_CONVEX_HULL_FRONTIER, COMPACT_IMP_BOUNDED] THEN
    ASM_SIMP_TAC [SUBSET_HULL] THEN
    ASM_SIMP_TAC [frontier, CLOSURE_CLOSED, COMPACT_IMP_CLOSED] THEN
    SET_TAC [])

  return { SEGMENT_TO_RELATIVE_FRONTIER, SEGMENT_TO_RELATIVE_FRONTIER_SIMPLE,
           SEGMENT_TO_FRONTIER_SIMPLE, SEGMENT_OUT_TO_FRONTIER,
           SUBSET_CONVEX_HULL_RELATIVE_FRONTIER, SUBSET_CONVEX_HULL_FRONTIER,
           AFFINE_HULL_RELATIVE_FRONTIER_BOUNDED, KREIN_MILMAN_RELATIVE_FRONTIER,
           KREIN_MILMAN_RELATIVE_BOUNDARY, KREIN_MILMAN_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Relative interior of a set (part 7).  (convex.ml 12488-12666)             -/
/- ------------------------------------------------------------------------- -/

structure RIG where
  RELATIVE_FRONTIER_NOT_SING : thm
  RELATIVE_INTERIOR_PCROSS : thm
  RELATIVE_FRONTIER_EQ_EMPTY : thm
  DIAMETER_BOUNDED_BOUND_LT : thm
  DIAMETER_ATTAINED_RELATIVE_FRONTIER : thm
  DIAMETER_RELATIVE_FRONTIER : thm
  DIAMETER_ATTAINED_FRONTIER : thm
  DIAMETER_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupRIG [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVP : CVP) (BCLH : CLH) (BRIA : RIA)
    (BRIC : RIC) (BRID : RID) (BRIE : RIE) : ExceptT String IO RIG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { DE_MORGAN_THM, EXTENSION, .. } := D.core1
  let { FORALL_PASTECART, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INTER, IN_SING, LEFT_AND_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_IMP, NOT_INSERT_EMPTY, PASTECART_IN_PCROSS, PCROSS_EMPTY, REAL_ABS_DIV,
        REAL_DIV_RMUL, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LT_DIV, REAL_LT_LE, REAL_LT_MUL, REAL_LT_REFL, .. } := D.core4
  let { RIGHT_AND_EXISTS_THM, SUBSET, SUBSET_DIFF, SUBSET_PCROSS, .. } := D.core5
  let { HULL_INC, .. } := D.misc
  let { NORM_0, NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LT, NORM_SUB, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_RCANCEL, VECTOR_SUB_EQ,
        VECTOR_SUB_REFL, .. } := D.vec4
  let { BOUNDED_CLOSURE, BOUNDED_DIFF, BOUNDED_FRONTIER, .. } := D.top1
  let { CLOSURE_EQ_EMPTY, CLOSURE_SUBSET, COMPACT_CLOSURE, .. } := D.top2
  let { DIAMETER_BOUNDED_BOUND, DIAMETER_CLOSURE, DIAMETER_COMPACT_ATTAINED, DIAMETER_EMPTY,
        DIAMETER_EQ_0, DIAMETER_SUBSET, FRONTIER_SING, .. } := D.top3
  let { IN_CBALL, .. } := D.top4
  let { OPEN_IN_PCROSS, PASTECART_IN_INTERIOR_SUBTOPOLOGY, frontier, .. } := D.top5
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { AFFINE_HULL_PCROSS, .. } := BCVP
  let { AFFINE_HULL_CLOSURE, .. } := BCLH
  let { relative_interior, relative_frontier, RELATIVE_INTERIOR_EMPTY, RELATIVE_FRONTIER_EMPTY,
        RELATIVE_INTERIOR_SUBSET, SUBSET_RELATIVE_INTERIOR, IN_RELATIVE_INTERIOR_CBALL, .. } :=
    BRIA
  let { INTERIOR_SUBSET_RELATIVE_INTERIOR, .. } := BRIC
  let { RELATIVE_FRONTIER_SING, .. } := BRID
  let { RELATIVE_INTERIOR_EQ_CLOSURE, RAY_TO_RELATIVE_FRONTIER, .. } := BRIE
  -- @@SCOPE END

  let RELATIVE_FRONTIER_NOT_SING ← prove
   r"!s a:real^N. bounded s ==> ~(relative_frontier s = {a})"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [RELATIVE_FRONTIER_EMPTY, NOT_INSERT_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"z:real^N")) THEN
    ASM_CASES_TAC (← q r"s = {z:real^N}") THEN
    ASM_REWRITE_TAC [RELATIVE_FRONTIER_SING, NOT_INSERT_EMPTY] THEN
    SUBGOAL_THEN (← q r"?w:real^N. w IN s /\ ~(w = z)") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], REPEAT STRIP_TAC] THEN
    SUBGOAL_THEN
      (← q r"~((w:real^N) IN relative_frontier s /\ z IN relative_frontier s)")
    MP_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
    MAP_EVERY UNDISCH_TAC
     [← q r"relative_frontier s = {a:real^N}", ← q r"bounded(s:real^N->bool)",
      ← q r"~(w:real^N = z)", ← q r"(z:real^N) IN s", ← q r"(w:real^N) IN s",
      ← q r"~((w:real^N) IN relative_frontier s /\ z IN relative_frontier s)"] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN REWRITE_TAC [DE_MORGAN_THM] THEN
    MAP_EVERY (fun t => SPEC_TAC (t, t)) [← q r"z:real^N", ← q r"w:real^N"] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!w z. Q w z <=> Q z w) /\ (!w z. P z ==> Q w z)
      ==> !w z. P w \/ P z ==> Q w z")) THEN
    CONJ_TAC THENL [MESON_TAC [], REPEAT GEN_TAC] THEN
    DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
    REWRITE_TAC [relative_frontier, IN_DIFF] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [SUBSET, CLOSURE_SUBSET], DISCH_TAC] THEN
    MP_TAC (← GEN (← q r"d:real")
     (← ISPECL [← q r"s:real^N->bool", ← q r"z:real^N", ← q r"d % (w - z):real^N"]
     RAY_TO_RELATIVE_FRONTIER)) THEN
    ASM_SIMP_TAC [VECTOR_SUB_EQ, IN_AFFINE_ADD_MUL_DIFF, AFFINE_AFFINE_HULL,
                  HULL_INC, VECTOR_MUL_EQ_0] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"&1") th) THEN MP_TAC (← SPEC (← q r"--(&1)") th))) THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [IN_SING] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_REWRITE_TAC [VECTOR_MUL_RCANCEL, VECTOR_MUL_ASSOC, VECTOR_SUB_EQ,
                     ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
    ASM_REAL_ARITH_TAC)

  let RELATIVE_INTERIOR_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        relative_interior(s PCROSS t) =
        relative_interior s PCROSS relative_interior t"
   (REPEAT STRIP_TAC THEN MAP_EVERY ASM_CASES_TAC
     [← q r"s:real^M->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, RELATIVE_INTERIOR_EMPTY] THEN
    REWRITE_TAC [relative_interior, AFFINE_HULL_PCROSS] THEN
    REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_ELIM_THM,
                 PASTECART_IN_PCROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^N"] THEN EQ_TAC THENL
     [ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> r /\ q /\ p")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^(M,N)finite_sum->bool")
       (CONJUNCTS_THEN ASSUME_TAC)) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP PASTECART_IN_INTERIOR_SUBTOPOLOGY) THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      W (MP_TAC o PART_MATCH (funpowM 3 rand) SUBSET_PCROSS o snd) THEN
      ASM SET_TAC [],
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"v:real^M->bool") STRIP_ASSUME_TAC)
       (X_CHOOSE_THEN (← q r"w:real^N->bool") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"(v:real^M->bool) PCROSS (w:real^N->bool)") THEN
      ASM_SIMP_TAC [PASTECART_IN_PCROSS, SUBSET_PCROSS, OPEN_IN_PCROSS]])

  let RELATIVE_FRONTIER_EQ_EMPTY ← prove
   r"!s:real^N->bool. relative_frontier s = {} <=> affine s"
   (GEN_TAC THEN REWRITE_TAC [relative_frontier] THEN
    REWRITE_TAC [← GSYM RELATIVE_INTERIOR_EQ_CLOSURE] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN SET_TAC [])

  let DIAMETER_BOUNDED_BOUND_LT ← do
    let lemma ← prove
     r"!s x y:real^N.
            bounded s /\ x IN relative_interior s /\ y IN s /\
            ~(diameter s = &0)
            ==> norm(x - y) < diameter s"
     (REPEAT STRIP_TAC THEN FIRST_X_ASSUM
       (MP_TAC o GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR_CBALL]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"e:real")
       STRIP_ASSUME_TAC)) THEN
      ASM_SIMP_TAC [REAL_LT_LE, DIAMETER_BOUNDED_BOUND] THEN
      ASM_CASES_TAC (← q r"y:real^N = x") THEN
      ASM_SIMP_TAC [VECTOR_SUB_REFL, NORM_0] THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x + e / norm(x - y) % (x - y):real^N")) THEN
      REWRITE_TAC [NOT_IMP, IN_INTER] THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [IN_CBALL, ← NORM_ARITH (← q r"dist(x:real^M,x + y) = norm y")] THEN
        ASM_SIMP_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM, REAL_DIV_RMUL,
                      NORM_EQ_0, VECTOR_SUB_EQ] THEN ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC IN_AFFINE_ADD_MUL_DIFF THEN
        ASM_SIMP_TAC [HULL_INC, AFFINE_AFFINE_HULL],
        DISCH_TAC THEN MP_TAC (← ISPECL
         [← q r"s:real^N->bool", ← q r"x + e / norm(x - y) % (x - y):real^N",
          ← q r"y:real^N"]
            DIAMETER_BOUNDED_BOUND) THEN
        ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [← VECTOR_ARITH
         (← q r"(x + e % (x - y)) - y:real^N = (&1 + e) % (x - y)")] THEN
        SIMP_TAC [NORM_MUL, ← REAL_ARITH (← q r"~(a * n <= n) <=> &0 < n * (a - &1)")] THEN
        MATCH_MP_TAC REAL_LT_MUL THEN
        ASM_REWRITE_TAC [NORM_POS_LT, VECTOR_SUB_EQ] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e ==> &0 < abs(&1 + e) - &1")) THEN
        MATCH_MP_TAC REAL_LT_DIV THEN
        ASM_REWRITE_TAC [NORM_POS_LT, VECTOR_SUB_EQ]])
    prove
     r"!s x y:real^N.
          bounded s /\ x IN relative_interior s /\ y IN closure s /\
          ~(diameter s = &0)
          ==> norm(x - y) < diameter s"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"closure s:real^N->bool", ← q r"x:real^N", ← q r"y:real^N"]
            lemma) THEN
      ASM_SIMP_TAC [DIAMETER_CLOSURE, BOUNDED_CLOSURE] THEN
      DISCH_THEN MATCH_MP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← SET_RULE (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
      MATCH_MP_TAC SUBSET_RELATIVE_INTERIOR THEN
      REWRITE_TAC [CLOSURE_SUBSET, AFFINE_HULL_CLOSURE])

  let DIAMETER_ATTAINED_RELATIVE_FRONTIER ← prove
   r"!s:real^N->bool.
        bounded s /\ ~(diameter s = &0)
        ==> ?x y. x IN relative_frontier s /\
                  y IN relative_frontier s /\
                  norm(x - y) = diameter s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [DIAMETER_EMPTY, relative_frontier] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"closure s:real^N->bool") DIAMETER_COMPACT_ATTAINED) THEN
    ASM_SIMP_TAC [COMPACT_CLOSURE, CLOSURE_EQ_EMPTY, DIAMETER_CLOSURE] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") DIAMETER_BOUNDED_BOUND_LT) THENL
     [DISCH_THEN (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]),
      DISCH_THEN (MP_TAC o SPECL [← q r"y:real^N", ← q r"x:real^N"])] THEN
    ASM_MESON_TAC [REAL_LT_REFL, NORM_SUB])

  let DIAMETER_RELATIVE_FRONTIER ← prove
   r"!s:real^N->bool.
        bounded s /\ ~(?a. s = {a})
        ==> diameter(relative_frontier s) = diameter s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [RELATIVE_FRONTIER_EMPTY] THEN
    REWRITE_TAC [relative_frontier] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM DIAMETER_CLOSURE] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_ANTISYM] THEN
    ASM_SIMP_TAC [SUBSET_DIFF, DIAMETER_SUBSET, BOUNDED_CLOSURE] THEN
    ASM_SIMP_TAC [DIAMETER_CLOSURE] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") DIAMETER_ATTAINED_RELATIVE_FRONTIER) THEN
    ASM_SIMP_TAC [DIAMETER_EQ_0, relative_frontier] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN MATCH_MP_TAC DIAMETER_BOUNDED_BOUND THEN
    ASM_SIMP_TAC [BOUNDED_CLOSURE, BOUNDED_DIFF])

  let DIAMETER_ATTAINED_FRONTIER ← prove
   r"!s:real^N->bool.
        bounded s /\ ~(diameter s = &0)
        ==> ?x y. x IN frontier s /\ y IN frontier s /\
                  norm(x - y) = diameter s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP DIAMETER_ATTAINED_RELATIVE_FRONTIER) THEN
    REWRITE_TAC [frontier, relative_frontier, IN_DIFF] THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] INTERIOR_SUBSET_RELATIVE_INTERIOR])

  let DIAMETER_FRONTIER ← prove
   r"!s:real^N->bool. bounded s ==> diameter(frontier s) = diameter s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"?a:real^N. s = {a}") THENL
     [ASM_MESON_TAC [FRONTIER_SING], ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"!r. r <= f /\ f <= s /\ r = s ==> f = s")) THEN
    EXISTS_TAC (← q r"diameter(closure s DIFF relative_interior s:real^N->bool)") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC DIAMETER_SUBSET THEN
      ASM_SIMP_TAC [BOUNDED_FRONTIER] THEN REWRITE_TAC [frontier] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET_RELATIVE_INTERIOR) THEN
      SET_TAC [],
      GEN_REWRITE_TAC RAND_CONV [← GSYM DIAMETER_CLOSURE] THEN
      MATCH_MP_TAC DIAMETER_SUBSET THEN
      ASM_SIMP_TAC [BOUNDED_CLOSURE, frontier, SUBSET_DIFF],
      ASM_SIMP_TAC [DIAMETER_RELATIVE_FRONTIER, ← GSYM relative_frontier]])

  return { RELATIVE_FRONTIER_NOT_SING, RELATIVE_INTERIOR_PCROSS, RELATIVE_FRONTIER_EQ_EMPTY,
           DIAMETER_BOUNDED_BOUND_LT, DIAMETER_ATTAINED_RELATIVE_FRONTIER,
           DIAMETER_RELATIVE_FRONTIER, DIAMETER_ATTAINED_FRONTIER, DIAMETER_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Relative interior of a set (part 8).  (convex.ml 12667-12890)             -/
/- ------------------------------------------------------------------------- -/

structure RIH where
  CLOSEST_POINT_IN_RELATIVE_INTERIOR : thm
  CLOSEST_POINT_IN_RELATIVE_FRONTIER : thm
  IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT : thm
  IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT_STRONG : thm
  IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT_EQ : thm
  INTER_RELATIVE_INTERIOR_SUBSET : thm
  RELATIVE_INTERIOR_INTER : thm
  SUBSET_RELATIVE_INTERIOR_INTERSECTING_CONVEX : thm
  CONVEX_HULL_SPHERE : thm
  SPHERE_SUBSET_CONVEX : thm
  DIAMETER_SPHERE : thm
  deriving Inhabited

@[nospecialize]
def setupRIH [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BCVB : CVB) (BRIA : RIA)
    (BRIB : RIB) (BRIC : RIC) (BRIF : RIF) (BRIG : RIG) : ExceptT String IO RIH := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_FIELD, SET_RULE,
        SET_TAC, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { INSERT_AC, IN_DIFF, .. } := D.core2
  let { IN_INSERT, IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_FORALL, NOT_IMP,
        NOT_IN_EMPTY, REAL_ABS_DIV, REAL_DIV_EQ_0, REAL_DIV_RMUL, .. } := D.core3
  let { REAL_INV_LE_1, REAL_LE_DIV, REAL_LE_INV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_MIN, REAL_LT_MUL,
        REAL_MIN_LE, .. } := D.core4
  let { RIGHT_AND_FORALL_THM, SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core5
  let { UNWIND_THM2, .. } := D.core6
  let { HULL_INC, SUBSET_HULL, .. } := D.misc
  let { BETWEEN_IMP_COLLINEAR, BETWEEN_MIDPOINT, BETWEEN_RESTRICTED_CASES,
        BETWEEN_TRANS_2, .. } := D.vec1
  let { MIDPOINT_EQ_ENDPOINT, NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, dist, .. } := D.vec4
  let { BETWEEN_IN_SEGMENT, BOUNDED_CBALL, CLOSEST_POINT_IN_SET, CLOSEST_POINT_LE,
        CLOSEST_POINT_SELF, .. } := D.top1
  let { CLOSURE_SUBSET, COMPACT_CBALL, .. } := D.top2
  let { DIAMETER_CBALL, ENDS_NOT_IN_SEGMENT, FRONTIER_CBALL, .. } := D.top3
  let { IN_CBALL, IN_SEGMENT, MIDPOINT_IN_SEGMENT, .. } := D.top4
  let { SEGMENT_OPEN_SUBSET_CLOSED, SEGMENT_SYM, segment, .. } := D.top5
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF, IN_AFFINE_SUB_MUL_DIFF, .. } := BAFF
  let { CONVEX_CONTAINS_SEGMENT, CONVEX_INTER, .. } := BCVX
  let { CONVEX_CBALL, .. } := BCVB
  let { relative_frontier, RELATIVE_INTERIOR_EMPTY, RELATIVE_INTERIOR_SUBSET,
        IN_RELATIVE_INTERIOR_CBALL, .. } := BRIA
  let { RELATIVE_INTERIOR_EQ_EMPTY, .. } := BRIB
  let { IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, .. } := BRIC
  let { KREIN_MILMAN_FRONTIER, .. } := BRIF
  let { DIAMETER_FRONTIER, .. } := BRIG
  -- @@SCOPE END

  let CLOSEST_POINT_IN_RELATIVE_INTERIOR ← prove
   r"!s x:real^N.
        closed s /\ ~(s = {}) /\ x IN affine hull s
        ==> ((closest_point s x) IN relative_interior s <=>
             x IN relative_interior s)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
    ASM_SIMP_TAC [CLOSEST_POINT_SELF] THEN
    MATCH_MP_TAC (← TAUT (← q r"~q /\ ~p ==> (p <=> q)")) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [RELATIVE_INTERIOR_SUBSET, SUBSET], STRIP_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR_CBALL]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"~(closest_point s (x:real^N) = x)") ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N",
     ← q r"closest_point s x -
      (min (&1) (e / norm(closest_point s x - x))) %
      (closest_point s x - x):real^N"]
      CLOSEST_POINT_LE) THEN
    ASM_REWRITE_TAC [dist, NOT_IMP, ← VECTOR_ARITH
     (← q r"x - (y - e % (y - x)):real^N = (&1 - e) % (x - y)")] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [IN_CBALL, IN_INTER] THEN CONJ_TAC THENL
       [REWRITE_TAC [← NORM_ARITH (← q r"dist(a:real^N,a - x) = norm x")] THEN
        REWRITE_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
        ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= a ==> abs(min (&1) a) <= a")) THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LE_DIV, NORM_POS_LE],
        MATCH_MP_TAC IN_AFFINE_SUB_MUL_DIFF THEN
        ASM_SIMP_TAC [AFFINE_AFFINE_HULL, HULL_INC]],
      REWRITE_TAC [NORM_MUL, ← REAL_ARITH
       (← q r"~(n <= a * n) <=> &0 < (&1 - a) * n")] THEN
      MATCH_MP_TAC REAL_LT_MUL THEN
      ASM_SIMP_TAC [NORM_POS_LT, VECTOR_SUB_EQ] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < e /\ e <= &1 ==> &0 < &1 - abs(&1 - e)")) THEN
      REWRITE_TAC [REAL_MIN_LE, REAL_LT_MIN, REAL_LT_01, REAL_LE_REFL] THEN
      ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT, VECTOR_SUB_EQ]])

  let CLOSEST_POINT_IN_RELATIVE_FRONTIER ← prove
   r"!s x:real^N.
        closed s /\ ~(s = {}) /\ x IN affine hull s DIFF relative_interior s
        ==> closest_point s x IN relative_frontier s"
   (SIMP_TAC [relative_frontier, IN_DIFF, CLOSEST_POINT_IN_RELATIVE_INTERIOR] THEN
    MESON_TAC [CLOSURE_SUBSET, CLOSEST_POINT_IN_SET, SUBSET])

  let IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT ← prove
   r"!s x a:real^N.
        convex s /\ x IN relative_interior s /\ a IN affine hull s /\ ~(x = a)
        ==> ?b. b IN s /\ x IN segment(a,b)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR_CBALL]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"x + d / norm(x - a) % (x - a:real^N)") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
      REWRITE_TAC [IN_INTER, IN_CBALL] THEN
      ASM_SIMP_TAC [IN_AFFINE_ADD_MUL_DIFF, HULL_INC, AFFINE_AFFINE_HULL] THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(x:real^N,x + y) = norm y")] THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ] THEN
      ASM_REAL_ARITH_TAC,
      ONCE_REWRITE_TAC [segment] THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a:real^N = a + x <=> x = vec 0")] THEN
      ASM_SIMP_TAC [VECTOR_MUL_EQ_0, REAL_DIV_EQ_0, NORM_EQ_0,
                    VECTOR_SUB_EQ, REAL_LT_IMP_NZ] THEN
      ASM_REWRITE_TAC [IN_SEGMENT, VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, ← VECTOR_ARITH
       (← q r"x:real^N = (&1 - u) % a + u % (x + v % (x - a)) <=>
        (&1 - u * (&1 + v)) % (x - a) = vec 0")] THEN
      ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT, VECTOR_SUB_EQ, ← REAL_FIELD
       (← q r"&0 < d ==> (&1 - u * (&1 + d) = &0 <=> u = inv(&1 + d))")] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> r /\ p /\ q")] THEN
      ASM_SIMP_TAC [UNWIND_THM2, REAL_LE_INV_EQ, REAL_INV_LE_1,
                    ← REAL_ARITH (← q r"&0 < d ==> &1 <= &1 + d /\ &0 <= &1 + d"),
                    REAL_LT_DIV, NORM_POS_LT, VECTOR_SUB_EQ]])

  let IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT_STRONG ← prove
   r"!s x a:real^N.
        convex s /\ x IN relative_interior s /\ a IN affine hull s /\ ~(x = a)
        ==> ?b. b IN relative_interior s /\ x IN segment(a,b)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"b:real^N") STRIP_ASSUME_TAC o MATCH_MP
      IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT) THEN
    EXISTS_TAC (← q r"midpoint(x:real^N,b)") THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N", ← q r"b:real^N"]
          IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
      ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN
      DISCH_THEN (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
      ASM_REWRITE_TAC [MIDPOINT_IN_SEGMENT] THEN
      ASM_MESON_TAC [ENDS_NOT_IN_SEGMENT],
      ONCE_REWRITE_TAC [segment] THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN CONJ_TAC THENL
       [REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT] THEN
        MATCH_MP_TAC BETWEEN_TRANS_2 THEN EXISTS_TAC (← q r"b:real^N") THEN
        REWRITE_TAC [BETWEEN_MIDPOINT] THEN
        ASM_MESON_TAC [BETWEEN_IN_SEGMENT, segment, IN_DIFF, SEGMENT_SYM],
        CONV_TAC (RAND_CONV SYM_CONV) THEN REWRITE_TAC [MIDPOINT_EQ_ENDPOINT] THEN
        ASM_MESON_TAC [ENDS_NOT_IN_SEGMENT]]])

  let IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT_EQ ← prove
   r"!s x:real^N.
        convex s
        ==> (x IN relative_interior s <=>
             ~(s = {}) /\
             !a. a IN s /\ ~(a = x) ==> ?b. b IN s /\ x IN segment(a,b))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [RELATIVE_INTERIOR_EMPTY, NOT_IN_EMPTY] THEN
    EQ_TAC THEN STRIP_TAC THENL
     [ASM_MESON_TAC [HULL_INC, IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") RELATIVE_INTERIOR_EQ_EMPTY) THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:real^N")) THEN
    ASM_CASES_TAC (← q r"x:real^N = z") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] RELATIVE_INTERIOR_SUBSET] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"z:real^N", ← q r"y:real^N"]
      IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
    ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN ASM SET_TAC [])

  let INTER_RELATIVE_INTERIOR_SUBSET ← prove
   r"!s t:real^N->bool.
        convex s /\ convex t
        ==> relative_interior s INTER relative_interior t SUBSET
            relative_interior(s INTER t)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s INTER t:real^N->bool = {}") THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"i1 INTER i2 = {} ==> k1 SUBSET i1 /\ k2 SUBSET i2
        ==> k1 INTER k2 SUBSET u"))) THEN
      REWRITE_TAC [RELATIVE_INTERIOR_SUBSET],
      REWRITE_TAC [SUBSET, IN_INTER] THEN X_GEN_TAC (← q r"x:real^N")] THEN
    ASM_SIMP_TAC [IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT_EQ, CONVEX_INTER] THEN
    ONCE_REWRITE_TAC [RIGHT_AND_FORALL_THM] THEN
    REWRITE_TAC [AND_FORALL_THM, IN_INTER] THEN MATCH_MP_TAC MONO_FORALL THEN
    X_GEN_TAC (← q r"y:real^N") THEN DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2
      (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"u:real^N") STRIP_ASSUME_TAC))
      (CONJUNCTS_THEN2 ASSUME_TAC
         (X_CHOOSE_THEN (← q r"v:real^N") STRIP_ASSUME_TAC))) THEN
    MP_TAC (← ISPECL [← q r"y:real^N", ← q r"u:real^N", ← q r"v:real^N", ← q r"x:real^N"]
          BETWEEN_RESTRICTED_CASES) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [BETWEEN_IMP_COLLINEAR, INSERT_AC, BETWEEN_IN_SEGMENT,
                     ← REWRITE_RULE [SUBSET] SEGMENT_OPEN_SUBSET_CLOSED],
      REWRITE_TAC [BETWEEN_IN_SEGMENT] THEN
      STRIP_TAC THENL
       [EXISTS_TAC (← q r"u:real^N") THEN
        MP_TAC (← ISPEC (← q r"t:real^N->bool") CONVEX_CONTAINS_SEGMENT) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"y:real^N", ← q r"v:real^N"]) THEN
        ASM_REWRITE_TAC [SUBSET] THEN ASM SET_TAC [],
        EXISTS_TAC (← q r"v:real^N") THEN
        MP_TAC (← ISPEC (← q r"s:real^N->bool") CONVEX_CONTAINS_SEGMENT) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"y:real^N", ← q r"u:real^N"]) THEN
        ASM_REWRITE_TAC [SUBSET] THEN ASM SET_TAC []]])

  let RELATIVE_INTERIOR_INTER ← prove
   r"!s t:real^N->bool.
        convex s /\ convex t /\
        ~(relative_interior s INTER relative_interior t = {})
        ==> relative_interior(s INTER t) =
            relative_interior s INTER relative_interior t"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, INTER_RELATIVE_INTERIOR_SUBSET] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [IN_INTER, SUBSET, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"v:real^N") THEN STRIP_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s INTER t:real^N->bool", ← q r"x:real^N", ← q r"v:real^N"]
     IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT) THEN
    ASM_CASES_TAC (← q r"x:real^N = v") THEN ASM_SIMP_TAC [CONVEX_INTER, IN_INTER] THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC HULL_INC THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN
      MP_TAC (← ISPEC (← q r"t:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN
      ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"v:real^N", ← q r"z:real^N"]
          IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT),
        MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"v:real^N", ← q r"z:real^N"]
          IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT)] THEN
      ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN ASM SET_TAC []])

  let SUBSET_RELATIVE_INTERIOR_INTERSECTING_CONVEX ← prove
   r"!s t:real^N->bool.
        convex s /\ convex t /\
        s SUBSET t /\ ~(s INTER relative_interior t = {})
        ==> relative_interior s SUBSET relative_interior t"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [IN_INTER, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real^N") THEN STRIP_TAC THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN
    ASM_CASES_TAC (← q r"x:real^N = a") THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N", ← q r"a:real^N"]
          IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT) THEN
    ASM_SIMP_TAC [HULL_INC] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N")
     (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> a IN s ==> a IN t")) THEN
    MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT THEN
    ASM_MESON_TAC [SUBSET, CLOSURE_SUBSET])

  let CONVEX_HULL_SPHERE ← prove
   r"!a:real^N r. convex hull (sphere(a,r)) = cball(a,r)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM FRONTIER_CBALL] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC KREIN_MILMAN_FRONTIER THEN
    REWRITE_TAC [CONVEX_CBALL, COMPACT_CBALL])

  let SPHERE_SUBSET_CONVEX ← prove
   r"!s a:real^N r. convex s ==> (sphere(a,r) SUBSET s <=> cball(a,r) SUBSET s)"
   (REWRITE_TAC [← GSYM CONVEX_HULL_SPHERE] THEN
    CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN REWRITE_TAC [SUBSET_HULL])

  let DIAMETER_SPHERE ← prove
   r"!a:real^N r. diameter(sphere(a,r)) = if r < &0 then &0 else &2 * r"
   (REWRITE_TAC [← GSYM FRONTIER_CBALL] THEN
    ASM_SIMP_TAC [DIAMETER_FRONTIER, BOUNDED_CBALL, DIAMETER_CBALL])

  return { CLOSEST_POINT_IN_RELATIVE_INTERIOR, CLOSEST_POINT_IN_RELATIVE_FRONTIER,
           IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT, IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT_STRONG,
           IN_RELATIVE_INTERIOR_IN_OPEN_SEGMENT_EQ, INTER_RELATIVE_INTERIOR_SUBSET,
           RELATIVE_INTERIOR_INTER, SUBSET_RELATIVE_INTERIOR_INTERSECTING_CONVEX,
           CONVEX_HULL_SPHERE, SPHERE_SUBSET_CONVEX, DIAMETER_SPHERE }

/- ------------------------------------------------------------------------- -/
/- Small move from (relative frontier of) convex set; basic closure          -/
/- properties for "is_interval".  (convex.ml 12894-13071)                    -/
/- ------------------------------------------------------------------------- -/

structure SMI where
  CONVEX_NEARBY_IN_SCALING : thm
  CONVEX_NEARBY_IN_SCALING_RELATIVE_INTERIOR : thm
  CONVEX_NEARBY_NOT_IN_SCALING : thm
  IS_INTERVAL_RELATIVE_INTERIOR : thm
  IS_INTERVAL_INTERIOR : thm
  IS_INTERVAL_CLOSURE : thm
  deriving Inhabited

@[nospecialize]
def setupSMI [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVA : CVA) (BCLH : CLH) (BRIA : RIA)
    (BRIB : RIB) (BRIC : RIC) : ExceptT String IO SMI := do
  -- @@SCOPE BEGIN
  let { ASM_METIS_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_FIELD, SET_RULE,
        VECTOR_ARITH, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, CARD_NUMSEG_1, CONJ_ASSOC, CONTRAPOS_THM, DIMINDEX_GE_1,
        FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_SUBSET, IMAGE_o, IMP_CONJ_ALT, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, LE_1, MONO_EXISTS, NOT_IMP, NOT_LT,
        NUMSEG_EMPTY, REAL_ABS_INV, .. } := D.core3
  let { REAL_INV_1_LT, REAL_LET_TRANS, REAL_LE_LDIV_EQ, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_MIN, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_SYM, REAL_OF_NUM_LT, REAL_POS, REAL_SUB_LE,
        REAL_SUB_LT, SUBSET, .. } := D.core5
  let { SUM_BOUND_LT_GEN, UNWIND_THM1, o_DEF, real_abs, real_div, .. } := D.core6
  let { HULL_INC, LAMBDA_SKOLEM, .. } := D.misc
  let { COMPONENT_LE_NORM, DIST_MUL, DIST_SYM, .. } := D.vec1
  let { NORM_LE_L1, NORM_MUL, NORM_SUB, SPAN_MUL, SPAN_SUB, SPAN_SUPERSET, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_ASSOC, VECTOR_MUL_LCANCEL, VECTOR_MUL_LID,
        VECTOR_SUB_COMPONENT, dist, .. } := D.vec4
  let { CLOSURE_APPROACHABLE, .. } := D.top1
  let { CLOSURE_INC, .. } := D.top2
  let { IN_CBALL, IN_CBALL_0, IS_INTERVAL_EMPTY, .. } := D.top4
  let { is_interval, .. } := D.top5
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { CONVEX_SUMS_MULTIPLES, .. } := BCVA
  let { AFFINE_HULL_EQ_SPAN, CLOSURE_SUBSET_AFFINE_HULL, .. } := BCLH
  let { relative_frontier, RELATIVE_INTERIOR_SUBSET, IN_RELATIVE_INTERIOR_CBALL, .. } := BRIA
  let { RELATIVE_INTERIOR_NONEMPTY_INTERIOR, .. } := BRIB
  let { IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK, .. } := BRIC
  -- @@SCOPE END

  let CONVEX_NEARBY_IN_SCALING ← prove
   r"!s:real^N->bool r.
        convex s /\ vec 0 IN relative_interior s /\ &1 < r
        ==> ?d. &0 < d /\
                !x y. x IN s /\ y IN affine hull s /\ dist(x,y) <= d
                      ==> y IN IMAGE (\x. r % x) s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR_CBALL]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"a * (r - &1)") THEN ASM_SIMP_TAC [REAL_LT_MUL, REAL_SUB_LT] THEN
    REPEAT STRIP_TAC THEN
    SUBST1_TAC (← REAL_ARITH (← q r"r = &1 + (r - &1)")) THEN
    ASM_SIMP_TAC [← GSYM CONVEX_SUMS_MULTIPLES, VECTOR_MUL_LID,
                  REAL_POS, REAL_SUB_LE, REAL_LT_IMP_LE] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"inv(r - &1) % (y - x):real^N"] THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV,
                  REAL_LT_IMP_NZ, REAL_SUB_LT] THEN
    CONJ_TAC THENL [ALL_TAC, CONV_TAC (fun t => VECTOR_ARITH t)] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
    REWRITE_TAC [IN_CBALL_0, IN_INTER, NORM_MUL, REAL_ABS_INV] THEN
    ASM_SIMP_TAC [SPAN_MUL, SPAN_SUB, SPAN_SUPERSET] THEN
    ASM_SIMP_TAC [real_abs, REAL_SUB_LE, REAL_LT_IMP_LE] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ONCE_REWRITE_TAC [NORM_SUB] THEN
    ASM_SIMP_TAC [← GSYM real_div, REAL_LE_LDIV_EQ, REAL_SUB_LT] THEN
    ASM_REWRITE_TAC [← GSYM dist])

  let CONVEX_NEARBY_IN_SCALING_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool r.
        convex s /\ vec 0 IN relative_interior s /\ &1 < r
        ==> ?d. &0 < d /\
                !x y. x IN s /\ y IN affine hull s /\ dist(x,y) <= d
                      ==> y IN IMAGE (\x. r % x) (relative_interior s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"(r + &1) / &2"]
          CONVEX_NEARBY_IN_SCALING) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")) THEN
    SUBGOAL_THEN
     (← q r"(\x:real^N. (r + &1) / &2 % x) =
      (\x. r % x) o (\x. (r + &1) / (&2 * r) % x)")
    SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF, VECTOR_MUL_ASSOC] THEN
      ABS_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      UNDISCH_TAC (← q r"&1 < r") THEN CONV_TAC (fun t => REAL_FIELD t),
      REWRITE_TAC [IMAGE_o] THEN MATCH_MP_TAC IMAGE_SUBSET] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"z:real^N") THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH
     (← q r"a % x:real^N = x - (&1 - a) % (x - vec 0)")] THEN
    MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK THEN
    ASM_SIMP_TAC [CLOSURE_INC] THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"&0 < x /\ x < &1 ==> &0 < &1 - x /\ &1 - x <= &1")) THEN
    ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ,
                  ← REAL_ARITH (← q r"&1 < x ==> &0 < &2 * x")] THEN
    ASM_REAL_ARITH_TAC)

  let CONVEX_NEARBY_NOT_IN_SCALING ← prove
   r"!s:real^N->bool r.
        convex s /\ vec 0 IN relative_interior s /\ &0 < r /\ r < &1
        ==> ?d. &0 < d /\
                !x y. x IN relative_frontier s /\ dist(x,y) <= d
                      ==> ~(y IN IMAGE (\x. r % x) s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"inv r:real"]
          CONVEX_NEARBY_IN_SCALING_RELATIVE_INTERIOR) THEN
    ASM_SIMP_TAC [REAL_INV_1_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"d * r:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    REWRITE_TAC [relative_frontier, IN_DIFF] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"inv r % y:real^N", ← q r"inv r % x:real^N"]) THEN
    ASM_REWRITE_TAC [DIST_MUL, IN_IMAGE, NOT_IMP, REAL_ABS_INV] THEN
    ASM_SIMP_TAC [VECTOR_MUL_LCANCEL, REAL_LT_IMP_NZ, REAL_LT_INV_EQ] THEN
    ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE, UNWIND_THM1, CONTRAPOS_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N")
     (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC)) THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, REAL_LT_IMP_NZ] THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LID] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN
    ASM_SIMP_TAC [← GSYM real_div, REAL_LE_LDIV_EQ] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
      RELATIVE_INTERIOR_SUBSET)) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
      CLOSURE_SUBSET_AFFINE_HULL)) THEN
    ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC, SPAN_MUL])

  let IS_INTERVAL_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool. is_interval s ==> is_interval(relative_interior s)"
   (REWRITE_TAC [is_interval, IN_RELATIVE_INTERIOR_CBALL] THEN
    GEN_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N", ← q r"x:real^N"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (CONJUNCTS_THEN2 ASSUME_TAC
      (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC)) MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (CONJUNCTS_THEN2 ASSUME_TAC
      (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC)) ASSUME_TAC) THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
    CONJ_TAC THENL [ASM_METIS_TAC [], DISCH_TAC] THEN
    EXISTS_TAC (← q r"min d e:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    REWRITE_TAC [SUBSET, IN_CBALL, IN_INTER] THEN
    X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"a + (y - x):real^N", ← q r"b + (y - x):real^N"] THEN
    REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a + y - x <= y <=> a <= x")] THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"y <= b + y - x <=> x <= b")] THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"cball(a:real^N,d) INTER affine hull s SUBSET s"),
      UNDISCH_TAC (← q r"cball(b:real^N,e) INTER affine hull s SUBSET s")] THEN
    REWRITE_TAC [SUBSET] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_CBALL, IN_INTER] THEN
    (CONJ_TAC THENL
      [UNDISCH_TAC (← q r"dist(x:real^N,y) <= min d e") THEN
       CONV_TAC (fun t => NORM_ARITH t),
       ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"a + b:real^N = a + &1 % b")] THEN
       MATCH_MP_TAC IN_AFFINE_ADD_MUL_DIFF THEN
       ASM_SIMP_TAC [AFFINE_AFFINE_HULL, HULL_INC]]))

  let IS_INTERVAL_INTERIOR ← prove
   r"!s:real^N->bool. is_interval s ==> is_interval(interior s)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"interior s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [IS_INTERVAL_EMPTY] THEN
    ASM_SIMP_TAC [← GSYM RELATIVE_INTERIOR_NONEMPTY_INTERIOR] THEN
    REWRITE_TAC [IS_INTERVAL_RELATIVE_INTERIOR])

  let IS_INTERVAL_CLOSURE ← do
    let lemma ← prove
     r"!a b u v. (u <= x /\ x <= v \/ v <= x /\ x <= u) /\
                 abs(a - u) < e /\ abs(b - v) < e
                 ==> ?y. (a <= y /\ y <= b \/ b <= y /\ y <= a) /\
                         abs(y - x) < e"
     (REPEAT GEN_TAC THEN DISCH_TAC THEN
      MATCH_MP_TAC (← MESON [] (← q r"!a b c. P a \/ P b \/ P c ==> ?x. P x")) THEN
      MAP_EVERY EXISTS_TAC [← q r"x:real", ← q r"a:real", ← q r"b:real"] THEN
      ASM_REAL_ARITH_TAC)
    prove
     r"!s:real^N->bool. is_interval s ==> is_interval(closure s)"
     (REWRITE_TAC [is_interval, CLOSURE_APPROACHABLE] THEN
      GEN_TAC THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N", ← q r"x:real^N"] THEN
      REWRITE_TAC [CONJ_ASSOC, AND_FORALL_THM] THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &(dimindex(:N))")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, DIMINDEX_GE_1, LE_1] THEN
      DISCH_THEN (CONJUNCTS_THEN2
        (X_CHOOSE_THEN (← q r"u:real^N") STRIP_ASSUME_TAC)
        (X_CHOOSE_THEN (← q r"v:real^N") STRIP_ASSUME_TAC)) THEN
      SUBGOAL_THEN
       (← q r"!i. 1 <= i /\ i <= dimindex(:N)
            ==> ?y. ((u:real^N)$i <= y /\ y <= (v:real^N)$i \/
                     v$i <= y /\ y <= u$i) /\
                    abs(y - (x:real^N)$i) < e / &(dimindex(:N))")
      MP_TAC THENL
       [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN MATCH_MP_TAC lemma THEN
        MAP_EVERY EXISTS_TAC [← q r"(a:real^N)$i", ← q r"(b:real^N)$i"] THEN
        ASM_SIMP_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN CONJ_TAC THEN
        W (MP_TAC o PART_MATCH lhand COMPONENT_LE_NORM o lhand o snd) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
        ASM_REWRITE_TAC [← GSYM dist],
        REWRITE_TAC [LAMBDA_SKOLEM] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^N", ← q r"v:real^N", ← q r"y:real^N"]) THEN
        ASM_SIMP_TAC [] THEN DISCH_TAC THEN REWRITE_TAC [dist] THEN
        W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
        MATCH_MP_TAC SUM_BOUND_LT_GEN THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, IN_NUMSEG, CARD_NUMSEG_1, VECTOR_SUB_COMPONENT,
                      NUMSEG_EMPTY, NOT_LT, DIMINDEX_GE_1]])

  return { CONVEX_NEARBY_IN_SCALING, CONVEX_NEARBY_IN_SCALING_RELATIVE_INTERIOR,
           CONVEX_NEARBY_NOT_IN_SCALING, IS_INTERVAL_RELATIVE_INTERIOR, IS_INTERVAL_INTERIOR,
           IS_INTERVAL_CLOSURE }

/- ------------------------------------------------------------------------- -/
/- Shrinking space to a ball while preserving convexity.                     -/
/- (convex.ml 13075-13235)                                                   -/
/- ------------------------------------------------------------------------- -/

structure SHB where
  CONVEX_PREIMAGE_CONCAVE_SCALING : thm
  CONVEXITY_PRESERVING_SHRINK_0 : thm
  deriving Inhabited

@[nospecialize]
def setupSHB [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCON : CON) (BCVF : CVF) (BCVB : CVB)
    (BCVP : CVP) (BCLH : CLH) (BAFI : AFI) (BRIA : RIA) : ExceptT String IO SHB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_RULE, SET_TAC,
        GEN_SIMPLIFY_CONV, TOP_DEPTH_SQCONV, basic_ss, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, EMPTY_SUBSET, .. } := D.core1
  let { FORALL_IN_IMAGE, INSERT_SUBSET, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNIV, MONO_EXISTS, REAL_ABS_INV, .. } := D.core3
  let { REAL_LE_DIV, REAL_LE_INV_EQ, REAL_LE_LADD, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_REFL,
        REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_IMP_NE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ,
        REAL_LT_LDIV_EQ, .. } := D.core4
  let { REAL_MUL_RINV, REAL_MUL_SYM, REAL_SUB_0, REAL_SUB_LE, REAL_SUB_LT, SUBSET,
        SUBSET_ANTISYM, SUBSET_TRANS, .. } := D.core5
  let { UNWIND_THM2, o_DEF, real_abs, real_div, .. } := D.core6
  let { HULL_INC, HULL_MINIMAL, .. } := D.misc
  let { LIFT_ADD, LIFT_SUB, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_TRIANGLE_LE, SPAN_MUL, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID,
        VECTOR_MUL_RZERO, .. } := D.vec4
  let { SUBTOPOLOGY_UNIV, .. } := D.met
  let { CENTRE_IN_BALL, .. } := D.top1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_INV,
        CONTINUOUS_ON_LIFT_NORM, CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB, ENDS_IN_SEGMENT, .. } :=
    D.top3
  let { HOMEOMORPHISM, HOMEOMORPHISM_IMP_OPEN_MAP, IN_BALL_0, IN_SEGMENT, OPEN_BALL,
        OPEN_CONTAINS_BALL, .. } := D.top4
  let { OPEN_IN, OPEN_IN_OPEN_EQ, homeomorphism, .. } := D.top5
  let { CONVEX_CONTAINS_SEGMENT, .. } := BCVX
  let { conic, CONIC_CONIC_HULL, CONIC_HULL_EXPLICIT, .. } := BCON
  let { convex_on, .. } := BCVF
  let { CONVEX_BALL, .. } := BCVB
  let { CONVEX_HULL_3, .. } := BCVP
  let { AFFINE_HULL_EQ_SPAN, .. } := BCLH
  let { SPAN_CONIC_HULL, .. } := BAFI
  let { IN_RELATIVE_INTERIOR, .. } := BRIA
  -- @@SCOPE END

  let CONVEX_PREIMAGE_CONCAVE_SCALING ← prove
   r"!f s t:real^N->bool.
        convex s /\ convex t /\ vec 0 IN s /\
        (\x. --f x) convex_on t /\ (!x. x IN t ==> &0 < f x)
        ==> convex {x | x IN t /\ (inv(f x) % x) IN s}"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [CONVEX_CONTAINS_SEGMENT, IN_ELIM_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
    REWRITE_TAC [← SET_RULE
     (← q r"s SUBSET {x | x IN t /\ Q x} <=> s SUBSET t /\ s SUBSET {x | Q x}")] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT], ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"!s. x IN s /\ s SUBSET t ==> x IN t")) THEN
    EXISTS_TAC (← q r"convex hull {vec 0:real^N,inv(f a) % a,inv(f b) % b}") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [CONVEX_HULL_3, IN_ELIM_THM, VECTOR_MUL_RZERO] THEN
      REWRITE_TAC [← TAUT (← q r"(p /\ q /\ r /\ s) /\ t <=> s /\ q /\ r /\ p /\ t")] THEN
      ONCE_REWRITE_TAC [← MESON [] (← q r"(?a b c. P a b c) <=> (?b c a. P a b c)")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"u + v = &1 <=> u = &1 - v"), UNWIND_THM2] THEN
      REWRITE_TAC [VECTOR_ADD_LID, REAL_SUB_LE] THEN
      SUBGOAL_THEN (← q r"(x:real^N) IN t") ASSUME_TAC THENL
       [ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, SUBSET], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_SEGMENT]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") (STRIP_ASSUME_TAC o GSYM)) THEN
      EXISTS_TAC (← q r"(&1 - u) * (f:real^N->real) a / f x") THEN
      EXISTS_TAC (← q r"u * (f:real^N->real) b / f x") THEN
      ASM (fun ths => tactic_of do
        pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
          (← ExceptT.mk (basic_ss [])) 5 ths))))
          [REAL_LE_MUL, REAL_LE_DIV, REAL_SUB_LE, REAL_LT_IMP_LE] THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [REAL_LE_LDIV_EQ, ← REAL_ARITH
          (← q r"u * a / c + v * b / c:real = (u * a + v * b) / c")] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"a:real^N", ← q r"b:real^N", ← q r"&1 - u", ← q r"u:real"] o
         GEN_REWRITE_RULE id [convex_on]) THEN
        ASM_REWRITE_TAC [ENDS_IN_SEGMENT, REAL_SUB_LE] THEN REAL_ARITH_TAC,
        ASM_SIMP_TAC [VECTOR_MUL_ASSOC, ← REAL_FIELD
         (← q r"&0 < a ==> (u * a / b) * inv a = inv b * u")] THEN
        ASM_REWRITE_TAC [← GSYM VECTOR_MUL_ASSOC, ← GSYM VECTOR_ADD_LDISTRIB]],
      MATCH_MP_TAC HULL_MINIMAL THEN
      ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET]])

  let CONVEXITY_PRESERVING_SHRINK_0 ← prove
   r"?f g. homeomorphism ((:real^N),ball(vec 0:real^N,&1)) (f,g) /\
         (!s. conic hull (IMAGE f s) = conic hull s) /\
         (!s. vec 0 IN s ==> vec 0 IN IMAGE f s) /\
         (!s. convex s /\ vec 0 IN s ==> convex(IMAGE f s)) /\
         (!s. vec 0 IN relative_interior s
              ==> vec 0 IN relative_interior(IMAGE f s))"
   (ABBREV_TAC (← q r"f = \x:real^N. inv(&1 + norm x) % x") THEN
    ABBREV_TAC (← q r"g = \x:real^N. inv(&1 - norm x) % x") THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REWRITE_TAC [HOMEOMORPHISM, SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      MAP_EVERY EXPAND_TAC ["f", "g"] THEN REWRITE_TAC [NORM_MUL] THEN
      REWRITE_TAC [IN_BALL_0, REAL_ABS_INV, IN_UNIV] THEN
      SIMP_TAC [real_abs, NORM_MUL, REAL_LE_INV_EQ, REAL_SUB_LE, REAL_LT_IMP_LE,
                ← NORM_ARITH (← q r"&0 <= &1 + norm(x:real^N)")] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
        REWRITE_TAC [CONTINUOUS_ON_ID, o_DEF] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        REWRITE_TAC [LIFT_ADD, ← NORM_ARITH (← q r"~(&1 + norm(x:real^N) = &0)")] THEN
        SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST,
                  ← REWRITE_RULE [o_DEF] CONTINUOUS_ON_LIFT_NORM],
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        REWRITE_TAC [VECTOR_MUL_ASSOC, ← GSYM real_div] THEN
        SIMP_TAC [REAL_LT_LDIV_EQ, ← NORM_ARITH (← q r"&0 < &1 + norm(x:real^N)")] THEN
        REAL_ARITH_TAC,
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
        REWRITE_TAC [CONTINUOUS_ON_ID, o_DEF] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        SIMP_TAC [LIFT_SUB, IN_ELIM_THM, REAL_SUB_0, REAL_LT_IMP_NE] THEN
        SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST,
                  ← REWRITE_RULE [o_DEF] CONTINUOUS_ON_LIFT_NORM] THEN
        SIMP_TAC [IN_BALL_0, REAL_LT_IMP_NE],
        X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [VECTOR_MUL_ASSOC] THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM VECTOR_MUL_LID] THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN
        MP_TAC (← ISPEC (← q r"x:real^N") NORM_POS_LE) THEN
        CONV_TAC (fun t => REAL_FIELD t),
        GEN_TAC THEN REWRITE_TAC [VECTOR_MUL_ASSOC] THEN
        MATCH_MP_TAC (← MESON [VECTOR_MUL_LID]
         (← q r"(P ==> a = &1) ==> P ==> a % y = y")) THEN
        CONV_TAC (fun t => REAL_FIELD t)],
      DISCH_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"s:real^N->bool") THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
      CONJ_TAC THEN MATCH_MP_TAC HULL_MINIMAL THEN
      REWRITE_TAC [CONIC_CONIC_HULL] THENL
       [EXPAND_TAC "f" THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        SIMP_TAC [HULL_INC, REAL_LE_INV_EQ, ← REWRITE_RULE [conic] CONIC_CONIC_HULL,
                  ← NORM_ARITH (← q r"&0 <= &1 + norm(x:real^N)")],
        EXPAND_TAC "f" THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        REWRITE_TAC [CONIC_HULL_EXPLICIT, IN_ELIM_THM, IN_IMAGE] THEN
        EXISTS_TAC (← q r"&1 + norm(x:real^N)") THEN
        EXISTS_TAC (← q r"inv(&1 + norm x) % x:real^N") THEN
        SIMP_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_LID, REAL_MUL_RINV,
                  REAL_LT_IMP_NZ, REAL_LT_IMP_LE,
                  ← NORM_ARITH (← q r"&0 < &1 + norm(x:real^N)")] THEN
        ASM_MESON_TAC []],
      DISCH_TAC] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REWRITE_TAC [AND_FORALL_THM]  THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
      SUBGOAL_THEN
       (← q r"IMAGE f s = {x | x IN ball(vec 0,&1) /\ (g:real^N->real^N) x IN s}")
      SUBST1_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
        SET_TAC [],
        EXPAND_TAC "g" THEN REWRITE_TAC [IN_ELIM_THM, VECTOR_MUL_RZERO] THEN
        ASM_REWRITE_TAC [CENTRE_IN_BALL, REAL_LT_01] THEN STRIP_TAC] THEN
      MATCH_MP_TAC CONVEX_PREIMAGE_CONCAVE_SCALING THEN
      ASM_REWRITE_TAC [CONVEX_BALL] THEN EXPAND_TAC "g" THEN
      SIMP_TAC [IN_BALL_0, REAL_LT_INV_EQ, REAL_SUB_LT] THEN
      SIMP_TAC [convex_on, REAL_LE_LADD, ← REAL_ARITH
       (← q r"--(&1 - z) <= u * --(&1 - x) + v * --(&1 - y) <=>
        (u + v) + z <= &1 + (u * x + v * y)")] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC NORM_TRIANGLE_LE THEN
      ASM_REWRITE_TAC [NORM_MUL, real_abs, REAL_LE_REFL],
      STRIP_TAC] THEN
    X_GEN_TAC (← q r"s:real^N->bool") THEN REWRITE_TAC [IN_RELATIVE_INTERIOR] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC] THEN
    ONCE_REWRITE_TAC [← GSYM SPAN_CONIC_HULL] THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [SPAN_CONIC_HULL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"open_in (subtopology euclidean (ball(vec 0,&1)))
              (IMAGE (f:real^N->real^N) (ball(vec 0,r)))")
    MP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN
      MAP_EVERY EXISTS_TAC [← q r"g:real^N->real^N", ← q r"(:real^N)"] THEN
      ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN, OPEN_BALL],
      SIMP_TAC [OPEN_IN_OPEN_EQ, OPEN_BALL]] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [OPEN_CONTAINS_BALL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^N")) THEN
    ASM_SIMP_TAC [CENTRE_IN_BALL] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"bd SUBSET IMAGE f br
      ==> br INTER ss SUBSET s /\
          IMAGE f br INTER ss SUBSET IMAGE f (br INTER ss)
          ==> bd INTER ss SUBSET IMAGE f s"))) THEN
    ASM_REWRITE_TAC [] THEN TRANS_TAC SUBSET_TRANS
     (← q r"IMAGE (f:real^N->real^N) (ball(vec 0,r)) INTER IMAGE f (span s)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. f x IN ss ==> x IN ss)
        ==> IMAGE f br INTER ss SUBSET IMAGE f br INTER IMAGE f ss")),
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
      ASM SET_TAC []] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EXPAND_TAC "f" THEN REWRITE_TAC [] THEN
    DISCH_TAC THEN SUBGOAL_THEN
     (← q r"x:real^N = (&1 + norm x) % inv(&1 + norm x) % x")
    SUBST1_TAC THENL [ALL_TAC, ASM_SIMP_TAC [SPAN_MUL]] THEN
    SIMP_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_LID, REAL_MUL_RINV,
              ← NORM_ARITH (← q r"~(&1 + norm(x:real^N) = &0)")])

  return { CONVEX_PREIMAGE_CONCAVE_SCALING, CONVEXITY_PRESERVING_SHRINK_0 }

/- ------------------------------------------------------------------------- -/
/- Some convexity-related properties of Hausdorff distance.                  -/
/- (convex.ml 13239-13405)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HAU where
  HAUSDIST_CONVEX_HULLS : thm
  HAUSDIST_SUMS : thm
  HAUSDIST_COMPLEMENTS_CONVEX_EXPLICIT : thm
  HAUSDIST_COMPLEMENTS_CONVEX_LE : thm
  deriving Inhabited

@[nospecialize]
def setupHAU [HolBase] (D : ConvexDeps) (BCVB : CVB) (BCVA : CVA) (BCVH : CVH) (BMCG : MCG)
    (BCHB : CHB) (BRIE : RIE) : ExceptT String IO HAU := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        NORM_ARITH, .. } := D
  let { CONJ_ASSOC, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IN_DIFF, .. } := D.core2
  let { IN_SING, IN_UNIV, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_ANTISYM, REAL_LE_REFL, REAL_LE_TRANS, REAL_LTE_TRANS,
        REAL_LT_IMP_LE, REAL_LT_LMUL_EQ, REAL_LT_REFL, .. } := D.core4
  let { REAL_MUL_AC, REAL_NOT_LE, REAL_NOT_LT, REAL_POW_2, REAL_SUB_LT, RIGHT_EXISTS_AND_THM,
        SUBSET, .. } := D.core5
  let { real_abs, .. } := D.core6
  let { HULL_SUBSET, .. } := D.misc
  let { DIST_SYM, DOT_RADD, DOT_RMUL, DOT_RNEG, DOT_RSUB, .. } := D.vec1
  let { NORM_CAUCHY_SCHWARZ_ABS, .. } := D.vec2
  let { NORM_MUL, NORM_NEG, NORM_POS_LT, NORM_POW_2, SUMS_ASSOC, SUMS_SYM, .. } := D.vec3
  let { VECTOR_NEG_EQ_0, dist, .. } := D.vec4
  let { BOUNDED_CLOSURE, BOUNDED_DIFFS, BOUNDED_SUMS, CBALL_EQ_EMPTY, CLOSED_CBALL,
        CLOSED_COMPACT_SUMS, CLOSURE_APPROACHABLE, CLOSURE_CLOSED, CLOSURE_COMPLEMENT, .. } :=
    D.top1
  let { CLOSURE_EQ_EMPTY, CLOSURE_SUBSET, CLOSURE_SUMS, COMPACT_CBALL, COMPACT_CLOSURE,
        COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPACT_SUMS, .. } := D.top2
  let { FRONTIER_COMPLEMENT, HAUSDIST_CLOSURE, HAUSDIST_COMPACT_SUMS, HAUSDIST_EMPTY,
        HAUSDIST_POS_LE, HAUSDIST_SYM, .. } := D.top3
  let { IN_BALL, .. } := D.top4
  let { REAL_HAUSDIST_LE, REAL_HAUSDIST_LE_SUMS, REAL_LE_HAUSDIST,
        REAL_LT_HAUSDIST_POINT_EXISTS, SETDIST_LE_DIST, SETDIST_SUBSET_RIGHT, bounded,
        frontier, .. } := D.top5
  let { CONVEX_CBALL, .. } := BCVB
  let { CONVEX_SUMS, SUBSET_SUMS_RCANCEL, .. } := BCVA
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_EMPTY, CONVEX_HULL_EQ_EMPTY, .. } := BCVH
  let { CONVEX_CLOSURE, SUPPORTING_HYPERPLANE_POINT, CONVEX_ON_SETDIST, .. } := BMCG
  let { CONVEX_ON_CONVEX_HULL_BOUND, .. } := BCHB
  let { RAY_TO_FRONTIER, .. } := BRIE
  -- @@SCOPE END

  let HAUSDIST_CONVEX_HULLS ← prove
   r"!s t:real^N->bool.
        bounded s /\ bounded t
        ==> hausdist(convex hull s,convex hull t) <= hausdist(s,t)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_MESON_TAC [HAUSDIST_EMPTY, CONVEX_HULL_EMPTY, REAL_LE_REFL],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_MESON_TAC [HAUSDIST_EMPTY, CONVEX_HULL_EMPTY, REAL_LE_REFL],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_HAUSDIST_LE THEN ASM_REWRITE_TAC [CONVEX_HULL_EQ_EMPTY] THEN
    CONJ_TAC THEN MATCH_MP_TAC CONVEX_ON_CONVEX_HULL_BOUND THEN
    CONJ_TAC THEN SIMP_TAC [CONVEX_ON_SETDIST, CONVEX_CONVEX_HULL] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_HAUSDIST THEN
    ASM_REWRITE_TAC [LEFT_EXISTS_AND_THM, RIGHT_EXISTS_AND_THM, CONJ_ASSOC] THEN
    (CONJ_TAC THENL
      [CONJ_TAC, ASM_MESON_TAC [SETDIST_SUBSET_RIGHT, HULL_SUBSET]]) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"] BOUNDED_DIFFS) THEN
    ASM_REWRITE_TAC [bounded, FORALL_IN_GSPEC, ← GSYM dist] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [SETDIST_LE_DIST, dist, DIST_SYM, REAL_LE_TRANS,
                   MEMBER_NOT_EMPTY, IN_SING])

  let HAUSDIST_SUMS ← prove
   r"!s t:real^N->bool u.
        bounded s /\ bounded t /\ convex s /\ convex t /\ bounded u /\
        ~(s = {}) /\ ~(t = {}) /\ ~(u = {})
        ==> hausdist({x + e | x IN s /\ e IN u},
                     {y + e | y IN t /\ e IN u}) =
            hausdist(s,t)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← MESON [HAUSDIST_CLOSURE]
     (← q r"hausdist(s:real^N->bool,t) = hausdist(closure s,closure t)")] THEN
    SIMP_TAC [CLOSURE_SUMS] THEN
    SIMP_TAC [CLOSURE_CLOSED, CLOSED_CBALL, ← GSYM COMPACT_CLOSURE] THEN
    ONCE_REWRITE_TAC [← GSYM CLOSURE_EQ_EMPTY] THEN
    ASM_CASES_TAC
     (← q r"convex(closure s:real^N->bool) /\ convex(closure t:real^N->bool)")
    THENL [POP_ASSUM MP_TAC, ASM_MESON_TAC [CONVEX_CLOSURE]] THEN
    ASM_CASES_TAC (← q r"convex(s:real^N->bool)") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"convex(t:real^N->bool)") THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN
    SPEC_TAC ((← q r"closure u:real^N->bool"), (← q r"u:real^N->bool")) THEN
    SPEC_TAC ((← q r"closure t:real^N->bool"), (← q r"t:real^N->bool")) THEN
    SPEC_TAC ((← q r"closure s:real^N->bool"), (← q r"s:real^N->bool")) THEN
    REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_HAUSDIST_LE_SUMS THEN
    MAP_EVERY ABBREV_TAC
     [← q r"a = hausdist(s:real^N->bool,t)",
      ← q r"b = hausdist({x + e:real^N | x IN s /\ e IN u},
                    {y + e | y IN t /\ e IN u})"] THEN
     ASM_REWRITE_TAC [CBALL_EQ_EMPTY, REAL_NOT_LT, ← SET_RULE
      (← q r"{f x y | x IN s /\ y IN t} = {} <=> s = {} \/ t = {}")]
    THENL
     [REWRITE_TAC [SUMS_ASSOC] THEN
      GEN_REWRITE_TAC (BINOP_CONV o RAND_CONV o RAND_CONV o ONCE_DEPTH_CONV)
        [SUMS_SYM] THEN
      REWRITE_TAC [← GSYM SUMS_ASSOC] THEN CONJ_TAC THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET s'
        ==> {f x y | x IN s /\ y IN t} SUBSET {f x y | x IN s' /\ y IN t}")) THEN
      EXPAND_TAC "a" THENL
       [ALL_TAC, ONCE_REWRITE_TAC [HAUSDIST_SYM]] THEN
      MATCH_MP_TAC HAUSDIST_COMPACT_SUMS THEN ASM_SIMP_TAC [COMPACT_IMP_BOUNDED],
      CONJ_TAC THEN MATCH_MP_TAC SUBSET_SUMS_RCANCEL THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN
      ASM_SIMP_TAC [CLOSED_COMPACT_SUMS, COMPACT_CBALL, COMPACT_IMP_CLOSED,
        CONVEX_CBALL, COMPACT_IMP_BOUNDED, CONVEX_SUMS, REAL_NOT_LT] THEN
      REWRITE_TAC [SUMS_ASSOC] THEN
      GEN_REWRITE_TAC (RAND_CONV o RAND_CONV o ONCE_DEPTH_CONV) [SUMS_SYM] THEN
      REWRITE_TAC [← GSYM SUMS_ASSOC] THEN
      EXPAND_TAC "b" THENL
       [ALL_TAC, ONCE_REWRITE_TAC [HAUSDIST_SYM]] THEN
      MATCH_MP_TAC HAUSDIST_COMPACT_SUMS THEN
      ASM_SIMP_TAC [BOUNDED_SUMS, COMPACT_SUMS, COMPACT_CBALL,
       COMPACT_IMP_BOUNDED, CBALL_EQ_EMPTY, REAL_NOT_LT, ← SET_RULE
       (← q r"{f x y | x IN s /\ y IN t} = {} <=> s = {} \/ t = {}")]])

  let HAUSDIST_COMPLEMENTS_CONVEX_EXPLICIT ← prove
   r"!s t d x:real^N.
        convex s /\ bounded s /\ ~(s = {}) /\
        bounded t /\ ~(x IN s) /\ hausdist(s,t) < d
        ==> ?y. ~(y IN t) /\ dist(x,y) < d"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"s:real^N->bool", ← q r"x:real^N"] SUPPORTING_HYPERPLANE_POINT) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"bb:real", ← q r"y:real^N"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    ASM_CASES_TAC (← q r"x IN closure((:real^N) DIFF t)") THENL
     [ONCE_REWRITE_TAC [DIST_SYM] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CLOSURE_APPROACHABLE]) THEN
      REWRITE_TAC [IN_UNIV, IN_DIFF] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_MESON_TAC [REAL_LET_TRANS, HAUSDIST_POS_LE],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE (RAND_CONV o RAND_CONV)
          [CLOSURE_COMPLEMENT]) THEN
      REWRITE_TAC [IN_DIFF, IN_UNIV] THEN DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"x:real^N", ← q r"--a:real^N"]
        RAY_TO_FRONTIER) THEN
    ASM_REWRITE_TAC [VECTOR_NEG_EQ_0] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"l:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"?w:real^N. w IN s /\ dist(x + l % --a,w) < d")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC REAL_LT_HAUSDIST_POINT_EXISTS THEN
      EXISTS_TAC (← q r"closure t:real^N->bool") THEN
      ASM_SIMP_TAC [HAUSDIST_CLOSURE, BOUNDED_CLOSURE] THEN
      ASM_MESON_TAC [frontier, IN_DIFF, HAUSDIST_SYM],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(x + l % --a) IN frontier((:real^N) DIFF t)") MP_TAC THENL
     [ASM_REWRITE_TAC [FRONTIER_COMPLEMENT], REWRITE_TAC [frontier]] THEN
    REWRITE_TAC [IN_DIFF, CLOSURE_APPROACHABLE] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"d - dist(x:real^N,x + l % --a)") o CONJUNCT1) THEN
    ASM_REWRITE_TAC [IN_UNIV, REAL_SUB_LT] THEN ANTS_TAC THENL
     [ALL_TAC,
      MESON_TAC [← NORM_ARITH
       (← q r"dist(y:real^N,z) < d - dist(x,z) ==> dist(x,y) < d")]] THEN
    SUBGOAL_THEN
     (← q r"ball(x + l % --a:real^N,dist(x,x + l % --a)) INTER closure s = {}")
    MP_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"(!y. y IN t ==> P y) ==> (!x. x IN u ==> ~P x) ==> u INTER t = {}"))) THEN
      X_GEN_TAC (← q r"v:real^N") THEN REWRITE_TAC [IN_BALL, REAL_NOT_LE] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"v - (x + l % --a):real^N"]
          NORM_CAUCHY_SCHWARZ_ABS) THEN
      REWRITE_TAC [DOT_RSUB, DOT_RADD, DOT_RNEG, DOT_RMUL] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"d < l * a /\ x <= y ==> abs(v - (x + l * --a)) <= d ==> ~(v >= y)")) THEN
      ASM_REWRITE_TAC [] THEN
      TRANS_TAC REAL_LTE_TRANS
       (← q r"norm(a:real^N) * dist(x:real^N,x + l % --a)") THEN
      ASM_SIMP_TAC [REAL_LT_LMUL_EQ, NORM_POS_LT,
                    ← NORM_ARITH (← q r"norm(a - b:real^N) = dist(b,a)")] THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(x:real^N,x + y) = norm y")] THEN
      REWRITE_TAC [DOT_RMUL, NORM_MUL, NORM_NEG, DOT_RNEG] THEN
      ASM_SIMP_TAC [← GSYM NORM_POW_2, REAL_POW_2, REAL_MUL_AC, real_abs,
                    REAL_LT_IMP_LE, REAL_LE_REFL],
      DISCH_THEN (MP_TAC o SPEC (← q r"w:real^N") o MATCH_MP (← SET_RULE
       (← q r"s INTER t = {} ==> !w. w IN t ==> ~(w IN s)"))) THEN
      ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET, IN_BALL] THEN
      ASM_REAL_ARITH_TAC])

  let HAUSDIST_COMPLEMENTS_CONVEX_LE ← prove
   r"!s t:real^N->bool.
      convex s /\ bounded s /\ convex t /\ bounded t /\ ~(s = {}) /\ ~(t = {})
      ==> hausdist((:real^N) DIFF s,(:real^N) DIFF t) <= hausdist(s,t)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(:real^N) DIFF s = {}") THEN
    ASM_REWRITE_TAC [HAUSDIST_EMPTY, HAUSDIST_POS_LE] THEN
    ASM_CASES_TAC (← q r"(:real^N) DIFF t = {}") THEN
    ASM_REWRITE_TAC [HAUSDIST_EMPTY, HAUSDIST_POS_LE] THEN
    MATCH_MP_TAC REAL_HAUSDIST_LE THEN ASM_REWRITE_TAC [IN_DIFF, IN_UNIV] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← MESON [REAL_NOT_LT, REAL_LT_REFL]
     (← q r"(!z:real. y < z ==> x < z) ==> x <= y")) THEN
    X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]
          HAUSDIST_COMPLEMENTS_CONVEX_EXPLICIT),
      MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"s:real^N->bool"]
          HAUSDIST_COMPLEMENTS_CONVEX_EXPLICIT)] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"d:real", ← q r"x:real^N"]) THEN
    (ANTS_TAC THENL [ASM_MESON_TAC [HAUSDIST_SYM], ALL_TAC]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
    MATCH_MP_TAC SETDIST_LE_DIST THEN ASM SET_TAC [])

  return { HAUSDIST_CONVEX_HULLS, HAUSDIST_SUMS, HAUSDIST_COMPLEMENTS_CONVEX_EXPLICIT,
           HAUSDIST_COMPLEMENTS_CONVEX_LE }

/- ------------------------------------------------------------------------- -/
/- The Blaschke selection principle and related results.                     -/
/- (convex.ml 13409-13505)                                                   -/
/- ------------------------------------------------------------------------- -/

structure BLA where
  CONVEX_HAUSDIST_LIMIT : thm
  COMPLETE_HAUSDIST_CONVEX : thm
  COMPLETE_HAUSDIST_CONVEX_UNIV : thm
  BLASCHKE : thm
  BLASCHKE_UNIV : thm
  deriving Inhabited

@[nospecialize]
def setupBLA [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVH : CVH) (BOCH : OCH) (BHAU : HAU) :
    ExceptT String IO BLA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, .. } := D
  let { IMP_CONJ_ALT, .. } := D.core2
  let { MONO_EXISTS, .. } := D.core3
  let { SUBSET, .. } := D.core5
  let { SUBSET_UNIV, o_THM, .. } := D.core6
  let { HULL_P, .. } := D.misc
  let { LIFT_ADD, LIFT_EQ, LIFT_NUM, .. } := D.vec2
  let { NORM_LIFT, .. } := D.vec3
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met
  let { BOUNDED_SUBSET, CLOSED_UNIV, CLOSURE_CLOSED, .. } := D.top1
  let { CLOSURE_SUBSET, COMPACT_CLOSURE, COMPACT_HAUSDIST, COMPACT_IMP_BOUNDED,
        COMPACT_IMP_CLOSED, COMPLETE_HAUSDIST, .. } := D.top2
  let { HAUSDIST_EQ_0, HAUSDIST_SYM, HAUSDIST_TRIANGLE, .. } := D.top3
  let { LIM_CONST, LIM_NULL_ADD, LIM_NULL_COMPARISON, LIM_UNIQUE, .. } := D.top4
  let { REAL_ABS_HAUSDIST, .. } := D.top5
  let { CONVEX_EMPTY, .. } := BCVX
  let { CONVEX_HULL_EQ, CONVEX_HULL_EQ_EMPTY, .. } := BCVH
  let { COMPACT_CONVEX_HULL, .. } := BOCH
  let { HAUSDIST_CONVEX_HULLS, .. } := BHAU
  -- @@SCOPE END

  let CONVEX_HAUSDIST_LIMIT ← prove
   r"!s:(num->real^N->bool) t.
    eventually (\n. bounded(s n) /\ convex(s n) /\ ~(s n = {})) sequentially /\
    compact t /\ ((\n. lift(hausdist(s n,t))) --> vec 0) sequentially
    ==> convex t"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [CONVEX_EMPTY] THEN
    SUBGOAL_THEN (← q r"hausdist(convex hull t:real^N->bool,t) = &0") MP_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [HAUSDIST_EQ_0, COMPACT_IMP_CLOSED, CONVEX_HULL_EQ_EMPTY,
        CLOSURE_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_CONVEX_HULL] THEN
      REWRITE_TAC [CONVEX_HULL_EQ]] THEN
    REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM] THEN
    MATCH_MP_TAC (← MESON [LIM_CONST, LIM_UNIQUE, TRIVIAL_LIMIT_SEQUENTIALLY]
     (← q r"((\x. a) --> b) sequentially ==> a = b")) THEN
    MATCH_MP_TAC LIM_NULL_COMPARISON THEN
    EXISTS_TAC
     (← q r"\n. hausdist(convex hull t,convex hull ((s:num->real^N->bool) n)) +
          hausdist(s n,t)") THEN
    REWRITE_TAC [NORM_LIFT, REAL_ABS_HAUSDIST] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MONO)) THEN
      SIMP_TAC [HULL_P] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC HAUSDIST_TRIANGLE THEN
      ASM_SIMP_TAC [COMPACT_CONVEX_HULL, COMPACT_IMP_BOUNDED],
      REWRITE_TAC [LIFT_ADD] THEN MATCH_MP_TAC LIM_NULL_ADD THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            LIM_NULL_COMPARISON)) THEN
      REWRITE_TAC [NORM_LIFT, REAL_ABS_HAUSDIST] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            EVENTUALLY_MONO)) THEN
      REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC RAND_CONV [HAUSDIST_SYM] THEN
      MATCH_MP_TAC HAUSDIST_CONVEX_HULLS THEN
      ASM_SIMP_TAC [COMPACT_IMP_BOUNDED]])

  let COMPLETE_HAUSDIST_CONVEX ← prove
   r"!f:num->(real^N->bool) c.
        closed c /\
        (!n. bounded(f n) /\ convex(f n) /\ ~(f n = {}) /\ f n SUBSET c) /\
        (!e. &0 < e
             ==> ?N. !m n. m >= N /\ n >= N ==> hausdist(f m,f n) < e)
        ==> ?s. compact s /\ convex s /\ ~(s = {}) /\ s SUBSET c /\
                ((\n. lift(hausdist(f n,s))) --> vec 0) sequentially"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->(real^N->bool)", ← q r"c:real^N->bool"]
          COMPLETE_HAUSDIST) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    GEN_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONVEX_HAUSDIST_LIMIT THEN
    EXISTS_TAC (← q r"f:num->real^N->bool") THEN
    ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY])

  let COMPLETE_HAUSDIST_CONVEX_UNIV ← prove
   r"!f:num->(real^N->bool).
        (!n. bounded(f n) /\ convex(f n) /\ ~(f n = {})) /\
        (!e. &0 < e
             ==> ?N. !m n. m >= N /\ n >= N ==> hausdist(f m,f n) < e)
        ==> ?s. compact s /\ convex s /\ ~(s = {}) /\
                ((\n. lift(hausdist(f n,s))) --> vec 0) sequentially"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->(real^N->bool)", ← q r"(:real^N)"]
          COMPLETE_HAUSDIST_CONVEX) THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, CLOSED_UNIV])

  let BLASCHKE ← prove
   r"!f:num->(real^N->bool) c.
        compact c /\ (!n. convex(f n) /\ ~(f n = {}) /\ f n SUBSET c)
        ==> ?r s. (!m n. m < n ==> r m < r n) /\
                  compact s /\ convex s /\ ~(s = {}) /\ s SUBSET c /\
                  ((\n. lift(hausdist(f(r n),s))) --> vec 0) sequentially"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->(real^N->bool)", ← q r"c:real^N->bool"]
          COMPACT_HAUSDIST) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONVEX_HAUSDIST_LIMIT THEN
    EXISTS_TAC (← q r"(f:num->real^N->bool) o (r:num->num)") THEN
    ASM_REWRITE_TAC [o_THM, EVENTUALLY_SEQUENTIALLY] THEN
    ASM_MESON_TAC [BOUNDED_SUBSET, COMPACT_IMP_BOUNDED])

  let BLASCHKE_UNIV ← prove
   r"!f:num->(real^N->bool) c.
        bounded c /\ (!n. convex(f n) /\ ~(f n = {}) /\ f n SUBSET c)
        ==> ?r s. (!m n. m < n ==> r m < r n) /\
                  compact s /\ convex s /\ ~(s = {}) /\
                  ((\n. lift(hausdist(f(r n),s))) --> vec 0) sequentially"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->(real^N->bool)", ← q r"closure c:real^N->bool"]
          BLASCHKE) THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE] THEN
    ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    ASM_MESON_TAC [SUBSET, CLOSURE_SUBSET])

  return { CONVEX_HAUSDIST_LIMIT, COMPLETE_HAUSDIST_CONVEX, COMPLETE_HAUSDIST_CONVEX_UNIV,
           BLASCHKE, BLASCHKE_UNIV }

/- ------------------------------------------------------------------------- -/
/- Interior, relative interior and closure interrelations (part 1).          -/
/- (convex.ml 13511-13697)                                                   -/
/- ------------------------------------------------------------------------- -/

structure IRA where
  CONVEX_CLOSURE_INTERIOR : thm
  EMPTY_INTERIOR_SUBSET_HYPERPLANE : thm
  CONVEX_INTERIOR_CLOSURE : thm
  FRONTIER_CLOSURE_CONVEX : thm
  CONVEX_CLOSURE_RELATIVE_INTERIOR : thm
  OPEN_IN_CONVEX_MEETS_RELATIVE_INTERIOR : thm
  OPEN_SUBSET_CLOSURE_CONVEX : thm
  SETDIST_RELATIVE_INTERIOR : thm
  HAUSDIST_RELATIVE_INTERIOR : thm
  AFFINE_HULL_RELATIVE_INTERIOR : thm
  AFF_DIM_RELATIVE_INTERIOR : thm
  deriving Inhabited

@[nospecialize]
def setupIRA [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCLH : CLH) (BADA : ADA) (BSHR : SHR)
    (BRIA : RIA) (BRIB : RIB) (BRIC : RIC) : ExceptT String IO IRA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        VECTOR_ARITH, NORM_ARITH, .. } := D
  let { ARITH, CONTRAPOS_THM, DIMINDEX_GE_1, EMPTY_SUBSET, EQ_IMP, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNION, LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_EXISTS_THM, NOT_LT, REAL_ABS_DIV, REAL_ADD_RDISTRIB,
        REAL_DIV_RMUL, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_ADDL, REAL_LE_LDIV_EQ, REAL_LE_REFL, REAL_LE_RMUL,
        REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_NZ, REAL_LT_MIN, REAL_MIN_LE, .. } := D.core4
  let { REAL_MUL_LID, REAL_OF_NUM_LT, REAL_SUB_REFL, SUBSET, SUBSET_ANTISYM, SUBSET_REFL,
        SUBSET_TRANS, .. } := D.core5
  let { SUBSET_UNIV, UNWIND_THM2, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { BASIS_NONZERO, DIM_EQ_SPAN, DIM_UNIV, DOT_RADD, .. } := D.vec1
  let { LOWDIM_SUBSET_HYPERPLANE, NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, REAL_ABS_NORM, SPAN_INC, SPAN_UNIV, .. } := D.vec3
  let { VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, .. } := D.vec4
  let { CLOSED_HYPERPLANE, CLOSURE_CLOSURE, .. } := D.top1
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, .. } := D.top2
  let { HAUSDIST_CLOSURE, .. } := D.top3
  let { INTERIOR_HYPERPLANE, INTERIOR_OPEN, INTERIOR_SUBSET, INTERIOR_TRANSLATION, IN_CBALL,
        IN_INTERIOR_CBALL, LIMPT_APPROACHABLE, .. } := D.top4
  let { OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_IN_OPEN, SETDIST_CLOSURE, SUBSET_CLOSURE,
        SUBSET_INTERIOR, closure, frontier, .. } := D.top5
  let { CONVEX_TRANSLATION_EQ, .. } := BCVX
  let { AFFINE_HULL_EQ_SPAN, AFFINE_HULL_CLOSURE, .. } := BCLH
  let { AFF_DIM_AFFINE_HULL, .. } := BADA
  let { IN_INTERIOR_CLOSURE_CONVEX_SHRINK, .. } := BSHR
  let { RELATIVE_INTERIOR_SUBSET, .. } := BRIA
  let { RELATIVE_INTERIOR_EQ_EMPTY, RELATIVE_INTERIOR_INTERIOR, .. } := BRIB
  let { IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK, .. } := BRIC
  -- @@SCOPE END

  let CONVEX_CLOSURE_INTERIOR ← prove
   r"!s:real^N->bool.
        convex s /\ ~(interior s = {})
        ==> closure(interior s) = closure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [SUBSET_CLOSURE, INTERIOR_SUBSET] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN REWRITE_TAC [SUBSET] THEN
    X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THENL
     [ASM_MESON_TAC [CLOSURE_SUBSET, SUBSET], ALL_TAC] THEN
    REWRITE_TAC [closure, IN_UNION, IN_ELIM_THM] THEN DISJ2_TAC THEN
    REWRITE_TAC [LIMPT_APPROACHABLE] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"b - min (e / &2 / norm(b - a)) (&1) % (b - a):real^N") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC IN_INTERIOR_CLOSURE_CONVEX_SHRINK THEN
      ASM_REWRITE_TAC [REAL_MIN_LE, REAL_LT_MIN, REAL_LE_REFL, REAL_LT_01],
      REWRITE_TAC [← VECTOR_ARITH (← q r"b - x:real^N = b <=> x = vec 0")] THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> ~(min x (&1) = &0)")),
      REWRITE_TAC [← NORM_ARITH (← q r"dist(b - x:real^N,b) = norm x")] THEN
      REWRITE_TAC [NORM_MUL] THEN MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC (← q r"e / &2 / norm(b - a:real^N) * norm(b - a)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> abs(min x (&1)) <= x")),
        ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_POS_LT, REAL_LT_IMP_NZ,
                      VECTOR_SUB_EQ] THEN
        ASM_REAL_ARITH_TAC]] THEN
    ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT, REAL_OF_NUM_LT,
                  VECTOR_SUB_EQ, ARITH])

  let EMPTY_INTERIOR_SUBSET_HYPERPLANE ← do
    let lemma ← prove
     r"!s. convex s /\ (vec 0) IN s /\ interior s = {}
           ==> ?a:real^N b. ~(a = vec 0) /\ s SUBSET {x | a dot x = b}"
     (GEN_TAC THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"~(relative_interior(s:real^N->bool) = {})") MP_TAC THENL
       [ASM_MESON_TAC [RELATIVE_INTERIOR_EQ_EMPTY, MEMBER_NOT_EMPTY], ALL_TAC] THEN
      ASM_REWRITE_TAC [CONTRAPOS_THM] THEN MATCH_MP_TAC EQ_IMP THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC RELATIVE_INTERIOR_INTERIOR THEN
      ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC] THEN
      ONCE_REWRITE_TAC [← GSYM SPAN_UNIV] THEN MATCH_MP_TAC DIM_EQ_SPAN THEN
      REWRITE_TAC [SUBSET_UNIV, DIM_UNIV, ← GSYM NOT_LT] THEN
      DISCH_THEN (MP_TAC o MATCH_MP LOWDIM_SUBSET_HYPERPLANE) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN EXISTS_TAC (← q r"&0") THEN
      ASM_MESON_TAC [SUBSET_TRANS, SPAN_INC])
    prove
     r"!s. convex s /\ interior s = {}
         ==> ?a:real^N b. ~(a = vec 0) /\ s SUBSET {x | a dot x = b}"
     (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
       [ASM_MESON_TAC [EMPTY_SUBSET, BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1],
        ALL_TAC] THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
      MP_TAC (← ISPEC (← q r"IMAGE (\x:real^N. --a + x) s") lemma) THEN
      ASM_REWRITE_TAC [CONVEX_TRANSLATION_EQ, INTERIOR_TRANSLATION,
                       IMAGE_EQ_EMPTY, IN_IMAGE, UNWIND_THM2,
                       ← VECTOR_ARITH (← q r"vec 0:real^N = --a + x <=> x = a")] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^N") THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, DOT_RADD] THEN
      MESON_TAC [← REAL_ARITH (← q r"a + x:real = b <=> x = b - a")])

  let CONVEX_INTERIOR_CLOSURE ← prove
   r"!s:real^N->bool. convex s ==> interior(closure s) = interior s"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"interior(s:real^N->bool) = {}") THENL
     [MP_TAC (← ISPEC (← q r"s:real^N->bool") EMPTY_INTERIOR_SUBSET_HYPERPLANE) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real"] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← SET_RULE (← q r"!t. s SUBSET t /\ t = {} ==> s = {}")) THEN
      EXISTS_TAC (← q r"interior {x:real^N | a dot x = b}") THEN CONJ_TAC THENL
       [ALL_TAC,  ASM_SIMP_TAC [INTERIOR_HYPERPLANE]] THEN
      MATCH_MP_TAC SUBSET_INTERIOR THEN MATCH_MP_TAC CLOSURE_MINIMAL THEN
      ASM_REWRITE_TAC [CLOSED_HYPERPLANE],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [SUBSET_INTERIOR, CLOSURE_SUBSET] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    MP_TAC (← ASSUME (← q r"(b:real^N) IN interior(closure s)")) THEN
    GEN_REWRITE_TAC LAND_CONV [IN_INTERIOR_CBALL] THEN
    REWRITE_TAC [SUBSET, IN_CBALL, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"b + e / norm(b - a) % (b - a):real^N")) THEN
    ASM_SIMP_TAC [← NORM_ARITH (← q r"dist(b:real^N,b + e) = norm e"), NORM_MUL,
      REAL_ABS_DIV, REAL_ABS_NORM, REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ,
      ← REAL_ARITH (← q r"&0 < e ==> abs e <= e")] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"b = (b + e / norm(b - a) % (b - a)) -
          e / norm(b - a) / (&1 + e / norm(b - a)) %
          ((b + e / norm(b - a) % (b - a)) - a):real^N")
    SUBST1_TAC THENL
     [REWRITE_TAC [← VECTOR_ARITH
       (← q r"b = (b + e % (b - a)) - d % ((b + e % (b - a)) - a) <=>
        (e - d * (&1 + e)) % (b - a) = vec 0")] THEN
      ASM_REWRITE_TAC [VECTOR_SUB_EQ, VECTOR_MUL_EQ_0],
      MATCH_MP_TAC IN_INTERIOR_CLOSURE_CONVEX_SHRINK] THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_DIV, NORM_POS_LT,
                  VECTOR_SUB_EQ, ← REAL_ARITH (← q r"&0 < x ==> &0 < &1 + x"),
                  ← REAL_ARITH (← q r"&0 < x ==> ~(&1 + x = &0)"),
                  REAL_MUL_LID, REAL_ADD_RDISTRIB, REAL_DIV_RMUL,
                  REAL_LT_IMP_NZ, REAL_LE_ADDL, NORM_POS_LE, REAL_SUB_REFL])

  let FRONTIER_CLOSURE_CONVEX ← prove
   r"!s:real^N->bool. convex s ==> frontier(closure s) = frontier s"
   (SIMP_TAC [frontier, CLOSURE_CLOSURE, CONVEX_INTERIOR_CLOSURE])

  let CONVEX_CLOSURE_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool.
        convex s ==> closure(relative_interior s) = closure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [SUBSET_CLOSURE, RELATIVE_INTERIOR_SUBSET] THEN
    ASM_CASES_TAC (← q r"relative_interior(s:real^N->bool) = {}") THENL
     [ASM_MESON_TAC [RELATIVE_INTERIOR_EQ_EMPTY, SUBSET_REFL], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN REWRITE_TAC [SUBSET] THEN
    X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THENL
     [ASM_MESON_TAC [CLOSURE_SUBSET, SUBSET], ALL_TAC] THEN
    REWRITE_TAC [closure, IN_UNION, IN_ELIM_THM] THEN DISJ2_TAC THEN
    REWRITE_TAC [LIMPT_APPROACHABLE] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"b - min (e / &2 / norm(b - a)) (&1) % (b - a):real^N") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK THEN
      ASM_REWRITE_TAC [REAL_MIN_LE, REAL_LT_MIN, REAL_LE_REFL, REAL_LT_01],
      REWRITE_TAC [← VECTOR_ARITH (← q r"b - x:real^N = b <=> x = vec 0")] THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> ~(min x (&1) = &0)")),
      REWRITE_TAC [← NORM_ARITH (← q r"dist(b - x:real^N,b) = norm x")] THEN
      REWRITE_TAC [NORM_MUL] THEN MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC (← q r"e / &2 / norm(b - a:real^N) * norm(b - a)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> abs(min x (&1)) <= x")),
        ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_POS_LT, REAL_LT_IMP_NZ,
                      VECTOR_SUB_EQ] THEN
        ASM_REAL_ARITH_TAC]] THEN
    ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT, REAL_OF_NUM_LT,
                  VECTOR_SUB_EQ, ARITH])

  let OPEN_IN_CONVEX_MEETS_RELATIVE_INTERIOR ← prove
   r"!u s:real^N->bool.
        convex u /\ open_in (subtopology euclidean u) s /\ ~(s = {})
        ==> ~(s INTER relative_interior u = {})"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"v:real^N->bool") STRIP_ASSUME_TAC o GSYM o
      REWRITE_RULE [OPEN_IN_OPEN]) THEN
    MP_TAC (← ISPECL [← q r"v:real^N->bool", ← q r"relative_interior u:real^N->bool"]
          OPEN_INTER_CLOSURE_EQ_EMPTY) THEN
    ASM_SIMP_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR] THEN
    MP_TAC (← ISPEC (← q r"u:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"u:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC [])

  let OPEN_SUBSET_CLOSURE_CONVEX ← prove
   r"!u s:real^N->bool.
        open u /\ convex s ==> (u SUBSET closure s <=> u SUBSET interior s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [INTERIOR_SUBSET, CLOSURE_SUBSET, SUBSET]] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SUBSET_INTERIOR) THEN
    ASM_SIMP_TAC [CONVEX_INTERIOR_CLOSURE, INTERIOR_OPEN])

  let SETDIST_RELATIVE_INTERIOR ← prove
   r"(!s t. convex s ==> setdist(relative_interior s,t) = setdist(s,t)) /\
   (!s t. convex t ==> setdist(s,relative_interior t) = setdist(s,t))"
   (MESON_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR, SETDIST_CLOSURE])

  let HAUSDIST_RELATIVE_INTERIOR ← prove
   r"(!s t. convex s ==> hausdist(relative_interior s,t) = hausdist(s,t)) /\
   (!s t. convex t ==> hausdist(s,relative_interior t) = hausdist(s,t))"
   (MESON_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR, HAUSDIST_CLOSURE])

  let AFFINE_HULL_RELATIVE_INTERIOR ← prove
   r"!s. convex s
       ==> affine hull (relative_interior s) = affine hull s"
   (MESON_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR, AFFINE_HULL_CLOSURE])

  let AFF_DIM_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool. convex s ==> aff_dim(relative_interior s) = aff_dim s"
   (ASM_MESON_TAC [AFF_DIM_AFFINE_HULL, AFFINE_HULL_RELATIVE_INTERIOR])

  return { CONVEX_CLOSURE_INTERIOR, EMPTY_INTERIOR_SUBSET_HYPERPLANE, CONVEX_INTERIOR_CLOSURE,
           FRONTIER_CLOSURE_CONVEX, CONVEX_CLOSURE_RELATIVE_INTERIOR,
           OPEN_IN_CONVEX_MEETS_RELATIVE_INTERIOR, OPEN_SUBSET_CLOSURE_CONVEX,
           SETDIST_RELATIVE_INTERIOR, HAUSDIST_RELATIVE_INTERIOR, AFFINE_HULL_RELATIVE_INTERIOR,
           AFF_DIM_RELATIVE_INTERIOR }

/- ------------------------------------------------------------------------- -/
/- Interior, relative interior and closure interrelations (part 2).          -/
/- (convex.ml 13697-13914)                                                   -/
/- ------------------------------------------------------------------------- -/

structure IRB where
  CONVEX_RELATIVE_INTERIOR_CLOSURE : thm
  RELATIVE_FRONTIER_CLOSURE : thm
  RELATIVE_FRONTIER_RELATIVE_INTERIOR : thm
  CONNECTED_INTER_RELATIVE_FRONTIER : thm
  CLOSED_RELATIVE_FRONTIER : thm
  CLOSED_RELATIVE_BOUNDARY : thm
  COMPACT_RELATIVE_BOUNDARY : thm
  BOUNDED_RELATIVE_FRONTIER : thm
  COMPACT_RELATIVE_FRONTIER_BOUNDED : thm
  COMPACT_RELATIVE_FRONTIER : thm
  CONVEX_SAME_RELATIVE_INTERIOR_CLOSURE : thm
  CONVEX_SAME_RELATIVE_INTERIOR_CLOSURE_STRADDLE : thm
  RELATIVE_INTERIOR_LINEAR_IMAGE_CONVEX : thm
  RELATIVE_INTERIOR_LINEAR_PREIMAGE_CONVEX : thm
  deriving Inhabited

@[nospecialize]
def setupIRB [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BCVA : CVA) (BCLH : CLH)
    (BRIA : RIA) (BRIB : RIB) (BRIC : RIC) (BRIE : RIE) (BRIH : RIH) (BIRA : IRA) :
    ExceptT String IO IRB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH,
        NORM_ARITH, .. } := D
  let { EXISTS_IN_IMAGE, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMAGE_SUBSET, .. } := D.core2
  let { IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS,
        REAL_ABS_DIV, REAL_ADD_RDISTRIB, REAL_DIV_RMUL, .. } := D.core3
  let { REAL_LE_ADDL, REAL_LE_LDIV_EQ, REAL_LT_DIV, REAL_LT_IMP_NZ, .. } := D.core4
  let { REAL_MUL_LID, REAL_SUB_REFL, SUBSET, SUBSET_ANTISYM, SUBSET_DIFF, SUBSET_TRANS, .. } :=
    D.core5
  let { SUBSET_UNIV, .. } := D.core6
  let { HULL_INC, HULL_MINIMAL, HULL_SUBSET, .. } := D.misc
  let { LINEAR_ADD, LINEAR_CMUL, LINEAR_SUB, NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, .. } := D.vec4
  let { CLOSED_IN_DIFF, OPEN_IN_INTER, OPEN_IN_SUBSET_TRANS, OPEN_IN_SUBTOPOLOGY_INTER_SUBSET,
        OPEN_IN_SUBTOPOLOGY_REFL, .. } := D.met
  let { BOUNDED_CLOSURE, BOUNDED_DIFF, BOUNDED_SUBSET, CLOSED_CLOSURE, CLOSED_IN_CLOSED_TRANS,
        CLOSED_SUBSET, CLOSURE_CLOSED, CLOSURE_CLOSURE, CLOSURE_EMPTY, CLOSURE_EQ, .. } :=
    D.top1
  let { CLOSURE_LINEAR_IMAGE_SUBSET, CLOSURE_SUBSET, COMPACT_EQ_BOUNDED_CLOSED,
        COMPACT_IMP_BOUNDED, CONNECTED_OPEN_IN, .. } := D.top2
  let { CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := D.top3
  let { IN_CBALL, LINEAR_CONTINUOUS_ON, .. } := D.top4
  let { OPEN_IN_OPEN_INTER, SUBSET_CLOSURE, TOPSPACE_EUCLIDEAN, closed, .. } := D.top5
  let { AFFINE_LINEAR_PREIMAGE, AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { CONVEX_LINEAR_IMAGE, .. } := BCVX
  let { CONVEX_LINEAR_PREIMAGE, .. } := BCVA
  let { CLOSED_AFFINE_HULL, CLOSURE_SUBSET_AFFINE_HULL, AFFINE_HULL_CLOSURE, .. } := BCLH
  let { relative_frontier, RELATIVE_INTERIOR_EMPTY, OPEN_IN_RELATIVE_INTERIOR,
        RELATIVE_INTERIOR_SUBSET, RELATIVE_INTERIOR_MAXIMAL, IN_RELATIVE_INTERIOR,
        IN_RELATIVE_INTERIOR_CBALL, .. } := BRIA
  let { RELATIVE_INTERIOR_EQ_EMPTY, .. } := BRIB
  let { CONVEX_RELATIVE_INTERIOR, IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK, .. } := BRIC
  let { RELATIVE_INTERIOR_PROLONG, RELATIVE_INTERIOR_CONVEX_PROLONG, .. } := BRIE
  let { SUBSET_RELATIVE_INTERIOR_INTERSECTING_CONVEX, .. } := BRIH
  let { CONVEX_CLOSURE_RELATIVE_INTERIOR, .. } := BIRA
  -- @@SCOPE END

  let CONVEX_RELATIVE_INTERIOR_CLOSURE ← prove
   r"!s:real^N->bool.
        convex s ==> relative_interior(closure s) = relative_interior s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [CLOSURE_EMPTY, RELATIVE_INTERIOR_EMPTY] THEN
    SUBGOAL_THEN (← q r"?a:real^N. a IN relative_interior s") STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [MEMBER_NOT_EMPTY, RELATIVE_INTERIOR_EQ_EMPTY],
      ALL_TAC] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [SUBSET] THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [IN_RELATIVE_INTERIOR, AFFINE_HULL_CLOSURE, SUBSET] THEN
      MESON_TAC [CLOSURE_SUBSET, SUBSET]] THEN
    X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    MP_TAC (← ASSUME (← q r"(b:real^N) IN relative_interior(closure s)")) THEN
    GEN_REWRITE_TAC LAND_CONV [IN_RELATIVE_INTERIOR_CBALL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [SUBSET, IN_CBALL, IN_INTER, LEFT_IMP_EXISTS_THM,
                 AFFINE_HULL_CLOSURE] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"b + e / norm(b - a) % (b - a):real^N")) THEN
    ASM_SIMP_TAC [← NORM_ARITH (← q r"dist(b:real^N,b + e) = norm e"), NORM_MUL,
      REAL_ABS_DIV, REAL_ABS_NORM, REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ,
      ← REAL_ARITH (← q r"&0 < e ==> abs e <= e")] THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC IN_AFFINE_ADD_MUL_DIFF THEN
      ASM_MESON_TAC [SUBSET, AFFINE_AFFINE_HULL, RELATIVE_INTERIOR_SUBSET,
                     CLOSURE_SUBSET_AFFINE_HULL, HULL_INC],
      ALL_TAC] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"b = (b + e / norm(b - a) % (b - a)) -
          e / norm(b - a) / (&1 + e / norm(b - a)) %
          ((b + e / norm(b - a) % (b - a)) - a):real^N")
    SUBST1_TAC THENL
     [REWRITE_TAC [← VECTOR_ARITH
       (← q r"b = (b + e % (b - a)) - d % ((b + e % (b - a)) - a) <=>
        (e - d * (&1 + e)) % (b - a) = vec 0")] THEN
      ASM_REWRITE_TAC [VECTOR_SUB_EQ, VECTOR_MUL_EQ_0],
      MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK] THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_DIV, NORM_POS_LT,
                  VECTOR_SUB_EQ, ← REAL_ARITH (← q r"&0 < x ==> &0 < &1 + x"),
                  ← REAL_ARITH (← q r"&0 < x ==> ~(&1 + x = &0)"),
                  REAL_MUL_LID, REAL_ADD_RDISTRIB, REAL_DIV_RMUL,
                  REAL_LT_IMP_NZ, REAL_LE_ADDL, NORM_POS_LE, REAL_SUB_REFL])

  let RELATIVE_FRONTIER_CLOSURE ← prove
   r"!s. convex s ==> relative_frontier(closure s) = relative_frontier s"
   (SIMP_TAC [relative_frontier, CLOSURE_CLOSURE,
              CONVEX_RELATIVE_INTERIOR_CLOSURE])

  let RELATIVE_FRONTIER_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool.
        convex s
        ==> relative_frontier(relative_interior s) = relative_frontier s"
   (ASM_MESON_TAC [RELATIVE_FRONTIER_CLOSURE, CONVEX_CLOSURE_RELATIVE_INTERIOR,
                   CONVEX_RELATIVE_INTERIOR])

  let CONNECTED_INTER_RELATIVE_FRONTIER ← prove
   r"!s t:real^N->bool.
        connected s /\ s SUBSET affine hull t /\
        ~(s INTER t = {}) /\ ~(s DIFF t = {})
        ==> ~(s INTER relative_frontier t = {})"
   (REWRITE_TAC [relative_frontier] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_OPEN_IN]) THEN
    REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC
     [← q r"s INTER relative_interior t:real^N->bool",
      ← q r"s DIFF closure t:real^N->bool"] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
      EXISTS_TAC (← q r"affine hull t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC OPEN_IN_INTER THEN
      REWRITE_TAC [OPEN_IN_RELATIVE_INTERIOR, OPEN_IN_SUBTOPOLOGY_REFL] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV],
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
      MATCH_MP_TAC OPEN_IN_OPEN_INTER THEN
      REWRITE_TAC [← GSYM closed, CLOSED_CLOSURE],
      ASM SET_TAC [],
      MATCH_MP_TAC (← SET_RULE
       (← q r"i SUBSET t /\ t SUBSET c ==> (s INTER i) INTER (s DIFF c) = {}")) THEN
      REWRITE_TAC [RELATIVE_INTERIOR_SUBSET, CLOSURE_SUBSET],
      MP_TAC (← ISPEC (← q r"t:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC [],
      MP_TAC (← ISPEC (← q r"t:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN
      ASM SET_TAC []])

  let CLOSED_RELATIVE_FRONTIER ← prove
   r"!s:real^N->bool. closed(relative_frontier s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [relative_frontier] THEN
    MATCH_MP_TAC CLOSED_IN_CLOSED_TRANS THEN
    EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
    REWRITE_TAC [CLOSED_AFFINE_HULL] THEN MATCH_MP_TAC CLOSED_IN_DIFF THEN
    REWRITE_TAC [OPEN_IN_RELATIVE_INTERIOR] THEN
    MATCH_MP_TAC CLOSED_SUBSET THEN REWRITE_TAC [CLOSED_CLOSURE] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET closure t /\ closure t = t ==> s SUBSET t")) THEN
    SIMP_TAC [SUBSET_CLOSURE, HULL_SUBSET, CLOSURE_EQ, CLOSED_AFFINE_HULL])

  let CLOSED_RELATIVE_BOUNDARY ← prove
   r"!s. closed s ==> closed(s DIFF relative_interior s)"
   (MESON_TAC [CLOSED_RELATIVE_FRONTIER, relative_frontier, CLOSURE_CLOSED])

  let COMPACT_RELATIVE_BOUNDARY ← prove
   r"!s. compact s ==> compact(s DIFF relative_interior s)"
   (SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_RELATIVE_BOUNDARY,
              BOUNDED_DIFF])

  let BOUNDED_RELATIVE_FRONTIER ← prove
   r"!s:real^N->bool. bounded s ==> bounded(relative_frontier s)"
   (REWRITE_TAC [relative_frontier] THEN
    MESON_TAC [BOUNDED_CLOSURE, BOUNDED_SUBSET, SUBSET_DIFF])

  let COMPACT_RELATIVE_FRONTIER_BOUNDED ← prove
   r"!s:real^N->bool. bounded s ==> compact(relative_frontier s)"
   (SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_RELATIVE_FRONTIER,
              BOUNDED_RELATIVE_FRONTIER])

  let COMPACT_RELATIVE_FRONTIER ← prove
   r"!s:real^N->bool. compact s ==> compact(relative_frontier s)"
   (SIMP_TAC [COMPACT_RELATIVE_FRONTIER_BOUNDED, COMPACT_IMP_BOUNDED])

  let CONVEX_SAME_RELATIVE_INTERIOR_CLOSURE ← prove
   r"!s t. convex s /\ convex t
         ==> (relative_interior s = relative_interior t <=>
              closure s = closure t)"
   (MESON_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR,
               CONVEX_RELATIVE_INTERIOR_CLOSURE])

  let CONVEX_SAME_RELATIVE_INTERIOR_CLOSURE_STRADDLE ← prove
   r"!s t. convex s /\ convex t
         ==> (relative_interior s = relative_interior t <=>
              relative_interior s SUBSET t /\ t SUBSET closure s)"
   (MESON_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR,
               CONVEX_RELATIVE_INTERIOR_CLOSURE, SUBSET_CLOSURE,
               SUBSET_ANTISYM, RELATIVE_INTERIOR_SUBSET,
               CLOSURE_SUBSET, CLOSURE_CLOSURE])

  let RELATIVE_INTERIOR_LINEAR_IMAGE_CONVEX ← prove
   r"!f:real^M->real^N s.
        linear f /\ convex s
        ==> relative_interior(IMAGE f s) = IMAGE f (relative_interior s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"relative_interior (IMAGE f (relative_interior s)) =
        relative_interior (IMAGE (f:real^M->real^N) s)")
       (fun th => tactic_of do
         pure (REWRITE_TAC [← SYM th, RELATIVE_INTERIOR_SUBSET])) THEN
      ASM_SIMP_TAC [CONVEX_SAME_RELATIVE_INTERIOR_CLOSURE_STRADDLE,
                    CONVEX_RELATIVE_INTERIOR, CONVEX_LINEAR_IMAGE] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUBSET_TRANS THEN
        EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (relative_interior s)") THEN
        SIMP_TAC [RELATIVE_INTERIOR_SUBSET, IMAGE_SUBSET],
        MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC
          (← q r"IMAGE (f:real^M->real^N) (closure(relative_interior s))") THEN
        ASM_SIMP_TAC [CLOSURE_LINEAR_IMAGE_SUBSET] THEN
        ASM_SIMP_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR] THEN
        MATCH_MP_TAC IMAGE_SUBSET THEN REWRITE_TAC [CLOSURE_SUBSET]],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"z:real^M") THEN
      DISCH_TAC THEN
      ASM_SIMP_TAC [RELATIVE_INTERIOR_CONVEX_PROLONG, CONVEX_LINEAR_IMAGE] THEN
      REWRITE_TAC [IN_ELIM_THM, FORALL_IN_IMAGE] THEN CONJ_TAC THENL
       [MATCH_MP_TAC FUN_IN_IMAGE THEN
        ASM_MESON_TAC [SUBSET, RELATIVE_INTERIOR_SUBSET],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"z:real^M", ← q r"x:real^M"]
          RELATIVE_INTERIOR_PROLONG) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real") THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"f:real^M->real^N") o MATCH_MP FUN_IN_IMAGE) THEN
      ASM_MESON_TAC [LINEAR_ADD, LINEAR_SUB, LINEAR_CMUL]])

  let RELATIVE_INTERIOR_LINEAR_PREIMAGE_CONVEX ← prove
   r"!f:real^M->real^N s.
        linear f /\ convex s /\ ~({x | f(x) IN relative_interior s} = {})
        ==> relative_interior {x | f(x) IN s} =
            {x | f(x) IN relative_interior s}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"IMAGE f s SUBSET t ==> s SUBSET {x | f x IN t}")) THEN
      ASM_SIMP_TAC [← GSYM RELATIVE_INTERIOR_LINEAR_IMAGE_CONVEX,
                    CONVEX_LINEAR_PREIMAGE, CONVEX_RELATIVE_INTERIOR] THEN
      MATCH_MP_TAC SUBSET_RELATIVE_INTERIOR_INTERSECTING_CONVEX THEN
      ASM_SIMP_TAC [CONVEX_LINEAR_IMAGE, CONVEX_LINEAR_PREIMAGE] THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, EXISTS_IN_IMAGE] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC RELATIVE_INTERIOR_MAXIMAL THEN CONJ_TAC THENL
       [MP_TAC (← ISPEC (← q r"s:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN
        SET_TAC [],
        MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
        EXISTS_TAC (← q r"{x | (f:real^M->real^N) x IN affine hull s}") THEN
        REPEAT CONJ_TAC THENL
         [SUBGOAL_THEN
           (← q r"{x | f x IN relative_interior s} =
            {x | x IN {x | (f:real^M->real^N) x IN affine hull s} /\
                 f x IN relative_interior s}")
          SUBST1_TAC THENL
           [REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC (← SET_RULE
             (← q r"relative_interior s SUBSET s /\ s SUBSET affine hull s
              ==> {x | f x IN relative_interior s} =
                  {x | f x IN affine hull s /\ f x IN relative_interior s}")) THEN
            REWRITE_TAC [RELATIVE_INTERIOR_SUBSET, HULL_SUBSET],
            MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
            EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
            ASM_SIMP_TAC [OPEN_IN_RELATIVE_INTERIOR, LINEAR_CONTINUOUS_ON] THEN
            SET_TAC []],
          REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN
          MATCH_MP_TAC HULL_INC THEN
          MP_TAC (← ISPEC (← q r"s:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN
          ASM SET_TAC [],
          MATCH_MP_TAC HULL_MINIMAL THEN
          ASM_SIMP_TAC [AFFINE_LINEAR_PREIMAGE, AFFINE_AFFINE_HULL] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"s SUBSET t ==> {x | f x IN s} SUBSET {x | f x IN t}")) THEN
          REWRITE_TAC [HULL_SUBSET]]]])

  return { CONVEX_RELATIVE_INTERIOR_CLOSURE, RELATIVE_FRONTIER_CLOSURE,
           RELATIVE_FRONTIER_RELATIVE_INTERIOR, CONNECTED_INTER_RELATIVE_FRONTIER,
           CLOSED_RELATIVE_FRONTIER, CLOSED_RELATIVE_BOUNDARY, COMPACT_RELATIVE_BOUNDARY,
           BOUNDED_RELATIVE_FRONTIER, COMPACT_RELATIVE_FRONTIER_BOUNDED,
           COMPACT_RELATIVE_FRONTIER, CONVEX_SAME_RELATIVE_INTERIOR_CLOSURE,
           CONVEX_SAME_RELATIVE_INTERIOR_CLOSURE_STRADDLE,
           RELATIVE_INTERIOR_LINEAR_IMAGE_CONVEX, RELATIVE_INTERIOR_LINEAR_PREIMAGE_CONVEX }

/- ------------------------------------------------------------------------- -/
/- Interior, relative interior and closure interrelations (part 3).          -/
/- (convex.ml 13914-14148)                                                   -/
/- ------------------------------------------------------------------------- -/

structure IRC where
  RELATIVE_INTERIOR_SUMS : thm
  CLOSURE_INTERS_CONVEX : thm
  CLOSURE_INTERS_CONVEX_OPEN : thm
  CLOSURE_INTER_CONVEX : thm
  CLOSURE_INTER_CONVEX_OPEN : thm
  CLOSURE_CONVEX_INTER_SUPERSET : thm
  CLOSURE_DYADIC_RATIONALS_IN_CONVEX_SET : thm
  CLOSURE_RATIONALS_IN_CONVEX_SET : thm
  RELATIVE_INTERIOR_CONVEX_INTER_AFFINE : thm
  CONNECTED_WITH_RELATIVE_INTERIOR_OPEN_IN_CONVEX : thm
  RELATIVE_INTERIOR_CBALL_INTER_AFFINE : thm
  deriving Inhabited

@[nospecialize]
def setupIRC [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVS : CVS) (BCOP : COP) (BCVB : CVB)
    (BCLH : CLH) (BADC : ADC) (BSHR : SHR) (BRIA : RIA) (BRIB : RIB) (BRIC : RIC)
    (BRIG : RIG) (BIRA : IRA) (BIRB : IRB) : ExceptT String IO IRC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, NORM_ARITH, GEOM_ORIGIN_TAC, .. } := D
  let { EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FSTCART_PASTECART, IMAGE_CLAUSES, INTERS_2,
        INTERS_IMAGE, INTER_COMM, INTER_EMPTY, INTER_SUBSET, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_INTERS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        NOT_EXISTS_THM, NOT_IN_EMPTY, PASTECART_IN_PCROSS, REAL_ABS_DIV, REAL_DIV_RMUL, .. } :=
    D.core3
  let { REAL_INV_LT_1, REAL_LT_DIV, REAL_LT_DIV2_EQ, REAL_LT_IMP_LE, REAL_LT_INV_EQ,
        REAL_LT_MIN, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_LINV, RIGHT_AND_EXISTS_THM, SNDCART_PASTECART, SUBSET, SUBSET_ANTISYM,
        SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, .. } := D.core5
  let { SUBSET_UNIV, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_REFL, .. } := D.vec1
  let { LINEAR_COMPOSE_ADD, LINEAR_FSTCART, LINEAR_SNDCART, NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LT, REAL_ABS_NORM, SUBSPACE_MUL, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_LID,
        VECTOR_MUL_RZERO, VECTOR_SUB_EQ, .. } := D.vec4
  let { OPEN_IN_IMP_SUBSET, .. } := D.met
  let { BALL_EMPTY, CBALL_EMPTY, CENTRE_IN_BALL, CENTRE_IN_CBALL, CLOSED_CLOSURE,
        CLOSURE_APPROACHABLE, CLOSURE_DYADIC_RATIONALS, CLOSURE_EMPTY, .. } := D.top1
  let { CLOSURE_INTERS_SUBSET, CLOSURE_OPEN_INTER_SUPERSET, CLOSURE_OPEN_IN_INTER_CLOSURE,
        CLOSURE_RATIONAL_COORDINATES, CLOSURE_SUBSET, CLOSURE_UNION, CONNECTED,
        CONNECTED_CLOSED, .. } := D.top2
  let { INTERIOR_CBALL, INTERIOR_EQ, INTERIOR_SUBSET, IN_CBALL, IN_INTERIOR_CBALL, IN_SEGMENT,
        OPEN_BALL, .. } := D.top4
  let { OPEN_INTERIOR, OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_IN_CONTAINS_BALL, SUBSET_CLOSURE,
        connected, .. } := D.top5
  let { CONVEX_INTER, .. } := BCVX
  let { CONVEX_PCROSS, .. } := BCVS
  let { CONVEX_CONNECTED, .. } := BCOP
  let { CONVEX_BALL, CONVEX_CBALL, .. } := BCVB
  let { SUBSPACE_IMP_AFFINE, AFFINE_EQ_SUBSPACE, .. } := BCLH
  let { AFFINE_HULL_AFFINE_INTER_NONEMPTY_INTERIOR, .. } := BADC
  let { IN_INTERIOR_CLOSURE_CONVEX_SEGMENT, .. } := BSHR
  let { RELATIVE_INTERIOR_EMPTY, RELATIVE_INTERIOR_SUBSET, IN_RELATIVE_INTERIOR_CBALL, .. } :=
    BRIA
  let { RELATIVE_INTERIOR_OPEN, .. } := BRIB
  let { CONVEX_RELATIVE_INTERIOR, IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK, .. } := BRIC
  let { RELATIVE_INTERIOR_PCROSS, .. } := BRIG
  let { CONVEX_CLOSURE_INTERIOR, CONVEX_CLOSURE_RELATIVE_INTERIOR, .. } := BIRA
  let { RELATIVE_INTERIOR_LINEAR_IMAGE_CONVEX, .. } := BIRB
  -- @@SCOPE END

  let RELATIVE_INTERIOR_SUMS ← prove
   r"!s t:real^N->bool.
        convex s /\ convex t
        ==> relative_interior {x + y | x IN s /\ y IN t} =
            {x + y | x IN relative_interior s /\ y IN relative_interior t}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!s t. {x + y:real^N | x IN s /\ y IN t} =
            IMAGE (\z. fstcart z + sndcart z) (s PCROSS t)")
     (fun th => REWRITE_TAC [th])
    THENL
     [REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM, EXISTS_PASTECART] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_IN_PCROSS] THEN
      MESON_TAC [],
      ASM_SIMP_TAC [RELATIVE_INTERIOR_LINEAR_IMAGE_CONVEX, CONVEX_PCROSS,
                    LINEAR_COMPOSE_ADD, LINEAR_FSTCART, LINEAR_SNDCART] THEN
      REWRITE_TAC [RELATIVE_INTERIOR_PCROSS]])

  let CLOSURE_INTERS_CONVEX ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> convex s) /\
        ~(INTERS(IMAGE relative_interior f) = {})
        ==> closure(INTERS f) = INTERS(IMAGE closure f)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [CLOSURE_INTERS_SUBSET] THEN
    REWRITE_TAC [SUBSET, IN_INTERS, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"b:real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [INTERS_IMAGE, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
    REWRITE_TAC [CLOSURE_APPROACHABLE] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THENL
     [EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [DIST_REFL, IN_INTERS] THEN
      ASM_MESON_TAC [SUBSET, RELATIVE_INTERIOR_SUBSET],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"b - min (&1 / &2) (e / &2 / norm(b - a)) % (b - a):real^N") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [← NORM_ARITH (← q r"dist(b - a:real^N,b) = norm a"), NORM_MUL] THEN
      ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < a /\ &0 < x /\ x < y ==> abs(min a x) < y")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV2_EQ, REAL_HALF, REAL_LT_DIV, NORM_POS_LT,
                    VECTOR_SUB_EQ] THEN
      ASM_REAL_ARITH_TAC] THEN
    REWRITE_TAC [IN_INTERS] THEN X_GEN_TAC (← q r"s:real^N->bool") THEN DISCH_TAC THEN
    MATCH_MP_TAC
     (← MESON [RELATIVE_INTERIOR_SUBSET, SUBSET]
           (← q r"!x. x IN relative_interior s ==> x IN s")) THEN
    MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK THEN
    ASM_SIMP_TAC [REAL_LT_MIN, REAL_HALF, REAL_LT_DIV, NORM_POS_LT,
                  VECTOR_SUB_EQ] THEN
    REAL_ARITH_TAC)

  let CLOSURE_INTERS_CONVEX_OPEN ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> convex s /\ open s)
        ==> closure(INTERS f) =
                if INTERS f = {} then {}
                else INTERS(IMAGE closure f)"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [CLOSURE_EMPTY] THEN
    MATCH_MP_TAC CLOSURE_INTERS_CONVEX THEN ASM_SIMP_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(s = {}) ==> s = t ==> ~(t = {})"))) THEN
    AP_TERM_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN s ==> f x = x) ==> s = IMAGE f s")) THEN
    ASM_SIMP_TAC [RELATIVE_INTERIOR_OPEN, INTERIOR_EQ])

  let CLOSURE_INTER_CONVEX ← prove
   r"!s t:real^N->bool.
        convex s /\ convex t /\
        ~(relative_interior s INTER relative_interior t = {})
        ==> closure(s INTER t) = closure(s) INTER closure(t)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"{s:real^N->bool,t}") CLOSURE_INTERS_CONVEX) THEN
    ASM_SIMP_TAC [IMAGE_CLAUSES, INTERS_2] THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY])

  let CLOSURE_INTER_CONVEX_OPEN ← prove
   r"!s t. convex s /\ open s /\ convex t /\ open t
         ==> closure(s INTER t) =
                if s INTER t = {} then {} else closure(s) INTER closure(t)"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [CLOSURE_EMPTY] THEN
    MATCH_MP_TAC CLOSURE_INTER_CONVEX THEN
    ASM_SIMP_TAC [RELATIVE_INTERIOR_OPEN])

  let CLOSURE_CONVEX_INTER_SUPERSET ← prove
   r"!s t:real^N->bool.
        convex s /\ ~(interior s = {}) /\ interior s SUBSET closure t
        ==> closure(s INTER t) = closure s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [SUBSET_CLOSURE, INTER_SUBSET, SUBSET_INTER] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN
    EXISTS_TAC (← q r"closure(interior s):real^N->bool") THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [CONVEX_CLOSURE_INTERIOR, SUBSET_REFL],
      ASM_SIMP_TAC [← GSYM CLOSURE_OPEN_INTER_SUPERSET, OPEN_INTERIOR] THEN
      MATCH_MP_TAC SUBSET_CLOSURE THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN SET_TAC []])

  let CLOSURE_DYADIC_RATIONALS_IN_CONVEX_SET ← prove
   r"!s:real^N->bool.
        convex s /\ ~(interior s = {})
        ==> closure(s INTER
                    { inv(&2 pow n) % x | n,x |
                      !i. 1 <= i /\ i <= dimindex(:N) ==> integer(x$i) }) =
            closure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_CONVEX_INTER_SUPERSET THEN
    ASM_REWRITE_TAC [CLOSURE_DYADIC_RATIONALS, SUBSET_UNIV])

  let CLOSURE_RATIONALS_IN_CONVEX_SET ← prove
   r"!s:real^N->bool.
      convex s /\ ~(interior s = {})
      ==> closure(s INTER
                  { x | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i) }) =
          closure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_CONVEX_INTER_SUPERSET THEN
    ASM_REWRITE_TAC [CLOSURE_RATIONAL_COORDINATES, SUBSET_UNIV])

  let RELATIVE_INTERIOR_CONVEX_INTER_AFFINE ← prove
   r"!s t:real^N->bool.
        convex s /\ affine t /\ ~(interior s INTER t = {})
        ==> relative_interior(s INTER t) = interior s INTER t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, RIGHT_AND_EXISTS_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") MP_TAC) THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REWRITE_TAC [IN_INTER] THEN
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(vec 0:real^N) IN t") THEN
    ASM_SIMP_TAC [AFFINE_EQ_SUBSPACE] THEN STRIP_TAC THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:real^N") THEN
    MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"s:real^N->bool"]
          (← ONCE_REWRITE_RULE [INTER_COMM]
             AFFINE_HULL_AFFINE_INTER_NONEMPTY_INTERIOR)) THEN
    ASM_SIMP_TAC [SUBSPACE_IMP_AFFINE, IN_RELATIVE_INTERIOR_CBALL] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_INTER, IN_INTERIOR_CBALL]] THEN
    DISCH_THEN SUBST1_TAC THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN t") THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [SUBSET, IN_INTER] THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN s") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [CENTRE_IN_CBALL, REAL_LT_IMP_LE]] THEN
    EQ_TAC THENL [REWRITE_TAC [IN_CBALL], MESON_TAC []] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"x:real^N = vec 0") THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERIOR_CBALL]) THEN
      ASM_REWRITE_TAC [SUBSET, IN_CBALL],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"s:real^N->bool", ← q r"vec 0:real^N", ← q r"(&1 + e / norm x) % x:real^N"]
     IN_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE [SUBSET] CLOSURE_SUBSET) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [SUBSPACE_MUL] THEN
      REWRITE_TAC [VECTOR_ADD_RDISTRIB, VECTOR_MUL_LID,
                   ← NORM_ARITH (← q r"dist(a:real^N,a + x) = norm x")] THEN
      ASM_SIMP_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM,
                    REAL_DIV_RMUL, NORM_EQ_0] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [SUBSET, IN_INTERIOR_CBALL, IN_CBALL] THEN
      DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [IN_SEGMENT] THEN
      CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
      EXISTS_TAC (← q r"inv(&1 + e / norm(x:real^N))") THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_LT_DIV, NORM_POS_LT, VECTOR_MUL_LID,
                    REAL_LT_INV_EQ, REAL_MUL_LINV, REAL_INV_LT_1, ← REAL_ARITH
                    (← q r"&0 < x ==> &1 < &1 + x /\ &0 < &1 + x /\ ~(&1 + x = &0)")]])

  let CONNECTED_WITH_RELATIVE_INTERIOR_OPEN_IN_CONVEX ← prove
   r"!c s:real^N->bool.
        convex c /\ connected s /\ open_in (subtopology euclidean c) s
        ==> connected(relative_interior c INTER s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONNECTED, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_CLOSED]) THEN
    REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC
     [← q r"closure(relative_interior c INTER u):real^N->bool",
      ← q r"closure(relative_interior c INTER v):real^N->bool"] THEN
    REWRITE_TAC [CLOSED_CLOSURE] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [← GSYM CLOSURE_UNION] THEN TRANS_TAC SUBSET_TRANS
       (← q r"closure(relative_interior c INTER s):real^N->bool") THEN
      CONJ_TAC THENL
       [ONCE_REWRITE_TAC [INTER_COMM] THEN
        MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"relative_interior c:real^N->bool",
                          ← q r"c:real^N->bool"] CLOSURE_OPEN_IN_INTER_CLOSURE) THEN
        REWRITE_TAC [RELATIVE_INTERIOR_SUBSET] THEN
        ASM_SIMP_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        TRANS_TAC SUBSET_TRANS (← q r"closure s:real^N->bool") THEN
        REWRITE_TAC [CLOSURE_SUBSET] THEN MATCH_MP_TAC SUBSET_CLOSURE THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
        MP_TAC (← ISPEC (← q r"c:real^N->bool") CLOSURE_SUBSET) THEN SET_TAC [],
        MATCH_MP_TAC SUBSET_CLOSURE THEN
        ASM SET_TAC []],
      ALL_TAC,
      MP_TAC (← ISPEC (← q r"relative_interior c INTER u:real^N->bool") CLOSURE_SUBSET) THEN
      ASM SET_TAC [],
      MP_TAC (← ISPEC (← q r"relative_interior c INTER v:real^N->bool") CLOSURE_SUBSET) THEN
      ASM SET_TAC []] THEN
    REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN
    X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_CONTAINS_BALL]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:real^N"))) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"connected(ball(x:real^N,r) INTER relative_interior c)")
    MP_TAC THENL
     [ASM_SIMP_TAC [CONVEX_CONNECTED, CONVEX_INTER, CONVEX_BALL,
                    CONVEX_RELATIVE_INTERIOR],
      REWRITE_TAC [connected]] THEN
    MAP_EVERY EXISTS_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MP_TAC (← ISPEC (← q r"c:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN
      ASM SET_TAC [],
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"u INTER b INTER i = b INTER u INTER i")] THEN
    MP_TAC (← ISPEC (← q r"ball(x:real^N,r)") OPEN_INTER_CLOSURE_EQ_EMPTY) THEN
    REWRITE_TAC [OPEN_BALL] THEN
    DISCH_THEN (fun th => tactic_of do pure (ONCE_REWRITE_TAC [← GSYM th])) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
    CONJ_TAC THEN EXISTS_TAC (← q r"x:real^N") THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN
    ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REWRITE_TAC [])

  let RELATIVE_INTERIOR_CBALL_INTER_AFFINE ← prove
   r"!s a:real^N r.
        affine s /\ a IN s /\ ~(r = &0)
        ==> relative_interior(cball(a,r) INTER s) = ball(a,r) INTER s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"r < &0") THENL
     [ASM_SIMP_TAC [CBALL_EMPTY, BALL_EMPTY, REAL_LT_IMP_LE, INTER_EMPTY] THEN
      REWRITE_TAC [RELATIVE_INTERIOR_EMPTY],
      W (MP_TAC o PART_MATCH (lhand o rand)
        RELATIVE_INTERIOR_CONVEX_INTER_AFFINE o lhand o snd) THEN
      REWRITE_TAC [INTERIOR_CBALL] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [CONVEX_CBALL, INTERIOR_CBALL, ← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL] THEN
      ASM_REAL_ARITH_TAC])

  return { RELATIVE_INTERIOR_SUMS, CLOSURE_INTERS_CONVEX, CLOSURE_INTERS_CONVEX_OPEN,
           CLOSURE_INTER_CONVEX, CLOSURE_INTER_CONVEX_OPEN, CLOSURE_CONVEX_INTER_SUPERSET,
           CLOSURE_DYADIC_RATIONALS_IN_CONVEX_SET, CLOSURE_RATIONALS_IN_CONVEX_SET,
           RELATIVE_INTERIOR_CONVEX_INTER_AFFINE, CONNECTED_WITH_RELATIVE_INTERIOR_OPEN_IN_CONVEX,
           RELATIVE_INTERIOR_CBALL_INTER_AFFINE }

/- ------------------------------------------------------------------------- -/
/- Lemmas about extending nondecreasing functions.  (convex.ml 14154-14281)  -/
/- ------------------------------------------------------------------------- -/

structure NDE where
  NONDECREASING_EXTENDS_TO_CONVEX_HULL : thm
  NONDECREASING_EXTENDS_FROM_DENSE : thm
  INCREASING_EXTENDS_FROM_DENSE : thm
  deriving Inhabited

@[nospecialize]
def setupNDE [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVH : CVH) (BMCG : MCG) (BONE : ONE)
    (BIRA : IRA) : ExceptT String IO NDE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, .. } := D
  let { CONTRAPOS_THM, EXISTS_IN_IMAGE, EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_SUBSET, IMP_CONJ, .. } := D.core2
  let { IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } :=
    D.core3
  let { REAL_LE_LT, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_IMP_NE, REAL_LT_LE,
        REAL_LT_MIN, .. } := D.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LT, REAL_SUP_LE_SUBSET, SIMPLE_IMAGE_GEN, SUBSET,
        SUBSET_TRANS, .. } := D.core5
  let { SUP_UNIQUE, SWAP_FORALL_THM, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_1, DIST_NZ, .. } := D.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, LIFT_DROP, .. } := D.vec2
  let { CLOSURE_APPROACHABLE, .. } := D.top1
  let { CONNECTED_CONTINUOUS_IMAGE, CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.top2
  let { INTERIOR_MAXIMAL_EQ, INTERIOR_SUBSET, INTERIOR_UNIV, IN_INTERVAL_1, .. } := D.top4
  let { OPEN_UNIV, SUBSET_CLOSURE, SUBSET_INTERIOR, continuous_at, .. } := D.top5
  let { CONVEX_UNIV, .. } := BCVX
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_UNIV, .. } := BCVH
  let { CONVEX_HULL_CLOSURE_SUBSET, .. } := BMCG
  let { CONVEX_CONNECTED_1, IN_CONVEX_HULL_INTERVAL_1, .. } := BONE
  let { CONVEX_INTERIOR_CLOSURE, .. } := BIRA
  -- @@SCOPE END

  let NONDECREASING_EXTENDS_TO_CONVEX_HULL ← prove
   r"!f s. (!x y. x IN s /\ y IN s /\ drop x <= drop y
                ==> drop(f x) <= drop(f y))
         ==> ?g. (!x y. x IN convex hull s /\ y IN convex hull s /\
                        drop x <= drop y
                        ==> drop(g x) <= drop(g y)) /\
                 (!x. x IN s ==> g x = f x)"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\x. lift(sup {drop(f u) | u IN s /\ drop u <= drop x})") THEN
    REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP] THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
      MATCH_MP_TAC REAL_SUP_LE_SUBSET THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
       [UNDISCH_TAC (← q r"(x:real^1) IN convex hull s") THEN
        REWRITE_TAC [IN_CONVEX_HULL_INTERVAL_1, IN_INTERVAL_1] THEN MESON_TAC [],
        MATCH_MP_TAC IMAGE_SUBSET THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_MESON_TAC [REAL_LE_TRANS],
        UNDISCH_TAC (← q r"(y:real^1) IN convex hull s") THEN
        REWRITE_TAC [IN_CONVEX_HULL_INTERVAL_1, IN_INTERVAL_1] THEN
        ASM_MESON_TAC [REAL_LE_TRANS]],
      X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
      REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP] THEN
      MATCH_MP_TAC SUP_UNIQUE THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ASM_MESON_TAC [REAL_LE_TRANS, REAL_LE_REFL]])

  let NONDECREASING_EXTENDS_FROM_DENSE ← prove
   r"!f s. closure s = (:real^1) /\ closure(IMAGE f s) = (:real^1) /\
         (!x y. x IN s /\ y IN s /\ drop x <= drop y
                ==> drop(f x) <= drop(f y))
         ==> ?g. (!x y. drop x <= drop y ==> drop(g x) <= drop(g y)) /\
                 (!x. x IN s ==> g x = f x) /\
                 g continuous_on (:real^1) /\
                 IMAGE g (:real^1) = (:real^1)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"s:real^1->bool"]
          NONDECREASING_EXTENDS_TO_CONVEX_HULL) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"g:real^1->real^1") THEN
    MP_TAC (← ISPEC (← q r"s:real^1->bool") CONVEX_HULL_CLOSURE_SUBSET) THEN
    ASM_REWRITE_TAC [CONVEX_HULL_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SUBSET_INTERIOR) THEN
    SIMP_TAC [CONVEX_INTERIOR_CLOSURE, CONVEX_CONVEX_HULL] THEN
    SIMP_TAC [INTERIOR_UNIV, OPEN_UNIV, INTERIOR_MAXIMAL_EQ] THEN
    DISCH_THEN (ASSUME_TAC o MATCH_MP (← SET_RULE
     (← q r"UNIV SUBSET s ==> s = UNIV"))) THEN
    ASM_REWRITE_TAC [IN_UNIV] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
      X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_UNIV, continuous_at] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"closure(IMAGE (f:real^1->real^1) s) = UNIV") THEN
      REWRITE_TAC [EXTENSION, IN_UNIV, EXISTS_IN_IMAGE, CLOSURE_APPROACHABLE] THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"g(x:real^1) + lift(e / &2)") th) THEN
              MP_TAC (← SPEC (← q r"g(x:real^1) - lift(e / &2)") th))) THEN
      SIMP_TAC [DIST_1, DROP_ADD, DROP_SUB, LIFT_DROP, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:real^1") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"b:real^1") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(f:real^1->real^1) a = g a /\ f b = g b")
      (CONJUNCTS_THEN SUBST_ALL_TAC) THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"drop a < drop x /\ drop x < drop b") STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [← GSYM REAL_NOT_LE] THEN
        CONJ_TAC THEN DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      EXISTS_TAC (← q r"min (drop x - drop a) (drop b - drop x)") THEN
      ASM_REWRITE_TAC [REAL_LT_MIN, REAL_SUB_LT] THEN
      X_GEN_TAC (← q r"y:real^1") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"drop((g:real^1->real^1) a) <= drop(g y) /\ drop(g y) <= drop(g b)")
      MP_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC,
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONNECTED_CONTINUOUS_IMAGE)) THEN
      REWRITE_TAC [← GSYM CONVEX_CONNECTED_1, CONVEX_UNIV] THEN DISCH_TAC THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"interior(closure s) SUBSET s /\ UNIV SUBSET interior(closure s)
        ==> s = UNIV")) THEN
      SIMP_TAC [INTERIOR_MAXIMAL_EQ, OPEN_UNIV] THEN
      ASM_SIMP_TAC [CONVEX_INTERIOR_CLOSURE, INTERIOR_SUBSET] THEN
      TRANS_TAC SUBSET_TRANS (← q r"closure(IMAGE (f:real^1->real^1) s)") THEN
      CONJ_TAC THENL [ALL_TAC, MATCH_MP_TAC SUBSET_CLOSURE] THEN
      ASM SET_TAC []])

  let INCREASING_EXTENDS_FROM_DENSE ← prove
   r"!f s. closure s = (:real^1) /\ closure(IMAGE f s) = (:real^1) /\
         (!x y. x IN s /\ y IN s /\ drop x < drop y
                ==> drop(f x) < drop(f y))
         ==> ?g. (!x y. drop(g x) < drop(g y) <=> drop x < drop y) /\
                 (!x. x IN s ==> g x = f x) /\
                 g continuous_on (:real^1) /\
                 IMAGE g (:real^1) = (:real^1)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"s:real^1->bool"]
          NONDECREASING_EXTENDS_FROM_DENSE) THEN
    ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [REAL_LE_LT, DROP_EQ], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^1->real^1") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
    EQ_TAC THEN ASM_REWRITE_TAC [← GSYM REAL_NOT_LE, CONTRAPOS_THM] THEN
    REWRITE_TAC [← GSYM REAL_NOT_LT, CONTRAPOS_THM] THEN
    DISCH_TAC THEN ASM_SIMP_TAC [REAL_LT_LE, REAL_LT_IMP_LE] THEN
    UNDISCH_TAC (← q r"closure s = (:real^1)") THEN
    REWRITE_TAC [EXTENSION, IN_UNIV, CLOSURE_APPROACHABLE] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"dist(x:real^1,y) / &4")) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"y - inv(&4) % (y - x):real^1") th) THEN
            MP_TAC (← SPEC (← q r"x + inv(&4) % (y - x):real^1") th))) THEN
    ASM_SIMP_TAC [← GSYM DIST_NZ, ← GSYM DROP_EQ, REAL_LT_IMP_NE,
                  ← REAL_ARITH (← q r"&0 < x / &4 <=> &0 < x")] THEN
    SIMP_TAC [DIST_1, DROP_SUB, DROP_ADD, LIFT_DROP, DROP_CMUL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x':real^1") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y':real^1") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"drop(g x) <= drop(g(x':real^1)) /\
      drop(g x') < drop(g y') /\ drop(g y') <= drop(g y)")
    MP_TAC THENL [ALL_TAC, REAL_ARITH_TAC] THEN
    REPEAT CONJ_TAC THEN
    TRY (FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC) THEN
    ASM_SIMP_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  return { NONDECREASING_EXTENDS_TO_CONVEX_HULL, NONDECREASING_EXTENDS_FROM_DENSE,
           INCREASING_EXTENDS_FROM_DENSE }

/- ------------------------------------------------------------------------- -/
/- More basics about segments (part 1).  (convex.ml 14285-14494)             -/
/- ------------------------------------------------------------------------- -/

structure SGA where
  BOUNDED_SEGMENT : thm
  SEGMENT_IMAGE_INTERVAL : thm
  CLOSURE_SEGMENT : thm
  CLOSED_SEGMENT : thm
  COMPACT_SEGMENT : thm
  AFFINE_HULL_SEGMENT : thm
  SEGMENT_AS_BALL : thm
  CONVEX_SEGMENT : thm
  RELATIVE_INTERIOR_SEGMENT : thm
  OPEN_IN_SEGMENT : thm
  AFF_DIM_SEGMENT : thm
  CONVEX_SEMIOPEN_SEGMENT : thm
  CONNECTED_SEMIOPEN_SEGMENT : thm
  SEGMENT_EQ_EMPTY : thm
  FINITE_SEGMENT : thm
  SEGMENT_EQ_SING : thm
  deriving Inhabited

@[nospecialize]
def setupSGA [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BCVX : CVX) (BCOP : COP)
    (BCVB : CVB) (BCVH : CVH) (BCLH : CLH) (BADA : ADA) (BADB : ADB) (BADC : ADC) (BOCH : OCH)
    (BSTL : STL) (BRIA : RIA) (BRIB : RIB) (BRID : RID) (BIRA : IRA) (BIRB : IRB) :
    ExceptT String IO SGA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D
  let { AND_FORALL_THM, EXTENSION, FINITE_DELETE, FINITE_IMAGE_INJ_EQ, FINITE_SING, .. } :=
    D.core1
  let { FUN_EQ_THM, IMAGE_o, INSERT_AC, INTER_EMPTY, IN_DELETE, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, LEFT_AND_EXISTS_THM, NOT_INSERT_EMPTY,
        NOT_IN_EMPTY, .. } := D.core3
  let { REAL_ENTIRE, REAL_LE_MUL, REAL_LE_MUL_EQ, REAL_LT_MUL_EQ, .. } := D.core4
  let { REAL_SUB_0, REAL_SUB_LE, .. } := D.core5
  let { SWAP_EXISTS_THM, UNWIND_THM2, o_THM, .. } := D.core6
  let { HULL_SUBSET, .. } := D.misc
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_VEC, EXISTS_DROP, NORM_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LT, .. } := D.vec3
  let { VECTOR_ADD_ASSOC, VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0,
        VECTOR_MUL_LCANCEL, VECTOR_MUL_RCANCEL, VECTOR_SUB_EQ, VECTOR_SUB_REFL, dist,
        linear, .. } := D.vec4
  let { OPEN_IN_SUBSET_TRANS, .. } := D.met
  let { BALL_TRIVIAL, BOUNDED_SUBSET, CBALL_TRIVIAL, CLOSURE_EMPTY, CLOSURE_EQ, .. } := D.top1
  let { CLOSURE_INJECTIVE_LINEAR_IMAGE, CLOSURE_OPEN_INTERVAL, CLOSURE_TRANSLATION,
        COMPACT_EMPTY, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED,
        COMPACT_INSERT, .. } := D.top2
  let { ENDS_IN_SEGMENT, ENDS_NOT_IN_SEGMENT, FINITE_INTERVAL_1, .. } := D.top3
  let { INTERVAL_EQ_EMPTY_1, IN_BALL, IN_CBALL, IN_INTERVAL_1, IN_SEGMENT, MIDPOINT_IN_SEGMENT,
        OPEN_BALL, .. } := D.top4
  let { OPEN_IN_OPEN, SEGMENT_OPEN_SUBSET_CLOSED, SEGMENT_REFL, SEGMENT_SYM,
        open_segment, .. } := D.top5
  let { AFFINE_AFFINE_HULL, .. } := BAFF
  let { AFFINE_HULL_EMPTY, AFFINE_HULL_2, .. } := BAFS
  let { CONVEX_ALT, CONVEX_EMPTY, CONVEX_INTER, .. } := BCVX
  let { CONVEX_CONNECTED, .. } := BCOP
  let { CONVEX_BALL, CONVEX_CBALL, .. } := BCVB
  let { CONVEX_HULL_EQ_EMPTY, CONVEX_HULL_EQ_SING, .. } := BCVH
  let { AFFINE_IMP_CONVEX, AFFINE_HULL_CLOSURE, .. } := BCLH
  let { AFF_DIM_EMPTY, .. } := BADA
  let { AFF_DIM_SING, .. } := BADB
  let { AFF_DIM_CONVEX_HULL, AFF_DIM_2, .. } := BADC
  let { COMPACT_CONVEX_HULL, .. } := BOCH
  let { SEGMENT_CONVEX_HULL, .. } := BSTL
  let { RELATIVE_INTERIOR_EQ, RELATIVE_INTERIOR_EMPTY, OPEN_IN_RELATIVE_INTERIOR, .. } := BRIA
  let { AFFINE_HULL_CONVEX_HULL, .. } := BRIB
  let { RELATIVE_INTERIOR_SING, .. } := BRID
  let { AFF_DIM_RELATIVE_INTERIOR, .. } := BIRA
  let { CONVEX_RELATIVE_INTERIOR_CLOSURE, .. } := BIRB
  -- @@SCOPE END

  let BOUNDED_SEGMENT ← prove
   r"(!a b:real^N. bounded(segment[a,b])) /\
   (!a b:real^N. bounded(segment(a,b)))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← MESON [BOUNDED_SUBSET]
     (← q r"bounded s /\ t SUBSET s ==> bounded s /\ bounded t")) THEN
    REWRITE_TAC [SEGMENT_OPEN_SUBSET_CLOSED] THEN
    MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
    MATCH_MP_TAC COMPACT_CONVEX_HULL THEN
    SIMP_TAC [COMPACT_INSERT, COMPACT_EMPTY])

  let SEGMENT_IMAGE_INTERVAL ← prove
   r"(!a b. segment[a,b] =
          IMAGE (\u. (&1 - drop u) % a + drop u % b)
                (interval[vec 0,vec 1])) /\
   (!a b. ~(a = b)
          ==> segment(a,b) =
                IMAGE (\u. (&1 - drop u) % a + drop u % b)
                (interval(vec 0,vec 1)))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, IN_INTERVAL_1, IN_SEGMENT] THEN
    ASM_REWRITE_TAC [← GSYM EXISTS_DROP, DROP_VEC] THEN MESON_TAC [])

  let CLOSURE_SEGMENT ← prove
   r"(!a b:real^N. closure(segment[a,b]) = segment[a,b]) /\
   (!a b:real^N. closure(segment(a,b)) = if a = b then {} else segment[a,b])"
   (REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [CLOSURE_EQ, COMPACT_IMP_CLOSED, SEGMENT_CONVEX_HULL,
                     COMPACT_CONVEX_HULL, COMPACT_INSERT, COMPACT_EMPTY],
      ALL_TAC] THEN
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, CLOSURE_EMPTY] THEN
    ASM_SIMP_TAC [SEGMENT_IMAGE_INTERVAL] THEN
    ASM_SIMP_TAC [← CONV_RULE (RAND_CONV SYM_CONV) (← SPEC_ALL CLOSURE_OPEN_INTERVAL),
                  INTERVAL_EQ_EMPTY_1, DROP_VEC, ← REAL_ARITH (← q r"~(&1 <= &0)")] THEN
    SUBGOAL_THEN
     (← q r"(\u. (&1 - drop u) % a + drop u % (b:real^N)) =
      (\x. a + x) o (\u. drop u % (b - a))")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN VECTOR_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [IMAGE_o, CLOSURE_TRANSLATION] THEN AP_TERM_TAC THEN
    MATCH_MP_TAC CLOSURE_INJECTIVE_LINEAR_IMAGE THEN
    ASM_REWRITE_TAC [VECTOR_MUL_RCANCEL, VECTOR_SUB_EQ, DROP_EQ] THEN
    REWRITE_TAC [linear, DROP_ADD, DROP_CMUL] THEN VECTOR_ARITH_TAC)

  let CLOSED_SEGMENT ← prove
   r"(!a b:real^N. closed(segment[a,b])) /\
   (!a b:real^N. closed(segment(a,b)) <=> a = b)"
   (REWRITE_TAC [← GSYM CLOSURE_EQ, CLOSURE_SEGMENT] THEN
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [SEGMENT_REFL] THEN
    MESON_TAC [ENDS_NOT_IN_SEGMENT, ENDS_IN_SEGMENT])

  let COMPACT_SEGMENT ← prove
   r"(!a b:real^N. compact(segment[a,b])) /\
   (!a b:real^N. compact(segment(a,b)) <=> a = b)"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_SEGMENT, BOUNDED_SEGMENT])

  let AFFINE_HULL_SEGMENT ← prove
   r"(!a b:real^N. affine hull (segment [a,b]) = affine hull {a,b}) /\
   (!a b:real^N. affine hull (segment(a,b)) =
                 if a = b then {} else affine hull {a,b})"
   (REWRITE_TAC [SEGMENT_CONVEX_HULL, AFFINE_HULL_CONVEX_HULL] THEN
    REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM AFFINE_HULL_CLOSURE] THEN
    REWRITE_TAC [CLOSURE_SEGMENT] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [AFFINE_HULL_EMPTY] THEN
    REWRITE_TAC [SEGMENT_CONVEX_HULL, AFFINE_HULL_CONVEX_HULL])

  let SEGMENT_AS_BALL ← prove
   r"(!a b. segment[a:real^N,b] =
         affine hull {a,b} INTER cball(inv(&2) % (a + b),norm(b - a) / &2)) /\
   (!a b. segment(a:real^N,b) =
         affine hull {a,b} INTER ball(inv(&2) % (a + b),norm(b - a) / &2))"
   (REPEAT STRIP_TAC THEN
    (ASM_CASES_TAC (← q r"b:real^N = a") THEN
     ASM_REWRITE_TAC [SEGMENT_REFL, VECTOR_SUB_REFL, NORM_0] THEN
     CONV_TAC REAL_RAT_REDUCE_CONV THEN
     REWRITE_TAC [BALL_TRIVIAL, CBALL_TRIVIAL] THENL
      [REWRITE_TAC [INTER_EMPTY, INSERT_AC] THEN
       REWRITE_TAC [← VECTOR_ARITH (← q r"&1 / &2 % (a + a) = a")] THEN
       REWRITE_TAC [← SET_RULE (← q r"a = b INTER a <=> a SUBSET b"), HULL_SUBSET],
       ASM_REWRITE_TAC [EXTENSION, IN_SEGMENT, IN_INTER, AFFINE_HULL_2] THEN
       X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN
       ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
       REWRITE_TAC [← REAL_ARITH (← q r"u + v:real = &1 <=> u = &1 - v")] THEN
       REWRITE_TAC [UNWIND_THM2] THEN REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
       AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
       X_GEN_TAC (← q r"u:real") THEN REWRITE_TAC [] THEN
       ASM_CASES_TAC (← q r"y:real^N = (&1 - u) % a + u % b") THEN
       ASM_REWRITE_TAC [] THEN REWRITE_TAC [IN_BALL, IN_CBALL, dist, ← VECTOR_ARITH
        (← q r"&1 / &2 % (a + b) - ((&1 - u) % a + u % b):real^N =
         (&1 / &2 - u) % (b - a)")] THEN
      ASM_SIMP_TAC [NORM_MUL, REAL_LT_MUL_EQ, REAL_LE_MUL_EQ, NORM_POS_LT,
       VECTOR_SUB_EQ, ← REAL_ARITH (← q r"a * n < n / &2 <=> &0 < n * (inv(&2) - a)"),
                ← REAL_ARITH (← q r"a * n <= n / &2 <=> &0 <= n * (inv(&2) - a)")] THEN
      REAL_ARITH_TAC]))

  let CONVEX_SEGMENT ← prove
   r"(!a b. convex(segment[a,b])) /\ (!a b. convex(segment(a,b)))"
   (REWRITE_TAC [SEGMENT_AS_BALL] THEN
    SIMP_TAC [CONVEX_INTER, CONVEX_BALL, CONVEX_CBALL,
              AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL])

  let RELATIVE_INTERIOR_SEGMENT ← prove
   r"(!a b:real^N.
      relative_interior(segment[a,b]) = if a = b then {a} else segment(a,b)) /\
   (!a b:real^N. relative_interior(segment(a,b)) = segment(a,b))"
   (MATCH_MP_TAC (← TAUT (← q r"b /\ (b ==> a) ==> a /\ b")) THEN CONJ_TAC THENL
     [REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = b") THEN
      ASM_REWRITE_TAC [SEGMENT_REFL, RELATIVE_INTERIOR_EMPTY] THEN
      REWRITE_TAC [RELATIVE_INTERIOR_EQ, OPEN_IN_OPEN] THEN
      ASM_REWRITE_TAC [AFFINE_HULL_SEGMENT] THEN
      EXISTS_TAC (← q r"ball(inv(&2) % (a + b):real^N,norm(b - a) / &2)") THEN
      REWRITE_TAC [OPEN_BALL, SEGMENT_AS_BALL],
      REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [SEGMENT_REFL, RELATIVE_INTERIOR_SING] THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N"] (← CONJUNCT2 CLOSURE_SEGMENT)) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THEN
      MATCH_MP_TAC CONVEX_RELATIVE_INTERIOR_CLOSURE THEN
      REWRITE_TAC [CONVEX_SEGMENT]])

  let OPEN_IN_SEGMENT ← prove
   r"!s a b:real^N.
        segment(a,b) SUBSET s /\ s SUBSET affine hull (segment(a,b))
        ==> open_in (subtopology euclidean s) (segment(a,b))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
    EXISTS_TAC (← q r"affine hull (segment(a:real^N,b))") THEN
    ASM_MESON_TAC [OPEN_IN_RELATIVE_INTERIOR, RELATIVE_INTERIOR_SEGMENT])

  let AFF_DIM_SEGMENT ← prove
   r"(!a b:real^N. aff_dim(segment[a,b]) = if a = b then &0 else &1) /\
   (!a b:real^N. aff_dim(segment(a,b)) = if a = b then -- &1 else &1)"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, AFF_DIM_EMPTY, AFF_DIM_SING] THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N"]
     (← CONJUNCT1 RELATIVE_INTERIOR_SEGMENT)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    SIMP_TAC [AFF_DIM_RELATIVE_INTERIOR, CONVEX_SEGMENT] THEN
    REWRITE_TAC [AFF_DIM_CONVEX_HULL, SEGMENT_CONVEX_HULL] THEN
    ASM_REWRITE_TAC [AFF_DIM_2])

  let CONVEX_SEMIOPEN_SEGMENT ← prove
   r"(!a b:real^N. convex(segment[a,b] DELETE a)) /\
   (!a b:real^N. convex(segment[a,b] DELETE b))"
   (MATCH_MP_TAC (← TAUT (← q r"(a ==> b) /\ a ==> a /\ b")) THEN
    CONJ_TAC THENL [MESON_TAC [SEGMENT_SYM], ALL_TAC] THEN
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"b:real^N = a") THEN
    ASM_SIMP_TAC [SEGMENT_REFL, ← SET_RULE (← q r"{a} DELETE a = {}"), CONVEX_EMPTY] THEN
    REWRITE_TAC [CONVEX_ALT, IN_DELETE] THEN
    SIMP_TAC [← REWRITE_RULE [CONVEX_ALT] CONVEX_SEGMENT] THEN
    REWRITE_TAC [IN_SEGMENT] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC,
                     ← GSYM VECTOR_ADD_ASSOC] THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
     (← q r"x % a + y % b + z % a + w % b:real^N = a <=>
      (&1 - x - z) % a = (w + y) % b")] THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LCANCEL, ← REAL_ARITH
     (← q r"&1 - (&1 - u) * (&1 - v) - u * (&1 - w) =
      u * w + (&1 - u) * v")] THEN
    ASM_SIMP_TAC [REAL_LE_MUL, REAL_SUB_LE, ← REAL_ARITH
     (← q r"&0 <= x /\ &0 <= y ==> (x + y = &0 <=> x = &0 /\ y = &0)")] THEN
    REWRITE_TAC [REAL_ENTIRE, ← REAL_ARITH (← q r"&1 - x = &0 <=> x = &1")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"(u = &0 \/ w = &0) /\ (u = &1 \/ v = &0)
      ==> u = &0 /\ v = &0 \/ u = &1 /\ w = &0 \/ v = &0 /\ w = &0"))) THEN
    DISCH_THEN (REPEAT_TCL DISJ_CASES_THEN (CONJUNCTS_THEN SUBST_ALL_TAC)) THEN
    ASM_MESON_TAC [← VECTOR_ARITH (← q r"(&1 - &0) % a + &0 % b:real^N = a")])

  let CONNECTED_SEMIOPEN_SEGMENT ← prove
   r"(!a b:real^N. connected(segment[a,b] DELETE a)) /\
   (!a b:real^N. connected(segment[a,b] DELETE b))"
   (SIMP_TAC [CONVEX_CONNECTED, CONVEX_SEMIOPEN_SEGMENT])

  let SEGMENT_EQ_EMPTY ← prove
   r"(!a b:real^N. ~(segment[a,b] = {})) /\
   (!a b:real^N. segment(a,b) = {} <=> a = b)"
   (REWRITE_TAC [SEGMENT_CONVEX_HULL, CONVEX_HULL_EQ_EMPTY, NOT_INSERT_EMPTY] THEN
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL] THEN
    ASM_MESON_TAC [NOT_IN_EMPTY, MIDPOINT_IN_SEGMENT])

  let FINITE_SEGMENT ← prove
   r"(!a b:real^N. FINITE(segment[a,b]) <=> a = b) /\
   (!a b:real^N. FINITE(segment(a,b)) <=> a = b)"
   (REWRITE_TAC [open_segment, ← SET_RULE (← q r"s DIFF {a,b} = s DELETE a DELETE b")] THEN
    REWRITE_TAC [FINITE_DELETE] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, FINITE_SING] THEN
    REWRITE_TAC [SEGMENT_IMAGE_INTERVAL] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) FINITE_IMAGE_INJ_EQ o rand o snd) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [← VECTOR_ARITH
       (← q r"(&1 - u) % a + u % b:real^N = (&1 - v) % a + v % b <=>
        (u - v) % (b - a) = vec 0")] THEN
      ASM_SIMP_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, REAL_SUB_0, DROP_EQ],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [FINITE_INTERVAL_1] THEN
      REWRITE_TAC [DROP_VEC] THEN REAL_ARITH_TAC])

  let SEGMENT_EQ_SING ← prove
   r"(!a b c:real^N. segment[a,b] = {c} <=> a = c /\ b = c) /\
   (!a b c:real^N. ~(segment(a,b) = {c}))"
   (REWRITE_TAC [SEGMENT_CONVEX_HULL, CONVEX_HULL_EQ_SING] THEN
    CONJ_TAC THENL [SET_TAC [], REPEAT GEN_TAC] THEN
    ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, NOT_INSERT_EMPTY] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N"] (← CONJUNCT2 FINITE_SEGMENT)) THEN
    ASM_REWRITE_TAC [FINITE_SING])

  return { BOUNDED_SEGMENT, SEGMENT_IMAGE_INTERVAL, CLOSURE_SEGMENT, CLOSED_SEGMENT,
           COMPACT_SEGMENT, AFFINE_HULL_SEGMENT, SEGMENT_AS_BALL, CONVEX_SEGMENT,
           RELATIVE_INTERIOR_SEGMENT, OPEN_IN_SEGMENT, AFF_DIM_SEGMENT, CONVEX_SEMIOPEN_SEGMENT,
           CONNECTED_SEMIOPEN_SEGMENT, SEGMENT_EQ_EMPTY, FINITE_SEGMENT, SEGMENT_EQ_SING }

/- ------------------------------------------------------------------------- -/
/- More basics about segments (part 2).  (convex.ml 14494-14717)             -/
/- ------------------------------------------------------------------------- -/

structure SGB where
  SEGMENT_SUBSET_RELATIVE_FRONTIER_CONVEX_GEN : thm
  SUBSET_SEGMENT_OPEN_CLOSED : thm
  SUBSET_SEGMENT : thm
  INTERIOR_SEGMENT : thm
  FRONTIER_SEGMENT : thm
  SEGMENT_EQ : thm
  COLLINEAR_SEGMENT : thm
  INTER_SEGMENT : thm
  deriving Inhabited

@[nospecialize]
def setupSGB [HolBase] (D : ConvexDeps) (BAFD : AFD) (BCOP : COP) (BCVH : CVH) (BCLH : CLH)
    (BAFI : AFI) (BEXC : EXC) (BSTL : STL) (BRIB : RIB) (BRID : RID) (BSGA : SGA) :
    ExceptT String IO SGB := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, GEOM_BASIS_MULTIPLE_TAC, GEOM_NORMALIZE_TAC,
        GEOM_ORIGIN_TAC, .. } := D
  let { AND_FORALL_THM, CARD_CLAUSES, CONTRAPOS_THM, DIFF_EMPTY, DIMINDEX_GE_1, EMPTY_SUBSET,
        EQ_TRANS, FINITE_EMPTY, FINITE_INSERT, FINITE_RULES, FINITE_SING, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INSERT_AC, INSERT_SUBSET, INTER_IDEMPOT, IN_DIFF, .. } :=
    D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_SING, LEFT_IMP_EXISTS_THM, LE_REFL, LE_TRANS,
        NOT_IN_EMPTY, .. } := D.core3
  let { REAL_MUL_RID, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_EMPTY, SUBSET_REFL,
        SUBSET_TRANS, .. } := D.core5
  let { real_abs, .. } := D.core6
  let { HULL_MINIMAL, SUBSET_HULL, .. } := D.misc
  let { BASIS_NONZERO, BETWEEN_IMP_COLLINEAR, COLLINEAR_2, COLLINEAR_3_TRANS,
        COLLINEAR_BETWEEN_CASES, COLLINEAR_LEMMA_ALT, COLLINEAR_SUBSET, .. } := D.vec1
  let { NORM_BASIS, .. } := D.vec2
  let { NORM_MUL, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_RCANCEL, VECTOR_SUB_EQ, VECTOR_SUB_RZERO, .. } := D.vec4
  let { BETWEEN_IN_SEGMENT, CLOSURE_EQ, .. } := D.top1
  let { CLOSURE_MINIMAL_EQ, .. } := D.top2
  let { EMPTY_INTERIOR_FINITE, ENDS_IN_SEGMENT, ENDS_NOT_IN_SEGMENT, .. } := D.top3
  let { INTERIOR_EMPTY, .. } := D.top4
  let { SEGMENT_CLOSED_OPEN, SEGMENT_OPEN_SUBSET_CLOSED, SEGMENT_REFL, SEGMENT_SCALAR_MULTIPLE,
        SUBSET_CLOSURE, SUBSET_INTERIOR, frontier, open_segment, .. } := D.top5
  let { AFFINE_INDEPENDENT_2, .. } := BAFD
  let { COLLINEAR_AFFINE_HULL, .. } := BCOP
  let { CONVEX_HULL_SING, .. } := BCVH
  let { CONVEX_HULL_SUBSET_AFFINE_HULL, .. } := BCLH
  let { AFFINE_INDEPENDENT_SPAN_GT, EMPTY_INTERIOR_CONVEX_HULL, .. } := BAFI
  let { CONVEX_HULL_EXCHANGE_INTER, .. } := BEXC
  let { SEGMENT_CONVEX_HULL, .. } := BSTL
  let { RELATIVE_INTERIOR_INTERIOR, .. } := BRIB
  let { SEGMENT_SUBSET_RELATIVE_FRONTIER_CONVEX, .. } := BRID
  let { CLOSURE_SEGMENT, CLOSED_SEGMENT, AFFINE_HULL_SEGMENT, CONVEX_SEGMENT,
        RELATIVE_INTERIOR_SEGMENT, SEGMENT_EQ_EMPTY, SEGMENT_EQ_SING, .. } := BSGA
  -- @@SCOPE END

  let SEGMENT_SUBSET_RELATIVE_FRONTIER_CONVEX_GEN ← prove
   r"!s a b c:real^N.
        convex s /\ collinear{a,b,c} /\
        ~(a = b) /\ ~(a = c) /\ ~(b = c) /\
        {a,b,c} SUBSET relative_frontier s
        ==> convex hull {a,b,c} SUBSET relative_frontier s"
   (REWRITE_TAC [COLLINEAR_BETWEEN_CASES] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") SEGMENT_SUBSET_RELATIVE_FRONTIER_CONVEX) THENL
     [DISCH_THEN (MP_TAC o SPECL [← q r"b:real^N", ← q r"c:real^N", ← q r"a:real^N"]),
      DISCH_THEN (MP_TAC o SPECL [← q r"c:real^N", ← q r"a:real^N", ← q r"b:real^N"]),
      DISCH_THEN (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N", ← q r"c:real^N"])] THEN
    REWRITE_TAC [open_segment, IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
    REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT] THEN
    (ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
    MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_SEGMENT] THEN
    REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, ENDS_IN_SEGMENT] THEN
    ASM_REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT])

  let SUBSET_SEGMENT_OPEN_CLOSED ← prove
   r"!a b c d:real^N.
        segment(a,b) SUBSET segment(c,d) <=>
        a = b \/ segment[a,b] SUBSET segment[c,d]"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [ASM_CASES_TAC (← q r"a:real^N = b") THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP SUBSET_CLOSURE) THEN
      ASM_REWRITE_TAC [CLOSURE_SEGMENT] THEN
      COND_CASES_TAC THEN REWRITE_TAC [SUBSET_EMPTY, SEGMENT_EQ_EMPTY],
      ALL_TAC] THEN
    DISCH_THEN (DISJ_CASES_THEN2 SUBST1_TAC MP_TAC) THEN
    REWRITE_TAC [SEGMENT_REFL, EMPTY_SUBSET] THEN
    ABBREV_TAC (← q r"m:real^N = d - c") THEN POP_ASSUM MP_TAC THEN
    GEOM_NORMALIZE_TAC (← q r"m:real^N") THEN
    SIMP_TAC [VECTOR_SUB_EQ, SEGMENT_REFL, SEGMENT_EQ_SING, SEGMENT_EQ_EMPTY,
              ← SET_RULE (← q r"s SUBSET {a} <=> s = {a} \/ s = {}"), SUBSET_REFL] THEN
    X_GEN_TAC (← q r"m:real^N") THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
    DISCH_THEN (SUBST_ALL_TAC o SYM) THEN POP_ASSUM MP_TAC THEN
    GEOM_ORIGIN_TAC (← q r"c:real^N") THEN GEOM_BASIS_MULTIPLE_TAC 1 (← q r"d:real^N") THEN
    X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    SIMP_TAC [VECTOR_SUB_RZERO, NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
    ASM_REWRITE_TAC [real_abs, REAL_MUL_RID] THEN DISCH_THEN SUBST_ALL_TAC THEN
    POP_ASSUM (K ALL_TAC) THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"collinear{vec 0:real^N,&1 % basis 1,x} /\
                  collinear{vec 0:real^N,&1 % basis 1,y}")
    MP_TAC THENL
     [ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b,c} = {a,c,b}")] THEN
      CONJ_TAC THEN MATCH_MP_TAC BETWEEN_IMP_COLLINEAR THEN
      REWRITE_TAC [BETWEEN_IN_SEGMENT] THEN
      ASM_MESON_TAC [SUBSET, ENDS_IN_SEGMENT],
      ALL_TAC] THEN
    SIMP_TAC [COLLINEAR_LEMMA_ALT, BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL,
              ← VECTOR_ARITH (← q r"&1 % x:real^N = vec 0 <=> x = vec 0")] THEN
    REWRITE_TAC [IMP_CONJ, VECTOR_MUL_ASSOC, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real") THEN REWRITE_TAC [REAL_MUL_RID] THEN
    DISCH_THEN SUBST_ALL_TAC THEN X_GEN_TAC (← q r"b:real") THEN
    DISCH_THEN SUBST_ALL_TAC THEN POP_ASSUM MP_TAC THEN
    SUBST1_TAC (← VECTOR_ARITH (← q r"vec 0:real^N = &0 % basis 1")) THEN
    ASM_SIMP_TAC [SEGMENT_SCALAR_MULTIPLE, VECTOR_MUL_RCANCEL, BASIS_NONZERO,
                  DIMINDEX_GE_1, LE_REFL, ← SET_RULE
                   (← q r"(!x y. x % v = y % v <=> x = y)
                    ==> ({x % v | P x} SUBSET {x % v | Q x} <=>
                         {x | P x} SUBSET {x | Q x})")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a <= x /\ x <= b \/ b <= x /\ x <= a <=>
                            min a b <= x /\ x <= max a b"),
                 ← REAL_ARITH (← q r"a < x /\ x < b \/ b < x /\ x < a <=>
                            min a b < x /\ x < max a b")] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"x:real") THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (MAP_EVERY (MP_TAC o C SPEC th)
        [← q r"min (a:real) b", ← q r"max (a:real) b"])) THEN
    REAL_ARITH_TAC)

  let SUBSET_SEGMENT ← prove
   r"(!a b c d:real^N.
        segment[a,b] SUBSET segment[c,d] <=>
        a IN segment[c,d] /\ b IN segment[c,d]) /\
   (!a b c d:real^N.
        segment[a,b] SUBSET segment(c,d) <=>
        a IN segment(c,d) /\ b IN segment(c,d)) /\
   (!a b c d:real^N.
        segment(a,b) SUBSET segment[c,d] <=>
        a = b \/ a IN segment[c,d] /\ b IN segment[c,d]) /\
   (!a b c d:real^N.
        segment(a,b) SUBSET segment(c,d) <=>
        a = b \/ a IN segment[c,d] /\ b IN segment[c,d])"
   (MATCH_MP_TAC (← TAUT (← q r"(a /\ b) /\ (a /\ b ==> c) ==> a /\ b /\ c")) THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [SEGMENT_CONVEX_HULL] THEN
      SIMP_TAC [SUBSET_HULL, CONVEX_SEGMENT] THEN SET_TAC [],
      STRIP_TAC THEN ASM_REWRITE_TAC [SUBSET_SEGMENT_OPEN_CLOSED] THEN
      REPEAT GEN_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"closure(segment(a:real^N,b)) SUBSET segment[c,d]") THEN
      CONJ_TAC THENL [SIMP_TAC [CLOSURE_MINIMAL_EQ, CLOSED_SEGMENT], ALL_TAC] THEN
      REWRITE_TAC [CLOSURE_SEGMENT] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [EMPTY_SUBSET]])

  let INTERIOR_SEGMENT ← prove
   r"(!a b:real^N. interior(segment[a,b]) =
                 if 2 <= dimindex(:N) then {} else segment(a,b)) /\
   (!a b:real^N. interior(segment(a,b)) =
                 if 2 <= dimindex(:N) then {} else segment(a,b))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"2 <= dimindex(:N)") THEN ASM_REWRITE_TAC [] THENL
     [MATCH_MP_TAC (← SET_RULE (← q r"t SUBSET s /\ s = {} ==> s = {} /\ t = {}")) THEN
      SIMP_TAC [SEGMENT_OPEN_SUBSET_CLOSED, SUBSET_INTERIOR] THEN
      REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
      MATCH_MP_TAC EMPTY_INTERIOR_CONVEX_HULL THEN
      REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY] THEN FIRST_ASSUM
       (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] LE_TRANS)) THEN
      SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN ARITH_TAC,
      ASM_CASES_TAC (← q r"a:real^N = b") THEN
      ASM_SIMP_TAC [SEGMENT_REFL, INTERIOR_EMPTY, EMPTY_INTERIOR_FINITE,
                    FINITE_SING] THEN
      SUBGOAL_THEN
       (← q r"affine hull (segment[a,b]) = (:real^N) /\
        affine hull (segment(a,b)) = (:real^N)")
       (fun th => tactic_of do
         pure (ASM_SIMP_TAC [th, ← GSYM RELATIVE_INTERIOR_INTERIOR,
                             RELATIVE_INTERIOR_SEGMENT])) THEN
      ASM_REWRITE_TAC [AFFINE_HULL_SEGMENT] THEN
      MATCH_MP_TAC AFFINE_INDEPENDENT_SPAN_GT THEN
      REWRITE_TAC [AFFINE_INDEPENDENT_2] THEN
      ASM_SIMP_TAC [CARD_CLAUSES, FINITE_RULES, IN_INSERT, NOT_IN_EMPTY] THEN
      ASM_ARITH_TAC])

  let FRONTIER_SEGMENT ← prove
   r"(!a b:real^N.
        frontier(segment[a,b]) =
        if 2 <= dimindex(:N) then segment[a,b] else {a,b}) /\
   (!a b:real^N.
        frontier(segment(a,b)) =
        if a = b then {}
        else if 2 <= dimindex(:N) then segment[a,b] else {a,b})"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [frontier, INTERIOR_SEGMENT, CLOSURE_SEGMENT] THEN
    ASM_CASES_TAC (← q r"2 <= dimindex(:N)") THEN ASM_REWRITE_TAC [DIFF_EMPTY] THEN
    SIMP_TAC [SEGMENT_REFL] THEN REWRITE_TAC [SEGMENT_CLOSED_OPEN] THEN
    REPEAT STRIP_TAC THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [SEGMENT_REFL, DIFF_EMPTY]) THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N"] ENDS_NOT_IN_SEGMENT) THEN
    SET_TAC [])

  let SEGMENT_EQ ← prove
   r"(!a b c d:real^N.
        segment[a,b] = segment[c,d] <=> {a,b} = {c,d}) /\
   (!a b c d:real^N.
        ~(segment[a,b] = segment(c,d))) /\
   (!a b c d:real^N.
        ~(segment(a,b) = segment[c,d])) /\
   (!a b c d:real^N.
        segment(a,b) = segment(c,d) <=> a = b /\ c = d \/ {a,b} = {c,d})"
   (MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [REPEAT GEN_TAC THEN EQ_TAC THENL
       [DISCH_THEN (fun th => tactic_of do
         pure (MP_TAC th THEN
           MP_TAC (← AP_TERM (← q r"\s:real^N->bool. s DIFF relative_interior s") th))) THEN
        REWRITE_TAC [RELATIVE_INTERIOR_SEGMENT] THEN
        REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [SEGMENT_REFL]) THEN
        SIMP_TAC [ENDS_IN_SEGMENT, open_segment, ← SET_RULE
          (← q r"a IN s /\ b IN s ==> s DIFF (s DIFF {a,b}) = {a,b}")] THEN
        ASM SET_TAC [SEGMENT_EQ_SING],
        SIMP_TAC [SEGMENT_CONVEX_HULL]],
      DISCH_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o AP_TERM (← q r"closed:(real^N->bool)->bool")) THEN
      REWRITE_TAC [← CONJUNCT1 CLOSED_SEGMENT] THEN
      REWRITE_TAC [← GSYM CLOSURE_EQ, CLOSURE_SEGMENT] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
       [ASM SET_TAC [SEGMENT_EQ_EMPTY],
        REWRITE_TAC [open_segment, ENDS_IN_SEGMENT, ← SET_RULE
         (← q r"s = s DIFF {a,b} <=> ~(a IN s) /\ ~(b IN s)")]],
      DISCH_TAC THEN CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c:real^N = d") THEN
      ASM_REWRITE_TAC [SEGMENT_EQ_EMPTY, SEGMENT_REFL] THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      CONV_TAC (BINOP_CONV SYM_CONV) THEN
      ASM_CASES_TAC (← q r"a:real^N = b") THEN
      ASM_REWRITE_TAC [SEGMENT_EQ_EMPTY, SEGMENT_REFL] THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET_SEGMENT_OPEN_CLOSED] THEN
      ASM_REWRITE_TAC [SUBSET_ANTISYM_EQ]])

  let COLLINEAR_SEGMENT ← prove
   r"(!a b:real^N. collinear(segment[a,b])) /\
   (!a b:real^N. collinear(segment(a,b)))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REWRITE_TAC [COLLINEAR_AFFINE_HULL] THEN
      MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
      REWRITE_TAC [SEGMENT_CONVEX_HULL, CONVEX_HULL_SUBSET_AFFINE_HULL],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COLLINEAR_SUBSET) THEN
      REWRITE_TAC [SEGMENT_OPEN_SUBSET_CLOSED]])

  let INTER_SEGMENT ← prove
   r"!a b c:real^N.
        b IN segment[a,c] \/ ~collinear{a,b,c}
        ==> segment[a,b] INTER segment[b,c] = {b}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c:real^N = a") THENL
     [ASM_SIMP_TAC [SEGMENT_REFL, IN_SING, INTER_IDEMPOT, INSERT_AC, COLLINEAR_2],
      ALL_TAC] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL
     [REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"{a:real^N,c}", ← q r"b:real^N", ← q r"{a:real^N}",
                        ← q r"{c:real^N}"]
          CONVEX_HULL_EXCHANGE_INTER) THEN
      ASM_REWRITE_TAC [AFFINE_INDEPENDENT_2] THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [INSERT_AC]] THEN
      DISCH_THEN SUBST1_TAC THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"~(a = c) ==> {a} INTER {c} = {}")] THEN
      REWRITE_TAC [CONVEX_HULL_SING],
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(s INTER t = {b})
        ==> b IN s /\ b IN t
            ==> ?a. ~(a = b) /\ a IN s /\ b IN s /\ a IN t /\ b IN t"))) THEN
      ANTS_TAC THENL [REWRITE_TAC [ENDS_IN_SEGMENT], ALL_TAC] THEN
      REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:real^N") THEN STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP BETWEEN_IMP_COLLINEAR)) THEN
      MATCH_MP_TAC COLLINEAR_3_TRANS THEN EXISTS_TAC (← q r"d:real^N") THEN
      REPEAT (POP_ASSUM MP_TAC) THEN SIMP_TAC [INSERT_AC]])

  return { SEGMENT_SUBSET_RELATIVE_FRONTIER_CONVEX_GEN, SUBSET_SEGMENT_OPEN_CLOSED,
           SUBSET_SEGMENT, INTERIOR_SEGMENT, FRONTIER_SEGMENT, SEGMENT_EQ, COLLINEAR_SEGMENT,
           INTER_SEGMENT }

/- ------------------------------------------------------------------------- -/
/- More basics about segments (part 3); theorems about strips between bounds -/
/- on a component.  (convex.ml 14717-14895)                                  -/
/- ------------------------------------------------------------------------- -/

structure SGC where
  CONVEX_LINE_INTERSECTION_UNIQUE_CLOSED : thm
  CONVEX_LINE_INTERSECTION_UNIQUE_OPEN_IN : thm
  CONVEX_LINE_INTERSECTION_UNIQUE_OPEN : thm
  CONVEX_LINE_INTERSECTIONS : thm
  CONVEX_LINE_INTERSECTIONS_ALT : thm
  CLOSED_STRIP_COMPONENT_LE : thm
  OPEN_STRIP_COMPONENT_LT : thm
  INTERIOR_STRIP_COMPONENT_LE : thm
  CLOSURE_STRIP_COMPONENT_LT : thm
  FRONTIER_STRIP_COMPONENT_LE : thm
  FRONTIER_STRIP_COMPONENT_LT : thm
  deriving Inhabited

@[nospecialize]
def setupSGC [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCOP : COP) (BCLH : CLH) (BMCG : MCG)
    (BSTL : STL) (BRIA : RIA) (BRIC : RIC) (BRID : RID) (BIRA : IRA) (BIRB : IRB) :
    ExceptT String IO SGC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } :=
    D
  let { EMPTY_DIFF, EMPTY_GSPEC, EMPTY_SUBSET, EXTENSION, .. } := D.core1
  let { INSERT_SUBSET, INTER_EMPTY, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNION, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        NOT_IN_EMPTY, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_TRANS, .. } := D.core5
  let { HULL_SUBSET, .. } := D.misc
  let { BETWEEN_SYM, BETWEEN_TRANS_2, COLLINEAR_BETWEEN_CASES, .. } := D.vec1
  let { VEC_COMPONENT, .. } := D.vec4
  let { BETWEEN_IN_SEGMENT, CLOSED_CLOSURE, CLOSED_HALFSPACE_COMPONENT_GE,
        CLOSED_HALFSPACE_COMPONENT_LE, CLOSED_INTER, CLOSURE_CLOSED, CLOSURE_EMPTY, .. } :=
    D.top1
  let { CLOSURE_INC, CLOSURE_SUBSET, .. } := D.top2
  let { ENDS_IN_SEGMENT, ENDS_NOT_IN_SEGMENT, .. } := D.top3
  let { INTERIOR_HALFSPACE_COMPONENT_GE, INTERIOR_HALFSPACE_COMPONENT_LE, INTERIOR_INTER,
        INTERIOR_OPEN, OPEN_HALFSPACE_COMPONENT_GT, OPEN_HALFSPACE_COMPONENT_LT, .. } := D.top4
  let { OPEN_INTER, OPEN_SUBSET, SEGMENT_CLOSED_OPEN, SEGMENT_OPEN_SUBSET_CLOSED, SEGMENT_REFL,
        frontier, open_segment, .. } := D.top5
  let { CONVEX_CONTAINS_SEGMENT_IMP, SEGMENT_SUBSET_CONVEX, CONVEX_STRIP_COMPONENT_LE, .. } :=
    BCVX
  let { COLLINEAR_3_IN_AFFINE_HULL, .. } := BCOP
  let { CONVEX_HULL_SUBSET_AFFINE_HULL, SEGMENT_SUBSET_LINE, .. } := BCLH
  let { CONVEX_CLOSURE, .. } := BMCG
  let { SEGMENT_CONVEX_HULL, .. } := BSTL
  let { relative_frontier, RELATIVE_INTERIOR_OPEN_IN, OPEN_IN_RELATIVE_INTERIOR,
        RELATIVE_FRONTIER_SUBSET, .. } := BRIA
  let { CONVEX_RELATIVE_INTERIOR, IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, .. } := BRIC
  let { CONVEX_OPEN_SEGMENT_CASES, .. } := BRID
  let { CONVEX_CLOSURE_INTERIOR, AFFINE_HULL_RELATIVE_INTERIOR, .. } := BIRA
  let { CONVEX_RELATIVE_INTERIOR_CLOSURE, RELATIVE_FRONTIER_CLOSURE,
        RELATIVE_FRONTIER_RELATIVE_INTERIOR, .. } := BIRB
  -- @@SCOPE END

  let CONVEX_LINE_INTERSECTION_UNIQUE_CLOSED ← prove
   r"!s a b:real^N.
        convex s /\ closed s /\
        a IN relative_frontier s /\ b IN relative_frontier s /\
        ~(segment(a,b) INTER relative_interior s = {})
        ==> s INTER (affine hull {a,b}) = segment[a,b]"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, EMPTY_SUBSET, INTER_EMPTY] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(a:real^N) IN s /\ (b:real^N) IN s") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [RELATIVE_FRONTIER_SUBSET, SUBSET], ALL_TAC] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET_INTER] THEN
    ASM_SIMP_TAC [SEGMENT_SUBSET_CONVEX] THEN
    REWRITE_TAC [SEGMENT_CONVEX_HULL, CONVEX_HULL_SUBSET_AFFINE_HULL] THEN
    REWRITE_TAC [SUBSET, ← GSYM SEGMENT_CONVEX_HULL, IN_INTER] THEN
    ASM_SIMP_TAC [← GSYM COLLINEAR_3_IN_AFFINE_HULL] THEN
    X_GEN_TAC (← q r"c:real^N") THEN STRIP_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"c:real^N = a", ← q r"c:real^N = b"] THEN
    ASM_REWRITE_TAC [ENDS_IN_SEGMENT] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [COLLINEAR_BETWEEN_CASES]) THEN
    REWRITE_TAC [BETWEEN_IN_SEGMENT, SEGMENT_CLOSED_OPEN] THEN
    ASM_REWRITE_TAC [IN_UNION, IN_INSERT, NOT_IN_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_INTER] THEN X_GEN_TAC (← q r"z:real^N") THEN
    STRIP_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"z:real^N", ← q r"c:real^N"]
        IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
    ASM_SIMP_TAC [CLOSURE_INC] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(?a. ~(a IN t) /\ a IN s) ==> s SUBSET t ==> P"))
    THENL [EXISTS_TAC (← q r"a:real^N"), EXISTS_TAC (← q r"b:real^N")] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [relative_frontier, IN_DIFF]) THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [open_segment, IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
    (CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [ENDS_NOT_IN_SEGMENT]]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE
      [open_segment, IN_DIFF, IN_INSERT, NOT_IN_EMPTY,
       ← GSYM BETWEEN_IN_SEGMENT]) THEN
    REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT] THEN
    ASM_MESON_TAC [BETWEEN_TRANS_2, BETWEEN_SYM])

  let CONVEX_LINE_INTERSECTION_UNIQUE_OPEN_IN ← prove
   r"!s a b:real^N.
        convex s /\
        open_in (subtopology euclidean (affine hull s)) s /\
        a IN relative_frontier s /\ b IN relative_frontier s /\
        ~(segment(a,b) INTER s = {})
        ==> s INTER (affine hull {a,b}) = segment(a,b)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [open_segment, ← SET_RULE
       (← q r"s SUBSET t DIFF {a,b} <=> (~(a IN s) /\ ~(b IN s)) /\ s SUBSET t")] THEN
      CONJ_TAC THENL
       [REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
         [relative_frontier])) THEN
        ASM_SIMP_TAC [RELATIVE_INTERIOR_OPEN_IN] THEN SET_TAC [],
        TRANS_TAC SUBSET_TRANS (← q r"closure s INTER affine hull {a:real^N,b}") THEN
        CONJ_TAC THENL
         [MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN SET_TAC [],
          MATCH_MP_TAC (← SET_RULE (← q r"s = t ==> s SUBSET t"))] THEN
        MATCH_MP_TAC CONVEX_LINE_INTERSECTION_UNIQUE_CLOSED THEN
        ASM_SIMP_TAC [CLOSED_CLOSURE, CONVEX_CLOSURE, RELATIVE_FRONTIER_CLOSURE,
          CONVEX_RELATIVE_INTERIOR_CLOSURE, RELATIVE_INTERIOR_OPEN_IN]],
      REWRITE_TAC [SUBSET_INTER, SEGMENT_SUBSET_LINE] THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N", ← q r"b:real^N"]
          CONVEX_OPEN_SEGMENT_CASES) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
         [relative_frontier])) THEN
      ASM_SIMP_TAC [RELATIVE_INTERIOR_OPEN_IN, IN_DIFF, relative_frontier] THEN
      ASM SET_TAC []])

  let CONVEX_LINE_INTERSECTION_UNIQUE_OPEN ← prove
   r"!s a b:real^N.
        convex s /\ open s /\
        a IN relative_frontier s /\ b IN relative_frontier s /\
        ~(segment(a,b) INTER s = {})
        ==> s INTER (affine hull {a,b}) = segment(a,b)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONVEX_LINE_INTERSECTION_UNIQUE_OPEN_IN THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC OPEN_SUBSET THEN
    ASM_REWRITE_TAC [HULL_SUBSET])

  let CONVEX_LINE_INTERSECTIONS ← prove
   r"!s a b:real^N.
        convex s /\ a IN relative_frontier s /\ b IN relative_frontier s /\
        ~(segment(a,b) INTER relative_interior s = {})
        ==> ~(a = b) /\
            closure s INTER affine hull {a,b} = segment[a,b] /\
            relative_interior s INTER affine hull {a,b} = segment(a,b) /\
            relative_frontier s INTER affine hull {a,b} = {a,b}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, INTER_EMPTY] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(p /\ q ==> r) /\ p /\ q ==> p /\ q /\ r")) THEN
    REPEAT CONJ_TAC THENL
     [STRIP_TAC THEN ASM_REWRITE_TAC [relative_frontier, ← SET_RULE
       (← q r"(s DIFF t) INTER u = (s INTER u) DIFF (t INTER u)")] THEN
      REWRITE_TAC [open_segment] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"t SUBSET s ==> s DIFF (s DIFF t) = t")) THEN
      REWRITE_TAC [INSERT_SUBSET, ENDS_IN_SEGMENT, EMPTY_SUBSET],
      MATCH_MP_TAC CONVEX_LINE_INTERSECTION_UNIQUE_CLOSED THEN
      ASM_SIMP_TAC [RELATIVE_FRONTIER_CLOSURE, CONVEX_RELATIVE_INTERIOR_CLOSURE,
                    CLOSED_CLOSURE, CONVEX_CLOSURE],
      MATCH_MP_TAC CONVEX_LINE_INTERSECTION_UNIQUE_OPEN_IN THEN
      ASM_SIMP_TAC [RELATIVE_FRONTIER_RELATIVE_INTERIOR,
                    OPEN_IN_RELATIVE_INTERIOR, CONVEX_RELATIVE_INTERIOR,
                    AFFINE_HULL_RELATIVE_INTERIOR]])

  let CONVEX_LINE_INTERSECTIONS_ALT ← prove
   r"!s a b:real^N.
        convex s /\ a IN relative_frontier s /\ b IN relative_frontier s /\
        ~(segment(a,b) SUBSET relative_frontier s)
        ==> ~(a = b) /\
            closure s INTER affine hull {a,b} = segment[a,b] /\
            relative_interior s INTER affine hull {a,b} = segment(a,b) /\
            relative_frontier s INTER affine hull {a,b} = {a,b}"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CONVEX_LINE_INTERSECTIONS THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [relative_frontier, IN_DIFF]) THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(s SUBSET c DIFF d) ==> s SUBSET c ==> ~(s INTER d = {})"))) THEN
    TRANS_TAC SUBSET_TRANS (← q r"segment[a:real^N,b]") THEN
    REWRITE_TAC [SEGMENT_OPEN_SUBSET_CLOSED] THEN
    ASM_SIMP_TAC [CONVEX_CONTAINS_SEGMENT_IMP, CONVEX_CLOSURE])

  let CLOSED_STRIP_COMPONENT_LE ← prove
   r"!a k. closed {x:real^N | abs(x$k) <= a}"
   (REWRITE_TAC [← REAL_ARITH (← q r"abs(x) <= a <=> x <= a /\ x >= --a")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
    SIMP_TAC [CLOSED_HALFSPACE_COMPONENT_LE, CLOSED_HALFSPACE_COMPONENT_GE,
              CLOSED_INTER])

  let OPEN_STRIP_COMPONENT_LT ← prove
   r"!a k. open {x:real^N | abs(x$k) < a}"
   (REWRITE_TAC [← REAL_ARITH (← q r"abs(x) < a <=> x < a /\ x > --a")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
    SIMP_TAC [OPEN_HALFSPACE_COMPONENT_LT, OPEN_HALFSPACE_COMPONENT_GT,
              OPEN_INTER])

  let INTERIOR_STRIP_COMPONENT_LE ← prove
   r"!a k. interior {x:real^N | abs(x$k) <= a} = {x | abs(x$k) < a}"
   (REWRITE_TAC [← REAL_ARITH (← q r"abs(x) <= a <=> x <= a /\ x >= --a"),
                 ← REAL_ARITH (← q r"abs(x) < a <=> x < a /\ x > --a")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
    REWRITE_TAC [INTERIOR_INTER, INTERIOR_HALFSPACE_COMPONENT_LE,
                 INTERIOR_HALFSPACE_COMPONENT_GE])

  let CLOSURE_STRIP_COMPONENT_LT ← prove
   r"!a k. closure {x:real^N | abs(x$k) < a} =
         if a = &0 then {} else {x | abs(x$k) <= a}"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"~(abs x < &0)"), EMPTY_GSPEC, CLOSURE_EMPTY] THEN
    ASM_CASES_TAC (← q r"a < &0") THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"a < &0 ==> ~(abs x < a) /\ ~(abs x <= a)"),
                  EMPTY_GSPEC, CLOSURE_EMPTY] THEN
    REWRITE_TAC [← GSYM INTERIOR_STRIP_COMPONENT_LE] THEN
    GEN_REWRITE_TAC RAND_CONV
     [← GSYM (← MATCH_MP CLOSURE_CLOSED (← SPEC_ALL CLOSED_STRIP_COMPONENT_LE))] THEN
    MATCH_MP_TAC CONVEX_CLOSURE_INTERIOR THEN
    REWRITE_TAC [CONVEX_STRIP_COMPONENT_LE, ← GSYM MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [INTERIOR_STRIP_COMPONENT_LE, IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"vec 0:real^N") THEN REWRITE_TAC [VEC_COMPONENT] THEN
    ASM_REAL_ARITH_TAC)

  let FRONTIER_STRIP_COMPONENT_LE ← prove
   r"!a k. frontier {x:real^N | abs(x$k) <= a} = {x | abs(x$k) = a}"
   (SIMP_TAC [frontier, CLOSED_STRIP_COMPONENT_LE, CLOSURE_CLOSED,
              INTERIOR_STRIP_COMPONENT_LE] THEN
    REWRITE_TAC [IN_DIFF, EXTENSION, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  let FRONTIER_STRIP_COMPONENT_LT ← prove
   r"!a k. frontier {x:real^N | abs(x$k) < a} =
         if a = &0 then {} else {x | abs(x$k) = a}"
   (SIMP_TAC [frontier, OPEN_STRIP_COMPONENT_LT, INTERIOR_OPEN,
              CLOSURE_STRIP_COMPONENT_LT] THEN
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [EMPTY_DIFF] THEN
    REWRITE_TAC [IN_DIFF, EXTENSION, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  return { CONVEX_LINE_INTERSECTION_UNIQUE_CLOSED, CONVEX_LINE_INTERSECTION_UNIQUE_OPEN_IN,
           CONVEX_LINE_INTERSECTION_UNIQUE_OPEN, CONVEX_LINE_INTERSECTIONS,
           CONVEX_LINE_INTERSECTIONS_ALT, CLOSED_STRIP_COMPONENT_LE, OPEN_STRIP_COMPONENT_LT,
           INTERIOR_STRIP_COMPONENT_LE, CLOSURE_STRIP_COMPONENT_LT, FRONTIER_STRIP_COMPONENT_LE,
           FRONTIER_STRIP_COMPONENT_LT }

/- ------------------------------------------------------------------------- -/
/- Lower-dimensional affine subsets are nowhere dense.                       -/
/- (convex.ml 14899-14984)                                                   -/
/- ------------------------------------------------------------------------- -/

structure NWD where
  DENSE_COMPLEMENT_SUBSPACE : thm
  DENSE_COMPLEMENT_AFFINE : thm
  DENSE_COMPLEMENT_OPEN_IN_AFFINE_HULL : thm
  DENSE_COMPLEMENT_CONVEX : thm
  DENSE_COMPLEMENT_CONVEX_CLOSED : thm
  deriving Inhabited

@[nospecialize]
def setupNWD [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCLH : CLH) (BADA : ADA) (BADB : ADB)
    (BRIA : RIA) (BIRA : IRA) : ExceptT String IO NWD := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH,
        NORM_ARITH, GEOM_ORIGIN_TAC, .. } := D
  let { EQ_IMP, EQ_TRANS, .. } := D.core1
  let { INTER_SUBSET, INT_OF_NUM_LT, IN_DIFF, .. } := D.core2
  let { IN_INTER, LEFT_IMP_EXISTS_THM, LET_TRANS, LT_REFL, MEMBER_NOT_EMPTY, MONO_FORALL,
        NOT_IMP, PSUBSET, REAL_ABS_DIV, REAL_ABS_NUM, REAL_DIV_EQ_0, REAL_DIV_RMUL, .. } :=
    D.core3
  let { SUBSET, SUBSET_ANTISYM, SUBSET_DIFF, .. } := D.core5
  let { HULL_INC, HULL_SUBSET, .. } := D.misc
  let { DIM_SPAN, DIM_SUBSET, DIST_REFL, .. } := D.vec1
  let { NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, ORTHOGONAL_MUL, ORTHOGONAL_REFL, ORTHOGONAL_TO_SUBSPACE_EXISTS_GEN,
        REAL_ABS_NORM, SPAN_ADD, SPAN_MONO, SPAN_MUL, SPAN_OF_SUBSPACE, SPAN_SUPERSET,
        SUBSPACE_ADD, SUBSPACE_MUL, .. } := D.vec3
  let { CLOSED_SUBSPACE, CLOSURE_APPROACHABLE, CLOSURE_CLOSED, .. } := D.top1
  let { CLOSURE_MINIMAL, CLOSURE_OPEN_IN_INTER_CLOSURE, .. } := D.top2
  let { SUBSET_CLOSURE, .. } := D.top5
  let { AFFINE_AFFINE_HULL, .. } := BAFF
  let { AFFINE_EQ_SUBSPACE, CLOSED_AFFINE, .. } := BCLH
  let { AFF_DIM_AFFINE_HULL, .. } := BADA
  let { AFF_DIM_DIM_0, .. } := BADB
  let { OPEN_IN_RELATIVE_INTERIOR, RELATIVE_INTERIOR_SUBSET, .. } := BRIA
  let { CONVEX_CLOSURE_RELATIVE_INTERIOR, AFFINE_HULL_RELATIVE_INTERIOR,
        AFF_DIM_RELATIVE_INTERIOR, .. } := BIRA
  -- @@SCOPE END

  let DENSE_COMPLEMENT_SUBSPACE ← prove
   r"!s t:real^N->bool.
        dim t < dim s /\ subspace s ==> closure(s DIFF t) = s"
   (SUBGOAL_THEN
     (← q r"!s t:real^N->bool.
          dim t < dim s /\ subspace s /\ t SUBSET s
          ==> closure(s DIFF t) = s")
    MP_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s INTER t:real^N->bool")) THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"s DIFF (s INTER t) = s DIFF t")] THEN
      DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [INTER_SUBSET] THEN
      TRANS_TAC LET_TRANS (← q r"dim(t:real^N->bool)") THEN
      ASM_SIMP_TAC [DIM_SUBSET, INTER_SUBSET]] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"s:real^N->bool"]
          ORTHOGONAL_TO_SUBSPACE_EXISTS_GEN) THEN
    ASM_SIMP_TAC [PSUBSET, SPAN_MONO] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [LT_REFL, DIM_SPAN], ASM_SIMP_TAC [SPAN_OF_SUBSPACE]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_SIMP_TAC [CLOSED_SUBSPACE] THEN
      SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_DIFF, CLOSURE_APPROACHABLE] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN t") THENL
     [ALL_TAC, EXISTS_TAC (← q r"x:real^N") THEN ASM_REWRITE_TAC [DIST_REFL]] THEN
    EXISTS_TAC (← q r"x + e / &2 / norm(a) % a:real^N") THEN REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [SUBSPACE_ADD, SUBSPACE_MUL],
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"(x + e / &2 / norm(a) % a) + -- &1 % x:real^N")) THEN
      ASM_SIMP_TAC [NOT_IMP, SPAN_ADD, SPAN_MUL, SPAN_SUPERSET] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"(x + a) + -- &1 % x:real^N = a")] THEN
      ASM_REWRITE_TAC [ORTHOGONAL_MUL, ORTHOGONAL_REFL,
                       REAL_DIV_EQ_0, NORM_EQ_0] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [← NORM_ARITH (← q r"dist(x + a:real^N,x) = norm a")] THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM, REAL_ABS_NUM] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0] THEN ASM_REAL_ARITH_TAC])

  let DENSE_COMPLEMENT_AFFINE ← prove
   r"!s t:real^N->bool.
        aff_dim t < aff_dim s /\ affine s ==> closure(s DIFF t) = s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s INTER t:real^N->bool = {}") THENL
     [REPEAT STRIP_TAC THEN
      TRANS_TAC EQ_TRANS (← q r"closure s:real^N->bool") THEN CONJ_TAC THENL
       [AP_TERM_TAC THEN ASM SET_TAC [],
        ASM_SIMP_TAC [CLOSURE_CLOSED, CLOSED_AFFINE]],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_INTER] THEN X_GEN_TAC (← q r"z:real^N") THEN
      GEOM_ORIGIN_TAC (← q r"z:real^N") THEN
      SIMP_TAC [AFFINE_EQ_SUBSPACE, AFF_DIM_DIM_0, HULL_INC, INT_OF_NUM_LT] THEN
      MESON_TAC [DENSE_COMPLEMENT_SUBSPACE]])

  let DENSE_COMPLEMENT_OPEN_IN_AFFINE_HULL ← prove
   r"!s t:real^N->bool.
        aff_dim t < aff_dim s /\
        open_in (subtopology euclidean (affine hull s)) s
        ==> closure(s DIFF t) = closure s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"affine hull s DIFF t:real^N->bool",
             ← q r"affine hull s:real^N->bool"] CLOSURE_OPEN_IN_INTER_CLOSURE) THEN
    ASM_REWRITE_TAC [OPEN_IN_RELATIVE_INTERIOR, SUBSET_DIFF] THEN
    ASM_SIMP_TAC [DENSE_COMPLEMENT_AFFINE, AFFINE_AFFINE_HULL,
                  AFF_DIM_AFFINE_HULL] THEN
    CONV_TAC (RAND_CONV SYM_CONV) THEN MATCH_MP_TAC EQ_IMP THEN
    BINOP_TAC THEN AP_TERM_TAC THEN
    MP_TAC (← ISPECL [← q r"affine:(real^N->bool)->bool", ← q r"s:real^N->bool"]
          HULL_SUBSET) THEN SET_TAC [])

  let DENSE_COMPLEMENT_CONVEX ← prove
   r"!s t:real^N->bool.
        aff_dim t < aff_dim s /\ convex s ==> closure(s DIFF t) = closure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [SUBSET_CLOSURE, SUBSET_DIFF] THEN
    MP_TAC (← ISPECL [← q r"relative_interior s:real^N->bool", ← q r"t:real^N->bool"]
          DENSE_COMPLEMENT_OPEN_IN_AFFINE_HULL) THEN
    ASM_SIMP_TAC [OPEN_IN_RELATIVE_INTERIOR, AFF_DIM_RELATIVE_INTERIOR,
      AFFINE_HULL_RELATIVE_INTERIOR, CONVEX_CLOSURE_RELATIVE_INTERIOR] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC SUBSET_CLOSURE THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN SET_TAC [])

  let DENSE_COMPLEMENT_CONVEX_CLOSED ← prove
   r"!s t:real^N->bool.
        aff_dim t < aff_dim s /\ convex s /\ closed s
        ==> closure(s DIFF t) = s"
   (ASM_SIMP_TAC [DENSE_COMPLEMENT_CONVEX, CLOSURE_CLOSED])

  return { DENSE_COMPLEMENT_SUBSPACE, DENSE_COMPLEMENT_AFFINE,
           DENSE_COMPLEMENT_OPEN_IN_AFFINE_HULL, DENSE_COMPLEMENT_CONVEX,
           DENSE_COMPLEMENT_CONVEX_CLOSED }

/- ------------------------------------------------------------------------- -/
/- Homeomorphism of all convex compact sets with same affine dimension, and  -/
/- in particular all those with nonempty interior (part 1).                  -/
/- (convex.ml 14995-15343)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HMA where
  COMPACT_FRONTIER_LINE_LEMMA : thm
  STARLIKE_COMPACT_PROJECTIVE : thm
  deriving Inhabited

@[nospecialize]
def setupHMA [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCLH : CLH) (BRIA : RIA) (BRIE : RIE)
    (BIRB : IRB) : ExceptT String IO HMA := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        SET_RULE, SET_TAC, GEN_SIMPLIFY_CONV, TOP_DEPTH_SQCONV, basic_ss, VECTOR_ARITH,
        NORM_ARITH, GEOM_ORIGIN_TAC, .. } := D
  let { ARITH, ARITH_EQ, CONJ_ASSOC, CONTRAPOS_THM, DIMINDEX_1, EQ_IMP, EXISTS_REFL,
        EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INTER_SUBSET, IN_DELETE,
        IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIV, LAMBDA_BETA, LEFT_AND_EXISTS_THM,
        LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, REAL_ABS_DIV,
        REAL_ABS_INV, REAL_ABS_NUM, REAL_DIV_RMUL, .. } := D.core3
  let { REAL_INV_1, REAL_INV_EQ_0, REAL_INV_MUL, REAL_LET_TRANS, REAL_LE_DIV, REAL_LE_LDIV_EQ,
        REAL_LE_LT, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_RMUL_EQ, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_MUL, .. } :=
    D.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_RINV, REAL_MUL_SYM, REAL_NOT_LT,
        REAL_OF_NUM_EQ, REAL_OF_NUM_LT, REAL_POS, RIGHT_IMP_FORALL_THM, SUBSET,
        SUBSET_ANTISYM, .. } := D.core5
  let { SWAP_FORALL_THM, o_DEF, o_THM, real_abs, real_div, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { DIST_0, DIST_REFL, .. } := D.vec1
  let { DROP_VEC, EXISTS_LIFT, IN_INTERVAL, LIFT_DROP, NORM_0, NORM_EQ_0, .. } := D.vec2
  let { NORM_LIFT, NORM_MUL, NORM_NEG, NORM_POS_LE, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_LCANCEL, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, VECTOR_MUL_RCANCEL, VECTOR_MUL_RZERO, VECTOR_SUB_EQ,
        VECTOR_SUB_LZERO, dist, drop, .. } := D.vec4
  let { BALL_SUBSET_CBALL, BOUNDED_POS, CBALL_DIFF_SPHERE, CLOSURE_CLOSED, .. } := D.top1
  let { COMPACT_CBALL, COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED,
        COMPACT_INTER, COMPACT_INTERVAL, COMPACT_INTER_CLOSED, CONTINUOUS_AT_ID,
        CONTINUOUS_AT_IMP_CONTINUOUS_ON, CONTINUOUS_AT_INV, CONTINUOUS_AT_LIFT_NORM, .. } :=
    D.top2
  let { CONTINUOUS_LIFT_NORM_COMPOSE, CONTINUOUS_MUL, CONTINUOUS_ON_COMPOSE,
        CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET, CONTINUOUS_VMUL,
        CONTINUOUS_WITHIN, CONTINUOUS_WITHIN_ID, CONTINUOUS_WITHIN_SUBSET,
        DISTANCE_ATTAINS_SUP, EVENTUALLY_AT, EVENTUALLY_WITHIN, FRONTIER_STRADDLE, .. } := D.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM, HOMEOMORPHISM_COMPACT, HOMEOMORPHISM_OF_SUBSETS,
        IN_CBALL, IN_CBALL_0, IN_SEGMENT, IN_SPHERE_0, LIM_NULL_VMUL_BOUNDED,
        LIM_TRANSFORM_WITHIN_SET, LIM_WITHIN, .. } := D.top4
  let { homeomorphic, homeomorphism, .. } := D.top5
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL, .. } := BAFF
  let { CLOSED_AFFINE_HULL, .. } := BCLH
  let { relative_frontier, RELATIVE_INTERIOR_SUBSET, .. } := BRIA
  let { RAY_TO_RELATIVE_FRONTIER, .. } := BRIE
  let { COMPACT_RELATIVE_BOUNDARY, .. } := BIRB
  -- @@SCOPE END

  let COMPACT_FRONTIER_LINE_LEMMA ← prove
   r"!s x. compact s /\ (vec 0 IN s) /\ ~(x = vec 0 :real^N)
         ==> ?u. &0 <= u /\ (u % x) IN frontier s /\
                 !v. u < v ==> ~((v % x) IN s)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
    REWRITE_TAC [BOUNDED_POS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
      [← q r"{y:real^N | ?u. &0 <= u /\ u <= b / norm(x) /\ (y = u % x)} INTER s",
       ← q r"vec 0:real^N"]
     DISTANCE_ATTAINS_SUP) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"vec 0:real^N") THEN
        ASM_REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"&0") THEN
        ASM_SIMP_TAC [VECTOR_MUL_LZERO, REAL_LE_REFL, REAL_LT_IMP_LE,
                      REAL_LT_DIV, NORM_POS_LT]] THEN
      MATCH_MP_TAC COMPACT_INTER THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"{y:real^N | ?u. &0 <= u /\ u <= b / norm(x) /\ (y = u % x)} =
        IMAGE (\u. drop u % x) (interval [vec 0,lambda i. b / norm(x:real^N)])")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE, IN_INTERVAL] THEN
        SIMP_TAC [LAMBDA_BETA] THEN
        SIMP_TAC [DIMINDEX_1, ← ARITH_RULE (← q r"1 <= i /\ i <= 1 <=> (i = 1)")] THEN
        REWRITE_TAC [← GSYM drop, LEFT_FORALL_IMP_THM, EXISTS_REFL, DROP_VEC] THEN
        REWRITE_TAC [EXISTS_LIFT, LIFT_DROP] THEN MESON_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      REWRITE_TAC [COMPACT_INTERVAL] THEN
      MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC CONTINUOUS_VMUL THEN
      REWRITE_TAC [o_DEF, LIFT_DROP, CONTINUOUS_AT_ID],
      ALL_TAC] THEN
    REWRITE_TAC [IN_INTER, IN_ELIM_THM, LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b /\ c) /\ d <=> c /\ a /\ b /\ d")] THEN
    SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    GEN_REWRITE_TAC (BINDER_CONV o ONCE_DEPTH_CONV) [SWAP_FORALL_THM] THEN
    SIMP_TAC [IMP_CONJ] THEN
    REWRITE_TAC [LEFT_FORALL_IMP_THM, EXISTS_REFL] THEN
    REWRITE_TAC [IMP_IMP] THEN REWRITE_TAC [LEFT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real") THEN
    REWRITE_TAC [dist, VECTOR_SUB_LZERO, NORM_NEG, NORM_MUL] THEN
    ASM_SIMP_TAC [REAL_LE_RMUL_EQ, NORM_POS_LT] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [real_abs] THEN REPEAT STRIP_TAC THENL
     [REWRITE_TAC [FRONTIER_STRADDLE] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      CONJ_TAC THENL
       [EXISTS_TAC (← q r"u % x :real^N") THEN ASM_REWRITE_TAC [DIST_REFL],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"(u + (e / &2) / norm(x)) % x :real^N") THEN
      REWRITE_TAC [dist, ← VECTOR_ARITH (← q r"u % x - (u + a) % x = --(a % x)")] THEN
      ASM_SIMP_TAC [NORM_NEG, NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM, NORM_EQ_0,
                    REAL_DIV_RMUL, REAL_ABS_NUM, REAL_LT_LDIV_EQ, REAL_OF_NUM_LT,
                    ARITH, ← REAL_ARITH (← q r"abs e < e * &2 <=> &0 < e")] THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u + (e / &2) / norm(x:real^N)")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < e /\ &0 <= u /\ u + e <= b
        ==> ~(&0 <= u + e /\ u + e <= b ==> u + e <= u)")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH, NORM_POS_LT] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(u + (e / &2) / norm(x:real^N)) % x")) THEN
      ASM_SIMP_TAC [NORM_MUL, ← GSYM REAL_LE_RDIV_EQ, NORM_POS_LT] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real")) THEN
    ASM_REWRITE_TAC [← GSYM REAL_NOT_LT] THEN ASM_REWRITE_TAC [REAL_NOT_LT] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [REAL_LET_TRANS, REAL_LT_IMP_LE], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v % x:real^N")) THEN
    ASM_SIMP_TAC [NORM_MUL, ← GSYM REAL_LE_RDIV_EQ, NORM_POS_LT] THEN
    REAL_ARITH_TAC)

  let STARLIKE_COMPACT_PROJECTIVE ← prove
   r"!s:real^N->bool a.
       compact s /\ a IN relative_interior s /\
       (!x. x IN s ==> segment(a,x) SUBSET relative_interior s)
       ==> s DIFF relative_interior s homeomorphic
           sphere(a,&1) INTER affine hull s /\
           s homeomorphic cball(a,&1) INTER affine hull s /\
           relative_interior s homeomorphic (ball(a,&1)) INTER affine hull s"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    REWRITE_TAC [SUBSET, IMP_IMP, RIGHT_IMP_FORALL_THM] THEN
    GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x:real^N u. x IN s /\ &0 <= u /\ u < &1
                   ==> (u % x) IN relative_interior s")
    ASSUME_TAC THENL
     [REWRITE_TAC [← REAL_ARITH (← q r"&0 <= u <=> u = &0 \/ &0 < u")] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO] THEN
      ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
      ASM_REWRITE_TAC [VECTOR_MUL_RZERO] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_SEGMENT] THEN
      REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN ASM_MESON_TAC [],
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o
        SPECL [← q r"x:real^N", ← q r"x:real^N"])] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
      RELATIVE_INTERIOR_SUBSET)) THEN
    ABBREV_TAC (← q r"proj = \x:real^N. inv(norm(x)) % x") THEN
    SUBGOAL_THEN
     (← q r"!x:real^N y. (proj(x) = proj(y):real^N) /\ (norm x = norm y) <=> (x = y)")
    ASSUME_TAC THENL
     [REPEAT GEN_TAC THEN EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
      ASM_CASES_TAC (← q r"y:real^N = vec 0") THEN
      ASM_SIMP_TAC [NORM_EQ_0, NORM_0] THEN
      ASM_CASES_TAC (← q r"x:real^N = vec 0") THENL
       [ASM_MESON_TAC [NORM_EQ_0], ALL_TAC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      EXPAND_TAC "proj" THEN REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH
       (← q r"a % x = a % y <=> a % (x - y):real^N = vec 0")] THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, REAL_INV_EQ_0, NORM_EQ_0, VECTOR_SUB_EQ],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(!x. x IN affine hull s ==> proj x IN affine hull s) /\
      (!x. ~(x = vec 0) ==> norm(proj x) = &1) /\
      (!x:real^N. proj x = vec 0 <=> x = vec 0)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "proj" THEN REWRITE_TAC [NORM_MUL, VECTOR_MUL_EQ_0] THEN
      REWRITE_TAC [REAL_INV_EQ_0, NORM_EQ_0, REAL_ABS_INV, REAL_ABS_NORM] THEN
      SIMP_TAC [REAL_MUL_LINV, NORM_EQ_0] THEN REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_LID] THEN
      MATCH_MP_TAC IN_AFFINE_ADD_MUL THEN
      ASM_SIMP_TAC [AFFINE_AFFINE_HULL, VECTOR_ADD_LID, HULL_INC],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(proj:real^N->real^N) continuous_on (UNIV DELETE vec 0)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
      REWRITE_TAC [IN_DELETE, IN_UNIV] THEN EXPAND_TAC "proj" THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_MUL THEN
      ASM_SIMP_TAC [CONTINUOUS_AT_ID] THEN
      REWRITE_TAC [← GSYM (← ISPEC (← q r"lift") o_DEF),
                   ← GSYM (← ISPEC (← q r"inv:real->real") o_DEF)] THEN
      MATCH_MP_TAC CONTINUOUS_AT_INV THEN
      ASM_REWRITE_TAC [NORM_EQ_0, VECTOR_SUB_EQ, CONTINUOUS_AT_LIFT_NORM],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a x. &0 < a ==> (proj:real^N->real^N)(a % x) = proj x")
    ASSUME_TAC THENL
     [REPEAT GEN_TAC THEN EXPAND_TAC "proj" THEN
      REWRITE_TAC [NORM_MUL, REAL_INV_MUL, VECTOR_MUL_ASSOC] THEN
      SIMP_TAC [← REAL_FIELD (← q r"&0 < a ==> (inv(a) * x) * a = x"), real_abs,
                REAL_LT_IMP_LE],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"usph = {x:real^N | x IN affine hull s /\ norm x = &1}") THEN
    SUBGOAL_THEN (← q r" sphere(vec 0:real^N,&1) INTER affine hull s = usph")
    SUBST1_TAC THENL
     [EXPAND_TAC "usph" THEN REWRITE_TAC [EXTENSION, IN_INTER, IN_SPHERE_0] THEN
      SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN affine hull s /\ ~(x = vec 0)
          ==> (proj:real^N->real^N) x IN usph")
    ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?surf. homeomorphism (s DIFF relative_interior s,usph)
                                       (proj:real^N->real^N,surf)")
    MP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHISM_COMPACT THEN
      ASM_SIMP_TAC [COMPACT_RELATIVE_BOUNDARY] THEN REPEAT CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
        ASM SET_TAC [],
        MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
         [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_DIFF] THEN
          EXPAND_TAC "usph" THEN REWRITE_TAC [IN_ELIM_THM] THEN
          ASM_MESON_TAC [HULL_INC],
          MAP_EVERY EXPAND_TAC ["proj", "usph"] THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN
          ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
          ASM_REWRITE_TAC [NORM_0, REAL_OF_NUM_EQ, ARITH_EQ] THEN STRIP_TAC THEN
          MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"vec 0:real^N", ← q r"x:real^N"]
              RAY_TO_RELATIVE_FRONTIER) THEN
          REWRITE_TAC [relative_frontier] THEN
          ASM_SIMP_TAC [COMPACT_IMP_BOUNDED, CLOSURE_CLOSED, COMPACT_IMP_CLOSED,
                        VECTOR_ADD_LID] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
          EXPAND_TAC "proj" THEN REWRITE_TAC [IN_IMAGE] THEN
          EXISTS_TAC (← q r"d % x:real^N") THEN ASM_REWRITE_TAC [NORM_MUL] THEN
          ASM_SIMP_TAC [REAL_MUL_RID, real_abs, REAL_LT_IMP_LE] THEN
          ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, REAL_LT_IMP_NZ,
                        VECTOR_MUL_LID]],
        MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
        REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q r"x:real^N = vec 0") THENL [ASM SET_TAC [], ALL_TAC] THEN
        ASM_CASES_TAC (← q r"y:real^N = vec 0") THENL [ASM SET_TAC [], ALL_TAC] THEN
        UNDISCH_TAC (← q r"(proj:real^N->real^N) x = proj y") THEN
        EXPAND_TAC "proj" THEN
        REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC (← REAL_ARITH
         (← q r"norm(x:real^N) = norm(y:real^N) \/
          norm x < norm y \/ norm y < norm x"))
        THENL
         [ASM_REWRITE_TAC [VECTOR_MUL_LCANCEL, REAL_INV_EQ_0, NORM_EQ_0],
          DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"y:real^N", ← q r"norm(x:real^N) / norm(y:real^N)"]),
          DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"x:real^N", ← q r"norm(y:real^N) / norm(x:real^N)"])] THEN
        ASM_SIMP_TAC [REAL_LE_DIV, NORM_POS_LE, REAL_LT_LDIV_EQ, NORM_POS_LT,
                      REAL_MUL_LID] THEN
        ASM_REWRITE_TAC [real_div, ← GSYM VECTOR_MUL_ASSOC] THENL
         [FIRST_X_ASSUM (SUBST1_TAC o SYM), ALL_TAC] THEN
        ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, NORM_EQ_0] THEN
        ASM_REWRITE_TAC [VECTOR_MUL_LID]],
      DISCH_THEN (X_CHOOSE_TAC (← q r"surf:real^N->real^N"))] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [homeomorphic], ALL_TAC] THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MATCH_MP_TAC (← MESON [] (← q r"(?x. P x /\ Q x) ==> (?x. P x) /\ (?x. Q x)")) THEN
    EXISTS_TAC (← q r"\x:real^N. norm(x) % (surf:real^N->real^N)(proj(x))") THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^N") THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q <=> p ==> p ==> q")] THEN
      GEN_REWRITE_TAC LAND_CONV [homeomorphism] THEN
      REWRITE_TAC [] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] HOMEOMORPHISM_OF_SUBSETS) THEN
      SIMP_TAC [RELATIVE_INTERIOR_SUBSET, BALL_SUBSET_CBALL, ← SET_RULE
                (← q r"b SUBSET c ==> b INTER s SUBSET c INTER s")] THEN
      ONCE_REWRITE_TAC [← GSYM CBALL_DIFF_SPHERE] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"(s DIFF t) INTER u = (s INTER u) DIFF {x | x IN u /\ x IN t}")] THEN
      ASM_REWRITE_TAC [IN_SPHERE_0] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\ u SUBSET s /\
        IMAGE f s DIFF IMAGE f u = v
        ==> IMAGE f (s DIFF u) = v")) THEN
      ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN CONJ_TAC THENL
       [EXPAND_TAC "usph" THEN
        SIMP_TAC [SUBSET, IN_ELIM_THM, IN_INTER, IN_CBALL_0, REAL_LE_REFL],
        MATCH_MP_TAC (← SET_RULE
         (← q r"t SUBSET s /\ u = s DIFF t ==> s DIFF u = t")) THEN
        REWRITE_TAC [RELATIVE_INTERIOR_SUBSET] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
        DISCH_THEN (fun th => tactic_of do
          pure (SUBST1_TAC (← SYM (← liftExcept (el 4 (CONJUNCTS th)))))) THEN
        MATCH_MP_TAC IMAGE_EQ THEN MAP_EVERY EXPAND_TAC ["usph", "proj"] THEN
        SIMP_TAC [IN_ELIM_THM, REAL_INV_1, REAL_MUL_LID, VECTOR_MUL_LID]],
      ALL_TAC] THEN
    MATCH_MP_TAC HOMEOMORPHISM_COMPACT THEN
    SIMP_TAC [COMPACT_INTER_CLOSED, CLOSED_AFFINE_HULL, COMPACT_CBALL] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHISM]) THEN
    STRIP_TAC THEN
    UNDISCH_THEN
     (← q r"(proj:real^N->real^N) continuous_on s DIFF relative_interior s")
     (K ALL_TAC : thm → tactic) THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, IN_INTER] THEN
      X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"x = vec 0:real^N") THENL
       [ASM_REWRITE_TAC [CONTINUOUS_WITHIN, VECTOR_MUL_LZERO, NORM_0] THEN
        MATCH_MP_TAC LIM_NULL_VMUL_BOUNDED THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
        REWRITE_TAC [BOUNDED_POS] THEN MATCH_MP_TAC MONO_EXISTS THEN
        REPEAT STRIP_TAC THENL
         [REWRITE_TAC [LIM_WITHIN, o_THM, DIST_0, NORM_LIFT, REAL_ABS_NORM] THEN
          MESON_TAC [],
          REWRITE_TAC [EVENTUALLY_WITHIN] THEN EXISTS_TAC (← q r"&1") THEN
          REWRITE_TAC [REAL_LT_01, IN_INTER, DIST_0, NORM_POS_LT] THEN
          ASM SET_TAC []],
        MATCH_MP_TAC CONTINUOUS_WITHIN_SUBSET THEN
        EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
        REWRITE_TAC [INTER_SUBSET] THEN MATCH_MP_TAC CONTINUOUS_MUL THEN
        SIMP_TAC [CONTINUOUS_LIFT_NORM_COMPOSE, CONTINUOUS_WITHIN_ID, o_DEF] THEN
        SUBGOAL_THEN
         (← q r"((surf:real^N->real^N) o (proj:real^N->real^N)) continuous_on
          (affine hull s DELETE vec 0)")
        MP_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          ASM_REWRITE_TAC [] THEN CONJ_TAC THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)) THEN
          SIMP_TAC [SUBSET, IN_DELETE, IN_UNIV, FORALL_IN_IMAGE] THEN
          EXPAND_TAC "usph" THEN ASM_SIMP_TAC [IN_ELIM_THM],
          SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_SIMP_TAC [IN_DELETE] THEN
          REWRITE_TAC [CONTINUOUS_WITHIN, o_DEF] THEN MATCH_MP_TAC EQ_IMP THEN
          MATCH_MP_TAC LIM_TRANSFORM_WITHIN_SET THEN
          REWRITE_TAC [EVENTUALLY_AT] THEN EXISTS_TAC (← q r"norm(x:real^N)") THEN
          ASM_REWRITE_TAC [IN_DELETE, IN_INTER, IN_CBALL, NORM_POS_LT] THEN
          X_GEN_TAC (← q r"y:real^N") THEN
          ASM_CASES_TAC (← q r"(y:real^N) IN affine hull s") THEN ASM_REWRITE_TAC [] THEN
          CONV_TAC (fun t => NORM_ARITH t)]],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
      ASM_CASES_TAC (← q r"y:real^N = vec 0") THENL
       [ASM_SIMP_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_EQ_0, NORM_0, NORM_EQ_0] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"x:real^N = vec 0") THENL
       [CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN
        ASM_SIMP_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_EQ_0, NORM_0, NORM_EQ_0] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [IN_INTER, IN_CBALL_0] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC th THEN MP_TAC (← AP_TERM (← q r"proj:real^N->real^N") th))) THEN
      ASM_SIMP_TAC [NORM_POS_LT, VECTOR_MUL_RCANCEL] THEN ASM SET_TAC []] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTER, IN_CBALL_0] THEN
      X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
      ASM_REWRITE_TAC [NORM_0, VECTOR_MUL_LZERO, IN_INTER] THEN
      REWRITE_TAC [IN_CBALL_0, REAL_LE_LT] THEN STRIP_TAC  THENL
       [MATCH_MP_TAC (← REWRITE_RULE [SUBSET] RELATIVE_INTERIOR_SUBSET) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [NORM_POS_LE] THEN
        ASM SET_TAC [],
        ASM_REWRITE_TAC [VECTOR_MUL_LID] THEN ASM SET_TAC []],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_IMAGE, IN_CBALL_0, IN_INTER] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"x:real^N = vec 0") THENL
     [EXISTS_TAC (← q r"vec 0:real^N") THEN
      ASM_SIMP_TAC [NORM_0, VECTOR_MUL_LZERO, HULL_INC, REAL_POS],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN usph ==> ~((surf:real^N->real^N) x = vec 0)")
    ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q r"inv(norm(surf(proj x:real^N):real^N)) % x:real^N") THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC LAND_CONV [← GSYM th])) THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
    ASM (fun ths => tactic_of do
      pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
        (← ExceptT.mk (basic_ss [])) 5 ths))))
     [NORM_POS_LT, REAL_LT_INV_EQ, HULL_INC, REAL_LT_MUL, NORM_MUL,
      REAL_ABS_INV, REAL_ABS_NORM] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC (← REAL_FIELD (← q r"~(y = &0) ==> x = (inv y * x) * y")) THEN
      ASM_SIMP_TAC [NORM_EQ_0, HULL_INC],
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM (fun ths => tactic_of do
        pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
          (← ExceptT.mk (basic_ss [])) 5 ths))))
       [← GSYM real_div, REAL_LE_LDIV_EQ, NORM_POS_LT, HULL_INC, REAL_MUL_LID] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"x:real^N", ← q r"norm(surf(proj x:real^N):real^N) / norm(x:real^N)"]) THEN
      ASM_SIMP_TAC [REAL_LE_DIV, NORM_POS_LE, REAL_LT_LDIV_EQ, NORM_POS_LT] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [REAL_NOT_LT, REAL_MUL_LID] THEN DISCH_THEN MATCH_MP_TAC THEN
      SUBGOAL_THEN
       (← q r"norm(surf(proj x)) / norm x % x:real^N = surf(proj x:real^N)")
      SUBST1_TAC THENL
       [FIRST_X_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC id [← GSYM th])) THEN
        ASM (fun ths => tactic_of do
          pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
            (← ExceptT.mk (basic_ss [])) 5 ths))))
         [NORM_POS_LT, REAL_LT_INV_EQ, HULL_INC, REAL_LT_MUL, NORM_MUL,
          REAL_ABS_INV, REAL_ABS_NORM, REAL_ABS_DIV, REAL_LT_DIV,
          REAL_DIV_RMUL, NORM_EQ_0],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE f s SUBSET t DIFF u ==> x IN s ==> ~(f x IN u)"))) THEN
        ASM_SIMP_TAC [HULL_INC]],
      GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_LID] THEN
      MATCH_MP_TAC IN_AFFINE_ADD_MUL THEN
      ASM_SIMP_TAC [AFFINE_AFFINE_HULL, VECTOR_ADD_LID, HULL_INC]])

  return { COMPACT_FRONTIER_LINE_LEMMA, STARLIKE_COMPACT_PROJECTIVE }

/- ------------------------------------------------------------------------- -/
/- Homeomorphism of all convex compact sets with same affine dimension, and  -/
/- in particular all those with nonempty interior (part 2).                  -/
/- (convex.ml 15345-15439)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HMB where
  HOMEOMORPHIC_CONVEX_COMPACT_SETS : thm
  HOMEOMORPHIC_RELATIVE_INTERIORS_CONVEX_COMPACT_SETS : thm
  HOMEOMORPHIC_RELATIVE_FRONTIERS_CONVEX_BOUNDED_SETS : thm
  HOMEOMORPHIC_CONVEX_COMPACT : thm
  HOMEOMORPHIC_CONVEX_COMPACT_CBALL : thm
  HOMEOMORPHIC_CLOSED_INTERVALS : thm
  deriving Inhabited

@[nospecialize]
def setupHMB [HolBase] (D : ConvexDeps) (BCVB : CVB) (BCLH : CLH) (BADA : ADA) (BADB : ADB)
    (BADC : ADC) (BADD : ADD) (BMCG : MCG) (BLIN : LIN) (BRIA : RIA) (BRIB : RIB) (BRIC : RIC)
    (BIRB : IRB) (BHMA : HMA) : ExceptT String IO HMB := do
  -- @@SCOPE BEGIN
  let { SET_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { EMPTY_DIFF, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, INT_OF_NUM_EQ, .. } := D.core2
  let { IN_INTER, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core3
  let { REAL_NOT_LE, SUBSET, .. } := D.core5
  let { HULL_INC, .. } := D.misc
  let { DIM_SPAN, .. } := D.vec1
  let { ISOMETRIES_SUBSPACES, .. } := D.vec2
  let { SUBSPACE_SPAN, .. } := D.vec3
  let { BALL_EQ_EMPTY, .. } := D.top1
  let { CLOSURE_SUBSET, COMPACT_CBALL, COMPACT_CLOSURE, COMPACT_INTERVAL, .. } := D.top2
  let { HOMEOMORPHIC_EMPTY, .. } := D.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM, INTERIOR_CBALL,
        INTERIOR_CLOSED_INTERVAL, IN_BALL_0, IN_CBALL_0, IN_SPHERE_0,
        LINEAR_CONTINUOUS_ON, .. } := D.top4
  let { homeomorphic, .. } := D.top5
  let { CONVEX_CBALL, .. } := BCVB
  let { AFFINE_HULL_EQ_SPAN, .. } := BCLH
  let { AFF_DIM_EMPTY, .. } := BADA
  let { AFF_DIM_DIM_0, .. } := BADB
  let { AFF_DIM_CLOSURE, AFF_DIM_EQ_MINUS1, .. } := BADC
  let { AFF_DIM_NONEMPTY_INTERIOR, .. } := BADD
  let { CONVEX_CLOSURE, .. } := BMCG
  let { CONVEX_INTERVAL, .. } := BLIN
  let { relative_frontier, RELATIVE_INTERIOR_EMPTY, RELATIVE_INTERIOR_SUBSET, .. } := BRIA
  let { RELATIVE_INTERIOR_EQ_EMPTY, .. } := BRIB
  let { IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, .. } := BRIC
  let { CONVEX_RELATIVE_INTERIOR_CLOSURE, .. } := BIRB
  let { STARLIKE_COMPACT_PROJECTIVE, .. } := BHMA
  -- @@SCOPE END

  let [HOMEOMORPHIC_CONVEX_COMPACT_SETS,
       HOMEOMORPHIC_RELATIVE_INTERIORS_CONVEX_COMPACT_SETS,
       HOMEOMORPHIC_RELATIVE_FRONTIERS_CONVEX_BOUNDED_SETS] := CONJUNCTS (← do
      let lemma ← prove
       r"!s:real^M->bool t:real^N->bool.
              convex s /\ compact s /\ convex t /\ compact t /\
              aff_dim s = aff_dim t
              ==> (s DIFF relative_interior s) homeomorphic
                  (t DIFF relative_interior t) /\
                  s homeomorphic t /\
                  relative_interior s homeomorphic relative_interior t"
       (REPEAT GEN_TAC THEN
        REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        ASM_CASES_TAC (← q r"relative_interior t:real^N->bool = {}") THENL
         [UNDISCH_TAC (← q r"relative_interior t:real^N->bool = {}") THEN
          ASM_SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, RELATIVE_INTERIOR_EMPTY,
                        EMPTY_DIFF, HOMEOMORPHIC_EMPTY, RELATIVE_INTERIOR_EQ_EMPTY],
           FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"b:real^N") MP_TAC o
              GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY])] THEN
        CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN
        ASM_CASES_TAC (← q r"relative_interior s:real^M->bool = {}") THENL
         [UNDISCH_TAC (← q r"relative_interior s:real^M->bool = {}") THEN
          ASM_SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, RELATIVE_INTERIOR_EMPTY,
                        EMPTY_DIFF, HOMEOMORPHIC_EMPTY, RELATIVE_INTERIOR_EQ_EMPTY],
          FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"a:real^M") MP_TAC o
              GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY])] THEN
        REPEAT (POP_ASSUM MP_TAC) THEN
        GEOM_ORIGIN_TAC (← q r"b:real^N") THEN REPEAT GEN_TAC THEN
        GEOM_ORIGIN_TAC (← q r"a:real^M") THEN REPEAT GEN_TAC THEN
        REPEAT DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"vec 0:real^M"]
              STARLIKE_COMPACT_PROJECTIVE) THEN
        MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"vec 0:real^N"]
              STARLIKE_COMPACT_PROJECTIVE) THEN
        ASM_SIMP_TAC [IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT,
                      ← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN
        MATCH_MP_TAC (← TAUT
         (← q r"(p ==> q ==> r) /\ (p' ==> q' ==> r') /\ (p'' ==> q'' ==> r'')
          ==> p /\ p' /\ p'' ==> q /\ q' /\ q'' ==> r /\ r' /\ r''")) THEN
        REPEAT CONJ_TAC THEN
        DISCH_THEN (fun th => tactic_of do
         pure (MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] HOMEOMORPHIC_TRANS) THEN
               MP_TAC (← ONCE_REWRITE_RULE [HOMEOMORPHIC_SYM] th))) THEN
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] HOMEOMORPHIC_TRANS) THEN
        REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
              RELATIVE_INTERIOR_SUBSET))) THEN
        FIRST_X_ASSUM (MP_TAC o SYM) THEN
        ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC, AFF_DIM_DIM_0] THEN
        REWRITE_TAC [INT_OF_NUM_EQ] THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"span s:real^M->bool", ← q r"span t:real^N->bool"]
                ISOMETRIES_SUBSPACES) THEN
        ASM_REWRITE_TAC [SUBSPACE_SPAN, DIM_SPAN, homeomorphic, HOMEOMORPHISM] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^M->real^N") THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
        SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTER,
                  IN_BALL_0, IN_CBALL_0, IN_SPHERE_0] THEN
        SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN ASM SET_TAC [])
      prove
       r"(!s:real^M->bool t:real^N->bool.
            convex s /\ compact s /\ convex t /\ compact t /\ aff_dim s = aff_dim t
            ==> s homeomorphic t) /\
       (!s:real^M->bool t:real^N->bool.
            convex s /\ compact s /\ convex t /\ compact t /\ aff_dim s = aff_dim t
            ==> relative_interior s homeomorphic relative_interior t) /\
       (!s:real^M->bool t:real^N->bool.
            convex s /\ bounded s /\ convex t /\ bounded t /\ aff_dim s = aff_dim t
            ==> relative_frontier s homeomorphic relative_frontier t)"
       (SIMP_TAC [lemma, relative_frontier] THEN REPEAT STRIP_TAC THEN
        MP_TAC (← SPECL [← q r"closure s:real^M->bool", ← q r"closure t:real^N->bool"]
          lemma) THEN
        ASM_SIMP_TAC [CONVEX_CLOSURE, COMPACT_CLOSURE, AFF_DIM_CLOSURE] THEN
        ASM_SIMP_TAC [CONVEX_RELATIVE_INTERIOR_CLOSURE]))
    | throw "HOMEOMORPHIC_CONVEX_COMPACT_SETS: CONJUNCTS"

  let HOMEOMORPHIC_CONVEX_COMPACT ← prove
   r"!s:real^N->bool t:real^N->bool.
        convex s /\ compact s /\ ~(interior s = {}) /\
        convex t /\ compact t /\ ~(interior t = {})
        ==> s homeomorphic t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_CONVEX_COMPACT_SETS THEN
    ASM_SIMP_TAC [AFF_DIM_NONEMPTY_INTERIOR])

  let HOMEOMORPHIC_CONVEX_COMPACT_CBALL ← prove
   r"!s:real^N->bool b:real^N e.
        convex s /\ compact s /\ ~(interior s = {}) /\ &0 < e
        ==> s homeomorphic cball(b,e)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_CONVEX_COMPACT THEN
    ASM_REWRITE_TAC [COMPACT_CBALL, INTERIOR_CBALL, CONVEX_CBALL] THEN
    ASM_REWRITE_TAC [BALL_EQ_EMPTY, REAL_NOT_LE])

  let HOMEOMORPHIC_CLOSED_INTERVALS ← prove
   r"!a b:real^N c d:real^N.
        ~(interval(a,b) = {}) /\ ~(interval(c,d) = {})
        ==> interval[a,b] homeomorphic interval[c,d]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_CONVEX_COMPACT THEN
    REWRITE_TAC [CONVEX_INTERVAL, COMPACT_INTERVAL] THEN
    ASM_REWRITE_TAC [INTERIOR_CLOSED_INTERVAL])

  return { HOMEOMORPHIC_CONVEX_COMPACT_SETS, HOMEOMORPHIC_RELATIVE_INTERIORS_CONVEX_COMPACT_SETS,
           HOMEOMORPHIC_RELATIVE_FRONTIERS_CONVEX_BOUNDED_SETS, HOMEOMORPHIC_CONVEX_COMPACT,
           HOMEOMORPHIC_CONVEX_COMPACT_CBALL, HOMEOMORPHIC_CLOSED_INTERVALS }

/- ------------------------------------------------------------------------- -/
/- Hence homeomorphism of convex open sets of same affine dimension.         -/
/- (convex.ml 15443-15537)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HMC where
  HOMEOMORPHIC_RELATIVELY_OPEN_CONVEX_SETS : thm
  HOMEOMORPHIC_CONVEX_OPEN_SETS : thm
  deriving Inhabited

@[nospecialize]
def setupHMC [HolBase] (D : ConvexDeps) (BCON : CON) (BCLH : CLH) (BAFI : AFI) (BADA : ADA)
    (BADC : ADC) (BADD : ADD) (BMCG : MCG) (BRIA : RIA) (BSHB : SHB) (BIRB : IRB)
    (BHMB : HMB) : ExceptT String IO HMC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { IMAGE_CLAUSES, IMP_CONJ, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, .. } := D.core3
  let { REAL_POS, SUBSET_ANTISYM, SUBSET_INTER, .. } := D.core5
  let { SUBSET_UNIV, .. } := D.core6
  let { HULL_INC, HULL_SUBSET, .. } := D.misc
  let { SPAN_MUL, .. } := D.vec3
  let { VECTOR_MUL_LID, .. } := D.vec4
  let { BOUNDED_BALL, BOUNDED_EMPTY, BOUNDED_SUBSET, .. } := D.top1
  let { COMPACT_CLOSURE, .. } := D.top2
  let { CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_REFL, .. } := D.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM_IMP_OPEN_MAP, OPEN_BALL, .. } :=
    D.top4
  let { OPEN_IN_OPEN, OPEN_IN_OPEN_EQ, OPEN_SUBSET, OPEN_UNIV, homeomorphic,
        homeomorphism, .. } := D.top5
  let { CONIC_HULL_EXPLICIT, .. } := BCON
  let { AFFINE_HULL_EQ_SPAN, .. } := BCLH
  let { SPAN_CONIC_HULL, .. } := BAFI
  let { AFF_DIM_AFFINE_HULL, .. } := BADA
  let { AFF_DIM_CLOSURE, .. } := BADC
  let { AFF_DIM_OPEN, .. } := BADD
  let { CONVEX_CLOSURE, .. } := BMCG
  let { RELATIVE_INTERIOR_OPEN_IN, .. } := BRIA
  let { CONVEXITY_PRESERVING_SHRINK_0, .. } := BSHB
  let { CONVEX_RELATIVE_INTERIOR_CLOSURE, .. } := BIRB
  let { HOMEOMORPHIC_RELATIVE_INTERIORS_CONVEX_COMPACT_SETS, .. } := BHMB
  -- @@SCOPE END

  let HOMEOMORPHIC_RELATIVELY_OPEN_CONVEX_SETS ← do
    let lemma ← prove
     r"!s:real^N->bool.
            convex s /\ open_in (subtopology euclidean (affine hull s)) s
            ==> ?t:real^N->bool.
                   convex t /\ bounded t /\ aff_dim t = aff_dim s /\
                   open_in (subtopology euclidean (affine hull t)) t /\
                   s homeomorphic t"
     (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
       [STRIP_TAC THEN EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [BOUNDED_EMPTY, HOMEOMORPHIC_REFL],
        POP_ASSUM MP_TAC THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"z:real^N") THEN GEOM_ORIGIN_TAC (← q r"z:real^N") THEN
        REPEAT STRIP_TAC] THEN
      X_CHOOSE_THEN (← q r"f:real^N->real^N") MP_TAC CONVEXITY_PRESERVING_SHRINK_0 THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"IMAGE (f:real^N->real^N) s") THEN ASM_SIMP_TAC [] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC BOUNDED_SUBSET THEN EXISTS_TAC (← q r"ball(vec 0:real^N,&1)") THEN
        REWRITE_TAC [BOUNDED_BALL] THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN SET_TAC [],
        ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
        ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC] THEN
        ONCE_REWRITE_TAC [← GSYM SPAN_CONIC_HULL] THEN ASM_REWRITE_TAC [],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
        REWRITE_TAC [OPEN_IN_OPEN] THEN
        EXISTS_TAC (← q r"IMAGE (f:real^N->real^N) u") THEN CONJ_TAC THENL
         [FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_IMP_OPEN_MAP)) THEN
          ASM_SIMP_TAC [OPEN_IN_OPEN_EQ, OPEN_UNIV, OPEN_BALL, SUBSET_UNIV],
          MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
           [REWRITE_TAC [SUBSET_INTER, HULL_SUBSET] THEN ASM SET_TAC [],
            ALL_TAC] THEN
          FIRST_X_ASSUM (MP_TAC o GSYM) THEN
          ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
          ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC] THEN
          ONCE_REWRITE_TAC [← GSYM SPAN_CONIC_HULL] THEN
          ASM_REWRITE_TAC [] THEN REWRITE_TAC [SPAN_CONIC_HULL] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"(!x y. f x = f y ==> x = y) /\
            (!x. f(x) IN v ==> x IN v)
             ==> v INTER u = s ==> v INTER IMAGE f u SUBSET IMAGE f s")) THEN
          CONJ_TAC THENL
           [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
            SET_TAC [],
            ALL_TAC] THEN
          X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
          SUBGOAL_THEN
            (← q r"conic hull (IMAGE (f:real^N->real^N) {x}) = conic hull {x}")
          MP_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
          REWRITE_TAC [CONIC_HULL_EXPLICIT, IMAGE_CLAUSES] THEN
          REWRITE_TAC [← SET_RULE (← q r"{f a x | P a /\ x IN {b}} = {f a b | P a}")] THEN
          DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
           (← q r"{c % f x | P c} = {c % x | P c}
            ==> P(&1) ==> ?c. &1 % x = c % f x"))) THEN
          REWRITE_TAC [REAL_POS, LEFT_IMP_EXISTS_THM, VECTOR_MUL_LID] THEN
          ASM_MESON_TAC [SPAN_MUL]],
        FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
        REWRITE_TAC [homeomorphism, homeomorphic] THEN
        MAP_EVERY EXISTS_TAC [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"] THEN
        REPEAT CONJ_TAC THEN
        TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET))) THEN ASM SET_TAC []])
    prove
     r"!s:real^M->bool t:real^N->bool.
          convex s /\ open_in (subtopology euclidean (affine hull s)) s /\
          convex t /\ open_in (subtopology euclidean (affine hull t)) t /\
          aff_dim s = aff_dim t
          ==> s homeomorphic t"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"s:real^M->bool") lemma) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"s':real^M->bool") THEN STRIP_TAC THEN
      TRANS_TAC HOMEOMORPHIC_TRANS (← q r"s':real^M->bool") THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPEC (← q r"t:real^N->bool") lemma) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"t':real^N->bool") THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
      TRANS_TAC HOMEOMORPHIC_TRANS (← q r"t':real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"closure t':real^N->bool", ← q r"closure s':real^M->bool"]
            HOMEOMORPHIC_RELATIVE_INTERIORS_CONVEX_COMPACT_SETS) THEN
      ASM_SIMP_TAC [CONVEX_CLOSURE, COMPACT_CLOSURE, AFF_DIM_CLOSURE] THEN
      ASM_SIMP_TAC [CONVEX_RELATIVE_INTERIOR_CLOSURE, RELATIVE_INTERIOR_OPEN_IN])

  let HOMEOMORPHIC_CONVEX_OPEN_SETS ← prove
   r"!s:real^N->bool t:real^N->bool.
        convex s /\ open s /\ convex t /\ open t /\ (s = {} <=> t = {})
        ==> s homeomorphic t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN ASM_SIMP_TAC [HOMEOMORPHIC_REFL] THEN
    STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_RELATIVELY_OPEN_CONVEX_SETS THEN
    ASM_SIMP_TAC [OPEN_SUBSET, HULL_SUBSET, AFF_DIM_OPEN])

  return { HOMEOMORPHIC_RELATIVELY_OPEN_CONVEX_SETS, HOMEOMORPHIC_CONVEX_OPEN_SETS }

/- ------------------------------------------------------------------------- -/
/- More refined Lipschitz homeomorphisms between relative frontiers (part 1). -/
/- (convex.ml 15541-15591)                                                   -/
/- ------------------------------------------------------------------------- -/

structure LPA where
  LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION_EXPLICIT : thm
  LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION : thm
  deriving Inhabited

@[nospecialize]
def setupLPA [HolBase] (D : ConvexDeps) (BCLH : CLH) (BRIA : RIA) (BRIB : RIB) :
    ExceptT String IO LPA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, .. } := D
  let { IMP_CONJ_ALT, INTER_COMM, IN_DIFF, .. } := D.core2
  let { REAL_ABS_INV, .. } := D.core3
  let { REAL_LE_INV2, REAL_LE_LMUL, REAL_LE_MIN, REAL_LE_RDIV_EQ, REAL_LE_TRANS,
        REAL_LT_MIN, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_SYM, REAL_NOT_LT, .. } := D.core5
  let { real_div, real_ge, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { DIST_DESCALE, DIST_POS_LE, .. } := D.vec1
  let { NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, .. } := D.vec4
  let { CENTRE_IN_BALL, .. } := D.top1
  let { IN_BALL_0, OPEN_BALL, .. } := D.top4
  let { OPEN_IN_OPEN_INTER, .. } := D.top5
  let { AFFINE_HULL_CLOSURE, .. } := BCLH
  let { relative_frontier, IN_RELATIVE_INTERIOR, .. } := BRIA
  let { OPEN_IN_SUBSET_RELATIVE_INTERIOR, .. } := BRIB
  -- @@SCOPE END

  let LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION_EXPLICIT ← prove
   r"!r s x y:real^N.
      convex s /\ &0 < r /\ vec 0 IN s /\
      ball(vec 0,r) INTER affine hull s SUBSET relative_interior s /\
      x IN relative_frontier s /\ y IN relative_frontier s
      ==> dist(inv(norm x) % x,inv(norm y) % y) <= inv r * dist(x,y)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"norm(x:real^N)", ← q r"norm(y:real^N)", ← q r"inv(norm x) % x:real^N",
      ← q r"inv(norm y) % y:real^N"] DIST_DESCALE) THEN
    SUBGOAL_THEN (← q r"~(x:real^N = vec 0) /\ ~(y:real^N = vec 0)")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s INTER t SUBSET u
        ==> z IN s /\ z IN t /\ ~(x IN u) ==> ~(x = z)"))) THEN
      ASM_SIMP_TAC [HULL_INC, CENTRE_IN_BALL] THEN
      ASM_MESON_TAC [relative_frontier, IN_DIFF],
      ALL_TAC] THEN
    ASM_SIMP_TAC [NORM_POS_LE, NORM_MUL, VECTOR_MUL_ASSOC, REAL_MUL_LINV,
                  REAL_MUL_RINV, NORM_EQ_0, REAL_ABS_INV, REAL_ABS_NORM] THEN
    REWRITE_TAC [VECTOR_MUL_LID, real_ge] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_LT_MIN, NORM_POS_LT] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    REWRITE_TAC [real_div] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
    REWRITE_TAC [DIST_POS_LE] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
    ASM_REWRITE_TAC [REAL_LE_MIN] THEN CONJ_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s INTER t SUBSET u
        ==> (r <= norm(z:real^N) <=> ~(z IN s)) /\ z IN t /\ ~(z IN u)
            ==> r <= norm z"))) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [relative_frontier, IN_DIFF]) THEN
    ASM_REWRITE_TAC [IN_BALL_0, REAL_NOT_LT] THEN
    ASM_MESON_TAC [AFFINE_HULL_CLOSURE, HULL_INC])

  let LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION ← prove
   r"!s:real^N->bool.
     convex s /\ vec 0 IN relative_interior s
     ==> ?B. !x y. x IN relative_frontier s /\ y IN relative_frontier s
                   ==> dist(inv(norm x) % x,inv(norm y) % y) <= B * dist(x,y)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"inv r:real") THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION_EXPLICIT  THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
          OPEN_IN_SUBSET_RELATIVE_INTERIOR o snd) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
    SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL])

  return { LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION_EXPLICIT,
           LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION }

/- ------------------------------------------------------------------------- -/
/- More refined Lipschitz homeomorphisms between relative frontiers (part 2). -/
/- (convex.ml 15592-15930)                                                   -/
/- ------------------------------------------------------------------------- -/

structure LPB where
  INVERSE_LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION_EXPLICIT : thm
  deriving Inhabited

@[nospecialize]
def setupLPB [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFS : AFS) (BCOP : COP) (BCLH : CLH)
    (BADA : ADA) (BADB : ADB) (BADC : ADC) (BADD : ADD) (BADE : ADE) (BCLP : CLP) (BRIA : RIA)
    (BRIC : RIC) : ExceptT String IO LPB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, REAL_RING, SET_RULE, SET_TAC, VECTOR_ARITH, NORM_ARITH,
        invariant_under_linear, GEOM_DROP_DIMENSION_RULE, GEOM_ORIGIN_TAC, .. } := D
  let { CONJ_ACI, DE_MORGAN_THM, DIMINDEX_2, EMPTY_SUBSET, EQ_SYM_EQ, EXISTS_REFL, .. } :=
    D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INSERT_AC, INSERT_SUBSET, INT_LE_TRANS, INT_OF_NUM_LE,
        IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM,
        LT_IMP_LE, MEMBER_NOT_EMPTY, NOT_INSERT_EMPTY, NOT_IN_EMPTY, NOT_LE, REAL_ABS_INV,
        REAL_ADD_LDISTRIB, .. } := D.core3
  let { REAL_EQ_IMP_LE, REAL_EQ_SQUARE_ABS, REAL_INV_0, REAL_INV_MUL, REAL_INV_POW,
        REAL_LE_ADD2, REAL_LE_ADDR, REAL_LE_DIV, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ,
        REAL_LE_LMUL, REAL_LE_MIN, REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_POW_2, REAL_LE_REFL,
        REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_LE, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RNEG, REAL_MUL_RZERO,
        REAL_NEG_GE0, REAL_NOT_LE, REAL_NOT_LT, REAL_POW_2, REAL_POW_MUL, SUBSET, .. } := D.core5
  let { SWAP_EXISTS_THM, real_div, real_ge, .. } := D.core6
  let { ALL, HULL_INC, HULL_MINIMAL, PAIRWISE, .. } := D.misc
  let { BETWEEN_REFL, BETWEEN_SYM, COLLINEAR_3_2D, COLLINEAR_BETWEEN_CASES, DIM_SPAN, DIST_0,
        DIST_EQ_0, DIST_POS_LE, DIST_REFL, DIST_SYM, DOT_2, DOT_LMUL, DOT_POS_LE,
        DOT_RMUL, .. } := D.vec1
  let { DOT_SYM, ISOMETRY_UNIV_SUPERSET_SUBSPACE, NORM_ADD_PYTHAGOREAN, NORM_EQ_0,
        NORM_GE_SQUARE, .. } := D.vec2
  let { NORM_LE_SQUARE, NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_POW_2, ORTHOGONAL_CLAUSES,
        ORTHOGONAL_LNEG, ORTHOGONAL_MUL, ORTHOGONAL_RNEG, ORTHOGONAL_SYM,
        PRESERVES_NORM_INJECTIVE, REAL_ABS_NORM, SPAN_INC, SUBSPACE_SPAN, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_RZERO, VECTOR_NEG_SUB,
        VECTOR_SUB_COMPONENT, VECTOR_SUB_LDISTRIB, VECTOR_SUB_LZERO, VECTOR_SUB_RZERO,
        VEC_COMPONENT, dist, orthogonal, .. } := D.vec4
  let { BETWEEN_IN_SEGMENT, CBALL_EMPTY, CENTRE_IN_BALL, CLOSEST_POINT_EXISTS,
        CLOSURE_CBALL, .. } := D.top1
  let { IN_BALL_0, IN_CBALL_0, IN_SEGMENT, .. } := D.top4
  let { SUBSET_CLOSURE, open_segment, .. } := D.top5
  let { AFFINE_AFFINE_HULL, .. } := BAFF
  let { AFFINE_HULL_EQ_EMPTY, AFFINE_HULL_2, .. } := BAFS
  let { AFFINE_HULL_3_IMP_COLLINEAR, .. } := BCOP
  let { CLOSED_AFFINE_HULL, AFFINE_HULL_CLOSURE, .. } := BCLH
  let { AFF_DIM_AFFINE_HULL, .. } := BADA
  let { AFF_DIM_DIM_0, AFF_DIM_SUBSET, .. } := BADB
  let { AFF_DIM_POS_LE, .. } := BADC
  let { COLLINEAR_AFF_DIM, .. } := BADD
  let { AFF_DIM_UNION, .. } := BADE
  let { CLOSEST_POINT_AFFINE_ORTHOGONAL, .. } := BCLP
  let { relative_frontier, .. } := BRIA
  let { IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, .. } := BRIC
  -- @@SCOPE END

  let INVERSE_LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION_EXPLICIT ← do
    let lemma0 ← prove
     r"!x y:real^N. orthogonal x y ==> norm(x) <= norm(x + y)"
     (REPEAT GEN_TAC THEN
      DISCH_THEN (ASSUME_TAC o MATCH_MP NORM_ADD_PYTHAGOREAN) THEN
      REWRITE_TAC [NORM_LE_SQUARE] THEN
      ASM_REWRITE_TAC [NORM_POS_LE, ← GSYM NORM_POW_2] THEN
      REWRITE_TAC [REAL_LE_ADDR, REAL_LE_POW_2])
    let lemma1 ← prove
     r"!a b x y:real^N.
            &0 <= a /\ &0 <= b /\ x dot y <= &0
            ==> dist(a % x,b % y) >= min a b * dist(x,y)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [dist, NORM_GE_SQUARE] THEN
      DISJ2_TAC THEN REWRITE_TAC [REAL_POW_MUL, NORM_POW_2] THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"(x - y:real^N) dot (x - y) = x dot x + y dot y + &2 * --(x dot y)")] THEN
      REWRITE_TAC [DOT_RMUL] THEN REWRITE_TAC [DOT_LMUL, real_ge] THEN
      REWRITE_TAC [← GSYM REAL_MUL_RNEG, REAL_ADD_LDISTRIB, REAL_MUL_ASSOC] THEN
      REPEAT (MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC) THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [DOT_POS_LE] THEN
      ASM_REWRITE_TAC [REAL_NEG_GE0] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a * &2 <= (&2 * x) * y <=> a <= x * y")] THEN
      REWRITE_TAC [REAL_POW_2] THEN MATCH_MP_TAC REAL_LE_MUL2  THEN
      ASM_REAL_ARITH_TAC)
    let lemma2 ← prove
     r"!a b w x y:real^N.
            &0 <= a /\ &0 <= b /\ between w (x,y) /\ orthogonal w (x - y)
            ==> dist(a % x,b % y) >= min a b * dist(x,y)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"a:real", ← q r"b:real", ← q r"x - w:real^N",
                        ← q r"y - w:real^N"]
            lemma1) THEN
      ASM_REWRITE_TAC [real_ge] THEN ANTS_TAC THENL
       [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BETWEEN_IN_SEGMENT]) THEN
        SIMP_TAC [IN_SEGMENT, LEFT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [← VECTOR_ARITH
         (← q r"x - ((&1 - u) % x + u % y):real^N = u % (x - y) /\
          y - ((&1 - u) % x + u % y):real^N = (u - &1) % (x - y)")] THEN
        REWRITE_TAC [DOT_RMUL] THEN REWRITE_TAC [DOT_LMUL] THEN
        REPEAT STRIP_TAC THEN
        REWRITE_TAC [← REAL_ARITH (← q r"(u - &1) * x <= &0 <=> &0 <= (&1 - u) * x")] THEN
        REPEAT (MATCH_MP_TAC REAL_LE_MUL THEN CONJ_TAC) THEN
        REWRITE_TAC [DOT_POS_LE] THEN ASM_REAL_ARITH_TAC,
        REWRITE_TAC [← NORM_ARITH (← q r"dist(x - w:real^N,y - w) = dist(x,y)")] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        REWRITE_TAC [dist] THEN SUBST1_TAC (← VECTOR_ARITH
         (← q r"a % x - b % y:real^N =
          (a % (x - w) - b % (y - w)) + (a - b) % w")) THEN
        MATCH_MP_TAC lemma0 THEN
        REWRITE_TAC [ORTHOGONAL_MUL] THEN DISJ2_TAC THEN
        MATCH_MP_TAC (← liftExcept (last (CONJUNCTS ORTHOGONAL_CLAUSES))) THEN
        CONJ_TAC THEN REWRITE_TAC [ORTHOGONAL_MUL] THEN DISJ2_TAC THEN
        ONCE_REWRITE_TAC [ORTHOGONAL_SYM] THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BETWEEN_IN_SEGMENT]) THEN
        SIMP_TAC [IN_SEGMENT, LEFT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [← VECTOR_ARITH
         (← q r"x - ((&1 - u) % x + u % y):real^N = u % (x - y) /\
          y - ((&1 - u) % x + u % y):real^N = (u - &1) % (x - y)")] THEN
        GEN_TAC THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
        ASM_REWRITE_TAC [ORTHOGONAL_MUL]])
    let mainlemma_2d ← prove
     r"collinear {z:real^2,x,x'} /\ collinear {w,x,y} /\
       orthogonal (z - w) (x - y) /\
       orthogonal (y - x') (z - x') /\
       ~(x' = z) /\ ~(y = w)
       ==> dist(z,w) * dist(x,y) = dist(y,x') * dist(z,x)"
     (REPEAT GEN_TAC THEN REWRITE_TAC [PAIRWISE, ALL] THEN
      GEOM_ORIGIN_TAC (← q r"x:real^2") THEN REWRITE_TAC [← GSYM DIST_EQ_0] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 <= x /\ &0 <= y /\ abs x = abs y ==> x = y")) THEN
      SIMP_TAC [DIST_POS_LE, REAL_LE_MUL, REAL_EQ_SQUARE_ABS, REAL_POW_MUL] THEN
      POP_ASSUM MP_TAC THEN
      ONCE_REWRITE_TAC [← REAL_RING (← q r"x = &0 <=> x pow 2 = &0")] THEN
      REWRITE_TAC [COLLINEAR_3_2D, dist, orthogonal, NORM_POW_2] THEN
      REWRITE_TAC [DOT_2, VECTOR_SUB_COMPONENT, VEC_COMPONENT] THEN
      CONV_TAC (fun t => REAL_RING t))
    let mainlemma ← prove
     r"collinear {z:real^N,x,x'} /\ collinear {w,x,y} /\
       orthogonal (z - w) (x - y) /\
       orthogonal (y - x') (z - x') /\
       ~(x' = z) /\ ~(y = w)
       ==> dist(z,w) * dist(x,y) = dist(y,x') * dist(z,x)"
     (ASM_CASES_TAC (← q r"dimindex(:N) <= dimindex(:2)") THENL
       [MP_TAC (← DISCH_ALL (← GEOM_DROP_DIMENSION_RULE
         (← ASSUME (← q r"dimindex(:N) <= dimindex(:2)")) (← GEN_ALL mainlemma_2d))) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_ACCEPT_TAC,
        RULE_ASSUM_TAC (REWRITE_RULE [NOT_LE])] THEN
      GEOM_ORIGIN_TAC (← q r"z:real^N") THEN REPEAT GEN_TAC THEN
      DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"?f:real^2->real^N.
            linear f /\
            span {vec 0:real^N,x,y,w,x'} SUBSET IMAGE f (:real^2) /\
            (!x. norm(f x) = norm x)")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC ISOMETRY_UNIV_SUPERSET_SUBSPACE THEN
        ASM_SIMP_TAC [LT_IMP_LE, SUBSPACE_SPAN, DIM_SPAN, DIMINDEX_2] THEN
        SIMP_TAC [← GSYM INT_OF_NUM_LE, ← GSYM AFF_DIM_DIM_0,
                  HULL_INC, IN_INSERT] THEN
        TRANS_TAC INT_LE_TRANS
        (← q r"aff_dim(affine hull {vec 0:real^N,x,x'} UNION affine hull {w,x,y})") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC AFF_DIM_SUBSET THEN
          SIMP_TAC [INSERT_SUBSET, EMPTY_SUBSET, IN_UNION, HULL_INC, IN_INSERT],
          W (MP_TAC o PART_MATCH (lhand o rand) AFF_DIM_UNION o lhand o snd) THEN
          REWRITE_TAC [AFF_DIM_AFFINE_HULL, AFFINE_AFFINE_HULL] THEN
          MATCH_MP_TAC (← TAUT (← q r"p /\ (p /\ q ==> r) ==> (p ==> q) ==> r")) THEN
           CONJ_TAC THENL
          [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
            MESON_TAC [HULL_INC, IN_INSERT],
            DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)] THEN
          MATCH_MP_TAC (← INT_ARITH
          (← q r"x:int <= &1 /\ y <= &1 /\ &0 <= z ==> (x + y) - z <= &2")) THEN
          ASM_REWRITE_TAC [← GSYM COLLINEAR_AFF_DIM, AFF_DIM_POS_LE]],
        FIRST_X_ASSUM (MP_TAC o check (fun th => HolCore.Basics.is_conj (concl th)))] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"span s SUBSET t ==> s SUBSET span s ==> s SUBSET t"))) THEN
      REWRITE_TAC [SPAN_INC] THEN REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET] THEN
      REWRITE_TAC [IN_IMAGE, IN_UNIV] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"!x y. (f:real^2->real^N) x = f y ==> x = y")
      ASSUME_TAC THENL [ASM_MESON_TAC [PRESERVES_NORM_INJECTIVE], ALL_TAC] THEN
      MP_TAC (← HolLight.end_itlist CONJ
       (← HolMath.IndTypes.mapfilterM (ISPEC (← q r"f:real^2->real^N"))
            (← invariant_under_linear.get))) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      SUBST1_TAC (← SET_RULE (← q r"{} = IMAGE (f:real^2->real^N) {}")) THEN
