/- ------------------------------------------------------------------------- -/
/- More refined Lipschitz homeomorphisms between relative frontiers (part 3). -/
/- (convex.ml 15931-16031)                                                   -/
/- ------------------------------------------------------------------------- -/

structure LPC where
  INVERSE_LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION : thm
  BILIPSCHITZ_HOMEOMORPHISM_SPHERICAL_PROJECTION : thm
  deriving Inhabited

@[nospecialize]
def setupLPC [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCLH : CLH) (BRIA : RIA) (BRIB : RIB)
    (BRIE : RIE) (BIRB : IRB) (BLPA : LPA) (BLPB : LPB) : ExceptT String IO LPC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, NORM_ARITH, .. } := D
  let { FORALL_IN_IMAGE, IMP_CONJ, INTER_COMM, IN_DIFF, .. } := D.core2
  let { IN_IMAGE, IN_INTER, LEFT_AND_EXISTS_THM, MONO_EXISTS, REAL_ABS_INV, .. } := D.core3
  let { REAL_LE_RDIV_EQ, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, .. } :=
    D.core4
  let { REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_SYM, REAL_POW_LT,
        RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core5
  let { SWAP_EXISTS_THM, o_DEF, real_abs, real_div, real_ge, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { LIPSCHITZ_ON_POS, NORM_0, NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_SUB_REFL, dist, .. } := D.vec4
  let { BOUNDED_POS, .. } := D.top1
  let { CONTINUOUS_ON_ID, CONTINUOUS_ON_INV, CONTINUOUS_ON_LIFT_NORM_COMPOSE,
        CONTINUOUS_ON_MUL, .. } := D.top3
  let { HOMEOMORPHISM_COMPACT, IN_CBALL_0, IN_SPHERE_0, OPEN_BALL, .. } := D.top4
  let { OPEN_IN_OPEN_INTER, homeomorphism, .. } := D.top5
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL, .. } := BAFF
  let { AFFINE_HULL_CLOSURE, .. } := BCLH
  let { relative_frontier, IN_RELATIVE_INTERIOR, .. } := BRIA
  let { OPEN_IN_SUBSET_RELATIVE_INTERIOR, .. } := BRIB
  let { RAY_TO_RELATIVE_FRONTIER, .. } := BRIE
  let { COMPACT_RELATIVE_FRONTIER_BOUNDED, .. } := BIRB
  let { LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION, .. } := BLPA
  let { INVERSE_LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION_EXPLICIT, .. } := BLPB
  -- @@SCOPE END

  let INVERSE_LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION ← prove
   r"!s:real^N->bool.
      convex s /\ bounded s /\ vec 0 IN relative_interior s
      ==>  ?B. &0 < B /\
               !x y. x IN relative_frontier s /\ y IN relative_frontier s
                     ==> dist(inv(norm x) % x,inv(norm y) % y) >= B * dist(x,y)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BOUNDED_POS]) THEN
    REWRITE_TAC [← GSYM IN_CBALL_0, ← GSYM SUBSET] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"R:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_RELATIVE_INTERIOR]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(r:real) / R pow 2") THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_POW_LT] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INVERSE_LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION_EXPLICIT THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
          OPEN_IN_SUBSET_RELATIVE_INTERIOR o snd) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
    SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL])

  let BILIPSCHITZ_HOMEOMORPHISM_SPHERICAL_PROJECTION ← prove
   r"!s:real^N->bool.
          convex s /\ bounded s /\ vec 0 IN relative_interior s
          ==> ?g. homeomorphism
                    (relative_frontier s,sphere(vec 0,&1) INTER affine hull s)
                    ((\x. inv(norm x) % x),g) /\
                  (?B. !x y. x IN relative_frontier s /\ y IN relative_frontier s
                             ==> norm(inv(norm x) % x - inv(norm y) % y)
                                 <= B * norm(x - y)) /\
                  (?B. !x y. x IN sphere(vec 0,&1) INTER affine hull s /\
                             y IN sphere(vec 0,&1) INTER affine hull s
                             ==> norm(g x - g y) <= B * norm(x - y))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION) THEN
    ASM_REWRITE_TAC [dist, LIPSCHITZ_ON_POS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool")
      INVERSE_LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION) THEN
    ASM_REWRITE_TAC [real_ge, dist] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") STRIP_ASSUME_TAC) THEN
    ONCE_REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN EXISTS_TAC (← q r"B:real") THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL
     [← q r"relative_frontier s:real^N->bool",
      ← q r"\x:real^N. inv(norm x) % x",
      ← q r"sphere(vec 0:real^N,&1) INTER affine hull s"]
     HOMEOMORPHISM_COMPACT) THEN
    ASM_SIMP_TAC [COMPACT_RELATIVE_FRONTIER_BOUNDED] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
        REWRITE_TAC [o_DEF, CONTINUOUS_ON_ID] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        SIMP_TAC [CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_ON_ID] THEN
        REWRITE_TAC [NORM_EQ_0, relative_frontier, IN_DIFF] THEN
        ASM_MESON_TAC [],
        REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, IN_INTER, IN_SPHERE_0] THEN
        CONJ_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THENL
         [CONJ_TAC THENL
           [REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
            MATCH_MP_TAC REAL_MUL_LINV THEN REWRITE_TAC [NORM_EQ_0] THEN
            ASM_MESON_TAC [relative_frontier, IN_DIFF],
            GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_LID] THEN
            MATCH_MP_TAC IN_AFFINE_ADD_MUL THEN
            REWRITE_TAC [AFFINE_AFFINE_HULL, VECTOR_ADD_LID] THEN
            ASM_MESON_TAC [AFFINE_HULL_CLOSURE, relative_frontier, IN_DIFF,
                           IN_RELATIVE_INTERIOR, HULL_INC]],
          REWRITE_TAC [IN_IMAGE] THEN
          MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"vec 0:real^N", ← q r"x:real^N"]
           RAY_TO_RELATIVE_FRONTIER) THEN
          ASM_REWRITE_TAC [VECTOR_ADD_LID] THEN ANTS_TAC THENL
           [ASM_MESON_TAC [← NORM_ARITH (← q r"~(norm(vec 0:real^N) = &1)")], ALL_TAC] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"a:real") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"a % x:real^N") THEN ASM_REWRITE_TAC [NORM_MUL] THEN
          ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE, REAL_MUL_RID, VECTOR_MUL_ASSOC,
                        REAL_MUL_LINV, REAL_LT_IMP_NZ, VECTOR_MUL_LID]],
        MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"])) THEN
        ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ] THEN
        REWRITE_TAC [real_div, REAL_MUL_LZERO] THEN
        SIMP_TAC [← NORM_ARITH (← q r"norm(x - y:real^N) <= &0 <=> x = y")]],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^N") THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"inv b:real") THEN
      ASM_REWRITE_TAC [REAL_LT_INV_EQ] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
      REWRITE_TAC [] THEN STRIP_TAC THEN
      SUBST1_TAC (← SYM (← ASSUME
       (← q r"IMAGE (\x:real^N. inv (norm x) % x) (relative_frontier s) =
        sphere (vec 0,&1) INTER affine hull s"))) THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM real_div, REAL_LE_RDIV_EQ] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ASM_SIMP_TAC []])

  return { INVERSE_LIPSCHITZ_CONVEX_SPHERICAL_PROJECTION,
           BILIPSCHITZ_HOMEOMORPHISM_SPHERICAL_PROJECTION }

/- ------------------------------------------------------------------------- -/
/- More refined Lipschitz homeomorphisms between relative frontiers (part 4). -/
/- (convex.ml 16032-16214)                                                   -/
/- ------------------------------------------------------------------------- -/

structure LPD where
  BILIPSCHITZ_HOMEOMORPHISM_RELATIVE_FRONTIERS : thm
  deriving Inhabited

@[nospecialize]
def setupLPD [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BCLH : CLH) (BADA : ADA)
    (BADB : ADB) (BADC : ADC) (BRIA : RIA) (BRIB : RIB) (BIRB : IRB) (BLPC : LPC) :
    ExceptT String IO LPD := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D
  let { ETA_AX, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, FUN_IN_IMAGE, IMAGE_ID, IMAGE_SUBSET, IMAGE_o,
        IMP_CONJ, IMP_IMP, INT_OF_NUM_EQ, IN_DIFF, .. } := D.core2
  let { IN_IMAGE, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core3
  let { SUBSET, SUBSET_REFL, .. } := D.core5
  let { UNWIND_THM2, o_DEF, o_THM, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { DIM_SPAN, .. } := D.vec1
  let { ISOMETRIES_SUBSPACES, LINEAR_0, LINEAR_SUB, LIPSCHITZ_ON_COMPOSE, .. } := D.vec2
  let { SPAN_SUB, SUBSPACE_SPAN, .. } := D.vec3
  let { BOUNDED_LINEAR_IMAGE, BOUNDED_TRANSLATION_EQ, CLOSURE_BOUNDED_LINEAR_IMAGE, .. } :=
    D.top1
  let { CLOSURE_INC, CLOSURE_SUBSET_SPAN, .. } := D.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        HOMEOMORPHIC_EMPTY, .. } := D.top3
  let { HOMEOMORPHISM, HOMEOMORPHISM_COMPOSE, HOMEOMORPHISM_SYM, LINEAR_CONTINUOUS_ON, .. } :=
    D.top4
  let { homeomorphic, homeomorphism, .. } := D.top5
  let { AFFINE_HULL_TRANSLATION, AFFINE_HULL_LINEAR_IMAGE, .. } := BAFF
  let { CONVEX_TRANSLATION_EQ, CONVEX_LINEAR_IMAGE, .. } := BCVX
  let { AFFINE_HULL_EQ_SPAN, .. } := BCLH
  let { AFF_DIM_EMPTY, AFF_DIM_TRANSLATION_EQ, .. } := BADA
  let { AFF_DIM_DIM_0, .. } := BADB
  let { AFF_DIM_EQ_MINUS1, .. } := BADC
  let { relative_frontier, RELATIVE_FRONTIER_EMPTY, RELATIVE_INTERIOR_SUBSET,
        IN_RELATIVE_INTERIOR, .. } := BRIA
  let { RELATIVE_INTERIOR_TRANSLATION, RELATIVE_FRONTIER_TRANSLATION,
        RELATIVE_INTERIOR_EQ_EMPTY, .. } := BRIB
  let { RELATIVE_INTERIOR_LINEAR_IMAGE_CONVEX, .. } := BIRB
  let { BILIPSCHITZ_HOMEOMORPHISM_SPHERICAL_PROJECTION, .. } := BLPC
  -- @@SCOPE END

  let BILIPSCHITZ_HOMEOMORPHISM_RELATIVE_FRONTIERS ← do
    let lemma1 ← prove
     r"!s:real^N->bool t:real^N->bool.
            convex s /\ bounded s /\ convex t /\ bounded t /\
            vec 0 IN relative_interior s /\
            vec 0 IN relative_interior t /\
            affine hull s = affine hull t
            ==> ?f g. homeomorphism
                        (relative_frontier s,relative_frontier t) (f,g) /\
                      (?B. !x y. x IN relative_frontier s /\
                                 y IN relative_frontier s
                                 ==> norm(f x - f y) <= B * norm(x - y)) /\
                      (?B. !x y. x IN relative_frontier t /\
                                 y IN relative_frontier t
                                 ==> norm(g x - g y) <= B * norm(x - y))"
     (REPEAT STRIP_TAC THEN
      MAP_EVERY (MP_TAC o C SPEC BILIPSCHITZ_HOMEOMORPHISM_SPHERICAL_PROJECTION)
       [← q r"t:real^N->bool", ← q r"s:real^N->bool"] THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
      REWRITE_TAC [IMP_IMP] THEN
      ABBREV_TAC (← q r"n (x:real^N) = inv(norm x) % x") THEN
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"vec 0:real^N")) THEN
      REWRITE_TAC [ETA_AX] THEN
      MAP_EVERY (fun t => X_GEN_TAC t THEN STRIP_TAC)
       [← q r"f:real^N->real^N", ← q r"B:real", ← q r"C:real",
        ← q r"f':real^N->real^N", ← q r"B':real", ← q r"C':real"] THEN
      MAP_EVERY EXISTS_TAC
       [← q r"(f':real^N->real^N) o (n:real^N->real^N)",
        ← q r"(f:real^N->real^N) o (n:real^N->real^N)"] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN
        EXISTS_TAC (← q r"sphere(vec 0:real^N,&1) INTER affine hull t") THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [HOMEOMORPHISM_SYM] THEN
        ASM_REWRITE_TAC [],
        CONJ_TAC THEN
        REWRITE_TAC [o_DEF] THEN MATCH_MP_TAC LIPSCHITZ_ON_COMPOSE THEN
        EXISTS_TAC (← q r"sphere(vec 0:real^N,&1) INTER affine hull t") THEN
        RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
        ASM_REWRITE_TAC [SUBSET_REFL] THEN ASM_MESON_TAC []])
    let lemma2 ← prove
     r"!s:real^M->bool t:real^N->bool.
            convex s /\ bounded s /\ convex t /\ bounded t /\
            vec 0 IN relative_interior s /\
            vec 0 IN relative_interior t /\
            dim s = dim t
            ==> ?f g. homeomorphism
                        (relative_frontier s,relative_frontier t) (f,g) /\
                      (?B. !x y. x IN relative_frontier s /\
                                 y IN relative_frontier s
                                 ==> norm(f x - f y) <= B * norm(x - y)) /\
                      (?B. !x y. x IN relative_frontier t /\
                                 y IN relative_frontier t
                                 ==> norm(g x - g y) <= B * norm(x - y))"
     (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
       [← q r"span s:real^M->bool", ← q r"span t:real^N->bool"] ISOMETRIES_SUBSPACES) THEN
      ASM_REWRITE_TAC [DIM_SPAN, SUBSPACE_SPAN, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"h:real^M->real^N", ← q r"k:real^N->real^M"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"IMAGE (h:real^M->real^N) s", ← q r"t:real^N->bool"]
            lemma1) THEN
      ASM_SIMP_TAC [CONVEX_LINEAR_IMAGE, BOUNDED_LINEAR_IMAGE,
                    RELATIVE_INTERIOR_LINEAR_IMAGE_CONVEX,
                    AFFINE_HULL_LINEAR_IMAGE] THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL [ASM_MESON_TAC [LINEAR_0, FUN_IN_IMAGE], ALL_TAC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_RELATIVE_INTERIOR]) THEN
        ASM_SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"] THEN
      SUBGOAL_THEN
       (← q r"relative_frontier (IMAGE h s) =
        IMAGE (h:real^M->real^N) (relative_frontier s)")
      SUBST1_TAC THENL
       [REWRITE_TAC [relative_frontier] THEN
        ASM_SIMP_TAC [RELATIVE_INTERIOR_LINEAR_IMAGE_CONVEX] THEN
        ASM_SIMP_TAC [CLOSURE_BOUNDED_LINEAR_IMAGE] THEN
        MP_TAC (← ISPEC (← q r"s:real^M->bool") RELATIVE_INTERIOR_SUBSET) THEN
        MP_TAC (← ISPEC (← q r"s:real^M->bool") CLOSURE_INC) THEN
        MP_TAC (← ISPEC (← q r"s:real^M->bool") CLOSURE_SUBSET_SPAN) THEN ASM SET_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [FORALL_IN_IMAGE_2] THEN
      DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(f:real^N->real^N) o (h:real^M->real^N)") THEN
      EXISTS_TAC (← q r"(k:real^N->real^M) o (g:real^N->real^N)") THEN
      ASM_REWRITE_TAC [o_THM] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN
        EXISTS_TAC (← q r"IMAGE (h:real^M->real^N) (relative_frontier s)") THEN
        ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [HOMEOMORPHISM, LINEAR_CONTINUOUS_ON] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, ← GSYM IMAGE_o, o_DEF, SUBSET] THEN
        MP_TAC (← ISPEC (← q r"s:real^M->bool") CLOSURE_SUBSET_SPAN) THEN
        REWRITE_TAC [relative_frontier] THEN ASM SET_TAC [],
        SUBGOAL_THEN
         (← q r"!x y. x IN relative_frontier s /\ y IN relative_frontier s
                ==> norm((h:real^M->real^N) x - h y) = norm(x - y)")
         (fun th => ASM_MESON_TAC [LINEAR_SUB, th]) THEN
        ASM_SIMP_TAC [← GSYM LINEAR_SUB] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        MATCH_MP_TAC SPAN_SUB THEN
        RULE_ASSUM_TAC (REWRITE_RULE [relative_frontier, IN_DIFF]) THEN
        ASM_MESON_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET_SPAN],
        SUBGOAL_THEN
         (← q r"!x y. x IN relative_frontier t /\ y IN relative_frontier t
                ==> ((g:real^N->real^N) x - g y) IN span t")
          (fun th => ASM_MESON_TAC [LINEAR_SUB, th]) THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC SPAN_SUB THEN CONJ_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHISM]) THEN
        DISCH_THEN (fun th => tactic_of do
          pure (MP_TAC (← liftExcept (el 3 (CONJUNCTS th))))) THEN
        MATCH_MP_TAC (← SET_RULE
          (← q r"x IN s /\ t SUBSET u ==> IMAGE f s SUBSET t ==> f x IN u")) THEN
        ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
        MATCH_MP_TAC IMAGE_SUBSET THEN REWRITE_TAC [relative_frontier] THEN
        MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET u ==> s DIFF t SUBSET u")) THEN
        REWRITE_TAC [CLOSURE_SUBSET_SPAN]])
    prove
     r"!s:real^M->bool t:real^N->bool.
       convex s /\ bounded s /\ convex t /\ bounded t /\ aff_dim s = aff_dim t
       ==> ?f g. homeomorphism (relative_frontier s,relative_frontier t) (f,g) /\
                 (?B. !x y. x IN relative_frontier s /\
                            y IN relative_frontier s
                            ==> norm(f x - f y) <= B * norm(x - y)) /\
                 (?B. !x y. x IN relative_frontier t /\
                            y IN relative_frontier t
                            ==> norm(g x - g y) <= B * norm(x - y))"
     (REPEAT GEN_TAC THEN
      ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
       [ASM_SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, RELATIVE_FRONTIER_EMPTY,
                      NOT_IN_EMPTY, HOMEOMORPHIC_EMPTY, ← GSYM homeomorphic],
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"s:real^M->bool = {}") THENL
       [ASM_MESON_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1], STRIP_TAC] THEN
      SUBGOAL_THEN
       (← q r"~(relative_interior(s:real^M->bool) = {}) /\
        ~(relative_interior(t:real^N->bool) = {})")
      MP_TAC THENL [ASM_MESON_TAC [RELATIVE_INTERIOR_EQ_EMPTY], ALL_TAC] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (CONJUNCTS_THEN2
        (X_CHOOSE_TAC (← q r"a:real^M")) (X_CHOOSE_TAC (← q r"b:real^N"))) THEN
      MP_TAC (← ISPECL
       [← q r"IMAGE (\x:real^M. --a + x) s", ← q r"IMAGE (\x:real^N. --b + x) t"]
       lemma2) THEN
      ASM_REWRITE_TAC [CONVEX_TRANSLATION_EQ, BOUNDED_TRANSLATION_EQ,
                       RELATIVE_INTERIOR_TRANSLATION, AFFINE_HULL_TRANSLATION] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IN_IMAGE] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"vec 0:real^N = --a + x <=> x = a")] THEN
      ASM_REWRITE_TAC [UNWIND_THM2] THEN ANTS_TAC THENL
       [MATCH_MP_TAC (← MESON [INT_OF_NUM_EQ]
         (← q r"aff_dim s = aff_dim t /\ aff_dim s = &(dim s) /\ aff_dim t = &(dim t)
          ==> dim(s:real^M->bool) = dim(t:real^N->bool)")) THEN
        CONJ_TAC THENL [ASM_REWRITE_TAC [AFF_DIM_TRANSLATION_EQ], ALL_TAC] THEN
        CONJ_TAC THEN MATCH_MP_TAC AFF_DIM_DIM_0 THEN MATCH_MP_TAC HULL_INC THEN
        REWRITE_TAC [IN_IMAGE, ← VECTOR_ARITH (← q r"vec 0:real^N = --a + x <=> x = a")] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_RELATIVE_INTERIOR]) THEN
        ASM_REWRITE_TAC [UNWIND_THM2],
        ALL_TAC] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, RELATIVE_FRONTIER_TRANSLATION] THEN
      REWRITE_TAC [FORALL_IN_IMAGE_2] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) - (a + y):real^N = x - y")] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"\x. b + (f:real^M->real^N) (--a + x)") THEN
      EXISTS_TAC (← q r"\x. a + (g:real^N->real^M) (--b + x)") THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) - (a + y):real^N = x - y")] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
      REWRITE_TAC [HOMEOMORPHISM, FORALL_IN_IMAGE, ← GSYM IMAGE_o] THEN
      SIMP_TAC [← VECTOR_ARITH (← q r"--a + a + x:real^N = x"),
                ← VECTOR_ARITH (← q r"a + --a + x:real^N = x")] THEN
      REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN ASM_SIMP_TAC [CONTINUOUS_ON_CONST] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID],
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        ASM_REWRITE_TAC [IMAGE_o] THEN REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"a + --a + x:real^N = x"), IMAGE_ID, SUBSET_REFL],
        MATCH_MP_TAC CONTINUOUS_ON_ADD THEN ASM_SIMP_TAC [CONTINUOUS_ON_CONST] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID],
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        ASM_REWRITE_TAC [IMAGE_o] THEN REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"a + --a + x:real^N = x"), IMAGE_ID,
                     SUBSET_REFL]])

  return { BILIPSCHITZ_HOMEOMORPHISM_RELATIVE_FRONTIERS }

/- ------------------------------------------------------------------------- -/
/- More about affine dimension of special sets.                              -/
/- (convex.ml 16221-16305)                                                   -/
/- ------------------------------------------------------------------------- -/

structure ADS where
  AFF_DIM_NONEMPTY_INTERIOR_EQ : thm
  AFF_DIM_BALL : thm
  AFF_DIM_CBALL : thm
  AFF_DIM_INTERVAL : thm
  deriving Inhabited

@[nospecialize]
def setupADS [HolBase] (D : ConvexDeps) (BADA : ADA) (BADB : ADB) (BADD : ADD) (BHYP : HYP)
    (BIRA : IRA) : ExceptT String IO ADS := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, INT_ARITH_TAC, MESON, SET_RULE, SET_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { CONJ_ASSOC, FINITE_NUMSEG, FINITE_RESTRICT, FORALL_IN_GSPEC, .. } := D.core1
  let { HAS_SIZE, HAS_SIZE_IMAGE_INJ, IMP_CONJ, .. } := D.core2
  let { IN_NUMSEG, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_IMP_NZ, REAL_LT_LADD, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_RZERO, REAL_NOT_LE, REAL_NOT_LT,
        RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SUBSET, .. } := D.core5
  let { pairwise, .. } := D.core6
  let { HULL_INC, .. } := D.misc
  let { BASIS_COMPONENT, BASIS_EXPANSION, BASIS_INJ_EQ, BASIS_NONZERO, DIM_SPAN,
        DIM_UNIQUE, .. } := D.vec1
  let { ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY, IN_INTERVAL, .. } := D.vec2
  let { ORTHOGONAL_BASIS_BASIS, PAIRWISE_ORTHOGONAL_INDEPENDENT, SPAN_0, SPAN_MUL,
        SPAN_SUBSET_SUBSPACE, SPAN_SUPERSET, SPAN_VSUM, SUBSPACE_SPAN, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, VEC_COMPONENT, .. } := D.vec4
  let { BALL_EQ_EMPTY, CBALL_EQ_EMPTY, CBALL_SING, .. } := D.top1
  let { INTERIOR_CBALL, OPEN_BALL, .. } := D.top4
  let { OPEN_INTERVAL, .. } := D.top5
  let { AFF_DIM_EMPTY, .. } := BADA
  let { AFF_DIM_DIM_0, AFF_DIM_SING, AFF_DIM_SUBSET, .. } := BADB
  let { AFF_DIM_OPEN, AFF_DIM_NONEMPTY_INTERIOR, .. } := BADD
  let { AFF_DIM_HYPERPLANE, .. } := BHYP
  let { EMPTY_INTERIOR_SUBSET_HYPERPLANE, .. } := BIRA
  -- @@SCOPE END

  let AFF_DIM_NONEMPTY_INTERIOR_EQ ← prove
   r"!s:real^N->bool.
          convex s ==> (aff_dim s = &(dimindex (:N)) <=> ~(interior s = {}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [AFF_DIM_NONEMPTY_INTERIOR] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") EMPTY_INTERIOR_SUBSET_HYPERPLANE) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP AFF_DIM_SUBSET) THEN
    ASM_SIMP_TAC [AFF_DIM_HYPERPLANE] THEN INT_ARITH_TAC)

  let AFF_DIM_BALL ← prove
   r"!a:real^N r.
          aff_dim(ball(a,r)) = if &0 < r then &(dimindex(:N)) else --(&1)"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THENL
     [MATCH_MP_TAC AFF_DIM_OPEN THEN
      ASM_REWRITE_TAC [OPEN_BALL, BALL_EQ_EMPTY, REAL_NOT_LE],
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LT, ← GSYM BALL_EQ_EMPTY]) THEN
      ASM_REWRITE_TAC [AFF_DIM_EMPTY]])

  let AFF_DIM_CBALL ← prove
   r"!a:real^N r.
          aff_dim(cball(a,r)) =
              if &0 < r then &(dimindex(:N))
              else if r = &0 then &0 else --(&1)"
   (REPEAT GEN_TAC THEN REPEAT COND_CASES_TAC THENL
     [MATCH_MP_TAC AFF_DIM_NONEMPTY_INTERIOR THEN
      ASM_REWRITE_TAC [INTERIOR_CBALL, BALL_EQ_EMPTY] THEN ASM_REAL_ARITH_TAC,
      ASM_SIMP_TAC [CBALL_SING, AFF_DIM_SING],
      MATCH_MP_TAC (← MESON [AFF_DIM_EMPTY] (← q r"s = {} ==> aff_dim s = --(&1)")) THEN
      REWRITE_TAC [CBALL_EQ_EMPTY] THEN ASM_REAL_ARITH_TAC])

  let AFF_DIM_INTERVAL ← prove
   r"(!a b:real^N.
          aff_dim(interval[a,b]) =
                  if interval[a,b] = {} then --(&1)
                  else &(CARD {i | 1 <= i /\ i <= dimindex(:N) /\ a$i < b$i})) /\
     (!a b:real^N.
           aff_dim(interval(a,b)) =
                  if interval(a,b) = {} then --(&1)
                  else &(dimindex(:N)))"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_OPEN, OPEN_INTERVAL] THEN
    POP_ASSUM MP_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    REPEAT STRIP_TAC THEN
    REWRITE_TAC [VECTOR_ADD_COMPONENT, VEC_COMPONENT, REAL_LT_LADD] THEN
    ASM_SIMP_TAC [AFF_DIM_DIM_0, HULL_INC, ENDS_IN_INTERVAL] THEN AP_TERM_TAC THEN
    ONCE_REWRITE_TAC [← GSYM DIM_SPAN] THEN MATCH_MP_TAC DIM_UNIQUE THEN EXISTS_TAC
     (← q r"{basis i:real^N | 1 <= i /\ i <= dimindex(:N) /\ &0 < (b:real^N)$i}") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY, VEC_COMPONENT]) THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"basis i:real^N = inv(b$i) % (b:real^N)$i % basis i")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, REAL_LT_IMP_NZ] THEN
        REWRITE_TAC [VECTOR_MUL_LID],
        MATCH_MP_TAC SPAN_MUL THEN MATCH_MP_TAC SPAN_SUPERSET THEN
        SIMP_TAC [IN_INTERVAL, VECTOR_MUL_COMPONENT, BASIS_COMPONENT] THEN
        X_GEN_TAC (← q r"j:num") THEN REWRITE_TAC [VEC_COMPONENT] THEN
        COND_CASES_TAC THEN
        ASM_SIMP_TAC [REAL_MUL_RZERO, REAL_MUL_RID, REAL_LE_REFL]],
      MATCH_MP_TAC SPAN_SUBSET_SUBSPACE THEN
      REWRITE_TAC [SUBSPACE_SPAN, SUBSET, IN_INTERVAL, VEC_COMPONENT] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM BASIS_EXPANSION] THEN
      MATCH_MP_TAC SPAN_VSUM THEN REWRITE_TAC [FINITE_NUMSEG] THEN
      X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"&0 < (b:real^N)$i") THENL
       [MATCH_MP_TAC SPAN_MUL THEN MATCH_MP_TAC SPAN_SUPERSET THEN ASM SET_TAC [],
        SUBGOAL_THEN (← q r"(x:real^N)$i = &0")
          (fun th => REWRITE_TAC [th, VECTOR_MUL_LZERO, SPAN_0]) THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC],
      MATCH_MP_TAC PAIRWISE_ORTHOGONAL_INDEPENDENT THEN
      REWRITE_TAC [← SET_RULE (← q r"~(a IN {f x | P x}) <=> !x. P x ==> ~(f x = a)")] THEN
      SIMP_TAC [BASIS_NONZERO, pairwise, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      SIMP_TAC [FORALL_IN_GSPEC, BASIS_INJ_EQ, ORTHOGONAL_BASIS_BASIS],
      GEN_REWRITE_TAC LAND_CONV [SIMPLE_IMAGE_GEN] THEN
      MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN
      SIMP_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC, BASIS_INJ_EQ,
                HAS_SIZE] THEN
      SIMP_TAC [CONJ_ASSOC, ← GSYM IN_NUMSEG, FINITE_RESTRICT, FINITE_NUMSEG]])

  return { AFF_DIM_NONEMPTY_INTERIOR_EQ, AFF_DIM_BALL, AFF_DIM_CBALL, AFF_DIM_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- A complete graph of |R|-many vertices can be embedded in R^3 with the     -/
/- edges as straight-line segments that intersect only at common endpoints.  -/
/- Basically, you just scatter the points onto the twisted cubic.            -/
/- (convex.ml 16311-16432)                                                   -/
/- ------------------------------------------------------------------------- -/

structure GRE where
  GRAPH_EMBEDS_IN_R3 : thm
  deriving Inhabited

@[nospecialize]
def setupGRE [HolBase] (D : ConvexDeps) (BADB : ADB) (BADD : ADD) (BADE : ADE) (BSGB : SGB) :
    ExceptT String IO GRE := do
  -- @@SCOPE BEGIN
  let { ASM_INT_ARITH_TAC, ASM_MESON_TAC, INT_ARITH, MESON_TAC, METIS, REAL_ARITH_TAC,
        REAL_RING, SET_RULE, SET_TAC, NUMSEG_CONV, NUM_REDUCE_CONV, VECTOR_ARITH, .. } := D
  let { CARD_CLAUSES, CART_EQ, CONTRAPOS_THM, DIMINDEX_3, FINITE_EMPTY, FINITE_INSERT, .. } :=
    D.core1
  let { FUN_IN_IMAGE, IMAGE_CLAUSES, INJECTIVE_ALT, INJECTIVE_ON_ALT, INTER_ACI,
        INT_OF_NUM_EQ, .. } := D.core2
  let { IN_INSERT, IN_INTER, IN_UNIV, LAMBDA_ETA, NOT_IMP, NOT_IN_EMPTY, .. } := D.core3
  let { SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SUBSET, .. } := D.core5
  let { le_c, numseg, o_THM, .. } := D.core6
  let { ALL, PAIRWISE, .. } := D.misc
  let { BETWEEN_IMP_COLLINEAR, DIM_INSERT_0, .. } := D.vec1
  let { FORALL_3, INDEPENDENT_EQ_DIM_EQ_CARD, .. } := D.vec2
  let { VECTOR_3, .. } := D.vec3
  let { VECTOR_SUB_COMPONENT, VECTOR_SUB_REFL, independent, row, rows, .. } := D.vec4
  let { DET_3, DET_DEPENDENT_ROWS, .. } := D.det
  let { BETWEEN_IN_SEGMENT, .. } := D.top1
  let { SEGMENT_REFL, SEGMENT_SYM, .. } := D.top5
  let { AFF_DIM_DIM_AFFINE_DIFFS, AFF_DIM_SUBSET, .. } := BADB
  let { AFF_DIM_INSERT, COLLINEAR_AFF_DIM, COPLANAR_AFF_DIM, .. } := BADD
  let { COPLANAR_INTERSECTING_LINES, .. } := BADE
  let { INTER_SEGMENT, .. } := BSGB
  -- @@SCOPE END

  let GRAPH_EMBEDS_IN_R3 ← prove
   r"!s:A->bool.
          s <=_c (:real)
          ==> ?v:A->real^3.
                  (!a b. a IN s /\ b IN s ==> (v a = v b <=> a = b)) /\
                  (!a b c d. ~({v a,v b} = {v c,v d})
                             ==> segment[v a,v b] INTER segment[v c,v d]
                                 SUBSET {v a,v b} INTER {v c,v d})"
   (SUBGOAL_THEN
     (← q r"?v:real->real^3.
          (!a b. v a = v b <=> a = b) /\
          (!a b c d. ~({v a,v b} = {v c,v d})
                     ==> segment[v a,v b] INTER segment[v c,v d]
                         SUBSET {v a,v b} INTER {v c,v d})")
    STRIP_ASSUME_TAC THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"s:A->bool") THEN
      REWRITE_TAC [le_c, IN_UNIV, INJECTIVE_ON_ALT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:A->real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(v:real->real^3) o (f:A->real)") THEN
      ASM_REWRITE_TAC [o_THM]] THEN
    ABBREV_TAC (← q r"v:real->real^3 = \x. vector[x; x pow 2; x pow 3]") THEN
    EXISTS_TAC (← q r"v:real->real^3") THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REWRITE_TAC [← GSYM INJECTIVE_ALT] THEN EXPAND_TAC "v" THEN
      SIMP_TAC [CART_EQ, FORALL_3, DIMINDEX_3, VECTOR_3],
      DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a b c d. PAIRWISE (\x y. ~(x = y)) [a;b;c;d]
                ==> aff_dim (IMAGE (v:real->real^3) {a,b,c,d}) = &3")
     (LABEL_TAC "COPLANAR")
    THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"(v:real->real^3) a",
        ← q r"IMAGE (v:real->real^3) {a,b,c,d}"] AFF_DIM_DIM_AFFINE_DIFFS) THEN
      SIMP_TAC [FUN_IN_IMAGE, IN_INSERT] THEN DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [SIMPLE_IMAGE, IMAGE_CLAUSES, INT_OF_NUM_EQ] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, DIM_INSERT_0] THEN
      W (MP_TAC o PART_MATCH (lhand o rand o rand) INDEPENDENT_EQ_DIM_EQ_CARD o
        lhand o snd) THEN
      REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY] THEN
      SUBGOAL_THEN
       (← q r"~(det(vector[(v:real->real^3) b - (v:real->real^3) a;
                     (v:real->real^3) c - (v:real->real^3) a;
                     (v:real->real^3) d - (v:real->real^3) a]:real^3^3) = &0)")
      MP_TAC THENL
       [EXPAND_TAC "v" THEN
        REWRITE_TAC [DET_3, VECTOR_3, VECTOR_SUB_COMPONENT] THEN
        POP_ASSUM MP_TAC THEN REWRITE_TAC [PAIRWISE, ALL] THEN
        CONV_TAC (fun t => REAL_RING t),
        DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM]
            DET_DEPENDENT_ROWS))] THEN
      REWRITE_TAC [rows] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      REWRITE_TAC [← GSYM numseg, DIMINDEX_3, ← NUMSEG_CONV (← q r"1..3")] THEN
      SIMP_TAC [row, IMAGE_CLAUSES, DIMINDEX_3, LAMBDA_ETA, VECTOR_3] THEN
      DISCH_TAC THEN ASM_REWRITE_TAC [independent] THEN DISCH_THEN SUBST1_TAC THEN
      SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN
      REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"x - z:real^3 = y - z <=> x = y")] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [PAIRWISE, ALL]) THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC NUM_REDUCE_CONV,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a b c. collinear(IMAGE (v:real->real^3) {a,b,c})
              ==> ~PAIRWISE (\x y. ~(x = y)) [a;b;c]")
     (LABEL_TAC "COLLINEAR")
    THENL
     [MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"c:real"] THEN
      GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
      REMOVE_THEN "COPLANAR" (MP_TAC o SPECL
       [← q r"abs a + abs b + abs c + &1:real", ← q r"a:real", ← q r"b:real",
        ← q r"c:real"]) THEN
      REWRITE_TAC [NOT_IMP] THEN ONCE_REWRITE_TAC [PAIRWISE] THEN
      ASM_REWRITE_TAC [ALL] THEN CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
      ONCE_REWRITE_TAC [IMAGE_CLAUSES] THEN REWRITE_TAC [AFF_DIM_INSERT] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [COLLINEAR_AFF_DIM]) THEN ASM_INT_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC (← METIS []
     (← q r"(!a b c d. P a b c d ==> P c d a b /\ P b a c d /\ P a b d c) /\
      (!a b c d. ~(a = b) /\ ~(a = c) /\ ~(a = d) /\
                 ~(b = c) /\ ~(b = d) /\ ~(c = d)
                 ==> P a b c d) /\
      (!a b c. P a b c c) /\
      (!a b c. ~(a = b) ==> P a b b c)
      ==> !a b c d. P a b c d")) THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"{a,b} = {b,a}"), SEGMENT_SYM, INTER_ACI] THEN
      MESON_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"c:real", ← q r"d:real"] THEN
      STRIP_TAC THEN DISCH_TAC THEN
      REWRITE_TAC [SUBSET, IN_INTER] THEN X_GEN_TAC (← q r"z:real^3") THEN STRIP_TAC THEN
      REMOVE_THEN "COPLANAR" (MP_TAC o
        SPECL [← q r"a:real", ← q r"b:real", ← q r"c:real", ← q r"d:real"]) THEN
      ASM_REWRITE_TAC [PAIRWISE, ALL] THEN
      MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN
      MATCH_MP_TAC (← INT_ARITH (← q r"!y:int. x <= y /\ y <= &2 ==> ~(x = &3)")) THEN
      EXISTS_TAC (← q r"aff_dim(z INSERT IMAGE (v:real->real^3) {a,b,c,d})") THEN
      SIMP_TAC [AFF_DIM_SUBSET, ← SET_RULE (← q r"s SUBSET a INSERT s")] THEN
      REWRITE_TAC [IMAGE_CLAUSES, ← GSYM COPLANAR_AFF_DIM] THEN
      MATCH_MP_TAC COPLANAR_INTERSECTING_LINES THEN
      ASM_SIMP_TAC [BETWEEN_IMP_COLLINEAR, BETWEEN_IN_SEGMENT],
      REWRITE_TAC [← SET_RULE (← q r"{a,a} = {a}"), SEGMENT_REFL] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"c:real"] THEN
      DISCH_THEN (K ALL_TAC : thm → tactic) THEN REWRITE_TAC [← SET_RULE
       (← q r"s INTER {a} SUBSET t INTER {a} <=> a IN s ==> a IN t")] THEN
      ASM_CASES_TAC (← q r"b:real = a") THEN
      ASM_SIMP_TAC [SEGMENT_REFL, IN_INSERT, NOT_IN_EMPTY] THEN
      STRIP_TAC THEN REMOVE_THEN "COLLINEAR" (MP_TAC o SPECL
       [← q r"a:real", ← q r"c:real", ← q r"b:real"]) THEN
      ASM_SIMP_TAC [IMAGE_CLAUSES, BETWEEN_IMP_COLLINEAR, BETWEEN_IN_SEGMENT] THEN
      REWRITE_TAC [PAIRWISE, ALL] THEN ASM_MESON_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"c:real"] THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"collinear {(v:real->real^3) a,v b,v c}") THENL
       [ALL_TAC, ASM_SIMP_TAC [INTER_SEGMENT] THEN SET_TAC []] THEN
      ASM_CASES_TAC (← q r"c:real = a") THENL
       [ASM SET_TAC [], DISCH_THEN (K ALL_TAC : thm → tactic)] THEN
      REMOVE_THEN "COLLINEAR" (MP_TAC o SPECL
       [← q r"a:real", ← q r"b:real", ← q r"c:real"]) THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, PAIRWISE, ALL] THEN
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [SEGMENT_REFL] THEN SET_TAC []])

  return { GRAPH_EMBEDS_IN_R3 }

/- ------------------------------------------------------------------------- -/
/- Deducing convexity from midpoint convexity in common cases.               -/
/- (convex.ml 16436-16541)                                                   -/
/- ------------------------------------------------------------------------- -/

structure MDC where
  MIDPOINT_CONVEX_DYADIC_RATIONALS : thm
  CONTINUOUS_MIDPOINT_CONVEX : thm
  deriving Inhabited

@[nospecialize]
def setupMDC [HolBase] (D : ConvexDeps) (BCVX : CVX) (BCVF : CVF) (BLIN : LIN) (BIRC : IRC) :
    ExceptT String IO MDC := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV, .. } := D
  let { ADD_SYM, DIMINDEX_1, EXP, FORALL_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_UNWIND_THM2, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.core2
  let { IN_INTER, REAL_ADD_ASSOC, REAL_ADD_LDISTRIB, REAL_ADD_RDISTRIB, REAL_ADD_SYM, .. } :=
    D.core3
  let { REAL_INV_MUL, REAL_LE_LDIV_EQ, REAL_LE_MUL_EQ, REAL_LT_IMP_NZ, REAL_LT_INV_EQ,
        REAL_LT_POW2, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_RINV, REAL_MUL_SYM, REAL_OF_NUM_LE,
        REAL_OF_NUM_POW, REAL_OF_NUM_SUB, REAL_SUB_LE, REAL_SUB_RDISTRIB,
        RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.core5
  let { WLOG_LE, o_ASSOC, o_DEF, real_div, real_pow, .. } := D.core6
  let { INTEGER_POS, .. } := D.lib
  let { DROP_CMUL, DROP_VEC, FORALL_1, FORALL_DROP, LIFT_ADD, LIFT_CMUL, LIFT_DROP,
        LIFT_SUB, .. } := D.vec2
  let { VECTOR_ADD_ASSOC, VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB,
        VECTOR_ADD_RID, VECTOR_ADD_SYM, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        drop, midpoint, .. } := D.vec4
  let { CLOSED_INTERVAL, CLOSURE_CLOSED, .. } := D.top1
  let { CONTINUOUS_LE_ON_CLOSURE, CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE,
        CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, .. } := D.top3
  let { INTERIOR_CLOSED_INTERVAL, IN_INTERVAL_1, .. } := D.top4
  let { UNIT_INTERVAL_NONEMPTY, .. } := D.top5
  let { convex, .. } := BCVX
  let { convex_on, .. } := BCVF
  let { CONVEX_INTERVAL, .. } := BLIN
  let { CLOSURE_DYADIC_RATIONALS_IN_CONVEX_SET, .. } := BIRC
  -- @@SCOPE END

  let MIDPOINT_CONVEX_DYADIC_RATIONALS ← prove
   r"!f:real^N->real s.
          (!x y. x IN s /\ y IN s
                 ==> midpoint(x,y) IN s /\
                     f(midpoint(x,y)) <= (f(x) + f(y)) / &2)
          ==> !n m p x y.
                  x IN s /\ y IN s /\ m + p = 2 EXP n
                  ==> (&m / &2 pow n % x + &p / &2 pow n % y) IN s /\
                      f(&m / &2 pow n % x + &p / &2 pow n % y)
                      <= &m / &2 pow n * f x + &p / &2 pow n * f y"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN INDUCT_TAC THENL
     [REWRITE_TAC [← ARITH_RULE
       (← q r"m + p = 2 EXP 0 <=> m = 0 /\ p = 1 \/ m = 1 /\ p = 0")] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_REWRITE_TAC [VECTOR_MUL_LID, VECTOR_MUL_LZERO,
                       VECTOR_ADD_LID, VECTOR_ADD_RID] THEN
      REAL_ARITH_TAC,
      MATCH_MP_TAC WLOG_LE THEN CONJ_TAC THENL
       [REWRITE_TAC [VECTOR_ADD_SYM, REAL_ADD_SYM, ADD_SYM] THEN MESON_TAC [],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"p:num"] THEN DISCH_TAC THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [EXP, real_pow] THEN STRIP_TAC THEN
      REWRITE_TAC [real_div, REAL_INV_MUL] THEN
      ONCE_REWRITE_TAC [← REAL_ARITH (← q r"x * inv(&2) * y = inv(&2) * x * y")] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_MUL_ASSOC, ← GSYM VECTOR_MUL_ASSOC] THEN
      REWRITE_TAC [← GSYM REAL_ADD_LDISTRIB, ← GSYM VECTOR_ADD_LDISTRIB] THEN
      SUBGOAL_THEN (← q r"2 EXP n <= p") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN (← q r"&p * inv(&2 pow n) = &(p - 2 EXP n) * inv(&2 pow n) + &1")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [← GSYM REAL_OF_NUM_SUB, ← GSYM REAL_OF_NUM_POW] THEN
        ASM_SIMP_TAC [REAL_SUB_RDISTRIB, REAL_MUL_RINV, REAL_LT_IMP_NZ,
                      REAL_LT_POW2] THEN REAL_ARITH_TAC,
        REWRITE_TAC [VECTOR_ADD_RDISTRIB, REAL_ADD_RDISTRIB] THEN
        REWRITE_TAC [VECTOR_MUL_LID, REAL_MUL_LID] THEN
        REWRITE_TAC [VECTOR_ADD_ASSOC, REAL_ADD_ASSOC] THEN
        REWRITE_TAC [← GSYM midpoint, ← GSYM real_div] THEN FIRST_X_ASSUM (fun th =>
          W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o snd)) THEN
        FIRST_X_ASSUM (fun th =>
          W (MP_TAC o PART_MATCH (lhand o rand) th o funpowM 3 lhand o  snd)) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [ASM_ARITH_TAC, SIMP_TAC [] THEN REAL_ARITH_TAC]]])

  let CONTINUOUS_MIDPOINT_CONVEX ← prove
   r"!f:real^N->real s.
          (lift o f) continuous_on s /\ convex s /\
          (!x y. x IN s /\ y IN s ==> f(midpoint(x,y)) <= (f(x) + f(y)) / &2)
           ==> f convex_on s"
   (REWRITE_TAC [midpoint] THEN REPEAT STRIP_TAC THEN REWRITE_TAC [convex_on] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
    X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"u + v = &1 <=> v = &1 - u"), IMP_CONJ] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2, REAL_SUB_LE] THEN
    REWRITE_TAC [FORALL_DROP, ← GSYM DROP_VEC, IMP_IMP, ← GSYM IN_INTERVAL_1] THEN
    MP_TAC (← ISPEC (← q r"interval[vec 0:real^1,vec 1]")
          CLOSURE_DYADIC_RATIONALS_IN_CONVEX_SET) THEN
    SIMP_TAC [CONVEX_INTERVAL, INTERIOR_CLOSED_INTERVAL,
              CLOSURE_CLOSED, CLOSED_INTERVAL, UNIT_INTERVAL_NONEMPTY] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop] THEN
    DISCH_THEN (fun th => tactic_of do pure (SUBST1_TAC (← SYM th) THEN ASSUME_TAC th)) THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a <= b <=> a - b <= &0")] THEN
    MATCH_MP_TAC CONTINUOUS_LE_ON_CLOSURE THEN
    REWRITE_TAC [IN_INTER, IMP_CONJ_ALT, FORALL_IN_GSPEC] THEN
    FIRST_X_ASSUM SUBST1_TAC THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, ← GSYM FORALL_DROP, DROP_VEC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [o_DEF, LIFT_SUB, LIFT_ADD, LIFT_CMUL] THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUB THEN CONJ_TAC THENL
       [REPLICATE_TAC 2 (ONCE_REWRITE_TAC [← GSYM o_DEF]) THEN
        REWRITE_TAC [o_ASSOC] THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        CONJ_TAC THENL
         [ALL_TAC,
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, ← GSYM FORALL_DROP,
                       DROP_VEC] THEN REPEAT STRIP_TAC THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [convex]) THEN
          ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC],
        ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      SIMP_TAC [o_DEF, LIFT_DROP, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST,
                LIFT_SUB, CONTINUOUS_ON_SUB],
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"i:real"] THEN
      ASM_SIMP_TAC [REAL_LE_MUL_EQ, REAL_LT_INV_EQ, REAL_LT_POW2] THEN
      ASM_CASES_TAC (← q r"&0 <= i") THEN ASM_SIMP_TAC [INTEGER_POS] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") SUBST_ALL_TAC) THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
      SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_POW2, REAL_MUL_LID] THEN
      GEN_REWRITE_TAC (LAND_CONV o DEPTH_CONV)
       [REAL_OF_NUM_POW, REAL_OF_NUM_LE] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^N->real", ← q r"s:real^N->bool"]
          MIDPOINT_CONVEX_DYADIC_RATIONALS) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [midpoint] THEN REWRITE_TAC [VECTOR_ADD_LDISTRIB] THEN
        REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [convex]) THEN
        ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
        DISCH_THEN (MP_TAC o SPECL
         [← q r"n:num", ← q r"m:num", ← q r"2 EXP n - m", ← q r"x:real^N",
          ← q r"y:real^N"]) THEN
        ASM_REWRITE_TAC [] THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN (MP_TAC o CONJUNCT2)] THEN
        ASM_SIMP_TAC [← GSYM REAL_OF_NUM_SUB, ← GSYM REAL_OF_NUM_POW] THEN
        ASM_SIMP_TAC [REAL_LT_POW2, ← REAL_FIELD
         (← q r"&0 < y ==> (y - x) / y = &1 - x / y")] THEN
        REAL_ARITH_TAC]])

  return { MIDPOINT_CONVEX_DYADIC_RATIONALS, CONTINUOUS_MIDPOINT_CONVEX }

/- ------------------------------------------------------------------------- -/
/- Slightly shaper separating/supporting hyperplane results.                 -/
/- (convex.ml 16548-16668)                                                   -/
/- ------------------------------------------------------------------------- -/

structure SHP where
  SEPARATING_HYPERPLANE_RELATIVE_INTERIORS : thm
  SUPPORTING_HYPERPLANE_RELATIVE_BOUNDARY : thm
  SUPPORTING_HYPERPLANE_RELATIVE_FRONTIER : thm
  SUPPORTING_HYPERPLANE_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupSHP [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCVX : CVX) (BGNS : GNS) (BMCG : MCG)
    (BRIA : RIA) (BRIB : RIB) (BRIC : RIC) (BIRA : IRA) (BIRB : IRB) :
    ExceptT String IO SHP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, SET_RULE, SET_TAC,
        NORM_ARITH, .. } := D
  let { DIMINDEX_GE_1, .. } := D.core1
  let { FORALL_IN_INSERT, INSERT_SUBSET, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, NOT_IMP,
        NOT_IN_EMPTY, REAL_ABS_DIV, REAL_ABS_NEG, REAL_DIV_RMUL, .. } := D.core3
  let { REAL_LE_NEG2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_LE,
        REAL_LT_MUL, .. } := D.core4
  let { SUBSET, .. } := D.core5
  let { UNIV_NOT_EMPTY, o_THM, real_ge, .. } := D.core6
  let { HULL_INC, HULL_MONO, .. } := D.misc
  let { BASIS_NONZERO, DOT_LNEG, DOT_POS_LT, DOT_RADD, DOT_RMUL, DOT_RNEG, .. } := D.vec1
  let { LIFT_DROP, NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_ADD_SUB, VECTOR_NEG_EQ_0, drop, .. } := D.vec4
  let { CLOSURE_HYPERPLANE, CLOSURE_SUBSET, .. } := D.top2
  let { CONTINUOUS_GE_ON_CLOSURE, CONTINUOUS_LE_ON_CLOSURE,
        CONTINUOUS_ON_CLOSURE_COMPONENT_GE, CONTINUOUS_ON_LIFT_DOT, .. } := D.top3
  let { IN_CBALL, .. } := D.top4
  let { SUBSET_CLOSURE, frontier, .. } := D.top5
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL_DIFF, .. } := BAFF
  let { CONVEX_EMPTY, CONVEX_SING, .. } := BCVX
  let { SEPARATING_HYPERPLANE_SET_POINT_INAFF, SEPARATING_HYPERPLANE_SETS, .. } := BGNS
  let { CONVEX_CLOSURE, .. } := BMCG
  let { relative_frontier, RELATIVE_INTERIOR_EMPTY, RELATIVE_INTERIOR_SUBSET,
        IN_RELATIVE_INTERIOR_CBALL, .. } := BRIA
  let { RELATIVE_INTERIOR_EQ_EMPTY, RELATIVE_FRONTIER_NONEMPTY_INTERIOR, .. } := BRIB
  let { CONVEX_RELATIVE_INTERIOR, .. } := BRIC
  let { EMPTY_INTERIOR_SUBSET_HYPERPLANE, CONVEX_CLOSURE_RELATIVE_INTERIOR, .. } := BIRA
  let { CONVEX_RELATIVE_INTERIOR_CLOSURE, .. } := BIRB
  -- @@SCOPE END

  let SEPARATING_HYPERPLANE_RELATIVE_INTERIORS ← prove
   r"!s t. convex s /\ convex t /\
           ~(s = {} /\ t = (:real^N) \/ s = (:real^N) /\ t = {}) /\
           DISJOINT (relative_interior s) (relative_interior t)
           ==> ?a b. ~(a = vec 0) /\
                     (!x. x IN s ==> a dot x <= b) /\
                     (!x. x IN t ==> a dot x >= b)"
   (REPEAT GEN_TAC THEN MAP_EVERY ASM_CASES_TAC
     [← q r"s:real^N->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, UNIV_NOT_EMPTY, CONVEX_EMPTY,
                     RELATIVE_INTERIOR_EMPTY] THEN
    STRIP_TAC THENL
     [EXISTS_TAC (← q r"basis 1:real^N") THEN
      SIMP_TAC [BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL],
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"x:real^N") o MATCH_MP (← SET_RULE
       (← q r"~(s = UNIV) ==> ?a. ~(a IN s)"))) THEN
      MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"x:real^N"]
          SEPARATING_HYPERPLANE_SET_POINT_INAFF) THEN
      ASM_MESON_TAC [],
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"x:real^N") o MATCH_MP (← SET_RULE
       (← q r"~(s = UNIV) ==> ?a. ~(a IN s)"))) THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N"]
          SEPARATING_HYPERPLANE_SET_POINT_INAFF) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, real_ge] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real"] THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"--a:real^N", ← q r"--b:real"] THEN
      ASM_REWRITE_TAC [VECTOR_NEG_EQ_0, DOT_LNEG, REAL_LE_NEG2],
      MP_TAC (← ISPECL [← q r"relative_interior s:real^N->bool",
                        ← q r"relative_interior t:real^N->bool"]
            SEPARATING_HYPERPLANE_SETS) THEN
      ASM_SIMP_TAC [RELATIVE_INTERIOR_EQ_EMPTY, CONVEX_RELATIVE_INTERIOR] THEN
      SIMP_TAC [real_ge] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"a:real^N") THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"b:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THEN MATCH_MP_TAC
      (← MESON [CONVEX_CLOSURE_RELATIVE_INTERIOR, CLOSURE_SUBSET, SUBSET]
        (← q r"convex s /\ (!x. x IN closure(relative_interior s) ==> P x)
         ==> !x. x IN s ==> P x")) THEN
      ASM_REWRITE_TAC [] THENL
       [MATCH_MP_TAC CONTINUOUS_LE_ON_CLOSURE,
        MATCH_MP_TAC CONTINUOUS_GE_ON_CLOSURE] THEN
      ASM_REWRITE_TAC [CONTINUOUS_ON_LIFT_DOT]])

  let SUPPORTING_HYPERPLANE_RELATIVE_BOUNDARY ← prove
   r"!s x:real^N.
          convex s /\ x IN s /\ ~(x IN relative_interior s)
          ==> ?a. ~(a = vec 0) /\
                  (!y. y IN s ==> a dot x <= a dot y) /\
                  (!y. y IN relative_interior s ==> a dot x < a dot y)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"relative_interior s:real^N->bool", ← q r"x:real^N"]
          SEPARATING_HYPERPLANE_SET_POINT_INAFF) THEN
    ASM_SIMP_TAC [CONVEX_SING, CONVEX_RELATIVE_INTERIOR,
                  RELATIVE_INTERIOR_EQ_EMPTY, real_ge] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
    REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") STRIP_ASSUME_TAC) THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"lift o (\x:real^N. a dot x)",
                        ← q r"relative_interior s:real^N->bool",
                        ← q r"y:real^N", ← q r"(a:real^N) dot x", ← q r"1"]
        CONTINUOUS_ON_CLOSURE_COMPONENT_GE) THEN
      REWRITE_TAC [CONTINUOUS_ON_LIFT_DOT, ← GSYM drop, o_THM, LIFT_DROP] THEN
      ASM_SIMP_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR] THEN
      ASM_MESON_TAC [CLOSURE_SUBSET, REAL_LE_TRANS, SUBSET],
      DISCH_TAC] THEN
    X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
    REWRITE_TAC [REAL_LT_LE] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_LE_TRANS], ALL_TAC] THEN
    DISCH_TAC THEN UNDISCH_TAC (← q r"(y:real^N) IN relative_interior s") THEN
    REWRITE_TAC [IN_RELATIVE_INTERIOR_CBALL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, SUBSET, IN_INTER, IN_CBALL] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"y + --(e / norm(a)) % ((x + a) - x):real^N")) THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [SIMP_TAC [← NORM_ARITH (← q r"dist(y:real^N,y + e) = norm e"), VECTOR_ADD_SUB] THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_NEG, REAL_ABS_DIV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0] THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC IN_AFFINE_ADD_MUL_DIFF THEN
      ASM_SIMP_TAC [AFFINE_AFFINE_HULL, HULL_INC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
      MATCH_MP_TAC HULL_MONO THEN
      ASM_REWRITE_TAC [INSERT_SUBSET, RELATIVE_INTERIOR_SUBSET],
      REWRITE_TAC [VECTOR_ADD_SUB] THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"!y:real^N. y IN s ==> a dot x <= a dot y") THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"y + --(e / norm(a)) % a:real^N")) THEN
      ASM_REWRITE_TAC [DOT_RMUL, DOT_RNEG, DOT_RADD] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x * y ==> ~(a <= a + --x * y)")) THEN
      ASM_SIMP_TAC [REAL_LT_MUL, REAL_LT_DIV, NORM_POS_LT, DOT_POS_LT]])

  let SUPPORTING_HYPERPLANE_RELATIVE_FRONTIER ← prove
   r"!s x:real^N.
          convex s /\ x IN relative_frontier s
          ==> ?a. ~(a = vec 0) /\
                  (!y. y IN closure s ==> a dot x <= a dot y) /\
                  (!y. y IN relative_interior s ==> a dot x < a dot y)"
   (REWRITE_TAC [relative_frontier, IN_DIFF] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"closure s:real^N->bool", ← q r"x:real^N"]
      SUPPORTING_HYPERPLANE_RELATIVE_BOUNDARY) THEN
    ASM_SIMP_TAC [CONVEX_CLOSURE, CONVEX_RELATIVE_INTERIOR_CLOSURE])

  let SUPPORTING_HYPERPLANE_FRONTIER ← prove
   r"!s x:real^N.
          convex s /\ x IN frontier s
          ==> ?a. ~(a = vec 0) /\
                  !y. y IN closure s ==> a dot x <= a dot y"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"interior s:real^N->bool = {}") THENL
     [STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") EMPTY_INTERIOR_SUBSET_HYPERPLANE) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      GEN_TAC THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP SUBSET_CLOSURE) THEN
      ASM_REWRITE_TAC [SUBSET, CLOSURE_HYPERPLANE, IN_ELIM_THM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [frontier, IN_DIFF]) THEN
      ASM_SIMP_TAC [REAL_LE_REFL],
      ASM_SIMP_TAC [← GSYM RELATIVE_FRONTIER_NONEMPTY_INTERIOR] THEN
      DISCH_THEN (MP_TAC o MATCH_MP SUPPORTING_HYPERPLANE_RELATIVE_FRONTIER) THEN
      MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC []])

  return { SEPARATING_HYPERPLANE_RELATIVE_INTERIORS, SUPPORTING_HYPERPLANE_RELATIVE_BOUNDARY,
           SUPPORTING_HYPERPLANE_RELATIVE_FRONTIER, SUPPORTING_HYPERPLANE_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Containment of rays in unbounded convex sets.                             -/
/- (convex.ml 16675-16817)                                                   -/
/- ------------------------------------------------------------------------- -/

structure RAY where
  UNBOUNDED_CONVEX_CLOSED_CONTAINS_RAY : thm
  CONVEX_CLOSED_CONTAINS_SAME_RAY : thm
  UNBOUNDED_CONVEX_CLOSED_CONTAINS_RAYS : thm
  RELATIVE_INTERIOR_UNBOUNDED_CONVEX_CONTAINS_RAY : thm
  RELATIVE_INTERIOR_CONVEX_CONTAINS_SAME_RAY : thm
  RELATIVE_INTERIOR_UNBOUNDED_CONVEX_CONTAINS_RAYS : thm
  deriving Inhabited

@[nospecialize]
def setupRAY [HolBase] (D : ConvexDeps) (BCVX : CVX) (BMCG : MCG) (BRIA : RIA) (BRIB : RIB)
    (BRIC : RIC) : ExceptT String IO RAY := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_FIELD,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, GEN_GEOM_ORIGIN_TAC, .. } := D
  let { ADD_SYM, FORALL_AND_THM, .. } := D.core1
  let { LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, REAL_ABS_INV, REAL_ARCH_SIMPLE, .. } := D.core3
  let { REAL_LE_DIV, REAL_LE_LDIV_EQ, REAL_LE_REFL, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_NOT_LE, REAL_OF_NUM_ADD, REAL_OF_NUM_LE,
        SKOLEM_THM, SUBSET, .. } := D.core5
  let { o_DEF, real_div, .. } := D.core6
  let { MONOTONE_BIGGER, .. } := D.misc
  let { NORM_EQ_0, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC,
        VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_SUB_LDISTRIB, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, EVENTUALLY_TRUE, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met
  let { BOUNDED_EMPTY, BOUNDED_POS, BOUNDED_SUBSET, CLOSED_CLOSURE,
        CLOSED_CONTAINS_SEQUENTIAL_LIMIT, .. } := D.top1
  let { CLOSURE_SUBSET, COMPACT_SPHERE, .. } := D.top2
  let { IN_SPHERE_0, LIM_ADD, LIM_CMUL, LIM_CONST, LIM_IN_CLOSED_SET,
        LIM_NULL_VMUL_BOUNDED, .. } := D.top4
  let { SEQ_HARMONIC, SEQ_OFFSET, compact, .. } := D.top5
  let { CONVEX_ALT, .. } := BCVX
  let { CONVEX_CLOSURE, .. } := BMCG
  let { RELATIVE_INTERIOR_SUBSET, .. } := BRIA
  let { RELATIVE_INTERIOR_EQ_EMPTY, .. } := BRIB
  let { IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK, .. } := BRIC
  -- @@SCOPE END

  let UNBOUNDED_CONVEX_CLOSED_CONTAINS_RAY ← prove
   r"!s a:real^N.
          convex s /\ ~bounded s /\ closed s /\ a IN s
          ==> ?l. ~(l = vec 0) /\ !t. &0 <= t ==> (a + t % l) IN s"
   (GEN_GEOM_ORIGIN_TAC (← q r"a:real^N") ["l"] THEN
    REWRITE_TAC [VECTOR_ADD_LID] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [BOUNDED_POS]) THEN
    REWRITE_TAC [NOT_EXISTS_THM, ← TAUT (← q r"~(p /\ q) <=> p ==> ~q")] THEN
    DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"&n + &1:real")) THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
    REWRITE_TAC [REAL_NOT_LE, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"x:num->real^N") THEN REWRITE_TAC [FORALL_AND_THM] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!n. ~((x:num->real^N) n = vec 0)") ASSUME_TAC THENL
     [ASM_MESON_TAC [← NORM_ARITH (← q r"~(&n + &1 < norm(vec 0:real^N))")], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"sphere(vec 0:real^N,&1)") compact) THEN
    REWRITE_TAC [COMPACT_SPHERE] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"\n. inv(norm(x n)) % (x:num->real^N) n")) THEN
    ASM_SIMP_TAC [IN_SPHERE_0, NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM,
                  REAL_MUL_LINV, NORM_EQ_0, o_DEF] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:real^N") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [← NORM_ARITH (← q r"~(norm(vec 0:real^N) = &1)")], ALL_TAC] THEN
    X_GEN_TAC (← q r"t:real") THEN DISCH_TAC THEN
    MATCH_MP_TAC CLOSED_CONTAINS_SEQUENTIAL_LIMIT THEN
    SUBGOAL_THEN
     (← q r"?N:num. !n. N <= n ==> t / norm(x n:real^N) <= &1")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [REAL_LE_LDIV_EQ, NORM_POS_LT] THEN
      MP_TAC (← SPEC (← q r"t:real") REAL_ARCH_SIMPLE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_LE, REAL_MUL_LID] THEN
      ASM_MESON_TAC [← REAL_ARITH (← q r"t <= m /\ m <= n /\ n + &1 < x ==> t <= x")],
      EXISTS_TAC (← q r"\n:num. t / norm((x:num->real^N)(r(N + n))) % x(r(N + n))") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONVEX_ALT]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^N")) THEN
        ASM_REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC [REAL_LE_DIV, NORM_POS_LE] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"N + n:num") o MATCH_MP MONOTONE_BIGGER) THEN
        ARITH_TAC,
        REWRITE_TAC [real_div, ← GSYM VECTOR_MUL_ASSOC] THEN
        MATCH_MP_TAC LIM_CMUL THEN ONCE_REWRITE_TAC [ADD_SYM] THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"N:num") o MATCH_MP SEQ_OFFSET) THEN
        ASM_REWRITE_TAC []]])

  let CONVEX_CLOSED_CONTAINS_SAME_RAY ← prove
   r"!s a b l:real^N.
          convex s /\ closed s /\ b IN s /\ (!t. &0 <= t ==> (a + t % l) IN s)
          ==> !t. &0 <= t ==> (b + t % l) IN s"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o SPEC (← q r"&0")) THEN
    REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_RID] THEN DISCH_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_IN_CLOSED_SET) THEN
    EXISTS_TAC (← q r"\n. (&1 - t / (&n + &1)) % b +
                    t / (&n + &1) % (a + (&n + &1) % l):real^N") THEN
    ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN CONJ_TAC THENL
     [REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      MP_TAC (← SPEC (← q r"t:real") REAL_ARCH_SIMPLE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONVEX_ALT]) THEN
      ASM_SIMP_TAC [REAL_LE_DIV, ← REAL_ARITH (← q r"&0 <= &n + &1")] THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN ASM_REAL_ARITH_TAC,
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"(&1 - u) % b + u % c:real^N = b + u % (c - b)")] THEN
      MATCH_MP_TAC LIM_ADD THEN REWRITE_TAC [LIM_CONST] THEN
      REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_SUB_LDISTRIB] THEN
      SIMP_TAC [VECTOR_MUL_ASSOC, ← REAL_FIELD (← q r"t / (&n + &1) * (&n + &1) = t")] THEN
      SIMP_TAC [← VECTOR_ARITH (← q r"(v % a + b) - v % c:real^N = b + v % (a - c)")] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_RID] THEN
      MATCH_MP_TAC LIM_ADD THEN REWRITE_TAC [LIM_CONST] THEN
      REWRITE_TAC [real_div, ← VECTOR_ARITH (← q r"(x * y) % a:real^N = y % x % a")] THEN
      MATCH_MP_TAC LIM_NULL_VMUL_BOUNDED THEN
      EXISTS_TAC (← q r"norm(t % (a - b):real^N)") THEN
      REWRITE_TAC [REAL_LE_REFL, EVENTUALLY_TRUE, o_DEF] THEN
      MP_TAC (← MATCH_MP SEQ_OFFSET SEQ_HARMONIC) THEN
      SIMP_TAC [REAL_OF_NUM_ADD]])

  let UNBOUNDED_CONVEX_CLOSED_CONTAINS_RAYS ← prove
   r"!s:real^N->bool.
          convex s /\ ~bounded s /\ closed s
          ==> ?l. ~(l = vec 0) /\ !a t. a IN s /\ &0 <= t ==> (a + t % l) IN s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [BOUNDED_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    ASM_MESON_TAC [UNBOUNDED_CONVEX_CLOSED_CONTAINS_RAY,
                   CONVEX_CLOSED_CONTAINS_SAME_RAY])

  let RELATIVE_INTERIOR_UNBOUNDED_CONVEX_CONTAINS_RAY ← prove
   r"!s a:real^N.
          convex s /\ ~bounded s /\ a IN relative_interior s
          ==> ?l. ~(l = vec 0) /\
                  !t. &0 <= t ==> (a + t % l) IN relative_interior s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"closure s:real^N->bool", ← q r"a:real^N"]
          UNBOUNDED_CONVEX_CLOSED_CONTAINS_RAY) THEN
    ASM_SIMP_TAC [CONVEX_CLOSURE, CLOSED_CLOSURE] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [BOUNDED_SUBSET, SUBSET, CLOSURE_SUBSET,
                     RELATIVE_INTERIOR_SUBSET],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:real^N") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH
        (← q r"a + t % l:real^N =
         (a + (&2 * t) % l) - inv(&2) % ((a + (&2 * t) % l) - a)")] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC])

  let RELATIVE_INTERIOR_CONVEX_CONTAINS_SAME_RAY ← prove
   r"!s a b l:real^N.
          convex s /\ b IN relative_interior s /\
          (!t. &0 <= t ==> (a + t % l) IN relative_interior s)
          ==> !t. &0 <= t ==> (b + t % l) IN relative_interior s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"closure s:real^N->bool", ← q r"a:real^N", ← q r"b:real^N",
                      ← q r"l:real^N"]
          CONVEX_CLOSED_CONTAINS_SAME_RAY) THEN
    ASM_SIMP_TAC [CONVEX_CLOSURE, CLOSED_CLOSURE] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [BOUNDED_SUBSET, SUBSET, CLOSURE_SUBSET,
                     RELATIVE_INTERIOR_SUBSET],
      DISCH_TAC THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH
        (← q r"a + t % l:real^N =
         (a + (&2 * t) % l) - inv(&2) % ((a + (&2 * t) % l) - a)")] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SHRINK THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC])

  let RELATIVE_INTERIOR_UNBOUNDED_CONVEX_CONTAINS_RAYS ← prove
   r"!s:real^N->bool.
          convex s /\ ~bounded s
          ==> ?l. ~(l = vec 0) /\
                  !a t. a IN relative_interior s /\ &0 <= t
                        ==> (a + t % l) IN relative_interior s"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"relative_interior s:real^N->bool = {}") THENL
     [ASM_MESON_TAC [RELATIVE_INTERIOR_EQ_EMPTY, BOUNDED_EMPTY], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    ASM_MESON_TAC [RELATIVE_INTERIOR_UNBOUNDED_CONVEX_CONTAINS_RAY,
                   RELATIVE_INTERIOR_CONVEX_CONTAINS_SAME_RAY])

  return { UNBOUNDED_CONVEX_CLOSED_CONTAINS_RAY, CONVEX_CLOSED_CONTAINS_SAME_RAY,
           UNBOUNDED_CONVEX_CLOSED_CONTAINS_RAYS, RELATIVE_INTERIOR_UNBOUNDED_CONVEX_CONTAINS_RAY,
           RELATIVE_INTERIOR_CONVEX_CONTAINS_SAME_RAY,
           RELATIVE_INTERIOR_UNBOUNDED_CONVEX_CONTAINS_RAYS }

/- ------------------------------------------------------------------------- -/
/- Containment of rays in unbounded convex sets (continued).                 -/
/- (convex.ml 16819-16910)                                                   -/
/- ------------------------------------------------------------------------- -/

structure CTR where
  CONVEX_TRIPLE_RELATIVE_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupCTR [HolBase] (D : ConvexDeps) (BAFF : AFF) (BCOP : COP) (BADB : ADB) (BADC : ADC)
    (BADD : ADD) (BHYP : HYP) (BRIA : RIA) (BRIC : RIC) (BIRA : IRA) (BSHP : SHP) :
    ExceptT String IO CTR := do
  -- @@SCOPE BEGIN
  let { INT_ARITH, INT_ARITH_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        INT_REDUCE_CONV, .. } := D
  let { CONJ_ACI, DIMINDEX_2, EMPTY_SUBSET, EQ_SYM_EQ, EQ_TRANS, EXTENSION, .. } := D.core1
  let { IMP_CONJ, INSERT_SUBSET, INT_LE_TRANS, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNION, MONO_OR, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_LMUL_EQ, REAL_LE_REFL, REAL_LT_ANTISYM,
        REAL_LT_IMP_NZ, .. } := D.core4
  let { REAL_SUB_LT, SUBSET, SUBSET_TRANS, .. } := D.core5
  let { SUBSET_UNIV, .. } := D.core6
  let { HULL_P, .. } := D.misc
  let { COLLINEAR_BETWEEN_CASES, DOT_LZERO, DOT_RADD, DOT_RMUL, .. } := D.vec1
  let { CONNECTED_IN_SUBSET_SEPARATED_UNION, separated_in, .. } := D.met
  let { BETWEEN_IN_SEGMENT, .. } := D.top1
  let { CLOSURE_HALFSPACE_GT, CLOSURE_HALFSPACE_LT, CLOSURE_SUBSET,
        CONNECTED_IN_EUCLIDEAN, .. } := D.top2
  let { EUCLIDEAN_CLOSURE_OF, .. } := D.top3
  let { IN_SEGMENT, .. } := D.top4
  let { SUBSET_CLOSURE, TOPSPACE_EUCLIDEAN, open_segment, .. } := D.top5
  let { AFFINE_HYPERPLANE, .. } := BAFF
  let { CONVEX_CONNECTED, .. } := BCOP
  let { AFF_DIM_GE, AFF_DIM_SUBSET, .. } := BADB
  let { AFF_DIM_EQ_MINUS1, AFF_DIM_EQ_0, AFF_DIM_EQ_AFFINE_HULL, .. } := BADC
  let { COLLINEAR_AFF_DIM, .. } := BADD
  let { AFF_DIM_HYPERPLANE, .. } := BHYP
  let { relative_frontier, .. } := BRIA
  let { CONVEX_RELATIVE_INTERIOR, .. } := BRIC
  let { CONVEX_CLOSURE_RELATIVE_INTERIOR, .. } := BIRA
  let { SUPPORTING_HYPERPLANE_RELATIVE_FRONTIER, .. } := BSHP
  -- @@SCOPE END

  let CONVEX_TRIPLE_RELATIVE_FRONTIER ← prove
   r"!s a b c d e.
          convex s /\
          {a,b,c} SUBSET relative_frontier s /\
          ~(a = b) /\ ~(a = c) /\ ~(b = c) /\
          d dot a = e /\ d dot b = e /\ d dot c = e
          ==> s SUBSET {x:real^2 | d dot x <= e} \/
              s SUBSET {x:real^2 | d dot x >= e}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"d:real^2 = vec 0") THENL
     [ASM_REWRITE_TAC [DOT_LZERO] THEN ASM_CASES_TAC (← q r"e:real = &0") THEN
      ASM_REWRITE_TAC [REAL_LE_REFL] THEN SET_TAC [],
      STRIP_TAC] THEN
    MP_TAC (← EQ_IMP_RULE (← ISPECL [← q r"a:real^2", ← q r"b:real^2", ← q r"c:real^2"]
          COLLINEAR_BETWEEN_CASES)).1 THEN
    ANTS_TAC THENL
     [REWRITE_TAC [COLLINEAR_AFF_DIM] THEN
      TRANS_TAC INT_LE_TRANS (← q r"aff_dim {x:real^2 | d dot x = e}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC AFF_DIM_SUBSET THEN ASM SET_TAC [],
        ASM_SIMP_TAC [AFF_DIM_HYPERPLANE, DIMINDEX_2] THEN INT_ARITH_TAC],
      DISCH_THEN (fun th =>
        POP_ASSUM_LIST (MP_TAC o end_itlist CONJ) THEN MP_TAC th)] THEN
    REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET] THEN
    MAP_EVERY (fun t => SPEC_TAC (t, t)) [← q r"c:real^2", ← q r"b:real^2", ← q r"a:real^2"] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"((!a b c. Q a b c <=> Q b a c) /\ (!a b c. Q a b c <=> Q b c a)) /\
      (!a b c. P c a b ==> Q a b c)
      ==> !a b c. P a b c \/ P b c a \/ P c a b ==> Q a b c")) THEN
    CONJ_TAC THENL [REWRITE_TAC [CONJ_ACI, EQ_SYM_EQ], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^2", ← q r"b:real^2", ← q r"c:real^2"] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^2->bool", ← q r"c:real^2"]
      SUPPORTING_HYPERPLANE_RELATIVE_FRONTIER) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d':real^2") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"e' = (d':real^2) dot c") THEN
    SUBGOAL_THEN (← q r"c IN segment(a:real^2,b)") MP_TAC THENL
     [ASM_REWRITE_TAC [open_segment, IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
      ASM_REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT],
      REWRITE_TAC [IN_SEGMENT]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") (STRIP_ASSUME_TAC o GSYM) o CONJUNCT2) THEN
    SUBGOAL_THEN (← q r"e' <= (d':real^2) dot a /\ e' <= (d':real^2) dot b")
    MP_TAC THENL
     [CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [relative_frontier]) THEN ASM SET_TAC [],
      MAP_EVERY EXPAND_TAC ["e'", "c"]] THEN
    REWRITE_TAC [DOT_RADD, DOT_RMUL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"(&1 - u) * a + u * b <= a <=> u * b <= u * a")] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"(&1 - u) * a + u * b <= b <=> (&1 - u) * a <= (&1 - u) * b")] THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_LT_IMP_NZ, REAL_SUB_LT] THEN
    REWRITE_TAC [REAL_LE_ANTISYM] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(d':real^2) dot a = e'") MP_TAC THENL
     [MAP_EVERY EXPAND_TAC ["e'", "c"] THEN
      REWRITE_TAC [DOT_RADD, DOT_RMUL] THEN ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
      DISCH_THEN (fun th => SUBST_ALL_TAC th THEN ASSUME_TAC th)] THEN
    SUBGOAL_THEN (← q r"{x:real^2 | d' dot x = e'} = {x | d dot x = e}")
    ASSUME_TAC THENL
     [MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"affine hull {a:real^2,b,c}") THEN
      GEN_REWRITE_TAC LAND_CONV [EQ_SYM_EQ] THEN CONJ_TAC THEN
      ONCE_REWRITE_TAC [← MESON [AFFINE_HYPERPLANE, HULL_P]
       (← q r"{x | d dot x = e} = affine hull {x | d dot x = e}")] THEN
      MATCH_MP_TAC AFF_DIM_EQ_AFFINE_HULL THEN
      SIMP_TAC [AFFINE_HYPERPLANE, HULL_P] THEN
      (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      ASM_SIMP_TAC [AFF_DIM_HYPERPLANE, DIMINDEX_2] THEN
      CONV_TAC INT_REDUCE_CONV THEN MATCH_MP_TAC (← INT_ARITH
       (← q r"--(&1):int <= d /\ ~(d = &0) /\ ~(d = --(&1)) ==> &1 <= d")) THEN
      REWRITE_TAC [AFF_DIM_EQ_0, AFF_DIM_EQ_MINUS1, AFF_DIM_GE] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"relative_interior s SUBSET {x:real^2 | d dot x < e} \/
      relative_interior s SUBSET {x | d dot x > e}")
    MP_TAC THENL
     [MATCH_MP_TAC CONNECTED_IN_SUBSET_SEPARATED_UNION THEN
      EXISTS_TAC (← q r"euclidean:(real^2)topology") THEN
      ASM_SIMP_TAC [CONNECTED_IN_EUCLIDEAN, separated_in, SUBSET_UNIV,
                    EUCLIDEAN_CLOSURE_OF, TOPSPACE_EUCLIDEAN] THEN
      ASM_SIMP_TAC [CONVEX_CONNECTED, CONVEX_RELATIVE_INTERIOR] THEN
      ASM_SIMP_TAC [CLOSURE_HALFSPACE_GT, CLOSURE_HALFSPACE_LT] THEN
      REWRITE_TAC [SUBSET, EXTENSION, IN_INTER, IN_UNION, IN_ELIM_THM] THEN
      SIMP_TAC [NOT_IN_EMPTY, ← REAL_ARITH (← q r"a:real < b \/ a > b <=> ~(a = b)")] THEN
      CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
      MP_TAC REAL_LT_ANTISYM THEN ASM SET_TAC [],
      MATCH_MP_TAC MONO_OR THEN CONJ_TAC THEN
      DISCH_THEN (MP_TAC o MATCH_MP SUBSET_CLOSURE) THEN
      ASM_SIMP_TAC [CLOSURE_HALFSPACE_GT, CLOSURE_HALFSPACE_LT] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
      ASM_SIMP_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR, CLOSURE_SUBSET]])

  return { CONVEX_TRIPLE_RELATIVE_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Explicit formulas for interior and relative interior of convex hull.      -/
/- (convex.ml 16916-17064)                                                   -/
/- ------------------------------------------------------------------------- -/

structure EXA where
  EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL : thm
  EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL_MINIMAL : thm
  deriving Inhabited

@[nospecialize]
def setupEXA [HolBase] (D : ConvexDeps) (BAFX : AFX) (BCVH : CVH) (BCVE : CVE) (BCLH : CLH)
    (BRIA : RIA) (BRIB : RIB) (BRID : RID) : ExceptT String IO EXA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC, VECTOR_ARITH,
        NORM_ARITH, .. } := D
  let { ARITH_EQ, EMPTY_GSPEC, EMPTY_SUBSET, EQ_TRANS, ETA_AX, EXISTS_IN_IMAGE, FINITE_EMPTY,
        FINITE_IMAGE, FINITE_INSERT, FINITE_NUMSEG, FORALL_AND_THM, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, HAS_SIZE, IMAGE_EQ_EMPTY, IMP_CONJ, IN_DIFF, .. } :=
    D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_SING, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY,
        REAL_ABS_MUL, REAL_ABS_POS, .. } := D.core3
  let { REAL_INF_LE_FINITE, REAL_LET_TRANS, REAL_LE_DIV2_EQ, REAL_LE_MUL2, REAL_LE_REFL,
        REAL_LE_SUP_FINITE, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_INF_FINITE, REAL_LT_MIN,
        REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_OF_NUM_EQ, REAL_SUB_LT,
        REAL_SUB_REFL, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_IMAGE,
        SUBSET_TRANS, .. } := D.core5
  let { SUM_0, SUM_ABS_LE, SUM_ADD, SUM_CLAUSES, SUM_EQ_0, SUM_LMUL, SUM_POS_LE, SUM_SING,
        SUM_SUB, SUM_SUBSET_SIMPLE, SUM_SWAP, o_THM, .. } := D.core6
  let { BASIS_EXISTS, .. } := D.vec1
  let { NORM_POS_LE, SPAN_FINITE, .. } := D.vec3
  let { VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_SUB_RDISTRIB,
        VECTOR_SUB_RZERO, VSUM_ADD, VSUM_EQ, VSUM_LMUL, VSUM_RMUL, VSUM_SING, VSUM_SUB,
        VSUM_SWAP, .. } := D.vec4
  let { BASIS_COORDINATES_LIPSCHITZ, .. } := D.top1
  let { open_in, .. } := D.top5
  let { AFFINE_HULL_FINITE, .. } := BAFX
  let { CONVEX_HULL_SING, .. } := BCVH
  let { CONVEX_HULL_FINITE, .. } := BCVE
  let { AFFINE_INDEPENDENT_IMP_FINITE, .. } := BCLH
  let { RELATIVE_INTERIOR_MAXIMAL, .. } := BRIA
  let { AFFINE_HULL_CONVEX_HULL, .. } := BRIB
  let { RELATIVE_INTERIOR_SING, .. } := BRID
  -- @@SCOPE END

  let EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL ← prove
   r"!s. FINITE s
         ==> {y:real^N | ?u. (!x. x IN s ==> &0 < u x /\ u x < &1) /\
                             sum s u = &1 /\
                             vsum s (\x. u x % x) = y}
         SUBSET relative_interior(convex hull s)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SUM_CLAUSES, REAL_OF_NUM_EQ, ARITH_EQ] THEN
    REWRITE_TAC [EMPTY_GSPEC, EMPTY_SUBSET] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC RELATIVE_INTERIOR_MAXIMAL THEN
    REWRITE_TAC [AFFINE_HULL_CONVEX_HULL] THEN CONJ_TAC THENL
     [REWRITE_TAC [CONVEX_HULL_FINITE, SUBSET, IN_ELIM_THM] THEN
      GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [REAL_LT_IMP_LE],
      ALL_TAC] THEN
    REWRITE_TAC [open_in, IN_ELIM_THM] THEN CONJ_TAC THENL
     [REWRITE_TAC [AFFINE_HULL_FINITE, SUBSET, IN_ELIM_THM] THEN
      GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [REAL_LT_IMP_LE],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"y:real^N") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"e = inf (IMAGE (\x:real^N. min (&1 - u x) (u x)) s)") THEN
    SUBGOAL_THEN (← q r"&0 < e") ASSUME_TAC THENL
     [EXPAND_TAC "e" THEN
      ASM_SIMP_TAC [REAL_LT_INF_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
      ASM_SIMP_TAC [REAL_LT_MIN, REAL_SUB_LT, FORALL_IN_IMAGE],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\z:real^N. z - y) (affine hull s)") BASIS_EXISTS) THEN
    REWRITE_TAC [SUBSET_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool")
     (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"c:real^N->bool") (STRIP_ASSUME_TAC o GSYM))
                      MP_TAC)) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, HAS_SIZE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    ASM_SIMP_TAC [SPAN_FINITE, IN_ELIM_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"compo:real^N->real^N->real")) THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC o
      MATCH_MP BASIS_COORDINATES_LIPSCHITZ) THEN
    SUBGOAL_THEN
     (← q r"!i. i IN b ==> ?u. sum s u = &0 /\ vsum s (\x:real^N. u x % x) = i")
    MP_TAC THENL
     [EXPAND_TAC "b" THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(x:real^N) IN affine hull s") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [AFFINE_HULL_FINITE, IN_ELIM_THM]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(\x. v x - u x):real^N->real") THEN
      ASM_SIMP_TAC [SUM_SUB, VSUM_SUB, VECTOR_SUB_RDISTRIB] THEN
      REWRITE_TAC [REAL_SUB_REFL, VECTOR_SUB_RZERO],
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
       [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, FORALL_AND_THM,
                  ← TAUT (← q r"(a ==> b /\ c) <=> (a ==> b) /\ (a ==> c)")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N->real^N->real") STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC (← q r"e / B /
                (&1 + sum (b:real^N->bool)
                     (\i. abs(sup(IMAGE (abs o w i) (s:real^N->bool)))))") THEN
    ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 <= x ==> &0 < &1 + x"),
                  SUM_POS_LE, REAL_ABS_POS] THEN
    X_GEN_TAC (← q r"z:real^N") THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"\x:real^N. u x + sum (b:real^N->bool)
                           (\i. compo (z:real^N) i * w i x)") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [SUM_ADD, ← REAL_ARITH (← q r"&1 + x = &1 <=> x = &0")] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) SUM_SWAP o lhand o snd) THEN
      ASM_REWRITE_TAC [FINITE_NUMSEG] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC SUM_EQ_0 THEN
      ASM_SIMP_TAC [SUM_LMUL, ETA_AX, REAL_MUL_RZERO, SUM_0],
      ASM_SIMP_TAC [VSUM_ADD, VECTOR_ADD_RDISTRIB] THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"y + w:real^N = z <=> w = z - y")] THEN
      ASM_SIMP_TAC [← GSYM VSUM_LMUL, ← GSYM VSUM_RMUL, ← GSYM VECTOR_MUL_ASSOC] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) VSUM_SWAP o lhand o snd) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      ASM_SIMP_TAC [VSUM_LMUL] THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"vsum b (\v:real^N. compo (z:real^N) v % v)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_SIMP_TAC []] THEN
      MATCH_MP_TAC VSUM_EQ THEN ASM_SIMP_TAC []] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"abs(x) < min u (&1 - u) ==> &0 < u + x /\ u + x < &1")) THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC
      (← q r"B * norm(z - y:real^N) * sum (b:real^N->bool)
                     (\i. abs(sup(IMAGE (abs o w i) (s:real^N->bool))))") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← GSYM SUM_LMUL] THEN MATCH_MP_TAC SUM_ABS_LE THEN
      ASM_REWRITE_TAC [REAL_ABS_MUL, REAL_MUL_ASSOC] THEN
      X_GEN_TAC (← q r"i:real^N") THEN STRIP_TAC THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
      REWRITE_TAC [REAL_ABS_POS] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"(compo:real^N->real^N->real) z",
                                      ← q r"i:real^N"]) THEN
        ASM_SIMP_TAC [],
        MATCH_MP_TAC (← REAL_ARITH (← q r"x <= a ==> x <= abs a")) THEN
        ASM_SIMP_TAC [REAL_LE_SUP_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, o_THM] THEN ASM_MESON_TAC [REAL_LE_REFL]],
      ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"&0 <= x /\ x * (&1 + e) < d ==> x * e < d")) THEN
    REWRITE_TAC [NORM_POS_LE] THEN
    ASM_SIMP_TAC [NORM_POS_LE, ← GSYM REAL_LT_RDIV_EQ,
                  ← REAL_ARITH (← q r"&0 <= x ==> &0 < &1 + x"),
                  SUM_POS_LE, REAL_ABS_POS] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← NORM_ARITH
     (← q r"dist(z:real^N,y) < k ==> k <= d ==> norm(z - y) < d"))) THEN
    ASM_SIMP_TAC [REAL_LE_DIV2_EQ, ← REAL_ARITH (← q r"&0 <= x ==> &0 < &1 + x"),
                  SUM_POS_LE, REAL_ABS_POS] THEN
    EXPAND_TAC "e" THEN
    ASM_SIMP_TAC [REAL_INF_LE_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE] THEN EXISTS_TAC (← q r"x:real^N") THEN
    ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL_MINIMAL ← prove
   r"!s. FINITE s
         ==> {y:real^N | ?u. (!x. x IN s ==> &0 < u x) /\
                             sum s u = &1 /\
                             vsum s (\x. u x % x) = y}
         SUBSET relative_interior(convex hull s)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SUM_CLAUSES, REAL_OF_NUM_EQ, ARITH_EQ] THEN
    REWRITE_TAC [EMPTY_GSPEC, EMPTY_SUBSET] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"s = {a:real^N}") THENL
     [ASM_REWRITE_TAC [SUM_SING, VSUM_SING, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
      REWRITE_TAC [RELATIVE_INTERIOR_SING, CONVEX_HULL_SING] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_SING] THEN
      MESON_TAC [VECTOR_MUL_LID],
      FIRST_ASSUM (MP_TAC o MATCH_MP
        EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"w:real^N") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N->real") THEN
      STRIP_TAC THEN ASM_SIMP_TAC [] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"?y:real^N. y IN s /\ ~(y = x)") STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"sum {x,y} u <= sum s (u:real^N->real)") MP_TAC THENL
       [MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
        ASM_SIMP_TAC [AFFINE_INDEPENDENT_IMP_FINITE, REAL_LT_IMP_LE, IN_DIFF] THEN
        ASM SET_TAC [],
        ASM_SIMP_TAC [SUM_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN
        ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < y ==> x + y + &0 <= &1 ==> x < &1")) THEN
        ASM_SIMP_TAC []]])

  return { EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL,
           EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL_MINIMAL }

/- ------------------------------------------------------------------------- -/
/- Explicit formulas for interior and relative interior of convex hull,      -/
/- continued. (convex.ml 17065-17277)                                        -/
/- ------------------------------------------------------------------------- -/

structure EXB where
  RELATIVE_INTERIOR_CONVEX_HULL_EXPLICIT : thm
  EXPLICIT_SUBSET_INTERIOR_CONVEX_HULL : thm
  EXPLICIT_SUBSET_INTERIOR_CONVEX_HULL_MINIMAL : thm
  INTERIOR_CONVEX_HULL_EXPLICIT_MINIMAL : thm
  INTERIOR_CONVEX_HULL_EXPLICIT : thm
  DISJOINT_RELATIVE_INTERIOR_CONVEX_HULL : thm
  INTERIOR_CONVEX_HULL_3_MINIMAL : thm
  INTERIOR_CONVEX_HULL_3 : thm
  deriving Inhabited

@[nospecialize]
def setupEXB [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFX : AFX) (BAFS : AFS) (BAFD : AFD)
    (BCOP : COP) (BCVH : CVH) (BCVE : CVE) (BCLH : CLH) (BAFI : AFI) (BADC : ADC) (BRIA : RIA)
    (BRIB : RIB) (BRID : RID) (BEXA : EXA) : ExceptT String IO EXB := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, HAS_SIZE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC,
        NORM_ARITH, GEOM_ORIGIN_TAC, .. } := D
  let { ARITH, CARD_CLAUSES, CHOOSE_SUBSET, COND_RAND, COND_RATOR, CONTRAPOS_THM,
        DE_MORGAN_THM, DIMINDEX_2, DIMINDEX_GE_1, EQ_TRANS, EXTENSION, FINITE_EMPTY,
        FINITE_INSERT, FINITE_RESTRICT, FINITE_UNION, .. } := D.core1
  let { FUN_EQ_THM, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_SING, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, REAL_ABS_DIV, REAL_ABS_NUM, REAL_ADD_LID, REAL_ADD_LINV,
        REAL_DIV_RMUL, .. } := D.core3
  let { REAL_LT_01, REAL_LT_ADD, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, .. } := D.core4
  let { REAL_OF_NUM_LT, RIGHT_EXISTS_AND_THM, RIGHT_IMP_FORALL_THM, SUBSET,
        SUBSET_ANTISYM, .. } := D.core5
  let { SUM_0, SUM_ADD, SUM_CASES, SUM_CLAUSES, SUM_DELTA, SUM_SING, SUM_SUB,
        SUM_SUBSET_SIMPLE, .. } := D.core6
  let { HULL_INC, REAL_HALF, .. } := D.misc
  let { NORM_MUL, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_MUL_RZERO, VECTOR_SUB_EQ, VECTOR_SUB_RDISTRIB, VSUM_0, VSUM_ADD, VSUM_CASES,
        VSUM_DELTA, VSUM_SING, VSUM_SUB, .. } := D.vec4
  let { IN_BALL, .. } := D.top4
  let { AFFINE_AFFINE_HULL, IN_AFFINE_SUB_MUL_DIFF, .. } := BAFF
  let { AFFINE_HULL_FINITE, .. } := BAFX
  let { AFFINE_HULL_FINITE_STEP_GEN, .. } := BAFS
  let { AFFINE_DEPENDENT_EXPLICIT_FINITE, .. } := BAFD
  let { COLLINEAR_3_EQ_AFFINE_DEPENDENT, .. } := BCOP
  let { CONVEX_HULL_SING, .. } := BCVH
  let { CONVEX_HULL_FINITE, .. } := BCVE
  let { AFFINE_INDEPENDENT_IMP_FINITE, .. } := BCLH
  let { AFFINE_INDEPENDENT_SPAN_GT, EMPTY_INTERIOR_CONVEX_HULL, .. } := BAFI
  let { AFFINE_INDEPENDENT_IFF_CARD, .. } := BADC
  let { RELATIVE_INTERIOR_SUBSET, IN_RELATIVE_INTERIOR, .. } := BRIA
  let { RELATIVE_INTERIOR_INTERIOR, AFFINE_HULL_CONVEX_HULL, .. } := BRIB
  let { RELATIVE_INTERIOR_SING, .. } := BRID
  let { EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL,
        EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL_MINIMAL, .. } := BEXA
  -- @@SCOPE END

  let RELATIVE_INTERIOR_CONVEX_HULL_EXPLICIT ← prove
   r"!s. ~(affine_dependent s)
         ==> relative_interior(convex hull s) =
               {y:real^N | ?u. (!x. x IN s ==> &0 < u x) /\
                               sum s u = &1 /\
                               vsum s (\x. u x % x) = y}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL_MINIMAL] THEN
    ASM_CASES_TAC (← q r"?a:real^N. s = {a}") THENL
     [FIRST_X_ASSUM (CHOOSE_THEN SUBST1_TAC) THEN
      ASM_REWRITE_TAC [SUM_SING, VSUM_SING, CONVEX_HULL_SING,
                       RELATIVE_INTERIOR_SING] THEN
      REWRITE_TAC [IN_ELIM_THM, SUBSET, IN_SING] THEN
      REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"\x:real^N. &1") THEN
      ASM_REWRITE_TAC [VECTOR_MUL_LID, REAL_LT_01],
      ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"relative_interior s SUBSET s /\
      (!x. x IN s /\ ~(x IN t) ==> ~(x IN relative_interior s))
      ==> relative_interior s SUBSET t")) THEN
    REWRITE_TAC [RELATIVE_INTERIOR_SUBSET] THEN
    X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_RELATIVE_INTERIOR] THEN
    REWRITE_TAC [AFFINE_HULL_CONVEX_HULL, IN_ELIM_THM, NOT_EXISTS_THM] THEN
    REWRITE_TAC [CONVEX_HULL_FINITE, IN_ELIM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC)
     (MP_TAC o SPEC (← q r"u:real^N->real"))) THEN
    ASM_REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, IN_RELATIVE_INTERIOR, DE_MORGAN_THM,
                     SUBSET, IN_ELIM_THM, IN_BALL, IN_INTER] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN DISJ2_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real")
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*"))) THEN
    SUBGOAL_THEN (← q r"(u:real^N->real) a = &0") ASSUME_TAC THENL
     [ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= x /\ ~(&0 < x) ==> x = &0")], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?b:real^N. b IN s /\ ~(b = a)") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?d. &0 < d /\ norm(d % (a - b):real^N) < e")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"e / &2 / norm(a - b:real^N)") THEN
      ASM_SIMP_TAC [NORM_MUL, REAL_LT_DIV, REAL_OF_NUM_LT, ARITH, NORM_POS_LT,
                    REAL_ABS_DIV, REAL_ABS_NORM, REAL_ABS_NUM,
                    REAL_DIV_RMUL, REAL_LT_IMP_NZ, VECTOR_SUB_EQ] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"y - d % (a - b):real^N")) THEN
    ASM_REWRITE_TAC [← NORM_ARITH (← q r"dist(a:real^N,a - b) = norm b")] THEN
    REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [MATCH_MP_TAC IN_AFFINE_SUB_MUL_DIFF THEN
      ASM_SIMP_TAC [HULL_INC, AFFINE_AFFINE_HULL] THEN
      REWRITE_TAC [AFFINE_HULL_FINITE, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"u:real^N->real") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->real") STRIP_ASSUME_TAC) THEN
    UNDISCH_TAC (← q r"~(affine_dependent(s:real^N->bool))") THEN
    ASM_SIMP_TAC [AFFINE_DEPENDENT_EXPLICIT_FINITE] THEN
    EXISTS_TAC (← q r"\x:real^N. (v x - u x) -
                     (if x = a then --d else if x = b then d else &0)") THEN
    REWRITE_TAC [VECTOR_SUB_RDISTRIB, ← MESON []
     (← q r"(if p then a else b) % x = (if p then a % x else b % x)")] THEN
    ASM_SIMP_TAC [SUM_SUB, VSUM_SUB] THEN
    ASM_SIMP_TAC [VSUM_CASES, SUM_CASES, FINITE_RESTRICT, IN_ELIM_THM] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"a IN s ==> {x | x IN s /\ x = a} = {a}"),
     ← SET_RULE (← q r"b IN s /\ ~(b = a)
               ==> {x | (x IN s /\ ~(x = a)) /\ x = b} = {b}")] THEN
    ASM_SIMP_TAC [VECTOR_MUL_LZERO, SUM_0, VSUM_0, SUM_SING, VSUM_SING] THEN
    CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
    CONJ_TAC THENL [ALL_TAC, VECTOR_ARITH_TAC] THEN
    EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^N")) THEN ASM_REWRITE_TAC [] THEN
    ASM_REAL_ARITH_TAC)

  let EXPLICIT_SUBSET_INTERIOR_CONVEX_HULL ← prove
   r"!s. FINITE s /\ affine hull s = (:real^N)
         ==> {y | ?u. (!x. x IN s ==> &0 < u x /\ u x < &1) /\
                      sum s u = &1 /\
                      vsum s (\x. u x % x) = y}
             SUBSET interior(convex hull s)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o
      MATCH_MP EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL) THEN
    ASM_SIMP_TAC [RELATIVE_INTERIOR_INTERIOR, AFFINE_HULL_CONVEX_HULL])

  let EXPLICIT_SUBSET_INTERIOR_CONVEX_HULL_MINIMAL ← prove
   r"!s. FINITE s /\ affine hull s = (:real^N)
         ==> {y | ?u. (!x. x IN s ==> &0 < u x) /\
                      sum s u = &1 /\
                      vsum s (\x. u x % x) = y}
             SUBSET interior(convex hull s)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o
      MATCH_MP EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL_MINIMAL) THEN
    ASM_SIMP_TAC [RELATIVE_INTERIOR_INTERIOR, AFFINE_HULL_CONVEX_HULL])

  let INTERIOR_CONVEX_HULL_EXPLICIT_MINIMAL ← prove
   r"!s:real^N->bool.
          ~(affine_dependent s)
          ==> interior(convex hull s) =
               if CARD(s) <= dimindex(:N) then {}
                else {y | ?u. (!x. x IN s ==> &0 < u x) /\
                              sum s u = &1 /\
                              vsum s (\x. u x % x) = y}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [EMPTY_INTERIOR_CONVEX_HULL] THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"relative_interior(convex hull s):real^N->bool") THEN
    CONJ_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC RELATIVE_INTERIOR_INTERIOR THEN
      REWRITE_TAC [AFFINE_HULL_CONVEX_HULL] THEN
      MATCH_MP_TAC AFFINE_INDEPENDENT_SPAN_GT THEN
      ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
      ASM_SIMP_TAC [RELATIVE_INTERIOR_CONVEX_HULL_EXPLICIT]])

  let INTERIOR_CONVEX_HULL_EXPLICIT ← prove
   r"!s:real^N->bool.
          ~(affine_dependent s)
          ==> interior(convex hull s) =
               if CARD(s) <= dimindex(:N) then {}
                else {y | ?u. (!x. x IN s ==> &0 < u x /\ u x < &1) /\
                              sum s u = &1 /\
                              vsum s (\x. u x % x) = y}"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [INTERIOR_CONVEX_HULL_EXPLICIT_MINIMAL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"v:real^N") THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"u:real^N->real") THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CHOOSE_SUBSET) THEN
    ASM_SIMP_TAC [AFFINE_INDEPENDENT_IMP_FINITE] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"2")) THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"~(c <= n) ==> 1 <= n ==> 2 <= c"))) THEN
      REWRITE_TAC [DIMINDEX_GE_1],
      ALL_TAC] THEN
    CONV_TAC (ONCE_DEPTH_CONV HAS_SIZE_CONV) THEN
    REWRITE_TAC [SUBSET] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") (CONJUNCTS_THEN2 ASSUME_TAC
      MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") (X_CHOOSE_THEN (← q r"b:real^N")
          STRIP_ASSUME_TAC)) THEN
    SUBGOAL_THEN (← q r"?y:real^N. y IN s /\ ~(y = x)") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"sum {x,y} u <= sum s (u:real^N->real)") MP_TAC THENL
     [MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
      ASM_SIMP_TAC [AFFINE_INDEPENDENT_IMP_FINITE, REAL_LT_IMP_LE, IN_DIFF] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [SUM_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN
    ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < y ==> x + y + &0 <= &1 ==> x < &1")) THEN
    ASM_SIMP_TAC [])

  let DISJOINT_RELATIVE_INTERIOR_CONVEX_HULL ← prove
   r"!s:real^N->bool.
          ~affine_dependent s /\ ~(?a. s = {a})
          ==> relative_interior(convex hull s) INTER s = {}"
   (REWRITE_TAC [← SET_RULE (← q r"s INTER t = {} <=> !x. x IN t ==> ~(x IN s)")] THEN
    GEN_TAC THEN REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    X_GEN_TAC (← q r"z:real^N") THEN GEOM_ORIGIN_TAC (← q r"z:real^N") THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [RELATIVE_INTERIOR_CONVEX_HULL_EXPLICIT, IN_ELIM_THM] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (STRIP_ASSUME_TAC (← GEN_REWRITE_RULE id [AFFINE_INDEPENDENT_IFF_CARD] th) THEN
        MP_TAC th)) THEN
    ASM_SIMP_TAC [AFFINE_DEPENDENT_EXPLICIT_FINITE, CONTRAPOS_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x. (if x = vec 0 then -- &1 else &0) + (u:real^N->real) x") THEN
    ASM_SIMP_TAC [VECTOR_ADD_RDISTRIB, VSUM_ADD, SUM_ADD] THEN
    REWRITE_TAC [COND_RAND, COND_RATOR, VECTOR_MUL_LZERO] THEN
    ASM_SIMP_TAC [SUM_DELTA, VSUM_DELTA, VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
    REWRITE_TAC [REAL_ADD_LINV, REAL_ADD_LID] THEN MATCH_MP_TAC (← MESON []
     (← q r"(?x. ~(x = a) /\ q x) ==> ?x. if x = a then p x else q x")) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(?a. s = {a}) ==> vec 0 IN s ==> ?b. ~(b = vec 0) /\ b IN s"))) THEN
    ASM_MESON_TAC [REAL_LT_IMP_NZ])

  let INTERIOR_CONVEX_HULL_3_MINIMAL ← prove
   r"!a b c:real^2.
          ~collinear{a,b,c}
          ==> interior(convex hull {a,b,c}) =
                  {v | ?x y z. &0 < x /\
                               &0 < y /\
                               &0 < z /\
                               x + y + z = &1 /\
                               x % a + y % b + z % c = v}"
   (REWRITE_TAC [COLLINEAR_3_EQ_AFFINE_DEPENDENT, DE_MORGAN_THM] THEN
    REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [INTERIOR_CONVEX_HULL_EXPLICIT_MINIMAL] THEN
    ASM_SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN
    CONV_TAC (LAND_CONV (RATOR_CONV (LAND_CONV (ONCE_DEPTH_CONV (REWRITE_CONV
     [IN_INSERT, NOT_IN_EMPTY]))))) THEN
    ASM_REWRITE_TAC [DIMINDEX_2, ARITH] THEN
    SIMP_TAC [FINITE_INSERT, FINITE_UNION, FINITE_EMPTY, RIGHT_EXISTS_AND_THM,
              AFFINE_HULL_FINITE_STEP_GEN, REAL_LT_ADD, REAL_HALF] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&1 - a - b - c = &0 <=> a + b + c = &1"),
           ← VECTOR_ARITH (← q r"y - a - b - c:real^N = vec 0 <=> a + b + c = y")])

  let INTERIOR_CONVEX_HULL_3 ← prove
   r"!a b c:real^2.
          ~collinear{a,b,c}
          ==> interior(convex hull {a,b,c}) =
                  {v | ?x y z. &0 < x /\ x < &1 /\
                               &0 < y /\ y < &1 /\
                               &0 < z /\ z < &1 /\
                               x + y + z = &1 /\
                               x % a + y % b + z % c = v}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [INTERIOR_CONVEX_HULL_3_MINIMAL] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN GEN_TAC THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  return { RELATIVE_INTERIOR_CONVEX_HULL_EXPLICIT, EXPLICIT_SUBSET_INTERIOR_CONVEX_HULL,
           EXPLICIT_SUBSET_INTERIOR_CONVEX_HULL_MINIMAL, INTERIOR_CONVEX_HULL_EXPLICIT_MINIMAL,
           INTERIOR_CONVEX_HULL_EXPLICIT, DISJOINT_RELATIVE_INTERIOR_CONVEX_HULL,
           INTERIOR_CONVEX_HULL_3_MINIMAL, INTERIOR_CONVEX_HULL_3 }

/- ------------------------------------------------------------------------- -/
/- Similar results for closure and (relative or absolute) frontier.          -/
/- (convex.ml 17282-17456)                                                   -/
/- ------------------------------------------------------------------------- -/

structure CFA where
  CLOSURE_CONVEX_HULL : thm
  RELATIVE_FRONTIER_CONVEX_HULL_EXPLICIT : thm
  FRONTIER_CONVEX_HULL_EXPLICIT : thm
  RELATIVE_FRONTIER_OF_CONVEX_HULL : thm
  FRONTIER_CONVEX_HULL_CASES : thm
  IN_FRONTIER_CONVEX_HULL : thm
  NOT_IN_INTERIOR_CONVEX_HULL : thm
  INTERIOR_CONVEX_HULL_EQ_EMPTY : thm
  deriving Inhabited

@[nospecialize]
def setupCFA [HolBase] (D : ConvexDeps) (BAFD : AFD) (BCVE : CVE) (BCLH : CLH) (BAFI : AFI)
    (BOCH : OCH) (BRIA : RIA) (BRIB : RIB) (BEXB : EXB) : ExceptT String IO CFA := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_FIELD, SET_RULE,
        SET_TAC, VECTOR_ARITH_TAC, .. } := D
  let { ARITH_SUC, CARD_CLAUSES, CARD_DELETE, COND_ID, COND_RAND, COND_RATOR, DELETE,
        DIFF_EMPTY, DIMINDEX_GE_1, EXTENSION, FINITE_DELETE, FINITE_EMPTY,
        FINITE_INSERT, .. } := D.core1
  let { HAS_SIZE, IN_DELETE, IN_DIFF, .. } := D.core2
  let { IN_ELIM_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, NOT_LE, NOT_LT, REAL_ADD_LID, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_INV_EQ, REAL_LT_REFL, .. } := D.core4
  let { REAL_OF_NUM_ADD, REAL_SUB_0, REAL_SUB_RZERO, SUBSET_REFL, .. } := D.core5
  let { SUM_0, SUM_CASES, SUM_CONST, SUM_DELETE, SUM_SUB, UNIONS_GSPEC, .. } := D.core6
  let { HULL_INC, HULL_MONO, HULL_REDUNDANT, HULL_SUBSET, .. } := D.misc
  let { VECTOR_ADD_LID, VECTOR_MUL_LZERO, VECTOR_SUB_EQ, VECTOR_SUB_RDISTRIB, VSUM_0,
        VSUM_CASES, VSUM_DELETE, VSUM_SUB, .. } := D.vec4
  let { CLOSURE_CLOSED, .. } := D.top1
  let { COMPACT_IMP_CLOSED, .. } := D.top2
  let { FINITE_IMP_COMPACT, .. } := D.top3
  let { SUBSET_INTERIOR, frontier, .. } := D.top5
  let { affine_dependent, AFFINE_DEPENDENT_EXPLICIT, .. } := BAFD
  let { CONVEX_HULL_FINITE, .. } := BCVE
  let { CONVEX_HULL_SUBSET_AFFINE_HULL, AFFINE_INDEPENDENT_IMP_FINITE, .. } := BCLH
  let { AFFINE_INDEPENDENT_SPAN_GT, EMPTY_INTERIOR_AFFINE_HULL, .. } := BAFI
  let { COMPACT_CONVEX_HULL, .. } := BOCH
  let { relative_frontier, .. } := BRIA
  let { RELATIVE_INTERIOR_INTERIOR, .. } := BRIB
  let { RELATIVE_INTERIOR_CONVEX_HULL_EXPLICIT, INTERIOR_CONVEX_HULL_EXPLICIT_MINIMAL,
        INTERIOR_CONVEX_HULL_EXPLICIT, .. } := BEXB
  -- @@SCOPE END

  let CLOSURE_CONVEX_HULL ← prove
   r"!s. compact s ==> closure(convex hull s) = convex hull s"
   (SIMP_TAC [CLOSURE_CLOSED, COMPACT_IMP_CLOSED, COMPACT_CONVEX_HULL])

  let RELATIVE_FRONTIER_CONVEX_HULL_EXPLICIT ← prove
   r"!s:real^N->bool.
          ~(affine_dependent s)
          ==> relative_frontier(convex hull s) =
                  {y | ?u. (!x. x IN s ==> &0 <= u x) /\
                           (?x. x IN s /\ u x = &0) /\
                           sum s u = &1 /\
                           vsum s (\x. u x % x) = y}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [relative_frontier, UNIONS_GSPEC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    ASM_SIMP_TAC [CLOSURE_CONVEX_HULL, FINITE_IMP_COMPACT] THEN
    ASM_SIMP_TAC [CONVEX_HULL_FINITE, RELATIVE_INTERIOR_CONVEX_HULL_EXPLICIT] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [IN_DIFF, IN_ELIM_THM] THEN EQ_TAC THENL
     [DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC) ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"u:real^N->real")) THEN
      ASM_REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN
      DISCH_THEN (CHOOSE_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= x ==> (~(&0 < x) <=> x = &0)")] THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"u:real^N->real") THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->real")
       (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC)) THEN
      CONJ_TAC THENL
       [EXISTS_TAC (← q r"u:real^N->real") THEN ASM_SIMP_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
       [AFFINE_DEPENDENT_EXPLICIT]) THEN
      REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC
       [← q r"s:real^N->bool", ← q r"(\x. u x - v x):real^N->real"] THEN
      ASM_SIMP_TAC [SUBSET_REFL, VECTOR_SUB_RDISTRIB, SUM_SUB, VSUM_SUB] THEN
      REWRITE_TAC [REAL_SUB_0, VECTOR_SUB_EQ] THEN ASM_MESON_TAC [REAL_LT_REFL]])

  let FRONTIER_CONVEX_HULL_EXPLICIT ← prove
   r"!s:real^N->bool.
          ~(affine_dependent s)
          ==> frontier(convex hull s) =
                  {y | ?u. (!x. x IN s ==> &0 <= u x) /\
                           (dimindex(:N) < CARD s ==> ?x. x IN s /\ u x = &0) /\
                           sum s u = &1 /\
                           vsum s (\x. u x % x) = y}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [frontier] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    DISJ_CASES_TAC
     (← ARITH_RULE (← q r"CARD(s:real^N->bool) <= dimindex(:N) \/
                  dimindex(:N) < CARD(s:real^N->bool)"))
    THENL
     [ASM_SIMP_TAC [← GSYM NOT_LE, INTERIOR_CONVEX_HULL_EXPLICIT] THEN
      ASM_SIMP_TAC [CLOSURE_CONVEX_HULL, FINITE_IMP_COMPACT, DIFF_EMPTY] THEN
      REWRITE_TAC [CONVEX_HULL_FINITE],
      ASM_SIMP_TAC [← GSYM RELATIVE_FRONTIER_CONVEX_HULL_EXPLICIT] THEN
      REWRITE_TAC [relative_frontier] THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC RELATIVE_INTERIOR_INTERIOR THEN
      MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ s = UNIV ==> t = UNIV")) THEN
      EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
      ASM_SIMP_TAC [AFFINE_INDEPENDENT_SPAN_GT, HULL_MONO, HULL_SUBSET]])

  let RELATIVE_FRONTIER_OF_CONVEX_HULL ← prove
   r"!s:real^N->bool.
          ~(affine_dependent s)
          ==> relative_frontier(convex hull s) =
                  UNIONS { convex hull (s DELETE a) |a| a IN s }"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [UNIONS_GSPEC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    ASM_SIMP_TAC [RELATIVE_FRONTIER_CONVEX_HULL_EXPLICIT] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, CONVEX_HULL_FINITE] THEN
    X_GEN_TAC (← q r"y:real^N") THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->real") MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"u:real^N->real") THEN
      ASM_SIMP_TAC [IN_DELETE, SUM_DELETE, VSUM_DELETE, REAL_SUB_RZERO] THEN
      VECTOR_ARITH_TAC,
      REWRITE_TAC [IN_DELETE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC))) THEN
      EXISTS_TAC (← q r"(\x. if x = a then &0 else u x):real^N->real") THEN
      ASM_SIMP_TAC [COND_RAND, COND_RATOR, REAL_LE_REFL, COND_ID] THEN
      CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [SUM_CASES, VSUM_CASES, VECTOR_MUL_LZERO] THEN
      ASM_SIMP_TAC [← GSYM DELETE, SUM_0, VSUM_0, REAL_ADD_LID, VECTOR_ADD_LID]])

  let FRONTIER_CONVEX_HULL_CASES ← prove
   r"!s:real^N->bool.
          ~(affine_dependent s)
          ==> frontier(convex hull s) =
                  if CARD(s) <= dimindex(:N) then convex hull s
                  else UNIONS { convex hull (s DELETE a) |a| a IN s }"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP AFFINE_INDEPENDENT_IMP_FINITE) THEN
    ASM_SIMP_TAC [frontier, CLOSURE_CONVEX_HULL, FINITE_IMP_COMPACT] THEN
    COND_CASES_TAC THENL
     [ASM_SIMP_TAC [INTERIOR_CONVEX_HULL_EXPLICIT, DIFF_EMPTY], ALL_TAC] THEN
    ASM_SIMP_TAC [← GSYM RELATIVE_FRONTIER_OF_CONVEX_HULL] THEN
    ASM_SIMP_TAC [relative_frontier, frontier,
                  CLOSURE_CONVEX_HULL, FINITE_IMP_COMPACT] THEN
    AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
    RULE_ASSUM_TAC (REWRITE_RULE [NOT_LE]) THEN
    MATCH_MP_TAC RELATIVE_INTERIOR_INTERIOR THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ s = UNIV ==> t = UNIV")) THEN
    EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
    ASM_SIMP_TAC [AFFINE_INDEPENDENT_SPAN_GT, HULL_MONO, HULL_SUBSET])

  let IN_FRONTIER_CONVEX_HULL ← prove
   r"!s x:real^N.
          FINITE s /\ CARD s <= dimindex(:N) + 1 /\ x IN s
          ==> x IN frontier(convex hull s)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"affine_dependent(s:real^N->bool)") THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [affine_dependent]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
      ASM_SIMP_TAC [frontier, CLOSURE_CONVEX_HULL, FINITE_IMP_COMPACT] THEN
      ASM_SIMP_TAC [HULL_INC, IN_DIFF] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"!t. s SUBSET t /\ t = {} ==> ~(x IN s)")) THEN
      EXISTS_TAC (← q r"interior(affine hull s):real^N->bool") THEN
      SIMP_TAC [SUBSET_INTERIOR, CONVEX_HULL_SUBSET_AFFINE_HULL] THEN
      SUBGOAL_THEN (← q r"s = (a:real^N) INSERT (s DELETE a)") SUBST1_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [HULL_REDUNDANT] THEN
      MATCH_MP_TAC EMPTY_INTERIOR_AFFINE_HULL THEN
      ASM_SIMP_TAC [FINITE_DELETE, CARD_DELETE] THEN ASM_ARITH_TAC,
      ASM_SIMP_TAC [FRONTIER_CONVEX_HULL_CASES] THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [HULL_INC] THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM] THEN
      SUBGOAL_THEN (← q r"?y:real^N. y IN s /\ ~(y = x)") MP_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"x IN s ==> ~(s = {x}) ==> ?y. y IN s /\ ~(y = x)"))) THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_LE]) THEN
        ASM_SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN
        REWRITE_TAC [NOT_LT, NOT_IN_EMPTY, ARITH_SUC, DIMINDEX_GE_1],
        MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HULL_INC THEN ASM SET_TAC []]])

  let NOT_IN_INTERIOR_CONVEX_HULL ← prove
   r"!s x:real^N.
          FINITE s /\ CARD s <= dimindex(:N) + 1 /\ x IN s
          ==> ~(x IN interior(convex hull s))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP IN_FRONTIER_CONVEX_HULL) THEN
    SIMP_TAC [frontier, IN_DIFF])

  let INTERIOR_CONVEX_HULL_EQ_EMPTY ← prove
   r"!s:real^N->bool.
          s HAS_SIZE (dimindex(:N) + 1)
          ==> (interior(convex hull s) = {} <=> affine_dependent s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_SIZE] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"affine_dependent(s:real^N->bool)") THENL
     [ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
        [affine_dependent]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
      ASM_SIMP_TAC [frontier, CLOSURE_CONVEX_HULL, FINITE_IMP_COMPACT] THEN
      ASM_SIMP_TAC [HULL_INC, IN_DIFF] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"!t. s SUBSET t /\ t = {} ==> s = {}")) THEN
      EXISTS_TAC (← q r"interior(affine hull s):real^N->bool") THEN
      SIMP_TAC [SUBSET_INTERIOR, CONVEX_HULL_SUBSET_AFFINE_HULL] THEN
      SUBGOAL_THEN (← q r"s = (a:real^N) INSERT (s DELETE a)") SUBST1_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [HULL_REDUNDANT] THEN
      MATCH_MP_TAC EMPTY_INTERIOR_AFFINE_HULL THEN
      ASM_SIMP_TAC [FINITE_DELETE, CARD_DELETE] THEN ASM_ARITH_TAC,
      ASM_SIMP_TAC [INTERIOR_CONVEX_HULL_EXPLICIT_MINIMAL] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, ← ARITH_RULE (← q r"~(n + 1 <= n)")] THEN
      EXISTS_TAC (← q r"vsum s (\x:real^N. inv(&(dimindex(:N)) + &1) % x)") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"\x:real^N. inv(&(dimindex(:N)) + &1)") THEN
      ASM_SIMP_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      ASM_SIMP_TAC [SUM_CONST, ← GSYM REAL_OF_NUM_ADD] THEN
      CONV_TAC (fun t => REAL_FIELD t)])

  return { CLOSURE_CONVEX_HULL, RELATIVE_FRONTIER_CONVEX_HULL_EXPLICIT,
           FRONTIER_CONVEX_HULL_EXPLICIT, RELATIVE_FRONTIER_OF_CONVEX_HULL,
           FRONTIER_CONVEX_HULL_CASES, IN_FRONTIER_CONVEX_HULL, NOT_IN_INTERIOR_CONVEX_HULL,
           INTERIOR_CONVEX_HULL_EQ_EMPTY }

/- ------------------------------------------------------------------------- -/
/- Similar things in special case (could use above as lemmas here instead).  -/
/- (convex.ml 17461-17583)                                                   -/
/- ------------------------------------------------------------------------- -/

structure SIM where
  SIMPLEX_EXPLICIT : thm
  STD_SIMPLEX : thm
  INTERIOR_STD_SIMPLEX : thm
  deriving Inhabited

@[nospecialize]
def setupSIM [HolBase] (D : ConvexDeps) (BCVE : CVE) : ExceptT String IO SIM := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        NORM_ARITH, .. } := D
  let { CARD_NUMSEG_1, CONJ_ASSOC, DIMINDEX_GE_1, EXTENSION, FINITE_IMAGE, FINITE_INSERT,
        FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_NUMSEG, LE_REFL, MONO_AND, MONO_FORALL, NOT_LE,
        NUMSEG_EMPTY, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_INF_FINITE, REAL_LT_LE, REAL_LT_MIN, REAL_LT_RDIV_EQ, .. } :=
    D.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, REAL_OF_NUM_LT, REAL_SUB_LE, REAL_SUB_LT, SIMPLE_IMAGE,
        SUBSET, .. } := D.core5
  let { SUM_ADD_NUMSEG, SUM_CLAUSES, SUM_CONST, SUM_EQ, SUM_IMAGE, SUM_LE_NUMSEG, SUM_LT,
        o_DEF, .. } := D.core6
  let { BASIS_COMPONENT, BASIS_EXPANSION_UNIQUE, BASIS_INJ, BASIS_NONZERO, COMPONENT_LE_NORM,
        DIST_REFL, DOT_BASIS, .. } := D.vec1
  let { NORM_BASIS, .. } := D.vec2
  let { NORM_MUL, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_LID, VECTOR_MUL_COMPONENT, VECTOR_MUL_RZERO,
        VECTOR_SUB_COMPONENT, VSUM_CLAUSES, VSUM_EQ, VSUM_IMAGE, dist, .. } := D.vec4
  let { IN_BALL, IN_INTERIOR, .. } := D.top4
  let { CONVEX_HULL_FINITE, .. } := BCVE
  -- @@SCOPE END

  let SIMPLEX_EXPLICIT ← prove
   r"!s:real^N->bool.
          FINITE s /\ ~(vec 0 IN s)
          ==> convex hull (vec 0 INSERT s) =
              { y | ?u. (!x. x IN s ==> &0 <= u x) /\
                        sum s u <= &1 /\
                        vsum s (\x. u x % x) = y}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [CONVEX_HULL_FINITE, FINITE_INSERT] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"y:real^N") THEN
    ASM_SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, IN_INSERT] THEN
    REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
    EQ_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC) THENL
     [EXISTS_TAC (← q r"u:real^N->real") THEN ASM_SIMP_TAC [REAL_LE_REFL] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N")) THEN REWRITE_TAC [] THEN
      ASM_REAL_ARITH_TAC,
      EXISTS_TAC (← q r"\x:real^N. if x = vec 0 then &1 - sum (s:real^N->bool) u
                             else u(x)") THEN
      ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
        ASM_REWRITE_TAC [REAL_SUB_LE],
        MATCH_MP_TAC (← REAL_ARITH (← q r"s = t ==> &1 - s + t = &1")) THEN
        MATCH_MP_TAC SUM_EQ THEN ASM_MESON_TAC [],
        FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC VSUM_EQ THEN ASM_MESON_TAC []]])

  let STD_SIMPLEX ← prove
   r"convex hull (vec 0 INSERT { basis i | 1 <= i /\ i <= dimindex(:N)}) =
          {x:real^N | (!i. 1 <= i /\ i <= dimindex(:N) ==> &0 <= x$i) /\
                      sum (1..dimindex(:N)) (\i. x$i) <= &1 }"
   (W (MP_TAC o PART_MATCH (lhs o rand) SIMPLEX_EXPLICIT o lhs o snd) THEN ANTS_TAC THENL
     [REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IN_NUMSEG] THEN
      SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, IN_IMAGE] THEN
      REWRITE_TAC [IN_NUMSEG] THEN MESON_TAC [BASIS_NONZERO],
      ALL_TAC] THEN
    DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [EXTENSION] THEN
    ONCE_REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN
    REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IN_NUMSEG] THEN
    SUBGOAL_THEN (← q r"!u. sum (IMAGE (basis:num->real^N) (1..dimindex(:N))) u =
                          sum (1..dimindex(:N)) (u o basis)")
     (fun th => REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN MATCH_MP_TAC SUM_IMAGE THEN REWRITE_TAC [IN_NUMSEG] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, BASIS_INJ],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!u. vsum (IMAGE (basis:num->real^N) (1..dimindex(:N))) u =
                          vsum (1..dimindex(:N)) ((u:real^N->real^N) o basis)")
     (fun th => REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN MATCH_MP_TAC VSUM_IMAGE THEN REWRITE_TAC [IN_NUMSEG] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, BASIS_INJ, FINITE_NUMSEG],
      ALL_TAC] THEN
    REWRITE_TAC [o_DEF, BASIS_EXPANSION_UNIQUE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_NUMSEG] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->real") STRIP_ASSUME_TAC) THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x <= &1 ==> x = y ==> y <= &1"))) THEN
      MATCH_MP_TAC SUM_EQ THEN ASM_SIMP_TAC [IN_NUMSEG],
      STRIP_TAC THEN EXISTS_TAC (← q r"\y:real^N. y dot x") THEN
      ASM_SIMP_TAC [DOT_BASIS]])

  let INTERIOR_STD_SIMPLEX ← prove
   r"interior
      (convex hull (vec 0 INSERT { basis i | 1 <= i /\ i <= dimindex(:N)})) =
          {x:real^N | (!i. 1 <= i /\ i <= dimindex(:N) ==> &0 < x$i) /\
                      sum (1..dimindex(:N)) (\i. x$i) < &1 }"
   (REWRITE_TAC [EXTENSION, IN_INTERIOR, IN_ELIM_THM, STD_SIMPLEX] THEN
    REWRITE_TAC [SUBSET, IN_BALL, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN REWRITE_TAC [DIST_REFL] THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_SIMP_TAC [REAL_LT_LE] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x - (e / &2) % basis k:real^N")) THEN
        REWRITE_TAC [← NORM_ARITH (← q r"dist(x,x - e) = norm(e)"), NORM_MUL] THEN
        ASM_SIMP_TAC [NORM_BASIS, ← REAL_ARITH (← q r"&0 < e ==> abs(e / &2) * &1 < e"),
                      VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"k:num") o CONJUNCT1) THEN ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [BASIS_COMPONENT] THEN UNDISCH_TAC (← q r"&0 < e") THEN
        REAL_ARITH_TAC,
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x + (e / &2) % basis 1:real^N")) THEN
        REWRITE_TAC [← NORM_ARITH (← q r"dist(x,x + e) = norm(e)"), NORM_MUL] THEN
        ASM_SIMP_TAC [NORM_BASIS, LE_REFL, DIMINDEX_GE_1] THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> abs(e / &2) * &1 < e")] THEN
        DISCH_THEN (MP_TAC o CONJUNCT2) THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"x < y ==> y <= &1 ==> ~(x = &1)")) THEN
        MATCH_MP_TAC SUM_LT THEN REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b) /\ c <=> ~(a /\ b ==> ~c)")] THEN
        SIMP_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                  BASIS_COMPONENT] THEN
        CONJ_TAC THENL
         [GEN_TAC THEN COND_CASES_TAC,
          EXISTS_TAC (← q r"1") THEN REWRITE_TAC [LE_REFL, DIMINDEX_GE_1]] THEN
        ASM_REAL_ARITH_TAC],
      STRIP_TAC THEN
      EXISTS_TAC
       (← q r"min (inf(IMAGE (\i. (x:real^N)$i) (1..dimindex(:N))))
            ((&1 - sum (1..dimindex(:N)) (\i. x$i)) / &(dimindex(:N)))") THEN
      ASM_SIMP_TAC [REAL_LT_MIN] THEN
      SIMP_TAC [REAL_LT_INF_FINITE, FINITE_IMAGE, FINITE_NUMSEG,
                IMAGE_EQ_EMPTY, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [REAL_LT_RDIV_EQ, REAL_OF_NUM_LT,
                    ← ARITH_RULE (← q r"0 < x <=> 1 <= x"), DIMINDEX_GE_1] THEN
      ASM_REWRITE_TAC [IN_NUMSEG, REAL_MUL_LZERO, REAL_SUB_LT] THEN
      REPEAT (POP_ASSUM (K ALL_TAC : thm → tactic)) THEN X_GEN_TAC (← q r"y:real^N") THEN
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k:num") THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"abs(xk - yk) <= d ==> d < xk ==> &0 <= yk")),
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o RAND_CONV o RAND_CONV)
         [← GSYM CARD_NUMSEG_1] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        SIMP_TAC [← GSYM SUM_CONST, FINITE_NUMSEG] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"s2 <= s0 + s1 ==> s0 < &1 - s1 ==> s2 <= &1")) THEN
        REWRITE_TAC [← GSYM SUM_ADD_NUMSEG] THEN
        MATCH_MP_TAC SUM_LE_NUMSEG THEN REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"abs(y - x) <= z ==> x <= z + y"))] THEN
      ASM_SIMP_TAC [← GSYM VECTOR_SUB_COMPONENT, dist, COMPONENT_LE_NORM]])

  return { SIMPLEX_EXPLICIT, STD_SIMPLEX, INTERIOR_STD_SIMPLEX }

/- ------------------------------------------------------------------------- -/
/- Barycentres.                                                              -/
/- (convex.ml 17589-17672)                                                   -/
/- ------------------------------------------------------------------------- -/

structure BAR where
  barycentre : thm
  BARYCENTRE_0 : thm
  BARYCENTRE_1 : thm
  BARYCENTRE_2 : thm
  BARYCENTRE_IN_RELATIVE_INTERIOR : thm
  BARYCENTRE_IN_CONVEX_HULL : thm
  BARYCENTRE_IN_AFFINE_HULL : thm
  BARYCENTRE_TRANSLATION : thm
  BARYCENTRE_LINEAR_IMAGE : thm
  BARYCENTRE_NOT_IN_SET : thm
  deriving Inhabited

@[nospecialize]
def setupBAR [HolBase] (D : ConvexDeps) (BCLH : CLH) (BADC : ADC) (BRIA : RIA) (BEXA : EXA)
    (BEXB : EXB) : ExceptT String IO BAR := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_RULE, NUM_REDUCE_CONV,
        VECTOR_ARITH, add_linear_invariants, add_translation_invariants, .. } := D
  let { CARD_CLAUSES, CARD_EQ_0, CARD_IMAGE_INJ, CARD_SING, FINITE_EMPTY, FINITE_IMAGE_INJ_EQ,
        FINITE_INSERT, FINITE_RULES, FINITE_SING, .. } := D.core1
  let { IMAGE_CLAUSES, IMAGE_EQ_EMPTY, INJECTIVE_ALT, .. } := D.core2
  let { IN_ELIM_THM, IN_SING, NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_INV_1, REAL_LT_INV_EQ, .. } := D.core4
  let { REAL_MUL_RINV, REAL_OF_NUM_EQ, REAL_OF_NUM_LT, SUBSET, .. } := D.core5
  let { SUM_CONST, o_DEF, .. } := D.core6
  let { LINEAR_0, LINEAR_CMUL, LINEAR_VSUM, .. } := D.vec2
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_RID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VSUM_ADD,
        VSUM_CLAUSES, VSUM_CONST, VSUM_EQ, VSUM_IMAGE, VSUM_SING, midpoint, .. } := D.vec4
  let { CONVEX_HULL_SUBSET_AFFINE_HULL, .. } := BCLH
  let { AFFINE_INDEPENDENT_IFF_CARD, .. } := BADC
  let { RELATIVE_INTERIOR_SUBSET, .. } := BRIA
  let { EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL_MINIMAL, .. } := BEXA
  let { DISJOINT_RELATIVE_INTERIOR_CONVEX_HULL, .. } := BEXB
  -- @@SCOPE END

  let barycentre ← new_definition
   r"barycentre s =
       if FINITE s then vsum s (\x. inv(&(CARD s)) % x) else vec 0"

  let BARYCENTRE_0 ← prove
   r"barycentre {} = vec 0"
   (REWRITE_TAC [barycentre, FINITE_EMPTY, VSUM_CLAUSES])

  let BARYCENTRE_1 ← prove
   r"!a:real^N. barycentre {a} = a"
   (REWRITE_TAC [barycentre, VSUM_SING, FINITE_SING, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [CARD_SING, REAL_INV_1, VECTOR_MUL_LID])

  let BARYCENTRE_2 ← prove
   r"!a b:real^N. barycentre {a,b} = midpoint(a,b)"
   (SIMP_TAC [barycentre, FINITE_INSERT, FINITE_EMPTY, NOT_INSERT_EMPTY,
              VSUM_CLAUSES, NOT_IN_EMPTY, IN_SING, midpoint] THEN
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [CARD_CLAUSES, FINITE_RULES, IN_SING, NOT_IN_EMPTY] THEN
    CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC (fun t => VECTOR_ARITH t))

  let BARYCENTRE_IN_RELATIVE_INTERIOR ← prove
   r"!s:real^N->bool.
          FINITE s /\ ~(s = {})
          ==> (barycentre s) IN relative_interior(convex hull s)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MATCH_MP_TAC o  REWRITE_RULE [SUBSET] o
      MATCH_MP EXPLICIT_SUBSET_RELATIVE_INTERIOR_CONVEX_HULL_MINIMAL) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"\x:real^N. inv(&(CARD(s:real^N->bool)))") THEN
    ASM_SIMP_TAC [SUM_CONST, barycentre, REAL_LT_INV_EQ] THEN
    REWRITE_TAC [REAL_OF_NUM_LT, ← ARITH_RULE (← q r"0 < n <=> ~(n = 0)")] THEN
    ASM_SIMP_TAC [CARD_EQ_0, REAL_OF_NUM_EQ, REAL_MUL_RINV])

  let BARYCENTRE_IN_CONVEX_HULL ← prove
   r"!s:real^N->bool.
          FINITE s /\ ~(s = {}) ==> (barycentre s) IN (convex hull s)"
   (MESON_TAC [BARYCENTRE_IN_RELATIVE_INTERIOR, SUBSET,
               RELATIVE_INTERIOR_SUBSET])

  let BARYCENTRE_IN_AFFINE_HULL ← prove
   r"!s:real^N->bool.
          FINITE s /\ ~(s = {}) ==> (barycentre s) IN (affine hull s)"
   (MESON_TAC [BARYCENTRE_IN_CONVEX_HULL, SUBSET,
               CONVEX_HULL_SUBSET_AFFINE_HULL])

  let BARYCENTRE_TRANSLATION ← prove
   r"!a:real^N s.
          barycentre (IMAGE (\x. a + x) s) =
          (if FINITE s /\ ~(s = {}) then a else vec 0) + barycentre s"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [BARYCENTRE_0, IMAGE_CLAUSES, VECTOR_ADD_RID] THEN
    REWRITE_TAC [barycentre] THEN
    SIMP_TAC [FINITE_IMAGE_INJ_EQ, CARD_IMAGE_INJ, VSUM_IMAGE, ← VECTOR_ARITH
     (← q r"a + x:real^N = a + y <=> x = y")] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [VECTOR_ADD_RID] THEN
    ASM_SIMP_TAC [o_DEF, VECTOR_ADD_LDISTRIB, VSUM_ADD, VSUM_CONST] THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, CARD_EQ_0, REAL_OF_NUM_EQ,
                  VECTOR_MUL_LID])

  add_translation_invariants [BARYCENTRE_TRANSLATION]

  let BARYCENTRE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
          linear f /\ (!x y. f x = f y ==> x = y)
          ==> barycentre (IMAGE f s) = f(barycentre s)"
   (REWRITE_TAC [INJECTIVE_ALT] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [barycentre, IMAGE_EQ_EMPTY, FINITE_IMAGE_INJ_EQ,
                  CARD_IMAGE_INJ, VSUM_IMAGE] THEN
    COND_CASES_TAC THENL [ALL_TAC, ASM_MESON_TAC [LINEAR_0]] THEN
    ASM_SIMP_TAC [LINEAR_VSUM, o_DEF] THEN MATCH_MP_TAC VSUM_EQ THEN
    ASM_MESON_TAC [LINEAR_CMUL])

  add_linear_invariants [BARYCENTRE_LINEAR_IMAGE]

  let BARYCENTRE_NOT_IN_SET ← prove
   r"!s:real^N->bool.
          ~affine_dependent s /\ ~(?a. s = {a}) ==> ~(barycentre s IN s)"
   (GEN_TAC THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP DISJOINT_RELATIVE_INTERIOR_CONVEX_HULL) THEN
    MATCH_MP_TAC (← SET_RULE (← q r"b IN i ==> i INTER s = {} ==> ~(b IN s)")) THEN
    MATCH_MP_TAC BARYCENTRE_IN_RELATIVE_INTERIOR THEN
    ASM_MESON_TAC [AFFINE_INDEPENDENT_IFF_CARD])

  return { barycentre, BARYCENTRE_0, BARYCENTRE_1, BARYCENTRE_2,
           BARYCENTRE_IN_RELATIVE_INTERIOR, BARYCENTRE_IN_CONVEX_HULL,
           BARYCENTRE_IN_AFFINE_HULL, BARYCENTRE_TRANSLATION, BARYCENTRE_LINEAR_IMAGE,
           BARYCENTRE_NOT_IN_SET }

/- ------------------------------------------------------------------------- -/
/- Construction of regular polyhedra with given parameters.                  -/
/- (convex.ml 17678-17835)                                                   -/
/- ------------------------------------------------------------------------- -/

structure RPA where
  REGULAR_POLYTOPE_DIST_BARYCENTRE : thm
  REGULAR_POLYTOPE_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupRPA [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFD : AFD) (BCLH : CLH) (BAFI : AFI)
    (BADA : ADA) (BADB : ADB) (BBAR : BAR) : ExceptT String IO RPA := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_INT_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, INT_ARITH, INT_ARITH_TAC,
        MESON_TAC, REAL_ARITH, REAL_FIELD, REAL_RING, SET_TAC, HAS_SIZE_CONV,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, GEOM_ORIGIN_TAC, .. } := D
  let { ARITH, CARD_CLAUSES, CARD_DELETE, CARD_EQ_0, CARD_SING, DELETE, EMPTY_SUBSET,
        EQ_TRANS, FINITE_DELETE, FINITE_INSERT, .. } := D.core1
  let { HAS_SIZE, HAS_SIZE_0, INSERT_SUBSET, INT_OF_NUM_SUC, .. } := D.core2
  let { IN_SING, LE_1, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, PAIRWISE_INSERT, PSUBSET, REAL_ABS_INV,
        REAL_ABS_REFL, REAL_ADD_LID, REAL_DIV_EQ_0, .. } := D.core3
  let { REAL_ENTIRE, REAL_INV_EQ_0, REAL_LE_ADD, REAL_LE_DIV, REAL_LE_MUL, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ,
        REAL_OF_NUM_LE, REAL_OF_NUM_SUB, REAL_POS, REAL_POW_MUL, REAL_SUB_LE, SING_SUBSET,
        SQRT_0, SQRT_EQ_0, SQRT_LE_0, SQRT_POW2, SQRT_POW_2, SUBSET, .. } := D.core5
  let { SUM_0, SUM_ADD, SUM_CASES, SUM_CONST, SUM_EQ, SUM_LMUL, SUM_SUB, UNWIND_THM2,
        pairwise, .. } := D.core6
  let { HULL_HULL, HULL_INC, HULL_MONO, .. } := D.misc
  let { DIST_0, DIST_REFL, DOT_RSUM, DOT_RZERO, .. } := D.vec1
  let { NORM_ADD_PYTHAGOREAN, NORM_EQ_0, NORM_EQ_SQUARE, .. } := D.vec2
  let { NORM_MUL, NORM_NEG, NORM_POW_2, ORTHOGONAL_CLAUSES, ORTHOGONAL_MUL, ORTHOGONAL_REFL,
        ORTHOGONAL_TO_SUBSPACE_EXISTS_GEN, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_SUB, VSUM_LMUL, dist, .. } :=
    D.vec4
  let { AFFINE_AFFINE_HULL, IN_AFFINE_ADD_MUL, .. } := BAFF
  let { AFFINE_INDEPENDENT_EMPTY, AFFINE_INDEPENDENT_1, .. } := BAFD
  let { AFFINE_HULL_EQ_SPAN, .. } := BCLH
  let { AFFINE_INDEPENDENT_INSERT, .. } := BAFI
  let { AFF_DIM_EMPTY, AFF_DIM_AFFINE_HULL, .. } := BADA
  let { AFF_DIM_LE_CARD, .. } := BADB
  let { barycentre, BARYCENTRE_1, BARYCENTRE_IN_AFFINE_HULL, .. } := BBAR
  -- @@SCOPE END

  let REGULAR_POLYTOPE_DIST_BARYCENTRE ← prove
   r"!s:real^N->bool n r.
          s HAS_SIZE n /\
          (!x y. x IN s /\ y IN s /\ ~(x = y) ==> dist(x,y) = r)
          ==> !x. x IN s
                  ==> dist(barycentre s,x) = sqrt((&n - &1) / (&2 * &n)) * r"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"&0 <= r") THENL
     [POP_ASSUM MP_TAC,
      ASM_SIMP_TAC [← NORM_ARITH (← q r"~(&0 <= r) ==> ~(dist(x,y) = r)")] THEN
      ASM_CASES_TAC (← q r"(?a:real^N. s = {a})") THENL [ALL_TAC, ASM SET_TAC []] THEN
      FIRST_X_ASSUM (CHOOSE_THEN SUBST1_TAC) THEN
      REWRITE_TAC [HAS_SIZE, CARD_SING] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_SIMP_TAC [BARYCENTRE_1, IN_SING, SQRT_0, DIST_REFL,
                    REAL_MUL_LZERO]] THEN
    ABBREV_TAC (← q r"z:real^N = barycentre s") THEN
    POP_ASSUM MP_TAC THEN GEOM_ORIGIN_TAC (← q r"z:real^N") THEN
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"FINITE(s:real^N->bool)") THEN
    ASM_REWRITE_TAC [HAS_SIZE] THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
    ASM_SIMP_TAC [barycentre] THEN
    DISCH_THEN (fun th => DISCH_TAC THEN STRIP_TAC THEN MP_TAC th) THEN
    ASM_CASES_TAC (← q r"n = 0") THENL [ASM_MESON_TAC [CARD_EQ_0], ALL_TAC] THEN
    ASM_SIMP_TAC [VSUM_LMUL, VECTOR_MUL_EQ_0, REAL_INV_EQ_0, REAL_OF_NUM_EQ] THEN
    STRIP_TAC THEN SUBGOAL_THEN
     (← q r"!x. x IN s
          ==> sum s (\y:real^N. dist(x,y) pow 2) = (&n - &1) * r pow 2")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      TRANS_TAC EQ_TRANS (← q r"sum s (\y:real^N. if y = x then &0 else r pow 2)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_EQ THEN REWRITE_TAC [] THEN
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [DIST_REFL] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV,
        ASM_SIMP_TAC [SUM_CASES, ← GSYM DELETE, SUM_0, SUM_CONST, FINITE_DELETE,
                      REAL_ADD_LID, CARD_DELETE, ← GSYM REAL_OF_NUM_SUB, LE_1]],
        REWRITE_TAC [DIST_0] THEN REWRITE_TAC [dist, NORM_POW_2] THEN
        REWRITE_TAC [← VECTOR_ARITH
         (← q r"(x - y:real^N) dot (x - y) = x dot x - &2 * x dot y + y dot y")] THEN
        ASM_SIMP_TAC [SUM_SUB, SUM_ADD, SUM_CONST, SUM_LMUL] THEN
        ASM_SIMP_TAC [← GSYM DOT_RSUM, DOT_RZERO, ← REAL_ARITH
         (← q r"x - &2 * &0 + y = x + y")] THEN
        DISCH_THEN (LABEL_TAC "*")] THEN
    ASM_REWRITE_TAC [NORM_EQ_SQUARE] THEN
    SUBGOAL_THEN (← q r"sum s (\x. &n * (x dot x) + sum s (\y. y dot y)) =
                  sum s (\x:real^N. (&n - &1) * r pow 2)")
    MP_TAC THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [SUM_ADD, SUM_LMUL, SUM_CONST, REAL_OF_NUM_EQ, ← REAL_RING
     (← q r"n * s + n * s = (n - &1) * n * r <=> n = &0 \/ s = (n - &1) * r / &2")] THEN
    DISCH_TAC THEN REMOVE_THEN "*" MP_TAC THEN
    ASM_SIMP_TAC [REAL_OF_NUM_EQ, ← REAL_FIELD
    (← q r"~(n = &0) ==> (n * x + a * r / &2 = a * r <=> x = (a / (&2 * n)) * r)")] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN REWRITE_TAC [REAL_POW_MUL] THEN
    REWRITE_TAC [← REAL_RING (← q r"x * r:real = y * r <=> y = x \/ r = &0")] THEN
    REWRITE_TAC [SQRT_POW2] THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [SQRT_LE_0], ALL_TAC] THEN
    ASM_SIMP_TAC [REAL_LE_DIV, REAL_LE_MUL, REAL_POS, REAL_SUB_LE, REAL_OF_NUM_LE,
                  LE_1])

  let REGULAR_POLYTOPE_EXISTS ← prove
   r"!r s:real^N->bool n.
         &n <= aff_dim s + &1 /\ &0 < r
         ==> ?k. k HAS_SIZE n /\ ~affine_dependent k /\ k SUBSET affine hull s /\
                 (!x y. x IN k /\ y IN k /\ ~(x = y) ==> dist(x,y) = r)"
   (GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THEN
    REWRITE_TAC [HAS_SIZE_0, UNWIND_THM2, AFFINE_INDEPENDENT_EMPTY] THEN
    REWRITE_TAC [EMPTY_SUBSET, NOT_IN_EMPTY, ← GSYM INT_OF_NUM_SUC] THEN
    DISCH_THEN (fun th => POP_ASSUM MP_TAC THEN STRIP_ASSUME_TAC th) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM_INT_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^N->bool") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"n = 0") THENL
     [UNDISCH_TAC (← q r"&n + &1 <= aff_dim(s:real^N->bool) + &1") THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [AFF_DIM_EMPTY] THENL [INT_ARITH_TAC, ALL_TAC] THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN EXISTS_TAC (← q r"{a:real^N}") THEN
      ASM_SIMP_TAC [ARITH, AFFINE_INDEPENDENT_1, SING_SUBSET, HULL_INC] THEN
      REWRITE_TAC [← ExceptT.mk (HAS_SIZE_CONV (← q r"s HAS_SIZE 1"))] THEN SET_TAC [],
      ALL_TAC] THEN
    POP_ASSUM_LIST (MP_TAC o end_itlist CONJ o HolLight.rev) THEN
    ABBREV_TAC (← q r"z:real^N = barycentre k") THEN
    POP_ASSUM MP_TAC THEN GEOM_ORIGIN_TAC (← q r"z:real^N") THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"FINITE(k:real^N->bool)") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [HAS_SIZE]] THEN
    ASM_CASES_TAC (← q r"k:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [HAS_SIZE, CARD_CLAUSES] THEN MESON_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a + v <=> x = v")] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"k:real^N->bool", ← q r"n:num", ← q r"r:real"]
          REGULAR_POLYTOPE_DIST_BARYCENTRE) THEN
    ASM_REWRITE_TAC [DIST_0] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"k:real^N->bool", ← q r"s:real^N->bool"]
          ORTHOGONAL_TO_SUBSPACE_EXISTS_GEN) THEN
    MP_TAC (← ISPEC (← q r"k:real^N->bool") BARYCENTRE_IN_AFFINE_HULL) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(vec 0:real^N) IN affine hull s") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, HULL_HULL, HULL_MONO], ALL_TAC] THEN
    ASM_SIMP_TAC [← GSYM AFFINE_HULL_EQ_SPAN] THEN ANTS_TAC THENL
     [REWRITE_TAC [PSUBSET] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [HULL_HULL, HULL_MONO], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"aff_dim:(real^N->bool)->int")) THEN
      REWRITE_TAC [AFF_DIM_AFFINE_HULL] THEN FIRST_X_ASSUM (MATCH_MP_TAC o
       MATCH_MP (← INT_ARITH (← q r"n + &1:int <= s + &1 ==> k <= n - &1
                  ==> ~(k = s)"))) THEN
      ASM_MESON_TAC [AFF_DIM_LE_CARD, HAS_SIZE],
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC)] THEN
    ABBREV_TAC
     (← q r"b = (sqrt((&n + &1) / (&2 * &n)) * r) % inv(norm a) % a:real^N") THEN
    EXISTS_TAC (← q r"(b:real^N) INSERT k") THEN
    SUBGOAL_THEN (← q r"norm(b:real^N) = sqrt((&n + &1) / (&2 * &n)) * r")
    ASSUME_TAC THENL
     [EXPAND_TAC "b" THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, NORM_EQ_0, REAL_MUL_RID] THEN
      REWRITE_TAC [REAL_ABS_REFL] THEN MATCH_MP_TAC REAL_LE_MUL THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, SQRT_LE_0] THEN
      SIMP_TAC [REAL_LE_DIV, REAL_LE_MUL, REAL_LE_ADD, REAL_POS],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(b:real^N = vec 0)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [← GSYM NORM_EQ_0, REAL_ENTIRE, REAL_LT_IMP_NZ] THEN
      REWRITE_TAC [SQRT_EQ_0, REAL_DIV_EQ_0] THEN
      REWRITE_TAC [REAL_ENTIRE, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ] THEN
      ASM_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!y:real^N. y IN affine hull k ==> orthogonal b y")
    ASSUME_TAC THENL
     [EXPAND_TAC "b" THEN REWRITE_TAC [ORTHOGONAL_MUL] THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(b:real^N) IN affine hull s") ASSUME_TAC THENL
     [SUBST1_TAC (← VECTOR_ARITH (← q r"b:real^N = vec 0 + b")) THEN
      EXPAND_TAC "b" THEN REWRITE_TAC [VECTOR_MUL_ASSOC] THEN
      MATCH_MP_TAC IN_AFFINE_ADD_MUL THEN
      ASM_REWRITE_TAC [AFFINE_AFFINE_HULL, VECTOR_ADD_LID],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~((b:real^N) IN affine hull k)") ASSUME_TAC THENL
     [ASM_MESON_TAC [ORTHOGONAL_REFL], ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
      ASM_SIMP_TAC [HAS_SIZE, FINITE_INSERT, CARD_CLAUSES] THEN
      ASM_MESON_TAC [HULL_INC],
      MATCH_MP_TAC AFFINE_INDEPENDENT_INSERT THEN ASM_REWRITE_TAC [],
      ASM_REWRITE_TAC [INSERT_SUBSET],
      REWRITE_TAC [← GSYM pairwise, PAIRWISE_INSERT] THEN
      ASM_REWRITE_TAC [pairwise, ← NORM_ARITH
       (← q r"dist(b:real^N,y) = r /\ dist(y,b) = r <=> dist(b,y) = r")] THEN
      X_GEN_TAC (← q r"c:real^N") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [NORM_EQ_SQUARE, dist, REAL_LT_IMP_LE, ← GSYM NORM_POW_2] THEN
      MP_TAC (← ISPECL [← q r"b:real^N", ← q r"--c:real^N"] NORM_ADD_PYTHAGOREAN) THEN
      ASM_SIMP_TAC [ORTHOGONAL_CLAUSES, HULL_INC] THEN
      ASM_SIMP_TAC [← GSYM VECTOR_SUB, NORM_NEG] THEN DISCH_THEN SUBST1_TAC THEN
      ASM_SIMP_TAC [SQRT_POW_2, REAL_LE_DIV, REAL_LE_MUL, REAL_POS, REAL_LE_ADD,
         REAL_LT_IMP_LE, REAL_POW_MUL, REAL_SUB_LE, REAL_OF_NUM_LE, LE_1] THEN
      UNDISCH_TAC (← q r"~(n = 0)") THEN REWRITE_TAC [← GSYM REAL_OF_NUM_EQ] THEN
      CONV_TAC (fun t => REAL_FIELD t)])

  return { REGULAR_POLYTOPE_DIST_BARYCENTRE, REGULAR_POLYTOPE_EXISTS }

/- ------------------------------------------------------------------------- -/
/- Construction of regular polyhedra with given parameters, continued.       -/
/- (convex.ml 17836-17891)                                                   -/
/- ------------------------------------------------------------------------- -/

structure RPB where
  REGULAR_POLYTOPE_WITH_BARYCENTRE_EXISTS_ALT : thm
  REGULAR_POLYTOPE_WITH_BARYCENTRE_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupRPB [HolBase] (D : ConvexDeps) (BAFF : AFF) (BAFD : AFD) (BBAR : BAR) (BRPA : RPA) :
    ExceptT String IO RPB := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_FIELD, REAL_RING,
        VECTOR_ARITH, NORM_ARITH, .. } := D
  let { CARD_EQ_0, CONJ_ASSOC, .. } := D.core1
  let { FORALL_IN_IMAGE, HAS_SIZE, HAS_SIZE_IMAGE_INJ_EQ, IMP_CONJ, .. } := D.core2
  let { MONO_EXISTS, .. } := D.core3
  let { REAL_LT_DIV, REAL_LT_MUL, .. } := D.core4
  let { REAL_OF_NUM_LT, RIGHT_FORALL_IMP_THM, SQRT_1, SQRT_LT_0, SQRT_MUL, SUBSET, .. } :=
    D.core5
  let { HULL_HULL, HULL_MONO, .. } := D.misc
  let { AFFINE_AFFINE_HULL, IN_AFFINE_MUL_DIFF_ADD, .. } := BAFF
  let { AFFINE_DEPENDENT_TRANSLATION_EQ, .. } := BAFD
  let { BARYCENTRE_IN_AFFINE_HULL, BARYCENTRE_TRANSLATION, .. } := BBAR
  let { REGULAR_POLYTOPE_DIST_BARYCENTRE, REGULAR_POLYTOPE_EXISTS, .. } := BRPA
  -- @@SCOPE END

  let REGULAR_POLYTOPE_WITH_BARYCENTRE_EXISTS_ALT ← prove
   r"!r s:real^N->bool a n.
        &n <= aff_dim s + &1 /\ &0 < r /\ a IN affine hull s /\ ~(n = 0)
        ==> ?k. k HAS_SIZE n /\ ~affine_dependent k /\ k SUBSET affine hull s /\
                barycentre k = a /\
                (!x y. x IN k /\ y IN k /\ ~(x = y) ==> dist(x,y) = r) /\
                (!x. x IN k ==> dist(a,x) = sqrt((&n - &1) / (&2 * &n)) * r)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"r:real", ← q r"s:real^N->bool", ← q r"n:num"]
          REGULAR_POLYTOPE_EXISTS) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^N->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (\x:real^N. (a - barycentre k) + x) k") THEN
    REWRITE_TAC [CONJ_ASSOC] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [REGULAR_POLYTOPE_DIST_BARYCENTRE]] THEN
    ASM_REWRITE_TAC [AFFINE_DEPENDENT_TRANSLATION_EQ] THEN
    ASM_SIMP_TAC [HAS_SIZE_IMAGE_INJ_EQ,
                  ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
    ASM_CASES_TAC (← q r"k:real^N->bool = {}") THENL
     [ASM_MESON_TAC [CARD_EQ_0], ALL_TAC] THEN
    ASM_REWRITE_TAC [BARYCENTRE_TRANSLATION, ← VECTOR_ARITH
     (← q r"(a - b) + b:real^N = a")] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
    ASM_SIMP_TAC [← NORM_ARITH (← q r"dist(a + x:real^N,a + y) = dist(x,y)")] THEN
    REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"x - y:real^N = &1 % (x - y)")] THEN
    MATCH_MP_TAC IN_AFFINE_MUL_DIFF_ADD THEN
    ASM_REWRITE_TAC [AFFINE_AFFINE_HULL] THEN
    ASM_MESON_TAC [BARYCENTRE_IN_AFFINE_HULL, SUBSET, HULL_MONO, HULL_HULL])

  let REGULAR_POLYTOPE_WITH_BARYCENTRE_EXISTS ← prove
   r"!r s:real^N->bool a n.
        &n <= aff_dim s + &1 /\ &0 < r /\ a IN affine hull s /\ 1 < n
        ==> ?k. k HAS_SIZE n /\ ~affine_dependent k /\ k SUBSET affine hull s /\
                barycentre k = a /\
                (!x. x IN k ==> dist(a,x) = r) /\
                (!x y. x IN k /\ y IN k /\ ~(x = y)
                       ==> dist(x,y) = sqrt((&2 * &n) / (&n - &1)) * r)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"sqrt((&2 * &n) / (&n - &1)) * r", ← q r"s:real^N->bool", ← q r"a:real^N",
      ← q r"n:num"]
     REGULAR_POLYTOPE_WITH_BARYCENTRE_EXISTS_ALT) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM_ARITH_TAC] THEN
      MATCH_MP_TAC REAL_LT_MUL THEN ASM_REWRITE_TAC [SQRT_LT_0] THEN
      MATCH_MP_TAC REAL_LT_DIV THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LT]) THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN STRIP_TAC THEN
      ASM_SIMP_TAC [] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_RING (← q r"a * b = &1 ==> a * b * y = y")) THEN
      REWRITE_TAC [← GSYM SQRT_MUL] THEN
      MATCH_MP_TAC (← MESON [SQRT_1] (← q r"x = &1 ==> sqrt x = &1")) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_OF_NUM_LT]) THEN
      CONV_TAC (fun t => REAL_FIELD t)])

  return { REGULAR_POLYTOPE_WITH_BARYCENTRE_EXISTS_ALT, REGULAR_POLYTOPE_WITH_BARYCENTRE_EXISTS }

