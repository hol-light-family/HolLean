                    ← ARITH_RULE (← q r"2 <= n ==> 1 <= n /\ ~(n = 1)"), ARITH] THEN
          REWRITE_TAC [REAL_MUL_RZERO, REAL_SUB_RZERO, REAL_LT_RADD] THEN
          REWRITE_TAC [← GSYM REAL_POW_2, ← GSYM REAL_LT_SQUARE_ABS] THEN
          MATCH_MP_TAC (← REAL_ARITH
