        ASM_SIMP_TAC [SUM_CONST, SUM_RMUL, SUM_SUB] THEN
        REWRITE_TAC [REAL_OF_NUM_MUL, MULT_CLAUSES] THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [REAL_MUL_SYM] THEN
