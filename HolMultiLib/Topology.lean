@[nospecialize]
def setupEUC [HolBase] (D : TopologyDeps) : ExceptT String IO EUC := do
  -- @@SCOPE BEGIN
  let { new_definition, MESON_TAC, SET_TAC, .. } := D
  let { EQ_IMP, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FUN_EQ_THM, INTER_UNIV, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIONS, IN_UNIV, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LT_01, .. } := D.core4
  let { SUBSET, SUBSET_UNIV, .. } := D.core5
  let { UNIONS_GSPEC, .. } := D.core6
  let { relative_to, .. } := D.misc
  let { DIST_EQ_0, DIST_POS_LE, DIST_SYM, DIST_TRIANGLE, .. } := D.vec1
  let { HAUSDORFF_IMP_T1_SPACE, HAUSDORFF_SPACE_MTOPOLOGY, IN_MBALL, KC_SPACE_MTOPOLOGY,
        K_SPACE_MTOPOLOGY, MDIST, METRIZABLE_SPACE_MTOPOLOGY, MSPACE, .. } := D.met2
  let { OPEN_IN_INTER, OPEN_IN_MTOPOLOGY, OPEN_IN_RELATIVE_TO, OPEN_IN_SUBTOPOLOGY_REFL,
        REGULAR_SPACE_MTOPOLOGY, SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_FINITE, TOPOLOGY_EQ,
        TOPSPACE_SUBTOPOLOGY, is_metric_space, topology_tybij, topspace, .. } := D.met3
  -- @@SCOPE END

  D.prioritize_real

  let open_def ← new_definition
   r"open s <=> !x. x IN s ==> ?e. &0 < e /\ !x'. dist(x',x) < e ==> x' IN s"

  let euclidean ← new_definition
   r"euclidean = topology open"

  let euclidean_metric ← new_definition
   r"euclidean_metric = metric ((:real^N), dist)"

  let EUCLIDEAN_METRIC ← prove
   r"mdist (euclidean_metric:(real^N)metric) = dist /\
   mspace euclidean_metric = (:real^N)"
   (SUBGOAL_THEN (← q r"is_metric_space ((:real^N),dist)") MP_TAC THENL
    [REWRITE_TAC [is_metric_space, IN_UNIV, DIST_POS_LE, DIST_EQ_0,
                  DIST_SYM, DIST_TRIANGLE],
     SIMP_TAC [euclidean_metric, MDIST, MSPACE]])

  let OPEN_IN_EUCLIDEAN_METRIC ← prove
   r"open_in (mtopology euclidean_metric) = open:(real^N->bool)->bool"
   (REWRITE_TAC [FUN_EQ_THM, OPEN_IN_MTOPOLOGY, open_def, EUCLIDEAN_METRIC,
                 SUBSET_UNIV, SUBSET, IN_MBALL, IN_UNIV, DIST_SYM])

  let OPEN_IN_EUCLIDEAN ← prove
   r"open_in euclidean = open"
   (REWRITE_TAC [euclidean, ← GSYM OPEN_IN_EUCLIDEAN_METRIC] THEN
    MESON_TAC [topology_tybij])

  let OPEN_IN ← prove
   r"!s:real^N->bool. open s <=> open_in euclidean s"
   (REWRITE_TAC [OPEN_IN_EUCLIDEAN])

  let MTOPOLOGY_EUCLIDEAN_METRIC ← prove
   r"mtopology euclidean_metric = euclidean:(real^N)topology"
   (REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_EUCLIDEAN_METRIC, OPEN_IN])

  let METRIZABLE_SPACE_EUCLIDEAN ← prove
   r"metrizable_space euclidean"
   (REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC,
                 METRIZABLE_SPACE_MTOPOLOGY])

  let HAUSDORFF_SPACE_EUCLIDEAN ← prove
   r"hausdorff_space euclidean"
   (REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, HAUSDORFF_SPACE_MTOPOLOGY])

  let KC_SPACE_EUCLIDEAN ← prove
   r"kc_space(euclidean:(real^N)topology)"
   (REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, KC_SPACE_MTOPOLOGY])

  let T1_SPACE_EUCLIDEAN ← prove
   r"t1_space euclidean"
   (SIMP_TAC [HAUSDORFF_SPACE_EUCLIDEAN, HAUSDORFF_IMP_T1_SPACE])

  let REGULAR_SPACE_EUCLIDEAN ← prove
   r"regular_space euclidean"
   (REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, REGULAR_SPACE_MTOPOLOGY])

  let K_SPACE_EUCLIDEAN ← prove
   r"k_space(euclidean:(real^N)topology)"
   (REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, K_SPACE_MTOPOLOGY])

  let OPEN_EMPTY ← prove
   r"open {}"
   (REWRITE_TAC [open_def, NOT_IN_EMPTY])

  let OPEN_UNIV ← prove
   r"open(:real^N)"
   (REWRITE_TAC [open_def, IN_UNIV] THEN MESON_TAC [REAL_LT_01])

  let OPEN_INTER ← prove
   r"!s t. open s /\ open t ==> open (s INTER t)"
   (REWRITE_TAC [OPEN_IN, OPEN_IN_INTER])

  let OPEN_UNIONS ← prove
   r"(!s. s IN f ==> open s) ==> open(UNIONS f)"
   (REWRITE_TAC [open_def, IN_UNIONS] THEN MESON_TAC [])

  let OPEN_EXISTS_IN ← prove
   r"!P Q:A->real^N->bool.
        (!a. P a ==> open {x | Q a x}) ==> open {x | ?a. P a /\ Q a x}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"open(UNIONS {{x | Q (a:A) (x:real^N)} | P a})") MP_TAC THENL
     [MATCH_MP_TAC OPEN_UNIONS THEN ASM_REWRITE_TAC [FORALL_IN_GSPEC],
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN REWRITE_TAC [UNIONS_GSPEC] THEN
      SET_TAC []])

  let OPEN_EXISTS ← prove
   r"!Q:A->real^N->bool. (!a. open {x | Q a x}) ==> open {x | ?a. Q a x}"
   (MP_TAC (← ISPEC (← q r"\x:A. T") OPEN_EXISTS_IN) THEN REWRITE_TAC [])

  let OPEN_RELATIVE_TO ← prove
   r"!s t:real^N->bool.
        (open relative_to s) t <=> open_in (subtopology euclidean s) t"
   (REWRITE_TAC [← GSYM OPEN_IN_RELATIVE_TO] THEN
    REWRITE_TAC [relative_to, OPEN_IN])

  let TOPSPACE_EUCLIDEAN ← prove
   r"topspace euclidean = (:real^N)"
   (REWRITE_TAC [topspace, EXTENSION, IN_UNIV, IN_UNIONS, IN_ELIM_THM] THEN
    MESON_TAC [OPEN_UNIV, IN_UNIV, OPEN_IN])

  let TOPSPACE_EUCLIDEAN_SUBTOPOLOGY ← prove
   r"!s. topspace (subtopology euclidean s) = s"
   (REWRITE_TAC [TOPSPACE_EUCLIDEAN, TOPSPACE_SUBTOPOLOGY, INTER_UNIV])

  let OPEN_IN_REFL ← prove
   r"!s:real^N->bool. open_in (subtopology euclidean s) s"
   (REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_REFL, TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let SUBTOPOLOGY_EUCLIDEAN_EQ_DISCRETE_TOPOLOGY_FINITE ← prove
   r"!s:real^N->bool.
        FINITE s ==> subtopology euclidean s = discrete_topology s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_FINITE THEN
    ASM_REWRITE_TAC [T1_SPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  return { open_def, euclidean, euclidean_metric, EUCLIDEAN_METRIC, OPEN_IN_EUCLIDEAN_METRIC,
           OPEN_IN_EUCLIDEAN, OPEN_IN, MTOPOLOGY_EUCLIDEAN_METRIC, METRIZABLE_SPACE_EUCLIDEAN,
           HAUSDORFF_SPACE_EUCLIDEAN, KC_SPACE_EUCLIDEAN, T1_SPACE_EUCLIDEAN,
           REGULAR_SPACE_EUCLIDEAN, K_SPACE_EUCLIDEAN, OPEN_EMPTY, OPEN_UNIV, OPEN_INTER,
           OPEN_UNIONS, OPEN_EXISTS_IN, OPEN_EXISTS, OPEN_RELATIVE_TO, TOPSPACE_EUCLIDEAN,
           TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, OPEN_IN_REFL,
           SUBTOPOLOGY_EUCLIDEAN_EQ_DISCRETE_TOPOLOGY_FINITE }

/- ------------------------------------------------------------------------- -/
/- Closed sets.  (topology.ml 135-238)                                       -/
/- ------------------------------------------------------------------------- -/

structure CLO where
  closed : thm
  CLOSED_IN : thm
  CLOSED_IN_EUCLIDEAN : thm
  CLOSED_IN_EUCLIDEAN_METRIC : thm
  CLOSED_IN_REFL : thm
  CLOSED_RELATIVE_TO : thm
  OPEN_UNION : thm
  OPEN_SUBOPEN : thm
  CLOSED_EMPTY : thm
  CLOSED_UNIV : thm
  CLOSED_UNION : thm
  CLOSED_INTER : thm
  CLOSED_INTERS : thm
  CLOSED_FORALL_IN : thm
  CLOSED_FORALL : thm
  OPEN_CLOSED : thm
  OPEN_DIFF : thm
  CLOSED_DIFF : thm
  OPEN_INTERS : thm
  CLOSED_UNIONS : thm
  CLOSED_LOCALLY_FINITE_UNIONS : thm
  deriving Inhabited

@[nospecialize]
def setupCLO [HolBase] (D : TopologyDeps) (BEUC : EUC) : ExceptT String IO CLO := do
  -- @@SCOPE BEGIN
  let { new_definition, MESON_TAC, SET_TAC, .. } := D
  let { EQ_IMP, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_GSPEC, FUN_EQ_THM, IMP_CONJ, INTERS_0, INTERS_GSPEC, INTERS_INSERT,
        IN_INSERT, .. } := D.core2
  let { SUBSET_UNIV, .. } := D.core5
  let { UNIONS_0, UNIONS_INSERT, .. } := D.core6
  let { relative_to, .. } := D.misc
  let { CLOSED_IN_DIFF, CLOSED_IN_EMPTY, CLOSED_IN_INTER, CLOSED_IN_INTERS,
        CLOSED_IN_LOCALLY_FINITE_UNIONS, CLOSED_IN_RELATIVE_TO, CLOSED_IN_SUBTOPOLOGY_REFL,
        CLOSED_IN_TOPSPACE, CLOSED_IN_UNION, .. } := D.met1
  let { OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_SUBOPEN, OPEN_IN_UNION, closed_in, .. } :=
    D.met3
  let { MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_IN, OPEN_INTER, OPEN_UNIV, TOPSPACE_EUCLIDEAN, .. } :=
    BEUC
  -- @@SCOPE END

  let closed ← new_definition
   r"closed(s:real^N->bool) <=> open(UNIV DIFF s)"

  let CLOSED_IN ← prove
   r"!s:real^N->bool. closed s <=> closed_in euclidean s"
   (REWRITE_TAC [closed, closed_in, TOPSPACE_EUCLIDEAN, OPEN_IN, SUBSET_UNIV])

  let CLOSED_IN_EUCLIDEAN ← prove
   r"closed_in euclidean = closed:(real^N->bool)->bool"
   (REWRITE_TAC [CLOSED_IN, FUN_EQ_THM])

  let CLOSED_IN_EUCLIDEAN_METRIC ← prove
   r"closed_in (mtopology euclidean_metric) = closed:(real^N->bool)->bool"
   (REWRITE_TAC [CLOSED_IN_EUCLIDEAN, MTOPOLOGY_EUCLIDEAN_METRIC])

  let CLOSED_IN_REFL ← prove
   r"!s:real^N->bool. closed_in (subtopology euclidean s) s"
   (REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY_REFL, TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let CLOSED_RELATIVE_TO ← prove
   r"!s t:real^N->bool.
        (closed relative_to s) t <=> closed_in (subtopology euclidean s) t"
   (REWRITE_TAC [← GSYM CLOSED_IN_RELATIVE_TO] THEN
    REWRITE_TAC [relative_to, CLOSED_IN])

  let OPEN_UNION ← prove
   r"!s t. open s /\ open t ==> open(s UNION t)"
   (REWRITE_TAC [OPEN_IN, OPEN_IN_UNION])

  let OPEN_SUBOPEN ← prove
   r"!s. open s <=> !x. x IN s ==> ?t. open t /\ x IN t /\ t SUBSET s"
   (REWRITE_TAC [OPEN_IN, ← GSYM OPEN_IN_SUBOPEN])

  let CLOSED_EMPTY ← prove
   r"closed {}"
   (REWRITE_TAC [CLOSED_IN, CLOSED_IN_EMPTY])

  let CLOSED_UNIV ← prove
   r"closed(UNIV:real^N->bool)"
   (REWRITE_TAC [CLOSED_IN, ← GSYM TOPSPACE_EUCLIDEAN, CLOSED_IN_TOPSPACE])

  let CLOSED_UNION ← prove
   r"!s t. closed s /\ closed t ==> closed(s UNION t)"
   (REWRITE_TAC [CLOSED_IN, CLOSED_IN_UNION])

  let CLOSED_INTER ← prove
   r"!s t. closed s /\ closed t ==> closed(s INTER t)"
   (REWRITE_TAC [CLOSED_IN, CLOSED_IN_INTER])

  let CLOSED_INTERS ← prove
   r"!f. (!s:real^N->bool. s IN f ==> closed s) ==> closed(INTERS f)"
   (REWRITE_TAC [CLOSED_IN] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THEN
    ASM_SIMP_TAC [CLOSED_IN_INTERS, INTERS_0] THEN
    REWRITE_TAC [← GSYM TOPSPACE_EUCLIDEAN, CLOSED_IN_TOPSPACE])

  let CLOSED_FORALL_IN ← prove
   r"!P Q:A->real^N->bool.
        (!a. P a ==> closed {x | Q a x}) ==> closed {x | !a. P a ==> Q a x}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"closed(INTERS {{x | Q (a:A) (x:real^N)} | P a})") MP_TAC THENL
     [MATCH_MP_TAC CLOSED_INTERS THEN ASM_REWRITE_TAC [FORALL_IN_GSPEC],
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN REWRITE_TAC [INTERS_GSPEC] THEN
      SET_TAC []])

  let CLOSED_FORALL ← prove
   r"!Q:A->real^N->bool. (!a. closed {x | Q a x}) ==> closed {x | !a. Q a x}"
   (MP_TAC (← ISPEC (← q r"\x:A. T") CLOSED_FORALL_IN) THEN REWRITE_TAC [])

  let OPEN_CLOSED ← prove
   r"!s:real^N->bool. open s <=> closed(UNIV DIFF s)"
   (SIMP_TAC [OPEN_IN, CLOSED_IN, TOPSPACE_EUCLIDEAN, SUBSET_UNIV,
              OPEN_IN_CLOSED_IN_EQ])

  let OPEN_DIFF ← prove
   r"!s t. open s /\ closed t ==> open(s DIFF t)"
   (REWRITE_TAC [OPEN_IN, CLOSED_IN, OPEN_IN_DIFF])

  let CLOSED_DIFF ← prove
   r"!s t. closed s /\ open t ==> closed(s DIFF t)"
   (REWRITE_TAC [OPEN_IN, CLOSED_IN, CLOSED_IN_DIFF])

  let OPEN_INTERS ← prove
   r"!s. FINITE s /\ (!t. t IN s ==> open t) ==> open(INTERS s)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [INTERS_INSERT, INTERS_0, OPEN_UNIV, IN_INSERT] THEN
    MESON_TAC [OPEN_INTER])

  let CLOSED_UNIONS ← prove
   r"!s. FINITE s /\ (!t. t IN s ==> closed t) ==> closed(UNIONS s)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_INSERT, UNIONS_0, CLOSED_EMPTY, IN_INSERT] THEN
    MESON_TAC [CLOSED_UNION])

  let CLOSED_LOCALLY_FINITE_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> closed s) /\ locally_finite_in euclidean f
        ==> closed(UNIONS f)"
   (REWRITE_TAC [CLOSED_IN, CLOSED_IN_LOCALLY_FINITE_UNIONS])

  return { closed, CLOSED_IN, CLOSED_IN_EUCLIDEAN, CLOSED_IN_EUCLIDEAN_METRIC, CLOSED_IN_REFL,
           CLOSED_RELATIVE_TO, OPEN_UNION, OPEN_SUBOPEN, CLOSED_EMPTY, CLOSED_UNIV,
           CLOSED_UNION, CLOSED_INTER, CLOSED_INTERS, CLOSED_FORALL_IN, CLOSED_FORALL,
           OPEN_CLOSED, OPEN_DIFF, CLOSED_DIFF, OPEN_INTERS, CLOSED_UNIONS,
           CLOSED_LOCALLY_FINITE_UNIONS }

/- ------------------------------------------------------------------------- -/
/- Componentwise, lifted and dropped limits and continuity; arithmetic       -/
/- combining theorems for vector-valued continuous maps.                     -/
/- (topology.ml 239-421)                                                     -/
/- ------------------------------------------------------------------------- -/

structure CWL where
  LIMIT_EQ_LIFT : thm
  LIMIT_EQ_DROP : thm
  CONTINUOUS_MAP_EQ_LIFT : thm
  CONTINUOUS_MAP_EQ_DROP : thm
  LIMIT_COMPONENTWISE_REAL : thm
  CONTINUOUS_MAP_COMPONENTWISE_REAL : thm
  CONTINUOUS_MAP_LIFT : thm
  CONTINUOUS_MAP_DROP : thm
  CONTINUOUS_MAP_LIFT_EQ : thm
  CONTINUOUS_MAP_DROP_EQ : thm
  CONTINUOUS_MAP_LIFT_EQ_GEN : thm
  CONTINUOUS_MAP_DROP_EQ_GEN : thm
  CONTINUOUS_MAP_VECTOR_CONST : thm
  CONTINUOUS_MAP_VECTOR_ADD : thm
  CONTINUOUS_MAP_VECTOR_SUB : thm
  CONTINUOUS_MAP_VECTOR_MUL : thm
  CONTINUOUS_MAP_DOT : thm
  CONTINUOUS_MAP_VSUM : thm
  CONTINUOUS_MAP_EUCLIDEAN_COMPONENT : thm
  deriving Inhabited

@[nospecialize]
def setupCWL [HolBase] (D : TopologyDeps) (BEUC : EUC) : ExceptT String IO CWL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, .. } := D
  let { CARD_NUMSEG_1, DIMINDEX_GE_1, ETA_AX, FINITE_INDEX_INRANGE, FINITE_INDUCT_STRONG,
        FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_ID, IMAGE_o, IMP_CONJ, IN_NUMSEG, .. } :=
    D.core2
  let { IN_UNIV, LE_1, NOT_LE, NOT_LT, NUMSEG_EMPTY, REAL_ABS_SUB, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LT_DIV, .. } := D.core4
  let { REAL_OF_NUM_LT, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.core5
  let { SUM_BOUND_LT_GEN, SWAP_FORALL_THM, o_DEF, o_THM, .. } := D.core6
  let { COMPONENT_LE_NORM, DIST_LIFT, DIST_SYM, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { NORM_LE_L1, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT, VSUM_CLAUSES, dist,
        dot, .. } := D.vec4
  let { CONTINUOUS_MAP_ATPOINTOF, CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_CONST,
        CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_MUL, CONTINUOUS_MAP_REAL_SUB, .. } := D.met1
  let { CONTINUOUS_MAP_SUM, EVENTUALLY_MONO, FORALL_EVENTUALLY, LIMIT_METRIC,
        MTOPOLOGY_REAL_EUCLIDEAN_METRIC, .. } := D.met2
  let { REAL_EUCLIDEAN_METRIC, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, TOPSPACE_EUCLIDEAN,
        TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  -- @@SCOPE END

  let LIMIT_EQ_LIFT ← prove
   r"!(net:A net) f l.
        limit euclideanreal f l net <=>
        limit euclidean (lift o f) (lift l) net"
   (REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC,
                 ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [LIMIT_METRIC, EUCLIDEAN_METRIC,
                 REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    REWRITE_TAC [o_THM, DIST_LIFT, REAL_ABS_SUB])

  let LIMIT_EQ_DROP ← prove
   r"!(net:A net) f l.
        limit euclidean f l net <=>
        limit euclideanreal (drop o f) (drop l) net"
   (REWRITE_TAC [LIMIT_EQ_LIFT, o_DEF, LIFT_DROP, ETA_AX])

  let CONTINUOUS_MAP_EQ_LIFT ← prove
   r"!top f:A->real.
        continuous_map(top,euclideanreal) f <=>
        continuous_map(top,euclidean) (lift o f)"
   (REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_EQ_LIFT, o_THM])

  let CONTINUOUS_MAP_EQ_DROP ← prove
   r"!top f:A->real^1.
        continuous_map(top,euclidean) f <=>
        continuous_map(top,euclideanreal) (drop o f)"
   (REWRITE_TAC [CONTINUOUS_MAP_EQ_LIFT, o_DEF, LIFT_DROP, ETA_AX])

  let LIMIT_COMPONENTWISE_REAL ← prove
   r"!net (f:A->real^N) l.
        limit euclidean f l net <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> limit euclideanreal (\x. f x$i) (l$i) net"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC,
                 ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [LIMIT_METRIC, EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_UNIV, RIGHT_IMP_FORALL_THM, ← GSYM IN_NUMSEG] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM, DIST_SYM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [FORALL_EVENTUALLY, FINITE_NUMSEG, NUMSEG_EMPTY,
              NOT_LT, DIMINDEX_GE_1] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      MESON_TAC [VECTOR_SUB_COMPONENT, dist, REAL_LET_TRANS, COMPONENT_LE_NORM],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &(dimindex(:N))")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      X_GEN_TAC (← q r"x:A") THEN SIMP_TAC [← GSYM VECTOR_SUB_COMPONENT, dist] THEN
      DISCH_TAC THEN W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"s < e ==> n <= s ==> n < e")) THEN
      MATCH_MP_TAC SUM_BOUND_LT_GEN THEN
      ASM_SIMP_TAC [FINITE_NUMSEG, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1,
                    CARD_NUMSEG_1, ← GSYM IN_NUMSEG]])

  let CONTINUOUS_MAP_COMPONENTWISE_REAL ← prove
   r"!top (f:A->real^N).
        continuous_map (top,euclidean) f <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> continuous_map (top,euclideanreal) (\x. f x$i)"
   (REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_COMPONENTWISE_REAL] THEN
    MESON_TAC [])

  let CONTINUOUS_MAP_LIFT ← prove
   r"continuous_map (euclideanreal,euclidean) lift"
   (REWRITE_TAC [CONTINUOUS_MAP_EQ_DROP, o_DEF, LIFT_DROP, CONTINUOUS_MAP_ID])

  let CONTINUOUS_MAP_DROP ← prove
   r"continuous_map (euclidean,euclideanreal) drop"
   (REWRITE_TAC [CONTINUOUS_MAP_EQ_LIFT, o_DEF, LIFT_DROP, CONTINUOUS_MAP_ID])

  let CONTINUOUS_MAP_LIFT_EQ ← prove
   r"!top f:real^1->A.
        continuous_map(euclidean,top) f <=>
        continuous_map(euclideanreal,top) (f o lift)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_LIFT], ALL_TAC] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"f:real^1->A = (f o lift) o drop") SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX],
      ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_DROP]])

  let CONTINUOUS_MAP_DROP_EQ ← prove
   r"!top f:real->A.
        continuous_map(euclideanreal,top) f <=>
        continuous_map(euclidean,top) (f o drop)"
   (REWRITE_TAC [CONTINUOUS_MAP_LIFT_EQ, o_DEF, LIFT_DROP, ETA_AX])

  let CONTINUOUS_MAP_LIFT_EQ_GEN ← prove
   r"!top s (f:real^1->A).
        continuous_map (subtopology euclidean s,top) f <=>
        continuous_map (subtopology euclideanreal (IMAGE drop s),top)
                       (f o lift)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"subtopology euclidean (s:real^1->bool)") THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_LIFT,
                    CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
      REWRITE_TAC [SUBSET, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP],
      SUBGOAL_THEN (← q r"f:real^1->A = (f o lift) o drop") SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"subtopology euclideanreal (IMAGE drop (s:real^1->bool))") THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_DROP,
                    CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
      REWRITE_TAC [SUBSET, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP]])

  let CONTINUOUS_MAP_DROP_EQ_GEN ← prove
   r"!top s (f:real->A).
        continuous_map(subtopology euclideanreal s,top) f <=>
        continuous_map(subtopology euclidean (IMAGE lift s),top) (f o drop)"
   (REWRITE_TAC [CONTINUOUS_MAP_LIFT_EQ_GEN, o_DEF, LIFT_DROP, ETA_AX,
                 ← GSYM IMAGE_o, IMAGE_ID])

  let CONTINUOUS_MAP_VECTOR_CONST ← prove
   r"!(top:A topology) (b:real^N).
        continuous_map (top,euclidean) (\x. b)"
   (REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEAN, IN_UNIV])

  let CONTINUOUS_MAP_VECTOR_ADD ← prove
   r"!top f g:A->real^N.
        continuous_map(top,euclidean) f /\ continuous_map(top,euclidean) g
        ==> continuous_map(top,euclidean) (\x. f x + g x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_REAL] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN
    ASM_SIMP_TAC [VECTOR_ADD_COMPONENT, CONTINUOUS_MAP_REAL_ADD])

  let CONTINUOUS_MAP_VECTOR_SUB ← prove
   r"!top f g:A->real^N.
        continuous_map(top,euclidean) f /\ continuous_map(top,euclidean) g
        ==> continuous_map(top,euclidean) (\x. f x - g x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_REAL] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN
    ASM_SIMP_TAC [VECTOR_SUB_COMPONENT, CONTINUOUS_MAP_REAL_SUB])

  let CONTINUOUS_MAP_VECTOR_MUL ← prove
   r"!top c f:A->real^N.
        continuous_map(top,euclideanreal) c /\ continuous_map(top,euclidean) f
        ==> continuous_map(top,euclidean) (\x. c x % f x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_REAL] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
    ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, CONTINUOUS_MAP_REAL_MUL])

  let CONTINUOUS_MAP_DOT ← prove
   r"!top f g:A->real^N.
        continuous_map(top,euclidean) f /\ continuous_map(top,euclidean) g
        ==> continuous_map(top,euclideanreal) (\x. f x dot g x)"
   (REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_REAL] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [dot] THEN MATCH_MP_TAC CONTINUOUS_MAP_SUM THEN
    ASM_SIMP_TAC [IN_NUMSEG, FINITE_NUMSEG, CONTINUOUS_MAP_REAL_MUL])

  let CONTINUOUS_MAP_VSUM ← prove
   r"!top k (f:A->K->real^N).
        FINITE k /\ (!i. i IN k ==> continuous_map(top,euclidean) (\x. f x i))
        ==> continuous_map(top,euclidean) (\x. vsum k (f x))"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN REWRITE_TAC [FORALL_IN_INSERT] THEN
    SIMP_TAC [VSUM_CLAUSES, CONTINUOUS_MAP_VECTOR_CONST,
              CONTINUOUS_MAP_VECTOR_ADD])

  let CONTINUOUS_MAP_EUCLIDEAN_COMPONENT ← prove
   r"!top (f:A->real^N) i.
        continuous_map(top,euclidean) f
        ==> continuous_map (top,euclideanreal) (\x. f x$i)"
   (REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_REAL] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?k. 1 <= k /\ k <= dimindex(:N) /\ !x:real^N. x$i = x$k")
    STRIP_ASSUME_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ASM_SIMP_TAC []])

  return { LIMIT_EQ_LIFT, LIMIT_EQ_DROP, CONTINUOUS_MAP_EQ_LIFT, CONTINUOUS_MAP_EQ_DROP,
           LIMIT_COMPONENTWISE_REAL, CONTINUOUS_MAP_COMPONENTWISE_REAL, CONTINUOUS_MAP_LIFT,
           CONTINUOUS_MAP_DROP, CONTINUOUS_MAP_LIFT_EQ, CONTINUOUS_MAP_DROP_EQ,
           CONTINUOUS_MAP_LIFT_EQ_GEN, CONTINUOUS_MAP_DROP_EQ_GEN, CONTINUOUS_MAP_VECTOR_CONST,
           CONTINUOUS_MAP_VECTOR_ADD, CONTINUOUS_MAP_VECTOR_SUB, CONTINUOUS_MAP_VECTOR_MUL,
           CONTINUOUS_MAP_DOT, CONTINUOUS_MAP_VSUM, CONTINUOUS_MAP_EUCLIDEAN_COMPONENT }

/- ------------------------------------------------------------------------- -/
/- Open and closed balls and spheres.  (topology.ml 422-682)                 -/
/- ------------------------------------------------------------------------- -/

structure BAL where
  ball : thm
  IN_BALL : thm
  MBALL_EUCLIDEAN : thm
  cball : thm
  IN_CBALL : thm
  MCBALL_EUCLIDEAN : thm
  sphere : thm
  IN_SPHERE : thm
  IN_BALL_0 : thm
  IN_CBALL_0 : thm
  IN_SPHERE_0 : thm
  BALL_TRIVIAL : thm
  CBALL_TRIVIAL : thm
  CENTRE_IN_CBALL : thm
  BALL_SUBSET_CBALL : thm
  SPHERE_SUBSET_CBALL : thm
  SUBSET_BALL : thm
  SUBSET_CBALL : thm
  BALL_MAX_UNION : thm
  BALL_MIN_INTER : thm
  CBALL_MAX_UNION : thm
  CBALL_MIN_INTER : thm
  BALL_TRANSLATION : thm
  CBALL_TRANSLATION : thm
  SPHERE_TRANSLATION : thm
  BALL_LINEAR_IMAGE : thm
  CBALL_LINEAR_IMAGE : thm
  SPHERE_LINEAR_IMAGE : thm
  BALL_SCALING : thm
  CBALL_SCALING : thm
  SPHERE_SCALING : thm
  CBALL_DIFF_BALL : thm
  BALL_UNION_SPHERE : thm
  SPHERE_UNION_BALL : thm
  CBALL_DIFF_SPHERE : thm
  OPEN_BALL : thm
  CENTRE_IN_BALL : thm
  OPEN_CONTAINS_BALL : thm
  OPEN_CONTAINS_BALL_EQ : thm
  BALL_EQ_EMPTY : thm
  BALL_EMPTY : thm
  OPEN_CONTAINS_CBALL : thm
  OPEN_CONTAINS_CBALL_EQ : thm
  SPHERE_EQ_EMPTY : thm
  SPHERE_EMPTY : thm
  NEGATIONS_BALL : thm
  NEGATIONS_CBALL : thm
  NEGATIONS_SPHERE : thm
  ORTHOGONAL_TRANSFORMATION_BALL : thm
  ORTHOGONAL_TRANSFORMATION_CBALL : thm
  ORTHOGONAL_TRANSFORMATION_SPHERE : thm
  deriving Inhabited

@[nospecialize]
def setupBAL [HolBase] (D : TopologyDeps) (BEUC : EUC) : ExceptT String IO BAL := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, NORM_ARITH,
        NORM_ARITH_TAC, add_linear_invariants, add_scaling_theorems, add_translation_invariants,
        GEOM_TRANSFORM_TAC, GEOM_TRANSLATE_TAC, .. } := D
  let { ARITH, EXTENSION, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, .. } := D.core2
  let { IN_UNION, IN_UNIV, MONO_FORALL, MONO_IMP, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_ADD_SYM, REAL_EQ_MUL_LCANCEL, REAL_LET_TRANS, REAL_LE_LMUL_EQ, REAL_LE_TRANS,
        REAL_LTE_TRANS, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ, .. } :=
    D.core4
  let { REAL_LT_SUB_LADD, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_LT, REAL_SUB_LT, SUBSET,
        SUBSET_TRANS, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_MUL, DIST_POS_LE, DIST_REFL, DIST_SYM, DIST_TRIANGLE_ALT, .. } := D.vec1
  let { NORM_NEG, SURJECTIVE_SCALING, .. } := D.vec3
  let { VECTOR_CHOOSE_DIST, VECTOR_NEG_NEG, VECTOR_SUB_LZERO, dist, .. } := D.vec4
  let { ORTHOGONAL_TRANSFORMATION, ORTHOGONAL_TRANSFORMATION_INVERSE, .. } := D.det
  let { IN_MBALL, IN_MCBALL, .. } := D.met2
  let { EUCLIDEAN_METRIC, open_def, .. } := BEUC
  -- @@SCOPE END

  let ball ← new_definition
   r"ball(x,e) = { y | dist(x,y) < e}"

  let IN_BALL ← prove
   r"!x y e. y IN ball(x,e) <=> dist(x,y) < e"
   (REWRITE_TAC [ball, IN_ELIM_THM])

  let MBALL_EUCLIDEAN ← prove
   r"!x:real^N r. mball euclidean_metric (x,r) = ball(x,r)"
   (REWRITE_TAC [EXTENSION, IN_MBALL, IN_BALL, EUCLIDEAN_METRIC, IN_UNIV])

  let cball ← new_definition
   r"cball(x,e) = { y | dist(x,y) <= e}"

  let IN_CBALL ← prove
   r"!x y e. y IN cball(x,e) <=> dist(x,y) <= e"
   (REWRITE_TAC [cball, IN_ELIM_THM])

  let MCBALL_EUCLIDEAN ← prove
   r"!x:real^N r. mcball euclidean_metric (x,r) = cball(x,r)"
   (REWRITE_TAC [EXTENSION, IN_MCBALL, IN_CBALL, EUCLIDEAN_METRIC, IN_UNIV])

  let sphere ← new_definition
   r"sphere(x,e) = { y | dist(x,y) = e}"

  let IN_SPHERE ← prove
   r"!x y e. y IN sphere(x,e) <=> dist(x,y) = e"
   (REWRITE_TAC [sphere, IN_ELIM_THM])

  let IN_BALL_0 ← prove
   r"!x e. x IN ball(vec 0,e) <=> norm(x) < e"
   (REWRITE_TAC [IN_BALL, dist, VECTOR_SUB_LZERO, NORM_NEG])

  let IN_CBALL_0 ← prove
   r"!x e. x IN cball(vec 0,e) <=> norm(x) <= e"
   (REWRITE_TAC [IN_CBALL, dist, VECTOR_SUB_LZERO, NORM_NEG])

  let IN_SPHERE_0 ← prove
   r"!x e. x IN sphere(vec 0,e) <=> norm(x) = e"
   (REWRITE_TAC [IN_SPHERE, dist, VECTOR_SUB_LZERO, NORM_NEG])

  let BALL_TRIVIAL ← prove
   r"!x. ball(x,&0) = {}"
   (REWRITE_TAC [EXTENSION, IN_BALL, IN_SING, NOT_IN_EMPTY] THEN NORM_ARITH_TAC)

  let CBALL_TRIVIAL ← prove
   r"!x. cball(x,&0) = {x}"
   (REWRITE_TAC [EXTENSION, IN_CBALL, IN_SING, NOT_IN_EMPTY] THEN NORM_ARITH_TAC)

  let CENTRE_IN_CBALL ← prove
   r"!x e. x IN cball(x,e) <=> &0 <= e"
   (MESON_TAC [IN_CBALL, DIST_REFL])

  let BALL_SUBSET_CBALL ← prove
   r"!x e. ball(x,e) SUBSET cball(x,e)"
   (REWRITE_TAC [IN_BALL, IN_CBALL, SUBSET] THEN REAL_ARITH_TAC)

  let SPHERE_SUBSET_CBALL ← prove
   r"!x e. sphere(x,e) SUBSET cball(x,e)"
   (REWRITE_TAC [IN_SPHERE, IN_CBALL, SUBSET] THEN REAL_ARITH_TAC)

  let SUBSET_BALL ← prove
   r"!x d e. d <= e ==> ball(x,d) SUBSET ball(x,e)"
   (REWRITE_TAC [SUBSET, IN_BALL] THEN MESON_TAC [REAL_LTE_TRANS])

  let SUBSET_CBALL ← prove
   r"!x d e. d <= e ==> cball(x,d) SUBSET cball(x,e)"
   (REWRITE_TAC [SUBSET, IN_CBALL] THEN MESON_TAC [REAL_LE_TRANS])

  let BALL_MAX_UNION ← prove
   r"!a r s. ball(a,max r s) = ball(a,r) UNION ball(a,s)"
   (REWRITE_TAC [IN_BALL, IN_UNION, EXTENSION] THEN REAL_ARITH_TAC)

  let BALL_MIN_INTER ← prove
   r"!a r s. ball(a,min r s) = ball(a,r) INTER ball(a,s)"
   (REWRITE_TAC [IN_BALL, IN_INTER, EXTENSION] THEN REAL_ARITH_TAC)

  let CBALL_MAX_UNION ← prove
   r"!a r s. cball(a,max r s) = cball(a,r) UNION cball(a,s)"
   (REWRITE_TAC [IN_CBALL, IN_UNION, EXTENSION] THEN REAL_ARITH_TAC)

  let CBALL_MIN_INTER ← prove
   r"!x d e. cball(x,min d e) = cball(x,d) INTER cball(x,e)"
   (REWRITE_TAC [EXTENSION, IN_INTER, IN_CBALL] THEN REAL_ARITH_TAC)

  let BALL_TRANSLATION ← prove
   r"!a x r. ball(a + x,r) = IMAGE (\y. a + y) (ball(x,r))"
   (REWRITE_TAC [ball] THEN GEOM_TRANSLATE_TAC [])

  let CBALL_TRANSLATION ← prove
   r"!a x r. cball(a + x,r) = IMAGE (\y. a + y) (cball(x,r))"
   (REWRITE_TAC [cball] THEN GEOM_TRANSLATE_TAC [])

  let SPHERE_TRANSLATION ← prove
   r"!a x r. sphere(a + x,r) = IMAGE (\y. a + y) (sphere(x,r))"
   (REWRITE_TAC [sphere] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants
    [BALL_TRANSLATION, CBALL_TRANSLATION, SPHERE_TRANSLATION]

  let BALL_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N x r.
        linear f /\ (!y. ?x. f x = y) /\ (!x. norm(f x) = norm x)
        ==> ball(f x,r) = IMAGE f (ball(x,r))"
   (REWRITE_TAC [ball] THEN GEOM_TRANSFORM_TAC [])

  let CBALL_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N x r.
        linear f /\ (!y. ?x. f x = y) /\ (!x. norm(f x) = norm x)
        ==> cball(f x,r) = IMAGE f (cball(x,r))"
   (REWRITE_TAC [cball] THEN GEOM_TRANSFORM_TAC [])

  let SPHERE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N x r.
        linear f /\ (!y. ?x. f x = y) /\ (!x. norm(f x) = norm x)
        ==> sphere(f x,r) = IMAGE f (sphere(x,r))"
   (REWRITE_TAC [sphere] THEN GEOM_TRANSFORM_TAC [])

  add_linear_invariants
    [BALL_LINEAR_IMAGE, CBALL_LINEAR_IMAGE, SPHERE_LINEAR_IMAGE]

  let BALL_SCALING ← prove
   r"!c. &0 < c ==> !x r. ball(c % x,c * r) = IMAGE (\x. c % x) (ball(x,r))"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SURJECTIVE_SCALING, REAL_LT_IMP_NZ], ALL_TAC] THEN
    REWRITE_TAC [IN_BALL, DIST_MUL] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < c ==> abs c = c"), REAL_LT_LMUL_EQ])

  let CBALL_SCALING ← prove
   r"!c. &0 < c ==> !x r. cball(c % x,c * r) = IMAGE (\x. c % x) (cball(x,r))"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SURJECTIVE_SCALING, REAL_LT_IMP_NZ], ALL_TAC] THEN
    REWRITE_TAC [IN_CBALL, DIST_MUL] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < c ==> abs c = c"), REAL_LE_LMUL_EQ])

  let SPHERE_SCALING ← prove
   r"!c. &0 < c
       ==> !x r. sphere(c % x,c * r) = IMAGE (\x. c % x) (sphere(x,r))"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SURJECTIVE_SCALING, REAL_LT_IMP_NZ], ALL_TAC] THEN
    REWRITE_TAC [IN_SPHERE, DIST_MUL] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < c ==> abs c = c"), REAL_EQ_MUL_LCANCEL,
                  REAL_LT_IMP_NZ])

  add_scaling_theorems [BALL_SCALING, CBALL_SCALING, SPHERE_SCALING]

  let CBALL_DIFF_BALL ← prove
   r"!a r. cball(a,r) DIFF ball(a,r) = sphere(a,r)"
   (REWRITE_TAC [ball, cball, sphere, EXTENSION, IN_DIFF, IN_ELIM_THM] THEN
    REAL_ARITH_TAC)

  let BALL_UNION_SPHERE ← prove
   r"!a r. ball(a,r) UNION sphere(a,r) = cball(a,r)"
   (REWRITE_TAC [ball, cball, sphere, EXTENSION, IN_UNION, IN_ELIM_THM] THEN
    REAL_ARITH_TAC)

  let SPHERE_UNION_BALL ← prove
   r"!a r. sphere(a,r) UNION ball(a,r)  = cball(a,r)"
   (REWRITE_TAC [ball, cball, sphere, EXTENSION, IN_UNION, IN_ELIM_THM] THEN
    REAL_ARITH_TAC)

  let CBALL_DIFF_SPHERE ← prove
   r"!a r. cball(a,r) DIFF sphere(a,r) = ball(a,r)"
   (REWRITE_TAC [EXTENSION, IN_DIFF, IN_SPHERE, IN_BALL, IN_CBALL] THEN
    REAL_ARITH_TAC)

  let OPEN_BALL ← prove
   r"!x e. open(ball(x,e))"
   (REWRITE_TAC [open_def, ball, IN_ELIM_THM] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
    MESON_TAC [REAL_SUB_LT, REAL_LT_SUB_LADD, REAL_ADD_SYM, REAL_LET_TRANS,
               DIST_TRIANGLE_ALT])

  let CENTRE_IN_BALL ← prove
   r"!x e. x IN ball(x,e) <=> &0 < e"
   (MESON_TAC [IN_BALL, DIST_REFL])

  let OPEN_CONTAINS_BALL ← prove
   r"!s. open s <=> !x. x IN s ==> ?e. &0 < e /\ ball(x,e) SUBSET s"
   (REWRITE_TAC [open_def, SUBSET, IN_BALL] THEN REWRITE_TAC [DIST_SYM])

  let OPEN_CONTAINS_BALL_EQ ← prove
   r"!s. open s ==> (!x. x IN s <=> ?e. &0 < e /\ ball(x,e) SUBSET s)"
   (MESON_TAC [OPEN_CONTAINS_BALL, SUBSET, CENTRE_IN_BALL])

  let BALL_EQ_EMPTY ← prove
   r"!x e. (ball(x,e) = {}) <=> e <= &0"
   (REWRITE_TAC [EXTENSION, IN_BALL, NOT_IN_EMPTY, REAL_NOT_LT] THEN
    MESON_TAC [DIST_POS_LE, REAL_LE_TRANS, DIST_REFL])

  let BALL_EMPTY ← prove
   r"!x e. e <= &0 ==> ball(x,e) = {}"
   (REWRITE_TAC [BALL_EQ_EMPTY])

  let OPEN_CONTAINS_CBALL ← prove
   r"!s. open s <=> !x. x IN s ==> ?e. &0 < e /\ cball(x,e) SUBSET s"
   (GEN_TAC THEN REWRITE_TAC [OPEN_CONTAINS_BALL] THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [SUBSET_TRANS, BALL_SUBSET_CBALL]] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [SUBSET, IN_BALL, IN_CBALL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"e / &2") THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    SUBGOAL_THEN (← q r"e / &2 < e")
      (fun th => ASM_MESON_TAC [th, REAL_LET_TRANS]) THEN
    ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_OF_NUM_LT, ARITH] THEN
    UNDISCH_TAC (← q r"&0 < e") THEN REAL_ARITH_TAC)

  let OPEN_CONTAINS_CBALL_EQ ← prove
   r"!s. open s ==> (!x. x IN s <=> ?e. &0 < e /\ cball(x,e) SUBSET s)"
   (MESON_TAC [OPEN_CONTAINS_CBALL, SUBSET, REAL_LT_IMP_LE, CENTRE_IN_CBALL])

  let SPHERE_EQ_EMPTY ← prove
   r"!a:real^N r. sphere(a,r) = {} <=> r < &0"
   (REWRITE_TAC [sphere, EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
    REPEAT GEN_TAC THEN EQ_TAC THENL [ALL_TAC, CONV_TAC (fun t => NORM_ARITH t)] THEN
    MESON_TAC [VECTOR_CHOOSE_DIST, REAL_NOT_LE])

  let SPHERE_EMPTY ← prove
   r"!a:real^N r. r < &0 ==> sphere(a,r) = {}"
   (REWRITE_TAC [SPHERE_EQ_EMPTY])

  let NEGATIONS_BALL ← prove
   r"!r. IMAGE (--) (ball(vec 0:real^N,r)) = ball(vec 0,r)"
   (GEN_TAC THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_BALL_0, NORM_NEG] THEN MESON_TAC [VECTOR_NEG_NEG])

  let NEGATIONS_CBALL ← prove
   r"!r. IMAGE (--) (cball(vec 0:real^N,r)) = cball(vec 0,r)"
   (GEN_TAC THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_CBALL_0, NORM_NEG] THEN MESON_TAC [VECTOR_NEG_NEG])

  let NEGATIONS_SPHERE ← prove
   r"!r. IMAGE (--) (sphere(vec 0:real^N,r)) = sphere(vec 0,r)"
   (GEN_TAC THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_SPHERE_0, NORM_NEG] THEN MESON_TAC [VECTOR_NEG_NEG])

  let ORTHOGONAL_TRANSFORMATION_BALL ← prove
   r"!f:real^N->real^N r.
    orthogonal_transformation f ==> IMAGE f (ball(vec 0,r)) = ball(vec 0,r)"
   (REWRITE_TAC [EXTENSION, IN_IMAGE, IN_BALL_0] THEN
    MESON_TAC [ORTHOGONAL_TRANSFORMATION_INVERSE, ORTHOGONAL_TRANSFORMATION])

  let ORTHOGONAL_TRANSFORMATION_CBALL ← prove
   r"!f:real^N->real^N r.
    orthogonal_transformation f ==> IMAGE f (cball(vec 0,r)) = cball(vec 0,r)"
   (REWRITE_TAC [EXTENSION, IN_IMAGE, IN_CBALL_0] THEN
    MESON_TAC [ORTHOGONAL_TRANSFORMATION_INVERSE, ORTHOGONAL_TRANSFORMATION])

  let ORTHOGONAL_TRANSFORMATION_SPHERE ← prove
   r"!f:real^N->real^N r.
    orthogonal_transformation f
    ==> IMAGE f (sphere(vec 0,r)) = sphere(vec 0,r)"
   (REWRITE_TAC [EXTENSION, IN_IMAGE, IN_SPHERE_0] THEN
    MESON_TAC [ORTHOGONAL_TRANSFORMATION_INVERSE, ORTHOGONAL_TRANSFORMATION])

  return { ball, IN_BALL, MBALL_EUCLIDEAN, cball, IN_CBALL, MCBALL_EUCLIDEAN, sphere,
           IN_SPHERE, IN_BALL_0, IN_CBALL_0, IN_SPHERE_0, BALL_TRIVIAL, CBALL_TRIVIAL,
           CENTRE_IN_CBALL, BALL_SUBSET_CBALL, SPHERE_SUBSET_CBALL, SUBSET_BALL, SUBSET_CBALL,
           BALL_MAX_UNION, BALL_MIN_INTER, CBALL_MAX_UNION, CBALL_MIN_INTER, BALL_TRANSLATION,
           CBALL_TRANSLATION, SPHERE_TRANSLATION, BALL_LINEAR_IMAGE, CBALL_LINEAR_IMAGE,
           SPHERE_LINEAR_IMAGE, BALL_SCALING, CBALL_SCALING, SPHERE_SCALING, CBALL_DIFF_BALL,
           BALL_UNION_SPHERE, SPHERE_UNION_BALL, CBALL_DIFF_SPHERE, OPEN_BALL, CENTRE_IN_BALL,
           OPEN_CONTAINS_BALL, OPEN_CONTAINS_BALL_EQ, BALL_EQ_EMPTY, BALL_EMPTY,
           OPEN_CONTAINS_CBALL, OPEN_CONTAINS_CBALL_EQ, SPHERE_EQ_EMPTY, SPHERE_EMPTY,
           NEGATIONS_BALL, NEGATIONS_CBALL, NEGATIONS_SPHERE, ORTHOGONAL_TRANSFORMATION_BALL,
           ORTHOGONAL_TRANSFORMATION_CBALL, ORTHOGONAL_TRANSFORMATION_SPHERE }

/- ------------------------------------------------------------------------- -/
/- Basic "localization" results; "transitivity" results; invariance         -/
/- theorems for relative topology.  (topology.ml 683-894)                    -/
/- ------------------------------------------------------------------------- -/

structure LOC where
  OPEN_IN_OPEN : thm
  OPEN_IN_INTER_OPEN : thm
  OPEN_IN_OPEN_INTER : thm
  OPEN_OPEN_IN_TRANS : thm
  OPEN_SUBSET : thm
  CLOSED_IN_DIFF_OPEN : thm
  CLOSED_IN_CLOSED : thm
  CLOSED_SUBSET_EQ : thm
  CLOSED_IN_INTER_CLOSED : thm
  CLOSED_IN_CLOSED_INTER : thm
  CLOSED_SUBSET : thm
  OPEN_IN_DIFF_CLOSED : thm
  open_in : thm
  OPEN_IN_CONTAINS_BALL : thm
  OPEN_IN_CONTAINS_CBALL : thm
  OPEN_IN_TRANS_EQ : thm
  OPEN_IN_OPEN_TRANS : thm
  CLOSED_IN_TRANS_EQ : thm
  CLOSED_IN_CLOSED_TRANS : thm
  OPEN_IN_OPEN_EQ : thm
  CLOSED_IN_CLOSED_EQ : thm
  OPEN_IN_TRANSLATION_EQ : thm
  CLOSED_IN_TRANSLATION_EQ : thm
  OPEN_IN_INJECTIVE_LINEAR_IMAGE : thm
  CLOSED_IN_INJECTIVE_LINEAR_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupLOC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) :
    ExceptT String IO LOC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, add_linear_invariants,
        add_translation_invariants, GEOM_TRANSFORM_TAC, GEOM_TRANSLATE_TAC, .. } := D
  let { EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_IMP, INTER, INTER_ACI, INTER_SUBSET,
        IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNIONS, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { REAL_LE_RDIV_EQ, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, .. } := D.core5
  let { RELATIVE_TO_SUBSET, .. } := D.misc
  let { DIST_REFL, DIST_SYM, .. } := D.vec1
  let { LINEAR_BOUNDED_POS, LINEAR_INJECTIVE_BOUNDED_BELOW_POS, LINEAR_SUB, .. } := D.vec2
  let { dist, .. } := D.vec4
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_SUBTOPOLOGY,
        CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED_IN, CLOSED_IN_TRANS, .. } := D.met1
  let { OPEN_IN_DIFF, OPEN_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_INTER_OPEN_IN, OPEN_IN_TRANS,
        SUBTOPOLOGY_UNIV, closed_in, .. } := D.met3
  let { OPEN_IN, OPEN_IN_REFL, OPEN_RELATIVE_TO, OPEN_UNIONS, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
        open_def, .. } := BEUC
  let { CLOSED_IN, CLOSED_IN_REFL, CLOSED_RELATIVE_TO, .. } := BCLO
  let { IN_BALL, IN_CBALL, OPEN_BALL, .. } := BBAL
  -- @@SCOPE END

  let OPEN_IN_OPEN ← prove
   r"!s:real^N->bool u.
        open_in (subtopology euclidean u) s <=> ?t. open t /\ (s = u INTER t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, ← GSYM OPEN_IN] THEN
    REWRITE_TAC [INTER_ACI])

  let OPEN_IN_INTER_OPEN ← prove
   r"!s t u:real^N->bool.
        open_in (subtopology euclidean u) s /\ open t
        ==> open_in (subtopology euclidean u) (s INTER t)"
   (REWRITE_TAC [OPEN_IN, OPEN_IN_SUBTOPOLOGY_INTER_OPEN_IN])

  let OPEN_IN_OPEN_INTER ← prove
   r"!u s. open s ==> open_in (subtopology euclidean u) (u INTER s)"
   (REWRITE_TAC [OPEN_IN_OPEN] THEN MESON_TAC [])

  let OPEN_OPEN_IN_TRANS ← prove
   r"!s t. open s /\ open t /\ t SUBSET s
         ==> open_in (subtopology euclidean s) t"
   (MESON_TAC [OPEN_IN_OPEN_INTER, ← SET_RULE (← q r"t SUBSET s ==> t = s INTER t")])

  let OPEN_SUBSET ← prove
   r"!s t:real^N->bool.
        s SUBSET t /\ open s ==> open_in (subtopology euclidean t) s"
   (REWRITE_TAC [← GSYM OPEN_RELATIVE_TO, RELATIVE_TO_SUBSET])

  let CLOSED_IN_DIFF_OPEN ← prove
   r"!s t. open t ==> closed_in (subtopology euclidean s) (s DIFF t)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s DIFF (s INTER t)")] THEN
    SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_REFL, OPEN_IN_OPEN_INTER])

  let CLOSED_IN_CLOSED ← prove
   r"!s:real^N->bool u.
    closed_in (subtopology euclidean u) s <=> ?t. closed t /\ (s = u INTER t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY, ← GSYM CLOSED_IN] THEN
    REWRITE_TAC [INTER_ACI])

  let CLOSED_SUBSET_EQ ← prove
   r"!u s:real^N->bool.
        closed s ==> (closed_in (subtopology euclidean u) s <=> s SUBSET u)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY],
      REWRITE_TAC [CLOSED_IN_CLOSED] THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM SET_TAC []])

  let CLOSED_IN_INTER_CLOSED ← prove
   r"!s t u:real^N->bool.
        closed_in (subtopology euclidean u) s /\ closed t
        ==> closed_in (subtopology euclidean u) (s INTER t)"
   (REWRITE_TAC [CLOSED_IN, CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED_IN])

  let CLOSED_IN_CLOSED_INTER ← prove
   r"!u s. closed s ==> closed_in (subtopology euclidean u) (u INTER s)"
   (REWRITE_TAC [CLOSED_IN_CLOSED] THEN MESON_TAC [])

  let CLOSED_SUBSET ← prove
   r"!s t:real^N->bool.
        s SUBSET t /\ closed s ==> closed_in (subtopology euclidean t) s"
   (REWRITE_TAC [← GSYM CLOSED_RELATIVE_TO, RELATIVE_TO_SUBSET])

  let OPEN_IN_DIFF_CLOSED ← prove
   r"!s t. closed t ==> open_in (subtopology euclidean s) (s DIFF t)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s DIFF (s INTER t)")] THEN
    SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL, CLOSED_IN_CLOSED_INTER])

  let open_in ← prove
   r"!u s:real^N->bool.
        open_in (subtopology euclidean u) s <=>
          s SUBSET u /\
          !x. x IN s ==> ?e. &0 < e /\
                             !x'. x' IN u /\ dist(x',x) < e ==> x' IN s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, ← GSYM OPEN_IN] THEN EQ_TAC THENL
     [REWRITE_TAC [open_def] THEN ASM SET_TAC [INTER_SUBSET, IN_INTER],
      ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"d:real^N->real")) THEN
    EXISTS_TAC (← q r"UNIONS {b | ?x:real^N. (b = ball(x,d x)) /\ x IN s}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_UNIONS THEN
      ASM_SIMP_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM, OPEN_BALL],
      GEN_REWRITE_TAC id [EXTENSION] THEN
      REWRITE_TAC [IN_INTER, IN_UNIONS, IN_ELIM_THM] THEN
      ASM_MESON_TAC [SUBSET, DIST_REFL, DIST_SYM, IN_BALL]])

  let OPEN_IN_CONTAINS_BALL ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean t) s <=>
        s SUBSET t /\
        !x. x IN s ==> ?e. &0 < e /\ ball(x,e) INTER t SUBSET s"
   (REWRITE_TAC [open_in, INTER, SUBSET, IN_ELIM_THM, IN_BALL] THEN
    MESON_TAC [DIST_SYM])

  let OPEN_IN_CONTAINS_CBALL ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean t) s <=>
        s SUBSET t /\
        !x. x IN s ==> ?e. &0 < e /\ cball(x,e) INTER t SUBSET s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_CONTAINS_BALL] THEN
    AP_TERM_TAC THEN REWRITE_TAC [IN_BALL, IN_INTER, SUBSET, IN_CBALL] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < e ==> &0 < e / &2 /\ (x <= e / &2 ==> x < e)"),
               REAL_LT_IMP_LE])

  let OPEN_IN_TRANS_EQ ← prove
   r"!s t:real^N->bool.
        (!u. open_in (subtopology euclidean t) u
             ==> open_in (subtopology euclidean s) t)
        <=> open_in (subtopology euclidean s) t"
   (MESON_TAC [OPEN_IN_TRANS, OPEN_IN_REFL])

  let OPEN_IN_OPEN_TRANS ← prove
   r"!s t. open_in (subtopology euclidean t) s /\ open t ==> open s"
   (REWRITE_TAC [← ONCE_REWRITE_RULE [← GSYM SUBTOPOLOGY_UNIV] OPEN_IN] THEN
    REWRITE_TAC [OPEN_IN_TRANS])

  let CLOSED_IN_TRANS_EQ ← prove
   r"!s t:real^N->bool.
        (!u. closed_in (subtopology euclidean t) u
             ==> closed_in (subtopology euclidean s) t)
        <=> closed_in (subtopology euclidean s) t"
   (MESON_TAC [CLOSED_IN_TRANS, CLOSED_IN_REFL])

  let CLOSED_IN_CLOSED_TRANS ← prove
   r"!s t. closed_in (subtopology euclidean t) s /\ closed t ==> closed s"
   (REWRITE_TAC [← ONCE_REWRITE_RULE [← GSYM SUBTOPOLOGY_UNIV] CLOSED_IN] THEN
    REWRITE_TAC [CLOSED_IN_TRANS])

  let OPEN_IN_OPEN_EQ ← prove
   r"!s t. open s
         ==> (open_in (subtopology euclidean s) t <=> open t /\ t SUBSET s)"
   (MESON_TAC [OPEN_OPEN_IN_TRANS, OPEN_IN_OPEN_TRANS, open_in])

  let CLOSED_IN_CLOSED_EQ ← prove
   r"!s t. closed s
         ==> (closed_in (subtopology euclidean s) t <=>
              closed t /\ t SUBSET s)"
   (MESON_TAC [CLOSED_SUBSET, CLOSED_IN_CLOSED_TRANS, closed_in,
               TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let OPEN_IN_TRANSLATION_EQ ← prove
   r"!a s t. open_in (subtopology euclidean (IMAGE (\x. a + x) t))
                   (IMAGE (\x. a + x) s) <=>
           open_in (subtopology euclidean t) s"
   (REWRITE_TAC [open_in] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [OPEN_IN_TRANSLATION_EQ]

  let CLOSED_IN_TRANSLATION_EQ ← prove
   r"!a s t. closed_in (subtopology euclidean (IMAGE (\x. a + x) t))
                   (IMAGE (\x. a + x) s) <=>
           closed_in (subtopology euclidean t) s"
   (REWRITE_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    GEOM_TRANSLATE_TAC [])

  add_translation_invariants [CLOSED_IN_TRANSLATION_EQ]

  let OPEN_IN_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s t.
          linear f /\ (!x y. f x = f y ==> x = y)
          ==> (open_in (subtopology euclidean (IMAGE f t)) (IMAGE f s) <=>
               open_in (subtopology euclidean t) s)"
   (REWRITE_TAC [open_in, FORALL_IN_IMAGE, IMP_CONJ, SUBSET] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE
     (← q r"(!x y. f x = f y ==> x = y) ==> (!x s. f x IN IMAGE f s <=> x IN s)"))) THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_BOUNDED_POS) THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_BOUNDED_BELOW_POS) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B2:real") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"B1:real") THEN STRIP_TAC THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:real^M") THEN
    REWRITE_TAC [] THEN AP_TERM_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o GSYM o MATCH_MP LINEAR_SUB) THEN
    ASM_REWRITE_TAC [dist, IMP_IMP] THEN EQ_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THENL
     [EXISTS_TAC (← q r"e / B1:real"), EXISTS_TAC (← q r"e * B2:real")] THEN
    ASM_SIMP_TAC [REAL_LT_MUL, REAL_LT_DIV] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THENL
     [MATCH_MP_TAC (← REAL_ARITH
       (← q r"norm(f x) <= B1 * norm(x) /\ norm(x) * B1 < e ==> norm(f x) < e")) THEN
      ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ],
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"norm x <= norm (f x :real^N) / B2 /\ norm(f x) / B2 < e
        ==> norm x < e")) THEN
      ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LT_LDIV_EQ]])

  add_linear_invariants [OPEN_IN_INJECTIVE_LINEAR_IMAGE]

  let CLOSED_IN_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s t.
          linear f /\ (!x y. f x = f y ==> x = y)
          ==> (closed_in (subtopology euclidean (IMAGE f t)) (IMAGE f s) <=>
               closed_in (subtopology euclidean t) s)"
   (REWRITE_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    GEOM_TRANSFORM_TAC [])

  add_linear_invariants [CLOSED_IN_INJECTIVE_LINEAR_IMAGE]

  return { OPEN_IN_OPEN, OPEN_IN_INTER_OPEN, OPEN_IN_OPEN_INTER, OPEN_OPEN_IN_TRANS,
           OPEN_SUBSET, CLOSED_IN_DIFF_OPEN, CLOSED_IN_CLOSED, CLOSED_SUBSET_EQ,
           CLOSED_IN_INTER_CLOSED, CLOSED_IN_CLOSED_INTER, CLOSED_SUBSET, OPEN_IN_DIFF_CLOSED,
           open_in, OPEN_IN_CONTAINS_BALL, OPEN_IN_CONTAINS_CBALL, OPEN_IN_TRANS_EQ,
           OPEN_IN_OPEN_TRANS, CLOSED_IN_TRANS_EQ, CLOSED_IN_CLOSED_TRANS, OPEN_IN_OPEN_EQ,
           CLOSED_IN_CLOSED_EQ, OPEN_IN_TRANSLATION_EQ, CLOSED_IN_TRANSLATION_EQ,
           OPEN_IN_INJECTIVE_LINEAR_IMAGE, CLOSED_IN_INJECTIVE_LINEAR_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Relating two variants of Euclidean space, one within product topology;    -/
/- Manhattan metric.  (topology.ml 895-1001)                                 -/
/- ------------------------------------------------------------------------- -/

structure EUS where
  HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN_GEN : thm
  HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN : thm
  HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE : thm
  manhattan : thm
  MANHATTAN : thm
  deriving Inhabited

@[nospecialize]
def setupEUS [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCWL : CWL) (BBAL : BAL) :
    ExceptT String IO EUS := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, INTRO_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { CART_EQ, EQ_IMP, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, INTER_COMM, IN_ELIM_THM, IN_INTER, IN_NUMSEG, .. } :=
    D.core2
  let { IN_UNIV, LAMBDA_BETA, LE_REFL, PAIR_EQ, REAL_ABS_0, REAL_ABS_POS, REAL_ABS_SUB,
        REAL_ABS_ZERO, .. } := D.core3
  let { REAL_POW_2, REAL_SUB_0, REAL_SUB_REFL, SIMPLE_IMAGE, SUBSET, SUBSET_NUMSEG, SUB_ADD,
        SUM_0, .. } := D.core5
  let { SUM_ADD_NUMSEG, SUM_EQ_SUPERSET, SUM_LE_NUMSEG, SUM_POS_EQ_0_NUMSEG, SUM_POS_LE, .. } :=
    D.core6
  let { IN_SPAN_IMAGE_BASIS, .. } := D.vec2
  let { NORM_EQ_1, SPAN_STDBASIS, .. } := D.vec3
  let { dot, .. } := D.vec4
  let { CONTINUOUS_MAP_COMPONENTWISE_EUCLIDEAN_SPACE, CONTINUOUS_MAP_COMPONENTWISE_UNIV,
        CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        CONTINUOUS_MAP_PRODUCT_PROJECTION, CONTINUOUS_MAP_REAL_CONST, .. } := D.met1
  let { HOMEOMORPHIC_MAPS_SUBTOPOLOGIES_ALT, MDIST, MSPACE, .. } := D.met2
  let { SUBTOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_UNIV, TOPSPACE_EUCLIDEAN_SPACE, euclidean_space,
        homeomorphic_maps, is_metric_space, nsphere, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CONTINUOUS_MAP_COMPONENTWISE_REAL, CONTINUOUS_MAP_EUCLIDEAN_COMPONENT, .. } := BCWL
  let { IN_SPHERE_0, .. } := BBAL
  -- @@SCOPE END

  let HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN_GEN ← prove
   r"!n. n <= dimindex(:N)
       ==> homeomorphic_maps
             (euclidean_space n,
              subtopology euclidean (span(IMAGE basis (1..n)):real^N->bool))
             ((\x. lambda i. if 1 <= i /\ i <= n then x i else &0),
              (\x i. if 1 <= i /\ i <= n then x$i else &0))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homeomorphic_maps] THEN
    REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_EUCLIDEAN_SPACE,
                 CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_COMPONENTWISE_UNIV,
                 CONTINUOUS_MAP_COMPONENTWISE_REAL] THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_EUCLIDEAN_COMPONENT,
              LAMBDA_BETA, CONTINUOUS_MAP_ID] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_EUCLIDEAN_SPACE] THEN
    REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN ASM_CASES_TAC (← q r"i:num <= n") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST] THEN
      SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV, euclidean_space,
                CONTINUOUS_MAP_FROM_SUBTOPOLOGY],
      X_GEN_TAC (← q r"x:num->real") THEN
      REWRITE_TAC [IN_SPAN_IMAGE_BASIS, IN_ELIM_THM, IN_NUMSEG] THEN
      SIMP_TAC [LAMBDA_BETA],
      REWRITE_TAC [IN_ELIM_THM, IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"i:num") THEN
      REWRITE_TAC [] THEN COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN
      SUBGOAL_THEN (← q r"i <= dimindex(:N)") MP_TAC THENL
       [ASM_ARITH_TAC, ASM_SIMP_TAC [LAMBDA_BETA]],
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, IN_SPAN_IMAGE_BASIS] THEN
      SIMP_TAC [CART_EQ, IN_NUMSEG, LAMBDA_BETA] THEN MESON_TAC []])

  let HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN ← prove
   r"homeomorphic_maps (euclidean_space(dimindex(:N)),euclidean:(real^N)topology)
                 ((\x. lambda i. x i),
                  (\x i. if 1 <= i /\ i <= dimindex(:N) then x$i else &0))"
   (MP_TAC (← SPEC (← q r"dimindex(:N)")
          HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN_GEN) THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, IN_NUMSEG, SPAN_STDBASIS, LE_REFL] THEN
    REWRITE_TAC [SUBTOPOLOGY_UNIV] THEN MATCH_MP_TAC EQ_IMP THEN
    BINOP_TAC THEN REWRITE_TAC [PAIR_EQ] THEN ABS_TAC THEN
    SIMP_TAC [CART_EQ, LAMBDA_BETA])

  let HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE ← prove
   r"!n. 1 <= n /\ n <= dimindex(:N)
       ==> homeomorphic_maps
            (nsphere(n - 1),
             subtopology euclidean
              (sphere(vec 0:real^N,&1) INTER span(IMAGE basis (1..n))))
            ((\x. lambda i. if 1 <= i /\ i <= n then x i else &0),
             (\x i. if 1 <= i /\ i <= n then x$i else &0))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [nsphere, SUB_ADD] THEN
    ONCE_REWRITE_TAC [INTER_COMM] THEN
    REWRITE_TAC [← GSYM SUBTOPOLOGY_SUBTOPOLOGY] THEN
    MATCH_MP_TAC HOMEOMORPHIC_MAPS_SUBTOPOLOGIES_ALT THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN_GEN] THEN
    REWRITE_TAC [SUBSET, TOPSPACE_EUCLIDEAN_SPACE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_INTER, IN_ELIM_THM, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [IN_SPHERE_0, NORM_EQ_1, dot, ← GSYM REAL_POW_2] THEN
    SUBGOAL_THEN (← q r"!j. j <= n ==> j <= dimindex(:N)") ASSUME_TAC THENL
     [ASM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [IN_NUMSEG, IN_SPAN_IMAGE_BASIS] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THENL
     [ALL_TAC, CONV_TAC SYM_CONV] THEN
    MATCH_MP_TAC SUM_EQ_SUPERSET THEN
    ASM_SIMP_TAC [FINITE_NUMSEG, SUBSET_NUMSEG, IN_NUMSEG, LAMBDA_BETA] THEN
    REWRITE_TAC [LE_REFL] THEN REPEAT STRIP_TAC THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let manhattan ← new_definition
   r"manhattan =
   metric ((:real^N), \(x,y). sum (1..dimindex(:N)) (\i. abs(x$i - y$i)))"

  let MANHATTAN ← prove
   r"mspace manhattan = (:real^N) /\
   (!x y. mdist manhattan (x:real^N,y) =
          sum (1..dimindex(:N)) (\i. abs(x$i - y$i)))"
   (SUBGOAL_THEN
      (← q r"is_metric_space
        ((:real^N), \(x,y). sum (1..dimindex(:N)) (\i. abs(x$i - y$i)))")
      (fun th => SIMP_TAC [th, manhattan, MSPACE, MDIST]) THEN
    REWRITE_TAC [is_metric_space, IN_UNIV] THEN CONJ_TAC THENL
    [REPEAT GEN_TAC THEN MATCH_MP_TAC SUM_POS_LE THEN
     REWRITE_TAC [REAL_ABS_POS],
     ALL_TAC] THEN
    CONJ_TAC THENL
    [REPEAT GEN_TAC THEN EQ_TAC THENL
     [INTRO_TAC "hp" THEN REWRITE_TAC [CART_EQ] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_SUB_0] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_ABS_ZERO] THEN
      MATCH_MP_TAC SUM_POS_EQ_0_NUMSEG THEN
      ASM_REWRITE_TAC [REAL_ABS_POS],
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [REAL_SUB_REFL, REAL_ABS_0, SUM_0]],
     ALL_TAC] THEN
    CONJ_TAC THENL [REWRITE_TAC [REAL_ABS_SUB], ALL_TAC] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM SUM_ADD_NUMSEG] THEN
    MATCH_MP_TAC SUM_LE_NUMSEG THEN REWRITE_TAC [] THEN REAL_ARITH_TAC)

  return { HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN_GEN,
           HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN, HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE,
           manhattan, MANHATTAN }

/- ------------------------------------------------------------------------- -/
/- Line segments, with open/closed overloading of (a,b) and [a,b].           -/
/- (topology.ml 1002-1240)                                                   -/
/- ------------------------------------------------------------------------- -/

structure SEG where
  closed_segment : thm
  open_segment : thm
  OPEN_SEGMENT_ALT : thm
  segment : thm
  SEGMENT_REFL : thm
  IN_SEGMENT : thm
  SEGMENT_SYM : thm
  ENDS_IN_SEGMENT : thm
  ENDS_NOT_IN_SEGMENT : thm
  SEGMENT_CLOSED_OPEN : thm
  SEGMENT_OPEN_SUBSET_CLOSED : thm
  MIDPOINT_IN_SEGMENT : thm
  BETWEEN_IN_SEGMENT : thm
  IN_SEGMENT_COMPONENT : thm
  SEGMENT_TRANSLATION : thm
  CLOSED_SEGMENT_LINEAR_IMAGE : thm
  OPEN_SEGMENT_LINEAR_IMAGE : thm
  IN_OPEN_SEGMENT : thm
  IN_OPEN_SEGMENT_ALT : thm
  COLLINEAR_DIST_IN_CLOSED_SEGMENT : thm
  COLLINEAR_DIST_IN_OPEN_SEGMENT : thm
  DIST_IN_CLOSED_SEGMENT : thm
  DIST_IN_OPEN_SEGMENT : thm
  DIST_DECREASES_OPEN_SEGMENT : thm
  DIST_DECREASES_CLOSED_SEGMENT : thm
  DIST_IN_CLOSED_SEGMENT_2 : thm
  deriving Inhabited

@[nospecialize]
def setupSEG [HolBase] (D : TopologyDeps) : ExceptT String IO SEG := do
  -- @@SCOPE BEGIN
  let { new_definition, define, make_overloadable, overload_interface, ASM_ARITH_TAC,
        ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC,
        NORM_ARITH_TAC, add_linear_invariants, add_translation_invariants,
        GEOM_BASIS_MULTIPLE_TAC, GEOM_NORMALIZE_TAC, GEOM_ORIGIN_TAC, GEOM_TRANSFORM_TAC, .. } :=
    D
  let { CONJ_ASSOC, DIMINDEX_GE_1, EXTENSION, .. } := D.core1
  let { FUN_EQ_THM, INSERT_AC, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_SING, .. } :=
    D.core2
  let { IN_UNION, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, LE_REFL, NOT_IN_EMPTY,
        REAL_ABS_NEG, REAL_ADD_LDISTRIB, .. } := D.core3
  let { REAL_CONVEX_BOUND_LE, REAL_DIV_LMUL, REAL_LE_LDIV_EQ, REAL_LE_LT, REAL_LE_RDIV_EQ,
        REAL_LE_REFL, REAL_LE_RMUL, REAL_LT_IMP_LE, REAL_LT_LE, REAL_LT_RMUL_EQ, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_RID, REAL_POS, REAL_SUB_0, REAL_SUB_LDISTRIB,
        RIGHT_AND_EXISTS_THM, .. } := D.core5
  let { real_abs, .. } := D.core6
  let { BASIS_COMPONENT, COLLINEAR_DIST_BETWEEN, DIST_EQ_0, DIST_POS_LT, DIST_SYM,
        DIST_TRIANGLE_EQ, DOT_BASIS, DOT_LMUL, DOT_LSUB, DOT_LZERO, DOT_RMUL, DOT_RSUB,
        DOT_RZERO, .. } := D.vec1
  let { LINEAR_ADD, LINEAR_CMUL, .. } := D.vec2
  let { NORM_BASIS, NORM_LT, NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_SUB, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_MUL_ASSOC,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0, VECTOR_MUL_LCANCEL_IMP, VECTOR_MUL_LID,
        VECTOR_MUL_RZERO, VECTOR_SUB_COMPONENT, VECTOR_SUB_EQ, VEC_COMPONENT, between, dist,
        midpoint, .. } := D.vec4
  -- @@SCOPE END
  let va (s : String) : ExceptT String IO thm := do VECTOR_ARITH (← q s)

  let closed_segment ← define
   r"closed_segment[a,b] = {(&1 - u) % a + u % b | &0 <= u /\ u <= &1}"

  let open_segment ← new_definition
   r"open_segment(a,b) = closed_segment[a,b] DIFF {a,b}"

  let OPEN_SEGMENT_ALT ← prove
   r"!a b:real^N.
        ~(a = b)
        ==> open_segment(a,b) = {(&1 - u) % a + u % b | &0 < u /\ u < &1}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [open_segment, closed_segment] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_INSERT, NOT_IN_EMPTY, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:real") THEN ASM_CASES_TAC (← q r"x:real^N = (&1 - u) % a + u % b") THEN
    ASM_REWRITE_TAC [REAL_LE_LT,
      ← va r"(&1 - u) % a + u % b = a <=> u % (b - a) = vec 0",
      ← va r"(&1 - u) % a + u % b = b <=> (&1 - u) % (b - a) = vec 0",
      VECTOR_MUL_EQ_0, REAL_SUB_0, VECTOR_SUB_EQ] THEN
    REAL_ARITH_TAC)

  make_overloadable "segment" (← qty "A")

  overload_interface "segment" (← q r"open_segment")
  overload_interface "segment" (← q r"closed_segment")

  let segment ← prove
   r"segment[a,b] = {(&1 - u) % a + u % b | &0 <= u /\ u <= &1} /\
   segment(a,b) = segment[a,b] DIFF {a,b}"
   (REWRITE_TAC [open_segment, closed_segment])

  let SEGMENT_REFL ← prove
   r"(!a. segment[a,a] = {a}) /\
   (!a. segment(a,a) = {})"
   (REWRITE_TAC [segment, ← va r"(&1 - u) % a + u % a = a"] THEN
    SET_TAC [REAL_POS])

  let IN_SEGMENT ← prove
   r"!a b x:real^N.
        (x IN segment[a,b] <=>
         ?u. &0 <= u /\ u <= &1 /\ x = (&1 - u) % a + u % b) /\
        (x IN segment(a,b) <=>
         ~(a = b) /\ ?u. &0 < u /\ u < &1 /\ x = (&1 - u) % a + u % b)"
   (REPEAT STRIP_TAC THENL
     [REWRITE_TAC [segment, IN_ELIM_THM, CONJ_ASSOC], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, NOT_IN_EMPTY] THEN
    ASM_SIMP_TAC [OPEN_SEGMENT_ALT, IN_ELIM_THM, CONJ_ASSOC])

  let SEGMENT_SYM ← prove
   r"(!a b:real^N. segment[a,b] = segment[b,a]) /\
   (!a b:real^N. segment(a,b) = segment(b,a))"
   (MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN
    SIMP_TAC [open_segment] THEN
    CONJ_TAC THENL [ALL_TAC, SIMP_TAC [INSERT_AC]] THEN
    REWRITE_TAC [EXTENSION, IN_SEGMENT] THEN REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"u:real")) THEN EXISTS_TAC (← q r"&1 - u") THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT CONJ_TAC THEN TRY ASM_ARITH_TAC THEN VECTOR_ARITH_TAC)

  let ENDS_IN_SEGMENT ← prove
   r"!a b. a IN segment[a,b] /\ b IN segment[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [segment, IN_ELIM_THM] THENL
     [EXISTS_TAC (← q r"&0"), EXISTS_TAC (← q r"&1")] THEN
    (CONJ_TAC THENL [REAL_ARITH_TAC, VECTOR_ARITH_TAC]))

  let ENDS_NOT_IN_SEGMENT ← prove
   r"!a b. ~(a IN segment(a,b)) /\ ~(b IN segment(a,b))"
   (REWRITE_TAC [open_segment] THEN SET_TAC [])

  let SEGMENT_CLOSED_OPEN ← prove
   r"!a b. segment[a,b] = segment(a,b) UNION {a,b}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_segment] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"a IN s /\ b IN s ==> s = (s DIFF {a,b}) UNION {a,b}")) THEN
    REWRITE_TAC [ENDS_IN_SEGMENT])

  let SEGMENT_OPEN_SUBSET_CLOSED ← prove
   r"!a b. segment(a,b) SUBSET segment[a,b]"
   (REWRITE_TAC [← CONJUNCT2 (← SPEC_ALL segment)] THEN SET_TAC [])

  let MIDPOINT_IN_SEGMENT ← prove
   r"(!a b:real^N. midpoint(a,b) IN segment[a,b]) /\
   (!a b:real^N. midpoint(a,b) IN segment(a,b) <=> ~(a = b))"
   (REWRITE_TAC [IN_SEGMENT] THEN REPEAT STRIP_TAC THENL
     [ALL_TAC, ASM_CASES_TAC (← q r"a:real^N = b") THEN ASM_REWRITE_TAC []] THEN
    EXISTS_TAC (← q r"&1 / &2") THEN REWRITE_TAC [midpoint] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN VECTOR_ARITH_TAC)

  let BETWEEN_IN_SEGMENT ← prove
   r"!x a b:real^N. between x (a,b) <=> x IN segment[a,b]"
   (REPEAT GEN_TAC THEN REWRITE_TAC [between] THEN
    ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, IN_SING] THENL [NORM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [segment, IN_ELIM_THM] THEN EQ_TAC THENL
     [DISCH_THEN (ASSUME_TAC o SYM) THEN
      EXISTS_TAC (← q r"dist(a:real^N,x) / dist(a,b)") THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, DIST_POS_LT] THEN CONJ_TAC
      THENL [FIRST_ASSUM (SUBST1_TAC o SYM) THEN NORM_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC VECTOR_MUL_LCANCEL_IMP THEN EXISTS_TAC (← q r"dist(a:real^N,b)") THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, VECTOR_ADD_LDISTRIB, REAL_SUB_LDISTRIB,
                    REAL_DIV_LMUL, DIST_EQ_0] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [DIST_TRIANGLE_EQ] o SYM) THEN
      FIRST_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [dist, ← REAL_ARITH (← q r"(a + b) * &1 - a = b")] THEN
      VECTOR_ARITH_TAC,
      STRIP_TAC THEN ASM_REWRITE_TAC [dist] THEN
      REWRITE_TAC [← va r"a - ((&1 - u) % a + u % b) = u % (a - b)",
                   ← va r"((&1 - u) % a + u % b) - b = (&1 - u) % (a - b)",
                   NORM_MUL, ← GSYM REAL_ADD_LDISTRIB] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => REAL_FIELD t)])

  let IN_SEGMENT_COMPONENT ← prove
   r"!a b x:real^N i.
        x IN segment[a,b] /\ 1 <= i /\ i <= dimindex(:N)
        ==> min (a$i) (b$i) <= x$i /\ x$i <= max (a$i) (b$i)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_SEGMENT]) THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"t:real") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
    SIMP_TAC [← REAL_ARITH (← q r"c <= u * a + t * b <=> u * --a + t * --b <= --c")] THEN
    MATCH_MP_TAC REAL_CONVEX_BOUND_LE THEN ASM_REAL_ARITH_TAC)

  let SEGMENT_TRANSLATION ← prove
   r"(!c a b. segment[c + a,c + b] = IMAGE (\x. c + x) (segment[a,b])) /\
   (!c a b. segment(c + a,c + b) = IMAGE (\x. c + x) (segment(a,b)))"
   (REWRITE_TAC [EXTENSION, IN_SEGMENT, IN_IMAGE] THEN
    REWRITE_TAC [← va r"(&1 - u) % (c + a) + u % (c + b) =
                              c + (&1 - u) % a + u % b"] THEN
    REWRITE_TAC [← va r"c + a:real^N = c + b <=> a = b"] THEN
    MESON_TAC [])

  add_translation_invariants
   [← CONJUNCT1 SEGMENT_TRANSLATION, ← CONJUNCT2 SEGMENT_TRANSLATION]

  let CLOSED_SEGMENT_LINEAR_IMAGE ← prove
   r"!f a b. linear f
           ==> segment[f a,f b] = IMAGE f (segment[a,b])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [EXTENSION, IN_IMAGE, IN_SEGMENT] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_CMUL th)])) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_ADD th)])) THEN
    MESON_TAC [])

  add_linear_invariants [CLOSED_SEGMENT_LINEAR_IMAGE]

  let OPEN_SEGMENT_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N a b.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> segment(f a,f b) = IMAGE f (segment(a,b))"
   (REWRITE_TAC [open_segment] THEN GEOM_TRANSFORM_TAC [])

  add_linear_invariants [OPEN_SEGMENT_LINEAR_IMAGE]

  let IN_OPEN_SEGMENT ← prove
   r"!a b x:real^N.
        x IN segment(a,b) <=> x IN segment[a,b] /\ ~(x = a) /\ ~(x = b)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_segment, IN_DIFF] THEN SET_TAC [])

  let IN_OPEN_SEGMENT_ALT ← prove
   r"!a b x:real^N.
        x IN segment(a,b) <=>
        x IN segment[a,b] /\ ~(x = a) /\ ~(x = b) /\ ~(a = b)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, IN_SING, NOT_IN_EMPTY] THEN
    ASM_MESON_TAC [IN_OPEN_SEGMENT])

  let COLLINEAR_DIST_IN_CLOSED_SEGMENT ← prove
   r"!a b x. collinear {x,a,b} /\
           dist(x,a) <= dist(a,b) /\ dist(x,b) <= dist(a,b)
           ==> x IN segment[a,b]"
   (REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT, COLLINEAR_DIST_BETWEEN])

  let COLLINEAR_DIST_IN_OPEN_SEGMENT ← prove
   r"!a b x. collinear {x,a,b} /\
           dist(x,a) < dist(a,b) /\ dist(x,b) < dist(a,b)
           ==> x IN segment(a,b)"
   (REWRITE_TAC [IN_OPEN_SEGMENT] THEN
    MESON_TAC [COLLINEAR_DIST_IN_CLOSED_SEGMENT, REAL_LT_LE, DIST_SYM])

  let (DIST_IN_CLOSED_SEGMENT, DIST_IN_OPEN_SEGMENT) ← CONJ_PAIR (← prove
   r"(!a b x:real^N.
    x IN segment[a,b] ==> dist(x,a) <= dist(a,b) /\ dist(x,b) <= dist(a,b)) /\
   (!a b x:real^N.
    x IN segment(a,b) ==> dist(x,a) < dist(a,b) /\ dist(x,b) < dist(a,b))"
   (SIMP_TAC [IN_SEGMENT, RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, dist,
              ← va r"((&1 - u) % a + u % b) - a:real^N = u % (b - a) /\
       ((&1 - u) % a + u % b) - b = --(&1 - u) % (b - a)"] THEN
    REWRITE_TAC [NORM_MUL, REAL_ABS_NEG, NORM_SUB] THEN CONJ_TAC THEN
    REPEAT GEN_TAC THEN STRIP_TAC THENL
     [REWRITE_TAC [← REAL_ARITH (← q r"x * y <= y <=> x * y <= &1 * y")] THEN
      CONJ_TAC THEN MATCH_MP_TAC REAL_LE_RMUL THEN
      REWRITE_TAC [NORM_POS_LE] THEN ASM_REAL_ARITH_TAC,
      REWRITE_TAC [← REAL_ARITH (← q r"x * y < y <=> x * y < &1 * y")] THEN
      ASM_SIMP_TAC [REAL_LT_RMUL_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
      ASM_REAL_ARITH_TAC]))

  let DIST_DECREASES_OPEN_SEGMENT ← prove
   r"!a b c x:real^N.
      x IN segment(a,b) ==> dist(c,x) < dist(c,a) \/ dist(c,x) < dist(c,b)"
   (GEOM_ORIGIN_TAC (← q r"a:real^N") THEN GEOM_NORMALIZE_TAC (← q r"b:real^N") THEN
    REWRITE_TAC [SEGMENT_REFL, NOT_IN_EMPTY] THEN X_GEN_TAC (← q r"b:real^N") THEN
    GEOM_BASIS_MULTIPLE_TAC 1 (← q r"b:real^N") THEN X_GEN_TAC (← q r"b:real") THEN
    SIMP_TAC [NORM_MUL, NORM_BASIS, real_abs, DIMINDEX_GE_1, LE_REFL,
              REAL_MUL_RID, VECTOR_MUL_LID] THEN
    REPEAT (DISCH_THEN (K ALL_TAC : thm → tactic)) THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [IN_SEGMENT, dist] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
    SUBGOAL_THEN
     (← q r"norm((c$1 - u) % basis 1:real^N) < norm((c:real^N)$1 % basis 1:real^N) \/
      norm((c$1 - u) % basis 1:real^N) < norm((c$1 - &1) % basis 1:real^N)")
    MP_TAC THENL
     [SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
      ASM_REAL_ARITH_TAC,
      ASM_SIMP_TAC [NORM_LT, DOT_LMUL, DOT_RMUL, DOT_BASIS, DIMINDEX_GE_1,
                DOT_LSUB, DOT_RSUB, LE_REFL, VECTOR_MUL_COMPONENT, VEC_COMPONENT,
                BASIS_COMPONENT, DOT_LZERO, DOT_RZERO, VECTOR_SUB_COMPONENT] THEN
      ASM_REAL_ARITH_TAC])

  let DIST_DECREASES_CLOSED_SEGMENT ← prove
   r"!a b c x:real^N.
      x IN segment[a,b] ==> dist(c,x) <= dist(c,a) \/ dist(c,x) <= dist(c,b)"
   (REWRITE_TAC [SEGMENT_CLOSED_OPEN, IN_UNION, IN_INSERT, NOT_IN_EMPTY] THEN
    ASM_MESON_TAC [DIST_DECREASES_OPEN_SEGMENT, REAL_LE_REFL, REAL_LT_IMP_LE])

  let DIST_IN_CLOSED_SEGMENT_2 ← prove
   r"!a b x y:real^N.
        x IN segment[a,b] /\ y IN segment[a,b] ==> dist(x,y) <= dist(a,b)"
   (REWRITE_TAC [IN_SEGMENT, dist] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [NORM_MUL, ← va
     r"((&1 - u) % a + u % b) - ((&1 - v) % a + v % b):real^N =
      (v - u) % (a - b)"] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
    ASM_REAL_ARITH_TAC)

  return { closed_segment, open_segment, OPEN_SEGMENT_ALT, segment, SEGMENT_REFL, IN_SEGMENT,
           SEGMENT_SYM, ENDS_IN_SEGMENT, ENDS_NOT_IN_SEGMENT, SEGMENT_CLOSED_OPEN,
           SEGMENT_OPEN_SUBSET_CLOSED, MIDPOINT_IN_SEGMENT, BETWEEN_IN_SEGMENT,
           IN_SEGMENT_COMPONENT, SEGMENT_TRANSLATION, CLOSED_SEGMENT_LINEAR_IMAGE,
           OPEN_SEGMENT_LINEAR_IMAGE, IN_OPEN_SEGMENT, IN_OPEN_SEGMENT_ALT,
           COLLINEAR_DIST_IN_CLOSED_SEGMENT, COLLINEAR_DIST_IN_OPEN_SEGMENT,
           DIST_IN_CLOSED_SEGMENT, DIST_IN_OPEN_SEGMENT, DIST_DECREASES_OPEN_SEGMENT,
           DIST_DECREASES_CLOSED_SEGMENT, DIST_IN_CLOSED_SEGMENT_2 }

/- ------------------------------------------------------------------------- -/
/- Connectedness.  (topology.ml 1241-1600)                                   -/
/- ------------------------------------------------------------------------- -/

structure CON where
  connected : thm
  CONNECTED_IN_EUCLIDEAN : thm
  CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY : thm
  CONNECTED_CLOSED : thm
  CONNECTED_OPEN_IN : thm
  CONNECTED_OPEN_IN_EQ : thm
  CONNECTED_CLOSED_IN : thm
  CONNECTED_CLOSED_IN_EQ : thm
  CONNECTED_CLOPEN : thm
  CONNECTED_CLOSED_SET : thm
  CONNECTED_OPEN_SET : thm
  CONNECTED_IFF_CONNECTABLE_POINTS : thm
  CONNECTED_EMPTY : thm
  CONNECTED_SING : thm
  CONNECTED_SEGMENT : thm
  CONNECTED_UNIV : thm
  CLOPEN : thm
  CONNECTED_UNIONS : thm
  CONNECTED_UNION : thm
  CONNECTED_DIFF_OPEN_FROM_CLOSED : thm
  CONNECTED_DISJOINT_UNIONS_OPEN_UNIQUE : thm
  CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL : thm
  CONNECTED_FROM_OPEN_UNION_AND_INTER_LOCAL : thm
  CONNECTED_FROM_CLOSED_UNION_AND_INTER : thm
  CONNECTED_FROM_OPEN_UNION_AND_INTER : thm
  deriving Inhabited

@[nospecialize]
def setupCON [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BCWL : CWL) (BLOC : LOC)
    (BSEG : SEG) : ExceptT String IO CON := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ACI, CONJ_ASSOC, DE_MORGAN_THM, DISJOINT, EMPTY_UNIONS, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, INTERS_2, INTER_ACI, INTER_COMM, INTER_EMPTY, INTER_UNIONS,
        INTER_UNIV, IN_DELETE, IN_INTER, IN_INTERS, .. } := D.core2
  let { IN_UNIONS, IN_UNIV, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, .. } := D.core3
  let { SUBSET_REFL, SUBSET_UNIV, .. } := D.core5
  let { UNIONS_2, UNIONS_INSERT, UNION_ACI, UNION_COMM, pairwise, .. } := D.core6
  let { real_interval, .. } := D.misc
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, .. } := D.vec4
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_SUBSET_TRANS, CLOSED_IN_TRANS, CLOSED_IN_UNION,
        CONNECTED_IN, CONNECTED_IN_CLOSED_IN, CONNECTED_IN_CONTINUOUS_MAP_IMAGE,
        CONNECTED_IN_EUCLIDEANREAL_INTERVAL, CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_TOPSPACE,
        CONNECTED_SPACE_CLOPEN_IN, CONNECTED_SPACE_CLOSED_IN, CONNECTED_SPACE_CLOSED_IN_EQ,
        CONNECTED_SPACE_EQ, CONNECTED_SPACE_SUBCONNECTED, CONTINUOUS_MAP_CONST,
        CONTINUOUS_MAP_ID, CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_RMUL,
        CONTINUOUS_MAP_REAL_SUB, .. } := D.met1
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_SUBSET_TRANS, OPEN_IN_TRANS, OPEN_IN_UNION,
        SUBTOPOLOGY_UNIV, TOPSPACE_EUCLIDEANREAL, connected_in, connected_space, .. } := D.met3
  let { OPEN_EMPTY, OPEN_IN, OPEN_UNIONS, OPEN_UNIV, TOPSPACE_EUCLIDEAN,
        TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_EMPTY, CLOSED_IN, CLOSED_UNIV, OPEN_DIFF, OPEN_UNION, .. } := BCLO
  let { CONTINUOUS_MAP_COMPONENTWISE_REAL, .. } := BCWL
  let { CLOSED_IN_CLOSED, CLOSED_IN_CLOSED_EQ, OPEN_IN_OPEN, OPEN_IN_OPEN_EQ, .. } := BLOC
  let { ENDS_IN_SEGMENT, IN_SEGMENT, SEGMENT_REFL, .. } := BSEG
  -- @@SCOPE END

  let connected ← new_definition
   r"connected s <=>
      ~(?e1 e2. open e1 /\ open e2 /\ s SUBSET (e1 UNION e2) /\
                (e1 INTER e2 INTER s = {}) /\
                ~(e1 INTER s = {}) /\ ~(e2 INTER s = {}))"

  let CONNECTED_IN_EUCLIDEAN ← prove
   r"!s:real^N->bool. connected_in euclidean s <=> connected s"
   (REWRITE_TAC [CONNECTED_IN, connected] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, ← GSYM OPEN_IN, SUBSET_UNIV, INTER_UNIV])

  let CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY ← prove
   r"!s:real^N->bool.
       connected_space(subtopology euclidean s) <=> connected s"
   (REWRITE_TAC [← GSYM CONNECTED_IN_TOPSPACE] THEN
    REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [CONNECTED_IN_EUCLIDEAN] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_REFL])

  let CONNECTED_CLOSED ← prove
   r"!s:real^N->bool.
        connected s <=>
        ~(?e1 e2. closed e1 /\ closed e2 /\ s SUBSET (e1 UNION e2) /\
                  (e1 INTER e2 INTER s = {}) /\
                  ~(e1 INTER s = {}) /\ ~(e2 INTER s = {}))"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN] THEN
    REWRITE_TAC [CONNECTED_IN_CLOSED_IN, CLOSED_IN] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, INTER_UNIV, SUBSET_UNIV, INTER_ACI])

  let CONNECTED_OPEN_IN ← prove
   r"!s. connected s <=>
           ~(?e1 e2.
                 open_in (subtopology euclidean s) e1 /\
                 open_in (subtopology euclidean s) e2 /\
                 s SUBSET e1 UNION e2 /\
                 e1 INTER e2 = {} /\
                 ~(e1 = {}) /\
                 ~(e2 = {}))"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, connected_in] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    REWRITE_TAC [connected_space, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CONNECTED_OPEN_IN_EQ ← prove
   r"!s. connected s <=>
           ~(?e1 e2.
                 open_in (subtopology euclidean s) e1 /\
                 open_in (subtopology euclidean s) e2 /\
                 e1 UNION e2 = s /\ e1 INTER e2 = {} /\
                 ~(e1 = {}) /\ ~(e2 = {}))"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, connected_in] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    REWRITE_TAC [CONNECTED_SPACE_EQ, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CONNECTED_CLOSED_IN ← prove
   r"!s. connected s <=>
           ~(?e1 e2.
                 closed_in (subtopology euclidean s) e1 /\
                 closed_in (subtopology euclidean s) e2 /\
                 s SUBSET e1 UNION e2 /\
                 e1 INTER e2 = {} /\
                 ~(e1 = {}) /\
                 ~(e2 = {}))"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, connected_in] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    REWRITE_TAC [CONNECTED_SPACE_CLOSED_IN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CONNECTED_CLOSED_IN_EQ ← prove
   r"!s. connected s <=>
           ~(?e1 e2.
                 closed_in (subtopology euclidean s) e1 /\
                 closed_in (subtopology euclidean s) e2 /\
                 e1 UNION e2 = s /\ e1 INTER e2 = {} /\
                 ~(e1 = {}) /\ ~(e2 = {}))"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, connected_in] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    REWRITE_TAC [CONNECTED_SPACE_CLOSED_IN_EQ, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CONNECTED_CLOPEN ← prove
   r"!s. connected s <=>
        !t. open_in (subtopology euclidean s) t /\
            closed_in (subtopology euclidean s) t ==> t = {} \/ t = s"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, connected_in] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    REWRITE_TAC [CONNECTED_SPACE_CLOPEN_IN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CONNECTED_CLOSED_SET ← prove
   r"!s:real^N->bool.
        closed s
        ==> (connected s <=>
             ~(?e1 e2. closed e1 /\ closed e2 /\ ~(e1 = {}) /\ ~(e2 = {}) /\
                       e1 UNION e2 = s /\ e1 INTER e2 = {}))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONNECTED_CLOSED_IN_EQ] THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSED_EQ] THEN AP_TERM_TAC THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN SET_TAC [])

  let CONNECTED_OPEN_SET ← prove
   r"!s:real^N->bool.
        open s
        ==> (connected s <=>
             ~(?e1 e2. open e1 /\ open e2 /\ ~(e1 = {}) /\ ~(e2 = {}) /\
                       e1 UNION e2 = s /\ e1 INTER e2 = {}))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONNECTED_OPEN_IN_EQ] THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_EQ] THEN AP_TERM_TAC THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN SET_TAC [])

  let CONNECTED_IFF_CONNECTABLE_POINTS ← prove
   r"!s:real^N->bool.
        connected s <=>
        !a b. a IN s /\ b IN s
              ==> ?t. connected t /\ t SUBSET s /\ a IN t /\ b IN t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN] THEN
    GEN_REWRITE_TAC LAND_CONV [connected_in] THEN
    REWRITE_TAC [CONNECTED_SPACE_SUBCONNECTED, TOPSPACE_EUCLIDEAN, SUBSET_UNIV,
                 TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, ← GSYM CONJ_ASSOC])

  let CONNECTED_EMPTY ← prove
   r"connected {}"
   (REWRITE_TAC [connected, INTER_EMPTY])

  let CONNECTED_SING ← prove
   r"!a. connected{a}"
   (REWRITE_TAC [connected] THEN SET_TAC [])

  let CONNECTED_SEGMENT ← prove
   r"(!a b:real^N. connected(segment[a,b])) /\
   (!a b:real^N. connected(segment(a,b)))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THEN
    ASM_SIMP_TAC [SEGMENT_REFL, CONNECTED_EMPTY, CONNECTED_SING] THEN
    GEN_REWRITE_TAC RAND_CONV [← SET_RULE (← q r"s = {x | x IN s}")] THEN
    ASM_REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, IN_SEGMENT, ← SET_RULE
     (← q r"{x | ?u. P u /\ Q u /\ x = f u} = IMAGE f {u | P u /\ Q u}")] THEN
    MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
    EXISTS_TAC (← q r"euclideanreal") THEN
    REWRITE_TAC [← GSYM real_interval, CONNECTED_IN_EUCLIDEANREAL_INTERVAL] THEN
    REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_REAL] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_ADD THEN CONJ_TAC THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_RMUL THEN
    TRY (MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB) THEN
    REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, IN_UNIV])

  let CONNECTED_UNIV ← prove
   r"connected(:real^N)"
   (ONCE_REWRITE_TAC [CONNECTED_IFF_CONNECTABLE_POINTS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV] THEN
    EXISTS_TAC (← q r"segment[a:real^N,b]") THEN
    ASM_REWRITE_TAC [CONNECTED_SEGMENT, ENDS_IN_SEGMENT])

  let CLOPEN ← prove
   r"!s. closed s /\ open s <=> s = {} \/ s = (:real^N)"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [CLOSED_EMPTY, OPEN_EMPTY, CLOSED_UNIV, OPEN_UNIV] THEN
    MATCH_MP_TAC (← REWRITE_RULE [CONNECTED_CLOPEN] CONNECTED_UNIV) THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN, ← GSYM CLOSED_IN])

  let CONNECTED_UNIONS ← prove
   r"!P:(real^N->bool)->bool.
        (!s. s IN P ==> connected s) /\ ~(INTERS P = {})
        ==> connected(UNIONS P)"
   (GEN_TAC THEN REWRITE_TAC [connected, NOT_EXISTS_THM] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"e1:real^N->bool", ← q r"e2:real^N->bool"] THEN
    STRIP_TAC THEN UNDISCH_TAC (← q r"~(INTERS P :real^N->bool = {})") THEN
    PURE_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTERS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"(a:real^N) IN e1 \/ a IN e2") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [],
      UNDISCH_TAC (← q r"~(e2 INTER UNIONS P:real^N->bool = {})"),
      UNDISCH_TAC (← q r"~(e1 INTER UNIONS P:real^N->bool = {})")] THEN
    PURE_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_UNIONS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N")
     (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^N->bool") STRIP_ASSUME_TAC) THEN
    UNDISCH_TAC (← q r"!t:real^N->bool. t IN P ==> a IN t") THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"e1:real^N->bool", ← q r"e2:real^N->bool"]) THEN
    ASM SET_TAC [])

  let CONNECTED_UNION ← prove
   r"!s t:real^N->bool.
        connected s /\ connected t /\ ~(s INTER t = {})
        ==> connected (s UNION t)"
   (REWRITE_TAC [← GSYM UNIONS_2, ← GSYM INTERS_2] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_UNIONS THEN
    ASM SET_TAC [])

  let CONNECTED_DIFF_OPEN_FROM_CLOSED ← prove
   r"!s t u:real^N->bool.
        s SUBSET t /\ t SUBSET u /\
        open s /\ closed t /\ connected u /\ connected(t DIFF s)
        ==> connected(u DIFF s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [connected, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"w:real^N->bool"] THEN STRIP_TAC THEN
    UNDISCH_TAC (← q r"connected(t DIFF s:real^N->bool)") THEN SIMP_TAC [connected] THEN
    MAP_EVERY EXISTS_TAC [← q r"v:real^N->bool", ← q r"w:real^N->bool"] THEN
    ASM_REWRITE_TAC [] THEN
    REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    POP_ASSUM_LIST (MP_TAC o end_itlist CONJ) THEN
    MAP_EVERY (fun t => SPEC_TAC (t, t)) [← q r"v:real^N->bool", ← q r"w:real^N->bool"] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!v w. P v w ==> P w v) /\ (!w v. P v w /\ Q w ==> F)
      ==> !w v. P v w ==> ~(Q v) /\ ~(Q w)")) THEN
    CONJ_TAC THENL [SIMP_TAC [CONJ_ACI, INTER_ACI, UNION_ACI], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [connected]) THEN SIMP_TAC [] THEN
    MAP_EVERY EXISTS_TAC [← q r"v UNION s:real^N->bool", ← q r"w DIFF t:real^N->bool"] THEN
    ASM_SIMP_TAC [OPEN_UNION, OPEN_DIFF] THEN ASM SET_TAC [])

  let CONNECTED_DISJOINT_UNIONS_OPEN_UNIQUE ← prove
   r"!f:(real^N->bool)->bool f'.
         pairwise DISJOINT f /\ pairwise DISJOINT f' /\
        (!s. s IN f ==> open s /\ connected s /\ ~(s = {})) /\
        (!s. s IN f' ==> open s /\ connected s /\ ~(s = {})) /\
        UNIONS f = UNIONS f'
        ==> f = f'"
   (GEN_REWRITE_TAC (funpow 2 BINDER_CONV o RAND_CONV) [EXTENSION] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!s t. P s t ==> P t s) /\ (!s t x. P s t /\ x IN s ==> x IN t)
      ==> (!s t. P s t ==> (!x. x IN s <=> x IN t))")) THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    GEN_TAC THEN GEN_TAC THEN X_GEN_TAC (← q r"s:real^N->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?t a:real^N. t IN f' /\ a IN s /\ a IN t") STRIP_ASSUME_TAC
    THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"s:real^N->bool = t") (fun th => ASM_REWRITE_TAC [th]) THEN
    REWRITE_TAC [EXTENSION] THEN
    POP_ASSUM_LIST (MP_TAC o end_itlist CONJ) THEN
    MAP_EVERY (fun t => SPEC_TAC (t, t))
     [← q r"s:real^N->bool", ← q r"t:real^N->bool",
      ← q r"f:(real^N->bool)->bool", ← q r"f':(real^N->bool)->bool"] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!f f' s t. P f f' s t ==> P f' f t s) /\
      (!f f' s t x. P f f' s t /\ x IN s ==> x IN t)
      ==> (!f' f t s. P f f' s t ==> (!x. x IN s <=> x IN t))")) THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    REPLICATE_TAC 4 GEN_TAC THEN X_GEN_TAC (← q r"b:real^N") THEN STRIP_TAC THEN
    UNDISCH_TAC
     (← q r"!s:real^N->bool. s IN f ==> open s /\ connected s /\ ~(s = {})") THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN ASM_CASES_TAC (← q r"(b:real^N) IN t") THEN
    ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"connected(s:real^N->bool)") THEN
    REWRITE_TAC [connected] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"t:real^N->bool", ← q r"UNIONS(f' DELETE (t:real^N->bool))"] THEN
    REPEAT STRIP_TAC THENL
     [ASM_SIMP_TAC [],
      MATCH_MP_TAC OPEN_UNIONS THEN ASM_SIMP_TAC [IN_DELETE],
      REWRITE_TAC [← GSYM UNIONS_INSERT] THEN ASM SET_TAC [],
      MATCH_MP_TAC (← SET_RULE (← q r"t INTER u = {} ==> t INTER u INTER s = {}")) THEN
      REWRITE_TAC [INTER_UNIONS, EMPTY_UNIONS, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [IN_DELETE, ← GSYM DISJOINT] THEN ASM_MESON_TAC [pairwise],
      ASM SET_TAC [],
      ASM SET_TAC []])

  let CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL ← prove
   r"!u s t:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        connected(s UNION t) /\ connected(s INTER t)
        ==> connected s /\ connected t"
   (GEN_TAC THEN MATCH_MP_TAC (← MESON []
     (← q r"(!s t. P s t ==> P t s) /\ (!s t. P s t ==> Q s)
      ==> !s t. P s t ==> Q s /\ Q t")) THEN
    CONJ_TAC THENL [SIMP_TAC [UNION_COMM, INTER_COMM], REPEAT STRIP_TAC] THEN
    REWRITE_TAC [CONNECTED_CLOSED_IN, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N->bool", ← q r"b:real^N->bool"] THEN
    STRIP_TAC THEN ASM_CASES_TAC
     (← q r"~(s INTER t SUBSET (a:real^N->bool)) /\ ~(s INTER t SUBSET b)")
    THENL
     [UNDISCH_TAC (← q r"connected(s INTER t:real^N->bool)") THEN
      ASM_SIMP_TAC [CONNECTED_CLOSED_IN] THEN
      MAP_EVERY EXISTS_TAC
       [← q r"t INTER a:real^N->bool", ← q r"t INTER b:real^N->bool"] THEN
      GEN_REWRITE_TAC id [CONJ_ASSOC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"closed_in (subtopology euclidean s) (a:real^N->bool)"),
        UNDISCH_TAC (← q r"closed_in (subtopology euclidean s) (b:real^N->bool)")] THEN
      REWRITE_TAC [CLOSED_IN_CLOSED] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [DE_MORGAN_THM]) THEN
      REWRITE_TAC [] THEN STRIP_TAC THEN
      UNDISCH_TAC (← q r"connected(s UNION t:real^N->bool)") THEN
      ASM_SIMP_TAC [CONNECTED_CLOSED_IN] THENL
       [MAP_EVERY EXISTS_TAC [← q r"t UNION a:real^N->bool", ← q r"b:real^N->bool"],
        MAP_EVERY EXISTS_TAC [← q r"t UNION b:real^N->bool", ← q r"a:real^N->bool"]] THEN
      (GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
        [ALL_TAC,
         REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET)) THEN
         ASM SET_TAC []] THEN
       CONJ_TAC THENL [MATCH_MP_TAC CLOSED_IN_UNION THEN CONJ_TAC, ALL_TAC] THEN
       MATCH_MP_TAC CLOSED_IN_SUBSET_TRANS THEN EXISTS_TAC (← q r"u:real^N->bool") THEN
       (CONJ_TAC THENL [ASM_MESON_TAC [CLOSED_IN_TRANS], ALL_TAC]) THEN
       REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET)) THEN
       ASM SET_TAC [])])

  let CONNECTED_FROM_OPEN_UNION_AND_INTER_LOCAL ← prove
   r"!u s t:real^N->bool.
        open_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) t /\
        connected(s UNION t) /\ connected(s INTER t)
        ==> connected s /\ connected t"
   (GEN_TAC THEN MATCH_MP_TAC (← MESON []
     (← q r"(!s t. P s t ==> P t s) /\ (!s t. P s t ==> Q s)
      ==> !s t. P s t ==> Q s /\ Q t")) THEN
    CONJ_TAC THENL [SIMP_TAC [UNION_COMM, INTER_COMM], REPEAT STRIP_TAC] THEN
    REWRITE_TAC [CONNECTED_OPEN_IN, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N->bool", ← q r"b:real^N->bool"] THEN
    STRIP_TAC THEN ASM_CASES_TAC
     (← q r"~(s INTER t SUBSET (a:real^N->bool)) /\ ~(s INTER t SUBSET b)")
    THENL
     [UNDISCH_TAC (← q r"connected(s INTER t:real^N->bool)") THEN
      ASM_SIMP_TAC [CONNECTED_OPEN_IN] THEN
      MAP_EVERY EXISTS_TAC
       [← q r"t INTER a:real^N->bool", ← q r"t INTER b:real^N->bool"] THEN
      GEN_REWRITE_TAC id [CONJ_ASSOC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"open_in (subtopology euclidean s) (a:real^N->bool)"),
        UNDISCH_TAC (← q r"open_in (subtopology euclidean s) (b:real^N->bool)")] THEN
      REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [DE_MORGAN_THM]) THEN
      REWRITE_TAC [] THEN STRIP_TAC THEN
      UNDISCH_TAC (← q r"connected(s UNION t:real^N->bool)") THEN
      ASM_SIMP_TAC [CONNECTED_OPEN_IN] THENL
       [MAP_EVERY EXISTS_TAC [← q r"t UNION a:real^N->bool", ← q r"b:real^N->bool"],
        MAP_EVERY EXISTS_TAC [← q r"t UNION b:real^N->bool", ← q r"a:real^N->bool"]] THEN
      (GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
        [ALL_TAC,
         REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
         ASM SET_TAC []] THEN
       CONJ_TAC THENL [MATCH_MP_TAC OPEN_IN_UNION THEN CONJ_TAC, ALL_TAC] THEN
       MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN EXISTS_TAC (← q r"u:real^N->bool") THEN
       (CONJ_TAC THENL [ASM_MESON_TAC [OPEN_IN_TRANS], ALL_TAC]) THEN
       REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
       ASM SET_TAC [])])

  let CONNECTED_FROM_CLOSED_UNION_AND_INTER ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\ connected(s UNION t) /\ connected(s INTER t)
        ==> connected s /\ connected t"
   (ONCE_REWRITE_TAC [CLOSED_IN] THEN ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL])

  let CONNECTED_FROM_OPEN_UNION_AND_INTER ← prove
   r"!s t:real^N->bool.
        open s /\ open t /\ connected(s UNION t) /\ connected(s INTER t)
        ==> connected s /\ connected t"
   (ONCE_REWRITE_TAC [OPEN_IN] THEN ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [CONNECTED_FROM_OPEN_UNION_AND_INTER_LOCAL])

  return { connected, CONNECTED_IN_EUCLIDEAN, CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY,
           CONNECTED_CLOSED, CONNECTED_OPEN_IN, CONNECTED_OPEN_IN_EQ, CONNECTED_CLOSED_IN,
           CONNECTED_CLOSED_IN_EQ, CONNECTED_CLOPEN, CONNECTED_CLOSED_SET, CONNECTED_OPEN_SET,
           CONNECTED_IFF_CONNECTABLE_POINTS, CONNECTED_EMPTY, CONNECTED_SING, CONNECTED_SEGMENT,
           CONNECTED_UNIV, CLOPEN, CONNECTED_UNIONS, CONNECTED_UNION,
           CONNECTED_DIFF_OPEN_FROM_CLOSED, CONNECTED_DISJOINT_UNIONS_OPEN_UNIQUE,
           CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL, CONNECTED_FROM_OPEN_UNION_AND_INTER_LOCAL,
           CONNECTED_FROM_CLOSED_UNION_AND_INTER, CONNECTED_FROM_OPEN_UNION_AND_INTER }

/- ------------------------------------------------------------------------- -/
/- Sort of induction principle for connected sets; limit points.            -/
/- (topology.ml 1601-1940)                                                   -/
/- ------------------------------------------------------------------------- -/

structure LPT where
  CONNECTED_INDUCTION : thm
  CONNECTED_EQUIVALENCE_RELATION_GEN : thm
  CONNECTED_INDUCTION_SIMPLE : thm
  CONNECTED_EQUIVALENCE_RELATION : thm
  LOCALLY_CONSTANT_IMP_CONSTANT : thm
  limit_point_of : thm
  EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF : thm
  LIMIT_POINT_IN_DERIVED_SET : thm
  LIMPT_SUBSET : thm
  LIMPT_APPROACHABLE : thm
  LIMPT_APPROACHABLE_LE : thm
  DISCRETE_SET : thm
  CLOSED_LIMPT : thm
  LIMPT_EMPTY : thm
  NO_LIMIT_POINT_IMP_CLOSED : thm
  CLOSED_POSITIVE_ORTHANT : thm
  FINITE_SET_AVOID : thm
  LIMIT_POINT_FINITE : thm
  LIMPT_SING : thm
  LIMIT_POINT_UNION : thm
  LIMPT_INSERT : thm
  LIMPT_DELETE : thm
  LIMIT_POINT_UNIONS : thm
  LIMPT_OF_LIMPTS : thm
  CLOSED_LIMPTS : thm
  DISCRETE_IMP_CLOSED : thm
  LIMPT_OF_UNIV : thm
  LIMPT_OF_OPEN_IN : thm
  LIMPT_OF_OPEN : thm
  OPEN_IN_SING : thm
  CLOSED_SING : thm
  CLOSED_IN_SING : thm
  CLOSED_IN_INSERT : thm
  LIMIT_POINT_OF_LOCAL_IMP : thm
  LIMIT_POINT_OF_LOCAL : thm
  deriving Inhabited

@[nospecialize]
def setupLPT [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLOC : LOC)
    (BCON : CON) : ExceptT String IO LPT := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC,
        REAL_ARITH, SET_RULE, SET_TAC, HYP_TAC, INTRO_TAC, NORM_ARITH, NORM_ARITH_TAC,
        ASM_NORM_ARITH_TAC, .. } := D
  let { EQ_TRANS, EXISTS_IN_INSERT, EXTENSION, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FINITE_SING, FORALL_UNWIND_THM2, IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_INTER, IN_SING,
        .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, REAL_ADD_LID, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_01, REAL_LT_MIN, REAL_LT_RNEG, .. } := D.core4
  let { REAL_MIN_LE, REAL_NOT_LE, REAL_NOT_LT, RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM,
        SING_SUBSET, SUBSET, .. } := D.core5
  let { SWAP_FORALL_THM, UNIONS_0, UNIONS_INSERT, .. } := D.core6
  let { APPROACHABLE_LT_LE, REAL_HALF, .. } := D.misc
  let { COMPONENT_LE_NORM, DIST_NZ, DIST_POS_LT, DIST_SYM, .. } := D.vec1
  let { VECTOR_CHOOSE_DIST, VECTOR_SUB_COMPONENT, dist, .. } := D.vec4
  let { CLOSED_IN_UNION, .. } := D.met1
  let { DERIVED_SET_OF_UNION, METRIC_DERIVED_SET_OF, .. } := D.met2
  let { OPEN_IN_INTER, OPEN_IN_SUBOPEN, SUBTOPOLOGY_UNIV, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_IN, open_def, .. } := BEUC
  let { OPEN_SUBOPEN, closed, .. } := BCLO
  let { CENTRE_IN_BALL, IN_BALL, MBALL_EUCLIDEAN, OPEN_BALL, .. } := BBAL
  let { CLOSED_SUBSET_EQ, OPEN_IN_OPEN, open_in, .. } := BLOC
  let { CONNECTED_OPEN_IN, .. } := BCON
  -- @@SCOPE END

  let CONNECTED_INDUCTION ← prove
   r"!P Q s:real^N->bool.
        connected s /\
        (!t a. open_in (subtopology euclidean s) t /\ a IN t
               ==> ?z. z IN t /\ P z) /\
        (!a. a IN s
             ==> ?t. open_in (subtopology euclidean s) t /\ a IN t /\
                     !x y. x IN t /\ y IN t /\ P x /\ P y /\ Q x ==> Q y)
        ==> !a b. a IN s /\ b IN s /\ P a /\ P b /\ Q a ==> Q b"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [← TAUT (← q r"p <=> ~ ~p")] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_OPEN_IN]) THEN
    REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC
     [← q r"{b:real^N | ?t. open_in (subtopology euclidean s) t /\ b IN t /\
                       !x. x IN t /\ P x ==> Q x}",
      ← q r"{b:real^N | ?t. open_in (subtopology euclidean s) t /\ b IN t /\
                       !x. x IN t /\ P x ==> ~(Q x)}"] THEN
    REPEAT CONJ_TAC THENL
     [ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"c:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [],
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"c:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [],
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION] THEN
      X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^N")) THEN ASM SET_TAC [],
      REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"c:real^N") THEN DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC)
       (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC)) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"t INTER u:real^N->bool", ← q r"c:real^N"]) THEN
      ASM_SIMP_TAC [OPEN_IN_INTER] THEN ASM SET_TAC [],
      ASM SET_TAC [],
      ASM SET_TAC []])

  let CONNECTED_EQUIVALENCE_RELATION_GEN ← prove
   r"!P R s:real^N->bool.
        connected s /\
        (!x y. R x y ==> R y x) /\
        (!x y z. R x y /\ R y z ==> R x z) /\
        (!t a. open_in (subtopology euclidean s) t /\ a IN t
               ==> ?z. z IN t /\ P z) /\
        (!a. a IN s
             ==> ?t. open_in (subtopology euclidean s) t /\ a IN t /\
                     !x y. x IN t /\ y IN t /\ P x /\ P y ==> R x y)
        ==> !a b. a IN s /\ b IN s /\ P a /\ P b ==> R a b"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!a:real^N. a IN s /\ P a
                 ==> !b c. b IN s /\ c IN s /\ P b /\ P c /\ R a b ==> R a c")
    MP_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC CONNECTED_INDUCTION THEN
    ASM_MESON_TAC [])

  let CONNECTED_INDUCTION_SIMPLE ← prove
   r"!P s:real^N->bool.
        connected s /\
        (!a. a IN s
             ==> ?t. open_in (subtopology euclidean s) t /\ a IN t /\
                     !x y. x IN t /\ y IN t /\ P x ==> P y)
        ==> !a b. a IN s /\ b IN s /\ P a ==> P b"
   (MP_TAC (← ISPEC (← q r"\x:real^N. T") CONNECTED_INDUCTION) THEN
    REWRITE_TAC [] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN MESON_TAC [])

  let CONNECTED_EQUIVALENCE_RELATION ← prove
   r"!R s:real^N->bool.
        connected s /\
        (!x y. R x y ==> R y x) /\
        (!x y z. R x y /\ R y z ==> R x z) /\
        (!a. a IN s
             ==> ?t. open_in (subtopology euclidean s) t /\ a IN t /\
                     !x. x IN t ==> R a x)
        ==> !a b. a IN s /\ b IN s ==> R a b"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!a:real^N. a IN s ==> !b c. b IN s /\ c IN s /\ R a b ==> R a c")
    MP_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC CONNECTED_INDUCTION_SIMPLE THEN
    ASM_MESON_TAC [])

  let LOCALLY_CONSTANT_IMP_CONSTANT ← prove
   r"!f:real^N->A s.
        connected s /\
        (!x. x IN s
             ==> ?u. open_in (subtopology euclidean s) u /\ x IN u /\
                     !x'. x' IN u ==> f x' = f x)
        ==> ?c. !x. x IN s ==> f x = c"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← MESON []
     (← q r"(?c. !x. P x ==> f x = c) <=> (!x y. P x /\ P y ==> f x = f y)")] THEN
    CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN
    MATCH_MP_TAC CONNECTED_EQUIVALENCE_RELATION THEN
    ASM_SIMP_TAC [])

  parse_as_infix ("limit_point_of", (12, "right"))

  let limit_point_of ← new_definition
   r"x limit_point_of s <=>
        !t. x IN t /\ open t ==> ?y. ~(y = x) /\ y IN s /\ y IN t"

  let EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF ← prove
   r"!s. euclidean derived_set_of s = {x:real^N | x limit_point_of s}"
   (GEN_TAC THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, METRIC_DERIVED_SET_OF,
                 EUCLIDEAN_METRIC, IN_UNIV, limit_point_of, EXTENSION,
                 IN_ELIM_THM, MBALL_EUCLIDEAN] THEN
    GEN_TAC THEN EQ_TAC THENL
    [INTRO_TAC "hp; !t; x t" THEN HYP_TAC "t" (REWRITE_RULE [open_def]) THEN
     HYP_TAC "t: @r. r t" (C MATCH_MP (← ASSUME (← q r"x:real^N IN t"))) THEN
     HYP_TAC "hp: @y. neq y dist" (C MATCH_MP (← ASSUME (← q r"&0 < r"))) THEN
     EXISTS_TAC (← q r"y:real^N") THEN HYP REWRITE_TAC "neq y" [] THEN
     REMOVE_THEN "t" MATCH_MP_TAC THEN REMOVE_THEN "dist" MP_TAC THEN
     REWRITE_TAC [IN_BALL, DIST_SYM],
     INTRO_TAC "hp; !r; r" THEN REMOVE_THEN "hp" MATCH_MP_TAC THEN
     ASM_REWRITE_TAC [CENTRE_IN_BALL, OPEN_BALL]])

  let LIMIT_POINT_IN_DERIVED_SET ← prove
   r"!s x:real^N. x limit_point_of s <=> x IN euclidean derived_set_of s"
   (REWRITE_TAC [EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF, IN_ELIM_THM])

  let LIMPT_SUBSET ← prove
   r"!x s t. x limit_point_of s /\ s SUBSET t ==> x limit_point_of t"
   (REWRITE_TAC [limit_point_of, SUBSET] THEN MESON_TAC [])

  let LIMPT_APPROACHABLE ← prove
   r"!x s. x limit_point_of s <=>
                !e. &0 < e ==> ?x'. x' IN s /\ ~(x' = x) /\ dist(x',x) < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [limit_point_of] THEN
    MESON_TAC [open_def, DIST_SYM, OPEN_BALL, CENTRE_IN_BALL, IN_BALL])

  let LIMPT_APPROACHABLE_LE ← prove
   r"!x s. x limit_point_of s <=>
                !e. &0 < e ==> ?x'. x' IN s /\ ~(x' = x) /\ dist(x',x) <= e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIMPT_APPROACHABLE] THEN
    MATCH_MP_TAC (← TAUT (← q r"(~a <=> ~b) ==> (a <=> b)")) THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, NOT_EXISTS_THM] THEN
    REWRITE_TAC [← TAUT (← q r"~(a /\ b /\ c) <=> c ==> ~(a /\ b)"), APPROACHABLE_LT_LE])

  let DISCRETE_SET ← prove
   r"!s t:real^N->bool.
        {x | x IN t /\ x limit_point_of s} = {} <=>
        !x. x IN t
            ==> ?e. &0 < e /\ !y. y IN s /\ ~(y = x) ==> e <= norm(y - x)"
   (REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM] THEN
    REWRITE_TAC [LIMPT_APPROACHABLE] THEN
    REWRITE_TAC [dist, ← GSYM REAL_NOT_LE] THEN MESON_TAC [])

  let CLOSED_LIMPT ← prove
   r"!s. closed s <=> !x. x limit_point_of s ==> x IN s"
   (REWRITE_TAC [closed] THEN ONCE_REWRITE_TAC [OPEN_SUBOPEN] THEN
    REWRITE_TAC [limit_point_of, IN_DIFF, IN_UNIV, SUBSET] THEN MESON_TAC [])

  let LIMPT_EMPTY ← prove
   r"!x. ~(x limit_point_of {})"
   (REWRITE_TAC [LIMPT_APPROACHABLE, NOT_IN_EMPTY] THEN MESON_TAC [REAL_LT_01])

  let NO_LIMIT_POINT_IMP_CLOSED ← prove
   r"!s. ~(?x. x limit_point_of s) ==> closed s"
   (MESON_TAC [CLOSED_LIMPT])

  let CLOSED_POSITIVE_ORTHANT ← prove
   r"closed {x:real^N | !i. 1 <= i /\ i <= dimindex(:N)
                          ==> &0 <= x$i}"
   (REWRITE_TAC [CLOSED_LIMPT, LIMPT_APPROACHABLE] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"--(x:real^N $ i)")) THEN
    ASM_REWRITE_TAC [REAL_LT_RNEG, REAL_ADD_LID, NOT_EXISTS_THM] THEN
    X_GEN_TAC (← q r"y:real^N") THEN
    MATCH_MP_TAC (← TAUT (← q r"(a ==> ~c) ==> ~(a /\ b /\ c)")) THEN DISCH_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"!b. abs x <= b /\ b <= a ==> ~(a + x < &0)")) THEN
    EXISTS_TAC (← q r"abs((y - x :real^N)$i)") THEN
    ASM_SIMP_TAC [dist, COMPONENT_LE_NORM] THEN
    ASM_SIMP_TAC [VECTOR_SUB_COMPONENT, ← REAL_ARITH
     (← q r"x < &0 /\ &0 <= y ==> abs(x) <= abs(y - x)")])

  let FINITE_SET_AVOID ← prove
   r"!a:real^N s. FINITE s
                ==> ?d. &0 < d /\ !x. x IN s /\ ~(x = a) ==> d <= dist(a,x)"
   (GEN_TAC THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [NOT_IN_EMPTY] THEN
    CONJ_TAC THENL [MESON_TAC [REAL_LT_01], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"s:real^N->bool"] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"x:real^N = a") THEN REWRITE_TAC [IN_INSERT] THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q r"min d (dist(a:real^N,x))") THEN
    ASM_REWRITE_TAC [REAL_LT_MIN, ← GSYM DIST_NZ, REAL_MIN_LE] THEN
    ASM_MESON_TAC [REAL_LE_REFL])

  let LIMIT_POINT_FINITE ← prove
   r"!s a. FINITE s ==> ~(a limit_point_of s)"
   (REWRITE_TAC [LIMPT_APPROACHABLE, ← GSYM REAL_NOT_LE] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, NOT_EXISTS_THM, REAL_NOT_LE,
      REAL_NOT_LT, ← TAUT (← q r"~(a /\ b /\ c) <=> a /\ b ==> ~c")] THEN
    MESON_TAC [FINITE_SET_AVOID, DIST_SYM])

  let LIMPT_SING ← prove
   r"!x y:real^N. ~(x limit_point_of {y})"
   (SIMP_TAC [LIMIT_POINT_FINITE, FINITE_SING])

  let LIMIT_POINT_UNION ← prove
   r"!s t x:real^N. x limit_point_of (s UNION t) <=>
                  x limit_point_of s \/ x limit_point_of t"
   (REWRITE_TAC [LIMIT_POINT_IN_DERIVED_SET, DERIVED_SET_OF_UNION, IN_UNION])

  let LIMPT_INSERT ← prove
   r"!s x y:real^N. x limit_point_of (y INSERT s) <=> x limit_point_of s"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"y INSERT s = {y} UNION s")] THEN
    REWRITE_TAC [LIMIT_POINT_UNION] THEN
    SIMP_TAC [FINITE_SING, LIMIT_POINT_FINITE])

  let LIMPT_DELETE ← prove
   r"!s a x:real^N. x limit_point_of (s DELETE a) <=> x limit_point_of s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN s") THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> s DELETE a = s")] THEN
    TRANS_TAC EQ_TRANS (← q r"(x:real^N) limit_point_of a INSERT (s DELETE a)") THEN
    CONJ_TAC THENL [REWRITE_TAC [LIMPT_INSERT], AP_TERM_TAC THEN ASM SET_TAC []])

  let LIMIT_POINT_UNIONS ← prove
   r"!f x:real^N.
      FINITE f
      ==> (x limit_point_of (UNIONS f) <=> ?s. s IN f /\ x limit_point_of s)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, LIMPT_EMPTY, NOT_IN_EMPTY] THEN
    SIMP_TAC [UNIONS_INSERT, LIMIT_POINT_UNION, EXISTS_IN_INSERT])

  let LIMPT_OF_LIMPTS ← prove
   r"!x:real^N s.
     x limit_point_of {y | y limit_point_of s} ==> x limit_point_of s"
   (REWRITE_TAC [LIMPT_APPROACHABLE, IN_ELIM_THM] THEN REPEAT GEN_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"dist(y:real^N,x)")) THEN
    ASM_SIMP_TAC [DIST_POS_LT] THEN MATCH_MP_TAC MONO_EXISTS THEN
    GEN_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN NORM_ARITH_TAC)

  let CLOSED_LIMPTS ← prove
   r"!s. closed {x:real^N | x limit_point_of s}"
   (REWRITE_TAC [CLOSED_LIMPT, IN_ELIM_THM, LIMPT_OF_LIMPTS])

  let DISCRETE_IMP_CLOSED ← prove
   r"!s:real^N->bool e.
        &0 < e /\
        (!x y. x IN s /\ y IN s /\ norm(y - x) < e ==> y = x)
        ==> closed s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!x:real^N. ~(x limit_point_of s)")
      (fun th => MESON_TAC [th, CLOSED_LIMPT]) THEN
    GEN_TAC THEN REWRITE_TAC [LIMPT_APPROACHABLE] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    REWRITE_TAC [REAL_HALF, ← ASSUME (← q r"&0 < e")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"min (e / &2) (dist(x:real^N,y))")) THEN
    ASM_SIMP_TAC [REAL_LT_MIN, DIST_POS_LT, REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"y:real^N", ← q r"z:real^N"]) THEN
    ASM_REWRITE_TAC [] THEN ASM_NORM_ARITH_TAC)

  let LIMPT_OF_UNIV ← prove
   r"!x. x limit_point_of (:real^N)"
   (GEN_TAC THEN REWRITE_TAC [LIMPT_APPROACHABLE, IN_UNIV] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"x:real^N", ← q r"e / &2"] VECTOR_CHOOSE_DIST) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, MATCH_MP_TAC MONO_EXISTS] THEN
    POP_ASSUM MP_TAC THEN CONV_TAC (fun t => NORM_ARITH t))

  let LIMPT_OF_OPEN_IN ← prove
   r"!s t x:real^N.
        open_in (subtopology euclidean s) t /\ x limit_point_of s /\ x IN t
        ==> x limit_point_of t"
   (REWRITE_TAC [open_in, SUBSET, LIMPT_APPROACHABLE] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"min d e / &2")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, MATCH_MP_TAC MONO_EXISTS] THEN
    GEN_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THEN
    TRY (FIRST_X_ASSUM MATCH_MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    ASM_REAL_ARITH_TAC)

  let LIMPT_OF_OPEN ← prove
   r"!s x:real^N. open s /\ x IN s ==> x limit_point_of s"
   (REWRITE_TAC [OPEN_IN] THEN ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    MESON_TAC [LIMPT_OF_OPEN_IN, LIMPT_OF_UNIV])

  let OPEN_IN_SING ← prove
   r"!s a. open_in (subtopology euclidean s) {a} <=>
         a IN s /\ ~(a limit_point_of s)"
   (REWRITE_TAC [open_in, LIMPT_APPROACHABLE, SING_SUBSET, IN_SING] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2] THEN MESON_TAC [])

  let CLOSED_SING ← prove
   r"!a:real^N. closed {a}"
   (REWRITE_TAC [CLOSED_LIMPT, LIMPT_INSERT, LIMPT_EMPTY])

  let CLOSED_IN_SING ← prove
   r"!u x:real^N. closed_in (subtopology euclidean u) {x} <=> x IN u"
   (SIMP_TAC [CLOSED_SUBSET_EQ, CLOSED_SING] THEN SET_TAC [])

  let CLOSED_IN_INSERT ← prove
   r"!u s a:real^N.
        closed_in (subtopology euclidean u) s /\ a IN u
        ==> closed_in (subtopology euclidean u) (a INSERT s)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = {a} UNION s")] THEN
    SIMP_TAC [CLOSED_IN_UNION, CLOSED_IN_SING])

  let LIMIT_POINT_OF_LOCAL_IMP ← prove
   r"!u s t x:real^N.
        s SUBSET u /\ x limit_point_of s /\
        x IN t /\ open_in (subtopology euclidean u) t
        ==> ?y. ~(y = x) /\ y IN s /\ y IN t"
   (REWRITE_TAC [limit_point_of, OPEN_IN_OPEN] THEN SET_TAC [])

  let LIMIT_POINT_OF_LOCAL ← prove
   r"!u s x:real^N.
        s SUBSET u /\ x IN u
        ==> (x limit_point_of s <=>
             !t. x IN t /\ open_in (subtopology euclidean u) t
                 ==> ?y. ~(y = x) /\ y IN s /\ y IN t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [limit_point_of, OPEN_IN_OPEN] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2, IN_INTER] THEN ASM SET_TAC [])

  return { CONNECTED_INDUCTION, CONNECTED_EQUIVALENCE_RELATION_GEN, CONNECTED_INDUCTION_SIMPLE,
           CONNECTED_EQUIVALENCE_RELATION, LOCALLY_CONSTANT_IMP_CONSTANT, limit_point_of,
           EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF, LIMIT_POINT_IN_DERIVED_SET, LIMPT_SUBSET,
           LIMPT_APPROACHABLE, LIMPT_APPROACHABLE_LE, DISCRETE_SET, CLOSED_LIMPT, LIMPT_EMPTY,
           NO_LIMIT_POINT_IMP_CLOSED, CLOSED_POSITIVE_ORTHANT, FINITE_SET_AVOID,
           LIMIT_POINT_FINITE, LIMPT_SING, LIMIT_POINT_UNION, LIMPT_INSERT, LIMPT_DELETE,
           LIMIT_POINT_UNIONS, LIMPT_OF_LIMPTS, CLOSED_LIMPTS, DISCRETE_IMP_CLOSED,
           LIMPT_OF_UNIV, LIMPT_OF_OPEN_IN, LIMPT_OF_OPEN, OPEN_IN_SING, CLOSED_SING,
           CLOSED_IN_SING, CLOSED_IN_INSERT, LIMIT_POINT_OF_LOCAL_IMP, LIMIT_POINT_OF_LOCAL }

/- ------------------------------------------------------------------------- -/
/- Interior of a set.  (topology.ml 1941-2090)                               -/
/- ------------------------------------------------------------------------- -/

structure INT where
  interior : thm
  EUCLIDEAN_INTERIOR_OF : thm
  INTERIOR_EQ : thm
  INTERIOR_OPEN : thm
  INTERIOR_EMPTY : thm
  INTERIOR_UNIV : thm
  OPEN_INTERIOR : thm
  INTERIOR_INTERIOR : thm
  INTERIOR_SUBSET : thm
  SUBSET_INTERIOR_EQ : thm
  SUBSET_INTERIOR : thm
  INTERIOR_MAXIMAL : thm
  INTERIOR_MAXIMAL_EQ : thm
  INTERIOR_UNIQUE : thm
  INTERIOR_EQ_UNIV : thm
  IN_INTERIOR : thm
  INTERIOR_INTER : thm
  INTERIOR_FINITE_INTERS : thm
  INTERIOR_INTERS_SUBSET : thm
  UNION_INTERIOR_SUBSET : thm
  INTERIOR_EQ_EMPTY : thm
  INTERIOR_EQ_EMPTY_ALT : thm
  INTERIOR_LIMIT_POINT : thm
  INTERIOR_SING : thm
  INTERIOR_CLOSED_UNION_EMPTY_INTERIOR : thm
  INTERIOR_UNION_EQ_EMPTY : thm
  INTERIOR_UNIONS_OPEN_SUBSETS : thm
  deriving Inhabited

@[nospecialize]
def setupINT [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLPT : LPT) :
    ExceptT String IO INT := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } :=
    D
  let { EXTENSION, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, INTERS_0, INTERS_INSERT, IN_ELIM_THM, IN_INTERS, .. } :=
    D.core2
  let { MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_EMPTY, SUBSET_TRANS, SUBSET_UNION,
        .. } := D.core5
  let { UNION_COMM, .. } := D.core6
  let { DIST_EQ_0, DIST_SYM, .. } := D.vec1
  let { VECTOR_CHOOSE_DIST, .. } := D.vec4
  let { INTERIOR_OF_CLOSED_IN_UNION_EMPTY_INTERIOR_OF, INTERIOR_OF_INTER, .. } := D.met2
  let { interior_of, .. } := D.met3
  let { OPEN_EMPTY, OPEN_IN, OPEN_UNIONS, OPEN_UNIV, .. } := BEUC
  let { CLOSED_IN, OPEN_SUBOPEN, OPEN_UNION, .. } := BCLO
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := BBAL
  let { LIMPT_APPROACHABLE, LIMPT_SING, .. } := BLPT
  -- @@SCOPE END

  let interior ← new_definition
   r"interior s = {x | ?t. open t /\ x IN t /\ t SUBSET s}"

  let EUCLIDEAN_INTERIOR_OF ← prove
   r"!s:real^N->bool. euclidean interior_of s = interior s"
   (REWRITE_TAC [interior_of, interior, OPEN_IN])

  let INTERIOR_EQ ← prove
   r"!s. (interior s = s) <=> open s"
   (GEN_TAC THEN REWRITE_TAC [EXTENSION, interior, IN_ELIM_THM] THEN
    GEN_REWRITE_TAC RAND_CONV [OPEN_SUBOPEN] THEN MESON_TAC [SUBSET])

  let INTERIOR_OPEN ← prove
   r"!s. open s ==> (interior s = s)"
   (MESON_TAC [INTERIOR_EQ])

  let INTERIOR_EMPTY ← prove
   r"interior {} = {}"
   (SIMP_TAC [INTERIOR_OPEN, OPEN_EMPTY])

  let INTERIOR_UNIV ← prove
   r"interior(:real^N) = (:real^N)"
   (SIMP_TAC [INTERIOR_OPEN, OPEN_UNIV])

  let OPEN_INTERIOR ← prove
   r"!s. open(interior s)"
   (GEN_TAC THEN REWRITE_TAC [interior] THEN GEN_REWRITE_TAC id [OPEN_SUBOPEN] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MESON_TAC [])

  let INTERIOR_INTERIOR ← prove
   r"!s. interior(interior s) = interior s"
   (MESON_TAC [INTERIOR_EQ, OPEN_INTERIOR])

  let INTERIOR_SUBSET ← prove
   r"!s. (interior s) SUBSET s"
   (REWRITE_TAC [SUBSET, interior, IN_ELIM_THM] THEN MESON_TAC [])

  let SUBSET_INTERIOR_EQ ← prove
   r"!s:real^N->bool. s SUBSET interior s <=> open s"
   (REWRITE_TAC [← GSYM INTERIOR_EQ, ← GSYM SUBSET_ANTISYM_EQ, INTERIOR_SUBSET])

  let SUBSET_INTERIOR ← prove
   r"!s t. s SUBSET t ==> (interior s) SUBSET (interior t)"
   (REWRITE_TAC [interior, SUBSET, IN_ELIM_THM] THEN MESON_TAC [])

  let INTERIOR_MAXIMAL ← prove
   r"!s t. t SUBSET s /\ open t ==> t SUBSET (interior s)"
   (REWRITE_TAC [interior, SUBSET, IN_ELIM_THM] THEN MESON_TAC [])

  let INTERIOR_MAXIMAL_EQ ← prove
   r"!s t:real^N->bool. open s ==> (s SUBSET interior t <=> s SUBSET t)"
   (MESON_TAC [INTERIOR_MAXIMAL, SUBSET_TRANS, INTERIOR_SUBSET])

  let INTERIOR_UNIQUE ← prove
   r"!s t. t SUBSET s /\ open t /\ (!t'. t' SUBSET s /\ open t' ==> t' SUBSET t)
         ==> (interior s = t)"
   (MESON_TAC [SUBSET_ANTISYM, INTERIOR_MAXIMAL, INTERIOR_SUBSET,
               OPEN_INTERIOR])

  let INTERIOR_EQ_UNIV ← prove
   r"!s. interior s = (:real^N) <=> s = (:real^N)"
   (SIMP_TAC [← SET_RULE (← q r"s = UNIV <=> UNIV SUBSET s"), OPEN_UNIV,
              INTERIOR_MAXIMAL_EQ])

  let IN_INTERIOR ← prove
   r"!x s. x IN interior s <=> ?e. &0 < e /\ ball(x,e) SUBSET s"
   (REWRITE_TAC [interior, IN_ELIM_THM] THEN
    MESON_TAC [OPEN_CONTAINS_BALL, SUBSET_TRANS, CENTRE_IN_BALL, OPEN_BALL])

  let INTERIOR_INTER ← prove
   r"!s t:real^N->bool. interior(s INTER t) = interior s INTER interior t"
   (REWRITE_TAC [← GSYM EUCLIDEAN_INTERIOR_OF, INTERIOR_OF_INTER])

  let INTERIOR_FINITE_INTERS ← prove
   r"!s:(real^N->bool)->bool.
        FINITE s ==> interior(INTERS s) = INTERS(IMAGE interior s)"
   (MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [INTERS_0, INTERS_INSERT, INTERIOR_UNIV, IMAGE_CLAUSES] THEN
    SIMP_TAC [INTERIOR_INTER])

  let INTERIOR_INTERS_SUBSET ← prove
   r"!f. interior(INTERS f) SUBSET INTERS (IMAGE interior f)"
   (REWRITE_TAC [SUBSET, IN_INTERIOR, IN_INTERS, FORALL_IN_IMAGE] THEN
    MESON_TAC [])

  let UNION_INTERIOR_SUBSET ← prove
   r"!s t:real^N->bool.
        interior s UNION interior t SUBSET interior(s UNION t)"
   (SIMP_TAC [INTERIOR_MAXIMAL_EQ, OPEN_UNION, OPEN_INTERIOR] THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET s' /\ t SUBSET t' ==> (s UNION t) SUBSET (s' UNION t')")) THEN
    REWRITE_TAC [INTERIOR_SUBSET])

  let INTERIOR_EQ_EMPTY ← prove
   r"!s:real^N->bool. interior s = {} <=> !t. open t /\ t SUBSET s ==> t = {}"
   (MESON_TAC [INTERIOR_MAXIMAL_EQ, SUBSET_EMPTY,
               OPEN_INTERIOR, INTERIOR_SUBSET])

  let INTERIOR_EQ_EMPTY_ALT ← prove
   r"!s:real^N->bool.
        interior s = {} <=>
        !t. open t /\ ~(t = {}) ==> ~(t DIFF s = {})"
   (GEN_TAC THEN REWRITE_TAC [INTERIOR_EQ_EMPTY] THEN SET_TAC [])

  let INTERIOR_LIMIT_POINT ← prove
   r"!s x:real^N. x IN interior s ==> x limit_point_of s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [IN_INTERIOR, IN_ELIM_THM, SUBSET, IN_BALL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [LIMPT_APPROACHABLE] THEN X_GEN_TAC (← q r"d:real") THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"x:real^N", ← q r"min d e / &2"] VECTOR_CHOOSE_DIST) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
    REPEAT CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC,
      CONV_TAC (RAND_CONV SYM_CONV) THEN REWRITE_TAC [← GSYM DIST_EQ_0],
      ONCE_REWRITE_TAC [DIST_SYM]] THEN
    ASM_REAL_ARITH_TAC)

  let INTERIOR_SING ← prove
   r"!a:real^N. interior {a} = {}"
   (REWRITE_TAC [EXTENSION, NOT_IN_EMPTY] THEN
    MESON_TAC [INTERIOR_LIMIT_POINT, LIMPT_SING])

  let INTERIOR_CLOSED_UNION_EMPTY_INTERIOR ← prove
   r"!s t:real^N->bool.
        closed(s) /\ interior(t) = {}
        ==> interior(s UNION t) = interior(s)"
   (REWRITE_TAC [← GSYM EUCLIDEAN_INTERIOR_OF, CLOSED_IN] THEN
    REWRITE_TAC [INTERIOR_OF_CLOSED_IN_UNION_EMPTY_INTERIOR_OF])

  let INTERIOR_UNION_EQ_EMPTY ← prove
   r"!s t:real^N->bool.
        closed s \/ closed t
        ==> (interior(s UNION t) = {} <=>
             interior s = {} /\ interior t = {})"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [SUBSET_UNION, SUBSET_INTERIOR, SUBSET_EMPTY],
      ASM_MESON_TAC [UNION_COMM, INTERIOR_CLOSED_UNION_EMPTY_INTERIOR]])

  let INTERIOR_UNIONS_OPEN_SUBSETS ← prove
   r"!s:real^N->bool. UNIONS {t | open t /\ t SUBSET s} = interior s"
   (GEN_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTERIOR_UNIQUE THEN
    SIMP_TAC [OPEN_UNIONS, IN_ELIM_THM] THEN SET_TAC [])

  return { interior, EUCLIDEAN_INTERIOR_OF, INTERIOR_EQ, INTERIOR_OPEN, INTERIOR_EMPTY,
           INTERIOR_UNIV, OPEN_INTERIOR, INTERIOR_INTERIOR, INTERIOR_SUBSET, SUBSET_INTERIOR_EQ,
           SUBSET_INTERIOR, INTERIOR_MAXIMAL, INTERIOR_MAXIMAL_EQ, INTERIOR_UNIQUE,
           INTERIOR_EQ_UNIV, IN_INTERIOR, INTERIOR_INTER, INTERIOR_FINITE_INTERS,
           INTERIOR_INTERS_SUBSET, UNION_INTERIOR_SUBSET, INTERIOR_EQ_EMPTY,
           INTERIOR_EQ_EMPTY_ALT, INTERIOR_LIMIT_POINT, INTERIOR_SING,
           INTERIOR_CLOSED_UNION_EMPTY_INTERIOR, INTERIOR_UNION_EQ_EMPTY,
           INTERIOR_UNIONS_OPEN_SUBSETS }

/- ------------------------------------------------------------------------- -/
/- Closure of a set, part 1.  (topology.ml 2091-2332)                        -/
/- ------------------------------------------------------------------------- -/

structure CLS1 where
  closure : thm
  EUCLIDEAN_CLOSURE_OF : thm
  CLOSURE_APPROACHABLE : thm
  CLOSURE_NONEMPTY_OPEN_INTER : thm
  CLOSURE_INTERIOR : thm
  INTERIOR_CLOSURE : thm
  CLOSED_CLOSURE : thm
  CLOSURE_HULL : thm
  CLOSURE_EQ : thm
  CLOSURE_CLOSED : thm
  CLOSURE_CLOSURE : thm
  CLOSURE_SUBSET : thm
  CLOSURE_INC : thm
  SUBSET_CLOSURE : thm
  CLOSURE_UNION : thm
  CLOSURE_UNIONS_SUBSET : thm
  CLOSURE_INTER_SUBSET : thm
  CLOSURE_INTERS_SUBSET : thm
  CLOSURE_MINIMAL : thm
  CLOSURE_MINIMAL_EQ : thm
  CLOSURE_UNIQUE : thm
  CLOSURE_EMPTY : thm
  CLOSURE_UNIV : thm
  LIMPT_OF_OPEN_CLOSURE : thm
  CLOSURE_UNIONS : thm
  CLOSURE_EQ_EMPTY : thm
  CLOSURE_SUBSET_EQ : thm
  OPEN_INTER_CLOSURE_EQ_EMPTY : thm
  CLOSURE_MINIMAL_LOCAL : thm
  CLOSURE_OPEN_IN_INTER_CLOSURE : thm
  OPEN_IN_INTER_CLOSURE_EQ_EMPTY : thm
  CLOSURE_OPEN_INTER_CLOSURE : thm
  OPEN_INTER_CLOSURE_SUBSET : thm
  OPEN_INTER_CLOSURE_EQ : thm
  CLOSURE_OPEN_INTER_SUPERSET : thm
  CLOSURE_COMPLEMENT : thm
  INTERIOR_COMPLEMENT : thm
  CLOSURE_LOCALLY_FINITE_UNIONS : thm
  CONNECTED_INTERMEDIATE_CLOSURE : thm
  CONNECTED_CLOSURE : thm
  CONNECTED_UNION_STRONG : thm
  CONNECTED_INSERT : thm
  CONNECTED_INSERT_LIMPT : thm
  INTERIOR_DIFF : thm
  deriving Inhabited

@[nospecialize]
def setupCLS1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BCON : CON)
    (BLPT : LPT) (BINT : INT) : ExceptT String IO CLS1 := do
  -- @@SCOPE BEGIN
  let { new_definition, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { COMPL_COMPL, EXTENSION, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMP_CONJ, INTER_SUBSET, INTER_UNIV, IN_DIFF,
        IN_ELIM_THM, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, NOT_EXISTS_THM, .. } := D.core3
  let { SUBSET, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, SUBSET_UNIV, .. } := D.core5
  let { UNIONS_0, UNIONS_INSERT, UNIONS_SUBSET, .. } := D.core6
  let { HULL_EQ, HULL_HULL, HULL_MINIMAL, HULL_MONO, HULL_SUBSET, HULL_UNIQUE, .. } := D.misc
  let { DIST_REFL, .. } := D.vec1
  let { CLOSURE_OF, CLOSURE_OF_LOCALLY_FINITE_UNIONS, CLOSURE_OF_OPEN_IN_INTER_SUPERSET,
        CLOSURE_OF_OPEN_IN_SUBTOPOLOGY_INTER_CLOSURE_OF, CONNECTED_IN_INTERMEDIATE_CLOSURE_OF,
        CONNECTED_IN_NONSEPARATED_UNION, .. } := D.met1
  let { OPEN_IN_INTER_CLOSURE_OF_EQ, OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, SUBTOPOLOGY_UNIV,
        separated_in, .. } := D.met3
  let { OPEN_IN, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { CLOSED_EMPTY, CLOSED_INTERS, CLOSED_UNIV, closed, .. } := BCLO
  let { CLOSED_IN_CLOSED, .. } := BLOC
  let { CONNECTED_CLOSED, CONNECTED_IN_EUCLIDEAN, CONNECTED_SING, .. } := BCON
  let { CLOSED_LIMPT, CLOSED_SING, EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF,
        LIMIT_POINT_UNION, LIMPT_APPROACHABLE, LIMPT_OF_OPEN, limit_point_of, .. } := BLPT
  let { INTERIOR_INTER, OPEN_INTERIOR, interior, .. } := BINT
  -- @@SCOPE END

  let closure ← new_definition
   r"closure s = s UNION {x | x limit_point_of s}"

  let EUCLIDEAN_CLOSURE_OF ← prove
   r"!s:real^N->bool. euclidean closure_of s = closure s"
   (GEN_TAC THEN
    REWRITE_TAC [closure, CLOSURE_OF, TOPSPACE_EUCLIDEAN, INTER_UNIV,
                 EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF])

  let CLOSURE_APPROACHABLE ← prove
   r"!x s. x IN closure(s) <=> !e. &0 < e ==> ?y. y IN s /\ dist(y,x) < e"
   (REWRITE_TAC [closure, LIMPT_APPROACHABLE, IN_UNION, IN_ELIM_THM] THEN
    MESON_TAC [DIST_REFL])

  let CLOSURE_NONEMPTY_OPEN_INTER ← prove
   r"!s x:real^N. x IN closure s <=> !t. x IN t /\ open t ==> ~(s INTER t = {})"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closure, IN_UNION, IN_ELIM_THM] THEN
    REWRITE_TAC [limit_point_of] THEN SET_TAC [])

  let CLOSURE_INTERIOR ← prove
   r"!s:real^N->bool. closure s = UNIV DIFF (interior (UNIV DIFF s))"
   (REWRITE_TAC [EXTENSION, closure, IN_UNION, IN_DIFF, IN_UNIV, interior,
                 IN_ELIM_THM, limit_point_of, SUBSET] THEN
    MESON_TAC [])

  let INTERIOR_CLOSURE ← prove
   r"!s:real^N->bool. interior s = UNIV DIFF (closure (UNIV DIFF s))"
   (REWRITE_TAC [CLOSURE_INTERIOR, COMPL_COMPL])

  let CLOSED_CLOSURE ← prove
   r"!s. closed(closure s)"
   (REWRITE_TAC [closed, CLOSURE_INTERIOR, COMPL_COMPL, OPEN_INTERIOR])

  let CLOSURE_HULL ← prove
   r"!s. closure s = closed hull s"
   (GEN_TAC THEN MATCH_MP_TAC (← GSYM HULL_UNIQUE) THEN
    REWRITE_TAC [CLOSED_CLOSURE, SUBSET] THEN
    REWRITE_TAC [closure, IN_UNION, IN_ELIM_THM, CLOSED_LIMPT] THEN
    MESON_TAC [limit_point_of])

  let CLOSURE_EQ ← prove
   r"!s. (closure s = s) <=> closed s"
   (SIMP_TAC [CLOSURE_HULL, HULL_EQ, CLOSED_INTERS])

  let CLOSURE_CLOSED ← prove
   r"!s. closed s ==> (closure s = s)"
   (MESON_TAC [CLOSURE_EQ])

  let CLOSURE_CLOSURE ← prove
   r"!s. closure(closure s) = closure s"
   (REWRITE_TAC [CLOSURE_HULL, HULL_HULL])

  let CLOSURE_SUBSET ← prove
   r"!s. s SUBSET (closure s)"
   (REWRITE_TAC [CLOSURE_HULL, HULL_SUBSET])

  let CLOSURE_INC ← prove
   r"!s x:real^N. x IN s ==> x IN closure s"
   (REWRITE_TAC [← GSYM SUBSET, CLOSURE_SUBSET])

  let SUBSET_CLOSURE ← prove
   r"!s t. s SUBSET t ==> (closure s) SUBSET (closure t)"
   (REWRITE_TAC [CLOSURE_HULL, HULL_MONO])

  let CLOSURE_UNION ← prove
   r"!s t:real^N->bool. closure(s UNION t) = closure s UNION closure t"
   (REWRITE_TAC [LIMIT_POINT_UNION, closure] THEN SET_TAC [])

  let CLOSURE_UNIONS_SUBSET ← prove
   r"!(f:(real^N->bool)->bool).
        UNIONS {closure s | s IN f} SUBSET closure(UNIONS f)"
   (REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_CLOSURE THEN ASM SET_TAC [])

  let CLOSURE_INTER_SUBSET ← prove
   r"!s t. closure(s INTER t) SUBSET closure(s) INTER closure(t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SUBSET_INTER] THEN
    CONJ_TAC THEN MATCH_MP_TAC SUBSET_CLOSURE THEN SET_TAC [])

  let CLOSURE_INTERS_SUBSET ← prove
   r"!f. closure(INTERS f) SUBSET INTERS(IMAGE closure f)"
   (REWRITE_TAC [← SET_RULE (← q r"s SUBSET INTERS f <=> !t. t IN f ==> s SUBSET t")] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUBSET_CLOSURE THEN ASM SET_TAC [])

  let CLOSURE_MINIMAL ← prove
   r"!s t. s SUBSET t /\ closed t ==> (closure s) SUBSET t"
   (REWRITE_TAC [HULL_MINIMAL, CLOSURE_HULL])

  let CLOSURE_MINIMAL_EQ ← prove
   r"!s t:real^N->bool. closed t ==> (closure s SUBSET t <=> s SUBSET t)"
   (MESON_TAC [SUBSET_TRANS, CLOSURE_SUBSET, CLOSURE_MINIMAL])

  let CLOSURE_UNIQUE ← prove
   r"!s t. s SUBSET t /\ closed t /\
         (!t'. s SUBSET t' /\ closed t' ==> t SUBSET t')
         ==> closure s = t"
   (REWRITE_TAC [CLOSURE_HULL, HULL_UNIQUE])

  let CLOSURE_EMPTY ← prove
   r"closure {} = {}"
   (SIMP_TAC [CLOSURE_CLOSED, CLOSED_EMPTY])

  let CLOSURE_UNIV ← prove
   r"closure(:real^N) = (:real^N)"
   (SIMP_TAC [CLOSURE_CLOSED, CLOSED_UNIV])

  let LIMPT_OF_OPEN_CLOSURE ← prove
   r"!s x:real^N. open s /\ x IN closure s ==> x limit_point_of s"
   (REWRITE_TAC [closure, IN_UNION, IN_ELIM_THM] THEN MESON_TAC [LIMPT_OF_OPEN])

  let CLOSURE_UNIONS ← prove
   r"!f. FINITE f ==> closure(UNIONS f) = UNIONS {closure s | s IN f}"
   (MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, UNIONS_INSERT, ← SET_RULE (← q r"{f x | x IN {}} = {}"),
       ← SET_RULE (← q r"{f x | x IN a INSERT s} = (f a) INSERT {f x | x IN s}")] THEN
    SIMP_TAC [CLOSURE_EMPTY, CLOSURE_UNION])

  let CLOSURE_EQ_EMPTY ← prove
   r"!s. closure s = {} <=> s = {}"
   (GEN_TAC THEN EQ_TAC THEN SIMP_TAC [CLOSURE_EMPTY] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> t = {} ==> s = {}")) THEN
    REWRITE_TAC [CLOSURE_SUBSET])

  let CLOSURE_SUBSET_EQ ← prove
   r"!s:real^N->bool. closure s SUBSET s <=> closed s"
   (GEN_TAC THEN REWRITE_TAC [← GSYM CLOSURE_EQ] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN SET_TAC [])

  let OPEN_INTER_CLOSURE_EQ_EMPTY ← prove
   r"!s t:real^N->bool.
        open s ==> (s INTER (closure t) = {} <=> s INTER t = {})"
   (REWRITE_TAC [OPEN_IN, ← GSYM EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY])

  let CLOSURE_MINIMAL_LOCAL ← prove
   r"!s t u:real^N->bool.
        closed_in (subtopology euclidean s) u /\ t SUBSET u
        ==> s INTER closure t SUBSET u"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [IMP_CONJ, CLOSED_IN_CLOSED, LEFT_IMP_EXISTS_THM, SUBSET_INTER] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [INTER_SUBSET] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"t SUBSET u ==> s INTER t SUBSET u")) THEN
    MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_REWRITE_TAC [])

  let CLOSURE_OPEN_IN_INTER_CLOSURE ← prove
   r"!s t u:real^N->bool.
        open_in (subtopology euclidean u) s /\ t SUBSET u
        ==> closure(s INTER closure t) = closure(s INTER t)"
   (REWRITE_TAC [OPEN_IN, ← GSYM EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [CLOSURE_OF_OPEN_IN_SUBTOPOLOGY_INTER_CLOSURE_OF])

  let OPEN_IN_INTER_CLOSURE_EQ_EMPTY ← prove
   r"!u s t:real^N->bool.
        open_in (subtopology euclidean u) s /\ t SUBSET u
        ==> (s INTER closure t = {} <=> s INTER t = {})"
   (MESON_TAC [CLOSURE_OPEN_IN_INTER_CLOSURE, CLOSURE_EQ_EMPTY])

  let CLOSURE_OPEN_INTER_CLOSURE ← prove
   r"!s t:real^N->bool.
        open s ==> closure(s INTER closure t) = closure(s INTER t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_OPEN_IN_INTER_CLOSURE THEN
    EXISTS_TAC (← q r"(:real^N)") THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, ← GSYM OPEN_IN, SUBTOPOLOGY_UNIV])

  let OPEN_INTER_CLOSURE_SUBSET ← prove
   r"!s t:real^N->bool.
        open s ==> (s INTER (closure t)) SUBSET closure(s INTER t)"
   (MESON_TAC [CLOSURE_OPEN_INTER_CLOSURE, CLOSURE_SUBSET])

  let OPEN_INTER_CLOSURE_EQ ← prove
   r"!s t:real^N->bool.
        open s ==> s INTER closure t = s INTER closure(s INTER t)"
   (REWRITE_TAC [← GSYM EUCLIDEAN_CLOSURE_OF, OPEN_IN] THEN
    REWRITE_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ])

  let CLOSURE_OPEN_INTER_SUPERSET ← prove
   r"!s t:real^N->bool.
        open s /\ s SUBSET closure t ==> closure(s INTER t) = closure s"
   (REWRITE_TAC [← GSYM EUCLIDEAN_CLOSURE_OF, OPEN_IN] THEN
    REWRITE_TAC [CLOSURE_OF_OPEN_IN_INTER_SUPERSET])

  let CLOSURE_COMPLEMENT ← prove
   r"!s:real^N->bool. closure(UNIV DIFF s) = UNIV DIFF interior(s)"
   (REWRITE_TAC [← SET_RULE (← q r"s = UNIV DIFF t <=> UNIV DIFF s = t")] THEN
    REWRITE_TAC [← GSYM INTERIOR_CLOSURE])

  let INTERIOR_COMPLEMENT ← prove
   r"!s:real^N->bool. interior(UNIV DIFF s) = UNIV DIFF closure(s)"
   (REWRITE_TAC [← SET_RULE (← q r"s = UNIV DIFF t <=> UNIV DIFF s = t")] THEN
    REWRITE_TAC [← GSYM CLOSURE_INTERIOR])

  let CLOSURE_LOCALLY_FINITE_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        locally_finite_in euclidean f
        ==> closure(UNIONS f) = UNIONS {closure s | s IN f}"
   (REWRITE_TAC [← GSYM EUCLIDEAN_CLOSURE_OF, CLOSURE_OF_LOCALLY_FINITE_UNIONS])

  let CONNECTED_INTERMEDIATE_CLOSURE ← prove
   r"!s t:real^N->bool.
        connected s /\ s SUBSET t /\ t SUBSET closure s ==> connected t"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, ← GSYM EUCLIDEAN_CLOSURE_OF,
                 CONNECTED_IN_INTERMEDIATE_CLOSURE_OF])

  let CONNECTED_CLOSURE ← prove
   r"!s:real^N->bool. connected s ==> connected(closure s)"
   (MESON_TAC [CONNECTED_INTERMEDIATE_CLOSURE, CLOSURE_SUBSET, SUBSET_REFL])

  let CONNECTED_UNION_STRONG ← prove
   r"!s t:real^N->bool.
        connected s /\ connected t /\ ~(closure s INTER t = {})
        ==> connected(s UNION t)"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, ← GSYM EUCLIDEAN_CLOSURE_OF] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_IN_NONSEPARATED_UNION THEN
    ASM_REWRITE_TAC [separated_in] THEN ASM SET_TAC [])

  let CONNECTED_INSERT ← prove
   r"!s a:real^N. connected s
                ==> (connected(a INSERT s) <=> s = {} \/ a IN closure s)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [CLOSURE_EMPTY, CONNECTED_SING] THEN
    DISCH_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [CONNECTED_CLOSED, NOT_EXISTS_THM] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"{a:real^N}", ← q r"closure s:real^N->bool"]) THEN
      REWRITE_TAC [CLOSED_CLOSURE, CLOSED_SING] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC [],
      DISCH_TAC THEN ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = s UNION {a}")] THEN
      MATCH_MP_TAC CONNECTED_UNION_STRONG THEN
      ASM_REWRITE_TAC [CONNECTED_SING] THEN ASM SET_TAC []])

  let CONNECTED_INSERT_LIMPT ← prove
   r"!s a:real^N. connected s /\ a limit_point_of s ==> connected(a INSERT s)"
   (SIMP_TAC [CONNECTED_INSERT, closure, IN_UNION, IN_ELIM_THM])

  let INTERIOR_DIFF ← prove
   r"!s t. interior(s DIFF t) = interior(s) DIFF closure(t)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
    REWRITE_TAC [INTERIOR_INTER, CLOSURE_INTERIOR] THEN SET_TAC [])

  return { closure, EUCLIDEAN_CLOSURE_OF, CLOSURE_APPROACHABLE, CLOSURE_NONEMPTY_OPEN_INTER,
           CLOSURE_INTERIOR, INTERIOR_CLOSURE, CLOSED_CLOSURE, CLOSURE_HULL, CLOSURE_EQ,
           CLOSURE_CLOSED, CLOSURE_CLOSURE, CLOSURE_SUBSET, CLOSURE_INC, SUBSET_CLOSURE,
           CLOSURE_UNION, CLOSURE_UNIONS_SUBSET, CLOSURE_INTER_SUBSET, CLOSURE_INTERS_SUBSET,
           CLOSURE_MINIMAL, CLOSURE_MINIMAL_EQ, CLOSURE_UNIQUE, CLOSURE_EMPTY, CLOSURE_UNIV,
           LIMPT_OF_OPEN_CLOSURE, CLOSURE_UNIONS, CLOSURE_EQ_EMPTY, CLOSURE_SUBSET_EQ,
           OPEN_INTER_CLOSURE_EQ_EMPTY, CLOSURE_MINIMAL_LOCAL, CLOSURE_OPEN_IN_INTER_CLOSURE,
           OPEN_IN_INTER_CLOSURE_EQ_EMPTY, CLOSURE_OPEN_INTER_CLOSURE, OPEN_INTER_CLOSURE_SUBSET,
           OPEN_INTER_CLOSURE_EQ, CLOSURE_OPEN_INTER_SUPERSET, CLOSURE_COMPLEMENT,
           INTERIOR_COMPLEMENT, CLOSURE_LOCALLY_FINITE_UNIONS, CONNECTED_INTERMEDIATE_CLOSURE,
           CONNECTED_CLOSURE, CONNECTED_UNION_STRONG, CONNECTED_INSERT, CONNECTED_INSERT_LIMPT,
           INTERIOR_DIFF }

/- ------------------------------------------------------------------------- -/
/- Closure of a set, part 2.  (topology.ml 2334-2557)                        -/
/- ------------------------------------------------------------------------- -/

structure CLS2 where
  LIMPT_OF_CLOSURE : thm
  PERFECT_FROM_CLOSURE : thm
  DENSE_IMP_PERFECT : thm
  CLOSED_IN_LIMPT : thm
  CLOSED_IN_INTER_CLOSURE : thm
  INTERIOR_CLOSURE_IDEMP : thm
  CLOSURE_INTERIOR_IDEMP : thm
  NOWHERE_DENSE_UNION : thm
  NOWHERE_DENSE : thm
  INTERIOR_CLOSURE_INTER_OPEN : thm
  CLOSURE_INTERIOR_UNION_CLOSED : thm
  REGULAR_OPEN_INTER : thm
  REGULAR_CLOSED_UNION : thm
  REGULAR_CLOSED_UNIONS : thm
  DIFF_CLOSURE_SUBSET : thm
  DENSE_OPEN_INTER : thm
  DENSE_OPEN_INTERS : thm
  SEPARATION_CLOSED_IN_UNION : thm
  SEPARATION_OPEN_IN_UNION : thm
  CONNECTED_SEPARATION : thm
  CONNECTED_SEPARATION_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupCLS2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BCON : CON)
    (BLPT : LPT) (BINT : INT) (BCLS1 : CLS1) : ExceptT String IO CLS2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, NORM_ARITH, .. } := D
  let { CONJ_ACI, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_INSERT, IMP_CONJ, IMP_CONJ_ALT, INTERS_0, INTERS_INSERT, INTER_COMM,
        INTER_SUBSET, INTER_UNIV, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNION, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core3
  let { REAL_LT_MIN, .. } := D.core4
  let { REAL_NOT_LE, SUBSET, SUBSET_TRANS, SUBSET_UNIV, .. } := D.core5
  let { SWAP_FORALL_THM, UNIONS_0, UNIONS_INSERT, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { CLOSED_IN_DERIVED_SET, CLOSED_IN_INTER_CLOSURE_OF, CLOSURE_OF_INTERIOR_OF_IDEMP,
        CONNECTED_IN_SEPARATION, CONNECTED_IN_SEPARATION_ALT, .. } := D.met1
  let { INTERIOR_OF_CLOSURE_OF_IDEMP, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, SEPARATION_CLOSED_IN_UNION_GEN, SEPARATION_OPEN_IN_UNION_GEN,
        separated_in, .. } := D.met3
  let { OPEN_INTER, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { OPEN_DIFF, closed, .. } := BCLO
  let { open_in, .. } := BLOC
  let { CONNECTED_IN_EUCLIDEAN, .. } := BCON
  let { LIMIT_POINT_IN_DERIVED_SET, LIMIT_POINT_UNION, LIMPT_OF_LIMPTS, LIMPT_OF_UNIV, .. } :=
    BLPT
  let { EUCLIDEAN_INTERIOR_OF, INTERIOR_EMPTY, INTERIOR_EQ_EMPTY, INTERIOR_EQ_EMPTY_ALT,
        INTERIOR_INTER, INTERIOR_MAXIMAL, INTERIOR_UNION_EQ_EMPTY, OPEN_INTERIOR,
        SUBSET_INTERIOR, .. } := BINT
  let { closure, EUCLIDEAN_CLOSURE_OF, CLOSURE_APPROACHABLE, CLOSED_CLOSURE, CLOSURE_SUBSET,
        SUBSET_CLOSURE, CLOSURE_UNION, CLOSURE_EMPTY, CLOSURE_UNIV,
        OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_INTER_CLOSURE_SUBSET, CLOSURE_COMPLEMENT,
        INTERIOR_COMPLEMENT, .. } := BCLS1
  -- @@SCOPE END

  let LIMPT_OF_CLOSURE ← prove
   r"!x:real^N s. x limit_point_of closure s <=> x limit_point_of s"
   (REWRITE_TAC [closure, IN_UNION, IN_ELIM_THM, LIMIT_POINT_UNION] THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q r"(q ==> p) ==> (p \/ q <=> p)")) THEN
    REWRITE_TAC [LIMPT_OF_LIMPTS])

  let PERFECT_FROM_CLOSURE ← prove
   r"!s:real^N->bool.
        (!x. x IN closure s ==> x limit_point_of closure s)
        ==> !x. x IN s ==> x limit_point_of s"
   (REWRITE_TAC [LIMPT_OF_CLOSURE] THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET])

  let DENSE_IMP_PERFECT ← prove
   r"!s. closure s = (:real^N) ==> !x. x IN s ==> x limit_point_of s"
   (GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC PERFECT_FROM_CLOSURE THEN
    ASM_REWRITE_TAC [LIMPT_OF_UNIV])

  let CLOSED_IN_LIMPT ← prove
   r"!s t. closed_in (subtopology euclidean t) s <=>
         s SUBSET t /\ !x:real^N. x limit_point_of s /\ x IN t ==> x IN s"
   (REWRITE_TAC [CLOSED_IN_DERIVED_SET, TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    REWRITE_TAC [LIMIT_POINT_IN_DERIVED_SET])

  let CLOSED_IN_INTER_CLOSURE ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean s) t <=> s INTER closure t = t"
   (REWRITE_TAC [CLOSED_IN_INTER_CLOSURE_OF, EUCLIDEAN_CLOSURE_OF])

  let INTERIOR_CLOSURE_IDEMP ← prove
   r"!s:real^N->bool.
        interior(closure(interior(closure s))) = interior(closure s)"
   (REWRITE_TAC [← GSYM EUCLIDEAN_INTERIOR_OF, ← GSYM EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [INTERIOR_OF_CLOSURE_OF_IDEMP])

  let CLOSURE_INTERIOR_IDEMP ← prove
   r"!s:real^N->bool.
        closure(interior(closure(interior s))) = closure(interior s)"
   (REWRITE_TAC [← GSYM EUCLIDEAN_INTERIOR_OF, ← GSYM EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [CLOSURE_OF_INTERIOR_OF_IDEMP])

  let NOWHERE_DENSE_UNION ← prove
   r"!s t:real^N->bool.
        interior(closure(s UNION t)) = {} <=>
        interior(closure s) = {} /\ interior(closure t) = {}"
   (SIMP_TAC [CLOSURE_UNION, INTERIOR_UNION_EQ_EMPTY, CLOSED_CLOSURE])

  let NOWHERE_DENSE ← prove
   r"!s:real^N->bool.
        interior(closure s) = {} <=>
        !t. open t /\ ~(t = {})
            ==> ?u. open u /\ ~(u = {}) /\ u SUBSET t /\ u INTER s = {}"
   (GEN_TAC THEN REWRITE_TAC [INTERIOR_EQ_EMPTY_ALT] THEN EQ_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THENL
     [EXISTS_TAC (← q r"t DIFF closure s:real^N->bool") THEN
      ASM_SIMP_TAC [OPEN_DIFF, CLOSED_CLOSURE] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^N->bool")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"s:real^N->bool"]
          OPEN_INTER_CLOSURE_EQ_EMPTY) THEN
      ASM SET_TAC []])

  let INTERIOR_CLOSURE_INTER_OPEN ← prove
   r"!s t:real^N->bool.
        open s /\ open t
        ==> interior(closure(s INTER t)) =
            interior(closure s) INTER interior(closure t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← SET_RULE
     (← q r"u = s INTER t <=> s INTER t SUBSET u /\ u SUBSET s /\ u SUBSET t")] THEN
    SIMP_TAC [SUBSET_INTERIOR, SUBSET_CLOSURE, INTER_SUBSET] THEN
    MATCH_MP_TAC INTERIOR_MAXIMAL THEN SIMP_TAC [OPEN_INTER, OPEN_INTERIOR] THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET t <=> s INTER (UNIV DIFF t) = {}"),
                 ← GSYM INTERIOR_COMPLEMENT] THEN
    REWRITE_TAC [← GSYM INTERIOR_INTER] THEN
    REWRITE_TAC [INTERIOR_EQ_EMPTY] THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"u INTER s:real^N->bool", ← q r"t:real^N->bool"]
          OPEN_INTER_CLOSURE_EQ_EMPTY) THEN
    MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"s:real^N->bool"]
          OPEN_INTER_CLOSURE_EQ_EMPTY) THEN
    ASM_SIMP_TAC [OPEN_INTER] THEN ASM SET_TAC [])

  let CLOSURE_INTERIOR_UNION_CLOSED ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t
        ==> closure(interior(s UNION t)) =
            closure(interior s) UNION closure(interior t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INTERIOR_CLOSURE_INTER_OPEN) THEN
    REWRITE_TAC [CLOSURE_COMPLEMENT, INTERIOR_COMPLEMENT,
                 ← SET_RULE (← q r"(UNIV DIFF s) INTER (UNIV DIFF t) =
                          UNIV DIFF (s UNION t)")] THEN
    SET_TAC [])

  let REGULAR_OPEN_INTER ← prove
   r"!s t:real^N->bool.
        interior(closure s) = s /\ interior(closure t) = t
        ==> interior(closure(s INTER t)) = s INTER t"
   (MESON_TAC [INTERIOR_CLOSURE_INTER_OPEN, OPEN_INTERIOR])

  let REGULAR_CLOSED_UNION ← prove
   r"!s t:real^N->bool.
        closure(interior s) = s /\ closure(interior t) = t
        ==> closure(interior(s UNION t)) = s UNION t"
   (MESON_TAC [CLOSURE_INTERIOR_UNION_CLOSED, CLOSED_CLOSURE])

  let REGULAR_CLOSED_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f /\ (!t. t IN f ==> closure(interior t) = t)
        ==> closure(interior(UNIONS f)) = UNIONS f"
   (REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_INSERT, UNIONS_0, INTERIOR_EMPTY, CLOSURE_EMPTY] THEN
    SIMP_TAC [FORALL_IN_INSERT, REGULAR_CLOSED_UNION])

  let DIFF_CLOSURE_SUBSET ← prove
   r"!s t:real^N->bool. closure(s) DIFF closure t SUBSET closure(s DIFF t)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"(:real^N) DIFF closure t", ← q r"s:real^N->bool"]
          OPEN_INTER_CLOSURE_SUBSET) THEN
    REWRITE_TAC [← SET_RULE (← q r"(UNIV DIFF t) INTER s = s DIFF t")] THEN
    REWRITE_TAC [← GSYM closed, CLOSED_CLOSURE] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
    MATCH_MP_TAC SUBSET_CLOSURE THEN
    MATCH_MP_TAC (← SET_RULE (← q r"t SUBSET u ==> s DIFF u SUBSET s DIFF t")) THEN
    REWRITE_TAC [CLOSURE_SUBSET])

  let DENSE_OPEN_INTER ← prove
   r"!s t u:real^N->bool.
        (open_in (subtopology euclidean u) s /\ t SUBSET u \/
         open_in (subtopology euclidean u) t /\ s SUBSET u)
        ==> (u SUBSET closure (s INTER t) <=>
             u SUBSET closure s /\ u SUBSET closure t)"
   (MATCH_MP_TAC (← MESON []
     (← q r"(!s t u. R s t u ==> R t s u) /\
      (!s t u. P s t u ==> R s t u)
      ==> !s t u. P s t u \/ P t s u ==> R s t u")) THEN
    CONJ_TAC THENL [SIMP_TAC [INTER_COMM, CONJ_ACI], ALL_TAC] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [SUBSET_TRANS, SUBSET_CLOSURE, INTER_SUBSET], ALL_TAC] THEN
    REWRITE_TAC [SUBSET, CLOSURE_APPROACHABLE] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"x:real^N")) ASSUME_TAC) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [open_in]) THEN
    REWRITE_TAC [SUBSET, IN_INTER] THEN
    DISCH_THEN (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"y:real^N"))) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"min d (e / &2)")) THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_LT_MIN] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^N") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN ASM_SIMP_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_NOT_LE])) THEN
    CONV_TAC (fun t => NORM_ARITH t))

  let DENSE_OPEN_INTERS ← prove
   r"!g s:real^N->bool.
         FINITE g /\
         (!t. t IN g
              ==> open_in (subtopology euclidean s) t /\ s SUBSET closure t)
         ==> s SUBSET closure (INTERS g)"
   (ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [INTERS_0, CLOSURE_UNIV, SUBSET_UNIV] THEN
    REWRITE_TAC [FORALL_IN_INSERT, INTERS_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"f:(real^N->bool)->bool"] THEN
    STRIP_TAC THEN ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THEN
    ASM_SIMP_TAC [INTERS_0, INTER_UNIV] THEN STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) DENSE_OPEN_INTER o snd) THEN
    ANTS_TAC THENL [ALL_TAC, ASM_SIMP_TAC []] THEN
    DISJ1_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"u:real^N->bool")) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:real^N->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET o CONJUNCT1) THEN
    ASM SET_TAC [])

  let SEPARATION_CLOSED_IN_UNION ← prove
   r"!s t:real^N->bool.
        s INTER closure t = {} /\ t INTER closure s = {} <=>
        DISJOINT s t /\
        closed_in (subtopology euclidean (s UNION t)) s /\
        closed_in (subtopology euclidean (s UNION t)) t"
   (REPEAT GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"euclidean:(real^N)topology", ← q r"s:real^N->bool", ← q r"t:real^N->bool"]
     SEPARATION_CLOSED_IN_UNION_GEN) THEN
    REWRITE_TAC [separated_in, TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    REWRITE_TAC [EUCLIDEAN_CLOSURE_OF])

  let SEPARATION_OPEN_IN_UNION ← prove
   r"!s t:real^N->bool.
        s INTER closure t = {} /\ t INTER closure s = {} <=>
        DISJOINT s t /\
        open_in (subtopology euclidean (s UNION t)) s /\
        open_in (subtopology euclidean (s UNION t)) t"
   (REPEAT GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"euclidean:(real^N)topology", ← q r"s:real^N->bool", ← q r"t:real^N->bool"]
     SEPARATION_OPEN_IN_UNION_GEN) THEN
    REWRITE_TAC [separated_in, TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    REWRITE_TAC [EUCLIDEAN_CLOSURE_OF])

  let (CONNECTED_SEPARATION, CONNECTED_SEPARATION_ALT) ← CONJ_PAIR (← prove
   r"(!s:real^N->bool.
        connected s <=>
        ~(?c1 c2. c1 UNION c2 = s /\ ~(c1 = {}) /\ ~(c2 = {}) /\
                  c1 INTER closure c2 = {} /\ c2 INTER closure c1 = {})) /\
   (!s:real^N->bool.
        connected s <=>
        ~(?c1 c2.
            s SUBSET c1 UNION c2 /\ ~(c1 INTER s = {}) /\ ~(c2 INTER s = {}) /\
            c1 INTER closure c2 = {} /\ c2 INTER closure c1 = {}))"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN] THEN CONJ_TAC THENL
     [REWRITE_TAC [CONNECTED_IN_SEPARATION],
      REWRITE_TAC [CONNECTED_IN_SEPARATION_ALT]] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV, EUCLIDEAN_CLOSURE_OF]))

  return { LIMPT_OF_CLOSURE, PERFECT_FROM_CLOSURE, DENSE_IMP_PERFECT, CLOSED_IN_LIMPT,
           CLOSED_IN_INTER_CLOSURE, INTERIOR_CLOSURE_IDEMP, CLOSURE_INTERIOR_IDEMP,
           NOWHERE_DENSE_UNION, NOWHERE_DENSE, INTERIOR_CLOSURE_INTER_OPEN,
           CLOSURE_INTERIOR_UNION_CLOSED, REGULAR_OPEN_INTER, REGULAR_CLOSED_UNION,
           REGULAR_CLOSED_UNIONS, DIFF_CLOSURE_SUBSET, DENSE_OPEN_INTER, DENSE_OPEN_INTERS,
           SEPARATION_CLOSED_IN_UNION, SEPARATION_OPEN_IN_UNION, CONNECTED_SEPARATION,
           CONNECTED_SEPARATION_ALT }

/- ------------------------------------------------------------------------- -/
/- Frontier (aka boundary), part 1.  (topology.ml 2558-2782)                 -/
/- ------------------------------------------------------------------------- -/

structure FRO1 where
  frontier : thm
  EUCLIDEAN_FRONTIER_OF : thm
  FRONTIER_CLOSED : thm
  FRONTIER_CLOSURES : thm
  FRONTIER_OPEN_STRADDLE_INTER : thm
  FRONTIER_UNION_INTERIOR : thm
  FRONTIER_STRADDLE : thm
  FRONTIER_SUBSET_CLOSED : thm
  FRONTIER_EMPTY : thm
  FRONTIER_UNIV : thm
  FRONTIER_SUBSET_EQ : thm
  FRONTIER_COMPLEMENT : thm
  FRONTIER_DISJOINT_EQ : thm
  FRONTIER_INTER : thm
  FRONTIER_INTER_SUBSET : thm
  FRONTIER_INTER_CLOSED : thm
  FRONTIER_UNION_SUBSET : thm
  FRONTIER_INTERIORS : thm
  FRONTIER_FRONTIER_SUBSET : thm
  INTERIOR_FRONTIER : thm
  THIN_FRONTIER_SUBSET : thm
  THIN_FRONTIER_CIC : thm
  THIN_FRONTIER_ICI : thm
  INTERIOR_FRONTIER_EMPTY : thm
  FRONTIER_FRONTIER : thm
  FRONTIER_FRONTIER_FRONTIER : thm
  REGULAR_CLOSURE_INTERIOR : thm
  REGULAR_INTERIOR_CLOSURE : thm
  REGULAR_CLOSED : thm
  REGULAR_OPEN : thm
  REGULAR_CLOSURE_IMP_THIN_FRONTIER : thm
  REGULAR_INTERIOR_IMP_THIN_FRONTIER : thm
  UNION_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupFRO1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLPT : LPT)
    (BINT : INT) (BCLS1 : CLS1) : ExceptT String IO FRO1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DE_MORGAN_THM, DISJ_SYM, EMPTY_DIFF, .. } := D.core1
  let { INTER_COMM, INTER_SUBSET, IN_DIFF, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, MONO_AND, MONO_OR, .. } := D.core3
  let { REAL_LT_MIN, .. } := D.core4
  let { SUBSET, SUBSET_ANTISYM_EQ, SUBSET_DIFF, SUBSET_UNIV, .. } := D.core5
  let { UNION_COMM, UNION_SUBSET, .. } := D.core6
  let { DIST_REFL, .. } := D.vec1
  let { FRONTIER_OF_FRONTIER_OF, INTERIOR_OF_FRONTIER_OF, INTERIOR_OF_FRONTIER_OF_EMPTY, .. } :=
    D.met2
  let { REGULAR_CLOSED_IN, REGULAR_CLOSURE_OF_INTERIOR_OF, REGULAR_INTERIOR_OF_CLOSURE_OF,
        REGULAR_OPEN_IN, THIN_FRONTIER_OF_CIC, THIN_FRONTIER_OF_ICI, frontier_of, .. } := D.met3
  let { OPEN_IN, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { CLOSED_DIFF, CLOSED_IN, CLOSED_INTER, OPEN_CLOSED, .. } := BCLO
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := BBAL
  let { limit_point_of, .. } := BLPT
  let { EUCLIDEAN_INTERIOR_OF, INTERIOR_SUBSET, INTERIOR_UNIV, IN_INTERIOR, OPEN_INTERIOR, .. } :=
    BINT
  let { CLOSED_CLOSURE, CLOSURE_CLOSED, CLOSURE_COMPLEMENT, CLOSURE_EMPTY, CLOSURE_INTERIOR,
        CLOSURE_SUBSET, CLOSURE_SUBSET_EQ, CLOSURE_UNION, CLOSURE_UNIV, EUCLIDEAN_CLOSURE_OF,
        INTERIOR_CLOSURE, INTERIOR_COMPLEMENT, OPEN_INTER_CLOSURE_EQ_EMPTY, SUBSET_CLOSURE,
        closure, .. } := BCLS1
  -- @@SCOPE END

  let frontier ← new_definition
   r"frontier s = (closure s) DIFF (interior s)"

  let EUCLIDEAN_FRONTIER_OF ← prove
   r"!s:real^N->bool. euclidean frontier_of s = frontier s"
   (REWRITE_TAC [frontier, frontier_of] THEN
    REWRITE_TAC [EUCLIDEAN_CLOSURE_OF, EUCLIDEAN_INTERIOR_OF])

  let FRONTIER_CLOSED ← prove
   r"!s. closed(frontier s)"
   (SIMP_TAC [frontier, CLOSED_DIFF, CLOSED_CLOSURE, OPEN_INTERIOR])

  let FRONTIER_CLOSURES ← do
    let lemma ← prove r"s DIFF (UNIV DIFF t) = s INTER t" (SET_TAC [])
    prove
     r"!s:real^N->bool. frontier s = (closure s) INTER (closure(UNIV DIFF s))"
     (REWRITE_TAC [frontier, INTERIOR_CLOSURE, lemma])

  let FRONTIER_OPEN_STRADDLE_INTER ← prove
   r"!s u:real^N->bool.
        open u /\ ~(u INTER frontier s = {})
        ==> ~(u INTER s = {}) /\ ~(u DIFF s = {})"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [FRONTIER_CLOSURES] THEN DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(s INTER t INTER u = {})
      ==> ~(s INTER t = {}) /\ ~(s INTER u = {})"))) THEN
    MATCH_MP_TAC MONO_AND THEN ASM_SIMP_TAC [OPEN_INTER_CLOSURE_EQ_EMPTY] THEN
    SET_TAC [])

  let FRONTIER_UNION_INTERIOR ← prove
   r"!s:real^N->bool. frontier s UNION interior s = closure s"
   (GEN_TAC THEN REWRITE_TAC [frontier] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN
    SET_TAC [])

  let FRONTIER_STRADDLE ← prove
   r"!a:real^N s.
     a IN frontier s <=>
        !e. &0 < e ==> (?x. x IN s /\ dist(a,x) < e) /\
                       (?x. ~(x IN s) /\ dist(a,x) < e)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FRONTIER_CLOSURES, IN_INTER] THEN
    REWRITE_TAC [closure, IN_UNION, IN_ELIM_THM, limit_point_of,
                 IN_UNIV, IN_DIFF] THEN
    ASM_MESON_TAC [IN_BALL, SUBSET, OPEN_CONTAINS_BALL,
                   CENTRE_IN_BALL, OPEN_BALL, DIST_REFL])

  let FRONTIER_SUBSET_CLOSED ← prove
   r"!s. closed s ==> (frontier s) SUBSET s"
   (MESON_TAC [frontier, CLOSURE_CLOSED, SUBSET_DIFF])

  let FRONTIER_EMPTY ← prove
   r"frontier {} = {}"
   (REWRITE_TAC [frontier, CLOSURE_EMPTY, EMPTY_DIFF])

  let FRONTIER_UNIV ← prove
   r"frontier(:real^N) = {}"
   (REWRITE_TAC [frontier, CLOSURE_UNIV, INTERIOR_UNIV] THEN SET_TAC [])

  let FRONTIER_SUBSET_EQ ← prove
   r"!s:real^N->bool. (frontier s) SUBSET s <=> closed s"
   (GEN_TAC THEN EQ_TAC THEN SIMP_TAC [FRONTIER_SUBSET_CLOSED] THEN
    REWRITE_TAC [frontier] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"s DIFF t SUBSET u ==> t SUBSET u ==> s SUBSET u"))) THEN
    REWRITE_TAC [INTERIOR_SUBSET, CLOSURE_SUBSET_EQ])

  let FRONTIER_COMPLEMENT ← prove
   r"!s:real^N->bool. frontier(UNIV DIFF s) = frontier s"
   (REWRITE_TAC [frontier, CLOSURE_COMPLEMENT, INTERIOR_COMPLEMENT] THEN
    SET_TAC [])

  let FRONTIER_DISJOINT_EQ ← prove
   r"!s. (frontier s) INTER s = {} <=> open s"
   (ONCE_REWRITE_TAC [← GSYM FRONTIER_COMPLEMENT, OPEN_CLOSED] THEN
    REWRITE_TAC [← GSYM FRONTIER_SUBSET_EQ] THEN SET_TAC [])

  let FRONTIER_INTER ← prove
   r"!s t:real^N->bool.
        frontier(s INTER t) =
        closure(s INTER t) INTER (frontier s UNION frontier t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FRONTIER_CLOSURES] THEN
    SIMP_TAC [SUBSET_CLOSURE, INTER_SUBSET, ← GSYM CLOSURE_UNION, ← SET_RULE
      (← q r"u SUBSET s /\ u SUBSET t
       ==> u INTER (s INTER x UNION t INTER y) = u INTER (x UNION y)")] THEN
    REPLICATE_TAC 2 AP_TERM_TAC THEN SET_TAC [])

  let FRONTIER_INTER_SUBSET ← prove
   r"!s t. frontier(s INTER t) SUBSET frontier(s) UNION frontier(t)"
   (REWRITE_TAC [FRONTIER_INTER] THEN SET_TAC [])

  let FRONTIER_INTER_CLOSED ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t
        ==> frontier(s INTER t) = frontier s INTER t UNION s INTER frontier t"
   (SIMP_TAC [FRONTIER_INTER, CLOSED_INTER, CLOSURE_CLOSED] THEN
    REWRITE_TAC [← GSYM FRONTIER_SUBSET_EQ] THEN SET_TAC [])

  let FRONTIER_UNION_SUBSET ← prove
   r"!s t:real^N->bool. frontier(s UNION t) SUBSET frontier s UNION frontier t"
   (ONCE_REWRITE_TAC [← GSYM FRONTIER_COMPLEMENT] THEN
    REWRITE_TAC [← SET_RULE (← q r"u DIFF (s UNION t) = (u DIFF s) INTER (u DIFF t)")] THEN
    REWRITE_TAC [FRONTIER_INTER_SUBSET])

  let FRONTIER_INTERIORS ← prove
   r"!s. frontier s = (:real^N) DIFF interior(s) DIFF interior((:real^N) DIFF s)"
   (REWRITE_TAC [frontier, CLOSURE_INTERIOR] THEN SET_TAC [])

  let FRONTIER_FRONTIER_SUBSET ← prove
   r"!s:real^N->bool. frontier(frontier s) SUBSET frontier s"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [frontier] THEN
    SIMP_TAC [CLOSURE_CLOSED, FRONTIER_CLOSED] THEN SET_TAC [])

  let INTERIOR_FRONTIER ← prove
   r"!s:real^N->bool.
        interior(frontier s) = interior(closure s) DIFF closure(interior s)"
   (REWRITE_TAC [← GSYM EUCLIDEAN_INTERIOR_OF, ← GSYM EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [← GSYM EUCLIDEAN_FRONTIER_OF, INTERIOR_OF_FRONTIER_OF])

  let THIN_FRONTIER_SUBSET ← prove
   r"!s:real^N->bool.
        interior(frontier s) = {} <=>
        interior(closure s) SUBSET closure(interior s)"
   (REWRITE_TAC [INTERIOR_FRONTIER] THEN SET_TAC [])

  let THIN_FRONTIER_CIC ← prove
   r"!s:real^N->bool.
        interior(frontier s) = {} <=>
        closure(interior(closure s)) = closure(interior s)"
   (REWRITE_TAC [← GSYM EUCLIDEAN_INTERIOR_OF, ← GSYM EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [← GSYM EUCLIDEAN_FRONTIER_OF, THIN_FRONTIER_OF_CIC])

  let THIN_FRONTIER_ICI ← prove
   r"!s:real^N->bool.
        interior(frontier s) = {} <=>
        interior(closure(interior s)) = interior(closure s)"
   (REWRITE_TAC [← GSYM EUCLIDEAN_INTERIOR_OF, ← GSYM EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [← GSYM EUCLIDEAN_FRONTIER_OF, THIN_FRONTIER_OF_ICI])

  let INTERIOR_FRONTIER_EMPTY ← prove
   r"!s:real^N->bool. open s \/ closed s ==> interior(frontier s) = {}"
   (REWRITE_TAC [OPEN_IN, CLOSED_IN, ← GSYM EUCLIDEAN_INTERIOR_OF] THEN
    REWRITE_TAC [← GSYM EUCLIDEAN_FRONTIER_OF, INTERIOR_OF_FRONTIER_OF_EMPTY])

  let FRONTIER_FRONTIER ← prove
   r"!s:real^N->bool. open s \/ closed s ==> frontier(frontier s) = frontier s"
   (REWRITE_TAC [OPEN_IN, CLOSED_IN, ← GSYM EUCLIDEAN_FRONTIER_OF] THEN
    REWRITE_TAC [FRONTIER_OF_FRONTIER_OF])

  let FRONTIER_FRONTIER_FRONTIER ← prove
   r"!s:real^N->bool. frontier(frontier(frontier s)) = frontier(frontier s)"
   (SIMP_TAC [FRONTIER_FRONTIER, FRONTIER_CLOSED])

  let REGULAR_CLOSURE_INTERIOR ← prove
   r"!s:real^N->bool.
        s SUBSET closure(interior s) <=>
        closure(interior s) = closure s"
   (REWRITE_TAC [← GSYM EUCLIDEAN_CLOSURE_OF, ← GSYM EUCLIDEAN_INTERIOR_OF] THEN
    SIMP_TAC [REGULAR_CLOSURE_OF_INTERIOR_OF, TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let REGULAR_INTERIOR_CLOSURE ← prove
   r"!s:real^N->bool.
        interior(closure s) SUBSET s <=>
        interior(closure s) = interior s"
   (REWRITE_TAC [← GSYM EUCLIDEAN_CLOSURE_OF, ← GSYM EUCLIDEAN_INTERIOR_OF] THEN
    REWRITE_TAC [REGULAR_INTERIOR_OF_CLOSURE_OF])

  let REGULAR_CLOSED ← prove
   r"!s:real^N->bool.
      closure(interior s) = s <=>
      closed s /\ s SUBSET closure(interior s)"
   (REWRITE_TAC [← GSYM EUCLIDEAN_CLOSURE_OF, ← GSYM EUCLIDEAN_INTERIOR_OF] THEN
    REWRITE_TAC [CLOSED_IN, REGULAR_CLOSED_IN])

  let REGULAR_OPEN ← prove
   r"!s:real^N->bool.
        interior(closure s) = s <=>
        open s /\ interior(closure s) SUBSET s"
   (REWRITE_TAC [← GSYM EUCLIDEAN_CLOSURE_OF, ← GSYM EUCLIDEAN_INTERIOR_OF] THEN
    REWRITE_TAC [OPEN_IN, REGULAR_OPEN_IN])

  let REGULAR_CLOSURE_IMP_THIN_FRONTIER ← prove
   r"!s:real^N->bool.
        s SUBSET closure(interior s) ==> interior(frontier s) = {}"
   (SIMP_TAC [REGULAR_CLOSURE_INTERIOR, THIN_FRONTIER_ICI])

  let REGULAR_INTERIOR_IMP_THIN_FRONTIER ← prove
   r"!s:real^N->bool.
        interior(closure s) SUBSET s ==> interior(frontier s) = {}"
   (SIMP_TAC [REGULAR_INTERIOR_CLOSURE, THIN_FRONTIER_CIC])

  let UNION_FRONTIER ← do
    let lemma ← prove
     r"!s t x. x IN frontier s /\ x IN interior t ==> x IN frontier(s INTER t)"
     (REWRITE_TAC [FRONTIER_STRADDLE, IN_INTER, IN_INTERIOR, SUBSET, IN_BALL] THEN
      REPEAT GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_TAC (← q r"d:real"))) THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"min d e:real")) THEN
      ASM_REWRITE_TAC [REAL_LT_MIN] THEN ASM_MESON_TAC [])
    prove
     r"!s t:real^N->bool.
        frontier(s) UNION frontier(t) =
        frontier(s UNION t) UNION
        frontier(s INTER t) UNION
        frontier(s) INTER frontier(t)"
     (REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNION_SUBSET,
                   FRONTIER_UNION_SUBSET, FRONTIER_INTER_SUBSET,
                   ← SET_RULE (← q r"s INTER t SUBSET s UNION t")] THEN
      REWRITE_TAC [← GSYM UNION_SUBSET] THEN REWRITE_TAC [SUBSET, IN_UNION] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"(!s t x. P s x ==> R x s t) /\ (!s t x. R x s t <=> R x t s)
        ==> (!s t x. P s x \/ P t x ==> R x s t)")) THEN
      CONJ_TAC THENL [REPEAT STRIP_TAC, REWRITE_TAC [UNION_COMM, INTER_COMM]] THEN
      ASM_CASES_TAC (← q r"(x:real^N) IN frontier t") THEN ASM_REWRITE_TAC [IN_INTER] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE (RAND_CONV o RAND_CONV)
            [FRONTIER_INTERIORS]) THEN
      REWRITE_TAC [DE_MORGAN_THM, IN_DIFF, IN_UNIV] THEN
      GEN_REWRITE_TAC RAND_CONV [DISJ_SYM] THEN MATCH_MP_TAC MONO_OR THEN
      ASM_SIMP_TAC [lemma] THEN
      POP_ASSUM MP_TAC THEN ONCE_REWRITE_TAC [← GSYM FRONTIER_COMPLEMENT] THEN
      SIMP_TAC [lemma, ← SET_RULE
        (← q r"UNIV DIFF (s UNION t) = (UNIV DIFF s) INTER (UNIV DIFF t)")])

  return { frontier, EUCLIDEAN_FRONTIER_OF, FRONTIER_CLOSED, FRONTIER_CLOSURES,
           FRONTIER_OPEN_STRADDLE_INTER, FRONTIER_UNION_INTERIOR, FRONTIER_STRADDLE,
           FRONTIER_SUBSET_CLOSED, FRONTIER_EMPTY, FRONTIER_UNIV, FRONTIER_SUBSET_EQ,
           FRONTIER_COMPLEMENT, FRONTIER_DISJOINT_EQ, FRONTIER_INTER, FRONTIER_INTER_SUBSET,
           FRONTIER_INTER_CLOSED, FRONTIER_UNION_SUBSET, FRONTIER_INTERIORS,
           FRONTIER_FRONTIER_SUBSET, INTERIOR_FRONTIER, THIN_FRONTIER_SUBSET, THIN_FRONTIER_CIC,
           THIN_FRONTIER_ICI, INTERIOR_FRONTIER_EMPTY, FRONTIER_FRONTIER,
           FRONTIER_FRONTIER_FRONTIER, REGULAR_CLOSURE_INTERIOR, REGULAR_INTERIOR_CLOSURE,
           REGULAR_CLOSED, REGULAR_OPEN, REGULAR_CLOSURE_IMP_THIN_FRONTIER,
           REGULAR_INTERIOR_IMP_THIN_FRONTIER, UNION_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Frontier (aka boundary), part 2.  (topology.ml 2784-2928)                 -/
/- ------------------------------------------------------------------------- -/

structure FRO2 where
  CONNECTED_INTER_FRONTIER : thm
  FRONTIER_NOT_EMPTY : thm
  FRONTIER_EQ_EMPTY : thm
  INTERIOR_CLOSED_EQ_EMPTY_AS_FRONTIER : thm
  FRONTIER_UNION : thm
  CLOSURE_UNION_FRONTIER : thm
  FRONTIER_INTERIOR_SUBSET : thm
  FRONTIER_CLOSURE_SUBSET : thm
  SET_DIFF_FRONTIER : thm
  FRONTIER_INTER_SUBSET_INTER : thm
  COMMON_FRONTIER_DOMAINS : thm
  FRONTIER_OPEN_UNION : thm
  FRONTIER_OPEN_UNIONS : thm
  CONNECTED_CLOSURE_FROM_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupFRO2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BCON : CON) (BINT : INT)
    (BCLS1 : CLS1) (BFRO1 : FRO1) : ExceptT String IO FRO2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DIFF_EMPTY, DISJOINT, EMPTY_UNIONS, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_INSERT, IMAGE_CLAUSES, IMP_CONJ, INTER_COMM, INTER_UNIONS,
        .. } := D.core2
  let { NOT_IN_EMPTY, PAIRWISE_INSERT, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET_ANTISYM, SUBSET_DIFF, .. } := D.core5
  let { UNIONS_0, UNIONS_INSERT, UNION_COMM, .. } := D.core6
  let { CONNECTED_IN_INTER_FRONTIER_OF, .. } := D.met1
  let { OPEN_UNIONS, OPEN_UNIV, .. } := BEUC
  let { OPEN_CLOSED, OPEN_DIFF, OPEN_UNION, .. } := BCLO
  let { CONNECTED_FROM_CLOSED_UNION_AND_INTER, CONNECTED_IN_EUCLIDEAN, CONNECTED_UNIV, .. } :=
    BCON
  let { INTERIOR_INTER, INTERIOR_INTERIOR, INTERIOR_OPEN, INTERIOR_SUBSET, SUBSET_INTERIOR,
        .. } := BINT
  let { CLOSED_CLOSURE, CLOSURE_CLOSED, CLOSURE_CLOSURE, CLOSURE_INTER_SUBSET, CLOSURE_SUBSET,
        CLOSURE_UNION, INTERIOR_COMPLEMENT, OPEN_INTER_CLOSURE_EQ_EMPTY, SUBSET_CLOSURE, .. } :=
    BCLS1
  let { EUCLIDEAN_FRONTIER_OF, FRONTIER_CLOSED, FRONTIER_CLOSURES, FRONTIER_COMPLEMENT,
        FRONTIER_EMPTY, FRONTIER_UNION_SUBSET, FRONTIER_UNIV, INTERIOR_FRONTIER_EMPTY,
        frontier, .. } := BFRO1
  -- @@SCOPE END

  let CONNECTED_INTER_FRONTIER ← prove
   r"!s t:real^N->bool.
        connected s /\ ~(s INTER t = {}) /\ ~(s DIFF t = {})
        ==> ~(s INTER frontier t = {})"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, ← GSYM EUCLIDEAN_FRONTIER_OF,
                 CONNECTED_IN_INTER_FRONTIER_OF])

  let FRONTIER_NOT_EMPTY ← prove
   r"!s. ~(s = {}) /\ ~(s = (:real^N)) ==> ~(frontier s = {})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(:real^N)", ← q r"s:real^N->bool"] CONNECTED_INTER_FRONTIER) THEN
    REWRITE_TAC [CONNECTED_UNIV] THEN ASM SET_TAC [])

  let FRONTIER_EQ_EMPTY ← prove
   r"!s. frontier s = {} <=> s = {} \/ s = (:real^N)"
   (MESON_TAC [FRONTIER_NOT_EMPTY, FRONTIER_EMPTY, FRONTIER_UNIV])

  let INTERIOR_CLOSED_EQ_EMPTY_AS_FRONTIER ← prove
   r"!s:real^N->bool.
        closed s /\ interior s = {} <=> ?t. open t /\ s = frontier t"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [EXISTS_TAC (← q r"(:real^N) DIFF s") THEN
      ASM_SIMP_TAC [OPEN_DIFF, OPEN_UNIV, FRONTIER_COMPLEMENT] THEN
      ASM_SIMP_TAC [frontier, CLOSURE_CLOSED, DIFF_EMPTY],
      ASM_SIMP_TAC [FRONTIER_CLOSED, INTERIOR_FRONTIER_EMPTY]])

  let FRONTIER_UNION ← prove
   r"!s t:real^N->bool.
        closure s INTER closure t = {}
        ==> frontier(s UNION t) = frontier(s) UNION frontier(t)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [FRONTIER_UNION_SUBSET] THEN
    GEN_REWRITE_TAC RAND_CONV [frontier] THEN
    REWRITE_TAC [CLOSURE_UNION] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(fs SUBSET cs /\ ft SUBSET ct) /\ k INTER fs = {} /\ k INTER ft = {}
      ==> (fs UNION ft) SUBSET (cs UNION ct) DIFF k")) THEN
    CONJ_TAC THENL [REWRITE_TAC [frontier] THEN SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [UNION_COMM] THEN
      RULE_ASSUM_TAC (ONCE_REWRITE_RULE [INTER_COMM])] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"s INTER t = {} ==> s' SUBSET s /\ s' INTER u INTER (UNIV DIFF t) = {}
        ==> u INTER s' = {}"))) THEN
    REWRITE_TAC [frontier, SUBSET_DIFF, ← GSYM INTERIOR_COMPLEMENT] THEN
    REWRITE_TAC [← GSYM INTERIOR_INTER, ← SET_RULE
     (← q r"(s UNION t) INTER (UNIV DIFF t) = s DIFF t")] THEN
    MATCH_MP_TAC (← SET_RULE
      (← q r"ti SUBSET si ==> (c DIFF si) INTER ti = {}")) THEN
    SIMP_TAC [SUBSET_INTERIOR, SUBSET_DIFF])

  let CLOSURE_UNION_FRONTIER ← prove
   r"!s:real^N->bool. closure s = s UNION frontier s"
   (GEN_TAC THEN REWRITE_TAC [frontier] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN
    SET_TAC [])

  let FRONTIER_INTERIOR_SUBSET ← prove
   r"!s:real^N->bool. frontier(interior s) SUBSET frontier s"
   (GEN_TAC THEN REWRITE_TAC [frontier, INTERIOR_INTERIOR] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> s DIFF u SUBSET t DIFF u")) THEN
    SIMP_TAC [SUBSET_CLOSURE, INTERIOR_SUBSET])

  let FRONTIER_CLOSURE_SUBSET ← prove
   r"!s:real^N->bool. frontier(closure s) SUBSET frontier s"
   (GEN_TAC THEN REWRITE_TAC [frontier, CLOSURE_CLOSURE] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> u DIFF t SUBSET u DIFF s")) THEN
    SIMP_TAC [SUBSET_INTERIOR, CLOSURE_SUBSET])

  let SET_DIFF_FRONTIER ← prove
   r"!s:real^N->bool. s DIFF frontier s = interior s"
   (GEN_TAC THEN REWRITE_TAC [frontier] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN
    SET_TAC [])

  let FRONTIER_INTER_SUBSET_INTER ← prove
   r"!s t:real^N->bool.
        frontier(s INTER t) SUBSET closure s INTER frontier t UNION
                                   frontier s INTER closure t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [frontier, INTERIOR_INTER] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]
          CLOSURE_INTER_SUBSET) THEN
    SET_TAC [])

  let COMMON_FRONTIER_DOMAINS ← prove
   r"!s t:real^N->bool.
      open s /\ open t /\ connected s /\ connected t /\ frontier s = frontier t
      ==> s = t \/ DISJOINT s t"
   (REWRITE_TAC [← SET_RULE
      (← q r"s = t \/ DISJOINT s t <=>
       (s SUBSET t \/ DISJOINT s t) /\ (t SUBSET s \/ DISJOINT t s)")] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!x y. P x y ==> P y x) /\ (!x y. P x y ==> Q x y)
      ==> !x y. P x y ==> Q x y /\ Q y x")) THEN
    CONJ_TAC THENL [MESON_TAC [], REPEAT STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]
          CONNECTED_INTER_FRONTIER) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN SET_TAC [])

  let FRONTIER_OPEN_UNION ← prove
   r"!s t:real^N->bool.
        open s /\ open t /\ DISJOINT s t
        ==> frontier(s UNION t) = frontier s UNION frontier t"
   (REWRITE_TAC [DISJOINT, FRONTIER_CLOSURES] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [CLOSURE_CLOSED, ← GSYM OPEN_CLOSED, OPEN_UNION] THEN
    REWRITE_TAC [CLOSURE_UNION] THEN
    SUBGOAL_THEN
     (← q r"(s:real^N->bool) INTER closure t = {} /\ t INTER closure s = {}")
    MP_TAC THENL
     [ASM_SIMP_TAC [OPEN_INTER_CLOSURE_EQ_EMPTY] THEN ASM SET_TAC [],
      ASM SET_TAC []])

  let FRONTIER_OPEN_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f /\ (!s. s IN f ==> open s) /\ pairwise DISJOINT f
        ==> frontier(UNIONS f) = UNIONS {frontier s | s IN f}"
   (REWRITE_TAC [IMP_CONJ, SIMPLE_IMAGE] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, UNIONS_0, UNIONS_INSERT] THEN
    REWRITE_TAC [UNIONS_0, IMAGE_CLAUSES, FRONTIER_EMPTY, UNIONS_INSERT] THEN
    REWRITE_TAC [PAIRWISE_INSERT] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (SUBST1_TAC o SYM) ASSUME_TAC) THEN
    MATCH_MP_TAC FRONTIER_OPEN_UNION THEN ASM_SIMP_TAC [OPEN_UNIONS] THEN
    REWRITE_TAC [DISJOINT, INTER_UNIONS, EMPTY_UNIONS, FORALL_IN_GSPEC] THEN
    ASM_MESON_TAC [DISJOINT])

  let CONNECTED_CLOSURE_FROM_FRONTIER ← prove
   r"!s:real^N->bool. connected(frontier s) ==> connected(closure s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q r"!q. p /\ q ==> p")) THEN
    EXISTS_TAC (← q r"connected(closure((:real^N) DIFF s))") THEN
    MATCH_MP_TAC CONNECTED_FROM_CLOSED_UNION_AND_INTER THEN
    ASM_REWRITE_TAC [CLOSED_CLOSURE, ← GSYM FRONTIER_CLOSURES] THEN
    SUBGOAL_THEN
     (← q r"closure s UNION closure ((:real^N) DIFF s) = (:real^N)")
     (fun th => REWRITE_TAC [th, CONNECTED_UNIV]) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET closure s /\ (:real^N) DIFF s SUBSET closure((:real^N) DIFF s)
      ==> closure s UNION closure ((:real^N) DIFF s) = (:real^N)")) THEN
    REWRITE_TAC [CLOSURE_SUBSET])

  return { CONNECTED_INTER_FRONTIER, FRONTIER_NOT_EMPTY, FRONTIER_EQ_EMPTY,
           INTERIOR_CLOSED_EQ_EMPTY_AS_FRONTIER, FRONTIER_UNION, CLOSURE_UNION_FRONTIER,
           FRONTIER_INTERIOR_SUBSET, FRONTIER_CLOSURE_SUBSET, SET_DIFF_FRONTIER,
           FRONTIER_INTER_SUBSET_INTER, COMMON_FRONTIER_DOMAINS, FRONTIER_OPEN_UNION,
           FRONTIER_OPEN_UNIONS, CONNECTED_CLOSURE_FROM_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Useful nets in Euclidean space.  (topology.ml 2929-2996)                  -/
/- ------------------------------------------------------------------------- -/

structure NET where
  «at» : thm
  at_infinity : thm
  at_posinfinity : thm
  at_neginfinity : thm
  in_direction : thm
  AT : thm
  NETLIMIT_AT : thm
  NETLIMIT_WITHIN : thm
  AT_INFINITY : thm
  NETLIMITS_AT_INFINITY : thm
  AT_POSINFINITY : thm
  NETLIMITS_AT_POSINFINITY : thm
  AT_NEGINFINITY : thm
  NETLIMITS_AT_NEGINFINITY : thm
  WITHIN_UNIV : thm
  deriving Inhabited

@[nospecialize]
def setupNET [HolBase] (D : TopologyDeps) (BEUC : EUC) : ExceptT String IO NET := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, REAL_ARITH_TAC, .. } := D
  let { EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, IMP_CONJ, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNIV, PAIR_EQ, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, .. } := D.core5
  let { ATPOINTOF, .. } := D.met1
  let { NETLIMITS_WITHIN, NETLIMIT_ATPOINTOF, NET_WITHIN_UNIV, .. } := D.met2
  let { net_tybij, netfilter, netlimit, netlimits, .. } := D.met3
  let { OPEN_IN, .. } := BEUC
  -- @@SCOPE END

  parse_as_infix ("in_direction", (14, "right"))

  let «at» ← new_definition
   r"at a = atpointof euclidean a"

  let at_infinity ← new_definition
   r"at_infinity = mk_net({{x | b <= norm x} | b IN (:real)},{})"

  let at_posinfinity ← new_definition
   r"at_posinfinity = mk_net({{x | a <= x} | a IN (:real)},{})"

  let at_neginfinity ← new_definition
   r"at_neginfinity = mk_net({{x | x <= a} | a IN (:real)},{})"

  let in_direction ← new_definition
   r"a in_direction v = (at a) within {b | ?c. &0 <= c /\ (b - a = c % v)}"

  let AT ← prove
   r"!a:real^N.
     netfilter (at a) = { u | open u /\ a IN u}"
   (REWRITE_TAC [«at», ATPOINTOF, OPEN_IN])

  let NETLIMIT_AT ← prove
   r"!a. netlimit(at a) = a"
   (REWRITE_TAC [«at», NETLIMIT_ATPOINTOF])

  let NETLIMIT_WITHIN ← prove
   r"!a:real^N s. netlimit (at a within s) = a"
   (REWRITE_TAC [netlimit, NETLIMITS_WITHIN] THEN
    REWRITE_TAC [← GSYM netlimit] THEN REWRITE_TAC [NETLIMIT_AT])

  let (AT_INFINITY, NETLIMITS_AT_INFINITY) ← CONJ_PAIR (← prove
   r"netfilter at_infinity = {{x:real^N | b <= norm x} | b IN (:real)} /\
   netlimits at_infinity = ({}:real^N->bool)"
   (REWRITE_TAC [netfilter, netlimits, at_infinity, ← GSYM PAIR_EQ] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 net_tybij)] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"b1:real", ← q r"b2:real"] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"max b1 b2:real") THEN
    REWRITE_TAC [EXTENSION, IN_INTER, IN_ELIM_THM] THEN REAL_ARITH_TAC))

  let (AT_POSINFINITY, NETLIMITS_AT_POSINFINITY) ← CONJ_PAIR (← prove
   r"netfilter at_posinfinity = {{x | a <= x} | a IN (:real)} /\
   netlimits at_posinfinity = {}"
   (REWRITE_TAC [netfilter, netlimits, at_posinfinity, ← GSYM PAIR_EQ] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 net_tybij)] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"b1:real", ← q r"b2:real"] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"max b1 b2:real") THEN
    REWRITE_TAC [EXTENSION, IN_INTER, IN_ELIM_THM] THEN REAL_ARITH_TAC))

  let (AT_NEGINFINITY, NETLIMITS_AT_NEGINFINITY) ← CONJ_PAIR (← prove
   r"netfilter at_neginfinity = {{x | x <= a} | a IN (:real)} /\
   netlimits at_neginfinity = {}"
   (REWRITE_TAC [netfilter, netlimits, at_neginfinity, ← GSYM PAIR_EQ] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 net_tybij)] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"b1:real", ← q r"b2:real"] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"min b1 b2:real") THEN
    REWRITE_TAC [EXTENSION, IN_INTER, IN_ELIM_THM] THEN REAL_ARITH_TAC))

  let WITHIN_UNIV ← prove
   r"!x:real^N. at x within UNIV = at x"
   (REWRITE_TAC [NET_WITHIN_UNIV])

  return { «at», at_infinity, at_posinfinity, at_neginfinity, in_direction, AT, NETLIMIT_AT,
           NETLIMIT_WITHIN, AT_INFINITY, NETLIMITS_AT_INFINITY, AT_POSINFINITY,
           NETLIMITS_AT_POSINFINITY, AT_NEGINFINITY, NETLIMITS_AT_NEGINFINITY, WITHIN_UNIV }

/- ------------------------------------------------------------------------- -/
/- The "eventually" property in Euclidean space.  (topology.ml 2998-3267)    -/
/- ------------------------------------------------------------------------- -/

structure EVT where
  EVENTUALLY_WITHIN : thm
  EVENTUALLY_WITHIN_LE : thm
  EVENTUALLY_WITHIN_TOPOLOGICAL : thm
  TRIVIAL_LIMIT_WITHIN : thm
  LIM_WITHIN_CLOSED_TRIVIAL : thm
  EVENTUALLY_AT : thm
  EVENTUALLY_AT_TOPOLOGICAL : thm
  TRIVIAL_LIMIT_AT : thm
  EVENTUALLY_HAPPENS_AT : thm
  EVENTUALLY_AT_INFINITY : thm
  EVENTUALLY_AT_INFINITY_WITHIN : thm
  EVENTUALLY_AT_INFINITY_POS : thm
  TRIVIAL_LIMIT_AT_INFINITY : thm
  EVENTUALLY_AT_POSINFINITY : thm
  TRIVIAL_LIMIT_AT_POSINFINITY : thm
  EVENTUALLY_AT_NEGINFINITY : thm
  TRIVIAL_LIMIT_AT_NEGINFINITY : thm
  EVENTUALLY_AT_ZERO : thm
  EVENTUALLY_AT_WITHIN : thm
  EVENTUALLY_WITHIN_ZERO : thm
  IN_INTERIOR_EVENTUALLY : thm
  EVENTUALLY_WITHIN_INTERIOR : thm
  EVENTUALLY_IN_OPEN : thm
  EVENTUALLY_WITHIN_OPEN : thm
  EVENTUALLY_WITHIN_OPEN_IN : thm
  EVENTUALLY_WITHIN_INTERIOR_LOCAL : thm
  EVENTUALLY_SCALABLE_PROPERTY : thm
  EVENTUALLY_SCALABLE_PROPERTY_EQ : thm
  ONORM_LE_EVENTUALLY : thm
  EVENTUALLY_WITHIN_REFLECT : thm
  EVENTUALLY_AT_REFLECT : thm
  EVENTUALLY_WITHIN_DELETE : thm
  deriving Inhabited

@[nospecialize]
def setupEVT [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BLPT : LPT)
    (BINT : INT) (BNET : NET) : ExceptT String IO EVT := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_FIELD, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { CONJ_ASSOC, DIFF_EMPTY, EQ_TRANS, EXISTS_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, INTERS_GSPEC, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_INTER,
        .. } := D.core2
  let { IN_UNIV, NOT_IN_EMPTY, REAL_ABS_DIV, REAL_ABS_NUM, REAL_ABS_POS, .. } := D.core3
  let { REAL_DIV_EQ_0, REAL_DIV_RMUL, REAL_LE_DIV, REAL_LE_LMUL, REAL_LE_REFL, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, .. } := D.core4
  let { REAL_MUL_AC, SUBSET, .. } := D.core5
  let { real_ge, .. } := D.core6
  let { APPROACHABLE_LT_LE, REAL_HALF, .. } := D.misc
  let { DIST_0, DIST_NZ, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { IN_TRANSLATION_GALOIS_ALT, LINEAR_CMUL, .. } := D.vec2
  let { NORM_EQ_0, NORM_MUL, NORM_POS_LE, NORM_POS_LT, ONORM_LE_EQ, REAL_ABS_NORM,
        REFLECT_UNIV, .. } := D.vec3
  let { VECTOR_ADD_SUB, VECTOR_CHOOSE_SIZE, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, VECTOR_NEG_NEG, VECTOR_SUB_ADD2, VECTOR_SUB_RZERO, dist, .. } := D.vec4
  let { ALWAYS_EVENTUALLY, .. } := D.met1
  let { EVENTUALLY_AND, EVENTUALLY_ATPOINTOF, EVENTUALLY_ATPOINTOF_METRIC, EVENTUALLY_HAPPENS,
        EVENTUALLY_MONO, EVENTUALLY_WITHIN_IMP, HAUSDORFF_SPACE_MTOPOLOGY, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, TRIVIAL_LIMIT_ATPOINTOF_WITHIN, eventually, trivial_limit, .. } :=
    D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_IN, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { IN_BALL, .. } := BBAL
  let { OPEN_IN_OPEN, .. } := BLOC
  let { CLOSED_LIMPT, LIMIT_POINT_IN_DERIVED_SET, LIMPT_OF_UNIV, .. } := BLPT
  let { INTERIOR_OPEN, IN_INTERIOR, .. } := BINT
  let { AT_INFINITY, AT_NEGINFINITY, AT_POSINFINITY, NETLIMITS_AT_INFINITY,
        NETLIMITS_AT_NEGINFINITY, NETLIMITS_AT_POSINFINITY, WITHIN_UNIV, «at», .. } := BNET
  -- @@SCOPE END

  let EVENTUALLY_WITHIN ← prove
   r"!s a:real^M p.
     eventually p (at a within s) <=>
        ?d. &0 < d /\ !x. x IN s /\ &0 < dist(x,a) /\ dist(x,a) < d ==> p(x)"
   (REWRITE_TAC [«at», EVENTUALLY_WITHIN_IMP, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [EVENTUALLY_ATPOINTOF_METRIC] THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, IN_UNIV] THEN MESON_TAC [])

  let EVENTUALLY_WITHIN_LE ← prove
   r"!s a:real^M p.
     eventually p (at a within s) <=>
        ?d. &0 < d /\ !x. x IN s /\ &0 < dist(x,a) /\ dist(x,a) <= d ==> p(x)"
   (REWRITE_TAC [EVENTUALLY_WITHIN] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> c ==> a /\ b ==> d")] THEN
    REWRITE_TAC [APPROACHABLE_LT_LE])

  let EVENTUALLY_WITHIN_TOPOLOGICAL ← prove
   r"!P s a:real^N.
        eventually P (at a within s) <=>
        ?t. open t /\ a IN t /\
            !x. x IN s INTER (t DELETE a) ==> P x"
   (REWRITE_TAC [«at», EVENTUALLY_WITHIN_IMP, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    SIMP_TAC [EVENTUALLY_ATPOINTOF, HAUSDORFF_SPACE_MTOPOLOGY] THEN
    REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, TOPSPACE_EUCLIDEAN] THEN
    REWRITE_TAC [IN_UNIV, OPEN_IN] THEN SET_TAC [])

  let TRIVIAL_LIMIT_WITHIN ← prove
   r"!a:real^N. trivial_limit (at a within s) <=> ~(a limit_point_of s)"
   (REWRITE_TAC [«at», ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    SIMP_TAC [TRIVIAL_LIMIT_ATPOINTOF_WITHIN, HAUSDORFF_SPACE_MTOPOLOGY] THEN
    REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, LIMIT_POINT_IN_DERIVED_SET])

  let LIM_WITHIN_CLOSED_TRIVIAL ← prove
   r"!a s. closed s /\ ~(a IN s) ==> trivial_limit (at a within s)"
   (REWRITE_TAC [TRIVIAL_LIMIT_WITHIN] THEN MESON_TAC [CLOSED_LIMPT])

  let EVENTUALLY_AT ← prove
   r"!a p. eventually p (at a) <=>
         ?d. &0 < d /\ !x. &0 < dist(x,a) /\ dist(x,a) < d ==> p(x)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [EVENTUALLY_WITHIN, IN_UNIV])

  let EVENTUALLY_AT_TOPOLOGICAL ← prove
   r"!P a:real^N.
        eventually P (at a) <=>
        ?t. open t /\ a IN t /\ !x. x IN t DELETE a ==> P x"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [EVENTUALLY_WITHIN_TOPOLOGICAL, IN_INTER, IN_UNIV])

  let TRIVIAL_LIMIT_AT ← prove
   r"!a. ~(trivial_limit (at a))"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [TRIVIAL_LIMIT_WITHIN, LIMPT_OF_UNIV])

  let EVENTUALLY_HAPPENS_AT ← prove
   r"!P a:real^N. eventually P (at a) ==> ?b. ~(b = a) /\ P b"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"eventually (\b:real^N. ~(b = a) /\ P b) (at a)") MP_TAC THENL
     [POP_ASSUM MP_TAC THEN REWRITE_TAC [EVENTUALLY_AT] THEN
      MESON_TAC [DIST_NZ, DIST_SYM],
      DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
      SIMP_TAC [TRIVIAL_LIMIT_AT]])

  let EVENTUALLY_AT_INFINITY ← prove
   r"!p. eventually p at_infinity <=> ?b. !x. norm(x) >= b ==> p x"
   (REWRITE_TAC [eventually, AT_INFINITY, NETLIMITS_AT_INFINITY] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, real_ge] THEN
    REWRITE_TAC [← SET_RULE (← q r"~({f x | x IN UNIV} = {})")] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_DIFF, INTERS_GSPEC, IN_UNIV, NOT_IN_EMPTY] THEN
    MESON_TAC [VECTOR_CHOOSE_SIZE, ← NORM_ARITH
     (← q r"&0 < norm(x:real^N) + &1 /\ ~(norm x + &1 <= norm x)")])

  let EVENTUALLY_AT_INFINITY_WITHIN ← prove
   r"!p s:real^N->bool.
        eventually p (at_infinity within s) <=>
        ?b. !x. x IN s /\ norm(x) >= b ==> p x"
   (REWRITE_TAC [EVENTUALLY_WITHIN_IMP, EVENTUALLY_AT_INFINITY] THEN
    MESON_TAC [])

  let EVENTUALLY_AT_INFINITY_POS ← prove
   r"!p:real^N->bool.
        eventually p at_infinity <=> ?b. &0 < b /\ !x. norm x >= b ==> p x"
   (GEN_TAC THEN REWRITE_TAC [EVENTUALLY_AT_INFINITY, real_ge] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < abs b + &1 /\ (abs b + &1 <= x ==> b <= x)")])

  let TRIVIAL_LIMIT_AT_INFINITY ← prove
   r"~(trivial_limit at_infinity)"
   (REWRITE_TAC [trivial_limit, EVENTUALLY_AT_INFINITY, real_ge] THEN
    MESON_TAC [VECTOR_CHOOSE_SIZE, ← REAL_ARITH
      (← q r"&0 <= abs b + &1 /\ b <= abs b + &1 /\ ~(abs b + &2 <= abs b + &1)")])

  let EVENTUALLY_AT_POSINFINITY ← prove
   r"!p. eventually p at_posinfinity <=> ?b. !x. x >= b ==> p x"
   (REWRITE_TAC [eventually, AT_POSINFINITY, NETLIMITS_AT_POSINFINITY] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, real_ge] THEN
    REWRITE_TAC [← SET_RULE (← q r"~({f x | x IN UNIV} = {})")] THEN
    REWRITE_TAC [real_ge, IN_ELIM_THM, INTERS_GSPEC, DIFF_EMPTY, IN_UNIV] THEN
    MESON_TAC [← REAL_ARITH (← q r"~(x + &1 <= x)")])

  let TRIVIAL_LIMIT_AT_POSINFINITY ← prove
   r"~(trivial_limit at_posinfinity)"
   (REWRITE_TAC [EVENTUALLY_AT_POSINFINITY, trivial_limit, real_ge] THEN
    MESON_TAC [← REAL_ARITH (← q r"~(x + &1 <= x)"), REAL_LE_REFL])

  let EVENTUALLY_AT_NEGINFINITY ← prove
   r"!p. eventually p at_neginfinity <=> ?b. !x. x <= b ==> p x"
   (REWRITE_TAC [eventually, AT_NEGINFINITY, NETLIMITS_AT_NEGINFINITY] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, real_ge] THEN
    REWRITE_TAC [← SET_RULE (← q r"~({f x | x IN UNIV} = {})")] THEN
    REWRITE_TAC [real_ge, IN_ELIM_THM, INTERS_GSPEC, DIFF_EMPTY, IN_UNIV] THEN
    MESON_TAC [← REAL_ARITH (← q r"~(x <= x - &1)")])

  let TRIVIAL_LIMIT_AT_NEGINFINITY ← prove
   r"~(trivial_limit at_neginfinity)"
   (REWRITE_TAC [EVENTUALLY_AT_NEGINFINITY, trivial_limit, real_ge] THEN
    MESON_TAC [← REAL_ARITH (← q r"~(x <= x - &1)"), REAL_LE_REFL])

  let EVENTUALLY_AT_ZERO ← prove
   r"!P:real^N->bool a.
        eventually P (at a) <=> eventually (\x. P(a + x)) (at (vec 0))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EVENTUALLY_AT] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    ASM_CASES_TAC (← q r"&0 < d") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"x:real^N") THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a + x:real^N")) THEN
      REWRITE_TAC [dist, VECTOR_ADD_SUB, VECTOR_SUB_RZERO],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x - a:real^N")) THEN
      REWRITE_TAC [dist, VECTOR_SUB_RZERO, VECTOR_SUB_ADD2]])

  let EVENTUALLY_AT_WITHIN ← prove
   r"!P s a:real^N.
        eventually P (at a) ==> eventually P (at a within s)"
   (REWRITE_TAC [EVENTUALLY_AT, EVENTUALLY_WITHIN] THEN MESON_TAC [])

  let EVENTUALLY_WITHIN_ZERO ← prove
   r"!P:real^N->bool s a.
        eventually P (at a within s) <=>
        eventually (\x. P(a + x)) (at (vec 0) within IMAGE (\x. x - a) s)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [EVENTUALLY_WITHIN_IMP] THEN
    REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [EVENTUALLY_AT_ZERO] THEN
    REWRITE_TAC [IN_TRANSLATION_GALOIS_ALT] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"--a + x:real^N = x - a")])

  let IN_INTERIOR_EVENTUALLY ← prove
   r"!s a:real^N. a IN interior s <=> a IN s /\ eventually (\x. x IN s) (at a)"
   (REWRITE_TAC [IN_INTERIOR, EVENTUALLY_AT, SUBSET, IN_BALL, ← GSYM DIST_NZ] THEN
    MESON_TAC [DIST_SYM, DIST_REFL])

  let EVENTUALLY_WITHIN_INTERIOR ← prove
   r"!p s x:real^N.
        x IN interior s
        ==> (eventually p (at x within s) <=> eventually p (at x))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IN_INTERIOR_EVENTUALLY] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p /\ q ==> r) /\ (p /\ r ==> q) ==> p' /\ p ==> (q <=> r)")) THEN
    REWRITE_TAC [← GSYM EVENTUALLY_AND, EVENTUALLY_WITHIN_IMP] THEN
    CONJ_TAC THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    SIMP_TAC [])

  let EVENTUALLY_IN_OPEN ← prove
   r"!s a:real^N. open s /\ a IN s ==> eventually (\x. x IN s) (at a)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N"] IN_INTERIOR_EVENTUALLY) THEN
    ASM_SIMP_TAC [INTERIOR_OPEN])

  let EVENTUALLY_WITHIN_OPEN ← prove
   r"!f a:real^M s.
        a IN s /\ open s
        ==> (eventually P (at a within s) <=> eventually P (at a))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC EVENTUALLY_WITHIN_INTERIOR THEN
    ASM_MESON_TAC [INTERIOR_OPEN])

  let EVENTUALLY_WITHIN_OPEN_IN ← prove
   r"!P a s t:real^N->bool.
         a IN t /\ open_in (subtopology euclidean s) t
         ==> (eventually P (at a within t) <=> eventually P (at a within s))"
   (REWRITE_TAC [OPEN_IN_OPEN] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [EVENTUALLY_WITHIN_IMP] THEN ONCE_REWRITE_TAC [← SET_RULE
     (← q r"x IN s INTER t ==> P <=> x IN t ==> x IN s ==> P")] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM EVENTUALLY_WITHIN_IMP] THEN
    MATCH_MP_TAC EVENTUALLY_WITHIN_OPEN THEN ASM SET_TAC [])

  let EVENTUALLY_WITHIN_INTERIOR_LOCAL ← prove
   r"!P a s t u:real^N->bool.
        a IN u /\ u SUBSET t /\ t SUBSET s /\
        open_in (subtopology euclidean s) u
        ==> (eventually P (at a within t) <=> eventually P (at a within s))"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS (← q r"eventually P (at (a:real^N) within u)") THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(s ==> t) /\ (t ==> u) /\ (u <=> s) ==> (t <=> u) /\ (u <=> s)")) THEN
    REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [ALL_TAC, ASM_SIMP_TAC [EVENTUALLY_WITHIN_OPEN_IN]] THEN
    REWRITE_TAC [EVENTUALLY_WITHIN_IMP] THEN CONJ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN ASM SET_TAC [])

  let EVENTUALLY_SCALABLE_PROPERTY ← prove
   r"!P. (!c x:real^N. &0 <= c /\ P x ==> P(c % x)) /\
       eventually P (at (vec 0))
       ==> !x. P x"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EVENTUALLY_AT]) THEN
    REWRITE_TAC [EVENTUALLY_AT, DIST_0, NORM_POS_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"x:real^N = vec 0") THENL
     [SUBGOAL_THEN (← q r"?y:real^N. norm(y) = d / &2") STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC VECTOR_CHOOSE_SIZE THEN ASM_REAL_ARITH_TAC,
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N"))] THEN
      ASM_REWRITE_TAC [← GSYM NORM_EQ_0] THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, DISCH_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"&0", ← q r"y:real^N"]) THEN
      ASM_REWRITE_TAC [VECTOR_MUL_LZERO, REAL_LE_REFL],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d / &2 / norm(x) % x:real^N")) THEN
      ASM_SIMP_TAC [VECTOR_MUL_EQ_0, NORM_MUL, REAL_DIV_EQ_0] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_SIMP_TAC [NORM_EQ_0, REAL_LT_IMP_NZ, REAL_ABS_DIV, REAL_ABS_NUM] THEN
      ASM_SIMP_TAC [REAL_ABS_NORM, REAL_DIV_RMUL, NORM_EQ_0] THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, DISCH_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"norm(x:real^N) / (d / &2)", ← q r"d / &2 / norm(x) % x:real^N"]) THEN
      ASM_SIMP_TAC [REAL_LE_DIV, NORM_POS_LE, REAL_HALF, REAL_LT_IMP_LE] THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, NORM_EQ_0, ← REAL_FIELD
       (← q r"~(n = &0) /\ &0 < d ==> n / (d / &2) * d / &2 / n = &1")] THEN
      REWRITE_TAC [VECTOR_MUL_LID]])

  let EVENTUALLY_SCALABLE_PROPERTY_EQ ← prove
   r"!P. (!c x:real^N. &0 <= c /\ P x ==> P(c % x))
       ==> (eventually P (at (vec 0)) <=> !x. P x)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [ALWAYS_EVENTUALLY] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_SCALABLE_PROPERTY) THEN
    ASM_SIMP_TAC [])

  let ONORM_LE_EVENTUALLY ← prove
   r"!f:real^M->real^N b.
        linear f
        ==> (onorm f <= b <=>
             eventually (\y. norm(f y) <= b * norm y) (at (vec 0)))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [ONORM_LE_EQ] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC EVENTUALLY_SCALABLE_PROPERTY_EQ THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP LINEAR_CMUL th])) THEN
    REWRITE_TAC [NORM_MUL] THEN
    MESON_TAC [REAL_LE_LMUL, REAL_ABS_POS, REAL_MUL_AC])

  let EVENTUALLY_WITHIN_REFLECT ← prove
   r"!P s a:real^N.
        eventually (\x. P(--x)) (at(--a) within IMAGE (--) s) <=>
        eventually P (at a within s)"
   (REWRITE_TAC [EVENTUALLY_WITHIN, IMP_CONJ, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ← NORM_ARITH (← q r"dist(--a:real^N,--b) = dist(a,b)")])

  let EVENTUALLY_AT_REFLECT ← prove
   r"!P a:real^N.
        eventually (\x. P(--x)) (at(--a)) <=> eventually P (at a)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM EVENTUALLY_WITHIN_REFLECT] THEN
    REWRITE_TAC [REFLECT_UNIV])

  let EVENTUALLY_WITHIN_DELETE ← prove
   r"!P:real^N->bool s a.
        eventually P (at a within (s DELETE a)) <=>
        eventually P (at a within s)"
   (REWRITE_TAC [EVENTUALLY_WITHIN, ← GSYM DIST_NZ, IN_DELETE] THEN MESON_TAC [])

  return { EVENTUALLY_WITHIN, EVENTUALLY_WITHIN_LE, EVENTUALLY_WITHIN_TOPOLOGICAL,
           TRIVIAL_LIMIT_WITHIN, LIM_WITHIN_CLOSED_TRIVIAL, EVENTUALLY_AT,
           EVENTUALLY_AT_TOPOLOGICAL, TRIVIAL_LIMIT_AT, EVENTUALLY_HAPPENS_AT,
           EVENTUALLY_AT_INFINITY, EVENTUALLY_AT_INFINITY_WITHIN, EVENTUALLY_AT_INFINITY_POS,
           TRIVIAL_LIMIT_AT_INFINITY, EVENTUALLY_AT_POSINFINITY, TRIVIAL_LIMIT_AT_POSINFINITY,
           EVENTUALLY_AT_NEGINFINITY, TRIVIAL_LIMIT_AT_NEGINFINITY, EVENTUALLY_AT_ZERO,
           EVENTUALLY_AT_WITHIN, EVENTUALLY_WITHIN_ZERO, IN_INTERIOR_EVENTUALLY,
           EVENTUALLY_WITHIN_INTERIOR, EVENTUALLY_IN_OPEN, EVENTUALLY_WITHIN_OPEN,
           EVENTUALLY_WITHIN_OPEN_IN, EVENTUALLY_WITHIN_INTERIOR_LOCAL,
           EVENTUALLY_SCALABLE_PROPERTY, EVENTUALLY_SCALABLE_PROPERTY_EQ, ONORM_LE_EVENTUALLY,
           EVENTUALLY_WITHIN_REFLECT, EVENTUALLY_AT_REFLECT, EVENTUALLY_WITHIN_DELETE }

/- ------------------------------------------------------------------------- -/
/- Limits, defined as vacuously true when the limit is trivial.              -/
/- (topology.ml 3268-3377)                                                   -/
/- ------------------------------------------------------------------------- -/

structure LIM1 where
  tendsto : thm
  LIMIT_EUCLIDEAN : thm
  lim : thm
  TENDSTO_ALT : thm
  TENDSTO_ALT_WITHIN : thm
  LIM_EVENTUALLY_IN_OPEN_IN : thm
  LIM_EVENTUALLY_IN_OPEN : thm
  LIM_TRIVIAL : thm
  LIM_WITHIN_REFLECT : thm
  LIM_AT_REFLECT : thm
  LIM_WITHIN_ZERO : thm
  LIM_WITHIN_DELETE : thm
  LIM_COMPONENTWISE_REAL : thm
  LIM_COMPONENTWISE_LIFT : thm
  LIM_EQ_DROP : thm
  LIM_EQ_LIFT : thm
  deriving Inhabited

@[nospecialize]
def setupLIM1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCWL : CWL) (BLOC : LOC) (BEVT : EVT) :
    ExceptT String IO LIM1 := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ASM_MESON_TAC, MESON_TAC, .. } := D
  let { ETA_AX, .. } := D.core1
  let { FORALL_UNWIND_THM2, IMP_CONJ, IMP_IMP, IN_INTER, .. } := D.core2
  let { IN_UNIV, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MONO_FORALL, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.core5
  let { SWAP_FORALL_THM, o_DEF, .. } := D.core6
  let { LIFT_DROP, .. } := D.vec2
  let { EVENTUALLY_AND, LIMIT_METRIC, LIMIT_TRIVIAL, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, limit, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_IN_EUCLIDEAN, TOPSPACE_EUCLIDEAN, .. } :=
    BEUC
  let { LIMIT_COMPONENTWISE_REAL, LIMIT_EQ_DROP, LIMIT_EQ_LIFT, .. } := BCWL
  let { OPEN_IN_OPEN, .. } := BLOC
  let { EVENTUALLY_AT_REFLECT, EVENTUALLY_WITHIN_DELETE, EVENTUALLY_WITHIN_REFLECT,
        EVENTUALLY_WITHIN_ZERO, .. } := BEVT
  -- @@SCOPE END

  parse_as_infix ("-->", (12, "right"))

  let tendsto ← new_definition
   r"(f --> l) net <=> !e. &0 < e ==> eventually (\x. dist(f(x),l) < e) net"

  let LIMIT_EUCLIDEAN ← prove
   r"!f:A->real^N x net. limit euclidean f x net <=> (f --> x) net"
   (REWRITE_TAC [LIMIT_METRIC, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, IN_UNIV, tendsto])

  let lim ← new_definition
   r"lim net f = @l. (f --> l) net"

  let TENDSTO_ALT ← prove
   r"!f:A->real^N l net.
     (f --> l) net <=>
     (!s. open s /\ l IN s ==> eventually (\x. f x IN s) net)"
   (REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, limit, TOPSPACE_EUCLIDEAN, IN_UNIV] THEN
    REWRITE_TAC [OPEN_IN_EUCLIDEAN])

  let TENDSTO_ALT_WITHIN ← prove
   r"!net f:A->real^N l u.
        l IN u /\ eventually (\x. f x IN u) net
        ==> ((f --> l) net <=>
             !s. open_in (subtopology euclidean u) s /\ l IN s
                 ==> eventually (\x. f x IN s) net)"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [OPEN_IN_OPEN, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    SIMP_TAC [IMP_CONJ, IN_INTER, EVENTUALLY_AND] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM TENDSTO_ALT])

  let LIM_EVENTUALLY_IN_OPEN_IN ← prove
   r"!net f:A->real^N l u s.
        l IN s /\ open_in (subtopology euclidean u) s /\
        eventually (\x. f x IN u) net /\ (f --> l) net
        ==> eventually (\x. f x IN s) net"
   (MP_TAC TENDSTO_ALT_WITHIN THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"s:real^N->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_imp o concl)) THEN
    ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, SUBSET], ALL_TAC] THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [])

  let LIM_EVENTUALLY_IN_OPEN ← prove
   r"!net f:A->real^N l s.
        open s /\ (f --> l) net /\ l IN s ==> eventually (\x. f x IN s) net"
   (REWRITE_TAC [TENDSTO_ALT] THEN MESON_TAC [])

  let LIM_TRIVIAL ← prove
   r"!net (f:A->real^N) l. trivial_limit net ==> (f --> l) net"
   (SIMP_TAC [← GSYM LIMIT_EUCLIDEAN, LIMIT_TRIVIAL, TOPSPACE_EUCLIDEAN, IN_UNIV])

  let LIM_WITHIN_REFLECT ← prove
   r"!f:real^M->real^N l a s.
        ((\x. f(--x)) --> l) (at(--a) within IMAGE (--) s) <=>
        (f --> l) (at a within s)"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHIN_REFLECT])

  let LIM_AT_REFLECT ← prove
   r"!f:real^M->real^N l a.
        ((\x. f(--x)) --> l) (at(--a)) <=> (f --> l) (at a)"
   (REWRITE_TAC [tendsto, EVENTUALLY_AT_REFLECT])

  let LIM_WITHIN_ZERO ← prove
   r"!f:real^M->real^N l s a.
        (f --> l) (at a within s) <=>
        ((\x. f(a + x)) --> l) (at(vec 0) within IMAGE (\x. x - a) s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [EVENTUALLY_WITHIN_ZERO] THEN
    REWRITE_TAC [])

  let LIM_WITHIN_DELETE ← prove
   r"!f:real^M->real^N l s a.
        (f --> l) (at a within (s DELETE a)) <=>
        (f --> l) (at a within s)"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHIN_DELETE])

  let LIM_COMPONENTWISE_REAL ← prove
   r"!net f:A->real^N l.
        (f --> l) net <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> limit euclideanreal (\x. f x$i) (l$i) net"
   (REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, LIMIT_COMPONENTWISE_REAL])

  let LIM_COMPONENTWISE_LIFT ← prove
   r"!net f:A->real^N.
        (f --> l) net <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> ((\x. lift((f x)$i)) --> lift(l$i)) net"
   (REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, LIMIT_EQ_DROP, o_DEF, LIFT_DROP] THEN
    REWRITE_TAC [LIMIT_EUCLIDEAN, ← GSYM LIM_COMPONENTWISE_REAL])

  let LIM_EQ_DROP ← prove
   r"!(net:A net) f l:real^1.
        (f --> l) net <=> limit euclideanreal (drop o f) (drop l) net"
   (REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, LIMIT_EQ_LIFT, o_DEF, LIFT_DROP, ETA_AX])

  let LIM_EQ_LIFT ← prove
   r"!(net:A net) f l.
        limit euclideanreal f l net <=> ((lift o f) --> lift l) net"
   (REWRITE_TAC [LIM_EQ_DROP, o_DEF, LIFT_DROP, ETA_AX])

  return { tendsto, LIMIT_EUCLIDEAN, lim, TENDSTO_ALT, TENDSTO_ALT_WITHIN,
           LIM_EVENTUALLY_IN_OPEN_IN, LIM_EVENTUALLY_IN_OPEN, LIM_TRIVIAL, LIM_WITHIN_REFLECT,
           LIM_AT_REFLECT, LIM_WITHIN_ZERO, LIM_WITHIN_DELETE, LIM_COMPONENTWISE_REAL,
           LIM_COMPONENTWISE_LIFT, LIM_EQ_DROP, LIM_EQ_LIFT }

/- ------------------------------------------------------------------------- -/
/- Usual definitions of limits; monotonicity; composition of limits.        -/
/- (topology.ml 3378-3597)                                                   -/
/- ------------------------------------------------------------------------- -/

structure LIM2 where
  LIM_WITHIN_LE : thm
  LIM_WITHIN : thm
  LIM_AT_LE : thm
  LIM_AT : thm
  LIM_AT_INFINITY : thm
  LIM_AT_INFINITY_POS : thm
  LIM_AT_POSINFINITY : thm
  LIM_AT_NEGINFINITY : thm
  LIM_AT_INFINITY_WITHIN : thm
  LIM_AT_INFINITY_WITHIN_POS : thm
  LIM_SEQUENTIALLY : thm
  LIM_EVENTUALLY : thm
  LIM_POSINFINITY_SEQUENTIALLY : thm
  LIM_INFINITY_POSINFINITY_LIFT : thm
  LIM_SELF_WITHIN : thm
  LIM_SELF_AT : thm
  LIM_SUBSEQUENCE : thm
  SEQUENTIAL_LIMIT_URYSOHN : thm
  LIM_WITHIN_EMPTY : thm
  LIM_WITHIN_SUBSET : thm
  LIM_UNION : thm
  LIM_UNION_UNIV : thm
  LIM_COMPOSE_WITHIN : thm
  LIM_COMPOSE_AT : thm
  deriving Inhabited

@[nospecialize]
def setupLIM2 [HolBase] (D : TopologyDeps) (BNET : NET) (BEVT : EVT) (BLIM1 : LIM1) :
    ExceptT String IO LIM2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_TAC, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INFINITE_ENUMERATE, IN_ELIM_THM, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_AND_FORALL_THM, LE_REFL, LE_TRANS, MONO_EXISTS, MONO_FORALL,
        NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_ARCH_SIMPLE, REAL_LT_01, REAL_LT_MIN, .. } := D.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_LE, SUBSET, .. } := D.core5
  let { num_INFINITE_EQ, o_DEF, o_THM, .. } := D.core6
  let { MONOTONE_BIGGER, .. } := D.misc
  let { DIST_NZ, DIST_REFL, FORALL_DROP, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { NORM_REAL, .. } := D.vec3
  let { drop, .. } := D.vec4
  let { EVENTUALLY_AND, EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { WITHIN_UNIV, .. } := BNET
  let { EVENTUALLY_AT, EVENTUALLY_AT_INFINITY, EVENTUALLY_AT_INFINITY_WITHIN,
        EVENTUALLY_AT_NEGINFINITY, EVENTUALLY_AT_POSINFINITY, EVENTUALLY_WITHIN,
        EVENTUALLY_WITHIN_LE, .. } := BEVT
  let { tendsto, .. } := BLIM1
  -- @@SCOPE END

  let LIM_WITHIN_LE ← prove
   r"!f:real^M->real^N l a s.
        (f --> l)(at a within s) <=>
           !e. &0 < e ==> ?d. &0 < d /\
                              !x. x IN s /\ &0 < dist(x,a) /\ dist(x,a) <= d
                                   ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHIN_LE])

  let LIM_WITHIN ← prove
   r"!f:real^M->real^N l a s.
      (f --> l) (at a within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x. x IN s /\ &0 < dist(x,a) /\ dist(x,a) < d
                    ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHIN] THEN MESON_TAC [])

  let LIM_AT_LE ← prove
   r"!f l a. (f --> l) (at a) <=>
           !e. &0 < e
               ==> ?d. &0 < d /\
                       !x. &0 < dist(x,a) /\ dist(x,a) <= d
                           ==> dist (f x,l) < e"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [LIM_WITHIN_LE, IN_UNIV])

  let LIM_AT ← prove
   r"!f l:real^N a:real^M.
      (f --> l) (at a) <=>
              !e. &0 < e
                  ==> ?d. &0 < d /\ !x. &0 < dist(x,a) /\ dist(x,a) < d
                          ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_AT] THEN MESON_TAC [])

  let LIM_AT_INFINITY ← prove
   r"!f l. (f --> l) at_infinity <=>
               !e. &0 < e ==> ?b. !x. norm(x) >= b ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_AT_INFINITY] THEN MESON_TAC [])

  let LIM_AT_INFINITY_POS ← prove
   r"!f l. (f --> l) at_infinity <=>
         !e. &0 < e ==> ?b. &0 < b /\ !x. norm x >= b ==> dist(f x,l) < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIM_AT_INFINITY] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < abs b + &1 /\ (x >= abs b + &1 ==> x >= b)")])

  let LIM_AT_POSINFINITY ← prove
   r"!f l. (f --> l) at_posinfinity <=>
               !e. &0 < e ==> ?b. !x. x >= b ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_AT_POSINFINITY] THEN MESON_TAC [])

  let LIM_AT_NEGINFINITY ← prove
   r"!f l. (f --> l) at_neginfinity <=>
               !e. &0 < e ==> ?b. !x. x <= b ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_AT_NEGINFINITY] THEN MESON_TAC [])

  let LIM_AT_INFINITY_WITHIN ← prove
   r"!f:real^M->real^N l s.
        (f --> l) (at_infinity within s) <=>
        !e. &0 < e ==> ?b. !x. x IN s /\ norm(x) >= b ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_AT_INFINITY_WITHIN] THEN MESON_TAC [])

  let LIM_AT_INFINITY_WITHIN_POS ← prove
   r"!f:real^M->real^N l s.
        (f --> l) (at_infinity within s) <=>
        !e. &0 < e
            ==> ?b. &0 < b /\ !x. x IN s /\ norm(x) >= b ==> dist(f(x),l) < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIM_AT_INFINITY_WITHIN] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < abs b + &1 /\ (x >= abs b + &1 ==> x >= b)")])

  let LIM_SEQUENTIALLY ← prove
   r"!s l. (s --> l) sequentially <=>
          !e. &0 < e ==> ?N. !n. N <= n ==> dist(s(n),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_SEQUENTIALLY] THEN MESON_TAC [])

  let LIM_EVENTUALLY ← prove
   r"!net f l. eventually (\x. f x = l) net ==> (f --> l) net"
   (SIMP_TAC [tendsto] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MONO)) THEN
    ASM_SIMP_TAC [DIST_REFL])

  let LIM_POSINFINITY_SEQUENTIALLY ← prove
   r"!f l. (f --> l) at_posinfinity ==> ((\n. f(&n)) --> l) sequentially"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [LIM_AT_POSINFINITY, LIM_SEQUENTIALLY] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN
    MP_TAC (← ISPEC (← q r"B:real") REAL_ARCH_SIMPLE) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN ASM_REAL_ARITH_TAC)

  let LIM_INFINITY_POSINFINITY_LIFT ← prove
   r"!f l:real^N. (f --> l) at_infinity ==> ((f o lift) --> l) at_posinfinity"
   (REWRITE_TAC [LIM_AT_INFINITY, LIM_AT_POSINFINITY, o_THM] THEN
    REWRITE_TAC [FORALL_DROP, NORM_REAL, ← GSYM drop, LIFT_DROP] THEN
    MESON_TAC [← REAL_ARITH (← q r"x >= b ==> abs(x) >= b")])

  let LIM_SELF_WITHIN ← prove
   r"!f:real^M->real^N s a.
        (f --> f a) (at a within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                     !x. x IN s /\ dist(x,a) < d ==> dist(f x,f a) < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIM_WITHIN, ← GSYM DIST_NZ] THEN
    AP_TERM_TAC THEN ABS_TAC THEN MESON_TAC [DIST_REFL])

  let LIM_SELF_AT ← prove
   r"!f:real^M->real^N a.
        (f --> f a) (at a) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                     !x. dist(x,a) < d ==> dist(f x,f a) < e"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [LIM_SELF_WITHIN, IN_UNIV])

  let LIM_SUBSEQUENCE ← prove
   r"!s r l. (!m n. m < n ==> r(m) < r(n)) /\ (s --> l) sequentially
           ==> (s o r --> l) sequentially"
   (REWRITE_TAC [LIM_SEQUENTIALLY, o_THM] THEN
    MESON_TAC [MONOTONE_BIGGER, LE_TRANS])

  let SEQUENTIAL_LIMIT_URYSOHN ← prove
   r"!s l:real^N.
        (s --> l) sequentially <=>
        !r. (!m n. m < n ==> r m < r n)
            ==> ?q:num->num.
                    (!m n. m < n ==> q m < q n) /\
                    ((s o r o q) --> l) sequentially"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [EXISTS_TAC (← q r"\n:num. n") THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC LIM_SUBSEQUENCE THEN
      ASM_REWRITE_TAC [o_THM],
      REWRITE_TAC [LIM_SEQUENTIALLY] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"{n |  e <= dist((s:num->real^N) n,l)}") num_INFINITE_EQ) THEN
      REWRITE_TAC [IN_ELIM_THM, ← GSYM REAL_NOT_LE] THEN
      REWRITE_TAC [← TAUT (← q r"p ==> ~q <=> ~(p /\ q)"), ← GSYM NOT_EXISTS_THM] THEN
      REWRITE_TAC [← GSYM NOT_FORALL_THM] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      DISCH_THEN (MP_TAC o MATCH_MP INFINITE_ENUMERATE) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r:num->num")) THEN
      ASM_REWRITE_TAC [LIM_SEQUENTIALLY, o_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:num->num") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, REAL_NOT_LT] THEN
      X_GEN_TAC (← q r"n:num") THEN EXISTS_TAC (← q r"n:num") THEN REWRITE_TAC [LE_REFL] THEN
      ASM SET_TAC []])

  let LIM_WITHIN_EMPTY ← prove
   r"!f l x. (f --> l) (at x within {})"
   (REWRITE_TAC [LIM_WITHIN, NOT_IN_EMPTY] THEN MESON_TAC [REAL_LT_01])

  let LIM_WITHIN_SUBSET ← prove
   r"!f l a s.
    (f --> l) (at a within s) /\ t SUBSET s ==> (f --> l) (at a within t)"
   (REWRITE_TAC [LIM_WITHIN, SUBSET] THEN MESON_TAC [])

  let LIM_UNION ← prove
   r"!f x l s t.
        (f --> l) (at x within s) /\ (f --> l) (at x within t)
        ==> (f --> l) (at x within (s UNION t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIM_WITHIN, IN_UNION] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
    X_GEN_TAC (← q r"e:real") THEN ASM_CASES_TAC (← q r"&0 < e") THEN ASM_SIMP_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_TAC (← q r"d1:real")) (X_CHOOSE_TAC (← q r"d2:real"))) THEN
    EXISTS_TAC (← q r"min d1 d2") THEN ASM_MESON_TAC [REAL_LT_MIN])

  let LIM_UNION_UNIV ← prove
   r"!f x l s t.
        (f --> l) (at x within s) /\ (f --> l) (at x within t) /\
        s UNION t = (:real^N)
        ==> (f --> l) (at x)"
   (MESON_TAC [LIM_UNION, WITHIN_UNIV])

  let LIM_COMPOSE_WITHIN ← prove
   r"!net f:A->real^N g:real^N->real^P s y z.
    (f --> y) net /\
    eventually (\w. f w IN s /\ (f w = y ==> g y = z)) net /\
    (g --> z) (at y within s)
    ==> ((g o f) --> z) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto, CONJ_ASSOC] THEN
    ONCE_REWRITE_TAC [LEFT_AND_FORALL_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [EVENTUALLY_WITHIN, ← GSYM DIST_NZ, o_DEF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d:real")) THEN
    ASM_REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    ASM_MESON_TAC [DIST_REFL])

  let LIM_COMPOSE_AT ← prove
   r"!net f:A->real^N g:real^N->real^P y z.
    (f --> y) net /\
    eventually (\w. f w = y ==> g y = z) net /\
    (g --> z) (at y)
    ==> ((g o f) --> z) net"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"net:(A)net", ← q r"f:A->real^N", ← q r"g:real^N->real^P",
                     ← q r"(:real^N)", ← q r"y:real^N", ← q r"z:real^P"]
          LIM_COMPOSE_WITHIN) THEN
    ASM_REWRITE_TAC [IN_UNIV, WITHIN_UNIV])

  return { LIM_WITHIN_LE, LIM_WITHIN, LIM_AT_LE, LIM_AT, LIM_AT_INFINITY, LIM_AT_INFINITY_POS,
           LIM_AT_POSINFINITY, LIM_AT_NEGINFINITY, LIM_AT_INFINITY_WITHIN,
           LIM_AT_INFINITY_WITHIN_POS, LIM_SEQUENTIALLY, LIM_EVENTUALLY,
           LIM_POSINFINITY_SEQUENTIALLY, LIM_INFINITY_POSINFINITY_LIFT, LIM_SELF_WITHIN,
           LIM_SELF_AT, LIM_SUBSEQUENCE, SEQUENTIAL_LIMIT_URYSOHN, LIM_WITHIN_EMPTY,
           LIM_WITHIN_SUBSET, LIM_UNION, LIM_UNION_UNIV, LIM_COMPOSE_WITHIN, LIM_COMPOSE_AT }

/- ------------------------------------------------------------------------- -/
/- Restricted vs unrestricted limits; more limit point characterizations;   -/
/- condensation points.  (topology.ml 3598-3772)                             -/
/- ------------------------------------------------------------------------- -/

structure RLM where
  LIM_AT_WITHIN : thm
  LIM_WITHIN_OPEN : thm
  LIM_WITHIN_OPEN_IN : thm
  LIMPT_SEQUENTIAL : thm
  LIMPT_SEQUENTIAL_INJ : thm
  LIMPT_SEQUENTIAL_DECREASING : thm
  LIMPT_INFINITE_OPEN : thm
  LIMPT_INFINITE_BALL : thm
  LIMPT_INFINITE_CBALL : thm
  INFINITE_OPEN_IN : thm
  condensation_point_of : thm
  CONDENSATION_POINT_OF_SUBSET : thm
  CONDENSATION_POINT_IMP_LIMPT : thm
  CONDENSATION_POINT_INFINITE_BALL : thm
  CONDENSATION_POINT_INFINITE_CBALL : thm
  CONDENSATION_POINT_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupRLM [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BLPT : LPT)
    (BEVT : EVT) (BLIM1 : LIM1) (BLIM2 : LIM2) : ExceptT String IO RLM := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, CONTRAPOS_THM, DEPENDENT_CHOICE, FINITE_EMPTY, .. } := D.core1
  let { FUN_EQ_THM, IMP_CONJ_ALT, INFINITE, INTER_SUBSET, IN_DELETE, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LE_REFL, MONO_EXISTS, MONO_FORALL, MONO_IMP, .. } := D.core3
  let { REAL_LE_INV2, REAL_LTE_TRANS, REAL_LT_01, REAL_LT_INV_EQ, REAL_LT_MIN, REAL_LT_REFL,
        .. } := D.core4
  let { REAL_LT_TRANS, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, RIGHT_IMP_FORALL_THM,
        .. } := D.core5
  let { SWAP_FORALL_THM, TRANSITIVE_STEPWISE_LT, WLOG_LT, .. } := D.core6
  let { CARD_DIFF_ABSORB, CARD_INFINITE_CONG, CARD_LET_TRANS, CARD_LE_SUBSET, CARD_LE_TRANS,
        CARD_NOT_LE, COUNTABLE_ALT, COUNTABLE_SUBSET, FINITE_IMP_COUNTABLE, .. } := D.lib1
  let { FORALL_POS_MONO_1, .. } := D.misc
  let { DIST_NZ, .. } := D.vec1
  let { DERIVED_SET_OF_INFINITE_MBALL, DERIVED_SET_OF_INFINITE_MCBALL,
        DERIVED_SET_OF_INFINITE_OPEN_IN_METRIC, .. } := D.met2
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_IN, .. } := BEUC
  let { BALL_SUBSET_CBALL, CENTRE_IN_BALL, MBALL_EUCLIDEAN, MCBALL_EUCLIDEAN, OPEN_BALL,
        OPEN_CONTAINS_CBALL, .. } := BBAL
  let { OPEN_IN_OPEN, .. } := BLOC
  let { LIMIT_POINT_IN_DERIVED_SET, LIMPT_APPROACHABLE, .. } := BLPT
  let { EVENTUALLY_WITHIN_OPEN, EVENTUALLY_WITHIN_OPEN_IN, .. } := BEVT
  let { tendsto, .. } := BLIM1
  let { LIM_AT, LIM_SEQUENTIALLY, LIM_WITHIN, .. } := BLIM2
  -- @@SCOPE END

  let LIM_AT_WITHIN ← prove
   r"!f l a s. (f --> l)(at a) ==> (f --> l)(at a within s)"
   (REWRITE_TAC [LIM_AT, LIM_WITHIN] THEN MESON_TAC [])

  let LIM_WITHIN_OPEN ← prove
   r"!f l a:real^M s.
     a IN s /\ open s ==> ((f --> l) (at a within s) <=> (f --> l) (at a))"
   (SIMP_TAC [tendsto, EVENTUALLY_WITHIN_OPEN])

  let LIM_WITHIN_OPEN_IN ← prove
   r"!f:real^M->real^N l a s t.

        a IN t /\ open_in (subtopology euclidean s) t
        ==> ((f --> l) (at a within t) <=> (f --> l) (at a within s))"
   (REWRITE_TAC [tendsto] THEN MESON_TAC [EVENTUALLY_WITHIN_OPEN_IN])

  let (LIMPT_SEQUENTIAL, LIMPT_SEQUENTIAL_INJ, LIMPT_SEQUENTIAL_DECREASING) ←
    match CONJUNCTS (← prove
     r"(!x:real^N s.
          x limit_point_of s <=>
          ?f. (!n. f(n) IN (s DELETE x)) /\ (f --> x) sequentially) /\
      (!x:real^N s.
          x limit_point_of s <=>
          ?f. (!n. f(n) IN (s DELETE x)) /\
              (!m n. f m = f n <=> m = n) /\
              (f --> x) sequentially) /\
      (!x:real^N s.
          x limit_point_of s <=>
          ?f. (!n. f(n) IN (s DELETE x)) /\
              (!m n. m < n ==> dist(f n,x) < dist(f m,x)) /\
              (f --> x) sequentially)"
     (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(s ==> r) /\ (r ==> q) /\ (q ==> p) /\ (p ==> s)
        ==> (p <=> q) /\ (p <=> r) /\ (p <=> s)")) THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:num->real^N") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC WLOG_LT THEN ASM_MESON_TAC [REAL_LT_REFL],
        MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [],
        REWRITE_TAC [LIMPT_APPROACHABLE, LIM_SEQUENTIALLY, IN_DELETE] THEN
        MESON_TAC [LE_REFL],
        REWRITE_TAC [LIMPT_APPROACHABLE] THEN DISCH_TAC THEN
        SUBGOAL_THEN
         (← q r"?f:num->real^N.
            (!n. (f n) IN s /\ ~(f n = x) /\ dist(f n,x) < inv(&n + &1)) /\
           (!n. dist(f(SUC n),x) < dist(f n,x))")
        MP_TAC THENL
         [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
          CONJ_TAC THENL [ASM_MESON_TAC [REAL_LT_01], ALL_TAC] THEN
          MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"z:real^N"] THEN
          STRIP_TAC THEN REWRITE_TAC [← GSYM CONJ_ASSOC, ← GSYM REAL_LT_MIN] THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [REAL_LT_MIN, REAL_LT_INV_EQ, ← GSYM DIST_NZ] THEN
          REAL_ARITH_TAC,
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:num->real^N") THEN
          STRIP_TAC THEN ASM_REWRITE_TAC [IN_DELETE] THEN CONJ_TAC THENL
           [MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN
            ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
            REWRITE_TAC [LIM_SEQUENTIALLY] THEN MATCH_MP_TAC FORALL_POS_MONO_1 THEN
            CONJ_TAC THENL [MESON_TAC [REAL_LT_TRANS], ALL_TAC] THEN
            X_GEN_TAC (← q r"N:num") THEN EXISTS_TAC (← q r"N:num") THEN
            X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
            TRANS_TAC REAL_LTE_TRANS (← q r"inv(&n + &1)") THEN
            ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
            REWRITE_TAC [REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_ADD] THEN
            ASM_ARITH_TAC]]])) with
    | [a, b, c] => pure (a, b, c)
    | _ => throw "LIMPT_SEQUENTIAL: match failure"

  let (LIMPT_INFINITE_OPEN, LIMPT_INFINITE_BALL, LIMPT_INFINITE_CBALL) ←
    match CONJUNCTS (← prove
     r"(!s x:real^N.
          x limit_point_of s <=> !t. x IN t /\ open t ==> INFINITE(s INTER t)) /\
     (!s x:real^N.
          x limit_point_of s <=> !e. &0 < e ==> INFINITE(s INTER ball(x,e))) /\
     (!s x:real^N.
          x limit_point_of s <=> !e. &0 < e ==> INFINITE(s INTER cball(x,e)))"
     (REWRITE_TAC [LIMIT_POINT_IN_DERIVED_SET, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
      REPEAT STRIP_TAC THENL
       [REWRITE_TAC [DERIVED_SET_OF_INFINITE_OPEN_IN_METRIC],
        REWRITE_TAC [DERIVED_SET_OF_INFINITE_MBALL],
        REWRITE_TAC [DERIVED_SET_OF_INFINITE_MCBALL]] THEN
      REWRITE_TAC [IN_ELIM_THM, EUCLIDEAN_METRIC, IN_UNIV] THEN
      REWRITE_TAC [MBALL_EUCLIDEAN, MCBALL_EUCLIDEAN] THEN
      REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, ← GSYM OPEN_IN, IN_UNIV])) with
    | [a, b, c] => pure (a, b, c)
    | _ => throw "LIMPT_INFINITE_OPEN: match failure"

  let INFINITE_OPEN_IN ← prove
   r"!u s:real^N->bool.
      open_in (subtopology euclidean u) s /\ (?x. x IN s /\ x limit_point_of u)
      ==> INFINITE s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^N->bool") o
          GEN_REWRITE_RULE id [LIMPT_INFINITE_OPEN]) THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN ASM SET_TAC [])

  parse_as_infix ("condensation_point_of", (12, "right"))

  let condensation_point_of ← new_definition
   r"x condensation_point_of s <=>
        !t. x IN t /\ open t ==> ~COUNTABLE(s INTER t)"

  let CONDENSATION_POINT_OF_SUBSET ← prove
   r"!x:real^N s t.
        x condensation_point_of s /\ s SUBSET t ==> x condensation_point_of t"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [condensation_point_of] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [CONTRAPOS_THM] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
    ASM SET_TAC [])

  let CONDENSATION_POINT_IMP_LIMPT ← prove
   r"!x s. x condensation_point_of s ==> x limit_point_of s"
   (REWRITE_TAC [condensation_point_of, LIMPT_INFINITE_OPEN, INFINITE] THEN
    MESON_TAC [FINITE_IMP_COUNTABLE])

  let (CONDENSATION_POINT_INFINITE_BALL, CONDENSATION_POINT_INFINITE_CBALL) ←
    CONJ_PAIR (← prove
     r"(!s x:real^N.
          x condensation_point_of s <=>
          !e. &0 < e ==> ~COUNTABLE(s INTER ball(x,e))) /\
     (!s x:real^N.
          x condensation_point_of s <=>
          !e. &0 < e ==> ~COUNTABLE(s INTER cball(x,e)))"
     (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN MATCH_MP_TAC (← TAUT
       (← q r"(p ==> q) /\ (q ==> r) /\ (r ==> p)
        ==> (p <=> q) /\ (p <=> r)")) THEN
      REWRITE_TAC [condensation_point_of] THEN REPEAT CONJ_TAC THENL
       [MESON_TAC [OPEN_BALL, CENTRE_IN_BALL],
        MESON_TAC [BALL_SUBSET_CBALL, COUNTABLE_SUBSET,
                   ← SET_RULE (← q r"t SUBSET u ==> s INTER t SUBSET s INTER u")],
        MESON_TAC [COUNTABLE_SUBSET, OPEN_CONTAINS_CBALL,
                   ← SET_RULE (← q r"t SUBSET u ==> s INTER t SUBSET s INTER u")]]))

  let CONDENSATION_POINT_ALT ← prove
   r"!x:real^N s.
        x condensation_point_of s <=>
        !t. COUNTABLE t ==> x limit_point_of (s DIFF t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [condensation_point_of] THEN
    REWRITE_TAC [LIMPT_INFINITE_OPEN, RIGHT_IMP_FORALL_THM] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN u /\ open u") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN REPEAT STRIP_TAC THENL
     [REWRITE_TAC [← SET_RULE
       (← q r"(s DIFF t) INTER u = (s INTER u) DIFF (t INTER u)")] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) CARD_DIFF_ABSORB o rand o snd) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [ASM_MESON_TAC [INFINITE, FINITE_IMP_COUNTABLE], ALL_TAC] THEN
        TRANS_TAC CARD_LET_TRANS (← q r"(:num)") THEN CONJ_TAC THENL
         [TRANS_TAC CARD_LE_TRANS (← q r"t:real^N->bool") THEN
          SIMP_TAC [CARD_LE_SUBSET, INTER_SUBSET] THEN
          ASM_REWRITE_TAC [← GSYM COUNTABLE_ALT],
          ASM_REWRITE_TAC [← GSYM COUNTABLE_ALT, ← GSYM CARD_NOT_LE]],
        DISCH_THEN (SUBST1_TAC o MATCH_MP CARD_INFINITE_CONG) THEN
        ASM_MESON_TAC [INFINITE, FINITE_IMP_COUNTABLE]],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s INTER u:real^N->bool")) THEN
      REWRITE_TAC [← SET_RULE (← q r"(s DIFF s INTER u) INTER u = {}")] THEN
      ASM_REWRITE_TAC [INFINITE, FINITE_EMPTY]])

  return { LIM_AT_WITHIN, LIM_WITHIN_OPEN, LIM_WITHIN_OPEN_IN, LIMPT_SEQUENTIAL,
           LIMPT_SEQUENTIAL_INJ, LIMPT_SEQUENTIAL_DECREASING, LIMPT_INFINITE_OPEN,
           LIMPT_INFINITE_BALL, LIMPT_INFINITE_CBALL, INFINITE_OPEN_IN, condensation_point_of,
           CONDENSATION_POINT_OF_SUBSET, CONDENSATION_POINT_IMP_LIMPT,
           CONDENSATION_POINT_INFINITE_BALL, CONDENSATION_POINT_INFINITE_CBALL,
           CONDENSATION_POINT_ALT }

/- ------------------------------------------------------------------------- -/
/- Basic arithmetical combining theorems for limits.  (topology.ml 3773-4036) -/
/- ------------------------------------------------------------------------- -/

structure ARI where
  LIM_LINEAR : thm
  LIM_CONST : thm
  LIM_CMUL : thm
  LIM_CMUL_EQ : thm
  LIM_NEG : thm
  LIM_NEG_EQ : thm
  LIM_ADD : thm
  LIM_ABS : thm
  LIM_LIFT_ABS_COMPONENT : thm
  LIM_SUB : thm
  LIM_MAX : thm
  LIM_MIN : thm
  LIM_NORM : thm
  LIM_NULL : thm
  LIM_NULL_NORM : thm
  LIM_NULL_CMUL_EQ : thm
  LIM_NULL_CMUL : thm
  LIM_NULL_VMUL_EQ : thm
  LIM_NULL_VMUL : thm
  LIM_NULL_NEG : thm
  LIM_NULL_ADD : thm
  LIM_NULL_SUB : thm
  LIM_NULL_COMPARISON : thm
  LIM_COMPONENT : thm
  LIM_TRANSFORM_BOUND : thm
  LIM_NULL_CMUL_BOUNDED : thm
  LIM_NULL_VMUL_BOUNDED : thm
  LIM_VSUM : thm
  LIM_NULL_VSUM : thm
  deriving Inhabited

@[nospecialize]
def setupARI [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) : ExceptT String IO ARI := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH,
        NORM_ARITH_TAC, .. } := D
  let { CART_EQ, EQ_IMP, ETA_AX, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN_INSERT, .. } := D.core2
  let { LAMBDA_BETA, MONO_FORALL, MONO_IMP, REAL_ABS_NUM, REAL_ABS_POS, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_LMUL_EQ, REAL_LE_MUL2, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_MUL_SYM, RIGHT_AND_FORALL_THM, .. } :=
    D.core5
  let { o_THM, real_sub, .. } := D.core6
  let { COMPONENT_LE_NORM, DIST_LIFT, DIST_REFL, .. } := D.vec1
  let { LIFT_CMUL, LIFT_SUB, LINEAR_BOUNDED_POS, LINEAR_COMPOSE_CMUL, LINEAR_ID, LINEAR_SUB, .. } :=
    D.vec2
  let { NORM_0, NORM_EQ_0, NORM_LIFT, NORM_MUL, NORM_POS_LE, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG,
        VECTOR_SUB, VECTOR_SUB_COMPONENT, VECTOR_SUB_RZERO, VSUM_0, VSUM_CLAUSES, dist, .. } :=
    D.vec4
  let { ALWAYS_EVENTUALLY, .. } := D.met1
  let { EVENTUALLY_AND, EVENTUALLY_MONO, EVENTUALLY_MP, EVENTUALLY_TRUE, LIMIT_REAL_ABS,
        LIMIT_REAL_ADD, .. } := D.met2
  let { LIM_COMPONENTWISE_REAL, tendsto, .. } := BLIM1
  -- @@SCOPE END

  let LIM_LINEAR ← prove
   r"!net:(A)net h f l.
        (f --> l) net /\ linear h ==> ((\x. h(f x)) --> h l) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC o
      MATCH_MP LINEAR_BOUNDED_POS) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / B")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, dist, ← GSYM LINEAR_SUB, REAL_LT_RDIV_EQ] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    ASM_MESON_TAC [REAL_LET_TRANS, REAL_MUL_SYM])

  let LIM_CONST ← prove
   r"!net a:real^N. ((\x. a) --> a) net"
   (SIMP_TAC [tendsto, DIST_REFL, EVENTUALLY_TRUE])

  let LIM_CMUL ← prove
   r"!f l c. (f --> l) net ==> ((\x. c % f x) --> c % l) net"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_LINEAR THEN
    ASM_REWRITE_TAC [← REWRITE_RULE [ETA_AX]
      (← MATCH_MP LINEAR_COMPOSE_CMUL LINEAR_ID)])

  let LIM_CMUL_EQ ← prove
   r"!net f l c.
        ~(c = &0) ==> (((\x. c % f x) --> c % l) net <=> (f --> l) net)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [LIM_CMUL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv c:real") o MATCH_MP LIM_CMUL) THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, VECTOR_MUL_LID, ETA_AX])

  let LIM_NEG ← prove
   r"!net f l:real^N. (f --> l) net ==> ((\x. --(f x)) --> --l) net"
   (ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"--x:real^N = --(&1) % x")] THEN
    REWRITE_TAC [LIM_CMUL])

  let LIM_NEG_EQ ← prove
   r"!net f l:real^N. ((\x. --(f x)) --> --l) net <=> (f --> l) net"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_NEG) THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ETA_AX])

  let LIM_ADD ← prove
   r"!net:(A)net f g l m.
    (f --> l) net /\ (g --> m) net ==> ((\x. f(x) + g(x)) --> l + m) net"
   (REWRITE_TAC [LIM_COMPONENTWISE_REAL, VECTOR_ADD_COMPONENT] THEN
    SIMP_TAC [LIMIT_REAL_ADD])

  let LIM_ABS ← prove
   r"!net:(A)net f:A->real^N l.
     (f --> l) net
     ==> ((\x. lambda i. (abs(f(x)$i))) --> (lambda i. abs(l$i)):real^N) net"
   (SIMP_TAC [LIM_COMPONENTWISE_REAL, LAMBDA_BETA] THEN
    SIMP_TAC [LIMIT_REAL_ABS])

  let LIM_LIFT_ABS_COMPONENT ← prove
   r"!net:(A)net f:A->real^N l k.
     (f --> l) net ==> ((\x. lift(abs(f(x)$k))) --> lift(abs(l$k))) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    GEN_TAC THEN REWRITE_TAC [DIST_LIFT] THEN REWRITE_TAC [dist] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"abs(x - y) <= a ==> a < e ==> abs(abs x - abs y) < e")) THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT, COMPONENT_LE_NORM])

  let LIM_SUB ← prove
   r"!net:(A)net f g l m.
    (f --> l) net /\ (g --> m) net ==> ((\x. f(x) - g(x)) --> l - m) net"
   (REWRITE_TAC [real_sub, VECTOR_SUB] THEN ASM_SIMP_TAC [LIM_ADD, LIM_NEG])

  let LIM_MAX ← prove
   r"!net:(A)net f g l:real^N m:real^N.
    (f --> l) net /\ (g --> m) net
    ==> ((\x. lambda i. max (f(x)$i) (g(x)$i))
         --> (lambda i. max (l$i) (m$i)):real^N) net"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LIM_ADD) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LIM_SUB) THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_ABS) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_ADD) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(&2)") o MATCH_MP LIM_CMUL) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN BINOP_TAC THEN
    SIMP_TAC [FUN_EQ_THM, CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
              VECTOR_SUB_COMPONENT, LAMBDA_BETA] THEN
    REAL_ARITH_TAC)

  let LIM_MIN ← prove
   r"!net:(A)net f g l:real^N m:real^N.
    (f --> l) net /\ (g --> m) net
    ==> ((\x. lambda i. min (f(x)$i) (g(x)$i))
         --> (lambda i. min (l$i) (m$i)):real^N) net"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN (MP_TAC o MATCH_MP LIM_NEG)) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_NEG o MATCH_MP LIM_MAX) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN BINOP_TAC THEN
    SIMP_TAC [FUN_EQ_THM, CART_EQ, LAMBDA_BETA, VECTOR_NEG_COMPONENT] THEN
    REAL_ARITH_TAC)

  let LIM_NORM ← prove
   r"!net f:A->real^N l.
        (f --> l) net ==> ((\x. lift(norm(f x))) --> lift(norm l)) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto, DIST_LIFT] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [] THEN NORM_ARITH_TAC)

  let LIM_NULL ← prove
   r"!net f l. (f --> l) net <=> ((\x. f(x) - l) --> vec 0) net"
   (REWRITE_TAC [tendsto, dist, VECTOR_SUB_RZERO])

  let LIM_NULL_NORM ← prove
   r"!net f. (f --> vec 0) net <=> ((\x. lift(norm(f x))) --> vec 0) net"
   (REWRITE_TAC [tendsto, dist, VECTOR_SUB_RZERO, REAL_ABS_NORM, NORM_LIFT])

  let LIM_NULL_CMUL_EQ ← prove
   r"!net f:A->real^N c.
        ((\x. c % f x) --> vec 0) net <=> c = &0 \/ (f --> vec 0) net"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, LIM_CONST] THEN
    ASM_MESON_TAC [LIM_CMUL_EQ, VECTOR_MUL_RZERO])

  let LIM_NULL_CMUL ← prove
   r"!net f c. (f --> vec 0) net ==> ((\x. c % f x) --> vec 0) net"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_SIMP_TAC [LIM_NULL_CMUL_EQ, VECTOR_MUL_LZERO, LIM_CONST])

  let LIM_NULL_VMUL_EQ ← prove
   r"!net:A net c v:real^N.
        ((\x. c x % v) --> vec 0) net <=>
        v = vec 0 \/ ((\x. lift(c x)) --> vec 0) net"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [LIM_NULL_NORM] THEN
    REWRITE_TAC [NORM_MUL] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [LIFT_CMUL, LIM_NULL_CMUL_EQ, NORM_EQ_0] THEN
    REWRITE_TAC [NORM_LIFT])

  let LIM_NULL_VMUL ← prove
   r"!net:A net c v:real^N.
    ((\x. lift(c x)) --> vec 0) net ==> ((\x. c x % v) --> vec 0) net"
   (SIMP_TAC [LIM_NULL_VMUL_EQ])

  let LIM_NULL_NEG ← prove
   r"!net f:A->real^N. ((\x. --(f x)) --> vec 0) net <=> (f --> vec 0) net"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"--x:real^N = --(&1) % x")] THEN
    REWRITE_TAC [LIM_NULL_CMUL_EQ] THEN CONV_TAC REAL_RAT_REDUCE_CONV)

  let LIM_NULL_ADD ← prove
   r"!net f g:A->real^N.
        (f --> vec 0) net /\ (g --> vec 0) net
        ==> ((\x. f x + g x) --> vec 0) net"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_ADD) THEN
    REWRITE_TAC [VECTOR_ADD_LID])

  let LIM_NULL_SUB ← prove
   r"!net f g:A->real^N.
        (f --> vec 0) net /\ (g --> vec 0) net
        ==> ((\x. f x - g x) --> vec 0) net"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_SUB) THEN
    REWRITE_TAC [VECTOR_SUB_RZERO])

  let LIM_NULL_COMPARISON ← prove
   r"!net f g. eventually (\x. norm(f x) <= g x) net /\
             ((\x. lift(g x)) --> vec 0) net
             ==> (f --> vec 0) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto, RIGHT_AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [dist, VECTOR_SUB_RZERO, NORM_LIFT] THEN REAL_ARITH_TAC)

  let LIM_COMPONENT ← prove
   r"!net f i l:real^N.
     (f --> l) net ==> ((\a. lift(f(a)$i)) --> lift(l$i)) net"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [tendsto, dist, ← GSYM LIFT_SUB, NORM_LIFT] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    MESON_TAC [COMPONENT_LE_NORM, REAL_LET_TRANS])

  let LIM_TRANSFORM_BOUND ← prove
   r"!f g. eventually (\n. norm(f n) <= norm(g n)) net /\ (g --> vec 0) net
         ==> (f --> vec 0) net"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [tendsto, RIGHT_AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [dist, VECTOR_SUB_RZERO] THEN REAL_ARITH_TAC)

  let LIM_NULL_CMUL_BOUNDED ← prove
   r"!f g:A->real^N B.
        eventually (\a. g a = vec 0 \/ abs(f a) <= B) net /\
        (g --> vec 0) net
        ==> ((\n. f n % g n) --> vec 0) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / (abs B + &1)")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < abs x + &1")] THEN
    UNDISCH_TAC (← q r"eventually (\a. g a:real^N = vec 0 \/ abs(f a) <= B)
                             (net:(A net))") THEN
    REWRITE_TAC [IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    REWRITE_TAC [dist, VECTOR_SUB_RZERO, o_THM, NORM_LIFT, NORM_MUL] THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(g:A->real^N) x = vec 0") THEN
    ASM_REWRITE_TAC [NORM_0, REAL_MUL_RZERO] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"B * e / (abs B + &1)") THEN
    ASM_SIMP_TAC [REAL_LE_MUL2, REAL_ABS_POS, NORM_POS_LE, REAL_LT_IMP_LE] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"c * (a / b) = (c * a) / b")] THEN
    SIMP_TAC [REAL_LT_LDIV_EQ, ← REAL_ARITH (← q r"&0 < abs x + &1")] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"e * B <= e * abs B /\ &0 < e ==> B * e < e * (abs B + &1)")) THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN REAL_ARITH_TAC)

  let LIM_NULL_VMUL_BOUNDED ← prove
   r"!f g:A->real^N B.
        ((lift o f) --> vec 0) net /\
        eventually (\a. f a = &0 \/ norm(g a) <= B) net
        ==> ((\n. f n % g n) --> vec 0) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / (abs B + &1)")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < abs x + &1")] THEN
    UNDISCH_TAC (← q r"eventually(\a. f a = &0 \/ norm((g:A->real^N) a) <= B) net") THEN
    REWRITE_TAC [IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    REWRITE_TAC [dist, VECTOR_SUB_RZERO, o_THM, NORM_LIFT, NORM_MUL] THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(f:A->real) x = &0") THEN
    ASM_REWRITE_TAC [REAL_ABS_NUM, REAL_MUL_LZERO] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"e / (abs B + &1) * B") THEN
    ASM_SIMP_TAC [REAL_LE_MUL2, REAL_ABS_POS, NORM_POS_LE, REAL_LT_IMP_LE] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"(a / b) * c = (a * c) / b")] THEN
    SIMP_TAC [REAL_LT_LDIV_EQ, ← REAL_ARITH (← q r"&0 < abs x + &1")] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"e * B <= e * abs B /\ &0 < e ==> e * B < e * (abs B + &1)")) THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN REAL_ARITH_TAC)

  let LIM_VSUM ← prove
   r"!net f:A->B->real^N l s.
        FINITE s /\ (!i. i IN s ==> ((f i) --> (l i)) net)
        ==> ((\x. vsum s (\i. f i x)) --> vsum s l) net"
   (REPLICATE_TAC 3 GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [VSUM_CLAUSES, LIM_CONST, LIM_ADD, IN_INSERT, ETA_AX])

  let LIM_NULL_VSUM ← prove
   r"!net f:A->B->real^N s.
        FINITE s /\ (!a. a IN s ==> ((\x. f x a) --> vec 0) net)
        ==> ((\x. vsum s (f x)) --> vec 0) net"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP LIM_VSUM) THEN
    REWRITE_TAC [VSUM_0, ETA_AX])

  return { LIM_LINEAR, LIM_CONST, LIM_CMUL, LIM_CMUL_EQ, LIM_NEG, LIM_NEG_EQ, LIM_ADD, LIM_ABS,
           LIM_LIFT_ABS_COMPONENT, LIM_SUB, LIM_MAX, LIM_MIN, LIM_NORM, LIM_NULL, LIM_NULL_NORM,
           LIM_NULL_CMUL_EQ, LIM_NULL_CMUL, LIM_NULL_VMUL_EQ, LIM_NULL_VMUL, LIM_NULL_NEG,
           LIM_NULL_ADD, LIM_NULL_SUB, LIM_NULL_COMPARISON, LIM_COMPONENT, LIM_TRANSFORM_BOUND,
           LIM_NULL_CMUL_BOUNDED, LIM_NULL_VMUL_BOUNDED, LIM_VSUM, LIM_NULL_VSUM }

/- ------------------------------------------------------------------------- -/
/- Limit in closed sets; norm bounds; uniqueness; limits in the same space; -/
/- uniform limits; bilinear limits.  (topology.ml 4037-4287)                 -/
/- ------------------------------------------------------------------------- -/

structure UNQ where
  LIM_IN_CLOSED_SET : thm
  LIM_NORM_UBOUND : thm
  LIM_NORM_LBOUND : thm
  LIM_UNIQUE : thm
  TENDSTO_LIM : thm
  LIM_CONST_EQ : thm
  LIM_WITHIN_ID : thm
  LIM_AT_ID : thm
  LIM_AT_ZERO : thm
  UNIFORM_LIM_ADD : thm
  UNIFORM_LIM_SUB : thm
  UNIFORM_LIM_BILINEAR : thm
  LIM_BILINEAR : thm
  BILINEAR_EPSILON_DELTA : thm
  deriving Inhabited

@[nospecialize]
def setupUNQ [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BNET : NET)
    (BEVT : EVT) (BLIM1 : LIM1) (BLIM2 : LIM2) (BARI : ARI) : ExceptT String IO UNQ := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, ETA_AX, .. } := D.core1
  let { FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ, IMP_IMP, IN_DIFF, .. } := D.core2
  let { IN_UNION, MONO_FORALL, .. } := D.core3
  let { REAL_INV_MUL, REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_MUL2, REAL_LE_REFL, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ, REAL_LT_MIN,
        REAL_LT_MUL, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_SYM, REAL_SUB_LT, RIGHT_AND_FORALL_THM, SNDCART_PASTECART,
        SUBSET, .. } := D.core5
  let { real_div, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { BILINEAR_BOUNDED_POS, BILINEAR_LSUB, BILINEAR_RSUB, DIST_PASTECART_LE, DIST_SYM, .. } :=
    D.vec1
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { NORM_POS_LE, NORM_TRIANGLE_LT, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { EVENTUALLY_AND, EVENTUALLY_HAPPENS, EVENTUALLY_MONO, EVENTUALLY_TRUE,
        LIMIT_METRIC_UNIQUE, .. } := D.met2
  let { NOT_EVENTUALLY, .. } := D.met3
  let { MTOPOLOGY_EUCLIDEAN_METRIC, .. } := BEUC
  let { closed, .. } := BCLO
  let { IN_BALL, OPEN_CONTAINS_BALL, .. } := BBAL
  let { WITHIN_UNIV, .. } := BNET
  let { EVENTUALLY_AT_ZERO, .. } := BEVT
  let { LIMIT_EUCLIDEAN, LIM_TRIVIAL, lim, tendsto, .. } := BLIM1
  let { LIM_SELF_AT, LIM_WITHIN, .. } := BLIM2
  let { LIM_CONST, LIM_LINEAR, .. } := BARI
  -- @@SCOPE END

  let LIM_IN_CLOSED_SET ← prove
   r"!net f:A->real^N s l.
        closed s /\ eventually (\x. f(x) IN s) net /\
        ~(trivial_limit net) /\ (f --> l) net
        ==> l IN s"
   (REWRITE_TAC [closed] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"~(x IN (UNIV DIFF s)) ==> x IN s")) THEN
    DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"l:real^N") o GEN_REWRITE_RULE id
            [OPEN_CONTAINS_BALL]) THEN
    ASM_REWRITE_TAC [SUBSET, IN_BALL, IN_DIFF, IN_UNION] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real") o GEN_REWRITE_RULE id [tendsto]) THEN
    UNDISCH_TAC (← q r"eventually (\x. (f:A->real^N) x IN s) net") THEN
    ASM_REWRITE_TAC [← GSYM EVENTUALLY_AND, ← TAUT (← q r"a ==> ~b <=> ~(a /\ b)")] THEN
    MATCH_MP_TAC NOT_EVENTUALLY THEN ASM_MESON_TAC [DIST_SYM])

  let LIM_NORM_UBOUND ← prove
   r"!net:(A)net f (l:real^N) b.
      ~(trivial_limit net) /\
      (f --> l) net /\
      eventually (\x. norm(f x) <= b) net
      ==> norm(l) <= b"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"norm(l:real^N) <= b \/ b < norm l")) THEN
    ASM_REWRITE_TAC [tendsto] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"norm(l:real^N) - b")) MP_TAC) THEN
    ASM_REWRITE_TAC [REAL_SUB_LT, IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
    DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
    ASM_REWRITE_TAC [] THEN UNDISCH_TAC (← q r"b < norm(l:real^N)") THEN
    CONV_TAC (fun t => NORM_ARITH t))

  let LIM_NORM_LBOUND ← prove
   r"!net:(A)net f (l:real^N) b.
      ~(trivial_limit net) /\ (f --> l) net /\
      eventually (\x. b <= norm(f x)) net
      ==> b <= norm(l)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"norm(l:real^N) < b \/ b <= norm l")) THEN
    ASM_REWRITE_TAC [tendsto] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"b - norm(l:real^N)")) MP_TAC) THEN
    ASM_REWRITE_TAC [REAL_SUB_LT, IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
    DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
    ASM_REWRITE_TAC [] THEN UNDISCH_TAC (← q r"norm(l:real^N) < b") THEN
    CONV_TAC (fun t => NORM_ARITH t))

  let LIM_UNIQUE ← prove
   r"!net:(A)net f l:real^N l'.
      ~(trivial_limit net) /\ (f --> l) net /\ (f --> l') net ==> (l = l')"
   (REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [LIMIT_METRIC_UNIQUE])

  let TENDSTO_LIM ← prove
   r"!net f l. ~(trivial_limit net) /\ (f --> l) net ==> lim net f = l"
   (REWRITE_TAC [lim] THEN MESON_TAC [LIM_UNIQUE])

  let LIM_CONST_EQ ← prove
   r"!net:(A net) c d:real^N.
        ((\x. c) --> d) net <=> trivial_limit net \/ c = d"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN
    ASM_SIMP_TAC [LIM_TRIVIAL] THEN
    EQ_TAC THEN SIMP_TAC [LIM_CONST] THEN DISCH_TAC THEN
    MATCH_MP_TAC (← SPEC (← q r"net:A net") LIM_UNIQUE) THEN
    EXISTS_TAC (← q r"(\x. c):A->real^N") THEN ASM_REWRITE_TAC [LIM_CONST])

  let LIM_WITHIN_ID ← prove
   r"!a s. ((\x. x) --> a) (at a within s)"
   (REWRITE_TAC [LIM_WITHIN] THEN MESON_TAC [])

  let LIM_AT_ID ← prove
   r"!a. ((\x. x) --> a) (at a)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN REWRITE_TAC [LIM_WITHIN_ID])

  let LIM_AT_ZERO ← prove
   r"!f:real^M->real^N l a.
        (f --> l) (at a) <=> ((\x. f(a + x)) --> l) (at(vec 0))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [EVENTUALLY_AT_ZERO] THEN
    REWRITE_TAC [])

  let UNIFORM_LIM_ADD ← prove
   r"!net:(A)net P f g l m.
        (!e. &0 < e
             ==> eventually (\x. !n:B. P n ==> norm(f n x - l n) < e) net) /\
        (!e. &0 < e
             ==> eventually (\x. !n. P n ==> norm(g n x - m n) < e) net)
        ==> !e. &0 < e
                ==> eventually
                     (\x. !n. P n
                              ==> norm((f n x + g n x) - (l n + m n)) < e)
                     net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [AND_FORALL_THM] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, ← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    GEN_TAC THEN REWRITE_TAC [AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:B") THEN
    ASM_CASES_TAC (← q r"(P:B->bool) n") THEN ASM_REWRITE_TAC [] THEN
    CONV_TAC (fun t => NORM_ARITH t))

  let UNIFORM_LIM_SUB ← prove
   r"!net:(A)net P f g l m.
        (!e. &0 < e
             ==> eventually (\x. !n:B. P n ==> norm(f n x - l n) < e) net) /\
        (!e. &0 < e
             ==> eventually (\x. !n. P n ==> norm(g n x - m n) < e) net)
        ==> !e. &0 < e
                ==> eventually
                     (\x. !n. P n
                              ==> norm((f n x - g n x) - (l n - m n)) < e)
                     net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [AND_FORALL_THM] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, ← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    GEN_TAC THEN REWRITE_TAC [AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:B") THEN
    ASM_CASES_TAC (← q r"(P:B->bool) n") THEN ASM_REWRITE_TAC [] THEN
    CONV_TAC (fun t => NORM_ARITH t))

  let UNIFORM_LIM_BILINEAR ← prove
   r"!net:(A)net P (h:real^M->real^N->real^P) f g l m b1 b2.
        bilinear h /\
        eventually (\x. !n. P n ==> norm(l n) <= b1) net /\
        eventually (\x. !n. P n ==> norm(m n) <= b2) net /\
        (!e. &0 < e
             ==> eventually (\x. !n:B. P n ==> norm(f n x - l n) < e) net) /\
        (!e. &0 < e
             ==> eventually (\x. !n. P n ==> norm(g n x - m n) < e) net)
        ==> !e. &0 < e
                ==> eventually
                     (\x. !n. P n
                              ==> norm(h (f n x) (g n x) - h (l n) (m n)) < e)
                     net"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC o MATCH_MP
     BILINEAR_BOUNDED_POS) THEN
    REWRITE_TAC [AND_FORALL_THM, RIGHT_AND_FORALL_THM] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"min (abs b2 + &1) (e / &2 / (B * (abs b1 + abs b2 + &2)))")) THEN
    ASM_SIMP_TAC [REAL_HALF, REAL_LT_DIV, REAL_LT_MUL, REAL_LT_MIN,
                  ← REAL_ARITH (← q r"&0 < abs x + &1"),
                  ← REAL_ARITH (← q r"&0 < abs x + abs y + &2")] THEN
    REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:B") THEN
    ASM_CASES_TAC (← q r"(P:B->bool) n") THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH
      (← q r"h a b - h c d :real^N = (h a b - h a d) + (h a d - h c d)")] THEN
    ASM_SIMP_TAC [← GSYM BILINEAR_LSUB, ← GSYM BILINEAR_RSUB] THEN
    MATCH_MP_TAC NORM_TRIANGLE_LT THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← MESON [REAL_LE_ADD2, REAL_LET_TRANS]
       (← q r"(!x y. norm(h x y:real^P) <= B * norm x * norm y)
         ==> B * norm a * norm b + B * norm c * norm d < e
             ==> norm(h a b) + norm(h c d) < e"))) THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"x * B < e / &2 /\ y * B < e / &2 ==> B * x + B * y < e")) THEN
    CONJ_TAC THEN ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ] THENL
     [ONCE_REWRITE_TAC [REAL_MUL_SYM], ALL_TAC] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"e / &2 / (B * (abs b1 + abs b2 + &2)) *
               (abs b1 + abs b2 + &1)") THEN
    (CONJ_TAC THENL
      [MATCH_MP_TAC REAL_LE_MUL2 THEN
       ASM_SIMP_TAC [NORM_POS_LE, REAL_LT_IMP_LE] THEN
       ASM_SIMP_TAC [← REAL_ARITH (← q r"a <= b2 ==> a <= abs b1 + abs b2 + &1")] THEN
       ASM_MESON_TAC [← NORM_ARITH
         (← q r"norm(f - l:real^P) < abs b2 + &1 /\ norm(l) <= b1
          ==> norm(f) <= abs b1 + abs b2 + &1")],
       ONCE_REWRITE_TAC [real_div] THEN
       ASM_SIMP_TAC [REAL_LT_LMUL_EQ, REAL_HALF, ← GSYM REAL_MUL_ASSOC,
                     REAL_INV_MUL] THEN
       REWRITE_TAC [← REAL_ARITH (← q r"B * inv x * y < B <=> B * y / x < B * &1")] THEN
       ASM_SIMP_TAC [REAL_LT_INV_EQ, REAL_LT_LMUL_EQ, REAL_LT_LDIV_EQ,
                     ← REAL_ARITH (← q r"&0 < abs x + abs y + &2")] THEN
       REAL_ARITH_TAC]))

  let LIM_BILINEAR ← prove
   r"!net:(A)net (h:real^M->real^N->real^P) f g l m.
        (f --> l) net /\ (g --> m) net /\ bilinear h
        ==> ((\x. h (f x) (g x)) --> (h l m)) net"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"net:(A)net", ← q r"\x:one. T", ← q r"h:real^M->real^N->real^P",
      ← q r"\n:one. (f:A->real^M)", ← q r"\n:one. (g:A->real^N)",
      ← q r"\n:one. (l:real^M)", ← q r"\n:one. (m:real^N)",
      ← q r"norm(l:real^M)", ← q r"norm(m:real^N)"]
     UNIFORM_LIM_BILINEAR) THEN
    ASM_REWRITE_TAC [REAL_LE_REFL, EVENTUALLY_TRUE] THEN
    ASM_REWRITE_TAC [← GSYM dist, ← GSYM tendsto])

  let BILINEAR_EPSILON_DELTA ← prove
   r"!bop:real^M->real^N->real^P a b e.
        bilinear bop /\ &0 < e
        ==> ?d. &0 < d /\
                !x y. norm(x - a) < d /\ norm(y - b) < d
                      ==> norm(bop x y - bop a b) < e"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"at (pastecart (a:real^M) (b:real^N))",
      ← q r"bop:real^M->real^N->real^P",
      ← q r"fstcart:real^(M,N)finite_sum->real^M",
      ← q r"sndcart:real^(M,N)finite_sum->real^N",
      ← q r"fstcart(pastecart (a:real^M) (b:real^N))",
      ← q r"sndcart(pastecart (a:real^M) (b:real^N))"]
      LIM_BILINEAR) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THEN
      GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM ETA_AX] THEN
      MATCH_MP_TAC LIM_LINEAR THEN
      REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART, LIM_AT_ID],
      REWRITE_TAC [LIM_SELF_AT] THEN DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
      ASM_SIMP_TAC [FORALL_PASTECART, FSTCART_PASTECART, SNDCART_PASTECART] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"d / &2") THEN ASM_REWRITE_TAC [REAL_HALF, ← GSYM dist] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      W (MP_TAC o PART_MATCH lhand DIST_PASTECART_LE o lhand o snd) THEN
      ASM_REAL_ARITH_TAC])

  return { LIM_IN_CLOSED_SET, LIM_NORM_UBOUND, LIM_NORM_LBOUND, LIM_UNIQUE, TENDSTO_LIM,
           LIM_CONST_EQ, LIM_WITHIN_ID, LIM_AT_ID, LIM_AT_ZERO, UNIFORM_LIM_ADD, UNIFORM_LIM_SUB,
           UNIFORM_LIM_BILINEAR, LIM_BILINEAR, BILINEAR_EPSILON_DELTA }

/- ------------------------------------------------------------------------- -/
/- Transformation of limit; linear limits; conditional sequences;           -/
/- congruence rules.  (topology.ml 4288-4502)                                -/
/- ------------------------------------------------------------------------- -/

structure TRN where
  LIM_TRANSFORM : thm
  LIM_TRANSFORM_EVENTUALLY : thm
  LIM_TRANSFORM_WITHIN : thm
  LIM_TRANSFORM_AT : thm
  LIM_TRANSFORM_EQ : thm
  LIM_TRANSFORM_WITHIN_SET : thm
  LIM_TRANSFORM_WITHIN_SET_IMP : thm
  LIM_TRANSFORM_AWAY_WITHIN : thm
  LIM_TRANSFORM_AWAY_AT : thm
  LIM_TRANSFORM_WITHIN_OPEN : thm
  LIM_TRANSFORM_WITHIN_OPEN_IN : thm
  LINEAR_LIMIT : thm
  LINEAR_SEQUENTIAL_LIMIT : thm
  LIM_CASES_FINITE_SEQUENTIALLY : thm
  LIM_CASES_COFINITE_SEQUENTIALLY : thm
  LIM_CASES_SEQUENTIALLY : thm
  LIM_CONG_WITHIN : thm
  LIM_CONG_AT : thm
  deriving Inhabited

@[nospecialize]
def setupTRN [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLOC : LOC) (BNET : NET) (BEVT : EVT)
    (BLIM2 : LIM2) (BARI : ARI) (BUNQ : UNQ) : ExceptT String IO TRN := do
  -- @@SCOPE BEGIN
  let { extend_basic_congs, ARITH_RULE, ASM_MESON_TAC, MESON_TAC, VECTOR_ARITH_TAC, .. } := D
  let { COND_SWAP, EQ_IMP, FINITE_NUMSEG_LE, .. } := D.core1
  let { FINITE_NUMSEG_LT, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IN_ELIM_THM, IN_INTER, .. } :=
    D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_LE, NOT_LT, .. } := D.core3
  let { REAL_LT_MIN, REAL_LT_REFL, .. } := D.core4
  let { SUBSET, .. } := D.core5
  let { UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { DIST_NZ, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { VECTOR_NEG_0, VECTOR_NEG_SUB, VECTOR_SUB_EQ, VECTOR_SUB_REFL, linear, .. } := D.vec4
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { IN_BALL, OPEN_CONTAINS_BALL, .. } := BBAL
  let { OPEN_IN_CONTAINS_BALL, .. } := BLOC
  let { WITHIN_UNIV, .. } := BNET
  let { EVENTUALLY_AT, .. } := BEVT
  let { LIM_AT, LIM_EVENTUALLY, LIM_WITHIN, .. } := BLIM2
  let { LIM_ADD, LIM_CMUL, LIM_NEG, LIM_NEG_EQ, LIM_SUB, .. } := BARI
  let { LIM_UNIQUE, .. } := BUNQ
  -- @@SCOPE END

  let LIM_TRANSFORM ← prove
   r"!net f g l.
     ((\x. f x - g x) --> vec 0) net /\ (f --> l) net ==> (g --> l) net"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP LIM_SUB) THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_NEG) THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN BINOP_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    VECTOR_ARITH_TAC)

  let LIM_TRANSFORM_EVENTUALLY ← prove
   r"!net f g l.
        eventually (\x. f x = g x) net /\ (f --> l) net ==> (g --> l) net"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o MATCH_MP LIM_EVENTUALLY) MP_TAC) THEN
    MESON_TAC [LIM_TRANSFORM])

  let LIM_TRANSFORM_WITHIN ← prove
   r"!f g x s d.
        &0 < d /\
        (!x'. x' IN s /\ &0 < dist(x',x) /\ dist(x',x) < d ==> f(x') = g(x')) /\
        (f --> l) (at x within s)
        ==> (g --> l) (at x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    DISCH_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM) THEN
    REWRITE_TAC [LIM_WITHIN] THEN REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"d:real") THEN
    ASM_SIMP_TAC [VECTOR_SUB_REFL, DIST_REFL])

  let LIM_TRANSFORM_AT ← prove
   r"!f g x d.
        &0 < d /\
        (!x'. &0 < dist(x',x) /\ dist(x',x) < d ==> f(x') = g(x')) /\
        (f --> l) (at x)
        ==> (g --> l) (at x)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN MESON_TAC [LIM_TRANSFORM_WITHIN])

  let LIM_TRANSFORM_EQ ← prove
   r"!net f:A->real^N g l.
     ((\x. f x - g x) --> vec 0) net ==> ((f --> l) net <=> (g --> l) net)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    DISCH_TAC THEN MATCH_MP_TAC LIM_TRANSFORM THENL
     [EXISTS_TAC (← q r"f:A->real^N") THEN ASM_REWRITE_TAC [],
      EXISTS_TAC (← q r"g:A->real^N") THEN ASM_REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [← GSYM LIM_NEG_EQ] THEN
      ASM_REWRITE_TAC [VECTOR_NEG_SUB, VECTOR_NEG_0]])

  let LIM_TRANSFORM_WITHIN_SET ← prove
   r"!f l a s t.
        eventually (\x. x IN s <=> x IN t) (at a)
        ==> ((f --> l) (at a within s) <=> (f --> l) (at a within t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EVENTUALLY_AT, LIM_WITHIN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d k:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [])

  let LIM_TRANSFORM_WITHIN_SET_IMP ← prove
   r"!f l a s t.
        eventually (\x. x IN t ==> x IN s) (at a) /\ (f --> l) (at a within s)
        ==> (f --> l) (at a within t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ, EVENTUALLY_AT, LIM_WITHIN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d k:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [])

  let LIM_TRANSFORM_AWAY_WITHIN ← prove
   r"!f:real^M->real^N g a b s.
        ~(a = b) /\
        (!x. x IN s /\ ~(x = a) /\ ~(x = b) ==> f(x) = g(x)) /\
        (f --> l) (at a within s)
        ==> (g --> l) (at a within s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_TRANSFORM_WITHIN THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"dist(a:real^M,b)"] THEN
    ASM_REWRITE_TAC [← GSYM DIST_NZ] THEN X_GEN_TAC (← q r"y:real^M") THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [DIST_SYM, REAL_LT_REFL])

  let LIM_TRANSFORM_AWAY_AT ← prove
   r"!f:real^M->real^N g a b.
        ~(a = b) /\
        (!x. ~(x = a) /\ ~(x = b) ==> f(x) = g(x)) /\
        (f --> l) (at a)
        ==> (g --> l) (at a)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    MESON_TAC [LIM_TRANSFORM_AWAY_WITHIN])

  let LIM_TRANSFORM_WITHIN_OPEN ← prove
   r"!f g:real^M->real^N s a l.
        open s /\ a IN s /\
        (!x. x IN s /\ ~(x = a) ==> f x = g x) /\
        (f --> l) (at a)
        ==> (g --> l) (at a)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_TRANSFORM_AT THEN
    EXISTS_TAC (← q r"f:real^M->real^N") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^M")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [SUBSET, IN_BALL] THEN
    ASM_MESON_TAC [DIST_NZ, DIST_SYM])

  let LIM_TRANSFORM_WITHIN_OPEN_IN ← prove
   r"!f g:real^M->real^N s t a l.
        open_in (subtopology euclidean t) s /\ a IN s /\
        (!x. x IN s /\ ~(x = a) ==> f x = g x) /\
        (f --> l) (at a within t)
        ==> (g --> l) (at a within t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_TRANSFORM_WITHIN THEN
    EXISTS_TAC (← q r"f:real^M->real^N") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^M") o CONJUNCT2) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [SUBSET, IN_INTER, IN_BALL] THEN
    ASM_MESON_TAC [DIST_NZ, DIST_SYM])

  let LINEAR_LIMIT ← prove
   r"!net:A net f g:real^M->real^N.
        ~trivial_limit net /\
        eventually (\i. linear(f i)) net /\
        (!x. ((\i. f i x) --> g x) net)
        ==> linear g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [linear] THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN
      MATCH_MP_TAC (← ISPEC (← q r"net:A net") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"\i. (f:A->real^M->real^N) i (x + y)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
      EXISTS_TAC (← q r"\i. (f:A->real^M->real^N) i x + f i y") THEN
      ASM_SIMP_TAC [LIM_ADD],
      MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^M"] THEN
      MATCH_MP_TAC (← ISPEC (← q r"net:A net") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"\i. (f:A->real^M->real^N) i (c % x)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
      EXISTS_TAC (← q r"\i. c % (f:A->real^M->real^N) i x") THEN
      ASM_SIMP_TAC [LIM_CMUL]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
       EVENTUALLY_MONO)) THEN
    SIMP_TAC [linear])

  let LINEAR_SEQUENTIAL_LIMIT ← prove
   r"!f g:real^M->real^N.
        eventually (\n. linear(f n)) sequentially /\
        (!x. ((\n. f n x) --> g x) sequentially)
        ==> linear g"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LINEAR_LIMIT) THEN
    ASM_MESON_TAC [TRIVIAL_LIMIT_SEQUENTIALLY])

  let LIM_CASES_FINITE_SEQUENTIALLY ← prove
   r"!f g l. FINITE {n | P n}
           ==> (((\n. if P n then f n else g n) --> l) sequentially <=>
                (g --> l) sequentially)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_EVENTUALLY) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"\n:num. n") o MATCH_MP UPPER_BOUND_FINITE_SET) THEN
    REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN SIMP_TAC [EVENTUALLY_SEQUENTIALLY] THEN
    EXISTS_TAC (← q r"N + 1") THEN
    ASM_MESON_TAC [← ARITH_RULE (← q r"~(x <= n /\ n + 1 <= x)")])

  let LIM_CASES_COFINITE_SEQUENTIALLY ← prove
   r"!f g l. FINITE {n | ~P n}
           ==> (((\n. if P n then f n else g n) --> l) sequentially <=>
                (f --> l) sequentially)"
   (ONCE_REWRITE_TAC [← GSYM COND_SWAP] THEN
    REWRITE_TAC [LIM_CASES_FINITE_SEQUENTIALLY])

  let LIM_CASES_SEQUENTIALLY ← prove
   r"!f g l m. (((\n. if m <= n then f n else g n) --> l) sequentially <=>
              (f --> l) sequentially) /\
             (((\n. if m < n then f n else g n) --> l) sequentially <=>
              (f --> l) sequentially) /\
             (((\n. if n <= m then f n else g n) --> l) sequentially <=>
              (g --> l) sequentially) /\
             (((\n. if n < m then f n else g n) --> l) sequentially <=>
              (g --> l) sequentially)"
   (SIMP_TAC [LIM_CASES_FINITE_SEQUENTIALLY, LIM_CASES_COFINITE_SEQUENTIALLY,
              NOT_LE, NOT_LT, FINITE_NUMSEG_LT, FINITE_NUMSEG_LE])

  let LIM_CONG_WITHIN ← prove
   r"(!x. x IN s /\ ~(x = a) ==> f x = g x)
   ==> (((\x. f x) --> l) (at a within s) <=> ((g --> l) (at a within s)))"
   (REWRITE_TAC [LIM_WITHIN, ← GSYM DIST_NZ] THEN SIMP_TAC [])

  let LIM_CONG_AT ← prove
   r"(!x. ~(x = a) ==> f x = g x)
   ==> (((\x. f x) --> l) (at a) <=> ((g --> l) (at a)))"
   (REWRITE_TAC [LIM_AT, ← GSYM DIST_NZ] THEN SIMP_TAC [])

  extend_basic_congs [LIM_CONG_WITHIN, LIM_CONG_AT]

  return { LIM_TRANSFORM, LIM_TRANSFORM_EVENTUALLY, LIM_TRANSFORM_WITHIN, LIM_TRANSFORM_AT,
           LIM_TRANSFORM_EQ, LIM_TRANSFORM_WITHIN_SET, LIM_TRANSFORM_WITHIN_SET_IMP,
           LIM_TRANSFORM_AWAY_WITHIN, LIM_TRANSFORM_AWAY_AT, LIM_TRANSFORM_WITHIN_OPEN,
           LIM_TRANSFORM_WITHIN_OPEN_IN, LINEAR_LIMIT, LINEAR_SEQUENTIAL_LIMIT,
           LIM_CASES_FINITE_SEQUENTIALLY, LIM_CASES_COFINITE_SEQUENTIALLY, LIM_CASES_SEQUENTIALLY,
           LIM_CONG_WITHIN, LIM_CONG_AT }

/- ------------------------------------------------------------------------- -/
/- Useful lemmas on closure and set of possible sequential limits; some     -/
/- other lemmas about sequences.  (topology.ml 4503-4628)                    -/
/- ------------------------------------------------------------------------- -/

structure SEQ where
  CLOSURE_SEQUENTIAL : thm
  CLOSED_CONTAINS_SEQUENTIAL_LIMIT : thm
  CLOSED_SEQUENTIAL_LIMITS : thm
  CLOSED_IN_SEQUENTIAL_LIMITS : thm
  CLOSED_APPROACHABLE : thm
  IN_CLOSURE_DELETE : thm
  DENSE_LIMIT_POINTS : thm
  SEQ_OFFSET : thm
  SEQ_OFFSET_NEG : thm
  SEQ_OFFSET_REV : thm
  SEQ_OFFSET_EQ : thm
  CONVERGENT_OFFSET : thm
  CONVERGENT_OFFSET_EQ : thm
  CONVERGENT_OFFSET_REV : thm
  SEQ_HARMONIC_OFFSET : thm
  SEQ_HARMONIC : thm
  SEQ_HARMONIC_RATIO : thm
  deriving Inhabited

@[nospecialize]
def setupSEQ [HolBase] (D : TopologyDeps) (BLPT : LPT) (BCLS1 : CLS1) (BCLS2 : CLS2)
    (BLIM2 : LIM2) (BRLM : RLM) (BARI : ARI) (BTRN : TRN) : ExceptT String IO SEQ := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_FIELD, SET_TAC, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { IN_DELETE, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNION, LE_1, MONO_EXISTS, REAL_ABS_INV, REAL_ADD_RID, .. } := D.core3
  let { REAL_ARCH_INV, REAL_ARCH_SIMPLE, REAL_LET_TRANS, REAL_LE_INV2, .. } := D.core4
  let { REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, SUBSET, SUBSET_ANTISYM_EQ,
        SUBSET_INTER, .. } := D.core5
  let { DIST_0, DROP_ADD, DROP_CMUL, DROP_EQ, DROP_VEC, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { NORM_LIFT, .. } := D.vec3
  let { VECTOR_ADD_RID, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { CLOSED_LIMPT, LIMPT_APPROACHABLE, .. } := BLPT
  let { CLOSURE_APPROACHABLE, CLOSURE_CLOSED, CLOSURE_SUBSET, closure, .. } := BCLS1
  let { CLOSED_IN_INTER_CLOSURE, DENSE_IMP_PERFECT, .. } := BCLS2
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIMPT_SEQUENTIAL, .. } := BRLM
  let { LIM_ADD, LIM_CONST, LIM_NULL_CMUL, .. } := BARI
  let { LIM_TRANSFORM_EVENTUALLY, .. } := BTRN
  -- @@SCOPE END

  let CLOSURE_SEQUENTIAL ← prove
   r"!s l:real^N.
     l IN closure(s) <=> ?x. (!n. x(n) IN s) /\ (x --> l) sequentially"
   (REWRITE_TAC [closure, IN_UNION, LIMPT_SEQUENTIAL, IN_ELIM_THM, IN_DELETE] THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC (← TAUT
      (← q r"((b ==> c) /\ (~a /\ c ==> b)) /\ (a ==> c) ==> (a \/ b <=> c)")) THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"\n:num. l:real^N") THEN
    ASM_REWRITE_TAC [LIM_CONST])

  let CLOSED_CONTAINS_SEQUENTIAL_LIMIT ← prove
   r"!s x l:real^N.
        closed s /\ (!n. x n IN s) /\ (x --> l) sequentially ==> l IN s"
   (MESON_TAC [CLOSURE_SEQUENTIAL, CLOSURE_CLOSED])

  let CLOSED_SEQUENTIAL_LIMITS ← prove
   r"!s. closed s <=>
       !x l. (!n. x(n) IN s) /\ (x --> l) sequentially ==> l IN s"
   (MESON_TAC [CLOSURE_SEQUENTIAL, CLOSURE_CLOSED,
               CLOSED_LIMPT, LIMPT_SEQUENTIAL, IN_DELETE])

  let CLOSED_IN_SEQUENTIAL_LIMITS ← prove
   r"!u s:real^N->bool.
        closed_in (subtopology euclidean u) s <=>
        s SUBSET u /\
        !x l. (!n. x n IN s) /\ l IN u /\ (x --> l) sequentially
              ==> l IN s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN_INTER_CLOSURE] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [SUBSET_INTER, CLOSURE_SUBSET] THEN
    REWRITE_TAC [SUBSET, IN_INTER, CLOSURE_SEQUENTIAL] THEN SET_TAC [])

  let CLOSED_APPROACHABLE ← prove
   r"!x s. closed s
         ==> ((!e. &0 < e ==> ?y. y IN s /\ dist(y,x) < e) <=> x IN s)"
   (MESON_TAC [CLOSURE_CLOSED, CLOSURE_APPROACHABLE])

  let IN_CLOSURE_DELETE ← prove
   r"!s x:real^N. x IN closure(s DELETE x) <=> x limit_point_of s"
   (SIMP_TAC [CLOSURE_APPROACHABLE, LIMPT_APPROACHABLE, IN_DELETE, CONJ_ASSOC])

  let DENSE_LIMIT_POINTS ← prove
   r"!s. {x | x limit_point_of s} = (:real^N) <=> closure s = (:real^N)"
   (GEN_TAC THEN EQ_TAC THENL [SIMP_TAC [closure] THEN SET_TAC [], DISCH_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP DENSE_IMP_PERFECT) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [closure]) THEN ASM SET_TAC [])

  let SEQ_OFFSET ← prove
   r"!f l k. (f --> l) sequentially ==> ((\i. f(i + k)) --> l) sequentially"
   (REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    MESON_TAC [← ARITH_RULE (← q r"N <= n ==> N <= n + k:num")])

  let SEQ_OFFSET_NEG ← prove
   r"!f l k. (f --> l) sequentially ==> ((\i. f(i - k)) --> l) sequentially"
   (REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    MESON_TAC [← ARITH_RULE (← q r"N + k <= n ==> N <= n - k:num")])

  let SEQ_OFFSET_REV ← prove
   r"!f l k. ((\i. f(i + k)) --> l) sequentially ==> (f --> l) sequentially"
   (REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    MESON_TAC [← ARITH_RULE (← q r"N + k <= n ==> N <= n - k /\ (n - k) + k = n:num")])

  let SEQ_OFFSET_EQ ← prove
   r"!k f l:real^N.
        ((\i. f (i + k)) --> l) sequentially <=> (f --> l) sequentially"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [SEQ_OFFSET_REV, SEQ_OFFSET])

  let CONVERGENT_OFFSET ← prove
   r"!f:num->real^N k.
     (?l. (f --> l) sequentially)
     ==> (?l. ((\i. f(i + k)) --> l) sequentially)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN
    REWRITE_TAC [SEQ_OFFSET])

  let CONVERGENT_OFFSET_EQ ← prove
   r"!f:num->real^N k.
        (?l. ((\i. f(i + k)) --> l) sequentially) <=>
        (?l. (f --> l) sequentially)"
   (REPEAT GEN_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    REWRITE_TAC [SEQ_OFFSET_EQ])

  let CONVERGENT_OFFSET_REV ← prove
   r"!f:num->real^N k.
        (?l. ((\i. f(i + k)) --> l) sequentially)
        ==> (?l. (f --> l) sequentially)"
   (REWRITE_TAC [CONVERGENT_OFFSET_EQ])

  let SEQ_HARMONIC_OFFSET ← prove
   r"!a. ((\n. lift(inv(&n + a))) --> vec 0) sequentially"
   (GEN_TAC THEN REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE id [REAL_ARCH_INV]) THEN
    X_CHOOSE_THEN (← q r"M:num") STRIP_ASSUME_TAC
     (← SPEC (← q r"--a:real") REAL_ARCH_SIMPLE) THEN
    EXISTS_TAC (← q r"M + N:num") THEN REWRITE_TAC [DIST_0, NORM_LIFT] THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    TRANS_TAC REAL_LET_TRANS (← q r"inv(&N)") THEN ASM_REWRITE_TAC [REAL_ABS_INV] THEN
    MATCH_MP_TAC REAL_LE_INV2 THEN ASM_SIMP_TAC [REAL_OF_NUM_LT, LE_1] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE, ← GSYM REAL_OF_NUM_ADD]) THEN
    ASM_REAL_ARITH_TAC)

  let SEQ_HARMONIC ← prove
   r"((\n. lift(inv(&n))) --> vec 0) sequentially"
   (MP_TAC (← SPEC (← q r"&0") SEQ_HARMONIC_OFFSET) THEN REWRITE_TAC [REAL_ADD_RID])

  let SEQ_HARMONIC_RATIO ← prove
   r"!a b. ((\n. lift((&n + a) / (&n + b))) --> vec 1) sequentially"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_RID] THEN
    MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"\n. vec 1 + (a - b) % lift(inv(&n + b))") THEN
    SIMP_TAC [LIM_ADD, LIM_CONST, SEQ_HARMONIC_OFFSET, LIM_NULL_CMUL] THEN
    MP_TAC (← ISPEC (← q r"abs b + &1") REAL_ARCH_SIMPLE) THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_ADD, DROP_VEC, DROP_CMUL, LIFT_DROP] THEN
    REWRITE_TAC [← GSYM REAL_OF_NUM_LE] THEN CONV_TAC (fun t => REAL_FIELD t))

  return { CLOSURE_SEQUENTIAL, CLOSED_CONTAINS_SEQUENTIAL_LIMIT, CLOSED_SEQUENTIAL_LIMITS,
           CLOSED_IN_SEQUENTIAL_LIMITS, CLOSED_APPROACHABLE, IN_CLOSURE_DELETE,
           DENSE_LIMIT_POINTS, SEQ_OFFSET, SEQ_OFFSET_NEG, SEQ_OFFSET_REV, SEQ_OFFSET_EQ,
           CONVERGENT_OFFSET, CONVERGENT_OFFSET_EQ, CONVERGENT_OFFSET_REV, SEQ_HARMONIC_OFFSET,
           SEQ_HARMONIC, SEQ_HARMONIC_RATIO }

/- ------------------------------------------------------------------------- -/
/- More properties of closed balls.  (topology.ml 4629-4851)                 -/
/- ------------------------------------------------------------------------- -/

structure CBL where
  CLOSED_CBALL : thm
  CLOSURE_CBALL : thm
  IN_INTERIOR_CBALL : thm
  LIMPT_BALL : thm
  CLOSURE_BALL : thm
  INTERIOR_BALL : thm
  INTERIOR_CBALL : thm
  FRONTIER_BALL : thm
  FRONTIER_CBALL : thm
  INTERIOR_SPHERE : thm
  CBALL_EQ_EMPTY : thm
  CBALL_EMPTY : thm
  CBALL_EQ_SING : thm
  CBALL_SING : thm
  SPHERE_SING : thm
  SPHERE_EQ_SING : thm
  HAS_SIZE_SPHERE_1 : thm
  IMAGE_AFFINITY_CBALL : thm
  IMAGE_AFFINITY_BALL : thm
  IMAGE_AFFINITY_SPHERE : thm
  deriving Inhabited

@[nospecialize]
def setupCBL [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLPT : LPT) (BINT : INT)
    (BCLS1 : CLS1) (BFRO1 : FRO1) (BARI : ARI) (BUNQ : UNQ) (BSEQ : SEQ) :
    ExceptT String IO CBL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, GEN_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        HAS_SIZE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, NORM_ARITH, .. } := D
  let { ARITH, DIMINDEX_GE_1, EXTENSION, .. } := D.core1
  let { IMAGE_EQ_EMPTY, IN_DIFF, IN_ELIM_THM, IN_SING, .. } := D.core2
  let { IN_UNION, LE_REFL, NOT_INSERT_EMPTY, NOT_IN_EMPTY, REAL_ABS_DIV, REAL_ABS_NEG,
        REAL_ABS_NUM, REAL_ABS_NZ, REAL_ABS_ZERO, .. } := D.core3
  let { REAL_DIV_RMUL, REAL_DOWN, REAL_DOWN2, REAL_EQ_MUL_LCANCEL, REAL_LE_LMUL_EQ,
        REAL_LTE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ, REAL_LT_LE,
        REAL_LT_LMUL_EQ, REAL_LT_RDIV_EQ, REAL_LT_RMUL, REAL_LT_RMUL_EQ, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RINV, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_LT,
        SING_GSPEC, SUBSET, SUBSET_TRANS, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, .. } := D.core6
  let { GE_REFL, .. } := D.misc
  let { BASIS_NONZERO, DIST_EQ_0, DIST_LE_0, DIST_MUL, DIST_NZ, DIST_POS_LE, DIST_REFL,
        DIST_SYM, .. } := D.vec1
  let { NORM_0, NORM_BASIS, NORM_MUL, NORM_NEG, NORM_SUB, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_ADD_SUB, VECTOR_CHOOSE_DIST, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0,
        VECTOR_MUL_LZERO, VECTOR_SUB_REFL, dist, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { open_def, .. } := BEUC
  let { BALL_EQ_EMPTY, BALL_SUBSET_CBALL, CBALL_TRIVIAL, CENTRE_IN_BALL, IN_BALL, IN_CBALL,
        IN_SPHERE, OPEN_BALL, OPEN_CONTAINS_CBALL, SPHERE_EMPTY, SPHERE_EQ_EMPTY, sphere, .. } :=
    BBAL
  let { CLOSED_LIMPT, LIMPT_APPROACHABLE, LIMPT_EMPTY, LIMPT_SUBSET, .. } := BLPT
  let { INTERIOR_EMPTY, INTERIOR_OPEN, INTERIOR_UNIQUE, interior, .. } := BINT
  let { CLOSURE_CLOSED, CLOSURE_EQ, closure, .. } := BCLS1
  let { INTERIOR_FRONTIER_EMPTY, frontier, .. } := BFRO1
  let { LIM_CONST, LIM_SUB, .. } := BARI
  let { LIM_NORM_UBOUND, .. } := BUNQ
  let { CLOSED_SEQUENTIAL_LIMITS, .. } := BSEQ
  -- @@SCOPE END
  let va (s : String) : ExceptT String IO thm := do VECTOR_ARITH (← q s)

  let CLOSED_CBALL ← prove
   r"!x:real^N e. closed(cball(x,e))"
   (REWRITE_TAC [CLOSED_SEQUENTIAL_LIMITS, IN_CBALL, dist] THEN
    GEN_TAC THEN GEN_TAC THEN X_GEN_TAC (← q r"s:num->real^N") THEN
    X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN
    EXISTS_TAC (← q r"\n. x - (s:num->real^N) n") THEN
    REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
    ASM_SIMP_TAC [LIM_SUB, LIM_CONST, SEQUENTIALLY] THEN MESON_TAC [GE_REFL])

  let CLOSURE_CBALL ← prove
   r"!a:real^N r. closure(cball(a,r)) = cball(a,r)"
   (REWRITE_TAC [CLOSURE_EQ, CLOSED_CBALL])

  let IN_INTERIOR_CBALL ← prove
   r"!x s. x IN interior s <=> ?e. &0 < e /\ cball(x,e) SUBSET s"
   (REWRITE_TAC [interior, IN_ELIM_THM] THEN
    MESON_TAC [OPEN_CONTAINS_CBALL, SUBSET_TRANS,
               BALL_SUBSET_CBALL, CENTRE_IN_BALL, OPEN_BALL])

  let LIMPT_BALL ← prove
   r"!x:real^N y e. y limit_point_of ball(x,e) <=> &0 < e /\ y IN cball(x,e)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"&0 < e") THENL
     [ALL_TAC, ASM_MESON_TAC [LIMPT_EMPTY, REAL_NOT_LT, BALL_EQ_EMPTY]] THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
     [MESON_TAC [CLOSED_CBALL, CLOSED_LIMPT, LIMPT_SUBSET, BALL_SUBSET_CBALL],
      REWRITE_TAC [IN_CBALL, LIMPT_APPROACHABLE, IN_BALL]] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"y:real^N = x") THEN ASM_REWRITE_TAC [DIST_NZ] THENL
     [MP_TAC (← SPECL [← q r"d:real", ← q r"e:real"] REAL_DOWN2) THEN
      ASM_REWRITE_TAC [] THEN
      GEN_MESON_TAC 0 40 1 [VECTOR_CHOOSE_DIST, DIST_SYM, REAL_LT_IMP_LE],
      ALL_TAC] THEN
    MP_TAC (← SPECL [← q r"norm(y:real^N - x)", ← q r"d:real"] REAL_DOWN2) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [DIST_NZ, dist]) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(y:real^N) - (k / dist(y,x)) % (y - x)") THEN
    REWRITE_TAC [dist, ← va r"(y - c % z) - y = --c % z"] THEN
    REWRITE_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM, REAL_ABS_NEG] THEN
    ASM_SIMP_TAC [REAL_DIV_RMUL, REAL_LT_IMP_NZ] THEN
    REWRITE_TAC [← va r"x - (y - k % (y - x)) = (&1 - k) % (x - y)"] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < k ==> &0 < abs k"), NORM_MUL] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < k /\ k < d ==> abs k < d")] THEN
    MATCH_MP_TAC REAL_LTE_TRANS THEN EXISTS_TAC (← q r"norm(x:real^N - y)") THEN
    ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
    MATCH_MP_TAC REAL_LT_RMUL THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [NORM_SUB]] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < k /\ k < &1 ==> abs(&1 - k) < &1")) THEN
    ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_MUL_LZERO,
                  REAL_MUL_LID])

  let CLOSURE_BALL ← prove
   r"!x:real^N e. &0 < e ==> (closure(ball(x,e)) = cball(x,e))"
   (SIMP_TAC [EXTENSION, closure, IN_ELIM_THM, IN_UNION, LIMPT_BALL] THEN
    REWRITE_TAC [IN_BALL, IN_CBALL] THEN REAL_ARITH_TAC)

  let INTERIOR_BALL ← prove
   r"!a r. interior(ball(a,r)) = ball(a,r)"
   (SIMP_TAC [INTERIOR_OPEN, OPEN_BALL])

  let INTERIOR_CBALL ← prove
   r"!x:real^N e. interior(cball(x,e)) = ball(x,e)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"&0 <= e") THENL
     [ALL_TAC,
      SUBGOAL_THEN (← q r"cball(x:real^N,e) = {} /\ ball(x:real^N,e) = {}")
       (fun th => REWRITE_TAC [th, INTERIOR_EMPTY]) THEN
      REWRITE_TAC [IN_BALL, IN_CBALL, EXTENSION, NOT_IN_EMPTY] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"y:real^N") THEN
      MP_TAC (← ISPECL [← q r"x:real^N", ← q r"y:real^N"] DIST_POS_LE) THEN
      POP_ASSUM MP_TAC THEN REAL_ARITH_TAC] THEN
    MATCH_MP_TAC INTERIOR_UNIQUE THEN
    REWRITE_TAC [BALL_SUBSET_CBALL, OPEN_BALL] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN
    SIMP_TAC [SUBSET, IN_CBALL, IN_BALL, REAL_LT_LE] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:real^N") o GEN_REWRITE_RULE id [open_def]) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_CASES_TAC (← q r"z:real^N = x") THENL
     [FIRST_X_ASSUM SUBST_ALL_TAC THEN
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"k:real") o MATCH_MP REAL_DOWN) THEN
      SUBGOAL_THEN (← q r"?w:real^N. dist(w,x) = k") STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [VECTOR_CHOOSE_DIST, DIST_SYM, REAL_LT_IMP_LE],
        ASM_MESON_TAC [REAL_NOT_LE, DIST_REFL, DIST_SYM]],
      RULE_ASSUM_TAC (REWRITE_RULE [DIST_NZ]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z + ((d / &2) / dist(z,x)) % (z - x:real^N)")) THEN
      REWRITE_TAC [dist, VECTOR_ADD_SUB, NORM_MUL, REAL_ABS_DIV,
                   REAL_ABS_NORM, REAL_ABS_NUM] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, ← GSYM dist, REAL_LT_IMP_NZ] THEN
      ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_OF_NUM_LT, ARITH] THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"abs d < d * &2 <=> &0 < d")] THEN
      DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN REWRITE_TAC [dist] THEN
      REWRITE_TAC [← va r"x - (z + k % (z - x)) = (&1 + k) % (x - z)"] THEN
      REWRITE_TAC [REAL_NOT_LE, NORM_MUL] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM REAL_MUL_LID] THEN
      ONCE_REWRITE_TAC [NORM_SUB] THEN
      ASM_SIMP_TAC [REAL_LT_RMUL_EQ, ← GSYM dist] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> &1 < abs(&1 + x)")) THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH]])

  let FRONTIER_BALL ← prove
   r"!a e. &0 < e ==> frontier(ball(a,e)) = sphere(a,e)"
   (SIMP_TAC [frontier, sphere, CLOSURE_BALL, INTERIOR_OPEN, OPEN_BALL,
              REAL_LT_IMP_LE] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_ELIM_THM, IN_BALL, IN_CBALL] THEN
    REAL_ARITH_TAC)

  let FRONTIER_CBALL ← prove
   r"!a e. frontier(cball(a,e)) = sphere(a,e)"
   (SIMP_TAC [frontier, sphere, INTERIOR_CBALL, CLOSED_CBALL, CLOSURE_CLOSED,
              REAL_LT_IMP_LE] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_ELIM_THM, IN_BALL, IN_CBALL] THEN
    REAL_ARITH_TAC)

  let INTERIOR_SPHERE ← prove
   r"!a:real^N r. interior(sphere(a,r)) = {}"
   (SIMP_TAC [← GSYM FRONTIER_CBALL, INTERIOR_FRONTIER_EMPTY, CLOSED_CBALL])

  let CBALL_EQ_EMPTY ← prove
   r"!x e. (cball(x,e) = {}) <=> e < &0"
   (REWRITE_TAC [EXTENSION, IN_CBALL, NOT_IN_EMPTY, REAL_NOT_LE] THEN
    MESON_TAC [DIST_POS_LE, DIST_REFL, REAL_LTE_TRANS])

  let CBALL_EMPTY ← prove
   r"!x e. e < &0 ==> cball(x,e) = {}"
   (REWRITE_TAC [CBALL_EQ_EMPTY])

  let CBALL_EQ_SING ← prove
   r"!x:real^N e. (cball(x,e) = {x}) <=> e = &0"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EXTENSION, IN_CBALL, IN_SING] THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC [DIST_LE_0]] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"x + (e / &2) % basis 1:real^N") th) THEN
            MP_TAC (← SPEC (← q r"x:real^N") th))) THEN
    REWRITE_TAC [dist, ← va r"x - (x + e):real^N = --e",
                 ← va r"x + e = x <=> e:real^N = vec 0"] THEN
    REWRITE_TAC [NORM_NEG, NORM_MUL, VECTOR_MUL_EQ_0, NORM_0, VECTOR_SUB_REFL] THEN
    SIMP_TAC [NORM_BASIS, BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1] THEN
    REAL_ARITH_TAC)

  let CBALL_SING ← prove
   r"!x e. e = &0 ==> cball(x,e) = {x}"
   (REWRITE_TAC [CBALL_EQ_SING])

  let SPHERE_SING ← prove
   r"!x e. e = &0 ==> sphere(x,e) = {x}"
   (SIMP_TAC [sphere, DIST_EQ_0, SING_GSPEC])

  let SPHERE_EQ_SING ← prove
   r"!a:real^N r x. sphere(a,r) = {x} <=> x = a /\ r = &0"
   (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [SPHERE_SING] THEN
    ASM_CASES_TAC (← q r"r < &0") THEN ASM_SIMP_TAC [SPHERE_EMPTY, NOT_INSERT_EMPTY] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN ASM_SIMP_TAC [SPHERE_SING] THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!y. (x IN s ==> y IN s /\ ~(y = x)) ==> ~(s = {x})")) THEN
    EXISTS_TAC (← q r"a - (x - a):real^N") THEN REWRITE_TAC [IN_SPHERE] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => NORM_ARITH t))

  let HAS_SIZE_SPHERE_1 ← prove
   r"!a:real^N r. sphere(a,r) HAS_SIZE 1 <=> r = &0"
   (REPEAT GEN_TAC THEN CONV_TAC (LAND_CONV HAS_SIZE_CONV) THEN
    REWRITE_TAC [SPHERE_EQ_SING] THEN MESON_TAC [])

  let IMAGE_AFFINITY_CBALL ← prove
   r"!m c a:real^N r.
        IMAGE (\x. m % x + c) (cball(a,r)) =
        if &0 <= r \/ ~(m = &0) then cball(m % a + c,abs m * r) else {}"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"m = &0") THEN ASM_REWRITE_TAC [] THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN
      REWRITE_TAC [REAL_ABS_NUM, REAL_MUL_LZERO] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, CBALL_EQ_EMPTY, ← GSYM REAL_NOT_LE] THEN
      MATCH_MP_TAC (← SET_RULE
        (← q r"~(s = {}) /\ t = {a} ==> IMAGE (\x. a) s = t")) THEN
      ASM_REWRITE_TAC [CBALL_TRIVIAL, CBALL_EQ_EMPTY, REAL_NOT_LT],
      MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      REWRITE_TAC [IN_CBALL, DIST_MUL, ← NORM_ARITH
       (← q r"dist(x + a:real^N,y + a) = dist(x,y)")] THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, ← GSYM REAL_ABS_NZ] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      EXISTS_TAC (← q r"inv(m) % (x - c):real^N") THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV] THEN VECTOR_ARITH_TAC])

  let IMAGE_AFFINITY_BALL ← prove
   r"!m c a:real^N r.
        IMAGE (\x. m % x + c) (ball(a,r)) =
        if ~(m = &0) then ball(m % a + c,abs m * r)
        else if r <= &0 then {} else {c}"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"m = &0") THEN ASM_REWRITE_TAC [] THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN
      REWRITE_TAC [REAL_ABS_NUM, REAL_MUL_LZERO] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, BALL_EQ_EMPTY, ← GSYM REAL_NOT_LT] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"~(s = {}) ==> IMAGE (\x. a) s = {a}")) THEN
      ASM_REWRITE_TAC [BALL_EQ_EMPTY],
      MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      REWRITE_TAC [IN_BALL, DIST_MUL, ← NORM_ARITH
       (← q r"dist(x + a:real^N,y + a) = dist(x,y)")] THEN
      ASM_SIMP_TAC [REAL_LT_LMUL_EQ, ← GSYM REAL_ABS_NZ] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      EXISTS_TAC (← q r"inv(m) % (x - c):real^N") THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV] THEN VECTOR_ARITH_TAC])

  let IMAGE_AFFINITY_SPHERE ← prove
   r"!m c a:real^N r.
        IMAGE (\x. m % x + c) (sphere(a,r)) =
        if &0 <= r \/ ~(m = &0) then sphere(m % a + c,abs m * r) else {}"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"m = &0") THEN ASM_REWRITE_TAC [] THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN
      REWRITE_TAC [REAL_ABS_NUM, REAL_MUL_LZERO] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, SPHERE_EQ_EMPTY, ← GSYM REAL_NOT_LE] THEN
      MATCH_MP_TAC (← SET_RULE
        (← q r"~(s = {}) /\ t = {a} ==> IMAGE (\x. a) s = t")) THEN
      ASM_SIMP_TAC [SPHERE_SING, SPHERE_EQ_EMPTY, REAL_NOT_LT],
      MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      REWRITE_TAC [IN_SPHERE, DIST_MUL, ← NORM_ARITH
       (← q r"dist(x + a:real^N,y + a) = dist(x,y)")] THEN
      ASM_SIMP_TAC [REAL_EQ_MUL_LCANCEL, REAL_ABS_ZERO, ← GSYM REAL_ABS_NZ] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      EXISTS_TAC (← q r"inv(m) % (x - c):real^N") THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV] THEN VECTOR_ARITH_TAC])

  return { CLOSED_CBALL, CLOSURE_CBALL, IN_INTERIOR_CBALL, LIMPT_BALL, CLOSURE_BALL,
           INTERIOR_BALL, INTERIOR_CBALL, FRONTIER_BALL, FRONTIER_CBALL, INTERIOR_SPHERE,
           CBALL_EQ_EMPTY, CBALL_EMPTY, CBALL_EQ_SING, CBALL_SING, SPHERE_SING, SPHERE_EQ_SING,
           HAS_SIZE_SPHERE_1, IMAGE_AFFINITY_CBALL, IMAGE_AFFINITY_BALL, IMAGE_AFFINITY_SPHERE }

/- ------------------------------------------------------------------------- -/
/- Localization in the interior; connected sets are perfect; boundedness,   -/
/- part 1.  (topology.ml 4852-5083)                                          -/
/- ------------------------------------------------------------------------- -/

structure BND1 where
  EVENTUALLY_WITHIN_INTERIOR_INTER : thm
  LIM_WITHIN_INTERIOR_INTER : thm
  LIM_WITHIN_INTERIOR : thm
  CONNECTED_IMP_PERFECT : thm
  CONNECTED_IMP_PERFECT_CLOSED : thm
  CONNECTED_LIMIT_POINTS_EQ_CLOSURE : thm
  CONNECTED_LIMIT_POINTS : thm
  bounded : thm
  MBOUNDED_EUCLIDEAN : thm
  BOUNDED_EMPTY : thm
  BOUNDED_SUBSET : thm
  BOUNDED_INTERIOR : thm
  BOUNDED_CLOSURE : thm
  BOUNDED_CLOSURE_EQ : thm
  BOUNDED_CBALL : thm
  BOUNDED_BALL : thm
  FINITE_IMP_BOUNDED : thm
  BOUNDED_NORM_IMAGE : thm
  BOUNDED_UNION : thm
  BOUNDED_UNIONS : thm
  BOUNDED_POS : thm
  BOUNDED_POS_LT : thm
  BOUNDED_PAIRS : thm
  BOUNDED_PAIRS_POS : thm
  BOUNDED_INTER : thm
  BOUNDED_DIFF : thm
  BOUNDED_INSERT : thm
  BOUNDED_SING : thm
  BOUNDED_DELETE : thm
  BOUNDED_INTERS : thm
  NOT_BOUNDED_UNIV : thm
  NOT_OPEN_SING : thm
  COBOUNDED_IMP_UNBOUNDED : thm
  deriving Inhabited

@[nospecialize]
def setupBND1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BCON : CON) (BLPT : LPT)
    (BINT : INT) (BCLS1 : CLS1) (BEVT : EVT) (BLIM1 : LIM1) (BUNQ : UNQ) (BSEQ : SEQ) :
    ExceptT String IO BND1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        NORM_ARITH, NORM_ARITH_TAC, .. } := D
  let { DE_MORGAN_THM, EMPTY_GSPEC, EQ_TRANS, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FINITE_RULES, FINITE_SING, FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, INTER_SUBSET,
        IN_ELIM_THM, IN_INSERT, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LEFT_IMP_FORALL_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_INSERT_EMPTY,
        NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_MAX, REAL_LT_IMP_LE, REAL_LT_MIN, .. } := D.core4
  let { REAL_NOT_LE, SUBSET, SUBSET_DIFF, .. } := D.core5
  let { UNIONS_0, UNIONS_INSERT, o_THM, .. } := D.core6
  let { DIST_SYM, .. } := D.vec1
  let { NORM_LIFT, NORM_POS_LE, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_CHOOSE_SIZE, dist, .. } := D.vec4
  let { CONNECTED_IN_IMP_PERFECT_GEN, .. } := D.met1
  let { EVENTUALLY_TRUE, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, mbounded, .. } := D.met3
  let { T1_SPACE_EUCLIDEAN, .. } := BEUC
  let { BALL_SUBSET_CBALL, IN_BALL, IN_CBALL, MCBALL_EUCLIDEAN, .. } := BBAL
  let { CLOPEN, CONNECTED_EMPTY, CONNECTED_IN_EUCLIDEAN, .. } := BCON
  let { CLOSED_LIMPT, CLOSED_SING, LIMIT_POINT_FINITE, LIMIT_POINT_IN_DERIVED_SET, .. } := BLPT
  let { INTERIOR_SUBSET, IN_INTERIOR, .. } := BINT
  let { CLOSURE_SUBSET, CONNECTED_CLOSURE, closure, .. } := BCLS1
  let { EVENTUALLY_WITHIN, EVENTUALLY_WITHIN_INTERIOR, .. } := BEVT
  let { tendsto, .. } := BLIM1
  let { LIM_NORM_UBOUND, .. } := BUNQ
  let { CLOSURE_SEQUENTIAL, .. } := BSEQ
  -- @@SCOPE END

  let EVENTUALLY_WITHIN_INTERIOR_INTER ← prove
   r"!p s t x.
        x IN interior s
        ==> (eventually p (at x within s INTER t) <=>
             eventually p (at x within t))"
   (REWRITE_TAC [EVENTUALLY_WITHIN, IN_INTER, IN_INTERIOR] THEN
    REPEAT GEN_TAC THEN SIMP_TAC [SUBSET, IN_BALL, LEFT_IMP_FORALL_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EQ_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min (d:real) e") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [DIST_SYM])

  let LIM_WITHIN_INTERIOR_INTER ← prove
   r"!f l s x.
        x IN interior s
        ==> ((f --> l) (at x within s INTER t) <=> (f --> l) (at x within t))"
   (SIMP_TAC [tendsto, EVENTUALLY_WITHIN_INTERIOR_INTER])

  let LIM_WITHIN_INTERIOR ← prove
   r"!f l s x.
        x IN interior s
        ==> ((f --> l) (at x within s) <=> (f --> l) (at x))"
   (SIMP_TAC [tendsto, EVENTUALLY_WITHIN_INTERIOR])

  let CONNECTED_IMP_PERFECT ← prove
   r"!s x:real^N.
        connected s /\ ~(?a. s = {a}) /\ x IN s ==> x limit_point_of s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean:(real^N)topology", ← q r"s:real^N->bool"]
          CONNECTED_IN_IMP_PERFECT_GEN) THEN
    ASM_REWRITE_TAC [CONNECTED_IN_EUCLIDEAN, T1_SPACE_EUCLIDEAN] THEN
    REWRITE_TAC [LIMIT_POINT_IN_DERIVED_SET] THEN ASM SET_TAC [])

  let CONNECTED_IMP_PERFECT_CLOSED ← prove
   r"!s x. connected s /\ closed s /\ ~(?a. s = {a})
         ==> (x limit_point_of s <=> x IN s)"
   (MESON_TAC [CONNECTED_IMP_PERFECT, CLOSED_LIMPT])

  let CONNECTED_LIMIT_POINTS_EQ_CLOSURE ← prove
   r"!s:real^N->bool.
        connected s /\ ~(?a. s = {a})
        ==> {x | x limit_point_of s} = closure s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [closure] THEN
    REWRITE_TAC [← SET_RULE (← q r"l = s UNION l <=> s SUBSET l")] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    ASM_MESON_TAC [CONNECTED_IMP_PERFECT])

  let CONNECTED_LIMIT_POINTS ← prove
   r"!s:real^N->bool. connected s ==> connected {x | x limit_point_of s}"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"?a:real^N. s = {a}") THENL
     [FIRST_X_ASSUM (CHOOSE_THEN SUBST1_TAC) THEN
      SIMP_TAC [LIMIT_POINT_FINITE, FINITE_SING, EMPTY_GSPEC, CONNECTED_EMPTY],
      ASM_MESON_TAC [CONNECTED_LIMIT_POINTS_EQ_CLOSURE, CONNECTED_CLOSURE]])

  let bounded ← new_definition
   r"bounded s <=> ?a. !x:real^N. x IN s ==> norm(x) <= a"

  let MBOUNDED_EUCLIDEAN ← prove
   r"!s:real^N->bool. mbounded euclidean_metric s <=> bounded s"
   (GEN_TAC THEN REWRITE_TAC [mbounded, bounded, MCBALL_EUCLIDEAN] THEN
    EQ_TAC THEN REWRITE_TAC [SUBSET, IN_CBALL, LEFT_IMP_EXISTS_THM] THENL
     [MAP_EVERY X_GEN_TAC [← q r"c:real^N", ← q r"b:real"] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"norm(c:real^N) + b"),
      X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"vec 0:real^N", ← q r"b:real"]] THEN
    POP_ASSUM MP_TAC THEN MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t))

  let BOUNDED_EMPTY ← prove
   r"bounded {}"
   (REWRITE_TAC [bounded, NOT_IN_EMPTY])

  let BOUNDED_SUBSET ← prove
   r"!s t. bounded t /\ s SUBSET t ==> bounded s"
   (MESON_TAC [bounded, SUBSET])

  let BOUNDED_INTERIOR ← prove
   r"!s:real^N->bool. bounded s ==> bounded(interior s)"
   (MESON_TAC [BOUNDED_SUBSET, INTERIOR_SUBSET])

  let BOUNDED_CLOSURE ← prove
   r"!s:real^N->bool. bounded s ==> bounded(closure s)"
   (REWRITE_TAC [bounded, CLOSURE_SEQUENTIAL] THEN
    GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"y:real^N") THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"x:num->real^N")) THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN
    EXISTS_TAC (← q r"x:num->real^N") THEN
    ASM_SIMP_TAC [EVENTUALLY_TRUE, TRIVIAL_LIMIT_SEQUENTIALLY])

  let BOUNDED_CLOSURE_EQ ← prove
   r"!s:real^N->bool. bounded(closure s) <=> bounded s"
   (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [BOUNDED_CLOSURE] THEN
    MESON_TAC [BOUNDED_SUBSET, CLOSURE_SUBSET])

  let BOUNDED_CBALL ← prove
   r"!x:real^N e. bounded(cball(x,e))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [bounded] THEN
    EXISTS_TAC (← q r"norm(x:real^N) + e") THEN REWRITE_TAC [IN_CBALL, dist] THEN
    NORM_ARITH_TAC)

  let BOUNDED_BALL ← prove
   r"!x e. bounded(ball(x,e))"
   (MESON_TAC [BALL_SUBSET_CBALL, BOUNDED_CBALL, BOUNDED_SUBSET])

  let FINITE_IMP_BOUNDED ← prove
   r"!s:real^N->bool. FINITE s ==> bounded s"
   (MATCH_MP_TAC FINITE_INDUCT_STRONG THEN REWRITE_TAC [BOUNDED_EMPTY] THEN
    REWRITE_TAC [bounded, IN_INSERT] THEN X_GEN_TAC (← q r"x:real^N") THEN GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"B:real")) STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"norm(x:real^N) + abs B") THEN REPEAT STRIP_TAC THEN
    ASM_MESON_TAC [NORM_POS_LE, ← REAL_ARITH
     (← q r"(y <= b /\ &0 <= x ==> y <= x + abs b) /\ x <= x + abs b")])

  let BOUNDED_NORM_IMAGE ← prove
   r"!s:real^N->bool.
        bounded s <=> bounded(IMAGE (lift o norm) s)"
   (REWRITE_TAC [bounded, FORALL_IN_IMAGE, o_THM] THEN
    REWRITE_TAC [NORM_LIFT, REAL_ABS_NORM])

  let BOUNDED_UNION ← prove
   r"!s t. bounded (s UNION t) <=> bounded s /\ bounded t"
   (REWRITE_TAC [bounded, IN_UNION] THEN MESON_TAC [REAL_LE_MAX])

  let BOUNDED_UNIONS ← prove
   r"!f. FINITE f /\ (!s. s IN f ==> bounded s) ==> bounded(UNIONS f)"
   (REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, BOUNDED_EMPTY, IN_INSERT, UNIONS_INSERT] THEN
    MESON_TAC [BOUNDED_UNION])

  let BOUNDED_POS ← prove
   r"!s. bounded s <=> ?b. &0 < b /\ !x. x IN s ==> norm(x) <= b"
   (REWRITE_TAC [bounded] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < &1 + abs(y) /\ (x <= y ==> x <= &1 + abs(y))")])

  let BOUNDED_POS_LT ← prove
   r"!s. bounded s <=> ?b. &0 < b /\ !x. x IN s ==> norm(x) < b"
   (REWRITE_TAC [bounded] THEN
    MESON_TAC [REAL_LT_IMP_LE,
               ← REAL_ARITH (← q r"&0 < &1 + abs(y) /\ (x <= y ==> x < &1 + abs(y))")])

  let BOUNDED_PAIRS ← prove
   r"!s:real^N->bool.
        bounded s <=> ?B. !x y. x IN s /\ y IN s ==> dist(x,y) <= B"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [BOUNDED_EMPTY, NOT_IN_EMPTY] THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"a:real^N") o
      REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [bounded] THEN EQ_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THENL
     [EXISTS_TAC (← q r"&2 * B") THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"y:real^N") th) THEN
              MP_TAC (← SPEC (← q r"x:real^N") th))) THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t),
      EXISTS_TAC (← q r"B + norm(a:real^N)") THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^N", ← q r"x:real^N"]) THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t)])

  let BOUNDED_PAIRS_POS ← prove
   r"!s:real^N->bool.
        bounded s <=> ?B. &0 < B /\ !x y. x IN s /\ y IN s ==> dist(x,y) <= B"
   (REWRITE_TAC [BOUNDED_PAIRS] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < &1 + abs(y) /\ (x <= y ==> x <= &1 + abs(y))")])

  let BOUNDED_INTER ← prove
   r"!s t. bounded s \/ bounded t ==> bounded (s INTER t)"
   (MESON_TAC [BOUNDED_SUBSET, INTER_SUBSET])

  let BOUNDED_DIFF ← prove
   r"!s t. bounded s ==> bounded (s DIFF t)"
   (MESON_TAC [BOUNDED_SUBSET, SUBSET_DIFF])

  let BOUNDED_INSERT ← prove
   r"!x s. bounded(x INSERT s) <=> bounded s"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"x INSERT s = {x} UNION s")] THEN
    SIMP_TAC [BOUNDED_UNION, FINITE_IMP_BOUNDED, FINITE_RULES])

  let BOUNDED_SING ← prove
   r"!a. bounded {a}"
   (REWRITE_TAC [BOUNDED_INSERT, BOUNDED_EMPTY])

  let BOUNDED_DELETE ← prove
   r"!x:real^N s. bounded(s DELETE x) <=> bounded s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"~(x IN s) ==> s DELETE x = s")] THEN
    TRANS_TAC EQ_TRANS (← q r"bounded((x:real^N) INSERT (s DELETE x))") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [BOUNDED_INSERT], AP_TERM_TAC THEN ASM SET_TAC []])

  let BOUNDED_INTERS ← prove
   r"!f:(real^N->bool)->bool.
        (?s:real^N->bool. s IN f /\ bounded s) ==> bounded(INTERS f)"
   (REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN REPEAT GEN_TAC THEN
    DISCH_TAC THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BOUNDED_SUBSET) THEN
    ASM SET_TAC [])

  let NOT_BOUNDED_UNIV ← prove
   r"~(bounded (:real^N))"
   (REWRITE_TAC [BOUNDED_POS, NOT_FORALL_THM, NOT_EXISTS_THM, IN_UNIV,
                 DE_MORGAN_THM, REAL_NOT_LE] THEN
    X_GEN_TAC (← q r"B:real") THEN ASM_CASES_TAC (← q r"&0 < B") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← SPEC (← q r"B + &1") VECTOR_CHOOSE_SIZE) THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < B ==> &0 <= B + &1")] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REAL_ARITH_TAC)

  let NOT_OPEN_SING ← prove
   r"!a:real^N. ~(open {a})"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q r"{a:real^N}") CLOPEN) THEN
    REWRITE_TAC [NOT_INSERT_EMPTY, CLOSED_SING] THEN
    DISCH_THEN SUBST1_TAC THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"bounded:(real^N->bool)->bool")) THEN
    REWRITE_TAC [BOUNDED_SING, NOT_BOUNDED_UNIV])

  let COBOUNDED_IMP_UNBOUNDED ← prove
   r"!s. bounded((:real^N) DIFF s) ==> ~bounded s"
   (GEN_TAC THEN REWRITE_TAC [← TAUT (← q r"a ==> ~b <=> ~(a /\ b)")] THEN
    REWRITE_TAC [← GSYM BOUNDED_UNION, ← SET_RULE (← q r"UNIV DIFF s UNION s = UNIV")] THEN
    REWRITE_TAC [NOT_BOUNDED_UNIV])

  return { EVENTUALLY_WITHIN_INTERIOR_INTER, LIM_WITHIN_INTERIOR_INTER, LIM_WITHIN_INTERIOR,
           CONNECTED_IMP_PERFECT, CONNECTED_IMP_PERFECT_CLOSED, CONNECTED_LIMIT_POINTS_EQ_CLOSURE,
           CONNECTED_LIMIT_POINTS, bounded, MBOUNDED_EUCLIDEAN, BOUNDED_EMPTY, BOUNDED_SUBSET,
           BOUNDED_INTERIOR, BOUNDED_CLOSURE, BOUNDED_CLOSURE_EQ, BOUNDED_CBALL, BOUNDED_BALL,
           FINITE_IMP_BOUNDED, BOUNDED_NORM_IMAGE, BOUNDED_UNION, BOUNDED_UNIONS, BOUNDED_POS,
           BOUNDED_POS_LT, BOUNDED_PAIRS, BOUNDED_PAIRS_POS, BOUNDED_INTER, BOUNDED_DIFF,
           BOUNDED_INSERT, BOUNDED_SING, BOUNDED_DELETE, BOUNDED_INTERS, NOT_BOUNDED_UNIV,
           NOT_OPEN_SING, COBOUNDED_IMP_UNBOUNDED }

/- ------------------------------------------------------------------------- -/
/- Boundedness, part 2; sups and infs using "bounded".                      -/
/- (topology.ml 5084-5321)                                                   -/
/- ------------------------------------------------------------------------- -/

structure BND2 where
  BOUNDED_LINEAR_IMAGE : thm
  BOUNDED_LINEAR_IMAGE_EQ : thm
  BOUNDED_SCALING : thm
  BOUNDED_NEGATIONS : thm
  BOUNDED_TRANSLATION : thm
  BOUNDED_TRANSLATION_EQ : thm
  BOUNDED_SCALING_EQ : thm
  BOUNDED_AFFINITY_EQ : thm
  BOUNDED_AFFINITY : thm
  BOUNDED_DIFFS : thm
  BOUNDED_SUMS : thm
  BOUNDED_SUMS_IMAGE : thm
  BOUNDED_SUMS_IMAGES : thm
  BOUNDED_SUBSET_BALL : thm
  BOUNDED_SUBSET_CBALL : thm
  UNBOUNDED_INTER_COBOUNDED : thm
  COBOUNDED_INTER_UNBOUNDED : thm
  SUBSPACE_BOUNDED_EQ_TRIVIAL : thm
  BOUNDED_COMPONENTWISE : thm
  BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC : thm
  BOUNDED_SUBSET_OPEN_INTERVAL : thm
  BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC : thm
  BOUNDED_SUBSET_CLOSED_INTERVAL : thm
  BOUNDED_LIFT : thm
  BOUNDED_HAS_SUP : thm
  SUP_INSERT : thm
  BOUNDED_HAS_INF : thm
  INF_INSERT : thm
  deriving Inhabited

@[nospecialize]
def setupBND2 [HolBase] (D : TopologyDeps) (BBAL : BAL) (BBND1 : BND1) :
    ExceptT String IO BND2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, VECTOR_ARITH, NORM_ARITH, NORM_ARITH_TAC, LINEAR_INVARIANT_RULE,
        add_linear_invariants, add_translation_invariants, .. } := D
  let { CONTRAPOS_THM, DIMINDEX_GE_1, FINITE_INDUCT_STRONG, FINITE_NUMSEG, .. } := D.core1
  let { FINITE_RULES, FORALL_IN_IMAGE, IMAGE_CONST, IMAGE_EQ_EMPTY, IMAGE_ID, IMAGE_o, IMP_CONJ,
        IMP_CONJ_ALT, INF, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_NUMSEG, IN_SING, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP,
        NOT_EXISTS_THM, NOT_LT, NUMSEG_EMPTY, REAL_ABS_DIV, .. } := D.core3
  let { REAL_BOUNDS_LT, REAL_DIV_RMUL, REAL_INF_UNIQUE, REAL_LET_TRANS, REAL_LE_LMUL_EQ,
        REAL_LE_MAX, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_MAX, REAL_LT_MUL, .. } :=
    D.core4
  let { REAL_MIN_LE, REAL_MIN_LT, REAL_MUL_LINV, REAL_NOT_LT, REAL_POS, REAL_SUP_UNIQUE,
        RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_TRANS, .. } := D.core5
  let { SUM_LE, SUM_LT_ALL, SUM_POS_LE_NUMSEG, SUP, o_DEF, .. } := D.core6
  let { AFFINITY_SCALING_TRANSLATION, COMPONENT_LE_NORM, FORALL_LIFT, .. } := D.vec1
  let { IN_INTERVAL, LIFT_IN_IMAGE_LIFT, LINEAR_BOUNDED_POS, LINEAR_COMPOSE_CMUL, LINEAR_ID,
        .. } := D.vec2
  let { NORM_EQ_0, NORM_LE_L1, NORM_LIFT, NORM_MUL, NORM_POS_LE, REAL_ABS_NORM, SUBSPACE_0,
        SUBSPACE_MUL, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LNEG, VECTOR_MUL_LZERO,
        VECTOR_NEG_COMPONENT, VSUM_CLAUSES, .. } := D.vec4
  let { BALL_SUBSET_CBALL, IN_BALL, .. } := BBAL
  let { BOUNDED_EMPTY, BOUNDED_POS, BOUNDED_SING, BOUNDED_SUBSET, FINITE_IMP_BOUNDED, bounded,
        .. } := BBND1
  -- @@SCOPE END

  let BOUNDED_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s. bounded s /\ linear f ==> bounded(IMAGE f s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [BOUNDED_POS] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"B1:real")) MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B2:real") o MATCH_MP LINEAR_BOUNDED_POS) THEN
    EXISTS_TAC (← q r"B2 * B1") THEN ASM_SIMP_TAC [REAL_LT_MUL, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"B2 * norm(x:real^M)") THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ])

  let BOUNDED_LINEAR_IMAGE_EQ ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (bounded (IMAGE f s) <=> bounded s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE BOUNDED_LINEAR_IMAGE))

  add_linear_invariants [BOUNDED_LINEAR_IMAGE_EQ]

  let BOUNDED_SCALING ← prove
   r"!c s. bounded s ==> bounded (IMAGE (\x. c % x) s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BOUNDED_LINEAR_IMAGE THEN
    ASM_SIMP_TAC [LINEAR_COMPOSE_CMUL, LINEAR_ID])

  let BOUNDED_NEGATIONS ← prove
   r"!s. bounded s ==> bounded (IMAGE (--) s)"
   (GEN_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"-- &1") o MATCH_MP BOUNDED_SCALING) THEN
    REWRITE_TAC [bounded, IN_IMAGE, VECTOR_MUL_LNEG, VECTOR_MUL_LID])

  let BOUNDED_TRANSLATION ← prove
   r"!a:real^N s. bounded s ==> bounded (IMAGE (\x. a + x) s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN
    EXISTS_TAC (← q r"B + norm(a:real^N)") THEN POP_ASSUM MP_TAC THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL [NORM_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [] THEN NORM_ARITH_TAC)

  let BOUNDED_TRANSLATION_EQ ← prove
   r"!a s. bounded (IMAGE (\x:real^N. a + x) s) <=> bounded s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [BOUNDED_TRANSLATION] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"--a:real^N") o MATCH_MP BOUNDED_TRANSLATION) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, IMAGE_ID,
                 ← VECTOR_ARITH (← q r"--a + a + x:real^N = x")])

  add_translation_invariants [BOUNDED_TRANSLATION_EQ]

  let BOUNDED_SCALING_EQ ← prove
   r"!s:real^N->bool c. bounded (IMAGE (\x. c % x) s) <=> c = &0 \/ bounded s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      MESON_TAC [BOUNDED_SING, BOUNDED_EMPTY],
      EQ_TAC THEN REWRITE_TAC [BOUNDED_SCALING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP BOUNDED_SCALING) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, IMAGE_ID]])

  let BOUNDED_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        bounded (IMAGE (\x. m % x + c) s) <=> m = &0 \/ bounded s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, BOUNDED_TRANSLATION_EQ,
                 BOUNDED_SCALING_EQ, IMAGE_o])

  let BOUNDED_AFFINITY ← prove
   r"!s m c:real^N. bounded s ==> bounded (IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [BOUNDED_AFFINITY_EQ])

  let BOUNDED_DIFFS ← prove
   r"!s t:real^N->bool.
        bounded s /\ bounded t ==> bounded {x - y | x IN s /\ y IN t}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [BOUNDED_POS] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_TAC (← q r"B:real")) (X_CHOOSE_TAC (← q r"C:real"))) THEN
    EXISTS_TAC (← q r"B + C:real") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, REPEAT STRIP_TAC] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← NORM_ARITH
     (← q r"norm x <= a /\ norm y <= b ==> norm(x - y) <= a + b")) THEN
    ASM_SIMP_TAC [])

  let BOUNDED_SUMS ← prove
   r"!s t:real^N->bool.
        bounded s /\ bounded t ==> bounded {x + y | x IN s /\ y IN t}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [BOUNDED_POS] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_TAC (← q r"B:real")) (X_CHOOSE_TAC (← q r"C:real"))) THEN
    EXISTS_TAC (← q r"B + C:real") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, REPEAT STRIP_TAC] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← NORM_ARITH
     (← q r"norm x <= a /\ norm y <= b ==> norm(x + y) <= a + b")) THEN
    ASM_SIMP_TAC [])

  let BOUNDED_SUMS_IMAGE ← prove
   r"!f g t. bounded {f x | x IN t} /\ bounded {g x | x IN t}
           ==> bounded {f x + g x | x IN t}"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP BOUNDED_SUMS) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BOUNDED_SUBSET) THEN
    SET_TAC [])

  let BOUNDED_SUMS_IMAGES ← prove
   r"!f:A->B->real^N t s.
        FINITE s /\
        (!a. a IN s ==> bounded {f x a | x IN t})
        ==> bounded { vsum s (f x) | x IN t}"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [VSUM_CLAUSES] THEN CONJ_TAC THENL
     [DISCH_THEN (K ALL_TAC : thm → tactic) THEN MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"{vec 0:real^N}") THEN
      SIMP_TAC [FINITE_IMP_BOUNDED, FINITE_RULES] THEN SET_TAC [],
      ALL_TAC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC BOUNDED_SUMS_IMAGE THEN
    ASM_SIMP_TAC [IN_INSERT])

  let BOUNDED_SUBSET_BALL ← prove
   r"!s x:real^N. bounded(s) ==> ?r. &0 < r /\ s SUBSET ball(x,r)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [BOUNDED_POS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"&2 * B + norm(x:real^N)") THEN
    ASM_SIMP_TAC [NORM_POS_LE, ← REAL_ARITH
      (← q r"&0 < B /\ &0 <= x ==> &0 < &2 * B + x")] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN ASM_REWRITE_TAC [IN_BALL] THEN
    UNDISCH_TAC (← q r"&0 < B") THEN NORM_ARITH_TAC)

  let BOUNDED_SUBSET_CBALL ← prove
   r"!s x:real^N. bounded(s) ==> ?r. &0 < r /\ s SUBSET cball(x,r)"
   (MESON_TAC [BOUNDED_SUBSET_BALL, SUBSET_TRANS, BALL_SUBSET_CBALL])

  let UNBOUNDED_INTER_COBOUNDED ← prove
   r"!s t. ~bounded s /\ bounded((:real^N) DIFF t) ==> ~(s INTER t = {})"
   (REWRITE_TAC [← SET_RULE (← q r"s INTER t = {} <=> s SUBSET (:real^N) DIFF t")] THEN
    MESON_TAC [BOUNDED_SUBSET])

  let COBOUNDED_INTER_UNBOUNDED ← prove
   r"!s t. bounded((:real^N) DIFF s) /\ ~bounded t ==> ~(s INTER t = {})"
   (REWRITE_TAC [← SET_RULE (← q r"s INTER t = {} <=> t SUBSET (:real^N) DIFF s")] THEN
    MESON_TAC [BOUNDED_SUBSET])

  let SUBSPACE_BOUNDED_EQ_TRIVIAL ← prove
   r"!s:real^N->bool. subspace s ==> (bounded s <=> s = {vec 0})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [BOUNDED_SING] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(s = {a}) ==> a IN s ==> ?b. b IN s /\ ~(b = a)"))) THEN
    ASM_SIMP_TAC [SUBSPACE_0] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [bounded, NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"B:real") THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(B + &1) / norm v % v:real^N")) THEN
    ASM_SIMP_TAC [SUBSPACE_MUL, NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
    ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0] THEN REAL_ARITH_TAC)

  let BOUNDED_COMPONENTWISE ← prove
   r"!s:real^N->bool.
        bounded s <=> !i. 1 <= i /\ i <= dimindex(:N)
                          ==> bounded (IMAGE (\x. lift(x$i)) s)"
   (GEN_TAC THEN REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE, NORM_LIFT] THEN
    EQ_TAC THENL [ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS], ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    SIMP_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"b:num->real") THEN
    DISCH_TAC THEN EXISTS_TAC (← q r"sum(1..dimindex(:N)) b") THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC (← q r"sum(1..dimindex(:N)) (\i. &0)") THEN
      SIMP_TAC [SUM_POS_LE_NUMSEG, REAL_POS] THEN
      MATCH_MP_TAC SUM_LT_ALL THEN
      ASM_SIMP_TAC [IN_NUMSEG, FINITE_NUMSEG, NUMSEG_EMPTY] THEN
      REWRITE_TAC [NOT_LT, DIMINDEX_GE_1],
      REPEAT STRIP_TAC THEN
      W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      MATCH_MP_TAC SUM_LE THEN ASM_SIMP_TAC [IN_NUMSEG, FINITE_NUMSEG]])

  let BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC ← prove
   r"!s:real^N->bool. bounded s ==> ?a. s SUBSET interval(--a,a)"
   (REWRITE_TAC [BOUNDED_POS, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"B:real"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(lambda i. B + &1):real^N") THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SIMP_TAC [IN_INTERVAL, LAMBDA_BETA, REAL_BOUNDS_LT, VECTOR_NEG_COMPONENT] THEN
    ASM_MESON_TAC [COMPONENT_LE_NORM,
                   ← REAL_ARITH (← q r"x <= y ==> a <= x ==> a < y + &1")])

  let BOUNDED_SUBSET_OPEN_INTERVAL ← prove
   r"!s:real^N->bool. bounded s ==> ?a b. s SUBSET interval(a,b)"
   (MESON_TAC [BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC])

  let BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC ← prove
   r"!s:real^N->bool. bounded s ==> ?a. s SUBSET interval[--a,a]"
   (GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC) THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    SIMP_TAC [IN_BALL, IN_INTERVAL, SUBSET, REAL_LT_IMP_LE])

  let BOUNDED_SUBSET_CLOSED_INTERVAL ← prove
   r"!s:real^N->bool. bounded s ==> ?a b. s SUBSET interval[a,b]"
   (MESON_TAC [BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC])

  let BOUNDED_LIFT ← prove
   r"!s. bounded(IMAGE lift s) <=>  ?a. !x. x IN s ==> abs(x) <= a"
   (REWRITE_TAC [bounded, FORALL_LIFT, NORM_LIFT, LIFT_IN_IMAGE_LIFT])

  let BOUNDED_HAS_SUP ← prove
   r"!s. bounded(IMAGE lift s) /\ ~(s = {})
       ==> (!x. x IN s ==> x <= sup s) /\
           (!b. (!x. x IN s ==> x <= b) ==> sup s <= b)"
   (REWRITE_TAC [BOUNDED_LIFT, IMAGE_EQ_EMPTY] THEN
    MESON_TAC [SUP, ← REAL_ARITH (← q r"abs(x) <= a ==> x <= a")])

  let SUP_INSERT ← prove
   r"!x s. bounded (IMAGE lift s)
         ==> sup(x INSERT s) = if s = {} then x else max x (sup s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_SUP_UNIQUE THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_SING] THENL
     [MESON_TAC [REAL_LE_REFL], ALL_TAC] THEN
    REWRITE_TAC [REAL_LE_MAX, REAL_LT_MAX, IN_INSERT] THEN
    MP_TAC (← ISPEC (← q r"s:real->bool") BOUNDED_HAS_SUP) THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN ASM_MESON_TAC [REAL_LE_REFL, REAL_NOT_LT])

  let BOUNDED_HAS_INF ← prove
   r"!s. bounded(IMAGE lift s) /\ ~(s = {})
       ==> (!x. x IN s ==> inf s <= x) /\
           (!b. (!x. x IN s ==> b <= x) ==> b <= inf s)"
   (REWRITE_TAC [BOUNDED_LIFT, IMAGE_EQ_EMPTY] THEN
    MESON_TAC [INF, ← REAL_ARITH (← q r"abs(x) <= a ==> --a <= x")])

  let INF_INSERT ← prove
   r"!x s. bounded (IMAGE lift s)
         ==> inf(x INSERT s) = if s = {} then x else min x (inf s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INF_UNIQUE THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_SING] THENL
     [MESON_TAC [REAL_LE_REFL], ALL_TAC] THEN
    REWRITE_TAC [REAL_MIN_LE, REAL_MIN_LT, IN_INSERT] THEN
    MP_TAC (← ISPEC (← q r"s:real->bool") BOUNDED_HAS_INF) THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN ASM_MESON_TAC [REAL_LE_REFL, REAL_NOT_LT])

  return { BOUNDED_LINEAR_IMAGE, BOUNDED_LINEAR_IMAGE_EQ, BOUNDED_SCALING, BOUNDED_NEGATIONS,
           BOUNDED_TRANSLATION, BOUNDED_TRANSLATION_EQ, BOUNDED_SCALING_EQ, BOUNDED_AFFINITY_EQ,
           BOUNDED_AFFINITY, BOUNDED_DIFFS, BOUNDED_SUMS, BOUNDED_SUMS_IMAGE,
           BOUNDED_SUMS_IMAGES, BOUNDED_SUBSET_BALL, BOUNDED_SUBSET_CBALL,
           UNBOUNDED_INTER_COBOUNDED, COBOUNDED_INTER_UNBOUNDED, SUBSPACE_BOUNDED_EQ_TRIVIAL,
           BOUNDED_COMPONENTWISE, BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC,
           BOUNDED_SUBSET_OPEN_INTERVAL, BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC,
           BOUNDED_SUBSET_CLOSED_INTERVAL, BOUNDED_LIFT, BOUNDED_HAS_SUP, SUP_INSERT,
           BOUNDED_HAS_INF, INF_INSERT }

/- ------------------------------------------------------------------------- -/
/- Subset and overlapping relations on balls.  (topology.ml 5322-5393)       -/
/- ------------------------------------------------------------------------- -/

structure BLS where
  SUBSET_BALLS : thm
  INTER_BALLS_EQ_EMPTY : thm
  deriving Inhabited

@[nospecialize]
def setupBLS [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCLS1 : CLS1) (BCBL : CBL) :
    ExceptT String IO BLS := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, REAL_ARITH, SET_RULE, VECTOR_ARITH, NORM_ARITH, NORM_ARITH_TAC,
        GEOM_BASIS_MULTIPLE_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { AND_FORALL_THM, DIMINDEX_GE_1, EXTENSION, .. } := D.core1
  let { IN_INTER, .. } := D.core2
  let { LE_REFL, NOT_IN_EMPTY, REAL_ABS_DIV, REAL_ADD_RDISTRIB, .. } := D.core3
  let { REAL_DIV_RMUL, REAL_LE_DIV, .. } := D.core4
  let { REAL_MUL_RID, REAL_NOT_LE, REAL_NOT_LT, REAL_POS, SUBSET, .. } := D.core5
  let { real_abs, .. } := D.core6
  let { DIST_0, .. } := D.vec1
  let { NORM_BASIS, NORM_EQ_0, NORM_MUL, NORM_NEG, NORM_POS_LE, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_SUB_LZERO, VECTOR_SUB_RDISTRIB, dist, .. } := D.vec4
  let { BALL_EQ_EMPTY, IN_BALL, IN_CBALL, .. } := BBAL
  let { CLOSURE_CLOSED, SUBSET_CLOSURE, .. } := BCLS1
  let { CBALL_EQ_EMPTY, CLOSED_CBALL, CLOSURE_BALL, .. } := BCBL
  -- @@SCOPE END

  let SUBSET_BALLS ← do
    let lemma ← prove
     r"(!a':real^N r r'.
         cball(a,r) SUBSET cball(a',r') <=> dist(a,a') + r <= r' \/ r < &0) /\
       (!a':real^N r r'.
         cball(a,r) SUBSET ball(a',r') <=> dist(a,a') + r < r' \/ r < &0)"
     (CONJ_TAC THEN
      (GEOM_ORIGIN_TAC (← q r"a':real^N") THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [SUBSET, IN_CBALL, IN_BALL] THEN
      EQ_TAC THENL [REWRITE_TAC [DIST_0], NORM_ARITH_TAC] THEN
      DISJ_CASES_TAC (← REAL_ARITH (← q r"r < &0 \/ &0 <= r")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN DISJ1_TAC THEN
      ASM_CASES_TAC (← q r"a:real^N = vec 0") THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r % basis 1:real^N")) THEN
        ASM_SIMP_TAC [DIST_0, NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL],
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(&1 + r / norm(a)) % a:real^N")) THEN
        SIMP_TAC [dist, ← VECTOR_ARITH (← q r"a - (&1 + x) % a:real^N = --(x % a)")] THEN
        ASM_SIMP_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM, NORM_NEG, REAL_POS,
                      REAL_LE_DIV, NORM_POS_LE, REAL_ADD_RDISTRIB, REAL_DIV_RMUL,
                  NORM_EQ_0, ← REAL_ARITH (← q r"&0 <= x ==> abs(&1 + x) = &1 + x")]] THEN
      UNDISCH_TAC (← q r"&0 <= r") THEN NORM_ARITH_TAC))
    let tac : tactic := DISCH_THEN (MP_TAC o MATCH_MP SUBSET_CLOSURE) THEN
              ASM_SIMP_TAC [CLOSED_CBALL, CLOSURE_CLOSED, CLOSURE_BALL]
    prove
     r"(!a a':real^N r r'.
        ball(a,r) SUBSET ball(a',r') <=> dist(a,a') + r <= r' \/ r <= &0) /\
     (!a a':real^N r r'.
        ball(a,r) SUBSET cball(a',r') <=> dist(a,a') + r <= r' \/ r <= &0) /\
     (!a a':real^N r r'.
        cball(a,r) SUBSET ball(a',r') <=> dist(a,a') + r < r' \/ r < &0) /\
     (!a a':real^N r r'.
        cball(a,r) SUBSET cball(a',r') <=> dist(a,a') + r <= r' \/ r < &0)"
     (REWRITE_TAC [AND_FORALL_THM] THEN GEOM_ORIGIN_TAC (← q r"a':real^N") THEN
      REPEAT STRIP_TAC THEN
      (EQ_TAC THENL
        [ALL_TAC, REWRITE_TAC [SUBSET, IN_BALL, IN_CBALL] THEN NORM_ARITH_TAC]) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(s = {} <=> q) /\ (s SUBSET t /\ ~(s = {}) /\ ~(t = {}) ==> p)
        ==> s SUBSET t ==> p \/ q")) THEN
      REWRITE_TAC [BALL_EQ_EMPTY, CBALL_EQ_EMPTY, REAL_NOT_LE, REAL_NOT_LT] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THENL
       [tac, tac, ALL_TAC, ALL_TAC] THEN REWRITE_TAC [lemma] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN NORM_ARITH_TAC)

  let INTER_BALLS_EQ_EMPTY ← prove
   r"(!a b:real^N r s. ball(a,r) INTER ball(b,s) = {} <=>
                     r <= &0 \/ s <= &0 \/ r + s <= dist(a,b)) /\
   (!a b:real^N r s. ball(a,r) INTER cball(b,s) = {} <=>
                     r <= &0 \/ s < &0 \/ r + s <= dist(a,b)) /\
   (!a b:real^N r s. cball(a,r) INTER ball(b,s) = {} <=>
                     r < &0 \/ s <= &0 \/ r + s <= dist(a,b)) /\
   (!a b:real^N r s. cball(a,r) INTER cball(b,s) = {} <=>
                     r < &0 \/ s < &0 \/ r + s < dist(a,b))"
   (REPEAT STRIP_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    GEOM_BASIS_MULTIPLE_TAC 1 (← q r"b:real^N") THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_INTER, IN_CBALL, IN_BALL] THEN
    (EQ_TAC THENL
      [ALL_TAC,
       SPEC_TAC (← q r"b % basis 1:real^N", ← q r"v:real^N") THEN
       CONV_TAC (fun t => NORM_ARITH t)]) THEN
    DISCH_THEN (MP_TAC o GEN (← q r"c:real") o SPEC (← q r"c % basis 1:real^N")) THEN
    SIMP_TAC [NORM_MUL, NORM_BASIS, LE_REFL, DIMINDEX_GE_1, dist, NORM_NEG,
              VECTOR_SUB_LZERO, ← GSYM VECTOR_SUB_RDISTRIB, REAL_MUL_RID] THEN
    ASM_REWRITE_TAC [real_abs] THEN REWRITE_TAC [← GSYM real_abs] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"min b r:real") th) THEN
            MP_TAC (← SPEC (← q r"max (&0) (b - s:real)") th) THEN
            MP_TAC (← SPEC (← q r"(r + (b - s)) / &2") th))) THEN
    ASM_REAL_ARITH_TAC)

  return { SUBSET_BALLS, INTER_BALLS_EQ_EMPTY }

/- ------------------------------------------------------------------------- -/
/- Compactness (the definition is the one based on convegent subsequences). -/
/- (topology.ml 5394-5623)                                                   -/
/- ------------------------------------------------------------------------- -/

structure CPT where
  compact : thm
  COMPACT_IN_EUCLIDEAN : thm
  COMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY : thm
  COMPACT_IMP_CLOSED : thm
  COMPACT_IMP_BOUNDED : thm
  COMPACT_INTERVAL : thm
  BOUNDED_CLOSED_IMP_COMPACT : thm
  COMPACT_EQ_BOUNDED_CLOSED : thm
  NOT_COMPACT_UNIV : thm
  COMPACT_CLOSURE : thm
  CLOSED_IN_COMPACT : thm
  CLOSED_IN_COMPACT_EQ : thm
  COMPACT_EQ_HEINE_BOREL : thm
  COMPACT_IMP_HEINE_BOREL : thm
  COMPACT_EQ_BOLZANO_WEIERSTRASS : thm
  BOLZANO_WEIERSTRASS_IMP_CLOSED : thm
  COMPACT_IMP_TOTALLY_BOUNDED : thm
  HEINE_BOREL_LEMMA : thm
  HEINE_BOREL_IMP_BOLZANO_WEIERSTRASS : thm
  BOLZANO_WEIERSTRASS_IMP_BOUNDED : thm
  COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY : thm
  COMPACT_EQ_HEINE_BOREL_GEN : thm
  BOUNDED_EQ_BOLZANO_WEIERSTRASS : thm
  BOLZANO_WEIERSTRASS : thm
  BOUNDED_EQ_TOTALLY_BOUNDED : thm
  deriving Inhabited

@[nospecialize]
def setupCPT [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BCWL : CWL) (BBAL : BAL)
    (BLOC : LOC) (BLPT : LPT) (BCLS1 : CLS1) (BLIM1 : LIM1) (BBND1 : BND1) (BBND2 : BND2) :
    ExceptT String IO CPT := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, .. } := D
  let { CART_EQ, EXTENSIONAL, .. } := D.core1
  let { IMP_CONJ, INTER_UNIV, IN_ELIM_THM, IN_INTER, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET_REFL, SUBSET_TRANS, SUBSET_UNIV, .. } := D.core5
  let { UNIONS_SUBSET, cartesian_product, .. } := D.core6
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { IN_INTERVAL, .. } := D.vec2
  let { CLOSED_COMPACT_IN, COMPACT_CLOSURE_OF_EQ_BOLZANO_WEIERSTRASS,
        COMPACT_CLOSURE_OF_IMP_TOTALLY_BOUNDED_IN, COMPACT_IN_ABSOLUTE,
        COMPACT_IN_CARTESIAN_PRODUCT, COMPACT_IN_EQ_BOLZANO_WEIERSTRASS,
        COMPACT_IN_EUCLIDEANREAL_INTERVAL, COMPACT_IN_IMP_CLOSED_IN, COMPACT_IN_IMP_MBOUNDED,
        COMPACT_IN_IMP_TOTALLY_BOUNDED_IN, COMPACT_IN_SEQUENTIALLY, COMPACT_IN_SUBSPACE,
        CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := D.met1
  let { HAUSDORFF_SPACE_MTOPOLOGY, IMAGE_COMPACT_IN, LEBESGUE_NUMBER, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY,
        TOTALLY_BOUNDED_IN_IMP_MBOUNDED, compact_in, totally_bounded_in, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_IN, TOPSPACE_EUCLIDEAN,
        TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_IN, CLOSED_IN_EUCLIDEAN, .. } := BCLO
  let { CONTINUOUS_MAP_COMPONENTWISE_REAL, .. } := BCWL
  let { MBALL_EUCLIDEAN, .. } := BBAL
  let { CLOSED_IN_CLOSED_EQ, .. } := BLOC
  let { LIMIT_POINT_IN_DERIVED_SET, .. } := BLPT
  let { CLOSED_CLOSURE, CLOSURE_SUBSET, EUCLIDEAN_CLOSURE_OF, .. } := BCLS1
  let { LIMIT_EUCLIDEAN, .. } := BLIM1
  let { BOUNDED_CLOSURE_EQ, BOUNDED_SUBSET, MBOUNDED_EUCLIDEAN, NOT_BOUNDED_UNIV, .. } := BBND1
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := BBND2
  -- @@SCOPE END

  let compact ← new_definition
   r"compact s <=>
        !f:num->real^N.
            (!n. f(n) IN s)
            ==> ?l r. l IN s /\ (!m n:num. m < n ==> r(m) < r(n)) /\
                      ((f o r) --> l) sequentially"

  let COMPACT_IN_EUCLIDEAN ← prove
   r"!s:real^N->bool. compact_in euclidean s <=> compact s"
   (REWRITE_TAC [compact, ← GSYM LIMIT_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, COMPACT_IN_SEQUENTIALLY] THEN
    REWRITE_TAC [compact, EUCLIDEAN_METRIC, SUBSET_UNIV])

  let COMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY ← prove
   r"!s:real^N->bool. compact_space (subtopology euclidean s) <=> compact s"
   (REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN, COMPACT_IN_SUBSPACE] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let COMPACT_IMP_CLOSED ← prove
   r"!s. compact s ==> closed s"
   (GEN_TAC THEN REWRITE_TAC [CLOSED_IN, ← GSYM COMPACT_IN_EUCLIDEAN] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] COMPACT_IN_IMP_CLOSED_IN) THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [HAUSDORFF_SPACE_MTOPOLOGY])

  let COMPACT_IMP_BOUNDED ← prove
   r"!s. compact s ==> bounded s"
   (REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN, ← GSYM MBOUNDED_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, COMPACT_IN_IMP_MBOUNDED])

  let COMPACT_INTERVAL ← prove
   r"!a b:real^N. compact(interval[a,b])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN] THEN
    SUBGOAL_THEN
      (← q r"interval[a:real^N,b] = IMAGE (\x. lambda i. x i)
       (cartesian_product (1..dimindex(:N)) (\i. real_interval[a$i,b$i]))")
    SUBST1_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"!g. (!x. x IN s ==> f x IN t) /\ (!y. y IN t ==> g y IN s /\ f(g y) = y)
            ==> t = IMAGE f s")) THEN
      EXISTS_TAC (← q r"\(x:real^N) i. if i IN 1..dimindex(:N) then x$i else ARB") THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM, EXTENSIONAL] THEN
      SIMP_TAC [IN_INTERVAL, LAMBDA_BETA, IN_REAL_INTERVAL, IN_NUMSEG, CART_EQ],
      MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      EXISTS_TAC (← q r"product_topology (1..dimindex(:N)) (\i. euclideanreal)") THEN
      SIMP_TAC [COMPACT_IN_CARTESIAN_PRODUCT, CONTINUOUS_MAP_PRODUCT_PROJECTION,
                IN_NUMSEG, CONTINUOUS_MAP_COMPONENTWISE_REAL, LAMBDA_BETA,
                COMPACT_IN_EUCLIDEANREAL_INTERVAL, TOPSPACE_EUCLIDEAN,
                SUBSET_UNIV, TOPSPACE_PRODUCT_TOPOLOGY]])

  let BOUNDED_CLOSED_IMP_COMPACT ← prove
   r"!s:real^N->bool. bounded s /\ closed s ==> compact s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
    MATCH_MP_TAC CLOSED_COMPACT_IN THEN EXISTS_TAC (← q r"interval[a:real^N,b]") THEN
    ASM_REWRITE_TAC [CLOSED_IN_EUCLIDEAN, COMPACT_IN_EUCLIDEAN] THEN
    REWRITE_TAC [COMPACT_INTERVAL])

  let COMPACT_EQ_BOUNDED_CLOSED ← prove
   r"!s:real^N->bool. compact s <=> bounded s /\ closed s"
   (MESON_TAC [BOUNDED_CLOSED_IMP_COMPACT, COMPACT_IMP_CLOSED,
               COMPACT_IMP_BOUNDED])

  let NOT_COMPACT_UNIV ← prove
   r"~compact (:real^N)"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, NOT_BOUNDED_UNIV])

  let COMPACT_CLOSURE ← prove
   r"!s. compact(closure s) <=> bounded s"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_CLOSURE, BOUNDED_CLOSURE_EQ])

  let CLOSED_IN_COMPACT ← prove
   r"!s t:real^N->bool.
        compact s /\ closed_in (subtopology euclidean s) t
        ==> compact t"
   (SIMP_TAC [IMP_CONJ, COMPACT_EQ_BOUNDED_CLOSED, CLOSED_IN_CLOSED_EQ] THEN
    MESON_TAC [BOUNDED_SUBSET])

  let CLOSED_IN_COMPACT_EQ ← prove
   r"!s t. compact s
         ==> (closed_in (subtopology euclidean s) t <=>
              compact t /\ t SUBSET s)"
   (MESON_TAC [CLOSED_IN_CLOSED_EQ, COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET])

  let COMPACT_EQ_HEINE_BOREL ← prove
   r"!s:real^N->bool.
        compact s <=>
           !f. (!t. t IN f ==> open t) /\ s SUBSET (UNIONS f)
               ==> ?f'. f' SUBSET f /\ FINITE f' /\ s SUBSET (UNIONS f')"
   (REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN, compact_in] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, OPEN_IN, SUBSET_UNIV] THEN
    MESON_TAC [])

  let COMPACT_IMP_HEINE_BOREL ← prove
   r"!s. compact (s:real^N->bool)
       ==> !f. (!t. t IN f ==> open t) /\ s SUBSET (UNIONS f)
               ==> ?f'. f' SUBSET f /\ FINITE f' /\ s SUBSET (UNIONS f')"
   (SIMP_TAC [← GSYM COMPACT_EQ_HEINE_BOREL])

  let COMPACT_EQ_BOLZANO_WEIERSTRASS ← prove
   r"!s:real^N->bool.
        compact s <=>
           !t. INFINITE t /\ t SUBSET s ==> ?x. x IN s /\ x limit_point_of t"
   (REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [COMPACT_IN_EQ_BOLZANO_WEIERSTRASS] THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, SUBSET_UNIV] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [← GSYM LIMIT_POINT_IN_DERIVED_SET] THEN MESON_TAC [])

  let BOLZANO_WEIERSTRASS_IMP_CLOSED ← prove
   r"!s:real^N->bool.
        (!t. INFINITE t /\ t SUBSET s ==> ?x. x IN s /\ x limit_point_of t)
        ==> closed s"
   (REWRITE_TAC [← GSYM COMPACT_EQ_BOLZANO_WEIERSTRASS, COMPACT_IMP_CLOSED])

  let COMPACT_IMP_TOTALLY_BOUNDED ← prove
   r"!s:real^N->bool.
        compact s
        ==> !e. &0 < e ==> ?k. FINITE k /\ k SUBSET s /\
                               s SUBSET (UNIONS(IMAGE (\x. ball(x,e)) k))"
   (GEN_TAC THEN
    SIMP_TAC [← GSYM COMPACT_IN_EUCLIDEAN, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IN_IMP_TOTALLY_BOUNDED_IN) THEN
    REWRITE_TAC [totally_bounded_in, MBALL_EUCLIDEAN, SIMPLE_IMAGE])

  let HEINE_BOREL_LEMMA ← prove
   r"!s:real^N->bool.
      compact s
      ==> !t. s SUBSET (UNIONS t) /\ (!b. b IN t ==> open b)
              ==> ?e. &0 < e /\
                      !x. x IN s ==> ?b. b IN t /\ ball(x,e) SUBSET b"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric",
                     ← q r"s:real^N->bool", ← q r"t:(real^N->bool)->bool"]
          LEBESGUE_NUMBER) THEN
    ASM_REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, COMPACT_IN_EUCLIDEAN] THEN
    ASM_REWRITE_TAC [← GSYM OPEN_IN, MBALL_EUCLIDEAN])

  let HEINE_BOREL_IMP_BOLZANO_WEIERSTRASS ← prove
   r"!s:real^N->bool.
        (!f. (!t. t IN f ==> open t) /\ s SUBSET (UNIONS f)
             ==> ?f'. f' SUBSET f /\ FINITE f' /\ s SUBSET (UNIONS f'))
        ==> !t. INFINITE t /\ t SUBSET s ==> ?x. x IN s /\ x limit_point_of t"
   (REWRITE_TAC [← GSYM COMPACT_EQ_BOLZANO_WEIERSTRASS, ← GSYM
                 COMPACT_EQ_HEINE_BOREL])

  let BOLZANO_WEIERSTRASS_IMP_BOUNDED ← prove
   r"!s:real^N->bool.
        (!t. INFINITE t /\ t SUBSET s ==> ?x. x limit_point_of t)
        ==> bounded s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BOUNDED_SUBSET THEN
    EXISTS_TAC (← q r"closure s:real^N->bool") THEN REWRITE_TAC [CLOSURE_SUBSET] THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric", ← q r"s:real^N->bool"]
          COMPACT_CLOSURE_OF_EQ_BOLZANO_WEIERSTRASS) THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, SUBSET_UNIV, ← GSYM MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [← GSYM LIMIT_POINT_IN_DERIVED_SET, MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    ASM_REWRITE_TAC [EUCLIDEAN_CLOSURE_OF, COMPACT_IN_EUCLIDEAN] THEN
    REWRITE_TAC [COMPACT_IMP_BOUNDED])

  let COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY ← prove
   r"!s:real^N->bool.
        compact s <=>
        !f. (!t. t IN f ==> open_in(subtopology euclidean s) t) /\
            s SUBSET UNIONS f
            ==> ?f'. f' SUBSET f /\ FINITE f' /\ s SUBSET UNIONS f'"
   (GEN_TAC THEN REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN] THEN
    ONCE_REWRITE_TAC [← GSYM COMPACT_IN_ABSOLUTE] THEN
    REWRITE_TAC [compact_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_REFL] THEN
    MESON_TAC [])

  let COMPACT_EQ_HEINE_BOREL_GEN ← prove
   r"!c:real^N->bool.
        compact c <=>
        !f s. (!t. t IN f ==> open_in (subtopology euclidean s) t) /\
              c SUBSET UNIONS f
              ==> ?f'. f' SUBSET f /\ FINITE f' /\ c SUBSET UNIONS f'"
   (GEN_TAC THEN REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN] THEN
    ONCE_REWRITE_TAC [← GSYM COMPACT_IN_ABSOLUTE] THEN
    EQ_TAC THEN REPEAT STRIP_TAC THENL
     [SUBGOAL_THEN (← q r"(c:real^N->bool) SUBSET s") ASSUME_TAC THENL
       [TRANS_TAC SUBSET_TRANS (← q r"UNIONS f:real^N->bool") THEN
        ASM_REWRITE_TAC [UNIONS_SUBSET] THEN
        ASM_MESON_TAC [OPEN_IN_IMP_SUBSET],
        MP_TAC (← ISPECL [← q r"subtopology euclidean (s:real^N->bool)",
                         ← q r"c:real^N->bool"] compact_in) THEN
        ONCE_REWRITE_TAC [← GSYM COMPACT_IN_ABSOLUTE] THEN
        REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
        ASM_SIMP_TAC [← SET_RULE (← q r"c SUBSET s ==> s INTER c = c")] THEN
        ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        ASM_MESON_TAC []],
      REWRITE_TAC [compact_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_REFL] THEN
      ASM_MESON_TAC []])

  let BOUNDED_EQ_BOLZANO_WEIERSTRASS ← prove
   r"!s:real^N->bool.
        bounded s <=> !t. t SUBSET s /\ INFINITE t ==> ?x. x limit_point_of t"
   (GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric", ← q r"s:real^N->bool"]
          COMPACT_CLOSURE_OF_EQ_BOLZANO_WEIERSTRASS) THEN
    REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, COMPACT_IN_EUCLIDEAN, SUBSET_UNIV,
                 EUCLIDEAN_CLOSURE_OF, EUCLIDEAN_METRIC, INTER_UNIV] THEN
    REWRITE_TAC [COMPACT_CLOSURE, ← GSYM MEMBER_NOT_EMPTY,
                 LIMIT_POINT_IN_DERIVED_SET] THEN
    MESON_TAC [])

  let BOLZANO_WEIERSTRASS ← prove
   r"!s:real^N->bool. bounded s /\ INFINITE s ==> ?x. x limit_point_of s"
   (MESON_TAC [BOUNDED_EQ_BOLZANO_WEIERSTRASS, SUBSET_REFL])

  let BOUNDED_EQ_TOTALLY_BOUNDED ← prove
   r"!s:real^N->bool.
        bounded s <=>
        !e. &0 < e
            ==> ?k. FINITE k /\ k SUBSET s /\
                    s SUBSET (UNIONS(IMAGE (\x. ball(x,e)) k))"
   (GEN_TAC THEN REWRITE_TAC [← GSYM MBALL_EUCLIDEAN, ← GSYM SIMPLE_IMAGE] THEN
    REWRITE_TAC [← GSYM totally_bounded_in] THEN EQ_TAC THENL
     [DISCH_TAC THEN MATCH_MP_TAC COMPACT_CLOSURE_OF_IMP_TOTALLY_BOUNDED_IN THEN
      REWRITE_TAC [SUBSET_UNIV, MTOPOLOGY_EUCLIDEAN_METRIC, EUCLIDEAN_METRIC] THEN
      REWRITE_TAC [EUCLIDEAN_CLOSURE_OF, COMPACT_IN_EUCLIDEAN] THEN
      ASM_REWRITE_TAC [COMPACT_CLOSURE],
      REWRITE_TAC [← GSYM MBOUNDED_EUCLIDEAN, TOTALLY_BOUNDED_IN_IMP_MBOUNDED]])

  return { compact, COMPACT_IN_EUCLIDEAN, COMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY,
           COMPACT_IMP_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_INTERVAL, BOUNDED_CLOSED_IMP_COMPACT,
           COMPACT_EQ_BOUNDED_CLOSED, NOT_COMPACT_UNIV, COMPACT_CLOSURE, CLOSED_IN_COMPACT,
           CLOSED_IN_COMPACT_EQ, COMPACT_EQ_HEINE_BOREL, COMPACT_IMP_HEINE_BOREL,
           COMPACT_EQ_BOLZANO_WEIERSTRASS, BOLZANO_WEIERSTRASS_IMP_CLOSED,
           COMPACT_IMP_TOTALLY_BOUNDED, HEINE_BOREL_LEMMA, HEINE_BOREL_IMP_BOLZANO_WEIERSTRASS,
           BOLZANO_WEIERSTRASS_IMP_BOUNDED, COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY,
           COMPACT_EQ_HEINE_BOREL_GEN, BOUNDED_EQ_BOLZANO_WEIERSTRASS, BOLZANO_WEIERSTRASS,
           BOUNDED_EQ_TOTALLY_BOUNDED }

/- ------------------------------------------------------------------------- -/
/- Convergence of bounded monotone sequences; completeness; Cauchy-type     -/
/- criteria for limits at a point.  (topology.ml 5624-5854)                  -/
/- ------------------------------------------------------------------------- -/

structure CMP where
  CONVERGENT_BOUNDED_MONOTONE_1 : thm
  CONVERGENT_BOUNDED_INCREASING_1 : thm
  CONVERGENT_BOUNDED_DECREASING_1 : thm
  cauchy : thm
  CAUCHY_IN_EUCLIDEAN : thm
  complete : thm
  CAUCHY : thm
  CAUCHY_SUBSEQUENCE : thm
  CAUCHY_OFFSET : thm
  CONVERGENT_IMP_CAUCHY : thm
  CAUCHY_IMP_BOUNDED : thm
  CAUCHY_CONVERGENT_SUBSEQUENCE : thm
  COMPACT_IMP_COMPLETE : thm
  COMPLETE_UNIV : thm
  COMPLETE_EQ_CLOSED : thm
  CONVERGENT_EQ_CAUCHY : thm
  CONVERGENT_IMP_BOUNDED : thm
  CONVERGENT_BOUNDED_MONOTONE_EQ : thm
  MCOMPLETE_EUCLIDEAN : thm
  COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN : thm
  CONVERGENT_EQ_ZERO_OSCILLATION : thm
  CONVERGENT_EQ_CAUCHY_WITHIN : thm
  CONVERGENT_EQ_CAUCHY_AT : thm
  deriving Inhabited

@[nospecialize]
def setupCMP [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLPT : LPT) (BCLS1 : CLS1)
    (BNET : NET) (BLIM1 : LIM1) (BLIM2 : LIM2) (BRLM : RLM) (BARI : ARI) (BUNQ : UNQ)
    (BSEQ : SEQ) (BBND1 : BND1) (BCPT : CPT) : ExceptT String IO CMP := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_TAC, .. } := D
  let { EQ_IMP, ETA_AX, .. } := D.core1
  let { FORALL_IN_IMAGE, GE, IMAGE, IMP_CONJ, IN_DELETE, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, LE_ADD, LE_REFL, LE_TRANS,
        MONO_EXISTS, MONO_FORALL, .. } := D.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, .. } := D.core4
  let { RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_UNIV, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LE, UNIV_NOT_EMPTY, o_DEF, o_THM, .. } := D.core6
  let { CONVERGENT_BOUNDED_MONOTONE, MONOTONE_BIGGER, REAL_HALF, .. } := D.misc
  let { DIST_NZ, DIST_REAL, DIST_SYM, DIST_TRIANGLE_HALF_L, EXISTS_DROP, .. } := D.vec1
  let { NORM_1, .. } := D.vec3
  let { VECTOR_ADD_RID, VECTOR_SUB_ADD2, VECTOR_SUB_RZERO, dist, drop, .. } := D.vec4
  let { CAUCHY_IN_IMP_MBOUNDED, COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY, .. } := D.met1
  let { CONVERGENT_EQ_ZERO_OSCILLATION_GEN, CONVERGENT_IMP_CAUCHY_IN, .. } := D.met2
  let { TOPSPACE_MTOPOLOGY, TRIVIAL_LIMIT_SEQUENTIALLY, cauchy_in, mcomplete, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_IN, .. } := BEUC
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := BBAL
  let { CLOSED_LIMPT, .. } := BLPT
  let { CLOSED_CLOSURE, closure, .. } := BCLS1
  let { WITHIN_UNIV, «at», .. } := BNET
  let { LIMIT_EUCLIDEAN, .. } := BLIM1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIMPT_SEQUENTIAL, .. } := BRLM
  let { LIM_ADD, .. } := BARI
  let { LIM_UNIQUE, .. } := BUNQ
  let { CLOSED_SEQUENTIAL_LIMITS, .. } := BSEQ
  let { BOUNDED_CLOSURE, MBOUNDED_EUCLIDEAN, bounded, .. } := BBND1
  let { BOUNDED_CLOSED_IMP_COMPACT, compact, .. } := BCPT
  -- @@SCOPE END

  let CONVERGENT_BOUNDED_MONOTONE_1 ← prove
   r"!s. bounded(IMAGE s (:num)) /\
       ((!n. drop(s n) <= drop(s(SUC n))) \/ (!n. drop(s(SUC n)) <= drop(s n)))
       ==> ?l. (s --> l) sequentially"
   (GEN_TAC THEN REWRITE_TAC [bounded, FORALL_IN_IMAGE, IN_UNIV] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"b:real")) ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"drop o (s:num->real^1)", ← q r"b:real"]
       CONVERGENT_BOUNDED_MONOTONE) THEN
    ASM_REWRITE_TAC [o_DEF, ← GSYM NORM_1, LIM_SEQUENTIALLY] THEN
    REWRITE_TAC [DIST_REAL, ← GSYM drop, ← GSYM EXISTS_DROP] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    FIRST_X_ASSUM DISJ_CASES_TAC THENL [DISJ1_TAC, DISJ2_TAC] THEN
    MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
    ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let CONVERGENT_BOUNDED_INCREASING_1 ← prove
   r"!s b. (!n. drop(s n) <= drop(s(SUC n))) /\ (!n. drop(s n) <= b)
         ==> ?l. (s --> l) sequentially"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONVERGENT_BOUNDED_MONOTONE_1 THEN
    ASM_REWRITE_TAC [bounded] THEN
    EXISTS_TAC (← q r"max (abs b) (norm((s:num->real^1) 0))") THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV, NORM_1] THEN X_GEN_TAC (← q r"n:num") THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"a <= x /\ x <= b ==> abs x <= max (abs b) (abs a)")) THEN
    ASM_REWRITE_TAC [] THEN SPEC_TAC (← q r"n:num", ← q r"n:num") THEN
    INDUCT_TAC THEN ASM_MESON_TAC [REAL_LE_TRANS, REAL_LE_REFL])

  let CONVERGENT_BOUNDED_DECREASING_1 ← prove
   r"!s b. (!n. drop(s(SUC n)) <= drop(s n)) /\ (!n. b <= drop(s n))
         ==> ?l. (s --> l) sequentially"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONVERGENT_BOUNDED_MONOTONE_1 THEN
    ASM_REWRITE_TAC [bounded] THEN
    EXISTS_TAC (← q r"max (abs b) (norm((s:num->real^1) 0))") THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV, NORM_1] THEN X_GEN_TAC (← q r"n:num") THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"b <= x /\ x <= a ==> abs x <= max (abs b) (abs a)")) THEN
    ASM_REWRITE_TAC [] THEN SPEC_TAC (← q r"n:num", ← q r"n:num") THEN
    INDUCT_TAC THEN ASM_MESON_TAC [REAL_LE_TRANS, REAL_LE_REFL])

  let cauchy ← new_definition
   r"cauchy (s:num->real^N) <=>
     !e. &0 < e ==> ?N. !m n. m >= N /\ n >= N ==> dist(s m,s n) < e"

  let CAUCHY_IN_EUCLIDEAN ← prove
   r"!s:num->real^N. cauchy_in euclidean_metric s <=> cauchy s"
   (REWRITE_TAC [cauchy, cauchy_in, EUCLIDEAN_METRIC, IN_UNIV, GE])

  let complete ← new_definition
   r"complete s <=>
     !f:num->real^N. (!n. f n IN s) /\ cauchy f
                      ==> ?l. l IN s /\ (f --> l) sequentially"

  let CAUCHY ← prove
   r"!s:num->real^N.
      cauchy s <=> !e. &0 < e ==> ?N. !n. n >= N ==> dist(s n,s N) < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [cauchy, GE] THEN EQ_TAC THENL
     [MESON_TAC [LE_REFL], DISCH_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    MESON_TAC [DIST_TRIANGLE_HALF_L])

  let CAUCHY_SUBSEQUENCE ← prove
   r"!x:num->real^N r:num->num.
        (!m n. m < n ==> r m < r n) /\ cauchy x ==> cauchy (x o r)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MONOTONE_BIGGER) THEN
    REWRITE_TAC [cauchy, o_DEF, GE] THEN MESON_TAC [LE_TRANS])

  let CAUCHY_OFFSET ← prove
   r"!k x:num->real^N. cauchy (\i. x(i + k)) <=> cauchy x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [cauchy, GE] THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [LE_ADD, LE_TRANS]] THEN
    MESON_TAC [← ARITH_RULE
     (← q r"N + k:num <= n ==> n = (n - k) + k /\ N <= n - k")])

  let CONVERGENT_IMP_CAUCHY ← prove
   r"!s l. (s --> l) sequentially ==> cauchy s"
   (REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, ← GSYM CAUCHY_IN_EUCLIDEAN] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CONVERGENT_IMP_CAUCHY_IN) THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, IN_UNIV])

  let CAUCHY_IMP_BOUNDED ← prove
   r"!s:num->real^N. cauchy s ==> bounded {y | ?n. y = s n}"
   (GEN_TAC THEN REWRITE_TAC [← GSYM CAUCHY_IN_EUCLIDEAN] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CAUCHY_IN_IMP_MBOUNDED) THEN
    REWRITE_TAC [MBOUNDED_EUCLIDEAN] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN SET_TAC [])

  let CAUCHY_CONVERGENT_SUBSEQUENCE ← prove
   r"!x:num->real^N r.
        cauchy x /\ (!m n. m < n ==> r m < r n) /\ ((x o r) --> l) sequentially
        ==> (x --> l) sequentially"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] LIM_ADD)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"\n. (x:num->real^N)(n) - x(r n)")) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"vec 0: real^N")) THEN ASM_REWRITE_TAC [o_THM] THEN
    REWRITE_TAC [VECTOR_ADD_RID, VECTOR_SUB_ADD2, ETA_AX] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [cauchy]) THEN
    REWRITE_TAC [GE, LIM_SEQUENTIALLY, dist, VECTOR_SUB_RZERO] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP MONOTONE_BIGGER) THEN
    ASM_MESON_TAC [LE_TRANS])

  let COMPACT_IMP_COMPLETE ← prove
   r"!s:real^N->bool. compact s ==> complete s"
   (GEN_TAC THEN REWRITE_TAC [complete, compact] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"f:num->real^N") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CAUCHY_CONVERGENT_SUBSEQUENCE THEN
    ASM_MESON_TAC [])

  let COMPLETE_UNIV ← prove
   r"complete(:real^N)"
   (REWRITE_TAC [complete, IN_UNIV] THEN X_GEN_TAC (← q r"x:num->real^N") THEN
    DISCH_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP CAUCHY_IMP_BOUNDED) THEN
    DISCH_THEN (ASSUME_TAC o MATCH_MP BOUNDED_CLOSURE) THEN
    MP_TAC (← ISPEC (← q r"closure {y:real^N | ?n:num. y = x n}")
                 COMPACT_IMP_COMPLETE) THEN
    ASM_SIMP_TAC [BOUNDED_CLOSED_IMP_COMPACT, CLOSED_CLOSURE, complete] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real^N")) THEN
    ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    ASM_REWRITE_TAC [closure, IN_ELIM_THM, IN_UNION] THEN MESON_TAC [])

  let COMPLETE_EQ_CLOSED ← prove
   r"!s:real^N->bool. complete s <=> closed s"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [complete, CLOSED_LIMPT, LIMPT_SEQUENTIAL] THEN
      REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN GEN_TAC THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
      MESON_TAC [CONVERGENT_IMP_CAUCHY, IN_DELETE, LIM_UNIQUE,
                 TRIVIAL_LIMIT_SEQUENTIALLY],
      REWRITE_TAC [complete, CLOSED_SEQUENTIAL_LIMITS] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"f:num->real^N") THEN STRIP_TAC THEN
      MP_TAC (← REWRITE_RULE [complete] COMPLETE_UNIV) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"f:num->real^N")) THEN
      ASM_REWRITE_TAC [IN_UNIV] THEN ASM_MESON_TAC []])

  let CONVERGENT_EQ_CAUCHY ← prove
   r"!s. (?l. (s --> l) sequentially) <=> cauchy s"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [LEFT_IMP_EXISTS_THM, CONVERGENT_IMP_CAUCHY],
      REWRITE_TAC [← REWRITE_RULE [complete, IN_UNIV] COMPLETE_UNIV]])

  let CONVERGENT_IMP_BOUNDED ← prove
   r"!s l. (s --> l) sequentially ==> bounded (IMAGE s (:num))"
   (REWRITE_TAC [LEFT_FORALL_IMP_THM, CONVERGENT_EQ_CAUCHY] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP CAUCHY_IMP_BOUNDED) THEN
    REWRITE_TAC [IMAGE, IN_UNIV])

  let CONVERGENT_BOUNDED_MONOTONE_EQ ← prove
   r"!s. (!n. drop(s n) <= drop(s(SUC n))) \/ (!n. drop(s(SUC n)) <= drop(s n))
       ==> ((?l. (s --> l) sequentially) <=> bounded (IMAGE s (:num)))"
   (MESON_TAC [CONVERGENT_BOUNDED_MONOTONE_1, CONVERGENT_IMP_BOUNDED])

  let MCOMPLETE_EUCLIDEAN ← prove
   r"mcomplete(euclidean_metric:(real^N)metric)"
   (REWRITE_TAC [mcomplete, MTOPOLOGY_EUCLIDEAN_METRIC,
      CAUCHY_IN_EUCLIDEAN, LIMIT_EUCLIDEAN, CONVERGENT_EQ_CAUCHY])

  let COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN ← prove
   r"completely_metrizable_space euclidean"
   (REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY THEN
    REWRITE_TAC [MCOMPLETE_EUCLIDEAN])

  let CONVERGENT_EQ_ZERO_OSCILLATION ← prove
   r"!f:real^M->real^N a s.
        (?l. (f --> l) (at a within s)) <=>
        !e. &0 < e
            ==> ?u. open u /\ a IN u /\
                    !x y. x IN (s INTER u) DELETE a /\
                          y IN (s INTER u) DELETE a
                          ==> dist(f x,f y) < e"
   (REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, «at», ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    SIMP_TAC [CONVERGENT_EQ_ZERO_OSCILLATION_GEN, MCOMPLETE_EUCLIDEAN, IN_UNIV,
              EUCLIDEAN_METRIC, SUBSET_UNIV, TOPSPACE_MTOPOLOGY] THEN
    REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, ← GSYM OPEN_IN, UNIV_NOT_EMPTY])

  let CONVERGENT_EQ_CAUCHY_WITHIN ← prove
   r"!f:real^M->real^N s a.
        (?l. (f --> l) (at a within s)) <=>
        (!e. &0 < e
             ==> ?d. &0 < d /\
                     !x x'. x IN s /\ &0 < dist(x,a) /\ dist(x,a) < d /\
                            x' IN s /\ &0 < dist(x',a) /\ dist(x',a) < d
                            ==> dist(f x,f x') < e)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONVERGENT_EQ_ZERO_OSCILLATION] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
     [X_GEN_TAC (← q r"u:real^M->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:real^M")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
      REWRITE_TAC [SUBSET, IN_BALL] THEN REPEAT STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [IN_INTER, IN_DELETE, DIST_NZ],
      X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"ball(a:real^M,d)") THEN
      ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL, IN_INTER, IN_DELETE] THEN
      ASM_REWRITE_TAC [IN_BALL, DIST_NZ]] THEN
    ASM_MESON_TAC [DIST_SYM])

  let CONVERGENT_EQ_CAUCHY_AT ← prove
   r"!f:real^M->real^N a.
        (?l. (f --> l) (at a)) <=>
        (!e. &0 < e
             ==> ?d. &0 < d /\
                     !x x'. &0 < dist(x,a) /\ dist(x,a) < d /\
                            &0 < dist(x',a) /\ dist(x',a) < d
                            ==> dist(f x,f x') < e)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(:real^M)", ← q r"a:real^M"]
          CONVERGENT_EQ_CAUCHY_WITHIN) THEN
    REWRITE_TAC [WITHIN_UNIV, IN_UNIV])

  return { CONVERGENT_BOUNDED_MONOTONE_1, CONVERGENT_BOUNDED_INCREASING_1,
           CONVERGENT_BOUNDED_DECREASING_1, cauchy, CAUCHY_IN_EUCLIDEAN, complete, CAUCHY,
           CAUCHY_SUBSEQUENCE, CAUCHY_OFFSET, CONVERGENT_IMP_CAUCHY, CAUCHY_IMP_BOUNDED,
           CAUCHY_CONVERGENT_SUBSEQUENCE, COMPACT_IMP_COMPLETE, COMPLETE_UNIV,
           COMPLETE_EQ_CLOSED, CONVERGENT_EQ_CAUCHY, CONVERGENT_IMP_BOUNDED,
           CONVERGENT_BOUNDED_MONOTONE_EQ, MCOMPLETE_EUCLIDEAN,
           COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN, CONVERGENT_EQ_ZERO_OSCILLATION,
           CONVERGENT_EQ_CAUCHY_WITHIN, CONVERGENT_EQ_CAUCHY_AT }

/- ------------------------------------------------------------------------- -/
/- Compactness properties, part 1.  (topology.ml 5855-6048)                  -/
/- ------------------------------------------------------------------------- -/

structure CPP1 where
  SEQUENCE_INFINITE_LEMMA : thm
  LIMPT_OF_SEQUENCE_SUBSEQUENCE : thm
  SEQUENCE_UNIQUE_LIMPT : thm
  COMPACT_SEQUENCE_WITH_LIMIT_GEN : thm
  COMPACT_SEQUENCE_WITH_LIMIT : thm
  BOLZANO_WEIERSTRASS_CONTRAPOS : thm
  DISCRETE_BOUNDED_IMP_FINITE : thm
  FINITE_EQ_BOUNDED_DISCRETE : thm
  DISCRETE_EQ_FINITE_BOUNDED : thm
  DISCRETE_EQ_FINITE_BOUNDED_CLOSED : thm
  DISCRETE_EQ_FINITE_COMPACT : thm
  COMPACT_EMPTY : thm
  COMPACT_UNION : thm
  COMPACT_INTER : thm
  COMPACT_INTER_CLOSED : thm
  CLOSED_INTER_COMPACT : thm
  COMPACT_INTERS : thm
  FINITE_IMP_CLOSED : thm
  FINITE_IMP_CLOSED_IN : thm
  FINITE_IMP_COMPACT : thm
  COMPACT_SING : thm
  deriving Inhabited

@[nospecialize]
def setupCPP1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLOC : LOC)
    (BLPT : LPT) (BLIM1 : LIM1) (BLIM2 : LIM2) (BUNQ : UNQ) (BBND1 : BND1) (BCPT : CPT) :
    ExceptT String IO CPP1 := do
  -- @@SCOPE BEGIN
  let { prove_recursive_functions_exist, ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON_TAC,
        REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { EXISTS_FINITE_SUBSET_IMAGE, EXISTS_IN_IMAGE, EXTENSION, FINITE_DELETE, FINITE_IMAGE,
        FINITE_INSERT, FINITE_NUMSEG, .. } := D.core1
  let { FINITE_PRODUCT_DEPENDENT, FINITE_RESTRICT, FINITE_RULES, FINITE_SUBSET, FORALL_AND_THM,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_PAIR_THM, IMAGE_EQ_EMPTY,
        INFINITE, INF_FINITE, INTER_COMM, INTER_SUBSET, IN_DELETE, IN_ELIM_PAIR_THM, IN_ELIM_THM,
        IN_IMAGE, IN_NUMSEG, .. } := D.core2
  let { IN_UNIV, LE, LE_0, LE_1, LE_REFL, LT_TRANS, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_ARCH_INV, REAL_LET_TRANS, REAL_LE_INV2, REAL_LT_01, REAL_LT_INF_FINITE,
        REAL_LT_INV_EQ, REAL_LT_REFL, .. } := D.core4
  let { REAL_LT_TRANS, REAL_NOT_LE, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, SKOLEM_THM,
        SUBSET, SUBSET_ANTISYM, SUBSET_REFL, SUBSET_UNIV, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LT, UNIONS_IMAGE, num_INDUCTION, num_RECURSION, o_THM, .. } :=
    D.core6
  let { MONOTONE_BIGGER, .. } := D.misc
  let { DIST_NZ, DIST_POS_LT, .. } := D.vec1
  let { dist, .. } := D.vec4
  let { COMPACT_IN_SEQUENCE_WITH_LIMIT, .. } := D.met1
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { CLOSED_INTER, CLOSED_INTERS, CLOSED_UNION, .. } := BCLO
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, .. } := BBAL
  let { CLOSED_SUBSET_EQ, .. } := BLOC
  let { CLOSED_LIMPT, DISCRETE_IMP_CLOSED, LIMIT_POINT_FINITE, LIMPT_APPROACHABLE, LIMPT_SUBSET,
        .. } := BLPT
  let { LIMIT_EUCLIDEAN, .. } := BLIM1
  let { LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, .. } := BLIM2
  let { LIM_UNIQUE, .. } := BUNQ
  let { BOUNDED_INTER, BOUNDED_INTERS, BOUNDED_SUBSET, BOUNDED_UNION, FINITE_IMP_BOUNDED, .. } :=
    BBND1
  let { BOLZANO_WEIERSTRASS_IMP_CLOSED, BOUNDED_EQ_BOLZANO_WEIERSTRASS,
        COMPACT_EQ_BOLZANO_WEIERSTRASS, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_HEINE_BOREL,
        COMPACT_IN_EUCLIDEAN, compact, .. } := BCPT
  -- @@SCOPE END

  let SEQUENCE_INFINITE_LEMMA ← prove
   r"!f l. (!n. ~(f(n) = l)) /\ (f --> l) sequentially
         ==> INFINITE {y:real^N | ?n. y = f n}"
   (REWRITE_TAC [INFINITE] THEN REPEAT STRIP_TAC THEN MP_TAC (← ISPEC
     (← q r"IMAGE (\y:real^N. dist(y,l)) {y | ?n:num. y = f n}") INF_FINITE) THEN
    ASM_SIMP_TAC [← GSYM MEMBER_NOT_EMPTY, IN_IMAGE, FINITE_IMAGE, IN_ELIM_THM] THEN
    ASM_MESON_TAC [LIM_SEQUENTIALLY, LE_REFL, REAL_NOT_LE, DIST_POS_LT])

  let LIMPT_OF_SEQUENCE_SUBSEQUENCE ← prove
   r"!f:num->real^N l.
        l limit_point_of (IMAGE f (:num))
        ==> ?r. (!m n. m < n ==> r(m) < r(n)) /\ ((f o r) --> l) sequentially"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIMPT_APPROACHABLE]) THEN
    DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC
     (← q r"inf((inv(&n + &1)) INSERT
      IMAGE (\k. dist((f:num->real^N) k,l))
            {k | k IN 0..n /\ ~(f k = l)})")) THEN
    SIMP_TAC [REAL_LT_INF_FINITE, FINITE_INSERT, NOT_INSERT_EMPTY,
              FINITE_RESTRICT, FINITE_NUMSEG, FINITE_IMAGE] THEN
    REWRITE_TAC [FORALL_IN_INSERT, EXISTS_IN_IMAGE, FORALL_IN_IMAGE, IN_UNIV] THEN
    REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
    SIMP_TAC [FORALL_AND_THM, FORALL_IN_GSPEC, ← GSYM DIST_NZ, SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"nn:num->num") STRIP_ASSUME_TAC) THEN
    MP_TAC (← prove_recursive_functions_exist num_RECURSION
     (← q r"r 0 = nn 0 /\ (!n. r (SUC n) = nn(r n))")) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
    STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN REWRITE_TAC [LT_TRANS] THEN
      X_GEN_TAC (← q r"n:num") THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(r:num->num) n", ← q r"(nn:num->num)(r(n:num))"]) THEN
      ASM_REWRITE_TAC [IN_NUMSEG, LE_0, REAL_LT_REFL] THEN ARITH_TAC,
      DISCH_THEN (ASSUME_TAC o MATCH_MP MONOTONE_BIGGER)] THEN
    REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    X_GEN_TAC (← q r"e:real") THEN GEN_REWRITE_TAC LAND_CONV [REAL_ARCH_INV] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
    MATCH_MP_TAC num_INDUCTION THEN ASM_REWRITE_TAC [← CONJUNCT1 LE] THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [o_THM] THEN MATCH_MP_TAC REAL_LT_TRANS THEN
    EXISTS_TAC (← q r"inv(&((r:num->num) n) + &1)") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"inv(&N)") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
    ASM_SIMP_TAC [REAL_OF_NUM_LE, REAL_OF_NUM_LT, LE_1, REAL_OF_NUM_ADD] THEN
    MATCH_MP_TAC (← ARITH_RULE (← q r"N <= SUC n /\ n <= r n ==> N <= r n + 1")) THEN
    ASM_REWRITE_TAC [])

  let SEQUENCE_UNIQUE_LIMPT ← prove
   r"!f l l':real^N.
        (f --> l) sequentially /\ l' limit_point_of {y | ?n. y = f n}
        ==> l' = l"
   (REWRITE_TAC [← SET_RULE (← q r"{y | ?n. y = f n} = IMAGE f (:num)")] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP LIMPT_OF_SEQUENCE_SUBSEQUENCE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
    EXISTS_TAC (← q r"(f:num->real^N) o (r:num->num)") THEN
    ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, LIM_SUBSEQUENCE])

  let COMPACT_SEQUENCE_WITH_LIMIT_GEN ← prove
   r"!f l:real^N s.
        (f --> l) sequentially /\ s SUBSET IMAGE f (:num)
        ==> compact (l INSERT s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN] THEN
    MATCH_MP_TAC COMPACT_IN_SEQUENCE_WITH_LIMIT THEN
    EXISTS_TAC (← q r"f:num->real^N") THEN
    ASM_REWRITE_TAC [LIMIT_EUCLIDEAN, TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let COMPACT_SEQUENCE_WITH_LIMIT ← prove
   r"!f l:real^N.
        (f --> l) sequentially ==> compact (l INSERT IMAGE f (:num))"
   (MESON_TAC [COMPACT_SEQUENCE_WITH_LIMIT_GEN, SUBSET_REFL])

  let BOLZANO_WEIERSTRASS_CONTRAPOS ← prove
   r"!s t:real^N->bool.
        compact s /\ t SUBSET s /\
        (!x. x IN s ==> ~(x limit_point_of t))
        ==> FINITE t"
   (REWRITE_TAC [COMPACT_EQ_BOLZANO_WEIERSTRASS, INFINITE] THEN MESON_TAC [])

  let DISCRETE_BOUNDED_IMP_FINITE ← prove
   r"!s:real^N->bool e.
        &0 < e /\
        (!x y. x IN s /\ y IN s /\ norm(y - x) < e ==> y = x) /\
        bounded s
        ==> FINITE s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"compact(s:real^N->bool)") MP_TAC THENL
     [ASM_REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN
      ASM_MESON_TAC [DISCRETE_IMP_CLOSED],
      DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IMP_HEINE_BOREL)] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (\x:real^N. ball(x,e)) s")) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, OPEN_BALL, UNIONS_IMAGE, IN_ELIM_THM] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_MESON_TAC [CENTRE_IN_BALL],
      ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> b /\ a /\ c")]] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"s:real^N->bool = t") (fun th => ASM_REWRITE_TAC [th]) THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [UNIONS_IMAGE]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N") o GEN_REWRITE_RULE id [SUBSET]) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, IN_BALL, dist] THEN ASM_MESON_TAC [SUBSET])

  let FINITE_EQ_BOUNDED_DISCRETE ← prove
   r"!s:real^N->bool.
        FINITE s <=>
        bounded s /\
        ?r. &0 < r /\ !x y. x IN s /\ y IN s /\ norm (y - x) < r ==> x = y"
   (GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [FINITE_IMP_BOUNDED], MESON_TAC [DISCRETE_BOUNDED_IMP_FINITE]] THEN
    DISCH_TAC THEN
    ASM_CASES_TAC (← q r"{(x:real^N,y) | x IN s /\ y IN s DELETE x} = {}") THENL
     [EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EXTENSION]) THEN
      REWRITE_TAC [FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN SET_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"inf (IMAGE dist {(x:real^N,y) | x IN s /\ y IN s DELETE x})") THEN
    ASM_SIMP_TAC [FINITE_PRODUCT_DEPENDENT, FINITE_DELETE, REAL_LT_INF_FINITE,
      FINITE_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
    SIMP_TAC [IN_DELETE, DIST_POS_LT, dist] THEN MESON_TAC [REAL_LT_REFL])

  let DISCRETE_EQ_FINITE_BOUNDED ← prove
   r"!s:real^N->bool.
        bounded s ==> ({x | x limit_point_of s} = {} <=> FINITE s)"
   (GEN_TAC THEN REWRITE_TAC [BOUNDED_EQ_BOLZANO_WEIERSTRASS] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
    MESON_TAC [LIMIT_POINT_FINITE, INFINITE, SUBSET_REFL])

  let DISCRETE_EQ_FINITE_BOUNDED_CLOSED ← prove
   r"!s t:real^N->bool.
        closed s /\ bounded t /\ t SUBSET s
        ==> ({x | x IN s /\ x limit_point_of t} = {} <=> FINITE t)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [← GSYM DISCRETE_EQ_FINITE_BOUNDED] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. P x ==> x IN s) ==> {x | x IN s /\ P x} = {x | P x}")) THEN
    ASM_MESON_TAC [CLOSED_LIMPT, LIMPT_SUBSET])

  let DISCRETE_EQ_FINITE_COMPACT ← prove
   r"!s t:real^N->bool.
        compact s /\ t SUBSET s
        ==> ({x | x IN s /\ x limit_point_of t} = {} <=> FINITE t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC DISCRETE_EQ_FINITE_BOUNDED_CLOSED THEN
    ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET])

  let COMPACT_EMPTY ← prove
   r"compact {}"
   (REWRITE_TAC [compact, NOT_IN_EMPTY])

  let COMPACT_UNION ← prove
   r"!s t. compact s /\ compact t ==> compact (s UNION t)"
   (SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_UNION, CLOSED_UNION])

  let COMPACT_INTER ← prove
   r"!s t. compact s /\ compact t ==> compact (s INTER t)"
   (SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_INTER, CLOSED_INTER])

  let COMPACT_INTER_CLOSED ← prove
   r"!s t. compact s /\ closed t ==> compact (s INTER t)"
   (SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_INTER] THEN
    MESON_TAC [BOUNDED_SUBSET, INTER_SUBSET])

  let CLOSED_INTER_COMPACT ← prove
   r"!s t. closed s /\ compact t ==> compact (s INTER t)"
   (MESON_TAC [COMPACT_INTER_CLOSED, INTER_COMM])

  let COMPACT_INTERS ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> compact s) /\ ~(f = {})
        ==> compact(INTERS f)"
   (SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_INTERS] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC BOUNDED_INTERS THEN ASM SET_TAC [])

  let FINITE_IMP_CLOSED ← prove
   r"!s. FINITE s ==> closed s"
   (MESON_TAC [BOLZANO_WEIERSTRASS_IMP_CLOSED, INFINITE, FINITE_SUBSET])

  let FINITE_IMP_CLOSED_IN ← prove
   r"!s t. FINITE s /\ s SUBSET t ==> closed_in (subtopology euclidean t) s"
   (SIMP_TAC [CLOSED_SUBSET_EQ, FINITE_IMP_CLOSED])

  let FINITE_IMP_COMPACT ← prove
   r"!s. FINITE s ==> compact s"
   (SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, FINITE_IMP_CLOSED, FINITE_IMP_BOUNDED])

  let COMPACT_SING ← prove
   r"!a. compact {a}"
   (SIMP_TAC [FINITE_IMP_COMPACT, FINITE_RULES])

  return { SEQUENCE_INFINITE_LEMMA, LIMPT_OF_SEQUENCE_SUBSEQUENCE, SEQUENCE_UNIQUE_LIMPT,
           COMPACT_SEQUENCE_WITH_LIMIT_GEN, COMPACT_SEQUENCE_WITH_LIMIT,
           BOLZANO_WEIERSTRASS_CONTRAPOS, DISCRETE_BOUNDED_IMP_FINITE,
           FINITE_EQ_BOUNDED_DISCRETE, DISCRETE_EQ_FINITE_BOUNDED,
           DISCRETE_EQ_FINITE_BOUNDED_CLOSED, DISCRETE_EQ_FINITE_COMPACT, COMPACT_EMPTY,
           COMPACT_UNION, COMPACT_INTER, COMPACT_INTER_CLOSED, CLOSED_INTER_COMPACT,
           COMPACT_INTERS, FINITE_IMP_CLOSED, FINITE_IMP_CLOSED_IN, FINITE_IMP_COMPACT,
           COMPACT_SING }

/- ------------------------------------------------------------------------- -/
/- Compactness properties, part 2; finite intersection property.            -/
/- (topology.ml 6049-6234)                                                   -/
/- ------------------------------------------------------------------------- -/

structure CPP2 where
  COMPACT_INSERT : thm
  CLOSURE_SING : thm
  CLOSURE_INSERT : thm
  CLOSURE_DELETE : thm
  CLOSED_INSERT : thm
  CONNECTED_2 : thm
  COMPACT_CBALL : thm
  COMPACT_FRONTIER_BOUNDED : thm
  COMPACT_FRONTIER : thm
  BOUNDED_FRONTIER : thm
  FRONTIER_SUBSET_COMPACT : thm
  OPEN_DELETE : thm
  OPEN_IN_DELETE : thm
  CLOSED_INTERS_COMPACT : thm
  COMPACT_UNIONS : thm
  COMPACT_DIFF : thm
  COMPACT_SPHERE : thm
  BOUNDED_SPHERE : thm
  CLOSED_SPHERE : thm
  CLOSURE_SPHERE : thm
  FRONTIER_SPHERE : thm
  FRONTIER_SING : thm
  COMPACT_OPEN : thm
  COMPACT_IMP_FIP : thm
  CLOSED_IMP_FIP : thm
  CLOSED_IMP_FIP_COMPACT : thm
  CLOSED_FIP : thm
  COMPACT_FIP : thm
  deriving Inhabited

@[nospecialize]
def setupCPP2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BCON : CON)
    (BLPT : LPT) (BINT : INT) (BCLS1 : CLS1) (BFRO1 : FRO1) (BCBL : CBL) (BBND1 : BND1)
    (BCPT : CPT) (BCPP1 : CPP1) : ExceptT String IO CPP2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, NORM_ARITH_TAC, .. } :=
    D
  let { DIFF_EMPTY, EXTENSION, FINITE_EMPTY, FINITE_INSERT, .. } := D.core1
  let { INSERT_SUBSET, INTERS_0, INTERS_INSERT, INTER_ASSOC, INTER_UNIV, IN_DELETE, IN_ELIM_THM,
        IN_INTER, .. } := D.core2
  let { IN_UNION, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core3
  let { SUBSET_DIFF, SUBSET_EMPTY, .. } := D.core5
  let { COMPACT_IN_FIP, .. } := D.met1
  let { OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, .. } := D.met3
  let { OPEN_EMPTY, .. } := BEUC
  let { CLOSED_DIFF, CLOSED_INTER, CLOSED_IN_EUCLIDEAN, CLOSED_UNION, CLOSED_UNIONS,
        CLOSED_UNIV, OPEN_CLOSED, OPEN_DIFF, .. } := BCLO
  let { IN_CBALL, .. } := BBAL
  let { CLOPEN, CONNECTED_SING, .. } := BCON
  let { CLOSED_IN_SING, CLOSED_LIMPT, CLOSED_SING, LIMPT_APPROACHABLE, LIMPT_DELETE, .. } := BLPT
  let { INTERIOR_SING, OPEN_INTERIOR, .. } := BINT
  let { CLOSED_CLOSURE, CLOSURE_CLOSED, CLOSURE_EQ, CLOSURE_UNION, CONNECTED_INSERT, closure,
        .. } := BCLS1
  let { FRONTIER_SUBSET_CLOSED, frontier, .. } := BFRO1
  let { CLOSED_CBALL, FRONTIER_CBALL, INTERIOR_SPHERE, .. } := BCBL
  let { BOUNDED_CBALL, BOUNDED_CLOSURE, BOUNDED_INTER, BOUNDED_SUBSET, BOUNDED_UNIONS,
        NOT_BOUNDED_UNIV, .. } := BBND1
  let { COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPACT_IN_EUCLIDEAN,
        .. } := BCPT
  let { CLOSED_INTER_COMPACT, COMPACT_EMPTY, COMPACT_INTER_CLOSED, COMPACT_SING, COMPACT_UNION,
        .. } := BCPP1
  -- @@SCOPE END

  let COMPACT_INSERT ← prove
   r"!a s. compact s ==> compact(a INSERT s)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = {a} UNION s")] THEN
    SIMP_TAC [COMPACT_UNION, COMPACT_SING])

  let CLOSURE_SING ← prove
   r"!x:real^N. closure {x} = {x}"
   (SIMP_TAC [CLOSURE_CLOSED, CLOSED_SING])

  let CLOSURE_INSERT ← prove
   r"!s a:real^N. closure(a INSERT s) = a INSERT closure s"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = {a} UNION s")] THEN
    REWRITE_TAC [CLOSURE_UNION, CLOSURE_SING])

  let CLOSURE_DELETE ← prove
   r"!s a:real^N.
        closure(s DELETE a) =
        if a limit_point_of s then closure s else closure s DELETE a"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [closure, EXTENSION, IN_UNION, IN_DELETE, IN_ELIM_THM] THEN
    REWRITE_TAC [LIMPT_DELETE] THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM SET_TAC [])

  let CLOSED_INSERT ← prove
   r"!a s. closed s ==> closed(a INSERT s)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = {a} UNION s")] THEN
    SIMP_TAC [CLOSED_UNION, CLOSED_SING])

  let CONNECTED_2 ← prove
   r"!a b:real^N. connected {a,b} <=> a = b"
   (REPEAT GEN_TAC THEN SIMP_TAC [CONNECTED_INSERT, CONNECTED_SING] THEN
    REWRITE_TAC [CLOSURE_SING] THEN SET_TAC [])

  let COMPACT_CBALL ← prove
   r"!x e. compact(cball(x,e))"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_CBALL, CLOSED_CBALL])

  let COMPACT_FRONTIER_BOUNDED ← prove
   r"!s. bounded s ==> compact(frontier s)"
   (SIMP_TAC [frontier, COMPACT_EQ_BOUNDED_CLOSED,
              CLOSED_DIFF, OPEN_INTERIOR, CLOSED_CLOSURE] THEN
    MESON_TAC [SUBSET_DIFF, BOUNDED_SUBSET, BOUNDED_CLOSURE])

  let COMPACT_FRONTIER ← prove
   r"!s. compact s ==> compact (frontier s)"
   (MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, COMPACT_FRONTIER_BOUNDED])

  let BOUNDED_FRONTIER ← prove
   r"!s:real^N->bool. bounded s ==> bounded(frontier s)"
   (MESON_TAC [COMPACT_FRONTIER_BOUNDED, COMPACT_IMP_BOUNDED])

  let FRONTIER_SUBSET_COMPACT ← prove
   r"!s. compact s ==> frontier s SUBSET s"
   (MESON_TAC [FRONTIER_SUBSET_CLOSED, COMPACT_EQ_BOUNDED_CLOSED])

  let OPEN_DELETE ← do
    let lemma ← prove r"s DELETE x = s DIFF {x}" (SET_TAC [])
    prove
     r"!s x. open s ==> open(s DELETE x)"
     (SIMP_TAC [lemma, OPEN_DIFF, CLOSED_SING])

  let OPEN_IN_DELETE ← prove
   r"!u s a:real^N.
        open_in (subtopology euclidean u) s
        ==> open_in (subtopology euclidean u) (s DELETE a)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN s") THENL
     [ONCE_REWRITE_TAC [← SET_RULE (← q r"s DELETE a = s DIFF {a}")] THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [CLOSED_IN_SING] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN ASM SET_TAC [],
      ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> s DELETE a = s")]])

  let CLOSED_INTERS_COMPACT ← prove
   r"!s:real^N->bool.
        closed s <=> !e. compact(cball(vec 0,e) INTER s)"
   (GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_INTER, CLOSED_CBALL,
                BOUNDED_INTER, BOUNDED_CBALL],
      ALL_TAC] THEN
    STRIP_TAC THEN REWRITE_TAC [CLOSED_LIMPT] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"norm(x:real^N) + &1")) THEN
    DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IMP_CLOSED) THEN
    REWRITE_TAC [CLOSED_LIMPT] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
    REWRITE_TAC [IN_INTER] THEN ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC [LIMPT_APPROACHABLE] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"min e (&1 / &2)")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, MATCH_MP_TAC MONO_EXISTS] THEN
    X_GEN_TAC (← q r"y:real^N") THEN SIMP_TAC [IN_INTER, IN_CBALL] THEN NORM_ARITH_TAC)

  let COMPACT_UNIONS ← prove
   r"!s. FINITE s /\ (!t. t IN s ==> compact t) ==> compact(UNIONS s)"
   (SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_UNIONS, BOUNDED_UNIONS])

  let COMPACT_DIFF ← prove
   r"!s t. compact s /\ open t ==> compact(s DIFF t)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
    SIMP_TAC [COMPACT_INTER_CLOSED, ← GSYM OPEN_CLOSED])

  let COMPACT_SPHERE ← prove
   r"!a:real^N r. compact(sphere(a,r))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM FRONTIER_CBALL] THEN MATCH_MP_TAC COMPACT_FRONTIER THEN
    REWRITE_TAC [COMPACT_CBALL])

  let BOUNDED_SPHERE ← prove
   r"!a:real^N r. bounded(sphere(a,r))"
   (SIMP_TAC [COMPACT_SPHERE, COMPACT_IMP_BOUNDED])

  let CLOSED_SPHERE ← prove
   r"!a r. closed(sphere(a,r))"
   (SIMP_TAC [COMPACT_SPHERE, COMPACT_IMP_CLOSED])

  let CLOSURE_SPHERE ← prove
   r"!a:real^N r. closure(sphere(a,r)) = sphere(a,r)"
   (REWRITE_TAC [CLOSURE_EQ, CLOSED_SPHERE])

  let FRONTIER_SPHERE ← prove
   r"!a:real^N r. frontier(sphere(a,r)) = sphere(a,r)"
   (REWRITE_TAC [frontier, CLOSURE_SPHERE, INTERIOR_SPHERE, DIFF_EMPTY])

  let FRONTIER_SING ← prove
   r"!a:real^N. frontier {a} = {a}"
   (REWRITE_TAC [frontier, CLOSURE_SING, INTERIOR_SING, DIFF_EMPTY])

  let COMPACT_OPEN ← prove
   r"!s:real^N->bool. compact s /\ open s <=> s = {}"
   (MESON_TAC [COMPACT_EMPTY, OPEN_EMPTY, COMPACT_IMP_CLOSED, CLOPEN,
               COMPACT_IMP_BOUNDED, NOT_BOUNDED_UNIV])

  let COMPACT_IMP_FIP ← prove
   r"!s:real^N->bool f.
        compact s /\
        (!t. t IN f ==> closed t) /\
        (!f'. FINITE f' /\ f' SUBSET f ==> ~(s INTER (INTERS f') = {}))
        ==> ~(s INTER (INTERS f) = {})"
   (REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN, COMPACT_IN_FIP] THEN
    REWRITE_TAC [CLOSED_IN_EUCLIDEAN] THEN MESON_TAC [])

  let CLOSED_IMP_FIP ← prove
   r"!s:real^N->bool f.
        closed s /\
        (!t. t IN f ==> closed t) /\ (?t. t IN f /\ bounded t) /\
        (!f'. FINITE f' /\ f' SUBSET f ==> ~(s INTER (INTERS f') = {}))
        ==> ~(s INTER (INTERS f) = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"~((s INTER t) INTER u = {}) ==> ~(s INTER u = {})")) THEN
    MATCH_MP_TAC COMPACT_IMP_FIP THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [CLOSED_INTER_COMPACT, COMPACT_EQ_BOUNDED_CLOSED],
      REWRITE_TAC [INTER_ASSOC] THEN ONCE_REWRITE_TAC [← GSYM INTERS_INSERT]] THEN
    GEN_TAC THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [FINITE_INSERT, INSERT_SUBSET])

  let CLOSED_IMP_FIP_COMPACT ← prove
   r"!s:real^N->bool f.
        closed s /\ (!t. t IN f ==> compact t) /\
        (!f'. FINITE f' /\ f' SUBSET f ==> ~(s INTER (INTERS f') = {}))
        ==> ~(s INTER (INTERS f) = {})"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THEN
    ASM_SIMP_TAC [SUBSET_EMPTY, INTERS_0, INTER_UNIV] THENL
     [MESON_TAC [FINITE_EMPTY], ALL_TAC] THEN
    STRIP_TAC THEN MATCH_MP_TAC CLOSED_IMP_FIP THEN
    ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, MEMBER_NOT_EMPTY])

  let CLOSED_FIP ← prove
   r"!f. (!t:real^N->bool. t IN f ==> closed t) /\ (?t. t IN f /\ bounded t) /\
       (!f'. FINITE f' /\ f' SUBSET f ==> ~(INTERS f' = {}))
       ==> ~(INTERS f = {})"
   (GEN_TAC THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"s = {} <=> UNIV INTER s = {}")] THEN
    MATCH_MP_TAC CLOSED_IMP_FIP THEN ASM_REWRITE_TAC [CLOSED_UNIV, INTER_UNIV])

  let COMPACT_FIP ← prove
   r"!f. (!t:real^N->bool. t IN f ==> compact t) /\
       (!f'. FINITE f' /\ f' SUBSET f ==> ~(INTERS f' = {}))
       ==> ~(INTERS f = {})"
   (GEN_TAC THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"s = {} <=> UNIV INTER s = {}")] THEN
    MATCH_MP_TAC CLOSED_IMP_FIP_COMPACT THEN
    ASM_REWRITE_TAC [CLOSED_UNIV, INTER_UNIV])

  return { COMPACT_INSERT, CLOSURE_SING, CLOSURE_INSERT, CLOSURE_DELETE, CLOSED_INSERT,
           CONNECTED_2, COMPACT_CBALL, COMPACT_FRONTIER_BOUNDED, COMPACT_FRONTIER,
           BOUNDED_FRONTIER, FRONTIER_SUBSET_COMPACT, OPEN_DELETE, OPEN_IN_DELETE,
           CLOSED_INTERS_COMPACT, COMPACT_UNIONS, COMPACT_DIFF, COMPACT_SPHERE, BOUNDED_SPHERE,
           CLOSED_SPHERE, CLOSURE_SPHERE, FRONTIER_SPHERE, FRONTIER_SING, COMPACT_OPEN,
           COMPACT_IMP_FIP, CLOSED_IMP_FIP, CLOSED_IMP_FIP_COMPACT, CLOSED_FIP, COMPACT_FIP }

/- ------------------------------------------------------------------------- -/
/- Nest and chain properties; escaping from compact sets; Cauchy criteria   -/
/- for uniform convergence.  (topology.ml 6235-6465)                         -/
/- ------------------------------------------------------------------------- -/

structure NST where
  BOUNDED_CLOSED_NEST : thm
  DECREASING_CLOSED_NEST : thm
  DECREASING_CLOSED_NEST_SING : thm
  BOUNDED_CLOSED_CHAIN : thm
  COMPACT_CHAIN : thm
  COMPACT_NEST : thm
  SEQUENCE_ESCAPES : thm
  SEQUENCE_ESCAPES_ALT : thm
  CONVERGENT_SUBSEQUENCE : thm
  UNIFORMLY_CONVERGENT_EQ_CAUCHY : thm
  UNIFORMLY_CONVERGENT_EQ_CAUCHY_ALT : thm
  UNIFORMLY_CAUCHY_IMP_UNIFORMLY_CONVERGENT : thm
  deriving Inhabited

@[nospecialize]
def setupNST [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLOC : LOC) (BLIM2 : LIM2) (BUNQ : UNQ)
    (BSEQ : SEQ) (BCPT : CPT) (BCMP : CMP) (BCPP1 : CPP1) (BCPP2 : CPP2) :
    ExceptT String IO NST := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { ADD_SYM, EXTENSION, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE, GE, IMAGE_o, IMP_CONJ, INFINITE,
        INFINITE_ENUMERATE, INSERT_SUBSET, INTERS_0, INTERS_GSPEC, IN_ELIM_THM, IN_INTERS,
        IN_SING, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_0, LE_ADD, LE_CASES, LE_REFL, LE_TRANS,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, .. } := D.core3
  let { REAL_LT_REFL, .. } := D.core4
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, .. } := D.core5
  let { WLOG_LE, WLOG_LT, num_FINITE, o_ASSOC, o_THM, .. } := D.core6
  let { MONOTONE_BIGGER, REAL_HALF, .. } := D.misc
  let { DIST_POS_LT, DIST_REFL, DIST_SYM, DIST_TRIANGLE_HALF_L, .. } := D.vec1
  let { COMPACT_SPACE_NEST, .. } := D.met1
  let { EVENTUALLY_IN_SEQUENTIALLY, MTOPOLOGY_SUBMETRIC, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { MTOPOLOGY_EUCLIDEAN_METRIC, .. } := BEUC
  let { CLOSED_SUBSET, .. } := BLOC
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_UNIQUE, .. } := BUNQ
  let { CLOSED_APPROACHABLE, .. } := BSEQ
  let { COMPACT_EQ_BOUNDED_CLOSED, COMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY, compact, .. } := BCPT
  let { COMPLETE_UNIV, CONVERGENT_EQ_CAUCHY, cauchy, complete, .. } := BCMP
  let { COMPACT_SEQUENCE_WITH_LIMIT, .. } := BCPP1
  let { COMPACT_IMP_FIP, .. } := BCPP2
  -- @@SCOPE END

  let BOUNDED_CLOSED_NEST ← prove
   r"!s. (!n. closed(s n)) /\ (!n. ~(s n = {})) /\
       (!m n. m <= n ==> s(n) SUBSET s(m)) /\
       bounded(s 0)
       ==> ?a:real^N. !n:num. a IN s(n)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPEC
     (← q r"submetric euclidean_metric ((s:num->real^N->bool) 0)")
     COMPACT_SPACE_NEST) THEN
    ASM_REWRITE_TAC [COMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY, MTOPOLOGY_SUBMETRIC,
                     MTOPOLOGY_EUCLIDEAN_METRIC, COMPACT_EQ_BOUNDED_CLOSED] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [CLOSED_SUBSET, LE_0] THEN ASM SET_TAC [])

  let DECREASING_CLOSED_NEST ← prove
   r"!s. (!n. closed(s n)) /\ (!n. ~(s n = {})) /\
       (!m n. m <= n ==> s(n) SUBSET s(m)) /\
       (!e. &0 < e ==> ?n. !x y. x IN s(n) /\ y IN s(n) ==> dist(x,y) < e)
       ==> ?a:real^N. !n:num. a IN s(n)"
   (GEN_TAC THEN REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, SKOLEM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_TAC (← q r"a:num->real^N")) STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"?l:real^N. (a --> l) sequentially") MP_TAC THENL
     [ASM_MESON_TAC [cauchy, GE, SUBSET, LE_TRANS, LE_REFL,
                     complete, COMPLETE_UNIV, IN_UNIV],
      ASM_MESON_TAC [LIM_SEQUENTIALLY, CLOSED_APPROACHABLE,
                     SUBSET, LE_REFL, LE_TRANS, LE_CASES]])

  let DECREASING_CLOSED_NEST_SING ← prove
   r"!s. (!n. closed(s n)) /\ (!n. ~(s n = {})) /\
       (!m n. m <= n ==> s(n) SUBSET s(m)) /\
       (!e. &0 < e ==> ?n. !x y. x IN s(n) /\ y IN s(n) ==> dist(x,y) < e)
       ==> ?a:real^N. INTERS {t | ?n:num. t = s n} = {a}"
   (GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP DECREASING_CLOSED_NEST) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
    DISCH_TAC THEN REWRITE_TAC [EXTENSION, IN_INTERS, IN_SING, IN_ELIM_THM] THEN
    ASM_MESON_TAC [DIST_POS_LT, REAL_LT_REFL, SUBSET, LE_CASES])

  let BOUNDED_CLOSED_CHAIN ← prove
   r"!f b:real^N->bool.
        (!s. s IN f ==> closed s /\ ~(s = {})) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s) /\
         b IN f /\ bounded b
         ==> ~(INTERS f = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(b INTER (INTERS f):real^N->bool = {})") MP_TAC THENL
     [ALL_TAC, SET_TAC []] THEN
    MATCH_MP_TAC COMPACT_IMP_FIP THEN
    ASM_SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN
    X_GEN_TAC (← q r"u:(real^N->bool)->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?s:real^N->bool. s IN f /\ !t. t IN u ==> s SUBSET t")
    MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    UNDISCH_TAC (← q r"(u:(real^N->bool)->bool) SUBSET f") THEN
    UNDISCH_TAC (← q r"FINITE(u:(real^N->bool)->bool)") THEN
    SPEC_TAC (← q r"u:(real^N->bool)->bool", ← q r"u:(real^N->bool)->bool") THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"u:(real^N->bool)->bool"] THEN
    REWRITE_TAC [INSERT_SUBSET] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]) THEN
    ASM SET_TAC [])

  let COMPACT_CHAIN ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> compact s /\ ~(s = {})) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> ~(INTERS f = {})"
   (GEN_TAC THEN REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THENL
     [ASM_REWRITE_TAC [INTERS_0] THEN SET_TAC [],
      MATCH_MP_TAC BOUNDED_CLOSED_CHAIN THEN ASM SET_TAC []])

  let COMPACT_NEST ← prove
   r"!s. (!n. compact(s n) /\ ~(s n = {})) /\
       (!m n. m <= n ==> s n SUBSET s m)
       ==> ~(INTERS {s n | n IN (:num)} = {})"
   (GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC COMPACT_CHAIN THEN
    ASM_SIMP_TAC [FORALL_IN_GSPEC, IN_UNIV, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC WLOG_LE THEN ASM_MESON_TAC [])

  let SEQUENCE_ESCAPES ← prove
   r"!s x:num->real^N.
      (!n. x n IN s)
      ==> ((!k. k SUBSET s /\ compact k ==> FINITE {n | x n IN k}) <=>
           ~(?y r. y IN s /\
                  (!m n. m < n ==> r m < r n) /\
                  (x o r --> y) sequentially))"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"(p <=> ~q) <=> (~p <=> q)")] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN EQ_TAC THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
     [X_GEN_TAC (← q r"k:real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM INFINITE]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP INFINITE_ENUMERATE) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(x:num->real^N) o (r:num->num)")) THEN
      REWRITE_TAC [o_THM] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:num->num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(r:num->num) o (q:num->num)") THEN
      ASM_SIMP_TAC [o_ASSOC, o_THM] THEN ASM SET_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"y:real^N", ← q r"r:num->num"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"y INSERT (IMAGE ((x:num->real^N) o r) (:num))") THEN
      ASM_SIMP_TAC [COMPACT_SEQUENCE_WITH_LIMIT, INSERT_SUBSET, IMAGE_o] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (r:num->num) (:num)")) THEN
      REWRITE_TAC [num_FINITE, NOT_IMP, FORALL_IN_IMAGE, IN_UNIV] THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n + 1"))) THEN
      MATCH_MP_TAC (← ARITH_RULE (← q r"n + 1 <= x ==> x <= n ==> F")) THEN
      ASM_MESON_TAC [MONOTONE_BIGGER]])

  let SEQUENCE_ESCAPES_ALT ← prove
   r"!s x:num->real^N.
      (!n. x n IN s)
      ==> ((!k. k SUBSET s /\ compact k
                ==> eventually (\n. ~(x n IN k)) sequentially) <=>
           ~(?y r. y IN s /\
                  (!m n. m < n ==> r m < r n) /\
                  (x o r --> y) sequentially))"
   (REWRITE_TAC [EVENTUALLY_IN_SEQUENTIALLY, SEQUENCE_ESCAPES])

  let CONVERGENT_SUBSEQUENCE ← prove
   r"!s x:num->real^N.
      (!n. x n IN s)
      ==> ((?y r. y IN s /\
                  (!m n. m < n ==> r m < r n) /\
                  (x o r --> y) sequentially) <=>
           (?k. k SUBSET s /\ compact k /\ INFINITE {n | x(n) IN k}))"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o
      AP_TERM (← q r"~") o MATCH_MP SEQUENCE_ESCAPES) THEN
    REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [NOT_FORALL_THM, INFINITE] THEN
    MESON_TAC [])

  let UNIFORMLY_CONVERGENT_EQ_CAUCHY ← prove
   r"!P s:num->A->real^N.
         (?l. !e. &0 < e
                  ==> ?N. !n x. N <= n /\ P x ==> dist(s n x,l x) < e) <=>
         (!e. &0 < e
              ==> ?N. !m n x. N <= m /\ N <= n /\ P x
                              ==> dist(s m x,s n x) < e)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_TAC (← q r"l:A->real^N")) THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN MESON_TAC [DIST_TRIANGLE_HALF_L],
      ALL_TAC] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"!x:A. P x ==> cauchy (\n. s n x :real^N)") MP_TAC THENL
     [REWRITE_TAC [cauchy, GE] THEN ASM_MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← GSYM CONVERGENT_EQ_CAUCHY, LIM_SEQUENTIALLY] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"l:A->real^N") THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"M:num")) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"N + M:num", ← q r"x:A"]) THEN
    ASM_REWRITE_TAC [LE_ADD] THEN ONCE_REWRITE_TAC [ADD_SYM] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"M + N:num")) THEN REWRITE_TAC [LE_ADD] THEN
    ASM_MESON_TAC [DIST_TRIANGLE_HALF_L, DIST_SYM])

  let UNIFORMLY_CONVERGENT_EQ_CAUCHY_ALT ← prove
   r"!P s:num->A->real^N.
         (?l. !e. &0 < e
                  ==> ?N. !n x. N <= n /\ P x ==> dist(s n x,l x) < e) <=>
         (!e. &0 < e
              ==> ?N. !m n x. N <= m /\ N <= n /\ m < n /\ P x
                              ==> dist(s m x,s n x) < e)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [UNIFORMLY_CONVERGENT_EQ_CAUCHY] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [] THEN MATCH_MP_TAC WLOG_LT THEN
    ASM_SIMP_TAC [DIST_REFL] THEN MESON_TAC [DIST_SYM])

  let UNIFORMLY_CAUCHY_IMP_UNIFORMLY_CONVERGENT ← prove
   r"!P (s:num->A->real^N) l.
    (!e. &0 < e
         ==> ?N. !m n x. N <= m /\ N <= n /\ P x ==> dist(s m x,s n x) < e) /\
    (!x. P x ==> !e. &0 < e ==> ?N. !n. N <= n ==> dist(s n x,l x) < e)
    ==> (!e. &0 < e ==> ?N. !n x. N <= n /\ P x ==> dist(s n x,l x) < e)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM UNIFORMLY_CONVERGENT_EQ_CAUCHY] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"l':A->real^N")) ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"!x. P x ==> (l:A->real^N) x = l' x") MP_TAC THENL
     [ALL_TAC, ASM_MESON_TAC []] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
    EXISTS_TAC (← q r"\n. (s:num->A->real^N) n x") THEN
    REWRITE_TAC [LIM_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
    ASM_MESON_TAC [])

  return { BOUNDED_CLOSED_NEST, DECREASING_CLOSED_NEST, DECREASING_CLOSED_NEST_SING,
           BOUNDED_CLOSED_CHAIN, COMPACT_CHAIN, COMPACT_NEST, SEQUENCE_ESCAPES,
           SEQUENCE_ESCAPES_ALT, CONVERGENT_SUBSEQUENCE, UNIFORMLY_CONVERGENT_EQ_CAUCHY,
           UNIFORMLY_CONVERGENT_EQ_CAUCHY_ALT, UNIFORMLY_CAUCHY_IMP_UNIFORMLY_CONVERGENT }

/- ------------------------------------------------------------------------- -/
/- Continuity over a net; epsilon-delta forms; versions in terms of open    -/
/- balls.  (topology.ml 6466-6624)                                           -/
/- ------------------------------------------------------------------------- -/

structure CNT1 where
  continuous : thm
  CONTINUOUS_TRIVIAL_LIMIT : thm
  CONTINUOUS_WITHIN : thm
  LIM_CONTINUOUS_SELF_WITHIN : thm
  CONTINUOUS_AT : thm
  LIM_CONTINUOUS_SELF_AT : thm
  CONTINUOUS_AT_WITHIN : thm
  CONTINUOUS_WITHIN_CLOSED_NONTRIVIAL : thm
  CONTINUOUS_TRANSFORM_WITHIN : thm
  CONTINUOUS_TRANSFORM_AT : thm
  CONTINUOUS_TRANSFORM_WITHIN_OPEN : thm
  CONTINUOUS_TRANSFORM_WITHIN_OPEN_IN : thm
  CONTINUOUS_TRANSFORM_WITHIN_SET_IMP : thm
  continuous_within : thm
  continuous_at : thm
  CONTINUOUS_WITHIN_COMPARISON : thm
  CONTINUOUS_EQ_CAUCHY_WITHIN : thm
  CONTINUOUS_EQ_CAUCHY_AT : thm
  CONTINUOUS_WITHIN_BALL : thm
  CONTINUOUS_AT_BALL : thm
  deriving Inhabited

@[nospecialize]
def setupCNT1 [HolBase] (D : TopologyDeps) (BBAL : BAL) (BNET : NET) (BEVT : EVT) (BLIM1 : LIM1)
    (BLIM2 : LIM2) (BRLM : RLM) (BTRN : TRN) : ExceptT String IO CNT1 := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ASM_MESON_TAC, MESON_TAC, NORM_ARITH, .. } := D
  let { FORALL_IN_IMAGE, IN_INSERT, IN_INTER, .. } := D.core2
  let { IN_UNIV, MONO_EXISTS, .. } := D.core3
  let { REAL_LET_TRANS, .. } := D.core4
  let { SUBSET, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { DIST_NZ, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { IN_BALL, .. } := BBAL
  let { NETLIMIT_WITHIN, WITHIN_UNIV, .. } := BNET
  let { LIM_WITHIN_CLOSED_TRIVIAL, .. } := BEVT
  let { LIM_TRIVIAL, .. } := BLIM1
  let { LIM_WITHIN, .. } := BLIM2
  let { LIM_AT_WITHIN, .. } := BRLM
  let { LIM_TRANSFORM_AT, LIM_TRANSFORM_WITHIN, LIM_TRANSFORM_WITHIN_OPEN,
        LIM_TRANSFORM_WITHIN_OPEN_IN, LIM_TRANSFORM_WITHIN_SET_IMP, .. } := BTRN
  -- @@SCOPE END

  parse_as_infix ("continuous", (12, "right"))

  let continuous ← new_definition
   r"f continuous net <=> (f --> f(netlimit net)) net"

  let CONTINUOUS_TRIVIAL_LIMIT ← prove
   r"!f net. trivial_limit net ==> f continuous net"
   (SIMP_TAC [continuous, LIM_TRIVIAL])

  let CONTINUOUS_WITHIN ← prove
   r"!f x:real^M. f continuous (at x within s) <=> (f --> f(x)) (at x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous] THEN
    ASM_CASES_TAC (← q r"trivial_limit(at (x:real^M) within s)") THEN
    ASM_SIMP_TAC [LIM_TRIVIAL, NETLIMIT_WITHIN])

  let LIM_CONTINUOUS_SELF_WITHIN ← prove
   r"!f:real^M->real^N s x y.
        f continuous (at x within s) /\ f x = y ==> (f --> y) (at x within s)"
   (REWRITE_TAC [CONTINUOUS_WITHIN] THEN MESON_TAC [])

  let CONTINUOUS_AT ← prove
   r"!f (x:real^N). f continuous (at x) <=> (f --> f(x)) (at x)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_WITHIN, IN_UNIV])

  let LIM_CONTINUOUS_SELF_AT ← prove
   r"!f:real^M->real^N x y.
        f continuous (at x) /\ f x = y ==> (f --> y) (at x)"
   (REWRITE_TAC [CONTINUOUS_AT] THEN MESON_TAC [])

  let CONTINUOUS_AT_WITHIN ← prove
   r"!f:real^M->real^N x s.
        f continuous (at x) ==> f continuous (at x within s)"
   (SIMP_TAC [LIM_AT_WITHIN, CONTINUOUS_AT, CONTINUOUS_WITHIN])

  let CONTINUOUS_WITHIN_CLOSED_NONTRIVIAL ← prove
   r"!a s. closed s /\ ~(a IN s) ==> f continuous (at a within s)"
   (ASM_SIMP_TAC [CONTINUOUS_TRIVIAL_LIMIT, LIM_WITHIN_CLOSED_TRIVIAL])

  let CONTINUOUS_TRANSFORM_WITHIN ← prove
   r"!f g:real^M->real^N s x d.
        &0 < d /\ x IN s /\
        (!x'. x' IN s /\ dist(x',x) < d ==> f(x') = g(x')) /\
        f continuous (at x within s)
        ==> g continuous (at x within s)"
   (REWRITE_TAC [CONTINUOUS_WITHIN] THEN
    MESON_TAC [LIM_TRANSFORM_WITHIN, DIST_REFL])

  let CONTINUOUS_TRANSFORM_AT ← prove
   r"!f g:real^M->real^N x d.
        &0 < d /\ (!x'. dist(x',x) < d ==> f(x') = g(x')) /\
        f continuous (at x)
        ==> g continuous (at x)"
   (REWRITE_TAC [CONTINUOUS_AT] THEN
    MESON_TAC [LIM_TRANSFORM_AT, DIST_REFL])

  let CONTINUOUS_TRANSFORM_WITHIN_OPEN ← prove
   r"!f g:real^M->real^N s a.
        open s /\ a IN s /\
        (!x. x IN s ==> f x = g x) /\
        f continuous at a
        ==> g continuous at a"
   (MESON_TAC [CONTINUOUS_AT, LIM_TRANSFORM_WITHIN_OPEN])

  let CONTINUOUS_TRANSFORM_WITHIN_OPEN_IN ← prove
   r"!f g:real^M->real^N s t a.
        open_in (subtopology euclidean t) s /\ a IN s /\
        (!x. x IN s ==> f x = g x) /\
        f continuous (at a within t)
        ==> g continuous (at a within t)"
   (MESON_TAC [CONTINUOUS_WITHIN, LIM_TRANSFORM_WITHIN_OPEN_IN])

  let CONTINUOUS_TRANSFORM_WITHIN_SET_IMP ← prove
   r"!f a s t. eventually (\x. x IN t ==> x IN s) (at a) /\
             f continuous (at a within s)
             ==> f continuous (at a within t)"
   (REWRITE_TAC [CONTINUOUS_WITHIN, LIM_TRANSFORM_WITHIN_SET_IMP])

  let continuous_within ← prove
   r"f continuous (at x within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x'. x' IN s /\ dist(x',x) < d ==> dist(f(x'),f(x)) < e"
   (REWRITE_TAC [CONTINUOUS_WITHIN, LIM_WITHIN] THEN
    REWRITE_TAC [← GSYM DIST_NZ] THEN MESON_TAC [DIST_REFL])

  let continuous_at ← prove
   r"f continuous (at x) <=>
        !e. &0 < e ==> ?d. &0 < d /\
                           !x'. dist(x',x) < d ==> dist(f(x'),f(x)) < e"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [continuous_within, IN_UNIV])

  let CONTINUOUS_WITHIN_COMPARISON ← prove
   r"!f:real^M->real^N g:real^M->real^P s a.
        g continuous (at a within s) /\
        (!x. x IN s ==> dist(f a,f x) <= dist(g a,g x))
        ==> f continuous (at a within s)"
   (ONCE_REWRITE_TAC [DIST_SYM] THEN
    REWRITE_TAC [continuous_within] THEN MESON_TAC [REAL_LET_TRANS])

  let CONTINUOUS_EQ_CAUCHY_WITHIN ← prove
   r"!f:real^M->real^N s a.
        f continuous (at a within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x x'. x IN a INSERT s /\ dist(x,a) < d /\
                           x' IN a INSERT s /\ dist(x',a) < d
                           ==> dist(f x,f x') < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_within, IN_INSERT] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [DIST_REFL]] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [DIST_REFL] THEN
    ASM_SIMP_TAC [← NORM_ARITH (← q r"dist(x:real^N,a) < e / &2 ==> dist(a,x) < e")] THEN
    ASM_SIMP_TAC [← NORM_ARITH (← q r"dist(x:real^N,a) < e / &2 ==> dist(x,a) < e")] THEN
    ASM_MESON_TAC [← NORM_ARITH
     (← q r"dist(x:real^N,a) < e / &2 /\ dist(y,a) < e / &2 ==> dist(x,y) < e")])

  let CONTINUOUS_EQ_CAUCHY_AT ← prove
   r"!f:real^M->real^N a.
        f continuous (at a) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x x'. dist(x,a) < d /\ dist(x',a) < d
                           ==> dist(f x,f x') < e"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_EQ_CAUCHY_WITHIN, IN_INSERT, IN_UNIV])

  let CONTINUOUS_WITHIN_BALL ← prove
   r"!f s x. f continuous (at x within s) <=>
                !e. &0 < e
                    ==> ?d. &0 < d /\
                            IMAGE f (ball(x,d) INTER s) SUBSET ball(f x,e)"
   (SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_BALL, continuous_within, IN_INTER] THEN
    MESON_TAC [DIST_SYM])

  let CONTINUOUS_AT_BALL ← prove
   r"!f x. f continuous (at x) <=>
                !e. &0 < e
                    ==> ?d. &0 < d /\
                            IMAGE f (ball(x,d)) SUBSET ball(f x,e)"
   (SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_BALL, continuous_at] THEN
    MESON_TAC [DIST_SYM])

  return { continuous, CONTINUOUS_TRIVIAL_LIMIT, CONTINUOUS_WITHIN, LIM_CONTINUOUS_SELF_WITHIN,
           CONTINUOUS_AT, LIM_CONTINUOUS_SELF_AT, CONTINUOUS_AT_WITHIN,
           CONTINUOUS_WITHIN_CLOSED_NONTRIVIAL, CONTINUOUS_TRANSFORM_WITHIN,
           CONTINUOUS_TRANSFORM_AT, CONTINUOUS_TRANSFORM_WITHIN_OPEN,
           CONTINUOUS_TRANSFORM_WITHIN_OPEN_IN, CONTINUOUS_TRANSFORM_WITHIN_SET_IMP,
           continuous_within, continuous_at, CONTINUOUS_WITHIN_COMPARISON,
           CONTINUOUS_EQ_CAUCHY_WITHIN, CONTINUOUS_EQ_CAUCHY_AT, CONTINUOUS_WITHIN_BALL,
           CONTINUOUS_AT_BALL }

/- ------------------------------------------------------------------------- -/
/- For setwise continuity, just start from the epsilon-delta definitions.   -/
/- (topology.ml 6626-6728)                                                   -/
/- ------------------------------------------------------------------------- -/

structure CNO where
  continuous_on : thm
  uniformly_continuous_on : thm
  CONTINUOUS_MAP_EUCLIDEAN : thm
  CONTINUOUS_MAP_EUCLIDEAN_EUCLIDEAN : thm
  CONTINUOUS_MAP_EUCLIDEAN2 : thm
  UNIFORMLY_CONTINUOUS_MAP_EUCLIDEAN : thm
  UNIFORMLY_CONTINUOUS_MAP_LIFT : thm
  UNIFORMLY_CONTINUOUS_MAP_DROP : thm
  UNIFORMLY_CONTINUOUS_MAP_EQ_LIFT : thm
  UNIFORMLY_CONTINUOUS_MAP_EQ_DROP : thm
  UNIFORMLY_CONTINUOUS_MAP_LIFT_EQ : thm
  UNIFORMLY_CONTINUOUS_MAP_DROP_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupCNO [HolBase] (D : TopologyDeps) (BEUC : EUC) : ExceptT String IO CNO := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ASM_MESON_TAC, MESON_TAC, .. } := D
  let { ETA_AX, .. } := D.core1
  let { INTER_UNIV, IN_INTER, .. } := D.core2
  let { IN_UNIV, REAL_ABS_SUB, .. } := D.core3
  let { SUBSET_UNIV, .. } := D.core5
  let { o_DEF, .. } := D.core6
  let { DIST_LIFT, DIST_SYM, DROP_SUB, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { NORM_1, NORM_SUB, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := D.met1
  let { METRIC_CONTINUOUS_MAP, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, MTOPOLOGY_SUBMETRIC, .. } := D.met2
  let { REAL_EUCLIDEAN_METRIC, SUBMETRIC, SUBTOPOLOGY_UNIV, UNIFORMLY_CONTINUOUS_MAP_COMPOSE,
        uniformly_continuous_map, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  -- @@SCOPE END

  parse_as_infix ("continuous_on", (12, "right"))
  parse_as_infix ("uniformly_continuous_on", (12, "right"))

  let continuous_on ← new_definition
   r"f continuous_on s <=>
        !x. x IN s ==> !e. &0 < e
                           ==> ?d. &0 < d /\
                                   !x'. x' IN s /\ dist(x',x) < d
                                        ==> dist(f(x'),f(x)) < e"

  let uniformly_continuous_on ← new_definition
   r"f uniformly_continuous_on s <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x x'. x IN s /\ x' IN s /\ dist(x',x) < d
                           ==> dist(f(x'),f(x)) < e"

  let CONTINUOUS_MAP_EUCLIDEAN ← prove
   r"!f:real^N->real^M s.
     continuous_map (subtopology euclidean s,euclidean) f <=>
     f continuous_on s"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
                 ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC,
                 ← GSYM MTOPOLOGY_SUBMETRIC] THEN
    REWRITE_TAC [METRIC_CONTINUOUS_MAP, continuous_on] THEN
    REWRITE_TAC [SUBMETRIC, EUCLIDEAN_METRIC, IN_UNIV, IN_INTER] THEN
    REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [DIST_SYM] THEN
    MESON_TAC [])

  let CONTINUOUS_MAP_EUCLIDEAN_EUCLIDEAN ← prove
   r"!(f:real^M->real^N).
        continuous_map (euclidean,euclidean) f <=> f continuous_on (:real^M)"
   (MESON_TAC [SUBTOPOLOGY_UNIV, CONTINUOUS_MAP_EUCLIDEAN, SUBSET_UNIV])

  let CONTINUOUS_MAP_EUCLIDEAN2 ← prove
   r"!(f:real^M->real^N) s t.
        continuous_map (subtopology euclidean s,subtopology euclidean t) f <=>
        f continuous_on s /\ IMAGE f s SUBSET t"
   (REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_EUCLIDEAN] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let UNIFORMLY_CONTINUOUS_MAP_EUCLIDEAN ← prove
   r"!f:real^N->real^M s.
     uniformly_continuous_map
      (submetric euclidean_metric s,euclidean_metric) f <=>
     f uniformly_continuous_on s"
   (REWRITE_TAC [uniformly_continuous_map, uniformly_continuous_on] THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, SUBMETRIC, INTER_UNIV, SUBSET_UNIV])

  let UNIFORMLY_CONTINUOUS_MAP_LIFT ← prove
   r"uniformly_continuous_map (real_euclidean_metric,euclidean_metric) lift"
   (REWRITE_TAC [uniformly_continuous_map, REAL_EUCLIDEAN_METRIC,
                 EUCLIDEAN_METRIC, IN_UNIV, SUBSET_UNIV, DIST_LIFT] THEN
    MESON_TAC [REAL_ABS_SUB])

  let UNIFORMLY_CONTINUOUS_MAP_DROP ← prove
   r"uniformly_continuous_map (euclidean_metric,real_euclidean_metric) drop"
   (REWRITE_TAC [uniformly_continuous_map, REAL_EUCLIDEAN_METRIC,
                 EUCLIDEAN_METRIC, IN_UNIV, SUBSET_UNIV] THEN
    REWRITE_TAC [← GSYM DROP_SUB, ← GSYM NORM_1, dist] THEN
    MESON_TAC [NORM_SUB])

  let UNIFORMLY_CONTINUOUS_MAP_EQ_LIFT ← prove
   r"!m f:A->real.
        uniformly_continuous_map(m,real_euclidean_metric) f <=>
        uniformly_continuous_map(m,euclidean_metric) (lift o f)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [UNIFORMLY_CONTINUOUS_MAP_COMPOSE, UNIFORMLY_CONTINUOUS_MAP_LIFT],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"f:A->real = drop o lift o f") SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX],
      ASM_MESON_TAC [UNIFORMLY_CONTINUOUS_MAP_COMPOSE,
                     UNIFORMLY_CONTINUOUS_MAP_DROP]])

  let UNIFORMLY_CONTINUOUS_MAP_EQ_DROP ← prove
   r"!m f:A->real^1.
        uniformly_continuous_map(m,euclidean_metric) f <=>
        uniformly_continuous_map(m,real_euclidean_metric) (drop o f)"
   (REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_EQ_LIFT, o_DEF, LIFT_DROP, ETA_AX])

  let UNIFORMLY_CONTINUOUS_MAP_LIFT_EQ ← prove
   r"!m f:real^1->A.
        uniformly_continuous_map(euclidean_metric,m) f <=>
        uniformly_continuous_map(real_euclidean_metric,m) (f o lift)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [UNIFORMLY_CONTINUOUS_MAP_COMPOSE, UNIFORMLY_CONTINUOUS_MAP_LIFT],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"f:real^1->A = (f o lift) o drop") SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX],
      ASM_MESON_TAC [UNIFORMLY_CONTINUOUS_MAP_COMPOSE,
                     UNIFORMLY_CONTINUOUS_MAP_DROP]])

  let UNIFORMLY_CONTINUOUS_MAP_DROP_EQ ← prove
   r"!m f:real->A.
        uniformly_continuous_map(real_euclidean_metric,m) f <=>
        uniformly_continuous_map(euclidean_metric,m) (f o drop)"
   (REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_LIFT_EQ, o_DEF, LIFT_DROP, ETA_AX])

  return { continuous_on, uniformly_continuous_on, CONTINUOUS_MAP_EUCLIDEAN,
           CONTINUOUS_MAP_EUCLIDEAN_EUCLIDEAN, CONTINUOUS_MAP_EUCLIDEAN2,
           UNIFORMLY_CONTINUOUS_MAP_EUCLIDEAN, UNIFORMLY_CONTINUOUS_MAP_LIFT,
           UNIFORMLY_CONTINUOUS_MAP_DROP, UNIFORMLY_CONTINUOUS_MAP_EQ_LIFT,
           UNIFORMLY_CONTINUOUS_MAP_EQ_DROP, UNIFORMLY_CONTINUOUS_MAP_LIFT_EQ,
           UNIFORMLY_CONTINUOUS_MAP_DROP_EQ }

/- ------------------------------------------------------------------------- -/
/- Some simple consequential lemmas.  (topology.ml 6729-6847)                -/
/- ------------------------------------------------------------------------- -/

structure CSL where
  CONTINUOUS_ON_COMPARISON : thm
  UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS : thm
  CONTINUOUS_AT_IMP_CONTINUOUS_ON : thm
  CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN : thm
  CONTINUOUS_ON : thm
  CONTINUOUS_ON_EQ_CONTINUOUS_AT : thm
  CONTINUOUS_WITHIN_OPEN_IN : thm
  CONTINUOUS_WITHIN_SUBSET : thm
  CONTINUOUS_ON_SUBSET : thm
  UNIFORMLY_CONTINUOUS_ON_SUBSET : thm
  CONTINUOUS_ON_INTERIOR : thm
  CONTINUOUS_ON_EQ : thm
  UNIFORMLY_CONTINUOUS_ON_EQ : thm
  CONTINUOUS_ON_RESTRICT : thm
  UNIFORMLY_CONTINUOUS_ON_RESTRICT : thm
  CONTINUOUS_ON_SING : thm
  CONTINUOUS_ON_EMPTY : thm
  CONTINUOUS_ON_NO_LIMPT : thm
  CONTINUOUS_ON_FINITE : thm
  CONTRACTION_IMP_CONTINUOUS_ON : thm
  ISOMETRY_ON_IMP_CONTINUOUS_ON : thm
  deriving Inhabited

@[nospecialize]
def setupCSL [HolBase] (D : TopologyDeps) (BLPT : LPT) (BINT : INT) (BLIM2 : LIM2) (BRLM : RLM)
    (BCNT1 : CNT1) (BCNO : CNO) : ExceptT String IO CSL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, .. } := D
  let { EMPTY_SUBSET, .. } := D.core1
  let { FORALL_UNWIND_THM2, IMP_CONJ, IN_ELIM_THM, IN_SING, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LE_REFL, .. } := D.core4
  let { SUBSET, .. } := D.core5
  let { DIST_REFL, .. } := D.vec1
  let { LIMIT_POINT_FINITE, LIMPT_APPROACHABLE, .. } := BLPT
  let { interior, .. } := BINT
  let { LIM_WITHIN_SUBSET, .. } := BLIM2
  let { LIM_WITHIN_OPEN, LIM_WITHIN_OPEN_IN, .. } := BRLM
  let { CONTINUOUS_AT, CONTINUOUS_WITHIN, continuous_at, continuous_within, .. } := BCNT1
  let { continuous_on, uniformly_continuous_on, .. } := BCNO
  -- @@SCOPE END

  let CONTINUOUS_ON_COMPARISON ← prove
   r"!f:real^M->real^N g:real^M->real^P s.
        g continuous_on s /\
        (!x y. x IN s /\ y IN s ==> dist(f x,f y) <= dist(g x,g y))
        ==> f continuous_on s"
   (REWRITE_TAC [continuous_on] THEN MESON_TAC [REAL_LET_TRANS])

  let UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS ← prove
   r"!f s. f uniformly_continuous_on s ==> f continuous_on s"
   (REWRITE_TAC [uniformly_continuous_on, continuous_on] THEN MESON_TAC [])

  let CONTINUOUS_AT_IMP_CONTINUOUS_ON ← prove
   r"!f s. (!x. x IN s ==> f continuous (at x)) ==> f continuous_on s"
   (REWRITE_TAC [continuous_at, continuous_on] THEN MESON_TAC [])

  let CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN ← prove
   r"!f s. f continuous_on s <=> !x. x IN s ==> f continuous (at x within s)"
   (REWRITE_TAC [continuous_on, continuous_within])

  let CONTINUOUS_ON ← prove
   r"!f (s:real^N->bool).
        f continuous_on s <=> !x. x IN s ==> (f --> f(x)) (at x within s)"
   (REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_WITHIN])

  let CONTINUOUS_ON_EQ_CONTINUOUS_AT ← prove
   r"!f:real^M->real^N s.
      open s ==> (f continuous_on s <=> (!x. x IN s ==> f continuous (at x)))"
   (SIMP_TAC [CONTINUOUS_ON, CONTINUOUS_AT, LIM_WITHIN_OPEN])

  let CONTINUOUS_WITHIN_OPEN_IN ← prove
   r"!f:real^M->real^N a s t.
        a IN t /\ open_in (subtopology euclidean s) t
        ==> (f continuous (at a within t) <=> f continuous (at a within s))"
   (REWRITE_TAC [CONTINUOUS_WITHIN] THEN MESON_TAC [LIM_WITHIN_OPEN_IN])

  let CONTINUOUS_WITHIN_SUBSET ← prove
   r"!f s t x. f continuous (at x within s) /\ t SUBSET s
             ==> f continuous (at x within t)"
   (REWRITE_TAC [CONTINUOUS_WITHIN] THEN MESON_TAC [LIM_WITHIN_SUBSET])

  let CONTINUOUS_ON_SUBSET ← prove
   r"!f s t. f continuous_on s /\ t SUBSET s ==> f continuous_on t"
   (REWRITE_TAC [CONTINUOUS_ON] THEN MESON_TAC [SUBSET, LIM_WITHIN_SUBSET])

  let UNIFORMLY_CONTINUOUS_ON_SUBSET ← prove
   r"!f s t. f uniformly_continuous_on s /\ t SUBSET s
           ==> f uniformly_continuous_on t"
   (REWRITE_TAC [uniformly_continuous_on] THEN
    MESON_TAC [SUBSET, LIM_WITHIN_SUBSET])

  let CONTINUOUS_ON_INTERIOR ← prove
   r"!f:real^M->real^N s x.
        f continuous_on s /\ x IN interior(s) ==> f continuous at x"
   (REWRITE_TAC [interior, IN_ELIM_THM] THEN
    MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, CONTINUOUS_ON_SUBSET])

  let CONTINUOUS_ON_EQ ← prove
   r"!f g s. (!x. x IN s ==> f(x) = g(x)) /\ f continuous_on s
           ==> g continuous_on s"
   (SIMP_TAC [continuous_on, IMP_CONJ])

  let UNIFORMLY_CONTINUOUS_ON_EQ ← prove
   r"!f g s.
        (!x. x IN s ==> f x = g x) /\ f uniformly_continuous_on s
        ==> g uniformly_continuous_on s"
   (SIMP_TAC [uniformly_continuous_on, IMP_CONJ])

  let CONTINUOUS_ON_RESTRICT ← prove
   r"!P f g:real^M->real^N s.
        (!x. x IN s ==> P x)
        ==> ((\x. if P x then f x else g x) continuous_on s <=>
             f continuous_on s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_EQ) THEN
    ASM_MESON_TAC [])

  let UNIFORMLY_CONTINUOUS_ON_RESTRICT ← prove
   r"!P f g:real^M->real^N s.
        (!x. x IN s ==> P x)
        ==> ((\x. if P x then f x else g x) uniformly_continuous_on s <=>
             f uniformly_continuous_on s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] UNIFORMLY_CONTINUOUS_ON_EQ) THEN
    ASM_MESON_TAC [])

  let CONTINUOUS_ON_SING ← prove
   r"!f:real^M->real^N a. f continuous_on {a}"
   (SIMP_TAC [continuous_on, IN_SING, FORALL_UNWIND_THM2, DIST_REFL] THEN
    MESON_TAC [])

  let CONTINUOUS_ON_EMPTY ← prove
   r"!f:real^M->real^N. f continuous_on {}"
   (MESON_TAC [CONTINUOUS_ON_SING, EMPTY_SUBSET, CONTINUOUS_ON_SUBSET])

  let CONTINUOUS_ON_NO_LIMPT ← prove
   r"!f:real^M->real^N s.
     ~(?x. x limit_point_of s) ==> f continuous_on s"
   (REWRITE_TAC [continuous_on, LIMPT_APPROACHABLE] THEN MESON_TAC [DIST_REFL])

  let CONTINUOUS_ON_FINITE ← prove
   r"!f:real^M->real^N s. FINITE s ==> f continuous_on s"
   (MESON_TAC [CONTINUOUS_ON_NO_LIMPT, LIMIT_POINT_FINITE])

  let CONTRACTION_IMP_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N.
        (!x y. x IN s /\ y IN s ==> dist(f x,f y) <= dist(x,y))
        ==> f continuous_on s"
   (SIMP_TAC [continuous_on] THEN MESON_TAC [REAL_LET_TRANS])

  let ISOMETRY_ON_IMP_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N.
        (!x y. x IN s /\ y IN s ==> dist(f x,f y) = dist(x,y))
        ==> f continuous_on s"
   (SIMP_TAC [CONTRACTION_IMP_CONTINUOUS_ON, REAL_LE_REFL])

  return { CONTINUOUS_ON_COMPARISON, UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS,
           CONTINUOUS_AT_IMP_CONTINUOUS_ON, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON,
           CONTINUOUS_ON_EQ_CONTINUOUS_AT, CONTINUOUS_WITHIN_OPEN_IN, CONTINUOUS_WITHIN_SUBSET,
           CONTINUOUS_ON_SUBSET, UNIFORMLY_CONTINUOUS_ON_SUBSET, CONTINUOUS_ON_INTERIOR,
           CONTINUOUS_ON_EQ, UNIFORMLY_CONTINUOUS_ON_EQ, CONTINUOUS_ON_RESTRICT,
           UNIFORMLY_CONTINUOUS_ON_RESTRICT, CONTINUOUS_ON_SING, CONTINUOUS_ON_EMPTY,
           CONTINUOUS_ON_NO_LIMPT, CONTINUOUS_ON_FINITE, CONTRACTION_IMP_CONTINUOUS_ON,
           ISOMETRY_ON_IMP_CONTINUOUS_ON }

/- ------------------------------------------------------------------------- -/
/- Characterization of limits and continuity in terms of sequences.         -/
/- (topology.ml 6848-7142)                                                   -/
/- ------------------------------------------------------------------------- -/

structure SQC where
  CONTINUOUS_WITHIN_SEQUENTIALLY : thm
  CONTINUOUS_AT_SEQUENTIALLY : thm
  CONTINUOUS_ON_SEQUENTIALLY : thm
  UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY : thm
  UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY_ALT : thm
  LIM_WITHIN_SEQUENTIALLY : thm
  LIM_WITHIN_SEQUENTIALLY_INJ : thm
  LIM_WITHIN_SEQUENTIALLY_DECREASING : thm
  LIM_AT_SEQUENTIALLY : thm
  CONTINUOUS_WITHIN_SEQUENTIALLY_INJ : thm
  CONTINUOUS_WITHIN_SEQUENTIALLY_ALT : thm
  CONTINUOUS_AT_SEQUENTIALLY_ALT : thm
  CONTINUOUS_AT_SEQUENTIALLY_INJ : thm
  LIM_CONTINUOUS : thm
  LIM_CONTINUOUS_FUNCTION : thm
  LIM_CONTINUOUS_FUNCTION_WITHIN : thm
  LIMIT_POINT_OF_IMAGE_GEN : thm
  LIMIT_POINT_OF_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupSQC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BNET : NET) (BLIM1 : LIM1)
    (BLIM2 : LIM2) (BRLM : RLM) (BCNT1 : CNT1) (BCNO : CNO) (BCSL : CSL) :
    ExceptT String IO SQC := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, REAL_RAT_REDUCE_CONV, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, ARITH, CONTRAPOS_THM, DEPENDENT_CHOICE, FINITE_FINITE_PREIMAGE, .. } :=
    D.core1
  let { FINITE_SING, FINITE_SUBSET, FORALL_AND_THM, INFINITE_DIFF_FINITE, INTER_UNIV, IN_DELETE,
        IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IMP, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_INV2, REAL_LE_RADD, REAL_LTE_TRANS, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_MIN, REAL_LT_REFL, .. } := D.core4
  let { REAL_LT_TRANS, REAL_MUL_LID, REAL_NOT_LT, REAL_OF_NUM_ADD, REAL_OF_NUM_LE,
        REAL_OF_NUM_LT, REAL_POS, SKOLEM_THM, .. } := D.core5
  let { SWAP_FORALL_THM, TRANSITIVE_STEPWISE_LE, TRANSITIVE_STEPWISE_LT, WLOG_LT, num_INFINITE,
        o_DEF, o_THM, real_div, .. } := D.core6
  let { FORALL_POS_MONO_1, INFINITE_ENUMERATE_WEAK, .. } := D.misc
  let { DIST_NZ, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { VECTOR_SUB_RZERO, dist, .. } := D.vec4
  let { EVENTUALLY_AND, EVENTUALLY_IN_SEQUENTIALLY, LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN,
        LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN_DECREASING, LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN_INJ,
        .. } := D.met2
  let { eventually, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_UNIV, .. } := BEUC
  let { WITHIN_UNIV, «at», .. } := BNET
  let { LIMIT_EUCLIDEAN, TENDSTO_ALT, tendsto, .. } := BLIM1
  let { LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, .. } := BLIM2
  let { LIMPT_SEQUENTIAL, LIMPT_SEQUENTIAL_INJ, .. } := BRLM
  let { continuous, continuous_at, continuous_within, .. } := BCNT1
  let { uniformly_continuous_on, .. } := BCNO
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  -- @@SCOPE END

  let CONTINUOUS_WITHIN_SEQUENTIALLY ← prove
   r"!f s a:real^N.
        f continuous (at a within s) <=>
                !x. (!n. x(n) IN s) /\ (x --> a) sequentially
                     ==> ((f o x) --> f(a)) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_within] THEN EQ_TAC THENL
     [REWRITE_TAC [LIM_SEQUENTIALLY, o_THM] THEN MESON_TAC [], ALL_TAC] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, NOT_EXISTS_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"&1 / (&n + &1)")) THEN
    SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, REAL_OF_NUM_LE, REAL_POS, ARITH,
         ← REAL_ARITH (← q r"&0 <= n ==> &0 < n + &1"), NOT_FORALL_THM, SKOLEM_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [NOT_IMP, FORALL_AND_THM] THEN
    X_GEN_TAC (← q r"y:num->real^N") THEN REWRITE_TAC [LIM_SEQUENTIALLY, o_THM] THEN
    STRIP_TAC THEN CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [LE_REFL]] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC FORALL_POS_MONO_1 THEN
    CONJ_TAC THENL [ASM_MESON_TAC [REAL_LT_TRANS], ALL_TAC] THEN
    X_GEN_TAC (← q r"n:num") THEN EXISTS_TAC (← q r"n:num") THEN
    X_GEN_TAC (← q r"m:num") THEN
    DISCH_TAC THEN MATCH_MP_TAC REAL_LTE_TRANS THEN
    EXISTS_TAC (← q r"&1 / (&m + &1)") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [REAL_LE_INV2, real_div, ← REAL_ARITH (← q r"&0 <= x ==> &0 < x + &1"),
                  REAL_POS, REAL_MUL_LID, REAL_LE_RADD, REAL_OF_NUM_LE])

  let CONTINUOUS_AT_SEQUENTIALLY ← prove
   r"!f a:real^N.
        f continuous (at a) <=>
              !x. (x --> a) sequentially
                  ==> ((f o x) --> f(a)) sequentially"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY, IN_UNIV])

  let CONTINUOUS_ON_SEQUENTIALLY ← prove
   r"!f s:real^N->bool.
        f continuous_on s <=>
              !x a. a IN s /\ (!n. x(n) IN s) /\ (x --> a) sequentially
                    ==> ((f o x) --> f(a)) sequentially"
   (REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
                 CONTINUOUS_WITHIN_SEQUENTIALLY] THEN MESON_TAC [])

  let (UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY, UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY_ALT) ←
    CONJ_PAIR (← prove
     r"(!f:real^M->real^N s.
          f uniformly_continuous_on s <=>
          !x y. (!n. x n IN s) /\ (!n. y n IN s) /\
                ((\n. x n - y n) --> vec 0) sequentially
                ==> ((\n. f(x(n)) - f(y(n))) --> vec 0) sequentially) /\
     (!f:real^M->real^N s.
          f uniformly_continuous_on s <=>
          !e x y. &0 < e /\
                  (!n. x n IN s) /\ (!n. y n IN s) /\
                  ((\n. x n - y n) --> vec 0) sequentially
                  ==> ?n. dist(f(x n),f(y n)) < e)"
     (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(p ==> q) /\ (q ==> r) /\ (r ==> p)
        ==> (p <=> q) /\ (p <=> r)")) THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [uniformly_continuous_on, LIM_SEQUENTIALLY, dist] THEN
        REWRITE_TAC [VECTOR_SUB_RZERO] THEN MESON_TAC [],
        DISCH_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"e:real", ← q r"x:num->real^M", ← q r"y:num->real^M"] THEN
        STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:num->real^M", ← q r"y:num->real^M"]) THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [LIM_SEQUENTIALLY] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
        ASM_REWRITE_TAC [← NORM_ARITH (← q r"dist(x - y:real^N,vec 0) = dist(x,y)")] THEN
        MESON_TAC [LE_REFL],
        REWRITE_TAC [uniformly_continuous_on] THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r <=> q ==> ~r ==> ~p")] THEN
        DISCH_TAC THEN REWRITE_TAC [NOT_EXISTS_THM] THEN
        DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
        REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, SKOLEM_THM] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:num->real^M") THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:num->real^M") THEN
        REWRITE_TAC [AND_FORALL_THM, REAL_NOT_LT] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
        ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REWRITE_TAC [REAL_NOT_LT] THEN
        REWRITE_TAC [LIM_SEQUENTIALLY] THEN
        MATCH_MP_TAC FORALL_POS_MONO_1 THEN
        CONJ_TAC THENL [MESON_TAC [REAL_LT_TRANS], ALL_TAC] THEN
        X_GEN_TAC (← q r"n:num") THEN EXISTS_TAC (← q r"n:num") THEN
        X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
        REWRITE_TAC [← NORM_ARITH (← q r"dist(x - y:real^N,vec 0) = dist(y,x)")] THEN
        TRANS_TAC REAL_LTE_TRANS (← q r"inv(&m + &1)") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
        REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
        ASM_ARITH_TAC]))

  let LIM_WITHIN_SEQUENTIALLY ← prove
   r"!f:real^M->real^N s a l.
        (f --> l) (at a within s) <=>
        !x. (!n. x(n) IN s DELETE a) /\
            (x --> a) sequentially
            ==> ((f o x) --> l) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, «at»] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    GEN_REWRITE_TAC LAND_CONV [LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN] THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, IN_UNIV, INTER_UNIV])

  let LIM_WITHIN_SEQUENTIALLY_INJ ← prove
   r"!f:real^M->real^N s a l.
        (f --> l) (at a within s) <=>
        !x. (!n. x(n) IN s DELETE a) /\
            (!m n. x m = x n <=> m = n) /\
            (x --> a) sequentially
            ==> ((f o x) --> l) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, «at»] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    GEN_REWRITE_TAC LAND_CONV [LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN_INJ] THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, IN_UNIV, INTER_UNIV])

  let LIM_WITHIN_SEQUENTIALLY_DECREASING ← prove
   r"!f:real^M->real^N s a l.
        (f --> l) (at a within s) <=>
        !x. (!n. x(n) IN s DELETE a) /\
            (!m n. m < n ==> dist(x n,a) < dist(x m,a)) /\
            (x --> a) sequentially
            ==> ((f o x) --> l) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, «at»] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN GEN_REWRITE_TAC LAND_CONV
     [LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN_DECREASING] THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, IN_UNIV, INTER_UNIV] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC WLOG_LT THEN ASM_MESON_TAC [REAL_LT_REFL])

  let LIM_AT_SEQUENTIALLY ← prove
   r"!f:real^M->real^N a l.
        (f --> l) (at a) <=>
        !x. (!n. ~(x(n) = a)) /\ (x --> a) sequentially
            ==> ((f o x) --> l) sequentially"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [LIM_WITHIN_SEQUENTIALLY, IN_UNIV, IN_DELETE])

  let (CONTINUOUS_WITHIN_SEQUENTIALLY_INJ, CONTINUOUS_WITHIN_SEQUENTIALLY_ALT) ←
    CONJ_PAIR (← prove
     r"(!f:real^M->real^N s a.
          f continuous at a within s <=>
          !x. (!n. x n IN s DELETE a) /\
              (!m n. x m = x n <=> m = n) /\
              (x --> a) sequentially
              ==> (f o x --> f a) sequentially) /\
     (!f:real^M->real^N s a.
          (f continuous at a within s) <=>
          !e x. &0 < e /\
                (!n. x n IN s DELETE a) /\
                (x --> a) sequentially /\
                (!m n. x m = x n <=> m = n)
                ==> ?n. dist(f(x n),f a) < e)"
     (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(p ==> q) /\ (q ==> r) /\ (~p ==> ~r)
        ==> (p <=> q) /\ (p <=> r)")) THEN
      REPEAT CONJ_TAC THENL
       [MESON_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY, IN_DELETE],
        ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:num->real^M") THEN
        DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [LIM_SEQUENTIALLY] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [o_DEF] THEN
        MESON_TAC [LE_REFL],
        ALL_TAC] THEN
      REWRITE_TAC [continuous_within, IN_DELETE] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, NOT_EXISTS_THM,
                   REAL_NOT_LT, ← TAUT (← q r"~(p /\ q) <=> p ==> ~q")] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"?x. (!n. x n IN s /\ ~(x n = a) /\ dist(x n,a) < inv(&n + &1) /\
                 e <= dist((f:real^M->real^N) (x n),f a)) /\
            (!n. dist(x(SUC n),a) < dist(x n,a))")
      MP_TAC THENL
       [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        CONJ_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"&1")) THEN REWRITE_TAC [REAL_LT_01],
          MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^M"] THEN STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC
           (← q r"min (inv(&(SUC n) + &1)) (dist(x:real^M,a))"))] THEN
        ASM_REWRITE_TAC [REAL_LT_MIN, REAL_LT_INV_EQ, ← GSYM DIST_NZ,
                         ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^M") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [DIST_REFL, REAL_NOT_LT],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:num->real^M") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
         [REWRITE_TAC [LIM_SEQUENTIALLY] THEN MATCH_MP_TAC FORALL_POS_MONO_1 THEN
          CONJ_TAC THENL [MESON_TAC [REAL_LT_TRANS], ALL_TAC] THEN
          SUBGOAL_THEN
            (← q r"!m n. m <= n ==> dist((x:num->real^M) n,a) <= dist(x m,a)")
           (fun th => ASM_MESON_TAC [REAL_LET_TRANS, th]) THEN
          MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
          ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN REAL_ARITH_TAC,
          MATCH_MP_TAC WLOG_LT THEN
          SUBGOAL_THEN
            (← q r"!m n. m < n ==> dist((x:num->real^M) n,a) < dist(x m,a)")
           (fun th => MESON_TAC [th, REAL_LT_REFL]) THEN
          MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN
          ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC]]))

  let CONTINUOUS_AT_SEQUENTIALLY_ALT ← prove
   r"!f:real^M->real^N a.
        (f continuous at a) <=>
        !e x. &0 < e /\
              (!n. ~(x n = a)) /\
              (x --> a) sequentially /\
              (!m n. x m = x n <=> m = n)
              ==> ?n. dist(f(x n),f a) < e"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY_ALT, IN_DELETE, IN_UNIV])

  let CONTINUOUS_AT_SEQUENTIALLY_INJ ← prove
   r"!f:real^M->real^N a.
        f continuous at a <=>
        !x. (!n. ~(x n = a)) /\
            (!m n. x m = x n <=> m = n) /\
            (x --> a) sequentially
            ==> (f o x --> f a) sequentially"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY_INJ, IN_DELETE, IN_UNIV])

  let LIM_CONTINUOUS ← prove
   r"!net f:A->real^N l.
        f continuous net /\ f(netlimit net) = l ==> (f --> l) net"
   (MESON_TAC [continuous])

  let LIM_CONTINUOUS_FUNCTION ← prove
   r"!f net g l.
        f continuous (at l) /\ (g --> l) net ==> ((\x. f(g x)) --> f l) net"
   (REWRITE_TAC [tendsto, continuous_at, eventually] THEN MESON_TAC [])

  let LIM_CONTINUOUS_FUNCTION_WITHIN ← prove
   r"!net f:real^M->real^N g:A->real^M l s.
       f continuous (at l within s) /\
       (g --> l) net /\ eventually (\a. g a IN s) net
       ==> ((\x. f (g x)) --> f l) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto, continuous_within] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
     (← q r"(!x. P x ==> Q x) /\ R ==> !x. P x ==> Q x /\ R"))) THEN
    REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    REWRITE_TAC [eventually] THEN ASM_MESON_TAC [])

  let LIMIT_POINT_OF_IMAGE_GEN ← prove
   r"!f:real^M->real^N s u x.
      x limit_point_of s /\
      f continuous (at x within s) /\ open u /\ x IN u /\
      FINITE {z | z IN s INTER u /\ f z =  f x}
      ==> (f x) limit_point_of (IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIMPT_SEQUENTIAL_INJ]) THEN
    REWRITE_TAC [IN_DELETE, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"p:num->real^M") THEN STRIP_TAC THEN
    MP_TAC (← SPEC (← q r"{n:num | p n IN u /\ ~((f:real^M->real^N)(p n) = f x)}")
      INFINITE_ENUMERATE_WEAK) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN ANTS_TAC THENL
     [REWRITE_TAC [← SET_RULE
       (← q r"{x | P x /\ ~Q x} = {x | P x} DIFF {x | P x /\ Q x}")] THEN
      MATCH_MP_TAC INFINITE_DIFF_FINITE THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [← SET_RULE (← q r"{x | P x} = UNIV DIFF {x | ~P x}")] THEN
        MATCH_MP_TAC INFINITE_DIFF_FINITE THEN REWRITE_TAC [num_INFINITE] THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"u:real^M->bool") o
          REWRITE_RULE [TENDSTO_ALT]) THEN
        ASM_REWRITE_TAC [EVENTUALLY_IN_SEQUENTIALLY],
        SUBGOAL_THEN
         (← q r"{n:num | p n IN u /\ (f:real^M->real^N)(p n) = f x} =
          {n | p n IN {z | z IN s INTER u /\ f z = f x}}")
        SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC FINITE_FINITE_PREIMAGE THEN ASM_REWRITE_TAC [] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC (← MESON [FINITE_SUBSET, FINITE_SING]
         (← q r"(?a. s SUBSET {a}) ==> FINITE s")) THEN
        ASM SET_TAC []],
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [LIMPT_SEQUENTIAL] THEN
      EXISTS_TAC (← q r"(f:real^M->real^N) o p o (r:num->num)") THEN
      REWRITE_TAC [o_THM] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_ASSUM (MATCH_MP_TAC o
        REWRITE_RULE [CONTINUOUS_WITHIN_SEQUENTIALLY]) THEN
      ASM_SIMP_TAC [LIM_SUBSEQUENCE, o_THM]])

  let LIMIT_POINT_OF_IMAGE ← prove
   r"!f:real^M->real^N s x.
      x limit_point_of s /\
      f continuous (at x within s) /\
      (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
      ==> (f x) limit_point_of (IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LIMIT_POINT_OF_IMAGE_GEN THEN
    EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [OPEN_UNIV, IN_UNIV] THEN
    MATCH_MP_TAC (← MESON [FINITE_SUBSET, FINITE_SING]
     (← q r"(?a. s SUBSET {a}) ==> FINITE s")) THEN
    ASM SET_TAC [])

  return { CONTINUOUS_WITHIN_SEQUENTIALLY, CONTINUOUS_AT_SEQUENTIALLY,
           CONTINUOUS_ON_SEQUENTIALLY, UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY,
           UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY_ALT, LIM_WITHIN_SEQUENTIALLY,
           LIM_WITHIN_SEQUENTIALLY_INJ, LIM_WITHIN_SEQUENTIALLY_DECREASING, LIM_AT_SEQUENTIALLY,
           CONTINUOUS_WITHIN_SEQUENTIALLY_INJ, CONTINUOUS_WITHIN_SEQUENTIALLY_ALT,
           CONTINUOUS_AT_SEQUENTIALLY_ALT, CONTINUOUS_AT_SEQUENTIALLY_INJ, LIM_CONTINUOUS,
           LIM_CONTINUOUS_FUNCTION, LIM_CONTINUOUS_FUNCTION_WITHIN, LIMIT_POINT_OF_IMAGE_GEN,
           LIMIT_POINT_OF_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Continuous functions and nested compact intersections; combination      -/
/- results for pointwise continuity.  (topology.ml 7143-7301)                -/
/- ------------------------------------------------------------------------- -/

structure CMB where
  CONTINUOUS_IMAGE_NESTED_INTERS : thm
  CONTINUOUS_IMAGE_NESTED_INTERS_GEN : thm
  CONTINUOUS_CONST : thm
  CONTINUOUS_CMUL : thm
  CONTINUOUS_NEG : thm
  CONTINUOUS_ADD : thm
  CONTINUOUS_SUB : thm
  CONTINUOUS_ABS : thm
  CONTINUOUS_LIFT_ABS_COMPONENT : thm
  CONTINUOUS_LIFT_ABS : thm
  CONTINUOUS_MAX : thm
  CONTINUOUS_MIN : thm
  CONTINUOUS_MAX_1 : thm
  CONTINUOUS_MIN_1 : thm
  CONTINUOUS_VSUM : thm
  CONTINUOUS_COMPONENTWISE_LIFT : thm
  deriving Inhabited

@[nospecialize]
def setupCMB [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) (BLIM2 : LIM2) (BARI : ARI)
    (BUNQ : UNQ) (BSEQ : SEQ) (BCPT : CPT) (BCNT1 : CNT1) (BSQC : SQC) :
    ExceptT String IO CMB := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ADD_CLAUSES, CART_EQ, DIMINDEX_1, EQ_IMP, ETA_AX, EXTENSION, FINITE_INDUCT_STRONG, .. } :=
    D.core1
  let { FORALL_AND_THM, FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, IMP_CONJ, INTERS_GSPEC,
        IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { IN_UNIV, LAMBDA_BETA, LE_0, LE_ADD, LE_EXISTS, LT_ADD_LCANCEL, MONO_EXISTS, NOT_IN_EMPTY,
        .. } := D.core3
  let { SKOLEM_THM, SUBSET, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LE, o_ASSOC, o_DEF, o_THM, .. } := D.core6
  let { MONOTONE_BIGGER, .. } := D.misc
  let { FORALL_1, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { VSUM_CLAUSES, drop, .. } := D.vec4
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { LIM_COMPONENTWISE_LIFT, .. } := BLIM1
  let { LIM_SUBSEQUENCE, .. } := BLIM2
  let { LIM_ABS, LIM_ADD, LIM_CMUL, LIM_CONST, LIM_LIFT_ABS_COMPONENT, LIM_MAX, LIM_MIN, LIM_NEG,
        LIM_SUB, .. } := BARI
  let { LIM_UNIQUE, .. } := BUNQ
  let { CLOSED_SEQUENTIAL_LIMITS, .. } := BSEQ
  let { COMPACT_IMP_CLOSED, compact, .. } := BCPT
  let { continuous, .. } := BCNT1
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  -- @@SCOPE END

  let CONTINUOUS_IMAGE_NESTED_INTERS ← prove
   r"!f:real^M->real^N s.
        f continuous_on s 0 /\
        (!n. compact(s n)) /\
        (!n. s(SUC n) SUBSET s n)
        ==> IMAGE f (INTERS {s n | n IN (:num)}) =
            INTERS {IMAGE f (s n) | n IN (:num)}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION] THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [INTERS_GSPEC, IN_IMAGE, IN_ELIM_THM, IN_UNIV] THEN
    EQ_TAC THENL [MESON_TAC [], REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:num->real^M") (STRIP_ASSUME_TAC o GSYM)) THEN
    SUBGOAL_THEN (← q r"compact(s 0:real^M->bool)") MP_TAC THENL
     [ASM_REWRITE_TAC [], REWRITE_TAC [compact]] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real^M")) THEN
    SUBGOAL_THEN
     (← q r"!m n. m <= n ==> (s:num->real^M->bool) n SUBSET s m")
    ASSUME_TAC THENL
     [MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. (x:num->real^M) n IN s 0") ASSUME_TAC THENL
     [ASM_MESON_TAC [LE_0, SUBSET], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"z:real^M") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN CONJ_TAC THENL
     [MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"(f:real^M->real^N) o x o (r:num->num)") THEN
      REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN CONJ_TAC THENL
       [ASM_REWRITE_TAC [o_DEF, LIM_CONST], ALL_TAC] THEN
      FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [CONTINUOUS_ON_SEQUENTIALLY]) THEN
      ASM_REWRITE_TAC [o_THM],
      X_GEN_TAC (← q r"n:num") THEN
      SUBGOAL_THEN (← q r"closed((s:num->real^M->bool) n)") MP_TAC THENL
       [ASM_SIMP_TAC [COMPACT_IMP_CLOSED],
        REWRITE_TAC [CLOSED_SEQUENTIAL_LIMITS]] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      EXISTS_TAC (← q r"(x:num->real^M) o (r:num->num) o (\i. n + i)") THEN
      ASM_SIMP_TAC [o_ASSOC, LIM_SUBSEQUENCE, LT_ADD_LCANCEL] THEN
      X_GEN_TAC (← q r"m:num") THEN REWRITE_TAC [o_THM] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ x IN s ==> x IN t")) THEN
      EXISTS_TAC (← q r"(s:num->real^M->bool)(r(n + m:num))") THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC (← ARITH_RULE (← q r"n + m:num <= r(n + m) ==> n <= r(n + m)")) THEN
      ASM_MESON_TAC [MONOTONE_BIGGER]])

  let CONTINUOUS_IMAGE_NESTED_INTERS_GEN ← prove
   r"!f:real^M->real^N s m.
        f continuous_on s m /\
        (!n. m <= n ==> compact(s n)) /\
        (!n. m <= n ==> s(SUC n) SUBSET s n)
        ==> IMAGE f (INTERS {s n | m <= n}) =
            INTERS {IMAGE f (s n) | m <= n}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(s:num->real^M->bool) o (\i. m + i)"]
          CONTINUOUS_IMAGE_NESTED_INTERS) THEN
    ASM_SIMP_TAC [o_THM, ADD_CLAUSES, LE_ADD] THEN
    SUBGOAL_THEN
     (← q r"!n. m <= n <=> n IN IMAGE (\i. m + i) (:num)")
     (fun th => REWRITE_TAC [th])
    THENL
     [REWRITE_TAC [IN_IMAGE, IN_UNIV] THEN MESON_TAC [LE_ADD, LE_EXISTS],
      REWRITE_TAC [INTERS_GSPEC, FORALL_IN_IMAGE]])

  let CONTINUOUS_CONST ← prove
   r"!net c. (\x. c) continuous net"
   (REWRITE_TAC [continuous, LIM_CONST])

  let CONTINUOUS_CMUL ← prove
   r"!f c net. f continuous net ==> (\x. c % f(x)) continuous net"
   (REWRITE_TAC [continuous, LIM_CMUL])

  let CONTINUOUS_NEG ← prove
   r"!f net. f continuous net ==> (\x. --(f x)) continuous net"
   (REWRITE_TAC [continuous, LIM_NEG])

  let CONTINUOUS_ADD ← prove
   r"!f g net. f continuous net /\ g continuous net
           ==> (\x. f(x) + g(x)) continuous net"
   (REWRITE_TAC [continuous, LIM_ADD])

  let CONTINUOUS_SUB ← prove
   r"!f g net. f continuous net /\ g continuous net
           ==> (\x. f(x) - g(x)) continuous net"
   (REWRITE_TAC [continuous, LIM_SUB])

  let CONTINUOUS_ABS ← prove
   r"!(f:A->real^N) net.
        f continuous net
        ==> (\x. (lambda i. abs(f(x)$i)):real^N) continuous net"
   (REWRITE_TAC [continuous, LIM_ABS])

  let CONTINUOUS_LIFT_ABS_COMPONENT ← prove
   r"!net f:A->real^N k.
     f continuous net ==> (\x. lift(abs(f x$k))) continuous net"
   (REWRITE_TAC [continuous, LIM_LIFT_ABS_COMPONENT])

  let CONTINUOUS_LIFT_ABS ← prove
   r"!net:(A)net f.
    (\x. lift(f x)) continuous net ==> (\x. lift(abs(f x))) continuous net"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_ABS) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    SIMP_TAC [FUN_EQ_THM, CART_EQ, LAMBDA_BETA] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, LIFT_DROP])

  let CONTINUOUS_MAX ← prove
   r"!(f:A->real^N) (g:A->real^N) net.
        f continuous net /\ g continuous net
        ==> (\x. (lambda i. max (f(x)$i) (g(x)$i)):real^N) continuous net"
   (REWRITE_TAC [continuous, LIM_MAX])

  let CONTINUOUS_MIN ← prove
   r"!(f:A->real^N) (g:A->real^N) net.
        f continuous net /\ g continuous net
        ==> (\x. (lambda i. min (f(x)$i) (g(x)$i)):real^N) continuous net"
   (REWRITE_TAC [continuous, LIM_MIN])

  let CONTINUOUS_MAX_1 ← prove
   r"!net:(A)net f g.
        (\x. lift(f x)) continuous net /\ (\x. lift(g x)) continuous net
        ==> (\x. lift(max (f x) (g x))) continuous net"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_MAX) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, LIFT_DROP])

  let CONTINUOUS_MIN_1 ← prove
   r"!net:(A)net f g.
        (\x. lift(f x)) continuous net /\ (\x. lift(g x)) continuous net
        ==> (\x. lift(min (f x) (g x))) continuous net"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_MIN) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, LIFT_DROP])

  let CONTINUOUS_VSUM ← prove
   r"!net f s. FINITE s /\ (!a. a IN s ==> (f a) continuous net)
             ==> (\x. vsum s (\a. f a x)) continuous net"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, VSUM_CLAUSES,
              CONTINUOUS_CONST, CONTINUOUS_ADD, ETA_AX])

  let CONTINUOUS_COMPONENTWISE_LIFT ← prove
   r"!net f:A->real^N.
        f continuous net <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> (\x. lift((f x)$i)) continuous net"
   (REWRITE_TAC [continuous, ← GSYM LIM_COMPONENTWISE_LIFT])

  return { CONTINUOUS_IMAGE_NESTED_INTERS, CONTINUOUS_IMAGE_NESTED_INTERS_GEN, CONTINUOUS_CONST,
           CONTINUOUS_CMUL, CONTINUOUS_NEG, CONTINUOUS_ADD, CONTINUOUS_SUB, CONTINUOUS_ABS,
           CONTINUOUS_LIFT_ABS_COMPONENT, CONTINUOUS_LIFT_ABS, CONTINUOUS_MAX, CONTINUOUS_MIN,
           CONTINUOUS_MAX_1, CONTINUOUS_MIN_1, CONTINUOUS_VSUM, CONTINUOUS_COMPONENTWISE_LIFT }

/- ------------------------------------------------------------------------- -/
/- Same thing for setwise continuity.  (topology.ml 7302-7404)               -/
/- ------------------------------------------------------------------------- -/

structure CMS where
  CONTINUOUS_ON_CONST : thm
  CONTINUOUS_ON_CMUL : thm
  CONTINUOUS_ON_NEG : thm
  CONTINUOUS_ON_ADD : thm
  CONTINUOUS_ON_SUB : thm
  CONTINUOUS_ON_LIFT_ABS_COMPONENT : thm
  CONTINUOUS_ON_LIFT_ABS : thm
  CONTINUOUS_ON_ABS : thm
  CONTINUOUS_ON_MAX : thm
  CONTINUOUS_ON_MIN : thm
  CONTINUOUS_ON_MAX_1 : thm
  CONTINUOUS_ON_MIN_1 : thm
  CONTINUOUS_ON_VSUM : thm
  CONTINUOUS_ON_COMPONENTWISE_LIFT : thm
  CONTINUOUS_ON_REFLECT : thm
  deriving Inhabited

@[nospecialize]
def setupCMS [HolBase] (D : TopologyDeps) (BCNO : CNO) (BCSL : CSL) (BCMB : CMB) :
    ExceptT String IO CMS := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, NORM_ARITH, .. } := D
  let { CART_EQ, DIMINDEX_1, EQ_IMP, EXISTS_IN_IMAGE, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, .. } := D.core2
  let { LAMBDA_BETA, .. } := D.core3
  let { FORALL_1, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { VECTOR_NEG_NEG, drop, .. } := D.vec4
  let { continuous_on, .. } := BCNO
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  let { CONTINUOUS_ABS, CONTINUOUS_ADD, CONTINUOUS_CMUL, CONTINUOUS_COMPONENTWISE_LIFT,
        CONTINUOUS_CONST, CONTINUOUS_LIFT_ABS, CONTINUOUS_LIFT_ABS_COMPONENT, CONTINUOUS_MAX,
        CONTINUOUS_MIN, CONTINUOUS_NEG, CONTINUOUS_SUB, CONTINUOUS_VSUM, .. } := BCMB
  -- @@SCOPE END

  let CONTINUOUS_ON_CONST ← prove
   r"!s c. (\x. c) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_CONST])

  let CONTINUOUS_ON_CMUL ← prove
   r"!f c s. f continuous_on s ==> (\x. c % f(x)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_CMUL])

  let CONTINUOUS_ON_NEG ← prove
   r"!f s. f continuous_on s
         ==> (\x. --(f x)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_NEG])

  let CONTINUOUS_ON_ADD ← prove
   r"!f g s. f continuous_on s /\ g continuous_on s
           ==> (\x. f(x) + g(x)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ADD])

  let CONTINUOUS_ON_SUB ← prove
   r"!f g s. f continuous_on s /\ g continuous_on s
           ==> (\x. f(x) - g(x)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_SUB])

  let CONTINUOUS_ON_LIFT_ABS_COMPONENT ← prove
   r"!f:real^M->real^N s.
     f continuous_on s ==> (\x. lift(abs(f x$k))) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
              CONTINUOUS_LIFT_ABS_COMPONENT])

  let CONTINUOUS_ON_LIFT_ABS ← prove
   r"!f s:real^N->bool.
     (\x. lift(f x)) continuous_on s ==> (\x. lift(abs(f x))) continuous_on s"
   (REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_LIFT_ABS THEN
    ASM_SIMP_TAC [])

  let CONTINUOUS_ON_ABS ← prove
   r"!f:real^M->real^N s.
        f continuous_on s
        ==> (\x. (lambda i. abs(f(x)$i)):real^N) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ABS])

  let CONTINUOUS_ON_MAX ← prove
   r"!f:real^M->real^N g:real^M->real^N s.
        f continuous_on s /\ g continuous_on s
        ==> (\x. (lambda i. max (f(x)$i) (g(x)$i)):real^N)
            continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_MAX])

  let CONTINUOUS_ON_MIN ← prove
   r"!f:real^M->real^N g:real^M->real^N s.
        f continuous_on s /\ g continuous_on s
        ==> (\x. (lambda i. min (f(x)$i) (g(x)$i)):real^N)
            continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_MIN])

  let CONTINUOUS_ON_MAX_1 ← prove
   r"!f:real^N->real g s.
        (\x. lift(f x)) continuous_on s /\ (\x. lift(g x)) continuous_on s
        ==> (\x. lift(max (f x) (g x))) continuous_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_ON_MAX) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, LIFT_DROP])

  let CONTINUOUS_ON_MIN_1 ← prove
   r"!f:real^N->real g s.
        (\x. lift(f x)) continuous_on s /\ (\x. lift(g x)) continuous_on s
        ==> (\x. lift(min (f x) (g x))) continuous_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_ON_MIN) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, LIFT_DROP])

  let CONTINUOUS_ON_VSUM ← prove
   r"!t f s. FINITE s /\ (!a. a IN s ==> (f a) continuous_on t)
             ==> (\x. vsum s (\a. f a x)) continuous_on t"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_VSUM])

  let CONTINUOUS_ON_COMPONENTWISE_LIFT ← prove
   r"!f:real^M->real^N s.
        f continuous_on s <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> (\x. lift((f x)$i)) continuous_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [CONTINUOUS_COMPONENTWISE_LIFT] THEN
    MESON_TAC [])

  let CONTINUOUS_ON_REFLECT ← prove
   r"!f:real^M->real^N s.
        (\x. f(--x)) continuous_on (IMAGE (--) s) <=>
        f continuous_on s"
   (REWRITE_TAC [continuous_on, FORALL_IN_IMAGE, EXISTS_IN_IMAGE, IMP_CONJ] THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ← NORM_ARITH (← q r"dist(--x:real^N,--y) = dist(x,y)")])

  return { CONTINUOUS_ON_CONST, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_NEG, CONTINUOUS_ON_ADD,
           CONTINUOUS_ON_SUB, CONTINUOUS_ON_LIFT_ABS_COMPONENT, CONTINUOUS_ON_LIFT_ABS,
           CONTINUOUS_ON_ABS, CONTINUOUS_ON_MAX, CONTINUOUS_ON_MIN, CONTINUOUS_ON_MAX_1,
           CONTINUOUS_ON_MIN_1, CONTINUOUS_ON_VSUM, CONTINUOUS_ON_COMPONENTWISE_LIFT,
           CONTINUOUS_ON_REFLECT }

/- ------------------------------------------------------------------------- -/
/- Same thing for uniform continuity, using sequential formulations.        -/
/- (topology.ml 7405-7569)                                                   -/
/- ------------------------------------------------------------------------- -/

structure UCN where
  UNIFORMLY_CONTINUOUS_ON_CONST : thm
  LINEAR_UNIFORMLY_CONTINUOUS_ON : thm
  UNIFORMLY_CONTINUOUS_ON_COMPOSE : thm
  BILINEAR_UNIFORMLY_CONTINUOUS_ON_COMPOSE : thm
  UNIFORMLY_CONTINUOUS_ON_MUL : thm
  UNIFORMLY_CONTINUOUS_ON_CMUL : thm
  UNIFORMLY_CONTINUOUS_ON_VMUL : thm
  UNIFORMLY_CONTINUOUS_ON_NEG : thm
  UNIFORMLY_CONTINUOUS_ON_ADD : thm
  UNIFORMLY_CONTINUOUS_ON_SUB : thm
  UNIFORMLY_CONTINUOUS_ON_VSUM : thm
  UNIFORMLY_CONTINUOUS_ON_SQRT : thm
  deriving Inhabited

@[nospecialize]
def setupUCN [HolBase] (D : TopologyDeps) (BARI : ARI) (BBND1 : BND1) (BCNO : CNO)
    (BSQC : SQC) : ExceptT String IO UCN := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, VECTOR_ARITH_TAC, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, EQ_IMP, ETA_AX, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IN_IMAGE, .. } :=
    D.core2
  let { MONO_FORALL, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_DIV_LMUL, REAL_DIV_RMUL, REAL_LET_TRANS, REAL_LE_LMUL, REAL_LE_MUL2, REAL_LE_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_MIN, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_SYM, .. } := D.core5
  let { SWAP_FORALL_THM, o_DEF, o_THM, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { BILINEAR_BOUNDED_POS, BILINEAR_LSUB, BILINEAR_RSUB, DROP_ADD, DROP_CMUL, .. } := D.vec1
  let { LIFT_DROP, LINEAR_BOUNDED_POS, LINEAR_ID, LINEAR_SUB, LINEAR_VMUL_DROP, .. } := D.vec2
  let { NORM_POS_LE, .. } := D.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_RZERO, VECTOR_NEG_MINUS1, VECTOR_SUB, VECTOR_SUB_LDISTRIB,
        VECTOR_SUB_REFL, VSUM_CLAUSES, bilinear, dist, linear, .. } := D.vec4
  let { UNIFORMLY_CONTINUOUS_MAP_SQRT, .. } := D.met3
  let { LIM_ADD, LIM_CMUL, LIM_CONST, .. } := BARI
  let { BOUNDED_POS, .. } := BBND1
  let { UNIFORMLY_CONTINUOUS_MAP_EQ_LIFT, UNIFORMLY_CONTINUOUS_MAP_EUCLIDEAN,
        uniformly_continuous_on, .. } := BCNO
  let { UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  -- @@SCOPE END

  let UNIFORMLY_CONTINUOUS_ON_CONST ← prove
   r"!s c. (\x. c) uniformly_continuous_on s"
   (REWRITE_TAC [UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY, o_DEF,
                 VECTOR_SUB_REFL, LIM_CONST])

  let LINEAR_UNIFORMLY_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N s. linear f ==> f uniformly_continuous_on s"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [uniformly_continuous_on, dist, ← GSYM LINEAR_SUB] THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC o
          MATCH_MP LINEAR_BOUNDED_POS) THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"e / B:real") THEN
    ASM_SIMP_TAC [REAL_LT_DIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN STRIP_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"B * norm(y - x:real^M)") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [REAL_LT_RDIV_EQ, REAL_MUL_SYM])

  let UNIFORMLY_CONTINUOUS_ON_COMPOSE ← do
    let lemma ← prove
     r"(!y. ((?x. (y = f x) /\ P x) /\ Q y ==> R y)) <=>
       (!x. P x /\ Q (f x) ==> R (f x))"
     (MESON_TAC [])
    prove
     r"!f g s. f uniformly_continuous_on s /\
           g uniformly_continuous_on (IMAGE f s)
           ==> (g o f) uniformly_continuous_on s"
     (REPEAT GEN_TAC THEN
      REWRITE_TAC [uniformly_continuous_on, o_THM, IN_IMAGE] THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN REWRITE_TAC [lemma] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> b /\ a /\ c")] THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN REWRITE_TAC [lemma] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC MONO_FORALL THEN
      X_GEN_TAC (← q r"e:real") THEN ASM_CASES_TAC (← q r"&0 < e") THEN
      ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [])

  let BILINEAR_UNIFORMLY_CONTINUOUS_ON_COMPOSE ← prove
   r"!f:real^M->real^N g (h:real^N->real^P->real^Q) s.
           f uniformly_continuous_on s /\ g uniformly_continuous_on s /\
           bilinear h /\ bounded(IMAGE f s) /\ bounded(IMAGE g s)
           ==> (\x. h (f x) (g x)) uniformly_continuous_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [uniformly_continuous_on, dist] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!a b c d. (h:real^N->real^P->real^Q) a b - h c d =
                h (a - c) b + h c (b - d)")
     (fun th => ONCE_REWRITE_TAC [th])
    THENL
     [FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP BILINEAR_LSUB th])) THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP BILINEAR_RSUB th])) THEN
      VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC o
      MATCH_MP BILINEAR_BOUNDED_POS) THEN
    UNDISCH_TAC (← q r"bounded(IMAGE (g:real^M->real^P) s)") THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BOUNDED_POS]) THEN
    REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B1:real") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B2:real") STRIP_ASSUME_TAC) THEN
    UNDISCH_TAC (← q r"(g:real^M->real^P) uniformly_continuous_on s") THEN
    UNDISCH_TAC (← q r"(f:real^M->real^N) uniformly_continuous_on s") THEN
    REWRITE_TAC [uniformly_continuous_on] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2 / &2 / B / B2")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_HALF, dist] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2 / &2 / B / B1")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_HALF, dist] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d1 d2") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^M", ← q r"y:real^M"])) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC
     (← q r"B * e / &2 / &2 / B / B2 * B2 + B * B1 * e / &2 / &2 / B / B1") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(x) <= a /\ norm(y) <= b ==> norm(x + y:real^N) <= a + b")) THEN
      CONJ_TAC THEN
      FIRST_X_ASSUM (fun th => W (MP_TAC o PART_MATCH lhand th o lhand o snd)) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, NORM_POS_LE],
      ASM_SIMP_TAC [REAL_DIV_RMUL, REAL_DIV_LMUL, REAL_LT_IMP_NZ] THEN
      ASM_REAL_ARITH_TAC])

  let UNIFORMLY_CONTINUOUS_ON_MUL ← prove
   r"!f g:real^M->real^N s.
        (lift o f) uniformly_continuous_on s /\ g uniformly_continuous_on s /\
        bounded(IMAGE (lift o f) s) /\ bounded(IMAGE g s)
        ==>  (\x. f x % g x) uniformly_continuous_on s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"lift o (f:real^M->real)", ← q r"g:real^M->real^N",
      ← q r"\c (v:real^N). drop c % v", ← q r"s:real^M->bool"]
          BILINEAR_UNIFORMLY_CONTINUOUS_ON_COMPOSE) THEN
    ASM_REWRITE_TAC [o_THM, LIFT_DROP] THEN DISCH_THEN MATCH_MP_TAC THEN
    REWRITE_TAC [bilinear, linear, DROP_ADD, DROP_CMUL] THEN VECTOR_ARITH_TAC)

  let UNIFORMLY_CONTINUOUS_ON_CMUL ← prove
   r"!f c s. f uniformly_continuous_on s
           ==> (\x. c % f(x)) uniformly_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_CMUL) THEN
    ASM_SIMP_TAC [VECTOR_SUB_LDISTRIB, VECTOR_MUL_RZERO])

  let UNIFORMLY_CONTINUOUS_ON_VMUL ← prove
   r"!s:real^M->bool c v:real^N.
      (lift o c) uniformly_continuous_on s
      ==> (\x. c x % v) uniformly_continuous_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"\x. (drop x % v:real^N)") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] UNIFORMLY_CONTINUOUS_ON_COMPOSE)) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN DISCH_THEN MATCH_MP_TAC THEN
    MATCH_MP_TAC LINEAR_UNIFORMLY_CONTINUOUS_ON THEN
    MATCH_MP_TAC LINEAR_VMUL_DROP THEN REWRITE_TAC [LINEAR_ID])

  let UNIFORMLY_CONTINUOUS_ON_NEG ← prove
   r"!f s. f uniformly_continuous_on s
         ==> (\x. --(f x)) uniformly_continuous_on s"
   (ONCE_REWRITE_TAC [VECTOR_NEG_MINUS1] THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_ON_CMUL])

  let UNIFORMLY_CONTINUOUS_ON_ADD ← prove
   r"!f g s. f uniformly_continuous_on s /\ g uniformly_continuous_on s
           ==> (\x. f(x) + g(x)) uniformly_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [o_DEF] THEN DISCH_THEN (MP_TAC o MATCH_MP LIM_ADD) THEN
    MATCH_MP_TAC EQ_IMP THEN
    REWRITE_TAC [VECTOR_ADD_LID] THEN AP_THM_TAC THEN BINOP_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN VECTOR_ARITH_TAC)

  let UNIFORMLY_CONTINUOUS_ON_SUB ← prove
   r"!f g s. f uniformly_continuous_on s /\ g uniformly_continuous_on s
           ==> (\x. f(x) - g(x)) uniformly_continuous_on s"
   (REWRITE_TAC [VECTOR_SUB] THEN
    SIMP_TAC [UNIFORMLY_CONTINUOUS_ON_NEG, UNIFORMLY_CONTINUOUS_ON_ADD])

  let UNIFORMLY_CONTINUOUS_ON_VSUM ← prove
   r"!t f s. FINITE s /\ (!a. a IN s ==> (f a) uniformly_continuous_on t)
             ==> (\x. vsum s (\a. f a x)) uniformly_continuous_on t"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, VSUM_CLAUSES,
         UNIFORMLY_CONTINUOUS_ON_CONST, UNIFORMLY_CONTINUOUS_ON_ADD, ETA_AX])

  let UNIFORMLY_CONTINUOUS_ON_SQRT ← prove
   r"!f:real^N->real s.
        (lift o f) uniformly_continuous_on s
        ==> (\x. lift(sqrt(f x))) uniformly_continuous_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM UNIFORMLY_CONTINUOUS_MAP_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM o_DEF, ← GSYM UNIFORMLY_CONTINUOUS_MAP_EQ_LIFT] THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_SQRT, o_DEF])

  return { UNIFORMLY_CONTINUOUS_ON_CONST, LINEAR_UNIFORMLY_CONTINUOUS_ON,
           UNIFORMLY_CONTINUOUS_ON_COMPOSE, BILINEAR_UNIFORMLY_CONTINUOUS_ON_COMPOSE,
           UNIFORMLY_CONTINUOUS_ON_MUL, UNIFORMLY_CONTINUOUS_ON_CMUL,
           UNIFORMLY_CONTINUOUS_ON_VMUL, UNIFORMLY_CONTINUOUS_ON_NEG,
           UNIFORMLY_CONTINUOUS_ON_ADD, UNIFORMLY_CONTINUOUS_ON_SUB,
           UNIFORMLY_CONTINUOUS_ON_VSUM, UNIFORMLY_CONTINUOUS_ON_SQRT }

/- ------------------------------------------------------------------------- -/
/- Identity function; composition; continuity in terms of open preimages.  -/
/- (topology.ml 7570-7713)                                                   -/
/- ------------------------------------------------------------------------- -/

structure IDC where
  CONTINUOUS_WITHIN_ID : thm
  CONTINUOUS_AT_ID : thm
  CONTINUOUS_ON_ID : thm
  UNIFORMLY_CONTINUOUS_ON_ID : thm
  CONTINUOUS_WITHIN_COMPOSE : thm
  CONTINUOUS_AT_COMPOSE : thm
  CONTINUOUS_ON_COMPOSE : thm
  CONTINUOUS_WITHIN_OPEN : thm
  CONTINUOUS_AT_OPEN : thm
  CONTINUOUS_ON_OPEN_GEN : thm
  CONTINUOUS_ON_OPEN : thm
  CONTINUOUS_OPEN_IN_PREIMAGE_GEN : thm
  CONTINUOUS_ON_IMP_OPEN_IN : thm
  CONTINUOUS_OPEN_IN_PREIMAGE_SUBSET : thm
  deriving Inhabited

@[nospecialize]
def setupIDC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BNET : NET)
    (BCNT1 : CNT1) (BCNO : CNO) (BCSL : CSL) : ExceptT String IO IDC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { FORALL_IN_IMAGE, INTER_COMM, IN_ELIM_THM, IN_IMAGE, IN_INTER, .. } := D.core2
  let { IN_UNIV, MONO_FORALL, .. } := D.core3
  let { REAL_LT_TRANS, SUBSET, SUBSET_REFL, SUBSET_UNIV, .. } := D.core5
  let { o_THM, .. } := D.core6
  let { DIST_REFL, DIST_SYM, .. } := D.vec1
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_TRANS, .. } := D.met3
  let { open_def, .. } := BEUC
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, .. } := BBAL
  let { OPEN_IN_OPEN, open_in, .. } := BLOC
  let { WITHIN_UNIV, .. } := BNET
  let { continuous_at, continuous_within, .. } := BCNT1
  let { continuous_on, uniformly_continuous_on, .. } := BCNO
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET, CONTINUOUS_WITHIN_SUBSET, .. } :=
    BCSL
  -- @@SCOPE END

  let CONTINUOUS_WITHIN_ID ← prove
   r"!a s. (\x. x) continuous (at a within s)"
   (REWRITE_TAC [continuous_within] THEN MESON_TAC [])

  let CONTINUOUS_AT_ID ← prove
   r"!a. (\x. x) continuous (at a)"
   (REWRITE_TAC [continuous_at] THEN MESON_TAC [])

  let CONTINUOUS_ON_ID ← prove
   r"!s. (\x. x) continuous_on s"
   (REWRITE_TAC [continuous_on] THEN MESON_TAC [])

  let UNIFORMLY_CONTINUOUS_ON_ID ← prove
   r"!s. (\x. x) uniformly_continuous_on s"
   (REWRITE_TAC [uniformly_continuous_on] THEN MESON_TAC [])

  let CONTINUOUS_WITHIN_COMPOSE ← prove
   r"!f g x s. f continuous (at x within s) /\
             g continuous (at (f x) within IMAGE f s)
             ==> (g o f) continuous (at x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_within, o_THM, IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_MESON_TAC [])

  let CONTINUOUS_AT_COMPOSE ← prove
   r"!f g x. f continuous (at x) /\ g continuous (at (f x))
           ==> (g o f) continuous (at x)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    MESON_TAC [CONTINUOUS_WITHIN_COMPOSE, IN_IMAGE, CONTINUOUS_WITHIN_SUBSET,
               SUBSET_UNIV, IN_UNIV])

  let CONTINUOUS_ON_COMPOSE ← prove
   r"!f g s. f continuous_on s /\ g continuous_on (IMAGE f s)
           ==> (g o f) continuous_on s"
   (REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    MESON_TAC [IN_IMAGE, CONTINUOUS_WITHIN_COMPOSE])

  let CONTINUOUS_WITHIN_OPEN ← prove
   r"!f:real^M->real^N x u.
     f continuous (at x within u) <=>
        !t. open t /\ f(x) IN t
            ==> ?s. open s /\ x IN s /\
                    !x'. x' IN s /\ x' IN u ==> f(x') IN t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_within] THEN EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      GEN_REWRITE_TAC LAND_CONV [open_def] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^M->real^N) x")) THEN
      ASM_MESON_TAC [IN_BALL, DIST_SYM, OPEN_BALL, CENTRE_IN_BALL, DIST_SYM],
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"ball((f:real^M->real^N) x,e)")) THEN
      ASM_SIMP_TAC [OPEN_BALL, CENTRE_IN_BALL] THEN
      MESON_TAC [open_def, IN_BALL, REAL_LT_TRANS, DIST_SYM]])

  let CONTINUOUS_AT_OPEN ← prove
   r"!f:real^M->real^N x.
     f continuous (at x) <=>
        !t. open t /\ f(x) IN t
            ==> ?s. open s /\ x IN s /\
                    !x'. x' IN s ==> f(x') IN t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_at] THEN EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      GEN_REWRITE_TAC LAND_CONV [open_def] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^M->real^N) x")) THEN
      ASM_MESON_TAC [IN_BALL, DIST_SYM, OPEN_BALL, CENTRE_IN_BALL],
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"ball((f:real^M->real^N) x,e)")) THEN
      ASM_SIMP_TAC [OPEN_BALL, CENTRE_IN_BALL] THEN
      MESON_TAC [open_def, IN_BALL, REAL_LT_TRANS, DIST_SYM]])

  let CONTINUOUS_ON_OPEN_GEN ← prove
   r"!f:real^M->real^N s t.
    IMAGE f s SUBSET t
    ==> (f continuous_on s <=>
         !u. open_in (subtopology euclidean t) u
             ==> open_in (subtopology euclidean s) {x | x IN s /\ f x IN u})"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [continuous_on] THEN EQ_TAC THENL
     [REWRITE_TAC [open_in, SUBSET, IN_ELIM_THM] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
      CONJ_TAC THENL [ASM_MESON_TAC [DIST_REFL], ALL_TAC] THEN
      X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(f:real^M->real^N) x")) THEN ASM SET_TAC [],
      DISCH_TAC THEN X_GEN_TAC (← q r"x:real^M") THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o
        SPEC (← q r"ball((f:real^M->real^N) x,e) INTER t")) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [OPEN_IN_OPEN, INTER_COMM, OPEN_BALL], ALL_TAC] THEN
      REWRITE_TAC [open_in, SUBSET, IN_INTER, IN_ELIM_THM, IN_BALL, IN_IMAGE] THEN
      REWRITE_TAC [AND_FORALL_THM] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) THEN
      ASM_MESON_TAC [DIST_REFL, DIST_SYM]])

  let CONTINUOUS_ON_OPEN ← prove
   r"!f:real^M->real^N s.
      f continuous_on s <=>
        !t. open_in (subtopology euclidean (IMAGE f s)) t
            ==> open_in (subtopology euclidean s) {x | x IN s /\ f(x) IN t}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_OPEN_GEN THEN
    REWRITE_TAC [SUBSET_REFL])

  let CONTINUOUS_OPEN_IN_PREIMAGE_GEN ← prove
   r"!f:real^M->real^N s t u.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        open_in (subtopology euclidean t) u
        ==> open_in (subtopology euclidean s) {x | x IN s /\ f x IN u}"
   (MESON_TAC [CONTINUOUS_ON_OPEN_GEN])

  let CONTINUOUS_ON_IMP_OPEN_IN ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\
        open_in (subtopology euclidean (IMAGE f s)) t
        ==> open_in (subtopology euclidean s) {x | x IN s /\ f x IN t}"
   (MESON_TAC [CONTINUOUS_ON_OPEN])

  let CONTINUOUS_OPEN_IN_PREIMAGE_SUBSET ← prove
   r"!f:real^M->real^N s t u v.
        f continuous_on s /\
        IMAGE f s SUBSET t /\
        open_in (subtopology euclidean s) u /\
        open_in (subtopology euclidean t) v
        ==> open_in (subtopology euclidean s) {x | x IN u /\ f x IN v}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"u:real^M->bool") THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ASM SET_TAC []])

  return { CONTINUOUS_WITHIN_ID, CONTINUOUS_AT_ID, CONTINUOUS_ON_ID, UNIFORMLY_CONTINUOUS_ON_ID,
           CONTINUOUS_WITHIN_COMPOSE, CONTINUOUS_AT_COMPOSE, CONTINUOUS_ON_COMPOSE,
           CONTINUOUS_WITHIN_OPEN, CONTINUOUS_AT_OPEN, CONTINUOUS_ON_OPEN_GEN,
           CONTINUOUS_ON_OPEN, CONTINUOUS_OPEN_IN_PREIMAGE_GEN, CONTINUOUS_ON_IMP_OPEN_IN,
           CONTINUOUS_OPEN_IN_PREIMAGE_SUBSET }

/- ------------------------------------------------------------------------- -/
/- Continuity in terms of closed sets; half-global and global cases.        -/
/- (topology.ml 7714-7875)                                                   -/
/- ------------------------------------------------------------------------- -/

structure CLC where
  CONTINUOUS_ON_CLOSED_GEN : thm
  CONTINUOUS_ON_CLOSED : thm
  CONTINUOUS_CLOSED_IN_PREIMAGE_GEN : thm
  CONTINUOUS_ON_IMP_CLOSED_IN : thm
  CONTINUOUS_CLOSED_IN_PREIMAGE_SUBSET : thm
  CONTINUOUS_OPEN_IN_PREIMAGE : thm
  CONTINUOUS_CLOSED_IN_PREIMAGE : thm
  CONTINUOUS_OPEN_PREIMAGE : thm
  CONTINUOUS_CLOSED_PREIMAGE : thm
  CONTINUOUS_OPEN_PREIMAGE_UNIV : thm
  CONTINUOUS_CLOSED_PREIMAGE_UNIV : thm
  CONTINUOUS_OPEN_IN_PREIMAGE_EQ : thm
  CONTINUOUS_CLOSED_IN_PREIMAGE_EQ : thm
  RESTRICTION_CONTINUOUS_ON : thm
  deriving Inhabited

@[nospecialize]
def setupCLC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BCSL : CSL)
    (BIDC : IDC) : ExceptT String IO CLC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, INTRO_TAC, .. } := D
  let { EQ_IMP, .. } := D.core1
  let { INTER_COMM, .. } := D.core2
  let { IN_UNIV, .. } := D.core3
  let { RESTRICTION, SUBSET_REFL, SUBSET_RESTRICT, .. } := D.core5
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_TRANS, .. } := D.met1
  let { OPEN_IN_CLOSED_IN_EQ, closed_in, .. } := D.met3
  let { OPEN_INTER, OPEN_UNIV, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_INTER, CLOSED_UNIV, .. } := BCLO
  let { CLOSED_IN_CLOSED, CLOSED_IN_CLOSED_INTER, OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, .. } := BLOC
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_OPEN, CONTINUOUS_ON_OPEN_GEN, .. } := BIDC
  -- @@SCOPE END

  let CONTINUOUS_ON_CLOSED_GEN ← prove
   r"!f:real^M->real^N s t.
    IMAGE f s SUBSET t
    ==> (f continuous_on s <=>
         !u. closed_in (subtopology euclidean t) u
             ==> closed_in (subtopology euclidean s)
                           {x | x IN s /\ f x IN u})"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (fun th => tactic_of do
      pure (ONCE_REWRITE_TAC [← MATCH_MP CONTINUOUS_ON_OPEN_GEN th])) THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t DIFF u:real^N->bool")) THENL
     [REWRITE_TAC [closed_in], REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ]] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [SUBSET_RESTRICT] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let CONTINUOUS_ON_CLOSED ← prove
   r"!f:real^M->real^N s.
      f continuous_on s <=>
        !t. closed_in (subtopology euclidean (IMAGE f s)) t
            ==> closed_in (subtopology euclidean s) {x | x IN s /\ f(x) IN t}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_CLOSED_GEN THEN
    REWRITE_TAC [SUBSET_REFL])

  let CONTINUOUS_CLOSED_IN_PREIMAGE_GEN ← prove
   r"!f:real^M->real^N s t u.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        closed_in (subtopology euclidean t) u
        ==> closed_in (subtopology euclidean s) {x | x IN s /\ f x IN u}"
   (MESON_TAC [CONTINUOUS_ON_CLOSED_GEN])

  let CONTINUOUS_ON_IMP_CLOSED_IN ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\
        closed_in (subtopology euclidean (IMAGE f s)) t
        ==> closed_in (subtopology euclidean s) {x | x IN s /\ f x IN t}"
   (MESON_TAC [CONTINUOUS_ON_CLOSED])

  let CONTINUOUS_CLOSED_IN_PREIMAGE_SUBSET ← prove
   r"!f:real^M->real^N s t u v.
        f continuous_on s /\
        IMAGE f s SUBSET t /\
        closed_in (subtopology euclidean s) u /\
        closed_in (subtopology euclidean t) v
        ==> closed_in (subtopology euclidean s) {x | x IN u /\ f x IN v}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_IN_TRANS THEN EXISTS_TAC (← q r"u:real^M->bool") THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_GEN THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET)) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ASM SET_TAC []])

  let CONTINUOUS_OPEN_IN_PREIMAGE ← prove
   r"!f s t.
         f continuous_on s /\ open t
         ==> open_in (subtopology euclidean s) {x | x IN s /\ f x IN t}"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← SET_RULE
     (← q r"x IN s /\ f x IN t <=> x IN s /\ f x IN (t INTER IMAGE f s)")] THEN
    FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [CONTINUOUS_ON_OPEN]) THEN
    ONCE_REWRITE_TAC [INTER_COMM] THEN MATCH_MP_TAC OPEN_IN_OPEN_INTER THEN
    ASM_REWRITE_TAC [])

  let CONTINUOUS_CLOSED_IN_PREIMAGE ← prove
   r"!f s t.
         f continuous_on s /\ closed t
         ==> closed_in (subtopology euclidean s) {x | x IN s /\ f x IN t}"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← SET_RULE
     (← q r"x IN s /\ f x IN t <=> x IN s /\ f x IN (t INTER IMAGE f s)")] THEN
    FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [CONTINUOUS_ON_CLOSED]) THEN
    ONCE_REWRITE_TAC [INTER_COMM] THEN MATCH_MP_TAC CLOSED_IN_CLOSED_INTER THEN
    ASM_REWRITE_TAC [])

  let CONTINUOUS_OPEN_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
     f continuous_on s /\ open s /\ open t
     ==> open {x | x IN s /\ f(x) IN t}"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONTINUOUS_ON_OPEN]) THEN
    REWRITE_TAC [OPEN_IN_OPEN] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (f:real^M->real^N) s INTER t")) THEN
    ANTS_TAC THENL
     [EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [],
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"{x | x IN s /\ (f:real^M->real^N) x IN t} =
                   s INTER t'") SUBST1_TAC THENL
      [ASM SET_TAC [], ASM_MESON_TAC [OPEN_INTER]]])

  let CONTINUOUS_CLOSED_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
     f continuous_on s /\ closed s /\ closed t
     ==> closed {x | x IN s /\ f(x) IN t}"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONTINUOUS_ON_CLOSED]) THEN
    REWRITE_TAC [CLOSED_IN_CLOSED] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (f:real^M->real^N) s INTER t")) THEN
    ANTS_TAC THENL
     [EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [],
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"{x | x IN s /\ (f:real^M->real^N) x IN t} =
                   s INTER t'") SUBST1_TAC THENL
      [ASM SET_TAC [], ASM_MESON_TAC [CLOSED_INTER]]])

  let CONTINUOUS_OPEN_PREIMAGE_UNIV ← prove
   r"!f:real^M->real^N s.
        (!x. f continuous (at x)) /\ open s ==> open {x | f(x) IN s}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"f:real^M->real^N", ← q r"(:real^M)", ← q r"s:real^N->bool"]
      CONTINUOUS_OPEN_PREIMAGE) THEN
    ASM_SIMP_TAC [OPEN_UNIV, IN_UNIV, CONTINUOUS_AT_IMP_CONTINUOUS_ON])

  let CONTINUOUS_CLOSED_PREIMAGE_UNIV ← prove
   r"!f:real^M->real^N s.
        (!x. f continuous (at x)) /\ closed s ==> closed {x | f(x) IN s}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"f:real^M->real^N", ← q r"(:real^M)", ← q r"s:real^N->bool"]
      CONTINUOUS_CLOSED_PREIMAGE) THEN
    ASM_SIMP_TAC [CLOSED_UNIV, IN_UNIV, CONTINUOUS_AT_IMP_CONTINUOUS_ON])

  let CONTINUOUS_OPEN_IN_PREIMAGE_EQ ← prove
   r"!f:real^M->real^N s.
    f continuous_on s <=>
    !t. open t ==> open_in (subtopology euclidean s) {x | x IN s /\ f x IN t}"
   (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [CONTINUOUS_OPEN_IN_PREIMAGE] THEN
    REWRITE_TAC [CONTINUOUS_ON_OPEN] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN GEN_REWRITE_TAC LAND_CONV [OPEN_IN_OPEN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:real^N->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [])

  let CONTINUOUS_CLOSED_IN_PREIMAGE_EQ ← prove
   r"!f:real^M->real^N s.
    f continuous_on s <=>
    !t. closed t
        ==> closed_in (subtopology euclidean s) {x | x IN s /\ f x IN t}"
   (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [CONTINUOUS_CLOSED_IN_PREIMAGE] THEN
    REWRITE_TAC [CONTINUOUS_ON_CLOSED] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN
    GEN_REWRITE_TAC LAND_CONV [CLOSED_IN_CLOSED] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:real^N->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [])

  let RESTRICTION_CONTINUOUS_ON ← prove
   r"!s t f:real^M->real^N.
     s SUBSET t ==> (RESTRICTION t f continuous_on s <=> f continuous_on s)"
   (INTRO_TAC "!s t f; sub" THEN REWRITE_TAC [CONTINUOUS_OPEN_IN_PREIMAGE_EQ] THEN
    SUBGOAL_THEN
      (← q r"!u. {x:real^M | x IN s /\ RESTRICTION t f x:real^N IN u} =
           {x | x IN s /\ f x IN u}")
      (fun th => REWRITE_TAC [th]) THEN
    REWRITE_TAC [RESTRICTION] THEN ASM SET_TAC [])

  return { CONTINUOUS_ON_CLOSED_GEN, CONTINUOUS_ON_CLOSED, CONTINUOUS_CLOSED_IN_PREIMAGE_GEN,
           CONTINUOUS_ON_IMP_CLOSED_IN, CONTINUOUS_CLOSED_IN_PREIMAGE_SUBSET,
           CONTINUOUS_OPEN_IN_PREIMAGE, CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_OPEN_PREIMAGE,
           CONTINUOUS_CLOSED_PREIMAGE, CONTINUOUS_OPEN_PREIMAGE_UNIV,
           CONTINUOUS_CLOSED_PREIMAGE_UNIV, CONTINUOUS_OPEN_IN_PREIMAGE_EQ,
           CONTINUOUS_CLOSED_IN_PREIMAGE_EQ, RESTRICTION_CONTINUOUS_ON }

/- ------------------------------------------------------------------------- -/
/- Linear and bilinear functions are continuous; preservation of           -/
/- compactness and connectedness.  (topology.ml 7876-8042)                   -/
/- ------------------------------------------------------------------------- -/

structure LCP where
  LINEAR_LIM_0 : thm
  LINEAR_CONTINUOUS_AT : thm
  LINEAR_CONTINUOUS_WITHIN : thm
  LINEAR_CONTINUOUS_ON : thm
  LINEAR_CONTINUOUS_COMPOSE : thm
  LINEAR_CONTINUOUS_ON_COMPOSE : thm
  CONTINUOUS_LIFT_COMPONENT_COMPOSE : thm
  CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE : thm
  BILINEAR_CONTINUOUS_COMPOSE : thm
  BILINEAR_CONTINUOUS_ON_COMPOSE : thm
  BILINEAR_CONTINUOUS_ON : thm
  BILINEAR_DOT : thm
  CONTINUOUS_LIFT_DOT2 : thm
  CONTINUOUS_ON_LIFT_DOT2 : thm
  COMPACT_CONTINUOUS_IMAGE : thm
  COMPACT_TRANSLATION : thm
  COMPACT_TRANSLATION_EQ : thm
  COMPACT_LINEAR_IMAGE : thm
  COMPACT_LINEAR_IMAGE_EQ : thm
  CONNECTED_CONTINUOUS_IMAGE : thm
  CONNECTED_TRANSLATION : thm
  CONNECTED_TRANSLATION_EQ : thm
  CONNECTED_LINEAR_IMAGE : thm
  CONNECTED_LINEAR_IMAGE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupLCP [HolBase] (D : TopologyDeps) (BCON : CON) (BLIM2 : LIM2) (BARI : ARI) (BUNQ : UNQ)
    (BCPT : CPT) (BCNT1 : CNT1) (BCNO : CNO) (BCSL : CSL) (BCMS : CMS) (BIDC : IDC) :
    ExceptT String IO LCP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, LINEAR_INVARIANT_RULE,
        add_linear_invariants, add_translation_invariants, .. } := D
  let { IMAGE_ID, IMAGE_o, IMP_CONJ_ALT, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LT_DIV, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_SYM, .. } := D.core5
  let { o_DEF, .. } := D.core6
  let { DOT_LADD, DOT_LMUL, DOT_RADD, DOT_RMUL, .. } := D.vec1
  let { LIFT_ADD, LIFT_CMUL, LINEAR_BOUNDED_POS, LINEAR_FSTCART, LINEAR_LIFT_COMPONENT,
        LINEAR_SNDCART, .. } := D.vec2
  let { VECTOR_SUB_RZERO, bilinear, dist, linear, .. } := D.vec4
  let { COMPACT_IN_ABSOLUTE, CONNECTED_IN_ABSOLUTE, CONNECTED_IN_CONTINUOUS_MAP_IMAGE, .. } :=
    D.met1
  let { IMAGE_COMPACT_IN, .. } := D.met2
  let { CONNECTED_IN_EUCLIDEAN, .. } := BCON
  let { LIM_AT, .. } := BLIM2
  let { LIM_LINEAR, LIM_NULL, .. } := BARI
  let { LIM_AT_ZERO, LIM_BILINEAR, .. } := BUNQ
  let { COMPACT_IN_EUCLIDEAN, .. } := BCPT
  let { CONTINUOUS_AT, CONTINUOUS_AT_WITHIN, continuous, .. } := BCNT1
  let { CONTINUOUS_MAP_EUCLIDEAN, .. } := BCNO
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_ID, .. } := BIDC
  -- @@SCOPE END

  let LINEAR_LIM_0 ← prove
   r"!f. linear f ==> (f --> vec 0) (at (vec 0))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [LIM_AT] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP LINEAR_BOUNDED_POS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"e / B") THEN
    ASM_SIMP_TAC [REAL_LT_DIV] THEN REWRITE_TAC [dist, VECTOR_SUB_RZERO] THEN
    ASM_MESON_TAC [REAL_MUL_SYM, REAL_LET_TRANS, REAL_LT_RDIV_EQ])

  let LINEAR_CONTINUOUS_AT ← prove
   r"!f:real^M->real^N a. linear f ==> f continuous (at a)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"\x. (f:real^M->real^N) (a + x) - f(a)") LINEAR_LIM_0) THEN
    ANTS_TAC THENL
     [POP_ASSUM MP_TAC THEN SIMP_TAC [linear] THEN
      REPEAT STRIP_TAC THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [← GSYM LIM_NULL, CONTINUOUS_AT] THEN
    GEN_REWRITE_TAC RAND_CONV [LIM_AT_ZERO] THEN SIMP_TAC [])

  let LINEAR_CONTINUOUS_WITHIN ← prove
   r"!f:real^M->real^N s x. linear f ==> f continuous (at x within s)"
   (SIMP_TAC [CONTINUOUS_AT_WITHIN, LINEAR_CONTINUOUS_AT])

  let LINEAR_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N s. linear f ==> f continuous_on s"
   (MESON_TAC [LINEAR_CONTINUOUS_AT, CONTINUOUS_AT_IMP_CONTINUOUS_ON])

  let LINEAR_CONTINUOUS_COMPOSE ← prove
   r"!net f:A->real^N g:real^N->real^P.
        f continuous net /\ linear g ==> (\x. g(f x)) continuous net"
   (REWRITE_TAC [continuous, LIM_LINEAR])

  let LINEAR_CONTINUOUS_ON_COMPOSE ← prove
   r"!f:real^M->real^N g:real^N->real^P s.
        f continuous_on s /\ linear g ==> (\x. g(f x)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
              LINEAR_CONTINUOUS_COMPOSE])

  let CONTINUOUS_LIFT_COMPONENT_COMPOSE ← prove
   r"!net f:A->real^N i.
    f continuous net ==> (\x. lift(f x$i)) continuous net"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"linear(\x:real^N. lift (x$i))") MP_TAC THENL
     [REWRITE_TAC [LINEAR_LIFT_COMPONENT], REWRITE_TAC [← GSYM IMP_CONJ_ALT]] THEN
    REWRITE_TAC [LINEAR_CONTINUOUS_COMPOSE])

  let CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s
        ==> (\x. lift (f x$i)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
              CONTINUOUS_LIFT_COMPONENT_COMPOSE])

  let BILINEAR_CONTINUOUS_COMPOSE ← prove
   r"!net f:A->real^M g:A->real^N h:real^M->real^N->real^P.
        f continuous net /\ g continuous net /\ bilinear h
        ==> (\x. h (f x) (g x)) continuous net"
   (REWRITE_TAC [continuous, LIM_BILINEAR])

  let BILINEAR_CONTINUOUS_ON_COMPOSE ← prove
   r"!f g h s. f continuous_on s /\ g continuous_on s /\ bilinear h
             ==> (\x. h (f x) (g x)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
              BILINEAR_CONTINUOUS_COMPOSE])

  let BILINEAR_CONTINUOUS_ON ← prove
   r"!bop:real^M->real^N->real^P.
        bilinear bop ==> (\z. bop (fstcart z) (sndcart z)) continuous_on UNIV"
   (SIMP_TAC [BILINEAR_CONTINUOUS_ON_COMPOSE, LINEAR_CONTINUOUS_ON,
              LINEAR_FSTCART, LINEAR_SNDCART])

  let BILINEAR_DOT ← prove
   r"bilinear (\x y:real^N. lift(x dot y))"
   (REWRITE_TAC [bilinear, linear, DOT_LADD, DOT_RADD, DOT_LMUL, DOT_RMUL] THEN
    REWRITE_TAC [LIFT_ADD, LIFT_CMUL])

  let CONTINUOUS_LIFT_DOT2 ← prove
   r"!net f g:A->real^N.
        f continuous net /\ g continuous net
        ==> (\x. lift(f x dot g x)) continuous net"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← MATCH_MP (← REWRITE_RULE
     [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
    BILINEAR_CONTINUOUS_COMPOSE) BILINEAR_DOT)) THEN REWRITE_TAC [])

  let CONTINUOUS_ON_LIFT_DOT2 ← prove
   r"!f:real^M->real^N g s.
        f continuous_on s /\ g continuous_on s
        ==> (\x. lift(f x dot g x)) continuous_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← MATCH_MP (← REWRITE_RULE
     [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
    BILINEAR_CONTINUOUS_ON_COMPOSE) BILINEAR_DOT)) THEN REWRITE_TAC [])

  let COMPACT_CONTINUOUS_IMAGE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ compact s ==> compact(IMAGE f s)"
   (REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN, ← GSYM CONTINUOUS_MAP_EUCLIDEAN] THEN
    MESON_TAC [IMAGE_COMPACT_IN, COMPACT_IN_ABSOLUTE])

  let COMPACT_TRANSLATION ← prove
   r"!s a:real^N. compact s ==> compact (IMAGE (\x. a + x) s)"
   (SIMP_TAC [COMPACT_CONTINUOUS_IMAGE, CONTINUOUS_ON_ADD,
              CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID])

  let COMPACT_TRANSLATION_EQ ← prove
   r"!a s. compact (IMAGE (\x:real^N. a + x) s) <=> compact s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [COMPACT_TRANSLATION] THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"--a:real^N") o MATCH_MP COMPACT_TRANSLATION) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, IMAGE_ID,
                 ← VECTOR_ARITH (← q r"--a + a + x:real^N = x")])

  add_translation_invariants [COMPACT_TRANSLATION_EQ]

  let COMPACT_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s. compact s /\ linear f ==> compact(IMAGE f s)"
   (SIMP_TAC [LINEAR_CONTINUOUS_ON, COMPACT_CONTINUOUS_IMAGE])

  let COMPACT_LINEAR_IMAGE_EQ ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (compact (IMAGE f s) <=> compact s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE COMPACT_LINEAR_IMAGE))

  add_linear_invariants [COMPACT_LINEAR_IMAGE_EQ]

  let CONNECTED_CONTINUOUS_IMAGE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ connected s ==> connected(IMAGE f s)"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN, ← GSYM CONTINUOUS_MAP_EUCLIDEAN] THEN
    MESON_TAC [CONNECTED_IN_CONTINUOUS_MAP_IMAGE, CONNECTED_IN_ABSOLUTE])

  let CONNECTED_TRANSLATION ← prove
   r"!a s. connected s ==> connected (IMAGE (\x:real^N. a + x) s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST])

  let CONNECTED_TRANSLATION_EQ ← prove
   r"!a s. connected (IMAGE (\x:real^N. a + x) s) <=> connected s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [CONNECTED_TRANSLATION] THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"--a:real^N") o MATCH_MP CONNECTED_TRANSLATION) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, IMAGE_ID,
                 ← VECTOR_ARITH (← q r"--a + a + x:real^N = x")])

  add_translation_invariants [CONNECTED_TRANSLATION_EQ]

  let CONNECTED_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s. connected s /\ linear f ==> connected(IMAGE f s)"
   (SIMP_TAC [LINEAR_CONTINUOUS_ON, CONNECTED_CONTINUOUS_IMAGE])

  let CONNECTED_LINEAR_IMAGE_EQ ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (connected (IMAGE f s) <=> connected s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE CONNECTED_LINEAR_IMAGE))

  add_linear_invariants [CONNECTED_LINEAR_IMAGE_EQ]

  return { LINEAR_LIM_0, LINEAR_CONTINUOUS_AT, LINEAR_CONTINUOUS_WITHIN, LINEAR_CONTINUOUS_ON,
           LINEAR_CONTINUOUS_COMPOSE, LINEAR_CONTINUOUS_ON_COMPOSE,
           CONTINUOUS_LIFT_COMPONENT_COMPOSE, CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE,
           BILINEAR_CONTINUOUS_COMPOSE, BILINEAR_CONTINUOUS_ON_COMPOSE, BILINEAR_CONTINUOUS_ON,
           BILINEAR_DOT, CONTINUOUS_LIFT_DOT2, CONTINUOUS_ON_LIFT_DOT2, COMPACT_CONTINUOUS_IMAGE,
           COMPACT_TRANSLATION, COMPACT_TRANSLATION_EQ, COMPACT_LINEAR_IMAGE,
           COMPACT_LINEAR_IMAGE_EQ, CONNECTED_CONTINUOUS_IMAGE, CONNECTED_TRANSLATION,
           CONNECTED_TRANSLATION_EQ, CONNECTED_LINEAR_IMAGE, CONNECTED_LINEAR_IMAGE_EQ }

/- ------------------------------------------------------------------------- -/
/- Preservation properties for pasted sets (Cartesian products), part 1.   -/
/- (topology.ml 8043-8219)                                                   -/
/- ------------------------------------------------------------------------- -/

structure PCR1 where
  BOUNDED_PCROSS_EQ : thm
  BOUNDED_PCROSS : thm
  CLOSED_PCROSS_EQ : thm
  CLOSED_PCROSS : thm
  COMPACT_PCROSS_EQ : thm
  COMPACT_PCROSS : thm
  OPEN_PCROSS_EQ : thm
  OPEN_PCROSS : thm
  OPEN_IN_PCROSS : thm
  PASTECART_IN_INTERIOR_SUBTOPOLOGY : thm
  PASTECART_IN_INTERIOR : thm
  OPEN_IN_PCROSS_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupPCR1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLOC : LOC)
    (BLIM2 : LIM2) (BSEQ : SEQ) (BBND1 : BND1) (BCPT : CPT) : ExceptT String IO PCR1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, NORM_ARITH, .. } :=
    D
  let { EXTENSION, .. } := D.core1
  let { FORALL_AND_THM, FORALL_PASTECART, FORALL_UNWIND_THM2, FSTCART_PASTECART, FUN_EQ_THM,
        INTER_SUBSET, IN_DIFF, IN_ELIM_PASTECART_THM, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND,
        MONO_FORALL, NOT_IN_EMPTY, PASTECART_EQ, PASTECART_IN_PCROSS, PCROSS, PCROSS_EMPTY, .. } :=
    D.core3
  let { REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_TRANS, .. } := D.core4
  let { REAL_SUB_LT, SKOLEM_THM, SNDCART_PASTECART, SUBSET, .. } := D.core5
  let { SWAP_FORALL_THM, UNIV_PCROSS_UNIV, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_PASTECART_CANCEL, DIST_SYM, .. } := D.vec1
  let { NORM_LE_PASTECART, NORM_PASTECART_LE, PASTECART_SUB, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { OPEN_IN_EMPTY, OPEN_IN_SUBOPEN, SUBTOPOLOGY_UNIV, .. } := D.met3
  let { OPEN_EMPTY, OPEN_IN, open_def, .. } := BEUC
  let { CLOSED_EMPTY, CLOSED_UNION, CLOSED_UNIV, OPEN_CLOSED, .. } := BCLO
  let { CENTRE_IN_BALL, IN_BALL, .. } := BBAL
  let { OPEN_IN_OPEN, open_in, .. } := BLOC
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { CLOSED_SEQUENTIAL_LIMITS, .. } := BSEQ
  let { BOUNDED_EMPTY, bounded, .. } := BBND1
  let { COMPACT_EQ_BOUNDED_CLOSED, .. } := BCPT
  -- @@SCOPE END

  let BOUNDED_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        bounded (s PCROSS t) <=>
        s = {} \/ t = {} \/ bounded s /\ bounded t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PCROSS] THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x y |x,y| F} = {}"), BOUNDED_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [bounded, FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
    ASM_MESON_TAC [NORM_LE_PASTECART, REAL_LE_TRANS, NORM_PASTECART_LE,
                   REAL_LE_ADD2])

  let BOUNDED_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
     bounded s /\ bounded t ==> bounded (s PCROSS t)"
   (SIMP_TAC [BOUNDED_PCROSS_EQ])

  let CLOSED_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        closed (s PCROSS t) <=>
        s = {} \/ t = {} \/ closed s /\ closed t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PCROSS] THEN MAP_EVERY ASM_CASES_TAC
     [← q r"s:real^M->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, CLOSED_EMPTY, ← SET_RULE
     (← q r"{f x y |x,y| F} = {}")] THEN
    REWRITE_TAC [CLOSED_SEQUENTIAL_LIMITS, LIM_SEQUENTIALLY] THEN
    REWRITE_TAC [FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
    REWRITE_TAC [IN_ELIM_THM, SKOLEM_THM, FORALL_AND_THM] THEN
    ONCE_REWRITE_TAC [← GSYM FUN_EQ_THM] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    SIMP_TAC [← TAUT (← q r"((p /\ q) /\ r) /\ s ==> t <=> r ==> p /\ q /\ s ==> t")] THEN
    ONCE_REWRITE_TAC [← MESON []
     (← q r"(!a b c d e. P a b c d e) <=> (!d e b c a. P a b c d e)")] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN EQ_TAC THENL
     [GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
       [← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)"), FORALL_AND_THM] THEN
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [ALL_TAC, GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM]] THEN
      MATCH_MP_TAC MONO_FORALL THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN MATCH_MP_TAC (← MESON []
       (← q r"(?x. P x (\n. x)) ==> (?s x. P x s)")) THEN
      ASM_MESON_TAC [DIST_PASTECART_CANCEL],
      ONCE_REWRITE_TAC [← MESON []
       (← q r"(!x l. P x l) /\ (!y m. Q y m) <=> (!x y l m. P x l /\ Q y m)")] THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      REWRITE_TAC [dist, PASTECART_SUB] THEN
      ASM_MESON_TAC [NORM_LE_PASTECART, REAL_LET_TRANS]])

  let CLOSED_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
     closed s /\ closed t ==> closed (s PCROSS t)"
   (SIMP_TAC [CLOSED_PCROSS_EQ])

  let COMPACT_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        compact (s PCROSS t) <=>
        s = {} \/ t = {} \/ compact s /\ compact t"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_PCROSS_EQ,
                 BOUNDED_PCROSS_EQ] THEN
    MESON_TAC [])

  let COMPACT_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
     compact s /\ compact t ==> compact (s PCROSS t)"
   (SIMP_TAC [COMPACT_PCROSS_EQ])

  let OPEN_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        open (s PCROSS t) <=>
        s = {} \/ t = {} \/ open s /\ open t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PCROSS] THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x y |x,y| F} = {}"), OPEN_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    EQ_TAC THENL
     [REWRITE_TAC [open_def, FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
      ASM_MESON_TAC [DIST_PASTECART_CANCEL],
      REWRITE_TAC [OPEN_CLOSED] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"UNIV DIFF {pastecart x y | x IN s /\ y IN t} =
        {pastecart x y | x IN ((:real^M) DIFF s) /\ y IN (:real^N)} UNION
        {pastecart x y | x IN (:real^M) /\ y IN ((:real^N) DIFF t)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_DIFF, IN_UNION, FORALL_PASTECART, IN_UNIV] THEN
        REWRITE_TAC [IN_ELIM_THM, PASTECART_EQ, FSTCART_PASTECART,
                     SNDCART_PASTECART] THEN MESON_TAC [],
        SIMP_TAC [← GSYM PCROSS] THEN MATCH_MP_TAC CLOSED_UNION THEN CONJ_TAC THEN
        MATCH_MP_TAC CLOSED_PCROSS THEN ASM_REWRITE_TAC [CLOSED_UNIV]]])

  let OPEN_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        open s /\ open t ==> open (s PCROSS t)"
   (SIMP_TAC [OPEN_PCROSS_EQ])

  let OPEN_IN_PCROSS ← prove
   r"!s s':real^M->bool t t':real^N->bool.
        open_in (subtopology euclidean s) s' /\
        open_in (subtopology euclidean t) t'
        ==> open_in (subtopology euclidean (s PCROSS t)) (s' PCROSS t')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_OPEN] THEN DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"s'':real^M->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"t'':real^N->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"(s'':real^M->bool) PCROSS (t'':real^N->bool)") THEN
    ASM_SIMP_TAC [OPEN_PCROSS, EXTENSION, FORALL_PASTECART] THEN
    REWRITE_TAC [IN_INTER, PASTECART_IN_PCROSS] THEN ASM SET_TAC [])

  let PASTECART_IN_INTERIOR_SUBTOPOLOGY ← prove
   r"!s t u x:real^M y:real^N.
     pastecart x y IN u /\ open_in (subtopology euclidean (s PCROSS t)) u
     ==> ?v w. open_in (subtopology euclidean s) v /\ x IN v /\
               open_in (subtopology euclidean t) w /\ y IN w /\
               (v PCROSS w) SUBSET u"
   (REWRITE_TAC [open_in, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^M", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"ball(x:real^M,e / &2) INTER s") THEN
    EXISTS_TAC (← q r"ball(y:real^N,e / &2) INTER t") THEN
    SUBGOAL_THEN (← q r"(x:real^M) IN s /\ (y:real^N) IN t") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, PASTECART_IN_PCROSS], ALL_TAC] THEN
    ASM_SIMP_TAC [INTER_SUBSET, IN_INTER, CENTRE_IN_BALL, REAL_HALF] THEN
    REWRITE_TAC [IN_BALL] THEN REPEAT (CONJ_TAC THENL
     [MESON_TAC [REAL_SUB_LT, ← NORM_ARITH
       (← q r"dist(x,y) < e /\ dist(z,y) < e - dist(x,y)
        ==> dist(x:real^N,z) < e")],
      ALL_TAC]) THEN
    REWRITE_TAC [SUBSET, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
    REWRITE_TAC [IN_BALL, IN_INTER] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [dist, PASTECART_SUB] THEN
    W (MP_TAC o PART_MATCH lhand NORM_PASTECART_LE o lhand o snd) THEN
    REWRITE_TAC [← GSYM (← ONCE_REWRITE_RULE [DIST_SYM] dist)] THEN
    ASM_REAL_ARITH_TAC)

  let PASTECART_IN_INTERIOR ← prove
   r"!u x:real^M y:real^N.
     pastecart x y IN u /\ open u
     ==> ?v w. open v /\ x IN v /\ open w /\ y IN w /\ (v PCROSS w) SUBSET u"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [← GSYM UNIV_PCROSS_UNIV, PASTECART_IN_INTERIOR_SUBTOPOLOGY])

  let OPEN_IN_PCROSS_EQ ← prove
   r"!s s':real^M->bool t t':real^N->bool.
        open_in (subtopology euclidean (s PCROSS t)) (s' PCROSS t') <=>
        s' = {} \/ t' = {} \/
        open_in (subtopology euclidean s) s' /\
        open_in (subtopology euclidean t) t'"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s':real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, OPEN_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"t':real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, OPEN_IN_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [OPEN_IN_PCROSS] THEN REPEAT STRIP_TAC THENL
     [ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"~(t':real^N->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"y:real^N")),
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"~(s':real^M->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"x:real^M"))] THEN
     MP_TAC (← ISPECL
       [← q r"s:real^M->bool", ← q r"t:real^N->bool",
        ← q r"(s':real^M->bool) PCROSS (t':real^N->bool)",
        ← q r"x:real^M", ← q r"y:real^N"] PASTECART_IN_INTERIOR_SUBTOPOLOGY) THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
    MESON_TAC [])

  return { BOUNDED_PCROSS_EQ, BOUNDED_PCROSS, CLOSED_PCROSS_EQ, CLOSED_PCROSS,
           COMPACT_PCROSS_EQ, COMPACT_PCROSS, OPEN_PCROSS_EQ, OPEN_PCROSS, OPEN_IN_PCROSS,
           PASTECART_IN_INTERIOR_SUBTOPOLOGY, PASTECART_IN_INTERIOR, OPEN_IN_PCROSS_EQ }

/- ------------------------------------------------------------------------- -/
/- Preservation properties for pasted sets (Cartesian products), part 2.   -/
/- (topology.ml 8220-8390)                                                   -/
/- ------------------------------------------------------------------------- -/

structure PCR2 where
  INTERIOR_PCROSS : thm
  LIPSCHITZ_CONTINUOUS_MAP_PASTING : thm
  LIPSCHITZ_CONTINUOUS_MAP_CART_PROJECTIONS : thm
  LIPSCHITZ_CONTINUOUS_MAP_PASTEWISE : thm
  LIPSCHITZ_CONTINUOUS_MAP_PASTED : thm
  UNIFORMLY_CONTINUOUS_MAP_PASTEWISE : thm
  UNIFORMLY_CONTINUOUS_MAP_PASTED : thm
  CAUCHY_CONTINUOUS_MAP_PASTEWISE : thm
  CAUCHY_CONTINUOUS_MAP_PASTED : thm
  CONTINUOUS_MAP_PASTEWISE : thm
  CONTINUOUS_MAP_PASTED : thm
  deriving Inhabited

@[nospecialize]
def setupPCR2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BINT : INT) (BPCR1 : PCR1) :
    ExceptT String IO PCR2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, .. } := D
  let { CROSS_UNIV, ETA_AX, .. } := D.core1
  let { FORALL_PAIR_THM, FORALL_PASTECART, FSTCART_PASTECART, FUN_EQ_THM, IMP_CONJ, .. } :=
    D.core2
  let { IN_UNIV, NOT_IN_EMPTY, PASTECART_FST_SND, PASTECART_IN_PCROSS, PCROSS_MONO, .. } :=
    D.core3
  let { REAL_LE_REFL, .. } := D.core4
  let { REAL_MUL_LID, SNDCART_PASTECART, SUBSET, SUBSET_ANTISYM, SUBSET_PCROSS, SUBSET_TRANS,
        SUBSET_UNIV, .. } := D.core5
  let { UNIV_PCROSS_UNIV, o_DEF, .. } := D.core6
  let { DIST_FSTCART, DIST_SNDCART, .. } := D.vec1
  let { NORM_PASTECART, PASTECART_SUB, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { CAUCHY_CONTINUOUS_MAP_COMPOSE, CAUCHY_CONTINUOUS_MAP_PAIRWISE, CONTINUOUS_MAP_COMPOSE,
        CONTINUOUS_MAP_PAIRED, .. } := D.met1
  let { LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP, LIPSCHITZ_CONTINUOUS_MAP_COMPOSE,
        LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP,
        LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP, MTOPOLOGY_PROD_METRIC, .. } := D.met2
  let { PROD_METRIC, SUBTOPOLOGY_UNIV, UNIFORMLY_CONTINUOUS_MAP_COMPOSE,
        UNIFORMLY_CONTINUOUS_MAP_PAIRWISE, lipschitz_continuous_map, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_IN, .. } := BEUC
  let { INTERIOR_MAXIMAL, INTERIOR_SUBSET, OPEN_INTERIOR, .. } := BINT
  let { OPEN_PCROSS, PASTECART_IN_INTERIOR_SUBTOPOLOGY, .. } := BPCR1
  -- @@SCOPE END

  let INTERIOR_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        interior (s PCROSS t) = (interior s) PCROSS (interior t)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^N"] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"(:real^M)", ← q r"(:real^N)",
           ← q r"interior((s:real^M->bool) PCROSS (t:real^N->bool))",
           ← q r"x:real^M", ← q r"y:real^N"] PASTECART_IN_INTERIOR_SUBTOPOLOGY) THEN
      REWRITE_TAC [UNIV_PCROSS_UNIV, SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN] THEN
      ASM_REWRITE_TAC [OPEN_INTERIOR] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← MESON [INTERIOR_SUBSET, SUBSET_TRANS]
        (← q r"s SUBSET interior t ==> s SUBSET t"))) THEN
      REWRITE_TAC [SUBSET_PCROSS] THEN
      ASM_MESON_TAC [NOT_IN_EMPTY, INTERIOR_MAXIMAL, SUBSET],
      MATCH_MP_TAC INTERIOR_MAXIMAL THEN
      SIMP_TAC [OPEN_PCROSS, OPEN_INTERIOR, PCROSS_MONO, INTERIOR_SUBSET]])

  let LIPSCHITZ_CONTINUOUS_MAP_PASTING ← prove
   r"lipschitz_continuous_map
      (prod_metric euclidean_metric euclidean_metric,euclidean_metric)
      (\(x:real^M,y:real^N). pastecart x y)"
   (REWRITE_TAC [lipschitz_continuous_map, PROD_METRIC, EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [CROSS_UNIV, IN_UNIV, SUBSET_UNIV, FORALL_PAIR_THM] THEN
    EXISTS_TAC (← q r"&1:real") THEN
    SIMP_TAC [dist, PASTECART_SUB, REAL_MUL_LID, NORM_PASTECART, REAL_LE_REFL])

  let LIPSCHITZ_CONTINUOUS_MAP_CART_PROJECTIONS ← prove
   r"lipschitz_continuous_map (euclidean_metric,euclidean_metric)
                            (fstcart:real^(M,N)finite_sum->real^M) /\
   lipschitz_continuous_map(euclidean_metric,euclidean_metric)
                            (sndcart:real^(M,N)finite_sum->real^N)"
   (REWRITE_TAC [lipschitz_continuous_map, EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV, REAL_MUL_LID] THEN
    CONJ_TAC THEN EXISTS_TAC (← q r"&1") THEN
    REWRITE_TAC [REAL_MUL_LID, DIST_FSTCART, DIST_SNDCART])

  let LIPSCHITZ_CONTINUOUS_MAP_PASTEWISE ← prove
   r"!m (f:A->real^(M,N)finite_sum).
        lipschitz_continuous_map(m,euclidean_metric) f <=>
        lipschitz_continuous_map(m,euclidean_metric) (fstcart o f) /\
        lipschitz_continuous_map(m,euclidean_metric) (sndcart o f)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THEN
      MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN
      ASM_MESON_TAC [LIPSCHITZ_CONTINUOUS_MAP_CART_PROJECTIONS],
      REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"(f:A->real^(M,N)finite_sum) =
        (\(x,y). pastecart x y) o (\a. fstcart(f a),sndcart(f a))")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_DEF, PASTECART_FST_SND],
        MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC
         (← q r"prod_metric euclidean_metric euclidean_metric
          :(real^M#real^N)metric") THEN
        REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PASTING] THEN
        ASM_REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, o_DEF]]])

  let LIPSCHITZ_CONTINUOUS_MAP_PASTED ← prove
   r"!m (f:A->real^M) (g:A->real^N).
        lipschitz_continuous_map (m,euclidean_metric)
                                 (\x. pastecart (f x) (g x)) <=>
        lipschitz_continuous_map(m,euclidean_metric) f /\
        lipschitz_continuous_map(m,euclidean_metric) g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PASTEWISE, o_DEF] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, ETA_AX])

  let UNIFORMLY_CONTINUOUS_MAP_PASTEWISE ← prove
   r"!m (f:A->real^(M,N)finite_sum).
        uniformly_continuous_map(m,euclidean_metric) f <=>
        uniformly_continuous_map(m,euclidean_metric) (fstcart o f) /\
        uniformly_continuous_map(m,euclidean_metric) (sndcart o f)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THEN
      MATCH_MP_TAC UNIFORMLY_CONTINUOUS_MAP_COMPOSE THEN
      ASM_MESON_TAC [LIPSCHITZ_CONTINUOUS_MAP_CART_PROJECTIONS,
                     LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP],
      REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"(f:A->real^(M,N)finite_sum) =
        (\(x,y). pastecart x y) o (\a. fstcart(f a),sndcart(f a))")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_DEF, PASTECART_FST_SND],
        MATCH_MP_TAC UNIFORMLY_CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC
         (← q r"prod_metric euclidean_metric euclidean_metric
          :(real^M#real^N)metric") THEN
        SIMP_TAC [LIPSCHITZ_CONTINUOUS_MAP_PASTING,
                  LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP] THEN
        ASM_REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_PAIRWISE, o_DEF]]])

  let UNIFORMLY_CONTINUOUS_MAP_PASTED ← prove
   r"!m (f:A->real^M) (g:A->real^N).
        uniformly_continuous_map (m,euclidean_metric)
                                 (\x. pastecart (f x) (g x)) <=>
        uniformly_continuous_map(m,euclidean_metric) f /\
        uniformly_continuous_map(m,euclidean_metric) g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_PASTEWISE, o_DEF] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, ETA_AX])

  let CAUCHY_CONTINUOUS_MAP_PASTEWISE ← prove
   r"!m (f:A->real^(M,N)finite_sum).
        cauchy_continuous_map(m,euclidean_metric) f <=>
        cauchy_continuous_map(m,euclidean_metric) (fstcart o f) /\
        cauchy_continuous_map(m,euclidean_metric) (sndcart o f)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THEN
      MATCH_MP_TAC CAUCHY_CONTINUOUS_MAP_COMPOSE THEN
      ASM_MESON_TAC [LIPSCHITZ_CONTINUOUS_MAP_CART_PROJECTIONS,
                     LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP],
      REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"(f:A->real^(M,N)finite_sum) =
        (\(x,y). pastecart x y) o (\a. fstcart(f a),sndcart(f a))")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_DEF, PASTECART_FST_SND],
        MATCH_MP_TAC CAUCHY_CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC
         (← q r"prod_metric euclidean_metric euclidean_metric
          :(real^M#real^N)metric") THEN
        SIMP_TAC [LIPSCHITZ_CONTINUOUS_MAP_PASTING,
                  LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP] THEN
        ASM_REWRITE_TAC [CAUCHY_CONTINUOUS_MAP_PAIRWISE, o_DEF]]])

  let CAUCHY_CONTINUOUS_MAP_PASTED ← prove
   r"!m (f:A->real^M) (g:A->real^N).
        cauchy_continuous_map (m,euclidean_metric)
                                 (\x. pastecart (f x) (g x)) <=>
        cauchy_continuous_map(m,euclidean_metric) f /\
        cauchy_continuous_map(m,euclidean_metric) g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CAUCHY_CONTINUOUS_MAP_PASTEWISE, o_DEF] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, ETA_AX])

  let CONTINUOUS_MAP_PASTEWISE ← prove
   r"!top (f:A->real^(M,N)finite_sum).
        continuous_map(top,euclidean) f <=>
        continuous_map(top,euclidean) (fstcart o f) /\
        continuous_map(top,euclidean) (sndcart o f)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_MAP_COMPOSE)) THEN
      REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
      MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP THEN
      REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_CART_PROJECTIONS],
      REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"(f:A->real^(M,N)finite_sum) =
        (\(x,y). pastecart x y) o (\a. fstcart(f a),sndcart(f a))")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_DEF, PASTECART_FST_SND],
        MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC
         (← q r"prod_topology euclidean euclidean :(real^M#real^N)topology") THEN
        ASM_REWRITE_TAC [CONTINUOUS_MAP_PAIRED] THEN
        REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC,
                     ← GSYM MTOPOLOGY_PROD_METRIC] THEN
        MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP THEN
        REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PASTING]]])

  let CONTINUOUS_MAP_PASTED ← prove
   r"!top (f:A->real^M) (g:A->real^N).
        continuous_map (top,euclidean) (\x. pastecart (f x) (g x)) <=>
        continuous_map(top,euclidean) f /\
        continuous_map(top,euclidean) g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONTINUOUS_MAP_PASTEWISE, o_DEF] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, ETA_AX])

  return { INTERIOR_PCROSS, LIPSCHITZ_CONTINUOUS_MAP_PASTING,
           LIPSCHITZ_CONTINUOUS_MAP_CART_PROJECTIONS, LIPSCHITZ_CONTINUOUS_MAP_PASTEWISE,
           LIPSCHITZ_CONTINUOUS_MAP_PASTED, UNIFORMLY_CONTINUOUS_MAP_PASTEWISE,
           UNIFORMLY_CONTINUOUS_MAP_PASTED, CAUCHY_CONTINUOUS_MAP_PASTEWISE,
           CAUCHY_CONTINUOUS_MAP_PASTED, CONTINUOUS_MAP_PASTEWISE, CONTINUOUS_MAP_PASTED }

/- ------------------------------------------------------------------------- -/
/- Quotient maps are occasionally useful, part 1.  (topology.ml 8391-8568)   -/
/- ------------------------------------------------------------------------- -/

structure QUO1 where
  QUASICOMPACT_OPEN_CLOSED : thm
  QUOTIENT_MAP_IMP_CONTINUOUS_OPEN : thm
  QUOTIENT_MAP_IMP_CONTINUOUS_CLOSED : thm
  OPEN_MAP_IMP_QUOTIENT_MAP : thm
  CLOSED_MAP_IMP_QUOTIENT_MAP : thm
  CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP : thm
  CONTINUOUS_LEFT_INVERSE_IMP_QUOTIENT_MAP : thm
  QUOTIENT_MAP_OPEN_CLOSED : thm
  CONTINUOUS_ON_COMPOSE_QUOTIENT : thm
  LIFT_TO_QUOTIENT_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupQUO1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLOC : LOC) (BCSL : CSL) (BIDC : IDC)
    (BCLC : CLC) : ExceptT String IO QUO1 := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EQ_IMP, .. } := D.core1
  let { FUNCTION_FACTORS_LEFT_GEN, IMAGE_o, IMP_CONJ_ALT, .. } := D.core2
  let { MONO_EXISTS, .. } := D.core3
  let { SUBSET_REFL, SUBSET_RESTRICT, SUBSET_UNIV, .. } := D.core5
  let { o_THM, .. } := D.core6
  let { CLOSED_IN_DIFF, CLOSED_IN_IMP_SUBSET, CLOSED_IN_SUBTOPOLOGY_REFL, .. } := D.met1
  let { OPEN_IN_IMP_SUBSET, closed_in, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { OPEN_IN_OPEN, .. } := BLOC
  let { CONTINUOUS_ON_EQ, .. } := BCSL
  let { CONTINUOUS_ON_OPEN, CONTINUOUS_ON_OPEN_GEN, .. } := BIDC
  let { CONTINUOUS_ON_CLOSED_GEN, .. } := BCLC
  -- @@SCOPE END

  let QUASICOMPACT_OPEN_CLOSED ← prove
   r"!f:real^M->real^N s t.
    IMAGE f s SUBSET t
    ==> ((!u. u SUBSET t
              ==> (open_in (subtopology euclidean s)
                           {x | x IN s /\ f x IN u}
                   ==> open_in (subtopology euclidean t) u)) <=>
         (!u. u SUBSET t
              ==> (closed_in (subtopology euclidean s)
                             {x | x IN s /\ f x IN u}
                   ==> closed_in (subtopology euclidean t) u)))"
   (SIMP_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t DIFF u:real^N->bool")) THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"u SUBSET t ==> t DIFF (t DIFF u) = u")] THEN
    (ANTS_TAC THENL [SET_TAC [], REPEAT STRIP_TAC]) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [SUBSET_RESTRICT] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
     (← q r"open_in top x ==> x = y ==> open_in top y"))) THEN
    ASM SET_TAC [])

  let QUOTIENT_MAP_IMP_CONTINUOUS_OPEN ← prove
   r"!f:real^M->real^N s t.
     IMAGE f s SUBSET t /\
     (!u. u SUBSET t
          ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
               open_in (subtopology euclidean t) u))
     ==> f continuous_on s"
   (MESON_TAC [OPEN_IN_IMP_SUBSET, CONTINUOUS_ON_OPEN_GEN])

  let QUOTIENT_MAP_IMP_CONTINUOUS_CLOSED ← prove
   r"!f:real^M->real^N s t.
     IMAGE f s SUBSET t /\
     (!u. u SUBSET t
          ==> (closed_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
               closed_in (subtopology euclidean t) u))
     ==> f continuous_on s"
   (MESON_TAC [CLOSED_IN_IMP_SUBSET, CONTINUOUS_ON_CLOSED_GEN])

  let OPEN_MAP_IMP_QUOTIENT_MAP ← prove
   r"!f:real^M->real^N s.
    f continuous_on s /\
    (!t. open_in (subtopology euclidean s) t
         ==> open_in (subtopology euclidean (IMAGE f s)) (IMAGE f t))
    ==> !t. t SUBSET IMAGE f s
            ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN t} <=>
                 open_in (subtopology euclidean (IMAGE f s)) t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN
       (← q r"t = IMAGE f {x | x IN s /\ (f:real^M->real^N) x IN t}")
      SUBST1_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC []],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONTINUOUS_ON_OPEN]) THEN
      ASM_SIMP_TAC []])

  let CLOSED_MAP_IMP_QUOTIENT_MAP ← prove
   r"!f:real^M->real^N s.
    f continuous_on s /\
    (!t. closed_in (subtopology euclidean s) t
         ==> closed_in (subtopology euclidean (IMAGE f s)) (IMAGE f t))
    ==> !t. t SUBSET IMAGE f s
            ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN t} <=>
                 open_in (subtopology euclidean (IMAGE f s)) t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"s DIFF {x | x IN s /\ (f:real^M->real^N) x IN t}")) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_DIFF THEN
        ASM_SIMP_TAC [CLOSED_IN_SUBTOPOLOGY_REFL,
                      TOPSPACE_EUCLIDEAN, SUBSET_UNIV],
        REWRITE_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        DISCH_THEN (MP_TAC o CONJUNCT2) THEN MATCH_MP_TAC EQ_IMP THEN
        AP_TERM_TAC THEN ASM SET_TAC []],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONTINUOUS_ON_OPEN]) THEN
      ASM_SIMP_TAC []])

  let CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET s /\
        (!y. y IN t ==> f(g y) = y)
        ==> (!u. u SUBSET t
            ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
                 open_in (subtopology euclidean t) u))"
   (REWRITE_TAC [CONTINUOUS_ON_OPEN] THEN REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN FIRST_ASSUM (MP_TAC o SPEC (← q r"(IMAGE (g:real^N->real^M) t)
         INTER
         {x | x IN s /\ (f:real^M->real^N) x IN u}")) THEN
      ANTS_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
        REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN
        ASM SET_TAC [],
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC []],
      DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      SUBGOAL_THEN (← q r"IMAGE (f:real^M->real^N) s = t")
       (fun th => ASM_REWRITE_TAC [th]) THEN
      ASM SET_TAC []])

  let CONTINUOUS_LEFT_INVERSE_IMP_QUOTIENT_MAP ← prove
   r"!f:real^M->real^N g s.
        f continuous_on s /\ g continuous_on (IMAGE f s) /\
        (!x. x IN s ==> g(f x) = x)
        ==> (!u. u SUBSET (IMAGE f s)
            ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
                 open_in (subtopology euclidean (IMAGE f s)) u))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP THEN
    EXISTS_TAC (← q r"g:real^N->real^M") THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let QUOTIENT_MAP_OPEN_CLOSED ← prove
   r"!f:real^M->real^N s t.
    IMAGE f s SUBSET t
    ==> ((!u. u SUBSET t
              ==> (open_in (subtopology euclidean s)
                           {x | x IN s /\ f x IN u} <=>
                   open_in (subtopology euclidean t) u)) <=>
         (!u. u SUBSET t
              ==> (closed_in (subtopology euclidean s)
                             {x | x IN s /\ f x IN u} <=>
                   closed_in (subtopology euclidean t) u)))"
   (SIMP_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t DIFF u:real^N->bool")) THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"u SUBSET t ==> t DIFF (t DIFF u) = u")] THEN
    (ANTS_TAC THENL [SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)]) THEN
    REWRITE_TAC [SUBSET_RESTRICT] THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let CONTINUOUS_ON_COMPOSE_QUOTIENT ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
      IMAGE f s SUBSET t /\ IMAGE g t SUBSET u /\
      (!v. v SUBSET t
           ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN v} <=>
                open_in (subtopology euclidean t) v)) /\
      (g o f) continuous_on s
      ==> g continuous_on t"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 3 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP CONTINUOUS_ON_OPEN_GEN th])) THEN
    SUBGOAL_THEN
     (← q r"IMAGE ((g:real^N->real^P) o (f:real^M->real^N)) s SUBSET u")
     (fun th => tactic_of do
       pure (REWRITE_TAC [← MATCH_MP CONTINUOUS_ON_OPEN_GEN th]))
    THENL [REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [], DISCH_TAC] THEN
    X_GEN_TAC (← q r"v:real^P->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^P->bool")) THEN
    ASM_REWRITE_TAC [o_THM] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{x | x IN t /\ (g:real^N->real^P) x IN v}")) THEN
    ASM_REWRITE_TAC [SUBSET_RESTRICT] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
     (← q r"open_in top s ==> s = t ==> open_in top t"))) THEN
    ASM SET_TAC [])

  let LIFT_TO_QUOTIENT_SPACE ← prove
   r"!f:real^M->real^N h:real^M->real^P s t u.
        IMAGE f s = t /\
        (!v. v SUBSET t
           ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN v} <=>
                open_in (subtopology euclidean t) v)) /\
        h continuous_on s /\ IMAGE h s = u /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> h x = h y)
        ==> ?g. g continuous_on t /\ IMAGE g t = u /\
                !x. x IN s ==> h(x) = g(f x)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [FUNCTION_FACTORS_LEFT_GEN] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^P") THEN
    DISCH_TAC THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE_QUOTIENT THEN MAP_EVERY EXISTS_TAC
     [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"u:real^P->bool"] THEN
    ASM_SIMP_TAC [SUBSET_REFL] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
      CONTINUOUS_ON_EQ)) THEN
    ASM_REWRITE_TAC [o_THM])

  return { QUASICOMPACT_OPEN_CLOSED, QUOTIENT_MAP_IMP_CONTINUOUS_OPEN,
           QUOTIENT_MAP_IMP_CONTINUOUS_CLOSED, OPEN_MAP_IMP_QUOTIENT_MAP,
           CLOSED_MAP_IMP_QUOTIENT_MAP, CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP,
           CONTINUOUS_LEFT_INVERSE_IMP_QUOTIENT_MAP, QUOTIENT_MAP_OPEN_CLOSED,
           CONTINUOUS_ON_COMPOSE_QUOTIENT, LIFT_TO_QUOTIENT_SPACE }

/- ------------------------------------------------------------------------- -/
/- Quotient maps are occasionally useful, part 2.  (topology.ml 8569-8705)   -/
/- ------------------------------------------------------------------------- -/

structure QUO2 where
  QUOTIENT_MAP_COMPOSE_EXPLICIT : thm
  QUOTIENT_MAP_FROM_COMPOSITION_EXPLICIT : thm
  QUOTIENT_MAP_FROM_SUBSET : thm
  QUOTIENT_MAP_RESTRICT : thm
  CONNECTED_MONOTONE_QUOTIENT_PREIMAGE_GEN : thm
  CONNECTED_MONOTONE_QUOTIENT_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupQUO2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCON : CON) (BIDC : IDC) (BCLC : CLC)
    (BQUO1 : QUO1) : ExceptT String IO QUO2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, .. } := D
  let { EQ_IMP, .. } := D.core1
  let { IMAGE_ID, IMP_CONJ_ALT, IN_ELIM_THM, .. } := D.core2
  let { MONO_FORALL, .. } := D.core3
  let { SUBSET_REFL, SUBSET_RESTRICT, .. } := D.core5
  let { o_THM, .. } := D.core6
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_SUBSET_TRANS, CLOSED_IN_TRANS,
        CONNECTED_IN_MONOTONE_QUOTIENT_MAP_PREIMAGE, CONNECTED_IN_SUBTOPOLOGY, .. } := D.met1
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_SUBSET_TRANS, OPEN_IN_TRANS, monotone_map, quotient_map,
        .. } := D.met3
  let { OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CONNECTED_IN_EUCLIDEAN, .. } := BCON
  let { CONTINUOUS_ON_ID, CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := BIDC
  let { CONTINUOUS_CLOSED_IN_PREIMAGE_GEN, .. } := BCLC
  let { QUOTIENT_MAP_IMP_CONTINUOUS_OPEN, QUOTIENT_MAP_OPEN_CLOSED, .. } := BQUO1
  -- @@SCOPE END

  let QUOTIENT_MAP_COMPOSE_EXPLICIT ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        IMAGE f s SUBSET t /\
        (!v. v SUBSET t
           ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN v} <=>
                open_in (subtopology euclidean t) v)) /\
        (!v. v SUBSET u
           ==> (open_in (subtopology euclidean t) {x | x IN t /\ g x IN v} <=>
                open_in (subtopology euclidean u) v))
        ==> !v. v SUBSET u
                ==> (open_in (subtopology euclidean s)
                             {x | x IN s /\ (g o f) x IN v} <=>
                     open_in (subtopology euclidean u) v)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [o_THM] THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ (g:real^N->real^P) ((f:real^M->real^N) x) IN v} =
      {x | x IN s /\ f x IN {x | x IN t /\ g x IN v}}")
    SUBST1_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC [SUBSET_RESTRICT]])

  let QUOTIENT_MAP_FROM_COMPOSITION_EXPLICIT ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET u /\
        (!v. v SUBSET u
             ==> (open_in (subtopology euclidean s)
                          {x | x IN s /\ (g o f) x IN v} <=>
                  open_in (subtopology euclidean u) v))
        ==> !v. v SUBSET u
                ==> (open_in (subtopology euclidean t)
                              {x | x IN t /\ g x IN v} <=>
                     open_in (subtopology euclidean u) v)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^P->bool")) THEN
      ASM_REWRITE_TAC [o_THM] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      SUBGOAL_THEN
       (← q r"{x | x IN s /\ (g:real^N->real^P) ((f:real^M->real^N) x) IN v} =
        {x | x IN s /\ f x IN {x | x IN t /\ g x IN v}}")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"u:real^P->bool") THEN ASM_REWRITE_TAC []])

  let QUOTIENT_MAP_FROM_SUBSET ← prove
   r"!f:real^M->real^N s t u.
        f continuous_on t /\ IMAGE f t SUBSET u /\
        s SUBSET t /\ IMAGE f s = u /\
        (!v. v SUBSET u
             ==> (open_in (subtopology euclidean s)
                          {x | x IN s /\ f x IN v} <=>
                  open_in (subtopology euclidean u) v))
        ==> !v. v SUBSET u
                ==> (open_in (subtopology euclidean t)
                             {x | x IN t /\ f x IN v} <=>
                     open_in (subtopology euclidean u) v)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC QUOTIENT_MAP_FROM_COMPOSITION_EXPLICIT THEN
    MAP_EVERY EXISTS_TAC [← q r"\x:real^M. x", ← q r"s:real^M->bool"] THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_ID, IMAGE_ID, o_THM])

  let QUOTIENT_MAP_RESTRICT ← prove
   r"!f:real^M->real^N s t c.
     IMAGE f s SUBSET t /\
     (!u. u SUBSET t
        ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
             open_in (subtopology euclidean t) u)) /\
     (open_in (subtopology euclidean t) c \/
      closed_in (subtopology euclidean t) c)
     ==> !u. u SUBSET c
             ==> (open_in (subtopology euclidean {x | x IN s /\ f x IN c})
                          {x | x IN {x | x IN s /\ f x IN c} /\ f x IN u} <=>
                  open_in (subtopology euclidean c) u)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC th THEN MP_TAC (← MATCH_MP
       (← REWRITE_RULE [IMP_CONJ_ALT] QUOTIENT_MAP_IMP_CONTINUOUS_OPEN) th))) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:real^M->real^N) {x | x IN s /\ f x IN c} SUBSET c")
    ASSUME_TAC THENL [SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM DISJ_CASES_TAC THENL
     [FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET),
      ASM_SIMP_TAC [QUOTIENT_MAP_OPEN_CLOSED] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET)] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    (ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    (MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
      [MATCH_MP_TAC (← MESON [] (← q r"t = s /\ (P s <=> Q s) ==> (P s <=> Q t)")) THEN
       CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_ELIM_THM]],
       ALL_TAC]) THEN
    (EQ_TAC THENL
      [MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] OPEN_IN_SUBSET_TRANS) ORELSE
       MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] CLOSED_IN_SUBSET_TRANS),
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] OPEN_IN_TRANS) ORELSE
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CLOSED_IN_TRANS)]) THEN
    (MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN ORELSE
     MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_GEN ORELSE ASM_SIMP_TAC []) THEN
    ASM SET_TAC [])

  let CONNECTED_MONOTONE_QUOTIENT_PREIMAGE_GEN ← prove
   r"!f:real^M->real^N s t c.
      IMAGE f s = t /\
      (!u. u SUBSET t
           ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
                open_in (subtopology euclidean t) u)) /\
      (!y. y IN t ==> connected {x | x IN s /\ f x = y}) /\
      (open_in (subtopology euclidean t) c \/
       closed_in (subtopology euclidean t) c) /\
      connected c
      ==> connected {x | x IN s /\ f x IN c}"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN MP_TAC (← ISPECL
     [← q r"subtopology euclidean (s:real^M->bool)",
      ← q r"subtopology euclidean (t:real^N->bool)",
      ← q r"f:real^M->real^N", ← q r"c:real^N->bool"]
      CONNECTED_IN_MONOTONE_QUOTIENT_MAP_PREIMAGE) THEN
    ASM_REWRITE_TAC [monotone_map, quotient_map, CONNECTED_IN_SUBTOPOLOGY,
                     CONNECTED_IN_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                     SUBSET_RESTRICT, SUBSET_REFL] THEN
    ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, CLOSED_IN_IMP_SUBSET])

  let CONNECTED_MONOTONE_QUOTIENT_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
      f continuous_on s /\ IMAGE f s = t /\
      (!u. u SUBSET t
           ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
                open_in (subtopology euclidean t) u)) /\
      (!y. y IN t ==> connected {x | x IN s /\ f x = y}) /\
      connected t
      ==> connected s"
   (MP_TAC CONNECTED_MONOTONE_QUOTIENT_PREIMAGE_GEN THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (STRIP_TAC THEN MP_TAC (← SPEC (← q r"t:real^N->bool") th))) THEN
    ASM_REWRITE_TAC [OPEN_IN_REFL] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    ASM SET_TAC [])

  return { QUOTIENT_MAP_COMPOSE_EXPLICIT, QUOTIENT_MAP_FROM_COMPOSITION_EXPLICIT,
           QUOTIENT_MAP_FROM_SUBSET, QUOTIENT_MAP_RESTRICT,
           CONNECTED_MONOTONE_QUOTIENT_PREIMAGE_GEN, CONNECTED_MONOTONE_QUOTIENT_PREIMAGE }

/- ------------------------------------------------------------------------- -/
/- More properties of open and closed maps, part 1.  (topology.ml 8706-8901) -/
/- ------------------------------------------------------------------------- -/

structure OCM1 where
  CLOSED_MAP_CLOSURES : thm
  OPEN_MAP_INTERIORS : thm
  OPEN_MAP_RESTRICT : thm
  CLOSED_MAP_RESTRICT : thm
  QUOTIENT_MAP_OPEN_MAP_EQ : thm
  QUOTIENT_MAP_CLOSED_MAP_EQ : thm
  CLOSED_MAP_IMP_OPEN_MAP : thm
  OPEN_MAP_IMP_CLOSED_MAP : thm
  OPEN_MAP_IFF_CLOSED_MAP_BIJECTIVE : thm
  OPEN_MAP_FROM_COMPOSITION_SURJECTIVE : thm
  CLOSED_MAP_FROM_COMPOSITION_SURJECTIVE : thm
  OPEN_MAP_FROM_COMPOSITION_INJECTIVE : thm
  deriving Inhabited

@[nospecialize]
def setupOCM1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BINT : INT)
    (BCLS1 : CLS1) (BIDC : IDC) (BCLC : CLC) (BQUO1 : QUO1) : ExceptT String IO OCM1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EQ_IMP, .. } := D.core1
  let { FORALL_UNWIND_THM2, IMAGE_SUBSET, IMAGE_o, IMP_CONJ, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET_REFL, .. } := D.core5
  let { SWAP_FORALL_THM, .. } := D.core6
  let { CLOSED_IN_DIFF, CLOSED_IN_IMP_SUBSET, .. } := D.met1
  let { OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, closed_in, .. } := D.met3
  let { OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_IN_REFL, .. } := BCLO
  let { CLOSED_IN_CLOSED, OPEN_IN_OPEN, .. } := BLOC
  let { INTERIOR_MAXIMAL, INTERIOR_OPEN, INTERIOR_SUBSET, OPEN_INTERIOR, SUBSET_INTERIOR_EQ, .. } :=
    BINT
  let { CLOSED_CLOSURE, CLOSURE_CLOSED, CLOSURE_MINIMAL, CLOSURE_SUBSET, CLOSURE_SUBSET_EQ, .. } :=
    BCLS1
  let { CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := BIDC
  let { CONTINUOUS_CLOSED_IN_PREIMAGE_GEN, .. } := BCLC
  let { QUOTIENT_MAP_OPEN_CLOSED, .. } := BQUO1
  -- @@SCOPE END

  let CLOSED_MAP_CLOSURES ← prove
   r"!f:real^M->real^N.
        (!s. closed s ==> closed(IMAGE f s)) <=>
        (!s. closure(IMAGE f s) SUBSET IMAGE f (closure s))"
   (GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC CLOSURE_MINIMAL THEN
      ASM_SIMP_TAC [CLOSED_CLOSURE, CLOSURE_SUBSET, IMAGE_SUBSET],
      REWRITE_TAC [← GSYM CLOSURE_SUBSET_EQ] THEN ASM_MESON_TAC [CLOSURE_CLOSED]])

  let OPEN_MAP_INTERIORS ← prove
   r"!f:real^M->real^N.
        (!s. open s ==> open(IMAGE f s)) <=>
        (!s. IMAGE f (interior s) SUBSET interior(IMAGE f s))"
   (GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC INTERIOR_MAXIMAL THEN
      ASM_SIMP_TAC [OPEN_INTERIOR, INTERIOR_SUBSET, IMAGE_SUBSET],
      REWRITE_TAC [← GSYM SUBSET_INTERIOR_EQ] THEN ASM_MESON_TAC [INTERIOR_OPEN]])

  let OPEN_MAP_RESTRICT ← prove
   r"!f:real^M->real^N s t t'.
        (!u. open_in (subtopology euclidean s) u
             ==> open_in (subtopology euclidean t) (IMAGE f u)) /\
        t' SUBSET t
        ==> !u. open_in (subtopology euclidean {x | x IN s /\ f x IN t'}) u
                ==> open_in (subtopology euclidean t') (IMAGE f u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_OPEN] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q r"c:real^M->bool") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  let CLOSED_MAP_RESTRICT ← prove
   r"!f:real^M->real^N s t t'.
        (!u. closed_in (subtopology euclidean s) u
             ==> closed_in (subtopology euclidean t) (IMAGE f u)) /\
        t' SUBSET t
        ==> !u. closed_in (subtopology euclidean {x | x IN s /\ f x IN t'}) u
                ==> closed_in (subtopology euclidean t') (IMAGE f u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN_CLOSED] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q r"c:real^M->bool") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  let QUOTIENT_MAP_OPEN_MAP_EQ ← prove
   r"!f:real^M->real^N s t.
       IMAGE f s SUBSET t /\
       (!u. u SUBSET t
            ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
                 open_in (subtopology euclidean t) u))
       ==> ((!k. open_in (subtopology euclidean s) k
                 ==> open_in (subtopology euclidean t) (IMAGE f k)) <=>
            (!k. open_in (subtopology euclidean s) k
                 ==> open_in (subtopology euclidean s)
                               {x | x IN s /\ f x IN IMAGE f k}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"k:real^M->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (f:real^M->real^N) k")) THEN
    ASM_SIMP_TAC [IMAGE_SUBSET] THEN DISCH_THEN MATCH_MP_TAC THEN ASM SET_TAC [])

  let QUOTIENT_MAP_CLOSED_MAP_EQ ← prove
   r"!f:real^M->real^N s t.
       IMAGE f s SUBSET t /\
       (!u. u SUBSET t
            ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
                 open_in (subtopology euclidean t) u))
       ==> ((!k. closed_in (subtopology euclidean s) k
                 ==> closed_in (subtopology euclidean t) (IMAGE f k)) <=>
            (!k. closed_in (subtopology euclidean s) k
                 ==> closed_in (subtopology euclidean s)
                               {x | x IN s /\ f x IN IMAGE f k}))"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [QUOTIENT_MAP_OPEN_CLOSED] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"k:real^M->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (f:real^M->real^N) k")) THEN
    ASM_SIMP_TAC [IMAGE_SUBSET] THEN DISCH_THEN MATCH_MP_TAC THEN ASM SET_TAC [])

  let CLOSED_MAP_IMP_OPEN_MAP ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s = t /\
        (!u. closed_in (subtopology euclidean s) u
                ==> closed_in (subtopology euclidean t) (IMAGE f u)) /\
        (!u. open_in (subtopology euclidean s) u
             ==> open_in (subtopology euclidean s)
                         {x | x IN s /\ f x IN IMAGE f u})
        ==> (!u. open_in (subtopology euclidean s) u
                 ==> open_in (subtopology euclidean t) (IMAGE f u))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"IMAGE (f:real^M->real^N) u =
       t DIFF IMAGE f (s DIFF {x | x IN s /\ f x IN IMAGE f u})")
    SUBST1_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN ASM SET_TAC [],
      MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC CLOSED_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
      ASM_SIMP_TAC [CLOSED_IN_REFL]])

  let OPEN_MAP_IMP_CLOSED_MAP ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s = t /\
        (!u. open_in (subtopology euclidean s) u
                ==> open_in (subtopology euclidean t) (IMAGE f u)) /\
        (!u. closed_in (subtopology euclidean s) u
             ==> closed_in (subtopology euclidean s)
                         {x | x IN s /\ f x IN IMAGE f u})
        ==> (!u. closed_in (subtopology euclidean s) u
                 ==> closed_in (subtopology euclidean t) (IMAGE f u))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"IMAGE (f:real^M->real^N) u =
       t DIFF IMAGE f (s DIFF {x | x IN s /\ f x IN IMAGE f u})")
    SUBST1_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_DIFF THEN REWRITE_TAC [CLOSED_IN_REFL] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [CLOSED_IN_REFL] THEN
      ASM_SIMP_TAC [OPEN_IN_REFL]])

  let OPEN_MAP_IFF_CLOSED_MAP_BIJECTIVE ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s = t /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> ((!u. open_in (subtopology euclidean s) u
                  ==> open_in (subtopology euclidean t) (IMAGE f u)) <=>
             (!c. closed_in (subtopology euclidean s) c
                  ==> closed_in (subtopology euclidean t) (IMAGE f c)))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"c:real^M->bool") THEN
    ONCE_REWRITE_TAC [closed_in, OPEN_IN_CLOSED_IN_EQ] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN STRIP_TAC THEN
    (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s DIFF c:real^M->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    ASM SET_TAC [])

  let OPEN_MAP_FROM_COMPOSITION_SURJECTIVE ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        f continuous_on s /\ IMAGE f s = t /\ IMAGE g t SUBSET u /\
        (!k. open_in (subtopology euclidean s) k
             ==> open_in (subtopology euclidean u) (IMAGE (g o f) k))
        ==> (!k. open_in (subtopology euclidean t) k
                 ==> open_in (subtopology euclidean u) (IMAGE g k))"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"IMAGE g k = IMAGE ((g:real^N->real^P) o (f:real^M->real^N))
                        {x | x IN s /\ f(x) IN k}")
    SUBST1_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL]])

  let CLOSED_MAP_FROM_COMPOSITION_SURJECTIVE ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        f continuous_on s /\ IMAGE f s = t /\ IMAGE g t SUBSET u /\
        (!k. closed_in (subtopology euclidean s) k
             ==> closed_in (subtopology euclidean u) (IMAGE (g o f) k))
        ==> (!k. closed_in (subtopology euclidean t) k
                 ==> closed_in (subtopology euclidean u) (IMAGE g k))"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"IMAGE g k = IMAGE ((g:real^N->real^P) o (f:real^M->real^N))
                        {x | x IN s /\ f(x) IN k}")
    SUBST1_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL]])

  let OPEN_MAP_FROM_COMPOSITION_INJECTIVE ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        IMAGE f s SUBSET t /\ IMAGE g t SUBSET u /\
        g continuous_on t /\ (!x y. x IN t /\ y IN t /\ g x = g y ==> x = y) /\
        (!k. open_in (subtopology euclidean s) k
             ==> open_in (subtopology euclidean u) (IMAGE (g o f) k))
        ==> (!k. open_in (subtopology euclidean s) k
                 ==> open_in (subtopology euclidean t) (IMAGE f k))"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"IMAGE f k = {x | x IN t /\
                      g(x) IN IMAGE ((g:real^N->real^P) o (f:real^M->real^N)) k}")
    SUBST1_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"u:real^P->bool") THEN ASM_SIMP_TAC []])

  return { CLOSED_MAP_CLOSURES, OPEN_MAP_INTERIORS, OPEN_MAP_RESTRICT, CLOSED_MAP_RESTRICT,
           QUOTIENT_MAP_OPEN_MAP_EQ, QUOTIENT_MAP_CLOSED_MAP_EQ, CLOSED_MAP_IMP_OPEN_MAP,
           OPEN_MAP_IMP_CLOSED_MAP, OPEN_MAP_IFF_CLOSED_MAP_BIJECTIVE,
           OPEN_MAP_FROM_COMPOSITION_SURJECTIVE, CLOSED_MAP_FROM_COMPOSITION_SURJECTIVE,
           OPEN_MAP_FROM_COMPOSITION_INJECTIVE }

/- ------------------------------------------------------------------------- -/
/- More properties of open and closed maps, part 2.  (topology.ml 8902-9014) -/
/- ------------------------------------------------------------------------- -/

structure OCM2 where
  CLOSED_MAP_FROM_COMPOSITION_INJECTIVE : thm
  OPEN_MAP_CLOSED_SUPERSET_PREIMAGE : thm
  OPEN_MAP_CLOSED_SUPERSET_PREIMAGE_EQ : thm
  CLOSED_MAP_OPEN_SUPERSET_PREIMAGE : thm
  CLOSED_MAP_OPEN_SUPERSET_PREIMAGE_EQ : thm
  CLOSED_MAP_OPEN_SUPERSET_PREIMAGE_POINT : thm
  CONNECTED_OPEN_MONOTONE_PREIMAGE : thm
  CONNECTED_CLOSED_MONOTONE_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupOCM2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCON : CON) (BCNO : CNO)
    (BCLC : CLC) : ExceptT String IO OCM2 := do
  -- @@SCOPE BEGIN
  let { SET_TAC, .. } := D
  let { IMAGE_o, .. } := D.core2
  let { SUBSET_REFL, SUBSET_RESTRICT, .. } := D.core5
  let { CLOSED_IN_IMP_SUBSET, CLOSED_MAP_FIBRE_NEIGHBOURHOOD, CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD,
        CONNECTED_IN_SUBTOPOLOGY, .. } := D.met1
  let { MONOTONE_CLOSED_MAP, MONOTONE_OPEN_MAP, .. } := D.met2
  let { OPEN_MAP_PREIMAGE_NEIGHBOURHOOD, closed_map, monotone_map, open_map, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CONNECTED_IN_EUCLIDEAN, .. } := BCON
  let { CONTINUOUS_MAP_EUCLIDEAN2, .. } := BCNO
  let { CONTINUOUS_CLOSED_IN_PREIMAGE_GEN, .. } := BCLC
  -- @@SCOPE END

  let CLOSED_MAP_FROM_COMPOSITION_INJECTIVE ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        IMAGE f s SUBSET t /\ IMAGE g t SUBSET u /\
        g continuous_on t /\ (!x y. x IN t /\ y IN t /\ g x = g y ==> x = y) /\
        (!k. closed_in (subtopology euclidean s) k
             ==> closed_in (subtopology euclidean u) (IMAGE (g o f) k))
        ==> (!k. closed_in (subtopology euclidean s) k
                 ==> closed_in (subtopology euclidean t) (IMAGE f k))"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"IMAGE f k = {x | x IN t /\
                      g(x) IN IMAGE ((g:real^N->real^P) o (f:real^M->real^N)) k}")
    SUBST1_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"u:real^P->bool") THEN ASM_SIMP_TAC []])

  let OPEN_MAP_CLOSED_SUPERSET_PREIMAGE ← prove
   r"!f:real^M->real^N s t u w.
        (!k. open_in (subtopology euclidean s) k
             ==> open_in (subtopology euclidean t) (IMAGE f k)) /\
        closed_in (subtopology euclidean s) u /\
        w SUBSET t /\ {x | x IN s /\ f(x) IN w} SUBSET u
        ==> ?v. closed_in (subtopology euclidean t) v /\
                w SUBSET v /\
                {x | x IN s /\ f(x) IN v} SUBSET u"
   (REWRITE_TAC [← GSYM open_map, OPEN_MAP_PREIMAGE_NEIGHBOURHOOD] THEN
    SIMP_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let OPEN_MAP_CLOSED_SUPERSET_PREIMAGE_EQ ← prove
   r"!f:real^M->real^N s t.
       IMAGE f s SUBSET t
       ==> ((!k. open_in (subtopology euclidean s) k
                 ==> open_in (subtopology euclidean t) (IMAGE f k)) <=>
            (!u w. closed_in (subtopology euclidean s) u /\
                   w SUBSET t /\ {x | x IN s /\ f(x) IN w} SUBSET u
                   ==> ?v. closed_in (subtopology euclidean t) v /\
                           w SUBSET v /\ {x | x IN s /\ f(x) IN v} SUBSET u))"
   (REWRITE_TAC [← GSYM open_map, OPEN_MAP_PREIMAGE_NEIGHBOURHOOD] THEN
    SIMP_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CLOSED_MAP_OPEN_SUPERSET_PREIMAGE ← prove
   r"!f:real^M->real^N s t u w.
        (!k. closed_in (subtopology euclidean s) k
             ==> closed_in (subtopology euclidean t) (IMAGE f k)) /\
        open_in (subtopology euclidean s) u /\
        w SUBSET t /\ {x | x IN s /\ f(x) IN w} SUBSET u
        ==> ?v. open_in (subtopology euclidean t) v /\
                w SUBSET v /\
                {x | x IN s /\ f(x) IN v} SUBSET u"
   (REWRITE_TAC [← GSYM closed_map, CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD] THEN
    SIMP_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CLOSED_MAP_OPEN_SUPERSET_PREIMAGE_EQ ← prove
   r"!f:real^M->real^N s t.
       IMAGE f s SUBSET t
       ==> ((!k. closed_in (subtopology euclidean s) k
                 ==> closed_in (subtopology euclidean t) (IMAGE f k)) <=>
            (!u w. open_in (subtopology euclidean s) u /\
                   w SUBSET t /\ {x | x IN s /\ f(x) IN w} SUBSET u
                   ==> ?v. open_in (subtopology euclidean t) v /\
                           w SUBSET v /\ {x | x IN s /\ f(x) IN v} SUBSET u))"
   (REWRITE_TAC [← GSYM closed_map, CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD] THEN
    SIMP_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CLOSED_MAP_OPEN_SUPERSET_PREIMAGE_POINT ← prove
   r"!f:real^M->real^N s t.
       IMAGE f s SUBSET t
       ==> ((!k. closed_in (subtopology euclidean s) k
                 ==> closed_in (subtopology euclidean t) (IMAGE f k)) <=>
            (!u y. open_in (subtopology euclidean s) u /\
                   y IN t /\ {x | x IN s /\ f(x) = y} SUBSET u
                   ==> ?v. open_in (subtopology euclidean t) v /\
                           y IN v /\ {x | x IN s /\ f(x) IN v} SUBSET u))"
   (REWRITE_TAC [← GSYM closed_map, CLOSED_MAP_FIBRE_NEIGHBOURHOOD] THEN
    SIMP_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CONNECTED_OPEN_MONOTONE_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s = t /\
        (!c. open_in (subtopology euclidean s) c
             ==> open_in (subtopology euclidean t) (IMAGE f c)) /\
        (!y. y IN t ==> connected {x | x IN s /\ f x = y})
        ==> !c. connected c /\ c SUBSET t
                ==> connected {x | x IN s /\ f x IN c}"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"subtopology euclidean (s:real^M->bool)",
      ← q r"subtopology euclidean (t:real^N->bool)", ← q r"f:real^M->real^N"]
     MONOTONE_OPEN_MAP) THEN
    ASM_REWRITE_TAC [open_map, monotone_map, CONTINUOUS_MAP_EUCLIDEAN2,
      CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_EUCLIDEAN,
      TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_REFL, SUBSET_RESTRICT])

  let CONNECTED_CLOSED_MONOTONE_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s = t /\
        (!c. closed_in (subtopology euclidean s) c
             ==> closed_in (subtopology euclidean t) (IMAGE f c)) /\
        (!y. y IN t ==> connected {x | x IN s /\ f x = y})
        ==> !c. connected c /\ c SUBSET t
                ==> connected {x | x IN s /\ f x IN c}"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"subtopology euclidean (s:real^M->bool)",
      ← q r"subtopology euclidean (t:real^N->bool)", ← q r"f:real^M->real^N"]
     MONOTONE_CLOSED_MAP) THEN
    ASM_REWRITE_TAC [closed_map, monotone_map, CONTINUOUS_MAP_EUCLIDEAN2,
      CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_EUCLIDEAN,
      TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_REFL, SUBSET_RESTRICT])

  return { CLOSED_MAP_FROM_COMPOSITION_INJECTIVE, OPEN_MAP_CLOSED_SUPERSET_PREIMAGE,
           OPEN_MAP_CLOSED_SUPERSET_PREIMAGE_EQ, CLOSED_MAP_OPEN_SUPERSET_PREIMAGE,
           CLOSED_MAP_OPEN_SUPERSET_PREIMAGE_EQ, CLOSED_MAP_OPEN_SUPERSET_PREIMAGE_POINT,
           CONNECTED_OPEN_MONOTONE_PREIMAGE, CONNECTED_CLOSED_MONOTONE_PREIMAGE }

/- ------------------------------------------------------------------------- -/
/- Proper maps, including projections out of compact sets, part 1.         -/
/- (topology.ml 9015-9141)                                                   -/
/- ------------------------------------------------------------------------- -/

structure PRP1 where
  PROPER_MAP_INTO_EUCLIDEAN : thm
  PROPER_MAP_EUCLIDEAN : thm
  PROPER_MAP : thm
  PROPER_MAP_EQ : thm
  PROPER_MAP_FROM_COMPACT : thm
  PROPER_MAP_FROM_COMPACT_ALT : thm
  PROPER_MAP_EUCLIDEAN_COMPOSE : thm
  PROPER_MAP_EUCLIDEAN_FROM_COMPOSITION_LEFT : thm
  PROPER_MAP_EUCLIDEAN_FROM_COMPOSITION_RIGHT : thm
  deriving Inhabited

@[nospecialize]
def setupPRP1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC)
    (BBND1 : BND1) (BCPT : CPT) (BCSL : CSL) (BCLC : CLC) (BLCP : LCP) :
    ExceptT String IO PRP1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { CONJ_ACI, EQ_IMP, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, .. } := D.core2
  let { SUBSET_RESTRICT, .. } := D.core5
  let { o_THM, .. } := D.core6
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_SUBSET_TRANS, COMPACT_IN_SUBTOPOLOGY, .. } := D.met1
  let { KC_SPACE_SUBTOPOLOGY, METRIZABLE_IMP_KC_SPACE, METRIZABLE_IMP_K_SPACE,
        METRIZABLE_SPACE_SUBTOPOLOGY, .. } := D.met2
  let { PROPER_EQ_COMPACT_MAP, closed_map, proper_map, .. } := D.met3
  let { KC_SPACE_EUCLIDEAN, METRIZABLE_SPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } :=
    BEUC
  let { CLOSED_IN_REFL, .. } := BCLO
  let { CLOSED_IN_CLOSED_EQ, CLOSED_SUBSET, .. } := BLOC
  let { BOUNDED_SUBSET, .. } := BBND1
  let { CLOSED_IN_COMPACT, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_CLOSED, COMPACT_IN_EUCLIDEAN,
        .. } := BCPT
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_CLOSED_IN_PREIMAGE_GEN, .. } := BCLC
  let { COMPACT_CONTINUOUS_IMAGE, .. } := BLCP
  -- @@SCOPE END

  let PROPER_MAP_INTO_EUCLIDEAN ← prove
   r"!top (f:A->real^N) s.
        continuous_map(top,subtopology euclidean s) f \/ kc_space top
        ==> (proper_map(top,subtopology euclidean s) f <=>
             IMAGE f (topspace top) SUBSET s /\
             !k. k SUBSET s /\ compact k
                 ==> compact_in top {x | x IN topspace top /\ f x IN k})"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
       PROPER_EQ_COMPACT_MAP o lhand o snd) THEN
    ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, COMPACT_IN_SUBTOPOLOGY,
                     COMPACT_IN_EUCLIDEAN] THEN
    ANTS_TAC THENL [ALL_TAC, REWRITE_TAC [CONJ_ACI]] THEN
    SIMP_TAC [METRIZABLE_IMP_K_SPACE, METRIZABLE_IMP_KC_SPACE,
              METRIZABLE_SPACE_SUBTOPOLOGY, METRIZABLE_SPACE_EUCLIDEAN])

  let PROPER_MAP_EUCLIDEAN ← prove
   r"!(f:real^M->real^N) s t.
        proper_map(subtopology euclidean s,subtopology euclidean t) f <=>
        IMAGE f s SUBSET t /\
        !k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}"
   (SIMP_TAC [PROPER_MAP_INTO_EUCLIDEAN, KC_SPACE_SUBTOPOLOGY,
              KC_SPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, COMPACT_IN_EUCLIDEAN, SUBSET_RESTRICT])

  let PROPER_MAP ← prove
   r"!f:real^M->real^N s t.
    IMAGE f s SUBSET t
    ==> ((!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) <=>
         (!k. closed_in (subtopology euclidean s) k
              ==> closed_in (subtopology euclidean t) (IMAGE f k)) /\
         (!a. a IN t ==> compact {x | x IN s /\ f x = a}))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"t:real^N->bool"]
          PROPER_MAP_EUCLIDEAN) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [proper_map, closed_map] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, COMPACT_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [SUBSET_RESTRICT, COMPACT_IN_EUCLIDEAN])

  let PROPER_MAP_EQ ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s SUBSET t /\
        (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) <=>
        (!k. closed_in (subtopology euclidean s) k
             ==> closed_in (subtopology euclidean t) (IMAGE f k)) /\
        (!a. a IN t ==> compact {x | x IN s /\ f x = a})"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p ==> (q <=> r /\ s)) /\ (r ==> p) ==> (p /\ q <=> r /\ s)")) THEN
    REWRITE_TAC [PROPER_MAP] THEN
    MESON_TAC [CLOSED_IN_REFL, CLOSED_IN_IMP_SUBSET])

  let PROPER_MAP_FROM_COMPACT ← prove
   r"!f:real^M->real^N s k t.
        f continuous_on s /\ IMAGE f s SUBSET t /\ compact s /\
        closed_in (subtopology euclidean t) k
        ==> compact {x | x IN s /\ f x IN k}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_IN_COMPACT THEN EXISTS_TAC (← q r"s:real^M->bool") THEN
    ASM_MESON_TAC [CONTINUOUS_CLOSED_IN_PREIMAGE_GEN])

  let PROPER_MAP_FROM_COMPACT_ALT ← prove
   r"!f:real^M->real^N s t.
         compact s /\ f continuous_on s /\ IMAGE f s SUBSET t
         ==> !k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PROPER_MAP_FROM_COMPACT THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CLOSED_SUBSET THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED])

  let PROPER_MAP_EUCLIDEAN_COMPOSE ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        IMAGE f s SUBSET t /\
        (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) /\
        (!k. k SUBSET u /\ compact k ==> compact {x | x IN t /\ g x IN k})
        ==> !k. k SUBSET u /\ compact k
                ==> compact {x | x IN s /\ (g o f) x IN k}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [o_THM] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:real^P->bool")) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{x | x IN t /\ (g:real^N->real^P) x IN k}")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC EQ_IMP] THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let PROPER_MAP_EUCLIDEAN_FROM_COMPOSITION_LEFT ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        f continuous_on s /\ IMAGE f s = t /\
        g continuous_on t /\ IMAGE g t SUBSET u /\
        (!k. k SUBSET u /\ compact k
             ==> compact {x | x IN s /\ (g o f) x IN k})
        ==> !k. k SUBSET u /\ compact k ==> compact {x | x IN t /\ g x IN k}"
   (REWRITE_TAC [o_THM] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:real^P->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"f:real^M->real^N") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] COMPACT_CONTINUOUS_IMAGE)) THEN
    ANTS_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN SET_TAC [],
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let PROPER_MAP_EUCLIDEAN_FROM_COMPOSITION_RIGHT ← do
    let lemma ← prove
     r"!s t. closed_in (subtopology euclidean s) t ==> compact s ==> compact t"
     (MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET,
                 CLOSED_IN_CLOSED_EQ])
    prove
     r"!f:real^M->real^N g:real^N->real^P s t u.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET u /\
        (!k. k SUBSET u /\ compact k
             ==> compact {x | x IN s /\ (g o f) x IN k})
        ==> !k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}"
     (REWRITE_TAC [o_THM] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (g:real^N->real^P) k")) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
        MATCH_MP_TAC lemma THEN
        MATCH_MP_TAC CLOSED_IN_SUBSET_TRANS THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_GEN THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_SUBSET THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED]])

  return { PROPER_MAP_INTO_EUCLIDEAN, PROPER_MAP_EUCLIDEAN, PROPER_MAP, PROPER_MAP_EQ,
           PROPER_MAP_FROM_COMPACT, PROPER_MAP_FROM_COMPACT_ALT, PROPER_MAP_EUCLIDEAN_COMPOSE,
           PROPER_MAP_EUCLIDEAN_FROM_COMPOSITION_LEFT,
           PROPER_MAP_EUCLIDEAN_FROM_COMPOSITION_RIGHT }

/- ------------------------------------------------------------------------- -/
/- Proper maps, including projections out of compact sets, part 2.         -/
/- (topology.ml 9142-9277)                                                   -/
/- ------------------------------------------------------------------------- -/

structure PRP2 where
  PROPER_MAP_FSTCART : thm
  CLOSED_MAP_FSTCART : thm
  PROPER_MAP_SNDCART : thm
  CLOSED_MAP_SNDCART : thm
  CLOSED_IN_COMPACT_PROJECTION : thm
  CLOSED_COMPACT_PROJECTION : thm
  TUBE_LEMMA : thm
  TUBE_LEMMA_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupPRP2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BCPT : CPT)
    (BPCR1 : PCR1) (BPRP1 : PRP1) : ExceptT String IO PRP2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, EQ_IMP, EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_PASTECART, FSTCART_PASTECART,
        IMAGE_FSTCART_PCROSS, IMAGE_SNDCART_PCROSS, IMP_CONJ_ALT, INTER_SUBSET, IN_DIFF,
        IN_ELIM_PASTECART_THM, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, PASTECART_IN_PCROSS, PCROSS, .. } :=
    D.core3
  let { RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SNDCART_PASTECART, SUBSET, SUBSET_DIFF, .. } := D.core5
  let { UNIONS_IMAGE, .. } := D.core6
  let { CLOSED_IN_IMP_SUBSET, .. } := D.met1
  let { OPEN_IN_CLOSED_IN_EQ, OPEN_IN_UNIONS, closed_in, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_INTER, CLOSED_UNIV, .. } := BCLO
  let { CLOSED_IN_CLOSED_TRANS, CLOSED_SUBSET, .. } := BLOC
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { CLOSED_PCROSS, COMPACT_PCROSS, .. } := BPCR1
  let { PROPER_MAP, .. } := BPRP1
  -- @@SCOPE END

  let PROPER_MAP_FSTCART ← prove
   r"!s:real^M->bool t:real^N->bool k.
        compact t /\ k SUBSET s /\ compact k
        ==> compact {z | z IN s PCROSS t /\ fstcart z IN k}"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"{z | z IN s PCROSS t /\ fstcart z IN k} =
      (k:real^M->bool) PCROSS (t:real^N->bool)")
     (fun th => ASM_SIMP_TAC [th, COMPACT_PCROSS]) THEN
    REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_ELIM_THM,
                 PASTECART_IN_PCROSS, FSTCART_PASTECART] THEN
    ASM SET_TAC [])

  let CLOSED_MAP_FSTCART ← prove
   r"!s:real^M->bool t:real^N->bool c.
        compact t /\ closed_in (subtopology euclidean (s PCROSS t)) c
        ==> closed_in (subtopology euclidean s) (IMAGE fstcart c)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"fstcart:real^(M,N)finite_sum->real^M",
                     ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)",
                     ← q r"s:real^M->bool"]
          PROPER_MAP) THEN
    ASM_SIMP_TAC [PROPER_MAP_FSTCART, IMAGE_FSTCART_PCROSS] THEN
    ASM SET_TAC [])

  let PROPER_MAP_SNDCART ← prove
   r"!s:real^M->bool t:real^N->bool k.
        compact s /\ k SUBSET t /\ compact k
        ==> compact {z | z IN s PCROSS t /\ sndcart z IN k}"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"{z | z IN s PCROSS t /\ sndcart z IN k} =
      (s:real^M->bool) PCROSS (k:real^N->bool)")
     (fun th => ASM_SIMP_TAC [th, COMPACT_PCROSS]) THEN
    REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_ELIM_THM,
                 PASTECART_IN_PCROSS, SNDCART_PASTECART] THEN
    ASM SET_TAC [])

  let CLOSED_MAP_SNDCART ← prove
   r"!s:real^M->bool t:real^N->bool c.
        compact s /\ closed_in (subtopology euclidean (s PCROSS t)) c
        ==> closed_in (subtopology euclidean t) (IMAGE sndcart c)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"sndcart:real^(M,N)finite_sum->real^N",
                     ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)",
                     ← q r"t:real^N->bool"]
          PROPER_MAP) THEN
    ASM_SIMP_TAC [PROPER_MAP_SNDCART, IMAGE_SNDCART_PCROSS] THEN
    ASM SET_TAC [])

  let CLOSED_IN_COMPACT_PROJECTION ← prove
   r"!s:real^M->bool t:real^N->bool u.
    compact s /\ closed_in (subtopology euclidean (s PCROSS t)) u
    ==> closed_in (subtopology euclidean t)
                  {y | ?x. x IN s /\ pastecart x y IN u}"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_MAP_SNDCART) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET o CONJUNCT2) THEN
    REWRITE_TAC [EXTENSION, SUBSET, IN_IMAGE, FORALL_PASTECART, EXISTS_PASTECART,
                 PASTECART_IN_PCROSS, IN_ELIM_THM, SNDCART_PASTECART] THEN
    SET_TAC [])

  let CLOSED_COMPACT_PROJECTION ← prove
   r"!s:real^M->bool t:real^(M,N)finite_sum->bool.
      compact s /\ closed t ==> closed {y | ?x. x IN s /\ pastecart x y IN t}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{y | ?x:real^M. x IN s /\ pastecart x y IN t} =
      {y | ?x. x IN s /\ pastecart x y IN ((s PCROSS (:real^N)) INTER t)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [PASTECART_IN_PCROSS, IN_UNIV, IN_INTER] THEN SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_CLOSED_TRANS THEN
      EXISTS_TAC (← q r"(:real^N)") THEN REWRITE_TAC [CLOSED_UNIV] THEN
      MATCH_MP_TAC CLOSED_IN_COMPACT_PROJECTION THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSED_SUBSET THEN
      ASM_SIMP_TAC [CLOSED_INTER, CLOSED_UNIV, CLOSED_PCROSS, COMPACT_IMP_CLOSED,
                    INTER_SUBSET]])

  let TUBE_LEMMA ← prove
   r"!s:real^M->bool t:real^N->bool u a.
        compact s /\ ~(s = {}) /\ {pastecart x a | x IN s} SUBSET u /\
        open_in(subtopology euclidean (s PCROSS t)) u
        ==> ?v. open_in (subtopology euclidean t) v /\ a IN v /\
                (s PCROSS v) SUBSET u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PCROSS] THEN
    REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT, PCROSS]
          CLOSED_IN_COMPACT_PROJECTION)) THEN
    ASM_REWRITE_TAC [IN_ELIM_PASTECART_THM, IN_DIFF] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN MATCH_MP_TAC (← MESON []
     (← q r"(closed_in top t ==> s DIFF (s DIFF t) = t) /\
      s DIFF t SUBSET s /\ P(s DIFF t)
      ==> closed_in top t
          ==> ?v. v SUBSET s /\ closed_in top (s DIFF v) /\ P v")) THEN
    REWRITE_TAC [← SET_RULE (← q r"s DIFF (s DIFF t) = t <=> t SUBSET s")] THEN
    REWRITE_TAC [SUBSET_DIFF] THEN
    SIMP_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [IN_DIFF, IN_ELIM_THM] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
    CONJ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET])) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_SING, FORALL_PASTECART] THEN
    REWRITE_TAC [IN_ELIM_PASTECART_THM] THEN ASM_MESON_TAC [MEMBER_NOT_EMPTY])

  let TUBE_LEMMA_GEN ← prove
   r"!s t t' u:real^(M,N)finite_sum->bool.
        compact s /\ ~(s = {}) /\ t SUBSET t' /\
        s PCROSS t SUBSET u /\
        open_in (subtopology euclidean (s PCROSS t')) u
        ==> ?v. open_in (subtopology euclidean t') v /\
                t SUBSET v /\
                s PCROSS v SUBSET u"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!a. a IN t ==> ?v. open_in (subtopology euclidean t') v /\ a IN v /\
                         (s:real^M->bool) PCROSS (v:real^N->bool) SUBSET u")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC TUBE_LEMMA THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
      ASM_REWRITE_TAC [PASTECART_IN_PCROSS],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"vv:real^N->real^N->bool") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"UNIONS (IMAGE (vv:real^N->real^N->bool) t)") THEN
      ASM_SIMP_TAC [OPEN_IN_UNIONS, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [SUBSET, UNIONS_IMAGE, IN_ELIM_THM, FORALL_IN_PCROSS] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^N"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_TAC (← q r"c:real^N"))) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^N")) THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_PCROSS] THEN ASM SET_TAC []])

  return { PROPER_MAP_FSTCART, CLOSED_MAP_FSTCART, PROPER_MAP_SNDCART, CLOSED_MAP_SNDCART,
           CLOSED_IN_COMPACT_PROJECTION, CLOSED_COMPACT_PROJECTION, TUBE_LEMMA, TUBE_LEMMA_GEN }

/- ------------------------------------------------------------------------- -/
/- Sequential characterizations of proper-ness; pasting functions together  -/
/- on open sets.  (topology.ml 9278-9445)                                    -/
/- ------------------------------------------------------------------------- -/

structure SPP where
  PROPER_MAP_SEQUENTIALLY_IMP : thm
  PROPER_MAP_SEQUENTIALLY_REV : thm
  PROPER_MAP_SEQUENTIALLY : thm
  PROPER_MAP_ESCAPES_IMP : thm
  PROPER_MAP_ESCAPES : thm
  CONTINUOUS_ON_UNION_LOCAL_OPEN : thm
  CONTINUOUS_ON_UNION_OPEN : thm
  CONTINUOUS_ON_CASES_LOCAL_OPEN : thm
  CONTINUOUS_ON_CASES_OPEN : thm
  deriving Inhabited

@[nospecialize]
def setupSPP [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BSEQ : SEQ)
    (BCPT : CPT) (BCPP1 : CPP1) (BNST : NST) (BCNO : CNO) (BCSL : CSL) (BSQC : SQC) :
    ExceptT String IO SPP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, CONTRAPOS_THM, EXISTS_IN_INSERT, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_o, IMP_CONJ, IMP_IMP, INSERT_SUBSET,
        IN_ELIM_THM, IN_INSERT, .. } := D.core2
  let { IN_UNION, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core3
  let { RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.core5
  let { o_ASSOC, o_DEF, o_THM, .. } := D.core6
  let { PASTING_LEMMA, SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { OPEN_UNION, .. } := BCLO
  let { OPEN_OPEN_IN_TRANS, .. } := BLOC
  let { CLOSED_CONTAINS_SEQUENTIAL_LIMIT, .. } := BSEQ
  let { COMPACT_IMP_CLOSED, compact, .. } := BCPT
  let { COMPACT_SEQUENCE_WITH_LIMIT, .. } := BCPP1
  let { SEQUENCE_ESCAPES, .. } := BNST
  let { CONTINUOUS_MAP_EUCLIDEAN, .. } := BCNO
  let { CONTINUOUS_ON_EQ, .. } := BCSL
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  -- @@SCOPE END

  let PROPER_MAP_SEQUENTIALLY_IMP ← prove
   r"!f:real^M->real^N s t x y.
        IMAGE f s SUBSET t /\
        (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) /\
        (!n. x(n) IN s) /\ y IN t /\ ((f o x) --> y) sequentially
        ==> ?z r. z IN s /\ (!m n. m < n ==> r m < r n) /\
                  ((x o r) --> z) sequentially"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
        (← q r"y INSERT IMAGE ((f:real^M->real^N) o x) (:num)")) THEN
      ASM_SIMP_TAC [COMPACT_SEQUENCE_WITH_LIMIT, INSERT_SUBSET] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, o_THM] THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [compact]] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real^M")) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, IN_INSERT, IMAGE_o] THEN ASM SET_TAC [])

  let PROPER_MAP_SEQUENTIALLY_REV ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\
        (!x y. (!n. x(n) IN s) /\ y IN t /\ ((f o x) --> y) sequentially
               ==> ?z r. z IN s /\ (!m n. m < n ==> r m < r n) /\
                         ((x o r) --> z) sequentially)
        ==> !k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [compact, IN_ELIM_THM, AND_FORALL_THM] THEN
    X_GEN_TAC (← q r"x:num->real^M") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^M->real^N) o (x:num->real^M)")) THEN
    ASM_REWRITE_TAC [o_THM, LEFT_IMP_EXISTS_THM, ← GSYM o_ASSOC] THEN
    MAP_EVERY X_GEN_TAC [← q r"y:real^N", ← q r"r:num->num"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"(x:num->real^M) o (r:num->num)", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [o_THM] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^M") THEN
    REWRITE_TAC [← GSYM o_ASSOC, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"q:num->num") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(r:num->num) o (q:num->num)") THEN
    ASM_SIMP_TAC [o_THM] THEN MATCH_MP_TAC CLOSED_CONTAINS_SEQUENTIAL_LIMIT THEN
    EXISTS_TAC (← q r"(f:real^M->real^N) o (x:num->real^M) o r o (q:num->num)") THEN
    ASM_SIMP_TAC [o_THM, COMPACT_IMP_CLOSED] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [CONTINUOUS_ON_SEQUENTIALLY]) THEN
    ASM_REWRITE_TAC [o_THM])

  let PROPER_MAP_SEQUENTIALLY ← prove
   r"!f:real^M->real^N s t.
    f continuous_on s /\ IMAGE f s SUBSET t
    ==> ((!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) <=>
         !x y. (!n. x(n) IN s) /\ y IN t /\ ((f o x) --> y) sequentially
               ==> ?z r. z IN s /\
                         (!m n. m < n ==> r m < r n) /\
                         ((x o r) --> z) sequentially)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC PROPER_MAP_SEQUENTIALLY_IMP THEN ASM_MESON_TAC [],
      DISCH_TAC THEN MATCH_MP_TAC PROPER_MAP_SEQUENTIALLY_REV THEN
      ASM_REWRITE_TAC []])

  let PROPER_MAP_ESCAPES_IMP ← prove
   r"!f:real^M->real^N s t x.
        IMAGE f s SUBSET t /\
        (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) /\
        (!n:num. x n IN s) /\
        (!c. c SUBSET s /\ compact c ==> FINITE {n | x n IN c})
        ==> (!k. k SUBSET t /\ compact k ==> FINITE {n | f(x n) IN k})"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    SUBGOAL_THEN
     (← q r"!x. (!n. x n IN s) ==> (!n:num. (f:real^M->real^N) (x n) IN t)")
    MP_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC [SEQUENCE_ESCAPES]] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    REWRITE_TAC [CONTRAPOS_THM, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC, o_DEF] THEN
    MAP_EVERY X_GEN_TAC [← q r"y:real^N", ← q r"r:num->num"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"t:real^N->bool",
                     ← q r"(x:num->real^M) o (r:num->num)", ← q r"y:real^N"]
          PROPER_MAP_SEQUENTIALLY_IMP) THEN
    ASM_REWRITE_TAC [o_DEF] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"z:real^M") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:num->num") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(r:num->num) o (q:num->num)") THEN
    ASM_SIMP_TAC [o_DEF])

  let PROPER_MAP_ESCAPES ← prove
   r"!f:real^M->real^N s t.
    f continuous_on s /\ IMAGE f s SUBSET t
    ==> ((!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) <=>
         !x. (!n:num. x n IN s) /\
             (!c. c SUBSET s /\ compact c ==> FINITE {n | x n IN c})
             ==> (!k. k SUBSET t /\ compact k ==> FINITE {n | f(x n) IN k}))"
   (REPEAT STRIP_TAC THEN
    SIMP_TAC [IMP_CONJ, SEQUENCE_ESCAPES] THEN
    ASM_SIMP_TAC [PROPER_MAP_SEQUENTIALLY, IMP_IMP] THEN
    SUBGOAL_THEN
     (← q r"!x. (!n. x n IN s) ==> (!n:num. (f:real^M->real^N) (x n) IN t)")
    MP_TAC THENL [ASM SET_TAC [], SIMP_TAC [SEQUENCE_ESCAPES]] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    REWRITE_TAC [CONTRAPOS_THM, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC, o_DEF] THEN
    EQ_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:num->real^M", ← q r"y:real^N"] THENL
     [X_GEN_TAC (← q r"r:num->num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(x:num->real^M) o (r:num->num)", ← q r"y:real^N"]) THEN
      ASM_REWRITE_TAC [o_DEF] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^M") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:num->num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(r:num->num) o (q:num->num)") THEN ASM_SIMP_TAC [o_THM],
      STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"y:real^N", ← q r"\n:num. n"] THEN
      ASM_REWRITE_TAC []])

  let CONTINUOUS_ON_UNION_LOCAL_OPEN ← prove
   r"!f:real^M->real^N s.
        open_in (subtopology euclidean (s UNION t)) s /\
        open_in (subtopology euclidean (s UNION t)) t /\
        f continuous_on s /\ f continuous_on t
        ==> f continuous_on (s UNION t)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"subtopology euclidean (s UNION t:real^M->bool)",
      ← q r"euclidean:(real^N)topology",
      ← q r"\i:(real^M->bool). (f:real^M->real^N)", ← q r"f:real^M->real^N",
      ← q r"\i:(real^M->bool). i", ← q r"{s:real^M->bool,t}"]
      PASTING_LEMMA) THEN
    REWRITE_TAC [FORALL_IN_INSERT, EXISTS_IN_INSERT, NOT_IN_EMPTY] THEN
    REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    ASM_REWRITE_TAC [IN_UNION, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"(s UNION t) INTER t = t")] THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"(s UNION t) INTER s = s")])

  let CONTINUOUS_ON_UNION_OPEN ← prove
   r"!f s t. open s /\ open t /\ f continuous_on s /\ f continuous_on t
           ==> f continuous_on (s UNION t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_UNION_LOCAL_OPEN THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC OPEN_OPEN_IN_TRANS THEN
    ASM_SIMP_TAC [OPEN_UNION] THEN SET_TAC [])

  let CONTINUOUS_ON_CASES_LOCAL_OPEN ← prove
   r"!P f g:real^M->real^N s t.
        open_in (subtopology euclidean (s UNION t)) s /\
        open_in (subtopology euclidean (s UNION t)) t /\
        f continuous_on s /\ g continuous_on t /\
        (!x. x IN s /\ ~P x \/ x IN t /\ P x ==> f x = g x)
        ==> (\x. if P x then f x else g x) continuous_on (s UNION t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_UNION_LOCAL_OPEN THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_EQ THENL
     [EXISTS_TAC (← q r"f:real^M->real^N"), EXISTS_TAC (← q r"g:real^M->real^N")] THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  let CONTINUOUS_ON_CASES_OPEN ← prove
   r"!P f g s t.
           open s /\
           open t /\
           f continuous_on s /\
           g continuous_on t /\
           (!x. x IN s /\ ~P x \/ x IN t /\ P x ==> f x = g x)
           ==> (\x. if P x then f x else g x) continuous_on s UNION t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL_OPEN THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC OPEN_OPEN_IN_TRANS THEN
    ASM_SIMP_TAC [OPEN_UNION] THEN SET_TAC [])

  return { PROPER_MAP_SEQUENTIALLY_IMP, PROPER_MAP_SEQUENTIALLY_REV, PROPER_MAP_SEQUENTIALLY,
           PROPER_MAP_ESCAPES_IMP, PROPER_MAP_ESCAPES, CONTINUOUS_ON_UNION_LOCAL_OPEN,
           CONTINUOUS_ON_UNION_OPEN, CONTINUOUS_ON_CASES_LOCAL_OPEN, CONTINUOUS_ON_CASES_OPEN }

/- ------------------------------------------------------------------------- -/
/- Closure of halflines, halfspaces and hyperplanes; openness of           -/
/- halfspaces.  (topology.ml 9446-9650)                                      -/
/- ------------------------------------------------------------------------- -/

structure HSP where
  LIM_LIFT_DOT : thm
  CONTINUOUS_AT_LIFT_DOT : thm
  CONTINUOUS_ON_LIFT_DOT : thm
  CLOSED_INTERVAL_LEFT : thm
  CLOSED_INTERVAL_RIGHT : thm
  CLOSED_HALFSPACE_LE : thm
  CLOSED_HALFSPACE_GE : thm
  CLOSED_HYPERPLANE : thm
  CLOSURE_HYPERPLANE : thm
  CLOSED_STANDARD_HYPERPLANE : thm
  CLOSED_HALFSPACE_COMPONENT_LE : thm
  CLOSED_HALFSPACE_COMPONENT_GE : thm
  OPEN_HALFSPACE_LT : thm
  OPEN_HALFSPACE_COMPONENT_LT : thm
  OPEN_HALFSPACE_GT : thm
  OPEN_HALFSPACE_COMPONENT_GT : thm
  OPEN_POSITIVE_MULTIPLES : thm
  OPEN_INTERVAL_LEFT : thm
  OPEN_INTERVAL_RIGHT : thm
  OPEN_POSITIVE_ORTHANT : thm
  deriving Inhabited

@[nospecialize]
def setupHSP [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BLPT : LPT)
    (BCLS1 : CLS1) (BLIM1 : LIM1) (BLIM2 : LIM2) (BARI : ARI) (BCNT1 : CNT1) (BCSL : CSL)
    (BCLC : CLC) : ExceptT String IO HSP := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH_TAC,
        .. } := D
  let { DIMINDEX_1, EQ_IMP, EXISTS_REFL, EXTENSION, FINITE_IMAGE, FINITE_INDEX_INRANGE,
        FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMP_CONJ, INTERS_GSPEC, IN_ELIM_THM, IN_IMAGE,
        IN_INTER, IN_NUMSEG, .. } := D.core2
  let { IN_UNIV, LAMBDA_BETA, LEFT_FORALL_IMP_THM, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_ANTISYM, REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_MUL, REAL_LT_RDIV_EQ, .. } :=
    D.core4
  let { REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_SYM, REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LT,
        SIMPLE_IMAGE, .. } := D.core5
  let { o_DEF, o_THM, real_abs, real_ge, real_gt, .. } := D.core6
  let { COMPONENT_LE_NORM, DIST_MUL, DOT_BASIS, DOT_LNEG, DOT_LZERO, DOT_RSUB, DOT_SYM, .. } :=
    D.vec1
  let { LIFT_DROP, LIFT_NUM, LIFT_SUB, .. } := D.vec2
  let { NORM_CAUCHY_SCHWARZ_ABS, NORM_LIFT, NORM_POS_LT, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_SUB_COMPONENT, VEC_COMPONENT, dist, drop, .. } :=
    D.vec4
  let { EVENTUALLY_MONO, .. } := D.met2
  let { SUBTOPOLOGY_UNIV, .. } := D.met3
  let { open_def, .. } := BEUC
  let { CLOSED_IN, CLOSED_INTER, OPEN_INTERS, closed, .. } := BCLO
  let { CLOSED_IN_CLOSED, .. } := BLOC
  let { CLOSED_LIMPT, LIMPT_APPROACHABLE, .. } := BLPT
  let { CLOSURE_CLOSED, .. } := BCLS1
  let { tendsto, .. } := BLIM1
  let { LIM_AT, .. } := BLIM2
  let { LIM_CONST, .. } := BARI
  let { CONTINUOUS_AT, .. } := BCNT1
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := BCSL
  let { CONTINUOUS_ON_CLOSED, .. } := BCLC
  -- @@SCOPE END

  let LIM_LIFT_DOT ← prove
   r"!f:real^M->real^N a.
        (f --> l) net ==> ((lift o (\y. a dot f(y))) --> lift(a dot l)) net"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a = vec 0:real^N") THENL
     [ASM_REWRITE_TAC [DOT_LZERO, LIFT_NUM, o_DEF, LIM_CONST], ALL_TAC] THEN
    REWRITE_TAC [tendsto] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / norm(a:real^N)")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT, REAL_LT_RDIV_EQ] THEN
    REWRITE_TAC [dist, o_THM, ← GSYM LIFT_SUB, ← GSYM DOT_RSUB, NORM_LIFT] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    ONCE_REWRITE_TAC [DOT_SYM] THEN
    MESON_TAC [NORM_CAUCHY_SCHWARZ_ABS, REAL_MUL_SYM, REAL_LET_TRANS])

  let CONTINUOUS_AT_LIFT_DOT ← prove
   r"!a:real^N x. (lift o (\y. a dot y)) continuous at x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_AT, o_THM] THEN
    MATCH_MP_TAC LIM_LIFT_DOT THEN REWRITE_TAC [LIM_AT] THEN MESON_TAC [])

  let CONTINUOUS_ON_LIFT_DOT ← prove
   r"!s. (lift o (\y. a dot y)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_AT_IMP_CONTINUOUS_ON, CONTINUOUS_AT_LIFT_DOT])

  let CLOSED_INTERVAL_LEFT ← prove
   r"!b:real^N.
     closed {x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> x$i <= b$i}"
   (REWRITE_TAC [CLOSED_LIMPT, LIMPT_APPROACHABLE, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(x:real^N)$i - (b:real^N)$i")) THEN
    ASM_REWRITE_TAC [REAL_SUB_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [dist, REAL_NOT_LT] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"abs((z - x :real^N)$i)") THEN
    ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
    ASM_SIMP_TAC [VECTOR_SUB_COMPONENT] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"z <= b /\ b < x ==> x - b <= abs(z - x)")])

  let CLOSED_INTERVAL_RIGHT ← prove
   r"!a:real^N.
     closed {x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> a$i <= x$i}"
   (REWRITE_TAC [CLOSED_LIMPT, LIMPT_APPROACHABLE, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(a:real^N)$i - (x:real^N)$i")) THEN
    ASM_REWRITE_TAC [REAL_SUB_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [dist, REAL_NOT_LT] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"abs((z - x :real^N)$i)") THEN
    ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
    ASM_SIMP_TAC [VECTOR_SUB_COMPONENT] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"x < a /\ a <= z ==> a - x <= abs(z - x)")])

  let CLOSED_HALFSPACE_LE ← prove
   r"!a:real^N b. closed {x | a dot x <= b}"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPEC (← q r"(:real^N)") CONTINUOUS_ON_LIFT_DOT) THEN
    REWRITE_TAC [CONTINUOUS_ON_CLOSED, ← GSYM CLOSED_IN, SUBTOPOLOGY_UNIV] THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"IMAGE lift {r | ?x:real^N. (a dot x = r) /\ r <= b}")) THEN
    ANTS_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE, IN_UNIV] THEN
      REWRITE_TAC [o_DEF] THEN MESON_TAC [LIFT_DROP]] THEN
    REWRITE_TAC [CLOSED_IN_CLOSED] THEN
    EXISTS_TAC (← q r"{x | !i. 1 <= i /\ i <= dimindex(:1)
                         ==> (x:real^1)$i <= (lift b)$i}") THEN
    REWRITE_TAC [CLOSED_INTERVAL_LEFT] THEN
    SIMP_TAC [EXTENSION, IN_IMAGE, IN_UNIV, IN_ELIM_THM, IN_INTER,
      VEC_COMPONENT, DIMINDEX_1, LAMBDA_BETA, o_THM] THEN
    SIMP_TAC [← ARITH_RULE (← q r"1 <= i /\ i <= 1 <=> (i = 1)")] THEN
    REWRITE_TAC [← GSYM drop, LEFT_FORALL_IMP_THM, EXISTS_REFL] THEN
    MESON_TAC [LIFT_DROP])

  let CLOSED_HALFSPACE_GE ← prove
   r"!a:real^N b. closed {x | a dot x >= b}"
   (REWRITE_TAC [← REAL_ARITH (← q r"a >= b <=> --a <= --b")] THEN
    REWRITE_TAC [← GSYM DOT_LNEG, CLOSED_HALFSPACE_LE])

  let CLOSED_HYPERPLANE ← prove
   r"!a b. closed {x | a dot x = b}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"b <= a dot x <=> a dot x >= b")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
    SIMP_TAC [CLOSED_INTER, CLOSED_HALFSPACE_LE, CLOSED_HALFSPACE_GE])

  let CLOSURE_HYPERPLANE ← prove
   r"!a b. closure {x | a dot x = b} = {x | a dot x = b}"
   (SIMP_TAC [CLOSURE_CLOSED, CLOSED_HYPERPLANE])

  let CLOSED_STANDARD_HYPERPLANE ← prove
   r"!k a. closed {x:real^N | x$k = a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CLOSED_HYPERPLANE) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let CLOSED_HALFSPACE_COMPONENT_LE ← prove
   r"!a k. closed {x:real^N | x$k <= a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CLOSED_HALFSPACE_LE) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let CLOSED_HALFSPACE_COMPONENT_GE ← prove
   r"!a k. closed {x:real^N | x$k >= a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CLOSED_HALFSPACE_GE) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let OPEN_HALFSPACE_LT ← prove
   r"!a b. open {x | a dot x < b}"
   (REWRITE_TAC [← GSYM REAL_NOT_LE] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | ~p x} = UNIV DIFF {x | p x}")] THEN
    REWRITE_TAC [← GSYM closed, ← GSYM real_ge, CLOSED_HALFSPACE_GE])

  let OPEN_HALFSPACE_COMPONENT_LT ← prove
   r"!a k. open {x:real^N | x$k < a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] OPEN_HALFSPACE_LT) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let OPEN_HALFSPACE_GT ← prove
   r"!a b. open {x | a dot x > b}"
   (REWRITE_TAC [← REAL_ARITH (← q r"x > y <=> ~(x <= y)")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | ~p x} = UNIV DIFF {x | p x}")] THEN
    REWRITE_TAC [← GSYM closed, CLOSED_HALFSPACE_LE])

  let OPEN_HALFSPACE_COMPONENT_GT ← prove
   r"!a k. open {x:real^N | x$k > a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] OPEN_HALFSPACE_GT) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let OPEN_POSITIVE_MULTIPLES ← prove
   r"!s:real^N->bool. open s ==> open {c % x | &0 < c /\ x IN s}"
   (REWRITE_TAC [open_def, FORALL_IN_GSPEC] THEN GEN_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"c * e:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(c) % y:real^N")) THEN ANTS_TAC THENL
     [SUBGOAL_THEN (← q r"x:real^N = inv c % c % x") SUBST1_TAC THENL
       [ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, VECTOR_MUL_LID,
                      REAL_LT_IMP_NZ],
        ASM_SIMP_TAC [DIST_MUL, real_abs, REAL_LT_INV_EQ, REAL_LT_IMP_LE] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"inv c * x:real = x / c")] THEN
        ASM_MESON_TAC [REAL_LT_LDIV_EQ, REAL_MUL_SYM]],
      DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"c:real") THEN EXISTS_TAC (← q r"inv(c) % y:real^N") THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, REAL_LT_IMP_NZ] THEN
      VECTOR_ARITH_TAC])

  let OPEN_INTERVAL_LEFT ← prove
   r"!b:real^N. open {x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> x$i < b$i}"
   (GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"{x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> x$i < b$i} =
      INTERS{{x | x$i < (b:real^N)$i} | i IN 1..dimindex(:N)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [INTERS_GSPEC, IN_NUMSEG] THEN SET_TAC [],
      MATCH_MP_TAC OPEN_INTERS THEN
      SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, OPEN_HALFSPACE_COMPONENT_LT]])

  let OPEN_INTERVAL_RIGHT ← prove
   r"!a:real^N. open {x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> a$i < x$i}"
   (GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"{x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> a$i < x$i} =
      INTERS{{x | (a:real^N)$i < x$i} | i IN 1..dimindex(:N)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [INTERS_GSPEC, IN_NUMSEG] THEN SET_TAC [],
      MATCH_MP_TAC OPEN_INTERS THEN
      SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, ← GSYM real_gt, OPEN_HALFSPACE_COMPONENT_GT]])

  let OPEN_POSITIVE_ORTHANT ← prove
   r"open {x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> &0 < x$i}"
   (MP_TAC (← ISPEC (← q r"vec 0:real^N") OPEN_INTERVAL_RIGHT) THEN
    REWRITE_TAC [VEC_COMPONENT])

  return { LIM_LIFT_DOT, CONTINUOUS_AT_LIFT_DOT, CONTINUOUS_ON_LIFT_DOT, CLOSED_INTERVAL_LEFT,
           CLOSED_INTERVAL_RIGHT, CLOSED_HALFSPACE_LE, CLOSED_HALFSPACE_GE, CLOSED_HYPERPLANE,
           CLOSURE_HYPERPLANE, CLOSED_STANDARD_HYPERPLANE, CLOSED_HALFSPACE_COMPONENT_LE,
           CLOSED_HALFSPACE_COMPONENT_GE, OPEN_HALFSPACE_LT, OPEN_HALFSPACE_COMPONENT_LT,
           OPEN_HALFSPACE_GT, OPEN_HALFSPACE_COMPONENT_GT, OPEN_POSITIVE_MULTIPLES,
           OPEN_INTERVAL_LEFT, OPEN_INTERVAL_RIGHT, OPEN_POSITIVE_ORTHANT }

/- ------------------------------------------------------------------------- -/
/- Closures and interiors of halfspaces.  (topology.ml 9651-9831)            -/
/- ------------------------------------------------------------------------- -/

structure CIH where
  INTERIOR_HALFSPACE_LE : thm
  INTERIOR_HALFSPACE_GE : thm
  INTERIOR_HALFSPACE_COMPONENT_LE : thm
  INTERIOR_HALFSPACE_COMPONENT_GE : thm
  CLOSURE_HALFSPACE_LT : thm
  CLOSURE_HALFSPACE_GT : thm
  CLOSURE_HALFSPACE_COMPONENT_LT : thm
  CLOSURE_HALFSPACE_COMPONENT_GT : thm
  INTERIOR_HYPERPLANE : thm
  FRONTIER_HALFSPACE_LE : thm
  FRONTIER_HALFSPACE_GE : thm
  FRONTIER_HALFSPACE_LT : thm
  FRONTIER_HALFSPACE_GT : thm
  FRONTIER_HALFSPACE_COMPONENT_LE : thm
  FRONTIER_HALFSPACE_COMPONENT_GE : thm
  FRONTIER_HALFSPACE_COMPONENT_LT : thm
  FRONTIER_HALFSPACE_COMPONENT_GT : thm
  INTERIOR_STANDARD_HYPERPLANE : thm
  EMPTY_INTERIOR_LOWDIM : thm
  DIM_NONEMPTY_INTERIOR : thm
  deriving Inhabited

@[nospecialize]
def setupCIH [HolBase] (D : TopologyDeps) (BBAL : BAL) (BINT : INT) (BCLS1 : CLS1)
    (BFRO1 : FRO1) (BHSP : HSP) : ExceptT String IO CIH := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, NORM_ARITH, .. } := D
  let { EMPTY_GSPEC, EXTENSION, FINITE_INDEX_INRANGE, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNIV, LE_ANTISYM, NOT_IN_EMPTY, NOT_LE, REAL_ABS_DIV, .. } := D.core3
  let { REAL_DIV_RMUL, REAL_EQ_NEG2, REAL_LE_NEG2, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_LE,
        REAL_LT_MUL, REAL_LT_NEG2, .. } := D.core4
  let { REAL_NEG_EQ_0, SUBSET, .. } := D.core5
  let { UNIV_GSPEC, real_ge, real_gt, .. } := D.core6
  let { BASIS_NONZERO, DIM_SUBSET_UNIV, DOT_BASIS, DOT_LNEG, DOT_LZERO, DOT_POS_LT, DOT_RADD,
        DOT_RMUL, .. } := D.vec1
  let { LOWDIM_SUBSET_HYPERPLANE, .. } := D.vec2
  let { NORM_EQ_0, NORM_MUL, NORM_POS_LT, REAL_ABS_NORM, SPAN_INC, .. } := D.vec3
  let { VECTOR_NEG_EQ_0, .. } := D.vec4
  let { IN_CBALL, OPEN_CONTAINS_CBALL, .. } := BBAL
  let { INTERIOR_INTER, INTERIOR_OPEN, INTERIOR_UNIQUE, SUBSET_INTERIOR, .. } := BINT
  let { CLOSURE_CLOSED, CLOSURE_INTERIOR, .. } := BCLS1
  let { FRONTIER_EMPTY, FRONTIER_UNIV, frontier, .. } := BFRO1
  let { CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_HALFSPACE_COMPONENT_LE, CLOSED_HALFSPACE_LE,
        OPEN_HALFSPACE_COMPONENT_GT, OPEN_HALFSPACE_COMPONENT_LT, OPEN_HALFSPACE_LT, .. } := BHSP
  -- @@SCOPE END
  let ra (s : String) : ExceptT String IO thm := do REAL_ARITH (← q s)

  let INTERIOR_HALFSPACE_LE ← prove
   r"!a:real^N b.
        ~(a = vec 0) ==> interior {x | a dot x <= b} = {x | a dot x < b}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERIOR_UNIQUE THEN
    SIMP_TAC [OPEN_HALFSPACE_LT, SUBSET, IN_ELIM_THM, REAL_LT_IMP_LE] THEN
    X_GEN_TAC (← q r"s:real^N->bool") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN ASM_SIMP_TAC [REAL_LT_LE] THEN
    DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [SUBSET, IN_CBALL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x + e / norm(a) % a:real^N")) THEN
    REWRITE_TAC [← NORM_ARITH (← q r"dist(x:real^N,x + y) = norm y")] THEN
    ASM_SIMP_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM, REAL_DIV_RMUL,
                  NORM_EQ_0, ← ra r"&0 < x ==> abs x <= x"] THEN
    DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x + e / norm(a) % a:real^N")) THEN
    ASM_REWRITE_TAC [DOT_RADD, DOT_RMUL] THEN
    MATCH_MP_TAC (← ra r"&0 < e ==> ~(b + e <= b)") THEN
    ASM_SIMP_TAC [REAL_LT_MUL, REAL_LT_DIV, NORM_POS_LT, DOT_POS_LT])

  let INTERIOR_HALFSPACE_GE ← prove
   r"!a:real^N b.
        ~(a = vec 0) ==> interior {x | a dot x >= b} = {x | a dot x > b}"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← ra r"a >= b <=> --a <= --b",
                      ← ra r"a > b <=> --a < --b"] THEN
    ASM_SIMP_TAC [← GSYM DOT_LNEG, INTERIOR_HALFSPACE_LE, VECTOR_NEG_EQ_0])

  let INTERIOR_HALFSPACE_COMPONENT_LE ← prove
   r"!a k. interior {x:real^N | x$k <= a} = {x | x$k < a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] INTERIOR_HALFSPACE_LE) THEN
    ASM_SIMP_TAC [DOT_BASIS, BASIS_NONZERO])

  let INTERIOR_HALFSPACE_COMPONENT_GE ← prove
   r"!a k. interior {x:real^N | x$k >= a} = {x | x$k > a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] INTERIOR_HALFSPACE_GE) THEN
    ASM_SIMP_TAC [DOT_BASIS, BASIS_NONZERO])

  let CLOSURE_HALFSPACE_LT ← prove
   r"!a:real^N b.
        ~(a = vec 0) ==> closure {x | a dot x < b} = {x | a dot x <= b}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CLOSURE_INTERIOR] THEN
    REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF {x | P x} = {x | ~P x}")] THEN
    ASM_SIMP_TAC [← ra r"~(x < b) <=> x >= b", INTERIOR_HALFSPACE_GE] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_UNIV, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  let CLOSURE_HALFSPACE_GT ← prove
   r"!a:real^N b.
        ~(a = vec 0) ==> closure {x | a dot x > b} = {x | a dot x >= b}"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← ra r"a >= b <=> --a <= --b",
                      ← ra r"a > b <=> --a < --b"] THEN
    ASM_SIMP_TAC [← GSYM DOT_LNEG, CLOSURE_HALFSPACE_LT, VECTOR_NEG_EQ_0])

  let CLOSURE_HALFSPACE_COMPONENT_LT ← prove
   r"!a k. closure {x:real^N | x$k < a} = {x | x$k <= a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CLOSURE_HALFSPACE_LT) THEN
    ASM_SIMP_TAC [DOT_BASIS, BASIS_NONZERO])

  let CLOSURE_HALFSPACE_COMPONENT_GT ← prove
   r"!a k. closure {x:real^N | x$k > a} = {x | x$k >= a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] CLOSURE_HALFSPACE_GT) THEN
    ASM_SIMP_TAC [DOT_BASIS, BASIS_NONZERO])

  let INTERIOR_HYPERPLANE ← prove
   r"!a b. ~(a = vec 0) ==> interior {x | a dot x = b} = {}"
   (REWRITE_TAC [← ra r"x = y <=> x <= y /\ x >= y"] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | p x /\ q x} = {x | p x} INTER {x | q x}")] THEN
    REWRITE_TAC [INTERIOR_INTER] THEN
    ASM_SIMP_TAC [INTERIOR_HALFSPACE_LE, INTERIOR_HALFSPACE_GE] THEN
    REWRITE_TAC [EXTENSION, IN_INTER, IN_ELIM_THM, NOT_IN_EMPTY] THEN
    REAL_ARITH_TAC)

  let FRONTIER_HALFSPACE_LE ← prove
   r"!a:real^N b. ~(a = vec 0 /\ b = &0)
                ==> frontier {x | a dot x <= b} = {x | a dot x = b}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = vec 0") THEN
    ASM_SIMP_TAC [DOT_LZERO] THENL
     [ASM_CASES_TAC (← q r"&0 <= b") THEN
      ASM_REWRITE_TAC [UNIV_GSPEC, FRONTIER_UNIV, EMPTY_GSPEC, FRONTIER_EMPTY],
      ASM_SIMP_TAC [frontier, INTERIOR_HALFSPACE_LE, CLOSURE_CLOSED,
                    CLOSED_HALFSPACE_LE] THEN
      REWRITE_TAC [EXTENSION, IN_DIFF, IN_ELIM_THM] THEN REAL_ARITH_TAC])

  let FRONTIER_HALFSPACE_GE ← prove
   r"!a:real^N b. ~(a = vec 0 /\ b = &0)
                ==> frontier {x | a dot x >= b} = {x | a dot x = b}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"--a:real^N", ← q r"--b:real"] FRONTIER_HALFSPACE_LE) THEN
    ASM_REWRITE_TAC [VECTOR_NEG_EQ_0, REAL_NEG_EQ_0, DOT_LNEG] THEN
    REWRITE_TAC [REAL_LE_NEG2, REAL_EQ_NEG2, real_ge])

  let FRONTIER_HALFSPACE_LT ← prove
   r"!a:real^N b. ~(a = vec 0 /\ b = &0)
                ==> frontier {x | a dot x < b} = {x | a dot x = b}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = vec 0") THEN
    ASM_SIMP_TAC [DOT_LZERO] THENL
     [ASM_CASES_TAC (← q r"&0 < b") THEN
      ASM_REWRITE_TAC [UNIV_GSPEC, FRONTIER_UNIV, EMPTY_GSPEC, FRONTIER_EMPTY],
      ASM_SIMP_TAC [frontier, CLOSURE_HALFSPACE_LT, INTERIOR_OPEN,
                    OPEN_HALFSPACE_LT] THEN
      REWRITE_TAC [EXTENSION, IN_DIFF, IN_ELIM_THM] THEN REAL_ARITH_TAC])

  let FRONTIER_HALFSPACE_GT ← prove
   r"!a:real^N b. ~(a = vec 0 /\ b = &0)
                ==> frontier {x | a dot x > b} = {x | a dot x = b}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"--a:real^N", ← q r"--b:real"] FRONTIER_HALFSPACE_LT) THEN
    ASM_REWRITE_TAC [VECTOR_NEG_EQ_0, REAL_NEG_EQ_0, DOT_LNEG] THEN
    REWRITE_TAC [REAL_LT_NEG2, REAL_EQ_NEG2, real_gt])

  let FRONTIER_HALFSPACE_COMPONENT_LE ← prove
   r"!a k. frontier {x:real^N | x$k <= a} = {x | x$k = a}"
   (SIMP_TAC [frontier, CLOSURE_CLOSED, CLOSED_HALFSPACE_COMPONENT_LE,
              INTERIOR_HALFSPACE_COMPONENT_LE] THEN
    REWRITE_TAC [IN_DIFF, EXTENSION, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  let FRONTIER_HALFSPACE_COMPONENT_GE ← prove
   r"!a k. frontier {x:real^N | x$k >= a} = {x | x$k = a}"
   (SIMP_TAC [frontier, CLOSURE_CLOSED, CLOSED_HALFSPACE_COMPONENT_GE,
              INTERIOR_HALFSPACE_COMPONENT_GE] THEN
    REWRITE_TAC [IN_DIFF, EXTENSION, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  let FRONTIER_HALFSPACE_COMPONENT_LT ← prove
   r"!a k. frontier {x:real^N | x$k < a} = {x | x$k = a}"
   (SIMP_TAC [frontier, INTERIOR_OPEN, OPEN_HALFSPACE_COMPONENT_LT,
              CLOSURE_HALFSPACE_COMPONENT_LT] THEN
    REWRITE_TAC [IN_DIFF, EXTENSION, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  let FRONTIER_HALFSPACE_COMPONENT_GT ← prove
   r"!a k. frontier {x:real^N | x$k > a} = {x | x$k = a}"
   (SIMP_TAC [frontier, INTERIOR_OPEN, OPEN_HALFSPACE_COMPONENT_GT,
              CLOSURE_HALFSPACE_COMPONENT_GT] THEN
    REWRITE_TAC [IN_DIFF, EXTENSION, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  let INTERIOR_STANDARD_HYPERPLANE ← prove
   r"!k a. interior {x:real^N | x$k = a} = {}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !x:real^N. x$k = x$i")
    CHOOSE_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"basis i:real^N", ← q r"a:real"] INTERIOR_HYPERPLANE) THEN
    ASM_SIMP_TAC [DOT_BASIS, BASIS_NONZERO])

  let EMPTY_INTERIOR_LOWDIM ← prove
   r"!s:real^N->bool. dim(s) < dimindex(:N) ==> interior s = {}"
   (GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP LOWDIM_SUBSET_HYPERPLANE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!t u. s SUBSET t /\ t SUBSET u /\ u = {} ==> s = {}")) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"interior(span(s):real^N->bool)",
      ← q r"interior({x:real^N | a dot x = &0})"] THEN
    ASM_SIMP_TAC [SUBSET_INTERIOR, SPAN_INC, INTERIOR_HYPERPLANE])

  let DIM_NONEMPTY_INTERIOR ← prove
   r"!s:real^N->bool. ~(interior s = {}) ==> dim s = dimindex(:N)"
   (MESON_TAC [EMPTY_INTERIOR_LOWDIM, NOT_LE, LE_ANTISYM, DIM_SUBSET_UNIV])

  return { INTERIOR_HALFSPACE_LE, INTERIOR_HALFSPACE_GE, INTERIOR_HALFSPACE_COMPONENT_LE,
           INTERIOR_HALFSPACE_COMPONENT_GE, CLOSURE_HALFSPACE_LT, CLOSURE_HALFSPACE_GT,
           CLOSURE_HALFSPACE_COMPONENT_LT, CLOSURE_HALFSPACE_COMPONENT_GT, INTERIOR_HYPERPLANE,
           FRONTIER_HALFSPACE_LE, FRONTIER_HALFSPACE_GE, FRONTIER_HALFSPACE_LT,
           FRONTIER_HALFSPACE_GT, FRONTIER_HALFSPACE_COMPONENT_LE,
           FRONTIER_HALFSPACE_COMPONENT_GE, FRONTIER_HALFSPACE_COMPONENT_LT,
           FRONTIER_HALFSPACE_COMPONENT_GT, INTERIOR_STANDARD_HYPERPLANE, EMPTY_INTERIOR_LOWDIM,
           DIM_NONEMPTY_INTERIOR }

/- ------------------------------------------------------------------------- -/
/- Unboundedness of halfspaces.  (topology.ml 9832-9906)                     -/
/- ------------------------------------------------------------------------- -/

structure UBH where
  UNBOUNDED_HALFSPACE_COMPONENT_LE : thm
  UNBOUNDED_HALFSPACE_COMPONENT_GE : thm
  UNBOUNDED_HALFSPACE_COMPONENT_LT : thm
  UNBOUNDED_HALFSPACE_COMPONENT_GT : thm
  BOUNDED_HALFSPACE_LE : thm
  BOUNDED_HALFSPACE_GE : thm
  BOUNDED_HALFSPACE_LT : thm
  BOUNDED_HALFSPACE_GT : thm
  deriving Inhabited

@[nospecialize]
def setupUBH [HolBase] (D : TopologyDeps) (BBND1 : BND1) (BBND2 : BND2) (BCIH : CIH) :
    ExceptT String IO UBH := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, GEOM_BASIS_MULTIPLE_TAC, .. } := D
  let { CONTRAPOS_THM, DIMINDEX_GE_1, EMPTY_GSPEC, EQ_IMP, FINITE_INDEX_INRANGE, .. } := D.core1
  let { FORALL_IN_GSPEC, IN_ELIM_THM, .. } := D.core2
  let { LE_REFL, NOT_FORALL_THM, NOT_IMP, .. } := D.core3
  let { REAL_LE_RDIV_EQ, REAL_LT_LE, .. } := D.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, REAL_NOT_LE, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, .. } := D.core6
  let { BASIS_COMPONENT, BASIS_NONZERO, DOT_BASIS, DOT_LMUL, DOT_LNEG, DOT_LZERO, .. } := D.vec1
  let { NORM_BASIS, NORM_MUL, .. } := D.vec3
  let { VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0, VECTOR_NEG_COMPONENT, VECTOR_NEG_EQ_0,
        VECTOR_NEG_NEG, .. } := D.vec4
  let { BOUNDED_CLOSURE_EQ, BOUNDED_EMPTY, NOT_BOUNDED_UNIV, bounded, .. } := BBND1
  let { BOUNDED_NEGATIONS, .. } := BBND2
  let { CLOSURE_HALFSPACE_COMPONENT_GT, CLOSURE_HALFSPACE_COMPONENT_LT, CLOSURE_HALFSPACE_LT,
        .. } := BCIH
  -- @@SCOPE END
  let ra (s : String) : ExceptT String IO thm := do REAL_ARITH (← q s)

  let UNBOUNDED_HALFSPACE_COMPONENT_LE ← prove
   r"!a k. ~bounded {x:real^N | x$k <= a}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?i. 1 <= i /\ i <= dimindex(:N) /\ !z:real^N. z$k = z$i")
    CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    ASM_REWRITE_TAC [bounded, FORALL_IN_GSPEC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") MP_TAC) THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN
    EXISTS_TAC (← q r"--(&1 + max (abs B) (abs a)) % basis i:real^N") THEN
    ASM_SIMP_TAC [NORM_MUL, NORM_BASIS, BASIS_COMPONENT,
                  VECTOR_MUL_COMPONENT] THEN
    REAL_ARITH_TAC)

  let UNBOUNDED_HALFSPACE_COMPONENT_GE ← prove
   r"!a k. ~bounded {x:real^N | x$k >= a}"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP BOUNDED_NEGATIONS) THEN
    MP_TAC (← SPECL [← q r"--a:real", ← q r"k:num"] UNBOUNDED_HALFSPACE_COMPONENT_LE) THEN
    REWRITE_TAC [CONTRAPOS_THM] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN CONJ_TAC THENL
     [MESON_TAC [VECTOR_NEG_NEG],
      REWRITE_TAC [IN_ELIM_THM, VECTOR_NEG_COMPONENT] THEN REAL_ARITH_TAC])

  let UNBOUNDED_HALFSPACE_COMPONENT_LT ← prove
   r"!a k. ~bounded {x:real^N | x$k < a}"
   (ONCE_REWRITE_TAC [← GSYM BOUNDED_CLOSURE_EQ] THEN
    REWRITE_TAC [CLOSURE_HALFSPACE_COMPONENT_LT,
                 UNBOUNDED_HALFSPACE_COMPONENT_LE])

  let UNBOUNDED_HALFSPACE_COMPONENT_GT ← prove
   r"!a k. ~bounded {x:real^N | x$k > a}"
   (ONCE_REWRITE_TAC [← GSYM BOUNDED_CLOSURE_EQ] THEN
    REWRITE_TAC [CLOSURE_HALFSPACE_COMPONENT_GT,
                 UNBOUNDED_HALFSPACE_COMPONENT_GE])

  let BOUNDED_HALFSPACE_LE ← prove
   r"!a:real^N b. bounded {x | a dot x <= b} <=> a = vec 0 /\ b < &0"
   (GEOM_BASIS_MULTIPLE_TAC 1 (← q r"a:real^N") THEN
    SIMP_TAC [DOT_LMUL, DOT_BASIS, VECTOR_MUL_EQ_0, DIMINDEX_GE_1, LE_REFL,
              BASIS_NONZERO] THEN
    X_GEN_TAC (← q r"a:real") THEN ASM_CASES_TAC (← q r"a = &0") THEN ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"b:real") THENL
     [REWRITE_TAC [REAL_MUL_LZERO, DOT_LZERO, ← GSYM REAL_NOT_LE] THEN
      ASM_CASES_TAC (← q r"&0 <= b") THEN
      ASM_REWRITE_TAC [BOUNDED_EMPTY, NOT_BOUNDED_UNIV,
                       ← SET_RULE (← q r"{x | T} = UNIV"), EMPTY_GSPEC],
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_LT_LE,
                    UNBOUNDED_HALFSPACE_COMPONENT_LE]])

  let BOUNDED_HALFSPACE_GE ← prove
   r"!a:real^N b. bounded {x | a dot x >= b} <=> a = vec 0 /\ &0 < b"
   (REWRITE_TAC [← ra r"a >= b <=> --a <= --b"] THEN
    REWRITE_TAC [← GSYM DOT_LNEG, BOUNDED_HALFSPACE_LE] THEN
    REWRITE_TAC [VECTOR_NEG_EQ_0, ← ra r"--b < &0 <=> &0 < b"])

  let BOUNDED_HALFSPACE_LT ← prove
   r"!a:real^N b. bounded {x | a dot x < b} <=> a = vec 0 /\ b <= &0"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = vec 0") THEN
    ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [DOT_LZERO, ← GSYM REAL_NOT_LE] THEN ASM_CASES_TAC (← q r"b <= &0") THEN
      ASM_REWRITE_TAC [BOUNDED_EMPTY, NOT_BOUNDED_UNIV,
                       ← SET_RULE (← q r"{x | T} = UNIV"), EMPTY_GSPEC],
      ONCE_REWRITE_TAC [← GSYM BOUNDED_CLOSURE_EQ] THEN
      ASM_SIMP_TAC [CLOSURE_HALFSPACE_LT, BOUNDED_HALFSPACE_LE]])

  let BOUNDED_HALFSPACE_GT ← prove
   r"!a:real^N b. bounded {x | a dot x > b} <=> a = vec 0 /\ &0 <= b"
   (REWRITE_TAC [← ra r"a > b <=> --a < --b"] THEN
    REWRITE_TAC [← GSYM DOT_LNEG, BOUNDED_HALFSPACE_LT] THEN
    REWRITE_TAC [VECTOR_NEG_EQ_0, ← ra r"--b <= &0 <=> &0 <= b"])

  return { UNBOUNDED_HALFSPACE_COMPONENT_LE, UNBOUNDED_HALFSPACE_COMPONENT_GE,
           UNBOUNDED_HALFSPACE_COMPONENT_LT, UNBOUNDED_HALFSPACE_COMPONENT_GT,
           BOUNDED_HALFSPACE_LE, BOUNDED_HALFSPACE_GE, BOUNDED_HALFSPACE_LT,
           BOUNDED_HALFSPACE_GT }

/- ------------------------------------------------------------------------- -/
/- Equality of continuous functions on closure and related results.        -/
/- (topology.ml 9907-10062)                                                  -/
/- ------------------------------------------------------------------------- -/

structure ECF where
  FORALL_IN_INTERMEDIATE_CLOSURE : thm
  FORALL_IN_INTERMEDIATE_CLOSURE_EQ : thm
  CONTINUOUS_LE_ON_INTERMEDIATE_CLOSURE : thm
  CONTINUOUS_GE_ON_INTERMEDIATE_CLOSURE : thm
  CONTINUOUS_CONSTANT_ON_INTERMEDIATE_CLOSURE : thm
  CONTINUOUS_AGREE_ON_INTERMEDIATE_CLOSURE : thm
  FORALL_IN_CLOSURE : thm
  FORALL_IN_CLOSURE_EQ : thm
  SUP_CLOSURE : thm
  INF_CLOSURE : thm
  CONTINUOUS_LE_ON_CLOSURE : thm
  CONTINUOUS_GE_ON_CLOSURE : thm
  CONTINUOUS_CONSTANT_ON_CLOSURE : thm
  CONTINUOUS_AGREE_ON_CLOSURE : thm
  CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT : thm
  CONTINUOUS_CLOSED_PREIMAGE_CONSTANT : thm
  deriving Inhabited

@[nospecialize]
def setupECF [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLPT : LPT) (BCLS1 : CLS1) (BSEQ : SEQ)
    (BSQC : SQC) (BCMS : CMS) (BIDC : IDC) (BCLC : CLC) (BHSP : HSP) :
    ExceptT String IO ECF := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ETA_AX, .. } := D.core1
  let { FORALL_IN_IMAGE, INF_EQ, IN_ELIM_THM, .. } := D.core2
  let { SUBSET, SUBSET_REFL, .. } := D.core5
  let { SUP_EQ, o_THM, real_ge, .. } := D.core6
  let { LIFT_DROP, .. } := D.vec2
  let { VECTOR_SUB_EQ, drop, .. } := D.vec4
  let { CLOSED_EMPTY, .. } := BCLO
  let { CLOSED_SING, .. } := BLPT
  let { CLOSURE_EQ, CLOSURE_SUBSET, .. } := BCLS1
  let { CLOSURE_SEQUENTIAL, .. } := BSEQ
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  let { CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_CLOSED_PREIMAGE, .. } := BCLC
  let { CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_HALFSPACE_COMPONENT_LE, .. } := BHSP
  -- @@SCOPE END

  let FORALL_IN_INTERMEDIATE_CLOSURE ← prove
   r"!f:real^M->real^N s s' t.
        closed t /\ f continuous_on s' /\ s SUBSET s' /\ s' SUBSET closure s /\
        (!x. x IN s ==> f x IN t)
        ==> !x. x IN s' ==> f x IN t"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"x:real^M"] CLOSURE_SEQUENTIAL) THEN
    DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1)) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:num->real^M") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o GEN_REWRITE_RULE id [← GSYM CLOSURE_EQ]) THEN
    REWRITE_TAC [CLOSURE_SEQUENTIAL] THEN
    EXISTS_TAC (← q r"(f:real^M->real^N) o (a:num->real^M)") THEN
    ASM_SIMP_TAC [o_THM] THEN
    FIRST_ASSUM (MATCH_MP_TAC o
      GEN_REWRITE_RULE id [CONTINUOUS_ON_SEQUENTIALLY]) THEN
    ASM SET_TAC [])

  let FORALL_IN_INTERMEDIATE_CLOSURE_EQ ← prove
   r"!f s s' t.
         closed t /\ f continuous_on s' /\ s SUBSET s' /\ s' SUBSET closure s
         ==> ((!x. x IN s' ==> f x IN t) <=>
              (!x. x IN s ==> f x IN t))"
   (MESON_TAC [FORALL_IN_INTERMEDIATE_CLOSURE, SUBSET])

  let CONTINUOUS_LE_ON_INTERMEDIATE_CLOSURE ← do
    let lemma ← prove
     r"x IN s ==> f x <= a <=> x IN s ==> (lift o f) x IN {y | y$1 <= a}"
     (REWRITE_TAC [IN_ELIM_THM, o_THM, ← GSYM drop, LIFT_DROP])
    prove
     r"!f:real^M->real s s' a.
        (lift o f) continuous_on s' /\ s SUBSET s' /\ s' SUBSET closure s /\
        (!x. x IN s ==> f(x) <= a)
        ==> !x. x IN s' ==> f(x) <= a"
     (REWRITE_TAC [lemma] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
      MATCH_MP_TAC FORALL_IN_INTERMEDIATE_CLOSURE THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN
      ASM_REWRITE_TAC [ETA_AX, CLOSED_HALFSPACE_COMPONENT_LE])

  let CONTINUOUS_GE_ON_INTERMEDIATE_CLOSURE ← do
    let lemma ← prove
     r"x IN s ==> a <= f x <=> x IN s ==> (lift o f) x IN {y | y$1 >= a}"
     (REWRITE_TAC [IN_ELIM_THM, o_THM, ← GSYM drop, real_ge, LIFT_DROP])
    prove
     r"!f:real^M->real s s' a.
       (lift o f) continuous_on s' /\ s SUBSET s' /\ s' SUBSET closure s /\
        (!x. x IN s ==> a <= f(x))
        ==> !x. x IN s' ==> a <= f(x)"
     (REWRITE_TAC [lemma] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
      MATCH_MP_TAC FORALL_IN_INTERMEDIATE_CLOSURE THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN
      ASM_REWRITE_TAC [ETA_AX, CLOSED_HALFSPACE_COMPONENT_GE])

  let CONTINUOUS_CONSTANT_ON_INTERMEDIATE_CLOSURE ← prove
   r"!f:real^M->real^N s s' a.
        f continuous_on s' /\ s SUBSET s' /\ s' SUBSET closure s /\
        (!x. x IN s ==> f(x) = a)
        ==> !x. x IN s' ==> f(x) = a"
   (REWRITE_TAC [← SET_RULE
     (← q r"x IN s ==> f x = a <=> x IN s ==> f x IN {a}")] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC FORALL_IN_INTERMEDIATE_CLOSURE THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [CLOSED_SING])

  let CONTINUOUS_AGREE_ON_INTERMEDIATE_CLOSURE ← prove
   r"!g h:real^M->real^N s s'.
        g continuous_on s' /\ h continuous_on s' /\
        s SUBSET s' /\ s' SUBSET closure s /\
        (!x. x IN s ==> g x = h x)
        ==> !x. x IN s' ==> g x = h x"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_CONSTANT_ON_INTERMEDIATE_CLOSURE THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_SIMP_TAC [CONTINUOUS_ON_SUB])

  let FORALL_IN_CLOSURE ← prove
   r"!f:real^M->real^N s t.
        closed t /\ f continuous_on (closure s) /\
        (!x. x IN s ==> f x IN t)
        ==> (!x. x IN closure s ==> f x IN t)"
   (MESON_TAC [FORALL_IN_INTERMEDIATE_CLOSURE, CLOSURE_SUBSET, SUBSET_REFL])

  let FORALL_IN_CLOSURE_EQ ← prove
   r"!f s t.
         closed t /\ f continuous_on closure s
         ==> ((!x. x IN closure s ==> f x IN t) <=>
              (!x. x IN s ==> f x IN t))"
   (MESON_TAC [FORALL_IN_CLOSURE, CLOSURE_SUBSET, SUBSET])

  let SUP_CLOSURE ← prove
   r"!s. sup(IMAGE drop (closure s)) = sup(IMAGE drop s)"
   (GEN_TAC THEN MATCH_MP_TAC SUP_EQ THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN GEN_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"drop x <= b <=> x IN {x | drop x <= b}")] THEN
    MATCH_MP_TAC FORALL_IN_CLOSURE_EQ THEN
    REWRITE_TAC [CONTINUOUS_ON_ID, drop, CLOSED_HALFSPACE_COMPONENT_LE])

  let INF_CLOSURE ← prove
   r"!s. inf(IMAGE drop (closure s)) = inf(IMAGE drop s)"
   (GEN_TAC THEN MATCH_MP_TAC INF_EQ THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN GEN_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"b <= drop x <=> x IN {x | b <= drop x}")] THEN
    MATCH_MP_TAC FORALL_IN_CLOSURE_EQ THEN
    REWRITE_TAC [CONTINUOUS_ON_ID, drop, CLOSED_HALFSPACE_COMPONENT_GE,
                 ← GSYM real_ge])

  let CONTINUOUS_LE_ON_CLOSURE ← prove
   r"!f:real^M->real s a.
        (lift o f) continuous_on closure(s) /\ (!x. x IN s ==> f(x) <= a)
        ==> !x. x IN closure(s) ==> f(x) <= a"
   (MESON_TAC [CONTINUOUS_LE_ON_INTERMEDIATE_CLOSURE,
               CLOSURE_SUBSET, SUBSET_REFL])

  let CONTINUOUS_GE_ON_CLOSURE ← prove
   r"!f:real^M->real s a.
        (lift o f) continuous_on closure(s) /\ (!x. x IN s ==> a <= f(x))
        ==> !x. x IN closure(s) ==> a <= f(x)"
   (MESON_TAC [CONTINUOUS_GE_ON_INTERMEDIATE_CLOSURE,
               CLOSURE_SUBSET, SUBSET_REFL])

  let CONTINUOUS_CONSTANT_ON_CLOSURE ← prove
   r"!f:real^M->real^N s a.
        f continuous_on closure(s) /\ (!x. x IN s ==> f(x) = a)
        ==> !x. x IN closure(s) ==> f(x) = a"
   (MESON_TAC [CONTINUOUS_CONSTANT_ON_INTERMEDIATE_CLOSURE,
               CLOSURE_SUBSET, SUBSET_REFL])

  let CONTINUOUS_AGREE_ON_CLOSURE ← prove
   r"!g h:real^M->real^N.
        g continuous_on closure s /\ h continuous_on closure s /\
        (!x. x IN s ==> g x = h x)
        ==> !x. x IN closure s ==> g x = h x"
   (MESON_TAC [CONTINUOUS_AGREE_ON_INTERMEDIATE_CLOSURE,
               CLOSURE_SUBSET, SUBSET_REFL])

  let CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT ← prove
   r"!f:real^M->real^N s a.
        f continuous_on s
        ==> closed_in (subtopology euclidean s) {x | x IN s /\ f x = a}"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN s /\ f(x) = a} = {x | x IN s /\ f(x) IN {a}}")] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
    ASM_REWRITE_TAC [CLOSED_SING])

  let CONTINUOUS_CLOSED_PREIMAGE_CONSTANT ← prove
   r"!f:real^M->real^N s.
      f continuous_on s /\ closed s ==> closed {x | x IN s /\ f(x) = a}"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"{x | x IN s /\ (f:real^M->real^N)(x) = a} = {}") THEN
    ASM_REWRITE_TAC [CLOSED_EMPTY] THEN ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN s /\ f(x) = a} = {x | x IN s /\ f(x) IN {a}}")] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE THEN
    ASM_REWRITE_TAC [CLOSED_SING] THEN ASM SET_TAC [])

  return { FORALL_IN_INTERMEDIATE_CLOSURE, FORALL_IN_INTERMEDIATE_CLOSURE_EQ,
           CONTINUOUS_LE_ON_INTERMEDIATE_CLOSURE, CONTINUOUS_GE_ON_INTERMEDIATE_CLOSURE,
           CONTINUOUS_CONSTANT_ON_INTERMEDIATE_CLOSURE, CONTINUOUS_AGREE_ON_INTERMEDIATE_CLOSURE,
           FORALL_IN_CLOSURE, FORALL_IN_CLOSURE_EQ, SUP_CLOSURE, INF_CLOSURE,
           CONTINUOUS_LE_ON_CLOSURE, CONTINUOUS_GE_ON_CLOSURE, CONTINUOUS_CONSTANT_ON_CLOSURE,
           CONTINUOUS_AGREE_ON_CLOSURE, CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT,
           CONTINUOUS_CLOSED_PREIMAGE_CONSTANT }

/- ------------------------------------------------------------------------- -/
/- Continuity and uniform continuity relative to closures; continuity      -/
/- properties for square roots.  (topology.ml 10063-10231)                   -/
/- ------------------------------------------------------------------------- -/

structure CUC where
  CONTINUOUS_ON_INTERMEDIATE_CLOSURE : thm
  CONTINUOUS_ON_INTERMEDIATE_CLOSURE_EQ : thm
  CONTINUOUS_ON_CLOSURE : thm
  CONTINUOUS_ON_CLOSURE_SEQUENTIALLY : thm
  CONTINUOUS_ON_INTERMEDIATE_CLOSURE_POINTWISE : thm
  FUNCTION_EXTENSION_POINTWISE : thm
  FUNCTION_EXTENSION_POINTWISE_ALT : thm
  UNIFORMLY_CONTINUOUS_ON_CLOSURE : thm
  CONTINUOUS_ON_LIFT_SQRT : thm
  CONTINUOUS_AT_SQRT : thm
  CONTINUOUS_WITHIN_LIFT_SQRT : thm
  CONTINUOUS_WITHIN_SQRT_COMPOSE : thm
  CONTINUOUS_AT_SQRT_COMPOSE : thm
  CONTINUOUS_ON_LIFT_SQRT_COMPOSE : thm
  deriving Inhabited

@[nospecialize]
def setupCUC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCWL : CWL) (BCLS1 : CLS1) (BNET : NET)
    (BLIM1 : LIM1) (BLIM2 : LIM2) (BUNQ : UNQ) (BCNT1 : CNT1) (BCNO : CNO) (BCSL : CSL)
    (BSQC : SQC) (BIDC : IDC) : ExceptT String IO CUC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_IMP, .. } := D.core2
  let { IN_UNIV, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_EMPTY, SUBSET_REFL, .. } := D.core5
  let { o_DEF, .. } := D.core6
  let { LIFT_DROP, .. } := D.vec2
  let { CONTINUOUS_MAP_EXTENSION_POINTWISE, CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT,
        CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF,
        CONTINUOUS_MAP_SQUARE_ROOT, .. } := D.met1
  let { EVENTUALLY_TRUE, EVENTUALLY_WITHIN_IMP, LIMIT_SUBTOPOLOGY, MTOPOLOGY_SUBMETRIC, .. } :=
    D.met2
  let { REGULAR_SPACE_SUBTOPOLOGY, UNIFORMLY_CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE, .. } := D.met3
  let { MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_UNIV, REGULAR_SPACE_EUCLIDEAN, .. } := BEUC
  let { CONTINUOUS_MAP_DROP_EQ, CONTINUOUS_MAP_EQ_LIFT, .. } := BCWL
  let { CLOSURE_EMPTY, CLOSURE_SUBSET, EUCLIDEAN_CLOSURE_OF, .. } := BCLS1
  let { WITHIN_UNIV, «at», .. } := BNET
  let { LIMIT_EUCLIDEAN, LIM_TRIVIAL, .. } := BLIM1
  let { LIM_SELF_WITHIN, LIM_WITHIN_SUBSET, .. } := BLIM2
  let { LIM_IN_CLOSED_SET, .. } := BUNQ
  let { CONTINUOUS_AT_WITHIN, continuous_within, .. } := BCNT1
  let { CONTINUOUS_MAP_EUCLIDEAN, CONTINUOUS_MAP_EUCLIDEAN2, UNIFORMLY_CONTINUOUS_MAP_EUCLIDEAN,
        .. } := BCNO
  let { CONTINUOUS_ON, CONTINUOUS_ON_EMPTY, CONTINUOUS_ON_EQ_CONTINUOUS_AT, .. } := BCSL
  let { CONTINUOUS_WITHIN_SEQUENTIALLY, .. } := BSQC
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_WITHIN_COMPOSE, .. } := BIDC
  -- @@SCOPE END

  let CONTINUOUS_ON_INTERMEDIATE_CLOSURE ← prove
   r"!f:real^M->real^N s t.
        t SUBSET closure s /\
        (!x. x IN t ==> (f --> f x) (at x within s))
        ==> f continuous_on t"
   (MP_TAC (← ISPECL [← q r"euclidean:(real^M)topology", ← q r"euclidean:(real^N)topology"]
      CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF) THEN
    REWRITE_TAC [REGULAR_SPACE_EUCLIDEAN, EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN, LIMIT_EUCLIDEAN, «at»])

  let CONTINUOUS_ON_INTERMEDIATE_CLOSURE_EQ ← prove
   r"!f:real^M->real^N s t.
        s SUBSET t /\ t SUBSET closure s
        ==> (f continuous_on t <=>
             !x. x IN t ==> (f --> f x) (at x within s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [CONTINUOUS_ON] THEN ASM_MESON_TAC [LIM_WITHIN_SUBSET],
      ASM_MESON_TAC [CONTINUOUS_ON_INTERMEDIATE_CLOSURE]])

  let CONTINUOUS_ON_CLOSURE ← prove
   r"!f:real^M->real^N s.
        f continuous_on closure s <=>
        !x e. x IN closure s /\ &0 < e
              ==> ?d. &0 < d /\
                      !y. y IN s /\ dist(y,x) < d ==> dist(f y,f x) < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM LIM_SELF_WITHIN] THEN
    MATCH_MP_TAC CONTINUOUS_ON_INTERMEDIATE_CLOSURE_EQ THEN
    REWRITE_TAC [CLOSURE_SUBSET, SUBSET_REFL])

  let CONTINUOUS_ON_CLOSURE_SEQUENTIALLY ← prove
   r"!f:real^M->real^N s.
        f continuous_on closure s <=>
        !x a. a IN closure s /\ (!n. x n IN s) /\ (x --> a) sequentially
              ==> ((f o x) --> f a) sequentially"
   (REWRITE_TAC [CONTINUOUS_ON_CLOSURE] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM continuous_within] THEN
    REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY] THEN MESON_TAC [])

  let CONTINUOUS_ON_INTERMEDIATE_CLOSURE_POINTWISE ← prove
   r"!f:real^M->real^N s t.
        s SUBSET t /\ t SUBSET closure s /\
        (!x. x IN t ==> f continuous_on (x INSERT s))
        ==> f continuous_on t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_INTERMEDIATE_CLOSURE THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [FORALL_IN_INSERT, CONTINUOUS_ON]) THEN
    ASM_MESON_TAC [LIM_WITHIN_SUBSET, ← SET_RULE (← q r"s SUBSET x INSERT s")])

  let FUNCTION_EXTENSION_POINTWISE ← prove
   r"!f:real^M->real^N s t u.
        s SUBSET t /\ t SUBSET closure s /\
        (!x. x IN t ==> ?g. g continuous_on (x INSERT s) /\
                            IMAGE g (x INSERT s) SUBSET u /\
                            (!x. x IN s ==> g x = f x))
        ==> ?g. g continuous_on t /\
                IMAGE g t SUBSET u /\
                (!x. x IN s ==> g x = f x)"
   (REPEAT GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"euclidean:(real^M)topology", ← q r"subtopology euclidean (u:real^N->bool)"]
     CONTINUOUS_MAP_EXTENSION_POINTWISE) THEN
    SIMP_TAC [REGULAR_SPACE_EUCLIDEAN, REGULAR_SPACE_SUBTOPOLOGY] THEN
    SIMP_TAC [CONTINUOUS_MAP_EUCLIDEAN2, EUCLIDEAN_CLOSURE_OF, CONJ_ASSOC])

  let FUNCTION_EXTENSION_POINTWISE_ALT ← prove
   r"!f:real^M->real^N s t u.
        s SUBSET t /\ t SUBSET closure s /\ closed u /\
        f continuous_on s /\ IMAGE f s SUBSET u /\
        (!x. x IN t DIFF s ==> ?l. (f --> l) (at x within s))
        ==> ?g. g continuous_on t /\
                IMAGE g t SUBSET u /\
                (!x. x IN s ==> g x = f x)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"u:real^N->bool = {}") THENL
     [ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
      ASM_SIMP_TAC [SUBSET_EMPTY, IMAGE_EQ_EMPTY, CLOSURE_EMPTY] THEN
      REWRITE_TAC [NOT_IN_EMPTY, CONTINUOUS_ON_EMPTY],
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN STRIP_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"euclidean:(real^M)topology", ← q r"subtopology euclidean (u:real^N->bool)"]
     CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT) THEN
    SIMP_TAC [REGULAR_SPACE_EUCLIDEAN, REGULAR_SPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [LIMIT_EUCLIDEAN, ← GSYM «at», LIMIT_SUBTOPOLOGY] THEN
    REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2, EUCLIDEAN_CLOSURE_OF, CONJ_ASSOC] THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_REWRITE_TAC [EVENTUALLY_WITHIN_IMP, EVENTUALLY_TRUE] THEN
    ASM_CASES_TAC (← q r"trivial_limit(at (x:real^M) within s)") THENL
     [ASM_MESON_TAC [LIM_TRIVIAL], MATCH_MP_TAC MONO_EXISTS] THEN
    GEN_TAC THEN SIMP_TAC [] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] (← REWRITE_RULE [CONJ_ASSOC]
          LIM_IN_CLOSED_SET)) THEN
    ASM_SIMP_TAC [EVENTUALLY_WITHIN_IMP, EVENTUALLY_TRUE])

  let UNIFORMLY_CONTINUOUS_ON_CLOSURE ← prove
   r"!f:real^M->real^N s.
        f uniformly_continuous_on s /\ f continuous_on closure s
        ==> f uniformly_continuous_on closure s"
   (REWRITE_TAC [← GSYM UNIFORMLY_CONTINUOUS_MAP_EUCLIDEAN] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC UNIFORMLY_CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN
    ASM_REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_EUCLIDEAN, SUBSET_REFL,
                     EUCLIDEAN_CLOSURE_OF, SUBSET_REFL, CLOSURE_SUBSET,
                     MTOPOLOGY_SUBMETRIC, MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN])

  let CONTINUOUS_ON_LIFT_SQRT ← prove
   r"!s. (lift o sqrt o drop) continuous_on s"
   (GEN_TAC THEN REWRITE_TAC [← GSYM CONTINUOUS_MAP_EUCLIDEAN] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
    REWRITE_TAC [← GSYM CONTINUOUS_MAP_EQ_LIFT,
                 ← GSYM CONTINUOUS_MAP_DROP_EQ] THEN
    REWRITE_TAC [CONTINUOUS_MAP_SQUARE_ROOT])

  let CONTINUOUS_AT_SQRT ← prove
   r"!a. (lift o sqrt o drop) continuous (at a)"
   (GEN_TAC THEN MP_TAC (← SPEC (← q r"(:real^1)") CONTINUOUS_ON_LIFT_SQRT) THEN
    SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_UNIV, IN_UNIV])

  let CONTINUOUS_WITHIN_LIFT_SQRT ← prove
   r"!a s. (lift o sqrt o drop) continuous (at a within s)"
   (SIMP_TAC [CONTINUOUS_AT_WITHIN, CONTINUOUS_AT_SQRT])

  let CONTINUOUS_WITHIN_SQRT_COMPOSE ← prove
   r"!f s a:real^N.
        (\x. lift(f x)) continuous (at a within s)
        ==> (\x. lift(sqrt(f x))) continuous (at a within s)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\x:real^N. lift(sqrt(f x))) = (lift o sqrt o drop) o (lift o f)")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF, LIFT_DROP], ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_WITHIN_COMPOSE THEN
    REWRITE_TAC [CONTINUOUS_WITHIN_LIFT_SQRT] THEN
    ASM_REWRITE_TAC [o_DEF])

  let CONTINUOUS_AT_SQRT_COMPOSE ← prove
   r"!f a:real^N.
        (\x. lift(f x)) continuous (at a)
        ==> (\x. lift(sqrt(f x))) continuous (at a)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real", ← q r"(:real^N)", ← q r"a:real^N"]
          CONTINUOUS_WITHIN_SQRT_COMPOSE) THEN
    REWRITE_TAC [WITHIN_UNIV, IN_UNIV])

  let CONTINUOUS_ON_LIFT_SQRT_COMPOSE ← prove
   r"!f:real^N->real s.
        (lift o f) continuous_on s
        ==> (\x. lift(sqrt(f x))) continuous_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\x:real^N. lift(sqrt(f x))) = (lift o sqrt o drop) o (lift o f)")
    SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF, LIFT_DROP],
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [CONTINUOUS_ON_LIFT_SQRT]])

  return { CONTINUOUS_ON_INTERMEDIATE_CLOSURE, CONTINUOUS_ON_INTERMEDIATE_CLOSURE_EQ,
           CONTINUOUS_ON_CLOSURE, CONTINUOUS_ON_CLOSURE_SEQUENTIALLY,
           CONTINUOUS_ON_INTERMEDIATE_CLOSURE_POINTWISE, FUNCTION_EXTENSION_POINTWISE,
           FUNCTION_EXTENSION_POINTWISE_ALT, UNIFORMLY_CONTINUOUS_ON_CLOSURE,
           CONTINUOUS_ON_LIFT_SQRT, CONTINUOUS_AT_SQRT, CONTINUOUS_WITHIN_LIFT_SQRT,
           CONTINUOUS_WITHIN_SQRT_COMPOSE, CONTINUOUS_AT_SQRT_COMPOSE,
           CONTINUOUS_ON_LIFT_SQRT_COMPOSE }

/- ------------------------------------------------------------------------- -/
/- Cauchy continuity, and the extension of functions to closures.          -/
/- (topology.ml 10232-10421)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CCE where
  UNIFORMLY_CONTINUOUS_IMP_CAUCHY_CONTINUOUS : thm
  CONTINUOUS_CLOSED_IMP_CAUCHY_CONTINUOUS : thm
  CAUCHY_CONTINUOUS_EXTENDS_TO_CLOSURE : thm
  UNIFORMLY_CONTINUOUS_EXTENDS_TO_CLOSURE : thm
  CAUCHY_CONTINUOUS_IMP_CONTINUOUS : thm
  BOUNDED_UNIFORMLY_CONTINUOUS_IMAGE : thm
  LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_ON : thm
  BOUNDED_LIPSCHITZ_IMAGE : thm
  LIPSCHITZ_IMP_CONTINUOUS_ON : thm
  LIPSCHITZ_LIM : thm
  LIPSCHITZ_ON_SUP : thm
  LIPSCHITZ_ON_INF : thm
  deriving Inhabited

@[nospecialize]
def setupCCE [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLS1 : CLS1) (BLIM1 : LIM1)
    (BBND1 : BND1) (BCPT : CPT) (BCMP : CMP) (BCNO : CNO) (BCSL : CSL) (BSQC : SQC)
    (BLCP : LCP) (BECF : ECF) (BCUC : CUC) : ExceptT String IO CCE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { FORALL_IN_GSPEC, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INF, .. } := D.core2
  let { LE_REFL, MONO_EXISTS, REAL_ADD_RDISTRIB, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_REFL, REAL_LE_RMUL,
        REAL_LE_SUB_RADD, REAL_LE_TRANS, REAL_LE_TRANS_LTE, REAL_LT_DIV, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_SUB_LT, .. } := D.core5
  let { SUP, o_DEF, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DROP_SUB, .. } := D.vec1
  let { LIFT_DROP, LIPSCHITZ_ON_POS, .. } := D.vec2
  let { NORM_0, NORM_1, NORM_POS_LE, NORM_POS_LT, .. } := D.vec3
  let { VECTOR_SUB_EQ, VECTOR_SUB_REFL, dist, .. } := D.vec4
  let { CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CONTINUOUS_CLOSURE_OF, CAUCHY_IN_SUBMETRIC, .. } := D.met1
  let { EVENTUALLY_AND, EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { cauchy_continuous_map, .. } := D.met3
  let { MTOPOLOGY_EUCLIDEAN_METRIC, .. } := BEUC
  let { CLOSURE_SUBSET, EUCLIDEAN_CLOSURE_OF, .. } := BCLS1
  let { tendsto, .. } := BLIM1
  let { BOUNDED_SUBSET, .. } := BBND1
  let { COMPACT_CLOSURE, COMPACT_IMP_BOUNDED, .. } := BCPT
  let { CAUCHY_IN_EUCLIDEAN, COMPLETE_EQ_CLOSED, CONVERGENT_IMP_CAUCHY, MCOMPLETE_EUCLIDEAN,
        cauchy, complete, .. } := BCMP
  let { CONTINUOUS_MAP_EUCLIDEAN, uniformly_continuous_on, .. } := BCNO
  let { CONTINUOUS_ON_EQ, CONTINUOUS_ON_SUBSET, UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS,
        UNIFORMLY_CONTINUOUS_ON_EQ, .. } := BCSL
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  let { COMPACT_CONTINUOUS_IMAGE, .. } := BLCP
  let { CONTINUOUS_AGREE_ON_CLOSURE, .. } := BECF
  let { UNIFORMLY_CONTINUOUS_ON_CLOSURE, .. } := BCUC
  -- @@SCOPE END

  let UNIFORMLY_CONTINUOUS_IMP_CAUCHY_CONTINUOUS ← prove
   r"!f:real^M->real^N s.
        f uniformly_continuous_on s
        ==> (!x. cauchy x /\ (!n. (x n) IN s) ==> cauchy(f o x))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [uniformly_continuous_on, cauchy, o_DEF] THEN
    MESON_TAC [])

  let CONTINUOUS_CLOSED_IMP_CAUCHY_CONTINUOUS ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ closed s
        ==> (!x. cauchy x /\ (!n. (x n) IN s) ==> cauchy(f o x))"
   (REWRITE_TAC [← GSYM COMPLETE_EQ_CLOSED, CONTINUOUS_ON_SEQUENTIALLY] THEN
    REWRITE_TAC [complete] THEN MESON_TAC [CONVERGENT_IMP_CAUCHY])

  let CAUCHY_CONTINUOUS_EXTENDS_TO_CLOSURE ← prove
   r"!f:real^M->real^N s.
        (!x. cauchy x /\ (!n. (x n) IN s) ==> cauchy(f o x))
        ==> ?g. g continuous_on closure s /\ (!x. x IN s ==> g x = f x)"
   (MP_TAC (← ISPECL
     [← q r"euclidean_metric:(real^M)metric", ← q r"euclidean_metric:(real^N)metric"]
          CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CONTINUOUS_CLOSURE_OF) THEN
    REWRITE_TAC [MCOMPLETE_EUCLIDEAN, cauchy_continuous_map, CAUCHY_IN_SUBMETRIC,
                 CAUCHY_IN_EUCLIDEAN, MTOPOLOGY_EUCLIDEAN_METRIC,
                 EUCLIDEAN_CLOSURE_OF, CONTINUOUS_MAP_EUCLIDEAN] THEN
    MESON_TAC [])

  let UNIFORMLY_CONTINUOUS_EXTENDS_TO_CLOSURE ← prove
   r"!f:real^M->real^N s.
   f uniformly_continuous_on s
   ==> ?g. g uniformly_continuous_on closure s /\ (!x. x IN s ==> g x = f x) /\
           !h. h continuous_on closure s /\ (!x. x IN s ==> h x = f x)
               ==> !x. x IN closure s ==> h x = g x"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CAUCHY_CONTINUOUS_EXTENDS_TO_CLOSURE o
     MATCH_MP UNIFORMLY_CONTINUOUS_IMP_CAUCHY_CONTINUOUS) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^M->real^N") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [UNIFORMLY_CONTINUOUS_ON_CLOSURE, UNIFORMLY_CONTINUOUS_ON_EQ],
      ASM_MESON_TAC [CONTINUOUS_AGREE_ON_CLOSURE]])

  let CAUCHY_CONTINUOUS_IMP_CONTINUOUS ← prove
   r"!f:real^M->real^N s.
        (!x. cauchy x /\ (!n. (x n) IN s) ==> cauchy(f o x))
        ==> f continuous_on s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (CHOOSE_TAC o MATCH_MP CAUCHY_CONTINUOUS_EXTENDS_TO_CLOSURE) THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, CLOSURE_SUBSET, CONTINUOUS_ON_EQ])

  let BOUNDED_UNIFORMLY_CONTINUOUS_IMAGE ← prove
   r"!f:real^M->real^N s.
        f uniformly_continuous_on s /\ bounded s ==> bounded(IMAGE f s)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM
     (MP_TAC o MATCH_MP UNIFORMLY_CONTINUOUS_EXTENDS_TO_CLOSURE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN
    EXISTS_TAC (← q r"IMAGE (g:real^M->real^N) (closure s)") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [COMPACT_CLOSURE, UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS,
                     COMPACT_IMP_BOUNDED, COMPACT_CONTINUOUS_IMAGE],
      MP_TAC (← ISPEC (← q r"s:real^M->bool") CLOSURE_SUBSET) THEN ASM SET_TAC []])

  let LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N s.
        (?B. !x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y))
        ==> f uniformly_continuous_on s"
   (ONCE_REWRITE_TAC [LIPSCHITZ_ON_POS] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [uniformly_continuous_on, dist] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"e / B:real") THEN ASM_SIMP_TAC [REAL_LT_DIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"y:real^M", ← q r"x:real^M"]) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ])

  let BOUNDED_LIPSCHITZ_IMAGE ← prove
   r"!f:real^M->real^N s.
        (?B. !x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y)) /\
        bounded s
        ==> bounded (IMAGE f s)"
   (MESON_TAC [BOUNDED_UNIFORMLY_CONTINUOUS_IMAGE,
               LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_ON])

  let LIPSCHITZ_IMP_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N s.
        (?B. !x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y))
        ==> f continuous_on s"
   (SIMP_TAC [LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_ON,
              UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS])

  let LIPSCHITZ_LIM ← prove
   r"!f:num->real^M->real^N g s b.
      (!n x y. x IN s /\ y IN s ==> norm(f n x - f n y) <= b * norm(x - y)) /\
      (!x. x IN s ==> ((\n. f n x) --> g x) sequentially)
      ==> !x y. x IN s /\ y IN s ==> norm(g x - g y) <= b * norm(x - y)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"x:real^M = y") THEN
    ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, REAL_LE_REFL, REAL_MUL_RZERO] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
    GEN_REWRITE_TAC id [REAL_LE_TRANS_LTE] THEN
    X_GEN_TAC (← q r"c:real") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"y:real^M") th) THEN
            MP_TAC (← SPEC (← q r"x:real^M") th))) THEN
    ASM_REWRITE_TAC [tendsto, IMP_IMP, AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(c - b) / &2 * norm(x - y:real^M)")) THEN
    ASM_SIMP_TAC [REAL_SUB_LT, REAL_HALF, REAL_LT_MUL, NORM_POS_LT,
                  VECTOR_SUB_EQ, ← GSYM EVENTUALLY_AND] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
    REWRITE_TAC [LE_REFL] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"x:real^M", ← q r"y:real^M"]) THEN
    ASM_REWRITE_TAC [IMP_IMP] THEN
    MATCH_MP_TAC (← NORM_ARITH
     (← q r"a + &2 * b <= c
      ==> norm(fx - fy:real^N) <= a /\ dist(fx,gx) < b /\ dist(fy,gy) < b
          ==> norm(gx - gy) <= c")) THEN
    REWRITE_TAC [← GSYM REAL_ADD_RDISTRIB, REAL_MUL_ASSOC] THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
    ASM_REAL_ARITH_TAC)

  let LIPSCHITZ_ON_SUP ← prove
   r"!P:(real^N->real^1)->bool B s.
        &0 <= B /\
        (!f. P f
             ==> !x y. x IN s /\ y IN s
                       ==> norm(f x - f y) <= B * norm(x - y)) /\
        (!x. x IN s ==> ?C. !f. P f ==> drop(f x) <= C)
        ==> !x y. x IN s /\ y IN s
                  ==> norm(lift(sup {drop(f x) | P f}) -
                           lift(sup {drop(f y) | P f}))
                      <= B * norm(x - y)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"!f:real^N->real^1. ~(P f)") THENL
     [ASM_REWRITE_TAC [← SET_RULE (← q r"{f x | x | F} = {}"), VECTOR_SUB_REFL] THEN
      ASM_SIMP_TAC [NORM_0, REAL_LE_MUL, NORM_POS_LE],
      ALL_TAC] THEN
    MP_TAC (← SPEC (← q r"{drop(f(y:real^N)) | P f}") SUP) THEN
    MP_TAC (← SPEC (← q r"{drop(f(x:real^N)) | P f}") SUP) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    ABBREV_TAC (← q r"fy = sup {drop(f(y:real^N)) | P f}") THEN
    ABBREV_TAC (← q r"fx = sup {drop(f(x:real^N)) | P f}") THEN
    REPEAT (ANTS_TAC THENL [ASM SET_TAC [], STRIP_TAC]) THEN
    REWRITE_TAC [NORM_1, DROP_SUB, LIFT_DROP, ← REAL_ARITH
     (← q r"abs(x - y) <= b <=> x <= y + b /\ y <= x + b")] THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    X_GEN_TAC (← q r"f:real^N->real^1") THEN DISCH_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:real^N->real^1"))) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM REAL_LE_SUB_RADD] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
      (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS)) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [NORM_1, DROP_SUB] THEN REAL_ARITH_TAC)

  let LIPSCHITZ_ON_INF ← prove
   r"!P:(real^N->real^1)->bool B s.
        &0 <= B /\
        (!f. P f
             ==> !x y. x IN s /\ y IN s
                       ==> norm(f x - f y) <= B * norm(x - y)) /\
        (!x. x IN s ==> ?C. !f. P f ==> C <= drop(f x))
        ==> !x y. x IN s /\ y IN s
                  ==> norm(lift(inf {drop(f x) | P f}) -
                           lift(inf {drop(f y) | P f}))
                      <= B * norm(x - y)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"!f:real^N->real^1. ~(P f)") THENL
     [ASM_REWRITE_TAC [← SET_RULE (← q r"{f x | x | F} = {}"), VECTOR_SUB_REFL] THEN
      ASM_SIMP_TAC [NORM_0, REAL_LE_MUL, NORM_POS_LE],
      ALL_TAC] THEN
    MP_TAC (← SPEC (← q r"{drop(f(y:real^N)) | P f}") INF) THEN
    MP_TAC (← SPEC (← q r"{drop(f(x:real^N)) | P f}") INF) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    ABBREV_TAC (← q r"fy = inf {drop(f(y:real^N)) | P f}") THEN
    ABBREV_TAC (← q r"fx = inf {drop(f(x:real^N)) | P f}") THEN
    REPEAT (ANTS_TAC THENL [ASM SET_TAC [], STRIP_TAC]) THEN
    REWRITE_TAC [NORM_1, DROP_SUB, LIFT_DROP, ← REAL_ARITH
     (← q r"abs(x - y) <= b <=> x - b <= y /\ y - b <= x")] THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    X_GEN_TAC (← q r"f:real^N->real^1") THEN DISCH_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:real^N->real^1"))) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [REAL_LE_SUB_RADD] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
      (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS)) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [NORM_1, DROP_SUB] THEN REAL_ARITH_TAC)

  return { UNIFORMLY_CONTINUOUS_IMP_CAUCHY_CONTINUOUS, CONTINUOUS_CLOSED_IMP_CAUCHY_CONTINUOUS,
           CAUCHY_CONTINUOUS_EXTENDS_TO_CLOSURE, UNIFORMLY_CONTINUOUS_EXTENDS_TO_CLOSURE,
           CAUCHY_CONTINUOUS_IMP_CONTINUOUS, BOUNDED_UNIFORMLY_CONTINUOUS_IMAGE,
           LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_ON, BOUNDED_LIPSCHITZ_IMAGE,
           LIPSCHITZ_IMP_CONTINUOUS_ON, LIPSCHITZ_LIM, LIPSCHITZ_ON_SUP, LIPSCHITZ_ON_INF }

/- ------------------------------------------------------------------------- -/
/- Invariance properties; interior of an injective image; avoiding a value; -/
/- level sets.  (topology.ml 10422-10575)                                    -/
/- ------------------------------------------------------------------------- -/

structure INV where
  CONTINUOUS_AT_COMPOSE_EQ : thm
  CONTINUOUS_AT_TRANSLATION : thm
  CONTINUOUS_AT_LINEAR_IMAGE : thm
  INTERIOR_IMAGE_SUBSET : thm
  CONTINUOUS_WITHIN_AVOID : thm
  CONTINUOUS_AT_AVOID : thm
  CONTINUOUS_ON_AVOID : thm
  CONTINUOUS_ON_OPEN_AVOID : thm
  CONTINUOUS_LEVELSET_OPEN_IN_CASES : thm
  CONTINUOUS_LEVELSET_OPEN_IN : thm
  CONTINUOUS_LEVELSET_OPEN : thm
  deriving Inhabited

@[nospecialize]
def setupINV [HolBase] (D : TopologyDeps) (BLOC : LOC) (BCON : CON) (BINT : INT) (BNET : NET)
    (BCNT1 : CNT1) (BCSL : CSL) (BCMB : CMB) (BIDC : IDC) (BCLC : CLC) (BLCP : LCP)
    (BECF : ECF) : ExceptT String IO INV := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH_TAC, NORM_ARITH_TAC,
        add_linear_invariants, add_translation_invariants, .. } := D
  let { ETA_AX, .. } := D.core1
  let { IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { IN_UNIV, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP, .. } := D.core3
  let { SUBSET, .. } := D.core5
  let { o_ASSOC, o_DEF, .. } := D.core6
  let { NORM_POS_LT, .. } := D.vec3
  let { VECTOR_SUB_EQ, .. } := D.vec4
  let { ORTHOGONAL_TRANSFORMATION, ORTHOGONAL_TRANSFORMATION_INVERSE, .. } := D.det
  let { OPEN_IN_OPEN, .. } := BLOC
  let { CONNECTED_CLOPEN, .. } := BCON
  let { interior, .. } := BINT
  let { WITHIN_UNIV, .. } := BNET
  let { continuous_within, .. } := BCNT1
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  let { CONTINUOUS_ADD, CONTINUOUS_CONST, CONTINUOUS_SUB, .. } := BCMB
  let { CONTINUOUS_AT_COMPOSE, CONTINUOUS_AT_ID, .. } := BIDC
  let { CONTINUOUS_OPEN_PREIMAGE_UNIV, .. } := BCLC
  let { LINEAR_CONTINUOUS_AT, .. } := BLCP
  let { CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT, .. } := BECF
  -- @@SCOPE END

  let CONTINUOUS_AT_COMPOSE_EQ ← prove
   r"!f:real^M->real^N g:real^M->real^M h:real^M->real^M.
        g continuous at x /\ h continuous at (g x) /\
        (!y. g(h y) = y) /\ h(g x) = x
        ==> (f continuous at (g x) <=> (\x. f(g x)) continuous at x)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_AT_COMPOSE] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"((f:real^M->real^N) o (g:real^M->real^M) o (h:real^M->real^M))
       continuous at (g(x:real^M))")
    MP_TAC THENL
     [REWRITE_TAC [o_ASSOC] THEN MATCH_MP_TAC CONTINUOUS_AT_COMPOSE THEN
      ASM_REWRITE_TAC [o_DEF],
      ASM_REWRITE_TAC [o_DEF, ETA_AX]])

  let CONTINUOUS_AT_TRANSLATION ← prove
   r"!a z f:real^M->real^N.
      f continuous at (a + z) <=> (\x. f(a + x)) continuous at z"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC CONTINUOUS_AT_COMPOSE_EQ THEN
    EXISTS_TAC (← q r"\x:real^M. x - a") THEN
    SIMP_TAC [CONTINUOUS_ADD, CONTINUOUS_SUB,
              CONTINUOUS_AT_ID, CONTINUOUS_CONST] THEN
    VECTOR_ARITH_TAC)

  add_translation_invariants [CONTINUOUS_AT_TRANSLATION]

  let CONTINUOUS_AT_LINEAR_IMAGE ← prove
   r"!h:real^M->real^M z f:real^M->real^N.
        linear h /\ (!x. norm(h x) = norm x)
        ==> (f continuous at (h z) <=> (\x. f(h x)) continuous at z)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o GEN_REWRITE_RULE id
     [← GSYM ORTHOGONAL_TRANSFORMATION]) THEN
    FIRST_ASSUM (X_CHOOSE_TAC (← q r"g:real^M->real^M") o MATCH_MP
      ORTHOGONAL_TRANSFORMATION_INVERSE) THEN
    MATCH_MP_TAC CONTINUOUS_AT_COMPOSE_EQ THEN
    EXISTS_TAC (← q r"g:real^M->real^M") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ORTHOGONAL_TRANSFORMATION]) THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_AT])

  add_linear_invariants [CONTINUOUS_AT_LINEAR_IMAGE]

  let INTERIOR_IMAGE_SUBSET ← prove
   r"!f:real^M->real^N s.
       (!x. f continuous at x) /\ (!x y. f x = f y ==> x = y)
       ==> interior(IMAGE f s) SUBSET IMAGE f (interior s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET] THEN
    REWRITE_TAC [interior, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"y:real^N") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [IN_IMAGE, IN_ELIM_THM] THEN
    SUBGOAL_THEN (← q r"y IN IMAGE (f:real^M->real^N) s") MP_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [IN_IMAGE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
    EXISTS_TAC (← q r"{x | (f:real^M->real^N)(x) IN t}") THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_OPEN_PREIMAGE_UNIV THEN ASM_MESON_TAC [],
      ASM SET_TAC []])

  let CONTINUOUS_WITHIN_AVOID ← prove
   r"!f:real^M->real^N x s a.
        f continuous (at x within s) /\ x IN s /\  ~(f x = a)
        ==> ?e. &0 < e /\ !y. y IN s /\ dist(x,y) < e ==> ~(f y = a)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [continuous_within]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"norm((f:real^M->real^N) x - a)")) THEN
    ASM_REWRITE_TAC [NORM_POS_LT, VECTOR_SUB_EQ] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC MONO_FORALL THEN
    GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN SIMP_TAC [] THEN NORM_ARITH_TAC)

  let CONTINUOUS_AT_AVOID ← prove
   r"!f:real^M->real^N x a.
        f continuous (at x) /\ ~(f x = a)
        ==> ?e. &0 < e /\ !y. dist(x,y) < e ==> ~(f y = a)"
   (MP_TAC CONTINUOUS_WITHIN_AVOID THEN
    REPLICATE_TAC 2 (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(:real^M)")) THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    REWRITE_TAC [WITHIN_UNIV, IN_UNIV])

  let CONTINUOUS_ON_AVOID ← prove
   r"!f:real^M->real^N x s a.
        f continuous_on s /\ x IN s /\ ~(f x = a)
        ==> ?e. &0 < e /\ !y. y IN s /\ dist(x,y) < e ==> ~(f y = a)"
   (REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_WITHIN_AVOID THEN
    ASM_SIMP_TAC [])

  let CONTINUOUS_ON_OPEN_AVOID ← prove
   r"!f:real^M->real^N x s a.
        f continuous_on s /\ open s /\ x IN s /\ ~(f x = a)
        ==> ?e. &0 < e /\ !y. dist(x,y) < e ==> ~(f y = a)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"open(s:real^M->bool)") THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_AT_AVOID THEN
    ASM_SIMP_TAC [])

  let CONTINUOUS_LEVELSET_OPEN_IN_CASES ← prove
   r"!f:real^M->real^N s a.
        connected s /\
        f continuous_on s /\
        open_in (subtopology euclidean s) {x | x IN s /\ f x = a}
        ==> (!x. x IN s ==> ~(f x = a)) \/ (!x. x IN s ==> f x = a)"
   (REWRITE_TAC [← SET_RULE (← q r"(!x. x IN s ==> ~(f x = a)) <=>
                          {x | x IN s /\ f x = a} = {}"),
                 ← SET_RULE (← q r"(!x. x IN s ==> f x = a) <=>
                          {x | x IN s /\ f x = a} = s")] THEN
    REWRITE_TAC [CONNECTED_CLOPEN] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT])

  let CONTINUOUS_LEVELSET_OPEN_IN ← prove
   r"!f:real^M->real^N s a.
        connected s /\
        f continuous_on s /\
        open_in (subtopology euclidean s) {x | x IN s /\ f x = a} /\
        (?x. x IN s /\ f x = a)
        ==> (!x. x IN s ==> f x = a)"
   (MESON_TAC [CONTINUOUS_LEVELSET_OPEN_IN_CASES])

  let CONTINUOUS_LEVELSET_OPEN ← prove
   r"!f:real^M->real^N s a.
        connected s /\
        f continuous_on s /\
        open {x | x IN s /\ f x = a} /\
        (?x. x IN s /\ f x = a)
        ==> (!x. x IN s ==> f x = a)"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC CONTINUOUS_LEVELSET_OPEN_IN THEN
    ASM_REWRITE_TAC [OPEN_IN_OPEN] THEN
    EXISTS_TAC (← q r"{x | x IN s /\ (f:real^M->real^N) x = a}") THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  return { CONTINUOUS_AT_COMPOSE_EQ, CONTINUOUS_AT_TRANSLATION, CONTINUOUS_AT_LINEAR_IMAGE,
           INTERIOR_IMAGE_SUBSET, CONTINUOUS_WITHIN_AVOID, CONTINUOUS_AT_AVOID,
           CONTINUOUS_ON_AVOID, CONTINUOUS_ON_OPEN_AVOID, CONTINUOUS_LEVELSET_OPEN_IN_CASES,
           CONTINUOUS_LEVELSET_OPEN_IN, CONTINUOUS_LEVELSET_OPEN }

/- ------------------------------------------------------------------------- -/
/- Some arithmetical combinations (more to prove).  (topology.ml 10576-10664) -/
/- ------------------------------------------------------------------------- -/

structure ARC where
  OPEN_SCALING : thm
  OPEN_SCALING_EQ : thm
  OPEN_NEGATIONS : thm
  OPEN_TRANSLATION : thm
  OPEN_TRANSLATION_EQ : thm
  OPEN_AFFINITY_EQ : thm
  OPEN_AFFINITY : thm
  INTERIOR_TRANSLATION : thm
  OPEN_SUMS : thm
  deriving Inhabited

@[nospecialize]
def setupARC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BINT : INT) (BBND1 : BND1) (BCMB : CMB)
    (BIDC : IDC) (BCLC : CLC) : ExceptT String IO ARC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, REAL_ARITH, VECTOR_ARITH, VECTOR_ARITH_TAC, NORM_ARITH,
        add_translation_invariants, GEOM_TRANSLATE_TAC, .. } := D
  let { EQ_IMP, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_CONST, IMAGE_ID, IMAGE_o,
        IMP_CONJ_ALT, IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { IN_UNIV, MONO_EXISTS, REAL_ABS_INV, REAL_ABS_NZ, .. } := D.core3
  let { REAL_INV_EQ_0, REAL_LT_LDIV_EQ, REAL_LT_MUL, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_SYM, .. } := D.core5
  let { o_DEF, real_div, .. } := D.core6
  let { AFFINITY_SCALING_TRANSLATION, .. } := D.vec1
  let { NORM_MUL, .. } := D.vec3
  let { VECTOR_ADD_SYM, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_SUB_LDISTRIB,
        dist, .. } := D.vec4
  let { OPEN_EMPTY, open_def, .. } := BEUC
  let { interior, .. } := BINT
  let { NOT_OPEN_SING, .. } := BBND1
  let { CONTINUOUS_CONST, CONTINUOUS_SUB, .. } := BCMB
  let { CONTINUOUS_AT_ID, .. } := BIDC
  let { CONTINUOUS_OPEN_PREIMAGE_UNIV, .. } := BCLC
  -- @@SCOPE END

  let OPEN_SCALING ← prove
   r"!s:real^N->bool c. ~(c = &0) /\ open s ==> open(IMAGE (\x. c % x) s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_def, FORALL_IN_IMAGE] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"e * abs(c)") THEN ASM_SIMP_TAC [REAL_LT_MUL, ← GSYM REAL_ABS_NZ] THEN
    X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN REWRITE_TAC [IN_IMAGE] THEN
    EXISTS_TAC (← q r"inv(c) % y:real^N") THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, VECTOR_MUL_LID] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    SUBGOAL_THEN (← q r"x = inv(c) % c % x:real^N") SUBST1_TAC THENL
     [ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, VECTOR_MUL_LID],
      REWRITE_TAC [dist, ← GSYM VECTOR_SUB_LDISTRIB, NORM_MUL] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [REAL_ABS_INV] THEN
      ASM_SIMP_TAC [← GSYM real_div, REAL_LT_LDIV_EQ, ← GSYM REAL_ABS_NZ] THEN
      ASM_REWRITE_TAC [← GSYM dist]])

  let OPEN_SCALING_EQ ← prove
   r"!s:real^N->bool c.
        open(IMAGE (\x. c % x) s) <=> (c = &0 ==> s = {}) /\ open s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [OPEN_EMPTY, NOT_OPEN_SING],
      EQ_TAC THEN ASM_SIMP_TAC [OPEN_SCALING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP
        (← REWRITE_RULE [IMP_CONJ_ALT] OPEN_SCALING)) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, REAL_INV_EQ_0, IMAGE_ID]])

  let OPEN_NEGATIONS ← prove
   r"!s:real^N->bool. open s ==> open (IMAGE (--) s)"
   (SUBGOAL_THEN (← q r"(--) = \x:real^N. --(&1) % x")
     (fun th => tactic_of do
       pure (SIMP_TAC [th, OPEN_SCALING, ← REAL_ARITH (← q r"~(--(&1) = &0)")])) THEN
    REWRITE_TAC [FUN_EQ_THM] THEN VECTOR_ARITH_TAC)

  let OPEN_TRANSLATION ← prove
   r"!s a:real^N. open s ==> open(IMAGE (\x. a + x) s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x:real^N. x - a", ← q r"s:real^N->bool"]
           CONTINUOUS_OPEN_PREIMAGE_UNIV) THEN
    ASM_SIMP_TAC [CONTINUOUS_SUB, CONTINUOUS_AT_ID, CONTINUOUS_CONST] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE, IN_UNIV] THEN
    ASM_MESON_TAC [← VECTOR_ARITH (← q r"(a + x) - a = x:real^N"),
                   ← VECTOR_ARITH (← q r"a + (x - a) = x:real^N")])

  let OPEN_TRANSLATION_EQ ← prove
   r"!a s. open (IMAGE (\x:real^N. a + x) s) <=> open s"
   (REWRITE_TAC [open_def] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [OPEN_TRANSLATION_EQ]

  let OPEN_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        open(IMAGE (\x. m % x + c) s) <=> (m = &0 ==> s = {}) /\ open s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, OPEN_TRANSLATION_EQ,
                 OPEN_SCALING_EQ, IMAGE_o])

  let OPEN_AFFINITY ← prove
   r"!s m c:real^N.
        open s /\ (m = &0 ==> s = {}) ==> open(IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [OPEN_AFFINITY_EQ])

  let INTERIOR_TRANSLATION ← prove
   r"!a:real^N s.
    interior (IMAGE (\x. a + x) s) = IMAGE (\x. a + x) (interior s)"
   (REWRITE_TAC [interior] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [INTERIOR_TRANSLATION]

  let OPEN_SUMS ← prove
   r"!s t:real^N->bool.
        open s \/ open t ==> open {x + y | x IN s /\ y IN t}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_def] THEN STRIP_TAC THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")),
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N"))] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
    ASM_MESON_TAC [VECTOR_ADD_SYM, ← VECTOR_ARITH (← q r"(z - y) + y:real^N = z"),
                   ← NORM_ARITH (← q r"dist(z:real^N,x + y) < e ==> dist(z - y,x) < e")])

  return { OPEN_SCALING, OPEN_SCALING_EQ, OPEN_NEGATIONS, OPEN_TRANSLATION,
           OPEN_TRANSLATION_EQ, OPEN_AFFINITY_EQ, OPEN_AFFINITY, INTERIOR_TRANSLATION,
           OPEN_SUMS }

/- ------------------------------------------------------------------------- -/
/- Upper and lower hemicontinuous functions.  (topology.ml 10665-10855)      -/
/- ------------------------------------------------------------------------- -/

structure HEM where
  UPPER_HEMICONTINUOUS : thm
  LOWER_HEMICONTINUOUS : thm
  OPEN_MAP_IFF_LOWER_HEMICONTINUOUS_PREIMAGE : thm
  CLOSED_MAP_IFF_UPPER_HEMICONTINUOUS_PREIMAGE : thm
  UPPER_LOWER_HEMICONTINUOUS_EXPLICIT : thm
  deriving Inhabited

@[nospecialize]
def setupHEM [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLOC : LOC)
    (BCLS1 : CLS1) (BCPT : CPT) (BARC : ARC) : ExceptT String IO HEM := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, VECTOR_ARITH, .. } := D
  let { CONJ_SYM, EQ_IMP, EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, INTERS_GSPEC, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_IMP, .. } := D.core3
  let { REAL_LT_MIN, .. } := D.core4
  let { SIMPLE_IMAGE, SUBSET, SUBSET_INTER, SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.core5
  let { UNIONS_IMAGE, UNWIND_THM1, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_0, DIST_SYM, DIST_TRIANGLE_HALF_L, .. } := D.vec1
  let { VECTOR_ADD_RID, dist, .. } := D.vec4
  let { CLOSED_IN_DIFF, CLOSED_IN_IMP_SUBSET, .. } := D.met1
  let { OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, OPEN_IN_INTERS, closed_in, .. } :=
    D.met3
  let { OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_IN_REFL, .. } := BCLO
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, .. } := BBAL
  let { OPEN_IN_OPEN_INTER, open_in, .. } := BLOC
  let { CLOSURE_APPROACHABLE, CLOSURE_SUBSET, .. } := BCLS1
  let { COMPACT_CLOSURE, COMPACT_EQ_HEINE_BOREL, .. } := BCPT
  let { OPEN_SUMS, .. } := BARC
  -- @@SCOPE END

  let UPPER_HEMICONTINUOUS ← prove
   r"!f:real^M->real^N->bool t s.
        (!x. x IN s ==> f(x) SUBSET t)
        ==> ((!u. open_in (subtopology euclidean t) u
                  ==> open_in (subtopology euclidean s)
                              {x | x IN s /\ f(x) SUBSET u}) <=>
             (!u. closed_in (subtopology euclidean t) u
                  ==> closed_in (subtopology euclidean s)
                                {x | x IN s /\ ~(f(x) INTER u = {})}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t DIFF u:real^N->bool")) THEN
    MATCH_MP_TAC MONO_IMP THEN
    SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_DIFF, OPEN_IN_REFL, CLOSED_IN_REFL] THENL
     [REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ], REWRITE_TAC [closed_in]] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_RESTRICT] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let LOWER_HEMICONTINUOUS ← prove
   r"!f:real^M->real^N->bool t s.
        (!x. x IN s ==> f(x) SUBSET t)
        ==> ((!u. closed_in (subtopology euclidean t) u
                  ==> closed_in (subtopology euclidean s)
                                {x | x IN s /\ f(x) SUBSET u}) <=>
             (!u. open_in (subtopology euclidean t) u
                  ==> open_in (subtopology euclidean s)
                              {x | x IN s /\ ~(f(x) INTER u = {})}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t DIFF u:real^N->bool")) THEN
    MATCH_MP_TAC MONO_IMP THEN
    SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_DIFF, OPEN_IN_REFL, CLOSED_IN_REFL] THENL
     [REWRITE_TAC [closed_in], REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ]] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_RESTRICT] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let OPEN_MAP_IFF_LOWER_HEMICONTINUOUS_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s SUBSET t
        ==> ((!u. open_in (subtopology euclidean s) u
                  ==> open_in (subtopology euclidean t) (IMAGE f u)) <=>
             (!u. closed_in (subtopology euclidean s) u
                      ==> closed_in (subtopology euclidean t)
                                    {y | y IN t /\
                                         {x | x IN s /\ f x = y} SUBSET u}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"v:real^M->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s DIFF v:real^M->bool")) THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL] THEN
      REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"v:real^M->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s DIFF v:real^M->bool")) THEN
      ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_REFL] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      DISCH_THEN (fun th => CONJ_TAC THENL [ASM SET_TAC [], MP_TAC th]) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let CLOSED_MAP_IFF_UPPER_HEMICONTINUOUS_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s SUBSET t
        ==> ((!u. closed_in (subtopology euclidean s) u
                  ==> closed_in (subtopology euclidean t) (IMAGE f u)) <=>
             (!u. open_in (subtopology euclidean s) u
                  ==> open_in (subtopology euclidean t)
                              {y | y IN t /\
                                   {x | x IN s /\ f x = y} SUBSET u}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"v:real^M->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s DIFF v:real^M->bool")) THEN
      ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_REFL] THEN
      REWRITE_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"v:real^M->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s DIFF v:real^M->bool")) THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
      REWRITE_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      DISCH_THEN (fun th => CONJ_TAC THENL [ASM SET_TAC [], MP_TAC th]) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let UPPER_LOWER_HEMICONTINUOUS_EXPLICIT ← prove
   r"!f:real^M->real^N->bool t s.
      (!x. x IN s ==> f(x) SUBSET t) /\
      (!u. open_in (subtopology euclidean t) u
           ==> open_in (subtopology euclidean s)
                       {x | x IN s /\ f(x) SUBSET u}) /\
      (!u. closed_in (subtopology euclidean t) u
           ==> closed_in (subtopology euclidean s)
                         {x | x IN s /\ f(x) SUBSET u})
      ==> !x e. x IN s /\ &0 < e /\ bounded(f x) /\ ~(f x = {})
                ==> ?d. &0 < d /\
                        !x'. x' IN s /\ dist(x,x') < d
                             ==> (!y. y IN f x
                                      ==> ?y'. y' IN f x' /\ dist(y,y') < e) /\
                                 (!y'. y' IN f x'
                                       ==> ?y. y IN f x /\ dist(y',y) < e)"
   (REPEAT STRIP_TAC THEN
    UNDISCH_TAC
     (← q r"!u. open_in (subtopology euclidean t) u
          ==> open_in (subtopology euclidean s)
                      {x | x IN s /\ (f:real^M->real^N->bool)(x) SUBSET u}") THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"t INTER
      {a + b | a IN (f:real^M->real^N->bool) x /\ b IN ball(vec 0,e)}")) THEN
    SIMP_TAC [OPEN_SUMS, OPEN_BALL, OPEN_IN_OPEN_INTER] THEN
    REWRITE_TAC [open_in, SUBSET_RESTRICT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
    ASM_SIMP_TAC [IN_ELIM_THM, SUBSET_INTER] THEN ANTS_TAC THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      ASM_MESON_TAC [CENTRE_IN_BALL, VECTOR_ADD_RID],
      DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "1")))] THEN
    UNDISCH_TAC
     (← q r"!u. closed_in (subtopology euclidean t) u
          ==> closed_in (subtopology euclidean s)
                      {x | x IN s /\ (f:real^M->real^N->bool)(x) SUBSET u}") THEN
    ASM_SIMP_TAC [LOWER_HEMICONTINUOUS] THEN DISCH_THEN (MP_TAC o
      GEN (← q r"a:real^N") o SPEC (← q r"t INTER ball(a:real^N,e / &2)")) THEN
    SIMP_TAC [OPEN_BALL, OPEN_IN_OPEN_INTER] THEN
    MP_TAC (← SPEC (← q r"closure((f:real^M->real^N->bool) x)")
      COMPACT_EQ_HEINE_BOREL) THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE] THEN DISCH_THEN (MP_TAC o SPEC
     (← q r"{ball(a:real^N,e / &2) | a IN (f:real^M->real^N->bool) x}")) THEN
    REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, OPEN_BALL] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN ANTS_TAC THENL
     [REWRITE_TAC [CLOSURE_APPROACHABLE, SUBSET, UNIONS_IMAGE, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_BALL] THEN ASM_SIMP_TAC [REAL_HALF],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N->bool") STRIP_ASSUME_TAC) THEN
    DISCH_TAC THEN FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP
     (← MESON [CLOSURE_SUBSET, SUBSET_TRANS]
          (← q r"closure s SUBSET t ==> s SUBSET t"))) THEN
    SUBGOAL_THEN
     (← q r"open_in (subtopology euclidean s)
        (INTERS {{x | x IN s /\
            ~((f:real^M->real^N->bool) x INTER t INTER ball(a,e / &2) = {})} |
       a IN c})")
    MP_TAC THENL
     [MATCH_MP_TAC OPEN_IN_INTERS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, FINITE_IMAGE] THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [open_in] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M") o CONJUNCT2) THEN ANTS_TAC THENL
     [REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"a:real^N") THEN
      ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL, REAL_HALF] THEN
      ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "2")))] THEN
    EXISTS_TAC (← q r"min d1 d2:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    X_GEN_TAC (← q r"x':real^M") THEN STRIP_TAC THEN CONJ_TAC THENL
     [ALL_TAC,
      REMOVE_THEN "1" (MP_TAC o SPEC (← q r"x':real^M")) THEN
      ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [DIST_SYM], ALL_TAC] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_BALL] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = a + b <=> x - a = b"),
                   DIST_0, ← ONCE_REWRITE_RULE [CONJ_SYM] UNWIND_THM1] THEN
      REWRITE_TAC [dist]] THEN
    REMOVE_THEN "2" (MP_TAC o SPEC (← q r"x':real^M")) THEN
    ASM_REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [DIST_SYM], ALL_TAC] THEN
    DISCH_THEN (LABEL_TAC "3") THEN
    X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
    UNDISCH_TAC (← q r"(f:real^M->real^N->bool) x SUBSET
                 UNIONS (IMAGE (\a. ball (a,e / &2)) c)") THEN
    REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q r"y:real^N")) THEN
    ASM_REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM, IN_BALL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    REMOVE_THEN "3" (MP_TAC o SPEC (← q r"a:real^N")) THEN
    ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_BALL] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^N") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [DIST_TRIANGLE_HALF_L, DIST_SYM])

  return { UPPER_HEMICONTINUOUS, LOWER_HEMICONTINUOUS,
           OPEN_MAP_IFF_LOWER_HEMICONTINUOUS_PREIMAGE,
           CLOSED_MAP_IFF_UPPER_HEMICONTINUOUS_PREIMAGE, UPPER_LOWER_HEMICONTINUOUS_EXPLICIT }

/- ------------------------------------------------------------------------- -/
/- Connected components, considered as a "connectedness" relation or a set. -/
/- (topology.ml 10856-11067)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CCM1 where
  connected_component : thm
  CONNECTED_COMPONENT_OF_EUCLIDEAN : thm
  CONNECTED_COMPONENT_IN : thm
  CONNECTED_COMPONENT_REFL : thm
  CONNECTED_COMPONENT_REFL_EQ : thm
  CONNECTED_COMPONENT_SYM : thm
  CONNECTED_COMPONENT_TRANS : thm
  CONNECTED_COMPONENT_OF_SUBSET : thm
  CONNECTED_COMPONENT_SET : thm
  CONNECTED_COMPONENT_UNIONS : thm
  CONNECTED_COMPONENT_SUBSET : thm
  CONNECTED_CONNECTED_COMPONENT_SET : thm
  CONNECTED_COMPONENT_UNIV : thm
  CONNECTED_COMPONENT_EQ_UNIV : thm
  CONNECTED_COMPONENT_EQ_SELF : thm
  CONNECTED_IFF_CONNECTED_COMPONENT : thm
  CONNECTED_IMP_CONNECTED_COMPONENT : thm
  CONNECTED_COMPONENT_MAXIMAL : thm
  CONNECTED_COMPONENT_MONO : thm
  CONNECTED_CONNECTED_COMPONENT : thm
  CONNECTED_COMPONENT_EQ_EMPTY : thm
  CONNECTED_COMPONENT_EMPTY : thm
  CONNECTED_COMPONENT_EQ : thm
  CLOSED_CONNECTED_COMPONENT : thm
  CONNECTED_COMPONENT_DISJOINT : thm
  CONNECTED_COMPONENT_NONOVERLAP : thm
  CONNECTED_COMPONENT_OVERLAP : thm
  CONNECTED_COMPONENT_SYM_EQ : thm
  CONNECTED_COMPONENT_EQ_EQ : thm
  CONNECTED_EQ_CONNECTED_COMPONENT_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupCCM1 [HolBase] (D : TopologyDeps) (BCLO : CLO) (BCON : CON) (BCLS1 : CLS1) :
    ExceptT String IO CCM1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, DISJOINT, EMPTY, EXTENSION, .. } := D.core1
  let { FUN_EQ_THM, IN, INTER_EMPTY, INTER_IDEMPOT, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM, .. } := D.core5
  let { UNION_SUBSET, .. } := D.core6
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := D.met1
  let { connected_component_of, .. } := D.met3
  let { CLOSED_EMPTY, .. } := BCLO
  let { CONNECTED_EMPTY, CONNECTED_IN_EUCLIDEAN, CONNECTED_SING, CONNECTED_UNION,
        CONNECTED_UNIONS, CONNECTED_UNIV, .. } := BCON
  let { CLOSURE_EQ, CLOSURE_MINIMAL, CLOSURE_SUBSET, CONNECTED_CLOSURE, .. } := BCLS1
  -- @@SCOPE END

  let connected_component ← new_definition
   r"connected_component s x y <=>
        ?t. connected t /\ t SUBSET s /\ x IN t /\ y IN t"

  let CONNECTED_COMPONENT_OF_EUCLIDEAN ← prove
   r"!s x:real^N.
     connected_component_of (subtopology euclidean s) x =
     connected_component s x"
   (REWRITE_TAC [FUN_EQ_THM, connected_component_of, connected_component] THEN
    REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC])

  let CONNECTED_COMPONENT_IN ← prove
   r"!s x y. connected_component s x y ==> x IN s /\ y IN s"
   (REWRITE_TAC [connected_component] THEN SET_TAC [])

  let CONNECTED_COMPONENT_REFL ← prove
   r"!s x:real^N. x IN s ==> connected_component s x x"
   (REWRITE_TAC [connected_component] THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"{x:real^N}") THEN REWRITE_TAC [CONNECTED_SING] THEN
    ASM SET_TAC [])

  let CONNECTED_COMPONENT_REFL_EQ ← prove
   r"!s x:real^N. connected_component s x x <=> x IN s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [CONNECTED_COMPONENT_REFL] THEN
    REWRITE_TAC [connected_component] THEN SET_TAC [])

  let CONNECTED_COMPONENT_SYM ← prove
   r"!s x y:real^N. connected_component s x y ==> connected_component s y x"
   (REWRITE_TAC [connected_component] THEN MESON_TAC [])

  let CONNECTED_COMPONENT_TRANS ← prove
   r"!s x y:real^N.
    connected_component s x y /\ connected_component s y z
    ==> connected_component s x z"
   (REPEAT GEN_TAC THEN REWRITE_TAC [connected_component] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"t:real^N->bool"))
                                (X_CHOOSE_TAC (← q r"u:real^N->bool"))) THEN
    EXISTS_TAC (← q r"t UNION u:real^N->bool") THEN
    ASM_REWRITE_TAC [IN_UNION, UNION_SUBSET] THEN
    MATCH_MP_TAC CONNECTED_UNION THEN ASM SET_TAC [])

  let CONNECTED_COMPONENT_OF_SUBSET ← prove
   r"!s t x. s SUBSET t /\ connected_component s x y
           ==> connected_component t x y"
   (REWRITE_TAC [connected_component] THEN SET_TAC [])

  let CONNECTED_COMPONENT_SET ← prove
   r"!s x. connected_component s x =
            { y | ?t. connected t /\ t SUBSET s /\ x IN t /\ y IN t}"
   (REWRITE_TAC [IN_ELIM_THM, EXTENSION] THEN
    REWRITE_TAC [IN, connected_component] THEN MESON_TAC [])

  let CONNECTED_COMPONENT_UNIONS ← prove
   r"!s x. connected_component s x =
                UNIONS {t | connected t /\ x IN t /\ t SUBSET s}"
   (REWRITE_TAC [CONNECTED_COMPONENT_SET] THEN SET_TAC [])

  let CONNECTED_COMPONENT_SUBSET ← prove
   r"!s x. (connected_component s x) SUBSET s"
   (REWRITE_TAC [CONNECTED_COMPONENT_SET] THEN SET_TAC [])

  let CONNECTED_CONNECTED_COMPONENT_SET ← prove
   r"!s. connected s <=> !x:real^N. x IN s ==> connected_component s x = s"
   (GEN_TAC THEN REWRITE_TAC [CONNECTED_COMPONENT_UNIONS] THEN EQ_TAC THENL
     [SET_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [CONNECTED_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC CONNECTED_UNIONS THEN
    ASM SET_TAC [])

  let CONNECTED_COMPONENT_UNIV ← prove
   r"!x. connected_component(:real^N) x = (:real^N)"
   (MESON_TAC [CONNECTED_CONNECTED_COMPONENT_SET, CONNECTED_UNIV, IN_UNIV])

  let CONNECTED_COMPONENT_EQ_UNIV ← prove
   r"!s x. connected_component s x = (:real^N) <=> s = (:real^N)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [CONNECTED_COMPONENT_UNIV] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> s = UNIV ==> t = UNIV")) THEN
    REWRITE_TAC [CONNECTED_COMPONENT_SUBSET])

  let CONNECTED_COMPONENT_EQ_SELF ← prove
   r"!s x. connected s /\ x IN s ==> connected_component s x = s"
   (MESON_TAC [CONNECTED_CONNECTED_COMPONENT_SET])

  let CONNECTED_IFF_CONNECTED_COMPONENT ← prove
   r"!s. connected s <=>
          !x y. x IN s /\ y IN s ==> connected_component s x y"
   (REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT_SET] THEN
    REWRITE_TAC [EXTENSION] THEN MESON_TAC [IN, CONNECTED_COMPONENT_IN])

  let CONNECTED_IMP_CONNECTED_COMPONENT ← prove
   r"!s a b:real^N.
     connected s /\ a IN s /\ b IN s ==> connected_component s a b"
   (MESON_TAC [CONNECTED_IFF_CONNECTED_COMPONENT])

  let CONNECTED_COMPONENT_MAXIMAL ← prove
   r"!s t x:real^N.
        x IN t /\ connected t /\ t SUBSET s
        ==> t SUBSET (connected_component s x)"
   (REWRITE_TAC [CONNECTED_COMPONENT_SET] THEN SET_TAC [])

  let CONNECTED_COMPONENT_MONO ← prove
   r"!s t x. s SUBSET t
           ==> (connected_component s x) SUBSET (connected_component t x)"
   (REWRITE_TAC [CONNECTED_COMPONENT_SET] THEN SET_TAC [])

  let CONNECTED_CONNECTED_COMPONENT ← prove
   r"!s x. connected(connected_component s x)"
   (REWRITE_TAC [CONNECTED_COMPONENT_UNIONS] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_UNIONS THEN SET_TAC [])

  let CONNECTED_COMPONENT_EQ_EMPTY ← prove
   r"!s x:real^N. connected_component s x = {} <=> ~(x IN s)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
      REWRITE_TAC [IN, CONNECTED_COMPONENT_REFL_EQ],
      REWRITE_TAC [CONNECTED_COMPONENT_SET] THEN SET_TAC []])

  let CONNECTED_COMPONENT_EMPTY ← prove
   r"!x. connected_component {} x = {}"
   (REWRITE_TAC [CONNECTED_COMPONENT_EQ_EMPTY, NOT_IN_EMPTY])

  let CONNECTED_COMPONENT_EQ ← prove
   r"!s x y. y IN connected_component s x
           ==> (connected_component s y = connected_component s x)"
   (REWRITE_TAC [EXTENSION, IN] THEN
    MESON_TAC [CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS])

  let CLOSED_CONNECTED_COMPONENT ← prove
   r"!s x:real^N. closed s ==> closed(connected_component s x)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN s") THENL
     [ALL_TAC, ASM_MESON_TAC [CONNECTED_COMPONENT_EQ_EMPTY, CLOSED_EMPTY]] THEN
    REWRITE_TAC [← GSYM CLOSURE_EQ] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [CLOSURE_SUBSET] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
    SIMP_TAC [CONNECTED_CLOSURE, CONNECTED_CONNECTED_COMPONENT] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE [SUBSET] CLOSURE_SUBSET) THEN
      ASM_REWRITE_TAC [IN, CONNECTED_COMPONENT_REFL_EQ],
      MATCH_MP_TAC CLOSURE_MINIMAL THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_SUBSET]])

  let CONNECTED_COMPONENT_DISJOINT ← prove
   r"!s a b. DISJOINT (connected_component s a) (connected_component s b) <=>
             ~(a IN connected_component s b)"
   (REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN
    REWRITE_TAC [IN] THEN
    MESON_TAC [CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS])

  let CONNECTED_COMPONENT_NONOVERLAP ← prove
   r"!s a b:real^N.
        (connected_component s a) INTER (connected_component s b) = {} <=>
        ~(a IN s) \/ ~(b IN s) \/
        ~(connected_component s a = connected_component s b)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM CONNECTED_COMPONENT_EQ_EMPTY]) THEN
    ASM_REWRITE_TAC [INTER_EMPTY] THEN
    ASM_CASES_TAC (← q r"(b:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM CONNECTED_COMPONENT_EQ_EMPTY]) THEN
    ASM_REWRITE_TAC [INTER_EMPTY] THEN ASM_CASES_TAC
     (← q r"connected_component s (a:real^N) = connected_component s b") THEN
    ASM_REWRITE_TAC [INTER_IDEMPOT, CONNECTED_COMPONENT_EQ_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_COMPONENT_EQ THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [← GSYM DISJOINT]) THEN
    REWRITE_TAC [CONNECTED_COMPONENT_DISJOINT])

  let CONNECTED_COMPONENT_OVERLAP ← prove
   r"!s a b:real^N.
        ~((connected_component s a) INTER (connected_component s b) = {}) <=>
        a IN s /\ b IN s /\
        connected_component s a = connected_component s b"
   (REWRITE_TAC [CONNECTED_COMPONENT_NONOVERLAP, DE_MORGAN_THM])

  let CONNECTED_COMPONENT_SYM_EQ ← prove
   r"!s x y. connected_component s x y <=> connected_component s y x"
   (MESON_TAC [CONNECTED_COMPONENT_SYM])

  let CONNECTED_COMPONENT_EQ_EQ ← prove
   r"!s x y:real^N.
        connected_component s x = connected_component s y <=>
           ~(x IN s) /\ ~(y IN s) \/
           x IN s /\ y IN s /\ connected_component s x y"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(y:real^N) IN s") THENL
     [ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THENL
       [REWRITE_TAC [FUN_EQ_THM] THEN
        ASM_MESON_TAC [CONNECTED_COMPONENT_TRANS, CONNECTED_COMPONENT_REFL,
                       CONNECTED_COMPONENT_SYM],
        ASM_MESON_TAC [CONNECTED_COMPONENT_EQ_EMPTY]],
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM CONNECTED_COMPONENT_EQ_EMPTY]) THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_EQ_EMPTY] THEN
      ONCE_REWRITE_TAC [CONNECTED_COMPONENT_SYM_EQ] THEN
      ASM_REWRITE_TAC [EMPTY] THEN ASM_MESON_TAC [CONNECTED_COMPONENT_EQ_EMPTY]])

  let CONNECTED_EQ_CONNECTED_COMPONENT_EQ ← prove
   r"!s. connected s <=>
       !x y. x IN s /\ y IN s
             ==> connected_component s x = connected_component s y"
   (SIMP_TAC [CONNECTED_COMPONENT_EQ_EQ] THEN
    REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT])

  return { connected_component, CONNECTED_COMPONENT_OF_EUCLIDEAN, CONNECTED_COMPONENT_IN,
           CONNECTED_COMPONENT_REFL, CONNECTED_COMPONENT_REFL_EQ, CONNECTED_COMPONENT_SYM,
           CONNECTED_COMPONENT_TRANS, CONNECTED_COMPONENT_OF_SUBSET, CONNECTED_COMPONENT_SET,
           CONNECTED_COMPONENT_UNIONS, CONNECTED_COMPONENT_SUBSET,
           CONNECTED_CONNECTED_COMPONENT_SET, CONNECTED_COMPONENT_UNIV,
           CONNECTED_COMPONENT_EQ_UNIV, CONNECTED_COMPONENT_EQ_SELF,
           CONNECTED_IFF_CONNECTED_COMPONENT, CONNECTED_IMP_CONNECTED_COMPONENT,
           CONNECTED_COMPONENT_MAXIMAL, CONNECTED_COMPONENT_MONO, CONNECTED_CONNECTED_COMPONENT,
           CONNECTED_COMPONENT_EQ_EMPTY, CONNECTED_COMPONENT_EMPTY, CONNECTED_COMPONENT_EQ,
           CLOSED_CONNECTED_COMPONENT, CONNECTED_COMPONENT_DISJOINT,
           CONNECTED_COMPONENT_NONOVERLAP, CONNECTED_COMPONENT_OVERLAP,
           CONNECTED_COMPONENT_SYM_EQ, CONNECTED_COMPONENT_EQ_EQ,
           CONNECTED_EQ_CONNECTED_COMPONENT_EQ }

/- ------------------------------------------------------------------------- -/
/- Connected components, continued.  (topology.ml 11068-11338)               -/
/- ------------------------------------------------------------------------- -/

structure CCM2 where
  CONNECTED_COMPONENT_IDEMP : thm
  CONNECTED_COMPONENT_UNIQUE : thm
  JOINABLE_CONNECTED_COMPONENT_EQ : thm
  CONNECTED_COMPONENT_TRANSLATION : thm
  CONNECTED_COMPONENT_LINEAR_IMAGE : thm
  UNIONS_CONNECTED_COMPONENT : thm
  COMPLEMENT_CONNECTED_COMPONENT_UNIONS : thm
  CLOSED_IN_CONNECTED_COMPONENT : thm
  OPEN_IN_CONNECTED_COMPONENT : thm
  CONNECTED_COMPONENT_EQUIVALENCE_RELATION : thm
  CONNECTED_COMPONENT_INTERMEDIATE_SUBSET : thm
  CONNECTED_UNIONS_STRONG : thm
  NOT_CONNECTED_COMPONENT_SEPARATED_UNION : thm
  CONNECTED_COMPONENT_SEPARATED_UNION : thm
  CONNECTED_CONNECTED_DIFF : thm
  CONNECTED_COMPONENT_FINITE : thm
  deriving Inhabited

@[nospecialize]
def setupCCM2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLOC : LOC) (BLPT : LPT) (BCLS1 : CLS1)
    (BCLS2 : CLS2) (BCCM1 : CCM1) : ExceptT String IO CCM2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, add_linear_invariants,
        add_translation_invariants, GEOM_TRANSFORM_TAC, GEOM_TRANSLATE_TAC, .. } := D
  let { ETA_AX, FINITE_IMAGE, .. } := D.core1
  let { FORALL_IN_GSPEC, FUN_EQ_THM, IMP_CONJ, IN, INTERS_GSPEC, INTER_SUBSET, IN_DELETE, IN_DIFF,
        IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIONS, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, MONO_FORALL, MONO_IMP, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_TRANS,
        SUBSET_UNION, SUBSET_UNIV, .. } := D.core5
  let { UNIONS_DIFF, UNIONS_GSPEC, UNIONS_SUBSET, UNION_COMM, .. } := D.core6
  let { CLOSED_IN_EMPTY, CLOSED_IN_UNIONS, CONNECTED_COMPONENT_OF_DISCRETE_TOPOLOGY, .. } := D.met1
  let { OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, OPEN_IN_SUBTOPOLOGY_REFL, .. } := D.met3
  let { SUBTOPOLOGY_EUCLIDEAN_EQ_DISCRETE_TOPOLOGY_FINITE, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { CLOSED_IN_CLOSED, OPEN_IN_OPEN, .. } := BLOC
  let { CONNECTED_EQUIVALENCE_RELATION, CONNECTED_EQUIVALENCE_RELATION_GEN, .. } := BLPT
  let { CLOSED_CLOSURE, CLOSURE_NONEMPTY_OPEN_INTER, CLOSURE_SUBSET,
        CONNECTED_INTERMEDIATE_CLOSURE, CONNECTED_UNION_STRONG, .. } := BCLS1
  let { CONNECTED_SEPARATION_ALT, .. } := BCLS2
  let { CONNECTED_COMPONENT_DISJOINT, CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_EQ_EMPTY,
        CONNECTED_COMPONENT_EQ_EQ, CONNECTED_COMPONENT_IN, CONNECTED_COMPONENT_MAXIMAL,
        CONNECTED_COMPONENT_MONO, CONNECTED_COMPONENT_OF_EUCLIDEAN, CONNECTED_COMPONENT_OVERLAP,
        CONNECTED_COMPONENT_REFL, CONNECTED_COMPONENT_REFL_EQ, CONNECTED_COMPONENT_SET,
        CONNECTED_COMPONENT_SUBSET, CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS,
        CONNECTED_CONNECTED_COMPONENT, CONNECTED_IFF_CONNECTED_COMPONENT, connected_component,
        .. } := BCCM1
  -- @@SCOPE END

  let CONNECTED_COMPONENT_IDEMP ← prove
   r"!s x:real^N. connected_component (connected_component s x) x =
                connected_component s x"
   (REWRITE_TAC [FUN_EQ_THM, connected_component] THEN
    REPEAT GEN_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN EQ_TAC THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [CONNECTED_COMPONENT_MAXIMAL, SUBSET_TRANS,
                   CONNECTED_COMPONENT_SUBSET])

  let CONNECTED_COMPONENT_UNIQUE ← prove
   r"!s c x:real^N.
        x IN c /\ c SUBSET s /\ connected c /\
        (!c'. x IN c' /\ c' SUBSET s /\ connected c'
              ==> c' SUBSET c)
        ==> connected_component s x = c"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET, CONNECTED_CONNECTED_COMPONENT] THEN
      REWRITE_TAC [IN] THEN ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN ASM_REWRITE_TAC []])

  let JOINABLE_CONNECTED_COMPONENT_EQ ← prove
   r"!s t x y:real^N.
        connected t /\ t SUBSET s /\
        ~(connected_component s x INTER t = {}) /\
        ~(connected_component s y INTER t = {})
        ==> connected_component s x = connected_component s y"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"w:real^N") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC)) THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_COMPONENT_EQ THEN
    REWRITE_TAC [IN] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_TRANS THEN
    EXISTS_TAC (← q r"z:real^N") THEN CONJ_TAC THENL [ASM_MESON_TAC [IN], ALL_TAC] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_TRANS THEN
    EXISTS_TAC (← q r"w:real^N") THEN CONJ_TAC THENL
     [REWRITE_TAC [connected_component] THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [],
      ASM_MESON_TAC [IN, CONNECTED_COMPONENT_SYM]])

  let CONNECTED_COMPONENT_TRANSLATION ← prove
   r"!a s x. connected_component (IMAGE (\x. a + x) s) (a + x) =
                IMAGE (\x. a + x) (connected_component s x)"
   (REWRITE_TAC [CONNECTED_COMPONENT_SET] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [CONNECTED_COMPONENT_TRANSLATION]

  let CONNECTED_COMPONENT_LINEAR_IMAGE ← prove
   r"!f s x. linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
           ==> connected_component (IMAGE f s) (f x) =
               IMAGE f (connected_component s x)"
   (REWRITE_TAC [CONNECTED_COMPONENT_SET] THEN
    GEOM_TRANSFORM_TAC [])

  add_linear_invariants [CONNECTED_COMPONENT_LINEAR_IMAGE]

  let UNIONS_CONNECTED_COMPONENT ← prove
   r"!s:real^N->bool. UNIONS {connected_component s x |x| x IN s} = s"
   (GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC, CONNECTED_COMPONENT_SUBSET] THEN
    REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN EXISTS_TAC (← q r"x:real^N") THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [IN] THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ])

  let COMPLEMENT_CONNECTED_COMPONENT_UNIONS ← prove
   r"!s x:real^N.
     s DIFF connected_component s x =
     UNIONS({connected_component s y | y | y IN s} DELETE
            (connected_component s x))"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
      [← GSYM UNIONS_CONNECTED_COMPONENT] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN s DELETE a ==> DISJOINT a x)
       ==> UNIONS s DIFF a = UNIONS (s DELETE a)")) THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_GSPEC, IN_DELETE] THEN
    SIMP_TAC [CONNECTED_COMPONENT_DISJOINT, CONNECTED_COMPONENT_EQ_EQ] THEN
    MESON_TAC [IN, SUBSET, CONNECTED_COMPONENT_SUBSET])

  let CLOSED_IN_CONNECTED_COMPONENT ← prove
   r"!s x:real^N. closed_in (subtopology euclidean s) (connected_component s x)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"connected_component s (x:real^N) = {}") THEN
    ASM_REWRITE_TAC [CLOSED_IN_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [CONNECTED_COMPONENT_EQ_EMPTY]) THEN
    REWRITE_TAC [CLOSED_IN_CLOSED] THEN
    EXISTS_TAC (← q r"closure(connected_component s x):real^N->bool") THEN
    REWRITE_TAC [CLOSED_CLOSURE] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [SUBSET_INTER, CONNECTED_COMPONENT_SUBSET, CLOSURE_SUBSET] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN REWRITE_TAC [INTER_SUBSET] THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [IN_INTER] THEN
      MATCH_MP_TAC (← REWRITE_RULE [SUBSET] CLOSURE_SUBSET) THEN
      ASM_REWRITE_TAC [IN, CONNECTED_COMPONENT_REFL_EQ],
      MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THEN
      EXISTS_TAC (← q r"connected_component s (x:real^N)") THEN
      REWRITE_TAC [INTER_SUBSET, CONNECTED_CONNECTED_COMPONENT,
                   SUBSET_INTER, CONNECTED_COMPONENT_SUBSET, CLOSURE_SUBSET]])

  let OPEN_IN_CONNECTED_COMPONENT ← prove
   r"!s x:real^N.
        FINITE {connected_component s x |x| x IN s}
        ==> open_in (subtopology euclidean s) (connected_component s x)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"connected_component s (x:real^N) =
          s DIFF (UNIONS {connected_component s y |y| y IN s} DIFF
                  connected_component s x)")
    SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_CONNECTED_COMPONENT] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"t SUBSET s ==> t = s DIFF (s DIFF t)")) THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET],
      MATCH_MP_TAC OPEN_IN_DIFF THEN
      REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_REFL, TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
      REWRITE_TAC [UNIONS_DIFF] THEN
      MATCH_MP_TAC CLOSED_IN_UNIONS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"connected_component s y DIFF connected_component s x =
        connected_component s y \/
        connected_component s (y:real^N) DIFF connected_component s x = {}")
       (DISJ_CASES_THEN SUBST1_TAC)
      THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"(~(s INTER t = {}) ==> s = t) ==> s DIFF t = s \/ s DIFF t = {}")) THEN
        SIMP_TAC [CONNECTED_COMPONENT_OVERLAP],
        REWRITE_TAC [CLOSED_IN_CONNECTED_COMPONENT],
        REWRITE_TAC [CLOSED_IN_EMPTY]]])

  let CONNECTED_COMPONENT_EQUIVALENCE_RELATION ← prove
   r"!R s:real^N->bool.
        (!x y. R x y ==> R y x) /\
        (!x y z. R x y /\ R y z ==> R x z) /\
        (!a. a IN s
             ==> ?t. open_in (subtopology euclidean s) t /\ a IN t /\
                     !x. x IN t ==> R a x)
        ==> !a b. connected_component s a b ==> R a b"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"R:real^N->real^N->bool", ← q r"connected_component s (a:real^N)"]
      CONNECTED_EQUIVALENCE_RELATION) THEN
    ASM_REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^N")) THEN ANTS_TAC THENL
       [ASM_MESON_TAC [CONNECTED_COMPONENT_SUBSET, SUBSET], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"t INTER connected_component s (a:real^N)") THEN
      ASM_SIMP_TAC [IN_INTER, OPEN_IN_OPEN] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [] THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N"]
          CONNECTED_COMPONENT_SUBSET) THEN
      SET_TAC [],
      DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
      ASM_MESON_TAC [CONNECTED_COMPONENT_IN]])

  let CONNECTED_COMPONENT_INTERMEDIATE_SUBSET ← prove
   r"!t u a:real^N.
        connected_component u a SUBSET t /\ t SUBSET u
        ==> connected_component t a = connected_component u a"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN u") THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_COMPONENT_UNIQUE THEN
      ASM_REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [CONNECTED_COMPONENT_REFL, IN], ALL_TAC] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
      ASM SET_TAC [],
      ASM_MESON_TAC [CONNECTED_COMPONENT_EQ_EMPTY, SUBSET]])

  let CONNECTED_UNIONS_STRONG ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> connected s) /\
        ~(UNIONS f INTER INTERS {closure s | s IN f} = {})
        ==> connected(UNIONS f)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [IN_INTER, IN_UNIONS, INTERS_GSPEC, IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"c:real^N->bool") STRIP_ASSUME_TAC) ASSUME_TAC)) THEN
    REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    SUBGOAL_THEN (← q r"(z:real^N) IN UNIONS f") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x:real^N. x IN UNIONS f ==> connected_component (UNIONS f) z x")
     (fun th => ASM_MESON_TAC [CONNECTED_COMPONENT_TRANS,
                               CONNECTED_COMPONENT_SYM, th]) THEN
    REWRITE_TAC [IN_UNIONS, LEFT_IMP_EXISTS_THM, connected_component] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"u:real^N->bool"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"u UNION c:real^N->bool") THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONNECTED_UNION_STRONG THEN ASM SET_TAC [])

  let NOT_CONNECTED_COMPONENT_SEPARATED_UNION ← prove
   r"!s t x y:real^N.
        s INTER closure t = {} /\ t INTER closure s = {} /\ x IN s /\ y IN t
        ==> ~connected_component (s UNION t) x y"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [connected_component] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_SEPARATION_ALT]) THEN
    REWRITE_TAC [] THEN
    MAP_EVERY EXISTS_TAC [← q r"s:real^N->bool", ← q r"t:real^N->bool"] THEN
    ASM SET_TAC [])

  let CONNECTED_COMPONENT_SEPARATED_UNION ← prove
   r"!s t x:real^N.
        s INTER closure t = {} /\ t INTER closure s = {}
        ==> connected_component (s UNION t) x =
            if x IN s then connected_component s x
            else if x IN t then connected_component t x
            else {}"
   (REPEAT STRIP_TAC THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_EQ_EMPTY, IN_UNION] THEN
    SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, CONNECTED_COMPONENT_MONO, SUBSET_UNION] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
    REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT, IN] THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ, IN_UNION] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"connected_component s x SUBSET s /\
      (!y. ~(y IN t) ==> y IN s ==> ~(connected_component s x y))
      ==> connected_component s x SUBSET t")) THEN
    SIMP_TAC [CONNECTED_COMPONENT_SUBSET, IN_UNION] THEN
    ASM_SIMP_TAC [NOT_CONNECTED_COMPONENT_SEPARATED_UNION] THEN
    ONCE_REWRITE_TAC [UNION_COMM] THEN
    ASM_SIMP_TAC [NOT_CONNECTED_COMPONENT_SEPARATED_UNION])

  let CONNECTED_CONNECTED_DIFF ← prove
   r"!s t:real^N->bool.
        connected s /\ s SUBSET closure(s DIFF t) /\
        (!x. x IN s
             ==> ?u. x IN u /\ open_in (subtopology euclidean s) u /\
                     connected(u DIFF t))
        ==> connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT, IN_DIFF] THEN
    REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ (r /\ s) <=> p /\ r /\ q /\ s")] THEN
    MATCH_MP_TAC CONNECTED_EQUIVALENCE_RELATION_GEN THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [OPEN_IN_OPEN, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"x:real^N", ← q r"u:real^N->bool"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
      ASM_REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o GEN_REWRITE_RULE id [SUBSET]) THEN
      ASM_REWRITE_TAC [CLOSURE_NONEMPTY_OPEN_INTER] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"u:real^N->bool")) THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN
      ONCE_REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_REWRITE_TAC [IN_DIFF] THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      MATCH_MP_TAC MONO_IMP THEN SIMP_TAC [] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"P SUBSET Q ==> P x ==> Q x")) THEN REWRITE_TAC [ETA_AX] THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN SET_TAC []])

  let CONNECTED_COMPONENT_FINITE ← prove
   r"!s x:real^N.
        FINITE s ==> connected_component s x = if x IN s then {x} else {}"
   (REWRITE_TAC [← GSYM CONNECTED_COMPONENT_OF_EUCLIDEAN] THEN
    SIMP_TAC [SUBTOPOLOGY_EUCLIDEAN_EQ_DISCRETE_TOPOLOGY_FINITE] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_OF_DISCRETE_TOPOLOGY])

  return { CONNECTED_COMPONENT_IDEMP, CONNECTED_COMPONENT_UNIQUE,
           JOINABLE_CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_TRANSLATION,
           CONNECTED_COMPONENT_LINEAR_IMAGE, UNIONS_CONNECTED_COMPONENT,
           COMPLEMENT_CONNECTED_COMPONENT_UNIONS, CLOSED_IN_CONNECTED_COMPONENT,
           OPEN_IN_CONNECTED_COMPONENT, CONNECTED_COMPONENT_EQUIVALENCE_RELATION,
           CONNECTED_COMPONENT_INTERMEDIATE_SUBSET, CONNECTED_UNIONS_STRONG,
           NOT_CONNECTED_COMPONENT_SEPARATED_UNION, CONNECTED_COMPONENT_SEPARATED_UNION,
           CONNECTED_CONNECTED_DIFF, CONNECTED_COMPONENT_FINITE }

/- ------------------------------------------------------------------------- -/
/- The set of connected components of a set.  (topology.ml 11339-11510)      -/
/- ------------------------------------------------------------------------- -/

structure CPN1 where
  components : thm
  EUCLIDEAN_CONNECTED_COMPONENTS_OF : thm
  PAIRWISE_SEPARATED_COMPONENTS : thm
  COMPONENTS_TRANSLATION : thm
  COMPONENTS_LINEAR_IMAGE : thm
  IN_COMPONENTS : thm
  CONNECTED_COMPONENTS : thm
  UNIONS_COMPONENTS : thm
  PAIRWISE_DISJOINT_COMPONENTS : thm
  IN_COMPONENTS_NONEMPTY : thm
  IN_COMPONENTS_SUBSET : thm
  IN_COMPONENTS_CONNECTED : thm
  CONNECTED_COMPONENT_IN_COMPONENTS : thm
  IN_COMPONENTS_MAXIMAL : thm
  JOINABLE_COMPONENTS_EQ : thm
  CLOSED_IN_COMPONENT : thm
  CLOSED_COMPONENTS : thm
  COMPACT_CONNECTED_COMPONENT : thm
  COMPACT_COMPONENTS : thm
  CONTINUOUS_ON_COMPONENTS_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupCPN1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCON : CON) (BBND1 : BND1) (BCPT : CPT)
    (BCLC : CLC) (BCCM1 : CCM1) (BCCM2 : CCM2) : ExceptT String IO CPN1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, ASSERT_TAC,
        add_linear_invariants, add_translation_invariants, GEOM_TRANSFORM_TAC,
        GEOM_TRANSLATE_TAC, .. } := D
  let { DISJOINT, EXISTS_IN_GSPEC, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, IMP_CONJ, IMP_CONJ_ALT, IN, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIONS, MEMBER_NOT_EMPTY, MONO_EXISTS, PAIRWISE_IMP, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM, .. } := D.core5
  let { UNIONS_GSPEC, pairwise, .. } := D.core6
  let { OPEN_IN_TRANS, OPEN_IN_UNIONS, PAIRWISE_SEPARATED_CONNECTED_COMPONENTS_OF,
        SEPARATED_IN_SUBTOPOLOGY, connected_components_of, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CONNECTED_SING, CONNECTED_UNION, .. } := BCON
  let { BOUNDED_SUBSET, .. } := BBND1
  let { CLOSED_IN_COMPACT, COMPACT_EQ_BOUNDED_CLOSED, .. } := BCPT
  let { CONTINUOUS_OPEN_IN_PREIMAGE_EQ, .. } := BCLC
  let { CLOSED_CONNECTED_COMPONENT, CONNECTED_COMPONENT_EQ_EMPTY, CONNECTED_COMPONENT_MAXIMAL,
        CONNECTED_COMPONENT_NONOVERLAP, CONNECTED_COMPONENT_OF_EUCLIDEAN,
        CONNECTED_COMPONENT_REFL, CONNECTED_COMPONENT_SET, CONNECTED_COMPONENT_SUBSET,
        CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS, CONNECTED_CONNECTED_COMPONENT,
        .. } := BCCM1
  let { CLOSED_IN_CONNECTED_COMPONENT, CONNECTED_COMPONENT_UNIQUE,
        JOINABLE_CONNECTED_COMPONENT_EQ, .. } := BCCM2
  -- @@SCOPE END

  let components ← new_definition
   r"components s = {connected_component s x | x | x:real^N IN s}"

  let EUCLIDEAN_CONNECTED_COMPONENTS_OF ← prove
   r"!s:real^N->bool.
        connected_components_of (subtopology euclidean s) = components s"
   (REWRITE_TAC [connected_components_of, components] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                 CONNECTED_COMPONENT_OF_EUCLIDEAN])

  let PAIRWISE_SEPARATED_COMPONENTS ← prove
   r"!s:real^N->bool. pairwise (separated_in euclidean) (components s)"
   (GEN_TAC THEN
    MP_TAC (← ISPEC (← q r"subtopology euclidean (s:real^N->bool)")
          PAIRWISE_SEPARATED_CONNECTED_COMPONENTS_OF) THEN
    REWRITE_TAC [EUCLIDEAN_CONNECTED_COMPONENTS_OF] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] PAIRWISE_IMP) THEN
    SIMP_TAC [SEPARATED_IN_SUBTOPOLOGY])

  let COMPONENTS_TRANSLATION ← prove
   r"!a s. components(IMAGE (\x. a + x) s) =
   IMAGE (IMAGE (\x. a + x)) (components s)"
   (REWRITE_TAC [components] THEN GEOM_TRANSLATE_TAC [] THEN SET_TAC [])

  add_translation_invariants [COMPONENTS_TRANSLATION]

  let COMPONENTS_LINEAR_IMAGE ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
           ==> components(IMAGE f s) = IMAGE (IMAGE f) (components s)"
   (REWRITE_TAC [components] THEN GEOM_TRANSFORM_TAC [] THEN SET_TAC [])

  add_linear_invariants [COMPONENTS_LINEAR_IMAGE]

  let IN_COMPONENTS ← prove
   r"!u:real^N->bool s. s IN components u
    <=> ?x. x IN u /\ s = connected_component u x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [components] THEN EQ_TAC
    THENL [SET_TAC [], STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    UNDISCH_TAC (← q r"x:real^N IN u") THEN SET_TAC []])

  let CONNECTED_COMPONENTS ← prove
   r"!s a b:real^N.
        connected_component s a b <=>
        ?c. c IN components s /\ a IN c /\ b IN c"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CONNECTED_COMPONENT_SUBSET) THEN
    REWRITE_TAC [components, EXISTS_IN_GSPEC, SUBSET] THEN REWRITE_TAC [IN] THEN
    MESON_TAC [CONNECTED_COMPONENT_TRANS, CONNECTED_COMPONENT_SYM])

  let UNIONS_COMPONENTS ← prove
   r"!u:real^N->bool. u = UNIONS (components u)"
   (REWRITE_TAC [EXTENSION] THEN REPEAT GEN_TAC THEN EQ_TAC
    THENL [DISCH_TAC THEN REWRITE_TAC [IN_UNIONS] THEN
    EXISTS_TAC (← q r"connected_component (u:real^N->bool) x") THEN CONJ_TAC THENL
    [REWRITE_TAC [components] THEN SET_TAC [← ASSUME (← q r"x:real^N IN u")],
    REWRITE_TAC [CONNECTED_COMPONENT_SET] THEN SUBGOAL_THEN
    (← q r"?s:real^N->bool. connected s /\ s SUBSET u /\ x IN s") MP_TAC
    THENL [EXISTS_TAC (← q r"{x:real^N}") THEN ASM_REWRITE_TAC [CONNECTED_SING] THEN
    POP_ASSUM MP_TAC THEN SET_TAC [], SET_TAC []]],
    REWRITE_TAC [IN_UNIONS] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!x:real^N s u. x IN s /\ s SUBSET u ==> x IN u")) THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN STRIP_ASSUME_TAC
    (← MESON [IN_COMPONENTS, ← ASSUME (← q r"t:real^N->bool IN components u")]
    (← q r"?y. t:real^N->bool = connected_component u y")) THEN
     ASM_REWRITE_TAC [CONNECTED_COMPONENT_SUBSET]])

  let PAIRWISE_DISJOINT_COMPONENTS ← prove
   r"!u:real^N->bool. pairwise DISJOINT (components u)"
   (GEN_TAC THEN REWRITE_TAC [pairwise, DISJOINT] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"t:real^N->bool"] THEN STRIP_TAC THEN
    ASSERT_TAC (← q r"(?a. s:real^N->bool = connected_component u a) /\
    ?b. t:real^N->bool = connected_component u b")
    THENL [ASM_MESON_TAC [IN_COMPONENTS],
    ASM_MESON_TAC [CONNECTED_COMPONENT_NONOVERLAP]])

  let IN_COMPONENTS_NONEMPTY ← prove
   r"!s c. c IN components s ==> ~(c = {})"
   (REPEAT GEN_TAC THEN REWRITE_TAC [components, IN_ELIM_THM] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [CONNECTED_COMPONENT_EQ_EMPTY])

  let IN_COMPONENTS_SUBSET ← prove
   r"!s c. c IN components s ==> c SUBSET s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [components, IN_ELIM_THM] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [CONNECTED_COMPONENT_SUBSET])

  let IN_COMPONENTS_CONNECTED ← prove
   r"!s c. c IN components s ==> connected c"
   (REPEAT GEN_TAC THEN REWRITE_TAC [components, IN_ELIM_THM] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT])

  let CONNECTED_COMPONENT_IN_COMPONENTS ← prove
   r"!s x:real^N. connected_component s x IN components s <=> x IN s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
    ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [components, IN_ELIM_THM] THEN ASM_MESON_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM CONNECTED_COMPONENT_EQ_EMPTY]) THEN
      ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY]])

  let IN_COMPONENTS_MAXIMAL ← prove
   r"!s c:real^N->bool.
        c IN components s <=>
        ~(c = {}) /\ c SUBSET s /\ connected c /\
        !c'. ~(c' = {}) /\ c SUBSET c' /\ c' SUBSET s /\ connected c'
             ==> c' = c"
   (REPEAT GEN_TAC THEN REWRITE_TAC [components, IN_ELIM_THM] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_EQ_EMPTY, CONNECTED_COMPONENT_SUBSET,
                       CONNECTED_CONNECTED_COMPONENT] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
      ASM_MESON_TAC [CONNECTED_COMPONENT_REFL, IN, SUBSET],
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← GSYM CONNECTED_COMPONENT_UNIQUE) THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"c':real^N->bool") THEN STRIP_TAC THEN
      REWRITE_TAC [← SET_RULE (← q r"c' SUBSET c <=> c' UNION c = c")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      MATCH_MP_TAC CONNECTED_UNION THEN ASM SET_TAC []])

  let JOINABLE_COMPONENTS_EQ ← prove
   r"!s t c1 c2.
        connected t /\ t SUBSET s /\
        c1 IN components s /\ c2 IN components s /\
        ~(c1 INTER t = {}) /\ ~(c2 INTER t = {})
        ==> c1 = c2"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, components, FORALL_IN_GSPEC] THEN
    MESON_TAC [JOINABLE_CONNECTED_COMPONENT_EQ])

  let CLOSED_IN_COMPONENT ← prove
   r"!s c:real^N->bool.
        c IN components s ==> closed_in (subtopology euclidean s) c"
   (REWRITE_TAC [components, FORALL_IN_GSPEC, CLOSED_IN_CONNECTED_COMPONENT])

  let CLOSED_COMPONENTS ← prove
   r"!s c. closed s /\ c IN components s ==> closed c"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, components, FORALL_IN_GSPEC] THEN
    SIMP_TAC [CLOSED_CONNECTED_COMPONENT])

  let COMPACT_CONNECTED_COMPONENT ← prove
   r"!s a:real^N. compact s ==> compact(connected_component s a)"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CLOSED_IN_COMPACT) THEN
    REWRITE_TAC [CLOSED_IN_CONNECTED_COMPONENT])

  let COMPACT_COMPONENTS ← prove
   r"!s c:real^N->bool. compact s /\ c IN components s ==> compact c"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN
    MESON_TAC [CLOSED_COMPONENTS, IN_COMPONENTS_SUBSET, BOUNDED_SUBSET])

  let CONTINUOUS_ON_COMPONENTS_GEN ← prove
   r"!f:real^M->real^N s.
        (!c. c IN components s
             ==> open_in (subtopology euclidean s) c /\ f continuous_on c)
        ==> f continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_OPEN_IN_PREIMAGE_EQ] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"t:real^N->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ (f:real^M->real^N) x IN t} =
      UNIONS {{x | x IN c /\ f x IN t} | c IN components s}")
    SUBST1_TAC THENL
     [CONV_TAC (LAND_CONV (SUBS_CONV
       [← ISPEC (← q r"s:real^M->bool") UNIONS_COMPONENTS])) THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_UNIONS] THEN SET_TAC [],
      MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ASM_MESON_TAC [OPEN_IN_TRANS]])

  return { components, EUCLIDEAN_CONNECTED_COMPONENTS_OF, PAIRWISE_SEPARATED_COMPONENTS,
           COMPONENTS_TRANSLATION, COMPONENTS_LINEAR_IMAGE, IN_COMPONENTS, CONNECTED_COMPONENTS,
           UNIONS_COMPONENTS, PAIRWISE_DISJOINT_COMPONENTS, IN_COMPONENTS_NONEMPTY,
           IN_COMPONENTS_SUBSET, IN_COMPONENTS_CONNECTED, CONNECTED_COMPONENT_IN_COMPONENTS,
           IN_COMPONENTS_MAXIMAL, JOINABLE_COMPONENTS_EQ, CLOSED_IN_COMPONENT, CLOSED_COMPONENTS,
           COMPACT_CONNECTED_COMPONENT, COMPACT_COMPONENTS, CONTINUOUS_ON_COMPONENTS_GEN }

/- ------------------------------------------------------------------------- -/
/- The set of connected components, continued.  (topology.ml 11511-11758)   -/
/- ------------------------------------------------------------------------- -/

structure CPN2 where
  CONTINUOUS_ON_COMPONENTS_FINITE : thm
  COMPONENTS_NONOVERLAP : thm
  COMPONENTS_EQ : thm
  COMPONENTS_EQ_EMPTY : thm
  COMPONENTS_EMPTY : thm
  CONNECTED_EQ_CONNECTED_COMPONENTS_EQ : thm
  COMPONENTS_EQ_SING : thm
  COMPONENTS_EQ_SING_EXISTS : thm
  CONNECTED_EQ_COMPONENTS_SING : thm
  CONNECTED_EQ_COMPONENTS_SING_EXISTS : thm
  CONNECTED_EQ_CARD_COMPONENTS : thm
  COMPONENTS_UNIV : thm
  CONNECTED_EQ_COMPONENTS_SUBSET_SING : thm
  CONNECTED_EQ_COMPONENTS_SUBSET_SING_EXISTS : thm
  IN_COMPONENTS_SELF : thm
  COMPONENTS_MAXIMAL : thm
  IN_COMPONENTS_MAXIMAL_ALT : thm
  COMPONENTS_UNIQUE : thm
  COMPONENTS_UNIQUE_EQ : thm
  COMPONENTS_UNIQUE_2 : thm
  EXISTS_COMPONENT_SUPERSET : thm
  COMPONENTS_INTERMEDIATE_SUBSET : thm
  FINITE_COMPONENTS_FINITE : thm
  COMPONENTS_FINITE : thm
  COMPONENTS_INTER_COMPONENTS : thm
  deriving Inhabited

@[nospecialize]
def setupCPN2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCON : CON) (BCLC : CLC) (BCCM1 : CCM1)
    (BCCM2 : CCM2) (BCPN1 : CPN1) : ExceptT String IO CPN2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, HAS_SIZE_CONV, .. } := D
  let { AND_FORALL_THM, EMPTY_SUBSET, EXTENSION, FINITE_IMAGE, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, HAS_SIZE, IMP_CONJ, IMP_IMP, IN,
        IN_ELIM_THM, IN_INTER, IN_SING, .. } := D.core2
  let { IN_UNIONS, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, LEFT_OR_DISTRIB, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_EMPTY, SUBSET_INTER, .. } := D.core5
  let { UNIONS_2, UNIONS_GSPEC, UNION_EMPTY, UNIV_NOT_EMPTY, .. } := D.core6
  let { CLOSED_IN_TRANS, CLOSED_IN_UNIONS, CONNECTED_COMPONENTS_OF_DISCRETE_TOPOLOGY, .. } :=
    D.met1
  let { FINITE_CONNECTED_COMPONENTS_OF_FINITE, .. } := D.met2
  let { SUBTOPOLOGY_EUCLIDEAN_EQ_DISCRETE_TOPOLOGY_FINITE, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } :=
    BEUC
  let { CONNECTED_EMPTY, CONNECTED_UNION, CONNECTED_UNIV, .. } := BCON
  let { CONTINUOUS_CLOSED_IN_PREIMAGE_EQ, .. } := BCLC
  let { CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_MAXIMAL, CONNECTED_COMPONENT_NONOVERLAP,
        CONNECTED_COMPONENT_REFL, CONNECTED_COMPONENT_SUBSET, CONNECTED_CONNECTED_COMPONENT,
        CONNECTED_CONNECTED_COMPONENT_SET, CONNECTED_EQ_CONNECTED_COMPONENT_EQ,
        connected_component, .. } := BCCM1
  let { CONNECTED_COMPONENT_INTERMEDIATE_SUBSET, CONNECTED_COMPONENT_UNIQUE, .. } := BCCM2
  let { CLOSED_IN_COMPONENT, EUCLIDEAN_CONNECTED_COMPONENTS_OF, IN_COMPONENTS,
        IN_COMPONENTS_CONNECTED, IN_COMPONENTS_MAXIMAL, IN_COMPONENTS_NONEMPTY,
        IN_COMPONENTS_SUBSET, UNIONS_COMPONENTS, components, .. } := BCPN1
  -- @@SCOPE END

  let CONTINUOUS_ON_COMPONENTS_FINITE ← prove
   r"!f:real^M->real^N s.
        FINITE(components s) /\
        (!c. c IN components s ==> f continuous_on c)
        ==> f continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_CLOSED_IN_PREIMAGE_EQ] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"t:real^N->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ (f:real^M->real^N) x IN t} =
      UNIONS {{x | x IN c /\ f x IN t} | c IN components s}")
    SUBST1_TAC THENL
     [CONV_TAC (LAND_CONV (SUBS_CONV
       [← ISPEC (← q r"s:real^M->bool") UNIONS_COMPONENTS])) THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_UNIONS] THEN SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_UNIONS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
      ASM_MESON_TAC [CLOSED_IN_TRANS, CLOSED_IN_COMPONENT]])

  let COMPONENTS_NONOVERLAP ← prove
   r"!s c c'. c IN components s /\ c' IN components s
            ==> (c INTER c' = {} <=> ~(c = c'))"
   (REWRITE_TAC [components, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [CONNECTED_COMPONENT_NONOVERLAP])

  let COMPONENTS_EQ ← prove
   r"!s c c'. c IN components s /\ c' IN components s
            ==> (c = c' <=> ~(c INTER c' = {}))"
   (MESON_TAC [COMPONENTS_NONOVERLAP])

  let COMPONENTS_EQ_EMPTY ← prove
   r"!s. components s = {} <=> s = {}"
   (GEN_TAC THEN REWRITE_TAC [EXTENSION] THEN
    REWRITE_TAC [components, connected_component, IN_ELIM_THM] THEN
    SET_TAC [])

  let COMPONENTS_EMPTY ← prove
   r"components {} = {}"
   (REWRITE_TAC [COMPONENTS_EQ_EMPTY])

  let CONNECTED_EQ_CONNECTED_COMPONENTS_EQ ← prove
   r"!s. connected s <=>
       !c c'. c IN components s /\ c' IN components s ==> c = c'"
   (REWRITE_TAC [components, IN_ELIM_THM] THEN
    MESON_TAC [CONNECTED_EQ_CONNECTED_COMPONENT_EQ])

  let (COMPONENTS_EQ_SING, COMPONENTS_EQ_SING_EXISTS) ← CONJ_PAIR (← prove
   r"(!s:real^N->bool. components s = {s} <=> connected s /\ ~(s = {})) /\
   (!s:real^N->bool. (?a. components s = {a}) <=> connected s /\ ~(s = {}))"
   (REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ (q ==> r) /\ (r ==> p)
                       ==> (p <=> r) /\ (q <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [],
      STRIP_TAC THEN ASM_REWRITE_TAC [CONNECTED_EQ_CONNECTED_COMPONENTS_EQ] THEN
      ASM_MESON_TAC [IN_SING, COMPONENTS_EQ_EMPTY, NOT_INSERT_EMPTY],
      STRIP_TAC THEN ONCE_REWRITE_TAC [EXTENSION] THEN
      REWRITE_TAC [IN_SING] THEN
      REWRITE_TAC [components, IN_ELIM_THM] THEN
      ASM_MESON_TAC [CONNECTED_CONNECTED_COMPONENT_SET, MEMBER_NOT_EMPTY]]))

  let CONNECTED_EQ_COMPONENTS_SING ← prove
   r"!s:real^N->bool. connected s <=> s = {} \/ components s = {s}"
   (MESON_TAC [COMPONENTS_EQ_SING, CONNECTED_EMPTY])

  let CONNECTED_EQ_COMPONENTS_SING_EXISTS ← prove
   r"!s:real^N->bool. connected s <=> s = {} \/ (?a. components s = {a})"
   (MESON_TAC [COMPONENTS_EQ_SING_EXISTS, CONNECTED_EMPTY])

  let CONNECTED_EQ_CARD_COMPONENTS ← prove
   r"!s:real^N->bool.
      connected s <=> FINITE(components s) /\ CARD(components s) <= 1"
   (GEN_TAC THEN REWRITE_TAC [CONNECTED_EQ_COMPONENTS_SING_EXISTS] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"n <= 1 <=> n = 0 \/ n = 1")] THEN
    REWRITE_TAC [IMP_IMP, LEFT_OR_DISTRIB, ← GSYM HAS_SIZE] THEN
    CONV_TAC (ONCE_DEPTH_CONV HAS_SIZE_CONV) THEN
    REWRITE_TAC [COMPONENTS_EQ_EMPTY])

  let COMPONENTS_UNIV ← prove
   r"components(:real^N) = {(:real^N)}"
   (REWRITE_TAC [COMPONENTS_EQ_SING, CONNECTED_UNIV, UNIV_NOT_EMPTY])

  let CONNECTED_EQ_COMPONENTS_SUBSET_SING ← prove
   r"!s:real^N->bool. connected s <=> components s SUBSET {s}"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [COMPONENTS_EMPTY, CONNECTED_EMPTY, EMPTY_SUBSET] THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET {a} <=> s = {} \/ s = {a}")] THEN
    ASM_REWRITE_TAC [COMPONENTS_EQ_EMPTY, COMPONENTS_EQ_SING])

  let CONNECTED_EQ_COMPONENTS_SUBSET_SING_EXISTS ← prove
   r"!s:real^N->bool. connected s <=> ?a. components s SUBSET {a}"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [COMPONENTS_EMPTY, CONNECTED_EMPTY, EMPTY_SUBSET] THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET {a} <=> s = {} \/ s = {a}")] THEN
    ASM_REWRITE_TAC [COMPONENTS_EQ_EMPTY, COMPONENTS_EQ_SING_EXISTS])

  let IN_COMPONENTS_SELF ← prove
   r"!s:real^N->bool. s IN components s <=> connected s /\ ~(s = {})"
   (GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_CONNECTED],
      SIMP_TAC [← GSYM COMPONENTS_EQ_SING, IN_SING]])

  let COMPONENTS_MAXIMAL ← prove
   r"!s t c:real^N->bool.
     c IN components s /\ connected t /\ t SUBSET s /\ ~(c INTER t = {})
     ==> t SUBSET c"
   (REWRITE_TAC [IMP_CONJ, components, FORALL_IN_GSPEC] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [IN_INTER, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP CONNECTED_COMPONENT_EQ) THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN ASM_REWRITE_TAC [])

  let IN_COMPONENTS_MAXIMAL_ALT ← prove
   r"!s c:real^N->bool.
        c IN components s <=>
        ~(c = {}) /\ c SUBSET s /\ connected c /\
        (!c'. ~(c INTER c' = {}) /\ c' SUBSET s /\ connected c'
              ==> c' SUBSET c)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_CONNECTED) THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC COMPONENTS_MAXIMAL THEN ASM_MESON_TAC [],
      STRIP_TAC THEN ASM_REWRITE_TAC [IN_COMPONENTS_MAXIMAL] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC []])

  let COMPONENTS_UNIQUE ← prove
   r"!s:real^N->bool k.
        UNIONS k = s /\
        (!c. c IN k
             ==> connected c /\ ~(c = {}) /\
                 !c'. connected c' /\ c SUBSET c' /\ c' SUBSET s ==> c' = c)
        ==> components s = k"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC id [EXTENSION] THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN REWRITE_TAC [IN_COMPONENTS] THEN
    EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N")
       (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o GEN_REWRITE_RULE id [EXTENSION]) THEN
      REWRITE_TAC [IN_UNIONS] THEN ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"connected_component s (x:real^N) = c")
       (fun th => ASM_REWRITE_TAC [th]) THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_UNIQUE THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"c':real^N->bool") THEN STRIP_TAC THEN
      REWRITE_TAC [← SET_RULE (← q r"c' SUBSET c <=> c' UNION c = c")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONNECTED_UNION, ASM SET_TAC []] THEN
      ASM SET_TAC [],
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
      CONJ_TAC THENL [ASM SET_TAC [], CONV_TAC SYM_CONV] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT, CONNECTED_COMPONENT_SUBSET] THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let COMPONENTS_UNIQUE_EQ ← prove
   r"!s:real^N->bool k.
        components s = k <=>
        UNIONS k = s /\
        (!c. c IN k
             ==> connected c /\ ~(c = {}) /\
                 !c'. connected c' /\ c SUBSET c' /\ c' SUBSET s ==> c' = c)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (SUBST1_TAC o SYM), REWRITE_TAC [COMPONENTS_UNIQUE]] THEN
    REWRITE_TAC [← GSYM UNIONS_COMPONENTS] THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED],
      ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY],
      RULE_ASSUM_TAC (REWRITE_RULE [IN_COMPONENTS_MAXIMAL]) THEN
      ASM_MESON_TAC [SUBSET_EMPTY]])

  let COMPONENTS_UNIQUE_2 ← prove
   r"!s c1 c2:real^N->bool.
        connected c1 /\ connected c2 /\ c1 UNION c2 = s /\ ~connected s
        ==> components s = {c1,c2}"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"c1:real^N->bool = {}") THENL
     [ASM_MESON_TAC [UNION_EMPTY], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"c2:real^N->bool = {}") THENL
     [ASM_MESON_TAC [UNION_EMPTY], ALL_TAC] THEN
    STRIP_TAC THEN MATCH_MP_TAC COMPONENTS_UNIQUE THEN
    ASM_REWRITE_TAC [UNIONS_2, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"c:real^N->bool", ← q r"c2:real^N->bool"]
          CONNECTED_UNION) THEN
      SUBGOAL_THEN (← q r"c UNION c2:real^N->bool = s") SUBST1_TAC THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      MP_TAC (← ISPECL [← q r"c1:real^N->bool", ← q r"c:real^N->bool"]
          CONNECTED_UNION) THEN
      SUBGOAL_THEN (← q r"c1 UNION c:real^N->bool = s") SUBST1_TAC THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let EXISTS_COMPONENT_SUPERSET ← prove
   r"!s t:real^N->bool.
        t SUBSET s /\ ~(s = {}) /\ connected t
        ==> ?c. c IN components s /\ t SUBSET c"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [EMPTY_SUBSET] THEN
      ASM_MESON_TAC [COMPONENTS_EQ_EMPTY, MEMBER_NOT_EMPTY],
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"a:real^N") o
        GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      EXISTS_TAC (← q r"connected_component s (a:real^N)") THEN
      REWRITE_TAC [IN_COMPONENTS] THEN CONJ_TAC THENL
       [ASM SET_TAC [], ASM_MESON_TAC [CONNECTED_COMPONENT_MAXIMAL]]])

  let COMPONENTS_INTERMEDIATE_SUBSET ← prove
   r"!s t u:real^N->bool.
        s IN components u /\ s SUBSET t /\ t SUBSET u
        ==> s IN components t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IN_COMPONENTS, LEFT_AND_EXISTS_THM] THEN
    MESON_TAC [CONNECTED_COMPONENT_INTERMEDIATE_SUBSET, SUBSET,
               CONNECTED_COMPONENT_REFL, IN, CONNECTED_COMPONENT_SUBSET])

  let FINITE_COMPONENTS_FINITE ← prove
   r"!s:real^N->bool. FINITE s ==> FINITE(components s)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM EUCLIDEAN_CONNECTED_COMPONENTS_OF] THEN
    MATCH_MP_TAC FINITE_CONNECTED_COMPONENTS_OF_FINITE THEN
    ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let COMPONENTS_FINITE ← prove
   r"!s:real^N->bool. FINITE s ==> components s = {{x} | x IN s}"
   (REWRITE_TAC [← GSYM EUCLIDEAN_CONNECTED_COMPONENTS_OF] THEN
    SIMP_TAC [SUBTOPOLOGY_EUCLIDEAN_EQ_DISCRETE_TOPOLOGY_FINITE] THEN
    REWRITE_TAC [CONNECTED_COMPONENTS_OF_DISCRETE_TOPOLOGY])

  let COMPONENTS_INTER_COMPONENTS ← prove
   r"!s t c d:real^N->bool.
        c IN components s /\ d IN components (t INTER c)
        ==> d IN components(t INTER s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [IN_COMPONENTS_MAXIMAL_ALT, SUBSET_INTER] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM SET_TAC [], REPEAT STRIP_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  return { CONTINUOUS_ON_COMPONENTS_FINITE, COMPONENTS_NONOVERLAP, COMPONENTS_EQ,
           COMPONENTS_EQ_EMPTY, COMPONENTS_EMPTY, CONNECTED_EQ_CONNECTED_COMPONENTS_EQ,
           COMPONENTS_EQ_SING, COMPONENTS_EQ_SING_EXISTS, CONNECTED_EQ_COMPONENTS_SING,
           CONNECTED_EQ_COMPONENTS_SING_EXISTS, CONNECTED_EQ_CARD_COMPONENTS, COMPONENTS_UNIV,
           CONNECTED_EQ_COMPONENTS_SUBSET_SING, CONNECTED_EQ_COMPONENTS_SUBSET_SING_EXISTS,
           IN_COMPONENTS_SELF, COMPONENTS_MAXIMAL, IN_COMPONENTS_MAXIMAL_ALT, COMPONENTS_UNIQUE,
           COMPONENTS_UNIQUE_EQ, COMPONENTS_UNIQUE_2, EXISTS_COMPONENT_SUPERSET,
           COMPONENTS_INTERMEDIATE_SUBSET, FINITE_COMPONENTS_FINITE, COMPONENTS_FINITE,
           COMPONENTS_INTER_COMPONENTS }

/- ------------------------------------------------------------------------- -/
/- The set of connected components, continued.  (topology.ml 11759-11995)   -/
/- ------------------------------------------------------------------------- -/

structure CPN3 where
  IN_COMPONENTS_UNIONS_COMPLEMENT : thm
  CONNECTED_SUBSET_CLOPEN : thm
  CLOPEN_UNIONS_COMPONENTS : thm
  CLOPEN_IN_COMPONENTS : thm
  CONNECTED_UNIONS_PAIRWISE : thm
  COMPONENTS_SEPARATED_UNION : thm
  COMPONENTS_COMPLEMENT_FRONTIER : thm
  CARD_LE_COMPONENTS_UNION : thm
  FINITE_COMPONENTS_UNION : thm
  COUNTABLE_COMPONENTS_UNION : thm
  MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER_ELEMENTWISE : thm
  MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupCPN3 [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLOC : LOC) (BCON : CON) (BINT : INT)
    (BCLS1 : CLS1) (BFRO1 : FRO1) (BCCM1 : CCM1) (BCCM2 : CCM2) (BCPN1 : CPN1) (BCPN2 : CPN2) :
    ExceptT String IO CPN3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, EXISTS_IN_GSPEC, EXISTS_IN_UNION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_UNION, IMAGE_EQ, IMAGE_UNION, IMP_CONJ, IMP_CONJ_ALT, IN,
        INSERT_SUBSET, INTER_COMM, IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIONS, IN_UNIV, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        NOT_EXISTS_THM, NOT_IMP, PSUBSET_ALT, .. } := D.core3
  let { RIGHT_EXISTS_AND_THM, SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_ANTISYM,
        SUBSET_RESTRICT, .. } := D.core5
  let { UNIONS_0, UNIONS_1, UNIONS_SUBSET, UNION_COMM, pairwise, .. } := D.core6
  let { CARD_ADD_FINITE_EQ, CARD_LE_COUNTABLE, CARD_LE_FINITE, CARD_LE_RELATIONAL_FULL,
        CARD_LE_TRANS, COUNTABLE_CARD_ADD_EQ, UNION_LE_ADD_C, .. } := D.lib1
  let { OPEN_IN_IMP_SUBSET, .. } := D.met3
  let { OPEN_CLOSED, .. } := BCLO
  let { CLOSED_IN_CLOSED, OPEN_IN_OPEN, .. } := BLOC
  let { CONNECTED_CLOSED_IN, CONNECTED_UNION, .. } := BCON
  let { INTERIOR_SUBSET, OPEN_INTERIOR, .. } := BINT
  let { CLOSURE_SUBSET, CONNECTED_INTERMEDIATE_CLOSURE, INTERIOR_COMPLEMENT,
        OPEN_INTER_CLOSURE_EQ_EMPTY, .. } := BCLS1
  let { FRONTIER_CLOSURES, frontier, .. } := BFRO1
  let { CONNECTED_COMPONENT_REFL_EQ, CONNECTED_COMPONENT_SUBSET, CONNECTED_COMPONENT_SYM,
        CONNECTED_COMPONENT_TRANS, CONNECTED_CONNECTED_COMPONENT,
        CONNECTED_IFF_CONNECTED_COMPONENT, connected_component, .. } := BCCM1
  let { COMPLEMENT_CONNECTED_COMPONENT_UNIONS, CONNECTED_COMPONENT_SEPARATED_UNION, .. } := BCCM2
  let { IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET,
        UNIONS_COMPONENTS, components, .. } := BCPN1
  let { COMPONENTS_EQ, COMPONENTS_INTERMEDIATE_SUBSET, COMPONENTS_MAXIMAL,
        CONNECTED_EQ_COMPONENTS_SUBSET_SING_EXISTS, CONNECTED_EQ_CONNECTED_COMPONENTS_EQ, .. } :=
    BCPN2
  -- @@SCOPE END

  let IN_COMPONENTS_UNIONS_COMPLEMENT ← prove
   r"!s c:real^N->bool.
        c IN components s
        ==> s DIFF c = UNIONS(components s DELETE c)"
   (REWRITE_TAC [components, FORALL_IN_GSPEC,
                 COMPLEMENT_CONNECTED_COMPONENT_UNIONS])

  let CONNECTED_SUBSET_CLOPEN ← prove
   r"!u s c:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) s /\
        connected c /\ c SUBSET u /\ ~(c INTER s = {})
        ==> c SUBSET s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_CLOSED_IN]) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_THEN (MP_TAC o
      SPECL [← q r"c INTER s:real^N->bool", ← q r"c DIFF s:real^N->bool"]) THEN
    ASM_REWRITE_TAC [CONJ_ASSOC, ← SET_RULE (← q r"c DIFF s = {} <=> c SUBSET s")] THEN
    MATCH_MP_TAC (← TAUT (← q r"p ==> ~(p /\ ~q) ==> q")) THEN
    REPLICATE_TAC 2 (CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []]) THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CLOSED_IN_CLOSED]),
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN])] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [OPEN_IN_OPEN, CLOSED_IN_CLOSED] THENL
     [EXISTS_TAC (← q r"t:real^N->bool"), EXISTS_TAC (← q r"(:real^N) DIFF t")] THEN
    ASM_REWRITE_TAC [← GSYM OPEN_CLOSED] THEN ASM SET_TAC [])

  let CLOPEN_UNIONS_COMPONENTS ← prove
   r"!u s:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) s
        ==> ?k. k SUBSET components u /\ s = UNIONS k"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"{c:real^N->bool | c IN components u /\ ~(c INTER s = {})}") THEN
    REWRITE_TAC [SUBSET_RESTRICT] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPEC (← q r"u:real^N->bool") UNIONS_COMPONENTS) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN SET_TAC [],
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_SUBSET_CLOPEN THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN
      ASM_MESON_TAC [IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET]])

  let CLOPEN_IN_COMPONENTS ← prove
   r"!u s:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) s /\
        connected s /\ ~(s = {})
        ==> s IN components u"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOPEN_UNIONS_COMPONENTS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"k:(real^N->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [UNIONS_0] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"c:real^N->bool")) THEN
    ASM_CASES_TAC (← q r"k = {c:real^N->bool}") THENL
     [ASM_MESON_TAC [UNIONS_1, ← GSYM SING_SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"~p ==> p /\ q ==> r")) THEN
    SUBGOAL_THEN (← q r"?c':real^N->bool. c' IN k /\ ~(c = c')") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [← SET_RULE
       (← q r"a IN s /\ ~(s = {a}) ==> ?b. b IN s /\ ~(b = a)")],
      REWRITE_TAC [CONNECTED_EQ_CONNECTED_COMPONENTS_EQ] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"c:real^N->bool", ← q r"c':real^N->bool"]) THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THEN
      MATCH_MP_TAC COMPONENTS_INTERMEDIATE_SUBSET THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN
      MP_TAC (← ISPEC (← q r"u:real^N->bool") UNIONS_COMPONENTS) THEN ASM SET_TAC []])

  let CONNECTED_UNIONS_PAIRWISE ← prove
   r"!f. (!s:real^N->bool. s IN f ==> connected s) /\
       pairwise (\s t. ~(s = {}) /\ ~(t = {}) ==> ~(s INTER t = {})) f
       ==> connected(UNIONS f)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [CONNECTED_EQ_COMPONENTS_SUBSET_SING_EXISTS] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"(?c. s SUBSET {c}) <=> !a b. a IN s /\ b IN s ==> a = b")] THEN
    MAP_EVERY X_GEN_TAC [← q r"c1:real^N->bool", ← q r"c2:real^N->bool"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"UNIONS f:real^N->bool", ← q r"c1:real^N->bool",
                      ← q r"c2:real^N->bool"]
      COMPONENTS_EQ) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    SUBGOAL_THEN
     (← q r"?a1:real^N a2:real^N. a1 IN c1 /\ a1 IN UNIONS f /\
                            a2 IN c2 /\ a2 IN UNIONS f")
    MP_TAC THENL
     [REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
      REWRITE_TAC [CONJ_ASSOC, LEFT_EXISTS_AND_THM] THEN CONJ_TAC THEN
      ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET,
                     MEMBER_NOT_EMPTY, SUBSET],
      REWRITE_TAC [IN_UNIONS, LEFT_IMP_EXISTS_THM, IMP_CONJ]] THEN
    MAP_EVERY X_GEN_TAC [← q r"a1:real^N", ← q r"a2:real^N"] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"s1:real^N->bool") THEN REPEAT DISCH_TAC THEN
    X_GEN_TAC (← q r"s2:real^N->bool") THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [pairwise]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"s1:real^N->bool", ← q r"s2:real^N->bool"]) THEN
    SUBGOAL_THEN
     (← q r"(s1:real^N->bool) SUBSET c1 /\ (s2:real^N->bool) SUBSET c2")
    MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    CONJ_TAC THEN MATCH_MP_TAC COMPONENTS_MAXIMAL THEN
    EXISTS_TAC (← q r"UNIONS f:real^N->bool") THEN ASM SET_TAC [])

  let COMPONENTS_SEPARATED_UNION ← prove
   r"!s t:real^N->bool.
        s INTER closure t = {} /\ t INTER closure s = {}
        ==> components(s UNION t) = components(s) UNION components(t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [components] THEN
    REWRITE_TAC [SIMPLE_IMAGE, IMAGE_UNION] THEN BINOP_TAC THEN
    MATCH_MP_TAC IMAGE_EQ THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM] THENL
     [ALL_TAC, ONCE_REWRITE_TAC [UNION_COMM]] THEN
    ASM_SIMP_TAC [CONNECTED_COMPONENT_SEPARATED_UNION])

  let COMPONENTS_COMPLEMENT_FRONTIER ← prove
   r"!s. components((:real^N) DIFF frontier s) =
       components(interior s) UNION components ((:real^N) DIFF closure s)"
   (GEN_TAC THEN REWRITE_TAC [FRONTIER_CLOSURES, ← SET_RULE
     (← q r"UNIV DIFF s INTER t = (UNIV DIFF s) UNION (UNIV DIFF t)")] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      COMPONENTS_SEPARATED_UNION o lhand o snd) THEN
    SIMP_TAC [OPEN_INTER_CLOSURE_EQ_EMPTY, ← GSYM INTERIOR_COMPLEMENT,
              OPEN_INTERIOR, ← SET_RULE (← q r"UNIV DIFF (UNIV DIFF s) = s")] THEN
    REWRITE_TAC [UNION_COMM, INTER_COMM] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"(:real^N) DIFF s") INTERIOR_SUBSET) THEN
    SET_TAC [])

  let CARD_LE_COMPONENTS_UNION ← prove
   r"!s t:real^N->bool.
        components(s UNION t) <=_c components(s) +_c components(t)"
   (REPEAT GEN_TAC THEN
    TRANS_TAC CARD_LE_TRANS (← q r"components(s:real^N->bool) UNION components t") THEN
    REWRITE_TAC [UNION_LE_ADD_C] THEN
    MATCH_MP_TAC (← ISPEC (← q r"\s t. ~(s INTER t = {})") CARD_LE_RELATIONAL_FULL) THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REWRITE_TAC [EXISTS_IN_UNION, components, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [FORALL_IN_UNION, EXISTS_IN_GSPEC] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THENL
       [DISJ1_TAC, DISJ2_TAC] THEN
      EXISTS_TAC (← q r"x:real^N") THEN ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_INTER] THEN REWRITE_TAC [IN] THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ, IN_UNION],
      MAP_EVERY X_GEN_TAC
       [← q r"c:real^N->bool", ← q r"d:real^N->bool", ← q r"e:real^N->bool"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"s UNION t:real^N->bool", ← q r"d:real^N->bool", ← q r"e:real^N->bool"]
       COMPONENTS_EQ) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(c INTER d = {}) ==> c SUBSET e ==> ~(d INTER e = {})"))) THEN
      MATCH_MP_TAC COMPONENTS_MAXIMAL THEN
      EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_UNION]) THEN
      DISCH_THEN (DISJ_CASES_THEN (fun th => tactic_of do
       pure (ASSUME_TAC (← MATCH_MP IN_COMPONENTS_CONNECTED th) THEN
             MP_TAC (← MATCH_MP IN_COMPONENTS_SUBSET th)))) THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let FINITE_COMPONENTS_UNION ← prove
   r"!s t:real^N->bool.
        FINITE(components s) /\ FINITE(components t)
        ==> FINITE(components(s UNION t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM CARD_ADD_FINITE_EQ] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_FINITE) THEN
    REWRITE_TAC [CARD_LE_COMPONENTS_UNION])

  let COUNTABLE_COMPONENTS_UNION ← prove
   r"!s t:real^N->bool.
        COUNTABLE(components s) /\ COUNTABLE(components t)
        ==> COUNTABLE(components(s UNION t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM COUNTABLE_CARD_ADD_EQ] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_COUNTABLE) THEN
    REWRITE_TAC [CARD_LE_COMPONENTS_UNION])

  let MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER_ELEMENTWISE ← prove
   r"!s c1 c2 a b t.
        c1 IN components((:real^N) DIFF s) /\
        c2 IN components((:real^N) DIFF s) /\
        a IN c1 /\ b IN c2 /\ frontier c1 = s /\ frontier c2 = s /\
        t PSUBSET s
        ==> connected_component ((:real^N) DIFF t) a b"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [PSUBSET_ALT]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"c:real^N")
          STRIP_ASSUME_TAC)) THEN
    REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"((c:real^N) INSERT c1) UNION (c INSERT c2)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_UNION THEN REWRITE_TAC [CONJ_ASSOC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      CONJ_TAC THEN MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THENL
       [EXISTS_TAC (← q r"c1:real^N->bool"), EXISTS_TAC (← q r"c2:real^N->bool")] THEN
      (CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED], ALL_TAC]) THEN
      REWRITE_TAC [INSERT_SUBSET, CLOSURE_SUBSET] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [frontier]) THEN ASM SET_TAC [],
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET)) THEN
      ASM SET_TAC []])

  let MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER ← prove
   r"!s t. t PSUBSET s /\ ~(s = (:real^N)) /\
         (!c. c IN components((:real^N) DIFF s) ==> frontier c = s)
         ==> connected((:real^N) DIFF t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV] THEN MATCH_MP_TAC (← MESON []
     (← q r"!Q. (!x y z. R x y /\ R y z ==> R x z) /\ (!x y. R x y ==> R y x) /\
          (?y. P y /\ Q y) /\
          (?y. P y /\ ~Q y) /\
          (!x y. P x /\ P y /\ Q x /\ ~Q y ==> R x y)
          ==> (!x y. P x /\ P y ==> R x y)")) THEN
    EXISTS_TAC (← q r"\x:real^N. x IN s") THEN
    REWRITE_TAC [CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS] THEN
    REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
    REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"a INSERT connected_component ((:real^N) DIFF s) b") THEN
    REWRITE_TAC [IN_INSERT] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THEN
      EXISTS_TAC (← q r"connected_component ((:real^N) DIFF s) b") THEN
      REWRITE_TAC [INSERT_SUBSET, CONNECTED_CONNECTED_COMPONENT] THEN
      CONJ_TAC THENL [SET_TAC [], REWRITE_TAC [CLOSURE_SUBSET]] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"connected_component ((:real^N) DIFF s) b")) THEN
      REWRITE_TAC [frontier] THEN ANTS_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [components, IN_ELIM_THM, IN_UNIV, IN_DIFF] THEN
      ASM_MESON_TAC [],
      ASM_REWRITE_TAC [INSERT_SUBSET, IN_UNIV, IN_DIFF] THEN
      MP_TAC (← ISPECL [← q r"(:real^N) DIFF s", ← q r"b:real^N"]
        CONNECTED_COMPONENT_SUBSET) THEN ASM SET_TAC [],
      DISJ2_TAC THEN REWRITE_TAC [IN] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN ASM SET_TAC []])

  return { IN_COMPONENTS_UNIONS_COMPLEMENT, CONNECTED_SUBSET_CLOPEN, CLOPEN_UNIONS_COMPONENTS,
           CLOPEN_IN_COMPONENTS, CONNECTED_UNIONS_PAIRWISE, COMPONENTS_SEPARATED_UNION,
           COMPONENTS_COMPLEMENT_FRONTIER, CARD_LE_COMPONENTS_UNION, FINITE_COMPONENTS_UNION,
           COUNTABLE_COMPONENTS_UNION, MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER_ELEMENTWISE,
           MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Continuity implies uniform continuity on a compact domain; uniformly     -/
/- convergent limits of continuous functions.  (topology.ml 11996-12182)     -/
/- ------------------------------------------------------------------------- -/

structure UCC where
  COMPACT_UNIFORMLY_EQUICONTINUOUS : thm
  COMPACT_UNIFORMLY_CONTINUOUS : thm
  CONTINUOUS_EQ_CAUCHY_CONTINUOUS_CLOSED : thm
  UNIFORMLY_CONTINUOUS_EQ_CAUCHY_CONTINUOUS_BOUNDED : thm
  CAUCHY_CONTINUOUS_EXTENDS_TO_CAUCHY_CONTINUOUS_CLOSURE : thm
  CAUCHY_CONTINUOUS_EQ_EXTENDS_TO_CLOSURE : thm
  UNIFORMLY_CONTINUOUS_ON_UNION : thm
  CONTINUOUS_UNIFORM_LIMIT : thm
  CONTINUOUS_UNIFORMLY_CAUCHY_LIMIT : thm
  deriving Inhabited

@[nospecialize]
def setupUCC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BCLS1 : CLS1) (BLIM2 : LIM2)
    (BBND1 : BND1) (BCPT : CPT) (BCMP : CMP) (BNST : NST) (BCNO : CNO) (BCSL : CSL) (BSQC : SQC)
    (BCCE : CCE) : ExceptT String IO UCC := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, NORM_ARITH, .. } := D
  let { ADD_SYM, CONTRAPOS_THM, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_UNWIND_THM2, IMP_CONJ, INFINITE, IN_ELIM_THM, IN_SING, .. } :=
    D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_ADD, MONO_EXISTS, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, .. } := D.core5
  let { UNIONS_GSPEC, o_DEF, .. } := D.core6
  let { INFINITE_ENUMERATE_WEAK, REAL_HALF, UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { DIST_REFL, DIST_SYM, .. } := D.vec1
  let { dist, .. } := D.vec4
  let { CONTINUOUS_MAP_UNIFORM_LIMIT, EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, .. } := BBAL
  let { CLOSED_CLOSURE, CLOSURE_INC, CLOSURE_SUBSET, .. } := BCLS1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { BOUNDED_UNION, .. } := BBND1
  let { COMPACT_CLOSURE, COMPACT_IMP_BOUNDED, HEINE_BOREL_LEMMA, .. } := BCPT
  let { CAUCHY_CONVERGENT_SUBSEQUENCE, CAUCHY_OFFSET, CAUCHY_SUBSEQUENCE, COMPLETE_EQ_CLOSED,
        CONVERGENT_IMP_CAUCHY, complete, .. } := BCMP
  let { UNIFORMLY_CONVERGENT_EQ_CAUCHY, .. } := BNST
  let { CONTINUOUS_MAP_EUCLIDEAN, continuous_on, uniformly_continuous_on, .. } := BCNO
  let { UNIFORMLY_CONTINUOUS_ON_EQ, UNIFORMLY_CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  let { CAUCHY_CONTINUOUS_EXTENDS_TO_CLOSURE, CAUCHY_CONTINUOUS_IMP_CONTINUOUS,
        CONTINUOUS_CLOSED_IMP_CAUCHY_CONTINUOUS, UNIFORMLY_CONTINUOUS_IMP_CAUCHY_CONTINUOUS,
        .. } := BCCE
  -- @@SCOPE END

  let COMPACT_UNIFORMLY_EQUICONTINUOUS ← prove
   r"!(fs:(real^M->real^N)->bool) s.
     (!x e. x IN s /\ &0 < e
            ==> ?d. &0 < d /\
                    (!f x'. f IN fs /\ x' IN s /\ dist (x',x) < d
                            ==> dist (f x',f x) < e)) /\
     compact s
     ==> !e. &0 < e
             ==> ?d. &0 < d /\
                     !f x x'. f IN fs /\ x IN s /\ x' IN s /\ dist (x',x) < d
                              ==> dist(f x',f x) < e"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"d:real^M->real->real") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP HEINE_BOREL_LEMMA) THEN
    DISCH_THEN (MP_TAC o SPEC
      (← q r"{ ball(x:real^M,d x (e / &2)) | x IN s}")) THEN
    SIMP_TAC [FORALL_IN_GSPEC, OPEN_BALL, UNIONS_GSPEC, SUBSET, IN_ELIM_THM] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [CENTRE_IN_BALL, REAL_HALF], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"u:real^M", ← q r"v:real^M"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"v:real^M") th) THEN
            ASM_REWRITE_TAC [] THEN DISCH_THEN (CHOOSE_THEN MP_TAC))) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"u:real^M") th) THEN
            MP_TAC (← SPEC (← q r"v:real^M") th))) THEN
    ASM_REWRITE_TAC [DIST_REFL] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"w:real^M") (CONJUNCTS_THEN2 ASSUME_TAC
      SUBST_ALL_TAC)) THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN ASM_REWRITE_TAC [IN_BALL] THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:real^M", ← q r"e / &2"]) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"f:real^M->real^N") o CONJUNCT2) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"u:real^M") th) THEN
            MP_TAC (← SPEC (← q r"v:real^M") th))) THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t))

  let COMPACT_UNIFORMLY_CONTINUOUS ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ compact s ==> f uniformly_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_on, uniformly_continuous_on] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{f:real^M->real^N}", ← q r"s:real^M->bool"]
          COMPACT_UNIFORMLY_EQUICONTINUOUS) THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, IN_SING, FORALL_UNWIND_THM2] THEN
    ASM_MESON_TAC [])

  let CONTINUOUS_EQ_CAUCHY_CONTINUOUS_CLOSED ← prove
   r"!f:real^M->real^N s.
        closed s
        ==> (f continuous_on s <=>
             !x. cauchy x /\ (!n. x n IN s) ==> cauchy(f o x))"
   (MESON_TAC [CAUCHY_CONTINUOUS_IMP_CONTINUOUS,
               CONTINUOUS_CLOSED_IMP_CAUCHY_CONTINUOUS])

  let UNIFORMLY_CONTINUOUS_EQ_CAUCHY_CONTINUOUS_BOUNDED ← prove
   r"!f:real^M->real^N s.
        bounded s
        ==> (f uniformly_continuous_on s <=>
             !x. cauchy x /\ (!n. x n IN s) ==> cauchy(f o x))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_IMP_CAUCHY_CONTINUOUS] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CAUCHY_CONTINUOUS_EXTENDS_TO_CLOSURE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC UNIFORMLY_CONTINUOUS_ON_EQ THEN
    EXISTS_TAC (← q r"g:real^M->real^N") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC UNIFORMLY_CONTINUOUS_ON_SUBSET THEN
    EXISTS_TAC (← q r"closure s:real^M->bool") THEN REWRITE_TAC [CLOSURE_SUBSET] THEN
    MATCH_MP_TAC COMPACT_UNIFORMLY_CONTINUOUS THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE])

  let CAUCHY_CONTINUOUS_EXTENDS_TO_CAUCHY_CONTINUOUS_CLOSURE ← prove
   r"!f:real^M->real^N s.
        (!x. cauchy x /\ (!n. (x n) IN s) ==> cauchy(f o x))
        ==> ?g. (!x. cauchy x /\ (!n. (x n) IN closure s) ==> cauchy(g o x)) /\
                (!x. x IN s ==> g x = f x)"
   (SIMP_TAC [← GSYM CONTINUOUS_EQ_CAUCHY_CONTINUOUS_CLOSED, CLOSED_CLOSURE] THEN
    REWRITE_TAC [CAUCHY_CONTINUOUS_EXTENDS_TO_CLOSURE])

  let CAUCHY_CONTINUOUS_EQ_EXTENDS_TO_CLOSURE ← prove
   r"!f:real^M->real^N s.
        (!x. cauchy x /\ (!n. (x n) IN s) ==> cauchy(f o x)) <=>
        ?g. g continuous_on closure s /\ (!x. x IN s ==> g x = f x)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    REWRITE_TAC [CAUCHY_CONTINUOUS_EXTENDS_TO_CLOSURE] THEN
    SIMP_TAC [CONTINUOUS_EQ_CAUCHY_CONTINUOUS_CLOSED, CLOSED_CLOSURE] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_SIMP_TAC [o_DEF] THEN
    REWRITE_TAC [← GSYM o_DEF] THEN ASM_SIMP_TAC [CLOSURE_INC])

  let UNIFORMLY_CONTINUOUS_ON_UNION ← prove
   r"!f:real^M->real^N s t.
        bounded s /\ bounded t /\
        f uniformly_continuous_on t /\
        f continuous_on (closure s UNION t)
        ==> f uniformly_continuous_on (s UNION t)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [UNIFORMLY_CONTINUOUS_EQ_CAUCHY_CONTINUOUS_BOUNDED,
                  BOUNDED_UNION, COMPACT_IMP_BOUNDED] THEN
    X_GEN_TAC (← q r"x:num->real^M") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"eventually (\n. (x:num->real^M) n IN t) sequentially") THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EVENTUALLY_SEQUENTIALLY]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:num")
        (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"n + k:num"))) THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [ADD_SYM] LE_ADD] THEN
      DISCH_TAC THEN
      UNDISCH_TAC (← q r"(f:real^M->real^N) uniformly_continuous_on t") THEN
      ASM_SIMP_TAC [UNIFORMLY_CONTINUOUS_EQ_CAUCHY_CONTINUOUS_BOUNDED] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\n. (x:num->real^M)(n + k)")) THEN
      UNDISCH_TAC (← q r"cauchy(x:num->real^M)") THEN ASM_REWRITE_TAC [o_DEF] THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(q <=> p) /\ (r <=> s) ==> p ==> (q ==> r) ==> s")) THEN
      CONJ_TAC THENL
       [MP_TAC (← SPEC (← q r"k:num")
          (← HolLight.INST_TYPE [(← qty "M", ← qty "N")] CAUCHY_OFFSET)),
        MP_TAC (← SPEC (← q r"k:num") CAUCHY_OFFSET)] THEN
      SIMP_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"{n | (x:num->real^M) n IN s}") INFINITE_ENUMERATE_WEAK) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN ANTS_TAC THENL
     [REWRITE_TAC [INFINITE] THEN DISCH_THEN (MP_TAC o
        ISPEC (← q r"\n:num. n") o MATCH_MP UPPER_BOUND_FINITE_SET) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
        [EVENTUALLY_SEQUENTIALLY]) THEN
      REWRITE_TAC [CONTRAPOS_THM, IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN EXISTS_TAC (← q r"N + 1") THEN
      ASM_MESON_TAC [IN_UNION, ← ARITH_RULE (← q r"~(n <= N /\ N + 1 <= n)")],
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN
     (← q r"?l. l IN closure s /\ ((\n. (x:num->real^M)(r n)) --> l) sequentially")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"closure s:real^M->bool") complete) THEN
      REWRITE_TAC [COMPLETE_EQ_CLOSED, CLOSED_CLOSURE] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC [CLOSURE_INC] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CAUCHY_SUBSEQUENCE THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"((x:num->real^M) --> l) sequentially") ASSUME_TAC THENL
     [MATCH_MP_TAC  CAUCHY_CONVERGENT_SUBSEQUENCE THEN
      EXISTS_TAC (← q r"r:num->num") THEN ASM_REWRITE_TAC [o_DEF],
      ALL_TAC] THEN
    MATCH_MP_TAC CONVERGENT_IMP_CAUCHY THEN
    EXISTS_TAC (← q r"(f:real^M->real^N) l") THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONTINUOUS_ON_SEQUENTIALLY]) THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_MESON_TAC [IN_UNION, CLOSURE_INC])

  let CONTINUOUS_UNIFORM_LIMIT ← prove
   r"!net f:A->real^M->real^N g s.
        ~(trivial_limit net) /\
        eventually (\n. (f n) continuous_on s) net /\
        (!e. &0 < e
             ==> eventually (\n. !x. x IN s ==> norm(f n x - g x) < e) net)
        ==> g continuous_on s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"net:A net", ← q r"subtopology euclidean (s:real^M->bool)",
                      ← q r"euclidean_metric:(real^N)metric", ← q r"f:A->real^M->real^N",
                      ← q r"g:real^M->real^N"] CONTINUOUS_MAP_UNIFORM_LIMIT) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN, MTOPOLOGY_EUCLIDEAN_METRIC, dist,
                     EUCLIDEAN_METRIC, IN_UNIV, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let CONTINUOUS_UNIFORMLY_CAUCHY_LIMIT ← prove
   r"!f:num->real^M->real^N s.
        eventually (\n. f n continuous_on s) sequentially /\
        (!e. &0 < e
            ==> ?N. !m n x. N <= m /\ N <= n /\ x IN s
                            ==> dist (f m x,f n x) < e)
        ==> ?g. g continuous_on s /\
                (!x. x IN s ==> ((\n. f n x) --> g x) sequentially)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [← GSYM UNIFORMLY_CONVERGENT_EQ_CAUCHY] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^M->real^N") THEN
    DISCH_TAC THEN CONJ_TAC THENL
     [MATCH_MP_TAC (← ISPEC (← q r"sequentially") CONTINUOUS_UNIFORM_LIMIT) THEN
      EXISTS_TAC (← q r"f:num->real^M->real^N") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
      ASM_MESON_TAC [dist],
      REWRITE_TAC [LIM_SEQUENTIALLY] THEN ASM_MESON_TAC []])

  return { COMPACT_UNIFORMLY_EQUICONTINUOUS, COMPACT_UNIFORMLY_CONTINUOUS,
           CONTINUOUS_EQ_CAUCHY_CONTINUOUS_CLOSED,
           UNIFORMLY_CONTINUOUS_EQ_CAUCHY_CONTINUOUS_BOUNDED,
           CAUCHY_CONTINUOUS_EXTENDS_TO_CAUCHY_CONTINUOUS_CLOSURE,
           CAUCHY_CONTINUOUS_EQ_EXTENDS_TO_CLOSURE, UNIFORMLY_CONTINUOUS_ON_UNION,
           CONTINUOUS_UNIFORM_LIMIT, CONTINUOUS_UNIFORMLY_CAUCHY_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Topological stuff lifted from and dropped to R.  (topology.ml 12183-12318) -/
/- ------------------------------------------------------------------------- -/

structure LFR where
  OPEN_LIFT : thm
  LIMPT_APPROACHABLE_LIFT : thm
  CLOSED_LIFT : thm
  CONTINUOUS_AT_LIFT_RANGE : thm
  CONTINUOUS_ON_LIFT_RANGE : thm
  CONTINUOUS_LIFT_NORM_COMPOSE : thm
  CONTINUOUS_ON_LIFT_NORM_COMPOSE : thm
  CONTINUOUS_AT_LIFT_NORM : thm
  CONTINUOUS_ON_LIFT_NORM : thm
  CONTINUOUS_MAP_NORM : thm
  PROPER_MAP_NORM_SIMPLE : thm
  PROPER_MAP_NORM : thm
  CLOSED_MAP_NORM : thm
  CONTINUOUS_AT_LIFT_COMPONENT : thm
  CONTINUOUS_ON_LIFT_COMPONENT : thm
  CONTINUOUS_AT_LIFT_INFNORM : thm
  CONTINUOUS_AT_LIFT_DIST : thm
  CONTINUOUS_ON_LIFT_DIST : thm
  deriving Inhabited

@[nospecialize]
def setupLFR [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLPT : LPT) (BLIM1 : LIM1)
    (BLIM2 : LIM2) (BBND1 : BND1) (BCPT : CPT) (BCPP1 : CPP1) (BCNT1 : CNT1) (BCNO : CNO)
    (BCSL : CSL) (BCLC : CLC) (BPRP1 : PRP1) (BCWL : CWL) : ExceptT String IO LFR := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, NORM_ARITH, NORM_ARITH_TAC, .. } := D
  let { FORALL_IN_GSPEC, IMP_CONJ, .. } := D.core2
  let { MONO_FORALL, MONO_IMP, .. } := D.core3
  let { REAL_LET_TRANS, .. } := D.core4
  let { SUBSET_UNIV, .. } := D.core5
  let { o_DEF, o_THM, .. } := D.core6
  let { COMPONENT_LE_NORM, DIST_LIFT, DIST_REAL, EXISTS_LIFT, FORALL_LIFT, .. } := D.vec1
  let { INFNORM_LE_NORM, LIFT_DROP, LIFT_EQ, LIFT_IN_IMAGE_LIFT, .. } := D.vec2
  let { NORM_LIFT, REAL_ABS_NORM, REAL_ABS_SUB_INFNORM, REAL_ABS_SUB_NORM, .. } := D.vec3
  let { VECTOR_SUB_COMPONENT, dist, drop, .. } := D.vec4
  let { EVENTUALLY_MONO, .. } := D.met2
  let { SUBTOPOLOGY_UNIV, .. } := D.met3
  let { CONTINUOUS_MAP_COMPOSE, .. } := D.met1
  let { open_def, .. } := BEUC
  let { CLOSED_IN, CLOSED_UNIV, .. } := BCLO
  let { CLOSED_LIMPT, LIMPT_APPROACHABLE, .. } := BLPT
  let { tendsto, .. } := BLIM1
  let { LIM_AT, .. } := BLIM2
  let { bounded, .. } := BBND1
  let { COMPACT_EQ_BOUNDED_CLOSED, .. } := BCPT
  let { CLOSED_INTER_COMPACT, .. } := BCPP1
  let { CONTINUOUS_AT, continuous, continuous_at, .. } := BCNT1
  let { CONTINUOUS_MAP_EUCLIDEAN, continuous_on, .. } := BCNO
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  let { CONTINUOUS_CLOSED_PREIMAGE_UNIV, .. } := BCLC
  let { PROPER_MAP, .. } := BPRP1
  let { CONTINUOUS_MAP_EQ_LIFT, .. } := BCWL
  -- @@SCOPE END

  let OPEN_LIFT ← prove
   r"!s. open(IMAGE lift s) <=>
        !x. x IN s ==> ?e. &0 < e /\ !x'. abs(x' - x) < e ==> x' IN s"
   (REWRITE_TAC [open_def, FORALL_LIFT, LIFT_IN_IMAGE_LIFT, DIST_LIFT])

  let LIMPT_APPROACHABLE_LIFT ← prove
   r"!x s. (lift x) limit_point_of (IMAGE lift s) <=>
         !e. &0 < e ==> ?x'. x' IN s /\ ~(x' = x) /\ abs(x' - x) < e"
   (REWRITE_TAC [LIMPT_APPROACHABLE, EXISTS_LIFT, LIFT_IN_IMAGE_LIFT,
                 LIFT_EQ, DIST_LIFT])

  let CLOSED_LIFT ← prove
   r"!s. closed (IMAGE lift s) <=>
        !x. (!e. &0 < e ==> ?x'. x' IN s /\ ~(x' = x) /\ abs(x' - x) < e)
            ==> x IN s"
   (GEN_TAC THEN REWRITE_TAC [CLOSED_LIMPT, LIMPT_APPROACHABLE] THEN
    ONCE_REWRITE_TAC [FORALL_LIFT] THEN
    REWRITE_TAC [LIMPT_APPROACHABLE_LIFT, LIFT_EQ, DIST_LIFT,
                 EXISTS_LIFT, LIFT_IN_IMAGE_LIFT])

  let CONTINUOUS_AT_LIFT_RANGE ← prove
   r"!f x. (lift o f) continuous (at x) <=>
                !e. &0 < e
                    ==> ?d. &0 < d /\
                            (!x'. norm(x' - x) < d
                                  ==> abs(f x' - f x) < e)"
   (REWRITE_TAC [continuous_at, o_THM, DIST_LIFT] THEN REWRITE_TAC [dist])

  let CONTINUOUS_ON_LIFT_RANGE ← prove
   r"!f s. (lift o f) continuous_on s <=>
         !x. x IN s
             ==> !e. &0 < e
                     ==> ?d. &0 < d /\
                             (!x'. x' IN s /\ norm(x' - x) < d
                                   ==> abs(f x' - f x) < e)"
   (REWRITE_TAC [continuous_on, o_THM, DIST_LIFT] THEN REWRITE_TAC [dist])

  let CONTINUOUS_LIFT_NORM_COMPOSE ← prove
   r"!net f:A->real^N.
        f continuous net
        ==> (\x. lift(norm(f x))) continuous net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous, tendsto] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [DIST_REAL, ← GSYM drop, LIFT_DROP] THEN
    NORM_ARITH_TAC)

  let CONTINUOUS_ON_LIFT_NORM_COMPOSE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s
        ==> (\x. lift(norm(f x))) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_LIFT_NORM_COMPOSE])

  let CONTINUOUS_AT_LIFT_NORM ← prove
   r"!x. (lift o norm) continuous (at x)"
   (REWRITE_TAC [CONTINUOUS_AT_LIFT_RANGE, NORM_LIFT] THEN
    MESON_TAC [REAL_ABS_SUB_NORM, REAL_LET_TRANS])

  let CONTINUOUS_ON_LIFT_NORM ← prove
   r"!s. (lift o norm) continuous_on s"
   (REWRITE_TAC [CONTINUOUS_ON_LIFT_RANGE, NORM_LIFT] THEN
    MESON_TAC [REAL_ABS_SUB_NORM, REAL_LET_TRANS])

  let CONTINUOUS_MAP_NORM ← prove
   r"!top (f:A->real^N).
        continuous_map (top,euclidean) f
        ==> continuous_map (top,euclideanreal) (\x. norm(f x))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_EQ_LIFT] THEN
    SUBGOAL_THEN (← q r"lift o (\x. norm((f:A->real^N) x)) = (lift o norm) o f")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"euclidean:(real^N)topology") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"(lift o norm):real^N->real^1", ← q r"(:real^N)"]
      CONTINUOUS_MAP_EUCLIDEAN) THEN
    REWRITE_TAC [SUBTOPOLOGY_UNIV, CONTINUOUS_ON_LIFT_NORM])

  let PROPER_MAP_NORM_SIMPLE ← prove
   r"!k. compact k ==> compact {x:real^N | lift(norm x) IN k}"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [bounded]) THEN
      REWRITE_TAC [bounded, FORALL_IN_GSPEC] THEN
      MESON_TAC [NORM_LIFT, REAL_ABS_NORM],
      MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
      ASM_REWRITE_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_AT_LIFT_NORM]])

  let PROPER_MAP_NORM ← prove
   r"!s t. closed s
         ==> !k. k SUBSET t /\ compact k
                 ==> compact {x:real^N | x IN s /\ lift(norm x) IN k}"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
    MATCH_MP_TAC CLOSED_INTER_COMPACT THEN
    ASM_SIMP_TAC [PROPER_MAP_NORM_SIMPLE])

  let CLOSED_MAP_NORM ← prove
   r"!s:real^N->bool. closed s ==> closed (IMAGE (lift o norm) s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(:real^N)", ← q r"(:real^1)"] PROPER_MAP_NORM) THEN
    REWRITE_TAC [CLOSED_UNIV] THEN
    SIMP_TAC [PROPER_MAP, SUBSET_UNIV] THEN
    ASM_SIMP_TAC [← GSYM CLOSED_IN, SUBTOPOLOGY_UNIV, o_DEF])

  let CONTINUOUS_AT_LIFT_COMPONENT ← prove
   r"!i a. 1 <= i /\ i <= dimindex(:N)
         ==> (\x:real^N. lift(x$i)) continuous (at a)"
   (SIMP_TAC [continuous_at, DIST_LIFT, ← GSYM VECTOR_SUB_COMPONENT] THEN
    MESON_TAC [dist, REAL_LET_TRANS, COMPONENT_LE_NORM])

  let CONTINUOUS_ON_LIFT_COMPONENT ← prove
   r"!i s. 1 <= i /\ i <= dimindex(:N)
         ==> (\x:real^N. lift(x$i)) continuous_on s"
   (SIMP_TAC [continuous_on, DIST_LIFT, ← GSYM VECTOR_SUB_COMPONENT] THEN
    MESON_TAC [dist, REAL_LET_TRANS, COMPONENT_LE_NORM])

  let CONTINUOUS_AT_LIFT_INFNORM ← prove
   r"!x:real^N. (lift o infnorm) continuous (at x)"
   (REWRITE_TAC [CONTINUOUS_AT, LIM_AT, o_THM, DIST_LIFT] THEN
    MESON_TAC [REAL_LET_TRANS, dist, REAL_ABS_SUB_INFNORM, INFNORM_LE_NORM])

  let CONTINUOUS_AT_LIFT_DIST ← prove
   r"!a:real^N x. (lift o (\x. dist(a,x))) continuous (at x)"
   (REWRITE_TAC [CONTINUOUS_AT_LIFT_RANGE] THEN
    MESON_TAC [← NORM_ARITH (← q r"abs(dist(a:real^N,x) - dist(a,y)) <= norm(x - y)"),
               REAL_LET_TRANS])

  let CONTINUOUS_ON_LIFT_DIST ← prove
   r"!a s. (lift o (\x. dist(a,x))) continuous_on s"
   (REWRITE_TAC [CONTINUOUS_ON_LIFT_RANGE] THEN
    MESON_TAC [← NORM_ARITH (← q r"abs(dist(a:real^N,x) - dist(a,y)) <= norm(x - y)"),
               REAL_LET_TRANS])

  return { OPEN_LIFT, LIMPT_APPROACHABLE_LIFT, CLOSED_LIFT, CONTINUOUS_AT_LIFT_RANGE,
           CONTINUOUS_ON_LIFT_RANGE, CONTINUOUS_LIFT_NORM_COMPOSE,
           CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_AT_LIFT_NORM, CONTINUOUS_ON_LIFT_NORM,
           CONTINUOUS_MAP_NORM, PROPER_MAP_NORM_SIMPLE, PROPER_MAP_NORM, CLOSED_MAP_NORM,
           CONTINUOUS_AT_LIFT_COMPONENT, CONTINUOUS_ON_LIFT_COMPONENT,
           CONTINUOUS_AT_LIFT_INFNORM, CONTINUOUS_AT_LIFT_DIST, CONTINUOUS_ON_LIFT_DIST }

/- ------------------------------------------------------------------------- -/
/- Distance, diameter etc. of/from a set; minimal distance needs only        -/
/- closure.  (topology.ml 12319-12388)                                        -/
/- ------------------------------------------------------------------------- -/

structure DST where
  COMPACT_ATTAINS_SUP : thm
  COMPACT_ATTAINS_INF : thm
  CONTINUOUS_ATTAINS_SUP : thm
  CONTINUOUS_ATTAINS_INF : thm
  DISTANCE_ATTAINS_SUP : thm
  DISTANCE_ATTAINS_INF : thm
  deriving Inhabited

@[nospecialize]
def setupDST [HolBase] (D : TopologyDeps) (BCLO : CLO) (BBAL : BAL) (BCBL : CBL) (BBND1 : BND1)
    (BBND2 : BND2) (BCPT : CPT) (BLCP : LCP) (BLFR : LFR) : ExceptT String IO DST := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, VECTOR_ARITH, .. } := D
  let { IMAGE_EQ_EMPTY, IMAGE_o, IN_IMAGE, IN_INTER, .. } := D.core2
  let { MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_REFL, REAL_LE_TOTAL, REAL_LE_TRANS, .. } := D.core4
  let { DIST_SYM, .. } := D.vec1
  let { NORM_NEG, NORM_SUB, REAL_ABS_SUB_NORM, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { CLOSED_INTER, .. } := BCLO
  let { IN_CBALL, .. } := BBAL
  let { CLOSED_CBALL, .. } := BCBL
  let { BOUNDED_CBALL, BOUNDED_INTER, .. } := BBND1
  let { BOUNDED_HAS_INF, BOUNDED_HAS_SUP, .. } := BBND2
  let { COMPACT_EQ_BOUNDED_CLOSED, .. } := BCPT
  let { COMPACT_CONTINUOUS_IMAGE, .. } := BLCP
  let { CLOSED_LIFT, CONTINUOUS_ON_LIFT_RANGE, .. } := BLFR
  -- @@SCOPE END

  let COMPACT_ATTAINS_SUP ← prove
   r"!s. compact (IMAGE lift s) /\ ~(s = {})
       ==> ?x. x IN s /\ !y. y IN s ==> y <= x"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← SPEC (← q r"s:real->bool") BOUNDED_HAS_SUP) THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"sup s") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [CLOSED_LIFT, ← REAL_ARITH (← q r"s <= s - e <=> ~(&0 < e)"),
                   ← REAL_ARITH (← q r"x <= s /\ ~(x <= s - e) ==> abs(x - s) < e")])

  let COMPACT_ATTAINS_INF ← prove
   r"!s. compact (IMAGE lift s) /\ ~(s = {})
       ==> ?x. x IN s /\ !y. y IN s ==> x <= y"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← SPEC (← q r"s:real->bool") BOUNDED_HAS_INF) THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"inf s") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [CLOSED_LIFT, ← REAL_ARITH (← q r"s + e <= s <=> ~(&0 < e)"),
                   ← REAL_ARITH (← q r"s <= x /\ ~(s + e <= x) ==> abs(x - s) < e")])

  let CONTINUOUS_ATTAINS_SUP ← prove
   r"!f:real^N->real s.
        compact s /\ ~(s = {}) /\ (lift o f) continuous_on s
        ==> ?x. x IN s /\ !y. y IN s ==> f(y) <= f(x)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPEC (← q r"IMAGE (f:real^N->real) s") COMPACT_ATTAINS_SUP) THEN
    ASM_SIMP_TAC [← GSYM IMAGE_o, COMPACT_CONTINUOUS_IMAGE, IMAGE_EQ_EMPTY] THEN
    MESON_TAC [IN_IMAGE])

  let CONTINUOUS_ATTAINS_INF ← prove
   r"!f:real^N->real s.
        compact s /\ ~(s = {}) /\ (lift o f) continuous_on s
        ==> ?x. x IN s /\ !y. y IN s ==> f(x) <= f(y)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPEC (← q r"IMAGE (f:real^N->real) s") COMPACT_ATTAINS_INF) THEN
    ASM_SIMP_TAC [← GSYM IMAGE_o, COMPACT_CONTINUOUS_IMAGE, IMAGE_EQ_EMPTY] THEN
    MESON_TAC [IN_IMAGE])

  let DISTANCE_ATTAINS_SUP ← prove
   r"!s a. compact s /\ ~(s = {})
         ==> ?x. x IN s /\ !y. y IN s ==> dist(a,y) <= dist(a,x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ATTAINS_SUP THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_LIFT_RANGE] THEN REWRITE_TAC [dist] THEN
    ASM_MESON_TAC [REAL_LET_TRANS, REAL_ABS_SUB_NORM, NORM_NEG,
                   ← VECTOR_ARITH (← q r"(a - x) - (a - y) = --(x - y):real^N")])

  let DISTANCE_ATTAINS_INF ← prove
   r"!s a:real^N.
        closed s /\ ~(s = {})
        ==> ?x. x IN s /\ !y. y IN s ==> dist(a,x) <= dist(a,y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"b:real^N")) THEN
    MP_TAC (← ISPECL [← q r"\x:real^N. dist(a,x)", ← q r"cball(a:real^N,dist(b,a)) INTER s"]
                  CONTINUOUS_ATTAINS_INF) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_INTER, BOUNDED_INTER,
                    BOUNDED_CBALL, CLOSED_CBALL, ← GSYM MEMBER_NOT_EMPTY] THEN
      REWRITE_TAC [dist, CONTINUOUS_ON_LIFT_RANGE, IN_INTER, IN_CBALL] THEN
      ASM_MESON_TAC [REAL_LET_TRANS, REAL_ABS_SUB_NORM, NORM_NEG, REAL_LE_REFL,
              NORM_SUB, ← VECTOR_ARITH (← q r"(a - x) - (a - y) = --(x - y):real^N")],
      MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [IN_INTER, IN_CBALL] THEN
      ASM_MESON_TAC [DIST_SYM, REAL_LE_TOTAL, REAL_LE_TRANS]])

  return { COMPACT_ATTAINS_SUP, COMPACT_ATTAINS_INF, CONTINUOUS_ATTAINS_SUP,
           CONTINUOUS_ATTAINS_INF, DISTANCE_ATTAINS_SUP, DISTANCE_ATTAINS_INF }

/- ------------------------------------------------------------------------- -/
/- Limit compositions with a scalar multiplier; continuity of inverse.      -/
/- (topology.ml 12389-12519)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SMI where
  LIM_MUL : thm
  LIM_LIFT_POW : thm
  LIM_LIFT_PRODUCT : thm
  LIM_VMUL : thm
  CONTINUOUS_VMUL : thm
  CONTINUOUS_MUL : thm
  CONTINUOUS_ON_VMUL : thm
  CONTINUOUS_ON_MUL : thm
  CONTINUOUS_LIFT_POW : thm
  CONTINUOUS_ON_LIFT_POW : thm
  CONTINUOUS_LIFT_PRODUCT : thm
  CONTINUOUS_ON_LIFT_PRODUCT : thm
  LIM_INV : thm
  CONTINUOUS_INV : thm
  CONTINUOUS_AT_WITHIN_INV : thm
  CONTINUOUS_AT_INV : thm
  CONTINUOUS_ON_INV : thm
  deriving Inhabited

@[nospecialize]
def setupSMI [HolBase] (D : TopologyDeps) (BCWL : CWL) (BNET : NET) (BLIM1 : LIM1) (BARI : ARI)
    (BUNQ : UNQ) (BCNT1 : CNT1) (BCSL : CSL) (BCMB : CMB) (BCMS : CMS) :
    ExceptT String IO SMI := do
  -- @@SCOPE BEGIN
  let { INDUCT_TAC, VECTOR_ARITH_TAC, .. } := D
  let { ETA_AX, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_INSERT, IMP_CONJ, .. } := D.core2
  let { PRODUCT_CLAUSES, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, .. } := D.core5
  let { o_DEF, o_THM, real_pow, .. } := D.core6
  let { DROP_ADD, DROP_CMUL, .. } := D.vec1
  let { LIFT_CMUL, LIFT_DROP, .. } := D.vec2
  let { bilinear, linear, .. } := D.vec4
  let { LIMIT_REAL_INV, .. } := D.met2
  let { LIMIT_EQ_DROP, .. } := BCWL
  let { NETLIMIT_WITHIN, WITHIN_UNIV, .. } := BNET
  let { LIMIT_EUCLIDEAN, .. } := BLIM1
  let { LIM_CONST, .. } := BARI
  let { LIM_BILINEAR, .. } := BUNQ
  let { CONTINUOUS_TRIVIAL_LIMIT, continuous, .. } := BCNT1
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  let { CONTINUOUS_CONST, .. } := BCMB
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  -- @@SCOPE END

  let LIM_MUL ← prove
   r"!net:(A)net f l:real^N c d.
        ((lift o c) --> lift d) net /\ (f --> l) net
        ==> ((\x. c(x) % f(x)) --> (d % l)) net"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"net:(A)net", ← q r"\x (y:real^N). drop x % y",
    ← q r"lift o (c:A->real)", ← q r"f:A->real^N", ← q r"lift d", ← q r"l:real^N"]
      LIM_BILINEAR) THEN
    ASM_REWRITE_TAC [LIFT_DROP, o_THM] THEN DISCH_THEN MATCH_MP_TAC THEN
    REWRITE_TAC [bilinear, linear, DROP_ADD, DROP_CMUL] THEN
    REPEAT STRIP_TAC THEN VECTOR_ARITH_TAC)

  let LIM_LIFT_POW ← prove
   r"!net:(A)net f l n.
        ((\a. lift(f a)) --> lift l) net
        ==> ((\a. lift(f(a) pow n)) --> lift(l pow n)) net"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN REWRITE_TAC [real_pow, LIM_CONST, LIFT_CMUL] THEN
    MATCH_MP_TAC LIM_MUL THEN ASM_REWRITE_TAC [o_DEF])

  let LIM_LIFT_PRODUCT ← prove
   r"!net:(A)net f g (t:B->bool).
        FINITE t /\
        (!i. i IN t ==> ((\x. lift(f x i)) --> lift(g i)) net)
        ==> ((\x. lift(product t (f x))) --> lift(product t g)) net"
   (REPLICATE_TAC 3 GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN SIMP_TAC [PRODUCT_CLAUSES] THEN
    REWRITE_TAC [LIM_CONST, LIFT_CMUL, FORALL_IN_INSERT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_MUL THEN
    ASM_SIMP_TAC [o_DEF])

  let LIM_VMUL ← prove
   r"!net:(A)net c d v:real^N.
        ((lift o c) --> lift d) net ==> ((\x. c(x) % v) --> d % v) net"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_MUL THEN ASM_REWRITE_TAC [LIM_CONST])

  let CONTINUOUS_VMUL ← prove
   r"!net c v. (lift o c) continuous net ==> (\x. c(x) % v) continuous net"
   (REWRITE_TAC [continuous, LIM_VMUL, o_THM])

  let CONTINUOUS_MUL ← prove
   r"!net f c. (lift o c) continuous net /\ f continuous net
             ==> (\x. c(x) % f(x)) continuous net"
   (REWRITE_TAC [continuous, LIM_MUL, o_THM])

  let CONTINUOUS_ON_VMUL ← prove
   r"!s c v. (lift o c) continuous_on s ==> (\x. c(x) % v) continuous_on s"
   (REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    SIMP_TAC [CONTINUOUS_VMUL])

  let CONTINUOUS_ON_MUL ← prove
   r"!s c f. (lift o c) continuous_on s /\ f continuous_on s
           ==> (\x. c(x) % f(x)) continuous_on s"
   (REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    SIMP_TAC [CONTINUOUS_MUL])

  let CONTINUOUS_LIFT_POW ← prove
   r"!net f:A->real n.
        (\x. lift(f x)) continuous net
        ==> (\x. lift(f x pow n)) continuous net"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [LIFT_CMUL, real_pow, CONTINUOUS_CONST] THEN
    MATCH_MP_TAC CONTINUOUS_MUL THEN ASM_REWRITE_TAC [o_DEF])

  let CONTINUOUS_ON_LIFT_POW ← prove
   r"!f:real^N->real s n.
        (\x. lift(f x)) continuous_on s
        ==> (\x. lift(f x pow n)) continuous_on s"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN
    DISCH_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [LIFT_CMUL, real_pow, CONTINUOUS_ON_CONST] THEN
    MATCH_MP_TAC CONTINUOUS_ON_MUL THEN ASM_REWRITE_TAC [o_DEF])

  let CONTINUOUS_LIFT_PRODUCT ← prove
   r"!net:(A)net f (t:B->bool).
        FINITE t /\
        (!i. i IN t ==> (\x. lift(f x i)) continuous net)
        ==> (\x. lift(product t (f x))) continuous net"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN SIMP_TAC [PRODUCT_CLAUSES] THEN
    REWRITE_TAC [CONTINUOUS_CONST, LIFT_CMUL, FORALL_IN_INSERT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_MUL THEN
    ASM_SIMP_TAC [o_DEF])

  let CONTINUOUS_ON_LIFT_PRODUCT ← prove
   r"!f:real^N->A->real s t.
        FINITE t /\
        (!i. i IN t ==> (\x. lift(f x i)) continuous_on s)
        ==> (\x. lift(product t (f x))) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_LIFT_PRODUCT])

  let LIM_INV ← prove
   r"!net:(A)net f l.
        ((lift o f) --> lift l) net /\ ~(l = &0)
        ==> ((lift o inv o f) --> lift(inv l)) net"
   (REWRITE_TAC [← GSYM LIMIT_EUCLIDEAN, LIMIT_REAL_INV, LIMIT_EQ_DROP,
                 LIFT_DROP, ETA_AX, o_DEF])

  let CONTINUOUS_INV ← prove
   r"!net f. (lift o f) continuous net /\ ~(f(netlimit net) = &0)
           ==> (lift o inv o f) continuous net"
   (REWRITE_TAC [continuous, LIM_INV, o_THM])

  let CONTINUOUS_AT_WITHIN_INV ← prove
   r"!f s a:real^N.
        (lift o f) continuous (at a within s) /\ ~(f a = &0)
        ==> (lift o inv o f) continuous (at a within s)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"trivial_limit (at (a:real^N) within s)") THEN
    ASM_SIMP_TAC [CONTINUOUS_TRIVIAL_LIMIT] THEN
    ASM_SIMP_TAC [NETLIMIT_WITHIN, CONTINUOUS_INV])

  let CONTINUOUS_AT_INV ← prove
   r"!f a. (lift o f) continuous at a /\ ~(f a = &0)
         ==> (lift o inv o f) continuous at a"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_AT_WITHIN_INV])

  let CONTINUOUS_ON_INV ← prove
   r"!f s. (lift o f) continuous_on s /\ (!x. x IN s ==> ~(f x = &0))
         ==> (lift o inv o f) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_AT_WITHIN_INV])

  return { LIM_MUL, LIM_LIFT_POW, LIM_LIFT_PRODUCT, LIM_VMUL, CONTINUOUS_VMUL, CONTINUOUS_MUL,
           CONTINUOUS_ON_VMUL, CONTINUOUS_ON_MUL, CONTINUOUS_LIFT_POW, CONTINUOUS_ON_LIFT_POW,
           CONTINUOUS_LIFT_PRODUCT, CONTINUOUS_ON_LIFT_PRODUCT, LIM_INV, CONTINUOUS_INV,
           CONTINUOUS_AT_WITHIN_INV, CONTINUOUS_AT_INV, CONTINUOUS_ON_INV }

/- ------------------------------------------------------------------------- -/
/- More preservation properties for pasted sets (Cartesian products).      -/
/- (topology.ml 12520-12709)                                                 -/
/- ------------------------------------------------------------------------- -/

structure PCA1 where
  CONTINUOUS_MAP_PASTECART : thm
  LIM_PASTECART : thm
  LIM_PASTECART_EQ : thm
  CONTINUOUS_PASTECART : thm
  CONTINUOUS_ON_PASTECART : thm
  CONTINUOUS_FSTCART : thm
  CONTINUOUS_SNDCART : thm
  CONTINUOUS_ON_FSTCART : thm
  CONTINUOUS_ON_SNDCART : thm
  CONNECTED_PCROSS : thm
  CONNECTED_PCROSS_EQ : thm
  CONNECTED_COMPONENT_PCROSS : thm
  COMPONENTS_PCROSS : thm
  CLOSURE_PCROSS : thm
  LIMPT_PCROSS : thm
  deriving Inhabited

@[nospecialize]
def setupPCA1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCON : CON) (BLPT : LPT) (BCLS1 : CLS1)
    (BLIM1 : LIM1) (BARI : ARI) (BCNT1 : CNT1) (BCSL : CSL) (BCMS : CMS) (BIDC : IDC)
    (BLCP : LCP) (BCCM1 : CCM1) (BCCM2 : CCM2) (BCPN1 : CPN1) : ExceptT String IO PCA1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { EQ_IMP, ETA_AX, EXISTS_IN_IMAGE, EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_IMAGE, FORALL_PAIR_THM, FORALL_PASTECART, FSTCART_PASTECART,
        IMP_CONJ, IMP_IMP, IN, IN_CROSS, IN_ELIM_PASTECART_THM, IN_IMAGE, IN_INTER, .. } :=
    D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_IN_EMPTY,
        PASTECART_FST_SND, PASTECART_INJ, PASTECART_IN_PCROSS, PCROSS, PCROSS_EMPTY,
        PCROSS_EQ_EMPTY, .. } := D.core3
  let { REAL_LET_TRANS, .. } := D.core4
  let { SIMPLE_IMAGE, SNDCART_PASTECART, SUBSET, SUBSET_PCROSS, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { DIST_PASTECART_LE, .. } := D.vec1
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { NORM_LE_PASTECART, NORM_PASTECART, NORM_PASTECART_LE, PASTECART_SUB, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { EVENTUALLY_AND, EVENTUALLY_MONO, METRIC_CONTINUOUS_MAP, MTOPOLOGY_PROD_METRIC, .. } :=
    D.met2
  let { PROD_METRIC, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, .. } := BEUC
  let { CONNECTED_EMPTY, CONNECTED_UNION, .. } := BCON
  let { LIMPT_APPROACHABLE, .. } := BLPT
  let { CLOSURE_APPROACHABLE, .. } := BCLS1
  let { tendsto, .. } := BLIM1
  let { LIM_LINEAR, .. } := BARI
  let { continuous, .. } := BCNT1
  let { CONTINUOUS_ON, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { CONNECTED_CONTINUOUS_IMAGE, LINEAR_CONTINUOUS_COMPOSE, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CONNECTED_COMPONENT_EQ_EMPTY, CONNECTED_COMPONENT_REFL_EQ, CONNECTED_COMPONENT_SUBSET,
        CONNECTED_CONNECTED_COMPONENT, CONNECTED_IFF_CONNECTED_COMPONENT, connected_component,
        .. } := BCCM1
  let { CONNECTED_COMPONENT_UNIQUE, .. } := BCCM2
  let { components, .. } := BCPN1
  -- @@SCOPE END

  let CONTINUOUS_MAP_PASTECART ← prove
   r"continuous_map
     (prod_topology (euclidean:(real^M)topology) (euclidean:(real^N)topology),
      euclidean)
     (\(x,y). pastecart x y)"
   (REWRITE_TAC [← GSYM MTOPOLOGY_PROD_METRIC, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [METRIC_CONTINUOUS_MAP, PROD_METRIC, EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, IN_UNIV] THEN
    REWRITE_TAC [dist, NORM_PASTECART, PASTECART_SUB] THEN MESON_TAC [])

  let LIM_PASTECART ← prove
   r"!net f:A->real^M g:A->real^N.
        (f --> a) net /\ (g --> b) net
        ==> ((\x. pastecart (f x) (g x)) --> pastecart a b) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"e / &2"))) THEN
    ASM_REWRITE_TAC [REAL_HALF, IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [] THEN MESON_TAC [DIST_PASTECART_LE,
     ← REAL_ARITH (← q r"x <= a + b /\ a < e / &2 /\ b < e / &2 ==> x < e")])

  let LIM_PASTECART_EQ ← prove
   r"!net f:A->real^M g:A->real^N.
        ((\x. pastecart (f x) (g x)) --> pastecart a b) net <=>
        (f --> a) net /\ (g --> b) net"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [LIM_PASTECART] THEN
    REPEAT STRIP_TAC THENL
     [FIRST_ASSUM (MP_TAC o ISPEC (← q r"fstcart:real^(M,N)finite_sum->real^M") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] LIM_LINEAR)) THEN
      REWRITE_TAC [LINEAR_FSTCART, FSTCART_PASTECART, ETA_AX],
      FIRST_ASSUM (MP_TAC o ISPEC (← q r"sndcart:real^(M,N)finite_sum->real^N") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] LIM_LINEAR)) THEN
      REWRITE_TAC [LINEAR_SNDCART, SNDCART_PASTECART, ETA_AX]])

  let CONTINUOUS_PASTECART ← prove
   r"!net f:A->real^M g:A->real^N.
        f continuous net /\ g continuous net
        ==> (\x. pastecart (f x) (g x)) continuous net"
   (REWRITE_TAC [continuous, LIM_PASTECART])

  let CONTINUOUS_ON_PASTECART ← prove
   r"!f:real^M->real^N g:real^M->real^P s.
        f continuous_on s /\ g continuous_on s
        ==> (\x. pastecart (f x) (g x)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON, LIM_PASTECART])

  let CONTINUOUS_FSTCART ← prove
   r"!net f:A->real^(M,N)finite_sum.
      f continuous net ==> (\x. fstcart(f x)) continuous net"
   (SIMP_TAC [LINEAR_CONTINUOUS_COMPOSE, LINEAR_FSTCART])

  let CONTINUOUS_SNDCART ← prove
   r"!net f:A->real^(M,N)finite_sum.
      f continuous net ==> (\x. sndcart(f x)) continuous net"
   (SIMP_TAC [LINEAR_CONTINUOUS_COMPOSE, LINEAR_SNDCART])

  let CONTINUOUS_ON_FSTCART ← prove
   r"!f:real^M->real^(N,P)finite_sum.
        f continuous_on s ==> (\x. fstcart(f x)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_FSTCART])

  let CONTINUOUS_ON_SNDCART ← prove
   r"!f:real^M->real^(N,P)finite_sum.
        f continuous_on s ==> (\x. sndcart(f x)) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_SNDCART])

  let CONNECTED_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        connected s /\ connected t
        ==> connected (s PCROSS t)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [PCROSS, CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    DISCH_TAC THEN REWRITE_TAC [FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x1:real^M", ← q r"y1:real^N", ← q r"x2:real^M",
                         ← q r"y2:real^N"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (CONJUNCTS_THEN2
     (MP_TAC o SPECL [← q r"x1:real^M", ← q r"x2:real^M"])
     (MP_TAC o SPECL [← q r"y1:real^N", ← q r"y2:real^N"])) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, connected_component] THEN
    X_GEN_TAC (← q r"c2:real^N->bool") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"c1:real^M->bool") THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"IMAGE (\x:real^M. pastecart x y1) c1 UNION
      IMAGE (\y:real^N. pastecart x2 y) c2") THEN
    REWRITE_TAC [IN_UNION] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_UNION THEN
      ASM_SIMP_TAC [CONNECTED_CONTINUOUS_IMAGE, CONTINUOUS_ON_PASTECART,
                    CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, EXISTS_IN_IMAGE] THEN
      EXISTS_TAC (← q r"x2:real^M") THEN ASM SET_TAC [],
      REWRITE_TAC [SUBSET, IN_UNION, FORALL_AND_THM, FORALL_IN_IMAGE,
                   ← TAUT (← q r"a \/ b ==> c <=> (a ==> c) /\ (b ==> c)")] THEN
      ASM SET_TAC [],
      ASM SET_TAC [],
      ASM SET_TAC []])

  let CONNECTED_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        connected (s PCROSS t) <=>
        s = {} \/ t = {} \/ connected s /\ connected t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    REWRITE_TAC [PCROSS_EMPTY, CONNECTED_EMPTY] THEN
    EQ_TAC THEN SIMP_TAC [CONNECTED_PCROSS] THEN
    REWRITE_TAC [PCROSS] THEN REPEAT STRIP_TAC THENL
     [SUBGOAL_THEN (← q r"connected (IMAGE fstcart
                       {pastecart (x:real^M) (y:real^N) | x IN s /\ y IN t})")
      MP_TAC THENL [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE, ALL_TAC],
      SUBGOAL_THEN (← q r"connected (IMAGE sndcart
                       {pastecart (x:real^M) (y:real^N) | x IN s /\ y IN t})")
      MP_TAC THENL [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE, ALL_TAC]] THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART, IN_ELIM_PASTECART_THM,
                 FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ASM SET_TAC [])

  let CONNECTED_COMPONENT_PCROSS ← prove
   r"!s t a:real^M b:real^N.
        connected_component (s PCROSS t) (pastecart a b) =
        connected_component s a PCROSS connected_component t b"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(a:real^M) IN s /\ (b:real^N) IN t") THENL
     [MATCH_MP_TAC CONNECTED_COMPONENT_UNIQUE THEN
      REWRITE_TAC [PASTECART_IN_PCROSS, SUBSET_PCROSS, CONNECTED_PCROSS_EQ] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET, CONNECTED_CONNECTED_COMPONENT] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IN] THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
      X_GEN_TAC (← q r"c:real^(M,N)finite_sum->bool") THEN
      REWRITE_TAC [SUBSET, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
      STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^N"] THEN DISCH_TAC THEN
      REWRITE_TAC [IN] THEN REWRITE_TAC [connected_component] THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"IMAGE fstcart (c:real^(M,N)finite_sum->bool)"),
        EXISTS_TAC (← q r"IMAGE sndcart (c:real^(M,N)finite_sum->bool)")] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FORALL_PASTECART, EXISTS_PASTECART, IN_IMAGE] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      (CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []]) THEN
      MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART],
      MATCH_MP_TAC (← SET_RULE (← q r"s = {} /\ t = {} ==> s = t")) THEN
      REWRITE_TAC [PCROSS_EQ_EMPTY, CONNECTED_COMPONENT_EQ_EMPTY] THEN
      REWRITE_TAC [PASTECART_IN_PCROSS] THEN ASM_MESON_TAC []])

  let COMPONENTS_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
    components(s PCROSS t) =
    {c PCROSS d | c IN components s /\ d IN components t}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [components] THEN
    REWRITE_TAC [SIMPLE_IMAGE] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o ABS_CONV o RAND_CONV)
     [← GSYM PASTECART_FST_SND] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_PCROSS] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{f x y | x IN IMAGE g s /\ y IN IMAGE h t} =
      {f (g x) (h y) | x IN s /\ y IN t}")] THEN
    REWRITE_TAC [PCROSS, ← GSYM SIMPLE_IMAGE, ← SET_RULE
     (← q r"{f z | z IN {g x y | P x y}} = {f(g x y) | P x y}")] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART])

  let CLOSURE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        closure (s PCROSS t) = (closure s) PCROSS (closure t)"
   (REWRITE_TAC [EXTENSION, PCROSS, FORALL_PASTECART] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [CLOSURE_APPROACHABLE, EXISTS_PASTECART, FORALL_PASTECART] THEN
    REWRITE_TAC [IN_ELIM_PASTECART_THM, PASTECART_INJ] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
    REWRITE_TAC [dist, PASTECART_SUB] THEN EQ_TAC THENL
     [MESON_TAC [NORM_LE_PASTECART, REAL_LET_TRANS], DISCH_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"e / &2"))) THEN
    ASM_MESON_TAC [REAL_HALF, NORM_PASTECART_LE, ← REAL_ARITH
      (← q r"z <= x + y /\ x < e / &2 /\ y < e / &2 ==> z < e")])

  let LIMPT_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool x y.
        x limit_point_of s /\ y limit_point_of t
        ==> (pastecart x y) limit_point_of (s PCROSS t)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [PCROSS, LIMPT_APPROACHABLE, EXISTS_PASTECART] THEN
    REWRITE_TAC [IN_ELIM_PASTECART_THM, PASTECART_INJ, dist, PASTECART_SUB] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"e / &2"))) THEN
    ASM_MESON_TAC [REAL_HALF, NORM_PASTECART_LE, ← REAL_ARITH
      (← q r"z <= x + y /\ x < e / &2 /\ y < e / &2 ==> z < e")])

  return { CONTINUOUS_MAP_PASTECART, LIM_PASTECART, LIM_PASTECART_EQ, CONTINUOUS_PASTECART,
           CONTINUOUS_ON_PASTECART, CONTINUOUS_FSTCART, CONTINUOUS_SNDCART,
           CONTINUOUS_ON_FSTCART, CONTINUOUS_ON_SNDCART, CONNECTED_PCROSS,
           CONNECTED_PCROSS_EQ, CONNECTED_COMPONENT_PCROSS, COMPONENTS_PCROSS, CLOSURE_PCROSS,
           LIMPT_PCROSS }

/- ------------------------------------------------------------------------- -/
/- Pasted sets, continued; hence some useful properties follow quite easily. -/
/- (topology.ml 12710-12890)                                                 -/
/- ------------------------------------------------------------------------- -/

structure PCA2 where
  CLOSED_IN_PCROSS : thm
  CLOSED_IN_PCROSS_EQ : thm
  FRONTIER_PCROSS : thm
  CONNECTED_SCALING : thm
  CONNECTED_NEGATIONS : thm
  CONNECTED_SCALING_EQ : thm
  CONNECTED_AFFINITY_EQ : thm
  CONNECTED_AFFINITY : thm
  CONNECTED_SUMS : thm
  COMPACT_SCALING : thm
  COMPACT_SCALING_EQ : thm
  COMPACT_NEGATIONS : thm
  COMPACT_SUMS : thm
  COMPACT_DIFFERENCES : thm
  COMPACT_AFFINITY_EQ : thm
  COMPACT_AFFINITY : thm
  COMPACT_SUP_MAXDISTANCE : thm
  deriving Inhabited

@[nospecialize]
def setupPCA2 [HolBase] (D : TopologyDeps) (BLOC : LOC) (BCON : CON) (BCLS2 : CLS2)
    (BFRO1 : FRO1) (BCPP1 : CPP1) (BCSL : CSL) (BCMS : CMS) (BLCP : LCP) (BPCR1 : PCR1)
    (BPCR2 : PCR2) (BDST : DST) (BPCA1 : PCA1) : ExceptT String IO PCA2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D
  let { CONJ_ASSOC, EQ_IMP, EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_PASTECART, FSTCART_PASTECART, IMAGE_CONST, IMAGE_ID, IMAGE_o, IMP_CONJ_ALT,
        INTER_PCROSS, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, .. } := D.core2
  let { IN_UNION, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, PASTECART_FST_SND, PASTECART_INJ,
        PASTECART_IN_PCROSS, PCROSS, PCROSS_DIFF, PCROSS_EMPTY, PCROSS_EQ, PCROSS_EQ_EMPTY,
        .. } := D.core3
  let { REAL_MUL_LINV, SNDCART_PASTECART, .. } := D.core5
  let { UNWIND_THM2, o_DEF, .. } := D.core6
  let { AFFINITY_SCALING_TRANSLATION, FSTCART_ADD, FSTCART_CMUL, .. } := D.vec1
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { NORM_NEG, SNDCART_ADD, SNDCART_CMUL, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_NEG_NEG, VECTOR_SUB,
        VECTOR_SUB_LZERO, VECTOR_SUB_RZERO, dist, linear, .. } := D.vec4
  let { CLOSED_IN_EMPTY, .. } := D.met1
  let { CLOSED_IN_CLOSED, .. } := BLOC
  let { CONNECTED_EMPTY, CONNECTED_SING, .. } := BCON
  let { CLOSED_IN_INTER_CLOSURE, .. } := BCLS2
  let { frontier, .. } := BFRO1
  let { COMPACT_EMPTY, COMPACT_SING, .. } := BCPP1
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := BCSL
  let { CONTINUOUS_ON_ADD, .. } := BCMS
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_TRANSLATION_EQ, CONNECTED_CONTINUOUS_IMAGE,
        CONNECTED_TRANSLATION_EQ, LINEAR_CONTINUOUS_AT, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_PCROSS, COMPACT_PCROSS, .. } := BPCR1
  let { INTERIOR_PCROSS, .. } := BPCR2
  let { DISTANCE_ATTAINS_SUP, .. } := BDST
  let { CLOSURE_PCROSS, CONNECTED_PCROSS, .. } := BPCA1
  -- @@SCOPE END

  let CLOSED_IN_PCROSS ← prove
   r"!s:real^M->bool s' t:real^N->bool t'.
        closed_in (subtopology euclidean s) s' /\
        closed_in (subtopology euclidean t) t'
        ==> closed_in (subtopology euclidean (s PCROSS t)) (s' PCROSS t')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN_CLOSED] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"s'':real^M->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"t'':real^N->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"(s'':real^M->bool) PCROSS (t'':real^N->bool)") THEN
    ASM_SIMP_TAC [CLOSED_PCROSS, EXTENSION, FORALL_PASTECART] THEN
    REWRITE_TAC [IN_INTER, PASTECART_IN_PCROSS] THEN ASM SET_TAC [])

  let CLOSED_IN_PCROSS_EQ ← prove
   r"!s s':real^M->bool t t':real^N->bool.
        closed_in (subtopology euclidean (s PCROSS t)) (s' PCROSS t') <=>
        s' = {} \/ t' = {} \/
        closed_in (subtopology euclidean s) s' /\
        closed_in (subtopology euclidean t) t'"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s':real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, CLOSED_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"t':real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, CLOSED_IN_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [CLOSED_IN_PCROSS] THEN
    ASM_REWRITE_TAC [CLOSED_IN_INTER_CLOSURE, CLOSURE_PCROSS, INTER_PCROSS,
                     PCROSS_EQ, PCROSS_EQ_EMPTY])

  let FRONTIER_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        frontier(s PCROSS t) = frontier s PCROSS closure t UNION
                               closure s PCROSS frontier t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [frontier, CLOSURE_PCROSS, INTERIOR_PCROSS, PCROSS_DIFF] THEN
    REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_DIFF, IN_UNION,
                 PASTECART_IN_PCROSS] THEN
    ASM SET_TAC [])

  let CONNECTED_SCALING ← prove
   r"!s:real^N->bool c. connected s ==> connected (IMAGE (\x. c % x) s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
    REWRITE_TAC [linear] THEN CONJ_TAC THEN VECTOR_ARITH_TAC)

  let CONNECTED_NEGATIONS ← prove
   r"!s:real^N->bool. connected s ==> connected (IMAGE (--) s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
    REWRITE_TAC [linear] THEN CONJ_TAC THEN VECTOR_ARITH_TAC)

  let CONNECTED_SCALING_EQ ← prove
   r"!s:real^N->bool c.
        connected (IMAGE (\x. c % x) s) <=> c = &0 \/ connected s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      MESON_TAC [CONNECTED_SING, CONNECTED_EMPTY],
      EQ_TAC THEN REWRITE_TAC [CONNECTED_SCALING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP CONNECTED_SCALING) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, IMAGE_ID]])

  let CONNECTED_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        connected (IMAGE (\x. m % x + c) s) <=> m = &0 \/ connected s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, CONNECTED_TRANSLATION_EQ,
                 CONNECTED_SCALING_EQ, IMAGE_o])

  let CONNECTED_AFFINITY ← prove
   r"!s m c:real^N. connected s ==> connected (IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [CONNECTED_AFFINITY_EQ])

  let CONNECTED_SUMS ← prove
   r"!s t:real^N->bool.
        connected s /\ connected t ==> connected {x + y | x IN s /\ y IN t}"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP CONNECTED_PCROSS) THEN
    DISCH_THEN (MP_TAC o ISPEC
     (← q r"\z. (fstcart z + sndcart z:real^N)") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] CONNECTED_CONTINUOUS_IMAGE)) THEN
    SIMP_TAC [CONTINUOUS_ON_ADD, LINEAR_CONTINUOUS_ON, LINEAR_FSTCART,
              LINEAR_SNDCART, PCROSS] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM, EXISTS_PASTECART] THEN
    REWRITE_TAC [PASTECART_INJ, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    MESON_TAC [])

  let COMPACT_SCALING ← prove
   r"!s:real^N->bool c. compact s ==> compact (IMAGE (\x. c % x) s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
    REWRITE_TAC [linear] THEN CONJ_TAC THEN VECTOR_ARITH_TAC)

  let COMPACT_SCALING_EQ ← prove
   r"!s:real^N->bool c. compact (IMAGE (\x. c % x) s) <=> c = &0 \/ compact s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      MESON_TAC [COMPACT_SING, COMPACT_EMPTY],
      EQ_TAC THEN REWRITE_TAC [COMPACT_SCALING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP COMPACT_SCALING) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, IMAGE_ID]])

  let COMPACT_NEGATIONS ← prove
   r"!s:real^N->bool. compact s ==> compact (IMAGE (--) s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
    REWRITE_TAC [linear] THEN CONJ_TAC THEN VECTOR_ARITH_TAC)

  let COMPACT_SUMS ← prove
   r"!s:real^N->bool t.
        compact s /\ compact t ==> compact {x + y | x IN s /\ y IN t}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"{x + y | x IN s /\ y IN t} =
                  IMAGE (\z. fstcart z + sndcart z :real^N) (s PCROSS t)")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE, PCROSS] THEN
      GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_FST_SND],
      ALL_TAC] THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
    ASM_SIMP_TAC [COMPACT_PCROSS] THEN
    MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
    REWRITE_TAC [linear, FSTCART_ADD, FSTCART_CMUL, SNDCART_ADD,
                 SNDCART_CMUL] THEN
    CONJ_TAC THEN VECTOR_ARITH_TAC)

  let COMPACT_DIFFERENCES ← prove
   r"!s:real^N->bool t.
        compact s /\ compact t ==> compact {x - y | x IN s /\ y IN t}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"{x - y | x:real^N IN s /\ y IN t} =
                  {x + y | x IN s /\ y IN (IMAGE (--) t)}")
      (fun th => ASM_SIMP_TAC [th, COMPACT_SUMS, COMPACT_NEGATIONS]) THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"(x:real^N = --y) <=> (y = --x)")] THEN
    SIMP_TAC [VECTOR_SUB, ← GSYM CONJ_ASSOC, UNWIND_THM2] THEN
    MESON_TAC [VECTOR_NEG_NEG])

  let COMPACT_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        compact (IMAGE (\x. m % x + c) s) <=> m = &0 \/ compact s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, COMPACT_TRANSLATION_EQ,
                 COMPACT_SCALING_EQ, IMAGE_o])

  let COMPACT_AFFINITY ← prove
   r"!s m c:real^N. compact s ==> compact (IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [COMPACT_AFFINITY_EQ])

  let COMPACT_SUP_MAXDISTANCE ← prove
   r"!s:real^N->bool.
        compact s /\ ~(s = {})
        ==> ?x y. x IN s /\ y IN s /\
                  !u v. u IN s /\ v IN s ==> norm(u - v) <= norm(x - y)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{x - y:real^N | x IN s /\ y IN s}", ← q r"vec 0:real^N"]
                  DISTANCE_ATTAINS_SUP) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [COMPACT_DIFFERENCES] THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
      ASM_MESON_TAC [MEMBER_NOT_EMPTY],
      REWRITE_TAC [IN_ELIM_THM, dist, VECTOR_SUB_RZERO, VECTOR_SUB_LZERO,
                   NORM_NEG] THEN
      MESON_TAC []])

  return { CLOSED_IN_PCROSS, CLOSED_IN_PCROSS_EQ, FRONTIER_PCROSS, CONNECTED_SCALING,
           CONNECTED_NEGATIONS, CONNECTED_SCALING_EQ, CONNECTED_AFFINITY_EQ, CONNECTED_AFFINITY,
           CONNECTED_SUMS, COMPACT_SCALING, COMPACT_SCALING_EQ, COMPACT_NEGATIONS, COMPACT_SUMS,
           COMPACT_DIFFERENCES, COMPACT_AFFINITY_EQ, COMPACT_AFFINITY, COMPACT_SUP_MAXDISTANCE }

/- ------------------------------------------------------------------------- -/
/- We can state this in terms of diameter of a set.  (topology.ml 12891-13056) -/
/- ------------------------------------------------------------------------- -/

structure DIA1 where
  diameter : thm
  MDIAMETER_EUCLIDEAN : thm
  DIAMETER_BOUNDED : thm
  DIAMETER_BOUNDED_BOUND : thm
  DIAMETER_COMPACT_ATTAINED : thm
  DIAMETER_TRANSLATION : thm
  DIAMETER_LINEAR_IMAGE : thm
  DIAMETER_EMPTY : thm
  DIAMETER_SING : thm
  DIAMETER_POS_LE : thm
  DIAMETER_SUBSET : thm
  DIAMETER_CLOSURE : thm
  DIAMETER_SUBSET_CBALL_NONEMPTY : thm
  DIAMETER_SUBSET_CBALL : thm
  DIAMETER_EQ_0 : thm
  DIAMETER_LE : thm
  BOUNDED_AND_DIAMETER_LE : thm
  DIST_LE_DIAMETER : thm
  DIAMETER_CBALL : thm
  DIAMETER_BALL : thm
  deriving Inhabited

@[nospecialize]
def setupDIA1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BCLS1 : CLS1) (BCBL : CBL)
    (BBND1 : BND1) (BBND2 : BND2) (BCPT : CPT) : ExceptT String IO DIA1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE,
        VECTOR_ARITH, NORM_ARITH, NORM_ARITH_TAC, add_linear_invariants,
        add_translation_invariants, GEOM_TRANSLATE_TAC, .. } := D
  let { CONJ_ASSOC, DIMINDEX_GE_1, EMPTY_SUBSET, EQ_TRANS, EXISTS_IN_IMAGE, EXTENSION, .. } :=
    D.core1
  let { FORALL_IN_GSPEC, FUN_EQ_THM, IMAGE_EQ_EMPTY, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LE_REFL, MEMBER_NOT_EMPTY, NOT_EXISTS_THM, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_MUL, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.core4
  let { REAL_MUL_RZERO, REAL_NOT_LT, REAL_POS, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM,
        SUBSET, SUBSET_UNIV, .. } := D.core5
  let { SUP_EQ, .. } := D.core6
  let { LINEAR_SUB, .. } := D.vec2
  let { NORM_BASIS, NORM_MUL, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { MBOUNDED_AND_MDIAMETER_LE, MDIAMETER_BOUNDED, MDIAMETER_CLOSURE,
        MDIAMETER_COMPACT_ATTAINED, MDIAMETER_EQ_0, MDIAMETER_LE, MDIAMETER_POS_LE,
        MDIAMETER_SING, MDIAMETER_SUBSET, MDIAMETER_SUBSET_MCBALL_NONEMPTY, .. } := D.met2
  let { mdiameter, .. } := D.met3
  let { EUCLIDEAN_METRIC, MTOPOLOGY_EUCLIDEAN_METRIC, .. } := BEUC
  let { BALL_EMPTY, IN_CBALL, MCBALL_EUCLIDEAN, .. } := BBAL
  let { CLOSURE_EQ_EMPTY, CLOSURE_SUBSET, EUCLIDEAN_CLOSURE_OF, .. } := BCLS1
  let { CBALL_EQ_EMPTY, CLOSURE_BALL, .. } := BCBL
  let { BOUNDED_BALL, BOUNDED_CBALL, BOUNDED_CLOSURE_EQ, MBOUNDED_EUCLIDEAN, bounded, .. } :=
    BBND1
  let { BOUNDED_TRANSLATION_EQ, .. } := BBND2
  let { COMPACT_IN_EUCLIDEAN, .. } := BCPT
  -- @@SCOPE END

  let diameter ← new_definition
   r"diameter s =
        if s = {} then &0
        else sup {norm(x - y) | x IN s /\ y IN s}"

  let MDIAMETER_EUCLIDEAN ← prove
   r"mdiameter euclidean_metric:(real^N->bool)->real = diameter"
   (REWRITE_TAC [mdiameter, diameter, FUN_EQ_THM, EUCLIDEAN_METRIC, dist])

  let DIAMETER_BOUNDED ← prove
   r"!s. bounded s
       ==> (!x:real^N y. x IN s /\ y IN s ==> norm(x - y) <= diameter s) /\
           (!d. &0 <= d /\ d < diameter s
                ==> ?x y. x IN s /\ y IN s /\ norm(x - y) > d)"
   (REWRITE_TAC [← GSYM MBOUNDED_EUCLIDEAN, ← GSYM MDIAMETER_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM dist, ← GSYM EUCLIDEAN_METRIC, MDIAMETER_BOUNDED])

  let DIAMETER_BOUNDED_BOUND ← prove
   r"!s x y. bounded s /\ x IN s /\ y IN s ==> norm(x - y) <= diameter s"
   (MESON_TAC [DIAMETER_BOUNDED])

  let DIAMETER_COMPACT_ATTAINED ← prove
   r"!s:real^N->bool.
        compact s /\ ~(s = {})
        ==> ?x y. x IN s /\ y IN s /\ (norm(x - y) = diameter s)"
   (REWRITE_TAC [← GSYM COMPACT_IN_EUCLIDEAN, ← GSYM MDIAMETER_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM dist, ← GSYM EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, MDIAMETER_COMPACT_ATTAINED])

  let DIAMETER_TRANSLATION ← prove
   r"!a s. diameter (IMAGE (\x. a + x) s) = diameter s"
   (REWRITE_TAC [diameter] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [DIAMETER_TRANSLATION]

  let DIAMETER_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x. norm(f x) = norm x)
        ==> diameter(IMAGE f s) = diameter s"
   (REWRITE_TAC [diameter] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [diameter, IMAGE_EQ_EMPTY] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM, EXISTS_IN_IMAGE] THEN
    ASM_MESON_TAC [LINEAR_SUB])

  add_linear_invariants [DIAMETER_LINEAR_IMAGE]

  let DIAMETER_EMPTY ← prove
   r"diameter {} = &0"
   (REWRITE_TAC [diameter])

  let DIAMETER_SING ← prove
   r"!a:real^N. diameter {a} = &0"
   (SIMP_TAC [← GSYM MDIAMETER_EUCLIDEAN, MDIAMETER_SING,
              EUCLIDEAN_METRIC, IN_UNIV])

  let DIAMETER_POS_LE ← prove
   r"!s:real^N->bool. bounded s ==> &0 <= diameter s"
   (REWRITE_TAC [← GSYM MBOUNDED_EUCLIDEAN, ← GSYM MDIAMETER_EUCLIDEAN] THEN
    REWRITE_TAC [MDIAMETER_POS_LE])

  let DIAMETER_SUBSET ← prove
   r"!s t:real^N->bool. s SUBSET t /\ bounded t ==> diameter s <= diameter t"
   (REWRITE_TAC [← GSYM MBOUNDED_EUCLIDEAN, ← GSYM MDIAMETER_EUCLIDEAN] THEN
    REWRITE_TAC [MDIAMETER_SUBSET])

  let DIAMETER_CLOSURE ← prove
   r"!s:real^N->bool. diameter(closure s) = diameter s"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"bounded(s:real^N->bool)") THENL
     [POP_ASSUM MP_TAC THEN
      REWRITE_TAC [← GSYM MBOUNDED_EUCLIDEAN, ← GSYM MDIAMETER_EUCLIDEAN] THEN
      REWRITE_TAC [← GSYM EUCLIDEAN_CLOSURE_OF, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC,
                   MDIAMETER_CLOSURE],
      REWRITE_TAC [diameter, CLOSURE_EQ_EMPTY] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUP_EQ THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      MATCH_MP_TAC (← MESON []
       (← q r"(!a b. P a ==> ~(Q b a)) /\ (!a b. P a ==> ~(R b a))
        ==> (?x. P x) ==> !b. (!x. Q b x) <=> (!x. R b x)")) THEN
      SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, ← GSYM NOT_EXISTS_THM] THEN
      ONCE_REWRITE_TAC [← NORM_ARITH (← q r"norm(a - y:real^N) = norm(--a + y)")] THEN
      ONCE_REWRITE_TAC [← SET_RULE
       (← q r"(!x. x IN s ==> norm(a + x:real^N) <= b) <=>
        (!x. x IN IMAGE (\x. a + x) s ==> norm(x) <= b)")] THEN
      ASM_REWRITE_TAC [← GSYM bounded, BOUNDED_TRANSLATION_EQ,
                       BOUNDED_CLOSURE_EQ]])

  let DIAMETER_SUBSET_CBALL_NONEMPTY ← prove
   r"!s:real^N->bool.
       bounded s /\ ~(s = {}) ==> ?z. z IN s /\ s SUBSET cball(z,diameter s)"
   (REWRITE_TAC [← GSYM MBOUNDED_EUCLIDEAN, ← GSYM MDIAMETER_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM MCBALL_EUCLIDEAN, MDIAMETER_SUBSET_MCBALL_NONEMPTY])

  let DIAMETER_SUBSET_CBALL ← prove
   r"!s:real^N->bool. bounded s ==> ?z. s SUBSET cball(z,diameter s)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_MESON_TAC [DIAMETER_SUBSET_CBALL_NONEMPTY, EMPTY_SUBSET])

  let DIAMETER_EQ_0 ← prove
   r"!s:real^N->bool.
        bounded s ==> (diameter s = &0 <=> s = {} \/ ?a. s = {a})"
   (REWRITE_TAC [← GSYM MBOUNDED_EUCLIDEAN, ← GSYM MDIAMETER_EUCLIDEAN] THEN
    REWRITE_TAC [MDIAMETER_EQ_0])

  let DIAMETER_LE ← prove
   r"!s:real^N->bool.
        (~(s = {}) \/ &0 <= d) /\
        (!x y. x IN s /\ y IN s ==> norm(x - y) <= d) ==> diameter s <= d"
   (REWRITE_TAC [← GSYM dist, ← GSYM MDIAMETER_EUCLIDEAN] THEN
    MESON_TAC [EUCLIDEAN_METRIC, MDIAMETER_LE, SUBSET_UNIV])

  let BOUNDED_AND_DIAMETER_LE ← prove
   r"!s:real^N->bool r.
        bounded s /\ diameter s <= r <=>
        &0 <= r /\ !x y. x IN s /\ y IN s ==> dist(x,y) <= r"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM MBOUNDED_EUCLIDEAN, ← GSYM MDIAMETER_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM EUCLIDEAN_METRIC] THEN
    MATCH_MP_TAC MBOUNDED_AND_MDIAMETER_LE THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, SUBSET_UNIV])

  let DIST_LE_DIAMETER ← prove
   r"!s a b:real^N. bounded s /\ a IN s /\ b IN s ==> dist(a,b) <= diameter s"
   (MESON_TAC [BOUNDED_AND_DIAMETER_LE, REAL_LE_REFL])

  let DIAMETER_CBALL ← prove
   r"!a:real^N r. diameter(cball(a,r)) = if r < &0 then &0 else &2 * r"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THENL
     [ASM_MESON_TAC [CBALL_EQ_EMPTY, DIAMETER_EMPTY], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LT]) THEN
    REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
     [MATCH_MP_TAC DIAMETER_LE THEN
      ASM_SIMP_TAC [CBALL_EQ_EMPTY, REAL_LE_MUL, REAL_POS, REAL_NOT_LT] THEN
      REWRITE_TAC [IN_CBALL] THEN NORM_ARITH_TAC,
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"norm((a + r % basis 1) - (a - r % basis 1):real^N)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← VECTOR_ARITH (← q r"(a + r % b) - (a - r % b:real^N) =
                                  (&2 * r) % b")] THEN
        SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
        ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC DIAMETER_BOUNDED_BOUND THEN
        REWRITE_TAC [BOUNDED_CBALL, IN_CBALL] THEN
        REWRITE_TAC [← NORM_ARITH
         (← q r"dist(a:real^N,a + b) = norm b /\ dist(a,a - b) = norm b")] THEN
        SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
        ASM_REAL_ARITH_TAC]])

  let DIAMETER_BALL ← prove
   r"!a:real^N r. diameter(ball(a,r)) = if r < &0 then &0 else &2 * r"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THENL
     [ASM_SIMP_TAC [BALL_EMPTY, REAL_LT_IMP_LE, DIAMETER_EMPTY], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN
    ASM_SIMP_TAC [BALL_EMPTY, REAL_LE_REFL, DIAMETER_EMPTY, REAL_MUL_RZERO] THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"diameter(cball(a:real^N,r))") THEN CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      ASM_SIMP_TAC [← GSYM CLOSURE_BALL, DIAMETER_CLOSURE, BOUNDED_BALL],
      ASM_SIMP_TAC [DIAMETER_CBALL]])

  return { diameter, MDIAMETER_EUCLIDEAN, DIAMETER_BOUNDED, DIAMETER_BOUNDED_BOUND,
           DIAMETER_COMPACT_ATTAINED, DIAMETER_TRANSLATION, DIAMETER_LINEAR_IMAGE,
           DIAMETER_EMPTY, DIAMETER_SING, DIAMETER_POS_LE, DIAMETER_SUBSET, DIAMETER_CLOSURE,
           DIAMETER_SUBSET_CBALL_NONEMPTY, DIAMETER_SUBSET_CBALL, DIAMETER_EQ_0, DIAMETER_LE,
           BOUNDED_AND_DIAMETER_LE, DIST_LE_DIAMETER, DIAMETER_CBALL, DIAMETER_BALL }

/- ------------------------------------------------------------------------- -/
/- Diameter, continued.  (topology.ml 13057-13134)                           -/
/- ------------------------------------------------------------------------- -/

structure DIA2 where
  DIAMETER_SCALING : thm
  DIAMETER_AFFINITY : thm
  DIAMETER_SUMS : thm
  DIAMETER_LE_SUMS_RIGHT : thm
  DIAMETER_LE_SUMS_LEFT : thm
  DIAMETER_UNION_LE : thm
  deriving Inhabited

@[nospecialize]
def setupDIA2 [HolBase] (D : TopologyDeps) (BBND1 : BND1) (BBND2 : BND2) (BDIA1 : DIA1) :
    ExceptT String IO DIA2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ, .. } :=
    D.core2
  let { MEMBER_NOT_EMPTY, NOT_IN_EMPTY, REAL_ABS_NUM, REAL_ABS_NZ, REAL_ABS_POS, REAL_ADD_LID,
        REAL_ADD_RID, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_LMUL_EQ, REAL_LE_MUL, REAL_LE_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_MUL_SYM, RIGHT_FORALL_IMP_THM, .. } := D.core5
  let { AFFINITY_SCALING_TRANSLATION, .. } := D.vec1
  let { NORM_MUL, SUMS_SYM, .. } := D.vec3
  let { VECTOR_MUL_LZERO, VECTOR_SUB_LDISTRIB, .. } := D.vec4
  let { MDIAMETER_UNION_LE, .. } := D.met2
  let { MBOUNDED_EUCLIDEAN, .. } := BBND1
  let { BOUNDED_SCALING, BOUNDED_SUMS, .. } := BBND2
  let { DIAMETER_BOUNDED_BOUND, DIAMETER_EMPTY, DIAMETER_LE, DIAMETER_POS_LE, DIAMETER_SING,
        DIAMETER_TRANSLATION, MDIAMETER_EUCLIDEAN, .. } := BDIA1
  -- @@SCOPE END

  let DIAMETER_SCALING ← prove
   r"!a s:real^N->bool.
        bounded s ==> diameter(IMAGE (\x. a % x) s) = abs a * diameter s"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [DIAMETER_EMPTY, IMAGE_CLAUSES, REAL_MUL_RZERO] THEN
    ASM_CASES_TAC (← q r"a = &0") THEN
    ASM_SIMP_TAC [VECTOR_MUL_LZERO, ← SET_RULE
       (← q r"~(s = {}) ==> IMAGE (\x. a) s = {a}")] THEN
    REWRITE_TAC [DIAMETER_SING, REAL_ABS_NUM, REAL_MUL_LZERO] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, ← GSYM REAL_ABS_NZ] THEN
    CONJ_TAC THEN MATCH_MP_TAC DIAMETER_LE THEN
    ASM_SIMP_TAC [DIAMETER_POS_LE, REAL_LE_MUL, REAL_ABS_POS] THEN
    REWRITE_TAC [IMAGE_EQ_EMPTY] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THENL
     [REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, NORM_MUL] THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, ← GSYM REAL_ABS_NZ] THEN
      ASM_MESON_TAC [DIAMETER_BOUNDED_BOUND],
      ASM_SIMP_TAC [REAL_LE_RDIV_EQ, ← GSYM REAL_ABS_NZ] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [← GSYM NORM_MUL, VECTOR_SUB_LDISTRIB] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC DIAMETER_BOUNDED_BOUND THEN
      ASM_SIMP_TAC [BOUNDED_SCALING] THEN ASM SET_TAC []])

  let DIAMETER_AFFINITY ← prove
   r"!s m c:real^N.
        bounded s
        ==> diameter(IMAGE (\x. m % x + c) s) = abs m * diameter s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, IMAGE_o, DIAMETER_TRANSLATION] THEN
    REWRITE_TAC [DIAMETER_SCALING])

  let DIAMETER_SUMS ← prove
   r"!s t:real^N->bool.
        bounded s /\ bounded t
        ==> diameter {x + y | x IN s /\ y IN t} <= diameter s + diameter t"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_SIMP_TAC [NOT_IN_EMPTY, ← SET_RULE (← q r"{f x y |x,y| F} = {}"),
                  DIAMETER_EMPTY, REAL_ADD_LID, DIAMETER_POS_LE] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [NOT_IN_EMPTY, ← SET_RULE (← q r"{f x y |x,y| F} = {}"),
                  DIAMETER_EMPTY, REAL_ADD_RID, DIAMETER_POS_LE] THEN
    MATCH_MP_TAC DIAMETER_LE THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_GSPEC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC (← NORM_ARITH
     (← q r"norm(x - x') <= s /\ norm(y - y') <= t
      ==> norm((x + y) - (x' + y'):real^N) <= s + t")) THEN
    ASM_SIMP_TAC [DIAMETER_BOUNDED_BOUND])

  let DIAMETER_LE_SUMS_RIGHT ← prove
   r"!s t:real^N->bool.
        ~(t = {}) /\ bounded s /\ bounded t
        ==> diameter s <= diameter {x + y | x IN s /\ y IN t}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC DIAMETER_LE THEN
    ASM_SIMP_TAC [DIAMETER_POS_LE, BOUNDED_SUMS] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"z:real^N")) THEN
    SUBST1_TAC (← VECTOR_ARITH (← q r"x - y:real^N = (x + z) - (y + z)")) THEN
    MATCH_MP_TAC DIAMETER_BOUNDED_BOUND THEN
    ASM_SIMP_TAC [BOUNDED_SUMS] THEN ASM SET_TAC [])

  let DIAMETER_LE_SUMS_LEFT ← prove
   r"!s t:real^N->bool.
        ~(s = {}) /\ bounded s /\ bounded t
        ==> diameter t <= diameter {x + y | x IN s /\ y IN t}"
   (ONCE_REWRITE_TAC [SUMS_SYM] THEN SIMP_TAC [DIAMETER_LE_SUMS_RIGHT])

  let DIAMETER_UNION_LE ← prove
   r"!s t:real^N->bool.
        bounded s /\ bounded t /\ ~(s INTER t = {})
        ==> diameter(s UNION t) <= diameter s + diameter t"
   (REWRITE_TAC [← GSYM MBOUNDED_EUCLIDEAN, ← GSYM MDIAMETER_EUCLIDEAN] THEN
    REWRITE_TAC [MDIAMETER_UNION_LE])

  return { DIAMETER_SCALING, DIAMETER_AFFINITY, DIAMETER_SUMS, DIAMETER_LE_SUMS_RIGHT,
           DIAMETER_LE_SUMS_LEFT, DIAMETER_UNION_LE }

/- ------------------------------------------------------------------------- -/
/- Related results with closure as the conclusion.  (topology.ml 13135-13368) -/
/- ------------------------------------------------------------------------- -/

structure CCC where
  CLOSED_SCALING : thm
  CLOSED_NEGATIONS : thm
  COMPACT_CLOSED_SUMS : thm
  CLOSED_COMPACT_SUMS : thm
  CLOSURE_SUMS : thm
  COMPACT_CLOSED_DIFFERENCES : thm
  CLOSED_COMPACT_DIFFERENCES : thm
  CLOSED_TRANSLATION_EQ : thm
  CLOSED_TRANSLATION : thm
  COMPLETE_TRANSLATION_EQ : thm
  CLOSED_SCALING_EQ : thm
  CLOSED_AFFINITY_EQ : thm
  CLOSED_AFFINITY : thm
  TRANSLATION_DIFF : thm
  CLOSURE_TRANSLATION : thm
  FRONTIER_TRANSLATION : thm
  DIAMETER_LT_SUMS_RIGHT : thm
  DIAMETER_LT_SUMS_LEFT : thm
  deriving Inhabited

@[nospecialize]
def setupCCC [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLPT : LPT) (BCLS1 : CLS1) (BFRO1 : FRO1)
    (BLIM2 : LIM2) (BARI : ARI) (BSEQ : SEQ) (BBND2 : BND2) (BCPT : CPT) (BCMP : CMP)
    (BPCA2 : PCA2) (BDIA1 : DIA1) : ExceptT String IO CCC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH,
        VECTOR_ARITH_TAC, add_translation_invariants, GEOM_TRANSLATE_TAC, .. } := D
  let { CONJ_ASSOC, ETA_AX, EXTENSION, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_GSPEC, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_CONST, IMAGE_ID,
        IMAGE_o, IMP_CONJ, IMP_IMP, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_SING, .. } :=
    D.core2
  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, .. } := D.core3
  let { REAL_MUL_LINV, REAL_MUL_RINV, REAL_NOT_LE, REAL_NOT_LT, RIGHT_AND_EXISTS_THM,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET, .. } := D.core5
  let { UNWIND_THM2, o_DEF, o_THM, .. } := D.core6
  let { AFFINITY_SCALING_TRANSLATION, .. } := D.vec1
  let { NORM_INCREASES_ONLINE, SUMS_SYM, .. } := D.vec3
  let { VECTOR_ADD_SUB, VECTOR_ADD_SYM, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_NEG_NEG, VECTOR_SUB, VECTOR_SUB_EQ, .. } := D.vec4
  let { CLOSED_EMPTY, closed, .. } := BCLO
  let { CLOSED_SING, .. } := BLPT
  let { CLOSURE_INTERIOR, CLOSURE_SUBSET, .. } := BCLS1
  let { frontier, .. } := BFRO1
  let { LIM_SUBSEQUENCE, .. } := BLIM2
  let { LIM_ADD, LIM_CMUL, LIM_SUB, .. } := BARI
  let { CLOSED_SEQUENTIAL_LIMITS, CLOSURE_SEQUENTIAL, .. } := BSEQ
  let { BOUNDED_SUMS, .. } := BBND2
  let { COMPACT_CLOSURE, COMPACT_IMP_BOUNDED, compact, .. } := BCPT
  let { COMPLETE_EQ_CLOSED, .. } := BCMP
  let { COMPACT_NEGATIONS, .. } := BPCA2
  let { DIAMETER_BOUNDED_BOUND, DIAMETER_CLOSURE, DIAMETER_COMPACT_ATTAINED, .. } := BDIA1
  -- @@SCOPE END

  let CLOSED_SCALING ← prove
   r"!s:real^N->bool c. closed s ==> closed (IMAGE (\x. c % x) s)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s :real^N->bool = {}") THEN
    ASM_REWRITE_TAC [CLOSED_EMPTY, IMAGE_CLAUSES] THEN
    ASM_CASES_TAC (← q r"c = &0") THENL
     [SUBGOAL_THEN (← q r"IMAGE (\x:real^N. c % x) s = {(vec 0)}")
       (fun th => REWRITE_TAC [th, CLOSED_SING]) THEN
      ASM_REWRITE_TAC [EXTENSION, IN_IMAGE, IN_SING, VECTOR_MUL_LZERO] THEN
      ASM_MESON_TAC [MEMBER_NOT_EMPTY],
      ALL_TAC] THEN
    REWRITE_TAC [CLOSED_SEQUENTIAL_LIMITS, IN_IMAGE, SKOLEM_THM] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"x:num->real^N") THEN X_GEN_TAC (← q r"l:real^N") THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:num->real^N") MP_TAC) THEN
    REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"inv(c) % l :real^N") THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, VECTOR_MUL_LID] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"\n:num. inv(c) % x n:real^N") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, VECTOR_MUL_LID],
      MATCH_MP_TAC LIM_CMUL THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← SYM (← SPEC_ALL th)])) THEN
      ASM_REWRITE_TAC [ETA_AX]])

  let CLOSED_NEGATIONS ← prove
   r"!s:real^N->bool. closed s ==> closed (IMAGE (--) s)"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (--) s = IMAGE (\x:real^N. --(&1) % x) s")
    SUBST1_TAC THEN SIMP_TAC [CLOSED_SCALING] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"--(&1) % x = --x")] THEN REWRITE_TAC [ETA_AX])

  let COMPACT_CLOSED_SUMS ← prove
   r"!s:real^N->bool t.
        compact s /\ closed t ==> closed {x + y | x IN s /\ y IN t}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [compact, IN_ELIM_THM, CLOSED_SEQUENTIAL_LIMITS] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"f:num->real^N") THEN X_GEN_TAC (← q r"l:real^N") THEN
    REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:num->real^N") MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:num->real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_imp o concl) o
      SPEC (← q r"a:num->real^N")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"la:real^N") (X_CHOOSE_THEN (← q r"sub:num->num")
          STRIP_ASSUME_TAC)) THEN
    MAP_EVERY EXISTS_TAC [← q r"la:real^N", ← q r"l - la:real^N"] THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"a + (b - a) = b:real^N")] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    EXISTS_TAC (← q r"\n. (f o (sub:num->num)) n - (a o sub) n:real^N") THEN
    CONJ_TAC THENL [ASM_REWRITE_TAC [VECTOR_ADD_SUB, o_THM], ALL_TAC] THEN
    MATCH_MP_TAC LIM_SUB THEN ASM_SIMP_TAC [LIM_SUBSEQUENCE, ETA_AX])

  let CLOSED_COMPACT_SUMS ← prove
   r"!s:real^N->bool t.
        closed s /\ compact t ==> closed {x + y | x IN s /\ y IN t}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"{x + y:real^N | x IN s /\ y IN t} = {y + x | y IN t /\ x IN s}")
    SUBST1_TAC THEN  SIMP_TAC [COMPACT_CLOSED_SUMS] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN MESON_TAC [VECTOR_ADD_SYM])

  let CLOSURE_SUMS ← prove
   r"!s t:real^N->bool.
        bounded s \/ bounded t
        ==> closure {x + y | x IN s /\ y IN t} =
            {x + y | x IN closure s /\ y IN closure t}"
   (REWRITE_TAC [← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)")] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [SUMS_SYM] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN
    SIMP_TAC [] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [EXTENSION, CLOSURE_SEQUENTIAL] THEN
    X_GEN_TAC (← q r"z:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN EQ_TAC THENL
     [REWRITE_TAC [IN_ELIM_THM, IN_DELETE, SKOLEM_THM, LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ r <=> q /\ p /\ r")] THEN
      ONCE_REWRITE_TAC [← MESON [] (← q r"(?f x y. P f x y) <=> (?x y f. P f x y)")] THEN
      ONCE_REWRITE_TAC [← GSYM FUN_EQ_THM] THEN
      REWRITE_TAC [ETA_AX, UNWIND_THM2] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:num->real^N", ← q r"b:num->real^N"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"closure s:real^N->bool") compact) THEN
      ASM_REWRITE_TAC [COMPACT_CLOSURE] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:num->real^N")) THEN
      ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"r:num->num"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"z - u:real^N") THEN
      EXISTS_TAC (← q r"(a:num->real^N) o (r:num->num)") THEN
      EXISTS_TAC (← q r"u:real^N") THEN
      ASM_REWRITE_TAC [o_THM] THEN
      CONJ_TAC THENL [ALL_TAC, VECTOR_ARITH_TAC] THEN
      EXISTS_TAC (← q r"(\n. ((\n. a n + b n) o (r:num->num)) n - (a o r) n)
                  :num->real^N") THEN
      CONJ_TAC THENL
       [ASM_REWRITE_TAC [o_DEF, ← VECTOR_ARITH (← q r"(a + b) - a:real^N = b")],
        MATCH_MP_TAC LIM_SUB THEN ASM_REWRITE_TAC [ETA_AX] THEN
        MATCH_MP_TAC LIM_SUBSEQUENCE THEN ASM_REWRITE_TAC []],
      REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, LEFT_AND_EXISTS_THM,
                   RIGHT_AND_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"x:real^N", ← q r"y:real^N", ← q r"a:num->real^N", ← q r"b:num->real^N"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"(\n. a n + b n):num->real^N") THEN
      ASM_SIMP_TAC [LIM_ADD] THEN ASM_MESON_TAC []])

  let COMPACT_CLOSED_DIFFERENCES ← prove
   r"!s:real^N->bool t.
        compact s /\ closed t ==> closed {x - y | x IN s /\ y IN t}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"{x - y | x:real^N IN s /\ y IN t} =
                  {x + y | x IN s /\ y IN (IMAGE (--) t)}")
      (fun th => ASM_SIMP_TAC [th, COMPACT_CLOSED_SUMS, CLOSED_NEGATIONS]) THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"(x:real^N = --y) <=> (y = --x)")] THEN
    SIMP_TAC [VECTOR_SUB, ← GSYM CONJ_ASSOC, UNWIND_THM2] THEN
    MESON_TAC [VECTOR_NEG_NEG])

  let CLOSED_COMPACT_DIFFERENCES ← prove
   r"!s:real^N->bool t.
        closed s /\ compact t ==> closed {x - y | x IN s /\ y IN t}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"{x - y | x:real^N IN s /\ y IN t} =
                  {x + y | x IN s /\ y IN (IMAGE (--) t)}")
      (fun th => ASM_SIMP_TAC [th, CLOSED_COMPACT_SUMS, COMPACT_NEGATIONS]) THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"(x:real^N = --y) <=> (y = --x)")] THEN
    SIMP_TAC [VECTOR_SUB, ← GSYM CONJ_ASSOC, UNWIND_THM2] THEN
    MESON_TAC [VECTOR_NEG_NEG])

  let CLOSED_TRANSLATION_EQ ← prove
   r"!a s. closed (IMAGE (\x:real^N. a + x) s) <=> closed s"
   (REWRITE_TAC [closed] THEN GEOM_TRANSLATE_TAC [])

  let CLOSED_TRANSLATION ← prove
   r"!s a:real^N. closed s ==> closed (IMAGE (\x. a + x) s)"
   (REWRITE_TAC [CLOSED_TRANSLATION_EQ])

  add_translation_invariants [CLOSED_TRANSLATION_EQ]

  let COMPLETE_TRANSLATION_EQ ← prove
   r"!a s. complete(IMAGE (\x:real^N. a + x) s) <=> complete s"
   (REWRITE_TAC [COMPLETE_EQ_CLOSED, CLOSED_TRANSLATION_EQ])

  add_translation_invariants [COMPLETE_TRANSLATION_EQ]

  let CLOSED_SCALING_EQ ← prove
   r"!s:real^N->bool c. closed (IMAGE (\x. c % x) s) <=> c = &0 \/ closed s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      MESON_TAC [CLOSED_SING, CLOSED_EMPTY],
      EQ_TAC THEN REWRITE_TAC [CLOSED_SCALING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP CLOSED_SCALING) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, IMAGE_ID]])

  let CLOSED_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        closed (IMAGE (\x. m % x + c) s) <=> m = &0 \/ closed s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, CLOSED_TRANSLATION_EQ,
                 CLOSED_SCALING_EQ, IMAGE_o])

  let CLOSED_AFFINITY ← prove
   r"!s m c:real^N. closed s ==> closed (IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [CLOSED_AFFINITY_EQ])

  let TRANSLATION_DIFF ← prove
   r"!s t:real^N->bool.
        IMAGE (\x. a + x) (s DIFF t) =
        (IMAGE (\x. a + x) s) DIFF (IMAGE (\x. a + x) t)"
   (REWRITE_TAC [EXTENSION, IN_DIFF, IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = a + y <=> y = x - a")] THEN
    REWRITE_TAC [UNWIND_THM2])

  let CLOSURE_TRANSLATION ← prove
   r"!a s. closure(IMAGE (\x:real^N. a + x) s) = IMAGE (\x. a + x) (closure s)"
   (REWRITE_TAC [CLOSURE_INTERIOR] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [CLOSURE_TRANSLATION]

  let FRONTIER_TRANSLATION ← prove
   r"!a s. frontier(IMAGE (\x:real^N. a + x) s) = IMAGE (\x. a + x) (frontier s)"
   (REWRITE_TAC [frontier] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [FRONTIER_TRANSLATION]

  let DIAMETER_LT_SUMS_RIGHT ← prove
   r"!s t:real^N->bool.
        ~(s = {}) /\ ~(?a. t SUBSET {a}) /\ bounded s /\ bounded t
        ==> diameter s < diameter {x + y | x IN s /\ y IN t}"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    ONCE_REWRITE_TAC [← GSYM DIAMETER_CLOSURE] THEN SIMP_TAC [CLOSURE_SUMS] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [← GSYM COMPACT_CLOSURE] THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP
     (← SET_RULE (← q r"~(s = {}) /\ ~(?a. t SUBSET {a})
                ==> s SUBSET closure s /\ t SUBSET closure t
                    ==> ~(closure s = {}) /\ ~(?a. closure t SUBSET {a})"))) THEN
    REWRITE_TAC [CLOSURE_SUBSET, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    MAP_EVERY SPEC_TAC
     [(← q r"closure t:real^N->bool", ← q r"t:real^N->bool"),
      (← q r"closure s:real^N->bool", ← q r"s:real^N->bool")] THEN
    REWRITE_TAC [← GSYM REAL_NOT_LE] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?a b:real^N. a IN t /\ b IN t /\ ~(a = b)")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"{x + y:real^N | x IN s /\ y IN t}")
          DIAMETER_BOUNDED_BOUND) THEN
    ASM_SIMP_TAC [BOUNDED_SUMS, COMPACT_IMP_BOUNDED, IMP_CONJ,
                  RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") DIAMETER_COMPACT_ATTAINED) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← ISPECL [← q r"x:real^N", ← q r"a:real^N", ← q r"y:real^N",
                              ← q r"b:real^N"] th) THEN
            MP_TAC (← ISPECL [← q r"x:real^N", ← q r"b:real^N", ← q r"y:real^N",
                              ← q r"a:real^N"] th))) THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH
      (← q r"(x + a) - (y + b):real^N = (x - y) + (a - b)")] THEN
    MP_TAC (← ISPECL [← q r"x - y:real^N", ← q r"b - a:real^N"] NORM_INCREASES_ONLINE) THEN
    ASM_REWRITE_TAC [VECTOR_SUB_EQ, ← VECTOR_ARITH
     (← q r"(x - y) - (b - a):real^N = (x - y) + (a - b)")] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_NOT_LT]) THEN
    SPEC_TAC (← q r"diameter {x + y:real^N | x IN s /\ y IN t}", ← q r"d:real") THEN
    ASM_REAL_ARITH_TAC)

  let DIAMETER_LT_SUMS_LEFT ← prove
   r"!s t:real^N->bool.
        ~(?a. s SUBSET {a}) /\ ~(t = {}) /\ bounded s /\ bounded t
        ==> diameter t < diameter {x + y | x IN s /\ y IN t}"
   (ONCE_REWRITE_TAC [SUMS_SYM] THEN SIMP_TAC [DIAMETER_LT_SUMS_RIGHT])

  return { CLOSED_SCALING, CLOSED_NEGATIONS, COMPACT_CLOSED_SUMS, CLOSED_COMPACT_SUMS,
           CLOSURE_SUMS, COMPACT_CLOSED_DIFFERENCES, CLOSED_COMPACT_DIFFERENCES,
           CLOSED_TRANSLATION_EQ, CLOSED_TRANSLATION, COMPLETE_TRANSLATION_EQ,
           CLOSED_SCALING_EQ, CLOSED_AFFINITY_EQ, CLOSED_AFFINITY, TRANSLATION_DIFF,
           CLOSURE_TRANSLATION, FRONTIER_TRANSLATION, DIAMETER_LT_SUMS_RIGHT,
           DIAMETER_LT_SUMS_LEFT }

/- ------------------------------------------------------------------------- -/
/- Shrinking a ball containing a compact set; separation between points and -/
/- sets.  (topology.ml 13369-13454)                                          -/
/- ------------------------------------------------------------------------- -/

structure SEP where
  COMPACT_SHRINK_ENCLOSING_BALL : thm
  COMPACT_SHRINK_ENCLOSING_BALL_INFTY : thm
  SEPARATE_POINT_CLOSED : thm
  SEPARATE_COMPACT_CLOSED : thm
  SEPARATE_CLOSED_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupSEP [HolBase] (D : TopologyDeps) (BBAL : BAL) (BDST : DST) (BCCC : CCC) :
    ExceptT String IO SEP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_FIELD, SET_TAC,
        CLAIM_TAC, INTRO_TAC, VECTOR_ARITH, NORM_ARITH, ASM_NORM_ARITH_TAC, .. } := D
  let { EMPTY_SUBSET, .. } := D.core1
  let { INTER_COMM, IN_ELIM_THM, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LT_01, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LCANCEL_IMP, .. } :=
    D.core4
  let { REAL_MUL_POS_LT, REAL_MUL_RID, REAL_MUL_RINV, REAL_NOT_LT, SUBSET, .. } := D.core5
  let { DIST_0, DIST_POS_LT, DIST_SYM, .. } := D.vec1
  let { IN_BALL, IN_BALL_0, .. } := BBAL
  let { DISTANCE_ATTAINS_INF, DISTANCE_ATTAINS_SUP, .. } := BDST
  let { COMPACT_CLOSED_DIFFERENCES, .. } := BCCC
  -- @@SCOPE END

  let COMPACT_SHRINK_ENCLOSING_BALL ← prove
   r"!s x:real^N r. &0 < r /\ compact s /\ s SUBSET ball(x,r)
                  ==> ?r'. &0 < r' /\ r' < r /\ s SUBSET ball(x,r')"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
    [POP_ASSUM SUBST1_TAC THEN INTRO_TAC "r _ _" THEN EXISTS_TAC (← q r"r / &2") THEN
     REWRITE_TAC [EMPTY_SUBSET] THEN ASM_REAL_ARITH_TAC,
     ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_BALL] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N"] DISTANCE_ATTAINS_SUP) THEN
    ASM_REWRITE_TAC [] THEN INTRO_TAC "@y. y le" THEN
    EXISTS_TAC (← q r"(dist (x:real^N,y) + r) / &2") THEN
    CLAIM_TAC "rlt" (← q r"dist(x:real^N,y) < r") THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"a <= b /\ b < c ==> a < (b + c) / &2")] THEN
    ASM_NORM_ARITH_TAC)

  let COMPACT_SHRINK_ENCLOSING_BALL_INFTY ← prove
   r"!s b. compact s /\ (!x:real^N. x IN s ==> b * norm x < &1)
         ==> ?r. &0 < r /\ b * r < &1 /\ !x. x IN s ==> norm x < r"
   (INTRO_TAC "!s b; cpt sub" THEN ASM_CASES_TAC (← q r"&0 < b") THENL
    [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"vec 0:real^N", ← q r"inv b"]
                    COMPACT_SHRINK_ENCLOSING_BALL) THEN
     ASM_REWRITE_TAC [REAL_LT_INV_EQ, SUBSET, IN_BALL_0] THEN
     ANTS_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN
      MATCH_MP_TAC (← SPEC (← q r"b:real") REAL_LT_LCANCEL_IMP) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_NZ, REAL_MUL_RINV],
      ALL_TAC] THEN
     INTRO_TAC "@r. rpos rlt sub" THEN EXISTS_TAC (← q r"r:real") THEN
     ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← SPEC (← q r"inv b") REAL_LT_LCANCEL_IMP) THEN
     ASM_REWRITE_TAC [REAL_LT_INV_EQ, REAL_MUL_RID] THEN
     ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < b ==> inv b * b * r = r")],
     POP_ASSUM (LABEL_TAC "bneg" o REWRITE_RULE [REAL_NOT_LT])] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
    [POP_ASSUM SUBST1_TAC THEN EXISTS_TAC (← q r"&1") THEN
     REWRITE_TAC [REAL_LT_01, NOT_IN_EMPTY] THEN ASM_REAL_ARITH_TAC,
     ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"vec 0:real^N"] DISTANCE_ATTAINS_SUP) THEN
    ASM_REWRITE_TAC [DIST_0] THEN INTRO_TAC "@x. x le" THEN
    EXISTS_TAC (← q r"norm (x:real^N) + &1") THEN
    CONJ_TAC THENL [ASM_NORM_ARITH_TAC, ALL_TAC] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"x <= y ==> x < y + &1")] THEN
    TRANS_TAC REAL_LET_TRANS (← q r"&0") THEN
    REWRITE_TAC [REAL_LT_01, ← GSYM REAL_NOT_LT, REAL_MUL_POS_LT] THEN
    ASM_NORM_ARITH_TAC)

  let SEPARATE_POINT_CLOSED ← prove
   r"!s a:real^N.
        closed s /\ ~(a IN s)
        ==> ?d. &0 < d /\ !x. x IN s ==> d <= dist(a,x)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [EXISTS_TAC (← q r"&1") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY, REAL_LT_01],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N"] DISTANCE_ATTAINS_INF) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"b:real^N") THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"dist(a:real^N,b)") THEN
    ASM_MESON_TAC [DIST_POS_LT])

  let SEPARATE_COMPACT_CLOSED ← prove
   r"!s t:real^N->bool.
        compact s /\ closed t /\ s INTER t = {}
        ==> ?d. &0 < d /\ !x y. x IN s /\ y IN t ==> d <= dist(x,y)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{x - y:real^N | x IN s /\ y IN t}", ← q r"vec 0:real^N"]
                  SEPARATE_POINT_CLOSED) THEN
    ASM_SIMP_TAC [COMPACT_CLOSED_DIFFERENCES, IN_ELIM_THM] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"vec 0 = x - y <=> x = y")] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
    MESON_TAC [← NORM_ARITH (← q r"dist(vec 0,x - y) = dist(x,y)")])

  let SEPARATE_CLOSED_COMPACT ← prove
   r"!s t:real^N->bool.
        closed s /\ compact t /\ s INTER t = {}
        ==> ?d. &0 < d /\ !x y. x IN s /\ y IN t ==> d <= dist(x,y)"
   (ONCE_REWRITE_TAC [DIST_SYM, INTER_COMM] THEN
    MESON_TAC [SEPARATE_COMPACT_CLOSED])

  return { COMPACT_SHRINK_ENCLOSING_BALL, COMPACT_SHRINK_ENCLOSING_BALL_INFTY,
           SEPARATE_POINT_CLOSED, SEPARATE_COMPACT_CLOSED, SEPARATE_CLOSED_COMPACT }

/- ------------------------------------------------------------------------- -/
/- Representing sets as the union of a chain of compact sets.               -/
/- (topology.ml 13455-13604)                                                 -/
/- ------------------------------------------------------------------------- -/

structure UCS where
  CLOSED_UNION_COMPACT_SUBSETS : thm
  OPEN_UNION_COMPACT_SUBSETS : thm
  deriving Inhabited

@[nospecialize]
def setupUCS [HolBase] (D : TopologyDeps) (BCLO : CLO) (BBAL : BAL) (BINT : INT) (BCLS1 : CLS1)
    (BCBL : CBL) (BBND2 : BND2) (BBLS : BLS) (BCPT : CPT) (BCPP1 : CPP1) (BCPP2 : CPP2)
    (BARC : ARC) (BCCC : CCC) : ExceptT String IO UCS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D
  let { ADD1, EMPTY_SUBSET, EXISTS_FINITE_SUBSET_IMAGE, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, GE, IMP_CONJ, INTER_SUBSET, IN_DIFF, IN_ELIM_THM,
        IN_INTER, .. } := D.core2
  let { IN_UNIV, LE_1, LE_TRANS, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_ARCH_INV, REAL_ARCH_SIMPLE, REAL_LE_INV2, REAL_LT_INV2, REAL_LT_INV_EQ, .. } :=
    D.core4
  let { REAL_OF_NUM_ADD, REAL_OF_NUM_GE, REAL_OF_NUM_LT, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM,
        SUBSET_EMPTY, SUBSET_INTER, SUBSET_TRANS, SUBSET_UNIV, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LE, UNIONS_GSPEC, UNIONS_SUBSET, UNWIND_THM2, .. } := D.core6
  let { UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { DIST_REFL, DIST_SYM, .. } := D.vec1
  let { VECTOR_ADD_RID, dist, .. } := D.vec4
  let { OPEN_CLOSED, .. } := BCLO
  let { CENTRE_IN_BALL, IN_BALL, IN_BALL_0, IN_CBALL, IN_CBALL_0, OPEN_BALL,
        OPEN_CONTAINS_BALL, .. } := BBAL
  let { INTERIOR_SUBSET, OPEN_INTERIOR, .. } := BINT
  let { CLOSURE_MINIMAL, INTERIOR_DIFF, .. } := BCLS1
  let { INTERIOR_CBALL, .. } := BCBL
  let { BOUNDED_SUBSET_CBALL, .. } := BBND2
  let { SUBSET_BALLS, .. } := BBLS
  let { COMPACT_EQ_HEINE_BOREL, COMPACT_IMP_BOUNDED, .. } := BCPT
  let { CLOSED_INTER_COMPACT, COMPACT_EMPTY, .. } := BCPP1
  let { COMPACT_CBALL, COMPACT_DIFF, .. } := BCPP2
  let { OPEN_SUMS, .. } := BARC
  let { CLOSED_COMPACT_SUMS, .. } := BCCC
  -- @@SCOPE END

  let CLOSED_UNION_COMPACT_SUBSETS ← prove
   r"!s. closed s
       ==> ?f:num->real^N->bool.
                (!n. compact(f n)) /\
                (!n. (f n) SUBSET s) /\
                (!n. (f n) SUBSET f(n + 1)) /\
                UNIONS {f n | n IN (:num)} = s /\
                (!k. compact k /\ k SUBSET s
                     ==> ?N. !n. n >= N ==> k SUBSET (f n))"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\n. s INTER cball(vec 0:real^N,&n)") THEN
    ASM_SIMP_TAC [INTER_SUBSET, COMPACT_CBALL, CLOSED_INTER_COMPACT] THEN
    REPEAT CONJ_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"t SUBSET u ==> s INTER t SUBSET s INTER u")) THEN
      REWRITE_TAC [SUBSET_BALLS, DIST_REFL, ← GSYM REAL_OF_NUM_ADD] THEN
      REAL_ARITH_TAC,
      REWRITE_TAC [EXTENSION, UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV, IN_INTER] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_CBALL_0] THEN
      MESON_TAC [REAL_ARCH_SIMPLE],
      X_GEN_TAC (← q r"k:real^N->bool") THEN SIMP_TAC [SUBSET_INTER] THEN
      REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN DISCH_THEN
       (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP BOUNDED_SUBSET_CBALL) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPEC (← q r"r:real") REAL_ARCH_SIMPLE) THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"N:num") THEN REWRITE_TAC [← GSYM REAL_OF_NUM_GE] THEN
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          SUBSET_TRANS)) THEN
      REWRITE_TAC [SUBSET_BALLS, DIST_REFL] THEN ASM_REAL_ARITH_TAC])

  let OPEN_UNION_COMPACT_SUBSETS ← prove
   r"!s. open s
       ==> ?f:num->real^N->bool.
                (!n. compact(f n)) /\
                (!n. (f n) SUBSET s) /\
                (!n. (f n) SUBSET interior(f(n + 1))) /\
                UNIONS {f n | n IN (:num)} = s /\
                (!k. compact k /\ k SUBSET s
                     ==> ?N. !n. n >= N ==> k SUBSET (f n))"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [DISCH_TAC THEN EXISTS_TAC (← q r"(\n. {}):num->real^N->bool") THEN
      ASM_SIMP_TAC [EMPTY_SUBSET, SUBSET_EMPTY, COMPACT_EMPTY] THEN
      REWRITE_TAC [EXTENSION, UNIONS_GSPEC, IN_ELIM_THM, NOT_IN_EMPTY],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN STRIP_TAC] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!f. p1 f /\ p3 f /\ p4 f ==> p5 f) /\
      (?f. p1 f /\ p2 f /\ p3 f /\ (p2 f ==> p4 f))
      ==> ?f. p1 f /\ p2 f /\ p3 f /\ p4 f /\ p5 f")) THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:num->real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      X_GEN_TAC (← q r"k:real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [COMPACT_EQ_HEINE_BOREL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"{interior(f n):real^N->bool | n IN (:num)}")) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, OPEN_INTERIOR] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          SUBSET_TRANS)) THEN
        REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM] THEN ASM SET_TAC [],
        ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
        REWRITE_TAC [SIMPLE_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
        REWRITE_TAC [SUBSET_UNIV] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"i:num->bool") STRIP_ASSUME_TAC) THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"\n:num. n") o
          MATCH_MP UPPER_BOUND_FINITE_SET) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
        REWRITE_TAC [GE] THEN DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          SUBSET_TRANS)) THEN
        REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN MATCH_MP_TAC SUBSET_TRANS THEN
        EXISTS_TAC (← q r"(f:num->real^N->bool) m") THEN
        REWRITE_TAC [INTERIOR_SUBSET] THEN
        SUBGOAL_THEN (← q r"!m n. m <= n ==> (f:num->real^N->bool) m SUBSET f n")
         (fun th => ASM_MESON_TAC [th, LE_TRANS]) THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
        ASM_MESON_TAC [SUBSET, ADD1, INTERIOR_SUBSET]],
      EXISTS_TAC
       (← q r"\n. cball(a,&n) DIFF
           {x + e | x IN (:real^N) DIFF s /\ e IN ball(vec 0,inv(&n + &1))}") THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC COMPACT_DIFF THEN
        SIMP_TAC [COMPACT_CBALL, OPEN_SUMS, OPEN_BALL],
        GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
         (← q r"(UNIV DIFF s) SUBSET t ==> c DIFF t SUBSET s")) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"vec 0:real^N"] THEN
        ASM_REWRITE_TAC [VECTOR_ADD_RID, CENTRE_IN_BALL, REAL_LT_INV_EQ] THEN
        REAL_ARITH_TAC,
        GEN_TAC THEN REWRITE_TAC [INTERIOR_DIFF] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"s SUBSET s' /\ t' SUBSET t ==> (s DIFF t) SUBSET (s' DIFF t')")) THEN
        CONJ_TAC THENL
         [REWRITE_TAC [INTERIOR_CBALL, SUBSET, IN_BALL, IN_CBALL] THEN
          REWRITE_TAC [← GSYM REAL_OF_NUM_ADD] THEN REAL_ARITH_TAC,
          MATCH_MP_TAC SUBSET_TRANS THEN
          EXISTS_TAC (← q r"{x + e | x IN (:real^N) DIFF s /\
                               e IN cball(vec 0,inv(&n + &2))}") THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC CLOSURE_MINIMAL THEN
            ASM_SIMP_TAC [CLOSED_COMPACT_SUMS, COMPACT_CBALL,
                          ← GSYM OPEN_CLOSED] THEN
            MATCH_MP_TAC (← SET_RULE
             (← q r"t SUBSET t'
              ==> {f x y | x IN s /\ y IN t} SUBSET
                  {f x y | x IN s /\ y IN t'}")) THEN
            REWRITE_TAC [SUBSET, IN_BALL, IN_CBALL, ← GSYM REAL_OF_NUM_ADD] THEN
            REAL_ARITH_TAC,
            MATCH_MP_TAC (← SET_RULE
             (← q r"t SUBSET t'
              ==> {f x y | x IN s /\ y IN t} SUBSET
                  {f x y | x IN s /\ y IN t'}")) THEN
            REWRITE_TAC [SUBSET, IN_BALL, IN_CBALL, ← GSYM REAL_OF_NUM_ADD] THEN
            GEN_TAC THEN MATCH_MP_TAC (← REAL_ARITH
             (← q r"a < b ==> x <= a ==> x < b")) THEN
            MATCH_MP_TAC REAL_LT_INV2 THEN REAL_ARITH_TAC]],
        DISCH_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
        ASM_REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
        REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_UNIV, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN REWRITE_TAC [IN_DIFF] THEN
        REWRITE_TAC [IN_ELIM_THM, IN_UNIV, IN_BALL_0] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = y + e <=> e = x - y")] THEN
        REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ r <=> r /\ p /\ q"), UNWIND_THM2] THEN
        REWRITE_TAC [← MESON [] (← q r"~(?x. ~P x /\ Q x) <=> !x. Q x ==> P x")] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
        ASM_REWRITE_TAC [SUBSET, IN_BALL, dist] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [REAL_ARCH_INV]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N1:num") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPEC (← q r"norm(x - a:real^N)") REAL_ARCH_SIMPLE) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"N2:num")) THEN EXISTS_TAC (← q r"N1 + N2:num") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [IN_CBALL] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
          UNDISCH_TAC (← q r"norm(x - a:real^N) <= &N2") THEN
          REWRITE_TAC [dist, ← GSYM REAL_OF_NUM_ADD] THEN REAL_ARITH_TAC,
          REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          SUBGOAL_THEN (← q r"inv(&(N1 + N2) + &1) <= inv(&N1)") MP_TAC THENL
           [MATCH_MP_TAC REAL_LE_INV2 THEN
            ASM_SIMP_TAC [REAL_OF_NUM_LT, LE_1] THEN
            REWRITE_TAC [← GSYM REAL_OF_NUM_ADD] THEN REAL_ARITH_TAC,
            ASM_REAL_ARITH_TAC]]]])

  return { CLOSED_UNION_COMPACT_SUBSETS, OPEN_UNION_COMPACT_SUBSETS }

/- ------------------------------------------------------------------------- -/
/- Closed-graph characterization of continuity.  (topology.ml 13605-13675)   -/
/- ------------------------------------------------------------------------- -/

structure CGR where
  CONTINUOUS_CLOSED_GRAPH_GEN : thm
  CONTINUOUS_CLOSED_GRAPH_EQ : thm
  CONTINUOUS_CLOSED_GRAPH : thm
  CONTINUOUS_FROM_CLOSED_GRAPH : thm
  deriving Inhabited

@[nospecialize]
def setupCGR [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLOC : LOC) (BLPT : LPT) (BCSL : CSL)
    (BCMS : CMS) (BIDC : IDC) (BCLC : CLC) (BLCP : LCP) (BPCR1 : PCR1) (BPRP2 : PRP2)
    (BPCA2 : PCA2) : ExceptT String IO CGR := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { CONJ_ASSOC, EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_PASTECART, FSTCART_PASTECART, IMAGE_FSTCART_PCROSS,
        IN_ELIM_PASTECART_THM, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, .. } := D.core2
  let { PASTECART_INJ, PASTECART_IN_PCROSS, .. } := D.core3
  let { SNDCART_PASTECART, SUBSET, SUBSET_UNIV, .. } := D.core5
  let { o_DEF, .. } := D.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { VECTOR_SUB_EQ, .. } := D.vec4
  let { CLOSED_IN_INTER, .. } := D.met1
  let { CLOSED_IN_REFL, CLOSED_UNIV, .. } := BCLO
  let { CLOSED_IN_CLOSED_TRANS, CLOSED_SUBSET, .. } := BLOC
  let { CLOSED_SING, .. } := BLPT
  let { CONTINUOUS_ON_EMPTY, .. } := BCSL
  let { CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_ON_COMPOSE, .. } := BIDC
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_ON_CLOSED_GEN, .. } := BCLC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_PCROSS, .. } := BPCR1
  let { CLOSED_MAP_FSTCART, .. } := BPRP2
  let { CLOSED_IN_PCROSS, .. } := BPCA2
  -- @@SCOPE END

  let CONTINUOUS_CLOSED_GRAPH_GEN ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s SUBSET t
        ==> closed_in (subtopology euclidean (s PCROSS t))
                      {pastecart x (f x) | x IN s}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{pastecart (x:real^M) (f x:real^N) | x IN s} =
      {z | z IN s PCROSS t /\ f(fstcart z) - sndcart z IN {vec 0}}")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_ELIM_THM, IN_SING,
                   PASTECART_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART,
                   PASTECART_INJ, VECTOR_SUB_EQ] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
      REWRITE_TAC [CLOSED_SING] THEN MATCH_MP_TAC CONTINUOUS_ON_SUB THEN
      SIMP_TAC [← GSYM o_DEF, LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, IMAGE_FSTCART_PCROSS] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_EMPTY]])

  let CONTINUOUS_CLOSED_GRAPH_EQ ← prove
   r"!f:real^M->real^N s t.
        compact t /\ IMAGE f s SUBSET t
        ==> (f continuous_on s <=>
             closed_in (subtopology euclidean (s PCROSS t))
                       {pastecart x (f x) | x IN s})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [CONTINUOUS_CLOSED_GRAPH_GEN] THEN DISCH_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
     pure (REWRITE_TAC [← MATCH_MP CONTINUOUS_ON_CLOSED_GEN th])) THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ (f:real^M->real^N) x IN c} =
      IMAGE fstcart ({pastecart x (f x) | x IN s} INTER
                     (s PCROSS c))")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM, EXISTS_PASTECART,
                   FSTCART_PASTECART, IN_INTER, IN_ELIM_PASTECART_THM,
                   PASTECART_IN_PCROSS, PASTECART_INJ] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_MAP_FSTCART THEN EXISTS_TAC (← q r"t:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSED_IN_INTER THEN
      ASM_REWRITE_TAC [] THEN  MATCH_MP_TAC CLOSED_IN_PCROSS THEN
      ASM_REWRITE_TAC [CLOSED_IN_REFL]])

  let CONTINUOUS_CLOSED_GRAPH ← prove
   r"!f:real^M->real^N s.
        closed s /\ f continuous_on s ==> closed {pastecart x (f x) | x IN s}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_IN_CLOSED_TRANS THEN
    EXISTS_TAC (← q r"(s:real^M->bool) PCROSS (:real^N)") THEN
    ASM_SIMP_TAC [CLOSED_PCROSS, CLOSED_UNIV] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_GRAPH_GEN THEN
    ASM_REWRITE_TAC [SUBSET_UNIV])

  let CONTINUOUS_FROM_CLOSED_GRAPH ← prove
   r"!f:real^M->real^N s t.
        compact t /\ IMAGE f s SUBSET t /\
        closed {pastecart x (f x) | x IN s}
        ==> f continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP CONTINUOUS_CLOSED_GRAPH_EQ) THEN
    MATCH_MP_TAC CLOSED_SUBSET THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, PASTECART_IN_PCROSS] THEN
    ASM SET_TAC [])

  return { CONTINUOUS_CLOSED_GRAPH_GEN, CONTINUOUS_CLOSED_GRAPH_EQ, CONTINUOUS_CLOSED_GRAPH,
           CONTINUOUS_FROM_CLOSED_GRAPH }

/- ------------------------------------------------------------------------- -/
/- More topological properties of intervals.  (topology.ml 13676-13874)      -/
/- ------------------------------------------------------------------------- -/

structure ITV1 where
  OPEN_INTERVAL_LEMMA : thm
  OPEN_INTERVAL : thm
  CLOSED_INTERVAL : thm
  INTERIOR_CLOSED_INTERVAL : thm
  INTERIOR_INTERVAL : thm
  BOUNDED_CLOSED_INTERVAL : thm
  BOUNDED_INTERVAL : thm
  NOT_INTERVAL_UNIV : thm
  OPEN_INTERVAL_MIDPOINT : thm
  OPEN_CLOSED_INTERVAL_CONVEX : thm
  CLOSURE_OPEN_INTERVAL : thm
  CLOSURE_INTERVAL : thm
  FRONTIER_CLOSED_INTERVAL : thm
  FRONTIER_OPEN_INTERVAL : thm
  INTER_INTERVAL_MIXED_EQ_EMPTY : thm
  INTERVAL_TRANSLATION : thm
  deriving Inhabited

@[nospecialize]
def setupITV1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLPT : LPT) (BINT : INT)
    (BCLS1 : CLS1) (BFRO1 : FRO1) (BLIM2 : LIM2) (BRLM : RLM) (BARI : ARI) (BBND1 : BND1)
    (BSMI : SMI) : ExceptT String IO ITV1 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        VECTOR_ARITH, add_translation_invariants, GEOM_TRANSLATE_TAC, .. } := D
  let { AND_FORALL_THM, DE_MORGAN_THM, DIMINDEX_NONZERO, FINITE_IMAGE, FINITE_NUMSEG, .. } :=
    D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IN_DELETE, IN_ELIM_THM, IN_NUMSEG, .. } := D.core2
  let { IN_UNION, LAMBDA_BETA, LT_NZ, MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_FORALL_THM,
        NOT_INSERT_EMPTY, NUMSEG_EMPTY, REAL_ABS_INV, .. } := D.core3
  let { REAL_ARCH_INV, REAL_INV_EQ_0, REAL_INV_LE_1, REAL_LET_TRANS, REAL_LE_INV2, REAL_LE_LADD,
        REAL_LE_LMUL, REAL_LE_TRANS, REAL_LTE_ADD2, REAL_LT_INF_FINITE, REAL_LT_INV_EQ,
        REAL_LT_LADD, REAL_LT_LE, REAL_LT_LMUL_EQ, REAL_LT_MIN, .. } := D.core4
  let { REAL_MUL_RID, REAL_NOT_LT, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_SUB_LE, REAL_SUB_LT,
        REAL_SUB_RZERO, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_ANTISYM, .. } := D.core5
  let { SUM_LE, o_THM, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { COMPONENT_LE_NORM, DIST_LIFT, .. } := D.vec1
  let { INTERVAL_NE_EMPTY, INTERVAL_OPEN_SUBSET_CLOSED, IN_INTERVAL, .. } := D.vec2
  let { NORM_BASIS, NORM_LE_L1, NORM_MUL, NORM_NEG, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_SUB, VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0,
        VECTOR_SUB_COMPONENT, VECTOR_SUB_EQ, basis, dist, interval, .. } := D.vec4
  let { open_def, .. } := BEUC
  let { CLOSED_LIMPT, LIMPT_APPROACHABLE, .. } := BLPT
  let { INTERIOR_MAXIMAL, INTERIOR_OPEN, interior, .. } := BINT
  let { CLOSURE_CLOSED, CLOSURE_EMPTY, CLOSURE_MINIMAL, OPEN_INTER_CLOSURE_EQ_EMPTY, closure,
        .. } := BCLS1
  let { FRONTIER_EMPTY, frontier, .. } := BFRO1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIMPT_SEQUENTIAL, .. } := BRLM
  let { LIM_ADD, LIM_CONST, .. } := BARI
  let { BOUNDED_SUBSET, NOT_BOUNDED_UNIV, bounded, .. } := BBND1
  let { LIM_VMUL, .. } := BSMI
  -- @@SCOPE END

  let OPEN_INTERVAL_LEMMA ← prove
   r"!a b x. a < x /\ x < b
           ==> ?d. &0 < d /\ !x'. abs(x' - x) < d ==> a < x' /\ x' < b"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"min (x - a) (b - x)") THEN REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_REAL_ARITH_TAC)

  let OPEN_INTERVAL ← prove
   r"!a:real^N b. open(interval (a,b))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_def, interval, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"!i. 1 <= i /\ i <= dimindex(:N)
                      ==> ?d. &0 < d /\
                              !x'. abs(x' - (x:real^N)$i) < d
                                   ==> (a:real^N)$i < x' /\ x' < (b:real^N)$i")
    MP_TAC THENL [ASM_SIMP_TAC [OPEN_INTERVAL_LEMMA], ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:num->real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"inf (IMAGE d (1..dimindex(:N)))") THEN
    SIMP_TAC [REAL_LT_INF_FINITE, FINITE_IMAGE, FINITE_NUMSEG,
              IMAGE_EQ_EMPTY, NOT_INSERT_EMPTY, NUMSEG_EMPTY,
              ← ARITH_RULE (← q r"n < 1 <=> (n = 0)"), DIMINDEX_NONZERO] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_NUMSEG, dist] THEN
    ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LET_TRANS, VECTOR_SUB_COMPONENT])

  let CLOSED_INTERVAL ← prove
   r"!a:real^N b. closed(interval [a,b])"
   (REWRITE_TAC [CLOSED_LIMPT, LIMPT_APPROACHABLE, IN_INTERVAL] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(a:real^N)$i - (x:real^N)$i")),
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(x:real^N)$i - (b:real^N)$i"))] THEN
    ASM_REWRITE_TAC [REAL_SUB_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [dist, REAL_NOT_LT] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"abs((z - x :real^N)$i)") THEN
    ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
    ASM_SIMP_TAC [VECTOR_SUB_COMPONENT] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"x < a /\ a <= z ==> a - x <= abs(z - x)"),
                  ← REAL_ARITH (← q r"z <= b /\ b < x ==> x - b <= abs(z - x)")])

  let INTERIOR_CLOSED_INTERVAL ← prove
   r"!a:real^N b. interior(interval [a,b]) = interval (a,b)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC INTERIOR_MAXIMAL THEN
      REWRITE_TAC [INTERVAL_OPEN_SUBSET_CLOSED, OPEN_INTERVAL]] THEN
    REWRITE_TAC [interior, SUBSET, IN_INTERVAL, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^N->bool") STRIP_ASSUME_TAC) THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [REAL_LT_LE] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [open_def]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THENL
     [(← do
        let t ← q r"x - (e / &2) % basis i :real^N"
        pure (DISCH_THEN (MP_TAC o SPEC t) THEN FIRST_X_ASSUM (MP_TAC o SPEC t))),
      (← do
        let t ← q r"x + (e / &2) % basis i :real^N"
        pure (DISCH_THEN (MP_TAC o SPEC t) THEN FIRST_X_ASSUM (MP_TAC o SPEC t)))] THEN
    REWRITE_TAC [dist, VECTOR_ADD_SUB, ← VECTOR_ARITH (← q r"x - y - x = --y:real^N")] THEN
    ASM_SIMP_TAC [NORM_MUL, NORM_BASIS, NORM_NEG, REAL_MUL_RID,
                  ← REAL_ARITH (← q r"&0 < e ==> abs(e / &2) < e")] THEN
    MATCH_MP_TAC (← TAUT (← q r"~b ==> (a ==> b) ==> ~a")) THEN
    REWRITE_TAC [NOT_FORALL_THM] THEN EXISTS_TAC (← q r"i:num") THEN
    ASM_SIMP_TAC [DE_MORGAN_THM, VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT] THENL
     [DISJ1_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"a <= a - b <=> ~(&0 < b)")],
      DISJ2_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"a + b <= a <=> ~(&0 < b)")]] THEN
    ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, basis, LAMBDA_BETA, REAL_MUL_RID] THEN
    ASM_REWRITE_TAC [REAL_HALF])

  let INTERIOR_INTERVAL ← prove
   r"(!a b. interior(interval[a,b]) = interval(a,b)) /\
   (!a b. interior(interval(a,b)) = interval(a,b))"
   (SIMP_TAC [INTERIOR_CLOSED_INTERVAL, INTERIOR_OPEN, OPEN_INTERVAL])

  let BOUNDED_CLOSED_INTERVAL ← prove
   r"!a b:real^N. bounded (interval [a,b])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [bounded, interval] THEN
    EXISTS_TAC (← q r"sum(1..dimindex(:N))
                   (\i. abs((a:real^N)$i) + abs((b:real^N)$i))") THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum(1..dimindex(:N)) (\i. abs((x:real^N)$i))") THEN
    REWRITE_TAC [NORM_LE_L1] THEN MATCH_MP_TAC SUM_LE THEN
    ASM_SIMP_TAC [FINITE_NUMSEG, IN_NUMSEG, ← REAL_ARITH
     (← q r"a <= x /\ x <= b ==> abs(x) <= abs(a) + abs(b)")])

  let BOUNDED_INTERVAL ← prove
   r"(!a b. bounded (interval [a,b])) /\ (!a b. bounded (interval (a,b)))"
   (MESON_TAC [BOUNDED_CLOSED_INTERVAL, BOUNDED_SUBSET,
               INTERVAL_OPEN_SUBSET_CLOSED])

  let NOT_INTERVAL_UNIV ← prove
   r"(!a b. ~(interval[a,b] = (:real^N))) /\
   (!a b. ~(interval(a,b) = (:real^N)))"
   (MESON_TAC [BOUNDED_INTERVAL, NOT_BOUNDED_UNIV])

  let OPEN_INTERVAL_MIDPOINT ← prove
   r"!a b:real^N.
        ~(interval(a,b) = {}) ==> (inv(&2) % (a + b)) IN interval(a,b)"
   (REWRITE_TAC [INTERVAL_NE_EMPTY, IN_INTERVAL] THEN
    SIMP_TAC [VECTOR_MUL_COMPONENT, VECTOR_ADD_COMPONENT] THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let OPEN_CLOSED_INTERVAL_CONVEX ← prove
   r"!a b x y:real^N e.
        x IN interval(a,b) /\ y IN interval[a,b] /\ &0 < e /\ e <= &1
        ==> (e % x + (&1 - e) % y) IN interval(a,b)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← TAUT
     (← q r"(c /\ d ==> a /\ b ==> e) ==> a /\ b /\ c /\ d ==> e")) THEN
    STRIP_TAC THEN REWRITE_TAC [IN_INTERVAL, AND_FORALL_THM] THEN
    SIMP_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
    MATCH_MP_TAC MONO_FORALL THEN
    GEN_TAC THEN DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBST1_TAC (← REAL_ARITH (← q r"(a:real^N)$i = e * a$i + (&1 - e) * a$i")) THEN
    SUBST1_TAC (← REAL_ARITH (← q r"(b:real^N)$i = e * b$i + (&1 - e) * b$i")) THEN
    CONJ_TAC THEN MATCH_MP_TAC REAL_LTE_ADD2 THEN
    ASM_SIMP_TAC [REAL_LT_LMUL_EQ, REAL_LE_LMUL, REAL_SUB_LE])

  let CLOSURE_OPEN_INTERVAL ← prove
   r"!a b:real^N.
     ~(interval(a,b) = {}) ==> closure(interval(a,b)) = interval[a,b]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC CLOSURE_MINIMAL THEN
      REWRITE_TAC [INTERVAL_OPEN_SUBSET_CLOSED, CLOSED_INTERVAL],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET, closure, IN_UNION] THEN X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_TAC THEN MATCH_MP_TAC (← TAUT (← q r"(~b ==> c) ==> b \/ c")) THEN DISCH_TAC THEN
    REWRITE_TAC [IN_ELIM_THM, LIMPT_SEQUENTIAL] THEN
    ABBREV_TAC (← q r"(c:real^N) = inv(&2) % (a + b)") THEN
    EXISTS_TAC (← q r"\n. (x:real^N) + inv(&n + &1) % (c - x)") THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [IN_DELETE] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"x + a = x <=> a = vec 0")] THEN
      REWRITE_TAC [VECTOR_MUL_EQ_0, REAL_INV_EQ_0] THEN
      REWRITE_TAC [VECTOR_SUB_EQ, ← REAL_ARITH (← q r"~(&n + &1 = &0)")] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [OPEN_INTERVAL_MIDPOINT]] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"x + a % (y - x) = a % y + (&1 - a) % x")] THEN
      MATCH_MP_TAC OPEN_CLOSED_INTERVAL_CONVEX THEN
      CONJ_TAC THENL [ASM_MESON_TAC [OPEN_INTERVAL_MIDPOINT], ALL_TAC] THEN
      ASM_REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      MATCH_MP_TAC REAL_INV_LE_1 THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [← VECTOR_ARITH (← q r"x:real^N = x + &0 % (c - x)")] THEN
    MATCH_MP_TAC LIM_ADD THEN REWRITE_TAC [LIM_CONST] THEN
    MATCH_MP_TAC LIM_VMUL THEN REWRITE_TAC [LIM_CONST] THEN
    REWRITE_TAC [LIM_SEQUENTIALLY, o_THM, DIST_LIFT, REAL_SUB_RZERO] THEN
    X_GEN_TAC (← q r"e:real") THEN GEN_REWRITE_TAC LAND_CONV [REAL_ARCH_INV] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    REWRITE_TAC [REAL_ABS_INV] THEN MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"inv(&N)") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC REAL_LE_INV2 THEN UNDISCH_TAC (← q r"N:num <= n") THEN
    UNDISCH_TAC (← q r"~(N = 0)") THEN
    REWRITE_TAC [← GSYM LT_NZ, ← GSYM REAL_OF_NUM_LE, ← GSYM REAL_OF_NUM_LT] THEN
    REAL_ARITH_TAC)

  let CLOSURE_INTERVAL ← prove
   r"(!a b. closure(interval[a,b]) = interval[a,b]) /\
   (!a b. closure(interval(a,b)) =
          if interval(a,b) = {} then {} else interval[a,b])"
   (SIMP_TAC [CLOSURE_CLOSED, CLOSED_INTERVAL] THEN REPEAT GEN_TAC THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [CLOSURE_OPEN_INTERVAL, CLOSURE_EMPTY])

  let FRONTIER_CLOSED_INTERVAL ← prove
   r"!a b. frontier(interval[a,b]) = interval[a,b] DIFF interval(a,b)"
   (SIMP_TAC [frontier, INTERIOR_CLOSED_INTERVAL, CLOSURE_CLOSED,
              CLOSED_INTERVAL])

  let FRONTIER_OPEN_INTERVAL ← prove
   r"!a b. frontier(interval(a,b)) =
                if interval(a,b) = {} then {}
                else interval[a,b] DIFF interval(a,b)"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [FRONTIER_EMPTY] THEN
    ASM_SIMP_TAC [frontier, CLOSURE_OPEN_INTERVAL, INTERIOR_OPEN,
                  OPEN_INTERVAL])

  let INTER_INTERVAL_MIXED_EQ_EMPTY ← prove
   r"!a b c d:real^N.
        ~(interval(c,d) = {})
        ==> (interval(a,b) INTER interval[c,d] = {} <=>
             interval(a,b) INTER interval(c,d) = {})"
   (SIMP_TAC [← GSYM CLOSURE_OPEN_INTERVAL, OPEN_INTER_CLOSURE_EQ_EMPTY,
              OPEN_INTERVAL])

  let INTERVAL_TRANSLATION ← prove
   r"(!c a b. interval[c + a,c + b] = IMAGE (\x. c + x) (interval[a,b])) /\
   (!c a b. interval(c + a,c + b) = IMAGE (\x. c + x) (interval(a,b)))"
   (REWRITE_TAC [interval] THEN CONJ_TAC THEN GEOM_TRANSLATE_TAC [] THEN
    REWRITE_TAC [VECTOR_ADD_COMPONENT, REAL_LT_LADD, REAL_LE_LADD])

  add_translation_invariants
   [← CONJUNCT1 INTERVAL_TRANSLATION, ← CONJUNCT2 INTERVAL_TRANSLATION]

  return { OPEN_INTERVAL_LEMMA, OPEN_INTERVAL, CLOSED_INTERVAL, INTERIOR_CLOSED_INTERVAL,
           INTERIOR_INTERVAL, BOUNDED_CLOSED_INTERVAL, BOUNDED_INTERVAL, NOT_INTERVAL_UNIV,
           OPEN_INTERVAL_MIDPOINT, OPEN_CLOSED_INTERVAL_CONVEX, CLOSURE_OPEN_INTERVAL,
           CLOSURE_INTERVAL, FRONTIER_CLOSED_INTERVAL, FRONTIER_OPEN_INTERVAL,
           INTER_INTERVAL_MIXED_EQ_EMPTY, INTERVAL_TRANSLATION }

/- ------------------------------------------------------------------------- -/
/- Intervals, continued.  (topology.ml 13875-14069)                          -/
/- ------------------------------------------------------------------------- -/

structure ITV2 where
  EMPTY_AS_INTERVAL : thm
  UNIT_INTERVAL_NONEMPTY : thm
  IMAGE_STRETCH_INTERVAL : thm
  INTERVAL_IMAGE_STRETCH_INTERVAL : thm
  CLOSED_INTERVAL_IMAGE_UNIT_INTERVAL : thm
  SUMS_INTERVALS : thm
  PCROSS_INTERVAL : thm
  OPEN_CONTAINS_INTERVAL : thm
  OPEN_CONTAINS_OPEN_INTERVAL : thm
  DIAMETER_INTERVAL : thm
  deriving Inhabited

@[nospecialize]
def setupITV2 [HolBase] (D : TopologyDeps) (BBAL : BAL) (BBND1 : BND1) (BDIA1 : DIA1)
    (BITV1 : ITV1) : ExceptT String IO ITV2 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, SET_RULE, VECTOR_ARITH, NORM_ARITH_TAC, .. } := D
  let { ADD_SUB, AND_FORALL_THM, CARD_NUMSEG_1, CART_EQ, DIMINDEX_FINITE_SUM, DIMINDEX_GE_1,
        EXTENSION, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_PASTECART, IMAGE_CLAUSES, IN_ELIM_PASTECART_THM, IN_ELIM_THM, IN_IMAGE,
        IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, LE_1, LE_REFL, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY,
        NOT_LT, NUMSEG_EMPTY, PCROSS, .. } := D.core3
  let { REAL_INV_NEG, REAL_LE_ANTISYM, REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LE_NEG2,
        REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_RMUL_EQ, REAL_LE_TRANS, REAL_LT_01,
        REAL_LT_DIV, .. } := D.core4
  let { REAL_MAX_ACI, REAL_MIN_ACI, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RNEG,
        REAL_MUL_RZERO, REAL_MUL_SYM, REAL_OF_NUM_LT, REAL_POS, SUBSET, SUBSET_EMPTY,
        SUBSET_TRANS, .. } := D.core5
  let { SUM_BOUND_GEN, UNWIND_THM2, pastecart, real_div, real_max, real_min, .. } := D.core6
  let { LAMBDA_SKOLEM, REAL_LE_BETWEEN, REAL_LT_BETWEEN, .. } := D.misc
  let { ENDS_IN_INTERVAL, .. } := D.vec1
  let { INTERVAL_NE_EMPTY, INTERVAL_OPEN_SUBSET_CLOSED, IN_INTERVAL, .. } := D.vec2
  let { NORM_LE_COMPONENTWISE, NORM_LE_L1, NORM_MUL, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT, VEC_COMPONENT, dist,
        .. } := D.vec4
  let { IN_CBALL, OPEN_CONTAINS_BALL, OPEN_CONTAINS_CBALL, .. } := BBAL
  let { BOUNDED_CBALL, .. } := BBND1
  let { DIAMETER_BOUNDED_BOUND, DIAMETER_CBALL, DIAMETER_CLOSURE, DIAMETER_EMPTY,
        DIAMETER_SUBSET, .. } := BDIA1
  let { BOUNDED_INTERVAL, CLOSURE_INTERVAL, INTERVAL_TRANSLATION, OPEN_INTERVAL, .. } := BITV1
  -- @@SCOPE END

  let EMPTY_AS_INTERVAL ← prove
   r"{} = interval[vec 1,vec 0]"
   (SIMP_TAC [EXTENSION, NOT_IN_EMPTY, IN_INTERVAL, VEC_COMPONENT] THEN
    GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"1")) THEN
    REWRITE_TAC [LE_REFL, DIMINDEX_GE_1] THEN REAL_ARITH_TAC)

  let UNIT_INTERVAL_NONEMPTY ← prove
   r"~(interval[vec 0:real^N,vec 1] = {}) /\
   ~(interval(vec 0:real^N,vec 1) = {})"
   (SIMP_TAC [INTERVAL_NE_EMPTY, VEC_COMPONENT, REAL_LT_01, REAL_POS])

  let IMAGE_STRETCH_INTERVAL ← prove
   r"!a b:real^N m.
    IMAGE (\x. lambda k. m(k) * x$k) (interval[a,b]) =
        if interval[a,b] = {} then {}
        else interval[(lambda k. min (m(k) * a$k) (m(k) * b$k)):real^N,
                      (lambda k. max (m(k) * a$k) (m(k) * b$k))]"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [IMAGE_CLAUSES] THEN
    ASM_SIMP_TAC [EXTENSION, IN_IMAGE, CART_EQ, IN_INTERVAL, AND_FORALL_THM,
                  ← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> a ==> b /\ c"),
                  LAMBDA_BETA, ← GSYM LAMBDA_SKOLEM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN MATCH_MP_TAC (← MESON []
     (← q r"(!x. p x ==> (q x <=> r x))
      ==> ((!x. p x ==> q x) <=> (!x. p x ==> r x))")) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INTERVAL_NE_EMPTY]) THEN
    MATCH_MP_TAC MONO_FORALL THEN
    X_GEN_TAC (← q r"k:num") THEN ASM_CASES_TAC (← q r"1 <= k /\ k <= dimindex(:N)") THEN
    ASM_REWRITE_TAC [] THEN ASM_CASES_TAC (← q r"(m:num->real) k = &0") THENL
     [ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_MAX_ACI, REAL_MIN_ACI] THEN
      ASM_MESON_TAC [REAL_LE_ANTISYM, REAL_LE_REFL],
      ALL_TAC] THEN
    ASM_SIMP_TAC [← REAL_FIELD (← q r"~(m = &0) ==> (x = m * y <=> y = x / m)")] THEN
    REWRITE_TAC [UNWIND_THM2] THEN FIRST_X_ASSUM (DISJ_CASES_TAC o MATCH_MP
     (← REAL_ARITH (← q r"~(z = &0) ==> &0 < z \/ &0 < --z")))
    THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← GSYM REAL_LE_NEG2] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"--(max a b) = min (--a) (--b)"),
                   ← REAL_ARITH (← q r"--(min a b) = max (--a) (--b)"), real_div,
                   ← GSYM REAL_MUL_RNEG, ← GSYM REAL_INV_NEG] THEN
      REWRITE_TAC [← GSYM real_div]] THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ] THEN
    ASM_SIMP_TAC [real_min, real_max, REAL_LE_LMUL_EQ, REAL_LE_RMUL_EQ] THEN
    REAL_ARITH_TAC)

  let INTERVAL_IMAGE_STRETCH_INTERVAL ← prove
   r"!a b:real^N m. ?u v:real^N.
     IMAGE (\x. lambda k. m k * x$k) (interval[a,b]) = interval[u,v]"
   (REWRITE_TAC [IMAGE_STRETCH_INTERVAL] THEN MESON_TAC [EMPTY_AS_INTERVAL])

  let CLOSED_INTERVAL_IMAGE_UNIT_INTERVAL ← prove
   r"!a b:real^N.
        ~(interval[a,b] = {})
        ==> interval[a,b] = IMAGE (\x:real^N. a + x)
                                  (IMAGE (\x. (lambda i. (b$i - a$i) * x$i))
                                         (interval[vec 0:real^N,vec 1]))"
   (REWRITE_TAC [INTERVAL_NE_EMPTY] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [IMAGE_STRETCH_INTERVAL, UNIT_INTERVAL_NONEMPTY] THEN
    REWRITE_TAC [← GSYM INTERVAL_TRANSLATION] THEN
    REWRITE_TAC [EXTENSION, IN_INTERVAL] THEN
    SIMP_TAC [LAMBDA_BETA, VECTOR_ADD_COMPONENT, VEC_COMPONENT] THEN
    GEN_TAC THEN REWRITE_TAC [REAL_MUL_RZERO, REAL_MUL_RID] THEN
    MATCH_MP_TAC (← MESON [] (← q r"(!x. P x <=> Q x) ==> ((!x. P x) <=> (!x. Q x))")) THEN
    POP_ASSUM MP_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
    ASM_CASES_TAC (← q r"1 <= i /\ i <= dimindex(:N)") THEN ASM_REWRITE_TAC [] THEN
    REAL_ARITH_TAC)

  let SUMS_INTERVALS ← prove
   r"(!a b c d:real^N.
        ~(interval[a,b] = {}) /\ ~(interval[c,d] = {})
        ==> {x + y | x IN interval[a,b] /\ y IN interval[c,d]} =
            interval[a+c,b+d]) /\
   (!a b c d:real^N.
        ~(interval(a,b) = {}) /\ ~(interval(c,d) = {})
        ==> {x + y | x IN interval(a,b) /\ y IN interval(c,d)} =
            interval(a+c,b+d))"
   (CONJ_TAC THEN REPEAT GEN_TAC THEN REWRITE_TAC [INTERVAL_NE_EMPTY] THEN
    STRIP_TAC THEN REWRITE_TAC [EXTENSION, IN_INTERVAL, IN_ELIM_THM] THEN
    REWRITE_TAC [← TAUT (← q r"(a /\ b) /\ c <=> c /\ a /\ b")] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = y + z <=> z = x - y")] THEN
    REWRITE_TAC [UNWIND_THM2, VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT] THEN
    (X_GEN_TAC (← q r"x:real^N") THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC),
      DISCH_TAC THEN
      REWRITE_TAC [AND_FORALL_THM, ← GSYM LAMBDA_SKOLEM,
                   ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
      REWRITE_TAC [← REAL_ARITH
       (← q r"((a <= y /\ y <= b) /\ c <= x - y /\ x - y <= d <=>
         max a (x - d) <= y /\ y <= min b (x - c)) /\
        ((a < y /\ y < b) /\ c < x - y /\ x - y < d <=>
         max a (x - d) < y /\ y < min b (x - c))")] THEN
      REWRITE_TAC [← GSYM REAL_LE_BETWEEN, ← GSYM REAL_LT_BETWEEN]] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC))

  let PCROSS_INTERVAL ← prove
   r"!a b:real^M c d:real^N.
        interval[a,b] PCROSS interval[c,d] =
        interval[pastecart a c,pastecart b d]"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PCROSS] THEN
    REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
    SIMP_TAC [IN_INTERVAL, pastecart, LAMBDA_BETA, DIMINDEX_FINITE_SUM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^N"] THEN EQ_TAC THEN
    STRIP_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      CONJ_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_ARITH_TAC,
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i + dimindex(:M)")) THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [ADD_SUB] THENL
         [ASM_ARITH_TAC,
          DISCH_THEN MATCH_MP_TAC THEN ASM_ARITH_TAC]]])

  let (OPEN_CONTAINS_INTERVAL, OPEN_CONTAINS_OPEN_INTERVAL) ← CONJ_PAIR (← prove
   r"(!s:real^N->bool.
        open s <=>
        !x. x IN s ==> ?a b. x IN interval(a,b) /\ interval[a,b] SUBSET s) /\
   (!s:real^N->bool.
        open s <=>
        !x. x IN s ==> ?a b. x IN interval(a,b) /\ interval(a,b) SUBSET s)"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> r) /\ (r ==> p) /\ (p ==> q) ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [SUBSET_TRANS, INTERVAL_OPEN_SUBSET_CLOSED],
      DISCH_TAC THEN REWRITE_TAC [OPEN_CONTAINS_BALL] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"interval(a:real^N,b)") OPEN_CONTAINS_BALL) THEN
      REWRITE_TAC [OPEN_INTERVAL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [SUBSET_TRANS, INTERVAL_OPEN_SUBSET_CLOSED],
      DISCH_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o
        GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"x - e / &(dimindex(:N)) % vec 1:real^N") THEN
      EXISTS_TAC (← q r"x + e / &(dimindex(:N)) % vec 1:real^N") THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"b SUBSET s ==> x IN i /\ j SUBSET b ==> x IN i /\ j SUBSET s"))) THEN
      SIMP_TAC [IN_INTERVAL, VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT, IN_CBALL,
                VEC_COMPONENT, VECTOR_ADD_COMPONENT, SUBSET, REAL_MUL_RID] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x - e < x /\ x < x + e <=> &0 < e"),
                   ← REAL_ARITH (← q r"x - e <= y /\ y <= x + e <=> abs(x - y) <= e")] THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1] THEN
      X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN
      DISCH_TAC THEN REWRITE_TAC [dist] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"sum(1..dimindex(:N)) (\i. abs((x - y:real^N)$i))") THEN
      REWRITE_TAC [NORM_LE_L1] THEN MATCH_MP_TAC SUM_BOUND_GEN THEN
      ASM_SIMP_TAC [CARD_NUMSEG_1, IN_NUMSEG, FINITE_NUMSEG] THEN
      REWRITE_TAC [NUMSEG_EMPTY, NOT_LT, DIMINDEX_GE_1]]))

  let DIAMETER_INTERVAL ← prove
   r"(!a b:real^N.
        diameter(interval[a,b]) =
        if interval[a,b] = {} then &0 else norm(b - a)) /\
   (!a b:real^N.
        diameter(interval(a,b)) =
        if interval(a,b) = {} then &0 else norm(b - a))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THENL
     [ASM_MESON_TAC [INTERVAL_OPEN_SUBSET_CLOSED, SUBSET_EMPTY, DIAMETER_EMPTY],
      ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN
      ASM_SIMP_TAC [DIAMETER_BOUNDED_BOUND,
                    ENDS_IN_INTERVAL, BOUNDED_INTERVAL] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
       (← q r"diameter(cball(inv(&2) % (a + b):real^N,norm(b - a) / &2))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC DIAMETER_SUBSET THEN REWRITE_TAC [BOUNDED_CBALL] THEN
        REWRITE_TAC [SUBSET, IN_INTERVAL, IN_CBALL] THEN
        GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [dist] THEN
        REWRITE_TAC [← GSYM NORM_MUL, ← REAL_ARITH (← q r"x / &2 = abs(inv(&2)) * x")] THEN
        MATCH_MP_TAC NORM_LE_COMPONENTWISE THEN
        X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
        ASM_REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT,
                         VECTOR_MUL_COMPONENT] THEN
        REAL_ARITH_TAC,
        REWRITE_TAC [DIAMETER_CBALL] THEN NORM_ARITH_TAC],
      DISCH_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [DIAMETER_EMPTY] THEN
      SUBGOAL_THEN (← q r"interval[a:real^N,b] = closure(interval(a,b))")
      SUBST_ALL_TAC THEN ASM_REWRITE_TAC [CLOSURE_INTERVAL] THEN
      ASM_MESON_TAC [DIAMETER_CLOSURE, BOUNDED_INTERVAL]])

  return { EMPTY_AS_INTERVAL, UNIT_INTERVAL_NONEMPTY, IMAGE_STRETCH_INTERVAL,
           INTERVAL_IMAGE_STRETCH_INTERVAL, CLOSED_INTERVAL_IMAGE_UNIT_INTERVAL, SUMS_INTERVALS,
           PCROSS_INTERVAL, OPEN_CONTAINS_INTERVAL, OPEN_CONTAINS_OPEN_INTERVAL,
           DIAMETER_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Intervals, continued.  (topology.ml 14070-14204)                          -/
/- ------------------------------------------------------------------------- -/

structure ITV3 where
  IMAGE_TWIZZLE_INTERVAL : thm
  EQ_INTERVAL : thm
  CLOSED_INTERVAL_EQ : thm
  OPEN_INTERVAL_EQ : thm
  COMPACT_INTERVAL_EQ : thm
  CLOSED_INTERVAL_DROPOUT : thm
  IMAGE_DROPOUT_CLOSED_INTERVAL : thm
  EQ_BALLS : thm
  deriving Inhabited

@[nospecialize]
def setupITV3 [HolBase] (D : TopologyDeps) (BCLO : CLO) (BBAL : BAL) (BCON : CON) (BCBL : CBL)
    (BBND1 : BND1) (BBLS : BLS) (BCPT : CPT) (BITV1 : ITV1) : ExceptT String IO ITV3 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, IMP_REWRITE_TAC,
        NORM_ARITH_TAC, .. } := D
  let { ADD_SUB, AND_FORALL_THM, CART_EQ, EQ_SYM_EQ, EXTENSION, .. } := D.core1
  let { IMAGE_EQ_EMPTY, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_REFL, .. } := D.core4
  let { REAL_NOT_LE, SUBSET_ANTISYM_EQ, SUB_ADD, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, .. } := D.core6
  let { PERMUTES_INVERSES, PERMUTES_INVERSE_EQ, PERMUTES_IN_IMAGE, .. } := D.lib2
  let { INTERVAL_EQ_EMPTY, INTERVAL_NE_EMPTY, IN_IMAGE_DROPOUT, IN_INTERVAL, .. } := D.vec2
  let { SUBSET_INTERVAL, .. } := D.vec3
  let { dropout, pushin, .. } := D.vec4
  let { CLOSED_EMPTY, .. } := BCLO
  let { BALL_EQ_EMPTY, IN_BALL, IN_CBALL, OPEN_BALL, .. } := BBAL
  let { CLOPEN, .. } := BCON
  let { CBALL_EQ_EMPTY, CLOSED_CBALL, .. } := BCBL
  let { BOUNDED_BALL, NOT_BOUNDED_UNIV, .. } := BBND1
  let { SUBSET_BALLS, .. } := BBLS
  let { COMPACT_EQ_BOUNDED_CLOSED, .. } := BCPT
  let { BOUNDED_INTERVAL, CLOSED_INTERVAL, NOT_INTERVAL_UNIV, OPEN_INTERVAL, .. } := BITV1
  -- @@SCOPE END

  let IMAGE_TWIZZLE_INTERVAL ← prove
   r"!p a b. dimindex(:M) = dimindex(:N) /\ p permutes 1..dimindex(:N)
           ==> IMAGE ((\x. lambda i. x$(p i)):real^M->real^N) (interval[a,b]) =
               interval[(lambda i. a$(p i)),(lambda i. b$(p i))]"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    SIMP_TAC [IN_INTERVAL, CART_EQ, LAMBDA_BETA] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(lambda i. (y:real^N)$(inverse p i)):real^M") THEN
      IMP_REWRITE_TAC [LAMBDA_BETA] THEN
      ASM_REWRITE_TAC [← GSYM IN_NUMSEG] THEN
      ASM_MESON_TAC [PERMUTES_INVERSE_EQ, PERMUTES_IN_IMAGE],
      REWRITE_TAC [← GSYM IN_NUMSEG] THEN
      ASM_MESON_TAC [PERMUTES_INVERSES, PERMUTES_IN_IMAGE]])

  let EQ_INTERVAL ← prove
   r"(!a b c d:real^N.
        interval[a,b] = interval[c,d] <=>
        interval[a,b] = {} /\ interval[c,d] = {} \/ a = c /\ b = d) /\
   (!a b c d:real^N.
        interval[a,b] = interval(c,d) <=>
        interval[a,b] = {} /\ interval(c,d) = {}) /\
   (!a b c d:real^N.
        interval(a,b) = interval[c,d] <=>
        interval(a,b) = {} /\ interval[c,d] = {}) /\
   (!a b c d:real^N.
        interval(a,b) = interval(c,d) <=>
        interval(a,b) = {} /\ interval(c,d) = {} \/ a = c /\ b = d)"
   (REPEAT CONJ_TAC THEN REPEAT GEN_TAC THEN
    (EQ_TAC THENL [ALL_TAC, STRIP_TAC THEN ASM_REWRITE_TAC []]) THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(p = {} /\ q = {} ==> r) /\ (~(p = {}) /\ ~(q = {}) ==> p = q ==> r)
      ==> p = q ==> r")) THEN
    SIMP_TAC [] THENL
     [REWRITE_TAC [INTERVAL_NE_EMPTY, CART_EQ] THEN
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
      SIMP_TAC [SUBSET_INTERVAL, ← GSYM REAL_LE_ANTISYM],
      STRIP_TAC THEN MATCH_MP_TAC (← MESON [CLOPEN]
       (← q r"closed s /\ open t /\ ~(s = {}) /\ ~(s = UNIV) ==> ~(s = t)")) THEN
      ASM_REWRITE_TAC [CLOSED_INTERVAL, OPEN_INTERVAL, NOT_INTERVAL_UNIV],
      STRIP_TAC THEN MATCH_MP_TAC (← MESON [CLOPEN]
       (← q r"closed s /\ open t /\ ~(s = {}) /\ ~(s = UNIV) ==> ~(t = s)")) THEN
      ASM_REWRITE_TAC [CLOSED_INTERVAL, OPEN_INTERVAL, NOT_INTERVAL_UNIV],
      REWRITE_TAC [INTERVAL_NE_EMPTY, CART_EQ] THEN
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
      SIMP_TAC [SUBSET_INTERVAL, ← GSYM REAL_LE_ANTISYM]])

  let CLOSED_INTERVAL_EQ ← prove
   r"(!a b:real^N. closed(interval[a,b])) /\
   (!a b:real^N. closed(interval(a,b)) <=> interval(a,b) = {})"
   (REWRITE_TAC [CLOSED_INTERVAL] THEN
    REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [CLOSED_EMPTY] THEN
    MP_TAC (← ISPEC (← q r"interval(a:real^N,b)") CLOPEN) THEN
    ASM_REWRITE_TAC [OPEN_INTERVAL] THEN
    MESON_TAC [BOUNDED_INTERVAL, NOT_BOUNDED_UNIV])

  let OPEN_INTERVAL_EQ ← prove
   r"(!a b:real^N. open(interval[a,b]) <=> interval[a,b] = {}) /\
   (!a b:real^N. open(interval(a,b)))"
   (REWRITE_TAC [OPEN_INTERVAL] THEN
    REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [CLOSED_EMPTY] THEN
    MP_TAC (← ISPEC (← q r"interval[a:real^N,b]") CLOPEN) THEN
    ASM_REWRITE_TAC [CLOSED_INTERVAL] THEN
    MESON_TAC [BOUNDED_INTERVAL, NOT_BOUNDED_UNIV])

  let COMPACT_INTERVAL_EQ ← prove
   r"(!a b:real^N. compact(interval[a,b])) /\
   (!a b:real^N. compact(interval(a,b)) <=> interval(a,b) = {})"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_INTERVAL] THEN
    REWRITE_TAC [CLOSED_INTERVAL_EQ])

  let CLOSED_INTERVAL_DROPOUT ← prove
   r"!k a b. dimindex(:M) + 1 = dimindex(:N) /\
           1 <= k /\ k <= dimindex(:N) /\
           a$k <= b$k
           ==> interval[dropout k a,dropout k b] =
               IMAGE (dropout k:real^N->real^M) (interval[a,b])"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [EXTENSION, IN_IMAGE_DROPOUT, IN_INTERVAL] THEN
    X_GEN_TAC (← q r"x:real^M") THEN
    SIMP_TAC [pushin, dropout, LAMBDA_BETA] THEN EQ_TAC THENL
     [DISCH_TAC THEN EXISTS_TAC (← q r"(a:real^N)$k") THEN X_GEN_TAC (← q r"i:num") THEN
      STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_ARITH_TAC,
        COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i - 1")) THEN
        COND_CASES_TAC THENL [ASM_ARITH_TAC, ASM_REWRITE_TAC []] THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, ASM_SIMP_TAC [SUB_ADD]]],
      DISCH_THEN (X_CHOOSE_TAC (← q r"t:real")) THEN X_GEN_TAC (← q r"i:num") THEN
      STRIP_TAC THEN COND_CASES_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_ARITH_TAC,
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i + 1")) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        COND_CASES_TAC THEN REWRITE_TAC [ADD_SUB] THEN ASM_ARITH_TAC]])

  let IMAGE_DROPOUT_CLOSED_INTERVAL ← prove
   r"!k a b. dimindex(:M) + 1 = dimindex(:N) /\
           1 <= k /\ k <= dimindex(:N)
           ==> IMAGE (dropout k:real^N->real^M) (interval[a,b]) =
                  if a$k <= b$k then interval[dropout k a,dropout k b]
                  else {}"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [CLOSED_INTERVAL_DROPOUT, IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [INTERVAL_EQ_EMPTY, ← GSYM REAL_NOT_LE] THEN ASM_MESON_TAC [])

  let EQ_BALLS ← prove
   r"(!a a':real^N r r'.
      ball(a,r) = ball(a',r') <=> a = a' /\ r = r' \/ r <= &0 /\ r' <= &0) /\
   (!a a':real^N r r'.
      ball(a,r) = cball(a',r') <=> r <= &0 /\ r' < &0) /\
   (!a a':real^N r r'.
      cball(a,r) = ball(a',r') <=> r < &0 /\ r' <= &0) /\
   (!a a':real^N r r'.
      cball(a,r) = cball(a',r') <=> a = a' /\ r = r' \/ r < &0 /\ r' < &0)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT STRIP_TAC THEN
    (EQ_TAC THENL
      [ALL_TAC, REWRITE_TAC [EXTENSION, IN_BALL, IN_CBALL] THEN NORM_ARITH_TAC])
    THENL
     [REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET_BALLS] THEN NORM_ARITH_TAC,
      ONCE_REWRITE_TAC [EQ_SYM_EQ],
      ALL_TAC,
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET_BALLS] THEN NORM_ARITH_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← MESON [CLOPEN, BOUNDED_BALL, NOT_BOUNDED_UNIV]
      (← q r"s = t ==> closed s /\ open t /\ bounded t ==> s = {} /\ t = {}"))) THEN
    REWRITE_TAC [OPEN_BALL, CLOSED_CBALL, BOUNDED_BALL,
                 BALL_EQ_EMPTY, CBALL_EQ_EMPTY] THEN
    REAL_ARITH_TAC)

  return { IMAGE_TWIZZLE_INTERVAL, EQ_INTERVAL, CLOSED_INTERVAL_EQ, OPEN_INTERVAL_EQ,
           COMPACT_INTERVAL_EQ, CLOSED_INTERVAL_DROPOUT, IMAGE_DROPOUT_CLOSED_INTERVAL,
           EQ_BALLS }

/- ------------------------------------------------------------------------- -/
/- Some special cases for intervals in R^1.  (topology.ml 14205-14392)       -/
/- ------------------------------------------------------------------------- -/

structure R1A where
  IN_INTERVAL_1 : thm
  REAL_INTERVAL_INTERVAL : thm
  INTERVAL_REAL_INTERVAL : thm
  DROP_IN_REAL_INTERVAL : thm
  LIFT_IN_INTERVAL : thm
  IMAGE_LIFT_REAL_INTERVAL : thm
  IMAGE_DROP_INTERVAL : thm
  INTERVAL_CASES_1 : thm
  INTERVAL_EQ_EMPTY_1 : thm
  INTERVAL_NE_EMPTY_1 : thm
  UNION_INTERVAL_1 : thm
  SUBSET_INTERVAL_1 : thm
  EQ_INTERVAL_1 : thm
  DISJOINT_INTERVAL_1 : thm
  OPEN_CLOSED_INTERVAL_1 : thm
  CLOSED_OPEN_INTERVAL_1 : thm
  BALL_1 : thm
  SPHERE_1 : thm
  FINITE_SPHERE_1 : thm
  FINITE_INTERVAL_1 : thm
  BALL_INTERVAL : thm
  CBALL_INTERVAL : thm
  BALL_INTERVAL_0 : thm
  CBALL_INTERVAL_0 : thm
  INTER_INTERVAL_1 : thm
  CLOSED_DIFF_OPEN_INTERVAL_1 : thm
  deriving Inhabited

@[nospecialize]
def setupR1A [HolBase] (D : TopologyDeps) (BBAL : BAL) : ExceptT String IO R1A := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH_TAC, .. } :=
    D
  let { CART_EQ, CONJ_ASSOC, DIMINDEX_1, EXTENSION, FINITE_DELETE, FINITE_EMPTY,
        FINITE_IMAGE_INJ_EQ, FINITE_INSERT, .. } := D.core1
  let { FINITE_REAL_INTERVAL, IMAGE_o, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, .. } :=
    D.core2
  let { IN_UNION, LE_ANTISYM, NOT_IN_EMPTY, .. } := D.core3
  let { SURJECTIVE_IMAGE_EQ, UNWIND_THM1, o_DEF, real_max, real_min, .. } := D.core6
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { DISJOINT_INTERVAL, DIST_REAL, DROP_ADD, DROP_EQ, DROP_SUB, EXISTS_DROP, EXISTS_LIFT,
        FORALL_1, FORALL_DIMINDEX_1, FORALL_DROP, .. } := D.vec1
  let { INTERVAL_EQ_EMPTY, IN_INTERVAL, LIFT_DROP, LIFT_EQ, .. } := D.vec2
  let { NORM_REAL, SUBSET_INTERVAL, .. } := D.vec3
  let { dist, drop, .. } := D.vec4
  let { IN_BALL, IN_CBALL, sphere, .. } := BBAL
  -- @@SCOPE END

  let IN_INTERVAL_1 ← prove
   r"!a b x:real^1.
        (x IN interval[a,b] <=> drop a <= drop x /\ drop x <= drop b) /\
        (x IN interval(a,b) <=> drop a < drop x /\ drop x < drop b)"
   (REWRITE_TAC [IN_INTERVAL, drop, CONJ_ASSOC, DIMINDEX_1, LE_ANTISYM] THEN
    MESON_TAC [])

  let REAL_INTERVAL_INTERVAL ← prove
   r"real_interval[a,b] = IMAGE drop (interval[lift a,lift b]) /\
   real_interval(a,b) = IMAGE drop (interval(lift a,lift b))"
   (REWRITE_TAC [EXTENSION, IN_IMAGE, IN_INTERVAL_1, IN_REAL_INTERVAL] THEN
    REWRITE_TAC [EXISTS_LIFT, LIFT_DROP, UNWIND_THM1])

  let INTERVAL_REAL_INTERVAL ← prove
   r"interval[a,b] = IMAGE lift (real_interval[drop a,drop b]) /\
   interval(a,b) = IMAGE lift (real_interval(drop a,drop b))"
   (REWRITE_TAC [EXTENSION, IN_IMAGE, IN_INTERVAL_1, IN_REAL_INTERVAL] THEN
    REWRITE_TAC [EXISTS_DROP, LIFT_DROP, UNWIND_THM1])

  let DROP_IN_REAL_INTERVAL ← prove
   r"(!a b x. drop x IN real_interval[a,b] <=> x IN interval[lift a,lift b]) /\
   (!a b x. drop x IN real_interval(a,b) <=> x IN interval(lift a,lift b))"
   (REWRITE_TAC [REAL_INTERVAL_INTERVAL, IN_IMAGE] THEN MESON_TAC [LIFT_DROP])

  let LIFT_IN_INTERVAL ← prove
   r"(!a b x. lift x IN interval[a,b] <=> x IN real_interval[drop a,drop b]) /\
   (!a b x. lift x IN interval(a,b) <=> x IN real_interval(drop a,drop b))"
   (REWRITE_TAC [FORALL_DROP, DROP_IN_REAL_INTERVAL, LIFT_DROP])

  let IMAGE_LIFT_REAL_INTERVAL ← prove
   r"IMAGE lift (real_interval[a,b]) = interval[lift a,lift b] /\
   IMAGE lift (real_interval(a,b)) = interval(lift a,lift b)"
   (REWRITE_TAC [REAL_INTERVAL_INTERVAL, ← GSYM IMAGE_o, o_DEF, LIFT_DROP] THEN
    SET_TAC [])

  let IMAGE_DROP_INTERVAL ← prove
   r"IMAGE drop (interval[a,b]) = real_interval[drop a,drop b] /\
   IMAGE drop (interval(a,b)) = real_interval(drop a,drop b)"
   (REWRITE_TAC [INTERVAL_REAL_INTERVAL, ← GSYM IMAGE_o, o_DEF, LIFT_DROP] THEN
    SET_TAC [])

  let INTERVAL_CASES_1 ← prove
   r"!x:real^1. x IN interval[a,b] ==> x IN interval(a,b) \/ (x = a) \/ (x = b)"
   (REWRITE_TAC [CART_EQ, IN_INTERVAL, FORALL_DIMINDEX_1] THEN REAL_ARITH_TAC)

  let INTERVAL_EQ_EMPTY_1 ← prove
   r"!a b:real^1.
        (interval[a,b] = {} <=> drop b < drop a) /\
        (interval(a,b) = {} <=> drop b <= drop a)"
   (REWRITE_TAC [INTERVAL_EQ_EMPTY, drop, CONJ_ASSOC, DIMINDEX_1, LE_ANTISYM] THEN
    MESON_TAC [])

  let INTERVAL_NE_EMPTY_1 ← prove
   r"(!a b:real^1. ~(interval[a,b] = {}) <=> drop a <= drop b) /\
   (!a b:real^1. ~(interval(a,b) = {}) <=> drop a < drop b)"
   (REWRITE_TAC [INTERVAL_EQ_EMPTY_1] THEN REAL_ARITH_TAC)

  let UNION_INTERVAL_1 ← prove
   r"!a b c:real^1.
    c IN interval[a,b] ==> interval[a,c] UNION interval[c,b] = interval[a,b]"
   (REWRITE_TAC [EXTENSION, IN_UNION, IN_INTERVAL_1] THEN REAL_ARITH_TAC)

  let SUBSET_INTERVAL_1 ← prove
   r"!a b c d.
        (interval[a,b] SUBSET interval[c,d] <=>
                drop b < drop a \/
                drop c <= drop a /\ drop a <= drop b /\ drop b <= drop d) /\
        (interval[a,b] SUBSET interval(c,d) <=>
                drop b < drop a \/
                drop c < drop a /\ drop a <= drop b /\ drop b < drop d) /\
        (interval(a,b) SUBSET interval[c,d] <=>
                drop b <= drop a \/
                drop c <= drop a /\ drop a < drop b /\ drop b <= drop d) /\
        (interval(a,b) SUBSET interval(c,d) <=>
                drop b <= drop a \/
                drop c <= drop a /\ drop a < drop b /\ drop b <= drop d)"
   (REWRITE_TAC [SUBSET_INTERVAL, FORALL_1, DIMINDEX_1, drop] THEN
    REAL_ARITH_TAC)

  let EQ_INTERVAL_1 ← prove
   r"!a b c d:real^1.
       (interval[a,b] = interval[c,d] <=>
          drop b < drop a /\ drop d < drop c \/
          drop a = drop c /\ drop b = drop d)"
   (REWRITE_TAC [← SET_RULE (← q r"s = t <=> s SUBSET t /\ t SUBSET s")] THEN
    REWRITE_TAC [SUBSET_INTERVAL_1] THEN REAL_ARITH_TAC)

  let DISJOINT_INTERVAL_1 ← prove
   r"!a b c d:real^1.
        (interval[a,b] INTER interval[c,d] = {} <=>
          drop b < drop a \/ drop d < drop c \/
          drop b < drop c \/ drop d < drop a) /\
        (interval[a,b] INTER interval(c,d) = {} <=>
          drop b < drop a \/ drop d <= drop c \/
          drop b <= drop c \/ drop d <= drop a) /\
        (interval(a,b) INTER interval[c,d] = {} <=>
          drop b <= drop a \/ drop d < drop c \/
          drop b <= drop c \/ drop d <= drop a) /\
        (interval(a,b) INTER interval(c,d) = {} <=>
          drop b <= drop a \/ drop d <= drop c \/
          drop b <= drop c \/ drop d <= drop a)"
   (REWRITE_TAC [DISJOINT_INTERVAL, CONJ_ASSOC, DIMINDEX_1, LE_ANTISYM,
                 UNWIND_THM1, drop])

  let OPEN_CLOSED_INTERVAL_1 ← prove
   r"!a b:real^1. interval(a,b) = interval[a,b] DIFF {a,b}"
   (REWRITE_TAC [EXTENSION, IN_INTERVAL_1, IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
    REWRITE_TAC [← GSYM DROP_EQ] THEN REAL_ARITH_TAC)

  let CLOSED_OPEN_INTERVAL_1 ← prove
   r"!a b:real^1. drop a <= drop b ==> interval[a,b] = interval(a,b) UNION {a,b}"
   (REWRITE_TAC [EXTENSION, IN_INTERVAL_1, IN_UNION, IN_INSERT, NOT_IN_EMPTY] THEN
    REWRITE_TAC [← GSYM DROP_EQ] THEN REAL_ARITH_TAC)

  let BALL_1 ← prove
   r"!x:real^1 r. cball(x,r) = interval[x - lift r,x + lift r] /\
                ball(x,r) = interval(x - lift r,x + lift r)"
   (REWRITE_TAC [EXTENSION, IN_BALL, IN_CBALL, IN_INTERVAL_1] THEN
    REWRITE_TAC [dist, NORM_REAL, ← GSYM drop, DROP_SUB, LIFT_DROP, DROP_ADD] THEN
    REAL_ARITH_TAC)

  let SPHERE_1 ← prove
   r"!a:real^1 r. sphere(a,r) = if r < &0 then {} else {a - lift r,a + lift r}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [sphere] THEN COND_CASES_TAC THEN
    REWRITE_TAC [DIST_REAL, ← GSYM drop, FORALL_DROP] THEN
    REWRITE_TAC [EXTENSION, IN_INSERT, NOT_IN_EMPTY, IN_ELIM_THM] THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_ADD, DROP_SUB, LIFT_DROP] THEN
    ASM_REAL_ARITH_TAC)

  let FINITE_SPHERE_1 ← prove
   r"!a:real^1 r. FINITE(sphere(a,r))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SPHERE_1] THEN
    MESON_TAC [FINITE_INSERT, FINITE_EMPTY])

  let FINITE_INTERVAL_1 ← prove
   r"(!a b. FINITE(interval[a,b]) <=> drop b <= drop a) /\
   (!a b. FINITE(interval(a,b)) <=> drop b <= drop a)"
   (REWRITE_TAC [OPEN_CLOSED_INTERVAL_1] THEN
    REWRITE_TAC [← SET_RULE (← q r"s DIFF {a,b} = s DELETE a DELETE b")] THEN
    REWRITE_TAC [FINITE_DELETE] THEN REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"interval[a,b] = IMAGE lift {x | drop a <= x /\ x <= drop b}")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      CONJ_TAC THENL [MESON_TAC [LIFT_DROP], ALL_TAC] THEN
      REWRITE_TAC [IN_INTERVAL_1, IN_ELIM_THM, LIFT_DROP],
      SIMP_TAC [FINITE_IMAGE_INJ_EQ, LIFT_EQ, FINITE_REAL_INTERVAL]])

  let BALL_INTERVAL ← prove
   r"!x:real^1 e. ball(x,e) = interval(x - lift e,x + lift e)"
   (REWRITE_TAC [EXTENSION, IN_BALL, IN_INTERVAL_1, DIST_REAL] THEN
    REWRITE_TAC [← GSYM drop, DROP_SUB, DROP_ADD, LIFT_DROP] THEN REAL_ARITH_TAC)

  let CBALL_INTERVAL ← prove
   r"!x:real^1 e. cball(x,e) = interval[x - lift e,x + lift e]"
   (REWRITE_TAC [EXTENSION, IN_CBALL, IN_INTERVAL_1, DIST_REAL] THEN
    REWRITE_TAC [← GSYM drop, DROP_SUB, DROP_ADD, LIFT_DROP] THEN REAL_ARITH_TAC)

  let BALL_INTERVAL_0 ← prove
   r"!e. ball(vec 0:real^1,e) = interval(--lift e,lift e)"
   (GEN_TAC THEN REWRITE_TAC [BALL_INTERVAL] THEN AP_TERM_TAC THEN
    BINOP_TAC THEN VECTOR_ARITH_TAC)

  let CBALL_INTERVAL_0 ← prove
   r"!e. cball(vec 0:real^1,e) = interval[--lift e,lift e]"
   (GEN_TAC THEN REWRITE_TAC [CBALL_INTERVAL] THEN AP_TERM_TAC THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN BINOP_TAC THEN VECTOR_ARITH_TAC)

  let INTER_INTERVAL_1 ← prove
   r"!a b c d:real^1.
        interval[a,b] INTER interval[c,d] =
        interval[lift(max (drop a) (drop c)),lift(min (drop b) (drop d))]"
   (REWRITE_TAC [EXTENSION, IN_INTER, IN_INTERVAL_1, real_max, real_min] THEN
    REPEAT GEN_TAC THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [LIFT_DROP]) THEN
    ASM_REAL_ARITH_TAC)

  let CLOSED_DIFF_OPEN_INTERVAL_1 ← prove
   r"!a b:real^1.
        interval[a,b] DIFF interval(a,b) =
        if interval[a,b] = {} then {} else {a,b}"
   (REWRITE_TAC [EXTENSION, IN_DIFF, INTERVAL_EQ_EMPTY_1, IN_INTERVAL_1] THEN
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, IN_INSERT, NOT_IN_EMPTY] THEN
    REWRITE_TAC [← GSYM DROP_EQ] THEN ASM_REAL_ARITH_TAC)

  return { IN_INTERVAL_1, REAL_INTERVAL_INTERVAL, INTERVAL_REAL_INTERVAL, DROP_IN_REAL_INTERVAL,
           LIFT_IN_INTERVAL, IMAGE_LIFT_REAL_INTERVAL, IMAGE_DROP_INTERVAL, INTERVAL_CASES_1,
           INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, UNION_INTERVAL_1, SUBSET_INTERVAL_1,
           EQ_INTERVAL_1, DISJOINT_INTERVAL_1, OPEN_CLOSED_INTERVAL_1, CLOSED_OPEN_INTERVAL_1,
           BALL_1, SPHERE_1, FINITE_SPHERE_1, FINITE_INTERVAL_1, BALL_INTERVAL, CBALL_INTERVAL,
           BALL_INTERVAL_0, CBALL_INTERVAL_0, INTER_INTERVAL_1, CLOSED_DIFF_OPEN_INTERVAL_1 }

/- ------------------------------------------------------------------------- -/
/- Special cases for intervals in R^1, continued.  (topology.ml 14393-14568) -/
/- ------------------------------------------------------------------------- -/

structure R1B where
  INTERVAL_1 : thm
  SEGMENT_1 : thm
  OPEN_SEGMENT_1 : thm
  INTERVAL_SUBSET_SEGMENT_1 : thm
  SEGMENT_SCALAR_MULTIPLE : thm
  FINITE_INTER_COLLINEAR_OPEN_SEGMENTS : thm
  BOUNDED_SEPARATION_1D : thm
  deriving Inhabited

@[nospecialize]
def setupR1B [HolBase] (D : TopologyDeps) (BSEG : SEG) (BCON : CON) (BBND2 : BND2) (BHSP : HSP)
    (BITV1 : ITV1) (BR1A : R1A) : ExceptT String IO R1B := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        VECTOR_ARITH, VECTOR_ARITH_TAC, GEOM_BASIS_MULTIPLE_TAC, GEOM_NORMALIZE_TAC,
        GEOM_ORIGIN_TAC, .. } := D
  let { ARITH, CART_EQ, CONJ_ASSOC, CONS_11, CONTRAPOS_THM, DE_MORGAN_THM, DIFF_EMPTY,
        DIMINDEX_1, DIMINDEX_GE_1, EXTENSION, FINITE_EMPTY, FINITE_IMAGE_INJ_EQ, .. } := D.core1
  let { FINITE_REAL_INTERVAL, FORALL_IN_INSERT, IMAGE_EQ_EMPTY, IMAGE_ID, IMAGE_o, INSERT_AC,
        INTER_EMPTY, IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IN_EMPTY, PAIR_EQ, .. } := D.core3
  let { REAL_LT_IMP_LE, .. } := D.core4
  let { REAL_MUL_RID, REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LE, SIMPLE_IMAGE_GEN, SUBSET,
        SUBSET_REFL, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, o_DEF, real_abs, real_gt, .. } := D.core6
  let { REAL_LT_BETWEEN, .. } := D.misc
  let { BASIS_COMPONENT, BASIS_NONZERO, BETWEEN_IMP_COLLINEAR, COLLINEAR_4_3,
        COLLINEAR_LEMMA_ALT, COLLINEAR_SUBSET, COLLINEAR_TRIPLES, DIST_REAL, DROP_CMUL, DROP_EQ,
        FORALL_1, FORALL_LIFT, .. } := D.vec1
  let { IN_INTERVAL, LIFT_CMUL, LIFT_DROP, LIFT_SUB, .. } := D.vec2
  let { NORM_BASIS, NORM_MUL, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_LID, VECTOR_MUL_RCANCEL, VECTOR_SUB_COMPONENT, VECTOR_SUB_EQ,
        VECTOR_SUB_RZERO, between, drop, midpoint, .. } := D.vec4
  let { BETWEEN_IN_SEGMENT, SEGMENT_REFL, open_segment, segment, .. } := BSEG
  let { CONNECTED_UNIV, connected, .. } := BCON
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := BBND2
  let { OPEN_HALFSPACE_COMPONENT_GT, OPEN_HALFSPACE_COMPONENT_LT, .. } := BHSP
  let { OPEN_INTERVAL, .. } := BITV1
  let { BALL_1, INTERVAL_EQ_EMPTY_1, IN_INTERVAL_1, .. } := BR1A
  -- @@SCOPE END

  let INTERVAL_1 ← prove
   r"(!a b:real^1. interval[a,b] =
                 if drop a <= drop b then cball(midpoint(a,b),dist(a,b) / &2)
                 else {}) /\
   (!a b:real^1. interval(a,b) =
                 if drop a < drop b then ball(midpoint(a,b),dist(a,b) / &2)
                 else {})"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LE, REAL_NOT_LT]) THEN
    ASM_REWRITE_TAC [INTERVAL_EQ_EMPTY_1] THEN
    REWRITE_TAC [BALL_1, DIST_REAL] THEN
    ASM_SIMP_TAC [← GSYM drop, REAL_SUB_LE, REAL_LT_IMP_LE,
                  ← REAL_ARITH (← q r"a <= b ==> abs(a - b) = b - a")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x / &2 = inv(&2) * x"), LIFT_CMUL] THEN
    REWRITE_TAC [LIFT_SUB, LIFT_DROP, midpoint] THEN
    AP_TERM_TAC THEN REWRITE_TAC [PAIR_EQ, CONS_11] THEN VECTOR_ARITH_TAC)

  let SEGMENT_1 ← prove
   r"(!a b. segment[a,b] =
          if drop a <= drop b then interval[a,b] else interval[b,a]) /\
   (!a b. segment(a,b) =
          if drop a <= drop b then interval(a,b) else interval(b,a))"
   (CONJ_TAC THEN REPEAT GEN_TAC THEN REWRITE_TAC [open_segment] THEN
    COND_CASES_TAC THEN
    REWRITE_TAC [IN_DIFF, IN_INSERT, NOT_IN_EMPTY,
                 EXTENSION, ← GSYM BETWEEN_IN_SEGMENT, between, IN_INTERVAL_1] THEN
    REWRITE_TAC [← GSYM DROP_EQ, DIST_REAL, ← GSYM drop] THEN ASM_REAL_ARITH_TAC)

  let OPEN_SEGMENT_1 ← prove
   r"!a b:real^1. open(segment(a,b))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SEGMENT_1] THEN
    COND_CASES_TAC THEN REWRITE_TAC [OPEN_INTERVAL])

  let INTERVAL_SUBSET_SEGMENT_1 ← prove
   r"(!a b:real^1. interval[a,b] SUBSET segment[a,b]) /\
   (!a b:real^1. interval(a,b) SUBSET segment(a,b))"
   (REWRITE_TAC [SEGMENT_1] THEN REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s = {} ==> s SUBSET t")) THEN
    REWRITE_TAC [INTERVAL_EQ_EMPTY_1] THEN ASM_REAL_ARITH_TAC)

  let SEGMENT_SCALAR_MULTIPLE ← prove
   r"(!a b v. segment[a % v,b % v] =
            {x % v:real^N | a <= x /\ x <= b \/ b <= x /\ x <= a}) /\
   (!a b v. ~(v = vec 0)
            ==> segment(a % v,b % v) =
                {x % v:real^N | a < x /\ x < b \/ b < x /\ x < a})"
   (MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN
    REPEAT STRIP_TAC THENL
     [REPEAT GEN_TAC THEN
      MP_TAC (← SPECL [← q r"a % basis 1:real^1", ← q r"b % basis 1:real^1"]
       (← CONJUNCT1 SEGMENT_1)) THEN
      REWRITE_TAC [segment, VECTOR_MUL_ASSOC, ← GSYM VECTOR_ADD_RDISTRIB] THEN
      REWRITE_TAC [← SET_RULE
        (← q r"{f x % b | p x} = IMAGE (\a. a % b) {f x | p x}")] THEN
      DISCH_TAC THEN AP_TERM_TAC THEN
      FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"IMAGE drop")) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, DROP_CMUL] THEN
      SIMP_TAC [drop, BASIS_COMPONENT, DIMINDEX_GE_1, LE_REFL] THEN
      REWRITE_TAC [REAL_MUL_RID, IMAGE_ID] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      CONJ_TAC THENL [MESON_TAC [LIFT_DROP], ALL_TAC] THEN
      REWRITE_TAC [FORALL_LIFT, LIFT_DROP] THEN GEN_TAC THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP] THEN
      SIMP_TAC [drop, VECTOR_MUL_COMPONENT, BASIS_COMPONENT, DIMINDEX_GE_1,
                LE_REFL, IN_ELIM_THM] THEN ASM_REAL_ARITH_TAC,
      ASM_REWRITE_TAC [open_segment] THEN
      ASM_SIMP_TAC [VECTOR_MUL_RCANCEL, ← SET_RULE
       (← q r"(!x y. x % v = y % v <=> x = y)
        ==> {x % v | P x} DIFF {a % v,b % v} =
            {x % v | P x /\ ~(x = a) /\ ~(x = b)}")] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN REAL_ARITH_TAC])

  let FINITE_INTER_COLLINEAR_OPEN_SEGMENTS ← prove
   r"!a b c d:real^N.
        collinear{a,b,c}
        ==> (FINITE(segment(a,b) INTER segment(c,d)) <=>
             segment(a,b) INTER segment(c,d) = {})"
   (REPEAT GEN_TAC THEN ABBREV_TAC (← q r"m:real^N = b - a") THEN POP_ASSUM MP_TAC THEN
    GEOM_NORMALIZE_TAC (← q r"m:real^N") THEN
    SIMP_TAC [VECTOR_SUB_EQ, SEGMENT_REFL, INTER_EMPTY, FINITE_EMPTY] THEN
    X_GEN_TAC (← q r"m:real^N") THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
    DISCH_THEN (SUBST_ALL_TAC o SYM) THEN POP_ASSUM MP_TAC THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    GEOM_BASIS_MULTIPLE_TAC 1 (← q r"b:real^N") THEN
    X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    SIMP_TAC [VECTOR_SUB_RZERO, NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
    ASM_REWRITE_TAC [real_abs, REAL_MUL_RID] THEN DISCH_THEN SUBST_ALL_TAC THEN
    POP_ASSUM (K ALL_TAC : thm → tactic) THEN
    ASM_CASES_TAC (← q r"collinear{vec 0:real^N,&1 % basis 1,y}") THENL
     [POP_ASSUM MP_TAC THEN
      SIMP_TAC [COLLINEAR_LEMMA_ALT, BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
      MATCH_MP_TAC (← TAUT
       (← q r"~a /\ (b ==> c ==> d) ==> a \/ b ==> a \/ c ==> d")) THEN
      CONJ_TAC THENL
       [SIMP_TAC [VECTOR_MUL_LID, BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"b:real") THEN DISCH_THEN SUBST_ALL_TAC THEN
      X_GEN_TAC (← q r"a:real") THEN DISCH_THEN SUBST_ALL_TAC THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RID] THEN
      SUBST1_TAC (← VECTOR_ARITH (← q r"vec 0:real^N = &0 % basis 1")) THEN
      SIMP_TAC [SEGMENT_SCALAR_MULTIPLE, BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL,
       VECTOR_MUL_RCANCEL, IMAGE_EQ_EMPTY, FINITE_IMAGE_INJ_EQ, ← SET_RULE
       (← q r"(!x y. x % v = y % v <=> x = y)
        ==> {x % v | P x} INTER {x % v | Q x} =
            IMAGE (\x. x % v) {x | P x /\ Q x}")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"(&0 < x /\ x < &1 \/ &1 < x /\ x < &0) /\
                              (b < x /\ x < a \/ a < x /\ x < b) <=>
                         max (&0) (min a b) < x /\ x < min (&1) (max a b)")] THEN
      SIMP_TAC [FINITE_REAL_INTERVAL, EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM] THEN
      SIMP_TAC [← GSYM REAL_LT_BETWEEN, ← GSYM NOT_EXISTS_THM] THEN REAL_ARITH_TAC,
      DISCH_TAC THEN ASM_CASES_TAC
       (← q r"segment(vec 0:real^N,&1 % basis 1) INTER segment (x,y) = {}") THEN
      ASM_REWRITE_TAC [FINITE_EMPTY] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [open_segment, IN_DIFF, NOT_IN_EMPTY,
                   DE_MORGAN_THM, IN_INTER, IN_INSERT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^N") STRIP_ASSUME_TAC) THEN
      UNDISCH_TAC (← q r"~collinear{vec 0:real^N,&1 % basis 1, y}") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [VECTOR_MUL_LID]) THEN
      REWRITE_TAC [VECTOR_MUL_LID] THEN
      MATCH_MP_TAC COLLINEAR_SUBSET THEN
      EXISTS_TAC (← q r"{p,x:real^N, y, vec 0, basis 1}") THEN
      CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      MP_TAC (← ISPECL [← q r"{y:real^N,vec 0,basis 1}", ← q r"p:real^N", ← q r"x:real^N"]
          COLLINEAR_TRIPLES) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY] THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [← SET_RULE (← q r"{p,x,y} = {x,p,y}")] THEN
        MATCH_MP_TAC BETWEEN_IMP_COLLINEAR THEN
        ASM_REWRITE_TAC [BETWEEN_IN_SEGMENT],
        ALL_TAC] THEN
      ASM_SIMP_TAC [← GSYM COLLINEAR_4_3] THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"{p,x,z,w} = {w,z,p,x}")] THEN
      SIMP_TAC [COLLINEAR_4_3, BASIS_NONZERO, DIMINDEX_GE_1, ARITH] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP BETWEEN_IMP_COLLINEAR o
          GEN_REWRITE_RULE id [← GSYM BETWEEN_IN_SEGMENT])) THEN
      REPEAT (POP_ASSUM MP_TAC) THEN SIMP_TAC [INSERT_AC]])

  let BOUNDED_SEPARATION_1D ← prove
   r"!s:real^N->bool.
        dimindex(:N) = 1 /\ bounded s
        ==> (connected((:real^N) DIFF s) <=> s = {})"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [DIFF_EMPTY, CONNECTED_UNIV] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN REWRITE_TAC [connected] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{x:real^N | x$1 < (a:real^N)$1}",
      ← q r"{x:real^N | x$1 > (a:real^N)$1}"] THEN
    REWRITE_TAC [OPEN_HALFSPACE_COMPONENT_GT, OPEN_HALFSPACE_COMPONENT_LT] THEN
    REWRITE_TAC [SUBSET, EXTENSION, IN_INTER, IN_ELIM_THM, NOT_IN_EMPTY,
                 IN_UNION, IN_DIFF, IN_UNIV] THEN
    REWRITE_TAC [CONJ_ASSOC, ← REAL_ARITH (← q r"x < a /\ x > a <=> F")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x < a \/ x > a <=> ~(x = a)"), real_gt] THEN
    REWRITE_TAC [CONTRAPOS_THM, NOT_FORALL_THM] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"b:real^N = a") (fun th => ASM_REWRITE_TAC [th]) THEN
      ASM_REWRITE_TAC [CART_EQ, DIMINDEX_1, FORALL_1],
      FIRST_X_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN
      ASM_REWRITE_TAC [SUBSET, IN_INTERVAL, DIMINDEX_1, FORALL_1] THEN
      DISCH_TAC THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"u - basis 1:real^N"), EXISTS_TAC (← q r"v + basis 1:real^N")] THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"a:real^N")) THEN
      (ANTS_TAC THENL [ASM_REWRITE_TAC [], STRIP_TAC]) THEN
      (CONJ_TAC THENL
        [ALL_TAC,
         FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE BINDER_CONV
          [← GSYM CONTRAPOS_THM])] THEN
        REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT] THEN
        SIMP_TAC [BASIS_COMPONENT, DIMINDEX_GE_1, LE_REFL] THEN
        ASM_REAL_ARITH_TAC)])

  return { INTERVAL_1, SEGMENT_1, OPEN_SEGMENT_1, INTERVAL_SUBSET_SEGMENT_1,
           SEGMENT_SCALAR_MULTIPLE, FINITE_INTER_COLLINEAR_OPEN_SEGMENTS, BOUNDED_SEPARATION_1D }

/- ------------------------------------------------------------------------- -/
/- Intervals in general, including infinite and mixtures of open and closed. -/
/- (topology.ml 14569-14767)                                                 -/
/- ------------------------------------------------------------------------- -/

structure IVG1 where
  is_interval : thm
  IS_INTERVAL_INTERVAL : thm
  IS_INTERVAL_EMPTY : thm
  IS_INTERVAL_UNIV : thm
  IS_INTERVAL_TRANSLATION_EQ : thm
  IS_INTERVAL_TRANSLATION : thm
  IS_INTERVAL_POINTWISE : thm
  IS_INTERVAL_COMPACT : thm
  IS_INTERVAL_1 : thm
  IS_INTERVAL_1_CASES : thm
  IS_INTERVAL_1_CLAUSES : thm
  IS_REALINTERVAL_IS_INTERVAL : thm
  deriving Inhabited

@[nospecialize]
def setupIVG1 [HolBase] (D : TopologyDeps) (BBND1 : BND1) (BCPT : CPT) (BLFR : LFR) (BDST : DST)
    (BITV2 : ITV2) : ExceptT String IO IVG1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC,
        INDUCT_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC, add_translation_invariants,
        GEOM_TRANSLATE_TAC, .. } := D
  let { CART_EQ, DIMINDEX_1, DIMINDEX_GE_1, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ, INF, IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { IN_UNIV, LAMBDA_BETA, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, .. } :=
    D.core3
  let { REAL_LET_TRANS, REAL_LE_ANTISYM, REAL_LE_INF, REAL_LE_LADD, REAL_LE_TOTAL,
        REAL_LE_TRANS, REAL_LTE_TRANS, REAL_LT_LADD, .. } := D.core4
  let { REAL_LT_TRANS, REAL_NOT_LE, REAL_SUP_LE, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, .. } :=
    D.core5
  let { SUP, UNWIND_THM1, o_DEF, .. } := D.core6
  let { is_realinterval, .. } := D.misc
  let { COMPONENT_LE_NORM, EXISTS_DROP, FORALL_1, FORALL_DROP, FORALL_LIFT, .. } := D.vec1
  let { IN_INTERVAL, LIFT_DROP, .. } := D.vec2
  let { VECTOR_ADD_COMPONENT, drop, .. } := D.vec4
  let { bounded, .. } := BBND1
  let { COMPACT_IMP_BOUNDED, COMPACT_INTERVAL, .. } := BCPT
  let { CONTINUOUS_ON_LIFT_COMPONENT, .. } := BLFR
  let { CONTINUOUS_ATTAINS_INF, CONTINUOUS_ATTAINS_SUP, .. } := BDST
  let { EMPTY_AS_INTERVAL, .. } := BITV2
  -- @@SCOPE END

  let is_interval ← new_definition
   r"is_interval(s:real^N->bool) <=>
        !a b x. a IN s /\ b IN s /\
                (!i. 1 <= i /\ i <= dimindex(:N)
                     ==> (a$i <= x$i /\ x$i <= b$i) \/
                         (b$i <= x$i /\ x$i <= a$i))
                ==> x IN s"

  let IS_INTERVAL_INTERVAL ← prove
   r"!a:real^N b. is_interval(interval (a,b)) /\ is_interval(interval [a,b])"
   (REWRITE_TAC [is_interval, IN_INTERVAL] THEN
    MESON_TAC [REAL_LT_TRANS, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LTE_TRANS])

  let IS_INTERVAL_EMPTY ← prove
   r"is_interval {}"
   (REWRITE_TAC [is_interval, NOT_IN_EMPTY])

  let IS_INTERVAL_UNIV ← prove
   r"is_interval(UNIV:real^N->bool)"
   (REWRITE_TAC [is_interval, IN_UNIV])

  let IS_INTERVAL_TRANSLATION_EQ ← prove
   r"!a:real^N s. is_interval(IMAGE (\x. a + x) s) <=> is_interval s"
   (REWRITE_TAC [is_interval] THEN GEOM_TRANSLATE_TAC [] THEN
    REWRITE_TAC [VECTOR_ADD_COMPONENT, REAL_LT_LADD, REAL_LE_LADD])

  add_translation_invariants [IS_INTERVAL_TRANSLATION_EQ]

  let IS_INTERVAL_TRANSLATION ← prove
   r"!s a:real^N. is_interval s ==> is_interval(IMAGE (\x. a + x) s)"
   (REWRITE_TAC [IS_INTERVAL_TRANSLATION_EQ])

  let IS_INTERVAL_POINTWISE ← prove
   r"!s:real^N->bool x.
        is_interval s /\
        (!i. 1 <= i /\ i <= dimindex(:N) ==> ?a. a IN s /\ a$i = x$i)
        ==> x IN s"
   (REWRITE_TAC [is_interval] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"!n. ?y:real^N. (!i. 1 <= i /\ i <= n ==> y$i = (x:real^N)$i) /\ y IN s")
    MP_TAC THENL
     [INDUCT_TAC THEN REWRITE_TAC [← ARITH_RULE (← q r"~(1 <= i /\ i <= 0)")] THENL
       [ASM_MESON_TAC [DIMINDEX_GE_1, LE_REFL], ALL_TAC] THEN
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"y:real^N")) THEN
      ASM_CASES_TAC (← q r"SUC n <= dimindex(:N)") THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"SUC n")) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC
         (← q r"(lambda i. if i <= n then (y:real^N)$i else (z:real^N)$i):real^N") THEN
        CONJ_TAC THENL
         [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
          SUBGOAL_THEN (← q r"i <= dimindex(:N)") ASSUME_TAC THENL
           [ASM_ARITH_TAC, ASM_SIMP_TAC [LAMBDA_BETA]] THEN
          COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
          SUBGOAL_THEN (← q r"i = SUC n") (fun th => ASM_REWRITE_TAC [th]) THEN
          ASM_ARITH_TAC,
          FIRST_X_ASSUM (ASSUME_TAC o CONJUNCT2) THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          MAP_EVERY EXISTS_TAC [← q r"y:real^N", ← q r"z:real^N"] THEN
          ASM_SIMP_TAC [LAMBDA_BETA] THEN REAL_ARITH_TAC],
        EXISTS_TAC (← q r"y:real^N") THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"y:real^N = x") (fun th => REWRITE_TAC [th]) THEN
        REWRITE_TAC [CART_EQ] THEN
        ASM_MESON_TAC [← ARITH_RULE (← q r"i <= N /\ ~(SUC n <= N) ==> i <= n")]],
      DISCH_THEN (MP_TAC o SPEC (← q r"dimindex(:N)")) THEN
      REWRITE_TAC [← GSYM CART_EQ] THEN MESON_TAC []])

  let IS_INTERVAL_COMPACT ← prove
   r"!s:real^N->bool. is_interval s /\ compact s <=> ?a b. s = interval[a,b]"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [IS_INTERVAL_INTERVAL, COMPACT_INTERVAL] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_MESON_TAC [EMPTY_AS_INTERVAL], ALL_TAC] THEN
    EXISTS_TAC (← q r"(lambda i. inf { (x:real^N)$i | x IN s}):real^N") THEN
    EXISTS_TAC (← q r"(lambda i. sup { (x:real^N)$i | x IN s}):real^N") THEN
    SIMP_TAC [EXTENSION, IN_INTERVAL, LAMBDA_BETA] THEN X_GEN_TAC (← q r"x:real^N") THEN
    EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"{ (x:real^N)$i | x IN s}") INF) THEN
      MP_TAC (← ISPEC (← q r"{ (x:real^N)$i | x IN s}") SUP) THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
      REWRITE_TAC [bounded] THEN
      ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS, MEMBER_NOT_EMPTY,
                     ← REAL_ARITH (← q r"abs(x) <= B ==> --B <= x /\ x <= B")],
      DISCH_TAC THEN MATCH_MP_TAC IS_INTERVAL_POINTWISE THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?a b:real^N. a IN s /\ b IN s /\ a$i <= (x:real^N)$i /\ x$i <= b$i")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPECL [← q r"\x:real^N. x$i", ← q r"s:real^N->bool"]
          CONTINUOUS_ATTAINS_INF) THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_COMPONENT, o_DEF] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"\x:real^N. x$i", ← q r"s:real^N->bool"]
          CONTINUOUS_ATTAINS_SUP) THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_COMPONENT, o_DEF] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:real^N") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THENL
         [EXISTS_TAC (← q r"inf {(x:real^N)$i | x IN s}") THEN ASM_SIMP_TAC [] THEN
          MATCH_MP_TAC REAL_LE_INF THEN ASM SET_TAC [],
          EXISTS_TAC (← q r"sup {(x:real^N)$i | x IN s}") THEN ASM_SIMP_TAC [] THEN
          MATCH_MP_TAC REAL_SUP_LE THEN ASM SET_TAC []],
        EXISTS_TAC
         (← q r"(lambda j. if j = i then (x:real^N)$i else (a:real^N)$j):real^N") THEN
        ASM_SIMP_TAC [LAMBDA_BETA] THEN
        FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [is_interval]) THEN
        MAP_EVERY EXISTS_TAC
         [← q r"a:real^N",
          ← q r"(lambda j. if j = i then (b:real^N)$i else (a:real^N)$j):real^N"] THEN
        ASM_SIMP_TAC [LAMBDA_BETA] THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [is_interval]) THEN
          MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
          ASM_SIMP_TAC [LAMBDA_BETA],
          ALL_TAC] THEN
        GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_REAL_ARITH_TAC]])

  let IS_INTERVAL_1 ← prove
   r"!s:real^1->bool.
        is_interval s <=>
          !a b x. a IN s /\ b IN s /\ drop a <= drop x /\ drop x <= drop b
                  ==> x IN s"
   (REWRITE_TAC [is_interval, DIMINDEX_1, FORALL_1, ← GSYM drop] THEN
    REWRITE_TAC [FORALL_LIFT, LIFT_DROP] THEN MESON_TAC [])

  let IS_INTERVAL_1_CASES ← prove
   r"!s:real^1->bool.
        is_interval s <=>
        s = {} \/
        s = (:real^1) \/
        (?a. s = {x | a < drop x}) \/
        (?a. s = {x | a <= drop x}) \/
        (?b. s = {x | drop x <= b}) \/
        (?b. s = {x | drop x < b}) \/
        (?a b. s = {x | a < drop x /\ drop x < b}) \/
        (?a b. s = {x | a < drop x /\ drop x <= b}) \/
        (?a b. s = {x | a <= drop x /\ drop x < b}) \/
        (?a b. s = {x | a <= drop x /\ drop x <= b})"
   (GEN_TAC THEN REWRITE_TAC [IS_INTERVAL_1] THEN EQ_TAC THENL
     [DISCH_TAC,
      STRIP_TAC THEN ASM_REWRITE_TAC [IN_ELIM_THM, IN_UNIV, NOT_IN_EMPTY] THEN
      REAL_ARITH_TAC] THEN
    ASM_CASES_TAC (← q r"s:real^1->bool = {}") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPEC (← q r"IMAGE drop s") SUP) THEN
    MP_TAC (← ISPEC (← q r"IMAGE drop s") INF) THEN
    ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN
    ASM_CASES_TAC (← q r"?a. !x. x IN s ==> a <= drop x") THEN
    ASM_CASES_TAC (← q r"?b. !x. x IN s ==> drop x <= b") THEN
    ASM_REWRITE_TAC [] THENL
     [STRIP_TAC THEN STRIP_TAC THEN
      MAP_EVERY ASM_CASES_TAC
       [← q r"inf(IMAGE drop s) IN IMAGE drop s", ← q r"sup(IMAGE drop s) IN IMAGE drop s"]
      THENL
       [REPLICATE_TAC 8 DISJ2_TAC,
        REPLICATE_TAC 7 DISJ2_TAC THEN DISJ1_TAC,
        REPLICATE_TAC 6 DISJ2_TAC THEN DISJ1_TAC,
        REPLICATE_TAC 5 DISJ2_TAC THEN DISJ1_TAC] THEN
      MAP_EVERY EXISTS_TAC [← q r"inf(IMAGE drop s)", ← q r"sup(IMAGE drop s)"],
      STRIP_TAC THEN ASM_CASES_TAC (← q r"inf(IMAGE drop s) IN IMAGE drop s") THENL
       [REPLICATE_TAC 2 DISJ2_TAC THEN DISJ1_TAC,
        DISJ2_TAC THEN DISJ1_TAC] THEN
      EXISTS_TAC (← q r"inf(IMAGE drop s)"),
      STRIP_TAC THEN ASM_CASES_TAC (← q r"sup(IMAGE drop s) IN IMAGE drop s") THENL
       [REPLICATE_TAC 3 DISJ2_TAC THEN DISJ1_TAC,
        REPLICATE_TAC 4 DISJ2_TAC THEN DISJ1_TAC] THEN
      EXISTS_TAC (← q r"sup(IMAGE drop s)"),
      DISJ1_TAC] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_UNIV] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_IMAGE]) THEN
    REWRITE_TAC [← GSYM REAL_NOT_LE] THEN
    ASM_MESON_TAC [REAL_LE_TRANS, REAL_LE_TOTAL, REAL_LE_ANTISYM])

  let IS_INTERVAL_1_CLAUSES ← prove
   r"is_interval({}:real^1->bool) /\
   is_interval (:real^1) /\
   (!a. is_interval {x | a < drop x}) /\
   (!a. is_interval {x | a <= drop x}) /\
   (!b. is_interval {x | drop x < b}) /\
   (!b. is_interval {x | drop x <= b}) /\
   (!a b. is_interval {x | a < drop x /\ drop x < b}) /\
   (!a b. is_interval {x | a < drop x /\ drop x <= b}) /\
   (!a b. is_interval {x | a <= drop x /\ drop x < b}) /\
   (!a b. is_interval {x | a <= drop x /\ drop x <= b})"
   (REWRITE_TAC [IS_INTERVAL_1, IN_ELIM_THM, IN_UNIV, NOT_IN_EMPTY] THEN
    REAL_ARITH_TAC)

  let IS_REALINTERVAL_IS_INTERVAL ← prove
   r"!s. is_realinterval s <=> is_interval(IMAGE lift s)"
   (REWRITE_TAC [IS_INTERVAL_1, is_realinterval] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [LIFT_DROP, IN_IMAGE, EXISTS_DROP, UNWIND_THM1] THEN
    REWRITE_TAC [← GSYM FORALL_DROP])

  return { is_interval, IS_INTERVAL_INTERVAL, IS_INTERVAL_EMPTY, IS_INTERVAL_UNIV,
           IS_INTERVAL_TRANSLATION_EQ, IS_INTERVAL_TRANSLATION, IS_INTERVAL_POINTWISE,
           IS_INTERVAL_COMPACT, IS_INTERVAL_1, IS_INTERVAL_1_CASES, IS_INTERVAL_1_CLAUSES,
           IS_REALINTERVAL_IS_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Intervals in general, continued.  (topology.ml 14768-14930)               -/
/- ------------------------------------------------------------------------- -/

structure IVG2 where
  IS_INTERVAL_PCROSS : thm
  IS_INTERVAL_PCROSS_EQ : thm
  IS_INTERVAL_INTER : thm
  INTERVAL_SUBSET_IS_INTERVAL : thm
  INTERVAL_CONTAINS_COMPACT_NEIGHBOURHOOD : thm
  IS_INTERVAL_SUMS : thm
  IS_INTERVAL_SING : thm
  INTERVAL_EQ_SING : thm
  deriving Inhabited

@[nospecialize]
def setupIVG2 [HolBase] (D : TopologyDeps) (BBAL : BAL) (BITV3 : ITV3) (BIVG1 : IVG1) :
    ExceptT String IO IVG2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC,
        REAL_ARITH, REAL_ARITH_TAC, VECTOR_ARITH, .. } := D
  let { ADD_SUB2, AND_FORALL_THM, CART_EQ, CONJ_ASSOC, CONJ_SYM, DIMINDEX_FINITE_SUM,
        DIMINDEX_GE_1, EMPTY_SUBSET, FINITE_IMAGE, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_PASTECART, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_IMP,
        IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_SING, .. } := D.core2
  let { LAMBDA_BETA, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, MONO_FORALL, NOT_INSERT_EMPTY,
        NOT_LE, NUMSEG_EMPTY, PASTECART_IN_PCROSS, PCROSS_EMPTY, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_LT, REAL_LE_MIN, REAL_LE_REFL, REAL_LT_01, REAL_LT_INF_FINITE,
        REAL_LT_MIN, .. } := D.core4
  let { REAL_MAX_LE, REAL_NOT_LT, REAL_SUB_LT, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SUBSET, .. } := D.core5
  let { UNWIND_THM2, pastecart, .. } := D.core6
  let { LAMBDA_SKOLEM, REAL_LE_BETWEEN, .. } := D.misc
  let { COMPONENT_LE_NORM, ENDS_IN_INTERVAL, .. } := D.vec1
  let { INTERVAL_SING, IN_INTERVAL, .. } := D.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT, dist, .. } := D.vec4
  let { IN_BALL, .. } := BBAL
  let { EQ_INTERVAL, .. } := BITV3
  let { IS_INTERVAL_EMPTY, IS_INTERVAL_POINTWISE, is_interval, .. } := BIVG1
  -- @@SCOPE END

  let IS_INTERVAL_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        is_interval s /\ is_interval t ==> is_interval(s PCROSS t)"
   (REWRITE_TAC [is_interval, DIMINDEX_FINITE_SUM] THEN
    REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
    REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!a b a' b' x x'. P a b x /\ Q a' b' x' ==> R a b x a' b' x')
      ==> (!a b x. P a b x) /\ (!a' b' x'. Q a' b' x')
          ==> (!a a' b b' x x'. R a b x a' b' x')")) THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
      ASM_SIMP_TAC [pastecart, LAMBDA_BETA, DIMINDEX_FINITE_SUM,
                    ← ARITH_RULE (← q r"x:num <= m ==> x <= m + n")],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"dimindex(:M) + i")) THEN
      ASM_SIMP_TAC [pastecart, LAMBDA_BETA, DIMINDEX_FINITE_SUM,
                    ← ARITH_RULE (← q r"x:num <= n ==> m + x <= m + n"),
                    ← ARITH_RULE (← q r"1 <= x ==> 1 <= m + x")] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [ADD_SUB2] THEN ASM_ARITH_TAC])

  let IS_INTERVAL_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        is_interval(s PCROSS t) <=>
        s = {} \/ t = {} \/ is_interval s /\ is_interval t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, IS_INTERVAL_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, IS_INTERVAL_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [IS_INTERVAL_PCROSS] THEN
    REWRITE_TAC [is_interval] THEN
    REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
    STRIP_TAC THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M", ← q r"x:real^M"] THEN
      STRIP_TAC THEN UNDISCH_TAC (← q r"~(t:real^N->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"y:real^N")) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"a:real^M", ← q r"y:real^N", ← q r"b:real^M",
        ← q r"y:real^N", ← q r"x:real^M", ← q r"y:real^N"]),
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N", ← q r"x:real^N"] THEN
      STRIP_TAC THEN UNDISCH_TAC (← q r"~(s:real^M->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"w:real^M")) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"w:real^M", ← q r"a:real^N", ← q r"w:real^M",
        ← q r"b:real^N", ← q r"w:real^M", ← q r"x:real^N"])] THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
    SIMP_TAC [pastecart, LAMBDA_BETA] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
    ASM_MESON_TAC [DIMINDEX_FINITE_SUM, ← ARITH_RULE
        (← q r"1 <= i /\ i <= m + n /\ ~(i <= m) ==> 1 <= i - m /\ i - m <= n")])

  let IS_INTERVAL_INTER ← prove
   r"!s t:real^N->bool.
        is_interval s /\ is_interval t ==> is_interval(s INTER t)"
   (REWRITE_TAC [is_interval, IN_INTER] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N", ← q r"x:real^N"] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN ASM_REWRITE_TAC [])

  let INTERVAL_SUBSET_IS_INTERVAL ← prove
   r"!s a b:real^N.
     is_interval s
     ==> (interval[a,b] SUBSET s <=> interval[a,b] = {} \/ a IN s /\ b IN s)"
   (REWRITE_TAC [is_interval] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THEN
    ASM_REWRITE_TAC [EMPTY_SUBSET] THEN
    EQ_TAC THENL [ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET], ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_INTERVAL] THEN ASM_MESON_TAC [])

  let INTERVAL_CONTAINS_COMPACT_NEIGHBOURHOOD ← prove
   r"!s x:real^N.
        is_interval s /\ x IN s
        ==> ?a b d. &0 < d /\ x IN interval[a,b] /\
                    interval[a,b] SUBSET s /\
                    ball(x,d) INTER s SUBSET interval[a,b]"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [INTERVAL_SUBSET_IS_INTERVAL] THEN
    SUBGOAL_THEN
     (← q r"!i. 1 <= i /\ i <= dimindex(:N)
          ==> ?a. (?y. y IN s /\ y$i = a) /\
                  (a < x$i \/ a = (x:real^N)$i /\
                              !y:real^N. y IN s ==> a <= y$i)")
    MP_TAC THENL [ASM_MESON_TAC [REAL_NOT_LT], REWRITE_TAC [LAMBDA_SKOLEM]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!i. 1 <= i /\ i <= dimindex(:N)
          ==> ?b. (?y. y IN s /\ y$i = b) /\
                  (x$i < b \/ b = (x:real^N)$i /\
                              !y:real^N. y IN s ==> y$i <= b)")
    MP_TAC THENL [ASM_MESON_TAC [REAL_NOT_LT], REWRITE_TAC [LAMBDA_SKOLEM]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:real^N") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"min (inf (IMAGE (\i. if a$i < x$i
                                     then (x:real^N)$i - (a:real^N)$i else &1)
                                (1..dimindex(:N))))
                    (inf (IMAGE (\i. if x$i < b$i
                                     then (b:real^N)$i - x$i else &1)
                                (1..dimindex(:N))))") THEN
    REWRITE_TAC [REAL_LT_MIN, SUBSET, IN_BALL, IN_INTER] THEN
    SIMP_TAC [REAL_LT_INF_FINITE, IMAGE_EQ_EMPTY, FINITE_IMAGE,
              FINITE_NUMSEG, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_INTERVAL] THEN REPEAT CONJ_TAC THENL
     [MESON_TAC [REAL_SUB_LT, REAL_LT_01],
      MESON_TAC [REAL_SUB_LT, REAL_LT_01],
      ASM_MESON_TAC [REAL_LE_LT],
      DISJ2_TAC THEN CONJ_TAC THEN MATCH_MP_TAC IS_INTERVAL_POINTWISE THEN
      ASM_MESON_TAC [],
      X_GEN_TAC (← q r"y:real^N") THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      REWRITE_TAC [AND_FORALL_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
      X_GEN_TAC (← q r"i:num") THEN DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [IN_NUMSEG] THEN MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
      (COND_CASES_TAC THENL [REWRITE_TAC [dist], ASM_MESON_TAC []]) THEN
      DISCH_TAC THEN MP_TAC (← ISPECL [← q r"x - y:real^N", ← q r"i:num"]
        COMPONENT_LE_NORM) THEN
      ASM_REWRITE_TAC [VECTOR_SUB_COMPONENT] THEN ASM_REAL_ARITH_TAC])

  let IS_INTERVAL_SUMS ← prove
   r"!s t:real^N->bool.
        is_interval s /\ is_interval t
        ==> is_interval {x + y | x IN s /\ y IN t}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [is_interval] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"a:real^N", ← q r"a':real^N", ← q r"b:real^N", ← q r"b':real^N",
      ← q r"y:real^N"] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o SPECL [← q r"a':real^N", ← q r"b':real^N"]) STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [IMP_IMP, IN_ELIM_THM] THEN  ONCE_REWRITE_TAC [CONJ_SYM] THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"z:real^N = x + y <=> y = z - x")] THEN
    REWRITE_TAC [UNWIND_THM2] THEN MATCH_MP_TAC (← MESON []
     (← q r"(?x. P x /\ Q(f x))
      ==> (!x. P x ==> x IN s) /\ (!x. Q x ==> x IN t)
          ==> ?x. x IN s /\ f x IN t")) THEN
    REWRITE_TAC [VECTOR_SUB_COMPONENT, AND_FORALL_THM,
                 ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    REWRITE_TAC [← GSYM LAMBDA_SKOLEM] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
    ASM_REWRITE_TAC [VECTOR_ADD_COMPONENT] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"c <= y - x /\ y - x <= d <=> y - d <= x /\ x <= y - c")] THEN
    REWRITE_TAC [← REAL_ARITH
    (← q r"a <= x /\ x <= b \/ b <= x /\ x <= a <=> min a b <= x /\ x <= max a b")] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ (r /\ s) <=> (p /\ r) /\ (q /\ s)")] THEN
    REWRITE_TAC [← GSYM REAL_LE_MIN, ← GSYM REAL_MAX_LE] THEN
    REWRITE_TAC [← GSYM REAL_LE_BETWEEN] THEN REAL_ARITH_TAC)

  let IS_INTERVAL_SING ← prove
   r"!a:real^N. is_interval {a}"
   (SIMP_TAC [is_interval, IN_SING, IMP_CONJ, CART_EQ, REAL_LE_ANTISYM])

  let INTERVAL_EQ_SING ← prove
   r"(!a b x:real^N. interval[a,b] = {x} <=> a = x /\ b = x) /\
   (!a b x:real^N. ~(interval(a,b) = {x}))"
   (REWRITE_TAC [← GSYM (← CONJUNCT1 INTERVAL_SING), EQ_INTERVAL] THEN
    REWRITE_TAC [INTERVAL_SING, NOT_INSERT_EMPTY])

  return { IS_INTERVAL_PCROSS, IS_INTERVAL_PCROSS_EQ, IS_INTERVAL_INTER,
           INTERVAL_SUBSET_IS_INTERVAL, INTERVAL_CONTAINS_COMPACT_NEIGHBOURHOOD,
           IS_INTERVAL_SUMS, IS_INTERVAL_SING, INTERVAL_EQ_SING }

/- ------------------------------------------------------------------------- -/
/- Intervals in general, continued.  (topology.ml 14931-15068)               -/
/- ------------------------------------------------------------------------- -/

structure IVG3 where
  IS_INTERVAL_SCALING : thm
  IS_INTERVAL_SCALING_EQ : thm
  IS_INTERVAL_REFLECT : thm
  CARD_FRONTIER_INTERVAL_1 : thm
  UNION_INTERVAL_SUBSET_INTERVAL : thm
  deriving Inhabited

@[nospecialize]
def setupIVG3 [HolBase] (D : TopologyDeps) (BCLS1 : CLS1) (BFRO1 : FRO1) (BIVG1 : IVG1)
    (BIVG2 : IVG2) : ExceptT String IO IVG3 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        HAS_SIZE_CONV, REAL_RAT_REDUCE_CONV, add_scaling_theorems, .. } := D
  let { CHOOSE_SUBSET_STRONG, CONJ_ASSOC, CONTRAPOS_THM, EMPTY_SUBSET, EQ_TRANS, ETA_AX, .. } :=
    D.core1
  let { FORALL_IN_IMAGE, IMAGE_ID, IMAGE_o, IMP_CONJ, IMP_IMP, INSERT_SUBSET, IN_DIFF, IN_IMAGE,
        IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_FORALL, NOT_EXISTS_THM, .. } :=
    D.core3
  let { REAL_INV_NEG, REAL_LE_LDIV_EQ, REAL_LE_NEG2, REAL_LE_RDIV_EQ, REAL_LE_TOTAL,
        REAL_LT_IMP_NZ, REAL_LT_LE, REAL_LT_MIN, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_RNEG, REAL_MUL_SYM, REAL_SUB_LT,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_REFL, .. } := D.core5
  let { UNION_EMPTY, UNION_SUBSET, o_DEF, real_div, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_REAL, DROP_EQ, ENDS_IN_INTERVAL, FORALL_DROP, FORALL_LIFT, .. } := D.vec1
  let { IN_INTERVAL, LIFT_DROP, LIFT_EQ, .. } := D.vec2
  let { SUBSET_INTERVAL, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT, VECTOR_MUL_LID, VECTOR_MUL_LNEG,
        VECTOR_MUL_LZERO, drop, .. } := D.vec4
  let { CLOSURE_APPROACHABLE, .. } := BCLS1
  let { FRONTIER_CLOSURES, .. } := BFRO1
  let { IS_INTERVAL_1, IS_INTERVAL_EMPTY, is_interval, .. } := BIVG1
  let { IS_INTERVAL_SING, .. } := BIVG2
  -- @@SCOPE END

  let IS_INTERVAL_SCALING ← prove
   r"!s:real^N->bool c. is_interval s ==> is_interval(IMAGE (\x. c % x) s)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO] THEN
      SUBGOAL_THEN (← q r"IMAGE ((\x. vec 0):real^N->real^N) s = {} \/
                    IMAGE ((\x. vec 0):real^N->real^N) s = {vec 0}")
      STRIP_ASSUME_TAC THENL
       [SET_TAC [],
        ASM_REWRITE_TAC [IS_INTERVAL_EMPTY],
        ASM_REWRITE_TAC [IS_INTERVAL_SING]],
      REWRITE_TAC [is_interval, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      GEN_REWRITE_TAC (BINOP_CONV o REDEPTH_CONV) [RIGHT_IMP_FORALL_THM] THEN
      REWRITE_TAC [IMP_IMP, VECTOR_MUL_COMPONENT] THEN
      MAP_EVERY (fun t => MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC t)
       [← q r"a:real^N", ← q r"b:real^N"] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
              MP_TAC (← SPEC (← q r"inv(c) % x:real^N") th))) THEN
      ASM_REWRITE_TAC [VECTOR_MUL_COMPONENT, IN_IMAGE] THEN ANTS_TAC THENL
       [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [← GSYM real_div] THEN
        FIRST_X_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
         (← q r"~(c = &0) ==> &0 < c \/ &0 < --c"))) THEN
        ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ] THEN
        GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM REAL_LE_NEG2] THEN
        ASM_SIMP_TAC [← GSYM REAL_MUL_RNEG, ← GSYM REAL_LE_RDIV_EQ, ← GSYM
                      REAL_LE_LDIV_EQ] THEN
        REWRITE_TAC [real_div, REAL_INV_NEG] THEN REAL_ARITH_TAC,
        DISCH_TAC THEN EXISTS_TAC (← q r"inv c % x:real^N") THEN
        ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, VECTOR_MUL_LID]]])

  let IS_INTERVAL_SCALING_EQ ← prove
   r"!s:real^N->bool c.
        is_interval(IMAGE (\x. c % x) s) <=> c = &0 \/ is_interval s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO] THEN
      SUBGOAL_THEN (← q r"IMAGE ((\x. vec 0):real^N->real^N) s = {} \/
                    IMAGE ((\x. vec 0):real^N->real^N) s = {vec 0}")
      STRIP_ASSUME_TAC THENL
       [SET_TAC [],
        ASM_REWRITE_TAC [IS_INTERVAL_EMPTY],
        ASM_REWRITE_TAC [IS_INTERVAL_SING]],
      ASM_REWRITE_TAC [] THEN EQ_TAC THEN REWRITE_TAC [IS_INTERVAL_SCALING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv c:real") o MATCH_MP IS_INTERVAL_SCALING) THEN
      ASM_SIMP_TAC [← GSYM IMAGE_o, VECTOR_MUL_ASSOC, o_DEF, REAL_MUL_LINV,
                    VECTOR_MUL_LID, IMAGE_ID]])

  let IS_INTERVAL_REFLECT ← prove
   r"!s:real^N->bool. is_interval(IMAGE (--) s) <=> is_interval s"
   (GEN_TAC THEN TRANS_TAC EQ_TRANS
     (← q r"is_interval(IMAGE (\x:real^N. --(&1) % x) s)") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [VECTOR_MUL_LNEG, VECTOR_MUL_LID] THEN REWRITE_TAC [ETA_AX],
      REWRITE_TAC [IS_INTERVAL_SCALING_EQ] THEN CONV_TAC REAL_RAT_REDUCE_CONV])

  -- let lemma = prove (...) in add_scaling_theorems [lemma];;
  do
    let lemma ← prove
     r"!c. &0 < c
         ==> !s:real^N->bool. is_interval(IMAGE (\x. c % x) s) <=>
                              is_interval s"
     (SIMP_TAC [IS_INTERVAL_SCALING_EQ, REAL_LT_IMP_NZ])
    add_scaling_theorems [lemma]

  let CARD_FRONTIER_INTERVAL_1 ← do
    let lemma ← prove
     r"~(?a b c. drop a < drop b /\ drop b < drop c /\
                 a IN s /\ b IN s /\ c IN s)
       ==> FINITE s /\ CARD(s) <= 2"
     (ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [← TAUT (← q r"~(p /\ q) <=> p ==> ~q")] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"~(n <= 2) <=> 3 <= n")] THEN
      DISCH_THEN (MP_TAC o MATCH_MP CHOOSE_SUBSET_STRONG) THEN
      REWRITE_TAC [← HAS_SIZE_CONV (← q r"t HAS_SIZE 3")] THEN
      REWRITE_TAC [CONJ_ASSOC, ← MESON []
       (← q r"(?t. P t /\ ?x y z. Q x y z /\ t = f x y z) <=>
        (?x y z. Q x y z /\ P(f x y z))")] THEN
      SIMP_TAC [LEFT_IMP_EXISTS_THM, ← GSYM CONJ_ASSOC, FORALL_LIFT, LIFT_EQ] THEN
      REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET] THEN
      MATCH_MP_TAC (← MESON [REAL_LE_TOTAL]
       (← q r"(!m n p:real. P m n p ==> P n p m /\ P n m p) /\
        (!m n p. m <= n /\ n <= p ==> P m n p)
        ==> !m n p. P m n p")) THEN
      CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [FORALL_DROP, DROP_EQ, LIFT_DROP] THEN
      REWRITE_TAC [REAL_LT_LE, DROP_EQ] THEN MESON_TAC [])
    prove
     r"!s:real^1->bool.
        is_interval s ==> FINITE(frontier s) /\ CARD(frontier s) <= 2"
     (GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC lemma THEN
      REWRITE_TAC [NOT_EXISTS_THM, FRONTIER_CLOSURES, IN_INTER] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1", ← q r"c:real^1"] THEN
      STRIP_TAC THEN
      MAP_EVERY UNDISCH_TAC
       [← q r"b IN closure ((:real^1) DIFF s)",
        ← q r"(a:real^1) IN closure s", ← q r"(c:real^1) IN closure s"] THEN
      SIMP_TAC [CLOSURE_APPROACHABLE, IN_DIFF, IN_UNIV, DIST_REAL, ← GSYM drop] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(drop c - drop b) / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^1") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(drop b - drop a) / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^1") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (MP_TAC o SPEC
        (← q r"min ((drop b - drop a) / &2) ((drop c - drop b) / &2)")) THEN
      ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT, REAL_LT_MIN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^1") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IS_INTERVAL_1]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"u:real^1", ← q r"v:real^1", ← q r"w:real^1"]) THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let UNION_INTERVAL_SUBSET_INTERVAL ← prove
   r"!s a b c d:real^N.
        is_interval s /\
        interval[a,b] SUBSET s /\ interval[c,d] SUBSET s
        ==> ?u v. interval[a,b] UNION interval[c,d] SUBSET interval[u,v] /\
                  interval[u,v] SUBSET s"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THENL
     [ASM_REWRITE_TAC [UNION_EMPTY] THEN MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"interval[c:real^N,d] = {}") THENL
     [ASM_REWRITE_TAC [UNION_EMPTY] THEN MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
    REWRITE_TAC [is_interval, ← GSYM UNION_SUBSET] THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"(lambda i. min ((a:real^N)$i) ((c:real^N)$i)):real^N") THEN
    EXISTS_TAC (← q r"(lambda i. max ((b:real^N)$i) ((d:real^N)$i)):real^N") THEN
    SIMP_TAC [UNION_SUBSET, SUBSET_INTERVAL, LAMBDA_BETA] THEN
    REPEAT (CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC]) THEN
    SIMP_TAC [SUBSET, IN_INTERVAL, LAMBDA_BETA] THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
    EXISTS_TAC (← q r"(lambda i. min ((a:real^N)$i) ((c:real^N)$i)):real^N") THEN
    EXISTS_TAC (← q r"(lambda i. max ((b:real^N)$i) ((d:real^N)$i)):real^N") THEN
    ASM_SIMP_TAC [LAMBDA_BETA] THEN CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THENL
     [MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"c:real^N"],
      MAP_EVERY EXISTS_TAC [← q r"b:real^N", ← q r"d:real^N"]] THEN
    SIMP_TAC [LAMBDA_BETA, CONJ_ASSOC] THEN
    (CONJ_TAC THENL [CONJ_TAC, REAL_ARITH_TAC]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_UNION, ENDS_IN_INTERVAL])

  return { IS_INTERVAL_SCALING, IS_INTERVAL_SCALING_EQ, IS_INTERVAL_REFLECT,
           CARD_FRONTIER_INTERVAL_1, UNION_INTERVAL_SUBSET_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Limit component bounds.  (topology.ml 15069-15170)                        -/
/- ------------------------------------------------------------------------- -/

structure LCB where
  LIM_COMPONENT_UBOUND : thm
  LIM_COMPONENT_LBOUND : thm
  LIM_COMPONENT_EQ : thm
  LIM_COMPONENT_LE : thm
  LIM_DROP_LE : thm
  LIM_DROP_UBOUND : thm
  LIM_DROP_LBOUND : thm
  LIMIT_PAIR_DROP_LE : thm
  deriving Inhabited

@[nospecialize]
def setupLCB [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) (BARI : ARI) (BUNQ : UNQ) (BHSP : HSP) :
    ExceptT String IO LCB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, .. } := D
  let { CONJ_ASSOC, DIMINDEX_1, .. } := D.core1
  let { IMP_IMP, IN_ELIM_THM, .. } := D.core2
  let { LE_REFL, NOT_EXISTS_THM, .. } := D.core3
  let { REAL_LE_ANTISYM, .. } := D.core4
  let { REAL_NOT_LE, REAL_SUB_LE, REAL_SUB_LT, .. } := D.core5
  let { real_ge, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_1, DOT_BASIS, .. } := D.vec1
  let { VECTOR_SUB_COMPONENT, drop, .. } := D.vec4
  let { EVENTUALLY_AND, EVENTUALLY_HAPPENS, .. } := D.met2
  let { tendsto, .. } := BLIM1
  let { LIM_SUB, .. } := BARI
  let { LIM_IN_CLOSED_SET, .. } := BUNQ
  let { CLOSED_HALFSPACE_GE, CLOSED_HALFSPACE_LE, .. } := BHSP
  -- @@SCOPE END

  let LIM_COMPONENT_UBOUND ← prove
   r"!net:(A)net f (l:real^N) b k.
        ~(trivial_limit net) /\ (f --> l) net /\
        eventually (\x. (f x)$k <= b) net /\
        1 <= k /\ k <= dimindex(:N)
        ==> l$k <= b"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"net:(A)net", ← q r"f:A->real^N", ← q r"{y:real^N | basis k dot y <= b}",
      ← q r"l:real^N"]
     LIM_IN_CLOSED_SET) THEN
    ASM_SIMP_TAC [CLOSED_HALFSPACE_LE, IN_ELIM_THM, DOT_BASIS])

  let LIM_COMPONENT_LBOUND ← prove
   r"!net:(A)net f (l:real^N) b k.
        ~(trivial_limit net) /\ (f --> l) net /\
        eventually (\x. b <= (f x)$k) net /\
        1 <= k /\ k <= dimindex(:N)
        ==> b <= l$k"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"net:(A)net", ← q r"f:A->real^N", ← q r"{y:real^N | b <= basis k dot y}",
      ← q r"l:real^N"]
     LIM_IN_CLOSED_SET) THEN
    ASM_SIMP_TAC [← REWRITE_RULE [real_ge] CLOSED_HALFSPACE_GE,
                  IN_ELIM_THM, DOT_BASIS])

  let LIM_COMPONENT_EQ ← prove
   r"!net f:A->real^N i l b.
        (f --> l) net /\ 1 <= i /\ i <= dimindex(:N) /\
        ~(trivial_limit net) /\ eventually (\x. f(x)$i = b) net
        ==> l$i = b"
   (REWRITE_TAC [← GSYM REAL_LE_ANTISYM, EVENTUALLY_AND] THEN
    MESON_TAC [LIM_COMPONENT_UBOUND, LIM_COMPONENT_LBOUND])

  let LIM_COMPONENT_LE ← prove
   r"!net:(A)net f:A->real^N g:A->real^N k l m.
         ~(trivial_limit net) /\ (f --> l) net /\ (g --> m) net /\
        eventually (\x. (f x)$k <= (g x)$k) net /\
        1 <= k /\ k <= dimindex(:N)
        ==> l$k <= m$k"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM REAL_SUB_LE] THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT, LIM_COMPONENT_LBOUND] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> b /\ a ==> c ==> d")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_SUB) THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC, LIM_COMPONENT_LBOUND])

  let LIM_DROP_LE ← prove
   r"!net:(A)net f g l m.
         ~(trivial_limit net) /\ (f --> l) net /\ (g --> m) net /\
        eventually (\x. drop(f x) <= drop(g x)) net
        ==> drop l <= drop m"
   (REWRITE_TAC [drop] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"net:(A)net") LIM_COMPONENT_LE) THEN
    MAP_EVERY EXISTS_TAC [← q r"f:A->real^1", ← q r"g:A->real^1"] THEN
    ASM_REWRITE_TAC [DIMINDEX_1, LE_REFL])

  let LIM_DROP_UBOUND ← prove
   r"!net f:A->real^1 l b.
        (f --> l) net /\
        ~(trivial_limit net) /\ eventually (\x. drop(f x) <= b) net
        ==> drop l <= b"
   (SIMP_TAC [drop] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LIM_COMPONENT_UBOUND THEN
    REWRITE_TAC [LE_REFL, DIMINDEX_1] THEN ASM_MESON_TAC [])

  let LIM_DROP_LBOUND ← prove
   r"!net f:A->real^1 l b.
        (f --> l) net /\
        ~(trivial_limit net) /\ eventually (\x. b <= drop(f x)) net
        ==> b <= drop l"
   (SIMP_TAC [drop] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LIM_COMPONENT_LBOUND THEN
    REWRITE_TAC [LE_REFL, DIMINDEX_1] THEN ASM_MESON_TAC [])

  let LIMIT_PAIR_DROP_LE ← prove
   r"!net1:(A)net net2:(B)net f g l m.
        ~(trivial_limit net1) /\ ~(trivial_limit net2) /\
        (f --> l) net1 /\ (g --> m) net2 /\
        eventually (\x. eventually (\y. drop(f x) <= drop(g y)) net2) net1
        ==> drop l <= drop m"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← TAUT
     (← q r"p /\ q /\ r /\ s /\ t ==> u <=>
      (p /\ q /\ s) ==> ~u ==> r /\ t ==> F")] THEN
    STRIP_TAC THEN REWRITE_TAC [REAL_NOT_LE] THEN STRIP_TAC THEN
    REWRITE_TAC [tendsto] THEN DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o SPEC (← q r"(drop l - drop m) / &2")) MP_TAC) THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT] THEN
    REWRITE_TAC [← TAUT (← q r"p ==> ~q <=> p /\ q ==> F"), ← GSYM EVENTUALLY_AND] THEN
    DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(drop l - drop m) / &2") o
      REWRITE_RULE [tendsto]) THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT] THEN
    REWRITE_TAC [← TAUT (← q r"p ==> ~q <=> p /\ q ==> F"), ← GSYM EVENTUALLY_AND] THEN
    DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_NOT_LE])) THEN
    REWRITE_TAC [DIST_1] THEN REAL_ARITH_TAC)

  return { LIM_COMPONENT_UBOUND, LIM_COMPONENT_LBOUND, LIM_COMPONENT_EQ, LIM_COMPONENT_LE,
           LIM_DROP_LE, LIM_DROP_UBOUND, LIM_DROP_LBOUND, LIMIT_PAIR_DROP_LE }

/- ------------------------------------------------------------------------- -/
/- Also extending closed bounds to closures.  (topology.ml 15171-15280)      -/
/- ------------------------------------------------------------------------- -/

structure CLB where
  IMAGE_CLOSURE_SUBSET : thm
  CLOSURE_IMAGE_CLOSURE : thm
  CLOSURE_IMAGE_BOUNDED : thm
  CONTINUOUS_ON_CLOSURE_NORM_LE : thm
  CONTINUOUS_ON_CLOSURE_COMPONENT_LE : thm
  CONTINUOUS_ON_CLOSURE_COMPONENT_GE : thm
  CONTINUOUS_MAP_CLOSURES_GEN : thm
  CONTINUOUS_MAP_CLOSURES : thm
  deriving Inhabited

@[nospecialize]
def setupCLB [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLOC : LOC) (BCLS1 : CLS1)
    (BCLS2 : CLS2) (BCBL : CBL) (BCPT : CPT) (BCSL : CSL) (BCLC : CLC) (BLCP : LCP)
    (BHSP : HSP) : ExceptT String IO CLB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EQ_TRANS, .. } := D.core1
  let { FUN_IN_IMAGE, IMAGE_SUBSET, IMP_CONJ_ALT, INTER_SUBSET, INTER_UNIV, IN_ELIM_THM,
        IN_INTER, .. } := D.core2
  let { SUBSET, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_RESTRICT, SUBSET_TRANS, SUBSET_UNIV,
        .. } := D.core5
  let { real_ge, .. } := D.core6
  let { CLOSED_IN_TRANS, .. } := D.met1
  let { IN_CBALL_0, .. } := BBAL
  let { CLOSED_IN_CLOSED_INTER, .. } := BLOC
  let { CLOSED_CLOSURE, CLOSURE_CLOSED, CLOSURE_INC, CLOSURE_MINIMAL, CLOSURE_MINIMAL_EQ,
        CLOSURE_MINIMAL_LOCAL, CLOSURE_SUBSET, SUBSET_CLOSURE, .. } := BCLS1
  let { CLOSED_IN_INTER_CLOSURE, .. } := BCLS2
  let { CLOSED_CBALL, .. } := BCBL
  let { COMPACT_CLOSURE, COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_CLOSED_IN_PREIMAGE_EQ,
        CONTINUOUS_CLOSED_PREIMAGE, .. } := BCLC
  let { COMPACT_CONTINUOUS_IMAGE, .. } := BLCP
  let { CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_HALFSPACE_COMPONENT_LE, .. } := BHSP
  -- @@SCOPE END

  let IMAGE_CLOSURE_SUBSET ← prove
   r"!f (s:real^N->bool) (t:real^M->bool).
      f continuous_on closure s /\ closed t /\ IMAGE f s SUBSET t
      ==> IMAGE f (closure s) SUBSET t"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"closure s SUBSET {x | (f:real^N->real^M) x IN t}") MP_TAC
    THENL [MATCH_MP_TAC SUBSET_TRANS, SET_TAC []]  THEN
    EXISTS_TAC (← q r"{x | x IN closure s /\ (f:real^N->real^M) x IN t}") THEN
    CONJ_TAC THENL
    [MATCH_MP_TAC CLOSURE_MINIMAL, SET_TAC []] THEN
    ASM_SIMP_TAC [CONTINUOUS_CLOSED_PREIMAGE, CLOSED_CLOSURE] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC [])

  let CLOSURE_IMAGE_CLOSURE ← prove
   r"!f:real^M->real^N s.
        f continuous_on closure s
        ==> closure(IMAGE f (closure s)) = closure(IMAGE f s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    SIMP_TAC [SUBSET_CLOSURE, IMAGE_SUBSET, CLOSURE_SUBSET] THEN
    SIMP_TAC [CLOSURE_MINIMAL_EQ, CLOSED_CLOSURE] THEN
    MATCH_MP_TAC IMAGE_CLOSURE_SUBSET THEN
    ASM_REWRITE_TAC [CLOSED_CLOSURE, CLOSURE_SUBSET])

  let CLOSURE_IMAGE_BOUNDED ← prove
   r"!f:real^M->real^N s.
        f continuous_on closure s /\ bounded s
        ==> closure(IMAGE f s) = IMAGE f (closure s)"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS (← q r"closure(IMAGE (f:real^M->real^N) (closure s))") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CLOSURE_IMAGE_CLOSURE], ALL_TAC] THEN
    MATCH_MP_TAC CLOSURE_CLOSED THEN MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE])

  let CONTINUOUS_ON_CLOSURE_NORM_LE ← prove
   r"!f:real^N->real^M s x b.
      f continuous_on (closure s) /\
      (!y. y IN s ==> norm(f y) <= b) /\
      x IN (closure s)
      ==> norm(f x) <= b"
   (REWRITE_TAC [← GSYM IN_CBALL_0] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:real^N->real^M) (closure s) SUBSET cball(vec 0,b)")
      MP_TAC THENL
    [MATCH_MP_TAC IMAGE_CLOSURE_SUBSET, ASM SET_TAC []] THEN
    ASM_REWRITE_TAC [CLOSED_CBALL] THEN ASM SET_TAC [])

  let CONTINUOUS_ON_CLOSURE_COMPONENT_LE ← prove
   r"!f:real^N->real^M s x b k.
      f continuous_on (closure s) /\
      (!y. y IN s ==> (f y)$k <= b) /\
      x IN (closure s)
      ==> (f x)$k <= b"
   (REWRITE_TAC [← GSYM IN_CBALL_0] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:real^N->real^M) (closure s) SUBSET {x | x$k <= b}")
    MP_TAC THENL
     [MATCH_MP_TAC IMAGE_CLOSURE_SUBSET, ASM SET_TAC []] THEN
    ASM_REWRITE_TAC [CLOSED_HALFSPACE_COMPONENT_LE] THEN ASM SET_TAC [])

  let CONTINUOUS_ON_CLOSURE_COMPONENT_GE ← prove
   r"!f:real^N->real^M s x b k.
      f continuous_on (closure s) /\
      (!y. y IN s ==> b <= (f y)$k) /\
      x IN (closure s)
      ==> b <= (f x)$k"
   (REWRITE_TAC [← GSYM IN_CBALL_0] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:real^N->real^M) (closure s) SUBSET {x | x$k >= b}")
    MP_TAC THENL
     [MATCH_MP_TAC IMAGE_CLOSURE_SUBSET, ASM SET_TAC [real_ge]] THEN
    ASM_REWRITE_TAC [CLOSED_HALFSPACE_COMPONENT_GE] THEN ASM SET_TAC [real_ge])

  let CONTINUOUS_MAP_CLOSURES_GEN ← prove
   r"!f:real^M->real^N s.
        f continuous_on s <=>
        !t. t SUBSET s
            ==> IMAGE f (s INTER closure t) SUBSET closure(IMAGE f t)"
   (REWRITE_TAC [← SET_RULE
       (← q r"IMAGE f s SUBSET t <=> s SUBSET {x | x IN s /\ f x IN t}")]  THEN
    REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [MATCH_MP_TAC CLOSURE_MINIMAL_LOCAL THEN CONJ_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_TRANS THEN
        EXISTS_TAC (← q r"s INTER closure t:real^M->bool") THEN
        SIMP_TAC [CLOSED_IN_CLOSED_INTER, CLOSED_CLOSURE] THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTER_SUBSET, CLOSED_CLOSURE],
        SIMP_TAC [SUBSET, IN_ELIM_THM, IN_INTER, CLOSURE_INC, FUN_IN_IMAGE] THEN
        ASM_REWRITE_TAC [← GSYM SUBSET]],
      REWRITE_TAC [CONTINUOUS_CLOSED_IN_PREIMAGE_EQ] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [CLOSED_IN_INTER_CLOSURE, ← GSYM SUBSET_ANTISYM_EQ] THEN
      REWRITE_TAC [SUBSET_INTER, CLOSURE_SUBSET, SUBSET_RESTRICT] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"{x | x IN s /\ (f:real^M->real^N) x IN t}")) THEN
      REWRITE_TAC [SUBSET_RESTRICT] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
      SIMP_TAC [SUBSET, IN_ELIM_THM, IN_INTER] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_THEN (MP_TAC o CONJUNCT2) THEN
      SPEC_TAC (← q r"(f:real^M->real^N) x", ← q r"y:real^N") THEN
      REWRITE_TAC [← GSYM SUBSET] THEN MATCH_MP_TAC CLOSURE_MINIMAL THEN
      ASM SET_TAC []])

  let CONTINUOUS_MAP_CLOSURES ← prove
   r"!f:real^M->real^N.
        f continuous_on UNIV <=>
        !s. IMAGE f (closure s) SUBSET closure(IMAGE f s)"
   (REWRITE_TAC [CONTINUOUS_MAP_CLOSURES_GEN, SUBSET_UNIV, INTER_UNIV])

  return { IMAGE_CLOSURE_SUBSET, CLOSURE_IMAGE_CLOSURE, CLOSURE_IMAGE_BOUNDED,
           CONTINUOUS_ON_CLOSURE_NORM_LE, CONTINUOUS_ON_CLOSURE_COMPONENT_LE,
           CONTINUOUS_ON_CLOSURE_COMPONENT_GE, CONTINUOUS_MAP_CLOSURES_GEN,
           CONTINUOUS_MAP_CLOSURES }

/- ------------------------------------------------------------------------- -/
/- Relating images and frontiers.  (topology.ml 15281-15403)                 -/
/- ------------------------------------------------------------------------- -/

structure IMF where
  PROPER_MAP_ESCAPES_FROM_IMAGE : thm
  FRONTIER_PROPER_MAP_IMAGE_SUBSET_GEN : thm
  FRONTIER_PROPER_MAP_IMAGE_SUBSET : thm
  FRONTIER_CLOPEN_MAP_IMAGE_SUBSET : thm
  FRONTIER_OPEN_MAP_IMAGE_SUBSET : thm
  FRONTIER_PROPER_CLOPEN_MAP_IMAGE : thm
  FRONTIER_PROPER_OPEN_MAP_IMAGE : thm
  FRONTIER_CLOPEN_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupIMF [HolBase] (D : TopologyDeps) (BINT : INT) (BCLS1 : CLS1) (BFRO1 : FRO1)
    (BLIM2 : LIM2) (BUNQ : UNQ) (BSEQ : SEQ) (BCPT : CPT) (BNST : NST) (BLCP : LCP)
    (BPRP1 : PRP1) (BSPP : SPP) (BCUC : CUC) (BCLB : CLB) : ExceptT String IO IMF := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { FORALL_IN_IMAGE, IMAGE_SUBSET, INTER_IDEMPOT, IN_DIFF, .. } := D.core2
  let { I_O_ID, I_THM, MONO_EXISTS, NOT_EXISTS_THM, NOT_IMP, .. } := D.core3
  let { SUBSET_ANTISYM_EQ, .. } := D.core5
  let { o_DEF, .. } := D.core6
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { INTERIOR_MAXIMAL, INTERIOR_OPEN, INTERIOR_SUBSET, .. } := BINT
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, .. } := BCLS1
  let { frontier, .. } := BFRO1
  let { LIM_SUBSEQUENCE, .. } := BLIM2
  let { LIM_UNIQUE, .. } := BUNQ
  let { CLOSURE_SEQUENTIAL, .. } := BSEQ
  let { COMPACT_CLOSURE, COMPACT_IMP_CLOSED, .. } := BCPT
  let { SEQUENCE_ESCAPES, .. } := BNST
  let { COMPACT_CONTINUOUS_IMAGE, .. } := BLCP
  let { PROPER_MAP_EQ, .. } := BPRP1
  let { PROPER_MAP_ESCAPES_IMP, .. } := BSPP
  let { CONTINUOUS_ON_CLOSURE_SEQUENTIALLY, .. } := BCUC
  let { CONTINUOUS_MAP_CLOSURES_GEN, .. } := BCLB
  -- @@SCOPE END

  let PROPER_MAP_ESCAPES_FROM_IMAGE ← prove
   r"!f:real^M->real^N s t x r a b.
        IMAGE f s SUBSET t /\
        (!k. k SUBSET t /\ compact k
             ==> compact {x | x IN s /\ f x IN k}) /\
        (!n. x n IN s) /\ ~(a IN s) /\ (x --> a) sequentially /\
        (!m n. m < n ==> r m < r n) /\ ((f o x o r) --> b) sequentially
        ==> ~(b IN IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"t:real^N->bool",
                      ← q r"x:num->real^M"] PROPER_MAP_ESCAPES_IMP) THEN
    ASM_SIMP_TAC [NOT_IMP, SEQUENCE_ESCAPES, NOT_EXISTS_THM] THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"a':real^M", ← q r"r':num->num"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"a':real^M = a") (fun th => ASM_MESON_TAC [th]) THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"(x:num->real^M) o (r':num->num)") THEN
      ASM_SIMP_TAC [LIM_SUBSEQUENCE, TRIVIAL_LIMIT_SEQUENTIALLY],
      W (MP_TAC o PART_MATCH (lhand o rand) SEQUENCE_ESCAPES o rand o snd) THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [] THEN RULE_ASSUM_TAC (REWRITE_RULE [o_DEF]) THEN
      MAP_EVERY EXISTS_TAC [← q r"b:real^N", ← q r"r:num->num"] THEN
      ASM_REWRITE_TAC [o_DEF] THEN ASM SET_TAC []])

  let FRONTIER_PROPER_MAP_IMAGE_SUBSET_GEN ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s SUBSET t /\
        f continuous_on closure s /\
        (!k. k SUBSET t /\ compact k
             ==> compact {x | x IN s /\ f x IN k})
        ==> IMAGE f (closure s DIFF s) SUBSET
            closure(IMAGE f s) DIFF IMAGE f s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"IMAGE f c SUBSET c' /\ IMAGE f (c DIFF i) INTER i' = {}
      ==> IMAGE f (c DIFF i) SUBSET c' DIFF i'")) THEN
    CONJ_TAC THENL
     [FIRST_ASSUM (MP_TAC o SPEC (← q r"s:real^M->bool") o
        GEN_REWRITE_RULE id [CONTINUOUS_MAP_CLOSURES_GEN]) THEN
      REWRITE_TAC [CLOSURE_SUBSET, INTER_IDEMPOT],
      REWRITE_TAC [← SET_RULE (← q r"s INTER t = {} <=> !x. x IN s ==> ~(x IN t)")] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_DIFF] THEN X_GEN_TAC (← q r"a:real^M") THEN
      STRIP_TAC THEN MATCH_MP_TAC PROPER_MAP_ESCAPES_FROM_IMAGE THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CLOSURE_SEQUENTIAL]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:num->real^M") THEN
      STRIP_TAC THEN MAP_EVERY EXISTS_TAC [← q r"I:num->num", ← q r"a:real^M"] THEN
      ASM_REWRITE_TAC [I_O_ID, I_THM] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_CLOSURE_SEQUENTIALLY]])

  let FRONTIER_PROPER_MAP_IMAGE_SUBSET ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s SUBSET t /\
        open s /\
        f continuous_on closure s /\
        (!k. k SUBSET t /\ compact k
             ==> compact {x | x IN s /\ f x IN k})
        ==> IMAGE f (frontier s) SUBSET frontier(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"t:real^N->bool"]
          FRONTIER_PROPER_MAP_IMAGE_SUBSET_GEN) THEN
    ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN
    MP_TAC (← ISPEC (← q r"IMAGE (f:real^M->real^N) s") INTERIOR_SUBSET) THEN SET_TAC [])

  let FRONTIER_CLOPEN_MAP_IMAGE_SUBSET ← prove
   r"!f:real^M->real^N s.
        closed(IMAGE f (closure s)) /\ open(IMAGE f (interior s))
        ==> frontier(IMAGE f s) SUBSET IMAGE f (frontier s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [frontier] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"IMAGE f i SUBSET i' /\ c' SUBSET IMAGE f c
      ==> c' DIFF i' SUBSET IMAGE f (c DIFF i)")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC INTERIOR_MAXIMAL, MATCH_MP_TAC CLOSURE_MINIMAL] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
    REWRITE_TAC [INTERIOR_SUBSET, CLOSURE_SUBSET])

  let FRONTIER_OPEN_MAP_IMAGE_SUBSET ← prove
   r"!f:real^M->real^N s.
        bounded s /\ f continuous_on closure s /\ open(IMAGE f (interior s))
        ==> frontier(IMAGE f s) SUBSET IMAGE f (frontier s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FRONTIER_CLOPEN_MAP_IMAGE_SUBSET THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE])

  let FRONTIER_PROPER_CLOPEN_MAP_IMAGE ← prove
   r"!f:real^M->real^N s t.
        open s /\ IMAGE f s SUBSET t /\ f continuous_on closure s /\
        open(IMAGE f s) /\ closed(IMAGE f (closure s)) /\
        (!k. k SUBSET t /\ compact k
             ==> compact {x | x IN s /\ f x IN k})
        ==> IMAGE f (frontier s) = frontier(IMAGE f s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    ASM_SIMP_TAC [FRONTIER_CLOPEN_MAP_IMAGE_SUBSET, INTERIOR_OPEN] THEN
    MATCH_MP_TAC FRONTIER_PROPER_MAP_IMAGE_SUBSET THEN ASM_MESON_TAC [])

  let FRONTIER_PROPER_OPEN_MAP_IMAGE ← prove
   r"!f:real^M->real^N s t.
        bounded s /\ open s /\ open(IMAGE f s) /\
        f continuous_on closure s /\
        IMAGE f s SUBSET t /\
        (!k. k SUBSET t /\ compact k
             ==> compact {x | x IN s /\ f x IN k})
        ==> IMAGE f (frontier s) = frontier(IMAGE f s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    ASM_SIMP_TAC [FRONTIER_OPEN_MAP_IMAGE_SUBSET, INTERIOR_OPEN] THEN
    MATCH_MP_TAC FRONTIER_PROPER_MAP_IMAGE_SUBSET THEN ASM_MESON_TAC [])

  let FRONTIER_CLOPEN_MAP_IMAGE ← prove
   r"!f:real^M->real^N s t.
        open s /\ open(IMAGE f s) /\ closed(IMAGE f (closure s)) /\
        f continuous_on closure s /\
        (!y. compact {x | x IN s /\ f x = y}) /\
        (!c. closed_in (subtopology euclidean s) c
             ==> closed_in (subtopology euclidean t) (IMAGE f c))
        ==> IMAGE f (frontier s) = frontier(IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FRONTIER_PROPER_CLOPEN_MAP_IMAGE THEN
    ASM_REWRITE_TAC [PROPER_MAP_EQ] THEN ASM_MESON_TAC [])

  return { PROPER_MAP_ESCAPES_FROM_IMAGE, FRONTIER_PROPER_MAP_IMAGE_SUBSET_GEN,
           FRONTIER_PROPER_MAP_IMAGE_SUBSET, FRONTIER_CLOPEN_MAP_IMAGE_SUBSET,
           FRONTIER_OPEN_MAP_IMAGE_SUBSET, FRONTIER_PROPER_CLOPEN_MAP_IMAGE,
           FRONTIER_PROPER_OPEN_MAP_IMAGE, FRONTIER_CLOPEN_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Limits relative to a union.  (topology.ml 15404-15565)                    -/
/- ------------------------------------------------------------------------- -/

structure LRU where
  LIM_WITHIN_UNION : thm
  CONTINUOUS_ON_UNION : thm
  CONTINUOUS_ON_CASES : thm
  CONTINUOUS_ON_UNION_LOCAL : thm
  CONTINUOUS_ON_CASES_LOCAL : thm
  CONTINUOUS_ON_CASES_LE : thm
  CONTINUOUS_ON_CASES_1 : thm
  EXTENSION_FROM_CLOPEN : thm
  CONTINUOUS_ON_CLOPEN_INDICATOR : thm
  deriving Inhabited

@[nospecialize]
def setupLRU [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLPT : LPT) (BCLS2 : CLS2) (BEVT : EVT)
    (BLIM1 : LIM1) (BLIM2 : LIM2) (BCSL : CSL) (BCMS : CMS) (BIDC : IDC) (BCLC : CLC)
    (BHSP : HSP) : ExceptT String IO LRU := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, COND_ID, CONJ_ASSOC, ETA_AX, EXTENSION, .. } := D.core1
  let { FINITE_RULES, FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMP_CONJ,
        IN_DIFF, IN_ELIM_THM, IN_INSERT, .. } := D.core2
  let { IN_UNION, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_TOTAL, REAL_LT_MIN, .. } := D.core4
  let { SUBSET, SUBSET_EMPTY, .. } := D.core5
  let { o_DEF, o_THM, .. } := D.core6
  let { LIFT_DROP, LIFT_EQ, .. } := D.vec2
  let { drop, .. } := D.vec4
  let { CLOSED_IN_DIFF, .. } := D.met1
  let { OPEN_IN_IMP_SUBSET, .. } := D.met3
  let { CLOSED_IN_REFL, .. } := BCLO
  let { CLOSED_IN_SING, CLOSED_LIMPT, LIMIT_POINT_FINITE, OPEN_IN_SING, .. } := BLPT
  let { CLOSED_IN_LIMPT, .. } := BCLS2
  let { TRIVIAL_LIMIT_WITHIN, .. } := BEVT
  let { LIM_TRIVIAL, .. } := BLIM1
  let { LIM_WITHIN, .. } := BLIM2
  let { CONTINUOUS_ON, CONTINUOUS_ON_EMPTY, CONTINUOUS_ON_EQ, CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_ID, CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := BIDC
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_CLOSED_IN_PREIMAGE_GEN, .. } := BCLC
  let { CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_HALFSPACE_COMPONENT_LE, .. } := BHSP
  -- @@SCOPE END

  let LIM_WITHIN_UNION ← prove
   r"(f --> l) (at x within (s UNION t)) <=>
   (f --> l) (at x within s) /\ (f --> l) (at x within t)"
   (REWRITE_TAC [LIM_WITHIN, IN_UNION, AND_FORALL_THM] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THENL [MESON_TAC [], ALL_TAC] THEN DISCH_THEN
     (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"d:real")) (X_CHOOSE_TAC (← q r"k:real"))) THEN
    EXISTS_TAC (← q r"min d k") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [])

  let CONTINUOUS_ON_UNION ← prove
   r"!f s t. closed s /\ closed t /\ f continuous_on s /\ f continuous_on t
           ==> f continuous_on (s UNION t)"
   (REWRITE_TAC [CONTINUOUS_ON, CLOSED_LIMPT, IN_UNION, LIM_WITHIN_UNION] THEN
    MESON_TAC [LIM_TRIVIAL, TRIVIAL_LIMIT_WITHIN])

  let CONTINUOUS_ON_CASES ← prove
   r"!P f g:real^M->real^N s t.
        closed s /\ closed t /\ f continuous_on s /\ g continuous_on t /\
        (!x. x IN s /\ ~P x \/ x IN t /\ P x ==> f x = g x)
        ==> (\x. if P x then f x else g x) continuous_on (s UNION t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_UNION THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_EQ THENL
     [EXISTS_TAC (← q r"f:real^M->real^N"), EXISTS_TAC (← q r"g:real^M->real^N")] THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  let CONTINUOUS_ON_UNION_LOCAL ← prove
   r"!f:real^M->real^N s.
        closed_in (subtopology euclidean (s UNION t)) s /\
        closed_in (subtopology euclidean (s UNION t)) t /\
        f continuous_on s /\ f continuous_on t
        ==> f continuous_on (s UNION t)"
   (REWRITE_TAC [CONTINUOUS_ON, CLOSED_IN_LIMPT, IN_UNION, LIM_WITHIN_UNION] THEN
    MESON_TAC [LIM_TRIVIAL, TRIVIAL_LIMIT_WITHIN])

  let CONTINUOUS_ON_CASES_LOCAL ← prove
   r"!P f g:real^M->real^N s t.
        closed_in (subtopology euclidean (s UNION t)) s /\
        closed_in (subtopology euclidean (s UNION t)) t /\
        f continuous_on s /\ g continuous_on t /\
        (!x. x IN s /\ ~P x \/ x IN t /\ P x ==> f x = g x)
        ==> (\x. if P x then f x else g x) continuous_on (s UNION t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_UNION_LOCAL THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_EQ THENL
     [EXISTS_TAC (← q r"f:real^M->real^N"), EXISTS_TAC (← q r"g:real^M->real^N")] THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  let CONTINUOUS_ON_CASES_LE ← prove
   r"!f g:real^M->real^N h s a.
        f continuous_on {t | t IN s /\ h t <= a} /\
        g continuous_on {t | t IN s /\ a <= h t} /\
        (lift o h) continuous_on s /\
        (!t. t IN s /\ h t = a ==> f t = g t)
        ==> (\t. if h t <= a then f(t) else g(t)) continuous_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC
     (← q r"{t | t IN s /\ (h:real^M->real) t <= a} UNION
      {t | t IN s /\ a <= h t}") THEN
    CONJ_TAC THENL
     [ALL_TAC, SIMP_TAC [SUBSET, IN_UNION, IN_ELIM_THM, REAL_LE_TOTAL]] THEN
    MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM CONJ_ASSOC, REAL_LE_ANTISYM] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC []] THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"{t | t IN s /\ (h:real^M->real) t <= a} =
        {t | t IN ({t | t IN s /\ h t <= a} UNION {t | t IN s /\ a <= h t}) /\
             (lift o h) t IN {x | x$1 <= a}}")
       (fun th => GEN_REWRITE_TAC RAND_CONV [th])
      THENL
       [REWRITE_TAC [← GSYM drop, o_THM, IN_ELIM_THM, LIFT_DROP, EXTENSION,
                     IN_UNION] THEN
        GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
        ASM_REWRITE_TAC [CLOSED_HALFSPACE_COMPONENT_LE, ETA_AX] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        SET_TAC []],
      SUBGOAL_THEN
       (← q r"{t | t IN s /\ a <= (h:real^M->real) t} =
        {t | t IN ({t | t IN s /\ h t <= a} UNION {t | t IN s /\ a <= h t}) /\
             (lift o h) t IN {x | x$1 >= a}}")
       (fun th => GEN_REWRITE_TAC RAND_CONV [th])
      THENL
       [REWRITE_TAC [← GSYM drop, o_THM, IN_ELIM_THM, LIFT_DROP, EXTENSION,
                     IN_UNION] THEN
        GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
        ASM_REWRITE_TAC [CLOSED_HALFSPACE_COMPONENT_GE, ETA_AX] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        SET_TAC []]])

  let CONTINUOUS_ON_CASES_1 ← prove
   r"!f g:real^1->real^N s a.
        f continuous_on {t | t IN s /\ drop t <= a} /\
        g continuous_on {t | t IN s /\ a <= drop t} /\
        (lift a IN s ==> f(lift a) = g(lift a))
        ==> (\t. if drop t <= a then f(t) else g(t)) continuous_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_CASES_LE THEN
    ASM_REWRITE_TAC [o_DEF, LIFT_DROP, CONTINUOUS_ON_ID] THEN
    REWRITE_TAC [← GSYM LIFT_EQ, LIFT_DROP] THEN ASM_MESON_TAC [])

  let EXTENSION_FROM_CLOPEN ← prove
   r"!f:real^M->real^N s t u.
        open_in (subtopology euclidean s) t /\
        closed_in (subtopology euclidean s) t /\
        f continuous_on t /\ IMAGE f t SUBSET u /\ (u = {} ==> s = {})
        ==> ?g. g continuous_on s /\ IMAGE g s SUBSET u /\
                !x. x IN t ==> g x = f x"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"u:real^N->bool = {}") THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_EMPTY, IMAGE_CLAUSES, SUBSET_EMPTY,
                  IMAGE_EQ_EMPTY, NOT_IN_EMPTY] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
    EXISTS_TAC (← q r"\x. if x IN t then (f:real^M->real^N) x else a") THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    SUBGOAL_THEN (← q r"s:real^M->bool = t UNION (s DIFF t)") SUBST1_TAC THENL
     [ASM SET_TAC [], MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"t SUBSET s ==> t UNION (s DIFF t) = s")] THEN
    REWRITE_TAC [CONTINUOUS_ON_CONST, IN_DIFF] THEN
    CONJ_TAC THENL [MATCH_MP_TAC CLOSED_IN_DIFF, MESON_TAC []] THEN
    ASM_REWRITE_TAC [CLOSED_IN_REFL])

  let CONTINUOUS_ON_CLOPEN_INDICATOR ← prove
   r"!s t:real^M->bool a b:real^N.
        (\x. if x IN t then a else b) continuous_on s <=>
        a = b \/
        open_in (subtopology euclidean s) (s INTER t) /\
        closed_in (subtopology euclidean s) (s INTER t)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [COND_ID, CONTINUOUS_ON_CONST] THEN
    EQ_TAC THENL
     [DISCH_TAC THEN SUBGOAL_THEN
      (← q r"s INTER t = {x:real^M | x IN s /\ (if x IN t then a else b:real^N) IN {a}}")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN,
        MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_GEN] THEN
      EXISTS_TAC (← q r"{a:real^N,b}") THEN ASM_REWRITE_TAC [] THEN
      (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      REWRITE_TAC [CLOSED_IN_SING, OPEN_IN_SING, IN_INSERT] THEN
      SIMP_TAC [LIMIT_POINT_FINITE, FINITE_RULES],
      STRIP_TAC THEN
      SUBST1_TAC (← SET_RULE (← q r"s:real^M->bool = (s INTER t) UNION (s DIFF t)")) THEN
      MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
      REWRITE_TAC [← SET_RULE (← q r"(s INTER t) UNION (s DIFF t) = s")] THEN
      ASM_REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s DIFF s INTER t")] THEN
      ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_REFL]])

  return { LIM_WITHIN_UNION, CONTINUOUS_ON_UNION, CONTINUOUS_ON_CASES, CONTINUOUS_ON_UNION_LOCAL,
           CONTINUOUS_ON_CASES_LOCAL, CONTINUOUS_ON_CASES_LE, CONTINUOUS_ON_CASES_1,
           EXTENSION_FROM_CLOPEN, CONTINUOUS_ON_CLOPEN_INDICATOR }

/- ------------------------------------------------------------------------- -/
/- Various formulations of limits for linear operators.                    -/
/- (topology.ml 15566-15687)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LLO where
  LIM_NULL_ONORM : thm
  LIM_NULL_ONORM_COMPONENTWISE : thm
  LIM_NULL_MATRIX_ONORM : thm
  LIM_NULL_MATRIX_ONORM_COMPONENTWISE : thm
  LIM_MATRIX_COMPONENTWISE : thm
  CONTINUOUS_MATRIX_COMPONENTWISE : thm
  CONTINUOUS_ON_MATRIX_COMPONENTWISE : thm
  deriving Inhabited

@[nospecialize]
def setupLLO [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) (BARI : ARI) (BCNT1 : CNT1)
    (BCSL : CSL) : ExceptT String IO LLO := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, REAL_ARITH, VECTOR_ARITH, .. } := D
  let { AND_FORALL_THM, ETA_AX, FINITE_NUMSEG, .. } := D.core1
  let { FUN_EQ_THM, IMP_CONJ, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, .. } := D.core3
  let { REAL_EQ_IMP_LE, REAL_LE_RMUL, REAL_LE_TRANS, .. } := D.core4
  let { REAL_MUL_SYM, RIGHT_FORALL_IMP_THM, .. } := D.core5
  let { SUM_LE_NUMSEG, SUM_RMUL, SWAP_FORALL_THM, o_DEF, real_abs, .. } := D.core6
  let { BASIS_EXPANSION, COMPONENT_LE_NORM, DROP_SUB, .. } := D.vec1
  let { LIFT_CMUL, LIFT_DROP, LIFT_NUM, LIFT_SUB, LIFT_SUM, LINEAR_CMUL, LINEAR_COMPOSE_NEG,
        LINEAR_COMPOSE_SUB, LINEAR_VSUM, MATRIX_SUB_COMPONENT, .. } := D.vec2
  let { MATRIX_VECTOR_MUL_BASIS, MATRIX_VECTOR_MUL_LINEAR, MATRIX_VECTOR_MUL_SUB_RDISTRIB,
        NORM_1, NORM_LIFT, NORM_MUL, NORM_POS_LE, ONORM, ONORM_LE_EQ, ONORM_NEG, ONORM_POS_LE,
        ONORM_TRIANGLE, .. } := D.vec3
  let { VEC_COMPONENT, VSUM_NORM_TRIANGLE, column, .. } := D.vec4
  let { ALWAYS_EVENTUALLY, .. } := D.met1
  let { EVENTUALLY_TRUE, .. } := D.met2
  let { LIM_COMPONENTWISE_LIFT, .. } := BLIM1
  let { LIM_NULL, LIM_NULL_COMPARISON, LIM_NULL_NORM, LIM_NULL_VMUL, LIM_NULL_VSUM, .. } := BARI
  let { continuous, .. } := BCNT1
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  -- @@SCOPE END

  let (LIM_NULL_ONORM, LIM_NULL_ONORM_COMPONENTWISE) ← CONJ_PAIR (← prove
   r"(!net f:A->real^M->real^N.
        (!a. linear(f a))
        ==> (((\a. lift(onorm(f a))) --> vec 0) net <=>
             !x. ((\a. f a x) --> vec 0) net)) /\
   (!net f:A->real^M->real^N.
        (!a. linear(f a))
        ==> (((\a. lift(onorm(f a))) --> vec 0) net <=>
             !i. 1 <= i /\ i <= dimindex(:M)
                 ==> ((\a. f a (basis i)) --> vec 0) net))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    DISCH_TAC THEN MATCH_MP_TAC (← TAUT
     (← q r"(q ==> r) /\ (p ==> q) /\ (r ==> p) ==> (p <=> q) /\ (p <=> r)")) THEN
    SIMP_TAC [] THEN CONJ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"x:real^M") THEN
      MATCH_MP_TAC LIM_NULL_COMPARISON THEN
      EXISTS_TAC (← q r"\a. onorm((f:A->real^M->real^N) a) * norm(x:real^M)") THEN
      ASM_SIMP_TAC [ONORM, EVENTUALLY_TRUE, LIFT_CMUL] THEN
      MATCH_MP_TAC LIM_NULL_VMUL THEN ASM_REWRITE_TAC [],
      DISCH_TAC THEN
      MATCH_MP_TAC LIM_NULL_COMPARISON THEN
      EXISTS_TAC (← q r"\a. sum(1..dimindex(:M))
                         (\i. norm((f:A->real^M->real^N) a (basis i)))") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [ONORM_LE_EQ, NORM_LIFT, real_abs, ONORM_POS_LE] THEN
        MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"a:A") THEN
        REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^M") THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV)
         [← GSYM BASIS_EXPANSION] THEN
        ASM_SIMP_TAC [LINEAR_VSUM, FINITE_NUMSEG, o_DEF] THEN
        MATCH_MP_TAC VSUM_NORM_TRIANGLE THEN
        REWRITE_TAC [FINITE_NUMSEG, ← GSYM SUM_RMUL] THEN
        MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"i:num") THEN
        STRIP_TAC THEN ASM_SIMP_TAC [LINEAR_CMUL, NORM_MUL] THEN
        GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN
        MATCH_MP_TAC REAL_LE_RMUL THEN
        REWRITE_TAC [NORM_POS_LE, COMPONENT_LE_NORM],
        REWRITE_TAC [LIFT_SUM] THEN MATCH_MP_TAC LIM_NULL_VSUM THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, IN_NUMSEG, ← GSYM LIM_NULL_NORM, o_DEF]]]))

  let LIM_NULL_MATRIX_ONORM ← prove
   r"!net A:A->real^M^N.
        ((\a. lift(onorm(\x. A a ** x))) --> vec 0) net <=>
        !x. ((\a. A a ** x) --> vec 0) net"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"net:A net", ← q r"\a x:real^M. (A:A->real^M^N) a ** x"]
     LIM_NULL_ONORM) THEN
    REWRITE_TAC [MATRIX_VECTOR_MUL_LINEAR])

  let LIM_NULL_MATRIX_ONORM_COMPONENTWISE ← prove
   r"!net A:A->real^M^N.
        ((\a. lift(onorm(\x. A a ** x))) --> vec 0) net <=>
        !i j. 1 <= i /\ i <= dimindex(:N) /\
              1 <= j /\ j <= dimindex(:M)
              ==> ((\a. lift(A a$i$j)) --> vec 0) net"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"net:A net", ← q r"\a x:real^M. (A:A->real^M^N) a ** x"]
     LIM_NULL_ONORM_COMPONENTWISE) THEN
    REWRITE_TAC [MATRIX_VECTOR_MUL_LINEAR] THEN
    DISCH_THEN SUBST1_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [LIM_COMPONENTWISE_LIFT] THEN
    SIMP_TAC [MATRIX_VECTOR_MUL_BASIS, column, LAMBDA_BETA] THEN
    REWRITE_TAC [VEC_COMPONENT, LIFT_NUM] THEN MESON_TAC [])

  let LIM_NULL_ONORM ← prove
   r"!net f:A->real^M->real^N g:real^M->real^N.
        (!a. linear(f a)) /\ linear g /\
        ((\a. lift(onorm(\x. f a x - g x))) --> vec 0) net
        ==> ((\a. lift(onorm(f a))) --> lift(onorm g)) net"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    GEN_REWRITE_TAC RAND_CONV [LIM_NULL] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_NULL_COMPARISON) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"a:A") THEN
    REWRITE_TAC [NORM_1, DROP_SUB, LIFT_DROP] THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"f <= g + d /\ g <= f + d ==> abs(f - g) <= d")) THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← GSYM ONORM_NEG] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV o LAND_CONV) [← GSYM ONORM_NEG] THEN
    CONJ_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand) ONORM_TRIANGLE o rand o snd) THEN
    ASM_SIMP_TAC [LINEAR_COMPOSE_SUB, LINEAR_COMPOSE_NEG, ETA_AX] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN CONV_TAC (fun t => VECTOR_ARITH t))

  let LIM_MATRIX_COMPONENTWISE ← prove
   r"!net A:A->real^M^N B.
        (!x. ((\a. A a ** x) --> B ** x) net) <=>
        !i j. 1 <= i /\ i <= dimindex(:N) /\
              1 <= j /\ j <= dimindex(:M)
              ==> ((\a. lift(A a$i$j)) --> lift(B$i$j)) net"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [LIM_NULL] THEN
    REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_SUB_RDISTRIB] THEN
    REWRITE_TAC [← GSYM LIFT_SUB, ← GSYM MATRIX_SUB_COMPONENT] THEN
    REWRITE_TAC [← GSYM LIM_NULL_MATRIX_ONORM] THEN
    REWRITE_TAC [LIM_NULL_MATRIX_ONORM_COMPONENTWISE])

  let CONTINUOUS_MATRIX_COMPONENTWISE ← prove
   r"!net (A:A->real^M^N).
        (!x. (\a. A a ** x) continuous net) <=>
        !i j. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:M)
              ==> (\a. lift (A a$i$j)) continuous net"
   (REWRITE_TAC [continuous, LIM_MATRIX_COMPONENTWISE])

  let CONTINUOUS_ON_MATRIX_COMPONENTWISE ← prove
   r"!A:real^P->real^M^N s.
        (!x. (\a. A a ** x) continuous_on s) <=>
        !i j. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex (:M)
              ==> (\a. lift (A a$i$j)) continuous_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [CONTINUOUS_MATRIX_COMPONENTWISE] THEN
    MESON_TAC [])

  return { LIM_NULL_ONORM, LIM_NULL_ONORM_COMPONENTWISE, LIM_NULL_MATRIX_ONORM,
           LIM_NULL_MATRIX_ONORM_COMPONENTWISE, LIM_MATRIX_COMPONENTWISE,
           CONTINUOUS_MATRIX_COMPONENTWISE, CONTINUOUS_ON_MATRIX_COMPONENTWISE }

/- ------------------------------------------------------------------------- -/
/- Limits and continuity of matrices as flattened vectors.                 -/
/- (topology.ml 15688-15799)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MFV where
  CONTINUOUS_MATRIX_VECTOR_MUL : thm
  CONTINUOUS_ON_MATRIX_VECTOR_MUL : thm
  CONTINUOUS_MATRIX_MUL : thm
  CONTINUOUS_ON_MATRIX_MUL : thm
  LIM_VECTORIZE_COMPONENTWISE : thm
  CONTINUOUS_VECTORIZE_COMPONENTWISE : thm
  CONTINUOUS_ON_VECTORIZE_COMPONENTWISE : thm
  LINEAR_TRANSP : thm
  LIM_MATRIX_VECTORIZE : thm
  CONTINUOUS_MATRIX_VECTORIZE : thm
  CONTINUOUS_ON_MATRIX_VECTORIZE : thm
  deriving Inhabited

@[nospecialize]
def setupMFV [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) (BCNT1 : CNT1) (BCSL : CSL)
    (BLCP : LCP) (BLLO : LLO) : ExceptT String IO MFV := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, MESON_TAC, .. } := D
  let { DIMINDEX_FINITE_PROD, DIMINDEX_GE_1, DIVISION, .. } := D.core1
  let { LE_1, LE_ADD, LE_MULT_RCANCEL, LE_TRANS, RDIV_LT_EQ, .. } := D.core3
  let { RIGHT_ADD_DISTRIB, RIGHT_FORALL_IMP_THM, .. } := D.core5
  let { SWAP_FORALL_THM, o_THM, .. } := D.core6
  let { MATRIFY_COMPONENT, MATRIFY_VECTORIZE, VECTORIZE_COMPONENT, .. } := D.misc
  let { BILINEAR_MATRIX_MUL, BILINEAR_MATRIX_VECTOR_MUL, .. } := D.vec1
  let { MATRIFY_ADD, MATRIFY_CMUL, .. } := D.vec2
  let { TRANSP_MATRIX_ADD, .. } := D.vec3
  let { TRANSP_MATRIX_CMUL, VECTORIZE_ADD, VECTORIZE_CMUL, linear, .. } := D.vec4
  let { LIM_COMPONENTWISE_LIFT, .. } := BLIM1
  let { continuous, .. } := BCNT1
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  let { BILINEAR_CONTINUOUS_COMPOSE, BILINEAR_CONTINUOUS_ON_COMPOSE, .. } := BLCP
  let { LIM_MATRIX_COMPONENTWISE, .. } := BLLO
  -- @@SCOPE END

  let CONTINUOUS_MATRIX_VECTOR_MUL ← prove
   r"!net A:A->real^N^M v:A->real^N.
        (vectorize o A) continuous net /\ v continuous net
        ==> (\x. (A x) ** (v x)) continuous net"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← MATCH_MP (← REWRITE_RULE
     [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
     BILINEAR_CONTINUOUS_COMPOSE) BILINEAR_MATRIX_VECTOR_MUL)) THEN
    REWRITE_TAC [o_THM, MATRIFY_VECTORIZE])

  let CONTINUOUS_ON_MATRIX_VECTOR_MUL ← prove
   r"!A:real^P->real^N^M v:real^P->real^N s.
        (vectorize o A) continuous_on s /\ v continuous_on s
        ==> (\x. (A x) ** (v x)) continuous_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← MATCH_MP (← REWRITE_RULE
     [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
     BILINEAR_CONTINUOUS_ON_COMPOSE) BILINEAR_MATRIX_VECTOR_MUL)) THEN
    REWRITE_TAC [o_THM, MATRIFY_VECTORIZE])

  let CONTINUOUS_MATRIX_MUL ← prove
   r"!net A:A->real^N^M B:A->real^P^N.
        (vectorize o A) continuous net /\ (vectorize o B) continuous net
        ==> (\x. vectorize((A x) ** (B x))) continuous net"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← MATCH_MP (← REWRITE_RULE
     [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
     BILINEAR_CONTINUOUS_COMPOSE) BILINEAR_MATRIX_MUL)) THEN
    REWRITE_TAC [o_THM, MATRIFY_VECTORIZE])

  let CONTINUOUS_ON_MATRIX_MUL ← prove
   r"!A:real^Q->real^N^M B:real^Q->real^P^N s.
        (vectorize o A) continuous_on s /\ (vectorize o B) continuous_on s
        ==> (\x. vectorize((A x) ** (B x))) continuous_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← MATCH_MP (← REWRITE_RULE
     [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
     BILINEAR_CONTINUOUS_ON_COMPOSE) BILINEAR_MATRIX_MUL)) THEN
    REWRITE_TAC [o_THM, MATRIFY_VECTORIZE])

  let LIM_VECTORIZE_COMPONENTWISE ← prove
   r"!net (A:A->real^N^M) B.
        ((\a. vectorize(A a)) --> vectorize B) net <=>
        !i j. 1 <= i /\ i <= dimindex (:M) /\ 1 <= j /\ j <= dimindex (:N)
              ==> ((\a. lift (A a$i$j)) --> lift (B$i$j)) net"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [LIM_COMPONENTWISE_LIFT] THEN
    REWRITE_TAC [] THEN EQ_TAC THEN DISCH_TAC THENL
     [ONCE_REWRITE_TAC [← GSYM MATRIFY_VECTORIZE] THEN
      SIMP_TAC [MATRIFY_COMPONENT] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      CONJ_TAC THENL [ASM_ARITH_TAC, REWRITE_TAC [DIMINDEX_FINITE_PROD]] THEN
      TRANS_TAC LE_TRANS (← q r"((i - 1) + 1) * dimindex(:N)") THEN
      CONJ_TAC THENL [ASM_ARITH_TAC, REWRITE_TAC [← GSYM RIGHT_ADD_DISTRIB]] THEN
      REWRITE_TAC [LE_MULT_RCANCEL] THEN ASM_ARITH_TAC,
      SIMP_TAC [VECTORIZE_COMPONENT, DIMINDEX_FINITE_PROD] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [LE_ADD] THEN CONJ_TAC THEN
      MATCH_MP_TAC (← ARITH_RULE (← q r"a < b ==> 1 + a <= b")) THEN
      SIMP_TAC [DIVISION, LE_1, DIMINDEX_GE_1, RDIV_LT_EQ] THEN
      ASM_ARITH_TAC])

  let CONTINUOUS_VECTORIZE_COMPONENTWISE ← prove
   r"!net (A:A->real^N^M).
        (\a. vectorize(A a)) continuous net <=>
        !i j. 1 <= i /\ i <= dimindex (:M) /\ 1 <= j /\ j <= dimindex (:N)
              ==> (\a. lift (A a$i$j)) continuous net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous] THEN
    GEN_REWRITE_TAC LAND_CONV [LIM_VECTORIZE_COMPONENTWISE] THEN
    REWRITE_TAC [])

  let CONTINUOUS_ON_VECTORIZE_COMPONENTWISE ← prove
   r"!(A:real^P->real^N^M) s.
        (\a. vectorize(A a)) continuous_on s <=>
        !i j. 1 <= i /\ i <= dimindex (:M) /\ 1 <= j /\ j <= dimindex (:N)
              ==> (\a. lift (A a$i$j)) continuous_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [CONTINUOUS_VECTORIZE_COMPONENTWISE] THEN
    MESON_TAC [])

  let LINEAR_TRANSP ← prove
   r"linear(vectorize o (transp:real^N^M->real^M^N) o matrify)"
   (REWRITE_TAC [linear, o_THM, MATRIFY_ADD, MATRIFY_CMUL] THEN
    REWRITE_TAC [TRANSP_MATRIX_ADD, TRANSP_MATRIX_CMUL] THEN
    REWRITE_TAC [VECTORIZE_ADD, VECTORIZE_CMUL])

  let LIM_MATRIX_VECTORIZE ← prove
   r"!net A:A->real^M^N B.
        (!x. ((\a. A a ** x) --> B ** x) net) <=>
        ((\a. vectorize (A a)) --> vectorize B) net"
   (REWRITE_TAC [LIM_MATRIX_COMPONENTWISE, LIM_VECTORIZE_COMPONENTWISE])

  let CONTINUOUS_MATRIX_VECTORIZE ← prove
   r"!net (A:A->real^N^M).
        (!x. (\a. A a ** x) continuous net) <=>
        (\a. vectorize(A a)) continuous net"
   (REWRITE_TAC [continuous, LIM_MATRIX_VECTORIZE])

  let CONTINUOUS_ON_MATRIX_VECTORIZE ← prove
   r"!A:real^P->real^N^M s.
        (!x. (\a. A a ** x) continuous_on s) <=>
        (\a. vectorize(A a)) continuous_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [CONTINUOUS_MATRIX_VECTORIZE] THEN
    MESON_TAC [])

  return { CONTINUOUS_MATRIX_VECTOR_MUL, CONTINUOUS_ON_MATRIX_VECTOR_MUL, CONTINUOUS_MATRIX_MUL,
           CONTINUOUS_ON_MATRIX_MUL, LIM_VECTORIZE_COMPONENTWISE,
           CONTINUOUS_VECTORIZE_COMPONENTWISE, CONTINUOUS_ON_VECTORIZE_COMPONENTWISE,
           LINEAR_TRANSP, LIM_MATRIX_VECTORIZE, CONTINUOUS_MATRIX_VECTORIZE,
           CONTINUOUS_ON_MATRIX_VECTORIZE }

/- ------------------------------------------------------------------------- -/
/- Intermediate-value formulations; mapping connected sets onto segments;  -/
/- monotone convergence; cardinality invariance.  (topology.ml 15800-15991)  -/
/- ------------------------------------------------------------------------- -/

structure IVT where
  CONNECTED_IVT_HYPERPLANE : thm
  CONNECTED_IVT_COMPONENT : thm
  MAPPING_CONNECTED_ONTO_SEGMENT : thm
  BOUNDED_INCREASING_CONVERGENT : thm
  BOUNDED_DECREASING_CONVERGENT : thm
  deriving Inhabited

@[nospecialize]
def setupIVT [HolBase] (D : TopologyDeps) (BSEG : SEG) (BCON : CON) (BLIM2 : LIM2) (BARI : ARI)
    (BBND1 : BND1) (BCMS : CMS) (BLCP : LCP) (BHSP : HSP) (BLFR : LFR) (BSMI : SMI) :
    ExceptT String IO IVT := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE, VECTOR_ARITH, NORM_ARITH,
        add_linear_invariants, add_translation_invariants, .. } := D
  let { ARITH_LE, CONTRAPOS_THM, DIMINDEX_1, ETA_AX, EXISTS_IN_IMAGE, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, IN_ELIM_THM, IN_IMAGE, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, NOT_EXISTS_THM,
        NOT_IN_EMPTY, REAL_ADD_RID, .. } := D.core3
  let { REAL_DIV_REFL, REAL_LE_ANTISYM, REAL_LE_LDIV_EQ, REAL_LE_NEG2, REAL_LE_RDIV_EQ,
        REAL_LE_REFL, REAL_LE_TOTAL, REAL_LE_TRANS, REAL_LT_LE, .. } := D.core4
  let { SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LE, ge_c, gt_c, o_DEF, real_div, real_gt, .. } := D.core6
  let { CARD_EQ_CONG, CARD_EQ_IMAGE, CARD_EQ_REFL, CARD_LE_CONG, CARD_LT_CONG, .. } := D.lib1
  let { CONVERGENT_BOUNDED_MONOTONE, .. } := D.misc
  let { DIST_EQ_0, DIST_REFL, DOT_BASIS, DROP_NEG, DROP_SUB, EXISTS_DROP, .. } := D.vec1
  let { LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, .. } := D.vec2
  let { NORM_1, NORM_NEG, .. } := D.vec3
  let { VECTOR_NEG_NEG, VEC_COMPONENT, dist, drop, .. } := D.vec4
  let { segment, .. } := BSEG
  let { connected, .. } := BCON
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_NEG_EQ, .. } := BARI
  let { bounded, .. } := BBND1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONNECTED_CONTINUOUS_IMAGE, .. } := BLCP
  let { OPEN_HALFSPACE_GT, OPEN_HALFSPACE_LT, .. } := BHSP
  let { CONTINUOUS_ON_LIFT_DIST, .. } := BLFR
  let { CONTINUOUS_ON_INV, CONTINUOUS_ON_MUL, .. } := BSMI
  -- @@SCOPE END

  let CONNECTED_IVT_HYPERPLANE ← prove
   r"!s x y:real^N a b.
        connected s /\
        x IN s /\ y IN s /\ a dot x <= b /\ b <= a dot y
        ==> ?z. z IN s /\ a dot z = b"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [connected]) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_THEN (MP_TAC o SPECL
     [← q r"{x:real^N | a dot x < b}", ← q r"{x:real^N | a dot x > b}"]) THEN
    REWRITE_TAC [OPEN_HALFSPACE_LT, OPEN_HALFSPACE_GT] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTER, NOT_IN_EMPTY, SUBSET,
                 IN_UNION, REAL_LT_LE, real_gt] THEN
    ASM_MESON_TAC [REAL_LE_TOTAL, REAL_LE_ANTISYM])

  let CONNECTED_IVT_COMPONENT ← prove
   r"!s x y:real^N a k.
        connected s /\ x IN s /\ y IN s /\
        1 <= k /\ k <= dimindex(:N) /\ x$k <= a /\ a <= y$k
        ==> ?z. z IN s /\ z$k = a"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"s:real^N->bool", ← q r"x:real^N", ← q r"y:real^N", ← q r"(basis k):real^N",
      ← q r"a:real"] CONNECTED_IVT_HYPERPLANE) THEN
    ASM_SIMP_TAC [DOT_BASIS])

  let MAPPING_CONNECTED_ONTO_SEGMENT ← prove
   r"!s:real^M->bool a b:real^N.
        connected s /\ ~(?a. s SUBSET {a})
        ==> ?f. f continuous_on s /\ IMAGE f s = segment[a,b]"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(?a. s SUBSET {a}) ==> ?a b. a IN s /\ b IN s /\ ~(a = b)"))) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^M", ← q r"v:real^M"] THEN STRIP_TAC THEN EXISTS_TAC
     (← q r"\x:real^M. a + dist(u,x) / (dist(u,x) + dist(v,x)) % (b - a:real^N)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN SIMP_TAC [o_DEF, CONTINUOUS_ON_CONST],
      REWRITE_TAC [segment, ← VECTOR_ARITH
       (← q r"(&1 - u) % a + u % b:real^N = a + u % (b - a)")] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"IMAGE f s = {x | P x}
        ==> IMAGE (\x. a + f x % b) s = {a + u % b:real^N | P u}")) THEN
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [IN_ELIM_THM, REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ,
        ← NORM_ARITH (← q r"~(u:real^N = v) ==> &0 < dist(u,x) + dist(v,x)")] THEN
      CONJ_TAC THENL [CONV_TAC (fun t => NORM_ARITH t), REWRITE_TAC [IN_IMAGE]] THEN
      X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"IMAGE (\x:real^M. lift(dist(u,x) / (dist(u,x) + dist(v,x)))) s",
        ← q r"vec 0:real^1", ← q r"vec 1:real^1", ← q r"t:real", ← q r"1"]
          CONNECTED_IVT_COMPONENT) THEN
      ASM_SIMP_TAC [VEC_COMPONENT, DIMINDEX_1, ARITH_LE] THEN
      REWRITE_TAC [EXISTS_IN_IMAGE, ← GSYM drop, LIFT_DROP] THEN
      ANTS_TAC THENL [REWRITE_TAC [IN_IMAGE], MESON_TAC []] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [],
        EXISTS_TAC (← q r"u:real^M") THEN ASM_REWRITE_TAC [DIST_REFL, real_div] THEN
        REWRITE_TAC [← GSYM LIFT_NUM, LIFT_EQ] THEN REAL_ARITH_TAC,
        EXISTS_TAC (← q r"v:real^M") THEN ASM_REWRITE_TAC [DIST_REFL] THEN
        ASM_SIMP_TAC [REAL_DIV_REFL, DIST_EQ_0, REAL_ADD_RID] THEN
        REWRITE_TAC [← GSYM LIFT_NUM, LIFT_EQ]]] THEN
    REWRITE_TAC [real_div, LIFT_CMUL] THEN
    MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
    REWRITE_TAC [CONTINUOUS_ON_LIFT_DIST] THEN
    MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
    ASM_SIMP_TAC [LIFT_ADD, ← NORM_ARITH
     (← q r"~(u:real^N = v) ==> ~(dist(u,x) + dist(v,x) = &0)")] THEN
    MATCH_MP_TAC CONTINUOUS_ON_ADD THEN
    REWRITE_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_ON_LIFT_DIST])

  let BOUNDED_INCREASING_CONVERGENT ← prove
   r"!s:num->real^1.
        bounded {s n | n IN (:num)} /\ (!n. drop(s n) <= drop(s(SUC n)))
        ==> ?l. (s --> l) sequentially"
   (GEN_TAC THEN
    REWRITE_TAC [bounded, IN_ELIM_THM, NORM_1, LIM_SEQUENTIALLY, dist,
                 DROP_SUB, IN_UNIV, ← GSYM EXISTS_DROP] THEN
    DISCH_TAC THEN MATCH_MP_TAC CONVERGENT_BOUNDED_MONOTONE THEN
    REWRITE_TAC [LEFT_EXISTS_AND_THM] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    DISJ1_TAC THEN MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
    ASM_REWRITE_TAC [REAL_LE_TRANS, REAL_LE_REFL])

  let BOUNDED_DECREASING_CONVERGENT ← prove
   r"!s:num->real^1.
        bounded {s n | n IN (:num)} /\ (!n. drop(s(SUC n)) <= drop(s(n)))
        ==> ?l. (s --> l) sequentially"
   (GEN_TAC THEN REWRITE_TAC [bounded, FORALL_IN_GSPEC] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"\n. --((s:num->real^1) n)") BOUNDED_INCREASING_CONVERGENT) THEN
    ASM_SIMP_TAC [bounded, FORALL_IN_GSPEC, NORM_NEG, DROP_NEG, REAL_LE_NEG2] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [← GSYM LIM_NEG_EQ] THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ETA_AX] THEN MESON_TAC [])

  -- let card_translation_invariants = (CONJUNCTS o prove) (...) in
  -- add_translation_invariants card_translation_invariants;;
  do
    let card_translation_invariants := CONJUNCTS (← prove
     r"(!a (s:real^N->bool) (t:A->bool).
       IMAGE (\x. a + x) s =_c t <=> s =_c t) /\
     (!a (s:A->bool) (t:real^N->bool).
       s =_c IMAGE (\x. a + x) t <=> s =_c t) /\
     (!a (s:real^N->bool) (t:A->bool).
       IMAGE (\x. a + x) s <_c t <=> s <_c t) /\
     (!a (s:A->bool) (t:real^N->bool).
       s <_c IMAGE (\x. a + x) t <=> s <_c t) /\
     (!a (s:real^N->bool) (t:A->bool).
       IMAGE (\x. a + x) s <=_c t <=> s <=_c t) /\
     (!a (s:A->bool) (t:real^N->bool).
       s <=_c IMAGE (\x. a + x) t <=> s <=_c t) /\
     (!a (s:real^N->bool) (t:A->bool).
       IMAGE (\x. a + x) s >_c t <=> s >_c t) /\
     (!a (s:A->bool) (t:real^N->bool).
       s >_c IMAGE (\x. a + x) t <=> s >_c t) /\
     (!a (s:real^N->bool) (t:A->bool).
       IMAGE (\x. a + x) s >=_c t <=> s >=_c t) /\
     (!a (s:A->bool) (t:real^N->bool).
       s >=_c IMAGE (\x. a + x) t <=> s >=_c t)"
     (REWRITE_TAC [gt_c, ge_c] THEN REPEAT STRIP_TAC THENL
       [MATCH_MP_TAC CARD_EQ_CONG,
        MATCH_MP_TAC CARD_EQ_CONG,
        MATCH_MP_TAC CARD_LT_CONG,
        MATCH_MP_TAC CARD_LT_CONG,
        MATCH_MP_TAC CARD_LE_CONG,
        MATCH_MP_TAC CARD_LE_CONG,
        MATCH_MP_TAC CARD_LT_CONG,
        MATCH_MP_TAC CARD_LT_CONG,
        MATCH_MP_TAC CARD_LE_CONG,
        MATCH_MP_TAC CARD_LE_CONG] THEN
      REWRITE_TAC [CARD_EQ_REFL] THEN MATCH_MP_TAC CARD_EQ_IMAGE THEN
      SIMP_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")]))
    add_translation_invariants card_translation_invariants

  -- let card_linear_invariants = (CONJUNCTS o prove) (...) in
  -- add_linear_invariants card_linear_invariants;;
  do
    let card_linear_invariants := CONJUNCTS (← prove
     r"(!(f:real^M->real^N) s (t:A->bool).
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (IMAGE f s =_c t <=> s =_c t)) /\
     (!(f:real^M->real^N) (s:A->bool) t.
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (s =_c IMAGE f t <=> s =_c t)) /\
     (!(f:real^M->real^N) s (t:A->bool).
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (IMAGE f s <_c t <=> s <_c t)) /\
     (!(f:real^M->real^N) (s:A->bool) t.
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (s <_c IMAGE f t <=> s <_c t)) /\
     (!(f:real^M->real^N) s (t:A->bool).
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (IMAGE f s <=_c t <=> s <=_c t)) /\
     (!(f:real^M->real^N) (s:A->bool) t.
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (s <=_c IMAGE f t <=> s <=_c t)) /\
     (!(f:real^M->real^N) s (t:A->bool).
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (IMAGE f s >_c t <=> s >_c t)) /\
     (!(f:real^M->real^N) (s:A->bool) t.
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (s >_c IMAGE f t <=> s >_c t)) /\
     (!(f:real^M->real^N) s (t:A->bool).
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (IMAGE f s >=_c t <=> s >=_c t)) /\
     (!(f:real^M->real^N) (s:A->bool) t.
       linear f /\ (!x y. f x = f y ==> x = y)
       ==> (s >=_c IMAGE f t <=> s >=_c t))"
     (REWRITE_TAC [gt_c, ge_c] THEN REPEAT STRIP_TAC THENL
       [MATCH_MP_TAC CARD_EQ_CONG,
        MATCH_MP_TAC CARD_EQ_CONG,
        MATCH_MP_TAC CARD_LT_CONG,
        MATCH_MP_TAC CARD_LT_CONG,
        MATCH_MP_TAC CARD_LE_CONG,
        MATCH_MP_TAC CARD_LE_CONG,
        MATCH_MP_TAC CARD_LT_CONG,
        MATCH_MP_TAC CARD_LT_CONG,
        MATCH_MP_TAC CARD_LE_CONG,
        MATCH_MP_TAC CARD_LE_CONG] THEN
      REWRITE_TAC [CARD_EQ_REFL] THEN MATCH_MP_TAC CARD_EQ_IMAGE THEN
      ASM_MESON_TAC []))
    add_linear_invariants card_linear_invariants

  return { CONNECTED_IVT_HYPERPLANE, CONNECTED_IVT_COMPONENT, MAPPING_CONNECTED_ONTO_SEGMENT,
           BOUNDED_INCREASING_CONVERGENT, BOUNDED_DECREASING_CONVERGENT }

/- ------------------------------------------------------------------------- -/
/- Basic homeomorphism definitions.  (topology.ml 15992-16174)               -/
/- ------------------------------------------------------------------------- -/

structure HMA where
  homeomorphism : thm
  homeomorphic : thm
  HOMEOMORPHISM : thm
  HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY : thm
  HOMEOMORPHIC_SPACE_EUCLIDEAN : thm
  HOMEOMORPHISM_IMP_HOMEOMORPHIC : thm
  HOMEOMORPHISM_OF_SUBSETS : thm
  HOMEOMORPHISM_OF_SUBSETS_ALT : thm
  HOMEOMORPHISM_ID : thm
  HOMEOMORPHISM_I : thm
  HOMEOMORPHIC_REFL : thm
  HOMEOMORPHISM_SYM : thm
  HOMEOMORPHIC_SYM : thm
  HOMEOMORPHISM_COMPOSE : thm
  HOMEOMORPHIC_TRANS : thm
  HOMEOMORPHISM_EQ : thm
  LINEAR_IMP_HOMEOMORPHISM : thm
  ORTHOGONAL_TRANSFORMATION_IMP_HOMEOMORPHISM : thm
  HOMEOMORPHIC_SELF_IMAGE : thm
  HOMEOMORPHIC_IMP_CARD_EQ : thm
  HOMEOMORPHIC_FINITENESS : thm
  HOMEOMORPHISM_FINITENESS : thm
  HOMEOMORPHIC_INFINITENESS : thm
  HOMEOMORPHISM_INFINITENESS : thm
  HOMEOMORPHIC_COUNTABILITY : thm
  deriving Inhabited

@[nospecialize]
def setupHMA [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCNO : CNO) (BCSL : CSL) (BIDC : IDC)
    (BLCP : LCP) : ExceptT String IO HMA := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { FUN_EQ_THM, IMAGE_ID, IMAGE_o, IMP_CONJ, INFINITE, .. } := D.core2
  let { I_DEF, I_THM, MONO_EXISTS, .. } := D.core3
  let { SWAP_EXISTS_THM, eq_c, o_THM, .. } := D.core6
  let { CARD_COUNTABLE_CONG, CARD_FINITE_CONG, .. } := D.lib1
  let { ORTHOGONAL_TRANSFORMATION_INVERSE_o, ORTHOGONAL_TRANSFORMATION_LINEAR, .. } := D.det
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := D.met1
  let { homeomorphic_maps, homeomorphic_space, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CONTINUOUS_MAP_EUCLIDEAN, .. } := BCNO
  let { CONTINUOUS_ON_EQ, CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, .. } := BIDC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  -- @@SCOPE END

  let homeomorphism ← new_definition
   r"homeomorphism (s,t) (f,g) <=>
     (!x. x IN s ==> (g(f(x)) = x)) /\ (IMAGE f s = t) /\ f continuous_on s /\
     (!y. y IN t ==> (f(g(y)) = y)) /\ (IMAGE g t = s) /\ g continuous_on t"

  parse_as_infix ("homeomorphic", (12, "right"))

  let homeomorphic ← new_definition
   r"s homeomorphic t <=> ?f g. homeomorphism (s,t) (f,g)"

  let HOMEOMORPHISM ← prove
   r"!s:real^M->bool t:real^N->bool f g.
        homeomorphism (s,t) (f,g) <=>
         f continuous_on s /\ IMAGE f s SUBSET t /\
         g continuous_on t /\ IMAGE g t SUBSET s /\
         (!x. x IN s ==> g (f x) = x) /\
         (!y. y IN t ==> f (g y) = y)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphism] THEN
    EQ_TAC THEN SIMP_TAC [] THEN SET_TAC [])

  let HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY ← prove
   r"!f:real^M->real^N g s t.
        homeomorphic_maps
          (subtopology euclidean s,subtopology euclidean t)
          (f,g) <=>
        homeomorphism (s,t) (f,g)"
   (REWRITE_TAC [homeomorphic_maps, homeomorphism] THEN
    REWRITE_TAC [← GSYM CONTINUOUS_MAP_EUCLIDEAN] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    SET_TAC [])

  let HOMEOMORPHIC_SPACE_EUCLIDEAN ← prove
   r"!(s:real^M->bool) (t:real^N->bool).
     (subtopology euclidean s) homeomorphic_space (subtopology euclidean t) <=>
     s homeomorphic t"
   (REWRITE_TAC [homeomorphic, homeomorphic_space,
                 HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY])

  let HOMEOMORPHISM_IMP_HOMEOMORPHIC ← prove
   r"!f:real^M->real^N g s t. homeomorphism (s,t) (f,g) ==> s homeomorphic t"
   (REWRITE_TAC [homeomorphic] THEN MESON_TAC [])

  let HOMEOMORPHISM_OF_SUBSETS ← prove
   r"!f g s t s' t'.
    homeomorphism (s,t) (f,g) /\ s' SUBSET s /\ t' SUBSET t /\ IMAGE f s' = t'
    ==> homeomorphism (s',t') (f,g)"
   (REWRITE_TAC [homeomorphism] THEN
    REPEAT STRIP_TAC THEN
    TRY (MATCH_MP_TAC CONTINUOUS_ON_SUBSET) THEN ASM SET_TAC [])

  let HOMEOMORPHISM_OF_SUBSETS_ALT ← prove
   r"!f:real^M->real^N g s t s' t'.
        homeomorphism (s,t) (f,g) /\
        s' SUBSET s /\
        t' SUBSET t /\
        (!x. x IN s ==> (f x IN t' <=> x IN s'))
        ==> homeomorphism (s',t') (f,g)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_OF_SUBSETS)) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← liftExcept (el 1 (CONJUNCTS (← REWRITE_RULE [homeomorphism] th)))))) THEN
    ASM SET_TAC [])

  let HOMEOMORPHISM_ID ← prove
   r"!s:real^N->bool. homeomorphism (s,s) ((\x. x),(\x. x))"
   (REWRITE_TAC [homeomorphism, IMAGE_ID, CONTINUOUS_ON_ID])

  let HOMEOMORPHISM_I ← prove
   r"!s:real^N->bool. homeomorphism (s,s) (I,I)"
   (REWRITE_TAC [I_DEF, HOMEOMORPHISM_ID])

  let HOMEOMORPHIC_REFL ← prove
   r"!s:real^N->bool. s homeomorphic s"
   (REWRITE_TAC [homeomorphic] THEN MESON_TAC [HOMEOMORPHISM_I])

  let HOMEOMORPHISM_SYM ← prove
   r"!f:real^M->real^N g s t.
        homeomorphism (s,t) (f,g) <=> homeomorphism (t,s) (g,f)"
   (REWRITE_TAC [homeomorphism] THEN MESON_TAC [])

  let HOMEOMORPHIC_SYM ← prove
   r"!s t. s homeomorphic t <=> t homeomorphic s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic, homeomorphism] THEN
    GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN CONV_TAC (fun t => TAUT t))

  let HOMEOMORPHISM_COMPOSE ← prove
   r"!f:real^M->real^N g h:real^N->real^P k s t u.
        homeomorphism (s,t) (f,g) /\ homeomorphism (t,u) (h,k)
        ==> homeomorphism (s,u) (h o f,g o k)"
   (SIMP_TAC [homeomorphism, CONTINUOUS_ON_COMPOSE, IMAGE_o, o_THM] THEN
    SET_TAC [])

  let HOMEOMORPHIC_TRANS ← prove
   r"!s:real^M->bool t:real^N->bool u:real^P->bool.
        s homeomorphic t /\ t homeomorphic u ==> s homeomorphic u"
   (REWRITE_TAC [homeomorphic] THEN MESON_TAC [HOMEOMORPHISM_COMPOSE])

  let HOMEOMORPHISM_EQ ← prove
   r"!f:real^M->real^N g f' g' s t.
        homeomorphism (s,t) (f,g) /\
        (!x. x IN s ==> f' x = f x) /\
        (!y. y IN t ==> g' y = g y)
        ==> homeomorphism (s,t) (f',g')"
   (REWRITE_TAC [HOMEOMORPHISM] THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_ON_EQ],
      ASM SET_TAC [],
      ASM_MESON_TAC [CONTINUOUS_ON_EQ],
      ASM SET_TAC [], ASM SET_TAC [], ASM SET_TAC []])

  let LINEAR_IMP_HOMEOMORPHISM ← prove
   r"!f:real^M->real^N g:real^N->real^M s t.
        linear f /\ linear g /\ g o f = I /\ IMAGE f s = t
        ==> homeomorphism (s,t) (f,g)"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC
     (LAND_CONV o RAND_CONV o RAND_CONV o LAND_CONV) [FUN_EQ_THM] THEN
    REWRITE_TAC [o_THM, I_THM] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [homeomorphism, LINEAR_CONTINUOUS_ON] THEN ASM SET_TAC [])

  let ORTHOGONAL_TRANSFORMATION_IMP_HOMEOMORPHISM ← prove
   r"!f:real^N->real^N s t.
        orthogonal_transformation f /\ IMAGE f s = t
        ==> ?g. orthogonal_transformation g /\
                homeomorphism (s,t) (f,g)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ORTHOGONAL_TRANSFORMATION_INVERSE_o) THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [ORTHOGONAL_TRANSFORMATION_LINEAR, LINEAR_IMP_HOMEOMORPHISM])

  let HOMEOMORPHIC_SELF_IMAGE ← prove
   r"!f:real^M->real^N g s t u.
        homeomorphism (s,t) (f,g) /\ u SUBSET s
        ==> IMAGE f u homeomorphic u"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
    REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_IMP_CARD_EQ ← prove
   r"!s:real^M->bool t:real^N->bool. s homeomorphic t ==> s =_c t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic, homeomorphism, eq_c] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [])

  let HOMEOMORPHIC_FINITENESS ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t ==> (FINITE s <=> FINITE t)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_IMP_CARD_EQ) THEN
    DISCH_THEN (ACCEPT_TAC o MATCH_MP CARD_FINITE_CONG))

  let HOMEOMORPHISM_FINITENESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (FINITE(IMAGE f k) <=> FINITE k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_FINITENESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_INFINITENESS ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t ==> (INFINITE s <=> INFINITE t)"
   (REWRITE_TAC [INFINITE] THEN MESON_TAC [HOMEOMORPHIC_FINITENESS])

  let HOMEOMORPHISM_INFINITENESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (INFINITE(IMAGE f k) <=> INFINITE k)"
   (REWRITE_TAC [INFINITE] THEN MESON_TAC [HOMEOMORPHISM_FINITENESS])

  let HOMEOMORPHIC_COUNTABILITY ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t ==> (COUNTABLE s <=> COUNTABLE t)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_IMP_CARD_EQ) THEN
    DISCH_THEN (ACCEPT_TAC o MATCH_MP CARD_COUNTABLE_CONG))

  return { homeomorphism, homeomorphic, HOMEOMORPHISM, HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY,
           HOMEOMORPHIC_SPACE_EUCLIDEAN, HOMEOMORPHISM_IMP_HOMEOMORPHIC,
           HOMEOMORPHISM_OF_SUBSETS, HOMEOMORPHISM_OF_SUBSETS_ALT, HOMEOMORPHISM_ID,
           HOMEOMORPHISM_I, HOMEOMORPHIC_REFL, HOMEOMORPHISM_SYM, HOMEOMORPHIC_SYM,
           HOMEOMORPHISM_COMPOSE, HOMEOMORPHIC_TRANS, HOMEOMORPHISM_EQ, LINEAR_IMP_HOMEOMORPHISM,
           ORTHOGONAL_TRANSFORMATION_IMP_HOMEOMORPHISM, HOMEOMORPHIC_SELF_IMAGE,
           HOMEOMORPHIC_IMP_CARD_EQ, HOMEOMORPHIC_FINITENESS, HOMEOMORPHISM_FINITENESS,
           HOMEOMORPHIC_INFINITENESS, HOMEOMORPHISM_INFINITENESS, HOMEOMORPHIC_COUNTABILITY }

/- ------------------------------------------------------------------------- -/
/- Basic homeomorphism results, continued.  (topology.ml 16175-16362)        -/
/- ------------------------------------------------------------------------- -/

structure HMB where
  HOMEOMORPHISM_COUNTABILITY : thm
  HOMEOMORPHIC_EMPTY : thm
  HOMEOMORPHIC_MINIMAL : thm
  HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF : thm
  HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ : thm
  HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ : thm
  HOMEOMORPHIC_TRANSLATION_SELF : thm
  HOMEOMORPHIC_TRANSLATION_LEFT_EQ : thm
  HOMEOMORPHIC_TRANSLATION_RIGHT_EQ : thm
  INVOLUTION_IMP_HOMEOMORPHISM_GEN : thm
  INVOLUTION_IMP_HOMEOMORPHISM : thm
  HOMEOMORPHISM_IMP_QUOTIENT_MAP : thm
  HOMEOMORPHIC_PCROSS : thm
  HOMEOMORPHIC_PCROSS_SYM : thm
  HOMEOMORPHIC_PCROSS_ASSOC : thm
  deriving Inhabited

@[nospecialize]
def setupHMB [HolBase] (D : TopologyDeps) (BCNO : CNO) (BCSL : CSL) (BCMS : CMS) (BIDC : IDC)
    (BLCP : LCP) (BQUO1 : QUO1) (BPCA1 : PCA1) (BHMA : HMA) : ExceptT String IO HMB := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, REAL_ARITH, SET_TAC, add_linear_invariants, add_translation_invariants, .. } :=
    D
  let { CONJ_ASSOC, EQ_IMP, EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FSTCART_PASTECART, FUN_IN_IMAGE, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, IMP_CONJ, IMP_IMP, INJECTIVE_LEFT_INVERSE, IN_IMAGE, .. } := D.core2
  let { MONO_EXISTS, NOT_IN_EMPTY, PASTECART_INJ, PASTECART_IN_PCROSS, .. } := D.core3
  let { REAL_LE_RDIV_EQ, REAL_LT_LDIV_EQ, REAL_LT_MUL, .. } := D.core4
  let { RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL, .. } :=
    D.core5
  let { UNION_SUBSET, o_DEF, .. } := D.core6
  let { LINEAR_COMPOSE, LINEAR_FSTCART, LINEAR_INJECTIVE_BOUNDED_BELOW_POS, LINEAR_PASTECART,
        LINEAR_SNDCART, LINEAR_SUB, .. } := D.vec2
  let { VECTOR_ADD_SUB, dist, .. } := D.vec4
  let { continuous_on, .. } := BCNO
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, .. } := BIDC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP, .. } := BQUO1
  let { CONTINUOUS_ON_PASTECART, .. } := BPCA1
  let { HOMEOMORPHIC_COUNTABILITY, HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM,
        HOMEOMORPHISM_OF_SUBSETS, homeomorphic, homeomorphism, .. } := BHMA
  -- @@SCOPE END

  let HOMEOMORPHISM_COUNTABILITY ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (COUNTABLE(IMAGE f k) <=> COUNTABLE k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_COUNTABILITY THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_EMPTY ← prove
   r"(!s. (s:real^N->bool) homeomorphic ({}:real^M->bool) <=> s = {}) /\
   (!s. ({}:real^M->bool) homeomorphic (s:real^N->bool) <=> s = {})"
   (REWRITE_TAC [homeomorphic, homeomorphism, IMAGE_CLAUSES, IMAGE_EQ_EMPTY] THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [continuous_on, NOT_IN_EMPTY])

  let HOMEOMORPHIC_MINIMAL ← prove
   r"!s t. s homeomorphic t <=>
            ?f g. (!x. x IN s ==> f(x) IN t /\ (g(f(x)) = x)) /\
                  (!y. y IN t ==> g(y) IN s /\ (f(g(y)) = y)) /\
                  f continuous_on s /\ g continuous_on t"
   (REWRITE_TAC [homeomorphic, homeomorphism, EXTENSION, IN_IMAGE] THEN
    REPEAT GEN_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN MESON_TAC [])

  let HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (IMAGE f s) homeomorphic s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INJECTIVE_LEFT_INVERSE]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"f:real^M->real^N") THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, FORALL_IN_IMAGE, FUN_IN_IMAGE] THEN
    ASM_SIMP_TAC [continuous_on, IMP_CONJ, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_BOUNDED_BELOW_POS) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"e * B:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    X_GEN_TAC (← q r"y:real^M") THEN ASM_SIMP_TAC [dist, ← GSYM LINEAR_SUB] THEN
    DISCH_TAC THEN ASM_SIMP_TAC [← GSYM REAL_LT_LDIV_EQ] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> b < x ==> a < x")) THEN
    ASM_SIMP_TAC [REAL_LE_RDIV_EQ])

  let HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ ← prove
   r"!f:real^M->real^N s t.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> ((IMAGE f s) homeomorphic t <=> s homeomorphic t)"
   (REPEAT GEN_TAC THEN DISCH_THEN (ASSUME_TAC o SPEC (← q r"s:real^M->bool") o
      MATCH_MP HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF) THEN
    EQ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_SYM]),
      POP_ASSUM MP_TAC] THEN
    REWRITE_TAC [IMP_IMP, HOMEOMORPHIC_TRANS])

  let HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ ← prove
   r"!f:real^M->real^N s t.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (s homeomorphic (IMAGE f t) <=> s homeomorphic t)"
   (ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
    REWRITE_TAC [HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ])

  add_linear_invariants
    [HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ,
     HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ]

  let HOMEOMORPHIC_TRANSLATION_SELF ← prove
   r"!a:real^N s. (IMAGE (\x. a + x) s) homeomorphic s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
    EXISTS_TAC (← q r"\x:real^N. x - a") THEN
    EXISTS_TAC (← q r"\x:real^N. a + x") THEN
    SIMP_TAC [FORALL_IN_IMAGE, CONTINUOUS_ON_SUB, CONTINUOUS_ON_ID,
              CONTINUOUS_ON_CONST, CONTINUOUS_ON_ADD, VECTOR_ADD_SUB] THEN
    REWRITE_TAC [IN_IMAGE] THEN MESON_TAC [])

  let HOMEOMORPHIC_TRANSLATION_LEFT_EQ ← prove
   r"!a:real^N s t.
      (IMAGE (\x. a + x) s) homeomorphic t <=> s homeomorphic t"
   (MESON_TAC [HOMEOMORPHIC_TRANSLATION_SELF,
               HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS])

  let HOMEOMORPHIC_TRANSLATION_RIGHT_EQ ← prove
   r"!a:real^N s t.
      s homeomorphic (IMAGE (\x. a + x) t) <=> s homeomorphic t"
   (ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
    REWRITE_TAC [HOMEOMORPHIC_TRANSLATION_LEFT_EQ])

  add_translation_invariants
    [HOMEOMORPHIC_TRANSLATION_LEFT_EQ,
     HOMEOMORPHIC_TRANSLATION_RIGHT_EQ]

  let INVOLUTION_IMP_HOMEOMORPHISM_GEN ← prove
   r"!f:real^N->real^N u s.
        f continuous_on u /\
        s UNION IMAGE f s SUBSET u /\
        (!x. x IN s ==> f(f x) = x)
        ==> homeomorphism(s,IMAGE f s) (f,f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHISM, SUBSET_REFL] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN ASM SET_TAC [],
      ASM SET_TAC []])

  let INVOLUTION_IMP_HOMEOMORPHISM ← prove
   r"!f:real^N->real^N s.
        f continuous_on s /\ IMAGE f s SUBSET s /\ (!x. x IN s ==> f(f x) = x)
        ==> homeomorphism(s,s) (f,f)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"s:real^N->bool", ← q r"s:real^N->bool"]
          INVOLUTION_IMP_HOMEOMORPHISM_GEN) THEN
    ASM_REWRITE_TAC [UNION_SUBSET, SUBSET_REFL] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let HOMEOMORPHISM_IMP_QUOTIENT_MAP ← prove
   r"!f:real^M->real^N g s t.
    homeomorphism (s,t) (f,g)
    ==> !u. u SUBSET t
            ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN u} <=>
                 open_in (subtopology euclidean t) u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphism] THEN
    STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP THEN
    EXISTS_TAC (← q r"g:real^N->real^M") THEN ASM_REWRITE_TAC [SUBSET_REFL])

  let HOMEOMORPHIC_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool s':real^P->bool t':real^Q->bool.
        s homeomorphic s' /\ t homeomorphic t'
        ==> (s PCROSS t) homeomorphic (s' PCROSS t')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic, HOMEOMORPHISM] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"f:real^M->real^P")
       (X_CHOOSE_THEN (← q r"f':real^P->real^M") STRIP_ASSUME_TAC))
     (X_CHOOSE_THEN (← q r"g:real^N->real^Q")
       (X_CHOOSE_THEN (← q r"g':real^Q->real^N") STRIP_ASSUME_TAC))) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(\z. pastecart (f(fstcart z)) (g(sndcart z)))
       :real^(M,N)finite_sum->real^(P,Q)finite_sum",
      ← q r"(\z. pastecart (f'(fstcart z)) (g'(sndcart z)))
       :real^(P,Q)finite_sum->real^(M,N)finite_sum"] THEN
    ASM_SIMP_TAC [FORALL_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART,
                  SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS] THEN
    CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
    CONJ_TAC THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [LINEAR_FSTCART, LINEAR_SNDCART, LINEAR_CONTINUOUS_ON] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_PCROSS, SUBSET] THEN
    SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART])

  let HOMEOMORPHIC_PCROSS_SYM ← prove
   r"!s:real^M->bool t:real^N->bool. (s PCROSS t) homeomorphic (t PCROSS s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic, homeomorphism] THEN
    EXISTS_TAC (← q r"(\z. pastecart (sndcart z) (fstcart z))
                :real^(M,N)finite_sum->real^(N,M)finite_sum") THEN
    EXISTS_TAC (← q r"(\z. pastecart (sndcart z) (fstcart z))
                :real^(N,M)finite_sum->real^(M,N)finite_sum") THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_IMAGE] THEN
    SIMP_TAC [CONTINUOUS_ON_PASTECART, LINEAR_CONTINUOUS_ON,
              LINEAR_FSTCART, LINEAR_SNDCART] THEN
    REWRITE_TAC [FORALL_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART,
      IN_IMAGE, EXISTS_PASTECART, PASTECART_INJ, PASTECART_IN_PCROSS] THEN
    MESON_TAC [])

  let HOMEOMORPHIC_PCROSS_ASSOC ← prove
   r"!s:real^M->bool t:real^N->bool u:real^P->bool.
        (s PCROSS (t PCROSS u)) homeomorphic ((s PCROSS t) PCROSS u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic, HOMEOMORPHISM] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\z:real^(M,(N,P)finite_sum)finite_sum.
          pastecart (pastecart (fstcart z) (fstcart(sndcart z)))
                    (sndcart(sndcart z))",
      ← q r"\z:real^((M,N)finite_sum,P)finite_sum.
          pastecart (fstcart(fstcart z))
                    (pastecart (sndcart(fstcart z)) (sndcart z))"] THEN
    REWRITE_TAC [FORALL_IN_PCROSS, SUBSET, FORALL_IN_IMAGE,
                 RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_IN_PCROSS] THEN
    CONJ_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
    REPEAT (MATCH_MP_TAC LINEAR_PASTECART THEN CONJ_TAC) THEN
    TRY (GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC LINEAR_COMPOSE) THEN
    REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART])

  return { HOMEOMORPHISM_COUNTABILITY, HOMEOMORPHIC_EMPTY, HOMEOMORPHIC_MINIMAL,
           HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF, HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ,
           HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ, HOMEOMORPHIC_TRANSLATION_SELF,
           HOMEOMORPHIC_TRANSLATION_LEFT_EQ, HOMEOMORPHIC_TRANSLATION_RIGHT_EQ,
           INVOLUTION_IMP_HOMEOMORPHISM_GEN, INVOLUTION_IMP_HOMEOMORPHISM,
           HOMEOMORPHISM_IMP_QUOTIENT_MAP, HOMEOMORPHIC_PCROSS, HOMEOMORPHIC_PCROSS_SYM,
           HOMEOMORPHIC_PCROSS_ASSOC }

/- ------------------------------------------------------------------------- -/
/- Basic homeomorphism results, continued; domain of a continuous function  -/
/- is homeomorphic to its graph.  (topology.ml 16363-16568)                  -/
/- ------------------------------------------------------------------------- -/

structure HMC where
  HOMEOMORPHIC_SCALING_LEFT : thm
  HOMEOMORPHIC_SCALING_RIGHT : thm
  HOMEOMORPHIC_SUBSPACES : thm
  HOMEOMORPHIC_FINITE : thm
  HOMEOMORPHIC_FINITE_STRONG : thm
  HOMEOMORPHIC_HAS_SIZE : thm
  HOMEOMORPHISM_HAS_SIZE_EQ : thm
  HOMEOMORPHIC_SING : thm
  HOMEOMORPHIC_PCROSS_SING : thm
  LIFT_TO_QUOTIENT_SPACE_UNIQUE : thm
  HOMOEOMORPHISM_PASTE : thm
  HOMEOMORPHISM_GRAPH_EXPLICIT : thm
  HOMEOMORPHISM_GRAPH : thm
  HOMEOMORPHIC_GRAPH : thm
  deriving Inhabited

@[nospecialize]
def setupHMC [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCSL : CSL) (BCMS : CMS) (BIDC : IDC)
    (BLCP : LCP) (BQUO1 : QUO1) (BSPP : SPP) (BPCA1 : PCA1) (BLRU : LRU) (BHMA : HMA)
    (BHMB : HMB) : ExceptT String IO HMC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { CARD_EQ_BIJECTIONS, CARD_SING, ETA_AX, EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FINITE_SING, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_PASTECART,
        FSTCART_PASTECART, HAS_SIZE, IMP_CONJ, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, .. } :=
    D.core2
  let { IN_UNION, MONO_EXISTS, PASTECART_INJ, PASTECART_IN_PCROSS, .. } := D.core3
  let { REAL_LT_IMP_NZ, .. } := D.core4
  let { RIGHT_IMP_FORALL_THM, SNDCART_PASTECART, SUBSET, SUBSET_REFL, .. } := D.core5
  let { o_DEF, o_THM, .. } := D.core6
  let { CARD_EQ_CARD, CARD_FINITE_CONG, .. } := D.lib1
  let { ISOMETRIES_SUBSPACES, LINEAR_FSTCART, LINEAR_SCALING, LINEAR_SNDCART, .. } := D.vec2
  let { VECTOR_MUL_LCANCEL, .. } := D.vec4
  let { OPEN_IN_IMP_SUBSET, .. } := D.met3
  let { IN_CBALL_0, .. } := BBAL
  let { CONTINUOUS_ON_EQ, CONTINUOUS_ON_FINITE, .. } := BCSL
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, CONTINUOUS_ON_OPEN_GEN, .. } := BIDC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { LIFT_TO_QUOTIENT_SPACE, .. } := BQUO1
  let { CONTINUOUS_ON_CASES_LOCAL_OPEN, .. } := BSPP
  let { CONTINUOUS_ON_PASTECART, .. } := BPCA1
  let { CONTINUOUS_ON_CASES_LOCAL, .. } := BLRU
  let { HOMEOMORPHIC_FINITENESS, HOMEOMORPHIC_IMP_CARD_EQ, HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS,
        HOMEOMORPHISM, HOMEOMORPHISM_OF_SUBSETS, homeomorphic, homeomorphism, .. } := BHMA
  let { HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ, HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ,
        HOMEOMORPHIC_PCROSS_SYM, .. } := BHMB
  -- @@SCOPE END

  let HOMEOMORPHIC_SCALING_LEFT ← prove
   r"!c. &0 < c
       ==> !s t. (IMAGE (\x. c % x) s) homeomorphic t <=> s homeomorphic t"
   (REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ THEN
    ASM_SIMP_TAC [VECTOR_MUL_LCANCEL, REAL_LT_IMP_NZ, LINEAR_SCALING])

  let HOMEOMORPHIC_SCALING_RIGHT ← prove
   r"!c. &0 < c
       ==> !s t. s homeomorphic (IMAGE (\x. c % x) t) <=> s homeomorphic t"
   (REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ THEN
    ASM_SIMP_TAC [VECTOR_MUL_LCANCEL, REAL_LT_IMP_NZ, LINEAR_SCALING])

  let HOMEOMORPHIC_SUBSPACES ← prove
   r"!s:real^M->bool t:real^N->bool.
        subspace s /\ subspace t /\ dim s = dim t ==> s homeomorphic t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic, HOMEOMORPHISM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP ISOMETRIES_SUBSPACES) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^M->real^N") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTER, IN_CBALL_0] THEN
    SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN ASM SET_TAC [])

  let HOMEOMORPHIC_FINITE ← prove
   r"!s:real^M->bool t:real^N->bool.
        FINITE s /\ FINITE t ==> (s homeomorphic t <=> CARD s = CARD t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_IMP_CARD_EQ) THEN
      ASM_SIMP_TAC [CARD_EQ_CARD],
      STRIP_TAC THEN REWRITE_TAC [homeomorphic, HOMEOMORPHISM] THEN
      MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"t:real^N->bool"]
          CARD_EQ_BIJECTIONS) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_FINITE] THEN ASM SET_TAC []])

  let HOMEOMORPHIC_FINITE_STRONG ← prove
   r"!s:real^M->bool t:real^N->bool.
        FINITE s \/ FINITE t
        ==> (s homeomorphic t <=> FINITE s /\ FINITE t /\ CARD s = CARD t)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN EQ_TAC THEN
    SIMP_TAC [HOMEOMORPHIC_FINITE] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CARD_FINITE_CONG o MATCH_MP
      HOMEOMORPHIC_IMP_CARD_EQ) THEN
    FIRST_X_ASSUM DISJ_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_FINITE])

  let HOMEOMORPHIC_HAS_SIZE ← prove
   r"!s:real^M->bool t:real^N->bool n.
        s homeomorphic t ==> (s HAS_SIZE n <=> t HAS_SIZE n)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_FINITENESS) THEN
    ASM_CASES_TAC (← q r"FINITE(t:real^N->bool)") THEN ASM_SIMP_TAC [HAS_SIZE] THEN
    DISCH_TAC THEN ASM_MESON_TAC [HOMEOMORPHIC_FINITE])

  let HOMEOMORPHISM_HAS_SIZE_EQ ← prove
   r"!f:real^M->real^N g s t k n.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> ((IMAGE f k) HAS_SIZE n <=> k HAS_SIZE n)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_HAS_SIZE THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_SING ← prove
   r"!a:real^M b:real^N. {a} homeomorphic {b}"
   (SIMP_TAC [HOMEOMORPHIC_FINITE, FINITE_SING, CARD_SING])

  let HOMEOMORPHIC_PCROSS_SING ← prove
   r"(!s:real^M->bool a:real^N. s homeomorphic (s PCROSS {a})) /\
   (!s:real^M->bool a:real^N. s homeomorphic ({a} PCROSS s))"
   (MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN CONJ_TAC THENL
     [MESON_TAC [HOMEOMORPHIC_PCROSS_SYM, HOMEOMORPHIC_TRANS], ALL_TAC] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic, HOMEOMORPHISM] THEN
    EXISTS_TAC (← q r"\x. (pastecart x a:real^(M,N)finite_sum)") THEN
    EXISTS_TAC (← q r"fstcart:real^(M,N)finite_sum->real^M") THEN
    SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
    SIMP_TAC [LINEAR_FSTCART, LINEAR_CONTINUOUS_ON, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [FORALL_IN_PCROSS, PASTECART_IN_PCROSS, IN_SING] THEN
    SIMP_TAC [FSTCART_PASTECART])

  let LIFT_TO_QUOTIENT_SPACE_UNIQUE ← prove
   r"!f:real^M->real^N g:real^M->real^P s t u.
        IMAGE f s = t /\
        IMAGE g s = u /\
        (!v. v SUBSET t
             ==> (open_in (subtopology euclidean s)
                  {x | x IN s /\ f x IN v} <=>
                  open_in (subtopology euclidean t) v)) /\
         (!v. v SUBSET u
             ==> (open_in (subtopology euclidean s)
                  {x | x IN s /\ g x IN v} <=>
                  open_in (subtopology euclidean u) v)) /\
        (!x y. x IN s /\ y IN s ==> (f x = f y <=> g x = g y))
        ==> t homeomorphic u"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"g:real^M->real^P", ← q r"s:real^M->bool",
      ← q r"t:real^N->bool", ← q r"u:real^P->bool"] LIFT_TO_QUOTIENT_SPACE) THEN
    MP_TAC (← ISPECL
     [← q r"g:real^M->real^P", ← q r"f:real^M->real^N", ← q r"s:real^M->bool",
      ← q r"u:real^P->bool", ← q r"t:real^N->bool"] LIFT_TO_QUOTIENT_SPACE) THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"t:real^N->bool"]
          CONTINUOUS_ON_OPEN_GEN) THEN
    ASM_SIMP_TAC [SUBSET_REFL] THEN DISCH_THEN SUBST1_TAC THEN ANTS_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET],
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^P->real^N") STRIP_ASSUME_TAC)] THEN
    MP_TAC (← ISPECL [← q r"g:real^M->real^P", ← q r"s:real^M->bool", ← q r"u:real^P->bool"]
          CONTINUOUS_ON_OPEN_GEN) THEN
    ASM_SIMP_TAC [SUBSET_REFL] THEN DISCH_THEN SUBST1_TAC THEN ANTS_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET],
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^N->real^P") STRIP_ASSUME_TAC)] THEN
    REWRITE_TAC [homeomorphic, homeomorphism] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"k:real^N->real^P", ← q r"h:real^P->real^N"] THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let HOMOEOMORPHISM_PASTE ← prove
   r"!f:real^M->real^N g f' g' s t s' t'.
        homeomorphism (s,t) (f,g) /\ homeomorphism (s',t') (f',g') /\
        (open_in (subtopology euclidean (s UNION s')) s /\
         open_in (subtopology euclidean (s UNION s')) s' /\
         open_in (subtopology euclidean (t UNION t')) t /\
         open_in (subtopology euclidean (t UNION t')) t' \/
         closed_in (subtopology euclidean (s UNION s')) s /\
         closed_in (subtopology euclidean (s UNION s')) s' /\
         closed_in (subtopology euclidean (t UNION t')) t /\
         closed_in (subtopology euclidean (t UNION t')) t') /\
        (!x. x IN s INTER s' ==> f' x = f x) /\
        (!y. y IN t INTER t' ==> g' y = g y)
        ==> ?h k. homeomorphism (s UNION s',t UNION t') (h,k) /\
                  (!x. x IN s ==> h x = f x) /\ (!x. x IN s' ==> h x = f' x) /\
                  (!y. y IN t ==> k y = g y) /\ (!y. y IN t' ==> k y = g' y) /\
                  IMAGE h s = t /\ IMAGE h s' = t' /\
                  IMAGE k t = s /\ IMAGE k t' = s' /\
                  IMAGE h (s INTER s') = t INTER t' /\
                  IMAGE h (s DIFF s') = t DIFF t' /\
                  IMAGE h (s' DIFF s) = t' DIFF t /\
                  IMAGE k (t INTER t') = s INTER s' /\
                  IMAGE k (t DIFF t') = s DIFF s' /\
                  IMAGE k (t' DIFF t) = s' DIFF s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphism] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x. if x IN s then (f:real^M->real^N) x else f' x") THEN
    EXISTS_TAC (← q r"\x. if x IN t then (g:real^N->real^M) x else g' x") THEN
    REWRITE_TAC [IN_UNION] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p /\ q /\ s /\ t /\ v) /\ (r /\ u)
      ==> (p /\ q /\ r /\ s /\ t /\ u) /\ v")) THEN
    CONJ_TAC THENL [REPEAT CONJ_TAC THEN ASM SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THEN
     (FIRST_X_ASSUM DISJ_CASES_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL_OPEN,
        MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL] THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC []))

  let HOMEOMORPHISM_GRAPH_EXPLICIT ← prove
   r"!f:real^M->real^N s.
        homeomorphism (s,{pastecart x (f x) | x IN s})
                      ((\x. pastecart x (f x)),fstcart) <=>
        f continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphism] THEN EQ_TAC THEN
    STRIP_TAC THEN REPEAT CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"(f:real^M->real^N) = sndcart o (\x. pastecart x (f x))")
      SUBST1_TAC THENL [SIMP_TAC [o_DEF, SNDCART_PASTECART, ETA_AX], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART],
      REWRITE_TAC [FSTCART_PASTECART],
      SET_TAC [],
      ASM_SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ID],
      REWRITE_TAC [FORALL_IN_GSPEC, FSTCART_PASTECART],
      REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_ELIM_THM, EXISTS_PASTECART, FORALL_PASTECART] THEN
      REWRITE_TAC [FSTCART_PASTECART, PASTECART_INJ] THEN MESON_TAC [],
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART]])

  let HOMEOMORPHISM_GRAPH ← prove
   r"!f:real^M->real^N s.
        (?g. homeomorphism (s,{pastecart x (f x) | x IN s})
                           ((\x. pastecart x (f x)),g)) <=>
        f continuous_on s"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [← GSYM HOMEOMORPHISM_GRAPH_EXPLICIT] THEN MESON_TAC []] THEN
    REWRITE_TAC [homeomorphism] THEN STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_ON_EQ THEN
    EXISTS_TAC (← q r"sndcart o (\x. pastecart x ((f:real^M->real^N) x))") THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_COMPOSE, LINEAR_CONTINUOUS_ON, LINEAR_SNDCART,
                  o_THM, SNDCART_PASTECART])

  let HOMEOMORPHIC_GRAPH ← prove
   r"!f:real^M->real^N s.
        f continuous_on s ==> {pastecart x (f x) | x IN s} homeomorphic s"
   (ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
    REWRITE_TAC [← GSYM HOMEOMORPHISM_GRAPH_EXPLICIT, homeomorphic] THEN
    MESON_TAC [])

  return { HOMEOMORPHIC_SCALING_LEFT, HOMEOMORPHIC_SCALING_RIGHT, HOMEOMORPHIC_SUBSPACES,
           HOMEOMORPHIC_FINITE, HOMEOMORPHIC_FINITE_STRONG, HOMEOMORPHIC_HAS_SIZE,
           HOMEOMORPHISM_HAS_SIZE_EQ, HOMEOMORPHIC_SING, HOMEOMORPHIC_PCROSS_SING,
           LIFT_TO_QUOTIENT_SPACE_UNIQUE, HOMOEOMORPHISM_PASTE, HOMEOMORPHISM_GRAPH_EXPLICIT,
           HOMEOMORPHISM_GRAPH, HOMEOMORPHIC_GRAPH }

/- ------------------------------------------------------------------------- -/
/- Inverse function property for open/closed maps.  (topology.ml 16569-16706) -/
/- ------------------------------------------------------------------------- -/

structure IOM where
  CONTINUOUS_ON_INVERSE_OPEN_MAP : thm
  CONTINUOUS_ON_INVERSE_CLOSED_MAP : thm
  CONTINUOUS_INVERSE_INJECTIVE_PROPER_MAP : thm
  HOMEOMORPHISM_INJECTIVE_OPEN_MAP : thm
  HOMEOMORPHISM_INJECTIVE_CLOSED_MAP : thm
  HOMEOMORPHISM_IMP_OPEN_MAP : thm
  HOMEOMORPHISM_IMP_CLOSED_MAP : thm
  HOMEOMORPHISM_INJECTIVE_OPEN_MAP_EQ : thm
  HOMEOMORPHISM_INJECTIVE_CLOSED_MAP_EQ : thm
  INJECTIVE_MAP_OPEN_IFF_CLOSED : thm
  deriving Inhabited

@[nospecialize]
def setupIOM [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLOC : LOC) (BIDC : IDC) (BCLC : CLC)
    (BPRP1 : PRP1) (BHMA : HMA) : ExceptT String IO IOM := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EQ_IMP, EQ_TRANS, .. } := D.core1
  let { INJECTIVE_ON_LEFT_INVERSE, .. } := D.core2
  let { MONO_EXISTS, .. } := D.core3
  let { SUBSET_REFL, .. } := D.core5
  let { closed_in, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { open_in, .. } := BLOC
  let { CONTINUOUS_ON_IMP_OPEN_IN, CONTINUOUS_ON_OPEN_GEN, .. } := BIDC
  let { CONTINUOUS_ON_CLOSED_GEN, CONTINUOUS_ON_IMP_CLOSED_IN, .. } := BCLC
  let { PROPER_MAP, .. } := BPRP1
  let { homeomorphism, .. } := BHMA
  -- @@SCOPE END

  let CONTINUOUS_ON_INVERSE_OPEN_MAP ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s = t /\ (!x. x IN s ==> g(f x) = x) /\
        (!u. open_in (subtopology euclidean s) u
             ==> open_in (subtopology euclidean t) (IMAGE f u))
        ==> g continuous_on t"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^N->real^M", ← q r"t:real^N->bool", ← q r"s:real^M->bool"]
          CONTINUOUS_ON_OPEN_GEN) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
    X_GEN_TAC (← q r"u:real^M->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:real^M->bool")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [open_in]) THEN
    ASM SET_TAC [])

  let CONTINUOUS_ON_INVERSE_CLOSED_MAP ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s = t /\ (!x. x IN s ==> g(f x) = x) /\
        (!u. closed_in (subtopology euclidean s) u
             ==> closed_in (subtopology euclidean t) (IMAGE f u))
        ==> g continuous_on t"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^N->real^M", ← q r"t:real^N->bool", ← q r"s:real^M->bool"]
          CONTINUOUS_ON_CLOSED_GEN) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
    X_GEN_TAC (← q r"u:real^M->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:real^M->bool")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [closed_in]) THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN ASM SET_TAC [])

  let CONTINUOUS_INVERSE_INJECTIVE_PROPER_MAP ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s = t /\
        (!x. x IN s ==> g(f x) = x) /\
        (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k})
        ==> g continuous_on t"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_SIMP_TAC [PROPER_MAP, SUBSET_REFL] THEN STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_ON_INVERSE_CLOSED_MAP THEN ASM_MESON_TAC [])

  let HOMEOMORPHISM_INJECTIVE_OPEN_MAP ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s = t /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
        (!u. open_in (subtopology euclidean s) u
             ==> open_in (subtopology euclidean t) (IMAGE f u))
        ==> ?g. homeomorphism (s,t) (f,g)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INJECTIVE_ON_LEFT_INVERSE]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
    DISCH_TAC THEN ASM_SIMP_TAC [homeomorphism] THEN
    REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    MATCH_MP_TAC CONTINUOUS_ON_INVERSE_OPEN_MAP THEN ASM_MESON_TAC [])

  let HOMEOMORPHISM_INJECTIVE_CLOSED_MAP ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s = t /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
        (!u. closed_in (subtopology euclidean s) u
             ==> closed_in (subtopology euclidean t) (IMAGE f u))
        ==> ?g. homeomorphism (s,t) (f,g)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INJECTIVE_ON_LEFT_INVERSE]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
    DISCH_TAC THEN ASM_SIMP_TAC [homeomorphism] THEN
    REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    MATCH_MP_TAC CONTINUOUS_ON_INVERSE_CLOSED_MAP THEN ASM_MESON_TAC [])

  let HOMEOMORPHISM_IMP_OPEN_MAP ← prove
   r"!f:real^M->real^N g s t u.
        homeomorphism (s,t) (f,g) /\ open_in (subtopology euclidean s) u
        ==> open_in (subtopology euclidean t) (IMAGE f u)"
   (REWRITE_TAC [homeomorphism] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:real^M->real^N) u =
                   {y | y IN t /\ g(y) IN u}")
    SUBST1_TAC THENL
     [FIRST_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [open_in]) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CONTINUOUS_ON_IMP_OPEN_IN THEN ASM_REWRITE_TAC []])

  let HOMEOMORPHISM_IMP_CLOSED_MAP ← prove
   r"!f:real^M->real^N g s t u.
        homeomorphism (s,t) (f,g) /\ closed_in (subtopology euclidean s) u
        ==> closed_in (subtopology euclidean t) (IMAGE f u)"
   (REWRITE_TAC [homeomorphism] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:real^M->real^N) u =
                   {y | y IN t /\ g(y) IN u}")
    SUBST1_TAC THENL
     [FIRST_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [closed_in]) THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN ASM SET_TAC [],
      MATCH_MP_TAC CONTINUOUS_ON_IMP_CLOSED_IN THEN ASM_REWRITE_TAC []])

  let HOMEOMORPHISM_INJECTIVE_OPEN_MAP_EQ ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s = t /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> ((?g. homeomorphism (s,t) (f,g)) <=>
             !u. open_in (subtopology euclidean s) u
                 ==> open_in (subtopology euclidean t) (IMAGE f u))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN ASM_MESON_TAC [],
      MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_OPEN_MAP THEN
      ASM_REWRITE_TAC []])

  let HOMEOMORPHISM_INJECTIVE_CLOSED_MAP_EQ ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s = t /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> ((?g. homeomorphism (s,t) (f,g)) <=>
             !u. closed_in (subtopology euclidean s) u
                 ==> closed_in (subtopology euclidean t) (IMAGE f u))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHISM_IMP_CLOSED_MAP THEN ASM_MESON_TAC [],
      MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_CLOSED_MAP THEN
      ASM_REWRITE_TAC []])

  let INJECTIVE_MAP_OPEN_IFF_CLOSED ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s = t /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> ((!u. open_in (subtopology euclidean s) u
                  ==> open_in (subtopology euclidean t) (IMAGE f u)) <=>
             (!u. closed_in (subtopology euclidean s) u
                  ==> closed_in (subtopology euclidean t) (IMAGE f u)))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"?g:real^N->real^M. homeomorphism (s,t) (f,g)") THEN
    CONJ_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_OPEN_MAP_EQ,
      MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_CLOSED_MAP_EQ] THEN
    ASM_REWRITE_TAC [])

  return { CONTINUOUS_ON_INVERSE_OPEN_MAP, CONTINUOUS_ON_INVERSE_CLOSED_MAP,
           CONTINUOUS_INVERSE_INJECTIVE_PROPER_MAP, HOMEOMORPHISM_INJECTIVE_OPEN_MAP,
           HOMEOMORPHISM_INJECTIVE_CLOSED_MAP, HOMEOMORPHISM_IMP_OPEN_MAP,
           HOMEOMORPHISM_IMP_CLOSED_MAP, HOMEOMORPHISM_INJECTIVE_OPEN_MAP_EQ,
           HOMEOMORPHISM_INJECTIVE_CLOSED_MAP_EQ, INJECTIVE_MAP_OPEN_IFF_CLOSED }

/- ------------------------------------------------------------------------- -/
/- Transformation theorems for open, interior etc. under homeomorphism.    -/
/- (topology.ml 16707-16886)                                                 -/
/- ------------------------------------------------------------------------- -/

structure TFH1 where
  HOMEOMORPHISM_OPEN_IN_EQ : thm
  HOMEOMORPHISM_OPENNESS : thm
  HOMEOMORPHISM_CLOSED_IN_EQ : thm
  HOMEOMORPHISM_CLOSEDNESS : thm
  HOMEOMORPHISM_DERIVED_SET_OF : thm
  HOMEOMORPHISM_CLOSURE_OF : thm
  HOMEOMORPHISM_INTERIOR_OF : thm
  HOMEOMORPHISM_FRONTIER_OF : thm
  HOMEOMORPHISM_CLOSURE : thm
  HOMEOMORPHISM_CONNECTED_COMPONENT : thm
  HOMEOMORPHISM_COMPONENTS : thm
  LOCAL_HOMEOMORPHISM_IMP_OPEN_MAP : thm
  deriving Inhabited

@[nospecialize]
def setupTFH1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLS1 : CLS1) (BCSL : CSL)
    (BLCP : LCP) (BCCM1 : CCM1) (BCCM2 : CCM2) (BCPN1 : CPN1) (BHMA : HMA) (BIOM : IOM) :
    ExceptT String IO TFH1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMAGE_SUBSET, IMAGE_UNION, IMP_CONJ, IN, INTER_COMM, .. } :=
    D.core2
  let { LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { CLOSURE_OF_ALT, CLOSURE_OF_SUBTOPOLOGY, .. } := D.met1
  let { HOMEOMORPHIC_MAP_DERIVED_SET_OF, HOMEOMORPHIC_MAP_FRONTIER_OF,
        HOMEOMORPHIC_MAP_INTERIOR_OF, HOMEOMORPHIC_MAP_MAPS, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBOPEN, OPEN_IN_SUBTOPOLOGY_INTER_SUBSET,
        OPEN_IN_TRANS, .. } := D.met3
  let { OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { EUCLIDEAN_CLOSURE_OF, .. } := BCLS1
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONNECTED_CONTINUOUS_IMAGE, .. } := BLCP
  let { CONNECTED_COMPONENT_MAXIMAL, CONNECTED_COMPONENT_REFL_EQ, CONNECTED_COMPONENT_SUBSET,
        CONNECTED_CONNECTED_COMPONENT, .. } := BCCM1
  let { CONNECTED_COMPONENT_UNIQUE, .. } := BCCM2
  let { components, .. } := BCPN1
  let { HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY, HOMEOMORPHISM, HOMEOMORPHISM_OF_SUBSETS,
        HOMEOMORPHISM_SYM, homeomorphism, .. } := BHMA
  let { HOMEOMORPHISM_IMP_CLOSED_MAP, HOMEOMORPHISM_IMP_OPEN_MAP, .. } := BIOM
  -- @@SCOPE END

  let HOMEOMORPHISM_OPEN_IN_EQ ← prove
   r"!f:real^M->real^N g s t u v.
        homeomorphism (s,t) (f,g) /\ u SUBSET s /\ v SUBSET s
        ==> (open_in (subtopology euclidean (IMAGE f u)) (IMAGE f v) <=>
             open_in  (subtopology euclidean u) v)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"v = IMAGE (g:real^N->real^M) (IMAGE f v)") SUBST1_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
        MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN MAP_EVERY EXISTS_TAC
         [← q r"f:real^M->real^N", ← q r"IMAGE (f:real^M->real^N) u"] THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [HOMEOMORPHISM_SYM]],
       MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN MAP_EVERY EXISTS_TAC
        [← q r"g:real^N->real^M", ← q r"u:real^M->bool"] THEN  ASM_REWRITE_TAC []] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
      HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHISM_OPENNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (open_in (subtopology euclidean t) (IMAGE f k) <=>
             open_in (subtopology euclidean s) k)"
   (REWRITE_TAC [homeomorphism] THEN REPEAT STRIP_TAC THEN EXPAND_TAC "t" THEN
    MATCH_MP_TAC HOMEOMORPHISM_OPEN_IN_EQ THEN MAP_EVERY EXISTS_TAC
     [← q r"g:real^N->real^M", ← q r"s:real^M->bool", ← q r"t:real^N->bool"] THEN
    ASM_REWRITE_TAC [homeomorphism] THEN ASM SET_TAC [])

  let HOMEOMORPHISM_CLOSED_IN_EQ ← prove
   r"!f:real^M->real^N g s t u v.
        homeomorphism (s,t) (f,g) /\ u SUBSET s /\ v SUBSET s
        ==> (closed_in (subtopology euclidean (IMAGE f u)) (IMAGE f v) <=>
             closed_in  (subtopology euclidean u) v)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"v = IMAGE (g:real^N->real^M) (IMAGE f v)") SUBST1_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
        MATCH_MP_TAC HOMEOMORPHISM_IMP_CLOSED_MAP THEN MAP_EVERY EXISTS_TAC
         [← q r"f:real^M->real^N", ← q r"IMAGE (f:real^M->real^N) u"] THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [HOMEOMORPHISM_SYM]],
       MATCH_MP_TAC HOMEOMORPHISM_IMP_CLOSED_MAP THEN MAP_EVERY EXISTS_TAC
        [← q r"g:real^N->real^M", ← q r"u:real^M->bool"] THEN  ASM_REWRITE_TAC []] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
      HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHISM_CLOSEDNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (closed_in (subtopology euclidean t) (IMAGE f k) <=>
             closed_in (subtopology euclidean s) k)"
   (REWRITE_TAC [homeomorphism] THEN REPEAT STRIP_TAC THEN EXPAND_TAC "t" THEN
    MATCH_MP_TAC HOMEOMORPHISM_CLOSED_IN_EQ THEN MAP_EVERY EXISTS_TAC
     [← q r"g:real^N->real^M", ← q r"s:real^M->bool", ← q r"t:real^N->bool"] THEN
    ASM_REWRITE_TAC [homeomorphism] THEN ASM SET_TAC [])

  let HOMEOMORPHISM_DERIVED_SET_OF ← prove
   r"!f:real^M->real^N g s t u.
           homeomorphism (s,t) (f,g) /\ u SUBSET s
           ==> IMAGE f ((subtopology euclidean s) derived_set_of u) =
               (subtopology euclidean t) derived_set_of (IMAGE f u)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC HOMEOMORPHIC_MAP_DERIVED_SET_OF THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY,
                 TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    ASM_MESON_TAC [])

  let HOMEOMORPHISM_CLOSURE_OF ← prove
   r"!f:real^M->real^N g s t u.
           homeomorphism (s,t) (f,g) /\ u SUBSET s
           ==> IMAGE f ((subtopology euclidean s) closure_of u) =
               (subtopology euclidean t) closure_of (IMAGE f u)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [CLOSURE_OF_ALT, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, IMAGE_UNION] THEN
    BINOP_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHISM]) THEN ASM SET_TAC [],
      MATCH_MP_TAC HOMEOMORPHISM_DERIVED_SET_OF THEN ASM_MESON_TAC []])

  let HOMEOMORPHISM_INTERIOR_OF ← prove
   r"!f:real^M->real^N g s t u.
           homeomorphism (s,t) (f,g) /\ u SUBSET s
           ==> IMAGE f ((subtopology euclidean s) interior_of u) =
               (subtopology euclidean t) interior_of (IMAGE f u)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC HOMEOMORPHIC_MAP_INTERIOR_OF THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY,
                 TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    ASM_MESON_TAC [])

  let HOMEOMORPHISM_FRONTIER_OF ← prove
   r"!f:real^M->real^N g s t u.
           homeomorphism (s,t) (f,g) /\ u SUBSET s
           ==> IMAGE f ((subtopology euclidean s) frontier_of u) =
               (subtopology euclidean t) frontier_of (IMAGE f u)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC HOMEOMORPHIC_MAP_FRONTIER_OF THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY,
                 TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    ASM_MESON_TAC [])

  let HOMEOMORPHISM_CLOSURE ← prove
   r"!f:real^M->real^N g s t u.
        homeomorphism (s,t) (f,g) /\ u SUBSET s
        ==> t INTER closure (IMAGE f u) = IMAGE f (s INTER closure u)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHISM_CLOSURE_OF) THEN
    REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"u SUBSET s ==> s INTER u = u")] THEN
    DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHISM_CONNECTED_COMPONENT ← prove
   r"!f:real^M->real^N g s t x.
        homeomorphism (s,t) (f,g) /\ x IN s
        ==> connected_component (IMAGE f s) (f x) =
            IMAGE f (connected_component s x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_COMPONENT_UNIQUE THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC FUN_IN_IMAGE THEN REWRITE_TAC [IN] THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ],
      MATCH_MP_TAC IMAGE_SUBSET THEN REWRITE_TAC [CONNECTED_COMPONENT_SUBSET],
      MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
      REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT] THEN
      FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET],
      X_GEN_TAC (← q r"d:real^N->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"IMAGE (g:real^N->real^M) d SUBSET connected_component s x")
      MP_TAC THENL
       [MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
        FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
        REPEAT CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
        FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
        ASM SET_TAC []]])

  let HOMEOMORPHISM_COMPONENTS ← prove
   r"!f:real^M->real^N g s t.
        homeomorphism (s,t) (f,g)
        ==> components t = IMAGE (IMAGE f) (components s)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o REWRITE_RULE [homeomorphism]) THEN
    EXPAND_TAC "t" THEN REWRITE_TAC [components] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x | x IN IMAGE g s} = {f(g x) | x IN s}")] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE f {g x | x IN s} = {f(g x) | x IN s}")] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN s ==> f x = g x) ==> {f x | x IN s} = {g x | x IN s}")) THEN
    ASM_MESON_TAC [HOMEOMORPHISM_CONNECTED_COMPONENT])

  let LOCAL_HOMEOMORPHISM_IMP_OPEN_MAP ← prove
   r"!f:real^M->real^N s t.
        (!x. x IN s
             ==> ?u v g. x IN u /\
                         open_in (subtopology euclidean s) u /\
                         open_in (subtopology euclidean t) v /\
                         homeomorphism (u,v) (f,g))
        ==> !u. open_in (subtopology euclidean s) u
                ==> open_in (subtopology euclidean t) (IMAGE f u)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"x:real^M") THEN
    DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"v:real^M->bool", ← q r"w:real^N->bool", ← q r"g:real^N->real^M"] THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (u INTER v)") THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    TRANS_TAC OPEN_IN_TRANS (← q r"w:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMEOMORPHISM_IMP_OPEN_MAP)) THEN
    ONCE_REWRITE_TAC [INTER_COMM] THEN
    MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN
    ASM_MESON_TAC [OPEN_IN_INTER, OPEN_IN_REFL, OPEN_IN_IMP_SUBSET])

  return { HOMEOMORPHISM_OPEN_IN_EQ, HOMEOMORPHISM_OPENNESS, HOMEOMORPHISM_CLOSED_IN_EQ,
           HOMEOMORPHISM_CLOSEDNESS, HOMEOMORPHISM_DERIVED_SET_OF, HOMEOMORPHISM_CLOSURE_OF,
           HOMEOMORPHISM_INTERIOR_OF, HOMEOMORPHISM_FRONTIER_OF, HOMEOMORPHISM_CLOSURE,
           HOMEOMORPHISM_CONNECTED_COMPONENT, HOMEOMORPHISM_COMPONENTS,
           LOCAL_HOMEOMORPHISM_IMP_OPEN_MAP }

/- ------------------------------------------------------------------------- -/
/- Transformation theorems under homeomorphism, continued; relatively weak  -/
/- hypotheses if the domain is compact.  (topology.ml 16887-17084)           -/
/- ------------------------------------------------------------------------- -/

structure TFH2 where
  DERIVED_SET_OF_TRANSLATION : thm
  CLOSURE_OF_TRANSLATION : thm
  INTERIOR_OF_TRANSLATION : thm
  FRONTIER_OF_TRANSLATION : thm
  DERIVED_SET_OF_INJECTIVE_LINEAR_IMAGE : thm
  CLOSURE_OF_INJECTIVE_LINEAR_IMAGE : thm
  FRONTIER_OF_INJECTIVE_LINEAR_IMAGE : thm
  INTERIOR_OF_INJECTIVE_LINEAR_IMAGE : thm
  CONTINUOUS_IMP_CLOSED_MAP_EXPLICIT : thm
  CONTINUOUS_IMP_QUOTIENT_MAP_EXPLICIT : thm
  CONTINUOUS_ON_INVERSE : thm
  HOMEOMORPHISM_COMPACT : thm
  HOMEOMORPHIC_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupTFH2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLOC : LOC) (BBND1 : BND1)
    (BCPT : CPT) (BCSL : CSL) (BCMS : CMS) (BIDC : IDC) (BCLC : CLC) (BLCP : LCP)
    (BQUO1 : QUO1) (BCCC : CCC) (BHMA : HMA) (BTFH1 : TFH1) : ExceptT String IO TFH2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, VECTOR_ARITH, add_linear_invariants,
        add_translation_invariants, .. } := D
  let { EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_INTER_INJ, IMAGE_SUBSET, INJECTIVE_ON_LEFT_INVERSE,
        INTER_SUBSET, IN_ELIM_THM, IN_IMAGE, IN_INTER, .. } := D.core2
  let { I_THM, MONO_EXISTS, .. } := D.core3
  let { SUBSET, .. } := D.core5
  let { o_THM, .. } := D.core6
  let { LINEAR_INJECTIVE_LEFT_INVERSE, .. } := D.vec2
  let { CLOSED_IN_SUBSET, CLOSURE_OF_RESTRICT, .. } := D.met1
  let { DERIVED_SET_OF_RESTRICT, FRONTIER_OF_RESTRICT, INTERIOR_OF_CLOSURE_OF,
        INTERIOR_OF_RESTRICT, .. } := D.met2
  let { frontier_of, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_IN_CLOSED, CLOSED_IN_CLOSED_EQ, CLOSED_IN_CLOSED_TRANS, CLOSED_SUBSET, .. } := BLOC
  let { BOUNDED_SUBSET, .. } := BBND1
  let { COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { CONTINUOUS_ON_CLOSED, .. } := BCLC
  let { COMPACT_CONTINUOUS_IMAGE, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_MAP_IMP_QUOTIENT_MAP, .. } := BQUO1
  let { TRANSLATION_DIFF, .. } := BCCC
  let { HOMEOMORPHISM, homeomorphic, homeomorphism, .. } := BHMA
  let { HOMEOMORPHISM_CLOSURE_OF, HOMEOMORPHISM_DERIVED_SET_OF, HOMEOMORPHISM_FRONTIER_OF,
        HOMEOMORPHISM_INTERIOR_OF, .. } := BTFH1
  -- @@SCOPE END

  let DERIVED_SET_OF_TRANSLATION ← prove
   r"!a:real^N u s.
        (subtopology euclidean (IMAGE (\x. a + x) u)) derived_set_of
        (IMAGE (\x. a + x) s) =
        IMAGE (\x. a + x) (subtopology euclidean u derived_set_of s)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    ONCE_REWRITE_TAC [DERIVED_SET_OF_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    SIMP_TAC [← GSYM IMAGE_INTER_INJ,
              ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
    MATCH_MP_TAC HOMEOMORPHISM_DERIVED_SET_OF THEN
    EXISTS_TAC (← q r"\x:real^N. --a + x") THEN
    REWRITE_TAC [INTER_SUBSET] THEN REWRITE_TAC [HOMEOMORPHISM] THEN
    SIMP_TAC [FORALL_IN_IMAGE, SUBSET] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"--a + a + x:real^N = x")] THEN
    SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
    SET_TAC [])

  add_translation_invariants [DERIVED_SET_OF_TRANSLATION]

  let CLOSURE_OF_TRANSLATION ← prove
   r"!a:real^N u s.
        (subtopology euclidean (IMAGE (\x. a + x) u)) closure_of
        (IMAGE (\x. a + x) s) =
        IMAGE (\x. a + x) (subtopology euclidean u closure_of s)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    SIMP_TAC [← GSYM IMAGE_INTER_INJ,
              ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
    MATCH_MP_TAC HOMEOMORPHISM_CLOSURE_OF THEN
    EXISTS_TAC (← q r"\x:real^N. --a + x") THEN
    REWRITE_TAC [INTER_SUBSET] THEN REWRITE_TAC [HOMEOMORPHISM] THEN
    SIMP_TAC [FORALL_IN_IMAGE, SUBSET] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"--a + a + x:real^N = x")] THEN
    SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
    SET_TAC [])

  add_translation_invariants [CLOSURE_OF_TRANSLATION]

  let INTERIOR_OF_TRANSLATION ← prove
   r"!a:real^N u s.
        (subtopology euclidean (IMAGE (\x. a + x) u)) interior_of
        (IMAGE (\x. a + x) s) =
        IMAGE (\x. a + x) (subtopology euclidean u interior_of s)"
   (REWRITE_TAC [INTERIOR_OF_CLOSURE_OF, CLOSURE_OF_TRANSLATION,
                 TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, ← GSYM TRANSLATION_DIFF])

  add_translation_invariants [INTERIOR_OF_TRANSLATION]

  let FRONTIER_OF_TRANSLATION ← prove
   r"!a:real^N u s.
        (subtopology euclidean (IMAGE (\x. a + x) u)) frontier_of
        (IMAGE (\x. a + x) s) =
        IMAGE (\x. a + x) (subtopology euclidean u frontier_of s)"
   (REWRITE_TAC [frontier_of, CLOSURE_OF_TRANSLATION, INTERIOR_OF_TRANSLATION,
                 ← GSYM TRANSLATION_DIFF])

  add_translation_invariants [FRONTIER_OF_TRANSLATION]

  let DERIVED_SET_OF_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N u s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (subtopology euclidean (IMAGE f u)) derived_set_of (IMAGE f s) =
            IMAGE f (subtopology euclidean u derived_set_of s)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    ONCE_REWRITE_TAC [DERIVED_SET_OF_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP IMAGE_INTER_INJ th)])) THEN
    MATCH_MP_TAC HOMEOMORPHISM_DERIVED_SET_OF THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    ASM_REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN STRIP_TAC THEN
    STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHISM] THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN ASM SET_TAC [])

  add_linear_invariants [DERIVED_SET_OF_INJECTIVE_LINEAR_IMAGE]

  let CLOSURE_OF_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N u s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (subtopology euclidean (IMAGE f u)) closure_of (IMAGE f s) =
            IMAGE f (subtopology euclidean u closure_of s)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP IMAGE_INTER_INJ th)])) THEN
    MATCH_MP_TAC HOMEOMORPHISM_CLOSURE_OF THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    ASM_REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN STRIP_TAC THEN
    STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHISM] THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN ASM SET_TAC [])

  add_linear_invariants [CLOSURE_OF_INJECTIVE_LINEAR_IMAGE]

  let FRONTIER_OF_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N u s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (subtopology euclidean (IMAGE f u)) frontier_of (IMAGE f s) =
            IMAGE f (subtopology euclidean u frontier_of s)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    ONCE_REWRITE_TAC [FRONTIER_OF_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP IMAGE_INTER_INJ th)])) THEN
    MATCH_MP_TAC HOMEOMORPHISM_FRONTIER_OF THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    ASM_REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN STRIP_TAC THEN
    STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHISM] THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN ASM SET_TAC [])

  add_linear_invariants [FRONTIER_OF_INJECTIVE_LINEAR_IMAGE]

  let INTERIOR_OF_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N u s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (subtopology euclidean (IMAGE f u)) interior_of (IMAGE f s) =
            IMAGE f (subtopology euclidean u interior_of s)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    ONCE_REWRITE_TAC [INTERIOR_OF_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP IMAGE_INTER_INJ th)])) THEN
    MATCH_MP_TAC HOMEOMORPHISM_INTERIOR_OF THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    ASM_REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN STRIP_TAC THEN
    STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHISM] THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN ASM SET_TAC [])

  add_linear_invariants [INTERIOR_OF_INJECTIVE_LINEAR_IMAGE]

  let CONTINUOUS_IMP_CLOSED_MAP_EXPLICIT ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s = t /\ compact s
        ==> !u. closed_in (subtopology euclidean s) u
                ==> closed_in (subtopology euclidean t) (IMAGE f u)"
   (SIMP_TAC [CLOSED_IN_CLOSED_EQ, COMPACT_IMP_CLOSED] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_SUBSET THEN
    EXPAND_TAC "t" THEN ASM_SIMP_TAC [IMAGE_SUBSET] THEN
    MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_IN_CLOSED_TRANS,
                   BOUNDED_SUBSET, CONTINUOUS_ON_SUBSET])

  let CONTINUOUS_IMP_QUOTIENT_MAP_EXPLICIT ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s = t /\ compact s
        ==> !u. u SUBSET t
                ==> (open_in (subtopology euclidean s)
                             {x | x IN s /\ f x IN u} <=>
                     open_in (subtopology euclidean t) u)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    MATCH_MP_TAC CLOSED_MAP_IMP_QUOTIENT_MAP THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_IMP_CLOSED_MAP_EXPLICIT THEN
    ASM_REWRITE_TAC [])

  let CONTINUOUS_ON_INVERSE ← prove
   r"!f:real^M->real^N g s.
        f continuous_on s /\ compact s /\ (!x. x IN s ==> (g(f(x)) = x))
        ==> g continuous_on (IMAGE f s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_ON_CLOSED] THEN
    SUBGOAL_THEN (← q r"IMAGE g (IMAGE (f:real^M->real^N) s) = s") SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_IMAGE] THEN ASM_MESON_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN DISCH_TAC THEN
    REWRITE_TAC [CLOSED_IN_CLOSED] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) t") THEN CONJ_TAC THENL
     [MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_IN_CLOSED_TRANS,
                     BOUNDED_SUBSET, CONTINUOUS_ON_SUBSET],
      REWRITE_TAC [EXTENSION, IN_INTER, IN_ELIM_THM, IN_IMAGE] THEN
      ASM_MESON_TAC [CLOSED_IN_SUBSET, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET]])

  let HOMEOMORPHISM_COMPACT ← prove
   r"!s f t. compact s /\ f continuous_on s /\ (IMAGE f s = t) /\
           (!x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y))
           ==> ?g. homeomorphism(s,t) (f,g)"
   (REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE] THEN REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM_SIMP_TAC [EXTENSION, homeomorphism] THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    ASM_MESON_TAC [CONTINUOUS_ON_INVERSE, IN_IMAGE])

  let HOMEOMORPHIC_COMPACT ← prove
   r"!s f t. compact s /\ f continuous_on s /\ (IMAGE f s = t) /\
           (!x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y))
           ==> s homeomorphic t"
   (REWRITE_TAC [homeomorphic] THEN MESON_TAC [HOMEOMORPHISM_COMPACT])

  return { DERIVED_SET_OF_TRANSLATION, CLOSURE_OF_TRANSLATION, INTERIOR_OF_TRANSLATION,
           FRONTIER_OF_TRANSLATION, DERIVED_SET_OF_INJECTIVE_LINEAR_IMAGE,
           CLOSURE_OF_INJECTIVE_LINEAR_IMAGE, FRONTIER_OF_INJECTIVE_LINEAR_IMAGE,
           INTERIOR_OF_INJECTIVE_LINEAR_IMAGE, CONTINUOUS_IMP_CLOSED_MAP_EXPLICIT,
           CONTINUOUS_IMP_QUOTIENT_MAP_EXPLICIT, CONTINUOUS_ON_INVERSE, HOMEOMORPHISM_COMPACT,
           HOMEOMORPHIC_COMPACT }

/- ------------------------------------------------------------------------- -/
/- Composition of homeomorphisms; preservation of topological properties;  -/
/- translation, scaling etc.  (topology.ml 17085-17233)                      -/
/- ------------------------------------------------------------------------- -/

structure CHP where
  HOMEOMORPHISM_FROM_COMPOSITION_SURJECTIVE : thm
  HOMEOMORPHISM_FROM_COMPOSITION_INJECTIVE : thm
  HOMEOMORPHIC_COMPACTNESS : thm
  HOMEOMORPHIC_CONNECTEDNESS : thm
  HOMEOMORPHISM_COMPACTNESS : thm
  HOMEOMORPHISM_CONNECTEDNESS : thm
  HOMEOMORPHIC_SCALING : thm
  HOMEOMORPHIC_TRANSLATION : thm
  HOMEOMORPHIC_AFFINITY : thm
  HOMEOMORPHIC_BALLS : thm
  HOMEOMORPHIC_CBALLS : thm
  HOMEOMORPHIC_SPHERES : thm
  deriving Inhabited

@[nospecialize]
def setupCHP [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCSL : CSL) (BCMS : CMS) (BIDC : IDC)
    (BLCP : LCP) (BOCM1 : OCM1) (BHMA : HMA) (BHMB : HMB) (BIOM : IOM) :
    ExceptT String IO CHP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_TAC, VECTOR_ARITH, .. } := D
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, IN_IMAGE, .. } := D.core2
  let { REAL_ABS_INV, REAL_ABS_MUL, .. } := D.core3
  let { REAL_DIV_REFL, REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ,
        REAL_LT_LMUL_EQ, .. } := D.core4
  let { REAL_MUL_AC, REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_RINV,
        REAL_SUB_REFL, .. } := D.core5
  let { o_THM, real_div, .. } := D.core6
  let { AFFINITY_SCALING_TRANSLATION, .. } := D.vec1
  let { NORM_MUL, NORM_NEG, NORM_SUB, .. } := D.vec3
  let { VECTOR_ADD_ASSOC, VECTOR_ADD_LID, VECTOR_ADD_LINV, VECTOR_ADD_RINV, VECTOR_MUL_ASSOC,
        VECTOR_MUL_LID, VECTOR_MUL_LZERO, dist, .. } := D.vec4
  let { IN_BALL, IN_CBALL, IN_SPHERE, .. } := BBAL
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB, .. } :=
    BCMS
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, .. } := BIDC
  let { COMPACT_CONTINUOUS_IMAGE, CONNECTED_CONTINUOUS_IMAGE, .. } := BLCP
  let { OPEN_MAP_FROM_COMPOSITION_INJECTIVE, OPEN_MAP_FROM_COMPOSITION_SURJECTIVE, .. } := BOCM1
  let { HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM_OF_SUBSETS, homeomorphic,
        homeomorphism, .. } := BHMA
  let { HOMEOMORPHIC_MINIMAL, .. } := BHMB
  let { HOMEOMORPHISM_IMP_OPEN_MAP, HOMEOMORPHISM_INJECTIVE_OPEN_MAP, .. } := BIOM
  -- @@SCOPE END

  let HOMEOMORPHISM_FROM_COMPOSITION_SURJECTIVE ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        f continuous_on s /\ IMAGE f s = t /\
        g continuous_on t /\ IMAGE g t SUBSET u /\
        (?h. homeomorphism (s,u) (g o f,h))
        ==> (?f'. homeomorphism (s,t) (f,f')) /\
            (?g'. homeomorphism (t,u) (g,g'))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism, o_THM]) THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_OPEN_MAP THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      MATCH_MP_TAC OPEN_MAP_FROM_COMPOSITION_SURJECTIVE THEN
      MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN
      MAP_EVERY EXISTS_TAC [← q r"h:real^P->real^M", ← q r"s:real^M->bool"] THEN
      ASM_REWRITE_TAC [homeomorphism, o_THM],
      REWRITE_TAC [homeomorphism, o_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g':real^P->real^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(h:real^P->real^M) o (g:real^N->real^P)") THEN
      ASM_SIMP_TAC [o_THM, IMAGE_o] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET]])

  let HOMEOMORPHISM_FROM_COMPOSITION_INJECTIVE ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET u /\
        (!x y. x IN t /\ y IN t /\ g x = g y ==> x = y) /\
        (?h. homeomorphism (s,u) (g o f,h))
        ==> (?f'. homeomorphism (s,t) (f,f')) /\
            (?g'. homeomorphism (t,u) (g,g'))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism, o_THM]) THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_OPEN_MAP THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      MATCH_MP_TAC OPEN_MAP_FROM_COMPOSITION_INJECTIVE THEN
      MAP_EVERY EXISTS_TAC [← q r"g:real^N->real^P", ← q r"u:real^P->bool"] THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN
      MAP_EVERY EXISTS_TAC [← q r"h:real^P->real^M", ← q r"s:real^M->bool"] THEN
      ASM_REWRITE_TAC [homeomorphism, o_THM],
      REWRITE_TAC [homeomorphism, o_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f':real^N->real^M") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(f:real^M->real^N) o (h:real^P->real^M)") THEN
      ASM_SIMP_TAC [o_THM, IMAGE_o] THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET]])

  let HOMEOMORPHIC_COMPACTNESS ← prove
   r"!s t. s homeomorphic t ==> (compact s <=> compact t)"
   (REWRITE_TAC [homeomorphic, homeomorphism] THEN
    MESON_TAC [COMPACT_CONTINUOUS_IMAGE])

  let HOMEOMORPHIC_CONNECTEDNESS ← prove
   r"!s t. s homeomorphic t ==> (connected s <=> connected t)"
   (REWRITE_TAC [homeomorphic, homeomorphism] THEN
    MESON_TAC [CONNECTED_CONTINUOUS_IMAGE])

  let HOMEOMORPHISM_COMPACTNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (compact(IMAGE f k) <=> compact k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_COMPACTNESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHISM_CONNECTEDNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (connected(IMAGE f k) <=> connected k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_CONNECTEDNESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_SCALING ← prove
   r"!s:real^N->bool c. ~(c = &0) ==> s homeomorphic (IMAGE (\x. c % x) s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
    MAP_EVERY EXISTS_TAC [← q r"\x:real^N. c % x", ← q r"\x:real^N. inv(c) % x"] THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_RINV] THEN
    SIMP_TAC [VECTOR_MUL_LID, IN_IMAGE, REAL_MUL_LID] THEN MESON_TAC [])

  let HOMEOMORPHIC_TRANSLATION ← prove
   r"!s a:real^N. s homeomorphic (IMAGE (\x. a + x) s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
    MAP_EVERY EXISTS_TAC [← q r"\x:real^N. a +  x", ← q r"\x:real^N. --a + x"] THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
    SIMP_TAC [VECTOR_ADD_ASSOC, VECTOR_ADD_LINV, VECTOR_ADD_RINV,
              FORALL_IN_IMAGE, VECTOR_ADD_LID] THEN
    REWRITE_TAC [IN_IMAGE] THEN MESON_TAC [])

  let HOMEOMORPHIC_AFFINITY ← prove
   r"!s a:real^N c. ~(c = &0) ==> s homeomorphic (IMAGE (\x. c % x + a) s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [AFFINITY_SCALING_TRANSLATION] THEN
    TRANS_TAC HOMEOMORPHIC_TRANS (← q r"IMAGE (\x:real^N. c % x) s") THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_TRANSLATION, IMAGE_o, HOMEOMORPHIC_SCALING])

  let (HOMEOMORPHIC_BALLS, HOMEOMORPHIC_CBALLS, HOMEOMORPHIC_SPHERES) ←
    match CONJUNCTS (← prove
     r"(!a:real^N b:real^N d e.
        &0 < d /\ &0 < e ==> ball(a,d) homeomorphic ball(b,e)) /\
     (!a:real^N b:real^N d e.
        &0 < d /\ &0 < e ==> cball(a,d) homeomorphic cball(b,e)) /\
     (!a:real^N b:real^N d e.
        &0 < d /\ &0 < e ==> sphere(a,d) homeomorphic sphere(b,e))"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
      EXISTS_TAC (← q r"\x:real^N. b + (e / d) % (x - a)") THEN
      EXISTS_TAC (← q r"\x:real^N. a + (d / e) % (x - b)") THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_SUB, CONTINUOUS_ON_CMUL,
        CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, IN_BALL, IN_CBALL, IN_SPHERE] THEN
      REWRITE_TAC [dist, ← VECTOR_ARITH (← q r"a - (a + b) = --b:real^N"), NORM_NEG] THEN
      REWRITE_TAC [real_div, ← VECTOR_ARITH
       (← q r"a + d % ((b + e % (x - a)) - b) = (&1 - d * e) % a + (d * e) % x")] THEN
      ONCE_REWRITE_TAC [← REAL_ARITH
        (← q r"(e * d') * (d * e') = (d * d') * (e * e')")] THEN
      ASM_SIMP_TAC [REAL_MUL_RINV, REAL_LT_IMP_NZ, REAL_MUL_LID, REAL_SUB_REFL] THEN
      REWRITE_TAC [NORM_MUL, VECTOR_MUL_LZERO, VECTOR_MUL_LID, VECTOR_ADD_LID] THEN
      ASM_SIMP_TAC [REAL_ABS_MUL, REAL_ABS_INV, ← REAL_ARITH
       (← q r"&0 < x ==> (abs x = x)")] THEN
      GEN_REWRITE_TAC (BINOP_CONV o BINDER_CONV o funpow 2 RAND_CONV)
            [← GSYM REAL_MUL_RID] THEN
      ONCE_REWRITE_TAC [← AC REAL_MUL_AC (← q r"(a * b) * c = (a * c) * b")] THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, ← GSYM real_div, REAL_LE_LDIV_EQ, REAL_MUL_LID,
        ← GSYM REAL_MUL_ASSOC, REAL_LT_LMUL_EQ, REAL_LT_LDIV_EQ, NORM_SUB] THEN
      ASM_SIMP_TAC [REAL_DIV_REFL, REAL_LT_IMP_NZ, REAL_MUL_RID])) with
    | [a, b, c] => pure (a, b, c)
    | _ => throw "HOMEOMORPHIC_BALLS: expected three conjuncts"

  return { HOMEOMORPHISM_FROM_COMPOSITION_SURJECTIVE, HOMEOMORPHISM_FROM_COMPOSITION_INJECTIVE,
           HOMEOMORPHIC_COMPACTNESS, HOMEOMORPHIC_CONNECTEDNESS, HOMEOMORPHISM_COMPACTNESS,
           HOMEOMORPHISM_CONNECTEDNESS, HOMEOMORPHIC_SCALING, HOMEOMORPHIC_TRANSLATION,
           HOMEOMORPHIC_AFFINITY, HOMEOMORPHIC_BALLS, HOMEOMORPHIC_CBALLS,
           HOMEOMORPHIC_SPHERES }

/- ------------------------------------------------------------------------- -/
/- Homeomorphism of one-point compactifications.  (topology.ml 17234-17339)  -/
/- ------------------------------------------------------------------------- -/

structure OPC where
  HOMEOMORPHISM_ONE_POINT_COMPACTIFICATIONS : thm
  HOMEOMORPHIC_ONE_POINT_COMPACTIFICATIONS : thm
  BOUNDED_IMAGE_IN_COMPACTIFICATION : thm
  deriving Inhabited

@[nospecialize]
def setupOPC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BCLS1 : CLS1)
    (BCPT : CPT) (BCPP1 : CPP1) (BCPP2 : CPP2) (BCNT1 : CNT1) (BCSL : CSL) (BLCP : LCP)
    (BHMA : HMA) (BTFH1 : TFH1) (BTFH2 : TFH2) (BCHP : CHP) : ExceptT String IO OPC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, DE_MORGAN_THM, .. } := D.core1
  let { IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IN_DELETE, IN_DIFF, IN_ELIM_THM, .. } := D.core2
  let { MONO_EXISTS, MONO_FORALL, .. } := D.core3
  let { REAL_LT_MIN, REAL_LT_REFL, .. } := D.core4
  let { DIST_NZ, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { closed_in, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, .. } := BBAL
  let { CLOSED_SUBSET, open_in, .. } := BLOC
  let { CLOSED_CLOSURE, CLOSURE_EQ, CLOSURE_MINIMAL, CLOSURE_SUBSET, SUBSET_CLOSURE, .. } := BCLS1
  let { COMPACT_CLOSURE, COMPACT_IMP_CLOSED, .. } := BCPT
  let { COMPACT_INTER_CLOSED, .. } := BCPP1
  let { COMPACT_DIFF, .. } := BCPP2
  let { continuous_within, .. } := BCNT1
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { COMPACT_CONTINUOUS_IMAGE, .. } := BLCP
  let { HOMEOMORPHISM, homeomorphic, .. } := BHMA
  let { HOMEOMORPHISM_CLOSURE, .. } := BTFH1
  let { HOMEOMORPHISM_COMPACT, .. } := BTFH2
  let { HOMEOMORPHISM_COMPACTNESS, .. } := BCHP
  -- @@SCOPE END

  let HOMEOMORPHISM_ONE_POINT_COMPACTIFICATIONS ← prove
   r"!f:real^M->real^N g:real^N->real^M s t a b.
        compact s /\ compact t /\ a IN s /\ b IN t /\
        homeomorphism (s DELETE a,t DELETE b) (f,g)
        ==> ?f' g'. homeomorphism (s,t) (f',g') /\
                    f' a = b /\ g' b = a /\
                    (!x. x IN s DELETE a ==> f' x = f x) /\
                    (!y. y IN t DELETE b ==> g' y = g y)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [HOMEOMORPHISM]) THEN
    ONCE_REWRITE_TAC [← TAUT
      (← q r"p /\ q /\ r /\ s /\ t <=> p /\ (q /\ s) /\ r /\ t")] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!f g. P f /\ R f g ==> Q f g) /\
      (?f. P f /\ ?g. R f g)
      ==> ?f g. R f g /\ P f /\ Q f g")) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [HOMEOMORPHISM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN X_GEN_TAC (← q r"y:real^N") THEN
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(f':real^M->real^N) (g(y:real^N)) = y") MP_TAC THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"\x. if x = a then b else (f:real^M->real^N) x") THEN
    SIMP_TAC [IN_DELETE] THEN MATCH_MP_TAC HOMEOMORPHISM_COMPACT THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"x:real^M = a") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [continuous_within] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"b:real^N", ← q r"e:real"] CENTRE_IN_BALL) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      SUBGOAL_THEN
        (← q r"closed_in (subtopology euclidean s)
                   { x | x IN (s DELETE a) /\
                         (f:real^M->real^N)(x) IN t DIFF ball(b,e)}")
      MP_TAC THENL
       [MATCH_MP_TAC CLOSED_SUBSET THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC COMPACT_IMP_CLOSED THEN SUBGOAL_THEN
         (← q r"{x | x IN s DELETE a /\ f x IN t DIFF ball(b,e)} =
          IMAGE (g:real^N->real^M) (t DIFF ball (b,e))")
        SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
        ASM_SIMP_TAC [COMPACT_DIFF, OPEN_BALL] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [],
        REWRITE_TAC [closed_in, open_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        DISCH_THEN (fun th => tactic_of do
          pure (MP_TAC (← SPEC (← q r"a:real^M") (← liftExcept (last (CONJUNCTS th)))))) THEN
        ASM_REWRITE_TAC [IN_ELIM_THM, IN_DIFF, IN_DELETE] THEN
        SIMP_TAC [IMP_CONJ, DE_MORGAN_THM] THEN
        MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [DIST_REFL] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_BALL]) THEN ASM SET_TAC []],
      UNDISCH_TAC (← q r"(f:real^M->real^N) continuous_on (s DELETE a)") THEN
      REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [IN_DELETE] THEN
      REWRITE_TAC [continuous_within] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [IN_DELETE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min d (dist(a:real^M,x))") THEN
      ASM_REWRITE_TAC [REAL_LT_MIN, ← GSYM DIST_NZ] THEN
      ASM_MESON_TAC [REAL_LT_REFL]])

  let HOMEOMORPHIC_ONE_POINT_COMPACTIFICATIONS ← prove
   r"!s:real^M->bool t:real^N->bool a b.
        compact s /\ compact t /\ a IN s /\ b IN t /\
        (s DELETE a) homeomorphic (t DELETE b)
        ==> s homeomorphic t"
   (REWRITE_TAC [homeomorphic] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
      (← REWRITE_RULE [CONJ_ASSOC] HOMEOMORPHISM_ONE_POINT_COMPACTIFICATIONS))) THEN
    ASM_MESON_TAC [])

  let BOUNDED_IMAGE_IN_COMPACTIFICATION ← prove
   r"!f:real^M->real^N g u s t c.
        homeomorphism (u,s DIFF t) (f,g) /\
        compact s /\ closed u /\ c SUBSET u
        ==> (bounded c <=> closure(IMAGE f c) INTER t = {})"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM COMPACT_CLOSURE] THEN
    SUBGOAL_THEN (← q r"closure(c:real^M->bool) SUBSET u") ASSUME_TAC THENL
     [ASM_SIMP_TAC [CLOSURE_MINIMAL], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"closure c:real^M->bool") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_COMPACTNESS)) THEN
    ASM_SIMP_TAC [CLOSURE_MINIMAL] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IMP_CLOSED) THEN
      REWRITE_TAC [← GSYM CLOSURE_EQ] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"closure(IMAGE f c) SUBSET closure(IMAGE f (closure c)) /\
        IMAGE f (closure c) SUBSET s DIFF t
        ==> closure (IMAGE f (closure c)) = IMAGE f (closure c)
            ==> closure (IMAGE f c) INTER t = {}")) THEN
      SIMP_TAC [IMAGE_SUBSET, CLOSURE_SUBSET, SUBSET_CLOSURE] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHISM]) THEN ASM SET_TAC [],
      FIRST_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_CLOSURE)) THEN
      ASM_SIMP_TAC [CLOSURE_MINIMAL, ← SET_RULE (← q r"c SUBSET u ==> u INTER c = c")] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [COMPACT_INTER_CLOSED, CLOSED_CLOSURE, ← SET_RULE
      (← q r"k INTER t = {} ==> (s DIFF t) INTER k = s INTER k")]])

  return { HOMEOMORPHISM_ONE_POINT_COMPACTIFICATIONS, HOMEOMORPHIC_ONE_POINT_COMPACTIFICATIONS,
           BOUNDED_IMAGE_IN_COMPACTIFICATION }

/- ------------------------------------------------------------------------- -/
/- Homeomorphisms between open intervals in real^1 and then in real^N.     -/
/- (topology.ml 17340-17560)                                                 -/
/- ------------------------------------------------------------------------- -/

structure HOI where
  HOMEOMORPHIC_OPEN_INTERVALS_1 : thm
  HOMEOMORPHIC_OPEN_INTERVAL_UNIV_1 : thm
  HOMEOMORPHIC_OPEN_INTERVALS : thm
  HOMEOMORPHIC_OPEN_INTERVAL_UNIV : thm
  HOMEOMORPHIC_BALL_UNIV : thm
  deriving Inhabited

@[nospecialize]
def setupHOI [HolBase] (D : TopologyDeps) (BBAL : BAL) (BNET : NET) (BCSL : CSL) (BCMB : CMB)
    (BCMS : CMS) (BIDC : IDC) (BHSP : HSP) (BLFR : LFR) (BSMI : SMI) (BR1A : R1A) (BLRU : LRU)
    (BHMA : HMA) (BHMB : HMB) : ExceptT String IO HOI := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, GEOM_NORMALIZE_TAC, GEOM_ORIGIN_TAC, .. } := D
  let { CART_EQ, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ_ALT, IN_ELIM_THM, .. } := D.core2
  let { IN_UNION, IN_UNIV, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, REAL_ABS_INV, REAL_ABS_MUL,
        REAL_ADD_RID, REAL_ADD_SUB, .. } := D.core3
  let { REAL_BOUNDS_LT, REAL_DIV_RMUL, REAL_EQ_LDIV_EQ, REAL_INV_EQ_1, REAL_INV_MUL,
        REAL_LET_ANTISYM, REAL_LE_ANTISYM, REAL_LE_INV_EQ, REAL_LE_MUL_EQ, REAL_LT_ADDR,
        REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, REAL_LT_RMUL_EQ, .. } := D.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, REAL_NOT_LE, REAL_SUB_0, REAL_SUB_LT, REAL_SUB_RZERO,
        RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, .. } := D.core5
  let { o_DEF, real_abs, real_div, real_ge, .. } := D.core6
  let { DIST_0, DROP_ADD, DROP_CMUL, DROP_EQ, DROP_NEG, DROP_SUB, DROP_VEC, .. } := D.vec1
  let { INTERVAL_NE_EMPTY, IN_INTERVAL, LIFT_ADD, LIFT_DROP, LIFT_SUB, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_REAL, .. } := D.vec3
  let { VECTOR_CHOOSE_SIZE, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_LID, drop, .. } :=
    D.vec4
  let { IN_BALL, IN_BALL_0, .. } := BBAL
  let { NETLIMIT_AT, .. } := BNET
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ADD, CONTINUOUS_CONST, CONTINUOUS_SUB, .. } := BCMB
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_COMPONENTWISE_LIFT,
        CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_AT_ID, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, .. } := BIDC
  let { CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_HALFSPACE_COMPONENT_LE, .. } := BHSP
  let { CONTINUOUS_AT_LIFT_NORM, CONTINUOUS_ON_LIFT_COMPONENT, CONTINUOUS_ON_LIFT_NORM_COMPOSE,
        .. } := BLFR
  let { CONTINUOUS_INV, CONTINUOUS_MUL, CONTINUOUS_ON_INV, CONTINUOUS_ON_MUL,
        CONTINUOUS_ON_VMUL, .. } := BSMI
  let { IN_INTERVAL_1, .. } := BR1A
  let { CONTINUOUS_ON_CASES, .. } := BLRU
  let { HOMEOMORPHIC_REFL, HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, .. } := BHMA
  let { HOMEOMORPHIC_MINIMAL, .. } := BHMB
  -- @@SCOPE END

  let HOMEOMORPHIC_OPEN_INTERVALS_1 ← prove
   r"!a b c d.
        drop a < drop b /\ drop c < drop d
        ==> interval(a,b) homeomorphic interval(c,d)"
   (SUBGOAL_THEN
     (← q r"!a b. drop a < drop b
            ==> interval(vec 0:real^1,vec 1) homeomorphic interval(a,b)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
      EXISTS_TAC (← q r"(\x. a + drop x % (b - a)):real^1->real^1") THEN
      EXISTS_TAC (← q r"(\x. inv(drop b - drop a) % (x - a)):real^1->real^1") THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, ← GSYM DROP_EQ] THEN
      REWRITE_TAC [DROP_ADD, DROP_CMUL, DROP_NEG, DROP_VEC, DROP_SUB] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"inv b * a:real = a / b")] THEN
      ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_SUB_LT,
         REAL_LT_ADDR, REAL_EQ_LDIV_EQ, REAL_DIV_RMUL, REAL_LT_IMP_NZ,
         REAL_LT_MUL, REAL_MUL_LZERO, REAL_ADD_SUB, REAL_LT_RMUL_EQ,
         ← REAL_ARITH (← q r"a + x < b <=> x < &1 * (b - a)")] THEN
      REPEAT CONJ_TAC THENL
       [REAL_ARITH_TAC,
        MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
        MATCH_MP_TAC CONTINUOUS_ON_VMUL THEN
        REWRITE_TAC [o_DEF, LIFT_DROP, CONTINUOUS_ON_ID],
        MATCH_MP_TAC CONTINUOUS_ON_CMUL THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID]],
      REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"]) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"c:real^1", ← q r"d:real^1"]) THEN
      ASM_REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
      GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [HOMEOMORPHIC_SYM] THEN
      REWRITE_TAC [HOMEOMORPHIC_TRANS]])

  let HOMEOMORPHIC_OPEN_INTERVAL_UNIV_1 ← prove
   r"!a b. drop a < drop b ==> interval(a,b) homeomorphic (:real^1)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"--vec 1:real^1",
                     ← q r"vec 1:real^1"]
          HOMEOMORPHIC_OPEN_INTERVALS_1) THEN
    ASM_REWRITE_TAC [DROP_VEC, DROP_NEG] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMEOMORPHIC_TRANS) THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN
    REWRITE_TAC [HOMEOMORPHIC_MINIMAL, IN_UNIV] THEN
    EXISTS_TAC (← q r"\x:real^1. inv(&1 - norm x) % x") THEN
    EXISTS_TAC (← q r"\y. if &0 <= drop y then inv(&1 + drop y) % y
                    else inv(&1 - drop y) % y") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_INTERVAL_1] THEN
      REWRITE_TAC [DROP_NEG, DROP_VEC, DROP_CMUL, NORM_REAL, ← GSYM drop] THEN
      SIMP_TAC [REAL_LE_MUL_EQ, REAL_LT_INV_EQ, REAL_LE_MUL_EQ, ← REAL_ARITH
       (← q r"--a < x /\ x < a ==> &0 < a - abs x")] THEN
      SIMP_TAC [real_abs, VECTOR_MUL_ASSOC] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM VECTOR_MUL_LID] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => REAL_FIELD t),
      X_GEN_TAC (← q r"y:real^1") THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_NEG, DROP_VEC, REAL_BOUNDS_LT] THEN
      REWRITE_TAC [DROP_CMUL, REAL_ABS_MUL, REAL_ABS_INV] THEN
      REWRITE_TAC [← GSYM (← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div)] THEN
      ASM_SIMP_TAC [REAL_LT_LDIV_EQ, ← REAL_ARITH (← q r"&0 <= x ==> &0 < abs(&1 + x)"),
                    ← REAL_ARITH (← q r"~(&0 <= x) ==> &0 < abs(&1 - x)")] THEN
      (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
      REWRITE_TAC [NORM_REAL, VECTOR_MUL_ASSOC] THEN
      REWRITE_TAC [← GSYM drop, DROP_CMUL, REAL_ABS_MUL] THEN
      ASM_REWRITE_TAC [real_abs, REAL_LE_INV_EQ] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= x ==> &0 <= &1 + x"),
                    ← REAL_ARITH (← q r"~(&0 <= x) ==> &0 <= &1 - x")] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM VECTOR_MUL_LID] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => REAL_FIELD t),
      MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
      X_GEN_TAC (← q r"x:real^1") THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_NEG, DROP_VEC] THEN
      DISCH_TAC THEN MATCH_MP_TAC CONTINUOUS_MUL THEN
      REWRITE_TAC [CONTINUOUS_AT_ID] THEN
      ONCE_REWRITE_TAC [← GSYM o_DEF] THEN MATCH_MP_TAC CONTINUOUS_INV THEN
      REWRITE_TAC [NETLIMIT_AT, o_DEF, LIFT_SUB, LIFT_DROP] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_SUB THEN
        SIMP_TAC [CONTINUOUS_CONST, ← REWRITE_RULE [o_DEF] CONTINUOUS_AT_LIFT_NORM],
        REWRITE_TAC [NORM_REAL, ← GSYM drop] THEN ASM_REAL_ARITH_TAC],
      SUBGOAL_THEN (← q r"(:real^1) = {x | x$1 >= &0} UNION {x | x$1 <= &0}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_UNION, IN_UNION, IN_ELIM_THM, IN_UNIV] THEN
        REAL_ARITH_TAC,
        MATCH_MP_TAC CONTINUOUS_ON_CASES THEN
        REWRITE_TAC [CLOSED_HALFSPACE_COMPONENT_LE, CLOSED_HALFSPACE_COMPONENT_GE,
                     IN_ELIM_THM] THEN
        REWRITE_TAC [← GSYM drop, REAL_NOT_LE, real_ge, REAL_LET_ANTISYM] THEN
        SIMP_TAC [REAL_LE_ANTISYM, REAL_SUB_RZERO, REAL_ADD_RID] THEN
        CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
        X_GEN_TAC (← q r"y:real^1") THEN REWRITE_TAC [IN_ELIM_THM, real_ge] THEN
        DISCH_TAC THEN MATCH_MP_TAC CONTINUOUS_MUL THEN
        REWRITE_TAC [CONTINUOUS_AT_ID] THEN
        ONCE_REWRITE_TAC [← GSYM o_DEF] THEN MATCH_MP_TAC CONTINUOUS_INV THEN
        REWRITE_TAC [NETLIMIT_AT, o_DEF, LIFT_ADD, LIFT_SUB, LIFT_DROP] THEN
        ASM_SIMP_TAC [CONTINUOUS_ADD, CONTINUOUS_AT_ID, CONTINUOUS_SUB,
                      CONTINUOUS_CONST] THEN
        ASM_REAL_ARITH_TAC]])

  let HOMEOMORPHIC_OPEN_INTERVALS ← prove
   r"!a b:real^N c d:real^N.
        (interval(a,b) = {} <=> interval(c,d) = {})
        ==> interval(a,b) homeomorphic interval(c,d)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"interval(c:real^N,d) = {}") THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN ASM_REWRITE_TAC [HOMEOMORPHIC_REFL] THEN
    SUBGOAL_THEN
     (← q r"!i. 1 <= i /\ i <= dimindex(:N)
          ==> interval(lift((a:real^N)$i),lift((b:real^N)$i)) homeomorphic
              interval(lift((c:real^N)$i),lift((d:real^N)$i))")
    MP_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
      ASM_SIMP_TAC [HOMEOMORPHIC_OPEN_INTERVALS_1, LIFT_DROP],
      ALL_TAC] THEN
    REWRITE_TAC [HOMEOMORPHIC_MINIMAL, IN_INTERVAL_1, LIFT_DROP] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:num->real^1->real^1", ← q r"g:num->real^1->real^1"] THEN
    DISCH_TAC THEN
    EXISTS_TAC
     (← q r"(\x. lambda i.
         drop((f:num->real^1->real^1) i (lift(x$i)))):real^N->real^N") THEN
    EXISTS_TAC
     (← q r"(\x. lambda i.
         drop((g:num->real^1->real^1) i (lift(x$i)))):real^N->real^N") THEN
    ASM_SIMP_TAC [IN_INTERVAL, LAMBDA_BETA, CART_EQ, LIFT_DROP] THEN
    ONCE_REWRITE_TAC [CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
    SIMP_TAC [LAMBDA_BETA, LIFT_DROP] THEN CONJ_TAC THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_COMPONENT] THEN
    MATCH_MP_TAC CONTINUOUS_ON_SUBSET THENL
     [EXISTS_TAC (← q r"interval(lift((a:real^N)$i),lift((b:real^N)$i))"),
      EXISTS_TAC (← q r"interval(lift((c:real^N)$i),lift((d:real^N)$i))")] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1] THEN
    ASM_SIMP_TAC [LIFT_DROP, IN_INTERVAL])

  let HOMEOMORPHIC_OPEN_INTERVAL_UNIV ← prove
   r"!a b:real^N.
        ~(interval(a,b) = {})
        ==> interval(a,b) homeomorphic (:real^N)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!i. 1 <= i /\ i <= dimindex(:N)
          ==> interval(lift((a:real^N)$i),lift((b:real^N)$i)) homeomorphic
              (:real^1)")
    MP_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
      ASM_SIMP_TAC [HOMEOMORPHIC_OPEN_INTERVAL_UNIV_1, LIFT_DROP],
      ALL_TAC] THEN
    REWRITE_TAC [HOMEOMORPHIC_MINIMAL, IN_INTERVAL_1, LIFT_DROP] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:num->real^1->real^1", ← q r"g:num->real^1->real^1"] THEN
    DISCH_TAC THEN
    EXISTS_TAC
     (← q r"(\x. lambda i.
         drop((f:num->real^1->real^1) i (lift(x$i)))):real^N->real^N") THEN
    EXISTS_TAC
     (← q r"(\x. lambda i.
         drop((g:num->real^1->real^1) i (lift(x$i)))):real^N->real^N") THEN
    ASM_SIMP_TAC [IN_INTERVAL, LAMBDA_BETA, CART_EQ, LIFT_DROP, IN_UNIV] THEN
    ONCE_REWRITE_TAC [CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
    SIMP_TAC [LAMBDA_BETA, LIFT_DROP] THEN CONJ_TAC THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_COMPONENT] THEN
    MATCH_MP_TAC CONTINUOUS_ON_SUBSET THENL
     [EXISTS_TAC (← q r"interval(lift((a:real^N)$i),lift((b:real^N)$i))"),
      EXISTS_TAC (← q r"(:real^1)")] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, IN_UNIV] THEN
    ASM_SIMP_TAC [LIFT_DROP, IN_INTERVAL])

  let HOMEOMORPHIC_BALL_UNIV ← prove
   r"!a:real^N r. &0 < r ==> ball(a,r) homeomorphic (:real^N)"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?y:real^N. r = norm(y)") (CHOOSE_THEN SUBST_ALL_TAC) THENL
     [ASM_MESON_TAC [VECTOR_CHOOSE_SIZE, REAL_LT_IMP_LE], POP_ASSUM MP_TAC] THEN
    REWRITE_TAC [NORM_POS_LT] THEN GEOM_NORMALIZE_TAC (← q r"y:real^N") THEN
    SIMP_TAC [] THEN GEN_TAC THEN REPEAT (DISCH_THEN (K ALL_TAC : thm → tactic)) THEN
    REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
    EXISTS_TAC (← q r"\z:real^N. inv(&1 - norm(z)) % z") THEN
    EXISTS_TAC (← q r"\z:real^N. inv(&1 + norm(z)) % z") THEN
    REWRITE_TAC [IN_BALL, IN_UNIV, DIST_0, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0,
                 ← VECTOR_ARITH (← q r"a % x:real^N = x <=> (a - &1) % x = vec 0")] THEN
    REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN DISJ1_TAC THEN
      REWRITE_TAC [← GSYM REAL_INV_MUL, REAL_SUB_0, REAL_INV_EQ_1] THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_INV] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"x < &1 ==> abs(&1 - x) = &1 - x")] THEN
      POP_ASSUM MP_TAC THEN CONV_TAC (fun t => REAL_FIELD t),
      X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [NORM_MUL, REAL_ABS_INV] THEN
      ASM_SIMP_TAC [NORM_POS_LE, ← REAL_ARITH
       (← q r"&0 <= y ==> inv(abs(&1 + y)) * z = z / (&1 + y)")] THEN
      ASM_SIMP_TAC [NORM_POS_LE, REAL_LT_LDIV_EQ, ← REAL_ARITH
        (← q r"&0 <= y ==> &0 < &1 + y")] THEN
      CONJ_TAC THENL [REAL_ARITH_TAC, DISJ1_TAC] THEN
      REWRITE_TAC [← GSYM REAL_INV_MUL, REAL_SUB_0, REAL_INV_EQ_1] THEN
      MP_TAC (← ISPEC (← q r"y:real^N") NORM_POS_LE) THEN CONV_TAC (fun t => REAL_FIELD t),
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN REWRITE_TAC [CONTINUOUS_ON_ID] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_INV THEN
      SIMP_TAC [IN_BALL_0, REAL_SUB_0, ← REAL_ARITH (← q r"x < &1 ==> ~(&1 = x)")] THEN
      REWRITE_TAC [o_DEF, LIFT_SUB] THEN MATCH_MP_TAC CONTINUOUS_ON_SUB THEN
      REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE THEN
      REWRITE_TAC [CONTINUOUS_ON_ID],
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN REWRITE_TAC [CONTINUOUS_ON_ID] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_INV THEN
      SIMP_TAC [NORM_POS_LE, ← REAL_ARITH (← q r"&0 <= x ==> ~(&1 + x = &0)")] THEN
      REWRITE_TAC [o_DEF, LIFT_ADD] THEN MATCH_MP_TAC CONTINUOUS_ON_ADD THEN
      REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE THEN
      REWRITE_TAC [CONTINUOUS_ON_ID]])

  return { HOMEOMORPHIC_OPEN_INTERVALS_1, HOMEOMORPHIC_OPEN_INTERVAL_UNIV_1,
           HOMEOMORPHIC_OPEN_INTERVALS, HOMEOMORPHIC_OPEN_INTERVAL_UNIV, HOMEOMORPHIC_BALL_UNIV }

/- ------------------------------------------------------------------------- -/
/- Cardinalities of various useful sets.  (topology.ml 17561-17739)          -/
/- ------------------------------------------------------------------------- -/

structure CRD1 where
  CARD_EQ_EUCLIDEAN : thm
  UNCOUNTABLE_EUCLIDEAN : thm
  CARD_EQ_INTERVAL : thm
  UNCOUNTABLE_INTERVAL : thm
  COUNTABLE_OPEN_INTERVAL : thm
  CARD_EQ_OPEN : thm
  UNCOUNTABLE_OPEN : thm
  CARD_EQ_BALL : thm
  CARD_EQ_CBALL : thm
  FINITE_IMP_NOT_OPEN : thm
  OPEN_IMP_INFINITE : thm
  EMPTY_INTERIOR_FINITE : thm
  FINITE_CBALL : thm
  FINITE_BALL : thm
  CARD_EQ_CONNECTED : thm
  UNCOUNTABLE_CONNECTED : thm
  CARD_LT_IMP_DISCONNECTED : thm
  COUNTABLE_IMP_DISCONNECTED : thm
  CONNECTED_CARD_EQ_IFF_NONTRIVIAL : thm
  CONNECTED_CARD_LT_IFF_TRIVIAL : thm
  deriving Inhabited

@[nospecialize]
def setupCRD1 [HolBase] (D : TopologyDeps) (BBAL : BAL) (BINT : INT) (BCBL : CBL) (BCCM1 : CCM1)
    (BITV2 : ITV2) (BR1A : R1A) (BIVT : IVT) (BHMA : HMA) (BHOI : HOI) :
    ExceptT String IO CRD1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, GEOM_NORMALIZE_TAC,
        GEOM_ORIGIN_TAC, .. } := D
  let { AND_FORALL_THM, CONTRAPOS_THM, DE_MORGAN_THM, FINITE_EMPTY, .. } := D.core1
  let { FINITE_SING, FINITE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IN, INFINITE, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_C, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_IMP_LE, .. } := D.core4
  let { REAL_NOT_LT, REAL_POS, REAL_POW_ONE, .. } := D.core5
  let { real_INFINITE, .. } := D.core6
  let { CARD_EQ_CART, CARD_EQ_IMP_LE, CARD_EQ_REAL_IMP_UNCOUNTABLE, CARD_EQ_SYM,
        CARD_LE_ANTISYM, CARD_LE_SUBSET, CARD_LE_TRANS, CARD_LE_UNIV, CARD_NOT_LE, CARD_NOT_LT,
        COUNTABLE_EMPTY, COUNTABLE_IMP_CARD_LT_REAL, FINITE_IMP_COUNTABLE, .. } := D.lib1
  let { DOT_RZERO, DROP_VEC, FORALL_LIFT, .. } := D.vec1
  let { INTERVAL_OPEN_SUBSET_CLOSED, LIFT_DROP, LIFT_EQ, .. } := D.vec2
  let { NORM_EQ_SQUARE, .. } := D.vec3
  let { BALL_EMPTY, BALL_EQ_EMPTY, BALL_SUBSET_CBALL, CBALL_TRIVIAL, OPEN_BALL, .. } := BBAL
  let { INTERIOR_SUBSET, OPEN_INTERIOR, .. } := BINT
  let { CBALL_EMPTY, INTERIOR_CBALL, .. } := BCBL
  let { CONNECTED_COMPONENT_REFL_EQ, CONNECTED_COMPONENT_SUBSET, CONNECTED_CONNECTED_COMPONENT,
        .. } := BCCM1
  let { OPEN_CONTAINS_INTERVAL, UNIT_INTERVAL_NONEMPTY, .. } := BITV2
  let { IN_INTERVAL_1, .. } := BR1A
  let { CONNECTED_IVT_HYPERPLANE, .. } := BIVT
  let { HOMEOMORPHIC_IMP_CARD_EQ, .. } := BHMA
  let { HOMEOMORPHIC_OPEN_INTERVAL_UNIV, .. } := BHOI
  -- @@SCOPE END

  let CARD_EQ_EUCLIDEAN ← prove
   r"(:real^N) =_c (:real)"
   (MATCH_MP_TAC CARD_EQ_CART THEN REWRITE_TAC [real_INFINITE])

  let UNCOUNTABLE_EUCLIDEAN ← prove
   r"~COUNTABLE(:real^N)"
   (MATCH_MP_TAC CARD_EQ_REAL_IMP_UNCOUNTABLE THEN
    REWRITE_TAC [CARD_EQ_EUCLIDEAN])

  let CARD_EQ_INTERVAL ← prove
   r"(!a b:real^N. ~(interval(a,b) = {}) ==> interval[a,b] =_c (:real)) /\
   (!a b:real^N. ~(interval(a,b) = {}) ==> interval(a,b) =_c (:real))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"interval(a:real^N,b) = {}") THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THEN REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
      REWRITE_TAC [CARD_LE_UNIV] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
      REWRITE_TAC [CARD_EQ_EUCLIDEAN],
      TRANS_TAC CARD_LE_TRANS (← q r"interval(a:real^N,b)") THEN
      SIMP_TAC [CARD_LE_SUBSET, INTERVAL_OPEN_SUBSET_CLOSED],
      TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
      REWRITE_TAC [CARD_LE_UNIV] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
      REWRITE_TAC [CARD_EQ_EUCLIDEAN],
      ALL_TAC] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
    SIMP_TAC [← ONCE_REWRITE_RULE [CARD_EQ_SYM] CARD_EQ_IMP_LE,
              CARD_EQ_EUCLIDEAN] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_OPEN_INTERVAL_UNIV) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_IMP_CARD_EQ) THEN
    MESON_TAC [CARD_EQ_IMP_LE, CARD_EQ_SYM])

  let UNCOUNTABLE_INTERVAL ← prove
   r"(!a b. ~(interval(a,b) = {}) ==> ~COUNTABLE(interval[a,b])) /\
   (!a b. ~(interval(a,b) = {}) ==> ~COUNTABLE(interval(a,b)))"
   (SIMP_TAC [CARD_EQ_REAL_IMP_UNCOUNTABLE, CARD_EQ_INTERVAL])

  let COUNTABLE_OPEN_INTERVAL ← prove
   r"!a b. COUNTABLE(interval(a,b)) <=> interval(a,b) = {}"
   (MESON_TAC [COUNTABLE_EMPTY, UNCOUNTABLE_INTERVAL])

  let CARD_EQ_OPEN ← prove
   r"!s:real^N->bool. open s /\ ~(s = {}) ==> s =_c (:real)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
      REWRITE_TAC [CARD_LE_UNIV] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
      REWRITE_TAC [CARD_EQ_EUCLIDEAN],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_INTERVAL]) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"c:real^N")) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"c:real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
      ASM_CASES_TAC (← q r"interval(a:real^N,b) = {}") THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN STRIP_TAC THEN
      TRANS_TAC CARD_LE_TRANS (← q r"interval[a:real^N,b]") THEN
      ASM_SIMP_TAC [CARD_LE_SUBSET] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
      ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN ASM_SIMP_TAC [CARD_EQ_INTERVAL]])

  let UNCOUNTABLE_OPEN ← prove
   r"!s:real^N->bool. open s /\ ~(s = {}) ==> ~(COUNTABLE s)"
   (SIMP_TAC [CARD_EQ_OPEN, CARD_EQ_REAL_IMP_UNCOUNTABLE])

  let CARD_EQ_BALL ← prove
   r"!a:real^N r. &0 < r ==> ball(a,r) =_c (:real)"
   (SIMP_TAC [CARD_EQ_OPEN, OPEN_BALL, BALL_EQ_EMPTY, ← GSYM REAL_NOT_LT])

  let CARD_EQ_CBALL ← prove
   r"!a:real^N r. &0 < r ==> cball(a,r) =_c (:real)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
      REWRITE_TAC [CARD_LE_UNIV] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
      REWRITE_TAC [CARD_EQ_EUCLIDEAN],
      TRANS_TAC CARD_LE_TRANS (← q r"ball(a:real^N,r)") THEN
      SIMP_TAC [CARD_LE_SUBSET, BALL_SUBSET_CBALL] THEN
      MATCH_MP_TAC CARD_EQ_IMP_LE THEN
      ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN ASM_SIMP_TAC [CARD_EQ_BALL]])

  let FINITE_IMP_NOT_OPEN ← prove
   r"!s:real^N->bool. FINITE s /\ ~(s = {}) ==> ~(open s)"
   (MESON_TAC [UNCOUNTABLE_OPEN, FINITE_IMP_COUNTABLE])

  let OPEN_IMP_INFINITE ← prove
   r"!s. open s ==> s = {} \/ INFINITE s"
   (MESON_TAC [FINITE_IMP_NOT_OPEN, INFINITE])

  let EMPTY_INTERIOR_FINITE ← prove
   r"!s:real^N->bool. FINITE s ==> interior s = {}"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPEC (← q r"s:real^N->bool") OPEN_INTERIOR) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] FINITE_IMP_NOT_OPEN) THEN
    MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
    ASM_REWRITE_TAC [INTERIOR_SUBSET])

  let FINITE_CBALL ← prove
   r"!a:real^N r. FINITE(cball(a,r)) <=> r <= &0"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [CBALL_EMPTY, REAL_LT_IMP_LE, FINITE_EMPTY] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN
    ASM_REWRITE_TAC [CBALL_TRIVIAL, FINITE_SING, REAL_LE_REFL] THEN
    EQ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP EMPTY_INTERIOR_FINITE) THEN
    REWRITE_TAC [INTERIOR_CBALL, BALL_EQ_EMPTY] THEN ASM_REAL_ARITH_TAC)

  let FINITE_BALL ← prove
   r"!a:real^N r. FINITE(ball(a,r)) <=> r <= &0"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"r <= &0") THEN
    ASM_SIMP_TAC [BALL_EMPTY, REAL_LT_IMP_LE, FINITE_EMPTY] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          FINITE_IMP_NOT_OPEN)) THEN
    REWRITE_TAC [OPEN_BALL, BALL_EQ_EMPTY] THEN ASM_REAL_ARITH_TAC)

  let CARD_EQ_CONNECTED ← prove
   r"!s a b:real^N.
        connected s /\ a IN s /\ b IN s /\ ~(a = b) ==> s =_c (:real)"
   (GEOM_ORIGIN_TAC (← q r"b:real^N") THEN GEOM_NORMALIZE_TAC (← q r"a:real^N") THEN
    REWRITE_TAC [NORM_EQ_SQUARE, REAL_POS, REAL_POW_ONE] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
      SIMP_TAC [CARD_LE_UNIV, CARD_EQ_EUCLIDEAN, CARD_EQ_IMP_LE],
      TRANS_TAC CARD_LE_TRANS (← q r"interval[vec 0:real^1,vec 1]") THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← ONCE_REWRITE_RULE [CARD_EQ_SYM] CARD_EQ_IMP_LE) THEN
        SIMP_TAC [UNIT_INTERVAL_NONEMPTY, CARD_EQ_INTERVAL],
        REWRITE_TAC [LE_C] THEN EXISTS_TAC (← q r"\x:real^N. lift(a dot x)") THEN
        SIMP_TAC [FORALL_LIFT, LIFT_EQ, IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
        X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THEN
        MATCH_MP_TAC CONNECTED_IVT_HYPERPLANE THEN
        MAP_EVERY EXISTS_TAC [← q r"vec 0:real^N", ← q r"a:real^N"] THEN
        ASM_REWRITE_TAC [DOT_RZERO]]])

  let UNCOUNTABLE_CONNECTED ← prove
   r"!s a b:real^N.
        connected s /\ a IN s /\ b IN s /\ ~(a = b) ==> ~COUNTABLE s"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CARD_EQ_REAL_IMP_UNCOUNTABLE THEN
    MATCH_MP_TAC CARD_EQ_CONNECTED THEN
    ASM_MESON_TAC [])

  let CARD_LT_IMP_DISCONNECTED ← prove
   r"!s x:real^N. s <_c (:real) /\ x IN s ==> connected_component s x = {x}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← SET_RULE
     (← q r"s = {a} <=> a IN s /\ !a b. a IN s /\ b IN s /\ ~(a = b) ==> F")] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [IN] THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
    MP_TAC (← ISPECL [← q r"connected_component s (x:real^N)", ← q r"a:real^N",
                      ← q r"b:real^N"]
          CARD_EQ_CONNECTED) THEN
    ASM_REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT] THEN
    DISCH_TAC THEN UNDISCH_TAC (← q r"(s:real^N->bool) <_c (:real)") THEN
    REWRITE_TAC [CARD_NOT_LT] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"connected_component s (x:real^N)") THEN
    ASM_SIMP_TAC [← ONCE_REWRITE_RULE [CARD_EQ_SYM] CARD_EQ_IMP_LE] THEN
    MATCH_MP_TAC CARD_LE_SUBSET THEN REWRITE_TAC [CONNECTED_COMPONENT_SUBSET])

  let COUNTABLE_IMP_DISCONNECTED ← prove
   r"!s x:real^N. COUNTABLE s /\ x IN s ==> connected_component s x = {x}"
   (SIMP_TAC [CARD_LT_IMP_DISCONNECTED, COUNTABLE_IMP_CARD_LT_REAL])

  let CONNECTED_CARD_EQ_IFF_NONTRIVIAL ← prove
   r"!s:real^N->bool.
        connected s ==> (s =_c (:real) <=> ~(?a. s SUBSET {a}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [ALL_TAC, MATCH_MP_TAC CARD_EQ_CONNECTED THEN ASM SET_TAC []] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET)) THEN
    REWRITE_TAC [FINITE_SING] THEN
    ASM_MESON_TAC [CARD_EQ_REAL_IMP_UNCOUNTABLE, FINITE_IMP_COUNTABLE])

  let CONNECTED_CARD_LT_IFF_TRIVIAL ← prove
   r"!s:real^N->bool. connected s ==> (s <_c (:real) <=> ?a. s SUBSET {a})"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_CARD_EQ_IFF_NONTRIVIAL) THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p <=> q) ==> (p <=> ~r) ==> (q <=> r)")) THEN
    REWRITE_TAC [← GSYM CARD_LE_ANTISYM, CARD_NOT_LE, DE_MORGAN_THM] THEN
    MATCH_MP_TAC (← TAUT (← q r"~p ==> (p \/ q <=> q)")) THEN REWRITE_TAC [CARD_NOT_LT] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
    REWRITE_TAC [CARD_LE_UNIV] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
    REWRITE_TAC [CARD_EQ_EUCLIDEAN])

  return { CARD_EQ_EUCLIDEAN, UNCOUNTABLE_EUCLIDEAN, CARD_EQ_INTERVAL, UNCOUNTABLE_INTERVAL,
           COUNTABLE_OPEN_INTERVAL, CARD_EQ_OPEN, UNCOUNTABLE_OPEN, CARD_EQ_BALL, CARD_EQ_CBALL,
           FINITE_IMP_NOT_OPEN, OPEN_IMP_INFINITE, EMPTY_INTERIOR_FINITE, FINITE_CBALL,
           FINITE_BALL, CARD_EQ_CONNECTED, UNCOUNTABLE_CONNECTED, CARD_LT_IMP_DISCONNECTED,
           COUNTABLE_IMP_DISCONNECTED, CONNECTED_CARD_EQ_IFF_NONTRIVIAL,
           CONNECTED_CARD_LT_IFF_TRIVIAL }

/- ------------------------------------------------------------------------- -/
/- Cardinalities, continued; "iff" forms of constancy of functions from    -/
/- connected sets into small sets.  (topology.ml 17740-17937)                -/
/- ------------------------------------------------------------------------- -/

structure CRD2 where
  SMALL_IMP_TOTALLY_DISCONNECTED : thm
  FINITE_IMP_TOTALLY_DISCONNECTED : thm
  CONTINUOUS_DISCONNECTED_RANGE_CONSTANT_EQ : thm
  CONTINUOUS_DISCRETE_RANGE_CONSTANT_EQ : thm
  CONTINUOUS_FINITE_RANGE_CONSTANT_EQ : thm
  CONTINUOUS_DISCONNECTED_RANGE_CONSTANT : thm
  CONTINUOUS_DISCRETE_RANGE_CONSTANT : thm
  CONTINUOUS_FINITE_RANGE_CONSTANT : thm
  CONTINUOUS_COUNTABLE_RANGE_CONSTANT_EQ : thm
  CONTINUOUS_CARD_LT_RANGE_CONSTANT_EQ : thm
  CONTINUOUS_COUNTABLE_RANGE_CONSTANT : thm
  CONTINUOUS_CARD_LT_RANGE_CONSTANT : thm
  deriving Inhabited

@[nospecialize]
def setupCRD2 [HolBase] (D : TopologyDeps) (BCLO : CLO) (BBAL : BAL) (BCON : CON) (BCBL : CBL)
    (BCMS : CMS) (BLCP : LCP) (BCCM1 : CCM1) (BCPN1 : CPN1) (BLRU : LRU) (BCRD1 : CRD1) :
    ExceptT String IO CRD2 := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_RULE, SET_TAC, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, CONTRAPOS_THM, DIMINDEX_GE_1, EXISTS_IN_IMAGE, FINITE_DELETE,
        FINITE_EMPTY, FINITE_IMAGE, FINITE_INSERT, .. } := D.core1
  let { FINITE_SUBSET, FORALL_IN_IMAGE, FUN_IN_IMAGE, IMAGE_EQ, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_IMP,
        IN, IN_DELETE, IN_DIFF, IN_IMAGE, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY, MONO_FORALL, NOT_IMP,
        NOT_IN_EMPTY, .. } := D.core3
  let { REAL_INF_LE_FINITE, REAL_LE_REFL, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_INF_FINITE, .. } :=
    D.core4
  let { REAL_NOT_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, SUBSET_REFL, .. } := D.core5
  let { SWAP_FORALL_THM, .. } := D.core6
  let { CARD_LET_TRANS, CARD_LE_SUBSET, COUNTABLE_IMP_CARD_LT_REAL, FINITE_IMP_COUNTABLE, .. } :=
    D.lib1
  let { REAL_HALF, .. } := D.misc
  let { BASIS_NONZERO, DIST_SYM, .. } := D.vec1
  let { NORM_POS_LT, .. } := D.vec3
  let { VECTOR_SUB_EQ, dist, .. } := D.vec4
  let { OPEN_CLOSED, .. } := BCLO
  let { CENTRE_IN_CBALL, IN_BALL, IN_CBALL, OPEN_BALL, .. } := BBAL
  let { CONNECTED_CLOSED, CONNECTED_CLOSED_IN_EQ, .. } := BCON
  let { CLOSED_CBALL, .. } := BCBL
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONNECTED_CONTINUOUS_IMAGE, .. } := BLCP
  let { CONNECTED_COMPONENT_MAXIMAL, CONNECTED_COMPONENT_REFL_EQ, CONNECTED_COMPONENT_SUBSET,
        CONNECTED_CONNECTED_COMPONENT, .. } := BCCM1
  let { components, .. } := BCPN1
  let { CONTINUOUS_ON_CASES_LOCAL, .. } := BLRU
  let { CARD_LT_IMP_DISCONNECTED, CONNECTED_CARD_LT_IFF_TRIVIAL, COUNTABLE_IMP_DISCONNECTED,
        .. } := BCRD1
  -- @@SCOPE END

  let SMALL_IMP_TOTALLY_DISCONNECTED ← prove
   r"!s:real^N->bool. s <_c (:real) ==> components s = IMAGE (\x. {x}) s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [components, SIMPLE_IMAGE] THEN
    MATCH_MP_TAC IMAGE_EQ THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s x /\ (?a. s SUBSET {a}) ==> s = {x}")) THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
    SIMP_TAC [← GSYM CONNECTED_CARD_LT_IFF_TRIVIAL,
              CONNECTED_CONNECTED_COMPONENT] THEN
    TRANS_TAC CARD_LET_TRANS (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CARD_LE_SUBSET THEN REWRITE_TAC [CONNECTED_COMPONENT_SUBSET])

  let FINITE_IMP_TOTALLY_DISCONNECTED ← prove
   r"!s:real^N->bool. FINITE s ==> components s = IMAGE (\x. {x}) s"
   (SIMP_TAC [SMALL_IMP_TOTALLY_DISCONNECTED, FINITE_IMP_COUNTABLE,
              COUNTABLE_IMP_CARD_LT_REAL])

  let (CONTINUOUS_DISCONNECTED_RANGE_CONSTANT_EQ, CONTINUOUS_DISCRETE_RANGE_CONSTANT_EQ,
       CONTINUOUS_FINITE_RANGE_CONSTANT_EQ) ←
    match CONJUNCTS (← prove
     r"(!s. connected s <=>
           !f:real^M->real^N t.
              f continuous_on s /\ IMAGE f s SUBSET t /\
              (!y. y IN t ==> connected_component t y = {y})
              ==> ?a. !x. x IN s ==> f x = a) /\
      (!s. connected s <=>
           !f:real^M->real^N.
              f continuous_on s /\
              (!x. x IN s
                   ==> ?e. &0 < e /\
                           !y. y IN s /\ ~(f y = f x) ==> e <= norm(f y - f x))
              ==> ?a. !x. x IN s ==> f x = a) /\
      (!s. connected s <=>
           !f:real^M->real^N.
              f continuous_on s /\ FINITE(IMAGE f s)
              ==> ?a. !x. x IN s ==> f x = a)"
     (REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"s:real^M->bool") THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(s ==> t) /\ (t ==> u) /\ (u ==> v) /\ (v ==> s)
        ==> (s <=> t) /\ (s <=> u) /\ (s <=> v)")) THEN
      REPEAT CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
        ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
        FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"x:real^M") o
            GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        EXISTS_TAC (← q r"(f:real^M->real^N) x") THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"IMAGE f s SUBSET {a} ==> !y. y IN s ==> f y = a")) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(f:real^M->real^N) x")) THEN
        ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
        MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
        ASM_SIMP_TAC [CONNECTED_CONTINUOUS_IMAGE] THEN ASM SET_TAC [],
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) s") THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE, SUBSET_REFL] THEN
        X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!y. y IN s /\ f y IN connected_component (IMAGE f s) a ==> f y = a) /\
          connected_component (IMAGE f s) a SUBSET (IMAGE f s) /\
          connected_component (IMAGE f s) a a
          ==> connected_component (IMAGE f s) a = {a}")) THEN
        REWRITE_TAC [CONNECTED_COMPONENT_SUBSET, CONNECTED_COMPONENT_REFL_EQ] THEN
        ASM_SIMP_TAC [FUN_IN_IMAGE] THEN X_GEN_TAC (← q r"y:real^M") THEN STRIP_TAC THEN
        MP_TAC (← ISPEC (← q r"connected_component (IMAGE (f:real^M->real^N) s) (f x)")
            CONNECTED_CLOSED) THEN
        REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT] THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
        ASM_REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC
         [← q r"cball((f:real^M->real^N) x,e / &2)",
          ← q r"(:real^N) DIFF ball((f:real^M->real^N) x,e)"] THEN
        REWRITE_TAC [← GSYM OPEN_CLOSED, OPEN_BALL, CLOSED_CBALL] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN REPEAT CONJ_TAC THENL
         [REWRITE_TAC [SUBSET, IN_CBALL, IN_UNION, IN_DIFF, IN_BALL, IN_UNIV] THEN
          MATCH_MP_TAC (← MESON [SUBSET, CONNECTED_COMPONENT_SUBSET]
           (← q r"(!x. x IN s ==> P x)
            ==> (!x. x IN connected_component s y ==> P x)")) THEN
          REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"z:real^M") THEN
          DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:real^M")) THEN
          ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t),
          MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. x IN s /\ x IN t ==> F) ==> s INTER t INTER u = {}")) THEN
          REWRITE_TAC [IN_BALL, IN_CBALL, IN_DIFF, IN_UNIV] THEN
          UNDISCH_TAC (← q r"&0 < e") THEN CONV_TAC (fun t => NORM_ARITH t),
          EXISTS_TAC (← q r"(f:real^M->real^N) x") THEN
          ASM_SIMP_TAC [CENTRE_IN_CBALL, REAL_HALF, REAL_LT_IMP_LE, IN_INTER] THEN
          REWRITE_TAC [IN] THEN
          ASM_SIMP_TAC [CONNECTED_COMPONENT_REFL_EQ, FUN_IN_IMAGE],
          EXISTS_TAC (← q r"(f:real^M->real^N) y") THEN
          ASM_REWRITE_TAC [IN_INTER, IN_DIFF, IN_UNIV, IN_BALL, REAL_NOT_LT] THEN
          ASM_SIMP_TAC [← ONCE_REWRITE_RULE [DIST_SYM] dist]],
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"f:real^M->real^N") THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MATCH_MP_TAC th) THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"IMAGE (f:real^M->real^N) s DELETE (f x) = {}") THENL
         [EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN ASM SET_TAC [],
          ALL_TAC] THEN
        EXISTS_TAC
         (← q r"inf{norm(z - f x) |z| z IN IMAGE (f:real^M->real^N) s DELETE (f x)}") THEN
        REWRITE_TAC [SIMPLE_IMAGE] THEN
        ASM_SIMP_TAC [REAL_LT_INF_FINITE, REAL_INF_LE_FINITE, FINITE_DELETE,
                      FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
        REWRITE_TAC [IN_DELETE, NORM_POS_LT, VECTOR_SUB_EQ, IN_IMAGE] THEN
        MESON_TAC [REAL_LE_REFL],
        REWRITE_TAC [CONNECTED_CLOSED_IN_EQ] THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"t:real^M->bool", ← q r"u:real^M->bool"] THEN
        STRIP_TAC THEN DISCH_THEN (MP_TAC o SPEC
         (← q r"(\x. if x IN t then vec 0 else basis 1):real^M->real^N")) THEN
        REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
         [EXPAND_TAC "s" THEN MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
          ASM_REWRITE_TAC [CONTINUOUS_ON_CONST] THEN ASM SET_TAC [],
          MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{vec 0:real^N,basis 1}") THEN
          REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY] THEN SET_TAC [],
          SUBGOAL_THEN (← q r"?a b:real^M. a IN s /\ a IN t /\ b IN s /\ ~(b IN t)")
          STRIP_ASSUME_TAC THENL
           [ASM SET_TAC [], DISCH_THEN (CHOOSE_THEN MP_TAC)] THEN
          DISCH_THEN (fun th => tactic_of do
            pure (MP_TAC (← SPEC (← q r"a:real^M") th) THEN
                  MP_TAC (← SPEC (← q r"b:real^M") th))) THEN
          ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
          CONV_TAC (RAND_CONV SYM_CONV) THEN
          SIMP_TAC [BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1, REAL_LE_REFL]]])) with
    | [a, b, c] => pure (a, b, c)
    | _ => throw "CONTINUOUS_DISCONNECTED_RANGE_CONSTANT_EQ: expected three conjuncts"

  let CONTINUOUS_DISCONNECTED_RANGE_CONSTANT ← prove
   r"!f:real^M->real^N s.
        connected s /\
        f continuous_on s /\ IMAGE f s SUBSET t /\
        (!y. y IN t ==> connected_component t y = {y})
        ==> ?a. !x. x IN s ==> f x = a"
   (MESON_TAC [CONTINUOUS_DISCONNECTED_RANGE_CONSTANT_EQ])

  let CONTINUOUS_DISCRETE_RANGE_CONSTANT ← prove
   r"!f:real^M->real^N s.
        connected s /\
        f continuous_on s /\
        (!x. x IN s
             ==> ?e. &0 < e /\
                     !y. y IN s /\ ~(f y = f x) ==> e <= norm(f y - f x))
        ==> ?a. !x. x IN s ==> f x = a"
   (ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONTINUOUS_DISCRETE_RANGE_CONSTANT_EQ])

  let CONTINUOUS_FINITE_RANGE_CONSTANT ← prove
   r"!f:real^M->real^N s.
        connected s /\
        f continuous_on s /\
        FINITE(IMAGE f s)
        ==> ?a. !x. x IN s ==> f x = a"
   (MESON_TAC [CONTINUOUS_FINITE_RANGE_CONSTANT_EQ])

  let CONTINUOUS_COUNTABLE_RANGE_CONSTANT_EQ ← prove
   r"!s. connected s <=>
         !f:real^M->real^N.
            f continuous_on s /\ COUNTABLE(IMAGE f s)
            ==> ?a. !x. x IN s ==> f x = a"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [CONTINUOUS_DISCONNECTED_RANGE_CONSTANT_EQ],
      REWRITE_TAC [CONTINUOUS_FINITE_RANGE_CONSTANT_EQ]] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [FINITE_IMP_COUNTABLE] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) s") THEN
    ASM_SIMP_TAC [COUNTABLE_IMP_DISCONNECTED, SUBSET_REFL])

  let CONTINUOUS_CARD_LT_RANGE_CONSTANT_EQ ← prove
   r"!s. connected s <=>
         !f:real^M->real^N.
            f continuous_on s /\ (IMAGE f s) <_c (:real)
            ==> ?a. !x. x IN s ==> f x = a"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [CONTINUOUS_DISCONNECTED_RANGE_CONSTANT_EQ],
      REWRITE_TAC [CONTINUOUS_COUNTABLE_RANGE_CONSTANT_EQ]] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [COUNTABLE_IMP_CARD_LT_REAL] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) s") THEN
    ASM_SIMP_TAC [CARD_LT_IMP_DISCONNECTED, SUBSET_REFL])

  let CONTINUOUS_COUNTABLE_RANGE_CONSTANT ← prove
   r"!f:real^M->real^N s.
        connected s /\ f continuous_on s /\ COUNTABLE(IMAGE f s)
        ==> ?a. !x. x IN s ==> f x = a"
   (MESON_TAC [CONTINUOUS_COUNTABLE_RANGE_CONSTANT_EQ])

  let CONTINUOUS_CARD_LT_RANGE_CONSTANT ← prove
   r"!f:real^M->real^N s.
        connected s /\ f continuous_on s /\ (IMAGE f s) <_c (:real)
        ==> ?a. !x. x IN s ==> f x = a"
   (MESON_TAC [CONTINUOUS_CARD_LT_RANGE_CONSTANT_EQ])

  return { SMALL_IMP_TOTALLY_DISCONNECTED, FINITE_IMP_TOTALLY_DISCONNECTED,
           CONTINUOUS_DISCONNECTED_RANGE_CONSTANT_EQ, CONTINUOUS_DISCRETE_RANGE_CONSTANT_EQ,
           CONTINUOUS_FINITE_RANGE_CONSTANT_EQ, CONTINUOUS_DISCONNECTED_RANGE_CONSTANT,
           CONTINUOUS_DISCRETE_RANGE_CONSTANT, CONTINUOUS_FINITE_RANGE_CONSTANT,
           CONTINUOUS_COUNTABLE_RANGE_CONSTANT_EQ, CONTINUOUS_CARD_LT_RANGE_CONSTANT_EQ,
           CONTINUOUS_COUNTABLE_RANGE_CONSTANT, CONTINUOUS_CARD_LT_RANGE_CONSTANT }

/- ------------------------------------------------------------------------- -/
/- Homeomorphism of hyperplanes.  (topology.ml 17938-18018)                  -/
/- ------------------------------------------------------------------------- -/

structure HYP where
  HOMEOMORPHIC_HYPERPLANES : thm
  HOMEOMORPHIC_HYPERPLANE_STANDARD_HYPERPLANE : thm
  HOMEOMORPHIC_STANDARD_HYPERPLANE_HYPERPLANE : thm
  HOMEOMORPHIC_HYPERPLANE_UNIV : thm
  deriving Inhabited

@[nospecialize]
def setupHYP [HolBase] (D : TopologyDeps) (BLCP : LCP) (BHMA : HMA) : ExceptT String IO HYP := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, REAL_ARITH_TAC, GEOM_BASIS_MULTIPLE_TAC, GEOM_ORIGIN_TAC, .. } :=
    D
  let { CART_EQ, COND_ID, DE_MORGAN_THM, DIMINDEX_GE_1, .. } := D.core1
  let { FORALL_IN_IMAGE, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LAMBDA_BETA, LE_REFL, NOT_FORALL_THM, NOT_IMP, REAL_ADD_RID, .. } := D.core3
  let { REAL_DIV_RMUL, REAL_ENTIRE, REAL_EQ_ADD_LCANCEL_0, .. } := D.core4
  let { SUBSET, SUBSET_UNIV, .. } := D.core5
  let { BASIS_NONZERO, DOT_BASIS, DOT_LMUL, DOT_RADD, DOT_RMUL, DOT_RZERO, .. } := D.vec1
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_RID, VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0,
        VEC_COMPONENT, linear, .. } := D.vec4
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { HOMEOMORPHIC_REFL, HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM, homeomorphic,
        .. } := BHMA
  -- @@SCOPE END

  let HOMEOMORPHIC_HYPERPLANES ← do
    let lemma ← prove
     r"~(a = vec 0)
       ==> {x:real^N | a dot x = b} homeomorphic {x:real^N | x$1 = &0}"
     (REPEAT STRIP_TAC THEN SUBGOAL_THEN (← q r"?c:real^N. a dot c = b")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CART_EQ]) THEN
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, VEC_COMPONENT] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"b / (a:real^N)$k % basis k:real^N") THEN
        ASM_SIMP_TAC [DOT_RMUL, DOT_BASIS, REAL_DIV_RMUL],
        FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        ABBREV_TAC (← q r"p = {x:real^N | x$1 = &0}") THEN
        GEOM_ORIGIN_TAC (← q r"c:real^N") THEN
        REWRITE_TAC [VECTOR_ADD_RID, DOT_RADD, DOT_RZERO, REAL_EQ_ADD_LCANCEL_0,
                     REAL_ADD_RID] THEN
        REPEAT STRIP_TAC THEN UNDISCH_TAC (← q r"~(a:real^N = vec 0)") THEN
        GEOM_BASIS_MULTIPLE_TAC 1 (← q r"a:real^N") THEN
        SIMP_TAC [VECTOR_MUL_EQ_0, DE_MORGAN_THM, DOT_LMUL, REAL_ENTIRE] THEN
        SIMP_TAC [DOT_BASIS, LE_REFL, DIMINDEX_GE_1] THEN
        EXPAND_TAC "p" THEN REWRITE_TAC [HOMEOMORPHIC_REFL]])
    prove
     r"!a:real^N b c:real^N d.
        ~(a = vec 0) /\ ~(c = vec 0)
        ==> {x | a dot x = b} homeomorphic {x | c dot x = d}"
     (REPEAT STRIP_TAC THEN
      TRANS_TAC HOMEOMORPHIC_TRANS (← q r"{x:real^N | x$1 = &0}") THEN
      ASM_SIMP_TAC [lemma] THEN ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
      ASM_SIMP_TAC [lemma])

  let HOMEOMORPHIC_HYPERPLANE_STANDARD_HYPERPLANE ← prove
   r"!a:real^N b k c.
        ~(a = vec 0) /\ 1 <= k /\ k <= dimindex(:N)
        ==> {x | a dot x = b} homeomorphic {x:real^N | x$k = c}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"{x:real^N | x$k = c} = {x | basis k dot x = c}") SUBST1_TAC
    THENL [ASM_SIMP_TAC [DOT_BASIS], MATCH_MP_TAC HOMEOMORPHIC_HYPERPLANES] THEN
    ASM_SIMP_TAC [BASIS_NONZERO])

  let HOMEOMORPHIC_STANDARD_HYPERPLANE_HYPERPLANE ← prove
   r"!a:real^N b k c.
        ~(a = vec 0) /\ 1 <= k /\ k <= dimindex(:N)
        ==> {x:real^N | x$k = c} homeomorphic {x | a dot x = b}"
   (ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
    REWRITE_TAC [HOMEOMORPHIC_HYPERPLANE_STANDARD_HYPERPLANE])

  let HOMEOMORPHIC_HYPERPLANE_UNIV ← prove
   r"!a b. ~(a = vec 0) /\ dimindex(:N) = dimindex(:M) + 1
         ==> {x:real^N | a dot x = b} homeomorphic (:real^M)"
   (REPEAT STRIP_TAC THEN TRANS_TAC HOMEOMORPHIC_TRANS
     (← q r"{x:real^N | basis(dimindex(:N)) dot x = &0}") THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_HYPERPLANES, BASIS_NONZERO,
                  LE_REFL, DIMINDEX_GE_1] THEN
    REWRITE_TAC [homeomorphic, HOMEOMORPHISM] THEN
    EXISTS_TAC (← q r"(\x. lambda i. x$i):real^N->real^M") THEN
    EXISTS_TAC (← q r"(\x. lambda i. if i <= dimindex(:M) then x$i else &0)
                :real^M->real^N") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
      SIMP_TAC [linear, CART_EQ, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                VECTOR_MUL_COMPONENT],
      REWRITE_TAC [SUBSET_UNIV],
      MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
      SIMP_TAC [linear, CART_EQ, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                VECTOR_MUL_COMPONENT] THEN
      REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      REAL_ARITH_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_UNIV] THEN
      ASM_SIMP_TAC [DOT_BASIS, LAMBDA_BETA, LE_REFL, ← ARITH_RULE (← q r"1 <= n + 1"),
                    ← ARITH_RULE (← q r"~(m + 1 <= m)")],
      ASM_SIMP_TAC [IN_ELIM_THM, LAMBDA_BETA, DOT_BASIS, LE_REFL, CART_EQ,
                    ← ARITH_RULE (← q r"1 <= n + 1")] THEN
      GEN_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN
      ASM_CASES_TAC (← q r"i = dimindex(:M) + 1") THEN ASM_REWRITE_TAC [COND_ID] THEN
      COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM_ARITH_TAC,
      ASM_SIMP_TAC [LAMBDA_BETA, CART_EQ, IN_UNIV, LE_REFL,
                    ← ARITH_RULE (← q r"i <= n ==> i <= n + 1")]])

  return { HOMEOMORPHIC_HYPERPLANES, HOMEOMORPHIC_HYPERPLANE_STANDARD_HYPERPLANE,
           HOMEOMORPHIC_STANDARD_HYPERPLANE_HYPERPLANE, HOMEOMORPHIC_HYPERPLANE_UNIV }

/- ------------------------------------------------------------------------- -/
/- "Isometry" (up to constant bounds) of injective linear map etc.          -/
/- (topology.ml 18019-18122)                                                 -/
/- ------------------------------------------------------------------------- -/

structure ISM where
  CAUCHY_ISOMETRIC : thm
  COMPLETE_ISOMETRIC_IMAGE : thm
  INJECTIVE_IMP_ISOMETRIC : thm
  CLOSED_INJECTIVE_IMAGE_SUBSPACE : thm
  deriving Inhabited

@[nospecialize]
def setupISM [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLPT : LPT) (BCBL : CBL) (BCPT : CPT)
    (BCMP : CMP) (BCPP1 : CPP1) (BCPP2 : CPP2) (BSQC : SQC) (BLCP : LCP) (BDST : DST) :
    ExceptT String IO ISM := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, .. } := D
  let { EXISTS_IN_IMAGE, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_IMAGE, FUN_EQ_THM, IN_ELIM_THM, IN_IMAGE, IN_SING, .. } :=
    D.core2
  let { MEMBER_NOT_EMPTY, NOT_FORALL_THM, NOT_IMP, REAL_ABS_DIV, .. } := D.core3
  let { REAL_DIV_RMUL, REAL_LET_TRANS, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LT_01, REAL_LT_DIV, REAL_LT_LDIV_EQ, REAL_LT_MUL, .. } := D.core4
  let { REAL_MUL_AC, REAL_MUL_LID, REAL_MUL_RZERO, REAL_MUL_SYM, SKOLEM_THM, SUBSET, .. } :=
    D.core5
  let { o_DEF, o_THM, real_div, real_ge, .. } := D.core6
  let { LINEAR_0, LINEAR_CMUL, LINEAR_SUB, .. } := D.vec2
  let { NORM_0, NORM_EQ_0, NORM_MUL, NORM_NEG, NORM_POS_LT, REAL_ABS_NORM, SUBSPACE_SUB, .. } :=
    D.vec3
  let { VECTOR_SUB_LZERO, dist, subspace, .. } := D.vec4
  let { sphere, .. } := BBAL
  let { CLOSED_LIMPT, LIMPT_APPROACHABLE, .. } := BLPT
  let { FRONTIER_CBALL, .. } := BCBL
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { CAUCHY, COMPLETE_EQ_CLOSED, complete, .. } := BCMP
  let { CLOSED_INTER_COMPACT, .. } := BCPP1
  let { COMPACT_CBALL, COMPACT_FRONTIER, .. } := BCPP2
  let { CONTINUOUS_AT_SEQUENTIALLY, .. } := BSQC
  let { COMPACT_CONTINUOUS_IMAGE, LINEAR_CONTINUOUS_AT, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { DISTANCE_ATTAINS_INF, .. } := BDST
  -- @@SCOPE END

  let CAUCHY_ISOMETRIC ← prove
   r"!f s e x.
        &0 < e /\ subspace s /\
        linear f /\ (!x. x IN s ==> norm(f x) >= e * norm(x)) /\
        (!n. x(n) IN s) /\ cauchy(f o x)
        ==> cauchy x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_ge] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [CAUCHY, dist, o_THM] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_SUB th)])) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THEN MP_TAC th)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"d * e")) THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    ASM_MESON_TAC [REAL_LE_RDIV_EQ, REAL_MUL_SYM, REAL_LET_TRANS, SUBSPACE_SUB,
                   REAL_LT_LDIV_EQ])

  let COMPLETE_ISOMETRIC_IMAGE ← prove
   r"!f:real^M->real^N s e.
        &0 < e /\ subspace s /\
        linear f /\ (!x. x IN s ==> norm(f x) >= e * norm(x)) /\
        complete s
        ==> complete(IMAGE f s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [complete, EXISTS_IN_IMAGE] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"g:num->real^N") THEN
    REWRITE_TAC [IN_IMAGE, SKOLEM_THM, FORALL_AND_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:num->real^M") MP_TAC) THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM FUN_EQ_THM] THEN
    REWRITE_TAC [← GSYM o_DEF] THEN
    DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->real^M")) THEN
    ASM_MESON_TAC [CAUCHY_ISOMETRIC, LINEAR_CONTINUOUS_AT,
                   CONTINUOUS_AT_SEQUENTIALLY])

  let INJECTIVE_IMP_ISOMETRIC ← prove
   r"!f:real^M->real^N s.
        closed s /\ subspace s /\
        linear f /\ (!x. x IN s /\ (f x = vec 0) ==> (x = vec 0))
        ==> ?e. &0 < e /\ !x. x IN s ==> norm(f x) >= e * norm(x)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s SUBSET {vec 0 :real^M}") THENL
     [EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01, REAL_MUL_LID, real_ge] THEN
      ASM_MESON_TAC [SUBSET, IN_SING, NORM_0, LINEAR_0, REAL_LE_REFL],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [SUBSET]) THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, IN_SING] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^M") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"{(f:real^M->real^N) x | x IN s /\ norm(x) = norm(a:real^M)}",
      ← q r"vec 0:real^N"] DISTANCE_ATTAINS_INF) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
      SUBST1_TAC (← SET_RULE
       (← q r"{f x | x IN s /\ norm(x) = norm(a:real^M)} =
        IMAGE (f:real^M->real^N) (s INTER {x | norm x = norm a})")) THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN
      MATCH_MP_TAC CLOSED_INTER_COMPACT THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"{x:real^M | norm x = norm(a:real^M)} = frontier(cball(vec 0,norm a))")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [FRONTIER_CBALL, NORM_POS_LT, dist, VECTOR_SUB_LZERO,
                      NORM_NEG, sphere],
        ASM_SIMP_TAC [COMPACT_FRONTIER, COMPACT_CBALL]],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"{f x | P x} = IMAGE f {x | P x}")] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^M") MP_TAC) THEN
    REWRITE_TAC [IN_ELIM_THM, dist, VECTOR_SUB_LZERO, NORM_NEG] THEN
    STRIP_TAC THEN REWRITE_TAC [CLOSED_LIMPT, LIMPT_APPROACHABLE] THEN
    EXISTS_TAC (← q r"norm((f:real^M->real^N) b) / norm(b)") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_LT_DIV, NORM_POS_LT, NORM_EQ_0], ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"x:real^M = vec 0") THENL
     [FIRST_ASSUM (fun th => tactic_of do
        pure (ASM_REWRITE_TAC [← MATCH_MP LINEAR_0 th])) THEN
      REWRITE_TAC [NORM_0, REAL_MUL_RZERO, real_ge, REAL_LE_REFL],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(norm(a:real^M) / norm(x)) % x:real^M")) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0] THEN ASM_MESON_TAC [subspace],
      ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP LINEAR_CMUL th])) THEN
    ASM_REWRITE_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM, real_ge] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, NORM_POS_LT] THEN
    REWRITE_TAC [real_div, REAL_MUL_AC])

  let CLOSED_INJECTIVE_IMAGE_SUBSPACE ← prove
   r"!f s. subspace s /\
         linear f /\
         (!x. x IN s /\ f(x) = vec 0 ==> x = vec 0) /\
         closed s
         ==> closed(IMAGE f s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM COMPLETE_EQ_CLOSED] THEN
    MATCH_MP_TAC COMPLETE_ISOMETRIC_IMAGE THEN
    ASM_REWRITE_TAC [COMPLETE_EQ_CLOSED] THEN
    MATCH_MP_TAC INJECTIVE_IMP_ISOMETRIC THEN
    ASM_REWRITE_TAC [])

  return { CAUCHY_ISOMETRIC, COMPLETE_ISOMETRIC_IMAGE, INJECTIVE_IMP_ISOMETRIC,
           CLOSED_INJECTIVE_IMAGE_SUBSPACE }

/- ------------------------------------------------------------------------- -/
/- Relating linear images to open/closed/interior/closure.                 -/
/- (topology.ml 18123-18285)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LIO where
  OPEN_SURJECTIVE_LINEAR_IMAGE : thm
  OPEN_BIJECTIVE_LINEAR_IMAGE_EQ : thm
  OPEN_INVERTIBLE_LINEAR_IMAGE : thm
  CLOSED_INJECTIVE_LINEAR_IMAGE : thm
  CLOSED_INJECTIVE_LINEAR_IMAGE_EQ : thm
  CLOSURE_LINEAR_IMAGE_SUBSET : thm
  CLOSURE_INJECTIVE_LINEAR_IMAGE : thm
  CLOSURE_BOUNDED_LINEAR_IMAGE : thm
  LINEAR_INTERIOR_IMAGE_SUBSET : thm
  LINEAR_IMAGE_SUBSET_INTERIOR : thm
  INTERIOR_BIJECTIVE_LINEAR_IMAGE : thm
  FRONTIER_BIJECTIVE_LINEAR_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupLIO [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BINT : INT)
    (BCLS1 : CLS1) (BFRO1 : FRO1) (BBND1 : BND1) (BCPT : CPT) (BCLC : CLC) (BLCP : LCP)
    (BINV : INV) (BCLB : CLB) (BISM : ISM) : ExceptT String IO LIO := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_TAC, VECTOR_ARITH_TAC, NORM_ARITH,
        add_linear_invariants, GEOM_TRANSFORM_TAC, .. } := D
  let { CARD_NUMSEG_1, DIMINDEX_GE_1, EQ_IMP, EXTENSION, FINITE_IMAGE, FINITE_NUMSEG, .. } :=
    D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_I, IMAGE_SUBSET, IMAGE_o, IMP_CONJ, IN_IMAGE,
        IN_NUMSEG, .. } := D.core2
  let { IN_UNIV, I_THM, LE_1, MONO_FORALL, REAL_ABS_POS, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_MUL2, REAL_LT_DIV, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_OF_NUM_LT, RIGHT_FORALL_IMP_THM, SKOLEM_THM, SUBSET_ANTISYM, .. } := D.core5
  let { SUM_BOUND, o_DEF, o_THM, .. } := D.core6
  let { BASIS_EXPANSION, COMPONENT_LE_NORM, .. } := D.vec1
  let { LINEAR_0, LINEAR_ADD, LINEAR_CMUL, LINEAR_INJECTIVE_LEFT_INVERSE, LINEAR_VSUM,
        MATRIX_INVERTIBLE, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, SUBSPACE_UNIV, .. } := D.vec3
  let { VSUM_NORM_TRIANGLE, dist, .. } := D.vec4
  let { open_def, .. } := BEUC
  let { CLOSED_UNIV, .. } := BCLO
  let { CLOSED_IN_CLOSED_TRANS, .. } := BLOC
  let { INTERIOR_MAXIMAL, INTERIOR_SUBSET, OPEN_INTERIOR, interior, .. } := BINT
  let { CLOSED_CLOSURE, CLOSURE_MINIMAL, CLOSURE_SUBSET, .. } := BCLS1
  let { frontier, .. } := BFRO1
  let { BOUNDED_POS, FINITE_IMP_BOUNDED, .. } := BBND1
  let { COMPACT_CLOSURE, COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_CLOSED_PREIMAGE_UNIV,
        CONTINUOUS_OPEN_PREIMAGE_UNIV, .. } := BCLC
  let { COMPACT_LINEAR_IMAGE, LINEAR_CONTINUOUS_AT, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { INTERIOR_IMAGE_SUBSET, .. } := BINV
  let { IMAGE_CLOSURE_SUBSET, .. } := BCLB
  let { CLOSED_INJECTIVE_IMAGE_SUBSPACE, .. } := BISM
  -- @@SCOPE END

  let OPEN_SURJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N.
        linear f /\ (!y. ?x. f x = y)
        ==> !s. open s ==> open(IMAGE f s)"
   (GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [open_def, FORALL_IN_IMAGE] THEN
    FIRST_ASSUM (MP_TAC o GEN (← q r"k:num") o SPEC (← q r"basis k:real^N")) THEN
    REWRITE_TAC [SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:num->real^M") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"bounded(IMAGE (b:num->real^M) (1..dimindex(:N)))") MP_TAC THENL
     [SIMP_TAC [FINITE_IMP_BOUNDED, FINITE_IMAGE, FINITE_NUMSEG], ALL_TAC] THEN
    REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE, IN_NUMSEG] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    X_GEN_TAC (← q r"s:real^M->bool") THEN MATCH_MP_TAC MONO_FORALL THEN
    X_GEN_TAC (← q r"x:real^M") THEN ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"e / B / &(dimindex(:N))") THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, DIMINDEX_GE_1, LE_1] THEN
    X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN REWRITE_TAC [IN_IMAGE] THEN
    ABBREV_TAC (← q r"u = y - (f:real^M->real^N) x") THEN
    EXISTS_TAC (← q r"x + vsum(1..dimindex(:N)) (\i. (u:real^N)$i % b i):real^M") THEN
    ASM_SIMP_TAC [LINEAR_ADD, LINEAR_VSUM, FINITE_NUMSEG, o_DEF,
                  LINEAR_CMUL, BASIS_EXPANSION] THEN
    CONJ_TAC THENL [EXPAND_TAC "u" THEN VECTOR_ARITH_TAC, ALL_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [← NORM_ARITH (← q r"dist(x + y,x) = norm y")] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"(dist(y,(f:real^M->real^N) x) * &(dimindex(:N))) * B") THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, REAL_OF_NUM_LT, DIMINDEX_GE_1, LE_1] THEN
    MATCH_MP_TAC VSUM_NORM_TRIANGLE THEN REWRITE_TAC [FINITE_NUMSEG] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"(a * b) * c:real = b * a * c")] THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o RAND_CONV) [← GSYM CARD_NUMSEG_1] THEN
    MATCH_MP_TAC SUM_BOUND THEN REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
    X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN REWRITE_TAC [NORM_MUL, dist] THEN
    MATCH_MP_TAC REAL_LE_MUL2 THEN REWRITE_TAC [REAL_ABS_POS, NORM_POS_LE] THEN
    ASM_SIMP_TAC [COMPONENT_LE_NORM])

  let OPEN_BIJECTIVE_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
        ==> (open(IMAGE f s) <=> open s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC, ASM_MESON_TAC [OPEN_SURJECTIVE_LINEAR_IMAGE]] THEN
    SUBGOAL_THEN (← q r"s = {x | (f:real^M->real^N) x IN IMAGE f s}")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_OPEN_PREIMAGE_UNIV THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_AT])

  add_linear_invariants [OPEN_BIJECTIVE_LINEAR_IMAGE_EQ]

  let OPEN_INVERTIBLE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ invertible(matrix f) /\ open s
        ==> open(IMAGE f s)"
   (SIMP_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, MATRIX_INVERTIBLE] THEN
    REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN GEN_TAC THEN REPEAT DISCH_TAC THEN
    MATCH_MP_TAC OPEN_SURJECTIVE_LINEAR_IMAGE THEN ASM_MESON_TAC [])

  let CLOSED_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> !s. closed s ==> closed(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^M") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC CLOSED_IN_CLOSED_TRANS THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (:real^M)") THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"g:real^N->real^M",
                        ← q r"IMAGE (f:real^M->real^N) (:real^M)",
                        ← q r"IMAGE (g:real^N->real^M) (IMAGE (f:real^M->real^N) s)"]
          CONTINUOUS_CLOSED_IN_PREIMAGE) THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [← GSYM IMAGE_o, IMAGE_I], ALL_TAC] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FUN_EQ_THM]) THEN
      REWRITE_TAC [EXTENSION, o_THM, I_THM] THEN SET_TAC [],
      MATCH_MP_TAC CLOSED_INJECTIVE_IMAGE_SUBSPACE THEN
      ASM_REWRITE_TAC [IN_UNIV, SUBSPACE_UNIV, CLOSED_UNIV] THEN
      X_GEN_TAC (← q r"x:real^M") THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"g:real^N->real^M")) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [FUN_EQ_THM, I_THM, o_THM]) THEN
      ASM_MESON_TAC [LINEAR_0]])

  let CLOSED_INJECTIVE_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (closed(IMAGE f s) <=> closed s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC, ASM_MESON_TAC [CLOSED_INJECTIVE_LINEAR_IMAGE]] THEN
    SUBGOAL_THEN (← q r"s = {x | (f:real^M->real^N) x IN IMAGE f s}")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_AT])

  add_linear_invariants [CLOSED_INJECTIVE_LINEAR_IMAGE_EQ]

  let CLOSURE_LINEAR_IMAGE_SUBSET ← prove
   r"!f:real^M->real^N s.
        linear f ==> IMAGE f (closure s) SUBSET closure(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC IMAGE_CLOSURE_SUBSET THEN
    ASM_SIMP_TAC [CLOSED_CLOSURE, CLOSURE_SUBSET, LINEAR_CONTINUOUS_ON])

  let CLOSURE_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> closure(IMAGE f s) = IMAGE f (closure s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [CLOSURE_LINEAR_IMAGE_SUBSET] THEN
    MATCH_MP_TAC CLOSURE_MINIMAL THEN
    SIMP_TAC [CLOSURE_SUBSET, IMAGE_SUBSET] THEN
    ASM_MESON_TAC [CLOSED_INJECTIVE_LINEAR_IMAGE, CLOSED_CLOSURE])

  add_linear_invariants [CLOSURE_INJECTIVE_LINEAR_IMAGE]

  let CLOSURE_BOUNDED_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ bounded s
        ==> closure(IMAGE f s) = IMAGE f (closure s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [CLOSURE_LINEAR_IMAGE_SUBSET] THEN
    MATCH_MP_TAC CLOSURE_MINIMAL THEN
    SIMP_TAC [CLOSURE_SUBSET, IMAGE_SUBSET] THEN
    MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
    MATCH_MP_TAC COMPACT_LINEAR_IMAGE THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE])

  let LINEAR_INTERIOR_IMAGE_SUBSET ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
       ==> interior(IMAGE f s) SUBSET IMAGE f (interior s)"
   (MESON_TAC [INTERIOR_IMAGE_SUBSET, LINEAR_CONTINUOUS_AT])

  let LINEAR_IMAGE_SUBSET_INTERIOR ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!y. ?x. f x = y)
        ==> IMAGE f (interior s) SUBSET interior(IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERIOR_MAXIMAL THEN
    ASM_SIMP_TAC [OPEN_SURJECTIVE_LINEAR_IMAGE, OPEN_INTERIOR,
                  IMAGE_SUBSET, INTERIOR_SUBSET])

  let INTERIOR_BIJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
        ==> interior(IMAGE f s) = IMAGE f (interior s)"
   (REWRITE_TAC [interior] THEN GEOM_TRANSFORM_TAC [])

  add_linear_invariants [INTERIOR_BIJECTIVE_LINEAR_IMAGE]

  let FRONTIER_BIJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
        ==> frontier(IMAGE f s) = IMAGE f (frontier s)"
   (REWRITE_TAC [frontier] THEN GEOM_TRANSFORM_TAC [])

  add_linear_invariants [FRONTIER_BIJECTIVE_LINEAR_IMAGE]

  return { OPEN_SURJECTIVE_LINEAR_IMAGE, OPEN_BIJECTIVE_LINEAR_IMAGE_EQ,
           OPEN_INVERTIBLE_LINEAR_IMAGE, CLOSED_INJECTIVE_LINEAR_IMAGE,
           CLOSED_INJECTIVE_LINEAR_IMAGE_EQ, CLOSURE_LINEAR_IMAGE_SUBSET,
           CLOSURE_INJECTIVE_LINEAR_IMAGE, CLOSURE_BOUNDED_LINEAR_IMAGE,
           LINEAR_INTERIOR_IMAGE_SUBSET, LINEAR_IMAGE_SUBSET_INTERIOR,
           INTERIOR_BIJECTIVE_LINEAR_IMAGE, FRONTIER_BIJECTIVE_LINEAR_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Corollaries, reformulations and special cases for M = N.                -/
/- (topology.ml 18286-18435)                                                 -/
/- ------------------------------------------------------------------------- -/

structure COR where
  IN_INTERIOR_LINEAR_IMAGE : thm
  LINEAR_OPEN_MAPPING : thm
  INTERIOR_INJECTIVE_LINEAR_IMAGE : thm
  INTERIOR_SURJECTIVE_LINEAR_IMAGE : thm
  CLOSURE_SURJECTIVE_LINEAR_IMAGE : thm
  FRONTIER_INJECTIVE_LINEAR_IMAGE : thm
  FRONTIER_SURJECTIVE_LINEAR_IMAGE : thm
  COMPLETE_INJECTIVE_LINEAR_IMAGE : thm
  COMPLETE_INJECTIVE_LINEAR_IMAGE_EQ : thm
  LIMPT_INJECTIVE_LINEAR_IMAGE_EQ : thm
  LIMPT_TRANSLATION_EQ : thm
  OPEN_OPEN_LEFT_PROJECTION : thm
  OPEN_OPEN_RIGHT_PROJECTION : thm
  OPEN_MAP_FSTCART : thm
  OPEN_MAP_SNDCART : thm
  deriving Inhabited

@[nospecialize]
def setupCOR [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLPT : LPT) (BCMP : CMP) (BLIO : LIO) :
    ExceptT String IO COR := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, add_linear_invariants, add_translation_invariants,
        GEOM_TRANSLATE_TAC, .. } := D
  let { EQ_IMP, EXISTS_IN_IMAGE, EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, FUN_EQ_THM, IMP_IMP, IN_ELIM_THM, IN_IMAGE,
        IN_INTER, .. } := D.core2
  let { IN_UNIV, I_THM, MONO_AND, MONO_EXISTS, PASTECART_FST_SND, .. } := D.core3
  let { REAL_LE_RDIV_EQ, REAL_LT_DIV, REAL_LT_LDIV_EQ, REAL_LT_MUL, REAL_LT_RDIV_EQ, .. } :=
    D.core4
  let { REAL_MUL_SYM, RIGHT_IMP_FORALL_THM, SNDCART_PASTECART, SUBSET, .. } := D.core5
  let { o_THM, .. } := D.core6
  let { LINEAR_BOUNDED_POS, LINEAR_FSTCART, LINEAR_INJECTIVE_BOUNDED_BELOW_POS,
        LINEAR_INJECTIVE_IMP_SURJECTIVE, LINEAR_SNDCART, LINEAR_SUB,
        LINEAR_SURJECTIVE_IMP_INJECTIVE, .. } := D.vec2
  let { dist, .. } := D.vec4
  let { OPEN_INTER, OPEN_UNIV, .. } := BEUC
  let { LIMPT_APPROACHABLE, limit_point_of, .. } := BLPT
  let { COMPLETE_EQ_CLOSED, .. } := BCMP
  let { CLOSED_INJECTIVE_LINEAR_IMAGE, CLOSED_INJECTIVE_LINEAR_IMAGE_EQ,
        CLOSURE_INJECTIVE_LINEAR_IMAGE, FRONTIER_BIJECTIVE_LINEAR_IMAGE,
        INTERIOR_BIJECTIVE_LINEAR_IMAGE, LINEAR_IMAGE_SUBSET_INTERIOR,
        OPEN_SURJECTIVE_LINEAR_IMAGE, .. } := BLIO
  -- @@SCOPE END

  let IN_INTERIOR_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N g s x.
        linear f /\ linear g /\ (f o g = I) /\ x IN interior s
        ==> (f x) IN interior (IMAGE f s)"
   (REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
      LINEAR_IMAGE_SUBSET_INTERIOR) THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    ASM_MESON_TAC [])

  let LINEAR_OPEN_MAPPING ← prove
   r"!f:real^M->real^N g.
        linear f /\ linear g /\ (f o g = I)
        ==> !s. open s ==> open(IMAGE f s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC OPEN_SURJECTIVE_LINEAR_IMAGE THEN
    ASM_MESON_TAC [])

  let INTERIOR_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> interior(IMAGE f s) = IMAGE f (interior s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERIOR_BIJECTIVE_LINEAR_IMAGE THEN
    ASM_MESON_TAC [LINEAR_INJECTIVE_IMP_SURJECTIVE])

  let INTERIOR_SURJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!y. ?x. f x = y)
        ==> interior(IMAGE f s) = IMAGE f (interior s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERIOR_BIJECTIVE_LINEAR_IMAGE THEN
    ASM_MESON_TAC [LINEAR_SURJECTIVE_IMP_INJECTIVE])

  let CLOSURE_SURJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!y. ?x. f x = y)
        ==> closure(IMAGE f s) = IMAGE f (closure s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_INJECTIVE_LINEAR_IMAGE THEN
    ASM_MESON_TAC [LINEAR_SURJECTIVE_IMP_INJECTIVE])

  let FRONTIER_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> frontier(IMAGE f s) = IMAGE f (frontier s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FRONTIER_BIJECTIVE_LINEAR_IMAGE THEN
    ASM_MESON_TAC [LINEAR_INJECTIVE_IMP_SURJECTIVE])

  let FRONTIER_SURJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N.
        linear f /\ (!y. ?x. f x = y)
        ==> frontier(IMAGE f s) = IMAGE f (frontier s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FRONTIER_BIJECTIVE_LINEAR_IMAGE THEN
    ASM_MESON_TAC [LINEAR_SURJECTIVE_IMP_INJECTIVE])

  let COMPLETE_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> !s. complete s ==> complete(IMAGE f s)"
   (REWRITE_TAC [COMPLETE_EQ_CLOSED, CLOSED_INJECTIVE_LINEAR_IMAGE])

  let COMPLETE_INJECTIVE_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (complete(IMAGE f s) <=> complete s)"
   (REWRITE_TAC [COMPLETE_EQ_CLOSED, CLOSED_INJECTIVE_LINEAR_IMAGE_EQ])

  add_linear_invariants [COMPLETE_INJECTIVE_LINEAR_IMAGE_EQ]

  let LIMPT_INJECTIVE_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> ((f x) limit_point_of (IMAGE f s) <=> x limit_point_of s)"
   (REWRITE_TAC [LIMPT_APPROACHABLE, EXISTS_IN_IMAGE] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN
    DISCH_TAC THENL
     [MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_BOUNDED_BELOW_POS),
      MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_BOUNDED_POS)] THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e * B:real")),
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / B:real"))] THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_MUL, dist, ← GSYM LINEAR_SUB] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN
           CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> b < x ==> a < x")) THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ASM_SIMP_TAC [REAL_LE_RDIV_EQ])

  add_linear_invariants [LIMPT_INJECTIVE_LINEAR_IMAGE_EQ]

  let LIMPT_TRANSLATION_EQ ← prove
   r"!a s x. (a + x) limit_point_of (IMAGE (\y. a + y) s) <=> x limit_point_of s"
   (REWRITE_TAC [limit_point_of] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [LIMPT_TRANSLATION_EQ]

  let OPEN_OPEN_LEFT_PROJECTION ← prove
   r"!s t:real^(M,N)finite_sum->bool.
        open s /\ open t ==> open {x | x IN s /\ ?y. pastecart x y IN t}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ ?y. (pastecart x y:real^(M,N)finite_sum) IN t} =
      s INTER IMAGE fstcart t")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTER, IN_IMAGE] THEN
      MESON_TAC [FSTCART_PASTECART, PASTECART_FST_SND],
      MATCH_MP_TAC OPEN_INTER THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
        OPEN_SURJECTIVE_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_FSTCART] THEN MESON_TAC [FSTCART_PASTECART]])

  let OPEN_OPEN_RIGHT_PROJECTION ← prove
   r"!s t:real^(M,N)finite_sum->bool.
        open s /\ open t ==> open {y | y IN s /\ ?x. pastecart x y IN t}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{y | y IN s /\ ?x. (pastecart x y:real^(M,N)finite_sum) IN t} =
      s INTER IMAGE sndcart t")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTER, IN_IMAGE] THEN
      MESON_TAC [SNDCART_PASTECART, PASTECART_FST_SND],
      MATCH_MP_TAC OPEN_INTER THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
        OPEN_SURJECTIVE_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_SNDCART] THEN MESON_TAC [SNDCART_PASTECART]])

  let OPEN_MAP_FSTCART ← prove
   r"!s:real^(M,N)finite_sum->bool.
        open s ==> open(IMAGE fstcart s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(:real^M)", ← q r"s:real^(M,N)finite_sum->bool"]
          OPEN_OPEN_LEFT_PROJECTION) THEN
    ASM_REWRITE_TAC [OPEN_UNIV, IN_UNIV] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
    REWRITE_TAC [EXISTS_PASTECART, FSTCART_PASTECART] THEN MESON_TAC [])

  let OPEN_MAP_SNDCART ← prove
   r"!s:real^(M,N)finite_sum->bool.
        open s ==> open(IMAGE sndcart s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(:real^N)", ← q r"s:real^(M,N)finite_sum->bool"]
          OPEN_OPEN_RIGHT_PROJECTION) THEN
    ASM_REWRITE_TAC [OPEN_UNIV, IN_UNIV] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
    REWRITE_TAC [EXISTS_PASTECART, SNDCART_PASTECART] THEN MESON_TAC [])

  return { IN_INTERIOR_LINEAR_IMAGE, LINEAR_OPEN_MAPPING, INTERIOR_INJECTIVE_LINEAR_IMAGE,
           INTERIOR_SURJECTIVE_LINEAR_IMAGE, CLOSURE_SURJECTIVE_LINEAR_IMAGE,
           FRONTIER_INJECTIVE_LINEAR_IMAGE, FRONTIER_SURJECTIVE_LINEAR_IMAGE,
           COMPLETE_INJECTIVE_LINEAR_IMAGE, COMPLETE_INJECTIVE_LINEAR_IMAGE_EQ,
           LIMPT_INJECTIVE_LINEAR_IMAGE_EQ, LIMPT_TRANSLATION_EQ, OPEN_OPEN_LEFT_PROJECTION,
           OPEN_OPEN_RIGHT_PROJECTION, OPEN_MAP_FSTCART, OPEN_MAP_SNDCART }

/- ------------------------------------------------------------------------- -/
/- Even more special cases.  (topology.ml 18436-18538)                       -/
/- ------------------------------------------------------------------------- -/

structure ESP where
  INTERIOR_SCALING : thm
  INTERIOR_AFFINITY : thm
  CLOSURE_SCALING : thm
  CLOSURE_AFFINITY : thm
  FRONTIER_SCALING : thm
  FRONTIER_AFFINITY : thm
  INTERIOR_NEGATIONS : thm
  SYMMETRIC_INTERIOR : thm
  CLOSURE_NEGATIONS : thm
  SYMMETRIC_CLOSURE : thm
  deriving Inhabited

@[nospecialize]
def setupESP [HolBase] (D : TopologyDeps) (BINT : INT) (BCLS1 : CLS1) (BFRO1 : FRO1)
    (BFRO2 : FRO2) (BCPP2 : CPP2) (BARC : ARC) (BCCC : CCC) (BLIO : LIO) (BCOR : COR) :
    ExceptT String IO ESP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH_TAC, .. } := D
  let { COND_ID, DIFF_EMPTY, EMPTY_DIFF, EQ_IMP, EXTENSION, .. } := D.core1
  let { FUN_IN_IMAGE, IMAGE_CLAUSES, IMAGE_CONST, IMAGE_DIFF_INJ, IMAGE_o, IN_IMAGE, .. } :=
    D.core2
  let { AFFINITY_SCALING_TRANSLATION, .. } := D.vec1
  let { LINEAR_SCALING, .. } := D.vec2
  let { VECTOR_ADD_RID, VECTOR_MUL_LCANCEL, VECTOR_MUL_LZERO, VECTOR_NEG_NEG, linear, .. } :=
    D.vec4
  let { INTERIOR_SING, SUBSET_INTERIOR, .. } := BINT
  let { CLOSURE_EMPTY, CLOSURE_EQ_EMPTY, .. } := BCLS1
  let { frontier, .. } := BFRO1
  let { FRONTIER_EQ_EMPTY, .. } := BFRO2
  let { CLOSURE_SING, .. } := BCPP2
  let { INTERIOR_TRANSLATION, .. } := BARC
  let { CLOSURE_TRANSLATION, FRONTIER_TRANSLATION, .. } := BCCC
  let { CLOSURE_INJECTIVE_LINEAR_IMAGE, .. } := BLIO
  let { INTERIOR_INJECTIVE_LINEAR_IMAGE, .. } := BCOR
  -- @@SCOPE END

  let INTERIOR_SCALING ← prove
   r"!s:real^N->bool c.
        interior (IMAGE (\x. c % x) s) =
        if c = &0 then {} else IMAGE (\x. c % x) (interior s)"
   (REPEAT GEN_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO] THENL
     [MATCH_MP_TAC (← SET_RULE (← q r"!t. s SUBSET t /\ t = {} ==> s = {}")) THEN
      EXISTS_TAC (← q r"interior {vec 0:real^N}") THEN CONJ_TAC THENL
       [MATCH_MP_TAC SUBSET_INTERIOR THEN SET_TAC [], REWRITE_TAC [INTERIOR_SING]],
      MATCH_MP_TAC INTERIOR_INJECTIVE_LINEAR_IMAGE THEN
      ASM_REWRITE_TAC [VECTOR_MUL_LCANCEL, LINEAR_SCALING]])

  let INTERIOR_AFFINITY ← prove
   r"!s m c:real^N.
        interior(IMAGE (\x. m % x + c) s) =
        if m = &0 then {} else IMAGE (\x. m % x + c) (interior s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, IMAGE_o] THEN
    REWRITE_TAC [INTERIOR_TRANSLATION, INTERIOR_SCALING] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [IMAGE_CLAUSES])

  let CLOSURE_SCALING ← prove
   r"!s:real^N->bool c.
        closure(IMAGE (\x. c % x) s) = IMAGE (\x. c % x) (closure s)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [CLOSURE_EMPTY, IMAGE_CLAUSES] THEN
    ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_SIMP_TAC [VECTOR_MUL_LZERO, CLOSURE_EQ_EMPTY, CLOSURE_SING,
                  IMAGE_CONST] THEN
    MATCH_MP_TAC CLOSURE_INJECTIVE_LINEAR_IMAGE THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LCANCEL, LINEAR_SCALING])

  let CLOSURE_AFFINITY ← prove
   r"!s m c:real^N.
        closure(IMAGE (\x. m % x + c) s) = IMAGE (\x. m % x + c) (closure s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, IMAGE_o] THEN
    REWRITE_TAC [CLOSURE_TRANSLATION, CLOSURE_SCALING] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [IMAGE_CLAUSES])

  let FRONTIER_SCALING ← prove
   r"!s:real^N->bool c.
        frontier (IMAGE (\x. c % x) s) =
        if c = &0 /\ s = (:real^N) then {vec 0}
        else IMAGE (\x. c % x) (frontier s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [frontier, CLOSURE_SCALING, INTERIOR_SCALING] THEN
    ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, IMAGE_CONST] THENL
     [REWRITE_TAC [CLOSURE_EQ_EMPTY, DIFF_EMPTY] THEN
      ASM_REWRITE_TAC [← GSYM frontier, FRONTIER_EQ_EMPTY] THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN ASM_REWRITE_TAC [COND_ID] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [CLOSURE_EMPTY, EMPTY_DIFF] THEN
      SET_TAC [],
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC IMAGE_DIFF_INJ THEN
      ASM_SIMP_TAC [VECTOR_MUL_LCANCEL]])

  let FRONTIER_AFFINITY ← prove
   r"!s m c:real^N.
        frontier (IMAGE (\x. m % x + c) s) =
        if m = &0 /\ s = (:real^N) then {c}
        else IMAGE (\x. m % x + c) (frontier s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, FRONTIER_TRANSLATION,
                 FRONTIER_SCALING, IMAGE_o] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IMAGE_CLAUSES, VECTOR_ADD_RID])

  let INTERIOR_NEGATIONS ← prove
   r"!s. interior(IMAGE (--) s) = IMAGE (--) (interior s)"
   (GEN_TAC THEN MATCH_MP_TAC INTERIOR_INJECTIVE_LINEAR_IMAGE THEN
    REWRITE_TAC [linear] THEN REPEAT CONJ_TAC THEN VECTOR_ARITH_TAC)

  let SYMMETRIC_INTERIOR ← prove
   r"!s:real^N->bool.
        (!x. x IN s ==> --x IN s)
        ==> !x. x IN interior s ==> (--x) IN interior s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← ISPEC (← q r"(--):real^N->real^N") FUN_IN_IMAGE)) THEN
    REWRITE_TAC [← GSYM INTERIOR_NEGATIONS] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE] THEN ASM_MESON_TAC [VECTOR_NEG_NEG])

  let CLOSURE_NEGATIONS ← prove
   r"!s. closure(IMAGE (--) s) = IMAGE (--) (closure s)"
   (GEN_TAC THEN MATCH_MP_TAC CLOSURE_INJECTIVE_LINEAR_IMAGE THEN
    REWRITE_TAC [linear] THEN REPEAT CONJ_TAC THEN VECTOR_ARITH_TAC)

  let SYMMETRIC_CLOSURE ← prove
   r"!s:real^N->bool.
        (!x. x IN s ==> --x IN s)
        ==> !x. x IN closure s ==> (--x) IN closure s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← ISPEC (← q r"(--):real^N->real^N") FUN_IN_IMAGE)) THEN
    REWRITE_TAC [← GSYM CLOSURE_NEGATIONS] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE] THEN ASM_MESON_TAC [VECTOR_NEG_NEG])

  return { INTERIOR_SCALING, INTERIOR_AFFINITY, CLOSURE_SCALING, CLOSURE_AFFINITY,
           FRONTIER_SCALING, FRONTIER_AFFINITY, INTERIOR_NEGATIONS, SYMMETRIC_INTERIOR,
           CLOSURE_NEGATIONS, SYMMETRIC_CLOSURE }

/- ------------------------------------------------------------------------- -/
/- Some properties of a canonical subspace.  (topology.ml 18539-18617)       -/
/- ------------------------------------------------------------------------- -/

structure CSS where
  SUBSPACE_SUBSTANDARD : thm
  CLOSED_SUBSTANDARD : thm
  DIM_SUBSTANDARD : thm
  deriving Inhabited

@[nospecialize]
def setupCSS [HolBase] (D : TopologyDeps) (BCLO : CLO) (BHSP : HSP) : ExceptT String IO CSS := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_RULE, VECTOR_ARITH, .. } := D
  let { ARITH, CART_EQ, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, HAS_SIZE_IMAGE_INJ, HAS_SIZE_NUMSEG_1, IMAGE_EQ_EMPTY, IN_ELIM_THM,
        IN_IMAGE, IN_INTERS, IN_NUMSEG, IN_SING, .. } := D.core2
  let { LE, LEFT_IMP_EXISTS_THM, LE_REFL, LE_TRANS, NOT_LT, NUMSEG_EMPTY, REAL_ADD_LID, .. } :=
    D.core3
  let { REAL_MUL_RID, REAL_MUL_RZERO, REAL_SUB_REFL, REAL_SUB_RZERO, SUBSET, SUBSET_IMAGE,
        SUBSET_NUMSEG, .. } := D.core5
  let { BASIS_COMPONENT, BASIS_INJ, DIM_UNIQUE, DOT_BASIS, .. } := D.vec1
  let { INDEPENDENT_MONO, INDEPENDENT_STDBASIS, .. } := D.vec2
  let { SPAN_ADD, SPAN_EMPTY, SPAN_MONO, SPAN_MUL, SPAN_STDBASIS, SPAN_SUPERSET, SUBSPACE_UNIV,
        .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT, VEC_COMPONENT,
        subspace, .. } := D.vec4
  let { CLOSED_INTERS, .. } := BCLO
  let { CLOSED_HYPERPLANE, .. } := BHSP
  -- @@SCOPE END

  let SUBSPACE_SUBSTANDARD ← prove
   r"!d. subspace
         {x:real^N | !i. d < i /\ i <= dimindex(:N) ==> x$i = &0}"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"d <= dimindex(:N)") THENL
     [MP_TAC (← ARITH_RULE (← q r"!i. d < i ==> 1 <= i")) THEN
      SIMP_TAC [subspace, IN_ELIM_THM, REAL_MUL_RZERO, REAL_ADD_LID,
                VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT],
      ASM_SIMP_TAC [← ARITH_RULE (← q r"~(d:num <= e) ==> (d < i /\ i <= e <=> F)")] THEN
      REWRITE_TAC [← SET_RULE (← q r"{x | T} = UNIV"), SUBSPACE_UNIV]])

  let CLOSED_SUBSTANDARD ← prove
   r"!d. closed
        {x:real^N | !i. d < i /\ i <= dimindex(:N) ==> x$i = &0}"
   (GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"{x:real^N | !i. d < i /\ i <= dimindex(:N) ==> x$i = &0} =
      INTERS {{x | basis i dot x = &0} | d < i /\ i <= dimindex(:N)}")
    SUBST1_TAC THENL
     [ALL_TAC,
      SIMP_TAC [CLOSED_INTERS, CLOSED_HYPERPLANE, IN_ELIM_THM,
                LEFT_IMP_EXISTS_THM]] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN REWRITE_TAC [IN_INTERS, IN_ELIM_THM] THEN
    SIMP_TAC [LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN
    MP_TAC (← ARITH_RULE (← q r"!i. d < i ==> 1 <= i")) THEN
    SIMP_TAC [DOT_BASIS] THEN MESON_TAC [])

  let DIM_SUBSTANDARD ← prove
   r"!d. d <= dimindex(:N)
       ==> (dim {x:real^N | !i. d < i /\ i <= dimindex(:N)
                                ==> x$i = &0} =
            d)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC DIM_UNIQUE THEN
    EXISTS_TAC (← q r"IMAGE (basis:num->real^N) (1..d)") THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_NUMSEG] THEN
      MESON_TAC [BASIS_COMPONENT, ← ARITH_RULE (← q r"d < i ==> 1 <= i"), NOT_LT],
      ALL_TAC,
      MATCH_MP_TAC INDEPENDENT_MONO THEN
      EXISTS_TAC (← q r"{basis i :real^N | 1 <= i /\ i <= dimindex(:N)}") THEN
      REWRITE_TAC [INDEPENDENT_STDBASIS] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_NUMSEG] THEN
      ASM_MESON_TAC [LE_TRANS],
      MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN REWRITE_TAC [HAS_SIZE_NUMSEG_1] THEN
      REWRITE_TAC [IN_NUMSEG] THEN ASM_MESON_TAC [LE_TRANS, BASIS_INJ]] THEN
    POP_ASSUM MP_TAC THEN SPEC_TAC (← q r"d:num", ← q r"d:num") THEN
    INDUCT_TAC THENL
     [REWRITE_TAC [← ARITH_RULE (← q r"0 < i <=> 1 <= i"), SPAN_STDBASIS] THEN
      SUBGOAL_THEN (← q r"IMAGE basis (1 .. 0) :real^N->bool = {}") SUBST1_TAC THENL
       [REWRITE_TAC [IMAGE_EQ_EMPTY, NUMSEG_EMPTY, ARITH], ALL_TAC] THEN
      DISCH_TAC THEN REWRITE_TAC [SPAN_EMPTY, SUBSET, IN_ELIM_THM, IN_SING] THEN
      SIMP_TAC [CART_EQ, VEC_COMPONENT],
      ALL_TAC] THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_imp o concl)) THEN
    ASM_SIMP_TAC [← ARITH_RULE (← q r"SUC d <= n ==> d <= n")] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x - (x$(SUC d)) % basis(SUC d) :real^N")) THEN
    ANTS_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← ARITH_RULE (← q r"d < i ==> 1 <= i"))) THEN
      ASM_SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT] THEN
      ASM_SIMP_TAC [BASIS_COMPONENT] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [REAL_MUL_RID, REAL_SUB_REFL] THEN
      ASM_REWRITE_TAC [REAL_MUL_RZERO, REAL_SUB_RZERO] THEN
      ASM_MESON_TAC [← ARITH_RULE (← q r"d < i /\ ~(i = SUC d) ==> SUC d < i")],
      ALL_TAC] THEN
    DISCH_TAC THEN
    SUBST1_TAC (← VECTOR_ARITH
     (← q r"x = (x - (x$(SUC d)) % basis(SUC d)) +
          x$(SUC d) % basis(SUC d) :real^N")) THEN
    MATCH_MP_TAC SPAN_ADD THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SPAN_MONO, SUBSET_IMAGE, SUBSET, SUBSET_NUMSEG, LE_REFL, LE],
      MATCH_MP_TAC SPAN_MUL THEN MATCH_MP_TAC SPAN_SUPERSET THEN
      REWRITE_TAC [IN_IMAGE, IN_NUMSEG] THEN
      MESON_TAC [LE_REFL, ← ARITH_RULE (← q r"1 <= SUC d")]])

  return { SUBSPACE_SUBSTANDARD, CLOSED_SUBSTANDARD, DIM_SUBSTANDARD }

/- ------------------------------------------------------------------------- -/
/- Hence closure and completeness of all subspaces.  (topology.ml 18618-18814) -/
/- ------------------------------------------------------------------------- -/

structure CSB1 where
  CLOSED_SUBSPACE : thm
  COMPLETE_SUBSPACE : thm
  CLOSED_SPAN : thm
  CLOSURE_SUBSET_SPAN : thm
  DIM_CLOSURE : thm
  CLOSED_BOUNDEDPREIM_CONTINUOUS_IMAGE : thm
  CLOSED_INJECTIVE_IMAGE_SUBSET_SUBSPACE : thm
  BASIS_COORDINATES_LIPSCHITZ : thm
  COMPLEMENTARY_SUM_COMPONENTS_LIPSCHITZ : thm
  deriving Inhabited

@[nospecialize]
def setupCSB1 [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCLS1 : CLS1) (BCBL : CBL)
    (BBND1 : BND1) (BCPT : CPT) (BCMP : CMP) (BCPP1 : CPP1) (BCPP2 : CPP2) (BCSL : CSL)
    (BCLC : CLC) (BLCP : LCP) (BISM : ISM) (BCSS : CSS) : ExceptT String IO CSB1 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } :=
    D
  let { CART_EQ, FINITE_INDEX_NUMSEG, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNION, IMP_CONJ, INJECTIVE_ON_LEFT_INVERSE, IN_ELIM_THM,
        IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, LE_ANTISYM, .. } := D.core3
  let { REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_RMUL_EQ, REAL_LE_TRANS,
        REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_MUL, .. } := D.core4
  let { REAL_MUL_SYM, SUBSET, .. } := D.core5
  let { SUM_LE, SUM_POS_LE, SUM_RMUL, o_THM, real_ge, .. } := D.core6
  let { BASIS_SUBSPACE_EXISTS, COMPONENT_LE_NORM, DIM_SPAN, DIM_SUBSET, DIM_SUBSET_UNIV, .. } :=
    D.vec1
  let { INDEPENDENT_BOUND, INDEPENDENT_EXPLICIT, INDEPENDENT_NONZERO, INDEPENDENT_UNION,
        IN_SPAN_IMAGE_BASIS, LINEAR_0, LINEAR_COMPOSE_VSUM, LINEAR_ID, LINEAR_VMUL_COMPONENT,
        .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, SPAN_FINITE, SPAN_INC, SUBSPACE_ISOMORPHISM, SUBSPACE_SPAN, .. } :=
    D.vec3
  let { VEC_COMPONENT, VSUM_EQ_GENERAL_INVERSES, VSUM_EQ_NUMSEG, VSUM_IMAGE, VSUM_NORM_TRIANGLE,
        VSUM_UNION, .. } := D.vec4
  let { IN_CBALL_0, .. } := BBAL
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, .. } := BCLS1
  let { CLOSED_CBALL, .. } := BCBL
  let { BOUNDED_CBALL, BOUNDED_SUBSET, .. } := BBND1
  let { COMPACT_EQ_BOUNDED_CLOSED, .. } := BCPT
  let { COMPLETE_EQ_CLOSED, .. } := BCMP
  let { CLOSED_INTER_COMPACT, .. } := BCPP1
  let { CLOSED_INTERS_COMPACT, .. } := BCPP2
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_CLOSED_PREIMAGE, .. } := BCLC
  let { COMPACT_CONTINUOUS_IMAGE, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_INJECTIVE_IMAGE_SUBSPACE, INJECTIVE_IMP_ISOMETRIC, .. } := BISM
  let { CLOSED_SUBSTANDARD, DIM_SUBSTANDARD, SUBSPACE_SUBSTANDARD, .. } := BCSS
  -- @@SCOPE END

  let CLOSED_SUBSPACE ← prove
   r"!s:real^N->bool. subspace s ==> closed s"
   (REPEAT STRIP_TAC THEN ABBREV_TAC (← q r"d = dim(s:real^N->bool)") THEN
    MP_TAC (← MATCH_MP DIM_SUBSTANDARD
      (← ISPEC (← q r"s:real^N->bool") DIM_SUBSET_UNIV)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{x:real^N | !i. d < i /\ i <= dimindex(:N)
                                  ==> x$i = &0}",
      ← q r"s:real^N->bool"] SUBSPACE_ISOMORPHISM) THEN
    ASM_REWRITE_TAC [SUBSPACE_SUBSTANDARD] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:real^N->real^N") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (SUBST_ALL_TAC o SYM) STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC (← ISPEC (← q r"f:real^N->real^N") CLOSED_INJECTIVE_IMAGE_SUBSPACE) THEN
    ASM_REWRITE_TAC [SUBSPACE_SUBSTANDARD, CLOSED_SUBSTANDARD] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [LINEAR_0]] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    ASM_MESON_TAC [VEC_COMPONENT, ← ARITH_RULE (← q r"d < i ==> 1 <= i")])

  let COMPLETE_SUBSPACE ← prove
   r"!s:real^N->bool. subspace s ==> complete s"
   (REWRITE_TAC [COMPLETE_EQ_CLOSED, CLOSED_SUBSPACE])

  let CLOSED_SPAN ← prove
   r"!s. closed(span s)"
   (SIMP_TAC [CLOSED_SUBSPACE, SUBSPACE_SPAN])

  let CLOSURE_SUBSET_SPAN ← prove
   r"!s:real^N->bool. closure s SUBSET span s"
   (GEN_TAC THEN MATCH_MP_TAC CLOSURE_MINIMAL THEN
    REWRITE_TAC [CLOSED_SPAN, SPAN_INC])

  let DIM_CLOSURE ← prove
   r"!s:real^N->bool. dim(closure s) = dim s"
   (GEN_TAC THEN REWRITE_TAC [← GSYM LE_ANTISYM] THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC RAND_CONV [← GSYM DIM_SPAN], ALL_TAC] THEN
    MATCH_MP_TAC DIM_SUBSET THEN REWRITE_TAC [CLOSURE_SUBSET] THEN
    MATCH_MP_TAC CLOSURE_MINIMAL THEN
    SIMP_TAC [CLOSED_SUBSPACE, SUBSPACE_SPAN, SPAN_INC])

  let CLOSED_BOUNDEDPREIM_CONTINUOUS_IMAGE ← prove
   r"!f:real^M->real^N s.
      closed s /\ f continuous_on s /\
      (!e. bounded {x | x IN s /\ norm(f x) <= e})
      ==> closed(IMAGE f s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CLOSED_INTERS_COMPACT] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"cball(vec 0,e) INTER IMAGE (f:real^M->real^N) s =
      IMAGE f (s INTER {x | x IN s /\ f x IN cball(vec 0,e)})")] THEN
    X_GEN_TAC (← q r"e:real") THEN MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:real^M->bool") THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [],
      MATCH_MP_TAC CLOSED_INTER_COMPACT THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN CONJ_TAC THENL
       [ASM_REWRITE_TAC [IN_CBALL_0],
        ASM_SIMP_TAC [CONTINUOUS_CLOSED_PREIMAGE, CLOSED_CBALL]]])

  let CLOSED_INJECTIVE_IMAGE_SUBSET_SUBSPACE ← prove
   r"!f:real^M->real^N s t.
        closed s /\ s SUBSET t /\ subspace t /\
        linear f /\
        (!x. x IN t /\ f(x) = vec 0 ==> x = vec 0)
        ==> closed(IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_BOUNDEDPREIM_CONTINUOUS_IMAGE THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"t:real^M->bool"]
      INJECTIVE_IMP_ISOMETRIC) THEN
    ASM_SIMP_TAC [CLOSED_SUBSPACE, real_ge] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    X_GEN_TAC (← q r"e:real") THEN MATCH_MP_TAC BOUNDED_SUBSET THEN
    EXISTS_TAC (← q r"cball(vec 0:real^M,e / B)") THEN
    REWRITE_TAC [BOUNDED_CBALL] THEN
    ASM_SIMP_TAC [SUBSET, IN_ELIM_THM, IN_CBALL_0, REAL_LE_RDIV_EQ] THEN
    ASM_MESON_TAC [SUBSET, REAL_LE_TRANS])

  let BASIS_COORDINATES_LIPSCHITZ ← prove
   r"!b:real^N->bool.
        independent b
        ==> ?B. &0 < B /\
                !c v. v IN b
                      ==> abs(c v) <= B * norm(vsum b (\v. c(v) % v))"
   (X_GEN_TAC (← q r"k:real^N->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP INDEPENDENT_BOUND) THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"b:num->real^N") STRIP_ASSUME_TAC o
          GEN_REWRITE_RULE id [FINITE_INDEX_NUMSEG]) THEN
    ABBREV_TAC (← q r"n = CARD(k:real^N->bool)") THEN
    MP_TAC (← ISPECL
     [← q r"(\x. vsum(1..n) (\i. x$i % b i)):real^N->real^N",
      ← q r"span(IMAGE basis (1..n)):real^N->bool"]
          INJECTIVE_IMP_ISOMETRIC) THEN
    REWRITE_TAC [SUBSPACE_SPAN] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [SIMP_TAC [CLOSED_SUBSPACE, SUBSPACE_SPAN], ALL_TAC] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC LINEAR_COMPOSE_VSUM THEN
        REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC LINEAR_VMUL_COMPONENT THEN
        SIMP_TAC [LINEAR_ID] THEN ASM_ARITH_TAC,
        ALL_TAC] THEN
      X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_SPAN_IMAGE_BASIS]) THEN
      REWRITE_TAC [IN_NUMSEG] THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INJECTIVE_ON_LEFT_INVERSE]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"c:real^N->num")) THEN
      SUBGOAL_THEN
       (← q r"vsum(1..n) (\i. (x:real^N)$i % b i:real^N) = vsum k (\v. x$(c v) % v)")
      SUBST1_TAC THENL
       [MATCH_MP_TAC VSUM_EQ_GENERAL_INVERSES THEN
        MAP_EVERY EXISTS_TAC [← q r"b:num->real^N", ← q r"c:real^N->num"] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INDEPENDENT_EXPLICIT]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\v:real^N. (x:real^N)$(c v)") o CONJUNCT2) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [CART_EQ, FORALL_IN_IMAGE, VEC_COMPONENT] THEN
      ASM_MESON_TAC [IN_NUMSEG],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"inv(B:real)") THEN ASM_REWRITE_TAC [REAL_LT_INV_EQ] THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, IN_NUMSEG] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^N->real", ← q r"j:num"] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"inv B * x = x / B")] THEN
    ASM_SIMP_TAC [REAL_LE_RDIV_EQ] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) VSUM_IMAGE o rand o rand o snd) THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG] THEN DISCH_THEN SUBST1_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"(lambda i. if 1 <= i /\ i <= n then c(b i:real^N) else &0):real^N")) THEN
    SIMP_TAC [IN_SPAN_IMAGE_BASIS, LAMBDA_BETA] THEN
    ANTS_TAC THENL [MESON_TAC [IN_NUMSEG], ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x = v /\ u <= y ==> x >= y ==> u <= v")) THEN
    CONJ_TAC THENL
     [AP_TERM_TAC THEN MATCH_MP_TAC VSUM_EQ_NUMSEG THEN
      SUBGOAL_THEN (← q r"!i. i <= n ==> i <= dimindex(:N)") MP_TAC THENL
       [ASM_ARITH_TAC,
        SIMP_TAC [LAMBDA_BETA] THEN DISCH_THEN (K ALL_TAC : thm → tactic)] THEN
      REWRITE_TAC [o_THM],
      GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [REAL_LE_RMUL_EQ] THEN
      MP_TAC (← ISPECL
       [← q r"(lambda i. if 1 <= i /\ i <= n then c(b i:real^N) else &0):real^N",
        ← q r"j:num"] COMPONENT_LE_NORM) THEN
      SUBGOAL_THEN (← q r"1 <= j /\ j <= dimindex(:N)") MP_TAC THENL
       [ASM_ARITH_TAC, SIMP_TAC [LAMBDA_BETA] THEN ASM_REWRITE_TAC []]])

  let COMPLEMENTARY_SUM_COMPONENTS_LIPSCHITZ ← prove
   r"!s t:real^N->bool.
        subspace s /\ subspace t /\ s INTER t SUBSET {vec 0}
        ==> ?B. &0 < B /\
                !x y. x IN s /\ y IN t ==> norm(x) <= B * norm(x + y)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"t:real^N->bool") BASIS_SUBSPACE_EXISTS) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") BASIS_SUBSPACE_EXISTS) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"b:real^N->bool") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"b UNION c:real^N->bool") BASIS_COORDINATES_LIPSCHITZ) THEN
    ASM_SIMP_TAC [INDEPENDENT_UNION] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(sum (b:real^N->bool) norm + &1) * B") THEN
    ASM_SIMP_TAC [REAL_LT_MUL, ← REAL_ARITH (← q r"&0 <= x ==> &0 < x + &1"),
                  SUM_POS_LE, NORM_POS_LE] THEN
    SUBGOAL_THEN (← q r"DISJOINT (b:real^N->bool) c") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s INTER t SUBSET {z}
        ==> b SUBSET s /\ c SUBSET t /\ ~(z IN b) ==> DISJOINT b c"))) THEN
      ASM_MESON_TAC [SPAN_INC, INDEPENDENT_NONZERO],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    MP_TAC (← ISPEC (← q r"c:real^N->bool") SPAN_FINITE) THEN
    MP_TAC (← ISPEC (← q r"b:real^N->bool") SPAN_FINITE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN SUBST1_TAC) THEN
    REWRITE_TAC [IN_ELIM_THM, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real^N->real") THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    X_GEN_TAC (← q r"a':real^N->real") THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"\x. if x IN b then (a:real^N->real) x else a' x")) THEN
    ASM_SIMP_TAC [VSUM_UNION] THEN REWRITE_TAC [FORALL_IN_UNION] THEN
    DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"DISJOINT b c ==> !x. x IN c ==> ~(x IN b)"))) THEN
    SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN DISCH_TAC THEN
    MATCH_MP_TAC VSUM_NORM_TRIANGLE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"&0 <= b * y /\ x <= s * b * y ==> x <= ((s + &1) * b) * y")) THEN
    ASM_SIMP_TAC [REAL_LE_MUL, NORM_POS_LE, REAL_LT_IMP_LE, ← GSYM SUM_RMUL] THEN
    MATCH_MP_TAC SUM_LE THEN
    ASM_REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] NORM_MUL] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [REAL_LE_LMUL, NORM_POS_LE])

  return { CLOSED_SUBSPACE, COMPLETE_SUBSPACE, CLOSED_SPAN, CLOSURE_SUBSET_SPAN, DIM_CLOSURE,
           CLOSED_BOUNDEDPREIM_CONTINUOUS_IMAGE, CLOSED_INJECTIVE_IMAGE_SUBSET_SUBSPACE,
           BASIS_COORDINATES_LIPSCHITZ, COMPLEMENTARY_SUM_COMPONENTS_LIPSCHITZ }

/- ------------------------------------------------------------------------- -/
/- Closure and completeness of subspaces, continued.  (topology.ml 18815-18899) -/
/- ------------------------------------------------------------------------- -/

structure CSB2 where
  BASIS_COORDINATES_CONTINUOUS : thm
  COMPLEMENTARY_SUM_HOMEOMORPHIC_PCROSS : thm
  deriving Inhabited

@[nospecialize]
def setupCSB2 [HolBase] (D : TopologyDeps) (BBND1 : BND1) (BCPT : CPT) (BCMS : CMS) (BCLC : CLC)
    (BLCP : LCP) (BPCR1 : PCR1) (BPRP1 : PRP1) (BHMA : HMA) (BIOM : IOM) (BCSB1 : CSB1) :
    ExceptT String IO CSB2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ,
        IMP_CONJ_ALT, IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, PASTECART_INJ, PASTECART_IN_PCROSS, REAL_ADD_RDISTRIB, .. } :=
    D.core3
  let { REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_LMUL_EQ, REAL_LE_TRANS, REAL_LT_ADD, REAL_LT_DIV,
        REAL_LT_MUL, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_SYM, RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, SUBSET, SUBSET_PCROSS, .. } :=
    D.core5
  let { INDEPENDENT_SUBSPACES, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { NORM_PASTECART_LE, SPAN_INC, SUBSPACE_SPAN, .. } := D.vec3
  let { VECTOR_ADD_SYM, .. } := D.vec4
  let { BOUNDED_POS, .. } := BBND1
  let { COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_ON_ADD, .. } := BCMS
  let { CONTINUOUS_CLOSED_PREIMAGE, .. } := BCLC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_PCROSS, .. } := BPCR1
  let { PROPER_MAP, .. } := BPRP1
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, homeomorphic, .. } := BHMA
  let { HOMEOMORPHISM_INJECTIVE_CLOSED_MAP, .. } := BIOM
  let { BASIS_COORDINATES_LIPSCHITZ, CLOSED_SPAN, COMPLEMENTARY_SUM_COMPONENTS_LIPSCHITZ, .. } :=
    BCSB1
  -- @@SCOPE END

  let BASIS_COORDINATES_CONTINUOUS ← prove
   r"!b:real^N->bool e.
        independent b /\ &0 < e
        ==> ?d. &0 < d /\
                !c. norm(vsum b (\v. c(v) % v)) < d
                    ==> !v. v IN b ==> abs(c v) < e"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP BASIS_COORDINATES_LIPSCHITZ) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"e / B:real") THEN ASM_SIMP_TAC [REAL_LT_DIV] THEN
    X_GEN_TAC (← q r"c:real^N->real") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"v:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"B * norm(vsum b (\v:real^N. c v % v))") THEN
    ASM_SIMP_TAC [] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ])

  let COMPLEMENTARY_SUM_HOMEOMORPHIC_PCROSS ← prove
   r"!s t:real^N->bool.
        span s INTER span t SUBSET {vec 0}
        ==> {x + y | x IN s /\ y IN t} homeomorphic (s PCROSS t)"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"add = \z:real^(N,N)finite_sum. fstcart z + sndcart z") THEN
    SUBGOAL_THEN
     (← q r"?g. homeomorphism (span s PCROSS span t,
                         {x + y:real^N | x IN span s /\ y IN span t})
                        (add,g)")
    STRIP_ASSUME_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
      EXISTS_TAC (← q r"add:real^(N,N)finite_sum->real^N") THEN
      EXISTS_TAC (← q r"g:real^N->real^(N,N)finite_sum") THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
      REWRITE_TAC [SUBSET_PCROSS, SPAN_INC] THEN EXPAND_TAC "add" THEN
      REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_IN_PCROSS] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") SPAN_INC) THEN
      MP_TAC (← ISPEC (← q r"t:real^N->bool") SPAN_INC) THEN SET_TAC []] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_CLOSED_MAP THEN
    SIMP_TAC [CONTINUOUS_ON_ADD, LINEAR_CONTINUOUS_ON, LINEAR_FSTCART,
              LINEAR_SNDCART] THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_IN_PCROSS] THEN
    CONJ_TAC THENL [SET_TAC [], REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM]] THEN
    REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_INJ] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [INDEPENDENT_SUBSPACES, SUBSPACE_SPAN], ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand o rand) PROPER_MAP o snd) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN SET_TAC [],
      MATCH_MP_TAC (← TAUT (← q r"p ==> (p <=> q /\ r) ==> q"))] THEN
    X_GEN_TAC (← q r"k:real^N->bool") THEN STRIP_TAC THEN
    REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
      REWRITE_TAC [BOUNDED_POS] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"span t:real^N->bool", ← q r"span s:real^N->bool"]
        COMPLEMENTARY_SUM_COMPONENTS_LIPSCHITZ) THEN
      MP_TAC (← ISPECL [← q r"span s:real^N->bool", ← q r"span t:real^N->bool"]
        COMPLEMENTARY_SUM_COMPONENTS_LIPSCHITZ) THEN
      ASM_REWRITE_TAC [SUBSPACE_SPAN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"D:real") THEN STRIP_TAC THEN EXISTS_TAC (← q r"B * (C + D):real") THEN
      ASM_SIMP_TAC [REAL_LT_ADD, REAL_LT_MUL] THEN
      REWRITE_TAC [FORALL_PASTECART, IN_ELIM_THM, PASTECART_IN_PCROSS] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
      W (MP_TAC o PART_MATCH lhand NORM_PASTECART_LE o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"(C + D) * norm(x + y:real^N)") THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_LT_ADD] THEN
      REWRITE_TAC [REAL_ADD_RDISTRIB] THEN MATCH_MP_TAC REAL_LE_ADD2 THEN
      ASM_MESON_TAC [VECTOR_ADD_SYM],
      MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_PCROSS, CLOSED_SPAN] THEN
      SIMP_TAC [CONTINUOUS_ON_ADD, LINEAR_CONTINUOUS_ON, LINEAR_FSTCART,
                LINEAR_SNDCART]])

  return { BASIS_COORDINATES_CONTINUOUS, COMPLEMENTARY_SUM_HOMEOMORPHIC_PCROSS }

/- ------------------------------------------------------------------------- -/
/- Affine transformations of intervals.  (topology.ml 18900-18978)           -/
/- ------------------------------------------------------------------------- -/

structure AFI where
  AFFINITY_INVERSES : thm
  REAL_AFFINITY_LE : thm
  REAL_LE_AFFINITY : thm
  REAL_AFFINITY_LT : thm
  REAL_LT_AFFINITY : thm
  REAL_AFFINITY_EQ : thm
  REAL_EQ_AFFINITY : thm
  VECTOR_AFFINITY_EQ : thm
  VECTOR_EQ_AFFINITY : thm
  IMAGE_AFFINITY_INTERVAL : thm
  deriving Inhabited

@[nospecialize]
def setupAFI [HolBase] (D : TopologyDeps) : ExceptT String IO AFI := do
  -- @@SCOPE BEGIN
  let { REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D
  let { CART_EQ, COND_ID, EXTENSION, .. } := D.core1
  let { FUN_EQ_THM, IMAGE_CLAUSES, IN_IMAGE, .. } := D.core2
  let { I_THM, .. } := D.core3
  let { REAL_INV_INV, REAL_LE_LDIV_EQ, REAL_LE_LT, REAL_LE_RDIV_EQ, REAL_LT_IMP_NZ,
        REAL_LT_INV_EQ, .. } := D.core4
  let { REAL_MUL_AC, REAL_MUL_LINV, REAL_MUL_LNEG, REAL_MUL_RINV, REAL_NEG_NEG, REAL_NOT_LE, .. } :=
    D.core5
  let { UNWIND_THM1, o_THM, real_div, .. } := D.core6
  let { INTERVAL_SING, IN_INTERVAL, .. } := D.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_MUL_ASSOC,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_LZERO, VECTOR_MUL_RNEG, VECTOR_NEG_COMPONENT, .. } :=
    D.vec4
  -- @@SCOPE END

  let AFFINITY_INVERSES ← prove
   r"!m c. ~(m = &0)
         ==> (\x. m % x + c) o (\x. inv(m) % x + (--(inv(m) % c))) = I /\
             (\x. inv(m) % x + (--(inv(m) % c))) o (\x. m % x + c) = I"
   (REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN
    REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_RNEG] THEN
    SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_RINV] THEN
    REPEAT STRIP_TAC THEN VECTOR_ARITH_TAC)

  let REAL_AFFINITY_LE ← prove
   r"!m c x y. &0 < m ==> (m * x + c <= y <=> x <= inv(m) * y + --(c / m))"
   (REWRITE_TAC [← REAL_ARITH (← q r"m * x + c <= y <=> x * m <= y - c")] THEN
    SIMP_TAC [← GSYM REAL_LE_RDIV_EQ] THEN REAL_ARITH_TAC)

  let REAL_LE_AFFINITY ← prove
   r"!m c x y. &0 < m ==> (y <= m * x + c <=> inv(m) * y + --(c / m) <= x)"
   (REWRITE_TAC [← REAL_ARITH (← q r"y <= m * x + c <=> y - c <= x * m")] THEN
    SIMP_TAC [← GSYM REAL_LE_LDIV_EQ] THEN REAL_ARITH_TAC)

  let REAL_AFFINITY_LT ← prove
   r"!m c x y. &0 < m ==> (m * x + c < y <=> x < inv(m) * y + --(c / m))"
   (SIMP_TAC [REAL_LE_AFFINITY, ← GSYM REAL_NOT_LE])

  let REAL_LT_AFFINITY ← prove
   r"!m c x y. &0 < m ==> (y < m * x + c <=> inv(m) * y + --(c / m) < x)"
   (SIMP_TAC [REAL_AFFINITY_LE, ← GSYM REAL_NOT_LE])

  let REAL_AFFINITY_EQ ← prove
   r"!m c x y. ~(m = &0) ==> (m * x + c = y <=> x = inv(m) * y + --(c / m))"
   (CONV_TAC (fun t => REAL_FIELD t))

  let REAL_EQ_AFFINITY ← prove
   r"!m c x y. ~(m = &0) ==> (y = m * x + c  <=> inv(m) * y + --(c / m) = x)"
   (CONV_TAC (fun t => REAL_FIELD t))

  let VECTOR_AFFINITY_EQ ← prove
   r"!m c x y. ~(m = &0)
             ==> (m % x + c = y <=> x = inv(m) % y + --(inv(m) % c))"
   (SIMP_TAC [CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
              real_div, VECTOR_NEG_COMPONENT, REAL_AFFINITY_EQ] THEN
    REWRITE_TAC [REAL_MUL_AC])

  let VECTOR_EQ_AFFINITY ← prove
   r"!m c x y. ~(m = &0)
             ==> (y = m % x + c <=> inv(m) % y + --(inv(m) % c) = x)"
   (SIMP_TAC [CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
              real_div, VECTOR_NEG_COMPONENT, REAL_EQ_AFFINITY] THEN
    REWRITE_TAC [REAL_MUL_AC])

  let IMAGE_AFFINITY_INTERVAL ← prove
   r"!a b:real^N m c.
        IMAGE (\x. m % x + c) (interval[a,b]) =
            if interval[a,b] = {} then {}
            else if &0 <= m then interval[m % a + c,m % b + c]
            else interval[m % b + c,m % a + c]"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [IMAGE_CLAUSES] THEN
    ASM_CASES_TAC (← q r"m = &0") THEN ASM_REWRITE_TAC [REAL_LE_LT] THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_LID, COND_ID] THEN
      REWRITE_TAC [INTERVAL_SING] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
     (← q r"~(x = &0) ==> &0 < x \/ &0 < --x"))) THEN
    ASM_SIMP_TAC [EXTENSION, IN_IMAGE, ← REAL_ARITH (← q r"&0 < --x ==> ~(&0 < x)")] THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"x = m % y + c <=> c = (--m) % y + x")]] THEN
    ASM_SIMP_TAC [VECTOR_EQ_AFFINITY, REAL_LT_IMP_NZ, UNWIND_THM1] THEN
    SIMP_TAC [IN_INTERVAL, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
              VECTOR_NEG_COMPONENT] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_LT_INV_EQ]) THEN
    SIMP_TAC [REAL_AFFINITY_LE, REAL_LE_AFFINITY, real_div] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN REWRITE_TAC [REAL_INV_INV] THEN
    REWRITE_TAC [REAL_MUL_LNEG, REAL_NEG_NEG] THEN
    ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < m ==> (inv m * x) * m = x")] THEN
    GEN_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN REAL_ARITH_TAC)

  return { AFFINITY_INVERSES, REAL_AFFINITY_LE, REAL_LE_AFFINITY, REAL_AFFINITY_LT,
           REAL_LT_AFFINITY, REAL_AFFINITY_EQ, REAL_EQ_AFFINITY, VECTOR_AFFINITY_EQ,
           VECTOR_EQ_AFFINITY, IMAGE_AFFINITY_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Some matrix identities are easier to deduce for invertible matrices. We   -/
/- can then extend by continuity, which is why this material needs to be     -/
/- here after basic topological notions have been defined.                   -/
/- (topology.ml 18979-19188)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MID1 where
  LIM_LIFT_DET : thm
  LIM_COFACTOR : thm
  LIM_MATRIX_TRANSP : thm
  LIM_MATRIX_INV : thm
  CONTINUOUS_LIFT_DET : thm
  CONTINUOUS_ON_LIFT_DET : thm
  CONTINUOUS_DET_VECTORIZE : thm
  CONTINUOUS_ON_DET_VECTORIZE : thm
  CONTINUOUS_DET_EXPLICIT : thm
  NEARBY_INVERTIBLE_MATRIX : thm
  NEARBY_INVERTIBLE_MATRIX_GEN : thm
  MATRIX_WLOG_INVERTIBLE : thm
  deriving Inhabited

@[nospecialize]
def setupMID1 [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLPT : LPT) (BLIM1 : LIM1)
    (BLIM2 : LIM2) (BARI : ARI) (BTRN : TRN) (BSEQ : SEQ) (BCNT1 : CNT1) (BCSL : CSL)
    (BSMI : SMI) (BLLO : LLO) (BMFV : MFV) : ExceptT String IO MID1 := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, .. } := D
  let { CONTRAPOS_THM, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, FINITE_IMAGE, FINITE_NUMSEG, .. } :=
    D.core1
  let { FORALL_AND_THM, FORALL_IN_IMAGE, IMP_CONJ, IN_ELIM_THM, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LE_REFL, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP,
        REAL_ABS_NEG, REAL_ABS_NZ, .. } := D.core3
  let { REAL_LT_IMP_LE, REAL_LT_INV_EQ, .. } := D.core4
  let { REAL_MUL_RZERO, REAL_NEG_EQ_0, REAL_NOT_LT, REAL_POLYFUN_FINITE_ROOTS, REAL_SUB_RZERO,
        SKOLEM_THM, SUBSET, .. } := D.core5
  let { o_DEF, .. } := D.core6
  let { FINITE_PERMUTATIONS, PERMUTES_IMAGE, .. } := D.lib2
  let { DIST_LIFT, DROP_VEC, EXISTS_LIFT, .. } := D.vec1
  let { INVERTIBLE_NEG, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, LIFT_SUB, LIFT_SUM,
        MATRIX_ADD_LDISTRIB, MATRIX_ADD_RID, MATRIX_ADD_SYM, MATRIX_CMUL_ADD_LDISTRIB,
        MATRIX_CMUL_ASSOC, MATRIX_CMUL_LID, MATRIX_CMUL_LZERO, MATRIX_MUL_RMUL, MATRIX_NEG_MINUS1,
        MATRIX_SUB, .. } := D.vec2
  let { MATRIX_VECTOR_LMUL, MATRIX_VECTOR_MUL_BASIS, MATRIX_VECTOR_MUL_COMPONENT, NORM_LIFT,
        TRANSP_COMPONENT, .. } := D.vec3
  let { VECTOR_SUB_REFL, column, dot, .. } := D.vec4
  let { CHARACTERISTIC_POLYNOMIAL, DET_MUL, INVERTIBLE_DET_NZ, MATRIX_INV_COFACTOR,
        MATRIX_MUL_LINV, cofactor, det, .. } := D.det
  let { EVENTUALLY_MONO, EVENTUALLY_TRUE, .. } := D.met2
  let { IN_CBALL_0, .. } := BBAL
  let { CLOSED_LIMPT, LIMIT_POINT_FINITE, LIMPT_APPROACHABLE, .. } := BLPT
  let { LIM_COMPONENTWISE_LIFT, tendsto, .. } := BLIM1
  let { LIM_EVENTUALLY, LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_CMUL, LIM_COMPONENT, LIM_CONST, LIM_NULL, LIM_NULL_COMPARISON, LIM_VSUM, .. } := BARI
  let { LIM_TRANSFORM, .. } := BTRN
  let { SEQ_HARMONIC_OFFSET, .. } := BSEQ
  let { continuous, .. } := BCNT1
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BCSL
  let { LIM_INV, LIM_LIFT_PRODUCT, LIM_MUL, LIM_VMUL, .. } := BSMI
  let { LIM_MATRIX_COMPONENTWISE, .. } := BLLO
  let { CONTINUOUS_ON_VECTORIZE_COMPONENTWISE, CONTINUOUS_VECTORIZE_COMPONENTWISE, .. } := BMFV
  -- @@SCOPE END

  let LIM_LIFT_DET ← prove
   r"!(A:A->real^N^N) (B:real^N^N) net.
        (!i j. 1 <= i /\ i <= dimindex(:N) /\
               1 <= j /\ j <= dimindex(:N)
               ==> ((\x. lift(A x$i$j)) --> lift(B$i$j)) net)
        ==> ((\x. lift(det(A x))) --> lift(det B)) net"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [det] THEN
    SIMP_TAC [LIFT_SUM, FINITE_PERMUTATIONS, FINITE_NUMSEG, o_DEF] THEN
    MATCH_MP_TAC LIM_VSUM THEN
    SIMP_TAC [FINITE_PERMUTATIONS, FINITE_NUMSEG, LIFT_CMUL, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"p:num->num") THEN DISCH_TAC THEN
    MATCH_MP_TAC LIM_CMUL THEN
    MATCH_MP_TAC LIM_LIFT_PRODUCT THEN
    REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP PERMUTES_IMAGE) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE (← q r"s = t ==> s SUBSET t"))) THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_NUMSEG])

  let LIM_COFACTOR ← prove
   r"!net A:A->real^N^N B.
        (!x. ((\a. A a ** x) --> B ** x) net)
        ==> !x. ((\a. cofactor(A a) ** x) --> cofactor B ** x) net"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [LIM_COMPONENTWISE_LIFT] THEN
    SIMP_TAC [MATRIX_VECTOR_MUL_COMPONENT] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN REWRITE_TAC [dot, LIFT_SUM, o_DEF] THEN
    MATCH_MP_TAC LIM_VSUM THEN REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
    X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [cofactor, LAMBDA_BETA] THEN
    REWRITE_TAC [LIFT_CMUL] THEN MATCH_MP_TAC LIM_VMUL THEN
    REWRITE_TAC [o_DEF] THEN MATCH_MP_TAC LIM_LIFT_DET THEN
    MAP_EVERY X_GEN_TAC [← q r"k:num", ← q r"l:num"] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [LAMBDA_BETA] THEN
    ASM_CASES_TAC (← q r"k:num = i /\ l:num = j") THEN
    ASM_REWRITE_TAC [LIM_CONST] THEN
    ASM_CASES_TAC (← q r"k:num = i \/ l:num = j") THEN
    ASM_REWRITE_TAC [LIM_CONST] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"basis l:real^N")) THEN
    ASM_SIMP_TAC [MATRIX_VECTOR_MUL_BASIS, column] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_COMPONENT) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"k:num")) THEN ASM_SIMP_TAC [LAMBDA_BETA])

  let LIM_MATRIX_TRANSP ← prove
   r"!net A:A->real^M^N B.
        (!x. ((\a. transp(A a) ** x) --> transp B ** x) net) <=>
        (!x. ((\a. A a ** x) --> B ** x) net)"
   (REWRITE_TAC [LIM_MATRIX_COMPONENTWISE, TRANSP_COMPONENT] THEN MESON_TAC [])

  let LIM_MATRIX_INV ← prove
   r"!net A:A->real^N^N B.
        (!x. ((\a. A a ** x) --> B ** x) net) /\ ~(det B = &0)
        ==> !x. ((\a. matrix_inv(A a) ** x) --> matrix_inv B ** x) net"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_TRANSFORM THEN EXISTS_TAC
     (← q r"\a:A. (inv(det(A a:real^N^N)) %% transp(cofactor(A a))) ** (x:real^N)") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC LIM_EVENTUALLY THEN
      MATCH_MP_TAC EVENTUALLY_MONO THEN
      EXISTS_TAC (← q r"\a:A. ~(det(A a:real^N^N) = &0)") THEN
      SIMP_TAC [MATRIX_INV_COFACTOR, VECTOR_SUB_REFL] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_MATRIX_COMPONENTWISE]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP LIM_LIFT_DET) THEN
      REWRITE_TAC [tendsto] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"abs(det(B:real^N^N))")) THEN
      ASM_REWRITE_TAC [← GSYM REAL_ABS_NZ] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      REWRITE_TAC [DIST_LIFT] THEN REAL_ARITH_TAC,
      ASM_SIMP_TAC [MATRIX_INV_COFACTOR, MATRIX_VECTOR_LMUL] THEN
      MATCH_MP_TAC LIM_MUL THEN REWRITE_TAC [o_DEF] THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [o_DEF] LIM_INV) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC LIM_LIFT_DET THEN
        ASM_REWRITE_TAC [← GSYM LIM_MATRIX_COMPONENTWISE],
        SPEC_TAC (← q r"x:real^N", ← q r"x:real^N") THEN
        REWRITE_TAC [LIM_MATRIX_TRANSP] THEN
        MATCH_MP_TAC LIM_COFACTOR THEN ASM_REWRITE_TAC []]])

  let CONTINUOUS_LIFT_DET ← prove
   r"!(A:A->real^N^N) net.
        (!i j. 1 <= i /\ i <= dimindex(:N) /\
               1 <= j /\ j <= dimindex(:N)
               ==> (\x. lift(A x$i$j)) continuous net)
        ==> (\x. lift(det(A x))) continuous net"
   (REWRITE_TAC [continuous, LIM_LIFT_DET])

  let CONTINUOUS_ON_LIFT_DET ← prove
   r"!A:real^M->real^N^N s.
        (!i j. 1 <= i /\ i <= dimindex(:N) /\
               1 <= j /\ j <= dimindex(:N)
               ==> (\x. lift(A x$i$j)) continuous_on s)
        ==> (\x. lift(det(A x))) continuous_on s"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_LIFT_DET])

  let CONTINUOUS_DET_VECTORIZE ← prove
   r"!net A:A->real^N^N.
        (\a. vectorize(A a)) continuous net
        ==> (\a. lift(det(A a))) continuous net"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_LIFT_DET THEN
    ASM_REWRITE_TAC [← GSYM CONTINUOUS_VECTORIZE_COMPONENTWISE])

  let CONTINUOUS_ON_DET_VECTORIZE ← prove
   r"!A:real^M->real^N^N.
        (\a. vectorize(A a)) continuous_on s
        ==> (\a. lift(det(A a))) continuous_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_LIFT_DET THEN
    ASM_REWRITE_TAC [← GSYM CONTINUOUS_ON_VECTORIZE_COMPONENTWISE])

  let CONTINUOUS_DET_EXPLICIT ← prove
   r"!A:real^N^N e.
        &0 < e
        ==> ?d. &0 < d /\
                !A':real^N^N.
                    (!i j. 1 <= i /\ i <= dimindex(:N) /\
                           1 <= j /\ j <= dimindex(:N)
                           ==> abs(A'$i$j - A$i$j) < d)
                    ==> abs(det A' - det A) < e"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN
    PURE_REWRITE_TAC [NOT_EXISTS_THM, ← TAUT (← q r"~(p /\ q) <=> p ==> ~q"),
                      NOT_FORALL_THM, NOT_IMP] THEN
    DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
    REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
    REWRITE_TAC [SKOLEM_THM, REAL_NOT_LT, FORALL_AND_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"L:num->real^N^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"L:num->real^N^N", ← q r"A:real^N^N", ← q r"sequentially"]
      LIM_LIFT_DET) THEN
    REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [LIM_NULL] THEN
      MATCH_MP_TAC LIM_NULL_COMPARISON THEN
      EXISTS_TAC (← q r"\n. inv(&n + &1)") THEN
      ASM_SIMP_TAC [← GSYM LIFT_SUB, NORM_LIFT, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [EVENTUALLY_TRUE, SEQ_HARMONIC_OFFSET],
      REWRITE_TAC [LIM_SEQUENTIALLY, NOT_IMP, DIST_LIFT] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [LE_REFL, REAL_NOT_LT]])

  let NEARBY_INVERTIBLE_MATRIX ← prove
   r"!A:real^N^N.
     ?e. &0 < e /\ !x. ~(x = &0) /\ abs x < e ==> invertible(A + x %% mat 1)"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q r"A:real^N^N") CHARACTERISTIC_POLYNOMIAL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:num->real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"dimindex(:N)", ← q r"a:num->real"] REAL_POLYFUN_FINITE_ROOTS) THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (p ==> r) ==> (p <=> q) ==> r")) THEN CONJ_TAC THENL
     [EXISTS_TAC (← q r"dimindex(:N)") THEN ASM_REWRITE_TAC [IN_NUMSEG] THEN ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"lift") o MATCH_MP FINITE_IMAGE) THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIMIT_POINT_FINITE) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"lift(&0)")) THEN
    REWRITE_TAC [LIMPT_APPROACHABLE, EXISTS_IN_IMAGE, EXISTS_IN_GSPEC] THEN
    REWRITE_TAC [DIST_LIFT, LIFT_EQ, REAL_SUB_RZERO, NOT_FORALL_THM, NOT_IMP] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
            MP_TAC (← SPEC (← q r"--x:real") th))) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM o SPEC (← q r"--x:real")) THEN
    ASM_REWRITE_TAC [REAL_NEG_EQ_0, REAL_ABS_NEG] THEN
    ONCE_REWRITE_TAC [← GSYM INVERTIBLE_NEG] THEN
    REWRITE_TAC [INVERTIBLE_DET_NZ, CONTRAPOS_THM] THEN
    REWRITE_TAC [MATRIX_SUB, MATRIX_NEG_MINUS1] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"--x = -- &1 * x")] THEN
    REWRITE_TAC [← GSYM MATRIX_CMUL_ADD_LDISTRIB, ← GSYM MATRIX_CMUL_ASSOC] THEN
    REWRITE_TAC [MATRIX_CMUL_LID, MATRIX_ADD_SYM])

  let NEARBY_INVERTIBLE_MATRIX_GEN ← prove
   r"!A B:real^N^N.
        invertible B
        ==> ?e. &0 < e /\
                !x. ~(x = &0) /\ abs x < e ==> invertible(A + x %% B)"
   (REWRITE_TAC [INVERTIBLE_DET_NZ] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"matrix_inv(B:real^N^N) ** (A:real^N^N)")
          NEARBY_INVERTIBLE_MATRIX) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN
    ASM_REWRITE_TAC [INVERTIBLE_DET_NZ, CONTRAPOS_THM] THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"( * ) (det(matrix_inv(B:real^N^N)))")) THEN
    REWRITE_TAC [← GSYM DET_MUL, REAL_MUL_RZERO, MATRIX_ADD_LDISTRIB] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [MATRIX_MUL_RMUL] THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
    ASM_SIMP_TAC [MATRIX_MUL_LINV])

  let MATRIX_WLOG_INVERTIBLE ← prove
   r"!P. (!A:real^N^N. invertible A ==> P A) /\
       (!A:real^N^N. ?d. &0 < d /\
                         closed {x | x IN cball(vec 0,d) /\
                                     P(A + drop x %% mat 1)})
       ==> !A:real^N^N. P A"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^1") o
      GEN_REWRITE_RULE id [CLOSED_LIMPT]) THEN
    ASM_SIMP_TAC [IN_ELIM_THM, DROP_VEC, MATRIX_CMUL_LZERO, MATRIX_ADD_RID] THEN
    ANTS_TAC THENL [ALL_TAC, CONV_TAC (fun t => TAUT t)] THEN
    MP_TAC (← ISPEC (← q r"A:real^N^N") NEARBY_INVERTIBLE_MATRIX) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [LIMPT_APPROACHABLE] THEN X_GEN_TAC (← q r"k:real") THEN
    DISCH_TAC THEN REWRITE_TAC [EXISTS_LIFT, IN_ELIM_THM] THEN
    REWRITE_TAC [← GSYM LIFT_NUM, IN_CBALL_0, NORM_LIFT, DIST_LIFT] THEN
    REWRITE_TAC [REAL_SUB_RZERO, LIFT_EQ, LIFT_DROP] THEN
    EXISTS_TAC (← q r"min d ((min e k) / &2)") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, FIRST_X_ASSUM MATCH_MP_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC)

  return { LIM_LIFT_DET, LIM_COFACTOR, LIM_MATRIX_TRANSP, LIM_MATRIX_INV, CONTINUOUS_LIFT_DET,
           CONTINUOUS_ON_LIFT_DET, CONTINUOUS_DET_VECTORIZE, CONTINUOUS_ON_DET_VECTORIZE,
           CONTINUOUS_DET_EXPLICIT, NEARBY_INVERTIBLE_MATRIX, NEARBY_INVERTIBLE_MATRIX_GEN,
           MATRIX_WLOG_INVERTIBLE }

/- ------------------------------------------------------------------------- -/
/- Sylvester's determinant identity.  (topology.ml 19189-19328)              -/
/- ------------------------------------------------------------------------- -/

structure SYL where
  SYLVESTER_DETERMINANT_IDENTITY : thm
  deriving Inhabited

@[nospecialize]
def setupSYL [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLPT : LPT) (BCBL : CBL) (BCMB : CMB)
    (BIDC : IDC) (BCLC : CLC) (BMID1 : MID1) : ExceptT String IO SYL := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, REAL_RING, SET_RULE, SET_TAC, .. } := D
  let { CART_EQ, DE_MORGAN_THM, EQ_TRANS, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IN_DIFF, IN_ELIM_THM, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LE_REFL, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, NOT_LE, NOT_LT,
        REAL_ADD_LID, .. } := D.core3
  let { REAL_ENTIRE, REAL_EQ_ADD_LCANCEL_0, REAL_LT_01, .. } := D.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, REAL_SUB_0, SUBSET, SUBSET_NUMSEG, .. } := D.core5
  let { SUM_EQ_0_NUMSEG, SUM_EQ_GENERAL, SUM_EQ_NUMSEG, SUM_EQ_SUPERSET, SUM_SUPERSET,
        SWAP_FORALL_THM, o_DEF, .. } := D.core6
  let { PRODUCT_ADD_SPLIT, PRODUCT_EQ_0_NUMSEG, PRODUCT_EQ_1_NUMSEG, PRODUCT_EQ_NUMSEG,
        PERMUTES_IMAGE, PERMUTES_SUBSET, PERMUTES_SUPERSET, permutes, .. } := D.lib2
  let { LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, LIFT_SUB, LIFT_SUM,
        MATRIX_ADD_COMPONENT, MATRIX_ADD_LDISTRIB, MATRIX_ADD_RDISTRIB, MATRIX_CMUL_COMPONENT,
        MATRIX_MUL_ASSOC, MATRIX_MUL_LID, MATRIX_MUL_RID, .. } := D.vec2
  let { MAT_COMPONENT, .. } := D.vec3
  let { matrix_mul, .. } := D.vec4
  let { DET_MUL, INVERTIBLE_DET_NZ, det, .. } := D.det
  let { CLOSED_INTER, .. } := BCLO
  let { CLOSED_SING, .. } := BLPT
  let { CLOSED_CBALL, .. } := BCBL
  let { CONTINUOUS_ADD, CONTINUOUS_CMUL, CONTINUOUS_CONST, CONTINUOUS_SUB, CONTINUOUS_VSUM, .. } :=
    BCMB
  let { CONTINUOUS_AT_ID, .. } := BIDC
  let { CONTINUOUS_CLOSED_PREIMAGE_UNIV, .. } := BCLC
  let { CONTINUOUS_LIFT_DET, MATRIX_WLOG_INVERTIBLE, .. } := BMID1
  -- @@SCOPE END

  let SYLVESTER_DETERMINANT_IDENTITY ← do
    let lemma1 ← prove
     r"!A:real^N^N B:real^N^N. det(mat 1 + A ** B) = det(mat 1 + B ** A)"
     (ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN GEN_TAC THEN
      MATCH_MP_TAC MATRIX_WLOG_INVERTIBLE THEN CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN
        SUBGOAL_THEN (← q r"det((mat 1 + A ** B) ** A:real^N^N) =
                      det(A ** (mat 1 + B ** A))")
        MP_TAC THENL
         [REWRITE_TAC [MATRIX_ADD_RDISTRIB, MATRIX_ADD_LDISTRIB] THEN
          REWRITE_TAC [MATRIX_MUL_LID, MATRIX_MUL_RID, MATRIX_MUL_ASSOC],
          REWRITE_TAC [DET_MUL] THEN
          FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INVERTIBLE_DET_NZ]) THEN
          CONV_TAC (fun t => REAL_RING t)],
        X_GEN_TAC (← q r"A:real^N^N") THEN EXISTS_TAC (← q r"&1") THEN
        REWRITE_TAC [REAL_LT_01, ← SET_RULE
         (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
        MATCH_MP_TAC CLOSED_INTER THEN REWRITE_TAC [CLOSED_CBALL] THEN
        ONCE_REWRITE_TAC [← GSYM REAL_SUB_0] THEN
        REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM] THEN
        REWRITE_TAC [← SET_RULE (← q r"{x | f x = a} = {x | f x IN {a}}")] THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
        REWRITE_TAC [CLOSED_SING, LIFT_SUB] THEN X_GEN_TAC (← q r"x:real^1") THEN
        REWRITE_TAC [o_DEF, LIFT_SUB] THEN MATCH_MP_TAC CONTINUOUS_SUB THEN
        CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_LIFT_DET THEN
        MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN STRIP_TAC THEN
        ASM_SIMP_TAC [MATRIX_ADD_COMPONENT, LIFT_ADD] THEN
        MATCH_MP_TAC CONTINUOUS_ADD THEN
        ASM_SIMP_TAC [matrix_mul, LAMBDA_BETA, CONTINUOUS_CONST] THEN
        SIMP_TAC [LIFT_SUM, FINITE_NUMSEG, o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_VSUM THEN
        REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN X_GEN_TAC (← q r"k:num") THEN
        DISCH_TAC THENL [ONCE_REWRITE_TAC [REAL_MUL_SYM], ALL_TAC] THEN
        REWRITE_TAC [LIFT_CMUL] THEN MATCH_MP_TAC CONTINUOUS_CMUL THEN
        REWRITE_TAC [MATRIX_ADD_COMPONENT, MATRIX_CMUL_COMPONENT, LIFT_ADD] THEN
        MATCH_MP_TAC CONTINUOUS_ADD THEN REWRITE_TAC [CONTINUOUS_CONST] THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] LIFT_CMUL] THEN
        MATCH_MP_TAC CONTINUOUS_CMUL THEN
        REWRITE_TAC [LIFT_DROP, CONTINUOUS_AT_ID]])
    let lemma2 ← prove
     r"!A:real^N^M B:real^M^N.
            dimindex(:M) <= dimindex(:N)
            ==> det(mat 1 + A ** B) = det(mat 1 + B ** A)"
     (REPEAT STRIP_TAC THEN
      MAP_EVERY ABBREV_TAC
       [← q r"A':real^N^N =
            lambda i j. if i <= dimindex(:M) then (A:real^N^M)$i$j
                        else &0",
        ← q r"B':real^N^N =
            lambda i j. if j <= dimindex(:M) then (B:real^M^N)$i$j
                        else &0"] THEN
      MP_TAC (← ISPECL [← q r"A':real^N^N", ← q r"B':real^N^N"] lemma1) THEN
      SUBGOAL_THEN
       (← q r"(B':real^N^N) ** (A':real^N^N) = (B:real^M^N) ** (A:real^N^M)")
      SUBST1_TAC THENL
       [MAP_EVERY EXPAND_TAC ["A'", "B'"] THEN
        SIMP_TAC [CART_EQ, LAMBDA_BETA, matrix_mul] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC SUM_EQ_SUPERSET THEN
        ASM_SIMP_TAC [IN_NUMSEG, REAL_MUL_LZERO, FINITE_NUMSEG, SUBSET_NUMSEG,
                      LE_REFL, ← TAUT (← q r"(p /\ q) /\ ~(p /\ r) <=> p /\ q /\ ~r")],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      REWRITE_TAC [det] THEN MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
       (← q r"sum {p | p permutes 1..dimindex(:N) /\ !i. dimindex(:M) < i ==> p i = i}
            (\p. sign p * product (1..dimindex(:N))
                       (\i. (mat 1 + (A':real^N^N) ** (B':real^N^N))$i$p i))") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_SUPERSET THEN
        CONJ_TAC THENL [SET_TAC [], SIMP_TAC [IN_ELIM_THM, IMP_CONJ]] THEN
        X_GEN_TAC (← q r"p:num->num") THEN REPEAT STRIP_TAC THEN
        REWRITE_TAC [REAL_ENTIRE, PRODUCT_EQ_0_NUMSEG] THEN DISJ2_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM]) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:num") THEN
        REWRITE_TAC [NOT_IMP] THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"k:num") o CONJUNCT1 o
          GEN_REWRITE_RULE id [permutes]) THEN
        ASM_REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP PERMUTES_IMAGE) THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE (← q r"s = t ==> s SUBSET t"))) THEN
        ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_NUMSEG] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"k:num")) THEN ASM_SIMP_TAC [] THEN STRIP_TAC THEN
        ASM_SIMP_TAC [MATRIX_ADD_COMPONENT, MAT_COMPONENT, REAL_ADD_LID] THEN
        ASM_SIMP_TAC [matrix_mul, LAMBDA_BETA] THEN
        MATCH_MP_TAC SUM_EQ_0_NUMSEG THEN REPEAT STRIP_TAC THEN
        REWRITE_TAC [REAL_ENTIRE] THEN DISJ1_TAC THEN EXPAND_TAC "A'" THEN
        ASM_SIMP_TAC [LAMBDA_BETA, ← GSYM NOT_LT]] THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_EQ_GENERAL THEN
      EXISTS_TAC (← q r"\f:num->num. f") THEN REWRITE_TAC [IN_ELIM_THM] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"p:num->num") THEN STRIP_TAC THENL
       [REWRITE_TAC [← MESON [] (← q r"(?!x. P x /\ x = y) <=> P y")] THEN CONJ_TAC THENL
         [MATCH_MP_TAC PERMUTES_SUBSET THEN
          EXISTS_TAC (← q r"1..dimindex(:M)") THEN
          ASM_REWRITE_TAC [SUBSET_NUMSEG, LE_REFL],
          X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o CONJUNCT1 o
            GEN_REWRITE_RULE id [permutes]) THEN
          ASM_REWRITE_TAC [IN_NUMSEG, DE_MORGAN_THM, NOT_LE]],
        MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
         [MATCH_MP_TAC PERMUTES_SUPERSET THEN
          EXISTS_TAC (← q r"1..dimindex(:N)") THEN
          ASM_REWRITE_TAC [IN_DIFF, IN_NUMSEG] THEN ASM_MESON_TAC [NOT_LE],
          DISCH_TAC] THEN
        AP_TERM_TAC THEN FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← ARITH_RULE
         (← q r"m:num <= n ==> n = m + (n - m)"))) THEN
        SIMP_TAC [PRODUCT_ADD_SPLIT, ← ARITH_RULE (← q r"1 <= n + 1")] THEN
        MATCH_MP_TAC (← REAL_RING (← q r"x = y /\ z = &1 ==> x = y * z")) THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC PRODUCT_EQ_NUMSEG THEN
          X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
          SUBGOAL_THEN (← q r"i <= dimindex(:N)") ASSUME_TAC THENL
           [ASM_ARITH_TAC, ALL_TAC] THEN
          MP_TAC (← ISPECL [← q r"p:num->num", ← q r"1..dimindex(:M)"] PERMUTES_IMAGE) THEN
          ASM_REWRITE_TAC [] THEN
          DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE (← q r"s = t ==> s SUBSET t"))) THEN
          ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_NUMSEG] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"i:num")) THEN
          ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
          SUBGOAL_THEN (← q r"(p:num->num) i <= dimindex(:N)") ASSUME_TAC THENL
           [ASM_ARITH_TAC, ALL_TAC] THEN
          ASM_SIMP_TAC [MATRIX_ADD_COMPONENT, MAT_COMPONENT] THEN
          AP_TERM_TAC THEN ASM_SIMP_TAC [matrix_mul, LAMBDA_BETA] THEN
          MATCH_MP_TAC SUM_EQ_NUMSEG THEN REPEAT STRIP_TAC THEN
          MAP_EVERY EXPAND_TAC ["A'", "B'"] THEN
          ASM_SIMP_TAC [LAMBDA_BETA],
          MATCH_MP_TAC PRODUCT_EQ_1_NUMSEG THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"n + 1 <= i ==> n < i")] THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"m:num <= n ==> m + (n - m) = n")] THEN
          X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
          SUBGOAL_THEN (← q r"1 <= i") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
          ASM_SIMP_TAC [MATRIX_ADD_COMPONENT, MAT_COMPONENT] THEN
          ASM_SIMP_TAC [REAL_EQ_ADD_LCANCEL_0, matrix_mul, LAMBDA_BETA] THEN
          MATCH_MP_TAC SUM_EQ_0_NUMSEG THEN REPEAT STRIP_TAC THEN
          REWRITE_TAC [REAL_ENTIRE] THEN DISJ1_TAC THEN EXPAND_TAC "A'" THEN
          ASM_SIMP_TAC [LAMBDA_BETA, ← ARITH_RULE (← q r"m + 1 <= i ==> ~(i <= m)")]]])
    prove
     r"!A:real^N^M B:real^M^N. det(mat 1 + A ** B) = det(mat 1 + B ** A)"
     (REPEAT GEN_TAC THEN DISJ_CASES_TAC (← ARITH_RULE
       (← q r"dimindex(:M) <= dimindex(:N) \/ dimindex(:N) <= dimindex(:M)"))
      THENL [ALL_TAC, CONV_TAC SYM_CONV] THEN
      MATCH_MP_TAC lemma2 THEN ASM_REWRITE_TAC [])

  return { SYLVESTER_DETERMINANT_IDENTITY }

/- ------------------------------------------------------------------------- -/
/- Cofactor identities by continuity.  (topology.ml 19329-19490)             -/
/- ------------------------------------------------------------------------- -/

structure CFM where
  COFACTOR_MATRIX_MUL : thm
  DET_COFACTOR : thm
  INVERTIBLE_COFACTOR : thm
  COFACTOR_COFACTOR : thm
  RANK_COFACTOR_EQ_FULL : thm
  deriving Inhabited

@[nospecialize]
def setupCFM [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLPT : LPT) (BCBL : CBL) (BCMB : CMB)
    (BIDC : IDC) (BCLC : CLC) (BSMI : SMI) (BMID1 : MID1) : ExceptT String IO CFM := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, REAL_ARITH_TAC, REAL_FIELD, SET_RULE, .. } := D
  let { CART_EQ, DE_MORGAN_THM, DIMINDEX_GE_1, DISJ_ACI, FINITE_NUMSEG, .. } := D.core1
  let { IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, .. } := D.core3
  let { REAL_INV_POW, REAL_LT_01, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_SYM, REAL_POW_2, REAL_POW_EQ_0, REAL_POW_SUB,
        REAL_SUB_0, RIGHT_AND_FORALL_THM, RIGHT_FORALL_IMP_THM, .. } := D.core5
  let { o_DEF, real_div, real_pow, .. } := D.core6
  let { LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, LIFT_SUB, LIFT_SUM,
        MATRIX_ADD_COMPONENT, MATRIX_CMUL_ASSOC, MATRIX_CMUL_COMPONENT, MATRIX_CMUL_LID,
        MATRIX_MUL_ASSOC, MATRIX_MUL_LID, MATRIX_MUL_LMUL, MATRIX_MUL_RID, MATRIX_MUL_RMUL,
        MATRIX_TRANSP_MUL, .. } := D.vec2
  let { TRANSP_MAT, .. } := D.vec3
  let { TRANSP_MATRIX_CMUL, TRANSP_TRANSP, matrix_mul, .. } := D.vec4
  let { COFACTOR_CMUL, COFACTOR_I, COFACTOR_MATRIX_INV, COFACTOR_TRANSP, DET_CMUL, DET_I,
        DET_MUL, DET_TRANSP, INVERTIBLE_DET_NZ, INVERTIBLE_MATRIX_MUL, MATRIX_INV_MUL,
        MATRIX_MUL_LEFT_COFACTOR, MATRIX_MUL_RIGHT_COFACTOR, RANK_EQ_FULL_DET, cofactor, .. } :=
    D.det
  let { CLOSED_FORALL, CLOSED_FORALL_IN, CLOSED_INTER, .. } := BCLO
  let { CLOSED_SING, .. } := BLPT
  let { CLOSED_CBALL, .. } := BCBL
  let { CONTINUOUS_ADD, CONTINUOUS_CMUL, CONTINUOUS_CONST, CONTINUOUS_SUB, CONTINUOUS_VSUM, .. } :=
    BCMB
  let { CONTINUOUS_AT_ID, .. } := BIDC
  let { CONTINUOUS_CLOSED_PREIMAGE_UNIV, .. } := BCLC
  let { CONTINUOUS_LIFT_POW, CONTINUOUS_MUL, .. } := BSMI
  let { CONTINUOUS_LIFT_DET, MATRIX_WLOG_INVERTIBLE, .. } := BMID1
  -- @@SCOPE END

  let COFACTOR_MATRIX_MUL ← prove
   r"!A B:real^N^N. cofactor(A ** B) = cofactor(A) ** cofactor(B)"
   (MATCH_MP_TAC MATRIX_WLOG_INVERTIBLE THEN CONJ_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC MATRIX_WLOG_INVERTIBLE THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [COFACTOR_MATRIX_INV, ← GSYM INVERTIBLE_DET_NZ,
                      INVERTIBLE_MATRIX_MUL] THEN
        REWRITE_TAC [DET_MUL, MATRIX_MUL_LMUL] THEN
        REWRITE_TAC [MATRIX_MUL_RMUL, MATRIX_CMUL_ASSOC,
                     ← GSYM MATRIX_TRANSP_MUL] THEN
        ASM_SIMP_TAC [MATRIX_INV_MUL],
        GEN_TAC THEN EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01]],
      X_GEN_TAC (← q r"A:real^N^N") THEN EXISTS_TAC (← q r"&1") THEN
      REWRITE_TAC [REAL_LT_01] THEN REWRITE_TAC [RIGHT_AND_FORALL_THM] THEN
      MATCH_MP_TAC CLOSED_FORALL THEN GEN_TAC] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
    MATCH_MP_TAC CLOSED_INTER THEN REWRITE_TAC [CLOSED_CBALL] THEN
    REWRITE_TAC [CART_EQ] THEN
    MATCH_MP_TAC CLOSED_FORALL_IN THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_FORALL_IN THEN X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SUB_0] THEN
    REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | f x = a} = {x | f x IN {a}}")] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
    REWRITE_TAC [CLOSED_SING, LIFT_SUB] THEN X_GEN_TAC (← q r"x:real^1") THEN
    ASM_SIMP_TAC [matrix_mul, LAMBDA_BETA, cofactor, LIFT_SUM,
                  FINITE_NUMSEG, o_DEF] THEN
    (MATCH_MP_TAC CONTINUOUS_SUB THEN CONJ_TAC THENL
      [ALL_TAC,
       MATCH_MP_TAC CONTINUOUS_VSUM THEN
       REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
       X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
       REWRITE_TAC [LIFT_CMUL] THEN MATCH_MP_TAC CONTINUOUS_MUL THEN
       REWRITE_TAC [o_DEF] THEN CONJ_TAC]) THEN
    MATCH_MP_TAC CONTINUOUS_LIFT_DET THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [LAMBDA_BETA, CONTINUOUS_CONST] THEN
    REPEAT (W (fun g => tactic_of do
      let t ← liftExcept (HolCore.Basics.find_term HolCore.Classic.is_cond (snd g))
      let c ← liftExcept (do let r ← rator t; lhand r)
      pure (ASM_CASES_TAC c THEN ASM_REWRITE_TAC [CONTINUOUS_CONST]))) THEN
    SIMP_TAC [LIFT_SUM, FINITE_NUMSEG, o_DEF] THEN
    TRY (MATCH_MP_TAC CONTINUOUS_VSUM THEN REWRITE_TAC [FINITE_NUMSEG] THEN
         REWRITE_TAC [IN_NUMSEG] THEN X_GEN_TAC (← q r"p:num") THEN STRIP_TAC) THEN
    REWRITE_TAC [LIFT_CMUL] THEN
    TRY (MATCH_MP_TAC CONTINUOUS_MUL THEN
         REWRITE_TAC [o_DEF, CONTINUOUS_CONST]) THEN
    REWRITE_TAC [MATRIX_ADD_COMPONENT, LIFT_ADD] THEN
    MATCH_MP_TAC CONTINUOUS_ADD THEN REWRITE_TAC [CONTINUOUS_CONST] THEN
    REWRITE_TAC [MATRIX_CMUL_COMPONENT, LIFT_CMUL, o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_MUL THEN
    REWRITE_TAC [CONTINUOUS_CONST, o_DEF, LIFT_DROP, CONTINUOUS_AT_ID])

  let DET_COFACTOR ← prove
   r"!A:real^N^N. det(cofactor A) = det(A) pow (dimindex(:N) - 1)"
   (MATCH_MP_TAC MATRIX_WLOG_INVERTIBLE THEN CONJ_TAC THEN
    X_GEN_TAC (← q r"A:real^N^N") THENL
     [REWRITE_TAC [INVERTIBLE_DET_NZ] THEN STRIP_TAC THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_FIELD
       (← q r"~(a = &0) ==> a * x = a * y ==> x = y"))) THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM DET_TRANSP] THEN
      REWRITE_TAC [← GSYM DET_MUL, MATRIX_MUL_RIGHT_COFACTOR] THEN
      REWRITE_TAC [DET_CMUL, ← GSYM (← CONJUNCT2 real_pow), DET_I, REAL_MUL_RID] THEN
      SIMP_TAC [DIMINDEX_GE_1, ← ARITH_RULE (← q r"1 <= n ==> SUC(n - 1) = n")],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
    MATCH_MP_TAC CLOSED_INTER THEN REWRITE_TAC [CLOSED_CBALL] THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SUB_0] THEN
    REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | f x = a} = {x | f x IN {a}}")] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
    REWRITE_TAC [CLOSED_SING, LIFT_SUB] THEN X_GEN_TAC (← q r"x:real^1") THEN
    MATCH_MP_TAC CONTINUOUS_SUB THEN
    CONJ_TAC THENL [ALL_TAC, MATCH_MP_TAC CONTINUOUS_LIFT_POW] THEN
    MATCH_MP_TAC CONTINUOUS_LIFT_DET THEN
    MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [MATRIX_ADD_COMPONENT, MATRIX_CMUL_COMPONENT, LIFT_ADD,
                  LIFT_CMUL, LIFT_DROP, CONTINUOUS_ADD, CONTINUOUS_CONST,
                  CONTINUOUS_MUL, o_DEF, LIFT_DROP, CONTINUOUS_AT_ID] THEN
    ASM_SIMP_TAC [cofactor, LAMBDA_BETA] THEN
    MATCH_MP_TAC CONTINUOUS_LIFT_DET THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [LAMBDA_BETA] THEN
    REPEAT (W (fun g => tactic_of do
      let t ← liftExcept (HolCore.Basics.find_term HolCore.Classic.is_cond (snd g))
      let c ← liftExcept (do let r ← rator t; lhand r)
      pure (ASM_CASES_TAC c THEN ASM_REWRITE_TAC [CONTINUOUS_CONST]))) THEN
    ASM_SIMP_TAC [MATRIX_ADD_COMPONENT, MATRIX_CMUL_COMPONENT, LIFT_ADD,
                  LIFT_CMUL, LIFT_DROP, CONTINUOUS_ADD, CONTINUOUS_CONST,
                  CONTINUOUS_MUL, o_DEF, LIFT_DROP, CONTINUOUS_AT_ID])

  let INVERTIBLE_COFACTOR ← prove
   r"!A:real^N^N. invertible(cofactor A) <=> dimindex(:N) = 1 \/ invertible A"
   (SIMP_TAC [DET_COFACTOR, INVERTIBLE_DET_NZ, REAL_POW_EQ_0, DE_MORGAN_THM,
              DIMINDEX_GE_1, ← ARITH_RULE (← q r"1 <= n ==> (n - 1 = 0 <=> n = 1)"),
              DISJ_ACI])

  let COFACTOR_COFACTOR ← prove
   r"!A:real^N^N.
     2 <= dimindex(:N)
     ==> cofactor(cofactor A) = (det(A) pow (dimindex(:N) - 2)) %% A"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC MATRIX_WLOG_INVERTIBLE THEN CONJ_TAC THEN
    X_GEN_TAC (← q r"A:real^N^N") THENL
     [REWRITE_TAC [INVERTIBLE_DET_NZ] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"A:real^N^N", ← q r"transp(cofactor A):real^N^N"]
          COFACTOR_MATRIX_MUL) THEN
      REWRITE_TAC [MATRIX_MUL_RIGHT_COFACTOR, COFACTOR_CMUL, COFACTOR_I] THEN
      REWRITE_TAC [COFACTOR_TRANSP] THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"transp:real^N^N->real^N^N")) THEN
      REWRITE_TAC [MATRIX_TRANSP_MUL, TRANSP_TRANSP, TRANSP_MATRIX_CMUL] THEN
      REWRITE_TAC [TRANSP_MAT] THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"(\x. x ** A):real^N^N->real^N^N")) THEN
      REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_LEFT_COFACTOR] THEN
      REWRITE_TAC [MATRIX_MUL_LMUL, MATRIX_MUL_RMUL] THEN
      REWRITE_TAC [MATRIX_MUL_LID, MATRIX_MUL_RID] THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"\x:real^N^N. inv(det(A:real^N^N)) %% x")) THEN
      ASM_SIMP_TAC [MATRIX_CMUL_ASSOC, REAL_MUL_LINV, MATRIX_CMUL_LID] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [REAL_POW_SUB, ← ARITH_RULE (← q r"2 <= n ==> 1 <= n")] THEN
      REWRITE_TAC [REAL_POW_2, real_div, REAL_INV_POW] THEN REAL_ARITH_TAC,
      POP_ASSUM (K ALL_TAC : thm → tactic)] THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
    MATCH_MP_TAC CLOSED_INTER THEN REWRITE_TAC [CLOSED_CBALL] THEN
    REWRITE_TAC [CART_EQ] THEN
    MATCH_MP_TAC CLOSED_FORALL_IN THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_FORALL_IN THEN X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SUB_0] THEN
    REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | f x = a} = {x | f x IN {a}}")] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
    REWRITE_TAC [CLOSED_SING, LIFT_SUB] THEN X_GEN_TAC (← q r"x:real^1") THEN
    MATCH_MP_TAC CONTINUOUS_SUB THEN CONJ_TAC THENL
     [REPLICATE_TAC 2
       (ONCE_REWRITE_TAC [cofactor] THEN ASM_SIMP_TAC [LAMBDA_BETA] THEN
        MATCH_MP_TAC CONTINUOUS_LIFT_DET THEN REPEAT STRIP_TAC THEN
        ASM_SIMP_TAC [LAMBDA_BETA] THEN
        REPEAT (W (fun g => tactic_of do
          let t ← liftExcept (HolCore.Basics.find_term HolCore.Classic.is_cond (snd g))
          let c ← liftExcept (do let r ← rator t; lhand r)
          pure (ASM_CASES_TAC c THEN
                ASM_REWRITE_TAC [CONTINUOUS_CONST])))),
      REWRITE_TAC [MATRIX_CMUL_COMPONENT, LIFT_CMUL] THEN
      MATCH_MP_TAC CONTINUOUS_MUL THEN REWRITE_TAC [o_DEF] THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_LIFT_POW THEN
        MATCH_MP_TAC CONTINUOUS_LIFT_DET THEN REPEAT STRIP_TAC,
        ALL_TAC]] THEN
    REWRITE_TAC [MATRIX_ADD_COMPONENT, MATRIX_CMUL_COMPONENT] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [LIFT_ADD, LIFT_CMUL, LIFT_DROP] THEN
    SIMP_TAC [CONTINUOUS_ADD, CONTINUOUS_CONST, CONTINUOUS_CMUL,
              CONTINUOUS_AT_ID])

  let RANK_COFACTOR_EQ_FULL ← prove
   r"!A:real^N^N. rank(cofactor A) = dimindex(:N) <=>
                dimindex(:N) = 1 \/ rank A = dimindex(:N)"
   (REWRITE_TAC [RANK_EQ_FULL_DET, DET_COFACTOR, REAL_POW_EQ_0] THEN
    SIMP_TAC [DIMINDEX_GE_1, ← ARITH_RULE (← q r"1 <= n ==> (n - 1 = 0 <=> n = 1)")] THEN
    CONV_TAC (fun t => TAUT t))

  return { COFACTOR_MATRIX_MUL, DET_COFACTOR, INVERTIBLE_COFACTOR, COFACTOR_COFACTOR,
           RANK_COFACTOR_EQ_FULL }

/- ------------------------------------------------------------------------- -/
/- Rank of the cofactor matrix.  (topology.ml 19491-19668)                   -/
/- ------------------------------------------------------------------------- -/

structure CEZ where
  COFACTOR_EQ_0 : thm
  RANK_COFACTOR_EQ_1 : thm
  RANK_COFACTOR : thm
  deriving Inhabited

@[nospecialize]
def setupCEZ [HolBase] (D : TopologyDeps) (BCFM : CFM) : ExceptT String IO CEZ := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, VECTOR_ARITH, .. } := D
  let { ARITH_EQ, CARD_DELETE, CARD_IMAGE_LE, CARD_NUMSEG_1, CART_EQ, COND_ID, CONJ_SYM,
        DIMINDEX_GE_1, EQ_TRANS, EXISTS_IN_GSPEC, FINITE_DELETE, FINITE_IMAGE, FINITE_NUMSEG,
        .. } := D.core1
  let { FORALL_IN_GSPEC, IMP_CONJ, IMP_CONJ_ALT, IN_DELETE, IN_IMAGE, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LAMBDA_ETA, LE_REFL, LE_TRANS, LT_REFL, MONO_EXISTS, NOT_FORALL_THM,
        NOT_IMP, PSUBSET, .. } := D.core3
  let { REAL_DIV_REFL, REAL_ENTIRE, .. } := D.core4
  let { REAL_MUL_RZERO, SIMPLE_IMAGE, SUBSET, SUBSET_UNIV, .. } := D.core5
  let { SUM_EQ_0, SUM_LMUL, .. } := D.core6
  let { DIM_INSERT, DIM_LE_CARD, DIM_LINEAR_IMAGE_LE, DIM_SPAN, DIM_SUBSET, DIM_UNIV, .. } :=
    D.vec1
  let { MATRIX_CMUL_EQ_0, MATRIX_CMUL_LZERO, MATRIX_MUL_LZERO, .. } := D.vec2
  let { MAT_COMPONENT, MAT_EQ, RANK_0, RANK_BOUND, RANK_EQ_0, RANK_ROW, RANK_SYLVESTER,
        RANK_TRANSP, SPAN_MUL, SPAN_SUPERSET, SPAN_VSUM, TRANSP_MAT, .. } := D.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT, VSUM_COMPONENT, VSUM_DELETE,
        basis, linear, matrix_vector_mul, row, rows, transp, .. } := D.vec4
  let { DET_COFACTOR_EXPANSION, DET_EQ_0_RANK, HOMOGENEOUS_LINEAR_EQUATIONS_DET,
        MATRIX_MUL_LEFT_COFACTOR, MATRIX_MUL_RIGHT_COFACTOR, RANK_EQ_FULL_DET, cofactor, .. } :=
    D.det
  let { RANK_COFACTOR_EQ_FULL, .. } := BCFM
  -- @@SCOPE END

  let COFACTOR_EQ_0 ← do
    let lemma1 ← prove
     r"!A:real^N^N. rank(A) < dimindex(:N) - 1 ==> cofactor A = mat 0"
     (GEN_TAC THEN REWRITE_TAC [RANK_ROW] THEN DISCH_TAC THEN
      SIMP_TAC [CART_EQ, cofactor, MAT_COMPONENT, LAMBDA_BETA, COND_ID] THEN
      X_GEN_TAC (← q r"m:num") THEN STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
      REWRITE_TAC [DET_EQ_0_RANK] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ARITH_RULE (← q r"r < n - 1 ==> s <= r + 1 ==> s < n"))) THEN
      REWRITE_TAC [RANK_ROW, rows] THEN MATCH_MP_TAC LE_TRANS THEN
      EXISTS_TAC
       (← q r"dim (basis n INSERT
             {row i ((lambda k l. if l = n then &0 else (A:real^N^N)$k$l)
                     :real^N^N)
              | i IN (1..dimindex(:N)) DELETE m})") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC DIM_SUBSET THEN REWRITE_TAC [← GSYM IN_NUMSEG] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"m IN s /\ (!i. i IN s DELETE m ==> f i = g i) /\ f m = a
          ==> {f i | i IN s} SUBSET a INSERT {g i | i IN s DELETE m}")) THEN
        ASM_SIMP_TAC [IN_NUMSEG, IN_DELETE, row, LAMBDA_BETA, basis, LAMBDA_ETA],
        REWRITE_TAC [DIM_INSERT] THEN MATCH_MP_TAC (← ARITH_RULE
         (← q r"n <= k ==> (if p then n else n + 1) <= k + 1")) THEN
        MATCH_MP_TAC (← MESON [DIM_LINEAR_IMAGE_LE, DIM_SUBSET, LE_TRANS]
         (← q r"(?f. linear f /\ t SUBSET IMAGE f s) ==> dim t <= dim s")) THEN
        EXISTS_TAC (← q r"(\x. lambda i. if i = n then &0 else x$i)
                    :real^N->real^N") THEN
        REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN CONJ_TAC THENL
         [SIMP_TAC [linear, CART_EQ, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                    VECTOR_MUL_COMPONENT] THEN
          REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
          REAL_ARITH_TAC,
          X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [IN_NUMSEG, IN_DELETE] THEN
          STRIP_TAC THEN REWRITE_TAC [IN_IMAGE] THEN
          ONCE_REWRITE_TAC [CONJ_SYM] THEN
          REWRITE_TAC [EXISTS_IN_GSPEC] THEN EXISTS_TAC (← q r"i:num") THEN
          ASM_SIMP_TAC [row, CART_EQ, LAMBDA_BETA]]])
    let lemma2 ← prove
     r"!A:real^N^N.
            rank A < dimindex(:N)
            ==> ?n x. 1 <= n /\ n <= dimindex(:N) /\
                      rank A <
                      rank((lambda i. if i = n then x else row i A):real^N^N)"
     (REPEAT STRIP_TAC THEN SUBGOAL_THEN
       (← q r"?n. 1 <= n /\ n <= dimindex(:N) /\
            row n (A:real^N^N) IN
            span {row j A | j IN (1..dimindex(:N)) DELETE n}")
      MP_TAC THENL
       [MP_TAC (← ISPEC (← q r"transp A:real^N^N") HOMOGENEOUS_LINEAR_EQUATIONS_DET) THEN
        ASM_REWRITE_TAC [DET_EQ_0_RANK, RANK_TRANSP] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CART_EQ]) THEN
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, VEC_COMPONENT] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CART_EQ]) THEN
        SIMP_TAC [matrix_vector_mul, transp, VEC_COMPONENT, LAMBDA_BETA] THEN
        DISCH_TAC THEN
        SUBGOAL_THEN (← q r"row n A = vsum ((1..dimindex(:N)) DELETE n)
                         (\i. --((c:real^N)$i / c$n) % row i (A:real^N^N))")
        SUBST1_TAC THENL
         [ASM_SIMP_TAC [VSUM_DELETE, FINITE_NUMSEG, IN_NUMSEG, REAL_DIV_REFL] THEN
          REWRITE_TAC [← VECTOR_ARITH (← q r"n = x - -- &1 % n <=> x:real^N = vec 0")] THEN
          SIMP_TAC [VSUM_COMPONENT, row, VECTOR_MUL_COMPONENT, LAMBDA_BETA,
            CART_EQ, ← REAL_ARITH (← q r"--(x / y) * z:real = --(inv y) * z * x")] THEN
          ASM_SIMP_TAC [SUM_LMUL, VEC_COMPONENT, REAL_MUL_RZERO],
          MATCH_MP_TAC SPAN_VSUM THEN SIMP_TAC [FINITE_DELETE, FINITE_NUMSEG] THEN
          X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [IN_DELETE, IN_NUMSEG] THEN
          STRIP_TAC THEN MATCH_MP_TAC SPAN_MUL THEN
          MATCH_MP_TAC SPAN_SUPERSET THEN ASM SET_TAC []],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"span {row j (A:real^N^N) | j IN (1..dimindex(:N)) DELETE n}
                      PSUBSET (:real^N)")
        MP_TAC THENL
         [REWRITE_TAC [PSUBSET, SUBSET_UNIV] THEN
          DISCH_THEN (MP_TAC o AP_TERM (← q r"dim:(real^N->bool)->num")) THEN
          REWRITE_TAC [DIM_UNIV] THEN
          MATCH_MP_TAC (← ARITH_RULE (← q r"1 <= n /\ x <= n - 1 ==> ~(x = n)")) THEN
          REWRITE_TAC [DIMINDEX_GE_1, DIM_SPAN] THEN
          W (MP_TAC o PART_MATCH (lhand o rand) DIM_LE_CARD o lhand o snd) THEN
          ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
          SIMP_TAC [FINITE_IMAGE, FINITE_DELETE, FINITE_NUMSEG] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] LE_TRANS) THEN
          W (MP_TAC o PART_MATCH (lhand o rand) CARD_IMAGE_LE o lhand o snd) THEN
          SIMP_TAC [FINITE_DELETE, FINITE_NUMSEG] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] LE_TRANS) THEN
          ASM_SIMP_TAC [CARD_DELETE, IN_NUMSEG, FINITE_NUMSEG] THEN
          REWRITE_TAC [CARD_NUMSEG_1, LE_REFL],
          DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
           (← q r"s PSUBSET UNIV ==> ?x. ~(x IN s)"))) THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN
          REWRITE_TAC [RANK_ROW] THEN DISCH_TAC THEN
          SUBGOAL_THEN
           (← q r"!A:real^N^N. rows A = row n A INSERT
                                  {row j A | j IN (1..dimindex (:N)) DELETE n}")
           (fun th => REWRITE_TAC [th])
          THENL
           [REWRITE_TAC [rows, IN_DELETE, IN_NUMSEG] THEN ASM SET_TAC [],
            ASM_SIMP_TAC [DIM_INSERT]] THEN
          COND_CASES_TAC THENL
           [FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
            FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
              (← q r"x IN span s ==> x = y /\ s = t ==> ~(y IN span t) ==> q"))) THEN
            ASM_SIMP_TAC [row, LAMBDA_BETA, LAMBDA_ETA],
            MATCH_MP_TAC (← ARITH_RULE (← q r"s = t ==> s < t + 1")) THEN
            AP_TERM_TAC THEN REWRITE_TAC [row]] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. x IN s ==> f x = g x) ==> {f x | x IN s} = {g x | x IN s}")) THEN
          ASM_SIMP_TAC [IN_DELETE, IN_NUMSEG, LAMBDA_BETA, CART_EQ]]])
    prove
     r"!A:real^N^N. cofactor A = mat 0 <=> rank(A) < dimindex(:N) - 1"
     (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [lemma1] THEN DISCH_TAC THEN
      MATCH_MP_TAC (← ARITH_RULE
       (← q r"r <= n /\ ~(r = n) /\ ~(r = n - 1) ==> r < n - 1")) THEN
      REPEAT CONJ_TAC THENL
       [MP_TAC (← ISPEC (← q r"A:real^N^N") RANK_BOUND) THEN ARITH_TAC,
        REWRITE_TAC [RANK_EQ_FULL_DET] THEN
        MP_TAC (← SYM (← ISPEC (← q r"A:real^N^N") MATRIX_MUL_LEFT_COFACTOR)) THEN
        ASM_REWRITE_TAC [MATRIX_CMUL_EQ_0, TRANSP_MAT, MATRIX_MUL_LZERO] THEN
        REWRITE_TAC [MAT_EQ, ARITH_EQ],
        DISCH_TAC] THEN
      MP_TAC (← ISPEC (← q r"A:real^N^N") lemma2) THEN
      ASM_REWRITE_TAC [DIMINDEX_GE_1, ← ARITH_RULE (← q r"n - 1 < n <=> 1 <= n")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (X_CHOOSE_THEN (← q r"x:real^N")
        STRIP_ASSUME_TAC)) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"n - 1 < k ==> k <= MIN n n ==> k = n"))) THEN
      REWRITE_TAC [RANK_BOUND, RANK_EQ_FULL_DET] THEN
      MP_TAC (← GEN (← q r"A:real^N^N") (← ISPECL [← q r"A:real^N^N", ← q r"n:num"]
        DET_COFACTOR_EXPANSION)) THEN
      ASM_SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      MATCH_MP_TAC SUM_EQ_0 THEN
      X_GEN_TAC (← q r"m:num") THEN SIMP_TAC [IN_NUMSEG, REAL_ENTIRE] THEN STRIP_TAC THEN
      DISJ2_TAC THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CART_EQ]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"n:num")) THEN ASM_REWRITE_TAC [CART_EQ] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"m:num")) THEN
      ASM_SIMP_TAC [MAT_COMPONENT, COND_ID] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EQ_TRANS) THEN
      ASM_SIMP_TAC [cofactor, LAMBDA_BETA] THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [CART_EQ, LAMBDA_BETA, row] THEN
      REPEAT STRIP_TAC THEN
      REPEAT (COND_CASES_TAC THEN ASM_SIMP_TAC [LAMBDA_BETA]) THEN
      ASM_MESON_TAC [])

  let RANK_COFACTOR_EQ_1 ← prove
   r"!A:real^N^N. rank(cofactor A) = 1 <=>
                dimindex(:N) = 1 \/ rank A = dimindex(:N) - 1"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"dimindex(:N) = 1") THENL
     [ASM_MESON_TAC [RANK_COFACTOR_EQ_FULL], ASM_REWRITE_TAC []] THEN
    EQ_TAC THENL
     [ASM_CASES_TAC (← q r"cofactor A:real^N^N = mat 0") THEN
      ASM_REWRITE_TAC [RANK_0, ARITH_EQ] THEN DISCH_TAC THEN
      MATCH_MP_TAC (← ARITH_RULE
       (← q r"~(r < n - 1) /\ ~(r = n) /\ r <= MIN n n ==> r = n - 1")) THEN
      ASM_REWRITE_TAC [RANK_BOUND, ← GSYM COFACTOR_EQ_0] THEN
      MP_TAC (← ISPEC (← q r"A:real^N^N") RANK_COFACTOR_EQ_FULL) THEN ASM_REWRITE_TAC [],
      DISCH_TAC THEN MATCH_MP_TAC (← ARITH_RULE
       (← q r"~(n = 0) /\ n <= 1 ==> n = 1")) THEN
      ASM_REWRITE_TAC [RANK_EQ_0, COFACTOR_EQ_0, LT_REFL] THEN
      MP_TAC (← ISPECL [← q r"A:real^N^N", ← q r"transp(cofactor A):real^N^N"]
        RANK_SYLVESTER) THEN
      ASM_REWRITE_TAC [MATRIX_MUL_RIGHT_COFACTOR, RANK_TRANSP] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"a = n - 1 ==> 1 <= n ==> a < n"))) THEN
      ASM_SIMP_TAC [← GSYM DET_EQ_0_RANK, DIMINDEX_GE_1] THEN
      DISCH_TAC THEN REWRITE_TAC [MATRIX_CMUL_LZERO, RANK_0] THEN
      ARITH_TAC])

  let RANK_COFACTOR ← prove
   r"!A:real^N^N.
        rank(cofactor A) = if rank(A) = dimindex(:N) then dimindex(:N)
                           else if rank(A) = dimindex(:N) - 1 then 1
                           else 0"
   (GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [RANK_COFACTOR_EQ_FULL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [RANK_COFACTOR_EQ_1] THEN
    REWRITE_TAC [RANK_EQ_0, COFACTOR_EQ_0] THEN
    MATCH_MP_TAC (← ARITH_RULE
     (← q r"r <= MIN n n /\ ~(r = n) /\ ~(r = n - 1) ==> r < n - 1")) THEN
    ASM_REWRITE_TAC [RANK_BOUND])

  return { COFACTOR_EQ_0, RANK_COFACTOR_EQ_1, RANK_COFACTOR }

/- ------------------------------------------------------------------------- -/
/- Eigenvalue and eigenvector identities.  (topology.ml 19669-19761)         -/
/- ------------------------------------------------------------------------- -/

structure EIG where
  SAME_EIGENVALUES_TRANSP : thm
  SAME_EIGENVALUES_SIMILAR : thm
  SAME_EIGENVALUES_MATRIX_MUL : thm
  SAME_EIGENVECTORS_MATRIX_INV : thm
  NORMAL_MATRIX_SAME_EIGENPAIRS_TRANSP : thm
  NORMAL_MATRIX_SAME_EIGENVECTORS_TRANSP : thm
  deriving Inhabited

@[nospecialize]
def setupEIG [HolBase] (D : TopologyDeps) (BSYL : SYL) : ExceptT String IO EIG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV, .. } := D
  let { EQ_TRANS, .. } := D.core1
  let { REAL_INV_0, REAL_INV_INV, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LNEG, REAL_MUL_RID, REAL_MUL_RINV,
        REAL_MUL_SYM, REAL_NEG_EQ_0, .. } := D.core5
  let { MATRIX_ADD_AC, MATRIX_ADD_SYM, MATRIX_CMUL_ADD_LDISTRIB, MATRIX_CMUL_ASSOC,
        MATRIX_CMUL_LID, MATRIX_CMUL_LZERO, MATRIX_INV, MATRIX_INV_INV, MATRIX_INV_MUL_INNER,
        MATRIX_MUL_LID, MATRIX_MUL_LMUL, MATRIX_MUL_RID, MATRIX_MUL_RMUL, MATRIX_NEG_MINUS1,
        MATRIX_SUB, MATRIX_SUB_LDISTRIB, MATRIX_SUB_RDISTRIB, MATRIX_SUB_RZERO,
        MATRIX_TRANSP_MUL, .. } := D.vec2
  let { MATRIX_VECTOR_LMUL, MATRIX_VECTOR_MUL_ASSOC, MATRIX_VECTOR_MUL_INV_EQ_0,
        MATRIX_VECTOR_MUL_LID, MATRIX_VECTOR_MUL_RMUL, MATRIX_VECTOR_MUL_SUB_RDISTRIB,
        NORMAL_MATRIX_KERNEL_TRANSP_EXPLICIT, SYMMETRIC_MATRIX_INV, SYMMETRIC_MATRIX_INV_RMUL,
        TRANSP_MAT, .. } := D.vec3
  let { TRANSP_MATRIX_CMUL, TRANSP_MATRIX_INV, TRANSP_MATRIX_SUB, VECTOR_MUL_ASSOC,
        VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_SUB_EQ, normal_matrix, symmetric_matrix, .. } :=
    D.vec4
  let { DET_CMUL, DET_MUL, DET_SIMILAR, DET_TRANSP, EIGENVALUES_CHARACTERISTIC_ALT, .. } := D.det
  let { SYLVESTER_DETERMINANT_IDENTITY, .. } := BSYL
  -- @@SCOPE END

  let SAME_EIGENVALUES_TRANSP ← prove
   r"!A:real^N^N c.
     (?v. ~(v = vec 0) /\ transp(A) ** v = c % v) <=>
     (?v. ~(v = vec 0) /\ A ** v = c % v)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EIGENVALUES_CHARACTERISTIC_ALT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM DET_TRANSP] THEN
    REWRITE_TAC [TRANSP_MATRIX_SUB, TRANSP_MATRIX_CMUL, TRANSP_MAT])

  let SAME_EIGENVALUES_SIMILAR ← prove
   r"!S:real^N^N A c.
        invertible S
        ==> ((?v. ~(v = vec 0) /\ (matrix_inv S ** A ** S) ** v = c % v) <=>
             (?v. ~(v = vec 0) /\ A ** v = c % v))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [EIGENVALUES_CHARACTERISTIC_ALT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN TRANS_TAC EQ_TRANS
     (← q r"det(matrix_inv S ** (A - c %% mat 1) ** (S:real^N^N))") THEN
    CONJ_TAC THENL [AP_TERM_TAC, ASM_SIMP_TAC [DET_SIMILAR]] THEN
    REWRITE_TAC [MATRIX_SUB_LDISTRIB, MATRIX_SUB_RDISTRIB] THEN
    REWRITE_TAC [MATRIX_MUL_LMUL, MATRIX_MUL_RMUL] THEN
    ASM_SIMP_TAC [MATRIX_INV, MATRIX_MUL_LID])

  let SAME_EIGENVALUES_MATRIX_MUL ← prove
   r"!A B:real^N^N c.
     (?v. ~(v = vec 0) /\ (A ** B) ** v = c % v) <=>
     (?v. ~(v = vec 0) /\ (B ** A) ** v = c % v)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EIGENVALUES_CHARACTERISTIC_ALT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_REWRITE_TAC [MATRIX_CMUL_LZERO, MATRIX_SUB_RZERO,
                     DET_MUL, REAL_MUL_SYM] THEN
    SUBGOAL_THEN (← q r"A:real^N^N = --c %% (inv(--c) %% A)") SUBST1_TAC THENL
     [ASM_SIMP_TAC [MATRIX_CMUL_ASSOC, MATRIX_CMUL_LID, REAL_MUL_RINV,
                    REAL_NEG_EQ_0],
      ONCE_REWRITE_TAC [MATRIX_MUL_LMUL, MATRIX_MUL_RMUL]] THEN
    REWRITE_TAC [MATRIX_SUB, MATRIX_NEG_MINUS1, MATRIX_CMUL_ASSOC] THEN
    REWRITE_TAC [REAL_MUL_LNEG, REAL_MUL_LID, ← GSYM MATRIX_CMUL_ADD_LDISTRIB] THEN
    REWRITE_TAC [DET_CMUL] THEN AP_TERM_TAC THEN
    ONCE_REWRITE_TAC [MATRIX_ADD_SYM] THEN
    REWRITE_TAC [SYLVESTER_DETERMINANT_IDENTITY])

  let SAME_EIGENVECTORS_MATRIX_INV ← prove
   r"!A:real^N^N c v.
        symmetric_matrix A
        ==> (matrix_inv A ** v = c % v <=> A ** v = inv(c) % v)"
   (SUBGOAL_THEN
     (← q r"!A:real^N^N c v.
        symmetric_matrix A ==> A ** v = c % v ==> matrix_inv A ** v = inv(c) % v")
    MP_TAC THENL
     [REWRITE_TAC [symmetric_matrix] THEN REPEAT STRIP_TAC,
      MESON_TAC [REAL_INV_INV, MATRIX_INV_INV, SYMMETRIC_MATRIX_INV]] THEN
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THENL
     [ASM_MESON_TAC [VECTOR_MUL_LZERO, REAL_INV_0, MATRIX_VECTOR_MUL_INV_EQ_0],
      ASM_REWRITE_TAC []] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE (LAND_CONV o LAND_CONV)
     [← GSYM MATRIX_INV_MUL_INNER]) THEN
    ASM_REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN
    REWRITE_TAC [MATRIX_VECTOR_MUL_ASSOC] THEN
    GEN_REWRITE_TAC (funpow 3 LAND_CONV)
     [← GSYM (← REWRITE_RULE [symmetric_matrix] SYMMETRIC_MATRIX_INV_RMUL)] THEN
    ASM_REWRITE_TAC [MATRIX_TRANSP_MUL, ← GSYM MATRIX_VECTOR_MUL_ASSOC,
                     TRANSP_MATRIX_INV, MATRIX_VECTOR_MUL_RMUL] THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"(%) (inv c * inv c):real^N->real^N")) THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, ← GSYM REAL_MUL_ASSOC, REAL_MUL_LINV,
                  ← REAL_FIELD (← q r"~(c = &0) ==> inv c * inv c * c * c = &1")] THEN
    REWRITE_TAC [VECTOR_MUL_LID, REAL_MUL_RID])

  let NORMAL_MATRIX_SAME_EIGENPAIRS_TRANSP ← prove
   r"!A:real^N^N.
        normal_matrix A
        ==> !c v. transp A ** v = c % v <=> A ** v = c % v"
   (REWRITE_TAC [normal_matrix] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
    ONCE_REWRITE_TAC [← MESON [MATRIX_VECTOR_LMUL, MATRIX_VECTOR_MUL_LID]
     (← q r"c % v = (c %% mat 1:real^N^N) ** v")] THEN
    REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_SUB_RDISTRIB] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM TRANSP_MAT] THEN
    REWRITE_TAC [← GSYM TRANSP_MATRIX_CMUL, ← GSYM TRANSP_MATRIX_SUB] THEN
    MATCH_MP_TAC NORMAL_MATRIX_KERNEL_TRANSP_EXPLICIT THEN
    REWRITE_TAC [normal_matrix] THEN
    REWRITE_TAC [TRANSP_MATRIX_SUB, TRANSP_MATRIX_CMUL, TRANSP_MAT] THEN
    REWRITE_TAC [MATRIX_SUB_LDISTRIB] THEN REWRITE_TAC [MATRIX_SUB_RDISTRIB] THEN
    ASM_REWRITE_TAC [MATRIX_MUL_LMUL, MATRIX_MUL_RMUL] THEN
    REWRITE_TAC [MATRIX_MUL_LID, MATRIX_MUL_RID] THEN
    REWRITE_TAC [MATRIX_NEG_MINUS1, MATRIX_SUB, MATRIX_CMUL_ADD_LDISTRIB] THEN
    REWRITE_TAC [MATRIX_CMUL_ASSOC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [MATRIX_ADD_AC])

  let NORMAL_MATRIX_SAME_EIGENVECTORS_TRANSP ← prove
   r"!A:real^N^N.
        normal_matrix A
        ==> !v. ((?c. transp A ** v = c % v) <=> (?c. A ** v = c % v))"
   (MESON_TAC [NORMAL_MATRIX_SAME_EIGENPAIRS_TRANSP])

  return { SAME_EIGENVALUES_TRANSP, SAME_EIGENVALUES_SIMILAR, SAME_EIGENVALUES_MATRIX_MUL,
           SAME_EIGENVECTORS_MATRIX_INV, NORMAL_MATRIX_SAME_EIGENPAIRS_TRANSP,
           NORMAL_MATRIX_SAME_EIGENVECTORS_TRANSP }

/- ------------------------------------------------------------------------- -/
/- Not in so many words, but combining this with intermediate value theorem  -/
/- implies the determinant is an open map.  (topology.ml 19762-19983)        -/
/- ------------------------------------------------------------------------- -/

structure DOM where
  DET_OPEN_MAP : thm
  deriving Inhabited

@[nospecialize]
def setupDOM [HolBase] (D : TopologyDeps) (BMID1 : MID1) : ExceptT String IO DOM := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        VECTOR_ARITH, NORM_ARITH, .. } := D
  let { ARITH_EQ, CARD_NUMSEG_1, CART_EQ, COND_ID, COND_RAND, COND_RATOR, CONJ_SYM, DELETE,
        DIMINDEX_GE_1, EQ_TRANS, FINITE_DELETE, FINITE_INDEX_INRANGE, FINITE_NUMSEG, .. } :=
    D.core1
  let { IMP_CONJ_ALT, IN_DELETE, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LAMBDA_ETA, LE_1, MONO_AND, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, NOT_LE,
        NUMSEG_EMPTY, REAL_ABS_ABS, REAL_ABS_DIV, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_POS,
        REAL_ADD_LID, .. } := D.core3
  let { REAL_ENTIRE, REAL_LET_TRANS, REAL_LE_LMUL, REAL_LE_REFL, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_LDIV_EQ, REAL_LT_MIN, REAL_LT_MUL_EQ, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_AC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RNEG, REAL_MUL_RZERO,
        REAL_NEG_0, REAL_NEG_ADD, REAL_NEG_EQ_0, REAL_NEG_GT0, REAL_NEG_NEG, REAL_OF_NUM_LT,
        REAL_SUB_0, REAL_SUB_LT, REAL_SUB_LZERO, REAL_SUB_REFL, SUM_0, SUM_ABS_NUMSEG, .. } :=
    D.core5
  let { SUM_ADD_NUMSEG, SUM_BOUND_LT_GEN, SUM_CASES, SUM_DELETE, SUM_EQ_0, SUM_NEG, SUM_POS_LT,
        SUM_SUB_NUMSEG, SWAP_EXISTS_THM, real_gt, .. } := D.core6
  let { BASIS_COMPONENT, COMPONENT_LE_NORM, .. } := D.vec1
  let { MATRIX_ADD_COMPONENT, MATRIX_CMUL_COMPONENT, MATRIX_CMUL_EQ_0, MATRIX_MUL_LZERO,
        MATRIX_SUB_COMPONENT, .. } := D.vec2
  let { MATRIX_VECTOR_MUL_RMUL, MATRIX_VECTOR_MUL_SUB_RDISTRIB, MAT_COMPONENT, MAT_EQ, SPAN_MUL,
        SPAN_SUPERSET, SPAN_VSUM, TRANSP_MAT, .. } := D.vec3
  let { TRANSP_MATRIX_SUB, VECTOR_MUL_COMPONENT, VECTOR_MUL_RZERO, VECTOR_SUB_COMPONENT,
        VEC_COMPONENT, VSUM_COMPONENT, matrix_vector_mul, row, transp, .. } := D.vec4
  let { DET_COFACTOR_EXPANSION, DET_ROW_MUL, DET_ROW_SPAN, DET_TRANSP, DET_ZERO_ROW,
        HOMOGENEOUS_LINEAR_EQUATIONS_DET, INVERTIBLE_DET_NZ, MATRIX_MUL_LEFT_COFACTOR,
        cofactor, .. } := D.det
  let { NEARBY_INVERTIBLE_MATRIX, .. } := BMID1
  -- @@SCOPE END

  let DET_OPEN_MAP ← do
    let lemma1 ← prove
     r"!A:real^N^N i e.
            1 <= i /\ i <= dimindex(:N) /\ row i A = vec 0 /\ &0 < e
            ==> (?B:real^N^N. (!i j. abs(B$i$j - A$i$j) < e) /\ det B < &0) /\
                (?C:real^N^N. (!i j. abs(C$i$j - A$i$j) < e) /\ det C > &0)"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"det(A:real^N^N) = &0") ASSUME_TAC THENL
       [ASM_MESON_TAC [DET_ZERO_ROW], ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"A:real^N^N") NEARBY_INVERTIBLE_MATRIX) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"min d e / &2")) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [INVERTIBLE_DET_NZ]] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o MATCH_MP (← REAL_ARITH
       (← q r"~(x = &0) ==> x < &0 \/ &0 < x")))
      THENL [ALL_TAC, ONCE_REWRITE_TAC [CONJ_SYM]] THEN
      (CONJ_TAC THENL
         [EXISTS_TAC (← q r"A + min d e / &2 %% mat 1:real^N^N"),
          EXISTS_TAC (← q r"(lambda j. if j = i then
                           --(&1) % row i (A + min d e / &2 %% mat 1:real^N^N)
                           else row j (A + min d e / &2 %% mat 1:real^N^N))
                      :real^N^N")]) THEN
      ASM_SIMP_TAC [DET_ROW_MUL, ← MESON []
       (← q r"(if j = i then f i else f j) = f j")] THEN
      REWRITE_TAC [row, LAMBDA_ETA] THEN
      ASM_REWRITE_TAC [real_gt, ← GSYM row] THEN
      TRY (CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC]) THEN
      (MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
       SUBGOAL_THEN (← q r"?k. 1 <= k /\ k <= dimindex(:N) /\ !A:real^N^N. A$m = A$k")
       CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
       SUBGOAL_THEN (← q r"?l. 1 <= l /\ l <= dimindex(:N) /\ !z:real^N. z$n = z$l")
       CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC]) THEN
      ASM_SIMP_TAC [LAMBDA_BETA] THEN
      TRY COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [MATRIX_ADD_COMPONENT, MATRIX_CMUL_COMPONENT, MAT_COMPONENT,
                    VECTOR_MUL_COMPONENT] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CART_EQ]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"l:num")) THEN
      ASM_SIMP_TAC [row, LAMBDA_BETA, VEC_COMPONENT] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)
    let lemma2 ← prove
     r"!A:real^N^N x:real^N i.
            1 <= i /\ i <= dimindex(:N) /\ x$i = &1
            ==> det(lambda k. if k = i then transp A ** x else row k A) = det A"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC
       (← q r"det(lambda k. if k = i
                      then row i (A:real^N^N) + (transp A ** x - row i A)
                      else row k A)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← VECTOR_ARITH (← q r"r + (x - r):real^N = x")], ALL_TAC] THEN
      MATCH_MP_TAC DET_ROW_SPAN THEN
      SUBGOAL_THEN
       (← q r"transp(A:real^N^N) ** x - row i A =
        vsum ((1..dimindex(:N)) DELETE i) (\k. x$k % row k A)")
      SUBST1_TAC THENL
       [SIMP_TAC [CART_EQ, VSUM_COMPONENT, VECTOR_SUB_COMPONENT, row, transp,
                  LAMBDA_BETA, matrix_vector_mul, VECTOR_MUL_COMPONENT] THEN
        ASM_SIMP_TAC [SUM_DELETE, IN_NUMSEG, FINITE_NUMSEG, REAL_MUL_LID] THEN
        REWRITE_TAC [REAL_MUL_AC],
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SPAN_VSUM THEN
        REWRITE_TAC [FINITE_DELETE, IN_DELETE, IN_NUMSEG, FINITE_NUMSEG] THEN
        X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN MATCH_MP_TAC SPAN_MUL THEN
        MATCH_MP_TAC SPAN_SUPERSET THEN ASM SET_TAC []])
    prove
     r"!A:real^N^N e.
          &0 < e
          ==> (?B:real^N^N. (!i j. abs(B$i$j - A$i$j) < e) /\ det B < det A) /\
              (?C:real^N^N. (!i j. abs(C$i$j - A$i$j) < e) /\ det C > det A)"
     (REPEAT GEN_TAC THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"cofactor(A:real^N^N) = mat 0") THENL
       [MP_TAC (← SYM (← ISPEC (← q r"A:real^N^N") MATRIX_MUL_LEFT_COFACTOR)) THEN
        ASM_REWRITE_TAC [MATRIX_CMUL_EQ_0, TRANSP_MAT, MATRIX_MUL_LZERO] THEN
        REWRITE_TAC [MAT_EQ, ARITH_EQ] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN
         (← q r"?c i. 1 <= i /\ i <= dimindex(:N) /\ c$i = &1 /\
                transp(A:real^N^N) ** c = vec 0")
        STRIP_ASSUME_TAC THENL
         [MP_TAC (← ISPEC (← q r"transp A:real^N^N") HOMOGENEOUS_LINEAR_EQUATIONS_DET) THEN
          ASM_REWRITE_TAC [DET_TRANSP] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N") STRIP_ASSUME_TAC) THEN
          ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CART_EQ]) THEN
          REWRITE_TAC [VEC_COMPONENT, NOT_IMP, NOT_FORALL_THM] THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
          EXISTS_TAC (← q r"inv(c$i) % c:real^N") THEN
          ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, REAL_MUL_LINV] THEN
          ASM_REWRITE_TAC [MATRIX_VECTOR_MUL_RMUL, VECTOR_MUL_RZERO],
          ALL_TAC] THEN
        MP_TAC (← ISPECL
        [← q r"(lambda k. if k = i then transp A ** c else row k (A:real^N^N)):real^N^N",
         ← q r"i:num", ← q r"min e (e / &(dimindex(:N)) /
                          (&1 + norm(&2 % basis i - c:real^N)))"] lemma1) THEN
        ASM_SIMP_TAC [REAL_LT_MIN, REAL_LT_DIV, REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1,
                      ← NORM_ARITH (← q r"&0 < &1 + norm(x:real^N)")] THEN
        ANTS_TAC THENL
         [ASM_SIMP_TAC [row, CART_EQ, VEC_COMPONENT, LAMBDA_BETA],
          ALL_TAC] THEN
        MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
        ABBREV_TAC (← q r"A':real^N^N =
                    lambda k. if k = i then vec 0 else row k (A:real^N^N)") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"B:real^N^N") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(lambda k. if k = i then transp(B:real^N^N) **
                                             (&2 % basis i - c)
                               else row k B):real^N^N") THEN
        ASM_SIMP_TAC [lemma2, BASIS_COMPONENT, VECTOR_MUL_COMPONENT,
                      VECTOR_SUB_COMPONENT, ← REAL_ARITH (← q r"&2 * x - x = x")] THEN
        (MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
         SUBGOAL_THEN (← q r"?k. 1 <= k /\ k <= dimindex(:N) /\ !A:real^N^N. A$m = A$k")
         CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
         SUBGOAL_THEN (← q r"?l. 1 <= l /\ l <= dimindex(:N) /\ !z:real^N. z$n = z$l")
         CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC]) THEN
        EXPAND_TAC "A'" THEN ASM_SIMP_TAC [LAMBDA_BETA] THEN
        (COND_CASES_TAC THENL
          [ALL_TAC,
           FIRST_X_ASSUM (MP_TAC o SPECL [← q r"k:num", ← q r"l:num"]) THEN
           EXPAND_TAC "A'" THEN ASM_SIMP_TAC [LAMBDA_BETA, row]] THEN
         SUBGOAL_THEN
          (← q r"(A:real^N^N)$k$l = (transp(A':real^N^N) ** (&2 % basis i - c:real^N))$l")
         SUBST1_TAC THENL
          [ASM_SIMP_TAC [matrix_vector_mul, transp, LAMBDA_BETA] THEN
           EXPAND_TAC "A'" THEN ASM_SIMP_TAC [LAMBDA_BETA] THEN
           REWRITE_TAC [COND_RAND, COND_RATOR] THEN
           SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT, BASIS_COMPONENT,
             VEC_COMPONENT, REAL_MUL_RZERO, REAL_SUB_LZERO, REAL_MUL_LZERO] THEN
           ASM_SIMP_TAC [SUM_CASES, FINITE_NUMSEG, SUM_0, REAL_ADD_LID] THEN
           ASM_SIMP_TAC [← GSYM DELETE, SUM_DELETE, IN_NUMSEG, FINITE_NUMSEG] THEN
           UNDISCH_TAC (← q r"transp(A:real^N^N) ** (c:real^N) = vec 0") THEN
           ASM_SIMP_TAC [CART_EQ, VEC_COMPONENT, matrix_vector_mul, LAMBDA_BETA,
                         row, transp] THEN
           DISCH_THEN (MP_TAC o SPEC (← q r"l:num")) THEN ASM_REWRITE_TAC [] THEN
           SIMP_TAC [REAL_MUL_RNEG, SUM_NEG] THEN REAL_ARITH_TAC,
           REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT, ← GSYM TRANSP_MATRIX_SUB,
                        ← GSYM MATRIX_VECTOR_MUL_SUB_RDISTRIB]] THEN
          ASM_SIMP_TAC [matrix_vector_mul, transp, LAMBDA_BETA] THEN
          W (MP_TAC o PART_MATCH lhand SUM_ABS_NUMSEG o lhand o snd) THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
          MATCH_MP_TAC SUM_BOUND_LT_GEN THEN
          ASM_SIMP_TAC [FINITE_NUMSEG, NUMSEG_EMPTY,
                        ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
          X_GEN_TAC (← q r"r:num") THEN REWRITE_TAC [CARD_NUMSEG_1, IN_NUMSEG] THEN
          STRIP_TAC THEN REWRITE_TAC [REAL_ABS_MUL] THEN
          TRANS_TAC REAL_LET_TRANS
           (← q r"abs((B - A':real^N^N)$r$l) * (&1 + norm(&2 % basis i - c:real^N))") THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
            MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> a <= &1 + b")) THEN
            ASM_SIMP_TAC [COMPONENT_LE_NORM],
            ASM_SIMP_TAC [MATRIX_SUB_COMPONENT, ← GSYM REAL_LT_RDIV_EQ,
                          ← NORM_ARITH (← q r"&0 < &1 + norm(x:real^N)")]]),
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CART_EQ]) THEN
        SIMP_TAC [CART_EQ, MAT_COMPONENT, COND_ID] THEN
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, real_gt] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"i:num") (CONJUNCTS_THEN2 STRIP_ASSUME_TAC
         (X_CHOOSE_THEN (← q r"j:num") STRIP_ASSUME_TAC))) THEN
        FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
         (← q r"~(x = &0) ==> &0 < x \/ x < &0")))
        THENL [ALL_TAC, ONCE_REWRITE_TAC [CONJ_SYM]] THEN
        (CONJ_TAC THENL
         [EXISTS_TAC (← q r"(lambda m n. if m = i /\ n = j
                                   then (A:real^N^N)$i$j -
                                        e / (&1 + abs(cofactor A$i$j))
                                   else A$m$n):real^N^N"),
          EXISTS_TAC (← q r"(lambda m n. if m = i /\ n = j
                                   then (A:real^N^N)$i$j +
                                        e / (&1 + abs(cofactor A$i$j))
                                   else A$m$n):real^N^N")]) THEN
         (CONJ_TAC THENL
           [MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
            SUBGOAL_THEN
              (← q r"?k. 1 <= k /\ k <= dimindex(:N) /\ !A:real^N^N. A$m = A$k")
            CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
            SUBGOAL_THEN (← q r"?l. 1 <= l /\ l <= dimindex(:N) /\ !z:real^N. z$n = z$l")
            CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
            ASM_SIMP_TAC [LAMBDA_BETA] THEN
            COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_ABS_NUM] THEN
            REWRITE_TAC [← REAL_ARITH (← q r"abs(a - e - a) = abs e"),
                         ← REAL_ARITH (← q r"abs((a + e) - a) = abs e")] THEN
            REWRITE_TAC [REAL_ABS_DIV, REAL_ABS_NUM, REAL_ABS_ABS] THEN
            ASM_SIMP_TAC [← REAL_ARITH (← q r"abs(&1 + abs x) = &1 + abs x"),
                          REAL_LT_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &1 + abs x")] THEN
            MATCH_MP_TAC (← REAL_ARITH
             (← q r"&0 < e /\ &0 < e * x ==> abs e < e * (&1 + x)")) THEN
            ASM_SIMP_TAC [REAL_LT_MUL_EQ] THEN ASM_REAL_ARITH_TAC,
            ALL_TAC]) THEN
        MP_TAC (← GEN (← q r"A:real^N^N") (← SPECL [← q r"A:real^N^N", ← q r"i:num"]
            DET_COFACTOR_EXPANSION)) THEN
        ASM_SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
        ONCE_REWRITE_TAC [← GSYM REAL_SUB_LT] THEN
        ASM_SIMP_TAC [← GSYM SUM_SUB_NUMSEG, LAMBDA_BETA] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"p - A$i$j * cofactor A$i$j =
                                --(A$i$j * cofactor A$i$j - p)")] THEN
        REWRITE_TAC [SUM_NEG, ← REAL_ARITH
         (← q r"a * b - c * d:real = b * (a - c) + c * (b - d)")] THEN
        REWRITE_TAC [SUM_ADD_NUMSEG, REAL_NEG_ADD] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"b = &0 /\ &0 < a ==> &0 < a + b")) THEN
        (CONJ_TAC THENL
          [REWRITE_TAC [REAL_NEG_EQ_0] THEN
           MATCH_MP_TAC SUM_EQ_0 THEN X_GEN_TAC (← q r"m:num") THEN
           REWRITE_TAC [IN_NUMSEG, REAL_ENTIRE] THEN STRIP_TAC THEN DISJ2_TAC THEN
           REWRITE_TAC [REAL_SUB_0] THEN REWRITE_TAC [cofactor] THEN
           ASM_SIMP_TAC [LAMBDA_BETA] THEN AP_TERM_TAC THEN
           ASM_SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN ASM_MESON_TAC [],
           ALL_TAC]) THEN
        REWRITE_TAC [← GSYM SUM_NEG, ← GSYM REAL_MUL_RNEG] THEN
        MATCH_MP_TAC SUM_POS_LT THEN REWRITE_TAC [FINITE_NUMSEG] THEN
        MATCH_MP_TAC (← MESON [REAL_LT_IMP_LE, REAL_LE_REFL]
         (← q r"(?i. P i /\ &0 < f i /\ (!j. P j /\ ~(j = i) ==> f j = &0))
          ==> (!j. P j ==> &0 <= f j) /\ (?j. P j /\ &0 < f j)")) THEN
        EXISTS_TAC (← q r"j:num") THEN ASM_REWRITE_TAC [FINITE_NUMSEG] THEN
        ASM_SIMP_TAC [REAL_SUB_REFL, REAL_MUL_RZERO, IN_NUMSEG, REAL_NEG_0] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"a - (a + e):real = --e"),
                     ← REAL_ARITH (← q r"a - (a - e):real = e"), REAL_NEG_NEG] THEN
        ASM_SIMP_TAC [REAL_LT_MUL_EQ] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&0 < a * --b <=> &0 < --a * b")] THEN
        ASM_SIMP_TAC [REAL_LT_MUL_EQ, REAL_NEG_GT0] THEN
        MATCH_MP_TAC REAL_LT_DIV THEN ASM_REAL_ARITH_TAC])

  return { DET_OPEN_MAP }

/- ------------------------------------------------------------------------- -/
/- Existence of eigenvectors. The proof is only in this file because it uses -/
/- a few simple results about continuous functions (at least                 -/
/- CONTINUOUS_ON_LIFT_DOT2, CONTINUOUS_ATTAINS_SUP and CLOSED_SUBSPACE).     -/
/- (topology.ml 19984-20202)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SAE where
  SELF_ADJOINT_HAS_EIGENVECTOR_IN_SUBSPACE : thm
  SELF_ADJOINT_HAS_EIGENVECTOR : thm
  SELF_ADJOINT_HAS_EIGENVECTOR_BASIS_OF_SUBSPACE : thm
  SELF_ADJOINT_HAS_EIGENVECTOR_BASIS : thm
  EIGENVALUE_LOWERBOUND_DOT : thm
  EIGENVALUE_LOWERBOUND_DOT_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupSAE [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCPP1 : CPP1) (BCPP2 : CPP2)
    (BIDC : IDC) (BLCP : LCP) (BDST : DST) (BCSB1 : CSB1) : ExceptT String IO SAE := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        REAL_RING, SET_RULE, SET_TAC, WF_INDUCT_TAC, REAL_RAT_REDUCE_CONV, NORM_ARITH, .. } := D
  let { ADD1, ARITH_EQ, CARD_CLAUSES, CONTRAPOS_THM, EMPTY_SUBSET, EQ_TRANS, EXISTS_IN_GSPEC,
        FINITE_INSERT, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_INSERT, FORALL_UNWIND_THM2, HAS_SIZE, HAS_SIZE_CLAUSES,
        IMP_CONJ, IMP_IMP, IN_ELIM_THM, IN_INTER, IN_SING, .. } := D.core2
  let { IN_UNIV, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, PAIRWISE_EMPTY,
        PAIRWISE_INSERT, REAL_ABS_INV, .. } := D.core3
  let { REAL_INV_POW, REAL_LE_DIV2_EQ, REAL_LE_LDIV_EQ, REAL_LE_LT, REAL_LE_REFL, REAL_LE_RMUL,
        REAL_LE_RMUL_EQ, REAL_LE_SQUARE, REAL_LT_POW_2, .. } := D.core4
  let { REAL_LT_SQUARE, REAL_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_RZERO, REAL_SUB_LE,
        RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM, SUBSET_UNIV, .. } :=
    D.core5
  let { SUM_LE, SUM_LMUL, o_DEF, real_div, .. } := D.core6
  let { ADJOINT_CLAUSES, ADJOINT_MATRIX, CARD_GE_DIM_INDEPENDENT, DIM_EQ_0, DIM_SING, DIM_SPAN,
        DIM_SUBSPACE_ORTHOGONAL_TO_VECTORS, DIM_UNIV, DOT_EQ_0, DOT_LMUL, DOT_LSUB,
        DOT_MATRIX_TRANSP_LMUL, DOT_POS_LT, DOT_RMUL, DOT_RSUB, DOT_RZERO, DOT_SYM, .. } := D.vec1
  let { INDEPENDENT_IMP_FINITE, LINEAR_CMUL, LINEAR_SUB, .. } := D.vec2
  let { MATRIX_VECTOR_MUL_LINEAR, NORM_0, NORM_EQ_0, NORM_MUL, NORM_POW_2, ORTHOGONAL_REFL,
        ORTHOGONAL_SYM, ORTHOGONAL_TO_SPAN_EQ, ORTHONORMAL_BASIS_EXPAND_DOT,
        PAIRWISE_ORTHOGONAL_INDEPENDENT, REAL_ABS_NORM, SPAN_SUBSET_SUBSPACE, SUBSPACE_0,
        SUBSPACE_INTER, SUBSPACE_MUL, SUBSPACE_ORTHOGONAL_TO_VECTOR, SUBSPACE_SPAN, SUBSPACE_SUB,
        SUBSPACE_UNIV, .. } := D.vec3
  let { VECTOR_SUB_EQ, VECTOR_SUB_RZERO, VEC_EQ, orthogonal, symmetric_matrix, .. } := D.vec4
  let { IN_SPHERE_0, .. } := BBAL
  let { CLOSED_INTER_COMPACT, .. } := BCPP1
  let { COMPACT_SPHERE, .. } := BCPP2
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { CONTINUOUS_ON_LIFT_DOT2, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CONTINUOUS_ATTAINS_SUP, .. } := BDST
  let { CLOSED_SUBSPACE, .. } := BCSB1
  -- @@SCOPE END

  let SELF_ADJOINT_HAS_EIGENVECTOR_IN_SUBSPACE ← do
    let lemma ← prove
     r"!a b. (!x. a * x <= b * x pow 2) ==> &0 <= b ==> a = &0"
     (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [REAL_LE_LT] THEN
      ASM_CASES_TAC (← q r"b = &0") THEN ASM_REWRITE_TAC [] THENL
       [FIRST_X_ASSUM (fun t => tactic_of do
          pure (MP_TAC (← SPEC (← q r"&1") t) THEN
                MP_TAC (← SPEC (← q r"-- &1") t))) THEN ASM_REAL_ARITH_TAC,
        DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a / &2 / b")) THEN
        ASM_SIMP_TAC [← REAL_FIELD
         (← q r"&0 < b ==> (b * (a / b) pow 2) = a pow 2 / b")] THEN
        REWRITE_TAC [real_div, REAL_MUL_ASSOC] THEN SIMP_TAC [← GSYM real_div] THEN
        ASM_SIMP_TAC [REAL_LE_DIV2_EQ] THEN
        REWRITE_TAC [REAL_LT_SQUARE, ← REAL_ARITH
          (← q r"(a * a) / &2 <= (a / &2) pow 2 <=> ~(&0 < a * a)")]])
    prove
     r"!f:real^N->real^N s.
          linear f /\ adjoint f = f /\
          subspace s /\ ~(s = {vec 0}) /\ (!x. x IN s ==> f x IN s)
          ==> ?v c. v IN s /\ norm(v) = &1 /\ f(v) = c % v"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"\x:real^N. (f x) dot x",
                        ← q r"s INTER sphere(vec 0:real^N,&1)"]
            CONTINUOUS_ATTAINS_SUP) THEN
      REWRITE_TAC [EXISTS_IN_GSPEC, FORALL_IN_GSPEC, o_DEF] THEN ANTS_TAC THENL
       [ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_DOT2, LINEAR_CONTINUOUS_ON,
                      CONTINUOUS_ON_ID] THEN
        ASM_SIMP_TAC [COMPACT_SPHERE, CLOSED_INTER_COMPACT, CLOSED_SUBSPACE] THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
          (← q r"~(s = {a}) ==> a IN s ==> ?b. ~(b = a) /\ b IN s"))) THEN
        ASM_SIMP_TAC [SUBSPACE_0, IN_SPHERE_0, ← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"inv(norm x) % x:real^N") THEN
        ASM_REWRITE_TAC [IN_ELIM_THM, VECTOR_SUB_RZERO, NORM_MUL] THEN
        ASM_SIMP_TAC [SUBSPACE_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
        ASM_SIMP_TAC [REAL_MUL_LINV, NORM_EQ_0],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N") THEN
        REWRITE_TAC [IN_INTER, IN_SPHERE_0] THEN STRIP_TAC THEN
        ABBREV_TAC (← q r"c = (f:real^N->real^N) v dot v") THEN
        EXISTS_TAC (← q r"c:real") THEN ASM_REWRITE_TAC []] THEN
      ABBREV_TAC (← q r"p = \x y:real^N. c * (x dot y) - (f x) dot y") THEN
      SUBGOAL_THEN (← q r"!x:real^N. x IN s ==> &0 <= p x x") (LABEL_TAC "POSDEF") THENL
       [X_GEN_TAC (← q r"x:real^N") THEN EXPAND_TAC "p" THEN REWRITE_TAC [] THEN
        ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN DISCH_TAC THEN
        ASM_REWRITE_TAC [DOT_RZERO, REAL_MUL_RZERO, REAL_SUB_LE, REAL_LE_REFL] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(norm x) % x:real^N")) THEN
        ASM_SIMP_TAC [SUBSPACE_MUL] THEN
        ASM_SIMP_TAC [LINEAR_CMUL, NORM_MUL, REAL_ABS_INV, DOT_RMUL] THEN
        ASM_SIMP_TAC [REAL_ABS_NORM, REAL_MUL_LINV, NORM_EQ_0, DOT_LMUL] THEN
        ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, DOT_POS_LT] THEN
        REWRITE_TAC [← GSYM NORM_POW_2, real_div, REAL_INV_POW] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!y:real^N. y IN s ==> !a. p v y * a <= p y y * a pow 2")
      MP_TAC THENL
       [REPEAT STRIP_TAC THEN
        REMOVE_THEN "POSDEF" (MP_TAC o SPEC (← q r"v - (&2 * a) % y:real^N")) THEN
        EXPAND_TAC "p" THEN ASM_SIMP_TAC [SUBSPACE_SUB, SUBSPACE_MUL] THEN
        ASM_SIMP_TAC [LINEAR_SUB, LINEAR_CMUL] THEN
        REWRITE_TAC [DOT_LSUB, DOT_LMUL] THEN
        REWRITE_TAC [DOT_RSUB, DOT_RMUL] THEN
        SUBGOAL_THEN (← q r"f y dot (v:real^N) = f v dot y") SUBST1_TAC THENL
         [ASM_MESON_TAC [ADJOINT_CLAUSES, DOT_SYM], ALL_TAC] THEN
        ASM_REWRITE_TAC [← GSYM NORM_POW_2] THEN REWRITE_TAC [NORM_POW_2] THEN
        MATCH_MP_TAC (← REAL_ARITH
            (← q r"&4 * (z - y) = x ==> &0 <= x ==> y <= z")) THEN
        REWRITE_TAC [DOT_SYM] THEN CONV_TAC (fun t => REAL_RING t),
        DISCH_THEN (MP_TAC o GEN (← q r"y:real^N") o DISCH (← q r"(y:real^N) IN s") o
          MATCH_MP lemma o C MP (← ASSUME (← q r"(y:real^N) IN s")) o
          SPEC (← q r"y:real^N")) THEN
        ASM_SIMP_TAC [] THEN EXPAND_TAC "p" THEN
        REWRITE_TAC [← GSYM DOT_LMUL, ← GSYM DOT_LSUB] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"c % v - f v:real^N")) THEN
        ASM_SIMP_TAC [SUBSPACE_MUL, SUBSPACE_SUB, DOT_EQ_0, VECTOR_SUB_EQ]])

  let SELF_ADJOINT_HAS_EIGENVECTOR ← prove
   r"!f:real^N->real^N.
        linear f /\ adjoint f = f ==> ?v c. norm(v) = &1 /\ f(v) = c % v"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"(:real^N)"]
          SELF_ADJOINT_HAS_EIGENVECTOR_IN_SUBSPACE) THEN
    ASM_REWRITE_TAC [SUBSPACE_UNIV, IN_UNIV] THEN DISCH_THEN MATCH_MP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!a. ~(a IN s) ==> ~(UNIV = s)")) THEN
    EXISTS_TAC (← q r"vec 1:real^N") THEN
    REWRITE_TAC [IN_SING, VEC_EQ, ARITH_EQ])

  let SELF_ADJOINT_HAS_EIGENVECTOR_BASIS_OF_SUBSPACE ← do
    let lemma ← prove
     r"!f:real^N->real^N s.
            linear f /\ adjoint f = f /\ subspace s /\ (!x. x IN s ==> f x IN s)
            ==> ?b. b SUBSET s /\ b HAS_SIZE dim s /\
                    pairwise orthogonal b /\
                    (!x. x IN b ==> norm x = &1 /\ ?c. f(x) = c % x)"
     (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN REWRITE_TAC [IMP_IMP] THEN
      GEN_TAC THEN STRIP_TAC THEN GEN_TAC THEN
      WF_INDUCT_TAC (← q r"dim(s:real^N->bool)") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"dim(s:real^N->bool) = 0") THENL
       [EXISTS_TAC (← q r"{}:real^N->bool") THEN
        ASM_SIMP_TAC [HAS_SIZE_CLAUSES, NOT_IN_EMPTY,
                      PAIRWISE_EMPTY, EMPTY_SUBSET],
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [DIM_EQ_0]) THEN
      DISCH_THEN (ASSUME_TAC o MATCH_MP (← SET_RULE
       (← q r"~(s SUBSET {a}) ==> ~(s = {a})"))) THEN
      MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"s:real^N->bool"]
        SELF_ADJOINT_HAS_EIGENVECTOR_IN_SUBSPACE) THEN
      ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N") MP_TAC) THEN
      ASM_CASES_TAC (← q r"v:real^N = vec 0") THEN ASM_REWRITE_TAC [NORM_0] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{y:real^N | y IN s /\ orthogonal v y}")) THEN
      REWRITE_TAC [SUBSPACE_ORTHOGONAL_TO_VECTOR, IN_ELIM_THM] THEN
      MP_TAC (← ISPECL [← q r"span {v:real^N}", ← q r"s:real^N->bool"]
            DIM_SUBSPACE_ORTHOGONAL_TO_VECTORS) THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [ORTHOGONAL_SYM] ORTHOGONAL_TO_SPAN_EQ] THEN
      ASM_REWRITE_TAC [SUBSPACE_SPAN, IN_SING, FORALL_UNWIND_THM2] THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC SPAN_SUBSET_SUBSPACE THEN ASM SET_TAC [],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      ASM_REWRITE_TAC [DIM_SPAN, DIM_SING, ← ARITH_RULE (← q r"n < n + 1")] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
        ASM_SIMP_TAC [SUBSPACE_INTER, SUBSPACE_ORTHOGONAL_TO_VECTOR] THEN
        REWRITE_TAC [orthogonal] THEN X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
        MATCH_MP_TAC EQ_TRANS THEN
        EXISTS_TAC (← q r"(f:real^N->real^N) v dot x") THEN CONJ_TAC THENL
         [ASM_MESON_TAC [ADJOINT_CLAUSES],
          ASM_MESON_TAC [DOT_LMUL, REAL_MUL_RZERO]],
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(v:real^N) INSERT b") THEN
        ASM_REWRITE_TAC [FORALL_IN_INSERT] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        ASM_REWRITE_TAC [PAIRWISE_INSERT] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE, SUBSET, IN_ELIM_THM]) THEN
        CONJ_TAC THENL
         [ASM_SIMP_TAC [HAS_SIZE, FINITE_INSERT, CARD_CLAUSES] THEN
          COND_CASES_TAC THEN ASM_REWRITE_TAC [ADD1] THEN
          ASM_MESON_TAC [ORTHOGONAL_REFL],
          RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, IN_ELIM_THM]) THEN
          ASM_MESON_TAC [ORTHOGONAL_SYM]]])
    prove
     r"!f:real^N->real^N s.
          linear f /\ adjoint f = f /\
          subspace s /\ (!x. x IN s ==> f x IN s)
          ==> ?b. b SUBSET s /\
                  pairwise orthogonal b /\
                  (!x. x IN b ==> norm x = &1 /\ ?c. f(x) = c % x) /\
                  independent b /\
                  span b = s /\
                  b HAS_SIZE dim s"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"s:real^N->bool"] lemma) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"b:real^N->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [MATCH_MP_TAC PAIRWISE_ORTHOGONAL_INDEPENDENT THEN
        ASM_MESON_TAC [← NORM_ARITH (← q r"~(norm(vec 0:real^N) = &1)")],
        DISCH_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
         [ASM_MESON_TAC [SPAN_SUBSET_SUBSPACE],
          MATCH_MP_TAC CARD_GE_DIM_INDEPENDENT THEN
          RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
          ASM_REWRITE_TAC [LE_REFL]]])

  let SELF_ADJOINT_HAS_EIGENVECTOR_BASIS ← prove
   r"!f:real^N->real^N.
        linear f /\ adjoint f = f
        ==> ?b. pairwise orthogonal b /\
                (!x. x IN b ==> norm x = &1 /\ ?c. f(x) = c % x) /\
                independent b /\
                span b = (:real^N) /\
                b HAS_SIZE (dimindex(:N))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"(:real^N)"]
          SELF_ADJOINT_HAS_EIGENVECTOR_BASIS_OF_SUBSPACE) THEN
    ASM_REWRITE_TAC [SUBSPACE_UNIV, IN_UNIV, DIM_UNIV, SUBSET_UNIV])

  let EIGENVALUE_LOWERBOUND_DOT ← prove
   r"!A:real^N^N a.
        symmetric_matrix A /\
        (!c v. A ** v = c % v /\ ~(v = vec 0) ==> a <= c)
        ==> !x. a * norm(x) pow 2 <= x dot (A ** x)"
   (REWRITE_TAC [symmetric_matrix] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"\x:real^N. (A:real^N^N) ** x")
      SELF_ADJOINT_HAS_EIGENVECTOR_BASIS) THEN
    ASM_REWRITE_TAC [ADJOINT_MATRIX, MATRIX_VECTOR_MUL_LINEAR] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"b:real^N->bool") ORTHONORMAL_BASIS_EXPAND_DOT) THEN
    ASM_SIMP_TAC [NORM_POW_2, IN_UNIV] THEN
    DISCH_THEN (fun th => tactic_of do pure (ONCE_REWRITE_TAC [← GSYM th])) THEN
    REWRITE_TAC [← GSYM SUM_LMUL] THEN MATCH_MP_TAC SUM_LE THEN
    ASM_SIMP_TAC [INDEPENDENT_IMP_FINITE] THEN X_GEN_TAC (← q r"v:real^N") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^N")) THEN
    ONCE_REWRITE_TAC [← GSYM DOT_MATRIX_TRANSP_LMUL] THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_TAC (← q r"c:real"))) THEN
    ASM_REWRITE_TAC [DOT_LMUL, ← REAL_ARITH (← q r"x * c * x:real = c * x * x")] THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [REAL_LE_SQUARE] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"v:real^N") THEN
    ASM_REWRITE_TAC [] THEN UNDISCH_TAC (← q r"norm(v:real^N) = &1") THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN SIMP_TAC [NORM_0] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let EIGENVALUE_LOWERBOUND_DOT_EQ ← prove
   r"!A:real^N^N a.
        symmetric_matrix A
        ==> ((!c v. A ** v = c % v /\ ~(v = vec 0) ==> a <= c) <=>
             (!x. a * norm(x) pow 2 <= x dot (A ** x)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [MATCH_MP_TAC EIGENVALUE_LOWERBOUND_DOT THEN ASM_MESON_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^N"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [DOT_RMUL, ← GSYM NORM_POW_2] THEN
      ASM_SIMP_TAC [REAL_LE_RMUL_EQ, REAL_LT_POW_2, NORM_EQ_0]])

  return { SELF_ADJOINT_HAS_EIGENVECTOR_IN_SUBSPACE, SELF_ADJOINT_HAS_EIGENVECTOR,
           SELF_ADJOINT_HAS_EIGENVECTOR_BASIS_OF_SUBSPACE, SELF_ADJOINT_HAS_EIGENVECTOR_BASIS,
           EIGENVALUE_LOWERBOUND_DOT, EIGENVALUE_LOWERBOUND_DOT_EQ }

/- ------------------------------------------------------------------------- -/
/- Diagonalization of symmetric matrix.  (topology.ml 20199-20297)           -/
/- ------------------------------------------------------------------------- -/

structure DIG where
  SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT : thm
  SYMMETRIC_MATRIX_IMP_DIAGONALIZABLE : thm
  SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE : thm
  SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupDIG [HolBase] (D : TopologyDeps) (BSAE : SAE) : ExceptT String IO DIG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, .. } := D
  let { CART_EQ, COND_RAND, CONJ_ASSOC, FINITE_INDEX_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, HAS_SIZE, IMP_CONJ_ALT, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LAMBDA_ETA, MONO_EXISTS, PAIRWISE_IMAGE, .. } := D.core3
  let { REAL_MUL_RZERO, REAL_MUL_SYM, RIGHT_EXISTS_AND_THM, SKOLEM_THM, .. } := D.core5
  let { SUM_DELTA, pairwise, .. } := D.core6
  let { COLUMN_TRANSP, .. } := D.vec1
  let { MATRIX_MUL_ASSOC, MATRIX_MUL_LID, MATRIX_MUL_RID, MATRIX_OF_MATRIX_VECTOR_MUL,
        MATRIX_SELF_ADJOINT, MATRIX_TRANSP_MUL, .. } := D.vec2
  let { MATRIX_VECTOR_MUL_LINEAR, .. } := D.vec3
  let { TRANSP_TRANSP, VECTOR_MUL_COMPONENT, column, matrix_mul, matrix_vector_mul, row,
        symmetric_matrix, .. } := D.vec4
  let { ORTHOGONAL_MATRIX_ORTHONORMAL_ROWS_INDEXED, ORTHOGONAL_MATRIX_TRANSP,
        TRANSP_DIAGONAL_MATRIX, diagonal_matrix, orthogonal_matrix, .. } := D.det
  let { SELF_ADJOINT_HAS_EIGENVECTOR_BASIS, .. } := BSAE
  -- @@SCOPE END

  let SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT ← do
    let lemma1 ← prove
     r"!A:real^N^N P:real^N^N d.
         A ** P = P ** (lambda i j. if i = j then d i else &0) <=>
         !i. 1 <= i /\ i <= dimindex(:N)
             ==> A ** column i P = d i % column i P"
     (SIMP_TAC [CART_EQ, matrix_mul, matrix_vector_mul, LAMBDA_BETA,
                column, VECTOR_MUL_COMPONENT] THEN
      REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [COND_RAND] THEN
      SIMP_TAC [REAL_MUL_RZERO, SUM_DELTA, IN_NUMSEG] THEN
      EQ_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [] THEN
      REWRITE_TAC [REAL_MUL_SYM])
    let lemma2 ← prove
     r"!A:real^N^N P:real^N^N d.
            orthogonal_matrix P /\
            transp P ** A ** P = (lambda i j. if i = j then d i else &0) <=>
            orthogonal_matrix P /\
            !i. 1 <= i /\ i <= dimindex(:N)
                ==> A ** column i P = d i % column i P"
     (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM lemma1, orthogonal_matrix] THEN
      ABBREV_TAC (← q r"D:real^N^N = lambda i j. if i = j then d i else &0") THEN
      MESON_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_LID])
    prove
     r"!A:real^N^N.
        symmetric_matrix A
        ==> ?P d. orthogonal_matrix P /\
                  transp P ** A ** P = (lambda i j. if i = j then d i else &0)"
     (REWRITE_TAC [symmetric_matrix] THEN REPEAT STRIP_TAC THEN
      REWRITE_TAC [lemma2] THEN REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
      REWRITE_TAC [← GSYM SKOLEM_THM] THEN
      MP_TAC (← ISPEC (← q r"\x:real^N. (A:real^N^N) ** x")
        SELF_ADJOINT_HAS_EIGENVECTOR_BASIS) THEN
      ASM_SIMP_TAC [MATRIX_SELF_ADJOINT, symmetric_matrix, MATRIX_VECTOR_MUL_LINEAR,
                    MATRIX_OF_MATRIX_VECTOR_MUL] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N->bool") MP_TAC) THEN
      REWRITE_TAC [CONJ_ASSOC] THEN ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN
      REWRITE_TAC [HAS_SIZE] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FINITE_INDEX_NUMSEG]) THEN
      ASM_REWRITE_TAC [IN_NUMSEG, ← TAUT
       (← q r"p /\ q /\ x = y ==> a = b <=> p /\ q /\ ~(a = b) ==> ~(x = y)")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [PAIRWISE_IMAGE, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [pairwise, IN_NUMSEG] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"transp(lambda i. f i):real^N^N") THEN
      SIMP_TAC [COLUMN_TRANSP, ORTHOGONAL_MATRIX_TRANSP] THEN
      SIMP_TAC [ORTHOGONAL_MATRIX_ORTHONORMAL_ROWS_INDEXED, row] THEN
      SIMP_TAC [LAMBDA_ETA, LAMBDA_BETA, pairwise, IN_NUMSEG] THEN
      ASM_MESON_TAC [])

  let SYMMETRIC_MATRIX_IMP_DIAGONALIZABLE ← prove
   r"!A:real^N^N.
     symmetric_matrix A
     ==> ?P. orthogonal_matrix P /\ diagonal_matrix(transp P ** A ** P)"
   (GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT) THEN
    MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [diagonal_matrix, LAMBDA_BETA])

  let SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE ← prove
   r"!A:real^N^N.
     symmetric_matrix A <=>
     ?P. orthogonal_matrix P /\ diagonal_matrix(transp P ** A ** P)"
   (GEN_TAC THEN EQ_TAC THEN
    REWRITE_TAC [SYMMETRIC_MATRIX_IMP_DIAGONALIZABLE] THEN
    REWRITE_TAC [symmetric_matrix, orthogonal_matrix] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"P:real^N^N") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"D:real^N^N = transp P ** (A:real^N^N) ** P") THEN
    SUBGOAL_THEN (← q r"A:real^N^N = P ** (D:real^N^N) ** transp P") SUBST1_TAC THENL
     [EXPAND_TAC "D" THEN REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
      ASM_REWRITE_TAC [MATRIX_MUL_LID] THEN
      ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_RID],
      REWRITE_TAC [MATRIX_TRANSP_MUL, TRANSP_TRANSP, MATRIX_MUL_ASSOC] THEN
      ASM_MESON_TAC [TRANSP_DIAGONAL_MATRIX]])

  let SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT ← prove
   r"!A:real^N^N.
        symmetric_matrix A <=>
        ?P D. orthogonal_matrix P /\ diagonal_matrix D /\
              A = transp P ** D ** P"
   (GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    MATCH_MP_TAC (← MESON [TRANSP_TRANSP, ORTHOGONAL_MATRIX_TRANSP]
     (← q r"(!P. orthogonal_matrix P ==> (A(transp P) <=> B P))
      ==> ((?P. orthogonal_matrix P /\ A P) <=>
           (?P. orthogonal_matrix P /\ B P))")) THEN
    X_GEN_TAC (← q r"P:real^N^N") THEN DISCH_TAC THEN
    REWRITE_TAC [TRANSP_TRANSP] THEN EQ_TAC THENL
     [DISCH_TAC THEN EXISTS_TAC (← q r"(P:real^N^N) ** (A:real^N^N) ** transp P"),
      STRIP_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
    ASM_REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
    ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
    ASM_REWRITE_TAC [MATRIX_MUL_LID, MATRIX_MUL_RID])

  return { SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT, SYMMETRIC_MATRIX_IMP_DIAGONALIZABLE,
           SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE, SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT }

/- ------------------------------------------------------------------------- -/
/- Hence deduce more general results using diagonalization.                  -/
/- (topology.ml 20298-20409)                                                 -/
/- ------------------------------------------------------------------------- -/

structure GDR1 where
  TRACE_MATRIX_INV_LMUL : thm
  TRACE_MATRIX_INV_RMUL : thm
  IDEMPOTENT_MATRIX_TRACE_EQ_RANK : thm
  POSITIVE_SEMIDEFINITE_EIGENVALUES : thm
  POSITIVE_DEFINITE_EIGENVALUES : thm
  deriving Inhabited

@[nospecialize]
def setupGDR1 [HolBase] (D : TopologyDeps) (BDIG : DIG) : ExceptT String IO GDR1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, REAL_RING, .. } := D
  let { CART_EQ, COND_RAND, FINITE_NUMSEG, .. } := D.core1
  let { FINITE_RESTRICT, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { REAL_LE_MUL_EQ, REAL_LT_MUL_EQ, .. } := D.core4
  let { REAL_MUL_RID, REAL_MUL_RZERO, .. } := D.core5
  let { SUM_CONST, SUM_DELTA, SUM_EQ_NUMSEG, SUM_RESTRICT_SET, .. } := D.core6
  let { BASIS_NONZERO, DOT_POS_LT, DOT_RMUL, .. } := D.vec1
  let { INVERTIBLE_MATRIX_INV, MATRIX_INV, MATRIX_INV_MUL_INNER, MATRIX_MUL_ASSOC,
        MATRIX_MUL_LCANCEL, MATRIX_MUL_RCANCEL, MATRIX_MUL_RID, MATRIX_TRANSP_MUL, .. } := D.vec2
  let { MATRIX_VECTOR_MUL_ASSOC, MATRIX_VECTOR_MUL_LID, MATRIX_VECTOR_MUL_RMUL,
        MATRIX_VECTOR_MUL_RZERO, RANK_MATRIX_INV_LMUL, RANK_SIMILAR, RANK_TRANSP,
        SYMMETRIC_MATRIX_INV_LMUL, .. } := D.vec3
  let { TRANSP_MATRIX_INV, basis, matrix_vector_mul, vector_mul, .. } := D.vec4
  let { DIAGONAL_MATRIX, MATRIX_MUL_DIAGONAL, ORTHOGONAL_MATRIX_IMP_INVERTIBLE,
        ORTHOGONAL_MATRIX_INV, POSITIVE_DEFINITE_DIAGONAL_MATRIX, POSITIVE_DEFINITE_SIMILAR,
        POSITIVE_SEMIDEFINITE_DIAGONAL_MATRIX, POSITIVE_SEMIDEFINITE_SIMILAR,
        RANK_DIAGONAL_MATRIX, TRACE_MUL_CYCLIC, TRACE_SIMILAR, TRACE_TRANSP, orthogonal_matrix,
        positive_definite, positive_semidefinite, trace, .. } := D.det
  let { SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, .. } := BDIG
  -- @@SCOPE END

  let TRACE_MATRIX_INV_LMUL ← prove
   r"!A:real^N^M. trace(matrix_inv A ** A) = &(rank A)"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM RANK_MATRIX_INV_LMUL] THEN
    SUBGOAL_THEN
     (← q r"(matrix_inv(A:real^N^M) ** A) ** (matrix_inv A ** A) = matrix_inv A ** A")
    MP_TAC THENL
     [REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_INV_MUL_INNER],
      MP_TAC (← ISPEC (← q r"A:real^N^M") SYMMETRIC_MATRIX_INV_LMUL)] THEN
    SPEC_TAC (← q r"matrix_inv(A:real^N^M) ** A", ← q r"A:real^N^N") THEN GEN_TAC THEN
    REWRITE_TAC [SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"P:real^N^N", ← q r"D:real^N^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM SUBST1_TAC THEN
    ASM_SIMP_TAC [ORTHOGONAL_MATRIX_IMP_INVERTIBLE, RANK_SIMILAR,
      ← GSYM ORTHOGONAL_MATRIX_INV, TRACE_SIMILAR, INVERTIBLE_MATRIX_INV,
      ← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_LCANCEL] THEN
    ASM_SIMP_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_RCANCEL,
                  ORTHOGONAL_MATRIX_IMP_INVERTIBLE] THEN
    GEN_REWRITE_TAC (funpow 3 LAND_CONV) [← GSYM MATRIX_MUL_ASSOC] THEN
    ASM_SIMP_TAC [MATRIX_INV, ORTHOGONAL_MATRIX_IMP_INVERTIBLE] THEN
    REWRITE_TAC [MATRIX_MUL_RID] THEN
    ASM_SIMP_TAC [MATRIX_MUL_DIAGONAL, RANK_DIAGONAL_MATRIX, trace] THEN
    SIMP_TAC [CART_EQ, LAMBDA_BETA, ← REAL_RING
     (← q r"x * x = x <=> x = &0 \/ x = &1")] THEN
    DISCH_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
    SIMP_TAC [← GSYM SUM_CONST, FINITE_NUMSEG, FINITE_RESTRICT] THEN
    REWRITE_TAC [SUM_RESTRICT_SET] THEN MATCH_MP_TAC SUM_EQ_NUMSEG THEN
    ASM_MESON_TAC [])

  let TRACE_MATRIX_INV_RMUL ← prove
   r"!A:real^N^M. trace(A ** matrix_inv A) = &(rank A)"
   (ONCE_REWRITE_TAC [← GSYM TRACE_TRANSP] THEN
    REWRITE_TAC [MATRIX_TRANSP_MUL, TRANSP_MATRIX_INV] THEN
    REWRITE_TAC [TRACE_MATRIX_INV_LMUL, RANK_TRANSP])

  let IDEMPOTENT_MATRIX_TRACE_EQ_RANK ← prove
   r"!A:real^N^N. A ** A = A ==> trace A = &(rank A)"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM MATRIX_INV_MUL_INNER] THEN
    ONCE_REWRITE_TAC [TRACE_MUL_CYCLIC] THEN
    ASM_REWRITE_TAC [TRACE_MATRIX_INV_LMUL])

  let POSITIVE_SEMIDEFINITE_EIGENVALUES ← prove
   r"!A:real^N^N. positive_semidefinite A <=>
                symmetric_matrix A /\
                !c v. A ** v = c % v /\ ~(v = vec 0) ==> &0 <= c"
   (GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [positive_semidefinite],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^N") o CONJUNCT2 o
        REWRITE_RULE [positive_semidefinite]) THEN
      ASM_SIMP_TAC [DOT_RMUL, REAL_LE_MUL_EQ, DOT_POS_LT],
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"P:real^N^N", ← q r"D:real^N^N"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN SUBST_ALL_TAC THEN
      MATCH_MP_TAC POSITIVE_SEMIDEFINITE_SIMILAR THEN
      MATCH_MP_TAC POSITIVE_SEMIDEFINITE_DIAGONAL_MATRIX THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      EXISTS_TAC (← q r"transp(P:real^N^N) ** basis i") THEN CONJ_TAC THENL
       [ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_VECTOR_MUL_ASSOC] THEN
        REWRITE_TAC [MATRIX_MUL_RID, ← GSYM MATRIX_VECTOR_MUL_RMUL] THEN
        REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN AP_TERM_TAC THEN
        FIRST_X_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE id [DIAGONAL_MATRIX]) THEN
        ASM_SIMP_TAC [LAMBDA_BETA, vector_mul, matrix_vector_mul, basis,
                      CART_EQ] THEN
        ONCE_REWRITE_TAC [COND_RAND] THEN
        ASM_SIMP_TAC [SUM_DELTA, REAL_MUL_RZERO, IN_NUMSEG, REAL_MUL_RID],
        DISCH_THEN (MP_TAC o AP_TERM (← q r"(**) P :real^N->real^N")) THEN
        ASM_REWRITE_TAC [MATRIX_VECTOR_MUL_ASSOC, MATRIX_VECTOR_MUL_LID] THEN
        ASM_SIMP_TAC [MATRIX_VECTOR_MUL_RZERO, BASIS_NONZERO]]])

  let POSITIVE_DEFINITE_EIGENVALUES ← prove
   r"!A:real^N^N. positive_definite A <=>
                symmetric_matrix A /\
                !c v. A ** v = c % v /\ ~(v = vec 0) ==> &0 < c"
   (GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [positive_definite],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^N") o CONJUNCT2 o
        REWRITE_RULE [positive_definite]) THEN
      ASM_SIMP_TAC [DOT_RMUL, REAL_LT_MUL_EQ, DOT_POS_LT],
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"P:real^N^N", ← q r"D:real^N^N"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN SUBST_ALL_TAC THEN
      MATCH_MP_TAC POSITIVE_DEFINITE_SIMILAR THEN
      ASM_SIMP_TAC [ORTHOGONAL_MATRIX_IMP_INVERTIBLE] THEN
      MATCH_MP_TAC POSITIVE_DEFINITE_DIAGONAL_MATRIX THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      EXISTS_TAC (← q r"transp(P:real^N^N) ** basis i") THEN CONJ_TAC THENL
       [ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_VECTOR_MUL_ASSOC] THEN
        REWRITE_TAC [MATRIX_MUL_RID, ← GSYM MATRIX_VECTOR_MUL_RMUL] THEN
        REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN AP_TERM_TAC THEN
        FIRST_X_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE id [DIAGONAL_MATRIX]) THEN
        ASM_SIMP_TAC [LAMBDA_BETA, vector_mul, matrix_vector_mul, basis,
                      CART_EQ] THEN
        ONCE_REWRITE_TAC [COND_RAND] THEN
        ASM_SIMP_TAC [SUM_DELTA, REAL_MUL_RZERO, IN_NUMSEG, REAL_MUL_RID],
        DISCH_THEN (MP_TAC o AP_TERM (← q r"(**) P :real^N->real^N")) THEN
        ASM_REWRITE_TAC [MATRIX_VECTOR_MUL_ASSOC, MATRIX_VECTOR_MUL_LID] THEN
        ASM_SIMP_TAC [MATRIX_VECTOR_MUL_RZERO, BASIS_NONZERO]]])

  return { TRACE_MATRIX_INV_LMUL, TRACE_MATRIX_INV_RMUL, IDEMPOTENT_MATRIX_TRACE_EQ_RANK,
           POSITIVE_SEMIDEFINITE_EIGENVALUES, POSITIVE_DEFINITE_EIGENVALUES }

/- ------------------------------------------------------------------------- -/
/- Positive semidefinite covariance.  (topology.ml 20410-20505)              -/
/- ------------------------------------------------------------------------- -/

structure PSC where
  POSITIVE_SEMIDEFINITE_COVARIANCE_EQ : thm
  POSITIVE_SEMIDEFINITE_COVARIANCE_EQ_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupPSC [HolBase] (D : TopologyDeps) (BDIG : DIG) : ExceptT String IO PSC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, .. } := D
  let { AND_FORALL_THM, CART_EQ, COND_RAND, CONJ_ASSOC, .. } := D.core1
  let { IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { REAL_EQ_IMP_LE, REAL_LE_MUL, REAL_LE_REFL, REAL_LE_SQUARE, .. } := D.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_POW_2, SQRT_0, SQRT_POS_LE, SQRT_POW_2, .. } :=
    D.core5
  let { SUM_DELTA, SUM_LMUL, SUM_POS_LE_NUMSEG, .. } := D.core6
  let { DOT_BASIS, DOT_LMUL_MATRIX, DOT_POS_LE, .. } := D.vec1
  let { MATRIX_MUL_ASSOC, MATRIX_MUL_RID, MATRIX_TRANSP_MUL, .. } := D.vec2
  let { MATRIX_VECTOR_MUL_ASSOC, MATRIX_VECTOR_MUL_BASIS, MATRIX_VECTOR_MUL_LID,
        MATRIX_VECTOR_MUL_TRANSP, .. } := D.vec3
  let { TRANSP_TRANSP, column, dot, matrix_vector_mul, symmetric_matrix, transp, .. } := D.vec4
  let { DIAGONAL_MATRIX, MATRIX_MUL_LTRANSP_DOT_COLUMN, diagonal_matrix, orthogonal_matrix,
        positive_semidefinite, .. } := D.det
  let { SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, .. } := BDIG
  -- @@SCOPE END

  let (POSITIVE_SEMIDEFINITE_COVARIANCE_EQ, POSITIVE_SEMIDEFINITE_COVARIANCE_EQ_ALT) ←
    CONJ_PAIR (← prove
   r"(!A:real^N^N. positive_semidefinite A <=>
                 ?S:real^N^N. A = transp S ** S) /\
   (!A:real^N^N. positive_semidefinite A <=>
                 ?S:real^N^N. positive_semidefinite S /\ A = transp S ** S)"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(r ==> q) /\ (q ==> p) /\ (p ==> r)
      ==> (p <=> q) /\ (p <=> r)")) THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN CONJ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"S:real^N^N") SUBST1_TAC) THEN
      REWRITE_TAC [positive_semidefinite, symmetric_matrix,
                   MATRIX_TRANSP_MUL, TRANSP_TRANSP] THEN
      REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN
      ONCE_REWRITE_TAC [← GSYM DOT_LMUL_MATRIX] THEN
      REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_TRANSP, DOT_POS_LE],
      ALL_TAC] THEN
    REWRITE_TAC [positive_semidefinite, symmetric_matrix] THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id
     [← REWRITE_RULE [symmetric_matrix]
       SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"P:real^N^N", ← q r"D:real^N^N"] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN EXISTS_TAC
     (← q r"transp P ** ((lambda i j. sqrt((D:real^N^N)$i$j)):real^N^N) **
      (P:real^N^N)") THEN
    REWRITE_TAC [MATRIX_TRANSP_MUL, TRANSP_TRANSP, ← GSYM CONJ_ASSOC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN AP_TERM_TAC THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      SIMP_TAC [CART_EQ, transp, LAMBDA_BETA] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [diagonal_matrix]) THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"j:num") THEN
      DISCH_TAC THEN ASM_CASES_TAC (← q r"i:num = j") THEN ASM_REWRITE_TAC [] THEN
      AP_TERM_TAC THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i j. 1 <= i /\ i <= dimindex(:N) /\
            1 <= j /\ j <= dimindex(:N)
            ==> &0 <= (D:real^N^N)$i$j")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"j:num = i") THENL
       [UNDISCH_TAC (← q r"!x:real^N. &0 <= x dot (A ** x)") THEN EXPAND_TAC "A" THEN
        REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
        ONCE_REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN
        ONCE_REWRITE_TAC [← GSYM DOT_LMUL_MATRIX] THEN
        REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_TRANSP] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"transp(P:real^N^N) ** basis i")) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
        ASM_REWRITE_TAC [MATRIX_MUL_ASSOC, MATRIX_VECTOR_MUL_ASSOC] THEN
        ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
        ASM_REWRITE_TAC [MATRIX_VECTOR_MUL_LID, MATRIX_MUL_RID] THEN
        ASM_SIMP_TAC [MATRIX_VECTOR_MUL_BASIS, DOT_BASIS] THEN
        ASM_SIMP_TAC [column, LAMBDA_BETA],
        MATCH_MP_TAC REAL_EQ_IMP_LE THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [diagonal_matrix]) THEN
        ASM_MESON_TAC []],
      CONJ_TAC THENL
       [REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
        ONCE_REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN
        ONCE_REWRITE_TAC [← GSYM DOT_LMUL_MATRIX] THEN
        REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_TRANSP] THEN
        REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN
        X_GEN_TAC (← q r"x:real^N") THEN
        SPEC_TAC (← q r"(P:real^N^N) ** (x:real^N)", ← q r"y:real^N") THEN
        SIMP_TAC [matrix_vector_mul, dot, LAMBDA_BETA] THEN
        X_GEN_TAC (← q r"y:real^N") THEN MATCH_MP_TAC SUM_POS_LE_NUMSEG THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN REWRITE_TAC [← GSYM SUM_LMUL] THEN
        MATCH_MP_TAC SUM_POS_LE_NUMSEG THEN X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [diagonal_matrix]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"i:num", ← q r"j:num"]) THEN
        ASM_CASES_TAC (← q r"j:num = i") THEN
        ASM_SIMP_TAC [SQRT_0, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_LE_REFL] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"y * a * y:real = a * y * y")] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN
        ASM_SIMP_TAC [REAL_LE_SQUARE, SQRT_POS_LE],
        EXPAND_TAC "A" THEN REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
        AP_TERM_TAC THEN REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN
        GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← GSYM MATRIX_MUL_ASSOC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
        ASM_REWRITE_TAC [MATRIX_MUL_RID] THEN
        REWRITE_TAC [MATRIX_MUL_LTRANSP_DOT_COLUMN] THEN
        SIMP_TAC [CART_EQ, LAMBDA_BETA, column, dot] THEN
        FIRST_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE id [DIAGONAL_MATRIX]) THEN
        SIMP_TAC [LAMBDA_BETA] THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [COND_RAND] THEN
        REWRITE_TAC [SQRT_0] THEN ONCE_REWRITE_TAC [COND_RAND] THEN
        REWRITE_TAC [REAL_MUL_RZERO] THEN
        ASM_SIMP_TAC [SUM_DELTA, IN_NUMSEG] THEN
        ASM_SIMP_TAC [← GSYM REAL_POW_2, SQRT_POW_2, REAL_MUL_LZERO]]]))

  return { POSITIVE_SEMIDEFINITE_COVARIANCE_EQ, POSITIVE_SEMIDEFINITE_COVARIANCE_EQ_ALT }

/- ------------------------------------------------------------------------- -/
/- Square roots, determinants and traces of semidefinite matrices.           -/
/- (topology.ml 20506-20684)                                                 -/
/- ------------------------------------------------------------------------- -/

structure PSS where
  POSITIVE_SEMIDEFINITE_SQRT_EQ : thm
  POSITIVE_SEMIDEFINITE_SQRT : thm
  POSITIVE_DEFINITE_COVARIANCE_EQ : thm
  POSITIVE_DEFINITE_COVARIANCE_EQ_ALT : thm
  DET_POSITIVE_SEMIDEFINITE : thm
  DET_POSITIVE_DEFINITE : thm
  POSITIVE_SEMIDEFINITE_DIAGONAL_INEQUALITY : thm
  TRACE_COVARIANCE_POSITIVE_SEMIDEFINITE_LE : thm
  TRACE_SQUARE_POSITIVE_SEMIDEFINITE_LE : thm
  TRACE_MUL_POSITIVE_SEMIDEFINITE_LE : thm
  POSITIVE_SEMIDEFINITE_ZERO_ROW : thm
  POSITIVE_SEMIDEFINITE_ZERO_COLUMN : thm
  POSITIVE_SEMIDEFINITE_TRACE_EQ_0 : thm
  COVARIANCE_MATRIX_EQ_SQUARE : thm
  TRACE_MUL_POSITIVE_SEMIDEFINITE : thm
  TRACE_MUL_POSITIVE_SEMIDEFINITE_EQ_0 : thm
  TRACE_MUL_POSITIVE_SEMIDEFINITE_DEFINITE_EQ_0 : thm
  TRACE_MUL_POSITIVE_DEFINITE_SEMIDEFINITE_EQ_0 : thm
  deriving Inhabited

@[nospecialize]
def setupPSS [HolBase] (D : TopologyDeps) (BPSC : PSC) : ExceptT String IO PSS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RING, .. } := D
  let { AND_FORALL_THM, CART_EQ, .. } := D.core1
  let { IMP_CONJ_ALT, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { REAL_LE_LSQRT, REAL_LE_MUL2, REAL_LE_POW_2, REAL_LE_SQUARE, REAL_LT_LE, .. } := D.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_POW_2, REAL_SUB_0, SQRT_POS_LE, .. } :=
    D.core5
  let { SUM_LE_NUMSEG, SUM_LMUL, SUM_POS_EQ_0_NUMSEG, SUM_RMUL, .. } := D.core6
  let { COVARIANCE_MATRIX_EQ_0, .. } := D.vec1
  let { INVERTIBLE_TRANSP, MATRIX_ENTIRE, MATRIX_EQUAL_ROWS, MATRIX_MUL_ASSOC, MATRIX_MUL_LZERO,
        MATRIX_MUL_RZERO, MATRIX_SUB_EQ, MATRIX_SUB_LDISTRIB, MATRIX_SUB_RDISTRIB,
        MATRIX_SUB_REFL, MATRIX_SUB_RZERO, MATRIX_TRANSP_MUL, .. } := D.vec2
  let { ROW_0, .. } := D.vec3
  let { TRANSP_MATRIX_SUB, TRANSP_TRANSP, VECTOR_2, VEC_COMPONENT, column, matrix_mul, row,
        symmetric_matrix, transp, .. } := D.vec4
  let { DET_2, DET_MUL, DET_TRANSP, DIAGONAL_POSITIVE_SEMIDEFINITE, INVERTIBLE_DET_NZ,
        INVERTIBLE_MATRIX_MUL, POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE,
        POSITIVE_SEMIDEFINITE_COVARIANCE, POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC,
        POSITIVE_SEMIDEFINITE_SUBMATRIX_2, TRACE_0, TRACE_COVARIANCE_CAUCHY_SCHWARZ,
        TRACE_COVARIANCE_POS_LE, TRACE_MUL_CYCLIC, TRACE_MUL_SYM, TRACE_POSITIVE_SEMIDEFINITE,
        TRACE_SUB, TRACE_TRANSP, positive_semidefinite, trace, .. } := D.det
  let { POSITIVE_SEMIDEFINITE_COVARIANCE_EQ, POSITIVE_SEMIDEFINITE_COVARIANCE_EQ_ALT, .. } := BPSC
  -- @@SCOPE END

  let POSITIVE_SEMIDEFINITE_SQRT_EQ ← prove
   r"!A:real^N^N.
        positive_semidefinite A <=>
        ?S:real^N^N. positive_semidefinite S /\ A = S ** S"
   (GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [POSITIVE_SEMIDEFINITE_COVARIANCE_EQ_ALT] THEN
    REWRITE_TAC [positive_semidefinite, symmetric_matrix] THEN MESON_TAC [])

  let POSITIVE_SEMIDEFINITE_SQRT ← prove
   r"!A:real^N^N. positive_semidefinite A ==> ?S:real^N^N. A = S ** S"
   (ONCE_REWRITE_TAC [POSITIVE_SEMIDEFINITE_SQRT_EQ] THEN MESON_TAC [])

  let POSITIVE_DEFINITE_COVARIANCE_EQ ← prove
   r"!A:real^N^N.
        positive_definite A <=>
        ?S:real^N^N. invertible S /\ transp S ** S = A"
   (REWRITE_TAC [POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE,
                 POSITIVE_SEMIDEFINITE_COVARIANCE_EQ] THEN
    MESON_TAC [INVERTIBLE_MATRIX_MUL, INVERTIBLE_TRANSP])

  let POSITIVE_DEFINITE_COVARIANCE_EQ_ALT ← prove
   r"!A:real^N^N.
        positive_definite A <=> ?S. positive_definite S /\ transp S ** S = A"
   (GEN_TAC THEN REWRITE_TAC [POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
     [POSITIVE_SEMIDEFINITE_COVARIANCE_EQ_ALT] THEN
    MESON_TAC [INVERTIBLE_MATRIX_MUL, INVERTIBLE_TRANSP])

  let DET_POSITIVE_SEMIDEFINITE ← prove
   r"!A:real^N^N. positive_semidefinite A ==> &0 <= det A"
   (ONCE_REWRITE_TAC [POSITIVE_SEMIDEFINITE_SQRT_EQ] THEN
    SIMP_TAC [DET_MUL, DET_TRANSP, REAL_LE_SQUARE, LEFT_IMP_EXISTS_THM])

  let DET_POSITIVE_DEFINITE ← prove
   r"!A:real^N^N. positive_definite A ==> &0 < det A"
   (SIMP_TAC [POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE, REAL_LT_LE,
              DET_POSITIVE_SEMIDEFINITE, INVERTIBLE_DET_NZ])

  let POSITIVE_SEMIDEFINITE_DIAGONAL_INEQUALITY ← prove
   r"!A:real^N^N i j.
        positive_semidefinite A /\
        1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:N)
        ==> A$i$j pow 2 <= A$i$i * A$j$j"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP POSITIVE_SEMIDEFINITE_SUBMATRIX_2) THEN
    DISCH_THEN (MP_TAC o MATCH_MP DET_POSITIVE_SEMIDEFINITE) THEN
    REWRITE_TAC [DET_2, VECTOR_2] THEN FIRST_ASSUM (MP_TAC o CONJUNCT1) THEN
    REWRITE_TAC [positive_semidefinite, symmetric_matrix] THEN
    DISCH_THEN (MP_TAC o CONJUNCT1) THEN SIMP_TAC [CART_EQ] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"j:num")) THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [transp, LAMBDA_BETA] THEN REAL_ARITH_TAC)

  let TRACE_COVARIANCE_POSITIVE_SEMIDEFINITE_LE ← prove
   r"!A:real^N^N.
        positive_semidefinite A ==> trace(transp A ** A) <= trace(A) pow 2"
   (REPEAT STRIP_TAC THEN
    SIMP_TAC [trace, matrix_mul, LAMBDA_BETA, transp, REAL_POW_2] THEN
    REWRITE_TAC [← GSYM SUM_RMUL] THEN
    MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"m:num") THEN
    STRIP_TAC THEN REWRITE_TAC [← GSYM SUM_LMUL] THEN
    MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"n:num") THEN
    STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_POW_2] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_MESON_TAC [POSITIVE_SEMIDEFINITE_DIAGONAL_INEQUALITY])

  let TRACE_SQUARE_POSITIVE_SEMIDEFINITE_LE ← prove
   r"!A:real^N^N.
        positive_semidefinite A ==> trace(A ** A) <= trace(A) pow 2"
   (MESON_TAC [POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC,
               TRACE_COVARIANCE_POSITIVE_SEMIDEFINITE_LE])

  let TRACE_MUL_POSITIVE_SEMIDEFINITE_LE ← prove
   r"!A B:real^N^N.
        positive_semidefinite A /\ positive_semidefinite B
        ==> trace(A ** B) <= trace(A) * trace(B)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"A:real^N^N", ← q r"B:real^N^N"]
          TRACE_COVARIANCE_CAUCHY_SCHWARZ) THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x = y /\ w <= z ==> x <= w ==> y <= z")) THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC], ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_MUL2 THEN
    SIMP_TAC [SQRT_POS_LE, TRACE_COVARIANCE_POS_LE] THEN
    CONJ_TAC THEN MATCH_MP_TAC REAL_LE_LSQRT THEN
    ASM_SIMP_TAC [TRACE_POSITIVE_SEMIDEFINITE] THEN
    ASM_SIMP_TAC [TRACE_COVARIANCE_POSITIVE_SEMIDEFINITE_LE])

  let POSITIVE_SEMIDEFINITE_ZERO_ROW ← prove
   r"!A:real^N^N i.
        positive_semidefinite A /\ 1 <= i /\ i <= dimindex(:N) /\ A$i$i = &0
        ==> row i A = vec 0"
   (REPEAT STRIP_TAC THEN SIMP_TAC [CART_EQ, row, LAMBDA_BETA, VEC_COMPONENT] THEN
    X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"A:real^N^N", ← q r"i:num", ← q r"j:num"]
     POSITIVE_SEMIDEFINITE_DIAGONAL_INEQUALITY) THEN
    ASM_SIMP_TAC [REAL_MUL_LZERO, REAL_LE_POW_2, ← REAL_ARITH
     (← q r"&0 <= x ==> (x <= &0 <=> x = &0)")] THEN
    CONV_TAC (fun t => REAL_RING t))

  let POSITIVE_SEMIDEFINITE_ZERO_COLUMN ← prove
   r"!A:real^N^N i.
        positive_semidefinite A /\ 1 <= i /\ i <= dimindex(:N) /\ A$i$i = &0
        ==> column i A = vec 0"
   (REPEAT STRIP_TAC THEN
    SIMP_TAC [CART_EQ, column, LAMBDA_BETA, VEC_COMPONENT] THEN
    X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"A:real^N^N", ← q r"j:num", ← q r"i:num"]
     POSITIVE_SEMIDEFINITE_DIAGONAL_INEQUALITY) THEN
    ASM_SIMP_TAC [REAL_MUL_RZERO, REAL_LE_POW_2, ← REAL_ARITH
     (← q r"&0 <= x ==> (x <= &0 <=> x = &0)")] THEN
    CONV_TAC (fun t => REAL_RING t))

  let POSITIVE_SEMIDEFINITE_TRACE_EQ_0 ← prove
   r"!A:real^N^N. positive_semidefinite A ==> (trace A = &0 <=> A = mat 0)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [TRACE_0] THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [MATRIX_EQUAL_ROWS] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE LAND_CONV [trace]) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          SUM_POS_EQ_0_NUMSEG)) THEN
    ASM_SIMP_TAC [DIAGONAL_POSITIVE_SEMIDEFINITE, ROW_0] THEN
    ASM_MESON_TAC [POSITIVE_SEMIDEFINITE_ZERO_ROW])

  let COVARIANCE_MATRIX_EQ_SQUARE ← prove
   r"!A:real^N^N. transp A ** A = A ** A <=> symmetric_matrix A"
   (REWRITE_TAC [symmetric_matrix] THEN GEN_TAC THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"transp A - A:real^N^N") POSITIVE_SEMIDEFINITE_COVARIANCE) THEN
    DISCH_THEN (MP_TAC o MATCH_MP POSITIVE_SEMIDEFINITE_TRACE_EQ_0) THEN
    REWRITE_TAC [COVARIANCE_MATRIX_EQ_0, MATRIX_SUB_EQ] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_REWRITE_TAC [TRANSP_MATRIX_SUB, TRANSP_TRANSP] THEN
    REWRITE_TAC [MATRIX_SUB_LDISTRIB] THEN
    ASM_REWRITE_TAC [MATRIX_SUB_RDISTRIB, MATRIX_SUB_REFL, MATRIX_SUB_RZERO] THEN
    REWRITE_TAC [TRACE_SUB, REAL_SUB_0] THEN
    ONCE_REWRITE_TAC [TRACE_MUL_SYM] THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM MATRIX_TRANSP_MUL, TRACE_TRANSP])

  let (TRACE_MUL_POSITIVE_SEMIDEFINITE, TRACE_MUL_POSITIVE_SEMIDEFINITE_EQ_0) ← do
    let lemma ← prove
     r"!A:real^N^N B:real^N^N.
            trace((transp A ** A) ** (transp B ** B)) =
            trace(transp(A ** transp B) ** (A ** transp B))"
     (REPEAT GEN_TAC THEN
       GEN_REWRITE_TAC LAND_CONV [← GSYM TRACE_MUL_CYCLIC] THEN
      REWRITE_TAC [MATRIX_TRANSP_MUL, TRANSP_TRANSP, ← GSYM MATRIX_MUL_ASSOC])
    CONJ_PAIR (← prove
     r"(!A:real^N^N B:real^N^N.
          positive_semidefinite A /\ positive_semidefinite B
          ==> &0 <= trace(A ** B)) /\
      (!A:real^N^N B:real^N^N.
          positive_semidefinite A /\ positive_semidefinite B
          ==> (trace(A ** B) = &0 <=> A ** B = mat 0))"
     (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
      REWRITE_TAC [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
      REWRITE_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE_EQ] THEN
      STRIP_TAC THEN
      SIMP_TAC [← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)"), TRACE_0] THEN
      ASM_REWRITE_TAC [lemma] THEN
      SIMP_TAC [POSITIVE_SEMIDEFINITE_TRACE_EQ_0, POSITIVE_SEMIDEFINITE_COVARIANCE,
                TRACE_POSITIVE_SEMIDEFINITE, COVARIANCE_MATRIX_EQ_0] THEN
      DISCH_TAC THEN REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [MATRIX_MUL_ASSOC] THEN
      ASM_REWRITE_TAC [MATRIX_MUL_LZERO, MATRIX_MUL_RZERO]))

  let TRACE_MUL_POSITIVE_SEMIDEFINITE_DEFINITE_EQ_0 ← prove
   r"!A:real^N^N B:real^N^N.
        positive_semidefinite A /\ positive_definite B
        ==> (trace(A ** B) = &0 <=> A = mat 0)"
   (SIMP_TAC [POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE, MATRIX_ENTIRE,
              TRACE_MUL_POSITIVE_SEMIDEFINITE_EQ_0])

  let TRACE_MUL_POSITIVE_DEFINITE_SEMIDEFINITE_EQ_0 ← prove
   r"!A:real^N^N B:real^N^N.
        positive_definite A /\ positive_semidefinite B
        ==> (trace(A ** B) = &0 <=> B = mat 0)"
   (SIMP_TAC [POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE, MATRIX_ENTIRE,
              TRACE_MUL_POSITIVE_SEMIDEFINITE_EQ_0])

  return { POSITIVE_SEMIDEFINITE_SQRT_EQ, POSITIVE_SEMIDEFINITE_SQRT,
           POSITIVE_DEFINITE_COVARIANCE_EQ, POSITIVE_DEFINITE_COVARIANCE_EQ_ALT,
           DET_POSITIVE_SEMIDEFINITE, DET_POSITIVE_DEFINITE,
           POSITIVE_SEMIDEFINITE_DIAGONAL_INEQUALITY, TRACE_COVARIANCE_POSITIVE_SEMIDEFINITE_LE,
           TRACE_SQUARE_POSITIVE_SEMIDEFINITE_LE, TRACE_MUL_POSITIVE_SEMIDEFINITE_LE,
           POSITIVE_SEMIDEFINITE_ZERO_ROW, POSITIVE_SEMIDEFINITE_ZERO_COLUMN,
           POSITIVE_SEMIDEFINITE_TRACE_EQ_0, COVARIANCE_MATRIX_EQ_SQUARE,
           TRACE_MUL_POSITIVE_SEMIDEFINITE, TRACE_MUL_POSITIVE_SEMIDEFINITE_EQ_0,
           TRACE_MUL_POSITIVE_SEMIDEFINITE_DEFINITE_EQ_0,
           TRACE_MUL_POSITIVE_DEFINITE_SEMIDEFINITE_EQ_0 }

/- ------------------------------------------------------------------------- -/
/- Orthogonal, inverse and cofactor of semidefinite matrices.                -/
/- (topology.ml 20685-20818)                                                 -/
/- ------------------------------------------------------------------------- -/

structure PSO where
  POSITIVE_SEMIDEFINITE_AND_ORTHOGONAL : thm
  POSITIVE_SEMIDEFINITE_INV : thm
  POSITIVE_DEFINITE_INV : thm
  POSITIVE_DEFINITE_COFACTOR : thm
  POSITIVE_SEMIDEFINITE_COFACTOR : thm
  POSITIVE_DEFINITE_COFACTOR_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupPSO [HolBase] (D : TopologyDeps) (BCMS : CMS) (BIDC : IDC) (BLCP : LCP) (BHSP : HSP)
    (BECF : ECF) (BSMI : SMI) (BITV1 : ITV1) (BITV2 : ITV2) (BR1A : R1A) (BMID1 : MID1)
    (BCFM : CFM) (BDIG : DIG) (BPSC : PSC) (BPSS : PSS) : ExceptT String IO PSO := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, REAL_RING,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { CART_EQ, DIMINDEX_GE_1, FINITE_NUMSEG, .. } := D.core1
  let { IMP_CONJ, IN_ELIM_THM, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, .. } := D.core4
  let { REAL_MUL_LINV, REAL_MUL_LZERO, REAL_POS, REAL_POW_LT, .. } := D.core5
  let { SUM_DELTA, o_DEF, real_ge, .. } := D.core6
  let { DOT_LZERO, DROP_VEC, ENDS_IN_UNIT_INTERVAL, FORALL_LIFT, .. } := D.vec1
  let { INVERTIBLE_MATRIX_INV, LIFT_ADD, LIFT_CMUL, LIFT_DROP, MATRIX_ADD_COMPONENT,
        MATRIX_ADD_RID, MATRIX_CMUL_ASSOC, MATRIX_CMUL_COMPONENT, MATRIX_CMUL_LID,
        MATRIX_CMUL_LZERO, MATRIX_INV_COVARIANCE, MATRIX_INV_INV, MATRIX_MUL_ASSOC,
        MATRIX_MUL_LID, MATRIX_MUL_RID, .. } := D.vec2
  let { MATRIX_VECTOR_MUL_COMPONENT, NORM_EQ_SQUARE, .. } := D.vec3
  let { TRANSP_TRANSP, dot, drop, mat, row, symmetric_matrix, .. } := D.vec4
  let { COFACTOR_1_GEN, COFACTOR_MATRIX_INV, COFACTOR_TRANSP, DET_1_GEN, DIAGONAL_MATRIX,
        DIAGONAL_POSITIVE_SEMIDEFINITE, INVERTIBLE_DET_NZ, NEARBY_POSITIVE_DEFINITE_MATRIX,
        ORTHOGONAL_MATRIX_MUL, ORTHOGONAL_MATRIX_ORTHONORMAL_ROWS_INDEXED,
        ORTHOGONAL_MATRIX_TRANSP, POSITIVE_DEFINITE_1_GEN, POSITIVE_DEFINITE_CMUL,
        POSITIVE_DEFINITE_ID, POSITIVE_DEFINITE_IMP_INVERTIBLE,
        POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE, POSITIVE_DEFINITE_TRANSP,
        POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC, POSITIVE_SEMIDEFINITE_SIMILAR, cofactor,
        orthogonal_matrix, positive_definite, positive_semidefinite, .. } := D.det
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPONENTWISE_LIFT, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { CONTINUOUS_ON_LIFT_DOT2, .. } := BLCP
  let { CLOSED_HALFSPACE_COMPONENT_GE, .. } := BHSP
  let { FORALL_IN_CLOSURE, .. } := BECF
  let { CONTINUOUS_ON_MUL, .. } := BSMI
  let { CLOSURE_INTERVAL, .. } := BITV1
  let { UNIT_INTERVAL_NONEMPTY, .. } := BITV2
  let { IN_INTERVAL_1, .. } := BR1A
  let { CONTINUOUS_ON_LIFT_DET, .. } := BMID1
  let { COFACTOR_COFACTOR, .. } := BCFM
  let { SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, .. } := BDIG
  let { POSITIVE_SEMIDEFINITE_COVARIANCE_EQ, .. } := BPSC
  let { DET_POSITIVE_DEFINITE, .. } := BPSS
  -- @@SCOPE END

  let POSITIVE_SEMIDEFINITE_AND_ORTHOGONAL ← prove
   r"!A:real^N^N.
        positive_semidefinite A /\ orthogonal_matrix A
        ==> A = mat 1"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o CONJUNCT1 o
     GEN_REWRITE_RULE id [positive_semidefinite]) THEN
    REWRITE_TAC [SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"Q:real^N^N", ← q r"D:real^N^N"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"D:real^N^N = mat 1")
     (fun th => ASM_MESON_TAC [MATRIX_MUL_LID, orthogonal_matrix, th]) THEN
    SUBGOAL_THEN
     (← q r"positive_semidefinite(D:real^N^N) /\ orthogonal_matrix D")
    MP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o AP_TERM
       (← q r"\X:real^N^N. Q ** X ** transp(Q:real^N^N)")) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      ASM_REWRITE_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_LID] THEN
      ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_RID] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM orthogonal_matrix]) THEN
      ASM_MESON_TAC [ORTHOGONAL_MATRIX_MUL, ORTHOGONAL_MATRIX_TRANSP,
                     POSITIVE_SEMIDEFINITE_SIMILAR, TRANSP_TRANSP],
      DISCH_THEN (CONJUNCTS_THEN2
       (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
                    DIAGONAL_POSITIVE_SEMIDEFINITE))
       (MP_TAC o CONJUNCT1 o
         REWRITE_RULE [ORTHOGONAL_MATRIX_ORTHONORMAL_ROWS_INDEXED]))] THEN
    FIRST_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE id [DIAGONAL_MATRIX]) THEN
    SIMP_TAC [LAMBDA_BETA, NORM_EQ_SQUARE, row, dot, CART_EQ] THEN
    REWRITE_TAC [← MESON []
     (← q r"(if i = j then x else y:real) * (if i = j then a else b) =
      (if j = i then x * a else y * b)")] THEN
    SIMP_TAC [SUM_DELTA, REAL_MUL_LZERO, REAL_POS, FINITE_NUMSEG] THEN
    SIMP_TAC [mat, LAMBDA_BETA, IN_NUMSEG] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    SUBGOAL_THEN (← q r"!x. x * x = &1 /\ &0 <= x ==> x = &1")
     (fun th => MESON_TAC [th]) THEN
    REWRITE_TAC [← REAL_RING (← q r"x * x = &1 <=> x = &1 \/ x = -- &1")] THEN
    REAL_ARITH_TAC)

  let POSITIVE_SEMIDEFINITE_INV ← prove
   r"!A:real^N^N.
     positive_semidefinite(matrix_inv A) <=> positive_semidefinite A"
   (SUBGOAL_THEN
     (← q r"!A:real^N^N. positive_semidefinite A
                   ==> positive_semidefinite(matrix_inv A)")
    MP_TAC THENL [GEN_TAC, MESON_TAC [MATRIX_INV_INV]] THEN
    REWRITE_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE_EQ] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"S:real^N^N") SUBST1_TAC) THEN
    REWRITE_TAC [MATRIX_INV_COVARIANCE] THEN MESON_TAC [TRANSP_TRANSP])

  let POSITIVE_DEFINITE_INV ← prove
   r"!A:real^N^N.
     positive_definite(matrix_inv A) <=> positive_definite A"
   (REWRITE_TAC [POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE,
                 POSITIVE_SEMIDEFINITE_INV, INVERTIBLE_MATRIX_INV])

  let POSITIVE_DEFINITE_COFACTOR ← prove
   r"!A:real^N^N. positive_definite A ==> positive_definite(cofactor A)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP POSITIVE_DEFINITE_IMP_INVERTIBLE) THEN
    REWRITE_TAC [INVERTIBLE_DET_NZ] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP COFACTOR_MATRIX_INV) THEN
    MATCH_MP_TAC POSITIVE_DEFINITE_CMUL THEN
    ASM_SIMP_TAC [POSITIVE_DEFINITE_TRANSP, POSITIVE_DEFINITE_INV] THEN
    ASM_SIMP_TAC [DET_POSITIVE_DEFINITE])

  let POSITIVE_SEMIDEFINITE_COFACTOR ← prove
   r"!A:real^N^N. positive_semidefinite A ==> positive_semidefinite(cofactor A)"
   (GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [positive_semidefinite] THEN
    REWRITE_TAC [symmetric_matrix, ← GSYM COFACTOR_TRANSP] THEN
    ASM_SIMP_TAC [POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC] THEN
    X_GEN_TAC (← q r"v:real^N") THEN ASM_CASES_TAC (← q r"v:real^N = vec 0") THEN
    ASM_REWRITE_TAC [DOT_LZERO, REAL_LE_REFL] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN closure(interval(vec 0,vec 1))
          ==> lift(v dot (cofactor(A + drop x %% mat 1:real^N^N) ** v)) IN
              {t | &0 <= drop t}")
    MP_TAC THENL
     [MATCH_MP_TAC FORALL_IN_CLOSURE,
      REWRITE_TAC [IN_ELIM_THM, LIFT_DROP] THEN
      SIMP_TAC [CLOSURE_INTERVAL, UNIT_INTERVAL_NONEMPTY] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^1")) THEN
      REWRITE_TAC [DROP_VEC, MATRIX_CMUL_LZERO, MATRIX_ADD_RID] THEN
      REWRITE_TAC [ENDS_IN_UNIT_INTERVAL]] THEN
    REWRITE_TAC [IN_ELIM_THM, LIFT_DROP] THEN
    SIMP_TAC [CLOSURE_INTERVAL, UNIT_INTERVAL_NONEMPTY] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [drop, ← REWRITE_RULE [real_ge] CLOSED_HALFSPACE_COMPONENT_GE],
      MATCH_MP_TAC CONTINUOUS_ON_LIFT_DOT2 THEN
      REWRITE_TAC [cofactor, CONTINUOUS_ON_CONST] THEN
      ONCE_REWRITE_TAC [CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [MATRIX_VECTOR_MUL_COMPONENT] THEN
      MATCH_MP_TAC CONTINUOUS_ON_LIFT_DOT2 THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_CONST, LAMBDA_BETA] THEN
      ONCE_REWRITE_TAC [CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
      X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN ASM_SIMP_TAC [LAMBDA_BETA] THEN
      MATCH_MP_TAC CONTINUOUS_ON_LIFT_DET THEN SIMP_TAC [LAMBDA_BETA] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:num", ← q r"l:num"] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"k:num = i /\ l:num = j") THEN
      ASM_REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      ASM_CASES_TAC (← q r"k:num = i \/ l:num = j") THEN
      ASM_REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      REWRITE_TAC [MATRIX_ADD_COMPONENT, LIFT_ADD] THEN
      MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      REWRITE_TAC [MATRIX_CMUL_COMPONENT, LIFT_CMUL] THEN
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      REWRITE_TAC [CONTINUOUS_ON_CONST, LIFT_DROP, o_DEF, CONTINUOUS_ON_ID],
      REWRITE_TAC [FORALL_LIFT, IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
      X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN MP_TAC
       (← ISPECL [← q r"A:real^N^N", ← q r"x:real"] NEARBY_POSITIVE_DEFINITE_MATRIX) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP POSITIVE_DEFINITE_COFACTOR) THEN
      ASM_SIMP_TAC [positive_definite, REAL_LT_IMP_LE]])

  let POSITIVE_DEFINITE_COFACTOR_EQ ← prove
   r"!A:real^N^N.
        positive_definite A <=>
        positive_definite(cofactor A) /\ &0 < det A"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"dimindex(:N) = 1") THENL
     [ASM_SIMP_TAC [COFACTOR_1_GEN, DET_1_GEN, POSITIVE_DEFINITE_ID] THEN
      ASM_SIMP_TAC [POSITIVE_DEFINITE_1_GEN],
      EQ_TAC THEN
      SIMP_TAC [POSITIVE_DEFINITE_COFACTOR, DET_POSITIVE_DEFINITE] THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP POSITIVE_DEFINITE_COFACTOR) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"~(n = 1) ==> 1 <= n ==> 2 <= n"))) THEN
      SIMP_TAC [DIMINDEX_GE_1] THEN DISCH_TAC THEN
      ASM_SIMP_TAC [COFACTOR_COFACTOR] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(det(A:real^N^N) pow (dimindex (:N) - 2))") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] POSITIVE_DEFINITE_CMUL)) THEN
      ASM_SIMP_TAC [REAL_LT_INV_EQ, REAL_POW_LT, MATRIX_CMUL_ASSOC,
                    REAL_MUL_LINV, REAL_LT_IMP_NZ, MATRIX_CMUL_LID]])

  return { POSITIVE_SEMIDEFINITE_AND_ORTHOGONAL, POSITIVE_SEMIDEFINITE_INV,
           POSITIVE_DEFINITE_INV, POSITIVE_DEFINITE_COFACTOR, POSITIVE_SEMIDEFINITE_COFACTOR,
           POSITIVE_DEFINITE_COFACTOR_EQ }

/- ------------------------------------------------------------------------- -/
/- Uniqueness of semidefinite square roots.  (topology.ml 20819-20905)       -/
/- ------------------------------------------------------------------------- -/

structure PSU where
  POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE : thm
  POSITIVE_SEMIDEFINITE_SQRT_UNIQUE : thm
  deriving Inhabited

@[nospecialize]
def setupPSU [HolBase] (D : TopologyDeps) (BDIG : DIG) (BPSC : PSC) : ExceptT String IO PSU := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_FIELD, REAL_RING, .. } := D
  let { CART_EQ, EXISTS_UNIQUE_DEF, .. } := D.core1
  let { IMP_CONJ, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_FORALL, .. } := D.core3
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, .. } := D.core5
  let { SUM_DELTA, .. } := D.core6
  let { COVARIANCE_MATRIX_EQ_0, .. } := D.vec1
  let { MATRIX_MUL_ASSOC, MATRIX_MUL_LID, MATRIX_MUL_RID, MATRIX_SUB_EQ, MATRIX_SUB_LDISTRIB,
        MATRIX_SUB_RDISTRIB, MATRIX_SUB_REFL, MATRIX_TRANSP_MUL, .. } := D.vec2
  let { TRANSP_MATRIX_SUB, TRANSP_TRANSP, matrix_mul, symmetric_matrix, .. } := D.vec4
  let { DIAGONAL_MATRIX, DIAGONAL_POSITIVE_SEMIDEFINITE, ORTHOGONAL_MATRIX_IMP_INVERTIBLE,
        POSITIVE_SEMIDEFINITE_SIMILAR_EQ, TRANSP_DIAGONAL_MATRIX, orthogonal_matrix,
        positive_semidefinite, .. } := D.det
  let { SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, .. } := BDIG
  let { POSITIVE_SEMIDEFINITE_COVARIANCE_EQ_ALT, .. } := BPSC
  -- @@SCOPE END

  let POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE ← prove
   r"!A:real^N^N. positive_semidefinite A <=>
                ?!S. positive_semidefinite S /\ A = transp S ** S"
   (GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC, MESON_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE_EQ_ALT]] THEN
    REWRITE_TAC [EXISTS_UNIQUE_DEF] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE_EQ_ALT], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"S:real^N^N", ← q r"U:real^N^N"] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ONCE_REWRITE_TAC [← GSYM MATRIX_SUB_EQ] THEN
    ONCE_REWRITE_TAC [← GSYM COVARIANCE_MATRIX_EQ_0] THEN
    REWRITE_TAC [MATRIX_SUB_LDISTRIB] THEN
    REWRITE_TAC [TRANSP_MATRIX_SUB, MATRIX_SUB_RDISTRIB] THEN
    ASM_REWRITE_TAC [MATRIX_SUB_EQ] THEN
    SUBGOAL_THEN (← q r"transp(U:real^N^N) ** (S:real^N^N) = A") ASSUME_TAC THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [MATRIX_SUB_REFL] THEN CONV_TAC SYM_CONV THEN
      REWRITE_TAC [MATRIX_SUB_EQ] THEN
      GEN_REWRITE_TAC BINOP_CONV [← GSYM TRANSP_TRANSP] THEN
      ONCE_REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
      ASM_REWRITE_TAC [TRANSP_TRANSP] THEN
      ASM_MESON_TAC [positive_semidefinite, symmetric_matrix]] THEN
    SUBGOAL_THEN (← q r"symmetric_matrix(S:real^N^N) /\ symmetric_matrix(U:real^N^N)")
    MP_TAC THENL [ASM_MESON_TAC [positive_semidefinite], ALL_TAC] THEN
    REWRITE_TAC [IMP_CONJ, SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"O:real^N^N", ← q r"D:real^N^N"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"P:real^N^N", ← q r"C:real^N^N"] THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"Q = (P:real^N^N) ** transp(O:real^N^N)") THEN
    SUBGOAL_THEN (← q r"(Q:real^N^N) ** (D ** D) = (C ** C) ** Q") MP_TAC THENL
     [UNDISCH_TAC (← q r"transp(S:real^N^N) ** S = A") THEN
      UNDISCH_TAC (← q r"transp(U:real^N^N) ** U = A") THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [MATRIX_TRANSP_MUL, TRANSP_TRANSP] THEN
      REWRITE_TAC [← MESON [MATRIX_MUL_ASSOC]
       (← q r"(A ** (Q:real^N^N)) ** (Q':real^N^N) ** C =
        (A:real^N^N) ** (Q ** Q') ** (C:real^N^N)")] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      ASM_REWRITE_TAC [MATRIX_MUL_LID] THEN DISCH_THEN (MP_TAC o
        AP_TERM (← q r"\X:real^N^N. (P:real^N^N) ** X ** transp(O:real^N^N)")) THEN
      ASM_REWRITE_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_LID] THEN
      ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_RID] THEN
      ASM_SIMP_TAC [TRANSP_DIAGONAL_MATRIX],
      TRANS_TAC (← TAUT (← q r"!q. (p ==> q) /\ (q ==> r) ==> p ==> r"))
        (← q r"(Q:real^N^N) ** (D:real^N^N) = C ** (Q:real^N^N)") THEN
      CONJ_TAC THENL
       [REPEAT (FIRST_X_ASSUM
         (SUBST1_TAC o GEN_REWRITE_RULE id [DIAGONAL_MATRIX])) THEN
        SIMP_TAC [CART_EQ, matrix_mul, LAMBDA_BETA] THEN
        REPLICATE_TAC 2
         (REWRITE_TAC [← MESON [REAL_MUL_LZERO]
           (← q r"(if a = b then x else &0) * y = if b = a then x * y else &0")] THEN
         SIMP_TAC [SUM_DELTA, IN_NUMSEG] THEN
         REWRITE_TAC [← MESON [REAL_MUL_RZERO]
           (← q r"u * (if p then x else &0) = if p then u * x else &0")] THEN
         SIMP_TAC [SUM_DELTA, IN_NUMSEG]) THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
        DISCH_THEN (fun t => STRIP_TAC THEN MP_TAC t THEN ASM_REWRITE_TAC []) THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"j:num") THEN
        DISCH_THEN (fun t => STRIP_TAC THEN MP_TAC t THEN ASM_REWRITE_TAC []) THEN
        MATCH_MP_TAC (← REAL_RING
         (← q r"(c + d = &0 ==> c = &0 /\ d = &0)
          ==> q * d * d = (c * c) * q ==> q * d = c * q")) THEN
        MATCH_MP_TAC (← REAL_FIELD
         (← q r"&0 <= c /\ &0 <= d ==> c + d = &0 ==> c = &0 /\ d = &0")) THEN
        CONJ_TAC THEN
        MATCH_MP_TAC DIAGONAL_POSITIVE_SEMIDEFINITE THEN
        ASM_MESON_TAC [POSITIVE_SEMIDEFINITE_SIMILAR_EQ,
                       ORTHOGONAL_MATRIX_IMP_INVERTIBLE],
        DISCH_TAC THEN ASM_REWRITE_TAC [TRANSP_TRANSP, MATRIX_TRANSP_MUL] THEN
        ASM_REWRITE_TAC [← MESON [MATRIX_MUL_ASSOC]
         (← q r"(A ** (Q:real^N^N)) ** (Q':real^N^N) ** C =
          (A:real^N^N) ** (Q ** Q') ** (C:real^N^N)")] THEN
        UNDISCH_THEN (← q r"transp(U:real^N^N) ** U = A") (SUBST1_TAC o SYM) THEN
        ASM_REWRITE_TAC [TRANSP_TRANSP, MATRIX_TRANSP_MUL] THEN
        EXPAND_TAC "Q" THEN REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
        ASM_REWRITE_TAC [MATRIX_MUL_RID] THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
        ASM_REWRITE_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_LID]]])

  let POSITIVE_SEMIDEFINITE_SQRT_UNIQUE ← prove
   r"!A:real^N^N. positive_semidefinite A <=>
                ?!S. positive_semidefinite S /\ A = S ** S"
   (GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE] THEN
    REWRITE_TAC [positive_semidefinite, symmetric_matrix] THEN MESON_TAC [])

  return { POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE, POSITIVE_SEMIDEFINITE_SQRT_UNIQUE }

/- ------------------------------------------------------------------------- -/
/- Products of semidefinite matrices and the 2x2 case.                       -/
/- (topology.ml 20906-21099)                                                 -/
/- ------------------------------------------------------------------------- -/

structure PSM where
  POSITIVE_SEMIDEFINITE_MUL_EQ : thm
  POSITIVE_SEMIDEFINITE_MUL : thm
  POSITIVE_DEFINITE_MUL_EQ : thm
  POSITIVE_DEFINITE_MUL : thm
  COMMUTING_WITH_SQUARE_ROOT_MATRIX : thm
  POSITIVE_SEMIDEFINITE_MUL_EIGENVALUES : thm
  POSITIVE_SEMIDEFINITE_2_DET : thm
  POSITIVE_SEMIDEFINITE_2 : thm
  POSITIVE_DEFINITE_2_DET : thm
  POSITIVE_DEFINITE_2 : thm
  deriving Inhabited

@[nospecialize]
def setupPSM [HolBase] (D : TopologyDeps) (BEIG : EIG) (BDIG : DIG) (BGDR1 : GDR1) (BPSC : PSC)
    (BPSS : PSS) : ExceptT String IO PSM := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RING, .. } :=
    D
  let { ARITH, CART_EQ, CONJ_SYM, DIMINDEX_2, EQ_IMP, EQ_SYM_EQ, EQ_TRANS, .. } := D.core1
  let { LAMBDA_BETA, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, REAL_ADD_RID, .. } := D.core3
  let { REAL_ENTIRE, REAL_LE_ADD, REAL_LE_LCANCEL_IMP, REAL_LE_MUL, REAL_LE_POW_2,
        REAL_LE_SQUARE, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LE, .. } := D.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_SUB_LE, .. } := D.core5
  let { DOT_2, FORALL_2, FORALL_VECTOR_2, .. } := D.vec1
  let { INVERTIBLE_TRANSP, MATRIX_MUL_ASSOC, MATRIX_MUL_LID, MATRIX_MUL_RID,
        MATRIX_TRANSP_MUL, .. } := D.vec2
  let { SUM_2, TRANSP_COMPONENT, .. } := D.vec3
  let { TRANSP_TRANSP, VECTOR_2, matrix_vector_mul, symmetric_matrix, .. } := D.vec4
  let { COMMUTING_WITH_DIAGONAL_MATRIX, DET_2, DIAGONAL_MATRIX_MUL,
        DIAGONAL_MATRIX_MUL_COMPONENT, DIAGONAL_POSITIVE_DEFINITE,
        DIAGONAL_POSITIVE_SEMIDEFINITE, INVERTIBLE_DET_NZ, INVERTIBLE_MATRIX_MUL,
        ORTHOGONAL_MATRIX_IMP_INVERTIBLE, POSITIVE_DEFINITE_IMP_POSITIVE_SEMIDEFINITE,
        POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE, POSITIVE_DEFINITE_SIMILAR,
        POSITIVE_SEMIDEFINITE_COVARIANCE, POSITIVE_SEMIDEFINITE_SIMILAR, orthogonal_matrix,
        positive_definite, positive_semidefinite, .. } := D.det
  let { SAME_EIGENVALUES_MATRIX_MUL, .. } := BEIG
  let { SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, .. } := BDIG
  let { POSITIVE_DEFINITE_EIGENVALUES, POSITIVE_SEMIDEFINITE_EIGENVALUES, .. } := BGDR1
  let { POSITIVE_SEMIDEFINITE_COVARIANCE_EQ, .. } := BPSC
  let { DET_POSITIVE_DEFINITE, DET_POSITIVE_SEMIDEFINITE, POSITIVE_SEMIDEFINITE_SQRT_EQ, .. } :=
    BPSS
  -- @@SCOPE END

  let POSITIVE_SEMIDEFINITE_MUL_EQ ← prove
   r"!A:real^N^N B:real^N^N.
        positive_semidefinite A /\ positive_semidefinite B
        ==> (positive_semidefinite(A ** B) <=> A ** B = B ** A)"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS (← q r"transp(A ** (B:real^N^N)) = A ** B") THEN CONJ_TAC THENL
     [ALL_TAC,
      ASM_MESON_TAC [MATRIX_TRANSP_MUL, symmetric_matrix,
                     positive_semidefinite]] THEN
    EQ_TAC THENL
     [MESON_TAC [positive_semidefinite, symmetric_matrix], DISCH_TAC] THEN
    ASM_REWRITE_TAC [POSITIVE_SEMIDEFINITE_EIGENVALUES, symmetric_matrix] THEN
    MP_TAC (← ISPEC (← q r"A:real^N^N") POSITIVE_SEMIDEFINITE_SQRT_EQ) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"S:real^N^N") THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"positive_semidefinite(S ** (B:real^N^N) ** S)") MP_TAC THENL
     [ASM_MESON_TAC [POSITIVE_SEMIDEFINITE_SIMILAR,
                     positive_semidefinite, symmetric_matrix],
      ASM_REWRITE_TAC [POSITIVE_SEMIDEFINITE_EIGENVALUES]] THEN
    REWRITE_TAC [MATRIX_MUL_ASSOC] THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
    ASM_MESON_TAC [SAME_EIGENVALUES_MATRIX_MUL])

  let POSITIVE_SEMIDEFINITE_MUL ← prove
   r"!A:real^N^N B:real^N^N.
        positive_semidefinite A /\ positive_semidefinite B /\ A ** B = B ** A
        ==> positive_semidefinite(A ** B)"
   (SIMP_TAC [POSITIVE_SEMIDEFINITE_MUL_EQ])

  let POSITIVE_DEFINITE_MUL_EQ ← prove
   r"!A:real^N^N B:real^N^N.
        positive_definite A /\ positive_definite B
        ==> (positive_definite(A ** B) <=> A ** B = B ** A)"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS (← q r"transp(A ** (B:real^N^N)) = A ** B") THEN CONJ_TAC THENL
     [ALL_TAC,
      ASM_MESON_TAC [MATRIX_TRANSP_MUL, symmetric_matrix,
                     positive_definite]] THEN
    EQ_TAC THENL [MESON_TAC [positive_definite, symmetric_matrix], DISCH_TAC] THEN
    ASM_REWRITE_TAC [POSITIVE_DEFINITE_EIGENVALUES, symmetric_matrix] THEN
    MP_TAC (← ISPEC (← q r"A:real^N^N") POSITIVE_SEMIDEFINITE_SQRT_EQ) THEN
    ASM_SIMP_TAC [POSITIVE_DEFINITE_IMP_POSITIVE_SEMIDEFINITE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"S:real^N^N") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"positive_definite(S ** (B:real^N^N) ** S)") MP_TAC THENL
     [ASM_MESON_TAC [POSITIVE_DEFINITE_SIMILAR, positive_definite,
          symmetric_matrix,
        POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE, INVERTIBLE_MATRIX_MUL],
      ASM_REWRITE_TAC [POSITIVE_DEFINITE_EIGENVALUES]] THEN
    REWRITE_TAC [MATRIX_MUL_ASSOC] THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
    ASM_MESON_TAC [SAME_EIGENVALUES_MATRIX_MUL])

  let POSITIVE_DEFINITE_MUL ← prove
   r"!A:real^N^N B:real^N^N.
        positive_definite A /\ positive_definite B /\ A ** B = B ** A
        ==> positive_definite(A ** B)"
   (SIMP_TAC [POSITIVE_DEFINITE_MUL_EQ])

  let COMMUTING_WITH_SQUARE_ROOT_MATRIX ← prove
   r"!A S B:real^N^N.
        positive_semidefinite S /\ S ** S = A /\ A ** B = B ** A
        ==> S ** B = B ** S"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"S:real^N^N") SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT) THEN
    DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).1)) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [positive_semidefinite], ALL_TAC] THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"Q:real^N^N", ← q r"D:real^N^N"] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    UNDISCH_TAC (← q r"(A:real^N^N) ** (B:real^N^N) = B ** A") THEN
    SUBGOAL_THEN
     (← q r"!C. (C:real^N^N) ** (B:real^N^N) = B ** C <=>
          (Q ** C ** transp(Q:real^N^N)) ** (Q ** B ** transp(Q:real^N^N)) =
          (Q ** B ** transp(Q:real^N^N)) ** (Q ** C ** transp(Q:real^N^N))")
     (fun th => ONCE_REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN EQ_TAC THENL
       [DISCH_THEN (MP_TAC o AP_TERM
          (← q r"\X:real^N^N. Q ** X ** transp(Q:real^N^N)")),
        DISCH_THEN (MP_TAC o AP_TERM
          (← q r"\X:real^N^N. transp(Q:real^N^N) ** X ** Q"))] THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN REPEAT AP_TERM_TAC THEN
      REWRITE_TAC [MATRIX_MUL_ASSOC] THEN REPEAT (AP_THM_TAC THEN AP_TERM_TAC) THEN
      ASM_REWRITE_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_LID, MATRIX_MUL_RID] THEN
      REPEAT (AP_THM_TAC THEN AP_TERM_TAC) THEN
      ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_RID],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(Q:real^N^N) ** (S:real^N^N) ** transp Q = D") ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN REPEAT AP_TERM_TAC THEN
      ASM_REWRITE_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_LID, MATRIX_MUL_RID],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(Q:real^N^N) ** (A:real^N^N) ** transp Q = (D:real^N^N) ** D")
    ASSUME_TAC THENL
     [EXPAND_TAC "A" THEN EXPAND_TAC "D" THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN REPEAT AP_TERM_TAC THEN
      EXPAND_TAC "S" THEN REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
      ASM_REWRITE_TAC [MATRIX_MUL_RID],
      ALL_TAC] THEN
    GEN_REWRITE_TAC BINOP_CONV [EQ_SYM_EQ] THEN
    ASM_SIMP_TAC [COMMUTING_WITH_DIAGONAL_MATRIX, DIAGONAL_MATRIX_MUL] THEN
    ASM_SIMP_TAC [DIAGONAL_MATRIX_MUL_COMPONENT] THEN
    REWRITE_TAC [← REAL_RING (← q r"x * x:real = y * y <=> x = y \/ x = --y")] THEN
    SUBGOAL_THEN (← q r"positive_semidefinite(D:real^N^N)") ASSUME_TAC THENL
     [ASM_MESON_TAC [POSITIVE_SEMIDEFINITE_SIMILAR, TRANSP_TRANSP,
                     ORTHOGONAL_MATRIX_IMP_INVERTIBLE, INVERTIBLE_TRANSP],
      ASM_SIMP_TAC [DIAGONAL_POSITIVE_SEMIDEFINITE, ← REAL_ARITH
       (← q r"&0 <= x /\ &0 <= y ==> (x = y \/ x = --y <=> x = y)")]])

  let POSITIVE_SEMIDEFINITE_MUL_EIGENVALUES ← prove
   r"!A B:real^N^N.
        positive_semidefinite A /\ positive_semidefinite B
        ==> !c v. (A ** B) ** v = c % v /\ ~(v = vec 0) ==> &0 <= c"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE_EQ] THEN STRIP_TAC THEN
    REWRITE_TAC [LEFT_FORALL_IMP_THM] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
    ONCE_REWRITE_TAC [SAME_EIGENVALUES_MATRIX_MUL] THEN
    ONCE_REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
    GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV o BINDER_CONV o
      RAND_CONV o funpow 4 LAND_CONV) [← GSYM TRANSP_TRANSP] THEN
    ONCE_REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
    REWRITE_TAC [TRANSP_TRANSP, ← GSYM MATRIX_MUL_ASSOC] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MESON_TAC [POSITIVE_SEMIDEFINITE_EIGENVALUES,
               POSITIVE_SEMIDEFINITE_COVARIANCE])

  let POSITIVE_SEMIDEFINITE_2_DET ← prove
   r"!A:real^2^2. positive_semidefinite A <=>
                symmetric_matrix A /\
                &0 <= A$1$1 /\ &0 <= A$2$2 /\ &0 <= det A"
   (GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [DIAGONAL_POSITIVE_SEMIDEFINITE, DIMINDEX_2, ARITH] THEN
      MESON_TAC [DET_POSITIVE_SEMIDEFINITE, positive_semidefinite],
      STRIP_TAC THEN ASM_REWRITE_TAC [positive_semidefinite]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [symmetric_matrix]) THEN
    SIMP_TAC [matrix_vector_mul, DOT_2, FORALL_VECTOR_2, VECTOR_2, ARITH,
              LAMBDA_BETA, DIMINDEX_2, SUM_2] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [DET_2]) THEN
    SUBGOAL_THEN (← q r"(A:real^2^2)$2$1 = A$1$2") SUBST1_TAC THENL
     [ASM_MESON_TAC [TRANSP_COMPONENT], REWRITE_TAC [REAL_SUB_LE]] THEN
    ASM_CASES_TAC (← q r"(A:real^2^2)$2$2 = &0") THENL
     [DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x <= a ==> &0 <= x /\ a = &0 ==> x = &0"))) THEN
      ASM_REWRITE_TAC [REAL_LE_SQUARE, REAL_ENTIRE] THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_ADD_RID] THEN
      GEN_TAC THEN ONCE_REWRITE_TAC [← REAL_ARITH (← q r"y * a * y:real = a * y * y")] THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_LE_SQUARE],
      DISCH_TAC] THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC REAL_LE_LCANCEL_IMP THEN
    EXISTS_TAC (← q r"(A:real^2^2)$2$2") THEN
    ASM_REWRITE_TAC [REAL_MUL_RZERO, REAL_LT_LE] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"c * (x * (a * x + b * y) + y * (b * x + c * y)) =
      (b * x + c * y) pow 2 + (a * c - b pow 2) * x pow 2")] THEN
    MATCH_MP_TAC REAL_LE_ADD THEN REWRITE_TAC [REAL_LE_POW_2] THEN
    MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [REAL_LE_POW_2] THEN
    ASM_REAL_ARITH_TAC)

  let POSITIVE_SEMIDEFINITE_2 ← prove
   r"!A:real^2^2. positive_semidefinite A <=>
                A$2$1 = A$1$2 /\
                &0 <= A$1$1 /\ &0 <= A$2$2 /\ A$1$2 pow 2 <= A$1$1 * A$2$2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [POSITIVE_SEMIDEFINITE_2_DET, DET_2] THEN
    REWRITE_TAC [symmetric_matrix] THEN
    SIMP_TAC [CART_EQ, FORALL_2, TRANSP_COMPONENT, DIMINDEX_2] THEN
    ASM_CASES_TAC (← q r"(A:real^2^2)$2$1 = A$1$2") THEN
    ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let POSITIVE_DEFINITE_2_DET ← prove
   r"!A:real^2^2. positive_definite A <=>
                symmetric_matrix A /\ &0 < A$1$1 /\ &0 < A$2$2 /\ &0 < det A"
   (GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [DIAGONAL_POSITIVE_DEFINITE, DIMINDEX_2, ARITH] THEN
      MESON_TAC [DET_POSITIVE_DEFINITE, positive_definite],
      STRIP_TAC THEN ASM_SIMP_TAC [POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE]] THEN
    ASM_REWRITE_TAC [POSITIVE_SEMIDEFINITE_2_DET, INVERTIBLE_DET_NZ] THEN
    ASM_SIMP_TAC [REAL_LT_IMP_NZ, REAL_LT_IMP_LE])

  let POSITIVE_DEFINITE_2 ← prove
   r"!A:real^2^2. positive_definite A <=>
                A$2$1 = A$1$2 /\
                &0 < A$1$1 /\ &0 < A$2$2 /\ A$1$2 pow 2 < A$1$1 * A$2$2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [POSITIVE_DEFINITE_2_DET, DET_2] THEN
    REWRITE_TAC [symmetric_matrix] THEN
    SIMP_TAC [CART_EQ, FORALL_2, TRANSP_COMPONENT, DIMINDEX_2] THEN
    ASM_CASES_TAC (← q r"(A:real^2^2)$2$1 = A$1$2") THEN
    ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)

  return { POSITIVE_SEMIDEFINITE_MUL_EQ, POSITIVE_SEMIDEFINITE_MUL, POSITIVE_DEFINITE_MUL_EQ,
           POSITIVE_DEFINITE_MUL, COMMUTING_WITH_SQUARE_ROOT_MATRIX,
           POSITIVE_SEMIDEFINITE_MUL_EIGENVALUES, POSITIVE_SEMIDEFINITE_2_DET,
           POSITIVE_SEMIDEFINITE_2, POSITIVE_DEFINITE_2_DET, POSITIVE_DEFINITE_2 }

/- ------------------------------------------------------------------------- -/
/- Determinant and operator norm bounds.  (topology.ml 21100-21350)          -/
/- ------------------------------------------------------------------------- -/

structure ODT where
  REAL_LE_NORM_MATRIX_MUL_DET : thm
  DET_LE_ONORM_POW : thm
  ONORM_INVERSE_DET_LE_ONORM_POW : thm
  ONORM_INVERSE_DET_LE_ONORM_POW_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupODT [HolBase] (D : TopologyDeps) (BDIG : DIG) : ExceptT String IO ODT := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, NORM_ARITH, .. } := D
  let { CARD_DELETE, CARD_NUMSEG_1, DIMINDEX_GE_1, EXISTS_IN_IMAGE, FINITE_DELETE, FINITE_IMAGE,
        FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, INF_FINITE, INF_LE_ELEMENT,
        IN_DELETE, IN_IMAGE, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MULT_SYM, NOT_LT, NUMSEG_EMPTY,
        REAL_ABS_DIV, REAL_ABS_INV, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_NZ, REAL_ABS_POS, .. } :=
    D.core3
  let { REAL_EQ_IMP_LE, REAL_LE_ANTISYM, REAL_LE_INV2, REAL_LE_LDIV_EQ, REAL_LE_LMUL,
        REAL_LE_RCANCEL_IMP, REAL_LE_REFL, REAL_LE_SQUARE_ABS, REAL_LE_SUP_FINITE,
        REAL_LE_TRANS, REAL_LT_INF_FINITE, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_RID, REAL_MUL_SYM, REAL_POW_2, REAL_POW_LE, REAL_POW_MUL,
        REAL_POW_ONE, REAL_POW_POW, REAL_SUP_LE, SIMPLE_IMAGE, .. } := D.core5
  let { o_DEF, real_abs, real_div, .. } := D.core6
  let { PRODUCT_ABS, PRODUCT_CONST, PRODUCT_DELETE, PRODUCT_LE, PRODUCT_LE_1, .. } := D.lib2
  let { COMPONENT_LE_NORM, DOT_MATRIX_TRANSP_LMUL, .. } := D.vec1
  let { INVERTIBLE_TRANSP, LINEAR_INVERSE_LEFT, MATRIX_COMPOSE, MATRIX_I, MATRIX_INVERTIBLE,
        MATRIX_INV_TRANSP, MATRIX_INV_UNIQUE, MATRIX_MUL_ASSOC, MATRIX_MUL_RID,
        MATRIX_OF_MATRIX_VECTOR_MUL, MATRIX_TRANSP_MUL, .. } := D.vec2
  let { MATRIX_VECTOR_LMUL, MATRIX_VECTOR_MUL, MATRIX_VECTOR_MUL_ASSOC, MATRIX_VECTOR_MUL_BASIS,
        MATRIX_VECTOR_MUL_LID, MATRIX_VECTOR_MUL_LINEAR, NORM_0, NORM_BASIS,
        NORM_CAUCHY_SCHWARZ, NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_POW_2, ONORM,
        ONORM_COVARIANCE, ONORM_COVARIANCE_ALT, ONORM_POS_LE, .. } := D.vec3
  let { TRANSP_TRANSP, column, symmetric_matrix, .. } := D.vec4
  let { DET_0, DET_CMUL, DET_DIAGONAL, DET_I, DET_MATRIX_INV, DET_MUL, DET_TRANSP,
        DIAGONAL_MATRIX_INV, DIAGONAL_MATRIX_INV_EXPLICIT, HOMOGENEOUS_LINEAR_EQUATIONS_DET,
        INVERTIBLE_DIAGONAL_MATRIX, INVERTIBLE_MATRIX_MUL, MATRIX_INV_MUL, MATRIX_MUL_RINV,
        ONORM_COMPOSE_ORTHOGONAL_TRANSFORMATION_LEFT,
        ONORM_COMPOSE_ORTHOGONAL_TRANSFORMATION_RIGHT, ONORM_DIAGONAL_MATRIX,
        ORTHOGONAL_MATRIX_INV_EQ, ORTHOGONAL_MATRIX_NORM, ORTHOGONAL_MATRIX_TRANSFORMATION,
        ORTHOGONAL_MATRIX_TRANSP, POSITIVE_SEMIDEFINITE_COVARIANCE,
        POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC_MATRIX, orthogonal_matrix, .. } := D.det
  let { SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, .. } := BDIG
  -- @@SCOPE END

  let REAL_LE_NORM_MATRIX_MUL_DET ← prove
   r"!A B:real^N^N.
        (!x. norm(A ** x) <= norm(B ** x)) ==> abs(det A) <= abs(det B)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"det(B:real^N^N) = &0") THENL
     [ASM_REWRITE_TAC [DET_0, ← REAL_ARITH (← q r"abs x <= abs(&0) <=> x = &0")] THEN
      REWRITE_TAC [← GSYM HOMOGENEOUS_LINEAR_EQUATIONS_DET] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [← GSYM HOMOGENEOUS_LINEAR_EQUATIONS_DET]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [← NORM_ARITH (← q r"norm(x:real^N) <= &0 <=> x = vec 0"), NORM_0],
      ALL_TAC] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, ← GSYM REAL_ABS_NZ, ← GSYM REAL_ABS_DIV] THEN
    REWRITE_TAC [real_div, ← GSYM DET_MATRIX_INV, ← GSYM DET_MUL] THEN
    SUBGOAL_THEN
     (← q r"!x:real^N. norm(((A:real^N^N) ** matrix_inv B) ** x) <= norm(x)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"norm(B ** matrix_inv(B:real^N^N) ** (x:real^N))") THEN
      ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [MATRIX_VECTOR_MUL_ASSOC, MATRIX_MUL_RINV] THEN
      REWRITE_TAC [MATRIX_VECTOR_MUL_LID, REAL_LE_REFL],
      POP_ASSUM_LIST (K ALL_TAC) THEN
      SPEC_TAC (← q r"(A:real^N^N) ** matrix_inv(B:real^N^N)", ← q r"A:real^N^N")] THEN
    REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_ABS_NUM] THEN
    REWRITE_TAC [REAL_LE_SQUARE_ABS] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"det(transp(A:real^N^N) ** A)") THEN CONJ_TAC THENL
     [REWRITE_TAC [DET_MUL, DET_TRANSP] THEN REAL_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. norm(transp A ** (A:real^N^N) ** x) <= norm(x)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"y:real^N") THEN
      TRANS_TAC REAL_LE_TRANS (← q r"norm((A:real^N^N) ** (y:real^N))") THEN
      ASM_REWRITE_TAC [] THEN
      SPEC_TAC (← q r"(A:real^N^N) ** (y:real^N)", ← q r"x:real^N") THEN GEN_TAC THEN
      ASM_CASES_TAC (← q r"transp(A:real^N^N) ** x = vec 0") THEN
      ASM_REWRITE_TAC [NORM_0, NORM_POS_LE] THEN
      MATCH_MP_TAC REAL_LE_RCANCEL_IMP THEN
      EXISTS_TAC (← q r"norm(transp(A:real^N^N) ** x)") THEN
      ASM_REWRITE_TAC [NORM_POS_LT, NORM_POW_2, ← GSYM REAL_POW_2] THEN
      REWRITE_TAC [DOT_MATRIX_TRANSP_LMUL] THEN
      W (MP_TAC o PART_MATCH lhand NORM_CAUCHY_SCHWARZ o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REWRITE_TAC [NORM_POS_LE],
      REWRITE_TAC [MATRIX_VECTOR_MUL_ASSOC, REAL_POW_ONE] THEN
      MP_TAC (← ISPEC (← q r"A:real^N^N") POSITIVE_SEMIDEFINITE_COVARIANCE) THEN
      POP_ASSUM (K ALL_TAC : thm → tactic) THEN
      SPEC_TAC (← q r"transp(A:real^N^N) ** A", ← q r"A:real^N^N")] THEN
    GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP
      POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC_MATRIX) THEN
    REWRITE_TAC [SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"Q:real^N^N", ← q r"D:real^N^N"] THEN
    STRIP_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [DET_MUL] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a * b * c:real = (a * c) * b")] THEN
    ONCE_REWRITE_TAC [← GSYM DET_MUL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
    ASM_REWRITE_TAC [DET_I, REAL_MUL_LID] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"abs x <= &1 ==> x <= &1")) THEN
    ASM_SIMP_TAC [DET_DIAGONAL, ← GSYM PRODUCT_ABS, FINITE_NUMSEG] THEN
    MATCH_MP_TAC PRODUCT_LE_1 THEN REWRITE_TAC [FINITE_NUMSEG] THEN
    X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [IN_NUMSEG, REAL_ABS_POS] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"transp(Q:real^N^N) ** basis k")) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM orthogonal_matrix]) THEN
    ASM_SIMP_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC, NORM_BASIS,
                  ORTHOGONAL_MATRIX_NORM, ORTHOGONAL_MATRIX_TRANSP] THEN
    REWRITE_TAC [MATRIX_VECTOR_MUL_ASSOC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
    ASM_SIMP_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_RID] THEN
    ASM_SIMP_TAC [MATRIX_VECTOR_MUL_BASIS] THEN
    MP_TAC (← ISPECL [← q r"column k (D:real^N^N)", ← q r"k:num"] COMPONENT_LE_NORM) THEN
    ASM_SIMP_TAC [column, LAMBDA_BETA] THEN REAL_ARITH_TAC)

  let DET_LE_ONORM_POW ← prove
   r"!A:real^N^N. abs(det A) <= onorm(\x. A ** x) pow (dimindex(:N))"
   (REPEAT GEN_TAC THEN TRANS_TAC REAL_LE_TRANS
     (← q r"abs(det(onorm(\x. (A:real^N^N) ** x) %% mat 1:real^N^N))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_LE_NORM_MATRIX_MUL_DET THEN
      REWRITE_TAC [MATRIX_VECTOR_LMUL, NORM_MUL, MATRIX_VECTOR_MUL_LID] THEN
      MP_TAC (← ISPEC (← q r"\x. (A:real^N^N) ** x") ONORM) THEN
      SIMP_TAC [MATRIX_OF_MATRIX_VECTOR_MUL, MATRIX_VECTOR_MUL_LINEAR, real_abs,
                ONORM_POS_LE],
      REWRITE_TAC [DET_CMUL, DET_I, REAL_MUL_RID, REAL_LE_REFL] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x ==> abs x <= x")) THEN
      SIMP_TAC [REAL_POW_LE, ONORM_POS_LE, MATRIX_VECTOR_MUL_LINEAR]])

  let ONORM_INVERSE_DET_LE_ONORM_POW ← prove
   r"!A:real^N^N.
        invertible A
        ==> onorm(\x. matrix_inv A ** x) * det A
            <= onorm(\x. A ** x) pow (dimindex(:N) - 1)"
   (SUBGOAL_THEN
     (← q r"!A:real^N^N.
          invertible A /\ transp A = A
          ==> onorm(\x. matrix_inv A ** x) * det A
              <= onorm(\x. A ** x) pow (dimindex(:N) - 1)")
    ASSUME_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"transp(A:real^N^N) ** A")) THEN
      ASM_REWRITE_TAC [INVERTIBLE_MATRIX_MUL, INVERTIBLE_TRANSP] THEN
      REWRITE_TAC [MATRIX_TRANSP_MUL, TRANSP_TRANSP] THEN
      ASM_SIMP_TAC [MATRIX_INV_MUL, INVERTIBLE_TRANSP, MATRIX_INV_TRANSP] THEN
      REWRITE_TAC [ONORM_COVARIANCE_ALT] THEN
      REWRITE_TAC [ONORM_COVARIANCE, DET_MUL, DET_TRANSP] THEN
      REWRITE_TAC [← GSYM REAL_POW_2, ← GSYM REAL_POW_MUL, REAL_POW_POW] THEN
      ONCE_REWRITE_TAC [MULT_SYM] THEN REWRITE_TAC [← GSYM REAL_POW_POW] THEN
      REWRITE_TAC [← GSYM REAL_LE_SQUARE_ABS] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= y ==> abs x <= abs y ==> x <= y")) THEN
      MATCH_MP_TAC REAL_POW_LE THEN MATCH_MP_TAC ONORM_POS_LE THEN
      REWRITE_TAC [MATRIX_VECTOR_MUL_LINEAR]] THEN
    REWRITE_TAC [← GSYM symmetric_matrix] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
     [SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"Q:real^N^N", ← q r"D:real^N^N"] THEN
    STRIP_TAC THEN UNDISCH_TAC (← q r"invertible(A:real^N^N)") THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    REWRITE_TAC [INVERTIBLE_MATRIX_MUL, INVERTIBLE_TRANSP] THEN STRIP_TAC THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"onorm(\x. matrix_inv(D:real^N^N) ** x) * det(D)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_EQ_IMP_LE THEN BINOP_TAC THENL
       [ASM_SIMP_TAC [MATRIX_INV_MUL, INVERTIBLE_MATRIX_MUL, INVERTIBLE_TRANSP,
                      ← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN
        MP_TAC (← ISPECL
         [← q r"\x:real^N. matrix_inv(Q:real^N^N) ** x",
          ← q r"\x:real^N. matrix_inv(D:real^N^N) **
                      matrix_inv(transp Q:real^N^N) ** x"]
         ONORM_COMPOSE_ORTHOGONAL_TRANSFORMATION_LEFT) THEN
        ASM_REWRITE_TAC [← GSYM ORTHOGONAL_MATRIX_TRANSFORMATION, o_DEF] THEN
        ASM_REWRITE_TAC [ORTHOGONAL_MATRIX_INV_EQ] THEN DISCH_THEN SUBST1_TAC THEN
        MP_TAC (← ISPECL
         [← q r"\x:real^N. matrix_inv(D:real^N^N) ** x",
          ← q r"\x:real^N. matrix_inv(transp Q:real^N^N) ** x"]
         ONORM_COMPOSE_ORTHOGONAL_TRANSFORMATION_RIGHT) THEN
        REWRITE_TAC [o_DEF] THEN DISCH_THEN MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [← GSYM ORTHOGONAL_MATRIX_TRANSFORMATION] THEN
        ASM_REWRITE_TAC [ORTHOGONAL_MATRIX_INV_EQ, ORTHOGONAL_MATRIX_TRANSP],
        REWRITE_TAC [DET_MUL] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"q' * d * q:real = (q' * q) * d")] THEN
        ONCE_REWRITE_TAC [← GSYM DET_MUL] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
        ASM_REWRITE_TAC [DET_I, REAL_MUL_LID]],
      ALL_TAC] THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"onorm(\x. (D:real^N^N) ** x) pow (dimindex(:N) - 1)") THEN
    CONJ_TAC THENL
     [(← do
        let Qt ← q r"Q:real^N^N"
        pure (REPEAT (FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o
                check (HolCore.Basics.free_in Qt o concl))))),
      MATCH_MP_TAC (← REAL_ARITH (← q r"y:real = x ==> x <= y")) THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [← GSYM MATRIX_VECTOR_MUL_ASSOC] THEN
      MP_TAC (← ISPECL
       [← q r"\x:real^N. transp(Q:real^N^N) ** x",
        ← q r"\x:real^N. (D:real^N^N) ** (Q:real^N^N) ** x"]
       ONORM_COMPOSE_ORTHOGONAL_TRANSFORMATION_LEFT) THEN
      ASM_REWRITE_TAC [← GSYM ORTHOGONAL_MATRIX_TRANSFORMATION, o_DEF] THEN
      ASM_REWRITE_TAC [ORTHOGONAL_MATRIX_TRANSP] THEN DISCH_THEN SUBST1_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\x:real^N. (D:real^N^N) ** x",
        ← q r"\x:real^N. (Q:real^N^N) ** x"]
       ONORM_COMPOSE_ORTHOGONAL_TRANSFORMATION_RIGHT) THEN
      REWRITE_TAC [o_DEF] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [← GSYM ORTHOGONAL_MATRIX_TRANSFORMATION]] THEN
    ASM_SIMP_TAC [ONORM_DIAGONAL_MATRIX, DET_DIAGONAL, DIAGONAL_MATRIX_INV] THEN
    MP_TAC (← ISPEC (← q r"D:real^N^N") INVERTIBLE_DIAGONAL_MATRIX) THEN
    ASM_REWRITE_TAC [← GSYM IN_NUMSEG] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"sup {abs((matrix_inv D:real^N^N)$i$i) | i IN 1..dimindex (:N)} =
      inv (inf {abs(D$i$i) | i IN 1..dimindex (:N)})")
    SUBST1_TAC THENL
     [ASM_SIMP_TAC [DIAGONAL_MATRIX_INV_EXPLICIT] THEN
      REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_SUP_LE THEN
        REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
        REWRITE_TAC [NUMSEG_EMPTY, NOT_LT, DIMINDEX_GE_1] THEN
        SIMP_TAC [LAMBDA_BETA, IN_NUMSEG] THEN X_GEN_TAC (← q r"i:num") THEN
        STRIP_TAC THEN REWRITE_TAC [REAL_ABS_INV] THEN
        MATCH_MP_TAC REAL_LE_INV2 THEN
        SIMP_TAC [REAL_LT_INF_FINITE, FINITE_NUMSEG, NUMSEG_EMPTY,
                  NOT_LT, DIMINDEX_GE_1, IMAGE_EQ_EMPTY, FINITE_IMAGE] THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE, IN_NUMSEG, ← GSYM REAL_ABS_NZ] THEN
        ASM_REWRITE_TAC [← GSYM IN_NUMSEG] THEN
        MATCH_MP_TAC INF_LE_ELEMENT THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
        CONJ_TAC THENL [MESON_TAC [REAL_ABS_POS], ALL_TAC] THEN
        REWRITE_TAC [IN_IMAGE, IN_NUMSEG] THEN ASM_MESON_TAC [],
        MP_TAC (← ISPEC (← q r"IMAGE (\i. abs((D:real^N^N)$i$i)) (1..dimindex(:N))")
          INF_FINITE) THEN
        SIMP_TAC [SIMPLE_IMAGE, REAL_LE_SUP_FINITE, FINITE_NUMSEG, NUMSEG_EMPTY,
                  NOT_LT, DIMINDEX_GE_1, IMAGE_EQ_EMPTY, FINITE_IMAGE] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
        REWRITE_TAC [IN_IMAGE] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"i:num") THEN SIMP_TAC [IN_NUMSEG, LAMBDA_BETA] THEN
        REWRITE_TAC [REAL_ABS_INV, REAL_LE_REFL]],
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) REAL_LE_LDIV_EQ o snd) THEN
      SIMP_TAC [SIMPLE_IMAGE, REAL_LT_INF_FINITE, FINITE_NUMSEG, NUMSEG_EMPTY,
                NOT_LT, DIMINDEX_GE_1, IMAGE_EQ_EMPTY, FINITE_IMAGE] THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE, ← GSYM REAL_ABS_NZ] THEN
      DISCH_THEN SUBST1_TAC] THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\i. abs((D:real^N^N)$i$i)) (1..dimindex(:N))")
      INF_FINITE) THEN
    SIMP_TAC [SIMPLE_IMAGE, REAL_LE_SUP_FINITE, FINITE_NUMSEG, NUMSEG_EMPTY,
              NOT_LT, DIMINDEX_GE_1, IMAGE_EQ_EMPTY, FINITE_IMAGE] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"\i. (D:real^N^N)$i$i", ← q r"1..dimindex(:N)", ← q r"n:num"]
          PRODUCT_DELETE) THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"abs(x) <= a * b ==> x <= b * a")) THEN
    REWRITE_TAC [REAL_ABS_MUL] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
    SIMP_TAC [← GSYM PRODUCT_ABS, REAL_ABS_POS, FINITE_NUMSEG, FINITE_DELETE] THEN
    SUBGOAL_THEN (← q r"dimindex(:N) - 1 = CARD((1..dimindex(:N)) DELETE n)")
    SUBST1_TAC THENL
     [ASM_SIMP_TAC [CARD_DELETE, FINITE_NUMSEG, CARD_NUMSEG_1],
      SIMP_TAC [← GSYM PRODUCT_CONST, FINITE_DELETE, FINITE_NUMSEG]] THEN
    MATCH_MP_TAC PRODUCT_LE THEN
    REWRITE_TAC [FINITE_DELETE, FINITE_NUMSEG, IN_DELETE] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN REWRITE_TAC [REAL_ABS_POS] THEN
    SIMP_TAC [REAL_LE_SUP_FINITE, FINITE_NUMSEG, NUMSEG_EMPTY,
              NOT_LT, DIMINDEX_GE_1, IMAGE_EQ_EMPTY, FINITE_IMAGE] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE] THEN EXISTS_TAC (← q r"i:num") THEN
    ASM_REWRITE_TAC [REAL_LE_REFL])

  let ONORM_INVERSE_DET_LE_ONORM_POW_ALT ← prove
   r"!f g:real^N->real^N.
        linear f /\ linear g /\ f o g = I
        ==> onorm f * det(matrix g) <= onorm g pow (dimindex(:N) - 1)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(g:real^N->real^N) o f = I") ASSUME_TAC THENL
     [ASM_MESON_TAC [LINEAR_INVERSE_LEFT], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"matrix(g:real^N->real^N)")
        ONORM_INVERSE_DET_LE_ONORM_POW) THEN
    ASM_SIMP_TAC [← GSYM MATRIX_VECTOR_MUL, MATRIX_INVERTIBLE] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    AP_TERM_TAC THEN MP_TAC (← ISPEC (← q r"f:real^N->real^N") MATRIX_VECTOR_MUL) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    ABS_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC MATRIX_INV_UNIQUE THEN
    ASM_SIMP_TAC [← GSYM MATRIX_COMPOSE, MATRIX_I])

  return { REAL_LE_NORM_MATRIX_MUL_DET, DET_LE_ONORM_POW, ONORM_INVERSE_DET_LE_ONORM_POW,
           ONORM_INVERSE_DET_LE_ONORM_POW_ALT }

/- ------------------------------------------------------------------------- -/
/- Hadamard inequality, nearby and Hadamard products of definite matrices.   -/
/- (topology.ml 21351-21530)                                                 -/
/- ------------------------------------------------------------------------- -/

structure PSN where
  HADAMARD_INEQUALITY_PSD : thm
  POSITIVE_DEFINITE_NEARBY : thm
  POSITIVE_DEFINITE_EQ_CONGRUENT_IDENTITY : thm
  POSITIVE_DEFINITE_EQ_CONGRUENT_IDENTITY_ALT : thm
  POSITIVE_DEFINITE_EVENTUALLY : thm
  POSITIVE_SEMIDEFINITE_HADAMARD_PRODUCT : thm
  POSITIVE_DEFINITE_HADAMARD_PRODUCT : thm
  deriving Inhabited

@[nospecialize]
def setupPSN [HolBase] (D : TopologyDeps) (BSAE : SAE) (BGDR1 : GDR1) (BPSC : PSC) (BPSS : PSS) :
    ExceptT String IO PSN := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, .. } := D
  let { AND_FORALL_THM, ARITH_EQ, CART_EQ, COND_RAND, COND_RATOR, CONTRAPOS_THM, EQ_SYM_EQ, .. } :=
    D.core1
  let { FORALL_UNWIND_THM1, IMP_CONJ_ALT, INF_FINITE, IN_ELIM_THM, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS,
        REAL_ABS_ABS, REAL_ABS_MUL, .. } := D.core3
  let { REAL_EQ_IMP_LE, REAL_LET_TRANS, REAL_LE_LMUL, REAL_LE_SQUARE_ABS, REAL_LE_TRANS,
        REAL_LTE_TRANS, REAL_LT_LMUL_EQ, REAL_LT_RMUL_EQ, .. } := D.core4
  let { REAL_MUL_AC, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_OF_NUM_EQ, REAL_POW_2,
        RIGHT_IMP_FORALL_THM, .. } := D.core5
  let { SUM_DELTA, SUM_EQ_NUMSEG, SUM_LMUL, SUM_RMUL, SUM_SWAP_NUMSEG, SWAP_EXISTS_THM, .. } :=
    D.core6
  let { PRODUCT_EQ_NUMSEG, PRODUCT_MUL_NUMSEG, .. } := D.lib2
  let { ADJOINT_MATRIX, DOT_RADD, DOT_RMUL, .. } := D.vec1
  let { INVERTIBLE_MATRIX_INV, INVERTIBLE_TRANSP, MATRIX_ADD_ASSOC, MATRIX_ADD_LNEG,
        MATRIX_ADD_RID, MATRIX_ENTIRE, MATRIX_INV, MATRIX_MUL_ASSOC, MATRIX_MUL_COMPONENT,
        MATRIX_MUL_LID, MATRIX_MUL_RID, MATRIX_SUB, MATRIX_TRANSP_MUL, .. } := D.vec2
  let { MATRIX_VECTOR_LMUL, MATRIX_VECTOR_MUL_ADD_RDISTRIB, MATRIX_VECTOR_MUL_COMPONENT,
        MATRIX_VECTOR_MUL_LID, MATRIX_VECTOR_MUL_LINEAR, MAT_COMPONENT, NORM_0,
        NORM_CAUCHY_SCHWARZ_ABS, NORM_POS_LE, NORM_POS_LT, NORM_POW_2, ONORM, ROW_MATRIX_MUL,
        TRANSP_COMPONENT, TRANSP_MAT, TRANSP_MATRIX_ADD, .. } := D.vec3
  let { TRANSP_MATRIX_CMUL, TRANSP_MATRIX_INV, VEC_COMPONENT, column, dot, matrix_vector_mul,
        symmetric_matrix, transp, .. } := D.vec4
  let { DET_MUL, DET_TRANSP, FINITE_EIGENVALUES, HADAMARD_INEQUALITY_COLUMN,
        INVERTIBLE_MATRIX_MUL, POSITIVE_DEFINITE_ID, POSITIVE_DEFINITE_IMP_INVERTIBLE,
        POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE, POSITIVE_DEFINITE_SIMILAR_EQ,
        TRACE_COVARIANCE_POS_LE, TRACE_COVARIANCE_POS_LT, TRACE_MUL_SYM, positive_definite,
        positive_semidefinite, trace, .. } := D.det
  let { EIGENVALUE_LOWERBOUND_DOT, SELF_ADJOINT_HAS_EIGENVECTOR, .. } := BSAE
  let { POSITIVE_DEFINITE_EIGENVALUES, .. } := BGDR1
  let { POSITIVE_SEMIDEFINITE_COVARIANCE_EQ, .. } := BPSC
  let { POSITIVE_DEFINITE_COVARIANCE_EQ, POSITIVE_SEMIDEFINITE_SQRT_EQ, .. } := BPSS
  -- @@SCOPE END

  let HADAMARD_INEQUALITY_PSD ← prove
   r"!A:real^N^N.
    positive_semidefinite A ==> det A <= product(1..dimindex(:N)) (\i. A$i$i)"
   (SIMP_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE_EQ, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"B:real^N^N", ← q r"A:real^N^N"] THEN
    DISCH_THEN SUBST1_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"abs x <= a ==> x <= a")) THEN
    REWRITE_TAC [DET_MUL, DET_TRANSP, REAL_ABS_MUL] THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"product(1..dimindex(:N)) (\i. norm(column i (A:real^N^N))) pow 2") THEN
    REWRITE_TAC [← GSYM REAL_POW_2, ← GSYM REAL_LE_SQUARE_ABS, REAL_ABS_ABS] THEN
    SIMP_TAC [HADAMARD_INEQUALITY_COLUMN, ← REAL_ARITH (← q r"x <= y ==> x <= abs y")] THEN
    REWRITE_TAC [← GSYM PRODUCT_MUL_NUMSEG, REAL_POW_2] THEN
    MATCH_MP_TAC REAL_EQ_IMP_LE THEN REWRITE_TAC [← GSYM REAL_POW_2] THEN
    MATCH_MP_TAC PRODUCT_EQ_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN
    STRIP_TAC THEN ASM_SIMP_TAC [ROW_MATRIX_MUL, MATRIX_MUL_COMPONENT] THEN
    REWRITE_TAC [NORM_POW_2, dot, matrix_vector_mul, transp, column] THEN
    ASM_SIMP_TAC [LAMBDA_BETA])

  let POSITIVE_DEFINITE_NEARBY ← prove
   r"!A:real^N^N.
        positive_definite A
        ==> ?e. &0 < e /\
                !B. symmetric_matrix B /\ onorm(\x. (B - A) ** x) < e
                    ==> positive_definite B"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"{c | ?v. ~(v = vec 0) /\ (A:real^N^N) ** v = c % v}")
          INF_FINITE) THEN
    REWRITE_TAC [FINITE_EIGENVALUES] THEN ANTS_TAC THENL
     [MP_TAC (← ISPEC (← q r"\x:real^N. (A:real^N^N) ** x")
       SELF_ADJOINT_HAS_EIGENVECTOR) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [positive_definite, symmetric_matrix]) THEN
      ASM_REWRITE_TAC [ADJOINT_MATRIX, MATRIX_VECTOR_MUL_LINEAR] THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      MATCH_MP_TAC MONO_AND THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      SIMP_TAC [NORM_0, REAL_OF_NUM_EQ, ARITH_EQ],
      ABBREV_TAC
       (← q r"a = inf {c | ?v. ~(v = vec 0) /\ (A:real^N^N) ** v = c % v}") THEN
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SYM) THEN
      REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN STRIP_TAC] THEN
    EXISTS_TAC (← q r"a:real") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [POSITIVE_DEFINITE_EIGENVALUES], ALL_TAC] THEN
    X_GEN_TAC (← q r"B:real^N^N") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [positive_definite] THEN X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"B:real^N^N = (B - A) + A") SUBST1_TAC THENL
     [REWRITE_TAC [MATRIX_SUB, ← GSYM MATRIX_ADD_ASSOC, MATRIX_ADD_LNEG] THEN
      REWRITE_TAC [MATRIX_ADD_RID],
      REWRITE_TAC [MATRIX_VECTOR_MUL_ADD_RDISTRIB, DOT_RADD]] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"!b. abs x < b /\ b <= y ==> &0 < x + y")) THEN
    EXISTS_TAC (← q r"a * norm(x:real^N) pow 2") THEN CONJ_TAC THENL
     [W (MP_TAC o PART_MATCH lhand NORM_CAUCHY_SCHWARZ_ABS o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
      ONCE_REWRITE_TAC [← REAL_ARITH (← q r"(a:real) * x pow 2 = x * a * x")] THEN
      ASM_SIMP_TAC [REAL_LT_LMUL_EQ, NORM_POS_LT] THEN TRANS_TAC REAL_LET_TRANS
       (← q r"onorm(\x. (B - A:real^N^N) ** x) * norm(x:real^N)") THEN
      SIMP_TAC [ONORM, MATRIX_VECTOR_MUL_LINEAR] THEN
      ASM_SIMP_TAC [REAL_LT_RMUL_EQ, NORM_POS_LT],
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM]
        EIGENVALUE_LOWERBOUND_DOT) THEN
      ASM_MESON_TAC [positive_definite]])

  let (POSITIVE_DEFINITE_EQ_CONGRUENT_IDENTITY,
       POSITIVE_DEFINITE_EQ_CONGRUENT_IDENTITY_ALT) ← CONJ_PAIR (← prove
   r"(!A:real^N^N.
        positive_definite A <=> ?B:real^N^N. transp B ** A ** B = mat 1) /\
   (!A:real^N^N.
        positive_definite A <=>
        ?B:real^N^N. invertible B /\ transp B ** A ** B = mat 1)"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(r ==> q) /\ (p ==> r) /\ (q ==> p) ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [],
      ONCE_REWRITE_TAC [POSITIVE_DEFINITE_COVARIANCE_EQ] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real^N^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"matrix_inv(B:real^N^N)") THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_INV, MATRIX_MUL_RID] THEN
      SIMP_TAC [TRANSP_MATRIX_INV, MATRIX_MUL_ASSOC, INVERTIBLE_MATRIX_INV] THEN
      ASM_SIMP_TAC [MATRIX_INV, INVERTIBLE_TRANSP, MATRIX_MUL_LID],
      DISCH_THEN (CHOOSE_THEN MP_TAC) THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"positive_definite:real^N^N->bool")) THEN
      SIMP_TAC [POSITIVE_DEFINITE_SIMILAR_EQ, POSITIVE_DEFINITE_ID]]))

  let POSITIVE_DEFINITE_EVENTUALLY ← prove
   r"!A:real^N^N.
        symmetric_matrix A
        ==> ?a. !x. a <= x ==> positive_definite(A + x %% mat 1)"
   (REWRITE_TAC [symmetric_matrix] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"onorm(\x. (A:real^N^N) ** x) + &1") THEN
    X_GEN_TAC (← q r"a:real") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [TRANSP_MATRIX_ADD, positive_definite, TRANSP_MATRIX_CMUL,
                  TRANSP_MAT, MATRIX_VECTOR_MUL_ADD_RDISTRIB, DOT_RADD,
                  symmetric_matrix,
                  MATRIX_VECTOR_LMUL, DOT_RMUL, MATRIX_VECTOR_MUL_LID] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"abs(x) < y ==> &0 < x + y")) THEN
    W (MP_TAC o PART_MATCH lhand NORM_CAUCHY_SCHWARZ_ABS o lhand o snd) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
    TRANS_TAC REAL_LET_TRANS
     (← q r"norm(x:real^N) * onorm(\y. (A:real^N^N) ** y) * norm(x)") THEN
    SIMP_TAC [REAL_LE_LMUL, NORM_POS_LE, ONORM, MATRIX_VECTOR_MUL_LINEAR] THEN
    SIMP_TAC [← GSYM NORM_POW_2, ← REAL_ARITH (← q r"(a:real) * x pow 2 = x * a * x")] THEN
    ASM_SIMP_TAC [REAL_LT_LMUL_EQ, REAL_LT_RMUL_EQ, NORM_POS_LT] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"a + &1 <= x ==> a < x")])

  let (POSITIVE_SEMIDEFINITE_HADAMARD_PRODUCT, POSITIVE_DEFINITE_HADAMARD_PRODUCT) ←
    CONJ_PAIR (← prove
   r"(!A:real^N^N B:real^N^N.
        positive_semidefinite A /\ positive_semidefinite B
        ==> positive_semidefinite((lambda i j. A$i$j * B$i$j):real^N^N)) /\
   (!A:real^N^N B:real^N^N.
        positive_definite A /\ positive_definite B
        ==> positive_definite((lambda i j. A$i$j * B$i$j):real^N^N))"
   (REPEAT STRIP_TAC THEN
    (SUBGOAL_THEN (← q r"transp(A:real^N^N) = A /\ transp(B:real^N^N) = B")
     STRIP_ASSUME_TAC THENL
      [ASM_MESON_TAC [positive_semidefinite, positive_definite, symmetric_matrix],
       REWRITE_TAC [positive_semidefinite, positive_definite,
                    symmetric_matrix]] THEN
     CONJ_TAC THENL
      [SIMP_TAC [CART_EQ, TRANSP_COMPONENT, LAMBDA_BETA] THEN
       REPEAT STRIP_TAC THEN BINOP_TAC THEN
       ASM_MESON_TAC [TRANSP_COMPONENT],
       ALL_TAC] THEN
     X_GEN_TAC (← q r"x:real^N") THEN REPEAT DISCH_TAC THEN
     ABBREV_TAC
        (← q r"D:real^N^N = (lambda i j. if i = j then (x:real^N)$i else &0)") THEN
     SUBGOAL_THEN
      (← q r"(?A':real^N^N. transp A' = A' /\  A' ** A' = A) /\
       (?B':real^N^N. transp B' = B' /\  B' ** B' = B)")
     STRIP_ASSUME_TAC THENL
      [ASM_MESON_TAC [POSITIVE_SEMIDEFINITE_SQRT_EQ, positive_semidefinite,
                      symmetric_matrix, POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE],
       ALL_TAC])
    THENL [MATCH_MP_TAC REAL_LE_TRANS, MATCH_MP_TAC REAL_LTE_TRANS] THEN
    EXISTS_TAC
      (← q r"trace(transp(A' ** D ** B') **
             ((A':real^N^N) ** D ** (B':real^N^N)))") THEN
    (CONJ_TAC THENL
      [ASM_REWRITE_TAC [TRACE_COVARIANCE_POS_LT, TRACE_COVARIANCE_POS_LE],
       MATCH_MP_TAC REAL_EQ_IMP_LE THEN
       REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
       REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
       ONCE_REWRITE_TAC [TRACE_MUL_SYM] THEN
       ASM_REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
       ONCE_REWRITE_TAC [TRACE_MUL_SYM] THEN
       ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN
       EXPAND_TAC "D" THEN
       SIMP_TAC [trace, dot, MATRIX_MUL_COMPONENT, LAMBDA_BETA,
                 TRANSP_COMPONENT, MATRIX_VECTOR_MUL_COMPONENT] THEN
       REWRITE_TAC [COND_RAND, COND_RATOR, REAL_MUL_LZERO, REAL_MUL_RZERO] THEN
       SIMP_TAC [SUM_DELTA] THEN
       GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
       SIMP_TAC [SUM_DELTA, ← GSYM SUM_LMUL, ← GSYM SUM_RMUL] THEN
       GEN_REWRITE_TAC RAND_CONV [SUM_SWAP_NUMSEG] THEN
       REWRITE_TAC [] THEN
       MATCH_MP_TAC SUM_EQ_NUMSEG THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
       REWRITE_TAC [] THEN
       MATCH_MP_TAC SUM_EQ_NUMSEG THEN X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
       REWRITE_TAC [] THEN
       SUBGOAL_THEN (← q r"(B:real^N^N)$j$i = B$i$j")
        (fun th => REWRITE_TAC [th, REAL_MUL_AC]) THEN
       ASM_MESON_TAC [TRANSP_COMPONENT]]) THEN
    SUBGOAL_THEN (← q r"invertible(A':real^N^N) /\ invertible(B':real^N^N)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [INVERTIBLE_MATRIX_MUL, POSITIVE_DEFINITE_IMP_INVERTIBLE],
      ASM_SIMP_TAC [MATRIX_ENTIRE]] THEN
    EXPAND_TAC "D" THEN SIMP_TAC [CART_EQ, LAMBDA_BETA, MAT_COMPONENT] THEN
    REWRITE_TAC [← MESON []
     (← q r"(if p then a else z) = (if p then b else z) <=> p ==> a = b")] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")] THEN
    UNDISCH_TAC (← q r"~(x:real^N = vec 0)") THEN
    SIMP_TAC [FORALL_UNWIND_THM1, CART_EQ, VEC_COMPONENT]))

  return { HADAMARD_INEQUALITY_PSD, POSITIVE_DEFINITE_NEARBY,
           POSITIVE_DEFINITE_EQ_CONGRUENT_IDENTITY, POSITIVE_DEFINITE_EQ_CONGRUENT_IDENTITY_ALT,
           POSITIVE_DEFINITE_EVENTUALLY, POSITIVE_SEMIDEFINITE_HADAMARD_PRODUCT,
           POSITIVE_DEFINITE_HADAMARD_PRODUCT }

/- ------------------------------------------------------------------------- -/
/- Polar decomposition.  (topology.ml 21527-21716)                           -/
/- ------------------------------------------------------------------------- -/

structure RPD where
  RIGHT_POLAR_DECOMPOSITION : thm
  deriving Inhabited

@[nospecialize]
def setupRPD [HolBase] (D : TopologyDeps) (BDIG : DIG) : ExceptT String IO RPD := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, REAL_ARITH_TAC, REAL_FIELD, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { CARD_EQ_BIJECTION, CARD_IMAGE_EQ_INJ, CARD_NUMSEG_1, CARD_UNION, CARD_UNION_EQ, CART_EQ,
        COND_RAND, COND_RATOR, DE_MORGAN_THM, DISJOINT, EQ_TRANS, EXISTS_IN_GSPEC,
        FINITE_NUMSEG, .. } := D.core1
  let { FINITE_RESTRICT, FINITE_UNION, FORALL_IN_GSPEC, IMAGE_ID, IMP_CONJ, INJECTIVE_ON_ALT,
        IN_NUMSEG, .. } := D.core2
  let { IN_UNION, LAMBDA_BETA, LAMBDA_ETA, LEFT_IMP_EXISTS_THM, REAL_ABS_INV, REAL_ABS_ZERO, .. } :=
    D.core3
  let { REAL_INV_EQ_0, REAL_LE_REFL, .. } := D.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_POS, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SIMPLE_IMAGE_GEN, SQRT_0, SQRT_EQ_0, SQRT_POS_LE, SQRT_POW2, SQRT_POW_2, SUBSET_UNIV, .. } :=
    D.core5
  let { SUM_DELTA, UNION_COMM, UNION_UNIV, pairwise, real_abs, .. } := D.core6
  let { BASIS_CARD_EQ_DIM, DIM_UNIV, DOT_EQ_0, DOT_LMUL, DOT_POS_LE, DOT_RMUL, .. } := D.vec1
  let { MATRIX_MUL_ASSOC, MATRIX_MUL_LID, MATRIX_MUL_RID, MATRIX_TRANSP_MUL, .. } := D.vec2
  let { MATRIX_VECTOR_MUL_ASSOC, MATRIX_VECTOR_MUL_BASIS, NORM_0, NORM_EQ_SQUARE, NORM_MUL,
        ORTHOGONAL_MUL, ORTHOGONAL_REFL, ORTHONORMAL_EXTENSION, PAIRWISE_ORTHOGONAL_IMP_FINITE,
        PAIRWISE_ORTHOGONAL_INDEPENDENT, SPAN_UNIV, SYMMETRIC_MATRIX_COVARIANCE, .. } := D.vec3
  let { TRANSP_TRANSP, VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0, VEC_COMPONENT, column, matrix_mul,
        orthogonal, row, transp, .. } := D.vec4
  let { DIAGONAL_MATRIX, MATRIX_MUL_LTRANSP_DOT_COLUMN, ORTHOGONAL_MATRIX_MUL,
        ORTHOGONAL_MATRIX_ORTHONORMAL_ROWS, ORTHOGONAL_MATRIX_TRANSP,
        POSITIVE_SEMIDEFINITE_DIAGONAL_MATRIX, POSITIVE_SEMIDEFINITE_SIMILAR, diagonal_matrix,
        orthogonal_matrix, .. } := D.det
  let { SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, .. } := BDIG
  -- @@SCOPE END

  let RIGHT_POLAR_DECOMPOSITION ← prove
   r"!A:real^N^N.
        ?U:real^N^N P:real^N^N.
                orthogonal_matrix U /\ positive_semidefinite P /\ U ** P = A"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"transp(A:real^N^N) ** A")
      SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT) THEN
    ASM_REWRITE_TAC [SYMMETRIC_MATRIX_COVARIANCE, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"P:real^N^N", ← q r"D:real^N^N"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!i j. 1 <= i /\ i <= dimindex(:N) /\
            1 <= j /\ j <= dimindex(:N)
            ==> ((A:real^N^N) ** (transp P ** (basis i:real^N))) dot
                (A ** (transp P ** basis j)) =
                (D:real^N^N)$i$j")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o AP_TERM
       (← q r"\M:real^N^N. (P:real^N^N) ** M ** transp P")) THEN
      REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      ASM_REWRITE_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_LID] THEN
      ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_RID] THEN
      GEN_REWRITE_TAC (funpow 3 LAND_CONV) [← GSYM TRANSP_TRANSP] THEN
      REWRITE_TAC [← GSYM MATRIX_TRANSP_MUL, MATRIX_MUL_ASSOC] THEN
      REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [MATRIX_VECTOR_MUL_ASSOC] THEN
      SPEC_TAC (← q r"(A:real^N^N) ** transp(P:real^N^N)", ← q r"B:real^N^N") THEN
      ASM_SIMP_TAC [MATRIX_MUL_LTRANSP_DOT_COLUMN, LAMBDA_BETA,
                    MATRIX_VECTOR_MUL_BASIS],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i j. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:N)
            ==> &0 <= (D:real^N^N)$i$j")
    ASSUME_TAC THENL
     [REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"i:num = j") THEN
      ASM_MESON_TAC [DOT_POS_LE, diagonal_matrix, REAL_LE_REFL],
      ALL_TAC] THEN
    ABBREV_TAC
      (← q r"b = { inv(sqrt((D:real^N^N)$i$i)) %
             ((A:real^N^N) ** (transp P ** (basis i:real^N))) |i|
             i IN 1..dimindex(:N) /\ ~((D:real^N^N)$i$i = &0)}") THEN
    MP_TAC (← ISPECL
     [← q r"b:real^N->bool", ← q r"(:real^N)"] ORTHONORMAL_EXTENSION) THEN
    REWRITE_TAC [UNION_UNIV, SPAN_UNIV] THEN MATCH_MP_TAC (← TAUT
      (← q r"(p /\ q) /\ (q ==> s ==> r) ==> (p /\ q ==> s) ==> r")) THEN
    CONJ_TAC THENL
     [EXPAND_TAC "b" THEN
      REWRITE_TAC [pairwise, FORALL_IN_GSPEC, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [IN_NUMSEG] THEN REPEAT STRIP_TAC THENL
       [REWRITE_TAC [ORTHOGONAL_MUL] THEN REPEAT DISJ2_TAC THEN
        ASM_SIMP_TAC [orthogonal] THEN
        FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [diagonal_matrix]) THEN
        ASM_MESON_TAC [],
        REWRITE_TAC [NORM_EQ_SQUARE, DOT_LMUL, DOT_RMUL, REAL_POS] THEN
        ASM_SIMP_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        MATCH_MP_TAC (← REAL_FIELD
         (← q r"s pow 2 = x /\ ~(x = &0) ==> inv s * inv s * x = &1")) THEN
        ASM_SIMP_TAC [SQRT_POW2]],
      DISCH_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"{i | i IN 1..dimindex(:N) /\ (D:real^N^N)$i$i = &0}",
      ← q r"c:real^N->bool"] CARD_EQ_BIJECTION) THEN
    ASM_SIMP_TAC [FINITE_RESTRICT, FINITE_NUMSEG] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP PAIRWISE_ORTHOGONAL_IMP_FINITE) THEN
    REWRITE_TAC [FINITE_UNION] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL
     [MP_TAC (← ISPECL [← q r"(:real^N)", ← q r"b UNION c:real^N->bool"]
          BASIS_CARD_EQ_DIM) THEN
      ASM_REWRITE_TAC [SUBSET_UNIV, FINITE_UNION, DIM_UNIV] THEN ANTS_TAC THENL
       [MATCH_MP_TAC PAIRWISE_ORTHOGONAL_INDEPENDENT THEN
        ASM_REWRITE_TAC [IN_UNION, DE_MORGAN_THM] THEN REPEAT STRIP_TAC THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N"))) THEN
        ASM_REWRITE_TAC [NORM_0] THEN CONV_TAC REAL_RAT_REDUCE_CONV,
        ONCE_REWRITE_TAC [UNION_COMM] THEN
        ASM_SIMP_TAC [CARD_UNION, ← GSYM DISJOINT] THEN
        MATCH_MP_TAC (← ARITH_RULE (← q r"s + b:num = n ==> c + b = n ==> s = c"))] THEN
      SUBGOAL_THEN
       (← q r"CARD(b:real^N->bool) =
        CARD {i | i IN 1..dimindex(:N) /\ ~((D:real^N^N)$i$i = &0)}")
      SUBST1_TAC THENL
       [EXPAND_TAC "b" THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        ASM_SIMP_TAC [IMAGE_ID, CARD_IMAGE_EQ_INJ, FINITE_RESTRICT,
                      FINITE_NUMSEG] THEN
        REWRITE_TAC [FORALL_IN_GSPEC, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [IN_NUMSEG] THEN
        STRIP_TAC THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q r"i:num = j") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← MESON [ORTHOGONAL_REFL]
         (← q r"orthogonal x y /\ ~(x = vec 0) ==> ~(x:real^N = y)")) THEN
        CONJ_TAC THENL
         [REWRITE_TAC [ORTHOGONAL_MUL] THEN ASM_SIMP_TAC [orthogonal] THEN
          ASM_MESON_TAC [diagonal_matrix],
          DISCH_TAC THEN
          UNDISCH_TAC (← q r"!x:real^N. x IN b ==> norm x = &1") THEN
          EXPAND_TAC "b" THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"i:num")) THEN
          ASM_REWRITE_TAC [IN_NUMSEG, NORM_0] THEN REAL_ARITH_TAC],
        GEN_REWRITE_TAC RAND_CONV [← GSYM CARD_NUMSEG_1] THEN
        MATCH_MP_TAC CARD_UNION_EQ THEN
        REWRITE_TAC [FINITE_NUMSEG] THEN SET_TAC []],
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN
      REWRITE_TAC [IN_NUMSEG, RIGHT_IMP_FORALL_THM] THEN ONCE_REWRITE_TAC [← TAUT
       (← q r"p ==> q ==> r ==> s <=> p /\ q /\ r ==> s")] THEN
      REWRITE_TAC [INJECTIVE_ON_ALT]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC
     (← q r"U:real^N^N =
      lambda i. if (D:real^N^N)$i$i = &0 then f i
               else inv(sqrt(D$i$i)) % (A ** transp(P:real^N^N) ** basis i)") THEN
    MAP_EVERY EXISTS_TAC
     [← q r"transp(U:real^N^N) ** P:real^N^N",
      ← q r"transp(P:real^N^N) ** (lambda i j. sqrt((D:real^N^N)$j$i)) ** P"] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC ORTHOGONAL_MATRIX_MUL THEN
      ASM_REWRITE_TAC [ORTHOGONAL_MATRIX_TRANSP] THEN
      REWRITE_TAC [ORTHOGONAL_MATRIX_ORTHONORMAL_ROWS] THEN
      EXPAND_TAC "U" THEN SIMP_TAC [LAMBDA_BETA, row, LAMBDA_ETA] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"i:num") THENL
       [STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
         [ASM SET_TAC [], REWRITE_TAC [NORM_MUL, REAL_ABS_INV]] THEN
        MATCH_MP_TAC (← REAL_FIELD
         (← q r"~(x = &0) /\ y = x ==> inv x * y = &1")) THEN
        ASM_REWRITE_TAC [REAL_ABS_ZERO, SQRT_EQ_0] THEN
        ASM_SIMP_TAC [real_abs, SQRT_POS_LE] THEN
        ASM_SIMP_TAC [NORM_EQ_SQUARE, SQRT_POW_2, SQRT_POS_LE],
        X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [pairwise]) THEN
        MAP_EVERY ASM_CASES_TAC
         [← q r"(D:real^N^N)$i$i = &0", ← q r"(D:real^N^N)$j$j = &0"] THEN
        ASM_SIMP_TAC [IN_UNION] THEN
        REPEAT (CONJ_TAC THENL
          [EXPAND_TAC "b" THEN REWRITE_TAC [IN_NUMSEG] THEN ASM SET_TAC [],
           ALL_TAC])
        THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"DISJOINT b c ==> x IN b /\ y IN c ==> ~(x = y)"))) THEN
          EXPAND_TAC "b" THEN REWRITE_TAC [IN_NUMSEG] THEN ASM SET_TAC [],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"DISJOINT b c ==> x IN b /\ y IN c ==> ~(y = x)"))) THEN
          EXPAND_TAC "b" THEN REWRITE_TAC [IN_NUMSEG] THEN ASM SET_TAC [],
          MATCH_MP_TAC (← MESON [ORTHOGONAL_REFL]
           (← q r"orthogonal x y /\ ~(x = vec 0) ==> ~(x = y)")) THEN
          CONJ_TAC THENL
           [REWRITE_TAC [ORTHOGONAL_MUL] THEN REPEAT DISJ2_TAC THEN
            ASM_SIMP_TAC [orthogonal] THEN ASM_MESON_TAC [diagonal_matrix],
            ASM_SIMP_TAC [VECTOR_MUL_EQ_0, REAL_INV_EQ_0, SQRT_EQ_0] THEN
            ASM_SIMP_TAC [← GSYM DOT_EQ_0]]]],
      MATCH_MP_TAC POSITIVE_SEMIDEFINITE_SIMILAR THEN
      MATCH_MP_TAC POSITIVE_SEMIDEFINITE_DIAGONAL_MATRIX THEN
      ASM_SIMP_TAC [SQRT_POS_LE, LAMBDA_BETA] THEN
      FIRST_X_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE id [DIAGONAL_MATRIX]) THEN
      SIMP_TAC [diagonal_matrix, LAMBDA_BETA, SQRT_0],
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      GEN_REWRITE_TAC LAND_CONV [MATRIX_MUL_ASSOC] THEN
      GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM MATRIX_MUL_ASSOC] THEN
      ASM_REWRITE_TAC [MATRIX_MUL_RID] THEN REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
      TRANS_TAC EQ_TRANS (← q r"(A:real^N^N) ** transp P ** (P:real^N^N)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [MATRIX_MUL_RID]] THEN
      REWRITE_TAC [MATRIX_MUL_ASSOC] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC LAND_CONV [matrix_mul] THEN
      SIMP_TAC [CART_EQ, LAMBDA_BETA, transp] THEN
      X_GEN_TAC (← q r"m:num") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE id [DIAGONAL_MATRIX]) THEN
      ASM_SIMP_TAC [LAMBDA_BETA] THEN
      REWRITE_TAC [COND_RATOR, COND_RAND, SQRT_0, REAL_MUL_LZERO,
                   REAL_MUL_RZERO] THEN
      CONV_TAC (LAND_CONV (ONCE_DEPTH_CONV SYM_CONV)) THEN
      ASM_SIMP_TAC [SUM_DELTA, IN_NUMSEG] THEN EXPAND_TAC "U" THEN
      ASM_SIMP_TAC [LAMBDA_BETA] THEN REWRITE_TAC [MATRIX_VECTOR_MUL_ASSOC] THEN
      COND_CASES_TAC THEN
      ASM_SIMP_TAC [MATRIX_VECTOR_MUL_BASIS, column, VECTOR_MUL_COMPONENT,
                    LAMBDA_BETA] THEN
      ASM_SIMP_TAC [transp, SQRT_POW2, ← REAL_FIELD
       (← q r"~(s = &0) /\ sqrt s pow 2 = s ==> (inv(sqrt s) * x) * sqrt s = x")] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"n:num"])) THEN
      ASM_REWRITE_TAC [DOT_EQ_0, REAL_LE_REFL, MATRIX_VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [MATRIX_VECTOR_MUL_BASIS, column, transp, SQRT_0,
                    CART_EQ, LAMBDA_BETA, VEC_COMPONENT, REAL_MUL_RZERO]])

  return { RIGHT_POLAR_DECOMPOSITION }

/- ------------------------------------------------------------------------- -/
/- Consequences of polar decomposition.  (topology.ml 21717-21995)           -/
/- ------------------------------------------------------------------------- -/

structure PDC where
  LEFT_POLAR_DECOMPOSITION : thm
  RIGHT_POLAR_DECOMPOSITION_INVERTIBLE : thm
  LEFT_POLAR_DECOMPOSITION_INVERTIBLE : thm
  NORMAL_RIGHT_POLAR_DECOMPOSITION : thm
  NORMAL_LEFT_POLAR_DECOMPOSITION : thm
  NORMAL_BIPOLAR_DECOMPOSITION : thm
  LEFT_POLAR_DECOMPOSITION_UNIQUE : thm
  RIGHT_POLAR_DECOMPOSITION_UNIQUE : thm
  LEFT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE : thm
  RIGHT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE : thm
  COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL : thm
  COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL_ALT : thm
  NORMAL_MATRIX_SIMILAR_TRANSP : thm
  NORMAL_MATRIX_SIMILAR_TRANSP_ALT : thm
  MATRIX_DIAGONALIZABLE : thm
  deriving Inhabited

@[nospecialize]
def setupPDC [HolBase] (D : TopologyDeps) (BDIG : DIG) (BPSU : PSU) (BRPD : RPD) :
    ExceptT String IO PDC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, .. } := D
  let { EXISTS_UNIQUE_DEF, .. } := D.core1
  let { IMP_CONJ, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core3
  let { SWAP_EXISTS_THM, .. } := D.core6
  let { INVERTIBLE_TRANSP, MATRIX_MUL_ASSOC, MATRIX_MUL_LCANCEL, MATRIX_MUL_LID,
        MATRIX_MUL_RCANCEL, MATRIX_MUL_RID, MATRIX_TRANSP_MUL, .. } := D.vec2
  let { TRANSP_EQ, .. } := D.vec3
  let { TRANSP_TRANSP, normal_matrix, symmetric_matrix, .. } := D.vec4
  let { INVERTIBLE_MATRIX_MUL, ORTHOGONAL_MATRIX_IMP_INVERTIBLE, ORTHOGONAL_MATRIX_MUL,
        ORTHOGONAL_MATRIX_TRANSP, POSITIVE_DEFINITE_IMP_INVERTIBLE,
        POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE, POSITIVE_DEFINITE_TRANSP,
        POSITIVE_SEMIDEFINITE_COVARIANCE, POSITIVE_SEMIDEFINITE_DIAGONAL_MATRIX_EQ,
        POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC, POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC_MATRIX,
        POSITIVE_SEMIDEFINITE_SIMILAR, POSITIVE_SEMIDEFINITE_SIMILAR_EQ,
        POSITIVE_SEMIDEFINITE_TRANSP, orthogonal_matrix, positive_semidefinite, .. } := D.det
  let { SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT, .. } := BDIG
  let { POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE, POSITIVE_SEMIDEFINITE_SQRT_UNIQUE, .. } := BPSU
  let { RIGHT_POLAR_DECOMPOSITION, .. } := BRPD
  -- @@SCOPE END

  let LEFT_POLAR_DECOMPOSITION ← prove
   r"!A:real^N^N.
        ?U:real^N^N P:real^N^N.
                orthogonal_matrix U /\ positive_semidefinite P /\ P ** U = A"
   (GEN_TAC THEN
    MP_TAC (← ISPEC (← q r"transp(A:real^N^N)") RIGHT_POLAR_DECOMPOSITION) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"U:real^N^N", ← q r"P:real^N^N"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"transp:real^N^N->real^N^N")) THEN
    REWRITE_TAC [TRANSP_TRANSP] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MAP_EVERY EXISTS_TAC [← q r"transp U:real^N^N", ← q r"transp P:real^N^N"] THEN
    ASM_REWRITE_TAC [ORTHOGONAL_MATRIX_TRANSP, POSITIVE_SEMIDEFINITE_TRANSP] THEN
    REWRITE_TAC [MATRIX_TRANSP_MUL])

  let RIGHT_POLAR_DECOMPOSITION_INVERTIBLE ← prove
   r"!A:real^N^N.
        invertible A <=>
        ?U:real^N^N P:real^N^N.
                orthogonal_matrix U /\ positive_definite P /\ U ** P = A"
   (GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"A:real^N^N") RIGHT_POLAR_DECOMPOSITION) THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      UNDISCH_TAC (← q r"invertible(A:real^N^N)") THEN
      ASM_SIMP_TAC [POSITIVE_DEFINITE_POSITIVE_SEMIDEFINITE,
                    INVERTIBLE_MATRIX_MUL],
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      ASM_SIMP_TAC [INVERTIBLE_MATRIX_MUL, ORTHOGONAL_MATRIX_IMP_INVERTIBLE,
                    POSITIVE_DEFINITE_IMP_INVERTIBLE]])

  let LEFT_POLAR_DECOMPOSITION_INVERTIBLE ← prove
   r"!A:real^N^N.
        invertible A <=>
        ?U:real^N^N P:real^N^N.
                orthogonal_matrix U /\ positive_definite P /\ P ** U = A"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM INVERTIBLE_TRANSP] THEN
    REWRITE_TAC [RIGHT_POLAR_DECOMPOSITION_INVERTIBLE] THEN
    EQ_TAC THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"U:real^N^N", ← q r"P:real^N^N"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"transp:real^N^N->real^N^N")) THEN
    REWRITE_TAC [TRANSP_TRANSP] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MAP_EVERY EXISTS_TAC [← q r"transp U:real^N^N", ← q r"transp P:real^N^N"] THEN
    ASM_REWRITE_TAC [ORTHOGONAL_MATRIX_TRANSP, POSITIVE_DEFINITE_TRANSP] THEN
    REWRITE_TAC [MATRIX_TRANSP_MUL])

  let NORMAL_RIGHT_POLAR_DECOMPOSITION ← prove
   r"!A U P:real^N^N.
        orthogonal_matrix U /\ positive_semidefinite P /\ U ** P = A
        ==> (normal_matrix A <=> P ** U = U ** P)"
   (REWRITE_TAC [normal_matrix] THEN REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [UNDISCH_TAC (← q r"transp A ** A:real^N^N = A ** transp A") THEN
      EXPAND_TAC "A" THEN
      REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
      ONCE_REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
      GEN_REWRITE_TAC (funpow 3 LAND_CONV) [← GSYM MATRIX_MUL_ASSOC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      ASM_REWRITE_TAC [MATRIX_MUL_RID] THEN EXPAND_TAC "A" THEN
      REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, ← GSYM MATRIX_TRANSP_MUL] THEN
      REWRITE_TAC [MATRIX_MUL_ASSOC] THEN DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"transp P ** P:real^N^N")
        POSITIVE_SEMIDEFINITE_SQRT_UNIQUE) THEN
      REWRITE_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE, EXISTS_UNIQUE_DEF] THEN
      DISCH_THEN (MP_TAC o SPECL
        [← q r"P:real^N^N", ← q r"(U:real^N^N) ** (P:real^N^N) ** transp U"] o
       CONJUNCT2) THEN
      ANTS_TAC THENL
       [ALL_TAC,
        DISCH_THEN (fun th => GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [th]) THEN
        ASM_MESON_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_RID]] THEN
      REPEAT CONJ_TAC THENL
       [FIRST_ASSUM ACCEPT_TAC,
        ASM_MESON_TAC [positive_semidefinite, symmetric_matrix],
        ASM_MESON_TAC [POSITIVE_SEMIDEFINITE_SIMILAR, TRANSP_TRANSP],
        ASM_REWRITE_TAC [] THEN EXPAND_TAC "A" THEN
        REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_TRANSP_MUL] THEN
        AP_TERM_TAC THEN AP_TERM_TAC THEN
        ASM_REWRITE_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_LID] THEN
        ASM_MESON_TAC [positive_semidefinite, symmetric_matrix]],
      EXPAND_TAC "A" THEN FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← SYM th] THEN
              GEN_REWRITE_TAC (funpow 3 RAND_CONV) [← SYM th])) THEN
      REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [positive_semidefinite, orthogonal_matrix]) THEN
      ONCE_REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
      GEN_REWRITE_TAC (BINOP_CONV o LAND_CONV) [← GSYM MATRIX_MUL_ASSOC] THEN
      ASM_REWRITE_TAC [MATRIX_MUL_RID] THEN ASM_MESON_TAC [symmetric_matrix]])

  let NORMAL_LEFT_POLAR_DECOMPOSITION ← prove
   r"!A U P:real^N^N.
        orthogonal_matrix U /\ positive_semidefinite P /\ P ** U = A
        ==> (normal_matrix A <=> P ** U = U ** P)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"transp A:real^N^N", ← q r"transp U:real^N^N",
                      ← q r"transp P:real^N^N"]
          NORMAL_RIGHT_POLAR_DECOMPOSITION) THEN
    ASM_SIMP_TAC [ORTHOGONAL_MATRIX_TRANSP, POSITIVE_SEMIDEFINITE_TRANSP] THEN
    REWRITE_TAC [normal_matrix] THEN
    ASM_REWRITE_TAC [← GSYM MATRIX_TRANSP_MUL, ← MESON [TRANSP_TRANSP]
     (← q r"transp(A:real^N^N) = transp B <=> A = B")] THEN
    MESON_TAC [])

  let NORMAL_BIPOLAR_DECOMPOSITION ← prove
   r"!A:real^N^N.
        normal_matrix A <=>
        ?U P. orthogonal_matrix U /\ positive_semidefinite P /\
              U ** P = A /\ P ** U = A"
   (GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [NORMAL_RIGHT_POLAR_DECOMPOSITION,
                 RIGHT_POLAR_DECOMPOSITION],
      REWRITE_TAC [normal_matrix, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"U:real^N^N", ← q r"P:real^N^N"] THEN
      REWRITE_TAC [IMP_CONJ] THEN DISCH_TAC THEN DISCH_TAC THEN
      DISCH_THEN (fun th => tactic_of do
       pure (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o ONCE_DEPTH_CONV) [← GSYM th])) THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE
       [orthogonal_matrix, positive_semidefinite, symmetric_matrix]) THEN
      ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC] THEN AP_TERM_TAC THEN
      ASM_REWRITE_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_LID]])

  let LEFT_POLAR_DECOMPOSITION_UNIQUE ← prove
   r"!A:real^N^N.
        ?!P. ?U. orthogonal_matrix U /\ positive_semidefinite P /\ P ** U = A"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q r"A:real^N^N") LEFT_POLAR_DECOMPOSITION) THEN
    REWRITE_TAC [EXISTS_UNIQUE_DEF] THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
    SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    MAP_EVERY X_GEN_TAC [← q r"S:real^N^N", ← q r"P:real^N^N"] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"U:real^N^N") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"V:real^N^N") STRIP_ASSUME_TAC)) THEN
    MP_TAC (← ISPEC (← q r"transp(transp A) ** transp A:real^N^N")
          POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE) THEN
    REWRITE_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE] THEN
    REWRITE_TAC [TRANSP_TRANSP, EXISTS_UNIQUE_DEF] THEN
    DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [UNDISCH_THEN (← q r"(S:real^N^N) ** (U:real^N^N) = A") (SUBST1_TAC o SYM),
      UNDISCH_THEN (← q r"(P:real^N^N) ** (V:real^N^N) = A") (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
    ASM_SIMP_TAC [POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC, MATRIX_MUL_ASSOC] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
    ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_RID])

  let RIGHT_POLAR_DECOMPOSITION_UNIQUE ← prove
   r"!A:real^N^N.
        ?!P. ?U. orthogonal_matrix U /\ positive_semidefinite P /\ U ** P = A"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q r"A:real^N^N") RIGHT_POLAR_DECOMPOSITION) THEN
    REWRITE_TAC [EXISTS_UNIQUE_DEF] THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
    SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    MAP_EVERY X_GEN_TAC [← q r"S:real^N^N", ← q r"P:real^N^N"] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"U:real^N^N") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"V:real^N^N") STRIP_ASSUME_TAC)) THEN
    MP_TAC (← ISPEC (← q r"transp(A:real^N^N) ** A:real^N^N")
          POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE) THEN
    REWRITE_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE] THEN
    REWRITE_TAC [TRANSP_TRANSP, EXISTS_UNIQUE_DEF] THEN
    DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [UNDISCH_THEN (← q r"(U:real^N^N) ** (S:real^N^N) = A") (SUBST1_TAC o SYM),
      UNDISCH_THEN (← q r"(V:real^N^N) ** (P:real^N^N) = A") (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
    ASM_SIMP_TAC [POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC, MATRIX_MUL_ASSOC] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
    ASM_REWRITE_TAC [← GSYM MATRIX_MUL_ASSOC, MATRIX_MUL_RID])

  let LEFT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE ← prove
   r"!A:real^N^N U V P S.
        invertible A /\
        orthogonal_matrix U /\ positive_semidefinite P /\
        orthogonal_matrix V /\ positive_semidefinite S /\
        P ** U = A /\ S ** V = A
        ==> P = S /\ U = V"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"P:real^N^N = S") SUBST_ALL_TAC THENL
     [ASM_MESON_TAC [LEFT_POLAR_DECOMPOSITION_UNIQUE], REWRITE_TAC []] THEN
    ASM_MESON_TAC [MATRIX_MUL_LCANCEL, INVERTIBLE_MATRIX_MUL])

  let RIGHT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE ← prove
   r"!A:real^N^N U V P S.
        invertible A /\
        orthogonal_matrix U /\ positive_semidefinite P /\
        orthogonal_matrix V /\ positive_semidefinite S /\
        U ** P = A /\ V ** S = A
        ==> P = S /\ U = V"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"P:real^N^N = S") SUBST_ALL_TAC THENL
     [ASM_MESON_TAC [RIGHT_POLAR_DECOMPOSITION_UNIQUE], REWRITE_TAC []] THEN
    ASM_MESON_TAC [MATRIX_MUL_RCANCEL, INVERTIBLE_MATRIX_MUL])

  let COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL ← prove
   r"!A B:real^N^N.
        transp A ** A = transp B ** B <=>
        ?U. orthogonal_matrix U /\ U ** A = B"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MP_TAC (← ISPEC (← q r"B:real^N^N") RIGHT_POLAR_DECOMPOSITION) THEN
      MP_TAC (← ISPEC (← q r"A:real^N^N") RIGHT_POLAR_DECOMPOSITION) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"U:real^N^N", ← q r"P:real^N^N"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"V:real^N^N", ← q r"Q:real^N^N"] THEN STRIP_TAC THEN
      MAP_EVERY EXPAND_TAC ["A", "B"] THEN REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
      ONCE_REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
      GEN_REWRITE_TAC (LAND_CONV o BINOP_CONV o LAND_CONV)
       [← GSYM MATRIX_MUL_ASSOC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [orthogonal_matrix]) THEN
      ASM_REWRITE_TAC [MATRIX_MUL_RID] THEN DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"transp(P:real^N^N) ** P")
        POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE) THEN
      REWRITE_TAC [POSITIVE_SEMIDEFINITE_COVARIANCE, EXISTS_UNIQUE_DEF] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"P:real^N^N", ← q r"Q:real^N^N"] o CONJUNCT2) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
      EXISTS_TAC (← q r"(V:real^N^N) ** transp(U:real^N^N)") THEN
      ASM_MESON_TAC [orthogonal_matrix, ORTHOGONAL_MATRIX_MUL,
                     ORTHOGONAL_MATRIX_TRANSP, MATRIX_MUL_ASSOC, MATRIX_MUL_RID],
      REWRITE_TAC [orthogonal_matrix] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      ASM_REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
      ASM_MESON_TAC [MATRIX_MUL_ASSOC, MATRIX_MUL_RID]])

  let COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL_ALT ← prove
   r"!A B:real^N^N.
        A ** transp A = B ** transp B <=>
        ?U. orthogonal_matrix U /\ A ** U = B"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"transp A:real^N^N", ← q r"transp B:real^N^N"]
          COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL) THEN
    REWRITE_TAC [← GSYM MATRIX_TRANSP_MUL, TRANSP_EQ] THEN
    DISCH_THEN SUBST1_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [← GSYM TRANSP_EQ] THEN
    REWRITE_TAC [MATRIX_TRANSP_MUL] THEN
    MESON_TAC [ORTHOGONAL_MATRIX_TRANSP, TRANSP_TRANSP])

  let NORMAL_MATRIX_SIMILAR_TRANSP ← prove
   r"!A:real^N^N.
        normal_matrix A <=>
        ?U. orthogonal_matrix U /\ U ** transp A = A"
   (REWRITE_TAC [← GSYM COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL] THEN
    REWRITE_TAC [normal_matrix] THEN MESON_TAC [TRANSP_TRANSP])

  let NORMAL_MATRIX_SIMILAR_TRANSP_ALT ← prove
   r"!A:real^N^N.
        normal_matrix A <=>
        ?U. orthogonal_matrix U /\ transp A ** U = A"
   (GEN_TAC THEN
    MP_TAC (← ISPEC (← q r"transp A:real^N^N") NORMAL_MATRIX_SIMILAR_TRANSP) THEN
    REWRITE_TAC [normal_matrix, TRANSP_TRANSP] THEN
    MESON_TAC [ORTHOGONAL_MATRIX_TRANSP, MATRIX_TRANSP_MUL, TRANSP_TRANSP])

  let MATRIX_DIAGONALIZABLE ← prove
   r"!A:real^N^N.
        ?P D Q. orthogonal_matrix P /\
                diagonal_matrix D /\
                orthogonal_matrix Q /\
                (!i. 1 <= i /\ i <= dimindex(:N) ==> &0 <= D$i$i) /\
                A = P ** D ** Q"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q r"A:real^N^N") RIGHT_POLAR_DECOMPOSITION) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"U:real^N^N", ← q r"S:real^N^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MP_TAC (← ISPEC (← q r"S:real^N^N") SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM,
                  POSITIVE_SEMIDEFINITE_IMP_SYMMETRIC_MATRIX] THEN
    MAP_EVERY X_GEN_TAC [← q r"V:real^N^N", ← q r"D:real^N^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"(U:real^N^N) ** transp(V:real^N^N)", ← q r"D:real^N^N", ← q r"V:real^N^N"] THEN
    ASM_REWRITE_TAC [MATRIX_MUL_ASSOC] THEN
    ASM_SIMP_TAC [ORTHOGONAL_MATRIX_MUL, ORTHOGONAL_MATRIX_TRANSP] THEN
    UNDISCH_TAC (← q r"positive_semidefinite(transp(V:real^N^N) ** D ** V)") THEN
    ASM_SIMP_TAC [POSITIVE_SEMIDEFINITE_SIMILAR_EQ,
                  ORTHOGONAL_MATRIX_IMP_INVERTIBLE,
                  POSITIVE_SEMIDEFINITE_DIAGONAL_MATRIX_EQ])

  return { LEFT_POLAR_DECOMPOSITION, RIGHT_POLAR_DECOMPOSITION_INVERTIBLE,
           LEFT_POLAR_DECOMPOSITION_INVERTIBLE, NORMAL_RIGHT_POLAR_DECOMPOSITION,
           NORMAL_LEFT_POLAR_DECOMPOSITION, NORMAL_BIPOLAR_DECOMPOSITION,
           LEFT_POLAR_DECOMPOSITION_UNIQUE, RIGHT_POLAR_DECOMPOSITION_UNIQUE,
           LEFT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE,
           RIGHT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE, COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL,
           COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL_ALT, NORMAL_MATRIX_SIMILAR_TRANSP,
           NORMAL_MATRIX_SIMILAR_TRANSP_ALT, MATRIX_DIAGONALIZABLE }

/- ------------------------------------------------------------------------- -/
/- Infinite sums of vectors. Allow general starting point (and more).        -/
/- (topology.ml 21996-22173)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SUM1 where
  sums : thm
  infsum : thm
  summable : thm
  SUMS_SUMMABLE : thm
  SUMS_INFSUM : thm
  SUMS_LIM : thm
  SERIES_FROM : thm
  SERIES_UNIQUE : thm
  INFSUM_UNIQUE : thm
  SERIES_TERMS_TOZERO : thm
  SERIES_FINITE : thm
  SERIES_FINITE_EQ : thm
  SERIES_LINEAR : thm
  SERIES_0 : thm
  SERIES_ADD : thm
  SERIES_SUB : thm
  SERIES_CMUL : thm
  SERIES_NEG : thm
  SUMS_IFF : thm
  SUMS_EQ : thm
  SUMS_0 : thm
  SERIES_FINITE_SUPPORT : thm
  SERIES_COMPONENT : thm
  SERIES_DIFFS : thm
  SERIES_TRIVIAL : thm
  SERIES_RESTRICT : thm
  SERIES_VSUM : thm
  deriving Inhabited

@[nospecialize]
def setupSUM1 [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) (BLIM2 : LIM2) (BARI : ARI)
    (BUNQ : UNQ) (BTRN : TRN) (BSEQ : SEQ) : ExceptT String IO SUM1 := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON,
        MESON_TAC, SET_TAC, NORM_ARITH_TAC, .. } := D
  let { EXTENSION, FINITE_INTER, FINITE_NUMSEG, .. } := D.core1
  let { FUN_EQ_THM, INTER_EMPTY, INTER_UNIV, IN_ELIM_THM, IN_INTER, IN_NUMSEG, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_0, LE_TRANS, MONO_EXISTS, .. } := D.core3
  let { SUBSET, .. } := D.core5
  let { num_FINITE, numseg, o_DEF, .. } := D.core6
  let { FINITE_INTER_NUMSEG, FROM_INTER_NUMSEG, REAL_HALF, UPPER_BOUND_FINITE_SET, «from», .. } :=
    D.misc
  let { DIST_REFL, .. } := D.vec1
  let { LIFT_SUM, LINEAR_VSUM, .. } := D.vec2
  let { VECTOR_SUB_RZERO, VSUM_0, VSUM_ADD, VSUM_CLAUSES, VSUM_CLAUSES_RIGHT, VSUM_COMPONENT,
        VSUM_DIFFS, VSUM_EQ, VSUM_LMUL, VSUM_NEG, VSUM_SUB, VSUM_SUPERSET, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { lim, .. } := BLIM1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_ADD, LIM_CMUL, LIM_COMPONENT, LIM_CONST, LIM_LINEAR, LIM_NEG, LIM_SUB, .. } := BARI
  let { LIM_UNIQUE, .. } := BUNQ
  let { LIM_TRANSFORM_EVENTUALLY, .. } := BTRN
  let { SEQ_OFFSET, .. } := BSEQ
  -- @@SCOPE END

  parse_as_infix ("sums", (12, "right"))

  let sums ← new_definition
   r"(f sums l) s = ((\n. vsum(s INTER (0..n)) f) --> l) sequentially"

  let infsum ← new_definition
   r"infsum s f = @l. (f sums l) s"

  let summable ← new_definition
   r"summable s f = ?l. (f sums l) s"

  let SUMS_SUMMABLE ← prove
   r"!f l s. (f sums l) s ==> summable s f"
   (REWRITE_TAC [summable] THEN MESON_TAC [])

  let SUMS_INFSUM ← prove
   r"!f s. (f sums (infsum s f)) s <=> summable s f"
   (REWRITE_TAC [infsum, summable] THEN MESON_TAC [])

  let SUMS_LIM ← prove
   r"!f:num->real^N s.
      (f sums lim sequentially (\n. vsum (s INTER (0..n)) f)) s
      <=> summable s f"
   (GEN_TAC THEN GEN_TAC THEN EQ_TAC THENL [MESON_TAC [summable],
    REWRITE_TAC [summable, sums] THEN STRIP_TAC THEN REWRITE_TAC [lim] THEN
    ASM_MESON_TAC []])

  let SERIES_FROM ← prove
   r"!f l k. (f sums l) (from k) = ((\n. vsum(k..n) f) --> l) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [sums] THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, numseg, «from», IN_ELIM_THM, IN_INTER] THEN ARITH_TAC)

  let SERIES_UNIQUE ← prove
   r"!f:num->real^N l l' s. (f sums l) s /\ (f sums l') s ==> (l = l')"
   (REWRITE_TAC [sums] THEN MESON_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, LIM_UNIQUE])

  let INFSUM_UNIQUE ← prove
   r"!f:num->real^N l s. (f sums l) s ==> infsum s f = l"
   (MESON_TAC [SERIES_UNIQUE, SUMS_INFSUM, summable])

  let SERIES_TERMS_TOZERO ← prove
   r"!f l n. (f sums l) (from n) ==> (f --> vec 0) sequentially"
   (REPEAT GEN_TAC THEN SIMP_TAC [sums, LIM_SEQUENTIALLY, FROM_INTER_NUMSEG] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
    EXISTS_TAC (← q r"N + n + 1") THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"m - 1") th) THEN MP_TAC (← SPEC (← q r"m:num") th))) THEN
    SUBGOAL_THEN (← q r"0 < m /\ n <= m") (fun th => SIMP_TAC [VSUM_CLAUSES_RIGHT, th])
    THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    REPEAT (ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_TAC]) THEN
    REPEAT (POP_ASSUM MP_TAC) THEN NORM_ARITH_TAC)

  let SERIES_FINITE ← prove
   r"!f s. FINITE s ==> (f sums (vsum s f)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [num_FINITE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [sums, LIM_SEQUENTIALLY] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"n:num") THEN
    X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"s INTER (0..m) = s")
     (fun th => ASM_REWRITE_TAC [th, DIST_REFL]) THEN
    REWRITE_TAC [EXTENSION, IN_INTER, IN_NUMSEG, LE_0] THEN
    ASM_MESON_TAC [LE_TRANS])

  let SERIES_FINITE_EQ ← prove
   r"!f:num->real^N s y.
        FINITE s ==> ((f sums y) s <=> vsum s f = y)"
   (MESON_TAC [SERIES_FINITE, SERIES_UNIQUE])

  let SERIES_LINEAR ← prove
   r"!f h l s. (f sums l) s /\ linear h ==> ((\n. h(f n)) sums h l) s"
   (SIMP_TAC [sums, LIM_LINEAR, FINITE_INTER, FINITE_NUMSEG,
              ← GSYM (← REWRITE_RULE [o_DEF] LINEAR_VSUM)])

  let SERIES_0 ← prove
   r"!s. ((\n. vec 0) sums (vec 0)) s"
   (REWRITE_TAC [sums, VSUM_0, LIM_CONST])

  let SERIES_ADD ← prove
   r"!x x0 y y0 s.
     (x sums x0) s /\ (y sums y0) s ==> ((\n. x n + y n) sums (x0 + y0)) s"
   (SIMP_TAC [sums, FINITE_INTER_NUMSEG, VSUM_ADD, LIM_ADD])

  let SERIES_SUB ← prove
   r"!x x0 y y0 s.
     (x sums x0) s /\ (y sums y0) s ==> ((\n. x n - y n) sums (x0 - y0)) s"
   (SIMP_TAC [sums, FINITE_INTER_NUMSEG, VSUM_SUB, LIM_SUB])

  let SERIES_CMUL ← prove
   r"!x x0 c s. (x sums x0) s ==> ((\n. c % x n) sums (c % x0)) s"
   (SIMP_TAC [sums, FINITE_INTER_NUMSEG, VSUM_LMUL, LIM_CMUL])

  let SERIES_NEG ← prove
   r"!x x0 s. (x sums x0) s ==> ((\n. --(x n)) sums (--x0)) s"
   (SIMP_TAC [sums, FINITE_INTER_NUMSEG, VSUM_NEG, LIM_NEG])

  let SUMS_IFF ← prove
   r"!f g k. (!x. x IN k ==> f x = g x) ==> ((f sums l) k <=> (g sums l) k)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [sums] THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    MATCH_MP_TAC VSUM_EQ THEN ASM_SIMP_TAC [IN_INTER])

  let SUMS_EQ ← prove
   r"!f g k. (!x. x IN k ==> f x = g x) /\ (f sums l) k ==> (g sums l) k"
   (MESON_TAC [SUMS_IFF])

  let SUMS_0 ← prove
   r"!f:num->real^N s. (!n. n IN s ==> f n = vec 0) ==> (f sums vec 0) s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUMS_EQ THEN
    EXISTS_TAC (← q r"\n:num. vec 0:real^N") THEN ASM_SIMP_TAC [SERIES_0])

  let SERIES_FINITE_SUPPORT ← prove
   r"!f:num->real^N s k.
     FINITE (s INTER k) /\ (!x. x IN k /\ ~(x IN s) ==> f x = vec 0)
     ==> (f sums vsum (s INTER k) f) k"
   (REWRITE_TAC [sums, LIM_SEQUENTIALLY] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"\x:num. x") o MATCH_MP UPPER_BOUND_FINITE_SET) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"vsum (k INTER (0..n)) (f:num->real^N) = vsum(s INTER k) f")
     (fun th => ASM_REWRITE_TAC [DIST_REFL, th]) THEN
    MATCH_MP_TAC VSUM_SUPERSET THEN
    ASM_SIMP_TAC [SUBSET, IN_INTER, IN_NUMSEG, LE_0] THEN
    ASM_MESON_TAC [IN_INTER, LE_TRANS])

  let SERIES_COMPONENT ← prove
   r"!f s l:real^N k. (f sums l) s /\ 1 <= k /\ k <= dimindex(:N)
                    ==> ((\i. lift(f(i)$k)) sums lift(l$k)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [sums] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    ASM_SIMP_TAC [← GSYM LIFT_SUM, ← GSYM VSUM_COMPONENT,
                  FINITE_INTER, FINITE_NUMSEG] THEN
    ASM_SIMP_TAC [o_DEF, LIM_COMPONENT])

  let SERIES_DIFFS ← prove
   r"!f:num->real^N k.
        (f --> vec 0) sequentially
        ==> ((\n. f(n) - f(n + 1)) sums f(k)) (from k)"
   (REWRITE_TAC [sums, FROM_INTER_NUMSEG, VSUM_DIFFS] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"\n. (f:num->real^N) k - f(n + 1)") THEN CONJ_TAC THENL
     [REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"k:num") THEN
      SIMP_TAC [],
      GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_SUB_RZERO] THEN
      MATCH_MP_TAC LIM_SUB THEN REWRITE_TAC [LIM_CONST] THEN
      MATCH_MP_TAC SEQ_OFFSET THEN ASM_REWRITE_TAC []])

  let SERIES_TRIVIAL ← prove
   r"!f. (f sums vec 0) {}"
   (REWRITE_TAC [sums, INTER_EMPTY, VSUM_CLAUSES, LIM_CONST])

  let SERIES_RESTRICT ← prove
   r"!f k l:real^N.
        ((\n. if n IN k then f(n) else vec 0) sums l) (:num) <=>
        (f sums l) k"
   (REPEAT GEN_TAC THEN REWRITE_TAC [sums] THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, INTER_UNIV] THEN GEN_TAC THEN
    MATCH_MP_TAC (← MESON [] (← q r"vsum s f = vsum t f /\ vsum t f = vsum t g
                          ==> vsum s f = vsum t g")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC VSUM_SUPERSET THEN SET_TAC [],
      MATCH_MP_TAC VSUM_EQ THEN SIMP_TAC [IN_INTER]])

  let SERIES_VSUM ← prove
   r"!f l k s. FINITE s /\ s SUBSET k /\ (!x. ~(x IN s) ==> f x = vec 0) /\
             vsum s f = l ==> (f sums l) k"
   (REPEAT STRIP_TAC THEN EXPAND_TAC "l" THEN
    SUBGOAL_THEN (← q r"s INTER k = s:num->bool") ASSUME_TAC THENL
     [ASM SET_TAC [], ASM_MESON_TAC [SERIES_FINITE_SUPPORT]])

  return { sums, infsum, summable, SUMS_SUMMABLE, SUMS_INFSUM, SUMS_LIM, SERIES_FROM,
           SERIES_UNIQUE, INFSUM_UNIQUE, SERIES_TERMS_TOZERO, SERIES_FINITE, SERIES_FINITE_EQ,
           SERIES_LINEAR, SERIES_0, SERIES_ADD, SERIES_SUB, SERIES_CMUL, SERIES_NEG, SUMS_IFF,
           SUMS_EQ, SUMS_0, SERIES_FINITE_SUPPORT, SERIES_COMPONENT, SERIES_DIFFS,
           SERIES_TRIVIAL, SERIES_RESTRICT, SERIES_VSUM }

/- ------------------------------------------------------------------------- -/
/- Reindexing, even and odd terms, and pasting of series.                    -/
/- (topology.ml 22174-22257)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SUM2 where
  SUMS_REINDEX : thm
  SUMS_REINDEX_GEN : thm
  SERIES_EVEN : thm
  SERIES_ODD : thm
  SERIES_PASTECART : thm
  deriving Inhabited

@[nospecialize]
def setupSUM2 [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) (BLIM2 : LIM2) (BPCA1 : PCA1)
    (BSUM1 : SUM1) : ExceptT String IO SUM2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ADD_CLAUSES, ARITH_EQ, ARITH_EVEN, ARITH_ODD, EQ_ADD_RCANCEL, EQ_TRANS, ETA_AX,
        EVEN_ADD, EVEN_EXISTS, EVEN_MULT, FINITE_INTER, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IN_NUMSEG, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_RDIV_EQ, NOT_ODD, ODD_ADD, .. } := D.core3
  let { SUBSET_NUMSEG, .. } := D.core5
  let { FROM_0, FROM_INTER_NUMSEG, IN_FROM, .. } := D.misc
  let { PASTECART_VSUM, .. } := D.vec3
  let { VECTOR_ADD_RID, VSUM_EQ_SUPERSET, VSUM_OFFSET, VSUM_PAIR, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { tendsto, .. } := BLIM1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_PASTECART_EQ, .. } := BPCA1
  let { SERIES_FROM, SERIES_RESTRICT, sums, .. } := BSUM1
  -- @@SCOPE END

  let SUMS_REINDEX ← prove
   r"!k a l:real^N n.
   ((\x. a(x + k)) sums l) (from n) <=> (a sums l) (from(n + k))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [sums, FROM_INTER_NUMSEG] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM VSUM_OFFSET] THEN
    REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    ASM_MESON_TAC [← ARITH_RULE (← q r"N + k:num <= n ==> n = (n - k) + k /\ N <= n - k"),
                   ← ARITH_RULE (← q r"N + k:num <= n ==> N <= n + k")])

  let SUMS_REINDEX_GEN ← prove
   r"!k a l:real^N s.
     ((\x. a(x + k)) sums l) s <=> (a sums l) (IMAGE (\i. i + k) s)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM SERIES_RESTRICT] THEN
    MP_TAC (← ISPECL
     [← q r"k:num",
      ← q r"\i. if i IN IMAGE (\i. i + k) s then (a:num->real^N) i else vec 0",
      ← q r"l:real^N", ← q r"0"] SUMS_REINDEX) THEN
    REWRITE_TAC [FROM_0] THEN
    SIMP_TAC [EQ_ADD_RCANCEL, ← SET_RULE
     (← q r"(!x y:num. x + k = y + k <=> x = y)
           ==> ((x + k) IN IMAGE (\i. i + k) s <=> x IN s)")] THEN
    DISCH_THEN SUBST1_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM SERIES_RESTRICT] THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, IN_FROM, ADD_CLAUSES] THEN
    SUBGOAL_THEN (← q r"!x:num. x IN IMAGE (\i. i + k) s ==> k <= x") MP_TAC THENL
     [REWRITE_TAC [FORALL_IN_IMAGE] THEN ARITH_TAC, SET_TAC []])

  let SERIES_EVEN ← do
    let lemma ← prove
     r"vsum(2 * m..n) (\i. if EVEN i then f i else vec 0):real^N =
       vsum(m..n DIV 2) (\i. f(2 * i))"
     (TRANS_TAC EQ_TRANS
       (← q r"vsum (2 * m..2 * (n DIV 2) + 1)
             (\i. if EVEN i then f i else vec 0):real^N") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [VSUM_PAIR] THEN
        REWRITE_TAC [EVEN_ADD, EVEN_MULT, ARITH_EVEN, VECTOR_ADD_RID]] THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC VSUM_EQ_SUPERSET THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG, SUBSET_NUMSEG] THEN
      CONJ_TAC THENL [ARITH_TAC, ALL_TAC] THEN
      X_GEN_TAC (← q r"p:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"p = 2 * n DIV 2 + 1") SUBST1_TAC
      THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      REWRITE_TAC [EVEN_ADD, EVEN_MULT, ARITH_EVEN])
    prove
     r"!f l:real^N n.
      (f sums l) (from n) <=>
      ((\i. if EVEN i then f(i DIV 2) else vec 0) sums l) (from (2 * n))"
     (REPEAT GEN_TAC THEN REWRITE_TAC [SERIES_FROM, lemma] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(2 * i) DIV 2 = i"), ETA_AX] THEN
      REWRITE_TAC [tendsto] THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"e:real") THEN
      REWRITE_TAC [] THEN AP_TERM_TAC THEN
      ABBREV_TAC (← q r"P m <=> dist(vsum (n..m) f:real^N,l) < e") THEN
      POP_ASSUM (K ALL_TAC : thm → tactic) THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      EQ_TAC THEN DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
      EXISTS_TAC (← q r"2 * N") THEN ASM_SIMP_TAC [← GSYM LE_RDIV_EQ, ARITH_EQ] THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"2 * n")) THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(2 * n) DIV 2 = n")] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_ARITH_TAC)

  let SERIES_ODD ← prove
   r"!f l:real^N n.
    (f sums l) (from n) <=>
    ((\i. if ODD i then f(i DIV 2) else vec 0) sums l) (from (2 * n + 1))"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [SERIES_EVEN] THEN
    REWRITE_TAC [← GSYM SUMS_REINDEX] THEN
    REWRITE_TAC [ODD_ADD, ARITH_ODD, NOT_ODD] THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN POP_ASSUM MP_TAC THEN
    SIMP_TAC [EVEN_EXISTS, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"(2 * m + 1) DIV 2 = m")] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"(2 * m) DIV 2 = m")])

  let SERIES_PASTECART ← prove
   r"!f1:num->real^N f2:num->real^M l1 l2 s.
        ((\x. pastecart (f1 x) (f2 x)) sums (pastecart l1 l2)) s <=>
        (f1 sums l1) s /\ (f2 sums l2) s"
   (SIMP_TAC [sums, ← GSYM PASTECART_VSUM, FINITE_INTER, FINITE_NUMSEG] THEN
    REWRITE_TAC [LIM_PASTECART_EQ])

  return { SUMS_REINDEX, SUMS_REINDEX_GEN, SERIES_EVEN, SERIES_ODD, SERIES_PASTECART }

/- ------------------------------------------------------------------------- -/
/- Similar combining theorems just for summability.                          -/
/- (topology.ml 22258-22459)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SUM3 where
  SUMMABLE_LINEAR : thm
  SUMMABLE_0 : thm
  SUMMABLE_ADD : thm
  SUMMABLE_SUB : thm
  SUMMABLE_CMUL : thm
  SUMMABLE_NEG : thm
  SUMMABLE_IFF : thm
  SUMMABLE_EQ : thm
  SUMMABLE_FINITE : thm
  SUMMABLE_COMPONENT : thm
  SERIES_SUBSET : thm
  SUMMABLE_SUBSET : thm
  SUMMABLE_TRIVIAL : thm
  SUMMABLE_RESTRICT : thm
  SUMS_FINITE_DIFF : thm
  SUMS_FINITE_UNION : thm
  SUMS_OFFSET : thm
  SUMS_OFFSET_REV : thm
  SUMMABLE_REINDEX : thm
  SUMMABLE_EVEN : thm
  SUMMABLE_ODD : thm
  SERIES_DROP_LE : thm
  SERIES_DROP_POS : thm
  SERIES_BOUND : thm
  deriving Inhabited

@[nospecialize]
def setupSUM3 [HolBase] (D : TopologyDeps) (BUNQ : UNQ) (BLCB : LCB) (BSUM1 : SUM1)
    (BSUM2 : SUM2) : ExceptT String IO SUM3 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC, VECTOR_ARITH_TAC,
        NORM_ARITH, .. } := D
  let { ADD_SUB, CONJ_SYM, EQ_IMP, ETA_AX, EXTENSION, FINITE_DIFF, FINITE_INTER,
        FINITE_NUMSEG, .. } := D.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_IMP, INTER, INTER_COMM, IN_DIFF, IN_INTER, IN_NUMSEG, .. } :=
    D.core2
  let { IN_UNION, .. } := D.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, .. } := D.core4
  let { REAL_SUB_LE, SUBSET, .. } := D.core5
  let { SUM_LE, o_DEF, o_THM, .. } := D.core6
  let { FINITE_INTER_NUMSEG, FROM_0, IN_FROM, .. } := D.misc
  let { DROP_SUB, DROP_VEC, DROP_VSUM, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { VSUM_NORM_LE, VSUM_REAL, VSUM_RESTRICT_SET, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { LIM_NORM_UBOUND, .. } := BUNQ
  let { LIM_DROP_LE, .. } := BLCB
  let { SERIES_0, SERIES_ADD, SERIES_CMUL, SERIES_COMPONENT, SERIES_FINITE, SERIES_LINEAR,
        SERIES_NEG, SERIES_RESTRICT, SERIES_SUB, SERIES_TRIVIAL, SUMS_0, SUMS_EQ, SUMS_IFF,
        summable, sums, .. } := BSUM1
  let { SERIES_EVEN, SERIES_ODD, SUMS_REINDEX, .. } := BSUM2
  -- @@SCOPE END

  let SUMMABLE_LINEAR ← prove
   r"!f h s. summable s f /\ linear h ==> summable s (\n. h(f n))"
   (REWRITE_TAC [summable] THEN MESON_TAC [SERIES_LINEAR])

  let SUMMABLE_0 ← prove
   r"!s. summable s (\n. vec 0)"
   (REWRITE_TAC [summable] THEN MESON_TAC [SERIES_0])

  let SUMMABLE_ADD ← prove
   r"!x y s. summable s x /\ summable s y ==> summable s (\n. x n + y n)"
   (REWRITE_TAC [summable] THEN MESON_TAC [SERIES_ADD])

  let SUMMABLE_SUB ← prove
   r"!x y s. summable s x /\ summable s y ==> summable s (\n. x n - y n)"
   (REWRITE_TAC [summable] THEN MESON_TAC [SERIES_SUB])

  let SUMMABLE_CMUL ← prove
   r"!s x c. summable s x ==> summable s (\n. c % x n)"
   (REWRITE_TAC [summable] THEN MESON_TAC [SERIES_CMUL])

  let SUMMABLE_NEG ← prove
   r"!x s. summable s x ==> summable s (\n. --(x n))"
   (REWRITE_TAC [summable] THEN MESON_TAC [SERIES_NEG])

  let SUMMABLE_IFF ← prove
   r"!f g k. (!x. x IN k ==> f x = g x) ==> (summable k f <=> summable k g)"
   (REWRITE_TAC [summable] THEN MESON_TAC [SUMS_IFF])

  let SUMMABLE_EQ ← prove
   r"!f g k. (!x. x IN k ==> f x = g x) /\ summable k f ==> summable k g"
   (REWRITE_TAC [summable] THEN MESON_TAC [SUMS_EQ])

  let SUMMABLE_FINITE ← prove
   r"!k f:num->real^N. FINITE k ==> summable k f"
   (REWRITE_TAC [summable] THEN MESON_TAC [SERIES_FINITE])

  let SUMMABLE_COMPONENT ← prove
   r"!f:num->real^N s k.
        summable s f /\ 1 <= k /\ k <= dimindex(:N)
        ==> summable s (\i. lift(f(i)$k))"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"l:real^N") o REWRITE_RULE [summable]) THEN
    REWRITE_TAC [summable] THEN EXISTS_TAC (← q r"lift((l:real^N)$k)") THEN
    ASM_SIMP_TAC [SERIES_COMPONENT])

  let SERIES_SUBSET ← prove
   r"!x s t l.
        s SUBSET t /\
        ((\i. if i IN s then x i else vec 0) sums l) t
        ==> (x sums l) s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [sums] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    ASM_SIMP_TAC [← GSYM VSUM_RESTRICT_SET, FINITE_INTER_NUMSEG] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN POP_ASSUM MP_TAC THEN SET_TAC [])

  let SUMMABLE_SUBSET ← prove
   r"!x s t.
        s SUBSET t /\
        summable t (\i. if i IN s then x i else vec 0)
        ==> summable s x"
   (REWRITE_TAC [summable] THEN MESON_TAC [SERIES_SUBSET])

  let SUMMABLE_TRIVIAL ← prove
   r"!f:num->real^N. summable {} f"
   (GEN_TAC THEN REWRITE_TAC [summable] THEN EXISTS_TAC (← q r"vec 0:real^N") THEN
    REWRITE_TAC [SERIES_TRIVIAL])

  let SUMMABLE_RESTRICT ← prove
   r"!f:num->real^N k.
        summable (:num) (\n. if n IN k then f(n) else vec 0) <=>
        summable k f"
   (REWRITE_TAC [summable, SERIES_RESTRICT])

  let SUMS_FINITE_DIFF ← prove
   r"!f:num->real^N t s l.
        t SUBSET s /\ FINITE t /\ (f sums l) s
        ==> (f sums (l - vsum t f)) (s DIFF t)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"f:num->real^N") o MATCH_MP SERIES_FINITE) THEN
    ONCE_REWRITE_TAC [← GSYM SERIES_RESTRICT] THEN
    REWRITE_TAC [IMP_IMP] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SERIES_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:num") THEN REWRITE_TAC [IN_DIFF] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"x:num") o GEN_REWRITE_RULE id [SUBSET]) THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:num) IN s", ← q r"(x:num) IN t"] THEN
    ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC)

  let SUMS_FINITE_UNION ← prove
   r"!f:num->real^N s t l.
        FINITE t /\ (f sums l) s
        ==> (f sums (l + vsum (t DIFF s) f)) (s UNION t)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"s:num->bool") o MATCH_MP FINITE_DIFF) THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"f:num->real^N") o MATCH_MP SERIES_FINITE) THEN
    ONCE_REWRITE_TAC [← GSYM SERIES_RESTRICT] THEN
    REWRITE_TAC [IMP_IMP] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SERIES_ADD) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:num") THEN
    REWRITE_TAC [IN_DIFF, IN_UNION] THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:num) IN s", ← q r"(x:num) IN t"] THEN
    ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC)

  let SUMS_OFFSET ← prove
   r"!f l:real^N m n.
           (f sums l) (from m) /\ 0 < n /\ m <= n
           ==> (f sums l - vsum (m..n - 1) f) (from n)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"from n = from m DIFF (m..(n-1))") SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_FROM, IN_DIFF, IN_NUMSEG] THEN ASM_ARITH_TAC,
      MATCH_MP_TAC SUMS_FINITE_DIFF THEN ASM_REWRITE_TAC [FINITE_NUMSEG] THEN
      SIMP_TAC [SUBSET, IN_FROM, IN_NUMSEG]])

  let SUMS_OFFSET_REV ← prove
   r"!f:num->real^N l m n.
        (f sums l) (from m) /\ 0 < m /\ n <= m

        ==> (f sums (l + vsum(n..m-1) f)) (from n)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->real^N", ← q r"from m", ← q r"n..m-1", ← q r"l:real^N"]
                  SUMS_FINITE_UNION) THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG] THEN MATCH_MP_TAC EQ_IMP THEN
    BINOP_TAC THENL [AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC, ALL_TAC] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_UNION, IN_FROM, IN_NUMSEG] THEN
    ASM_ARITH_TAC)

  let SUMMABLE_REINDEX ← prove
   r"!k a n. summable (from n) (\x. a (x + k)) <=> summable (from(n + k)) a"
   (REWRITE_TAC [summable, ← GSYM SUMS_REINDEX])

  let SUMMABLE_EVEN ← prove
   r"!f:num->real^N n.
        summable (from n) f <=>
        summable (from (2 * n)) (\i. if EVEN i then f(i DIV 2) else vec 0)"
   (REWRITE_TAC [summable, ← GSYM SERIES_EVEN])

  let SUMMABLE_ODD ← prove
   r"!f:num->real^N n.
        summable (from n) f <=>
        summable (from (2 * n + 1)) (\i. if ODD i then f(i DIV 2) else vec 0)"
   (REWRITE_TAC [summable, ← GSYM SERIES_ODD])

  let SERIES_DROP_LE ← prove
   r"!f g s a b.
        (f sums a) s /\ (g sums b) s /\
        (!x. x IN s ==> drop(f x) <= drop(g x))
        ==> drop a <= drop b"
   (REWRITE_TAC [sums] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LE) THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
    EXISTS_TAC (← q r"\n. vsum (s INTER (0..n)) (f:num->real^1)") THEN
    EXISTS_TAC (← q r"\n. vsum (s INTER (0..n)) (g:num->real^1)") THEN
    ASM_REWRITE_TAC [DROP_VSUM] THEN EXISTS_TAC (← q r"0") THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUM_LE THEN
    ASM_SIMP_TAC [FINITE_INTER, FINITE_NUMSEG, o_THM, IN_INTER, IN_NUMSEG])

  let SERIES_DROP_POS ← prove
   r"!f s a.
        (f sums a) s /\ (!x. x IN s ==> &0 <= drop(f x))
        ==> &0 <= drop a"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(\n. vec 0):num->real^1", ← q r"f:num->real^1",
                      ← q r"s:num->bool", ← q r"vec 0:real^1", ← q r"a:real^1"]
                      SERIES_DROP_LE) THEN
    ASM_SIMP_TAC [SUMS_0, DROP_VEC])

  let SERIES_BOUND ← prove
   r"!f:num->real^N g s a b.
        (f sums a) s /\ ((lift o g) sums (lift b)) s /\
        (!i. i IN s ==> norm(f i) <= g i)
        ==> norm(a) <= b"
   (REWRITE_TAC [sums] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN
    EXISTS_TAC (← q r"\n. vsum (s INTER (0..n)) (f:num->real^N)") THEN
    ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"0") THEN
    X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
    TRANS_TAC REAL_LE_TRANS (← q r"sum (s INTER (0..m)) g") THEN CONJ_TAC THEN
    ASM_SIMP_TAC [VSUM_NORM_LE, IN_INTER, FINITE_NUMSEG, FINITE_INTER] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM sums]) THEN
    UNDISCH_TAC (← q r"((lift o g) sums lift b) s") THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM SERIES_RESTRICT] THEN
    REWRITE_TAC [← GSYM FROM_0] THEN DISCH_THEN (MP_TAC o SPEC (← q r"m + 1") o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] SUMS_OFFSET)) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"0 < m + 1"), o_DEF, ADD_SUB] THEN
    REWRITE_TAC [← GSYM VSUM_RESTRICT_SET] THEN
    REWRITE_TAC [VSUM_REAL, o_DEF, LIFT_DROP, ETA_AX] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] SERIES_DROP_POS)) THEN
    REWRITE_TAC [DROP_SUB, LIFT_DROP, ← ONCE_REWRITE_RULE [INTER_COMM] (← GSYM INTER),
                 REAL_SUB_LE] THEN
    DISCH_THEN MATCH_MP_TAC THEN REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [LIFT_DROP, DROP_VEC, REAL_LE_REFL] THEN
    ASM_MESON_TAC [← NORM_ARITH (← q r"norm(x:real^N) <= y ==> &0 <= y")])

  return { SUMMABLE_LINEAR, SUMMABLE_0, SUMMABLE_ADD, SUMMABLE_SUB, SUMMABLE_CMUL,
           SUMMABLE_NEG, SUMMABLE_IFF, SUMMABLE_EQ, SUMMABLE_FINITE, SUMMABLE_COMPONENT,
           SERIES_SUBSET, SUMMABLE_SUBSET, SUMMABLE_TRIVIAL, SUMMABLE_RESTRICT,
           SUMS_FINITE_DIFF, SUMS_FINITE_UNION, SUMS_OFFSET, SUMS_OFFSET_REV, SUMMABLE_REINDEX,
           SUMMABLE_EVEN, SUMMABLE_ODD, SERIES_DROP_LE, SERIES_DROP_POS, SERIES_BOUND }

/- ------------------------------------------------------------------------- -/
/- Similar combining theorems for infsum.  (topology.ml 22460-22564)         -/
/- ------------------------------------------------------------------------- -/

structure INF where
  INFSUM_LINEAR : thm
  INFSUM_0 : thm
  INFSUM_ADD : thm
  INFSUM_SUB : thm
  INFSUM_CMUL : thm
  INFSUM_NEG : thm
  INFSUM_EQ : thm
  INFSUM_RESTRICT : thm
  PARTIAL_SUMS_COMPONENT_LE_INFSUM : thm
  PARTIAL_SUMS_DROP_LE_INFSUM : thm
  INFSUM_EVEN : thm
  INFSUM_ODD : thm
  deriving Inhabited

@[nospecialize]
def setupINF [HolBase] (D : TopologyDeps) (BLIM2 : LIM2) (BSUM1 : SUM1) (BSUM2 : SUM2)
    (BSUM3 : SUM3) : ExceptT String IO INF := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, REAL_ARITH, .. } := D
  let { ADD_SYM, DIMINDEX_1, DISJOINT, EXTENSION, FINITE_INTER, FINITE_NUMSEG, .. } := D.core1
  let { IN_INTER, IN_NUMSEG, .. } := D.core2
  let { LE_0, LE_ADD, LE_REFL, NOT_EXISTS_THM, NOT_IN_EMPTY, NUMSEG_ADD_SPLIT, .. } := D.core3
  let { REAL_LE_ADDR, REAL_LE_TRANS, .. } := D.core4
  let { REAL_NOT_LT, REAL_SUB_LT, .. } := D.core5
  let { SUM_POS_LE, UNION_OVER_INTER, .. } := D.core6
  let { COMPONENT_LE_NORM, .. } := D.vec1
  let { VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT, VSUM_COMPONENT, VSUM_UNION, dist, drop, .. } :=
    D.vec4
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { INFSUM_UNIQUE, SERIES_0, SERIES_ADD, SERIES_CMUL, SERIES_LINEAR, SERIES_NEG,
        SERIES_RESTRICT, SERIES_SUB, SUMS_EQ, SUMS_INFSUM, infsum, summable, sums, .. } := BSUM1
  let { SERIES_EVEN, SERIES_ODD, .. } := BSUM2
  let { SUMMABLE_RESTRICT, .. } := BSUM3
  -- @@SCOPE END

  let INFSUM_LINEAR ← prove
   r"!f h s. summable s f /\ linear h
           ==> infsum s (\n. h(f n)) = h(infsum s f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INFSUM_UNIQUE THEN
    MATCH_MP_TAC SERIES_LINEAR THEN ASM_REWRITE_TAC [SUMS_INFSUM])

  let INFSUM_0 ← prove
   r"infsum s (\i. vec 0) = vec 0"
   (MATCH_MP_TAC INFSUM_UNIQUE THEN REWRITE_TAC [SERIES_0])

  let INFSUM_ADD ← prove
   r"!x y s. summable s x /\ summable s y
           ==> infsum s (\i. x i + y i) = infsum s x + infsum s y"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INFSUM_UNIQUE THEN
    MATCH_MP_TAC SERIES_ADD THEN ASM_REWRITE_TAC [SUMS_INFSUM])

  let INFSUM_SUB ← prove
   r"!x y s. summable s x /\ summable s y
           ==> infsum s (\i. x i - y i) = infsum s x - infsum s y"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INFSUM_UNIQUE THEN
    MATCH_MP_TAC SERIES_SUB THEN ASM_REWRITE_TAC [SUMS_INFSUM])

  let INFSUM_CMUL ← prove
   r"!s x c. summable s x ==> infsum s (\n. c % x n) = c % infsum s x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INFSUM_UNIQUE THEN
    MATCH_MP_TAC SERIES_CMUL THEN ASM_REWRITE_TAC [SUMS_INFSUM])

  let INFSUM_NEG ← prove
   r"!s x. summable s x ==> infsum s (\n. --(x n)) = --(infsum s x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INFSUM_UNIQUE THEN
    MATCH_MP_TAC SERIES_NEG THEN ASM_REWRITE_TAC [SUMS_INFSUM])

  let INFSUM_EQ ← prove
   r"!f g k. summable k f /\ summable k g /\ (!x. x IN k ==> f x = g x)
           ==> infsum k f = infsum k g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [infsum] THEN
    AP_TERM_TAC THEN ABS_TAC THEN ASM_MESON_TAC [SUMS_EQ, SUMS_INFSUM])

  let INFSUM_RESTRICT ← prove
   r"!k a:num->real^N.
        infsum (:num) (\n. if n IN k then a n else vec 0) = infsum k a"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"a:num->real^N", ← q r"k:num->bool"] SUMMABLE_RESTRICT) THEN
    ASM_CASES_TAC (← q r"summable k (a:num->real^N)") THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THENL
     [MATCH_MP_TAC INFSUM_UNIQUE THEN
      ASM_REWRITE_TAC [SERIES_RESTRICT, SUMS_INFSUM],
      RULE_ASSUM_TAC (REWRITE_RULE [summable, NOT_EXISTS_THM]) THEN
      ASM_REWRITE_TAC [infsum]])

  let PARTIAL_SUMS_COMPONENT_LE_INFSUM ← prove
   r"!f:num->real^N s k n.
        1 <= k /\ k <= dimindex(:N) /\
        (!i. i IN s ==> &0 <= (f i)$k) /\
        summable s f
        ==> (vsum (s INTER (0..n)) f)$k <= (infsum s f)$k"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM SUMS_INFSUM] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [sums, LIM_SEQUENTIALLY] THEN DISCH_TAC THEN
    REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"vsum (s INTER (0..n)) (f:num->real^N)$k - (infsum s f)$k")) THEN
    ASM_REWRITE_TAC [REAL_SUB_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") (MP_TAC o SPEC (← q r"N + n:num"))) THEN
    REWRITE_TAC [LE_ADD, REAL_NOT_LT, dist] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"abs((vsum (s INTER (0..N + n)) f - infsum s f:real^N)$k)") THEN
    ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN REWRITE_TAC [VECTOR_SUB_COMPONENT] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"s < a /\ a <= b ==> a - s <= abs(b - s)")) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [ADD_SYM] THEN
    SIMP_TAC [NUMSEG_ADD_SPLIT, LE_0, UNION_OVER_INTER] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) VSUM_UNION o lhand o rand o snd) THEN
    ANTS_TAC THENL
     [SIMP_TAC [FINITE_INTER, FINITE_NUMSEG, DISJOINT, EXTENSION] THEN
      REWRITE_TAC [IN_INTER, NOT_IN_EMPTY, IN_NUMSEG] THEN ARITH_TAC,
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [REAL_LE_ADDR, VECTOR_ADD_COMPONENT] THEN
      ASM_SIMP_TAC [VSUM_COMPONENT] THEN MATCH_MP_TAC SUM_POS_LE THEN
      ASM_SIMP_TAC [FINITE_INTER, IN_INTER, FINITE_NUMSEG]])

  let PARTIAL_SUMS_DROP_LE_INFSUM ← prove
   r"!f s n.
        (!i. i IN s ==> &0 <= drop(f i)) /\
        summable s f
        ==> drop(vsum (s INTER (0..n)) f) <= drop(infsum s f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [drop] THEN
    MATCH_MP_TAC PARTIAL_SUMS_COMPONENT_LE_INFSUM THEN
    ASM_REWRITE_TAC [DIMINDEX_1, LE_REFL, ← GSYM drop])

  let INFSUM_EVEN ← prove
   r"!f:num->real^N n.
        infsum (from n) f =
        infsum (from (2 * n)) (\i. if EVEN i then f(i DIV 2) else vec 0)"
   (REWRITE_TAC [infsum, ← GSYM SERIES_EVEN])

  let INFSUM_ODD ← prove
   r"!f:num->real^N n.
        infsum (from n) f =
        infsum (from (2 * n + 1)) (\i. if ODD i then f(i DIV 2) else vec 0)"
   (REWRITE_TAC [infsum, ← GSYM SERIES_ODD])

  return { INFSUM_LINEAR, INFSUM_0, INFSUM_ADD, INFSUM_SUB, INFSUM_CMUL, INFSUM_NEG, INFSUM_EQ,
           INFSUM_RESTRICT, PARTIAL_SUMS_COMPONENT_LE_INFSUM, PARTIAL_SUMS_DROP_LE_INFSUM,
           INFSUM_EVEN, INFSUM_ODD }

/- ------------------------------------------------------------------------- -/
/- Cauchy criterion for series.  (topology.ml 22565-22677)                   -/
/- ------------------------------------------------------------------------- -/

structure CAU where
  SEQUENCE_CAUCHY_WLOG : thm
  VSUM_DIFF_LEMMA : thm
  NORM_VSUM_TRIVIAL_LEMMA : thm
  SERIES_CAUCHY : thm
  SUMMABLE_CAUCHY : thm
  SUMMABLE_IFF_EVENTUALLY : thm
  SUMMABLE_EQ_EVENTUALLY : thm
  SUMMABLE_IFF_COFINITE : thm
  SUMMABLE_EQ_COFINITE : thm
  SUMMABLE_FROM_ELSEWHERE : thm
  SUMMABLE_FROM_ELSEWHERE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupCAU [HolBase] (D : TopologyDeps) (BCMP : CMP) (BSUM1 : SUM1) (BSUM3 : SUM3) :
    ExceptT String IO CAU := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EQ_IMP, EXTENSION, FINITE_INTER, FINITE_NUMSEG, .. } := D.core1
  let { FINITE_SUBSET, FUN_EQ_THM, GE, IMP_CONJ, INTER_EMPTY, IN_DIFF, IN_INTER, IN_NUMSEG, .. } :=
    D.core2
  let { IN_UNION, IN_UNIV, LE_CASES, MONO_FORALL, NOT_LT, NUMSEG_EMPTY, .. } := D.core3
  let { SUBSET, .. } := D.core5
  let { IN_FROM, UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { DIST_SYM, .. } := D.vec1
  let { NORM_0, .. } := D.vec3
  let { VSUM_CLAUSES, VSUM_DIFF, VSUM_EQ, dist, .. } := D.vec4
  let { CONVERGENT_EQ_CAUCHY, cauchy, .. } := BCMP
  let { summable, sums, .. } := BSUM1
  let { SUMMABLE_RESTRICT, .. } := BSUM3
  -- @@SCOPE END

  let SEQUENCE_CAUCHY_WLOG ← prove
   r"!P s. (!m n:num. P m /\ P n ==> dist(s m,s n) < e) <=>
         (!m n. P m /\ P n /\ m <= n ==> dist(s m,s n) < e)"
   (MESON_TAC [DIST_SYM, LE_CASES])

  let VSUM_DIFF_LEMMA ← prove
   r"!f:num->real^N k m n.
        m <= n
        ==> vsum(k INTER (0..n)) f - vsum(k INTER (0..m)) f =
            vsum(k INTER (m+1..n)) f"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->real^N", ← q r"k INTER (0..n)", ← q r"k INTER (0..m)"]
      VSUM_DIFF) THEN
    ANTS_TAC THENL
     [SIMP_TAC [FINITE_INTER, FINITE_NUMSEG] THEN MATCH_MP_TAC
       (← SET_RULE (← q r"s SUBSET t ==> (u INTER s SUBSET u INTER t)")) THEN
      REWRITE_TAC [SUBSET, IN_NUMSEG] THEN POP_ASSUM MP_TAC THEN ARITH_TAC,
      DISCH_THEN (SUBST1_TAC o SYM) THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [← SET_RULE
       (← q r"(k INTER s) DIFF (k INTER t) = k INTER (s DIFF t)")] THEN
      AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_DIFF, IN_NUMSEG] THEN
      POP_ASSUM MP_TAC THEN ARITH_TAC])

  let NORM_VSUM_TRIVIAL_LEMMA ← prove
   r"!e. &0 < e ==> (P ==> norm(vsum(s INTER (m..n)) f) < e <=>
                   P ==> n < m \/ norm(vsum(s INTER (m..n)) f) < e)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"n:num < m") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE id [← GSYM NUMSEG_EMPTY]) THEN
    ASM_REWRITE_TAC [VSUM_CLAUSES, NORM_0, INTER_EMPTY])

  let SERIES_CAUCHY ← prove
   r"!f s. (?l. (f sums l) s) =
         !e. &0 < e
             ==> ?N. !m n. m >= N
                           ==> norm(vsum(s INTER (m..n)) f) < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [sums, CONVERGENT_EQ_CAUCHY, cauchy] THEN
    REWRITE_TAC [SEQUENCE_CAUCHY_WLOG] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
    SIMP_TAC [dist, VSUM_DIFF_LEMMA, NORM_VSUM_TRIVIAL_LEMMA] THEN
    REWRITE_TAC [GE, ← TAUT (← q r"a ==> b \/ c <=> a /\ ~b ==> c")] THEN
    REWRITE_TAC [NOT_LT, ← ARITH_RULE
     (← q r"(N <= m /\ N <= n /\ m <= n) /\ m + 1 <= n <=>
      N + 1 <= m + 1 /\ m + 1 <= n")] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THENL
     [EXISTS_TAC (← q r"N + 1"), EXISTS_TAC (← q r"N:num")] THEN
    REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← ARITH_RULE (← q r"N + 1 <= m + 1 ==> N <= m + 1")] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"m - 1", ← q r"n:num"]) THEN
    SUBGOAL_THEN (← q r"m - 1 + 1 = m") SUBST_ALL_TAC THENL
     [ALL_TAC, ANTS_TAC THEN SIMP_TAC []] THEN
    ASM_ARITH_TAC)

  let SUMMABLE_CAUCHY ← prove
   r"!f s. summable s f <=>
         !e. &0 < e
             ==> ?N. !m n. m >= N ==> norm(vsum(s INTER (m..n)) f) < e"
   (REWRITE_TAC [summable, ← GSYM SERIES_CAUCHY])

  let SUMMABLE_IFF_EVENTUALLY ← prove
   r"!f g k. (?N. !n. N <= n /\ n IN k ==> f n = g n)
           ==> (summable k f <=> summable k g)"
   (REWRITE_TAC [summable, SERIES_CAUCHY] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N0:num") STRIP_ASSUME_TAC) THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"e:real") THEN
    AP_TERM_TAC THEN EQ_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N1:num")
     (fun th => tactic_of do pure (EXISTS_TAC (← q r"N0 + N1:num") THEN MP_TAC th))) THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    (ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC]) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    MATCH_MP_TAC VSUM_EQ THEN ASM_SIMP_TAC [IN_INTER, IN_NUMSEG] THEN
    REPEAT STRIP_TAC THENL [ALL_TAC, CONV_TAC SYM_CONV] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_ARITH_TAC)

  let SUMMABLE_EQ_EVENTUALLY ← prove
   r"!f g k. (?N. !n. N <= n /\ n IN k ==> f n = g n) /\ summable k f
           ==> summable k g"
   (MESON_TAC [SUMMABLE_IFF_EVENTUALLY])

  let SUMMABLE_IFF_COFINITE ← prove
   r"!f s t. FINITE((s DIFF t) UNION (t DIFF s))
           ==> (summable s f <=> summable t f)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM SUMMABLE_RESTRICT] THEN
    MATCH_MP_TAC SUMMABLE_IFF_EVENTUALLY THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"\x:num.x") o MATCH_MP UPPER_BOUND_FINITE_SET) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") MP_TAC) THEN REWRITE_TAC [IN_UNIV] THEN
    DISCH_TAC THEN EXISTS_TAC (← q r"N + 1") THEN
    REWRITE_TAC [← ARITH_RULE (← q r"N + 1 <= n <=> ~(n <= N)")] THEN ASM SET_TAC [])

  let SUMMABLE_EQ_COFINITE ← prove
   r"!f s t. FINITE((s DIFF t) UNION (t DIFF s)) /\ summable s f
           ==> summable t f"
   (MESON_TAC [SUMMABLE_IFF_COFINITE])

  let SUMMABLE_FROM_ELSEWHERE ← prove
   r"!f m n. summable (from m) f ==> summable (from n) f"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUMMABLE_EQ_COFINITE) THEN
    MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"0..(m+n)") THEN
    SIMP_TAC [FINITE_NUMSEG, SUBSET, IN_NUMSEG, IN_UNION, IN_DIFF, IN_FROM] THEN
    ARITH_TAC)

  let SUMMABLE_FROM_ELSEWHERE_EQ ← prove
   r"!n m f:num->real^N. summable (from m) f <=> summable (from n) f"
   (MESON_TAC [SUMMABLE_FROM_ELSEWHERE])

  return { SEQUENCE_CAUCHY_WLOG, VSUM_DIFF_LEMMA, NORM_VSUM_TRIVIAL_LEMMA, SERIES_CAUCHY,
           SUMMABLE_CAUCHY, SUMMABLE_IFF_EVENTUALLY, SUMMABLE_EQ_EVENTUALLY,
           SUMMABLE_IFF_COFINITE, SUMMABLE_EQ_COFINITE, SUMMABLE_FROM_ELSEWHERE,
           SUMMABLE_FROM_ELSEWHERE_EQ }

/- ------------------------------------------------------------------------- -/
/- Uniform Cauchy criterion, terms tend to zero, comparison tests.           -/
/- (topology.ml 22678-22857)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CMT where
  SERIES_CAUCHY_UNIFORM : thm
  SERIES_GOESTOZERO : thm
  SUMMABLE_IMP_TOZERO : thm
  SUMMABLE_IMP_BOUNDED : thm
  SUMMABLE_IMP_SUMS_BOUNDED : thm
  SERIES_COMPARISON : thm
  SUMMABLE_COMPARISON : thm
  SERIES_LIFT_ABSCONV_IMP_CONV : thm
  SUMMABLE_SUBSET_ABSCONV : thm
  SERIES_COMPARISON_BOUND : thm
  SERIES_COMPARISON_UNIFORM : thm
  deriving Inhabited

@[nospecialize]
def setupCMT [HolBase] (D : TopologyDeps) (BLIM2 : LIM2) (BBND1 : BND1) (BCMP : CMP)
    (BNST : NST) (BSUM1 : SUM1) (BSUM3 : SUM3) (BCAU : CAU) : ExceptT String IO CMT := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE,
        NORM_ARITH, .. } := D
  let { ETA_AX, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, GE, INTER_UNIV, IN_INTER, IN_NUMSEG, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_0, MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_LT,
        NUMSEG_SING, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_REFL, REAL_LT_IMP_LE, .. } := D.core4
  let { SIMPLE_IMAGE, .. } := D.core5
  let { o_DEF, .. } := D.core6
  let { FINITE_INTER_NUMSEG, FROM_0, FROM_INTER_NUMSEG, REAL_HALF, .. } := D.misc
  let { DIST_SYM, .. } := D.vec1
  let { LIFT_DROP, LIFT_SUM, .. } := D.vec2
  let { NORM_0, NORM_LIFT, NORM_POS_LE, REAL_ABS_NORM, .. } := D.vec3
  let { VSUM_CLAUSES_NUMSEG, VSUM_NORM_LE, VSUM_SING, dist, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { BOUNDED_POS, .. } := BBND1
  let { CONVERGENT_IMP_BOUNDED, cauchy, .. } := BCMP
  let { UNIFORMLY_CONVERGENT_EQ_CAUCHY, .. } := BNST
  let { summable, sums, .. } := BSUM1
  let { SERIES_BOUND, SUMMABLE_RESTRICT, SUMMABLE_SUBSET, .. } := BSUM3
  let { NORM_VSUM_TRIVIAL_LEMMA, SEQUENCE_CAUCHY_WLOG, SERIES_CAUCHY, VSUM_DIFF_LEMMA, .. } :=
    BCAU
  -- @@SCOPE END

  let SERIES_CAUCHY_UNIFORM ← prove
   r"!P f:A->num->real^N k.
        (?l. !e. &0 < e
                 ==> ?N. !n x. N <= n /\ P x
                               ==> dist(vsum(k INTER (0..n)) (f x),
                                        l x) < e) <=>
        (!e. &0 < e ==> ?N. !m n x. N <= m /\ P x
                                    ==> norm(vsum(k INTER (m..n)) (f x)) < e)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [sums, UNIFORMLY_CONVERGENT_EQ_CAUCHY, cauchy] THEN
    ONCE_REWRITE_TAC [← MESON []
     (← q r"(!m n:num y. N <= m /\ N <= n /\ P y ==> Q m n y) <=>
      (!y. P y ==> !m n. N <= m /\ N <= n ==> Q m n y)")] THEN
    REWRITE_TAC [SEQUENCE_CAUCHY_WLOG] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
    SIMP_TAC [dist, VSUM_DIFF_LEMMA, NORM_VSUM_TRIVIAL_LEMMA] THEN
    REWRITE_TAC [GE, ← TAUT (← q r"a ==> b \/ c <=> a /\ ~b ==> c")] THEN
    REWRITE_TAC [NOT_LT, ← ARITH_RULE
     (← q r"(N <= m /\ N <= n /\ m <= n) /\ m + 1 <= n <=>
      N + 1 <= m + 1 /\ m + 1 <= n")] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THENL
     [EXISTS_TAC (← q r"N + 1"), EXISTS_TAC (← q r"N:num")] THEN
    REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← ARITH_RULE (← q r"N + 1 <= m + 1 ==> N <= m + 1")] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"m - 1", ← q r"n:num"]) THEN
    SUBGOAL_THEN (← q r"m - 1 + 1 = m") SUBST_ALL_TAC THENL
     [ALL_TAC, ANTS_TAC THEN SIMP_TAC []] THEN
    ASM_ARITH_TAC)

  let SERIES_GOESTOZERO ← prove
   r"!s x. summable s x
         ==> !e. &0 < e
                 ==> eventually (\n. n IN s ==> norm(x n) < e) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [summable, SERIES_CAUCHY] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"n:num") THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"n:num"]) THEN
    ASM_SIMP_TAC [NUMSEG_SING, GE, ← SET_RULE (← q r"n IN s ==> s INTER {n} = {n}")] THEN
    REWRITE_TAC [VSUM_SING])

  let SUMMABLE_IMP_TOZERO ← prove
   r"!f:num->real^N k.
       summable k f
       ==> ((\n. if n IN k then f(n) else vec 0) --> vec 0) sequentially"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM SUMMABLE_RESTRICT] THEN
    REWRITE_TAC [summable, LIM_SEQUENTIALLY, INTER_UNIV, sums] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"l:real^N")) THEN X_GEN_TAC (← q r"e:real") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN EXISTS_TAC (← q r"N + 1") THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"n - 1") th) THEN MP_TAC (← SPEC (← q r"n:num") th))) THEN
    ASM_SIMP_TAC [← ARITH_RULE (← q r"N + 1 <= n ==> N <= n /\ N <= n - 1")] THEN
    ABBREV_TAC (← q r"m = n - 1") THEN
    SUBGOAL_THEN (← q r"n = SUC m") SUBST1_TAC THENL
     [ASM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [VSUM_CLAUSES_NUMSEG, LE_0] THEN
    REWRITE_TAC [← NORM_ARITH (← q r"dist(x,vec 0) = norm x")] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [NORM_0] THEN CONV_TAC (fun t => NORM_ARITH t))

  let SUMMABLE_IMP_BOUNDED ← prove
   r"!f:num->real^N k. summable k f ==> bounded (IMAGE f k)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP SUMMABLE_IMP_TOZERO) THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONVERGENT_IMP_BOUNDED) THEN
    REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE, IN_UNIV] THEN
    MATCH_MP_TAC MONO_EXISTS THEN MESON_TAC [REAL_LT_IMP_LE, NORM_0])

  let SUMMABLE_IMP_SUMS_BOUNDED ← prove
   r"!f:num->real^N k.
       summable (from k) f ==> bounded { vsum(k..n) f | n IN (:num) }"
   (REWRITE_TAC [summable, sums, LEFT_IMP_EXISTS_THM] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONVERGENT_IMP_BOUNDED) THEN
    REWRITE_TAC [FROM_INTER_NUMSEG, SIMPLE_IMAGE])

  let SERIES_COMPARISON ← prove
   r"!f g s. (?l. ((lift o g) sums l) s) /\
           (?N. !n. n >= N /\ n IN s ==> norm(f n) <= g n)
           ==> ?l:real^N. (f sums l) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SERIES_CAUCHY] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (X_CHOOSE_TAC (← q r"N1:num"))) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N2:num")) THEN
    EXISTS_TAC (← q r"N1 + N2:num") THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"norm (vsum (s INTER (m .. n)) (lift o g))") THEN CONJ_TAC THENL
     [SIMP_TAC [← GSYM LIFT_SUM, FINITE_INTER_NUMSEG, NORM_LIFT] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= a ==> x <= abs(a)")) THEN
      MATCH_MP_TAC VSUM_NORM_LE THEN
      REWRITE_TAC [FINITE_INTER_NUMSEG, IN_INTER, IN_NUMSEG] THEN
      ASM_MESON_TAC [← ARITH_RULE (← q r"m >= N1 + N2:num /\ m <= x ==> x >= N1")],
      ASM_MESON_TAC [← ARITH_RULE (← q r"m >= N1 + N2:num ==> m >= N2")]])

  let SUMMABLE_COMPARISON ← prove
   r"!f g s. summable s (lift o g) /\
           (?N. !n. n >= N /\ n IN s ==> norm(f n) <= g n)
           ==> summable s f"
   (REWRITE_TAC [summable, SERIES_COMPARISON])

  let SERIES_LIFT_ABSCONV_IMP_CONV ← prove
   r"!x:num->real^N k. summable k (\n. lift(norm(x n))) ==> summable k x"
   (REWRITE_TAC [summable] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SERIES_COMPARISON THEN
    EXISTS_TAC (← q r"\n:num. norm(x n:real^N)") THEN
    ASM_REWRITE_TAC [o_DEF, REAL_LE_REFL] THEN ASM_MESON_TAC [])

  let SUMMABLE_SUBSET_ABSCONV ← prove
   r"!x:num->real^N s t.
        summable s (\n. lift(norm(x n))) /\ t SUBSET s
        ==> summable t (\n. lift(norm(x n)))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUMMABLE_SUBSET THEN
    EXISTS_TAC (← q r"s:num->bool") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [summable] THEN MATCH_MP_TAC SERIES_COMPARISON THEN
    EXISTS_TAC (← q r"\n:num. norm(x n:real^N)") THEN
    ASM_REWRITE_TAC [o_DEF, ← GSYM summable] THEN
    EXISTS_TAC (← q r"0") THEN REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC [REAL_LE_REFL, NORM_LIFT, REAL_ABS_NORM, NORM_0, NORM_POS_LE])

  let SERIES_COMPARISON_BOUND ← prove
   r"!f:num->real^N g s a.
        (g sums a) s /\ (!i. i IN s ==> norm(f i) <= drop(g i))
        ==> ?l. (f sums l) s /\ norm(l) <= drop a"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->real^N", ← q r"drop o (g:num->real^1)",
                      ← q r"s:num->bool"] SUMMABLE_COMPARISON) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, GE, ETA_AX, summable] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
    X_GEN_TAC (← q r"l:real^N") THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [FROM_0, INTER_UNIV, sums]) THEN
    MATCH_MP_TAC SERIES_BOUND THEN MAP_EVERY EXISTS_TAC
     [← q r"f:num->real^N", ← q r"drop o (g:num->real^1)", ← q r"s:num->bool"] THEN
    ASM_REWRITE_TAC [sums, o_DEF, LIFT_DROP, ETA_AX])

  let SERIES_COMPARISON_UNIFORM ← prove
   r"!f g P s. (?l. ((lift o g) sums l) s) /\
             (?N. !n x. N <= n /\ n IN s /\ P x ==> norm(f x n) <= g n)
             ==> ?l:A->real^N.
                    !e. &0 < e
                        ==> ?N. !n x. N <= n /\ P x
                                      ==> dist(vsum(s INTER (0..n)) (f x),
                                               l x) < e"
   (REPEAT GEN_TAC THEN SIMP_TAC [GE, SERIES_CAUCHY, SERIES_CAUCHY_UNIFORM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (X_CHOOSE_TAC (← q r"N1:num"))) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N2:num")) THEN
    EXISTS_TAC (← q r"N1 + N2:num") THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num", ← q r"x:A"] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"norm (vsum (s INTER (m .. n)) (lift o g))") THEN CONJ_TAC THENL
     [SIMP_TAC [← GSYM LIFT_SUM, FINITE_INTER_NUMSEG, NORM_LIFT] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= a ==> x <= abs(a)")) THEN
      MATCH_MP_TAC VSUM_NORM_LE THEN
      REWRITE_TAC [FINITE_INTER_NUMSEG, IN_INTER, IN_NUMSEG] THEN
      ASM_MESON_TAC [← ARITH_RULE (← q r"N1 + N2:num <= m /\ m <= x ==> N1 <= x")],
      ASM_MESON_TAC [← ARITH_RULE (← q r"N1 + N2:num <= m ==> N2 <= m")]])

  return { SERIES_CAUCHY_UNIFORM, SERIES_GOESTOZERO, SUMMABLE_IMP_TOZERO, SUMMABLE_IMP_BOUNDED,
           SUMMABLE_IMP_SUMS_BOUNDED, SERIES_COMPARISON, SUMMABLE_COMPARISON,
           SERIES_LIFT_ABSCONV_IMP_CONV, SUMMABLE_SUBSET_ABSCONV, SERIES_COMPARISON_BOUND,
           SERIES_COMPARISON_UNIFORM }

/- ------------------------------------------------------------------------- -/
/- Ratio test and boundedness of partial sums.  (topology.ml 22858-23015)    -/
/- ------------------------------------------------------------------------- -/

structure RAT where
  SERIES_RATIO : thm
  SUMMABLE_RATIO : thm
  SUMMABLE_REAL_GP : thm
  BOUNDED_PARTIAL_SUMS : thm
  deriving Inhabited

@[nospecialize]
def setupRAT [HolBase] (D : TopologyDeps) (BBND1 : BND1) (BBND2 : BND2) (BSUM1 : SUM1)
    (BCAU : CAU) (BCMT : CMT) : ExceptT String IO RAT := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, VECTOR_ARITH_TAC, NORM_ARITH, .. } := D
  let { ADD_CLAUSES, ADD_SUB2, FINITE_INTER, FINITE_NUMSEG, .. } := D.core1
  let { FINITE_NUMSEG_LT, FORALL_IN_IMAGE, GE, IMP_CONJ, IMP_IMP, IN_DIFF, IN_ELIM_THM,
        IN_INTER, IN_NUMSEG, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_ADD, LE_EXISTS, LT, NUMSEG_LT, REAL_ABS_DIV,
        REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_POS, REAL_ABS_POW, .. } := D.core3
  let { REAL_ARCH_POW_INV, REAL_INV_1_LE, REAL_INV_MUL, REAL_LET_TRANS, REAL_LE_LMUL,
        REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NE, REAL_LT_LDIV_EQ, REAL_LT_MUL, REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_AC, REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID,
        REAL_MUL_RZERO, REAL_MUL_SYM, REAL_POW_1_LE, REAL_POW_ADD, REAL_POW_INV, REAL_POW_LE,
        REAL_POW_LE_1, REAL_POW_LT, REAL_SUB_LE, REAL_SUB_LT, SIMPLE_IMAGE, SUBSET, .. } :=
    D.core5
  let { SUM_LMUL, SUM_OFFSET, SUM_POS_LE, SUM_SUBSET, SUM_TRIV_NUMSEG, o_DEF, real_div,
        real_pow, .. } := D.core6
  let { FINITE_INTER_NUMSEG, SUM_GP, .. } := D.misc
  let { LIFT_NUM, LIFT_SUM, .. } := D.vec2
  let { NORM_0, NORM_LIFT, NORM_POS_LE, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_SUB_REFL, VSUM_COMBINE_L, VSUM_NORM, VSUM_TRIV_NUMSEG, .. } := D.vec4
  let { BOUNDED_POS, BOUNDED_SUBSET, BOUNDED_UNION, bounded, .. } := BBND1
  let { BOUNDED_DIFFS, .. } := BBND2
  let { SERIES_0, summable, .. } := BSUM1
  let { SERIES_CAUCHY, .. } := BCAU
  let { SERIES_COMPARISON, .. } := BCMT
  -- @@SCOPE END

  let SERIES_RATIO ← prove
   r"!c a s N.
      c < &1 /\
      (!n. n >= N ==> norm(a(SUC n)) <= c * norm(a(n)))
      ==> ?l:real^N. (a sums l) s"
   (REWRITE_TAC [GE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SERIES_COMPARISON THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"c <= &0 \/ &0 < c")) THENL
     [EXISTS_TAC (← q r"\n:num. &0") THEN REWRITE_TAC [o_DEF, LIFT_NUM] THEN
      CONJ_TAC THENL [MESON_TAC [SERIES_0], ALL_TAC] THEN
      EXISTS_TAC (← q r"N + 1") THEN REWRITE_TAC [GE] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"c * norm(a(n - 1):real^N)") THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [← ARITH_RULE (← q r"N + 1 <= n ==> SUC(n - 1) = n /\ N <= n - 1")],
        ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= --c * x ==> c * x <= &0")) THEN
      MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [NORM_POS_LE] THEN
      UNDISCH_TAC (← q r"c <= &0") THEN REAL_ARITH_TAC,
      ASSUME_TAC (← MATCH_MP REAL_LT_IMP_LE (← ASSUME (← q r"&0 < c")))] THEN
    EXISTS_TAC (← q r"\n. norm(a(N):real^N) * c pow (n - N)") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC,
      EXISTS_TAC (← q r"N:num") THEN
      SIMP_TAC [GE, LE_EXISTS, IMP_CONJ, ADD_SUB2, LEFT_IMP_EXISTS_THM] THEN
      SUBGOAL_THEN (← q r"!d:num. norm(a(N + d):real^N) <= norm(a N) * c pow d")
       (fun th => MESON_TAC [th]) THEN INDUCT_TAC THEN
      REWRITE_TAC [ADD_CLAUSES, real_pow, REAL_MUL_RID, REAL_LE_REFL] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"c * norm((a:num->real^N) (N + d))") THEN
      ASM_SIMP_TAC [LE_ADD] THEN ASM_MESON_TAC [REAL_LE_LMUL, REAL_MUL_AC]] THEN
    GEN_REWRITE_TAC id [SERIES_CAUCHY] THEN X_GEN_TAC (← q r"e:real") THEN
    SIMP_TAC [← GSYM LIFT_SUM, FINITE_INTER, NORM_LIFT, FINITE_NUMSEG] THEN
    DISCH_TAC THEN SIMP_TAC [SUM_LMUL, FINITE_INTER, FINITE_NUMSEG] THEN
    ASM_CASES_TAC (← q r"(a:num->real^N) N = vec 0") THENL
     [ASM_REWRITE_TAC [NORM_0, REAL_MUL_LZERO, REAL_ABS_NUM], ALL_TAC] THEN
    MP_TAC (← SPECL [← q r"c:real", ← q r"((&1 - c) * e) / norm((a:num->real^N) N)"]
                 REAL_ARCH_POW_INV) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_MUL, REAL_SUB_LT, NORM_POS_LT, GE] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"M:num")) THEN EXISTS_TAC (← q r"N + M:num") THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"abs(norm((a:num->real^N) N) *
                    sum(m..n) (\i. c pow (i - N)))") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [REAL_ABS_MUL] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
      REWRITE_TAC [REAL_ABS_POS] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ x <= y ==> abs x <= abs y")) THEN
      ASM_SIMP_TAC [SUM_POS_LE, FINITE_INTER_NUMSEG, REAL_POW_LE] THEN
      MATCH_MP_TAC SUM_SUBSET THEN ASM_SIMP_TAC [REAL_POW_LE] THEN
      REWRITE_TAC [FINITE_INTER_NUMSEG, FINITE_NUMSEG] THEN
      REWRITE_TAC [IN_INTER, IN_DIFF] THEN MESON_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_NORM] THEN
    DISJ_CASES_TAC (← ARITH_RULE (← q r"n:num < m \/ m <= n")) THENL
     [ASM_SIMP_TAC [SUM_TRIV_NUMSEG, REAL_ABS_NUM, REAL_MUL_RZERO], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"m = 0 + m /\ n = (n - m) + m") (CONJUNCTS_THEN SUBST1_TAC) THENL
     [UNDISCH_TAC (← q r"m:num <= n") THEN ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [SUM_OFFSET] THEN UNDISCH_TAC (← q r"N + M:num <= m") THEN
    SIMP_TAC [LE_EXISTS] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"d:num") SUBST_ALL_TAC) THEN
    REWRITE_TAC [← ARITH_RULE (← q r"(i + (N + M) + d) - N:num = (M + d) + i")] THEN
    ONCE_REWRITE_TAC [REAL_POW_ADD] THEN REWRITE_TAC [SUM_LMUL, SUM_GP] THEN
    ASM_SIMP_TAC [LT, REAL_LT_IMP_NE] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, NORM_POS_LT, REAL_ABS_MUL] THEN
    REWRITE_TAC [REAL_ABS_POW] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, REAL_ABS_DIV, REAL_POW_LT, ← REAL_ARITH
     (← q r"&0 < c /\ c < &1 ==> &0 < abs c /\ &0 < abs(&1 - c)"), REAL_LT_LDIV_EQ] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"&0 < x /\ x <= &1 /\ &1 <= e ==> abs(c pow 0 - x) < e")) THEN
    ASM_SIMP_TAC [REAL_POW_LT, REAL_POW_1_LE, REAL_LT_IMP_LE] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"c < &1 ==> x * abs(&1 - c) = (&1 - c) * x")] THEN
    REWRITE_TAC [real_div, REAL_INV_MUL, REAL_POW_ADD, REAL_MUL_ASSOC] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"(((a * b) * c) * d) * e = (e * ((a * b) * c)) * d")] THEN
    ASM_SIMP_TAC [← GSYM real_div, REAL_LE_RDIV_EQ, REAL_POW_LT, REAL_MUL_LID,
                  ← REAL_ARITH (← q r"&0 < c ==> abs c = c")] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"xm < e ==> &0 <= (d - &1) * e ==> xm <= d * e"))) THEN
    MATCH_MP_TAC REAL_LE_MUL THEN CONJ_TAC THENL
     [REWRITE_TAC [REAL_SUB_LE, ← GSYM REAL_POW_INV] THEN
      MATCH_MP_TAC REAL_POW_LE_1 THEN
      MATCH_MP_TAC REAL_INV_1_LE THEN ASM_SIMP_TAC [REAL_LT_IMP_LE],
      MATCH_MP_TAC REAL_LT_IMP_LE THEN
      ASM_SIMP_TAC [REAL_SUB_LT, REAL_LT_MUL, REAL_LT_DIV, NORM_POS_LT]])

  let SUMMABLE_RATIO ← prove
   r"!c a:num->real^N s N.
      c < &1 /\
      (!n. n >= N ==> norm(a(SUC n)) <= c * norm(a(n)))
      ==> summable s a"
   (REWRITE_TAC [summable, SERIES_RATIO])

  let SUMMABLE_REAL_GP ← prove
   r"!x k. abs x < &1 ==> summable k (\n. lift(x pow n))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUMMABLE_RATIO THEN
    MAP_EVERY EXISTS_TAC [← q r"abs x", ← q r"0"] THEN
    ASM_REWRITE_TAC [NORM_LIFT, real_pow, REAL_ABS_MUL, REAL_LE_REFL])

  let BOUNDED_PARTIAL_SUMS ← prove
   r"!f:num->real^N k.
        bounded { vsum(k..n) f | n IN (:num) }
        ==> bounded { vsum(m..n) f | m IN (:num) /\ n IN (:num) }"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"bounded { vsum(0..n) f:real^N | n IN (:num) }") MP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BOUNDED_POS]) THEN
      REWRITE_TAC [bounded] THEN
      REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, IN_UNIV] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"sum { i:num | i < k} (\i. norm(f i:real^N)) + B") THEN
      X_GEN_TAC (← q r"i:num") THEN ASM_CASES_TAC (← q r"i:num < k") THENL
       [MATCH_MP_TAC (← REAL_ARITH
         (← q r"!y. x <= y /\ y <= a /\ &0 < b ==> x <= a + b")) THEN
        EXISTS_TAC (← q r"sum (0..i) (\i. norm(f i:real^N))") THEN
        ASM_SIMP_TAC [VSUM_NORM, FINITE_NUMSEG] THEN
        MATCH_MP_TAC SUM_SUBSET THEN
        REWRITE_TAC [FINITE_NUMSEG, FINITE_NUMSEG_LT, NORM_POS_LE] THEN
        REWRITE_TAC [IN_DIFF, IN_NUMSEG, IN_ELIM_THM] THEN ASM_ARITH_TAC,
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"k = 0") THENL
       [FIRST_X_ASSUM SUBST_ALL_TAC THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"x <= B /\ &0 <= b ==> x <= b + B")) THEN
        ASM_SIMP_TAC [SUM_POS_LE, FINITE_NUMSEG_LT, NORM_POS_LE],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"f:num->real^N", ← q r"0", ← q r"k:num", ← q r"i:num"]
        VSUM_COMBINE_L) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_REWRITE_TAC [NUMSEG_LT] THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(x) <= a /\ norm(y) <= b ==> norm(x + y) <= a + b")) THEN
      ASM_SIMP_TAC [VSUM_NORM, FINITE_NUMSEG],
      ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← MATCH_MP BOUNDED_DIFFS (← W CONJ th)) THEN MP_TAC th)) THEN
    REWRITE_TAC [IMP_IMP, ← GSYM BOUNDED_UNION] THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"a /\ b ==> c <=> b ==> a ==> c")]
          BOUNDED_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION, LEFT_IMP_EXISTS_THM, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"m:num", ← q r"n:num"] THEN
    DISCH_THEN SUBST1_TAC THEN
    ASM_CASES_TAC (← q r"m = 0") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"n:num < m") THENL
     [DISJ2_TAC THEN REPEAT (EXISTS_TAC (← q r"vsum(0..0) (f:num->real^N)")) THEN
      ASM_SIMP_TAC [VSUM_TRIV_NUMSEG, VECTOR_SUB_REFL] THEN MESON_TAC [],
      ALL_TAC] THEN
    DISJ2_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"vsum(0..n) (f:num->real^N)", ← q r"vsum(0..(m-1)) (f:num->real^N)"] THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:num->real^N", ← q r"0", ← q r"m:num", ← q r"n:num"]
        VSUM_COMBINE_L) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, VECTOR_ARITH_TAC])

  return { SERIES_RATIO, SUMMABLE_RATIO, SUMMABLE_REAL_GP, BOUNDED_PARTIAL_SUMS }

/- ------------------------------------------------------------------------- -/
/- General Dirichlet convergence test (could make this uniform on a set),    -/
/- and rearranging absolutely convergent series.  (topology.ml 23016-23218)  -/
/- ------------------------------------------------------------------------- -/

structure DIR where
  SUMMABLE_BILINEAR_PARTIAL_PRE : thm
  SERIES_DIRICHLET_BILINEAR : thm
  SERIES_DIRICHLET : thm
  SERIES_INJECTIVE_IMAGE_STRONG : thm
  SERIES_INJECTIVE_IMAGE : thm
  SERIES_REARRANGE_EQ : thm
  SERIES_REARRANGE : thm
  SUMMABLE_REARRANGE : thm
  deriving Inhabited

@[nospecialize]
def setupDIR [HolBase] (D : TopologyDeps) (BLIM2 : LIM2) (BARI : ARI) (BTRN : TRN) (BSEQ : SEQ)
    (BBND1 : BND1) (BSUM1 : SUM1) (BSUM3 : SUM3) (BCAU : CAU) (BCMT : CMT) (BRAT : RAT) :
    ExceptT String IO DIR := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE,
        VECTOR_ARITH_TAC, NORM_ARITH, .. } := D
  let { CONTRAPOS_THM, FINITE_DIFF, FINITE_IMAGE, FINITE_INTER, FINITE_NUMSEG, .. } := D.core1
  let { GE, IMP_CONJ_ALT, INJECTIVE_ON_LEFT_INVERSE, INTER_COMM, INTER_SUBSET, IN_ELIM_THM,
        IN_INTER, IN_NUMSEG, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_0, LE_REFL, LT_IMP_LE, NOT_LE, NUMSEG_RREC, .. } :=
    D.core3
  let { REAL_LET_TRANS, REAL_LE_LMUL, REAL_LE_LMUL_EQ, REAL_LE_TRANS, .. } := D.core4
  let { REAL_MUL_SYM, .. } := D.core5
  let { SUM_POS_LE, SUM_SUBSET_SIMPLE, o_DEF, o_THM, real_abs, .. } := D.core6
  let { PERMUTES_IMAGE, PERMUTES_INJECTIVE, .. } := D.lib2
  let { FROM_INTER_NUMSEG, IN_FROM, REAL_HALF, UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { BILINEAR_BOUNDED_POS, BILINEAR_RADD, BILINEAR_RSUB, BILINEAR_VSUM_PARTIAL_PRE, DROP_ADD,
        DROP_CMUL, .. } := D.vec1
  let { LIFT_CMUL, LIFT_DROP, LIFT_SUB, .. } := D.vec2
  let { NORM_LIFT, NORM_POS_LE, .. } := D.vec3
  let { VECTOR_SUB_RZERO, VSUM_CLAUSES, VSUM_DIFF, VSUM_DIFFS, VSUM_IMAGE, VSUM_NORM, VSUM_REAL,
        bilinear, dist, linear, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_CONST, LIM_NULL_VMUL_BOUNDED, LIM_SUB, .. } := BARI
  let { LIM_CASES_SEQUENTIALLY, LIM_TRANSFORM_EQ, .. } := BTRN
  let { SEQ_OFFSET, .. } := BSEQ
  let { BOUNDED_POS, .. } := BBND1
  let { summable, sums, .. } := BSUM1
  let { SUMMABLE_CMUL, SUMMABLE_EQ, .. } := BSUM3
  let { SUMMABLE_CAUCHY, SUMMABLE_EQ_EVENTUALLY, SUMMABLE_FROM_ELSEWHERE, .. } := BCAU
  let { SERIES_LIFT_ABSCONV_IMP_CONV, SUMMABLE_COMPARISON, .. } := BCMT
  let { BOUNDED_PARTIAL_SUMS, .. } := BRAT
  -- @@SCOPE END

  let SUMMABLE_BILINEAR_PARTIAL_PRE ← prove
   r"!f g h:real^M->real^N->real^P l k.
        bilinear h /\
        ((\n. h (f(n + 1)) (g(n))) --> l) sequentially /\
        summable (from k) (\n. h (f(n + 1) - f(n)) (g(n)))
        ==> summable (from k) (\n. h (f n) (g(n) - g(n - 1)))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [summable, sums, FROM_INTER_NUMSEG] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    FIRST_ASSUM (fun th => tactic_of do
     pure (REWRITE_TAC [← MATCH_MP BILINEAR_VSUM_PARTIAL_PRE th])) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"l':real^P")) THEN
    EXISTS_TAC (← q r"l - (h:real^M->real^N->real^P) (f k) (g(k - 1)) - l'") THEN
    REWRITE_TAC [LIM_CASES_SEQUENTIALLY] THEN
    REPEAT (MATCH_MP_TAC LIM_SUB THEN ASM_REWRITE_TAC [LIM_CONST]))

  let SERIES_DIRICHLET_BILINEAR ← prove
   r"!f g h:real^M->real^N->real^P k m p l.
        bilinear h /\
        bounded { vsum (m..n) f | n IN (:num)} /\
        summable (from p) (\n. lift(norm(g(n + 1) - g(n)))) /\
        ((\n. h (g(n + 1)) (vsum(1..n) f)) --> l) sequentially
        ==> summable (from k) (\n. h (g n) (f n))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUMMABLE_FROM_ELSEWHERE THEN
    EXISTS_TAC (← q r"1") THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP BOUNDED_PARTIAL_SUMS) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BOUNDED_POS]) THEN
    SIMP_TAC [IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [← MESON [] (← q r"(!x a b. x = f a b ==> p a b) <=> (!a b. p a b)")] THEN
    X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BILINEAR_BOUNDED_POS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC SUMMABLE_EQ THEN
    EXISTS_TAC (← q r"\n. (h:real^M->real^N->real^P)
                    (g n) (vsum (1..n) f - vsum (1..n-1) f)") THEN
    SIMP_TAC [IN_FROM, ← GSYM NUMSEG_RREC] THEN
    SIMP_TAC [VSUM_CLAUSES, FINITE_NUMSEG, IN_NUMSEG,
              ← ARITH_RULE (← q r"1 <= n ==> ~(n <= n - 1)")] THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN ASM_SIMP_TAC [BILINEAR_RADD, BILINEAR_RSUB] THEN
      VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC SUMMABLE_FROM_ELSEWHERE THEN EXISTS_TAC (← q r"p:num") THEN
    MP_TAC (← ISPECL [← q r"g:num->real^M", ← q r"\n. vsum(1..n) f:real^N",
                      ← q r"h:real^M->real^N->real^P", ← q r"l:real^P", ← q r"p:num"]
           SUMMABLE_BILINEAR_PARTIAL_PRE) THEN
    REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
      (← q r"summable (from p) (lift o (\n. C * B * norm(g(n + 1) - g(n):real^M)))")
    MP_TAC THENL [ASM_SIMP_TAC [o_DEF, LIFT_CMUL, SUMMABLE_CMUL], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUMMABLE_COMPARISON) THEN
    EXISTS_TAC (← q r"0") THEN REWRITE_TAC [IN_FROM, GE, LE_0] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
     (← q r"C * norm(g(n + 1) - g(n):real^M) * norm(vsum (1..n) f:real^N)") THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN
    GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [REAL_LE_LMUL, NORM_POS_LE])

  let SERIES_DIRICHLET ← prove
   r"!f:num->real^N g N k m.
        bounded { vsum (m..n) f | n IN (:num)} /\
        (!n. N <= n ==> g(n + 1) <= g(n)) /\
        ((lift o g) --> vec 0) sequentially
        ==> summable (from k) (\n. g(n) % f(n))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->real^N", ← q r"lift o (g:num->real)",
                      ← q r"\x y:real^N. drop x % y"] SERIES_DIRICHLET_BILINEAR) THEN
    REWRITE_TAC [o_THM, LIFT_DROP] THEN DISCH_THEN MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"m:num", ← q r"N:num", ← q r"vec 0:real^N"] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [bilinear, linear, DROP_ADD, DROP_CMUL] THEN
      REPEAT STRIP_TAC THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    ASM_REWRITE_TAC [← GSYM LIFT_SUB, NORM_LIFT] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"1") o MATCH_MP SEQ_OFFSET) THEN
    REWRITE_TAC [o_THM] THEN DISCH_TAC THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUMMABLE_EQ_EVENTUALLY THEN
      EXISTS_TAC (← q r"\n. lift(g(n) - g(n + 1))") THEN REWRITE_TAC [] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [← REAL_ARITH (← q r"b <= a ==> abs(b - a) = a - b")],
        REWRITE_TAC [summable, sums, FROM_INTER_NUMSEG, VSUM_DIFFS, LIFT_SUB] THEN
        REWRITE_TAC [LIM_CASES_SEQUENTIALLY] THEN
        EXISTS_TAC (← q r"lift(g(N:num)) - vec 0") THEN
        MATCH_MP_TAC LIM_SUB THEN ASM_REWRITE_TAC [LIM_CONST]],
      MATCH_MP_TAC LIM_NULL_VMUL_BOUNDED THEN ASM_REWRITE_TAC [o_DEF] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP BOUNDED_PARTIAL_SUMS) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BOUNDED_POS]) THEN
      SIMP_TAC [IN_ELIM_THM, IN_UNIV] THEN MESON_TAC []])

  let SERIES_INJECTIVE_IMAGE_STRONG ← do
    let lemma ← prove
     r"!f:A->real^N s t.
            FINITE s /\ FINITE t
            ==> vsum s f - vsum t f = vsum (s DIFF t) f - vsum (t DIFF s) f"
     (REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s DIFF (s INTER t)")] THEN
      ASM_SIMP_TAC [VSUM_DIFF, INTER_SUBSET] THEN
      REWRITE_TAC [INTER_COMM] THEN VECTOR_ARITH_TAC)
    prove
     r"!x:num->real^N s f.
          summable (IMAGE f s) (\n. lift(norm(x n))) /\
          (!m n. m IN s /\ n IN s /\ f m = f n ==> m = n)
          ==> ((\n. vsum (IMAGE f s INTER (0..n)) x -
                    vsum (s INTER (0..n)) (x o f)) --> vec 0)
              sequentially"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [LIM_SEQUENTIALLY] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUMMABLE_CAUCHY]) THEN
      SIMP_TAC [VSUM_REAL, FINITE_INTER, FINITE_NUMSEG] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [o_DEF] THEN
      REWRITE_TAC [NORM_LIFT, LIFT_DROP] THEN
      SIMP_TAC [real_abs, SUM_POS_LE, NORM_POS_LE, FINITE_INTER, FINITE_NUMSEG] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [dist, GE, VECTOR_SUB_RZERO, REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INJECTIVE_ON_LEFT_INVERSE]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"g:num->num")) THEN
      MP_TAC (← ISPECL [← q r"g:num->num", ← q r"0..N"] UPPER_BOUND_FINITE_SET) THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG, LE_0] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"P:num")) THEN
      EXISTS_TAC (← q r"MAX N P") THEN X_GEN_TAC (← q r"n:num") THEN
      SIMP_TAC [← ARITH_RULE (← q r"MAX a b <= c <=> a <= c /\ b <= c")] THEN DISCH_TAC THEN
      W (MP_TAC o PART_MATCH (rand o rand) VSUM_IMAGE o rand o
        rand o lhand o snd) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [FINITE_INTER, FINITE_NUMSEG, IN_INTER],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) lemma o rand o lhand o snd) THEN
      SIMP_TAC [FINITE_INTER, FINITE_IMAGE, FINITE_NUMSEG] THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm a < e / &2 /\ norm b < e / &2 ==> norm(a - b:real^N) < e")) THEN
      CONJ_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand) VSUM_NORM o lhand o snd) THEN
      SIMP_TAC [FINITE_DIFF, FINITE_IMAGE, FINITE_INTER, FINITE_NUMSEG] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
      MATCH_MP_TAC REAL_LET_TRANS THENL
       [EXISTS_TAC
         (← q r"sum(IMAGE (f:num->num) s INTER (N..n)) (\i. norm(x i :real^N))") THEN
        ASM_SIMP_TAC [LE_REFL] THEN MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
        SIMP_TAC [NORM_POS_LE, FINITE_INTER, FINITE_NUMSEG] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s /\ f(x) IN n /\ ~(x IN m) ==> f x IN t)
          ==> (IMAGE f s INTER n) DIFF (IMAGE f (s INTER m)) SUBSET
              IMAGE f s INTER t")) THEN
        ASM_SIMP_TAC [IN_NUMSEG, LE_0, NOT_LE] THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        MATCH_MP_TAC LT_IMP_LE THEN ONCE_REWRITE_TAC [← GSYM NOT_LE] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE BINDER_CONV
         [← GSYM CONTRAPOS_THM]) THEN
        ASM_SIMP_TAC [] THEN ASM_ARITH_TAC,
        MP_TAC (← ISPECL [← q r"f:num->num", ← q r"0..n"] UPPER_BOUND_FINITE_SET) THEN
        REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG, LE_0] THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"p:num")) THEN
        EXISTS_TAC
         (← q r"sum(IMAGE (f:num->num) s INTER (N..p)) (\i. norm(x i :real^N))") THEN
        ASM_SIMP_TAC [LE_REFL] THEN MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
        SIMP_TAC [NORM_POS_LE, FINITE_INTER, FINITE_NUMSEG] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s /\ x IN n /\ ~(f x IN m) ==> f x IN t)
          ==> (IMAGE f (s INTER n) DIFF (IMAGE f s) INTER m) SUBSET
              (IMAGE f s INTER t)")) THEN
        ASM_SIMP_TAC [IN_NUMSEG, LE_0] THEN ASM_ARITH_TAC])

  let SERIES_INJECTIVE_IMAGE ← prove
   r"!x:num->real^N s f l.
        summable (IMAGE f s) (\n. lift(norm(x n))) /\
        (!m n. m IN s /\ n IN s /\ f m = f n ==> m = n)
        ==> (((x o f) sums l) s <=> (x sums l) (IMAGE f s))"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN REWRITE_TAC [sums] THEN
    MATCH_MP_TAC LIM_TRANSFORM_EQ THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC SERIES_INJECTIVE_IMAGE_STRONG THEN
    ASM_REWRITE_TAC [])

  let SERIES_REARRANGE_EQ ← prove
   r"!x:num->real^N s p l.
        summable s (\n. lift(norm(x n))) /\ p permutes s
        ==> (((x o p) sums l) s <=> (x sums l) s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"x:num->real^N", ← q r"s:num->bool", ← q r"p:num->num",
                      ← q r"l:real^N"] SERIES_INJECTIVE_IMAGE) THEN
    ASM_SIMP_TAC [PERMUTES_IMAGE] THEN
    ASM_MESON_TAC [PERMUTES_INJECTIVE])

  let SERIES_REARRANGE ← prove
   r"!x:num->real^N s p l.
        summable s (\n. lift(norm(x n))) /\ p permutes s /\ (x sums l) s
        ==> ((x o p) sums l) s"
   (MESON_TAC [SERIES_REARRANGE_EQ])

  let SUMMABLE_REARRANGE ← prove
   r"!x s p.
        summable s (\n. lift(norm(x n))) /\ p permutes s
        ==> summable s (x o p)"
   (MESON_TAC [SERIES_LIFT_ABSCONV_IMP_CONV, summable, SERIES_REARRANGE])

  return { SUMMABLE_BILINEAR_PARTIAL_PRE, SERIES_DIRICHLET_BILINEAR, SERIES_DIRICHLET,
           SERIES_INJECTIVE_IMAGE_STRONG, SERIES_INJECTIVE_IMAGE, SERIES_REARRANGE_EQ,
           SERIES_REARRANGE, SUMMABLE_REARRANGE }

/- ------------------------------------------------------------------------- -/
/- Some general theorems about series averages, convolutions etc.            -/
/- (topology.ml 23219-23349)                                                 -/
/- ------------------------------------------------------------------------- -/

structure TOE where
  TOEPLITZ_BILINEAR_SERIES_NULL : thm
  TOEPLITZ_BILINEAR_SERIES : thm
  deriving Inhabited

@[nospecialize]
def setupTOE [HolBase] (D : TopologyDeps) (BLIM2 : LIM2) (BARI : ARI) (BUNQ : UNQ) (BTRN : TRN) :
    ExceptT String IO TOE := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, REAL_ARITH, VECTOR_ARITH,
        NORM_ARITH, .. } := D
  let { FINITE_NUMSEG, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_NUMSEG, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_0, LE_REFL, NOT_LE, .. } := D.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_LMUL_EQ, REAL_LE_RDIV_EQ, REAL_LE_TRANS,
        REAL_LT_DIV, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_SYM, SUBSET, SUBSET_NUMSEG, .. } := D.core5
  let { SUM_LE_NUMSEG, SUM_RMUL, SUM_SUBSET_SIMPLE, WLOG_LT, real_div, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { BILINEAR_BOUNDED_POS, BILINEAR_LSUM, BILINEAR_LZERO, BILINEAR_RSUB, BILINEAR_RZERO,
        DIST_0, .. } := D.vec1
  let { NORM_POS_LE, .. } := D.vec3
  let { VECTOR_NEG_SUB, VECTOR_SUB_REFL, VSUM_COMBINE_L, VSUM_COMBINE_R, VSUM_EQ_SUPERSET,
        VSUM_NORM_TRIANGLE, VSUM_SUB_NUMSEG, .. } := D.vec4
  let { ALWAYS_EVENTUALLY, .. } := D.met1
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_CONST, LIM_NULL, LIM_NULL_NEG, LIM_NULL_VSUM, .. } := BARI
  let { LIM_BILINEAR, .. } := BUNQ
  let { LIM_TRANSFORM, LIM_TRANSFORM_EVENTUALLY, .. } := BTRN
  -- @@SCOPE END

  let TOEPLITZ_BILINEAR_SERIES_NULL ← prove
   r"!(bop:real^M->real^N->real^P) a x m b.
        bilinear bop /\
        (x --> vec 0) sequentially /\
        (!p. ((\n. a n p) --> vec 0) sequentially) /\
        (!n. sum (0..n) (\i. norm(a n i)) <= b)
        ==> ((\n. vsum(m..n) (\i. bop (a n i) (x i))) --> vec 0) sequentially"
   (ONCE_REWRITE_TAC [← MESON []
     (← q r"(!p a x m b. P p a x m b) <=> (!p b a m x. P p a x m b)")] THEN
    REPLICATE_TAC 3 GEN_TAC THEN
    MATCH_MP_TAC (← MESON [] (← q r"(!m. P 0 ==> P m) /\ P 0 ==> !m. P m")) THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"x:num->real^N") THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"\i. if i < m then vec 0 else (x:num->real^N) i")) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          LIM_TRANSFORM_EVENTUALLY)) THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"m:num") THEN
        SIMP_TAC [← GSYM NOT_LE],
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_EVENTUALLY) THEN
        MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"i:num") THEN
        REWRITE_TAC [] THEN MATCH_MP_TAC VSUM_EQ_SUPERSET THEN
        REWRITE_TAC [FINITE_NUMSEG, SUBSET_NUMSEG, IN_NUMSEG, LE_0, LE_REFL] THEN
        SIMP_TAC [← GSYM NOT_LE, IMP_CONJ] THEN ASM_MESON_TAC [BILINEAR_RZERO]],
      REPEAT STRIP_TAC] THEN
    REWRITE_TAC [LIM_SEQUENTIALLY] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC o
      MATCH_MP BILINEAR_BOUNDED_POS) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / B / (&2 * abs b + &1)")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &2 * abs b + &1")] THEN
    REWRITE_TAC [DIST_0, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
    SUBGOAL_THEN
      (← q r"((\n. vsum(0..m) (\i. (bop:real^M->real^N->real^P) (a n i) (x i)))
        --> vec 0) sequentially")
    MP_TAC THENL
     [MATCH_MP_TAC LIM_NULL_VSUM THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
      X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o SPEC (← q r"(x:num->real^N) k") o
          MATCH_MP BILINEAR_LZERO) THEN
      MP_TAC (← ISPECL [← q r"sequentially", ← q r"bop:real^M->real^N->real^P"]
          LIM_BILINEAR) THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [LIM_CONST],
      REWRITE_TAC [LIM_SEQUENTIALLY] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, DIST_0, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"p:num") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"MAX m p") THEN X_GEN_TAC (← q r"n:num") THEN
    REWRITE_TAC [← ARITH_RULE (← q r"MAX a b <= n <=> a <= n /\ b <= n")] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"0 <= m + 1 /\ m <= n") MP_TAC THENL
     [ASM_ARITH_TAC,
      DISCH_THEN (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP VSUM_COMBINE_R th)]))] THEN
    MATCH_MP_TAC (← NORM_ARITH
     (← q r"norm(x:real^N) < e / &2 /\ norm(y) <= e / &2 ==> norm(x + y) < e")) THEN
    ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC VSUM_NORM_TRIANGLE THEN REWRITE_TAC [FINITE_NUMSEG] THEN
    TRANS_TAC REAL_LE_TRANS
      (← q r"sum(m + 1..n) (\i. norm((a:num->num->real^M) n i)) *
       e / (&2 * abs b + &1)") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← GSYM SUM_RMUL] THEN MATCH_MP_TAC SUM_LE_NUMSEG THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN REWRITE_TAC [] THEN
      FIRST_X_ASSUM (fun th => W (MP_TAC o PART_MATCH lhand th o lhand o snd)) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      GEN_REWRITE_TAC LAND_CONV [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ] THEN
      REWRITE_TAC [← GSYM REAL_MUL_ASSOC, real_div] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x < e / b / c ==> x <= e * inv c * inv b")) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      ONCE_REWRITE_TAC [← REAL_ARITH
       (← q r"s * e / b <= e / &2 <=> e * (&2 * s) / b <= e * &1")] THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_LE_LDIV_EQ,
                    ← REAL_ARITH (← q r"&0 < &2 * abs b + &1")] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"x <= b ==> &2 * x <= &1 * (&2 * abs b + &1)")) THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"sum(0..n) (\i. norm((a:num->num->real^M) n i))") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
      REWRITE_TAC [SUBSET, NORM_POS_LE, IN_NUMSEG, FINITE_NUMSEG] THEN
      ARITH_TAC])

  let TOEPLITZ_BILINEAR_SERIES ← prove
   r"!(bop:real^M->real^N->real^P) a x m r l i b.
        bilinear bop /\
        (x --> l) sequentially /\
        (!p. ((\n. a n p) --> vec 0) sequentially) /\
        (((\n. vsum(r..n) (\i. a n i))) --> i) sequentially /\
        (!n. sum (0..n) (\i. norm(a n i)) <= b)
        ==> ((\n. vsum(m..n) (\i. bop (a n i) (x i))) --> bop i l)
             sequentially"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"bop:real^M->real^N->real^P", ← q r"a:num->num->real^M",
      ← q r"\n. (x:num->real^N) n - l", ← q r"m:num", ← q r"b:real"]
     TOEPLITZ_BILINEAR_SERIES_NULL) THEN
    ASM_REWRITE_TAC [← GSYM LIM_NULL] THEN
    GEN_REWRITE_TAC RAND_CONV [LIM_NULL] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM) THEN
    ASM_SIMP_TAC [BILINEAR_RSUB, VSUM_SUB_NUMSEG] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"x - l - (x - b):real^N = --(l - b)")] THEN
    REWRITE_TAC [LIM_NULL_NEG, ← GSYM LIM_NULL] THEN
    ASM_SIMP_TAC [← GSYM BILINEAR_LSUM, FINITE_NUMSEG] THEN
    MP_TAC (← ISPECL [← q r"sequentially", ← q r"bop:real^M->real^N->real^P"]
          LIM_BILINEAR) THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [LIM_CONST] THEN
    UNDISCH_TAC
     (← q r"((\n. vsum(r..n) (\j. (a:num->num->real^M) n j)) --> i) sequentially") THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM) THEN
    REWRITE_TAC [] THEN
    MAP_EVERY (fun t => SPEC_TAC (t, t)) [← q r"r:num", ← q r"m:num"] THEN
    MATCH_MP_TAC WLOG_LT THEN
    REWRITE_TAC [VECTOR_SUB_REFL, LIM_CONST] THEN CONJ_TAC THENL
     [REPEAT GEN_TAC THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM LIM_NULL_NEG] THEN
      REWRITE_TAC [VECTOR_NEG_SUB],
      MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN DISCH_TAC THEN
      MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
      EXISTS_TAC (← q r"\k. --(vsum(m..n-1) (\j. (a:num->num->real^M) k j))") THEN
      ASM_SIMP_TAC [LIM_NULL_VSUM, FINITE_NUMSEG, LIM_NULL_NEG] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"n:num") THEN
      X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"--x:real^N = y - z <=> x + y = z")] THEN
      MATCH_MP_TAC VSUM_COMBINE_L THEN ASM_ARITH_TAC])

  return { TOEPLITZ_BILINEAR_SERIES_NULL, TOEPLITZ_BILINEAR_SERIES }

/- ------------------------------------------------------------------------- -/
/- Bilinear convolutions and Cesaro means.  (topology.ml 23350-23530)        -/
/- ------------------------------------------------------------------------- -/

structure LBC where
  LIM_BILINEAR_CONVOLUTION : thm
  LIM_CESARO : thm
  deriving Inhabited

@[nospecialize]
def setupLBC [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) (BARI : ARI) (BUNQ : UNQ) (BTRN : TRN)
    (BSEQ : SEQ) (BBND1 : BND1) (BCMP : CMP) (BSMI : SMI) : ExceptT String IO LBC := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH,
        NORM_ARITH, .. } := D
  let { CARD_NUMSEG, CONJ_ASSOC, ETA_AX, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_NUMSEG, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, NUMSEG_EMPTY, REAL_ABS_INV, REAL_ABS_NUM, REAL_ABS_NZ, .. } :=
    D.core3
  let { REAL_INV_EQ_0, REAL_LET_TRANS, REAL_LE_LCANCEL_IMP, REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ,
        REAL_LE_MUL2, REAL_LE_TRANS, REAL_LT_LCANCEL_IMP, .. } := D.core4
  let { REAL_MAX_LE, REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_SYM, REAL_OF_NUM_ADD,
        REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_MUL, .. } := D.core5
  let { SUM_BOUND_LT_ALL, o_DEF, real_div, .. } := D.core6
  let { BILINEAR_BOUNDED_POS, BILINEAR_MUL_DROP, DIST_LIFT, DROP_VEC, .. } := D.vec1
  let { LIFT_NUM, .. } := D.vec2
  let { NORM_MUL, NORM_POS_LE, .. } := D.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_SUB_LDISTRIB,
        VSUM_COMBINE_L, VSUM_COMBINE_R, VSUM_CONST_NUMSEG, VSUM_EQ_NUMSEG, VSUM_LMUL, VSUM_NORM,
        VSUM_REFLECT, VSUM_SUB_NUMSEG, dist, .. } := D.vec4
  let { ALWAYS_EVENTUALLY, ARCH_EVENTUALLY_LE, .. } := D.met1
  let { EVENTUALLY_AND, EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { tendsto, .. } := BLIM1
  let { LIM_CONST, LIM_NULL_VMUL_BOUNDED, LIM_NULL_VSUM, .. } := BARI
  let { BILINEAR_EPSILON_DELTA, .. } := BUNQ
  let { LIM_TRANSFORM_EVENTUALLY, .. } := BTRN
  let { SEQ_HARMONIC_OFFSET, SEQ_HARMONIC_RATIO, .. } := BSEQ
  let { BOUNDED_POS, .. } := BBND1
  let { CONVERGENT_IMP_BOUNDED, .. } := BCMP
  let { LIM_VMUL, .. } := BSMI
  -- @@SCOPE END

  let LIM_BILINEAR_CONVOLUTION ← prove
   r"!(bop:real^M->real^N->real^P) x y m k a b.
     bilinear bop /\ (x --> a) sequentially /\ (y --> b) sequentially
     ==> ((\n. inv(&n + k) % vsum(m..n) (\i. bop (x i) (y(n - i))))
          --> bop a b) sequentially"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [tendsto] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o ISPECL [← q r"a:real^M", ← q r"b:real^N", ← q r"e / &4"] o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] BILINEAR_EPSILON_DELTA)) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"eventually (\n. m + 1 <= n /\
                      norm(x n - a:real^M) < d /\
                      norm(y n - b:real^N) < d) sequentially")
    MP_TAC THENL
     [REWRITE_TAC [EVENTUALLY_AND] THEN CONJ_TAC THENL
       [REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN MESON_TAC [],
        RULE_ASSUM_TAC (REWRITE_RULE [tendsto, dist]) THEN ASM_SIMP_TAC []],
      GEN_REWRITE_TAC LAND_CONV [EVENTUALLY_SEQUENTIALLY] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"m + 1 <= N") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"N:num")) THEN ARITH_TAC,
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP
       (← ARITH_RULE (← q r"m + 1 <= n ==> 1 <= n")))] THEN
    MATCH_MP_TAC EVENTUALLY_MONO THEN EXISTS_TAC
     (← q r"\n. max (&(2 * N + 1)) (--k) <= &n /\
          (dist(inv (&n + k) % vsum(m..N-1) (\i. bop (x i) (y (n - i))),vec 0)
           < e / &4 /\
          dist(inv (&n + k) % vsum((n-N)+1..n)
                (\i. (bop:real^M->real^N->real^P) (x i) (y (n - i))),vec 0)
          < e / &4) /\
         dist(inv (&n + k) % vsum(N..n-N) (\i. bop (x i) (y (n - i))),bop a b)
         < e / &2") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [REAL_MAX_LE, REAL_OF_NUM_LE] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"x + y + z:real^N = w
        ==> (dist(x,vec 0) < e / &4 /\ dist(z,vec 0) < e / &4) /\
            dist(y,a) < e / &2
            ==> dist(w,a) < e")) THEN
      REWRITE_TAC [← GSYM VECTOR_ADD_LDISTRIB] THEN AP_TERM_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand)
        VSUM_COMBINE_R o rand o lhand o snd) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC] THEN
      MATCH_MP_TAC VSUM_COMBINE_L THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"N:num")) THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [EVENTUALLY_AND, ARCH_EVENTUALLY_LE] THEN CONJ_TAC THENL
     [CONJ_TAC THEN
      (SUBGOAL_THEN (← q r"&0 < e / &4") MP_TAC THENL
        [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
      SPEC_TAC (← q r"e / &4", ← q r"e:real") THEN REWRITE_TAC [← GSYM tendsto] THEN
      REWRITE_TAC [← GSYM VSUM_LMUL] THENL
       [ALL_TAC,
        MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
        EXISTS_TAC
         (← q r"\n. vsum (0..N-1)
                 (\i. inv (&n + k) %
                (bop:real^M->real^N->real^P) (x (n - i)) (y i))") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"N + 1") THEN
          REPEAT STRIP_TAC THEN
          GEN_REWRITE_TAC RAND_CONV [VSUM_REFLECT] THEN
          COND_CASES_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"N + 1 <= n ==> n - (n - N + 1) = N - 1")] THEN
          MATCH_MP_TAC VSUM_EQ_NUMSEG THEN REWRITE_TAC [] THEN
          REPEAT STRIP_TAC THEN REPEAT AP_TERM_TAC THEN ASM_ARITH_TAC,
          ALL_TAC]] THEN
      MATCH_MP_TAC LIM_NULL_VSUM THEN REWRITE_TAC [FINITE_NUMSEG] THEN
      X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
      MATCH_MP_TAC LIM_NULL_VMUL_BOUNDED THEN
      REWRITE_TAC [o_DEF, SEQ_HARMONIC_OFFSET] THEN
      UNDISCH_TAC (← q r"(y --> (b:real^N)) sequentially") THEN
      UNDISCH_TAC (← q r"(x --> (a:real^M)) sequentially") THEN
      DISCH_THEN (MP_TAC o MATCH_MP CONVERGENT_IMP_BOUNDED) THEN
      REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE, IN_UNIV] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"A:real") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (MP_TAC o MATCH_MP CONVERGENT_IMP_BOUNDED) THEN
      REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE, IN_UNIV] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP BILINEAR_BOUNDED_POS) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"C * A * B:real") THEN MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
      X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [] THEN DISJ2_TAC THEN
      FIRST_X_ASSUM (fun th => W (MP_TAC o PART_MATCH lhand th o lhand o snd)) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
      ASM_REWRITE_TAC [NORM_POS_LE],
      MATCH_MP_TAC EVENTUALLY_MONO THEN
      EXISTS_TAC
       (← q r"\n. max (&1 - k) (&2 * &N + &1) <= &n /\
            dist(inv(&n + (&1 - &2 * &N)) %
                 vsum(N..n - N) (\i. bop (x i) (y (n - i))),bop a b) < e / &4 /\
            dist(lift((&n + k) / (&n + (&1 - &2 * &N))),vec 1) < &1 / &4 /\
            dist((&n + (&1 - &2 * &N)) / (&n + k) %
                 (bop:real^M->real^N->real^P) a b,bop a b) < e / &8") THEN
      REWRITE_TAC [EVENTUALLY_AND, ARCH_EVENTUALLY_LE] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [REAL_MAX_LE] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← NORM_ARITH
         (← q r"dist(ab',ab) < e / &8 ==> dist(s,ab') <= &3 * e / &8
          ==> dist(s:real^N,ab) < e / &2"))) THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div] THEN
        REWRITE_TAC [dist, ← GSYM VECTOR_MUL_ASSOC, ← GSYM VECTOR_SUB_LDISTRIB] THEN
        ASM_SIMP_TAC [NORM_MUL, REAL_ABS_INV, ← REAL_ARITH
          (← q r"&1 - k <= n ==> abs(n + k) = n + k")] THEN
        GEN_REWRITE_TAC LAND_CONV [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [← GSYM real_div, REAL_LE_LDIV_EQ, ← REAL_ARITH
          (← q r"&1 - k <= n ==> &0 < n + k")] THEN
        MATCH_MP_TAC REAL_LE_LCANCEL_IMP THEN
        EXISTS_TAC (← q r"abs(inv(&n + &1 - &2 * &N))") THEN
        REWRITE_TAC [← GSYM NORM_MUL, VECTOR_SUB_LDISTRIB, VECTOR_MUL_ASSOC] THEN
        REWRITE_TAC [REAL_ABS_INV, REAL_INV_EQ_0, ← GSYM REAL_ABS_NZ] THEN
        ASM_SIMP_TAC [REAL_MUL_LINV, ← GSYM dist, VECTOR_MUL_LID, ← REAL_ARITH
         (← q r"x + &1 <= n ==> ~(n + &1 - x = &0)")] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
          (← q r"x < e / &4 ==> e * &2 / &3 <= e * nk * nn
          ==> x <= nn * (&3 * inv(&8) * e) * nk"))) THEN
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [DIST_LIFT, ← GSYM LIFT_NUM]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
          (← q r"abs(x - &1) < &1 / &4 ==> y = x ==> &2 / &3 <= y"))) THEN
        REWRITE_TAC [real_div] THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
        ASM_REAL_ARITH_TAC,
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"2 * N + 1") THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        MATCH_MP_TAC REAL_LT_LCANCEL_IMP THEN
        EXISTS_TAC (← q r"abs(&n + &1 - &2 * &N)") THEN
        SIMP_TAC [dist, ← GSYM NORM_MUL, VECTOR_SUB_LDISTRIB, VECTOR_MUL_ASSOC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE
         [← GSYM REAL_OF_NUM_LE, ← GSYM REAL_OF_NUM_ADD, ← GSYM REAL_OF_NUM_MUL]) THEN
        ASM_SIMP_TAC [← GSYM REAL_ABS_NZ, REAL_MUL_RINV, VECTOR_MUL_LID, ← REAL_ARITH
         (← q r"x + &1 <= n ==> ~(n + &1 - x = &0)")] THEN
        SUBGOAL_THEN (← q r"&n + &1 - &2 * &N = &(((n - N) + 1) - N)")
        SUBST1_TAC THENL
         [MATCH_MP_TAC (← REAL_ARITH (← q r"x + &1 = y + z ==> x + &1 - z = y")) THEN
          UNDISCH_TAC (← q r"&2 * &N + &1 <= &n") THEN
          REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_MUL] THEN
          REWRITE_TAC [REAL_OF_NUM_EQ, REAL_OF_NUM_LE] THEN ARITH_TAC,
          REWRITE_TAC [← GSYM VSUM_CONST_NUMSEG, ← GSYM VSUM_SUB_NUMSEG]] THEN
        W (MP_TAC o PART_MATCH (lhand o rand) VSUM_NORM o lhand o snd) THEN
        REWRITE_TAC [FINITE_NUMSEG] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
        REWRITE_TAC [← GSYM CARD_NUMSEG, REAL_ABS_NUM] THEN
        MATCH_MP_TAC SUM_BOUND_LT_ALL THEN
        REWRITE_TAC [FINITE_NUMSEG, NUMSEG_EMPTY, IN_NUMSEG] THEN
        CONJ_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE
           [REAL_OF_NUM_ADD, REAL_OF_NUM_MUL, REAL_OF_NUM_LE]) THEN
          ASM_ARITH_TAC,
          X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          FIRST_X_ASSUM (fun th => tactic_of do
            pure (MP_TAC (← ISPEC (← q r"i:num") th) THEN
                  MP_TAC (← ISPEC (← q r"n - i:num") th))) THEN
          ASM_SIMP_TAC [REAL_OF_NUM_LE] THEN
          ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []]],
        MP_TAC (← REAL_ARITH (← q r"&0 < &1 / &4")) THEN
        SPEC_TAC (← q r"&1 / &4", ← q r"e:real") THEN
        REWRITE_TAC [← GSYM tendsto, SEQ_HARMONIC_RATIO],
        SUBGOAL_THEN (← q r"&0 < e / &8") MP_TAC THENL
         [ASM_REAL_ARITH_TAC, SPEC_TAC (← q r"e / &8", ← q r"e:real")] THEN
        REWRITE_TAC [← GSYM tendsto] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_MUL_LID] THEN
        MATCH_MP_TAC LIM_VMUL THEN
        REWRITE_TAC [o_DEF, SEQ_HARMONIC_RATIO, LIFT_NUM]]])

  let LIM_CESARO ← prove
   r"!a l:real^N m k.
        (a --> l) sequentially
        ==> ((\n. inv(&n + k) % vsum(m..n) a) --> l) sequentially"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"\y:real^N x. drop x % y", ← q r"a:num->real^N", ← q r"(\n. vec 1):num->real^1",
      ← q r"m:num", ← q r"k:real", ← q r"l:real^N", ← q r"vec 1:real^1"]
     LIM_BILINEAR_CONVOLUTION) THEN
    ASM_REWRITE_TAC [BILINEAR_MUL_DROP, LIM_CONST, DROP_VEC, VECTOR_MUL_LID] THEN
    REWRITE_TAC [ETA_AX])

  return { LIM_BILINEAR_CONVOLUTION, LIM_CESARO }

/- ------------------------------------------------------------------------- -/
/- Multiplication (in a general bilinear sense) of series.                   -/
/- (topology.ml 23531-23662)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SBL where
  SERIES_BILINEAR : thm
  SERIES_BILINEAR_UNIQUE : thm
  SUMMABLE_BILINEAR_LEFT : thm
  SUMMABLE_BILINEAR_RIGHT : thm
  deriving Inhabited

@[nospecialize]
def setupSBL [HolBase] (D : TopologyDeps) (BLIM2 : LIM2) (BARI : ARI) (BUNQ : UNQ) (BTRN : TRN)
    (BSEQ : SEQ) (BBND1 : BND1) (BCMP : CMP) (BSUM1 : SUM1) (BCAU : CAU) (BCMT : CMT)
    (BTOE : TOE) (BLBC : LBC) : ExceptT String IO SBL := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, REAL_ARITH, VECTOR_ARITH, .. } := D
  let { ADD_SUB, ETA_AX, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_NUMSEG, .. } := D.core2
  let { IN_UNIV, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, LT, MONO_EXISTS, MONO_FORALL,
        REAL_ABS_REFL, REAL_ADD_RID, .. } := D.core3
  let { RIGHT_EXISTS_AND_THM, SUB_0, .. } := D.core5
  let { SUM_POS_LE_NUMSEG, SUM_REFLECT, o_DEF, .. } := D.core6
  let { BILINEAR_LSUB, BILINEAR_LSUM, BILINEAR_LZERO, BILINEAR_RSUB, BILINEAR_SWAP,
        BILINEAR_VSUM_CONVOLUTION_1, BILINEAR_VSUM_CONVOLUTION_2, DROP_VSUM, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { NORM_1, NORM_POS_LE, .. } := D.vec3
  let { VECTOR_SUB_EQ, VSUM_EQ, VSUM_EQ_NUMSEG, VSUM_REFLECT, VSUM_SUB_NUMSEG, .. } := D.vec4
  let { ALWAYS_EVENTUALLY, .. } := D.met1
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { LIM_EVENTUALLY, .. } := BLIM2
  let { LIM_CONST, LIM_NULL, LIM_NULL_ADD, LIM_NULL_NEG, .. } := BARI
  let { LIM_BILINEAR, LIM_UNIQUE, .. } := BUNQ
  let { LIM_TRANSFORM, LIM_TRANSFORM_EVENTUALLY, .. } := BTRN
  let { SEQ_OFFSET_REV, .. } := BSEQ
  let { bounded, .. } := BBND1
  let { CONVERGENT_IMP_BOUNDED, .. } := BCMP
  let { SERIES_FROM, SERIES_TERMS_TOZERO, SUMS_EQ, summable, .. } := BSUM1
  let { SUMMABLE_FROM_ELSEWHERE_EQ, .. } := BCAU
  let { SERIES_LIFT_ABSCONV_IMP_CONV, .. } := BCMT
  let { TOEPLITZ_BILINEAR_SERIES_NULL, .. } := BTOE
  let { LIM_BILINEAR_CONVOLUTION, LIM_CESARO, .. } := BLBC
  -- @@SCOPE END

  let SERIES_BILINEAR ← do
    let lemma ← prove
     r"!bop:real^M->real^N->real^P x y a b.
            bilinear bop /\
            (x sums a) (from 0) /\ (y sums b) (from 0) /\
            summable (from 0) (\n. lift(norm(x n)))
            ==> ((\n. vsum(0..n) (\i. bop (x i) (y(n - i)))) sums bop a b)
                (from 0)"
     (REWRITE_TAC [SERIES_FROM] THEN REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [LIM_NULL] THEN
      ASM_SIMP_TAC [BILINEAR_VSUM_CONVOLUTION_1] THEN
      ONCE_REWRITE_TAC [VSUM_REFLECT] THEN REWRITE_TAC [← CONJUNCT1 LT, SUB_0] THEN
      MP_TAC (← ISPECL
       [← q r"bop:real^M->real^N->real^P",
        ← q r"\n i. (x:num->real^M) (n - i)",
        ← q r"\m. vsum(0..m) y - b:real^N",
        ← q r"0"]
       TOEPLITZ_BILINEAR_SERIES_NULL) THEN
      ASM_REWRITE_TAC [LEFT_FORALL_IMP_THM, RIGHT_EXISTS_AND_THM] THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [← GSYM LIM_NULL] THEN CONJ_TAC THENL
         [X_GEN_TAC (← q r"p:num") THEN MATCH_MP_TAC SEQ_OFFSET_REV THEN
          EXISTS_TAC (← q r"p:num") THEN ASM_REWRITE_TAC [ADD_SUB, ETA_AX] THEN
          MATCH_MP_TAC SERIES_TERMS_TOZERO THEN REWRITE_TAC [SERIES_FROM] THEN
          MAP_EVERY EXISTS_TAC [← q r"a:real^M", ← q r"0"] THEN ASM_REWRITE_TAC [],
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [summable]) THEN
          REWRITE_TAC [SERIES_FROM, LEFT_IMP_EXISTS_THM] THEN
          X_GEN_TAC (← q r"l:real^1") THEN DISCH_TAC THEN
          MP_TAC (← ISPECL [← q r"\n. vsum(0..n) (\i. lift(norm((x:num->real^M) i)))",
                            ← q r"l:real^1"]
            CONVERGENT_IMP_BOUNDED) THEN
          ASM_REWRITE_TAC [bounded, FORALL_IN_IMAGE, IN_UNIV] THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:num") THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x <= b ==> y <= b")) THEN
          REWRITE_TAC [NORM_1, DROP_VSUM, o_DEF, LIFT_DROP] THEN
          GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [SUM_REFLECT] THEN
          REWRITE_TAC [← CONJUNCT1 LT, SUB_0, REAL_ABS_REFL] THEN
          SIMP_TAC [SUM_POS_LE_NUMSEG, NORM_POS_LE]],
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM) THEN
        ASM_SIMP_TAC [BILINEAR_RSUB, VSUM_SUB_NUMSEG] THEN
        ONCE_REWRITE_TAC [← VECTOR_ARITH
          (← q r"s - l - (s' - ab):real^N = (s - s') + --(l - ab)")] THEN
        MATCH_MP_TAC LIM_NULL_ADD THEN CONJ_TAC THENL
         [MATCH_MP_TAC LIM_EVENTUALLY THEN
          MATCH_MP_TAC ALWAYS_EVENTUALLY THEN REWRITE_TAC [VECTOR_SUB_EQ] THEN
          GEN_TAC THEN MATCH_MP_TAC VSUM_EQ_NUMSEG THEN
          SIMP_TAC [← ARITH_RULE (← q r"i:num <= n ==> n - (n - i) = i")],
          ASM_SIMP_TAC [← GSYM BILINEAR_LSUM, FINITE_NUMSEG,
                        ← GSYM BILINEAR_LSUB] THEN
          REWRITE_TAC [LIM_NULL_NEG] THEN
          FIRST_ASSUM (SUBST1_TAC o SYM o SPEC (← q r"b:real^N") o
            MATCH_MP BILINEAR_LZERO) THEN
          MP_TAC (← ISPECL [← q r"sequentially", ← q r"bop:real^M->real^N->real^P"]
            LIM_BILINEAR) THEN
          DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [LIM_CONST] THEN
          ONCE_REWRITE_TAC [VSUM_REFLECT] THEN
          REWRITE_TAC [← CONJUNCT1 LT, SUB_0, ← GSYM LIM_NULL] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            LIM_TRANSFORM_EVENTUALLY)) THEN
          REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"0") THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC VSUM_EQ_NUMSEG THEN
          GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [] THEN AP_TERM_TAC THEN
          ASM_ARITH_TAC]])
    prove
     r"!bop:real^M->real^N->real^P x y a b.
          bilinear bop /\ (x sums a) (from 0) /\ (y sums b) (from 0) /\
          (summable (from 0) (\n. lift(norm(x n))) \/
           summable (from 0) (\n. lift(norm(y n))))
          ==> ((\n. vsum(0..n) (\i. bop (x i) (y(n - i)))) sums bop a b)
              (from 0)"
     (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [lemma] THEN
      MP_TAC (← ISPECL
       [← q r"\x y. (bop:real^M->real^N->real^P) y x",
        ← q r"y:num->real^N", ← q r"x:num->real^M", ← q r"b:real^N", ← q r"a:real^M"]
       lemma) THEN
      ASM_REWRITE_TAC [BILINEAR_SWAP] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUMS_EQ) THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
      GEN_REWRITE_TAC RAND_CONV [VSUM_REFLECT] THEN
      REWRITE_TAC [← CONJUNCT1 LT, SUB_0] THEN MATCH_MP_TAC VSUM_EQ THEN
      SIMP_TAC [IN_NUMSEG, ← ARITH_RULE (← q r"i:num <= n ==> n - (n - i) = i")])

  let SERIES_BILINEAR_UNIQUE ← prove
   r"!bop:real^M->real^N->real^P x y a b c.
        bilinear bop /\
        (x sums a) (from 0) /\ (y sums b) (from 0) /\
        ((\n. vsum (0..n) (\i. bop (x i) (y(n - i)))) sums c) (from 0)
        ==> bop a b = c"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SERIES_FROM] THEN ONCE_REWRITE_TAC [← TAUT
      (← q r"p /\ q /\ r /\ s ==> t <=> p ==> p /\ q /\ r ==> s ==> t")] THEN
    DISCH_TAC THEN DISCH_THEN (LABEL_TAC "*" o SPECL [← q r"0", ← q r"&0:real"] o
    MATCH_MP LIM_BILINEAR_CONVOLUTION) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"0", ← q r"&0:real"] o MATCH_MP LIM_CESARO) THEN
    REMOVE_THEN "*" MP_TAC THEN REWRITE_TAC [IMP_IMP, REAL_ADD_RID] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP BILINEAR_VSUM_CONVOLUTION_2 th])) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] LIM_UNIQUE) THEN
    REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY])

  let SUMMABLE_BILINEAR_LEFT ← prove
   r"!bop:real^M->real^N->real^P x y m n p.
        bilinear bop /\
        summable (from m) (\n. lift(norm(x n))) /\ summable (from n) y
        ==> summable (from p) (\n. vsum(0..n) (\i. bop (x i) (y(n - i))))"
   (ONCE_REWRITE_TAC [← SPEC (← q r"0") SUMMABLE_FROM_ELSEWHERE_EQ] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SERIES_LIFT_ABSCONV_IMP_CONV) THEN
    UNDISCH_TAC (← q r"summable (from 0) (y:num->real^N)") THEN
    REWRITE_TAC [summable, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"a:real^M") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"(bop:real^M->real^N->real^P) a b") THEN
    MATCH_MP_TAC SERIES_BILINEAR THEN ASM_REWRITE_TAC [])

  let SUMMABLE_BILINEAR_RIGHT ← prove
   r"!bop:real^M->real^N->real^P x y m n p.
        bilinear bop /\
        summable (from m) x /\ summable (from n) (\n. lift(norm(y n)))
        ==> summable (from p) (\n. vsum(0..n) (\i. bop (x i) (y(n - i))))"
   (ONCE_REWRITE_TAC [← SPEC (← q r"0") SUMMABLE_FROM_ELSEWHERE_EQ] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SERIES_LIFT_ABSCONV_IMP_CONV) THEN
    UNDISCH_TAC (← q r"summable (from 0) (x:num->real^M)") THEN
    REWRITE_TAC [summable, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real^M") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"(bop:real^M->real^N->real^P) a b") THEN
    MATCH_MP_TAC SERIES_BILINEAR THEN ASM_REWRITE_TAC [])

  return { SERIES_BILINEAR, SERIES_BILINEAR_UNIQUE, SUMMABLE_BILINEAR_LEFT,
           SUMMABLE_BILINEAR_RIGHT }

/- ------------------------------------------------------------------------- -/
/- Relate Cauchy sequences to summability or absolute convergence.           -/
/- (topology.ml 23663-23742)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CSM where
  CAUCHY_EQ_SUMMABLE : thm
  CAUCHY_ABSOLUTELY_SUMMABLE_SUBSEQUENCE : thm
  ABSOLUTELY_SUMMABLE_IMP_CAUCHY : thm
  COMPLETE_ABSOLUTELY_SUMMABLE : thm
  deriving Inhabited

@[nospecialize]
def setupCSM [HolBase] (D : TopologyDeps) (BCMP : CMP) (BCAU : CAU) (BCMT : CMT) (BRAT : RAT) :
    ExceptT String IO CSM := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_RAT_REDUCE_CONV,
        NORM_ARITH, .. } := D
  let { ADD1, DEPENDENT_CHOICE, .. } := D.core1
  let { GE, INTER_UNIV, .. } := D.core2
  let { LE_REFL, LT, LT_TRANS, MONO_EXISTS, .. } := D.core3
  let { REAL_INV_POW, REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_POW2, .. } := D.core4
  let { SKOLEM_THM, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LT, WLOG_LT, num_INDUCTION, o_DEF, o_THM, .. } := D.core6
  let { FROM_0, .. } := D.misc
  let { DIST_REFL, DIST_SYM, .. } := D.vec1
  let { NORM_0, NORM_LIFT, REAL_ABS_DIST, .. } := D.vec3
  let { VSUM_DIFFS_ALT, dist, .. } := D.vec4
  let { CAUCHY_CONVERGENT_SUBSEQUENCE, cauchy, complete, .. } := BCMP
  let { SUMMABLE_CAUCHY, .. } := BCAU
  let { SERIES_LIFT_ABSCONV_IMP_CONV, SUMMABLE_COMPARISON, .. } := BCMT
  let { SUMMABLE_REAL_GP, .. } := BRAT
  -- @@SCOPE END

  let CAUCHY_EQ_SUMMABLE ← prove
   r"!x:num->real^N. cauchy x <=> summable (from 0) (\n. x(n + 1) - x n)"
   (REWRITE_TAC [cauchy, SUMMABLE_CAUCHY, FROM_0, INTER_UNIV] THEN
    GEN_TAC THEN REWRITE_TAC [VSUM_DIFFS_ALT] THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"N + 1") THEN REWRITE_TAC [GE] THENL
     [REWRITE_TAC [GE] THEN REPEAT STRIP_TAC THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [NORM_0, ← GSYM dist] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      MATCH_MP_TAC WLOG_LT THEN ASM_REWRITE_TAC [DIST_REFL] THEN
      CONJ_TAC THENL [MESON_TAC [DIST_SYM], ALL_TAC] THEN
      X_GEN_TAC (← q r"m:num") THEN MATCH_MP_TAC num_INDUCTION THEN
      REWRITE_TAC [← CONJUNCT1 LT] THEN X_GEN_TAC (← q r"n:num") THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"m:num", ← q r"n:num"]) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      COND_CASES_TAC THENL [ALL_TAC, ASM_ARITH_TAC] THEN
      REWRITE_TAC [ADD1] THEN CONV_TAC (fun t => NORM_ARITH t)])

  let CAUCHY_ABSOLUTELY_SUMMABLE_SUBSEQUENCE ← prove
   r"!x:num->real^N.
        cauchy x
        ==> ?r. (!m n. m < n ==> r m < r n) /\
                summable (from 0) (\n. lift(dist(x(r(n + 1)),x(r n))))"
   (REWRITE_TAC [cauchy] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&2 pow n)")) THEN
    SIMP_TAC [REAL_LT_INV_EQ, REAL_LT_POW2, SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N:num->num")) THEN
    SUBGOAL_THEN
     (← q r"?r:num->num.
          (!n. N n <= r n) /\ (!n. r(n) < r(SUC n))")
    MP_TAC THENL
     [MATCH_MP_TAC DEPENDENT_CHOICE THEN
      REWRITE_TAC [← ARITH_RULE (← q r"a <= x /\ b < x <=> MAX a (SUC b) <= x")] THEN
      MESON_TAC [LE_REFL],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num")] THEN
    STRIP_TAC THEN CONJ_TAC THENL
     [MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN ASM_REWRITE_TAC [LT_TRANS],
      ALL_TAC] THEN
    MATCH_MP_TAC SUMMABLE_COMPARISON THEN
    EXISTS_TAC (← q r"\n. inv(&2 pow n)") THEN CONJ_TAC THENL
     [REWRITE_TAC [o_DEF, REAL_INV_POW] THEN MATCH_MP_TAC SUMMABLE_REAL_GP THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      EXISTS_TAC (← q r"0") THEN X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
      REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_LT_IMP_LE THEN REWRITE_TAC [NORM_LIFT, REAL_ABS_DIST] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num"))) THEN
      REWRITE_TAC [ADD1] THEN ARITH_TAC])

  let ABSOLUTELY_SUMMABLE_IMP_CAUCHY ← prove
   r"!x:num->real^N.
        summable (from 0) (\n. lift(dist(x(n + 1),x n))) ==> cauchy x"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CAUCHY_EQ_SUMMABLE] THEN
    MATCH_MP_TAC SERIES_LIFT_ABSCONV_IMP_CONV THEN
    ASM_REWRITE_TAC [← GSYM dist])

  let COMPLETE_ABSOLUTELY_SUMMABLE ← prove
   r"!s:real^N->bool.
        complete s <=>
        !f. (!n. f n IN s) /\ summable (from 0) (\n. lift(dist(f(n + 1),f n)))
            ==> ?l. l IN s /\ (f --> l) sequentially"
   (GEN_TAC THEN REWRITE_TAC [complete] THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC ABSOLUTELY_SUMMABLE_IMP_CAUCHY THEN
      ASM_REWRITE_TAC [],
      DISCH_TAC THEN X_GEN_TAC (← q r"f:num->real^N") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o
        MATCH_MP CAUCHY_ABSOLUTELY_SUMMABLE_SUBSEQUENCE) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(f:num->real^N) o (r:num->num)")) THEN
      ASM_REWRITE_TAC [o_THM] THEN
      ASM_MESON_TAC [CAUCHY_CONVERGENT_SUBSEQUENCE]])

  return { CAUCHY_EQ_SUMMABLE, CAUCHY_ABSOLUTELY_SUMMABLE_SUBSEQUENCE,
           ABSOLUTELY_SUMMABLE_IMP_CAUCHY, COMPLETE_ABSOLUTELY_SUMMABLE }

/- ------------------------------------------------------------------------- -/
/- Banach fixed point theorem (not really topological...)                    -/
/- (topology.ml 23743-23851)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BFX where
  BANACH_FIX : thm
  deriving Inhabited

@[nospecialize]
def setupBFX [HolBase] (D : TopologyDeps) (BLIM2 : LIM2) (BCMP : CMP) : ExceptT String IO BFX := do
  -- @@SCOPE BEGIN
  let { prove_recursive_functions_exist, ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC,
        REAL_ARITH, .. } := D
  let { ADD_CLAUSES, ARITH, CONTRAPOS_THM, EXISTS_UNIQUE_THM, .. } := D.core1
  let { GE, IN_IMAGE, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_0, LE_EXISTS, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } :=
    D.core3
  let { REAL_ARCH_POW_INV, REAL_LET_TRANS, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_MUL,
        REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_LDIV_EQ, REAL_LT_MUL, REAL_LT_RDIV_EQ, REAL_LT_REFL, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_NOT_LE,
        REAL_POW_1_LE, REAL_POW_ADD, REAL_POW_LE, REAL_SUB_LE, REAL_SUB_LT, SUBSET, .. } :=
    D.core5
  let { num_RECURSION, real_div, real_pow, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_POS_LE, DIST_POS_LT, DIST_REFL, DIST_SYM, DIST_TRIANGLE, DIST_TRIANGLE_HALF_R, .. } :=
    D.vec1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { CAUCHY, complete, .. } := BCMP
  -- @@SCOPE END

  let BANACH_FIX ← prove
   r"!f s c. complete s /\ ~(s = {}) /\
           &0 <= c /\ c < &1 /\
           (IMAGE f s) SUBSET s /\
           (!x y. x IN s /\ y IN s ==> dist(f(x),f(y)) <= c * dist(x,y))
           ==> ?!x:real^N. x IN s /\ (f x = x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [EXISTS_UNIQUE_THM] THEN CONJ_TAC THENL
     [ALL_TAC,
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"dist((f:real^N->real^N) x,f y) <= c * dist(x,y)") MP_TAC THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"a <= c * a <=> &0 <= --a * (&1 - c)")] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, REAL_SUB_LT, real_div] THEN
      REWRITE_TAC [REAL_MUL_LZERO, ← REAL_ARITH (← q r"&0 <= --x <=> ~(&0 < x)")] THEN
      MESON_TAC [DIST_POS_LT]] THEN
    STRIP_ASSUME_TAC (← prove_recursive_functions_exist num_RECURSION
      (← q r"(z 0 = @x:real^N. x IN s) /\ (!n. z(SUC n) = f(z n))")) THEN
    SUBGOAL_THEN (← q r"!n. (z:num->real^N) n IN s") ASSUME_TAC THENL
     [INDUCT_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [MEMBER_NOT_EMPTY, SUBSET, IN_IMAGE],
      ALL_TAC] THEN
    UNDISCH_THEN (← q r"z 0 = @x:real^N. x IN s") (K ALL_TAC : thm → tactic) THEN
    SUBGOAL_THEN (← q r"?x:real^N. x IN s /\ (z --> x) sequentially") MP_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ABBREV_TAC (← q r"e = dist(f(a:real^N),a)") THEN
      SUBGOAL_THEN (← q r"~(&0 < e)") (fun th => ASM_MESON_TAC [th, DIST_POS_LT]) THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
      SUBGOAL_THEN
       (← q r"dist(f(z N),a:real^N) < e / &2 /\ dist(f(z(N:num)),f(a)) < e / &2")
       (fun th => ASM_MESON_TAC [th, DIST_TRIANGLE_HALF_R, REAL_LT_REFL]) THEN
      CONJ_TAC THENL [ASM_MESON_TAC [← ARITH_RULE (← q r"N <= SUC N")], ALL_TAC] THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC (← q r"c * dist((z:num->real^N) N,a)") THEN ASM_SIMP_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x < y /\ c * x <= &1 * x ==> c * x < y")) THEN
      ASM_SIMP_TAC [LE_REFL, REAL_LE_RMUL, DIST_POS_LE, REAL_LT_IMP_LE]] THEN
    FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [complete]) THEN
    ASM_REWRITE_TAC [CAUCHY] THEN
    SUBGOAL_THEN (← q r"!n. dist(z(n):real^N,z(SUC n)) <= c pow n * dist(z(0),z(1))")
    ASSUME_TAC THENL
     [INDUCT_TAC THEN
      REWRITE_TAC [real_pow, ARITH, REAL_MUL_LID, REAL_LE_REFL] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"c * dist(z(n):real^N,z(SUC n))") THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [← GSYM REAL_MUL_ASSOC] THEN ASM_SIMP_TAC [REAL_LE_LMUL],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!m n:num. (&1 - c) * dist(z(m):real^N,z(m+n))
                  <= c pow m * dist(z(0),z(1)) * (&1 - c pow n)")
    ASSUME_TAC THENL
     [GEN_TAC THEN INDUCT_TAC THENL
       [REWRITE_TAC [ADD_CLAUSES, DIST_REFL, REAL_MUL_RZERO] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN
        ASM_SIMP_TAC [REAL_LE_MUL, REAL_POW_LE, DIST_POS_LE, REAL_SUB_LE,
                      REAL_POW_1_LE, REAL_LT_IMP_LE],
        ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
      (← q r"(&1 - c) * (dist(z m:real^N,z(m + n)) + dist(z(m + n),z(m + SUC n)))") THEN
      ASM_SIMP_TAC [REAL_LE_LMUL, REAL_SUB_LE, REAL_LT_IMP_LE, DIST_TRIANGLE] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
        (← q r"c * x <= y ==> c * x' + y <= y' ==> c * (x + x') <= y'"))) THEN
      REWRITE_TAC [← REAL_ARITH
       (← q r"q + a * b * (&1 - x) <= a * b * (&1 - y) <=> q <= a * b * (x - y)")] THEN
      REWRITE_TAC [ADD_CLAUSES, real_pow] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a * b * (d - c * d) = (&1 - c) * a * d * b")] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN
      ASM_SIMP_TAC [REAL_SUB_LE, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [← GSYM REAL_POW_ADD, REAL_MUL_ASSOC] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(z:num->real^N) 0 = z 1") THENL
     [FIRST_X_ASSUM SUBST_ALL_TAC THEN EXISTS_TAC (← q r"0") THEN
      REWRITE_TAC [GE, LE_0] THEN X_GEN_TAC (← q r"n:num") THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"0", ← q r"n:num"]) THEN
      REWRITE_TAC [ADD_CLAUSES, DIST_REFL, REAL_MUL_LZERO, REAL_MUL_RZERO] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      ASM_CASES_TAC (← q r"(z:num->real^N) 0 = z n") THEN
      ASM_REWRITE_TAC [DIST_REFL, REAL_NOT_LE] THEN
      ASM_SIMP_TAC [REAL_LT_MUL, DIST_POS_LT, REAL_SUB_LT],
      ALL_TAC] THEN
    MP_TAC (← SPECL [← q r"c:real", ← q r"e * (&1 - c) / dist((z:num->real^N) 0,z 1)"]
     REAL_ARCH_POW_INV) THEN
    ASM_SIMP_TAC [REAL_LT_MUL, REAL_LT_DIV, REAL_SUB_LT, DIST_POS_LT] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
    REWRITE_TAC [real_div, GE, REAL_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_LT_RDIV_EQ, ← GSYM real_div, DIST_POS_LT] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_LDIV_EQ, REAL_SUB_LT] THEN DISCH_TAC THEN
    REWRITE_TAC [LE_EXISTS, LEFT_IMP_EXISTS_THM] THEN
    GEN_TAC THEN X_GEN_TAC (← q r"d:num") THEN DISCH_THEN SUBST_ALL_TAC THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
      (← q r"d < e ==> x <= d ==> x < e"))) THEN
    ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_SUB_LT] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"N:num", ← q r"d:num"]) THEN
    MATCH_MP_TAC (← REAL_ARITH
    (← q r"(c * d) * e <= (c * d) * &1 ==> x * y <= c * d * e ==> y * x <= c * d")) THEN
    MATCH_MP_TAC REAL_LE_LMUL THEN
    ASM_SIMP_TAC [REAL_LE_MUL, REAL_POW_LE, DIST_POS_LE, ← REAL_ARITH
     (← q r"&0 <= x ==> &1 - x <= &1")])

  return { BANACH_FIX }

/- ------------------------------------------------------------------------- -/
/- Edelstein fixed point theorem.  (topology.ml 23852-23974)                 -/
/- ------------------------------------------------------------------------- -/

structure EDF where
  EDELSTEIN_FIX : thm
  deriving Inhabited

@[nospecialize]
def setupEDF [HolBase] (D : TopologyDeps) (BLIM2 : LIM2) (BARI : ARI) (BUNQ : UNQ) (BCPT : CPT)
    (BCNO : CNO) (BSQC : SQC) (BLCP : LCP) (BPCR1 : PCR1) : ExceptT String IO EDF := do
  -- @@SCOPE BEGIN
  let { prove_general_recursive_function_exists, ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC,
        MESON_TAC, REAL_ARITH, SET_TAC, NORM_ARITH, NORM_ARITH_TAC, .. } := D
  let { CONJ_SYM, ETA_AX, EXISTS_UNIQUE_THM, .. } := D.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, IMP_CONJ, IMP_IMP, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_ADD, NOT_EXISTS_THM, PCROSS, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_LT, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_REFL, .. } := D.core4
  let { REAL_NOT_LT, REAL_SUB_LT, RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, SUBSET, .. } :=
    D.core5
  let { TRANSITIVE_STEPWISE_LE, o_DEF, .. } := D.core6
  let { MONOTONE_BIGGER, REAL_HALF, .. } := D.misc
  let { DIST_REFL, .. } := D.vec1
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_SUB, .. } := BARI
  let { LIM_UNIQUE, .. } := BUNQ
  let { compact, .. } := BCPT
  let { continuous_on, .. } := BCNO
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { COMPACT_PCROSS, .. } := BPCR1
  -- @@SCOPE END

  let EDELSTEIN_FIX ← prove
   r"!f s. compact s /\ ~(s = {}) /\ (IMAGE f s) SUBSET s /\
         (!x y. x IN s /\ y IN s /\ ~(x = y) ==> dist(f(x),f(y)) < dist(x,y))
         ==> ?!x:real^N. x IN s /\ f x = x"
   (MAP_EVERY X_GEN_TAC [← q r"g:real^N->real^N", ← q r"s:real^N->bool"] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [EXISTS_UNIQUE_THM] THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [REAL_LT_REFL]] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN s /\ y IN s ==> dist((g:real^N->real^N)(x),g(y)) <= dist(x,y)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"x:real^N = y") THEN
      ASM_SIMP_TAC [DIST_REFL, REAL_LE_LT],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"?x:real^N. x IN s /\ ~(g x = x)") THENL
     [ALL_TAC, ASM SET_TAC []] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"x:real^N") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"y = (g:real^N->real^N) x") THEN
    SUBGOAL_THEN (← q r"(y:real^N) IN s") ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_PCROSS o W CONJ) THEN
    REWRITE_TAC [compact, PCROSS] THEN
    STRIP_ASSUME_TAC (← prove_general_recursive_function_exists
      (← q r"?f:num->real^N->real^N.
          (!z. f 0 z = z) /\ (!z n. f (SUC n) z = g(f n z))")) THEN
    SUBGOAL_THEN (← q r"!n z. z IN s ==> (f:num->real^N->real^N) n z IN s")
    STRIP_ASSUME_TAC THENL [INDUCT_TAC THEN ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!m n w z. m <= n /\ w IN s /\ z IN s
                ==> dist((f:num->real^N->real^N) n w,f n z) <= dist(f m w,f m z)")
    ASSUME_TAC THENL
     [REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
      MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) THEN
      ASM_SIMP_TAC [REAL_LE_REFL] THEN MESON_TAC [REAL_LE_TRANS],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"\n:num. pastecart (f n (x:real^N)) (f n y:real^N)")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"l:real^(N,N)finite_sum", ← q r"s:num->num"] THEN
    REWRITE_TAC [o_DEF, IN_ELIM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC SUBST_ALL_TAC) THEN
    SUBGOAL_THEN
     (← q r"(\x:real^(N,N)finite_sum. fstcart x) continuous_on UNIV /\
      (\x:real^(N,N)finite_sum. sndcart x) continuous_on UNIV")
    MP_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
      REWRITE_TAC [ETA_AX, LINEAR_FSTCART, LINEAR_SNDCART],
      ALL_TAC] THEN
    REWRITE_TAC [CONTINUOUS_ON_SEQUENTIALLY, IN_UNIV] THEN
    DISCH_THEN (CONJUNCTS_THEN (fun th => FIRST_ASSUM (MP_TAC o MATCH_MP th))) THEN
    REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART, IMP_IMP] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (CONJUNCTS_THEN2 (LABEL_TAC "A") (LABEL_TAC "B") th THEN
            MP_TAC (← MATCH_MP LIM_SUB th))) THEN
    REWRITE_TAC [] THEN DISCH_THEN (LABEL_TAC "AB") THEN
    SUBGOAL_THEN
     (← q r"!n. dist(a:real^N,b) <= dist((f:num->real^N->real^N) n x,f n y)")
    STRIP_ASSUME_TAC THENL
     [X_GEN_TAC (← q r"N:num") THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_SUB_LT] THEN DISCH_TAC THEN
      USE_THEN "AB" (MP_TAC o REWRITE_RULE [LIM_SEQUENTIALLY]) THEN
      DISCH_THEN (fun th => FIRST_X_ASSUM (MP_TAC o MATCH_MP th)) THEN
      REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"M:num") THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"M + N:num")) THEN REWRITE_TAC [LE_ADD] THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"dist(fx,fy) <= dist(x,y)
        ==> ~(dist(fx - fy,a - b) < dist(a,b) - dist(x,y))")) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"M + N:num") o MATCH_MP MONOTONE_BIGGER) THEN
      ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"b:real^N = a") SUBST_ALL_TAC THENL
     [MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
      ABBREV_TAC (← q r"e = dist(a,b) - dist((g:real^N->real^N) a,g b)") THEN
      SUBGOAL_THEN (← q r"&0 < e") ASSUME_TAC THENL
       [ASM_MESON_TAC [REAL_SUB_LT], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?n. dist((f:num->real^N->real^N) n x,a) < e / &2 /\
            dist(f n y,b) < e / &2")
      STRIP_ASSUME_TAC THENL
       [(← do
          let t ← q r"e / &2"
          pure (MAP_EVERY (fun s => USE_THEN s (MP_TAC o SPEC t o
                  REWRITE_RULE [LIM_SEQUENTIALLY])) ["A", "B"])) THEN
        ASM_REWRITE_TAC [REAL_HALF] THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"M:num")) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
        EXISTS_TAC (← q r"(s:num->num) (M + N)") THEN
        CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"dist(f (SUC n) x,(g:real^N->real^N) a) +
                    dist((f:num->real^N->real^N) (SUC n) y,g b) < e")
      MP_TAC THENL
       [ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"x < e / &2 /\ y < e / &2 ==> x + y < e")) THEN
        CONJ_TAC THEN FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"dist(x,y) < e
          ==> dist(g x,g y) <= dist(x,y) ==> dist(g x,g y) < e"))) THEN
        ASM_SIMP_TAC [],
        ALL_TAC] THEN
      MP_TAC (← SPEC (← q r"SUC n") (← ASSUME
      (← q r"!n. dist (a:real^N,b) <=
           dist ((f:num->real^N->real^N) n x,f n y)"))) THEN
      EXPAND_TAC "e" THEN NORM_ARITH_TAC,
      ALL_TAC] THEN
    EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
    EXISTS_TAC (← q r"\n:num. (f:num->real^N->real^N) (SUC(s n)) x") THEN
    REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"(g:real^N->real^N) continuous_on s") MP_TAC THENL
       [REWRITE_TAC [continuous_on] THEN ASM_MESON_TAC [REAL_LET_TRANS],
        ALL_TAC] THEN
      REWRITE_TAC [CONTINUOUS_ON_SEQUENTIALLY, o_DEF] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC [],
      SUBGOAL_THEN (← q r"!n. (f:num->real^N->real^N) (SUC n) x = f n y")
       (fun th => ASM_SIMP_TAC [th]) THEN
      INDUCT_TAC THEN ASM_REWRITE_TAC []])

  return { EDELSTEIN_FIX }

/- ------------------------------------------------------------------------- -/
/- Simple n-ary generalizations of Banach and Edelstein theorems, and Dini's -/
/- theorem.  (topology.ml 23975-24091)                                       -/
/- ------------------------------------------------------------------------- -/

structure FXD where
  BANACH_FIX_ITER : thm
  EDELSTEIN_FIX_ITER : thm
  DINI : thm
  deriving Inhabited

@[nospecialize]
def setupFXD [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLIM2 : LIM2) (BARI : ARI) (BCPT : CPT)
    (BCMS : CMS) (BCLC : CLC) (BLCB : LCB) (BBFX : BFX) (BEDF : EDF) :
    ExceptT String IO FXD := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC, .. } := D
  let { ADD1, ETA_AX, EXISTS_FINITE_SUBSET_IMAGE, EXISTS_UNIQUE, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_I, IMAGE_o, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LE_REFL, LE_TRANS, MONO_EXISTS, .. } := D.core3
  let { SUBSET, SUBSET_UNION, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LE, UNIONS_IMAGE, .. } := D.core6
  let { ITER, ITER_ALT, ITER_POINTLESS, .. } := D.lib1
  let { UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { DROP_SUB, .. } := D.vec1
  let { NORM_REAL, .. } := D.vec3
  let { dist, drop, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { IN_BALL_0, OPEN_BALL, .. } := BBAL
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_CONST, .. } := BARI
  let { COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY, .. } := BCPT
  let { CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_OPEN_IN_PREIMAGE, .. } := BCLC
  let { LIM_DROP_LE, .. } := BLCB
  let { BANACH_FIX, .. } := BBFX
  let { EDELSTEIN_FIX, .. } := BEDF
  -- @@SCOPE END

  let BANACH_FIX_ITER ← prove
   r"!f s:real^N->bool c n.
           complete s /\
           ~(s = {}) /\
           &0 <= c /\
           c < &1 /\
           IMAGE f s SUBSET s /\
           (!x y. x IN s /\ y IN s
                  ==> dist (ITER n f x,ITER n f y) <= c * dist (x,y))
           ==> ?!x. x IN s /\ f x = x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"ITER n f:real^N->real^N", ← q r"s:real^N->bool", ← q r"c:real"]
          BANACH_FIX) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [SPEC_TAC (← q r"n:num", ← q r"n:num") THEN INDUCT_TAC THEN
      ASM_REWRITE_TAC [ITER_POINTLESS, IMAGE_I, IMAGE_o] THEN
      ASM SET_TAC [],
      REWRITE_TAC [EXISTS_UNIQUE] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC
       (fun t => tactic_of do
         pure (ASSUME_TAC t THEN MP_TAC (← SPEC (← q r"(f:real^N->real^N) x") t)))) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        ASM_MESON_TAC [ITER_ALT, ITER],
        STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
      X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      SPEC_TAC (← q r"n:num", ← q r"n:num") THEN INDUCT_TAC THEN
      ASM_REWRITE_TAC [ITER]])

  let EDELSTEIN_FIX_ITER ← prove
   r"!f s n.
        compact s /\ ~(s = {}) /\ (IMAGE f s) SUBSET s /\
        (!x y. x IN s /\ y IN s /\ ~(x = y)
               ==> dist(ITER n f x,ITER n f y) < dist(x,y))
        ==> ?!x:real^N. x IN s /\ f x = x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"ITER n f:real^N->real^N", ← q r"s:real^N->bool"]
          EDELSTEIN_FIX) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [SPEC_TAC (← q r"n:num", ← q r"n:num") THEN INDUCT_TAC THEN
      ASM_REWRITE_TAC [ITER_POINTLESS, IMAGE_I, IMAGE_o] THEN
      ASM SET_TAC [],
      REWRITE_TAC [EXISTS_UNIQUE] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC
       (fun t => tactic_of do
         pure (ASSUME_TAC t THEN MP_TAC (← SPEC (← q r"(f:real^N->real^N) x") t)))) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        ASM_MESON_TAC [ITER_ALT, ITER],
        STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
      X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      SPEC_TAC (← q r"n:num", ← q r"n:num") THEN INDUCT_TAC THEN
      ASM_REWRITE_TAC [ITER]])

  let DINI ← prove
   r"!f:num->real^N->real^1 g s.
        compact s /\ (!n. (f n) continuous_on s) /\ g continuous_on s /\
        (!x. x IN s ==> ((\n. (f n x)) --> g x) sequentially) /\
        (!n x. x IN s ==> drop(f n x) <= drop(f (n + 1) x))
        ==> !e. &0 < e
                ==> eventually (\n. !x. x IN s ==> norm(f n x - g x) < e)
                               sequentially"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x:real^N m n:num. x IN s /\ m <= n ==> drop(f m x) <= drop(f n x)")
    ASSUME_TAC THENL
     [GEN_TAC THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM_SIMP_TAC [ADD1] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n:num x:real^N. x IN s ==> drop(f n x) <= drop(g x)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LE) THEN
      EXISTS_TAC (← q r"\m:num. (f:num->real^N->real^1) n x") THEN
      EXISTS_TAC (← q r"\m:num. (f:num->real^N->real^1) m x") THEN
      ASM_SIMP_TAC [LIM_CONST, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [LIM_SEQUENTIALLY, dist]) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id
     [COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY]) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"IMAGE (\n. { x | x IN s /\ norm((f:num->real^N->real^1) n x - g x) < e})
            (:num)")) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE, SUBSET_UNION, UNIONS_IMAGE] THEN
    REWRITE_TAC [IN_UNIV, IN_ELIM_THM, EVENTUALLY_SEQUENTIALLY] THEN
    SIMP_TAC [SUBSET, IN_UNIV, IN_ELIM_THM] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [LE_REFL]] THEN
      X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [← GSYM IN_BALL_0] THEN
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE THEN
      ASM_SIMP_TAC [OPEN_BALL, CONTINUOUS_ON_SUB, ETA_AX],
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:num->bool") (CONJUNCTS_THEN2
       (MP_TAC o SPEC (← q r"\n:num. n") o MATCH_MP UPPER_BOUND_FINITE_SET)
       (LABEL_TAC "*"))) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      REWRITE_TAC [] THEN STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB] THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"m <= n /\ n <= g ==> abs(m - g) < e ==> abs(n - g) < e")) THEN
      ASM_MESON_TAC [LE_TRANS]])

  return { BANACH_FIX_ITER, EDELSTEIN_FIX_ITER, DINI }

/- ------------------------------------------------------------------------- -/
/- Closest point of a (closed) set to a point.  (topology.ml 24092-24270)    -/
/- ------------------------------------------------------------------------- -/

structure CLP where
  closest_point : thm
  CLOSEST_POINT_EXISTS : thm
  CLOSEST_POINT_IN_SET : thm
  CLOSEST_POINT_LE : thm
  CLOSEST_POINT_SELF : thm
  CLOSEST_POINT_REFL : thm
  DIST_CLOSEST_POINT_LIPSCHITZ : thm
  CONTINUOUS_AT_DIST_CLOSEST_POINT : thm
  CONTINUOUS_ON_DIST_CLOSEST_POINT : thm
  UNIFORMLY_CONTINUOUS_ON_DIST_CLOSEST_POINT : thm
  SEGMENT_TO_CLOSEST_POINT : thm
  SEGMENT_TO_POINT_EXISTS : thm
  CLOSEST_POINT_IN_INTERIOR : thm
  CLOSEST_POINT_IN_FRONTIER : thm
  CLOSEST_POINT_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupCLP [HolBase] (D : TopologyDeps) (BBAL : BAL) (BSEG : SEG) (BCON : CON) (BINT : INT)
    (BCLS1 : CLS1) (BFRO1 : FRO1) (BFRO2 : FRO2) (BCBL : CBL) (BCNT1 : CNT1) (BCNO : CNO)
    (BCSL : CSL) (BDST : DST) : ExceptT String IO CLP := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SELECT_CONV,
        VECTOR_ARITH, NORM_ARITH, NORM_ARITH_TAC, .. } := D
  let { FUN_EQ_THM, IN_DIFF, IN_INSERT, IN_INTER, .. } := D.core2
  let { IN_UNIV, MEMBER_NOT_EMPTY, NOT_IMP, NOT_IN_EMPTY, REAL_ABS_DIV, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_DIV, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_MIN, REAL_LT_MUL, .. } := D.core4
  let { REAL_MIN_LE, REAL_NOT_LE, REAL_NOT_LT, SELECT_UNIQUE, SUBSET, .. } := D.core5
  let { DIST_LE_0, DIST_LIFT, DIST_NZ, DIST_POS_LE, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_SUB_EQ, dist, .. } := D.vec4
  let { IN_CBALL, .. } := BBAL
  let { DIST_IN_CLOSED_SEGMENT, DIST_IN_OPEN_SEGMENT, ENDS_IN_SEGMENT, open_segment, .. } := BSEG
  let { CONNECTED_SEGMENT, .. } := BCON
  let { INTERIOR_SUBSET, INTERIOR_UNIV, .. } := BINT
  let { CLOSURE_CLOSED, CLOSURE_EMPTY, .. } := BCLS1
  let { FRONTIER_EMPTY, frontier, .. } := BFRO1
  let { CONNECTED_INTER_FRONTIER, FRONTIER_INTERIOR_SUBSET, .. } := BFRO2
  let { IN_INTERIOR_CBALL, .. } := BCBL
  let { continuous_at, .. } := BCNT1
  let { uniformly_continuous_on, .. } := BCNO
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := BCSL
  let { DISTANCE_ATTAINS_INF, .. } := BDST
  -- @@SCOPE END

  let closest_point ← new_definition
   r"closest_point s a = @x. x IN s /\ !y. y IN s ==> dist(a,x) <= dist(a,y)"

  let CLOSEST_POINT_EXISTS ← prove
   r"!s a. closed s /\ ~(s = {})
         ==> (closest_point s a) IN s /\
             !y. y IN s ==> dist(a,closest_point s a) <= dist(a,y)"
   (REWRITE_TAC [closest_point] THEN CONV_TAC (ONCE_DEPTH_CONV SELECT_CONV) THEN
    REWRITE_TAC [DISTANCE_ATTAINS_INF])

  let CLOSEST_POINT_IN_SET ← prove
   r"!s a. closed s /\ ~(s = {}) ==> (closest_point s a) IN s"
   (MESON_TAC [CLOSEST_POINT_EXISTS])

  let CLOSEST_POINT_LE ← prove
   r"!s a x. closed s /\ x IN s ==> dist(a,closest_point s a) <= dist(a,x)"
   (MESON_TAC [CLOSEST_POINT_EXISTS, MEMBER_NOT_EMPTY])

  let CLOSEST_POINT_SELF ← prove
   r"!s x:real^N. x IN s ==> closest_point s x = x"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [closest_point] THEN
    MATCH_MP_TAC SELECT_UNIQUE THEN REWRITE_TAC [] THEN GEN_TAC THEN EQ_TAC THENL
     [STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_SIMP_TAC [DIST_LE_0, DIST_REFL],
      STRIP_TAC THEN ASM_REWRITE_TAC [DIST_REFL, DIST_POS_LE]])

  let CLOSEST_POINT_REFL ← prove
   r"!s x:real^N. closed s /\ ~(s = {}) ==> (closest_point s x = x <=> x IN s)"
   (MESON_TAC [CLOSEST_POINT_IN_SET, CLOSEST_POINT_SELF])

  let DIST_CLOSEST_POINT_LIPSCHITZ ← prove
   r"!s x y:real^N.
        closed s /\ ~(s = {})
        ==> abs(dist(x,closest_point s x) - dist(y,closest_point s y))
            <= dist(x,y)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSEST_POINT_EXISTS) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (CONJUNCTS_THEN2 ASSUME_TAC
             (MP_TAC o SPEC (← q r"closest_point s (y:real^N)")) (← SPEC (← q r"x:real^N") th) THEN
            CONJUNCTS_THEN2 ASSUME_TAC
             (MP_TAC o SPEC (← q r"closest_point s (x:real^N)")) (← SPEC (← q r"y:real^N") th))) THEN
    ASM_REWRITE_TAC [] THEN NORM_ARITH_TAC)

  let CONTINUOUS_AT_DIST_CLOSEST_POINT ← prove
   r"!s x:real^N.
        closed s /\ ~(s = {})
        ==> (\x. lift(dist(x,closest_point s x))) continuous (at x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [continuous_at, DIST_LIFT] THEN
    ASM_MESON_TAC [DIST_CLOSEST_POINT_LIPSCHITZ, REAL_LET_TRANS])

  let CONTINUOUS_ON_DIST_CLOSEST_POINT ← prove
   r"!s t. closed s /\ ~(s = {})
         ==> (\x. lift(dist(x,closest_point s x))) continuous_on t"
   (MESON_TAC [CONTINUOUS_AT_IMP_CONTINUOUS_ON,
               CONTINUOUS_AT_DIST_CLOSEST_POINT])

  let UNIFORMLY_CONTINUOUS_ON_DIST_CLOSEST_POINT ← prove
   r"!s t:real^N->bool.
        closed s /\ ~(s = {})
        ==> (\x. lift(dist(x,closest_point s x))) uniformly_continuous_on t"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [uniformly_continuous_on, DIST_LIFT] THEN
    ASM_MESON_TAC [DIST_CLOSEST_POINT_LIPSCHITZ, REAL_LET_TRANS])

  let SEGMENT_TO_CLOSEST_POINT ← prove
   r"!s a:real^N.
        closed s /\ ~(s = {})
        ==> segment(a,closest_point s a) INTER s = {}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER t = {} <=> !x. x IN s ==> ~(x IN t)")] THEN
    GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP DIST_IN_OPEN_SEGMENT) THEN
    MATCH_MP_TAC (← TAUT (← q r"(r ==> ~p) ==> p /\ q ==> ~r")) THEN
    ASM_MESON_TAC [CLOSEST_POINT_EXISTS, REAL_NOT_LT, DIST_SYM])

  let SEGMENT_TO_POINT_EXISTS ← prove
   r"!s a:real^N.
        closed s /\ ~(s = {}) ==> ?b. b IN s /\ segment(a,b) INTER s = {}"
   (MESON_TAC [SEGMENT_TO_CLOSEST_POINT, CLOSEST_POINT_EXISTS])

  let CLOSEST_POINT_IN_INTERIOR ← prove
   r"!s x:real^N.
        closed s /\ ~(s = {})
        ==> ((closest_point s x) IN interior s <=> x IN interior s)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
    ASM_SIMP_TAC [CLOSEST_POINT_SELF] THEN
    MATCH_MP_TAC (← TAUT (← q r"~q /\ ~p ==> (p <=> q)")) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [INTERIOR_SUBSET, SUBSET], STRIP_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERIOR_CBALL]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"closest_point s (x:real^N) IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [INTERIOR_SUBSET, SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(closest_point s (x:real^N) = x)") ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N",
     ← q r"closest_point s x -
      (min (&1) (e / norm(closest_point s x - x))) %
      (closest_point s x - x):real^N"]
      CLOSEST_POINT_LE) THEN
    ASM_REWRITE_TAC [dist, NOT_IMP, ← VECTOR_ARITH
     (← q r"x - (y - e % (y - x)):real^N = (&1 - e) % (x - y)")] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [IN_CBALL, ← NORM_ARITH (← q r"dist(a:real^N,a - x) = norm x")] THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= a ==> abs(min (&1) a) <= a")) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LE_DIV, NORM_POS_LE],
      REWRITE_TAC [NORM_MUL, ← REAL_ARITH
       (← q r"~(n <= a * n) <=> &0 < (&1 - a) * n")] THEN
      MATCH_MP_TAC REAL_LT_MUL THEN
      ASM_SIMP_TAC [NORM_POS_LT, VECTOR_SUB_EQ] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < e /\ e <= &1 ==> &0 < &1 - abs(&1 - e)")) THEN
      REWRITE_TAC [REAL_MIN_LE, REAL_LT_MIN, REAL_LT_01, REAL_LE_REFL] THEN
      ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT, VECTOR_SUB_EQ]])

  let CLOSEST_POINT_IN_FRONTIER ← prove
   r"!s x:real^N.
        closed s /\ ~(s = {}) /\ ~(x IN interior s)
        ==> (closest_point s x) IN frontier s"
   (SIMP_TAC [frontier, IN_DIFF, CLOSEST_POINT_IN_INTERIOR] THEN
    SIMP_TAC [CLOSEST_POINT_IN_SET, CLOSURE_CLOSED])

  let CLOSEST_POINT_FRONTIER ← prove
   r"!s x:real^N.
        ~(x IN interior s)
        ==> closest_point (frontier s) x = closest_point (closure s) x"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [FRONTIER_EMPTY, CLOSURE_EMPTY] THEN
    ASM_CASES_TAC (← q r"s = (:real^N)") THEN
    ASM_REWRITE_TAC [INTERIOR_UNIV, IN_UNIV] THEN DISCH_TAC THEN
    REWRITE_TAC [closest_point] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [] THEN EQ_TAC THEN STRIP_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [frontier, IN_DIFF], ALL_TAC] THEN
      X_GEN_TAC (← q r"z:real^N") THEN ASM_CASES_TAC (← q r"(z:real^N) IN interior s") THENL
       [DISCH_THEN (K ALL_TAC : thm → tactic), ASM_MESON_TAC [frontier, IN_DIFF]] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"segment[x:real^N,z]", ← q r"interior s:real^N->bool"]
          CONNECTED_INTER_FRONTIER) THEN
      PURE_REWRITE_TAC [CONNECTED_SEGMENT, ← GSYM MEMBER_NOT_EMPTY, NOT_IMP] THEN
      REWRITE_TAC [IN_INTER, IN_DIFF, NOT_IMP] THEN REPEAT CONJ_TAC THENL
       [EXISTS_TAC (← q r"z:real^N") THEN ASM_REWRITE_TAC [ENDS_IN_SEGMENT],
        EXISTS_TAC (← q r"x:real^N") THEN ASM_REWRITE_TAC [ENDS_IN_SEGMENT],
        DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:real^N")) THEN
        REWRITE_TAC [NOT_IMP] THEN
        FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
          FRONTIER_INTERIOR_SUBSET)) THEN
        CONJ_TAC THENL [ASM_MESON_TAC [SUBSET, frontier, IN_DIFF], ALL_TAC] THEN
        REWRITE_TAC [REAL_NOT_LE] THEN
        TRANS_TAC REAL_LET_TRANS (← q r"dist(x:real^N,z)") THEN
        ASM_MESON_TAC [DIST_IN_CLOSED_SEGMENT, DIST_SYM]],
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [frontier, IN_DIFF]] THEN
      ASM_REWRITE_TAC [frontier, IN_DIFF] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"segment[x:real^N,y]", ← q r"interior s:real^N->bool"]
          CONNECTED_INTER_FRONTIER) THEN
      PURE_REWRITE_TAC [CONNECTED_SEGMENT, ← GSYM MEMBER_NOT_EMPTY, NOT_IMP] THEN
      REWRITE_TAC [IN_INTER, IN_DIFF, NOT_IMP] THEN REPEAT CONJ_TAC THENL
       [EXISTS_TAC (← q r"y:real^N") THEN ASM_REWRITE_TAC [ENDS_IN_SEGMENT],
        EXISTS_TAC (← q r"x:real^N") THEN ASM_REWRITE_TAC [ENDS_IN_SEGMENT],
        DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:real^N")) THEN
        REWRITE_TAC [NOT_IMP] THEN
        FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
          FRONTIER_INTERIOR_SUBSET)) THEN
        CONJ_TAC THENL [ASM_MESON_TAC [SUBSET, frontier, IN_DIFF], ALL_TAC] THEN
        ASM_CASES_TAC (← q r"z:real^N = x") THEN
        ASM_REWRITE_TAC [REAL_NOT_LE, DIST_REFL, ← GSYM DIST_NZ] THENL
         [ASM_MESON_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"z IN segment(x:real^N,y)") MP_TAC THENL
         [ALL_TAC, ASM_MESON_TAC [DIST_IN_OPEN_SEGMENT, DIST_SYM]] THEN
        ASM_REWRITE_TAC [open_segment, IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
        ASM_MESON_TAC [frontier, IN_DIFF]]])

  return { closest_point, CLOSEST_POINT_EXISTS, CLOSEST_POINT_IN_SET, CLOSEST_POINT_LE,
           CLOSEST_POINT_SELF, CLOSEST_POINT_REFL, DIST_CLOSEST_POINT_LIPSCHITZ,
           CONTINUOUS_AT_DIST_CLOSEST_POINT, CONTINUOUS_ON_DIST_CLOSEST_POINT,
           UNIFORMLY_CONTINUOUS_ON_DIST_CLOSEST_POINT, SEGMENT_TO_CLOSEST_POINT,
           SEGMENT_TO_POINT_EXISTS, CLOSEST_POINT_IN_INTERIOR, CLOSEST_POINT_IN_FRONTIER,
           CLOSEST_POINT_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- More general infimum of distance between two sets.                        -/
/- (topology.ml 24271-24411)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SDS where
  setdist : thm
  SETDIST_EMPTY : thm
  SETDIST_POS_LE : thm
  SETDIST_POS_LT : thm
  SETDIST_SUBSETS_EQ : thm
  REAL_LE_SETDIST : thm
  SETDIST_LE_DIST : thm
  REAL_LE_SETDIST_EQ : thm
  REAL_SETDIST_LT_EXISTS : thm
  SETDIST_REFL : thm
  SETDIST_SYM : thm
  SETDIST_TRIANGLE : thm
  SETDIST_SINGS : thm
  SETDIST_SCALING : thm
  deriving Inhabited

@[nospecialize]
def setupSDS [HolBase] (D : TopologyDeps) : ExceptT String IO SDS := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        NORM_ARITH, .. } := D
  let { DISJ_SYM, EXTENSION, FINITE_EMPTY, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_UNWIND_THM2, IMAGE_CLAUSES, IMAGE_EQ_EMPTY,
        IMP_CONJ, IMP_IMP, INF, INF_EQ, INF_INSERT_FINITE, INF_UNIQUE, IN_ELIM_THM, IN_SING, .. } :=
    D.core2
  let { MEMBER_NOT_EMPTY, NOT_INSERT_EMPTY, NOT_IN_EMPTY, REAL_ABS_NZ, REAL_ADD_LID,
        REAL_ADD_RID, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_INF, REAL_LE_INF_EQ, REAL_LE_LDIV_EQ, REAL_LE_REFL,
        REAL_LE_SUB_RADD, REAL_LE_TRANS, REAL_LT_LE, .. } := D.core4
  let { REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NOT_LE, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SUBSET, .. } := D.core5
  let { DIST_MUL, DIST_POS_LE, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { VECTOR_MUL_LZERO, .. } := D.vec4
  -- @@SCOPE END

  let setdist ← new_definition
   r"setdist(s,t) =
        if s = {} \/ t = {} then &0
        else inf {dist(x,y) | x IN s /\ y IN t}"

  let SETDIST_EMPTY ← prove
   r"(!t. setdist({},t) = &0) /\ (!s. setdist(s,{}) = &0)"
   (REWRITE_TAC [setdist])

  let SETDIST_POS_LE ← prove
   r"!s t. &0 <= setdist(s,t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [setdist] THEN
    COND_CASES_TAC THEN REWRITE_TAC [REAL_LE_REFL] THEN
    MATCH_MP_TAC REAL_LE_INF THEN
    REWRITE_TAC [FORALL_IN_GSPEC, DIST_POS_LE] THEN ASM SET_TAC [])

  let SETDIST_POS_LT ← prove
   r"!s t:real^N->bool. &0 < setdist(s,t) <=> ~(setdist(s,t) = &0)"
   (REWRITE_TAC [REAL_LT_LE, SETDIST_POS_LE] THEN REAL_ARITH_TAC)

  let SETDIST_SUBSETS_EQ ← prove
   r"!s t s' t':real^N->bool.
     s' SUBSET s /\ t' SUBSET t /\
     (!x y. x IN s /\ y IN t
            ==> ?x' y'. x' IN s' /\ y' IN t' /\ dist(x',y') <= dist(x,y))
     ==> setdist(s',t') = setdist(s,t)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_CASES_TAC (← q r"s':real^N->bool = {}") THEN
      ASM_REWRITE_TAC [SETDIST_EMPTY] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_CASES_TAC (← q r"t':real^N->bool = {}") THEN
      ASM_REWRITE_TAC [SETDIST_EMPTY] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"s':real^N->bool = {}") THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"t':real^N->bool = {}") THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [setdist] THEN MATCH_MP_TAC INF_EQ THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_MESON_TAC [SUBSET, REAL_LE_TRANS])

  let REAL_LE_SETDIST ← prove
   r"!s t:real^N->bool d.
        ~(s = {}) /\ ~(t = {}) /\
        (!x y. x IN s /\ y IN t ==> d <= dist(x,y))
        ==> d <= setdist(s,t)"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [setdist] THEN
    MP_TAC (← ISPEC (← q r"{dist(x:real^N,y) | x IN s /\ y IN t}") INF) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM SET_TAC [], MESON_TAC [DIST_POS_LE]], ALL_TAC] THEN
    ASM_MESON_TAC [])

  let SETDIST_LE_DIST ← prove
   r"!s t x y:real^N. x IN s /\ y IN t ==> setdist(s,t) <= dist(x,y)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [setdist] THEN
    COND_CASES_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"{dist(x:real^N,y) | x IN s /\ y IN t}") INF) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM SET_TAC [], MESON_TAC [DIST_POS_LE]], ALL_TAC] THEN
    ASM_MESON_TAC [])

  let REAL_LE_SETDIST_EQ ← prove
   r"!d s t:real^N->bool.
        d <= setdist(s,t) <=>
        (!x y. x IN s /\ y IN t ==> d <= dist(x,y)) /\
        (s = {} \/ t = {} ==> d <= &0)"
   (REPEAT GEN_TAC THEN MAP_EVERY ASM_CASES_TAC
     [← q r"s:real^N->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [SETDIST_EMPTY, NOT_IN_EMPTY] THEN
    ASM_MESON_TAC [REAL_LE_SETDIST, SETDIST_LE_DIST, REAL_LE_TRANS])

  let REAL_SETDIST_LT_EXISTS ← prove
   r"!s t:real^N->bool b.
        ~(s = {}) /\ ~(t = {}) /\ setdist(s,t) < b
        ==> ?x y. x IN s /\ y IN t /\ dist(x,y) < b"
   (REWRITE_TAC [← GSYM REAL_NOT_LE, REAL_LE_SETDIST_EQ] THEN MESON_TAC [])

  let SETDIST_REFL ← prove
   r"!s:real^N->bool. setdist(s,s) = &0"
   (GEN_TAC THEN REWRITE_TAC [← GSYM REAL_LE_ANTISYM, SETDIST_POS_LE] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [setdist, REAL_LE_REFL], ALL_TAC] THEN
    ASM_MESON_TAC [SETDIST_LE_DIST, MEMBER_NOT_EMPTY, DIST_REFL])

  let SETDIST_SYM ← prove
   r"!s t. setdist(s,t) = setdist(t,s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [setdist, DISJ_SYM] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    MESON_TAC [DIST_SYM])

  let SETDIST_TRIANGLE ← prove
   r"!s a t:real^N->bool.
        setdist(s,t) <= setdist(s,{a}) + setdist({a},t)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SETDIST_EMPTY, REAL_ADD_LID, SETDIST_POS_LE] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SETDIST_EMPTY, REAL_ADD_RID, SETDIST_POS_LE] THEN
    ONCE_REWRITE_TAC [← GSYM REAL_LE_SUB_RADD] THEN
    MATCH_MP_TAC REAL_LE_SETDIST THEN
    ASM_REWRITE_TAC [NOT_INSERT_EMPTY, IN_SING, IMP_CONJ,
                     RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"x - y <= z <=> x - z <= y")] THEN
    MATCH_MP_TAC REAL_LE_SETDIST THEN
    ASM_REWRITE_TAC [NOT_INSERT_EMPTY, IN_SING, IMP_CONJ,
                     RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2] THEN
    X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
    REWRITE_TAC [REAL_LE_SUB_RADD] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"dist(x:real^N,y)") THEN
    ASM_SIMP_TAC [SETDIST_LE_DIST] THEN CONV_TAC (fun t => NORM_ARITH t))

  let SETDIST_SINGS ← prove
   r"!x y. setdist({x},{y}) = dist(x,y)"
   (REWRITE_TAC [setdist, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x y | x IN {a} /\ y IN {b}} = {f a b}")] THEN
    SIMP_TAC [INF_INSERT_FINITE, FINITE_EMPTY])

  let SETDIST_SCALING ← prove
   r"!a s t:real^N->bool.
        setdist(IMAGE (\x. a % x) s,IMAGE (\x. a % x) t) =
        abs a * setdist(s,t)"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"s:real^N->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [REAL_MUL_RZERO, SETDIST_EMPTY, IMAGE_CLAUSES] THEN
    ASM_CASES_TAC (← q r"a = &0") THENL
     [ASM_SIMP_TAC [VECTOR_MUL_LZERO, SETDIST_REFL, ← SET_RULE
       (← q r"~(s = {}) ==> IMAGE (\x. a) s = {a}")] THEN REAL_ARITH_TAC,
      ASM_REWRITE_TAC [setdist, IMAGE_EQ_EMPTY] THEN MATCH_MP_TAC INF_UNIQUE THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, DIST_MUL] THEN
      X_GEN_TAC (← q r"c:real") THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, ← GSYM REAL_ABS_NZ] THEN
      CONV_TAC SYM_CONV THEN
      W (MP_TAC o PART_MATCH (lhand o rand) REAL_LE_INF_EQ o lhand o snd) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
      DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MESON_TAC [DIST_POS_LE]])

  return { setdist, SETDIST_EMPTY, SETDIST_POS_LE, SETDIST_POS_LT, SETDIST_SUBSETS_EQ,
           REAL_LE_SETDIST, SETDIST_LE_DIST, REAL_LE_SETDIST_EQ, REAL_SETDIST_LT_EXISTS,
           SETDIST_REFL, SETDIST_SYM, SETDIST_TRIANGLE, SETDIST_SINGS, SETDIST_SCALING }

/- ------------------------------------------------------------------------- -/
/- Uniform continuity via setdist, and setdist scaling.                      -/
/- (topology.ml 24412-24465)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SDU where
  SETDIST_UNIFORMLY_CONTINUOUS_ON : thm
  SETDIST_UNIFORMLY_CONTINUOUS_ON_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupSDU [HolBase] (D : TopologyDeps) (BBND1 : BND1) (BCNO : CNO) (BSDS : SDS) :
    ExceptT String IO SDU := do
  -- @@SCOPE BEGIN
  let { REAL_ARITH, SET_RULE, add_scaling_theorems, .. } := D
  let { FUN_IN_IMAGE, IMAGE_CLAUSES, IN_SING, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP, .. } := D.core3
  let { REAL_LT_IMP_LE, .. } := D.core4
  let { SING_SUBSET, SUBSET, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { BOUNDED_SING, .. } := BBND1
  let { uniformly_continuous_on, .. } := BCNO
  let { REAL_SETDIST_LT_EXISTS, SETDIST_EMPTY, SETDIST_LE_DIST, SETDIST_SCALING,
        SETDIST_SINGS, .. } := BSDS
  -- @@SCOPE END

  let (SETDIST_UNIFORMLY_CONTINUOUS_ON, SETDIST_UNIFORMLY_CONTINUOUS_ON_ALT) ←
    CONJ_PAIR (← prove
   r"(!f:real^M->real^N s.
        f uniformly_continuous_on s <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !t t'. t SUBSET s /\ t' SUBSET s /\ setdist(t',t) < d
                           ==> setdist(IMAGE f t',IMAGE f t) < e) /\
   (!f:real^M->real^N s.
        f uniformly_continuous_on s <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !t t'. t SUBSET s /\ t' SUBSET s /\
                           bounded t /\ bounded t' /\
                           setdist(t',t) < d
                           ==> setdist(IMAGE f t',IMAGE f t) < e)"
   (CONJ_TAC THEN
    (REPEAT GEN_TAC THEN REWRITE_TAC [uniformly_continuous_on] THEN EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"d / &2") THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real^M->bool", ← q r"t':real^M->bool"] THEN
      STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
      ASM_CASES_TAC (← q r"t:real^M->bool = {}") THEN
      ASM_SIMP_TAC [SETDIST_EMPTY, IMAGE_CLAUSES, REAL_HALF, REAL_LT_IMP_LE] THEN
      ASM_CASES_TAC (← q r"t':real^M->bool = {}") THEN
      ASM_SIMP_TAC [SETDIST_EMPTY, IMAGE_CLAUSES, REAL_HALF, REAL_LT_IMP_LE] THEN
      MP_TAC (← ISPECL [← q r"t':real^M->bool", ← q r"t:real^M->bool", ← q r"d / &2"]
          REAL_SETDIST_LT_EXISTS) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"y:real^M", ← q r"x:real^M"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^M", ← q r"y:real^M"]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"x < d / &2 /\ &0 < d ==> x < d")] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> y < e / &2 ==> x <= e / &2")) THEN
      MATCH_MP_TAC SETDIST_LE_DIST THEN ASM_SIMP_TAC [IN_SING, FUN_IN_IMAGE],
      MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM SETDIST_SINGS] THEN REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"{f x} = IMAGE f {x}")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [SING_SUBSET, BOUNDED_SING]])))

  -- let th = prove (...) in add_scaling_theorems [th];;
  do
    let th ← prove
     r"!c. &0 < c
         ==> !s t. setdist(IMAGE (\x. c % x) s,IMAGE (\x. c % x) t) =
                   c * setdist(s,t)"
     (SIMP_TAC [SETDIST_SCALING, ← REAL_ARITH (← q r"&0 < c ==> abs c = c")])
    add_scaling_theorems [th]

  return { SETDIST_UNIFORMLY_CONTINUOUS_ON, SETDIST_UNIFORMLY_CONTINUOUS_ON_ALT }

/- ------------------------------------------------------------------------- -/
/- Continuity, subsets, closures and frontiers for setdist.                  -/
/- (topology.ml 24466-24561)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SD2 where
  SETDIST_SING_TRIANGLE : thm
  CONTINUOUS_AT_LIFT_SETDIST : thm
  CONTINUOUS_ON_LIFT_SETDIST : thm
  UNIFORMLY_CONTINUOUS_ON_LIFT_SETDIST : thm
  SETDIST_DIFFERENCES : thm
  SETDIST_SUBSET_RIGHT : thm
  SETDIST_SUBSET_LEFT : thm
  SETDIST_CLOSURE : thm
  SETDIST_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupSD2 [HolBase] (D : TopologyDeps) (BSEG : SEG) (BCON : CON) (BINT : INT) (BCLS1 : CLS1)
    (BFRO1 : FRO1) (BFRO2 : FRO2) (BCNT1 : CNT1) (BCNO : CNO) (BCSL : CSL) (BCMS : CMS)
    (BIDC : IDC) (BECF : ECF) (BLFR : LFR) (BSDS : SDS) : ExceptT String IO SD2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, DISJOINT_SYM, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_SING, .. } := D.core2
  let { MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_ANTISYM, REAL_LE_INF_SUBSET, REAL_LE_REFL, .. } := D.core4
  let { RIGHT_EXISTS_AND_THM, SUBSET, SUBSET_DIFF, SUBSET_REFL, .. } := D.core5
  let { SWAP_EXISTS_THM, SWAP_FORALL_THM, UNWIND_THM2, o_DEF, .. } := D.core6
  let { DIST_0, DIST_LIFT, DIST_POS_LE, .. } := D.vec1
  let { dist, .. } := D.vec4
  let { DIST_IN_CLOSED_SEGMENT, ENDS_IN_SEGMENT, .. } := BSEG
  let { CONNECTED_SEGMENT, .. } := BCON
  let { INTERIOR_SUBSET, .. } := BINT
  let { CLOSURE_EMPTY, CLOSURE_EQ_EMPTY, CLOSURE_SUBSET, .. } := BCLS1
  let { frontier, .. } := BFRO1
  let { CONNECTED_INTER_FRONTIER, .. } := BFRO2
  let { continuous_at, .. } := BCNT1
  let { uniformly_continuous_on, .. } := BCNO
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := BCSL
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { CONTINUOUS_GE_ON_CLOSURE, .. } := BECF
  let { CONTINUOUS_ON_LIFT_NORM_COMPOSE, .. } := BLFR
  let { REAL_LE_SETDIST_EQ, SETDIST_EMPTY, SETDIST_POS_LE, SETDIST_SINGS, SETDIST_SUBSETS_EQ,
        SETDIST_SYM, SETDIST_TRIANGLE, setdist, .. } := BSDS
  -- @@SCOPE END

  let SETDIST_SING_TRIANGLE ← prove
   r"!s x y:real^N. abs(setdist({x},s) - setdist({y},s)) <= dist(x,y)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SETDIST_SINGS] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"abs(x - y) <= z <=> x <= z + y /\ y <= z + x")] THEN
    MESON_TAC [SETDIST_TRIANGLE, SETDIST_SYM])

  let CONTINUOUS_AT_LIFT_SETDIST ← prove
   r"!s x:real^N. (\y. lift(setdist({y},s))) continuous (at x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [continuous_at, DIST_LIFT] THEN
    ASM_MESON_TAC [SETDIST_SING_TRIANGLE, REAL_LET_TRANS])

  let CONTINUOUS_ON_LIFT_SETDIST ← prove
   r"!s t:real^N->bool. (\y. lift(setdist({y},s))) continuous_on t"
   (MESON_TAC [CONTINUOUS_AT_IMP_CONTINUOUS_ON,
               CONTINUOUS_AT_LIFT_SETDIST])

  let UNIFORMLY_CONTINUOUS_ON_LIFT_SETDIST ← prove
   r"!s t:real^N->bool.
         (\y. lift(setdist({y},s))) uniformly_continuous_on t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [uniformly_continuous_on, DIST_LIFT] THEN
    ASM_MESON_TAC [SETDIST_SING_TRIANGLE, REAL_LET_TRANS])

  let SETDIST_DIFFERENCES ← prove
   r"!s t. setdist(s,t) = setdist({vec 0},{x - y:real^N | x IN s /\ y IN t})"
   (REPEAT GEN_TAC THEN REWRITE_TAC [setdist, NOT_INSERT_EMPTY,
       ← SET_RULE (← q r"{f x y | x IN s /\ y IN t} = {} <=> s = {} \/ t = {}")] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_SING] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM, UNWIND_THM2, DIST_0] THEN
    REWRITE_TAC [dist] THEN MESON_TAC [])

  let SETDIST_SUBSET_RIGHT ← prove
   r"!s t u:real^N->bool.
    ~(t = {}) /\ t SUBSET u ==> setdist(s,u) <= setdist(s,t)"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"s:real^N->bool = {}", ← q r"u:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [SETDIST_EMPTY, SETDIST_POS_LE, REAL_LE_REFL] THEN
    ASM_REWRITE_TAC [setdist] THEN MATCH_MP_TAC REAL_LE_INF_SUBSET THEN
    ASM_REWRITE_TAC [FORALL_IN_GSPEC, SUBSET] THEN
    REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    MESON_TAC [DIST_POS_LE])

  let SETDIST_SUBSET_LEFT ← prove
   r"!s t u:real^N->bool.
    ~(s = {}) /\ s SUBSET t ==> setdist(t,u) <= setdist(s,u)"
   (MESON_TAC [SETDIST_SUBSET_RIGHT, SETDIST_SYM])

  let SETDIST_CLOSURE ← prove
   r"(!s t:real^N->bool. setdist(closure s,t) = setdist(s,t)) /\
   (!s t:real^N->bool. setdist(s,closure t) = setdist(s,t))"
   (GEN_REWRITE_TAC RAND_CONV [SWAP_FORALL_THM] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [SETDIST_SYM] THEN
    REWRITE_TAC [] THEN
    REWRITE_TAC [← MESON [REAL_LE_ANTISYM]
     (← q r"x:real = y <=> !d. d <= x <=> d <= y")] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [REAL_LE_SETDIST_EQ] THEN
    MAP_EVERY ASM_CASES_TAC [← q r"s:real^N->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [CLOSURE_EQ_EMPTY, CLOSURE_EMPTY, NOT_IN_EMPTY] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET c /\
      (!y. Q y /\ (!x. x IN s ==> P x y) ==> (!x. x IN c ==> P x y))
     ==> ((!x y. x IN c /\ Q y ==> P x y) <=>
          (!x y. x IN s /\ Q y ==> P x y))")) THEN
    REWRITE_TAC [CLOSURE_SUBSET] THEN GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_GE_ON_CLOSURE THEN
    ASM_REWRITE_TAC [o_DEF, dist] THEN
    MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE THEN
    SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID])

  let SETDIST_FRONTIER ← prove
   r"(!s t:real^N->bool.
        DISJOINT s t ==> setdist(frontier s,t) = setdist(s,t)) /\
   (!s t:real^N->bool.
        DISJOINT s t ==> setdist(s,frontier t) = setdist(s,t))"
   (MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN
    CONJ_TAC THENL [MESON_TAC [SETDIST_SYM, DISJOINT_SYM], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM (← CONJUNCT1 SETDIST_CLOSURE)] THEN
    MATCH_MP_TAC SETDIST_SUBSETS_EQ THEN
    REWRITE_TAC [frontier, IN_DIFF, SUBSET_DIFF, SUBSET_REFL] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN interior s") THENL
     [ALL_TAC, ASM_MESON_TAC [REAL_LE_REFL]] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN EXISTS_TAC (← q r"y:real^N") THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"segment[x:real^N,y]", ← q r"s:real^N->bool"]
          CONNECTED_INTER_FRONTIER) THEN
    REWRITE_TAC [CONNECTED_SEGMENT, ← GSYM MEMBER_NOT_EMPTY] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [EXISTS_TAC (← q r"x:real^N"), EXISTS_TAC (← q r"y:real^N")] THEN
      ASM_REWRITE_TAC [IN_INTER, IN_DIFF, ENDS_IN_SEGMENT] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN ASM SET_TAC [],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^N") THEN
      SIMP_TAC [IN_INTER, frontier, IN_DIFF] THEN
      MESON_TAC [DIST_IN_CLOSED_SEGMENT]])

  return { SETDIST_SING_TRIANGLE, CONTINUOUS_AT_LIFT_SETDIST, CONTINUOUS_ON_LIFT_SETDIST,
           UNIFORMLY_CONTINUOUS_ON_LIFT_SETDIST, SETDIST_DIFFERENCES, SETDIST_SUBSET_RIGHT,
           SETDIST_SUBSET_LEFT, SETDIST_CLOSURE, SETDIST_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Attainment, invariance and zero cases for setdist.                        -/
/- (topology.ml 24562-24756)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SD3 where
  SETDIST_COMPACT_CLOSED : thm
  SETDIST_CLOSED_COMPACT : thm
  SETDIST_EQ_0_COMPACT_CLOSED : thm
  SETDIST_EQ_0_CLOSED_COMPACT : thm
  SETDIST_EQ_0_BOUNDED : thm
  SETDIST_TRANSLATION : thm
  SETDIST_LINEAR_IMAGE : thm
  SETDIST_UNIQUE : thm
  SETDIST_UNIV : thm
  SETDIST_ZERO : thm
  SETDIST_ZERO_STRONG : thm
  SETDIST_FRONTIERS : thm
  SETDIST_SING_FRONTIER : thm
  SETDIST_CLOSEST_POINT : thm
  SETDIST_EQ_0_SING : thm
  SETDIST_EQ_0_CLOSED : thm
  SETDIST_EQ_0_CLOSED_IN : thm
  SETDIST_SING_IN_SET : thm
  SETDIST_SING_FRONTIER_CASES : thm
  SETDIST_LE_SING : thm
  deriving Inhabited

@[nospecialize]
def setupSD3 [HolBase] (D : TopologyDeps) (BSEG : SEG) (BCON : CON) (BCLS1 : CLS1) (BCLS2 : CLS2)
    (BFRO1 : FRO1) (BFRO2 : FRO2) (BBND1 : BND1) (BCPT : CPT) (BCPP1 : CPP1) (BCPP2 : CPP2)
    (BDST : DST) (BCCC : CCC) (BCLP : CLP) (BSDS : SDS) (BSD2 : SD2) :
    ExceptT String IO SD3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH,
        add_linear_invariants, add_translation_invariants, .. } := D
  let { CONJ_ASSOC, EXISTS_IN_GSPEC, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, IMAGE_EQ_EMPTY, IN_DIFF, IN_INTER, IN_SING, .. } := D.core2
  let { IN_UNIV, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_REFL, .. } := D.core4
  let { RIGHT_EXISTS_AND_THM, SUBSET, SUBSET_DIFF, SUBSET_REFL, .. } := D.core5
  let { SWAP_EXISTS_THM, UNWIND_THM1, UNWIND_THM2, .. } := D.core6
  let { DIST_0, DIST_EQ_0, DIST_POS_LE, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { LINEAR_SUB, .. } := D.vec2
  let { dist, .. } := D.vec4
  let { DIST_IN_CLOSED_SEGMENT, ENDS_IN_SEGMENT, .. } := BSEG
  let { CONNECTED_SEGMENT, .. } := BCON
  let { CLOSED_CLOSURE, CLOSURE_EQ_EMPTY, CLOSURE_SUBSET, INTERIOR_CLOSURE, SUBSET_CLOSURE, .. } :=
    BCLS1
  let { CLOSED_IN_INTER_CLOSURE, .. } := BCLS2
  let { frontier, .. } := BFRO1
  let { CONNECTED_INTER_FRONTIER, FRONTIER_INTERIOR_SUBSET, .. } := BFRO2
  let { BOUNDED_SING, .. } := BBND1
  let { COMPACT_CLOSURE, .. } := BCPT
  let { COMPACT_SING, .. } := BCPP1
  let { CLOSURE_SING, .. } := BCPP2
  let { DISTANCE_ATTAINS_INF, .. } := BDST
  let { CLOSED_COMPACT_DIFFERENCES, COMPACT_CLOSED_DIFFERENCES, .. } := BCCC
  let { CLOSEST_POINT_EXISTS, .. } := BCLP
  let { REAL_LE_SETDIST, REAL_LE_SETDIST_EQ, SETDIST_EMPTY, SETDIST_LE_DIST, SETDIST_POS_LE,
        SETDIST_SUBSETS_EQ, SETDIST_SYM, setdist, .. } := BSDS
  let { SETDIST_CLOSURE, SETDIST_DIFFERENCES, SETDIST_FRONTIER, SETDIST_SUBSET_LEFT, .. } := BSD2
  -- @@SCOPE END

  let SETDIST_COMPACT_CLOSED ← prove
   r"!s t:real^N->bool.
        compact s /\ closed t /\ ~(s = {}) /\ ~(t = {})
        ==> ?x y. x IN s /\ y IN t /\ dist(x,y) = setdist(s,t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!x y. P x /\ Q y ==> S x y) /\ (?x y. P x /\ Q y /\ R x y)
      ==> ?x y. P x /\ Q y /\ R x y /\ S x y")) THEN
    SIMP_TAC [SETDIST_LE_DIST] THEN
    ASM_REWRITE_TAC [REAL_LE_SETDIST_EQ] THEN
    MP_TAC (← ISPECL [← q r"{x - y:real^N | x IN s /\ y IN t}", ← q r"vec 0:real^N"]
          DISTANCE_ATTAINS_INF) THEN
    ASM_SIMP_TAC [COMPACT_CLOSED_DIFFERENCES, EXISTS_IN_GSPEC, FORALL_IN_GSPEC,
                  DIST_0, ← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [dist] THEN DISCH_THEN MATCH_MP_TAC THEN ASM SET_TAC [])

  let SETDIST_CLOSED_COMPACT ← prove
   r"!s t:real^N->bool.
        closed s /\ compact t /\ ~(s = {}) /\ ~(t = {})
        ==> ?x y. x IN s /\ y IN t /\ dist(x,y) = setdist(s,t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!x y. P x /\ Q y ==> S x y) /\ (?x y. P x /\ Q y /\ R x y)
      ==> ?x y. P x /\ Q y /\ R x y /\ S x y")) THEN
    SIMP_TAC [SETDIST_LE_DIST] THEN
    ASM_REWRITE_TAC [REAL_LE_SETDIST_EQ] THEN
    MP_TAC (← ISPECL [← q r"{x - y:real^N | x IN s /\ y IN t}", ← q r"vec 0:real^N"]
          DISTANCE_ATTAINS_INF) THEN
    ASM_SIMP_TAC [CLOSED_COMPACT_DIFFERENCES, EXISTS_IN_GSPEC, FORALL_IN_GSPEC,
                  DIST_0, ← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [dist] THEN DISCH_THEN MATCH_MP_TAC THEN ASM SET_TAC [])

  let SETDIST_EQ_0_COMPACT_CLOSED ← prove
   r"!s t:real^N->bool.
        compact s /\ closed t
        ==> (setdist(s,t) = &0 <=> s = {} \/ t = {} \/ ~(s INTER t = {}))"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"s:real^N->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [SETDIST_EMPTY] THEN EQ_TAC THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]
        SETDIST_COMPACT_CLOSED) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN MESON_TAC [DIST_EQ_0],
      REWRITE_TAC [← GSYM REAL_LE_ANTISYM, SETDIST_POS_LE] THEN
      REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN
      MESON_TAC [SETDIST_LE_DIST, DIST_EQ_0]])

  let SETDIST_EQ_0_CLOSED_COMPACT ← prove
   r"!s t:real^N->bool.
        closed s /\ compact t
        ==> (setdist(s,t) = &0 <=> s = {} \/ t = {} \/ ~(s INTER t = {}))"
   (ONCE_REWRITE_TAC [SETDIST_SYM] THEN
    SIMP_TAC [SETDIST_EQ_0_COMPACT_CLOSED] THEN SET_TAC [])

  let SETDIST_EQ_0_BOUNDED ← prove
   r"!s t:real^N->bool.
        (bounded s \/ bounded t)
        ==> (setdist(s,t) = &0 <=>
             s = {} \/ t = {} \/ ~(closure(s) INTER closure(t) = {}))"
   (REPEAT GEN_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"s:real^N->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [SETDIST_EMPTY] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [← MESON [SETDIST_CLOSURE]
     (← q r"setdist(s,t) = setdist(closure s,closure t)")] THEN
    ASM_SIMP_TAC [SETDIST_EQ_0_COMPACT_CLOSED, SETDIST_EQ_0_CLOSED_COMPACT,
                  COMPACT_CLOSURE, CLOSED_CLOSURE, CLOSURE_EQ_EMPTY])

  let SETDIST_TRANSLATION ← prove
   r"!a:real^N s t.
        setdist(IMAGE (\x. a + x) s,IMAGE (\x. a + x) t) = setdist(s,t)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [SETDIST_DIFFERENCES] THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{f x y | x IN IMAGE g s /\ y IN IMAGE g t} =
      {f (g x) (g y) | x IN s /\ y IN t}")] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) - (a + y):real^N = x - y")])

  add_translation_invariants [SETDIST_TRANSLATION]

  let SETDIST_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s t.
        linear f /\ (!x. norm(f x) = norm x)
        ==> setdist(IMAGE f s,IMAGE f t) = setdist(s,t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [setdist, IMAGE_EQ_EMPTY] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [dist] THEN AP_TERM_TAC THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{f x y | x IN IMAGE g s /\ y IN IMAGE g t} =
      {f (g x) (g y) | x IN s /\ y IN t}")] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_SUB th)])) THEN
    ASM_REWRITE_TAC [])

  add_linear_invariants [SETDIST_LINEAR_IMAGE]

  let SETDIST_UNIQUE ← prove
   r"!s t a b:real^N d.
        a IN s /\ b IN t /\ dist(a,b) = d /\
        (!x y. x IN s /\ y IN t ==> dist(a,b) <= dist(x,y))
        ==> setdist(s,t) = d"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SETDIST_LE_DIST],
      MATCH_MP_TAC REAL_LE_SETDIST THEN ASM SET_TAC []])

  let SETDIST_UNIV ← prove
   r"(!s. setdist(s,(:real^N)) = &0) /\
   (!t. setdist((:real^N),t) = &0)"
   (GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [SETDIST_SYM] THEN
    REWRITE_TAC [] THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN ASM_REWRITE_TAC [SETDIST_EMPTY] THEN
    MATCH_MP_TAC SETDIST_UNIQUE THEN
    REWRITE_TAC [IN_UNIV, DIST_EQ_0, RIGHT_EXISTS_AND_THM] THEN
    ASM_REWRITE_TAC [UNWIND_THM1, DIST_REFL, DIST_POS_LE, MEMBER_NOT_EMPTY])

  let SETDIST_ZERO ← prove
   r"!s t:real^N->bool. ~(DISJOINT s t) ==> setdist(s,t) = &0"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SETDIST_UNIQUE THEN
    MATCH_MP_TAC (← MESON [] (← q r"(?a. P a a) ==> ?a b. P a b")) THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> r /\ p /\ q /\ s")] THEN
    REWRITE_TAC [DIST_EQ_0, UNWIND_THM2, DIST_REFL, DIST_POS_LE] THEN
    ASM SET_TAC [])

  let SETDIST_ZERO_STRONG ← prove
   r"!s t:real^N->bool.
      ~(DISJOINT (closure s) (closure t)) ==> setdist(s,t) = &0"
   (MESON_TAC [SETDIST_CLOSURE, SETDIST_ZERO])

  let SETDIST_FRONTIERS ← prove
   r"!s t:real^N->bool.
        setdist(s,t) =
        if DISJOINT s t then setdist(frontier s,frontier t) else &0"
   (REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [SETDIST_ZERO] THEN
    ASM_SIMP_TAC [← GSYM SETDIST_FRONTIER] THEN
    ASM_CASES_TAC (← q r"DISJOINT s (frontier t:real^N->bool)") THENL
     [ASM_MESON_TAC [SETDIST_FRONTIER], ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM (← CONJUNCT1 SETDIST_CLOSURE)] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC SETDIST_SUBSETS_EQ THEN
    REWRITE_TAC [frontier, SUBSET_DIFF, SUBSET_REFL, IN_DIFF] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN EXISTS_TAC (← q r"y:real^N") THEN
    ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN interior s") THENL
     [ALL_TAC, ASM_MESON_TAC [REAL_LE_REFL]] THEN
    MP_TAC (← ISPECL [← q r"segment[x:real^N,y]", ← q r"interior s:real^N->bool"]
          CONNECTED_INTER_FRONTIER) THEN
    REWRITE_TAC [CONNECTED_SEGMENT, ← GSYM MEMBER_NOT_EMPTY] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [EXISTS_TAC (← q r"x:real^N"), EXISTS_TAC (← q r"y:real^N")] THEN
      ASM_REWRITE_TAC [IN_INTER, IN_DIFF, ENDS_IN_SEGMENT] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"y IN u ==> u INTER v = {} ==> ~(y IN v)"))) THEN
      REWRITE_TAC [INTERIOR_CLOSURE, ← SET_RULE
       (← q r"s INTER (UNIV DIFF t) = {} <=> s SUBSET t")] THEN
      MATCH_MP_TAC SUBSET_CLOSURE THEN ASM SET_TAC [],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^N") THEN
      SIMP_TAC [IN_INTER, ← GSYM frontier, ← GSYM IN_DIFF] THEN
      MESON_TAC [FRONTIER_INTERIOR_SUBSET, SUBSET, DIST_IN_CLOSED_SEGMENT]])

  let SETDIST_SING_FRONTIER ← prove
   r"!s x:real^N. ~(x IN s) ==> setdist({x},frontier s) = setdist({x},s)"
   (MESON_TAC [← SET_RULE (← q r"DISJOINT {x} s <=> ~(x IN s)"), SETDIST_FRONTIER])

  let SETDIST_CLOSEST_POINT ← prove
   r"!a:real^N s.
      closed s /\ ~(s = {}) ==> setdist({a},s) = dist(a,closest_point s a)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SETDIST_UNIQUE THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, IN_SING, UNWIND_THM2] THEN
    EXISTS_TAC (← q r"closest_point s (a:real^N)") THEN
    ASM_MESON_TAC [CLOSEST_POINT_EXISTS, DIST_SYM])

  let SETDIST_EQ_0_SING ← prove
   r"(!s x:real^N. setdist({x},s) = &0 <=> s = {} \/ x IN closure s) /\
   (!s x:real^N. setdist(s,{x}) = &0 <=> s = {} \/ x IN closure s)"
   (SIMP_TAC [SETDIST_EQ_0_BOUNDED, BOUNDED_SING, CLOSURE_SING] THEN SET_TAC [])

  let SETDIST_EQ_0_CLOSED ← prove
   r"!s x. closed s ==> (setdist({x},s) = &0 <=> s = {} \/ x IN s)"
   (SIMP_TAC [SETDIST_EQ_0_COMPACT_CLOSED, COMPACT_SING] THEN SET_TAC [])

  let SETDIST_EQ_0_CLOSED_IN ← prove
   r"!u s x. closed_in (subtopology euclidean u) s /\ x IN u
           ==> (setdist({x},s) = &0 <=> s = {} \/ x IN s)"
   (REWRITE_TAC [SETDIST_EQ_0_SING, CLOSED_IN_INTER_CLOSURE] THEN SET_TAC [])

  let SETDIST_SING_IN_SET ← prove
   r"!x s. x IN s ==> setdist({x},s) = &0"
   (SIMP_TAC [SETDIST_EQ_0_SING, ← REWRITE_RULE [SUBSET] CLOSURE_SUBSET])

  let SETDIST_SING_FRONTIER_CASES ← prove
   r"!s x:real^N.
        setdist({x},s) = if x IN s then &0 else setdist({x},frontier s)"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [SETDIST_SING_IN_SET, SETDIST_SING_FRONTIER])

  let SETDIST_LE_SING ← prove
   r"!s t x:real^N. x IN s ==> setdist(s,t) <= setdist({x},t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SETDIST_SUBSET_LEFT THEN ASM SET_TAC [])

  return { SETDIST_COMPACT_CLOSED, SETDIST_CLOSED_COMPACT, SETDIST_EQ_0_COMPACT_CLOSED,
           SETDIST_EQ_0_CLOSED_COMPACT, SETDIST_EQ_0_BOUNDED, SETDIST_TRANSLATION,
           SETDIST_LINEAR_IMAGE, SETDIST_UNIQUE, SETDIST_UNIV, SETDIST_ZERO,
           SETDIST_ZERO_STRONG, SETDIST_FRONTIERS, SETDIST_SING_FRONTIER, SETDIST_CLOSEST_POINT,
           SETDIST_EQ_0_SING, SETDIST_EQ_0_CLOSED, SETDIST_EQ_0_CLOSED_IN, SETDIST_SING_IN_SET,
           SETDIST_SING_FRONTIER_CASES, SETDIST_LE_SING }

/- ------------------------------------------------------------------------- -/
/- Setdist between balls; open translation preimages.                       -/
/- (topology.ml 24757-24841)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SD4 where
  SETDIST_BALLS : thm
  OPEN_TRANSLATION_SUBSET_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupSD4 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BCLS1 : CLS1)
    (BCBL : CBL) (BBND1 : BND1) (BBLS : BLS) (BLCP : LCP) (BSDS : SDS) (BSD2 : SD2)
    (BSD3 : SD3) : ExceptT String IO SD4 := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_TAC,
        VECTOR_ARITH, NORM_ARITH, .. } := D
  let { DE_MORGAN_THM, EMPTY_SUBSET, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IN_ELIM_THM, .. } := D.core2
  let { REAL_ABS_DIV, REAL_ABS_MUL, .. } := D.core3
  let { REAL_DIV_RMUL, REAL_LE_ANTISYM, REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LE, SUBSET, SUBSET_UNIV, .. } := D.core5
  let { UNIV_GSPEC, real_max, .. } := D.core6
  let { DIST_REFL, DIST_SYM, .. } := D.vec1
  let { NORM_EQ_0, NORM_MUL, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_SUB_EQ, dist, .. } := D.vec4
  let { OPEN_UNIV, .. } := BEUC
  let { OPEN_CLOSED, .. } := BCLO
  let { BALL_EMPTY, IN_BALL, IN_CBALL, OPEN_CONTAINS_BALL, .. } := BBAL
  let { CLOSURE_CLOSED, .. } := BCLS1
  let { CBALL_EMPTY, CBALL_EQ_EMPTY, CBALL_SING, CLOSED_CBALL, CLOSURE_BALL, .. } := BCBL
  let { BOUNDED_CBALL, .. } := BBND1
  let { INTER_BALLS_EQ_EMPTY, .. } := BBLS
  let { COMPACT_TRANSLATION_EQ, .. } := BLCP
  let { REAL_LE_SETDIST, SETDIST_EMPTY, SETDIST_LE_DIST, SETDIST_POS_LT, SETDIST_SINGS, .. } := BSDS
  let { SETDIST_CLOSURE, .. } := BSD2
  let { SETDIST_EQ_0_BOUNDED, SETDIST_EQ_0_COMPACT_CLOSED, .. } := BSD3
  -- @@SCOPE END

  let SETDIST_BALLS ← prove
   r"(!a b:real^N r s.
        setdist(ball(a,r),ball(b,s)) =
        if r <= &0 \/ s <= &0 then &0 else max (&0) (dist(a,b) - (r + s))) /\
   (!a b:real^N r s.
        setdist(ball(a,r),cball(b,s)) =
        if r <= &0 \/ s < &0 then &0 else max (&0) (dist(a,b) - (r + s))) /\
   (!a b:real^N r s.
        setdist(cball(a,r),ball(b,s)) =
        if r < &0 \/ s <= &0 then &0 else max (&0) (dist(a,b) - (r + s))) /\
   (!a b:real^N r s.
        setdist(cball(a,r),cball(b,s)) =
        if r < &0 \/ s < &0 then &0 else max (&0) (dist(a,b) - (r + s)))"
   (REWRITE_TAC [← MESON []
     (← q r"(x = if p then y else z) <=> (p ==> x = y) /\ (~p ==> x = z)")] THEN
    SIMP_TAC [← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)")] THEN
    SIMP_TAC [BALL_EMPTY, CBALL_EMPTY, SETDIST_EMPTY, DE_MORGAN_THM] THEN
    ONCE_REWRITE_TAC [← MESON [SETDIST_CLOSURE]
     (← q r"setdist(s,t) = setdist(closure s,closure t)")] THEN
    SIMP_TAC [REAL_NOT_LE, REAL_NOT_LT, CLOSURE_BALL] THEN
    REWRITE_TAC [SETDIST_CLOSURE] THEN
    MATCH_MP_TAC (← TAUT (← q r"(s ==> p /\ q /\ r) /\ s ==> p /\ q /\ r /\ s")) THEN
    CONJ_TAC THENL [MESON_TAC [REAL_LT_IMP_LE], REPEAT GEN_TAC] THEN
    REWRITE_TAC [real_max, REAL_SUB_LE] THEN COND_CASES_TAC THEN
    SIMP_TAC [SETDIST_EQ_0_BOUNDED, BOUNDED_CBALL, CLOSED_CBALL, CLOSURE_CLOSED,
              CBALL_EQ_EMPTY, INTER_BALLS_EQ_EMPTY]
    THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THENL
     [FIRST_X_ASSUM SUBST_ALL_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [DIST_REFL]) THEN
      ASM_CASES_TAC (← q r"r = &0 /\ s = &0") THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      ASM_SIMP_TAC [CBALL_SING, SETDIST_SINGS] THEN REAL_ARITH_TAC,
      STRIP_TAC] THEN
    REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC REAL_LE_SETDIST THEN
      ASM_REWRITE_TAC [CBALL_EQ_EMPTY, REAL_NOT_LT, IN_CBALL] THEN
      CONV_TAC (fun t => NORM_ARITH t)] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"dist(a + r / dist(a,b) % (b - a):real^N,
                     b - s / dist(a,b) % (b - a))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SETDIST_LE_DIST THEN
      REWRITE_TAC [IN_CBALL, ← NORM_ARITH (← q r"dist(a:real^N,a + x) = norm x"),
                   ← NORM_ARITH (← q r"dist(a:real^N,a - x) = norm x")] THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN
      REWRITE_TAC [dist, NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, VECTOR_SUB_EQ, NORM_EQ_0] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [dist, ← VECTOR_ARITH
       (← q r"(a + d % (b - a)) - (b - e % (b - a)):real^N =
        (&1 - d - e) % (a - b)")] THEN
      REWRITE_TAC [NORM_MUL, ← REAL_ARITH
        (← q r"&1 - r / y - s / y = &1 - (r + s) / y")] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_ABS_NORM] THEN
      REWRITE_TAC [← GSYM REAL_ABS_MUL] THEN REWRITE_TAC [REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [VECTOR_SUB_EQ, NORM_EQ_0, ← REAL_FIELD
       (← q r"~(n = &0) ==> (&1 - x / n) * n = n - x")] THEN
      REWRITE_TAC [← GSYM dist] THEN ASM_REAL_ARITH_TAC])

  let OPEN_TRANSLATION_SUBSET_PREIMAGE ← prove
   r"!s t:real^N->bool.
        compact s /\ open t ==> open {a | IMAGE (\x. a + x) s SUBSET t}"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET, UNIV_GSPEC, OPEN_UNIV] THEN
    ASM_CASES_TAC (← q r"t = (:real^N)") THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, UNIV_GSPEC, OPEN_UNIV] THEN
    REWRITE_TAC [OPEN_CONTAINS_BALL] THEN
    X_GEN_TAC (← q r"a:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"setdist(IMAGE (\x. a + x) s,(:real^N) DIFF t)") THEN
    REWRITE_TAC [SETDIST_POS_LT, SUBSET, IN_BALL, IN_ELIM_THM,
                 FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [SETDIST_EQ_0_COMPACT_CLOSED, COMPACT_TRANSLATION_EQ,
                  ← GSYM OPEN_CLOSED] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON [REAL_NOT_LT]
     (← q r"x < y ==> (~p ==> y <= x) ==> p"))) THEN
    DISCH_TAC THEN
    SUBST1_TAC (← NORM_ARITH (← q r"dist(a:real^N,b) = dist(a + c,b + c)")) THEN
    MATCH_MP_TAC SETDIST_LE_DIST THEN ASM SET_TAC [])

  return { SETDIST_BALLS, OPEN_TRANSLATION_SUBSET_PREIMAGE }

/- ------------------------------------------------------------------------- -/
/- A nice characterization of uniform continuity via setdist.                -/
/- (topology.ml 24842-25023)                                                 -/
/- ------------------------------------------------------------------------- -/

structure UCD where
  UNIFORMLY_CONTINUOUS_ON_SETDIST : thm
  UNIFORMLY_CONTINUOUS_ON_SETDIST_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupUCD [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLIM2 : LIM2) (BARI : ARI) (BBND1 : BND1)
    (BCPT : CPT) (BCPP2 : CPP2) (BCNO : CNO) (BSQC : SQC) (BSDS : SDS) :
    ExceptT String IO UCD := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, ASM_METIS_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        SELECT_CONV, NORM_ARITH, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, DE_MORGAN_THM, EXTENSION, FINITE_IMAGE, FINITE_NUMSEG, .. } :=
    D.core1
  let { FINITE_NUMSEG_LT, FINITE_UNION, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_UNION,
        FUN_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ, IMP_IMP, INFINITE,
        INFINITE_ENUMERATE, IN_ELIM_THM, IN_NUMSEG, .. } := D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LET_TRANS, LE_0, LE_REFL, LE_TRANS, LT_CASES,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_LE, .. } :=
    D.core3
  let { REAL_LET_TRANS, REAL_LE_ANTISYM, REAL_LE_TRANS_LT, REAL_LTE_TRANS, .. } := D.core4
  let { REAL_NOT_LE, REAL_NOT_LT, RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.core5
  let { UNIV_NOT_EMPTY, WF_REC, WF_num, num_INFINITE, o_DEF, o_THM, .. } := D.core6
  let { MONOTONE_BIGGER, REAL_HALF, UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { DIST_SYM, .. } := D.vec1
  let { VECTOR_NEG_SUB, VECTOR_SUB_RZERO, dist, .. } := D.vec4
  let { IN_CBALL_0, .. } := BBAL
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_NULL_NEG, .. } := BARI
  let { FINITE_IMP_BOUNDED, bounded, .. } := BBND1
  let { compact, .. } := BCPT
  let { COMPACT_CBALL, .. } := BCPP2
  let { uniformly_continuous_on, .. } := BCNO
  let { UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY_ALT, .. } := BSQC
  let { REAL_LE_SETDIST, REAL_SETDIST_LT_EXISTS, SETDIST_EMPTY, SETDIST_LE_DIST, SETDIST_POS_LE,
        SETDIST_POS_LT, .. } := BSDS
  -- @@SCOPE END

  let UNIFORMLY_CONTINUOUS_ON_SETDIST ← prove
   r"!f:real^M->real^N s t t'.
        f uniformly_continuous_on s /\
        t SUBSET s /\ t' SUBSET s /\ setdist(t,t') = &0
        ==> setdist(IMAGE f t,IMAGE f t') = &0"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"t:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, SETDIST_EMPTY] THEN
    ASM_CASES_TAC (← q r"t':real^M->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, SETDIST_EMPTY] THEN
    GEN_REWRITE_TAC id [← TAUT (← q r"p <=> ~ ~p")] THEN
    PURE_REWRITE_TAC [← GSYM SETDIST_POS_LT] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [uniformly_continuous_on]) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"setdist(IMAGE (f:real^M->real^N) t,IMAGE f t')")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"t:real^M->bool", ← q r"t':real^M->bool", ← q r"d:real"]
          REAL_SETDIST_LT_EXISTS) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"y:real^M", ← q r"x:real^M"]) THEN
    ASM_REWRITE_TAC [REAL_NOT_LT, NOT_IMP] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC SETDIST_LE_DIST THEN
    ASM_SIMP_TAC [FUN_IN_IMAGE])

  let UNIFORMLY_CONTINUOUS_ON_SETDIST_EQ ← prove
   r"!f:real^M->real^N s.
        f uniformly_continuous_on s <=>
        !t t'. t SUBSET s /\ t' SUBSET s /\ setdist(t,t') = &0
              ==> setdist(IMAGE f t,IMAGE f t') = &0"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [UNIFORMLY_CONTINUOUS_ON_SETDIST], DISCH_TAC] THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY_ALT] THEN
    X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"!P. (!x y. R x y ==> R y x) /\
          (!x y. P x ==> R x y) /\ (!x y. ~P x /\ ~P y ==> R x y)
          ==> !x y. R x y")) THEN
    EXISTS_TAC
     (← q r"\x. ?B. INFINITE {n:num | norm((f:real^M->real^N) (x n)) <= B}") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REPEAT GEN_TAC THEN DISCH_TAC THEN
      ONCE_REWRITE_TAC [← GSYM LIM_NULL_NEG] THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN
      ASM_SIMP_TAC [VECTOR_NEG_SUB],
      ALL_TAC] THEN
    CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:num->real^M", ← q r"y:num->real^M"] THEN
    REWRITE_TAC [NOT_EXISTS_THM, INFINITE, AND_FORALL_THM] THEN
    REWRITE_TAC [← GSYM INFINITE, ← GSYM FINITE_UNION] THEN DISCH_TAC THEN
    STRIP_TAC THEN
    REWRITE_TAC [← GSYM REAL_NOT_LE, ← GSYM NOT_FORALL_THM] THEN DISCH_TAC THENL
     [SUBGOAL_THEN
       (← q r"?l r. (!m n. m < n ==> r m < r n) /\
              ((\n. (f:real^M->real^N) (x((r:num->num) n))) --> l) sequentially")
      (REPEAT_TCL CHOOSE_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THENL
       [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"B:real") (MP_TAC o MATCH_MP
          INFINITE_ENUMERATE)) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE r UNIV = {x | P x} ==> !n. P(r n)"))) THEN
        MP_TAC (← ISPEC (← q r"cball(vec 0:real^N,B)") compact) THEN
        REWRITE_TAC [COMPACT_CBALL, IN_CBALL_0] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^M->real^N) o x o (r:num->num)")) THEN
        ASM_REWRITE_TAC [o_DEF] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:real^N") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"q:num->num") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(r:num->num) o (q:num->num)") THEN
        ASM_SIMP_TAC [o_DEF],
        REWRITE_TAC [LIM_SEQUENTIALLY] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
        ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
        FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"IMAGE ((x:num->real^M) o r) {n:num | N <= n}",
          ← q r"IMAGE ((y:num->real^M) o r) {n:num | N <= n}"]) THEN
        ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, ← GSYM IMAGE_o, o_DEF] THEN
        REWRITE_TAC [NOT_IMP, ← GSYM SETDIST_POS_LT] THEN CONJ_TAC THENL
         [REWRITE_TAC [← GSYM REAL_LE_ANTISYM, SETDIST_POS_LE] THEN
          GEN_REWRITE_TAC id [REAL_LE_TRANS_LT] THEN X_GEN_TAC (← q r"b:real") THEN
          DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"b:real")) THEN ASM_REWRITE_TAC [] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC
           (← q r"(r:num->num) (MAX N n)"))) THEN
          REWRITE_TAC [LE_REFL, dist, VECTOR_SUB_RZERO] THEN ANTS_TAC THENL
           [TRANS_TAC LE_TRANS (← q r"MAX N n") THEN CONJ_TAC THENL
             [ARITH_TAC, ASM_MESON_TAC [MONOTONE_BIGGER]],
            MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS)] THEN
          REWRITE_TAC [← GSYM dist] THEN MATCH_MP_TAC SETDIST_LE_DIST THEN
          GEN_REWRITE_TAC (BINOP_CONV o RAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
          REWRITE_TAC [IMAGE_o] THEN CONJ_TAC THEN
          REPLICATE_TAC 2 (MATCH_MP_TAC FUN_IN_IMAGE) THEN
          REWRITE_TAC [IN_ELIM_THM] THEN ARITH_TAC,
          TRANS_TAC REAL_LTE_TRANS (← q r"e / &2") THEN ASM_REWRITE_TAC [REAL_HALF] THEN
          MATCH_MP_TAC REAL_LE_SETDIST THEN
          REWRITE_TAC [IMAGE_EQ_EMPTY, CONJ_ASSOC] THEN
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
          CONJ_TAC THENL [MESON_TAC [LE_REFL], ALL_TAC] THEN
          REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
          REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
          X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"!xn l. dist(xm,l) < e / &4 /\ dist(xn,l) < e / &4 /\
                   e <= dist(xn,yn)
                   ==> e / &2 <= dist(xm:real^N,yn)")) THEN
          EXISTS_TAC (← q r"(f:real^M->real^N)(x((r:num->num) n))") THEN
          EXISTS_TAC (← q r"l:real^N") THEN ASM_SIMP_TAC []]],
      MP_TAC (← ISPEC (← q r"\(r:num->num) n.
                  @m. !k. k < n
                          ==> (r:num->num) k < m /\
                              e <= dist(f(y(r k)),f(x m)) /\
                              e <= dist((f:real^M->real^N)(x(r k)),f(y m))")
          (← MATCH_MP WF_REC WF_num)) THEN
      REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL [SIMP_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") (LABEL_TAC "*")) THEN
      SUBGOAL_THEN
        (← q r"!n k. k < n
                 ==> (r:num->num) k < r n /\
                     e <= dist(f(y(r k)),f(x (r n))) /\
                     e <= dist((f:real^M->real^N)(x(r k)),f(y (r n)))")
      ASSUME_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN
        REMOVE_THEN "*" (SUBST1_TAC o SPEC (← q r"n:num")) THEN
        CONV_TAC SELECT_CONV THEN
        SUBGOAL_THEN
         (← q r"bounded
             (IMAGE ((f:real^M->real^N) o x o (r:num->num)) {k | k < n} UNION
              IMAGE ((f:real^M->real^N) o y o (r:num->num)) {k | k < n})")
        MP_TAC THENL
         [MATCH_MP_TAC FINITE_IMP_BOUNDED THEN REWRITE_TAC [FINITE_UNION] THEN
          SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT],
          REWRITE_TAC [bounded, FORALL_IN_UNION, FORALL_IN_IMAGE] THEN
          REWRITE_TAC [FORALL_IN_GSPEC, o_THM, LEFT_IMP_EXISTS_THM]] THEN
        X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"B + e:real")) THEN
        SUBGOAL_THEN (← q r"FINITE(IMAGE (r:num->num) {k | k < n})") MP_TAC THENL
         [SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT], ALL_TAC] THEN
        DISCH_THEN (MP_TAC o ISPEC (← q r"\n:num. n") o
         MATCH_MP UPPER_BOUND_FINITE_SET) THEN
        REWRITE_TAC [FORALL_IN_IMAGE, LEFT_IMP_EXISTS_THM, FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
        MP_TAC (← SPECL [← q r"0", ← q r"m:num"] FINITE_NUMSEG) THEN
        REWRITE_TAC [IMP_IMP, ← GSYM FINITE_UNION] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← MESON [INFINITE, num_INFINITE]
         (← q r"FINITE s ==> ~(s = (:num))"))) THEN
        REWRITE_TAC [EXTENSION, IN_UNION, IN_UNIV, NOT_FORALL_THM] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"p:num") THEN
        REWRITE_TAC [IN_NUMSEG, DE_MORGAN_THM, IN_ELIM_THM, LE_0] THEN
        REWRITE_TAC [REAL_NOT_LE, NOT_LE] THEN ASM_MESON_TAC [LET_TRANS,
         ← NORM_ARITH (← q r"norm x <= B /\ B + e < norm y ==> e <= dist(x:real^N,y)")],
        REMOVE_THEN "*" (K ALL_TAC : thm → tactic)] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"IMAGE ((x:num->real^M) o r) (:num)",
        ← q r"IMAGE ((y:num->real^M) o r) (:num)"]) THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, ← GSYM IMAGE_o, o_DEF] THEN
      REWRITE_TAC [NOT_IMP, ← GSYM SETDIST_POS_LT] THEN CONJ_TAC THENL
       [REWRITE_TAC [← GSYM REAL_LE_ANTISYM, SETDIST_POS_LE] THEN
        GEN_REWRITE_TAC id [REAL_LE_TRANS_LT] THEN X_GEN_TAC (← q r"b:real") THEN
        DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"b:real")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC
         (← q r"(r:num->num) (MAX N n)"))) THEN
        REWRITE_TAC [LE_REFL, dist, VECTOR_SUB_RZERO] THEN ANTS_TAC THENL
         [TRANS_TAC LE_TRANS (← q r"MAX N n") THEN CONJ_TAC THENL
           [ARITH_TAC, ASM_MESON_TAC [MONOTONE_BIGGER]],
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS)] THEN
        REWRITE_TAC [← GSYM dist] THEN MATCH_MP_TAC SETDIST_LE_DIST THEN
        GEN_REWRITE_TAC (BINOP_CONV o RAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        REWRITE_TAC [IMAGE_o] THEN SET_TAC [],
        TRANS_TAC REAL_LTE_TRANS (← q r"e:real") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_LE_SETDIST THEN
        REWRITE_TAC [IMAGE_EQ_EMPTY, CONJ_ASSOC, UNIV_NOT_EMPTY] THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
        REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN
        ASM_METIS_TAC [LT_CASES, DIST_SYM]]])

  return { UNIFORMLY_CONTINUOUS_ON_SETDIST, UNIFORMLY_CONTINUOUS_ON_SETDIST_EQ }

/- ------------------------------------------------------------------------- -/
/- Use set distance for an easy proof of separation properties etc.          -/
/- (topology.ml 25024-25091)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SPA where
  OPEN_IN_SEPARATED_UNION : thm
  CLOSED_IN_SEPARATED_UNION : thm
  COMPACT_IN_SEPARATED_UNION : thm
  CONNECTED_IMP_NONSEPARATED_UNION : thm
  deriving Inhabited

@[nospecialize]
def setupSPA [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BCON : CON)
    (BCPT : CPT) (BARC : ARC) (BSDS : SDS) (BSD3 : SD3) : ExceptT String IO SPA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, NORM_ARITH, .. } := D
  let { CONJ_SYM, CONTRAPOS_THM, EQ_IMP, .. } := D.core1
  let { FORALL_IN_GSPEC, IN_ELIM_THM, .. } := D.core2
  let { MONO_AND, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_UNION, .. } := D.core5
  let { SWAP_EXISTS_THM, UNION_COMM, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { VECTOR_ADD_RID, .. } := D.vec4
  let { closed_in, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CENTRE_IN_BALL, IN_BALL_0, OPEN_BALL, .. } := BBAL
  let { OPEN_IN_OPEN, .. } := BLOC
  let { CONNECTED_CLOSED_IN, .. } := BCON
  let { CLOSED_IN_COMPACT, .. } := BCPT
  let { OPEN_SUMS, .. } := BARC
  let { SETDIST_EMPTY, SETDIST_LE_DIST, SETDIST_POS_LT, SETDIST_SYM, .. } := BSDS
  let { SETDIST_ZERO, .. } := BSD3
  -- @@SCOPE END

  let OPEN_IN_SEPARATED_UNION ← prove
   r"!s t:real^N->bool.
        &0 < setdist(s,t)
        ==> open_in (subtopology euclidean (s UNION t)) s /\
            open_in (subtopology euclidean (s UNION t)) t"
   (MATCH_MP_TAC (← MESON []
     (← q r"(!s t. P s t ==> P t s) /\ (!s t. Q t s ==> R s t) /\
      (!s t. P s t ==> Q s t)
      ==> !s t. P s t ==> Q s t /\ R s t")) THEN
    CONJ_TAC THENL [REWRITE_TAC [SETDIST_SYM], ALL_TAC] THEN
    CONJ_TAC THENL [REWRITE_TAC [UNION_COMM], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [OPEN_IN_OPEN] THEN EXISTS_TAC
     (← q r"{x + y:real^N | x IN s /\ y IN ball(vec 0,setdist(s,t))}") THEN
    SIMP_TAC [OPEN_SUMS, OPEN_BALL] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_UNION] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN EXISTS_TAC (← q r"vec 0:real^N") THEN
      ASM_REWRITE_TAC [CENTRE_IN_BALL, REAL_HALF, VECTOR_ADD_RID] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC (← SET_RULE (← q r"DISJOINT t u ==> (s UNION t) INTER u SUBSET s")) THEN
      REWRITE_TAC [← SET_RULE (← q r"DISJOINT s t <=> !x. x IN t ==> ~(x IN s)")] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_BALL_0] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool",
                        ← q r"x:real^N", ← q r"x + y:real^N"] SETDIST_LE_DIST) THEN
      ASM_SIMP_TAC [← NORM_ARITH (← q r"~(p <= dist(x:real^N,x + y)) <=> norm y < p")]])

  let CLOSED_IN_SEPARATED_UNION ← prove
   r"!s t:real^N->bool.
        &0 < setdist(s,t)
        ==> closed_in (subtopology euclidean (s UNION t)) s /\
            closed_in (subtopology euclidean (s UNION t)) t"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    REWRITE_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_UNION] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SEPARATED_UNION) THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [SETDIST_POS_LT]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM]
          SETDIST_ZERO)) THEN
    SET_TAC [])

  let COMPACT_IN_SEPARATED_UNION ← prove
   r"!s t:real^N->bool.
        compact(s UNION t) /\ &0 < setdist(s,t) ==> compact s /\ compact t"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SEPARATED_UNION) THEN
    ASM_MESON_TAC [CLOSED_IN_COMPACT])

  let CONNECTED_IMP_NONSEPARATED_UNION ← prove
   r"!s t:real^N->bool. connected(s UNION t) ==> setdist(s,t) = &0"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN ASM_REWRITE_TAC [SETDIST_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN ASM_REWRITE_TAC [SETDIST_EMPTY] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM]
          SETDIST_ZERO)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM SETDIST_POS_LT]) THEN
    REWRITE_TAC [CONNECTED_CLOSED_IN] THEN
    MAP_EVERY EXISTS_TAC [← q r"s:real^N->bool", ← q r"t:real^N->bool"] THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o MATCH_MP CLOSED_IN_SEPARATED_UNION) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  return { OPEN_IN_SEPARATED_UNION, CLOSED_IN_SEPARATED_UNION, COMPACT_IN_SEPARATED_UNION,
           CONNECTED_IMP_NONSEPARATED_UNION }

/- ------------------------------------------------------------------------- -/
/- Separation properties.  (topology.ml 25092-25209)                         -/
/- ------------------------------------------------------------------------- -/

structure SPB where
  SEPARATION_CLOSURES : thm
  SEPARATION_NORMAL : thm
  SEPARATION_NORMAL_LOCAL_CLOSURES : thm
  SEPARATION_NORMAL_LOCAL : thm
  SEPARATION_NORMAL_CLOSURES : thm
  SEPARATION_NORMAL_COMPACT : thm
  SEPARATION_HAUSDORFF : thm
  SEPARATION_T2 : thm
  SEPARATION_T1 : thm
  SEPARATION_T0 : thm
  deriving Inhabited

@[nospecialize]
def setupSPB [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BCLS1 : CLS1)
    (BBND1 : BND1) (BBND2 : BND2) (BCPT : CPT) : ExceptT String IO SPB := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DISJOINT, EXTENSION, .. } := D.core1
  let { IN_INTER, .. } := D.core2
  let { IN_UNIV, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core3
  let { SUBSET_INTER, SUBSET_UNIV, .. } := D.core5
  let { CLOSURE_OF_SUBTOPOLOGY, .. } := D.met1
  let { METRIZABLE_IMP_NORMAL_SPACE, METRIZABLE_SPACE_SEPARATION, METRIZABLE_SPACE_SUBTOPOLOGY,
        NORMAL_SPACE_DISJOINT_CLOSURES, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, hausdorff_space, separated_in, .. } := D.met3
  let { HAUSDORFF_SPACE_EUCLIDEAN, METRIZABLE_SPACE_EUCLIDEAN, OPEN_IN, TOPSPACE_EUCLIDEAN, .. } :=
    BEUC
  let { CLOSED_IN, CLOSED_UNION, OPEN_CLOSED, .. } := BCLO
  let { OPEN_BALL, .. } := BBAL
  let { CLOSED_CLOSURE, CLOSURE_CLOSED, CLOSURE_SUBSET, EUCLIDEAN_CLOSURE_OF, .. } := BCLS1
  let { BOUNDED_BALL, BOUNDED_CLOSURE, BOUNDED_SUBSET, .. } := BBND1
  let { BOUNDED_SUBSET_BALL, .. } := BBND2
  let { COMPACT_EQ_BOUNDED_CLOSED, .. } := BCPT
  -- @@SCOPE END

  let SEPARATION_CLOSURES ← prove
   r"!s t:real^N->bool.
        s INTER closure(t) = {} /\ t INTER closure(s) = {}
        ==> ?u v. DISJOINT u v /\ open u /\ open v /\
                  s SUBSET u /\ t SUBSET v"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [OPEN_IN] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s /\ t <=> q /\ r /\ s /\ t /\ p")] THEN
    MATCH_MP_TAC METRIZABLE_SPACE_SEPARATION THEN
    REWRITE_TAC [METRIZABLE_SPACE_EUCLIDEAN, separated_in] THEN
    ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV, EUCLIDEAN_CLOSURE_OF])

  let SEPARATION_NORMAL ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\ s INTER t = {}
        ==> ?u v. open u /\ open v /\
                  s SUBSET u /\ t SUBSET v /\ u INTER v = {}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM DISJOINT] THEN
    ONCE_REWRITE_TAC [← TAUT
      (← q r"a /\ b /\ c /\ d /\ e <=> e /\ a /\ b /\ c /\ d")] THEN
    MATCH_MP_TAC SEPARATION_CLOSURES THEN
    ASM_SIMP_TAC [CLOSURE_CLOSED] THEN ASM SET_TAC [])

  let SEPARATION_NORMAL_LOCAL_CLOSURES ← prove
   r"!s t u:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        DISJOINT s t
        ==> ?s' t'. open_in (subtopology euclidean u) s' /\
                    open_in (subtopology euclidean u) t' /\
                    s SUBSET s' /\ t SUBSET t' /\ DISJOINT s' t' /\
                    DISJOINT (subtopology euclidean u closure_of s')
                             (subtopology euclidean u closure_of t')"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"normal_space(subtopology euclidean (u:real^N->bool))")
    MP_TAC THENL
     [SIMP_TAC [METRIZABLE_IMP_NORMAL_SPACE, METRIZABLE_SPACE_EUCLIDEAN,
                METRIZABLE_SPACE_SUBTOPOLOGY],
      REWRITE_TAC [NORMAL_SPACE_DISJOINT_CLOSURES]] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"s':real^N->bool") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t':real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← SET_RULE (← q r"DISJOINT s t
                ==> s' SUBSET s /\ t' SUBSET t ==> DISJOINT s' t'"))) THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBTOPOLOGY, SUBSET_INTER, CLOSURE_SUBSET,
                  EUCLIDEAN_CLOSURE_OF, ← ISPEC (← q r"euclidean") OPEN_IN_IMP_SUBSET,
                  ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")])

  let SEPARATION_NORMAL_LOCAL ← prove
   r"!s t u:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        s INTER t = {}
        ==> ?s' t'. open_in (subtopology euclidean u) s' /\
                    open_in (subtopology euclidean u) t' /\
                    s SUBSET s' /\ t SUBSET t' /\ s' INTER t' = {}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM DISJOINT] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SEPARATION_NORMAL_LOCAL_CLOSURES) THEN
    MESON_TAC [])

  let SEPARATION_NORMAL_CLOSURES ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\ DISJOINT s t
        ==> ?s' t'. open s' /\ open t' /\
                    s SUBSET s' /\ t SUBSET t' /\ DISJOINT s' t' /\
                    DISJOINT (closure s') (closure t')"
   (REWRITE_TAC [CLOSED_IN, OPEN_IN, ← GSYM EUCLIDEAN_CLOSURE_OF] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [SEPARATION_NORMAL_LOCAL_CLOSURES])

  let SEPARATION_NORMAL_COMPACT ← prove
   r"!s t:real^N->bool.
        compact s /\ closed t /\ s INTER t = {}
        ==> ?u v. open u /\ compact(closure u) /\ open v /\
                  s SUBSET u /\ t SUBSET v /\ u INTER v = {}"
   (REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_CLOSURE] THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM
     (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP BOUNDED_SUBSET_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool",
                      ← q r"t UNION ((:real^N) DIFF ball(vec 0,r))"]
          SEPARATION_NORMAL) THEN
    ASM_SIMP_TAC [CLOSED_UNION, ← GSYM OPEN_CLOSED, OPEN_BALL] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [MATCH_MP_TAC BOUNDED_CLOSURE, ASM SET_TAC []] THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN EXISTS_TAC (← q r"ball(vec 0:real^N,r)") THEN
    REWRITE_TAC [BOUNDED_BALL] THEN ASM SET_TAC [])

  let SEPARATION_HAUSDORFF ← prove
   r"!x:real^N y.
      ~(x = y)
      ==> ?u v. open u /\ open v /\ x IN u /\ y IN v /\ (u INTER v = {})"
   (MATCH_ACCEPT_TAC (← REWRITE_RULE
     [← GSYM OPEN_IN, hausdorff_space, TOPSPACE_EUCLIDEAN, IN_UNIV, DISJOINT]
       HAUSDORFF_SPACE_EUCLIDEAN))

  let SEPARATION_T2 ← prove
   r"!x:real^N y.
        ~(x = y) <=> ?u v. open u /\ open v /\ x IN u /\ y IN v /\
                           (u INTER v = {})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [SEPARATION_HAUSDORFF] THEN
    REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN MESON_TAC [])

  let SEPARATION_T1 ← prove
   r"!x:real^N y.
        ~(x = y) <=> ?u v. open u /\ open v /\ x IN u /\ ~(y IN u) /\
                           ~(x IN v) /\ y IN v"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_SIMP_TAC [SEPARATION_T2, EXTENSION, NOT_IN_EMPTY, IN_INTER],
      ALL_TAC] THEN MESON_TAC [])

  let SEPARATION_T0 ← prove
   r"!x:real^N y. ~(x = y) <=> ?u. open u /\ ~(x IN u <=> y IN u)"
   (MESON_TAC [SEPARATION_T1])

  return { SEPARATION_CLOSURES, SEPARATION_NORMAL, SEPARATION_NORMAL_LOCAL_CLOSURES,
           SEPARATION_NORMAL_LOCAL, SEPARATION_NORMAL_CLOSURES, SEPARATION_NORMAL_COMPACT,
           SEPARATION_HAUSDORFF, SEPARATION_T2, SEPARATION_T1, SEPARATION_T0 }

/- ------------------------------------------------------------------------- -/
/- Closed sets as level sets; connectedness of the intersection of a chain.  -/
/- (topology.ml 25210-25305)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CLV where
  CLOSED_IN_EQ_CONTINUOUS_LEVELSET : thm
  CLOSED_EQ_CONTINUOUS_LEVELSET : thm
  CONNECTED : thm
  CONNECTED_CHAIN : thm
  CONNECTED_CHAIN_GEN : thm
  CONNECTED_NEST : thm
  CONNECTED_NEST_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupCLV [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BCON : CON)
    (BLPT : LPT) (BCLS1 : CLS1) (BCLS2 : CLS2) (BCPT : CPT) (BCMS : CMS) (BCLC : CLC)
    (BSMI : SMI) (BSD2 : SD2) (BSD3 : SD3) (BSPB : SPB) : ExceptT String IO CLV := do
  -- @@SCOPE BEGIN
  let { SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D
  let { CONTRAPOS_THM, DIMINDEX_GE_1, .. } := D.core1
  let { INTERS_0, IN_SING, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, .. } := D.core3
  let { o_DEF, .. } := D.core6
  let { BASIS_NONZERO, .. } := D.vec1
  let { VECTOR_MUL_EQ_0, .. } := D.vec4
  let { CONNECTED_IN_CHAIN, CONNECTED_IN_CHAIN_GEN, CONNECTED_IN_NEST, CONNECTED_IN_NEST_GEN, .. } :=
    D.met1
  let { SUBTOPOLOGY_UNIV, .. } := D.met3
  let { HAUSDORFF_SPACE_EUCLIDEAN, .. } := BEUC
  let { CLOSED_IN, CLOSED_IN_EUCLIDEAN, .. } := BCLO
  let { CLOSED_IN_CLOSED, .. } := BLOC
  let { CONNECTED_IN_EUCLIDEAN, CONNECTED_UNIV, connected, .. } := BCON
  let { CLOSED_SING, .. } := BLPT
  let { CLOSURE_CLOSED, .. } := BCLS1
  let { CONNECTED_SEPARATION, .. } := BCLS2
  let { COMPACT_IN_EUCLIDEAN, .. } := BCPT
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, .. } := BCLC
  let { CONTINUOUS_ON_MUL, .. } := BSMI
  let { CONTINUOUS_ON_LIFT_SETDIST, .. } := BSD2
  let { SETDIST_EQ_0_SING, .. } := BSD3
  let { SEPARATION_CLOSURES, .. } := BSPB
  -- @@SCOPE END

  let CLOSED_IN_EQ_CONTINUOUS_LEVELSET ← prove
   r"!u s a.
        closed_in (subtopology euclidean u) s <=>
        ?f:real^M->real^N. f continuous_on u /\ {x | x IN u /\ f x = a} = s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CLOSED_IN_CLOSED]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC) THEN
      ASM_CASES_TAC (← q r"t:real^M->bool = {}") THENL
       [EXISTS_TAC (← q r"(\x. a + basis 1):real^M->real^N") THEN
        REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a <=> x = vec 0")] THEN
        ASM_SIMP_TAC [BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"(\x. a + setdist({x},t) % basis 1):real^M->real^N") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
        REWRITE_TAC [o_DEF, CONTINUOUS_ON_CONST, CONTINUOUS_ON_LIFT_SETDIST],
        REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a <=> x = vec 0")] THEN
        REWRITE_TAC [VECTOR_MUL_EQ_0, SETDIST_EQ_0_SING] THEN
        ASM_SIMP_TAC [CLOSURE_CLOSED, BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
        SET_TAC []],
      EXPAND_TAC "s" THEN REWRITE_TAC [← GSYM IN_SING] THEN
      MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
      ASM_REWRITE_TAC [CLOSED_SING]])

  let CLOSED_EQ_CONTINUOUS_LEVELSET ← prove
   r"!s a.
        closed s <=>
        ?f:real^M->real^N. f continuous_on (:real^M) /\ {x | f x = a} = s"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"{x | P x} = {x | x IN UNIV /\ P x}")] THEN
    REWRITE_TAC [← GSYM CLOSED_IN_EQ_CONTINUOUS_LEVELSET] THEN
    REWRITE_TAC [← GSYM CLOSED_IN, SUBTOPOLOGY_UNIV])

  let CONNECTED ← prove
   r"!s:real^N->bool.
      connected s <=>
      ~(?e1 e2. open e1 /\ open e2 /\ s SUBSET (e1 UNION e2) /\
                e1 INTER e2 = {} /\ ~(e1 INTER s = {}) /\ ~(e2 INTER s = {}))"
   (GEN_TAC THEN EQ_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THENL
     [REWRITE_TAC [connected] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN SET_TAC [],
      REWRITE_TAC [CONNECTED_SEPARATION, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"c1:real^N->bool", ← q r"c2:real^N->bool"] THEN
      STRIP_TAC THEN MP_TAC
       (← ISPECL [← q r"c1:real^N->bool", ← q r"c2:real^N->bool"] SEPARATION_CLOSURES) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN ASM SET_TAC []])

  let CONNECTED_CHAIN ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> compact s /\ connected s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> connected(INTERS f)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THENL
     [ASM_REWRITE_TAC [INTERS_0, CONNECTED_UNIV], ALL_TAC] THEN
    STRIP_TAC THEN REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN] THEN
    MATCH_MP_TAC CONNECTED_IN_CHAIN THEN
    ASM_REWRITE_TAC [HAUSDORFF_SPACE_EUCLIDEAN, COMPACT_IN_EUCLIDEAN,
                     CONNECTED_IN_EUCLIDEAN])

  let CONNECTED_CHAIN_GEN ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> closed s /\ connected s) /\
        (?s. s IN f /\ compact s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> connected(INTERS f)"
   (GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN] THEN
    MATCH_MP_TAC CONNECTED_IN_CHAIN_GEN THEN
    ASM_REWRITE_TAC [HAUSDORFF_SPACE_EUCLIDEAN, COMPACT_IN_EUCLIDEAN,
                     CONNECTED_IN_EUCLIDEAN, CLOSED_IN_EUCLIDEAN])

  let CONNECTED_NEST ← prove
   r"!s. (!n. compact(s n) /\ connected(s n)) /\
       (!m n. m <= n ==> s n SUBSET s m)
       ==> connected(INTERS {(s:num->real^N->bool) n | n IN (:num)})"
   (GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN] THEN
    MATCH_MP_TAC CONNECTED_IN_NEST THEN
    ASM_REWRITE_TAC [HAUSDORFF_SPACE_EUCLIDEAN, COMPACT_IN_EUCLIDEAN,
                     CONNECTED_IN_EUCLIDEAN])

  let CONNECTED_NEST_GEN ← prove
   r"!s. (!n. closed(s n) /\ connected(s n)) /\ (?n. compact(s n)) /\
       (!m n. m <= n ==> s n SUBSET s m)
       ==> connected(INTERS {(s:num->real^N->bool) n | n IN (:num)})"
   (GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN] THEN
    MATCH_MP_TAC CONNECTED_IN_NEST_GEN THEN
    ASM_REWRITE_TAC [HAUSDORFF_SPACE_EUCLIDEAN, COMPACT_IN_EUCLIDEAN,
                     CONNECTED_IN_EUCLIDEAN, CLOSED_IN_EUCLIDEAN])

  return { CLOSED_IN_EQ_CONTINUOUS_LEVELSET, CLOSED_EQ_CONTINUOUS_LEVELSET, CONNECTED,
           CONNECTED_CHAIN, CONNECTED_CHAIN_GEN, CONNECTED_NEST, CONNECTED_NEST_GEN }

/- ------------------------------------------------------------------------- -/
/- Hausdorff distance between sets.  (topology.ml 25306-25480)               -/
/- ------------------------------------------------------------------------- -/

structure HDA where
  hausdist : thm
  HAUSDIST_POS_LE : thm
  HAUSDIST_POS_LT : thm
  REAL_ABS_HAUSDIST : thm
  HAUSDIST_REFL : thm
  HAUSDIST_SYM : thm
  HAUSDIST_EMPTY : thm
  HAUSDIST_SINGS : thm
  HAUSDIST_SCALING : thm
  HAUSDIST_EQ : thm
  HAUSDIST_TRANSLATION : thm
  HAUSDIST_LINEAR_IMAGE : thm
  HAUSDIST_CLOSURE : thm
  deriving Inhabited

@[nospecialize]
def setupHDA [HolBase] (D : TopologyDeps) (BCLO : CLO) (BIDC : IDC) (BCLC : CLC) (BHSP : HSP)
    (BECF : ECF) (BSDS : SDS) (BSD2 : SD2) (BSD3 : SD3) : ExceptT String IO HDA := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, let_CONV, add_linear_invariants, add_scaling_theorems,
        add_translation_invariants, .. } := D
  let { COND_ID, COND_RAND, DE_MORGAN_THM, EMPTY_GSPEC, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_UNION, FORALL_UNWIND_THM2, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, IN_SING, .. } := D.core2
  let { LET_DEF, LET_END_DEF, MEMBER_NOT_EMPTY, NOT_FORALL_THM, NOT_INSERT_EMPTY, NOT_IN_EMPTY,
        REAL_ABS_NZ, REAL_ABS_POS, .. } := D.core3
  let { REAL_LE_ANTISYM, REAL_LE_LMUL, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_SUP, REAL_LT_LE, .. } :=
    D.core4
  let { REAL_MUL_RZERO, REAL_MUL_SYM, REAL_SUP_LE, REAL_SUP_LE_EQ, RIGHT_EXISTS_AND_THM, .. } :=
    D.core5
  let { SUP_EQ, SUP_SING, SUP_UNIQUE, SWAP_EXISTS_THM, UNION_COMM, UNION_EMPTY, UNION_IDEMPOT,
        real_abs, .. } := D.core6
  let { DIST_SYM, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { VECTOR_MUL_LZERO, drop, .. } := D.vec4
  let { CLOSED_EMPTY, CLOSED_UNIV, .. } := BCLO
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { CONTINUOUS_CLOSED_PREIMAGE, .. } := BCLC
  let { CLOSED_HALFSPACE_COMPONENT_LE, .. } := BHSP
  let { FORALL_IN_CLOSURE_EQ, .. } := BECF
  let { SETDIST_EMPTY, SETDIST_POS_LE, SETDIST_SCALING, SETDIST_SINGS, .. } := BSDS
  let { CONTINUOUS_ON_LIFT_SETDIST, SETDIST_CLOSURE, .. } := BSD2
  let { SETDIST_LINEAR_IMAGE, SETDIST_SING_IN_SET, SETDIST_TRANSLATION, .. } := BSD3
  -- @@SCOPE END

  let hausdist ← new_definition
   r"hausdist(s:real^N->bool,t:real^N->bool) =
        let ds = {setdist({x},t) | x IN s} UNION {setdist({y},s) | y IN t} in
        if ~(ds = {}) /\ (?b. !d. d IN ds ==> d <= b) then sup ds
        else &0"

  let HAUSDIST_POS_LE ← prove
   r"!s t:real^N->bool. &0 <= hausdist(s,t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [hausdist, LET_DEF, LET_END_DEF] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, FORALL_IN_UNION] THEN
    COND_CASES_TAC THEN REWRITE_TAC [REAL_LE_REFL] THEN
    MATCH_MP_TAC REAL_LE_SUP THEN
    ASM_REWRITE_TAC [FORALL_IN_GSPEC, FORALL_IN_UNION, SETDIST_POS_LE] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"~(s = {}) /\ (!x. x IN s ==> P x) ==> ?y. y IN s /\ P y")) THEN
    ASM_REWRITE_TAC [FORALL_IN_GSPEC, FORALL_IN_UNION, SETDIST_POS_LE])

  let HAUSDIST_POS_LT ← prove
   r"!s t:real^N->bool. &0 < hausdist(s,t) <=> ~(hausdist(s,t) = &0)"
   (REWRITE_TAC [REAL_LT_LE, HAUSDIST_POS_LE] THEN REAL_ARITH_TAC)

  let REAL_ABS_HAUSDIST ← prove
   r"!s t:real^N->bool. abs(hausdist(s,t)) = hausdist(s,t)"
   (REWRITE_TAC [real_abs, HAUSDIST_POS_LE])

  let HAUSDIST_REFL ← prove
   r"!s:real^N->bool. hausdist(s,s) = &0"
   (GEN_TAC THEN REWRITE_TAC [← GSYM REAL_LE_ANTISYM, HAUSDIST_POS_LE] THEN
    REWRITE_TAC [hausdist, LET_DEF, LET_END_DEF] THEN
    COND_CASES_TAC THEN REWRITE_TAC [REAL_LE_REFL] THEN
    MATCH_MP_TAC REAL_SUP_LE THEN
    REWRITE_TAC [FORALL_IN_GSPEC, FORALL_IN_UNION] THEN
    ASM_SIMP_TAC [SETDIST_SING_IN_SET, REAL_LE_REFL])

  let HAUSDIST_SYM ← prove
   r"!s t:real^N->bool. hausdist(s,t) = hausdist(t,s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [hausdist, LET_DEF, LET_END_DEF] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [UNION_COMM] THEN
    REWRITE_TAC [])

  let HAUSDIST_EMPTY ← prove
   r"(!t:real^N->bool. hausdist ({},t) = &0) /\
   (!s:real^N->bool. hausdist (s,{}) = &0)"
   (REWRITE_TAC [hausdist, LET_DEF, LET_END_DEF, SETDIST_EMPTY] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x | x IN {}} = {}"), UNION_EMPTY] THEN
    REWRITE_TAC [← SET_RULE (← q r"{c |x| x IN s} = {} <=> s = {}")] THEN
    X_GEN_TAC (← q r"s:real^N->bool") THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"~(s = {}) ==> {c |x| x IN s} = {c}")] THEN
    REWRITE_TAC [SUP_SING, COND_ID])

  let HAUSDIST_SINGS ← prove
   r"!x y:real^N. hausdist({x},{y}) = dist(x,y)"
   (REWRITE_TAC [hausdist, LET_DEF, LET_END_DEF, SETDIST_SINGS] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x | x IN {a}} = {f a}")] THEN
    REWRITE_TAC [DIST_SYM, UNION_IDEMPOT, SUP_SING, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [IN_SING, FORALL_UNWIND_THM2] THEN
    MESON_TAC [REAL_LE_REFL])

  let HAUSDIST_SCALING ← prove
   r"!a s t:real^N->bool.
        hausdist(IMAGE (\x. a % x) s,IMAGE (\x. a % x) t) =
        abs a * hausdist(s,t)"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"s:real^N->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [REAL_MUL_RZERO, HAUSDIST_EMPTY, IMAGE_CLAUSES] THEN
    ASM_CASES_TAC (← q r"a = &0") THENL
     [ASM_SIMP_TAC [VECTOR_MUL_LZERO, HAUSDIST_REFL, ← SET_RULE
       (← q r"~(s = {}) ==> IMAGE (\x. a) s = {a}")] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [hausdist, ← SET_RULE
     (← q r"{f x | x IN IMAGE g s} = {f(g x) | x IN s}")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{a % x} = IMAGE (\x:real^N. a % x) {x}")] THEN
    REWRITE_TAC [SETDIST_SCALING, ← SET_RULE
     (← q r"{(c:real) * f x t | x IN s} UNION {c * f x s | x IN t} =
      IMAGE (\x. c * x) ({f x t | x IN s} UNION {f x s | x IN t})")] THEN
    ABBREV_TAC (← q r"ds = {setdist({y:real^N},t) | y IN s} UNION
                     {setdist ({y},s) | y IN t}") THEN
    CONV_TAC (ONCE_DEPTH_CONV let_CONV) THEN
    ASM_CASES_TAC (← q r"ds:real->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, REAL_MUL_RZERO, FORALL_IN_IMAGE] THEN
    GEN_REWRITE_TAC RAND_CONV [COND_RAND] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"y = b /\ (p <=> q) /\ (p /\ q ==> x = a)
      ==> (if p then x else y) = (if q then a else b)")) THEN
    REWRITE_TAC [REAL_MUL_RZERO] THEN CONJ_TAC THENL
     [EQ_TAC THEN DISCH_THEN (X_CHOOSE_TAC (← q r"b:real")) THENL
       [EXISTS_TAC (← q r"b / abs a"), EXISTS_TAC (← q r"abs a * b")] THEN
      ASM_SIMP_TAC [REAL_LE_LMUL, REAL_ABS_POS] THEN
      ASM_SIMP_TAC [REAL_LE_RDIV_EQ, ← GSYM REAL_ABS_NZ] THEN
      ASM_MESON_TAC [REAL_MUL_SYM],
      DISCH_TAC THEN MATCH_MP_TAC SUP_UNIQUE THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, ← GSYM REAL_ABS_NZ] THEN
      X_GEN_TAC (← q r"c:real") THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC REAL_SUP_LE_EQ THEN ASM_REWRITE_TAC []])

  -- let th = prove (...) in add_scaling_theorems [th];;
  do
    let th ← prove
     r"!c. &0 < c
         ==> !s t. hausdist(IMAGE (\x. c % x) s,IMAGE (\x. c % x) t) =
                   c * hausdist(s,t)"
     (SIMP_TAC [HAUSDIST_SCALING, ← REAL_ARITH (← q r"&0 < c ==> abs c = c")])
    add_scaling_theorems [th]

  let HAUSDIST_EQ ← prove
   r"!s t:real^M->bool s' t':real^N->bool.
        (!b. (!x. x IN s ==> setdist({x},t) <= b) /\
             (!y. y IN t ==> setdist({y},s) <= b) <=>
             (!x. x IN s' ==> setdist({x},t') <= b) /\
             (!y. y IN t' ==> setdist({y},s') <= b))
        ==> hausdist(s,t) = hausdist(s',t')"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [hausdist, LET_DEF, LET_END_DEF] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(p <=> p') /\ s = s'
      ==> (if p then s else &0) = (if p' then s' else &0)")) THEN
    CONJ_TAC THENL
     [BINOP_TAC THENL
       [PURE_REWRITE_TAC [← SET_RULE (← q r"s = {} <=> !x. x IN s ==> F")],
        AP_TERM_TAC THEN ABS_TAC],
      MATCH_MP_TAC SUP_EQ] THEN
    PURE_REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_GSPEC] THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [DE_MORGAN_THM, NOT_FORALL_THM, MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [← GSYM DE_MORGAN_THM] THEN AP_TERM_TAC THEN EQ_TAC THEN
    DISCH_THEN (fun th => POP_ASSUM MP_TAC THEN ASSUME_TAC th) THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"--(&1):real")) THEN
    SIMP_TAC [SETDIST_POS_LE, ← REAL_ARITH (← q r"&0 <= x ==> ~(x <= --(&1))")] THEN
    SET_TAC [])

  let HAUSDIST_TRANSLATION ← prove
   r"!a s t:real^N->bool.
        hausdist(IMAGE (\x. a + x) s,IMAGE (\x. a + x) t) = hausdist(s,t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [hausdist] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x | x IN IMAGE g s} = {f(g x) | x IN s}")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{a + x:real^N} = IMAGE (\x. a + x) {x}")] THEN
    REWRITE_TAC [SETDIST_TRANSLATION])

  add_translation_invariants [HAUSDIST_TRANSLATION]

  let HAUSDIST_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s t.
           linear f /\ (!x. norm(f x) = norm x)
           ==> hausdist(IMAGE f s,IMAGE f t) = hausdist(s,t)"
   (REPEAT STRIP_TAC THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [hausdist] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x | x IN IMAGE g s} = {f(g x) | x IN s}")] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"{(f:real^M->real^N) x} = IMAGE f {x}")] THEN
    ASM_SIMP_TAC [SETDIST_LINEAR_IMAGE])

  add_linear_invariants [HAUSDIST_LINEAR_IMAGE]

  let HAUSDIST_CLOSURE ← prove
   r"(!s t:real^N->bool. hausdist(closure s,t) = hausdist(s,t)) /\
   (!s t:real^N->bool. hausdist(s,closure t) = hausdist(s,t))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAUSDIST_EQ THEN
    GEN_TAC THEN BINOP_TAC THEN REWRITE_TAC [SETDIST_CLOSURE] THEN
    PURE_ONCE_REWRITE_TAC [← SET_RULE
     (← q r"(!x. P x ==> Q x) <=> (!x. P x ==> x IN {x | Q x})")] THEN
    MATCH_MP_TAC FORALL_IN_CLOSURE_EQ THEN
    REWRITE_TAC [EMPTY_GSPEC, CONTINUOUS_ON_ID, CLOSED_EMPTY] THEN
    ONCE_REWRITE_TAC [← MESON [LIFT_DROP] (← q r"x <= b <=> drop(lift x) <= b")] THEN
    REWRITE_TAC [← SET_RULE
      (← q r"{x | drop(lift(f x)) <= b} =
       {x | x IN UNIV /\ lift(f x) IN {x | drop x <= b}}")] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE THEN
    REWRITE_TAC [CLOSED_UNIV, CONTINUOUS_ON_LIFT_SETDIST] THEN
    REWRITE_TAC [drop, CLOSED_HALFSPACE_COMPONENT_LE])

  return { hausdist, HAUSDIST_POS_LE, HAUSDIST_POS_LT, REAL_ABS_HAUSDIST, HAUSDIST_REFL,
           HAUSDIST_SYM, HAUSDIST_EMPTY, HAUSDIST_SINGS, HAUSDIST_SCALING, HAUSDIST_EQ,
           HAUSDIST_TRANSLATION, HAUSDIST_LINEAR_IMAGE, HAUSDIST_CLOSURE }

/- ------------------------------------------------------------------------- -/
/- Bounds for Hausdorff distance.  (topology.ml 25481-25680)                 -/
/- ------------------------------------------------------------------------- -/

structure HDB where
  REAL_HAUSDIST_LE : thm
  REAL_HAUSDIST_LE_SUMS : thm
  REAL_LE_HAUSDIST : thm
  SETDIST_LE_HAUSDIST : thm
  SETDIST_SING_LE_HAUSDIST : thm
  SETDIST_HAUSDIST_TRIANGLE : thm
  HAUSDIST_SETDIST_TRIANGLE : thm
  REAL_LT_HAUSDIST_POINT_EXISTS : thm
  HAUSDIST_UNIFORMLY_CONTINUOUS_ON : thm
  SUBSET_COMPACT_HAUSDIST_LIMIT : thm
  deriving Inhabited

@[nospecialize]
def setupHDB [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCLS1 : CLS1) (BLIM2 : LIM2)
    (BBND1 : BND1) (BBND2 : BND2) (BCPT : CPT) (BCNO : CNO) (BSDS : SDS) (BSD2 : SD2)
    (BSD3 : SD3) (BHDA : HDA) : ExceptT String IO HDB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D
  let { CONJ_ASSOC, CONJ_SYM, CONTRAPOS_THM, EMPTY_UNION, EXISTS_OR_THM, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_UNION, FUN_IN_IMAGE, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, IMP_CONJ, IN_ELIM_THM, IN_SING, .. } := D.core2
  let { LEFT_EXISTS_AND_THM, LET_DEF, LET_END_DEF, LE_REFL, MEMBER_NOT_EMPTY, MONO_AND,
        MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_INSERT_EMPTY,
        NOT_IN_EMPTY, REAL_ADD_LID, .. } := D.core3
  let { REAL_ADD_SYM, REAL_LET_TRANS, REAL_LE_ADD, REAL_LE_MAX, REAL_LE_REFL, REAL_LE_SUB_RADD,
        REAL_LE_SUP, REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.core4
  let { REAL_NOT_LT, REAL_SUP_LE, RIGHT_EXISTS_AND_THM, SING_SUBSET, SUBSET, .. } := D.core5
  let { SWAP_FORALL_THM, UNWIND_THM1, UNWIND_THM2, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_0, DIST_SYM, .. } := D.vec1
  let { NORM_LIFT, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { IN_CBALL_0, .. } := BBAL
  let { CLOSURE_CLOSED, .. } := BCLS1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { BOUNDED_SING, bounded, .. } := BBND1
  let { BOUNDED_DIFFS, .. } := BBND2
  let { COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := BCPT
  let { uniformly_continuous_on, .. } := BCNO
  let { REAL_LE_SETDIST_EQ, REAL_SETDIST_LT_EXISTS, SETDIST_EMPTY, SETDIST_LE_DIST,
        SETDIST_POS_LE, SETDIST_POS_LT, SETDIST_SINGS, SETDIST_SYM, .. } := BSDS
  let { SETDIST_SING_TRIANGLE, .. } := BSD2
  let { SETDIST_EQ_0_SING, SETDIST_LE_SING, .. } := BSD3
  let { HAUSDIST_EMPTY, HAUSDIST_POS_LE, HAUSDIST_SINGS, HAUSDIST_SYM, REAL_ABS_HAUSDIST,
        hausdist, .. } := BHDA
  -- @@SCOPE END

  let REAL_HAUSDIST_LE ← prove
   r"!s t:real^N->bool b.
        ~(s = {}) /\ ~(t = {}) /\
        (!x. x IN s ==> setdist({x},t) <= b) /\
        (!y. y IN t ==> setdist({y},s) <= b)
        ==> hausdist(s,t) <= b"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [hausdist, LET_DEF, LET_END_DEF, SETDIST_SINGS] THEN
    ASM_REWRITE_TAC [EMPTY_UNION, ← SET_RULE (← q r"{f x | x IN s} = {} <=> s = {}")] THEN
    REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_GSPEC] THEN
    COND_CASES_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    MATCH_MP_TAC REAL_SUP_LE THEN
    ASM_REWRITE_TAC [EMPTY_UNION, ← SET_RULE (← q r"{f x | x IN s} = {} <=> s = {}")] THEN
    ASM_REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_GSPEC])

  let REAL_HAUSDIST_LE_SUMS ← prove
   r"!s t:real^N->bool b.
        ~(s = {}) /\ ~(t = {}) /\
        s SUBSET {y + z | y IN t /\ z IN cball(vec 0,b)} /\
        t SUBSET {y + z | y IN s /\ z IN cball(vec 0,b)}
        ==> hausdist(s,t) <= b"
   (REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_CBALL_0] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a:real^N = b + x <=> a - b = x"),
                 ← ONCE_REWRITE_RULE [CONJ_SYM] UNWIND_THM1] THEN
    REWRITE_TAC [← GSYM dist] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_HAUSDIST_LE THEN
    ASM_MESON_TAC [SETDIST_LE_DIST, REAL_LE_TRANS, IN_SING])

  let REAL_LE_HAUSDIST ← prove
   r"!s t:real^N->bool a b c z.
        ~(s = {}) /\ ~(t = {}) /\
        (!x. x IN s ==> setdist({x},t) <= b) /\
        (!y. y IN t ==> setdist({y},s) <= c) /\
        (z IN s /\ a <= setdist({z},t) \/ z IN t /\ a <= setdist({z},s))
        ==> a <= hausdist(s,t)"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    REWRITE_TAC [hausdist, LET_DEF, LET_END_DEF, SETDIST_SINGS] THEN
    ASM_REWRITE_TAC [EMPTY_UNION, ← SET_RULE (← q r"{f x | x IN s} = {} <=> s = {}")] THEN
    REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_GSPEC] THEN COND_CASES_TAC THENL
     [MATCH_MP_TAC REAL_LE_SUP THEN
      ASM_SIMP_TAC [EMPTY_UNION, ← SET_RULE (← q r"{f x | x IN s} = {} <=> s = {}")] THEN
      REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_GSPEC],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
      REWRITE_TAC [NOT_FORALL_THM]] THEN
    EXISTS_TAC (← q r"max b c:real") THEN
    ASM_SIMP_TAC [REAL_LE_MAX] THEN ASM SET_TAC [])

  let SETDIST_LE_HAUSDIST ← prove
   r"!s t:real^N->bool.
        bounded s /\ bounded t ==> setdist(s,t) <= hausdist(s,t)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SETDIST_EMPTY, HAUSDIST_EMPTY, REAL_LE_REFL] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SETDIST_EMPTY, HAUSDIST_EMPTY, REAL_LE_REFL] THEN
    MATCH_MP_TAC REAL_LE_HAUSDIST THEN REWRITE_TAC [CONJ_ASSOC] THEN
    ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM, LEFT_EXISTS_AND_THM] THEN
    CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [SETDIST_LE_SING, MEMBER_NOT_EMPTY]] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"] BOUNDED_DIFFS) THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [bounded, FORALL_IN_GSPEC, ← GSYM dist] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"b:real")) THEN
    CONJ_TAC THEN EXISTS_TAC (← q r"b:real") THEN REPEAT STRIP_TAC THEN
    ASM_MESON_TAC [REAL_LE_TRANS, SETDIST_LE_DIST, MEMBER_NOT_EMPTY, IN_SING,
                   DIST_SYM])

  let SETDIST_SING_LE_HAUSDIST ← prove
   r"!s t x:real^N.
        bounded s /\ bounded t /\ x IN s ==> setdist({x},t) <= hausdist(s,t)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SETDIST_EMPTY, HAUSDIST_EMPTY, REAL_LE_REFL] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_LE_HAUSDIST THEN
    ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [LEFT_EXISTS_AND_THM, EXISTS_OR_THM, CONJ_ASSOC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL_LE_REFL]] THEN CONJ_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"] BOUNDED_DIFFS) THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [bounded, FORALL_IN_GSPEC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [← GSYM dist] THEN GEN_TAC THENL
     [ALL_TAC, ONCE_REWRITE_TAC [SWAP_FORALL_THM]] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"y:real^N") THEN
    REPEAT STRIP_TAC THENL
     [UNDISCH_TAC (← q r"~(t:real^N->bool = {})"),
      UNDISCH_TAC (← q r"~(s:real^N->bool = {})")] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:real^N")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THENL
     [ALL_TAC, ONCE_REWRITE_TAC [DIST_SYM]] THEN
    MATCH_MP_TAC SETDIST_LE_DIST THEN ASM_REWRITE_TAC [IN_SING])

  let SETDIST_HAUSDIST_TRIANGLE ← prove
   r"!s t u:real^N->bool.
        ~(t = {}) /\ bounded t /\ bounded u
        ==> setdist(s,u) <= setdist(s,t) + hausdist(t,u)"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"s:real^N->bool = {}", ← q r"u:real^N->bool = {}"] THEN
    ASM_SIMP_TAC [SETDIST_EMPTY, REAL_LE_ADD, REAL_ADD_LID,
                  SETDIST_POS_LE, HAUSDIST_POS_LE] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a <= b + c <=> a - c <= b")] THEN
    ASM_REWRITE_TAC [REAL_LE_SETDIST_EQ, NOT_INSERT_EMPTY, IN_SING] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    REWRITE_TAC [REAL_LE_SUB_RADD] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"setdist({x:real^N},u)") THEN
    ASM_SIMP_TAC [SETDIST_LE_SING] THEN
    MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"x:real^N", ← q r"y:real^N"]
          SETDIST_SING_TRIANGLE) THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"yu <= z ==> abs(xu - yu) <= d ==> xu <= d + z")) THEN
    MATCH_MP_TAC SETDIST_SING_LE_HAUSDIST THEN ASM_REWRITE_TAC [])

  let HAUSDIST_SETDIST_TRIANGLE ← prove
   r"!s t u:real^N->bool.
        ~(t = {}) /\ bounded s /\ bounded t
        ==> setdist(s,u) <= hausdist(s,t) + setdist(t,u)"
   (ONCE_REWRITE_TAC [SETDIST_SYM, HAUSDIST_SYM] THEN
    ONCE_REWRITE_TAC [REAL_ADD_SYM] THEN
    SIMP_TAC [SETDIST_HAUSDIST_TRIANGLE])

  let REAL_LT_HAUSDIST_POINT_EXISTS ← prove
   r"!s t x:real^N d.
        bounded s /\ bounded t /\ ~(t = {}) /\ hausdist(s,t) < d /\ x IN s
        ==> ?y. y IN t /\ dist(x,y) < d"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{x:real^N}", ← q r"t:real^N->bool", ← q r"d:real"]
          REAL_SETDIST_LT_EXISTS) THEN
    REWRITE_TAC [IN_SING, RIGHT_EXISTS_AND_THM, UNWIND_THM2] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [NOT_INSERT_EMPTY] THEN
    TRANS_TAC REAL_LET_TRANS (← q r"hausdist(s:real^N->bool,t)") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SETDIST_SING_LE_HAUSDIST THEN
    ASM_REWRITE_TAC [])

  let HAUSDIST_UNIFORMLY_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N s.
        f uniformly_continuous_on s <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !t t'. t SUBSET s /\ t' SUBSET s /\
                           bounded t /\ bounded t' /\
                           hausdist(t',t) < d
                           ==> hausdist(IMAGE f t',IMAGE f t) < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [uniformly_continuous_on] THEN EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"d / &2") THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real^M->bool", ← q r"t':real^M->bool"] THEN
      STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
      ASM_CASES_TAC (← q r"t:real^M->bool = {}") THEN
      ASM_SIMP_TAC [HAUSDIST_EMPTY, IMAGE_CLAUSES, REAL_HALF, REAL_LT_IMP_LE] THEN
      ASM_CASES_TAC (← q r"t':real^M->bool = {}") THEN
      ASM_SIMP_TAC [HAUSDIST_EMPTY, IMAGE_CLAUSES, REAL_HALF, REAL_LT_IMP_LE] THEN
      MATCH_MP_TAC REAL_HAUSDIST_LE THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THENL
       [MP_TAC (← ISPECL [← q r"t':real^M->bool", ← q r"t:real^M->bool", ← q r"x:real^M",
                          ← q r"d / &2"]
          REAL_LT_HAUSDIST_POINT_EXISTS),
        MP_TAC (← ISPECL [← q r"t:real^M->bool", ← q r"t':real^M->bool", ← q r"x:real^M",
                          ← q r"d / &2"]
          REAL_LT_HAUSDIST_POINT_EXISTS)] THEN
      ASM_REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [HAUSDIST_SYM] THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^M") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"y:real^M", ← q r"x:real^M"]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"x < d / &2 /\ &0 < d ==> x < d")] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> y < e / &2 ==> x <= e / &2")) THEN
      MATCH_MP_TAC SETDIST_LE_DIST THEN ASM_SIMP_TAC [IN_SING, FUN_IN_IMAGE],
      MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM HAUSDIST_SINGS] THEN REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"{f x} = IMAGE f {x}")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [SING_SUBSET, BOUNDED_SING]])

  let SUBSET_COMPACT_HAUSDIST_LIMIT ← prove
   r"!f s t:real^N->bool.
        compact s /\ ~(s = {}) /\
        (!n. t SUBSET f n) /\ (!n. bounded(f n)) /\
        ((\n. lift(hausdist (f n,s))) --> vec 0) sequentially
        ==> t SUBSET s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"setdist({x:real^N},s) = &0") MP_TAC THENL
     [GEN_REWRITE_TAC id [← TAUT (← q r"p <=> ~ ~ p")],
      ASM_SIMP_TAC [SETDIST_EQ_0_SING, CLOSURE_CLOSED, COMPACT_IMP_CLOSED]] THEN
    PURE_REWRITE_TAC [← GSYM SETDIST_POS_LT] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"setdist({x:real^N},s)")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
    REWRITE_TAC [DIST_0, NORM_LIFT, REAL_ABS_HAUSDIST, LE_REFL] THEN
    REWRITE_TAC [REAL_NOT_LT] THEN MATCH_MP_TAC SETDIST_SING_LE_HAUSDIST THEN
    ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN ASM SET_TAC [])

  return { REAL_HAUSDIST_LE, REAL_HAUSDIST_LE_SUMS, REAL_LE_HAUSDIST, SETDIST_LE_HAUSDIST,
           SETDIST_SING_LE_HAUSDIST, SETDIST_HAUSDIST_TRIANGLE, HAUSDIST_SETDIST_TRIANGLE,
           REAL_LT_HAUSDIST_POINT_EXISTS, HAUSDIST_UNIFORMLY_CONTINUOUS_ON,
           SUBSET_COMPACT_HAUSDIST_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Hemicontinuity, nontrivial forms, unions and the triangle law for         -/
/- Hausdorff distance.  (topology.ml 25681-25853)                            -/
/- ------------------------------------------------------------------------- -/

structure HDC where
  UPPER_LOWER_HEMICONTINUOUS : thm
  HAUSDIST_NONTRIVIAL : thm
  HAUSDIST_NONTRIVIAL_ALT : thm
  REAL_HAUSDIST_LE_EQ : thm
  HAUSDIST_UNION_LE : thm
  HAUSDIST_INSERT_LE : thm
  HAUSDIST_COMPACT_EXISTS : thm
  HAUSDIST_TRIANGLE : thm
  deriving Inhabited

@[nospecialize]
def setupHDC [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLOC : LOC) (BCLS1 : CLS1)
    (BBND1 : BND1) (BBND2 : BND2) (BCPT : CPT) (BCPP1 : CPP1) (BHEM : HEM) (BSDS : SDS)
    (BSD2 : SD2) (BSD3 : SD3) (BHDA : HDA) (BHDB : HDB) : ExceptT String IO HDC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, NORM_ARITH, .. } := D
  let { CONJ_ACI, CONJ_ASSOC, DE_MORGAN_THM, EMPTY_UNION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_UNION, IMAGE_EQ_EMPTY, IN_ELIM_THM,
        IN_SING, .. } := D.core2
  let { IN_UNION, LEFT_EXISTS_AND_THM, LET_DEF, LET_END_DEF, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_INSERT_EMPTY, REAL_ADD_LID, REAL_ADD_RID, .. } := D.core3
  let { REAL_ADD_SYM, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_MIN, .. } :=
    D.core4
  let { REAL_MAX_LE, REAL_SUP_LE_EQ, RIGHT_EXISTS_AND_THM, SIMPLE_IMAGE, SUBSET_INTER,
        SUBSET_UNION, .. } := D.core5
  let { SUP_UNION, UNWIND_THM1, UNWIND_THM2, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_SYM, .. } := D.vec1
  let { dist, .. } := D.vec4
  let { OPEN_BALL, .. } := BBAL
  let { OPEN_IN_OPEN_INTER, open_in, .. } := BLOC
  let { CLOSURE_EQ_EMPTY, .. } := BCLS1
  let { BOUNDED_SING, BOUNDED_UNION, bounded, .. } := BBND1
  let { BOUNDED_DIFFS, BOUNDED_SUBSET_BALL, .. } := BBND2
  let { COMPACT_CLOSURE, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := BCPT
  let { COMPACT_SING, .. } := BCPP1
  let { UPPER_LOWER_HEMICONTINUOUS_EXPLICIT, .. } := BHEM
  let { SETDIST_LE_DIST, .. } := BSDS
  let { SETDIST_SUBSET_RIGHT, .. } := BSD2
  let { SETDIST_COMPACT_CLOSED, SETDIST_SING_IN_SET, .. } := BSD3
  let { HAUSDIST_CLOSURE, HAUSDIST_EMPTY, HAUSDIST_POS_LE, HAUSDIST_SYM, hausdist, .. } := BHDA
  let { REAL_HAUSDIST_LE, REAL_LE_HAUSDIST, SETDIST_SING_LE_HAUSDIST, .. } := BHDB
  -- @@SCOPE END

  let UPPER_LOWER_HEMICONTINUOUS ← prove
   r"!f:real^M->real^N->bool t s.
      (!x. x IN s ==> f(x) SUBSET t) /\
      (!u. open_in (subtopology euclidean t) u
           ==> open_in (subtopology euclidean s)
                       {x | x IN s /\ f(x) SUBSET u}) /\
      (!u. closed_in (subtopology euclidean t) u
           ==> closed_in (subtopology euclidean s)
                         {x | x IN s /\ f(x) SUBSET u})
      ==> !x e. x IN s /\ &0 < e /\ bounded(f x)
                ==> ?d. &0 < d /\
                        !x'. x' IN s /\ dist(x,x') < d
                             ==> hausdist(f x,f x') < e"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(f:real^M->real^N->bool) x = {}") THENL
     [ASM_REWRITE_TAC [HAUSDIST_EMPTY] THEN MESON_TAC [REAL_LT_01], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPECL [← q r"x:real^M", ← q r"e / &2"] o MATCH_MP
          UPPER_LOWER_HEMICONTINUOUS_EXPLICIT) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP BOUNDED_SUBSET_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"t INTER ball(vec 0:real^N,r)") o
          CONJUNCT1 o CONJUNCT2) THEN
    SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL] THEN REWRITE_TAC [open_in] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M") o CONJUNCT2) THEN
    ASM_SIMP_TAC [SUBSET_INTER, IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d1 d2:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    X_GEN_TAC (← q r"x':real^M") THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x':real^M"))) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(f:real^M->real^N->bool) x' = {}") THEN
    ASM_REWRITE_TAC [HAUSDIST_EMPTY] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_HAUSDIST_LE THEN
    ASM_MESON_TAC [SETDIST_LE_DIST, DIST_SYM, REAL_LE_TRANS,
                   IN_SING, REAL_LT_IMP_LE])

  let HAUSDIST_NONTRIVIAL ← prove
   r"!s t:real^N->bool.
        bounded s /\ bounded t /\ ~(s = {}) /\ ~(t = {})
        ==> hausdist(s,t) =
            sup({setdist ({x},t) | x IN s} UNION {setdist ({y},s) | y IN t})"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [hausdist, LET_DEF, LET_END_DEF] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [DE_MORGAN_THM]) THEN
    ASM_SIMP_TAC [EMPTY_UNION, SIMPLE_IMAGE, IMAGE_EQ_EMPTY] THEN
    MATCH_MP_TAC (← TAUT (← q r"p ==> ~p ==> q")) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"] BOUNDED_DIFFS) THEN
    ASM_REWRITE_TAC [bounded, FORALL_IN_UNION, FORALL_IN_IMAGE, ← GSYM dist] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
    ASM_MESON_TAC [SETDIST_LE_DIST, dist, DIST_SYM, REAL_LE_TRANS,
                   MEMBER_NOT_EMPTY, IN_SING])

  let HAUSDIST_NONTRIVIAL_ALT ← prove
   r"!s t:real^N->bool.
        bounded s /\ bounded t /\ ~(s = {}) /\ ~(t = {})
        ==> hausdist(s,t) = max (sup {setdist ({x},t) | x IN s})
                                (sup {setdist ({y},s) | y IN t})"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [HAUSDIST_NONTRIVIAL] THEN
    MATCH_MP_TAC SUP_UNION THEN
    ASM_REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
    CONJ_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"] BOUNDED_DIFFS) THEN
    ASM_REWRITE_TAC [bounded, FORALL_IN_UNION, FORALL_IN_IMAGE, ← GSYM dist] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [FORALL_IN_GSPEC, ← GSYM dist] THEN
    ASM_MESON_TAC [SETDIST_LE_DIST, dist, DIST_SYM, REAL_LE_TRANS,
                   MEMBER_NOT_EMPTY, IN_SING])

  let REAL_HAUSDIST_LE_EQ ← prove
   r"!s t:real^N->bool b.
        ~(s = {}) /\ ~(t = {}) /\ bounded s /\ bounded t
        ==> (hausdist(s,t) <= b <=>
             (!x. x IN s ==> setdist({x},t) <= b) /\
             (!y. y IN t ==> setdist({y},s) <= b))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [HAUSDIST_NONTRIVIAL_ALT, REAL_MAX_LE] THEN
    BINOP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"(!x. x IN s ==> f x <= b) <=>
                               (!y. y IN {f x | x IN s} ==> y <= b)")] THEN
    MATCH_MP_TAC REAL_SUP_LE_EQ THEN
    ASM_REWRITE_TAC [SIMPLE_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"] BOUNDED_DIFFS) THEN
    ASM_REWRITE_TAC [bounded, FORALL_IN_UNION, FORALL_IN_IMAGE, ← GSYM dist] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [FORALL_IN_GSPEC, ← GSYM dist] THEN
    ASM_MESON_TAC [SETDIST_LE_DIST, dist, DIST_SYM, REAL_LE_TRANS,
                   MEMBER_NOT_EMPTY, IN_SING])

  let HAUSDIST_UNION_LE ← prove
   r"!s t u:real^N->bool.
        bounded s /\ bounded t /\ bounded u /\ ~(t = {}) /\ ~(u = {})
        ==> hausdist(s UNION t,s UNION u) <= hausdist(t,u)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [REAL_HAUSDIST_LE_EQ, BOUNDED_UNION, EMPTY_UNION] THEN
    REWRITE_TAC [FORALL_IN_UNION] THEN
    SIMP_TAC [SETDIST_SING_IN_SET, IN_UNION, HAUSDIST_POS_LE] THEN
    ASM_SIMP_TAC [← GSYM REAL_HAUSDIST_LE_EQ, BOUNDED_UNION, EMPTY_UNION] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THENL
     [TRANS_TAC REAL_LE_TRANS (← q r"setdist({x:real^N},u)"),
      TRANS_TAC REAL_LE_TRANS (← q r"setdist({x:real^N},t)")] THEN
    ASM_SIMP_TAC [SETDIST_SUBSET_RIGHT, SUBSET_UNION] THENL
     [ALL_TAC, ONCE_REWRITE_TAC [HAUSDIST_SYM]] THEN
    MATCH_MP_TAC SETDIST_SING_LE_HAUSDIST THEN ASM_REWRITE_TAC [])

  let HAUSDIST_INSERT_LE ← prove
   r"!s t a:real^N.
        bounded s /\ bounded t /\ ~(s = {}) /\ ~(t = {})
        ==> hausdist(a INSERT s,a INSERT t) <= hausdist(s,t)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = {a} UNION s")] THEN
    ASM_SIMP_TAC [HAUSDIST_UNION_LE, NOT_INSERT_EMPTY, BOUNDED_SING])

  let HAUSDIST_COMPACT_EXISTS ← prove
   r"!s t:real^N->bool.
        bounded s /\ compact t /\ ~(t = {})
        ==> !x. x IN s ==> ?y. y IN t /\ dist(x,y) <= hausdist(s,t)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"{x:real^N}", ← q r"t:real^N->bool"]
          SETDIST_COMPACT_CLOSED) THEN
    ASM_SIMP_TAC [COMPACT_SING, COMPACT_IMP_CLOSED, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [IN_SING, UNWIND_THM2, RIGHT_EXISTS_AND_THM, UNWIND_THM1] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC REAL_LE_HAUSDIST THEN
    ASM_REWRITE_TAC [LEFT_EXISTS_AND_THM, RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN
    CONJ_TAC THENL [CONJ_TAC, ASM_MESON_TAC [REAL_LE_REFL]] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"] BOUNDED_DIFFS) THEN
    ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN
    REWRITE_TAC [bounded, FORALL_IN_GSPEC, ← GSYM dist] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [SETDIST_LE_DIST, dist, DIST_SYM, REAL_LE_TRANS,
                   MEMBER_NOT_EMPTY, IN_SING])

  let HAUSDIST_TRIANGLE ← prove
   r"!s t u:real^N->bool.
        bounded s /\ bounded t /\ bounded u /\ ~(t = {})
        ==> hausdist(s,u) <= hausdist(s,t) + hausdist(t,u)"
   (ONCE_REWRITE_TAC [← GSYM (← CONJUNCT1 HAUSDIST_CLOSURE)] THEN
    ONCE_REWRITE_TAC [← GSYM (← CONJUNCT2 HAUSDIST_CLOSURE)] THEN
    ONCE_REWRITE_TAC [← GSYM COMPACT_CLOSURE, ← GSYM CLOSURE_EQ_EMPTY] THEN
    REPEAT GEN_TAC THEN
    (← do
      let cl ← q r"closure:(real^N->bool)->real^N->bool"
      pure (MAP_EVERY
        (fun t => tactic_of do pure (SPEC_TAC (← liftExcept (mk_comb cl t), t)))
        [← q r"u:real^N->bool", ← q r"t:real^N->bool", ← q r"s:real^N->bool"])) THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [HAUSDIST_EMPTY, HAUSDIST_POS_LE, REAL_ADD_LID] THEN
    ASM_CASES_TAC (← q r"u:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [HAUSDIST_EMPTY, HAUSDIST_POS_LE, REAL_ADD_RID] THEN
    ASM_SIMP_TAC [REAL_HAUSDIST_LE_EQ, COMPACT_IMP_BOUNDED] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [HAUSDIST_SYM] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [REAL_ADD_SYM] THEN
    POP_ASSUM_LIST (MP_TAC o end_itlist CONJ) THEN
     MAP_EVERY (fun t => SPEC_TAC (t, t))
     [← q r"u:real^N->bool", ← q r"t:real^N->bool", ← q r"s:real^N->bool"] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!s t u. P s t u ==> P u t s) /\
      (!s t u. P s t u ==> Q s t u)
      ==> (!s t u. P s t u ==> Q s t u /\ Q u t s)")) THEN
    CONJ_TAC THENL [REWRITE_TAC [CONJ_ACI], REPEAT GEN_TAC THEN STRIP_TAC] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"?y:real^N. y IN t /\ dist(x,y) <= hausdist(s,t)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [HAUSDIST_COMPACT_EXISTS, COMPACT_IMP_BOUNDED], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?z:real^N. z IN u /\ dist(y,z) <= hausdist(t,u)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [HAUSDIST_COMPACT_EXISTS, COMPACT_IMP_BOUNDED], ALL_TAC] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← NORM_ARITH
     (← q r"dist(y,z) <= b ==> dist(x,y) <= a /\ s <= dist(x,z) ==> s <= a + b"))) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SETDIST_LE_DIST THEN
    ASM_REWRITE_TAC [IN_SING])

  return { UPPER_LOWER_HEMICONTINUOUS, HAUSDIST_NONTRIVIAL, HAUSDIST_NONTRIVIAL_ALT,
           REAL_HAUSDIST_LE_EQ, HAUSDIST_UNION_LE, HAUSDIST_INSERT_LE, HAUSDIST_COMPACT_EXISTS,
           HAUSDIST_TRIANGLE }

/- ------------------------------------------------------------------------- -/
/- Sums, zero Hausdorff distance, and balls.  (topology.ml 25854-26009)      -/
/- ------------------------------------------------------------------------- -/

structure HDD where
  HAUSDIST_COMPACT_SUMS : thm
  HAUSDIST_SUMS_LE : thm
  HAUSDIST_SUMS_LE_LCANCEL : thm
  HAUSDIST_SUMS_LE_RCANCEL : thm
  HAUSDIST_EQ_0 : thm
  HAUSDIST_COMPACT_NONTRIVIAL : thm
  HAUSDIST_BALLS : thm
  deriving Inhabited

@[nospecialize]
def setupHDD [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCLS1 : CLS1) (BCBL : CBL) (BBND1 : BND1)
    (BCPT : CPT) (BIDC : IDC) (BECF : ECF) (BCCC : CCC) (BSDS : SDS) (BSD3 : SD3) (BSD4 : SD4)
    (BHDA : HDA) (BHDB : HDB) (BHDC : HDC) : ExceptT String IO HDD := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_TAC, VECTOR_ARITH,
        NORM_ARITH, NORM_ARITH_TAC, .. } := D
  let { CONJ_SYM, DE_MORGAN_THM, DIMINDEX_GE_1, EXISTS_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_UNION, IN_ELIM_THM, IN_SING, .. } := D.core2
  let { LE_REFL, REAL_ABS_MUL, REAL_ADD_LID, REAL_ADD_RDISTRIB, REAL_ADD_RID, .. } := D.core3
  let { REAL_DIV_RMUL, REAL_INF_UNIQUE, REAL_LE_ADD, REAL_LE_ANTISYM, REAL_LE_TRANS,
        REAL_LT_IMP_LE, REAL_LT_REFL, .. } := D.core4
  let { REAL_MAX_LE, REAL_MUL_LID, REAL_NOT_LE, REAL_NOT_LT, SUBSET, SUBSET_ANTISYM_EQ, .. } :=
    D.core5
  let { SUP_UNIQUE, UNWIND_THM1, .. } := D.core6
  let { DIST_REFL, DIST_SYM, .. } := D.vec1
  let { NORM_BASIS, NORM_EQ_0, NORM_MUL, NORM_SUB, REAL_ABS_NORM, .. } := D.vec3
  let { VECTOR_SUB_EQ, dist, .. } := D.vec4
  let { BALL_EMPTY, IN_CBALL, IN_CBALL_0, .. } := BBAL
  let { CLOSED_CLOSURE, .. } := BCLS1
  let { CBALL_EMPTY, CBALL_EQ_EMPTY, CBALL_SING, CLOSURE_BALL, .. } := BCBL
  let { BOUNDED_CBALL, .. } := BBND1
  let { COMPACT_CLOSURE, COMPACT_IMP_BOUNDED, .. } := BCPT
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { FORALL_IN_CLOSURE_EQ, .. } := BECF
  let { CLOSURE_SUMS, .. } := BCCC
  let { SETDIST_LE_DIST, SETDIST_POS_LE, .. } := BSDS
  let { SETDIST_EQ_0_SING, .. } := BSD3
  let { SETDIST_BALLS, .. } := BSD4
  let { HAUSDIST_CLOSURE, HAUSDIST_EMPTY, HAUSDIST_POS_LE, HAUSDIST_REFL, HAUSDIST_SYM, .. } :=
    BHDA
  let { REAL_HAUSDIST_LE, .. } := BHDB
  let { HAUSDIST_COMPACT_EXISTS, HAUSDIST_NONTRIVIAL, REAL_HAUSDIST_LE_EQ, .. } := BHDC
  -- @@SCOPE END

  let HAUSDIST_COMPACT_SUMS ← prove
   r"!s t:real^N->bool.
        bounded s /\ compact t /\ ~(t = {})
        ==> s SUBSET {y + z | y IN t /\ z IN cball(vec 0,hausdist(s,t))}"
   (REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_CBALL_0] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a:real^N = b + x <=> a - b = x"),
                 ← ONCE_REWRITE_RULE [CONJ_SYM] UNWIND_THM1] THEN
    REWRITE_TAC [← GSYM dist, HAUSDIST_COMPACT_EXISTS])

  let HAUSDIST_SUMS_LE ← prove
   r"!s t u v:real^N->bool.
        bounded s /\ bounded t /\ bounded u /\ bounded v
        ==> hausdist({x + y | x IN s /\ y IN t},{x + y | x IN u /\ y IN v})
            <= hausdist(s,u) + hausdist(t,v)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM (← CONJUNCT1 HAUSDIST_CLOSURE)] THEN
    ONCE_REWRITE_TAC [← GSYM (← CONJUNCT2 HAUSDIST_CLOSURE)] THEN
    SIMP_TAC [CLOSURE_SUMS] THEN
    ONCE_REWRITE_TAC [← GSYM COMPACT_CLOSURE] THEN
    (← do
      let cl ← q r"closure:(real^N->bool)->real^N->bool"
      pure (MAP_EVERY
        (fun t => tactic_of do pure (SPEC_TAC (← liftExcept (mk_comb cl t), t)))
        [← q r"v:real^N->bool", ← q r"u:real^N->bool", ← q r"t:real^N->bool",
         ← q r"s:real^N->bool"])) THEN
    REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"{x + y:real^N | x IN s /\ y IN t} = {}") THEN
    ASM_SIMP_TAC [HAUSDIST_EMPTY, HAUSDIST_POS_LE, REAL_LE_ADD] THEN
    ASM_CASES_TAC (← q r"{x + y:real^N | x IN u /\ y IN v} = {}") THEN
    ASM_SIMP_TAC [HAUSDIST_EMPTY, HAUSDIST_POS_LE, REAL_LE_ADD] THEN
    MATCH_MP_TAC REAL_HAUSDIST_LE THEN ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN
    CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"v:real^N->bool"]
        HAUSDIST_COMPACT_EXISTS) THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"u:real^N->bool"]
        HAUSDIST_COMPACT_EXISTS),
      MP_TAC (← ISPECL [← q r"v:real^N->bool", ← q r"t:real^N->bool"]
        HAUSDIST_COMPACT_EXISTS) THEN
      MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"s:real^N->bool"]
        HAUSDIST_COMPACT_EXISTS)] THEN
    ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN
    (ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N"))]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N") STRIP_ASSUME_TAC) THEN
    (ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (MP_TAC o SPEC (← q r"b:real^N"))]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^N") STRIP_ASSUME_TAC) THENL
     [ALL_TAC, ONCE_REWRITE_TAC [HAUSDIST_SYM]] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"dist(a + b:real^N,c + d)") THEN
    (CONJ_TAC THENL
      [MATCH_MP_TAC SETDIST_LE_DIST THEN ASM SET_TAC [],
       REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_NOT_LT])) THEN
       CONV_TAC (fun t => NORM_ARITH t)]))

  let HAUSDIST_SUMS_LE_LCANCEL ← prove
   r"!s t u:real^N->bool.
        bounded s /\ bounded t /\ bounded u
        ==> hausdist({x + y | x IN s /\ y IN t},{x + y | x IN s /\ y IN u})
            <= hausdist(t,u)"
   (REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) HAUSDIST_SUMS_LE o lhand o snd) THEN
    ASM_REWRITE_TAC [HAUSDIST_REFL, REAL_ADD_LID])

  let HAUSDIST_SUMS_LE_RCANCEL ← prove
   r"!s t u:real^N->bool.
        bounded s /\ bounded t /\ bounded u
        ==> hausdist({x + y | x IN s /\ y IN u},{x + y | x IN t /\ y IN u})
            <= hausdist(s,t)"
   (REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) HAUSDIST_SUMS_LE o lhand o snd) THEN
    ASM_REWRITE_TAC [HAUSDIST_REFL, REAL_ADD_RID])

  let HAUSDIST_EQ_0 ← prove
   r"!s t:real^N->bool.
      bounded s /\ bounded t
      ==> (hausdist(s,t) = &0 <=> s = {} \/ t = {} \/ closure s = closure t)"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"s:real^N->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [HAUSDIST_EMPTY] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_ANTISYM, HAUSDIST_POS_LE, REAL_HAUSDIST_LE_EQ] THEN
    SIMP_TAC [SETDIST_POS_LE, ← REAL_ARITH (← q r"&0 <= x ==> (x <= &0 <=> x = &0)")] THEN
    ASM_REWRITE_TAC [SETDIST_EQ_0_SING, ← GSYM SUBSET_ANTISYM_EQ, SUBSET] THEN
    SIMP_TAC [FORALL_IN_CLOSURE_EQ, CLOSED_CLOSURE, CONTINUOUS_ON_ID])

  let HAUSDIST_COMPACT_NONTRIVIAL ← prove
   r"!s t:real^N->bool.
        compact s /\ compact t /\ ~(s = {}) /\ ~(t = {})
        ==> hausdist(s,t) =
            inf {e | &0 <= e /\
                   s SUBSET {x + y | x IN t /\ norm y <= e} /\
                   t SUBSET {x + y | x IN s /\ norm y <= e}}"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC REAL_INF_UNIQUE THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a:real^N = b + x <=> a - b = x"),
                 ← ONCE_REWRITE_RULE [CONJ_SYM] UNWIND_THM1] THEN
    REWRITE_TAC [← GSYM dist] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC REAL_HAUSDIST_LE THEN
      ASM_MESON_TAC [SETDIST_LE_DIST, DIST_SYM, REAL_LE_TRANS,
                     IN_SING, REAL_LT_IMP_LE],
      REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"hausdist(s:real^N->bool,t)") THEN
      ASM_REWRITE_TAC [HAUSDIST_POS_LE] THEN
      ASM_MESON_TAC [DIST_SYM, HAUSDIST_SYM,
                     HAUSDIST_COMPACT_EXISTS, COMPACT_IMP_BOUNDED]])

  let HAUSDIST_BALLS ← prove
   r"(!a b:real^N r s.
        hausdist(ball(a,r),ball(b,s)) =
        if r <= &0 \/ s <= &0 then &0 else dist(a,b) + abs(r - s)) /\
   (!a b:real^N r s.
        hausdist(ball(a,r),cball(b,s)) =
        if r <= &0 \/ s < &0 then &0 else dist(a,b) + abs(r - s)) /\
   (!a b:real^N r s.
        hausdist(cball(a,r),ball(b,s)) =
        if r < &0 \/ s <= &0 then &0 else dist(a,b) + abs(r - s)) /\
   (!a b:real^N r s.
        hausdist(cball(a,r),cball(b,s)) =
        if r < &0 \/ s < &0 then &0 else dist(a,b) + abs(r - s))"
   (REWRITE_TAC [← MESON []
     (← q r"(x = if p then y else z) <=> (p ==> x = y) /\ (~p ==> x = z)")] THEN
    SIMP_TAC [← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)")] THEN
    SIMP_TAC [BALL_EMPTY, CBALL_EMPTY, HAUSDIST_EMPTY, DE_MORGAN_THM] THEN
    ONCE_REWRITE_TAC [← MESON [HAUSDIST_CLOSURE]
     (← q r"hausdist(s,t) = hausdist(closure s,closure t)")] THEN
    SIMP_TAC [REAL_NOT_LE, REAL_NOT_LT, CLOSURE_BALL] THEN
    REWRITE_TAC [HAUSDIST_CLOSURE] THEN
    MATCH_MP_TAC (← TAUT (← q r"(s ==> p /\ q /\ r) /\ s ==> p /\ q /\ r /\ s")) THEN
    CONJ_TAC THENL [MESON_TAC [REAL_LT_IMP_LE], REPEAT STRIP_TAC] THEN
    ASM_SIMP_TAC [HAUSDIST_NONTRIVIAL, BOUNDED_CBALL, CBALL_EQ_EMPTY,
                  REAL_NOT_LT] THEN
    MATCH_MP_TAC SUP_UNIQUE THEN
    REWRITE_TAC [FORALL_IN_GSPEC, FORALL_IN_UNION] THEN
    REWRITE_TAC [← MESON [CBALL_SING] (← q r"{a} = cball(a:real^N,&0)")] THEN
    ASM_REWRITE_TAC [SETDIST_BALLS, REAL_LT_REFL] THEN
    X_GEN_TAC (← q r"c:real") THEN REWRITE_TAC [IN_CBALL] THEN
    EQ_TAC THENL [ALL_TAC, NORM_ARITH_TAC] THEN
    ASM_CASES_TAC (← q r"b:real^N = a") THENL
     [ASM_REWRITE_TAC [DIST_SYM, DIST_REFL, REAL_MAX_LE] THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (MP_TAC o SPEC (← q r"a + r % basis 1:real^N"))
       (MP_TAC o SPEC (← q r"a + s % basis 1:real^N"))) THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a:real^N,a + x) = norm x")] THEN
      SIMP_TAC [NORM_MUL, NORM_BASIS, LE_REFL, DIMINDEX_GE_1] THEN
      ASM_REAL_ARITH_TAC,
      DISCH_THEN (CONJUNCTS_THEN2
       (MP_TAC o SPEC (← q r"a - r / dist(a,b) % (b - a):real^N"))
       (MP_TAC o SPEC (← q r"b - s / dist(a,b) % (a - b):real^N"))) THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a:real^N,a - x) = norm x")] THEN
      REWRITE_TAC [dist, NORM_MUL, ← VECTOR_ARITH
       (← q r"b - e % (a - b) - a:real^N = (&1 + e) % (b - a)")] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_ABS_NORM] THEN
      REWRITE_TAC [← GSYM REAL_ABS_MUL] THEN REWRITE_TAC [REAL_ABS_NORM] THEN
      REWRITE_TAC [NORM_SUB, REAL_ADD_RDISTRIB, REAL_MUL_LID] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ] THEN
      ASM_REAL_ARITH_TAC])

  return { HAUSDIST_COMPACT_SUMS, HAUSDIST_SUMS_LE, HAUSDIST_SUMS_LE_LCANCEL,
           HAUSDIST_SUMS_LE_RCANCEL, HAUSDIST_EQ_0, HAUSDIST_COMPACT_NONTRIVIAL, HAUSDIST_BALLS }

/- ------------------------------------------------------------------------- -/
/- Alternative form, diameters and connected limits for Hausdorff distance.  -/
/- (topology.ml 26010-26147)                                                 -/
/- ------------------------------------------------------------------------- -/

structure HDE where
  HAUSDIST_ALT : thm
  DIAMETERS_HAUSDIST_BOUND : thm
  CONTINUOUS_DIAMETER : thm
  CONNECTED_HAUSDIST_LIMIT : thm
  deriving Inhabited

@[nospecialize]
def setupHDE [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLOC : LOC) (BCON : CON) (BLPT : LPT)
    (BCLS1 : CLS1) (BLIM2 : LIM2) (BBND1 : BND1) (BBND2 : BND2) (BBLS : BLS) (BCPT : CPT)
    (BARC : ARC) (BDIA1 : DIA1) (BDIA2 : DIA2) (BSDS : SDS) (BSD2 : SD2) (BSD3 : SD3)
    (BHDA : HDA) (BHDB : HDB) (BHDC : HDC) (BHDD : HDD) : ExceptT String IO HDE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        NORM_ARITH, .. } := D
  let { EXISTS_IN_GSPEC, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_IN_UNION, IMP_CONJ, IN_SING, .. } := D.core2
  let { IN_UNIV, LE_REFL, NOT_EXISTS_THM, NOT_INSERT_EMPTY, REAL_ADD_LID, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_TRANS, .. } := D.core4
  let { REAL_NOT_LE, REAL_SUB_RZERO, RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { SUP_EQ, UNWIND_THM2, real_abs, .. } := D.core6
  let { REAL_HALF, .. } := D.misc
  let { DIST_1, DIST_REFL, DIST_SYM, DROP_VEC, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { VECTOR_SUB_ADD2, dist, .. } := D.vec4
  let { IN_BALL_0, OPEN_BALL, .. } := BBAL
  let { CLOSED_IN_CLOSED_EQ, .. } := BLOC
  let { CONNECTED_CLOSED_IN_EQ, connected, .. } := BCON
  let { CLOSED_SING, .. } := BLPT
  let { CLOSURE_EQ_EMPTY, .. } := BCLS1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { BOUNDED_CBALL, BOUNDED_CLOSURE, BOUNDED_SUBSET, .. } := BBND1
  let { BOUNDED_SUMS, .. } := BBND2
  let { SUBSET_BALLS, .. } := BBLS
  let { COMPACT_CLOSURE, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } :=
    BCPT
  let { OPEN_SUMS, .. } := BARC
  let { DIAMETER_CBALL, DIAMETER_CLOSURE, DIAMETER_SUBSET, .. } := BDIA1
  let { DIAMETER_SUMS, .. } := BDIA2
  let { SETDIST_LE_DIST, SETDIST_POS_LT, .. } := BSDS
  let { SETDIST_CLOSURE, .. } := BSD2
  let { SETDIST_CLOSED_COMPACT, SETDIST_EQ_0_CLOSED_COMPACT, SETDIST_SING_IN_SET, .. } := BSD3
  let { HAUSDIST_CLOSURE, HAUSDIST_POS_LE, HAUSDIST_SYM, .. } := BHDA
  let { REAL_LT_HAUSDIST_POINT_EXISTS, .. } := BHDB
  let { HAUSDIST_NONTRIVIAL, .. } := BHDC
  let { HAUSDIST_COMPACT_SUMS, .. } := BHDD
  -- @@SCOPE END

  let HAUSDIST_ALT ← prove
   r"!s t:real^N->bool.
        bounded s /\ bounded t /\ ~(s = {}) /\ ~(t = {})
        ==> hausdist(s,t) =
            sup {abs(setdist({x},s) - setdist({x},t)) | x IN (:real^N)}"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM COMPACT_CLOSURE, ← GSYM (← CONJUNCT2 SETDIST_CLOSURE),
      ← GSYM CLOSURE_EQ_EMPTY, ← MESON [HAUSDIST_CLOSURE]
      (← q r"hausdist(s:real^N->bool,t) = hausdist(closure s,closure t)")] THEN
    SPEC_TAC (← q r"closure t:real^N->bool", ← q r"t:real^N->bool") THEN
    SPEC_TAC (← q r"closure s:real^N->bool", ← q r"s:real^N->bool") THEN
    REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [HAUSDIST_NONTRIVIAL, COMPACT_IMP_BOUNDED] THEN
    MATCH_MP_TAC SUP_EQ THEN
    REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_GSPEC, IN_UNIV] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"abs(y - x) <= b <=> x <= y + b /\ y <= x + b")] THEN
    GEN_TAC THEN REWRITE_TAC [FORALL_AND_THM] THEN BINOP_TAC THEN
    (EQ_TAC THENL [ALL_TAC, MESON_TAC [SETDIST_SING_IN_SET, REAL_ADD_LID]]) THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"z:real^N") THENL
     [MP_TAC (← ISPECL [← q r"{z:real^N}", ← q r"s:real^N->bool"] SETDIST_CLOSED_COMPACT),
      MP_TAC (← ISPECL [← q r"{z:real^N}", ← q r"t:real^N->bool"] SETDIST_CLOSED_COMPACT)] THEN
    ASM_REWRITE_TAC [CLOSED_SING, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [IN_SING, RIGHT_EXISTS_AND_THM, UNWIND_THM2] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") (STRIP_ASSUME_TAC o GSYM)) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN ASM_REWRITE_TAC [] THENL
     [MP_TAC (← ISPECL [← q r"{y:real^N}", ← q r"t:real^N->bool"] SETDIST_CLOSED_COMPACT),
      MP_TAC (← ISPECL [← q r"{y:real^N}", ← q r"s:real^N->bool"] SETDIST_CLOSED_COMPACT)] THEN
    ASM_REWRITE_TAC [CLOSED_SING, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [IN_SING, RIGHT_EXISTS_AND_THM, UNWIND_THM2] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N") (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    TRANS_TAC REAL_LE_TRANS (← q r"dist(z:real^N,x)") THEN
    ASM_SIMP_TAC [SETDIST_LE_DIST, IN_SING] THEN
    UNDISCH_TAC (← q r"dist(y:real^N,x) <= b") THEN CONV_TAC (fun t => NORM_ARITH t))

  let DIAMETERS_HAUSDIST_BOUND ← prove
   r"!s t:real^N->bool.
        bounded s /\ ~(s = {}) /\ bounded t /\ ~(t = {})
        ==> abs(diameter s - diameter t) <= &2 * hausdist(s,t)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM DIAMETER_CLOSURE] THEN
    MP_TAC (← ISPECL [← q r"vec 0:real^N", ← q r"hausdist(s:real^N->bool,t)"]
      DIAMETER_CBALL) THEN
    ASM_SIMP_TAC [HAUSDIST_POS_LE, ← GSYM REAL_NOT_LE] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"x <= y + e /\ y <= x + e ==> abs(x - y) <= e")) THEN
    CONJ_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand) DIAMETER_SUMS o rand o snd) THEN
    ASM_SIMP_TAC [BOUNDED_CBALL, BOUNDED_CLOSURE] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC DIAMETER_SUBSET THEN
    ASM_SIMP_TAC [BOUNDED_SUMS, BOUNDED_CBALL, BOUNDED_CLOSURE] THEN
    ONCE_REWRITE_TAC [← MESON [HAUSDIST_CLOSURE]
     (← q r"hausdist(s:real^N->bool,t) = hausdist(closure s,closure t)")]
    THENL [ALL_TAC, ONCE_REWRITE_TAC [HAUSDIST_SYM]] THEN
    MATCH_MP_TAC HAUSDIST_COMPACT_SUMS THEN
    ASM_SIMP_TAC [COMPACT_CLOSURE, BOUNDED_CLOSURE, CLOSURE_EQ_EMPTY])

  let CONTINUOUS_DIAMETER ← prove
   r"!s:real^N->bool e.
        bounded s /\ ~(s = {}) /\ &0 < e
        ==> ?d. &0 < d /\
                !t. bounded t /\ ~(t = {}) /\ hausdist(s,t) < d
                    ==> abs(diameter s - diameter t) < e"
   (REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"e / &2") THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN REPEAT STRIP_TAC THEN
    TRANS_TAC REAL_LET_TRANS (← q r"&2 * hausdist(s:real^N->bool,t)") THEN
    ASM_SIMP_TAC [DIAMETERS_HAUSDIST_BOUND] THEN ASM_REAL_ARITH_TAC)

  let CONNECTED_HAUSDIST_LIMIT ← prove
   r"!s k:real^N->bool.
        (!n. bounded(s n) /\ connected(s n) /\ ~(s n = {})) /\
        compact k /\ ((\n. lift (hausdist(s n,k))) --> vec 0) sequentially
        ==> connected k"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [CONNECTED_CLOSED_IN_EQ] THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSED_EQ, COMPACT_IMP_CLOSED, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"k1:real^N->bool", ← q r"k2:real^N->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"compact(k1:real^N->bool) /\ compact(k2:real^N->bool)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"e = setdist(k1:real^N->bool,k2)") THEN
    SUBGOAL_THEN (← q r"&0 < e") ASSUME_TAC THENL
     [EXPAND_TAC "e" THEN REWRITE_TAC [SETDIST_POS_LT] THEN
      ASM_SIMP_TAC [SETDIST_EQ_0_CLOSED_COMPACT, COMPACT_IMP_CLOSED],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
    REWRITE_TAC [LE_REFL, DIST_1, DROP_VEC, LIFT_DROP, REAL_SUB_RZERO] THEN
    REWRITE_TAC [real_abs, HAUSDIST_POS_LE] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o CONJUNCT2 o SPEC (← q r"n:num")) THEN
    REWRITE_TAC [connected] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{x + y:real^N | x IN k1 /\ y IN ball(vec 0,e / &2)}",
      ← q r"{x + y:real^N | x IN k2 /\ y IN ball(vec 0,e / &2)}"] THEN
    SIMP_TAC [OPEN_SUMS, OPEN_BALL] THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [← SET_RULE
       (← q r"{f x y | x IN s /\ y IN t} UNION {f x y | x IN s' /\ y IN t} =
        {f x y | x IN s UNION s' /\  y IN t}")] THEN
      MP_TAC (← ISPECL [← q r"(s:num->real^N->bool) n", ← q r"k:real^N->bool"]
       HAUSDIST_COMPACT_SUMS) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"t SUBSET u
        ==> s SUBSET {f x y | x IN k /\ y IN t}
            ==> s SUBSET {f x y | x IN k /\ y IN u}")) THEN
      REWRITE_TAC [SUBSET_BALLS, DIST_REFL] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
        (← q r"(!x y a b. (x IN s /\ y IN t) /\ a IN u /\ b IN u ==> ~(f x a = f y b))
         ==> {f x a | x IN s /\ a IN u} INTER {f x a | x IN t /\ a IN u}
             INTER v = {}")) THEN
      REPEAT GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [IN_BALL_0] THEN MATCH_MP_TAC (← NORM_ARITH
       (← q r"e <= dist(x:real^N,y)
        ==> norm a < e / &2 /\ norm b < e / &2 ==> ~(x + a = y + b)")) THEN
      ASM_MESON_TAC [SETDIST_LE_DIST],
      ALL_TAC] THEN
    CONJ_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"~(s INTER t = {}) <=> ?x. x IN s /\ x IN t")] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, IN_BALL_0] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"~(k = {})
      ==> (!x. x IN k ==> ?y. R x y /\ P y)
          ==> ?x y. (x IN k /\ P y) /\ R x y"))) THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← MESON [] (← q r"!x:real^N. (?y. P(y - x)) ==> ?y. P y")) THEN
    EXISTS_TAC (← q r"x:real^N") THEN REWRITE_TAC [VECTOR_SUB_ADD2] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM dist)] THEN
    MATCH_MP_TAC REAL_LT_HAUSDIST_POINT_EXISTS THEN
    EXISTS_TAC (← q r"k:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [HAUSDIST_SYM] THEN ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN
    ASM SET_TAC [])

  return { HAUSDIST_ALT, DIAMETERS_HAUSDIST_BOUND, CONTINUOUS_DIAMETER, CONNECTED_HAUSDIST_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Hausdorff limit of a decreasing nest of compact sets.                     -/
/- (topology.ml 26148-26226)                                                 -/
/- ------------------------------------------------------------------------- -/

structure HDF where
  HAUSDIST_COMPACT_INTERS_LIMIT : thm
  deriving Inhabited

@[nospecialize]
def setupHDF [HolBase] (D : TopologyDeps) (BLIM2 : LIM2) (BCPT : CPT) (BNST : NST) (BSDS : SDS)
    (BSD3 : SD3) (BHDA : HDA) (BHDB : HDB) : ExceptT String IO HDF := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } :=
    D
  let { DEPENDENT_CHOICE, .. } := D.core1
  let { FORALL_AND_THM, INTERS_GSPEC, IN_ELIM_THM, IN_SING, .. } := D.core2
  let { IN_UNIV, LE_0, LE_REFL, LE_TRANS, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, .. } :=
    D.core3
  let { REAL_LE_TOTAL, REAL_LE_TRANS, .. } := D.core4
  let { REAL_NOT_LT, SKOLEM_THM, SUBSET, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LE, TRANSITIVE_STEPWISE_LT, o_THM, real_abs, .. } := D.core6
  let { MONOTONE_BIGGER, .. } := D.misc
  let { DIST_0, DIST_SYM, .. } := D.vec1
  let { LIFT_NUM, .. } := D.vec2
  let { NORM_LIFT, .. } := D.vec3
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { LIM_EVENTUALLY, LIM_SEQUENTIALLY, .. } := BLIM2
  let { COMPACT_IMP_CLOSED, compact, .. } := BCPT
  let { COMPACT_NEST, .. } := BNST
  let { SETDIST_LE_DIST, SETDIST_POS_LT, .. } := BSDS
  let { SETDIST_EQ_0_CLOSED, SETDIST_SING_IN_SET, .. } := BSD3
  let { HAUSDIST_EMPTY, HAUSDIST_POS_LE, .. } := BHDA
  let { REAL_HAUSDIST_LE, .. } := BHDB
  -- @@SCOPE END

  let HAUSDIST_COMPACT_INTERS_LIMIT ← prove
   r"!s:num->(real^N->bool).
        (!n. compact(s n)) /\ (!n. s(SUC n) SUBSET s n)
        ==> ((\n. lift(hausdist(s n,INTERS {s i | i IN (:num)}))) --> vec 0)
            sequentially"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!m n. m <= n ==> (s:num->real^N->bool) n SUBSET s m")
    ASSUME_TAC THENL
     [MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM_REWRITE_TAC [] THEN SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"?n. (s:num->real^N->bool) n = {}") THENL
     [FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"N:num")) THEN
      MATCH_MP_TAC LIM_EVENTUALLY THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      EXISTS_TAC (← q r"N:num") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(s:num->real^N->bool) n = {}") SUBST1_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [HAUSDIST_EMPTY, LIFT_NUM]],
      RULE_ASSUM_TAC (REWRITE_RULE [NOT_EXISTS_THM])] THEN
    REWRITE_TAC [LIM_SEQUENTIALLY] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?r:num->num.
          (!n. e <= hausdist(s(r n):real^N->bool,INTERS {s i | i IN (:num)})) /\
          (!n. r n < r (SUC n))")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONJ_TAC THENL
       [ALL_TAC, REWRITE_TAC [] THEN X_GEN_TAC (← q r"n:num") THEN REPEAT STRIP_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"n + 1")) THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"m:num") THEN REWRITE_TAC [DIST_0, NORM_LIFT] THEN
      SIMP_TAC [real_abs, HAUSDIST_POS_LE, REAL_NOT_LT] THEN ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n:num. ?x:real^N.
          x IN s(r n) /\ e / &2 <= setdist({x},INTERS {s i | i IN (:num)})")
    MP_TAC THENL
     [GEN_TAC THEN
      MP_TAC (← ISPECL [← q r"(s:num->real^N->bool)(r(n:num))",
                        ← q r"INTERS {s i | i IN (:num)}:real^N->bool", ← q r"e / &2"]
         REAL_HAUSDIST_LE) THEN
      ASM_SIMP_TAC [COMPACT_NEST] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e /\ e <= x ==> ~(x <= e / &2)")] THEN
      REWRITE_TAC [← TAUT (← q r"~(p /\ q) <=> q ==> ~p")] THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC [REAL_LE_TOTAL]] THEN
      SIMP_TAC [SETDIST_SING_IN_SET, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:num->real^N") STRIP_ASSUME_TAC)] THEN
    MP_TAC (← ISPEC (← q r"s 0:real^N->bool") compact) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real^N")) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SUBSET, LE_0], REWRITE_TAC [NOT_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"y:real^N", ← q r"k:num->num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN REWRITE_TAC [NOT_IMP] THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
    REWRITE_TAC [LE_REFL, REAL_NOT_LT, o_THM] THEN TRANS_TAC REAL_LE_TRANS
     (← q r"setdist({(x:num->real^N)(k(n:num))}, INTERS {s i | i IN (:num)})") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SETDIST_LE_DIST THEN
    REWRITE_TAC [IN_SING, INTERS_GSPEC, IN_UNIV, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"n:num") THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"setdist({y},(s:num->real^N->bool) n)")) THEN
    ASM_SIMP_TAC [SETDIST_POS_LT, SETDIST_EQ_0_CLOSED, COMPACT_IMP_CLOSED] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") (MP_TAC o SPEC (← q r"MAX N n"))) THEN
    REWRITE_TAC [o_THM, NOT_IMP, REAL_NOT_LT] THEN
    CONJ_TAC THENL [ARITH_TAC, ONCE_REWRITE_TAC [DIST_SYM]] THEN
    MATCH_MP_TAC SETDIST_LE_DIST THEN REWRITE_TAC [IN_SING] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!t. x IN t /\ t SUBSET s ==> x IN s")) THEN
    EXISTS_TAC (← q r"(s:num->real^N->bool)((r:num->num)(k(MAX N n)))") THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    TRANS_TAC LE_TRANS (← q r"MAX N n") THEN CONJ_TAC THENL [ARITH_TAC, ALL_TAC] THEN
    SPEC_TAC (← q r"MAX N n", ← q r"m:num") THEN X_GEN_TAC (← q r"m:num") THEN
    TRANS_TAC LE_TRANS (← q r"(k:num->num) m") THEN ASM_SIMP_TAC [MONOTONE_BIGGER] THEN
    SPEC_TAC (← q r"(k:num->num) m", ← q r"p:num") THEN MATCH_MP_TAC MONOTONE_BIGGER THEN
    MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN ASM_REWRITE_TAC [] THEN ARITH_TAC)

  return { HAUSDIST_COMPACT_INTERS_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Hausdorff metric inherits completeness, total boundedness, compactness.   -/
/- (topology.ml 26227-26475)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CHU where
  COMPLETE_HAUSDIST_UNIV : thm
  deriving Inhabited

@[nospecialize]
def setupCHU [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCLS1 : CLS1) (BLIM2 : LIM2) (BARI : ARI)
    (BUNQ : UNQ) (BTRN : TRN) (BBND1 : BND1) (BBND2 : BND2) (BCPT : CPT) (BCMP : CMP)
    (BCMT : CMT) (BRAT : RAT) (BCSM : CSM) (BHDA : HDA) (BHDB : HDB) (BHDC : HDC) :
    ExceptT String IO CHU := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH,
        SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { ADD1, ADD_CLAUSES, CONJ_SYM, DEPENDENT_CHOICE, DEPENDENT_CHOICE_FIXED, FINITE_NUMSEG, .. } :=
    D.core1
  let { GE, IMP_CONJ_ALT, IN_ELIM_THM, .. } := D.core2
  let { LE_REFL, LE_TRANS, LT_IMP_LE, LT_TRANS, MONO_EXISTS, .. } := D.core3
  let { REAL_ARCH_POW_INV, REAL_INV_POW, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_REFL,
        REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_POW2, .. } := D.core4
  let { REAL_LT_TRANS, REAL_POS, REAL_POW_DIV, REAL_POW_INV, REAL_POW_LE, REAL_POW_MONO,
        REAL_POW_ONE, SKOLEM_THM, SUBSET, SUB_0, SUB_REFL, .. } := D.core5
  let { SUM_LE_NUMSEG, TRANSITIVE_STEPWISE_LE, TRANSITIVE_STEPWISE_LT, UNWIND_THM2, o_DEF, o_THM,
        real_div, .. } := D.core6
  let { MONOTONE_BIGGER, REAL_HALF, SUM_GP, .. } := D.misc
  let { DIST_0, DIST_LIFT, DIST_REFL, DIST_SYM, .. } := D.vec1
  let { NORM_LIFT, REAL_ABS_DIST, .. } := D.vec3
  let { VSUM_DIFFS_ALT, VSUM_NORM_TRIANGLE, dist, .. } := D.vec4
  let { ALWAYS_EVENTUALLY, .. } := D.met1
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { IN_CBALL_0, .. } := BBAL
  let { CLOSURE_EQ_EMPTY, .. } := BCLS1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { LIM_CONST, LIM_NULL_COMPARISON, LIM_SUB, .. } := BARI
  let { LIM_NORM_UBOUND, .. } := BUNQ
  let { LIM_TRANSFORM, .. } := BTRN
  let { BOUNDED_CBALL, BOUNDED_SUBSET, .. } := BBND1
  let { BOUNDED_SUMS, .. } := BBND2
  let { COMPACT_CLOSURE, .. } := BCPT
  let { CONVERGENT_EQ_CAUCHY, .. } := BCMP
  let { SUMMABLE_COMPARISON, .. } := BCMT
  let { SUMMABLE_REAL_GP, .. } := BRAT
  let { ABSOLUTELY_SUMMABLE_IMP_CAUCHY, .. } := BCSM
  let { HAUSDIST_CLOSURE, HAUSDIST_SYM, REAL_ABS_HAUSDIST, .. } := BHDA
  let { REAL_HAUSDIST_LE_SUMS, REAL_LT_HAUSDIST_POINT_EXISTS, .. } := BHDB
  let { HAUSDIST_TRIANGLE, .. } := BHDC
  -- @@SCOPE END

  let COMPLETE_HAUSDIST_UNIV ← prove
   r"!f:num->(real^N->bool).
        (!n. bounded(f n) /\ ~(f n = {})) /\
        (!e. &0 < e
             ==> ?N. !m n. m >= N /\ n >= N ==> hausdist(f m,f n) < e)
        ==> ?s. compact s /\ ~(s = {}) /\
                ((\n. lift(hausdist(f n,s))) --> vec 0) sequentially"
   (SUBGOAL_THEN
     (← q r"!f:num->(real^N->bool).
          (!n. bounded(f n) /\ ~(f n = {})) /\
          (!m n. m <= n ==> hausdist(f m,f n) < inv(&2 pow m))
          ==> ?s. bounded s /\ ~(s = {}) /\
                  ((\n. lift(hausdist(f n,s))) --> vec 0) sequentially")
    ASSUME_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← MESON [] (← q r"(?s. P(closure s)) ==> ?s. P s")) THEN
      REWRITE_TAC [COMPACT_CLOSURE, HAUSDIST_CLOSURE, CLOSURE_EQ_EMPTY] THEN
      FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&2 pow n)")) THEN
      SIMP_TAC [REAL_LT_INV_EQ, REAL_LT_POW2, SKOLEM_THM] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"N:num->num")) THEN
      SUBGOAL_THEN
       (← q r"?r:num->num.
            (!n. N n <= r n) /\ (!n. r(n) < r(SUC n))")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC DEPENDENT_CHOICE THEN
        REWRITE_TAC [← ARITH_RULE (← q r"a <= x /\ b < x <=> MAX a (SUC b) <= x")] THEN
        MESON_TAC [LE_REFL],
        FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"(f:num->(real^N->bool)) o (r:num->num)")) THEN
        ASM_REWRITE_TAC [o_THM] THEN ANTS_TAC THENL
         [MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN DISCH_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [GE] THEN
          SUBGOAL_THEN (← q r"!i j. i <= j ==> (r:num->num) i <= r j")
           (fun th => ASM_MESON_TAC [LE_TRANS, th]) THEN
          MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
          ASM_SIMP_TAC [LT_IMP_LE] THEN ARITH_TAC,
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
          STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] LIM_TRANSFORM)) THEN
          MATCH_MP_TAC LIM_NULL_COMPARISON THEN
          EXISTS_TAC (← q r"\n. hausdist((f:num->(real^N->bool)) n,f(r n))") THEN
          REWRITE_TAC [] THEN CONJ_TAC THENL
           [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"n:num") THEN
            REWRITE_TAC [← GSYM dist, DIST_LIFT] THEN
            REWRITE_TAC [← REAL_ARITH
              (← q r"abs(x - y) <= z <=> x <= z + y /\ y <= z + x")] THEN
            CONJ_TAC THENL
             [GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [HAUSDIST_SYM],
              ALL_TAC] THEN
            MATCH_MP_TAC HAUSDIST_TRIANGLE THEN ASM_REWRITE_TAC [],
            REWRITE_TAC [LIM_SEQUENTIALLY, DIST_0] THEN
            REWRITE_TAC [NORM_LIFT, REAL_ABS_HAUSDIST] THEN
            X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
            MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
            ASM_REWRITE_TAC [REAL_POW_INV] THEN
            CONV_TAC REAL_RAT_REDUCE_CONV THEN
            DISCH_THEN (X_CHOOSE_TAC (← q r"M:num")) THEN
            EXISTS_TAC (← q r"(N:num->num) M") THEN
            X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
            TRANS_TAC REAL_LT_TRANS (← q r"inv(&2 pow M)") THEN
            ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
            MATCH_MP_TAC (← ARITH_RULE
             (← q r"a:num <= n /\ n <= r ==> n >= a /\ r >= a")) THEN
            ASM_REWRITE_TAC [] THEN SPEC_TAC (← q r"n:num", ← q r"n:num") THEN
            MATCH_MP_TAC MONOTONE_BIGGER THEN
            MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN
            ASM_REWRITE_TAC [LT_TRANS]]]]] THEN
    REPEAT STRIP_TAC THEN ABBREV_TAC
     (← q r"s:real^N->bool =
      {l | ?x:num->real^N.
                  (!n. x n IN f n) /\
                  (!n. dist(x n,x(SUC n)) < inv(&2 pow n)) /\
                  (x --> l) sequentially}") THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN
    SUBGOAL_THEN
     (← q r"!n. f n SUBSET {x + y:real^N | x IN s /\ y IN cball(vec 0,&2 / &2 pow n)}")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"?x. x k:real^N = a /\
            (!n. x n IN f n) /\
            (!n. dist(x n,x (SUC n)) < inv(&2 pow n))")
      STRIP_ASSUME_TAC THENL
       [SUBGOAL_THEN
         (← q r"?y. y 0 = a /\
              (!n. y n IN f(k + n)) /\
              (!n. dist(y n:real^N,y(SUC n)) < inv(&2 pow (k + n)))")
        STRIP_ASSUME_TAC THENL
         [MATCH_MP_TAC DEPENDENT_CHOICE_FIXED THEN
          ASM_REWRITE_TAC [ADD_CLAUSES] THEN
          MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^N"] THEN DISCH_TAC THEN
          MATCH_MP_TAC REAL_LT_HAUSDIST_POINT_EXISTS THEN
          EXISTS_TAC (← q r"(f:num->(real^N->bool)) (k + n)") THEN
          ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC,
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"?z. z 0 = a /\
              (!n. z n IN f(k - n)) /\
              (!n. dist(z n:real^N,z(SUC n)) < inv(&2 pow (k - SUC n)))")
        STRIP_ASSUME_TAC THENL
         [MATCH_MP_TAC DEPENDENT_CHOICE_FIXED THEN ASM_REWRITE_TAC [SUB_0] THEN
          MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^N"] THEN DISCH_TAC THEN
          ASM_CASES_TAC (← q r"k:num <= n") THENL
           [EXISTS_TAC (← q r"x:real^N") THEN
            ASM_REWRITE_TAC [DIST_REFL, REAL_LT_INV_EQ, REAL_LT_POW2] THEN
            ASM_MESON_TAC [← ARITH_RULE (← q r"k <= n ==> k - SUC n = k - n")],
            MATCH_MP_TAC REAL_LT_HAUSDIST_POINT_EXISTS THEN
            EXISTS_TAC (← q r"(f:num->(real^N->bool)) (k - n)") THEN
            ASM_REWRITE_TAC [] THEN
            ONCE_REWRITE_TAC [HAUSDIST_SYM] THEN
            FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC],
          ALL_TAC] THEN
        EXISTS_TAC
         (← q r"\n. if k <= n then (y:num->real^N)(n - k) else z(k - n)") THEN
        ASM_REWRITE_TAC [LE_REFL, SUB_REFL] THEN
        CONJ_TAC THEN X_GEN_TAC (← q r"n:num") THENL
         [ASM_MESON_TAC [← ARITH_RULE
           (← q r"(k:num <= n ==> k + (n - k) = n) /\
            (~(k <= n) ==> k - (k - n) = n)")],
          ALL_TAC] THEN
        ASM_CASES_TAC (← q r"SUC n = k") THEN ASM_REWRITE_TAC [LE_REFL] THENL
         [ASM_SIMP_TAC [← ARITH_RULE (← q r"SUC n = k ==> ~(k <= n)"), SUB_REFL] THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"SUC n = k ==> k - n = SUC 0")] THEN
          SUBST1_TAC (← SYM (← ASSUME (← q r"(z:num->real^N) 0 = a"))) THEN
          ONCE_REWRITE_TAC [DIST_SYM] THEN
          FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← ARITH_RULE
           (← q r"SUC n = k ==> n = k - SUC 0"))) THEN
          ASM_REWRITE_TAC [],
          SUBGOAL_THEN (← q r"k <= SUC n <=> k <= n") SUBST1_TAC THENL
           [ASM_ARITH_TAC, ALL_TAC]] THEN
         COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
          [ASM_SIMP_TAC [← ARITH_RULE (← q r"k <= n ==> SUC n - k = SUC(n - k)")] THEN
           ASM_MESON_TAC [← ARITH_RULE (← q r"k:num <= n ==> k + n - k = n")],
           ASM_SIMP_TAC [← ARITH_RULE (← q r"~(k <= n) ==> k - n = SUC(k - SUC n)")] THEN
           ONCE_REWRITE_TAC [DIST_SYM] THEN
           ASM_MESON_TAC [← ARITH_RULE (← q r"~(k <= n) ==> k - SUC(k - SUC n) = n")]],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"cauchy(x:num->real^N)") MP_TAC THENL
       [MATCH_MP_TAC ABSOLUTELY_SUMMABLE_IMP_CAUCHY THEN
        REWRITE_TAC [← GSYM ADD1] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
        MATCH_MP_TAC SUMMABLE_COMPARISON THEN
        EXISTS_TAC (← q r"\n. inv(&2 pow n)") THEN
        ASM_SIMP_TAC [NORM_LIFT, REAL_ABS_DIST, REAL_LT_IMP_LE] THEN
        REWRITE_TAC [REAL_INV_POW, o_DEF] THEN
        MATCH_MP_TAC SUMMABLE_REAL_GP THEN CONV_TAC REAL_RAT_REDUCE_CONV,
        REWRITE_TAC [← GSYM CONVERGENT_EQ_CAUCHY]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:real^N") THEN DISCH_TAC THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"l:real^N = x + y <=> y = l - x")] THEN
      REWRITE_TAC [UNWIND_THM2] THEN ASM_REWRITE_TAC [IN_CBALL_0] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN
      EXISTS_TAC (← q r"\n. a - (x:num->real^N) n") THEN
      ASM_SIMP_TAC [LIM_SUB, TRIVIAL_LIMIT_SEQUENTIALLY, LIM_CONST] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      EXISTS_TAC (← q r"k + 1") THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
      SUBST1_TAC (← SYM (← ASSUME (← q r"(x:num->real^N) k = a"))) THEN
      TRANS_TAC REAL_LE_TRANS
        (← q r"norm(vsum (k..m - 1) (\i. (x:num->real^N)(i + 1) - x i))") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [VSUM_DIFFS_ALT] THEN FIRST_ASSUM (fun th => tactic_of do
          pure (REWRITE_TAC [← MATCH_MP
           (← ARITH_RULE (← q r"k + 1 <= m ==> m - 1 + 1 = m /\ k <= m - 1")) th])) THEN
        CONV_TAC (fun t => NORM_ARITH t),
        MATCH_MP_TAC VSUM_NORM_TRIANGLE THEN REWRITE_TAC [FINITE_NUMSEG]] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM dist)] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"sum (k..m-1) (\i. inv(&2 pow i))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE_NUMSEG THEN
        ASM_SIMP_TAC [← GSYM ADD1, REAL_LT_IMP_LE],
        ALL_TAC] THEN
      REWRITE_TAC [REAL_INV_POW, SUM_GP] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      COND_CASES_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"x <= inv y ==> x / (&1 / &2) <= &2 / y")) THEN
      REWRITE_TAC [REAL_POW_DIV, REAL_POW_ONE] THEN REWRITE_TAC [real_div] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x ==> &1 * y - &1 * x <= y")) THEN
      REWRITE_TAC [REAL_LE_INV_EQ] THEN MATCH_MP_TAC REAL_POW_LE THEN
      REWRITE_TAC [REAL_POS],
      ALL_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p /\ r) ==> p /\ q /\ r")) THEN CONJ_TAC THENL
     [ASM SET_TAC [], DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n. s SUBSET {x + y:real^N | x IN f n /\ y IN cball(vec 0,&2 / &2 pow n)}")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "s" THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"l:real^N") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:num->real^N") STRIP_ASSUME_TAC) THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"l:real^N = x + y <=> y = l - x")] THEN
      REWRITE_TAC [UNWIND_THM2] THEN EXISTS_TAC (← q r"(x:num->real^N) n") THEN
      ASM_REWRITE_TAC [IN_CBALL_0] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN
      EXISTS_TAC (← q r"\m. (x:num->real^N) m - x n") THEN
      ASM_SIMP_TAC [LIM_SUB, TRIVIAL_LIMIT_SEQUENTIALLY, LIM_CONST] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      EXISTS_TAC (← q r"n + 1") THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
      TRANS_TAC REAL_LE_TRANS
        (← q r"norm(vsum (n..m - 1) (\i. (x:num->real^N)(i + 1) - x i))") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [VSUM_DIFFS_ALT] THEN FIRST_ASSUM (fun th => tactic_of do
          pure (REWRITE_TAC [← MATCH_MP
           (← ARITH_RULE (← q r"n + 1 <= m ==> m - 1 + 1 = m /\ n <= m - 1")) th])) THEN
        REWRITE_TAC [REAL_LE_REFL],
        MATCH_MP_TAC VSUM_NORM_TRIANGLE THEN REWRITE_TAC [FINITE_NUMSEG]] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM dist)] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"sum (n..m-1) (\i. inv(&2 pow i))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE_NUMSEG THEN
        ASM_SIMP_TAC [← GSYM ADD1, REAL_LT_IMP_LE],
        ALL_TAC] THEN
      REWRITE_TAC [REAL_INV_POW, SUM_GP] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      COND_CASES_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"x <= inv y ==> x / (&1 / &2) <= &2 / y")) THEN
      REWRITE_TAC [REAL_POW_DIV, REAL_POW_ONE] THEN REWRITE_TAC [real_div] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x ==> &1 * y - &1 * x <= y")) THEN
      REWRITE_TAC [REAL_LE_INV_EQ] THEN MATCH_MP_TAC REAL_POW_LE THEN
      REWRITE_TAC [REAL_POS],
      ALL_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"{x + y:real^N | x IN f n /\
                                  y IN cball(vec 0,&2 / &2 pow n)}") THEN
      ASM_SIMP_TAC [BOUNDED_SUMS, BOUNDED_CBALL],
      DISCH_TAC] THEN
    REWRITE_TAC [LIM_SEQUENTIALLY, DIST_0, NORM_LIFT, REAL_ABS_HAUSDIST] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e / &2"] REAL_ARCH_POW_INV) THEN
    ASM_REWRITE_TAC [REAL_POW_INV, REAL_HALF] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
      (← q r"inv i < e / &2 ==> x <= &2 / i ==> x < e"))) THEN
    TRANS_TAC REAL_LE_TRANS (← q r"&2 / &2 pow m") THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_HAUSDIST_LE_SUMS THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [← REAL_ARITH (← q r"&2 / x <= &2 / y <=> inv x <= inv y")] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN REWRITE_TAC [REAL_LT_POW2] THEN
      MATCH_MP_TAC REAL_POW_MONO THEN ASM_REWRITE_TAC [] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV])

  return { COMPLETE_HAUSDIST_UNIV }

/- ------------------------------------------------------------------------- -/
/- Completeness in a closed set; total boundedness.  (topology.ml 26476-26597) -/
/- ------------------------------------------------------------------------- -/

structure CHT where
  COMPLETE_HAUSDIST : thm
  TOTALLY_BOUNDED_HAUSDIST : thm
  deriving Inhabited

@[nospecialize]
def setupCHT [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCLS1 : CLS1) (BLIM2 : LIM2) (BCPT : CPT)
    (BHDA : HDA) (BHDB : HDB) (BCHU : CHU) : ExceptT String IO CHT := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH,
        NORM_ARITH, .. } := D
  let { CONJ_ASSOC, CONJ_SYM, EMPTY_UNIONS, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, FINITE_DELETE,
        FINITE_IMAGE, .. } := D.core1
  let { FINITE_POWERSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMP_CONJ, INTER_SUBSET, IN_DELETE,
        IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, .. } := D.core3
  let { REAL_LE_DIV, REAL_LT_IMP_LE, .. } := D.core4
  let { REAL_POS, RIGHT_EXISTS_AND_THM, SIMPLE_IMAGE_GEN, SUBSET, SUBSET_RESTRICT, .. } := D.core5
  let { UNIONS_IMAGE, UNWIND_THM1, .. } := D.core6
  let { DIST_0, DIST_SYM, .. } := D.vec1
  let { NORM_LIFT, .. } := D.vec3
  let { VECTOR_ADD_RID, VECTOR_SUB_ADD2, dist, .. } := D.vec4
  let { BALL_EQ_EMPTY, CENTRE_IN_CBALL, IN_BALL, IN_BALL_0, IN_CBALL_0, .. } := BBAL
  let { CLOSURE_APPROACHABLE, CLOSURE_CLOSED, CLOSURE_EQ_EMPTY, CLOSURE_SUBSET, .. } := BCLS1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { COMPACT_CLOSURE, COMPACT_IMP_BOUNDED, COMPACT_IMP_TOTALLY_BOUNDED, .. } := BCPT
  let { HAUSDIST_EMPTY, HAUSDIST_SYM, REAL_ABS_HAUSDIST, .. } := BHDA
  let { REAL_HAUSDIST_LE_SUMS, REAL_LT_HAUSDIST_POINT_EXISTS, .. } := BHDB
  let { COMPLETE_HAUSDIST_UNIV, .. } := BCHU
  -- @@SCOPE END

  let COMPLETE_HAUSDIST ← prove
   r"!f:num->(real^N->bool) c.
        closed c /\
        (!n. bounded(f n) /\ ~(f n = {}) /\ f n SUBSET c) /\
        (!e. &0 < e
             ==> ?N. !m n. m >= N /\ n >= N ==> hausdist(f m,f n) < e)
        ==> ?s. compact s /\ ~(s = {}) /\ s SUBSET c /\
                ((\n. lift(hausdist(f n,s))) --> vec 0) sequentially"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"f:num->(real^N->bool)") COMPLETE_HAUSDIST_UNIV) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP CLOSURE_CLOSED) THEN
    REWRITE_TAC [SUBSET, CLOSURE_APPROACHABLE] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
    REWRITE_TAC [LE_REFL, DIST_0, NORM_LIFT, REAL_ABS_HAUSDIST] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?y. y IN (f:num->(real^N->bool)) n /\ dist(y,x) < e")
    MP_TAC THENL [ONCE_REWRITE_TAC [DIST_SYM], ASM SET_TAC []] THEN
    MATCH_MP_TAC REAL_LT_HAUSDIST_POINT_EXISTS THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN
    ASM_MESON_TAC [HAUSDIST_SYM])

  let TOTALLY_BOUNDED_HAUSDIST ← prove
   r"!s:real^N->bool e.
        bounded s /\ &0 < e
        ==> ?k. FINITE k /\
                (!u. u IN k ==> ~(u = {}) /\ u SUBSET s) /\
                (!t. t SUBSET s /\ ~(t = {})
                     ==> ?u. u IN k /\ hausdist(t,u) < e)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"closure s:real^N->bool") COMPACT_IMP_TOTALLY_BOUNDED) THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^N->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC
     (← q r"{s INTER {x + y:real^N | x IN c /\ y IN ball(vec 0,e / &4)} | c SUBSET k}
      DELETE {}") THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_DELETE, IMP_CONJ, INTER_SUBSET] THEN
    REWRITE_TAC [FINITE_DELETE, ← GSYM CONJ_ASSOC] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    ASM_SIMP_TAC [FINITE_POWERSET, FINITE_IMAGE, EXISTS_IN_IMAGE] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    REPEAT DISCH_TAC THEN
    EXISTS_TAC (← q r"{x:real^N | x IN k /\ ~(ball(x,e / &4) INTER t = {})}") THEN
    REWRITE_TAC [SUBSET_RESTRICT, IN_ELIM_THM] THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← SET_RULE
       (← q r"~(s INTER t = {}) <=> ?x. x IN t /\ x IN s")] THEN
      REWRITE_TAC [EXISTS_IN_GSPEC] THEN
      SUBGOAL_THEN (← q r"?x:real^N. x IN t") STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o MATCH_MP (← SET_RULE
       (← q r"closure s SUBSET u
        ==> !x. x IN t /\ t SUBSET s /\ s SUBSET closure s ==> x IN u"))) THEN
      ASM_REWRITE_TAC [CLOSURE_SUBSET, UNIONS_IMAGE, IN_ELIM_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM] THEN
      CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_BALL_0]] THEN
      SUBGOAL_THEN (← q r"(y:real^N) IN closure s") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [CLOSURE_APPROACHABLE]] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"z - y:real^N") THEN ASM_REWRITE_TAC [← GSYM dist, VECTOR_SUB_ADD2],
      ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
    ASM_REWRITE_TAC [] THEN ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [HAUSDIST_EMPTY, REAL_LE_DIV, REAL_POS, REAL_LT_IMP_LE] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
      (← q r"closure s SUBSET t ==> ~(closure s = {}) ==> ~(t = {})"))) THEN
    ASM_REWRITE_TAC [CLOSURE_EQ_EMPTY, EMPTY_UNIONS, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [BALL_EQ_EMPTY, ← REAL_ARITH (← q r"&0 < e ==> ~(e / &4 <= &0)")] THEN
    REWRITE_TAC [NOT_FORALL_THM, MEMBER_NOT_EMPTY] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_HAUSDIST_LE_SUMS THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← SET_RULE
       (← q r"~(s INTER t = {}) <=> ?x. x IN t /\ x IN s")] THEN
      REWRITE_TAC [EXISTS_IN_GSPEC] THEN
      SUBGOAL_THEN (← q r"?x:real^N. x IN t") STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC],
      REWRITE_TAC [SUBSET, IN_INTER, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
          MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"vec 0:real^N"] THEN
      REWRITE_TAC [VECTOR_ADD_RID, CENTRE_IN_CBALL, ← GSYM CONJ_ASSOC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC],
      REWRITE_TAC [← SET_RULE
       (← q r"s INTER t SUBSET u <=> !x. x IN t ==> x IN s ==> x IN u")] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_BALL, DIST_0] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(s INTER t = {}) ==> ?x. x IN t /\ x IN s"))) THEN
      REWRITE_TAC [IN_CBALL_0, IN_BALL] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^N") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = z + w <=> x - z = w")] THEN
      REWRITE_TAC [UNWIND_THM1] THEN
      MAP_EVERY UNDISCH_TAC
       [← q r"norm(y:real^N) < e / &4", ← q r"dist(x:real^N,z) < e / &4"] THEN
      CONV_TAC (fun t => NORM_ARITH t)] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o MATCH_MP (← SET_RULE
     (← q r"closure s SUBSET u
      ==> !x. x IN t /\ t SUBSET s /\ s SUBSET closure s ==> x IN u"))) THEN
    ASM_REWRITE_TAC [CLOSURE_SUBSET, UNIONS_IMAGE, IN_ELIM_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [IN_BALL] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"x - y:real^N") THEN REWRITE_TAC [VECTOR_SUB_ADD2] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_BALL, DIST_0] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN ASM_SIMP_TAC [] THEN
    ASM_REWRITE_TAC [IN_BALL, ← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM dist)] THEN
    EXISTS_TAC (← q r"x:real^N") THEN ASM_REWRITE_TAC [IN_INTER, IN_BALL])

  return { COMPLETE_HAUSDIST, TOTALLY_BOUNDED_HAUSDIST }

/- ------------------------------------------------------------------------- -/
/- Compactness for the Hausdorff metric.  (topology.ml 26598-26730)          -/
/- ------------------------------------------------------------------------- -/

structure CHC where
  COMPACT_HAUSDIST : thm
  deriving Inhabited

@[nospecialize]
def setupCHC [HolBase] (D : TopologyDeps) (BBND1 : BND1) (BCPT : CPT) (BHDA : HDA) (BHDC : HDC)
    (BCHT : CHT) : ExceptT String IO CHC := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { ADD1, ADD_CLAUSES, DEPENDENT_CHOICE, FINITE_IMAGE, FINITE_NUMSEG, .. } := D.core1
  let { FINITE_UNIONS, FORALL_IN_IMAGE, GE, IMP_CONJ, IMP_CONJ_ALT, INFINITE, INFINITE_DIFF_FINITE,
        INFINITE_NONEMPTY, INFINITE_SUPERSET, IN_DIFF, IN_ELIM_THM, IN_NUMSEG, .. } := D.core2
  let { LE_0, LT_EXISTS, LT_TRANS, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, NOT_LE,
        NUMSEG_SING, .. } := D.core3
  let { REAL_ARCH_POW_INV, REAL_INV_MUL, REAL_INV_POW, REAL_LET_TRANS, REAL_LE_INV2,
        REAL_LE_INV_EQ, REAL_LE_REFL, REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_POW2, .. } := D.core4
  let { REAL_OF_NUM_LE, REAL_POS, REAL_POW_DIV, REAL_POW_INV, REAL_POW_LE, REAL_POW_MONO,
        REAL_POW_ONE, RIGHT_EXISTS_AND_THM, SIMPLE_IMAGE, SUBSET, .. } := D.core5
  let { SUM_CLAUSES_NUMSEG, SUM_LE_NUMSEG, SUM_SING, TRANSITIVE_STEPWISE_LT, UNIONS_GSPEC, WLOG_LT,
        num_INDUCTION, num_INFINITE, real_div, real_pow, .. } := D.core6
  let { SUM_GP, .. } := D.misc
  let { BOUNDED_SUBSET, .. } := BBND1
  let { COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := BCPT
  let { HAUSDIST_REFL, HAUSDIST_SYM, .. } := BHDA
  let { HAUSDIST_TRIANGLE, .. } := BHDC
  let { COMPLETE_HAUSDIST, TOTALLY_BOUNDED_HAUSDIST, .. } := BCHT
  -- @@SCOPE END

  let COMPACT_HAUSDIST ← prove
   r"!f:num->(real^N->bool) c.
        compact c /\ (!n. ~(f n = {}) /\ f n SUBSET c)
        ==> ?r s. (!m n. m < n ==> r m < r n) /\
                  compact s /\ ~(s = {}) /\ s SUBSET c /\
                  ((\n. lift(hausdist(f(r n),s))) --> vec 0) sequentially"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?r. (!n. INFINITE {i | hausdist(f(r n),f i) < inv(&2 pow n)}) /\
          (!n. r n < r(SUC n) /\
               hausdist((f:num->(real^N->bool))(r n),f(r(SUC n)))
               < inv(&2 pow n))")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"c:real^N->bool", ← q r"&1 / &2"]
          TOTALLY_BOUNDED_HAUSDIST) THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"k:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN
         (← q r"UNIONS
           {{i | hausdist((f:num->(real^N->bool)) i,u) < &1 / &2} | u IN k} =
          (:num)")
        MP_TAC THENL
         [REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC [],
          DISCH_THEN (MP_TAC o MATCH_MP (← MESON [INFINITE, num_INFINITE]
           (← q r"s = (:num) ==> ~FINITE s")))] THEN
        REWRITE_TAC [FINITE_UNIONS] THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, ← GSYM INFINITE] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP INFINITE_NONEMPTY) THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          INFINITE_SUPERSET)) THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        GEN_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"x < &1 / &2 ==> z <= x + y ==> y < &1 / &2 ==> z < &1"))) THEN
        GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [HAUSDIST_SYM] THEN
        MATCH_MP_TAC HAUSDIST_TRIANGLE THEN
        ASM_MESON_TAC [COMPACT_IMP_BOUNDED, BOUNDED_SUBSET],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"m:num"] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"c:real^N->bool", ← q r"inv(&2 pow (n + 2))"]
          TOTALLY_BOUNDED_HAUSDIST) THEN
      ASM_SIMP_TAC [COMPACT_IMP_BOUNDED, REAL_LT_INV_EQ, REAL_LT_POW2] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"INFINITE
          (UNIONS
            {{i | hausdist (f m,f i) < inv(&2 pow n) /\ m < i /\
                   hausdist((f:num->(real^N->bool)) i,u) < inv(&2 pow (n + 2))}
             | u IN k})")
      MP_TAC THENL
       [FIRST_ASSUM (MP_TAC o SPEC (← q r"0..m") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
         INFINITE_DIFF_FINITE)) THEN
        REWRITE_TAC [FINITE_NUMSEG] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] INFINITE_SUPERSET) THEN
        REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_DIFF, IN_NUMSEG, IN_ELIM_THM] THEN
        REWRITE_TAC [LE_0, NOT_LE] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [INFINITE, FINITE_UNIONS] THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, ← GSYM INFINITE] THEN
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o GEN_REWRITE_RULE id [INFINITE]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP INFINITE_NONEMPTY) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"p:num") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        INFINITE_SUPERSET)) THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"q:num") THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x < n2 ==> inv(&2) * n1 = n2 /\ z <= x + y ==> y < n2 ==> z < n1"))) THEN
      REWRITE_TAC [← GSYM REAL_INV_MUL, ← GSYM (← CONJUNCT2 real_pow)] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"SUC(SUC n) = n + 2")] THEN
      GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [HAUSDIST_SYM] THEN
      MATCH_MP_TAC HAUSDIST_TRIANGLE THEN
      ASM_MESON_TAC [COMPACT_IMP_BOUNDED, BOUNDED_SUBSET],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"r:num->num") THEN REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN ASM_REWRITE_TAC [LT_TRANS],
      MATCH_MP_TAC COMPLETE_HAUSDIST] THEN
    ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [BOUNDED_SUBSET, COMPACT_IMP_BOUNDED], ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
    ASM_REWRITE_TAC [REAL_POW_INV, GE] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN EXISTS_TAC (← q r"N + 1") THEN
    MATCH_MP_TAC WLOG_LT THEN ASM_REWRITE_TAC [HAUSDIST_REFL] THEN
    CONJ_TAC THENL [MESON_TAC [HAUSDIST_SYM], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN REPEAT STRIP_TAC THEN
    TRANS_TAC REAL_LET_TRANS
      (← q r"sum(m..n-1) (\i. hausdist((f:num->real^N->bool)(r(i + 1)),f(r i)))") THEN
    CONJ_TAC THENL
     [FIRST_ASSUM (X_CHOOSE_THEN (← q r"d:num") SUBST1_TAC o
          GEN_REWRITE_RULE id [LT_EXISTS]) THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(m + SUC d) - 1 = m + d")] THEN
      SPEC_TAC (← q r"d:num", ← q r"d:num") THEN MATCH_MP_TAC num_INDUCTION THEN
      REWRITE_TAC [ADD_CLAUSES, SUM_CLAUSES_NUMSEG, NUMSEG_SING, SUM_SING] THEN
      CONJ_TAC THENL [MESON_TAC [ADD1, REAL_LE_REFL, HAUSDIST_SYM], ALL_TAC] THEN
      X_GEN_TAC (← q r"d:num") THEN REWRITE_TAC [← ARITH_RULE (← q r"m <= SUC(m + d)")] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"h' <= h + e ==> h <= d ==> h' <= d + e")) THEN
      REWRITE_TAC [← GSYM ADD1, ADD_CLAUSES] THEN
      GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [HAUSDIST_SYM] THEN
      MATCH_MP_TAC HAUSDIST_TRIANGLE THEN
      ASM_MESON_TAC [BOUNDED_SUBSET, COMPACT_IMP_BOUNDED],
      ALL_TAC] THEN
    TRANS_TAC REAL_LET_TRANS (← q r"sum (m..n-1) (\i. inv(&2 pow i))") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [HAUSDIST_SYM] THEN MATCH_MP_TAC SUM_LE_NUMSEG THEN
      ASM_SIMP_TAC [← GSYM ADD1, REAL_LT_IMP_LE],
      ALL_TAC] THEN
    REWRITE_TAC [REAL_INV_POW, SUM_GP] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    COND_CASES_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"inv i < e ==> x <= inv(&2) * inv i  ==> x / (&1 / &2) < e"))) THEN
    REWRITE_TAC [REAL_POW_DIV, REAL_POW_ONE] THEN REWRITE_TAC [real_div] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ y <= z ==> &1 * y - &1 * x <= z")) THEN
    SIMP_TAC [REAL_LE_INV_EQ, REAL_POW_LE, REAL_POS] THEN
    REWRITE_TAC [← GSYM REAL_INV_MUL] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 real_pow), REAL_LT_POW2] THEN
    MATCH_MP_TAC REAL_POW_MONO THEN REWRITE_TAC [REAL_OF_NUM_LE] THEN
    ASM_ARITH_TAC)

  return { COMPACT_HAUSDIST }

/- ------------------------------------------------------------------------- -/
/- Isometries are embeddings, and even surjective in the compact case.       -/
/- (topology.ml 26731-26797)                                                 -/
/- ------------------------------------------------------------------------- -/

structure ISO where
  ISOMETRY_IMP_OPEN_MAP : thm
  ISOMETRY_IMP_EMBEDDING : thm
  ISOMETRY_IMP_HOMEOMORPHISM_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupISO [HolBase] (D : TopologyDeps) (BLOC : LOC) (BCLS1 : CLS1) (BCPT : CPT) (BCMP : CMP)
    (BCSL : CSL) (BLCP : LCP) (BIOM : IOM) (BSDS : SDS) (BSD3 : SD3) :
    ExceptT String IO ISO := do
  -- @@SCOPE BEGIN
  let { prove_recursive_functions_exist, ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, REAL_ARITH,
        SET_TAC, .. } := D
  let { ADD_CLAUSES, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ, IN_IMAGE, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LT_EXISTS, MONO_EXISTS, NOT_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_EQ_IMP_LE, REAL_LE_TRANS, .. } := D.core4
  let { REAL_NOT_LT, SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core5
  let { num_RECURSION, o_THM, .. } := D.core6
  let { DIST_EQ_0, .. } := D.vec1
  let { open_in, .. } := BLOC
  let { CLOSURE_CLOSED, .. } := BCLS1
  let { COMPACT_IMP_CLOSED, compact, .. } := BCPT
  let { CONVERGENT_IMP_CAUCHY, cauchy, .. } := BCMP
  let { ISOMETRY_ON_IMP_CONTINUOUS_ON, .. } := BCSL
  let { COMPACT_CONTINUOUS_IMAGE, .. } := BLCP
  let { HOMEOMORPHISM_INJECTIVE_OPEN_MAP, .. } := BIOM
  let { SETDIST_LE_DIST, SETDIST_POS_LE, .. } := BSDS
  let { SETDIST_EQ_0_SING, .. } := BSD3
  -- @@SCOPE END

  let ISOMETRY_IMP_OPEN_MAP ← prove
   r"!f:real^M->real^N s t u.
        IMAGE f s = t /\
        (!x y. x IN s /\ y IN s ==> dist(f x,f y) = dist(x,y)) /\
        open_in (subtopology euclidean s) u
        ==> open_in (subtopology euclidean t) (IMAGE f u)"
   (REWRITE_TAC [open_in, FORALL_IN_IMAGE] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [IMP_CONJ] THEN
    EXPAND_TAC "t" THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [IN_IMAGE] THEN ASM_MESON_TAC [])

  let ISOMETRY_IMP_EMBEDDING ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s = t /\ (!x y. x IN s /\ y IN s ==> dist(f x,f y) = dist(x,y))
        ==> ?g. homeomorphism (s,t) (f,g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_OPEN_MAP THEN
    ASM_SIMP_TAC [ISOMETRY_ON_IMP_CONTINUOUS_ON] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [DIST_EQ_0], REPEAT STRIP_TAC] THEN
    MATCH_MP_TAC ISOMETRY_IMP_OPEN_MAP THEN ASM_MESON_TAC [])

  let ISOMETRY_IMP_HOMEOMORPHISM_COMPACT ← prove
   r"!f s:real^N->bool.
        compact s /\ IMAGE f s SUBSET s /\
        (!x y. x IN s /\ y IN s ==> dist(f x,f y) = dist(x,y))
        ==> ?g. homeomorphism (s,s) (f,g)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:real^N->real^N) s = s")
     (fun th => ASM_MESON_TAC [th, ISOMETRY_IMP_EMBEDDING]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ISOMETRY_ON_IMP_CONTINUOUS_ON) THEN
    ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN REWRITE_TAC [SUBSET] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"setdist({x},IMAGE (f:real^N->real^N) s) = &0") MP_TAC THENL
     [MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ ~(&0 < x) ==> x = &0")) THEN
      REWRITE_TAC [SETDIST_POS_LE] THEN DISCH_TAC THEN
      X_CHOOSE_THEN (← q r"z:num->real^N") STRIP_ASSUME_TAC
       (← prove_recursive_functions_exist num_RECURSION
         (← q r"z 0 = (x:real^N) /\ !n. z(SUC n) = f(z n)")) THEN
      SUBGOAL_THEN (← q r"!n. (z:num->real^N) n IN s") ASSUME_TAC THENL
       [INDUCT_TAC THEN ASM SET_TAC [], ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z:num->real^N")) THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"l:real^N", ← q r"r:num->num"] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP CONVERGENT_IMP_CAUCHY) THEN
      REWRITE_TAC [cauchy] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"setdist({x},IMAGE (f:real^N->real^N) s)")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"N:num")
       (MP_TAC o SPECL [← q r"N:num", ← q r"N + 1"])) THEN
      ANTS_TAC THENL [ARITH_TAC, REWRITE_TAC [REAL_NOT_LT, o_THM]] THEN
      SUBGOAL_THEN (← q r"(r:num->num) N < r (N + 1)") MP_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC,
        REWRITE_TAC [LT_EXISTS, LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"d:num") THEN DISCH_THEN SUBST1_TAC THEN
      TRANS_TAC REAL_LE_TRANS (← q r"dist(x:real^N,z(SUC d))") THEN CONJ_TAC THENL
       [MATCH_MP_TAC SETDIST_LE_DIST THEN ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC REAL_EQ_IMP_LE THEN
      SPEC_TAC (← q r"(r:num->num) N", ← q r"m:num") THEN
      INDUCT_TAC THEN ASM_MESON_TAC [ADD_CLAUSES],
      REWRITE_TAC [SETDIST_EQ_0_SING, IMAGE_EQ_EMPTY] THEN
      ASM_MESON_TAC [COMPACT_IMP_CLOSED, NOT_IN_EMPTY,
                     COMPACT_CONTINUOUS_IMAGE, CLOSURE_CLOSED]])

  return { ISOMETRY_IMP_OPEN_MAP, ISOMETRY_IMP_EMBEDDING, ISOMETRY_IMP_HOMEOMORPHISM_COMPACT }

/- ------------------------------------------------------------------------- -/
/- Urysohn's lemma (for real^N, where the proof is easy using distances).    -/
/- (topology.ml 26798-26957)                                                 -/
/- ------------------------------------------------------------------------- -/

structure URY where
  URYSOHN_LOCAL_STRONG : thm
  URYSOHN_LOCAL : thm
  URYSOHN_STRONG : thm
  URYSOHN : thm
  deriving Inhabited

@[nospecialize]
def setupURY [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BSEG : SEG)
    (BLPT : LPT) (BCLS1 : CLS1) (BCMS : CMS) (BSMI : SMI) (BSDS : SDS) (BSD2 : SD2)
    (BSD3 : SD3) : ExceptT String IO URY := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, SET_TAC, VECTOR_ARITH,
        VECTOR_ARITH_TAC, NORM_ARITH_TAC, .. } := D
  let { CONJ_ACI, CONJ_SYM, CONTRAPOS_THM, EQ_SYM_EQ, EXISTS_OR_THM, .. } := D.core1
  let { INTER_COMM, INTER_SUBSET, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNIV, LEFT_OR_DISTRIB, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_EQ_LDIV_EQ, REAL_LE_ADD, REAL_LE_DIV, REAL_LE_LDIV_EQ, REAL_LT_IMP_NZ, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_SUB_0, SUBSET, .. } := D.core5
  let { SWAP_FORALL_THM, UNWIND_THM1, o_DEF, real_div, .. } := D.core6
  let { DIST_MIDPOINT, .. } := D.vec1
  let { LIFT_ADD, .. } := D.vec2
  let { MIDPOINT_EQ_ENDPOINT, .. } := D.vec3
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, midpoint, .. } := D.vec4
  let { CLOSED_IN_SUBSET, .. } := D.met1
  let { SUBTOPOLOGY_UNIV, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_IN, .. } := BCLO
  let { CLOSED_IN_CLOSED, .. } := BLOC
  let { DIST_IN_CLOSED_SEGMENT, ENDS_IN_SEGMENT, IN_SEGMENT, MIDPOINT_IN_SEGMENT, SEGMENT_SYM,
        segment, .. } := BSEG
  let { CLOSED_IN_SING, .. } := BLPT
  let { CLOSURE_CLOSED, CLOSURE_SUBSET, SUBSET_CLOSURE, .. } := BCLS1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_INV, CONTINUOUS_ON_MUL, .. } := BSMI
  let { SETDIST_POS_LE, .. } := BSDS
  let { CONTINUOUS_ON_LIFT_SETDIST, .. } := BSD2
  let { SETDIST_EQ_0_SING, .. } := BSD3
  -- @@SCOPE END

  let URYSOHN_LOCAL_STRONG ← do
    let lemma ← prove
     r"!s t u a b.
            closed_in (subtopology euclidean u) s /\
            closed_in (subtopology euclidean u) t /\
            s INTER t = {} /\ ~(s = {}) /\ ~(t = {}) /\ ~(a = b)
            ==> ?f:real^N->real^M.
                   f continuous_on u /\
                   (!x. x IN u ==> f(x) IN segment[a,b]) /\
                   (!x. x IN u ==> (f x = a <=> x IN s)) /\
                   (!x. x IN u ==> (f x = b <=> x IN t))"
     (REPEAT STRIP_TAC THEN EXISTS_TAC
        (← q r"\x:real^N. a + setdist({x},s) / (setdist({x},s) + setdist({x},t)) %
                        (b - a:real^M)") THEN REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"(!x:real^N. x IN u ==> (setdist({x},s) = &0 <=> x IN s)) /\
        (!x:real^N. x IN u ==> (setdist({x},t) = &0 <=> x IN t))")
      STRIP_ASSUME_TAC THENL
       [ASM_REWRITE_TAC [SETDIST_EQ_0_SING] THEN CONJ_TAC THENL
         [MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSED_IN_CLOSED),
          MP_TAC (← ISPEC (← q r"t:real^N->bool") CLOSED_IN_CLOSED)] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"u:real^N->bool")) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool")
         (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC)) THEN
        ASM_MESON_TAC [CLOSURE_CLOSED, INTER_SUBSET, SUBSET_CLOSURE, SUBSET,
                       IN_INTER, CLOSURE_SUBSET],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!x:real^N. x IN u ==> &0 < setdist({x},s) + setdist({x},t)")
      ASSUME_TAC THENL
       [REPEAT STRIP_TAC THEN MATCH_MP_TAC (← REAL_ARITH
          (← q r"&0 <= x /\ &0 <= y /\ ~(x = &0 /\ y = &0) ==> &0 < x + y")) THEN
        REWRITE_TAC [SETDIST_POS_LE] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
        REWRITE_TAC [real_div, ← GSYM VECTOR_MUL_ASSOC] THEN
        REPEAT (MATCH_MP_TAC CONTINUOUS_ON_MUL THEN CONJ_TAC) THEN
        REWRITE_TAC [CONTINUOUS_ON_CONST, o_DEF] THEN
        REWRITE_TAC [CONTINUOUS_ON_LIFT_SETDIST] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        ASM_SIMP_TAC [REAL_LT_IMP_NZ] THEN
        REWRITE_TAC [LIFT_ADD] THEN MATCH_MP_TAC CONTINUOUS_ON_ADD THEN
        REWRITE_TAC [CONTINUOUS_ON_LIFT_SETDIST],
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        REWRITE_TAC [segment, IN_ELIM_THM] THEN
        REWRITE_TAC [VECTOR_MUL_EQ_0, LEFT_OR_DISTRIB, ← VECTOR_ARITH
         (← q r"a + x % (b - a):real^N = (&1 - u) % a + u % b <=>
          (x - u) % (b - a) = vec 0"),
         EXISTS_OR_THM] THEN
        DISJ1_TAC THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
        REWRITE_TAC [REAL_SUB_0, UNWIND_THM1] THEN
        ASM_SIMP_TAC [REAL_LE_DIV, REAL_LE_ADD, SETDIST_POS_LE, REAL_LE_LDIV_EQ,
                      ← REAL_ARITH (← q r"a <= &1 * (a + b) <=> &0 <= b")],
        REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a <=> x = vec 0")],
        REWRITE_TAC [← VECTOR_ARITH (← q r"a + x % (b - a):real^N = b <=>
                                  (x - &1) % (b - a) = vec 0")]] THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ] THEN
      ASM_SIMP_TAC [REAL_SUB_0, REAL_EQ_LDIV_EQ,
                    REAL_MUL_LZERO, REAL_MUL_LID] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x:real = x + y <=> y = &0")] THEN
      ASM_REWRITE_TAC [])
    prove
     r"!s t u a b.
          closed_in (subtopology euclidean u) s /\
          closed_in (subtopology euclidean u) t /\
          s INTER t = {} /\ ~(a = b)
          ==> ?f:real^N->real^M.
                 f continuous_on u /\
                 (!x. x IN u ==> f(x) IN segment[a,b]) /\
                 (!x. x IN u ==> (f x = a <=> x IN s)) /\
                 (!x. x IN u ==> (f x = b <=> x IN t))"
     (MATCH_MP_TAC (← MESON []
       (← q r"(!s t. P s t <=> P t s) /\
        (!s t. ~(s = {}) /\ ~(t = {}) ==> P s t) /\
        P {} {} /\ (!t. ~(t = {}) ==> P {} t)
        ==> !s t. P s t")) THEN
      REPEAT CONJ_TAC THENL
       [REPEAT GEN_TAC THEN
        GEN_REWRITE_TAC (RAND_CONV o BINDER_CONV) [SWAP_FORALL_THM] THEN
        REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
        REWRITE_TAC [SEGMENT_SYM, INTER_COMM, CONJ_ACI, EQ_SYM_EQ],
        SIMP_TAC [lemma],
        REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"(\x. midpoint(a,b)):real^N->real^M") THEN
        ASM_SIMP_TAC [NOT_IN_EMPTY, CONTINUOUS_ON_CONST, MIDPOINT_IN_SEGMENT] THEN
        REWRITE_TAC [midpoint] THEN CONJ_TAC THEN GEN_TAC THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"~(a:real^M = b)") THEN REWRITE_TAC [CONTRAPOS_THM] THEN
        VECTOR_ARITH_TAC,
        REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"t:real^N->bool = u") THENL
         [EXISTS_TAC (← q r"(\x. b):real^N->real^M") THEN
          ASM_REWRITE_TAC [NOT_IN_EMPTY, ENDS_IN_SEGMENT, IN_UNIV,
                           CONTINUOUS_ON_CONST],
          SUBGOAL_THEN (← q r"?c:real^N. c IN u /\ ~(c IN t)") STRIP_ASSUME_TAC THENL
           [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
            REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN ASM SET_TAC [],
            ALL_TAC] THEN
          MP_TAC (← ISPECL [← q r"{c:real^N}", ← q r"t:real^N->bool", ← q r"u:real^N->bool",
                            ← q r"midpoint(a,b):real^M", ← q r"b:real^M"] lemma) THEN
          ASM_REWRITE_TAC [CLOSED_IN_SING, MIDPOINT_EQ_ENDPOINT] THEN
          ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
          MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [NOT_IN_EMPTY] THEN
          X_GEN_TAC (← q r"f:real^N->real^M") THEN STRIP_TAC THEN CONJ_TAC THENL
           [SUBGOAL_THEN
             (← q r"segment[midpoint(a,b):real^M,b] SUBSET segment[a,b]") MP_TAC
            THENL
             [REWRITE_TAC [SUBSET, IN_SEGMENT, midpoint] THEN GEN_TAC THEN
              DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) THEN
              EXISTS_TAC (← q r"(&1 + u) / &2") THEN ASM_REWRITE_TAC [] THEN
              REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
              VECTOR_ARITH_TAC,
              ASM SET_TAC []],
            SUBGOAL_THEN (← q r"~(a IN segment[midpoint(a,b):real^M,b])") MP_TAC THENL
             [ALL_TAC, ASM_MESON_TAC []] THEN
            DISCH_THEN (MP_TAC o CONJUNCT2 o MATCH_MP DIST_IN_CLOSED_SEGMENT) THEN
            REWRITE_TAC [DIST_MIDPOINT] THEN
            UNDISCH_TAC (← q r"~(a:real^M = b)") THEN NORM_ARITH_TAC]]])

  let URYSOHN_LOCAL ← prove
   r"!s t u a b.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        s INTER t = {}
        ==> ?f:real^N->real^M.
               f continuous_on u /\
               (!x. x IN u ==> f(x) IN segment[a,b]) /\
               (!x. x IN s ==> f x = a) /\
               (!x. x IN t ==> f x = b)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"a:real^M = b") THENL
     [EXISTS_TAC (← q r"(\x. b):real^N->real^M") THEN
      ASM_REWRITE_TAC [ENDS_IN_SEGMENT, CONTINUOUS_ON_CONST],
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool", ← q r"u:real^N->bool",
                        ← q r"a:real^M", ← q r"b:real^M"] URYSOHN_LOCAL_STRONG) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN SET_TAC []])

  let URYSOHN_STRONG ← prove
   r"!s t a b.
        closed s /\ closed t /\ s INTER t = {} /\ ~(a = b)
        ==> ?f:real^N->real^M.
               f continuous_on (:real^N) /\ (!x. f(x) IN segment[a,b]) /\
               (!x. f x = a <=> x IN s) /\ (!x. f x = b <=> x IN t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP URYSOHN_LOCAL_STRONG) THEN
    REWRITE_TAC [IN_UNIV])

  let URYSOHN ← prove
   r"!s t a b.
        closed s /\ closed t /\ s INTER t = {}
        ==> ?f:real^N->real^M.
               f continuous_on (:real^N) /\ (!x. f(x) IN segment[a,b]) /\
               (!x. x IN s ==> f x = a) /\ (!x. x IN t ==> f x = b)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN DISCH_THEN
     (MP_TAC o ISPECL [← q r"a:real^M", ← q r"b:real^M"] o MATCH_MP URYSOHN_LOCAL) THEN
    REWRITE_TAC [IN_UNIV])

  return { URYSOHN_LOCAL_STRONG, URYSOHN_LOCAL, URYSOHN_STRONG, URYSOHN }

/- ------------------------------------------------------------------------- -/
/- Density of points with rational, or just dyadic rational, coordinates.    -/
/- (topology.ml 26958-27020)                                                 -/
/- ------------------------------------------------------------------------- -/

structure DYR where
  CLOSURE_DYADIC_RATIONALS : thm
  CLOSURE_RATIONAL_COORDINATES : thm
  CLOSURE_DYADIC_RATIONALS_IN_OPEN_SET : thm
  CLOSURE_RATIONALS_IN_OPEN_SET : thm
  deriving Inhabited

@[nospecialize]
def setupDYR [HolBase] (D : TopologyDeps) (BCLS1 : CLS1) : ExceptT String IO DYR := do
  -- @@SCOPE BEGIN
  let { REAL_ARITH_TAC, REAL_FIELD, SET_RULE, REAL_RAT_REDUCE_CONV, .. } := D
  let { ARITH, CARD_NUMSEG_1, DIMINDEX_GE_1, EXISTS_IN_GSPEC, EXTENSION, FINITE_NUMSEG, .. } :=
    D.core1
  let { FORALL_IN_GSPEC, IMP_CONJ, IN_ELIM_THM, IN_NUMSEG, .. } := D.core2
  let { IN_UNIV, LAMBDA_BETA, LE_1, MONO_EXISTS, REAL_ABS_INV, REAL_ABS_MUL, REAL_ABS_NUM,
        REAL_ABS_POS, REAL_ABS_POW, .. } := D.core3
  let { REAL_ARCH_POW_INV, REAL_LET_TRANS, REAL_LE_MUL2, REAL_LE_REFL, REAL_LT_DIV,
        REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_RID, REAL_MUL_SYM, REAL_OF_NUM_EQ, REAL_OF_NUM_LT, REAL_POW_EQ_0, REAL_POW_INV,
        SUBSET, SUBSET_UNIV, .. } := D.core5
  let { SUM_BOUND, .. } := D.core6
  let { FLOOR, RATIONAL_CLOSED, .. } := D.lib2
  let { NORM_LE_L1, NORM_MUL, .. } := D.vec3
  let { VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT, dist, .. } := D.vec4
  let { CLOSURE_APPROACHABLE, CLOSURE_OPEN_INTER_SUPERSET, SUBSET_CLOSURE, .. } := BCLS1
  -- @@SCOPE END

  let CLOSURE_DYADIC_RATIONALS ← prove
   r"closure { inv(&2 pow n) % x |n,x|
             !i. 1 <= i /\ i <= dimindex(:N) ==> integer(x$i) } = (:real^N)"
   (REWRITE_TAC [EXTENSION, CLOSURE_APPROACHABLE, IN_UNIV, EXISTS_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"e:real"] THEN DISCH_TAC THEN
    MP_TAC (← SPECL [← q r"inv(&2)", ← q r"e / &(dimindex(:N))"] REAL_ARCH_POW_INV) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1,
                  REAL_POW_INV, REAL_LT_RDIV_EQ] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN MATCH_MP_TAC MONO_EXISTS THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"(lambda i. floor(&2 pow n * (x:real^N)$i)):real^N") THEN
    ASM_SIMP_TAC [LAMBDA_BETA, FLOOR, dist, NORM_MUL] THEN
    MATCH_MP_TAC (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS)
     (← SPEC_ALL NORM_LE_L1)) THEN
    SIMP_TAC [LAMBDA_BETA, VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"&(dimindex(:N)) * inv(&2 pow n)") THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o RAND_CONV) [← GSYM CARD_NUMSEG_1] THEN
    MATCH_MP_TAC SUM_BOUND THEN REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
    X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
    SIMP_TAC [REAL_ABS_MUL, REAL_POW_EQ_0, REAL_OF_NUM_EQ, ARITH,
      ← REAL_FIELD (← q r"~(a = &0) ==> inv a * b - x = inv a * (b - a * x)")] THEN
    MATCH_MP_TAC REAL_LE_MUL2 THEN REWRITE_TAC [REAL_ABS_POS] THEN
    REWRITE_TAC [REAL_LE_REFL, REAL_ABS_POW, REAL_ABS_INV, REAL_ABS_NUM] THEN
    MP_TAC (← SPEC (← q r"&2 pow n * (x:real^N)$k") FLOOR) THEN REAL_ARITH_TAC)

  let CLOSURE_RATIONAL_COORDINATES ← prove
   r"closure { x | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i) } =
   (:real^N)"
   (MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ s = UNIV ==> t = UNIV")) THEN
    EXISTS_TAC
     (← q r"closure { inv(&2 pow n) % x:real^N |n,x|
                !i. 1 <= i /\ i <= dimindex(:N) ==> integer(x$i) }") THEN
    CONJ_TAC THENL [ALL_TAC, REWRITE_TAC [CLOSURE_DYADIC_RATIONALS]] THEN
    MATCH_MP_TAC SUBSET_CLOSURE THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_ELIM_THM, VECTOR_MUL_COMPONENT] THEN
    ASM_SIMP_TAC [RATIONAL_CLOSED])

  let CLOSURE_DYADIC_RATIONALS_IN_OPEN_SET ← prove
   r"!s:real^N->bool.
        open s
        ==> closure(s INTER
                    { inv(&2 pow n) % x | n,x |
                      !i. 1 <= i /\ i <= dimindex(:N) ==> integer(x$i) }) =
            closure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_OPEN_INTER_SUPERSET THEN
    ASM_REWRITE_TAC [CLOSURE_DYADIC_RATIONALS, SUBSET_UNIV])

  let CLOSURE_RATIONALS_IN_OPEN_SET ← prove
   r"!s:real^N->bool.
      open s
      ==> closure(s INTER
                  { x | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i) }) =
          closure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_OPEN_INTER_SUPERSET THEN
    ASM_REWRITE_TAC [CLOSURE_RATIONAL_COORDINATES, SUBSET_UNIV])

  return { CLOSURE_DYADIC_RATIONALS, CLOSURE_RATIONAL_COORDINATES,
           CLOSURE_DYADIC_RATIONALS_IN_OPEN_SET, CLOSURE_RATIONALS_IN_OPEN_SET }

/- ------------------------------------------------------------------------- -/
/- Various separability-type properties.  (topology.ml 27021-27210)          -/
/- ------------------------------------------------------------------------- -/

structure SEC where
  UNIV_SECOND_COUNTABLE : thm
  SECOND_COUNTABLE_EUCLIDEAN : thm
  UNIV_SECOND_COUNTABLE_SEQUENCE : thm
  SUBSET_SECOND_COUNTABLE : thm
  SEPARABLE : thm
  deriving Inhabited

@[nospecialize]
def setupSEC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BCLS1 : CLS1)
    (BDYR : DYR) : ExceptT String IO SEC := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, NORM_ARITH_TAC, .. } := D
  let { CONJ_ASSOC, CONTRAPOS_THM, CROSS, DIMINDEX_GE_1, EMPTY_SUBSET, EXISTS_IN_GSPEC,
        EXISTS_IN_IMAGE, EXISTS_PAIR_THM, EXISTS_SUBSET_IMAGE, EXTENSION, FINITE_IMAGE, .. } :=
    D.core1
  let { FINITE_POWERSET, FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMP_IMP, IN, INFINITE,
        INFINITE_IMAGE_INJ, INTER_UNIONS, IN_DELETE, IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_IMAGE,
        IN_INTER, .. } := D.core2
  let { IN_UNIONS, IN_UNIV, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY,
        MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, REAL_ABS_INV, .. } := D.core3
  let { REAL_LT_INV2, REAL_LT_REFL, .. } := D.core4
  let { REAL_MUL_RID, REAL_OF_NUM_ADD, REAL_OF_NUM_LT, RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM,
        SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_ANTISYM, SUBSET_DELETE, SUBSET_IMAGE,
        SUBSET_UNIV, .. } := D.core5
  let { SWAP_EXISTS_THM, UNIONS_0, WLOG_LT, num_INFINITE, .. } := D.core6
  let { COUNTABLE_AS_INJECTIVE_IMAGE, COUNTABLE_CART, COUNTABLE_CROSS, COUNTABLE_DELETE,
        COUNTABLE_IMAGE, .. } := D.lib1
  let { RATIONAL_APPROXIMATION, .. } := D.lib2
  let { COUNTABLE_RATIONAL, .. } := D.misc
  let { DIST_0, DIST_SYM, .. } := D.vec1
  let { NORM_BASIS, NORM_MUL, .. } := D.vec3
  let { OPEN_IN_SUBSET, TOPSPACE_SUBTOPOLOGY, second_countable, .. } := D.met3
  let { OPEN_IN, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := BBAL
  let { OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, .. } := BLOC
  let { CLOSURE_APPROACHABLE, .. } := BCLS1
  let { CLOSURE_RATIONAL_COORDINATES, .. } := BDYR
  -- @@SCOPE END

  let UNIV_SECOND_COUNTABLE ← prove
   r"?b. COUNTABLE b /\ (!c. c IN b ==> open c) /\
       !s:real^N->bool. open s ==> ?u. u SUBSET b /\ s = UNIONS u"
   (EXISTS_TAC
     (← q r"IMAGE (\(v:real^N,q). ball(v,q))
            ({v | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(v$i)} CROSS
             rational)") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_IMAGE THEN MATCH_MP_TAC COUNTABLE_CROSS THEN
      REWRITE_TAC [COUNTABLE_RATIONAL] THEN MATCH_MP_TAC COUNTABLE_CART THEN
      REWRITE_TAC [COUNTABLE_RATIONAL, ← SET_RULE (← q r"{x | P x} = P")],
      REWRITE_TAC [FORALL_IN_IMAGE, CROSS, FORALL_IN_GSPEC, OPEN_BALL],
      REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
       [EXISTS_TAC (← q r"{}:(real^N->bool)->bool") THEN
        ASM_REWRITE_TAC [UNIONS_0, EMPTY_SUBSET],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"{c | c IN IMAGE (\(v:real^N,q). ball(v,q))
            ({v | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(v$i)} CROSS
             rational) /\ c SUBSET s}") THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      REWRITE_TAC [SUBSET, IN_UNIONS, IN_ELIM_THM] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, EXISTS_IN_IMAGE] THEN
      REWRITE_TAC [CROSS, EXISTS_PAIR_THM, EXISTS_IN_GSPEC] THEN
      REWRITE_TAC [IN_ELIM_PAIR_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, SUBSET, IN_BALL] THEN
      X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
      MP_TAC (← REWRITE_RULE [EXTENSION, IN_UNIV] CLOSURE_RATIONAL_COORDINATES) THEN
      REWRITE_TAC [CLOSURE_APPROACHABLE] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:real^N", ← q r"e / &4"]) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [IN_ELIM_THM]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"?x. rational x /\ e / &3 < x /\ x < e / &2")
       (X_CHOOSE_THEN (← q r"q:real") STRIP_ASSUME_TAC)
      THENL
       [MP_TAC (← ISPECL [← q r"&5 / &12 * e", ← q r"e / &12"] RATIONAL_APPROXIMATION) THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, MATCH_MP_TAC MONO_EXISTS] THEN
        SIMP_TAC [] THEN REAL_ARITH_TAC,
        EXISTS_TAC (← q r"q:real") THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
         [ASM_REWRITE_TAC [IN],
          REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          REPEAT (POP_ASSUM MP_TAC) THEN NORM_ARITH_TAC,
          ASM_REAL_ARITH_TAC]]])

  let SECOND_COUNTABLE_EUCLIDEAN ← prove
   r"second_countable (euclidean:(real^N)topology)"
   (REWRITE_TAC [second_countable, ← GSYM OPEN_IN] THEN
    X_CHOOSE_THEN (← q r"b:(real^N->bool)->bool") STRIP_ASSUME_TAC
      UNIV_SECOND_COUNTABLE THEN
    EXISTS_TAC (← q r"b:(real^N->bool)->bool") THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:real^N->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    ASM SET_TAC [])

  let UNIV_SECOND_COUNTABLE_SEQUENCE ← prove
   r"?b:num->real^N->bool.
        (!m n. b m = b n <=> m = n) /\
        (!n. open(b n)) /\
        (!s. open s ==> ?k. s = UNIONS {b n | n IN k})"
   (X_CHOOSE_THEN (← q r"bb:(real^N->bool)->bool") STRIP_ASSUME_TAC
      UNIV_SECOND_COUNTABLE THEN
    MP_TAC (← ISPEC (← q r"bb:(real^N->bool)->bool") COUNTABLE_AS_INJECTIVE_IMAGE) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [INFINITE] THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"INFINITE {ball(vec 0:real^N,inv(&n + &1)) | n IN (:num)}")
      MP_TAC THENL
       [REWRITE_TAC [SIMPLE_IMAGE] THEN MATCH_MP_TAC (← REWRITE_RULE
         [RIGHT_IMP_FORALL_THM, IMP_IMP] INFINITE_IMAGE_INJ) THEN
        REWRITE_TAC [num_INFINITE] THEN MATCH_MP_TAC WLOG_LT THEN SIMP_TAC [] THEN
        CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN DISCH_TAC THEN
        REWRITE_TAC [EXTENSION] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"inv(&n + &1) % basis 1:real^N")) THEN
        REWRITE_TAC [IN_BALL, DIST_0, NORM_MUL, REAL_ABS_INV] THEN
        SIMP_TAC [NORM_BASIS, DIMINDEX_GE_1, LE_REFL, REAL_MUL_RID] THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
        REWRITE_TAC [← REAL_ARITH (← q r"abs(&n + &1) = &n + &1"), REAL_LT_REFL] THEN
        MATCH_MP_TAC REAL_LT_INV2 THEN
        REWRITE_TAC [REAL_OF_NUM_LT, REAL_OF_NUM_ADD] THEN ASM_ARITH_TAC,
        REWRITE_TAC [INFINITE, SIMPLE_IMAGE] THEN
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE UNIONS {u | u SUBSET bb} :(real^N->bool)->bool") THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FINITE_POWERSET] THEN
        GEN_REWRITE_TAC id [SUBSET] THEN SIMP_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [IN_IMAGE, IN_ELIM_THM] THEN
        ASM_MESON_TAC [OPEN_BALL]],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:num->real^N->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [FORALL_IN_IMAGE, IN_UNIV]) THEN
      REPEAT (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
      X_GEN_TAC (← q r"s:real^N->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
      ASM_REWRITE_TAC [SUBSET_IMAGE, LEFT_AND_EXISTS_THM, SUBSET_UNIV] THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [SIMPLE_IMAGE]])

  let SUBSET_SECOND_COUNTABLE ← prove
   r"!s:real^N->bool.
       ?b. COUNTABLE b /\
           (!c. c IN b ==> ~(c = {}) /\ open_in(subtopology euclidean s) c) /\
           !t. open_in(subtopology euclidean s) t
               ==> ?u. u SUBSET b /\ t = UNIONS u"
   (GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"?b. COUNTABLE b /\
             (!c:real^N->bool. c IN b ==> open_in(subtopology euclidean s) c) /\
             !t. open_in(subtopology euclidean s) t
                 ==> ?u. u SUBSET b /\ t = UNIONS u")
    STRIP_ASSUME_TAC THENL
     [X_CHOOSE_THEN (← q r"B:(real^N->bool)->bool") STRIP_ASSUME_TAC
        UNIV_SECOND_COUNTABLE THEN
      EXISTS_TAC (← q r"{s INTER c :real^N->bool | c IN B}") THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE] THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE, EXISTS_SUBSET_IMAGE, OPEN_IN_OPEN_INTER] THEN
      REWRITE_TAC [OPEN_IN_OPEN] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM SUBST_ALL_TAC THEN
      SUBGOAL_THEN (← q r"?b. b SUBSET B /\ u:real^N->bool = UNIONS b")
      STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM SUBST_ALL_TAC THEN
      EXISTS_TAC (← q r"b:(real^N->bool)->bool") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [INTER_UNIONS] THEN AP_TERM_TAC THEN SET_TAC [],
      EXISTS_TAC (← q r"b DELETE ({}:real^N->bool)") THEN
      ASM_SIMP_TAC [COUNTABLE_DELETE, IN_DELETE, SUBSET_DELETE] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"u DELETE ({}:real^N->bool)") THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      FIRST_X_ASSUM SUBST_ALL_TAC THEN
      REWRITE_TAC [EXTENSION, IN_UNIONS] THEN
      GEN_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
      REWRITE_TAC [IN_DELETE] THEN SET_TAC []])

  let SEPARABLE ← prove
   r"!s:real^N->bool.
        ?t. COUNTABLE t /\ t SUBSET s /\ s SUBSET closure t"
   (MP_TAC SUBSET_SECOND_COUNTABLE THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_AND_EXISTS_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:(real^N->bool)->bool")
     (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC))) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:(real^N->bool)->real^N") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"IMAGE (f:(real^N->bool)->real^N) B") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE] THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEAN] THEN ASM SET_TAC [],
      REWRITE_TAC [SUBSET, CLOSURE_APPROACHABLE, EXISTS_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      UNDISCH_THEN
       (← q r"!t:real^N->bool.
          open_in (subtopology euclidean s) t
          ==> (?u. u SUBSET B /\ t = UNIONS u)")
       (MP_TAC o SPEC (← q r"s INTER ball(x:real^N,e)")) THEN
      SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"b:(real^N->bool)->bool") THEN
      ASM_CASES_TAC (← q r"b:(real^N->bool)->bool = {}") THENL
       [MATCH_MP_TAC (← TAUT (← q r"~b ==> a /\ b ==> c")) THEN
        ASM_REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY, UNIONS_0] THEN
        ASM_MESON_TAC [CENTRE_IN_BALL],
        STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^N->bool") THEN
        DISCH_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EXTENSION]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"(f:(real^N->bool)->real^N) c")) THEN
        ONCE_REWRITE_TAC [DIST_SYM] THEN REWRITE_TAC [IN_INTER, IN_BALL] THEN
        MATCH_MP_TAC (← TAUT (← q r"a /\ c ==> (a /\ b <=> c) ==> b")) THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
        ANTS_TAC THENL [ASM SET_TAC [], STRIP_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEAN] THEN
        ASM SET_TAC []]])

  return { UNIV_SECOND_COUNTABLE, SECOND_COUNTABLE_EUCLIDEAN, UNIV_SECOND_COUNTABLE_SEQUENCE, SUBSET_SECOND_COUNTABLE,
           SEPARABLE }

/- ------------------------------------------------------------------------- -/
/- Rational points in open sets, countable unions of intervals, Lindelof.    -/
/- (topology.ml 27211-27326)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LND where
  OPEN_SET_RATIONAL_COORDINATES : thm
  OPEN_COUNTABLE_UNION_OPEN_INTERVALS : thm
  OPEN_COUNTABLE_UNION_CLOSED_INTERVALS : thm
  LINDELOF : thm
  LINDELOF_OPEN_IN : thm
  deriving Inhabited

@[nospecialize]
def setupLND [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLOC : LOC) (BCLS1 : CLS1) (BDYR : DYR)
    (BSEC : SEC) : ExceptT String IO LND := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_TAC, .. } := D
  let { CARD_NUMSEG_1, CONJ_ASSOC, DIMINDEX_GE_1, EXISTS_IN_IMAGE, EXISTS_PAIR_THM, EXTENSION,
        FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, IMP_CONJ, INTER_UNIV, IN_CROSS, IN_ELIM_THM, IN_INTER,
        IN_NUMSEG, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_1, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_LT, NUMSEG_EMPTY, .. } :=
    D.core3
  let { REAL_LT_DIV, REAL_LT_IMP_LE, .. } := D.core4
  let { REAL_OF_NUM_LT, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_REFL, .. } := D.core5
  let { SUM_BOUND_LT_GEN, UNIONS_GSPEC, UNIONS_IMAGE, .. } := D.core6
  let { COUNTABLE_CROSS, COUNTABLE_IMAGE, COUNTABLE_RESTRICT, EXISTS_COUNTABLE_SUBSET_IMAGE, .. } :=
    D.lib1
  let { RATIONAL_APPROXIMATION_STRADDLE, .. } := D.lib2
  let { COUNTABLE_RATIONAL_COORDINATES, LAMBDA_SKOLEM, .. } := D.misc
  let { IN_INTERVAL, .. } := D.vec2
  let { NORM_LE_L1, .. } := D.vec3
  let { VECTOR_SUB_COMPONENT, dist, .. } := D.vec4
  let { open_def, .. } := BEUC
  let { OPEN_IN_OPEN, .. } := BLOC
  let { CLOSURE_APPROACHABLE, .. } := BCLS1
  let { CLOSURE_RATIONAL_COORDINATES, .. } := BDYR
  let { UNIV_SECOND_COUNTABLE, .. } := BSEC
  -- @@SCOPE END

  let OPEN_SET_RATIONAL_COORDINATES ← prove
   r"!s. open s /\ ~(s = {})
       ==> ?x:real^N. x IN s /\
                      !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"~(closure { x | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i) } INTER
      (s:real^N->bool) = {})")
    MP_TAC THENL
     [ASM_REWRITE_TAC [CLOSURE_RATIONAL_COORDINATES, INTER_UNIV], ALL_TAC] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, CLOSURE_APPROACHABLE, IN_INTER,
                 IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^N") o REWRITE_RULE [open_def]) THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  let (OPEN_COUNTABLE_UNION_OPEN_INTERVALS, OPEN_COUNTABLE_UNION_CLOSED_INTERVALS) ←
    CONJ_PAIR (← prove
   r"(!s:real^N->bool.
        open s
        ==> ?D. COUNTABLE D /\
                (!i. i IN D ==> i SUBSET s /\ ?a b. i = interval(a,b)) /\
                UNIONS D = s) /\
   (!s:real^N->bool.
        open s
        ==> ?D. COUNTABLE D /\
                (!i. i IN D ==> i SUBSET s /\ ?a b. i = interval[a,b]) /\
                UNIONS D = s)"
   (REPEAT STRIP_TAC THENL
     [EXISTS_TAC
       (← q r"{i | i IN IMAGE (\(a:real^N,b). interval(a,b))
              ({x | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i)} CROSS
               {x | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i)}) /\
             i SUBSET s}"),
      EXISTS_TAC
       (← q r"{i | i IN IMAGE (\(a:real^N,b). interval[a,b])
              ({x | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i)} CROSS
               {x | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i)}) /\
             i SUBSET s}")] THEN
    (SIMP_TAC [COUNTABLE_RESTRICT, COUNTABLE_IMAGE, COUNTABLE_CROSS,
               COUNTABLE_RATIONAL_COORDINATES] THEN
     REWRITE_TAC [IN_ELIM_THM, UNIONS_GSPEC, IMP_CONJ, ← GSYM CONJ_ASSOC] THEN
     REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
     REWRITE_TAC [FORALL_PAIR_THM, EXISTS_PAIR_THM, IN_CROSS, IN_ELIM_THM] THEN
     CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
     REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
     X_GEN_TAC (← q r"x:real^N") THEN EQ_TAC THENL [SET_TAC [], DISCH_TAC] THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o REWRITE_RULE [open_def]) THEN
     ASM_REWRITE_TAC [] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
     SUBGOAL_THEN
      (← q r"!i. 1 <= i /\ i <= dimindex(:N)
           ==> ?a b. rational a /\ rational b /\
                     a < (x:real^N)$i /\ (x:real^N)$i < b /\
                     abs(b - a) < e / &(dimindex(:N))")
     MP_TAC THENL
      [REPEAT STRIP_TAC THEN MATCH_MP_TAC RATIONAL_APPROXIMATION_STRADDLE THEN
       ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1],
       REWRITE_TAC [LAMBDA_SKOLEM]] THEN
     MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
     MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:real^N") THEN
     DISCH_TAC THEN ASM_SIMP_TAC [SUBSET, IN_INTERVAL, REAL_LT_IMP_LE] THEN
     X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
     REWRITE_TAC [dist] THEN MP_TAC (← ISPEC (← q r"y - x:real^N") NORM_LE_L1) THEN
     MATCH_MP_TAC (← REAL_ARITH (← q r"s < e ==> n <= s ==> n < e")) THEN
     MATCH_MP_TAC SUM_BOUND_LT_GEN THEN
     REWRITE_TAC [FINITE_NUMSEG, NUMSEG_EMPTY, NOT_LT, CARD_NUMSEG_1] THEN
     REWRITE_TAC [DIMINDEX_GE_1, IN_NUMSEG, VECTOR_SUB_COMPONENT] THEN
     X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
     REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:num"))) THEN ASM_REWRITE_TAC [] THEN
     ASM_REAL_ARITH_TAC)))

  let LINDELOF ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> open s)
        ==> ?f'. f' SUBSET f /\ COUNTABLE f' /\ UNIONS f' = UNIONS f"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?b. COUNTABLE b /\
          (!c:real^N->bool. c IN b ==> open c) /\
          (!s. open s ==> ?u. u SUBSET b /\ s = UNIONS u)")
    STRIP_ASSUME_TAC THENL [ASM_REWRITE_TAC [UNIV_SECOND_COUNTABLE], ALL_TAC] THEN
    ABBREV_TAC
     (← q r"d = {s:real^N->bool | s IN b /\ ?u. u IN f /\ s SUBSET u}") THEN
    SUBGOAL_THEN
     (← q r"COUNTABLE d /\ UNIONS f :real^N->bool = UNIONS d")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "d" THEN ASM_SIMP_TAC [COUNTABLE_RESTRICT] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!s:real^N->bool. ?u. s IN d ==> u IN f /\ s SUBSET u")
    MP_TAC THENL [EXPAND_TAC "d" THEN SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:(real^N->bool)->(real^N->bool)") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (g:(real^N->bool)->(real^N->bool)) d") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, UNIONS_IMAGE] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN ASM SET_TAC [])

  let LINDELOF_OPEN_IN ← prove
   r"!f u:real^N->bool.
        (!s. s IN f ==> open_in (subtopology euclidean u) s)
        ==> ?f'. f' SUBSET f /\ COUNTABLE f' /\ UNIONS f' = UNIONS f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_OPEN] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"v:(real^N->bool)->real^N->bool") THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE (v:(real^N->bool)->real^N->bool) f") LINDELOF) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f':(real^N->bool)->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
    (← q r"!f'. f' SUBSET f ==> UNIONS f' = (u:real^N->bool) INTER UNIONS (IMAGE v f')")
    MP_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC [SUBSET_REFL]])

  return { OPEN_SET_RATIONAL_COORDINATES, OPEN_COUNTABLE_UNION_OPEN_INTERVALS,
           OPEN_COUNTABLE_UNION_CLOSED_INTERVALS, LINDELOF, LINDELOF_OPEN_IN }

/- ------------------------------------------------------------------------- -/
/- Countability of disjoint open, compact-open and clopen families.          -/
/- (topology.ml 27327-27411)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CDO where
  COUNTABLE_DISJOINT_OPEN_IN_SUBSETS : thm
  COUNTABLE_DISJOINT_OPEN_SUBSETS : thm
  COUNTABLE_DISJOINT_NONEMPTY_INTERIOR_SUBSETS : thm
  COUNTABLE_COMPACT_OPEN_IN : thm
  COUNTABLE_CLOPEN_IN : thm
  deriving Inhabited

@[nospecialize]
def setupCDO [HolBase] (D : TopologyDeps) (BEUC : EUC) (BINT : INT) (BCPT : CPT) (BSEC : SEC)
    (BLND : LND) : ExceptT String IO CDO := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EQ_IMP, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IN_ELIM_THM, IN_IMAGE, IN_INSERT, .. } := D.core2
  let { IN_UNIONS, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, PAIRWISE_IMAGE, PAIRWISE_IMP, .. } :=
    D.core3
  let { RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_REFL, .. } := D.core5
  let { pairwise, .. } := D.core6
  let { COUNTABLE_FINITE_SUBSETS, COUNTABLE_IMAGE, COUNTABLE_IMAGE_INJ_EQ, COUNTABLE_INSERT,
        COUNTABLE_SUBSET, .. } := D.lib1
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_SUBSET_TRANS, SUBTOPOLOGY_UNIV, .. } := D.met3
  let { OPEN_IN, .. } := BEUC
  let { INTERIOR_SUBSET, OPEN_INTERIOR, .. } := BINT
  let { CLOSED_IN_COMPACT, COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY, .. } := BCPT
  let { SUBSET_SECOND_COUNTABLE, .. } := BSEC
  let { LINDELOF_OPEN_IN, .. } := BLND
  -- @@SCOPE END

  let COUNTABLE_DISJOINT_OPEN_IN_SUBSETS ← prove
   r"!f:(real^N->bool)->bool u.
        (!s. s IN f ==> open_in (subtopology euclidean u) s) /\
        pairwise DISJOINT f
        ==> COUNTABLE f"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP LINDELOF_OPEN_IN) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC (← q r"({}:real^N->bool) INSERT g") THEN
    ASM_REWRITE_TAC [COUNTABLE_INSERT] THEN
    REWRITE_TAC [SUBSET, IN_INSERT] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [EXTENSION, SUBSET] THEN
    REWRITE_TAC [IN_UNIONS, pairwise] THEN
    REWRITE_TAC [← SET_RULE (← q r"DISJOINT s t <=> !x. ~(x IN s /\ x IN t)")] THEN
    REWRITE_TAC [NOT_IN_EMPTY] THEN MESON_TAC [])

  let COUNTABLE_DISJOINT_OPEN_SUBSETS ← prove
   r"!f. (!s:real^N->bool. s IN f ==> open s) /\ pairwise DISJOINT f
       ==> COUNTABLE f"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:(real^N->bool)->bool", ← q r"(:real^N)"]
          COUNTABLE_DISJOINT_OPEN_IN_SUBSETS) THEN
    ASM_SIMP_TAC [← GSYM OPEN_IN, SUBTOPOLOGY_UNIV])

  let COUNTABLE_DISJOINT_NONEMPTY_INTERIOR_SUBSETS ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f /\ interior s = {} ==> s = {}) /\ pairwise DISJOINT f
        ==> COUNTABLE f"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE interior (f:(real^N->bool)->bool)")
          COUNTABLE_DISJOINT_OPEN_SUBSETS) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, OPEN_INTERIOR] THEN ANTS_TAC THENL
     [REWRITE_TAC [PAIRWISE_IMAGE],
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC COUNTABLE_IMAGE_INJ_EQ THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> p /\ q /\ ~s ==> ~r")] THEN
      REWRITE_TAC [← GSYM pairwise]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      PAIRWISE_IMP)) THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!s:real^N->bool. interior s SUBSET s) /\
      (!s t. interior s SUBSET s /\ interior t SUBSET t ==> P s t)
      ==> !s:real^N->bool t:real^N->bool. P s t")) THEN
    (CONJ_TAC THENL [REWRITE_TAC [INTERIOR_SUBSET], ALL_TAC]) THEN
    REPEAT (FIRST_ASSUM MP_TAC THEN MATCH_MP_TAC MONO_FORALL THEN
           GEN_TAC THEN REWRITE_TAC [RIGHT_IMP_FORALL_THM]) THEN
    SET_TAC [])

  let COUNTABLE_COMPACT_OPEN_IN ← prove
   r"!u:real^N->bool.
        COUNTABLE {c | compact c /\ open_in (subtopology euclidean u) c}"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q r"u:real^N->bool") SUBSET_SECOND_COUNTABLE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN EXISTS_TAC
     (← q r"IMAGE UNIONS {t:(real^N->bool)->bool | t SUBSET b /\ FINITE t}") THEN
    ASM_SIMP_TAC [COUNTABLE_FINITE_SUBSETS, COUNTABLE_IMAGE] THEN
    GEN_REWRITE_TAC id [SUBSET] THEN
    REWRITE_TAC [IN_IMAGE, IN_UNIONS, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o C MATCH_MP (← ASSUME
     (← q r"open_in (subtopology euclidean u) (c:real^N->bool)"))) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:(real^N->bool)->bool")
     (STRIP_ASSUME_TAC o GSYM)) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:(real^N->bool)->bool") o
      GEN_REWRITE_RULE id [COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY]) THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"v:real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^N->bool")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], STRIP_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          OPEN_IN_SUBSET_TRANS)) THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN ASM SET_TAC [],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:(real^N->bool)->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let COUNTABLE_CLOPEN_IN ← prove
   r"!u:real^N->bool.
        compact u
        ==> COUNTABLE {c | closed_in (subtopology euclidean u) c /\
                           open_in (subtopology euclidean u) c}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC COUNTABLE_SUBSET THEN EXISTS_TAC
     (← q r"{c:real^N->bool | compact c /\ open_in (subtopology euclidean u) c}") THEN
    REWRITE_TAC [COUNTABLE_COMPACT_OPEN_IN, SUBSET, IN_ELIM_THM] THEN
    ASM_MESON_TAC [CLOSED_IN_COMPACT])

  return { COUNTABLE_DISJOINT_OPEN_IN_SUBSETS, COUNTABLE_DISJOINT_OPEN_SUBSETS,
           COUNTABLE_DISJOINT_NONEMPTY_INTERIOR_SUBSETS, COUNTABLE_COMPACT_OPEN_IN,
           COUNTABLE_CLOPEN_IN }

/- ------------------------------------------------------------------------- -/
/- Cardinality of open, closed and compact sets; condensation points.        -/
/- (topology.ml 27412-27520)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CEO where
  CARD_EQ_OPEN_SETS : thm
  CARD_EQ_CLOSED_SETS : thm
  CARD_EQ_COMPACT_SETS : thm
  COUNTABLE_NON_CONDENSATION_POINTS : thm
  COUNTABLE_NON_LIMIT_POINTS : thm
  COUNTABLE_ISOLATED_SET : thm
  CARD_EQ_CONDENSATION_POINTS_IN_SET : thm
  deriving Inhabited

@[nospecialize]
def setupCEO [HolBase] (D : TopologyDeps) (BCLO : CLO) (BBAL : BAL) (BRLM : RLM) (BBLS : BLS)
    (BCPT : CPT) (BCPP1 : CPP1) (BSEC : SEC) : ExceptT String IO CEO := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, NORM_ARITH, .. } := D
  let { ARITH, COMPL_COMPL, CONTRAPOS_THM, DIMINDEX_GE_1, EQ_IMP, EQ_SYM_EQ, .. } := D.core1
  let { FORALL_IN_GSPEC, IMP_CONJ, INFINITE, INTER_UNIONS, IN_DIFF, IN_ELIM_THM, IN_INTER, .. } :=
    D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_C, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, .. } := D.core3
  let { SIMPLE_IMAGE_GEN, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_UNIV, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, UNIONS_GSPEC, UNIV_GSPEC, le_c, .. } := D.core6
  let { CARD_ADD_ABSORB_LEFT, CARD_DISJOINT_UNION, CARD_EQ_IMAGE, CARD_EQ_IMP_LE, CARD_EQ_REAL,
        CARD_EQ_SYM, CARD_EQ_TRANS, CARD_LE_ANTISYM, CARD_LE_POWERSET, CARD_LE_SUBSET,
        CARD_LE_TRANS, COUNTABLE_ALT, COUNTABLE_IMAGE, COUNTABLE_RESTRICT, COUNTABLE_SUBSET,
        COUNTABLE_UNION, COUNTABLE_UNIONS, FINITE_IMP_COUNTABLE, INFINITE_CARD_LE, .. } := D.lib1
  let { BASIS_NONZERO, .. } := D.vec1
  let { VECTOR_MUL_RCANCEL, .. } := D.vec4
  let { OPEN_CLOSED, .. } := BCLO
  let { OPEN_BALL, .. } := BBAL
  let { CONDENSATION_POINT_IMP_LIMPT, condensation_point_of, .. } := BRLM
  let { SUBSET_BALLS, .. } := BBLS
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { COMPACT_SING, .. } := BCPP1
  let { UNIV_SECOND_COUNTABLE, .. } := BSEC
  -- @@SCOPE END

  let CARD_EQ_OPEN_SETS ← prove
   r"{s:real^N->bool | open s} =_c (:real)"
   (REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [X_CHOOSE_THEN (← q r"b:(real^N->bool)->bool") STRIP_ASSUME_TAC
        UNIV_SECOND_COUNTABLE THEN
      TRANS_TAC CARD_LE_TRANS (← q r"{s:(real^N->bool)->bool | s SUBSET b}") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [LE_C] THEN
        EXISTS_TAC (← q r"UNIONS:((real^N->bool)->bool)->real^N->bool") THEN
        REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [],
        TRANS_TAC CARD_LE_TRANS (← q r"{s | s SUBSET (:num)}") THEN CONJ_TAC THENL
         [MATCH_MP_TAC CARD_LE_POWERSET THEN ASM_REWRITE_TAC [← GSYM COUNTABLE_ALT],
          REWRITE_TAC [SUBSET_UNIV, UNIV_GSPEC] THEN
          MESON_TAC [CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_EQ_REAL]]],
      REWRITE_TAC [le_c, IN_UNIV, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"\x. ball(x % basis 1:real^N,&1)") THEN
      REWRITE_TAC [OPEN_BALL, ← GSYM SUBSET_ANTISYM_EQ, SUBSET_BALLS] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(p:real^N,q) + &1 <= &1 <=> p = q")] THEN
      REWRITE_TAC [VECTOR_MUL_RCANCEL, EQ_SYM_EQ] THEN
      SIMP_TAC [BASIS_NONZERO, DIMINDEX_GE_1, ARITH]])

  let CARD_EQ_CLOSED_SETS ← prove
   r"{s:real^N->bool | closed s} =_c (:real)"
   (SUBGOAL_THEN
     (← q r"{s:real^N->bool | closed s} =
      IMAGE (\s. (:real^N) DIFF s) {s | open s}")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      REWRITE_TAC [IN_ELIM_THM, ← GSYM OPEN_CLOSED] THEN
      MESON_TAC [COMPL_COMPL],
      TRANS_TAC CARD_EQ_TRANS (← q r"{s:real^N->bool | open s}") THEN
      REWRITE_TAC [CARD_EQ_OPEN_SETS] THEN
      MATCH_MP_TAC CARD_EQ_IMAGE THEN SET_TAC []])

  let CARD_EQ_COMPACT_SETS ← prove
   r"{s:real^N->bool | compact s} =_c (:real)"
   (REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"{s:real^N->bool | closed s}") THEN
      SIMP_TAC [CARD_EQ_IMP_LE, CARD_EQ_CLOSED_SETS] THEN
      MATCH_MP_TAC CARD_LE_SUBSET THEN
      SIMP_TAC [SUBSET, IN_ELIM_THM, COMPACT_IMP_CLOSED],
      REWRITE_TAC [le_c, IN_UNIV, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"\x. {x % basis 1:real^N}") THEN
      REWRITE_TAC [COMPACT_SING, ← SET_RULE (← q r"{x} = {y} <=> x = y")] THEN
      SIMP_TAC [VECTOR_MUL_RCANCEL, BASIS_NONZERO, DIMINDEX_GE_1, ARITH]])

  let COUNTABLE_NON_CONDENSATION_POINTS ← prove
   r"!s:real^N->bool. COUNTABLE(s DIFF {x | x condensation_point_of s})"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [condensation_point_of] THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN
    X_CHOOSE_THEN (← q r"b:(real^N->bool)->bool") STRIP_ASSUME_TAC
     UNIV_SECOND_COUNTABLE THEN
    EXISTS_TAC
     (← q r"s INTER UNIONS { u:real^N->bool | u IN b /\ COUNTABLE(s INTER u)}") THEN
    REWRITE_TAC [INTER_UNIONS, IN_ELIM_THM] THEN CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_UNIONS THEN SIMP_TAC [FORALL_IN_GSPEC] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_RESTRICT],
      SIMP_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM, IN_INTER, IN_DIFF] THEN
      X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"?u:real^N->bool. x IN u /\ u IN b /\ u SUBSET t") MP_TAC THENL
       [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC COUNTABLE_SUBSET THEN
      EXISTS_TAC (← q r"s INTER t:real^N->bool") THEN ASM SET_TAC []])

  let COUNTABLE_NON_LIMIT_POINTS ← prove
   r"!s:real^N->bool. COUNTABLE(s DIFF {x | x limit_point_of s})"
   (GEN_TAC THEN MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC (← q r"s DIFF {x:real^N | x condensation_point_of s}") THEN
    REWRITE_TAC [COUNTABLE_NON_CONDENSATION_POINTS] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. Q x ==> P x) ==> s DIFF {x | P x} SUBSET s DIFF {x | Q x}")) THEN
    REWRITE_TAC [CONDENSATION_POINT_IMP_LIMPT])

  let COUNTABLE_ISOLATED_SET ← prove
   r"!s:real^N->bool.
        (!a. a IN s ==> ~(a limit_point_of s)) ==> COUNTABLE s"
   (GEN_TAC THEN DISCH_THEN (SUBST1_TAC o MATCH_MP (← SET_RULE
     (← q r"(!x. x IN s ==> ~(P x)) ==> s = s DIFF {x | P x}"))) THEN
    REWRITE_TAC [COUNTABLE_NON_LIMIT_POINTS])

  let CARD_EQ_CONDENSATION_POINTS_IN_SET ← prove
   r"!s:real^N->bool.
     ~(COUNTABLE s) ==> {x | x IN s /\ x condensation_point_of s} =_c s"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC CARD_EQ_TRANS
     (← q r"(s DIFF {x | x condensation_point_of s}) +_c
      {x:real^N | x IN s /\ x condensation_point_of s}") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN MATCH_MP_TAC CARD_ADD_ABSORB_LEFT THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [POP_ASSUM MP_TAC THEN REWRITE_TAC [INFINITE, CONTRAPOS_THM] THEN
        DISCH_THEN (MP_TAC o CONJ (← SPEC (← q r"s:real^N->bool")
         COUNTABLE_NON_CONDENSATION_POINTS) o MATCH_MP FINITE_IMP_COUNTABLE) THEN
        REWRITE_TAC [← GSYM COUNTABLE_UNION] THEN MATCH_MP_TAC EQ_IMP THEN
        AP_TERM_TAC THEN SET_TAC [],
        REWRITE_TAC [INFINITE_CARD_LE] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CARD_LE_TRANS) THEN
        REWRITE_TAC [← GSYM COUNTABLE_ALT, COUNTABLE_NON_CONDENSATION_POINTS]],
      ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
      W (MP_TAC o PART_MATCH (rand o rand) CARD_DISJOINT_UNION o rand o snd) THEN
      ANTS_TAC THENL [SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC []])

  return { CARD_EQ_OPEN_SETS, CARD_EQ_CLOSED_SETS, CARD_EQ_COMPACT_SETS,
           COUNTABLE_NON_CONDENSATION_POINTS, COUNTABLE_NON_LIMIT_POINTS, COUNTABLE_ISOLATED_SET,
           CARD_EQ_CONDENSATION_POINTS_IN_SET }

/- ------------------------------------------------------------------------- -/
/- Condensation points of condensation points; Cantor-Bendixson.             -/
/- (topology.ml 27521-27598)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CBX where
  LIMPT_OF_CONDENSATION_POINTS : thm
  CONDENSATION_POINT_OF_CONDENSATION_POINTS : thm
  CLOSED_CONDENSATION_POINTS : thm
  CANTOR_BENDIXSON_GEN : thm
  CANTOR_BENDIXSON : thm
  deriving Inhabited

@[nospecialize]
def setupCBX [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLOC : LOC) (BLPT : LPT) (BCLS1 : CLS1)
    (BRLM : RLM) (BCBL : CBL) (BBLS : BLS) (BCEO : CEO) : ExceptT String IO CBX := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        NORM_ARITH_TAC, .. } := D
  let { AND_FORALL_THM, CONTRAPOS_THM, .. } := D.core1
  let { IMP_CONJ_ALT, IMP_IMP, INTER_SUBSET, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNION, MONO_FORALL, .. } := D.core3
  let { SUBSET, SUBSET_TRANS, .. } := D.core5
  let { CARD_COUNTABLE_CONG, COUNTABLE_SUBSET, COUNTABLE_UNION, UNCOUNTABLE_REAL, .. } := D.lib1
  let { REAL_HALF, .. } := D.misc
  let { DIST_REFL, .. } := D.vec1
  let { IN_BALL, .. } := BBAL
  let { CLOSED_IN_CLOSED_INTER, CLOSED_IN_CLOSED_TRANS, .. } := BLOC
  let { CLOSED_LIMPT, LIMPT_APPROACHABLE, .. } := BLPT
  let { SUBSET_CLOSURE, closure, .. } := BCLS1
  let { CONDENSATION_POINT_IMP_LIMPT, CONDENSATION_POINT_INFINITE_BALL,
        CONDENSATION_POINT_OF_SUBSET, condensation_point_of, .. } := BRLM
  let { CLOSURE_BALL, .. } := BCBL
  let { SUBSET_BALLS, .. } := BBLS
  let { COUNTABLE_NON_CONDENSATION_POINTS, CARD_EQ_CONDENSATION_POINTS_IN_SET, .. } := BCEO
  -- @@SCOPE END

  let (LIMPT_OF_CONDENSATION_POINTS, CONDENSATION_POINT_OF_CONDENSATION_POINTS) ←
    CONJ_PAIR (← prove
   r"(!x:real^N s.
        x limit_point_of {y | y condensation_point_of s} <=>
        x condensation_point_of s) /\
   (!x:real^N s.
        x condensation_point_of {y | y condensation_point_of s} <=>
        x condensation_point_of s)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN MATCH_MP_TAC (← TAUT
     (← q r"(r ==> q) /\ (q ==> p) /\ (p ==> r)
      ==> (q <=> p) /\ (r <=> p)")) THEN
    REWRITE_TAC [CONDENSATION_POINT_IMP_LIMPT] THEN CONJ_TAC THENL
     [REWRITE_TAC [LIMPT_APPROACHABLE, CONDENSATION_POINT_INFINITE_BALL] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
      SIMP_TAC [SUBSET, IN_INTER, IN_BALL] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN NORM_ARITH_TAC,
      ONCE_REWRITE_TAC [CONDENSATION_POINT_INFINITE_BALL] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN DISCH_THEN (MP_TAC o MATCH_MP
       (← MESON [CARD_EQ_CONDENSATION_POINTS_IN_SET, CARD_COUNTABLE_CONG]
          (← q r"~COUNTABLE s
           ==> ~COUNTABLE {x | x IN s /\ x condensation_point_of s}"))) THEN
      REWRITE_TAC [UNCOUNTABLE_REAL, CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INTER] THEN X_GEN_TAC (← q r"y:real^N") THEN
      REPEAT STRIP_TAC THENL
       [ASM_MESON_TAC [CONDENSATION_POINT_OF_SUBSET, INTER_SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"!s. x IN s /\ s SUBSET t ==> x IN t")) THEN
      EXISTS_TAC (← q r"closure(s INTER ball(x:real^N,e / &2))") THEN CONJ_TAC THENL
       [REWRITE_TAC [closure, IN_UNION, IN_ELIM_THM] THEN DISJ2_TAC THEN
        ASM_SIMP_TAC [CONDENSATION_POINT_IMP_LIMPT],
        TRANS_TAC SUBSET_TRANS (← q r"closure(ball(x:real^N,e / &2))") THEN
        SIMP_TAC [SUBSET_CLOSURE, INTER_SUBSET] THEN
        ASM_SIMP_TAC [CLOSURE_BALL, REAL_HALF, SUBSET_BALLS, DIST_REFL] THEN
        ASM_REAL_ARITH_TAC]]))

  let CLOSED_CONDENSATION_POINTS ← prove
   r"!s:real^N->bool. closed {x | x condensation_point_of s}"
   (SIMP_TAC [CLOSED_LIMPT, LIMPT_OF_CONDENSATION_POINTS, IN_ELIM_THM])

  let CANTOR_BENDIXSON_GEN ← prove
   r"!s:real^N->bool.
      ?t u.
        closed_in (subtopology euclidean s) t /\
        (!x. x IN t ==> x condensation_point_of t) /\
        COUNTABLE u /\ DISJOINT t u /\ s = t UNION u"
   (GEN_TAC THEN
    EXISTS_TAC (← q r"s INTER {x:real^N | x condensation_point_of s}") THEN
    EXISTS_TAC (← q r"s DIFF {x:real^N | x condensation_point_of s}") THEN
    SIMP_TAC [CLOSED_IN_CLOSED_INTER, CLOSED_CONDENSATION_POINTS] THEN
    REWRITE_TAC [COUNTABLE_NON_CONDENSATION_POINTS] THEN
    CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [condensation_point_of] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [CONTRAPOS_THM] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") COUNTABLE_NON_CONDENSATION_POINTS) THEN
    REWRITE_TAC [IMP_IMP, ← GSYM COUNTABLE_UNION] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN SET_TAC [])

  let CANTOR_BENDIXSON ← prove
   r"!s:real^N->bool.
        closed s
        ==> ?t u. closed t /\ (!x. x IN t ==> x limit_point_of t) /\
                  COUNTABLE u /\ DISJOINT t u /\ s = t UNION u"
   (MESON_TAC [CLOSED_IN_CLOSED_TRANS, CANTOR_BENDIXSON_GEN,
               CONDENSATION_POINT_IMP_LIMPT])

  return { LIMPT_OF_CONDENSATION_POINTS, CONDENSATION_POINT_OF_CONDENSATION_POINTS,
           CLOSED_CONDENSATION_POINTS, CANTOR_BENDIXSON_GEN, CANTOR_BENDIXSON }

/- ------------------------------------------------------------------------- -/
/- A discrete set is countable, and an uncountable set has a limit point.    -/
/- (topology.ml 27599-27644)                                                 -/
/- ------------------------------------------------------------------------- -/

structure DSC where
  DISCRETE_IMP_COUNTABLE : thm
  UNCOUNTABLE_CONTAINS_LIMIT_POINT : thm
  deriving Inhabited

@[nospecialize]
def setupDSC [HolBase] (D : TopologyDeps) (BLPT : LPT) (BCLS1 : CLS1) (BDYR : DYR) :
    ExceptT String IO DSC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, NORM_ARITH_TAC, .. } := D
  let { CONTRAPOS_THM, COUNTABLE, .. } := D.core1
  let { IN_ELIM_THM, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core3
  let { REAL_LT_ANTISYM, .. } := D.core4
  let { REAL_NOT_LT, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, .. } := D.core5
  let { ge_c, le_c, .. } := D.core6
  let { CARD_LE_TRANS, .. } := D.lib1
  let { COUNTABLE_RATIONAL_COORDINATES, REAL_HALF, .. } := D.misc
  let { dist, .. } := D.vec4
  let { LIMPT_APPROACHABLE, .. } := BLPT
  let { CLOSURE_APPROACHABLE, .. } := BCLS1
  let { CLOSURE_RATIONAL_COORDINATES, .. } := BDYR
  -- @@SCOPE END

  let DISCRETE_IMP_COUNTABLE ← prove
   r"!s:real^N->bool.
        (!x. x IN s ==> ?e. &0 < e /\
                            !y. y IN s /\ ~(y = x) ==> e <= norm(y - x))
        ==> COUNTABLE s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN s
          ==> ?q. (!i. 1 <= i /\ i <= dimindex(:N) ==> rational(q$i)) /\
                  !y:real^N. y IN s /\ ~(y = x) ==> norm(x - q) < norm(y - q)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← SET_RULE (← q r"x IN (:real^N)")) THEN
      REWRITE_TAC [← GSYM CLOSURE_RATIONAL_COORDINATES] THEN
      REWRITE_TAC [CLOSURE_APPROACHABLE, IN_ELIM_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"q:real^N") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN ASM_REWRITE_TAC [] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN NORM_ARITH_TAC,
      POP_ASSUM (K ALL_TAC : thm → tactic) THEN
      REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"q:real^N->real^N") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL
       [← q r"s:real^N->bool",
        ← q r"{ x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i) }",
        ← q r"(:num)"] CARD_LE_TRANS) THEN
      REWRITE_TAC [COUNTABLE, ge_c] THEN DISCH_THEN MATCH_MP_TAC THEN
      SIMP_TAC [← REWRITE_RULE [COUNTABLE, ge_c] COUNTABLE_RATIONAL_COORDINATES] THEN
      REWRITE_TAC [le_c] THEN EXISTS_TAC (← q r"q:real^N->real^N") THEN
      ASM_SIMP_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [REAL_LT_ANTISYM]])

  let UNCOUNTABLE_CONTAINS_LIMIT_POINT ← prove
   r"!s. ~(COUNTABLE s) ==> ?x. x IN s /\ x limit_point_of s"
   (GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP
     (← ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM] DISCRETE_IMP_COUNTABLE)) THEN
    REWRITE_TAC [LIMPT_APPROACHABLE, ← GSYM REAL_NOT_LT, dist] THEN
    MESON_TAC [])

  return { DISCRETE_IMP_COUNTABLE, UNCOUNTABLE_CONTAINS_LIMIT_POINT }

/- ------------------------------------------------------------------------- -/
/- Theorems about left and right limits on R^1.  (topology.ml 27645-27737)   -/
/- ------------------------------------------------------------------------- -/

structure LRL where
  EVENTUALLY_WITHIN_RIGHT_ALT_GEN : thm
  EVENTUALLY_WITHIN_RIGHT_ALT : thm
  RIGHT_LIMIT_WITHIN_ALT : thm
  RIGHT_LIMIT_ALT : thm
  EVENTUALLY_WITHIN_LEFT_ALT_GEN : thm
  EVENTUALLY_WITHIN_LEFT_ALT : thm
  LEFT_LIMIT_WITHIN_ALT : thm
  LEFT_LIMIT_ALT : thm
  TWO_SIDED_LIMIT_WITHIN : thm
  TWO_SIDED_LIMIT_AT : thm
  NON_TRIVIAL_LIMIT_LEFT : thm
  NON_TRIVIAL_LIMIT_RIGHT : thm
  deriving Inhabited

@[nospecialize]
def setupLRL [HolBase] (D : TopologyDeps) (BLPT : LPT) (BNET : NET) (BEVT : EVT) (BLIM1 : LIM1) :
    ExceptT String IO LRL := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, REAL_ARITH_TAC, .. } := D
  let { AND_FORALL_THM, EXTENSION, .. } := D.core1
  let { IN_DELETE, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, .. } := D.core3
  let { REAL_LE_TOTAL, .. } := D.core4
  let { DIST_1, DROP_ADD, DROP_EQ, DROP_SUB, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { EVENTUALLY_AND, EVENTUALLY_WITHIN_INTER_IMP, .. } := D.met2
  let { WITHIN_WITHIN, .. } := D.met3
  let { LIMPT_APPROACHABLE_LE, .. } := BLPT
  let { WITHIN_UNIV, .. } := BNET
  let { EVENTUALLY_WITHIN_DELETE, TRIVIAL_LIMIT_WITHIN, .. } := BEVT
  let { tendsto, .. } := BLIM1
  -- @@SCOPE END

  let EVENTUALLY_WITHIN_RIGHT_ALT_GEN ← prove
   r"!P s a. eventually P (at a within {x | x IN s /\ drop a <= drop x}) <=>
           eventually P (at a within {x | x IN s /\ drop a < drop x})"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM EVENTUALLY_WITHIN_DELETE] THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_DELETE] THEN
    X_GEN_TAC (← q r"x:real^1") THEN ASM_CASES_TAC (← q r"(x:real^1) IN s") THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, ← GSYM DROP_EQ] THEN REAL_ARITH_TAC)

  let EVENTUALLY_WITHIN_RIGHT_ALT ← prove
   r"!P a. eventually P (at a within {x | drop a <= drop x}) <=>
         eventually P (at a within {x | drop a < drop x})"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"P:real^1->bool", ← q r"(:real^1)", ← q r"a:real^1"]
          EVENTUALLY_WITHIN_RIGHT_ALT_GEN) THEN
    REWRITE_TAC [IN_UNIV])

  let RIGHT_LIMIT_WITHIN_ALT ← prove
   r"!f l s a. (f --> l) (at a within {x | x IN s /\ drop a <= drop x}) <=>
             (f --> l) (at a within {x | x IN s /\ drop a < drop x})"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHIN_RIGHT_ALT_GEN])

  let RIGHT_LIMIT_ALT ← prove
   r"!f l a. (f --> l) (at a within {x | drop a <= drop x}) <=>
           (f --> l) (at a within {x | drop a < drop x})"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHIN_RIGHT_ALT])

  let EVENTUALLY_WITHIN_LEFT_ALT_GEN ← prove
   r"!P s a. eventually P (at a within {x | x IN s /\ drop x <= drop a}) <=>
           eventually P (at a within {x | x IN s /\ drop x < drop a})"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM EVENTUALLY_WITHIN_DELETE] THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_DELETE] THEN
    X_GEN_TAC (← q r"x:real^1") THEN ASM_CASES_TAC (← q r"(x:real^1) IN s") THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, ← GSYM DROP_EQ] THEN REAL_ARITH_TAC)

  let EVENTUALLY_WITHIN_LEFT_ALT ← prove
   r"!P a. eventually P (at a within {x | drop x <= drop a}) <=>
         eventually P (at a within {x | drop x < drop a})"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"P:real^1->bool", ← q r"(:real^1)", ← q r"a:real^1"]
          EVENTUALLY_WITHIN_LEFT_ALT_GEN) THEN
    REWRITE_TAC [IN_UNIV])

  let LEFT_LIMIT_WITHIN_ALT ← prove
   r"!f l s a. (f --> l) (at a within {x | x IN s /\ drop x <= drop a}) <=>
             (f --> l) (at a within {x | x IN s /\ drop x < drop a})"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHIN_LEFT_ALT_GEN])

  let LEFT_LIMIT_ALT ← prove
   r"!f l a. (f --> l) (at a within {x | drop x <= drop a}) <=>
           (f --> l) (at a within {x | drop x < drop a})"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHIN_LEFT_ALT])

  let TWO_SIDED_LIMIT_WITHIN ← prove
   r"!f s a l:real^N.
        (f --> l) (at a within s) <=>
        (f --> l) (at a within s INTER {x | drop x <= drop a}) /\
        (f --> l) (at a within s INTER {x | drop a <= drop x})"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto] THEN
    REWRITE_TAC [AND_FORALL_THM, ← TAUT
     (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    REWRITE_TAC [EVENTUALLY_WITHIN_INTER_IMP, ← GSYM EVENTUALLY_AND] THEN
    REWRITE_TAC [← TAUT (← q r"(p ==> r) /\ (q ==> r) <=> p \/ q ==> r")] THEN
    REWRITE_TAC [IN_ELIM_THM, REAL_LE_TOTAL])

  let TWO_SIDED_LIMIT_AT ← prove
   r"!f a l:real^N.
        (f --> l) (at a) <=>
        (f --> l) (at a within {x | drop x <= drop a}) /\
        (f --> l) (at a within {x | drop a <= drop x})"
   (REPEAT GEN_TAC THEN
    SUBST1_TAC (← SYM (← ISPEC (← q r"a:real^1") WITHIN_UNIV)) THEN
    REWRITE_TAC [WITHIN_WITHIN, ← GSYM TWO_SIDED_LIMIT_WITHIN])

  let NON_TRIVIAL_LIMIT_LEFT ← prove
   r"!a. ~trivial_limit (at a within {x | drop x <= drop a})"
   (GEN_TAC THEN REWRITE_TAC [TRIVIAL_LIMIT_WITHIN, LIMPT_APPROACHABLE_LE] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"a - lift e") THEN
    REWRITE_TAC [IN_ELIM_THM, DIST_1, DROP_SUB, LIFT_DROP, ← GSYM DROP_EQ] THEN
    ASM_REAL_ARITH_TAC)

  let NON_TRIVIAL_LIMIT_RIGHT ← prove
   r"!a. ~trivial_limit (at a within {x | drop a <= drop x})"
   (GEN_TAC THEN REWRITE_TAC [TRIVIAL_LIMIT_WITHIN, LIMPT_APPROACHABLE_LE] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"a + lift e") THEN
    REWRITE_TAC [IN_ELIM_THM, DIST_1, DROP_ADD, DROP_SUB,
                 LIFT_DROP, ← GSYM DROP_EQ] THEN
    ASM_REAL_ARITH_TAC)

  return { EVENTUALLY_WITHIN_RIGHT_ALT_GEN, EVENTUALLY_WITHIN_RIGHT_ALT, RIGHT_LIMIT_WITHIN_ALT,
           RIGHT_LIMIT_ALT, EVENTUALLY_WITHIN_LEFT_ALT_GEN, EVENTUALLY_WITHIN_LEFT_ALT,
           LEFT_LIMIT_WITHIN_ALT, LEFT_LIMIT_ALT, TWO_SIDED_LIMIT_WITHIN, TWO_SIDED_LIMIT_AT,
           NON_TRIVIAL_LIMIT_LEFT, NON_TRIVIAL_LIMIT_RIGHT }

/- ------------------------------------------------------------------------- -/
/- Countably many trivial or noncontinuous one-sided limits on R^1.          -/
/- (topology.ml 27738-27950)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CTL where
  COUNTABLE_TRIVIAL_RIGHT_LIMITS : thm
  COUNTABLE_TRIVIAL_LEFT_LIMITS : thm
  COUNTABLE_NONCONTINUOUS_RIGHT_LIMITS : thm
  COUNTABLE_NONCONTINUOUS_LEFT_LIMITS : thm
  COUNTABLE_NONCONTINUOUS_ONE_SIDED_LIMITS : thm
  deriving Inhabited

@[nospecialize]
def setupCTL [HolBase] (D : TopologyDeps) (BLOC : LOC) (BLPT : LPT) (BEVT : EVT) (BLIM1 : LIM1)
    (BLIM2 : LIM2) (BCNT1 : CNT1) (BITV1 : ITV1) (BITV3 : ITV3) (BR1A : R1A) (BCDO : CDO) :
    ExceptT String IO CTL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { CONJ_ASSOC, DIFF_INTERS, DISJOINT, DISJOINT_SYM, EQ_IMP, EXISTS_REFL, EXTENSION, .. } :=
    D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, INTERS_GSPEC, IN_DIFF, IN_ELIM_THM, IN_INTER, .. } :=
    D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY,
        PAIRWISE_IMAGE, .. } := D.core3
  let { REAL_LE_NEG2, REAL_LT_ADDR, REAL_LT_INV_EQ, REAL_LT_MIN, .. } := D.core4
  let { REAL_LT_TRANS, REAL_NOT_LT, REAL_SUB_LT, REAL_WLOG_LT, RIGHT_IMP_EXISTS_THM,
        SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, pairwise, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_IMAGE_INJ_EQ, COUNTABLE_SUBSET, COUNTABLE_UNION,
        COUNTABLE_UNIONS, NUM_COUNTABLE, .. } := D.lib1
  let { FORALL_POS_MONO_1_EQ, REAL_HALF, .. } := D.misc
  let { DIST_1, DIST_SYM, DROP_ADD, DROP_EQ, DROP_NEG, FORALL_DROP, FORALL_LIFT, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { VECTOR_NEG_NEG, .. } := D.vec4
  let { EVENTUALLY_FALSE, .. } := D.met2
  let { OPEN_IN_OPEN_INTER, .. } := BLOC
  let { LIMPT_APPROACHABLE, .. } := BLPT
  let { EVENTUALLY_WITHIN_REFLECT, TRIVIAL_LIMIT_WITHIN, .. } := BEVT
  let { LIM_AT_REFLECT, LIM_WITHIN_REFLECT, .. } := BLIM1
  let { LIM_WITHIN, .. } := BLIM2
  let { CONTINUOUS_EQ_CAUCHY_WITHIN, CONTINUOUS_WITHIN, .. } := BCNT1
  let { OPEN_INTERVAL, .. } := BITV1
  let { EQ_INTERVAL, .. } := BITV3
  let { DISJOINT_INTERVAL_1, INTERVAL_EQ_EMPTY_1, IN_INTERVAL_1, .. } := BR1A
  let { COUNTABLE_DISJOINT_OPEN_IN_SUBSETS, COUNTABLE_DISJOINT_OPEN_SUBSETS, .. } := BCDO
  -- @@SCOPE END

  let COUNTABLE_TRIVIAL_RIGHT_LIMITS ← prove
   r"!s. COUNTABLE {x | x IN s /\
                      trivial_limit
                        (at x within {t | t IN s /\ drop x <= drop t})}"
   (GEN_TAC THEN ABBREV_TAC
     (← q r"C = {x | x IN s /\
               trivial_limit(at x within {t | t IN s /\ drop x <= drop t})}") THEN
    SUBGOAL_THEN
     (← q r"!a. a IN C ==> ?b. drop a < drop b /\ DISJOINT s (interval(a,b))")
    MP_TAC THENL
     [X_GEN_TAC (← q r"a:real^1") THEN EXPAND_TAC "C" THEN
      REWRITE_TAC [IN_ELIM_THM, TRIVIAL_LIMIT_WITHIN, LIMPT_APPROACHABLE] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:real") THEN REWRITE_TAC [NOT_EXISTS_THM, ← GSYM DROP_EQ] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, DIST_1, ← REAL_ARITH
       (← q r"a <= x /\ ~(x = a) /\ abs(x - a) < d <=> a < x /\ x < a + d")] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"a + lift d") THEN
      ASM_REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, IN_INTERVAL_1] THEN
      REWRITE_TAC [DROP_ADD, LIFT_DROP, NOT_IN_EMPTY, REAL_LT_ADDR] THEN
      ASM_MESON_TAC [],
      REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"B:real^1->real^1") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"COUNTABLE (IMAGE (\a:real^1. interval(a,B a)) C)")
    MP_TAC THENL
     [MATCH_MP_TAC COUNTABLE_DISJOINT_OPEN_SUBSETS THEN
      REWRITE_TAC [FORALL_IN_IMAGE, OPEN_INTERVAL] THEN
      REWRITE_TAC [PAIRWISE_IMAGE, DISJOINT_INTERVAL_1, DISJOINT] THEN
      REWRITE_TAC [pairwise, EQ_INTERVAL] THEN ASM_SIMP_TAC [DROP_EQ, ← REAL_ARITH
       (← q r"a < a' /\ b < b' /\ ~(a = b)
        ==> (a' <= a \/ b' <= b \/ a' <= b \/ b' <= a <=>
             ~(a < b /\ b < a') /\ ~(b < a /\ a < b'))")] THEN
      REWRITE_TAC [← GSYM IN_INTERVAL_1] THEN ASM SET_TAC [],
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC COUNTABLE_IMAGE_INJ_EQ THEN
      ASM_SIMP_TAC [EQ_INTERVAL, IMP_CONJ, INTERVAL_EQ_EMPTY_1, ← GSYM
                    REAL_NOT_LT]])

  let COUNTABLE_TRIVIAL_LEFT_LIMITS ← prove
   r"!s. COUNTABLE {x | x IN s /\
                      trivial_limit
                        (at x within {t | t IN s /\ drop t <= drop x})}"
   (GEN_TAC THEN MP_TAC (← ISPEC
     (← q r"IMAGE (--) (s:real^1->bool)") COUNTABLE_TRIVIAL_RIGHT_LIMITS) THEN
    REWRITE_TAC [← GSYM EVENTUALLY_FALSE] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [← GSYM EVENTUALLY_WITHIN_REFLECT] THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"(--):real^1->real^1") o
      MATCH_MP COUNTABLE_IMAGE) THEN
    REWRITE_TAC [EVENTUALLY_FALSE] THEN
    SIMP_TAC [VECTOR_NEG_NEG, ← SET_RULE
     (← q r"(!x. n(n x) = x)
      ==> IMAGE n {x | x IN IMAGE n s /\ P x} = {x | x IN s /\ P(n x)}")] THEN
    REWRITE_TAC [DROP_NEG, REAL_LE_NEG2])

  let COUNTABLE_NONCONTINUOUS_RIGHT_LIMITS ← prove
   r"!f:real^1->real^N s.
      COUNTABLE
       {x | x IN s /\
            (?l. (f --> l) (at x within {t | t IN s /\ drop x <= drop t})) /\
            ~(f continuous (at x within s))}"
   (REPEAT GEN_TAC THEN
    ABBREV_TAC
     (← q r"C = {x | x IN s /\
               trivial_limit(at x within {t | t IN s /\ drop x <= drop t})}") THEN
    SUBGOAL_THEN (← q r"COUNTABLE(C:real^1->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "C" THEN REWRITE_TAC [COUNTABLE_TRIVIAL_RIGHT_LIMITS],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"L = {x | x IN s /\
               ?l. ((f:real^1->real^N) --> l)
                   (at x within {t | t IN s /\ drop x <= drop t})}") THEN
    ABBREV_TAC
     (← q r"U = \n. {a | ?d. &0 < d /\
                       !x y. x IN s /\ y IN s /\
                             dist(a:real^1,x) < d /\ dist(a,y) < d
                             ==> dist(f x:real^N,f y) < inv(&n + &1)}") THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\
           (?l:real^N. (f --> l)
                       (at x within {t | t IN s /\ drop x <= drop t})) /\
           ~(f continuous (at x within s))} =
      L DIFF INTERS {U n | n IN (:num)}")
    SUBST1_TAC THENL
     [MAP_EVERY EXPAND_TAC ["L", "U"] THEN
      GEN_REWRITE_TAC id [EXTENSION] THEN
      REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_DIFF, IN_UNIV] THEN
      X_GEN_TAC (← q r"a:real^1") THEN
      ASM_CASES_TAC (← q r"(a:real^1) IN s") THEN ASM_REWRITE_TAC [] THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN
      W (MP_TAC o PART_MATCH (rand o rand) FORALL_POS_MONO_1_EQ o rand o snd) THEN
      ANTS_TAC THENL
       [MESON_TAC [REAL_LT_TRANS], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      REWRITE_TAC [CONTINUOUS_EQ_CAUCHY_WITHIN] THEN
      REPEAT (AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC) THEN ABS_TAC THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"a IN s ==> a INSERT s = s")] THEN
      REWRITE_TAC [DIST_SYM] THEN MESON_TAC [],
      REWRITE_TAC [DIFF_INTERS] THEN MATCH_MP_TAC COUNTABLE_UNIONS THEN
      REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE] THEN
      SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, IN_UNIV]] THEN
    X_GEN_TAC (← q r"n:num") THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC (← q r"(L DIFF (U:num->real^1->bool) n DIFF C) UNION C") THEN
    CONJ_TAC THENL [ASM_REWRITE_TAC [COUNTABLE_UNION], SET_TAC []] THEN
    SUBGOAL_THEN
     (← q r"!a. a IN L
          ==> ?b. drop a < drop b /\ s INTER interval(a,b) SUBSET U(n:num)")
    MP_TAC THENL
     [GEN_TAC THEN MAP_EVERY EXPAND_TAC ["L", "U"] THEN
      REWRITE_TAC [IN_ELIM_THM, SUBSET] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [LIM_WITHIN, LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"l:real^N") THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(&n + &1) / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      REWRITE_TAC [IN_ELIM_THM, DIST_1, ← REAL_ARITH
       (← q r"a <= x /\ &0 < abs(x - a) /\ abs(x - a) < d <=>
        a < x /\ x < a + d")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"a + lift d") THEN
      ASM_SIMP_TAC [SUBSET, IN_INTERVAL_1, IN_INTER, IN_ELIM_THM, DROP_ADD] THEN
      ASM_REWRITE_TAC [LIFT_DROP, REAL_LT_ADDR] THEN
      X_GEN_TAC (← q r"b:real^1") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"min (drop b - drop a) ((drop a + d) - drop b)") THEN
      ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"!l:real^N. dist(x,l) < e / &2 /\ dist(y,l) < e / &2
                   ==> dist(x,y) < e")) THEN
      EXISTS_TAC (← q r"l:real^N") THEN CONJ_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"B:real^1->real^1") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"COUNTABLE (IMAGE (\a:real^1. s INTER interval(a,B a))
                       (L DIFF U(n:num) DIFF C))")
    MP_TAC THENL
     [MATCH_MP_TAC COUNTABLE_DISJOINT_OPEN_IN_SUBSETS THEN
      EXISTS_TAC (← q r"s:real^1->bool") THEN
      SIMP_TAC [FORALL_IN_IMAGE, OPEN_IN_OPEN_INTER, OPEN_INTERVAL] THEN
      REWRITE_TAC [PAIRWISE_IMAGE] THEN REWRITE_TAC [pairwise, FORALL_LIFT] THEN
      MATCH_MP_TAC REAL_WLOG_LT THEN REWRITE_TAC [] THEN CONJ_TAC THENL
       [REWRITE_TAC [DISJOINT_SYM] THEN MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [LIFT_DROP, FORALL_DROP] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN DISCH_TAC THEN
      REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"t INTER u = {} ==> DISJOINT (s INTER t) (s INTER u)")) THEN
      ASM_REWRITE_TAC [DISJOINT_INTERVAL_1] THEN
      SUBGOAL_THEN (← q r"~(b IN interval(a:real^1,B a))") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC],
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC COUNTABLE_IMAGE_INJ_EQ THEN
      REWRITE_TAC [EQ_INTERVAL, INTERVAL_EQ_EMPTY_1, IN_DIFF, IMP_CONJ] THEN
      REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN REPEAT DISCH_TAC THEN
      UNDISCH_TAC (← q r"~((a:real^1) IN C)") THEN EXPAND_TAC "C" THEN
      REWRITE_TAC [IN_ELIM_THM, TRIVIAL_LIMIT_WITHIN, LIMPT_APPROACHABLE] THEN
      ASM_CASES_TAC (← q r"(a:real^1) IN s") THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN
       (MP_TAC o SPEC (← q r"min (drop(B a) - drop a) (drop b - drop a)")) THEN
      ASM_SIMP_TAC [REAL_LT_MIN, REAL_SUB_LT, DIST_1, ← GSYM DROP_EQ] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^1") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"x IN (s INTER interval(a:real^1,B a))") MP_TAC THENL
       [REWRITE_TAC [IN_INTER, IN_INTERVAL_1] THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [IN_INTER, IN_INTERVAL_1] THEN
        ASM_REAL_ARITH_TAC]])

  let COUNTABLE_NONCONTINUOUS_LEFT_LIMITS ← do
    let lemma ← prove
     r"{x | P x} = {--x:real^N | P (--x)}"
     (REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN MESON_TAC [VECTOR_NEG_NEG])
    prove
     r"!f:real^1->real^N s.
        COUNTABLE {x | x IN s /\
                       (?l. (f --> l)
                            (at x within {t | t IN s /\ drop t <= drop x})) /\
                       ~(f continuous (at x within s))}"
     (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_WITHIN] THEN
      ONCE_REWRITE_TAC [← GSYM LIM_WITHIN_REFLECT, ← GSYM LIM_AT_REFLECT] THEN
      ONCE_REWRITE_TAC [lemma] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      MATCH_MP_TAC COUNTABLE_IMAGE THEN REWRITE_TAC [VECTOR_NEG_NEG] THEN
      MP_TAC (← ISPECL [← q r"\x. (f:real^1->real^N) (--x)",
                        ← q r"IMAGE (--) (s:real^1->bool)"]
        COUNTABLE_NONCONTINUOUS_RIGHT_LIMITS) THEN
      REWRITE_TAC [CONTINUOUS_WITHIN] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:real^1") THEN
      SIMP_TAC [IN_ELIM_THM, VECTOR_NEG_NEG, ← SET_RULE
       (← q r"(!x. n(n x) = x) ==> (x IN IMAGE n s <=> n x IN s)")] THEN
      AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      REWRITE_TAC [EXISTS_REFL, ← VECTOR_ARITH (← q r"--x:real^N = y <=> x = --y")] THEN
      REWRITE_TAC [IN_ELIM_THM, VECTOR_NEG_NEG, DROP_NEG] THEN
      GEN_TAC THEN AP_TERM_TAC THEN REAL_ARITH_TAC)

  let COUNTABLE_NONCONTINUOUS_ONE_SIDED_LIMITS ← prove
   r"!f:real^1->real^N s.
      COUNTABLE {x | x IN s /\
                     ((?l. (f --> l)
                           (at x within {t | t IN s /\ drop t <= drop x})) \/
                      (?l. (f --> l)
                           (at x within {t | t IN s /\ drop x <= drop t}))) /\
                     ~(f continuous (at x within s))}"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"s:real^1->bool"]
       COUNTABLE_NONCONTINUOUS_RIGHT_LIMITS) THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"s:real^1->bool"]
       COUNTABLE_NONCONTINUOUS_LEFT_LIMITS) THEN
    REWRITE_TAC [← GSYM COUNTABLE_UNION, IMP_IMP] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [])

  return { COUNTABLE_TRIVIAL_RIGHT_LIMITS, COUNTABLE_TRIVIAL_LEFT_LIMITS,
           COUNTABLE_NONCONTINUOUS_RIGHT_LIMITS, COUNTABLE_NONCONTINUOUS_LEFT_LIMITS,
           COUNTABLE_NONCONTINUOUS_ONE_SIDED_LIMITS }

/- ------------------------------------------------------------------------- -/
/- A closed local homeomorphism is proper: it actually has finite preimages. -/
/- (topology.ml 27951-28210)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CLH where
  CLOSED_LOCAL_HOMEOMORPHISM_IMP_PROPER_GEN : thm
  CLOSED_LOCAL_HOMEOMORPHISM_IMP_PROPER : thm
  deriving Inhabited

@[nospecialize]
def setupCLH [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLOC : LOC)
    (BLPT : LPT) (BCLS2 : CLS2) (BLIM1 : LIM1) (BLIM2 : LIM2) (BRLM : RLM) (BUNQ : UNQ)
    (BSEQ : SEQ) (BBND1 : BND1) (BCPP1 : CPP1) (BCSL : CSL) (BSQC : SQC) (BCLC : CLC)
    (BPRP1 : PRP1) (BCCM1 : CCM1) (BHMA : HMA) (BDSC : DSC) : ExceptT String IO CLH := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON, REAL_ARITH, SET_RULE,
        SET_TAC, REAL_RAT_REDUCE_CONV, NORM_ARITH, .. } := D
  let { CONJ_ASSOC, DEPENDENT_CHOICE, DISJOINT, EXTENSION, .. } := D.core1
  let { FINITE_SING, FINITE_SUBSET, FORALL_AND_THM, FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IN,
        INFINITE, INJECTIVE_ALT, INTER_SUBSET, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM, NOT_IMP,
        NOT_IN_EMPTY, PSUBSET, .. } := D.core3
  let { REAL_ARCH_POW_INV, REAL_LET_TRANS, REAL_LE_LMUL, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_RMUL_EQ, REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_POW2, REAL_LT_RDIV_EQ, .. } :=
    D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_RID, REAL_MUL_SYM, REAL_POW_INV, REAL_POW_MONO, SING_SUBSET,
        SKOLEM_THM, SUBSET, SUBSET_RESTRICT, .. } := D.core5
  let { o_ASSOC, o_DEF, o_THM, real_div, real_pow, .. } := D.core6
  let { COUNTABLE_AS_INJECTIVE_IMAGE, .. } := D.lib1
  let { MONOTONE_BIGGER, REAL_HALF, .. } := D.misc
  let { DIST_NZ, DIST_POS_LE, DIST_POS_LT, DIST_SYM, .. } := D.vec1
  let { dist, .. } := D.vec4
  let { CLOSED_IN_IMP_SUBSET, .. } := D.met1
  let { EVENTUALLY_SEQUENTIALLY, EVENTUALLY_TRUE, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_TRANS, TRIVIAL_LIMIT_SEQUENTIALLY, .. } :=
    D.met3
  let { OPEN_IN_REFL, .. } := BEUC
  let { CLOSED_IN_REFL, .. } := BCLO
  let { CENTRE_IN_BALL, IN_BALL, IN_CBALL, OPEN_BALL, .. } := BBAL
  let { OPEN_IN_CONTAINS_CBALL, OPEN_IN_OPEN_INTER, .. } := BLOC
  let { LIMPT_SUBSET, .. } := BLPT
  let { CLOSED_IN_LIMPT, .. } := BCLS2
  let { LIM_EVENTUALLY_IN_OPEN_IN, .. } := BLIM1
  let { LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, .. } := BLIM2
  let { INFINITE_OPEN_IN, .. } := BRLM
  let { LIM_UNIQUE, .. } := BUNQ
  let { CLOSED_IN_SEQUENTIAL_LIMITS, .. } := BSEQ
  let { CONNECTED_IMP_PERFECT, .. } := BBND1
  let { FINITE_IMP_COMPACT, LIMPT_OF_SEQUENCE_SUBSEQUENCE, .. } := BCPP1
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { LIM_CONTINUOUS_FUNCTION_WITHIN, .. } := BSQC
  let { CONTINUOUS_OPEN_IN_PREIMAGE, .. } := BCLC
  let { PROPER_MAP, .. } := BPRP1
  let { CONNECTED_COMPONENT_REFL, CONNECTED_COMPONENT_REFL_EQ, CONNECTED_COMPONENT_SUBSET,
        CONNECTED_CONNECTED_COMPONENT, .. } := BCCM1
  let { HOMEOMORPHISM, .. } := BHMA
  let { DISCRETE_IMP_COUNTABLE, .. } := BDSC
  -- @@SCOPE END

  let CLOSED_LOCAL_HOMEOMORPHISM_IMP_PROPER_GEN ← prove
   r"!f:real^M->real^N s t.
        (!c. closed_in (subtopology euclidean s) c
             ==> closed_in (subtopology euclidean t) (IMAGE f c)) /\
        (!w x. open_in (subtopology euclidean s) w /\ x IN w
               ==> ?u. open_in (subtopology euclidean s) u /\
                       {x} PSUBSET u /\ u SUBSET w /\
                       f continuous_on u /\
                       (!x'. x' IN u /\ ~(x' = x) ==> ~(f x' = f x)))
          ==> !y. FINITE {x | x IN s /\ f x = y}"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (ASSUME_TAC th THEN MP_TAC (← SPEC (← q r"s:real^M->bool") th))) THEN
    REWRITE_TAC [CLOSED_IN_REFL] THEN
    DISCH_THEN (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    X_GEN_TAC (← q r"b:real^N") THEN
    REWRITE_TAC [← MESON [INFINITE] (← q r"FINITE s <=> ~INFINITE s")] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!z. z IN s /\ (f:real^M->real^N) z = b
          ==> ?r. &0 < r /\
                  f continuous_on s INTER ball(z,r) /\
                  !z'. z' IN s /\ z' IN cball(z,&2 * r) /\ ~(z' = z)
                       ==> ~(f z' = b)")
    (LABEL_TAC "*") THENL
     [X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"s:real^M->bool", ← q r"x:real^M"]) THEN
      ASM_SIMP_TAC [OPEN_IN_REFL, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:real^M->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [OPEN_IN_CONTAINS_CBALL] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:real^M"))) THEN
      ASM_REWRITE_TAC [SUBSET, IN_INTER] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"r / &2") THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, IN_INTER, IN_BALL] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_CBALL] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          COUNTABLE_AS_INJECTIVE_IMAGE)) THEN
    REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [MATCH_MP_TAC DISCRETE_IMP_COUNTABLE THEN
      X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ASM_REWRITE_TAC [IN_CBALL, dist] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"y:real^M") THEN
      ASM_CASES_TAC (← q r"y:real^M = x") THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"(y:real^M) IN s") THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"(f:real^M->real^N) y = b") THEN ASM_REWRITE_TAC [] THEN
      CONV_TAC (fun t => NORM_ARITH t),
      REWRITE_TAC [INJECTIVE_ALT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:num->real^M") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN (← q r"(!n:num. a n IN s) /\ (!n. (f:real^M->real^N) (a n) = b)")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REMOVE_THEN "*" (MP_TAC o GEN_REWRITE_RULE id [← SET_RULE
      (← q r"(!x. P x ==> Q x) <=> (!x. x IN {z | P z} ==> Q x)")]) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV, SKOLEM_THM, FORALL_AND_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->real") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"u:num->real^M->bool = \n. s INTER ball(a n,r n)") THEN
    SUBGOAL_THEN
     (← q r"!n. open_in (subtopology euclidean s) ((u:num->real^M->bool) n)")
    ASSUME_TAC THENL
     [EXPAND_TAC "u" THEN REWRITE_TAC [] THEN
      SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. (a:num->real^M) n IN u n") ASSUME_TAC THENL
     [EXPAND_TAC "u" THEN REWRITE_TAC [IN_INTER, CENTRE_IN_BALL] THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n:num. (f:real^M->real^N) continuous_on u n") ASSUME_TAC THENL
     [EXPAND_TAC "u" THEN REWRITE_TAC [] THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?x:num->real^M.
          (!n. x n IN u n /\ ~(f(x n) = b)) /\
          (!n. dist(f(x(SUC n)):real^N,b) < dist(f(x n),b) / &2)")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL
          [← q r"(u:num->real^M->bool) 0", ← q r"a 0:real^M"]) THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^M"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"{z | z IN u(SUC n) /\
                (f:real^M->real^N) z IN ball(b,dist(f x,b) / &2)}",
          ← q r"(a:num->real^M) (SUC n)"]) THEN
        ASM_SIMP_TAC [IN_ELIM_THM, CENTRE_IN_BALL, REAL_HALF, ← GSYM DIST_NZ] THEN
      ANTS_TAC THENL
       [TRANS_TAC OPEN_IN_TRANS (← q r"u(SUC n):real^M->bool") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE THEN
        ASM_REWRITE_TAC [OPEN_BALL],
        REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] IN_BALL] THEN SET_TAC []]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. (x:num->real^M) n IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(((f:real^M->real^N) o (x:num->real^M)) --> b) sequentially")
    ASSUME_TAC THENL
     [REWRITE_TAC [LIM_SEQUENTIALLY] THEN X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e / dist((f:real^M->real^N)(x 0),b)"]
          REAL_ARCH_POW_INV) THEN
      ASM_SIMP_TAC [REAL_POW_INV, REAL_LT_DIV, DIST_POS_LT] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      ASM_SIMP_TAC [REAL_LT_RDIV_EQ, DIST_POS_LT] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        REAL_LET_TRANS)) THEN
      SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LT_POW2, o_THM] THEN
      TRANS_TAC REAL_LE_TRANS
        (← q r"dist ((f:real^M->real^N) (x n),b) * &2 pow n") THEN
      ASM_SIMP_TAC [REAL_LE_LMUL, DIST_POS_LE, REAL_POW_MONO,
                    ← REAL_ARITH (← q r"&1 <= &2")] THEN
      SPEC_TAC (← q r"n:num", ← q r"m:num") THEN INDUCT_TAC THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [REAL_LE_REFL, REAL_MUL_RID, real_pow] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        REAL_LE_TRANS)) THEN
      ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_LE_RMUL_EQ, REAL_LT_POW2] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"x < y / &2 ==> x * &2 <= y")],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN (← q r"x:real^M") o
      SPECL [← q r"s:real^M->bool", ← q r"x:real^M"]) THEN
    REWRITE_TAC [OPEN_IN_REFL] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (x:num->real^M) (:num)")) THEN
    REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [CLOSED_IN_SEQUENTIAL_LIMITS] THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"(f:real^M->real^N) o (x:num->real^M)", ← q r"b:real^N"] o CONJUNCT2) THEN
      ASM_REWRITE_TAC [o_THM, NOT_IMP] THEN ASM SET_TAC []] THEN
    REWRITE_TAC [CLOSED_IN_LIMPT] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"z:real^M") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LIMPT_OF_SEQUENCE_SUBSEQUENCE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"(f:real^M->real^N) z = b") ASSUME_TAC THENL
     [MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"(f:real^M->real^N) o x o (r:num->num)") THEN
      ASM_SIMP_TAC [o_ASSOC, LIM_SUBSEQUENCE, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      REWRITE_TAC [o_DEF] THEN
      MATCH_MP_TAC LIM_CONTINUOUS_FUNCTION_WITHIN THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:real^M")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"u:real^M->bool") THEN REPEAT STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE
         (← q r"{z} PSUBSET s ==> z IN s")))
      THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN],
        GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC LIM_EVENTUALLY_IN_OPEN_IN THEN
        MAP_EVERY EXISTS_TAC [← q r"z:real^M", ← q r"s:real^M->bool"] THEN
        ASM_REWRITE_TAC [EVENTUALLY_TRUE] THEN
        GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        ASM_REWRITE_TAC []],
      SUBGOAL_THEN (← q r"?N. z = (a:num->real^M) N")
       (X_CHOOSE_THEN (← q r"N:num") SUBST_ALL_TAC) THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"eventually (\n. (x:num->real^M)(r n) IN u(N:num)) sequentially")
      MP_TAC THENL
       [MATCH_MP_TAC LIM_EVENTUALLY_IN_OPEN_IN THEN
        MAP_EVERY EXISTS_TAC [← q r"(a:num->real^M) N", ← q r"s:real^M->bool"] THEN
        ASM_REWRITE_TAC [EVENTUALLY_TRUE] THEN
        GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"M:num") (MP_TAC o SPEC (← q r"M + N + 1"))) THEN
        REWRITE_TAC [← ARITH_RULE (← q r"M <= M + N + 1")] THEN
        SUBGOAL_THEN (← q r"(x:num->real^M)(r(M + N + 1)) IN u(r(M + N + 1))")
        MP_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC (← SET_RULE (← q r"DISJOINT s t ==> x IN t ==> ~(x IN s)")) THEN
        SUBGOAL_THEN (← q r"~(r(M + N + 1) = N)") MP_TAC THENL
         [MATCH_MP_TAC (← ARITH_RULE
           (← q r"M + N + 1 <= r(M + N + 1) ==> ~(r(M + N + 1) = N)")) THEN
          ASM_MESON_TAC [MONOTONE_BIGGER],
          ALL_TAC] THEN
        SPEC_TAC (← q r"r(M + N + 1):num", ← q r"N':num") THEN GEN_TAC THEN
        DISCH_TAC THEN EXPAND_TAC "u" THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"DISJOINT t u ==> DISJOINT (s INTER t) (s INTER u)")) THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          pure (MP_TAC (← SPECL [← q r"N:num", ← q r"(a:num->real^M) N'"] th) THEN
                MP_TAC (← SPECL [← q r"N':num", ← q r"(a:num->real^M) N"] th))) THEN
        ASM_REWRITE_TAC [IN_BALL, IN_CBALL, DISJOINT, EXTENSION, IN_INTER,
                         NOT_IN_EMPTY] THEN
        CONV_TAC (fun t => NORM_ARITH t)]])

  let CLOSED_LOCAL_HOMEOMORPHISM_IMP_PROPER ← prove
   r"!f:real^M->real^N s t.
        (!x. connected_component s x = {x} ==> s = {x}) /\
        (!c. closed_in (subtopology euclidean s) c
             ==> closed_in (subtopology euclidean t) (IMAGE f c)) /\
        (!x. x IN s
             ==> ?u v g. x IN u /\
                         open_in (subtopology euclidean s) u /\
                         open_in (subtopology euclidean t) v /\
                         homeomorphism (u,v) (f,g))
        ==> !k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:real^M->real^N) s SUBSET t") ASSUME_TAC THENL
     [ASM_MESON_TAC [CLOSED_IN_REFL, CLOSED_IN_IMP_SUBSET], ALL_TAC] THEN
    ASM_SIMP_TAC [PROPER_MAP] THEN
    X_GEN_TAC (← q r"y:real^N") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    MATCH_MP_TAC FINITE_IMP_COMPACT THEN
    ASM_CASES_TAC (← q r"?a:real^M. s = {a}") THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"a:real^M") SUBST1_TAC) THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{a:real^M}") THEN
      REWRITE_TAC [SUBSET_RESTRICT, FINITE_SING],
      SUBGOAL_THEN (← q r"!x:real^M. x IN s ==> {x} PSUBSET connected_component s x")
      ASSUME_TAC THENL
       [REPEAT STRIP_TAC THEN REWRITE_TAC [SING_SUBSET, PSUBSET] THEN
        REWRITE_TAC [IN] THEN ASM_SIMP_TAC [CONNECTED_COMPONENT_REFL] THEN
        ASM_MESON_TAC [],
        FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o
          GEN_REWRITE_RULE id [NOT_EXISTS_THM])] THEN
      UNDISCH_THEN (← q r"!x:real^M. connected_component s x = {x} ==> s = {x}")
           (K ALL_TAC : thm → tactic)] THEN
    SPEC_TAC (← q r"y:real^N", ← q r"y:real^N") THEN
    MATCH_MP_TAC CLOSED_LOCAL_HOMEOMORPHISM_IMP_PROPER_GEN THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real^M->bool", ← q r"x:real^M"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(x:real^M) IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, OPEN_IN_IMP_SUBSET], ALL_TAC] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M"))) THEN
    ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"u:real^M->bool") MP_TAC) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, HOMEOMORPHISM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"g:real^N->real^M"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"u INTER w:real^M->bool") THEN
    ASM_SIMP_TAC [OPEN_IN_INTER, INTER_SUBSET, CONJ_ASSOC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTER_SUBSET]] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"a IN s /\ ~(s SUBSET {a}) ==> {a} PSUBSET s")) THEN
    ASM_REWRITE_TAC [IN_INTER] THEN
    MATCH_MP_TAC (← MESON [INFINITE, FINITE_SING, FINITE_SUBSET]
     (← q r"INFINITE s ==> ~(s SUBSET {x})")) THEN
    MATCH_MP_TAC INFINITE_OPEN_IN THEN EXISTS_TAC (← q r"s:real^M->bool") THEN
    ASM_SIMP_TAC [OPEN_IN_INTER] THEN
    EXISTS_TAC (← q r"x:real^M") THEN ASM_REWRITE_TAC [IN_INTER] THEN
    MATCH_MP_TAC LIMPT_SUBSET THEN
    EXISTS_TAC (← q r"connected_component s (x:real^M)") THEN
    REWRITE_TAC [CONNECTED_COMPONENT_SUBSET] THEN
    MATCH_MP_TAC CONNECTED_IMP_PERFECT THEN
    REWRITE_TAC [IN, CONNECTED_CONNECTED_COMPONENT] THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN ASM SET_TAC [])

  return { CLOSED_LOCAL_HOMEOMORPHISM_IMP_PROPER_GEN, CLOSED_LOCAL_HOMEOMORPHISM_IMP_PROPER }

/- ------------------------------------------------------------------------- -/
/- The Brouwer reduction theorem.  (topology.ml 28211-28338)                 -/
/- ------------------------------------------------------------------------- -/

structure BRT where
  BROUWER_REDUCTION_THEOREM_GEN : thm
  BROUWER_REDUCTION_THEOREM : thm
  MINIMAL_CONTINUUM : thm
  deriving Inhabited

@[nospecialize]
def setupBRT [HolBase] (D : TopologyDeps) (BCLO : CLO) (BBAL : BAL) (BCON : CON) (BBND1 : BND1)
    (BCPT : CPT) (BCPP1 : CPP1) (BNST : NST) (BCLV : CLV) (BSEC : SEC) :
    ExceptT String IO BRT := do
  -- @@SCOPE BEGIN
  let { prove_recursive_functions_exist, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_RULE,
        SET_TAC, .. } := D
  let { EMPTY_SUBSET, EMPTY_UNIONS, EXISTS_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_GSPEC, INTERS_GSPEC, INTER_UNIONS, IN_DIFF, .. } := D.core2
  let { IN_UNIONS, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_EXISTS_THM, PSUBSET_ALT, .. } :=
    D.core3
  let { SUBSET_EMPTY, SUBSET_INTERS, SUBSET_REFL, SUBSET_TRANS, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LE, num_RECURSION, .. } := D.core6
  let { CLOSED_INTERS, closed, .. } := BCLO
  let { CENTRE_IN_BALL, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := BBAL
  let { CONNECTED_EMPTY, .. } := BCON
  let { BOUNDED_SUBSET, .. } := BBND1
  let { COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_CLOSED, .. } := BCPT
  let { COMPACT_EMPTY, .. } := BCPP1
  let { COMPACT_NEST, .. } := BNST
  let { CONNECTED_NEST, .. } := BCLV
  let { UNIV_SECOND_COUNTABLE_SEQUENCE, .. } := BSEC
  -- @@SCOPE END

  let BROUWER_REDUCTION_THEOREM_GEN ← prove
   r"!P s:real^N->bool.
        (!f. (!n. closed(f n) /\ P(f n)) /\ (!n. f(SUC n) SUBSET f(n))
              ==> P(INTERS {f n | n IN (:num)})) /\
        closed s /\ P s
        ==> ?t. t SUBSET s /\ closed t /\ P t /\
                (!u. u SUBSET s /\ closed u /\ P u ==> ~(u PSUBSET t))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?b:num->real^N->bool.
          (!m n. b m = b n <=> m = n) /\
          (!n. open (b n)) /\
          (!s. open s ==> (?k. s = UNIONS {b n | n IN k}))")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [UNIV_SECOND_COUNTABLE_SEQUENCE], ALL_TAC] THEN
    X_CHOOSE_THEN (← q r"a:num->real^N->bool") MP_TAC
     (← prove_recursive_functions_exist num_RECURSION
     (← q r"a 0 = (s:real^N->bool) /\
      (!n. a(SUC n) =
           if ?u. u SUBSET a(n) /\ closed u /\ P u /\ u INTER (b n) = {}
           then @u. u SUBSET a(n) /\ closed u /\ P u /\ u INTER (b n) = {}
           else a(n))")) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "base") (LABEL_TAC "step")) THEN
    EXISTS_TAC (← q r"INTERS {a n :real^N->bool | n IN (:num)}") THEN
    SUBGOAL_THEN (← q r"!n. (a:num->real^N->bool)(SUC n) SUBSET a(n)") ASSUME_TAC THENL
     [GEN_TAC THEN ASM_REWRITE_TAC [] THEN
      COND_CASES_TAC THEN REWRITE_TAC [SUBSET_REFL] THEN
      FIRST_X_ASSUM (MP_TAC o SELECT_RULE) THEN MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. (a:num->real^N->bool) n SUBSET s") ASSUME_TAC THENL
     [INDUCT_TAC THEN ASM_MESON_TAC [SUBSET_REFL, SUBSET_TRANS], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. closed((a:num->real^N->bool) n) /\ P(a n)") ASSUME_TAC THENL
     [INDUCT_TAC THEN ASM_REWRITE_TAC [] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SELECT_RULE) THEN MESON_TAC [],
      ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_INTERS THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN SET_TAC [],
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      REWRITE_TAC [PSUBSET_ALT] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [INTERS_GSPEC, EXISTS_IN_GSPEC, IN_UNIV] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"?n. x IN (b:num->real^N->bool)(n) /\ t INTER b n = {}")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPEC (← q r"(:real^N) DIFF t") OPEN_CONTAINS_BALL) THEN
        ASM_REWRITE_TAC [← GSYM closed] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DIFF t <=> t INTER s = {}")] THEN
        X_GEN_TAC (← q r"e:real") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        MP_TAC (← ISPECL [← q r"x:real^N", ← q r"e:real"] CENTRE_IN_BALL) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"ball(x:real^N,e)")) THEN
        ASM_REWRITE_TAC [OPEN_BALL, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"k:num->bool") THEN DISCH_THEN SUBST1_TAC THEN
        REWRITE_TAC [IN_UNIONS, INTER_UNIONS, EMPTY_UNIONS, FORALL_IN_GSPEC] THEN
        SET_TAC [],
        REMOVE_THEN "step" (MP_TAC o SPEC (← q r"n:num")) THEN
        COND_CASES_TAC THENL
         [DISCH_THEN (ASSUME_TAC o SYM) THEN
          FIRST_X_ASSUM (MP_TAC o SELECT_RULE) THEN ASM_REWRITE_TAC [] THEN
          ASM SET_TAC [],
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"t:real^N->bool")) THEN ASM_REWRITE_TAC [] THEN
          ASM SET_TAC []]]])

  let BROUWER_REDUCTION_THEOREM ← prove
   r"!P s:real^N->bool.
        (!f. (!n. compact(f n) /\ ~(f n = {}) /\ P(f n)) /\
             (!n. f(SUC n) SUBSET f(n))
             ==> P(INTERS {f n | n IN (:num)})) /\
        compact s /\ ~(s = {}) /\ P s
        ==> ?t. t SUBSET s /\ compact t /\ ~(t = {}) /\ P t /\
                (!u. u SUBSET s /\ closed u /\ ~(u = {}) /\ P u
                     ==> ~(u PSUBSET t))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\t:real^N->bool. ~(t = {}) /\ t SUBSET s /\ P t",
                      ← q r"s:real^N->bool"]
          BROUWER_REDUCTION_THEOREM_GEN) THEN
    ASM_SIMP_TAC [COMPACT_IMP_CLOSED, SUBSET_REFL] THEN ANTS_TAC THENL
     [GEN_TAC THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"!n. compact((f:num->real^N->bool) n)") ASSUME_TAC THENL
       [ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET], ALL_TAC] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC COMPACT_NEST THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM_SIMP_TAC [] THEN SET_TAC [],
        ASM SET_TAC [],
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC []],
      MATCH_MP_TAC MONO_EXISTS THEN ASM_SIMP_TAC [] THEN
      ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET]])

  let MINIMAL_CONTINUUM ← prove
   r"!t s:real^N->bool.
        t SUBSET s /\ compact s /\ connected s
        ==> ?u. t SUBSET u /\ u SUBSET s /\ compact u /\ connected u /\
                !v. v SUBSET u /\ t SUBSET v /\ compact v /\ connected v
                    ==> v = u"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [EXISTS_TAC (← q r"{}:real^N->bool") THEN
      ASM_MESON_TAC [COMPACT_EMPTY, CONNECTED_EMPTY, SUBSET_EMPTY, EMPTY_SUBSET],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"\u:real^N->bool. t SUBSET u /\ connected u",
                      ← q r"s:real^N->bool"]
          BROUWER_REDUCTION_THEOREM) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN GEN_TAC THEN STRIP_TAC THEN
      CONJ_TAC THENL
       [REWRITE_TAC [SUBSET_INTERS] THEN ASM SET_TAC [],
        MATCH_MP_TAC CONNECTED_NEST THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
        ASM_REWRITE_TAC [] THEN SET_TAC []],
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← SET_RULE (← q r"(v SUBSET u /\ p ==> v = u) <=>
                            (v SUBSET u /\ p ==> ~(v PSUBSET u))")] THEN
      GEN_TAC THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN ASM SET_TAC []])

  return { BROUWER_REDUCTION_THEOREM_GEN, BROUWER_REDUCTION_THEOREM, MINIMAL_CONTINUUM }

/- ------------------------------------------------------------------------- -/
/- The Arzela-Ascoli theorem.  (topology.ml 28339-28517)                     -/
/- ------------------------------------------------------------------------- -/

structure ARZ where
  FUNCTION_CONVERGENT_SUBSEQUENCE : thm
  ARZELA_ASCOLI : thm
  ARZELA_ASCOLI_LIPSCHITZ : thm
  deriving Inhabited

@[nospecialize]
def setupARZ [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCLS1 : CLS1) (BLIM2 : LIM2)
    (BBND1 : BND1) (BBND2 : BND2) (BCPT : CPT) (BCMP : CMP) (BCPP2 : CPP2) (BNST : NST)
    (BCNO : CNO) (BCCE : CCE) (BUCC : UCC) (BSEC : SEC) : ExceptT String IO ARZ := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_TAC, NORM_ARITH, .. } := D
  let { CONJ_ASSOC, EXISTS_FINITE_SUBSET_IMAGE, EXISTS_IN_IMAGE, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, GE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_ELIM_THM,
        IN_INTER, .. } := D.core2
  let { IN_UNIV, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, LE_TRANS, MEMBER_NOT_EMPTY,
        MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_IN_EMPTY, REAL_ABS_POS, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_LMUL, REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_RDIV_EQ, .. } :=
    D.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET, SUBSET_TRANS, .. } :=
    D.core5
  let { SWAP_FORALL_THM, UNIONS_IMAGE, o_DEF, o_THM, .. } := D.core6
  let { COUNTABLE_AS_IMAGE, .. } := D.lib1
  let { SUBSEQUENCE_DIAGONALIZATION_LEMMA, UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { NORM_POS_LE, NORM_SUB, .. } := D.vec3
  let { dist, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { IN_BALL, IN_CBALL_0, OPEN_BALL, .. } := BBAL
  let { CLOSURE_APPROACHABLE, .. } := BCLS1
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { BOUNDED_POS, .. } := BBND1
  let { BOUNDED_DIFFS, .. } := BBND2
  let { COMPACT_EQ_HEINE_BOREL, COMPACT_IMP_BOUNDED, compact, .. } := BCPT
  let { CONVERGENT_EQ_CAUCHY, cauchy, .. } := BCMP
  let { COMPACT_CBALL, .. } := BCPP2
  let { UNIFORMLY_CONVERGENT_EQ_CAUCHY, .. } := BNST
  let { continuous_on, .. } := BCNO
  let { LIPSCHITZ_LIM, .. } := BCCE
  let { COMPACT_UNIFORMLY_EQUICONTINUOUS, CONTINUOUS_UNIFORM_LIMIT, .. } := BUCC
  let { SEPARABLE, .. } := BSEC
  -- @@SCOPE END

  let FUNCTION_CONVERGENT_SUBSEQUENCE ← prove
   r"!f:num->real^M->real^N s M.
        COUNTABLE s /\ (!n x. x IN s ==> norm(f n x) <= M)
        ==> ?k. (!m n:num. m < n ==> k m < k n) /\
                !x. x IN s ==> ?l. ((\n. f (k n) x) --> l) sequentially"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THENL
     [EXISTS_TAC (← q r"\n:num. n") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"s:real^M->bool") COUNTABLE_AS_IMAGE) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"X:num->real^M") THEN DISCH_THEN SUBST_ALL_TAC THEN
    MP_TAC (← ISPEC
      (← q r"\i r. ?l. ((\n. ((f:num->real^M->real^N) o (r:num->num)) n
                       ((X:num->real^M) i)) --> l) sequentially")
     SUBSEQUENCE_DIAGONALIZATION_LEMMA) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, o_THM, IN_UNIV] THEN
    ANTS_TAC THENL [ALL_TAC, DISCH_THEN MATCH_ACCEPT_TAC] THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [FORALL_IN_IMAGE, IN_UNIV]) THEN
      MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"r:num->num"] THEN
      MP_TAC (← ISPEC (← q r"cball(vec 0:real^N,M)") compact) THEN
      REWRITE_TAC [COMPACT_CBALL] THEN DISCH_THEN (MP_TAC o SPEC
       (← q r"\n. (f:num->real^M->real^N) ((r:num->num) n) (X(i:num))")) THEN
      ASM_REWRITE_TAC [IN_CBALL_0, o_DEF] THEN MESON_TAC [],
      REPEAT GEN_TAC THEN REWRITE_TAC [LIM_SEQUENTIALLY, GE] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      ASM_MESON_TAC [LE_TRANS, ← ARITH_RULE (← q r"MAX a b <= c <=> a <= c /\ b <= c")]])

  let ARZELA_ASCOLI ← prove
   r"!f:num->real^M->real^N s M.
        compact s /\
        (!n x. x IN s ==> norm(f n x) <= M) /\
        (!x e. x IN s /\ &0 < e
               ==> ?d. &0 < d /\
                       !n y. y IN s /\ norm(x - y) < d
                             ==> norm(f n x - f n y) < e)
        ==> ?g. g continuous_on s /\
                ?r. (!m n:num. m < n ==> r m < r n) /\
                    !e. &0 < e
                        ==> ?N. !n x. n >= N /\ x IN s
                                      ==> norm(f(r n) x - g x) < e"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [GE] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!k g. V k g ==> N g) /\ (?k. M k /\ ?g. V k g)
      ==> ?g. N g /\ ?k. M k /\ V k g")) THEN
    CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"k:num->num", ← q r"g:real^M->real^N"] THEN
      STRIP_TAC THEN MATCH_MP_TAC (← ISPEC (← q r"sequentially")
        CONTINUOUS_UNIFORM_LIMIT) THEN
      EXISTS_TAC (← q r"(f:num->real^M->real^N) o (k:num->num)") THEN
      ASM_SIMP_TAC [EVENTUALLY_SEQUENTIALLY, o_THM, TRIVIAL_LIMIT_SEQUENTIALLY,
                    RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
      EXISTS_TAC (← q r"0") THEN REWRITE_TAC [continuous_on, dist] THEN
      ASM_MESON_TAC [NORM_SUB],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"IMAGE (f:num->real^M->real^N) (:num)",
      ← q r"s:real^M->bool"]
     COMPACT_UNIFORMLY_EQUICONTINUOUS) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE, IN_UNIV] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [dist] THEN ONCE_REWRITE_TAC [NORM_SUB] THEN ASM_MESON_TAC [],
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"x:real^M"))] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC, dist] THEN
    DISCH_THEN (ASSUME_TAC o ONCE_REWRITE_RULE [NORM_SUB]) THEN
    REWRITE_TAC [← GSYM dist, UNIFORMLY_CONVERGENT_EQ_CAUCHY] THEN
    X_CHOOSE_THEN (← q r"r:real^M->bool") STRIP_ASSUME_TAC
     (← ISPEC (← q r"s:real^M->bool") SEPARABLE) THEN
    MP_TAC (← ISPECL [← q r"f:num->real^M->real^N", ← q r"r:real^M->bool", ← q r"M:real"]
          FUNCTION_CONVERGENT_SUBSEQUENCE) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:num->num") THEN
    REWRITE_TAC [CONVERGENT_EQ_CAUCHY, cauchy] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*")) THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &3")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [COMPACT_EQ_HEINE_BOREL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (\x:real^M. ball(x,d)) r")) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, OPEN_BALL] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> b /\ a /\ c")] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN ANTS_TAC THENL
     [MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"closure r:real^M->bool") THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [SUBSET, CLOSURE_APPROACHABLE] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_THEN (MP_TAC o SPEC (← q r"d:real")) THEN
      ASM_REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM, IN_BALL],
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC)] THEN
    REMOVE_THEN "*" MP_TAC THEN REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"M:real^M->num") THEN DISCH_THEN (LABEL_TAC "*") THEN
    MP_TAC (← ISPECL [← q r"M:real^M->num", ← q r"t:real^M->bool"]
      UPPER_BOUND_FINITE_SET) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
    DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num", ← q r"x:real^M"] THEN STRIP_TAC THEN
    UNDISCH_TAC (← q r"s SUBSET UNIONS (IMAGE (\x:real^M. ball (x,d)) t)") THEN
    REWRITE_TAC [SUBSET, UNIONS_IMAGE, IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
    ASM_REWRITE_TAC [IN_BALL, LEFT_IMP_EXISTS_THM, dist] THEN
    X_GEN_TAC (← q r"y:real^M") THEN STRIP_TAC THEN
    MATCH_MP_TAC (← NORM_ARITH
     (← q r"norm(f (k(m:num)) y - f (k m) x) < e / &3 /\
      norm(f (k n) y - f (k n) x) < e / &3 /\
      norm(f (k m) y - f (k n) y) < e / &3
      ==> norm(f (k m) x - f (k n) x :real^M) < e")) THEN
    ASM_SIMP_TAC [] THEN REMOVE_THEN "*" (MP_TAC o SPEC (← q r"y:real^M")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"m:num", ← q r"n:num"]) THEN
    ASM_REWRITE_TAC [dist, GE] THEN ASM_MESON_TAC [SUBSET, LE_TRANS])

  let ARZELA_ASCOLI_LIPSCHITZ ← prove
   r"!f:num->real^M->real^N s t b.
     compact s /\ bounded t /\
     (!n x. x IN s ==> ~(IMAGE (f n) s INTER t = {})) /\
     (!n x y. x IN s /\ y IN s ==> norm(f n x - f n y) <= b * norm(x - y))
     ==> ?g. (!x y. x IN s /\ y IN s ==> norm(g x - g y) <= b * norm(x - y)) /\
             ?r. (!m n. m < n ==> r m < r n) /\
                 !e. &0 < e
                     ==> ?N. !n:num x. n >= N /\ x IN s
                                       ==> norm(f (r n) x - g x) < e"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← MATCH_MP MONO_EXISTS (← ISPECL
     [← q r"f:num->real^M->real^N", ← q r"s:real^M->bool"] ARZELA_ASCOLI)) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REWRITE_TAC [LEFT_EXISTS_AND_THM] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BOUNDED_POS]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"s:real^M->bool"] BOUNDED_DIFFS) THEN
        ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN
        REWRITE_TAC [BOUNDED_POS, LEFT_IMP_EXISTS_THM, FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"C:real") THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"B + abs b * C:real") THEN
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^M"] THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"~(IMAGE ((f:num->real^M->real^N) n) s INTER t = {})")
        MP_TAC THENL [ASM_MESON_TAC [], REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY]] THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, IN_INTER] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^M") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"x:real^M", ← q r"y:real^M"]) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← NORM_ARITH
        (← q r"norm(y) <= b /\ a <= c
          ==> norm(x - y:real^M) <= a ==> norm(x) <= b + c")) THEN
        ASM_SIMP_TAC [] THEN
        TRANS_TAC REAL_LE_TRANS (← q r"abs b * norm(x - y:real^M)") THEN
        ASM_SIMP_TAC [REAL_LE_LMUL, REAL_ABS_POS] THEN
        MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
        REAL_ARITH_TAC,
        MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"e:real"] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"e / (abs b + &1)") THEN
        ASM_SIMP_TAC [REAL_LT_RDIV_EQ, ← REAL_ARITH (← q r"&0 < abs b + &1")] THEN
        ASM_REWRITE_TAC [REAL_MUL_LZERO] THEN
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"y:real^M"] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"x:real^M", ← q r"y:real^M"]) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        GEN_REWRITE_TAC LAND_CONV [REAL_MUL_SYM] THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
        REAL_ARITH_TAC],
      REWRITE_TAC [RIGHT_AND_EXISTS_THM, dist, GE] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^M->real^N") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC LIPSCHITZ_LIM THEN
      EXISTS_TAC (← q r"(f:num->real^M->real^N) o (r:num->num)") THEN
      ASM_REWRITE_TAC [LIM_SEQUENTIALLY, dist, o_DEF] THEN ASM_MESON_TAC []])

  return { FUNCTION_CONVERGENT_SUBSEQUENCE, ARZELA_ASCOLI, ARZELA_ASCOLI_LIPSCHITZ }

/- ------------------------------------------------------------------------- -/
/- Basics about "local" properties in general.  (topology.ml 28518-28645)    -/
/- ------------------------------------------------------------------------- -/

structure LCY1 where
  locally : thm
  NEIGHBOURHOOD_BASE_OF_EUCLIDEAN : thm
  LOCALLY_MONO : thm
  LOCALLY_OPEN_SUBSET : thm
  LOCALLY_LOCALLY : thm
  LOCALLY_ON_OPEN_SUBSETS : thm
  LOCALLY_ON_NBDS : thm
  LOCALLY_AND_SUBSET : thm
  LOCALLY_AND_OPEN_IN : thm
  LOCALLY_AND_SMALL_LT : thm
  LOCALLY_AND_SMALL_LE : thm
  deriving Inhabited

@[nospecialize]
def setupLCY1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BBND1 : BND1)
    (BDIA1 : DIA1) : ExceptT String IO LCY1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_TAC, .. } :=
    D
  let { AND_FORALL_THM, .. } := D.core1
  let { FUN_EQ_THM, IMP_CONJ, IN_INTER, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core3
  let { REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.core4
  let { RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, .. } := D.core5
  let { NEIGHBOURHOOD_BASE_OF, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBSET_TRANS,
        OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_TRANS, .. } := D.met3
  let { OPEN_IN_REFL, .. } := BEUC
  let { CENTRE_IN_BALL, OPEN_BALL, .. } := BBAL
  let { OPEN_IN_INTER_OPEN, open_in, .. } := BLOC
  let { BOUNDED_BALL, BOUNDED_SUBSET, .. } := BBND1
  let { DIAMETER_BALL, DIAMETER_SUBSET, .. } := BDIA1
  -- @@SCOPE END

  let locally ← new_definition
   r"locally P (s:real^N->bool) <=>
        !w x. open_in (subtopology euclidean s) w /\ x IN w
              ==> ?u v. open_in (subtopology euclidean s) u /\ P v /\
                        x IN u /\ u SUBSET v /\ v SUBSET w"

  let NEIGHBOURHOOD_BASE_OF_EUCLIDEAN ← prove
   r"!P s:real^N->bool.
        neighbourhood_base_of P (subtopology euclidean s) <=> locally P s"
   (REWRITE_TAC [NEIGHBOURHOOD_BASE_OF, locally])

  let LOCALLY_MONO ← prove
   r"!P Q s. (!t. P t ==> Q t) /\ locally P s ==> locally Q s"
   (REWRITE_TAC [locally] THEN MESON_TAC [])

  let LOCALLY_OPEN_SUBSET ← prove
   r"!P s t:real^N->bool.
        locally P s /\ open_in (subtopology euclidean s) t
        ==> locally P t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:real^N->bool", ← q r"x:real^N"]) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [OPEN_IN_TRANS], ALL_TAC] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_MESON_TAC [open_in, SUBSET])

  let (LOCALLY_LOCALLY, LOCALLY_ON_OPEN_SUBSETS, LOCALLY_ON_NBDS) ←
    match CONJUNCTS (← prove
   r"(!P:(real^N->bool)->bool. locally (locally P) = locally P) /\
   (!P s:real^N->bool.
        locally P s <=>
        !a. a IN s
            ==> ?v. open_in (subtopology euclidean s) v /\
                    a IN v /\ locally P v) /\
   (!P s:real^N->bool.
        locally P s <=>
        !a. a IN s
            ==> ?u v. open_in (subtopology euclidean s) u /\
                    a IN u /\ u SUBSET v /\ v SUBSET s /\ locally P v)"
   (REWRITE_TAC [FUN_EQ_THM, AND_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"P:(real^N->bool)->bool", ← q r"s:real^N->bool"] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p ==> q) /\ (q ==> s) /\ (s ==> r) /\ (r ==> p)
      ==> (q <=> p) /\ (p <=> r) /\ (p <=> s)")) THEN
    REPEAT CONJ_TAC THENL
     [DISCH_TAC THEN ONCE_REWRITE_TAC [locally] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"x:real^N"] THEN
      STRIP_TAC THEN REPEAT (EXISTS_TAC (← q r"v:real^N->bool")) THEN
      ASM_MESON_TAC [SUBSET_REFL, LOCALLY_OPEN_SUBSET],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [locally] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
      REWRITE_TAC [OPEN_IN_REFL] THEN MESON_TAC [],
      DISCH_TAC THEN
      X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^N")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN
      EXISTS_TAC (← q r"v:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_REWRITE_TAC [],
      REWRITE_TAC [locally] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      SUBGOAL_THEN (← q r"(x:real^N) IN s") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u INTER v:real^N->bool", ← q r"x:real^N"]) THEN
      ASM_REWRITE_TAC [IN_INTER, SUBSET_INTER] THEN
      ASM_MESON_TAC [OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_INTER,
                     OPEN_IN_TRANS, OPEN_IN_REFL, OPEN_IN_IMP_SUBSET]])) with
    | [a, b, c] => pure (a, b, c)
    | _ => throw "LOCALLY_LOCALLY: match failure"

  let LOCALLY_AND_SUBSET ← prove
   r"!s:real^N->bool. locally P s <=> locally (\t. t SUBSET s /\ P t) s"
   (GEN_TAC THEN REWRITE_TAC [locally] THEN
    MESON_TAC [OPEN_IN_IMP_SUBSET, SUBSET_TRANS])

  let LOCALLY_AND_OPEN_IN ← prove
   r"!P s:real^N->bool.
        locally (\u. open_in (subtopology euclidean s) u /\ P u) s <=>
        !v x. open_in (subtopology euclidean s) v /\ x IN v
              ==> ?u. open_in (subtopology euclidean s) u /\ P u /\
                      x IN u /\
                      u SUBSET v"
   (REWRITE_TAC [locally] THEN MESON_TAC [SUBSET])

  let (LOCALLY_AND_SMALL_LT, LOCALLY_AND_SMALL_LE) ← CONJ_PAIR (← prove
   r"(!P:(real^N->bool)->bool e.
        &0 < e
        ==> locally P = locally (\s. P s /\ bounded s /\ diameter s < e)) /\
   (!P:(real^N->bool)->bool e.
        &0 < e
        ==> locally P = locally (\s. P s /\ bounded s /\ diameter s <= e))"
   (REWRITE_TAC [AND_FORALL_THM, FUN_EQ_THM, RIGHT_IMP_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC
      [← q r"P:(real^N->bool)->bool", ← q r"e:real", ← q r"s:real^N->bool"] THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"((q ==> r) /\ (r ==> p)) /\ (p ==> q)
      ==> (p <=> q) /\ (p <=> r)")) THEN
    CONJ_TAC THENL
     [CONJ_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LOCALLY_MONO) THEN
      SIMP_TAC [REAL_LT_IMP_LE],
      REWRITE_TAC [locally] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"w INTER ball(a:real^N,e / &4)", ← q r"a:real^N"]) THEN
      ASM_SIMP_TAC [OPEN_IN_INTER_OPEN, OPEN_BALL, IN_INTER, CENTRE_IN_BALL] THEN
      ASM_REWRITE_TAC [SUBSET_INTER, ← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [BOUNDED_SUBSET, BOUNDED_BALL], ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
      ASM_REWRITE_TAC [] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"diameter(ball(a:real^N,e / &4))") THEN
      ASM_SIMP_TAC [DIAMETER_SUBSET, BOUNDED_BALL] THEN
      REWRITE_TAC [DIAMETER_BALL] THEN ASM_REAL_ARITH_TAC]))

  return { locally, NEIGHBOURHOOD_BASE_OF_EUCLIDEAN, LOCALLY_MONO, LOCALLY_OPEN_SUBSET,
           LOCALLY_LOCALLY, LOCALLY_ON_OPEN_SUBSETS, LOCALLY_ON_NBDS, LOCALLY_AND_SUBSET,
           LOCALLY_AND_OPEN_IN, LOCALLY_AND_SMALL_LT, LOCALLY_AND_SMALL_LE }

/- ------------------------------------------------------------------------- -/
/- Local properties: open bases, unions, closed differences.                 -/
/- (topology.ml 28646-28805)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LCY2 where
  LOCALLY_OPEN_BASIS : thm
  LOCALLY_AND_OPEN_IN_IDEMPOT : thm
  LOCALLY_IMP_COUNTABLE_UNION_OF : thm
  LOCALLY_IMP_FINITE_UNION_OF : thm
  LOCALLY_DIFF_CLOSED : thm
  deriving Inhabited

@[nospecialize]
def setupLCY2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BCPT : CPT)
    (BLND : LND) (BLCY1 : LCY1) : ExceptT String IO LCY2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, NORM_ARITH, .. } := D
  let { EMPTY_SUBSET, EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_UNIONS, IMP_CONJ,
        IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNIONS, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, .. } := D.core3
  let { REAL_LT_INV_EQ, .. } := D.core4
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_EMPTY, SUBSET_INTER, SUBSET_REFL,
        SUBSET_TRANS, SUBSET_UNIV, .. } := D.core5
  let { UNIONS_GSPEC, UNIONS_SUBSET, UNION_OF, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_UNIONS, EXISTS_COUNTABLE_SUBSET_IMAGE, NUM_COUNTABLE, .. } :=
    D.lib1
  let { REAL_HALF, .. } := D.misc
  let { ARCH_EVENTUALLY_INV1, .. } := D.met1
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBSET_TRANS,
        OPEN_IN_SUBTOPOLOGY_REFL, OPEN_IN_TRANS, .. } := D.met3
  let { OPEN_IN_REFL, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, .. } := BBAL
  let { OPEN_IN_CONTAINS_BALL, OPEN_IN_OPEN_INTER, .. } := BLOC
  let { COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY, .. } := BCPT
  let { LINDELOF_OPEN_IN, .. } := BLND
  let { LOCALLY_AND_OPEN_IN, LOCALLY_OPEN_SUBSET, locally, .. } := BLCY1
  -- @@SCOPE END

  let LOCALLY_OPEN_BASIS ← prove
   r"!P s:real^N->bool.
        locally (\u. open_in (subtopology euclidean s) u /\ P u) s <=>
        ?b. COUNTABLE b /\
            (!c. c IN b
                 ==> ~(c = {}) /\
                     open_in (subtopology euclidean s) c /\
                     P c) /\
            (!t. open_in (subtopology euclidean s) t
                 ==> ?u. u SUBSET b /\ t = UNIONS u)"
   (REWRITE_TAC [LOCALLY_AND_OPEN_IN] THEN REPEAT STRIP_TAC THEN EQ_TAC THENL
     [STRIP_TAC, ASM SET_TAC []] THEN
    SUBGOAL_THEN
      (← q r"!n. ?c. COUNTABLE c /\
               UNIONS c = s /\
               !u. u IN c
                   ==> ~(u = {}) /\
                       open_in (subtopology euclidean s) u /\
                       P u /\
                       ?x. x IN s /\ x IN u /\
                           u SUBSET ball(x:real^N,inv(&n + &1))")
    MP_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN FIRST_ASSUM (MP_TAC o GEN (← q r"x:real^N") o
          SPECL [← q r"s INTER ball(x:real^N,inv(&n + &1))", ← q r"x:real^N"]) THEN
      SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL, IN_INTER, CENTRE_IN_BALL] THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:real^N->real^N->bool") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"IMAGE (u:real^N->real^N->bool) s", ← q r"s:real^N->bool"]
          LINDELOF_OPEN_IN) THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:(real^N->bool)->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"c SUBSET t ==> (!x. x IN t ==> P x) ==> !x. x IN c ==> P x"))) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, SUBSET_EMPTY, EMPTY_SUBSET] THEN
      ASM SET_TAC [],
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM]] THEN
    X_GEN_TAC (← q r"c:num->(real^N->bool)->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"UNIONS {c n | n IN (:num)}:(real^N->bool)->bool") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_UNIONS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE,
                    FORALL_IN_IMAGE],
      REWRITE_TAC [FORALL_IN_UNIONS, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"v:real^N->bool") THEN DISCH_TAC THEN
      EXISTS_TAC
       (← q r"{t:real^N->bool | t IN UNIONS {c n | n IN (:num)} /\ t SUBSET v}") THEN
      CONJ_TAC THENL [SET_TAC [], MATCH_MP_TAC SUBSET_ANTISYM] THEN
      CONJ_TAC THENL [GEN_REWRITE_TAC id [SUBSET], SET_TAC []] THEN
      X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_CONTAINS_BALL]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"a:real^N"))) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"r / &2") ARCH_EVENTUALLY_INV1) THEN
      ASM_REWRITE_TAC [REAL_HALF, EVENTUALLY_SEQUENTIALLY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
      REWRITE_TAC [LE_REFL] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(a:real^N) IN UNIONS (c(n:num))") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"t:real^N->bool"]) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N") STRIP_ASSUME_TAC) THEN
      TRANS_TAC SUBSET_TRANS (← q r"ball(a:real^N,r) INTER s") THEN
      ASM_REWRITE_TAC [SUBSET_INTER] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [OPEN_IN_IMP_SUBSET]] THEN
      REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"x IN ball(b:real^N,inv(&n + &1)) /\
                    a IN ball(b,inv(&n + &1))")
      MP_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_BALL]] THEN
      UNDISCH_TAC (← q r"inv (&n + &1) < r / &2") THEN CONV_TAC (fun t => NORM_ARITH t)])

  let LOCALLY_AND_OPEN_IN_IDEMPOT ← prove
   r"!P s:real^N->bool.
        locally (\u. open_in (subtopology euclidean s) u /\
                     locally (\v. open_in (subtopology euclidean u) v /\
                                  P v) u) s <=>
        locally (\u. open_in (subtopology euclidean s) u /\ P u) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LOCALLY_AND_OPEN_IN] THEN
    EQ_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"x:real^N"] THEN
    STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:real^N->bool", ← q r"x:real^N"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^N->bool", ← q r"x:real^N"]) THEN
      ASM_REWRITE_TAC [OPEN_IN_REFL] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
      ASM_MESON_TAC [OPEN_IN_TRANS, SUBSET],
      EXISTS_TAC (← q r"w:real^N->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"y:real^N"] THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"v INTER w:real^N->bool", ← q r"y:real^N"]) THEN
      SUBGOAL_THEN (← q r"(v:real^N->bool) SUBSET w /\ w SUBSET s")
      STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(y:real^N) IN w") ASSUME_TAC THENL
       [ASM SET_TAC [], ASM_REWRITE_TAC [IN_INTER, SUBSET_INTER]] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [OPEN_IN_INTER, OPEN_IN_TRANS], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_INTER]])

  let LOCALLY_IMP_COUNTABLE_UNION_OF ← prove
   r"!P s:real^N->bool. locally P s ==> (COUNTABLE UNION_OF P) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally] THEN DISCH_THEN
     (MP_TAC o GEN (← q r"x:real^N") o SPECL [← q r"s:real^N->bool", ← q r"x:real^N"]) THEN
    REWRITE_TAC [OPEN_IN_REFL, RIGHT_IMP_EXISTS_THM, SKOLEM_THM,
                 LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->real^N->bool", ← q r"v:real^N->real^N->bool"] THEN
    DISCH_TAC THEN REWRITE_TAC [UNION_OF] THEN
    MP_TAC (← ISPECL [← q r"IMAGE (u:real^N->real^N->bool) s", ← q r"s:real^N->bool"]
          LINDELOF_OPEN_IN) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (v:real^N->real^N->bool) t") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE] THEN ASM SET_TAC [])

  let LOCALLY_IMP_FINITE_UNION_OF ← prove
   r"!P s:real^N->bool. compact s /\ locally P s ==> (FINITE UNION_OF P) s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally]) THEN
    DISCH_THEN
     (MP_TAC o GEN (← q r"x:real^N") o SPECL [← q r"s:real^N->bool", ← q r"x:real^N"]) THEN
    REWRITE_TAC [OPEN_IN_REFL, RIGHT_IMP_EXISTS_THM, SKOLEM_THM,
                 LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->real^N->bool", ← q r"v:real^N->real^N->bool"] THEN
    DISCH_TAC THEN REWRITE_TAC [UNION_OF] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"IMAGE (u:real^N->real^N->bool) s") o
      GEN_REWRITE_RULE id [COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY]) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (v:real^N->real^N->bool) t") THEN
    ASM_SIMP_TAC [FINITE_IMAGE] THEN ASM SET_TAC [])

  let LOCALLY_DIFF_CLOSED ← prove
   r"!P s t:real^N->bool.
        locally P s /\ closed_in (subtopology euclidean s) t
        ==> locally P (s DIFF t)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC OPEN_IN_DIFF THEN
    ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_REFL, SUBSET_UNIV, TOPSPACE_EUCLIDEAN])

  return { LOCALLY_OPEN_BASIS, LOCALLY_AND_OPEN_IN_IDEMPOT, LOCALLY_IMP_COUNTABLE_UNION_OF,
           LOCALLY_IMP_FINITE_UNION_OF, LOCALLY_DIFF_CLOSED }

/- ------------------------------------------------------------------------- -/
/- Local properties: closed sets, empty, singleton, intersections, products. -/
/- (topology.ml 28806-28946)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LCY3 where
  LOCALLY_CLOSED_IN_EXPLICIT : thm
  LOCALLY_CLOSED_IN : thm
  LOCALLY_EMPTY : thm
  LOCALLY_SING : thm
  LOCALLY_INTER : thm
  LOCALLY_INTER_OPEN : thm
  LOCALLY_OPEN_INTER : thm
  LOCALLY_PCROSS : thm
  deriving Inhabited

@[nospecialize]
def setupLCY3 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BCLS1 : CLS1)
    (BCBL : CBL) (BPCR1 : PCR1) (BLCY1 : LCY1) : ExceptT String IO LCY3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, CONJ_SYM, .. } := D.core1
  let { FORALL_PASTECART, FORALL_UNWIND_THM2, IMP_CONJ, INTER_COMM, IN_INTER, IN_SING, .. } :=
    D.core2
  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY,
        PASTECART_IN_PCROSS, PCROSS_MONO, .. } := D.core3
  let { REAL_LT_01, .. } := D.core4
  let { RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_TRANS, .. } := D.core5
  let { UNWIND_THM2, .. } := D.core6
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET, CLOSURE_OF_SUBTOPOLOGY, .. } := D.met1
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_SUBSET_TRANS,
        OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_TRANS, .. } := D.met3
  let { OPEN_INTER, OPEN_IN_REFL, .. } := BEUC
  let { BALL_SUBSET_CBALL, CENTRE_IN_BALL, OPEN_BALL, .. } := BBAL
  let { OPEN_IN_CONTAINS_CBALL, OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, open_in, .. } := BLOC
  let { EUCLIDEAN_CLOSURE_OF, SUBSET_CLOSURE, .. } := BCLS1
  let { CLOSURE_BALL, .. } := BCBL
  let { OPEN_IN_PCROSS, PASTECART_IN_INTERIOR_SUBTOPOLOGY, .. } := BPCR1
  let { locally, .. } := BLCY1
  -- @@SCOPE END

  let LOCALLY_CLOSED_IN_EXPLICIT ← prove
   r"!s v a:real^N.
        a IN v /\ open_in (subtopology euclidean s) v
        ==> ?u. a IN u /\
                open_in (subtopology euclidean s) u /\
                u SUBSET v /\
                (subtopology euclidean s) closure_of u SUBSET v"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_CONTAINS_CBALL]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"a:real^N"))) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"r:real") THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"s INTER ball(a:real^N,r)") THEN
    ASM_SIMP_TAC [IN_INTER, CENTRE_IN_BALL, OPEN_IN_OPEN_INTER, OPEN_BALL] THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] BALL_SUBSET_CBALL) THEN DISCH_TAC THEN
    REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"b INTER s SUBSET v ==> c SUBSET b ==> s INTER c SUBSET v"))) THEN
    ASM_SIMP_TAC [← GSYM CLOSURE_BALL, EUCLIDEAN_CLOSURE_OF] THEN
    MATCH_MP_TAC SUBSET_CLOSURE THEN SET_TAC [])

  let LOCALLY_CLOSED_IN ← prove
   r"!s:real^N->bool. locally (closed_in (subtopology euclidean s)) s"
   (REWRITE_TAC [locally] THEN REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LOCALLY_CLOSED_IN_EXPLICIT) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"(subtopology euclidean s) closure_of u:real^N->bool") THEN
    ASM_REWRITE_TAC [CLOSED_IN_CLOSURE_OF] THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBSET, OPEN_IN_SUBSET])

  let LOCALLY_EMPTY ← prove
   r"!P. locally P {}"
   (REWRITE_TAC [locally] THEN MESON_TAC [open_in, SUBSET, NOT_IN_EMPTY])

  let LOCALLY_SING ← prove
   r"!P a. locally P {a} <=> P {a}"
   (REWRITE_TAC [locally, open_in] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"(w SUBSET {a} /\ P) /\ x IN w <=> w = {a} /\ x = a /\ P")] THEN
    SIMP_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2, IN_SING] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"(u SUBSET {a} /\ P) /\ Q /\ a IN u /\ u SUBSET v /\ v SUBSET {a} <=>
      u = {a} /\ v = {a} /\ P /\ Q")] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, UNWIND_THM2, IN_SING] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2, ← MESON [REAL_LT_01] (← q r"?x. &0 < x")])

  let LOCALLY_INTER ← prove
   r"!P:(real^N->bool)->bool.
        (!s t. P s /\ P t ==> P(s INTER t))
        ==> !s t. locally P s /\ locally P t ==> locally P (s INTER t)"
   (GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [locally, OPEN_IN_OPEN] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, ← GSYM CONJ_ASSOC, ← MESON []
     (← q r"(!w x. (?t. P t /\ w = f t) /\ Q w x ==> R w x) <=>
      (!t x. P t /\ Q (f t) x ==> R (f t) x)")] THEN
    ONCE_REWRITE_TAC [← MESON []
     (← q r"(?a b c. P a b c /\ Q a b c /\ R a b c) <=>
      (?b c a. Q a b c /\ P a b c /\ R a b c)")] THEN
    REWRITE_TAC [AND_FORALL_THM, UNWIND_THM2, IN_INTER] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"w:real^N->bool") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"u1:real^N->bool") (X_CHOOSE_THEN (← q r"v1:real^N->bool")
          STRIP_ASSUME_TAC))
     (X_CHOOSE_THEN (← q r"u2:real^N->bool") (X_CHOOSE_THEN (← q r"v2:real^N->bool")
          STRIP_ASSUME_TAC))) THEN
    EXISTS_TAC (← q r"u1 INTER u2:real^N->bool") THEN
    EXISTS_TAC (← q r"v1 INTER v2:real^N->bool") THEN
    ASM_SIMP_TAC [OPEN_INTER] THEN ASM SET_TAC [])

  let LOCALLY_INTER_OPEN ← prove
   r"!P s t u:real^N->bool.
        locally P s /\
        open_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) t
        ==> locally P (s INTER t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [locally, IN_INTER] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"t INTER v:real^N->bool", ← q r"x:real^N"]) THEN
    ASM_REWRITE_TAC [IN_INTER] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"s INTER t:real^N->bool") THEN
        CONJ_TAC THENL
         [SUBGOAL_THEN (← q r"t INTER v:real^N->bool = (s INTER t) INTER v")
           (fun th => ASM_SIMP_TAC [th, OPEN_IN_INTER, OPEN_IN_REFL]) THEN
          REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
          ASM SET_TAC [],
          MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
          EXISTS_TAC (← q r"u:real^N->bool") THEN
          ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_REFL] THEN
          ASM_MESON_TAC [OPEN_IN_IMP_SUBSET]],
        REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
        ASM SET_TAC []],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:real^N->bool") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:real^N->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
      ASM SET_TAC []])

  let LOCALLY_OPEN_INTER ← prove
   r"!P s t u:real^N->bool.
        locally P t /\
        open_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) t
        ==> locally P (s INTER t)"
   (ONCE_REWRITE_TAC [INTER_COMM] THEN MESON_TAC [LOCALLY_INTER_OPEN])

  let LOCALLY_PCROSS ← prove
   r"!P Q R.
        (!s:real^M->bool t:real^N->bool. P s /\ Q t ==> R(s PCROSS t))
        ==> (!s t. locally P s /\ locally Q t ==> locally R (s PCROSS t))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [locally, FORALL_PASTECART] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"w:real^(M,N)finite_sum->bool", ← q r"x:real^M", ← q r"y:real^N"] THEN
    DISCH_THEN (fun th => tactic_of do
     pure (STRIP_ASSUME_TAC th THEN
      MP_TAC (← MATCH_MP PASTECART_IN_INTERIOR_SUBTOPOLOGY
          (← ONCE_REWRITE_RULE [CONJ_SYM] th)))) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^N->bool"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^M->bool", ← q r"x:real^M"] o
      GEN_REWRITE_RULE id [locally]) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"v:real^N->bool", ← q r"y:real^N"] o
      GEN_REWRITE_RULE id [locally]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v':real^N->bool", ← q r"v'':real^N->bool"] THEN
    STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"u':real^M->bool", ← q r"u'':real^M->bool"] THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"(u':real^M->bool) PCROSS (v':real^N->bool)") THEN
    EXISTS_TAC (← q r"(u'':real^M->bool) PCROSS (v'':real^N->bool)") THEN
    ASM_SIMP_TAC [PASTECART_IN_PCROSS, PCROSS_MONO, OPEN_IN_PCROSS] THEN
    ASM_MESON_TAC [PCROSS_MONO, SUBSET_TRANS])

  return { LOCALLY_CLOSED_IN_EXPLICIT, LOCALLY_CLOSED_IN, LOCALLY_EMPTY, LOCALLY_SING,
           LOCALLY_INTER, LOCALLY_INTER_OPEN, LOCALLY_OPEN_INTER, LOCALLY_PCROSS }

/- ------------------------------------------------------------------------- -/
/- Local properties under homeomorphisms, translations, linear and open maps. -/
/- (topology.ml 28947-29078)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LCY4 where
  HOMEOMORPHISM_LOCALLY : thm
  HOMEOMORPHIC_LOCALLY : thm
  LOCALLY_TRANSLATION : thm
  LOCALLY_INJECTIVE_LINEAR_IMAGE : thm
  LOCALLY_OPEN_MAP_IMAGE : thm
  LOCALLY_FINE_COVERING_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupLCY4 [HolBase] (D : TopologyDeps) (BLOC : LOC) (BCSL : CSL) (BCMS : CMS) (BIDC : IDC)
    (BLCP : LCP) (BHMA : HMA) (BLCY1 : LCY1) (BLCY2 : LCY2) : ExceptT String IO LCY4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, VECTOR_ARITH, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_UNWIND_THM1, FUN_EQ_THM, IMAGE_ID, IMAGE_o, IMP_CONJ,
        IN_ELIM_THM, .. } := D.core2
  let { I_THM, LEFT_IMP_EXISTS_THM, MONO_FORALL, .. } := D.core3
  let { RIGHT_IMP_FORALL_THM, .. } := D.core5
  let { UNION_OF, o_DEF, o_THM, .. } := D.core6
  let { LINEAR_INJECTIVE_LEFT_INVERSE, .. } := D.vec2
  let { open_in, .. } := BLOC
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_ID, CONTINUOUS_ON_IMP_OPEN_IN, CONTINUOUS_ON_OPEN, .. } := BIDC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { HOMEOMORPHISM_SYM, homeomorphic, homeomorphism, .. } := BHMA
  let { LOCALLY_AND_SMALL_LE, locally, .. } := BLCY1
  let { LOCALLY_IMP_FINITE_UNION_OF, .. } := BLCY2
  -- @@SCOPE END

  let HOMEOMORPHISM_LOCALLY ← do
    let lemma ← prove
     r"!P Q f g.
          (!s t. P s /\ homeomorphism (s,t) (f,g) ==> Q t)
          ==> (!s:real^N->bool t:real^M->bool.
                  locally P s /\ homeomorphism (s,t) (f,g) ==> locally Q t)"
     (REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
      REWRITE_TAC [locally] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
      MAP_EVERY X_GEN_TAC [← q r"w:real^M->bool", ← q r"y:real^M"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"IMAGE (g:real^M->real^N) w", ← q r"(g:real^M->real^N) y"]) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        SUBGOAL_THEN (← q r"IMAGE (g:real^M->real^N) w =
                       {x | x IN s /\ f(x) IN w}")
        SUBST1_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [open_in]) THEN ASM SET_TAC [],
          MATCH_MP_TAC CONTINUOUS_ON_IMP_OPEN_IN THEN ASM_REWRITE_TAC []],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
      STRIP_TAC THEN MAP_EVERY EXISTS_TAC
       [← q r"IMAGE (f:real^N->real^M) u", ← q r"IMAGE (f:real^N->real^M) v"] THEN
      CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"IMAGE (f:real^N->real^M) u =
                       {x | x IN t /\ g(x) IN u}")
        SUBST1_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [open_in]) THEN ASM SET_TAC [],
          MATCH_MP_TAC CONTINUOUS_ON_IMP_OPEN_IN THEN ASM_REWRITE_TAC []],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"v:real^N->bool") THEN
        ASM_REWRITE_TAC [homeomorphism] THEN
        REWRITE_TAC [homeomorphism] THEN REPEAT CONJ_TAC THEN
        TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET))),
        ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [open_in]) THEN ASM SET_TAC [])
    prove
     r"!P Q f:real^N->real^M g.
          (!s t. homeomorphism (s,t) (f,g) ==> (P s <=> Q t))
          ==> (!s t. homeomorphism (s,t) (f,g)
                     ==> (locally P s <=> locally Q t))"
     (REPEAT STRIP_TAC THEN EQ_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM,
            ← TAUT (← q r"p ==> q /\ r ==> s <=> p /\ r ==> q ==> s")] lemma) THEN
      ASM_MESON_TAC [HOMEOMORPHISM_SYM])

  let HOMEOMORPHIC_LOCALLY ← prove
   r"!P Q. (!s:real^N->bool t:real^M->bool. s homeomorphic t ==> (P s <=> Q t))
         ==> (!s t. s homeomorphic t ==> (locally P s <=> locally Q t))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [homeomorphic, LEFT_IMP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← MESON []
     (← q r"(!a b c d. P a b c d) <=> (!c d a b. P a b c d)")] THEN
    GEN_TAC THEN GEN_TAC THEN MATCH_MP_TAC HOMEOMORPHISM_LOCALLY THEN
    ASM_MESON_TAC [homeomorphic])

  let LOCALLY_TRANSLATION ← prove
   r"!P:(real^N->bool)->bool.
        (!a s. P (IMAGE (\x. a + x) s) <=> P s)
        ==> (!a s. locally P (IMAGE (\x. a + x) s) <=> locally P s)"
   (GEN_TAC THEN MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    MP_TAC (← ISPECL
     [← q r"P:(real^N->bool)->bool", ← q r"P:(real^N->bool)->bool",
      ← q r"\x:real^N. a + x", ← q r"\x:real^N. --a + x"]
       HOMEOMORPHISM_LOCALLY) THEN
    REWRITE_TAC [homeomorphism] THEN
    SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
    REWRITE_TAC [FORALL_UNWIND_THM1, IMP_CONJ, ← GSYM IMAGE_o, o_DEF, IMAGE_ID,
                 ← VECTOR_ARITH (← q r"--a + a + x:real^N = x /\ a + --a + x = x")] THEN
    MESON_TAC [])

  let LOCALLY_INJECTIVE_LINEAR_IMAGE ← prove
   r"!P:(real^N->bool)->bool Q:(real^M->bool)->bool.
        (!f s. linear f /\ (!x y. f x = f y ==> x = y)
               ==> (P (IMAGE f s) <=> Q s))
        ==>  (!f s. linear f /\ (!x y. f x = f y ==> x = y)
                    ==> (locally P (IMAGE f s) <=> locally Q s))"
   (GEN_TAC THEN GEN_TAC THEN MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    ASM_CASES_TAC (← q r"linear(f:real^M->real^N) /\ (!x y. f x = f y ==> x = y)") THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^M") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"Q:(real^M->bool)->bool", ← q r"P:(real^N->bool)->bool",
      ← q r"f:real^M->real^N", ← q r"g:real^N->real^M"]
       HOMEOMORPHISM_LOCALLY) THEN
    ASM_SIMP_TAC [homeomorphism, LINEAR_CONTINUOUS_ON] THEN
    ASM_REWRITE_TAC [FORALL_UNWIND_THM1, IMP_CONJ, FORALL_IN_IMAGE] THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_o, o_DEF, IMAGE_ID] THEN MESON_TAC [])

  let LOCALLY_OPEN_MAP_IMAGE ← prove
   r"!P Q f:real^M->real^N s.
        f continuous_on s /\
        (!t. open_in (subtopology euclidean s) t
              ==> open_in (subtopology euclidean (IMAGE f s)) (IMAGE f t)) /\
        (!t. t SUBSET s /\ P t ==> Q(IMAGE f t)) /\
        locally P s
        ==> locally Q (IMAGE f s)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [locally] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"y:real^N"] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [open_in]) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"w:real^N->bool") o
      GEN_REWRITE_RULE id [CONTINUOUS_ON_OPEN]) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"?x. x IN s /\ (f:real^M->real^N) x = y") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"{x | x IN s /\ (f:real^M->real^N) x IN w}", ← q r"x:real^M"]) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^M->bool"] THEN
    STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"IMAGE (f:real^M->real^N) u", ← q r"IMAGE (f:real^M->real^N) v"] THEN
    ASM_SIMP_TAC [] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [])

  let LOCALLY_FINE_COVERING_COMPACT ← prove
   r"!P s:real^N->bool e.
        compact s /\ locally P s /\ &0 < e
        ==> ?f. FINITE f /\ UNIONS f = s /\
                !c. c IN f ==> P c /\ bounded c /\ diameter c <= e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    FIRST_ASSUM (SUBST1_TAC o SPEC (← q r"P:(real^N->bool)->bool") o
      MATCH_MP LOCALLY_AND_SMALL_LE) THEN
    DISCH_THEN (MP_TAC o MATCH_MP LOCALLY_IMP_FINITE_UNION_OF) THEN
    REWRITE_TAC [UNION_OF] THEN MESON_TAC [])

  return { HOMEOMORPHISM_LOCALLY, HOMEOMORPHIC_LOCALLY, LOCALLY_TRANSLATION,
           LOCALLY_INJECTIVE_LINEAR_IMAGE, LOCALLY_OPEN_MAP_IMAGE,
           LOCALLY_FINE_COVERING_COMPACT }

/- ------------------------------------------------------------------------- -/
/- Local countability, constancy, continuity; locally to compactly.          -/
/- (topology.ml 29079-29167)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LCY5 where
  LOCALLY_COUNTABLE : thm
  LOCALLY_CONSTANT : thm
  LOCALLY_CONTINUOUS_ON : thm
  LOCALLY_CONTINUOUS_ON_ALT : thm
  LOCALLY_CONTINUOUS_ON_EXPLICIT : thm
  LOCALLY_TO_COMPACTLY : thm
  deriving Inhabited

@[nospecialize]
def setupLCY5 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLPT : LPT) (BRLM : RLM) (BCPT : CPT)
    (BCSL : CSL) (BLND : LND) (BLCY1 : LCY1) : ExceptT String IO LCY5 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { AND_FORALL_THM, EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, .. } := D.core1
  let { FORALL_IN_IMAGE, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_FORALL, .. } := D.core3
  let { RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_REFL, .. } := D.core5
  let { COUNTABLE_IMAGE, COUNTABLE_SUBSET, COUNTABLE_UNIONS, EXISTS_COUNTABLE_SUBSET_IMAGE, .. } :=
    D.lib1
  let { OPEN_IN_IMP_SUBSET, .. } := D.met3
  let { OPEN_IN_REFL, .. } := BEUC
  let { LOCALLY_CONSTANT_IMP_CONSTANT, .. } := BLPT
  let { LIM_WITHIN_OPEN_IN, .. } := BRLM
  let { COMPACT_EQ_HEINE_BOREL_GEN, .. } := BCPT
  let { CONTINUOUS_ON, CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { LINDELOF_OPEN_IN, .. } := BLND
  let { locally, .. } := BLCY1
  -- @@SCOPE END

  let LOCALLY_COUNTABLE ← prove
   r"!s:real^N->bool. locally COUNTABLE s <=> COUNTABLE s"
   (GEN_TAC THEN REWRITE_TAC [locally] THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o GEN (← q r"x:real^N") o
        SPECL [← q r"s:real^N->bool", ← q r"x:real^N"]) THEN
      REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [OPEN_IN_REFL] THEN MAP_EVERY X_GEN_TAC
       [← q r"u:real^N->real^N->bool", ← q r"vu:real^N->real^N->bool"] THEN
      DISCH_TAC THEN MATCH_MP_TAC COUNTABLE_SUBSET THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE (u:real^N->real^N->bool) s)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MP_TAC (← ISPECL [← q r"IMAGE (u:real^N->real^N->bool) s", ← q r"s:real^N->bool"]
            LINDELOF_OPEN_IN) THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
      REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC COUNTABLE_UNIONS THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      ASM_MESON_TAC [SUBSET, COUNTABLE_SUBSET],
      DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"x:real^N"] THEN
      DISCH_TAC THEN REPEAT (EXISTS_TAC (← q r"w:real^N->bool")) THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN
      ASM_MESON_TAC [COUNTABLE_SUBSET, OPEN_IN_IMP_SUBSET]])

  let LOCALLY_CONSTANT ← prove
   r"!f:real^N->A s.
        connected s
        ==> (locally (\u. ?c. !x. x IN u ==> f x = c) s <=>
             ?c. !x. x IN s ==> f x = c)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [locally] THEN EQ_TAC THENL
     [DISCH_TAC, MESON_TAC [SUBSET, OPEN_IN_IMP_SUBSET]] THEN
    MATCH_MP_TAC LOCALLY_CONSTANT_IMP_CONSTANT THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"s:real^N->bool", ← q r"x:real^N"]) THEN
    ASM_REWRITE_TAC [OPEN_IN_REFL] THEN MESON_TAC [SUBSET])

  let (LOCALLY_CONTINUOUS_ON, LOCALLY_CONTINUOUS_ON_ALT, LOCALLY_CONTINUOUS_ON_EXPLICIT) ←
    match CONJUNCTS (← prove
   r"(!f:real^M->real^N s.
        locally (\u. f continuous_on u) s <=> f continuous_on s) /\
   (!f:real^M->real^N s.
        f continuous_on s <=>
        !x. x IN s ==> ?u v. open_in (subtopology euclidean s) u /\
                             x IN u /\ u SUBSET v /\ f continuous_on v) /\
   (!f:real^M->real^N s.
        f continuous_on s <=>
        !x. x IN s ==> ?u. open_in (subtopology euclidean s) u /\
                           x IN u /\ f continuous_on u)"
   (REWRITE_TAC [AND_FORALL_THM, locally] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p ==> q) /\ (q ==> r) /\ (s ==> p) /\ (r ==> s)
      ==> (p <=> s) /\ (s <=> q) /\ (s <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [OPEN_IN_REFL],
      MESON_TAC [CONTINUOUS_ON_SUBSET],
      MESON_TAC [CONTINUOUS_ON_SUBSET, OPEN_IN_IMP_SUBSET, SUBSET_REFL],
      REWRITE_TAC [CONTINUOUS_ON] THEN
      MATCH_MP_TAC MONO_FORALL THEN MESON_TAC [LIM_WITHIN_OPEN_IN]])) with
    | [a, b, c] => pure (a, b, c)
    | _ => throw "LOCALLY_CONTINUOUS_ON: match failure"

  let LOCALLY_TO_COMPACTLY ← prove
   r"!P s c:real^N->bool.
        (!t u. t SUBSET u /\ u SUBSET s /\ P u ==> P t) /\
        (!f. FINITE f /\ (!t. t IN f ==> P t /\ t SUBSET s)
             ==> P(UNIONS f)) /\
        locally P s /\ compact c /\ c SUBSET s
        ==> P c"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
    ASM_REWRITE_TAC [OPEN_IN_REFL, RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->real^N->bool", ← q r"v:real^N->real^N->bool"] THEN
    DISCH_TAC THEN FIRST_ASSUM (MP_TAC o
      GEN_REWRITE_RULE id [COMPACT_EQ_HEINE_BOREL_GEN]) THEN DISCH_THEN (MP_TAC o
      SPECL [← q r"IMAGE (u:real^N->real^N->bool) s", ← q r"s:real^N->bool"]) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> b /\ a /\ c")] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    EXISTS_TAC (← q r"UNIONS (IMAGE (v:real^N->real^N->bool) k)") THEN
    REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN ASM SET_TAC [])

  return { LOCALLY_COUNTABLE, LOCALLY_CONSTANT, LOCALLY_CONTINUOUS_ON,
           LOCALLY_CONTINUOUS_ON_ALT, LOCALLY_CONTINUOUS_ON_EXPLICIT, LOCALLY_TO_COMPACTLY }

/- ------------------------------------------------------------------------- -/
/- Local compactness.  (topology.ml 29168-29368)                             -/
/- ------------------------------------------------------------------------- -/

structure LCC1 where
  LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN : thm
  LOCALLY_COMPACT : thm
  LOCALLY_COMPACT_ALT : thm
  LOCALLY_COMPACT_INTER_CBALL : thm
  LOCALLY_COMPACT_INTER_CBALLS : thm
  LOCALLY_COMPACT_COMPACT : thm
  LOCALLY_COMPACT_COMPACT_ALT : thm
  LOCALLY_COMPACT_COMPACT_SUBOPEN : thm
  OPEN_IMP_LOCALLY_COMPACT : thm
  CLOSED_IMP_LOCALLY_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupLCC1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLOC : LOC)
    (BCLS1 : CLS1) (BCBL : CBL) (BBND1 : BND1) (BCPT : CPT) (BCPP1 : CPP1) (BCPP2 : CPP2)
    (BLCY1 : LCY1) : ExceptT String IO LCC1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, INTER_ASSOC, INTER_COMM, INTER_SUBSET, IN_INTER, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_01, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, SING_SUBSET, SKOLEM_THM, SUBSET, SUBSET_INTER, SUBSET_TRANS,
        SUBSET_UNIV, .. } := D.core5
  let { UNIONS_IMAGE, .. } := D.core6
  let { COMPACT_IN_SUBTOPOLOGY, .. } := D.met1
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE,
        NEIGHBOURHOOD_BASE_OF, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_UNIONS, .. } :=
    D.met3
  let { HAUSDORFF_SPACE_EUCLIDEAN, OPEN_IN_REFL, OPEN_UNIV, .. } := BEUC
  let { CLOSED_INTER, .. } := BCLO
  let { BALL_SUBSET_CBALL, CBALL_MIN_INTER, CENTRE_IN_BALL, OPEN_BALL, OPEN_CONTAINS_CBALL, .. } :=
    BBAL
  let { OPEN_IN_CONTAINS_CBALL, OPEN_IN_INTER_OPEN, OPEN_IN_OPEN, OPEN_IN_OPEN_INTER,
        OPEN_OPEN_IN_TRANS, .. } := BLOC
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, SUBSET_CLOSURE, .. } := BCLS1
  let { CLOSED_CBALL, .. } := BCBL
  let { BOUNDED_CBALL, BOUNDED_INTER, BOUNDED_SUBSET, .. } := BBND1
  let { COMPACT_CLOSURE, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY,
        COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPACT_IN_EUCLIDEAN, .. } := BCPT
  let { CLOSED_INTER_COMPACT, COMPACT_INTER, COMPACT_SING, .. } := BCPP1
  let { COMPACT_CBALL, COMPACT_UNIONS, .. } := BCPP2
  let { NEIGHBOURHOOD_BASE_OF_EUCLIDEAN, locally, .. } := BLCY1
  -- @@SCOPE END

  let LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        locally_compact_space(subtopology euclidean s) <=>
        locally compact s"
   (GEN_TAC THEN
    REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_EUCLIDEAN] THEN
    SIMP_TAC [LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE,
              HAUSDORFF_SPACE_EUCLIDEAN, HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, NEIGHBOURHOOD_BASE_OF] THEN
    REWRITE_TAC [COMPACT_IN_EUCLIDEAN] THEN
    MESON_TAC [SUBSET, OPEN_IN_IMP_SUBSET])

  let LOCALLY_COMPACT ← prove
   r"!s:real^N->bool.
        locally compact s <=>
        !x. x IN s ==> ?u v. x IN u /\ u SUBSET v /\ v SUBSET s /\
                             open_in (subtopology euclidean s) u /\
                             compact v"
   (GEN_TAC THEN REWRITE_TAC [locally] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN FIRST_X_ASSUM
       (MP_TAC o SPECL [← q r"s INTER ball(x:real^N,&1)", ← q r"x:real^N"]) THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL] THEN
      ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL, REAL_LT_01] THEN
      MESON_TAC [SUBSET_INTER],
      MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"x:real^N"] THEN
      REWRITE_TAC [IMP_CONJ] THEN GEN_REWRITE_TAC LAND_CONV [OPEN_IN_OPEN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(s INTER ball(x:real^N,e)) INTER u") THEN
      EXISTS_TAC (← q r"cball(x:real^N,e) INTER v") THEN
      ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_OPEN_INTER, OPEN_BALL, CENTRE_IN_BALL,
                    COMPACT_INTER, COMPACT_CBALL, IN_INTER] THEN
      MP_TAC (← ISPECL [← q r"x:real^N", ← q r"e:real"] BALL_SUBSET_CBALL) THEN
      ASM SET_TAC []])

  let LOCALLY_COMPACT_ALT ← prove
   r"!s:real^N->bool.
        locally compact s <=>
        !x. x IN s
            ==> ?u. x IN u /\
                    open_in (subtopology euclidean s) u /\
                    compact(closure u) /\ closure u SUBSET s"
   (GEN_TAC THEN REWRITE_TAC [LOCALLY_COMPACT] THEN EQ_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
    MESON_TAC [CLOSURE_SUBSET, SUBSET_TRANS, CLOSURE_MINIMAL,
               COMPACT_CLOSURE, BOUNDED_SUBSET, COMPACT_EQ_BOUNDED_CLOSED])

  let LOCALLY_COMPACT_INTER_CBALL ← prove
   r"!s:real^N->bool.
        locally compact s <=>
        !x. x IN s ==> ?e. &0 < e /\ closed(cball(x,e) INTER s)"
   (GEN_TAC THEN REWRITE_TAC [LOCALLY_COMPACT, OPEN_IN_CONTAINS_CBALL] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^N") THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THENL
     [MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"cball(x:real^N,e) INTER s = cball (x,e) INTER v")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [COMPACT_CBALL, COMPACT_INTER, COMPACT_IMP_CLOSED],
      X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"ball(x:real^N,e) INTER s") THEN
      EXISTS_TAC (← q r"cball(x:real^N,e) INTER s") THEN
      REWRITE_TAC [← GSYM OPEN_IN_CONTAINS_CBALL] THEN
      ASM_SIMP_TAC [IN_INTER, CENTRE_IN_BALL, INTER_SUBSET] THEN
      ASM_SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_INTER, BOUNDED_CBALL] THEN
      ONCE_REWRITE_TAC [INTER_COMM] THEN
      SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL] THEN
      MESON_TAC [SUBSET, IN_INTER, BALL_SUBSET_CBALL]])

  let LOCALLY_COMPACT_INTER_CBALLS ← prove
   r"!s:real^N->bool.
      locally compact s <=>
      !x. x IN s ==> ?e. &0 < e /\ !d. d <= e ==> closed(cball(x,d) INTER s)"
   (GEN_TAC THEN REWRITE_TAC [LOCALLY_COMPACT_INTER_CBALL] THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC [REAL_LE_REFL]] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^N") THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN GEN_TAC THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"cball(x:real^N,d) INTER s = cball(x,d) INTER cball(x,e) INTER s")
    SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM INTER_ASSOC, ← GSYM CBALL_MIN_INTER] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      BINOP_TAC THEN REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ASM_SIMP_TAC [CLOSED_INTER, CLOSED_CBALL]])

  let LOCALLY_COMPACT_COMPACT ← prove
   r"!s:real^N->bool.
        locally compact s <=>
        !k. k SUBSET s /\ compact k
            ==> ?u v. k SUBSET u /\
                      u SUBSET v /\
                      v SUBSET s /\
                      open_in (subtopology euclidean s) u /\
                      compact v"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [LOCALLY_COMPACT] THEN EQ_TAC THEN
    REPEAT STRIP_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [SING_SUBSET, COMPACT_SING]] THEN
    FIRST_X_ASSUM (MP_TAC o REWRITE_RULE [RIGHT_IMP_EXISTS_THM] o
          check (HolCore.Basics.is_forall o concl)) THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->real^N->bool", ← q r"v:real^N->real^N->bool"] THEN
    DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
     [COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (\x:real^N. k INTER u x) k")) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, UNIONS_IMAGE] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC OPEN_IN_INTER THEN REWRITE_TAC [OPEN_IN_REFL] THEN
      ASM SET_TAC [],
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
      REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE, UNIONS_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE (u:real^N->real^N->bool) t)") THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE (v:real^N->real^N->bool) t)") THEN
      REPEAT CONJ_TAC THENL
       [ALL_TAC, ALL_TAC, ALL_TAC, MATCH_MP_TAC OPEN_IN_UNIONS,
        MATCH_MP_TAC COMPACT_UNIONS THEN ASM_SIMP_TAC [FINITE_IMAGE]] THEN
      ASM SET_TAC []])

  let LOCALLY_COMPACT_COMPACT_ALT ← prove
   r"!s:real^N->bool.
        locally compact s <=>
        !k. k SUBSET s /\ compact k
            ==> ?u. k SUBSET u /\
                    open_in (subtopology euclidean s) u /\
                    compact(closure u) /\ closure u SUBSET s"
   (GEN_TAC THEN REWRITE_TAC [LOCALLY_COMPACT_COMPACT] THEN EQ_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"k:real^N->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:real^N->bool")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
    MESON_TAC [CLOSURE_SUBSET, SUBSET_TRANS, CLOSURE_MINIMAL,
               COMPACT_CLOSURE, BOUNDED_SUBSET, COMPACT_EQ_BOUNDED_CLOSED])

  let LOCALLY_COMPACT_COMPACT_SUBOPEN ← prove
   r"!s:real^N->bool.
        locally compact s <=>
        !k t. k SUBSET s /\ compact k /\ open t /\ k SUBSET t
              ==> ?u v. k SUBSET u /\ u SUBSET v /\ u SUBSET t /\ v SUBSET s /\
                        open_in (subtopology euclidean s) u /\
                        compact v"
   (GEN_TAC THEN REWRITE_TAC [LOCALLY_COMPACT_COMPACT] THEN
    EQ_TAC THEN DISCH_TAC THEN REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:real^N->bool")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
      STRIP_TAC THEN MAP_EVERY EXISTS_TAC
       [← q r"u INTER t:real^N->bool", ← q r"closure(u INTER t:real^N->bool)"] THEN
      REWRITE_TAC [CLOSURE_SUBSET, INTER_SUBSET] THEN REPEAT CONJ_TAC THENL
       [ASM SET_TAC [],
        TRANS_TAC SUBSET_TRANS (← q r"closure(u:real^N->bool)") THEN
        SIMP_TAC [SUBSET_CLOSURE, INTER_SUBSET] THEN
        TRANS_TAC SUBSET_TRANS (← q r"v:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED],
        ASM_SIMP_TAC [OPEN_IN_INTER_OPEN],
        REWRITE_TAC [COMPACT_CLOSURE] THEN
        ASM_MESON_TAC [BOUNDED_SUBSET, INTER_SUBSET, SUBSET_TRANS,
                       COMPACT_IMP_BOUNDED]],
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"k:real^N->bool", ← q r"(:real^N)"]) THEN
      ASM_REWRITE_TAC [OPEN_UNIV, SUBSET_UNIV]])

  let OPEN_IMP_LOCALLY_COMPACT ← prove
   r"!s:real^N->bool. open s ==> locally compact s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [LOCALLY_COMPACT] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN FIRST_ASSUM
     (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    MAP_EVERY EXISTS_TAC [← q r"ball(x:real^N,e)", ← q r"cball(x:real^N,e)"] THEN
    ASM_REWRITE_TAC [BALL_SUBSET_CBALL, CENTRE_IN_BALL, COMPACT_CBALL] THEN
    MATCH_MP_TAC OPEN_OPEN_IN_TRANS THEN ASM_REWRITE_TAC [OPEN_BALL] THEN
    ASM_MESON_TAC [BALL_SUBSET_CBALL, SUBSET_TRANS])

  let CLOSED_IMP_LOCALLY_COMPACT ← prove
   r"!s:real^N->bool. closed s ==> locally compact s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [LOCALLY_COMPACT] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"s INTER ball(x:real^N,&1)", ← q r"s INTER cball(x:real^N,&1)"] THEN
    ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL, INTER_SUBSET, REAL_LT_01] THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL] THEN
    ASM_SIMP_TAC [CLOSED_INTER_COMPACT, COMPACT_CBALL] THEN
    MP_TAC (← ISPECL [← q r"x:real^N", ← q r"&1"] BALL_SUBSET_CBALL) THEN ASM SET_TAC [])

  return { LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN, LOCALLY_COMPACT, LOCALLY_COMPACT_ALT,
           LOCALLY_COMPACT_INTER_CBALL, LOCALLY_COMPACT_INTER_CBALLS, LOCALLY_COMPACT_COMPACT,
           LOCALLY_COMPACT_COMPACT_ALT, LOCALLY_COMPACT_COMPACT_SUBOPEN,
           OPEN_IMP_LOCALLY_COMPACT, CLOSED_IMP_LOCALLY_COMPACT }

/- ------------------------------------------------------------------------- -/
/- Local compactness of intervals, intersections, images; locally closed.    -/
/- (topology.ml 29369-29495)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LCC2 where
  IS_INTERVAL_LOCALLY_COMPACT_INTERVAL : thm
  IS_INTERVAL_IMP_LOCALLY_COMPACT : thm
  LOCALLY_COMPACT_UNIV : thm
  LOCALLY_COMPACT_SPACE_EUCLIDEAN : thm
  LOCALLY_COMPACT_INTER : thm
  LOCALLY_COMPACT_OPEN_IN : thm
  LOCALLY_COMPACT_CLOSED_IN : thm
  LOCALLY_COMPACT_DELETE : thm
  SIGMA_COMPACT : thm
  HOMEOMORPHIC_LOCAL_COMPACTNESS : thm
  LOCALLY_COMPACT_TRANSLATION_EQ : thm
  LOCALLY_COMPACT_LINEAR_IMAGE_EQ : thm
  HOMEOMORPHISM_LOCAL_COMPACTNESS : thm
  LOCALLY_CLOSED : thm
  deriving Inhabited

@[nospecialize]
def setupLCC2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BLOC : LOC) (BCPT : CPT)
    (BCPP1 : CPP1) (BCPP2 : CPP2) (BLCP : LCP) (BITV1 : ITV1) (BITV2 : ITV2) (BIVG2 : IVG2)
    (BHMA : HMA) (BCHP : CHP) (BLCY1 : LCY1) (BLCY2 : LCY2) (BLCY3 : LCY3) (BLCY4 : LCY4)
    (BLCC1 : LCC1) : ExceptT String IO LCC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, add_linear_invariants, add_translation_invariants, .. } :=
    D
  let { IMP_CONJ, IN_INTER, .. } := D.core2
  let { LEFT_AND_EXISTS_THM, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { REAL_LT_01, .. } := D.core4
  let { SUBSET, .. } := D.core5
  let { UNION_OF, .. } := D.core6
  let { INTERVAL_OPEN_SUBSET_CLOSED, INTER_INTERVAL, .. } := D.vec2
  let { OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.met3
  let { OPEN_INTER, OPEN_IN_REFL, OPEN_UNIV, .. } := BEUC
  let { BALL_SUBSET_CBALL, CENTRE_IN_BALL, OPEN_BALL, .. } := BBAL
  let { CLOSED_IN_CLOSED, OPEN_IN_INTER_OPEN, OPEN_IN_OPEN, .. } := BLOC
  let { COMPACT_IMP_CLOSED, COMPACT_INTERVAL, .. } := BCPT
  let { CLOSED_INTER_COMPACT, COMPACT_INTER, .. } := BCPP1
  let { COMPACT_CBALL, OPEN_IN_DELETE, .. } := BCPP2
  let { COMPACT_LINEAR_IMAGE_EQ, COMPACT_TRANSLATION_EQ, .. } := BLCP
  let { OPEN_INTERVAL, .. } := BITV1
  let { OPEN_CONTAINS_INTERVAL, .. } := BITV2
  let { INTERVAL_CONTAINS_COMPACT_NEIGHBOURHOOD, .. } := BIVG2
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, homeomorphic, homeomorphism, .. } := BHMA
  let { HOMEOMORPHIC_COMPACTNESS, .. } := BCHP
  let { LOCALLY_MONO, locally, .. } := BLCY1
  let { LOCALLY_IMP_COUNTABLE_UNION_OF, .. } := BLCY2
  let { LOCALLY_INTER, .. } := BLCY3
  let { HOMEOMORPHIC_LOCALLY, LOCALLY_INJECTIVE_LINEAR_IMAGE, LOCALLY_TRANSLATION, .. } := BLCY4
  let { CLOSED_IMP_LOCALLY_COMPACT, LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN,
        OPEN_IMP_LOCALLY_COMPACT, .. } := BLCC1
  -- @@SCOPE END

  let IS_INTERVAL_LOCALLY_COMPACT_INTERVAL ← prove
   r"!s:real^N->bool.
        is_interval s ==> locally (\k. ?a b. k = interval[a,b]) s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [locally] THEN
    REWRITE_TAC [OPEN_IN_OPEN, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"ww:real^N->bool", ← q r"x:real^N", ← q r"w:real^N->bool"] THEN
    ASM_CASES_TAC (← q r"s INTER w:real^N->bool = ww") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN REWRITE_TAC [IN_INTER] THEN
    STRIP_TAC THEN MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N"]
     INTERVAL_CONTAINS_COMPACT_NEIGHBOURHOOD) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, SUBSET], ALL_TAC] THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N", ← q r"e:real"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_INTERVAL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^N", ← q r"d:real^N"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"s INTER ball(x:real^N,e) INTER interval(c,d)") THEN
    EXISTS_TAC (← q r"interval[a:real^N,b] INTER interval[c:real^N,d]") THEN
    EXISTS_TAC (← q r"ball(x:real^N,e) INTER interval(c,d)") THEN
    ASM_SIMP_TAC [OPEN_INTERVAL, OPEN_INTER, OPEN_BALL, IN_INTER] THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL, LEFT_EXISTS_AND_THM] THEN CONJ_TAC THENL
     [REWRITE_TAC [INTER_INTERVAL] THEN MESON_TAC [],
      MP_TAC (← ISPECL [← q r"c:real^N", ← q r"d:real^N"] INTERVAL_OPEN_SUBSET_CLOSED) THEN
      ASM SET_TAC []])

  let IS_INTERVAL_IMP_LOCALLY_COMPACT ← prove
   r"!s:real^N->bool. is_interval s ==> locally compact s"
   (GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP IS_INTERVAL_LOCALLY_COMPACT_INTERVAL) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LOCALLY_MONO) THEN
    SIMP_TAC [LEFT_IMP_EXISTS_THM, COMPACT_INTERVAL])

  let LOCALLY_COMPACT_UNIV ← prove
   r"locally compact (:real^N)"
   (SIMP_TAC [OPEN_IMP_LOCALLY_COMPACT, OPEN_UNIV])

  let LOCALLY_COMPACT_SPACE_EUCLIDEAN ← prove
   r"locally_compact_space (euclidean:(real^N)topology)"
   (MP_TAC (← ISPEC (← q r"(:real^N)") LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN) THEN
    REWRITE_TAC [SUBTOPOLOGY_UNIV, LOCALLY_COMPACT_UNIV])

  let LOCALLY_COMPACT_INTER ← prove
   r"!s t:real^N->bool.
        locally compact s /\ locally compact t
        ==> locally compact (s INTER t)"
   (MATCH_MP_TAC LOCALLY_INTER THEN REWRITE_TAC [COMPACT_INTER])

  let LOCALLY_COMPACT_OPEN_IN ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean s) t /\ locally compact s
        ==> locally compact t"
   (REWRITE_TAC [OPEN_IN_OPEN] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [LOCALLY_COMPACT_INTER, OPEN_IMP_LOCALLY_COMPACT])

  let LOCALLY_COMPACT_CLOSED_IN ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean s) t /\ locally compact s
        ==> locally compact t"
   (REWRITE_TAC [CLOSED_IN_CLOSED] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [LOCALLY_COMPACT_INTER, CLOSED_IMP_LOCALLY_COMPACT])

  let LOCALLY_COMPACT_DELETE ← prove
   r"!s a:real^N. locally compact s ==> locally compact (s DELETE a)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LOCALLY_COMPACT_OPEN_IN THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN
    ASM_SIMP_TAC [OPEN_IN_DELETE, OPEN_IN_REFL])

  let SIGMA_COMPACT ← prove
   r"!s:real^N->bool.
        locally compact s
        ==> ?f. COUNTABLE f /\ (!t. t IN f ==> compact t) /\ UNIONS f = s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP LOCALLY_IMP_COUNTABLE_UNION_OF) THEN
    REWRITE_TAC [UNION_OF])

  let HOMEOMORPHIC_LOCAL_COMPACTNESS ← prove
   r"!s t:real^N->bool.
        s homeomorphic t ==> (locally compact s <=> locally compact t)"
   (MATCH_MP_TAC HOMEOMORPHIC_LOCALLY THEN
    REWRITE_TAC [HOMEOMORPHIC_COMPACTNESS])

  let LOCALLY_COMPACT_TRANSLATION_EQ ← prove
   r"!a:real^N s. locally compact (IMAGE (\x. a + x) s) <=>
                locally compact s"
   (MATCH_MP_TAC LOCALLY_TRANSLATION THEN
    REWRITE_TAC [COMPACT_TRANSLATION_EQ])

  add_translation_invariants [LOCALLY_COMPACT_TRANSLATION_EQ]

  let LOCALLY_COMPACT_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (locally compact (IMAGE f s) <=> locally compact s)"
   (MATCH_MP_TAC LOCALLY_INJECTIVE_LINEAR_IMAGE THEN
    REWRITE_TAC [COMPACT_LINEAR_IMAGE_EQ])

  add_linear_invariants [LOCALLY_COMPACT_LINEAR_IMAGE_EQ]

  let HOMEOMORPHISM_LOCAL_COMPACTNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (locally compact (IMAGE f k) <=> locally compact k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_LOCAL_COMPACTNESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let LOCALLY_CLOSED ← prove
   r"!s:real^N->bool. locally closed s <=> locally compact s"
   (GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [LOCALLY_MONO, COMPACT_IMP_CLOSED]] THEN
    REWRITE_TAC [locally] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:real^N->bool", ← q r"x:real^N"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"u INTER ball(x:real^N,&1)") THEN
    EXISTS_TAC (← q r"v INTER cball(x:real^N,&1)") THEN
    ASM_SIMP_TAC [OPEN_IN_INTER_OPEN, OPEN_BALL] THEN
    ASM_SIMP_TAC [CLOSED_INTER_COMPACT, COMPACT_CBALL] THEN
    ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL, REAL_LT_01] THEN
    MP_TAC (← ISPEC (← q r"x:real^N") BALL_SUBSET_CBALL) THEN ASM SET_TAC [])

  return { IS_INTERVAL_LOCALLY_COMPACT_INTERVAL, IS_INTERVAL_IMP_LOCALLY_COMPACT,
           LOCALLY_COMPACT_UNIV, LOCALLY_COMPACT_SPACE_EUCLIDEAN, LOCALLY_COMPACT_INTER, LOCALLY_COMPACT_OPEN_IN,
           LOCALLY_COMPACT_CLOSED_IN, LOCALLY_COMPACT_DELETE, SIGMA_COMPACT,
           HOMEOMORPHIC_LOCAL_COMPACTNESS, LOCALLY_COMPACT_TRANSLATION_EQ,
           LOCALLY_COMPACT_LINEAR_IMAGE_EQ, HOMEOMORPHISM_LOCAL_COMPACTNESS, LOCALLY_CLOSED }

/- ------------------------------------------------------------------------- -/
/- Local compactness of unions and products; open sets in locally compact.   -/
/- (topology.ml 29496-29634)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LCC3 where
  LOCALLY_COMPACT_CLOSED_UNION : thm
  LOCALLY_COMPACT_OPEN_UNIONS : thm
  LOCALLY_COMPACT_OPEN_UNION : thm
  LOCALLY_COMPACT_PCROSS : thm
  LOCALLY_COMPACT_PCROSS_EQ : thm
  OPEN_IN_LOCALLY_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupLCC3 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLOC : LOC)
    (BLPT : LPT) (BCLS1 : CLS1) (BCBL : CBL) (BBND1 : BND1) (BCPT : CPT) (BPCR1 : PCR1)
    (BHMC : HMC) (BLCY3 : LCY3) (BLCC1 : LCC1) (BLCC2 : LCC2) : ExceptT String IO LCC3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, INTRO_TAC, .. } := D
  let { FORALL_IN_INSERT, FORALL_IN_UNIONS, IMP_CONJ, INTER_ACI, INTER_PCROSS, INTER_SUBSET,
        INTER_UNIV, IN_DIFF, IN_INTER, .. } := D.core2
  let { IN_UNION, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY,
        PCROSS_EMPTY, .. } := D.core3
  let { REAL_LT_MIN, .. } := D.core4
  let { SUBSET_TRANS, SUBSET_UNION, .. } := D.core5
  let { UNIONS_2, UNIONS_SUBSET, UNION_SUBSET, .. } := D.core6
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_SUBSET_TRANS, .. } := D.met1
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET_TRANS, OPEN_IN_TRANS, closed_in, .. } :=
    D.met3
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_INTER, CLOSED_UNION, CLOSED_UNIV, .. } := BCLO
  let { CBALL_MIN_INTER, .. } := BBAL
  let { OPEN_IN_CONTAINS_CBALL, OPEN_IN_OPEN, .. } := BLOC
  let { CLOSED_SING, .. } := BLPT
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, .. } := BCLS1
  let { CLOSED_CBALL, .. } := BCBL
  let { BOUNDED_SUBSET, .. } := BBND1
  let { COMPACT_CLOSURE, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := BCPT
  let { COMPACT_PCROSS, .. } := BPCR1
  let { HOMEOMORPHIC_PCROSS_SING, .. } := BHMC
  let { LOCALLY_EMPTY, LOCALLY_PCROSS, .. } := BLCY3
  let { CLOSED_IMP_LOCALLY_COMPACT, LOCALLY_COMPACT, LOCALLY_COMPACT_ALT,
        LOCALLY_COMPACT_INTER_CBALL, .. } := BLCC1
  let { HOMEOMORPHIC_LOCAL_COMPACTNESS, LOCALLY_COMPACT_INTER, .. } := BLCC2
  -- @@SCOPE END

  let LOCALLY_COMPACT_CLOSED_UNION ← prove
   r"!s t u:real^N->bool.
        locally compact s /\ locally compact t /\
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t
        ==> locally compact (s UNION t)"
   (SUBGOAL_THEN
     (← q r"!s t:real^N->bool.
          locally compact s /\ locally compact t /\
          closed_in (subtopology euclidean (s UNION t)) s /\
          closed_in (subtopology euclidean (s UNION t)) t
          ==> locally compact (s UNION t)")
    MP_TAC THENL
     [ALL_TAC,
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [CLOSED_IN_SUBSET_TRANS, SUBSET_UNION, UNION_SUBSET,
                     CLOSED_IN_IMP_SUBSET]] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [LOCALLY_COMPACT_INTER_CBALL, IN_UNION] THEN
    INTRO_TAC "lcs lct cs ct" THEN X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_THEN (STRIP_ASSUME_TAC o MATCH_MP (← TAUT
     (← q r"p \/ q ==> p /\ q \/ p /\ ~q \/ q /\ ~p")))
    THENL
     [REMOVE_THEN "lct" (MP_TAC o SPEC (← q r"x:real^N")) THEN
      REMOVE_THEN "lcs" (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"min d e:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      SIMP_TAC [← SET_RULE (← q r"u INTER (s UNION t) = u INTER s UNION u INTER t")] THEN
      MATCH_MP_TAC CLOSED_UNION THEN REWRITE_TAC [CBALL_MIN_INTER] THEN
      ASM_MESON_TAC [CLOSED_CBALL, CLOSED_INTER, INTER_ACI],
      REMOVE_THEN "lcs" (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      REMOVE_THEN "ct" (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [closed_in]),
      REMOVE_THEN "lct" (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      REMOVE_THEN "cs" (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [closed_in])] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_CONTAINS_CBALL]) THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, IN_DIFF, IN_UNION] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N") o CONJUNCT2) THEN ASM_SIMP_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d e:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THENL
     [SUBGOAL_THEN (← q r"cball (x:real^N,min d e) INTER (s UNION t) =
                    cball(x,d) INTER cball (x,e) INTER s") SUBST1_TAC
      THENL [REWRITE_TAC [CBALL_MIN_INTER] THEN ASM SET_TAC [], ALL_TAC],
      SUBGOAL_THEN (← q r"cball (x:real^N,min d e) INTER (s UNION t) =
                    cball(x,d) INTER cball (x,e) INTER t") SUBST1_TAC
      THENL [REWRITE_TAC [CBALL_MIN_INTER] THEN ASM SET_TAC [], ALL_TAC]] THEN
    ASM_MESON_TAC [CLOSED_INTER, CLOSED_CBALL])

  let LOCALLY_COMPACT_OPEN_UNIONS ← prove
   r"!f:(real^N->bool)->bool u.
        (!c. c IN f ==> locally compact c) /\
        (!c. c IN f ==> open_in (subtopology euclidean u) c)
        ==> locally compact (UNIONS f)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [LOCALLY_COMPACT_ALT, FORALL_IN_UNIONS] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"t:real^N->bool") o
      GEN_REWRITE_RULE (BINDER_CONV o RAND_CONV) [LOCALLY_COMPACT_ALT]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
    EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [OPEN_IN_TRANS], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [UNIONS_SUBSET]] THEN
    ASM_MESON_TAC [OPEN_IN_IMP_SUBSET])

  let LOCALLY_COMPACT_OPEN_UNION ← prove
   r"!s t:real^N->bool u.
        locally compact s /\ locally compact t /\
        open_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) t
        ==> locally compact (s UNION t)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{s:real^N->bool,t}", ← q r"u:real^N->bool"]
      LOCALLY_COMPACT_OPEN_UNIONS) THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, UNIONS_2])

  let LOCALLY_COMPACT_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        locally compact s /\ locally compact t
        ==> locally compact (s PCROSS t)"
   (MATCH_MP_TAC LOCALLY_PCROSS THEN REWRITE_TAC [COMPACT_PCROSS])

  let LOCALLY_COMPACT_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        locally compact (s PCROSS t) <=>
        s = {} \/ t = {} \/ locally compact s /\ locally compact t"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [LOCALLY_COMPACT_PCROSS, PCROSS_EMPTY, LOCALLY_EMPTY] THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> s) /\ (~q ==> r) ==> p \/ q \/ r /\ s")) THEN
    CONJ_TAC THEN REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THENL
     [X_GEN_TAC (← q r"a:real^M"), X_GEN_TAC (← q r"b:real^N")] THEN
    DISCH_TAC THEN FIRST_ASSUM
     (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] LOCALLY_COMPACT_INTER))
    THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"{a:real^M} PCROSS (:real^N)")),
      DISCH_THEN (MP_TAC o SPEC (← q r"(:real^M) PCROSS {b:real^N}"))] THEN
    ASM_SIMP_TAC [LOCALLY_COMPACT_PCROSS, CLOSED_IMP_LOCALLY_COMPACT,
                  CLOSED_UNIV, CLOSED_SING, INTER_PCROSS, INTER_UNIV,
                  ← SET_RULE (← q r"a IN s ==> s INTER {a} = {a}")] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_PCROSS_SING, HOMEOMORPHIC_LOCAL_COMPACTNESS])

  let OPEN_IN_LOCALLY_COMPACT ← prove
   r"!s t:real^N->bool.
        locally compact s
        ==> (open_in (subtopology euclidean s) t <=>
             t SUBSET s /\
             !k. compact k /\ k SUBSET s
                 ==> open_in (subtopology euclidean k) (k INTER t))"
   (REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [],
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_COMPACT]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"t INTER u:real^N->bool") THEN
      ASM_REWRITE_TAC [IN_INTER, INTER_SUBSET] THEN
      MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"u:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"closure u:real^N->bool")) THEN
      ANTS_TAC THENL
       [SUBGOAL_THEN (← q r"(closure u:real^N->bool) SUBSET v") MP_TAC THENL
         [MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED],
          REWRITE_TAC [COMPACT_CLOSURE] THEN
          ASM_MESON_TAC [SUBSET_TRANS, BOUNDED_SUBSET, COMPACT_IMP_BOUNDED]],
        REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN
        MP_TAC (← ISPEC (← q r"u:real^N->bool") CLOSURE_SUBSET) THEN SET_TAC []]])

  return { LOCALLY_COMPACT_CLOSED_UNION, LOCALLY_COMPACT_OPEN_UNIONS,
           LOCALLY_COMPACT_OPEN_UNION, LOCALLY_COMPACT_PCROSS, LOCALLY_COMPACT_PCROSS_EQ,
           OPEN_IN_LOCALLY_COMPACT }

/- ------------------------------------------------------------------------- -/
/- Local compactness under proper maps.  (topology.ml 29635-29742)           -/
/- ------------------------------------------------------------------------- -/

structure LCC4 where
  LOCALLY_COMPACT_PROPER_IMAGE_EQ : thm
  LOCALLY_COMPACT_PROPER_IMAGE : thm
  LOCALLY_COMPACT_PROPER_CONTINUOUS_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupLCC4 [HolBase] (D : TopologyDeps) (BCLS1 : CLS1) (BBND1 : BND1) (BCPT : CPT)
    (BCSL : CSL) (BIDC : IDC) (BLCP : LCP) (BOCM2 : OCM2) (BPRP1 : PRP1) (BLCC1 : LCC1) :
    ExceptT String IO LCC4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { FUN_IN_IMAGE, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IN_ELIM_THM, IN_SING, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core3
  let { SING_SUBSET, SUBSET_REFL, SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.core5
  let { OPEN_IN_IMP_SUBSET, .. } := D.met3
  let { CLOSED_CLOSURE, CLOSURE_MINIMAL, CLOSURE_SUBSET, SUBSET_CLOSURE, .. } := BCLS1
  let { BOUNDED_SUBSET, .. } := BBND1
  let { COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := BIDC
  let { COMPACT_CONTINUOUS_IMAGE, .. } := BLCP
  let { CLOSED_MAP_OPEN_SUPERSET_PREIMAGE, .. } := BOCM2
  let { PROPER_MAP, .. } := BPRP1
  let { LOCALLY_COMPACT, LOCALLY_COMPACT_ALT, LOCALLY_COMPACT_COMPACT_ALT, .. } := BLCC1
  -- @@SCOPE END

  let LOCALLY_COMPACT_PROPER_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\
        (!k. k SUBSET (IMAGE f s) /\ compact k
             ==> compact {x | x IN s /\ f x IN k})
        ==> (locally compact s <=> locally compact (IMAGE f s))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool",
                      ← q r"IMAGE (f:real^M->real^N) s"] PROPER_MAP) THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [REWRITE_TAC [LOCALLY_COMPACT_ALT] THEN X_GEN_TAC (← q r"y:real^N") THEN
      DISCH_TAC THEN FIRST_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_COMPACT_COMPACT_ALT]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"{x | x IN s /\ (f:real^M->real^N) x = y}")) THEN
      ASM_REWRITE_TAC [SUBSET_RESTRICT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"?v. open_in (subtopology euclidean (IMAGE f s)) v /\
            y IN v /\
            {x | x IN s /\ (f:real^M->real^N) x IN v} SUBSET u")
      MP_TAC THENL
       [GEN_REWRITE_TAC (BINDER_CONV o RAND_CONV o LAND_CONV)
         [← GSYM SING_SUBSET] THEN
        MATCH_MP_TAC CLOSED_MAP_OPEN_SUPERSET_PREIMAGE THEN
        ASM_REWRITE_TAC [SING_SUBSET, IN_SING],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"closure v SUBSET IMAGE (f:real^M->real^N) (closure u)")
        ASSUME_TAC THENL
         [TRANS_TAC SUBSET_TRANS (← q r"closure(IMAGE (f:real^M->real^N) u)") THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC SUBSET_CLOSURE THEN
            REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
            ASM SET_TAC [],
            MATCH_MP_TAC CLOSURE_MINIMAL THEN
            SIMP_TAC [CLOSURE_SUBSET, IMAGE_SUBSET] THEN
            MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
            MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
            ASM_MESON_TAC [CONTINUOUS_ON_SUBSET]],
          CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
          REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_CLOSURE] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            BOUNDED_SUBSET)) THEN
          MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
          MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
          ASM_MESON_TAC [CONTINUOUS_ON_SUBSET]]],
      REWRITE_TAC [LOCALLY_COMPACT_ALT] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_COMPACT_ALT]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^M->real^N) x")) THEN
      ASM_SIMP_TAC [FUN_IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"closure v:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"{x | x IN s /\ (f:real^M->real^N) x IN v}") THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
        ASM_MESON_TAC [SUBSET_REFL],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"closure {x | x IN s /\ f x IN v} SUBSET
        {x | x IN s /\ (f:real^M->real^N) x IN closure v}")
      ASSUME_TAC THENL
       [MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
        MP_TAC (← ISPEC (← q r"v:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC [],
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_CLOSURE] THEN
        ASM_MESON_TAC [COMPACT_IMP_BOUNDED, BOUNDED_SUBSET]]])

  let LOCALLY_COMPACT_PROPER_IMAGE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\
        (!k. k SUBSET (IMAGE f s) /\ compact k
             ==> compact {x | x IN s /\ f x IN k}) /\
        locally compact s
        ==> locally compact (IMAGE f s)"
   (MESON_TAC [LOCALLY_COMPACT_PROPER_IMAGE_EQ])

  let LOCALLY_COMPACT_PROPER_CONTINUOUS_PREIMAGE ← prove
   r"!f:real^M->real^N s t c.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        (!k. k SUBSET t /\ compact k
             ==> compact {x | x IN s /\ f x IN k}) /\
        locally compact c /\ c SUBSET t
        ==> locally compact {x | x IN s /\ f x IN c}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LOCALLY_COMPACT] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"x:real^M") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(f:real^M->real^N) x")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"k:real^N->bool"] THEN
    STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"{x | x IN s /\ (f:real^M->real^N) x IN u}",
      ← q r"{x | x IN s /\ (f:real^M->real^N) x IN k}"] THEN
    REPLICATE_TAC 3 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"{x | x IN s /\ (f:real^M->real^N) x IN u} =
        {x | x IN {x | x IN s /\ f x IN c} /\ f x IN u}")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"c:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN SET_TAC [],
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC []])

  return { LOCALLY_COMPACT_PROPER_IMAGE_EQ, LOCALLY_COMPACT_PROPER_IMAGE,
           LOCALLY_COMPACT_PROPER_CONTINUOUS_PREIMAGE }

/- ------------------------------------------------------------------------- -/
/- Mumford's lemma; local properties equal compact ones.                     -/
/- (topology.ml 29743-29852)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MUM where
  MUMFORD_LEMMA : thm
  LOCALLY_EQ_COMPACTLY : thm
  deriving Inhabited

@[nospecialize]
def setupMUM [HolBase] (D : TopologyDeps) (BBAL : BAL) (BLOC : LOC) (BCLS1 : CLS1)
    (BLIM2 : LIM2) (BUNQ : UNQ) (BBND1 : BND1) (BCPT : CPT) (BCPP1 : CPP1) (BCSL : CSL)
    (BSQC : SQC) (BIDC : IDC) (BCLC : CLC) (BLCY1 : LCY1) (BLCY5 : LCY5) (BLCC1 : LCC1) :
    ExceptT String IO MUM := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { FORALL_AND_THM, IMP_CONJ, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, NOT_EXISTS_THM, NOT_IMP, PSUBSET, .. } :=
    D.core3
  let { REAL_ARCH_INV, REAL_LT_INV2, REAL_LT_INV_EQ, .. } := D.core4
  let { REAL_LT_TRANS, REAL_OF_NUM_ADD, REAL_OF_NUM_LT, SKOLEM_THM, SUBSET_RESTRICT,
        SUBSET_TRANS, .. } := D.core5
  let { o_ASSOC, o_THM, .. } := D.core6
  let { DIST_SYM, .. } := D.vec1
  let { OPEN_IN_INTER, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, .. } := BBAL
  let { OPEN_IN_OPEN_INTER, open_in, .. } := BLOC
  let { CLOSED_CLOSURE, CLOSURE_MINIMAL, CLOSURE_SUBSET, .. } := BCLS1
  let { LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, .. } := BLIM2
  let { LIM_UNIQUE, .. } := BUNQ
  let { BOUNDED_SUBSET, .. } := BBND1
  let { COMPACT_CLOSURE, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, compact, .. } := BCPT
  let { COMPACT_INTER_CLOSED, .. } := BCPP1
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  let { CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := BIDC
  let { CONTINUOUS_CLOSED_PREIMAGE, .. } := BCLC
  let { LOCALLY_AND_SUBSET, LOCALLY_MONO, .. } := BLCY1
  let { LOCALLY_TO_COMPACTLY, .. } := BLCY5
  let { LOCALLY_COMPACT_COMPACT, .. } := BLCC1
  -- @@SCOPE END

  let MUMFORD_LEMMA ← prove
   r"!f:real^M->real^N s t y.
        f continuous_on s /\ IMAGE f s SUBSET t /\ locally compact s /\
        y IN t /\ compact {x | x IN s /\ f x = y}
        ==> ?u v. open_in (subtopology euclidean s) u /\
                  open_in (subtopology euclidean t) v /\
                  {x | x IN s /\ f x = y} SUBSET u /\ y IN v /\
                  IMAGE f u SUBSET v /\
                  (!k. k SUBSET v /\ compact k
                       ==> compact {x | x IN u /\ f x IN k})"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"{x | x IN s /\ (f:real^M->real^N) x = y}") o
     GEN_REWRITE_RULE id [LOCALLY_COMPACT_COMPACT]) THEN
    ASM_REWRITE_TAC [SUBSET_RESTRICT, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^M->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(closure u:real^M->bool) SUBSET v") ASSUME_TAC THENL
     [MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"compact(closure u:real^M->bool)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [COMPACT_CLOSURE] THEN
      ASM_MESON_TAC [BOUNDED_SUBSET, COMPACT_IMP_BOUNDED],
      ALL_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!b. open_in (subtopology euclidean t) b /\ y IN b
          ==> u INTER {x | x IN s /\ (f:real^M->real^N) x IN b} PSUBSET
              closure u INTER {x | x IN s /\ (f:real^M->real^N) x IN b}")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [PSUBSET] THEN
      SIMP_TAC [CLOSURE_SUBSET,
                ← SET_RULE (← q r"s SUBSET t ==> s INTER u SUBSET t INTER u")] THEN
      MATCH_MP_TAC (← MESON [] (← q r"!P. ~P s /\ P t ==> ~(s = t)")) THEN
      EXISTS_TAC
       (← q r"\a. !k. k SUBSET b /\ compact k
                ==> compact {x | x IN a /\ (f:real^M->real^N) x IN k}") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
        REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_THEN (MP_TAC o SPECL
         [← q r"u INTER {x | x IN s /\ (f:real^M->real^N) x IN b}",
          ← q r"b:real^N->bool"]) THEN
        ASM_REWRITE_TAC [← TAUT (← q r"~(p /\ q) <=> p ==> ~q")] THEN ANTS_TAC THENL
         [MATCH_MP_TAC OPEN_IN_INTER THEN ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN ASM SET_TAC [],
          ASM SET_TAC []],
        X_GEN_TAC (← q r"k:real^N->bool") THEN STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"{x | x IN closure u INTER {x | x IN s /\ f x IN b} /\ f x IN k} =
          v INTER {x | x IN closure u /\ (f:real^M->real^N) x IN k}")
        SUBST1_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC COMPACT_INTER_CLOSED] THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE THEN
        ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_CLOSURE] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_TRANS]],
      DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC
       (← q r"t INTER ball(y:real^N,inv(&n + &1))")) THEN
      SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL, IN_INTER, CENTRE_IN_BALL] THEN
      ASM_REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      SIMP_TAC [CLOSURE_SUBSET, ← SET_RULE
       (← q r"u SUBSET u'
        ==> (u INTER t PSUBSET u' INTER t <=>
             ?x. x IN u' /\ ~(x IN u) /\ x IN t)")] THEN
      REWRITE_TAC [SKOLEM_THM, IN_ELIM_THM, IN_BALL, FORALL_AND_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:num->real^M") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPEC (← q r"closure u:real^M->bool") compact) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real^M")) THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"l:real^M", ← q r"r:num->num"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(f:real^M->real^N) l = y") ASSUME_TAC THENL
       [MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
        EXISTS_TAC (← q r"(f:real^M->real^N) o x o (r:num->num)") THEN
        ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN CONJ_TAC THENL
         [SUBGOAL_THEN (← q r"(f:real^M->real^N) continuous_on closure u") MP_TAC THENL
           [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_TRANS], ALL_TAC] THEN
          REWRITE_TAC [CONTINUOUS_ON_SEQUENTIALLY] THEN
          DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [o_THM],
          REWRITE_TAC [o_ASSOC] THEN MATCH_MP_TAC LIM_SUBSEQUENCE THEN
          ASM_REWRITE_TAC [LIM_SEQUENTIALLY, o_THM] THEN
          X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
          MP_TAC (← SPEC (← q r"e:real") REAL_ARCH_INV) THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
          X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN
          DISCH_TAC THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
          TRANS_TAC REAL_LT_TRANS (← q r"inv(&n + &1)") THEN ASM_REWRITE_TAC [] THEN
          TRANS_TAC REAL_LT_TRANS (← q r"inv(&N)") THEN ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC REAL_LT_INV2 THEN
          ASM_REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LT] THEN ASM_ARITH_TAC],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [open_in]) THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"l:real^M"))) THEN
        REWRITE_TAC [NOT_IMP, NOT_EXISTS_THM] THEN
        CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"e:real") THEN STRIP_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
        ASM_REWRITE_TAC [LE_REFL, o_THM] THEN ASM SET_TAC []]])

  let LOCALLY_EQ_COMPACTLY ← prove
   r"!P s:real^N->bool.
        (!t u. t SUBSET u /\ u SUBSET s /\ P u ==> P t) /\
        (!f. FINITE f /\ (!t. t IN f ==> P t /\ t SUBSET s)
             ==> P(UNIONS f)) /\
        locally compact s
        ==> (locally P s <=> !c. compact c /\ c SUBSET s ==> P c)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC LOCALLY_TO_COMPACTLY THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [],
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_AND_SUBSET]) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LOCALLY_MONO) THEN ASM_MESON_TAC []])

  return { MUMFORD_LEMMA, LOCALLY_EQ_COMPACTLY }

/- ------------------------------------------------------------------------- -/
/- Locally compact sets are closed in an open set and are homeomorphic       -/
/- to an absolutely closed set if we have one more dimension to play with.   -/
/- (topology.ml 29853-29989)                                                 -/
/- ------------------------------------------------------------------------- -/

structure LCC5 where
  LOCALLY_COMPACT_OPEN_INTER_CLOSURE : thm
  LOCALLY_COMPACT_CLOSED_IN_OPEN : thm
  LOCALLY_COMPACT_HOMEOMORPHISM_PROJECTION_CLOSED : thm
  LOCALLY_COMPACT_CLOSED_INTER_OPEN : thm
  LOCALLY_COMPACT_CLOSED_DIFF : thm
  LOCALLY_COMPACT_CLOSURE_DIFF : thm
  deriving Inhabited

@[nospecialize]
def setupLCC5 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BLPT : LPT)
    (BINT : INT) (BCLS1 : CLS1) (BCMS : CMS) (BIDC : IDC) (BCLC : CLC) (BLCP : LCP)
    (BPCR1 : PCR1) (BSMI : SMI) (BPCA1 : PCA1) (BHMA : HMA) (BIOM : IOM) (BSD2 : SD2)
    (BSD3 : SD3) (BLCC1 : LCC1) (BLCC2 : LCC2) : ExceptT String IO LCC5 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, REAL_FIELD, SET_RULE, SET_TAC, .. } := D
  let { CART_EQ, COMPL_COMPL, CONJ_ASSOC, DIMINDEX_GE_1, EQ_SYM_EQ, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ_ALT,
        INTER_COMM, INTER_UNIV, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, PASTECART_INJ,
        PASTECART_IN_PCROSS, .. } := D.core3
  let { SNDCART_PASTECART, SUBSET, SUBSET_REFL, SUBSET_UNIV, .. } := D.core5
  let { UNWIND_THM1, o_DEF, .. } := D.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { VECTOR_MUL_COMPONENT, VEC_COMPONENT, .. } := D.vec4
  let { LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF, .. } := D.met2
  let { OPEN_IN_SUBTOPOLOGY, .. } := D.met3
  let { HAUSDORFF_SPACE_EUCLIDEAN, OPEN_IN, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { CLOSED_DIFF, CLOSED_INTER, OPEN_CLOSED, .. } := BCLO
  let { CLOSED_IN_CLOSED_INTER, CLOSED_IN_CLOSED_TRANS, .. } := BLOC
  let { CLOSED_SING, .. } := BLPT
  let { INTERIOR_OPEN, .. } := BINT
  let { CLOSED_CLOSURE, CLOSURE_CLOSED, CLOSURE_COMPLEMENT, CLOSURE_EQ, CLOSURE_SUBSET,
        CLOSURE_UNION, EUCLIDEAN_CLOSURE_OF, .. } := BCLS1
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_AT_COMPOSE, CONTINUOUS_ON_ID, .. } := BIDC
  let { CONTINUOUS_CLOSED_PREIMAGE_UNIV, .. } := BCLC
  let { LINEAR_CONTINUOUS_AT, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_PCROSS, .. } := BPCR1
  let { CONTINUOUS_MUL, CONTINUOUS_ON_INV, CONTINUOUS_ON_MUL, .. } := BSMI
  let { CONTINUOUS_ON_PASTECART, .. } := BPCA1
  let { HOMEOMORPHISM, HOMEOMORPHISM_OF_SUBSETS, .. } := BHMA
  let { HOMEOMORPHISM_IMP_CLOSED_MAP, .. } := BIOM
  let { CONTINUOUS_AT_LIFT_SETDIST, CONTINUOUS_ON_LIFT_SETDIST, .. } := BSD2
  let { SETDIST_EQ_0_SING, .. } := BSD3
  let { CLOSED_IMP_LOCALLY_COMPACT, LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN,
        OPEN_IMP_LOCALLY_COMPACT, .. } := BLCC1
  let { LOCALLY_COMPACT_INTER, .. } := BLCC2
  -- @@SCOPE END

  let LOCALLY_COMPACT_OPEN_INTER_CLOSURE ← prove
   r"!s:real^N->bool. locally compact s ==> ?t. open t /\ s = t INTER closure s"
   (REWRITE_TAC [← GSYM LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN] THEN
    GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
    (← REWRITE_RULE [CONJ_ASSOC] LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF))) THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV, HAUSDORFF_SPACE_EUCLIDEAN] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, ← GSYM OPEN_IN, EUCLIDEAN_CLOSURE_OF])

  let LOCALLY_COMPACT_CLOSED_IN_OPEN ← prove
   r"!s:real^N->bool.
    locally compact s ==> ?t. open t /\ closed_in (subtopology euclidean t) s"
   (GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP LOCALLY_COMPACT_OPEN_INTER_CLOSURE) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM SUBST1_TAC THEN
    SIMP_TAC [CLOSED_IN_CLOSED_INTER, CLOSED_CLOSURE])

  let LOCALLY_COMPACT_HOMEOMORPHISM_PROJECTION_CLOSED ← prove
   r"!s:real^M->bool.
        locally compact s
        ==> ?t:real^(M,N)finite_sum->bool f.
                closed t /\ homeomorphism (s,t) (f,fstcart)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"closed(s:real^M->bool)") THENL
     [EXISTS_TAC (← q r"(s:real^M->bool) PCROSS {vec 0:real^N}") THEN
      EXISTS_TAC (← q r"\x. (pastecart x (vec 0):real^(M,N)finite_sum)") THEN
      ASM_SIMP_TAC [CLOSED_PCROSS, CLOSED_SING, HOMEOMORPHISM] THEN
      SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        LINEAR_FSTCART, LINEAR_CONTINUOUS_ON, SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FORALL_IN_PCROSS, PASTECART_IN_PCROSS, IN_SING] THEN
      SIMP_TAC [FSTCART_PASTECART],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP LOCALLY_COMPACT_OPEN_INTER_CLOSURE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") (STRIP_ASSUME_TAC o GSYM)) THEN
    DISJ_CASES_TAC (← SET_RULE (← q r"t = (:real^M) \/ ~((:real^M) DIFF t = {})")) THENL
     [ASM_MESON_TAC [CLOSURE_EQ, INTER_UNIV], ALL_TAC] THEN
    ABBREV_TAC
     (← q r"f:real^M->real^(M,N)finite_sum =
        \x. pastecart x (inv(setdist({x},(:real^M) DIFF t)) % vec 1)") THEN
    SUBGOAL_THEN
     (← q r"homeomorphism (t,IMAGE (f:real^M->real^(M,N)finite_sum) t) (f,fstcart)")
    ASSUME_TAC THENL
     [SIMP_TAC [HOMEOMORPHISM, SUBSET_REFL, LINEAR_CONTINUOUS_ON,
                LINEAR_FSTCART, FORALL_IN_IMAGE] THEN
      MATCH_MP_TAC (← TAUT (← q r"(r ==> q /\ s) /\ r /\ p ==> p /\ q /\ r /\ s")) THEN
      CONJ_TAC THENL [SET_TAC [], EXPAND_TAC "f"] THEN
      SIMP_TAC [FSTCART_PASTECART] THEN MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
      REWRITE_TAC [CONTINUOUS_ON_ID] THEN MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      REWRITE_TAC [o_DEF, CONTINUOUS_ON_CONST] THEN
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
      REWRITE_TAC [SETDIST_EQ_0_SING, CONTINUOUS_ON_LIFT_SETDIST] THEN
      ASM_SIMP_TAC [CLOSURE_COMPLEMENT, IN_DIFF, IN_UNIV, INTERIOR_OPEN],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^(M,N)finite_sum) s") THEN
    EXISTS_TAC (← q r"f:real^M->real^(M,N)finite_sum") THEN CONJ_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_CLOSED_TRANS THEN
      EXISTS_TAC (← q r"IMAGE (f:real^M->real^(M,N)finite_sum) t") THEN CONJ_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHISM_IMP_CLOSED_MAP THEN MAP_EVERY EXISTS_TAC
         [← q r"fstcart:real^(M,N)finite_sum->real^M", ← q r"t:real^M->bool"] THEN
        ASM_REWRITE_TAC [] THEN EXPAND_TAC "s" THEN
        SIMP_TAC [CLOSED_IN_CLOSED_INTER, CLOSED_CLOSURE],
        SUBGOAL_THEN
         (← q r"IMAGE (f:real^M->real^(M,N)finite_sum) t =
          {z | (setdist({fstcart z},(:real^M) DIFF t) % sndcart z) IN {vec 1}}")
        SUBST1_TAC THENL
         [EXPAND_TAC "f" THEN
          REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_ELIM_THM, PASTECART_INJ,
                       FSTCART_PASTECART, SNDCART_PASTECART, IN_IMAGE, IN_INTER,
                       ← GSYM CONJ_ASSOC, UNWIND_THM1, IN_SING] THEN
          REWRITE_TAC [CART_EQ, VECTOR_MUL_COMPONENT, VEC_COMPONENT] THEN
          MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^N"] THEN
          MP_TAC (← ISPECL [← q r"(:real^M) DIFF t", ← q r"x:real^M"]
            (← CONJUNCT1 SETDIST_EQ_0_SING)) THEN
          ASM_SIMP_TAC [CLOSURE_COMPLEMENT, IN_DIFF, IN_UNIV, INTERIOR_OPEN] THEN
          ASM_CASES_TAC (← q r"(x:real^M) IN t") THEN ASM_SIMP_TAC [← REAL_FIELD
           (← q r"~(x = &0) ==> (y = inv x * &1 <=> x * y = &1)")] THEN
          DISCH_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"1")) THEN
          REWRITE_TAC [LE_REFL, DIMINDEX_GE_1] THEN REAL_ARITH_TAC,
          MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
          REWRITE_TAC [CLOSED_SING] THEN X_GEN_TAC (← q r"z:real^(M,N)finite_sum") THEN
          MATCH_MP_TAC CONTINUOUS_MUL THEN
          SIMP_TAC [LINEAR_CONTINUOUS_AT, LINEAR_SNDCART, o_DEF] THEN
          SUBGOAL_THEN
           (← q r"(\z:real^(M,N)finite_sum.
               lift(setdist({fstcart z},(:real^M) DIFF t))) =
            (\x. lift (setdist ({x},(:real^M) DIFF t))) o fstcart")
          SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
          MATCH_MP_TAC CONTINUOUS_AT_COMPOSE THEN
          SIMP_TAC [LINEAR_CONTINUOUS_AT, LINEAR_FSTCART] THEN
          REWRITE_TAC [CONTINUOUS_AT_LIFT_SETDIST]]],
      MATCH_MP_TAC HOMEOMORPHISM_OF_SUBSETS THEN MAP_EVERY EXISTS_TAC
       [← q r"t:real^M->bool", ← q r"IMAGE (f:real^M->real^(M,N)finite_sum) t"] THEN
      ASM SET_TAC []])

  let LOCALLY_COMPACT_CLOSED_INTER_OPEN ← prove
   r"!s:real^N->bool.
        locally compact s <=> ?t u. closed t /\ open u /\ s = t INTER u"
   (MESON_TAC [CLOSED_IMP_LOCALLY_COMPACT, OPEN_IMP_LOCALLY_COMPACT,
               LOCALLY_COMPACT_INTER, INTER_COMM, CLOSED_CLOSURE,
               LOCALLY_COMPACT_OPEN_INTER_CLOSURE])

  let LOCALLY_COMPACT_CLOSED_DIFF ← prove
   r"!s:real^N->bool.
        locally compact s <=> ?t u. closed t /\ closed u /\ t DIFF u = s"
   (GEN_TAC THEN REWRITE_TAC [LOCALLY_COMPACT_CLOSED_INTER_OPEN] THEN
    MATCH_MP_TAC (← MESON [COMPL_COMPL]
      (← q r"(!t u. P t u <=> Q t (UNIV DIFF u))
       ==> ((?t u. P t u) <=> (?t u. Q t u))")) THEN
    REWRITE_TAC [← GSYM OPEN_CLOSED, ← SET_RULE
      (← q r"t DIFF (UNIV DIFF s) = t INTER s")] THEN
    REWRITE_TAC [EQ_SYM_EQ])

  let LOCALLY_COMPACT_CLOSURE_DIFF ← prove
   r"!s:real^N->bool. locally compact s <=> closed(closure s DIFF s)"
   (GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [LOCALLY_COMPACT_CLOSED_INTER_OPEN, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"c:real^N->bool", ← q r"u:real^N->bool"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"closure(c INTER u) DIFF (c INTER u):real^N->bool =
        closure(c INTER u) INTER (c DIFF u)")
       (fun t => ASM_SIMP_TAC [CLOSED_CLOSURE, CLOSED_DIFF, CLOSED_INTER, t]) THEN
      MP_TAC (← SET_RULE (← q r"c:real^N->bool = (c INTER u) UNION (c DIFF u)")) THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"closure:(real^N->bool)->real^N->bool")) THEN
      ASM_SIMP_TAC [CLOSURE_UNION, CLOSURE_CLOSED, CLOSED_DIFF] THEN SET_TAC [],
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"s:real^N->bool = closure s DIFF (closure(s) DIFF s)")
      SUBST1_TAC THENL
       [MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN SET_TAC [],
        REWRITE_TAC [LOCALLY_COMPACT_CLOSED_DIFF] THEN
        ASM_MESON_TAC [CLOSED_CLOSURE]]])

  return { LOCALLY_COMPACT_OPEN_INTER_CLOSURE, LOCALLY_COMPACT_CLOSED_IN_OPEN,
           LOCALLY_COMPACT_HOMEOMORPHISM_PROJECTION_CLOSED, LOCALLY_COMPACT_CLOSED_INTER_OPEN,
           LOCALLY_COMPACT_CLOSED_DIFF, LOCALLY_COMPACT_CLOSURE_DIFF }

/- ------------------------------------------------------------------------- -/
/- F_sigma and G_delta sets.  (topology.ml 29990-30122)                      -/
/- ------------------------------------------------------------------------- -/

structure FSG1 where
  gdelta : thm
  fsigma : thm
  FSIGMA_IN_EUCLIDEAN : thm
  GDELTA_IN_EUCLIDEAN : thm
  FSIGMA_UNIONS_COMPACT : thm
  GDELTA_COMPLEMENT : thm
  FSIGMA_ASCENDING : thm
  FSIGMA_COMPLEMENT : thm
  GDELTA_DESCENDING : thm
  GDELTA_TRANSLATION : thm
  FSIGMA_TRANSLATION : thm
  GDELTA_LINEAR_IMAGE : thm
  FSIGMA_LINEAR_IMAGE : thm
  FSIGMA_LOCALLY_COMPACT : thm
  OPEN_IMP_FSIGMA : thm
  CLOSED_IMP_FSIGMA : thm
  CLOSED_IMP_GDELTA : thm
  FSIGMA_SING : thm
  GDELTA_SING : thm
  OPEN_IMP_GDELTA : thm
  GDELTA_EMPTY : thm
  FSIGMA_EMPTY : thm
  GDELTA_UNIV : thm
  FSIGMA_UNIV : thm
  deriving Inhabited

@[nospecialize]
def setupFSG1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLPT : LPT) (BCPT : CPT)
    (BCPP1 : CPP1) (BLCC1 : LCC1) (BLCC2 : LCC2) : ExceptT String IO FSG1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_TAC, add_linear_invariants,
        add_translation_invariants, GEOM_TRANSFORM_TAC, GEOM_TRANSLATE_TAC, .. } := D
  let { ADD1, COMPL_COMPL, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, INTERSECTION_OF, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { SIMPLE_IMAGE, SKOLEM_THM, SUBSET_UNIV, .. } := D.core5
  let { UNION_OF, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_UNIONS, COUNTABLE_UNION_OF_ASCENDING, .. } := D.lib1
  let { RELATIVE_TO_UNIV, .. } := D.misc
  let { FSIGMA_IN_GDELTA_IN, GDELTA_IN_DESCENDING, .. } := D.met2
  let { OPEN_IMP_GDELTA_IN, fsigma_in, gdelta_in, .. } := D.met3
  let { OPEN_EMPTY, OPEN_IN, OPEN_IN_EUCLIDEAN, OPEN_UNIV, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { CLOSED_EMPTY, CLOSED_IN_EUCLIDEAN, CLOSED_UNIV, closed, .. } := BCLO
  let { CLOSED_SING, .. } := BLPT
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { COMPACT_EMPTY, COMPACT_UNION, .. } := BCPP1
  let { CLOSED_IMP_LOCALLY_COMPACT, OPEN_IMP_LOCALLY_COMPACT, .. } := BLCC1
  let { SIGMA_COMPACT, .. } := BLCC2
  -- @@SCOPE END

  let gdelta ← new_definition
   r"gdelta(s:real^N->bool) <=> (COUNTABLE INTERSECTION_OF open) s"

  let fsigma ← new_definition
   r"fsigma (s:real^N->bool) <=> (COUNTABLE UNION_OF closed) s"

  let FSIGMA_IN_EUCLIDEAN ← prove
   r"fsigma_in euclidean = fsigma"
   (REWRITE_TAC [FUN_EQ_THM, fsigma_in, fsigma, CLOSED_IN_EUCLIDEAN])

  let GDELTA_IN_EUCLIDEAN ← prove
   r"gdelta_in euclidean = gdelta"
   (REWRITE_TAC [FUN_EQ_THM, gdelta_in, gdelta, OPEN_IN_EUCLIDEAN,
                 TOPSPACE_EUCLIDEAN, RELATIVE_TO_UNIV])

  let FSIGMA_UNIONS_COMPACT ← prove
   r"!s:real^N->bool. fsigma s <=> (COUNTABLE UNION_OF compact) s"
   (GEN_TAC THEN REWRITE_TAC [fsigma, UNION_OF] THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC [COMPACT_IMP_CLOSED]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!c:real^N->bool. ?g.
          c IN u
          ==> COUNTABLE g /\ (!t. t IN g ==> compact t) /\ UNIONS g = c")
    MP_TAC THENL
     [ASM_MESON_TAC [SIGMA_COMPACT, CLOSED_IMP_LOCALLY_COMPACT], ALL_TAC] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:(real^N->bool)->(real^N->bool)->bool") THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"UNIONS {(f:(real^N->bool)->(real^N->bool)->bool) c | c IN u}") THEN
    REWRITE_TAC [SIMPLE_IMAGE] THEN CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_UNIONS THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE],
      ASM SET_TAC []])

  let GDELTA_COMPLEMENT ← prove
   r"!s. gdelta((:real^N) DIFF s) <=> fsigma s"
   (REWRITE_TAC [← GSYM FSIGMA_IN_EUCLIDEAN, FSIGMA_IN_GDELTA_IN] THEN
    REWRITE_TAC [GDELTA_IN_EUCLIDEAN, TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let FSIGMA_ASCENDING ← prove
   r"!s:real^N->bool.
        fsigma s <=>
        ?c. (!n. compact(c n)) /\ (!n. c n SUBSET c(SUC n)) /\
            UNIONS {c n | n IN (:num)} = s"
   (REWRITE_TAC [FSIGMA_UNIONS_COMPACT] THEN
    SIMP_TAC [COUNTABLE_UNION_OF_ASCENDING, COMPACT_EMPTY, COMPACT_UNION])

  let FSIGMA_COMPLEMENT ← prove
   r"!s. fsigma((:real^N) DIFF s) <=> gdelta s"
   (ONCE_REWRITE_TAC [← GSYM GDELTA_COMPLEMENT] THEN
    REWRITE_TAC [COMPL_COMPL])

  let GDELTA_DESCENDING ← prove
   r"!s:real^N->bool.
        gdelta s <=>
        ?u. (!n. open(u n)) /\ (!n. u(SUC n) SUBSET u n) /\
            INTERS {u n | n IN (:num)} = s"
   (REWRITE_TAC [← GSYM GDELTA_IN_EUCLIDEAN, GDELTA_IN_DESCENDING] THEN
    REWRITE_TAC [← GSYM OPEN_IN, ADD1])

  let GDELTA_TRANSLATION ← prove
   r"!a:real^N s. gdelta (IMAGE (\x. a + x) s) <=> gdelta s"
   (REWRITE_TAC [gdelta, INTERSECTION_OF] THEN GEOM_TRANSLATE_TAC [])

  let FSIGMA_TRANSLATION ← prove
   r"!a:real^N s. fsigma (IMAGE (\x. a + x) s) <=> fsigma s"
   (REWRITE_TAC [fsigma, UNION_OF] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [GDELTA_TRANSLATION, FSIGMA_TRANSLATION]

  let GDELTA_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (gdelta(IMAGE f s) <=> gdelta s)"
   (REWRITE_TAC [gdelta, INTERSECTION_OF] THEN GEOM_TRANSFORM_TAC [])

  let FSIGMA_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (fsigma(IMAGE f s) <=> fsigma s)"
   (REWRITE_TAC [fsigma, UNION_OF] THEN GEOM_TRANSFORM_TAC [])

  add_linear_invariants [GDELTA_LINEAR_IMAGE, FSIGMA_LINEAR_IMAGE]

  let FSIGMA_LOCALLY_COMPACT ← prove
   r"!s:real^N->bool. locally compact s ==> fsigma s"
   (MESON_TAC [fsigma, UNION_OF, SIGMA_COMPACT, COMPACT_IMP_CLOSED])

  let OPEN_IMP_FSIGMA ← prove
   r"!s:real^N->bool. open s ==> fsigma s"
   (MESON_TAC [OPEN_IMP_LOCALLY_COMPACT, FSIGMA_LOCALLY_COMPACT])

  let CLOSED_IMP_FSIGMA ← prove
   r"!s:real^N->bool. closed s ==> fsigma s"
   (MESON_TAC [CLOSED_IMP_LOCALLY_COMPACT, FSIGMA_LOCALLY_COMPACT])

  let CLOSED_IMP_GDELTA ← prove
   r"!s:real^N->bool. closed s ==> gdelta s"
   (REWRITE_TAC [closed, ← GSYM FSIGMA_COMPLEMENT, OPEN_IMP_FSIGMA])

  let FSIGMA_SING ← prove
   r"!x:real^N. fsigma {x}"
   (SIMP_TAC [CLOSED_IMP_FSIGMA, CLOSED_SING])

  let GDELTA_SING ← prove
   r"!x:real^N. gdelta {x}"
   (SIMP_TAC [CLOSED_IMP_GDELTA, CLOSED_SING])

  let OPEN_IMP_GDELTA ← prove
   r"!s:real^N->bool. open s ==> gdelta s"
   (REWRITE_TAC [← GSYM OPEN_IN_EUCLIDEAN, ← GSYM GDELTA_IN_EUCLIDEAN] THEN
    REWRITE_TAC [OPEN_IMP_GDELTA_IN])

  let GDELTA_EMPTY ← prove
   r"gdelta {}"
   (SIMP_TAC [OPEN_IMP_GDELTA, OPEN_EMPTY])

  let FSIGMA_EMPTY ← prove
   r"fsigma {}"
   (SIMP_TAC [CLOSED_IMP_FSIGMA, CLOSED_EMPTY])

  let GDELTA_UNIV ← prove
   r"gdelta (:real^N)"
   (SIMP_TAC [OPEN_IMP_GDELTA, OPEN_UNIV])

  let FSIGMA_UNIV ← prove
   r"fsigma (:real^N)"
   (SIMP_TAC [CLOSED_IMP_FSIGMA, CLOSED_UNIV])

  return { gdelta, fsigma, FSIGMA_IN_EUCLIDEAN, GDELTA_IN_EUCLIDEAN, FSIGMA_UNIONS_COMPACT,
           GDELTA_COMPLEMENT, FSIGMA_ASCENDING, FSIGMA_COMPLEMENT, GDELTA_DESCENDING,
           GDELTA_TRANSLATION, FSIGMA_TRANSLATION, GDELTA_LINEAR_IMAGE, FSIGMA_LINEAR_IMAGE,
           FSIGMA_LOCALLY_COMPACT, OPEN_IMP_FSIGMA, CLOSED_IMP_FSIGMA, CLOSED_IMP_GDELTA,
           FSIGMA_SING, GDELTA_SING, OPEN_IMP_GDELTA, GDELTA_EMPTY, FSIGMA_EMPTY, GDELTA_UNIV,
           FSIGMA_UNIV }

/- ------------------------------------------------------------------------- -/
/- Closure properties of F_sigma and G_delta sets.  (topology.ml 30123-30217) -/
/- ------------------------------------------------------------------------- -/

structure FSG2 where
  GDELTA_INTERS : thm
  GDELTA_INTER : thm
  GDELTA_DIFF : thm
  FSIGMA_UNIONS : thm
  COUNTABLE_IMP_FSIGMA : thm
  FSIGMA_UNION : thm
  GDELTA_UNION : thm
  FSIGMA_INTER : thm
  FSIGMA_DIFF : thm
  GDELTA_UNIONS : thm
  FSIGMA_INTERS : thm
  OPEN_IN_FSIGMA : thm
  CLOSED_IN_FSIGMA : thm
  OPEN_IN_GDELTA : thm
  CLOSED_IN_GDELTA : thm
  GDELTA_LOCALLY_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupFSG2 [HolBase] (D : TopologyDeps) (BLOC : LOC) (BCLS1 : CLS1) (BLCC5 : LCC5)
    (BFSG1 : FSG1) : ExceptT String IO FSG2 := do
  -- @@SCOPE BEGIN
  let { SET_RULE, SET_TAC, .. } := D
  let { FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMP_CONJ, INTERS_0, INTERS_INSERT, .. } := D.core2
  let { SIMPLE_IMAGE, .. } := D.core5
  let { UNIONS_0, UNIONS_GSPEC, UNIONS_INSERT, .. } := D.core6
  let { COUNTABLE_IMAGE, .. } := D.lib1
  let { FSIGMA_IN_INTER, FSIGMA_IN_UNION, FSIGMA_IN_UNIONS, GDELTA_IN_INTER, GDELTA_IN_INTERS,
        GDELTA_IN_UNION, .. } := D.met2
  let { CLOSED_IN_CLOSED, OPEN_IN_OPEN, .. } := BLOC
  let { CLOSED_CLOSURE, .. } := BCLS1
  let { LOCALLY_COMPACT_OPEN_INTER_CLOSURE, .. } := BLCC5
  let { CLOSED_IMP_FSIGMA, CLOSED_IMP_GDELTA, FSIGMA_COMPLEMENT, FSIGMA_IN_EUCLIDEAN,
        FSIGMA_SING, FSIGMA_UNIV, GDELTA_COMPLEMENT, GDELTA_EMPTY, GDELTA_IN_EUCLIDEAN,
        GDELTA_UNIV, OPEN_IMP_FSIGMA, OPEN_IMP_GDELTA, .. } := BFSG1
  -- @@SCOPE END

  let GDELTA_INTERS ← prove
   r"!g:(real^N->bool)->bool.
        COUNTABLE g /\ (!u. u IN g ==> gdelta u) ==> gdelta(INTERS g)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"g:(real^N->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [INTERS_0, GDELTA_UNIV] THEN
    ASM_SIMP_TAC [← GSYM GDELTA_IN_EUCLIDEAN, GDELTA_IN_INTERS])

  let GDELTA_INTER ← prove
   r"!s t:real^N->bool. gdelta s /\ gdelta t ==> gdelta(s INTER t)"
   (REWRITE_TAC [← GSYM GDELTA_IN_EUCLIDEAN, GDELTA_IN_INTER])

  let GDELTA_DIFF ← prove
   r"!s t:real^N->bool. gdelta s /\ fsigma t ==> gdelta(s DIFF t)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
    SIMP_TAC [GDELTA_INTER, GDELTA_COMPLEMENT])

  let FSIGMA_UNIONS ← prove
   r"!g:(real^N->bool)->bool.
        COUNTABLE g /\ (!u. u IN g ==> fsigma u) ==> fsigma(UNIONS g)"
   (REWRITE_TAC [← GSYM FSIGMA_IN_EUCLIDEAN, FSIGMA_IN_UNIONS])

  let COUNTABLE_IMP_FSIGMA ← prove
   r"!s:real^N->bool. COUNTABLE s ==> fsigma s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s = UNIONS {{x:real^N} | x IN s}") SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [], MATCH_MP_TAC FSIGMA_UNIONS] THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [FSIGMA_SING])

  let FSIGMA_UNION ← prove
   r"!s t:real^N->bool. fsigma s /\ fsigma t ==> fsigma(s UNION t)"
   (REWRITE_TAC [← GSYM FSIGMA_IN_EUCLIDEAN, FSIGMA_IN_UNION])

  let GDELTA_UNION ← prove
   r"!s t:real^N->bool. gdelta s /\ gdelta t ==> gdelta(s UNION t)"
   (REWRITE_TAC [← GSYM GDELTA_IN_EUCLIDEAN, GDELTA_IN_UNION])

  let FSIGMA_INTER ← prove
   r"!s t:real^N->bool. fsigma s /\ fsigma t ==> fsigma(s INTER t)"
   (REWRITE_TAC [← GSYM FSIGMA_IN_EUCLIDEAN, FSIGMA_IN_INTER])

  let FSIGMA_DIFF ← prove
   r"!s t:real^N->bool. fsigma s /\ gdelta t ==> fsigma(s DIFF t)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
    SIMP_TAC [FSIGMA_INTER, FSIGMA_COMPLEMENT])

  let GDELTA_UNIONS ← prove
   r"!g:(real^N->bool)->bool.
        FINITE g /\ (!u. u IN g ==> gdelta u) ==> gdelta(UNIONS g)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, GDELTA_EMPTY] THEN
    SIMP_TAC [UNIONS_INSERT, FORALL_IN_INSERT, GDELTA_UNION])

  let FSIGMA_INTERS ← prove
   r"!g:(real^N->bool)->bool.
        FINITE g /\ (!u. u IN g ==> fsigma u) ==> fsigma(INTERS g)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [INTERS_0, FSIGMA_UNIV] THEN
    SIMP_TAC [INTERS_INSERT, FORALL_IN_INSERT, FSIGMA_INTER])

  let OPEN_IN_FSIGMA ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean t) s /\ fsigma t ==> fsigma s"
   (REWRITE_TAC [OPEN_IN_OPEN] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC FSIGMA_INTER THEN
    ASM_SIMP_TAC [OPEN_IMP_FSIGMA])

  let CLOSED_IN_FSIGMA ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean t) s /\ fsigma t ==> fsigma s"
   (REWRITE_TAC [CLOSED_IN_CLOSED] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC FSIGMA_INTER THEN
    ASM_SIMP_TAC [CLOSED_IMP_FSIGMA])

  let OPEN_IN_GDELTA ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean t) s /\ gdelta t ==> gdelta s"
   (REWRITE_TAC [OPEN_IN_OPEN] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC GDELTA_INTER THEN
    ASM_SIMP_TAC [OPEN_IMP_GDELTA])

  let CLOSED_IN_GDELTA ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean t) s /\ gdelta t ==> gdelta s"
   (REWRITE_TAC [CLOSED_IN_CLOSED] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC GDELTA_INTER THEN
    ASM_SIMP_TAC [CLOSED_IMP_GDELTA])

  let GDELTA_LOCALLY_COMPACT ← prove
   r"!s:real^N->bool. locally compact s ==> gdelta s"
   (GEN_TAC THEN DISCH_THEN (STRIP_ASSUME_TAC o MATCH_MP
      LOCALLY_COMPACT_OPEN_INTER_CLOSURE) THEN
    ONCE_ASM_REWRITE_TAC [] THEN MATCH_MP_TAC GDELTA_INTER THEN
    ASM_SIMP_TAC [OPEN_IMP_GDELTA, CLOSED_IMP_GDELTA, CLOSED_CLOSURE])

  return { GDELTA_INTERS, GDELTA_INTER, GDELTA_DIFF, FSIGMA_UNIONS, COUNTABLE_IMP_FSIGMA,
           FSIGMA_UNION, GDELTA_UNION, FSIGMA_INTER, FSIGMA_DIFF, GDELTA_UNIONS, FSIGMA_INTERS,
           OPEN_IN_FSIGMA, CLOSED_IN_FSIGMA, OPEN_IN_GDELTA, CLOSED_IN_GDELTA,
           GDELTA_LOCALLY_COMPACT }

/- ------------------------------------------------------------------------- -/
/- F_sigma and G_delta sets under images and preimages.                      -/
/- (topology.ml 30218-30338)                                                 -/
/- ------------------------------------------------------------------------- -/

structure FSG3 where
  FSIGMA_CONTINUOUS_IMAGE : thm
  HOMEOMORPHIC_FSIGMANESS : thm
  HOMEOMORPHISM_FSIGMANESS : thm
  FSIGMA_FSIGMA_PROJECTION : thm
  CONTINUOUS_FSIGMA_PREIMAGE : thm
  CONTINUOUS_GDELTA_PREIMAGE : thm
  FSIGMA_PROPER_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupFSG3 [HolBase] (D : TopologyDeps) (BLOC : LOC) (BCPT : CPT) (BCSL : CSL) (BCLC : CLC)
    (BLCP : LCP) (BHMA : HMA) (BFSG1 : FSG1) (BFSG2 : FSG2) : ExceptT String IO FSG3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FSTCART_PASTECART, IMAGE_UNIONS, IMP_CONJ,
        INTERSECTION_OF, INTERS_0, IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, PASTECART_IN_PCROSS, .. } := D.core3
  let { RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SNDCART_PASTECART, SUBSET, .. } := D.core5
  let { UNIONS_IMAGE, UNION_OF, .. } := D.core6
  let { COUNTABLE_IMAGE, .. } := D.lib1
  let { LINEAR_SNDCART, .. } := D.vec2
  let { CLOSED_IN_CLOSED, OPEN_IN_OPEN, .. } := BLOC
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_OPEN_IN_PREIMAGE, .. } := BCLC
  let { COMPACT_CONTINUOUS_IMAGE, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, homeomorphic, homeomorphism, .. } := BHMA
  let { CLOSED_IMP_FSIGMA, FSIGMA_UNIONS_COMPACT, OPEN_IMP_GDELTA, fsigma, gdelta, .. } := BFSG1
  let { FSIGMA_INTER, FSIGMA_UNIONS, GDELTA_INTER, GDELTA_INTERS, .. } := BFSG2
  -- @@SCOPE END

  let FSIGMA_CONTINUOUS_IMAGE ← prove
   r"!f:real^M->real^N s. f continuous_on s /\ fsigma s ==> fsigma (IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FSIGMA_UNIONS_COMPACT]) THEN
    REWRITE_TAC [UNION_OF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^M->bool)->bool")
      (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_REWRITE_TAC [IMAGE_UNIONS] THEN
    MATCH_MP_TAC FSIGMA_UNIONS THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN DISCH_TAC THEN
    MATCH_MP_TAC CLOSED_IMP_FSIGMA THEN MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN ASM_SIMP_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_FSIGMANESS ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t ==> (fsigma s <=> fsigma t)"
   (REWRITE_TAC [homeomorphic, homeomorphism] THEN
    MESON_TAC [FSIGMA_CONTINUOUS_IMAGE])

  let HOMEOMORPHISM_FSIGMANESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (fsigma(IMAGE f k) <=> fsigma k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_FSIGMANESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let FSIGMA_FSIGMA_PROJECTION ← prove
   r"!s:real^M->bool t:real^(M,N)finite_sum->bool.
      IMAGE fstcart t SUBSET s /\ fsigma t
      ==> fsigma {y | ?x. x IN s /\ pastecart x y IN t}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{y:real^N | ?x:real^M. x IN s /\ pastecart x y IN t} =
      IMAGE sndcart t")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [EXTENSION, SUBSET, IN_IMAGE, FORALL_PASTECART,
                   EXISTS_PASTECART, FSTCART_PASTECART, PASTECART_IN_PCROSS,
                   IN_ELIM_THM, SNDCART_PASTECART] THEN
      MESON_TAC [],
      MATCH_MP_TAC FSIGMA_CONTINUOUS_IMAGE THEN
      ASM_SIMP_TAC [LINEAR_SNDCART, LINEAR_CONTINUOUS_ON]])

  let CONTINUOUS_FSIGMA_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ fsigma s /\ fsigma t
        ==> fsigma {x | x IN s /\ f x IN t}"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [fsigma]) THEN
    REWRITE_TAC [UNION_OF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(real^N->bool)->bool")
     (STRIP_ASSUME_TAC o GSYM)) THEN
    SUBGOAL_THEN
     (← q r"!t. t IN g
          ==> closed_in (subtopology euclidean s)
                        {x | x IN s /\ (f:real^M->real^N) x IN t}")
    MP_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_CLOSED_IN_PREIMAGE],
      REWRITE_TAC [CLOSED_IN_CLOSED]] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    ASM_REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:(real^N->bool)->(real^M->bool)") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ f x IN UNIONS g} =
      s INTER (UNIONS (IMAGE (u:(real^N->bool)->(real^M->bool)) g))")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC FSIGMA_INTER THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC FSIGMA_UNIONS THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, CLOSED_IMP_FSIGMA])

  let CONTINUOUS_GDELTA_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ gdelta s /\ gdelta t
        ==> gdelta {x | x IN s /\ f x IN t}"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [gdelta]) THEN
    REWRITE_TAC [INTERSECTION_OF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(real^N->bool)->bool")
     (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_CASES_TAC (← q r"g:(real^N->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [INTERS_0, IN_UNIV, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
    SUBGOAL_THEN
     (← q r"!t. t IN g
          ==> open_in (subtopology euclidean s)
                      {x | x IN s /\ (f:real^M->real^N) x IN t}")
    MP_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_OPEN_IN_PREIMAGE],
      REWRITE_TAC [OPEN_IN_OPEN]] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:(real^N->bool)->(real^M->bool)") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ f x IN INTERS g} =
      s INTER (INTERS (IMAGE (u:(real^N->bool)->(real^M->bool)) g))")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC GDELTA_INTER THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC GDELTA_INTERS THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, OPEN_IMP_GDELTA])

  let FSIGMA_PROPER_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k})
        ==> (!k. k SUBSET t /\ fsigma k ==> fsigma {x | x IN s /\ f x IN k})"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [FSIGMA_UNIONS_COMPACT, UNION_OF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    EXISTS_TAC (← q r"IMAGE (\c. {x | x IN s /\ (f:real^M->real^N) x IN c}) g") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, UNIONS_IMAGE] THEN
    CONJ_TAC THENL [REPEAT STRIP_TAC, ASM SET_TAC []] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [])

  return { FSIGMA_CONTINUOUS_IMAGE, HOMEOMORPHIC_FSIGMANESS, HOMEOMORPHISM_FSIGMANESS,
           FSIGMA_FSIGMA_PROJECTION, CONTINUOUS_FSIGMA_PREIMAGE, CONTINUOUS_GDELTA_PREIMAGE,
           FSIGMA_PROPER_PREIMAGE }

/- ------------------------------------------------------------------------- -/
/- F_sigma and G_delta products; cardinality of these classes.              -/
/- (topology.ml 30339-30451)                                                 -/
/- ------------------------------------------------------------------------- -/

structure FSG4 where
  FSIGMA_PCROSS : thm
  FSIGMA_PCROSS_EQ : thm
  GDELTA_PCROSS : thm
  GDELTA_PCROSS_EQ : thm
  CARD_EQ_GDELTA_SETS : thm
  CARD_EQ_FSIGMA_SETS : thm
  deriving Inhabited

@[nospecialize]
def setupFSG4 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCMS : CMS) (BIDC : IDC) (BLCP : LCP)
    (BPCR1 : PCR1) (BPCA1 : PCA1) (BCEO : CEO) (BFSG1 : FSG1) (BFSG2 : FSG2) (BFSG3 : FSG3) :
    ExceptT String IO FSG4 := do
  -- @@SCOPE BEGIN
  let { SET_TAC, .. } := D
  let { CONJ_SYM, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_PASTECART, IMAGE_FSTCART_PCROSS,
        IMAGE_SNDCART_PCROSS, INTERSECTION_OF, INTERS_IMAGE, INTER_PCROSS, INTER_UNIV,
        IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, PASTECART_IN_PCROSS,
        PCROSS_EMPTY, .. } := D.core3
  let { SUBSET, .. } := D.core5
  let { UNIONS_GSPEC, UNION_OF, real_INFINITE, .. } := D.core6
  let { CARD_EQ_COUNTABLE_SUBSETS_SUBREAL, CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_EQ_TRANS,
        CARD_INFINITE_CONG, CARD_LE_ANTISYM, CARD_LE_IMAGE, CARD_LE_SUBSET, CARD_LE_TRANS,
        COUNTABLE_IMAGE, COUNTABLE_PRODUCT_DEPENDENT, EQ_C_BIJECTIONS, .. } := D.lib1
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { OPEN_UNIV, .. } := BEUC
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_PCROSS, OPEN_PCROSS, .. } := BPCR1
  let { CONTINUOUS_ON_PASTECART, .. } := BPCA1
  let { CARD_EQ_CLOSED_SETS, CARD_EQ_OPEN_SETS, .. } := BCEO
  let { CLOSED_IMP_GDELTA, FSIGMA_COMPLEMENT, FSIGMA_EMPTY, GDELTA_COMPLEMENT, GDELTA_EMPTY,
        GDELTA_UNIV, fsigma, gdelta, .. } := BFSG1
  let { GDELTA_INTER, .. } := BFSG2
  let { CONTINUOUS_GDELTA_PREIMAGE, FSIGMA_CONTINUOUS_IMAGE, .. } := BFSG3
  -- @@SCOPE END

  let FSIGMA_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        fsigma s /\ fsigma t ==> fsigma(s PCROSS t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [fsigma, UNION_OF] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"f:(real^M->bool)->bool") (STRIP_ASSUME_TAC o GSYM))
     (X_CHOOSE_THEN (← q r"g:(real^N->bool)->bool") (STRIP_ASSUME_TAC o GSYM))) THEN
    EXISTS_TAC
     (← q r"{(s PCROSS t):real^(M,N)finite_sum->bool | s IN f /\ t IN g}") THEN
    ASM_SIMP_TAC [FORALL_IN_GSPEC, CLOSED_PCROSS] THEN
    ASM_SIMP_TAC [COUNTABLE_PRODUCT_DEPENDENT] THEN
    REWRITE_TAC [UNIONS_GSPEC, EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS,
                 IN_ELIM_THM] THEN
    ASM SET_TAC [])

  let FSIGMA_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        fsigma(s PCROSS t) <=> s = {} \/ t = {} \/ fsigma s /\ fsigma t"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [FSIGMA_PCROSS, PCROSS_EMPTY, FSIGMA_EMPTY] THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p /\ ~q ==> r) ==> p \/ q \/ r")) THEN STRIP_TAC THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL
       [← q r"fstcart:real^(M,N)finite_sum->real^M",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"]
       FSIGMA_CONTINUOUS_IMAGE),
      MP_TAC (← ISPECL
       [← q r"sndcart:real^(M,N)finite_sum->real^N",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"]
       FSIGMA_CONTINUOUS_IMAGE)] THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART] THEN
    ASM_REWRITE_TAC [IMAGE_FSTCART_PCROSS, IMAGE_SNDCART_PCROSS])

  let GDELTA_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        gdelta s /\ gdelta t ==> gdelta(s PCROSS t)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s PCROSS t = (s PCROSS (:real^N)) INTER ((:real^M) PCROSS t)")
    SUBST1_TAC THENL [REWRITE_TAC [INTER_PCROSS, INTER_UNIV], ALL_TAC] THEN
    MATCH_MP_TAC GDELTA_INTER THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"gdelta(s:real^M->bool)"),
      UNDISCH_TAC (← q r"gdelta(t:real^N->bool)")] THEN
    REWRITE_TAC [gdelta, INTERSECTION_OF, LEFT_IMP_EXISTS_THM] THENL
     [X_GEN_TAC (← q r"f:(real^M->bool)->bool") THEN
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      EXISTS_TAC (← q r"IMAGE (\s:real^M->bool. s PCROSS (:real^N)) f"),
      X_GEN_TAC (← q r"f:(real^N->bool)->bool") THEN
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      EXISTS_TAC (← q r"IMAGE (\s:real^N->bool. (:real^M) PCROSS s) f")] THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, OPEN_PCROSS, OPEN_UNIV] THEN
    REWRITE_TAC [INTERS_IMAGE, EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS,
                 IN_ELIM_THM, IN_UNIV] THEN
    SET_TAC [])

  let GDELTA_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        gdelta(s PCROSS t) <=> s = {} \/ t = {} \/ gdelta s /\ gdelta t"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [GDELTA_PCROSS, PCROSS_EMPTY, GDELTA_EMPTY] THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p /\ ~q ==> r) ==> p \/ q \/ r")) THEN
    REPEAT STRIP_TAC THENL
     [UNDISCH_TAC (← q r"~(t:real^N->bool = {})"),
      UNDISCH_TAC (← q r"~(s:real^M->bool = {})")] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THENL
     [X_GEN_TAC (← q r"y:real^N"), X_GEN_TAC (← q r"x:real^M")] THEN
    DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"s = {x | x IN (:real^M) /\
                             pastecart x (y:real^N) IN (s PCROSS t)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [PASTECART_IN_PCROSS] THEN ASM SET_TAC [], ALL_TAC],
      SUBGOAL_THEN (← q r"t = {y | y IN (:real^N) /\
                             pastecart (x:real^M) y IN (s PCROSS t)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [PASTECART_IN_PCROSS] THEN ASM SET_TAC [], ALL_TAC]] THEN
    MATCH_MP_TAC CONTINUOUS_GDELTA_PREIMAGE THEN
    ASM_REWRITE_TAC [GDELTA_UNIV] THEN
    MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
    REWRITE_TAC [CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST])

  let CARD_EQ_GDELTA_SETS ← prove
   r"{s:real^N->bool | gdelta s} =_c (:real)"
   (REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS
       (← q r"IMAGE INTERS
           {g | COUNTABLE g /\ g SUBSET {s:real^N->bool | open s}}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CARD_LE_SUBSET THEN
        REWRITE_TAC [SUBSET, IN_IMAGE, gdelta, INTERSECTION_OF, IN_ELIM_THM] THEN
        GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
        TRANS_TAC CARD_LE_TRANS
         (← q r"{g | COUNTABLE g /\ g SUBSET {s:real^N->bool | open s}}") THEN
        REWRITE_TAC [CARD_LE_IMAGE] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
        ONCE_REWRITE_TAC [CONJ_SYM] THEN
        MATCH_MP_TAC CARD_EQ_COUNTABLE_SUBSETS_SUBREAL THEN
        SUBGOAL_THEN (← q r"{s:real^N->bool | open s} =_c (:real)") MP_TAC THENL
         [REWRITE_TAC [CARD_EQ_OPEN_SETS], SIMP_TAC [CARD_EQ_IMP_LE]] THEN
        DISCH_THEN (SUBST1_TAC o MATCH_MP CARD_INFINITE_CONG) THEN
        REWRITE_TAC [real_INFINITE]],
      TRANS_TAC CARD_LE_TRANS (← q r"{s:real^N->bool | closed s}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
        REWRITE_TAC [CARD_EQ_CLOSED_SETS],
        MATCH_MP_TAC CARD_LE_SUBSET THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, CLOSED_IMP_GDELTA]]])

  let CARD_EQ_FSIGMA_SETS ← prove
   r"{s:real^N->bool | fsigma s} =_c (:real)"
   (TRANS_TAC CARD_EQ_TRANS (← q r"{s:real^N->bool | gdelta s}") THEN
    REWRITE_TAC [CARD_EQ_GDELTA_SETS] THEN REWRITE_TAC [EQ_C_BIJECTIONS] THEN
    REPEAT (EXISTS_TAC (← q r"\s. (:real^N) DIFF s")) THEN
    SIMP_TAC [IN_ELIM_THM, FSIGMA_COMPLEMENT, GDELTA_COMPLEMENT] THEN
    SET_TAC [])

  return { FSIGMA_PCROSS, FSIGMA_PCROSS_EQ, GDELTA_PCROSS, GDELTA_PCROSS_EQ,
           CARD_EQ_GDELTA_SETS, CARD_EQ_FSIGMA_SETS }

/- ------------------------------------------------------------------------- -/
/- Points of convergence and continuity form G_delta sets.                   -/
/- (topology.ml 30452-30545)                                                 -/
/- ------------------------------------------------------------------------- -/

structure GPC where
  GDELTA_POINTS_OF_CONVERGENCE_WITHIN : thm
  GDELTA_POINTS_OF_CONVERGENCE_AT : thm
  GDELTA_POINTS_OF_CONTINUITY_WITHIN : thm
  GDELTA_POINTS_OF_CONTINUITY : thm
  deriving Inhabited

@[nospecialize]
def setupGPC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BNET : NET) (BCMP : CMP)
    (BCNT1 : CNT1) (BFSG1 : FSG1) (BFSG2 : FSG2) : ExceptT String IO GPC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_TAC, NORM_ARITH, .. } := D
  let { EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, INTERS_GSPEC, INTER_UNIV, IN_DELETE, IN_ELIM_THM, IN_INTER, .. } :=
    D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core3
  let { REAL_LT_INV_EQ, REAL_LT_REFL, .. } := D.core4
  let { REAL_LT_TRANS, SIMPLE_IMAGE, SUBSET, .. } := D.core5
  let { UNIONS_GSPEC, .. } := D.core6
  let { COUNTABLE_IMAGE, NUM_COUNTABLE, .. } := D.lib1
  let { FORALL_POS_MONO_1, FORALL_POS_MONO_1_EQ, REAL_HALF, .. } := D.misc
  let { DIST_NZ, DIST_SYM, .. } := D.vec1
  let { dist, .. } := D.vec4
  let { OPEN_INTER, OPEN_UNIONS, .. } := BEUC
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := BBAL
  let { WITHIN_UNIV, .. } := BNET
  let { CONVERGENT_EQ_ZERO_OSCILLATION, .. } := BCMP
  let { continuous_within, .. } := BCNT1
  let { OPEN_IMP_GDELTA, .. } := BFSG1
  let { GDELTA_INTERS, .. } := BFSG2
  -- @@SCOPE END

  let GDELTA_POINTS_OF_CONVERGENCE_WITHIN ← prove
   r"!f:real^M->real^N s. gdelta {x | ?l. (f --> l) (at x within s)}"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"{a | ?l. ((f:real^M->real^N) --> l) (at a within s)} =
      INTERS {UNIONS {u | open u /\
                          ?b. !x y. x IN (s INTER u) DELETE b /\
                                    y IN (s INTER u) DELETE b
                                    ==> dist(f x,f y) < inv(&n + &1)} |
              n IN (:num)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [CONVERGENT_EQ_ZERO_OSCILLATION, EXTENSION] THEN
      REWRITE_TAC [IN_ELIM_THM, INTERS_GSPEC, UNIONS_GSPEC, IN_UNIV] THEN
      X_GEN_TAC (← q r"a:real^M") THEN EQ_TAC THEN DISCH_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(&n + &1)")) THEN
        REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN MESON_TAC [],
        MATCH_MP_TAC FORALL_POS_MONO_1 THEN
        CONJ_TAC THENL [MESON_TAC [REAL_LT_TRANS], ALL_TAC] THEN
        X_GEN_TAC (← q r"n:num") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool")
          (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC)) THEN
        FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"b:real^M") STRIP_ASSUME_TAC) THEN
        ASM_CASES_TAC (← q r"b:real^M = a") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        EXISTS_TAC (← q r"u INTER ball(a:real^M,dist(b,a))") THEN
        ASM_SIMP_TAC [OPEN_INTER, OPEN_BALL, IN_INTER, CENTRE_IN_BALL,
                      IN_DELETE, ← GSYM DIST_NZ] THEN
        REWRITE_TAC [IN_BALL] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [IN_INTER, IN_DELETE] THEN
        ASM_MESON_TAC [DIST_SYM, REAL_LT_REFL]],
      MATCH_MP_TAC GDELTA_INTERS THEN
      SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN X_GEN_TAC (← q r"n:num") THEN
      MATCH_MP_TAC OPEN_IMP_GDELTA THEN MATCH_MP_TAC OPEN_UNIONS THEN
      SET_TAC []])

  let GDELTA_POINTS_OF_CONVERGENCE_AT ← prove
   r"!f:real^M->real^N. gdelta {x | ?l. (f --> l) (at x)}"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [GDELTA_POINTS_OF_CONVERGENCE_WITHIN])

  let GDELTA_POINTS_OF_CONTINUITY_WITHIN ← prove
   r"!f:real^M->real^N s.
        ?t. gdelta t /\
            {x | x IN s /\ f continuous (at x within s)} = s INTER t"
   (REPEAT GEN_TAC THEN
    EXISTS_TAC
     (← q r"INTERS {UNIONS {u | open u /\
                          !x y. x IN s INTER u /\ y IN s INTER u
                                ==> norm((f:real^M->real^N) x - f y)
                                    < inv(&n + &1)} |
              n IN (:num)}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC GDELTA_INTERS THEN
      SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC OPEN_IMP_GDELTA THEN MATCH_MP_TAC OPEN_UNIONS THEN
      SIMP_TAC [IN_ELIM_THM],
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTER] THEN
      REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, UNIONS_GSPEC, IN_UNIV] THEN
      X_GEN_TAC (← q r"x:real^M") THEN
      ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [continuous_within] THEN
      W (MP_TAC o PART_MATCH (rand o rand) FORALL_POS_MONO_1_EQ o rand o snd) THEN
      ANTS_TAC THENL
       [MESON_TAC [REAL_LT_TRANS], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
        ASM_REWRITE_TAC [REAL_HALF] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"ball(x:real^M,d)") THEN
        ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL] THEN
        MAP_EVERY X_GEN_TAC [← q r"y:real^M", ← q r"z:real^M"] THEN
        REWRITE_TAC [IN_BALL] THEN STRIP_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
          pure (MP_TAC (← SPEC (← q r"y:real^M") th) THEN
                MP_TAC (← SPEC (← q r"z:real^M") th))) THEN
        ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REWRITE_TAC [] THEN
        CONV_TAC (fun t => NORM_ARITH t),
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [SUBSET, dist] THEN
        REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        REPEAT (FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC []) THEN
        ASM_REWRITE_TAC [IN_BALL, ← ONCE_REWRITE_RULE [DIST_SYM] dist]]])

  let GDELTA_POINTS_OF_CONTINUITY ← prove
   r"!f:real^M->real^N. gdelta {x | f continuous at x}"
   (GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(:real^M)"]
          GDELTA_POINTS_OF_CONTINUITY_WITHIN) THEN
    SIMP_TAC [WITHIN_UNIV, IN_UNIV, INTER_UNIV, LEFT_IMP_EXISTS_THM])

  return { GDELTA_POINTS_OF_CONVERGENCE_WITHIN, GDELTA_POINTS_OF_CONVERGENCE_AT,
           GDELTA_POINTS_OF_CONTINUITY_WITHIN, GDELTA_POINTS_OF_CONTINUITY }

/- ------------------------------------------------------------------------- -/
/- Lavrentiev extension theorem.  (topology.ml 30546-30716)                  -/
/- ------------------------------------------------------------------------- -/

structure LAV where
  LAVRENTIEV : thm
  LAVRENTIEV_HOMEOMORPHISM : thm
  LAVRENTIEV_HOMEOMORPHISM_SELF : thm
  HOMEOMORPHIC_GDELTANESS : thm
  HOMEOMORPHISM_GDELTANESS : thm
  deriving Inhabited

@[nospecialize]
def setupLAV [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLPT : LPT) (BCLS1 : CLS1) (BCMP : CMP)
    (BCNO : CNO) (BCSL : CSL) (BCMS : CMS) (BIDC : IDC) (BECF : ECF) (BHMA : HMA)
    (BFSG1 : FSG1) (BFSG2 : FSG2) (BFSG3 : FSG3) : ExceptT String IO LAV := do
  -- @@SCOPE BEGIN
  let { prove_recursive_functions_exist, ASM_MESON_TAC, INDUCT_TAC, MESON, SET_RULE,
        SET_TAC, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMP_CONJ, INTERS_GSPEC, IN_ELIM_THM, IN_IMAGE,
        IN_SING, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, SUBSET_INTER, SUBSET_INTERS, SUBSET_UNIV, .. } :=
    D.core5
  let { SWAP_EXISTS_THM, num_INDUCTION, num_RECURSION, o_DEF, .. } := D.core6
  let { COUNTABLE_IMAGE, NUM_COUNTABLE, .. } := D.lib1
  let { VECTOR_SUB_EQ, .. } := D.vec4
  let { COMPLETELY_METRIZABLE_SPACE_GDELTA_IN, .. } := D.met1
  let { LAVRENTIEV_EXTENSION, .. } := D.met2
  let { METRIZABLE_SPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { CLOSED_SING, .. } := BLPT
  let { EUCLIDEAN_CLOSURE_OF, .. } := BCLS1
  let { COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN, .. } := BCMP
  let { CONTINUOUS_MAP_EUCLIDEAN2, .. } := BCNO
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, .. } := BIDC
  let { FORALL_IN_INTERMEDIATE_CLOSURE, .. } := BECF
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, homeomorphic, homeomorphism, .. } := BHMA
  let { GDELTA_IN_EUCLIDEAN, GDELTA_UNIV, .. } := BFSG1
  let { GDELTA_INTER, GDELTA_INTERS, .. } := BFSG2
  let { CONTINUOUS_GDELTA_PREIMAGE, .. } := BFSG3
  -- @@SCOPE END

  let LAVRENTIEV ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\ gdelta t
        ==> ?u g. gdelta u /\ s SUBSET u /\ u SUBSET closure s /\
                  g continuous_on u /\ IMAGE g u SUBSET t /\
                  !x. x IN s ==> g x = f x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean:(real^M)topology", ← q r"s:real^M->bool",
                      ← q r"subtopology euclidean (t:real^N->bool)",
                      ← q r"f:real^M->real^N"]
          LAVRENTIEV_EXTENSION) THEN
    ASM_SIMP_TAC [METRIZABLE_SPACE_EUCLIDEAN, CONTINUOUS_MAP_EUCLIDEAN2,
                  COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN, ← GSYM CONJ_ASSOC,
                  COMPLETELY_METRIZABLE_SPACE_GDELTA_IN, TOPSPACE_EUCLIDEAN,
                  SUBSET_UNIV, GDELTA_IN_EUCLIDEAN, EUCLIDEAN_CLOSURE_OF])

  let LAVRENTIEV_HOMEOMORPHISM ← prove
   r"!f:real^M->real^N f' s s'.
        homeomorphism (s,s') (f,f')
        ==> ?u u' g g'.
                gdelta u /\ s SUBSET u /\ u SUBSET closure s /\
                gdelta u' /\ s' SUBSET u' /\ u' SUBSET closure s' /\
                (!x. x IN s ==> g x = f x) /\ (!x. x IN s' ==> g' x = f' x) /\
                homeomorphism (u,u') (g,g')"
   (REWRITE_TAC [homeomorphism] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"(:real^N)"]
          LAVRENTIEV) THEN
    ASM_REWRITE_TAC [GDELTA_UNIV, SUBSET_UNIV, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^M->bool", ← q r"g:real^M->real^N"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f':real^N->real^M", ← q r"s':real^N->bool", ← q r"(:real^M)"]
          LAVRENTIEV) THEN
    ASM_REWRITE_TAC [GDELTA_UNIV, SUBSET_UNIV, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v':real^N->bool", ← q r"g':real^N->real^M"] THEN
    STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"{x | x IN v /\ (g:real^M->real^N) x IN v'}",
      ← q r"{x | x IN v' /\ (g':real^N->real^M) x IN v}",
      ← q r"g:real^M->real^N", ← q r"g':real^N->real^M"] THEN
    REPLICATE_TAC 2
     (CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_GDELTA_PREIMAGE], ALL_TAC] THEN
      REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC])) THEN
    REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    ONCE_REWRITE_TAC [← TAUT
     (← q r"p /\ q /\ r /\ p' /\ q' /\ r' <=>
      (r /\ r') /\ (p /\ p' ==> q /\ q') /\ (p /\ p')")] THEN
    CONJ_TAC THENL
     [CONJ_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [],
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]] THEN
    CONJ_TAC THEN ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
    REWRITE_TAC [← GSYM IN_SING] THEN
    MATCH_MP_TAC FORALL_IN_INTERMEDIATE_CLOSURE THENL
     [EXISTS_TAC (← q r"s:real^M->bool"), EXISTS_TAC (← q r"s':real^N->bool")] THEN
    REWRITE_TAC [IN_SING, VECTOR_SUB_EQ, CLOSED_SING] THEN
    (CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []]) THEN
    MATCH_MP_TAC CONTINUOUS_ON_SUB THEN REWRITE_TAC [CONTINUOUS_ON_ID] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONTINUOUS_ON_SUBSET)) THEN
    ASM SET_TAC [])

  let LAVRENTIEV_HOMEOMORPHISM_SELF ← prove
   r"!f:real^N->real^N f' s.
        homeomorphism (s,s) (f,f')
        ==> ?u g g'.
                gdelta u /\ s SUBSET u /\ u SUBSET closure s /\
                (!x. x IN s ==> g x = f x /\ g' x = f' x) /\
                homeomorphism (u,u) (g,g')"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LAVRENTIEV_HOMEOMORPHISM) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") MP_TAC) THEN
    GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^N") THEN
    GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g':real^N->real^N") THEN
    STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    STRIP_ASSUME_TAC (← prove_recursive_functions_exist num_RECURSION
     (← q r"h 0 = u /\
      (!n. h(SUC n) = h n INTER IMAGE g (h n) INTER
                      {x:real^N | x IN u /\ g x IN h n})")) THEN
    EXISTS_TAC (← q r"INTERS {h n:real^N->bool | n IN (:num)}") THEN
    SUBGOAL_THEN (← q r"!n. (h:num->real^N->bool) n SUBSET u") ASSUME_TAC THENL
     [INDUCT_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [], ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC GDELTA_INTERS THEN
      SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
      MATCH_MP_TAC num_INDUCTION THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      MATCH_MP_TAC GDELTA_INTER THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC GDELTA_INTER THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN CONJ_TAC THENL
       [SUBGOAL_THEN
         (← q r"IMAGE (g:real^N->real^N) (h(n:num)) = {x | x IN v /\ g' x IN h n}")
        SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_GDELTA_PREIMAGE THEN
      ASM_REWRITE_TAC [],
      REWRITE_TAC [SUBSET_INTERS, FORALL_IN_GSPEC, IN_UNIV] THEN
      MATCH_MP_TAC num_INDUCTION THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [SUBSET_INTER] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      MATCH_MP_TAC (← SET_RULE
       (← q r"!a. a IN s /\ f a SUBSET t ==> INTERS {f x | x IN s} SUBSET t")) THEN
      EXISTS_TAC (← q r"0") THEN ASM_REWRITE_TAC [IN_UNIV],
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMEOMORPHISM_OF_SUBSETS)) THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"!a. a IN s /\ f a SUBSET t ==> INTERS {f x | x IN s} SUBSET t")) THEN
        EXISTS_TAC (← q r"0") THEN ASM SET_TAC [],
        MATCH_MP_TAC (← SET_RULE
         (← q r"!a. a IN s /\ f a SUBSET t ==> INTERS {f x | x IN s} SUBSET t")) THEN
        EXISTS_TAC (← q r"SUC 0") THEN ASM_REWRITE_TAC [] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
        MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
         [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
          REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
          GEN_TAC THEN MATCH_MP_TAC (← MESON []
           (← q r"(!n. P(SUC n) ==> Q n) ==> (!n. P n) ==> (!n. Q n)")) THEN
          ASM SET_TAC [],
          REWRITE_TAC [SUBSET, IN_IMAGE, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
          X_GEN_TAC (← q r"x:real^N") THEN
          DISCH_THEN (fun th => tactic_of do
            pure (EXISTS_TAC (← q r"(g':real^N->real^N) x") THEN CONJ_TAC THEN MP_TAC th))
          THENL
           [DISCH_THEN (MP_TAC o SPEC (← q r"SUC 0")),
            MATCH_MP_TAC (← MESON []
            (← q r"(!n. P(SUC n) ==> Q n) ==> (!n. P n) ==> (!n. Q n)"))] THEN
          ASM_REWRITE_TAC [] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC []]]])

  let HOMEOMORPHIC_GDELTANESS ← do
    let lemma ← prove
     r"!s:real^M->bool t:real^N->bool.
            s homeomorphic t ==> gdelta s ==> gdelta t"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
      STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP LAVRENTIEV_HOMEOMORPHISM) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^N->bool"] THEN
      MAP_EVERY X_GEN_TAC [← q r"f':real^M->real^N", ← q r"g':real^N->real^M"] THEN
      STRIP_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      SUBGOAL_THEN (← q r"t = {x | x IN v /\ (g':real^N->real^M) x IN s}")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_GDELTA_PREIMAGE THEN ASM_SIMP_TAC [])
    prove
     r"!s:real^M->bool t:real^N->bool.
          s homeomorphic t ==> (gdelta s <=> gdelta t)"
     (REPEAT STRIP_TAC THEN EQ_TAC THEN
      MATCH_MP_TAC lemma THEN ASM_MESON_TAC [HOMEOMORPHIC_SYM])

  let HOMEOMORPHISM_GDELTANESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (gdelta(IMAGE f k) <=> gdelta k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_GDELTANESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  return { LAVRENTIEV, LAVRENTIEV_HOMEOMORPHISM, LAVRENTIEV_HOMEOMORPHISM_SELF,
           HOMEOMORPHIC_GDELTANESS, HOMEOMORPHISM_GDELTANESS }

/- ------------------------------------------------------------------------- -/
/- Effective countability of closed or open chains.                          -/
/- (topology.ml 30717-30833)                                                 -/
/- ------------------------------------------------------------------------- -/

structure ECC1 where
  EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_UNIONS : thm
  COUNTABLE_ASCENDING_CLOPEN_IN_CHAIN : thm
  deriving Inhabited

@[nospecialize]
def setupECC1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BSEC : SEC) (BLND : LND) :
    ExceptT String IO ECC1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_UNIONS, .. } := D.core1
  let { FORALL_IN_GSPEC, IMP_CONJ, IN, IN_DIFF, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIONS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core3
  let { SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUBSET_REFL, SUBSET_TRANS, .. } := D.core5
  let { UNIONS_0, UNIONS_1, .. } := D.core6
  let { CARD_LE_COUNTABLE, CARD_LE_RELATIONAL_FULL, COUNTABLE_ASCENDING_CHAIN, COUNTABLE_SING,
        COUNTABLE_UNION, .. } := D.lib1
  let { FLD_SUBSET, TOSET_COFINAL_WOSET, fld, poset, toset, woset, .. } := D.lib2
  let { CLOSED_IN_IMP_SUBSET, .. } := D.met1
  let { OPEN_IN_DIFF, .. } := D.met3
  let { OPEN_IN_REFL, .. } := BEUC
  let { SUBSET_SECOND_COUNTABLE, .. } := BSEC
  let { LINDELOF_OPEN_IN, .. } := BLND
  -- @@SCOPE END

  let EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_UNIONS ← do
    let lemma ← prove
     r"!f v:real^N->bool.
            (!s. s IN f ==> closed_in (subtopology euclidean v) s) /\
            (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
            ==> ?f'. COUNTABLE f' /\ f' SUBSET f /\ UNIONS f' = UNIONS f"
     (REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"?s:real^N->bool. s IN f /\ !s'. s' IN f ==> s' SUBSET s")
      THENL
       [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"s:real^N->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"{s:real^N->bool}") THEN
        ASM_REWRITE_TAC [COUNTABLE_SING, SING_SUBSET, UNIONS_1] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"\(s:real^N->bool) t. s IN f /\ t IN f /\ s SUBSET t")
            TOSET_COFINAL_WOSET) THEN
      SUBGOAL_THEN
       (← q r"fld(\(s:real^N->bool) t. s IN f /\ t IN f /\ s SUBSET t) = f")
      ASSUME_TAC THENL
       [REWRITE_TAC [fld, IN_ELIM_THM] THEN ASM SET_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [toset, poset] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [IN, SUBSET_REFL, SUBSET_TRANS, SUBSET_ANTISYM],
        DISCH_THEN (X_CHOOSE_THEN (← q r"w:((real^N->bool)->(real^N->bool)->bool)")
            STRIP_ASSUME_TAC)] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP FLD_SUBSET) THEN ASM_REWRITE_TAC [] THEN
      ABBREV_TAC (← q r"f':(real^N->bool)->bool = fld w") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"f':(real^N->bool)->bool") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MP_TAC (← ISPEC (← q r"v:real^N->bool") SUBSET_SECOND_COUNTABLE) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CARD_LE_COUNTABLE)) THEN
      MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
      EXISTS_TAC (← q r"\b c:real^N->bool.
                      DISJOINT b c /\
                      !c'. c' IN f' /\ c PSUBSET c' ==> ~(DISJOINT b c')") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [ALL_TAC,
        REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(s SUBSET t \/ t SUBSET s) /\ ~(s PSUBSET t) /\ ~(t PSUBSET s)
          ==> s = t")) THEN
        ASM_MESON_TAC [SUBSET]] THEN
      X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"\c':real^N->bool. c' IN f' /\ c PSUBSET c'")
          (← liftExcept (last (CONJUNCTS (← GEN_REWRITE_RULE id [woset] th))))))) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?c':real^N->bool. c' IN f /\ ~(c' SUBSET c)")
        STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"c PSUBSET (c':real^N->bool)") ASSUME_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?c'':real^N->bool. c'' IN f' /\ c' SUBSET c''") MP_TAC THENL
         [ASM SET_TAC [], REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY]] THEN
        MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [],
        DISCH_THEN (X_CHOOSE_THEN (← q r"c':real^N->bool") STRIP_ASSUME_TAC)] THEN
      SUBGOAL_THEN (← q r"?p:real^N. p IN c' /\ ~(p IN c)") STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"open_in (subtopology euclidean v) (v DIFF c:real^N->bool)")
      (ANTE_RES_THEN MP_TAC) THENL
       [MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN ASM
        SET_TAC [],
        DISCH_THEN (X_CHOOSE_THEN (← q r"bb:(real^N->bool)->bool")
          STRIP_ASSUME_TAC)] THEN
      SUBGOAL_THEN (← q r"(p:real^N) IN v DIFF c") MP_TAC THENL
       [ASM_MESON_TAC [SUBSET, IN_DIFF, CLOSED_IN_IMP_SUBSET],
        ASM_REWRITE_TAC [IN_UNIONS]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
      STRIP_TAC THEN REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      X_GEN_TAC (← q r"d:real^N->bool") THEN STRIP_TAC THEN
      UNDISCH_THEN
       (← q r"!x y:real^N->bool. w x y ==> x IN f /\ y IN f /\ x SUBSET y")
       (MP_TAC o SPECL [← q r"c':real^N->bool", ← q r"d:real^N->bool"]) THEN
      ASM SET_TAC [])
    prove
     r"!f v:real^N->bool.
          (!s. s IN f ==> closed_in (subtopology euclidean v) s \/
                          open_in (subtopology euclidean v) s) /\
          (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
          ==> ?f'. COUNTABLE f' /\ f' SUBSET f /\ UNIONS f' = UNIONS f"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"{s:real^N->bool | s IN f /\ closed_in (subtopology euclidean v) s}",
        ← q r"v:real^N->bool"] lemma) THEN
      MP_TAC (← ISPECL
       [← q r"{s:real^N->bool | s IN f /\ open_in (subtopology euclidean v) s}",
        ← q r"v:real^N->bool"] LINDELOF_OPEN_IN) THEN
      ASM_SIMP_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"fo:(real^N->bool)->bool") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"fc:(real^N->bool)->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"fo UNION fc:(real^N->bool)->bool") THEN
      ASM_REWRITE_TAC [COUNTABLE_UNION] THEN ASM SET_TAC [])

  let COUNTABLE_ASCENDING_CLOPEN_IN_CHAIN ← prove
   r"!f v:real^N->bool.
        ~(f = {}) /\
        (!s. s IN f ==> closed_in (subtopology euclidean v) s \/
                        open_in (subtopology euclidean v) s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> ?u. (!n. u(n) IN f) /\ (!n. u(n) SUBSET u(SUC n)) /\
                UNIONS {u n | n IN (:num)} = UNIONS f"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"UNIONS f:real^N->bool = {}") THENL
     [EXISTS_TAC (← q r"(\n. {}):num->real^N->bool") THEN
      ASM_REWRITE_TAC [SUBSET_REFL, EMPTY_UNIONS, FORALL_IN_GSPEC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EMPTY_UNIONS]) THEN
      ASM_MESON_TAC [MEMBER_NOT_EMPTY],
      MP_TAC (← ISPECL [← q r"f:(real^N->bool)->bool", ← q r"v:real^N->bool"]
          EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_UNIONS) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f':(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPEC (← q r"f':(real^N->bool)->bool") COUNTABLE_ASCENDING_CHAIN) THEN
      ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [UNIONS_0, SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []])

  return { EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_UNIONS, COUNTABLE_ASCENDING_CLOPEN_IN_CHAIN }

/- ------------------------------------------------------------------------- -/
/- Effective countability of chains: intersections and absolute versions.    -/
/- (topology.ml 30834-30960)                                                 -/
/- ------------------------------------------------------------------------- -/

structure ECC2 where
  EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_INTERS : thm
  COUNTABLE_DESCENDING_CLOPEN_IN_CHAIN : thm
  EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_UNIONS : thm
  COUNTABLE_ASCENDING_CLOPEN_CHAIN : thm
  EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_INTERS : thm
  COUNTABLE_DESCENDING_CLOPEN_CHAIN : thm
  FSIGMA_UNIONS_CLOPEN_CHAIN : thm
  GDELTA_INTERS_CLOPEN_CHAIN : thm
  deriving Inhabited

@[nospecialize]
def setupECC2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BFSG1 : FSG1)
    (BFSG2 : FSG2) (BECC1 : ECC1) : ExceptT String IO ECC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DIFF_INTERS, EMPTY_UNIONS, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, IMAGE_CLAUSES, INTERS_0,
        INTERS_EQ_UNIV, INTERS_SUBSET, IN_SING, .. } := D.core2
  let { MONO_EXISTS, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_REFL, .. } := D.core5
  let { UNIONS_0, .. } := D.core6
  let { COUNTABLE_DESCENDING_CHAIN, COUNTABLE_SING, COUNTABLE_SUBSET,
        EXISTS_COUNTABLE_SUBSET_IMAGE, .. } := D.lib1
  let { CLOSED_IN_DIFF, CLOSED_IN_IMP_SUBSET, .. } := D.met1
  let { OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.met3
  let { OPEN_IN, OPEN_IN_REFL, .. } := BEUC
  let { CLOSED_IN, CLOSED_IN_REFL, .. } := BCLO
  let { CLOSED_IMP_FSIGMA, CLOSED_IMP_GDELTA, OPEN_IMP_FSIGMA, OPEN_IMP_GDELTA, .. } := BFSG1
  let { FSIGMA_UNIONS, GDELTA_INTERS, .. } := BFSG2
  let { COUNTABLE_ASCENDING_CLOPEN_IN_CHAIN, EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_UNIONS, .. } :=
    BECC1
  -- @@SCOPE END

  let EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_INTERS ← prove
   r"!f v:real^N->bool.
        (!s. s IN f ==> closed_in (subtopology euclidean v) s \/
                        open_in (subtopology euclidean v) s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> ?f'. COUNTABLE f' /\ f' SUBSET f /\ INTERS f' = INTERS f"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"f SUBSET {v:real^N->bool}") THENL
     [EXISTS_TAC (← q r"f:(real^N->bool)->bool") THEN
      ASM_MESON_TAC [COUNTABLE_SUBSET, COUNTABLE_SING, SUBSET_REFL],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"IMAGE (\s:real^N->bool. v DIFF s) f", ← q r"v:real^N->bool"]
     EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_UNIONS) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_IMAGE_2] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [← SET_RULE (← q r"s SUBSET t ==> v DIFF t SUBSET v DIFF s"),
                     OPEN_IN_REFL, CLOSED_IN_REFL, CLOSED_IN_DIFF, OPEN_IN_DIFF],
      REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:(real^N->bool)->bool") THEN
      ASM_CASES_TAC (← q r"g:(real^N->bool)->bool = {}") THENL
       [DISCH_THEN (fun th => tactic_of do
          pure (MP_TAC (← SYM (← liftExcept (last (CONJUNCTS th)))))) THEN
        ASM_REWRITE_TAC [EMPTY_UNIONS, IMAGE_CLAUSES, UNIONS_0] THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
         (← q r"(!u. u IN f ==> v DIFF u = {})
          ==> (!u. u IN f ==> u SUBSET v)
              ==> !u. u IN f ==> u = v"))) THEN
        ANTS_TAC THENL
         [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, CLOSED_IN_IMP_SUBSET],
          ASM_REWRITE_TAC [← GSYM IN_SING, ← GSYM SUBSET]],
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"!v. s SUBSET v /\ t SUBSET v /\ v DIFF s = v DIFF t ==> s = t")) THEN
      EXISTS_TAC (← q r"v:real^N->bool") THEN
      ASM_REWRITE_TAC [DIFF_INTERS, SIMPLE_IMAGE] THEN
      CONJ_TAC THEN MATCH_MP_TAC INTERS_SUBSET THEN
      (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, CLOSED_IN_IMP_SUBSET, SUBSET]]])

  let COUNTABLE_DESCENDING_CLOPEN_IN_CHAIN ← prove
   r"!f v:real^N->bool.
        ~(f = {}) /\
        (!s. s IN f ==> closed_in (subtopology euclidean v) s \/
                        open_in (subtopology euclidean v) s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> ?u. (!n. u(n) IN f) /\ (!n. u(SUC n) SUBSET u n) /\
                INTERS {u n | n IN (:num)} = INTERS f"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"INTERS f = (:real^N)") THENL
     [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INTERS_EQ_UNIV]) THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM IN_SING] THEN
      ASM_SIMP_TAC [← GSYM SUBSET, ← SET_RULE
       (← q r"~(f = {}) ==> (f SUBSET {a} <=> f = {a})")] THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"(\n. UNIV):num->real^N->bool") THEN
      REWRITE_TAC [IN_SING, SUBSET_REFL, INTERS_EQ_UNIV, FORALL_IN_GSPEC],
      MP_TAC (← ISPECL [← q r"f:(real^N->bool)->bool", ← q r"v:real^N->bool"]
        EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_INTERS) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f':(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPEC (← q r"f':(real^N->bool)->bool") COUNTABLE_DESCENDING_CHAIN) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        ASM_MESON_TAC [INTERS_0],
        MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []]])

  let EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> closed s \/ open s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> ?f'. COUNTABLE f' /\ f' SUBSET f /\ UNIONS f' = UNIONS f"
   (REWRITE_TAC [CLOSED_IN, OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_UNIONS])

  let COUNTABLE_ASCENDING_CLOPEN_CHAIN ← prove
   r"!f:(real^N->bool)->bool.
        ~(f = {}) /\
        (!s. s IN f ==> closed s \/ open s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> ?u. (!n. u(n) IN f) /\ (!n. u(n) SUBSET u(SUC n)) /\
                UNIONS {u n | n IN (:num)} = UNIONS f"
   (REWRITE_TAC [CLOSED_IN, OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [COUNTABLE_ASCENDING_CLOPEN_IN_CHAIN])

  let EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_INTERS ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> closed s \/ open s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> ?f'. COUNTABLE f' /\ f' SUBSET f /\ INTERS f' = INTERS f"
   (REWRITE_TAC [CLOSED_IN, OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_INTERS])

  let COUNTABLE_DESCENDING_CLOPEN_CHAIN ← prove
   r"!f:(real^N->bool)->bool.
        ~(f = {}) /\
        (!s. s IN f ==> closed s \/ open s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> ?u. (!n. u(n) IN f) /\ (!n. u(SUC n) SUBSET u n) /\
                INTERS {u n | n IN (:num)} = INTERS f"
   (REWRITE_TAC [CLOSED_IN, OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [COUNTABLE_DESCENDING_CLOPEN_IN_CHAIN])

  let FSIGMA_UNIONS_CLOPEN_CHAIN ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> closed s \/ open s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> fsigma(UNIONS f)"
   (GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_UNIONS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC FSIGMA_UNIONS THEN
    ASM_MESON_TAC [SUBSET, CLOSED_IMP_FSIGMA, OPEN_IMP_FSIGMA])

  let GDELTA_INTERS_CLOPEN_CHAIN ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> closed s \/ open s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> gdelta(INTERS f)"
   (GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_INTERS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC GDELTA_INTERS THEN
    ASM_MESON_TAC [SUBSET, CLOSED_IMP_GDELTA, OPEN_IMP_GDELTA])

  return { EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_INTERS, COUNTABLE_DESCENDING_CLOPEN_IN_CHAIN,
           EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_UNIONS, COUNTABLE_ASCENDING_CLOPEN_CHAIN,
           EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_INTERS, COUNTABLE_DESCENDING_CLOPEN_CHAIN,
           FSIGMA_UNIONS_CLOPEN_CHAIN, GDELTA_INTERS_CLOPEN_CHAIN }

/- ------------------------------------------------------------------------- -/
/- Cantor-Baire stationary principle.  (topology.ml 30961-31019)             -/
/- ------------------------------------------------------------------------- -/

structure CBS where
  CANTOR_BAIRE_STATIONARY_PRINCIPLE : thm
  deriving Inhabited

@[nospecialize]
def setupCBS [HolBase] (D : TopologyDeps) (BECC2 : ECC2) : ExceptT String IO CBS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ETA_AX, EXISTS_IN_GSPEC, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, FUN_EQ_THM, IMP_CONJ, IN,
        IN_ELIM_THM, .. } := D.core2
  let { MONO_EXISTS, NOT_EXISTS_THM, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_INTERS, SUBSET_TRANS, .. } := D.core5
  let { UNIONS_GSPEC, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_UNIONS, EXISTS_COUNTABLE_SUBSET_IMAGE, .. } := D.lib1
  let { INSEG_LINSEG, LINSEG_INSEG, UNION_INSEG, fld, linseg, properly, woset, .. } := D.lib2
  let { EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_INTERS, .. } := BECC2
  -- @@SCOPE END

  let CANTOR_BAIRE_STATIONARY_PRINCIPLE ← do
    let lemma ← prove
     r"{x,y | ?l. l IN p /\ l x y} = UNIONS {{x,y | l x y} | l IN p}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    prove
     r"!f:A->real^N->bool v w.
          woset w /\ ~COUNTABLE {(x,y) | w x y} /\
          (!v. v inseg w /\ ~(v = w) ==> COUNTABLE {(x,y) | v x y}) /\
          (!i. i IN fld w ==> closed_in (subtopology euclidean v) (f i) \/
                              open_in (subtopology euclidean v) (f i)) /\
          (!i j. w i j ==> f j SUBSET f i)
          ==> ?k. k IN fld w /\ !i. w k i ==> f i = f k"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"IMAGE (f:A->real^N->bool) (fld w)", ← q r"v:real^N->bool"]
            EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_INTERS) THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE_2, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
       [UNDISCH_TAC (← q r"woset(w:A->A->bool)") THEN
        REWRITE_TAC [woset, IN] THEN ASM_MESON_TAC [],
        REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL
         [← q r"w:A->A->bool", ← q r"\x y. ?l. l IN {linseg w (a:A) | a IN k} /\ l x y"]
            INSEG_LINSEG) THEN
        ASM_SIMP_TAC [] THEN MATCH_MP_TAC (← TAUT
         (← q r"p /\ ~q /\ (r ==> s) ==> (p <=> q \/ r) ==> s")) THEN
        REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC UNION_INSEG THEN
          ASM_SIMP_TAC [FORALL_IN_GSPEC, LINSEG_INSEG],
          DISCH_THEN (MP_TAC o AP_TERM
           (← q r"\l:A->A->bool. COUNTABLE {(x,y) | l x y}")) THEN
          ASM_REWRITE_TAC [] THEN REWRITE_TAC [lemma] THEN
          MATCH_MP_TAC COUNTABLE_UNIONS THEN
          ASM_SIMP_TAC [COUNTABLE_IMAGE, SIMPLE_IMAGE, FORALL_IN_IMAGE] THEN
          X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_SIMP_TAC [LINSEG_INSEG, ETA_AX] THEN REWRITE_TAC [FUN_EQ_THM] THEN
          DISCH_THEN (MP_TAC o SPECL [← q r"a:A", ← q r"a:A"]) THEN
          REWRITE_TAC [linseg, properly] THEN UNDISCH_TAC (← q r"woset(w:A->A->bool)") THEN
          REWRITE_TAC [woset] THEN ASM SET_TAC [],
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN
          MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
           [ASM SET_TAC [], DISCH_TAC] THEN
          X_GEN_TAC (← q r"b:A") THEN DISCH_TAC THEN
          ASM_SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
          FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
           (← q r"s = INTERS f ==> !x. x IN f ==> s SUBSET x"))) THEN
          REWRITE_TAC [FORALL_IN_IMAGE] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"b:A")) THEN REWRITE_TAC [fld, IN_ELIM_THM] THEN
          ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
          REWRITE_TAC [SUBSET_INTERS, FORALL_IN_IMAGE] THEN
          X_GEN_TAC (← q r"c:A") THEN DISCH_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o C AP_THM (← q r"a:A") o C AP_THM (← q r"a:A")) THEN
          REWRITE_TAC [EXISTS_IN_GSPEC] THEN
          REWRITE_TAC [linseg, IN_ELIM_THM] THEN
          REWRITE_TAC [IN, properly, NOT_EXISTS_THM] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"c:A")) THEN
          UNDISCH_TAC (← q r"woset(w:A->A->bool)") THEN
          REWRITE_TAC [woset, IN] THEN ASM_MESON_TAC [IN, SUBSET]]])

  return { CANTOR_BAIRE_STATIONARY_PRINCIPLE }

/- ------------------------------------------------------------------------- -/
/- Very basics about Borel sets.  (topology.ml 31020-31142)                  -/
/- ------------------------------------------------------------------------- -/

structure BOR1 where
  borel_RULES : thm
  borel_INDUCT : thm
  borel_CASES : thm
  BOREL_IN_EUCLIDEAN : thm
  BOREL_INDUCT_COMPACT : thm
  BOREL_INDUCT_COMPACT_DIFF : thm
  BOREL_INDUCT_COMPACT_ALT : thm
  BOREL_INDUCT_UNIONS_INTERS : thm
  BOREL_INDUCT_COMPACT_UNIONS_INTERS : thm
  BOREL_INDUCT_CLOSED_UNIONS_INTERS : thm
  deriving Inhabited

@[nospecialize]
def setupBOR1 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BCPT : CPT)
    (BCPP1 : CPP1) (BLCC1 : LCC1) (BLCC2 : LCC2) (BFSG1 : FSG1) : ExceptT String IO BOR1 := do
  -- @@SCOPE BEGIN
  let { new_inductive_definition, ASM_MESON_TAC, MESON_TAC, INTRO_TAC, .. } := D
  let { COMPL_COMPL, DIFF_UNIONS, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, IMAGE_EQ_EMPTY, INTERSECTION_OF,
        INTERS_INSERT, .. } := D.core2
  let { SIMPLE_IMAGE, .. } := D.core5
  let { UNIONS_0, UNIONS_INTERS, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_INSERT, .. } := D.lib1
  let { BOREL_IN_COMPLEMENT, BOREL_IN_UNIONS, .. } := D.met1
  let { OPEN_IMP_BOREL_IN, borel_in_INDUCT, .. } := D.met3
  let { OPEN_IN_EUCLIDEAN, OPEN_UNIV, TOPSPACE_EUCLIDEAN, .. } := BEUC
  let { OPEN_CLOSED, .. } := BCLO
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { COMPACT_EMPTY, .. } := BCPP1
  let { OPEN_IMP_LOCALLY_COMPACT, .. } := BLCC1
  let { SIGMA_COMPACT, .. } := BLCC2
  let { CLOSED_IMP_GDELTA, gdelta, .. } := BFSG1
  -- @@SCOPE END

  let (borel_RULES, borel_INDUCT, borel_CASES) ← new_inductive_definition
   r"(!s. open s ==> borel s) /\
  (!s. borel s ==> borel((:real^N) DIFF s)) /\
  (!u. COUNTABLE u /\ (!s. s IN u ==> borel s) ==> borel(UNIONS u))"

  let BOREL_IN_EUCLIDEAN ← prove
   r"borel_in euclidean = borel:(real^N->bool)->bool"
   (REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"s:real^N->bool") THEN EQ_TAC THENL
     [SPEC_TAC (← q r"s:real^N->bool", ← q r"s:real^N->bool") THEN
      MATCH_MP_TAC borel_in_INDUCT THEN REPEAT CONJ_TAC THENL
       [REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_EUCLIDEAN] THEN
        DISCH_TAC THEN MATCH_MP_TAC (← CONJUNCT1 borel_RULES) THEN
        ASM_REWRITE_TAC [],
        REPEAT GEN_TAC THEN REWRITE_TAC [TOPSPACE_EUCLIDEAN] THEN
        DISCH_TAC THEN MATCH_MP_TAC (← CONJUNCT1 (← CONJUNCT2 borel_RULES)) THEN
        ASM_REWRITE_TAC [],
        REPEAT GEN_TAC THEN STRIP_TAC THEN
        MATCH_MP_TAC (← CONJUNCT2 (← CONJUNCT2 borel_RULES)) THEN
        ASM_MESON_TAC []],
      SPEC_TAC (← q r"s:real^N->bool", ← q r"s:real^N->bool") THEN
      MATCH_MP_TAC borel_INDUCT THEN REPEAT CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN MATCH_MP_TAC OPEN_IMP_BOREL_IN THEN
        ASM_REWRITE_TAC [OPEN_IN_EUCLIDEAN],
        REPEAT STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(:real^N) DIFF s = topspace euclidean DIFF s")
        SUBST1_TAC THENL [REWRITE_TAC [TOPSPACE_EUCLIDEAN], ALL_TAC] THEN
        MATCH_MP_TAC BOREL_IN_COMPLEMENT THEN ASM_REWRITE_TAC [],
        REPEAT STRIP_TAC THEN MATCH_MP_TAC BOREL_IN_UNIONS THEN
        ASM_MESON_TAC []]])

  let BOREL_INDUCT_COMPACT ← prove
   r"!P. (!s. compact s ==> P s) /\
       (!s. P s ==> P ((:real^N) DIFF s)) /\
       (!u. COUNTABLE u /\ (!s. s IN u ==> P s) ==> P (UNIONS u))
       ==> !a. borel a ==> P a"
   (GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC borel_INDUCT THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    DISCH_THEN (MP_TAC o MATCH_MP OPEN_IMP_LOCALLY_COMPACT) THEN
    DISCH_THEN (MP_TAC o MATCH_MP SIGMA_COMPACT) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool")
      (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_SIMP_TAC [])

  let BOREL_INDUCT_COMPACT_DIFF ← prove
   r"!P. (!s. compact s ==> P s) /\
       (!s t. P s /\ P t ==> P(s DIFF t)) /\
       (!u. COUNTABLE u /\ (!s. s IN u ==> P s) ==> P (UNIONS u))
       ==> !a:real^N->bool. borel a ==> P a"
   (GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC borel_INDUCT THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [OPEN_UNIV], X_GEN_TAC (← q r"s:real^N->bool")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP OPEN_IMP_LOCALLY_COMPACT) THEN
    DISCH_THEN (MP_TAC o MATCH_MP SIGMA_COMPACT) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool")
      (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_SIMP_TAC [])

  let BOREL_INDUCT_COMPACT_ALT ← prove
   r"!P. (!s. compact s ==> P s) /\
       (!s. P s ==> P((:real^N) DIFF s)) /\
       (!u. COUNTABLE u /\ ~(u = {}) /\ (!s. s IN u ==> P s) ==> P(INTERS u))
       ==> !a:real^N->bool. borel a ==> P a"
   (GEN_TAC THEN INTRO_TAC "C D I" THEN
    MATCH_MP_TAC BOREL_INDUCT_COMPACT THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"u:(real^N->bool)->bool") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"u:(real^N->bool)->bool = {}") THEN
    ASM_SIMP_TAC [UNIONS_0, COMPACT_EMPTY] THEN
    REWRITE_TAC [UNIONS_INTERS] THEN
    USE_THEN "D" MATCH_MP_TAC THEN USE_THEN "I" MATCH_MP_TAC THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE,
                  IMAGE_EQ_EMPTY])

  let BOREL_INDUCT_UNIONS_INTERS ← prove
   r"!P. (!s. open s ==> P s) /\
       (!u. COUNTABLE u /\ (!s. s IN u ==> P s) ==> P (UNIONS u)) /\
       (!u. COUNTABLE u /\ (!s. s IN u ==> P s) ==> P (INTERS u))
       ==> !a:real^N->bool. borel a ==> P a"
   (GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!a. borel a ==> P a /\ P((:real^N) DIFF a)")
     (fun th => MESON_TAC [th]) THEN
    MATCH_MP_TAC borel_INDUCT THEN REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"s:real^N->bool") THEN ASM_SIMP_TAC [] THEN
      REWRITE_TAC [OPEN_CLOSED] THEN
      DISCH_THEN (MP_TAC o MATCH_MP CLOSED_IMP_GDELTA) THEN
      REWRITE_TAC [gdelta, INTERSECTION_OF] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      ASM_SIMP_TAC [],
      SIMP_TAC [COMPL_COMPL],
      X_GEN_TAC (← q r"u:(real^N->bool)->bool") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [] THEN REWRITE_TAC [DIFF_UNIONS] THEN
      REWRITE_TAC [← GSYM INTERS_INSERT] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [COUNTABLE_INSERT, COUNTABLE_IMAGE, SIMPLE_IMAGE] THEN
      REWRITE_TAC [FORALL_IN_INSERT, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [OPEN_UNIV]])

  let BOREL_INDUCT_COMPACT_UNIONS_INTERS ← prove
   r"!P. (!s. compact s ==> P s) /\
       (!u. COUNTABLE u /\ (!s. s IN u ==> P s) ==> P (UNIONS u)) /\
       (!u. COUNTABLE u /\ (!s. s IN u ==> P s) ==> P (INTERS u))
       ==> !a:real^N->bool. borel a ==> P a"
   (GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC BOREL_INDUCT_UNIONS_INTERS THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"s:real^N->bool") THEN
    DISCH_THEN (MP_TAC o MATCH_MP OPEN_IMP_LOCALLY_COMPACT) THEN
    DISCH_THEN (MP_TAC o MATCH_MP SIGMA_COMPACT) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool")
      (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_SIMP_TAC [])

  let BOREL_INDUCT_CLOSED_UNIONS_INTERS ← prove
   r"!P. (!s. closed s ==> P s) /\
       (!u. COUNTABLE u /\ (!s. s IN u ==> P s) ==> P (UNIONS u)) /\
       (!u. COUNTABLE u /\ (!s. s IN u ==> P s) ==> P (INTERS u))
       ==> !a:real^N->bool. borel a ==> P a"
   (GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC BOREL_INDUCT_COMPACT_UNIONS_INTERS THEN
    ASM_MESON_TAC [COMPACT_IMP_CLOSED])

  return { borel_RULES, borel_INDUCT, borel_CASES, BOREL_IN_EUCLIDEAN, BOREL_INDUCT_COMPACT,
           BOREL_INDUCT_COMPACT_DIFF, BOREL_INDUCT_COMPACT_ALT, BOREL_INDUCT_UNIONS_INTERS,
           BOREL_INDUCT_COMPACT_UNIONS_INTERS, BOREL_INDUCT_CLOSED_UNIONS_INTERS }

/- ------------------------------------------------------------------------- -/
/- Closure properties of Borel sets.  (topology.ml 31143-31253)              -/
/- ------------------------------------------------------------------------- -/

structure BOR2 where
  OPEN_IMP_BOREL : thm
  BOREL_COMPLEMENT : thm
  BOREL_UNIONS : thm
  BOREL_INTERS : thm
  BOREL_EMPTY : thm
  BOREL_UNIV : thm
  BOREL_UNION : thm
  BOREL_INTER : thm
  BOREL_DIFF : thm
  CLOSED_IMP_BOREL : thm
  COMPACT_IMP_BOREL : thm
  FSIGMA_IMP_BOREL : thm
  GDELTA_IMP_BOREL : thm
  LOCALLY_COMPACT_IMP_BOREL : thm
  OPEN_IN_BOREL : thm
  CLOSED_IN_BOREL : thm
  CONTINUOUS_BOREL_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupBOR2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC) (BCPT : CPT)
    (BCLC : CLC) (BFSG1 : FSG1) (BBOR1 : BOR1) : ExceptT String IO BOR2 := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { COMPL_COMPL, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMP_CONJ, INTERSECTION_OF, INTERS_2,
        INTERS_UNIONS, .. } := D.core2
  let { NOT_IN_EMPTY, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, .. } := D.core5
  let { UNIONS_2, UNIONS_GSPEC, UNION_OF, .. } := D.core6
  let { COUNTABLE_EMPTY, COUNTABLE_IMAGE, COUNTABLE_INSERT, .. } := D.lib1
  let { OPEN_EMPTY, OPEN_UNIV, .. } := BEUC
  let { closed, .. } := BCLO
  let { CLOSED_IN_CLOSED, OPEN_IN_OPEN, .. } := BLOC
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_OPEN_IN_PREIMAGE, .. } := BCLC
  let { FSIGMA_LOCALLY_COMPACT, fsigma, gdelta, .. } := BFSG1
  let { borel_INDUCT, borel_RULES, .. } := BBOR1
  -- @@SCOPE END

  let OPEN_IMP_BOREL ← prove
   r"!s:real^N->bool. open s ==> borel s"
   (REWRITE_TAC [borel_RULES])

  let BOREL_COMPLEMENT ← prove
   r"!s. borel((:real^N) DIFF s) <=> borel s"
   (MESON_TAC [COMPL_COMPL, borel_RULES])

  let BOREL_UNIONS ← prove
   r"!u. COUNTABLE u /\ (!s:real^N->bool. s IN u ==> borel s)
       ==> borel(UNIONS u)"
   (REWRITE_TAC [borel_RULES])

  let BOREL_INTERS ← prove
   r"!u. COUNTABLE u /\ (!s:real^N->bool. s IN u ==> borel s)
       ==> borel(INTERS u)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [INTERS_UNIONS] THEN
    REWRITE_TAC [BOREL_COMPLEMENT, SIMPLE_IMAGE] THEN
    MATCH_MP_TAC BOREL_UNIONS THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, BOREL_COMPLEMENT])

  let BOREL_EMPTY ← prove
   r"borel {}"
   (SIMP_TAC [OPEN_IMP_BOREL, OPEN_EMPTY])

  let BOREL_UNIV ← prove
   r"borel(:real^N)"
   (SIMP_TAC [OPEN_IMP_BOREL, OPEN_UNIV])

  let BOREL_UNION ← prove
   r"!s t:real^N->bool. borel s /\ borel t ==> borel(s UNION t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM UNIONS_2] THEN
    MATCH_MP_TAC BOREL_UNIONS THEN
    REWRITE_TAC [COUNTABLE_INSERT, FORALL_IN_INSERT] THEN
    ASM_REWRITE_TAC [COUNTABLE_EMPTY, NOT_IN_EMPTY])

  let BOREL_INTER ← prove
   r"!s t:real^N->bool. borel s /\ borel t ==> borel(s INTER t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM INTERS_2] THEN
    MATCH_MP_TAC BOREL_INTERS THEN
    REWRITE_TAC [COUNTABLE_INSERT, FORALL_IN_INSERT] THEN
    ASM_REWRITE_TAC [COUNTABLE_EMPTY, NOT_IN_EMPTY])

  let BOREL_DIFF ← prove
   r"!s t:real^N->bool. borel s /\ borel t ==> borel(s DIFF t)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
    SIMP_TAC [BOREL_INTER, BOREL_COMPLEMENT])

  let CLOSED_IMP_BOREL ← prove
   r"!s:real^N->bool. closed s ==> borel s"
   (GEN_TAC THEN REWRITE_TAC [closed] THEN
    DISCH_THEN (MP_TAC o MATCH_MP OPEN_IMP_BOREL) THEN
    REWRITE_TAC [BOREL_COMPLEMENT])

  let COMPACT_IMP_BOREL ← prove
   r"!s:real^N->bool. compact s ==> borel s"
   (SIMP_TAC [CLOSED_IMP_BOREL, COMPACT_IMP_CLOSED])

  let FSIGMA_IMP_BOREL ← prove
   r"!s:real^N->bool. fsigma s ==> borel s"
   (GEN_TAC THEN REWRITE_TAC [fsigma, UNION_OF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool")
     (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_SIMP_TAC [BOREL_UNIONS, CLOSED_IMP_BOREL])

  let GDELTA_IMP_BOREL ← prove
   r"!s:real^N->bool. gdelta s ==> borel s"
   (GEN_TAC THEN REWRITE_TAC [gdelta, INTERSECTION_OF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool")
     (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_SIMP_TAC [BOREL_INTERS, OPEN_IMP_BOREL])

  let LOCALLY_COMPACT_IMP_BOREL ← prove
   r"!s:real^N->bool. locally compact s ==> borel s"
   (SIMP_TAC [FSIGMA_IMP_BOREL, FSIGMA_LOCALLY_COMPACT])

  let OPEN_IN_BOREL ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean t) s /\ borel t ==> borel s"
   (REWRITE_TAC [OPEN_IN_OPEN] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC BOREL_INTER THEN
    ASM_SIMP_TAC [OPEN_IMP_BOREL])

  let CLOSED_IN_BOREL ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean t) s /\ borel t ==> borel s"
   (REWRITE_TAC [CLOSED_IN_CLOSED] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC BOREL_INTER THEN
    ASM_SIMP_TAC [CLOSED_IMP_BOREL])

  let CONTINUOUS_BOREL_PREIMAGE ← do
    let lemma ← prove
     r"{x | x IN s /\ f x IN UNIONS u} =
       UNIONS {{x | x IN s /\ f x IN t} | t IN u}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    prove
     r"!f:real^M->real^N s t.
          f continuous_on s /\ borel s /\ borel t
          ==> borel {x | x IN s /\ f x IN t}"
     (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REPEAT GEN_TAC THEN REPEAT DISCH_TAC THEN
      MATCH_MP_TAC borel_INDUCT THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"t:real^N->bool") THEN DISCH_TAC THEN
        MATCH_MP_TAC OPEN_IN_BOREL THEN EXISTS_TAC (← q r"s:real^M->bool") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE THEN
        ASM_REWRITE_TAC [],
        ASM_SIMP_TAC [BOREL_DIFF, ← SET_RULE
         (← q r"{x | x IN s /\ f x IN UNIV DIFF t} = s DIFF {x | x IN s /\ f x IN t}")],
        REPEAT STRIP_TAC THEN REWRITE_TAC [lemma] THEN
        MATCH_MP_TAC BOREL_UNIONS THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE]])

  return { OPEN_IMP_BOREL, BOREL_COMPLEMENT, BOREL_UNIONS, BOREL_INTERS, BOREL_EMPTY,
           BOREL_UNIV, BOREL_UNION, BOREL_INTER, BOREL_DIFF, CLOSED_IMP_BOREL,
           COMPACT_IMP_BOREL, FSIGMA_IMP_BOREL, GDELTA_IMP_BOREL, LOCALLY_COMPACT_IMP_BOREL,
           OPEN_IN_BOREL, CLOSED_IN_BOREL, CONTINUOUS_BOREL_PREIMAGE }

/- ------------------------------------------------------------------------- -/
/- Borel sets under homeomorphisms; products; Lavrentiev for Borel sets.     -/
/- (topology.ml 31254-31369)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BOR3 where
  HOMEOMORPHIC_BORELNESS : thm
  BOREL_TRANSLATION : thm
  BOREL_LINEAR_IMAGE : thm
  HOMEOMORPHISM_BORELNESS : thm
  BOREL_PCROSS : thm
  BOREL_PCROSS_EQ : thm
  LAVRENTIEV_BOREL : thm
  deriving Inhabited

@[nospecialize]
def setupBOR3 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLS1 : CLS1) (BCSL : CSL)
    (BCMS : CMS) (BIDC : IDC) (BPCR1 : PCR1) (BPCA1 : PCA1) (BHMA : HMA) (BHMB : HMB)
    (BFSG1 : FSG1) (BLAV : LAV) (BBOR1 : BOR1) (BBOR2 : BOR2) : ExceptT String IO BOR3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, add_linear_invariants, add_translation_invariants, .. } := D
  let { FORALL_IN_IMAGE, IMP_CONJ, INTER_PCROSS, INTER_UNIV, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, PASTECART_IN_PCROSS, PCROSS_DIFF,
        PCROSS_EMPTY, PCROSS_UNIONS, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET_TRANS, .. } := D.core5
  let { SWAP_EXISTS_THM, .. } := D.core6
  let { COUNTABLE_IMAGE, .. } := D.lib1
  let { OPEN_UNIV, .. } := BEUC
  let { CLOSED_CLOSURE, CLOSURE_SUBSET, .. } := BCLS1
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { OPEN_PCROSS, .. } := BPCR1
  let { CONTINUOUS_ON_PASTECART, .. } := BPCA1
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, homeomorphic, homeomorphism, .. } := BHMA
  let { HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF, HOMEOMORPHIC_TRANSLATION_SELF, .. } := BHMB
  let { CLOSED_IMP_GDELTA, .. } := BFSG1
  let { LAVRENTIEV, LAVRENTIEV_HOMEOMORPHISM, .. } := BLAV
  let { borel_INDUCT, .. } := BBOR1
  let { BOREL_DIFF, BOREL_EMPTY, BOREL_INTER, BOREL_UNIONS, BOREL_UNIV,
        CONTINUOUS_BOREL_PREIMAGE, GDELTA_IMP_BOREL, OPEN_IMP_BOREL, .. } := BBOR2
  -- @@SCOPE END

  let HOMEOMORPHIC_BORELNESS ← do
    let lemma ← prove
     r"!s:real^M->bool t:real^N->bool.
            s homeomorphic t ==> borel s ==> borel t"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
      STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP LAVRENTIEV_HOMEOMORPHISM) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^N->bool"] THEN
      MAP_EVERY X_GEN_TAC [← q r"f':real^M->real^N", ← q r"g':real^N->real^M"] THEN
      STRIP_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      SUBGOAL_THEN (← q r"t = {x | x IN v /\ (g':real^N->real^M) x IN s}")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_BOREL_PREIMAGE THEN
      ASM_SIMP_TAC [GDELTA_IMP_BOREL])
    prove
     r"!s:real^M->bool t:real^N->bool.
          s homeomorphic t ==> (borel s <=> borel t)"
     (REPEAT STRIP_TAC THEN EQ_TAC THEN
      MATCH_MP_TAC lemma THEN ASM_MESON_TAC [HOMEOMORPHIC_SYM])

  let BOREL_TRANSLATION ← prove
   r"!a:real^N s. borel (IMAGE (\x. a + x) s) <=> borel s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_BORELNESS THEN
    REWRITE_TAC [HOMEOMORPHIC_TRANSLATION_SELF])

  add_translation_invariants [BOREL_TRANSLATION]

  let BOREL_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (borel(IMAGE f s) <=> borel s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_BORELNESS THEN
    MATCH_MP_TAC HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF THEN
    ASM_REWRITE_TAC [])

  add_linear_invariants [BOREL_LINEAR_IMAGE]

  let HOMEOMORPHISM_BORELNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (borel(IMAGE f k) <=> borel k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_BORELNESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let BOREL_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool. borel s /\ borel t ==> borel(s PCROSS t)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s PCROSS t = (s PCROSS (:real^N)) INTER ((:real^M) PCROSS t)")
    SUBST1_TAC THENL [REWRITE_TAC [INTER_PCROSS, INTER_UNIV], ALL_TAC] THEN
    MATCH_MP_TAC BOREL_INTER THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"borel(s:real^M->bool)") THEN
      SPEC_TAC (← q r"s:real^M->bool", ← q r"s:real^M->bool"),
      UNDISCH_TAC (← q r"borel(t:real^N->bool)") THEN
      SPEC_TAC (← q r"t:real^N->bool", ← q r"t:real^N->bool")] THEN
    MATCH_MP_TAC borel_INDUCT THEN REWRITE_TAC [PCROSS_DIFF] THEN
    SIMP_TAC [OPEN_PCROSS, OPEN_UNIV, OPEN_IMP_BOREL, BOREL_DIFF] THEN
    REWRITE_TAC [PCROSS_UNIONS] THEN
    SIMP_TAC [BOREL_UNIONS, FORALL_IN_IMAGE, SIMPLE_IMAGE, COUNTABLE_IMAGE])

  let BOREL_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        borel(s PCROSS t) <=> s = {} \/ t = {} \/ borel s /\ borel t"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [BOREL_PCROSS, PCROSS_EMPTY, BOREL_EMPTY] THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p /\ ~q ==> r) ==> p \/ q \/ r")) THEN
    REPEAT STRIP_TAC THENL
     [UNDISCH_TAC (← q r"~(t:real^N->bool = {})"),
      UNDISCH_TAC (← q r"~(s:real^M->bool = {})")] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THENL
     [X_GEN_TAC (← q r"y:real^N"), X_GEN_TAC (← q r"x:real^M")] THEN
    DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"s = {x | x IN (:real^M) /\
                             pastecart x (y:real^N) IN (s PCROSS t)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [PASTECART_IN_PCROSS] THEN ASM SET_TAC [], ALL_TAC],
      SUBGOAL_THEN (← q r"t = {y | y IN (:real^N) /\
                             pastecart (x:real^M) y IN (s PCROSS t)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [PASTECART_IN_PCROSS] THEN ASM SET_TAC [], ALL_TAC]] THEN
    MATCH_MP_TAC CONTINUOUS_BOREL_PREIMAGE THEN
    ASM_REWRITE_TAC [BOREL_UNIV] THEN
    MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
    REWRITE_TAC [CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST])

  let LAVRENTIEV_BOREL ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\ borel t
        ==> ?u g. borel u /\ s SUBSET u /\ u SUBSET closure s /\
                  g continuous_on u /\ IMAGE g u SUBSET t /\
                  !x. x IN s ==> g x = f x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool",
                      ← q r"closure t:real^N->bool"]
          LAVRENTIEV) THEN
    ASM_SIMP_TAC [CLOSED_CLOSURE, CLOSED_IMP_GDELTA] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SUBSET_TRANS, CLOSURE_SUBSET],
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^M->real^N") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"{x | x IN u /\ (g:real^M->real^N) x IN t}") THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_BOREL_PREIMAGE THEN
      ASM_SIMP_TAC [GDELTA_IMP_BOREL],
      ASM SET_TAC [],
      ASM SET_TAC [],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONTINUOUS_ON_SUBSET)) THEN SET_TAC [],
      ASM SET_TAC []])

  return { HOMEOMORPHIC_BORELNESS, BOREL_TRANSLATION, BOREL_LINEAR_IMAGE,
           HOMEOMORPHISM_BORELNESS, BOREL_PCROSS, BOREL_PCROSS_EQ, LAVRENTIEV_BOREL }

/- ------------------------------------------------------------------------- -/
/- Baire functions. We only define these for finite indices, since I can't   -/
/- imagine ever using any indexed by higher ordinals. But this means         -/
/- that "borel_measurable" is strictly stronger than "baire n for some n".   -/
/- (topology.ml 31370-31523)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BAI1 where
  baire : thm
  BAIRE_MONO : thm
  CONTINUOUS_ON_IMP_BAIRE : thm
  BAIRE_SUBSET : thm
  BAIRE_EQ : thm
  BAIRE_CONST : thm
  BAIRE_PASTECART : thm
  BAIRE_COMPOSE_CONTINUOUS : thm
  BAIRE_CONTINUOUS_COMPOSE_UNIV : thm
  BAIRE_CMUL : thm
  BAIRE_BILINEAR : thm
  BAIRE_ADD : thm
  BAIRE_SUB : thm
  BAIRE_MUL : thm
  BAIRE_VSUM : thm
  deriving Inhabited

@[nospecialize]
def setupBAI1 [HolBase] (D : TopologyDeps) (BARI : ARI) (BCSL : CSL) (BSQC : SQC) (BCMS : CMS)
    (BIDC : IDC) (BLCP : LCP) (BPCA1 : PCA1) : ExceptT String IO BAI1 := do
  -- @@SCOPE BEGIN
  let { define, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, VECTOR_ARITH, .. } := D
  let { ETA_AX, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FSTCART_PASTECART, IMP_CONJ, IMP_CONJ_ALT,
        IMP_IMP, .. } := D.core2
  let { IN_UNIV, LE_0, MONO_EXISTS, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, SUBSET, SUBSET_UNIV, .. } := D.core5
  let { SWAP_FORALL_THM, TRANSITIVE_STEPWISE_LE, num_INDUCTION, o_DEF, o_THM, .. } := D.core6
  let { BILINEAR_DROP_MUL, .. } := D.vec1
  let { LIFT_DROP, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { VSUM_CLAUSES, .. } := D.vec4
  let { LIM_CONST, .. } := BARI
  let { CONTINUOUS_ON_EQ, CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, .. } := BIDC
  let { BILINEAR_CONTINUOUS_ON, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CONTINUOUS_ON_PASTECART, LIM_PASTECART, .. } := BPCA1
  -- @@SCOPE END

  let baire ← define
   r"(baire 0 s (f:real^M->real^N) <=> f continuous_on s) /\
  (baire (SUC n) s f <=>
        ?g. (!k. baire n s (g k)) /\
            (!x. x IN s ==> ((\k. g k x) --> f x) sequentially))"

  let BAIRE_MONO ← prove
   r"!f:real^M->real^N s m n. baire m s f /\ m <= n ==> baire n s f"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ_ALT] THEN
    MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
    REPEAT (CONJ_TAC THENL [CONV_TAC (fun t => TAUT t), ALL_TAC]) THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN REWRITE_TAC [baire] THEN
    EXISTS_TAC (← q r"(\k. f):num->real^M->real^N") THEN
    ASM_SIMP_TAC [LIM_CONST])

  let CONTINUOUS_ON_IMP_BAIRE ← prove
   r"!f:real^M->real^N s n. f continuous_on s ==> baire n s f"
   (REWRITE_TAC [← GSYM (← CONJUNCT1 baire)] THEN
    MESON_TAC [BAIRE_MONO, LE_0])

  let BAIRE_SUBSET ← prove
   r"!f:real^M->real^N s t n.
        baire n s f /\ t SUBSET s ==> baire n t f"
   (ONCE_REWRITE_TAC [← MESON []
     (← q r"(!f s t n. P f s t n) <=> (!s t n f. P f s t n)")] THEN
    GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THEN
    REWRITE_TAC [baire, CONTINUOUS_ON_SUBSET] THEN
    X_GEN_TAC (← q r"f:real^M->real^N") THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM_MESON_TAC [SUBSET])

  let BAIRE_EQ ← prove
   r"!f:real^M->real^N g s n.
        (!x. x IN s ==> f x = g x) /\ baire n s f
        ==> baire n s g"
   (ONCE_REWRITE_TAC [← MESON []
     (← q r"(!f g s n. P f g s n) <=> (!s n f g. P f g s n)")] THEN
    GEN_TAC THEN INDUCT_TAC THEN
    REWRITE_TAC [baire, CONTINUOUS_ON_EQ] THEN MESON_TAC [])

  let BAIRE_CONST ← prove
   r"!s:real^M->bool n a:real^N. baire n s (\x. a)"
   (SIMP_TAC [CONTINUOUS_ON_IMP_BAIRE, CONTINUOUS_ON_CONST])

  let BAIRE_PASTECART ← prove
   r"!f:real^M->real^N g:real^M->real^P s n.
        baire n s f /\ baire n s g
        ==> baire n s (\x. pastecart (f x) (g x))"
   (ONCE_REWRITE_TAC [← MESON []
     (← q r"(!f g s n. P f g s n) <=> (!s n f g. P f g s n)")] THEN
    GEN_TAC THEN INDUCT_TAC THEN
    REWRITE_TAC [baire, CONTINUOUS_ON_PASTECART] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^M->real^P"] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"h:num->real^M->real^N") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"k:num->real^M->real^P") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"\n:num x:real^M. pastecart (h n x:real^N) (k n x:real^P)") THEN
    ASM_SIMP_TAC [ETA_AX, LIM_PASTECART])

  let BAIRE_COMPOSE_CONTINUOUS ← prove
   r"!f:real^M->real^N g:real^N->real^P s k.
        f continuous_on s /\ baire k (IMAGE f s) g ==> baire k s (g o f)"
   (GEN_REWRITE_TAC BINDER_CONV [SWAP_FORALL_THM] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    MATCH_MP_TAC num_INDUCTION THEN
    ASM_SIMP_TAC [baire, CONTINUOUS_ON_COMPOSE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"g:real^N->real^P") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:num->real^N->real^P") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\n. (h:num->real^N->real^P) n o (f:real^M->real^N)") THEN
    ASM_SIMP_TAC [o_THM])

  let BAIRE_CONTINUOUS_COMPOSE_UNIV ← prove
   r"!f:real^N->real^P g:real^M->real^N s n.
        f continuous_on (:real^N) /\ baire n s g
        ==> baire n s (f o g)"
   (ONCE_REWRITE_TAC [← MESON []
     (← q r"(!f g s n. P f g s n) <=> (!f s n g. P f g s n)")] THEN
    GEN_TAC THEN GEN_TAC THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN DISCH_TAC THEN
    INDUCT_TAC THEN REWRITE_TAC [baire] THENL
     [ASM_MESON_TAC [CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
      X_GEN_TAC (← q r"g:real^M->real^N") THEN DISCH_THEN (X_CHOOSE_THEN
        (← q r"h:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\n. (f:real^N->real^P) o ((h:num->real^M->real^N) n)") THEN
      ASM_SIMP_TAC [] THEN RULE_ASSUM_TAC (REWRITE_RULE
       [CONTINUOUS_ON_SEQUENTIALLY, IN_UNIV, o_DEF]) THEN
      ASM_SIMP_TAC [o_THM]])

  let BAIRE_CMUL ← prove
   r"!f:real^M->real^N s c n.
        baire n s f ==> baire n s (\x. c % f x)"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ, o_DEF]
      BAIRE_CONTINUOUS_COMPOSE_UNIV) THEN
    SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID])

  let BAIRE_BILINEAR ← prove
   r"!bop:real^N->real^P->real^Q f g s:real^M->bool n.
        bilinear bop /\ baire n s f /\ baire n s g
        ==> baire n s (\x. bop (f x) (g x))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP BAIRE_PASTECART) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BILINEAR_CONTINUOUS_ON) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP BAIRE_CONTINUOUS_COMPOSE_UNIV) THEN
    REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART])

  let BAIRE_ADD ← prove
   r"!f g:real^M->real^N s n.
        baire n s f /\ baire n s g ==> baire n s (\x. f x + g x)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP BAIRE_PASTECART) THEN
    SUBGOAL_THEN
     (← q r"(\z. (fstcart z:real^N) + sndcart z) continuous_on UNIV")
    MP_TAC THENL
     [SIMP_TAC [CONTINUOUS_ON_ADD, LINEAR_CONTINUOUS_ON, LINEAR_FSTCART,
                LINEAR_SNDCART],
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP BAIRE_CONTINUOUS_COMPOSE_UNIV) THEN
      REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART]])

  let BAIRE_SUB ← prove
   r"!f g:real^M->real^N s n.
        baire n s f /\ baire n s g
        ==> baire n s (\x. f x - g x)"
   (REWRITE_TAC [← VECTOR_ARITH (← q r"x - y:real^N = x + --(&1) % y")] THEN
    SIMP_TAC [BAIRE_CMUL, BAIRE_ADD])

  let BAIRE_MUL ← prove
   r"!f g:real^M->real^N s n.
        baire n s (\x. lift(f x)) /\ baire n s g
        ==> baire n s (\x. f x % g x)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [BILINEAR_DROP_MUL]
      (← ISPEC (← q r"\x y:real^N. drop x % y") BAIRE_BILINEAR))) THEN
    REWRITE_TAC [LIFT_DROP])

  let BAIRE_VSUM ← prove
   r"!f:A->real^M->real^N s t n.
        FINITE t /\ (!i. i IN t ==> baire n s (f i))
        ==> baire n s (\x. vsum t (\i. f i x))"
   (GEN_TAC THEN GEN_TAC THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [VSUM_CLAUSES, BAIRE_CONST, BAIRE_ADD, FORALL_IN_INSERT, ETA_AX])

  return { baire, BAIRE_MONO, CONTINUOUS_ON_IMP_BAIRE, BAIRE_SUBSET, BAIRE_EQ, BAIRE_CONST,
           BAIRE_PASTECART, BAIRE_COMPOSE_CONTINUOUS, BAIRE_CONTINUOUS_COMPOSE_UNIV,
           BAIRE_CMUL, BAIRE_BILINEAR, BAIRE_ADD, BAIRE_SUB, BAIRE_MUL, BAIRE_VSUM }

/- ------------------------------------------------------------------------- -/
/- Baire functions: products, norms, max, min, components.                  -/
/- (topology.ml 31524-31586)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BAI2 where
  BAIRE_PRODUCT : thm
  BAIRE_NORM : thm
  BAIRE_MAX : thm
  BAIRE_MIN : thm
  BAIRE_COMPONENTWISE : thm
  deriving Inhabited

@[nospecialize]
def setupBAI2 [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) (BCMS : CMS) (BLFR : LFR)
    (BBAI1 : BAI1) : ExceptT String IO BAI2 := do
  -- @@SCOPE BEGIN
  let { INDUCT_TAC, REAL_ARITH, .. } := D
  let { ETA_AX, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_INSERT, IMP_CONJ, IMP_CONJ_ALT, .. } := D.core2
  let { LAMBDA_BETA, LEFT_IMP_EXISTS_THM, PRODUCT_CLAUSES, .. } := D.core3
  let { RIGHT_IMP_EXISTS_THM, SKOLEM_THM, .. } := D.core5
  let { SWAP_FORALL_THM, o_ASSOC, o_DEF, .. } := D.core6
  let { DROP_SUB, .. } := D.vec1
  let { LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_SUB, .. } := D.vec2
  let { NORM_LIFT, .. } := D.vec3
  let { LIM_COMPONENTWISE_LIFT, .. } := BLIM1
  let { CONTINUOUS_ON_COMPONENTWISE_LIFT, .. } := BCMS
  let { CONTINUOUS_ON_LIFT_COMPONENT, CONTINUOUS_ON_LIFT_NORM, .. } := BLFR
  let { BAIRE_ADD, BAIRE_CMUL, BAIRE_CONST, BAIRE_CONTINUOUS_COMPOSE_UNIV, BAIRE_MUL,
        BAIRE_SUB, baire, .. } := BBAI1
  -- @@SCOPE END

  let BAIRE_PRODUCT ← prove
   r"!f:A->real^N->real s t n.
        FINITE t /\ (!i. i IN t ==> baire n s (\x. lift(f i x)))
        ==> baire n s (\x. lift(product t (\i. f i x)))"
   (GEN_TAC THEN GEN_TAC THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [PRODUCT_CLAUSES, BAIRE_CONST, LIFT_CMUL, BAIRE_MUL,
              FORALL_IN_INSERT, ETA_AX])

  let BAIRE_NORM ← prove
   r"!f:real^M->real^N s n. baire n s f ==> baire n s (\x. lift(norm(f x)))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM o_DEF, o_ASSOC] THEN
    MATCH_MP_TAC BAIRE_CONTINUOUS_COMPOSE_UNIV THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_LIFT_NORM])

  let BAIRE_MAX ← prove
   r"!f g:real^N->real s n.
        baire n s (\x. lift(f x)) /\ baire n s (\x. lift(g x))
        ==> baire n s (\x. lift(max (f x) (g x)))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← REAL_ARITH
     (← q r"max x y = inv(&2) * (x + y) + inv(&2) * abs(x - y)")] THEN
    REWRITE_TAC [LIFT_ADD, LIFT_CMUL, LIFT_DROP] THEN
    MATCH_MP_TAC BAIRE_ADD THEN CONJ_TAC THEN MATCH_MP_TAC BAIRE_CMUL THEN
    ASM_SIMP_TAC [BAIRE_ADD, ← GSYM DROP_SUB, ← GSYM NORM_LIFT] THEN
    MATCH_MP_TAC BAIRE_NORM THEN ASM_SIMP_TAC [BAIRE_SUB, LIFT_SUB])

  let BAIRE_MIN ← prove
   r"!f g:real^N->real s n.
        baire n s (\x. lift(f x)) /\ baire n s (\x. lift(g x))
        ==> baire n s (\x. lift(min (f x) (g x)))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← REAL_ARITH
     (← q r"min x y = inv(&2) * (x + y) - inv(&2) * abs(x - y)")] THEN
    REWRITE_TAC [LIFT_ADD, LIFT_SUB, LIFT_CMUL, LIFT_DROP] THEN
    MATCH_MP_TAC BAIRE_SUB THEN CONJ_TAC THEN MATCH_MP_TAC BAIRE_CMUL THEN
    ASM_SIMP_TAC [BAIRE_ADD, ← GSYM DROP_SUB, ← GSYM NORM_LIFT] THEN
    MATCH_MP_TAC BAIRE_NORM THEN ASM_SIMP_TAC [BAIRE_SUB, LIFT_SUB])

  let BAIRE_COMPONENTWISE ← prove
   r"!f:real^M->real^N s n.
        baire n s f <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> baire n s (\x. lift(f x$i))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT, o_DEF]
         BAIRE_CONTINUOUS_COMPOSE_UNIV)) THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_COMPONENT],
      POP_ASSUM MP_TAC THEN MAP_EVERY (fun t => SPEC_TAC (t, t))
       [← q r"f:real^M->real^N", ← q r"n:num"]] THEN
    INDUCT_TAC THEN GEN_TAC THEN
    REWRITE_TAC [baire, ← GSYM CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
      [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:num->num->real^M->real^1") THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"(\n:num x. lambda i. drop((g:num->num->real^M->real^1) i n x))
      :num->real^M->real^N") THEN
    REWRITE_TAC [] THEN REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC,
      ONCE_REWRITE_TAC [LIM_COMPONENTWISE_LIFT]] THEN
    ASM_SIMP_TAC [LAMBDA_BETA, LIFT_DROP, ETA_AX])

  return { BAIRE_PRODUCT, BAIRE_NORM, BAIRE_MAX, BAIRE_MIN, BAIRE_COMPONENTWISE }

/- ------------------------------------------------------------------------- -/
/- Uniform limits of Baire functions.  (topology.ml 31587-31818)             -/
/- ------------------------------------------------------------------------- -/

structure BUL where
  BAIRE_UNIFORM_LIMIT : thm
  deriving Inhabited

@[nospecialize]
def setupBUL [HolBase] (D : TopologyDeps) (BLIM1 : LIM1) (BARI : ARI) (BUNQ : UNQ) (BTRN : TRN)
    (BUCC : UCC) (BSUM1 : SUM1) (BSUM3 : SUM3) (BCMT : CMT) (BRAT : RAT) (BBAI1 : BAI1)
    (BBAI2 : BAI2) : ExceptT String IO BUL := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON, MESON_TAC,
        REAL_ARITH, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, .. } := D
  let { ADD1, AND_FORALL_THM, CARD_NUMSEG_1, CART_EQ, DIMINDEX_GE_1, ETA_AX, FINITE_NUMSEG, .. } :=
    D.core1
  let { FORALL_AND_THM, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_NUMSEG, .. } := D.core2
  let { LAMBDA_BETA, LEFT_AND_FORALL_THM, LEFT_IMP_EXISTS_THM, LE_0, LE_1, LE_REFL, MONO_EXISTS,
        REAL_ADD_LDISTRIB, .. } := D.core3
  let { REAL_ARCH_POW_INV, REAL_INV_MUL, REAL_INV_POW, REAL_LE_INV_EQ, REAL_LE_LMUL,
        REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_POW2,
        REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_RID, REAL_MUL_RZERO, REAL_MUL_SYM,
        REAL_OF_NUM_LT, REAL_POS, REAL_POW_ADD, REAL_POW_INV, REAL_POW_LE, REAL_POW_MONO_INV,
        REAL_SUB_LT, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, .. } := D.core5
  let { SUM_CONST, SUM_LE_NUMSEG, SUM_LMUL, o_DEF, real_div, real_pow, .. } := D.core6
  let { REAL_HALF, SUM_GP, .. } := D.misc
  let { COMPONENT_LE_NORM, DIST_0, .. } := D.vec1
  let { LIFT_CMUL, .. } := D.vec2
  let { NORM_LE_L1, NORM_LIFT, NORM_NEG, .. } := D.vec3
  let { VECTOR_NEG_SUB, VSUM_DIFFS_ALT, VSUM_NORM_LE, VSUM_SUB_NUMSEG, dist, .. } := D.vec4
  let { ALWAYS_EVENTUALLY, ARCH_EVENTUALLY_POW_INV, .. } := D.met1
  let { EVENTUALLY_AND, EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, EVENTUALLY_TRUE, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { tendsto, .. } := BLIM1
  let { LIM_CONST, LIM_NEG, LIM_NULL, LIM_NULL_CMUL, LIM_NULL_COMPARISON, LIM_NULL_VSUM,
        LIM_SUB, .. } := BARI
  let { LIM_NORM_UBOUND, .. } := BUNQ
  let { LIM_TRANSFORM_EVENTUALLY, .. } := BTRN
  let { CONTINUOUS_UNIFORM_LIMIT, .. } := BUCC
  let { SERIES_FROM, summable, .. } := BSUM1
  let { SUMMABLE_CMUL, SUMS_OFFSET, .. } := BSUM3
  let { SUMMABLE_COMPARISON, .. } := BCMT
  let { SUMMABLE_REAL_GP, .. } := BRAT
  let { BAIRE_ADD, BAIRE_CONST, BAIRE_SUB, BAIRE_VSUM, baire, .. } := BBAI1
  let { BAIRE_COMPONENTWISE, BAIRE_MAX, BAIRE_MIN, .. } := BBAI2
  -- @@SCOPE END

  let BAIRE_UNIFORM_LIMIT ← prove
   r"!f g:real^M->real^N s k.
        eventually (\n. baire k s (f n)) sequentially /\
        (!e. &0 < e
             ==> eventually (\n. !x. x IN s ==> norm(f n x - g x) < e)
                            sequentially)
        ==> baire k s g"
   (ONCE_REWRITE_TAC [← MESON []
     (← q r"(!f g s k. P f g s k) <=> (!s k f g. P f g s k)")] THEN
    GEN_TAC THEN INDUCT_TAC THENL
     [REWRITE_TAC [baire] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") CONTINUOUS_UNIFORM_LIMIT) THEN
      EXISTS_TAC (← q r"f:num->real^M->real^N") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:num->real^M->real^N", ← q r"g:real^M->real^N"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!n. ?m. baire (SUC k) s (f m) /\
              !x. x IN s
                  ==> norm((f:num->real^M->real^N) m x - g x)
                      < inv(&2 pow (n + 1))")
    MP_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(&2 pow (n + 1))")) THEN
      ASM_REWRITE_TAC [REAL_LT_INV_EQ, REAL_LT_POW2] THEN
      UNDISCH_TAC
       (← q r"eventually (\n. baire (SUC k) s (f n:real^M->real^N)) sequentially") THEN
      REWRITE_TAC [IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN MESON_TAC [LE_REFL],
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"r:num->num") THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"h = \n x. (f:num->real^M->real^N) (r(n + 1)) x - f (r n) x") THEN
    SUBGOAL_THEN
     (← q r"!n x. x IN s ==> norm((h:num->real^M->real^N) n x) < inv(&2 pow n)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN EXPAND_TAC "h" THEN REWRITE_TAC [] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPECL [← q r"n + 1", ← q r"x:real^M"] th) THEN
              MP_TAC (← SPECL [← q r"n:num", ← q r"x:real^M"] th))) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← NORM_ARITH
       (← q r"a + b <= c
        ==> norm(f - g:real^N) < a
            ==> norm(f' - g) < b ==> norm(f' - f) < c")) THEN
      REWRITE_TAC [REAL_POW_ADD, REAL_INV_MUL, ← GSYM REAL_MUL_ASSOC] THEN
      REWRITE_TAC [← GSYM REAL_ADD_LDISTRIB] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      SIMP_TAC [REAL_LE_INV_EQ, REAL_LT_IMP_LE, REAL_LT_POW2],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n:num. ?d:num->real^M->real^N.
          (!m. baire k s (d m)) /\
          (!m x. norm(d m x) <= &(dimindex(:N)) / &2 pow n) /\
          (!x. x IN s ==> ((\m. d m x) --> h n x) sequentially)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      SUBGOAL_THEN (← q r"baire (SUC k) s ((h:num->real^M->real^N) n)") MP_TAC THENL
       [EXPAND_TAC "h" THEN REWRITE_TAC [] THEN MATCH_MP_TAC BAIRE_SUB THEN
        ASM_REWRITE_TAC [ETA_AX],
        REWRITE_TAC [baire, LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"d:num->real^M->real^N") THEN STRIP_TAC THEN
      EXISTS_TAC
       (← q r"(\m x. lambda i. min (max (--inv(&2 pow n))
                                  ((d m x:real^N)$i))
                             (inv(&2 pow n)))
        :num->real^M->real^N") THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"m:num") THEN ONCE_REWRITE_TAC [BAIRE_COMPONENTWISE] THEN
        X_GEN_TAC (← q r"i:num") THEN SIMP_TAC [LAMBDA_BETA] THEN STRIP_TAC THEN
        MATCH_MP_TAC BAIRE_MIN THEN REWRITE_TAC [BAIRE_CONST] THEN
        MATCH_MP_TAC BAIRE_MAX THEN REWRITE_TAC [BAIRE_CONST] THEN
        RULE_ASSUM_TAC (ONCE_REWRITE_RULE [BAIRE_COMPONENTWISE]) THEN
        ASM_SIMP_TAC [],
        REPEAT GEN_TAC THEN
        W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o RAND_CONV)
         [← GSYM CARD_NUMSEG_1] THEN
        SIMP_TAC [real_div, ← GSYM SUM_CONST, FINITE_NUMSEG] THEN
        MATCH_MP_TAC SUM_LE_NUMSEG THEN SIMP_TAC [LAMBDA_BETA] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 < a ==> abs(min (max (--a) x) a) <= a")) THEN
        REWRITE_TAC [REAL_LT_INV_EQ, REAL_LT_POW2],
        X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
        MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
        EXISTS_TAC (← q r"\k. (d:num->real^M->real^N) k x") THEN
        ASM_SIMP_TAC [] THEN MATCH_MP_TAC EVENTUALLY_MONO THEN
        EXISTS_TAC (← q r"\m. norm((d:num->real^M->real^N) m x - h n x)
                        < inv(&2 pow n) - norm(h n x)") THEN
        RULE_ASSUM_TAC (REWRITE_RULE [tendsto, dist]) THEN
        ASM_SIMP_TAC [REAL_SUB_LT] THEN X_GEN_TAC (← q r"m:num") THEN
        DISCH_THEN (ASSUME_TAC o MATCH_MP (← NORM_ARITH
         (← q r"norm(x - y:real^N) < a - norm y ==> norm(x) <= a"))) THEN
        SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs x <= n ==> x = min (max (--n) x) n")) THEN
        ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS]],
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"d:num->num->real^M->real^N") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!m x. x IN s
            ==> summable (from 0) (\n. (d:num->num->real^M->real^N) n m x)")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC SUMMABLE_COMPARISON THEN
      EXISTS_TAC (← q r"\n. &(dimindex(:N)) / &2 pow n") THEN
      ASM_SIMP_TAC [o_DEF] THEN
      REWRITE_TAC [real_div, LIFT_CMUL, REAL_INV_POW] THEN
      MATCH_MP_TAC SUMMABLE_CMUL THEN MATCH_MP_TAC SUMMABLE_REAL_GP THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      REWRITE_TAC [summable, RIGHT_IMP_EXISTS_THM, SKOLEM_THM]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"g = \x. (f:num->real^M->real^N) (r 0) x +
                          (g x - f (r 0) x)")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM] THEN CONV_TAC (fun t => VECTOR_ARITH t),
      MATCH_MP_TAC BAIRE_ADD THEN ASM_REWRITE_TAC [ETA_AX]] THEN
    REWRITE_TAC [baire] THEN EXISTS_TAC (← q r"t:num->real^M->real^N") THEN
    SUBGOAL_THEN
     (← q r"!e. &0 < e
          ==> eventually
           (\n. !x i. x IN s
                      ==> norm(vsum (0..n)
                                    (\m. (d:num->num->real^M->real^N) m i x) -
                             t i x) < e)
           sequentially")
     (LABEL_TAC "*")
    THENL
     [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e / &2 / &(dimindex(:N))"]
        REAL_ARCH_POW_INV) THEN
      ASM_SIMP_TAC [REAL_HALF, REAL_LT_DIV, REAL_OF_NUM_LT, LE_1,
                    DIMINDEX_GE_1, EVENTUALLY_SEQUENTIALLY] THEN
      SIMP_TAC [REAL_POW_INV, REAL_LT_RDIV_EQ, REAL_OF_NUM_LT, LE_1,
                DIMINDEX_GE_1] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"j:num"] THEN DISCH_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN EXISTS_TAC
       (← q r"\m. --vsum(n+1..m) (\q. (d:num->num->real^M->real^N) q j x)") THEN
      REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [← GSYM VECTOR_NEG_SUB] THEN MATCH_MP_TAC LIM_NEG THEN
        REWRITE_TAC [← GSYM SERIES_FROM] THEN
        SUBST1_TAC (← ARITH_RULE (← q r"n = (n + 1) - 1")) THEN
        REWRITE_TAC [← ARITH_RULE (← q r"(n + 1) - 1 + 1 = n + 1")] THEN
        MATCH_MP_TAC SUMS_OFFSET THEN ASM_SIMP_TAC [] THEN ARITH_TAC,
        REWRITE_TAC [NORM_NEG] THEN
        MATCH_MP_TAC EVENTUALLY_MONO THEN
        EXISTS_TAC
         (← q r"\m. sum(n + 1..m) (\q. &(dimindex (:N)) / &2 pow q) <= e / &2") THEN
        REWRITE_TAC [] THEN CONJ_TAC THENL
         [X_GEN_TAC (← q r"m:num") THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
          MATCH_MP_TAC VSUM_NORM_LE THEN ASM_SIMP_TAC [FINITE_NUMSEG],
          REWRITE_TAC [real_div, SUM_LMUL, SUM_GP, REAL_INV_POW] THEN
          REWRITE_TAC [← GSYM real_div] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
          MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"m:num") THEN
          REWRITE_TAC [] THEN COND_CASES_TAC THEN
          ASM_SIMP_TAC [REAL_HALF, REAL_MUL_RZERO, REAL_LT_IMP_LE] THEN
          TRANS_TAC REAL_LE_TRANS (← q r"&(dimindex (:N)) / &2 pow N") THEN
          ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
          REWRITE_TAC [real_div] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
          REWRITE_TAC [REAL_POS] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
          REWRITE_TAC [← GSYM ADD1, real_pow] THEN MATCH_MP_TAC (← REAL_ARITH
           (← q r"x <= a /\ &0 <= y ==> (&1 / &2 * x - &1 / &2 * y) * &2 <= a")) THEN
          REWRITE_TAC [real_div, REAL_MUL_LID, REAL_INV_POW] THEN
          SIMP_TAC [REAL_LE_INV_EQ, REAL_POW_LE, REAL_POS] THEN
          MATCH_MP_TAC REAL_POW_MONO_INV THEN ASM_REWRITE_TAC [] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV]],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"j:num") THEN FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC
       (← q r"\n x. vsum (0..n) (\m. (d:num->num->real^M->real^N) m j x)") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"i:num") THEN
        REWRITE_TAC [] THEN MATCH_MP_TAC BAIRE_VSUM THEN
        ASM_REWRITE_TAC [FINITE_NUMSEG, ETA_AX],
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        REMOVE_THEN "*" (MP_TAC o SPEC (← q r"e:real")) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        SIMP_TAC []],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN REWRITE_TAC [tendsto] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"((\n. vsum(0..n) (\m. (h:num->real^M->real^N) m x))
       --> (g(x) - f (r 0:num) x)) sequentially")
    MP_TAC THENL
     [EXPAND_TAC "h" THEN REWRITE_TAC [VSUM_DIFFS_ALT, LE_0] THEN
      MATCH_MP_TAC LIM_SUB THEN REWRITE_TAC [LIM_CONST] THEN
      ONCE_REWRITE_TAC [LIM_NULL] THEN
      MATCH_MP_TAC LIM_NULL_COMPARISON THEN
      EXISTS_TAC (← q r"\n. inv(&2 pow ((n + 1) + 1))") THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, EVENTUALLY_TRUE] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(n + 1) + 1 = 2 + n")] THEN
      REWRITE_TAC [REAL_POW_ADD, REAL_INV_MUL, LIFT_CMUL] THEN
      MATCH_MP_TAC LIM_NULL_CMUL THEN REWRITE_TAC [tendsto] THEN
      REWRITE_TAC [DIST_0, NORM_LIFT, REAL_INV_POW] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC ARCH_EVENTUALLY_POW_INV THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [tendsto] THEN REMOVE_THEN "*" MP_TAC THEN
    REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")] THEN
    REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    GEN_REWRITE_TAC LAND_CONV [EVENTUALLY_SEQUENTIALLY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") (MP_TAC o SPEC (← q r"N:num"))) THEN
    REWRITE_TAC [LE_REFL, IMP_CONJ] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
    ASM_REWRITE_TAC [IMP_IMP, LEFT_AND_FORALL_THM] THEN
    DISCH_THEN (LABEL_TAC "+") THEN
    SUBGOAL_THEN
     (← q r"((\i. vsum(0..N) (\m. (d:num->num->real^M->real^N) m i x) -
            vsum (0..N) (\m. h m x))
       --> vec 0) sequentially")
    MP_TAC THENL
     [REWRITE_TAC [← GSYM VSUM_SUB_NUMSEG] THEN
      MATCH_MP_TAC LIM_NULL_VSUM THEN
      ASM_SIMP_TAC [FINITE_NUMSEG, IN_NUMSEG, ← GSYM LIM_NULL],
      REWRITE_TAC [tendsto] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")]] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    X_GEN_TAC (← q r"i:num") THEN REMOVE_THEN "+" (MP_TAC o SPEC (← q r"i:num")) THEN
    REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t))

  return { BAIRE_UNIFORM_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Uniform approximation; preimages under Baire-1 functions.                 -/
/- (topology.ml 31819-31960)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BAI3 where
  BAIRE_UNIFORM_APPROXIMATION : thm
  FSIGMA_BAIRE1_PREIMAGE_OPEN_GEN : thm
  FSIGMA_BAIRE1_PREIMAGE_OPEN : thm
  GDELTA_BAIRE1_PREIMAGE_CLOSED : thm
  deriving Inhabited

@[nospecialize]
def setupBAI3 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLOC : LOC)
    (BCLS1 : CLS1) (BLIM1 : LIM1) (BIDC : IDC) (BCLC : CLC) (BHSP : HSP) (BSDS : SDS)
    (BSD2 : SD2) (BSD3 : SD3) (BFSG2 : FSG2) (BBAI1 : BAI1) (BBUL : BUL) :
    ExceptT String IO BAI3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, num_CONV, .. } := D
  let { CONJ_ASSOC, DIFF_UNIONS, EQ_TRANS, EXTENSION, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, IMP_CONJ, IMP_IMP,
        IN, INTERS_GSPEC, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LT_INV_EQ, .. } := D.core4
  let { REAL_LT_TRANS, RIGHT_EXISTS_AND_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET_UNIV, .. } := D.core5
  let { SWAP_EXISTS_THM, UNIONS_1, UNIONS_GSPEC, o_DEF, real_ge, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_PRODUCT_DEPENDENT, COUNTABLE_RESTRICT, COUNTABLE_SING,
        NUM_COUNTABLE, .. } := D.lib1
  let { RATIONAL_BETWEEN_EQ, RATIONAL_CLOSED, .. } := D.lib2
  let { COUNTABLE_RATIONAL, REAL_HALF, .. } := D.misc
  let { LIFT_DROP, .. } := D.vec2
  let { NORM_0, .. } := D.vec3
  let { VECTOR_SUB_REFL, drop, .. } := D.vec4
  let { ARCH_EVENTUALLY_INV1, CLOSED_IN_INTERS, .. } := D.met1
  let { EVENTUALLY_AND, EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, EVENTUALLY_TRUE, .. } := D.met2
  let { OPEN_IN_DIFF, SUBTOPOLOGY_UNIV, .. } := D.met3
  let { OPEN_IN, OPEN_IN_REFL, .. } := BEUC
  let { CLOSED_IN_REFL, OPEN_CLOSED, closed, .. } := BCLO
  let { OPEN_IN_OPEN, .. } := BLOC
  let { CLOSURE_CLOSED, .. } := BCLS1
  let { tendsto, .. } := BLIM1
  let { CONTINUOUS_ON_COMPOSE, .. } := BIDC
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, .. } := BCLC
  let { CLOSED_HALFSPACE_COMPONENT_GE, .. } := BHSP
  let { SETDIST_POS_LT, .. } := BSDS
  let { CONTINUOUS_ON_LIFT_SETDIST, SETDIST_SING_TRIANGLE, .. } := BSD2
  let { SETDIST_EQ_0_SING, .. } := BSD3
  let { CLOSED_IN_FSIGMA, FSIGMA_UNIONS, GDELTA_INTER, GDELTA_INTERS, OPEN_IN_GDELTA, .. } := BFSG2
  let { baire, .. } := BBAI1
  let { BAIRE_UNIFORM_LIMIT, .. } := BBUL
  -- @@SCOPE END

  let BAIRE_UNIFORM_APPROXIMATION ← prove
   r"!f:real^M->real^N s k.
        baire k s f <=>
        !e. &0 < e ==> ?g. baire k s g /\ !x. x IN s ==> norm(g x - f x) < e"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [EXISTS_TAC (← q r"f:real^M->real^N") THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0],
      FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)"))] THEN
    REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
    X_GEN_TAC (← q r"g:num->real^M->real^N") THEN STRIP_TAC THEN
    MATCH_MP_TAC BAIRE_UNIFORM_LIMIT THEN
    EXISTS_TAC (← q r"g:num->real^M->real^N") THEN
    ASM_REWRITE_TAC [EVENTUALLY_TRUE] THEN GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM ARCH_EVENTUALLY_INV1] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [] THEN ASM_MESON_TAC [REAL_LT_TRANS])

  let FSIGMA_BAIRE1_PREIMAGE_OPEN_GEN ← prove
   r"!f:real^M->real^N g s t u.
        IMAGE f s SUBSET t /\
        open_in (subtopology euclidean t) u /\
        (!n. (g n) continuous_on s) /\
        (!x. x IN s ==> ((\n. g n x) --> f x) sequentially)
        ==> ?c. COUNTABLE c /\
                (!t. t IN c ==> closed_in (subtopology euclidean s) t) /\
                UNIONS c = {x | x IN s /\ f(x) IN u}"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool")
     (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
    ASM_SIMP_TAC [← SET_RULE
     (← q r"IMAGE f s SUBSET t
      ==> (x IN s /\ f x IN t INTER v <=> x IN s /\ f x IN v)")] THEN
    ASM_CASES_TAC (← q r"v = (:real^N)") THENL
     [EXISTS_TAC (← q r"{s:real^M->bool}") THEN
      ASM_REWRITE_TAC [COUNTABLE_SING, UNIONS_1, IN_UNIV] THEN
      REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, CLOSED_IN_REFL] THEN SET_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC
     (← q r"{INTERS
         {{x | x IN s /\
               lift(setdist({(g:num->real^M->real^N) n x},(:real^N) DIFF v)) IN
               {x | drop x >= e}} |n|
          N <= n} |N,e| N IN (:num) /\ e IN {r | rational r /\ &0 < r}}") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_PRODUCT_DEPENDENT THEN
      REWRITE_TAC [NUM_COUNTABLE] THEN
      SIMP_TAC [← REWRITE_RULE [IN] COUNTABLE_RESTRICT, COUNTABLE_RATIONAL],
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"N:num", ← q r"e:real"] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [IN_UNIV, IN_ELIM_THM] THEN
      REWRITE_TAC [] THEN STRIP_TAC THEN MATCH_MP_TAC CLOSED_IN_INTERS THEN
      SIMP_TAC [LE_REFL, ← SET_RULE (← q r"N:num <= N ==> ~({f n | N <= n} = {})")] THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
      REWRITE_TAC [drop, CLOSED_HALFSPACE_COMPONENT_GE] THEN
      SUBGOAL_THEN
       (← q r"(\x. lift(setdist({g n x},(:real^N) DIFF v))) =
        (\y. lift(setdist({y},(:real^N) DIFF v))) o (g:num->real^M->real^N) n")
      SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_REWRITE_TAC [CONTINUOUS_ON_LIFT_SETDIST],
      GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:real^M") THEN
      REWRITE_TAC [UNIONS_GSPEC, INTERS_GSPEC, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_UNIV, LIFT_DROP] THEN
      ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_REWRITE_TAC [] THENL
       [REWRITE_TAC [real_ge], MESON_TAC [LE_REFL]] THEN
      TRANS_TAC EQ_TRANS
       (← q r"&0 < setdist({(f:real^M->real^N) x},(:real^N) DIFF v)") THEN
      CONJ_TAC THENL
       [GEN_REWRITE_TAC RAND_CONV [← GSYM RATIONAL_BETWEEN_EQ],
        REWRITE_TAC [SETDIST_POS_LT, SETDIST_EQ_0_SING] THEN
        ASM_SIMP_TAC [CLOSURE_CLOSED, ← GSYM OPEN_CLOSED] THEN ASM SET_TAC []] THEN
      GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
      REWRITE_TAC [RIGHT_EXISTS_AND_THM, ← GSYM EVENTUALLY_SEQUENTIALLY] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC] THEN MATCH_MP_TAC (← MESON
       [RATIONAL_CLOSED]
       (← q r"(!x. Q x ==> P(x / &2)) /\ (!x. P x ==> Q(x / &2))
        ==> ((?x. rational x /\ P x) <=> (?y. rational y /\ Q y))")) THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"q:real") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [tendsto] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"q / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, IMP_IMP] THENL
       [DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o
          MATCH_MP (← REAL_ARITH
         (← q r"q < d2 ==> abs(d1 - d2) <= x ==> x < q / &2 ==> q / &2 <= d1"))),
        REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
        REWRITE_TAC [LE_REFL] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs(d1 - d2) <= x ==> x < q / &2 /\ q <= d1 ==> q / &2 < d2"))] THEN
      REWRITE_TAC [SETDIST_SING_TRIANGLE]])

  let FSIGMA_BAIRE1_PREIMAGE_OPEN ← prove
   r"!f:real^M->real^N s u.
        fsigma s /\ open u /\ baire 1 s f
        ==> fsigma {x | x IN s /\ f(x) IN u}"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [← ExceptT.mk (num_CONV (← q r"1")), baire] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"g:num->real^M->real^N",
      ← q r"s:real^M->bool", ← q r"(:real^N)", ← q r"u:real^N->bool"]
     FSIGMA_BAIRE1_PREIMAGE_OPEN_GEN) THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:(real^M->bool)->bool")
     (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC FSIGMA_UNIONS THEN
    ASM_MESON_TAC [CLOSED_IN_FSIGMA])

  let GDELTA_BAIRE1_PREIMAGE_CLOSED ← prove
   r"!f:real^M->real^N s c.
        gdelta s /\ closed c /\ baire 1 s f
        ==> gdelta {x | x IN s /\ f(x) IN c}"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [← ExceptT.mk (num_CONV (← q r"1")), baire] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"g:num->real^M->real^N",
      ← q r"s:real^M->bool", ← q r"(:real^N)", ← q r"(:real^N) DIFF c"]
     FSIGMA_BAIRE1_PREIMAGE_OPEN_GEN) THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN] THEN
    ASM_REWRITE_TAC [← GSYM closed, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"d:(real^M->bool)->bool") THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN s /\ f x IN c} = s DIFF {x | x IN s /\ f x IN UNIV DIFF c}")] THEN
    ASM_REWRITE_TAC [DIFF_UNIONS] THEN
    MATCH_MP_TAC GDELTA_INTER THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC GDELTA_INTERS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"u:real^M->bool") THEN DISCH_TAC THEN
    MATCH_MP_TAC OPEN_IN_GDELTA THEN EXISTS_TAC (← q r"s:real^M->bool") THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL])

  return { BAIRE_UNIFORM_APPROXIMATION, FSIGMA_BAIRE1_PREIMAGE_OPEN_GEN,
           FSIGMA_BAIRE1_PREIMAGE_OPEN, GDELTA_BAIRE1_PREIMAGE_CLOSED }

/- ------------------------------------------------------------------------- -/
/- Delta_n sets (defined via "baire" on indicator, not a special constant).  -/
/- We can then express Sigma_n and Pi_n using "COUNTABLE UNION_OF ..." and   -/
/- "COUNTABLE INTERSECTION_OF ...". While a bit verbose, and breaking down   -/
/- for the 0 case, it is adequate for use in occasional lemmas.              -/
/- (topology.ml 31961-32092)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BIN1 where
  BAIRE_INDICATOR_EMPTY : thm
  BAIRE_INDICATOR_UNIV : thm
  BAIRE_INDICATOR_REFL : thm
  BAIRE_INDICATOR_COMPLEMENT : thm
  BAIRE_INDICATOR_COMPLEMENT_UNIV : thm
  BAIRE_INDICATOR_INTER : thm
  BAIRE_INDICATOR_UNION : thm
  BAIRE_INDICATOR_DIFF : thm
  BAIRE_INDICATOR_INTERS : thm
  BAIRE_INDICATOR_UNIONS : thm
  BAIRE0_INDICATOR : thm
  COUNTABLE_UNION_OF_BAIRE0_INDICATOR : thm
  COUNTABLE_INTERSECTION_OF_BAIRE0_INDICATOR : thm
  deriving Inhabited

@[nospecialize]
def setupBIN1 [HolBase] (D : TopologyDeps) (BCON : CON) (BCMS : CMS) (BCRD2 : CRD2)
    (BBAI1 : BAI1) : ExceptT String IO BIN1 := do
  -- @@SCOPE BEGIN
  let { SET_TAC, NUM_REDUCE_CONV, .. } := D
  let { EQ_IMP, ETA_AX, EXTENSION, FINITE_EMPTY, FINITE_INDUCT_STRONG, FINITE_INSERT, .. } :=
    D.core1
  let { FINITE_SUBSET, FORALL_IN_INSERT, FUN_EQ_THM, IMP_CONJ, IMP_IMP, INTERSECTION_OF,
        INTERS_0, INTERS_INSERT, IN_DIFF, IN_INTER, .. } := D.core2
  let { IN_UNION, IN_UNIV, NOT_IN_EMPTY, .. } := D.core3
  let { SWAP_FORALL_THM, UNIONS_0, UNIONS_INSERT, UNION_OF, o_THM, .. } := D.core6
  let { COUNTABLE_INTERSECTION_OF_INC, COUNTABLE_UNION_OF_INC, .. } := D.lib1
  let { DROP_VEC, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_ADD_SUB, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_MUL_RZERO, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, VEC_EQ, indicator, .. } := D.vec4
  let { CONNECTED_UNIV, .. } := BCON
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_FINITE_RANGE_CONSTANT, .. } := BCRD2
  let { BAIRE_ADD, BAIRE_CONST, BAIRE_EQ, BAIRE_MUL, BAIRE_SUB, baire, .. } := BBAI1
  -- @@SCOPE END

  let BAIRE_INDICATOR_EMPTY ← prove
   r"!n. baire n u (indicator {})"
   (REWRITE_TAC [indicator, NOT_IN_EMPTY, BAIRE_CONST])

  let BAIRE_INDICATOR_UNIV ← prove
   r"!n. baire n u (indicator (:real^N))"
   (REWRITE_TAC [indicator, IN_UNIV, BAIRE_CONST])

  let BAIRE_INDICATOR_REFL ← prove
   r"!u:real^N->bool n. baire n u (indicator u)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC BAIRE_EQ THEN
    EXISTS_TAC (← q r"indicator(:real^N)") THEN CONJ_TAC THEN
    SIMP_TAC [indicator, IN_UNIV, BAIRE_CONST])

  let BAIRE_INDICATOR_COMPLEMENT ← prove
   r"!u s:real^N->bool n.
        baire n u (indicator(u DIFF s)) <=>
        baire n u (indicator s)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"n:num", ← q r"vec 1:real^1"]
          BAIRE_CONST) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP BAIRE_SUB) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] BAIRE_EQ) THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    REWRITE_TAC [indicator, IN_DIFF, IN_UNIV] THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
    ASM_REWRITE_TAC [VECTOR_SUB_REFL, VECTOR_SUB_RZERO])

  let BAIRE_INDICATOR_COMPLEMENT_UNIV ← prove
   r"!u s n.
        baire n u (indicator((:real^N) DIFF s)) <=> baire n u (indicator s)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM BAIRE_INDICATOR_COMPLEMENT] THEN
    EQ_TAC THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] BAIRE_EQ) THEN
    SIMP_TAC [indicator, IN_DIFF, IN_UNIV])

  let BAIRE_INDICATOR_INTER ← prove
   r"!u s t:real^N->bool n.
        baire n u (indicator s) /\ baire n u (indicator t)
        ==> baire n u (indicator(s INTER t))"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
    ONCE_REWRITE_TAC [← GSYM LIFT_DROP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP BAIRE_MUL) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [indicator, FUN_EQ_THM, IN_INTER] THEN
    X_GEN_TAC (← q r"x:real^N") THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^N) IN s", ← q r"(x:real^N) IN t"] THEN
    ASM_REWRITE_TAC [DROP_VEC, VECTOR_MUL_LZERO, VECTOR_MUL_LID] THEN
    REWRITE_TAC [VECTOR_MUL_RZERO])

  let BAIRE_INDICATOR_UNION ← prove
   r"!u s t:real^N->bool n.
        baire n u (indicator s) /\ baire n u (indicator t)
        ==> baire n u (indicator(s UNION t))"
   (REPEAT GEN_TAC THEN DISCH_THEN (fun th => tactic_of do
     pure (MP_TAC (← MATCH_MP BAIRE_INDICATOR_INTER th) THEN
           MP_TAC (← MATCH_MP BAIRE_ADD th))) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP BAIRE_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [indicator, FUN_EQ_THM, IN_INTER, IN_UNION] THEN
    X_GEN_TAC (← q r"x:real^N") THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^N) IN s", ← q r"(x:real^N) IN t"] THEN
    ASM_REWRITE_TAC [DROP_VEC, VECTOR_SUB_RZERO, VECTOR_ADD_RID, VECTOR_ADD_LID,
                     VECTOR_ADD_SUB])

  let BAIRE_INDICATOR_DIFF ← prove
   r"!u s t:real^N->bool n.
        baire n u (indicator s) /\ baire n u (indicator t)
        ==> baire n u (indicator(s DIFF t))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BAIRE_EQ THEN
    EXISTS_TAC (← q r"indicator(s INTER (u DIFF t):real^N->bool)") THEN
    ASM_SIMP_TAC [BAIRE_INDICATOR_INTER, BAIRE_INDICATOR_COMPLEMENT] THEN
    SIMP_TAC [indicator, IN_INTER, IN_DIFF, IN_UNIV, IN_UNIV])

  let BAIRE_INDICATOR_INTERS ← prove
   r"!f n. FINITE f /\
         (!s. s IN f ==> baire n u (indicator s))
         ==> baire n u (indicator(INTERS f))"
   (GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [FORALL_IN_INSERT, INTERS_0, INTERS_INSERT] THEN
    ASM_SIMP_TAC [BAIRE_INDICATOR_UNIV, BAIRE_INDICATOR_INTER])

  let BAIRE_INDICATOR_UNIONS ← prove
   r"!f n. FINITE f /\
         (!s. s IN f ==> baire n u (indicator s))
         ==> baire n u (indicator(UNIONS f))"
   (GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [FORALL_IN_INSERT, UNIONS_0, UNIONS_INSERT] THEN
    ASM_SIMP_TAC [BAIRE_INDICATOR_EMPTY, BAIRE_INDICATOR_UNION])

  let BAIRE0_INDICATOR ← prove
   r"!s. baire 0 (:real^N) (indicator s) <=> s = {} \/ s = (:real^N)"
   (GEN_TAC THEN REWRITE_TAC [baire] THEN EQ_TAC THENL
     [DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"indicator(s:real^N->bool)", ← q r"(:real^N)"]
       CONTINUOUS_FINITE_RANGE_CONSTANT) THEN
      ASM_REWRITE_TAC [CONNECTED_UNIV, IN_UNIV, EXTENSION, NOT_IN_EMPTY] THEN
      REWRITE_TAC [indicator] THEN ANTS_TAC THENL
       [MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{vec 0:real^1,vec 1}") THEN
        REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY] THEN SET_TAC [],
        SUBGOAL_THEN (← q r"~(vec 0:real^1 = vec 1)") MP_TAC THENL
         [REWRITE_TAC [VEC_EQ] THEN CONV_TAC NUM_REDUCE_CONV, SET_TAC []]],
      STRIP_TAC THEN ASM_REWRITE_TAC [indicator, IN_UNIV, NOT_IN_EMPTY] THEN
      REWRITE_TAC [CONTINUOUS_ON_CONST]])

  let COUNTABLE_UNION_OF_BAIRE0_INDICATOR ← prove
   r"!s. (COUNTABLE UNION_OF baire 0 (:real^N) o indicator) s <=>
       s = {} \/ s = (:real^N)"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [UNION_OF, o_THM, BAIRE0_INDICATOR] THEN SET_TAC [],
      DISCH_TAC THEN MATCH_MP_TAC COUNTABLE_UNION_OF_INC THEN
      ASM_REWRITE_TAC [BAIRE0_INDICATOR, o_THM]])

  let COUNTABLE_INTERSECTION_OF_BAIRE0_INDICATOR ← prove
   r"!s. (COUNTABLE INTERSECTION_OF baire 0 (:real^N) o indicator) s <=>
       s = {} \/ s = (:real^N)"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [INTERSECTION_OF, o_THM, BAIRE0_INDICATOR] THEN SET_TAC [],
      DISCH_TAC THEN MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INC THEN
      ASM_REWRITE_TAC [BAIRE0_INDICATOR, o_THM]])

  return { BAIRE_INDICATOR_EMPTY, BAIRE_INDICATOR_UNIV, BAIRE_INDICATOR_REFL,
           BAIRE_INDICATOR_COMPLEMENT, BAIRE_INDICATOR_COMPLEMENT_UNIV, BAIRE_INDICATOR_INTER,
           BAIRE_INDICATOR_UNION, BAIRE_INDICATOR_DIFF, BAIRE_INDICATOR_INTERS,
           BAIRE_INDICATOR_UNIONS, BAIRE0_INDICATOR, COUNTABLE_UNION_OF_BAIRE0_INDICATOR,
           COUNTABLE_INTERSECTION_OF_BAIRE0_INDICATOR }

/- ------------------------------------------------------------------------- -/
/- Baire-1 indicators, F_sigma and G_delta sets; continuous preimages.       -/
/- (topology.ml 32093-32195)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BIN2 where
  BAIRE1_INDICATOR : thm
  GDELTA_BAIRE : thm
  FSIGMA_BAIRE : thm
  CLOSED_IMP_BAIRE1_INDICATOR : thm
  OPEN_IMP_BAIRE1_INDICATOR : thm
  BAIRE_INDICATOR_CONTINUOUS_PREIMAGE : thm
  BAIRE_INDICATOR_CONTINUOUS_PREIMAGE_UNIV : thm
  deriving Inhabited

@[nospecialize]
def setupBIN2 [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLIM2 : LIM2) (BCPT : CPT)
    (BCPP2 : CPP2) (BURY : URY) (BFSG1 : FSG1) (BFSG2 : FSG2) (BBAI1 : BAI1) (BBAI3 : BAI3) :
    ExceptT String IO BIN2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, NUM_REDUCE_CONV, num_CONV, .. } := D
  let { ETA_AX, EXTENSION, .. } := D.core1
  let { FORALL_AND_THM, INTERSECTION_OF, IN_DELETE, IN_DIFF, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core3
  let { SKOLEM_THM, SUBSET_REFL, SUBSET_TRANS, SUBSET_UNIV, .. } := D.core5
  let { TRANSITIVE_STEPWISE_LE, UNION_OF, o_THM, .. } := D.core6
  let { VEC_EQ, indicator, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { OPEN_UNIV, .. } := BEUC
  let { LIM_EVENTUALLY, .. } := BLIM2
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { OPEN_DELETE, .. } := BCPP2
  let { URYSOHN, .. } := BURY
  let { CLOSED_IMP_FSIGMA, CLOSED_IMP_GDELTA, FSIGMA_ASCENDING, FSIGMA_COMPLEMENT, FSIGMA_UNIV,
        OPEN_IMP_FSIGMA, OPEN_IMP_GDELTA, fsigma, gdelta, .. } := BFSG1
  let { FSIGMA_UNIONS, GDELTA_INTERS, .. } := BFSG2
  let { BAIRE_COMPOSE_CONTINUOUS, BAIRE_EQ, BAIRE_SUBSET, baire, .. } := BBAI1
  let { FSIGMA_BAIRE1_PREIMAGE_OPEN, .. } := BBAI3
  -- @@SCOPE END

  let BAIRE1_INDICATOR ← prove
   r"!s. baire 1 (:real^N) (indicator s) <=> fsigma s /\ gdelta s"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [REWRITE_TAC [← GSYM FSIGMA_COMPLEMENT] THEN CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"s = {x | x IN (:real^N) /\
                               indicator s x IN (UNIV DELETE vec 0)}")
        SUBST1_TAC THENL
         [REWRITE_TAC [EXTENSION, IN_ELIM_THM, indicator, IN_UNIV, IN_DELETE] THEN
          X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
          ASM_REWRITE_TAC [VEC_EQ] THEN CONV_TAC NUM_REDUCE_CONV,
          ALL_TAC],
        SUBGOAL_THEN (← q r"(:real^N) DIFF s =
                      {x | x IN (:real^N) /\
                           indicator s x IN (UNIV DELETE vec 1)}")
        SUBST1_TAC THENL
         [REWRITE_TAC [EXTENSION, IN_ELIM_THM, indicator, IN_UNIV, IN_DELETE] THEN
          X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
          ASM_REWRITE_TAC [VEC_EQ, IN_DIFF, IN_UNIV] THEN
          CONV_TAC NUM_REDUCE_CONV,
          ALL_TAC]] THEN
      MATCH_MP_TAC FSIGMA_BAIRE1_PREIMAGE_OPEN THEN
      ASM_SIMP_TAC [ETA_AX, FSIGMA_UNIV, OPEN_DELETE, OPEN_UNIV],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM FSIGMA_COMPLEMENT]) THEN
      POP_ASSUM MP_TAC THEN
      REWRITE_TAC [FSIGMA_ASCENDING, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:num->real^N->bool") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"d:num->real^N->bool") THEN STRIP_TAC THEN
      REWRITE_TAC [← ExceptT.mk (num_CONV (← q r"1")), baire] THEN
      SUBGOAL_THEN
       (← q r"!n:num. ?f:real^N->real^1.
          f continuous_on UNIV /\
          (!x. x IN c n ==> f x = vec 1) /\
          (!x. x IN d n ==> f x = vec 0)")
      MP_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN MP_TAC (← ISPECL
         [← q r"(c:num->real^N->bool) n", ← q r"(d:num->real^N->bool) n",
          ← q r"vec 1:real^1", ← q r"vec 0:real^1"] URYSOHN) THEN
        ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
        ANTS_TAC THENL [ASM SET_TAC [], MESON_TAC []],
        REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:num->real^N->real^1") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [IN_UNIV] THEN
        X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [indicator] THEN
        COND_CASES_TAC THEN MATCH_MP_TAC LIM_EVENTUALLY THENL
         [SUBGOAL_THEN (← q r"?n. x IN (c:num->real^N->bool) n") MP_TAC THENL
           [ASM SET_TAC [], ALL_TAC],
          SUBGOAL_THEN (← q r"?n. x IN (d:num->real^N->bool) n") MP_TAC THENL
           [ASM SET_TAC [], ALL_TAC]] THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN MATCH_MP_TAC MONO_EXISTS THENL
         [SUBGOAL_THEN
           (← q r"!m n. m <= n ==> (c:num->real^N->bool) m SUBSET c n")
          MP_TAC THENL [ALL_TAC, ASM SET_TAC []],
          SUBGOAL_THEN
           (← q r"!m n. m <= n ==> (d:num->real^N->bool) m SUBSET d n")
          MP_TAC THENL [ALL_TAC, ASM SET_TAC []]] THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
        ASM_REWRITE_TAC [SUBSET_REFL, SUBSET_TRANS]]])

  let GDELTA_BAIRE ← prove
   r"!s. gdelta s <=>
       (COUNTABLE INTERSECTION_OF baire 1 (:real^N) o indicator) s"
   (GEN_TAC THEN REWRITE_TAC [INTERSECTION_OF, o_THM] THEN EQ_TAC THENL
     [REWRITE_TAC [gdelta, INTERSECTION_OF] THEN MATCH_MP_TAC MONO_EXISTS THEN
      SIMP_TAC [BAIRE1_INDICATOR, OPEN_IMP_FSIGMA, OPEN_IMP_GDELTA],
      REWRITE_TAC [BAIRE1_INDICATOR] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN MATCH_MP_TAC GDELTA_INTERS THEN
      ASM_SIMP_TAC []])

  let FSIGMA_BAIRE ← prove
   r"!s. fsigma s <=> (COUNTABLE UNION_OF baire 1 (:real^N) o indicator) s"
   (GEN_TAC THEN REWRITE_TAC [UNION_OF, o_THM] THEN EQ_TAC THENL
     [REWRITE_TAC [fsigma, UNION_OF] THEN MATCH_MP_TAC MONO_EXISTS THEN
      SIMP_TAC [BAIRE1_INDICATOR, CLOSED_IMP_FSIGMA, CLOSED_IMP_GDELTA],
      REWRITE_TAC [BAIRE1_INDICATOR] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN MATCH_MP_TAC FSIGMA_UNIONS THEN
      ASM_SIMP_TAC []])

  let CLOSED_IMP_BAIRE1_INDICATOR ← prove
   r"!s. closed s ==> baire 1 (:real^N) (indicator s)"
   (SIMP_TAC [BAIRE1_INDICATOR, CLOSED_IMP_FSIGMA, CLOSED_IMP_GDELTA])

  let OPEN_IMP_BAIRE1_INDICATOR ← prove
   r"!s. open s ==> baire 1 (:real^N) (indicator s)"
   (SIMP_TAC [BAIRE1_INDICATOR, OPEN_IMP_FSIGMA, OPEN_IMP_GDELTA])

  let BAIRE_INDICATOR_CONTINUOUS_PREIMAGE ← prove
   r"!f:real^M->real^N s t u k.
        baire k u (indicator t) /\ f continuous_on s /\ IMAGE f s SUBSET u
        ==> baire k s (indicator {x | x IN s /\ f x IN t})"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BAIRE_EQ THEN
    EXISTS_TAC (← q r"indicator t o (f:real^M->real^N)") THEN CONJ_TAC THENL
     [SIMP_TAC [indicator, IN_ELIM_THM, o_THM], ALL_TAC] THEN
    MATCH_MP_TAC BAIRE_COMPOSE_CONTINUOUS THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [BAIRE_SUBSET])

  let BAIRE_INDICATOR_CONTINUOUS_PREIMAGE_UNIV ← prove
   r"!f s k. baire k (:real^N) (indicator s) /\ f continuous_on (:real^M)
           ==> baire k (:real^M) (indicator {x | f x IN s})"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | f x IN s} = {x | x IN UNIV /\ f x IN s}")] THEN
    MATCH_MP_TAC BAIRE_INDICATOR_CONTINUOUS_PREIMAGE THEN
    ASM_MESON_TAC [SUBSET_UNIV])

  return { BAIRE1_INDICATOR, GDELTA_BAIRE, FSIGMA_BAIRE, CLOSED_IMP_BAIRE1_INDICATOR,
           OPEN_IMP_BAIRE1_INDICATOR, BAIRE_INDICATOR_CONTINUOUS_PREIMAGE,
           BAIRE_INDICATOR_CONTINUOUS_PREIMAGE_UNIV }

/- ------------------------------------------------------------------------- -/
/- Baire indicators under translations and linear maps.                      -/
/- (topology.ml 32196-32309)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BIN3 where
  BAIRE_INDICATOR_TRANSLATION : thm
  BAIRE_INDICATOR_INJECTIVE_LINEAR_IMAGE : thm
  BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE : thm
  COUNTABLE_UNION_OF_BAIRE_INDICATOR_TRANSLATION : thm
  COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR_TRANSLATION : thm
  COUNTABLE_UNION_OF_BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE : thm
  COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupBIN3 [HolBase] (D : TopologyDeps) (BCMS : CMS) (BIDC : IDC) (BLCP : LCP)
    (BCSB1 : CSB1) (BBAI1 : BAI1) (BBIN1 : BIN1) (BBIN2 : BIN2) : ExceptT String IO BIN3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH, add_linear_invariants,
        add_translation_invariants, .. } := D
  let { EXISTS_REFL, EXTENSION, .. } := D.core1
  let { FUN_EQ_THM, IN_ELIM_THM, .. } := D.core2
  let { I_THM, LEFT_IMP_EXISTS_THM, LE_1, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, .. } := D.core5
  let { SWAP_FORALL_THM, o_THM, .. } := D.core6
  let { COUNTABLE_INTERSECTION_OF_BIJECTIVE_IMAGE, COUNTABLE_UNION_OF_BIJECTIVE_IMAGE, .. } :=
    D.vec1
  let { IN_TRANSLATION_GALOIS, LINEAR_INJECTIVE_LEFT_INVERSE, .. } := D.vec2
  let { SUBSPACE_LINEAR_IMAGE, SUBSPACE_UNIV, .. } := D.vec3
  let { VECTOR_ADD_SUB, .. } := D.vec4
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_SUBSPACE, .. } := BCSB1
  let { BAIRE_MONO, .. } := BBAI1
  let { BAIRE0_INDICATOR, BAIRE_INDICATOR_INTER, .. } := BBIN1
  let { BAIRE_INDICATOR_CONTINUOUS_PREIMAGE_UNIV, CLOSED_IMP_BAIRE1_INDICATOR, .. } := BBIN2
  -- @@SCOPE END

  let BAIRE_INDICATOR_TRANSLATION ← prove
   r"!a s k. baire k (:real^N) (indicator (IMAGE (\x. a + x) s)) <=>
           baire k (:real^N) (indicator s)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"s = {x:real^N | a + x IN IMAGE (\x. a + x) s}")
      SUBST1_TAC THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"(!x y. f x = f y ==> x = y) ==> s = {x | f x IN IMAGE f s}")) THEN
        CONV_TAC (fun t => VECTOR_ARITH t),
        MATCH_MP_TAC BAIRE_INDICATOR_CONTINUOUS_PREIMAGE_UNIV THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST]],
      SUBGOAL_THEN (← q r"IMAGE (\x:real^N. a + x) s = {x | x - a IN s}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_TRANSLATION_GALOIS, IN_ELIM_THM],
        MATCH_MP_TAC BAIRE_INDICATOR_CONTINUOUS_PREIMAGE_UNIV THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_ID,
                      CONTINUOUS_ON_CONST]]])

  let BAIRE_INDICATOR_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f s k.
        1 <= k /\ linear f /\ (!x y. f x = f y ==> x = y)
        ==> (baire k (:real^N) (indicator (IMAGE f s)) <=>
             baire k (:real^M) (indicator s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"s = {x | (f:real^M->real^N) x IN IMAGE f s}")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC BAIRE_INDICATOR_CONTINUOUS_PREIMAGE_UNIV THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON],
      SUBGOAL_THEN (← q r"?g:real^N->real^M. linear g /\ g o f = I") MP_TAC THENL
       [ASM_MESON_TAC [LINEAR_INJECTIVE_LEFT_INVERSE], ALL_TAC] THEN
      REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"g:real^N->real^M") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"IMAGE (f:real^M->real^N) s = IMAGE f UNIV INTER {x | g x IN s}")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC BAIRE_INDICATOR_INTER THEN
      ASM_SIMP_TAC [BAIRE_INDICATOR_CONTINUOUS_PREIMAGE_UNIV,
                    LINEAR_CONTINUOUS_ON] THEN
      MATCH_MP_TAC BAIRE_MONO THEN EXISTS_TAC (← q r"1") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSED_IMP_BAIRE1_INDICATOR THEN
      MATCH_MP_TAC CLOSED_SUBSPACE THEN MATCH_MP_TAC SUBSPACE_LINEAR_IMAGE THEN
      ASM_REWRITE_TAC [SUBSPACE_UNIV]])

  let BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE ← prove
   r"!f s k.
        linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
        ==> (baire k (:real^N) (indicator (IMAGE f s)) <=>
             baire k (:real^M) (indicator s))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"k = 0") THENL
     [ASM_REWRITE_TAC [BAIRE0_INDICATOR] THEN ASM SET_TAC [],
      MATCH_MP_TAC BAIRE_INDICATOR_INJECTIVE_LINEAR_IMAGE THEN
      ASM_MESON_TAC [LE_1]])

  add_translation_invariants [BAIRE_INDICATOR_TRANSLATION]

  add_linear_invariants [BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE]

  let COUNTABLE_UNION_OF_BAIRE_INDICATOR_TRANSLATION ← prove
   r"!a s k. (COUNTABLE UNION_OF baire k (:real^N) o indicator)
           (IMAGE (\x. a + x) s) <=>
           (COUNTABLE UNION_OF baire k (:real^N) o indicator) s"
   (GEN_TAC THEN GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC COUNTABLE_UNION_OF_BIJECTIVE_IMAGE THEN
    REWRITE_TAC [o_THM, BAIRE_INDICATOR_TRANSLATION] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = y <=> x = y - a"), EXISTS_REFL] THEN
    REWRITE_TAC [VECTOR_ADD_SUB])

  add_translation_invariants [COUNTABLE_UNION_OF_BAIRE_INDICATOR_TRANSLATION]

  let COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR_TRANSLATION ← prove
   r"!a s k. (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator)
           (IMAGE (\x. a + x) s) <=>
           (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) s"
   (GEN_TAC THEN GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_BIJECTIVE_IMAGE THEN
    REWRITE_TAC [o_THM, BAIRE_INDICATOR_TRANSLATION] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = y <=> x = y - a"), EXISTS_REFL] THEN
    REWRITE_TAC [VECTOR_ADD_SUB])

  add_translation_invariants
    [COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR_TRANSLATION]

  let COUNTABLE_UNION_OF_BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE ← prove
   r"!f s k.
        linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
        ==> ((COUNTABLE UNION_OF baire k (:real^N) o indicator) (IMAGE f s) <=>
             (COUNTABLE UNION_OF baire k (:real^M) o indicator) s)"
   (GEN_TAC THEN GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC COUNTABLE_UNION_OF_BIJECTIVE_IMAGE THEN
    ASM_REWRITE_TAC [o_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE THEN
    ASM_REWRITE_TAC [])

  add_linear_invariants
   [COUNTABLE_UNION_OF_BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE]

  let COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE ← prove
   r"!f s k.
        linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
        ==> ((COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator)
             (IMAGE f s) <=>
             (COUNTABLE INTERSECTION_OF baire k (:real^M) o indicator) s)"
   (GEN_TAC THEN GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_BIJECTIVE_IMAGE THEN
    ASM_REWRITE_TAC [o_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE THEN
    ASM_REWRITE_TAC [])

  add_linear_invariants
   [COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE]

  return { BAIRE_INDICATOR_TRANSLATION, BAIRE_INDICATOR_INJECTIVE_LINEAR_IMAGE,
           BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE,
           COUNTABLE_UNION_OF_BAIRE_INDICATOR_TRANSLATION,
           COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR_TRANSLATION,
           COUNTABLE_UNION_OF_BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE,
           COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR_BIJECTIVE_LINEAR_IMAGE }

/- ------------------------------------------------------------------------- -/
/- The reduction theorem for Sigma_n sets and consequences.                  -/
/- (topology.ml 32310-32346)                                                 -/
/- ------------------------------------------------------------------------- -/

structure FSR where
  FSIGMA_REDUCTION_GEN_ALT : thm
  FSIGMA_REDUCTION_GEN_2 : thm
  FSIGMA_REDUCTION : thm
  deriving Inhabited

@[nospecialize]
def setupFSR [HolBase] (D : TopologyDeps) (BBIN1 : BIN1) (BBIN2 : BIN2) :
    ExceptT String IO FSR := do
  -- @@SCOPE BEGIN
  let { MESON, .. } := D
  let { SWAP_FORALL_THM, o_THM, .. } := D.core6
  let { GENERAL_REDUCTION_THEOREM, GENERAL_REDUCTION_THEOREM_2, .. } := D.misc
  let { BAIRE_INDICATOR_DIFF, BAIRE_INDICATOR_EMPTY, BAIRE_INDICATOR_UNION, .. } := BBIN1
  let { FSIGMA_BAIRE, .. } := BBIN2
  -- @@SCOPE END

  let FSIGMA_REDUCTION_GEN_ALT ← prove
   r"!s:num->real^N->bool k.
     (!n. (COUNTABLE UNION_OF baire k (:real^N) o indicator) (s n))
     ==> ?t. (!n. (COUNTABLE UNION_OF baire k (:real^N) o indicator) (t n)) /\
             (!n. t n SUBSET s n) /\
             pairwise (\m n. DISJOINT (t m) (t n)) (:num) /\
             UNIONS {t n | n IN (:num)} = UNIONS {s n | n IN (:num)}"
   (GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC GENERAL_REDUCTION_THEOREM THEN
    REWRITE_TAC [o_THM, BAIRE_INDICATOR_EMPTY,
                 BAIRE_INDICATOR_UNION, BAIRE_INDICATOR_DIFF])

  let FSIGMA_REDUCTION_GEN_2 ← prove
   r"!s t k.
       (COUNTABLE UNION_OF baire k (:real^N) o indicator) s /\
       (COUNTABLE UNION_OF baire k (:real^N) o indicator) t
       ==> ?s' t'. (COUNTABLE UNION_OF baire k (:real^N) o indicator) s' /\
                   (COUNTABLE UNION_OF baire k (:real^N) o indicator) t' /\
                   s' SUBSET s /\ t' SUBSET t /\ DISJOINT s' t' /\
                   s' UNION t' = s UNION t"
   (ONCE_REWRITE_TAC [← MESON [] (← q r"(!s t k. P s t k) <=> (!k s t. P s t k)")] THEN
    GEN_TAC THEN MATCH_MP_TAC GENERAL_REDUCTION_THEOREM_2 THEN
    REWRITE_TAC [o_THM, BAIRE_INDICATOR_EMPTY,
                 BAIRE_INDICATOR_UNION, BAIRE_INDICATOR_DIFF])

  let FSIGMA_REDUCTION ← prove
   r"!s:num->real^N->bool.
        (!n. fsigma(s n))
        ==> ?t. (!n. fsigma(t n)) /\
                (!n. t n SUBSET s n) /\
                pairwise (\m n. DISJOINT (t m) (t n)) (:num) /\
                UNIONS {t n | n IN (:num)} = UNIONS {s n | n IN (:num)}"
   (REWRITE_TAC [FSIGMA_BAIRE, FSIGMA_REDUCTION_GEN_ALT])

  return { FSIGMA_REDUCTION_GEN_ALT, FSIGMA_REDUCTION_GEN_2, FSIGMA_REDUCTION }

/- ------------------------------------------------------------------------- -/
/- Baire indicators at successor levels, Delta_n sets, reduction and         -/
/- separation.  (topology.ml 32347-32655)                                    -/
/- ------------------------------------------------------------------------- -/

structure BIS where
  BAIRE_INDICATOR_SUC : thm
  BAIRE_INDICATOR_DELTA : thm
  FGSIGMA_BAIRE_PREIMAGE_OPEN_ALT : thm
  FSIGMA_REDUCTION_GEN : thm
  GDELTA_SEPARATION_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupBIS [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BLPT : LPT)
    (BCLS1 : CLS1) (BLIM1 : LIM1) (BLIM2 : LIM2) (BHSP : HSP) (BSDS : SDS) (BSD2 : SD2)
    (BSD3 : SD3) (BFSG1 : FSG1) (BBAI1 : BAI1) (BBAI3 : BAI3) (BBIN1 : BIN1) (BBIN2 : BIN2)
    (BFSR : FSR) : ExceptT String IO BIS := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, MESON, METIS, REAL_ARITH, SET_RULE, SET_TAC,
        NUM_REDUCE_CONV, .. } := D
  let { ADD1, AND_FORALL_THM, ARITH, ARITH_EQ, COMPL_COMPL, CONJ_ASSOC,
        DIFF_UNIONS_PAIRWISE_DISJOINT, EQ_TRANS, ETA_AX, EXTENSION, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN,
        INTERSECTION_OF_MONO, INTERS_GSPEC, IN_DIFF, IN_ELIM_THM, IN_SING, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_AND, MONO_EXISTS, MONO_FORALL,
        PAIRWISE_IMAGE, PAIRWISE_IMP, .. } := D.core3
  let { REAL_NOT_LE, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE,
        SIMPLE_IMAGE_GEN, SKOLEM_THM, .. } := D.core5
  let { SWAP_EXISTS_THM, SWAP_FORALL_THM, TRANSITIVE_STEPWISE_LE, UNIONS_1, UNIONS_GSPEC,
        UNION_OF, UNION_OF_MONO, UNIV_GSPEC, num_CASES, num_INDUCTION, o_DEF, o_THM,
        real_ge, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_INTERSECTION_OF_COMPLEMENT,
        COUNTABLE_INTERSECTION_OF_IDEMPOT, COUNTABLE_INTERSECTION_OF_INC,
        COUNTABLE_INTERSECTION_OF_INTERS, COUNTABLE_INTERSECTION_OF_UNION,
        COUNTABLE_PRODUCT_DEPENDENT, COUNTABLE_RESTRICT, COUNTABLE_SUBSET,
        COUNTABLE_SUBSET_NUM, COUNTABLE_UNION_OF_ASCENDING, COUNTABLE_UNION_OF_COMPLEMENT,
        COUNTABLE_UNION_OF_IDEMPOT, COUNTABLE_UNION_OF_INC, COUNTABLE_UNION_OF_UNIONS,
        NUM_COUNTABLE, .. } := D.lib1
  let { RATIONAL_BETWEEN_EQ, RATIONAL_CLOSED, .. } := D.lib2
  let { COUNTABLE_RATIONAL, REAL_HALF, .. } := D.misc
  let { LIFT_DROP, .. } := D.vec2
  let { VEC_EQ, drop, indicator, .. } := D.vec4
  let { EVENTUALLY_AND, EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { OPEN_UNIV, .. } := BEUC
  let { OPEN_CLOSED, OPEN_DIFF, .. } := BCLO
  let { CLOSED_SING, .. } := BLPT
  let { CLOSURE_CLOSED, .. } := BCLS1
  let { tendsto, .. } := BLIM1
  let { LIM_EVENTUALLY, .. } := BLIM2
  let { OPEN_HALFSPACE_COMPONENT_LT, .. } := BHSP
  let { SETDIST_POS_LT, .. } := BSDS
  let { CONTINUOUS_ON_LIFT_SETDIST, SETDIST_SING_TRIANGLE, .. } := BSD2
  let { SETDIST_EQ_0_SING, .. } := BSD3
  let { FSIGMA_UNIV, .. } := BFSG1
  let { BAIRE_CONTINUOUS_COMPOSE_UNIV, baire, .. } := BBAI1
  let { FSIGMA_BAIRE1_PREIMAGE_OPEN, .. } := BBAI3
  let { BAIRE0_INDICATOR, BAIRE_INDICATOR_COMPLEMENT, BAIRE_INDICATOR_EMPTY,
        BAIRE_INDICATOR_UNION, BAIRE_INDICATOR_UNIV, COUNTABLE_INTERSECTION_OF_BAIRE0_INDICATOR,
        COUNTABLE_UNION_OF_BAIRE0_INDICATOR, .. } := BBIN1
  let { BAIRE1_INDICATOR, FSIGMA_BAIRE, GDELTA_BAIRE, .. } := BBIN2
  let { FSIGMA_REDUCTION_GEN_2, FSIGMA_REDUCTION_GEN_ALT, .. } := BFSR
  -- @@SCOPE END

  let (BAIRE_INDICATOR_SUC, BAIRE_INDICATOR_DELTA, FGSIGMA_BAIRE_PREIMAGE_OPEN_ALT,
       FSIGMA_REDUCTION_GEN, GDELTA_SEPARATION_GEN) ← do
    let clemma ← MESON [BAIRE_INDICATOR_COMPLEMENT, o_THM]
       (← q r"(baire k (:real^N) o indicator) ((:real^N) DIFF s) =
        (baire k (:real^N) o indicator) s")
    let slemma ← prove
     r"!s t k.
        (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) s /\
        (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) t /\
        DISJOINT s t
        ==> ?u. (COUNTABLE UNION_OF baire k (:real^N) o indicator) u /\
                (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) u /\
                s SUBSET u /\ DISJOINT u t"
     (GEN_REWRITE_TAC (funpow 3 BINDER_CONV o LAND_CONV o ONCE_DEPTH_CONV)
       [COUNTABLE_INTERSECTION_OF_COMPLEMENT] THEN
      REWRITE_TAC [clemma] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"DISJOINT s t <=> (UNIV DIFF s) UNION (UNIV DIFF t) = UNIV")] THEN
      ONCE_REWRITE_TAC [← SET_RULE
       (← q r"s SUBSET t <=> UNIV DIFF t SUBSET UNIV DIFF s")] THEN
      REWRITE_TAC [← MESON [← SET_RULE (← q r"UNIV DIFF (UNIV DIFF s) = s")]
       (← q r"((!s. P(UNIV DIFF s)) <=> (!s. P s)) /\
        ((?s. P(UNIV DIFF s)) <=> (?s. P s))")] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [ETA_AX, CONJ_ASSOC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      DISCH_THEN (MP_TAC o MATCH_MP FSIGMA_REDUCTION_GEN_2) THEN
      ASM_REWRITE_TAC [← SET_RULE
        (← q r"DISJOINT s t /\ s UNION t = UNIV <=> s = UNIV DIFF t")] THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool")
       (STRIP_ASSUME_TAC o GSYM)) THEN
      ASM_REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ONCE_REWRITE_TAC [COUNTABLE_INTERSECTION_OF_COMPLEMENT] THEN
      ASM_REWRITE_TAC [clemma, ETA_AX])
    let (BAIRE_INDICATOR_SUC, BAIRE_INDICATOR_DELTA, FGSIGMA_BAIRE_PREIMAGE_OPEN_ALT) ←
      match CONJUNCTS (← prove
     r"(!s n. 1 <= n
              ==> ((COUNTABLE UNION_OF
                    COUNTABLE INTERSECTION_OF baire n (:real^N) o indicator) s /\
                   (COUNTABLE INTERSECTION_OF
                    COUNTABLE UNION_OF baire n (:real^N) o indicator) s <=>
                   baire (n + 1) (:real^N) (indicator s))) /\
       (!s n. (COUNTABLE UNION_OF baire n (:real^N) o indicator) s /\
              (COUNTABLE INTERSECTION_OF baire n (:real^N) o indicator) s <=>
              baire n (:real^N) (indicator s)) /\
       (!f u n. 1 <= n /\ baire (n + 1) (:real^N) (f:real^N->real^1) /\ open u
                ==> (COUNTABLE UNION_OF
                     COUNTABLE INTERSECTION_OF baire n (:real^N) o indicator)
                    {x | f x IN u})"
     (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o BINDER_CONV)
       [← METIS [num_CASES] (← q r"(!n. P n) <=> P 0 /\ (!n. P(SUC n))")] THEN
      REWRITE_TAC [BAIRE0_INDICATOR, COUNTABLE_INTERSECTION_OF_BAIRE0_INDICATOR,
                   COUNTABLE_UNION_OF_BAIRE0_INDICATOR] THEN
      REWRITE_TAC [← GSYM ADD1] THEN
      ONCE_REWRITE_TAC [← MESON [] (← q r"(!f u n. P f u n) <=> (!f n u. P f u n)")] THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN REWRITE_TAC [AND_FORALL_THM] THEN
      MATCH_MP_TAC num_INDUCTION THEN CONV_TAC NUM_REDUCE_CONV THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← GSYM FSIGMA_BAIRE, ← GSYM GDELTA_BAIRE] THEN
        REWRITE_TAC [← GSYM BAIRE1_INDICATOR],
        REWRITE_TAC [← ARITH_RULE (← q r"1 <= SUC n")]] THEN
      X_GEN_TAC (← q r"k:num") THEN
      SUBST1_TAC (← ARITH_RULE (← q r"1 <= k <=> 2 <= SUC k")) THEN
      ABBREV_TAC (← q r"k1 = SUC k") THEN DISCH_THEN
       (CONJUNCTS_THEN2 (LABEL_TAC "Lk")
         (CONJUNCTS_THEN2 (LABEL_TAC "L0") (LABEL_TAC "L2"))) THEN
      SUBGOAL_THEN
       (← q r"!s. (COUNTABLE UNION_OF
             COUNTABLE INTERSECTION_OF (baire k1 (:real^N) o indicator)) s /\
            (COUNTABLE INTERSECTION_OF
             COUNTABLE UNION_OF (baire k1 (:real^N) o indicator)) s
            ==> baire (SUC k1) (:real^N) (indicator s)")
      (LABEL_TAC "L1") THENL
       [GEN_TAC THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o ONCE_DEPTH_CONV)
         [COUNTABLE_INTERSECTION_OF_COMPLEMENT] THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o LAND_CONV o ONCE_DEPTH_CONV)
         [COUNTABLE_UNION_OF_COMPLEMENT] THEN
        REWRITE_TAC [COMPL_COMPL, clemma, ETA_AX] THEN
        W (MP_TAC o PART_MATCH (lhand o rand) COUNTABLE_UNION_OF_ASCENDING o
          lhand o lhand o snd) THEN
        W (MP_TAC o PART_MATCH (lhand o rand) COUNTABLE_UNION_OF_ASCENDING o
          rand o lhand o rand o snd) THEN
        REPLICATE_TAC 2
         (ANTS_TAC THENL
