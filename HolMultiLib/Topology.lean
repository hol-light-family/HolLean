                   {x | x IN s /\ f(x) IN u})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [FSIGMA_BAIRE_PREIMAGE_OPEN] THEN
    ASM_SIMP_TAC [BAIRE_EQ_FSIGMA_PREIMAGE_OPEN_GEN] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"{x | x IN s /\ (f:real^M->real^N) x IN u}") THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let BAIRE_EQ_FSIGMA_PREIMAGE_ALT ← prove
   r"!f:real^M->real^N s k.
      1 <= k
      ==> ((COUNTABLE UNION_OF baire k (:real^M) o indicator) s /\
            baire k s f <=>
            !u. open u
                ==> (COUNTABLE UNION_OF baire k (:real^M) o indicator)
                    {x | x IN s /\ f(x) IN u})"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← MESON []
     (← q r"(p /\ q ==> (r <=> s)) /\ (s ==> q)
      ==> (p ==> (q /\ r <=> s))")) THEN
    REWRITE_TAC [BAIRE_EQ_FSIGMA_PREIMAGE_OPEN] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(:real^N)")) THEN
    REWRITE_TAC [OPEN_UNIV, IN_UNIV, ← SET_RULE (← q r"{x | x IN s} = s")])

  let BAIRE_EQ_GDELTA_PREIMAGE_CLOSED_GEN ← prove
   r"!f:real^M->real^N s k.
      1 <= k
      ==> (baire k s f <=>
           !u. closed u
               ==> ?t. (COUNTABLE INTERSECTION_OF
                        baire k (:real^M) o indicator) t /\
                       {x | x IN s /\ f(x) IN u} = s INTER t)"
   (REWRITE_TAC [COUNTABLE_INTERSECTION_OF_COMPLEMENT] THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN s /\ f x IN u} = s INTER t <=>
      {x | x IN s /\ f x IN UNIV DIFF u} = s INTER (UNIV DIFF t)")] THEN
    REWRITE_TAC [← MESON [COMPL_COMPL] (← q r"(?s. P(UNIV DIFF s)) <=> (?s. P s)")] THEN
    REWRITE_TAC [ETA_AX, closed, ← MESON [BAIRE_INDICATOR_COMPLEMENT, o_THM]
       (← q r"(baire k (:real^N) o indicator) ((:real^N) DIFF s) =
        (baire k (:real^N) o indicator) s")] THEN
    REWRITE_TAC [← MESON [COMPL_COMPL] (← q r"(!s. P(UNIV DIFF s)) <=> (!s. P s)")] THEN
    REWRITE_TAC [BAIRE_EQ_FSIGMA_PREIMAGE_OPEN_GEN])

  let BAIRE_EQ_GDELTA_PREIMAGE_CLOSED ← prove
   r"!f:real^M->real^N s k.
      1 <= k /\ (COUNTABLE INTERSECTION_OF baire k (:real^M) o indicator) s
      ==> (baire k s f <=>
           !u. closed u
               ==> (COUNTABLE INTERSECTION_OF baire k (:real^M) o indicator)
                   {x | x IN s /\ f(x) IN u})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [GDELTA_BAIRE_PREIMAGE_CLOSED] THEN
    ASM_SIMP_TAC [BAIRE_EQ_GDELTA_PREIMAGE_CLOSED_GEN] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"{x | x IN s /\ (f:real^M->real^N) x IN u}") THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let BAIRE_EQ_GDELTA_PREIMAGE_ALT ← prove
   r"!f:real^M->real^N s k.
      1 <= k
      ==> ((COUNTABLE INTERSECTION_OF baire k (:real^M) o indicator) s /\
            baire k s f <=>
            !u. closed u
                ==> (COUNTABLE INTERSECTION_OF baire k (:real^M) o indicator)
                    {x | x IN s /\ f(x) IN u})"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← MESON []
     (← q r"(p /\ q ==> (r <=> s)) /\ (s ==> q)
      ==> (p ==> (q /\ r <=> s))")) THEN
    REWRITE_TAC [BAIRE_EQ_GDELTA_PREIMAGE_CLOSED] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(:real^N)")) THEN
    REWRITE_TAC [CLOSED_UNIV, IN_UNIV, ← SET_RULE (← q r"{x | x IN s} = s")])

  let COUNTABLE_DISCONTINUITIES_IMP_BAIRE1 ← prove
   r"!f:real^M->real^N s.
        COUNTABLE {x | x IN s /\ ~(f continuous (at x within s))}
        ==> baire 1 s f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← SET_RULE
       (← q r"{x | x IN s /\ ~P x} = s DIFF {x | x IN s /\ P x}")] THEN
    ABBREV_TAC
     (← q r"t = {x | x IN s /\ (f:real^M->real^N) continuous at x within s}") THEN
    DISCH_TAC THEN SIMP_TAC [BAIRE_EQ_FSIGMA_PREIMAGE_OPEN_GEN, LE_REFL] THEN
    X_GEN_TAC (← q r"v:real^N->bool") THEN DISCH_TAC THEN
    REWRITE_TAC [← GSYM FSIGMA_BAIRE] THEN
    SUBGOAL_THEN
     (← q r"?u r. open_in (subtopology euclidean s) u /\
            r SUBSET s DIFF t /\
            {x | x IN s /\ (f:real^M->real^N) x IN v} = u UNION r")
    STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"!x. x IN t /\ f x IN v
            ==> ?u. x IN u /\ open_in (subtopology euclidean s) u /\
                    IMAGE (f:real^M->real^N) u SUBSET v")
      MP_TAC THENL
       [X_GEN_TAC (← q r"x:real^M") THEN
        EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONTINUOUS_WITHIN_OPEN]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"v:real^N->bool")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"s INTER u:real^M->bool") THEN
        ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, IN_INTER] THEN ASM SET_TAC [],
        GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"u:real^M->real^M->bool") THEN DISCH_TAC THEN
        EXISTS_TAC
         (← q r"UNIONS {u x:real^M->bool | x IN t /\ (f:real^M->real^N) x IN v}") THEN
        EXISTS_TAC (← q r"{x | x IN s /\ f x IN v} DIFF
                    UNIONS {u x | x IN t /\ (f:real^M->real^N) x IN v}") THEN
        ASM_SIMP_TAC [OPEN_IN_UNIONS, FORALL_IN_GSPEC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [OPEN_IN_OPEN]) THEN
        REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC []],
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^M->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"w UNION r:real^M->bool") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC FSIGMA_UNION THEN ASM_SIMP_TAC [OPEN_IMP_FSIGMA] THEN
      MATCH_MP_TAC COUNTABLE_IMP_FSIGMA THEN ASM_MESON_TAC [COUNTABLE_SUBSET]])

  let COUNTABLE_NEITHER_SIDED_LIMITS_IMP_BAIRE1_GEN ← prove
   r"!f:real^1->real^N s.
      COUNTABLE {x | x IN s /\
                     ~(?l. (f --> l)
                           (at x within {t | t IN s /\ drop t <= drop x})) /\
                     ~(?l. (f --> l)
                           (at x within {t | t IN s /\ drop x <= drop t}))}
      ==> baire 1 s f"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COUNTABLE_DISCONTINUITIES_IMP_BAIRE1 THEN MP_TAC
     (← ISPECL [← q r"f:real^1->real^N", ← q r"s:real^1->bool"]
             COUNTABLE_NONCONTINUOUS_ONE_SIDED_LIMITS) THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC [IMP_IMP, ← GSYM COUNTABLE_UNION] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
    SET_TAC [])

  let COUNTABLE_NEITHER_SIDED_LIMITS_IMP_BAIRE1 ← prove
   r"!f:real^1->real^N s.
      COUNTABLE {x | x IN s /\
                     ~(?l. (f --> l) (at x within {t | drop t <= drop x})) /\
                     ~(?l. (f --> l) (at x within {t | drop x <= drop t}))}
      ==> baire 1 s f"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC COUNTABLE_NEITHER_SIDED_LIMITS_IMP_BAIRE1_GEN THEN
    POP_ASSUM MP_TAC THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
      COUNTABLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN
    REWRITE_TAC [CONTRAPOS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] LIM_WITHIN_SUBSET) THEN
    SET_TAC [])

  return { BAIRE_EQ_FSIGMA_PREIMAGE_OPEN, BAIRE_EQ_FSIGMA_PREIMAGE_ALT,
           BAIRE_EQ_GDELTA_PREIMAGE_CLOSED_GEN, BAIRE_EQ_GDELTA_PREIMAGE_CLOSED,
           BAIRE_EQ_GDELTA_PREIMAGE_ALT, COUNTABLE_DISCONTINUITIES_IMP_BAIRE1,
           COUNTABLE_NEITHER_SIDED_LIMITS_IMP_BAIRE1_GEN,
           COUNTABLE_NEITHER_SIDED_LIMITS_IMP_BAIRE1 }

/- ------------------------------------------------------------------------- -/
/- Extending Baire functions and more miscellaneous properties.              -/
/- (topology.ml 33355-33581)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BXT where
  BAIRE_EXTENSION : thm
  deriving Inhabited

@[nospecialize]
def setupBXT [HolBase] (D : TopologyDeps) (BCLO : CLO) (BBAL : BAL) (BLIM1 : LIM1) (BUNQ : UNQ)
    (BNST : NST) (BCLC : CLC) (BHSP : HSP) (BHMA : HMA) (BHOI : HOI) (BBAI1 : BAI1)
    (BBAI2 : BAI2) (BBUL : BUL) (BBIN1 : BIN1) (BBIS : BIS) (BFBP : FBP) (BBEG : BEG) :
    ExceptT String IO BXT := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH,
        SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, NORM_ARITH, .. } := D
  let { ADD1, CART_EQ, DEPENDENT_CHOICE, ETA_AX, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_AND_THM, IMP_CONJ, IMP_IMP, IN_DIFF, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, REAL_ABS_DIV,
        REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_POW, .. } := D.core3
  let { REAL_LET_TRANS, REAL_LE_DIV, REAL_LE_LMUL, REAL_LE_TRANS, REAL_LT_01, .. } := D.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_NOT_LE, REAL_NOT_LT, REAL_POS,
        REAL_POW_LE, REAL_POW_LT, RIGHT_EXISTS_IMP_THM, SKOLEM_THM, SUBSET_UNIV, .. } := D.core5
  let { SUM_LE_NUMSEG, SUM_RMUL, o_THM, real_div, real_pow, .. } := D.core6
  let { COUNTABLE_INTERSECTION_OF_INC, COUNTABLE_UNION_OF_INC, .. } := D.lib1
  let { SUM_GP, .. } := D.misc
  let { DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { NORM_1, NORM_MUL, NORM_NEG, .. } := D.vec3
  let { VECTOR_ADD_SUB, VECTOR_MUL_LID, VECTOR_SUB_LZERO, VSUM_DIFFS_ALT, VSUM_NORM_TRIANGLE,
        dist, drop, indicator, .. } := D.vec4
  let { ARCH_EVENTUALLY_POW_INV, .. } := D.met1
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { OPEN_CLOSED, .. } := BCLO
  let { IN_BALL_0, OPEN_BALL, .. } := BBAL
  let { tendsto, .. } := BLIM1
  let { LIM_UNIQUE, .. } := BUNQ
  let { UNIFORMLY_CONVERGENT_EQ_CAUCHY_ALT, .. } := BNST
  let { CONTINUOUS_OPEN_PREIMAGE, .. } := BCLC
  let { CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_HALFSPACE_COMPONENT_LE, .. } := BHSP
  let { HOMEOMORPHIC_SYM, homeomorphic, homeomorphism, .. } := BHMA
  let { HOMEOMORPHIC_BALL_UNIV, .. } := BHOI
  let { BAIRE_ADD, BAIRE_CMUL, BAIRE_CONST, BAIRE_CONTINUOUS_COMPOSE_UNIV, BAIRE_MUL, BAIRE_SUB,
        BAIRE_SUBSET, .. } := BBAI1
  let { BAIRE_COMPONENTWISE, .. } := BBAI2
  let { BAIRE_UNIFORM_LIMIT, .. } := BBUL
  let { COUNTABLE_INTERSECTION_OF_BAIRE0_INDICATOR, .. } := BBIN1
  let { GDELTA_SEPARATION_GEN, .. } := BBIS
  let { FSIGMA_BAIRE_PREIMAGE_OPEN, .. } := BFBP
  let { BAIRE_EQ_FSIGMA_PREIMAGE_OPEN, BAIRE_EQ_GDELTA_PREIMAGE_CLOSED, .. } := BBEG
  -- @@SCOPE END

  let BAIRE_EXTENSION ← do
    let version1 ← prove
     r"!f:real^N->real^1 s k.
            baire k s f /\ 1 <= k /\
            (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) s /\
            (!x. x IN s ==> norm(f x) < &1)
            ==> ?g. baire k (:real^N) g /\
                    (!x. norm(g x) < &1) /\
                    !x. x IN s ==> g x = f x"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?g. (!n. baire k (:real^N) (g n) /\
                 !x. x IN s ==> norm(g n x - f x) < (&2 / &3) pow n) /\
            (!n x. norm(g(SUC n) x - g n x:real^1) <= (&2 / &3) pow n / &3)")
      MP_TAC THENL
       [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONJ_TAC THENL
         [EXISTS_TAC (← q r"(\x. vec 0):real^N->real^1") THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN
          ASM_REWRITE_TAC [BAIRE_CONST, NORM_NEG, VECTOR_SUB_LZERO],
          MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"g:real^N->real^1"] THEN STRIP_TAC] THEN
        MP_TAC (← ISPECL
         [← q r"(\x. g x - f x):real^N->real^1", ← q r"s:real^N->bool", ← q r"k:num"]
         BAIRE_EQ_GDELTA_PREIMAGE_CLOSED) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1)) THEN
        ANTS_TAC THENL
         [MATCH_MP_TAC BAIRE_SUB THEN ASM_REWRITE_TAC [ETA_AX] THEN
          MATCH_MP_TAC BAIRE_SUBSET THEN EXISTS_TAC (← q r"(:real^N)") THEN
          ASM_REWRITE_TAC [SUBSET_UNIV],
          ALL_TAC] THEN
        DISCH_THEN (fun th => tactic_of do
            pure (MP_TAC (← SPEC (← q r"{y | drop y <= --((&2 / &3) pow n / &3)}") th) THEN
                  MP_TAC (← SPEC (← q r"{y | drop y >= (&2 / &3) pow n / &3}") th))) THEN
        REWRITE_TAC [drop, IMP_IMP, CLOSED_HALFSPACE_COMPONENT_GE,
                     CLOSED_HALFSPACE_COMPONENT_LE] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE
         [← TAUT (← q r"b /\ c /\ d ==> e <=> b /\ c ==> d ==> e")]
         GDELTA_SEPARATION_GEN)) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. P x /\ Q x ==> F)
            ==> DISJOINT {x | x IN s /\ f x IN {y | P y}}
                         {x | x IN s /\ f x IN {y | Q y}}")) THEN
          GEN_TAC THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e ==> x >= e /\ x <= --e ==> F")) THEN
          REWRITE_TAC [← REAL_ARITH (← q r"&0 < x / &3 <=> &0 < x")] THEN
          MATCH_MP_TAC REAL_POW_LT THEN CONV_TAC REAL_RAT_REDUCE_CONV,
          DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC)] THEN
        EXISTS_TAC
         (← q r"\x. (g:real^N->real^1) x +
              (&2 / &3) pow n / &3 % (vec 1 - &2 % indicator u x)") THEN
        REWRITE_TAC [VECTOR_ADD_SUB] THEN REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC BAIRE_ADD THEN ASM_REWRITE_TAC [ETA_AX] THEN
          MATCH_MP_TAC BAIRE_CMUL THEN MATCH_MP_TAC BAIRE_SUB THEN
          REWRITE_TAC [BAIRE_CONST] THEN MATCH_MP_TAC BAIRE_CMUL THEN
          ASM_REWRITE_TAC [ETA_AX],
          X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
          RULE_ASSUM_TAC (REWRITE_RULE [IN_ELIM_THM, ← GSYM drop]) THEN
          REWRITE_TAC [NORM_1, DROP_ADD, DROP_SUB, DROP_CMUL, DROP_VEC] THEN
          ASM_CASES_TAC (← q r"drop(g(x:real^N) - f x) >= (&2 / &3) pow n / &3") THENL
           [SUBGOAL_THEN (← q r"(x:real^N) IN u") ASSUME_TAC THENL
             [ASM SET_TAC [], ASM_REWRITE_TAC [indicator, DROP_VEC]] THEN
            CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [real_pow] THEN
            MATCH_MP_TAC (← REAL_ARITH
             (← q r"g - f >= b / &3 /\ abs(g - f) < b
              ==> abs((g + b / &3 * -- &1) - f) < &2 / &3 * b")) THEN
            ASM_SIMP_TAC [← GSYM NORM_1, ← GSYM DROP_SUB],
            ALL_TAC] THEN
          ASM_CASES_TAC
           (← q r"drop(g(x:real^N) - f x) <= --((&2 / &3) pow n / &3)")
          THENL
           [SUBGOAL_THEN (← q r"~((x:real^N) IN u)") ASSUME_TAC THENL
             [ASM SET_TAC [], ASM_REWRITE_TAC [indicator, DROP_VEC]] THEN
            CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [real_pow] THEN
            MATCH_MP_TAC (← REAL_ARITH
             (← q r"g - f <= --(b / &3) /\ abs(g - f) < b
              ==> abs((g + b / &3 * &1) - f) < &2 / &3 * b")) THEN
            ASM_SIMP_TAC [← GSYM NORM_1, ← GSYM DROP_SUB],
            ALL_TAC] THEN
          REWRITE_TAC [real_pow] THEN MATCH_MP_TAC (← REAL_ARITH
           (← q r"abs(g - f) < b / &3 /\ abs(d) <= b / &3
            ==> abs((g + d) - f) < &2 / &3 * b")) THEN
          REWRITE_TAC [← GSYM DROP_SUB] THEN
          CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC],
          GEN_TAC THEN
          REWRITE_TAC [NORM_1, DROP_CMUL, DROP_SUB, DROP_ADD, DROP_VEC]] THEN
       (REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_DIV, REAL_ABS_POW, REAL_ABS_NUM] THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN CONJ_TAC THENL
         [MATCH_MP_TAC REAL_LE_DIV THEN REWRITE_TAC [REAL_POS] THEN
          MATCH_MP_TAC REAL_POW_LE THEN CONV_TAC REAL_RAT_REDUCE_CONV,
          REWRITE_TAC [indicator] THEN COND_CASES_TAC THEN
          REWRITE_TAC [DROP_VEC] THEN CONV_TAC REAL_RAT_REDUCE_CONV]),
        REWRITE_TAC [FORALL_AND_THM, LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"g:num->real^N->real^1") THEN STRIP_TAC THEN
      MP_TAC (← EQ_IMP_RULE (← ISPECL
       [← q r"\x:real^N. T", ← q r"g:num->real^N->real^1"]
       UNIFORMLY_CONVERGENT_EQ_CAUCHY_ALT)).2 THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"&2 / &3", ← q r"e:real"] ARCH_EVENTUALLY_POW_INV) THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num", ← q r"x:real^N"] THEN STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"dist((g:num->real^N->real^1) m x,g n x) =
          norm(vsum(m..n-1) (\i. g(SUC i) x - g i x))")
        SUBST1_TAC THENL
         [REWRITE_TAC [ADD1, VSUM_DIFFS_ALT] THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"m < n ==> m <= n - 1")] THEN
          SUBGOAL_THEN (← q r"n - 1 + 1 = n") SUBST1_TAC THENL
           [ASM_ARITH_TAC, CONV_TAC (fun t => NORM_ARITH t)],
          TRANS_TAC REAL_LET_TRANS (← q r"(&2 / &3) pow m") THEN
          ASM_SIMP_TAC [← REAL_ARITH (← q r"abs x < e ==> x < e")] THEN
          MATCH_MP_TAC VSUM_NORM_TRIANGLE THEN REWRITE_TAC [FINITE_NUMSEG] THEN
          TRANS_TAC REAL_LE_TRANS (← q r"sum(m..n-1) (\i. (&2 / &3) pow i / &3)") THEN
          ASM_SIMP_TAC [SUM_LE_NUMSEG] THEN
          REWRITE_TAC [real_div, SUM_RMUL] THEN
          REWRITE_TAC [← GSYM real_div] THEN REWRITE_TAC [SUM_GP] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"m < n ==> ~(n - 1 < m)")] THEN
          REWRITE_TAC [← REAL_ARITH
           (← q r"(x - y) / (&1 / &3) / &3 <= x <=> &0 <= y")] THEN
