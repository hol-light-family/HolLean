  BAIRE_CASES : thm
  BAIRE_RESTRICT : thm
  BAIRE_FSIGMA_PREIMAGE_GEN : thm
  BAIRE_COMPOSE : thm
  BAIRE_CONTINUOUS_COMPOSE : thm
  deriving Inhabited

@[nospecialize]
def setupBCC [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLOC : LOC) (BCPT : CPT) (BIDC : IDC)
    (BCLC : CLC) (BFSG1 : FSG1) (BFSG2 : FSG2) (BBAI1 : BAI1) (BBIN1 : BIN1) (BBIN2 : BIN2)
    (BBIS : BIS) (BGSP : GSP) (BFBP : FBP) (BBEF : BEF) : ExceptT String IO BCC := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ADD1, ADD_CLAUSES, ADD_EQ_0, AND_FORALL_THM, ARITH, COMPL_COMPL, CONJ_ASSOC, DIFF_EMPTY,
        ETA_AX, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_1, MONO_FORALL, NOT_IN_EMPTY, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET_UNIV, .. } :=
    D.core5
  let { SWAP_FORALL_THM, UNION_OF_MONO, num_INDUCTION, o_THM, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_INTERSECTION_OF_INC, COUNTABLE_SUBSET_NUM,
        COUNTABLE_UNION_OF_COMPLEMENT, COUNTABLE_UNION_OF_EXPLICIT, COUNTABLE_UNION_OF_IDEMPOT,
        COUNTABLE_UNION_OF_INC, COUNTABLE_UNION_OF_INTER, COUNTABLE_UNION_OF_UNION,
        COUNTABLE_UNION_OF_UNIONS, .. } := D.lib1
  let { EXISTS_DIFF, .. } := D.misc
  let { indicator, .. } := D.vec4
  let { closed, .. } := BCLO
  let { CLOSED_IN_CLOSED, OPEN_IN_OPEN, .. } := BLOC
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_ON_COMPOSE, .. } := BIDC
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_OPEN_IN_PREIMAGE_EQ, .. } := BCLC
  let { CLOSED_IMP_FSIGMA, FSIGMA_ASCENDING, .. } := BFSG1
  let { FSIGMA_UNIONS, .. } := BFSG2
  let { BAIRE_CONST, BAIRE_SUBSET, baire, .. } := BBAI1
  let { BAIRE0_INDICATOR, BAIRE_INDICATOR_COMPLEMENT, BAIRE_INDICATOR_EMPTY,
        BAIRE_INDICATOR_INTER, BAIRE_INDICATOR_UNIV, COUNTABLE_UNION_OF_BAIRE0_INDICATOR, .. } :=
    BBIN1
  let { FSIGMA_BAIRE, .. } := BBIN2
  let { BAIRE_INDICATOR_SUC, .. } := BBIS
  let { COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR, .. } := BGSP
  let { FSIGMA_BAIRE_PREIMAGE_OPEN_GEN, GDELTA_BAIRE_PREIMAGE_CLOSED_GEN, .. } := BFBP
  let { BAIRE_EQ_FSIGMA_PREIMAGE_OPEN_GEN, .. } := BBEF
  -- @@SCOPE END

  let BAIRE_CASES ← prove
   r"!f:real^M->real^N g s t k.
        baire k s f /\ baire k (t DIFF s) g /\ baire k (:real^M) (indicator s)
        ==>  baire k t (\x. if x IN s then f x else g x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN ASM_CASES_TAC (← q r"k = 0") THENL
     [ASM_REWRITE_TAC [BAIRE0_INDICATOR] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (DISJ_CASES_THEN SUBST1_TAC)) THEN
      ASM_SIMP_TAC [NOT_IN_EMPTY, DIFF_EMPTY, ETA_AX, IN_UNIV] THEN
      MESON_TAC [BAIRE_SUBSET, SUBSET_UNIV],
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)] THEN
    ASM_SIMP_TAC [BAIRE_EQ_FSIGMA_PREIMAGE_OPEN_GEN, LE_1, AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
    ASM_CASES_TAC (← q r"open(u:real^N->bool)") THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"v:real^M->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"w:real^M->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"s INTER v UNION (((:real^M) DIFF s) INTER w)") THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REPEAT ((MATCH_MP_TAC COUNTABLE_UNION_OF_UNION ORELSE
            MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
                  COUNTABLE_UNION_OF_INTER)) THEN REPEAT CONJ_TAC) THEN
    ASM_SIMP_TAC [COUNTABLE_UNION_OF_INC, o_THM, BAIRE_INDICATOR_COMPLEMENT] THEN
    REWRITE_TAC [BAIRE_INDICATOR_INTER])

  let BAIRE_RESTRICT ← prove
   r"!f:real^M->real^N s k.
        baire k s f /\ baire k (:real^M) (indicator s)
        ==> baire k (:real^M) (\x. if x IN s then f x else vec 0)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BAIRE_CASES THEN
    ASM_REWRITE_TAC [BAIRE_CONST])

  let BAIRE_FSIGMA_PREIMAGE_GEN ← prove
   r"!f:real^M->real^N s u m n.
        baire m s f /\ (COUNTABLE UNION_OF baire n (:real^N) o indicator) u
        ==> ?c. (COUNTABLE UNION_OF baire (m + n) (:real^M) o indicator) c /\
                {x | x IN s /\ f x IN u} = s INTER c"
   (GEN_TAC THEN GEN_TAC THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN MATCH_MP_TAC num_INDUCTION THEN
    CONJ_TAC THENL
     [REWRITE_TAC [COUNTABLE_UNION_OF_BAIRE0_INDICATOR] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
       [EXISTS_TAC (← q r"{}:real^M->bool"), EXISTS_TAC (← q r"(:real^M)")] THEN
      (CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []]) THEN
      MATCH_MP_TAC COUNTABLE_UNION_OF_INC THEN
      REWRITE_TAC [o_THM, BAIRE_INDICATOR_EMPTY, BAIRE_INDICATOR_UNIV],
      X_GEN_TAC (← q r"n:num") THEN DISCH_TAC] THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN ASM_CASES_TAC (← q r"n = 0") THENL
     [ASM_REWRITE_TAC [ADD_CLAUSES, ARITH, ← GSYM FSIGMA_BAIRE] THEN
      REWRITE_TAC [FSIGMA_ASCENDING, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:num->real^N->bool") THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_CASES_TAC (← q r"m = 0") THENL
       [UNDISCH_TAC (← q r"baire m s (f:real^M->real^N)") THEN
        ASM_REWRITE_TAC [ARITH, ← GSYM FSIGMA_BAIRE, baire] THEN DISCH_TAC THEN
        SUBGOAL_THEN
         (← q r"!n. ?t. closed t /\
                  {x | x IN s /\ (f:real^M->real^N) x IN c(n:num)} = s INTER t")
        MP_TAC THENL
         [GEN_TAC THEN REWRITE_TAC [← GSYM CLOSED_IN_CLOSED] THEN
          MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
          ASM_SIMP_TAC [COMPACT_IMP_CLOSED],
          REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
          X_GEN_TAC (← q r"c:num->real^M->bool") THEN STRIP_TAC THEN
          EXISTS_TAC (← q r"UNIONS {c n | n IN (:num)}:real^M->bool") THEN
          ASM_SIMP_TAC [SIMPLE_IMAGE, FSIGMA_UNIONS, COUNTABLE_IMAGE,
            COUNTABLE_SUBSET_NUM, FORALL_IN_IMAGE, CLOSED_IMP_FSIGMA] THEN
          ASM SET_TAC []],
        MP_TAC (← GEN (← q r"n:num") (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool",
                       ← q r"(c:num->real^N->bool) n", ← q r"m:num"]
          GDELTA_BAIRE_PREIMAGE_CLOSED_GEN)) THEN
        ASM_SIMP_TAC [LE_1, COMPACT_IMP_CLOSED, SKOLEM_THM, FORALL_AND_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->real^M->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"UNIONS {c n | n IN (:num)}:real^M->bool") THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC COUNTABLE_UNION_OF_UNIONS THEN
        SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN X_GEN_TAC (← q r"k:num") THEN
        MATCH_MP_TAC COUNTABLE_UNION_OF_INC THEN REWRITE_TAC [o_THM, ADD1] THEN
        MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR THEN
        ASM_REWRITE_TAC []],
      MATCH_MP_TAC (← TAUT (← q r"!q. (p ==> q) /\ (q ==> r) ==> p ==> r")) THEN EXISTS_TAC
       (← q r"(COUNTABLE UNION_OF
         COUNTABLE INTERSECTION_OF baire n (:real^N) o indicator) u") THEN
      CONJ_TAC THENL
       [GEN_REWRITE_TAC (RAND_CONV o RATOR_CONV)
         [← GSYM COUNTABLE_UNION_OF_IDEMPOT] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] UNION_OF_MONO) THEN
        ASM_SIMP_TAC [← GSYM BAIRE_INDICATOR_SUC, ADD1, LE_1, o_THM],
        ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) COUNTABLE_UNION_OF_EXPLICIT o
        lhand o snd) THEN
      ANTS_TAC THENL
       [SIMP_TAC [indicator, o_THM, NOT_IN_EMPTY, BAIRE_CONST,
                  COUNTABLE_INTERSECTION_OF_INC],
        DISCH_THEN SUBST1_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:num->real^N->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM))) THEN
      FIRST_X_ASSUM (MP_TAC o GEN (← q r"k:num") o SPEC (← q r"(:real^N) DIFF d(k:num)")) THEN
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV o RAND_CONV)
       [← GSYM EXISTS_DIFF] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"{x | x IN s /\ f x IN (:real^N) DIFF u} = s INTER (UNIV DIFF t) <=>
        {x | x IN s /\ f x IN u} = s INTER t")] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
       [COUNTABLE_UNION_OF_COMPLEMENT] THEN
      REWRITE_TAC [COMPL_COMPL] THEN
      ASM_REWRITE_TAC [ETA_AX, closed, ← MESON [BAIRE_INDICATOR_COMPLEMENT, o_THM]
       (← q r"(baire k (:real^N) o indicator) ((:real^N) DIFF s) =
        (baire k (:real^N) o indicator) s")] THEN
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->real^M->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"UNIONS {c n | n IN (:num)}:real^M->bool") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC COUNTABLE_UNION_OF_UNIONS THEN
      SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN X_GEN_TAC (← q r"k:num") THEN
      MATCH_MP_TAC COUNTABLE_UNION_OF_INC THEN
      REWRITE_TAC [o_THM, ADD_CLAUSES] THEN REWRITE_TAC [ADD1] THEN
      MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR THEN
      ASM_REWRITE_TAC []])

  let BAIRE_COMPOSE ← prove
   r"!m n f:real^M->real^N g:real^N->real^P s.
        baire m s f /\ baire n (IMAGE f s) g
        ==> baire (m + n) s (g o f)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"m + n = 0") THENL
     [ASM_REWRITE_TAC [baire] THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_MESON_TAC [baire, ADD_EQ_0],
      ASM_SIMP_TAC [BAIRE_EQ_FSIGMA_PREIMAGE_OPEN_GEN, LE_1]] THEN
    X_GEN_TAC (← q r"u:real^P->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x:real^M | x IN s /\ ((g:real^N->real^P) o f) x IN u} =
      {x | x IN s /\ f x IN {y | y IN IMAGE f s /\ g y IN u}}")
    SUBST1_TAC THENL
     [REWRITE_TAC [o_THM] THEN SET_TAC [], ALL_TAC] THEN
    UNDISCH_TAC (← q r"baire n (IMAGE (f:real^M->real^N) s) (g:real^N->real^P)") THEN
    ASM_CASES_TAC (← q r"n = 0") THENL
     [ASM_REWRITE_TAC [baire, CONTINUOUS_OPEN_IN_PREIMAGE_EQ] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"u:real^P->bool")) THEN
      ASM_REWRITE_TAC [OPEN_IN_OPEN],
      DISCH_TAC THEN MP_TAC (← ISPECL
       [← q r"g:real^N->real^P", ← q r"IMAGE (f:real^M->real^N) s", ← q r"u:real^P->bool",
        ← q r"n:num"] FSIGMA_BAIRE_PREIMAGE_OPEN_GEN) THEN
      ASM_SIMP_TAC [LE_1]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN s /\ f x IN IMAGE f s INTER v} = {x | x IN s /\ f x IN v}")] THEN
    REWRITE_TAC [ADD_CLAUSES] THENL
     [MATCH_MP_TAC FSIGMA_BAIRE_PREIMAGE_OPEN_GEN THEN ASM_REWRITE_TAC [] THEN
      ASM_ARITH_TAC,
      MATCH_MP_TAC BAIRE_FSIGMA_PREIMAGE_GEN THEN ASM_REWRITE_TAC []])

  let BAIRE_CONTINUOUS_COMPOSE ← prove
   r"!f:real^M->real^N g:real^N->real^P s k.
        baire k s f /\ g continuous_on IMAGE f s ==> baire k s (g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM (← CONJUNCT1 baire)] THEN
    DISCH_THEN (MP_TAC o MATCH_MP BAIRE_COMPOSE) THEN REWRITE_TAC [ADD_CLAUSES])

  return { BAIRE_CASES, BAIRE_RESTRICT, BAIRE_FSIGMA_PREIMAGE_GEN, BAIRE_COMPOSE,
           BAIRE_CONTINUOUS_COMPOSE }

/- ------------------------------------------------------------------------- -/
/- Homeomorphism invariance of Baire indicator classes.                      -/
/- (topology.ml 33911-34046)                                                 -/
/- ------------------------------------------------------------------------- -/

structure HBI where
  HOMEOMORPHIC_BAIRE_INDICATOR : thm
  HOMEOMORPHIC_COUNTABLE_UNION_OF_BAIRE_INDICATOR : thm
  HOMEOMORPHIC_COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR : thm
  deriving Inhabited

@[nospecialize]
def setupHBI [HolBase] (D : TopologyDeps) (BHMA : HMA) (BFSG3 : FSG3) (BLAV : LAV)
    (BBAI1 : BAI1) (BBIN2 : BIN2) (BGSP : GSP) (BBCC : BCC) : ExceptT String IO HBI := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EQ_IMP, ETA_AX, .. } := D.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_UNIONS, IMP_CONJ, IMP_CONJ_ALT, INTERSECTION_OF,
        INTERSECTION_OF_MONO, INTERS_GSPEC, IN_ELIM_THM, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_REFL, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET_UNIV, .. } := D.core5
  let { UNION_OF, o_THM, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_INTERSECTION_OF_INC, COUNTABLE_INTERSECTION_OF_INTER,
        COUNTABLE_INTERSECTION_OF_INTERS, COUNTABLE_UNION_OF_INC, COUNTABLE_UNION_OF_UNIONS, .. } :=
    D.lib1
  let { indicator, .. } := D.vec4
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, homeomorphic, homeomorphism, .. } := BHMA
  let { HOMEOMORPHIC_FSIGMANESS, .. } := BFSG3
  let { HOMEOMORPHIC_GDELTANESS, LAVRENTIEV_HOMEOMORPHISM, .. } := BLAV
  let { BAIRE_MONO, .. } := BBAI1
  let { BAIRE1_INDICATOR, BAIRE_INDICATOR_CONTINUOUS_PREIMAGE, GDELTA_BAIRE, .. } := BBIN2
  let { COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR, .. } := BGSP
  let { BAIRE_RESTRICT, .. } := BBCC
  -- @@SCOPE END

  let HOMEOMORPHIC_BAIRE_INDICATOR ← do
    let lemma ← prove
     r"!s t k. s homeomorphic t /\ 2 <= k
               ==> baire k (:real^M) (indicator s)
                   ==> baire k (:real^N) (indicator t)"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
      STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP LAVRENTIEV_HOMEOMORPHISM) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^N->bool"] THEN
      MAP_EVERY X_GEN_TAC [← q r"f':real^M->real^N", ← q r"g':real^N->real^M"] THEN
      STRIP_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      SUBGOAL_THEN (← q r"t = {x | x IN v /\ (g':real^N->real^M) x IN s}")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"indicator {x | x IN v /\ (g':real^N->real^M) x IN s} =
        \x. if x IN v then indicator {x | x IN v /\ g' x IN s} x else vec 0")
      SUBST1_TAC THENL
       [REWRITE_TAC [indicator, IN_ELIM_THM, FUN_EQ_THM] THEN MESON_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC BAIRE_RESTRICT THEN CONJ_TAC THENL
       [REWRITE_TAC [ETA_AX] THEN
        MATCH_MP_TAC BAIRE_INDICATOR_CONTINUOUS_PREIMAGE THEN
        ASM_MESON_TAC [SUBSET_UNIV],
        MATCH_MP_TAC BAIRE_MONO THEN EXISTS_TAC (← q r"1 + 1") THEN
        CONJ_TAC THENL [ALL_TAC, ASM_ARITH_TAC] THEN
        MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR THEN
        ASM_REWRITE_TAC [← GSYM GDELTA_BAIRE]])
    prove
     r"!s t k. s homeomorphic t /\ 1 <= k
          ==> (baire k (:real^M) (indicator s) <=>
               baire k (:real^N) (indicator t))"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"k = 1") THENL
       [ASM_REWRITE_TAC [BAIRE1_INDICATOR, LE_REFL] THEN
        MESON_TAC [HOMEOMORPHIC_FSIGMANESS, HOMEOMORPHIC_GDELTANESS],
        STRIP_TAC THEN
        SUBGOAL_THEN (← q r"2 <= k") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        EQ_TAC THEN MATCH_MP_TAC lemma THEN ASM_MESON_TAC [HOMEOMORPHIC_SYM]])

  let HOMEOMORPHIC_COUNTABLE_UNION_OF_BAIRE_INDICATOR ← do
    let lemma ← prove
     r"!s t k. s homeomorphic t /\ 1 <= k
               ==> (COUNTABLE UNION_OF baire k (:real^M) o indicator) s
                   ==> (COUNTABLE UNION_OF baire k (:real^N) o indicator) t"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RATOR_CONV [UNION_OF]) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, o_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
      DISCH_TAC THEN
      X_GEN_TAC (← q r"ss:(real^M->bool)->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"t = IMAGE (f:real^M->real^N) (UNIONS ss)") SUBST1_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
        REWRITE_TAC [IMAGE_UNIONS]] THEN
      MATCH_MP_TAC COUNTABLE_UNION_OF_UNIONS THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"c:real^M->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC COUNTABLE_UNION_OF_INC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
      ASM_REWRITE_TAC [o_THM] THEN MATCH_MP_TAC EQ_IMP THEN
      MATCH_MP_TAC HOMEOMORPHIC_BAIRE_INDICATOR THEN
      ASM_REWRITE_TAC [homeomorphic] THEN
      MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMEOMORPHISM_OF_SUBSETS)) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])
    prove
     r"!s t k. s homeomorphic t /\ 1 <= k
          ==> ((COUNTABLE UNION_OF baire k (:real^M) o indicator) s <=>
               (COUNTABLE UNION_OF baire k (:real^N) o indicator) t)"
     (REPEAT STRIP_TAC THEN EQ_TAC THEN MATCH_MP_TAC lemma THEN
      ASM_MESON_TAC [HOMEOMORPHIC_SYM])

  let HOMEOMORPHIC_COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR ← do
    let lemma ← prove
     r"!s t k. s homeomorphic t /\ 2 <= k
               ==> (COUNTABLE INTERSECTION_OF baire k (:real^M) o indicator) s
                   ==> (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator)
                       t"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
      STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP LAVRENTIEV_HOMEOMORPHISM) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^N->bool"] THEN
      MAP_EVERY X_GEN_TAC [← q r"f':real^M->real^N", ← q r"g':real^N->real^M"] THEN
      STRIP_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      SUBGOAL_THEN (← q r"t = {x | x IN v /\ (g':real^N->real^M) x IN s}")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RATOR_CONV [INTERSECTION_OF]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, o_THM] THEN
      X_GEN_TAC (← q r"ss:(real^M->bool)->bool") THEN
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"{x | x IN v /\ (g':real^N->real^M) x IN INTERS ss} =
        v INTER INTERS {{x | x IN v /\ (g':real^N->real^M) x IN w} | w IN ss}")
      SUBST1_TAC THENL
       [REWRITE_TAC [INTERS_GSPEC] THEN SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INTER THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"gdelta(v:real^N->bool)") THEN
        REWRITE_TAC [GDELTA_BAIRE] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] INTERSECTION_OF_MONO) THEN
        GEN_TAC THEN REWRITE_TAC [o_THM] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BAIRE_MONO) THEN ASM_ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INTERS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"c:real^M->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INC THEN REWRITE_TAC [o_THM] THEN
      SUBGOAL_THEN
       (← q r"indicator {x | x IN v /\ (g':real^N->real^M) x IN c} =
        \x. if x IN v then indicator {x | x IN v /\ g' x IN c} x else vec 0")
      SUBST1_TAC THENL
       [REWRITE_TAC [indicator, IN_ELIM_THM, FUN_EQ_THM] THEN MESON_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC BAIRE_RESTRICT THEN CONJ_TAC THENL
       [REWRITE_TAC [ETA_AX] THEN
        MATCH_MP_TAC BAIRE_INDICATOR_CONTINUOUS_PREIMAGE THEN
        ASM_MESON_TAC [SUBSET_UNIV],
        MATCH_MP_TAC BAIRE_MONO THEN EXISTS_TAC (← q r"1 + 1") THEN
        CONJ_TAC THENL [ALL_TAC, ASM_ARITH_TAC] THEN
        MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR THEN
        ASM_REWRITE_TAC [← GSYM GDELTA_BAIRE]])
    prove
     r"!s t k. s homeomorphic t /\ 1 <= k
          ==> ((COUNTABLE INTERSECTION_OF baire k (:real^M) o indicator) s <=>
               (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) t)"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"k = 1") THEN
      ASM_REWRITE_TAC [← GSYM GDELTA_BAIRE, HOMEOMORPHIC_GDELTANESS, LE_REFL] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"2 <= k") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      EQ_TAC THEN MATCH_MP_TAC lemma THEN ASM_MESON_TAC [HOMEOMORPHIC_SYM])

  return { HOMEOMORPHIC_BAIRE_INDICATOR, HOMEOMORPHIC_COUNTABLE_UNION_OF_BAIRE_INDICATOR,
           HOMEOMORPHIC_COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR }

/- ------------------------------------------------------------------------- -/
/- Disjoint unions and alternation in the Baire indicator hierarchy.         -/
/- (topology.ml 34047-34168)                                                 -/
/- ------------------------------------------------------------------------- -/

structure FGD where
  FSIGMA_DISJOINT_GEN : thm
  FSIGMA_GDELTA_GEN : thm
  GDELTA_FSIGMA_GEN : thm
  FSIGMA_GDELTA_DISJOINT : thm
  deriving Inhabited

@[nospecialize]
def setupFGD [HolBase] (D : TopologyDeps) (BBIN1 : BIN1) (BBIS : BIS) (BGSP : GSP) :
    ExceptT String IO FGD := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { COMPL_COMPL, ETA_AX, EXTENSION, FINITE_IMAGE, .. } := D.core1
  let { FINITE_NUMSEG_LT, FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMP_CONJ_ALT, IN, INTER,
        INTERSECTION_OF_MONO, INTER_UNIONS, IN_DIFF, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, MONO_EXISTS, PAIRWISE_IMAGE, .. } := D.core3
  let { SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, .. } := D.core5
  let { UNIONS_GSPEC, UNION_OF, UNION_OF_MONO, WLOG_LT, num_WOP, o_THM, pairwise, .. } := D.core6
  let { COUNTABLE_DISJOINT_UNION_OF_IDEMPOT, COUNTABLE_IMAGE, COUNTABLE_INTERSECTION_OF_IDEMPOT,
        COUNTABLE_INTERSECTION_OF_INC, COUNTABLE_INTERSECTION_OF_INTER,
        COUNTABLE_INTERSECTION_OF_UNIONS, COUNTABLE_SUBSET_NUM, COUNTABLE_UNION_OF_COMPLEMENT,
        COUNTABLE_UNION_OF_EXPLICIT, COUNTABLE_UNION_OF_IDEMPOT, .. } := D.lib1
  let { BAIRE_INDICATOR_COMPLEMENT, BAIRE_INDICATOR_DIFF, BAIRE_INDICATOR_EMPTY,
        BAIRE_INDICATOR_UNION, BAIRE_INDICATOR_UNIONS, .. } := BBIN1
  let { BAIRE_INDICATOR_SUC, .. } := BBIS
  let { COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR, COUNTABLE_UNION_OF_BAIRE_INDICATOR, .. } :=
    BGSP
  -- @@SCOPE END

  let FSIGMA_DISJOINT_GEN ← prove
   r"!k s. (COUNTABLE UNION_OF baire k (:real^N) o indicator) s <=>
         ((COUNTABLE INTER pairwise DISJOINT) UNION_OF
          baire k (:real^N) o indicator) s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER t = \x. s x /\ t x")] THEN EQ_TAC THENL
     [ALL_TAC, REWRITE_TAC [UNION_OF] THEN MESON_TAC []] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) COUNTABLE_UNION_OF_EXPLICIT o
      lhand o snd) THEN
    SIMP_TAC [o_THM, COUNTABLE_INTERSECTION_OF_INC, BAIRE_INDICATOR_EMPTY] THEN
    DISCH_THEN SUBST1_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->real^N->bool")
     (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM))) THEN
    ABBREV_TAC (← q r"d:num->real^N->bool = \n. c n DIFF UNIONS {c m | m < n}") THEN
    SUBGOAL_THEN
     (← q r"UNIONS {c n | n IN (:num)}:real^N->bool = UNIONS {d n | n IN (:num)}")
    SUBST1_TAC THENL
     [EXPAND_TAC "d" THEN REWRITE_TAC [UNIONS_GSPEC, IN_UNIV, EXTENSION] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_ELIM_THM, IN_DIFF] THEN
      GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN MESON_TAC [],
      REWRITE_TAC [UNION_OF]] THEN
    EXISTS_TAC (← q r"{d n:real^N->bool | n IN (:num)}") THEN
    SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM] THEN
    REWRITE_TAC [PAIRWISE_IMAGE, FORALL_IN_IMAGE, IN_UNIV] THEN CONJ_TAC THENL
     [REWRITE_TAC [pairwise] THEN MATCH_MP_TAC WLOG_LT THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      EXPAND_TAC "d" THEN REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [],
      X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "d" THEN REWRITE_TAC [o_THM] THEN
      MATCH_MP_TAC BAIRE_INDICATOR_DIFF THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC BAIRE_INDICATOR_UNIONS THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT]])

  let FSIGMA_GDELTA_GEN ← prove
   r"!k s. 1 <= k
         ==> ((COUNTABLE UNION_OF baire (k + 1) (:real^N) o indicator) s <=>
              (COUNTABLE UNION_OF
               COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
       [← GSYM COUNTABLE_UNION_OF_IDEMPOT],
      ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] UNION_OF_MONO) THEN
    REWRITE_TAC [COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR, o_THM] THEN
    ASM_SIMP_TAC [← GSYM BAIRE_INDICATOR_SUC])

  let GDELTA_FSIGMA_GEN ← prove
   r"!k s.
     1 <= k
     ==> ((COUNTABLE INTERSECTION_OF baire (k + 1) (:real^N) o indicator) s <=>
          (COUNTABLE INTERSECTION_OF
           COUNTABLE UNION_OF baire k (:real^N) o indicator) s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
       [← GSYM COUNTABLE_INTERSECTION_OF_IDEMPOT],
      ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] INTERSECTION_OF_MONO) THEN
    REWRITE_TAC [COUNTABLE_UNION_OF_BAIRE_INDICATOR, o_THM] THEN
    ASM_SIMP_TAC [← GSYM BAIRE_INDICATOR_SUC])

  let FSIGMA_GDELTA_DISJOINT ← prove
   r"!k s. 1 <= k
         ==> ((COUNTABLE UNION_OF baire (k + 1) (:real^N) o indicator) s <=>
              ((COUNTABLE INTER pairwise DISJOINT) UNION_OF
               COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) s)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [FSIGMA_GDELTA_GEN] THEN EQ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [UNION_OF] THEN MATCH_MP_TAC MONO_EXISTS THEN
      REWRITE_TAC [INTER, IN_ELIM_THM] THEN SIMP_TAC [IN]] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) COUNTABLE_UNION_OF_EXPLICIT o
      lhand o snd) THEN
    SIMP_TAC [o_THM, COUNTABLE_INTERSECTION_OF_INC, BAIRE_INDICATOR_EMPTY] THEN
    DISCH_THEN SUBST1_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->real^N->bool")
     (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM))) THEN
    ABBREV_TAC (← q r"d:num->real^N->bool = \n. c n DIFF UNIONS {c m | m < n}") THEN
    SUBGOAL_THEN
     (← q r"UNIONS {c n | n IN (:num)}:real^N->bool = UNIONS {d n | n IN (:num)}")
    SUBST1_TAC THENL
     [EXPAND_TAC "d" THEN REWRITE_TAC [UNIONS_GSPEC, IN_UNIV, EXTENSION] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_ELIM_THM, IN_DIFF] THEN
      GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN MESON_TAC [],
      ONCE_REWRITE_TAC [← GSYM COUNTABLE_DISJOINT_UNION_OF_IDEMPOT]] THEN
    REWRITE_TAC [] THEN ONCE_REWRITE_TAC [UNION_OF] THEN
    REWRITE_TAC [] THEN EXISTS_TAC (← q r"{d n :real^N->bool | n IN (:num)}") THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN CONJ_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"s INTER t = \x. s x /\ t x")] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM, PAIRWISE_IMAGE] THEN
      REWRITE_TAC [pairwise] THEN MATCH_MP_TAC WLOG_LT THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      EXPAND_TAC "d" THEN REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [],
      X_GEN_TAC (← q r"n:num")] THEN
    EXPAND_TAC "d" THEN
    MP_TAC (← EQ_IMP_RULE (← ISPECL
      [← q r"k:num", ← q r"(:real^N) DIFF UNIONS {c m | m:num < n}"]
      FSIGMA_DISJOINT_GEN)).1 THEN
    ANTS_TAC THENL
     [REWRITE_TAC [COUNTABLE_UNION_OF_COMPLEMENT] THEN
      REWRITE_TAC [COMPL_COMPL] THEN
      MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_UNIONS THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, ETA_AX,
                       ← MESON [o_THM, BAIRE_INDICATOR_COMPLEMENT]
       (← q r"(baire k (:real^N) o indicator) (UNIV DIFF s) <=>
        (baire k (:real^N) o indicator) s")] THEN
      SIMP_TAC [COUNTABLE_INTERSECTION_OF_INC, BAIRE_INDICATOR_EMPTY, o_THM] THEN
      REWRITE_TAC [BAIRE_INDICATOR_UNION] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT],
      REWRITE_TAC [UNION_OF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"IMAGE (\t. (c:num->real^N->bool) n INTER t) u") THEN
      ASM_REWRITE_TAC [← REWRITE_RULE [SIMPLE_IMAGE] (← GSYM INTER_UNIONS)] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, ← SET_RULE
       (← q r"s INTER (UNIV DIFF t) = s DIFF t")] THEN
      ASM_SIMP_TAC [COUNTABLE_INTERSECTION_OF_INTER,
                    COUNTABLE_INTERSECTION_OF_INC] THEN
      UNDISCH_TAC
       (← q r"(COUNTABLE INTER pairwise DISJOINT) (u:(real^N->bool)->bool)") THEN
      REWRITE_TAC [← SET_RULE (← q r"s INTER t = \x. s x /\ t x")] THEN
      SIMP_TAC [COUNTABLE_IMAGE, PAIRWISE_IMAGE] THEN
      REWRITE_TAC [pairwise] THEN SET_TAC []])

  return { FSIGMA_DISJOINT_GEN, FSIGMA_GDELTA_GEN, GDELTA_FSIGMA_GEN, FSIGMA_GDELTA_DISJOINT }

/- ------------------------------------------------------------------------- -/
/- Baire functions are a local property.  (topology.ml 34169-34232)          -/
/- ------------------------------------------------------------------------- -/

structure LBA where
  LOCALLY_BAIRE : thm
  LOCALLY_BAIRE_ALT : thm
  LOCALLY_BAIRE_EXPLICIT : thm
  deriving Inhabited

@[nospecialize]
def setupLBA [HolBase] (D : TopologyDeps) (BEUC : EUC) (BLOC : LOC) (BLND : LND)
    (BLCY1 : LCY1) (BLCY5 : LCY5) (BBAI1 : BAI1) (BBIN1 : BIN1) (BBIN2 : BIN2) (BBEF : BEF) :
    ExceptT String IO LBA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_IMAGE, IMP_IMP, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, LE_1, .. } := D.core3
  let { RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET_ANTISYM_EQ,
        SUBSET_REFL, .. } := D.core5
  let { SWAP_FORALL_THM, UNIONS_IMAGE, UNIONS_SUBSET, o_THM, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_UNION_OF_INC, COUNTABLE_UNION_OF_INTER,
        COUNTABLE_UNION_OF_UNIONS, EXISTS_COUNTABLE_SUBSET_IMAGE, .. } := D.lib1
  let { OPEN_IN_IMP_SUBSET, .. } := D.met3
  let { OPEN_IN_REFL, .. } := BEUC
  let { OPEN_IN_OPEN, .. } := BLOC
  let { LINDELOF_OPEN_IN, .. } := BLND
  let { locally, .. } := BLCY1
  let { LOCALLY_CONTINUOUS_ON_EXPLICIT, .. } := BLCY5
  let { BAIRE_MONO, BAIRE_SUBSET, baire, .. } := BBAI1
  let { BAIRE_INDICATOR_INTER, .. } := BBIN1
  let { OPEN_IMP_BAIRE1_INDICATOR, .. } := BBIN2
  let { BAIRE_EQ_FSIGMA_PREIMAGE_OPEN_GEN, .. } := BBEF
  -- @@SCOPE END

  let (LOCALLY_BAIRE, LOCALLY_BAIRE_ALT, LOCALLY_BAIRE_EXPLICIT) ←
    match CONJUNCTS (← prove
   r"(!f:real^M->real^N s k. locally (\u. baire k u f) s <=> baire k s f) /\
   (!f:real^M->real^N s k.
        baire k s f <=>
        (!x. x IN s ==> ?u v. open_in (subtopology euclidean s) u /\
                              x IN u /\ u SUBSET v /\ baire k v f)) /\
   (!f:real^M->real^N s k.
        baire k s f <=>
        (!x. x IN s ==> ?u. open_in (subtopology euclidean s) u /\
                            x IN u /\ baire k u f))"
   (REWRITE_TAC [AND_FORALL_THM, locally] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p ==> q) /\ (q ==> r) /\ (s ==> p) /\ (r ==> s)
      ==> (p <=> s) /\ (s <=> q) /\ (s <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [OPEN_IN_REFL],
      MESON_TAC [BAIRE_SUBSET],
      MESON_TAC [BAIRE_SUBSET, OPEN_IN_IMP_SUBSET, SUBSET_REFL],
      ASM_CASES_TAC (← q r"k = 0") THEN
      ASM_REWRITE_TAC [← GSYM LOCALLY_CONTINUOUS_ON_EXPLICIT, baire]] THEN
    ASM_SIMP_TAC [BAIRE_EQ_FSIGMA_PREIMAGE_OPEN_GEN, LE_1] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:real^M->real^M->bool") THEN
    REWRITE_TAC [← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [IMP_IMP] THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"v:real^N->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^N->bool")) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    ASM_REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"t:real^M->real^M->bool") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"IMAGE (u:real^M->real^M->bool) s", ← q r"s:real^M->bool"]
          LINDELOF_OPEN_IN) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
    SUBGOAL_THEN (← q r"UNIONS(IMAGE (u:real^M->real^M->bool) s) = s") SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET] THEN
      CONJ_TAC THENL [REWRITE_TAC [FORALL_IN_IMAGE], ASM SET_TAC []] THEN
      ASM_MESON_TAC [OPEN_IN_IMP_SUBSET],
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^M->bool") STRIP_ASSUME_TAC)] THEN
    FIRST_ASSUM (MP_TAC o
      GEN_REWRITE_RULE (BINDER_CONV o RAND_CONV) [OPEN_IN_OPEN]) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    ASM_REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"w:real^M->real^M->bool") THEN DISCH_THEN (ASSUME_TAC o GSYM) THEN
    EXISTS_TAC (← q r"UNIONS(IMAGE (\x. (t:real^M->real^M->bool) x INTER w x) k)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_UNION_OF_UNIONS THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
        COUNTABLE_UNION_OF_INTER) THEN
      REWRITE_TAC [o_THM, BAIRE_INDICATOR_INTER] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC COUNTABLE_UNION_OF_INC THEN REWRITE_TAC [o_THM] THEN
      MATCH_MP_TAC BAIRE_MONO THEN EXISTS_TAC (← q r"1") THEN ASM_SIMP_TAC [LE_1] THEN
      MATCH_MP_TAC OPEN_IMP_BAIRE1_INDICATOR THEN ASM SET_TAC [],
      REWRITE_TAC [UNIONS_IMAGE] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [UNIONS_IMAGE]) THEN ASM SET_TAC []])) with
    | [a, b, c] => pure (a, b, c)
    | _ => throw "LOCALLY_BAIRE: match failure"

  return { LOCALLY_BAIRE, LOCALLY_BAIRE_ALT, LOCALLY_BAIRE_EXPLICIT }

/- ------------------------------------------------------------------------- -/
/- Relative versions of Baire indicator classes.  (topology.ml 34233-34382)  -/
/- ------------------------------------------------------------------------- -/

structure FLC where
  FSIGMA_LOCALLY_GEN : thm
  FSIGMA_LOCALLY_EQ : thm
  FSIGMA_LOCALLY_TRANS : thm
  GDELTA_LOCALLY_GEN : thm
  GDELTA_LOCALLY_EQ : thm
  GDELTA_LOCALLY_TRANS : thm
  BAIRE_INDICATOR_LOCALLY : thm
  deriving Inhabited

@[nospecialize]
def setupFLC [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCPP2 : CPP2) (BBAI1 : BAI1)
    (BBIN1 : BIN1) (BBIS : BIS) (BFBP : FBP) : ExceptT String IO FLC := do
  -- @@SCOPE BEGIN
  let { MESON, SET_RULE, SET_TAC, .. } := D
  let { ARITH_EQ, COMPL_COMPL, CONJ_ASSOC, ETA_AX, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INTERSECTION_OF_MONO, INTER_SUBSET,
        IN_DELETE, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LE_1, MONO_EXISTS, .. } := D.core3
  let { RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET_UNIV, .. } := D.core5
  let { UNION_OF, UNION_OF_MONO, o_THM, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_INTERSECTION_OF_COMPLEMENT, COUNTABLE_INTERSECTION_OF_INC,
        COUNTABLE_INTERSECTION_OF_INTER, COUNTABLE_UNION_OF_INC, COUNTABLE_UNION_OF_INTER,
        COUNTABLE_UNION_OF_UNIONS, .. } := D.lib1
  let { EXISTS_DIFF, .. } := D.misc
  let { VEC_EQ, indicator, .. } := D.vec4
  let { OPEN_UNIV, .. } := BEUC
  let { OPEN_DELETE, .. } := BCPP2
  let { BAIRE_SUBSET, .. } := BBAI1
  let { BAIRE_INDICATOR_COMPLEMENT_UNIV, BAIRE_INDICATOR_INTER, BAIRE_INDICATOR_REFL, .. } :=
    BBIN1
  let { GDELTA_SEPARATION_GEN, .. } := BBIS
  let { FSIGMA_BAIRE_PREIMAGE_OPEN_GEN, .. } := BFBP
  -- @@SCOPE END

  let FSIGMA_LOCALLY_GEN ← prove
   r"!u s k. 1 <= k /\ (COUNTABLE UNION_OF baire k u o indicator) s
           ==> ?t. (COUNTABLE UNION_OF baire k (:real^N) o indicator) t /\
                   u INTER t = u INTER s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC (LAND_CONV o RATOR_CONV) [UNION_OF] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, o_THM] THEN
    X_GEN_TAC (← q r"v:(real^N->bool)->bool") THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    SUBGOAL_THEN
     (← q r"!c. c IN v
          ==> ?d. (COUNTABLE UNION_OF baire k (:real^N) o indicator) d /\
                  u INTER d = u INTER c")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"indicator(c:real^N->bool)", ← q r"u:real^N->bool",
                        ← q r"(:real^1) DELETE vec 0", ← q r"k:num"]
        FSIGMA_BAIRE_PREIMAGE_OPEN_GEN) THEN
      ASM_SIMP_TAC [LE_1, OPEN_DELETE, OPEN_UNIV] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^N->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
      ASM_REWRITE_TAC [indicator, EXTENSION, IN_ELIM_THM, IN_INTER] THEN
      GEN_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IN_DELETE, IN_UNIV, VEC_EQ, ARITH_EQ],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:(real^N->bool)->real^N->bool") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE (d:(real^N->bool)->real^N->bool) v)") THEN
      ASM_SIMP_TAC [COUNTABLE_UNION_OF_UNIONS, COUNTABLE_IMAGE,
                    FORALL_IN_IMAGE] THEN
      ASM SET_TAC []])

  let FSIGMA_LOCALLY_EQ ← prove
   r"!u s k. 1 <= k
           ==> (s SUBSET u /\ (COUNTABLE UNION_OF baire k u o indicator) s <=>
                ?t. (COUNTABLE UNION_OF baire k (:real^N) o indicator) t /\
                    u INTER t = s)"
   (REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          FSIGMA_LOCALLY_GEN)) THEN
      ASM SET_TAC [],
      ASM SET_TAC [],
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
        COUNTABLE_UNION_OF_INTER) THEN
      ASM_REWRITE_TAC [BAIRE_INDICATOR_INTER, o_THM] THEN
      SIMP_TAC [COUNTABLE_UNION_OF_INC, BAIRE_INDICATOR_REFL, o_THM] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          UNION_OF_MONO)) THEN
      REWRITE_TAC [o_THM] THEN GEN_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BAIRE_SUBSET) THEN
      REWRITE_TAC [SUBSET_UNIV]])

  let FSIGMA_LOCALLY_TRANS ← prove
   r"!s t u:real^N->bool k.
        1 <= k /\ s SUBSET t /\ t SUBSET u /\
        (COUNTABLE UNION_OF baire k t o indicator) s /\
        (COUNTABLE UNION_OF baire k u o indicator) t
        ==> (COUNTABLE UNION_OF baire k u o indicator) s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"s:real^N->bool", ← q r"k:num"]
      FSIGMA_LOCALLY_GEN) THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET t ==> t INTER s = s")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
      COUNTABLE_UNION_OF_INTER) THEN
    ASM_REWRITE_TAC [BAIRE_INDICATOR_INTER, o_THM] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      UNION_OF_MONO)) THEN
    REWRITE_TAC [o_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BAIRE_SUBSET) THEN
    REWRITE_TAC [SUBSET_UNIV])

  let GDELTA_LOCALLY_GEN ← prove
   r"!u s k.
        1 <= k /\ (COUNTABLE INTERSECTION_OF baire k u o indicator) s
        ==> ?t. (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) t /\
                u INTER t = u INTER s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [COUNTABLE_INTERSECTION_OF_COMPLEMENT] THEN
    REWRITE_TAC [ETA_AX, ← MESON [o_THM, BAIRE_INDICATOR_COMPLEMENT_UNIV]
     (← q r"(baire k u o indicator) (UNIV DIFF s) <=> (baire k u o indicator) s")] THEN
    ONCE_REWRITE_TAC [← GSYM EXISTS_DIFF] THEN
    DISCH_THEN (MP_TAC o MATCH_MP FSIGMA_LOCALLY_GEN) THEN
    MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [COMPL_COMPL] THEN SET_TAC [])

  let GDELTA_LOCALLY_EQ ← prove
   r"!u s k.
    1 <= k
    ==> (s SUBSET u /\
         (COUNTABLE INTERSECTION_OF baire k u o indicator) s <=>
         ?t. (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) t /\
             u INTER t = s)"
   (REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          GDELTA_LOCALLY_GEN)) THEN
      ASM SET_TAC [],
      ASM SET_TAC [],
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INTER THEN
      SIMP_TAC [COUNTABLE_INTERSECTION_OF_INC, BAIRE_INDICATOR_REFL, o_THM] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          INTERSECTION_OF_MONO)) THEN
      REWRITE_TAC [o_THM] THEN GEN_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BAIRE_SUBSET) THEN
      REWRITE_TAC [SUBSET_UNIV]])

  let GDELTA_LOCALLY_TRANS ← prove
   r"!s t u:real^N->bool k.
        1 <= k /\ s SUBSET t /\ t SUBSET u /\
        (COUNTABLE INTERSECTION_OF baire k t o indicator) s /\
        (COUNTABLE INTERSECTION_OF baire k u o indicator) t
        ==> (COUNTABLE INTERSECTION_OF baire k u o indicator) s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"s:real^N->bool", ← q r"k:num"]
      GDELTA_LOCALLY_GEN) THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET t ==> t INTER s = s")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INTER THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          INTERSECTION_OF_MONO)) THEN
    REWRITE_TAC [o_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BAIRE_SUBSET) THEN
    REWRITE_TAC [SUBSET_UNIV])

  let BAIRE_INDICATOR_LOCALLY ← prove
   r"!u s k.
        1 <= k /\ baire k u (indicator s) /\
        (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) u
        ==> ?t. baire k (:real^N) (indicator t) /\ u INTER t = u INTER s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"u INTER s:real^N->bool", ← q r"u DIFF s:real^N->bool",
                      ← q r"k:num"]
            GDELTA_SEPARATION_GEN) THEN
    ANTS_TAC THENL [ALL_TAC, MATCH_MP_TAC MONO_EXISTS THEN SET_TAC []] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
    CONJ_TAC THEN MATCH_MP_TAC GDELTA_LOCALLY_TRANS THEN
    EXISTS_TAC (← q r"u:real^N->bool") THEN
    ASM_REWRITE_TAC [INTER_SUBSET, SUBSET_UNIV] THEN
    MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INTER THEN
    ASM_SIMP_TAC [COUNTABLE_INTERSECTION_OF_INC, o_THM,
                  BAIRE_INDICATOR_COMPLEMENT_UNIV] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          INTERSECTION_OF_MONO)) THEN
    REWRITE_TAC [o_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BAIRE_SUBSET) THEN
    REWRITE_TAC [SUBSET_UNIV])

  return { FSIGMA_LOCALLY_GEN, FSIGMA_LOCALLY_EQ, FSIGMA_LOCALLY_TRANS, GDELTA_LOCALLY_GEN,
           GDELTA_LOCALLY_EQ, GDELTA_LOCALLY_TRANS, BAIRE_INDICATOR_LOCALLY }

/- ------------------------------------------------------------------------- -/
/- Basics on Borel measurability. We define it as "Baire function" and later -/
/- prove (BOREL_MEASURABLE_PREIMAGE_BOREL) that it is equivalent to another  -/
/- natural definition when the domain is a Borel set.                        -/
/- (topology.ml 34383-34587)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BMS where
  borel_measurable_RULES : thm
  borel_measurable_INDUCT : thm
  borel_measurable_CASES : thm
  CONTINUOUS_IMP_BOREL_MEASURABLE_ON : thm
  BAIRE_IMP_BOREL_MEASURABLE : thm
  BOREL_MEASURABLE_ON_SUBSET : thm
  BOREL_MEASURABLE_EQ : thm
  BOREL_MEASURABLE_PASTECART : thm
  BOREL_MEASURABLE_CONTINUOUS_COMPOSE : thm
  BOREL_MEASURABLE_CMUL : thm
  BOREL_MEASURABLE_BILINEAR : thm
  BOREL_MEASURABLE_ADD : thm
  BOREL_MEASURABLE_SUB : thm
  BOREL_MEASURABLE_CONST : thm
  BOREL_MEASURABLE_VSUM : thm
  BOREL_MEASURABLE_MUL : thm
  BOREL_MEASURABLE_NORM : thm
  BOREL_MEASURABLE_MAX : thm
  BOREL_MEASURABLE_MIN : thm
  BOREL_MEASURABLE_PRODUCT : thm
  deriving Inhabited

@[nospecialize]
def setupBMS [HolBase] (D : TopologyDeps) (BARI : ARI) (BCSL : CSL) (BSQC : SQC) (BCMS : CMS)
    (BIDC : IDC) (BLCP : LCP) (BLFR : LFR) (BPCA1 : PCA1) (BBAI1 : BAI1) :
    ExceptT String IO BMS := do
  -- @@SCOPE BEGIN
  let { new_inductive_definition, parse_as_infix, ASM_MESON_TAC, INDUCT_TAC, MESON, REAL_ARITH,
        VECTOR_ARITH, .. } := D
  let { CONJ_SYM, ETA_AX, FINITE_INDUCT_STRONG, .. } := D.core1
  let { FORALL_IN_INSERT, FSTCART_PASTECART, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.core2
  let { IN_UNIV, PRODUCT_CLAUSES, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SNDCART_PASTECART, SUBSET, SUBSET_UNIV, .. } :=
    D.core5
  let { SWAP_FORALL_THM, o_ASSOC, o_DEF, o_THM, .. } := D.core6
  let { BILINEAR_DROP_MUL, DROP_SUB, .. } := D.vec1
  let { LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_SUB, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { NORM_LIFT, .. } := D.vec3
  let { VSUM_CLAUSES, .. } := D.vec4
  let { LIM_CONST, .. } := BARI
  let { CONTINUOUS_ON_EQ, CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := BSQC
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, .. } := BIDC
  let { BILINEAR_CONTINUOUS_ON, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CONTINUOUS_ON_LIFT_NORM, .. } := BLFR
  let { CONTINUOUS_ON_PASTECART, LIM_PASTECART, .. } := BPCA1
  let { baire, .. } := BBAI1
  -- @@SCOPE END

  parse_as_infix ("borel_measurable_on", (12, "right"))

  let (borel_measurable_RULES, borel_measurable_INDUCT, borel_measurable_CASES) ←
   new_inductive_definition
   r"(!f:real^M->real^N s. f continuous_on s ==> f borel_measurable_on s) /\
  (!(f:num->real^M->real^N) g s.
        (!n. f n borel_measurable_on s) /\
        (!x. x IN s ==> ((\n. f n x) --> g x) sequentially)
        ==> g borel_measurable_on s)"

  let CONTINUOUS_IMP_BOREL_MEASURABLE_ON ← prove
   r"!f:real^M->real^N s. f continuous_on s ==> f borel_measurable_on s"
   (REWRITE_TAC [borel_measurable_RULES])

  let BAIRE_IMP_BOREL_MEASURABLE ← prove
   r"!f:real^M->real^N s n. baire n s f ==> f borel_measurable_on s"
   (ONCE_REWRITE_TAC [← MESON [] (← q r"(!f s n. P f s n) <=> (!n f s. P f s n)")] THEN
    INDUCT_TAC THEN
    REWRITE_TAC [baire, CONTINUOUS_IMP_BOREL_MEASURABLE_ON] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN
    EXISTS_TAC (← q r"g:num->real^M->real^N") THEN ASM_SIMP_TAC [])

  let BOREL_MEASURABLE_ON_SUBSET ← prove
   r"!f:real^M->real^N s t.
        f borel_measurable_on s /\ t SUBSET s ==> f borel_measurable_on t"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC borel_measurable_INDUCT THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC (← CONJUNCT1 borel_measurable_RULES) THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
      MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN
      ASM_MESON_TAC [SUBSET]])

  let BOREL_MEASURABLE_EQ ← prove
   r"!f:real^M->real^N g s.
        (!x. x IN s ==> f x = g x) /\ f borel_measurable_on s
        ==> g borel_measurable_on s"
   (ONCE_REWRITE_TAC [CONJ_SYM] THEN
    GEN_REWRITE_TAC BINDER_CONV [SWAP_FORALL_THM] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC borel_measurable_INDUCT THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_ON_EQ, CONTINUOUS_IMP_BOREL_MEASURABLE_ON],
      X_GEN_TAC (← q r"f:num->real^M->real^N") THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN
      EXISTS_TAC (← q r"f:num->real^M->real^N") THEN ASM_MESON_TAC []])

  let BOREL_MEASURABLE_PASTECART ← prove
   r"!f:real^M->real^N g:real^M->real^P s.
        f borel_measurable_on s /\ g borel_measurable_on s
        ==> (\x. pastecart (f x) (g x)) borel_measurable_on s"
   (GEN_REWRITE_TAC BINDER_CONV [SWAP_FORALL_THM] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    MATCH_MP_TAC borel_measurable_INDUCT THEN CONJ_TAC THENL
     [REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
      ONCE_REWRITE_TAC [← MESON [] (← q r"(!f s g. P f s g) <=> (!g s f. P f s g)")] THEN
      REWRITE_TAC [IMP_CONJ_ALT, RIGHT_FORALL_IMP_THM] THEN
      MATCH_MP_TAC borel_measurable_INDUCT THEN
      ASM_SIMP_TAC [CONTINUOUS_IMP_BOREL_MEASURABLE_ON,
                    CONTINUOUS_ON_PASTECART] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"h:num->real^M->real^P", ← q r"g:real^M->real^P", ← q r"s:real^M->bool"] THEN
      STRIP_TAC THEN X_GEN_TAC (← q r"f:real^M->real^N") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN EXISTS_TAC
       (← q r"\n:num x:real^M. pastecart (f x:real^N) (h n x:real^P)") THEN
      ASM_SIMP_TAC [LIM_PASTECART, LIM_CONST],
      MAP_EVERY X_GEN_TAC
       [← q r"f:num->real^M->real^N", ← q r"g:real^M->real^N", ← q r"s:real^M->bool"] THEN
      STRIP_TAC THEN X_GEN_TAC (← q r"h:real^M->real^P") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN EXISTS_TAC
       (← q r"\n:num x:real^M. pastecart (f n x:real^N) (h x:real^P)") THEN
      ASM_SIMP_TAC [LIM_PASTECART, LIM_CONST]])

  let BOREL_MEASURABLE_CONTINUOUS_COMPOSE ← prove
   r"!f:real^N->real^P g:real^M->real^N s.
        f continuous_on (:real^N) /\ g borel_measurable_on s
        ==> (f o g) borel_measurable_on s"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC borel_measurable_INDUCT THEN CONJ_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_ON_COMPOSE, SUBSET_UNIV, CONTINUOUS_ON_SUBSET,
                     CONTINUOUS_IMP_BOREL_MEASURABLE_ON],
      MAP_EVERY X_GEN_TAC
       [← q r"g:num->real^M->real^N", ← q r"h:real^M->real^N", ← q r"s:real^M->bool"] THEN
      STRIP_TAC THEN MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN
      EXISTS_TAC (← q r"\n. (f:real^N->real^P) o (g:num->real^M->real^N) n") THEN
      ASM_SIMP_TAC [o_THM] THEN RULE_ASSUM_TAC (REWRITE_RULE
       [CONTINUOUS_ON_SEQUENTIALLY, IN_UNIV, o_DEF]) THEN
      ASM_SIMP_TAC []])

  let BOREL_MEASURABLE_CMUL ← prove
   r"!f:real^M->real^N s c.
        f borel_measurable_on s ==> (\x. c % f x) borel_measurable_on s"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ, o_DEF]
      BOREL_MEASURABLE_CONTINUOUS_COMPOSE) THEN
    SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID])

  let BOREL_MEASURABLE_BILINEAR ← prove
   r"!bop:real^N->real^P->real^Q f g s:real^M->bool.
        bilinear bop /\ f borel_measurable_on s /\ g borel_measurable_on s
        ==> (\x. bop (f x) (g x)) borel_measurable_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP BOREL_MEASURABLE_PASTECART) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BILINEAR_CONTINUOUS_ON) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP BOREL_MEASURABLE_CONTINUOUS_COMPOSE) THEN
    REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART])

  let BOREL_MEASURABLE_ADD ← prove
   r"!f g:real^M->real^N s.
        f borel_measurable_on s /\ g borel_measurable_on s
        ==> (\x. f x + g x) borel_measurable_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP BOREL_MEASURABLE_PASTECART) THEN
    SUBGOAL_THEN
     (← q r"(\z. (fstcart z:real^N) + sndcart z) continuous_on UNIV")
    MP_TAC THENL
     [SIMP_TAC [CONTINUOUS_ON_ADD, LINEAR_CONTINUOUS_ON, LINEAR_FSTCART,
                LINEAR_SNDCART],
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP BOREL_MEASURABLE_CONTINUOUS_COMPOSE) THEN
      REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART]])

  let BOREL_MEASURABLE_SUB ← prove
   r"!f g:real^M->real^N s.
        f borel_measurable_on s /\ g borel_measurable_on s
        ==> (\x. f x - g x) borel_measurable_on s"
   (REWRITE_TAC [← VECTOR_ARITH (← q r"x - y:real^N = x + --(&1) % y")] THEN
    SIMP_TAC [BOREL_MEASURABLE_CMUL, BOREL_MEASURABLE_ADD])

  let BOREL_MEASURABLE_CONST ← prove
   r"!s:real^M->bool c:real^N. (\x. c) borel_measurable_on s"
   (SIMP_TAC [CONTINUOUS_IMP_BOREL_MEASURABLE_ON, CONTINUOUS_ON_CONST])

  let BOREL_MEASURABLE_VSUM ← prove
   r"!f:A->real^M->real^N s t.
        FINITE t /\ (!i. i IN t ==> f i borel_measurable_on s)
        ==> (\x. vsum t (\i. f i x)) borel_measurable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [VSUM_CLAUSES, BOREL_MEASURABLE_CONST, BOREL_MEASURABLE_ADD,
              FORALL_IN_INSERT, ETA_AX])

  let BOREL_MEASURABLE_MUL ← prove
   r"!f g:real^M->real^N s.
        (\x. lift(f x)) borel_measurable_on s /\ g borel_measurable_on s
        ==> (\x. f x % g x) borel_measurable_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [BILINEAR_DROP_MUL]
      (← ISPEC (← q r"\x y:real^N. drop x % y") BOREL_MEASURABLE_BILINEAR))) THEN
    REWRITE_TAC [LIFT_DROP])

  let BOREL_MEASURABLE_NORM ← prove
   r"!f:real^M->real^N s.
        f borel_measurable_on s
        ==> (\x. lift(norm(f x))) borel_measurable_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM o_DEF, o_ASSOC] THEN
    MATCH_MP_TAC BOREL_MEASURABLE_CONTINUOUS_COMPOSE THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_LIFT_NORM])

  let BOREL_MEASURABLE_MAX ← prove
   r"!f g:real^N->real s.
        (\x. lift(f x)) borel_measurable_on s /\
        (\x. lift(g x)) borel_measurable_on s
        ==> (\x. lift(max (f x) (g x))) borel_measurable_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← REAL_ARITH
     (← q r"max x y = inv(&2) * (x + y) + inv(&2) * abs(x - y)")] THEN
    REWRITE_TAC [LIFT_ADD, LIFT_CMUL, LIFT_DROP] THEN
    MATCH_MP_TAC BOREL_MEASURABLE_ADD THEN CONJ_TAC THEN
    MATCH_MP_TAC BOREL_MEASURABLE_CMUL THEN
    ASM_SIMP_TAC [BOREL_MEASURABLE_ADD, ← GSYM DROP_SUB, ← GSYM NORM_LIFT] THEN
    MATCH_MP_TAC BOREL_MEASURABLE_NORM THEN
    ASM_SIMP_TAC [BOREL_MEASURABLE_SUB, LIFT_SUB])

  let BOREL_MEASURABLE_MIN ← prove
   r"!f g:real^N->real s.
        (\x. lift(f x)) borel_measurable_on s /\
        (\x. lift(g x)) borel_measurable_on s
        ==> (\x. lift(min (f x) (g x))) borel_measurable_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← REAL_ARITH
     (← q r"min x y = inv(&2) * (x + y) - inv(&2) * abs(x - y)")] THEN
    REWRITE_TAC [LIFT_ADD, LIFT_SUB, LIFT_CMUL, LIFT_DROP] THEN
    MATCH_MP_TAC BOREL_MEASURABLE_SUB THEN CONJ_TAC THEN
    MATCH_MP_TAC BOREL_MEASURABLE_CMUL THEN
    ASM_SIMP_TAC [BOREL_MEASURABLE_ADD, ← GSYM DROP_SUB, ← GSYM NORM_LIFT] THEN
    MATCH_MP_TAC BOREL_MEASURABLE_NORM THEN
    ASM_SIMP_TAC [BOREL_MEASURABLE_SUB, LIFT_SUB])

  let BOREL_MEASURABLE_PRODUCT ← prove
   r"!f:A->real^N->real s t.
        FINITE t /\ (!i. i IN t ==> (\x. lift(f i x)) borel_measurable_on s)
        ==> (\x. lift(product t (\i. f i x))) borel_measurable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [PRODUCT_CLAUSES, BOREL_MEASURABLE_CONST, LIFT_CMUL,
              BOREL_MEASURABLE_MUL, FORALL_IN_INSERT, ETA_AX])

  return { borel_measurable_RULES, borel_measurable_INDUCT, borel_measurable_CASES,
           CONTINUOUS_IMP_BOREL_MEASURABLE_ON, BAIRE_IMP_BOREL_MEASURABLE,
           BOREL_MEASURABLE_ON_SUBSET, BOREL_MEASURABLE_EQ, BOREL_MEASURABLE_PASTECART,
           BOREL_MEASURABLE_CONTINUOUS_COMPOSE, BOREL_MEASURABLE_CMUL, BOREL_MEASURABLE_BILINEAR,
           BOREL_MEASURABLE_ADD, BOREL_MEASURABLE_SUB, BOREL_MEASURABLE_CONST,
           BOREL_MEASURABLE_VSUM, BOREL_MEASURABLE_MUL, BOREL_MEASURABLE_NORM,
           BOREL_MEASURABLE_MAX, BOREL_MEASURABLE_MIN, BOREL_MEASURABLE_PRODUCT }

/- ------------------------------------------------------------------------- -/
/- Componentwise Borel measurability; preimages of Borel sets.               -/
/- (topology.ml 34588-34739)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BMC where
  BOREL_MEASURABLE_COMPONENTWISE : thm
  BOREL_BOREL_MEASURABLE_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupBMC [HolBase] (D : TopologyDeps) (BCLO : CLO) (BCLS1 : CLS1) (BLIM1 : LIM1)
    (BCMS : CMS) (BCLC : CLC) (BLCP : LCP) (BHSP : HSP) (BLFR : LFR) (BSDS : SDS) (BSD2 : SD2)
    (BSD3 : SD3) (BBOR1 : BOR1) (BBOR2 : BOR2) (BBMS : BMS) : ExceptT String IO BMC := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, INDUCT_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { CART_EQ, CONJ_ASSOC, EQ_IMP, EQ_TRANS, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FSTCART_PASTECART, FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN,
        INTERS_0, INTERS_GSPEC, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LAMBDA_BETA, LE_REFL, LT, LT_SUC_LE, .. } := D.core3
  let { RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN,
        SNDCART_PASTECART, .. } := D.core5
  let { SWAP_EXISTS_THM, UNIONS_GSPEC, o_DEF, real_gt, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_PRODUCT_DEPENDENT, COUNTABLE_RESTRICT, COUNTABLE_SUBSET_NUM,
        NUM_COUNTABLE, .. } := D.lib1
  let { RATIONAL_BETWEEN_EQ, RATIONAL_CLOSED, .. } := D.lib2
  let { COUNTABLE_RATIONAL, REAL_HALF, .. } := D.misc
  let { LIFT_DROP, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { drop, .. } := D.vec4
  let { EVENTUALLY_AND, EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { OPEN_CLOSED, .. } := BCLO
  let { CLOSURE_CLOSED, .. } := BCLS1
  let { tendsto, .. } := BLIM1
  let { CONTINUOUS_ON_COMPONENTWISE_LIFT, CONTINUOUS_ON_CONST, .. } := BCMS
  let { CONTINUOUS_OPEN_IN_PREIMAGE, CONTINUOUS_OPEN_PREIMAGE_UNIV, .. } := BCLC
  let { CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { OPEN_HALFSPACE_COMPONENT_GT, .. } := BHSP
  let { CONTINUOUS_ON_LIFT_COMPONENT, .. } := BLFR
  let { SETDIST_POS_LT, .. } := BSDS
  let { CONTINUOUS_AT_LIFT_SETDIST, SETDIST_SING_TRIANGLE, .. } := BSD2
  let { SETDIST_EQ_0_SING, .. } := BSD3
  let { BOREL_INDUCT_UNIONS_INTERS, .. } := BBOR1
  let { BOREL_INTERS, BOREL_UNIONS, OPEN_IN_BOREL, .. } := BBOR2
  let { BOREL_MEASURABLE_CONST, BOREL_MEASURABLE_CONTINUOUS_COMPOSE, BOREL_MEASURABLE_PASTECART,
        borel_measurable_INDUCT, .. } := BBMS
  -- @@SCOPE END

  let BOREL_MEASURABLE_COMPONENTWISE ← prove
   r"!f:real^M->real^N s.
        f borel_measurable_on s <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> (\x. lift(f x$i)) borel_measurable_on s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [UNDISCH_TAC (← q r"(f:real^M->real^N) borel_measurable_on s") THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ, o_DEF]
        BOREL_MEASURABLE_CONTINUOUS_COMPOSE) THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_COMPONENT],
      SUBGOAL_THEN
       (← q r"!n. ((\x. lambda i. if i < n then (f:real^M->real^N) x $i else &0)
             :real^M->real^N)
            borel_measurable_on s")
      MP_TAC THENL
       [ALL_TAC,
        DISCH_THEN (MP_TAC o SPEC (← q r"SUC(dimindex(:N))")) THEN
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        SIMP_TAC [FUN_EQ_THM, CART_EQ, LAMBDA_BETA, LT_SUC_LE]] THEN
      INDUCT_TAC THEN
      REWRITE_TAC [← CONJUNCT1 LT, BOREL_MEASURABLE_CONST] THEN
      ASM_CASES_TAC (← q r"1 <= n /\ n <= dimindex(:N)") THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN ASM_REWRITE_TAC [],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
         (← q r"f borel_measurable_on s ==> f = g ==> g borel_measurable_on s"))) THEN
        ASM_SIMP_TAC [FUN_EQ_THM, CART_EQ, LAMBDA_BETA] THEN
        REPEAT STRIP_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
        ASM_ARITH_TAC] THEN
      FIRST_ASSUM (MP_TAC o check (fun th => !(HolCore.Basics.is_conj (concl th)))) THEN
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP BOREL_MEASURABLE_PASTECART) THEN
      SUBGOAL_THEN
       (← q r"((\z. lambda i. if i < n then fstcart z$i
                        else if i = n then sndcart z$1 else &0)
         :real^(N,1)finite_sum->real^N)
        continuous_on UNIV")
      MP_TAC THENL
       [ONCE_REWRITE_TAC [CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
        SIMP_TAC [LAMBDA_BETA] THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        MAP_EVERY ASM_CASES_TAC [← q r"i:num < n", ← q r"i:num = n"] THEN
        ASM_REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
        MATCH_MP_TAC CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE THEN
        SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART],
        REWRITE_TAC [IMP_IMP] THEN
        DISCH_THEN (MP_TAC o MATCH_MP BOREL_MEASURABLE_CONTINUOUS_COMPOSE) THEN
        REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        SIMP_TAC [FUN_EQ_THM, LAMBDA_BETA, CART_EQ] THEN
        REWRITE_TAC [LT, ← GSYM drop, LIFT_DROP] THEN MESON_TAC []]])

  let BOREL_BOREL_MEASURABLE_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        f borel_measurable_on s /\ borel s /\ borel t
        ==> borel {x | x IN s /\ f x IN t}"
   (GEN_TAC THEN GEN_TAC THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")] THEN
    MATCH_MP_TAC BOREL_INDUCT_UNIONS_INTERS THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"u:real^N->bool"),
      REWRITE_TAC [IMP_IMP] THEN CONJ_TAC THEN
      X_GEN_TAC (← q r"u:(real^N->bool)->bool") THEN STRIP_TAC THENL
       [SUBGOAL_THEN
         (← q r"{x | x IN s /\ (f:real^M->real^N) x IN UNIONS u} =
          UNIONS {{x | x IN s /\ f x IN t} | t IN u}")
        SUBST1_TAC THENL [REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC BOREL_UNIONS THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE],
        ASM_CASES_TAC (← q r"u:(real^N->bool)->bool = {}") THEN
        ASM_SIMP_TAC [INTERS_0, ← SET_RULE (← q r"{x | x IN s /\ f x IN UNIV} = s")] THEN
        SUBGOAL_THEN
         (← q r"{x | x IN s /\ (f:real^M->real^N) x IN INTERS u} =
          INTERS {{x | x IN s /\ f x IN t} | t IN u}")
        SUBST1_TAC THENL
         [REWRITE_TAC [INTERS_GSPEC] THEN ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC BOREL_INTERS THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE]]] THEN
    ONCE_REWRITE_TAC [← TAUT
     (← q r"p ==> q /\ r ==> s <=> q ==> p /\ r ==> s")] THEN
    MAP_EVERY (fun t => SPEC_TAC (t, t))
     [← q r"u:real^N->bool", ← q r"s:real^M->bool", ← q r"f:real^M->real^N"] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC borel_measurable_INDUCT THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC OPEN_IN_BOREL THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE THEN ASM_REWRITE_TAC [],
      MAP_EVERY X_GEN_TAC
       [← q r"g:num->real^M->real^N", ← q r"f:real^M->real^N", ← q r"s:real^M->bool"] THEN
      STRIP_TAC THEN X_GEN_TAC (← q r"v:real^N->bool") THEN STRIP_TAC] THEN
    ASM_CASES_TAC (← q r"v = (:real^N)") THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ f x IN UNIV} = s")] THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ (f:real^M->real^N) x IN v} =
      UNIONS
        {INTERS
         {{x | x IN s /\
               lift(setdist({(g:num->real^M->real^N) n x},(:real^N) DIFF v)) IN
               {x | drop x > e}} |n|
          N <= n} |N,e| N IN (:num) /\ e IN {r | rational r /\ &0 < r}}")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN
      GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:real^M") THEN
      REWRITE_TAC [UNIONS_GSPEC, INTERS_GSPEC, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_UNIV, LIFT_DROP] THEN
      ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_REWRITE_TAC [] THENL
       [REWRITE_TAC [real_gt], MESON_TAC [LE_REFL]] THEN
      TRANS_TAC EQ_TRANS
       (← q r"&0 < setdist({(f:real^M->real^N) x},(:real^N) DIFF v)") THEN
      CONJ_TAC THENL
       [GEN_REWRITE_TAC RAND_CONV [← GSYM RATIONAL_BETWEEN_EQ],
        REWRITE_TAC [SETDIST_POS_LT, SETDIST_EQ_0_SING] THEN
        ASM_SIMP_TAC [CLOSURE_CLOSED, ← GSYM OPEN_CLOSED] THEN ASM SET_TAC []] THEN
      GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
      REWRITE_TAC [RIGHT_EXISTS_AND_THM, ← GSYM EVENTUALLY_SEQUENTIALLY] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC] THEN MATCH_MP_TAC (← MESON
       [RATIONAL_CLOSED]
       (← q r"(!x. Q x ==> P(x / &2)) /\ (!x. P x ==> Q(x / &2))
        ==> ((?x. rational x /\ P x) <=> (?y. rational y /\ Q y))")) THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"q:real") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [tendsto] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"q / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, IMP_IMP] THENL
       [DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o
          MATCH_MP (← REAL_ARITH
         (← q r"q < d2 ==> abs(d1 - d2) <= x ==> x < q / &2 ==> q / &2 < d1"))),
        REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
        REWRITE_TAC [LE_REFL] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs(d1 - d2) <= x ==> x < q / &2 /\ q < d1 ==> q / &2 < d2"))] THEN
      REWRITE_TAC [SETDIST_SING_TRIANGLE],
      MATCH_MP_TAC BOREL_UNIONS THEN CONJ_TAC THENL
       [MATCH_MP_TAC COUNTABLE_PRODUCT_DEPENDENT THEN
        REWRITE_TAC [NUM_COUNTABLE] THEN
        SIMP_TAC [← REWRITE_RULE [IN] COUNTABLE_RESTRICT, COUNTABLE_RATIONAL],
        REWRITE_TAC [FORALL_IN_GSPEC]] THEN
      MAP_EVERY X_GEN_TAC [← q r"N:num", ← q r"e:real"] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [IN_UNIV, IN_ELIM_THM] THEN
      REWRITE_TAC [] THEN STRIP_TAC THEN MATCH_MP_TAC BOREL_INTERS THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      REWRITE_TAC [← SET_RULE
       (← q r"{x | x IN s /\ lift(setdist({g n x},t)) IN u} =
        {x | x IN s /\ g n x IN {y | lift(setdist({y},t)) IN u}}")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONTINUOUS_OPEN_PREIMAGE_UNIV THEN
      REWRITE_TAC [CONTINUOUS_AT_LIFT_SETDIST, drop] THEN
      REWRITE_TAC [OPEN_HALFSPACE_COMPONENT_GT]])

  return { BOREL_MEASURABLE_COMPONENTWISE, BOREL_BOREL_MEASURABLE_PREIMAGE }

/- ------------------------------------------------------------------------- -/
/- Borel measurability of indicator functions.  (topology.ml 34740-34802)    -/
/- ------------------------------------------------------------------------- -/

structure BMI where
  BOREL_MEASURABLE_INDICATOR : thm
  BOREL_MEASURABLE_ON_INDICATOR : thm
  deriving Inhabited

@[nospecialize]
def setupBMI [HolBase] (D : TopologyDeps) (BLPT : LPT) (BLIM2 : LIM2) (BARI : ARI) (BCPT : CPT)
    (BCMS : CMS) (BFSG1 : FSG1) (BBOR1 : BOR1) (BBOR2 : BOR2) (BBIN2 : BIN2) (BBMS : BMS)
    (BBMC : BMC) : ExceptT String IO BMI := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, NUM_REDUCE_CONV, .. } := D
  let { COND_RAND, COND_RATOR, ETA_AX, EXTENSION, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_IMAGE, INTERS_IMAGE, IN_ELIM_THM, IN_INTER, IN_SING, .. } :=
    D.core2
  let { IN_UNIV, LE_0, NOT_FORALL_THM, .. } := D.core3
  let { SUBSET_UNIV, .. } := D.core5
  let { COUNTABLE_AS_IMAGE, .. } := D.lib1
  let { PRODUCT_EQ_0_NUMSEG, PRODUCT_ONE, .. } := D.lib2
  let { DROP_VEC, .. } := D.vec1
  let { INDICATOR_COMPLEMENT, LIFT_DROP, LIFT_EQ, LIFT_NUM, .. } := D.vec2
  let { VEC_EQ, indicator, .. } := D.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { CLOSED_SING, .. } := BLPT
  let { LIM_EVENTUALLY, .. } := BLIM2
  let { LIM_CONST, .. } := BARI
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { CLOSED_IMP_FSIGMA, CLOSED_IMP_GDELTA, .. } := BFSG1
  let { BOREL_INDUCT_COMPACT_ALT, .. } := BBOR1
  let { BOREL_UNIV, CLOSED_IMP_BOREL, .. } := BBOR2
  let { BAIRE1_INDICATOR, .. } := BBIN2
  let { BAIRE_IMP_BOREL_MEASURABLE, BOREL_MEASURABLE_EQ, BOREL_MEASURABLE_ON_SUBSET,
        BOREL_MEASURABLE_PRODUCT, BOREL_MEASURABLE_SUB, CONTINUOUS_IMP_BOREL_MEASURABLE_ON,
        borel_measurable_RULES, .. } := BBMS
  let { BOREL_BOREL_MEASURABLE_PREIMAGE, .. } := BBMC
  -- @@SCOPE END

  let BOREL_MEASURABLE_INDICATOR ← prove
   r"!s. indicator s borel_measurable_on (:real^N) <=> borel s"
   (REWRITE_TAC [FORALL_AND_THM, ← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"s = {x | x IN (:real^N) /\ indicator s x IN {vec 1}}")
      SUBST1_TAC THENL
       [REWRITE_TAC [indicator, EXTENSION, IN_ELIM_THM, IN_SING, IN_UNIV] THEN
        REWRITE_TAC [COND_RAND, COND_RATOR, VEC_EQ] THEN
        CONV_TAC NUM_REDUCE_CONV THEN MESON_TAC [],
        MATCH_MP_TAC BOREL_BOREL_MEASURABLE_PREIMAGE THEN
        ASM_REWRITE_TAC [ETA_AX, BOREL_UNIV] THEN
        SIMP_TAC [CLOSED_IMP_BOREL, CLOSED_SING]],
      ALL_TAC] THEN
    MATCH_MP_TAC BOREL_INDUCT_COMPACT_ALT THEN REPEAT CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC BAIRE_IMP_BOREL_MEASURABLE THEN
      EXISTS_TAC (← q r"1") THEN REWRITE_TAC [BAIRE1_INDICATOR] THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_IMP_GDELTA, CLOSED_IMP_FSIGMA],
      X_GEN_TAC (← q r"s:real^N->bool") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [INDICATOR_COMPLEMENT, BOREL_MEASURABLE_SUB, ETA_AX,
                    CONTINUOUS_IMP_BOREL_MEASURABLE_ON, CONTINUOUS_ON_CONST],
      X_GEN_TAC (← q r"u:(real^N->bool)->bool") THEN
      REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      MP_TAC (← ISPEC (← q r"u:(real^N->bool)->bool") COUNTABLE_AS_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->real^N->bool") SUBST1_TAC) THEN
      POP_ASSUM_LIST (K ALL_TAC) THEN REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
      DISCH_TAC THEN MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN
      EXISTS_TAC
       (← q r"\n x:real^N. lift(product(0..n) (\m. drop(indicator (c m) x)))") THEN
      REWRITE_TAC [IN_UNIV] THEN CONJ_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC BOREL_MEASURABLE_PRODUCT THEN
        ASM_SIMP_TAC [LIFT_DROP, ETA_AX, FINITE_NUMSEG],
       X_GEN_TAC (← q r"x:real^N") THEN
       REWRITE_TAC [indicator, INTERS_IMAGE, IN_UNIV, IN_ELIM_THM] THEN
       ASM_CASES_TAC (← q r"!n:num. (x:real^N) IN c n") THEN
       ASM_REWRITE_TAC [DROP_VEC, PRODUCT_ONE, LIM_CONST, LIFT_NUM] THEN
       FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM]) THEN
       DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
       MATCH_MP_TAC LIM_EVENTUALLY THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
       EXISTS_TAC (← q r"N:num") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
       REWRITE_TAC [← GSYM LIFT_NUM, LIFT_EQ, PRODUCT_EQ_0_NUMSEG] THEN
       EXISTS_TAC (← q r"N:num") THEN ASM_REWRITE_TAC [LIFT_DROP, LE_0]]])

  let BOREL_MEASURABLE_ON_INDICATOR ← prove
   r"!s t:real^N->bool.
        borel s
        ==> (indicator t borel_measurable_on s <=> borel(s INTER t))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [SUBGOAL_THEN (← q r"s INTER t = {x:real^N | x IN s /\ indicator t x IN {vec 1}}")
      SUBST1_TAC THENL
       [REWRITE_TAC [indicator, EXTENSION, IN_ELIM_THM, IN_INTER, IN_SING] THEN
        REWRITE_TAC [COND_RAND, COND_RATOR, VEC_EQ] THEN
        CONV_TAC NUM_REDUCE_CONV THEN MESON_TAC [],
        MATCH_MP_TAC BOREL_BOREL_MEASURABLE_PREIMAGE THEN
        ASM_SIMP_TAC [ETA_AX, CLOSED_IMP_BOREL, CLOSED_SING]],
      MATCH_MP_TAC BOREL_MEASURABLE_EQ THEN
      EXISTS_TAC (← q r"indicator(s INTER t:real^N->bool)") THEN CONJ_TAC THENL
       [SIMP_TAC [indicator, IN_INTER],
        MATCH_MP_TAC BOREL_MEASURABLE_ON_SUBSET THEN
        EXISTS_TAC (← q r"(:real^N)") THEN ASM_REWRITE_TAC [SUBSET_UNIV] THEN
        ASM_REWRITE_TAC [BOREL_MEASURABLE_INDICATOR]]])

  return { BOREL_MEASURABLE_INDICATOR, BOREL_MEASURABLE_ON_INDICATOR }

/- ------------------------------------------------------------------------- -/
/- Borel measurability via preimages of Borel sets.  (topology.ml 34803-34914) -/
/- ------------------------------------------------------------------------- -/

structure BPB where
  BOREL_MEASURABLE_PREIMAGE_BOREL : thm
  deriving Inhabited

@[nospecialize]
def setupBPB [HolBase] (D : TopologyDeps) (BLIM2 : LIM2) (BHSP : HSP) (BBOR2 : BOR2)
    (BBMS : BMS) (BBMC : BMC) (BBMI : BMI) : ExceptT String IO BPB := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        REAL_RAT_REDUCE_CONV, NORM_ARITH, .. } := D
  let { ARITH, EQ_TRANS, ETA_AX, .. } := D.core1
  let { IN_ELIM_THM, IN_SING, .. } := D.core2
  let { IN_UNIV, MULT_2, REAL_ABS_BOUNDS, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_NZ,
        REAL_ABS_POW, .. } := D.core3
  let { REAL_ARCH_POW, REAL_ARCH_POW_INV, REAL_DIV_LMUL, REAL_LE_LDIV_EQ, REAL_LE_LMUL,
        REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_LCANCEL_IMP, REAL_LT_LDIV_EQ, REAL_LT_POW2,
        REAL_LT_RDIV_EQ, .. } := D.core4
  let { REAL_MUL_SYM, REAL_OF_NUM_EQ, REAL_POS, REAL_POW_ADD, REAL_POW_EQ_0, REAL_POW_INV,
        REAL_POW_LE, REAL_POW_MONO, REAL_SUB_LDISTRIB, SING_SUBSET, .. } := D.core5
  let { real_ge, .. } := D.core6
  let { FINITE_INTSEG, FLOOR, INTEGER_CLOSED, REAL_EQ_INTEGERS, REAL_FLOOR_LE,
        REAL_LE_FLOOR, .. } := D.lib2
  let { DIST_REAL, .. } := D.vec1
  let { LIFT_DROP, LIFT_EQ_CMUL, .. } := D.vec2
  let { VECTOR_MUL_EQ_0, VSUM_SING, VSUM_SUPERSET, drop, indicator, .. } := D.vec4
  let { LIM_SEQUENTIALLY, .. } := BLIM2
  let { CLOSED_HALFSPACE_COMPONENT_GE, OPEN_HALFSPACE_COMPONENT_LT, .. } := BHSP
  let { BOREL_INTER, BOREL_UNIV, CLOSED_IMP_BOREL, OPEN_IMP_BOREL, .. } := BBOR2
  let { BOREL_MEASURABLE_CMUL, BOREL_MEASURABLE_VSUM, borel_measurable_RULES, .. } := BBMS
  let { BOREL_BOREL_MEASURABLE_PREIMAGE, BOREL_MEASURABLE_COMPONENTWISE, .. } := BBMC
  let { BOREL_MEASURABLE_ON_INDICATOR, .. } := BBMI
  -- @@SCOPE END

  let BOREL_MEASURABLE_PREIMAGE_BOREL ← do
    let lemma0 ← prove
     r"!f:real^M->real^1 n m.
            integer m /\
            m / &2 pow n <= drop(f x) /\
            drop(f x) < (m + &1) / &2 pow n /\
            abs(m) <= &2 pow (2 * n)
            ==> vsum {k | integer k /\ abs(k) <= &2 pow (2 * n)}
                     (\k. k / &2 pow n %
                          indicator {y:real^M | k / &2 pow n <= drop(f y) /\
                                                drop(f y) < (k + &1) / &2 pow n}
                                    x) =
                lift(m / &2 pow n)"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC
       (← q r"vsum {m} (\k. k / &2 pow n %
                      indicator {y:real^M | k / &2 pow n <= drop(f y) /\
                                            drop(f y) < (k + &1) / &2 pow n}
                                x)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VSUM_SUPERSET THEN
        ASM_REWRITE_TAC [SING_SUBSET, IN_ELIM_THM, IN_SING] THEN
        X_GEN_TAC (← q r"k:real") THEN STRIP_TAC THEN
        REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ2_TAC THEN
        ASM_REWRITE_TAC [indicator, IN_ELIM_THM] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← TAUT (← q r"F ==> p")) THEN
        UNDISCH_TAC (← q r"~(k:real = m)") THEN ASM_SIMP_TAC [REAL_EQ_INTEGERS] THEN
        POP_ASSUM_LIST (MP_TAC o end_itlist CONJ) THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
        REAL_ARITH_TAC,
        ASM_REWRITE_TAC [VSUM_SING, indicator, IN_ELIM_THM, LIFT_EQ_CMUL]])
    let lemma1 ← prove
     r"!f:real^M->real^1 s.
            borel s /\
            (!a b. borel {x | x IN s /\ a <= drop(f x) /\ drop(f x) < b})
            ==> f borel_measurable_on s"
     (REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN
      REWRITE_TAC [IN_UNIV] THEN
      EXISTS_TAC
       (← q r"\n x. vsum {k | integer k /\ abs(k) <= &2 pow (2 * n)}
                   (\k. k / &2 pow n %
                        indicator {y:real^M | k / &2 pow n <= drop(f y) /\
                                              drop(f y) < (k + &1) / &2 pow n}
                                  x)") THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC BOREL_MEASURABLE_VSUM THEN
        REWRITE_TAC [REAL_ABS_BOUNDS, FINITE_INTSEG, IN_ELIM_THM] THEN
        GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC BOREL_MEASURABLE_CMUL THEN
        ASM_SIMP_TAC [BOREL_MEASURABLE_ON_INDICATOR, ETA_AX,
                      ← SET_RULE (← q r"s INTER {x | P x} = {x | x IN s /\ P x}")],
        X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [LIM_SEQUENTIALLY] THEN
        MP_TAC (← ISPECL [← q r"&2", ← q r"abs(drop((f:real^M->real^1) x))"]
            REAL_ARCH_POW) THEN
        ANTS_TAC THENL [REAL_ARITH_TAC, DISCH_THEN (X_CHOOSE_TAC (← q r"N1:num"))] THEN
        DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
        REWRITE_TAC [REAL_POW_INV] THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N2:num") MP_TAC) THEN
        SUBST1_TAC (← REAL_ARITH (← q r"inv(&2 pow N2) = &1 / &2 pow N2")) THEN
        SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_POW2] THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"MAX N1 N2") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        ABBREV_TAC (← q r"m = floor(&2 pow n * drop(f(x:real^M)))") THEN
        SUBGOAL_THEN (← q r"dist(lift(m / &2 pow n),(f:real^M->real^1) x) < e")
        MP_TAC THENL
         [REWRITE_TAC [DIST_REAL, ← GSYM drop, LIFT_DROP] THEN
          MATCH_MP_TAC REAL_LT_LCANCEL_IMP THEN EXISTS_TAC (← q r"abs(&2 pow n)") THEN
          REWRITE_TAC [← GSYM REAL_ABS_MUL, REAL_SUB_LDISTRIB] THEN
          SIMP_TAC [REAL_DIV_LMUL, REAL_POW_EQ_0, ← GSYM REAL_ABS_NZ,
                    REAL_OF_NUM_EQ, ARITH] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"x <= y /\ y < x + &1 /\ &1 <= z ==> abs(x - y) < z")) THEN
          EXPAND_TAC "m" THEN REWRITE_TAC [FLOOR] THEN
          ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC (← q r"e * &2 pow N2") THEN
          ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_ABS_POW, REAL_ABS_NUM] THEN
          MATCH_MP_TAC REAL_LE_LMUL THEN ASM_SIMP_TAC [REAL_LT_IMP_LE],
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"x:real^1 = y ==> dist(y,z) < e ==> dist(x,z) < e")) THEN
          MATCH_MP_TAC lemma0 THEN
          SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
          ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
          EXPAND_TAC "m" THEN REWRITE_TAC [FLOOR] THEN
          SIMP_TAC [REAL_ABS_BOUNDS, REAL_LE_FLOOR, REAL_FLOOR_LE,
                    INTEGER_CLOSED] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"abs(x) <= e ==> --e <= x /\ x - &1 < e")) THEN
          REWRITE_TAC [MULT_2, REAL_POW_ADD, REAL_ABS_MUL, REAL_ABS_POW,
                       REAL_ABS_NUM] THEN
          MATCH_MP_TAC REAL_LE_LMUL THEN SIMP_TAC [REAL_POW_LE, REAL_POS] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
           (← q r"x < e ==> e <= d ==> x <= d")))] THEN
        MATCH_MP_TAC REAL_POW_MONO THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_ARITH_TAC])
    prove
     r"!f:real^M->real^N s.
          borel s /\ f borel_measurable_on s <=>
          !t. borel t ==> borel {x | x IN s /\ f x IN t}"
     (REPEAT GEN_TAC THEN EQ_TAC THEN
      SIMP_TAC [BOREL_BOREL_MEASURABLE_PREIMAGE] THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"(:real^N)")) THEN
      REWRITE_TAC [BOREL_UNIV, ← SET_RULE (← q r"{x | x IN s /\ f x IN UNIV} = s")] THEN
      DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC id [BOREL_MEASURABLE_COMPONENTWISE] THEN
      X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
      MATCH_MP_TAC lemma1 THEN ASM_REWRITE_TAC [LIFT_DROP] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [← SET_RULE
       (← q r"{x | x IN s /\ a <= f x$k /\ f x$k < b} =
        {x | x IN s /\ f x IN ({y | a <= y$k} INTER {y | y$k < b})}")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN MATCH_MP_TAC BOREL_INTER THEN
      SIMP_TAC [OPEN_IMP_BOREL, OPEN_HALFSPACE_COMPONENT_LT] THEN
      SIMP_TAC [CLOSED_IMP_BOREL, ← GSYM real_ge, CLOSED_HALFSPACE_COMPONENT_GE])

  return { BOREL_MEASURABLE_PREIMAGE_BOREL }

/- ------------------------------------------------------------------------- -/
/- Extension of Borel measurable functions.  (topology.ml 34916-35075)       -/
/- ------------------------------------------------------------------------- -/

structure BME where
  BOREL_MEASURABLE_EXTENSION : thm
  deriving Inhabited

@[nospecialize]
def setupBME [HolBase] (D : TopologyDeps) (BBAL : BAL) (BUNQ : UNQ) (BTRN : TRN) (BCMP : CMP)
    (BCMS : CMS) (BFSG1 : FSG1) (BLAV : LAV) (BBOR2 : BOR2) (BBMS : BMS) (BBMC : BMC)
    (BBPB : BPB) : ExceptT String IO BME := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, NORM_ARITH, .. } := D
  let { ETA_AX, EXTENSION, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_IMAGE, GE, IMAGE_EQ_EMPTY, IN, INTERS_GSPEC, IN_ELIM_THM, .. } :=
    D.core2
  let { IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_IN_EMPTY, .. } := D.core3
  let { REAL_LT_01, .. } := D.core4
  let { REAL_LT_TRANS, RIGHT_EXISTS_AND_THM, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET,
        SUBSET_EMPTY, SUBSET_RESTRICT, SUBSET_UNIV, .. } := D.core5
  let { SWAP_EXISTS_THM, UNIONS_GSPEC, .. } := D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_RESTRICT, COUNTABLE_SUBSET_NUM, NUM_COUNTABLE, .. } := D.lib1
  let { RATIONAL_BETWEEN, RATIONAL_CLOSED, .. } := D.lib2
  let { COUNTABLE_RATIONAL, .. } := D.misc
  let { EVENTUALLY_TRUE, .. } := D.met2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.met3
  let { IN_BALL_0, OPEN_BALL, .. } := BBAL
  let { LIM_UNIQUE, .. } := BUNQ
  let { LIM_TRANSFORM_EVENTUALLY, .. } := BTRN
  let { CONVERGENT_EQ_CAUCHY, cauchy, .. } := BCMP
  let { CONTINUOUS_ON_CONST, .. } := BCMS
  let { GDELTA_UNIV, .. } := BFSG1
  let { LAVRENTIEV, .. } := BLAV
  let { BOREL_COMPLEMENT, BOREL_EMPTY, BOREL_INTERS, BOREL_UNION, BOREL_UNIONS, BOREL_UNIV,
        GDELTA_IMP_BOREL, OPEN_IMP_BOREL, .. } := BBOR2
  let { BOREL_MEASURABLE_ON_SUBSET, BOREL_MEASURABLE_SUB, CONTINUOUS_IMP_BOREL_MEASURABLE_ON,
        borel_measurable_INDUCT, borel_measurable_RULES, .. } := BBMS
  let { BOREL_BOREL_MEASURABLE_PREIMAGE, .. } := BBMC
  let { BOREL_MEASURABLE_PREIMAGE_BOREL, .. } := BBPB
  -- @@SCOPE END

  let BOREL_MEASURABLE_EXTENSION ← do
    let version1 ← prove
     r"!f:real^M->real^N s.
            f borel_measurable_on s
            ==> ?u g.
                     borel u /\
                     s SUBSET u /\
                     u SUBSET closure s /\
                     g borel_measurable_on u /\
                     (!x. x IN s ==> g x = f x)"
     (MATCH_MP_TAC borel_measurable_INDUCT THEN CONJ_TAC THENL
       [MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] THEN
        STRIP_TAC THEN MP_TAC (← ISPECL
         [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"(:real^N)"] LAVRENTIEV) THEN
        ASM_REWRITE_TAC [GDELTA_UNIV, SUBSET_UNIV] THEN
        REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
        SIMP_TAC [CONTINUOUS_IMP_BOREL_MEASURABLE_ON, GDELTA_IMP_BOREL],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"f:num->real^M->real^N", ← q r"g:real^M->real^N", ← q r"s:real^M->bool"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:num->real^M->bool", ← q r"h:num->real^M->real^N"] THEN
      STRIP_TAC THEN
      ABBREV_TAC
       (← q r"v = {x | x IN INTERS {u n | n IN (:num)} /\
                 ?l. ((\n. (h:num->real^M->real^N) n x) --> l) sequentially}") THEN
      EXISTS_TAC (← q r"v:real^M->bool") THEN REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
      CONJ_TAC THENL
       [SUBGOAL_THEN
         (← q r"v = INTERS
               {UNIONS {INTERS {
                      INTERS {{x:real^M | x IN INTERS {u n | n IN (:num)} /\
                                     h m x - h n x IN ball(vec 0:real^N,e)} |m|
                                         N <= m} |n|
                                 N <= n} |
                        N IN (:num)} |
                e IN {q | q IN rational /\ &0 < q}}")
        SUBST1_TAC THENL
         [EXPAND_TAC "v" THEN REWRITE_TAC [CONVERGENT_EQ_CAUCHY, cauchy] THEN
          REWRITE_TAC [UNIONS_GSPEC, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
          REWRITE_TAC [IN_BALL_0, ← NORM_ARITH (← q r"norm(x - y:real^N) = dist(x,y)")] THEN
          REWRITE_TAC [EXTENSION, IN_ELIM_THM, GE] THEN X_GEN_TAC (← q r"x:real^M") THEN
          EQ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
          ASM_CASES_TAC (← q r"!n. x IN (u:num->real^M->bool) n") THEN
          ASM_REWRITE_TAC [IN] THENL
           [ALL_TAC, MESON_TAC [RATIONAL_CLOSED, REAL_LT_01, LE_REFL]] THEN
          DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
          MP_TAC (← ISPECL [← q r"&0", ← q r"e:real"] RATIONAL_BETWEEN) THEN
          ASM_MESON_TAC [REAL_LT_TRANS],
          MATCH_MP_TAC BOREL_INTERS THEN
          SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, COUNTABLE_RATIONAL,
                    COUNTABLE_RESTRICT, FORALL_IN_IMAGE] THEN
          X_GEN_TAC (← q r"q:real") THEN DISCH_THEN (K ALL_TAC) THEN
          MATCH_MP_TAC BOREL_UNIONS THEN
          SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM, FORALL_IN_IMAGE] THEN
          X_GEN_TAC (← q r"N:num") THEN REWRITE_TAC [IN_UNIV] THEN
          MATCH_MP_TAC BOREL_INTERS THEN
          ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
          SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM, FORALL_IN_IMAGE] THEN
          X_GEN_TAC (← q r"m:num") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
          MATCH_MP_TAC BOREL_INTERS THEN
          ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
          SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM, FORALL_IN_IMAGE] THEN
          X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
          MATCH_MP_TAC BOREL_BOREL_MEASURABLE_PREIMAGE THEN
          ASM_SIMP_TAC [BOREL_INTERS, FORALL_IN_IMAGE, COUNTABLE_IMAGE,
                        NUM_COUNTABLE, OPEN_IMP_BOREL, OPEN_BALL] THEN
          MATCH_MP_TAC BOREL_MEASURABLE_SUB THEN CONJ_TAC THEN
          MATCH_MP_TAC BOREL_MEASURABLE_ON_SUBSET THENL
           [EXISTS_TAC (← q r"(u:num->real^M->bool) n"),
            EXISTS_TAC (← q r"(u:num->real^M->bool) m")] THEN
          ASM_REWRITE_TAC [ETA_AX] THEN ASM SET_TAC []],
        ALL_TAC] THEN
       MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
        [EXPAND_TAC "v" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM, INTERS_GSPEC] THEN
         X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN CONJ_TAC THENL
          [ASM SET_TAC [], EXISTS_TAC (← q r"(g:real^M->real^N) x")] THEN
         MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
         EXISTS_TAC (← q r"\n. (f:num->real^M->real^N) n x") THEN
         ASM_SIMP_TAC [EVENTUALLY_TRUE],
         DISCH_TAC] THEN
       CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
       SUBGOAL_THEN
        (← q r"!x. ?l. x IN v
                 ==> ((\n. (h:num->real^M->real^N) n x) --> l) sequentially")
       MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
       REWRITE_TAC [SKOLEM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
       X_GEN_TAC (← q r"k:real^M->real^N") THEN STRIP_TAC THEN CONJ_TAC THENL
        [MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN
         EXISTS_TAC (← q r"h:num->real^M->real^N") THEN ASM_SIMP_TAC [] THEN
         X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC BOREL_MEASURABLE_ON_SUBSET THEN
         EXISTS_TAC (← q r"(u:num->real^M->bool) n") THEN ASM SET_TAC [],
         X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
         MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
         EXISTS_TAC (← q r"\n. (f:num->real^M->real^N) n x") THEN
         ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
         MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
         EXISTS_TAC (← q r"\n. (h:num->real^M->real^N) n x") THEN
         REWRITE_TAC [] THEN CONJ_TAC THENL
          [ASM_SIMP_TAC [EVENTUALLY_TRUE], FIRST_X_ASSUM MATCH_MP_TAC] THEN
         ASM SET_TAC []])
    let version2 ← prove
     r"!f:real^M->real^N s t.
            f borel_measurable_on s /\ IMAGE f s SUBSET t /\ borel t
            ==> ?u g. borel u /\
                      s SUBSET u /\
                      u SUBSET closure s /\
                      g borel_measurable_on u /\
                      IMAGE g u SUBSET t /\
                      (!x. x IN s ==> g x = f x)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] version1) THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^M->real^N") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"{x | x IN u /\ (g:real^M->real^N) x IN t}") THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC BOREL_BOREL_MEASURABLE_PREIMAGE THEN ASM_REWRITE_TAC [],
        ASM SET_TAC [],
        ASM SET_TAC [],
        MATCH_MP_TAC BOREL_MEASURABLE_ON_SUBSET THEN
        EXISTS_TAC (← q r"u:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_RESTRICT],
        ASM SET_TAC [],
        ASM SET_TAC []])
    prove
     r"!f:real^M->real^N s t.
          f borel_measurable_on s /\ IMAGE f s SUBSET t /\ borel t
          ==> ?g. g borel_measurable_on (:real^M) /\
                  (~(t = {}) ==> IMAGE g (:real^M) SUBSET t) /\
                  (!x. x IN s ==> g x = f x)"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
       [ASM_SIMP_TAC [SUBSET_EMPTY, IMAGE_EQ_EMPTY, NOT_IN_EMPTY] THEN
        DISCH_THEN (K ALL_TAC) THEN
        EXISTS_TAC (← q r"(\x. vec 0):real^M->real^N") THEN
        SIMP_TAC [CONTINUOUS_IMP_BOREL_MEASURABLE_ON, CONTINUOUS_ON_CONST],
        STRIP_TAC] THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"t:real^N->bool"]
            version2) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"g:real^M->real^N"] THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"c:real^N")) THEN
      EXISTS_TAC (← q r"\x. if x IN u then (g:real^M->real^N) x else c") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      W (MP_TAC o PART_MATCH (rand o lhand)
        BOREL_MEASURABLE_PREIMAGE_BOREL o snd) THEN
      REWRITE_TAC [BOREL_UNIV, IN_UNIV] THEN DISCH_THEN SUBST1_TAC THEN
      X_GEN_TAC (← q r"v:real^N->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"{x | (if x IN u then (g:real^M->real^N) x else c) IN v} =
        {x | x IN u /\ g x IN v} UNION (if c IN v then UNIV DIFF u else {})")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_UNION, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:real^M") THEN
        REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN ASM SET_TAC [],
        MATCH_MP_TAC BOREL_UNION THEN
        ASM_SIMP_TAC [BOREL_BOREL_MEASURABLE_PREIMAGE] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [BOREL_EMPTY, BOREL_COMPLEMENT]])

  return { BOREL_MEASURABLE_EXTENSION }

/- ------------------------------------------------------------------------- -/
/- Composition, cases and restriction of Borel measurable functions, and the -/
/- relation with the general borel_measurable_map.  (topology.ml 35076-35167) -/
/- ------------------------------------------------------------------------- -/

structure BMX where
  BOREL_MEASURABLE_COMPOSE : thm
  BOREL_MEASURABLE_CASES : thm
  BOREL_MEASURABLE_RESTRICT : thm
  BOREL_MEASURABLE_MAP_EUCLIDEAN_SUBTOPOLOGY : thm
  BOREL_MEASURABLE_MAP_EUCLIDEAN : thm
  deriving Inhabited

@[nospecialize]
def setupBMX [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCSL : CSL) (BBOR1 : BOR1)
    (BBOR2 : BOR2) (BBMS : BMS) (BBMI : BMI) (BBPB : BPB) (BBME : BME) :
    ExceptT String IO BMX := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, VECTOR_ARITH, .. } := D
  let { ETA_AX, .. } := D.core1
  let { IMP_CONJ, IN_DIFF, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { REAL_SUB_REFL, REAL_SUB_RZERO, SUBSET_RESTRICT, SUBSET_UNIV, .. } := D.core5
  let { o_THM, .. } := D.core6
  let { DROP_VEC, .. } := D.vec1
  let { LIFT_DROP, LIFT_SUB, .. } := D.vec2
  let { indicator, .. } := D.vec4
  let { BOREL_IN_SUBTOPOLOGY_EQ, .. } := D.met1
  let { SUBTOPOLOGY_UNIV, borel_measurable_map, .. } := D.met3
  let { TOPSPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { BOREL_IN_EUCLIDEAN, .. } := BBOR1
  let { BOREL_UNIV, .. } := BBOR2
  let { BOREL_MEASURABLE_ADD, BOREL_MEASURABLE_CONST, BOREL_MEASURABLE_CONTINUOUS_COMPOSE,
        BOREL_MEASURABLE_EQ, BOREL_MEASURABLE_MUL, BOREL_MEASURABLE_ON_SUBSET,
        BOREL_MEASURABLE_SUB, borel_measurable_INDUCT, borel_measurable_RULES, .. } := BBMS
  let { BOREL_MEASURABLE_INDICATOR, .. } := BBMI
  let { BOREL_MEASURABLE_PREIMAGE_BOREL, .. } := BBPB
  let { BOREL_MEASURABLE_EXTENSION, .. } := BBME
  -- @@SCOPE END

  let BOREL_MEASURABLE_COMPOSE ← prove
   r"!f:real^M->real^N g:real^N->real^P s.
        f borel_measurable_on s /\ g borel_measurable_on IMAGE f s
         ==> g o f borel_measurable_on s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^N->real^P", ← q r"IMAGE (f:real^M->real^N) s",
                      ← q r"(:real^P)"] BOREL_MEASURABLE_EXTENSION) THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, BOREL_UNIV, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real^N->real^P") THEN STRIP_TAC THEN
    MATCH_MP_TAC BOREL_MEASURABLE_EQ THEN
    EXISTS_TAC (← q r"(h:real^N->real^P) o (f:real^M->real^N)") THEN
    REWRITE_TAC [o_THM] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    UNDISCH_TAC (← q r"(f:real^M->real^N) borel_measurable_on s") THEN
    MAP_EVERY (fun t => SPEC_TAC (t, t))
     [← q r"s:real^M->bool", ← q r"f:real^M->real^N"] THEN
    ABBREV_TAC (← q r"t = (:real^N)") THEN FIRST_X_ASSUM (MP_TAC o SYM) THEN
    UNDISCH_TAC (← q r"(h:real^N->real^P) borel_measurable_on t") THEN
    MAP_EVERY (fun t => SPEC_TAC (t, t))
     [← q r"t:real^N->bool", ← q r"h:real^N->real^P"] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN
    MATCH_MP_TAC borel_measurable_INDUCT THEN CONJ_TAC THENL
     [ASM_MESON_TAC [BOREL_MEASURABLE_CONTINUOUS_COMPOSE,
                     CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
      MAP_EVERY X_GEN_TAC
        [← q r"g:num->real^N->real^P", ← q r"h:real^N->real^P", ← q r"t:real^N->bool"] THEN
      ASM_CASES_TAC (← q r"t = (:real^N)") THEN
      ASM_REWRITE_TAC [IN_UNIV] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] THEN
      STRIP_TAC THEN
      MATCH_MP_TAC (← CONJUNCT2 borel_measurable_RULES) THEN
      EXISTS_TAC (← q r"\n. (g:num->real^N->real^P) n  o (f:real^M->real^N)") THEN
      ASM_SIMP_TAC [o_THM] THEN ASM SET_TAC []])

  let BOREL_MEASURABLE_CASES ← prove
   r"!f g:real^M->real^N s t.
        f borel_measurable_on s /\ g borel_measurable_on (t DIFF s) /\ borel s
        ==> (\x. if x IN s then f x else g x) borel_measurable_on t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(:real^N)") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] BOREL_MEASURABLE_EXTENSION)) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"(:real^N)") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] BOREL_MEASURABLE_EXTENSION)) THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, BOREL_UNIV, IN_DIFF, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f':real^M->real^N") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"g':real^M->real^N") THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC BOREL_MEASURABLE_EQ THEN
    EXISTS_TAC
     (← q r"(\x. drop(indicator s x) % f' x + (&1 - drop(indicator s x)) % g' x)
      :real^M->real^N") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [indicator] THEN
      COND_CASES_TAC THEN
      ASM_SIMP_TAC [DROP_VEC, REAL_SUB_REFL, REAL_SUB_RZERO] THEN
      CONV_TAC (fun t => VECTOR_ARITH t),
      MATCH_MP_TAC BOREL_MEASURABLE_ON_SUBSET THEN EXISTS_TAC (← q r"(:real^M)") THEN
      REWRITE_TAC [SUBSET_UNIV] THEN
      MATCH_MP_TAC BOREL_MEASURABLE_ADD THEN CONJ_TAC THEN
      MATCH_MP_TAC BOREL_MEASURABLE_MUL THEN
      ASM_SIMP_TAC [LIFT_DROP, ETA_AX, BOREL_MEASURABLE_INDICATOR, LIFT_SUB,
                    BOREL_MEASURABLE_CONST, BOREL_MEASURABLE_SUB]])

  let BOREL_MEASURABLE_RESTRICT ← prove
   r"!f:real^M->real^N s.
        f borel_measurable_on s /\ borel s
        ==> (\x. if x IN s then f x else vec 0) borel_measurable_on (:real^M)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BOREL_MEASURABLE_CASES THEN
    ASM_REWRITE_TAC [BOREL_MEASURABLE_CONST])

  /- ----------------------------------------------------------------------- -/
  /- The relation with the general borel_measurable is slightly subtler      -/
  /- ----------------------------------------------------------------------- -/

  let BOREL_MEASURABLE_MAP_EUCLIDEAN_SUBTOPOLOGY ← prove
   r"!(f:real^M->real^N) s.
        borel s
        ==> (borel_measurable_map(subtopology euclidean s,euclidean) f <=>
             f borel_measurable_on s)"
   (REWRITE_TAC [borel_measurable_map, TOPSPACE_EUCLIDEAN, IN_UNIV] THEN
    SIMP_TAC [← GSYM BOREL_IN_EUCLIDEAN, BOREL_IN_SUBTOPOLOGY_EQ] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_RESTRICT] THEN
    SIMP_TAC [BOREL_IN_EUCLIDEAN, ← GSYM BOREL_MEASURABLE_PREIMAGE_BOREL])

  let BOREL_MEASURABLE_MAP_EUCLIDEAN ← prove
   r"!(f:real^M->real^N).
        borel_measurable_map(euclidean,euclidean) f <=> 
        f borel_measurable_on (:real^M)"
   (SIMP_TAC [← GSYM BOREL_MEASURABLE_MAP_EUCLIDEAN_SUBTOPOLOGY, BOREL_UNIV] THEN
    REWRITE_TAC [SUBTOPOLOGY_UNIV])

  return { BOREL_MEASURABLE_COMPOSE, BOREL_MEASURABLE_CASES, BOREL_MEASURABLE_RESTRICT,
           BOREL_MEASURABLE_MAP_EUCLIDEAN_SUBTOPOLOGY, BOREL_MEASURABLE_MAP_EUCLIDEAN }

/- ------------------------------------------------------------------------- -/
/- Analytic sets.  (topology.ml 35168-35253)                                 -/
/- ------------------------------------------------------------------------- -/

structure ANA where
  analytic : thm
  COMPACT_IMP_ANALYTIC : thm
  ANALYTIC_EMPTY : thm
  ANALYTIC_UNIONS : thm
  ANALYTIC_UNION : thm
  LOCALLY_COMPACT_IMP_ANALYTIC : thm
  OPEN_IMP_ANALYTIC : thm
  CLOSED_IMP_ANALYTIC : thm
  ANALYTIC_UNIV : thm
  ANALYTIC_INTERS : thm
  ANALYTIC_INTER : thm
  OPEN_IN_ANALYTIC : thm
  CLOSED_IN_ANALYTIC : thm
  BOREL_IMP_ANALYTIC : thm
  GDELTA_IMP_ANALYTIC : thm
  FSIGMA_IMP_ANALYTIC : thm
  deriving Inhabited

@[nospecialize]
def setupANA [HolBase] (D : TopologyDeps) (BLOC : LOC) (BCPP1 : CPP1) (BLCC1 : LCC1)
    (BLCC2 : LCC2) (BBOR1 : BOR1) (BBOR2 : BOR2) : ExceptT String IO ANA := do
  -- @@SCOPE BEGIN
  let { new_definition, .. } := D
  let { IMP_CONJ, IN, INTERS_0, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { SUBSET, .. } := D.core5
  let { UNIONS_0, .. } := D.core6
  let { SUSLIN_INTER, SUSLIN_INTERS, SUSLIN_SUPERSET, SUSLIN_UNION, SUSLIN_UNIONS, .. } := D.misc
  let { CLOSED_IN_CLOSED, OPEN_IN_OPEN, .. } := BLOC
  let { COMPACT_EMPTY, .. } := BCPP1
  let { CLOSED_IMP_LOCALLY_COMPACT, OPEN_IMP_LOCALLY_COMPACT, .. } := BLCC1
  let { LOCALLY_COMPACT_UNIV, SIGMA_COMPACT, .. } := BLCC2
  let { BOREL_INDUCT_COMPACT_UNIONS_INTERS, .. } := BBOR1
  let { FSIGMA_IMP_BOREL, GDELTA_IMP_BOREL, .. } := BBOR2
  -- @@SCOPE END

  let analytic ← new_definition
   r"analytic s = suslin compact s"

  let COMPACT_IMP_ANALYTIC ← prove
   r"!s. compact s ==> analytic s"
   (REWRITE_TAC [analytic, ← REWRITE_RULE [IN, SUBSET] SUSLIN_SUPERSET])

  let ANALYTIC_EMPTY ← prove
   r"analytic({}:real^N->bool)"
   (SIMP_TAC [COMPACT_EMPTY, COMPACT_IMP_ANALYTIC])

  let ANALYTIC_UNIONS ← prove
   r"!u:(real^N->bool)->bool.
        COUNTABLE u /\ (!s. s IN u ==> analytic s) ==> analytic(UNIONS u)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"u:(real^N->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [UNIONS_0, ANALYTIC_EMPTY] THEN
    REWRITE_TAC [analytic] THEN MATCH_MP_TAC SUSLIN_UNIONS THEN
    ASM_REWRITE_TAC [← GSYM analytic])

  let ANALYTIC_UNION ← prove
   r"!s t:real^N->bool. analytic s /\ analytic t ==> analytic(s UNION t)"
   (REWRITE_TAC [analytic, SUSLIN_UNION])

  let LOCALLY_COMPACT_IMP_ANALYTIC ← prove
   r"!s:real^N->bool. locally compact s ==> analytic s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP SIGMA_COMPACT) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC ANALYTIC_UNIONS THEN
    ASM_SIMP_TAC [COMPACT_IMP_ANALYTIC])

  let OPEN_IMP_ANALYTIC ← prove
   r"!s:real^N->bool. open s ==> analytic s"
   (SIMP_TAC [OPEN_IMP_LOCALLY_COMPACT, LOCALLY_COMPACT_IMP_ANALYTIC])

  let CLOSED_IMP_ANALYTIC ← prove
   r"!s:real^N->bool. closed s ==> analytic s"
   (SIMP_TAC [CLOSED_IMP_LOCALLY_COMPACT, LOCALLY_COMPACT_IMP_ANALYTIC])

  let ANALYTIC_UNIV ← prove
   r"analytic(:real^N)"
   (SIMP_TAC [LOCALLY_COMPACT_IMP_ANALYTIC, LOCALLY_COMPACT_UNIV])

  let ANALYTIC_INTERS ← prove
   r"!u:(real^N->bool)->bool.
        COUNTABLE u /\ (!s. s IN u ==> analytic s) ==> analytic(INTERS u)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"u:(real^N->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [INTERS_0, ANALYTIC_UNIV] THEN
    REWRITE_TAC [analytic] THEN MATCH_MP_TAC SUSLIN_INTERS THEN
    ASM_REWRITE_TAC [← GSYM analytic])

  let ANALYTIC_INTER ← prove
   r"!s t:real^N->bool. analytic s /\ analytic t ==> analytic(s INTER t)"
   (REWRITE_TAC [analytic, SUSLIN_INTER])

  let OPEN_IN_ANALYTIC ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean t) s /\ analytic t ==> analytic s"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [IMP_CONJ, OPEN_IN_OPEN, LEFT_IMP_EXISTS_THM] THEN
    SIMP_TAC [ANALYTIC_INTER, OPEN_IMP_ANALYTIC])

  let CLOSED_IN_ANALYTIC ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean t) s /\ analytic t ==> analytic s"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [IMP_CONJ, CLOSED_IN_CLOSED, LEFT_IMP_EXISTS_THM] THEN
    SIMP_TAC [ANALYTIC_INTER, CLOSED_IMP_ANALYTIC])

  let BOREL_IMP_ANALYTIC ← prove
   r"!s:real^N->bool. borel s ==> analytic s"
   (MATCH_MP_TAC BOREL_INDUCT_COMPACT_UNIONS_INTERS THEN
    REWRITE_TAC [COMPACT_IMP_ANALYTIC, ANALYTIC_UNIONS, ANALYTIC_INTERS])

  let GDELTA_IMP_ANALYTIC ← prove
   r"!s:real^N->bool. gdelta s ==> analytic s"
   (SIMP_TAC [BOREL_IMP_ANALYTIC, GDELTA_IMP_BOREL])

  let FSIGMA_IMP_ANALYTIC ← prove
   r"!s:real^N->bool. fsigma s ==> analytic s"
   (SIMP_TAC [BOREL_IMP_ANALYTIC, FSIGMA_IMP_BOREL])

  return { analytic, COMPACT_IMP_ANALYTIC, ANALYTIC_EMPTY, ANALYTIC_UNIONS, ANALYTIC_UNION,
           LOCALLY_COMPACT_IMP_ANALYTIC, OPEN_IMP_ANALYTIC, CLOSED_IMP_ANALYTIC, ANALYTIC_UNIV,
           ANALYTIC_INTERS, ANALYTIC_INTER, OPEN_IN_ANALYTIC, CLOSED_IN_ANALYTIC,
           BOREL_IMP_ANALYTIC, GDELTA_IMP_ANALYTIC, FSIGMA_IMP_ANALYTIC }

/- ------------------------------------------------------------------------- -/
/- Products, preimages and continuous images of analytic sets.               -/
/- (topology.ml 35254-35389)                                                 -/
/- ------------------------------------------------------------------------- -/

structure ANP where
  ANALYTIC_PCROSS : thm
  ANALYTIC_BOREL_MEASURABLE_PREIMAGE : thm
  ANALYTIC_CONTINUOUS_PREIMAGE : thm
  ANALYTIC_CONTINUOUS_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupANP [HolBase] (D : TopologyDeps) (BLPT : LPT) (BCPP1 : CPP1) (BCSL : CSL)
    (BCMB : CMB) (BCMS : CMS) (BIDC : IDC) (BLCP : LCP) (BPCR1 : PCR1) (BBOR2 : BOR2)
    (BBMS : BMS) (BBMC : BMC) (BBME : BME) (BANA : ANA) : ExceptT String IO ANP := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_PASTECART, FSTCART_PASTECART, IMAGE_EQ, IMAGE_FSTCART_PCROSS,
        IMAGE_UNIONS, IMAGE_o, IN, INTERS_GSPEC, IN_ELIM_THM, IN_IMAGE, IN_SING, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, LENGTH_EQ_NIL, LENGTH_LIST_OF_SEQ, LE_1, LE_REFL,
        PASTECART_INJ, PASTECART_IN_PCROSS, PCROSS_INTERS, PCROSS_UNIONS, .. } := D.core3
  let { SIMPLE_IMAGE, SNDCART_PASTECART, SUBSET, SUBSET_UNIV, .. } := D.core5
  let { UNIONS_GSPEC, UNIV_NOT_EMPTY, o_DEF, o_THM, .. } := D.core6
  let { SUSLIN_REGULAR, SUSLIN_SUSLIN, suslin, suslin_operation, .. } := D.misc
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { VECTOR_SUB_EQ, .. } := D.vec4
  let { CLOSED_SING, .. } := BLPT
  let { COMPACT_INTERS, .. } := BCPP1
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_IMAGE_NESTED_INTERS_GEN, .. } := BCMB
  let { CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_ON_COMPOSE, .. } := BIDC
  let { COMPACT_CONTINUOUS_IMAGE, LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { COMPACT_PCROSS, .. } := BPCR1
  let { BOREL_UNIV, COMPACT_IMP_BOREL, .. } := BBOR2
  let { CONTINUOUS_IMP_BOREL_MEASURABLE_ON, .. } := BBMS
  let { BOREL_BOREL_MEASURABLE_PREIMAGE, .. } := BBMC
  let { BOREL_MEASURABLE_EXTENSION, .. } := BBME
  let { ANALYTIC_INTER, ANALYTIC_UNIV, BOREL_IMP_ANALYTIC, CLOSED_IMP_ANALYTIC,
        COMPACT_IMP_ANALYTIC, analytic, .. } := BANA
  -- @@SCOPE END

  let ANALYTIC_PCROSS ← do
    let lemma ← prove
     r"!s:real^M->bool t:real^N->bool.
            analytic s /\ compact t ==> analytic(s PCROSS t)"
     (REPEAT GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      REWRITE_TAC [analytic] THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [← GSYM SUSLIN_SUSLIN] THEN
      ONCE_REWRITE_TAC [suslin] THEN
      REWRITE_TAC [IN, IN_ELIM_THM, ← GSYM analytic] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:num list->real^M->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
      EXISTS_TAC (← q r"\l. (f:num list->real^M->bool) l PCROSS (t:real^N->bool)") THEN
      ASM_SIMP_TAC [COMPACT_PCROSS, COMPACT_IMP_ANALYTIC] THEN
      REWRITE_TAC [suslin_operation, PCROSS_UNIONS, PCROSS_INTERS, ← SET_RULE
       (← q r"{f y | y IN {g x | P x}} = {f(g x) | P x}")] THEN
      REWRITE_TAC [← SET_RULE (← q r"{f x | P x} = {} <=> ~(?x. P x)")] THEN
      REWRITE_TAC [← MESON [LE_REFL] (← q r"?n. 1 <= n")])
    prove
     r"!s:real^M->bool t:real^N->bool.
          analytic s /\ analytic t ==> analytic(s PCROSS t)"
     (REPEAT GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [analytic] THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [← GSYM SUSLIN_SUSLIN] THEN
      ONCE_REWRITE_TAC [suslin] THEN
      REWRITE_TAC [IN, IN_ELIM_THM, ← GSYM analytic] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:num list->real^N->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
      EXISTS_TAC (← q r"\l. (s:real^M->bool) PCROSS (f:num list->real^N->bool) l") THEN
      ASM_SIMP_TAC [lemma] THEN
      REWRITE_TAC [suslin_operation, PCROSS_UNIONS, PCROSS_INTERS, ← SET_RULE
       (← q r"{f y | y IN {g x | P x}} = {f(g x) | P x}")] THEN
      REWRITE_TAC [← SET_RULE (← q r"{f x | P x} = {} <=> ~(?x. P x)")] THEN
      REWRITE_TAC [← MESON [LE_REFL] (← q r"?n. 1 <= n")])

  let ANALYTIC_BOREL_MEASURABLE_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        f borel_measurable_on s /\ analytic s /\ analytic t
        ==> analytic {x | x IN s /\ f x IN t}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"(:real^N)"]
          BOREL_MEASURABLE_EXTENSION) THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, BOREL_UNIV, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real^M->real^N") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ (f:real^M->real^N) x IN t} =
      s INTER {x | x IN (:real^M) /\ g x IN t}")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC ANALYTIC_INTER THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY UNDISCH_TAC
     [← q r"analytic(t:real^N->bool)",
      ← q r"(g:real^M->real^N) borel_measurable_on (:real^M)"] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN DISCH_TAC THEN
    REWRITE_TAC [analytic] THEN
    GEN_REWRITE_TAC (RAND_CONV o RATOR_CONV) [← GSYM SUSLIN_SUSLIN] THEN
    GEN_REWRITE_TAC (BINOP_CONV o RATOR_CONV) [suslin] THEN
    GEN_REWRITE_TAC BINOP_CONV [← GSYM IN] THEN
    SPEC_TAC (← q r"t:real^N->bool", ← q r"t:real^N->bool") THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"c:num list->real^N->bool") THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IN] THEN DISCH_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [IN] THEN
    REWRITE_TAC [← GSYM analytic, IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"\l:num list. {x | x IN UNIV /\ (g:real^M->real^N) x IN c l}") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC BOREL_IMP_ANALYTIC THEN
      MATCH_MP_TAC BOREL_BOREL_MEASURABLE_PREIMAGE THEN
      ASM_SIMP_TAC [COMPACT_IMP_BOREL, BOREL_UNIV],
      GEN_REWRITE_TAC id [EXTENSION] THEN
      REWRITE_TAC [suslin_operation, IN_ELIM_THM] THEN
      REWRITE_TAC [UNIONS_GSPEC, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      MP_TAC LE_REFL THEN SET_TAC []])

  let ANALYTIC_CONTINUOUS_PREIMAGE ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ analytic s /\ analytic t
        ==> analytic {x | x IN s /\ f x IN t}"
   (SIMP_TAC [ANALYTIC_BOREL_MEASURABLE_PREIMAGE,
              CONTINUOUS_IMP_BOREL_MEASURABLE_ON])

  let ANALYTIC_CONTINUOUS_IMAGE ← do
    let lemma ← prove
     r"!f:real^M->real^N s.
            f continuous_on (:real^M) /\ analytic s
            ==> analytic(IMAGE f s)"
     (REPEAT GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [analytic] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) SUSLIN_REGULAR o
        rator o lhand o snd) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [SUBSET, IN] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC COMPACT_INTERS THEN ASM SET_TAC [],
        DISCH_THEN (fun th => GEN_REWRITE_TAC (LAND_CONV o RATOR_CONV) [th])] THEN
      REWRITE_TAC [suslin, IN_ELIM_THM, IN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:num list->real^M->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM SUBST1_TAC THEN
      EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) o (t:num list->real^M->bool)") THEN
      REWRITE_TAC [suslin_operation, o_DEF] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [COMPACT_CONTINUOUS_IMAGE, CONTINUOUS_ON_SUBSET,
                       SUBSET_UNIV],
        REWRITE_TAC [IMAGE_UNIONS]] THEN
      REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o] THEN AP_TERM_TAC THEN
      MATCH_MP_TAC IMAGE_EQ THEN
      X_GEN_TAC (← q r"s:num->num") THEN REWRITE_TAC [o_THM, IN_UNIV] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) CONTINUOUS_IMAGE_NESTED_INTERS_GEN o
            lhand o snd) THEN
      ASM_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN DISCH_THEN MATCH_MP_TAC THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_SIMP_TAC [← GSYM LENGTH_EQ_NIL, LENGTH_LIST_OF_SEQ, LE_1] THEN
        ASM_ARITH_TAC])
    prove
     r"!f:real^M->real^N s.
          analytic s /\ f continuous_on s ==> analytic(IMAGE f s)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"IMAGE (f:real^M->real^N) s =
        IMAGE sndcart {x | x IN s PCROSS (:real^N) /\
                           (f(fstcart x) - sndcart x) IN {vec 0}}")
      SUBST1_TAC THENL
       [REWRITE_TAC [VECTOR_SUB_EQ, IN_SING, EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
        REWRITE_TAC [IN_ELIM_THM, EXISTS_PASTECART, FORALL_PASTECART] THEN
        REWRITE_TAC [SNDCART_PASTECART, PASTECART_INJ, FSTCART_PASTECART] THEN
        REWRITE_TAC [PASTECART_IN_PCROSS, IN_UNIV] THEN MESON_TAC [],
        MATCH_MP_TAC lemma THEN
        SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
        MATCH_MP_TAC ANALYTIC_CONTINUOUS_PREIMAGE THEN
        ASM_SIMP_TAC [ANALYTIC_PCROSS, ANALYTIC_UNIV] THEN
        SIMP_TAC [CLOSED_SING, CLOSED_IMP_ANALYTIC] THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUB THEN
        SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART] THEN
        ASM_REWRITE_TAC [IMAGE_FSTCART_PCROSS, UNIV_NOT_EMPTY]])

  return { ANALYTIC_PCROSS, ANALYTIC_BOREL_MEASURABLE_PREIMAGE, ANALYTIC_CONTINUOUS_PREIMAGE,
           ANALYTIC_CONTINUOUS_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Invariance and images of analytic sets.  (topology.ml 35390-35456)        -/
/- ------------------------------------------------------------------------- -/

structure ANH where
  HOMEOMORPHIC_ANALYTICITY : thm
  ANALYTIC_TRANSLATION : thm
  ANALYTIC_LINEAR_IMAGE : thm
  ANALYTIC_PCROSS_EQ : thm
  ANALYTIC_BOREL_MEASURABLE_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupANH [HolBase] (D : TopologyDeps) (BLPT : LPT) (BLCP : LCP) (BHMA : HMA) (BHMB : HMB)
    (BBMS : BMS) (BBMX : BMX) (BANA : ANA) (BANP : ANP) : ExceptT String IO ANH := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, add_linear_invariants, add_translation_invariants, .. } := D
  let { EXISTS_PASTECART, EXTENSION, .. } := D.core1
  let { FORALL_PASTECART, FSTCART_PASTECART, IMAGE_FSTCART_PCROSS, IMAGE_SNDCART_PCROSS,
        IN_ELIM_THM, IN_IMAGE, IN_SING, .. } := D.core2
  let { IN_UNIV, PASTECART_INJ, PASTECART_IN_PCROSS, PCROSS_EMPTY, .. } := D.core3
  let { SNDCART_PASTECART, .. } := D.core5
  let { UNIV_NOT_EMPTY, o_DEF, .. } := D.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { VECTOR_SUB_EQ, .. } := D.vec4
  let { CLOSED_SING, .. } := BLPT
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { homeomorphic, homeomorphism, .. } := BHMA
  let { HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF, HOMEOMORPHIC_TRANSLATION_SELF, .. } := BHMB
  let { BOREL_MEASURABLE_SUB, CONTINUOUS_IMP_BOREL_MEASURABLE_ON, .. } := BBMS
  let { BOREL_MEASURABLE_COMPOSE, .. } := BBMX
  let { ANALYTIC_EMPTY, ANALYTIC_UNIV, CLOSED_IMP_ANALYTIC, .. } := BANA
  let { ANALYTIC_BOREL_MEASURABLE_PREIMAGE, ANALYTIC_CONTINUOUS_IMAGE, ANALYTIC_PCROSS, .. } :=
    BANP
  -- @@SCOPE END

  let HOMEOMORPHIC_ANALYTICITY ← prove
   r"!s:real^M->bool t:real^N->bool.
     s homeomorphic t ==> (analytic s <=> analytic t)"
   (REWRITE_TAC [homeomorphic, homeomorphism] THEN
    MESON_TAC [ANALYTIC_CONTINUOUS_IMAGE])

  let ANALYTIC_TRANSLATION ← prove
   r"!a:real^N s. analytic (IMAGE (\x. a + x) s) <=> analytic s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_ANALYTICITY THEN
    REWRITE_TAC [HOMEOMORPHIC_TRANSLATION_SELF])

  add_translation_invariants [ANALYTIC_TRANSLATION]

  let ANALYTIC_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (analytic(IMAGE f s) <=> analytic s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_ANALYTICITY THEN
    MATCH_MP_TAC HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF THEN
    ASM_REWRITE_TAC [])

  add_linear_invariants [ANALYTIC_LINEAR_IMAGE]

  let ANALYTIC_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        analytic(s PCROSS t) <=> s = {} \/ t = {} \/ analytic s /\ analytic t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, ANALYTIC_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, ANALYTIC_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [ANALYTIC_PCROSS] THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPEC (← q r"fstcart:real^(M,N)finite_sum->real^M")
          ANALYTIC_CONTINUOUS_IMAGE),
      MP_TAC (← ISPEC (← q r"sndcart:real^(M,N)finite_sum->real^N")
          ANALYTIC_CONTINUOUS_IMAGE)] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(s:real^M->bool) PCROSS (t:real^N->bool)")) THEN
    ASM_REWRITE_TAC [IMAGE_FSTCART_PCROSS, IMAGE_SNDCART_PCROSS] THEN
    DISCH_THEN MATCH_MP_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
    REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART])

  let ANALYTIC_BOREL_MEASURABLE_IMAGE ← prove
   r"!f:real^M->real^N s.
        analytic s /\ f borel_measurable_on s ==> analytic(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"IMAGE (f:real^M->real^N) s =
      IMAGE sndcart {x | x IN s PCROSS (:real^N) /\
                         (f(fstcart x) - sndcart x) IN {vec 0}}")
    SUBST1_TAC THENL
     [REWRITE_TAC [VECTOR_SUB_EQ, IN_SING, EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_ELIM_THM, EXISTS_PASTECART, FORALL_PASTECART] THEN
      REWRITE_TAC [SNDCART_PASTECART, PASTECART_INJ, FSTCART_PASTECART] THEN
      REWRITE_TAC [PASTECART_IN_PCROSS, IN_UNIV] THEN MESON_TAC [],
      MATCH_MP_TAC ANALYTIC_CONTINUOUS_IMAGE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
      MATCH_MP_TAC ANALYTIC_BOREL_MEASURABLE_PREIMAGE THEN
      ASM_SIMP_TAC [ANALYTIC_PCROSS, ANALYTIC_UNIV] THEN
      SIMP_TAC [CLOSED_SING, CLOSED_IMP_ANALYTIC] THEN
      MATCH_MP_TAC BOREL_MEASURABLE_SUB THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, CONTINUOUS_IMP_BOREL_MEASURABLE_ON,
                LINEAR_SNDCART] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC BOREL_MEASURABLE_COMPOSE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART,
                CONTINUOUS_IMP_BOREL_MEASURABLE_ON] THEN
      ASM_REWRITE_TAC [IMAGE_FSTCART_PCROSS, UNIV_NOT_EMPTY]])

  return { HOMEOMORPHIC_ANALYTICITY, ANALYTIC_TRANSLATION, ANALYTIC_LINEAR_IMAGE,
           ANALYTIC_PCROSS_EQ, ANALYTIC_BOREL_MEASURABLE_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Cardinalities of analytic and Borel sets and of Borel and Baire functions. -/
/- (topology.ml 35457-35539)                                                 -/
/- ------------------------------------------------------------------------- -/

structure CRB where
  CARD_EQ_ANALYTIC_SETS : thm
  CARD_EQ_BOREL_SETS : thm
  CARD_EQ_BOREL_MEASURABLE_FUNCTIONS : thm
  CARD_EQ_BAIRE_FUNCTIONS : thm
  deriving Inhabited

@[nospecialize]
def setupCRB [HolBase] (D : TopologyDeps) (BEUC : EUC) (BBAL : BAL) (BCRD1 : CRD1) (BSEC : SEC)
    (BCEO : CEO) (BBOR2 : BOR2) (BBAI1 : BAI1) (BBMS : BMS) (BBMC : BMC) (BANA : ANA) :
    ExceptT String IO CRB := do
  -- @@SCOPE BEGIN
  let { SET_RULE, SET_TAC, .. } := D
  let { ETA_AX, EXTENSION, .. } := D.core1
  let { FORALL_IN_GSPEC, FUN_EQ_THM, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, .. } := D.core3
  let { REAL_LT_REFL, .. } := D.core4
  let { SIMPLE_IMAGE, SUBSET, .. } := D.core5
  let { le_c, .. } := D.core6
  let { CARD_EQ_IMAGE, CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_EXP_LE_REAL, CARD_LE_ANTISYM,
        CARD_LE_SUBSET, CARD_LE_TRANS, exp_c, .. } := D.lib1
  let { CARD_SUSLIN_EQ, .. } := D.misc
  let { DIST_NZ, .. } := D.vec1
  let { OPEN_UNIV, .. } := BEUC
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, .. } := BBAL
  let { CARD_EQ_EUCLIDEAN, .. } := BCRD1
  let { UNIV_SECOND_COUNTABLE, .. } := BSEC
  let { CARD_EQ_COMPACT_SETS, .. } := BCEO
  let { COMPACT_IMP_BOREL, OPEN_IMP_BOREL, .. } := BBOR2
  let { BAIRE_CONST, .. } := BBAI1
  let { BAIRE_IMP_BOREL_MEASURABLE, BOREL_MEASURABLE_CONST, .. } := BBMS
  let { BOREL_BOREL_MEASURABLE_PREIMAGE, .. } := BBMC
  let { BOREL_IMP_ANALYTIC, analytic, .. } := BANA
  -- @@SCOPE END

  let CARD_EQ_ANALYTIC_SETS ← prove
   r"{s:real^N->bool | analytic s} =_c (:real)"
   (REWRITE_TAC [analytic] THEN REWRITE_TAC [ETA_AX, ← SET_RULE (← q r"{x | s x} = s")] THEN
    MATCH_MP_TAC CARD_SUSLIN_EQ THEN
    GEN_REWRITE_TAC LAND_CONV [← SET_RULE (← q r"s = {x | s x}")] THEN
    REWRITE_TAC [CARD_EQ_COMPACT_SETS])

  let CARD_EQ_BOREL_SETS ← prove
   r"{s:real^N->bool | borel s} =_c (:real)"
   (REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"{s:real^N->bool | analytic s}") THEN
      SIMP_TAC [CARD_EQ_IMP_LE, CARD_EQ_ANALYTIC_SETS] THEN
      MATCH_MP_TAC CARD_LE_SUBSET THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, BOREL_IMP_ANALYTIC],
      TRANS_TAC CARD_LE_TRANS (← q r"{s:real^N->bool | compact s}") THEN
      SIMP_TAC [CARD_EQ_IMP_LE,
                ← ONCE_REWRITE_RULE [CARD_EQ_SYM] CARD_EQ_COMPACT_SETS] THEN
      MATCH_MP_TAC CARD_LE_SUBSET THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, COMPACT_IMP_BOREL]])

  let CARD_EQ_BOREL_MEASURABLE_FUNCTIONS ← prove
   r"{f:real^M->real^N | f borel_measurable_on UNIV} =_c (:real)"
   (REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [ALL_TAC,
      TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
        REWRITE_TAC [CARD_EQ_EUCLIDEAN],
        ALL_TAC] THEN
      TRANS_TAC CARD_LE_TRANS (← q r"{(\x. c):real^M->real^N | c IN UNIV}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
        REWRITE_TAC [SIMPLE_IMAGE] THEN MATCH_MP_TAC CARD_EQ_IMAGE THEN
        SIMP_TAC [FUN_EQ_THM],
        MATCH_MP_TAC CARD_LE_SUBSET THEN SIMP_TAC [SUBSET, FORALL_IN_GSPEC] THEN
        REWRITE_TAC [IN_ELIM_THM, BOREL_MEASURABLE_CONST]]] THEN
    X_CHOOSE_THEN (← q r"B:(real^N->bool)->bool") STRIP_ASSUME_TAC
          UNIV_SECOND_COUNTABLE THEN
    TRANS_TAC CARD_LE_TRANS
     (← q r"{s:real^M->bool | borel s} ^_c (B:(real^N->bool)->bool)") THEN
    ASM_SIMP_TAC [CARD_EQ_BOREL_SETS, CARD_EQ_IMP_LE, CARD_EXP_LE_REAL] THEN
    REWRITE_TAC [le_c, exp_c, IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"\f:real^M->real^N b.
                  if b IN B then {x | x IN UNIV /\ f x IN b} else @y. F") THEN
    ASM_SIMP_TAC [BOREL_BOREL_MEASURABLE_PREIMAGE, OPEN_IMP_BOREL, OPEN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^M->real^N"] THEN
    STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:real^M") THEN
    GEN_REWRITE_TAC id [← TAUT (← q r"p <=> ~ ~p")] THEN PURE_REWRITE_TAC [DIST_NZ] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"?b. b IN B /\ f(x:real^M) IN b /\
                      b SUBSET ball(f x:real^N,dist(f x,g x))")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"(f:real^M->real^N) x", ← q r"dist((f:real^M->real^N) x,g x)"]
          OPEN_BALL) THEN
      MP_TAC (← ISPECL [← q r"(f:real^M->real^N) x", ← q r"dist((f:real^M->real^N) x,g x)"]
          CENTRE_IN_BALL) THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o C AP_THM (← q r"b:real^N->bool"))] THEN
    ASM_REWRITE_TAC [EXTENSION] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
    ASM_REWRITE_TAC [IN_UNIV, IN_ELIM_THM] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g:real^M->real^N) x") o
          GEN_REWRITE_RULE id [SUBSET]) THEN
    REWRITE_TAC [IN_BALL, REAL_LT_REFL])

  let CARD_EQ_BAIRE_FUNCTIONS ← prove
   r"{f:real^M->real^N | baire k UNIV f} =_c (:real)"
   (REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS
        (← q r"{f:real^M->real^N | f borel_measurable_on UNIV}") THEN
      SIMP_TAC [CARD_EQ_BOREL_MEASURABLE_FUNCTIONS, CARD_EQ_IMP_LE] THEN
      MATCH_MP_TAC CARD_LE_SUBSET THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, BAIRE_IMP_BOREL_MEASURABLE],
      TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
        REWRITE_TAC [CARD_EQ_EUCLIDEAN],
        ALL_TAC] THEN
      TRANS_TAC CARD_LE_TRANS (← q r"{(\x. c):real^M->real^N | c IN UNIV}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
        REWRITE_TAC [SIMPLE_IMAGE] THEN MATCH_MP_TAC CARD_EQ_IMAGE THEN
        SIMP_TAC [FUN_EQ_THM],
        MATCH_MP_TAC CARD_LE_SUBSET THEN SIMP_TAC [SUBSET, FORALL_IN_GSPEC] THEN
        REWRITE_TAC [IN_ELIM_THM, BAIRE_CONST]]])

  return { CARD_EQ_ANALYTIC_SETS, CARD_EQ_BOREL_SETS, CARD_EQ_BOREL_MEASURABLE_FUNCTIONS,
           CARD_EQ_BAIRE_FUNCTIONS }

/- ------------------------------------------------------------------------- -/
/- Some Borel variants of the measurability of the Banach indicatrix.        -/
/- (topology.ml 35540-35710)                                                 -/
/- ------------------------------------------------------------------------- -/

structure BIX where
  FSIGMA_PREIMAGE_CARD_GE : thm
  GDELTA_PREIMAGE_CARD_LE : thm
  BOREL_PREIMAGE_HAS_SIZE : thm
  BOREL_PREIMAGE_FINITE : thm
  BOREL_PREIMAGE_INFINITE : thm
  deriving Inhabited

@[nospecialize]
def setupBIX [HolBase] (D : TopologyDeps) (BBAL : BAL) (BCLS1 : CLS1) (BCPP1 : CPP1)
    (BCSL : CSL) (BDYR : DYR) (BFSG1 : FSG1) (BFSG2 : FSG2) (BFSG3 : FSG3) (BBOR2 : BOR2) :
    ExceptT String IO BIX := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, NORM_ARITH,
        .. } := D
  let { CHOOSE_SUBSET_EQ, CONJ_ASSOC, EXTENSION, FINITE_IMAGE, .. } := D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, HAS_SIZE, HAS_SIZE_0, HAS_SIZE_IMAGE_INJ, INFINITE,
        INTERS_IMAGE, INTER_SUBSET, IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, PAIRWISE_IMAGE, .. } := D.core3
  let { RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET, .. } := D.core5
  let { UNIONS_GSPEC, UNIONS_IMAGE, pairwise, .. } := D.core6
  let { COUNTABLE_FINITE_SUBSETS, COUNTABLE_IMAGE, COUNTABLE_PRODUCT_DEPENDENT,
        COUNTABLE_RESTRICT, NUM_COUNTABLE, .. } := D.lib1
  let { RATIONAL_BETWEEN, .. } := D.lib2
  let { COUNTABLE_RATIONAL, COUNTABLE_RATIONAL_COORDINATES, .. } := D.misc
  let { DIST_SYM, .. } := D.vec1
  let { IN_BALL, OPEN_BALL, .. } := BBAL
  let { CLOSURE_APPROACHABLE, .. } := BCLS1
  let { FINITE_EQ_BOUNDED_DISCRETE, .. } := BCPP1
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CLOSURE_RATIONAL_COORDINATES, .. } := BDYR
  let { GDELTA_COMPLEMENT, OPEN_IMP_FSIGMA, .. } := BFSG1
  let { FSIGMA_INTER, FSIGMA_INTERS, FSIGMA_UNIONS, .. } := BFSG2
  let { FSIGMA_CONTINUOUS_IMAGE, .. } := BFSG3
  let { BOREL_COMPLEMENT, BOREL_DIFF, BOREL_UNIONS, FSIGMA_IMP_BOREL, GDELTA_IMP_BOREL, .. } :=
    BBOR2
  -- @@SCOPE END

  let FSIGMA_PREIMAGE_CARD_GE ← prove
   r"!f:real^M->real^N s n.
        f continuous_on s /\ fsigma s
        ==> fsigma {y | FINITE {x | x IN s /\ f x = y}
                        ==> n <= CARD {x | x IN s /\ f x = y}}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CHOOSE_SUBSET_EQ] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"t SUBSET {x | x IN s /\ P x} /\ Q t <=>
      t SUBSET s /\ Q t /\ (!x. x IN t ==> P x)")] THEN
    SUBGOAL_THEN
     (← q r"{y | ?t. t SUBSET s /\ t HAS_SIZE n /\ (!x. x IN t ==> f x = y)} =
      UNIONS (IMAGE (\b. INTERS (IMAGE (IMAGE (f:real^M->real^N)) b))
       {b | b SUBSET {s INTER ball(a,r) |
                      (!i. 1 <= i /\ i <= dimindex(:M) ==> rational(a$i)) /\
                      rational r} /\
            b HAS_SIZE n /\ pairwise DISJOINT b})")
    SUBST1_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC FSIGMA_UNIONS THEN CONJ_TAC THENL
       [MATCH_MP_TAC COUNTABLE_IMAGE THEN REWRITE_TAC [HAS_SIZE] THEN
        REWRITE_TAC [← SET_RULE
         (← q r"b SUBSET s /\ (FINITE b /\ Q b) /\ R b <=>
          b IN {c | c SUBSET s /\ FINITE c} /\ Q b /\ R b")] THEN
        MATCH_MP_TAC COUNTABLE_RESTRICT THEN
        MATCH_MP_TAC COUNTABLE_FINITE_SUBSETS THEN
        ONCE_REWRITE_TAC [← SET_RULE
        (← q r"{f x y | P x /\ Q y} =
         {f x y | x IN {z | P z} /\ y IN Q}")] THEN
        MATCH_MP_TAC COUNTABLE_PRODUCT_DEPENDENT THEN
        REWRITE_TAC [COUNTABLE_RATIONAL_COORDINATES, COUNTABLE_RATIONAL],
        REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_GSPEC, HAS_SIZE] THEN
        X_GEN_TAC (← q r"b:(real^M->bool)->bool") THEN STRIP_TAC THEN
        MATCH_MP_TAC FSIGMA_INTERS THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
        REWRITE_TAC [FORALL_IN_IMAGE] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← SET_RULE
           (← q r"b SUBSET c ==> (!x. x IN c ==> P x) ==> (!x. x IN b ==> P x)"))) THEN
        REWRITE_TAC [FORALL_IN_GSPEC] THEN
        MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"r:real"] THEN
        DISCH_THEN (K ALL_TAC) THEN
        MATCH_MP_TAC FSIGMA_CONTINUOUS_IMAGE THEN
        ASM_SIMP_TAC [FSIGMA_INTER, OPEN_IMP_FSIGMA, OPEN_BALL] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTER_SUBSET]]] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM, INTERS_IMAGE] THEN EQ_TAC THENL
     [ALL_TAC,
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:(real^M->bool)->bool") MP_TAC) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [IN_IMAGE] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"p:(real^M->bool)->real^M") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"IMAGE (p:(real^M->bool)->real^M) b") THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE, SUBSET] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← SET_RULE
           (← q r"(!x. x IN b ==> Q x) ==> (!x. x IN b ==> Q x ==> P x)
            ==> (!x. x IN b ==> P x)"))) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← SET_RULE
           (← q r"b SUBSET c ==> (!x. x IN c ==> P x) ==> (!x. x IN b ==> P x)"))) THEN
        REWRITE_TAC [FORALL_IN_GSPEC] THEN SET_TAC [],
        MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN ASM_REWRITE_TAC [] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC []]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"t:real^M->bool") FINITE_EQ_BOUNDED_DISCRETE) THEN
    ASM_CASES_TAC (← q r"FINITE(t:real^M->bool)") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [HAS_SIZE]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC o CONJUNCT2) THEN
    MP_TAC (← ISPECL [← q r"&0", ← q r"r / &4"] RATIONAL_BETWEEN) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"q:real") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN t
          ==> ?a. (!i. 1 <= i /\ i <= dimindex(:M) ==> rational(a$i)) /\
                  x IN ball(a:real^M,q)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"x:real^M",
       ← q r"{a:real^M | !i. 1 <= i /\ i <= dimindex(:M) ==> rational(a$i)}"]
          CLOSURE_APPROACHABLE) THEN
      REWRITE_TAC [CLOSURE_RATIONAL_COORDINATES, IN_UNIV, IN_BALL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"q:real")) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [DIST_SYM],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:real^M->real^M") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"IMAGE (\x. s INTER ball((a:real^M->real^M) x,q)) t") THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, ← GSYM CONJ_ASSOC] THEN CONJ_TAC THENL
       [REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← TAUT (← q r"r /\ (r ==> p /\ q) ==> p /\ q /\ r")) THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (ASSUME_TAC o MATCH_MP (← SET_RULE
       (← q r"(!s. P s ==> y IN IMAGE f (g s))
        ==> (!s. P s ==> ~(g s = {}))"))) THEN
      SUBGOAL_THEN
       (← q r"pairwise (\x y. DISJOINT (s INTER ball ((a:real^M->real^M) x,q))
                                 (s INTER ball(a y,q))) t")
      MP_TAC THENL
       [REWRITE_TAC [pairwise] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN STRIP_TAC THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. ~(x IN t /\ x IN u)) ==> DISJOINT (s INTER t) (s INTER u)")) THEN
        SUBGOAL_THEN (← q r"x IN ball(a x,q) /\ y IN ball(a y:real^M,q)") MP_TAC THENL
         [ASM_SIMP_TAC [], ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^M", ← q r"y:real^M"]) THEN
        ASM_REWRITE_TAC [IN_BALL] THEN UNDISCH_TAC (← q r"q < r / &4") THEN
        CONV_TAC (fun t => NORM_ARITH t),
        REWRITE_TAC [PAIRWISE_IMAGE] THEN SIMP_TAC [pairwise] THEN DISCH_TAC THEN
        MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN ASM_REWRITE_TAC [] THEN
        ASM_MESON_TAC [← SET_RULE
         (← q r"~(s = {}) /\ ~(t = {}) /\ DISJOINT s t ==> ~(s = t)")]]])

  let GDELTA_PREIMAGE_CARD_LE ← prove
   r"!f:real^M->real^N s n.
        f continuous_on s /\ fsigma s
        ==> gdelta {y | FINITE {x | x IN s /\ f x = y} /\
                        CARD {x | x IN s /\ f x = y} <= n}"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | P x /\ Q x} = UNIV DIFF {x | P x ==> ~Q x}")] THEN
    REWRITE_TAC [GDELTA_COMPLEMENT, ← ARITH_RULE (← q r"~(m <= n) <=> SUC n <= m")] THEN
    ASM_SIMP_TAC [FSIGMA_PREIMAGE_CARD_GE])

  let BOREL_PREIMAGE_HAS_SIZE ← prove
   r"!f:real^M->real^N s n.
        f continuous_on s /\ fsigma s
        ==> borel {y | {x | x IN s /\ f x = y} HAS_SIZE n}"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"n = 0") THENL
     [ASM_REWRITE_TAC [HAS_SIZE_0, ← SET_RULE
       (← q r"{y | {x | x IN s /\ f x = y} = {}} = UNIV DIFF IMAGE f s")] THEN
      REWRITE_TAC [BOREL_COMPLEMENT] THEN MATCH_MP_TAC FSIGMA_IMP_BOREL THEN
      ASM_MESON_TAC [FSIGMA_CONTINUOUS_IMAGE],
      REWRITE_TAC [HAS_SIZE] THEN FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC
       [← MATCH_MP (← ARITH_RULE (← q r"~(n = 0) ==> (x = n <=> x <= n /\ ~(x <= n - 1))"))
          th]))] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{x | P x /\ Q x /\ ~R x} = {x | P x /\ Q x} DIFF {x | P x /\ R x}")] THEN
    MATCH_MP_TAC BOREL_DIFF THEN CONJ_TAC THEN
    MATCH_MP_TAC GDELTA_IMP_BOREL THEN MATCH_MP_TAC GDELTA_PREIMAGE_CARD_LE THEN
    ASM_REWRITE_TAC [])

  let BOREL_PREIMAGE_FINITE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ fsigma s
        ==> borel {y | FINITE {x | x IN s /\ f x = y}}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{y | FINITE {x | x IN s /\ (f:real^M->real^N) x = y}} =
      UNIONS {{y | {x | x IN s /\ f x = y} HAS_SIZE n} | n IN (:num)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC, EXTENSION, IN_ELIM_THM, IN_UNIV] THEN
      MESON_TAC [HAS_SIZE],
      MATCH_MP_TAC BOREL_UNIONS THEN
      ASM_SIMP_TAC [FORALL_IN_GSPEC, BOREL_PREIMAGE_HAS_SIZE] THEN
      SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE]])

  let BOREL_PREIMAGE_INFINITE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ fsigma s
        ==> borel {y | INFINITE {x | x IN s /\ f x = y}}"
   (REWRITE_TAC [INFINITE, ← SET_RULE (← q r"{x | ~P x} = UNIV DIFF {x | P x}")] THEN
    REWRITE_TAC [BOREL_COMPLEMENT, BOREL_PREIMAGE_FINITE])

  return { FSIGMA_PREIMAGE_CARD_GE, GDELTA_PREIMAGE_CARD_LE, BOREL_PREIMAGE_HAS_SIZE,
           BOREL_PREIMAGE_FINITE, BOREL_PREIMAGE_INFINITE }

/- ------------------------------------------------------------------------- -/
/- Forms of the Baire property of dense sets.  (topology.ml 35707-35822)     -/
/- ------------------------------------------------------------------------- -/

structure BAR where
  BAIRE : thm
  BAIRE_ALT : thm
  NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED_IN : thm
  NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED : thm
  NOWHERE_DENSE_COUNTABLE_UNIONS : thm
  deriving Inhabited

@[nospecialize]
def setupBAR [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLO : CLO) (BBAL : BAL) (BLOC : LOC)
    (BINT : INT) (BCLS1 : CLS1) (BLCC1 : LCC1) (BLCC2 : LCC2) : ExceptT String IO BAR := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DIFF_INTERS, DIFF_UNIONS, EXISTS_IN_IMAGE, EXTENSION, .. } := D.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_ID, IMP_CONJ_ALT, INTERS_IMAGE, INTERS_SUBSET,
        INTER_SUBSET, INTER_UNIONS, IN_DIFF, IN_INTER, .. } := D.core2
  let { NOT_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, .. } := D.core5
  let { UNIONS_0, UNIONS_MONO, UNIONS_MONO_IMAGE, .. } := D.core6
  let { COUNTABLE_IMAGE, .. } := D.lib1
  let { DIST_SYM, .. } := D.vec1
  let { BAIRE_CATEGORY, CLOSURE_OF_SUBTOPOLOGY, .. } := D.met1
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, INTERIOR_OF_CLOSURE_OF, INTERIOR_OF_EMPTY, .. } := D.met2
  let { OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.met3
  let { HAUSDORFF_SPACE_EUCLIDEAN, OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CLOSED_IN, .. } := BCLO
  let { CENTRE_IN_BALL, IN_BALL, OPEN_BALL, .. } := BBAL
  let { CLOSED_IN_CLOSED_INTER, OPEN_IN_OPEN_INTER, .. } := BLOC
  let { EUCLIDEAN_INTERIOR_OF, SUBSET_INTERIOR, .. } := BINT
  let { CLOSED_CLOSURE, CLOSURE_APPROACHABLE, CLOSURE_EMPTY, CLOSURE_SUBSET,
        EUCLIDEAN_CLOSURE_OF, SUBSET_CLOSURE, .. } := BCLS1
  let { LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN, .. } := BLCC1
  let { LOCALLY_COMPACT_UNIV, .. } := BLCC2
  -- @@SCOPE END

  let BAIRE ← prove
   r"!g s:real^N->bool.
        locally compact s /\ COUNTABLE g /\
        (!t. t IN g
             ==> open_in (subtopology euclidean s) t /\ s SUBSET closure t)
        ==> s SUBSET closure(INTERS g)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology euclidean (s:real^N->bool)",
                      ← q r"g:(real^N->bool)->bool"]
          BAIRE_CATEGORY) THEN
    ASM_REWRITE_TAC [LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN] THEN
    SIMP_TAC [HAUSDORFF_SPACE_EUCLIDEAN, HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER t = s <=> s SUBSET t")] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET,
                     ← SET_RULE (← q r"t SUBSET s ==> s INTER t = t")],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
      MATCH_MP_TAC SUBSET_CLOSURE THEN REWRITE_TAC [INTER_SUBSET]])

  let BAIRE_ALT ← prove
   r"!g s:real^N->bool.
        locally compact s /\ ~(s = {}) /\ COUNTABLE g /\ UNIONS g = s
        ==> ?t u. t IN g /\ open_in (subtopology euclidean s) u /\ ~(u = {}) /\
                  u SUBSET (closure t)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
    [← q r"IMAGE (\t:real^N->bool. s DIFF closure t) g", ← q r"s:real^N->bool"] BAIRE) THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    MATCH_MP_TAC (← TAUT (← q r"~q /\ (~r ==> p) ==> (p ==> q) ==> r")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"~(s = {}) /\ (t = {} ==> closure t = {}) /\ t = {}
        ==> ~(s SUBSET closure t)")) THEN
      ASM_SIMP_TAC [CLOSURE_EMPTY] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"i SUBSET s /\ s DIFF i = s ==> i = {}")) THEN
      CONJ_TAC THENL [REWRITE_TAC [INTERS_IMAGE] THEN ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [DIFF_INTERS] THEN
      REWRITE_TAC [← SET_RULE (← q r"{f x | x IN IMAGE g s} = {f(g x) | x IN s}")] THEN
      REWRITE_TAC [← SET_RULE (← q r"s DIFF (s DIFF t) = s INTER t")] THEN
      REWRITE_TAC [← SET_RULE (← q r"{s INTER closure t | t IN g} =
                            {s INTER t | t IN IMAGE closure g}")] THEN
      SIMP_TAC [← GSYM INTER_UNIONS, ← SET_RULE (← q r"s INTER t = s <=> s SUBSET t")] THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM IMAGE_ID] THEN
      MATCH_MP_TAC UNIONS_MONO_IMAGE THEN REWRITE_TAC [CLOSURE_SUBSET],
      REWRITE_TAC [NOT_EXISTS_THM] THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN REPEAT STRIP_TAC THENL
       [ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s DIFF (s INTER t)")] THEN
        MATCH_MP_TAC OPEN_IN_DIFF THEN
        ASM_SIMP_TAC [CLOSED_IN_CLOSED_INTER, CLOSED_CLOSURE, OPEN_IN_REFL],
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        REWRITE_TAC [CLOSURE_APPROACHABLE] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"t:real^N->bool", ← q r"s INTER ball(x:real^N,e)"]) THEN
        ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL, SUBSET, IN_INTER, IN_BALL,
                      IN_DIFF] THEN
        MP_TAC (← ISPECL [← q r"x:real^N", ← q r"e:real"] CENTRE_IN_BALL) THEN
        ASM_MESON_TAC [DIST_SYM, EXTENSION, IN_INTER, NOT_IN_EMPTY]]])

  let NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED_IN ← prove
   r"!u g:(real^N->bool)->bool.
        locally compact u /\
        COUNTABLE g /\
        (!s. s IN g
             ==> closed_in (subtopology euclidean u) s /\
                 (subtopology euclidean u) interior_of s = {})
        ==> (subtopology euclidean u) interior_of (UNIONS g) = {}"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"g:(real^N->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [INTERIOR_OF_EMPTY, UNIONS_0] THEN
    MP_TAC (← ISPECL [← q r"{u DIFF s:real^N->bool | s IN g}", ← q r"u:real^N->bool"]
          BAIRE) THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL] THEN
      X_GEN_TAC (← q r"s:real^N->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
      ASM_REWRITE_TAC [INTERIOR_OF_CLOSURE_OF] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"c SUBSET d ==> P /\ u DIFF c = {} ==> u SUBSET d")) THEN
      REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
      REWRITE_TAC [← SET_RULE (← q r"u INTER (u DIFF s) = u DIFF s")] THEN SET_TAC [],
      REWRITE_TAC [INTERIOR_OF_CLOSURE_OF, CLOSURE_OF_SUBTOPOLOGY] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"c SUBSET d ==> u SUBSET c ==> u DIFF u INTER d = {}")) THEN
      MATCH_MP_TAC SUBSET_CLOSURE THEN
      REWRITE_TAC [DIFF_UNIONS, SIMPLE_IMAGE, SUBSET_INTER, SUBSET_REFL] THEN
      MATCH_MP_TAC INTERS_SUBSET THEN
      REWRITE_TAC [IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN ASM SET_TAC []])

  let NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED ← prove
   r"!g:(real^N->bool)->bool.
        COUNTABLE g /\ (!s. s IN g ==> closed s /\ interior s = {})
        ==> interior(UNIONS g) = {}"
   (MP_TAC (← ISPEC (← q r"(:real^N)") NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED_IN) THEN
    REWRITE_TAC [SUBTOPOLOGY_UNIV, EUCLIDEAN_INTERIOR_OF, ← GSYM CLOSED_IN] THEN
    REWRITE_TAC [LOCALLY_COMPACT_UNIV])

  let NOWHERE_DENSE_COUNTABLE_UNIONS ← prove
   r"!g:(real^N->bool)->bool.
        COUNTABLE g /\ (!s. s IN g ==> interior(closure s) = {})
        ==> interior(UNIONS g) = {}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE closure (g:(real^N->bool)->bool)")
          NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED) THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, CLOSED_CLOSURE] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> t = {} ==> s = {}")) THEN
    MATCH_MP_TAC SUBSET_INTERIOR THEN MATCH_MP_TAC UNIONS_MONO THEN
    REWRITE_TAC [EXISTS_IN_IMAGE] THEN MESON_TAC [CLOSURE_SUBSET])

  return { BAIRE, BAIRE_ALT, NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED_IN,
           NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED, NOWHERE_DENSE_COUNTABLE_UNIONS }

/- ------------------------------------------------------------------------- -/
/- Some cute Baire applications from Silverman's paper in AMM vol. 102       -/
/- "Intervals Contained in Arithmetic Combinations of Sets". These are       -/
/- somewhat like the Steinhaus/Piccard theorems. There are other variants.   -/
/- (topology.ml 35823-35918)                                                 -/
/- ------------------------------------------------------------------------- -/

structure SIL where
  SILVERMAN_STEINHAUSLIKE : thm
  DENSE_GDELTA_IMP_LARGE : thm
  NOT_GDELTA_DENSE_COUNTABLE : thm
  deriving Inhabited

@[nospecialize]
def setupSIL [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCLS1 : CLS1) (BCPP1 : CPP1)
    (BARC : ARC) (BCCC : CCC) (BCRD1 : CRD1) (BESP : ESP) (BLCC2 : LCC2) (BFSG1 : FSG1)
    (BBAR : BAR) : ExceptT String IO SIL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D
  let { CONJ_SYM, EXISTS_IN_IMAGE, EXISTS_REFL, .. } := D.core1
  let { FINITE_SUBSET, FORALL_IN_IMAGE, FORALL_IN_UNION, IMAGE_INTERS, IMAGE_SUBSET, IMAGE_o,
        INFINITE, INJECTIVE_ON_ALT, INTERSECTION_OF, INTERS_UNION, INTER_COMM, IN_INTER, .. } :=
    D.core2
  let { IN_UNIV, MEMBER_NOT_EMPTY, .. } := D.core3
  let { SUBSET_TRANS, SUBSET_UNIV, .. } := D.core5
  let { SURJECTIVE_IMAGE_EQ, UNWIND_THM2, o_DEF, .. } := D.core6
  let { CARD_EQ_IMP_LE, CARD_EQ_REAL_IMP_UNCOUNTABLE, CARD_EQ_SYM, CARD_LE_ANTISYM,
        CARD_LE_IMAGE, CARD_LE_REFL, CARD_LE_TRANS, CARD_LE_UNIV, CARD_SQUARE_INFINITE,
        COUNTABLE_IMAGE, COUNTABLE_UNION, mul_c, .. } := D.lib1
  let { EUCLIDEAN_SPACE_INFINITE, .. } := D.vec1
  let { SUBTOPOLOGY_UNIV, .. } := D.met3
  let { OPEN_IN, .. } := BEUC
  let { CLOSURE_CLOSED, CLOSURE_EMPTY, CLOSURE_EQ_EMPTY, SUBSET_CLOSURE, .. } := BCLS1
  let { FINITE_IMP_CLOSED, .. } := BCPP1
  let { OPEN_NEGATIONS, OPEN_TRANSLATION, .. } := BARC
  let { CLOSURE_TRANSLATION, .. } := BCCC
  let { CARD_EQ_EUCLIDEAN, .. } := BCRD1
  let { CLOSURE_NEGATIONS, .. } := BESP
  let { LOCALLY_COMPACT_UNIV, .. } := BLCC2
  let { gdelta, .. } := BFSG1
  let { BAIRE, .. } := BBAR
  -- @@SCOPE END

  let SILVERMAN_STEINHAUSLIKE ← prove
   r"!s t:real^N->bool.
        gdelta s /\ gdelta t /\
        (:real^N) SUBSET closure s /\ (:real^N) SUBSET closure t
        ==> {x + y | x IN s /\ y IN t} = (:real^N)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [gdelta, INTERSECTION_OF] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"c:(real^N->bool)->bool") STRIP_ASSUME_TAC) MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"d:(real^N->bool)->bool") STRIP_ASSUME_TAC)
     STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x y | x IN s /\ y IN t} = UNIV <=>
                          !z. ?x y. x IN s /\ y IN t /\ f x y = z")] THEN
    X_GEN_TAC (← q r"r:real^N") THEN ASM_CASES_TAC (← q r"d:(real^N->bool)->bool = {}") THENL
     [SUBGOAL_THEN (← q r"t = (:real^N)") SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [IN_UNIV] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"x + y:real^N = r <=> y = r - x")] THEN
      REWRITE_TAC [UNWIND_THM2, MEMBER_NOT_EMPTY] THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"(:real^N) SUBSET closure s") THEN
      ASM_REWRITE_TAC [CLOSURE_EMPTY] THEN SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"c UNION IMAGE (IMAGE (\x:real^N. r - x)) d", ← q r"(:real^N)"]
     BAIRE) THEN
    ASM_SIMP_TAC [LOCALLY_COMPACT_UNIV, COUNTABLE_UNION, COUNTABLE_IMAGE] THEN
    REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN] THEN ANTS_TAC THENL
     [REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_IMAGE] THEN
      SUBGOAL_THEN (← q r"(\x:real^N. r - x) = (\x. r + x) o (--)") SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF] THEN ABS_TAC THEN CONV_TAC (fun t => VECTOR_ARITH t),
        ALL_TAC] THEN
      ASM_SIMP_TAC [IMAGE_o, OPEN_NEGATIONS, OPEN_TRANSLATION] THEN CONJ_TAC THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN DISCH_TAC THENL
       [TRANS_TAC SUBSET_TRANS (← q r"closure(s:real^N->bool)"),
        SUBGOAL_THEN
         (← q r"(:real^N) = IMAGE (\x. r + x) (IMAGE (--) (:real^N))")
        SUBST1_TAC THENL
         [REWRITE_TAC [← GSYM IMAGE_o] THEN CONV_TAC SYM_CONV THEN
          MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
          REWRITE_TAC [IN_UNIV, o_DEF, EXISTS_REFL,
                       ← VECTOR_ARITH (← q r"r + --x:real^N = y <=> x = r - y")],
          REWRITE_TAC [CLOSURE_NEGATIONS, CLOSURE_TRANSLATION] THEN
          REPLICATE_TAC 2 (MATCH_MP_TAC IMAGE_SUBSET) THEN
          TRANS_TAC SUBSET_TRANS (← q r"closure(t:real^N->bool)")]] THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_CLOSURE THEN ASM SET_TAC [],
      DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE (← q r"UNIV SUBSET s ==> ~(s = {})"))) THEN
      REWRITE_TAC [CLOSURE_EQ_EMPTY, INTERS_UNION] THEN
      ASM_SIMP_TAC [← GSYM (← REWRITE_RULE [INJECTIVE_ON_ALT] IMAGE_INTERS),
                    ← VECTOR_ARITH (← q r"r - x:real^N = r - y <=> x = y")] THEN
      ONCE_REWRITE_TAC [INTER_COMM] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, EXISTS_IN_IMAGE, IN_INTER] THEN
      MESON_TAC [← VECTOR_ARITH (← q r"(r - x) + x:real^N = r")]])

  let DENSE_GDELTA_IMP_LARGE ← prove
   r"!s:real^N->bool.
        gdelta s /\ (:real^N) SUBSET closure s
        ==> s =_c (:real)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"FINITE(s:real^N->bool)") THENL
     [ASM_SIMP_TAC [FINITE_IMP_CLOSED, CLOSURE_CLOSED] THEN
      ASM_MESON_TAC [EUCLIDEAN_SPACE_INFINITE, INFINITE, FINITE_SUBSET],
      ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THEN
    TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THENL
     [REWRITE_TAC [CARD_LE_UNIV] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
      REWRITE_TAC [CARD_EQ_EUCLIDEAN],
      CONJ_TAC THENL
       [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
        REWRITE_TAC [CARD_EQ_EUCLIDEAN],
        MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"s:real^N->bool"]
          SILVERMAN_STEINHAUSLIKE) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
        TRANS_TAC CARD_LE_TRANS (← q r"IMAGE (\(x:real^N,y). x + y) (s *_c s)") THEN
        CONJ_TAC THENL
         [ASM_SIMP_TAC [mul_c, CARD_LE_REFL, ← SET_RULE
          (← q r"IMAGE f {g x y | P x /\ Q y} = {f(g x y) | P x /\ Q y}")],
          TRANS_TAC CARD_LE_TRANS (← q r"((s:real^N->bool) *_c s)") THEN
          REWRITE_TAC [CARD_LE_IMAGE] THEN
          MATCH_MP_TAC CARD_EQ_IMP_LE THEN MATCH_MP_TAC CARD_SQUARE_INFINITE THEN
          ASM_REWRITE_TAC [INFINITE]]]])

  let NOT_GDELTA_DENSE_COUNTABLE ← prove
   r"!s. COUNTABLE s /\ closure s = (:real^N) ==> ~(gdelta s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") DENSE_GDELTA_IMP_LARGE) THEN
    ASM_REWRITE_TAC [SUBSET_UNIV] THEN
    ASM_MESON_TAC [CARD_EQ_REAL_IMP_UNCOUNTABLE])

  return { SILVERMAN_STEINHAUSLIKE, DENSE_GDELTA_IMP_LARGE, NOT_GDELTA_DENSE_COUNTABLE }

/- ------------------------------------------------------------------------- -/
/- Finding borel subsets where a function is injective (mainly looking       -/
/- ahead to measure theory but maybe of some independent interest).          -/
/- (topology.ml 35919-36032)                                                 -/
/- ------------------------------------------------------------------------- -/

structure GCM where
  GDELTA_CONTINUOUS_FUNCTION_MINIMA : thm
  deriving Inhabited

@[nospecialize]
def setupGCM [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLPT : LPT) (BCPT : CPT) (BCSL : CSL)
    (BCMS : CMS) (BIDC : IDC) (BCLC : CLC) (BLCP : LCP) (BPCR1 : PCR1) (BPRP2 : PRP2)
    (BHSP : HSP) (BFSG1 : FSG1) (BFSG2 : FSG2) : ExceptT String IO GCM := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, .. } := D
  let { CART_EQ, EQ_TRANS, EXTENSION, FINITE_IMAGE, FINITE_NUMSEG, .. } := D.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, FUN_EQ_THM, IMAGE_FSTCART_PCROSS,
        IMAGE_SNDCART_PCROSS, IMP_CONJ, IMP_IMP, INTERS_GSPEC, IN_DIFF, IN_ELIM_THM, IN_INTER,
        IN_NUMSEG, IN_SING, .. } := D.core2
  let { IN_UNIV, LEFT_AND_EXISTS_THM, LEFT_EXISTS_AND_THM, MONO_EXISTS, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IMP, OR_EXISTS_THM, PASTECART_IN_PCROSS, .. } := D.core3
  let { REAL_LE_REFL, REAL_LE_TRANS_LT, REAL_LT_REFL, .. } := D.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LE, REAL_SUB_LT, RIGHT_AND_EXISTS_THM,
        RIGHT_EXISTS_AND_THM, SIMPLE_IMAGE, SNDCART_PASTECART, .. } := D.core5
  let { SWAP_EXISTS_THM, SWAP_FORALL_THM, UNIONS_GSPEC, num_WOP, o_DEF, real_ge, .. } := D.core6
  let { COUNTABLE_IMAGE, NUM_COUNTABLE, .. } := D.lib1
  let { FORALL_POS_MONO_1_EQ, .. } := D.misc
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.vec2
  let { VECTOR_SUB_COMPONENT, VECTOR_SUB_EQ, .. } := D.vec4
  let { CLOSED_INTER, CLOSED_INTERS, CLOSED_UNIONS, .. } := BCLO
  let { CLOSED_SING, .. } := BLPT
  let { COMPACT_IMP_CLOSED, .. } := BCPT
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { CONTINUOUS_ON_SUB, .. } := BCMS
  let { CONTINUOUS_ON_COMPOSE, .. } := BIDC
  let { CONTINUOUS_CLOSED_PREIMAGE, .. } := BCLC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_PCROSS, .. } := BPCR1
  let { CLOSED_COMPACT_PROJECTION, .. } := BPRP2
  let { CLOSED_HALFSPACE_COMPONENT_GE, .. } := BHSP
  let { CLOSED_IMP_FSIGMA, CLOSED_IMP_GDELTA, GDELTA_COMPLEMENT, .. } := BFSG1
  let { FSIGMA_UNIONS, GDELTA_INTER, .. } := BFSG2
  -- @@SCOPE END

  let GDELTA_CONTINUOUS_FUNCTION_MINIMA ← do
    let lemma ← prove
     r"(?n. inv(&n + &1) <= x) <=> &0 < x"
     (TRANS_TAC EQ_TRANS (← q r"~(!n. ~(inv(&n + &1) <= x))") THEN CONJ_TAC THENL
       [MESON_TAC [], ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (rand o rand)
        FORALL_POS_MONO_1_EQ o rand o lhand o snd) THEN
      ANTS_TAC THENL [REAL_ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
      REWRITE_TAC [REAL_NOT_LE, ← GSYM REAL_LE_TRANS_LT])
    prove
     r"!f:real^M->real^N s.
          f continuous_on s /\ compact s
          ==> gdelta {x | x IN s /\
                          !y. y IN s /\ f x = f y
                              ==> x = y \/
                                  ?k. 1 <= k /\ k <= dimindex(:M) /\
                                      (!i. 1 <= i /\ i < k
                                           ==> x$i <= y$i) /\
                                      x$k < y$k}"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"{x | x IN s /\
             !y. y IN s /\ (f:real^M->real^N) x = f y
                 ==> x = y \/
                     ?k. 1 <= k /\ k <= dimindex(:M) /\
                         (!i. 1 <= i /\ i < k
                              ==> x$i <= y$i) /\
                         x$k < y$k} =
        s DIFF
        UNIONS {{x | ?t. t IN s /\
                         pastecart t x IN
                         ({z | z IN s PCROSS s /\
                               (f(fstcart z) - f(sndcart z)) IN {vec 0}} INTER
                          UNIONS {{z | z IN s PCROSS s /\
                                       (sndcart z - fstcart z) IN
                                       ({a | a$k >= inv(&n + &1)} INTER
                                        INTERS {{a | a$i >= &0} | i IN 1..k-1})} |
                                  k IN 1..dimindex(:M)})} |
                n IN (:num)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_INTER, IN_SING, IN_UNIV,
                     INTERS_GSPEC] THEN
        REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_IN_PCROSS] THEN
        REWRITE_TAC [EXTENSION, IN_DIFF, IN_ELIM_THM, real_ge, VECTOR_SUB_EQ] THEN
        X_GEN_TAC (← q r"x:real^M") THEN
        ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
        REWRITE_TAC [NOT_EXISTS_THM] THEN AP_TERM_TAC THEN
        GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"y:real^M") THEN
        ASM_CASES_TAC (← q r"(y:real^M) IN s") THEN ASM_REWRITE_TAC [IN_NUMSEG] THEN
        ASM_CASES_TAC (← q r"(f:real^M->real^N) x = f y") THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [NOT_EXISTS_THM] THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
        REWRITE_TAC [← GSYM NOT_EXISTS_THM] THEN
        REWRITE_TAC [LEFT_EXISTS_AND_THM, RIGHT_EXISTS_AND_THM, lemma] THEN
        REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ r /\ s <=> p /\ q /\ s /\ r")] THEN
        REWRITE_TAC [VECTOR_SUB_COMPONENT, REAL_SUB_LE, REAL_SUB_LT] THEN
        REWRITE_TAC [← ARITH_RULE (← q r"1 <= i /\ i <= k - 1 <=> 1 <= i /\ i < k")] THEN
        MATCH_MP_TAC (← TAUT
         (← q r"(p ==> ~r) /\ (~p ==> q \/ r) /\ ~(q /\ r)
          ==> (p \/ q <=> ~r)")) THEN
        SIMP_TAC [REAL_LT_REFL] THEN CONJ_TAC THENL
         [REWRITE_TAC [OR_EXISTS_THM, CART_EQ, NOT_FORALL_THM, IN_NUMSEG] THEN
          GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:num") THEN
          REWRITE_TAC [NOT_IMP] THEN
          DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
          ASM_SIMP_TAC [IMP_IMP, REAL_LE_REFL, ← ARITH_RULE
           (← q r"k <= N ==> (m < k /\ (1 <= m /\ m <= N) <=> 1 <= m /\ m < k)")] THEN
          DISCH_THEN (K ALL_TAC) THEN ASM_REAL_ARITH_TAC,
          REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
          REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
          REWRITE_TAC [NOT_EXISTS_THM] THEN
          MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
          ASM_CASES_TAC (← q r"m:num = n") THEN
          ASM_REWRITE_TAC [] THENL [REAL_ARITH_TAC, ALL_TAC] THEN
          FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← ARITH_RULE
           (← q r"~(m:num = n) ==> m < n \/ n < m"))) THEN
          STRIP_TAC THENL
           [UNDISCH_TAC (← q r"(x:real^M)$m < (y:real^M)$m"),
            UNDISCH_TAC (← q r"(y:real^M)$n < (x:real^M)$n")] THEN
          REWRITE_TAC [REAL_NOT_LT] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_ARITH_TAC],
        ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
        MATCH_MP_TAC GDELTA_INTER THEN
        ASM_SIMP_TAC [CLOSED_IMP_GDELTA, COMPACT_IMP_CLOSED] THEN
        REWRITE_TAC [GDELTA_COMPLEMENT] THEN
        MATCH_MP_TAC FSIGMA_UNIONS THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN X_GEN_TAC (← q r"k:num") THEN
        MATCH_MP_TAC CLOSED_IMP_FSIGMA THEN
        MATCH_MP_TAC CLOSED_COMPACT_PROJECTION THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSED_INTER THEN CONJ_TAC THENL
         [ALL_TAC,
          MATCH_MP_TAC CLOSED_UNIONS THEN
          SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, FORALL_IN_IMAGE] THEN
          X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC] THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE THEN
        ASM_SIMP_TAC [CLOSED_PCROSS, COMPACT_IMP_CLOSED] THEN
        SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART,
                  CONTINUOUS_ON_SUB, CLOSED_SING]
        THENL
         [MATCH_MP_TAC CONTINUOUS_ON_SUB THEN
          CONJ_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
                CONTINUOUS_ON_SUBSET)) THEN
          REWRITE_TAC [IMAGE_FSTCART_PCROSS, IMAGE_SNDCART_PCROSS] THEN
          SET_TAC [],
          MATCH_MP_TAC CLOSED_INTER THEN
          REWRITE_TAC [CLOSED_HALFSPACE_COMPONENT_GE] THEN
          MATCH_MP_TAC CLOSED_INTERS THEN
          REWRITE_TAC [FORALL_IN_IMAGE, IN_NUMSEG] THEN
          REWRITE_TAC [CLOSED_HALFSPACE_COMPONENT_GE]]])

  return { GDELTA_CONTINUOUS_FUNCTION_MINIMA }

/- ------------------------------------------------------------------------- -/
/- A G_delta domain of injectivity.  (topology.ml 36033-36134)               -/
/- ------------------------------------------------------------------------- -/

structure GDI where
  GDELTA_DOMAIN_OF_INJECTIVITY_CONTINUOUS : thm
  deriving Inhabited

@[nospecialize]
def setupGDI [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLPT : LPT) (BCPP1 : CPP1)
    (BIDC : IDC) (BLCP : LCP) (BPRP1 : PRP1) (BHSP : HSP) (BDST : DST) (BGCM : GCM) :
    ExceptT String IO GDI := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, REAL_ARITH, SET_RULE, .. } := D
  let { CART_EQ, CONJ_ASSOC, DISJ_ASSOC, EXISTS_OR_THM, .. } := D.core1
  let { FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_UNWIND_THM2, FUN_IN_IMAGE, IMP_CONJ, IMP_IMP,
        INTERS_GSPEC, IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_SING, .. } := D.core2
  let { LE, LEFT_IMP_EXISTS_THM, LEFT_OR_DISTRIB, LE_REFL, LE_TRANS, LT_IMP_LE, LT_SUC_LE,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, .. } := D.core3
  let { REAL_LE_REFL, REAL_LT_ANTISYM, .. } := D.core4
  let { REAL_NOT_LT, RIGHT_IMP_FORALL_THM, RIGHT_OR_DISTRIB, SUBSET_REFL, SUBSET_RESTRICT, .. } :=
    D.core5
  let { UNWIND_THM2, num_INDUCTION, o_DEF, .. } := D.core6
  let { CLOSED_INTERS, .. } := BCLO
  let { CLOSED_IN_SING, .. } := BLPT
  let { COMPACT_INTER_CLOSED, .. } := BCPP1
  let { CONTINUOUS_ON_ID, .. } := BIDC
  let { CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE, .. } := BLCP
  let { PROPER_MAP_FROM_COMPACT, .. } := BPRP1
  let { CLOSED_STANDARD_HYPERPLANE, .. } := BHSP
  let { CONTINUOUS_ATTAINS_INF, .. } := BDST
  let { GDELTA_CONTINUOUS_FUNCTION_MINIMA, .. } := BGCM
  -- @@SCOPE END

  let GDELTA_DOMAIN_OF_INJECTIVITY_CONTINUOUS ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ compact s
        ==> ?t. gdelta t /\ t SUBSET s /\
                IMAGE f t = IMAGE f s /\
                !x y. x IN t /\ y IN t /\ f x = f y ==> x = y"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
        GDELTA_CONTINUOUS_FUNCTION_MINIMA) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← MESON []
     (← q r"P s ==> gdelta s ==> ?t. gdelta t /\ P t")) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"t SUBSET s /\ (!z. z IN s ==> ?a. {x | x IN t /\ f x = f z} = {a})
      ==> t SUBSET s /\ IMAGE f t = IMAGE f s /\
          !x y. x IN t /\ y IN t /\ f x = f y ==> x = y")) THEN
    REWRITE_TAC [SUBSET_RESTRICT] THEN X_GEN_TAC (← q r"z:real^M") THEN DISCH_TAC THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    SUBGOAL_THEN
     (← q r"!n. n <= dimindex(:M)
          ==> ?x. x IN s /\
                  (!y. y IN s /\ f x = f y
                       ==> (!i. 1 <= i /\ i <= n ==> x$i = y$i) \/
                           (?k. 1 <= k /\
                                k <= n /\
                                (!i. 1 <= i /\ i < k ==> x$i <= y$i) /\
                                x$k < y$k)) /\
                  (f:real^M->real^N) x = f z")
    (MP_TAC o SPEC (← q r"dimindex(:M)")) THENL
     [MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
       [REWRITE_TAC [CONJ_ASSOC, ← ARITH_RULE (← q r"1 <= k /\ k <= 0 <=> F")] THEN
        ASM_MESON_TAC [],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"m:num") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP (← ARITH_RULE
       (← q r"SUC n <= m ==> n <= m /\ n < m"))) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"y:real^M") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\x:real^M. x$(SUC m)",
        ← q r"{x | x IN s /\ (f:real^M->real^N) x IN {f z}} INTER
         INTERS {{x | x$i = (y:real^M)$i} | i IN 1..m}"]
       CONTINUOUS_ATTAINS_INF) THEN
      SIMP_TAC [o_DEF, CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE,
                CONTINUOUS_ON_ID] THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [MATCH_MP_TAC COMPACT_INTER_CLOSED THEN CONJ_TAC THENL
           [MATCH_MP_TAC PROPER_MAP_FROM_COMPACT THEN
            EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) s") THEN
            ASM_SIMP_TAC [CLOSED_IN_SING, FUN_IN_IMAGE, SUBSET_REFL],
            MATCH_MP_TAC CLOSED_INTERS THEN
            SIMP_TAC [FORALL_IN_GSPEC, CLOSED_STANDARD_HYPERPLANE]],
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"y:real^M") THEN
          ASM_REWRITE_TAC [IN_ELIM_THM, IN_INTER, INTERS_GSPEC, IN_SING]],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^M") THEN
        REWRITE_TAC [IN_ELIM_THM, IN_INTER, INTERS_GSPEC, IN_SING] THEN
        REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"w:real^M") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:real^M"))) THEN
        REPEAT (ASM_REWRITE_TAC [] THEN DISCH_TAC) THEN
        FIRST_X_ASSUM (DISJ_CASES_THEN2 ASSUME_TAC MP_TAC) THENL
         [REWRITE_TAC [LE, CONJ_ASSOC] THEN
          REWRITE_TAC [LEFT_OR_DISTRIB, RIGHT_OR_DISTRIB] THEN
          REWRITE_TAC [← GSYM CONJ_ASSOC, EXISTS_OR_THM,
                       ← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)")] THEN
          REWRITE_TAC [CONJ_ASSOC, ← ARITH_RULE
           (← q r"1 <= k /\ k = SUC n <=> k = SUC n /\ 1 <= k")] THEN
          REWRITE_TAC [← GSYM CONJ_ASSOC, FORALL_AND_THM, FORALL_UNWIND_THM2,
                       IMP_CONJ, UNWIND_THM2, ← ARITH_RULE (← q r"1 <= SUC n")] THEN
          REWRITE_TAC [LT_SUC_LE, IMP_IMP] THEN
          ASM_SIMP_TAC [REAL_LE_REFL, DISJ_ASSOC] THEN
          DISJ1_TAC THEN
          REWRITE_TAC [← REAL_ARITH (← q r"x = w \/ x < w <=> x <= w")] THEN
          ASM_MESON_TAC [],
          DISCH_THEN (fun th => DISJ2_TAC THEN MP_TAC th) THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"j:num") THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"j <= n ==> j <= SUC n")] THEN
          ASM_MESON_TAC [LE_TRANS, LT_IMP_LE]]],
      REWRITE_TAC [LE_REFL] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"a:real^M") THEN STRIP_TAC THEN
      REWRITE_TAC [← SET_RULE (← q r"s = {a} <=> a IN s /\ !b. b IN s ==> b = a")] THEN
      ASM_SIMP_TAC [CART_EQ, IN_ELIM_THM] THEN X_GEN_TAC (← q r"b:real^M") THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"a:real^M"))) THEN
      ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:real^M")) THEN
      ASM_SIMP_TAC [CART_EQ] THEN REWRITE_TAC [← GSYM CART_EQ] THEN
      ASM_CASES_TAC (← q r"b:real^M = a") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [NOT_EXISTS_THM, LEFT_IMP_EXISTS_THM,
                   RIGHT_IMP_FORALL_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> (p /\ q /\ s) /\ r")] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p ==> ~q <=> ~(p /\ q)")] THEN
      DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2
        STRIP_ASSUME_TAC MP_TAC)) THEN
      ASM_CASES_TAC (← q r"i:num = j") THENL
       [ASM_MESON_TAC [REAL_LT_ANTISYM], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"~(i:num = j) ==> i < j \/ j < i"))) THEN
      ASM_MESON_TAC [REAL_NOT_LT]])

  return { GDELTA_DOMAIN_OF_INJECTIVITY_CONTINUOUS }

/- ------------------------------------------------------------------------- -/
/- Borel domains of injectivity.  (topology.ml 36135-36218)                  -/
/- ------------------------------------------------------------------------- -/

structure BDI where
  BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS_GEN : thm
  BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS : thm
  deriving Inhabited

@[nospecialize]
def setupBDI [HolBase] (D : TopologyDeps) (BCSL : CSL) (BLCP : LCP) (BFSG1 : FSG1)
    (BBOR2 : BOR2) (BGDI : GDI) : ExceptT String IO BDI := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { CONJ_SYM, EQ_TRANS, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, EXISTS_IN_UNIONS, EXTENSION,
        FINITE_IMAGE, .. } := D.core1
  let { FINITE_NUMSEG_LT, FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_UNIONS,
        IMP_CONJ, IMP_IMP, INJECTIVE_ON_ALT, IN_IMAGE, .. } := D.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core3
  let { RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE,
        SKOLEM_THM, SUBSET_REFL, .. } := D.core5
  let { SWAP_FORALL_THM, UNIONS_0, UNIONS_IMAGE, UNIONS_MONO_IMAGE, UNION_OF, WLOG_LT, num_WOP,
        .. } := D.core6
  let { COUNTABLE_AS_IMAGE, COUNTABLE_IMAGE, FINITE_IMP_COUNTABLE, NUM_COUNTABLE, .. } := D.lib1
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  let { COMPACT_CONTINUOUS_IMAGE, .. } := BLCP
  let { FSIGMA_UNIONS_COMPACT, .. } := BFSG1
  let { BOREL_DIFF, BOREL_EMPTY, BOREL_UNIONS, COMPACT_IMP_BOREL, CONTINUOUS_BOREL_PREIMAGE,
        GDELTA_IMP_BOREL, .. } := BBOR2
  let { GDELTA_DOMAIN_OF_INJECTIVITY_CONTINUOUS, .. } := BGDI
  -- @@SCOPE END

  let BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS_GEN ← prove
   r"!f:real^M->real^N u.
        COUNTABLE u /\
        (!k. k IN u ==> compact k /\ f continuous_on k)
        ==> ?t. borel t /\ t SUBSET UNIONS u /\
                IMAGE f t = IMAGE f (UNIONS u) /\
                !x y. x IN t /\ y IN t /\ f x = f y ==> x = y"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"u:(real^M->bool)->bool = {}") THENL
     [EXISTS_TAC (← q r"{}:real^M->bool") THEN
      ASM_REWRITE_TAC [UNIONS_0, NOT_IN_EMPTY, BOREL_EMPTY, SUBSET_REFL],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"u:(real^M->bool)->bool") COUNTABLE_AS_IMAGE) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:num->real^M->bool") THEN DISCH_THEN SUBST_ALL_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [FORALL_IN_IMAGE, IN_UNIV]) THEN
    SUBGOAL_THEN
     (← q r"!n. ?t. gdelta t /\
              t SUBSET (c(n:num)) /\
              IMAGE (f:real^M->real^N) t = IMAGE f (c n) /\
              !x y. x IN t /\ y IN t /\ f x = f y ==> x = y")
    MP_TAC THENL
     [ASM_SIMP_TAC [GDELTA_DOMAIN_OF_INJECTIVITY_CONTINUOUS],
      REWRITE_TAC [INJECTIVE_ON_ALT, SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"d:num->real^M->bool") THEN REWRITE_TAC [FORALL_AND_THM] THEN
    STRIP_TAC THEN
    EXISTS_TAC
     (← q r"UNIONS {d n DIFF
              UNIONS(IMAGE (\m.
                 {x | x IN d n /\ f(x) IN IMAGE (f:real^M->real^N) (d m)})
                 {m | m < n}) | n IN (:num)}") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC BOREL_UNIONS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE, IN_UNIV] THEN
      X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC BOREL_DIFF THEN
      ASM_SIMP_TAC [GDELTA_IMP_BOREL] THEN MATCH_MP_TAC BOREL_UNIONS THEN
      SIMP_TAC [FINITE_IMP_COUNTABLE, FINITE_IMAGE, FINITE_NUMSEG_LT] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"m:num") THEN DISCH_THEN (K ALL_TAC) THEN
      MATCH_MP_TAC CONTINUOUS_BOREL_PREIMAGE THEN
      ASM_SIMP_TAC [GDELTA_IMP_BOREL] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC COMPACT_IMP_BOREL THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      ASM_REWRITE_TAC [],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [SIMPLE_IMAGE] THEN
      MATCH_MP_TAC UNIONS_MONO_IMAGE THEN ASM SET_TAC [],
      TRANS_TAC EQ_TRANS
       (← q r"IMAGE (f:real^M->real^N) (UNIONS (IMAGE d (:num)))") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      GEN_REWRITE_TAC id [EXTENSION] THEN
      REWRITE_TAC [IN_IMAGE] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [EXISTS_IN_UNIONS] THEN
      REWRITE_TAC [RIGHT_EXISTS_AND_THM, EXISTS_IN_IMAGE, EXISTS_IN_GSPEC] THEN
      X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_UNIV] THEN
      GEN_REWRITE_TAC RAND_CONV [num_WOP] THEN
      REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC [],
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_UNIONS] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN
      REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
      GEN_REWRITE_TAC BINDER_CONV [SWAP_FORALL_THM] THEN
      REWRITE_TAC [IMP_IMP] THEN MATCH_MP_TAC WLOG_LT THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [UNIONS_IMAGE] THEN ASM SET_TAC []])

  let BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ fsigma s
        ==> ?t. borel t /\ t SUBSET s /\
                IMAGE f t = IMAGE f s /\
                !x y. x IN t /\ y IN t /\ f x = f y ==> x = y"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FSIGMA_UNIONS_COMPACT]) THEN
    REWRITE_TAC [UNION_OF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    MATCH_MP_TAC BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS_GEN THEN
    ASM_SIMP_TAC [] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONTINUOUS_ON_SUBSET)) THEN
    ASM SET_TAC [])

  return { BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS_GEN, BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS }

/- ------------------------------------------------------------------------- -/
/- Partitions of unity subordinate to open coverings. Since subsets of       -/
/- Euclidean space are paracompact, there's a locally finite refinement.     -/
/- (topology.ml 36219-36325)                                                 -/
/- ------------------------------------------------------------------------- -/

structure PCU where
  PARACOMPACT_SPACE_EUCLIDEAN : thm
  PARACOMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY : thm
  PARACOMPACT : thm
  SUBORDINATE_PARTITION_OF_UNITY : thm
  deriving Inhabited

@[nospecialize]
def setupPCU [HolBase] (D : TopologyDeps) (BEUC : EUC) (BCWL : CWL) (BLOC : LOC) (BCNO : CNO)
    (BCSL : CSL) : ExceptT String IO PCU := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { FINITE_SUBSET, IMP_CONJ, IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, .. } := D.core3
  let { SUBSET, .. } := D.core5
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, METRIZABLE_IMP_PARACOMPACT_SPACE,
        METRIZABLE_SPACE_SUBTOPOLOGY, MTOPOLOGY_SUBMETRIC, .. } := D.met2
  let { OPEN_IN_IMP_SUBSET, PARACOMPACT_PARTITION_OF_UNITY, PARACOMPACT_SPACE_MTOPOLOGY,
        locally_finite_in, paracompact_space, .. } := D.met3
  let { HAUSDORFF_SPACE_EUCLIDEAN, METRIZABLE_SPACE_EUCLIDEAN, MTOPOLOGY_EUCLIDEAN_METRIC,
        OPEN_INTER, OPEN_UNIONS, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BEUC
  let { CONTINUOUS_MAP_EQ_LIFT, .. } := BCWL
  let { OPEN_IN_OPEN, OPEN_IN_OPEN_EQ, .. } := BLOC
  let { CONTINUOUS_MAP_EUCLIDEAN, .. } := BCNO
  let { CONTINUOUS_ON_SUBSET, .. } := BCSL
  -- @@SCOPE END

  let PARACOMPACT_SPACE_EUCLIDEAN ← prove
   r"paracompact_space(euclidean:(real^N)topology)"
   (REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, PARACOMPACT_SPACE_MTOPOLOGY])

  let PARACOMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY ← prove
   r"!s:real^N->bool. paracompact_space(subtopology euclidean s)"
   (REWRITE_TAC [← GSYM MTOPOLOGY_EUCLIDEAN_METRIC, PARACOMPACT_SPACE_MTOPOLOGY,
                 ← GSYM MTOPOLOGY_SUBMETRIC])

  let PARACOMPACT ← prove
   r"!s c. (!t:real^N->bool. t IN c ==> open t) /\ s SUBSET UNIONS c
         ==> ?c'. s SUBSET UNIONS c' /\
                  (!u. u IN c'
                       ==> open u /\ ?t. t IN c /\ u SUBSET t) /\
                  (!x. x IN s
                       ==> ?v. open v /\ x IN v /\
                               FINITE {u | u IN c' /\ ~(u INTER v = {})})"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPEC
     (← q r"UNIONS c:real^N->bool") PARACOMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY) THEN
    REWRITE_TAC [paracompact_space] THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_EQ, OPEN_UNIONS, locally_finite_in] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:(real^N->bool)->bool")) THEN
    ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN ANTS_TAC THENL
     [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []])

  let SUBORDINATE_PARTITION_OF_UNITY ← prove
   r"!c s:real^N->bool.
        s SUBSET UNIONS c /\ (!u. u IN c ==> open u)
        ==> ?f:(real^N->bool)->real^N->real.
                (!u. u IN c
                     ==> (lift o f u) continuous_on s /\
                         !x. x IN s ==> &0 <= f u x) /\
                (!x u. u IN c /\ x IN s /\ ~(x IN u)
                       ==> f u x = &0) /\
                (!x. x IN s ==> sum c (\u. f u x) = &1) /\
                (!x. x IN s
                     ==> ?n. open n /\ x IN n /\
                             FINITE {u | u IN c /\
                                     ~(!x. x IN n
                                           ==> f u x = &0)})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"subtopology euclidean (UNIONS c):(real^N)topology",
      ← q r"c:(real^N->bool)->bool"]
     PARACOMPACT_PARTITION_OF_UNITY) THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                 CONTINUOUS_MAP_EQ_LIFT, CONTINUOUS_MAP_EUCLIDEAN] THEN
    ANTS_TAC THENL
    [REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC METRIZABLE_IMP_PARACOMPACT_SPACE THEN
      MATCH_MP_TAC METRIZABLE_SPACE_SUBTOPOLOGY THEN
      REWRITE_TAC [METRIZABLE_SPACE_EUCLIDEAN],
      MATCH_MP_TAC HAUSDORFF_SPACE_SUBTOPOLOGY THEN
      REWRITE_TAC [HAUSDORFF_SPACE_EUCLIDEAN],
      X_GEN_TAC (← q r"u:real^N->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [OPEN_IN_OPEN] THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN
      ASM_SIMP_TAC [] THEN ASM SET_TAC []],
     ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"ph:(real^N->bool)->real^N->real")
      STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"ph:(real^N->bool)->real^N->real") THEN
    SUBGOAL_THEN (← q r"open(UNIONS c:real^N->bool)") ASSUME_TAC THENL
    [MATCH_MP_TAC OPEN_UNIONS THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
    [/- Continuity and nonnegativity -/
     X_GEN_TAC (← q r"u:real^N->bool") THEN DISCH_TAC THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"UNIONS c:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
      ASM_MESON_TAC [SUBSET]],
     /- Support condition -/
     REPEAT GEN_TAC THEN STRIP_TAC THEN
     RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, IN_ELIM_THM]) THEN
     ASM_MESON_TAC [],
     /- Sum equals 1 -/
     RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN ASM_MESON_TAC [],
     /- Local finiteness of supports -/
     X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
     SUBGOAL_THEN (← q r"(x:real^N) IN UNIONS c") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
     FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"x:real^N")) THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
     ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:real^N->bool") THEN
     STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
     SUBGOAL_THEN (← q r"(N:real^N->bool) SUBSET UNIONS c") ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET,
                     TOPSPACE_EUCLIDEAN_SUBTOPOLOGY],
      ALL_TAC] THEN
     CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool")
        STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC OPEN_INTER THEN
      ASM_SIMP_TAC [OPEN_UNIONS],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, NOT_FORALL_THM,
        NOT_IMP, ← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
      ASM SET_TAC []]])

  return { PARACOMPACT_SPACE_EUCLIDEAN, PARACOMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY, PARACOMPACT,
           SUBORDINATE_PARTITION_OF_UNITY }

end HolMultiLib.Topology
