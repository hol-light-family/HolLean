     (REWRITE_TAC [← GSYM BAIRE_INDICATOR_DELTA, ← GSYM CONJ_ASSOC] THEN
      REWRITE_TAC [slemma])
    pure (BAIRE_INDICATOR_SUC, BAIRE_INDICATOR_DELTA, FGSIGMA_BAIRE_PREIMAGE_OPEN_ALT,
          FSIGMA_REDUCTION_GEN, GDELTA_SEPARATION_GEN)

  return { BAIRE_INDICATOR_SUC, BAIRE_INDICATOR_DELTA, FGSIGMA_BAIRE_PREIMAGE_OPEN_ALT,
           FSIGMA_REDUCTION_GEN, GDELTA_SEPARATION_GEN }

/- ------------------------------------------------------------------------- -/
/- Baire indicators of countable unions and intersections; G_delta separation. -/
/- (topology.ml 32656-32684)                                                 -/
/- ------------------------------------------------------------------------- -/

structure GSP where
  COUNTABLE_UNION_OF_BAIRE_INDICATOR : thm
  COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR : thm
  GDELTA_SEPARATION : thm
  deriving Inhabited

@[nospecialize]
def setupGSP [HolBase] (D : TopologyDeps) (BBIN1 : BIN1) (BBIN2 : BIN2) (BBIS : BIS) :
    ExceptT String IO GSP := do
  -- @@SCOPE BEGIN
  let { CONJ_ASSOC, .. } := D.core1
  let { IMP_CONJ_ALT, IMP_IMP, .. } := D.core2
  let { LE_1, .. } := D.core3
  let { UNION_OF_MONO, o_DEF, .. } := D.core6
  let { COUNTABLE_INTERSECTION_OF_COMPLEMENT, COUNTABLE_INTERSECTION_OF_INC, .. } := D.lib1
  let { FORALL_DIFF, .. } := D.misc
  let { BAIRE_INDICATOR_COMPLEMENT, BAIRE_INDICATOR_EMPTY, BAIRE_INDICATOR_UNIV,
        COUNTABLE_UNION_OF_BAIRE0_INDICATOR, .. } := BBIN1
  let { BAIRE1_INDICATOR, GDELTA_BAIRE, .. } := BBIN2
  let { BAIRE_INDICATOR_SUC, GDELTA_SEPARATION_GEN, .. } := BBIS
  -- @@SCOPE END

  let COUNTABLE_UNION_OF_BAIRE_INDICATOR ← prove
   r"!s k. (COUNTABLE UNION_OF baire k (:real^N) o indicator) s
         ==> baire (k + 1) (:real^N) (indicator s)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"k = 0") THENL
     [ASM_REWRITE_TAC [COUNTABLE_UNION_OF_BAIRE0_INDICATOR] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [BAIRE_INDICATOR_UNIV, BAIRE_INDICATOR_EMPTY],
      ASM_SIMP_TAC [LE_1, ← GSYM BAIRE_INDICATOR_SUC] THEN
      SIMP_TAC [COUNTABLE_INTERSECTION_OF_INC] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] UNION_OF_MONO) THEN
      REWRITE_TAC [COUNTABLE_INTERSECTION_OF_INC]])

  let COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR ← prove
   r"!s k. (COUNTABLE INTERSECTION_OF baire k (:real^N) o indicator) s
         ==> baire (k + 1) (:real^N) (indicator s)"
   (ONCE_REWRITE_TAC [← GSYM BAIRE_INDICATOR_COMPLEMENT] THEN
    REWRITE_TAC [COUNTABLE_INTERSECTION_OF_COMPLEMENT, FORALL_DIFF] THEN
    REWRITE_TAC [o_DEF, BAIRE_INDICATOR_COMPLEMENT] THEN
    REWRITE_TAC [← REWRITE_RULE [o_DEF] COUNTABLE_UNION_OF_BAIRE_INDICATOR])

  let GDELTA_SEPARATION ← prove
   r"!s t:real^N->bool.
        gdelta s /\ gdelta t /\ DISJOINT s t
        ==> ?u. fsigma u /\ gdelta u /\ s SUBSET u /\ DISJOINT u t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [IMP_IMP, GDELTA_BAIRE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP GDELTA_SEPARATION_GEN) THEN
    REWRITE_TAC [← GSYM GDELTA_BAIRE, BAIRE1_INDICATOR, CONJ_ASSOC])

  return { COUNTABLE_UNION_OF_BAIRE_INDICATOR, COUNTABLE_INTERSECTION_OF_BAIRE_INDICATOR,
           GDELTA_SEPARATION }

/- ------------------------------------------------------------------------- -/
/- More on Baire functions including the full preimage characterization.     -/
/- (topology.ml 32685-32873)                                                 -/
/- ------------------------------------------------------------------------- -/

structure FBP where
  FSIGMA_BAIRE_PREIMAGE_OPEN_GEN : thm
  FSIGMA_BAIRE_PREIMAGE_OPEN : thm
  GDELTA_BAIRE_PREIMAGE_CLOSED_GEN : thm
  GDELTA_BAIRE_PREIMAGE_CLOSED : thm
  deriving Inhabited

@[nospecialize]
def setupFBP [HolBase] (D : TopologyDeps) (BCLO : CLO) (BLOC : LOC) (BCLS1 : CLS1)
    (BLIM1 : LIM1) (BIDC : IDC) (BCLC : CLC) (BLCP : LCP) (BHSP : HSP) (BSDS : SDS)
    (BSD2 : SD2) (BSD3 : SD3) (BFSG1 : FSG1) (BBAI1 : BAI1) (BBIN1 : BIN1) (BBIN2 : BIN2)
    (BBIS : BIS) : ExceptT String IO FBP := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, NUM_REDUCE_CONV, .. } := D
  let { CART_EQ, COMPL_COMPL, CONJ_ASSOC, DIMINDEX_GE_1, EQ_TRANS, ETA_AX, EXTENSION, .. } :=
    D.core1
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INTERSECTION_OF_MONO,
        INTERS_GSPEC, IN_ELIM_THM, .. } := D.core2
  let { IN_UNIV, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_FORALL, .. } := D.core3
  let { REAL_NOT_LT, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN,
        SKOLEM_THM, .. } := D.core5
  let { SWAP_EXISTS_THM, UNIONS_GSPEC, num_INDUCTION, o_ASSOC, o_DEF, o_THM, real_ge, .. } :=
    D.core6
  let { COUNTABLE_IMAGE, COUNTABLE_INTERSECTION_OF_COMPLEMENT, COUNTABLE_INTERSECTION_OF_INTER,
        COUNTABLE_INTERSECTION_OF_INTERS, COUNTABLE_PRODUCT_DEPENDENT, COUNTABLE_RESTRICT,
        COUNTABLE_SUBSET_NUM, COUNTABLE_UNION_OF_COMPLEMENT, COUNTABLE_UNION_OF_INC,
        COUNTABLE_UNION_OF_INTER, COUNTABLE_UNION_OF_UNIONS, .. } := D.lib1
  let { RATIONAL_BETWEEN_EQ, RATIONAL_CLOSED, .. } := D.lib2
  let { COUNTABLE_RATIONAL, REAL_HALF, .. } := D.misc
  let { DROP_ADD, DROP_CMUL, .. } := D.vec1
  let { LIFT_DROP, .. } := D.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, drop, linear, .. } := D.vec4
  let { EVENTUALLY_AND, EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.met2
  let { CLOSED_INTERS, OPEN_CLOSED, closed, .. } := BCLO
  let { CLOSED_IN_CLOSED, .. } := BLOC
  let { CLOSURE_CLOSED, .. } := BCLS1
  let { tendsto, .. } := BLIM1
  let { CONTINUOUS_ON_COMPOSE, .. } := BIDC
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, .. } := BCLC
  let { LINEAR_CONTINUOUS_ON, .. } := BLCP
  let { CLOSED_HALFSPACE_COMPONENT_GE, OPEN_HALFSPACE_COMPONENT_LT, .. } := BHSP
  let { SETDIST_POS_LT, .. } := BSDS
  let { CONTINUOUS_ON_LIFT_SETDIST, SETDIST_SING_TRIANGLE, .. } := BSD2
  let { SETDIST_EQ_0_SING, .. } := BSD3
  let { CLOSED_IMP_FSIGMA, .. } := BFSG1
  let { BAIRE_CONTINUOUS_COMPOSE_UNIV, baire, .. } := BBAI1
  let { BAIRE_INDICATOR_COMPLEMENT, BAIRE_INDICATOR_INTER, BAIRE_INDICATOR_UNIV, .. } := BBIN1
  let { FSIGMA_BAIRE, .. } := BBIN2
  let { BAIRE_INDICATOR_SUC, .. } := BBIS
  -- @@SCOPE END

  let FSIGMA_BAIRE_PREIMAGE_OPEN_GEN ← prove
   r"!f:real^M->real^N s u k.
        1 <= k /\ baire k s f /\ open u
        ==> ?t. (COUNTABLE UNION_OF baire k (:real^M) o indicator) t /\
