    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopic_with]) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
