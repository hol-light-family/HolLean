        ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"j:num") THEN REWRITE_TAC [← REAL_ARITH
        (← q r"&0 <= x /\ x <= &1 <=> abs(x - &0) <= &1 /\ abs(x - &1) <= &1")] THEN
        CONJ_TAC THEN MATCH_MP_TAC REAL_CONVEX_SUM_BOUND_LE THEN
        ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        MATCH_MP_TAC SUM_EQ_0_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
        REWRITE_TAC [] THEN
        REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_MUL_LZERO]) THEN
        REWRITE_TAC [REAL_MUL_LID] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_ARITH_TAC,
        ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
