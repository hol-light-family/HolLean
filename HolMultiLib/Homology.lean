structure HIV where
  HOMOTOPIC_IMP_HOMOLOGOUS_REL_CHAIN_MAPS : thm
  deriving Inhabited

@[nospecialize]
def setupHIV [HolBase] (D : HomologyDeps) (BSSX : SSX) (BSFC : SFC) (BSCH : SCH) (BMSR : MSR)
    (BRBD : RBD) (BHMR : HMR) (BSMP : SMP) (BSSC : SSC) : ExceptT String IO HIV := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, FRAG_MODULE, INT_REDUCE_CONV, NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV,
        .. } := D
  let { ADD1, ADD_SUB, COND_RAND, COND_RATOR, CONJ_ASSOC, DISJOINT, EMPTY_GSPEC, EQ_ADD_RCANCEL,
        ETA_AX, EVEN_ADD, EXTENSION, EXTENSIONAL_UNIV, FINITE_DELETE, FINITE_IMAGE,
        FINITE_NUMSEG, FINITE_NUMSEG_LT, FINITE_PRODUCT_DEPENDENT, FINITE_RESTRICT,
        FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, IMAGE,
        IMAGE_CLAUSES, IMP_CONJ, IMP_IMP, IN, INTER_SUBSET, .. } := D.core1
  let { INT_MUL_ASSOC, INT_POW, INT_POW_1, INT_POW_ADD, INT_POW_NEG, INT_POW_ONE, IN_CROSS,
        IN_DELETE, IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_NUMSEG,
        IN_UNION, IN_UNIV, ITERATE_CLAUSES, ITERATE_EQ, ITERATE_EQ_GENERAL_INVERSES,
        ITERATE_IMAGE, ITERATE_ITERATE_PRODUCT, ITERATE_SWAP, ITERATE_UNION, LE, LE_0, LE_1,
        LE_ADD_RCANCEL, LE_REFL, LT, LT_REFL, NOT_IN_EMPTY, NOT_LE, NOT_LT, NOT_SUC,
        NUMSEG_EMPTY, NUMSEG_LREC, NUMSEG_OFFSET_IMAGE, .. } := D.core2
  let { PAIR_EQ, REAL_ADD_LID, REAL_ADD_RID, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RZERO,
        RESTRICTION, RIGHT_FORALL_IMP_THM, .. } := D.core3
  let { RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_CROSS, SUB_ADD, SUM_0, SUM_ADD_NUMSEG,
        SUM_ADD_SPLIT, SUM_CASES, SUM_CLAUSES, SUM_EQ_0_NUMSEG, SUM_EQ_NUMSEG, SUM_IMAGE,
        SUM_OFFSET, SUM_RESTRICT_SET, SUM_SING, SUM_UNION, UNWIND_THM2, cong, numseg, o_DEF,
