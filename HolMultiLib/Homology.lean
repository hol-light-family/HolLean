    ANTS_TAC THENL
     [EXPAND_TAC "y" THEN
      ASM_SIMP_TAC [HOM_INDUCED, ← MATCH_MP GROUP_HOMOMORPHISM_DIV
         (← SPEC_ALL GROUP_HOMOMORPHISM_HOM_BOUNDARY)] THEN
      ASM_SIMP_TAC [GROUP_DIV_EQ_ID, HOM_INDUCED, HOM_BOUNDARY] THEN
      CONV_TAC SYM_CONV THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN
      SIMP_TAC [NATURALITY_HOM_INDUCED, IMAGE_ID, CONTINUOUS_MAP_ID,
               CONTINUOUS_MAP_FROM_SUBTOPOLOGY, SUBSET_REFL] THEN
      ASM_REWRITE_TAC [o_THM, SUBTOPOLOGY_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"t SUBSET s ==> s INTER t = t")] THEN
      ASM_SIMP_TAC [HOM_INDUCED_ID, ← GSYM homology_group],
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:((num->real)->A)frag->bool")
       (STRIP_ASSUME_TAC o GSYM))] THEN
    MP_TAC (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
        HOMOLOGY_EXACTNESS_AXIOM_3) THEN
    REWRITE_TAC [group_exactness, group_image, group_kernel] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← GEN_REWRITE_RULE id [EXTENSION]
        (← liftExcept (last (CONJUNCTS th)))))) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:((num->real)->A)frag->bool")) THEN
    DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).2)) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM, IN_IMAGE] THEN
    ANTS_TAC THENL
     [TRANS_TAC EQ_TRANS
       (← q r"(hom_induced p (top,t) (top,s) (\x:A. x) o
         hom_induced p (top,{}) (top,t) (\x. x)) z") THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [← GSYM HOM_INDUCED_COMPOSE, CONTINUOUS_MAP_ID,
                      IMAGE_ID, EMPTY_SUBSET] THEN
        REWRITE_TAC [o_DEF],
        ASM_REWRITE_TAC [o_THM]] THEN
      SUBST1_TAC (← SYM (← ASSUME
       (← q r"group_div (relative_homology_group (p,top,t)) x
                  (hom_induced p (subtopology top s,t) (top,t) (\x:A. x) u) =
        y"))) THEN
      ASM_SIMP_TAC [HOM_INDUCED, ← MATCH_MP GROUP_HOMOMORPHISM_DIV
                (← SPEC_ALL GROUP_HOMOMORPHISM_HOM_INDUCED)] THEN
      REWRITE_TAC [← GROUP_RULE
       (← q r"group_div G (group_id G) (group_id G) = group_id G")],
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:((num->real)->A)frag->bool")
       (STRIP_ASSUME_TAC o GSYM)) THEN
      EXISTS_TAC
       (← q r"group_mul (relative_homology_group (p,subtopology top s,t))
                  (hom_induced p (subtopology top s,{}) (subtopology top s,t)
                      (\x:A. x) w) u") THEN
      ASM_SIMP_TAC [GROUP_MUL, HOM_INDUCED,
                    ← MATCH_MP GROUP_HOMOMORPHISM_MUL
                (← SPEC_ALL GROUP_HOMOMORPHISM_HOM_INDUCED)] THEN
      ASM_SIMP_TAC [← GROUP_RULE (← q r"x = group_mul G z u <=> z = group_div G x u"),
                    HOM_INDUCED] THEN
      EXPAND_TAC "y" THEN EXPAND_TAC "z" THEN
      GEN_REWRITE_TAC BINOP_CONV [← GSYM o_THM] THEN
      SIMP_TAC [← GSYM HOM_INDUCED_COMPOSE, IMAGE_ID, SUBSET_REFL, EMPTY_SUBSET,
                CONTINUOUS_MAP_ID, CONTINUOUS_MAP_FROM_SUBTOPOLOGY]])

  return { HOMOLOGY_EXACTNESS_TRIPLE_3 }

/- ------------------------------------------------------------------------- -/
/- Reduced homology.  (homology.ml 6626-6838)                                -/
/- ------------------------------------------------------------------------- -/

structure HRD where
  reduced_homology_group : thm
  GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP : thm
  GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP_SUBSET : thm
  UN_REDUCED_HOMOLOGY_GROUP : thm
  TRIVIAL_REDUCED_HOMOLOGY_GROUP : thm
  GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED : thm
  HOM_INDUCED_REDUCED : thm
  GROUP_HOMOMORPHISM_HOM_BOUNDARY_REDUCED : thm
  HOMOTOPY_EQUIVALENCE_REDUCED_HOMOLOGY_GROUP_ISOMORPHISMS : thm
  HOMOTOPY_EQUIVALENCE_REDUCED_HOMOLOGY_GROUP_ISOMORPHISM : thm
  HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS : thm
  HOMEOMORPHIC_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS : thm
  TRIVIAL_REDUCED_HOMOLOGY_GROUP_EMPTY : thm
  HOMOLOGY_DIMENSION_REDUCED : thm
  TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupHRD [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHBD : HBD) (BHIN : HIN) (BHIF : HIF)
    (BHAX : HAX) (BHBP : HBP) (BHTR : HTR) : ExceptT String IO HRD := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_SUBSET, EQ_IMP, FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_CLAUSES, IMP_CONJ, IMP_CONJ_ALT,
        INTER_IDEMPOT, .. } := D.core1
  let { INT_LT_IMP_NE, IN_ELIM_THM, IN_SING, I_DEF, LEFT_IMP_EXISTS_THM, MONO_AND,
        MONO_FORALL, .. } := D.core2
  let { SUBSET, SUBSET_REFL, o_DEF, o_THM, .. } := D.core4
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET,
        GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED, GROUP_HOMOMORPHISM_INTO_SUBGROUP,
        GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ, GROUP_HOMOMORPHISM_TRIVIAL,
        GROUP_IMAGE_FROM_TRIVIAL_GROUP, .. } := D.grp1
  let { GROUP_ISOMORPHISM_GROUP_KERNEL_GROUP_IMAGE, GROUP_KERNEL_TO_TRIVIAL_GROUP,
        ISOMORPHIC_GROUP_TRIVIALITY, SUBGROUP_GENERATED, SUBGROUP_GENERATED_GROUP_CARRIER,
        SUBGROUP_GROUP_KERNEL, TRIVIAL_GROUP_SUBGROUP_GENERATED,
        TRIVIAL_GROUP_SUBGROUP_GENERATED_TRIVIAL, group_homomorphism, group_image,
        group_isomorphism, group_isomorphisms, group_kernel, isomorphic_group, .. } := D.grp2
  let { CONTINUOUS_MAP_CONST, CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY, .. } :=
    D.met1
  let { HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE, HOMEOMORPHIC_MAP_MAPS, .. } := D.met2
  let { SUBTOPOLOGY_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, TOPSPACE_SUBTOPOLOGY,
        homeomorphic_maps, homotopy_equivalent_space, .. } := D.met3
  let { homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_BOUNDARY, HOM_BOUNDARY, .. } := BHBD
  let { HOM_INDUCED, HOM_INDUCED_DEFAULT, .. } := BHIN
  let { HOM_INDUCED_COMPOSE, HOM_INDUCED_ID, NATURALITY_HOM_INDUCED, .. } := BHIF
  let { HOMOLOGY_DIMENSION_AXIOM, .. } := BHAX
  let { GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY, HOMOLOGY_HOMOTOPY_EMPTY, HOM_INDUCED_COMPOSE_EMPTY,
        TRIVIAL_HOMOLOGY_GROUP, .. } := BHBP
  let { HOMEOMORPHIC_MAP_HOMOLOGY_GROUP_ISOMORPHISM, TRIVIAL_HOMOLOGY_GROUP_EMPTY,
        TRIVIAL_RELATIVE_HOMOLOGY_GROUP_TOPSPACE, .. } := BHTR
  -- @@SCOPE END

  let reduced_homology_group ← new_definition
   r"reduced_homology_group(p,(top:A topology)) =
        subgroup_generated (homology_group(p,top))
          (group_kernel (homology_group(p,top),
                         homology_group(p,discrete_topology {one}))
                        (hom_induced p (top,{}) (discrete_topology {one},{})
                                     (\x. one)))"

  let GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP ← prove
   r"!p top:A topology.
        group_carrier (reduced_homology_group(p,top)) =
        group_kernel (homology_group(p,top),
                      homology_group(p,discrete_topology {one}))
             (hom_induced p (top,{}) (discrete_topology {one},{}) (\x. one))"
   (SIMP_TAC [reduced_homology_group, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
              SUBGROUP_GROUP_KERNEL, GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY,
              CONTINUOUS_MAP_CONST, TOPSPACE_DISCRETE_TOPOLOGY, IN_SING])

  let GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP_SUBSET ← prove
   r"!p top:A topology.
        group_carrier (reduced_homology_group(p,top))
        SUBSET group_carrier (homology_group(p,top))"
   (REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET,
                 reduced_homology_group])

  let UN_REDUCED_HOMOLOGY_GROUP ← prove
   r"!p top:A topology.
        ~(p = &0)
        ==> reduced_homology_group(p,top) = homology_group(p,top)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [reduced_homology_group] THEN
    MATCH_MP_TAC (← MESON [SUBGROUP_GENERATED_GROUP_CARRIER]
     (← q r"s = group_carrier G ==> subgroup_generated G s = G")) THEN
    MATCH_MP_TAC GROUP_KERNEL_TO_TRIVIAL_GROUP THEN
    SIMP_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY, CONTINUOUS_MAP_CONST,
              TOPSPACE_DISCRETE_TOPOLOGY, IN_SING] THEN
    MATCH_MP_TAC HOMOLOGY_DIMENSION_AXIOM THEN EXISTS_TAC (← q r"one") THEN
    ASM_REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY])

  let TRIVIAL_REDUCED_HOMOLOGY_GROUP ← prove
   r"!p top:A topology.
        p < &0 ==> trivial_group(reduced_homology_group(p,top))"
   (SIMP_TAC [UN_REDUCED_HOMOLOGY_GROUP, INT_LT_IMP_NE] THEN
    REWRITE_TAC [TRIVIAL_HOMOLOGY_GROUP])

  let GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED ← prove
   r"!p top top' f:A->B.
        group_homomorphism
          (reduced_homology_group (p,top),reduced_homology_group (p,top'))
          (hom_induced p (top,{}) (top',{}) f)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"continuous_map(top,top') (f:A->B)") THENL
     [ALL_TAC,
      SUBGOAL_THEN
       (← q r"hom_induced p (top,{}) (top',{}) (f:A->B) =
          \c. group_id(reduced_homology_group (p,top'))")
       (fun th => REWRITE_TAC [th, GROUP_HOMOMORPHISM_TRIVIAL]) THEN
      GEN_REWRITE_TAC id [FUN_EQ_THM] THEN ASM_SIMP_TAC [HOM_INDUCED_DEFAULT] THEN
      REWRITE_TAC [reduced_homology_group, homology_group] THEN
      REWRITE_TAC [SUBGROUP_GENERATED]] THEN
    REWRITE_TAC [reduced_homology_group] THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ,
                  GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY,
                  GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED,
                  CONTINUOUS_MAP_CONST, TOPSPACE_DISCRETE_TOPOLOGY, IN_SING,
                  CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                  SUBGROUP_GROUP_KERNEL] THEN
    REWRITE_TAC [group_kernel] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN s ==> k(f x) = h x) /\ IMAGE f s SUBSET t
      ==> IMAGE f {x | x IN s /\ h x = z} SUBSET
          {y | y IN t /\ k y = z}")) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, HOM_INDUCED, homology_group] THEN
    REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN
    ASM_SIMP_TAC [← GSYM HOM_INDUCED_COMPOSE_EMPTY, CONTINUOUS_MAP_CONST,
                  TOPSPACE_DISCRETE_TOPOLOGY, IN_SING] THEN
    REWRITE_TAC [o_DEF])

  let HOM_INDUCED_REDUCED ← prove
   r"!p top top' f c.
        c IN group_carrier(reduced_homology_group(p,top))
        ==> hom_induced p (top,{}) (top',{}) f c IN
            group_carrier(reduced_homology_group (p,top'))"
   (REWRITE_TAC [← REWRITE_RULE [group_homomorphism, SUBSET, FORALL_IN_IMAGE]
      GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED])

  let GROUP_HOMOMORPHISM_HOM_BOUNDARY_REDUCED ← prove
   r"!p top s:A->bool.
        group_homomorphism
         (relative_homology_group (p,top,s),
          reduced_homology_group (p - &1,subtopology top s))
         (hom_boundary p (top,s))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [reduced_homology_group] THEN
    MATCH_MP_TAC GROUP_HOMOMORPHISM_INTO_SUBGROUP THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_BOUNDARY] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, group_kernel, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"c:((num->real)->A)frag->bool") THEN DISCH_TAC THEN
    REWRITE_TAC [HOM_BOUNDARY] THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN
    MP_TAC (← ISPECL
     [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool",
      ← q r"discrete_topology {one}", ← q r"{one}",
      ← q r"\x:A. one"] NATURALITY_HOM_INDUCED) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [SUBTOPOLOGY_DISCRETE_TOPOLOGY, INTER_IDEMPOT] THEN
    ANTS_TAC THENL [SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MP_TAC (← ISPECL
     [← q r"relative_homology_group(p,discrete_topology {one},{one})",
      ← q r"homology_group (p - &1,discrete_topology {one})",
      ← q r"hom_boundary p (discrete_topology {one},{one})"]
     GROUP_IMAGE_FROM_TRIVIAL_GROUP) THEN
    MP_TAC (← ISPECL
     [← q r"p:int", ← q r"discrete_topology {one}", ← q r"{one}"]
     GROUP_HOMOMORPHISM_HOM_BOUNDARY) THEN
    REWRITE_TAC [SUBTOPOLOGY_DISCRETE_TOPOLOGY, INTER_IDEMPOT] THEN
    DISCH_THEN (fun th => REWRITE_TAC [th]) THEN ANTS_TAC THENL
     [MESON_TAC [TRIVIAL_RELATIVE_HOMOLOGY_GROUP_TOPSPACE,
                 TOPSPACE_DISCRETE_TOPOLOGY],
      REWRITE_TAC [group_image, o_THM] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"x IN s ==> IMAGE f s = {z} ==> f x = z")) THEN
      REWRITE_TAC [HOM_INDUCED]])

  let HOMOTOPY_EQUIVALENCE_REDUCED_HOMOLOGY_GROUP_ISOMORPHISMS ← prove
   r"!p top top' (f:A->B) g.
        continuous_map (top,top') f /\
        continuous_map (top',top) g /\
        homotopic_with (\h. T) (top,top) (g o f) I /\
        homotopic_with (\k. T) (top',top') (f o g) I
        ==> group_isomorphisms (reduced_homology_group (p,top),
                                reduced_homology_group (p,top'))
                               (hom_induced p (top,{}) (top',{}) f,
                                hom_induced p (top',{}) (top,{}) g)"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_TAC THEN REWRITE_TAC [group_isomorphisms] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED] THEN
    FIRST_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"p:int") o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] HOMOLOGY_HOMOTOPY_EMPTY))) THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
    GEN_TAC THEN DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN
    ASM_SIMP_TAC [I_DEF, HOM_INDUCED_ID, ← REWRITE_RULE [SUBSET, homology_group]
      GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP_SUBSET] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM] THEN AP_THM_TAC THEN
    MATCH_MP_TAC HOM_INDUCED_COMPOSE THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET])

  let HOMOTOPY_EQUIVALENCE_REDUCED_HOMOLOGY_GROUP_ISOMORPHISM ← prove
   r"!p top top' (f:A->B) g.
        continuous_map (top,top') f /\ continuous_map (top',top) g /\
        homotopic_with (\h. T) (top,top) (g o f) I /\
        homotopic_with (\k. T) (top',top') (f o g) I
        ==> group_isomorphism (reduced_homology_group (p,top),
                               reduced_homology_group (p,top'))
                              (hom_induced p (top,{}) (top',{}) f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_isomorphism] THEN
    EXISTS_TAC (← q r"hom_induced p (top',{}) (top,{}) (g:B->A)") THEN
    ASM_SIMP_TAC [HOMOTOPY_EQUIVALENCE_REDUCED_HOMOLOGY_GROUP_ISOMORPHISMS])

  let HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS ← prove
   r"!p (top:A topology) (top':B topology).
        top homotopy_equivalent_space top'
        ==> reduced_homology_group(p,top) isomorphic_group
            reduced_homology_group(p,top')"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homotopy_equivalent_space, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN STRIP_TAC THEN
    REWRITE_TAC [isomorphic_group] THEN
    EXISTS_TAC (← q r"hom_induced p (top,{}) (top',{}) (f:A->B)") THEN
    MATCH_MP_TAC HOMOTOPY_EQUIVALENCE_REDUCED_HOMOLOGY_GROUP_ISOMORPHISM THEN
    ASM_MESON_TAC [])

  let HOMEOMORPHIC_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS ← prove
   r"!p (top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> reduced_homology_group(p,top) isomorphic_group
            reduced_homology_group(p,top')"
   (SIMP_TAC [HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS,
              HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE])

  let TRIVIAL_REDUCED_HOMOLOGY_GROUP_EMPTY ← prove
   r"!p top:A topology.
        topspace top = {} ==> trivial_group(reduced_homology_group(p,top))"
   (SIMP_TAC [reduced_homology_group, TRIVIAL_GROUP_SUBGROUP_GENERATED,
              TRIVIAL_HOMOLOGY_GROUP_EMPTY])

  let HOMOLOGY_DIMENSION_REDUCED ← prove
   r"!p top a:A.
        topspace top = {a} ==> trivial_group (reduced_homology_group (p,top))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [reduced_homology_group] THEN
    MATCH_MP_TAC TRIVIAL_GROUP_SUBGROUP_GENERATED_TRIVIAL THEN
    MATCH_MP_TAC (← MESON [GROUP_ISOMORPHISM_GROUP_KERNEL_GROUP_IMAGE, SUBSET_REFL]
     (← q r"group_isomorphism (G,G') f
       ==> group_kernel(G,G') f SUBSET {group_id G}")) THEN
    MATCH_MP_TAC HOMEOMORPHIC_MAP_HOMOLOGY_GROUP_ISOMORPHISM THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS] THEN EXISTS_TAC (← q r"(\x. a):1->A") THEN
    ASM_REWRITE_TAC [homeomorphic_maps, CONTINUOUS_MAP_CONST,
      TOPSPACE_DISCRETE_TOPOLOGY] THEN
    SIMP_TAC [IN_SING])

  let TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE ← prove
   r"!p top:A topology.
         contractible_space top
         ==> trivial_group (reduced_homology_group (p,top))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN
    REWRITE_TAC [TRIVIAL_REDUCED_HOMOLOGY_GROUP_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_TRIVIALITY o SPEC (← q r"p:int") o
     MATCH_MP
      HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS) THEN
    MATCH_MP_TAC HOMOLOGY_DIMENSION_REDUCED THEN EXISTS_TAC (← q r"a:A") THEN
    ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [])

  return { reduced_homology_group, GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP,
           GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP_SUBSET, UN_REDUCED_HOMOLOGY_GROUP,
           TRIVIAL_REDUCED_HOMOLOGY_GROUP, GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED,
           HOM_INDUCED_REDUCED, GROUP_HOMOMORPHISM_HOM_BOUNDARY_REDUCED,
           HOMOTOPY_EQUIVALENCE_REDUCED_HOMOLOGY_GROUP_ISOMORPHISMS,
           HOMOTOPY_EQUIVALENCE_REDUCED_HOMOLOGY_GROUP_ISOMORPHISM,
           HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS,
           HOMEOMORPHIC_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS,
           TRIVIAL_REDUCED_HOMOLOGY_GROUP_EMPTY, HOMOLOGY_DIMENSION_REDUCED,
           TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE }

/- ------------------------------------------------------------------------- -/
/- Exactness for reduced homology.  (homology.ml 6839-7048)                  -/
/- ------------------------------------------------------------------------- -/

structure HRX where
  GROUP_IMAGE_REDUCED_HOMOLOGY_GROUP : thm
  HOMOLOGY_EXACTNESS_REDUCED_1 : thm
  HOMOLOGY_EXACTNESS_REDUCED_2 : thm
  HOMOLOGY_EXACTNESS_REDUCED_3 : thm
  deriving Inhabited

@[nospecialize]
def setupHRX [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) (BHEX : HEX)
    (BHAX : HAX) (BHBP : HBP) (BHTR : HTR) (BHRD : HRD) : ExceptT String IO HRX := do
  -- @@SCOPE BEGIN
  let { MESON, SET_RULE, SET_TAC, GEN_SIMPLIFY_CONV, TOP_DEPTH_SQCONV, basic_ss, .. } := D
  let { EMPTY_SUBSET, EQ_TRANS, FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_SUBSET, INTER_COMM, .. } :=
    D.core1
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, .. } :=
    D.core2
  let { SING_SUBSET, SUBSET, o_DEF, o_THM, .. } := D.core4
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, GROUP_DIV, GROUP_DIV_EQ_ID,
        GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED, GROUP_IMAGE_FROM_SUBGROUP_GENERATED,
        GROUP_IMAGE_TO_SUBGROUP_GENERATED, GROUP_INV, GROUP_INV_EQ_ID, .. } := D.grp1
  let { GROUP_KERNEL_FROM_SUBGROUP_GENERATED, GROUP_KERNEL_TO_SUBGROUP_GENERATED, GROUP_MUL_RID,
        SUBGROUP_GROUP_KERNEL, group_div, group_exactness, group_homomorphism, group_image,
        group_kernel, trivial_group, .. } := D.grp2
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, .. } := D.met1
  let { TOPSPACE_DISCRETE_TOPOLOGY, .. } := D.met3
  let { homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, .. } := BHIN
  let { HOM_INDUCED_COMPOSE, .. } := BHIF
  let { HOMOLOGY_EXACTNESS_AXIOM_1, HOMOLOGY_EXACTNESS_AXIOM_2, .. } := BHEX
  let { HOMOLOGY_EXACTNESS_AXIOM_3, .. } := BHAX
  let { GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY, .. } := BHBP
  let { TRIVIAL_RELATIVE_HOMOLOGY_GROUP_TOPSPACE, .. } := BHTR
  let { GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP, GROUP_HOMOMORPHISM_HOM_BOUNDARY_REDUCED,
        GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED, reduced_homology_group, .. } := BHRD
  -- @@SCOPE END

  let GROUP_IMAGE_REDUCED_HOMOLOGY_GROUP ← do
    let lemma ← prove r"(\y. a) o f = \x. a" (REWRITE_TAC [o_DEF])
    prove
     r"!p top s:A->bool.
          ~(topspace top INTER s = {})
          ==> group_image (reduced_homology_group (p,top),
                           relative_homology_group (p,top,s))
                          (hom_induced p (top,{}) (top,s) (\x. x)) =
              group_image (homology_group (p,top),
                           relative_homology_group (p,top,s))
                          (hom_induced p (top,{}) (top,s) (\x. x))"
     (REPEAT STRIP_TAC THEN
      SIMP_TAC [reduced_homology_group, GROUP_IMAGE_FROM_SUBGROUP_GENERATED,
                SUBGROUP_GROUP_KERNEL, GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY,
                CONTINUOUS_MAP_CONST, TOPSPACE_DISCRETE_TOPOLOGY, IN_SING] THEN
      REWRITE_TAC [← SET_RULE (← q r"s INTER t = s <=> s SUBSET t")] THEN
      REWRITE_TAC [group_image, SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [group_kernel, IN_ELIM_THM, IN_IMAGE] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [IN_INTER, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"y:((num->real)->A)frag->bool") THEN DISCH_TAC THEN
      EXISTS_TAC
       (← q r"group_div (homology_group (p,top)) y
        (hom_induced p (discrete_topology {one},{}) (top,{}) (\x. a)
         (hom_induced p (top,{}) (discrete_topology {one},{}) (\x:A. one) y))") THEN
      MP_TAC (← ISPECL
       [← q r"p:int", ← q r"discrete_topology {one}", ← q r"top:A topology",
        ← q r"(\x. a):1->A"]
       GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY) THEN
      MP_TAC (← ISPECL
       [← q r"p:int", ← q r"top:A topology", ← q r"discrete_topology {one}",
        ← q r"\x:A. one"]
       GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY) THEN
      MP_TAC (← ISPECL
       [← q r"p:int", ← q r"top:A topology", ← q r"{}:A->bool", ← q r"top:A topology",
        ← q r"s:A->bool", ← q r"\x:A. x"]
       GROUP_HOMOMORPHISM_HOM_INDUCED) THEN
      MP_TAC (← ISPECL
       [← q r"p:int", ← q r"discrete_topology {one}", ← q r"{one}",
        ← q r"top:A topology", ← q r"s:A->bool", ← q r"(\x. a):1->A"]
       GROUP_HOMOMORPHISM_HOM_INDUCED) THEN
      MP_TAC (← ISPECL
       [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool",
        ← q r"discrete_topology {one}", ← q r"{one}", ← q r"\x:A. one"]
       GROUP_HOMOMORPHISM_HOM_INDUCED) THEN
      MP_TAC (← ISPECL
       [← q r"p:int", ← q r"discrete_topology {one}", ← q r"{}:1->bool",
        ← q r"discrete_topology {one}", ← q r"{one}", ← q r"\x:1. x"]
       GROUP_HOMOMORPHISM_HOM_INDUCED) THEN
      SIMP_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST] THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET] THEN
      ASM_REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, IN_SING, SING_SUBSET] THEN
      REWRITE_TAC [← SET_RULE (← q r"IMAGE (\x. a) s SUBSET {a}")] THEN
      REWRITE_TAC [group_homomorphism, ← GSYM homology_group] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THENL
       [ASM (fun ths => tactic_of do
          pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
            (← ExceptT.mk (basic_ss [])) 4 ths))))
         [group_div, GROUP_INV] THEN
        MATCH_MP_TAC (← MESON [GROUP_MUL_RID]
         (← q r"x IN group_carrier G /\ y = group_id G ==> x = group_mul G x y")) THEN
        ASM (fun ths => tactic_of do
          pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
            (← ExceptT.mk (basic_ss [])) 4 ths))))
         [GROUP_INV_EQ_ID] THEN
        TRANS_TAC EQ_TRANS
         (← q r"hom_induced p (discrete_topology {one},{one}) (top,s) (\x. (a:A))
            (hom_induced p (discrete_topology {one},{})
               (discrete_topology {one},{one}) (\x:1. x)
               (hom_induced p (top,{}) (discrete_topology {one},{}) (\x:A. one)
                y))") THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN
          W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
            rator o lhand o snd) THEN
          REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET, CONTINUOUS_MAP_CONST] THEN
          REWRITE_TAC [CONTINUOUS_MAP_ID] THEN
          ASM_SIMP_TAC [← GSYM homology_group] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
          GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM] THEN
          W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
            rator o rand o snd) THEN
          REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET, CONTINUOUS_MAP_CONST] THEN
          ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, SING_SUBSET] THEN
          ASM_SIMP_TAC [← GSYM homology_group] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
          REWRITE_TAC [o_DEF],
          FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
           (← q r"f w = z ==> x = w ==> f x = z"))) THEN
          MP_TAC (← ISPECL [← q r"p:int", ← q r"discrete_topology {one}"]
            TRIVIAL_RELATIVE_HOMOLOGY_GROUP_TOPSPACE) THEN
          REWRITE_TAC [trivial_group, TOPSPACE_DISCRETE_TOPOLOGY] THEN
          ASM SET_TAC []],
        MATCH_MP_TAC GROUP_DIV THEN ASM_SIMP_TAC [],
        ASM (fun ths => tactic_of do
          pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
            (← ExceptT.mk (basic_ss [])) 4 ths))))
         [group_div, GROUP_INV] THEN
        ASM (fun ths => tactic_of do
          pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
            (← ExceptT.mk (basic_ss [])) 4 ths))))
         [← GSYM group_div, GROUP_DIV_EQ_ID] THEN
        REPLICATE_TAC 2 (GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM]) THEN
        ASM_SIMP_TAC [← GSYM HOM_INDUCED_COMPOSE, CONTINUOUS_MAP_CONST,
                      TOPSPACE_DISCRETE_TOPOLOGY, IN_SING, IMAGE_CLAUSES,
                      EMPTY_SUBSET, lemma]])

  let HOMOLOGY_EXACTNESS_REDUCED_1 ← prove
   r"!p top s:A->bool.
        ~(topspace top INTER s = {})
        ==> group_exactness(reduced_homology_group(p,top),
                            relative_homology_group(p,top,s),
                            reduced_homology_group(p - &1,subtopology top s))
                           (hom_induced p (top,{}) (top,s) (\x. x),
                            hom_boundary p (top,s))"
   (REWRITE_TAC [group_exactness, GROUP_HOMOMORPHISM_HOM_BOUNDARY_REDUCED] THEN
    REPEAT STRIP_TAC THENL
     [REWRITE_TAC [reduced_homology_group] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED THEN
      REWRITE_TAC [homology_group, GROUP_HOMOMORPHISM_HOM_INDUCED],
      ALL_TAC] THEN
    REWRITE_TAC [reduced_homology_group,
                 GROUP_KERNEL_TO_SUBGROUP_GENERATED,
                 GROUP_IMAGE_TO_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [← GSYM reduced_homology_group] THEN
    MP_TAC (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
          HOMOLOGY_EXACTNESS_AXIOM_1) THEN
    REWRITE_TAC [group_exactness] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (SUBST1_TAC (← SYM (← liftExcept (last (CONJUNCTS th)))))) THEN
    MATCH_MP_TAC GROUP_IMAGE_REDUCED_HOMOLOGY_GROUP THEN
    ASM_REWRITE_TAC [])

  let HOMOLOGY_EXACTNESS_REDUCED_2 ← prove
   r"!p top s:A->bool.
      group_exactness(relative_homology_group(p,top,s),
                      reduced_homology_group(p - &1,subtopology top s),
                      reduced_homology_group(p - &1,top))
               (hom_boundary p (top,s),
                hom_induced (p - &1) (subtopology top s,{}) (top,{}) (\x. x))"
   (REWRITE_TAC [group_exactness, GROUP_HOMOMORPHISM_HOM_BOUNDARY_REDUCED] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED] THEN
    REWRITE_TAC [reduced_homology_group,
                 GROUP_KERNEL_TO_SUBGROUP_GENERATED,
                 GROUP_IMAGE_TO_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [← GSYM reduced_homology_group] THEN
    MP_TAC (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
          HOMOLOGY_EXACTNESS_AXIOM_2) THEN
    REWRITE_TAC [group_exactness] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SYM (← liftExcept (last (CONJUNCTS th)))))) THEN
    SIMP_TAC [reduced_homology_group, GROUP_KERNEL_FROM_SUBGROUP_GENERATED,
              SUBGROUP_GROUP_KERNEL, GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY,
              CONTINUOUS_MAP_CONST, TOPSPACE_DISCRETE_TOPOLOGY, IN_SING] THEN
    DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"s = s INTER t <=> s SUBSET t")] THEN
    MP_TAC (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
      GROUP_HOMOMORPHISM_HOM_BOUNDARY_REDUCED) THEN
    REWRITE_TAC [group_homomorphism, group_image] THEN
    DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    REWRITE_TAC [GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP])

  let HOMOLOGY_EXACTNESS_REDUCED_3 ← prove
   r"!p top s:A->bool.
        group_exactness(reduced_homology_group(p,subtopology top s),
                        reduced_homology_group(p,top),
                        relative_homology_group(p,top,s))
                       (hom_induced p (subtopology top s,{}) (top,{}) (\x. x),
                        hom_induced p (top,{}) (top,s) (\x. x))"
   (REWRITE_TAC [group_exactness, GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED] THEN
    REPEAT STRIP_TAC THENL
     [REWRITE_TAC [reduced_homology_group] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED THEN
      REWRITE_TAC [homology_group, GROUP_HOMOMORPHISM_HOM_INDUCED],
      ALL_TAC] THEN
     REWRITE_TAC [reduced_homology_group,
                GROUP_KERNEL_TO_SUBGROUP_GENERATED,
                GROUP_IMAGE_TO_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [← GSYM reduced_homology_group] THEN
    MP_TAC (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
          HOMOLOGY_EXACTNESS_AXIOM_3) THEN
    REWRITE_TAC [group_exactness] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← liftExcept (last (CONJUNCTS th))))) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!u. s' SUBSET u /\ s' SUBSET s /\ u INTER t = t' /\ u INTER s SUBSET s'
          ==> s = t ==> s' = t'")) THEN
    EXISTS_TAC
     (← q r"group_carrier(reduced_homology_group (p,top:A topology))") THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"p:int", ← q r"subtopology top s:A topology",
                       ← q r"top:A topology", ← q r"\x:A. x"]
          GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED) THEN
      SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
      SIMP_TAC [group_image, group_homomorphism],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [reduced_homology_group, group_image] THEN
      MATCH_MP_TAC IMAGE_SUBSET THEN
      REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET],
      ALL_TAC] THEN
    REWRITE_TAC [GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP] THEN
    SIMP_TAC [reduced_homology_group, GROUP_KERNEL_FROM_SUBGROUP_GENERATED,
              SUBGROUP_GROUP_KERNEL, GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY,
              CONTINUOUS_MAP_CONST, TOPSPACE_DISCRETE_TOPOLOGY, IN_SING,
              GROUP_IMAGE_FROM_SUBGROUP_GENERATED] THEN
    CONJ_TAC THENL [MATCH_ACCEPT_TAC INTER_COMM, ALL_TAC] THEN
    REWRITE_TAC [group_image] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN s /\ f x IN k ==> x IN c)
      ==> k INTER IMAGE f s SUBSET IMAGE f s INTER IMAGE f c")) THEN
    X_GEN_TAC (← q r"x:((num->real)->A)frag->bool") THEN
    REWRITE_TAC [group_kernel, IN_ELIM_THM] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_THM] THEN
    W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
          rator o lhand o lhand o snd) THEN
    REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET, CONTINUOUS_MAP_CONST] THEN
    ASM_REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, IN_SING] THEN
    ASM_REWRITE_TAC [← GSYM homology_group] THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, o_DEF])

  return { GROUP_IMAGE_REDUCED_HOMOLOGY_GROUP, HOMOLOGY_EXACTNESS_REDUCED_1,
           HOMOLOGY_EXACTNESS_REDUCED_2, HOMOLOGY_EXACTNESS_REDUCED_3 }

/- ------------------------------------------------------------------------- -/
/- More homology properties of deformations, retracts, contractible spaces.  -/
/- (homology.ml 7049-7284)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HDR where
  GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE : thm
  ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE : thm
  ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_OF_CONTRACTIBLE : thm
  GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_BY_CONTRACTIBLE : thm
  ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_CONTRACTIBLE : thm
  ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_BY_CONTRACTIBLE : thm
  ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_SING : thm
  ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_BY_SING : thm
  REDUCED_HOMOLOGY_GROUP_PAIR : thm
  DEFORMATION_RETRACTION_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS : thm
  DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS : thm
  DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM : thm
  DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM_ID : thm
  DEFORMATION_RETRACTION_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS : thm
  DEFORMATION_RETRACTION_IMP_ISOMORPHIC_HOMOLOGY_GROUPS : thm
  DEFORMATION_RETRACT_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS : thm
  DEFORMATION_RETRACT_IMP_ISOMORPHIC_HOMOLOGY_GROUPS : thm
  ISOMORPHIC_GROUP_HOMOLOGY_BY_SING : thm
  deriving Inhabited

@[nospecialize]
def setupHDR [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHXA : HXA) (BHBP : HBP) (BHPR : HPR)
    (BHRD : HRD) (BHRX : HRX) : ExceptT String IO HDR := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_ARITH, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DIFF_EQ_EMPTY, EMPTY_SUBSET, FINITE_EMPTY, FINITE_INSERT, IMAGE_CLAUSES, IMAGE_I,
        IMAGE_ID, IMAGE_o, IMP_CONJ_ALT, INSERT_SUBSET, INTER_IDEMPOT, INTER_SUBSET, .. } :=
    D.core1
  let { IN_INSERT, IN_INTER, I_DEF, I_O_ID, .. } := D.core2
  let { SING_SUBSET, SUBSET_REFL, o_THM, .. } := D.core4
  let { GROUP_ISOMORPHISMS_IMP_ISOMORPHISM, GROUP_ISOMORPHISMS_IMP_ISOMORPHISM_ALT, .. } := D.grp1
  let { ISOMORPHIC_GROUP_PROD_GROUPS, ISOMORPHIC_GROUP_REFL, ISOMORPHIC_GROUP_SYM,
        ISOMORPHIC_GROUP_TRANS, VERY_SHORT_EXACT_SEQUENCE, group_isomorphism,
        isomorphic_group, .. } := D.grp2
  let { CONTINUOUS_MAP_COMPOSE, CONTRACTIBLE_SPACE_SUBTOPOLOGY_SING, .. } := D.met1
  let { DISCRETE_TOPOLOGY_CLOSURE_OF, DISCRETE_TOPOLOGY_INTERIOR_OF, HOMOTOPIC_WITH_EQUAL, .. } :=
    D.met2
  let { RETRACT_OF_SPACE_SING, SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_FINITE, SUBTOPOLOGY_SUBTOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, retraction_maps, .. } := D.met3
  let { homology_group, .. } := BHGP
  let { HOMOLOGY_EXCISION_AXIOM, .. } := BHXA
  let { HOMOLOGY_COEFFICIENTS, HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS, .. } :=
    BHBP
  let { ISOMORPHIC_GROUP_HOMOLOGY_GROUP_PROD_RETRACT, .. } := BHPR
  let { TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE, UN_REDUCED_HOMOLOGY_GROUP, .. } := BHRD
  let { HOMOLOGY_EXACTNESS_REDUCED_1, HOMOLOGY_EXACTNESS_REDUCED_2,
        HOMOLOGY_EXACTNESS_REDUCED_3, .. } := BHRX
  -- @@SCOPE END

  let GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE ← prove
   r"!p top s:A->bool.
      contractible_space top /\ ~(topspace top INTER s = {})
      ==> group_isomorphism (relative_homology_group(p,top,s),
                             reduced_homology_group(p - &1,subtopology top s))
                            (hom_boundary p (top,s))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"hom_induced p (top,{}) (top,s) (\x:A. x)",
      ← q r"hom_boundary p (top:A topology,s)",
      ← q r"hom_induced (p - &1) (subtopology top s,{}) (top,{}) (\x:A. x)",
      ← q r"reduced_homology_group (p,top:A topology)",
      ← q r"relative_homology_group (p,top:A topology,s)",
      ← q r"reduced_homology_group (p - &1,subtopology top s:A topology)",
      ← q r"reduced_homology_group (p - &1,top:A topology)"]
      VERY_SHORT_EXACT_SEQUENCE) THEN
    ASM_SIMP_TAC [TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE] THEN
    DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [HOMOLOGY_EXACTNESS_REDUCED_2] THEN
    ASM_SIMP_TAC [HOMOLOGY_EXACTNESS_REDUCED_1])

  let ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE ← prove
   r"!p top s:A->bool.
        contractible_space top /\ ~(topspace top INTER s = {})
        ==> relative_homology_group(p,top,s) isomorphic_group
            reduced_homology_group(p - &1,subtopology top s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o MATCH_MP
      GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE) THEN
    REWRITE_TAC [isomorphic_group] THEN MESON_TAC [])

  let ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_OF_CONTRACTIBLE ← prove
   r"!p top s:A->bool.
        contractible_space top /\ ~(topspace top INTER s = {})
        ==> reduced_homology_group(p,subtopology top s) isomorphic_group
            relative_homology_group(p + &1,top,s)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"p + &1:int") o MATCH_MP
      ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE) THEN
    REWRITE_TAC [← INT_ARITH (← q r"(x + &1) - &1:int = x")])

  let GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_BY_CONTRACTIBLE ← prove
   r"!p top s:A->bool.
      contractible_space(subtopology top s) /\ ~(topspace top INTER s = {})
      ==> group_isomorphism (reduced_homology_group(p,top),
                             relative_homology_group(p,top,s))
                            (hom_induced p (top,{}) (top,s) (\x. x))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"hom_induced p (subtopology top s,{}) (top,{}) (\x:A. x)",
      ← q r"hom_induced p (top,{}) (top,s) (\x:A. x)",
      ← q r"hom_boundary p (top:A topology,s)",
      ← q r"reduced_homology_group (p,subtopology top s:A topology)",
      ← q r"reduced_homology_group (p,top:A topology)",
      ← q r"relative_homology_group (p,top:A topology,s)",
      ← q r"reduced_homology_group (p - &1,subtopology top s:A topology)"]
      VERY_SHORT_EXACT_SEQUENCE) THEN
    ASM_SIMP_TAC [TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE] THEN
    DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [HOMOLOGY_EXACTNESS_REDUCED_3] THEN
    ASM_SIMP_TAC [HOMOLOGY_EXACTNESS_REDUCED_1])

  let ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_CONTRACTIBLE ← prove
   r"!p top s:A->bool.
      contractible_space(subtopology top s) /\ ~(topspace top INTER s = {})
      ==> reduced_homology_group(p,top) isomorphic_group
          relative_homology_group(p,top,s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o MATCH_MP
      GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_BY_CONTRACTIBLE) THEN
    REWRITE_TAC [isomorphic_group] THEN MESON_TAC [])

  let ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_BY_CONTRACTIBLE ← prove
   r"!p top s:A->bool.
      contractible_space(subtopology top s) /\ ~(topspace top INTER s = {})
      ==> relative_homology_group(p,top,s) isomorphic_group
          reduced_homology_group(p,top)"
   (ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    REWRITE_TAC [ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_CONTRACTIBLE])

  let ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_SING ← prove
   r"!p top a:A.
        a IN topspace top
        ==> reduced_homology_group(p,top) isomorphic_group
            relative_homology_group(p,top,{a})"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_CONTRACTIBLE THEN
    REWRITE_TAC [CONTRACTIBLE_SPACE_SUBTOPOLOGY_SING] THEN ASM SET_TAC [])

  let ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_BY_SING ← prove
   r"!p top a:A.
        a IN topspace top
        ==> relative_homology_group(p,top,{a}) isomorphic_group
            reduced_homology_group(p,top)"
   (ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    REWRITE_TAC [ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_SING])

  let REDUCED_HOMOLOGY_GROUP_PAIR ← prove
   r"!p top a b:A.
        t1_space top /\ a IN topspace top /\ b IN topspace top /\ ~(a = b)
        ==> reduced_homology_group(p,subtopology top {a,b}) isomorphic_group
            homology_group(p,subtopology top {a})"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC ISOMORPHIC_GROUP_TRANS
     (← q r"relative_homology_group(p,subtopology top {a,b},{b:A})") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_SING THEN
      ASM_REWRITE_TAC [IN_INTER, TOPSPACE_SUBTOPOLOGY, IN_INSERT],
      ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group, homology_group] THEN MP_TAC (← ISPECL
       [← q r"p:int", ← q r"subtopology top {a:A,b}",
        ← q r"{a:A,b}", ← q r"{b:A}", ← q r"{b:A}"]
       HOMOLOGY_EXCISION_AXIOM) THEN
      REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY, DIFF_EQ_EMPTY, INTER_IDEMPOT] THEN
      ASM_SIMP_TAC [← SET_RULE
       (← q r"~(a = b) ==> {a, b} INTER ({a, b} DIFF {b}) = {a}")] THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
      CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      ASM_SIMP_TAC [SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_FINITE,
                    TOPSPACE_SUBTOPOLOGY, INTER_SUBSET,
                    INSERT_SUBSET, EMPTY_SUBSET, FINITE_INSERT, FINITE_EMPTY] THEN
      SIMP_TAC [DISCRETE_TOPOLOGY_CLOSURE_OF, DISCRETE_TOPOLOGY_INTERIOR_OF] THEN
      SET_TAC []])

  let DEFORMATION_RETRACTION_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS ← prove
   r"!p top top' u v (r:A->B) s.
        retraction_maps(top,top') (r,s) /\
        IMAGE r u SUBSET v /\ IMAGE s v SUBSET u /\
        homotopic_with (\h. IMAGE h u SUBSET u) (top,top) (s o r) I
        ==> group_isomorphisms
             (relative_homology_group (p,top,u),
              relative_homology_group (p,top',v))
             (hom_induced p (top,u) (top',v) r,
              hom_induced p (top',v) (top,u) s)"
   (REWRITE_TAC [retraction_maps] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMOTOPIC_WITH_EQUAL THEN
    ASM_REWRITE_TAC [o_THM, I_DEF, IMAGE_ID, SUBSET_REFL, IMAGE_o] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE]])

  let DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS ← prove
   r"!p top top' u v (r:A->A).
        retraction_maps(top,top') (r,I) /\ v SUBSET u /\ IMAGE r u SUBSET v /\
        homotopic_with (\h. IMAGE h u SUBSET u) (top,top) r I
        ==> group_isomorphisms
             (relative_homology_group (p,top,u),
              relative_homology_group (p,top',v))
             (hom_induced p (top,u) (top',v) r,
              hom_induced p (top',v) (top,u) (\x. x))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM I_DEF] THEN
    MATCH_MP_TAC DEFORMATION_RETRACTION_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS THEN
    ASM_REWRITE_TAC [I_O_ID, IMAGE_I])

  let DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM ← prove
   r"!p top top' u v (r:A->A).
        retraction_maps(top,top') (r,I) /\ v SUBSET u /\ IMAGE r u SUBSET v /\
        homotopic_with (\h. IMAGE h u SUBSET u) (top,top) r I
        ==> group_isomorphism
             (relative_homology_group (p,top,u),
              relative_homology_group (p,top',v))
             (hom_induced p (top,u) (top',v) r)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o MATCH_MP
     DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS) THEN
    REWRITE_TAC [GROUP_ISOMORPHISMS_IMP_ISOMORPHISM])

  let DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM_ID ← prove
   r"!p top top' u v (r:A->A).
        retraction_maps(top,top') (r,I) /\ v SUBSET u /\ IMAGE r u SUBSET v /\
        homotopic_with (\h. IMAGE h u SUBSET u) (top,top) r I
        ==> group_isomorphism
             (relative_homology_group (p,top',v),
              relative_homology_group (p,top,u))
             (hom_induced p (top',v) (top,u) (\x. x))"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o MATCH_MP
     DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS) THEN
    REWRITE_TAC [GROUP_ISOMORPHISMS_IMP_ISOMORPHISM_ALT])

  let DEFORMATION_RETRACTION_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS ← prove
   r"!p top top' u v (r:A->B) s.
        retraction_maps(top,top') (r,s) /\
        IMAGE r u SUBSET v /\ IMAGE s v SUBSET u /\
        homotopic_with (\h. IMAGE h u SUBSET u) (top,top) (s o r) I
        ==> relative_homology_group (p,top,u) isomorphic_group
            relative_homology_group (p,top',v)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o MATCH_MP
     DEFORMATION_RETRACTION_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS) THEN
    REWRITE_TAC [group_isomorphism, isomorphic_group] THEN MESON_TAC [])

  let DEFORMATION_RETRACTION_IMP_ISOMORPHIC_HOMOLOGY_GROUPS ← prove
   r"!p top top' (r:A->B) s.
        retraction_maps(top,top') (r,s) /\
        homotopic_with (\h. T) (top,top) (s o r) I
        ==> homology_group (p,top) isomorphic_group
            homology_group (p,top')"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homology_group] THEN MATCH_MP_TAC
      DEFORMATION_RETRACTION_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS THEN
    REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET] THEN ASM_MESON_TAC [])

  let DEFORMATION_RETRACT_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS ← prove
   r"!p top top' u v (r:A->A).
        retraction_maps(top,top') (r,I) /\ v SUBSET u /\ IMAGE r u SUBSET v /\
        homotopic_with (\h. IMAGE h u SUBSET u) (top,top) r I
        ==> relative_homology_group (p,top,u) isomorphic_group
            relative_homology_group (p,top',v)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o MATCH_MP
     DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS) THEN
    REWRITE_TAC [group_isomorphism, isomorphic_group] THEN MESON_TAC [])

  let DEFORMATION_RETRACT_IMP_ISOMORPHIC_HOMOLOGY_GROUPS ← prove
   r"!p top top' (r:A->A).
        retraction_maps(top,top') (r,I) /\
        homotopic_with (\h. T) (top,top) r I
        ==> homology_group (p,top) isomorphic_group
            homology_group (p,top')"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homology_group] THEN MATCH_MP_TAC
      DEFORMATION_RETRACT_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS THEN
    REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET] THEN ASM_MESON_TAC [])

  let ISOMORPHIC_GROUP_HOMOLOGY_BY_SING ← prove
   r"(!top a:A.
        a IN topspace top
        ==> homology_group (&0,top) isomorphic_group
            prod_group integer_group (relative_homology_group(&0,top,{a}))) /\
   (!p top a:A.
        a IN topspace top /\ ~(p = &0)
        ==> homology_group (p,top) isomorphic_group
            relative_homology_group(p,top,{a}))"
   (REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"&0:int", ← q r"top:A topology", ← q r"{a:A}"]
          ISOMORPHIC_GROUP_HOMOLOGY_GROUP_PROD_RETRACT) THEN
      ASM_REWRITE_TAC [RETRACT_OF_SPACE_SING] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] ISOMORPHIC_GROUP_TRANS) THEN
      MATCH_MP_TAC ISOMORPHIC_GROUP_PROD_GROUPS THEN
      REWRITE_TAC [ISOMORPHIC_GROUP_REFL] THEN
      MATCH_MP_TAC HOMOLOGY_COEFFICIENTS THEN EXISTS_TAC (← q r"a:A") THEN
      ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, SING_SUBSET],
      ASM_SIMP_TAC [← GSYM UN_REDUCED_HOMOLOGY_GROUP] THEN
      ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      ASM_SIMP_TAC [ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_BY_SING]])

  return { GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE,
           ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE,
           ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_OF_CONTRACTIBLE,
           GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_BY_CONTRACTIBLE,
           ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_CONTRACTIBLE,
           ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_BY_CONTRACTIBLE,
           ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_SING, ISOMORPHIC_GROUP_RELATIVE_HOMOLOGY_BY_SING,
           REDUCED_HOMOLOGY_GROUP_PAIR,
           DEFORMATION_RETRACTION_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS,
           DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS,
           DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM,
           DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM_ID,
           DEFORMATION_RETRACTION_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS,
           DEFORMATION_RETRACTION_IMP_ISOMORPHIC_HOMOLOGY_GROUPS,
           DEFORMATION_RETRACT_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS,
           DEFORMATION_RETRACT_IMP_ISOMORPHIC_HOMOLOGY_GROUPS, ISOMORPHIC_GROUP_HOMOLOGY_BY_SING }

/- ------------------------------------------------------------------------- -/
/- Deformations into a subset.  (homology.ml 7285-7459)                      -/
/- ------------------------------------------------------------------------- -/

structure HDF where
  GROUP_EPIMORPHISM_HOM_INDUCED_INCLUSION : thm
  TRIVIAL_HOMOMORPHISM_HOM_INDUCED_RELATIVIZATION : thm
  GROUP_MONOMORPHISM_HOM_BOUNDARY_INCLUSION : thm
  SHORT_EXACT_SEQUENCE_HOM_INDUCED_RELATIVIZATION : thm
  GROUP_ISOMORPHISMS_HOMOLOGY_GROUP_PROD_DEFORMATION : thm
  ISOMORPHIC_GROUP_HOMOLOGY_GROUP_PROD_DEFORMATION : thm
  ISOMORPHIC_GROUP_HOMOLOGY_CONTRACTIBLE_SPACE_SUBTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupHDF [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) (BHEX : HEX)
    (BHAX : HAX) (BHZ0 : HZ0) (BHBP : HBP) (BHRD : HRD) (BHDR : HDR) :
    ExceptT String IO HDF := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_ARITH, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_SUBSET, ETA_AX, FORALL_IN_IMAGE, IMAGE_CLAUSES, IMP_CONJ, IMP_CONJ_ALT,
        INT_ADD_LID, .. } := D.core1
  let { I_DEF, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { SUBSET, o_DEF, o_THM, .. } := D.core4
  let { GROUP_EPIMORPHISM_RIGHT_INVERTIBLE, GROUP_EXACTNESS_EPIMORPHISM_EQ_TRIVIALITY,
        GROUP_EXACTNESS_MONOMORPHISM_EQ_TRIVIALITY, .. } := D.grp1
  let { GROUP_ISOMORPHISM_GROUP_MUL, ISOMORPHIC_GROUP_PROD_GROUPS,
        ISOMORPHIC_GROUP_PROD_GROUP_SWAP_RIGHT, ISOMORPHIC_GROUP_REFL, ISOMORPHIC_GROUP_SYM,
        ISOMORPHIC_GROUP_TRANS, SPLITTING_LEMMA_RIGHT, isomorphic_group, normal_subgroup_of,
        short_exact_sequence, .. } := D.grp2
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE, CONTRACTIBLE_SPACE_ALT, .. } := D.met1
  let { HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS, .. } := D.met2
  let { homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, .. } := BHIN
  let { ABELIAN_RELATIVE_HOMOLOGY_GROUP, HOM_INDUCED_COMPOSE, HOM_INDUCED_ID, .. } := BHIF
  let { HOMOLOGY_EXACTNESS_AXIOM_1, HOMOLOGY_EXACTNESS_AXIOM_2, .. } := BHEX
  let { HOMOLOGY_EXACTNESS_AXIOM_3, .. } := BHAX
  let { ISOMORPHIC_GROUP_INTEGER_ZEROTH_HOMOLOGY_GROUP, .. } := BHZ0
  let { HOMOLOGY_HOMOTOPY_EMPTY, .. } := BHBP
  let { UN_REDUCED_HOMOLOGY_GROUP, .. } := BHRD
  let { ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_OF_CONTRACTIBLE, .. } := BHDR
  -- @@SCOPE END

  let GROUP_EPIMORPHISM_HOM_INDUCED_INCLUSION ← prove
   r"!p top s:A->bool.
        (?f. homotopic_with (\x. T) (top,top) I f /\
             IMAGE f (topspace top) SUBSET s)
        ==> group_epimorphism
             (homology_group(p,subtopology top s),homology_group(p,top))
             (hom_induced p (subtopology top s,{}) (top,{}) (\x. x))"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (STRIP_ASSUME_TAC o
      MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS) THEN
    MATCH_MP_TAC GROUP_EPIMORPHISM_RIGHT_INVERTIBLE THEN
    EXISTS_TAC (← q r"hom_induced p (top,{}) (subtopology top s,{}) (f:A->A)") THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED, homology_group] THEN
    GEN_TAC THEN DISCH_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN
    ASM_SIMP_TAC [← GSYM HOM_INDUCED_COMPOSE, IMAGE_CLAUSES, EMPTY_SUBSET,
                  CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                  CONTINUOUS_MAP_ID] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC RAND_CONV [← GSYM (← MATCH_MP HOM_INDUCED_ID th)])) THEN
    AP_THM_TAC THEN REWRITE_TAC [o_DEF, ETA_AX, ← GSYM I_DEF] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC HOMOLOGY_HOMOTOPY_EMPTY THEN
    ASM_REWRITE_TAC [])

  let TRIVIAL_HOMOMORPHISM_HOM_INDUCED_RELATIVIZATION ← prove
   r"!p top s:A->bool.
        (?f. homotopic_with (\x. T) (top,top) I f /\
             IMAGE f (topspace top) SUBSET s)
        ==> trivial_homomorphism
             (homology_group(p,top),relative_homology_group(p,top,s))
             (hom_induced p (top,{}) (top,s) (\x. x))"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o
      SPEC (← q r"p:int") o MATCH_MP GROUP_EPIMORPHISM_HOM_INDUCED_INCLUSION) THEN
    MP_TAC (← CONJ
     (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
        HOMOLOGY_EXACTNESS_AXIOM_3)
     (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
        HOMOLOGY_EXACTNESS_AXIOM_1)) THEN
    DISCH_THEN (SUBST1_TAC o
      MATCH_MP GROUP_EXACTNESS_EPIMORPHISM_EQ_TRIVIALITY) THEN
    REWRITE_TAC [])

  let GROUP_MONOMORPHISM_HOM_BOUNDARY_INCLUSION ← prove
   r"!p top s:A->bool.
        (?f. homotopic_with (\x. T) (top,top) I f /\
             IMAGE f (topspace top) SUBSET s)
        ==> group_monomorphism
             (relative_homology_group(p,top,s),
              homology_group (p - &1,subtopology top s))
             (hom_boundary p (top,s))"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o
      MATCH_MP TRIVIAL_HOMOMORPHISM_HOM_INDUCED_RELATIVIZATION) THEN
    MP_TAC (← CONJ
     (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
        HOMOLOGY_EXACTNESS_AXIOM_3)
     (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
        HOMOLOGY_EXACTNESS_AXIOM_1)) THEN
    REWRITE_TAC [← GSYM homology_group] THEN
    DISCH_THEN (SUBST1_TAC o
      MATCH_MP GROUP_EXACTNESS_MONOMORPHISM_EQ_TRIVIALITY) THEN
    REWRITE_TAC [])

  let SHORT_EXACT_SEQUENCE_HOM_INDUCED_RELATIVIZATION ← prove
   r"!p top s:A->bool.
        (?f. homotopic_with (\x. T) (top,top) I f /\
             IMAGE f (topspace top) SUBSET s)
        ==> short_exact_sequence
             (relative_homology_group(p,top,s),
              homology_group(p - &1,subtopology top s),
              homology_group(p - &1,top))
             (hom_boundary p (top,s),
              hom_induced (p - &1) (subtopology top s,{}) (top,{}) (\x. x))"
   (REWRITE_TAC [short_exact_sequence, HOMOLOGY_EXACTNESS_AXIOM_2] THEN
    SIMP_TAC [GROUP_EPIMORPHISM_HOM_INDUCED_INCLUSION] THEN
    SIMP_TAC [GROUP_MONOMORPHISM_HOM_BOUNDARY_INCLUSION])

  let GROUP_ISOMORPHISMS_HOMOLOGY_GROUP_PROD_DEFORMATION ← prove
   r"!p top s:A->bool.
     (?f. homotopic_with (\x. T) (top,top) I f /\
          IMAGE f (topspace top) SUBSET s)
     ==> ?h k. h subgroup_of homology_group (p,subtopology top s) /\
               k subgroup_of homology_group (p,subtopology top s) /\
               group_isomorphism
                (prod_group
                  (subgroup_generated (homology_group(p,subtopology top s)) h)
                  (subgroup_generated (homology_group(p,subtopology top s)) k),
                 homology_group(p,subtopology top s))
                (\(x,y). group_mul(homology_group(p,subtopology top s)) x y) /\
               group_isomorphism
                (relative_homology_group (p + &1,top,s),
                 subgroup_generated (homology_group (p,subtopology top s)) h)
                (hom_boundary (p + &1) (top,s)) /\
               group_isomorphism
                (subgroup_generated (homology_group (p,subtopology top s)) k,
                 homology_group (p,top))
                (hom_induced p (subtopology top s,{}) (top,{}) (\x. x))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o SPEC (← q r"p + &1:int") o
      MATCH_MP SHORT_EXACT_SEQUENCE_HOM_INDUCED_RELATIVIZATION) THEN
    REWRITE_TAC [← INT_ARITH (← q r"(p + &1) - &1:int = p")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      SPLITTING_LEMMA_RIGHT)) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"f:A->A") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"hom_induced p (top,{}) (subtopology top s,{}) (f:A->A)")) THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED, homology_group] THEN
    ANTS_TAC THENL
     [FIRST_ASSUM (STRIP_ASSUME_TAC o
        MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS) THEN
      GEN_TAC THEN DISCH_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN
      ASM_SIMP_TAC [← GSYM HOM_INDUCED_COMPOSE, IMAGE_CLAUSES, EMPTY_SUBSET,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_ID] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← GSYM (← MATCH_MP HOM_INDUCED_ID th)])) THEN
      AP_THM_TAC THEN REWRITE_TAC [o_DEF, ETA_AX, ← GSYM I_DEF] THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC HOMOLOGY_HOMOTOPY_EMPTY THEN
      ASM_REWRITE_TAC [],
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      REWRITE_TAC [normal_subgroup_of] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [GROUP_ISOMORPHISM_GROUP_MUL,
                    ABELIAN_RELATIVE_HOMOLOGY_GROUP]])

  let ISOMORPHIC_GROUP_HOMOLOGY_GROUP_PROD_DEFORMATION ← prove
   r"!p top s:A->bool.
        (?f. homotopic_with (\x. T) (top,top) I f /\
             IMAGE f (topspace top) SUBSET s)
        ==> homology_group(p,subtopology top s) isomorphic_group
            prod_group (homology_group(p,top))
                       (relative_homology_group(p + &1,top,s))"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_PROD_GROUP_SWAP_RIGHT] THEN
    DISCH_TAC THEN FIRST_ASSUM (MP_TAC o SPEC (← q r"p:int") o
      MATCH_MP GROUP_ISOMORPHISMS_HOMOLOGY_GROUP_PROD_DEFORMATION) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
     [← q r"h:(((num->real)->A)frag->bool)->bool",
      ← q r"k:(((num->real)->A)frag->bool)->bool"] THEN
    STRIP_TAC THEN
    TRANS_TAC ISOMORPHIC_GROUP_TRANS
     (← q r"prod_group
       (subgroup_generated (homology_group(p,subtopology top s:A topology)) h)
       (subgroup_generated (homology_group(p,subtopology top s)) k)") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN ASM_MESON_TAC [],
      MATCH_MP_TAC ISOMORPHIC_GROUP_PROD_GROUPS THEN
      GEN_REWRITE_TAC LAND_CONV [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN ASM_MESON_TAC []])

  let ISOMORPHIC_GROUP_HOMOLOGY_CONTRACTIBLE_SPACE_SUBTOPOLOGY ← prove
   r"(!top s:A->bool.
        contractible_space top /\ s SUBSET topspace top /\ ~(s = {})
        ==> homology_group (&0,subtopology top s) isomorphic_group
            prod_group integer_group (relative_homology_group(&1,top,s))) /\
   (!p top s:A->bool.
        ~(p = &0) /\
        contractible_space top /\ s SUBSET topspace top /\ ~(s = {})
        ==> homology_group (p,subtopology top s) isomorphic_group
            relative_homology_group(p + &1,top,s))"
   (SIMP_TAC [← GSYM UN_REDUCED_HOMOLOGY_GROUP,
              ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_OF_CONTRACTIBLE,
              ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"&0:int", ← q r"top:A topology", ← q r"s:A->bool"]
          ISOMORPHIC_GROUP_HOMOLOGY_GROUP_PROD_DEFORMATION) THEN
    REWRITE_TAC [INT_ADD_LID] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"a:A")) THEN EXISTS_TAC (← q r"(\x. a):A->A") THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, I_DEF] THEN
      ASM_MESON_TAC [CONTRACTIBLE_SPACE_ALT, SUBSET],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] ISOMORPHIC_GROUP_TRANS) THEN
      MATCH_MP_TAC ISOMORPHIC_GROUP_PROD_GROUPS THEN
      REWRITE_TAC [ISOMORPHIC_GROUP_REFL] THEN
      MATCH_MP_TAC ISOMORPHIC_GROUP_INTEGER_ZEROTH_HOMOLOGY_GROUP THEN
      ASM_SIMP_TAC [CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE] THEN
      ASM SET_TAC []])

  return { GROUP_EPIMORPHISM_HOM_INDUCED_INCLUSION, TRIVIAL_HOMOMORPHISM_HOM_INDUCED_RELATIVIZATION,
           GROUP_MONOMORPHISM_HOM_BOUNDARY_INCLUSION,
           SHORT_EXACT_SEQUENCE_HOM_INDUCED_RELATIVIZATION,
           GROUP_ISOMORPHISMS_HOMOLOGY_GROUP_PROD_DEFORMATION,
           ISOMORPHIC_GROUP_HOMOLOGY_GROUP_PROD_DEFORMATION,
           ISOMORPHIC_GROUP_HOMOLOGY_CONTRACTIBLE_SPACE_SUBTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Relative homology of contractible pairs.  (homology.ml 7460-7629)         -/
/- ------------------------------------------------------------------------- -/

structure HCT where
  TRIVIAL_RELATIVE_HOMOLOGY_GROUP_CONTRACTIBLE_SPACES : thm
  TRIVIAL_RELATIVE_HOMOLOGY_GROUP_ALT : thm
  GROUP_ISOMORPHISM_HOM_INDUCED_RELATIVIZATION_CONTRACTIBLE : thm
  ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_RELATIVIZATION_CONTRACTIBLE : thm
  GROUP_ISOMORPHISM_HOM_INDUCED_INCLUSION_CONTRACTIBLE : thm
  ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_INCLUSION_CONTRACTIBLE : thm
  GROUP_ISOMORPHISM_HOM_RELBOUNDARY_CONTRACTIBLE : thm
  ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_RELBOUNDARY_CONTRACTIBLE : thm
  ISOMORPHIC_RELATIVE_CONTRACTIBLE_SPACE_IMP_HOMOLOGY_GROUPS : thm
  deriving Inhabited

@[nospecialize]
def setupHCT [HolBase] (D : HomologyDeps) (BHTR : HTR) (BHT1 : HT1) (BHT2 : HT2) (BHT3 : HT3)
    (BHRD : HRD) (BHDR : HDR) (BHDF : HDF) : ExceptT String IO HCT := do
  -- @@SCOPE BEGIN
  let { ASM_INT_ARITH_TAC, SET_RULE, .. } := D
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, INTER_EMPTY, .. } := D.core1
  let { IN_CROSS, IN_INTER, MONO_EXISTS, .. } := D.core2
  let { SUBSET, .. } := D.core4
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, ISOMORPHIC_GROUP_PROD_GROUPS, ISOMORPHIC_GROUP_REFL,
        ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRANS, ISOMORPHIC_GROUP_TRIVIALITY,
        ISOMORPHIC_TO_TRIVIAL_GROUP, VERY_SHORT_EXACT_SEQUENCE, .. } := D.grp2
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := D.met1
  let { PROD_TOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_PROD_TOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, homotopic_with, .. } := D.met3
  let { TRIVIAL_HOMOLOGY_GROUP_EMPTY, TRIVIAL_RELATIVE_HOMOLOGY_GROUP_GEN, .. } := BHTR
  let { HOMOLOGY_EXACTNESS_TRIPLE_1, .. } := BHT1
  let { HOMOLOGY_EXACTNESS_TRIPLE_2, .. } := BHT2
  let { HOMOLOGY_EXACTNESS_TRIPLE_3, .. } := BHT3
  let { TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE, .. } := BHRD
  let { ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_CONTRACTIBLE, .. } := BHDR
  let { ISOMORPHIC_GROUP_HOMOLOGY_CONTRACTIBLE_SPACE_SUBTOPOLOGY, .. } := BHDF
  -- @@SCOPE END

  let TRIVIAL_RELATIVE_HOMOLOGY_GROUP_CONTRACTIBLE_SPACES ← prove
   r"!p top s:A->bool.
        contractible_space top /\
        contractible_space(subtopology top s) /\ ~(topspace top INTER s = {})
        ==> trivial_group(relative_homology_group(p,top,s))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
          ISOMORPHIC_GROUP_REDUCED_HOMOLOGY_BY_CONTRACTIBLE) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (SUBST1_TAC o SYM o MATCH_MP ISOMORPHIC_GROUP_TRIVIALITY) THEN
    ASM_SIMP_TAC [TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE])

  let TRIVIAL_RELATIVE_HOMOLOGY_GROUP_ALT ← prove
   r"!p top s f:A->A.
        continuous_map (top,subtopology top s) f /\
        homotopic_with (\k. IMAGE k s SUBSET s) (top,top) f I
        ==> trivial_group (relative_homology_group (p,top,s))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC TRIVIAL_RELATIVE_HOMOLOGY_GROUP_GEN THEN
    EXISTS_TAC (← q r"f:A->A") THEN ASM_REWRITE_TAC [homotopic_with] THEN CONJ_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopic_with]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [] THEN
    REWRITE_TAC [← CONJUNCT2 PROD_TOPOLOGY_SUBTOPOLOGY] THEN
    SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_SUBTOPOLOGY, IN_INTER,
                 IN_CROSS, FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY] THEN
    SIMP_TAC [])

  let GROUP_ISOMORPHISM_HOM_INDUCED_RELATIVIZATION_CONTRACTIBLE ← prove
   r"!p top s t:A->bool.
        contractible_space(subtopology top s) /\
        contractible_space(subtopology top t) /\
        t SUBSET s /\ ~(topspace top INTER t = {})
        ==> group_isomorphism (relative_homology_group(p,top,t),
                               relative_homology_group(p,top,s))
                              (hom_induced p (top,t) (top,s) (\x. x))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"hom_induced p (subtopology top s,t) (top,t) (\x:A. x)",
      ← q r"hom_induced p (top,t) (top,s) (\x:A. x)",
      ← q r"hom_relboundary p (top,s:A->bool,t)",
      ← q r"relative_homology_group(p,subtopology top (s:A->bool),t)",
      ← q r"relative_homology_group(p,top:A topology,t)",
      ← q r"relative_homology_group(p,top:A topology,s)",
      ← q r"relative_homology_group(p - &1,subtopology top (s:A->bool),t)"]
     VERY_SHORT_EXACT_SEQUENCE) THEN
    ASM_SIMP_TAC [HOMOLOGY_EXACTNESS_TRIPLE_1,
                  HOMOLOGY_EXACTNESS_TRIPLE_3] THEN
    DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THEN
    MATCH_MP_TAC TRIVIAL_RELATIVE_HOMOLOGY_GROUP_CONTRACTIBLE_SPACES THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY,
                  ← SET_RULE (← q r"t SUBSET s ==> s INTER t = t"),
                  ← SET_RULE (← q r"t SUBSET s ==> (u INTER s) INTER t = u INTER t")])

  let ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_RELATIVIZATION_CONTRACTIBLE ← prove
   r"!p top s t:A->bool.
        contractible_space(subtopology top s) /\
        contractible_space(subtopology top t) /\
        t SUBSET s /\ ~(topspace top INTER t = {})
        ==> relative_homology_group(p,top,t) isomorphic_group
            relative_homology_group(p,top,s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o MATCH_MP
     GROUP_ISOMORPHISM_HOM_INDUCED_RELATIVIZATION_CONTRACTIBLE) THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC])

  let GROUP_ISOMORPHISM_HOM_INDUCED_INCLUSION_CONTRACTIBLE ← prove
   r"!p top s t:A->bool.
        contractible_space top /\
        contractible_space(subtopology top s) /\
        t SUBSET s /\ ~(topspace top INTER s = {})
        ==> group_isomorphism (relative_homology_group(p,subtopology top s,t),
                               relative_homology_group(p,top,t))
                              (hom_induced p
                                (subtopology top s,t) (top,t) (\x. x))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"hom_relboundary (p + &1) (top:A topology,s,t)",
      ← q r"hom_induced p (subtopology top s,t) (top,t) (\x:A. x)",
      ← q r"hom_induced p (top,t) (top,s) (\x:A. x)",
      ← q r"relative_homology_group(p + &1,top,s:A->bool)",
      ← q r"relative_homology_group(p,subtopology top (s:A->bool),t)",
      ← q r"relative_homology_group(p,top:A topology,t)",
      ← q r"relative_homology_group(p,top,s:A->bool)"]
     VERY_SHORT_EXACT_SEQUENCE) THEN
    ASM_SIMP_TAC [HOMOLOGY_EXACTNESS_TRIPLE_3] THEN
    DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
     [ABBREV_TAC (← q r"q:int = p + &1") THEN
      SUBGOAL_THEN (← q r"p:int = q - &1") SUBST1_TAC THENL
       [ASM_INT_ARITH_TAC,
        ASM_SIMP_TAC [HOMOLOGY_EXACTNESS_TRIPLE_2]],
      CONJ_TAC THEN
      MATCH_MP_TAC TRIVIAL_RELATIVE_HOMOLOGY_GROUP_CONTRACTIBLE_SPACES THEN
      ASM_REWRITE_TAC []])

  let ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_INCLUSION_CONTRACTIBLE ← prove
   r"!p top s t:A->bool.
        contractible_space top /\
        contractible_space(subtopology top s) /\
        t SUBSET s /\ ~(topspace top INTER s = {})
        ==> relative_homology_group(p,subtopology top s,t) isomorphic_group
            relative_homology_group(p,top,t)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o MATCH_MP
     GROUP_ISOMORPHISM_HOM_INDUCED_INCLUSION_CONTRACTIBLE) THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC])

  let GROUP_ISOMORPHISM_HOM_RELBOUNDARY_CONTRACTIBLE ← prove
   r"!p top s t:A->bool.
        contractible_space top /\
        contractible_space(subtopology top t) /\
        t SUBSET s /\ ~(topspace top INTER t = {})
        ==> group_isomorphism
             (relative_homology_group(p,top,s),
              relative_homology_group(p - &1,subtopology top s,t))
             (hom_relboundary p (top,s,t))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"hom_induced p (top,t) (top,s) (\x:A. x)",
      ← q r"hom_relboundary p (top:A topology,s,t)",
      ← q r"hom_induced (p - &1) (subtopology top s,t) (top,t) (\x:A. x)",
      ← q r"relative_homology_group(p,top,t:A->bool)",
      ← q r"relative_homology_group(p,top,s:A->bool)",
      ← q r"relative_homology_group(p - &1,subtopology top s,t:A->bool)",
      ← q r"relative_homology_group(p - &1,top,t:A->bool)"]
     VERY_SHORT_EXACT_SEQUENCE) THEN
    ASM_SIMP_TAC [HOMOLOGY_EXACTNESS_TRIPLE_1,
                  HOMOLOGY_EXACTNESS_TRIPLE_2] THEN
    DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THEN
    MATCH_MP_TAC TRIVIAL_RELATIVE_HOMOLOGY_GROUP_CONTRACTIBLE_SPACES THEN
    ASM_REWRITE_TAC [])

  let ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_RELBOUNDARY_CONTRACTIBLE ← prove
   r"!p top s t:A->bool.
        contractible_space top /\
        contractible_space(subtopology top t) /\
        t SUBSET s /\ ~(topspace top INTER t = {})
        ==> relative_homology_group(p,top,s) isomorphic_group
            relative_homology_group(p - &1,subtopology top s,t)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"p:int") o MATCH_MP
     GROUP_ISOMORPHISM_HOM_RELBOUNDARY_CONTRACTIBLE) THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC])

  let ISOMORPHIC_RELATIVE_CONTRACTIBLE_SPACE_IMP_HOMOLOGY_GROUPS ← do
    let tac := fun (t : term) =>
      TRANS_TAC ISOMORPHIC_GROUP_TRANS t THEN
      ASM_SIMP_TAC [ISOMORPHIC_GROUP_HOMOLOGY_CONTRACTIBLE_SPACE_SUBTOPOLOGY] THEN
      GEN_REWRITE_TAC id [ISOMORPHIC_GROUP_SYM]
    prove
     r"!(top:A topology) (top':B topology) s t.
          contractible_space top /\ contractible_space top' /\
          s SUBSET topspace top /\ t SUBSET topspace top' /\
          (s = {} <=> t = {}) /\
          (!p. relative_homology_group(p,top,s) isomorphic_group
               relative_homology_group(p,top',t))
          ==> !p. homology_group(p,subtopology top s) isomorphic_group
                  homology_group(p,subtopology top' t)"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"t:B->bool = {}") THEN
      ASM_SIMP_TAC [TRIVIAL_HOMOLOGY_GROUP_EMPTY, TOPSPACE_SUBTOPOLOGY, INTER_EMPTY,
                    ISOMORPHIC_TO_TRIVIAL_GROUP] THEN
      REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"p:int = &0") THENL
       [tac (← q r"prod_group integer_group
                    (relative_homology_group (&1,top:A topology,s))") THEN
        tac (← q r"prod_group integer_group
                    (relative_homology_group (&1,top':B topology,t))") THEN
        ASM_SIMP_TAC [ISOMORPHIC_GROUP_PROD_GROUPS, ISOMORPHIC_GROUP_REFL],
        tac (← q r"relative_homology_group (p + &1,top:A topology,s)") THEN
        tac (← q r"relative_homology_group (p + &1,top':B topology,t)") THEN
        ASM_SIMP_TAC [ISOMORPHIC_GROUP_PROD_GROUPS, ISOMORPHIC_GROUP_REFL]])

  return { TRIVIAL_RELATIVE_HOMOLOGY_GROUP_CONTRACTIBLE_SPACES,
           TRIVIAL_RELATIVE_HOMOLOGY_GROUP_ALT,
           GROUP_ISOMORPHISM_HOM_INDUCED_RELATIVIZATION_CONTRACTIBLE,
           ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_RELATIVIZATION_CONTRACTIBLE,
           GROUP_ISOMORPHISM_HOM_INDUCED_INCLUSION_CONTRACTIBLE,
           ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_INCLUSION_CONTRACTIBLE,
           GROUP_ISOMORPHISM_HOM_RELBOUNDARY_CONTRACTIBLE,
           ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_RELBOUNDARY_CONTRACTIBLE,
           ISOMORPHIC_RELATIVE_CONTRACTIBLE_SPACE_IMP_HOMOLOGY_GROUPS }

/- ------------------------------------------------------------------------- -/
/- Homology groups of spheres.  (homology.ml 7630-7947)                      -/
/- ------------------------------------------------------------------------- -/

structure HSP where
  GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_GROUP_LOWER_HEMISPHERE : thm
  GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_UPPER_HEMISPHERE : thm
  deriving Inhabited

@[nospecialize]
def setupHSP [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) (BHXA : HXA)
    (BHDR : HDR) : ExceptT String IO HSP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        REAL_RING, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, let_CONV, .. } := D
  let { CARTESIAN_PRODUCT_UNIV, COND_RAND, COND_RATOR, CONJ_ASSOC, DELETE, EMPTY_SUBSET, EQ_IMP,
        ETA_AX, FINITE_EMPTY, FINITE_INSERT, FINITE_NUMSEG, FINITE_RESTRICT, FORALL_IN_IMAGE,
        FORALL_PAIR_THM, FUN_EQ_THM, IMAGE_ID, IMAGE_o, IMP_CONJ_ALT, IMP_IMP, INSERT_SUBSET,
        INTER_UNIV, .. } := D.core1
  let { IN_CROSS, IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNIV, I_DEF, I_THM, LAMBDA_PAIR,
        LAMBDA_PAIR_THM, LEFT_FORALL_IMP_THM, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_ADD_RID, REAL_DIV_REFL, REAL_LE_POW_2, REAL_LE_REFL, REAL_LE_SQUARE_ABS,
        REAL_LE_TRANS, REAL_LT_POW_2, REAL_LT_SQUARE_ABS, REAL_MUL_LID, REAL_MUL_RZERO,
        REAL_NEG_0, REAL_NOT_LT, REAL_POS, REAL_POW_DIV, REAL_POW_MUL, REAL_SUB_0,
        REAL_SUB_LE, .. } := D.core3
  let { SQRT_EQ_0, SQRT_POW_2, SUBSET, SUBSET_INTER, SUBSET_TRANS, SUBSET_UNIV, SUM_CASES,
        SUM_CLAUSES, SUM_DELETE, SUM_DELTA, SUM_LMUL, SUM_SING, SUM_SUBSET_SIMPLE, o_DEF, o_THM,
        real_ge, .. } := D.core4
  let { IN_REAL_INTERVAL, .. } := D.lib
  let { GROUP_ISOMORPHISM_COMPOSE, .. } := D.grp2
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CLOSURE_OF_MINIMAL, CLOSURE_OF_RESTRICT,
        CONTINUOUS_MAP_CASES_LE, CONTINUOUS_MAP_COMPONENTWISE_UNIV, CONTINUOUS_MAP_COMPOSE,
        CONTINUOUS_MAP_EQ, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID,
        CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND, CONTINUOUS_MAP_PAIRWISE,
        CONTINUOUS_MAP_PRODUCT_PROJECTION, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_DIV,
        CONTINUOUS_MAP_REAL_MAX, CONTINUOUS_MAP_REAL_MUL, CONTINUOUS_MAP_REAL_NEG,
        CONTINUOUS_MAP_REAL_NEG_EQ, CONTINUOUS_MAP_REAL_POW, CONTINUOUS_MAP_REAL_SUB,
        CONTINUOUS_MAP_SQRT, CONTRACTIBLE_SPACE_LOWER_HEMISPHERE, .. } := D.met1
  let { HOMOTOPIC_WITH, INTERIOR_OF_MAXIMAL, NSPHERE, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, .. } :=
    D.met2
  let { REAL_CLOSED_HALFSPACE_LE, REAL_CLOSED_IN, REAL_OPEN_HALFSPACE_LT, REAL_OPEN_IN,
        SUBTOPOLOGY_UNIV, TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY,
        TOPSPACE_PRODUCT_TOPOLOGY, TOPSPACE_PROD_TOPOLOGY, TOPSPACE_SUBTOPOLOGY,
        retraction_maps, .. } := D.met3
  let { RELATIVE_HOMOLOGY_GROUP_RESTRICT, .. } := BHGP
  let { HOM_INDUCED_RESTRICT, .. } := BHIN
  let { HOM_INDUCED_COMPOSE, .. } := BHIF
  let { HOMOLOGY_EXCISION_AXIOM, .. } := BHXA
  let { DEFORMATION_RETRACT_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM_ID,
        GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_BY_CONTRACTIBLE, .. } := BHDR
  -- @@SCOPE END

