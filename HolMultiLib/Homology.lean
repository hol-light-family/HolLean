  let { IN_REAL_INTERVAL, is_realinterval, .. } := D.lib
  let { CLOSED_IN_EUCLIDEAN_SPACE, CLOSED_IN_SUBSET, CLOSED_IN_SUBSET_TOPSPACE,
        CLOSED_IN_TRANS_FULL, CONTINUOUS_MAP_COMPONENTWISE_UNIV, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_ID, CONTINUOUS_MAP_PRODUCT_PROJECTION, CONTINUOUS_MAP_REAL_ADD,
        CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_RMUL, CONTINUOUS_MAP_REAL_SUB,
        CONTRACTIBLE_EUCLIDEAN_SPACE, .. } := D.met1
  let { HOMEOMORPHIC_SPACE_REFL, .. } := D.met2
  let { PATH_COMPONENT_OF_SYM, PATH_COMPONENT_OF_TRANS, PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE,
        PATH_CONNECTED_IN_EUCLIDEANREAL, PATH_CONNECTED_IN_SUBTOPOLOGY,
        PATH_CONNECTED_IN_TOPSPACE, PATH_CONNECTED_IN_UNION,
        PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT, PATH_IN_SUBTOPOLOGY, SUBSET_EUCLIDEAN_SPACE,
        SUBTOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_TOPSPACE, TOPSPACE_EUCLIDEAN_SPACE,
        TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, euclidean_space, path_component_of,
        path_connected_in, path_in, .. } := D.met3
  let { ISOMORPHIC_HOMOLOGY_IMP_PATH_CONNECTEDNESS, .. } := BHBP
  let { ISOMORPHIC_RELATIVE_CONTRACTIBLE_SPACE_IMP_HOMOLOGY_GROUPS, .. } := BHCT
  let { ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_EUCLIDEAN_COMPLEMENTS, .. } := BHCM
  -- @@SCOPE END

  let INVARIANCE_OF_DIMENSION_CLOSED_IN_EUCLIDEAN_SPACE ← do
    let lemma ← prove
     r"!n s t:(num->real)->bool.
            s SUBSET t /\ ~(s = {}) /\ t SUBSET topspace(euclidean_space n) /\
            (!a b u. a IN s /\ b IN t /\ &0 < u /\ u < &1
                     ==> (\i. (&1 - u) * a i + u * b i) IN s)
            ==> path_connected_in (euclidean_space n) t"
     (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [path_connected_in] THEN
      SUBGOAL_THEN (← q r"t SUBSET topspace(euclidean_space n)") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT] THEN
      ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:num->real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"!x. x IN t ==> path_component_of (subtopology (euclidean_space n) t) a x")
      MP_TAC THENL
       [ALL_TAC,
        ASM_MESON_TAC [PATH_COMPONENT_OF_SYM, PATH_COMPONENT_OF_TRANS]] THEN
      X_GEN_TAC (← q r"b:num->real") THEN DISCH_TAC THEN
      REWRITE_TAC [path_component_of] THEN
      EXISTS_TAC (← q r"(\t i. (&1 - t) * a i + t * b i):real->num->real") THEN
      REWRITE_TAC [REAL_SUB_REFL, REAL_SUB_RZERO, REAL_MUL_LZERO] THEN
      REWRITE_TAC [REAL_MUL_LID, REAL_ADD_LID, REAL_ADD_RID, ETA_AX] THEN
      REWRITE_TAC [euclidean_space, SUBTOPOLOGY_SUBTOPOLOGY] THEN
      REWRITE_TAC [PATH_IN_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [← GSYM TOPSPACE_SUBTOPOLOGY] THEN CONJ_TAC THENL
       [REWRITE_TAC [path_in, CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN GEN_TAC THEN
        MATCH_MP_TAC CONTINUOUS_MAP_REAL_ADD THEN CONJ_TAC THEN
        MATCH_MP_TAC CONTINUOUS_MAP_REAL_RMUL THEN
        MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
        REWRITE_TAC [CONTINUOUS_MAP_ID] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB THEN
        REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_REAL_CONST],
        ASM_SIMP_TAC [IN_REAL_INTERVAL, ← GSYM TOPSPACE_EUCLIDEAN_SPACE,
                      ← SET_RULE (← q r"t SUBSET u ==> u INTER t = t")] THEN
        REWRITE_TAC [← REAL_ARITH
         (← q r"&0 <= x /\ x <= &1 <=> x = &0 \/ x = &1 \/ &0 < x /\ x < &1")] THEN
        REPEAT STRIP_TAC THEN
        ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_SUB_RZERO, REAL_MUL_LZERO] THEN
        REWRITE_TAC [REAL_MUL_LID, REAL_ADD_LID, REAL_ADD_RID, ETA_AX] THEN
        ASM SET_TAC []])
    prove
     r"!n s. closed_in (euclidean_space n) s
           ==> (subtopology (euclidean_space n) s homeomorphic_space
                euclidean_space n <=>
                s = topspace(euclidean_space n))"
     (REPEAT STRIP_TAC THEN EQ_TAC THEN
      SIMP_TAC [SUBTOPOLOGY_TOPSPACE, HOMEOMORPHIC_SPACE_REFL] THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET t /\ (!x. ~(~(x IN s) /\ x IN t)) ==> s = t")) THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"a:num->real") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"closed_in (euclidean_space (n + 1)) (topspace(euclidean_space n))")
      ASSUME_TAC THENL
       [REWRITE_TAC [euclidean_space] THEN
        MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN
        REWRITE_TAC [← GSYM euclidean_space, CLOSED_IN_EUCLIDEAN_SPACE] THEN
        REWRITE_TAC [← GSYM TOPSPACE_EUCLIDEAN_SPACE, SUBSET_EUCLIDEAN_SPACE] THEN
        ARITH_TAC,
        ALL_TAC] THEN
       SUBGOAL_THEN
        (← q r"subtopology (euclidean_space(n + 1)) (topspace(euclidean_space n)) =
         euclidean_space n")
       ASSUME_TAC THENL
        [REWRITE_TAC [euclidean_space, SUBTOPOLOGY_SUBTOPOLOGY] THEN
         AP_TERM_TAC THEN REWRITE_TAC [← GSYM euclidean_space] THEN
         REWRITE_TAC [← GSYM TOPSPACE_EUCLIDEAN_SPACE] THEN
         REWRITE_TAC [← SET_RULE (← q r"t INTER s = s <=> s SUBSET t")] THEN
         REWRITE_TAC [SUBSET_EUCLIDEAN_SPACE] THEN ARITH_TAC,
         ALL_TAC] THEN
      SUBGOAL_THEN (← q r"closed_in (euclidean_space(n + 1)) s") ASSUME_TAC THENL
       [ASM_MESON_TAC [CLOSED_IN_TRANS_FULL], ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"subtopology (euclidean_space (n + 1))
                     (topspace(euclidean_space(n + 1)) DIFF s)",
        ← q r"subtopology (euclidean_space (n + 1))
                     (topspace(euclidean_space(n + 1)) DIFF
                      topspace(euclidean_space n))"]
       ISOMORPHIC_HOMOLOGY_IMP_PATH_CONNECTEDNESS) THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ ~r /\ q ==> (p ==> (q <=> r)) ==> F")) THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM]
          ISOMORPHIC_RELATIVE_CONTRACTIBLE_SPACE_IMP_HOMOLOGY_GROUPS) THEN
        REWRITE_TAC [CONTRACTIBLE_EUCLIDEAN_SPACE, SUBSET_DIFF] THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC (← SET_RULE
           (← q r"t SUBSET s /\ s SUBSET u /\ ~(u SUBSET s)
            ==> (u DIFF t = {} <=> u DIFF s = {})")) THEN
          ASM_REWRITE_TAC [SUBSET_EUCLIDEAN_SPACE] THEN ARITH_TAC,
          GEN_TAC THEN MATCH_MP_TAC
           ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_EUCLIDEAN_COMPLEMENTS THEN
          ASM_REWRITE_TAC [] THEN
          SUBGOAL_THEN
           (← q r"subtopology (euclidean_space (n + 1)) s =
            subtopology (euclidean_space n) s")
           (fun th => ASM_REWRITE_TAC [th]) THEN
          REWRITE_TAC [euclidean_space, SUBTOPOLOGY_SUBTOPOLOGY] THEN
          AP_TERM_TAC THEN REWRITE_TAC [← GSYM TOPSPACE_EUCLIDEAN_SPACE] THEN
          MATCH_MP_TAC (← SET_RULE
