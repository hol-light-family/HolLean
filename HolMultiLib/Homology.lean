  return { GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_GROUP_LOWER_HEMISPHERE,
           GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_UPPER_HEMISPHERE }

/- ------------------------------------------------------------------------- -/
/- Hemisphere isomorphisms.  (homology.ml 7948-8115)                         -/
/- ------------------------------------------------------------------------- -/

structure HHM where
  GROUP_ISOMORPHISM_UPPER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP : thm
  GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_GROUP_UPPER_HEMISPHERE : thm
  GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_LOWER_HEMISPHERE : thm
  GROUP_ISOMORPHISM_LOWER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupHHM [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) (BHTR : HTR)
    (BHDR : HDR) (BHSP : HSP) : ExceptT String IO HHM := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, INT_ARITH_TAC, MESON, MESON_TAC,
        REAL_ARITH, REAL_ARITH_TAC, SET_RULE, REAL_RAT_REDUCE_CONV, .. } := D
  let { CARTESIAN_PRODUCT_UNIV, COND_RAND, COND_RATOR, CONJ_ASSOC, ETA_AX, EXTENSION,
        FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_NUMSEG, IN_UNIV, MEMBER_NOT_EMPTY,
        NUMSEG_CLAUSES, .. } := D.core2
  let { REAL_ADD_RID, REAL_NEG_NEG, .. } := D.core3
  let { SUBSET, SUM_CLAUSES_NUMSEG, SUM_DELTA, o_DEF, real_ge, .. } := D.core4
  let { GROUP_ISOMORPHISM_COMPOSE, .. } := D.grp2
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        CONTINUOUS_MAP_NSPHERE_REFLECTION, CONTRACTIBLE_SPACE_LOWER_HEMISPHERE,
        CONTRACTIBLE_SPACE_UPPER_HEMISPHERE, .. } := D.met1
  let { HOMEOMORPHIC_MAP_MAPS, NSPHERE, .. } := D.met2
  let { SUBTOPOLOGY_NSPHERE_EQUATOR, SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_EUCLIDEANREAL,
        TOPSPACE_PRODUCT_TOPOLOGY, TOPSPACE_SUBTOPOLOGY, continuous_map, homeomorphic_maps, .. } :=
    D.met3
  let { RELATIVE_HOMOLOGY_GROUP_RESTRICT, .. } := BHGP
  let { HOM_INDUCED_RESTRICT, .. } := BHIN
  let { HOM_INDUCED_COMPOSE, .. } := BHIF
  let { HOMEOMORPHIC_MAP_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM, .. } := BHTR
  let { GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_BY_CONTRACTIBLE,
        GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE, .. } := BHDR
  let { GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_UPPER_HEMISPHERE, .. } := BHSP
  -- @@SCOPE END

  let GROUP_ISOMORPHISM_UPPER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP ← prove
   r"!p n. group_isomorphism
           (relative_homology_group
                (p + &1,subtopology (nsphere (n + 1)) {x | x(n+2) >= &0},
                        {x | x(n+2) = &0}),
            reduced_homology_group(p,nsphere n))
           (hom_boundary (p + &1)
                         (subtopology (nsphere (n + 1)) {x | x(n+2) >= &0},
                         {x | x(n+2) = &0}))"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"nsphere n =
      subtopology (subtopology (nsphere (n + 1)) {x | x(n+2) >= &0})
                  {x | x(n+2) = &0}")
    SUBST1_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [← GSYM SUBTOPOLOGY_NSPHERE_EQUATOR] THEN
      REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTER] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    ABBREV_TAC (← q r"q:int = p + &1") THEN
    SUBGOAL_THEN (← q r"p:int = q - &1") SUBST1_TAC THENL
     [EXPAND_TAC "q" THEN INT_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONTRACTIBLE_SPACE_UPPER_HEMISPHERE THEN
      REWRITE_TAC [IN_NUMSEG] THEN ARITH_TAC,
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_ELIM_THM, real_ge, IN_UNIV,
                   TOPSPACE_SUBTOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY, NSPHERE,
                   o_DEF, TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV] THEN
      EXISTS_TAC (← q r"(\i. if i = n + 1 then &1 else &0):num->real") THEN
      ASM_REWRITE_TAC [← ARITH_RULE (← q r"(n + 1) + 1 = n + 2")] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"~(n + 2 = n + 1)")] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN CONJ_TAC THENL
       [REWRITE_TAC [COND_RAND, COND_RATOR] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_REWRITE_TAC [SUM_DELTA, IN_NUMSEG] THEN
        COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM_ARITH_TAC,
        GEN_TAC THEN REWRITE_TAC [IN_NUMSEG] THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC]])

  let GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_GROUP_UPPER_HEMISPHERE ← prove
   r"!p n k. k IN 1..n+1
           ==> group_isomorphism
                (reduced_homology_group (p,nsphere n),
                 relative_homology_group (p,nsphere n,{x | x k >= &0}))
                (hom_induced p (nsphere n,{}) (nsphere n,{x | x k >= &0})
                               (\x. x))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_BY_CONTRACTIBLE THEN
    ASM_SIMP_TAC [CONTRACTIBLE_SPACE_UPPER_HEMISPHERE, ← GSYM MEMBER_NOT_EMPTY] THEN
    EXISTS_TAC (← q r"(\i. if i = k then &1 else &0):num->real") THEN
    REWRITE_TAC [NSPHERE, TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, o_DEF, TOPSPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_UNIV, IN_UNIV] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    REWRITE_TAC [COND_RAND, COND_RATOR] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_REWRITE_TAC [SUM_DELTA])

  let GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_LOWER_HEMISPHERE ← prove
   r"!p n k.
        group_isomorphism
         (relative_homology_group
               (p,subtopology (nsphere n) {x | x k <= &0},{x | x k = &0}),
          relative_homology_group
               (p,nsphere n,{x | x k >= &0}))
         (hom_induced p
               (subtopology (nsphere n) {x | x k <= &0},{x | x k = &0})
               (nsphere n,{x | x k >= &0})
               (\x. x))"
   (REPEAT GEN_TAC THEN MP_TAC (← SPEC_ALL
      GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_UPPER_HEMISPHERE) THEN
    MATCH_MP_TAC (← MESON [GROUP_ISOMORPHISM_COMPOSE]
      (← q r"!f h. group_isomorphism(G',G) f /\
             group_isomorphism(H,H') h /\ h o g o f = k
             ==> group_isomorphism(G,H) g
                 ==> group_isomorphism(G',H') k")) THEN
    ABBREV_TAC (← q r"r = \(x:num->real) i. if i = k then --x i else x i") THEN
    MP_TAC (← SPECL [← q r"n:num", ← q r"k:num"] CONTINUOUS_MAP_NSPHERE_REFLECTION) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"!x:num->real. r(r x) = x") ASSUME_TAC THENL
     [EXPAND_TAC "r" THEN SIMP_TAC [FUN_EQ_THM, REAL_NEG_NEG] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"hom_induced p (subtopology (nsphere n) {x | x k <= &0},{x | x k = &0})
         (subtopology (nsphere n) {x | x k >= &0},{x | x k = &0}) r",
      ← q r"hom_induced p (nsphere n,{x | x k <= &0})
                     (nsphere n,{x | x k >= &0}) r"] THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN
      ONCE_REWRITE_TAC [HOM_INDUCED_RESTRICT,
                        RELATIVE_HOMOLOGY_GROUP_RESTRICT] THEN
      MATCH_MP_TAC HOMEOMORPHIC_MAP_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM THEN
      (CONJ_TAC THENL
        [REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS] THEN
         EXISTS_TAC (← q r"r:(num->real)->(num->real)") THEN
         ASM_REWRITE_TAC [homeomorphic_maps],
         ALL_TAC]),
      W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
        rand o lhand o snd) THEN
      SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
      ANTS_TAC THENL
       [ALL_TAC,
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
          lhand o snd) THEN
        ANTS_TAC THENL
         [ALL_TAC,
          DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_SIMP_TAC [o_DEF]]]] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, o_DEF, ETA_AX] THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, ← SET_RULE
     (← q r"(!x. r(r x) = x)
      ==> (IMAGE r s = t <=> IMAGE r s SUBSET t /\ IMAGE r t SUBSET s)")] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTER, IN_ELIM_THM,
                 TOPSPACE_SUBTOPOLOGY] THEN
    FIRST_X_ASSUM (ASSUME_TAC o CONJUNCT1 o REWRITE_RULE [continuous_map]) THEN
    ASM_SIMP_TAC [] THEN EXPAND_TAC "r" THEN REWRITE_TAC [] THEN
    REAL_ARITH_TAC)

  let GROUP_ISOMORPHISM_LOWER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP ← prove
   r"!p n. group_isomorphism
           (relative_homology_group
                (p + &1,subtopology (nsphere (n + 1)) {x | x(n+2) <= &0},
                        {x | x(n+2) = &0}),
            reduced_homology_group(p,nsphere n))
           (hom_boundary (p + &1)
                         (subtopology (nsphere (n + 1)) {x | x(n+2) <= &0},
                         {x | x(n+2) = &0}))"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"nsphere n =
      subtopology (subtopology (nsphere (n + 1)) {x | x(n+2) <= &0})
                  {x | x(n+2) = &0}")
    SUBST1_TAC THENL
     [REWRITE_TAC [NSPHERE, SUBTOPOLOGY_SUBTOPOLOGY] THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:num->real") THEN
      REWRITE_TAC [IN_INTER, IN_ELIM_THM, ← GSYM CONJ_ASSOC] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(n + 1) + 1 = SUC(n + 1)"), SUM_CLAUSES_NUMSEG] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"1 <= SUC n"), NUMSEG_CLAUSES] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"SUC(n + 1) = n + 2"), IN_INSERT] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x >= &0 /\ x = &0 <=> x = &0"), IN_NUMSEG] THEN
      ASM_CASES_TAC (← q r"(x:num->real)(n + 2) = &0") THENL
       [ALL_TAC, ASM_MESON_TAC [← ARITH_RULE (← q r"~(n + 2 <= n + 1)")]] THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [REAL_ADD_RID] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"q:int = p + &1") THEN
    SUBGOAL_THEN (← q r"p:int = q - &1") SUBST1_TAC THENL
     [EXPAND_TAC "q" THEN INT_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_OF_CONTRACTIBLE THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONTRACTIBLE_SPACE_LOWER_HEMISPHERE THEN
      REWRITE_TAC [IN_NUMSEG] THEN ARITH_TAC,
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_ELIM_THM, real_ge, IN_UNIV,
                   TOPSPACE_SUBTOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY, NSPHERE,
                   o_DEF, TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV] THEN
      EXISTS_TAC (← q r"(\i. if i = n + 1 then &1 else &0):num->real") THEN
      ASM_REWRITE_TAC [← ARITH_RULE (← q r"(n + 1) + 1 = n + 2")] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"~(n + 2 = n + 1)")] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN CONJ_TAC THENL
       [REWRITE_TAC [COND_RAND, COND_RATOR] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_REWRITE_TAC [SUM_DELTA, IN_NUMSEG] THEN
        COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM_ARITH_TAC,
        GEN_TAC THEN REWRITE_TAC [IN_NUMSEG] THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC]])

  return { GROUP_ISOMORPHISM_UPPER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP,
           GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_GROUP_UPPER_HEMISPHERE,
           GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_LOWER_HEMISPHERE,
           GROUP_ISOMORPHISM_LOWER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP }

/- ------------------------------------------------------------------------- -/
/- Reduced homology of spheres.  (homology.ml 8116-8340)                     -/
/- ------------------------------------------------------------------------- -/

structure HNS where
  REDUCED_HOMOLOGY_GROUP_NSPHERE_STEP : thm
  REDUCED_HOMOLOGY_GROUP_NSPHERE : thm
  CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE : thm
  TRIVIAL_REDUCED_HOMOLOGY_GROUP_NSPHERE : thm
  NON_CONTRACTIBLE_SPACE_NSPHERE : thm
  deriving Inhabited

@[nospecialize]
def setupHNS [HolBase] (D : HomologyDeps) (BHIN : HIN) (BHIF : HIF) (BHAX : HAX) (BHBP : HBP)
    (BHRD : HRD) (BHDR : HDR) (BHSP : HSP) (BHHM : HHM) : ExceptT String IO HNS := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, INT_ARITH, MESON, MESON_TAC, REAL_ARITH,
        REAL_RING, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { ADD1, ADD_CLAUSES, CARTESIAN_PRODUCT_UNIV, EMPTY_SUBSET, EXTENSION, FORALL_IN_IMAGE,
        FUN_EQ_THM, IMAGE_CLAUSES, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INTER_UNIV,
        INT_EQ_ADD_RCANCEL, .. } := D.core1
  let { INT_OF_NUM_SUC, IN_ELIM_THM, IN_INSERT, IN_INTER, IN_NUMSEG, IN_SING, IN_UNIV,
        LEFT_AND_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, NUMSEG_SING, .. } := D.core2
  let { REAL_LE_REFL, .. } := D.core3
  let { SUBSET, SUM_SING, SWAP_EXISTS_THM, num_INDUCTION, o_DEF, o_THM, .. } := D.core4
  let { CYCLIC_INTEGER_GROUP, GROUP_ISOMORPHISM, .. } := D.grp1
  let { GROUP_ISOMORPHISM_COMPOSE, ISOMORPHIC_GROUP_CYCLICITY, ISOMORPHIC_GROUP_SYM,
        ISOMORPHIC_GROUP_TRANS, ISOMORPHIC_GROUP_TRIVIALITY, NON_TRIVIAL_INTEGER_GROUP,
        TRIVIAL_IMP_CYCLIC_GROUP, group_homomorphism, group_isomorphism, group_isomorphisms,
        isomorphic_group, .. } := D.grp2
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        CONTINUOUS_MAP_NSPHERE_REFLECTION,
        CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY, .. } := D.met1
  let { NONEMPTY_NSPHERE, NSPHERE, .. } := D.met2
  let { SUBTOPOLOGY_NSPHERE_EQUATOR, SUBTOPOLOGY_SUBTOPOLOGY, T1_SPACE_EUCLIDEANREAL,
        T1_SPACE_PRODUCT_TOPOLOGY, TOPSPACE_EUCLIDEANREAL, TOPSPACE_PRODUCT_TOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, .. } := D.met3
  let { HOM_INDUCED, .. } := BHIN
  let { HOM_INDUCED_COMPOSE, NATURALITY_HOM_INDUCED, .. } := BHIF
  let { HOMOLOGY_DIMENSION_AXIOM, .. } := BHAX
  let { HOMOLOGY_COEFFICIENTS, .. } := BHBP
  let { HOMOLOGY_DIMENSION_REDUCED,
        HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS,
        HOM_INDUCED_REDUCED, .. } := BHRD
  let { REDUCED_HOMOLOGY_GROUP_PAIR, .. } := BHDR
  let { GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_GROUP_LOWER_HEMISPHERE,
        GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_UPPER_HEMISPHERE, .. } := BHSP
  let { GROUP_ISOMORPHISM_UPPER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP, .. } := BHHM
  -- @@SCOPE END

  let REDUCED_HOMOLOGY_GROUP_NSPHERE_STEP ← do
    let isomorphism_sym ← prove
     r"!G1 G2 (r:A->A) (r':A->A).
          (?f. group_isomorphism(G1,G2) f /\
               !x. x IN group_carrier G1 ==> r'(f x) = f(r x))
          ==> (!x. x IN group_carrier G1 ==> r x IN group_carrier G1)
              ==> (?f. group_isomorphism(G2,G1) f /\
                       !x. x IN group_carrier G2 ==> r(f x) = f(r' x))"
     (REPEAT GEN_TAC THEN REWRITE_TAC [← TAUT
       (← q r"p ==> q ==> r <=> q ==> p ==> r")] THEN DISCH_TAC THEN
      REWRITE_TAC [group_isomorphism, LEFT_AND_EXISTS_THM] THEN
      GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      REWRITE_TAC [group_isomorphisms, group_homomorphism] THEN
      ASM SET_TAC [])
    let isomorphism_trans ← prove
     r"!G1 G2 G3 (r:A->A) (r':A->A) (r'':A->A).
          (?f. group_isomorphism(G1,G2) f /\
               !x. x IN group_carrier G1 ==> r'(f x) = f(r x)) /\
          (?f. group_isomorphism(G2,G3) f /\
               !x. x IN group_carrier G2 ==> r''(f x) = f(r' x))
          ==> (?f. group_isomorphism(G1,G3) f /\
                   !x. x IN group_carrier G1 ==> r''(f x) = f(r x))"
     (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"f:A->A") STRIP_ASSUME_TAC)
       (X_CHOOSE_THEN (← q r"g:A->A") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"(g:A->A) o (f:A->A)") THEN
      CONJ_TAC THENL [ASM_MESON_TAC [GROUP_ISOMORPHISM_COMPOSE], ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [GROUP_ISOMORPHISM]) THEN
      REWRITE_TAC [o_DEF] THEN ASM SET_TAC [])
    prove
     r"!p n. ?f.
          group_isomorphism(reduced_homology_group (p,nsphere n),
                            reduced_homology_group(p + &1,nsphere (n + 1))) f /\
          !c. c IN group_carrier(reduced_homology_group(p,nsphere n))
              ==> hom_induced (p + &1) (nsphere(n + 1),{}) (nsphere(n + 1),{})
                              (\x i. if i = 1 then --x i else x i)
                              (f c) =
                  f (hom_induced p (nsphere n,{}) (nsphere n,{})
                                 (\x i. if i = 1 then --x i else x i) c)"
     (REPEAT GEN_TAC THEN
      ABBREV_TAC (← q r"r = \(x:num->real) i. if i = 1 then --x i else x i") THEN
      SUBGOAL_THEN
       (← q r"!n. continuous_map (nsphere n,nsphere n) r")
      ASSUME_TAC THENL
       [EXPAND_TAC "r" THEN REWRITE_TAC [CONTINUOUS_MAP_NSPHERE_REFLECTION],
        ALL_TAC] THEN
      MATCH_MP_TAC isomorphism_trans THEN
      MAP_EVERY EXISTS_TAC
       [← q r"relative_homology_group(p + &1,
             subtopology (nsphere (n + 1)) {x | x (n + 2) >= &0},
             {x | x (n + 2) = &0})",
        ← q r"hom_induced (p + &1)
                   (subtopology (nsphere (n + 1)) {x | x (n + 2) >= &0},
                    {x | x (n + 2) = &0})
                   (subtopology (nsphere (n + 1)) {x | x (n + 2) >= &0},
                    {x | x (n + 2) = &0}) r"] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_IMP] isomorphism_sym) THEN
        REWRITE_TAC [HOM_INDUCED] THEN
        EXISTS_TAC (← q r"hom_boundary (p + &1)
             (subtopology (nsphere (n + 1)) {x | x (n + 2) >= &0},
              {x | x (n + 2) = &0})") THEN
        SIMP_TAC [GROUP_ISOMORPHISM_UPPER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP] THEN
        REPEAT STRIP_TAC THEN
        GEN_REWRITE_TAC BINOP_CONV [← GSYM o_THM] THEN AP_THM_TAC THEN
        W (MP_TAC o PART_MATCH (lhand o rand) NATURALITY_HOM_INDUCED o
          rand o snd) THEN
        REWRITE_TAC [← INT_ARITH (← q r"(p + &1) - &1:int = p")] THEN ANTS_TAC THENL
         [ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY,
                        CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTER, IN_ELIM_THM,
                       TOPSPACE_SUBTOPOLOGY] THEN
          EXPAND_TAC "r" THEN SIMP_TAC [← ARITH_RULE (← q r"~(n + 2 = 1)")],
          DISCH_THEN SUBST1_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
          REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
          REWRITE_TAC [← SET_RULE (← q r"{x | P x} INTER {x | Q x} = {x | P x /\ Q x}")] THEN
          REWRITE_TAC [← REAL_ARITH (← q r"x:real >= &0 /\ x = &0 <=> x = &0")] THEN
          REWRITE_TAC [SUBTOPOLOGY_NSPHERE_EQUATOR]],
        ALL_TAC] THEN
      MATCH_MP_TAC isomorphism_trans THEN
      MAP_EVERY EXISTS_TAC
       [← q r"relative_homology_group(p + &1,nsphere (n + 1),{x | x(n + 2) <= &0})",
        ← q r"hom_induced (p + &1)
                   (nsphere (n + 1),{x | x (n + 2) <= &0})
                   (nsphere (n + 1),{x | x (n + 2) <= &0}) r"] THEN
      CONJ_TAC THENL
       [EXISTS_TAC
         (← q r"hom_induced (p + &1)
            (subtopology (nsphere(n + 1)) {x | x(n+2) >= &0},{x | x(n+2) = &0})
            (nsphere(n+1),{x | x(n+2) <= &0})
           (\x. x)") THEN
        SIMP_TAC [GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_UPPER_HEMISPHERE] THEN
        REPEAT STRIP_TAC THEN
        GEN_REWRITE_TAC BINOP_CONV [← GSYM o_THM] THEN AP_THM_TAC THEN
        W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
          rand o snd) THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_ID,
                      CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
        ANTS_TAC THENL
         [EXPAND_TAC "r" THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
          REWRITE_TAC [IN_ELIM_THM, TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
          SIMP_TAC [← ARITH_RULE (← q r"~(n + 2 = 1)"), REAL_LE_REFL],
          DISCH_THEN (SUBST1_TAC o SYM)] THEN
        W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
          lhand o snd) THEN
        ANTS_TAC THENL [ALL_TAC, SIMP_TAC [o_DEF]] THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
        EXPAND_TAC "r" THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        SIMP_TAC [IN_ELIM_THM, ← ARITH_RULE (← q r"~(n + 2 = 1)"), REAL_LE_REFL],
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_IMP] isomorphism_sym) THEN
        SIMP_TAC [HOM_INDUCED_REDUCED] THEN
        EXISTS_TAC (← q r"hom_induced (p + &1) (nsphere(n + 1),{})
                          (nsphere (n + 1),{x | x(n + 2) <= &0}) (\x. x)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC
            GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_GROUP_LOWER_HEMISPHERE THEN
          REWRITE_TAC [IN_NUMSEG] THEN ARITH_TAC,
          REPEAT STRIP_TAC THEN
          GEN_REWRITE_TAC BINOP_CONV [← GSYM o_THM] THEN AP_THM_TAC THEN
          W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
            rand o snd) THEN
          ASM_REWRITE_TAC [IMAGE_CLAUSES, CONTINUOUS_MAP_ID, EMPTY_SUBSET] THEN
          DISCH_THEN (SUBST1_TAC o SYM) THEN
          W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
            lhand o snd) THEN
          ASM_REWRITE_TAC [IMAGE_CLAUSES, CONTINUOUS_MAP_ID, EMPTY_SUBSET] THEN
          ANTS_TAC THENL [ALL_TAC, SIMP_TAC [o_DEF]] THEN
          EXPAND_TAC "r" THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
          REWRITE_TAC [← ARITH_RULE (← q r"~(n + 2 = 1)")]]])

  let REDUCED_HOMOLOGY_GROUP_NSPHERE ← prove
   r"(!n. reduced_homology_group(&n,nsphere n) isomorphic_group integer_group) /\
   (!n p. ~(p = &n) ==> trivial_group(reduced_homology_group(p,nsphere n)))"
   (ONCE_REWRITE_TAC [← MESON []
     (← q r"(!n. P (&n:int) n) /\ (!n p. ~(p = &n) ==> Q p n) <=>
      !n p. (p = &n ==> P p n) /\ (~(p = &n) ==> Q p n)")] THEN
    MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"p:int") THEN
      SUBGOAL_THEN
       (← q r"subtopology (product_topology (:num) (\i. euclideanreal))
                    {(\i. if i = 1 then &1 else &0),
                     (\i. if i = 1 then -- &1 else &0)} =
        nsphere 0")
      ASSUME_TAC THENL
       [REWRITE_TAC [NSPHERE, ADD_CLAUSES, NUMSEG_SING, SUM_SING, IN_SING] THEN
        AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_INSERT, NOT_IN_EMPTY] THEN
        X_GEN_TAC (← q r"x:num->real") THEN REWRITE_TAC [FUN_EQ_THM, IN_ELIM_THM] THEN
        REWRITE_TAC [← REAL_RING (← q r"x pow 2 = &1 <=> x = &1 \/ x = -- &1")] THEN
        MESON_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"p:int", ← q r"product_topology (:num) (\i. euclideanreal)",
        ← q r"(\i. if i = 1 then &1 else &0):num->real",
        ← q r"(\i. if i = 1 then -- &1 else &0):num->real"]
        REDUCED_HOMOLOGY_GROUP_PAIR) THEN
      REWRITE_TAC [T1_SPACE_PRODUCT_TOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY] THEN
      REWRITE_TAC [T1_SPACE_EUCLIDEANREAL, o_DEF, TOPSPACE_EUCLIDEANREAL] THEN
      ASM_REWRITE_TAC [CARTESIAN_PRODUCT_UNIV, IN_UNIV] THEN ANTS_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM] THEN DISCH_THEN (MP_TAC o SPEC (← q r"1")) THEN
        REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV,
        ALL_TAC] THEN
      ABBREV_TAC (← q r"a:num->real = \i. if i = 1 then &1 else &0") THEN
      ASM_CASES_TAC (← q r"p:int = &0") THEN ASM_REWRITE_TAC [] THENL
       [MP_TAC (← ISPECL
         [← q r"subtopology (product_topology (:num) (\i. euclideanreal)) {a}",
          ← q r"a:num->real"] HOMOLOGY_COEFFICIENTS),
        MP_TAC (← ISPECL
         [← q r"p:int",
          ← q r"subtopology (product_topology (:num) (\i. euclideanreal)) {a}",
          ← q r"a:num->real"] HOMOLOGY_DIMENSION_AXIOM)] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY, o_DEF] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV] THEN
      ASM_REWRITE_TAC [INTER_UNIV, ← GSYM IMP_CONJ_ALT] THEN
      REWRITE_TAC [ISOMORPHIC_GROUP_TRANS, IMP_CONJ] THEN
      DISCH_THEN (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_TRIVIALITY) THEN
      REWRITE_TAC [],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"p:int") THEN
    REWRITE_TAC [← GSYM INT_OF_NUM_SUC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p - &1:int")) THEN
    SUBST1_TAC (← INT_ARITH (← q r"p:int = (p - &1) + &1")) THEN
    REWRITE_TAC [INT_EQ_ADD_RCANCEL, ← INT_ARITH (← q r"(x + &1) - &1:int = x")] THEN
    SPEC_TAC (← q r"p - &1:int", ← q r"p:int") THEN X_GEN_TAC (← q r"p:int") THEN
    REWRITE_TAC [ADD1] THEN
    SUBGOAL_THEN
     (← q r"reduced_homology_group (p + &1,nsphere (n + 1))
      isomorphic_group reduced_homology_group (p,nsphere n)")
    MP_TAC THENL
     [ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN
      MESON_TAC [REDUCED_HOMOLOGY_GROUP_NSPHERE_STEP],
      ASM_CASES_TAC (← q r"p:int = &n") THEN
      ASM_REWRITE_TAC [IMP_IMP, ISOMORPHIC_GROUP_TRANS] THEN
      REWRITE_TAC [IMP_CONJ] THEN
      DISCH_THEN (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_TRIVIALITY) THEN
      REWRITE_TAC []])

  let CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE ← prove
   r"!p n. cyclic_group(reduced_homology_group(p,nsphere n))"
   (ASM_MESON_TAC [REDUCED_HOMOLOGY_GROUP_NSPHERE,
                   TRIVIAL_IMP_CYCLIC_GROUP, ISOMORPHIC_GROUP_CYCLICITY,
                   CYCLIC_INTEGER_GROUP])

  let TRIVIAL_REDUCED_HOMOLOGY_GROUP_NSPHERE ← prove
   r"!p n. trivial_group(reduced_homology_group (p,nsphere n)) <=> ~(p = &n)"
   (MESON_TAC [NON_TRIVIAL_INTEGER_GROUP, REDUCED_HOMOLOGY_GROUP_NSPHERE,
               ISOMORPHIC_GROUP_TRIVIALITY])

  let NON_CONTRACTIBLE_SPACE_NSPHERE ← prove
   r"!n. ~(contractible_space(nsphere n))"
   (REWRITE_TAC [CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY] THEN
    GEN_TAC THEN REWRITE_TAC [NONEMPTY_NSPHERE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:num->real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_TRIVIALITY o
      SPEC (← q r"&n:int") o MATCH_MP
      HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_REDUCED_HOMOLOGY_GROUPS) THEN
    REWRITE_TAC [TRIVIAL_REDUCED_HOMOLOGY_GROUP_NSPHERE] THEN
    MATCH_MP_TAC HOMOLOGY_DIMENSION_REDUCED THEN EXISTS_TAC (← q r"a:num->real") THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [])

  return { REDUCED_HOMOLOGY_GROUP_NSPHERE_STEP, REDUCED_HOMOLOGY_GROUP_NSPHERE,
           CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE, TRIVIAL_REDUCED_HOMOLOGY_GROUP_NSPHERE,
           NON_CONTRACTIBLE_SPACE_NSPHERE }

/- ------------------------------------------------------------------------- -/
/- Brouwer degree of a map f:S^n->S^n.  (homology.ml 8341-8547)              -/
/- ------------------------------------------------------------------------- -/

structure HBR where
  brouwer_degree2 : thm
  BROUWER_DEGREE2_EQ : thm
  BROUWER_DEGREE2 : thm
  BROUWER_DEGREE2_IFF : thm
  BROUWER_DEGREE2_UNIQUE : thm
  BROUWER_DEGREE2_UNIQUE_GENERATOR : thm
  BROUWER_DEGREE2_HOMOTOPIC : thm
  BROUWER_DEGREE2_ID : thm
  BROUWER_DEGREE2_COMPOSE : thm
  BROUWER_DEGREE2_HOMOTOPY_EQUIVALENCE : thm
  BROUWER_DEGREE2_HOMEOMORPHIC_MAPS : thm
  BROUWER_DEGREE2_RETRACTION_MAP : thm
  BROUWER_DEGREE2_SECTION_MAP : thm
  BROUWER_DEGREE2_HOMEOMORPHIC_MAP : thm
  deriving Inhabited

@[nospecialize]
def setupHBR [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) (BHBP : HBP)
    (BHRD : HRD) (BHNS : HNS) : ExceptT String IO HBR := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, INT_ARITH_TAC, INTEGER_RULE, SET_RULE, SET_TAC,
        SELECT_CONV, .. } := D
  let { EMPTY_SUBSET, EQ_IMP, FORALL_IN_GSPEC, IMAGE_CLAUSES, IMP_CONJ, IMP_IMP, .. } := D.core1
  let { INT_MUL_EQ_1, INT_MUL_LID, INT_MUL_SYM, INT_OF_NUM_EQ, IN_ELIM_THM, IN_UNIV, I_DEF, I_THM,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, .. } := D.core3
  let { RIGHT_IMP_FORALL_THM, SUBSET, o_THM, .. } := D.core4
  let { CARRIER_SUBGROUP_GENERATED_BY_SING, GROUP_HOMOMORPHISM_ZPOW, .. } := D.grp1
  let { GROUP_ZPOW, GROUP_ZPOW_1, GROUP_ZPOW_EQ_ALT, GROUP_ZPOW_EQ_ID, GROUP_ZPOW_MUL,
        GROUP_ZPOW_POW, INFINITE_CYCLIC_SUBGROUP_ORDER, INFINITE_INTEGER_GROUP,
        ISOMORPHIC_GROUP_INFINITENESS, SUBGROUP_GENERATED, TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ,
        cyclic_group, group_pow, .. } := D.grp2
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_ID, .. } := D.met1
  let { HOMOTOPIC_WITH_EQUAL, HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS, .. } := D.met2
  let { SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP, homeomorphic_maps, retraction_map,
        retraction_maps, section_map, .. } := D.met3
  let { homology_group, .. } := BHGP
  let { HOM_INDUCED_DEFAULT, .. } := BHIN
  let { HOM_INDUCED_COMPOSE, HOM_INDUCED_EQ, HOM_INDUCED_ID, .. } := BHIF
  let { HOMOLOGY_HOMOTOPY_EMPTY, .. } := BHBP
  let { GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP_SUBSET, GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED,
        HOM_INDUCED_REDUCED, reduced_homology_group, .. } := BHRD
  let { CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE, REDUCED_HOMOLOGY_GROUP_NSPHERE,
        TRIVIAL_REDUCED_HOMOLOGY_GROUP_NSPHERE, .. } := BHNS
  -- @@SCOPE END

  let brouwer_degree2 ← new_definition
   r"brouwer_degree2 p f =
    @d. !x. x IN group_carrier(reduced_homology_group(&p,nsphere p))
            ==> hom_induced (&p) (nsphere p,{}) (nsphere p,{}) f x =
                group_zpow (reduced_homology_group (&p,nsphere p)) x d"

  let BROUWER_DEGREE2_EQ ← prove
   r"!p f g.
    (!x. x IN topspace(nsphere p) ==> f x = g x)
    ==> brouwer_degree2 p f = brouwer_degree2 p g"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (ASSUME_TAC o MATCH_MP HOM_INDUCED_EQ) THEN
    ASM_REWRITE_TAC [brouwer_degree2])

  let BROUWER_DEGREE2 ← prove
   r"!p f x. x IN group_carrier(reduced_homology_group(&p,nsphere p))
            ==> hom_induced (&p) (nsphere p,{}) (nsphere p,{}) f x =
                group_zpow (reduced_homology_group (&p,nsphere p))
                           x (brouwer_degree2 p f)"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [brouwer_degree2] THEN
    CONV_TAC SELECT_CONV THEN
    ASM_CASES_TAC (← q r"continuous_map(nsphere p,nsphere p) f") THENL
     [ALL_TAC,
      EXISTS_TAC (← q r"&0:int") THEN
      ASM_SIMP_TAC [HOM_INDUCED_DEFAULT, GROUP_ZPOW_POW, group_pow] THEN
      SIMP_TAC [reduced_homology_group, SUBGROUP_GENERATED, homology_group]] THEN
    MP_TAC (← ISPECL [← q r"&p:int", ← q r"p:num"] CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE) THEN
    REWRITE_TAC [cyclic_group, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:((num->real)->num->real)frag->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CARRIER_SUBGROUP_GENERATED_BY_SING) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (ASSUME_TAC o SYM) THEN
    FIRST_ASSUM (MP_TAC o SPEC
     (← q r"hom_induced (&p) (nsphere p,{}) (nsphere p,{}) f a") o
      MATCH_MP (← SET_RULE (← q r"s = t ==> !x. x IN t ==> x IN s"))) THEN
    ASM_SIMP_TAC [HOM_INDUCED_REDUCED, IN_ELIM_THM, IN_UNIV] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:int") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV o RAND_CONV) [← GSYM th])) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN X_GEN_TAC (← q r"n:int") THEN
    ASM_SIMP_TAC [← GSYM GROUP_ZPOW_MUL] THEN ONCE_REWRITE_TAC [INT_MUL_SYM] THEN
    ASM_SIMP_TAC [GROUP_ZPOW_MUL] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← SYM th])) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
          GROUP_HOMOMORPHISM_ZPOW) THEN
    ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED])

  let BROUWER_DEGREE2_IFF ← prove
   r"!p f x d.
        continuous_map (nsphere p,nsphere p) f /\
        x IN group_carrier(reduced_homology_group(&p,nsphere p))
        ==> (hom_induced (&p) (nsphere p,{}) (nsphere p,{}) f x =
             group_zpow (reduced_homology_group (&p,nsphere p)) x d <=>
             x = group_id(reduced_homology_group(&p,nsphere p)) \/
             brouwer_degree2 p f = d)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"&p:int", ← q r"p:num"]
     CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE) THEN
    REWRITE_TAC [cyclic_group, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:((num->real)->num->real)frag->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC
      (BINDER_CONV o LAND_CONV o funpow 2 RAND_CONV) [← GSYM th])) THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_BY_SING, FORALL_IN_GSPEC,
                  BROUWER_DEGREE2, GROUP_ZPOW] THEN
    ASM_SIMP_TAC [IN_UNIV, ← GSYM GROUP_ZPOW_MUL, GROUP_ZPOW_EQ_ALT] THEN
    REPEAT GEN_TAC THEN ASM_SIMP_TAC [GROUP_ZPOW_EQ_ID] THEN
    MATCH_MP_TAC (← INTEGER_RULE
     (← q r"d:int = &0 ==> (d divides n * a - n * b <=> d divides n \/ b = a)")) THEN
    ASM_SIMP_TAC [INT_OF_NUM_EQ, ← GSYM INFINITE_CYCLIC_SUBGROUP_ORDER] THEN
    MP_TAC INFINITE_INTEGER_GROUP THEN MATCH_MP_TAC EQ_IMP THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC ISOMORPHIC_GROUP_INFINITENESS THEN
    REWRITE_TAC [REDUCED_HOMOLOGY_GROUP_NSPHERE])

  let BROUWER_DEGREE2_UNIQUE ← prove
   r"!p f d. continuous_map (nsphere p,nsphere p) f /\
           (!x. x IN group_carrier(reduced_homology_group(&p,nsphere p))
                ==> hom_induced (&p) (nsphere p,{}) (nsphere p,{}) f x =
                    group_zpow (reduced_homology_group (&p,nsphere p)) x d)
           ==> brouwer_degree2 p f = d"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"&p:int", ← q r"p:num"] CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE) THEN
    REWRITE_TAC [cyclic_group, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:((num->real)->num->real)frag->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:((num->real)->num->real)frag->bool")) THEN
    ASM_SIMP_TAC [BROUWER_DEGREE2, GROUP_ZPOW_EQ_ALT] THEN
    MATCH_MP_TAC (← INTEGER_RULE (← q r"d:int = &0 ==> d divides b - a ==> a = b")) THEN
    ASM_SIMP_TAC [INT_OF_NUM_EQ, ← GSYM INFINITE_CYCLIC_SUBGROUP_ORDER] THEN
    MP_TAC INFINITE_INTEGER_GROUP THEN MATCH_MP_TAC EQ_IMP THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC ISOMORPHIC_GROUP_INFINITENESS THEN
    REWRITE_TAC [REDUCED_HOMOLOGY_GROUP_NSPHERE])

  let BROUWER_DEGREE2_UNIQUE_GENERATOR ← prove
   r"!p f d a.
        continuous_map (nsphere p,nsphere p) f /\
        subgroup_generated (reduced_homology_group (&p,nsphere p)) {a} =
        reduced_homology_group (&p,nsphere p) /\
        hom_induced (&p) (nsphere p,{}) (nsphere p,{}) f a =
        group_zpow (reduced_homology_group (&p,nsphere p)) a d
        ==> brouwer_degree2 p f = d"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_CASES_TAC
     (← q r"a IN group_carrier(reduced_homology_group (&p,nsphere p))")
    THENL
     [ASM_SIMP_TAC [BROUWER_DEGREE2, GROUP_ZPOW_EQ_ALT] THEN
      MATCH_MP_TAC (← INTEGER_RULE
       (← q r"d:int = &0 ==> d divides b - a ==> a = b")) THEN
      ASM_SIMP_TAC [INT_OF_NUM_EQ, ← GSYM INFINITE_CYCLIC_SUBGROUP_ORDER] THEN
      MP_TAC INFINITE_INTEGER_GROUP THEN MATCH_MP_TAC EQ_IMP THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC ISOMORPHIC_GROUP_INFINITENESS THEN
      REWRITE_TAC [REDUCED_HOMOLOGY_GROUP_NSPHERE],
      MP_TAC (← SPECL [← q r"&p:int", ← q r"p:num"]
        TRIVIAL_REDUCED_HOMOLOGY_GROUP_NSPHERE) THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [] THEN
      REWRITE_TAC [TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ] THEN
      ASM SET_TAC []])

  let BROUWER_DEGREE2_HOMOTOPIC ← prove
   r"!p f g. homotopic_with (\x. T) (nsphere p,nsphere p) f g
           ==> brouwer_degree2 p f = brouwer_degree2 p g"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o
      MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS) THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      HOMOLOGY_HOMOTOPY_EMPTY)) THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC BROUWER_DEGREE2_UNIQUE THEN
    ASM_SIMP_TAC [← REWRITE_RULE [SUBSET]
      GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP_SUBSET] THEN
    ASM_SIMP_TAC [BROUWER_DEGREE2])

  let BROUWER_DEGREE2_ID ← prove
   r"!p. brouwer_degree2 p (\x. x) = &1"
   (GEN_TAC THEN MATCH_MP_TAC BROUWER_DEGREE2_UNIQUE THEN
    REWRITE_TAC [CONTINUOUS_MAP_ID] THEN
    SIMP_TAC [INT_MUL_LID, HOM_INDUCED_ID, GROUP_ZPOW_1,
      ← REWRITE_RULE [SUBSET, homology_group]
             GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP_SUBSET])

  let BROUWER_DEGREE2_COMPOSE ← prove
   r"!p f g.
        continuous_map (nsphere p,nsphere p) f /\
        continuous_map (nsphere p,nsphere p) g
        ==> brouwer_degree2 p (g o f) =
            brouwer_degree2 p g * brouwer_degree2 p f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BROUWER_DEGREE2_UNIQUE THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE], ALL_TAC] THEN
    ONCE_REWRITE_TAC [INT_MUL_SYM] THEN
    SIMP_TAC [GROUP_ZPOW_MUL, ← GSYM BROUWER_DEGREE2, HOM_INDUCED_REDUCED] THEN
    REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM] THEN
    AP_THM_TAC THEN MATCH_MP_TAC HOM_INDUCED_COMPOSE THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET])

  let BROUWER_DEGREE2_HOMOTOPY_EQUIVALENCE ← prove
   r"!p f g. continuous_map (nsphere p,nsphere p) f /\
           continuous_map (nsphere p,nsphere p) g /\
           homotopic_with (\x. T) (nsphere p,nsphere p) (f o g) I
           ==> abs(brouwer_degree2 p f) = &1 /\
               abs(brouwer_degree2 p g) = &1 /\
               brouwer_degree2 p g = brouwer_degree2 p f"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BROUWER_DEGREE2_HOMOTOPIC) THEN
    ASM_SIMP_TAC [BROUWER_DEGREE2_COMPOSE, I_DEF, BROUWER_DEGREE2_ID] THEN
    REWRITE_TAC [INT_MUL_EQ_1] THEN INT_ARITH_TAC)

  let BROUWER_DEGREE2_HOMEOMORPHIC_MAPS ← prove
   r"!p f g. homeomorphic_maps (nsphere p,nsphere p) (f,g)
           ==> abs(brouwer_degree2 p f) = &1 /\
               abs(brouwer_degree2 p g) = &1 /\
               brouwer_degree2 p g = brouwer_degree2 p f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_maps] THEN STRIP_TAC THEN
    MATCH_MP_TAC BROUWER_DEGREE2_HOMOTOPY_EQUIVALENCE THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMOTOPIC_WITH_EQUAL THEN
    ASM_REWRITE_TAC [o_THM, I_THM] THEN ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE])

  let BROUWER_DEGREE2_RETRACTION_MAP ← prove
   r"!p f. retraction_map(nsphere p,nsphere p) f
         ==> abs(brouwer_degree2 p f) = &1"
   (REPEAT GEN_TAC THEN REWRITE_TAC [retraction_map, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:(num->real)->(num->real)") THEN
    REWRITE_TAC [retraction_maps] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"p:num", ← q r"f:(num->real)->(num->real)", ← q r"g:(num->real)->(num->real)"]
     BROUWER_DEGREE2_HOMOTOPY_EQUIVALENCE) THEN
    ANTS_TAC THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQUAL THEN
    ASM_REWRITE_TAC [o_THM, I_THM] THEN ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE])

  let BROUWER_DEGREE2_SECTION_MAP ← prove
   r"!p f. section_map (nsphere p,nsphere p) f
         ==> abs(brouwer_degree2 p f) = &1"
   (REPEAT GEN_TAC THEN REWRITE_TAC [section_map, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:(num->real)->(num->real)") THEN
    REWRITE_TAC [retraction_maps] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"p:num", ← q r"g:(num->real)->(num->real)", ← q r"f:(num->real)->(num->real)"]
     BROUWER_DEGREE2_HOMOTOPY_EQUIVALENCE) THEN
    ANTS_TAC THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQUAL THEN
    ASM_REWRITE_TAC [o_THM, I_THM] THEN ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE])

  let BROUWER_DEGREE2_HOMEOMORPHIC_MAP ← prove
   r"!p f. homeomorphic_map (nsphere p,nsphere p) f
         ==> abs(brouwer_degree2 p f) = &1"
   (SIMP_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP,
              BROUWER_DEGREE2_SECTION_MAP])

  return { brouwer_degree2, BROUWER_DEGREE2_EQ, BROUWER_DEGREE2, BROUWER_DEGREE2_IFF,
           BROUWER_DEGREE2_UNIQUE, BROUWER_DEGREE2_UNIQUE_GENERATOR, BROUWER_DEGREE2_HOMOTOPIC,
           BROUWER_DEGREE2_ID, BROUWER_DEGREE2_COMPOSE, BROUWER_DEGREE2_HOMOTOPY_EQUIVALENCE,
           BROUWER_DEGREE2_HOMEOMORPHIC_MAPS, BROUWER_DEGREE2_RETRACTION_MAP,
           BROUWER_DEGREE2_SECTION_MAP, BROUWER_DEGREE2_HOMEOMORPHIC_MAP }

/- ------------------------------------------------------------------------- -/
/- Degree of constant maps and of the reflection.  (homology.ml 8548-8821)   -/
/- ------------------------------------------------------------------------- -/

structure HRF where
  BROUWER_DEGREE2_NULLHOMOTOPIC : thm
  BROUWER_DEGREE2_CONST : thm
  BROUWER_DEGREE2_NONSURJECTIVE : thm
  BROUWER_DEGREE2_REFLECTION : thm
  deriving Inhabited

@[nospecialize]
def setupHRF [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) (BHBP : HBP)
    (BHTR : HTR) (BHPR : HPR) (BHRD : HRD) (BHNS : HNS) (BHBR : HBR) :
    ExceptT String IO HRF := do
  -- @@SCOPE BEGIN
  let { INTEGER_RULE, MESON, MESON_TAC, REAL_RING, SET_RULE, SET_TAC, GROUP_RULE,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { ADD1, ADD_CLAUSES, CARTESIAN_PRODUCT_UNIV, CONJ_ASSOC, EMPTY_SUBSET, EQ_IMP, EQ_SYM_EQ,
        ETA_AX, EXISTS_PAIR_THM, FINITE_EMPTY, FINITE_INSERT, FORALL_IN_IMAGE, FUN_EQ_THM,
        IMAGE_CLAUSES, INTER_UNIV, .. } := D.core1
  let { INT_OF_NUM_ADD, INT_OF_NUM_EQ, IN_CROSS, IN_ELIM_THM, IN_INSERT, IN_INTER, IN_SING,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, NUMSEG_SING, .. } := D.core2
  let { REAL_NEG_NEG, .. } := D.core3
  let { SELECT_UNIQUE, SUBSET, SUM_SING, num_INDUCTION, o_DEF, o_THM, .. } := D.core4
  let { GROUP_HOMOMORPHISM, GROUP_HOMOMORPHISM_DIV, GROUP_HOMOMORPHISM_ZPOW, GROUP_INV,
        GROUP_ISOMORPHISM, .. } := D.grp1
  let { GROUP_ISOMORPHISM_IMP_HOMOMORPHISM, GROUP_LINV_EQ, GROUP_MONOMORPHISM_ALT, GROUP_MUL,
        GROUP_POW_1, GROUP_ZPOW_0, GROUP_ZPOW_EQ_ID, GROUP_ZPOW_POW,
        INFINITE_CYCLIC_SUBGROUP_ORDER, INFINITE_INTEGER_GROUP, ISOMORPHIC_GROUP_INFINITENESS,
        PROD_GROUP, SUBGROUP_GENERATED, TRIVIAL_GROUP_SUBSET, cyclic_group, group_div,
        group_epimorphism, group_homomorphism, group_kernel, .. } := D.grp2
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_NSPHERE_REFLECTION,
        CONTRACTIBLE_SPACE_SUBTOPOLOGY_SING, .. } := D.met1
  let { DISCRETE_TOPOLOGY_UNIQUE, FINITE_T1_SPACE_IMP_DISCRETE_TOPOLOGY,
        HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS, HOMOTOPIC_WITH_REFL,
        NULLHOMOTOPIC_NONSURJECTIVE_SPHERE_MAP, NSPHERE, .. } := D.met2
  let { T1_SPACE_EUCLIDEANREAL, T1_SPACE_PRODUCT_TOPOLOGY, T1_SPACE_SUBTOPOLOGY,
        TOPSPACE_DISCRETE_TOPOLOGY, TOPSPACE_EUCLIDEANREAL, TOPSPACE_PRODUCT_TOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, retraction_map, retraction_maps, section_map, .. } := D.met3
  let { homology_group, .. } := BHGP
  let { HOM_INDUCED, HOM_INDUCED_DEFAULT, .. } := BHIN
  let { HOM_INDUCED_COMPOSE, .. } := BHIF
  let { GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY, HOM_INDUCED_COMPOSE_EMPTY, .. } := BHBP
  let { GROUP_EPIMORPHISM_HOM_INDUCED_RETRACTION_MAP,
        GROUP_MONOMORPHISM_HOM_INDUCED_SECTION_MAP, .. } := BHTR
  let { HOMOLOGY_ADDITIVITY_EXPLICIT, .. } := BHPR
  let { GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP, GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED,
        HOM_INDUCED_REDUCED, TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE,
        reduced_homology_group, .. } := BHRD
  let { CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE, REDUCED_HOMOLOGY_GROUP_NSPHERE,
        REDUCED_HOMOLOGY_GROUP_NSPHERE_STEP, .. } := BHNS
  let { BROUWER_DEGREE2, BROUWER_DEGREE2_HOMOTOPIC, BROUWER_DEGREE2_UNIQUE,
        brouwer_degree2, .. } := BHBR
  -- @@SCOPE END

  let BROUWER_DEGREE2_NULLHOMOTOPIC ← prove
   r"!p f a. homotopic_with (\x. T) (nsphere p,nsphere p) f (\x. a)
           ==> brouwer_degree2 p f = &0"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP BROUWER_DEGREE2_HOMOTOPIC) THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o
      MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS) THEN
    MATCH_MP_TAC BROUWER_DEGREE2_UNIQUE THEN
    ASM_REWRITE_TAC [GROUP_ZPOW_0] THEN
    X_GEN_TAC (← q r"c:((num->real)->num->real)frag->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"hom_induced (&p) (nsphere p,{}) (nsphere p,{}) (\x. a) =
      hom_induced (&p) (subtopology (nsphere p) {a},{})
                       (nsphere p,{}) (\x. x) o
      hom_induced (&p) (nsphere p,{})
                       (subtopology (nsphere p) {a},{}) (\x. a)")
    SUBST1_TAC THENL
     [W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
        rand o snd) THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET,
                       ← SET_RULE (← q r"IMAGE (\x. a) s SUBSET {a}"),
                       CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [o_DEF],
      REWRITE_TAC [o_THM] THEN MATCH_MP_TAC
       (← MESON [← REWRITE_RULE [group_homomorphism]
              GROUP_HOMOMORPHISM_HOM_INDUCED_REDUCED]
        (← q r"a = group_id(reduced_homology_group(p,top))
         ==> hom_induced p (top,{}) (top',{}) f a =
             group_id(reduced_homology_group(p,top'))")) THEN
      MP_TAC (← ISPECL [← q r"&p:int", ← q r"subtopology (nsphere p) {a}"]
        TRIVIAL_REDUCED_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE) THEN
      SIMP_TAC [CONTRACTIBLE_SPACE_SUBTOPOLOGY_SING, TRIVIAL_GROUP_SUBSET] THEN
      REWRITE_TAC [SUBSET, IN_SING] THEN DISCH_THEN MATCH_MP_TAC THEN
      MATCH_MP_TAC HOM_INDUCED_REDUCED THEN ASM_REWRITE_TAC []])

  let BROUWER_DEGREE2_CONST ← prove
   r"!p a. brouwer_degree2 p (\x. a) = &0"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"continuous_map(nsphere p,nsphere p) (\x. a)") THENL
     [MATCH_MP_TAC BROUWER_DEGREE2_NULLHOMOTOPIC THEN
      EXISTS_TAC (← q r"a:num->real") THEN ASM_REWRITE_TAC [HOMOTOPIC_WITH_REFL],
      ALL_TAC] THEN
    ASM_SIMP_TAC [brouwer_degree2, HOM_INDUCED_DEFAULT] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
    SUBGOAL_THEN (← q r"group_id(relative_homology_group(&p,nsphere p,{})) =
                  group_id(reduced_homology_group(&p,nsphere p))")
    SUBST1_TAC THENL
     [REWRITE_TAC [reduced_homology_group, ← GSYM homology_group] THEN
      REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED],
      SIMP_TAC [GROUP_ZPOW_EQ_ID]] THEN
    MATCH_MP_TAC SELECT_UNIQUE THEN X_GEN_TAC (← q r"d:int") THEN EQ_TAC THEN
    SIMP_TAC [← INTEGER_RULE (← q r"!x:int. x divides &0")] THEN
    MP_TAC (← ISPECL [← q r"&p:int", ← q r"p:num"]
     CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE) THEN
    REWRITE_TAC [cyclic_group, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:((num->real)->num->real)frag->bool") THEN
    STRIP_TAC THEN DISCH_THEN (MP_TAC o SPEC
     (← q r"c:((num->real)->num->real)frag->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← INTEGER_RULE
     (← q r"c = &0 ==> c divides d ==> d = &0")) THEN
    ASM_SIMP_TAC [INT_OF_NUM_EQ, ← GSYM INFINITE_CYCLIC_SUBGROUP_ORDER] THEN
    MP_TAC INFINITE_INTEGER_GROUP THEN MATCH_MP_TAC EQ_IMP THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC ISOMORPHIC_GROUP_INFINITENESS THEN
    REWRITE_TAC [REDUCED_HOMOLOGY_GROUP_NSPHERE])

  let BROUWER_DEGREE2_NONSURJECTIVE ← prove
   r"!p f. continuous_map(nsphere p,nsphere p) f /\
         ~(IMAGE f (topspace(nsphere p)) = topspace(nsphere p))
         ==> brouwer_degree2 p f = &0"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC BROUWER_DEGREE2_NULLHOMOTOPIC THEN
    MATCH_MP_TAC NULLHOMOTOPIC_NONSURJECTIVE_SPHERE_MAP THEN
    ASM_REWRITE_TAC [])

  let BROUWER_DEGREE2_REFLECTION ← prove
   r"!p. brouwer_degree2 p (\x i. if i = 1 then --x i else x i) = -- &1"
   (ABBREV_TAC (← q r"r = \(x:num->real) i. if i = 1 then --x i else x i") THEN
    MP_TAC (← GEN (← q r"p:num") (← SPECL [← q r"p:num", ← q r"1"]
      CONTINUOUS_MAP_NSPHERE_REFLECTION)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"p:num") THEN DISCH_TAC THEN
      MATCH_MP_TAC BROUWER_DEGREE2_UNIQUE THEN
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"&p:int", ← q r"p:num"]
        REDUCED_HOMOLOGY_GROUP_NSPHERE_STEP) THEN
      ASM_REWRITE_TAC [ADD1, ← GSYM INT_OF_NUM_ADD] THEN STRIP_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SYM (← liftExcept (el 1 (CONJUNCTS
          (← GEN_REWRITE_RULE id [GROUP_ISOMORPHISM] th))))))) THEN
      REWRITE_TAC [ADD1, ← GSYM INT_OF_NUM_ADD] THEN DISCH_THEN SUBST1_TAC THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE, BROUWER_DEGREE2] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_ZPOW o
            MATCH_MP GROUP_ISOMORPHISM_IMP_HOMOMORPHISM) THEN
      SIMP_TAC []] THEN
    SUBGOAL_THEN (← q r"!c. c IN group_carrier(reduced_homology_group(&0,nsphere 0))
                      ==> hom_induced (&0) (nsphere 0,{}) (nsphere 0,{}) r c =
                          group_inv (homology_group(&0,nsphere 0)) c")
    ASSUME_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC BROUWER_DEGREE2_UNIQUE THEN ASM_SIMP_TAC [] THEN
      SIMP_TAC [GROUP_ZPOW_POW, GROUP_POW_1] THEN
      REWRITE_TAC [reduced_homology_group, ← CONJUNCT2 SUBGROUP_GENERATED]] THEN
    X_GEN_TAC (← q r"c:((num->real)->num->real)frag->bool") THEN
    REWRITE_TAC [GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP] THEN
    REWRITE_TAC [group_kernel, IN_ELIM_THM] THEN STRIP_TAC THEN
    MAP_EVERY ABBREV_TAC
     [← q r"p:num->real = \i. if i = 1 then &1 else &0",
      ← q r"n:num->real = \i. if i = 1 then -- &1 else &0"] THEN
    SUBGOAL_THEN (← q r"topspace(nsphere 0) = {p,n}") ASSUME_TAC THENL
     [REWRITE_TAC [NSPHERE] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY, o_DEF] THEN
      SIMP_TAC [TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV, INTER_UNIV] THEN
      REWRITE_TAC [ADD_CLAUSES, NUMSEG_SING, SUM_SING, IN_SING] THEN
      MAP_EVERY EXPAND_TAC ["p", "n"] THEN
      REWRITE_TAC [← SET_RULE (← q r"s = {a,b} <=> !x. x IN s <=> x = a \/ x = b")] THEN
      REWRITE_TAC [← REAL_RING (← q r"(x:real) pow 2 = &1 <=> x = &1 \/ x = -- &1")] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN REWRITE_TAC [FUN_EQ_THM] THEN MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(p:num->real = n)") ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["p", "n"] THEN REWRITE_TAC [FUN_EQ_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"1")) THEN REWRITE_TAC [] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"r(p:num->real) = n /\ r n = p") STRIP_ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["r", "n", "p"] THEN SIMP_TAC [REAL_NEG_NEG],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!x:num->real. r(r x) = x") ASSUME_TAC THENL
     [EXPAND_TAC "r" THEN SIMP_TAC [FUN_EQ_THM, REAL_NEG_NEG] THEN MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?d. d IN group_carrier(homology_group(&0,subtopology (nsphere 0) {p})) /\
          group_div (homology_group (&0,nsphere 0))
                    (hom_induced (&0) (subtopology (nsphere 0) {p},{})
                                      (nsphere 0,{}) (\x. x) d)
                    (hom_induced (&0) (subtopology (nsphere 0) {p},{})
                                      (nsphere 0,{}) r d) = c")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"&0:int", ← q r"nsphere 0", ← q r"{p:num->real}",
                       ← q r"{n:num->real}"]
            HOMOLOGY_ADDITIVITY_EXPLICIT) THEN
      ANTS_TAC THENL
       [ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        MP_TAC ((← EQ_IMP_RULE (← ISPECL [← q r"nsphere 0", ← q r"{p:num->real,n}"]
            DISCRETE_TOPOLOGY_UNIQUE)).1) THEN
        ANTS_TAC THENL [ALL_TAC, SIMP_TAC [IN_INSERT]] THEN
        CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC FINITE_T1_SPACE_IMP_DISCRETE_TOPOLOGY THEN
        ASM_REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY] THEN
        REWRITE_TAC [NSPHERE] THEN MATCH_MP_TAC T1_SPACE_SUBTOPOLOGY THEN
        REWRITE_TAC [T1_SPACE_PRODUCT_TOPOLOGY, T1_SPACE_EUCLIDEANREAL],
        REWRITE_TAC [GROUP_ISOMORPHISM] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
         (← q r"P /\ IMAGE f s = t /\ Q
          ==> !y. y IN t ==> ?x. x IN s /\ f x = y")))] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"c:((num->real)->num->real)frag->bool")) THEN
      ASM_REWRITE_TAC [PROD_GROUP, EXISTS_PAIR_THM, IN_CROSS] THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"d:((num->real)->num->real)frag->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d':((num->real)->num->real)frag->bool")
          STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [group_div] THEN EXPAND_TAC "c" THEN AP_TERM_TAC THEN
      SUBGOAL_THEN
       (← q r"group_epimorphism(homology_group(&0,subtopology (nsphere 0) {p}),
                          homology_group(&0,subtopology (nsphere 0) {n}))
          (hom_induced (&0) (subtopology (nsphere 0) {p},{})
                            (subtopology (nsphere 0) {n},{}) r)")
      MP_TAC THENL
       [MATCH_MP_TAC GROUP_EPIMORPHISM_HOM_INDUCED_RETRACTION_MAP THEN
        REWRITE_TAC [retraction_map] THEN
        EXISTS_TAC (← q r"r:(num->real)->num->real") THEN
        REWRITE_TAC [retraction_maps, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [],
        REWRITE_TAC [group_epimorphism] THEN DISCH_THEN (MP_TAC o MATCH_MP
         (← SET_RULE (← q r"P /\ IMAGE f s = t
                    ==> !y. y IN t ==> ?x. x IN s /\ f x = y")))] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"d':((num->real)->num->real)frag->bool")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_THEN
       (← q r"e:((num->real)->num->real)frag->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"group_monomorphism(homology_group(&0,subtopology (nsphere 0) {p}),
                           homology_group(&0,discrete_topology {one}))
          (hom_induced (&0) (subtopology (nsphere 0) {p},{})
                            (discrete_topology {one},{}) (\x. one))")
      MP_TAC THENL
       [MATCH_MP_TAC GROUP_MONOMORPHISM_HOM_INDUCED_SECTION_MAP THEN
        REWRITE_TAC [section_map, retraction_maps] THEN
        EXISTS_TAC (← q r"(\w. p):1->num->real") THEN
        SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_SING] THEN
        REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_SUBTOPOLOGY] THEN
        REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, IN_SING] THEN ASM SET_TAC [],
        REWRITE_TAC [GROUP_MONOMORPHISM_ALT]] THEN
      DISCH_THEN (MP_TAC o SPEC
       (← q r"group_mul (homology_group (&0,subtopology (nsphere 0) {p})) d e") o
       CONJUNCT2) THEN
      ASM_SIMP_TAC [GROUP_MUL, ← GSYM GROUP_LINV_EQ] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
        W (MP_TAC o PART_MATCH rand
          GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY o rator o lhand o snd) THEN
        SIMP_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_DISCRETE_TOPOLOGY, IN_SING] THEN
        ASM_SIMP_TAC [group_homomorphism] THEN DISCH_THEN (K ALL_TAC) THEN
        EXPAND_TAC "c" THEN
        W (MP_TAC o PART_MATCH rand
          GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY o rator o rand o snd) THEN
        SIMP_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_DISCRETE_TOPOLOGY, IN_SING] THEN
        REWRITE_TAC [group_homomorphism] THEN DISCH_THEN (fun th => tactic_of do
          pure (W (MP_TAC o PART_MATCH (lhand o rand)
            (← liftExcept (last (CONJUNCTS th))) o rand o snd))) THEN
        ANTS_TAC THENL
         [CONJ_TAC THEN
          W (MP_TAC o PART_MATCH rand GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY
            o rator o lhand o snd) THEN
          SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
          REWRITE_TAC [GROUP_HOMOMORPHISM, SUBSET, FORALL_IN_IMAGE] THEN
          DISCH_THEN (MATCH_MP_TAC o CONJUNCT1) THEN ASM_REWRITE_TAC [],
          DISCH_THEN SUBST1_TAC] THEN
        BINOP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM] THEN
        W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE_EMPTY o
          rator o rand o snd) THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, IN_SING,
                      CONTINUOUS_MAP_CONST, TOPSPACE_DISCRETE_TOPOLOGY] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [o_DEF] THEN
        EXPAND_TAC "d'" THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM] THEN
        AP_THM_TAC THEN
        W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE_EMPTY o
          rand o snd) THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_CONST,
                      CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
        SIMP_TAC [TOPSPACE_DISCRETE_TOPOLOGY, IN_SING, SUBSET, FORALL_IN_IMAGE,
                  TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
        ASM_REWRITE_TAC [],
        DISCH_THEN (SUBST_ALL_TAC o SYM)] THEN
      REWRITE_TAC [o_DEF] THEN EXPAND_TAC "d'" THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM] THEN
      W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE_EMPTY o
        rator o rand o snd) THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_ID,
                    GROUP_INV, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      W (MP_TAC o PART_MATCH rand
          GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY o rator o rand o snd) THEN
      ASM_SIMP_TAC [ETA_AX, o_DEF, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [group_homomorphism],
      EXPAND_TAC "c" THEN W (MP_TAC o PART_MATCH (lhand o rand)
          (← GROUP_RULE (← q r"group_inv G (group_div G x y) = group_div G y x")) o
          rand o snd) THEN
      ANTS_TAC THENL
       [CONJ_TAC THEN
        W (MP_TAC o PART_MATCH rand GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY
           o rator o lhand o snd) THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
        ASM_SIMP_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE],
        DISCH_THEN SUBST1_TAC] THEN
      W (MP_TAC o PART_MATCH rand
          GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY o rator o lhand o snd) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_DIV) THEN
      EXPAND_TAC "c" THEN DISCH_THEN (fun th =>
        W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o snd)) THEN
      REWRITE_TAC [HOM_INDUCED, homology_group] THEN
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [← GSYM homology_group] THEN
      BINOP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN AP_THM_TAC THEN
      W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE_EMPTY o
        lhand o snd) THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_REWRITE_TAC [o_DEF, ETA_AX]])

  return { BROUWER_DEGREE2_NULLHOMOTOPIC, BROUWER_DEGREE2_CONST, BROUWER_DEGREE2_NONSURJECTIVE,
           BROUWER_DEGREE2_REFLECTION }

/- ------------------------------------------------------------------------- -/
/- Degree invariance mod 2 for map between pairs (S^n,S^{n-1})               -/
/- (homology.ml 8822-9441)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HBO where
  BORSUK_ODD_MAPPING_DEGREE_STEP : thm
  deriving Inhabited

@[nospecialize]
def setupHBO [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHBD : HBD) (BHIN : HIN) (BHIF : HIF)
    (BHT3 : HT3) (BHRD : HRD) (BHRX : HRX) (BHSP : HSP) (BHHM : HHM) (BHNS : HNS)
    (BHBR : HBR) : ExceptT String IO HBO := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, INT_ARITH, INTEGER_RULE, MESON, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, GROUP_RULE, NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV,
        GEN_SIMPLIFY_CONV, TOP_DEPTH_SQCONV, basic_ss, .. } := D
  let { CARTESIAN_PRODUCT_UNIV, COND_ID, COND_RAND, COND_RATOR, CONJ_ASSOC, EMPTY_SUBSET, EQ_IMP,
