        SUBGOAL_THEN
         (← q r"topspace(euclidean_space(n + 1)) INTER {x | x(n+1) = &0} =
          topspace(euclidean_space n)")
        ASSUME_TAC THENL
         [REWRITE_TAC [TOPSPACE_EUCLIDEAN_SPACE, IN_NUMSEG] THEN
