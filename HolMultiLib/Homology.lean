        REWRITE_TAC [SUBSET, IN, EXTENSIONAL_UNIV] THEN GEN_TAC THEN
        MATCH_MP_TAC CONTINUOUS_MAP_PRODUCT_PROJECTION THEN
        REWRITE_TAC [IN_UNIV]],
