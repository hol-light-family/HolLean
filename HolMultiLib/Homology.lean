          EXISTS_TAC (← q r"(\i. if i = n + 1 then &1 else &0):num->real") THEN
          REWRITE_TAC [IN_NUMSEG] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
          GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN ARITH_TAC,
          REPEAT STRIP_TAC THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < a /\ &0 <= b ==> &0 < a + b")) THEN
          ASM_SIMP_TAC [REAL_LE_MUL_EQ, REAL_LT_MUL_EQ, REAL_SUB_LT]]])

  return { INVARIANCE_OF_DIMENSION_CLOSED_IN_EUCLIDEAN_SPACE }

/- ------------------------------------------------------------------------- -/
/- Jordan-Brouwer consequences, invariance of dimension.                     -/
/- (homology.ml 10436-10553)                                                 -/
/- ------------------------------------------------------------------------- -/

structure HJB where
  ISOMORPHIC_HOMOLOGY_GROUPS_EUCLIDEAN_COMPLEMENTS : thm
  CARD_EQ_PATH_COMPONENTS_EUCLIDEAN_COMPLEMENTS : thm
  PATH_CONNECTED_IN_EUCLIDEAN_COMPLEMENTS : thm
  CARD_EQ_CONNECTED_COMPONENTS_EUCLIDEAN_COMPLEMENTS : thm
  CONNECTED_IN_EUCLIDEAN_COMPLEMENTS : thm
  INVARIANCE_OF_DIMENSION_EUCLIDEAN_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupHJB [HolBase] (D : HomologyDeps) (BHBP : HBP) (BHCT : HCT) (BHCM : HCM) (BHID : HID) :
    ExceptT String IO HJB := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, SET_RULE, .. } := D
  let { EQ_IMP, EQ_SYM_EQ, IMP_CONJ, .. } := D.core1
  let { LT_IMP_LE, LT_IMP_NE, .. } := D.core2
  let { RIGHT_IMP_FORALL_THM, SUBSET_ANTISYM_EQ, SUBSET_DIFF, WLOG_LT, .. } := D.core4
  let { CARD_EQ_REFL, CARD_LE_CONG, CARD_LE_SING, .. } := D.lib
  let { CLOSED_IN_EUCLIDEAN_SPACE, CLOSED_IN_SUBSET, CLOSED_IN_SUBSET_TOPSPACE,
        CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING, CONTRACTIBLE_EUCLIDEAN_SPACE, .. } := D.met1
  let { HOMEOMORPHIC_SPACE_REFL, HOMEOMORPHIC_SPACE_SYM, HOMEOMORPHIC_SPACE_TRANS,
        LOCALLY_PATH_CONNECTED_EUCLIDEAN_SPACE, LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET,
        OPEN_IN_DIFF, OPEN_IN_TOPSPACE, .. } := D.met2
  let { PATH_COMPONENTS_EQ_CONNECTED_COMPONENTS_OF, SUBSET_EUCLIDEAN_SPACE,
        SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_EUCLIDEAN_SPACE, connected_in, euclidean_space,
        path_connected_in, .. } := D.met3
  let { ISOMORPHIC_HOMOLOGY_IMP_PATH_COMPONENTS, ISOMORPHIC_HOMOLOGY_IMP_PATH_CONNECTEDNESS, .. } :=
    BHBP
  let { ISOMORPHIC_RELATIVE_CONTRACTIBLE_SPACE_IMP_HOMOLOGY_GROUPS, .. } := BHCT
  let { ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_EUCLIDEAN_COMPLEMENTS, .. } := BHCM
  let { INVARIANCE_OF_DIMENSION_CLOSED_IN_EUCLIDEAN_SPACE, .. } := BHID
  -- @@SCOPE END

  let ISOMORPHIC_HOMOLOGY_GROUPS_EUCLIDEAN_COMPLEMENTS ← prove
