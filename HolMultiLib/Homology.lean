    ASSUME_TAC THENL
     [EXPAND_TAC "b" THEN REWRITE_TAC [HOM_BOUNDARY], ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"p:int", ← q r"top:A topology", ← q r"t:A->bool", ← q r"top:A topology",
      ← q r"s:A->bool", ← q r"\x:A. x"] NATURALITY_HOM_INDUCED) THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_ID, IMAGE_ID] THEN
    DISCH_THEN (MP_TAC o C AP_THM (← q r"x:((num->real)->A)frag->bool")) THEN
    ASM_REWRITE_TAC [o_THM, ← REWRITE_RULE [group_homomorphism]
