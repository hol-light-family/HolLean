    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{i,j | i IN 0..q /\ j IN 0..q + 1} =
      {i,j | i IN 0..q /\ j IN {j | j IN 0..q + 1 /\ j <= i}} UNION
