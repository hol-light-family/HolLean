@[nospecialize]
def setupHID [HolBase] (D : HomologyDeps) (BHBP : HBP) (BHCT : HCT) (BHCM : HCM) :
    ExceptT String IO HID := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { CONJ_ASSOC, ETA_AX, EXTENSION, FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_UNIV, MEMBER_NOT_EMPTY,
        NOT_IMP, .. } := D.core2
  let { REAL_ADD_LID, REAL_ADD_RID, REAL_LE_MUL_EQ, REAL_LT_IMP_LE, REAL_LT_MUL_EQ, REAL_LT_REFL,
        REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RNEG, REAL_MUL_RZERO, REAL_NEG_ADD, REAL_NEG_GE0,
        REAL_NEG_GT0, REAL_SUB_LT, REAL_SUB_REFL, REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, .. } :=
    D.core3
