  let { INT_MUL_EQ_1, INT_MUL_RID, INT_OF_NUM_SUB, INT_POW_2, INT_SUB_ADD, IN_CROSS, IN_ELIM_THM,
        IN_IMAGE, IN_INTER, IN_NUMSEG, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY,
        MONO_EXISTS, .. } := D.core2
  let { REAL_NEG_EQ_0, REAL_NEG_NEG, RIGHT_EXISTS_AND_THM, .. } := D.core3
  let { RIGHT_IMP_FORALL_THM, SING_SUBSET, SUBSET, SUBSET_REFL, SUB_ADD, SUM_DELTA, o_DEF,
        o_THM, .. } := D.core4
  let { ABELIAN_GROUP_DIV_ZPOW, ABELIAN_GROUP_MUL_AC, ABELIAN_GROUP_MUL_ZPOW,
        CARRIER_SUBGROUP_GENERATED_BY_SING, EXACT_SEQUENCE_SUM_LEMMA, GROUPS_EQ, GROUP_DIV,
        GROUP_DIV_REFL, GROUP_DIV_SUBGROUP_GENERATED, GROUP_ELEMENT_ORDER_EQ_0,
        GROUP_HOMOMORPHISM_DIV, GROUP_HOMOMORPHISM_MUL, GROUP_HOMOMORPHISM_POW,
        GROUP_HOMOMORPHISM_ZPOW, GROUP_INV, GROUP_INV_INV, GROUP_INV_MUL, GROUP_ISOMORPHISM, .. } :=
    D.grp1
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, GROUP_MUL, GROUP_ZPOW, GROUP_ZPOW_1, GROUP_ZPOW_ADD,
        GROUP_ZPOW_EQ_ALT, GROUP_ZPOW_MUL, GROUP_ZPOW_SUB, GROUP_ZPOW_SUBGROUP_GENERATED,
        INFINITE_CYCLIC_SUBGROUP_ORDER, INFINITE_INTEGER_GROUP, ISOMORPHIC_GROUP_INFINITENESS,
        ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRANS, PROD_GROUP, SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE, cyclic_group, group_div, group_exactness,
        group_homomorphism, group_image, group_isomorphism, group_isomorphisms,
        group_kernel, .. } := D.grp2
  let { CONTINUOUS_MAP_COMPONENTWISE_UNIV, CONTINUOUS_MAP_COMPOSE,
        CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_PRODUCT_PROJECTION,
        CONTINUOUS_MAP_REAL_NEG, .. } := D.met1
  let { HOMEOMORPHIC_MAP_MAPS, NSPHERE, .. } := D.met2
  let { SUBTOPOLOGY_NSPHERE_EQUATOR, SUBTOPOLOGY_RESTRICT, SUBTOPOLOGY_SUBTOPOLOGY,
        TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEAN_SPACE, TOPSPACE_PRODUCT_TOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, homeomorphic_maps, nsphere, .. } := D.met3
  let { homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_BOUNDARY, HOM_BOUNDARY_RESTRICT, .. } := BHBD
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED, HOM_INDUCED_RESTRICT, .. } := BHIN
  let { ABELIAN_RELATIVE_HOMOLOGY_GROUP, HOM_INDUCED_COMPOSE, HOM_INDUCED_EQ, HOM_INDUCED_ID,
        HOM_INDUCED_ID_GEN, NATURALITY_HOM_INDUCED, .. } := BHIF
  let { HOMOLOGY_EXACTNESS_TRIPLE_3, .. } := BHT3
  let { GROUP_CARRIER_REDUCED_HOMOLOGY_GROUP_SUBSET, reduced_homology_group, .. } := BHRD
  let { HOMOLOGY_EXACTNESS_REDUCED_1, .. } := BHRX
  let { GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_GROUP_LOWER_HEMISPHERE,
        GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_UPPER_HEMISPHERE, .. } := BHSP
  let { GROUP_ISOMORPHISM_LOWER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP,
        GROUP_ISOMORPHISM_REDUCED_HOMOLOGY_GROUP_UPPER_HEMISPHERE,
        GROUP_ISOMORPHISM_RELATIVE_HOMOLOGY_GROUP_LOWER_HEMISPHERE,
        GROUP_ISOMORPHISM_UPPER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP, .. } := BHHM
  let { CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE, REDUCED_HOMOLOGY_GROUP_NSPHERE, .. } := BHNS
  let { BROUWER_DEGREE2, BROUWER_DEGREE2_HOMEOMORPHIC_MAP,
        BROUWER_DEGREE2_UNIQUE_GENERATOR, .. } := BHBR
  -- @@SCOPE END

  let BORSUK_ODD_MAPPING_DEGREE_STEP ← prove
   r"!f n. continuous_map (nsphere n,nsphere n) f /\
         (!x. x IN topspace(nsphere n)
              ==> (f o (\x i. --x i)) x = ((\x i. --x i) o f) x) /\
         IMAGE f (topspace(nsphere(n - 1))) SUBSET topspace(nsphere(n - 1))
         ==> (brouwer_degree2 n f == brouwer_degree2 (n - 1) f) (mod &2)"
   (REPEAT GEN_TAC THEN DISJ_CASES_TAC (← ARITH_RULE (← q r"n = 0 \/ 1 <= n")) THENL
     [ASM_REWRITE_TAC [] THEN CONV_TAC NUM_REDUCE_CONV THEN
      REWRITE_TAC [← INTEGER_RULE (← q r"(x:int == x) (mod b)")],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"neg = \(x:num->real) i. --x i") THEN STRIP_TAC THEN
    MAP_EVERY ABBREV_TAC
     [← q r"upper = \n. {x:num->real | x(n+1) >= &0}",
      ← q r"lower = \n. {x:num->real | x(n+1) <= &0}",
      ← q r"equator = \n. {x:num->real | x(n+1) = &0}",
      ← q r"usphere = \n. subtopology (nsphere n) (upper n)",
      ← q r"lsphere = \n. subtopology (nsphere n) (lower n)"] THEN
    SUBGOAL_THEN
     (← q r"subtopology (nsphere n) (equator n) = nsphere(n - 1) /\
      subtopology (lsphere n) (equator n) = nsphere(n - 1) /\
      subtopology (usphere n) (equator n) = nsphere(n - 1)")
    STRIP_ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC
       ["lsphere", "usphere", "equator", "lower", "upper"] THEN
      REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY, ← SET_RULE
           (← q r"{x | P x} INTER {x | Q x} = {x | P x /\ Q x}")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x <= &0 /\ x = &0 <=> x = &0")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x >= &0 /\ x = &0 <=> x = &0")] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM SUBTOPOLOGY_NSPHERE_EQUATOR] THEN
      ASM_SIMP_TAC [SUB_ADD, ← ARITH_RULE (← q r"1 <= n ==> n - 1 + 2 = n + 1")],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"continuous_map(nsphere(n - 1),nsphere(n - 1)) f")
    ASSUME_TAC THENL
     [UNDISCH_TAC
       (← q r"IMAGE f (topspace(nsphere(n-1))) SUBSET topspace(nsphere(n - 1))") THEN
      ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_NSPHERE_EQUATOR] THEN
      ASM_SIMP_TAC [SUB_ADD, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!m x. neg x IN topspace(nsphere m) <=> x IN topspace(nsphere m)")
    ASSUME_TAC THENL
     [REWRITE_TAC [nsphere, TOPSPACE_SUBTOPOLOGY] THEN EXPAND_TAC "neg" THEN
      REWRITE_TAC [IN_INTER, IN_ELIM_THM, TOPSPACE_EUCLIDEAN_SPACE] THEN
      REWRITE_TAC [REAL_NEG_EQ_0, ← REAL_ARITH (← q r"(--x:real) pow 2 = x pow 2")],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!m. continuous_map(nsphere m,nsphere m) neg") ASSUME_TAC THENL
     [GEN_TAC THEN REWRITE_TAC [NSPHERE, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN EXPAND_TAC "neg" THEN
        REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN GEN_TAC THEN
        MATCH_MP_TAC CONTINUOUS_MAP_REAL_NEG THEN
        SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV],
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_SUBTOPOLOGY] THEN
        EXPAND_TAC "neg" THEN REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
        SIMP_TAC [REAL_NEG_EQ_0, ← REAL_ARITH (← q r"(--x:real) pow 2 = x pow 2")]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"&n - &1:int", ← q r"n - 1"] CYCLIC_REDUCED_HOMOLOGY_GROUP_NSPHERE) THEN
    REWRITE_TAC [cyclic_group, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:((num->real)->num->real)frag->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?zp. zp IN group_carrier(relative_homology_group(&n,lsphere n,equator n)) /\
           hom_boundary (&n) (lsphere n,equator n:(num->real)->bool) zp = z /\
           subgroup_generated (relative_homology_group(&n,lsphere n,equator n))
                              {zp} =
           relative_homology_group(&n,lsphere n,equator n)")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"&n - &1:int", ← q r"n - 1"]
          GROUP_ISOMORPHISM_LOWER_HEMISPHERE_REDUCED_HOMOLOGY_GROUP) THEN
      ASM_SIMP_TAC [SUB_ADD, INT_SUB_ADD, ← ARITH_RULE
       (← q r"1 <= n ==> n - 1 + 2 = n + 1")] THEN
      MAP_EVERY EXPAND_TAC ["equator", "lsphere", "lower"] THEN
      REWRITE_TAC [group_isomorphism] THEN MATCH_MP_TAC (← MESON []
       (← q r"(!g. P g ==> ?x. Q(g x)) ==> (?g. P g) ==> ?y. Q y")) THEN
      REWRITE_TAC [group_isomorphisms] THEN REPEAT STRIP_TAC THEN
      EXISTS_TAC (← q r"z:((num->real)->num->real)frag->bool") THEN
      ASM_SIMP_TAC [] THEN CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [],
        ONCE_REWRITE_TAC [← SET_RULE (← q r"{g z} = IMAGE g {z}")] THEN
        REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (W (MP_TAC o PART_MATCH (lhand o rand) (← MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE) th) o lhand o snd))) THEN
        ASM_REWRITE_TAC [SING_SUBSET] THEN DISCH_THEN SUBST1_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"(!x. x IN s ==> g'(g x) = x)
          ==> (!y. y IN t ==> g(g' y) = y) /\
             IMAGE g s SUBSET t /\ IMAGE g' t SUBSET s
