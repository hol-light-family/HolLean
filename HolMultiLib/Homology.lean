    REWRITE_TAC [← FRAG_MODULE (← q r"frag_sub x x = frag_0")] THEN
    REWRITE_TAC [FRAG_EXTEND_SUB, CHAIN_BOUNDARY_SUB, CHAIN_MAP_SUB] THEN
    CONJ_TAC THENL [ALL_TAC, REPEAT GEN_TAC THEN CONV_TAC (fun t => FRAG_MODULE t)] THEN
    X_GEN_TAC (← q r"a:(num->real)->A") THEN GEN_REWRITE_TAC LAND_CONV [IN] THEN
    DISCH_TAC THEN REWRITE_TAC [CHAIN_MAP_OF, FRAG_EXTEND_OF] THEN
    FIRST_ASSUM (fun th => tactic_of do
     pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o funpow 2 RATOR_CONV) [← SYM th])) THEN
    SIMP_TAC [CHAIN_BOUNDARY_SUM, FINITE_NUMSEG, o_DEF, CHAIN_BOUNDARY_CMUL] THEN
