        FRAG_EXTEND_SUM, FRAG_INDUCTION, MONOIDAL_FRAG_ADD, NEUTRAL_FRAG_ADD, .. } := D.frag
  let { CONTINUOUS_MAP_COMPONENTWISE, CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        CONTINUOUS_MAP_PAIRWISE, CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := D.met1
  let { HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS, .. } := D.met2
  let { SUBTOPOLOGY_CROSS, SUBTOPOLOGY_RESTRICT, SUBTOPOLOGY_TOPSPACE, TOPSPACE_PROD_TOPOLOGY,
