        ASM SET_TAC []],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:((num->real)->A)frag->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"p - &1:int", ← q r"subtopology top s:A topology",
