/- ------------------------------------------------------------------------- -/
/- A chain homotopy for simplicial subdivision.  (homology.ml 2368-2597)     -/
/- ------------------------------------------------------------------------- -/

structure CHS where
  CHAIN_HOMOTOPIC_SIMPLICIAL_SUBDIVISION : thm
  deriving Inhabited

@[nospecialize]
def setupCHS [HolBase] (D : HomologyDeps) (BSSX : SSX) (BSCH : SCH) (BBDB : BDB) (BSMP : SMP)
    (BCMP : CMP) (BSSC : SSC) (BSCC : SCC) (BSBD : SBD) (BSSS : SSS) :
    ExceptT String IO CHS := do
  -- @@SCOPE BEGIN
  let { prove_recursive_functions_exist, ARITH_RULE, ASM_MESON_TAC, MESON, REAL_ARITH,
        REAL_FIELD, FRAG_MODULE, NUM_REDUCE_CONV, .. } := D
  let { ADD1, AND_FORALL_THM, COND_RAND, CONJ_ASSOC, ETA_AX, FORALL_AND_THM, FORALL_IN_IMAGE,
        FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN, .. } := D.core1
  let { IN_NUMSEG, I_THM, LE_0, LE_REFL, NOT_SUC, .. } := D.core2
  let { REAL_ADD_LID, REAL_DIV_1, REAL_INV_LE_1, REAL_LE_INV_EQ, REAL_MUL_ASSOC, REAL_MUL_RID,
        REAL_MUL_RZERO, REAL_OF_NUM_SUC, RESTRICTION, RIGHT_FORALL_IMP_THM, .. } := D.core3
  let { RIGHT_IMP_FORALL_THM, SUBSET, SUC_SUB1, SUM_CLAUSES_NUMSEG, SUM_DELTA, SUM_EQ_NUMSEG,
        SUM_LMUL, SUM_RMUL, SUM_SWAP_NUMSEG, SWAP_FORALL_THM, num_INDUCTION, num_RECURSION,
        o_THM, real_div, .. } := D.core4
  let { FRAG_EXTEND_0, FRAG_EXTEND_OF, FRAG_EXTEND_SUB, FRAG_INDUCTION, .. } := D.frag
  let { BASIS_IN_STANDARD_SIMPLEX, CONVEX_STANDARD_SIMPLEX, .. } := BSSX
  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_SUB, SINGULAR_CHAIN_OF, .. } := BSCH
  let { CHAIN_BOUNDARY_BOUNDARY, .. } := BBDB
  let { CHAIN_MAP_0, CHAIN_MAP_OF, CHAIN_MAP_SUB, .. } := BSMP
  let { CHAIN_BOUNDARY_CHAIN_MAP, .. } := BCMP
  let { SIMPLICIAL_CHAIN_0, SIMPLICIAL_CHAIN_BOUNDARY, SIMPLICIAL_CHAIN_OF,
        SIMPLICIAL_CHAIN_SUB, SIMPLICIAL_IMP_SINGULAR_CHAIN, SIMPLICIAL_IMP_SINGULAR_SIMPLEX,
        SIMPLICIAL_SIMPLEX_ORIENTED_SIMPLEX, oriented_simplex, simplicial_chain,
        simplicial_simplex, .. } := BSSC
  let { CHAIN_BOUNDARY_SIMPLICIAL_CONE, CHAIN_MAP_SIMPLICIAL_CONE, SIMPLEX_MAP_ORIENTED_SIMPLEX,
        SIMPLICIAL_CHAIN_SIMPLICIAL_CONE, simplicial_cone, .. } := BSCC
  let { CHAIN_BOUNDARY_SIMPLICIAL_SUBDIVISION, SIMPLICIAL_CHAIN_SIMPLICIAL_SUBDIVISION,
        SIMPLICIAL_SUBDIVISION_0, SIMPLICIAL_SUBDIVISION_SUB, SIMPLICIAL_VERTEX_ORIENTED_SIMPLEX,
        simplicial_subdivision, .. } := BSBD
  let { NATURALITY_SIMPLICIAL_SUBDIVISION, .. } := BSSS
  -- @@SCOPE END

  let CHAIN_HOMOTOPIC_SIMPLICIAL_SUBDIVISION ← prove
   r"?h. (!p. h p frag_0 = frag_0) /\
       (!p c1 c2. h p (frag_sub c1 c2) = frag_sub (h p c1) (h p c2)) /\
       (!p q r g c.
                simplicial_chain (p,standard_simplex q) c /\
                simplicial_simplex (q,standard_simplex r) g
                ==> chain_map (p + 1) g (h p c) = h p (chain_map p g c)) /\
       (!p q c. simplicial_chain (p,standard_simplex q) c
                ==> simplicial_chain (p + 1,standard_simplex q) (h p c)) /\
       (!p q c. simplicial_chain (p,standard_simplex q) c
                ==> frag_add (chain_boundary (p + 1) (h p c))
                             (h (p - 1) (chain_boundary p c)) =
                    frag_sub (simplicial_subdivision p c) c)"
   (REPEAT STRIP_TAC THEN
    STRIP_ASSUME_TAC (← prove_recursive_functions_exist num_RECURSION
     (← q r"h 0 = (\x. frag_0) /\
      !p. h(SUC p) =
            frag_extend
               (\f. simplicial_cone (SUC p)
                     (\i. sum (0..SUC p)
                          (\j. simplicial_vertex j f i) / (&(SUC p) + &1))
                     (frag_sub
                        (frag_sub (simplicial_subdivision (SUC p) (frag_of f))
                                  (frag_of f))
                        (h p (chain_boundary (SUC p) (frag_of f)))))")) THEN
    EXISTS_TAC
     (← q r"h:num->((num->real)->num->real)frag->((num->real)->num->real)frag") THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC num_INDUCTION THEN
      ASM_REWRITE_TAC [FRAG_EXTEND_0, FRAG_EXTEND_SUB] THEN
      CONV_TAC (fun t => FRAG_MODULE t),
      ALL_TAC] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN
    GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN X_GEN_TAC (← q r"s:num") THEN
    ONCE_REWRITE_TAC [← MESON [] (← q r"(!r g c. P r c g) <=> (!c r g. P r c g)")] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, AND_FORALL_THM, ← TAUT
     (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    MATCH_MP_TAC num_INDUCTION THEN CONV_TAC NUM_REDUCE_CONV THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [← CONJUNCT1 simplicial_subdivision, I_THM, CHAIN_MAP_0] THEN
      REWRITE_TAC [SIMPLICIAL_CHAIN_0, CHAIN_BOUNDARY_0] THEN
      REPEAT STRIP_TAC THEN CONV_TAC (fun t => FRAG_MODULE t),
      X_GEN_TAC (← q r"p:num")] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
     [RIGHT_IMP_FORALL_THM, ← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)"),
      FORALL_AND_THM, IMP_IMP] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!p. (h:num->((num->real)->num->real)frag->((num->real)->num->real)frag)
          p frag_0 = frag_0")
    ASSUME_TAC THENL
     [MATCH_MP_TAC num_INDUCTION THEN ASM_REWRITE_TAC [FRAG_EXTEND_0],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!p c1 c2.
        (h:num->((num->real)->num->real)frag->((num->real)->num->real)frag)
        p (frag_sub c1 c2) = frag_sub (h p c1) (h p c2)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC num_INDUCTION THEN ASM_REWRITE_TAC [FRAG_EXTEND_SUB] THEN
      CONV_TAC (fun t => FRAG_MODULE t),
      ALL_TAC] THEN
    ABBREV_TAC (← q r"q = SUC p") THEN REWRITE_TAC [simplicial_chain] THEN
    MATCH_MP_TAC FRAG_INDUCTION THEN REWRITE_TAC [← GSYM simplicial_chain] THEN
    ASM_REWRITE_TAC [CHAIN_BOUNDARY_0, SIMPLICIAL_SUBDIVISION_0, CHAIN_MAP_0] THEN
    ASM_SIMP_TAC [CHAIN_BOUNDARY_SUB, SIMPLICIAL_SUBDIVISION_SUB,
                  CHAIN_MAP_SUB] THEN
    REWRITE_TAC [SIMPLICIAL_CHAIN_0] THEN
    CONJ_TAC THENL [CONV_TAC (fun t => FRAG_MODULE t), ALL_TAC] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:(num->real)->(num->real)") THEN REWRITE_TAC [IN] THEN
      DISCH_TAC THEN
      UNDISCH_THEN (← q r"SUC p = q") (SUBST_ALL_TAC o SYM) THEN
      ASM_REWRITE_TAC [SUC_SUB1, FRAG_EXTEND_OF],
      REWRITE_TAC [← FRAG_MODULE (← q r"frag_add x y = z <=> x = frag_sub z y")] THEN
      REPEAT STRIP_TAC THEN ASM_SIMP_TAC [SIMPLICIAL_CHAIN_SUB] THENL
       [ASM_MESON_TAC [], CONV_TAC (fun t => FRAG_MODULE t)]] THEN
    SUBGOAL_THEN
     (← q r"(\i. sum (0..SUC p) (\j. simplicial_vertex j f i) / (&(SUC p) + &1))
      IN standard_simplex s")
    ASSUME_TAC THENL
     [MP_TAC (← ASSUME (← q r"simplicial_simplex (SUC p,standard_simplex s) f")) THEN
      REWRITE_TAC [simplicial_simplex] THEN DISCH_THEN (X_CHOOSE_THEN
       (← q r"m:num->num->real") SUBST_ALL_TAC o CONJUNCT2) THEN
      ASM_SIMP_TAC [SIMPLICIAL_VERTEX_ORIENTED_SIMPLEX] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [SIMPLICIAL_SIMPLEX_ORIENTED_SIMPLEX]) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      DISCH_THEN (MP_TAC o GEN (← q r"i:num") o
        SPEC (← q r"(\j. if j = i then &1 else &0):num->real")) THEN
      REWRITE_TAC [BASIS_IN_STANDARD_SIMPLEX, COND_RAND] THEN
      SIMP_TAC [REAL_MUL_RZERO, SUM_DELTA, IN_NUMSEG, LE_0, REAL_MUL_RID] THEN
      ASM_SIMP_TAC [ETA_AX, RESTRICTION, ← GSYM SUM_LMUL, ← GSYM SUM_RMUL] THEN
      SPEC_TAC (← q r"SUC p", ← q r"n:num") THEN MATCH_MP_TAC num_INDUCTION THEN
      REWRITE_TAC [SUM_CLAUSES_NUMSEG, LE_0, REAL_ADD_LID, REAL_DIV_1] THEN
      ASM_SIMP_TAC [ETA_AX, LE_0, ← GSYM REAL_OF_NUM_SUC, ← REAL_FIELD
        (← q r"(a + b) / ((&n + &1) + &1) =
         (&1 - inv(&n + &2)) * ((a / (&n + &1))) + inv(&n + &2) * b")] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC CONVEX_STANDARD_SIMPLEX THEN
      ASM_SIMP_TAC [ETA_AX, LE_REFL, REAL_LE_INV_EQ, REAL_INV_LE_1,
                    ← REAL_ARITH (← q r"&1 <= &n + &2 /\ &0 <= &n + &2")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [← ARITH_RULE (← q r"i <= n ==> i <= SUC n")],
      ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"r:num", ← q r"g:(num->real)->(num->real)"] THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL
       [← q r"standard_simplex r", ← q r"SUC p", ← q r"s:num", ← q r"s:num"]
         CHAIN_MAP_SIMPLICIAL_CONE) THEN
      DISCH_THEN (fun th =>
        W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o snd)) THEN
      ASM_REWRITE_TAC [LE_REFL] THEN ANTS_TAC THENL
       [REPEAT (MATCH_MP_TAC SIMPLICIAL_CHAIN_SUB THEN CONJ_TAC) THEN
        ASM_SIMP_TAC [SIMPLICIAL_CHAIN_SIMPLICIAL_SUBDIVISION,
                      SIMPLICIAL_CHAIN_OF] THEN
        REWRITE_TAC [ADD1] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
         [← ARITH_RULE (← q r"p = (p + 1) - 1")] THEN
        MATCH_MP_TAC SIMPLICIAL_CHAIN_BOUNDARY THEN
        ASM_REWRITE_TAC [← GSYM ADD1, SIMPLICIAL_CHAIN_OF],
        DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [CHAIN_MAP_OF, FRAG_EXTEND_OF] THEN BINOP_TAC THENL
       [MP_TAC (← ASSUME (← q r"simplicial_simplex (s,standard_simplex r) g")) THEN
        REWRITE_TAC [simplicial_simplex] THEN DISCH_THEN (X_CHOOSE_THEN
          (← q r"m:num->num->real") SUBST_ALL_TAC o CONJUNCT2) THEN
        ASM_REWRITE_TAC [oriented_simplex, RESTRICTION] THEN
        GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"k:num") THEN
        REWRITE_TAC [real_div, SUM_RMUL, REAL_MUL_ASSOC] THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [← GSYM oriented_simplex, ← GSYM SUM_LMUL] THEN
        GEN_REWRITE_TAC LAND_CONV [SUM_SWAP_NUMSEG] THEN
        MATCH_MP_TAC SUM_EQ_NUMSEG THEN X_GEN_TAC (← q r"m:num") THEN
        STRIP_TAC THEN REWRITE_TAC [] THEN
        MP_TAC (← ASSUME
         (← q r"simplicial_simplex (SUC p,standard_simplex s) f")) THEN
        REWRITE_TAC [simplicial_simplex] THEN DISCH_THEN (X_CHOOSE_THEN
          (← q r"l:num->num->real") SUBST_ALL_TAC o CONJUNCT2) THEN
        MP_TAC (← ISPECL
         [← q r"SUC p", ← q r"s:num", ← q r"s:num",
          ← q r"oriented_simplex s m", ← q r"l:num->num->real",
          ← q r"standard_simplex r"] SIMPLEX_MAP_ORIENTED_SIMPLEX) THEN
        ASM_REWRITE_TAC [LE_REFL] THEN DISCH_THEN SUBST1_TAC THEN
        ASM_REWRITE_TAC [SIMPLICIAL_VERTEX_ORIENTED_SIMPLEX] THEN
        MP_TAC (← ASSUME
         (← q r"simplicial_simplex (SUC p,standard_simplex s)
                             (oriented_simplex (SUC p) l)")) THEN
        REWRITE_TAC [SIMPLICIAL_SIMPLEX_ORIENTED_SIMPLEX, SUBSET] THEN
        REWRITE_TAC [FORALL_IN_IMAGE] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"(\i. if i = m then &1 else &0):num->real")) THEN
        ASM_REWRITE_TAC [BASIS_IN_STANDARD_SIMPLEX, COND_RAND] THEN
        SIMP_TAC [REAL_MUL_RZERO, SUM_DELTA, REAL_MUL_RID] THEN
        ASM_REWRITE_TAC [IN_NUMSEG, oriented_simplex, o_THM, RESTRICTION] THEN
        SIMP_TAC [ETA_AX],
        REWRITE_TAC [CHAIN_MAP_SUB] THEN
        REPEAT BINOP_TAC THEN REWRITE_TAC [CHAIN_MAP_OF] THENL
         [REWRITE_TAC [← GSYM CHAIN_MAP_OF] THEN CONV_TAC SYM_CONV THEN
          MATCH_MP_TAC NATURALITY_SIMPLICIAL_SUBDIVISION THEN
          REWRITE_TAC [SIMPLICIAL_CHAIN_OF] THEN ASM_MESON_TAC [],
          REWRITE_TAC [ADD1] THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r:num") o
             GEN_REWRITE_RULE id [SWAP_FORALL_THM]) THEN
          DISCH_THEN (fun th =>
            W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o snd)) THEN
          ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
           [GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
             [← ARITH_RULE (← q r"p = (p + 1) - 1")] THEN
            MATCH_MP_TAC SIMPLICIAL_CHAIN_BOUNDARY THEN
            ASM_REWRITE_TAC [← GSYM ADD1, SIMPLICIAL_CHAIN_OF],
            DISCH_THEN SUBST1_TAC] THEN
          AP_TERM_TAC THEN
          REWRITE_TAC [← GSYM CHAIN_MAP_OF] THEN CONV_TAC SYM_CONV THEN
          GEN_REWRITE_TAC (RAND_CONV o RATOR_CONV o LAND_CONV)
           [← ARITH_RULE (← q r"p = (p + 1) - 1")] THEN
          MATCH_MP_TAC CHAIN_BOUNDARY_CHAIN_MAP THEN
          REWRITE_TAC [← GSYM ADD1, SINGULAR_CHAIN_OF] THEN
          ASM_MESON_TAC [SIMPLICIAL_IMP_SINGULAR_SIMPLEX]]],
      MATCH_MP_TAC SIMPLICIAL_CHAIN_SIMPLICIAL_CONE THEN
      EXISTS_TAC (← q r"standard_simplex s") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [REPEAT (MATCH_MP_TAC SIMPLICIAL_CHAIN_SUB THEN CONJ_TAC) THEN
        ASM_SIMP_TAC [SIMPLICIAL_CHAIN_SIMPLICIAL_SUBDIVISION,
                      SIMPLICIAL_CHAIN_OF] THEN
        REWRITE_TAC [ADD1] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
         [← ARITH_RULE (← q r"p = (p + 1) - 1")] THEN
        MATCH_MP_TAC SIMPLICIAL_CHAIN_BOUNDARY THEN
        ASM_REWRITE_TAC [← GSYM ADD1, SIMPLICIAL_CHAIN_OF],
        REPEAT STRIP_TAC THEN MATCH_MP_TAC CONVEX_STANDARD_SIMPLEX THEN
        ASM_REWRITE_TAC []],
      MP_TAC (← ISPECL [← q r"SUC p", ← q r"standard_simplex s"]
        CHAIN_BOUNDARY_SIMPLICIAL_CONE) THEN
      DISCH_THEN (fun th =>
        W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o lhand o snd)) THEN
      ASM_REWRITE_TAC [NOT_SUC] THEN ANTS_TAC THENL
       [REPEAT (MATCH_MP_TAC SIMPLICIAL_CHAIN_SUB THEN CONJ_TAC) THEN
        ASM_SIMP_TAC [SIMPLICIAL_CHAIN_SIMPLICIAL_SUBDIVISION,
                      SIMPLICIAL_CHAIN_OF] THEN
        REWRITE_TAC [ADD1] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
         [← ARITH_RULE (← q r"p = (p + 1) - 1")] THEN
        MATCH_MP_TAC SIMPLICIAL_CHAIN_BOUNDARY THEN
        ASM_REWRITE_TAC [← GSYM ADD1, SIMPLICIAL_CHAIN_OF],
        DISCH_THEN SUBST1_TAC] THEN
      MATCH_MP_TAC (← FRAG_MODULE
        (← q r"z = frag_0
         ==> frag_add (frag_sub (frag_sub (frag_sub ff f) t) z) t =
             frag_sub ff f")) THEN
      REWRITE_TAC [simplicial_cone] THEN MATCH_MP_TAC (← MESON [FRAG_EXTEND_0]
       (← q r"z = frag_0 ==> frag_extend f z = frag_0")) THEN
      REWRITE_TAC [CHAIN_BOUNDARY_SUB] THEN
      FIRST_ASSUM (MP_TAC o
       SPEC (← q r"chain_boundary (SUC p) (frag_of(f:(num->real)->(num->real)))")) THEN
      ANTS_TAC THENL
       [GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM SUC_SUB1] THEN
        MATCH_MP_TAC SIMPLICIAL_CHAIN_BOUNDARY THEN
        ASM_REWRITE_TAC [SIMPLICIAL_CHAIN_OF],
        REWRITE_TAC [ADD1]] THEN
      DISCH_THEN (SUBST1_TAC o MATCH_MP (← FRAG_MODULE
       (← q r"frag_add w z = x ==> w = frag_sub x z"))) THEN
      REWRITE_TAC [CHAIN_BOUNDARY_SUB] THEN
      MP_TAC (← ISPECL [← q r"p + 1",
                        ← q r"subtopology (product_topology (:num) (\i. euclideanreal))
                                  (standard_simplex s)",
                        ← q r"frag_of(f:(num->real)->(num->real))"]
        CHAIN_BOUNDARY_BOUNDARY) THEN
      ASM_SIMP_TAC [SIMPLICIAL_IMP_SINGULAR_CHAIN, SIMPLICIAL_CHAIN_OF,
                    ← GSYM ADD1, SUC_SUB1] THEN
      DISCH_THEN SUBST1_TAC THEN
      MP_TAC (← ISPECL [← q r"SUC p", ← q r"standard_simplex s",
                        ← q r"frag_of(f:(num->real)->(num->real))"]
            CHAIN_BOUNDARY_SIMPLICIAL_SUBDIVISION) THEN
      ASM_REWRITE_TAC [SIMPLICIAL_CHAIN_OF, SUC_SUB1] THEN
      CONV_TAC (fun t => FRAG_MODULE t)])

  return { CHAIN_HOMOTOPIC_SIMPLICIAL_SUBDIVISION }

/- ------------------------------------------------------------------------- -/
/- A chain homotopy for singular subdivision.  (homology.ml 2598-2789)       -/
/- ------------------------------------------------------------------------- -/

structure CHG where
  CHAIN_HOMOTOPIC_SINGULAR_SUBDIVISION : thm
  HOMOLOGOUS_REL_SINGULAR_SUBDIVISION : thm
  deriving Inhabited

@[nospecialize]
def setupCHG [HolBase] (D : HomologyDeps) (BSFC : SFC) (BSCH : SCH) (BMSR : MSR) (BHMR : HMR)
    (BSMP : SMP) (BCMP : CMP) (BSSC : SSC) (BSGS : SGS) (BSSS : SSS) (BCHS : CHS) :
    ExceptT String IO CHG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, FRAG_MODULE, .. } := D
  let { ADD_SUB, AND_FORALL_THM, CARTESIAN_PRODUCT_UNIV, EQ_TRANS, FINITE_INDUCT_STRONG,
        FINITE_NUMSEG, FORALL_IN_IMAGE, FUN_EQ_THM, IN, INTER_UNIV, .. } := D.core1
  let { INT_POW_NEG, INT_POW_ONE, IN_NUMSEG, ITERATE_CLAUSES, ITERATE_EQ, I_O_ID, I_THM,
        LE_1, .. } := D.core2
  let { RESTRICTION, .. } := D.core3
  let { SUBSET, SUBSET_REFL, SUB_ADD, SWAP_FORALL_THM, o_DEF, o_THM, .. } := D.core4
  let { FRAG_EXTEND_0, FRAG_EXTEND_CMUL, FRAG_EXTEND_OF, FRAG_EXTEND_SUB, FRAG_EXTEND_SUM,
        FRAG_INDUCTION, MONOIDAL_FRAG_ADD, NEUTRAL_FRAG_ADD, .. } := D.frag
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := D.met1
  let { TOPSPACE_EUCLIDEANREAL, TOPSPACE_PRODUCT_TOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := D.met3
  let { SIMPLICIAL_FACE_IN_STANDARD_SIMPLEX, singular_face, singular_simplex, .. } := BSFC
  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_SUB, SINGULAR_CHAIN_0, SINGULAR_CHAIN_SUB,
        chain_boundary, singular_chain, .. } := BSCH
  let { singular_relcycle, .. } := BMSR
  let { CHAIN_HOMOTOPIC_IMP_HOMOLOGOUS_REL, HOMOLOGOUS_REL_REFL, .. } := BHMR
  let { CHAIN_MAP_0, CHAIN_MAP_CMUL, CHAIN_MAP_COMPOSE, CHAIN_MAP_OF, CHAIN_MAP_SUB,
        CHAIN_MAP_SUM, SINGULAR_CHAIN_CHAIN_MAP, simplex_map, .. } := BSMP
  let { CHAIN_BOUNDARY_CHAIN_MAP, SINGULAR_SIMPLEX_CHAIN_MAP_I, .. } := BCMP
  let { SIMPLICIAL_CHAIN_OF, SIMPLICIAL_IMP_SINGULAR_CHAIN, SIMPLICIAL_SIMPLEX_SINGULAR_FACE,
        simplicial_chain, simplicial_simplex, .. } := BSSC
  let { SIMPLICIAL_SIMPLEX_I, singular_subdivision, .. } := BSGS
  let { SINGULAR_SUBDIVISION_ZERO, .. } := BSSS
  let { CHAIN_HOMOTOPIC_SIMPLICIAL_SUBDIVISION, .. } := BCHS
  -- @@SCOPE END

  let CHAIN_HOMOTOPIC_SINGULAR_SUBDIVISION ← prove
   r"?h:num->((num->real)->A)frag->((num->real)->A)frag.
        (!p. h p frag_0 = frag_0) /\
        (!p c1 c2. h p (frag_sub c1 c2) = frag_sub (h p c1) (h p c2)) /\
        (!p top c. singular_chain (p,top) c
                   ==> singular_chain (p + 1,top) (h p c)) /\
        (!p top c. singular_chain (p,top) c
                   ==> frag_add (chain_boundary (p + 1) (h p c))
                                (h (p - 1) (chain_boundary p c)) =
                       frag_sub (singular_subdivision p c) c)"
   (X_CHOOSE_THEN
     (← q r"h:num->((num->real)->(num->real))frag->((num->real)->(num->real))frag")
     STRIP_ASSUME_TAC CHAIN_HOMOTOPIC_SIMPLICIAL_SUBDIVISION THEN
    ABBREV_TAC
     (← q r"k:num->((num->real)->A)frag->((num->real)->A)frag =
          \p. frag_extend
                (\f. chain_map (p + 1) (f:(num->real)->A)
                 (h p (frag_of(RESTRICTION (standard_simplex p)
                        (I:(num->real)->(num->real))))))") THEN
    EXISTS_TAC (← q r"k:num->((num->real)->A)frag->((num->real)->A)frag") THEN
    SUBGOAL_THEN
     (← q r"!p. (k:num->((num->real)->A)frag->((num->real)->A)frag) p frag_0 = frag_0")
    ASSUME_TAC THENL
     [EXPAND_TAC "k" THEN REWRITE_TAC [FRAG_EXTEND_0],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!p c1 c2. (k:num->((num->real)->A)frag->((num->real)->A)frag) p
                  (frag_sub c1 c2) = frag_sub (k p c1) (k p c2)")
    ASSUME_TAC THENL
     [EXPAND_TAC "k" THEN REWRITE_TAC [FRAG_EXTEND_SUB],
      ASM_REWRITE_TAC []] THEN
    REWRITE_TAC [AND_FORALL_THM, ← TAUT
     (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    MAP_EVERY X_GEN_TAC [← q r"p:num", ← q r"s:A topology"] THEN
    REWRITE_TAC [singular_chain] THEN
    MATCH_MP_TAC FRAG_INDUCTION THEN
    ASM_REWRITE_TAC [← GSYM singular_chain] THEN
    ASM_SIMP_TAC [CHAIN_BOUNDARY_0, SINGULAR_CHAIN_0, CHAIN_BOUNDARY_SUB,
                  singular_subdivision, FRAG_EXTEND_0, FRAG_EXTEND_SUB] THEN
    REWRITE_TAC [← GSYM singular_subdivision] THEN SIMP_TAC [SINGULAR_CHAIN_SUB] THEN
    CONJ_TAC THENL [CONV_TAC (fun t => FRAG_MODULE t), ALL_TAC] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:(num->real)->A") THEN REWRITE_TAC [IN] THEN DISCH_TAC,
      REWRITE_TAC [← FRAG_MODULE (← q r"frag_add x y = z <=> x = frag_sub z y")] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => FRAG_MODULE t)] THEN
    EXPAND_TAC "k" THEN REWRITE_TAC [FRAG_EXTEND_OF, ADD_SUB] THEN CONJ_TAC THENL
     [MATCH_MP_TAC SINGULAR_CHAIN_CHAIN_MAP THEN
      EXISTS_TAC (← q r"subtopology (product_topology (:num) (\i. euclideanreal))
                              (standard_simplex p)") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [singular_simplex]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SIMPLICIAL_IMP_SINGULAR_CHAIN THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [SIMPLICIAL_CHAIN_OF, SIMPLICIAL_SIMPLEX_I, SUBSET_REFL],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"p + 1",
                      ← q r"subtopology (product_topology (:num) (\i. euclideanreal))
                                (standard_simplex p)",
                      ← q r"f:(num->real)->A"]
          CHAIN_BOUNDARY_CHAIN_MAP) THEN
    DISCH_THEN (fun th =>
     W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o lhand o snd)) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC SIMPLICIAL_IMP_SINGULAR_CHAIN THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [SIMPLICIAL_CHAIN_OF, SIMPLICIAL_SIMPLEX_I, SUBSET_REFL],
      DISCH_THEN SUBST1_TAC] THEN
    REWRITE_TAC [ADD_SUB] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE
     (funpow 3 BINDER_CONV o RAND_CONV)
     [← FRAG_MODULE (← q r"frag_add x y = z <=> x = frag_sub z y")]) THEN
    DISCH_THEN (MP_TAC o SPECL
      [← q r"p:num", ← q r"p:num",
       ← q r"frag_of(RESTRICTION (standard_simplex p) I)"]) THEN
    REWRITE_TAC [SIMPLICIAL_CHAIN_OF, SIMPLICIAL_SIMPLEX_I, SUBSET_REFL] THEN
    DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [← FRAG_MODULE (← q r"frag_add x y = z <=> x = frag_sub z y")] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [CHAIN_MAP_SUB, CHAIN_MAP_OF] THEN
    MATCH_MP_TAC (← FRAG_MODULE
     (← q r"b = y /\ frag_sub a c = frag_sub x z
      ==> frag_sub (frag_sub a b) c = frag_sub (frag_sub x y) z")) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← GSYM CHAIN_MAP_OF] THEN
      MATCH_MP_TAC SINGULAR_SIMPLEX_CHAIN_MAP_I THEN ASM_MESON_TAC [],
      REWRITE_TAC [← GSYM CHAIN_MAP_SUB, singular_subdivision]] THEN
    REWRITE_TAC [FRAG_EXTEND_OF, CHAIN_MAP_SUB] THEN AP_TERM_TAC THEN
    REWRITE_TAC [chain_boundary] THEN
    ASM_REWRITE_TAC [CHAIN_MAP_0, FRAG_EXTEND_0] THEN
    ASM_CASES_TAC (← q r"p = 0") THEN ASM_REWRITE_TAC [FRAG_EXTEND_0, CHAIN_MAP_0] THEN
    ASM_SIMP_TAC [SUB_ADD, LE_1, FRAG_EXTEND_OF] THEN
    SIMP_TAC [FRAG_EXTEND_SUM, FINITE_NUMSEG] THEN
    REWRITE_TAC [o_DEF, FRAG_EXTEND_CMUL, FRAG_EXTEND_OF] THEN
    TRANS_TAC EQ_TRANS
      (← q r"chain_map p (f:(num->real)->A)
        (iterate frag_add (0..p)
         (\k. frag_cmul (-- &1 pow k)
                (chain_map p (singular_face p k I)
                 ((h:num->((num->real)->(num->real))frag
                     ->((num->real)->(num->real))frag) (p - 1)
                  (frag_of (RESTRICTION (standard_simplex (p - 1)) I))))))") THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [] THEN AP_TERM_TAC THEN
      SUBGOAL_THEN
       (← q r"!k z. FINITE k
              ==> (h:num->((num->real)->(num->real))frag
                       ->((num->real)->(num->real))frag) (p - 1)
                  (iterate frag_add (k:num->bool) z) =
                  iterate frag_add k (h (p - 1) o z)")
       (fun th => SIMP_TAC [th, FINITE_NUMSEG])
      THENL
       [GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
        MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
        SIMP_TAC [← MATCH_MP ITERATE_CLAUSES MONOIDAL_FRAG_ADD] THEN
        ASM_REWRITE_TAC [NEUTRAL_FRAG_ADD, o_DEF] THEN
        ASM_SIMP_TAC [← FRAG_MODULE
         (← q r"frag_add x y = frag_sub x (frag_sub frag_0 y)")],
        ALL_TAC] THEN
      MATCH_MP_TAC (← MATCH_MP ITERATE_EQ MONOIDAL_FRAG_ADD) THEN
      X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [IN_NUMSEG, o_DEF] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!k c. (h:num->((num->real)->(num->real))frag
                   ->((num->real)->(num->real))frag) (p - 1)
              (frag_cmul (-- &1 pow k) c) =
              frag_cmul (-- &1 pow k) (h (p - 1) c)")
       (fun th => REWRITE_TAC [th])
      THENL
       [REPEAT GEN_TAC THEN REWRITE_TAC [INT_POW_NEG, INT_POW_ONE] THEN
        COND_CASES_TAC THEN REWRITE_TAC [← FRAG_MODULE (← q r"frag_cmul (&1) c = c")] THEN
        ASM_REWRITE_TAC [← FRAG_MODULE
         (← q r"frag_cmul (-- &1) c = frag_sub frag_0 c")],
        AP_TERM_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"p - 1", ← q r"p - 1", ← q r"p:num",
        ← q r"singular_face p k (RESTRICTION (standard_simplex p) I)",
        ← q r"frag_of(RESTRICTION
          (standard_simplex (p - 1)) (I:(num->real)->(num->real)))"]) THEN
      ASM_REWRITE_TAC [SIMPLICIAL_CHAIN_OF, SIMPLICIAL_SIMPLEX_I] THEN
      REWRITE_TAC [SUBSET_REFL] THEN ANTS_TAC THENL
       [MATCH_MP_TAC SIMPLICIAL_SIMPLEX_SINGULAR_FACE THEN
        ASM_SIMP_TAC [LE_1, SIMPLICIAL_SIMPLEX_I, SUBSET_REFL],
        MATCH_MP_TAC (← MESON [] (← q r"x = y' /\ y = x' ==> x = y ==> x' = y'")) THEN
        REWRITE_TAC [CHAIN_MAP_OF] THEN CONJ_TAC THENL
         [ASM_SIMP_TAC [LE_1, SUB_ADD],
          ASM_SIMP_TAC [SUB_ADD, LE_1] THEN
          AP_TERM_TAC THEN REWRITE_TAC [CHAIN_MAP_OF] THEN AP_TERM_TAC THEN
          REWRITE_TAC [singular_face, simplex_map, RESTRICTION, FUN_EQ_THM,
                       o_THM, I_THM] THEN
          ASM_SIMP_TAC [LE_1, SIMPLICIAL_FACE_IN_STANDARD_SIMPLEX]]],
      SIMP_TAC [CHAIN_MAP_SUM, FINITE_NUMSEG] THEN
      MATCH_MP_TAC (← MATCH_MP ITERATE_EQ MONOIDAL_FRAG_ADD) THEN
      X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
      REWRITE_TAC [o_DEF, CHAIN_MAP_CMUL] THEN AP_TERM_TAC THEN
      REWRITE_TAC [← REWRITE_RULE [FUN_EQ_THM, o_THM] (← GSYM CHAIN_MAP_COMPOSE)] THEN
      ASM_REWRITE_TAC [singular_face, I_O_ID]] THEN
    (SUBGOAL_THEN
      (← q r"simplicial_chain((p-1)+1,standard_simplex(p - 1))
          ((h:num->((num->real)->(num->real))frag
              ->((num->real)->(num->real))frag) (p - 1)
               (frag_of (RESTRICTION (standard_simplex (p - 1)) I)))")
     MP_TAC THENL
      [FIRST_X_ASSUM MATCH_MP_TAC THEN
       REWRITE_TAC [SIMPLICIAL_CHAIN_OF, SIMPLICIAL_SIMPLEX_I, SUBSET_REFL],
       ASM_SIMP_TAC [SUB_ADD, LE_1]] THEN
     SPEC_TAC (← q r"(h:num->((num->real)->(num->real))frag
                        ->((num->real)->(num->real))frag) (p - 1)
               (frag_of (RESTRICTION (standard_simplex (p - 1)) I))",
              ← q r"c:((num->real)->(num->real))frag") THEN
     REWRITE_TAC [simplicial_chain] THEN MATCH_MP_TAC FRAG_INDUCTION THEN
     SIMP_TAC [CHAIN_MAP_0, CHAIN_MAP_SUB] THEN
     X_GEN_TAC (← q r"f:(num->real)->(num->real)") THEN REWRITE_TAC [IN] THEN
     REWRITE_TAC [CHAIN_MAP_OF, singular_simplex, simplicial_simplex] THEN
     REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
                  TOPSPACE_PRODUCT_TOPOLOGY, TOPSPACE_SUBTOPOLOGY, INTER_UNIV,
                  TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV, o_DEF] THEN
     STRIP_TAC THEN
     AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM, simplex_map] THEN
     ASM_SIMP_TAC [singular_face, I_THM, o_THM, RESTRICTION,
                   SIMPLICIAL_FACE_IN_STANDARD_SIMPLEX, LE_1]))

  let HOMOLOGOUS_REL_SINGULAR_SUBDIVISION ← prove
   r"!p s t c:((num->real)->A)frag.
        singular_relcycle (p,s,t) c
        ==> homologous_rel (p,s,t) (singular_subdivision p c) c"
   (REPLICATE_TAC 3 GEN_TAC THEN ASM_CASES_TAC (← q r"p = 0") THENL
     [ASM_MESON_TAC [singular_relcycle, SINGULAR_SUBDIVISION_ZERO,
                     HOMOLOGOUS_REL_REFL],
      ALL_TAC] THEN
    MATCH_MP_TAC CHAIN_HOMOTOPIC_IMP_HOMOLOGOUS_REL THEN
    X_CHOOSE_THEN
     (← q r"k:num->((num->real)->A)frag->((num->real)->A)frag")
     STRIP_ASSUME_TAC CHAIN_HOMOTOPIC_SINGULAR_SUBDIVISION THEN
    EXISTS_TAC (← q r"(k:num->((num->real)->A)frag->((num->real)->A)frag) p") THEN
    EXISTS_TAC (← q r"(k:num->((num->real)->A)frag->((num->real)->A)frag) (p - 1)") THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [SUB_ADD, LE_1])

  return { CHAIN_HOMOTOPIC_SINGULAR_SUBDIVISION, HOMOLOGOUS_REL_SINGULAR_SUBDIVISION }

/- ------------------------------------------------------------------------- -/
/- Excision argument that we keep doing singular subdivision.                -/
/- (homology.ml 2790-2916)                                                   -/
/- ------------------------------------------------------------------------- -/

structure ITS where
  ITERATED_SINGULAR_SUBDIVISION : thm
  CHAIN_HOMOTOPIC_ITERATED_SINGULAR_SUBDIVISION : thm
  deriving Inhabited

@[nospecialize]
def setupITS [HolBase] (D : HomologyDeps) (BSCH : SCH) (BCMP : CMP) (BSSC : SSC) (BSBD : SBD)
    (BSGS : SGS) (BSSS : SSS) (BCHG : CHG) : ExceptT String IO ITS := do
  -- @@SCOPE BEGIN
  let { INDUCT_TAC, MESON, FRAG_MODULE, .. } := D
  let { ADD_SUB, AND_FORALL_THM, IN, .. } := D.core1
  let { LE_1, .. } := D.core2
  let { SUBSET_REFL, SUB_ADD, num_INDUCTION, .. } := D.core4
  let { ITER, .. } := D.lib
  let { FRAG_EXTEND_0, FRAG_EXTEND_OF, FRAG_EXTEND_SUB, FRAG_INDUCTION, .. } := D.frag
  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_ADD, SINGULAR_CHAIN_0, SINGULAR_CHAIN_ADD,
        SINGULAR_CHAIN_OF, chain_boundary, singular_chain, .. } := BSCH
  let { SINGULAR_SIMPLEX_CHAIN_MAP_I, .. } := BCMP
  let { SIMPLICIAL_CHAIN_OF, SIMPLICIAL_IMP_SINGULAR_CHAIN, .. } := BSSC
  let { SIMPLICIAL_CHAIN_SIMPLICIAL_SUBDIVISION, .. } := BSBD
  let { NATURALITY_SINGULAR_SUBDIVISION, SIMPLICIAL_SIMPLEX_I,
        SINGULAR_CHAIN_SINGULAR_SUBDIVISION, SINGULAR_SUBDIVISION_0, SINGULAR_SUBDIVISION_ADD,
        SINGULAR_SUBDIVISION_SUB, singular_subdivision, .. } := BSGS
  let { CHAIN_BOUNDARY_SINGULAR_SUBDIVISION, SINGULAR_SUBDIVISION_SIMPLICIAL_SIMPLEX, .. } := BSSS
  let { CHAIN_HOMOTOPIC_SINGULAR_SUBDIVISION, .. } := BCHG
  -- @@SCOPE END

  let ITERATED_SINGULAR_SUBDIVISION ← prove
   r"!p s n c.
        singular_chain(p,s) c
        ==> ITER n (singular_subdivision p) c =
            frag_extend
             (\f:(num->real)->A.
                  chain_map p f
                       (ITER n (simplicial_subdivision p)
                         (frag_of(RESTRICTION (standard_simplex p) I)))) c"
   (GEN_TAC THEN GEN_TAC THEN
    CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN MATCH_MP_TAC num_INDUCTION THEN
    REWRITE_TAC [ITER] THEN CONJ_TAC THENL
     [ALL_TAC, X_GEN_TAC (← q r"n:num") THEN DISCH_TAC] THEN
    REWRITE_TAC [singular_chain] THEN MATCH_MP_TAC FRAG_INDUCTION THEN
    REWRITE_TAC [← GSYM singular_chain] THENL
     [SIMP_TAC [FRAG_EXTEND_0, FRAG_EXTEND_SUB, FRAG_EXTEND_OF] THEN
      REWRITE_TAC [IN, SINGULAR_SIMPLEX_CHAIN_MAP_I],
      ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [singular_subdivision, FRAG_EXTEND_0] THEN
      MATCH_MP_TAC (← MESON [FRAG_EXTEND_0]
       (← q r"c = frag_0 ==> frag_0 = frag_extend f c")) THEN
      SPEC_TAC (← q r"n:num", ← q r"n:num") THEN
      INDUCT_TAC THEN ASM_REWRITE_TAC [ITER, FRAG_EXTEND_0],
      ALL_TAC,
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [FRAG_EXTEND_SUB] THEN
      SPEC_TAC (← q r"n:num", ← q r"n:num") THEN MATCH_MP_TAC num_INDUCTION THEN
      SIMP_TAC [ITER, singular_subdivision, ← GSYM FRAG_EXTEND_SUB]] THEN
    X_GEN_TAC (← q r"f:(num->real)->A") THEN GEN_REWRITE_TAC LAND_CONV [IN] THEN
    DISCH_TAC THEN REWRITE_TAC [FRAG_EXTEND_OF] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"frag_of(f:(num->real)->A)")) THEN
    ASM_REWRITE_TAC [SINGULAR_CHAIN_OF, FRAG_EXTEND_OF] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    MP_TAC (← ISPECL [← q r"p:num",
                      ← q r"subtopology (product_topology (:num) (\i. euclideanreal))
                                (standard_simplex p)",
                      ← q r"f:(num->real)->A"] NATURALITY_SINGULAR_SUBDIVISION) THEN
    DISCH_THEN (fun th =>
      W (MP_TAC o PART_MATCH (lhand o rand) th o rand o snd)) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [MATCH_MP_TAC SIMPLICIAL_IMP_SINGULAR_CHAIN THEN
      SPEC_TAC (← q r"n:num", ← q r"n:num") THEN
      INDUCT_TAC THEN REWRITE_TAC [ITER] THEN
      ASM_SIMP_TAC [SIMPLICIAL_CHAIN_OF, SIMPLICIAL_SIMPLEX_I, SUBSET_REFL] THEN
      MATCH_MP_TAC SIMPLICIAL_CHAIN_SIMPLICIAL_SUBDIVISION THEN
      ASM_REWRITE_TAC [],
      DISCH_THEN SUBST1_TAC] THEN
    AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC SINGULAR_SUBDIVISION_SIMPLICIAL_SIMPLEX THEN
    ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"standard_simplex p") THEN
    SPEC_TAC (← q r"n:num", ← q r"n:num") THEN INDUCT_TAC THEN
    SIMP_TAC [ITER, SIMPLICIAL_CHAIN_OF, SIMPLICIAL_SIMPLEX_I, SUBSET_REFL] THEN
    MATCH_MP_TAC SIMPLICIAL_CHAIN_SIMPLICIAL_SUBDIVISION THEN
    ASM_REWRITE_TAC [])

  let CHAIN_HOMOTOPIC_ITERATED_SINGULAR_SUBDIVISION ← prove
   r"!n. ?h:num->((num->real)->A)frag->((num->real)->A)frag.
        (!p. h p frag_0 = frag_0) /\
        (!p c1 c2. h p (frag_sub c1 c2) = frag_sub (h p c1) (h p c2)) /\
        (!p top c. singular_chain (p,top) c
                   ==> singular_chain (p + 1,top) (h p c)) /\
        (!p top c. singular_chain (p,top) c
                   ==> frag_add (chain_boundary (p + 1) (h p c))
                                (h (p - 1) (chain_boundary p c)) =
                       frag_sub (ITER n (singular_subdivision p) c) c)"
   (INDUCT_TAC THEN REWRITE_TAC [ITER] THENL
     [EXISTS_TAC
       (← q r"(\p x. frag_0):num->((num->real)->A)frag->((num->real)->A)frag") THEN
      REWRITE_TAC [SINGULAR_CHAIN_0, CHAIN_BOUNDARY_0] THEN
      REPEAT STRIP_TAC THEN CONV_TAC (fun t => FRAG_MODULE t),
      ALL_TAC] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN
     (← q r"k:num->((num->real)->A)frag->((num->real)->A)frag")
     STRIP_ASSUME_TAC) THEN
    X_CHOOSE_THEN
     (← q r"h:num->((num->real)->A)frag->((num->real)->A)frag")
     STRIP_ASSUME_TAC
     CHAIN_HOMOTOPIC_SINGULAR_SUBDIVISION THEN
    EXISTS_TAC
     (← q r"(\p c. frag_add (singular_subdivision (p + 1) (k p c)) (h p c))
      :num->((num->real)->A)frag->((num->real)->A)frag") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [REWRITE_TAC [SINGULAR_SUBDIVISION_0] THEN
      REPEAT STRIP_TAC THEN CONV_TAC (fun t => FRAG_MODULE t),
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [SINGULAR_SUBDIVISION_SUB] THEN
      REPEAT STRIP_TAC THEN CONV_TAC (fun t => FRAG_MODULE t),
      ALL_TAC] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"p:num", ← q r"top:A topology", ← q r"c:((num->real)->A)frag"] THEN
    ASM_SIMP_TAC [SINGULAR_CHAIN_ADD, SINGULAR_CHAIN_SINGULAR_SUBDIVISION] THEN
    DISCH_TAC THEN ONCE_REWRITE_TAC [← FRAG_MODULE
     (← q r"frag_sub (singular_subdivision p (ITER n (singular_subdivision p) c)) c =
      frag_add
       (frag_sub (singular_subdivision p (ITER n (singular_subdivision p) c))
                 (singular_subdivision p c))
       (frag_sub (singular_subdivision p c) c)")] THEN
    FIRST_X_ASSUM (fun th =>
     W (MP_TAC o PART_MATCH (rand o rand) th o rand o rand o snd)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← GSYM SINGULAR_SUBDIVISION_SUB] THEN
    FIRST_X_ASSUM (fun th =>
     W (MP_TAC o PART_MATCH (rand o rand) th o rand o lhand o rand o snd)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    SUBGOAL_THEN
     (← q r"singular_subdivision (p - 1 + 1) (k (p - 1) (chain_boundary p c)) =
      singular_subdivision p
        ((k:num->((num->real)->A)frag->((num->real)->A)frag) (p - 1)
        (chain_boundary p c))")
    SUBST1_TAC THENL
     [ASM_CASES_TAC (← q r"p = 0") THEN ASM_SIMP_TAC [SUB_ADD, LE_1] THEN
      ASM_REWRITE_TAC [chain_boundary, SINGULAR_SUBDIVISION_0],
      ALL_TAC] THEN
    REWRITE_TAC [CHAIN_BOUNDARY_ADD, SINGULAR_SUBDIVISION_ADD] THEN
    MP_TAC (← ISPECL [← q r"p + 1", ← q r"top:A topology"]
      CHAIN_BOUNDARY_SINGULAR_SUBDIVISION) THEN
    ASM_SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
    ASM_REWRITE_TAC [ADD_SUB] THEN
    REPEAT STRIP_TAC THEN CONV_TAC (fun t => FRAG_MODULE t))

  return { ITERATED_SINGULAR_SUBDIVISION, CHAIN_HOMOTOPIC_ITERATED_SINGULAR_SUBDIVISION }

/- ------------------------------------------------------------------------- -/
/- Sufficiently many iterated subdivisions make simplices small.             -/
/- (homology.ml 2917-3189)                                                   -/
/- ------------------------------------------------------------------------- -/

structure SIS where
  SUFFICIENT_ITERATED_SINGULAR_SUBDIVISION_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupSIS [HolBase] (D : HomologyDeps) (BSSX : SSX) (BSFC : SFC) (BSCH : SCH) (BSMP : SMP)
    (BSSC : SSC) (BSBD : SBD) (BSHR : SHR) (BSGS : SGS) (BITS : ITS) :
    ExceptT String IO SIS := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, .. } := D
  let { CARTESIAN_PRODUCT_UNIV, COND_EXPAND, COND_RAND, EMPTY_SUBSET, EXISTS_FINITE_SUBSET_IMAGE,
        EXISTS_IN_IMAGE, EXTENSIONAL_UNIV, FINITE_IMAGE, FINITE_INSERT, FINITE_NUMSEG_LE,
        FINITE_SUBSET, FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_IMAGE_2,
        FORALL_IN_INSERT, FORALL_IN_UNIONS, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_RESTRICTION,
        IMAGE_o, IMP_CONJ, IN, INTER_UNIV, .. } := D.core1
  let { IN_ELIM_THM, IN_SING, IN_UNIONS, IN_UNIV, I_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, MONO_FORALL, NOT_INSERT_EMPTY, NOT_IN_EMPTY, NOT_LT, .. } := D.core2
  let { REAL_ABS_POS, REAL_ARCH_POW_INV, REAL_LE_INF_FINITE, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ,
        REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_INF_FINITE, REAL_LT_LDIV_EQ,
        REAL_LT_RDIV_EQ, REAL_MUL_LZERO, REAL_POS, REAL_POW_MONO_INV, RESTRICTION,
        RIGHT_FORALL_IMP_THM, .. } := D.core3
  let { RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_EMPTY, SUBSET_REFL,
        SWAP_EXISTS_THM, UNIONS_0, UNIONS_IMAGE, cartesian_product, num_INDUCTION, o_DEF, o_THM,
        real_pow, .. } := D.core4
  let { ITER, IN_REAL_INTERVAL, .. } := D.lib
  let { FINITE_FRAG_SUPPORT, FRAG_SUPPORT_0, FRAG_SUPPORT_EQ_EMPTY, FRAG_SUPPORT_FRAG_EXTEND,
        FRAG_SUPPORT_OF, .. } := D.frag
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := D.met1
  let { OPEN_IN_CARTESIAN_PRODUCT_GEN, OPEN_IN_PRODUCT_TOPOLOGY_ALT, OPEN_IN_SUBTOPOLOGY, .. } :=
    D.met2
  let { REAL_OPEN_IN, REAL_OPEN_REAL_INTERVAL, REAL_OPEN_UNIV, TOPSPACE_EUCLIDEANREAL,
        TOPSPACE_PRODUCT_TOPOLOGY, TOPSPACE_SUBTOPOLOGY, compact_in, continuous_map, real_open,
        .. } := D.met3
  let { COMPACT_IN_STANDARD_SIMPLEX, NONEMPTY_STANDARD_SIMPLEX, standard_simplex, .. } := BSSX
  let { singular_simplex, .. } := BSFC
  let { SINGULAR_CHAIN_EMPTY, singular_chain, .. } := BSCH
  let { chain_map, simplex_map, .. } := BSMP
  let { SIMPLICIAL_CHAIN_OF, SIMPLICIAL_SIMPLEX, simplicial_chain, .. } := BSSC
  let { SIMPLICIAL_CHAIN_SIMPLICIAL_SUBDIVISION, .. } := BSBD
  let { SIMPLICIAL_SUBDIVISION_SHRINKS, .. } := BSHR
  let { SIMPLICIAL_SIMPLEX_I, SINGULAR_SUBDIVISION_0, .. } := BSGS
  let { ITERATED_SINGULAR_SUBDIVISION, .. } := BITS
  -- @@SCOPE END

  let SUFFICIENT_ITERATED_SINGULAR_SUBDIVISION_EXISTS ← do
    let llemma ← prove
     r"!p c. standard_simplex p SUBSET UNIONS c /\
             (!u. u IN c
                  ==> open_in (product_topology (:num) (\i. euclideanreal)) u)
             ==> ?d. &0 < d /\
                     !k. k SUBSET standard_simplex p /\
                         (!x y i.
                            x IN k /\ y IN k /\ i <= p ==> abs (x i - y i) <= d)
                         ==> ?u. u IN c /\ k SUBSET u"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!x. x IN standard_simplex p
            ==> ?e u. &0 < e /\ u IN c /\ x IN u /\
                      !y. (!i. i <= p ==> abs(y i - x i) <= &2 * e) /\
                          (!i. p < i ==> y i = &0)
                          ==> y IN u")
      MP_TAC THENL
       [REPEAT STRIP_TAC THEN GEN_REWRITE_TAC id [SWAP_EXISTS_THM] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->real") o REWRITE_RULE [SUBSET]) THEN
        ASM_REWRITE_TAC [IN_UNIONS] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"u:(num->real)->bool") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:(num->real)->bool")) THEN
        ASM_REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY_ALT] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real")) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, cartesian_product, IN_UNIV] THEN
        REWRITE_TAC [EXTENSIONAL_UNIV, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"v:num->(real->bool)") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o
          GEN_REWRITE_RULE BINDER_CONV [← GSYM REAL_OPEN_IN]) THEN
        REWRITE_TAC [real_open] THEN
        DISCH_THEN (MP_TAC o GEN (← q r"i:num") o
          SPECL [← q r"i:num", ← q r"(x:num->real) i"]) THEN
        ASM_REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
        X_GEN_TAC (← q r"d:num->real") THEN STRIP_TAC THEN EXISTS_TAC
         (← q r"inf ((&1) INSERT IMAGE (d:num->real) {i | ~(v i = (:real))}) / &3") THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&0 < x / &3 <=> &0 < x")] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"x <= &2 * y / &3 <=> &3 / &2 * x <= y")] THEN
        ASM_SIMP_TAC [REAL_LT_INF_FINITE, REAL_LE_INF_FINITE, NOT_INSERT_EMPTY,
                      FINITE_IMAGE, FINITE_INSERT] THEN
        ASM_SIMP_TAC [FORALL_IN_IMAGE, FORALL_IN_INSERT, REAL_LT_01] THEN
        X_GEN_TAC (← q r"y:num->real") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
        MP_TAC (← ASSUME (← q r"x IN standard_simplex p")) THEN
        REWRITE_TAC [IN_ELIM_THM, standard_simplex] THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"i:num") THEN
        ASM_CASES_TAC (← q r"p:num < i") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [NOT_LT]) THEN
        ASM_CASES_TAC (← q r"(v:num->real->bool) i = UNIV") THEN
        ASM_REWRITE_TAC [IN_UNIV] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&3 / &2 * x <= y /\ &0 < y ==> x < y")) THEN
        ASM_SIMP_TAC [],
        GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM]] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
       [← q r"e:(num->real)->real", ← q r"v:(num->real)->(num->real)->bool"] THEN
      DISCH_TAC THEN MP_TAC (← SPEC (← q r"p:num") COMPACT_IN_STANDARD_SIMPLEX) THEN
      REWRITE_TAC [compact_in] THEN DISCH_THEN (MP_TAC o
        SPEC (← q r"{cartesian_product (:num)
                (\i. if i <= p then real_interval(x i - e x,x i + e x)
                     else (:real)) | x | x IN standard_simplex p}") o
        CONJUNCT2) THEN
      REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [SUBSET, UNIONS_IMAGE, IN_ELIM_THM] THEN
        CONJ_TAC THEN X_GEN_TAC (← q r"x:num->real") THEN DISCH_TAC THENL
         [REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN DISJ2_TAC THEN
          REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN CONJ_TAC THENL
           [MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{i:num | i <= p}") THEN
            REWRITE_TAC [FINITE_NUMSEG_LE, SUBSET, IN_ELIM_THM] THEN MESON_TAC [],
            GEN_TAC THEN REWRITE_TAC [← GSYM REAL_OPEN_IN] THEN
            MESON_TAC [REAL_OPEN_REAL_INTERVAL, REAL_OPEN_UNIV]],
          EXISTS_TAC (← q r"x:num->real") THEN
          ASM_REWRITE_TAC [cartesian_product, IN_ELIM_THM, EXTENSIONAL_UNIV] THEN
          GEN_TAC THEN COND_CASES_TAC THEN REWRITE_TAC [IN_UNIV] THEN
          ASM_SIMP_TAC [IN_REAL_INTERVAL, ← REAL_ARITH
           (← q r"x - e < x /\ x < x + e <=> &0 < e")]],
        DISCH_THEN (X_CHOOSE_THEN (← q r"s:(num->real)->bool") MP_TAC)] THEN
      ASM_CASES_TAC (← q r"s:(num->real)->bool = {}") THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, UNIONS_0, SUBSET_EMPTY] THEN
      REWRITE_TAC [NONEMPTY_STANDARD_SIMPLEX] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"inf(IMAGE (e:(num->real)->real) s)") THEN
      ASM_SIMP_TAC [REAL_LT_INF_FINITE, REAL_LE_INF_FINITE,
                    FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"k:(num->real)->bool") THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"k:(num->real)->bool = {}") THENL
       [ASM_REWRITE_TAC [EMPTY_SUBSET] THEN
        ASM_MESON_TAC [MEMBER_NOT_EMPTY, NONEMPTY_STANDARD_SIMPLEX],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY])] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:num->real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"x IN standard_simplex p") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [UNIONS_IMAGE]) THEN
      GEN_REWRITE_TAC LAND_CONV [SUBSET] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real")) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, cartesian_product, EXTENSIONAL_UNIV] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:num->real")
       (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [IN_UNIV] THEN ONCE_REWRITE_TAC [COND_RAND] THEN
      REWRITE_TAC [COND_EXPAND, FORALL_AND_THM, IN_UNIV] THEN
      REWRITE_TAC [← TAUT (← q r"~p \/ q <=> p ==> q"), IN_REAL_INTERVAL] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a - e < x /\ x < a + e <=> abs(x - a) < e")] THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"(v:(num->real)->(num->real)->bool) a") THEN
      SUBGOAL_THEN (← q r"a IN standard_simplex p") (fun th => ASSUME_TAC th THEN
        FIRST_X_ASSUM (MP_TAC o C MATCH_MP th))
      THENL [ASM SET_TAC [], STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
      REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:num->real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      SUBGOAL_THEN (← q r"y IN standard_simplex p")
       (fun th => ASSUME_TAC th THEN MP_TAC th)
      THENL [ASM SET_TAC [], SIMP_TAC [standard_simplex, IN_ELIM_THM]] THEN
      DISCH_THEN (K ALL_TAC) THEN X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:num->real", ← q r"y:num->real", ← q r"i:num"]) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"a:num->real")) THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)
    prove
     r"!p top u c:((num->real)->A)frag.
          (!v. v IN u ==> open_in top v) /\
          topspace top SUBSET UNIONS u /\
          singular_chain (p,top) c
          ==> ?n. !m f. n <= m /\
                        f IN frag_support (ITER m (singular_subdivision p) c)
                        ==> ?v. v IN u /\ IMAGE f (standard_simplex p) SUBSET v"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c:((num->real)->A)frag = frag_0") THENL
       [STRIP_TAC THEN EXISTS_TAC (← q r"0") THEN
        SUBGOAL_THEN
         (← q r"!k. ITER k (singular_subdivision p) frag_0:((num->real)->A)frag =
              frag_0")
         (fun th => ASM_REWRITE_TAC [th, FRAG_SUPPORT_0, NOT_IN_EMPTY]) THEN
        INDUCT_TAC THEN ASM_REWRITE_TAC [ITER, SINGULAR_SUBDIVISION_0],
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THENL
       [ASM_MESON_TAC [SINGULAR_CHAIN_EMPTY], ALL_TAC] THEN
      ASM_CASES_TAC (← q r"u:(A->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [UNIONS_0, SUBSET_EMPTY] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?d. &0 < d /\
            !f k. f IN frag_support c /\ k SUBSET standard_simplex p /\
                 (!x y i. x IN k /\ y IN k /\ i <= p ==> abs(x i - y i) <= d)
                 ==> ?v. v IN u /\ IMAGE (f:(num->real)->A) k SUBSET v")
      STRIP_ASSUME_TAC THENL
       [SUBGOAL_THEN
         (← q r"!f:(num->real)->A.
              f IN frag_support c
              ==> ?e. &0 < e /\
                      !k. k SUBSET standard_simplex p /\
                          (!x y i. x IN k /\ y IN k /\ i <= p
                                   ==> abs(x i - y i) <= e)
                          ==> ?v. v IN u /\ IMAGE f k SUBSET v")
        MP_TAC THENL
         [REPEAT STRIP_TAC THEN
          SUBGOAL_THEN
           (← q r"!v. v IN u
                ==> ?t. open_in (product_topology (:num) (\i. euclideanreal)) t /\
                        {x | x IN standard_simplex p /\ (f:(num->real)->A) x IN v}
                        = t INTER standard_simplex p")
          MP_TAC THENL
           [REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM OPEN_IN_SUBTOPOLOGY] THEN
            FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [singular_chain]) THEN
            REWRITE_TAC [SUBSET] THEN
            DISCH_THEN (MP_TAC o SPEC (← q r"f:(num->real)->A")) THEN
            ASM_REWRITE_TAC [singular_simplex, IN, continuous_map] THEN
            DISCH_THEN (MP_TAC o SPEC (← q r"v:A->bool") o CONJUNCT2 o CONJUNCT1) THEN
            REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY] THEN
            REWRITE_TAC [o_DEF, TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV] THEN
            ASM_SIMP_TAC [INTER_UNIV],
            GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM]] THEN
          REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
          X_GEN_TAC (← q r"g:(A->bool)->((num->real)->bool)") THEN DISCH_TAC THEN
          MP_TAC (← SPECL
           [← q r"p:num", ← q r"IMAGE (g:(A->bool)->((num->real)->bool)) u"]
            llemma) THEN
          REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
          ASM_SIMP_TAC [UNIONS_IMAGE] THEN
          FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [singular_chain]) THEN
           REWRITE_TAC [SUBSET] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"f:(num->real)->A")) THEN
          ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC LAND_CONV [IN] THEN
          REWRITE_TAC [singular_simplex] THEN
          DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE o
                     CONJUNCT1) THEN
          REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY] THEN
          REWRITE_TAC [o_DEF, TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV] THEN
          REWRITE_TAC [INTER_UNIV] THEN DISCH_TAC THEN
          ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k:(num->real)->bool") THEN
          DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [],
          GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
          REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
          X_GEN_TAC (← q r"e:((num->real)->A)->real") THEN DISCH_TAC THEN
          EXISTS_TAC (← q r"inf {e f | (f:(num->real)->A) IN frag_support c}") THEN
          REWRITE_TAC [SIMPLE_IMAGE] THEN
          ASM_SIMP_TAC [REAL_LT_INF_FINITE, FINITE_FRAG_SUPPORT,
                        FRAG_SUPPORT_EQ_EMPTY, FINITE_IMAGE, IMAGE_EQ_EMPTY,
                        REAL_LE_INF_FINITE] THEN
          ASM_SIMP_TAC [FORALL_IN_IMAGE]],
        ALL_TAC] THEN
      MP_TAC (← SPECL [← q r"&p / (&p + &1)", ← q r"d:real"] REAL_ARCH_POW_INV) THEN
      SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_POS,
                ← REAL_ARITH (← q r"&0 <= x ==> &0 < x + &1"), REAL_ABS_POS] THEN
      ASM_REWRITE_TAC [REAL_MUL_LZERO] THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"m:num") THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      DISCH_TAC THEN
      ABBREV_TAC (← q r"c':((num->real)->A)frag = ITER m (singular_subdivision p) c") THEN
      MP_TAC (← ISPECL
       [← q r"p:num", ← q r"top:A topology", ← q r"m:num",
        ← q r"c:((num->real)->A)frag"] ITERATED_SINGULAR_SUBDIVISION) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      W (MP_TAC o PART_MATCH lhand FRAG_SUPPORT_FRAG_EXTEND o
        (fun t : term => do rand (← lhand (← HolCore.Basics.dest_forall t).2)) o snd) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. x IN s ==> P x) ==> top SUBSET s ==> (!x. x IN top ==> P x)")) THEN
      REWRITE_TAC [FORALL_IN_UNIONS] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"f:(num->real)->A") THEN DISCH_TAC THEN
      REWRITE_TAC [chain_map] THEN
      W (MP_TAC o PART_MATCH lhand FRAG_SUPPORT_FRAG_EXTEND o
        (fun t : term => do rand (← lhand (← HolCore.Basics.dest_forall t).2)) o snd) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. x IN s ==> P x) ==> top SUBSET s ==> (!x. x IN top ==> P x)")) THEN
      REWRITE_TAC [FORALL_IN_UNIONS] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [FRAG_SUPPORT_OF, o_THM, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
      SIMP_TAC [simplex_map, IMAGE_RESTRICTION, SUBSET_REFL] THEN
      X_GEN_TAC (← q r"d:(num->real)->(num->real)") THEN DISCH_THEN (LABEL_TAC "*") THEN
      REWRITE_TAC [IMAGE_o] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← MESON []
       (← q r"P /\ (!x y i. Q x y i) <=> !i. P /\ (!x y. Q x y i)")] THEN
      X_GEN_TAC (← q r"i:num") THEN
      SUBGOAL_THEN
       (← q r"!n. simplicial_chain (p,standard_simplex p)
             (ITER n (simplicial_subdivision p)
                            (frag_of (RESTRICTION (standard_simplex p) I))) /\
            !f x y.
              f IN frag_support(ITER n (simplicial_subdivision p)
                            (frag_of (RESTRICTION (standard_simplex p) I))) /\
              x IN standard_simplex p /\
              y IN standard_simplex p
              ==> abs (f x i - f y i) <= (&p / (&p + &1)) pow n")
      MP_TAC THENL
       [MATCH_MP_TAC num_INDUCTION THEN REWRITE_TAC [ITER] THEN CONJ_TAC THENL
         [REWRITE_TAC [SIMPLICIAL_CHAIN_OF, SIMPLICIAL_SIMPLEX_I, SUBSET_REFL] THEN
          SIMP_TAC [FRAG_SUPPORT_OF, IN_SING, RESTRICTION, real_pow, I_THM] THEN
          REWRITE_TAC [standard_simplex, IN_ELIM_THM] THEN
          MESON_TAC [← REAL_ARITH
           (← q r"&0 <= x /\ &0 <= y /\ x <= &1 /\ y <= &1 ==> abs(x - y) <= &1")],
          GEN_TAC THEN STRIP_TAC THEN
          ASM_SIMP_TAC [SIMPLICIAL_CHAIN_SIMPLICIAL_SUBDIVISION] THEN
          REWRITE_TAC [real_pow] THEN
          MATCH_MP_TAC SIMPLICIAL_SUBDIVISION_SHRINKS THEN ASM_MESON_TAC []],
        DISCH_THEN (MP_TAC o SPEC (← q r"m:num"))] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      REWRITE_TAC [simplicial_chain] THEN
      GEN_REWRITE_TAC LAND_CONV [SUBSET] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"d:(num->real)->(num->real)")) THEN
      ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC LAND_CONV [IN] THEN
      SIMP_TAC [SIMPLICIAL_SIMPLEX] THEN DISCH_THEN (K ALL_TAC) THEN
      ASM_CASES_TAC (← q r"i:num <= p") THEN ASM_REWRITE_TAC [FORALL_IN_IMAGE_2] THEN
      REPEAT STRIP_TAC THEN
      TRANS_TAC REAL_LE_TRANS (← q r"(&p / (&p + &1)) pow n") THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"(&p / (&p + &1)) pow m") THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC REAL_POW_MONO_INV THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ,
                    ← REAL_ARITH (← q r"&0 < &p + &1")] THEN
      REAL_ARITH_TAC)

  return { SUFFICIENT_ITERATED_SINGULAR_SUBDIVISION_EXISTS }

/- ------------------------------------------------------------------------- -/
/- Small homologous cycles and excised chains.  (homology.ml 3190-3337)      -/
/- ------------------------------------------------------------------------- -/

structure EXC where
  SMALL_HOMOLOGOUS_REL_RELCYCLE_EXISTS : thm
  EXCISED_CHAIN_EXISTS : thm
  EXCISED_RELCYCLE_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupEXC [HolBase] (D : HomologyDeps) (BSFC : SFC) (BSCH : SCH) (BMSR : MSR) (BRBD : RBD)
    (BHMR : HMR) (BBDB : BDB) (BSGS : SGS) (BSSS : SSS) (BCHG : CHG) (BSIS : SIS) :
    ExceptT String IO EXC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, SET_RULE, SET_TAC, FRAG_MODULE, .. } := D
  let { DISJ_SYM, EQ_SYM_EQ, EXISTS_IN_INSERT, FORALL_IN_INSERT, IMP_CONJ, IMP_CONJ_ALT, IN,
        INTER_SUBSET, .. } := D.core1
  let { IN_UNION, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, MONO_OR, NOT_IN_EMPTY, .. } :=
    D.core2
  let { SUBSET, SUBSET_INTER, SUBSET_TRANS, UNIONS_2, cong, .. } := D.core4
  let { ITER, .. } := D.lib
  let { FRAG_SPLIT, .. } := D.frag
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET, .. } := D.met1
  let { INTERIOR_OF_RESTRICT, INTERIOR_OF_SUBSET, OPEN_IN_INTERIOR_OF,
        OPEN_IN_SUBTOPOLOGY_DIFF_CLOSED, OPEN_IN_SUBTOPOLOGY_INTER_OPEN, .. } := D.met2
  let { SUBTOPOLOGY_RESTRICT, SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := D.met3
  let { SINGULAR_SIMPLEX_SUBTOPOLOGY, .. } := BSFC
  let { CHAIN_BOUNDARY_SUB, SINGULAR_CHAIN_0, SINGULAR_CHAIN_BOUNDARY, SINGULAR_CHAIN_SUB,
        SINGULAR_CHAIN_SUBTOPOLOGY, singular_chain, .. } := BSCH
  let { mod_subset, singular_relcycle, .. } := BMSR
  let { SINGULAR_CHAIN_IMP_RELBOUNDARY, SINGULAR_RELBOUNDARY_0, SINGULAR_RELBOUNDARY_SUB, .. } :=
    BRBD
  let { HOMOLOGOUS_REL_REFL, HOMOLOGOUS_REL_SUB, HOMOLOGOUS_REL_SYM, HOMOLOGOUS_REL_TRANS,
        homologous_rel, .. } := BHMR
  let { HOMOLOGOUS_REL_SINGULAR_RELCYCLE, .. } := BBDB
  let { SINGULAR_CHAIN_SINGULAR_SUBDIVISION, .. } := BSGS
  let { CHAIN_BOUNDARY_SINGULAR_SUBDIVISION, .. } := BSSS
  let { HOMOLOGOUS_REL_SINGULAR_SUBDIVISION, .. } := BCHG
  let { SUFFICIENT_ITERATED_SINGULAR_SUBDIVISION_EXISTS, .. } := BSIS
  -- @@SCOPE END

  let SMALL_HOMOLOGOUS_REL_RELCYCLE_EXISTS ← prove
   r"!p top s u c:((num->real)->A)frag.
        (!v. v IN u ==> open_in top v) /\ topspace top SUBSET UNIONS u /\
        singular_relcycle (p,top,s) c
        ==> ?c'. singular_relcycle (p,top,s) c' /\
                 homologous_rel (p,top,s) c c' /\
                 !f. f IN frag_support c'
                      ==> ?v. v IN u /\ IMAGE f (standard_simplex p) SUBSET v"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o REWRITE_RULE [singular_relcycle]) THEN
    MP_TAC (← ISPECL
     [← q r"p:num", ← q r"top:A topology", ← q r"u:(A->bool)->bool",
      ← q r"c:((num->real)->A)frag"]
     SUFFICIENT_ITERATED_SINGULAR_SUBDIVISION_EXISTS) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
    ABBREV_TAC (← q r"c':((num->real)->A)frag = ITER n (singular_subdivision p) c") THEN
    REWRITE_TAC [LE_REFL] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"c':((num->real)->A)frag") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"(q ==> p) /\ q ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [HOMOLOGOUS_REL_SINGULAR_RELCYCLE], ALL_TAC] THEN
    EXPAND_TAC "c'" THEN SPEC_TAC (← q r"n:num", ← q r"m:num") THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [ITER, HOMOLOGOUS_REL_REFL] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        HOMOLOGOUS_REL_TRANS)) THEN
    ONCE_REWRITE_TAC [HOMOLOGOUS_REL_SYM] THEN
    MATCH_MP_TAC HOMOLOGOUS_REL_SINGULAR_SUBDIVISION THEN
    ASM_MESON_TAC [HOMOLOGOUS_REL_SINGULAR_RELCYCLE])

  let EXCISED_CHAIN_EXISTS ← prove
   r"!p top s t u c:((num->real)->A)frag.
      top closure_of u SUBSET top interior_of t /\ t SUBSET s /\
      singular_chain(p,subtopology top s) c
      ==> ?n d e. singular_chain(p,subtopology top (s DIFF u)) d /\
                  singular_chain(p,subtopology top t) e /\
                  ITER n (singular_subdivision p) c = frag_add d e"
   (SUBGOAL_THEN
     (← q r"!p top s t u c:((num->real)->A)frag.
        top closure_of u SUBSET top interior_of t /\
        u SUBSET topspace top /\ t SUBSET s /\ s SUBSET topspace top /\
        singular_chain(p,subtopology top s) c
        ==> ?n d e. singular_chain(p,subtopology top (s DIFF u)) d /\
                    singular_chain(p,subtopology top t) e /\
                    ITER n (singular_subdivision p) c = frag_add d e")
    MP_TAC THENL
     [REPEAT STRIP_TAC,
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"p:num", ← q r"top:A topology", ← q r"topspace top INTER s:A->bool",
        ← q r"topspace top INTER t:A->bool", ← q r"topspace top INTER u:A->bool",
        ← q r"c:((num->real)->A)frag"]) THEN
      REWRITE_TAC [← SET_RULE (← q r"s INTER t DIFF s INTER u = s INTER (t DIFF u)")] THEN
      REWRITE_TAC [← GSYM SUBTOPOLOGY_RESTRICT, INTER_SUBSET] THEN
      ASM_REWRITE_TAC [← GSYM INTERIOR_OF_RESTRICT, ← GSYM CLOSURE_OF_RESTRICT] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM SET_TAC []] THEN
    MP_TAC (← ISPECL
     [← q r"p:num", ← q r"subtopology top (s:A->bool)",
      ← q r"{s INTER top interior_of t:A->bool,s DIFF top closure_of u}",
      ← q r"c:((num->real)->A)frag"]
     SUFFICIENT_ITERATED_SINGULAR_SUBDIVISION_EXISTS) THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
    ANTS_TAC THENL
     [SIMP_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN, OPEN_IN_INTERIOR_OF] THEN
      ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_DIFF_CLOSED, CLOSED_IN_CLOSURE_OF] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, UNIONS_2] THEN ASM SET_TAC [],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num")] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"n:num")) THEN REWRITE_TAC [LE_REFL] THEN
    ABBREV_TAC (← q r"c':((num->real)->A)frag = ITER n (singular_subdivision p) c") THEN
    REWRITE_TAC [EXISTS_IN_INSERT, NOT_IN_EMPTY] THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN REWRITE_TAC [singular_chain] THEN
    MATCH_MP_TAC FRAG_SPLIT THEN REWRITE_TAC [SUBSET, IN_UNION] THEN
    X_GEN_TAC (← q r"f:(num->real)->A") THEN DISCH_TAC THEN
    GEN_REWRITE_TAC id [DISJ_SYM] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:(num->real)->A")) THEN
    SUBGOAL_THEN (← q r"singular_chain(p,subtopology top s:A topology) c'")
    (MP_TAC o REWRITE_RULE [singular_chain, SUBSET]) THENL
     [EXPAND_TAC "c'" THEN SPEC_TAC (← q r"n:num", ← q r"m:num") THEN
      INDUCT_TAC THEN ASM_SIMP_TAC [ITER, SINGULAR_CHAIN_0] THEN
      ASM_SIMP_TAC [SINGULAR_CHAIN_SINGULAR_SUBDIVISION],
      DISCH_THEN (MP_TAC o SPEC (← q r"f:(num->real)->A")) THEN
      ASM_SIMP_TAC [IN, SINGULAR_SIMPLEX_SUBTOPOLOGY, SUBSET_INTER] THEN
      STRIP_TAC THEN MATCH_MP_TAC MONO_OR THEN CONJ_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
      REWRITE_TAC [INTERIOR_OF_SUBSET] THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"u:A->bool"] CLOSURE_OF_SUBSET) THEN
      ASM SET_TAC []])

  let EXCISED_RELCYCLE_EXISTS ← prove
   r"!p top s t u c:((num->real)->A)frag.
      top closure_of u SUBSET top interior_of t /\ t SUBSET s /\
      singular_relcycle (p,subtopology top s,t) c
      ==> ?c'. singular_relcycle (p,subtopology top (s DIFF u),t DIFF u) c' /\
               homologous_rel (p,subtopology top s,t) c c'"
   (REWRITE_TAC [singular_relcycle, cong, mod_subset] THEN
    REWRITE_TAC [IMP_CONJ, ← FRAG_MODULE (← q r"frag_sub x frag_0 = x")] THEN
    SIMP_TAC [SUBTOPOLOGY_SUBTOPOLOGY, ← SET_RULE
     (← q r"t SUBSET s
      ==> s INTER t = t /\ (s DIFF u) INTER (t DIFF u) = t DIFF u")] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"p:num", ← q r"top:A topology", ← q r"s:A->bool", ← q r"t:A->bool",
      ← q r"u:A->bool", ← q r"c:((num->real)->A)frag"]
     EXCISED_CHAIN_EXISTS) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
     [← q r"n:num", ← q r"d:((num->real)->A)frag", ← q r"e:((num->real)->A)frag"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"d:((num->real)->A)frag") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"singular_chain(p - 1,subtopology top (t:A->bool)) (chain_boundary p d) /\
        singular_chain(p - 1,subtopology top (s DIFF u)) (chain_boundary p d)")
      MP_TAC THENL
       [ASM_SIMP_TAC [SINGULAR_CHAIN_BOUNDARY] THEN
        FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP (← FRAG_MODULE
         (← q r"c' = frag_add d e ==> d = frag_sub c' e"))) THEN
        REWRITE_TAC [CHAIN_BOUNDARY_SUB] THEN
        MATCH_MP_TAC SINGULAR_CHAIN_SUB THEN
        ASM_SIMP_TAC [SINGULAR_CHAIN_BOUNDARY] THEN
        SPEC_TAC (← q r"n:num", ← q r"m:num") THEN INDUCT_TAC THEN
        ASM_REWRITE_TAC [ITER] THEN
        MP_TAC (← ISPECL [← q r"p:num", ← q r"subtopology top s:A topology",
                          ← q r"ITER m (singular_subdivision p) c:((num->real)->A)frag"]
          CHAIN_BOUNDARY_SINGULAR_SUBDIVISION) THEN
        ANTS_TAC THENL
         [SPEC_TAC (← q r"m:num", ← q r"r:num") THEN
          INDUCT_TAC THEN ASM_SIMP_TAC [SINGULAR_CHAIN_0, ITER] THEN
          ASM_SIMP_TAC [SINGULAR_CHAIN_SINGULAR_SUBDIVISION],
          DISCH_THEN SUBST1_TAC] THEN
        ASM_SIMP_TAC [SINGULAR_CHAIN_SINGULAR_SUBDIVISION],
        REWRITE_TAC [SINGULAR_CHAIN_SUBTOPOLOGY] THEN ASM SET_TAC []],
      FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP (← FRAG_MODULE
         (← q r"c' = frag_add d e ==> d = frag_sub c' e"))) THEN
      GEN_REWRITE_TAC LAND_CONV [← FRAG_MODULE (← q r"x = frag_sub x frag_0")] THEN
      MATCH_MP_TAC HOMOLOGOUS_REL_SUB THEN CONJ_TAC THENL
       [SPEC_TAC (← q r"n:num", ← q r"m:num") THEN INDUCT_TAC THEN
        ASM_REWRITE_TAC [ITER, HOMOLOGOUS_REL_REFL] THEN
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOLOGOUS_REL_TRANS)) THEN
        ONCE_REWRITE_TAC [HOMOLOGOUS_REL_SYM] THEN
        MATCH_MP_TAC HOMOLOGOUS_REL_SINGULAR_SUBDIVISION THEN
        FIRST_ASSUM (SUBST1_TAC o SYM o
         MATCH_MP HOMOLOGOUS_REL_SINGULAR_RELCYCLE) THEN
        REWRITE_TAC [singular_relcycle, cong, mod_subset] THEN
        ASM_REWRITE_TAC [← FRAG_MODULE (← q r"frag_sub x frag_0 = x")],
        REWRITE_TAC [homologous_rel] THEN
        MATCH_MP_TAC SINGULAR_RELBOUNDARY_SUB THEN
        REWRITE_TAC [SINGULAR_RELBOUNDARY_0] THEN
        MATCH_MP_TAC SINGULAR_CHAIN_IMP_RELBOUNDARY] THEN
      ASM_SIMP_TAC [SUBTOPOLOGY_SUBTOPOLOGY, ← SET_RULE
         (← q r"t SUBSET s ==> s INTER t = t")]])

  return { SMALL_HOMOLOGOUS_REL_RELCYCLE_EXISTS, EXCISED_CHAIN_EXISTS, EXCISED_RELCYCLE_EXISTS }

