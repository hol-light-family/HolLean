        X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [o_THM]] THEN
      EXPAND_TAC "simp" THEN
      REWRITE_TAC [oriented_simplex, RESTRICTION] THEN
      ASM_SIMP_TAC [SUB_ADD, LE_1] THEN
      ASM_SIMP_TAC [SIMPLICIAL_FACE_IN_STANDARD_SIMPLEX, ADD_SUB,
                    LE_ADD_RCANCEL, ← ARITH_RULE (← q r"1 <= j + 1")] THEN
      MAP_EVERY EXPAND_TAC ["vv", "ww"] THEN
      REWRITE_TAC [simplicial_face, o_DEF] THEN
      ONCE_REWRITE_TAC [COND_RATOR] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"~(0 = k + 1)"), NOT_SUC] THENL
       [ONCE_REWRITE_TAC [← MESON []
         (← q r"(if p then x else y) * z:real = if p then x * z else y * z")] THEN
        SIMP_TAC [REAL_MUL_LZERO, FINITE_NUMSEG, SUM_CASES, SUM_0] THEN
        REWRITE_TAC [REAL_MUL_LID, REAL_ADD_LID] THEN
        SIMP_TAC [SUM_CASES, FINITE_NUMSEG, FINITE_RESTRICT] THEN
        REWRITE_TAC [SUM_0, REAL_ADD_LID] THEN
        REWRITE_TAC [IN_ELIM_THM, IN_NUMSEG, LE_1, NOT_LE, LE_0, NOT_LT] THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
        W (MP_TAC o PART_MATCH (rand o rand) SUM_IMAGE o rand o lhand o snd) THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        ANTS_TAC THENL [ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
        REWRITE_TAC [IMAGE, IN_ELIM_THM, ← ARITH_RULE
         (← q r"(((x <= q + 1 /\ i < x) /\ j + 1 <= x) /\ ~(x = j + 1)) /\ y = x - 1
          <=> x = y + 1 /\ y <= q /\ i <= y /\ j < y")] THEN
        REWRITE_TAC [UNWIND_THM2, ← GSYM CONJ_ASSOC] THEN
        W (MP_TAC o PART_MATCH (rand o rand) SUM_UNION o lhand o snd) THEN
        ANTS_TAC THENL
         [REWRITE_TAC [CONJ_ASSOC, DISJOINT, EXTENSION, IN_ELIM_THM,
                       NOT_IN_EMPTY, IN_INTER, IN_ELIM_THM] THEN
          CONJ_TAC THENL [ALL_TAC, ARITH_TAC] THEN CONJ_TAC THEN
          MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"0..q+1") THEN
          REWRITE_TAC [FINITE_NUMSEG, SUBSET, IN_NUMSEG, IN_ELIM_THM] THEN
          ARITH_TAC,
          DISCH_THEN (SUBST1_TAC o SYM)] THEN
        REWRITE_TAC [ETA_AX] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [EXTENSION, IN_UNION, IN_ELIM_THM] THEN ASM_ARITH_TAC,
        ASM_CASES_TAC (← q r"k:num = j") THEN ASM_REWRITE_TAC [LT_REFL] THENL
         [MATCH_MP_TAC SUM_EQ_0_NUMSEG THEN X_GEN_TAC (← q r"m:num") THEN STRIP_TAC THEN
          REWRITE_TAC [] THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_ARITH_TAC,
          ALL_TAC] THEN
        REWRITE_TAC [← MESON []
         (← q r"(if p then if q then a else b else if r then a else b) =
          (if p /\ q \/ ~p /\ r then a else b)")] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH
         (← q r"(if p then a else b) * x:real = if p then a * x else b * x")] THEN
        REWRITE_TAC [REAL_MUL_LZERO, ← GSYM SUM_RESTRICT_SET, REAL_MUL_LID] THEN
        SIMP_TAC [SUM_CASES, FINITE_NUMSEG, FINITE_RESTRICT] THEN
        REWRITE_TAC [SUM_0, REAL_ADD_LID] THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
        W (MP_TAC o PART_MATCH (rand o rand) SUM_IMAGE o rand o lhand o snd) THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        ANTS_TAC THENL [ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
        REWRITE_TAC [IN_NUMSEG, ADD1, EQ_ADD_RCANCEL, IN_ELIM_THM] THEN
        REWRITE_TAC [← GSYM CONJ_ASSOC, LE_0, NOT_LE, NOT_LT] THEN
        REWRITE_TAC [IMAGE, IN_ELIM_THM, ← ARITH_RULE
         (← q r"j:num <= k /\ ~(k = j) <=> j < k")] THEN
        REWRITE_TAC [← GSYM CONJ_ASSOC, ← ARITH_RULE
         (← q r"j + 1 < k /\ m = k - 1 <=> j < m /\ k = m + 1")] THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> s /\ p /\ q /\ r")] THEN
        REWRITE_TAC [UNWIND_THM2, ETA_AX] THEN
        W (MP_TAC o PART_MATCH (rand o rand) SUM_UNION o lhand o snd) THEN
        ANTS_TAC THENL
         [REWRITE_TAC [CONJ_ASSOC, DISJOINT, EXTENSION, IN_ELIM_THM,
                       NOT_IN_EMPTY, IN_INTER, IN_ELIM_THM] THEN
          CONJ_TAC THENL [ALL_TAC, ARITH_TAC] THEN CONJ_TAC THEN
          MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"0..q+1") THEN
          REWRITE_TAC [FINITE_NUMSEG, SUBSET, IN_NUMSEG, IN_ELIM_THM] THEN
          ARITH_TAC,
          DISCH_THEN (SUBST1_TAC o SYM)] THEN
        ASM_CASES_TAC (← q r"k:num < j") THEN ASM_REWRITE_TAC [] THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [EXTENSION, IN_UNION, IN_ELIM_THM, ADD_SUB] THEN
        REWRITE_TAC [← ARITH_RULE (← q r"i < j /\ k = j - 1 <=> i < j /\ j = k + 1")] THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN
        SUBGOAL_THEN (← q r"1 <= k") MP_TAC THENL
         [ASM_ARITH_TAC, SIMP_TAC [SUB_ADD]] THEN
        SIMP_TAC [← ARITH_RULE (← q r"1 <= k ==> (k - 1 = j <=> k = j + 1)")] THEN
        ASM_ARITH_TAC]])

  return { HOMOTOPIC_IMP_HOMOLOGOUS_REL_CHAIN_MAPS }

/- ------------------------------------------------------------------------- -/
/- Now actually connect to group theory and set up homology groups. Note     -/
/- that we define homomogy groups for all *integers* p, since this seems to  -/
/- avoid some special-case reasoning, though they are trivial for p < 0.     -/
/- (homology.ml 3967-4121)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HGP where
  chain_group : thm
  CHAIN_GROUP : thm
  ABELIAN_CHAIN_GROUP : thm
  SUBGROUP_SINGULAR_RELCYCLE : thm
  relcycle_group : thm
  RELCYCLE_GROUP : thm
  ABELIAN_RELCYCLE_GROUP : thm
  RELCYCLE_GROUP_RESTRICT : thm
  relative_homology_group : thm
  homology_group : thm
  RELATIVE_HOMOLOGY_GROUP_RESTRICT : thm
  NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP : thm
  TRIVIAL_RELATIVE_HOMOLOGY_GROUP : thm
  SUBGROUP_SINGULAR_RELBOUNDARY : thm
  SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE : thm
  NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE : thm
  RIGHT_COSET_SINGULAR_RELBOUNDARY : thm
  RELATIVE_HOMOLOGY_GROUP : thm
  HOMOLOGOUS_REL_EQ_RELBOUNDARY : thm
  deriving Inhabited

@[nospecialize]
def setupHGP [HolBase] (D : HomologyDeps) (BSCH : SCH) (BMSR : MSR) (BRBD : RBD) (BHMR : HMR)
    (BBDB : BDB) : ExceptT String IO HGP := do
  -- @@SCOPE BEGIN
  let { new_definition, INT_ARITH, MESON_TAC, SET_RULE, SET_TAC, FRAG_MODULE, .. } := D
  let { AND_FORALL_THM, EXTENSION, FUN_EQ_THM, IN, .. } := D.core1
  let { IN_ELIM_THM, IN_IMAGE, NUM_OF_INT_OF_NUM, .. } := D.core2
  let { SUBSET, UNWIND_THM2, .. } := D.core4
  let { ABELIAN_FREE_ABELIAN_GROUP, ABELIAN_GROUP_NORMAL_SUBGROUP, ABELIAN_SUBGROUP_GENERATED,
        CARRIER_SUBGROUP_GENERATED_SUBGROUP, FREE_ABELIAN_GROUP, .. } := D.grp1
  let { QUOTIENT_GROUP, SUBGROUP_GENERATED, SUBGROUP_OF_SUBGROUP_GENERATED,
        TRIVIAL_GROUP_SINGLETON_GROUP, group_setinv, group_setmul, right_coset, subgroup_of,
        .. } := D.grp2
  let { singular_chain, .. } := BSCH
  let { SINGULAR_RELCYCLE_0, SINGULAR_RELCYCLE_ADD, SINGULAR_RELCYCLE_NEG,
        SINGULAR_RELCYCLE_RESTRICT, singular_relcycle, .. } := BMSR
  let { SINGULAR_RELBOUNDARY_0, SINGULAR_RELBOUNDARY_ADD, SINGULAR_RELBOUNDARY_IMP_CHAIN,
        SINGULAR_RELBOUNDARY_NEG, SINGULAR_RELBOUNDARY_RESTRICT, SINGULAR_RELBOUNDARY_SUB, .. } :=
    BRBD
  let { homologous_rel, .. } := BHMR
  let { SINGULAR_RELBOUNDARY_IMP_RELCYCLE, .. } := BBDB
  -- @@SCOPE END

  let chain_group ← new_definition
   r"chain_group (p,top:A topology) =
  free_abelian_group (singular_simplex(p,top))"

  let CHAIN_GROUP ← prove
   r"(!p top:A topology.
        group_carrier(chain_group(p,top)) = singular_chain(p,top)) /\
   (!p top:A topology. group_id(chain_group(p,top)) = frag_0) /\
   (!p top:A topology. group_inv(chain_group(p,top)) = frag_neg) /\
   (!p top:A topology. group_mul(chain_group(p,top)) = frag_add)"
   (REWRITE_TAC [chain_group, FREE_ABELIAN_GROUP] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN REWRITE_TAC [IN, singular_chain])

  let ABELIAN_CHAIN_GROUP ← prove
   r"!p top:A topology. abelian_group(chain_group (p,top))"
   (REWRITE_TAC [chain_group, ABELIAN_FREE_ABELIAN_GROUP])

  let SUBGROUP_SINGULAR_RELCYCLE ← prove
   r"!p top s:A->bool.
        singular_relcycle(p,top,s) subgroup_of chain_group(p,top)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [subgroup_of, CHAIN_GROUP] THEN
    REWRITE_TAC [SUBSET, IN, SINGULAR_RELCYCLE_0] THEN
    REWRITE_TAC [SINGULAR_RELCYCLE_ADD, SINGULAR_RELCYCLE_NEG] THEN
    SIMP_TAC [singular_relcycle])

  let relcycle_group ← new_definition
   r"relcycle_group(p,top:A topology,s) =
        subgroup_generated (chain_group(p,top)) (singular_relcycle(p,top,s))"

  let RELCYCLE_GROUP ← prove
   r"(!p top s:A->bool. group_carrier(relcycle_group(p,top,s)) =
                      singular_relcycle(p,top,s)) /\
   (!p top s:A->bool. group_id(relcycle_group(p,top,s)) = frag_0) /\
   (!p top s:A->bool. group_inv(relcycle_group(p,top,s)) = frag_neg) /\
   (!p top s:A->bool. group_mul(relcycle_group(p,top,s)) = frag_add)"
   (SIMP_TAC [relcycle_group, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
              SUBGROUP_SINGULAR_RELCYCLE] THEN
    REWRITE_TAC [SUBGROUP_GENERATED, CHAIN_GROUP])

  let ABELIAN_RELCYCLE_GROUP ← prove
   r"!p top s:A->bool. abelian_group(relcycle_group(p,top,s))"
   (SIMP_TAC [relcycle_group, ABELIAN_SUBGROUP_GENERATED,
              ABELIAN_CHAIN_GROUP])

  let RELCYCLE_GROUP_RESTRICT ← prove
   r"!p top s:A->bool.
        relcycle_group(p,top,s) =
        relcycle_group(p,top,topspace top INTER s)"
   (REWRITE_TAC [relcycle_group, ← GSYM SINGULAR_RELCYCLE_RESTRICT])

  let relative_homology_group ← new_definition
   r"relative_homology_group(p,top:A topology,s) =
        if p < &0 then singleton_group ARB else
        quotient_group (relcycle_group(num_of_int p,top,s))
                       (singular_relboundary(num_of_int p,top,s))"

  let homology_group ← new_definition
   r"homology_group(p,top:A topology) = relative_homology_group(p,top,{})"

  let RELATIVE_HOMOLOGY_GROUP_RESTRICT ← prove
   r"!p top s:A->bool.
        relative_homology_group(p,top,s) =
        relative_homology_group(p,top,topspace top INTER s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [relative_homology_group] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [relcycle_group] THEN
    REWRITE_TAC [← GSYM SINGULAR_RELBOUNDARY_RESTRICT,
                 ← GSYM SINGULAR_RELCYCLE_RESTRICT])

  let NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP ← prove
   r"!p top s:A->bool.
        relative_homology_group(&p,top,s) =
        quotient_group (relcycle_group(p,top,s))
                       (singular_relboundary(p,top,s))"
   (REWRITE_TAC [relative_homology_group, ← INT_ARITH (← q r"~(&p:int < &0)")] THEN
    REWRITE_TAC [NUM_OF_INT_OF_NUM])

  let TRIVIAL_RELATIVE_HOMOLOGY_GROUP ← prove
   r"!p top s:A->bool.
        p < &0 ==> trivial_group(relative_homology_group(p,top,s))"
   (SIMP_TAC [relative_homology_group, TRIVIAL_GROUP_SINGLETON_GROUP])

  let SUBGROUP_SINGULAR_RELBOUNDARY ← prove
   r"!p top s:A->bool.
        singular_relboundary(p,top,s) subgroup_of chain_group(p,top)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [subgroup_of, CHAIN_GROUP] THEN
    REWRITE_TAC [SUBSET, IN, SINGULAR_RELBOUNDARY_0] THEN
    REWRITE_TAC [SINGULAR_RELBOUNDARY_ADD, SINGULAR_RELBOUNDARY_NEG] THEN
    REWRITE_TAC [SINGULAR_RELBOUNDARY_IMP_CHAIN])

  let SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE ← prove
   r"!p top s:A->bool.
        singular_relboundary(p,top,s) subgroup_of relcycle_group(p,top,s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [relcycle_group] THEN
    MATCH_MP_TAC SUBGROUP_OF_SUBGROUP_GENERATED THEN
    REWRITE_TAC [SUBGROUP_SINGULAR_RELBOUNDARY, SUBSET, IN] THEN
    REWRITE_TAC [SINGULAR_RELBOUNDARY_IMP_RELCYCLE])

  let NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE ← prove
   r"!p top s:A->bool.
     singular_relboundary(p,top,s) normal_subgroup_of relcycle_group(p,top,s)"
   (SIMP_TAC [ABELIAN_GROUP_NORMAL_SUBGROUP, ABELIAN_RELCYCLE_GROUP,
              SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE])

  let RIGHT_COSET_SINGULAR_RELBOUNDARY ← prove
   r"!p top s:A->bool.
      right_coset (relcycle_group(p,top,s)) (singular_relboundary (p,top,s)) =
      homologous_rel (p,top,s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"c1:((num->real)->A)frag", ← q r"c2:((num->real)->A)frag"] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM IN] THEN
    REWRITE_TAC [right_coset, homologous_rel, group_setmul] THEN
    REWRITE_TAC [IN_IMAGE, RELCYCLE_GROUP, ← SET_RULE
     (← q r"{f x y | x IN s /\ y IN {a}} = IMAGE (\x. f x a) s")] THEN
    REWRITE_TAC [UNWIND_THM2, ← FRAG_MODULE
     (← q r"c2 = frag_add x c1 <=> x = frag_neg(frag_sub c1 c2)")] THEN
    REWRITE_TAC [IN, SINGULAR_RELBOUNDARY_NEG])

  let RELATIVE_HOMOLOGY_GROUP ← prove
   r"(!p top s:A->bool.
        group_carrier(relative_homology_group(&p,top,s)) =
        {homologous_rel (p,top,s) c | c | singular_relcycle (p,top,s) c}) /\
   (!p top s:A->bool.
        group_id(relative_homology_group(&p,top,s)) =
        singular_relboundary (p,top,s)) /\
   (!p top s:A->bool.
        group_inv(relative_homology_group(&p,top,s)) =
        \r. {frag_neg c | c IN r}) /\
   (!p top s:A->bool.
        group_mul(relative_homology_group(&p,top,s)) =
        \r1 r2. {frag_add c1 c2 | c1 IN r1 /\ c2 IN r2})"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP] THEN
    SIMP_TAC [QUOTIENT_GROUP, RIGHT_COSET_SINGULAR_RELBOUNDARY, RELCYCLE_GROUP,
              NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE] THEN
    CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [group_setinv, group_setmul, RELCYCLE_GROUP, FUN_EQ_THM])

  let HOMOLOGOUS_REL_EQ_RELBOUNDARY ← prove
   r"!p top (s:A->bool) c.
        homologous_rel(p,top,s) c = singular_relboundary(p,top,s) <=>
        singular_relboundary(p,top,s) c"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FUN_EQ_THM, homologous_rel] THEN
    MESON_TAC [SINGULAR_RELBOUNDARY_SUB, SINGULAR_RELBOUNDARY_0,
        ← FRAG_MODULE (← q r"frag_sub c c:((num->real)->A)frag = frag_0"),
        ← FRAG_MODULE (← q r"d:((num->real)->A)frag = frag_sub c (frag_sub c d)")])

  return { chain_group, CHAIN_GROUP, ABELIAN_CHAIN_GROUP, SUBGROUP_SINGULAR_RELCYCLE,
           relcycle_group, RELCYCLE_GROUP, ABELIAN_RELCYCLE_GROUP, RELCYCLE_GROUP_RESTRICT,
           relative_homology_group, homology_group, RELATIVE_HOMOLOGY_GROUP_RESTRICT,
           NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP, TRIVIAL_RELATIVE_HOMOLOGY_GROUP,
           SUBGROUP_SINGULAR_RELBOUNDARY, SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE,
           NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE, RIGHT_COSET_SINGULAR_RELBOUNDARY,
           RELATIVE_HOMOLOGY_GROUP, HOMOLOGOUS_REL_EQ_RELBOUNDARY }

/- ------------------------------------------------------------------------- -/
/- Lift the boundary and induced maps to homology groups. We totalize both   -/
/- quite aggressively to the appropriate group identity in all "undefined"   -/
/- situations, which makes several of the properties cleaner and simpler.    -/
/- (homology.ml 4122-4295)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HBD where
  GROUP_HOMOMORPHISM_CHAIN_BOUNDARY : thm
  HOM_BOUNDARY_DEFAULT : thm
  GROUP_HOMOMORPHISM_HOM_BOUNDARY : thm
  HOM_BOUNDARY_CHAIN_BOUNDARY : thm
  HOM_BOUNDARY_RESTRICT : thm
  HOM_BOUNDARY : thm
  HOM_BOUNDARY_TRIVIAL : thm
  deriving Inhabited

@[nospecialize]
def setupHBD [HolBase] (D : HomologyDeps) (BSCH : SCH) (BMSR : MSR) (BRBD : RBD) (BHMR : HMR)
    (BBDB : BDB) (BHGP : HGP) : ExceptT String IO HBD := do
  -- @@SCOPE BEGIN
  let { new_specification, ARITH_RULE, ASM_MESON_TAC, INT_ARITH, MESON, SET_RULE, SET_TAC,
        FRAG_MODULE, INTRO_TAC, .. } := D
  let { CONJ_ASSOC, EXISTS_CURRY, FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, IMP_CONJ,
        IMP_CONJ_ALT, IN, .. } := D.core1
  let { INT_OF_NUM_LE, INT_OF_NUM_OF_INT, INT_OF_NUM_SUB, IN_SING, LEFT_IMP_EXISTS_THM, LE_1,
        MONO_EXISTS, MONO_FORALL, NUM_OF_INT_OF_NUM, .. } := D.core2
  let { SKOLEM_THM, SUBSET, SUB_ADD, cong, o_DEF, o_THM, .. } := D.core4
  let { GROUP_HOMOMORPHISM_COMPOSE, GROUP_HOMOMORPHISM_EQ, GROUP_HOMOMORPHISM_RIGHT_COSET,
        GROUP_ID, .. } := D.grp1
  let { QUOTIENT_GROUP_UNIVERSAL_EXPLICIT, SINGLETON_GROUP, group_homomorphism, .. } := D.grp2
  let { SUBTOPOLOGY_RESTRICT, .. } := D.met3
  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_ADD, CHAIN_BOUNDARY_NEG, CHAIN_BOUNDARY_SUB,
        SINGULAR_CHAIN_0, SINGULAR_CHAIN_NEG, chain_boundary, .. } := BSCH
  let { SINGULAR_RELCYCLE_RESTRICT, mod_subset, singular_relcycle, .. } := BMSR
  let { SINGULAR_BOUNDARY, SINGULAR_RELBOUNDARY_0, singular_relboundary, .. } := BRBD
  let { HOMOLOGOUS_REL_EQ, HOMOLOGOUS_REL_RESTRICT, homologous_rel, .. } := BHMR
  let { CHAIN_BOUNDARY_BOUNDARY, CHAIN_BOUNDARY_BOUNDARY_ALT, .. } := BBDB
  let { NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP, NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE,
        RELATIVE_HOMOLOGY_GROUP, RELATIVE_HOMOLOGY_GROUP_RESTRICT, RELCYCLE_GROUP,
        RIGHT_COSET_SINGULAR_RELBOUNDARY, homology_group, relative_homology_group, .. } := BHGP
  -- @@SCOPE END

  let GROUP_HOMOMORPHISM_CHAIN_BOUNDARY ← prove
   r"!p top s:A->bool.
     group_homomorphism (relcycle_group(p,top,s),
                         relcycle_group(p-1,subtopology top s,{}))
                        (chain_boundary p)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [group_homomorphism, RELCYCLE_GROUP, CHAIN_BOUNDARY_0, SUBSET] THEN
    REWRITE_TAC [CHAIN_BOUNDARY_NEG, CHAIN_BOUNDARY_ADD, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN, singular_relcycle] THEN
    X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN
    SIMP_TAC [cong, mod_subset, ← FRAG_MODULE (← q r"frag_sub x frag_0 = x")] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP CHAIN_BOUNDARY_BOUNDARY o CONJUNCT1) THEN
    REWRITE_TAC [SINGULAR_CHAIN_0])

  let (HOM_BOUNDARY_DEFAULT, GROUP_HOMOMORPHISM_HOM_BOUNDARY, HOM_BOUNDARY_CHAIN_BOUNDARY,
       HOM_BOUNDARY_RESTRICT, HOM_BOUNDARY, HOM_BOUNDARY_TRIVIAL) ← do
    let oth ← prove
     r"?d. !p (top:A topology) s.
            group_homomorphism
             (relative_homology_group (&p,top,s),
              homology_group (&(p - 1),subtopology top s))
             (d p (top,s)) /\
            !c. singular_relcycle (p,top,s) c
                ==> d p (top,s) (homologous_rel (p,top,s) c) =
                    homologous_rel (p - 1,subtopology top s,{})
                                   (chain_boundary p c)"
     (REWRITE_TAC [homology_group] THEN REWRITE_TAC [← GSYM SKOLEM_THM] THEN
      REWRITE_TAC [EXISTS_CURRY] THEN REWRITE_TAC [← GSYM SKOLEM_THM] THEN
      REPEAT GEN_TAC THEN MP_TAC (← ISPECL
       [← q r"relcycle_group(p,top:A topology,s)",
        ← q r"relative_homology_group(&(p-1),subtopology top s:A topology,{})",
        ← q r"singular_relboundary(p,top:A topology,s)",
        ← q r"right_coset (relcycle_group(p-1,subtopology top s:A topology,{}))
                     (singular_relboundary(p - 1,subtopology top s,{})) o
         (chain_boundary p:((num->real)->A)frag->((num->real)->A)frag)"]
            QUOTIENT_GROUP_UNIVERSAL_EXPLICIT) THEN
      REWRITE_TAC [← GSYM NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP] THEN
      GEN_REWRITE_TAC LAND_CONV [IMP_CONJ] THEN ANTS_TAC THENL
       [MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE THEN
        EXISTS_TAC (← q r"relcycle_group (p-1,subtopology top s:A topology,{})") THEN
        REWRITE_TAC [NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP] THEN
        ASM_SIMP_TAC [GROUP_HOMOMORPHISM_RIGHT_COSET,
                      NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE] THEN
        REWRITE_TAC [GROUP_HOMOMORPHISM_CHAIN_BOUNDARY],
        REWRITE_TAC [NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE]] THEN
      REWRITE_TAC [RIGHT_COSET_SINGULAR_RELBOUNDARY] THEN
      REWRITE_TAC [RELCYCLE_GROUP] THEN ANTS_TAC THENL
       [ALL_TAC, REWRITE_TAC [IN, o_THM]] THEN
      REWRITE_TAC [HOMOLOGOUS_REL_EQ, o_DEF] THEN
      REWRITE_TAC [homologous_rel, ← GSYM CHAIN_BOUNDARY_SUB] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"c1:((num->real)->A)frag", ← q r"c2:((num->real)->A)frag"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 (K ALL_TAC : thm → tactic) MP_TAC)) THEN
      SPEC_TAC (← q r"frag_sub c1 c2:((num->real)->A)frag",
                ← q r"c:((num->real)->A)frag") THEN
      GEN_TAC THEN ASM_CASES_TAC (← q r"p = 0") THENL
       [ASM_REWRITE_TAC [chain_boundary, SINGULAR_RELBOUNDARY_0], ALL_TAC] THEN
      REWRITE_TAC [singular_relboundary, SINGULAR_BOUNDARY] THEN
      ASM_SIMP_TAC [SUB_ADD, LE_1, cong, mod_subset] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:((num->real)->A)frag") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"frag_neg(frag_sub (chain_boundary (p + 1) d) c):
                  ((num->real)->A)frag") THEN
      ASM_SIMP_TAC [SINGULAR_CHAIN_NEG] THEN
      REWRITE_TAC [CHAIN_BOUNDARY_SUB, CHAIN_BOUNDARY_NEG] THEN
      REWRITE_TAC [← FRAG_MODULE (← q r"frag_neg(frag_sub x y) = y <=> x = frag_0")] THEN
      ASM_MESON_TAC [CHAIN_BOUNDARY_BOUNDARY_ALT])
    let eth ← prove
     r"?d. (!p (top:A topology) s.
              group_homomorphism
               (relative_homology_group (p,top,s),
                homology_group (p - &1,subtopology top s))
               (d p (top,s))) /\
           (!p (top:A topology) s c.
                singular_relcycle (p,top,s) c /\ 1 <= p
                ==> d (&p) (top,s) (homologous_rel (p,top,s) c) =
                    homologous_rel (p - 1,subtopology top s,{})
                                   (chain_boundary p c)) /\
           (!p. p <= &0 ==> d p = \q r. ARB)"
     (MATCH_MP_TAC (← MESON []
      (← q r"(?f. P(\p. if p <= &0 then \q r. ARB else f(num_of_int p)))
       ==> ?f. P f")) THEN
      MP_TAC oth THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN DISCH_TAC THEN
      ASM_SIMP_TAC [INT_OF_NUM_LE, ← ARITH_RULE (← q r"1 <= p ==> ~(p <= 0)"),
                    NUM_OF_INT_OF_NUM] THEN
      MAP_EVERY X_GEN_TAC [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"] THEN
      COND_CASES_TAC THENL
       [ASM_SIMP_TAC [homology_group, relative_homology_group,
                      ← INT_ARITH (← q r"p:int <= &0 ==> p - &1 < &0")] THEN
        REWRITE_TAC [group_homomorphism, SINGLETON_GROUP] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_SING],
        FIRST_X_ASSUM (MP_TAC o CONJUNCT1 o SPECL
         [← q r"num_of_int p", ← q r"top:A topology", ← q r"s:A->bool"]) THEN
        ASM_SIMP_TAC [INT_OF_NUM_OF_INT, ← INT_ARITH (← q r"~(p:int <= &0) ==> &0 <= p"),
                      ← GSYM INT_OF_NUM_SUB, ← GSYM INT_OF_NUM_LE,
                      ← INT_ARITH (← q r"~(p:int <= &0) ==> &1 <= p")]])
    let fth ← prove
     r"?d. (!p (top:A topology) s c.
                  ~(c IN group_carrier(relative_homology_group (p,top,s)))
                  ==> d p (top,s) c =
                      group_id(homology_group (p - &1,subtopology top s))) /\
           (!p (top:A topology) s.
              group_homomorphism
               (relative_homology_group (p,top,s),
                homology_group (p - &1,subtopology top s))
               (d p (top,s))) /\
           (!p (top:A topology) s c.
                singular_relcycle (p,top,s) c /\ 1 <= p
                ==> d (&p) (top,s) (homologous_rel (p,top,s) c) =
                    homologous_rel (p - 1,subtopology top s,{})
                                   (chain_boundary p c)) /\
           (!p (top:A topology) s.
                  d p (top,s) = d p (top,topspace top INTER s)) /\
           (!p (top:A topology) s c.
                  d p (top,s) c IN
                  group_carrier(homology_group (p - &1,subtopology top s))) /\
           (!p. p <= &0 ==> d p = \q r. ARB)"
     (REWRITE_TAC [CONJ_ASSOC] THEN MATCH_MP_TAC (← MESON []
       (← q r"(!x. Q x ==> R x) /\ (?x. P x /\ Q x)
        ==> ?x. (P x /\ Q x) /\ R x")) THEN
      CONJ_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"p:int") THEN
        ASM_CASES_TAC (← q r"p:int <= &0") THEN
        ASM_REWRITE_TAC [homology_group, relative_homology_group] THEN
        ASM_REWRITE_TAC [← INT_ARITH (← q r"p - &1:int < &0 <=> p <= &0")] THEN
        REWRITE_TAC [FUN_EQ_THM, SINGLETON_GROUP, IN_SING] THEN
        REWRITE_TAC [FORALL_PAIR_THM],
        REWRITE_TAC [← GSYM CONJ_ASSOC]] THEN
      MP_TAC eth THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      INTRO_TAC "!d; hom rel triv" THEN EXISTS_TAC
       (← q r"\p (top:A topology,s) c.
           if c IN group_carrier(relative_homology_group (p,top,s))
           then d p (top,topspace top INTER s) c
           else group_id(homology_group (p - &1,subtopology top s))") THEN
      REWRITE_TAC [homology_group, ← GSYM RELATIVE_HOMOLOGY_GROUP_RESTRICT] THEN
      REWRITE_TAC [← SET_RULE (← q r"u INTER u INTER s = u INTER s")] THEN
      REWRITE_TAC [← GSYM SUBTOPOLOGY_RESTRICT] THEN REPEAT CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [],
        MAP_EVERY X_GEN_TAC [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"] THEN
        REMOVE_THEN "hom" (MP_TAC o SPECL
         [← q r"p:int", ← q r"top:A topology", ← q r"topspace top INTER s:A->bool"]) THEN
        REWRITE_TAC [homology_group, ← GSYM RELATIVE_HOMOLOGY_GROUP_RESTRICT] THEN
        REWRITE_TAC [← GSYM SUBTOPOLOGY_RESTRICT] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] GROUP_HOMOMORPHISM_EQ) THEN
        SIMP_TAC [],
        REPEAT GEN_TAC THEN DISCH_THEN (fun th =>
          STRIP_ASSUME_TAC th THEN MP_TAC th) THEN
        GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
         [SINGULAR_RELCYCLE_RESTRICT] THEN
        DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
        REWRITE_TAC [← GSYM HOMOLOGOUS_REL_RESTRICT, ← GSYM SUBTOPOLOGY_RESTRICT] THEN
        DISCH_THEN SUBST1_TAC THEN
        REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP] THEN
        COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM SET_TAC [],
        MAP_EVERY X_GEN_TAC [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"] THEN
        REMOVE_THEN "hom" (MP_TAC o SPECL
         [← q r"p:int", ← q r"top:A topology", ← q r"topspace top INTER s:A->bool"]) THEN
        REWRITE_TAC [group_homomorphism, homology_group] THEN
        REWRITE_TAC [← GSYM RELATIVE_HOMOLOGY_GROUP_RESTRICT] THEN
        REWRITE_TAC [← GSYM SUBTOPOLOGY_RESTRICT] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. (x IN s ==> f x IN t) ==> P x)
          ==> IMAGE f s SUBSET t /\ Q ==> !x. P x")) THEN
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [GROUP_ID]])
    let dth ← new_specification ["hom_boundary"] fth
    match CONJUNCTS dth with
    | [a, b, c, d, e, f] => pure (a, b, c, d, e, f)
    | _ => throw "HOM_BOUNDARY: match failure"

  return { GROUP_HOMOMORPHISM_CHAIN_BOUNDARY, HOM_BOUNDARY_DEFAULT,
           GROUP_HOMOMORPHISM_HOM_BOUNDARY, HOM_BOUNDARY_CHAIN_BOUNDARY, HOM_BOUNDARY_RESTRICT,
           HOM_BOUNDARY, HOM_BOUNDARY_TRIVIAL }

/- ------------------------------------------------------------------------- -/
/- Induced maps on homology groups.  (homology.ml 4296-4477)                 -/
/- ------------------------------------------------------------------------- -/

structure HIN where
  GROUP_HOMOMORPHISM_CHAIN_MAP : thm
  HOM_INDUCED_DEFAULT : thm
  GROUP_HOMOMORPHISM_HOM_INDUCED : thm
  HOM_INDUCED_CHAIN_MAP_GEN : thm
  HOM_INDUCED_RESTRICT : thm
  HOM_INDUCED : thm
  HOM_INDUCED_TRIVIAL : thm
  deriving Inhabited

@[nospecialize]
def setupHIN [HolBase] (D : HomologyDeps) (BMSR : MSR) (BRBD : RBD) (BHMR : HMR) (BSMP : SMP)
    (BCMP : CMP) (BHGP : HGP) : ExceptT String IO HIN := do
  -- @@SCOPE BEGIN
  let { new_specification, ASM_MESON_TAC, INT_ARITH, MESON, SET_RULE, SET_TAC, INTRO_TAC, .. } :=
    D
  let { AND_FORALL_THM, CONJ_ASSOC, EXISTS_CURRY, FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM,
        IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN, .. } := D.core1
  let { INT_OF_NUM_OF_INT, IN_SING, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        NUM_OF_INT_OF_NUM, .. } := D.core2
  let { RIGHT_EXISTS_IMP_THM, RIGHT_FORALL_IMP_THM, .. } := D.core3
  let { SKOLEM_THM, SUBSET, o_DEF, o_THM, .. } := D.core4
  let { GROUP_HOMOMORPHISM_COMPOSE, GROUP_HOMOMORPHISM_EQ, GROUP_HOMOMORPHISM_RIGHT_COSET,
        GROUP_HOMOMORPHISM_TRIVIAL, GROUP_ID, .. } := D.grp1
  let { QUOTIENT_GROUP_UNIVERSAL_EXPLICIT, SINGLETON_GROUP, group_homomorphism, .. } := D.grp2
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := D.met1
  let { SUBTOPOLOGY_RESTRICT, continuous_map, .. } := D.met3
  let { SINGULAR_RELCYCLE_RESTRICT, .. } := BMSR
  let { SINGULAR_RELBOUNDARY_RESTRICT, .. } := BRBD
  let { HOMOLOGOUS_REL_EQ, HOMOLOGOUS_REL_RESTRICT, homologous_rel, .. } := BHMR
  let { CHAIN_MAP_0, CHAIN_MAP_ADD, CHAIN_MAP_NEG, CHAIN_MAP_SUB, .. } := BSMP
  let { SINGULAR_RELBOUNDARY_CHAIN_MAP, SINGULAR_RELCYCLE_CHAIN_MAP, .. } := BCMP
  let { NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP, NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE,
        RELATIVE_HOMOLOGY_GROUP, RELATIVE_HOMOLOGY_GROUP_RESTRICT, RELCYCLE_GROUP,
        RELCYCLE_GROUP_RESTRICT, RIGHT_COSET_SINGULAR_RELBOUNDARY, homology_group,
        relative_homology_group, .. } := BHGP
  -- @@SCOPE END

  let GROUP_HOMOMORPHISM_CHAIN_MAP ← prove
   r"!p top s top' t (f:A->B).
        continuous_map (top,top') f /\ IMAGE f s SUBSET t
        ==> group_homomorphism
             (relcycle_group (p,top,s),relcycle_group (p,top',t))
             (chain_map p f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_homomorphism, RELCYCLE_GROUP] THEN
    REWRITE_TAC [CHAIN_MAP_0, CHAIN_MAP_NEG, CHAIN_MAP_ADD] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN] THEN
    ASM_MESON_TAC [SINGULAR_RELCYCLE_CHAIN_MAP])

  let (HOM_INDUCED_DEFAULT, GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED_CHAIN_MAP_GEN,
       HOM_INDUCED_RESTRICT, HOM_INDUCED, HOM_INDUCED_TRIVIAL) ← do
    let oth ← prove
     r"?hom_relmap.
        (!p top s top' t (f:A->B).
            continuous_map(top,top') f /\
            IMAGE f (topspace top INTER s) SUBSET t
            ==> group_homomorphism(relative_homology_group(&p,top,s),
                                   relative_homology_group(&p,top',t))
                                  (hom_relmap p (top,s) (top',t) f)) /\
        (!p top s top' t (f:A->B) c.
            continuous_map(top,top') f /\
            IMAGE f (topspace top INTER s) SUBSET t /\
            singular_relcycle (p,top,s) c
            ==> hom_relmap p (top,s) (top',t) f (homologous_rel (p,top,s) c) =
                homologous_rel (p,top',t) (chain_map p f c))"
     (REWRITE_TAC [AND_FORALL_THM] THEN
      REWRITE_TAC [EXISTS_CURRY, ← GSYM SKOLEM_THM] THEN REPEAT GEN_TAC THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [IMP_IMP, ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
      REWRITE_TAC [RIGHT_EXISTS_IMP_THM] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"relcycle_group(p,top:A topology,s)",
        ← q r"relative_homology_group(&p,top':B topology,t)",
        ← q r"singular_relboundary(p,top:A topology,s)",
        ← q r"right_coset (relcycle_group(p,top',t))
                     (singular_relboundary(p,top',t)) o
         chain_map p (f:A->B)"]
            QUOTIENT_GROUP_UNIVERSAL_EXPLICIT) THEN
      REWRITE_TAC [← GSYM NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP] THEN
      GEN_REWRITE_TAC LAND_CONV [IMP_CONJ] THEN ANTS_TAC THENL
       [MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE THEN
        EXISTS_TAC (← q r"relcycle_group (p,top':B topology,t)") THEN
        REWRITE_TAC [NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP] THEN
        ASM_SIMP_TAC [GROUP_HOMOMORPHISM_RIGHT_COSET,
                      NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE] THEN
        ONCE_REWRITE_TAC [RELCYCLE_GROUP_RESTRICT] THEN
        MATCH_MP_TAC GROUP_HOMOMORPHISM_CHAIN_MAP THEN
        ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM
         (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
        ASM SET_TAC [],
        REWRITE_TAC [NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE]] THEN
      REWRITE_TAC [RIGHT_COSET_SINGULAR_RELBOUNDARY] THEN
      REWRITE_TAC [RELCYCLE_GROUP] THEN ANTS_TAC THENL
       [ALL_TAC, REWRITE_TAC [IN, o_THM]] THEN
      REWRITE_TAC [HOMOLOGOUS_REL_EQ, o_DEF] THEN
      REWRITE_TAC [homologous_rel, ← GSYM CHAIN_MAP_SUB] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC SINGULAR_RELBOUNDARY_CHAIN_MAP THEN
      MAP_EVERY EXISTS_TAC
       [← q r"top:A topology", ← q r"topspace top INTER s:A->bool"] THEN
      ASM_REWRITE_TAC [← GSYM SINGULAR_RELBOUNDARY_RESTRICT])
    let eth ← prove
     r"?hom_relmap.
        (!p top s top' t (f:A->B).
            continuous_map(top,top') f /\
            IMAGE f (topspace top INTER s) SUBSET t
            ==> group_homomorphism(relative_homology_group(p,top,s),
                                   relative_homology_group(p,top',t))
                                  (hom_relmap p (top,s) (top',t) f)) /\
        (!p top s top' t (f:A->B) c.
            continuous_map(top,top') f /\
            IMAGE f (topspace top INTER s) SUBSET t /\
            singular_relcycle (p,top,s) c
            ==> hom_relmap (&p) (top,s) (top',t) f (homologous_rel (p,top,s) c) =
                homologous_rel (p,top',t) (chain_map p f c)) /\
        (!p. p < &0 ==> hom_relmap p = \q r s t. ARB)"
     (MATCH_MP_TAC (← MESON []
      (← q r"(?f. P(\p. if p < &0 then \q r s t. ARB else f(num_of_int p)))
       ==> ?f. P f")) THEN
      MP_TAC oth THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN DISCH_TAC THEN
      ASM_SIMP_TAC [← INT_ARITH (← q r"~(&p:int < &0)"), NUM_OF_INT_OF_NUM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool",
        ← q r"top':B topology", ← q r"t:B->bool", ← q r"f:A->B"] THEN
      STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
       [ASM_REWRITE_TAC [relative_homology_group, group_homomorphism] THEN
        REWRITE_TAC [SINGLETON_GROUP] THEN SET_TAC [],
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"num_of_int p") o CONJUNCT1) THEN
        ASM_SIMP_TAC [INT_OF_NUM_OF_INT, ← INT_ARITH
         (← q r"~(p:int < &0) ==> &0 <= p")]])
    let fth ← prove
     r"?hom_relmap.
        (!p top s top' t (f:A->B) c.
            ~(continuous_map (top,top') f /\
              IMAGE f (topspace top INTER s) SUBSET t /\
              c IN group_carrier(relative_homology_group (p,top,s)))
            ==> hom_relmap p (top,s) (top',t) f c =
                group_id(relative_homology_group (p,top',t))) /\
        (!p top s top' t (f:A->B).
            group_homomorphism(relative_homology_group(p,top,s),
                               relative_homology_group(p,top',t))
                              (hom_relmap p (top,s) (top',t) f)) /\
        (!p top s top' t (f:A->B) c.
            continuous_map(top,top') f /\
            IMAGE f (topspace top INTER s) SUBSET t /\
            singular_relcycle (p,top,s) c
            ==> hom_relmap (&p) (top,s) (top',t) f (homologous_rel (p,top,s) c) =
                homologous_rel (p,top',t) (chain_map p f c)) /\
        (!p top s top' t.
            hom_relmap p (top,s) (top',t) =
            hom_relmap p (top,topspace top INTER s)
                         (top',topspace top' INTER t)) /\
        (!p top s top' f t c.
            hom_relmap p (top,s) (top',t) f c IN
            group_carrier(relative_homology_group(p,top',t))) /\
        (!p. p < &0 ==> hom_relmap p = \q r s t. ARB)"
     (REWRITE_TAC [CONJ_ASSOC] THEN MATCH_MP_TAC (← MESON []
       (← q r"(!x. Q x ==> R x) /\ (?x. P x /\ Q x)
        ==> ?x. (P x /\ Q x) /\ R x")) THEN
      CONJ_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"p:int") THEN
        ASM_CASES_TAC (← q r"p:int < &0") THEN
        ASM_REWRITE_TAC [homology_group, relative_homology_group] THEN
        REWRITE_TAC [FUN_EQ_THM, SINGLETON_GROUP, IN_SING] THEN
        SIMP_TAC [FORALL_PAIR_THM],
        REWRITE_TAC [← GSYM CONJ_ASSOC]] THEN
      MP_TAC eth THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      INTRO_TAC "!hom_relmap; hom rel triv" THEN EXISTS_TAC
       (← q r"\p (top:A topology,s) (top':B topology,t) (f:A->B) c.
           if continuous_map (top,top') f /\
              IMAGE f (topspace top INTER s) SUBSET t /\
              c IN group_carrier(relative_homology_group (p,top,s))
           then hom_relmap p (top,topspace top INTER s)
                             (top',topspace top' INTER t) f c
           else group_id(relative_homology_group (p,top',t))") THEN
      REWRITE_TAC [homology_group, ← GSYM RELATIVE_HOMOLOGY_GROUP_RESTRICT] THEN
      REWRITE_TAC [← SET_RULE (← q r"u INTER u INTER s = u INTER s")] THEN
      REWRITE_TAC [← GSYM SUBTOPOLOGY_RESTRICT] THEN REPEAT CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [],
        INTRO_TAC "!p top s top' t f" THEN
        ASM_CASES_TAC (← q r" continuous_map (top,top') (f:A->B)") THEN
        ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_TRIVIAL] THEN
        ASM_CASES_TAC (← q r"IMAGE (f:A->B) (topspace top INTER s) SUBSET t") THEN
        ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_TRIVIAL] THEN
        REMOVE_THEN "hom" (MP_TAC o SPECL
         [← q r"p:int", ← q r"top:A topology", ← q r"topspace top INTER s:A->bool",
          ← q r"top':B topology", ← q r"topspace top' INTER t:B->bool", ← q r"f:A->B"]) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
          REWRITE_TAC [← GSYM RELATIVE_HOMOLOGY_GROUP_RESTRICT] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] GROUP_HOMOMORPHISM_EQ) THEN
          SIMP_TAC []],
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        REPEAT GEN_TAC THEN REPEAT DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
        REMOVE_THEN "rel" (MP_TAC o SPECL
         [← q r"p:num", ← q r"top:A topology", ← q r"topspace top INTER s:A->bool",
          ← q r"top':B topology", ← q r"topspace top' INTER t:B->bool", ← q r"f:A->B"]) THEN
        ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
          REWRITE_TAC [← GSYM SINGULAR_RELCYCLE_RESTRICT]] THEN
        SIMP_TAC [← GSYM HOMOLOGOUS_REL_RESTRICT] THEN DISCH_THEN (K ALL_TAC) THEN
        GEN_TAC THEN REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP] THEN
        COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM SET_TAC [],
        REPEAT GEN_TAC THEN REPEAT ABS_TAC THEN
        AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [continuous_map] THEN SET_TAC [],
        INTRO_TAC "!p top s top' t f c" THEN
        COND_CASES_TAC THEN REWRITE_TAC [GROUP_ID] THEN
        REMOVE_THEN "hom" (MP_TAC o SPECL
         [← q r"p:int", ← q r"top:A topology", ← q r"topspace top INTER s:A->bool",
          ← q r"top':B topology", ← q r"topspace top' INTER t:B->bool", ← q r"f:A->B"]) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
          REWRITE_TAC [group_homomorphism] THEN
          REWRITE_TAC [← GSYM RELATIVE_HOMOLOGY_GROUP_RESTRICT] THEN
          ASM SET_TAC []]])
    let dth ← new_specification ["hom_induced"] fth
    match CONJUNCTS dth with
    | [a, b, c, d, e, f] => pure (a, b, c, d, e, f)
    | _ => throw "HOM_INDUCED: match failure"

  return { GROUP_HOMOMORPHISM_CHAIN_MAP, HOM_INDUCED_DEFAULT, GROUP_HOMOMORPHISM_HOM_INDUCED,
           HOM_INDUCED_CHAIN_MAP_GEN, HOM_INDUCED_RESTRICT, HOM_INDUCED, HOM_INDUCED_TRIVIAL }

/- ------------------------------------------------------------------------- -/
/- Functoriality of induced maps and naturality of the boundary.             -/
/- (homology.ml 4478-4660)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HIF where
  HOM_INDUCED_CHAIN_MAP : thm
  HOM_INDUCED_EQ : thm
  ABELIAN_RELATIVE_HOMOLOGY_GROUP : thm
  HOM_INDUCED_ID_GEN : thm
  HOM_INDUCED_ID : thm
  HOM_INDUCED_COMPOSE : thm
  NATURALITY_HOM_INDUCED : thm
  deriving Inhabited

@[nospecialize]
def setupHIF [HolBase] (D : HomologyDeps) (BMSR : MSR) (BHMR : HMR) (BBDB : BDB) (BSMP : SMP)
    (BCMP : CMP) (BHGP : HGP) (BHBD : HBD) (BHIN : HIN) : ExceptT String IO HIF := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_ARITH, MESON, SET_TAC, FRAG_MODULE, .. } := D
  let { FORALL_IN_GSPEC, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_o, IMP_CONJ, IN, .. } := D.core1
  let { INT_FORALL_POS, INT_NOT_LT, INT_OF_NUM_LE, INT_OF_NUM_OF_INT, INT_OF_NUM_SUB, IN_SING,
        LE_0, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, .. } := D.core3
  let { SUBSET_INTER, SUBSET_REFL, cong, o_DEF, o_THM, .. } := D.core4
  let { ABELIAN_QUOTIENT_GROUP, ABELIAN_SINGLETON_GROUP, .. } := D.grp1
  let { QUOTIENT_GROUP, SINGLETON_GROUP, group_homomorphism, .. } := D.grp2
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EQ, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := D.met1
  let { TOPSPACE_SUBTOPOLOGY, continuous_map, .. } := D.met3
  let { SINGULAR_CYCLE, SINGULAR_RELCYCLE_RESTRICT, mod_subset, singular_relcycle, .. } := BMSR
  let { HOMOLOGOUS_REL_RESTRICT, .. } := BHMR
  let { CHAIN_BOUNDARY_BOUNDARY, .. } := BBDB
  let { CHAIN_MAP_COMPOSE, CHAIN_MAP_EQ, CHAIN_MAP_ID_GEN, .. } := BSMP
  let { CHAIN_BOUNDARY_CHAIN_MAP, SINGULAR_RELCYCLE_CHAIN_MAP, .. } := BCMP
  let { ABELIAN_RELCYCLE_GROUP, NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP,
        NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE, RELATIVE_HOMOLOGY_GROUP, RELCYCLE_GROUP,
        RIGHT_COSET_SINGULAR_RELBOUNDARY, SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE, homology_group,
        relative_homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_BOUNDARY, HOM_BOUNDARY_CHAIN_BOUNDARY, HOM_BOUNDARY_DEFAULT,
        HOM_BOUNDARY_TRIVIAL, .. } := BHBD
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED_CHAIN_MAP_GEN, HOM_INDUCED_DEFAULT,
        HOM_INDUCED_RESTRICT, HOM_INDUCED_TRIVIAL, .. } := BHIN
  -- @@SCOPE END

  let HOM_INDUCED_CHAIN_MAP ← prove
   r"!p top s top' t (f:A->B) c.
        continuous_map (top,top') f /\
        IMAGE f s SUBSET t /\
        singular_relcycle (p,top,s) c
        ==> hom_induced (&p) (top,s) (top',t) f (homologous_rel (p,top,s) c) =
            homologous_rel (p,top',t) (chain_map p f c)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOM_INDUCED_CHAIN_MAP_GEN THEN
    ASM SET_TAC [])

  let HOM_INDUCED_EQ ← prove
   r"!p top s top' t (f:A->B) g.
        (!x. x IN topspace top ==> f x = g x)
        ==> hom_induced p (top,s) (top',t) f =
            hom_induced p (top,s) (top',t) g"
   (MATCH_MP_TAC (← MESON [INT_OF_NUM_OF_INT, INT_NOT_LT]
     (← q r"(!x. x < &0 ==> P x) /\ (!p. P(&p)) ==> !x:int. P x")) THEN
    CONJ_TAC THENL [SIMP_TAC [HOM_INDUCED_TRIVIAL], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"c:((num->real)->A)frag->bool") THEN
    SUBGOAL_THEN
     (← q r"continuous_map (top,top') (f:A->B) /\
      IMAGE f (topspace top INTER s) SUBSET t /\
      c IN group_carrier (relative_homology_group (&p,top,s)) <=>
      continuous_map (top,top') (g:A->B) /\
      IMAGE g (topspace top INTER s) SUBSET t /\
      c IN group_carrier (relative_homology_group (&p,top,s))")
    MP_TAC THENL
     [BINOP_TAC THENL [ASM_MESON_TAC [CONTINUOUS_MAP_EQ], ASM SET_TAC []],
      ALL_TAC] THEN
    REWRITE_TAC [← TAUT (← q r"(p <=> q) <=> ~p /\ ~q \/ p /\ q")] THEN STRIP_TAC THENL
     [ASM_MESON_TAC [HOM_INDUCED_DEFAULT], ALL_TAC] THEN
    UNDISCH_TAC
     (← q r"c IN group_carrier (relative_homology_group (&p,top,s:A->bool))") THEN
    SPEC_TAC (← q r"c:((num->real)->A)frag->bool", ← q r"c:((num->real)->A)frag->bool") THEN
    REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP, FORALL_IN_GSPEC] THEN
    ONCE_REWRITE_TAC [HOMOLOGOUS_REL_RESTRICT, SINGULAR_RELCYCLE_RESTRICT] THEN
    ONCE_REWRITE_TAC [HOM_INDUCED_RESTRICT] THEN REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      HOM_INDUCED_CHAIN_MAP o lhand o snd) THEN
    ASM_REWRITE_TAC [SUBSET_INTER] THEN ANTS_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      DISCH_THEN SUBST1_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      HOM_INDUCED_CHAIN_MAP o rand o snd) THEN
    ASM_REWRITE_TAC [SUBSET_INTER] THEN ANTS_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      DISCH_THEN SUBST1_TAC] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC CHAIN_MAP_EQ THEN
    ASM_MESON_TAC [singular_relcycle, SINGULAR_RELCYCLE_RESTRICT])

  /- ----------------------------------------------------------------------- -/
  /- First prove we get functors into abelian groups with the boundary map   -/
  /- being a natural transformation between them, and prove                  -/
  /- Eilenberg-Steenrod axioms (we also prove additivity a bit later on if   -/
  /- one counts that).                                                       -/
  /- ----------------------------------------------------------------------- -/

  let ABELIAN_RELATIVE_HOMOLOGY_GROUP ← prove
   r"!p top s:A->bool. abelian_group(relative_homology_group(p,top,s))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [relative_homology_group] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [ABELIAN_SINGLETON_GROUP] THEN
    SIMP_TAC [ABELIAN_QUOTIENT_GROUP,
              SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE, ABELIAN_RELCYCLE_GROUP])

  let HOM_INDUCED_ID_GEN ← prove
   r"!p top (f:A->A) s c.
        continuous_map(top,top) f /\
        (!x. x IN topspace top ==> f x = x) /\
        c IN group_carrier (relative_homology_group (p,top,s))
        ==> hom_induced p (top,s) (top,s) f c = c"
   (MATCH_MP_TAC (← MESON [INT_OF_NUM_OF_INT, INT_NOT_LT]
     (← q r"(!x. x < &0 ==> P x) /\ (!p. P(&p)) ==> !x:int. P x")) THEN
    CONJ_TAC THENL
     [SIMP_TAC [relative_homology_group, SINGLETON_GROUP,
                HOM_INDUCED_TRIVIAL, IN_SING],
      ALL_TAC] THEN
    REWRITE_TAC [NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP] THEN
    SIMP_TAC [QUOTIENT_GROUP, NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IMP_CONJ, RIGHT_FORALL_IMP_THM,
                 RIGHT_COSET_SINGULAR_RELBOUNDARY] THEN
    REWRITE_TAC [RELCYCLE_GROUP, IN] THEN REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) HOM_INDUCED_CHAIN_MAP_GEN o
      lhand o snd) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC CHAIN_MAP_ID_GEN THEN
    ASM_MESON_TAC [singular_relcycle, IN])

  let HOM_INDUCED_ID ← prove
   r"!p top (s:A->bool) c.
        c IN group_carrier (relative_homology_group (p,top,s))
        ==> hom_induced p (top,s) (top,s) (\x. x) c = c"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOM_INDUCED_ID_GEN THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_ID])

  let HOM_INDUCED_COMPOSE ← prove
   r"!p top s top' t top'' u (f:A->B) (g:B->C).
        continuous_map(top,top') f /\ IMAGE f s SUBSET t /\
        continuous_map(top',top'') g /\ IMAGE g t SUBSET u
        ==> hom_induced p (top,s) (top'',u) (g o f) =
            hom_induced p (top',t) (top'',u) g o
            hom_induced p (top,s) (top',t) f"
   (MATCH_MP_TAC (← MESON [INT_OF_NUM_OF_INT, INT_NOT_LT]
     (← q r"(!x. x < &0 ==> P x) /\ (!p. P(&p)) ==> !x:int. P x")) THEN
    CONJ_TAC THENL [SIMP_TAC [HOM_INDUCED_TRIVIAL, o_DEF], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN MATCH_MP_TAC (← MESON []
     (← q r"!P. (!x. ~P x ==> Q x) /\ (!x. P x ==> Q x) ==> !x. Q x")) THEN
    EXISTS_TAC
     (← q r"\c. c IN group_carrier(relative_homology_group(&p,top:A topology,s))") THEN
    CONJ_TAC THENL
     [SIMP_TAC [HOM_INDUCED_DEFAULT, o_DEF, ← REWRITE_RULE [group_homomorphism]
                 GROUP_HOMOMORPHISM_HOM_INDUCED],
      REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP, FORALL_IN_GSPEC, o_THM]] THEN
    X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [HOM_INDUCED_CHAIN_MAP] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) HOM_INDUCED_CHAIN_MAP o rand o snd) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SINGULAR_RELCYCLE_CHAIN_MAP], DISCH_THEN SUBST1_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) HOM_INDUCED_CHAIN_MAP o
      lhand o snd) THEN
    ASM_REWRITE_TAC [IMAGE_o] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE], ASM SET_TAC []],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [CHAIN_MAP_COMPOSE, o_THM]])

  let NATURALITY_HOM_INDUCED ← prove
   r"!p top s top' t (f:A->B).
    continuous_map(top,top') f /\ IMAGE f s SUBSET t
    ==> hom_boundary p (top',t) o
        hom_induced p (top,s) (top',t) f =
        hom_induced (p - &1) (subtopology top s,{}) (subtopology top' t,{}) f o
        hom_boundary p (top,s)"
   (X_GEN_TAC (← q r"q:int") THEN ASM_CASES_TAC (← q r"q:int <= &0") THENL
     [ASM_SIMP_TAC [o_DEF, HOM_BOUNDARY_TRIVIAL, HOM_INDUCED_TRIVIAL, ← INT_ARITH
       (← q r"q:int <= &0 ==> q - &1 < &0")],
      FIRST_ASSUM (MP_TAC o MATCH_MP (← INT_ARITH
       (← q r"~(q:int <= &0) ==> &0 <= q /\ &1 <= q"))) THEN
      SPEC_TAC (← q r"q:int", ← q r"q:int") THEN
      REWRITE_TAC [IMP_CONJ, ← GSYM INT_FORALL_POS, INT_OF_NUM_LE, LE_0] THEN
      X_GEN_TAC (← q r"p:num") THEN DISCH_TAC] THEN
    REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN MATCH_MP_TAC (← MESON []
     (← q r"!P. (!x. ~P x ==> Q x) /\ (!x. P x ==> Q x) ==> !x. Q x")) THEN
    EXISTS_TAC
     (← q r"\c. c IN group_carrier(relative_homology_group(&p,top:A topology,s))") THEN
    CONJ_TAC THENL
     [SIMP_TAC [HOM_INDUCED_DEFAULT, HOM_BOUNDARY_DEFAULT, o_DEF, homology_group,
                ← REWRITE_RULE [group_homomorphism] (← CONJ
                 GROUP_HOMOMORPHISM_HOM_INDUCED GROUP_HOMOMORPHISM_HOM_BOUNDARY)],
      REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP, FORALL_IN_GSPEC, o_THM]] THEN
    X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [HOM_BOUNDARY_CHAIN_BOUNDARY, HOM_INDUCED_CHAIN_MAP] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) HOM_BOUNDARY_CHAIN_BOUNDARY o
      lhand o snd) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [SINGULAR_RELCYCLE_CHAIN_MAP], ALL_TAC] THEN
    DISCH_THEN SUBST1_TAC THEN ASM_SIMP_TAC [INT_OF_NUM_SUB] THEN
    FIRST_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
      REWRITE_RULE [singular_relcycle]) THEN
    SIMP_TAC [cong, mod_subset, ← FRAG_MODULE (← q r"frag_sub x frag_0 = x")] THEN
    DISCH_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) HOM_INDUCED_CHAIN_MAP o
      rand o snd) THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, SUBSET_REFL] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [SINGULAR_CYCLE] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [CHAIN_BOUNDARY_BOUNDARY]] THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY,
                    CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
      ASM SET_TAC [],
      DISCH_THEN SUBST1_TAC] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC CHAIN_BOUNDARY_CHAIN_MAP THEN
    ASM_MESON_TAC [])

  return { HOM_INDUCED_CHAIN_MAP, HOM_INDUCED_EQ, ABELIAN_RELATIVE_HOMOLOGY_GROUP,
           HOM_INDUCED_ID_GEN, HOM_INDUCED_ID, HOM_INDUCED_COMPOSE, NATURALITY_HOM_INDUCED }

/- ------------------------------------------------------------------------- -/
/- The first two exactness axioms.  (homology.ml 4661-4833)                  -/
/- ------------------------------------------------------------------------- -/

structure HEX where
  HOMOLOGY_EXACTNESS_AXIOM_1 : thm
  HOMOLOGY_EXACTNESS_AXIOM_2 : thm
  deriving Inhabited

@[nospecialize]
def setupHEX [HolBase] (D : HomologyDeps) (BSCH : SCH) (BMSR : MSR) (BRBD : RBD) (BHMR : HMR)
    (BBDB : BDB) (BSMP : SMP) (BHGP : HGP) (BHBD : HBD) (BHIN : HIN) (BHIF : HIF) :
    ExceptT String IO HEX := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INT_ARITH, MESON, MESON_TAC, SET_RULE, SET_TAC, FRAG_MODULE,
        NUM_REDUCE_CONV, .. } := D
  let { ADD_SUB, CONJ_ASSOC, CONJ_SYM, EMPTY_SUBSET, EQ_TRANS, ETA_AX, EXISTS_IN_GSPEC,
        FORALL_IN_GSPEC, FUN_EQ_THM, IMAGE_CLAUSES, IMP_CONJ, .. } := D.core1
  let { INT_FORALL_POS, INT_LE_REFL, INT_NOT_LT, INT_OF_NUM_ADD, INT_OF_NUM_LE,
        INT_OF_NUM_OF_INT, INT_OF_NUM_SUC, IN_IMAGE, LE_0, .. } := D.core2
  let { SUBSET, cong, num_INDUCTION, .. } := D.core4
  let { GROUP_ID, .. } := D.grp1
  let { SINGLETON_GROUP, group_exactness, group_homomorphism, group_image, group_kernel, .. } :=
    D.grp2
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, .. } := D.met1
  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_SUB, SINGULAR_CHAIN_0, SINGULAR_CHAIN_NEG,
        SINGULAR_CHAIN_SUB, SINGULAR_CHAIN_SUBTOPOLOGY, chain_boundary, .. } := BSCH
  let { MOD_SUBSET_REFL, SINGULAR_CYCLE, mod_subset, singular_relcycle, .. } := BMSR
  let { SINGULAR_BOUNDARY, SINGULAR_RELBOUNDARY_0, singular_relboundary, .. } := BRBD
  let { HOMOLOGOUS_REL_EQ, HOMOLOGOUS_REL_REFL, homologous_rel, .. } := BHMR
  let { CHAIN_BOUNDARY_BOUNDARY_ALT, .. } := BBDB
  let { CHAIN_MAP_ID, .. } := BSMP
  let { HOMOLOGOUS_REL_EQ_RELBOUNDARY, RELATIVE_HOMOLOGY_GROUP, homology_group,
        relative_homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_BOUNDARY, HOM_BOUNDARY_CHAIN_BOUNDARY, HOM_BOUNDARY_TRIVIAL, .. } :=
    BHBD
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED_TRIVIAL, .. } := BHIN
  let { HOM_INDUCED_CHAIN_MAP, .. } := BHIF
  -- @@SCOPE END

  let HOMOLOGY_EXACTNESS_AXIOM_1 ← prove
   r"!p top s:A->bool.
        group_exactness(homology_group(p,top),
                        relative_homology_group(p,top,s),
                        homology_group(p - &1,subtopology top s))
                       (hom_induced p (top,{}) (top,s) (\x. x),
                        hom_boundary p (top,s))"
   (REWRITE_TAC [group_exactness, GROUP_HOMOMORPHISM_HOM_BOUNDARY] THEN
    SIMP_TAC [homology_group, GROUP_HOMOMORPHISM_HOM_INDUCED,
              CONTINUOUS_MAP_ID, IMAGE_CLAUSES, EMPTY_SUBSET] THEN
    REWRITE_TAC [group_image, group_kernel] THEN
    MATCH_MP_TAC (← MESON [INT_OF_NUM_OF_INT, INT_NOT_LT]
     (← q r"(!x. x < &0 ==> P x) /\ (!p. P(&p)) ==> !x:int. P x")) THEN
    CONJ_TAC THENL
     [SIMP_TAC [relative_homology_group, SINGLETON_GROUP, HOM_INDUCED_TRIVIAL,
                HOM_BOUNDARY_TRIVIAL, ← INT_ARITH
                 (← q r"q:int < &0 ==> q <= &0 /\ q - &1 < &0")] THEN
      SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
     [SIMP_TAC [HOM_BOUNDARY_TRIVIAL, INT_LE_REFL] THEN
      SIMP_TAC [relative_homology_group, ← INT_ARITH (← q r"&0 - &1:int < &0")] THEN
      REWRITE_TAC [← GSYM relative_homology_group, SINGLETON_GROUP] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [← SET_RULE
       (← q r"s = {x | x IN t} <=> s SUBSET t /\ t SUBSET s")] THEN
      MP_TAC (← ISPECL [← q r"&0:int", ← q r"top:A topology", ← q r"{}:A->bool",
                        ← q r"top:A topology", ← q r"s:A->bool", ← q r"\x:A. x"]
            GROUP_HOMOMORPHISM_HOM_INDUCED) THEN
      REWRITE_TAC [CONTINUOUS_MAP_ID, IMAGE_CLAUSES, EMPTY_SUBSET] THEN
      SIMP_TAC [group_homomorphism, homology_group] THEN
      DISCH_THEN (K ALL_TAC) THEN
      REWRITE_TAC [SUBSET, RELATIVE_HOMOLOGY_GROUP, IN_IMAGE] THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN
      REWRITE_TAC [singular_relcycle] THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN REWRITE_TAC [EXISTS_IN_GSPEC] THEN
      EXISTS_TAC (← q r"c:((num->real)->A)frag") THEN
      ASM_REWRITE_TAC [singular_relcycle, chain_boundary, MOD_SUBSET_REFL] THEN
      ASM_SIMP_TAC [HOM_INDUCED_CHAIN_MAP, CONTINUOUS_MAP_ID, IMAGE_CLAUSES,
          EMPTY_SUBSET, singular_relcycle, chain_boundary, MOD_SUBSET_REFL] THEN
      AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC CHAIN_MAP_ID THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"p:num") THEN DISCH_THEN (K ALL_TAC) THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM INT_OF_NUM_SUC, ← INT_ARITH (← q r"(p + &1) - &1:int = p")] THEN
    REWRITE_TAC [INT_OF_NUM_ADD, RELATIVE_HOMOLOGY_GROUP] THEN
    REWRITE_TAC [← SET_RULE
       (← q r"{x | x IN {f y | P y} /\ Q x} = {f y |y| P y /\ Q(f y)}")] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE g {f y | P y} = { g(f y) | P y}")] THEN
    TRANS_TAC EQ_TRANS
     (← q r"{ homologous_rel (p+1,top:A topology,s) c | c |
        singular_relcycle (p+1,top,{}) c}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. P x ==> f x = g x) ==> {f x | P x} = {g x | P x}")) THEN
      X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [HOM_INDUCED_CHAIN_MAP, CONTINUOUS_MAP_ID, IMAGE_CLAUSES,
                    CONTINUOUS_MAP_FROM_SUBTOPOLOGY, EMPTY_SUBSET] THEN
      AP_TERM_TAC THEN MATCH_MP_TAC CHAIN_MAP_ID THEN
      ASM_MESON_TAC [singular_relcycle],
      ALL_TAC] THEN
    TRANS_TAC EQ_TRANS
     (← q r"{ homologous_rel (p+1,top:A topology,s) c | c |
        singular_relcycle (p+1,top,s) c /\
        singular_relboundary (p,subtopology top s,{})
                             (chain_boundary (p+1) c)}") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. P x ==> (Q x <=> R x))
        ==> {f x | P x /\ Q x} = {f x | P x /\ R x}")) THEN
      SIMP_TAC [HOM_BOUNDARY_CHAIN_BOUNDARY, ← ARITH_RULE (← q r"1 <= p + 1")] THEN
      X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN DISCH_TAC THEN
      REWRITE_TAC [FUN_EQ_THM] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM FUN_EQ_THM] THEN
      REWRITE_TAC [ETA_AX, ADD_SUB, HOMOLOGOUS_REL_EQ_RELBOUNDARY] THEN
      REWRITE_TAC [SINGULAR_BOUNDARY]] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. P x ==> ?y. Q y /\ f x = f y) /\
      (!x. Q x ==> ?y. P y /\ f x = f y)
      ==> {f x | P x} = {f x | Q x}")) THEN
    REWRITE_TAC [HOMOLOGOUS_REL_EQ] THEN CONJ_TAC THEN
    X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN STRIP_TAC THENL
     [EXISTS_TAC (← q r"c:((num->real)->A)frag") THEN
      REWRITE_TAC [HOMOLOGOUS_REL_REFL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SINGULAR_CYCLE]) THEN
      ASM_REWRITE_TAC [SINGULAR_RELBOUNDARY_0, singular_relcycle] THEN
      REWRITE_TAC [cong, mod_subset, ← FRAG_MODULE (← q r"frag_sub x x = frag_0")] THEN
      REWRITE_TAC [SINGULAR_CHAIN_0],
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SINGULAR_BOUNDARY]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:((num->real)->A)frag") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"frag_sub c d:((num->real)->A)frag") THEN
      ASM_REWRITE_TAC [SINGULAR_CYCLE] THEN
      ASM_REWRITE_TAC [CHAIN_BOUNDARY_SUB, ← FRAG_MODULE
       (← q r"frag_sub x x = frag_0")] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SINGULAR_CHAIN_SUB THEN
        CONJ_TAC THENL [ASM_MESON_TAC [singular_relcycle], ALL_TAC] THEN
        ASM_MESON_TAC [SINGULAR_CHAIN_SUBTOPOLOGY],
        REWRITE_TAC [homologous_rel, singular_relboundary] THEN
        EXISTS_TAC (← q r"frag_0:((num->real)->A)frag") THEN
        REWRITE_TAC [SINGULAR_CHAIN_0, CHAIN_BOUNDARY_0] THEN
        ASM_REWRITE_TAC [cong, mod_subset, SINGULAR_CHAIN_NEG, ← FRAG_MODULE
         (← q r"frag_sub frag_0 (frag_sub c (frag_sub c d)) = frag_neg d")]]])

  let HOMOLOGY_EXACTNESS_AXIOM_2 ← prove
   r"!p top s:A->bool.
      group_exactness(relative_homology_group(p,top,s),
                      homology_group(p - &1,subtopology top s),
                      homology_group(p - &1,top))
               (hom_boundary p (top,s),
                hom_induced (p - &1) (subtopology top s,{}) (top,{}) (\x. x))"
   (REWRITE_TAC [group_exactness, GROUP_HOMOMORPHISM_HOM_BOUNDARY] THEN
    SIMP_TAC [homology_group, GROUP_HOMOMORPHISM_HOM_INDUCED,
              CONTINUOUS_MAP_FROM_SUBTOPOLOGY, GROUP_HOMOMORPHISM_HOM_BOUNDARY,
              CONTINUOUS_MAP_ID, IMAGE_CLAUSES, EMPTY_SUBSET] THEN
    REWRITE_TAC [group_image, group_kernel] THEN
    X_GEN_TAC (← q r"q:int") THEN ASM_CASES_TAC (← q r"q:int <= &0") THENL
     [ASM_SIMP_TAC [HOM_BOUNDARY_TRIVIAL, HOM_INDUCED_TRIVIAL, ← INT_ARITH
       (← q r"q:int <= &0 ==> q - &1 < &0"), relative_homology_group] THEN
      REWRITE_TAC [← GSYM relative_homology_group, SINGLETON_GROUP] THEN
      REPEAT GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
      (← q r"(?x. x IN s) ==> IMAGE (\x. a) s = {x | x IN {a}}")) THEN
      MESON_TAC [GROUP_ID],
      FIRST_ASSUM (MP_TAC o MATCH_MP (← INT_ARITH
       (← q r"~(q:int <= &0) ==> &0 <= q /\ &1 <= q"))) THEN
      SPEC_TAC (← q r"q:int", ← q r"q:int") THEN
      REWRITE_TAC [IMP_CONJ, ← GSYM INT_FORALL_POS, INT_OF_NUM_LE, LE_0] THEN
      MATCH_MP_TAC num_INDUCTION THEN CONV_TAC NUM_REDUCE_CONV] THEN
    X_GEN_TAC (← q r"p:num") THEN REPEAT (DISCH_THEN (K ALL_TAC)) THEN
    REWRITE_TAC [← GSYM INT_OF_NUM_SUC, ← INT_ARITH (← q r"(p + &1) - &1:int = p")] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN REWRITE_TAC [INT_OF_NUM_ADD] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [homology_group, RELATIVE_HOMOLOGY_GROUP] THEN
    REWRITE_TAC [← SET_RULE
       (← q r"{x | x IN {f y | P y} /\ Q x} = {f y |y| P y /\ Q(f y)}")] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE g {f y | P y} = { g(f y) | P y}")] THEN
    TRANS_TAC EQ_TRANS
     (← q r"{ homologous_rel (p,subtopology top s,{}) (chain_boundary (p + 1) c) | c |
        singular_relcycle (p+1,top:A topology,s) c}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. P x ==> f x = g x) ==> {f x | P x} = {g x | P x}")) THEN
      X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [HOM_BOUNDARY_CHAIN_BOUNDARY, ADD_SUB,
                    ← ARITH_RULE (← q r"1 <= p + 1")] THEN
      REWRITE_TAC [FUN_EQ_THM],
      ALL_TAC] THEN
    TRANS_TAC EQ_TRANS
     (← q r"{ homologous_rel (p,subtopology top s:A topology,{}) c | c |
        singular_relcycle (p,subtopology top s,{}) c /\
        singular_relboundary (p,top,{}) c}") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. P x ==> (Q x <=> R x))
        ==> {f x | P x /\ Q x} = {f x | P x /\ R x}")) THEN
      SIMP_TAC [HOM_INDUCED_CHAIN_MAP, CONTINUOUS_MAP_ID, IMAGE_CLAUSES,
                CONTINUOUS_MAP_FROM_SUBTOPOLOGY, EMPTY_SUBSET] THEN
      REWRITE_TAC [HOMOLOGOUS_REL_EQ_RELBOUNDARY] THEN
      REPEAT STRIP_TAC THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC CHAIN_MAP_ID THEN ASM_MESON_TAC [singular_relcycle]] THEN
    REWRITE_TAC [SINGULAR_BOUNDARY] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{f x | P x /\ ?y. Q y /\ g y = x} = {f(g z) |z| Q z /\ P(g z)}")] THEN
    REWRITE_TAC [SINGULAR_CYCLE] THEN
    REWRITE_TAC [singular_relcycle, ← GSYM CONJ_ASSOC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. P x ==> (Q x <=> R x))
      ==> {f x | P x /\ Q x} = {f x | P x /\ R x}")) THEN
    X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN DISCH_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP CHAIN_BOUNDARY_BOUNDARY_ALT) THEN
    REWRITE_TAC [ADD_SUB, cong, mod_subset, ← FRAG_MODULE
     (← q r"frag_sub x frag_0 = x")])

  return { HOMOLOGY_EXACTNESS_AXIOM_1, HOMOLOGY_EXACTNESS_AXIOM_2 }

/- ------------------------------------------------------------------------- -/
/- Third exactness axiom, dimension and homotopy axioms.                     -/
/- (homology.ml 4834-4951)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HAX where
  HOMOLOGY_EXACTNESS_AXIOM_3 : thm
  HOMOLOGY_DIMENSION_AXIOM : thm
  HOMOLOGY_HOMOTOPY_AXIOM : thm
  deriving Inhabited

@[nospecialize]
def setupHAX [HolBase] (D : HomologyDeps) (BSCH : SCH) (BMSR : MSR) (BRBD : RBD) (BHMR : HMR)
    (BBDB : BDB) (BSMP : SMP) (BSNG : SNG) (BHIV : HIV) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) :
    ExceptT String IO HAX := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, FRAG_MODULE, .. } := D
  let { EMPTY_SUBSET, EQ_TRANS, FORALL_IN_GSPEC, FUN_EQ_THM, IMAGE_CLAUSES, IN, INTER_SUBSET, .. } :=
    D.core1
  let { INT_NOT_LT, INT_OF_NUM_EQ, INT_OF_NUM_OF_INT, LEFT_IMP_EXISTS_THM, LE_1, .. } := D.core2
  let { GROUP_ID, .. } := D.grp1
  let { SINGLETON_GROUP, group_exactness, group_homomorphism, group_image, group_kernel,
        trivial_group, .. } := D.grp2
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, .. } := D.met1
  let { HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS, HOMOTOPIC_WITH_IMP_PROPERTY, .. } := D.met2
  let { SUBTOPOLOGY_RESTRICT, SUBTOPOLOGY_TOPSPACE, .. } := D.met3
  let { CHAIN_BOUNDARY_SUB, .. } := BSCH
  let { SINGULAR_CYCLE, SINGULAR_CYCLE_MONO, SINGULAR_RELCYCLE_NEG, singular_relcycle, .. } := BMSR
  let { SINGULAR_BOUNDARY, SINGULAR_CHAIN_IMP_RELBOUNDARY, SINGULAR_RELBOUNDARY_ALT, .. } := BRBD
  let { HOMOLOGOUS_REL_EQ, HOMOLOGOUS_REL_REFL, homologous_rel, .. } := BHMR
  let { CHAIN_BOUNDARY_BOUNDARY_ALT, .. } := BBDB
  let { CHAIN_MAP_ID, .. } := BSMP
  let { SINGULAR_BOUNDARY_EQ_CYCLE_SING, .. } := BSNG
  let { HOMOTOPIC_IMP_HOMOLOGOUS_REL_CHAIN_MAPS, .. } := BHIV
  let { HOMOLOGOUS_REL_EQ_RELBOUNDARY, RELATIVE_HOMOLOGY_GROUP, RELCYCLE_GROUP,
        TRIVIAL_RELATIVE_HOMOLOGY_GROUP, homology_group, relative_homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED_DEFAULT, HOM_INDUCED_TRIVIAL, .. } := BHIN
  let { HOM_INDUCED_CHAIN_MAP, .. } := BHIF
  -- @@SCOPE END

  let HOMOLOGY_EXACTNESS_AXIOM_3 ← prove
   r"!p top s:A->bool.
        group_exactness(homology_group(p,subtopology top s),
                        homology_group(p,top),
                        relative_homology_group(p,top,s))
                       (hom_induced p (subtopology top s,{}) (top,{}) (\x. x),
                        hom_induced p (top,{}) (top,s) (\x. x))"
   (MATCH_MP_TAC (← MESON [INT_OF_NUM_OF_INT, INT_NOT_LT]
     (← q r"(!x. x < &0 ==> P x) /\ (!p. P(&p)) ==> !x:int. P x")) THEN
    CONJ_TAC THENL
     [SIMP_TAC [group_exactness, homology_group, relative_homology_group,
                HOM_INDUCED_TRIVIAL, group_image, group_kernel,
                group_homomorphism, SINGLETON_GROUP] THEN
      SET_TAC [],
      ALL_TAC] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [homology_group, group_exactness] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED] THEN
    REWRITE_TAC [group_image, group_kernel, RELATIVE_HOMOLOGY_GROUP] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN {f y | P y} /\ Q x} = {f y |y| P y /\ Q(f y)}")] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE g {f y | P y} = { g(f y) | P y}")] THEN
    TRANS_TAC EQ_TRANS
     (← q r"{ homologous_rel (p,top:A topology,{}) c | c |
        singular_relcycle (p,subtopology top s,{}) c}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. P x ==> f x = g x) ==> {f x | P x} = {g x | P x}")) THEN
      X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [HOM_INDUCED_CHAIN_MAP, CONTINUOUS_MAP_ID, IMAGE_CLAUSES,
                    CONTINUOUS_MAP_FROM_SUBTOPOLOGY, EMPTY_SUBSET] THEN
      AP_TERM_TAC THEN MATCH_MP_TAC CHAIN_MAP_ID THEN
      ASM_MESON_TAC [singular_relcycle],
      ALL_TAC] THEN
    TRANS_TAC EQ_TRANS
     (← q r"{ homologous_rel (p,top:A topology,{}) c | c |
        singular_relcycle (p,top,{}) c /\
        singular_relboundary (p,top,s) c}") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. P x ==> (Q x <=> R x))
        ==> {f x | P x /\ Q x} = {f x | P x /\ R x}")) THEN
      REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM HOMOLOGOUS_REL_EQ_RELBOUNDARY] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      ASM_SIMP_TAC [HOM_INDUCED_CHAIN_MAP, CONTINUOUS_MAP_ID,
                    IMAGE_CLAUSES, EMPTY_SUBSET] THEN
      AP_TERM_TAC THEN MATCH_MP_TAC CHAIN_MAP_ID THEN
      ASM_MESON_TAC [singular_relcycle]] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. P x ==> ?y. Q y /\ f x = f y) /\
      (!x. Q x ==> ?y. P y /\ f x = f y)
      ==> {f x | P x} = {f x | Q x}")) THEN
    REWRITE_TAC [HOMOLOGOUS_REL_EQ] THEN CONJ_TAC THEN
    X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN STRIP_TAC THENL
     [EXISTS_TAC (← q r"c:((num->real)->A)frag") THEN
      REWRITE_TAC [HOMOLOGOUS_REL_REFL] THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_TOPSPACE] THEN
        MATCH_MP_TAC SINGULAR_CYCLE_MONO THEN
        EXISTS_TAC (← q r"topspace top INTER s:A->bool") THEN
        REWRITE_TAC [INTER_SUBSET, ← GSYM SUBTOPOLOGY_RESTRICT] THEN
        ASM_REWRITE_TAC [← GSYM SINGULAR_CYCLE],
        MATCH_MP_TAC SINGULAR_CHAIN_IMP_RELBOUNDARY THEN
        ASM_MESON_TAC [singular_relcycle]],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SINGULAR_RELBOUNDARY_ALT]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
       [← q r"e:((num->real)->A)frag", ← q r"d:((num->real)->A)frag"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"frag_neg d:((num->real)->A)frag") THEN
      REWRITE_TAC [homologous_rel, SINGULAR_RELCYCLE_NEG, ← FRAG_MODULE
       (← q r"frag_sub c (frag_neg d) = frag_add c d")] THEN
      CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [SINGULAR_CYCLE]) THEN
        ASM_REWRITE_TAC [SINGULAR_CYCLE] THEN
        FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← FRAG_MODULE
          (← q r"e = frag_add c d ==> d = frag_sub e c"))) THEN
        ASM_REWRITE_TAC [CHAIN_BOUNDARY_SUB] THEN
        REWRITE_TAC [← FRAG_MODULE (← q r"frag_sub x frag_0 = x")] THEN
        ASM_MESON_TAC [CHAIN_BOUNDARY_BOUNDARY_ALT],
        FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [SINGULAR_BOUNDARY] THEN
        ASM_MESON_TAC []]])

  let HOMOLOGY_DIMENSION_AXIOM ← prove
   r"!p top (a:A).
        topspace top = {a} /\ ~(p = &0)
        ==> trivial_group(homology_group(p,top))"
   (MATCH_MP_TAC (← MESON [INT_OF_NUM_OF_INT, INT_NOT_LT]
     (← q r"(!x. x < &0 ==> P x) /\ (!p. P(&p)) ==> !x:int. P x")) THEN
    SIMP_TAC [homology_group, INT_OF_NUM_EQ, TRIVIAL_RELATIVE_HOMOLOGY_GROUP] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [trivial_group] THEN
    REWRITE_TAC [← SET_RULE (← q r"s = {a} <=> a IN s /\ !b. b IN s ==> b = a")] THEN
    REWRITE_TAC [GROUP_ID] THEN REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, HOMOLOGOUS_REL_EQ_RELBOUNDARY] THEN
    ASM_MESON_TAC [SINGULAR_BOUNDARY_EQ_CYCLE_SING, LE_1])

  let HOMOLOGY_HOMOTOPY_AXIOM ← prove
   r"!p top s top' t (f:A->B) g.
           homotopic_with (\h. IMAGE h s SUBSET t) (top,top') f g
           ==> hom_induced p (top,s) (top',t) f =
               hom_induced p (top,s) (top',t) g"
   (MATCH_MP_TAC (← MESON [INT_OF_NUM_OF_INT, INT_NOT_LT]
     (← q r"(!x. x < &0 ==> P x) /\ (!p. P(&p)) ==> !x:int. P x")) THEN
    SIMP_TAC [HOM_INDUCED_TRIVIAL] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN MATCH_MP_TAC (← MESON []
     (← q r"!P. (!x. ~P x ==> Q x) /\ (!x. P x ==> Q x) ==> !x. Q x")) THEN
    EXISTS_TAC
     (← q r"\c. c IN group_carrier(relative_homology_group(&p,top:A topology,s))") THEN
    SIMP_TAC [HOM_INDUCED_DEFAULT] THEN
    REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [RELCYCLE_GROUP, IN] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_PROPERTY) THEN
    REWRITE_TAC [] THEN STRIP_TAC THEN FIRST_ASSUM (STRIP_ASSUME_TAC o
      MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS) THEN
    ASM_SIMP_TAC [HOM_INDUCED_CHAIN_MAP] THEN
    REWRITE_TAC [HOMOLOGOUS_REL_EQ] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_IMP_HOMOLOGOUS_REL_CHAIN_MAPS THEN
    ASM_MESON_TAC [])

  return { HOMOLOGY_EXACTNESS_AXIOM_3, HOMOLOGY_DIMENSION_AXIOM, HOMOLOGY_HOMOTOPY_AXIOM }

/- ------------------------------------------------------------------------- -/
/- Excision axiom.  (homology.ml 4952-5095)                                  -/
/- ------------------------------------------------------------------------- -/

structure HXA where
  HOMOLOGY_EXCISION_AXIOM : thm
  deriving Inhabited

@[nospecialize]
def setupHXA [HolBase] (D : HomologyDeps) (BSCH : SCH) (BMSR : MSR) (BRBD : RBD) (BHMR : HMR)
    (BBDB : BDB) (BSMP : SMP) (BITS : ITS) (BEXC : EXC) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) :
    ExceptT String IO HXA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, FRAG_MODULE, .. } := D
  let { ADD_SUB, CONJ_SYM, EXISTS_IN_GSPEC, FORALL_IN_GSPEC, IMP_CONJ, IMP_IMP, IN, .. } := D.core1
  let { INT_NOT_LT, INT_OF_NUM_OF_INT, IN_IMAGE, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, .. } := D.core3
  let { SUBSET, cong, .. } := D.core4
  let { GROUP_ISOMORPHISM, .. } := D.grp1
  let { QUOTIENT_GROUP, SINGLETON_GROUP, group_homomorphism, .. } := D.grp2
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, .. } := D.met1
  let { SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.met3
  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_ADD, CHAIN_BOUNDARY_SUB, SINGULAR_CHAIN_BOUNDARY,
        SINGULAR_CHAIN_SUB, SINGULAR_CHAIN_SUBTOPOLOGY, .. } := BSCH
  let { SINGULAR_RELCYCLE_SUB, mod_subset, singular_relcycle, .. } := BMSR
  let { SINGULAR_RELBOUNDARY_ALT, .. } := BRBD
  let { HOMOLOGOUS_REL_EQ, homologous_rel, .. } := BHMR
  let { CHAIN_BOUNDARY_BOUNDARY_ALT, .. } := BBDB
  let { CHAIN_MAP_ID, .. } := BSMP
  let { CHAIN_HOMOTOPIC_ITERATED_SINGULAR_SUBDIVISION, .. } := BITS
  let { EXCISED_CHAIN_EXISTS, EXCISED_RELCYCLE_EXISTS, .. } := BEXC
  let { NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP, NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE,
        RELCYCLE_GROUP, RIGHT_COSET_SINGULAR_RELBOUNDARY, relative_homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED_TRIVIAL, .. } := BHIN
  let { HOM_INDUCED_CHAIN_MAP, .. } := BHIF
  -- @@SCOPE END

  let HOMOLOGY_EXCISION_AXIOM ← prove
   r"!p top s t (u:A->bool).
        top closure_of u SUBSET top interior_of t /\ t SUBSET s
        ==> group_isomorphism
             (relative_homology_group(p,subtopology top (s DIFF u),t DIFF u),
              relative_homology_group(p,subtopology top s,t))
             (hom_induced p (subtopology top (s DIFF u),t DIFF u)
                            (subtopology top s,t) (\x. x))"
   (MATCH_MP_TAC (← MESON [INT_OF_NUM_OF_INT, INT_NOT_LT]
     (← q r"(!x. x < &0 ==> P x) /\ (!p. P(&p)) ==> !x:int. P x")) THEN
    CONJ_TAC THENL
     [SIMP_TAC [relative_homology_group, HOM_INDUCED_TRIVIAL] THEN
      REWRITE_TAC [GROUP_ISOMORPHISM, group_homomorphism, SINGLETON_GROUP] THEN
      SET_TAC [],
      ALL_TAC] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [GROUP_ISOMORPHISM] THEN
    REWRITE_TAC [group_homomorphism, ← SET_RULE
     (← q r"(IMAGE f s SUBSET t /\ P) /\ IMAGE f s = t /\ Q <=>
      (IMAGE f s SUBSET t /\ P) /\ t SUBSET IMAGE f s /\ Q")] THEN
    REWRITE_TAC [← GSYM group_homomorphism] THEN
    SUBGOAL_THEN
     (← q r"continuous_map (subtopology top (s DIFF u),subtopology top s) (\x. x) /\
      IMAGE (\x:A. x) (t DIFF u) SUBSET t")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF u = s INTER (s DIFF u)")] THEN
      SIMP_TAC [← GSYM SUBTOPOLOGY_SUBTOPOLOGY, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                CONTINUOUS_MAP_ID],
      ALL_TAC] THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED] THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC id [SUBSET] THEN
      REWRITE_TAC [NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP] THEN
      SIMP_TAC [QUOTIENT_GROUP,
                NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, RIGHT_COSET_SINGULAR_RELBOUNDARY] THEN
      X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN
      GEN_REWRITE_TAC LAND_CONV [IN] THEN
      REWRITE_TAC [RELCYCLE_GROUP] THEN DISCH_TAC THEN
      REWRITE_TAC [IN_IMAGE] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [EXISTS_IN_GSPEC] THEN MP_TAC (← ISPECL
       [← q r"p:num", ← q r"top:A topology", ← q r"s:A->bool", ← q r"t:A->bool",
        ← q r"u:A->bool", ← q r"c:((num->real)->A)frag"] EXCISED_RELCYCLE_EXISTS) THEN
      ASM_REWRITE_TAC [IN] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"d:((num->real)->A)frag") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [HOM_INDUCED_CHAIN_MAP] THEN
      FIRST_X_ASSUM (SUBST1_TAC o
        GEN_REWRITE_RULE id [← GSYM HOMOLOGOUS_REL_EQ]) THEN
      AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC CHAIN_MAP_ID THEN ASM_MESON_TAC [singular_relcycle],
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [NONTRIVIAL_RELATIVE_HOMOLOGY_GROUP] THEN
      SIMP_TAC [QUOTIENT_GROUP,
                NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, RIGHT_COSET_SINGULAR_RELBOUNDARY] THEN
      REWRITE_TAC [RELCYCLE_GROUP, IN] THEN
      X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"d:((num->real)->A)frag") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [HOM_INDUCED_CHAIN_MAP] THEN
      SUBGOAL_THEN
       (← q r"singular_chain(p,subtopology top (s DIFF u:A->bool)) c /\
        singular_chain(p,subtopology top (s DIFF u)) d")
      MP_TAC THENL [ASM_MESON_TAC [singular_relcycle], ALL_TAC] THEN
      DISCH_THEN (CONJUNCTS_THEN (SUBST1_TAC o MATCH_MP CHAIN_MAP_ID)) THEN
      REWRITE_TAC [HOMOLOGOUS_REL_EQ] THEN
      REWRITE_TAC [homologous_rel] THEN MAP_EVERY UNDISCH_TAC
       [← q r"singular_relcycle (p,subtopology top (s DIFF u:A->bool),t DIFF u) d",
        ← q r"singular_relcycle
          (p,subtopology top (s DIFF u:A->bool),t DIFF u) c"] THEN
      GEN_REWRITE_TAC id [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP SINGULAR_RELCYCLE_SUB) THEN
      SPEC_TAC (← q r"frag_sub c d:((num->real)->A)frag",
                ← q r"c:((num->real)->A)frag") THEN
      X_GEN_TAC (← q r"c:((num->real)->A)frag") THEN
      REWRITE_TAC [singular_relcycle, cong, mod_subset] THEN
      REWRITE_TAC [← FRAG_MODULE (← q r"frag_sub x frag_0 = x")] THEN
      ASM_SIMP_TAC [SUBTOPOLOGY_SUBTOPOLOGY, ← SET_RULE
       (← q r"t SUBSET s ==> (s DIFF u) INTER (t DIFF u) = t DIFF u")] THEN
      STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [SINGULAR_RELBOUNDARY_ALT] THEN
      ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, SUBTOPOLOGY_SUBTOPOLOGY, ← SET_RULE
       (← q r"t SUBSET s ==> s INTER t = t")] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"d:((num->real)->A)frag", ← q r"e:((num->real)->A)frag"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"p + 1", ← q r"top:A topology", ← q r"s:A->bool", ← q r"t:A->bool",
        ← q r"u:A->bool", ← q r"d:((num->real)->A)frag"] EXCISED_CHAIN_EXISTS) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
       [← q r"n:num", ← q r"f:((num->real)->A)frag", ← q r"g:((num->real)->A)frag"] THEN
      STRIP_TAC THEN
      X_CHOOSE_THEN (← q r"h:num->((num->real)->A)frag->((num->real)->A)frag") MP_TAC
       (← SPEC (← q r"n:num") CHAIN_HOMOTOPIC_ITERATED_SINGULAR_SUBDIVISION) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"p + 1", ← q r"subtopology top (s:A->bool)", ← q r"d:((num->real)->A)frag"]) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o AP_TERM
       (← q r"chain_boundary (p + 1):((num->real)->A)frag->((num->real)->A)frag")) THEN
      REWRITE_TAC [CHAIN_BOUNDARY_ADD, CHAIN_BOUNDARY_SUB] THEN
      MP_TAC (← ISPECL [← q r"p + 1", ← q r"subtopology top s:A topology"]
          CHAIN_BOUNDARY_BOUNDARY_ALT) THEN
      ASM_SIMP_TAC [← FRAG_MODULE (← q r"frag_add frag_0 c = c"), ADD_SUB] THEN
      DISCH_THEN (K ALL_TAC) THEN
      SUBST1_TAC (← FRAG_MODULE
       (← q r"frag_add c e:((num->real)->A)frag = frag_sub c (frag_sub frag_0 e)")) THEN
      ASM_REWRITE_TAC [CHAIN_BOUNDARY_SUB, CHAIN_BOUNDARY_0] THEN
      REWRITE_TAC [← FRAG_MODULE
       (← q r"frag_sub x (frag_sub frag_0 y) = frag_add x y")] THEN
      REWRITE_TAC [← FRAG_MODULE
       (← q r"frag_add c' e' = frag_sub (frag_add f g) (frag_add c e) <=>
        c = frag_add (frag_sub f c') (frag_sub (frag_sub g e) e')")] THEN
      REWRITE_TAC [← GSYM CHAIN_BOUNDARY_SUB] THEN
      ONCE_REWRITE_TAC [← FRAG_MODULE
       (← q r"c = frag_add c1 (frag_sub c2 c3) <=>
        c1 = frag_add c (frag_sub c3 c2)")] THEN
      REWRITE_TAC [SINGULAR_RELBOUNDARY_ALT] THEN
      MAP_EVERY ABBREV_TAC
       [← q r"c1 =
         frag_sub f ((h:num->((num->real)->A)frag->((num->real)->A)frag) p c)",
        ← q r"c2:((num->real)->A)frag =
         frag_sub (chain_boundary (p + 1) (h p e))
                  (frag_sub (chain_boundary (p + 1) g) e)"] THEN
      DISCH_TAC THEN REWRITE_TAC [SINGULAR_RELBOUNDARY_ALT] THEN
      MAP_EVERY EXISTS_TAC
       [← q r"c1:((num->real)->A)frag", ← q r"c2:((num->real)->A)frag"] THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [ASM_MESON_TAC [SINGULAR_CHAIN_SUB], DISCH_TAC] THEN
      SUBGOAL_THEN
       (← q r"singular_chain (p,subtopology top (s DIFF u:A->bool)) c2 /\
        singular_chain (p,subtopology top t) c2")
      MP_TAC THENL
       [CONJ_TAC THENL
         [FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP (← FRAG_MODULE
           (← q r"c1 = frag_add c c2 ==> c2 = frag_sub c1 c"))) THEN
          MATCH_MP_TAC SINGULAR_CHAIN_SUB THEN ASM_REWRITE_TAC [] THEN
          ASM_MESON_TAC [SINGULAR_CHAIN_BOUNDARY, ADD_SUB],
          EXPAND_TAC "c2" THEN
          REPEAT (MATCH_MP_TAC SINGULAR_CHAIN_SUB THEN CONJ_TAC) THEN
          ASM_MESON_TAC [SINGULAR_CHAIN_BOUNDARY, ADD_SUB]],
        REWRITE_TAC [SINGULAR_CHAIN_SUBTOPOLOGY] THEN ASM SET_TAC []]])

  return { HOMOLOGY_EXCISION_AXIOM }

/- ------------------------------------------------------------------------- -/
/- Additivity axiom; not in the original Eilenberg-Steenrod list but usually -/
/- included nowadays, following Milnor's "On Axiomatic Homology Theory".     -/
/- (homology.ml 5096-5232)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HCS where
  GROUP_ISOMORPHISM_CHAIN_GROUP_SUM : thm
  GROUP_ISOMORPHISM_CYCLE_GROUP_SUM : thm
  deriving Inhabited

@[nospecialize]
def setupHCS [HolBase] (D : HomologyDeps) (BSSX : SSX) (BSFC : SFC) (BSCH : SCH) (BMSR : MSR)
    (BHGP : HGP) : ExceptT String IO HCS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, .. } := D
  let { CONTRAPOS_THM, EQ_IMP, EXISTS_IN_UNIONS, FINITE_SUBSET, FORALL_IN_GSPEC, FUN_EQ_THM,
        IMP_CONJ, IN, INTER_SUBSET, .. } := D.core1
  let { IN_ELIM_THM, IN_INTER, ITERATE_EQ, ITERATE_SUPERSET, ITERATE_SUPPORT,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { RESTRICTION, RESTRICTION_EXTENSION, RESTRICTION_IN_CARTESIAN_PRODUCT,
        RIGHT_EXISTS_AND_THM, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_RESTRICT, UNIONS_GSPEC, UNIONS_SUBSET,
        cartesian_product, o_THM, pairwise, support, .. } := D.core4
  let { MONOIDAL_FRAG_ADD, NEUTRAL_FRAG_ADD, .. } := D.frag
  let { GROUPS_EQ, .. } := D.grp1
  let { GROUP_ISOMORPHISM_BETWEEN_SUBGROUPS, GROUP_ISOMORPHISM_FREE_ABELIAN_GROUP_SUM,
        GROUP_ISOMORPHISM_IMP_MONOMORPHISM, GROUP_MONOMORPHISM_ALT_EQ,
        SUBGROUP_GENERATED_RESTRICT, SUM_GROUP_CLAUSES, SUM_GROUP_SUBGROUP_GENERATED,
        group_homomorphism, group_isomorphism, group_isomorphisms, .. } := D.grp2
  let { COMPACT_IN_SUBTOPOLOGY, .. } := D.met1
  let { IMAGE_COMPACT_IN, .. } := D.met2
  let { PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE, PATH_CONNECTED_IN_SUBTOPOLOGY,
        SUBTOPOLOGY_TOPSPACE, .. } := D.met3
  let { COMPACT_IN_STANDARD_SIMPLEX, NONEMPTY_STANDARD_SIMPLEX,
        PATH_CONNECTED_IN_STANDARD_SIMPLEX, .. } := BSSX
  let { SINGULAR_SIMPLEX_SUBTOPOLOGY, singular_simplex, .. } := BSFC
  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_SUM, SINGULAR_CHAIN_BOUNDARY, SINGULAR_CHAIN_SUBTOPOLOGY,
        SINGULAR_CHAIN_SUM, chain_boundary, .. } := BSCH
  let { SINGULAR_CYCLE, .. } := BMSR
  let { CHAIN_GROUP, RELCYCLE_GROUP, SUBGROUP_SINGULAR_RELCYCLE, chain_group, relcycle_group, .. } :=
    BHGP
  -- @@SCOPE END

  let GROUP_ISOMORPHISM_CHAIN_GROUP_SUM ← prove
   r"!p top u:(A->bool)->bool.
     pairwise DISJOINT u /\ UNIONS u = topspace top /\
     (!c t. compact_in top c /\ path_connected_in top c /\
            t IN u /\ ~(DISJOINT c t)
            ==> c SUBSET t)
     ==> group_isomorphism (sum_group u (\s. chain_group(p,subtopology top s)),
                            chain_group(p,top))
                           (iterate frag_add u)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [chain_group] THEN
    W (MP_TAC o PART_MATCH (lhand o lhand o rand)
          GROUP_ISOMORPHISM_FREE_ABELIAN_GROUP_SUM o lhand o lhand o snd) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [pairwise] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN STRIP_TAC THEN
      REWRITE_TAC [← SET_RULE (← q r"DISJOINT s t <=> !x. s x /\ t x ==> F")] THEN
      X_GEN_TAC (← q r"f:(num->real)->A") THEN
      REWRITE_TAC [SINGULAR_SIMPLEX_SUBTOPOLOGY] THEN
      DISCH_THEN (CONJUNCTS_THEN (MP_TAC o CONJUNCT2)) THEN MATCH_MP_TAC (← SET_RULE
       (← q r"DISJOINT s t /\ ~(p = {})
        ==> IMAGE f p SUBSET t ==> IMAGE f p SUBSET s ==> F")) THEN
      REWRITE_TAC [NONEMPTY_STANDARD_SIMPLEX] THEN
      ASM_MESON_TAC [pairwise],
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN
      REPLICATE_TAC 3 AP_TERM_TAC THEN
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET] THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, SUBSET, ← SET_RULE
       (← q r"c IN singular_simplex (p,top) <=> singular_simplex (p,top) c")] THEN
      SIMP_TAC [SINGULAR_SIMPLEX_SUBTOPOLOGY] THEN
      X_GEN_TAC (← q r"f:(num->real)->A") THEN
      GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o RAND_CONV)
       [← GSYM SUBTOPOLOGY_TOPSPACE] THEN
      REWRITE_TAC [SINGULAR_SIMPLEX_SUBTOPOLOGY] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"IMAGE f p SUBSET s ==> ~(p = {})
        ==> ?x. x IN s /\ x IN IMAGE f p")))) THEN
      REWRITE_TAC [NONEMPTY_STANDARD_SIMPLEX] THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [EXISTS_IN_UNIONS] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"t:A->bool") THEN REWRITE_TAC [RIGHT_EXISTS_AND_THM, ← SET_RULE
       (← q r"(?x. x IN t /\ x IN s) <=> ~(DISJOINT s t)")] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC IMAGE_COMPACT_IN,
        MATCH_MP_TAC PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE] THEN
      EXISTS_TAC (← q r"subtopology (product_topology (:num) (\i. euclideanreal))
                              (standard_simplex p)") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [singular_simplex]) THEN
      ASM_REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, PATH_CONNECTED_IN_SUBTOPOLOGY,
          COMPACT_IN_STANDARD_SIMPLEX, PATH_CONNECTED_IN_STANDARD_SIMPLEX,
          SUBSET_REFL]])

  let GROUP_ISOMORPHISM_CYCLE_GROUP_SUM ← prove
   r"!p top u:(A->bool)->bool.
     pairwise DISJOINT u /\ UNIONS u = topspace top /\
     (!c t. compact_in top c /\ path_connected_in top c /\
            t IN u /\ ~(DISJOINT c t)
            ==> c SUBSET t)
     ==> group_isomorphism
          (sum_group u (\t. relcycle_group(p,subtopology top t,{})),
           relcycle_group(p,top,{}))
          (iterate frag_add u)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"p = 0") THENL
     [SUBGOAL_THEN
       (← q r"!top:A topology. relcycle_group(p,top,{}) = chain_group(p,top)")
        (fun th => REWRITE_TAC [th])
      THENL
       [REWRITE_TAC [GROUPS_EQ, RELCYCLE_GROUP, CHAIN_GROUP] THEN
        REWRITE_TAC [FUN_EQ_THM, SINGULAR_CYCLE] THEN
        ASM_REWRITE_TAC [chain_boundary],
        MATCH_MP_TAC GROUP_ISOMORPHISM_CHAIN_GROUP_SUM THEN
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    REWRITE_TAC [relcycle_group] THEN
    SIMP_TAC [SUM_GROUP_SUBGROUP_GENERATED, SUBGROUP_SINGULAR_RELCYCLE] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
     [SUBGROUP_GENERATED_RESTRICT] THEN
    MATCH_MP_TAC GROUP_ISOMORPHISM_BETWEEN_SUBGROUPS THEN
    REWRITE_TAC [INTER_SUBSET] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC GROUP_ISOMORPHISM_CHAIN_GROUP_SUM THEN
      ASM_REWRITE_TAC [],
      REWRITE_TAC [group_isomorphism, group_isomorphisms, group_homomorphism,
                   LEFT_IMP_EXISTS_THM]] THEN
    GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET u /\ t SUBSET v /\
      (!x. x IN u ==> (f x IN t <=> x IN s))
      ==> (IMAGE f u SUBSET v /\ P) /\ (IMAGE f' v SUBSET u /\ Q) /\
          (!x. x IN u ==> f'(f x) = x) /\ (!y. y IN v ==> f(f' y) = y)
          ==> IMAGE f s = t")) THEN
    SIMP_TAC [INTER_SUBSET, IN_INTER] THEN CONJ_TAC THENL
     [REWRITE_TAC [CHAIN_GROUP, SUBSET, IN] THEN SIMP_TAC [SINGULAR_CYCLE],
      X_GEN_TAC (← q r"z:(A->bool)->((num->real)->A)frag")] THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, cartesian_product,
                 IN_ELIM_THM, CHAIN_GROUP] THEN
    REWRITE_TAC [← SET_RULE (← q r"z IN singular_relcycle q <=> singular_relcycle q z"),
                 ← SET_RULE (← q r"z IN singular_chain q <=> singular_chain q z")] THEN
    REWRITE_TAC [SINGULAR_CYCLE] THEN STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    ONCE_REWRITE_TAC [← GSYM ITERATE_SUPPORT] THEN
    REWRITE_TAC [support, NEUTRAL_FRAG_ADD] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (q <=> r) ==> (p /\ q <=> r)")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC SINGULAR_CHAIN_SUM THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SINGULAR_CHAIN_SUBTOPOLOGY]) THEN
      ASM_SIMP_TAC [IN_ELIM_THM],
      ASM_SIMP_TAC [CHAIN_BOUNDARY_SUM]] THEN
    MP_TAC (← ISPECL [← q r"p - 1", ← q r"top:A topology", ← q r"u:(A->bool)->bool"]
          GROUP_ISOMORPHISM_CHAIN_GROUP_SUM) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o MATCH_MP GROUP_ISOMORPHISM_IMP_MONOMORPHISM) THEN
    REWRITE_TAC [GROUP_MONOMORPHISM_ALT_EQ] THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"RESTRICTION u (chain_boundary p o (z:(A->bool)->((num->real)->A)frag))") o
     CONJUNCT2) THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, CHAIN_GROUP, RESTRICTION_EXTENSION] THEN
    REWRITE_TAC [IN_ELIM_THM, RESTRICTION_IN_CARTESIAN_PRODUCT, o_THM] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN REWRITE_TAC [IN] THEN
        ASM_SIMP_TAC [SINGULAR_CHAIN_BOUNDARY],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"t:A->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        ASM_REWRITE_TAC [CONTRAPOS_THM, RESTRICTION, o_THM] THEN
        SIMP_TAC [CHAIN_BOUNDARY_0]],
      DISCH_THEN (SUBST1_TAC o SYM) THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      MATCH_MP_TAC (← MESON []
       (← q r"iterate f u (RESTRICTION u x) = iterate f u x /\ iterate f u x = y
        ==> y = iterate f u (RESTRICTION u x)")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← MATCH_MP ITERATE_EQ MONOIDAL_FRAG_ADD) THEN
        SIMP_TAC [RESTRICTION],
        MATCH_MP_TAC (← MATCH_MP ITERATE_SUPERSET MONOIDAL_FRAG_ADD) THEN
        SIMP_TAC [SUBSET_RESTRICT, IN_ELIM_THM, IMP_CONJ] THEN
        SIMP_TAC [o_THM, NEUTRAL_FRAG_ADD, CHAIN_BOUNDARY_0]]])

  return { GROUP_ISOMORPHISM_CHAIN_GROUP_SUM, GROUP_ISOMORPHISM_CYCLE_GROUP_SUM }

/- ------------------------------------------------------------------------- -/
/- Additivity axiom.  (homology.ml 5233-5517)                                -/
/- ------------------------------------------------------------------------- -/

structure HAD where
  HOMOLOGY_ADDITIVITY_AXIOM_GEN : thm
  HOMOLOGY_ADDITIVITY_AXIOM : thm
  deriving Inhabited

@[nospecialize]
def setupHAD [HolBase] (D : HomologyDeps) (BSCH : SCH) (BMSR : MSR) (BRBD : RBD) (BHMR : HMR)
    (BSMP : SMP) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) (BHCS : HCS) :
    ExceptT String IO HAD := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_ARITH, MESON, MESON_TAC, SET_RULE, SET_TAC, FRAG_MODULE, .. } := D
  let { CONTRAPOS_THM, DIFF_UNIONS_PAIRWISE_DISJOINT, EMPTY_GSPEC, EMPTY_SUBSET, EQ_TRANS, ETA_AX,
        EXISTS_IN_IMAGE, EXTENSION, EXTENSIONAL, FINITE_INDUCT_STRONG, FINITE_SUBSET,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, FUN_IN_IMAGE,
        IMAGE_CLAUSES, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN, .. } := D.core1
  let { INT_NOT_LT, INT_OF_NUM_OF_INT, IN_DIFF, IN_ELIM_THM, IN_IMAGE, ITERATE_CLAUSES,
        ITERATE_EQ, ITERATE_SUPERSET, ITERATE_SUPPORT, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_FORALL,
        NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, NUM_OF_INT_OF_NUM, .. } := D.core2
  let { RESTRICTION, RESTRICTION_EXTENSION, RESTRICTION_IN_CARTESIAN_PRODUCT,
        RESTRICTION_IN_EXTENSIONAL, .. } := D.core3
  let { RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE_GEN, SING_SUBSET, SKOLEM_THM,
        SUBSET, SUBSET_ANTISYM_EQ, SUBSET_RESTRICT, cartesian_product, o_DEF, o_THM, support, .. } :=
    D.core4
  let { MONOIDAL_FRAG_ADD, NEUTRAL_FRAG_ADD, .. } := D.frag
  let { ABELIAN_GROUP_HOMOMORPHISM_GROUP_SUM, ABELIAN_GROUP_SUM_ITERATE, ABELIAN_SINGLETON_GROUP,
        GROUP_ADD_EQ_MUL, GROUP_EPIMORPHISM_ALT, GROUP_HOMOMORPHISM_EQ, .. } := D.grp1
  let { GROUP_ISOMORPHISM_TRIVIAL, GROUP_MONOMORPHISM_ALT, GROUP_MONOMORPHISM_EPIMORPHISM,
        MONOIDAL_GROUP_ADD, NEUTRAL_GROUP_ADD, QUOTIENT_GROUP_MUL, SINGLETON_GROUP,
        SUM_GROUP_CLAUSES, TRIVIAL_GROUP_SINGLETON_GROUP, TRIVIAL_GROUP_SUBGROUP_GENERATED,
        TRIVIAL_PRODUCT_GROUP, group_epimorphism, group_image, group_monomorphism, sum_group, .. } :=
    D.grp2
  let { CONNECTED_IN, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, .. } := D.met1
  let { OPEN_IN_UNIONS, .. } := D.met2
  let { PATH_CONNECTED_IN_IMP_CONNECTED_IN, .. } := D.met3
  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_SUM, SINGULAR_CHAIN_BOUNDARY_ALT,
        SINGULAR_CHAIN_SUBTOPOLOGY, .. } := BSCH
  let { SINGULAR_CYCLE, SINGULAR_RELCYCLE_0, SINGULAR_RELCYCLE_SUM, .. } := BMSR
  let { SINGULAR_BOUNDARY, SINGULAR_RELBOUNDARY_0, .. } := BRBD
  let { HOMOLOGOUS_REL_EQ, homologous_rel, .. } := BHMR
  let { CHAIN_MAP_ID, .. } := BSMP
  let { CHAIN_GROUP, HOMOLOGOUS_REL_EQ_RELBOUNDARY, NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE,
        RELATIVE_HOMOLOGY_GROUP, RELCYCLE_GROUP, RIGHT_COSET_SINGULAR_RELBOUNDARY, homology_group,
        relative_homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED, HOM_INDUCED_TRIVIAL, .. } := BHIN
  let { ABELIAN_RELATIVE_HOMOLOGY_GROUP, HOM_INDUCED_CHAIN_MAP, .. } := BHIF
  let { GROUP_ISOMORPHISM_CHAIN_GROUP_SUM, GROUP_ISOMORPHISM_CYCLE_GROUP_SUM, .. } := BHCS
  -- @@SCOPE END

  let HOMOLOGY_ADDITIVITY_AXIOM_GEN ← prove
   r"!p top u:(A->bool)->bool.
     pairwise DISJOINT u /\ UNIONS u = topspace top /\
     (!c t. compact_in top c /\ path_connected_in top c /\
            t IN u /\ ~(DISJOINT c t)
            ==> c SUBSET t)
     ==> group_isomorphism
          (sum_group u (\s. homology_group(p,subtopology top s)),
           homology_group(p,top))
          (\x. iterate (group_add (homology_group(p,top))) u
           (\v. hom_induced p (subtopology top v,{}) (top,{}) (\z. z) (x v)))"
   (MATCH_MP_TAC (← MESON [INT_OF_NUM_OF_INT, INT_NOT_LT]
     (← q r"(!x. x < &0 ==> P x) /\ (!p. P(&p)) ==> !x:int. P x")) THEN
    CONJ_TAC THENL
     [SIMP_TAC [homology_group, relative_homology_group] THEN
      ASM_SIMP_TAC [HOM_INDUCED_TRIVIAL] THEN REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← GSYM ITERATE_SUPPORT] THEN
      REWRITE_TAC [support, NEUTRAL_GROUP_ADD, SINGLETON_GROUP, EMPTY_GSPEC] THEN
      SIMP_TAC [ITERATE_CLAUSES, MONOIDAL_GROUP_ADD, ABELIAN_SINGLETON_GROUP] THEN
      REWRITE_TAC [NEUTRAL_GROUP_ADD, GROUP_ISOMORPHISM_TRIVIAL] THEN
      REWRITE_TAC [TRIVIAL_GROUP_SINGLETON_GROUP] THEN
      REWRITE_TAC [sum_group] THEN
      MATCH_MP_TAC TRIVIAL_GROUP_SUBGROUP_GENERATED THEN
      REWRITE_TAC [TRIVIAL_PRODUCT_GROUP, TRIVIAL_GROUP_SINGLETON_GROUP],
      REPEAT STRIP_TAC] THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM,
                 GROUP_EPIMORPHISM_ALT, GROUP_MONOMORPHISM_ALT] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q /\ r) ==> (p /\ q) /\ (p /\ r)")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC GROUP_HOMOMORPHISM_EQ THEN
      EXISTS_TAC (← q r"\x. group_sum (homology_group (&p,top:A topology)) u
                   (\v. hom_induced (&p) (subtopology top v,{}) (top,{})
                                         (\z. z) (x v))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC ABELIAN_GROUP_HOMOMORPHISM_GROUP_SUM THEN
        REWRITE_TAC [homology_group, ETA_AX, ABELIAN_RELATIVE_HOMOLOGY_GROUP] THEN
        REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED],
        REPEAT GEN_TAC THEN REWRITE_TAC [] THEN DISCH_TAC THEN
        MATCH_MP_TAC (← GSYM ABELIAN_GROUP_SUM_ITERATE) THEN
        ASM_REWRITE_TAC [homology_group, ETA_AX, ABELIAN_RELATIVE_HOMOLOGY_GROUP,
                         HOM_INDUCED]],
      DISCH_TAC] THEN
    REWRITE_TAC [group_image] THEN
    SUBGOAL_THEN
     (← q r"group_carrier(sum_group u
         (\s:A->bool. homology_group (&p,subtopology top s))) =
      IMAGE (\x. RESTRICTION u
                    (\s. homologous_rel (p,subtopology top s,{}) (x s)))
            (group_carrier
              (sum_group u (\s. relcycle_group(p,subtopology top s,{}))))")
    SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP, SUM_GROUP_CLAUSES, homology_group] THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
      REWRITE_TAC [← REWRITE_RULE [IN] RESTRICTION_IN_EXTENSIONAL] THEN
      CONJ_TAC THENL
       [ALL_TAC,
        ONCE_REWRITE_TAC [← TAUT (← q r"p /\ ~q <=> ~(p ==> q)")] THEN
        SIMP_TAC [RESTRICTION, HOMOLOGOUS_REL_EQ_RELBOUNDARY] THEN
        REWRITE_TAC [RELCYCLE_GROUP] THEN
        GEN_TAC THEN MATCH_MP_TAC MONO_AND THEN
        CONJ_TAC THENL [MESON_TAC [IN], ALL_TAC] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, NOT_IMP] THEN
        MESON_TAC [SINGULAR_RELBOUNDARY_0]] THEN
      X_GEN_TAC (← q r"z:(A->bool)->((num->real)->A)frag->bool") THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE BINDER_CONV [RIGHT_IMP_EXISTS_THM]) THEN
      REWRITE_TAC [SKOLEM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:(A->bool)->((num->real)->A)frag") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"RESTRICTION u
       (\s. if singular_relboundary (p,subtopology top s,{}) (c s)
            then frag_0
            else (c:(A->bool)->((num->real)->A)frag) s)") THEN
      REWRITE_TAC [IN_ELIM_THM, ← REWRITE_RULE [IN] RESTRICTION_IN_EXTENSIONAL] THEN
      GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ ~q <=> ~(p ==> q)")] THEN
      SIMP_TAC [RESTRICTION] THEN REPEAT CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [EXTENSIONAL, IN_ELIM_THM]) THEN
        GEN_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [HOMOLOGOUS_REL_EQ] THEN
        ASM_REWRITE_TAC [homologous_rel, ← FRAG_MODULE (← q r"frag_sub c frag_0 = c")],
        REPEAT STRIP_TAC THEN
        REWRITE_TAC [RELCYCLE_GROUP, IN] THEN
        COND_CASES_TAC THEN ASM_SIMP_TAC [SINGULAR_RELCYCLE_0],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
        REWRITE_TAC [SUBSET, NOT_IMP, IN_ELIM_THM] THEN
        GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        ASM_SIMP_TAC [CONTRAPOS_THM] THEN
        SIMP_TAC [HOMOLOGOUS_REL_EQ_RELBOUNDARY] THEN
        REWRITE_TAC [RELCYCLE_GROUP]],
      ALL_TAC] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN REWRITE_TAC [← SET_RULE
     (← q r"t SUBSET IMAGE f s <=> !y. y IN t ==> ~(!x. x IN s ==> ~(f x = y))")] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN group_carrier
            (sum_group u (\s. relcycle_group (p,subtopology top s,{})))
          ==> iterate (group_add (homology_group (&p,top))) u
               (\v. hom_induced (&p) (subtopology top v,{}) (top,{}) (\z:A. z)
                    (RESTRICTION u
                     (\s. homologous_rel (p,subtopology top s,{}) (x s)) v)) =
              homologous_rel(p,top,{}) (iterate frag_add u x)")
     (fun th => SIMP_TAC [th])
    THENL
     [REWRITE_TAC [SUM_GROUP_CLAUSES, cartesian_product, IN_ELIM_THM] THEN
      REWRITE_TAC [RELCYCLE_GROUP, ← SET_RULE
       (← q r"x IN singular_relcycle q <=> singular_relcycle q x")] THEN
      X_GEN_TAC (← q r"z:(A->bool)->((num->real)->A)frag") THEN STRIP_TAC THEN
      TRANS_TAC EQ_TRANS
       (← q r"iterate (group_add (homology_group (&p,top:A topology))) u
                (\s:A->bool. homologous_rel (p,top,{}) (z s))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
          ITERATE_EQ) THEN
        REWRITE_TAC [MONOIDAL_GROUP_ADD, ABELIAN_RELATIVE_HOMOLOGY_GROUP,
                     homology_group] THEN
        SIMP_TAC [RESTRICTION] THEN X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
        ASM_SIMP_TAC [HOM_INDUCED_CHAIN_MAP, CONTINUOUS_MAP_ID,
          CONTINUOUS_MAP_FROM_SUBTOPOLOGY, IMAGE_CLAUSES, EMPTY_SUBSET] THEN
        AP_TERM_TAC THEN MATCH_MP_TAC CHAIN_MAP_ID THEN
        ASM_MESON_TAC [SINGULAR_CYCLE],
        ALL_TAC] THEN
      TRANS_TAC EQ_TRANS
       (← q r"iterate (group_add (homology_group (&p,top:A topology)))
                {s:A->bool | s IN u /\ ~(z s = frag_0)}
                (\s. homologous_rel (p,top,{}) (z s))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
          ITERATE_SUPERSET) THEN
        REWRITE_TAC [MONOIDAL_GROUP_ADD, ABELIAN_RELATIVE_HOMOLOGY_GROUP,
                     homology_group, SUBSET_RESTRICT, IN_ELIM_THM] THEN
        SIMP_TAC [IMP_CONJ, RELATIVE_HOMOLOGY_GROUP, NEUTRAL_GROUP_ADD] THEN
        REPEAT STRIP_TAC THEN REWRITE_TAC [HOMOLOGOUS_REL_EQ_RELBOUNDARY] THEN
        REWRITE_TAC [SINGULAR_RELBOUNDARY_0],
        ALL_TAC] THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
       [← GSYM ITERATE_SUPPORT] THEN
      REWRITE_TAC [support, NEUTRAL_FRAG_ADD] THEN
      SUBGOAL_THEN
       (← q r"!s:A->bool. s IN {i | i IN u /\ ~(z i = frag_0)}
                    ==> singular_relcycle (p,subtopology top s,{}) (z s)")
      MP_TAC THENL [ASM_SIMP_TAC [IN_ELIM_THM], ALL_TAC] THEN
      UNDISCH_TAC (← q r"FINITE {s:A->bool | s IN u /\
                        ~(z s:((num->real)->A)frag = frag_0)}") THEN
      SPEC_TAC (← q r"{s:A->bool | s IN u /\ ~(z s:((num->real)->A)frag = frag_0)}",
                ← q r"v:(A->bool)->bool") THEN
      MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
      REWRITE_TAC [NOT_IN_EMPTY, FORALL_IN_INSERT] THEN
      SIMP_TAC [ITERATE_CLAUSES, MONOIDAL_FRAG_ADD, MONOIDAL_GROUP_ADD,
                homology_group, ABELIAN_RELATIVE_HOMOLOGY_GROUP] THEN
      REWRITE_TAC [NEUTRAL_GROUP_ADD, NEUTRAL_FRAG_ADD] THEN
      REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP] THEN CONV_TAC (LAND_CONV SYM_CONV) THEN
      REWRITE_TAC [HOMOLOGOUS_REL_EQ_RELBOUNDARY] THEN
      REWRITE_TAC [SINGULAR_RELBOUNDARY_0] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"v:(A->bool)->bool"] THEN
      REPEAT STRIP_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand) GROUP_ADD_EQ_MUL o lhand o snd) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN REWRITE_TAC [ETA_AX] THEN
        CONJ_TAC THEN MATCH_MP_TAC FUN_IN_IMAGE THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_MESON_TAC [SINGULAR_CYCLE, SINGULAR_CHAIN_SUBTOPOLOGY,
                       SINGULAR_RELCYCLE_SUM],
        DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [relative_homology_group] THEN
      REWRITE_TAC [NUM_OF_INT_OF_NUM, ← INT_ARITH (← q r"~(&p:int < &0)")] THEN
      REWRITE_TAC [← GSYM RIGHT_COSET_SINGULAR_RELBOUNDARY] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) QUOTIENT_GROUP_MUL o
          lhand o snd) THEN
      REWRITE_TAC [NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [RELCYCLE_GROUP] THEN REWRITE_TAC [IN] THEN
        ASM_MESON_TAC [SINGULAR_CYCLE, SINGULAR_CHAIN_SUBTOPOLOGY,
                       SINGULAR_RELCYCLE_SUM],
        DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [RELCYCLE_GROUP]],
      ALL_TAC] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [homology_group, RELATIVE_HOMOLOGY_GROUP, FORALL_IN_GSPEC] THEN
      MP_TAC (← ISPECL [← q r"p:num", ← q r"top:A topology", ← q r"u:(A->bool)->bool"]
          GROUP_ISOMORPHISM_CYCLE_GROUP_SUM) THEN
      ASM_REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
      REWRITE_TAC [group_epimorphism] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC (← MATCH_MP (← SET_RULE
          (← q r"IMAGE f s = t ==> !y. y IN t ==> ?x. x IN s /\ f x = y"))
          (← liftExcept (last (CONJUNCTS th)))))) THEN
      REWRITE_TAC [RELCYCLE_GROUP] THEN MESON_TAC [IN]] THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, RESTRICTION_EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [homology_group, RELATIVE_HOMOLOGY_GROUP] THEN
    REWRITE_TAC [HOMOLOGOUS_REL_EQ_RELBOUNDARY, RELCYCLE_GROUP] THEN
    SIMP_TAC [cartesian_product, IN_ELIM_THM, SINGULAR_BOUNDARY, ← SET_RULE
     (← q r"x IN singular_relcycle p <=> singular_relcycle p x")] THEN
    X_GEN_TAC (← q r"z:(A->bool)->((num->real)->A)frag") THEN
    STRIP_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:((num->real)->A)frag") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"p + 1", ← q r"top:A topology", ← q r"u:(A->bool)->bool"]
          GROUP_ISOMORPHISM_CHAIN_GROUP_SUM) THEN
    ASM_REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
      GEN_REWRITE_RULE id [group_epimorphism]) THEN
    GEN_REWRITE_TAC LAND_CONV [EXTENSION] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"d:((num->real)->A)frag")) THEN
    REWRITE_TAC [← SET_RULE
     (← q r"(y IN IMAGE f s <=> x IN t) <=> ((?x. x IN s /\ f x = y) <=> t x)")] THEN
    ASM_REWRITE_TAC [CHAIN_GROUP, SUM_GROUP_CLAUSES, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"w:(A->bool)->((num->real)->A)frag") THEN
    REWRITE_TAC [cartesian_product, IN_ELIM_THM, ← SET_RULE
      (← q r"x IN singular_chain p <=> singular_chain p x")] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC (SUBST_ALL_TAC o SYM)) THEN
    MP_TAC (← ISPECL [← q r"p:num", ← q r"top:A topology", ← q r"u:(A->bool)->bool"]
          GROUP_ISOMORPHISM_CHAIN_GROUP_SUM) THEN
    ASM_REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    REWRITE_TAC [group_monomorphism] THEN DISCH_THEN (MP_TAC o SPECL
     [← q r"RESTRICTION u
         (\s. chain_boundary (p + 1)
                ((w:(A->bool)->((num->real)->A)frag) s))",
      ← q r"z:(A->bool)->((num->real)->A)frag"] o
     CONJUNCT2 o CONJUNCT1) THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, IN_ELIM_THM,
                 RESTRICTION_IN_CARTESIAN_PRODUCT] THEN
    ASM_REWRITE_TAC [CHAIN_GROUP, cartesian_product, IN_ELIM_THM, ← SET_RULE
      (← q r"x IN singular_chain p <=> singular_chain p x")] THEN
    ASM_SIMP_TAC [SINGULAR_CHAIN_BOUNDARY_ALT] THEN
    ANTS_TAC THENL
     [ALL_TAC,
      GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"s:A->bool") THEN
      ASM_CASES_TAC (← q r"(s:A->bool) IN u") THEN ASM_REWRITE_TAC [RESTRICTION] THEN
      ASM_MESON_TAC []] THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"p /\ ~q <=> ~(p ==> q)")] THEN
      SIMP_TAC [RESTRICTION] THEN MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
       (← q r"{s:A->bool | s IN u /\ ~(w s:((num->real)->A)frag = frag_0)}") THEN
      ASM_REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MESON_TAC [CHAIN_BOUNDARY_0],
      ASM_MESON_TAC [SINGULAR_CYCLE],
      ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM ITERATE_SUPPORT] THEN
    REWRITE_TAC [support, NEUTRAL_FRAG_ADD] THEN
    ASM_SIMP_TAC [CHAIN_BOUNDARY_SUM] THEN TRANS_TAC EQ_TRANS
     (← q r"iterate frag_add u
        (chain_boundary (p + 1) o (w:(A->bool)->((num->real)->A)frag))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
          ITERATE_EQ) THEN
      SIMP_TAC [MONOIDAL_FRAG_ADD, RESTRICTION, o_THM],
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
          ITERATE_SUPERSET) THEN
      REWRITE_TAC [SUBSET_RESTRICT, MONOIDAL_FRAG_ADD] THEN
      SIMP_TAC [NEUTRAL_FRAG_ADD, IMP_CONJ, IN_ELIM_THM, o_THM] THEN
      REWRITE_TAC [CHAIN_BOUNDARY_0]])

  let HOMOLOGY_ADDITIVITY_AXIOM ← prove
   r"!p top u:(A->bool)->bool.
     (!v. v IN u ==> open_in top v) /\
     pairwise DISJOINT u /\
     UNIONS u = topspace top
     ==> group_isomorphism
          (sum_group u (\s. homology_group(p,subtopology top s)),
           homology_group(p,top))
          (\x. iterate (group_add (homology_group(p,top))) u
           (\v. hom_induced p (subtopology top v,{}) (top,{}) (\z. z) (x v)))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOLOGY_ADDITIVITY_AXIOM_GEN THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"t:A->bool"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP PATH_CONNECTED_IN_IMP_CONNECTED_IN) THEN
    REWRITE_TAC [CONNECTED_IN] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p /\ ~r ==> q) ==> p /\ ~q ==> r")) THEN
    STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"t:A->bool", ← q r"UNIONS (u DIFF {t:A->bool})"] THEN
    ASM_SIMP_TAC [OPEN_IN_UNIONS, IN_DIFF] THEN
    ASM_SIMP_TAC [← GSYM DIFF_UNIONS_PAIRWISE_DISJOINT, SING_SUBSET] THEN
    ASM SET_TAC [])

  return { HOMOLOGY_ADDITIVITY_AXIOM_GEN, HOMOLOGY_ADDITIVITY_AXIOM }

/- ------------------------------------------------------------------------- -/
/- Special properties of singular homology, in particular the fact that the  -/
/- zeroth homology group is isomorphic to the free abelian group generated   -/
/- by the path components, and so the "coefficient group" is the integers.   -/
/- (homology.ml 5518-5675)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HZ0 where
  GROUP_ISOMORPHISM_INTEGER_ZEROTH_HOMOLOGY_GROUP : thm
  ISOMORPHIC_GROUP_INTEGER_ZEROTH_HOMOLOGY_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupHZ0 [HolBase] (D : HomologyDeps) (BSSX : SSX) (BSFC : SFC) (BSCH : SCH) (BMSR : MSR)
    (BRBD : RBD) (BHMR : HMR) (BHGP : HGP) : ExceptT String IO HZ0 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, FRAG_MODULE,
        INT_REDUCE_CONV, NUMSEG_CONV, NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV, num_CONV, .. } := D
  let { ADD_CLAUSES, CARTESIAN_PRODUCT_UNIV, ETA_AX, EXTENSIONAL, FINITE_EMPTY, FINITE_INSERT,
        FORALL_IN_GSPEC, FUN_EQ_THM, FUN_IN_IMAGE, IN, INTER_SUBSET, .. } := D.core1
  let { INT_LT_REFL, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_SING, IN_UNIV, ITERATE_CLAUSES,
        ITERATE_CLAUSES_NUMSEG, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, LE_0, LT,
        MEMBER_NOT_EMPTY, MONO_FORALL, NOT_IN_EMPTY, NUM_OF_INT_OF_NUM, .. } := D.core2
  let { RESTRICTION, RESTRICTION_IN_EXTENSIONAL, RIGHT_AND_EXISTS_THM, .. } := D.core3
  let { SIMPLE_IMAGE_GEN, SUBSET, SUB_REFL, SUM_CLAUSES_NUMSEG, o_DEF, o_THM, .. } := D.core4
  let { IN_REAL_INTERVAL, .. } := D.lib
  let { FRAG_EXTEND_0, FRAG_EXTEND_ADD, FRAG_EXTEND_CMUL, FRAG_EXTEND_OF, FRAG_EXTEND_SUB,
        FRAG_INDUCTION, FRAG_OF_NONZERO, MONOIDAL_FRAG_ADD, NEUTRAL_FRAG_ADD, .. } := D.frag
  let { FREE_ABELIAN_GROUP_ZPOW, GROUP_EPIMORPHISM_ALT, GROUP_HOMOMORPHISM_GROUP_ZPOW, .. } :=
    D.grp1
  let { GROUP_MONOMORPHISM_ALT, GROUP_MONOMORPHISM_EPIMORPHISM, GROUP_ZPOW_SUBGROUP_GENERATED,
        INTEGER_GROUP, ISOMORPHIC_GROUP_SYM, QUOTIENT_GROUP_ZPOW, group_image, isomorphic_group,
        .. } := D.grp2
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := D.met1
  let { RESTRICTION_CONTINUOUS_MAP, TOPSPACE_EUCLIDEANREAL, TOPSPACE_PRODUCT_TOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, continuous_map, path_connected_space, path_in, .. } := D.met3
  let { STANDARD_SIMPLEX_0, standard_simplex, .. } := BSSX
  let { simplicial_face, singular_face, singular_simplex, .. } := BSFC
  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_OF, CHAIN_BOUNDARY_SUB, SINGULAR_CHAIN_OF,
        chain_boundary, singular_chain, .. } := BSCH
  let { SINGULAR_CYCLE, .. } := BMSR
  let { SINGULAR_BOUNDARY, .. } := BRBD
  let { HOMOLOGOUS_REL_EQ, HOMOLOGOUS_REL_REFL, HOMOLOGOUS_REL_SUB, homologous_rel, .. } := BHMR
  let { HOMOLOGOUS_REL_EQ_RELBOUNDARY, NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE,
        RELATIVE_HOMOLOGY_GROUP, RELCYCLE_GROUP, RIGHT_COSET_SINGULAR_RELBOUNDARY, chain_group,
        homology_group, relative_homology_group, relcycle_group, .. } := BHGP
  -- @@SCOPE END

  let GROUP_ISOMORPHISM_INTEGER_ZEROTH_HOMOLOGY_GROUP ← do
    let lemma ← prove
     r"!(top:A topology) f f'.
            path_connected_space top /\
            singular_simplex (0,top) f /\ singular_simplex (0,top) f'
            ==> homologous_rel (0,top,{}) (frag_of f) (frag_of f')"
     (REPEAT GEN_TAC THEN REWRITE_TAC [singular_simplex, STANDARD_SIMPLEX_0] THEN
      ABBREV_TAC (← q r"p:num->real = \j. if j = 0 then &1 else &0") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPECL
       [← q r"(f:(num->real)->A) p", ← q r"(f':(num->real)->A) p"] o
       GEN_REWRITE_RULE id [path_connected_space]) THEN
      ANTS_TAC THENL
       [REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [continuous_map])) THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY] THEN
        REWRITE_TAC [o_DEF, TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV] THEN
        SET_TAC [],
        REWRITE_TAC [path_in, LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"g:real->A") THEN STRIP_TAC THEN
      REWRITE_TAC [homologous_rel, SINGULAR_BOUNDARY] THEN
      EXISTS_TAC (← q r"frag_of(RESTRICTION (standard_simplex 1)
                     ((g:real->A) o (\x:num->real. x 0)))") THEN
      REWRITE_TAC [SINGULAR_CHAIN_OF, CHAIN_BOUNDARY_OF] THEN
      CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [← NUMSEG_CONV (← q r"0..1")] THEN
      SIMP_TAC [ITERATE_CLAUSES, MONOIDAL_FRAG_ADD, FINITE_INSERT, FINITE_EMPTY,
                NOT_IN_EMPTY, IN_INSERT, NEUTRAL_FRAG_ADD] THEN
      CONV_TAC NUM_REDUCE_CONV THEN CONJ_TAC THENL
       [REWRITE_TAC [singular_simplex] THEN
        REWRITE_TAC [← REWRITE_RULE [IN] RESTRICTION_IN_EXTENSIONAL] THEN
        SIMP_TAC [RESTRICTION_CONTINUOUS_MAP, TOPSPACE_SUBTOPOLOGY,
                  INTER_SUBSET] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
        EXISTS_TAC (← q r"subtopology euclideanreal (real_interval [&0,&1])") THEN
        ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
        SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV,
                  CONTINUOUS_MAP_FROM_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s ==> f x IN t) ==> IMAGE f (u INTER s) SUBSET t")) THEN
        SIMP_TAC [standard_simplex, IN_REAL_INTERVAL, IN_ELIM_THM],
        CONV_TAC INT_REDUCE_CONV THEN MATCH_MP_TAC (← FRAG_MODULE
         (← q r"x = x' /\ y = y'
          ==> frag_add (frag_cmul (&1) x)
                       (frag_add (frag_cmul (-- &1) y) frag_0) =
              frag_sub x' y'")) THEN
        CONJ_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [singular_face] THEN
        ASM_REWRITE_TAC [SUB_REFL, STANDARD_SIMPLEX_0] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [EXTENSIONAL, IN_ELIM_THM, IN_SING]) THEN
        GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:num->real") THEN
        ASM_CASES_TAC (← q r"x:num->real = p") THEN
        ASM_SIMP_TAC [RESTRICTION, IN_SING, o_THM] THEN
        REWRITE_TAC [simplicial_face, ← CONJUNCT1 LT] THEN
        CONV_TAC NUM_REDUCE_CONV THEN
        ASM_REWRITE_TAC [standard_simplex, IN_ELIM_THM] THEN
        UNDISCH_THEN (← q r"x:num->real = p") SUBST1_TAC THEN
        REWRITE_TAC [← num_CONV (← q r"1"), SUM_CLAUSES_NUMSEG] THEN
        EXPAND_TAC "p" THEN REWRITE_TAC [] THEN CONV_TAC NUM_REDUCE_CONV THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← MESON [] (← q r"p ==> (if p then x else y) = x")) THEN
        REPEAT STRIP_TAC THEN
        REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_ARITH_TAC])
    prove
     r"!(top:A topology) f.
          path_connected_space top /\ singular_simplex(0,top) f
          ==> group_isomorphism (integer_group,homology_group(&0,top))
                (group_zpow (homology_group(&0,top))
                            (homologous_rel(0,top,{}) (frag_of f)))"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"singular_relcycle(0,top:A topology,{}) (frag_of f)")
      ASSUME_TAC THENL
       [ASM_REWRITE_TAC [SINGULAR_CYCLE, SINGULAR_CHAIN_OF] THEN
        REWRITE_TAC [chain_boundary],
        ALL_TAC] THEN
      ABBREV_TAC (← q r"q = homologous_rel(0,top:A topology,{}) (frag_of f)") THEN
      SUBGOAL_THEN (← q r"q IN group_carrier (homology_group (&0,top:A topology))")
      ASSUME_TAC THENL
       [REWRITE_TAC [homology_group, RELATIVE_HOMOLOGY_GROUP] THEN
        EXPAND_TAC "q" THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        REWRITE_TAC [ETA_AX] THEN MATCH_MP_TAC FUN_IN_IMAGE THEN
        ASM_REWRITE_TAC [IN_ELIM_THM],
        ALL_TAC] THEN
      REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM,
                   GROUP_EPIMORPHISM_ALT, GROUP_MONOMORPHISM_ALT] THEN
      ASM_SIMP_TAC [GROUP_HOMOMORPHISM_GROUP_ZPOW] THEN
      SUBGOAL_THEN
       (← q r"group_zpow (homology_group (&0,top)) q =
        \n. homologous_rel(0,top:A topology,{}) (frag_cmul n (frag_of f))")
      SUBST1_TAC THENL
       [GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"n:int") THEN
        EXPAND_TAC "q" THEN SIMP_TAC [← GSYM RIGHT_COSET_SINGULAR_RELBOUNDARY] THEN
        SIMP_TAC [homology_group, relative_homology_group, INT_LT_REFL,
                  NUM_OF_INT_OF_NUM] THEN
        ASM_SIMP_TAC [QUOTIENT_GROUP_ZPOW, ← CONJUNCT1 RELCYCLE_GROUP, IN,
                      NORMAL_SUBGROUP_SINGULAR_RELBOUNDARY_RELCYCLE] THEN
        AP_TERM_TAC THEN
        REWRITE_TAC [GROUP_ZPOW_SUBGROUP_GENERATED, relcycle_group] THEN
        REWRITE_TAC [FREE_ABELIAN_GROUP_ZPOW, chain_group],
        ALL_TAC] THEN
      REWRITE_TAC [INTEGER_GROUP, IN_UNIV, homology_group] THEN
      REWRITE_TAC [group_image, SUBSET, RELATIVE_HOMOLOGY_GROUP] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, INTEGER_GROUP, IN_UNIV] THEN
      REWRITE_TAC [HOMOLOGOUS_REL_EQ_RELBOUNDARY] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:int") THEN REWRITE_TAC [SINGULAR_BOUNDARY, ADD_CLAUSES] THEN
        SUBGOAL_THEN
         (← q r"!d. singular_chain (1,top:A topology) d
              ==> frag_extend (\x. frag_of(f:(num->real)->A))
                              (chain_boundary 1 d) = frag_0")
        MP_TAC THENL
         [REWRITE_TAC [singular_chain] THEN MATCH_MP_TAC FRAG_INDUCTION THEN
          REWRITE_TAC [← GSYM singular_chain] THEN
          REWRITE_TAC [FRAG_EXTEND_0, CHAIN_BOUNDARY_0] THEN
          SIMP_TAC [FRAG_EXTEND_SUB, CHAIN_BOUNDARY_SUB] THEN
          REWRITE_TAC [← FRAG_MODULE (← q r"frag_sub x frag_0 = x"), IN] THEN
          X_GEN_TAC (← q r"g:(num->real)->A") THEN DISCH_TAC THEN
          REWRITE_TAC [CHAIN_BOUNDARY_OF] THEN CONV_TAC NUM_REDUCE_CONV THEN
          SIMP_TAC [← MATCH_MP ITERATE_CLAUSES_NUMSEG MONOIDAL_FRAG_ADD, ← num_CONV (← q r"1"),
                    LE_0, FRAG_EXTEND_ADD, FRAG_EXTEND_CMUL, FRAG_EXTEND_OF] THEN
          CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC INT_REDUCE_CONV THEN
          CONV_TAC (fun t => FRAG_MODULE t),
          REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
          GEN_TAC THEN DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
          ASM_REWRITE_TAC [FRAG_EXTEND_OF, FRAG_EXTEND_CMUL, ← FRAG_MODULE
           (← q r"frag_cmul n t = frag_0 <=> n = &0 \/ t = frag_0")] THEN
          REWRITE_TAC [FRAG_OF_NONZERO]],
        REWRITE_TAC [SINGULAR_CYCLE, IN_IMAGE, IN_UNIV, HOMOLOGOUS_REL_EQ] THEN
        MATCH_MP_TAC (← MESON [] (← q r"(!x. P x ==> R x) ==> (!x. P x /\ Q x ==> R x)")) THEN
        REWRITE_TAC [singular_chain] THEN MATCH_MP_TAC FRAG_INDUCTION THEN
        REPEAT CONJ_TAC THENL
         [EXISTS_TAC (← q r"&0:int") THEN REWRITE_TAC [HOMOLOGOUS_REL_REFL,
            ← FRAG_MODULE (← q r"frag_cmul (&0) x = frag_0")],
          ALL_TAC,
          REWRITE_TAC [LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
          REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN REPEAT GEN_TAC THEN
          DISCH_THEN (MP_TAC o MATCH_MP HOMOLOGOUS_REL_SUB) THEN
          REWRITE_TAC [← FRAG_MODULE
           (← q r"frag_sub (frag_cmul a c) (frag_cmul b c) = frag_cmul (a - b) c")] THEN
          MESON_TAC []] THEN
        REWRITE_TAC [IN] THEN X_GEN_TAC (← q r"f':(num->real)->A") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"&1:int") THEN
        REWRITE_TAC [← FRAG_MODULE (← q r"frag_cmul (&1) x = x")] THEN
        ASM_MESON_TAC [lemma]])

  let ISOMORPHIC_GROUP_INTEGER_ZEROTH_HOMOLOGY_GROUP ← prove
   r"!top:A topology.
        path_connected_space top /\ ~(topspace top = {})
        ==> homology_group(&0,top) isomorphic_group integer_group"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?f. singular_simplex(0,top:A topology) f")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"a:A")) THEN
      EXISTS_TAC (← q r"RESTRICTION (standard_simplex 0) (\x. (a:A))") THEN
      SIMP_TAC [singular_simplex, RESTRICTION_CONTINUOUS_MAP,
                TOPSPACE_SUBTOPOLOGY, INTER_SUBSET, CONTINUOUS_MAP_CONST,
                ← REWRITE_RULE [IN] RESTRICTION_IN_EXTENSIONAL] THEN
      ASM_REWRITE_TAC [],
      ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN
      ASM_MESON_TAC [GROUP_ISOMORPHISM_INTEGER_ZEROTH_HOMOLOGY_GROUP]])

  return { GROUP_ISOMORPHISM_INTEGER_ZEROTH_HOMOLOGY_GROUP,
           ISOMORPHIC_GROUP_INTEGER_ZEROTH_HOMOLOGY_GROUP }

/- ------------------------------------------------------------------------- -/
/- Coefficients, zeroth homology, and basic consequences of the axioms.      -/
/- (homology.ml 5676-5851)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HBP where
  HOMOLOGY_COEFFICIENTS : thm
  ZEROTH_HOMOLOGY_GROUP : thm
  ISOMORPHIC_HOMOLOGY_IMP_PATH_COMPONENTS : thm
  ISOMORPHIC_HOMOLOGY_IMP_PATH_CONNECTEDNESS : thm
  TRIVIAL_HOMOLOGY_GROUP : thm
  ABELIAN_HOMOLOGY_GROUP : thm
  GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY : thm
  HOM_INDUCED_COMPOSE_EMPTY : thm
  HOMOLOGY_HOMOTOPY_EMPTY : thm
  HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS : thm
  HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM : thm
  HOMOTOPY_EQUIVALENCE_HOMOLOGY_GROUP_ISOMORPHISM : thm
  HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS : thm
  HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_HOMOLOGY_GROUPS : thm
  HOMEOMORPHIC_SPACE_IMP_ISOMORPHIC_HOMOLOGY_GROUPS : thm
  deriving Inhabited

@[nospecialize]
def setupHBP [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) (BHAX : HAX)
    (BHAD : HAD) (BHZ0 : HZ0) : ExceptT String IO HBP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EMPTY_SUBSET, EQ_IMP, FUN_EQ_THM, IMAGE_CLAUSES, IMP_CONJ, IMP_CONJ_ALT, .. } := D.core1
  let { IN_SING, I_DEF, MONO_AND, MONO_FORALL, NOT_INSERT_EMPTY, .. } := D.core2
  let { o_THM, .. } := D.core4
  let { CARD_EQ_REFL, CARD_LE_CONG, CARD_LE_SING, .. } := D.lib
  let { ISOMORPHIC_FREE_ABELIAN_GROUPS, ISOMORPHIC_GROUP_SUM_GROUP, ISOMORPHIC_GROUP_SYM,
        ISOMORPHIC_GROUP_TRANS, ISOMORPHIC_SUM_INTEGER_GROUP, group_isomorphism,
        group_isomorphisms, isomorphic_group, .. } := D.grp2
  let { HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE, NONEMPTY_PATH_COMPONENTS_OF, .. } := D.met2
  let { PAIRWISE_DISJOINT_PATH_COMPONENTS_OF, PATH_COMPONENTS_OF_MAXIMAL,
        PATH_COMPONENTS_OF_SUBSET, PATH_CONNECTED_IN_PATH_COMPONENTS_OF, PATH_CONNECTED_IN_SING,
        PATH_CONNECTED_IN_TOPSPACE, PATH_CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING,
        TOPSPACE_SUBTOPOLOGY_SUBSET, UNIONS_PATH_COMPONENTS_OF, homotopy_equivalent_space,
        path_connected_in, .. } := D.met3
  let { TRIVIAL_RELATIVE_HOMOLOGY_GROUP, homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, .. } := BHIN
  let { ABELIAN_RELATIVE_HOMOLOGY_GROUP, HOM_INDUCED_COMPOSE, HOM_INDUCED_ID, .. } := BHIF
  let { HOMOLOGY_HOMOTOPY_AXIOM, .. } := BHAX
  let { HOMOLOGY_ADDITIVITY_AXIOM_GEN, .. } := BHAD
  let { ISOMORPHIC_GROUP_INTEGER_ZEROTH_HOMOLOGY_GROUP, .. } := BHZ0
  -- @@SCOPE END

  let HOMOLOGY_COEFFICIENTS ← prove
   r"!top (a:A).
        topspace top = {a}
        ==> homology_group(&0,top) isomorphic_group integer_group"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ISOMORPHIC_GROUP_INTEGER_ZEROTH_HOMOLOGY_GROUP THEN
    ASM_REWRITE_TAC [← GSYM PATH_CONNECTED_IN_TOPSPACE, NOT_INSERT_EMPTY] THEN
    ASM_REWRITE_TAC [PATH_CONNECTED_IN_SING, IN_SING])

  let ZEROTH_HOMOLOGY_GROUP ← prove
   r"!top:A topology.
        homology_group(&0,top) isomorphic_group
        free_abelian_group (path_components_of top)"
   (GEN_TAC THEN TRANS_TAC ISOMORPHIC_GROUP_TRANS
     (← q r"sum_group (path_components_of top)
         (\s:A->bool. homology_group(&0,subtopology top s))") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      MP_TAC (← ISPECL [← q r"&0:int", ← q r"top:A topology",
                        ← q r"path_components_of(top:A topology)"]
        HOMOLOGY_ADDITIVITY_AXIOM_GEN) THEN
      REWRITE_TAC [isomorphic_group] THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
      REWRITE_TAC [PAIRWISE_DISJOINT_PATH_COMPONENTS_OF] THEN
      REWRITE_TAC [UNIONS_PATH_COMPONENTS_OF] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_COMPONENTS_OF_MAXIMAL THEN
      EXISTS_TAC (← q r"top:A topology") THEN ASM SET_TAC [],
      TRANS_TAC ISOMORPHIC_GROUP_TRANS
       (← q r"sum_group (path_components_of (top:A topology)) (\i. integer_group)") THEN
      REWRITE_TAC [ISOMORPHIC_SUM_INTEGER_GROUP] THEN
      MATCH_MP_TAC ISOMORPHIC_GROUP_SUM_GROUP THEN
      REWRITE_TAC [] THEN X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC ISOMORPHIC_GROUP_INTEGER_ZEROTH_HOMOLOGY_GROUP THEN
      ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, PATH_COMPONENTS_OF_SUBSET,
       ← REWRITE_RULE [path_connected_in] PATH_CONNECTED_IN_PATH_COMPONENTS_OF] THEN
      ASM_MESON_TAC [NONEMPTY_PATH_COMPONENTS_OF]])

  let ISOMORPHIC_HOMOLOGY_IMP_PATH_COMPONENTS ← prove
   r"!(top:A topology) (top':B topology).
        homology_group(&0,top) isomorphic_group homology_group(&0,top')
        ==> path_components_of top =_c path_components_of top'"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM ISOMORPHIC_FREE_ABELIAN_GROUPS] THEN
    TRANS_TAC ISOMORPHIC_GROUP_TRANS (← q r"homology_group(&0,(top':B topology))") THEN
    REWRITE_TAC [ZEROTH_HOMOLOGY_GROUP] THEN
    GEN_REWRITE_TAC id [ISOMORPHIC_GROUP_SYM] THEN
    TRANS_TAC ISOMORPHIC_GROUP_TRANS (← q r"homology_group(&0,(top:A topology))") THEN
    REWRITE_TAC [ZEROTH_HOMOLOGY_GROUP] THEN
    GEN_REWRITE_TAC id [ISOMORPHIC_GROUP_SYM] THEN
    ASM_REWRITE_TAC [])

  let ISOMORPHIC_HOMOLOGY_IMP_PATH_CONNECTEDNESS ← prove
   r"!(top:A topology) (top':B topology).
        homology_group(&0,top) isomorphic_group homology_group(&0,top')
        ==> (path_connected_space top <=> path_connected_space top')"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [PATH_CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING] THEN
    REWRITE_TAC [← GSYM CARD_LE_SING] THEN
    MATCH_MP_TAC CARD_LE_CONG THEN REWRITE_TAC [CARD_EQ_REFL] THEN
    MATCH_MP_TAC ISOMORPHIC_HOMOLOGY_IMP_PATH_COMPONENTS THEN
    ASM_REWRITE_TAC [])

  /- ----------------------------------------------------------------------- -/
  /- More basic properties of homology groups, deduced from the E-S axioms.  -/
  /- ----------------------------------------------------------------------- -/

  let TRIVIAL_HOMOLOGY_GROUP ← prove
   r"!p top:A topology. p < &0 ==> trivial_group(homology_group(p,top))"
   (REWRITE_TAC [TRIVIAL_RELATIVE_HOMOLOGY_GROUP, homology_group])

  let ABELIAN_HOMOLOGY_GROUP ← prove
   r"!p top:A topology. abelian_group(homology_group(p,top))"
   (REWRITE_TAC [homology_group, ABELIAN_RELATIVE_HOMOLOGY_GROUP])

  let GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY ← prove
   r"!p top top' f:A->B.
        group_homomorphism
         (homology_group (p,top),homology_group (p,top'))
         (hom_induced p (top,{}) (top',{}) f)"
   (REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED, homology_group])

  let HOM_INDUCED_COMPOSE_EMPTY ← prove
   r"!p top top' top'' (f:A->B) (g:B->C).
        continuous_map(top,top') f /\
        continuous_map(top',top'') g
        ==> hom_induced p (top,{}) (top'',{}) (g o f) =
            hom_induced p (top',{}) (top'',{}) g o
            hom_induced p (top,{}) (top',{}) f"
   (REWRITE_TAC [homology_group] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOM_INDUCED_COMPOSE THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET])

  let HOMOLOGY_HOMOTOPY_EMPTY ← prove
   r"!p (top:A topology) (top':B topology) f g.
        homotopic_with (\h. T) (top,top') f g
        ==> hom_induced p (top,{}) (top',{}) f =
            hom_induced p (top,{}) (top',{}) g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMOLOGY_HOMOTOPY_AXIOM THEN
    ASM_REWRITE_TAC [← GSYM homology_group, IMAGE_CLAUSES, EMPTY_SUBSET])

  let HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS ← prove
   r"!p top top' s t (f:A->B) g.
        continuous_map (top,top') f /\ IMAGE f s SUBSET t /\
        continuous_map (top',top) g /\ IMAGE g t SUBSET s /\
        homotopic_with (\h. IMAGE h s SUBSET s) (top,top) (g o f) I /\
        homotopic_with (\k. IMAGE k t SUBSET t) (top',top') (f o g) I
        ==> group_isomorphisms (relative_homology_group (p,top,s),
                                relative_homology_group (p,top',t))
                               (hom_induced p (top,s) (top',t) f,
                                hom_induced p (top',t) (top,s) g)"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 4 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_TAC THEN REWRITE_TAC [group_isomorphisms] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED] THEN
    FIRST_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"p:int") o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] HOMOLOGY_HOMOTOPY_AXIOM))) THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT, homology_group] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
    GEN_TAC THEN DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    BINOP_TAC THEN ASM_SIMP_TAC [I_DEF, HOM_INDUCED_ID] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM] THEN AP_THM_TAC THEN
    MATCH_MP_TAC HOM_INDUCED_COMPOSE THEN ASM_REWRITE_TAC [])

  let HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM ← prove
   r"!p top top' s t (f:A->B) g.
        continuous_map (top,top') f /\ IMAGE f s SUBSET t /\
        continuous_map (top',top) g /\ IMAGE g t SUBSET s /\
        homotopic_with (\h. IMAGE h s SUBSET s) (top,top) (g o f) I /\
        homotopic_with (\k. IMAGE k t SUBSET t) (top',top') (f o g) I
        ==> group_isomorphism (relative_homology_group (p,top,s),
                               relative_homology_group (p,top',t))
                              (hom_induced p (top,s) (top',t) f)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP
      HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS) THEN
    REWRITE_TAC [group_isomorphism] THEN MESON_TAC [])

  let HOMOTOPY_EQUIVALENCE_HOMOLOGY_GROUP_ISOMORPHISM ← prove
   r"!p top top' (f:A->B) g.
        continuous_map (top,top') f /\ continuous_map (top',top) g /\
        homotopic_with (\h. T) (top,top) (g o f) I /\
        homotopic_with (\k. T) (top',top') (f o g) I
        ==> group_isomorphism (homology_group (p,top),homology_group (p,top'))
                              (hom_induced p (top,{}) (top',{}) f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homology_group] THEN
    MATCH_MP_TAC HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM THEN
    EXISTS_TAC (← q r"g:B->A") THEN ASM_REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET])

  let HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS ← prove
   r"!p top top' s t (f:A->B) g.
        continuous_map (top,top') f /\ IMAGE f s SUBSET t /\
        continuous_map (top',top) g /\ IMAGE g t SUBSET s /\
        homotopic_with (\h. IMAGE h s SUBSET s) (top,top) (g o f) I /\
        homotopic_with (\k. IMAGE k t SUBSET t) (top',top') (f o g) I
        ==> relative_homology_group (p,top,s) isomorphic_group
            relative_homology_group (p,top',t)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP
      HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS) THEN
    REWRITE_TAC [isomorphic_group, group_isomorphism] THEN MESON_TAC [])

  let HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_HOMOLOGY_GROUPS ← prove
   r"!p (top:A topology) (top':B topology).
        top homotopy_equivalent_space top'
        ==> homology_group(p,top) isomorphic_group homology_group(p,top')"
   (REWRITE_TAC [homotopy_equivalent_space] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [homology_group] THEN MATCH_MP_TAC
     HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS THEN
    REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET] THEN ASM_MESON_TAC [])

  let HOMEOMORPHIC_SPACE_IMP_ISOMORPHIC_HOMOLOGY_GROUPS ← prove
   r"!p (top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> homology_group(p,top) isomorphic_group homology_group(p,top')"
   (SIMP_TAC [HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_HOMOLOGY_GROUPS,
              HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE])

  return { HOMOLOGY_COEFFICIENTS, ZEROTH_HOMOLOGY_GROUP, ISOMORPHIC_HOMOLOGY_IMP_PATH_COMPONENTS,
           ISOMORPHIC_HOMOLOGY_IMP_PATH_CONNECTEDNESS, TRIVIAL_HOMOLOGY_GROUP,
           ABELIAN_HOMOLOGY_GROUP, GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY,
           HOM_INDUCED_COMPOSE_EMPTY, HOMOLOGY_HOMOTOPY_EMPTY,
           HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS,
           HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM,
           HOMOTOPY_EQUIVALENCE_HOMOLOGY_GROUP_ISOMORPHISM,
           HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS,
           HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_HOMOLOGY_GROUPS,
           HOMEOMORPHIC_SPACE_IMP_ISOMORPHIC_HOMOLOGY_GROUPS }

/- ------------------------------------------------------------------------- -/
/- Triviality, homeomorphisms, retracts.  (homology.ml 5852-6061)            -/
/- ------------------------------------------------------------------------- -/

structure HTR where
  TRIVIAL_RELATIVE_HOMOLOGY_GROUP_GEN : thm
  TRIVIAL_RELATIVE_HOMOLOGY_GROUP_TOPSPACE : thm
  TRIVIAL_RELATIVE_HOMOLOGY_GROUP_EMPTY : thm
  TRIVIAL_HOMOLOGY_GROUP_EMPTY : thm
  TRIVIAL_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE : thm
  HOMEOMORPHIC_MAPS_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS : thm
  HOMEOMORPHIC_MAP_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM : thm
  GROUP_MONOMORPHISM_HOM_INDUCED_SECTION_MAP : thm
  GROUP_EPIMORPHISM_HOM_INDUCED_RETRACTION_MAP : thm
  HOMEOMORPHIC_MAP_HOMOLOGY_GROUP_ISOMORPHISM : thm
  GROUP_MONOMORPHISM_HOM_INDUCED_INCLUSION : thm
  TRIVIAL_HOMOMORPHISM_HOM_BOUNDARY_INCLUSION : thm
  GROUP_EPIMORPHISM_HOM_INDUCED_RELATIVIZATION : thm
  SHORT_EXACT_SEQUENCE_HOM_INDUCED_INCLUSION : thm
  deriving Inhabited

@[nospecialize]
def setupHTR [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHIN : HIN) (BHIF : HIF) (BHEX : HEX)
    (BHAX : HAX) (BHBP : HBP) : ExceptT String IO HTR := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, EMPTY_SUBSET, ETA_AX, FORALL_IN_IMAGE, FUN_EQ_THM,
        IMAGE_CLAUSES, INTER_EMPTY, .. } := D.core1
  let { IN_INTER, I_DEF, I_THM, LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { SUBSET, o_DEF, o_THM, .. } := D.core4
  let { GROUP_EPIMORPHISM_RIGHT_INVERTIBLE, GROUP_EXACTNESS_EPIMORPHISM_EQ_TRIVIALITY,
        GROUP_EXACTNESS_IMP_TRIVIALITY, GROUP_EXACTNESS_MONOMORPHISM_EQ_TRIVIALITY, .. } := D.grp1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, GROUP_MONOMORPHISM_FROM_TRIVIAL_GROUP,
        GROUP_MONOMORPHISM_LEFT_INVERTIBLE, ISOMORPHIC_GROUP_TRIVIALITY, group_isomorphism,
        short_exact_sequence, .. } := D.grp2
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID,
        CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY, .. } := D.met1
  let { HOMEOMORPHIC_MAP_MAPS, HOMOTOPIC_WITH_EQUAL, HOMOTOPIC_WITH_REFL, .. } := D.met2
  let { RETRACT_OF_SPACE_SECTION_MAP, SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP,
        SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, continuous_map, homeomorphic_maps,
        retraction_map, retraction_maps, section_map, .. } := D.met3
  let { RELATIVE_HOMOLOGY_GROUP_RESTRICT, homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED_RESTRICT, .. } := BHIN
  let { HOM_INDUCED_ID_GEN, .. } := BHIF
  let { HOMOLOGY_EXACTNESS_AXIOM_1, HOMOLOGY_EXACTNESS_AXIOM_2, .. } := BHEX
  let { HOMOLOGY_DIMENSION_AXIOM, HOMOLOGY_EXACTNESS_AXIOM_3, .. } := BHAX
  let { GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY,
        HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM,
        HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS,
        HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_HOMOLOGY_GROUPS, HOM_INDUCED_COMPOSE_EMPTY, .. } :=
    BHBP
  -- @@SCOPE END

  let TRIVIAL_RELATIVE_HOMOLOGY_GROUP_GEN ← prove
   r"!p top s f:A->A.
        continuous_map (top,subtopology top s) f /\
        homotopic_with (\h. T) (subtopology top s,subtopology top s) f I /\
        homotopic_with (\k. T) (top,top) f I
        ==> trivial_group(relative_homology_group(p,top,s))"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"hom_induced p (subtopology top s:A topology,{}) (top,{}) (\x. x)",
      ← q r"hom_induced p (top:A topology,{}) (top,s) (\x. x)",
      ← q r"hom_boundary p (top:A topology,s)",
      ← q r"hom_induced (p - &1) (subtopology top s:A topology,{}) (top,{}) (\x. x)",
      ← q r"homology_group (p,subtopology top (s:A->bool))",
      ← q r"homology_group (p,top:A topology)",
      ← q r"relative_homology_group (p,top,s:A->bool)",
      ← q r"homology_group (p - &1,subtopology top (s:A->bool))",
      ← q r"homology_group (p - &1,top:A topology)"]
    GROUP_EXACTNESS_IMP_TRIVIALITY) THEN
    REWRITE_TAC [HOMOLOGY_EXACTNESS_AXIOM_1,
                 HOMOLOGY_EXACTNESS_AXIOM_2,
                 HOMOLOGY_EXACTNESS_AXIOM_3] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    REWRITE_TAC [homology_group] THEN CONJ_TAC THEN MATCH_MP_TAC
     HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM THEN
    SIMP_TAC [IMAGE_CLAUSES, EMPTY_SUBSET] THEN
    SIMP_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
    REWRITE_TAC [o_DEF, ETA_AX] THEN ASM_MESON_TAC [])

  let TRIVIAL_RELATIVE_HOMOLOGY_GROUP_TOPSPACE ← prove
   r"!p top:A topology.
        trivial_group(relative_homology_group(p,top,topspace top))"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC TRIVIAL_RELATIVE_HOMOLOGY_GROUP_GEN THEN
    EXISTS_TAC (← q r"\x:A. x") THEN
    REWRITE_TAC [HOMOTOPIC_WITH_REFL, I_DEF, SUBTOPOLOGY_TOPSPACE] THEN
    REWRITE_TAC [CONTINUOUS_MAP_ID])

  let TRIVIAL_RELATIVE_HOMOLOGY_GROUP_EMPTY ← prove
   r"!p top s:A->bool.
        topspace top = {}
        ==> trivial_group(relative_homology_group(p,top,s))"
   (ONCE_REWRITE_TAC [RELATIVE_HOMOLOGY_GROUP_RESTRICT] THEN
    SIMP_TAC [INTER_EMPTY] THEN
    MESON_TAC [TRIVIAL_RELATIVE_HOMOLOGY_GROUP_TOPSPACE])

  let TRIVIAL_HOMOLOGY_GROUP_EMPTY ← prove
   r"!p top:A topology.
        topspace top = {} ==> trivial_group(homology_group(p,top))"
   (REWRITE_TAC [homology_group, TRIVIAL_RELATIVE_HOMOLOGY_GROUP_EMPTY])

  let TRIVIAL_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE ← prove
   r"!p top:A topology.
        contractible_space top /\ ~(p = &0)
        ==> trivial_group(homology_group(p,top))"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN
    REWRITE_TAC [TRIVIAL_HOMOLOGY_GROUP_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_TRIVIALITY o SPEC (← q r"p:int") o
     MATCH_MP HOMOTOPY_EQUIVALENT_SPACE_IMP_ISOMORPHIC_HOMOLOGY_GROUPS) THEN
    MATCH_MP_TAC HOMOLOGY_DIMENSION_AXIOM THEN EXISTS_TAC (← q r"a:A") THEN
    ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [])

  let HOMEOMORPHIC_MAPS_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS ← prove
   r"!p top top' s t (f:A->B) g.
        homeomorphic_maps (top,top') (f,g) /\
        IMAGE f s SUBSET t /\ IMAGE g t SUBSET s
        ==> group_isomorphisms (relative_homology_group (p,top,s),
                                relative_homology_group (p,top',t))
                               (hom_induced p (top,s) (top',t) f,
                                hom_induced p (top',t) (top,s) g)"
   (ONCE_REWRITE_TAC [HOM_INDUCED_RESTRICT, RELATIVE_HOMOLOGY_GROUP_RESTRICT] THEN
    REWRITE_TAC [homeomorphic_maps] THEN REPEAT STRIP_TAC THEN MATCH_MP_TAC
      HOMOTOPY_EQUIVALENCE_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      CONJ_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_EQUAL THEN
      ASM_SIMP_TAC [o_THM, SUBSET, FORALL_IN_IMAGE, I_THM, IN_INTER] THEN
      ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE]])

  let HOMEOMORPHIC_MAP_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM ← prove
   r"!p top top' s t (f:A->B).
        homeomorphic_map (top,top') f /\ s SUBSET topspace top /\ IMAGE f s = t
        ==> group_isomorphism (relative_homology_group (p,top,s),
                               relative_homology_group (p,top',t))
                              (hom_induced p (top,s) (top',t) f)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MAP_MAPS]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"g:B->A")) THEN REWRITE_TAC [group_isomorphism] THEN
    EXISTS_TAC (← q r"hom_induced p (top',t) (top,s) (g:B->A)") THEN
    MATCH_MP_TAC HOMEOMORPHIC_MAPS_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS THEN
    ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphic_maps, continuous_map]) THEN
    ASM SET_TAC [])

  let GROUP_MONOMORPHISM_HOM_INDUCED_SECTION_MAP ← prove
   r"!p top top' f:A->B.
        section_map (top,top') f
        ==> group_monomorphism (homology_group (p,top),
                                homology_group (p,top'))
                               (hom_induced p (top,{}) (top',{}) f)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [section_map, retraction_maps, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:B->A") THEN STRIP_TAC THEN
    MATCH_MP_TAC GROUP_MONOMORPHISM_LEFT_INVERTIBLE THEN
    EXISTS_TAC (← q r"hom_induced p (top',{}) (top,{}) (g:B->A)") THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY] THEN
    MP_TAC (← GSYM (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"top':B topology",
                   ← q r"top:A topology",
                   ← q r"f:A->B", ← q r"g:B->A"]
          HOM_INDUCED_COMPOSE_EMPTY)) THEN
    ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN
    SIMP_TAC [o_THM] THEN DISCH_THEN (K ALL_TAC) THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HOM_INDUCED_ID_GEN THEN
     ASM_REWRITE_TAC [o_THM, ← GSYM homology_group] THEN
    ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE])

  let GROUP_EPIMORPHISM_HOM_INDUCED_RETRACTION_MAP ← prove
   r"!p top top' f:A->B.
        retraction_map (top,top') f
        ==> group_epimorphism (homology_group (p,top),
                               homology_group (p,top'))
                              (hom_induced p (top,{}) (top',{}) f)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [retraction_map, retraction_maps, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:B->A") THEN STRIP_TAC THEN
    MATCH_MP_TAC GROUP_EPIMORPHISM_RIGHT_INVERTIBLE THEN
    EXISTS_TAC (← q r"hom_induced p (top',{}) (top,{}) (g:B->A)") THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY] THEN
    MP_TAC (← GSYM (← ISPECL [← q r"p:int", ← q r"top':B topology", ← q r"top:A topology",
                   ← q r"top':B topology",
                   ← q r"g:B->A", ← q r"f:A->B"]
          HOM_INDUCED_COMPOSE_EMPTY)) THEN
    ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN
    SIMP_TAC [o_THM] THEN DISCH_THEN (K ALL_TAC)  THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HOM_INDUCED_ID_GEN THEN
    ASM_REWRITE_TAC [o_THM, ← GSYM homology_group] THEN
    ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE])

  let HOMEOMORPHIC_MAP_HOMOLOGY_GROUP_ISOMORPHISM ← prove
   r"!p top top' f:A->B.
        homeomorphic_map (top,top') f
        ==> group_isomorphism (homology_group (p,top),
                               homology_group (p,top'))
                               (hom_induced p (top,{}) (top',{}) f)"
   (REWRITE_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP] THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [GROUP_MONOMORPHISM_HOM_INDUCED_SECTION_MAP,
                  GROUP_EPIMORPHISM_HOM_INDUCED_RETRACTION_MAP])

  let GROUP_MONOMORPHISM_HOM_INDUCED_INCLUSION ← prove
   r"!p top s:A->bool.
        s = {} \/ s retract_of_space top
        ==> group_monomorphism
             (homology_group(p,subtopology top s),homology_group(p,top))
             (hom_induced p (subtopology top s,{}) (top,{}) (\x. x))"
   (REWRITE_TAC [RETRACT_OF_SPACE_SECTION_MAP] THEN REPEAT STRIP_TAC THENL
     [W (MP_TAC o PART_MATCH (lhand o rand)
        GROUP_MONOMORPHISM_FROM_TRIVIAL_GROUP o snd) THEN
      ASM_SIMP_TAC [TRIVIAL_HOMOLOGY_GROUP_EMPTY, TOPSPACE_SUBTOPOLOGY,
                    INTER_EMPTY] THEN
      ASM_SIMP_TAC [homology_group, GROUP_HOMOMORPHISM_HOM_INDUCED,
                    CONTINUOUS_MAP_ID, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                    IMAGE_CLAUSES, EMPTY_SUBSET],
      MATCH_MP_TAC GROUP_MONOMORPHISM_HOM_INDUCED_SECTION_MAP THEN
      ASM_REWRITE_TAC []])

  let TRIVIAL_HOMOMORPHISM_HOM_BOUNDARY_INCLUSION ← prove
   r"!p top s:A->bool.
        s = {} \/ s retract_of_space top
        ==> trivial_homomorphism
             (relative_homology_group(p,top,s),
              homology_group (p - &1,subtopology top s))
             (hom_boundary p (top,s))"
   (REPEAT GEN_TAC THEN
    MP_TAC (← CONJ (← SPEC (← q r"p:int") HOMOLOGY_EXACTNESS_AXIOM_1)
                   (← SPEC (← q r"p:int") HOMOLOGY_EXACTNESS_AXIOM_2)) THEN
    REWRITE_TAC [AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"top:A topology", ← q r"s:A->bool"]) THEN
    DISCH_THEN (SUBST1_TAC o SYM o
      MATCH_MP GROUP_EXACTNESS_MONOMORPHISM_EQ_TRIVIALITY) THEN
    REWRITE_TAC [GROUP_MONOMORPHISM_HOM_INDUCED_INCLUSION])

  let GROUP_EPIMORPHISM_HOM_INDUCED_RELATIVIZATION ← prove
   r"!p top s:A->bool.
        s = {} \/ s retract_of_space top
        ==> group_epimorphism
             (homology_group(p,top),relative_homology_group(p,top,s))
             (hom_induced p (top,{}) (top,s) (\x. x))"
   (REPEAT GEN_TAC THEN
    MP_TAC (← CONJ (← SPEC (← q r"p:int") HOMOLOGY_EXACTNESS_AXIOM_1)
                   (← SPEC (← q r"p:int") HOMOLOGY_EXACTNESS_AXIOM_2)) THEN
    REWRITE_TAC [AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"top:A topology", ← q r"s:A->bool"]) THEN
    DISCH_THEN (SUBST1_TAC o
      MATCH_MP GROUP_EXACTNESS_EPIMORPHISM_EQ_TRIVIALITY) THEN
    REWRITE_TAC [TRIVIAL_HOMOMORPHISM_HOM_BOUNDARY_INCLUSION])

  let SHORT_EXACT_SEQUENCE_HOM_INDUCED_INCLUSION ← prove
   r"!p top s:A->bool.
        s = {} \/ s retract_of_space top
        ==> short_exact_sequence
               (homology_group(p,subtopology top s),
                homology_group(p,top),
                relative_homology_group(p,top,s))
               (hom_induced p (subtopology top s,{}) (top,{}) (\x. x),
                hom_induced p (top,{}) (top,s) (\x. x))"
   (REWRITE_TAC [short_exact_sequence, HOMOLOGY_EXACTNESS_AXIOM_3] THEN
    SIMP_TAC [GROUP_MONOMORPHISM_HOM_INDUCED_INCLUSION] THEN
    REWRITE_TAC [GROUP_EPIMORPHISM_HOM_INDUCED_RELATIVIZATION])

  return { TRIVIAL_RELATIVE_HOMOLOGY_GROUP_GEN, TRIVIAL_RELATIVE_HOMOLOGY_GROUP_TOPSPACE,
           TRIVIAL_RELATIVE_HOMOLOGY_GROUP_EMPTY, TRIVIAL_HOMOLOGY_GROUP_EMPTY,
           TRIVIAL_HOMOLOGY_GROUP_CONTRACTIBLE_SPACE,
           HOMEOMORPHIC_MAPS_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISMS,
           HOMEOMORPHIC_MAP_RELATIVE_HOMOLOGY_GROUP_ISOMORPHISM,
           GROUP_MONOMORPHISM_HOM_INDUCED_SECTION_MAP,
           GROUP_EPIMORPHISM_HOM_INDUCED_RETRACTION_MAP,
           HOMEOMORPHIC_MAP_HOMOLOGY_GROUP_ISOMORPHISM, GROUP_MONOMORPHISM_HOM_INDUCED_INCLUSION,
           TRIVIAL_HOMOMORPHISM_HOM_BOUNDARY_INCLUSION,
           GROUP_EPIMORPHISM_HOM_INDUCED_RELATIVIZATION,
           SHORT_EXACT_SEQUENCE_HOM_INDUCED_INCLUSION }

/- ------------------------------------------------------------------------- -/
/- Product splitting for retracts, explicit additivity.                      -/
/- (homology.ml 6062-6189)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HPR where
  GROUP_ISOMORPHISMS_HOMOLOGY_GROUP_PROD_RETRACT : thm
  ISOMORPHIC_GROUP_HOMOLOGY_GROUP_PROD_RETRACT : thm
  HOMOLOGY_ADDITIVITY_EXPLICIT : thm
  deriving Inhabited

@[nospecialize]
def setupHPR [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHIF : HIF) (BHAX : HAX) (BHXA : HXA)
    (BHBP : HBP) (BHTR : HTR) : ExceptT String IO HPR := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, DIFF_EQ_EMPTY, EMPTY_SUBSET, EQ_IMP, ETA_AX, IMAGE_CLAUSES, IMP_CONJ, IMP_IMP,
        INTER_EMPTY, .. } := D.core1
  let { LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { SUBSET_REFL, SUBSET_UNION, o_DEF, o_THM, .. } := D.core4
  let { EXACT_SEQUENCE_SUM_LEMMA, GROUP_HOMOMORPHISM_TRIVIAL, .. } := D.grp1
  let { GROUP_ISOMORPHISM_GROUP_MUL, ISOMORPHIC_GROUP_PROD_GROUPS, ISOMORPHIC_GROUP_SYM,
        ISOMORPHIC_GROUP_TRANS, SPLITTING_LEMMA_LEFT, isomorphic_group, normal_subgroup_of,
        trivial_group, .. } := D.grp2
  let { CLOSURE_OF_CLOSED_IN, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, .. } := D.met1
  let { INTERIOR_OF_OPEN_IN, OPEN_IN_SUBSET, .. } := D.met2
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, closed_in, retract_of_space, .. } := D.met3
  let { homology_group, .. } := BHGP
  let { HOM_INDUCED_COMPOSE, HOM_INDUCED_ID_GEN, .. } := BHIF
  let { HOMOLOGY_EXACTNESS_AXIOM_3, .. } := BHAX
  let { HOMOLOGY_EXCISION_AXIOM, .. } := BHXA
  let { ABELIAN_HOMOLOGY_GROUP, GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY, .. } := BHBP
  let { SHORT_EXACT_SEQUENCE_HOM_INDUCED_INCLUSION, TRIVIAL_HOMOLOGY_GROUP_EMPTY, .. } := BHTR
  -- @@SCOPE END

  let GROUP_ISOMORPHISMS_HOMOLOGY_GROUP_PROD_RETRACT ← prove
   r"!p top s:A->bool.
        s = {} \/ s retract_of_space top
        ==> ?h k. h subgroup_of homology_group(p,top) /\
                  k subgroup_of homology_group(p,top) /\
                  group_isomorphism
                   (prod_group (subgroup_generated (homology_group(p,top)) h)
                               (subgroup_generated (homology_group(p,top)) k),
                     (homology_group(p,top)))
                   (\(x,y). group_mul(homology_group(p,top)) x y) /\
                  group_isomorphism
                  (homology_group(p,subtopology top s),
                   subgroup_generated (homology_group(p,top)) h)
                  (hom_induced p (subtopology top s,{}) (top,{}) (\x. x)) /\
                  group_isomorphism
                  (subgroup_generated (homology_group(p,top)) k,
                   relative_homology_group(p,top,s))
                  (hom_induced p (top,{}) (top,s) (\x. x))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o SPEC (← q r"p:int") o
      MATCH_MP SHORT_EXACT_SEQUENCE_HOM_INDUCED_INCLUSION) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      SPLITTING_LEMMA_LEFT)) THEN
    REWRITE_TAC [LEFT_FORALL_IMP_THM, IMP_IMP] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (DISJ_CASES_THEN2 SUBST1_TAC ASSUME_TAC) THENL
       [EXISTS_TAC (← q r"(\x. group_id(homology_group(p,subtopology top {})))
               :(((num->real)->A)frag->bool)->((num->real)->A)frag->bool") THEN
        REWRITE_TAC [GROUP_HOMOMORPHISM_TRIVIAL] THEN
        MATCH_MP_TAC (← SET_RULE (← q r"s = {a} ==> !x. x IN s ==> a = x")) THEN
        REWRITE_TAC [← GSYM trivial_group] THEN
        MATCH_MP_TAC TRIVIAL_HOMOLOGY_GROUP_EMPTY THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, INTER_EMPTY],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [retract_of_space]) THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
          (X_CHOOSE_THEN (← q r"r:A->A") STRIP_ASSUME_TAC)) THEN
        EXISTS_TAC (← q r"hom_induced p (top,{}) (subtopology top s,{}) (r:A->A)") THEN
        ASM_SIMP_TAC [GROUP_HOMOMORPHISM_HOM_INDUCED_EMPTY] THEN
        REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN
        W (MP_TAC o PART_MATCH (rand o rand)
          HOM_INDUCED_COMPOSE o rator o lhand o snd) THEN
        REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET] THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
        ASM_REWRITE_TAC [← GSYM homology_group] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [o_DEF, ETA_AX] THEN
        MATCH_MP_TAC HOM_INDUCED_ID_GEN THEN
        ASM_REWRITE_TAC [← GSYM homology_group] THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
        ASM SET_TAC []],
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      REWRITE_TAC [normal_subgroup_of] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [GROUP_ISOMORPHISM_GROUP_MUL, ABELIAN_HOMOLOGY_GROUP]])

  let ISOMORPHIC_GROUP_HOMOLOGY_GROUP_PROD_RETRACT ← prove
   r"!p top s:A->bool.
        s = {} \/ s retract_of_space top
        ==> homology_group(p,top) isomorphic_group
            prod_group (homology_group(p,subtopology top s))
                       (relative_homology_group(p,top,s))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o SPEC (← q r"p:int") o
      MATCH_MP GROUP_ISOMORPHISMS_HOMOLOGY_GROUP_PROD_RETRACT) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
     [← q r"h:(((num->real)->A)frag->bool)->bool",
      ← q r"k:(((num->real)->A)frag->bool)->bool"] THEN
    STRIP_TAC THEN
    TRANS_TAC ISOMORPHIC_GROUP_TRANS
     (← q r"prod_group (subgroup_generated (homology_group(p,top:A topology)) h)
                 (subgroup_generated (homology_group(p,top)) k)") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN ASM_MESON_TAC [],
      MATCH_MP_TAC ISOMORPHIC_GROUP_PROD_GROUPS THEN
      GEN_REWRITE_TAC LAND_CONV [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN ASM_MESON_TAC []])

  let HOMOLOGY_ADDITIVITY_EXPLICIT ← prove
   r"!p top s t:A->bool.
        open_in top s /\ open_in top t /\
        DISJOINT s t /\ s UNION t = topspace top
        ==> group_isomorphism
             (prod_group (homology_group (p,subtopology top s))
                         (homology_group (p,subtopology top t)),
              homology_group (p,top))
             (\(a,b). group_mul (homology_group (p,top))
                (hom_induced p (subtopology top s,{}) (top,{}) (\x. x) a)
                (hom_induced p (subtopology top t,{}) (top,{}) (\x. x) b))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"closed_in top (s:A->bool) /\ closed_in top t")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [closed_in, OPEN_IN_SUBSET] THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"open_in top (t:A->bool)"),
        UNDISCH_TAC (← q r"open_in top (s:A->bool)")] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"hom_induced p (top,{}) (top,t) (\x:A. x)",
      ← q r"hom_induced p (top,{}) (top,s) (\x:A. x)",
      ← q r"hom_induced p (subtopology top s,{}) (top,t) (\x:A. x)",
      ← q r"hom_induced p (subtopology top s,{}) (top,{}) (\x:A. x)",
      ← q r"hom_induced p (subtopology top t,{}) (top,{}) (\x:A. x)",
      ← q r"hom_induced p (subtopology top t,{}) (top,s) (\x:A. x)",
      ← q r"homology_group(p,subtopology top s:A topology)",
      ← q r"homology_group(p,subtopology top t:A topology)",
      ← q r"relative_homology_group(p,top,t:A->bool)",
      ← q r"relative_homology_group(p,top,s:A->bool)",
      ← q r"homology_group(p,top:A topology)"]
     EXACT_SEQUENCE_SUM_LEMMA) THEN
    ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
    REWRITE_TAC [ABELIAN_HOMOLOGY_GROUP, HOMOLOGY_EXACTNESS_AXIOM_3] THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s UNION t:A->bool",
                         ← q r"t:A->bool", ← q r"t:A->bool"] HOMOLOGY_EXCISION_AXIOM),
        MP_TAC (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s UNION t:A->bool",
                         ← q r"s:A->bool", ← q r"s:A->bool"] HOMOLOGY_EXCISION_AXIOM)] THEN
      REWRITE_TAC [DIFF_EQ_EMPTY, SUBSET_UNION] THEN
      ASM_SIMP_TAC [← SET_RULE
       (← q r"DISJOINT s t ==> (s UNION t) DIFF t = s /\ (s UNION t) DIFF s = t")] THEN
      ASM_REWRITE_TAC [SUBTOPOLOGY_TOPSPACE, ← GSYM homology_group] THEN
      ASM_SIMP_TAC [CLOSURE_OF_CLOSED_IN, INTERIOR_OF_OPEN_IN, SUBSET_REFL],
      REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN
      ASM_SIMP_TAC [← GSYM HOM_INDUCED_COMPOSE, IMAGE_CLAUSES, EMPTY_SUBSET,
                    CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
      REWRITE_TAC [o_DEF]])

  return { GROUP_ISOMORPHISMS_HOMOLOGY_GROUP_PROD_RETRACT,
           ISOMORPHIC_GROUP_HOMOLOGY_GROUP_PROD_RETRACT, HOMOLOGY_ADDITIVITY_EXPLICIT }

/- ------------------------------------------------------------------------- -/
/- Generalize exact homology sequence to triples (derived from E-S axioms)   -/
/- (homology.ml 6190-6237)                                                   -/
/- ------------------------------------------------------------------------- -/

structure HRB where
  hom_relboundary : thm
  GROUP_HOMOMORPHISM_HOM_RELBOUNDARY : thm
  HOM_RELBOUNDARY : thm
  HOM_RELBOUNDARY_EMPTY : thm
  NATURALITY_HOM_INDUCED_RELBOUNDARY : thm
  deriving Inhabited

@[nospecialize]
def setupHRB [HolBase] (D : HomologyDeps) (BHGP : HGP) (BHBD : HBD) (BHIN : HIN) (BHIF : HIF) :
    ExceptT String IO HRB := do
  -- @@SCOPE BEGIN
  let { new_definition, SET_RULE, .. } := D
  let { EMPTY_SUBSET, ETA_AX, IMAGE_CLAUSES, IMAGE_ID, INTER_SUBSET, .. } := D.core1
  let { o_ASSOC, o_DEF, o_THM, .. } := D.core4
  let { GROUP_HOMOMORPHISM_COMPOSE, .. } := D.grp1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } :=
    D.met1
  let { TOPSPACE_SUBTOPOLOGY, .. } := D.met3
  let { homology_group, .. } := BHGP
  let { GROUP_HOMOMORPHISM_HOM_BOUNDARY, HOM_BOUNDARY, .. } := BHBD
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED, .. } := BHIN
  let { HOM_INDUCED_COMPOSE, HOM_INDUCED_ID, NATURALITY_HOM_INDUCED, .. } := BHIF
  -- @@SCOPE END

  let hom_relboundary ← new_definition
   r"hom_relboundary p (top:A topology,s,t) =
    hom_induced (p - &1) (subtopology top s,{}) (subtopology top s,t) (\x. x) o
    hom_boundary p (top,s)"

  let GROUP_HOMOMORPHISM_HOM_RELBOUNDARY ← prove
   r"!p top s t:A->bool.
           group_homomorphism
           (relative_homology_group (p,top,s),
            relative_homology_group (p - &1,subtopology top s,t))
           (hom_relboundary p (top,s,t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [hom_relboundary] THEN
    MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE THEN
    EXISTS_TAC (← q r"homology_group(p - &1,subtopology top (s:A->bool))") THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_HOM_BOUNDARY, GROUP_HOMOMORPHISM_HOM_INDUCED,
                 homology_group])

  let HOM_RELBOUNDARY ← prove
   r"!p top s t c.
         hom_relboundary p (top,s,t) c IN
         group_carrier (relative_homology_group (p - &1,subtopology top s,t))"
   (REWRITE_TAC [hom_relboundary, o_THM, HOM_INDUCED])

  let HOM_RELBOUNDARY_EMPTY ← prove
   r"!p top s:A->bool.
        hom_relboundary p (top,s,{}) = hom_boundary p (top,s)"
   (SIMP_TAC [hom_relboundary, o_DEF, HOM_INDUCED_ID, HOM_BOUNDARY,
              ← GSYM homology_group, ETA_AX])

  let NATURALITY_HOM_INDUCED_RELBOUNDARY ← prove
   r"!p top s t top' u v (f:A->B).
    continuous_map(top,top') f /\ IMAGE f s SUBSET u /\ IMAGE f t SUBSET v
    ==> hom_relboundary p (top',u,v) o
        hom_induced p (top,s) (top',u) f =
        hom_induced (p - &1) (subtopology top s,t) (subtopology top' u,v) f o
        hom_relboundary p (top,s,t)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [hom_relboundary, ← GSYM o_ASSOC, NATURALITY_HOM_INDUCED] THEN
    REWRITE_TAC [o_ASSOC] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o lhand o snd) THEN
    W (MP_TAC o PART_MATCH (rand o rand)
      HOM_INDUCED_COMPOSE o rand o rand o snd) THEN
    ASM_SIMP_TAC [IMAGE_CLAUSES, IMAGE_ID, EMPTY_SUBSET, INTER_SUBSET,
                  CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
                  CONTINUOUS_MAP_FROM_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, ← SET_RULE
                   (← q r"IMAGE f s SUBSET t ==> IMAGE f (u INTER s) SUBSET t")] THEN
    REPEAT (DISCH_THEN (SUBST1_TAC o SYM)) THEN REWRITE_TAC [o_DEF])

  return { hom_relboundary, GROUP_HOMOMORPHISM_HOM_RELBOUNDARY, HOM_RELBOUNDARY,
           HOM_RELBOUNDARY_EMPTY, NATURALITY_HOM_INDUCED_RELBOUNDARY }

/- ------------------------------------------------------------------------- -/
/- First exactness property for triples.  (homology.ml 6238-6350)            -/
/- ------------------------------------------------------------------------- -/

structure HT1 where
  HOMOLOGY_EXACTNESS_TRIPLE_1 : thm
  deriving Inhabited

@[nospecialize]
def setupHT1 [HolBase] (D : HomologyDeps) (BHBD : HBD) (BHIN : HIN) (BHIF : HIF) (BHEX : HEX)
    (BHAX : HAX) (BHRB : HRB) : ExceptT String IO HT1 := do
  -- @@SCOPE BEGIN
  let { SET_RULE, SET_TAC, GROUP_RULE, .. } := D
  let { EMPTY_SUBSET, EQ_TRANS, FORALL_IN_IMAGE, IMAGE_ID, IMP_CONJ, .. } := D.core1
  let { IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { SUBSET, SUBSET_ANTISYM, o_ASSOC, o_DEF, o_THM, .. } := D.core4
  let { GROUP_DIV, GROUP_HOMOMORPHISM_DIV, GROUP_HOMOMORPHISM_MUL, .. } := D.grp1
  let { GROUP_MUL, abelian_group, group_exactness, group_image, group_kernel, .. } := D.grp2
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } :=
    D.met1
  let { SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := D.met3
  let { GROUP_HOMOMORPHISM_HOM_BOUNDARY, HOM_BOUNDARY, .. } := BHBD
  let { GROUP_HOMOMORPHISM_HOM_INDUCED, HOM_INDUCED, .. } := BHIN
  let { ABELIAN_RELATIVE_HOMOLOGY_GROUP, HOM_INDUCED_COMPOSE, NATURALITY_HOM_INDUCED, .. } := BHIF
  let { HOMOLOGY_EXACTNESS_AXIOM_1, HOMOLOGY_EXACTNESS_AXIOM_2, .. } := BHEX
  let { HOMOLOGY_EXACTNESS_AXIOM_3, .. } := BHAX
  let { GROUP_HOMOMORPHISM_HOM_RELBOUNDARY, hom_relboundary, .. } := BHRB
  -- @@SCOPE END

  let HOMOLOGY_EXACTNESS_TRIPLE_1 ← prove
   r"!p top s t:A->bool.
       t SUBSET s
       ==> group_exactness(relative_homology_group(p,top,t),
                           relative_homology_group(p,top,s),
                           relative_homology_group(p - &1,subtopology top s,t))
               (hom_induced p (top,t) (top,s) (\x. x),
                hom_relboundary p (top,s,t))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [group_exactness, GROUP_HOMOMORPHISM_HOM_RELBOUNDARY,
                 GROUP_HOMOMORPHISM_HOM_INDUCED] THEN
    REWRITE_TAC [group_image, group_kernel] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN GEN_REWRITE_TAC BINOP_CONV [SUBSET] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN REWRITE_TAC [IN_IMAGE, IN_ELIM_THM] THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"b:((num->real)->A)frag->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [HOM_INDUCED, hom_relboundary] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN REWRITE_TAC [← GSYM o_ASSOC] THEN
      ASM_SIMP_TAC [NATURALITY_HOM_INDUCED, IMAGE_ID, CONTINUOUS_MAP_ID] THEN
      REWRITE_TAC [o_THM] THEN
      MP_TAC (← ISPECL [← q r"p - &1:int", ← q r"subtopology top (s:A->bool)",
                        ← q r"t:A->bool"]
          HOMOLOGY_EXACTNESS_AXIOM_3) THEN
      ASM_SIMP_TAC [SUBTOPOLOGY_SUBTOPOLOGY, ← SET_RULE
       (← q r"t SUBSET s ==> s INTER t = t")] THEN
      REWRITE_TAC [group_exactness, group_kernel, group_image] THEN
      DISCH_THEN (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"P /\ Q /\ IMAGE f s = {y | y IN t /\ g y = z}
        ==> !x. x IN s ==> g(f x) = z"))) THEN
      REWRITE_TAC [HOM_BOUNDARY],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:((num->real)->A)frag->bool") THEN
    REWRITE_TAC [hom_relboundary, o_THM] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"p - &1:int", ← q r"subtopology top (s:A->bool)", ← q r"t:A->bool"]
     HOMOLOGY_EXACTNESS_AXIOM_3) THEN
    REWRITE_TAC [group_exactness, group_kernel, group_image] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"hom_boundary p (top,s:A->bool) x") o
     MATCH_MP (← SET_RULE
       (← q r"P /\ Q /\ IMAGE f s = {y | y IN t /\ g y = z}
        ==> !x. x IN t /\ g x = z ==> ?y. y IN s /\ f y = x"))) THEN
    ASM_REWRITE_TAC [HOM_BOUNDARY] THEN
    ASM_SIMP_TAC [SUBTOPOLOGY_SUBTOPOLOGY, ← SET_RULE
     (← q r"t SUBSET s ==> s INTER t = t")] THEN
    DISCH_THEN (X_CHOOSE_THEN
     (← q r"y:((num->real)->A)frag->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"p:int", ← q r"top:A topology", ← q r"t:A->bool"]
          HOMOLOGY_EXACTNESS_AXIOM_2) THEN
    REWRITE_TAC [group_exactness, group_kernel, group_image] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"P /\ Q /\ IMAGE f s = {y | y IN t /\ g y = z}
        ==> !x. x IN t /\ g x = z ==> ?y. y IN s /\ f y = x"))) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"y:((num->real)->A)frag->bool")) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [MP_TAC (← ISPECL
       [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
          HOMOLOGY_EXACTNESS_AXIOM_2) THEN
      REWRITE_TAC [group_exactness, group_kernel, group_image] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"P /\ Q /\ IMAGE f s = {y | y IN t /\ g y = z}
        ==> !x. x IN s ==> g(f x) = z"))) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:((num->real)->A)frag->bool")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EQ_TRANS) THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← SYM th])) THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM] THEN AP_THM_TAC THEN
      W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o rand o snd) THEN
      SIMP_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
                CONTINUOUS_MAP_FROM_SUBTOPOLOGY, IMAGE_ID, EMPTY_SUBSET] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      REWRITE_TAC [o_DEF],
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:((num->real)->A)frag->bool")
        STRIP_ASSUME_TAC)] THEN
    MP_TAC (← ISPECL [← q r"p:int", ← q r"top:A topology", ← q r"s:A->bool"]
     HOMOLOGY_EXACTNESS_AXIOM_1) THEN
    REWRITE_TAC [group_exactness, group_kernel, group_image] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"P /\ Q /\ IMAGE f s = {y | y IN t /\ g y = z}
        ==> !x. x IN t /\ g x = z ==> ?y. y IN s /\ f y = x"))) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"group_div (relative_homology_group (p,top,s)) x
                (hom_induced p (top,t) (top,s) (\x:A. x) z)")) THEN
    ASM_SIMP_TAC [GROUP_DIV, HOM_INDUCED, HOM_BOUNDARY,
                  ← MATCH_MP GROUP_HOMOMORPHISM_DIV
                    (← SPEC_ALL GROUP_HOMOMORPHISM_HOM_BOUNDARY),
                  ← GROUP_RULE (← q r"group_div G x y = group_id G <=> y = x")] THEN
    ANTS_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [← GSYM o_THM] THEN
      ASM_SIMP_TAC [NATURALITY_HOM_INDUCED, IMAGE_ID, CONTINUOUS_MAP_ID] THEN
      ASM_REWRITE_TAC [o_THM],
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:((num->real)->A)frag->bool")
          STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC (← q r"group_mul (relative_homology_group (p,top,t)) z
                          (hom_induced p (top,{}) (top,t) (\x:A. x) w)") THEN
    ASM_SIMP_TAC [GROUP_MUL, HOM_INDUCED,
                  ← MATCH_MP GROUP_HOMOMORPHISM_MUL
                     (← SPEC_ALL GROUP_HOMOMORPHISM_HOM_INDUCED)] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
       (← REWRITE_RULE [abelian_group] ABELIAN_RELATIVE_HOMOLOGY_GROUP) o
      rand o snd) THEN
    REWRITE_TAC [HOM_INDUCED] THEN DISCH_THEN SUBST1_TAC THEN
    ASM_SIMP_TAC [GROUP_MUL, HOM_INDUCED,
                  ← GROUP_RULE (← q r"x = group_mul G z y <=> group_div G x y = z")] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC LAND_CONV [← SYM th])) THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM o_THM] THEN AP_THM_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o rand o snd) THEN
    SIMP_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
              CONTINUOUS_MAP_FROM_SUBTOPOLOGY, IMAGE_ID, EMPTY_SUBSET] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [o_DEF])

  return { HOMOLOGY_EXACTNESS_TRIPLE_1 }

