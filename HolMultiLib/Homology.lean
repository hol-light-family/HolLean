  let { CHAIN_BOUNDARY_0, CHAIN_BOUNDARY_CMUL, CHAIN_BOUNDARY_NEG, CHAIN_BOUNDARY_SUB,
        CHAIN_BOUNDARY_SUM, SINGULAR_CHAIN_0, SINGULAR_CHAIN_CMUL, SINGULAR_CHAIN_NEG,
        SINGULAR_CHAIN_OF, SINGULAR_CHAIN_SUB, SINGULAR_CHAIN_SUM, chain_boundary,
        singular_chain, .. } := BSCH
  let { mod_subset, singular_relcycle, .. } := BMSR
  let { singular_relboundary, .. } := BRBD
  let { homologous_rel, .. } := BHMR
  let { CHAIN_MAP_0, CHAIN_MAP_OF, CHAIN_MAP_SUB, SINGULAR_FACE_SIMPLEX_MAP,
        SINGULAR_SIMPLEX_SIMPLEX_MAP, simplex_map, .. } := BSMP
  let { SIMPLICIAL_IMP_SINGULAR_SIMPLEX, SIMPLICIAL_SIMPLEX, SIMPLICIAL_SIMPLEX_ORIENTED_SIMPLEX,
        oriented_simplex, .. } := BSSC
  -- @@SCOPE END

  let HOMOTOPIC_IMP_HOMOLOGOUS_REL_CHAIN_MAPS ← prove
   r"!p f g:A->B s t u v c:((num->real)->A)frag.
        homotopic_with (\h. IMAGE h t SUBSET v) (s,u) f g /\
        singular_relcycle (p,s,t) c
