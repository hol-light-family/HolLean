        REWRITE_TAC [trivial_group] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"x IN c /\ a = b ==> c = {b} ==> x = a")) THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
