        ONCE_REWRITE_TAC [← GSYM TOPSPACE_SUBTOPOLOGY] THEN
        REWRITE_TAC [← GSYM RELATIVE_HOMOLOGY_GROUP_RESTRICT, HOM_INDUCED]],
      DISCH_TAC] THEN
    X_GEN_TAC (← q r"x:((num->real)->A)frag->bool") THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"b = hom_boundary p (top:A topology,t) x") THEN
