    REWRITE_TAC [HOM_INDUCED, homology_group] THEN
    GEN_REWRITE_TAC (funpow 3 LAND_CONV) [← GSYM o_THM] THEN
    W (MP_TAC o PART_MATCH (rand o rand) HOM_INDUCED_COMPOSE o
