    REWRITE_TAC [SIMPLICIAL_CHAIN_OF,
             SIMPLICIAL_SIMPLEX_I, SUBSET_REFL] THEN
    DISCH_THEN SUBST1_TAC THEN
    MP_TAC (← ISPECL
     [← q r"p - 1", ← q r"standard_simplex p",
      ← q r"chain_boundary p (frag_of (RESTRICTION (standard_simplex p) I))"]
     SINGULAR_SUBDIVISION_SIMPLICIAL_SIMPLEX) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC SIMPLICIAL_CHAIN_BOUNDARY THEN
      REWRITE_TAC [SIMPLICIAL_SIMPLEX_I, SIMPLICIAL_CHAIN_OF, SUBSET_REFL],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MP_TAC (← ISPECL [← q r"p - 1",
                      ← q r"subtopology (product_topology (:num) (\i. euclideanreal))
                                (standard_simplex p)",
                      ← q r"f:(num->real)->A",
                      ← q r"chain_boundary p (frag_of
              (RESTRICTION (standard_simplex p) I))"]
