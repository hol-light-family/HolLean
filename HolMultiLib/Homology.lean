structure HEC where
  RELATIVE_HOMOLOGY_GROUP_EUCLIDEAN_COMPLEMENT_STEP : thm
  deriving Inhabited

@[nospecialize]
def setupHEC [HolBase] (D : HomologyDeps) (BHXA : HXA) (BHDR : HDR) (BHCT : HCT) :
    ExceptT String IO HEC := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH_TAC, MESON,
        MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { ADD1, ADD_CLAUSES, AND_FORALL_THM, CARTESIAN_PRODUCT_UNIV, CONJ_ASSOC, CONTRAPOS_THM,
        EQ_IMP, EXTENSION, FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT,
        INT_ADD_ASSOC, INT_ADD_RID, .. } := D.core1
  let { INT_OF_NUM_SUC, IN_CROSS, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_UNION, IN_UNIV,
        I_DEF, LAMBDA_PAIR, LAMBDA_PAIR_THM, LE_REFL, MEMBER_NOT_EMPTY, MONO_AND, .. } := D.core2
  let { REAL_ABS_MUL, REAL_ADD_LID, REAL_ADD_RDISTRIB, REAL_ADD_RID, REAL_LE_REFL, REAL_LE_TOTAL,
        REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_NEG_EQ_0, REAL_NEG_NEG,
        RIGHT_FORALL_IMP_THM, .. } := D.core3
  let { SUBSET, SUBSET_UNION, SUBSET_UNIV, SWAP_FORALL_THM, num_INDUCTION, o_DEF, real_gt, .. } :=
    D.core4
  let { IN_REAL_INTERVAL, .. } := D.lib
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, ISOMORPHIC_GROUP_REFL, ISOMORPHIC_GROUP_SYM,
        ISOMORPHIC_GROUP_TRANS, .. } := D.grp2
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CLOSED_IN_EUCLIDEAN_SPACE, CLOSED_IN_INTER,
        CLOSED_IN_SUBSET, CLOSED_IN_SUBTOPOLOGY, CLOSURE_OF_COMPLEMENT,
        CONTINUOUS_MAP_COMPONENTWISE_UNIV, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_FST,
        CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_OF_SND,
        CONTINUOUS_MAP_PRODUCT_PROJECTION, CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_CONST,
        CONTINUOUS_MAP_REAL_MUL, CONTINUOUS_MAP_REAL_NEG_EQ, CONTINUOUS_MAP_REAL_SUB,
        CONTRACTIBLE_EUCLIDEAN_SPACE, .. } := D.met1
  let { DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT_SPACE, HOMEOMORPHIC_SPACE_CONTRACTIBILITY,
        HOMOTOPIC_WITH, HOMOTOPIC_WITH_SYM, HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY,
        HOMOTOPY_EQUIVALENT_SPACE_SYM, INTERIOR_OF_OPEN_IN, INTERIOR_OF_SUBTOPOLOGY_OPEN,
        OPEN_IN_CONTINUOUS_MAP_PREIMAGE, OPEN_IN_DIFF, OPEN_IN_INTER, OPEN_IN_SUBOPEN,
        OPEN_IN_TOPSPACE, OPEN_IN_UNION, .. } := D.met2
  let { REAL_OPEN_HALFSPACE_GT, REAL_OPEN_HALFSPACE_LT, REAL_OPEN_IN, SUBTOPOLOGY_CROSS,
        SUBTOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_TOPSPACE, SUBTOPOLOGY_UNIV, TOPSPACE_EUCLIDEANREAL,
        TOPSPACE_EUCLIDEAN_SPACE, TOPSPACE_PRODUCT_TOPOLOGY, TOPSPACE_PROD_TOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, continuous_map, contractible_space, euclidean_space,
        homeomorphic_maps, homeomorphic_space, homotopic_with, retraction_maps, .. } := D.met3
  let { HOMOLOGY_EXCISION_AXIOM, .. } := BHXA
  let { DEFORMATION_RETRACT_IMP_ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS, .. } := BHDR
  let { ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_INCLUSION_CONTRACTIBLE,
        ISOMORPHIC_RELATIVE_HOMOLOGY_GROUPS_RELBOUNDARY_CONTRACTIBLE, .. } := BHCT
  -- @@SCOPE END

  let RELATIVE_HOMOLOGY_GROUP_EUCLIDEAN_COMPLEMENT_STEP ← prove
   r"!p n k s.
        closed_in (euclidean_space n) s
        ==> relative_homology_group
             (p,euclidean_space n,topspace(euclidean_space n) DIFF s)
            isomorphic_group
            relative_homology_group
             (p + &k,euclidean_space (n+k),
                     topspace(euclidean_space (n+k)) DIFF s)"
   (SUBGOAL_THEN
     (← q r"!p n s.
          closed_in (euclidean_space (n + 1)) s /\
          (!x y. (!i. ~(i = n + 1) ==> x i = y i) /\ x IN s ==> y IN s)
          ==> relative_homology_group
               (p,euclidean_space n,topspace(euclidean_space n) DIFF s)
              isomorphic_group
              relative_homology_group
               (p + &1,euclidean_space (n+1),
                topspace(euclidean_space (n+1)) DIFF
                {x | x IN s /\ x(n + 1) = &0})")
    ASSUME_TAC THENL
     [ALL_TAC,
      GEN_TAC THEN GEN_TAC THEN GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN GEN_TAC THEN DISCH_TAC THEN
      MATCH_MP_TAC num_INDUCTION THEN
      REWRITE_TAC [ADD_CLAUSES, INT_ADD_RID, ISOMORPHIC_GROUP_REFL] THEN
      X_GEN_TAC (← q r"m:num") THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] ISOMORPHIC_GROUP_TRANS) THEN
      SUBGOAL_THEN (← q r"closed_in (euclidean_space (m + n)) s") MP_TAC THEN
      UNDISCH_TAC (← q r"closed_in (euclidean_space n) s") THENL
       [REWRITE_TAC [euclidean_space, CLOSED_IN_SUBTOPOLOGY] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:(num->real)->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"c INTER topspace(euclidean_space n)") THEN
        ASM_SIMP_TAC [CLOSED_IN_INTER, CLOSED_IN_EUCLIDEAN_SPACE] THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEAN_SPACE] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"s SUBSET t ==> c INTER s = (c INTER s) INTER t")) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_NUMSEG] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_ARITH_TAC,
        DISCH_THEN (K ALL_TAC) THEN
        REWRITE_TAC [← GSYM INT_OF_NUM_SUC, INT_ADD_ASSOC, ADD_CLAUSES] THEN
        SPEC_TAC (← q r"p + &m:int", ← q r"p:int") THEN REWRITE_TAC [ADD1] THEN
        SUBST1_TAC (← ARITH_RULE (← q r"m + n:num = n + m")) THEN
        SPEC_TAC (← q r"n + m:num", ← q r"n:num")] THEN
      REPEAT STRIP_TAC THEN
      ABBREV_TAC (← q r"s' = {x | x IN topspace(euclidean_space(n + 1)) /\
                            (\i. if i <= n then x i else &0) IN s}") THEN
      FIRST_X_ASSUM (MP_TAC o
       SPECL [← q r"p:int", ← q r"n:num", ← q r"s':(num->real)->bool"]) THEN
      ANTS_TAC THENL
       [EXPAND_TAC "s'" THEN CONJ_TAC THENL
         [MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
          EXISTS_TAC (← q r"euclidean_space n") THEN
          ASM_REWRITE_TAC [] THEN REWRITE_TAC [euclidean_space] THEN
          REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
          REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV, SUBSET] THEN
          REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM] THEN CONJ_TAC THENL
           [X_GEN_TAC (← q r"k:num") THEN
            MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
            ASM_CASES_TAC (← q r"k:num <= n") THEN
            ASM_REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST] THEN
            SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV],
            REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
            REWRITE_TAC [IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
            COND_CASES_TAC THEN REWRITE_TAC [] THEN
            FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC],
          REWRITE_TAC [IN_ELIM_THM, TOPSPACE_EUCLIDEAN_SPACE, IN_NUMSEG] THEN
          REPEAT GEN_TAC THEN
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
          MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
           [ASM_MESON_TAC [LE_REFL, ← ARITH_RULE (← q r"1 <= n + 1")],
            MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
            ABS_TAC THEN COND_CASES_TAC THEN REWRITE_TAC [] THEN
            FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC]],
        MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN REPLICATE_TAC 3 AP_TERM_TAC THEN
        EXPAND_TAC "s'" THEN REWRITE_TAC [TOPSPACE_EUCLIDEAN_SPACE] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN u ==> (x IN s <=> x IN t))
          ==> u DIFF s = u DIFF t")) THEN
        SIMP_TAC [IN_ELIM_THM, IN_NUMSEG, ← ARITH_RULE
         (← q r"~(1 <= i /\ i <= n + 1) ==> ~(1 <= i /\ i <= n)")]
        THENL
         [REPEAT STRIP_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
          REWRITE_TAC [FUN_EQ_THM] THEN ASM_MESON_TAC [],
          X_GEN_TAC (← q r"x:num->real") THEN DISCH_TAC THEN EQ_TAC THENL
           [DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
            MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
            REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"i:num") THEN
            ASM_CASES_TAC (← q r"i:num <= n") THEN ASM_REWRITE_TAC [] THEN
            CONV_TAC SYM_CONV THEN ASM_CASES_TAC (← q r"i = n + 1") THEN
            ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
            ASM_ARITH_TAC,
            DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
            REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real")) THEN
            ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN_SPACE, IN_ELIM_THM] THEN
            REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
            ASM_SIMP_TAC [← ARITH_RULE (← q r"~(n + 1 <= n)")] THEN
            UNDISCH_TAC (← q r"(x:num->real) IN s") THEN
            MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
            REWRITE_TAC [FUN_EQ_THM] THEN ASM_MESON_TAC []]]]] THEN
    REPEAT STRIP_TAC THEN MAP_EVERY ABBREV_TAC
     [← q r"lo = {x | x IN topspace(euclidean_space (n + 1)) /\
                 x(n+1) < (if x IN s then &0 else &1)}",
      ← q r"hi = {x | x IN topspace(euclidean_space (n + 1)) /\
                 x(n+1) > (if x IN s then &0 else -- &1)}"] THEN
    SUBGOAL_THEN
     (← q r"lo INTER hi =
      {x | x IN topspace(euclidean_space (n + 1)) DIFF s /\
           x(n+1) IN real_interval(-- &1,&1)}")
    ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["lo", "hi"] THEN
      REWRITE_TAC [EXTENSION, IN_INTER, IN_ELIM_THM, IN_DIFF] THEN
      X_GEN_TAC (← q r"x:num->real") THEN
      ASM_CASES_TAC (← q r"x IN topspace(euclidean_space (n + 1))") THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
      ASM_CASES_TAC (← q r"(x:num->real) IN s") THEN ASM_REWRITE_TAC [] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"lo UNION hi =
      topspace(euclidean_space (n + 1)) DIFF {x | x IN s /\ x(n+1) = &0}")
    ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["lo", "hi"] THEN
      REWRITE_TAC [EXTENSION, IN_UNION, IN_ELIM_THM, IN_DIFF] THEN
      X_GEN_TAC (← q r"x:num->real") THEN
      ASM_CASES_TAC (← q r"x IN topspace(euclidean_space (n + 1))") THEN
      ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"(x:num->real) IN s") THEN ASM_REWRITE_TAC [] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    ABBREV_TAC (← q r"ret = \c (x:num->real) i. if i = n + 1 then c else x i") THEN
    SUBGOAL_THEN
     (← q r"!t:real. continuous_map (product_topology (:num) (\i. euclideanreal),
                               product_topology (:num) (\i. euclideanreal))
                              (ret t)")
    ASSUME_TAC THENL
     [GEN_TAC THEN EXPAND_TAC "ret" THEN
      REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN
      X_GEN_TAC (← q r"k:num") THEN ASM_CASES_TAC (← q r"k = n + 1") THEN
