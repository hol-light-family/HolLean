def prove_bdry_gen_zero2 (clG : thm) (no ko : Int) (gen_tm : term) : ExceptT String IO thm := do
  let ci ← bdry_cl_inst clG no ko
  prove (← ec (HolCore.Bool.mk_imp (← ExceptT.mk [[1 <= p]]) (← mkEq gen_tm zero_tm)))
    (DISCH_TAC THEN MP_TAC ci THEN ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RING)
#eval IO.println "<fun>"

