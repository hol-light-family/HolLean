#eval phrase 19
def DIVIDES_NPRODUCT_FROM_MEMBER : thm := keep "DIVIDES_NPRODUCT_FROM_MEMBER" fun _ => (do
  prove ([[!s n x:A. FINITE s /\ n divides (f x) /\ x IN s
             ==> n divides nproduct s f]])
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN REWRITE_TAC [NOT_IN_EMPTY] THEN
    SIMP_TAC [IN_INSERT, NPRODUCT_CLAUSES] THEN
    MESON_TAC [DIVIDES_LMUL, DIVIDES_RMUL])
  : ExceptT String IO thm).run
#eval DIVIDES_NPRODUCT_FROM_MEMBER

#eval phrase 20
def LOG_LCM_BOUND : thm := keep "LOG_LCM_BOUND" fun _ => (do
  let h8 ← ar (← ExceptT.mk [[1 <= n <=> ~(n = 0)]])
  let h7 ← ar (← ExceptT.mk [[1 < n <=> 2 <= n]])
  let h6 ← ar (← ExceptT.mk [[1 < p <=> 2 <= p]])
  let h5 ← rr (← ExceptT.mk [[x < floor x + &1 /\ k <= x ==> floor x = a ==> k < a + &1]])
  let h4 ← ar (← ExceptT.mk [[m <= n <=> m < n + 1]])
  let h3 ← tt (← ExceptT.mk [[b /\ (b ==> a) ==> a /\ b]])
  let h2 ← ar (← ExceptT.mk [[2 <= p ==> 1 <= p]])
  let h1 ← ms [DIVIDES_LE] (← ExceptT.mk [[~(n = 0) /\ m divides n ==> m <= n]])
  prove ([[!n. ~(n = 0)
       ==> log(&(LCM(1..n))) <= log(&n) * &(CARD {p | prime p /\ p <= n})]])
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [LCM_CLAUSES_NUMSEG, ARITH, LOG_1, REAL_ADD_LID, REAL_POS] THEN
    ABBREV_TAC ([[a = \p. @k. floor(log(&n) / log(&p)) = &k]]) THEN
    SUBGOAL_THEN ([[!p. prime p ==> floor(log(&n) / log(&p)) = &(a p)]]) ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN EXPAND_TAC "a" THEN CONV_TAC (pureC SELECT_CONV) THEN
      MATCH_MP_TAC FLOOR_POS THEN MATCH_MP_TAC REAL_LE_DIV THEN
      ASM_SIMP_TAC [LOG_POS, LE_1, PRIME_IMP_NZ, REAL_OF_NUM_LE],
      ALL_TAC] THEN
    TRANS_TAC REAL_LE_TRANS ([[log(&(nproduct {p | p IN 1..n /\ prime p} (\p. p EXP (a p))))]]) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC LOG_MONO_LE_IMP THEN
      ASM_SIMP_TAC [REAL_OF_NUM_LT, LCM_NONZERO, LE_1, REAL_OF_NUM_LE] THEN
      MATCH_MP_TAC h1 THEN
      CONJ_TAC THENL
       [SIMP_TAC [NPRODUCT_EQ_0, FINITE_NUMSEG, FINITE_RESTRICT] THEN
        REWRITE_TAC [IN_ELIM_THM, EXP_EQ_0] THEN MESON_TAC [PRIME_IMP_NZ],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [PRIMEPOW_DIVISORS_DIVIDES] THEN
      ASM_SIMP_TAC [IMP_CONJ, PRIMEPOW_DIVIDES_NUMSEG_LCM] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN REPEAT STRIP_TAC THEN
      ASM_CASES_TAC ([[k = 0]]) THEN ASM_REWRITE_TAC [EXP, DIVIDES_1] THEN
      MATCH_MP_TAC DIVIDES_NPRODUCT_FROM_MEMBER THEN EXISTS_TAC ([[p:num]]) THEN
      ASM_SIMP_TAC [IN_ELIM_THM, FINITE_RESTRICT, FINITE_NUMSEG, IN_NUMSEG] THEN
      ASM_SIMP_TAC [PRIME_GE_2, DIVIDES_EXP_LE, h2] THEN
      MATCH_MP_TAC h3 THEN CONJ_TAC THENL
       [SUBGOAL_THEN ([[p divides m]]) MP_TAC THENL
         [TRANS_TAC DIVIDES_TRANS ([[p EXP k]]) THEN ASM_REWRITE_TAC [] THEN
          GEN_REWRITE_TAC HolLight.LAND_CONV [(← HolLight.GSYM EXP_1)] THEN
          ASM_SIMP_TAC [DIVIDES_EXP_LE, PRIME_GE_2, LE_1],
          DISCH_THEN (MP_TAC o HolLight.MATCH_MP DIVIDES_LE) THEN ASM_ARITH_TAC],
        DISCH_TAC THEN REWRITE_TAC [h4] THEN
        FIRST_X_ASSUM (MP_TAC o HolLight.MATCH_MP DIVIDES_LE) THEN
        ASM_SIMP_TAC [LE_1] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o HolLight.SPEC ([[p:num]])) THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_LT), (← HolLight.GSYM REAL_OF_NUM_ADD)] THEN
        MATCH_MP_TAC h5 THEN
        REWRITE_TAC [FLOOR] THEN
        ASM_SIMP_TAC [REAL_LE_RDIV_EQ, LOG_POS_LT, REAL_OF_NUM_LT, PRIME_GE_2,
                     h6, (← HolLight.GSYM LOG_POW),
                     PRIME_IMP_NZ, LE_1] THEN
        MATCH_MP_TAC LOG_MONO_LE_IMP THEN
        ASM_REWRITE_TAC [REAL_OF_NUM_LE, REAL_OF_NUM_LE, REAL_OF_NUM_POW] THEN
        CONJ_TAC THENL [REWRITE_TAC [REAL_OF_NUM_LT], ASM_ARITH_TAC] THEN
        REWRITE_TAC [EXP_LT_0] THEN ASM_MESON_TAC [PRIME_IMP_NZ]],
      SIMP_TAC [LOG_PRODUCT, LE_1, EXP_EQ_0, PRIME_IMP_NZ, FINITE_RESTRICT,
       REAL_OF_NUM_NPRODUCT, FINITE_NUMSEG, REAL_OF_NUM_LT, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_POW)] THEN
