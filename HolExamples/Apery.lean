   ((p+1)+0 = p+1) /\ ((p+1)+1 = p+2) /\ ((p+1)+2 = p+3) /\
   ((p+2)+0 = p+2) /\ ((p+2)+1 = p+3) /\ ((p+2)+2 = p+4) /\
