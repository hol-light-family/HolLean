/- ------------------------------------------------------------------------- -/
/- PFLAT decomposes over bb = aa*zz + ww. The aa*zz part is killed          -/
/- algebraically using P_flat = M o L and AA_RECURRENCE. The harmonic kernel -/
/- P_flat[ww] is handled by creative telescoping below.                      -/
/- ------------------------------------------------------------------------- -/

#eval phrase 63
def LOP_AAZZ : thm := keep "LOP_AAZZ" fun _ => (do
  let h1 ← ar (← ExceptT.mk [[n + 2 = (n + 1) + 1]])
  prove ([[!n. lop (\m. aa m * zz m) n =
       (&n + &2) pow 3 * aa(n+2) / (&n + &1) pow 3 + aa(n+2) -
       (&2 * &n + &3) * (&17 * &n pow 2 + &51 * &n + &39) * aa(n+1) / (&n + &1) pow 3]])
   (GEN_TAC THEN REWRITE_TAC [lop] THEN BETA_TAC THEN
    MP_TAC (← HolLight.SPEC ([[n:num]]) AA_RECURRENCE) THEN
    REWRITE_TAC [h1, ZZ_STEP,
                (← HolLight.GSYM REAL_OF_NUM_ADD)] THEN
    SUBGOAL_THEN ([[~(&n + &1 = &0) /\ ~(&n + &2 = &0)]]) MP_TAC THENL
     [REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)] THEN REAL_ARITH_TAC2, ALL_TAC] THEN
    CONV_TAC rf)
  : ExceptT String IO thm).run
#eval LOP_AAZZ

/- The aa 3-term recurrence in the explicit (m+2)^3-leading form, at row m. -/

#eval phrase 64
def AA_REC_ROW : thm := keep "AA_REC_ROW" fun _ => (do
  let h1 ← ar (← ExceptT.mk [[(m+1)+1 = m+2]])
  prove ([[!m. (&m + &2) pow 3 * aa(m+2) =
       (&2 * &m + &3) * (&17 * &m pow 2 + &51 * &m + &39) * aa(m+1) -
       (&m + &1) pow 3 * aa(m)]])
   (GEN_TAC THEN MP_TAC (← HolLight.SPEC ([[m:num]]) AA_RECURRENCE) THEN
    REWRITE_TAC [h1] THEN REAL_ARITH_TAC2)
  : ExceptT String IO thm).run
#eval AA_REC_ROW

/- P_flat[aa*zz] = 0 follows from MOL_FACTOR and LOP_AAZZ at three rows, -/
/- together with the aa recurrence at the same rows. -/

#eval phrase 65
def PFLAT_AAZZ : thm := keep "PFLAT_AAZZ" fun _ => (do
  let a4 ← ar (← ExceptT.mk [[(n+2)+2 = n+4]])
  let a3 ← ar (← ExceptT.mk [[(n+2)+1 = n+3]])
  let a2 ← ar (← ExceptT.mk [[(n+1)+2 = n+3]])
  let a1 ← ar (← ExceptT.mk [[(n+1)+1 = n+2]])
  let b4 ← ar (← ExceptT.mk [[(n+2)+2 = n+4]])
  let b3 ← ar (← ExceptT.mk [[(n+1)+2 = n+3]])
  let b2 ← ar (← ExceptT.mk [[(n+2)+1 = n+3]])
  let b1 ← ar (← ExceptT.mk [[(n+1)+1 = n+2]])
  prove ([[!n. pflat (\m. aa m * zz m) n = &0]])
   (GEN_TAC THEN REWRITE_TAC [MOL_FACTOR] THEN
    REWRITE_TAC [LOP_AAZZ, b1, b2, b3, b4] THEN
    REWRITE_TAC [m0c, m1c, m2c] THEN
    MP_TAC (← HolLight.SPEC (← ExceptT.mk [[n:num]]) AA_REC_ROW) THEN
    MP_TAC (← HolLight.SPEC (← ExceptT.mk [[n+1]]) AA_REC_ROW) THEN
    MP_TAC (← HolLight.SPEC (← ExceptT.mk [[n+2]]) AA_REC_ROW) THEN
    REWRITE_TAC [a1, a2, a3, a4, (← HolLight.GSYM REAL_OF_NUM_ADD)] THEN
    SUBGOAL_THEN ([[~(&n + &1 = &0) /\ ~(&n + &2 = &0) /\ ~(&n + &3 = &0)]])
      MP_TAC THENL
     [REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)] THEN REAL_ARITH_TAC2, ALL_TAC] THEN
    REPEAT (DISCH_THEN (fun th => if HolCore.Basics.is_imp (concl th) then ALL_TAC else
                                  ASSUME_TAC th) ORELSE STRIP_TAC) THEN
    POP_ASSUM_LIST (fun ths => HolLight.tactic_of do
      pure (MP_TAC (← ec (HolCore.Lib.end_itlistM (fun a b => Session.CONJ a b) ths)))) THEN
    CONV_TAC REAL_FIELD)
  : ExceptT String IO thm).run
