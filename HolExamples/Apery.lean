-- let apery_vec_add xs ys = map2 apery_add xs ys and ...;;
private def zipM (f : term → term → Except String term) : List term → List term → Except String (List term)
  | [], [] => pure []
  | x :: xs, y :: ys => do pure ((← f x y) :: (← zipM f xs ys))
  | _, _ => throw "map2: length mismatch"
def apery_vec_add (xs ys : List term) : Except String (List term) := zipM apery_add xs ys
def apery_vec_sub (xs ys : List term) : Except String (List term) := zipM apery_sub xs ys
def apery_vec_neg (xs : List term) : Except String (List term) := xs.mapM apery_neg
def apery_vec_scale (c : term) (xs : List term) : Except String (List term) := xs.mapM (apery_mul c)
#eval do IO.println "<fun>"; IO.println "<fun>"; IO.println "<fun>"; IO.println "<fun>"

#eval phrase 125
-- let rec apery_linearize tm = ...;;
partial def apery_linearize (tm : term) : Except String (List term) := do
  if apery_atoms.contains tm then
    pure (apery_zero :: apery_atoms.map (fun a => if tm == a then apery_one else apery_zero))
  else if !(apery_has_atom tm) then
    pure [tm, apery_zero, apery_zero, apery_zero]
  else if is_binop_op add_tm tm then
    let (l, r) ← HolCore.Basics.dest_binop add_tm tm
    apery_vec_add (← apery_linearize l) (← apery_linearize r)
  else if is_binop_op sub_tm tm then
    let (l, r) ← HolCore.Basics.dest_binop sub_tm tm
    apery_vec_sub (← apery_linearize l) (← apery_linearize r)
  else if (match tm with | .Comb r _ => r == neg_tm | _ => false) then
    apery_vec_neg (← apery_linearize (← HolCore.Kernel.rand tm))
  else if is_binop_op mul_tm tm then
    let (l, r) ← HolCore.Basics.dest_binop mul_tm tm
    if !(apery_has_atom l) then apery_vec_scale l (← apery_linearize r)
    else if !(apery_has_atom r) then apery_vec_scale r (← apery_linearize l)
    else throw "apery_linearize: nonlinear product"
  else throw "apery_linearize: unsupported term"
#eval IO.println "<fun>"

