#eval phrase 219
-- let prove_pnz f = ...;;
def prove_pnz (f : term) : ExceptT String IO thm := do
  let tac := REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD), (← HolLight.GSYM REAL_OF_NUM_LE)] THEN
    DISCH_TAC THEN CONV_TAC (HolLight.RAND_CONV (HolLight.LAND_CONV REAL_POLY_CONV)) THEN ASM_REAL_ARITH_TAC
  let hyp ← ExceptT.mk [[1 <= p]]
  HolLight.MP (← prove (← ec (HolCore.Bool.mk_imp hyp (← ec (HolCore.Bool.mk_neg (← mkEq f zero_tm))))) tac)
    (← HolLight.ASSUME hyp)
#eval IO.println "<fun>"

