/- The bracket coefficient (after the two substitutions) is identically 0,
   proven by clearing the qc denominators with the certificate machinery. -/

#eval phrase 166
def QFLAT_N1_BRACKET : thm := keep "QFLAT_N1_BRACKET" fun _ => (do
  let bracket_tm ← ExceptT.mk [[qc00 n 1 +
     qc10 n 1 * (-- &n - &2 - &0) / (-- &n + &0) +
     qc01 n 1 * ((&n + &2 + &0) * (-- &n + &0 + &1) *
        (&2 * &0 pow 3 + &8 * &0 pow 2 + &11 * &0 + &5 - &0 * &n - &0 * &n pow 2 - &2 * &n pow 2 - &2 * &n) /
        (&0 + &2) pow 5)]]
  let bracket_unf ← ec (HolCore.Equal.rhs (concl (← ExceptT.mk (HolLight.REWRITE_CONV [qc00, qc01, qc10] bracket_tm))))
  let dfs := denom_factors bracket_unf []
  let h3n ← ExceptT.mk [[3 <= n]]
  let hyp3 ← HolLight.ASSUME h3n
  let prove_nz_3 (f : term) : ExceptT String IO thm := do
    let tac := REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_LE)] THEN STRIP_TAC THEN ASM_REAL_ARITH_TAC
    let h ← ExceptT.mk [[3 <= n]]
    prove (← ec (HolCore.Bool.mk_imp h (← ec (HolCore.Bool.mk_neg (← mkEq f zero_tm))))) tac
  let nz3 ← dfs.mapM fun f => do HolLight.MP (← prove_nz_3 f) hyp3
  HolLight.DISCH h3n (← prove_rat_eq nz3 (← mkEq bracket_unf zero_tm))
  : ExceptT String IO thm).run
#eval QFLAT_N1_BRACKET

