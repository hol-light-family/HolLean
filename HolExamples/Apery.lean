-- let apery_abstract_identity leaves eq = ...;;
def apery_abstract_identity (leaves0 : List term) (eq : term) : ExceptT String IO thm := do
  let leaves := (HolCore.Lib.setify leaves0).filter (fun t => t != apery_zero && t != apery_one)
  let vars ← ExceptT.lift (leaves.mapM fun t => HolCore.Basics.genvar (type_of t))
  let abstr := List.zip vars leaves
  let concrete := List.zip leaves vars
  let sub ← ExceptT.mk (HolCore.Basics.subst abstr)
  let eq' ← ExceptT.mk (sub eq)
  HolLight.INST concrete (← prove eq' (CONV_TAC REAL_RING))
#eval IO.println "<fun>"

