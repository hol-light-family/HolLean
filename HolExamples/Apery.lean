-- let rec denom_factors t acc = ... and factor_collect d acc = ...;;
mutual
partial def denom_factors (t : term) (acc : List term) : List term :=
  if is_binop_op div_tm t then
    match dest_div t with
    | .ok (a, b) => denom_factors a (factor_collect b (denom_factors b acc))
    | .error _ => acc
  else match t with
    | .Comb f x => denom_factors f (denom_factors x acc)
    | .Abs _ b => denom_factors b acc
    | _ => acc
partial def factor_collect (d : term) (acc : List term) : List term :=
  if is_binop_op mul_tm d then
    match HolCore.Basics.dest_binop mul_tm d with
    | .ok (a, b) => factor_collect a (factor_collect b acc)
    | .error _ => acc
  else if is_binop_op pow_tm d then
    match HolCore.Basics.dest_binop pow_tm d with
    | .ok (a, _) => factor_collect a acc
    | .error _ => acc
  else if acc.contains d then acc else d :: acc
end
#eval do IO.println "<fun>"; IO.println "<fun>"

