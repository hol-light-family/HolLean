/- Instantiate a cleared recurrence at (p+No,p+Ko) and normalize indices. -/

#eval phrase 210
-- let bdry_cl_inst clG no ko = ...;;
def bdry_cl_inst (clG : thm) (no ko : Int) : ExceptT String IO thm := do
  let pl ← ExceptT.mk [[(+):num->num->num]]
  let p ← ExceptT.mk [[p:num]]
  let a ← ec (HolCore.Kernel.mk_comb (← ec (HolCore.Kernel.mk_comb pl p)) (← ec (mk_small_numeral no)))
  let b ← ec (HolCore.Kernel.mk_comb (← ec (HolCore.Kernel.mk_comb pl p)) (← ec (mk_small_numeral ko)))
  let inst ← HolLight.SPECL [a, b] clG
  let pre := (← ec (HolCore.Basics.dest_imp (concl inst))).1
  let preth ← HolLight.MP (← prove (← ec (HolCore.Bool.mk_imp (← ExceptT.mk [[1<=p]]) pre))
      (DISCH_TAC THEN ASM_ARITH_TAC)) hyp1p
  HolLight.REWRITE_RULE (GIDX ++ [(← HolLight.GSYM REAL_OF_NUM_ADD)]) (← HolLight.MP inst preth)
#eval IO.println "<fun>"

