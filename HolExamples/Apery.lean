-- let rec apery_rational_summands tm = ...;;
partial def apery_rational_summands (tm : term) : Except String (List term) := do
  if !(has_div tm) then pure [tm]
  else if is_binop_op add_tm tm then
    let (l, r) ← HolCore.Basics.dest_binop add_tm tm
    pure ((← apery_rational_summands l) ++ (← apery_rational_summands r))
  else if is_binop_op sub_tm tm then
    let (l, r) ← HolCore.Basics.dest_binop sub_tm tm
    pure ((← apery_rational_summands l) ++ (← (← apery_rational_summands r).mapM apery_neg))
  else if (match tm with | .Comb r _ => r == neg_tm | _ => false) then
    (← apery_rational_summands (← HolCore.Kernel.rand tm)).mapM apery_neg
  else if is_binop_op mul_tm tm then
    let (l, r) ← HolCore.Basics.dest_binop mul_tm tm
    let rs ← apery_rational_summands r
    let ls ← apery_rational_summands l
    pure (← ls.mapM fun x => rs.mapM (apery_mul x)).flatten
  else pure [tm]
#eval IO.println "<fun>"

