/-- `val x : term = `...``: OCaml's toplevel printer for a term. -/
private def printTerm (t : term) : IO Unit := do
  HolCore.Printer.print_qterm t; IO.println ""
private def qtermString (t : term) : IO String := do
  pure (HolCore.System.Fmt.runStd (← HolCore.Printer.get_margin) (← HolCore.Printer.pp_print_qterm t))
/-- A `term list` as the toplevel prints it. -/
private def printTerms (l : List term) : IO Unit := do
  IO.println ("[" ++ String.intercalate ";\n " (← l.mapM qtermString) ++ "]")
private def keepIO {α : Type} [Inhabited α] (name : String) (f : Unit → IO (Except String α)) : α :=
  keep name fun _ =>
    match runIO (f ()) with
    | .ok (.ok v) => v
    | .ok (.error e) => panic! s!"keepIO {name}: {e}"
    | .error e => panic! s!"keepIO {name}: {e}"
private def mkEq (l r : term) : ExceptT String IO term := do
  let f ← ExceptT.mk _root_.mk_eq
  ec (f (l, r))
private def mkBin (op a b : term) : Except String term := do
  (← HolCore.Basics.mk_binop op a) b
