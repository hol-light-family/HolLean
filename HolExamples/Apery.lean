  let h1 ← ar (← ExceptT.mk [[(n+1)+2 = n+3]])
  prove ([[!f n. pflat f n = m0c n * lop f n + m1c n * lop f (n+1) + m2c n * lop f (n+2)]])
   (REPEAT GEN_TAC THEN REWRITE_TAC [pflat, lop, m0c, m1c, m2c] THEN
    REWRITE_TAC [h1, h2,
                h3, h4,
                (← HolLight.GSYM REAL_OF_NUM_ADD)] THEN
    CONV_TAC rg)
  : ExceptT String IO thm).run
