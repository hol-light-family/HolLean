  let nz ← (factor_collect tm []).mapM fun f => do HolLight.MP (← prove_factor_nz_imp f) hyp_thm
  PROVE_NZ nz tm
#eval IO.println "<fun>"

#eval phrase 140
-- let rec apery_sum_theorems thms = ...;;
partial def apery_sum_theorems : List thm → ExceptT String IO thm
  | [th] => pure th
  | th :: rest => do
      let r ← apery_sum_theorems rest
      HolLight.MK_COMB ((← HolLight.AP_TERM add_tm th), r)
  | [] => throw "apery_sum_theorems"
#eval IO.println "<fun>"

#eval phrase 141
-- let apery_reduce_fractions raws reduced = ...;;
def apery_reduce_fractions (raws : List (thm × term × term)) (reduced : List (term × term × term × term)) :
    ExceptT String IO (List thm) := do
  if raws.length != reduced.length then throw "map2: length mismatch"
  (List.zip raws reduced).mapM fun ((rawth, raw_num, raw_den), (num, den, _, common)) => do
    let den_th ← apery_prove_poly_eq raw_den (← ec (mkBin mul_tm common den))
    let num_th ← apery_prove_poly_eq raw_num (← ec (mkBin mul_tm common num))
    let fraction_th ← HolLight.MK_COMB ((← HolLight.AP_TERM div_tm num_th), den_th)
    let cancel_th ← HolLight.MATCH_MP (← HolLight.SPECL [common, num, den] APERY_RAT_CANCEL)
      (← apery_prove_nz_product common)
    HolLight.TRANS rawth (← HolLight.TRANS fraction_th cancel_th)
#eval IO.println "<fun>"

#eval phrase 142
def apery_bigd : term := keep "apery_bigd" fun _ => ([[((&k - &n) pow 2 * (&n + &2) pow 3 * (&n + &3) pow 3 * (&k - &n - &4) pow 2 * (&k - &n - &3) pow 2 * (&k - &n - &2) pow 2 * (&k - &n - &1) pow 2 * (&k - &n + &1)):real]])
#eval printTerm apery_bigd

