/- The session's `prove` lifted into `ExceptT String IO`, so tactic scripts
   read as the OCaml does. -/
private def prove (g : term) (tac : HolCore.Tactics.tactic) : ExceptT String IO thm :=
  ExceptT.mk (Session.prove g tac)
private def ar (tm : term) : ExceptT String IO thm := ExceptT.mk (ARITH_RULE tm)
private def ms (ths : List thm) (tm : term) : ExceptT String IO thm :=
  ExceptT.mk (MESON ths tm)
private def nc (tm : term) : ExceptT String IO thm := ExceptT.mk (num_CONV tm)
private def nr (tm : term) : ExceptT String IO thm := ExceptT.mk (NUMBER_RULE tm)
private def rf (tm : term) : ExceptT String IO thm := ExceptT.mk (REAL_FIELD tm)
private def rg (tm : term) : ExceptT String IO thm := ExceptT.mk (REAL_RING tm)
private def rpc (tm : term) : ExceptT String IO thm := ExceptT.mk (REAL_POLY_CONV tm)
private def rr (tm : term) : ExceptT String IO thm := ExceptT.mk (Session.REAL_ARITH3 tm)
private def sr (tm : term) : ExceptT String IO thm := ExceptT.mk (SET_RULE tm)
private def tt (tm : term) : ExceptT String IO thm := ExceptT.mk (TAUT tm)

/- ========================================================================= -/
/- Apery's theorem: the irrationality of zeta(3).                            -/
/-                                                                           -/
/- The proof follows John Harrison's HOL Light development apart from the    -/
/- recurrence for bb. The order-4 recurrence and its telescoping certificate -/
/- originate in Bruno Salvy's Maple/Algolib worksheet. They were later       -/
/- formally checked by Chyzak, Mahboubi, Sibut-Pinote and Tassi. The exact   -/
/- operators and contiguity data used here are translated from the later     -/
/- Coq development by Mahboubi and Sibut-Pinote.                             -/
/-                                                                           -/
/- Thus the recurrence data were generated in Maple by creative telescoping, -/
/- using algorithms derived from Zeilberger's work, not generated by Coq.    -/
/- Both Coq and HOL check the data a posteriori. Here P_flat is factored     -/
/- through the order-2 Apery operator. The interior telescoping              -/
/- identity is checked by triangular rational reduction to three factorized  -/
/- polynomial identities. Only the boundary step retains a large cofactor    -/
/- certificate generated offline for this HOL development.                   -/
/-                                                                           -/
/- References:                                                               -/
/-   C. Schneider, "Apery's Double Sum is Plain Sailing Indeed" (2007):      -/
/-   http://www.risc.jku.at/publications/download/risc_3027/Apery.pdf        -/
/-   B. Salvy, "An Algolib-aided version of Apery's proof of the             -/
/-   irrationality of zeta(3)" (2003):                                       -/
/-   http://algo.inria.fr/libraries/autocomb/Apery2-html/apery.html          -/
/-   F. Chyzak, A. Mahboubi, T. Sibut-Pinote and E. Tassi, "A                -/
/-   Computer-Algebra-Based Formal Proof of the Irrationality of zeta(3)"    -/
/-   (2014), doi:10.1007/978-3-319-08970-6_11.                               -/
/-   A. Mahboubi and T. Sibut-Pinote, "A Formal Proof of the                 -/
/-   Irrationality of zeta(3)" (2021), doi:10.23638/LMCS-17(1:16)2021;       -/
/-   https://github.com/rocq-community/apery                                 -/
/- ========================================================================= -/

#eval phrase 1
-- needs "100/pnt.ml";;
#eval Hol100.Pnt.ensure

/- ------------------------------------------------------------------------- -/
/- LCMs over sets.                                                           -/
/- ------------------------------------------------------------------------- -/

#eval phrase 2
def LCM_DEF : thm := keep "LCM_DEF" fun _ => define
 [[LCM (s:num->bool) = iterate(\m n. lcm(m,n)) s I]]
#eval LCM_DEF

#eval phrase 3
def LCM_CLAUSES : thm := keep "LCM_CLAUSES" fun _ => (do
  prove ([[(LCM {} = 1) /\
   (!x s. FINITE s
          ==> LCM (x INSERT s) = if x IN s then LCM s else lcm(x,LCM s))]])
   (ASM_SIMP_TAC [LCM_DEF, MONOIDAL_LCM, ITERATE_CLAUSES, I_THM, NEUTRAL_LCM])
  : ExceptT String IO thm).run
#eval LCM_CLAUSES

#eval phrase 4
def LCM_CLAUSES_NUMSEG : thm := keep "LCM_CLAUSES_NUMSEG" fun _ => (do
  let h2 ← ms [LCM_CLAUSES] (← ExceptT.mk [[s = {} ==> LCM s = 1]])
  let h1 ← ar (← ExceptT.mk [[~(SUC n <= n)]])
  prove ([[(!m. LCM(m..0) = if m = 0 then 0 else 1) /\
   (!m n. LCM(m..SUC n) =
          if m <= SUC n then lcm(LCM(m..n),SUC n) else 1)]])
   (REWRITE_TAC [NUMSEG_CLAUSES] THEN REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN
    ASM_SIMP_TAC [LCM_CLAUSES, FINITE_NUMSEG, IN_NUMSEG, FINITE_EMPTY] THEN
    REWRITE_TAC [h1, LCM_1, NOT_IN_EMPTY] THEN
    REWRITE_TAC [LCM_SYM] THEN
    MATCH_MP_TAC h2 THEN
    REWRITE_TAC [NUMSEG_EMPTY] THEN ASM_ARITH_TAC)
  : ExceptT String IO thm).run
#eval LCM_CLAUSES_NUMSEG

#eval phrase 5
def LCM_EQ_0 : thm := keep "LCM_EQ_0" fun _ => (do
  prove ([[!s. FINITE s ==> (LCM s = 0 <=> 0 IN s)]])
   (SIMP_TAC [LCM_DEF, ITERATE_LCM_EQ_0, I_THM] THEN SET_TAC [])
  : ExceptT String IO thm).run
#eval LCM_EQ_0

#eval phrase 6
def LCM_NONZERO : thm := keep "LCM_NONZERO" fun _ => (do
  prove ([[!n. ~(LCM(1..n) = 0)]])
   (SIMP_TAC [LCM_EQ_0, FINITE_NUMSEG, IN_NUMSEG, ARITH])
  : ExceptT String IO thm).run
#eval LCM_NONZERO

#eval phrase 7
def DIVIDES_LCM_SET : thm := keep "DIVIDES_LCM_SET" fun _ => (do
  prove ([[!s n. FINITE s /\ n IN s ==> n divides LCM s]])
   (REPEAT STRIP_TAC THEN REWRITE_TAC [LCM_DEF] THEN
    MP_TAC (← HolLight.ISPECL [([[I:num->num]]), ([[s:num->bool]]), ([[n:num]])] DIVIDES_ITERATE_LCM) THEN
    ASM_REWRITE_TAC [I_THM])
  : ExceptT String IO thm).run
#eval DIVIDES_LCM_SET

#eval phrase 8
def DIVIDES_LCM_NUMSEG : thm := keep "DIVIDES_LCM_NUMSEG" fun _ => (do
  prove ([[!m n. 1 <= m /\ m <= n ==> m divides LCM(1..n)]])
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC DIVIDES_LCM_SET THEN
    ASM_SIMP_TAC [IN_NUMSEG, FINITE_NUMSEG, LE_1])
  : ExceptT String IO thm).run
#eval DIVIDES_LCM_NUMSEG

#eval phrase 9
def PRIMEPOW_DIVIDES_SET_LCM : thm := keep "PRIMEPOW_DIVIDES_SET_LCM" fun _ => (do
  prove ([[!s p k. FINITE s /\ prime p
           ==> (p EXP k divides LCM(s) <=>
                s = {} /\ k = 0 \/ ?n. n IN s /\ p EXP k divides n)]])
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [LCM_DEF, PRIMEPOW_DIVIDES_ITERATE_LCM, I_THM] THEN
    ASM_CASES_TAC ([[s:num->bool = {}]]) THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    ASM_MESON_TAC [MEMBER_NOT_EMPTY, EXP, DIVIDES_1])
  : ExceptT String IO thm).run
#eval PRIMEPOW_DIVIDES_SET_LCM

#eval phrase 10
def PRIMEPOW_DIVIDES_NUMSEG_LCM : thm := keep "PRIMEPOW_DIVIDES_NUMSEG_LCM" fun _ => (do
  let h1 ← ar (← ExceptT.mk [[n < 1 <=> n = 0]])
  prove ([[!n p k. prime p
           ==> (p EXP k divides LCM(1..n) <=> n = 0 /\ k = 0 \/
                ?m. 1 <= m /\ m <= n /\ p EXP k divides m)]])
   (SIMP_TAC [PRIMEPOW_DIVIDES_SET_LCM, FINITE_NUMSEG] THEN
    REWRITE_TAC [NUMSEG_EMPTY, h1] THEN
    REWRITE_TAC [IN_NUMSEG, (← HolLight.GSYM CONJ_ASSOC)])
  : ExceptT String IO thm).run
#eval PRIMEPOW_DIVIDES_NUMSEG_LCM

#eval phrase 11
def PRIMEPOW_DIVIDES_NUMSEG_LCM_SIMPLE : thm := keep "PRIMEPOW_DIVIDES_NUMSEG_LCM_SIMPLE" fun _ => (do
  let h1 ← ar (← ExceptT.mk [[1 <= p <=> ~(p = 0)]])
  prove ([[!n p k. prime p
           ==> (p EXP k divides LCM(1..n) <=> n = 0 /\ k = 0 \/ p EXP k <= n)]])
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [PRIMEPOW_DIVIDES_NUMSEG_LCM] THEN
    AP_TERM_TAC THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN ([[m:num]]) STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o HolLight.MATCH_MP DIVIDES_LE) THEN
      ASM_MESON_TAC [LE_TRANS, LE_1],
      DISCH_TAC THEN EXISTS_TAC ([[p EXP k]]) THEN ASM_REWRITE_TAC [DIVIDES_REFL] THEN
      ASM_SIMP_TAC [h1, PRIME_IMP_NZ, EXP_EQ_0]])
  : ExceptT String IO thm).run
#eval PRIMEPOW_DIVIDES_NUMSEG_LCM_SIMPLE

#eval phrase 12
def BINOM_MULTIPLE_DIVIDES_LCM : thm := keep "BINOM_MULTIPLE_DIVIDES_LCM" fun _ => (do
  let h10 ← ar (← ExceptT.mk [[!m:num. m <= n /\ m + (n - m) < x ==> n < x]])
  let h9 ← ar (← ExceptT.mk [[m:num <= n /\ n - m < p ==> n < m + p]])
  let h8 ← ar (← ExceptT.mk [[p * ((d + e) + 1):num = d * p + e * p + p]])
  let h7 ← ar (← ExceptT.mk [[1 + a <= b + c + 1 <=> a <= b + c]])
  let h6 ← sr (← ExceptT.mk [[{x | P x /\ (Q x \/ R x)} =
                           {x | P x /\ Q x} UNION {x | P x /\ R x}]])
  let h5 ← ms [ARITH] (← ExceptT.mk [[((if p then 1 else 0) = 0) <=> ~p]])
  let h4 ← sr (← ExceptT.mk [[{x | P x /\ Q x} = {x | x IN {x | P x} /\ Q x}]])
  let h3 ← ar (← ExceptT.mk [[CARD s = CARD s * 1]])
  let h2 ← ar (← ExceptT.mk [[a:num <= b ==> !k. k <= a ==> k <= b]])
  let h1 ← ar (← ExceptT.mk [[(m * k) * x * b:num = x * k * m * b]])
  prove ([[!m. 1 <= m /\ m <= n ==> (m * binom(n,m)) divides LCM(1..n)]])
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC DIVIDES_CMUL2 THEN
    EXISTS_TAC ([[FACT m * FACT(n - m)]]) THEN
    MP_TAC (← HolLight.SPECL [([[n - m:num]]), ([[m:num]])] BINOM_FACT) THEN
    ASM_SIMP_TAC [MULT_EQ_0, FACT_NZ, SUB_ADD] THEN
    SIMP_TAC [h1] THEN
    DISCH_TAC THEN REWRITE_TAC [(← HolLight.GSYM MULT_ASSOC)] THEN
    ONCE_REWRITE_TAC [PRIMEPOW_DIVISORS_DIVIDES] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    X_GEN_TAC ([[p:num]]) THEN DISCH_TAC THEN
    SUBGOAL_THEN ([[~(p = 0) /\ ~(p = 1) /\ 2 <= p /\ ~(p <= 1)]]) STRIP_ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o HolLight.MATCH_MP PRIME_GE_2) THEN ARITH_TAC, ALL_TAC] THEN
    ASM_SIMP_TAC [PRIMEPOW_DIVIDES_INDEX, MULT_EQ_0, FACT_NZ,
                 INDEX_FACT_UNBOUNDED, LE_1, LCM_NONZERO, INDEX_MUL] THEN
    MATCH_MP_TAC h2 THEN
    ASM_SIMP_TAC [index_def, LE_1, LCM_NONZERO] THEN
    ONCE_REWRITE_TAC [h3] THEN
    ASM_SIMP_TAC [(← HolLight.GSYM NSUM_CONST), FINITE_INDICES, LE_1, LCM_NONZERO] THEN
    ONCE_REWRITE_TAC [h4] THEN
    REWRITE_TAC [NSUM_RESTRICT_SET] THEN
    REPLICATE_TAC 2 (ASM_SIMP_TAC [(← HolLight.CONV_RULE (HolLight.RAND_CONV HolLight.SYM_CONV) (← HolLight.SPEC_ALL NSUM_ADD_GEN)),
                   IN_ELIM_THM, DIV_EQ_0, EXP_EQ_0,
                   NOT_LT, FINITE_EXP_LE, FINITE_INDICES, LCM_NONZERO,
                   h5,
                   ADD_EQ_0, DE_MORGAN_THM, FINITE_UNION, LE_1,
                   h6] THEN
      TRY (MATCH_MP_TAC NSUM_LE_GEN)) THEN
    X_GEN_TAC ([[j:num]]) THEN DISCH_TAC THEN
    ASM_SIMP_TAC [PRIMEPOW_DIVIDES_NUMSEG_LCM_SIMPLE] THEN
    ASM_CASES_TAC ([[p EXP j divides m]]) THEN ASM_REWRITE_TAC [] THENL
     [COND_CASES_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [DIVIDES_LE, LE_TRANS, LE_1]] THEN
      REWRITE_TAC [h7] THEN
      ASM_SIMP_TAC [LE_LDIV_EQ, EXP_EQ_0, PRIME_IMP_NZ] THEN
      RULE_ASSUM_TAC (HolLight.REWRITE_RULE [DIVIDES_DIV_MULT]) THEN
      ASM_SIMP_TAC [h8] THEN
      MATCH_MP_TAC h9 THEN
      ASM_REWRITE_TAC [] THEN MP_TAC (← HolLight.SPECL [([[n - m:num]]), ([[p EXP j]])] DIVISION) THEN
      ASM_SIMP_TAC [EXP_EQ_0, PRIME_IMP_NZ] THEN ASM_ARITH_TAC,
      REWRITE_TAC [ADD_CLAUSES] THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [(← HolLight.GSYM NOT_LE), DIV_LT, LE_0] THEN
      ASM_SIMP_TAC [LE_LDIV_EQ, EXP_EQ_0, PRIME_IMP_NZ] THEN
      MATCH_MP_TAC h10 THEN
      EXISTS_TAC ([[m:num]]) THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← HolLight.SPECL [([[n - m:num]]), ([[p EXP j]])] DIVISION) THEN
      MP_TAC (← HolLight.SPECL [([[m:num]]), ([[p EXP j]])] DIVISION) THEN
      ASM_SIMP_TAC [EXP_EQ_0, PRIME_IMP_NZ] THEN ASM_ARITH_TAC])
  : ExceptT String IO thm).run
#eval BINOM_MULTIPLE_DIVIDES_LCM

/- ------------------------------------------------------------------------- -/
/- The real zeta function.                                                   -/
/- ------------------------------------------------------------------------- -/

#eval phrase 13
def ZETA : thm := keep "ZETA" fun _ => new_definition
 [[ZETA x = Re(zeta(Cx x))]]
#eval ZETA

/- ------------------------------------------------------------------------- -/
/- The key sequences.                                                        -/
/- ------------------------------------------------------------------------- -/

#eval phrase 14
def cc : thm := keep "cc" fun _ => new_definition
 [[cc n k = &(binom(n + k,k)) pow 2 * &(binom(n,k)) pow 2]]
#eval cc

#eval phrase 15
def zz : thm := keep "zz" fun _ => new_definition
 [[zz n = sum(1..n) (\k. &1 / &k pow 3)]]
#eval zz

#eval phrase 16
def aa : thm := keep "aa" fun _ => new_definition
 [[aa n = sum(0..n) (\k. cc n k)]]
#eval aa

#eval phrase 17
def bb : thm := keep "bb" fun _ => new_definition
 [[bb n = aa n * zz n +
         sum (1..n)
             (\k. sum (1..k)
                      (\m. --(&1) pow (m + 1) /
                           (&2 * &m pow 3 * &(binom(n,m)) * &(binom(n+m,m))) *
                           cc n k))]]
#eval bb

/- ------------------------------------------------------------------------- -/
/- Cosmetically different form for b from Schneider's paper.                 -/
/- ------------------------------------------------------------------------- -/

#eval phrase 18
def BB_ALT : thm := keep "BB_ALT" fun _ => (do
  let h1 ← ar (← ExceptT.mk [[1 <= m ==> m + 1 = SUC(SUC(m - 1))]])
  prove ([[!n. bb n =
       sum (0..n)
           (\k. &(binom(n + k,k)) pow 2 * &(binom(n,k)) pow 2 *
                (zz n +
                 sum (1..k)
                     (\m. --(&1) pow (m - 1) /
                           (&2 * &m pow 3 *
                            &(binom(n+m,m)) * &(binom(n,m))))))]])
   (GEN_TAC THEN REWRITE_TAC [REAL_ADD_LDISTRIB, SUM_ADD_NUMSEG] THEN
    REWRITE_TAC [bb, aa, cc, (← HolLight.GSYM SUM_RMUL), REAL_POW_MUL] THEN
    REWRITE_TAC [(← HolLight.GSYM REAL_MUL_ASSOC)] THEN AP_TERM_TAC THEN
    SIMP_TAC [(← HolLight.ISPECL [([[f:num->real]]), ([[0]]), ([[n:num]])] SUM_CLAUSES_LEFT), LE_0] THEN
    REWRITE_TAC [SUM_CLAUSES_NUMSEG, ARITH_EQ, REAL_MUL_RZERO, REAL_ADD_LID] THEN
    REWRITE_TAC [ADD_CLAUSES] THEN MATCH_MP_TAC SUM_EQ_NUMSEG THEN
    X_GEN_TAC ([[k:num]]) THEN STRIP_TAC THEN REWRITE_TAC [(← HolLight.GSYM SUM_LMUL)] THEN
    MATCH_MP_TAC SUM_EQ_NUMSEG THEN X_GEN_TAC ([[m:num]]) THEN STRIP_TAC THEN
    REWRITE_TAC [] THEN
    ASM_SIMP_TAC [h1] THEN
    REWRITE_TAC [real_pow, REAL_MUL_LNEG, REAL_MUL_LID, REAL_MUL_RNEG] THEN
    REWRITE_TAC [REAL_NEG_NEG, REAL_MUL_AC])
  : ExceptT String IO thm).run
#eval BB_ALT

