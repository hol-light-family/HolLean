/- A sequence killed by M and zero at 0 and 1 vanishes, since m2c is never -/
/- zero. -/

#eval phrase 60
def M_KERNEL_TRIVIAL : thm := keep "M_KERNEL_TRIVIAL" fun _ => (do
  prove ([[!g:num->real. (!n. m0c n * g n + m1c n * g(n+1) + m2c n * g(n+2) = &0) /\
       g 0 = &0 /\ g 1 = &0
       ==> !n. g n = &0]])
   (GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC num_WF THEN X_GEN_TAC ([[n:num]]) THEN DISCH_TAC THEN
    ASM_CASES_TAC ([[n = 0]]) THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC ([[n = 1]]) THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN ([[g (n - 2):real = &0 /\ g (n - 1):real = &0]]) STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC, ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => HolLight.tactic_of do
      let isM0 (t : term) : Bool :=
        match HolCore.Kernel.dest_const (HolCore.Basics.strip_comb t).1 with
        | .ok (c, _) => c == "m0c" | .error _ => false
      if (HolCore.Basics.find_term isM0 (concl th)) matches .ok _ then
        pure (MP_TAC (← HolLight.SPEC (← ExceptT.mk [[n - 2]]) th))
      else throw "fail") THEN
    SUBGOAL_THEN ([[n - 2 + 1 = n - 1 /\ n - 2 + 2 = n]]) (fun th => REWRITE_TAC [th]) THENL
     [ASM_ARITH_TAC, ALL_TAC] THEN
    ASM_REWRITE_TAC [REAL_MUL_RZERO, REAL_ADD_LID, REAL_ADD_RID] THEN
    REWRITE_TAC [REAL_ENTIRE, M2C_NONZERO])
  : ExceptT String IO thm).run
