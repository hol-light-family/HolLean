      TRANS_TAC REAL_LE_TRANS ([[sum(n..m) (\k. &6 / (&k + &1) pow 3) / aa(n + 1)]]) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [real_div, (← HolLight.GSYM SUM_RMUL), REAL_INV_MUL] THEN
        MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC ([[k:num]]) THEN STRIP_TAC THEN
        REWRITE_TAC [(← HolLight.GSYM REAL_MUL_ASSOC), h3] THEN
        ASM_SIMP_TAC [REAL_LE_DIV2_EQ, REAL_POW_LT, h4] THEN
        REWRITE_TAC [real_div] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
        SIMP_TAC [REAL_LE_MUL, REAL_LE_INV_EQ, REAL_LT_IMP_LE, AA_POS_LT] THEN
        ASM_SIMP_TAC [(← HolLight.GSYM real_div), REAL_LE_LDIV_EQ, AA_POS_LT] THEN
        ASM_SIMP_TAC [REAL_MUL_LID, AA_MONOTONIC] THEN
        MATCH_MP_TAC REAL_LE_INV2 THEN
        ASM_SIMP_TAC [AA_MONOTONIC, AA_POS_LT, LE_ADD_RCANCEL],
        SIMP_TAC [REAL_LE_DIV2_EQ, AA_POS_LT,
                 h5] THEN
        REWRITE_TAC [real_div, SUM_LMUL] THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_POS] THEN
        REWRITE_TAC [(← HolLight.GSYM (← HolLight.SPEC ([[1]]) SUM_OFFSET)), REAL_OF_NUM_ADD] THEN
        TRANS_TAC REAL_LE_TRANS ([[real_infsum (from 1) (\n. inv(&n pow 3))]]) THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC REAL_PARTIAL_SUMS_LE_INFSUM_GEN THEN
          SIMP_TAC [FINITE_NUMSEG, SUBSET, IN_NUMSEG, IN_FROM] THEN
          SIMP_TAC [REAL_LE_INV_EQ, REAL_POW_LE, REAL_POS] THEN
          CONJ_TAC THENL [ARITH_TAC, MATCH_MP_TAC SessionMultiLib.RealAnalysis.REAL_SUMS_SUMMABLE] THEN
          EXISTS_TAC ([[ZETA(&3)]]),
          MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC REAL_INFSUM_UNIQUE] THEN
        MP_TAC ZZ_LIM THEN
        REWRITE_TAC [SessionMultiLib.RealAnalysis.real_sums, (← HolLight.REWRITE_RULE [(← HolLight.GSYM FUN_EQ_THM), ETA_AX] zz),
                    FROM_INTER_NUMSEG, real_div, REAL_MUL_LID]]])
  : ExceptT String IO thm).run
#eval APPROXIMATION_BOUND

/- ========================================================================= -/
/- *** Part 5: b_n / a_n < zeta(3)                                           -/
/- ========================================================================= -/

#eval phrase 239
def BB_OVER_AA_INCREASES : thm := keep "BB_OVER_AA_INCREASES" fun _ => (do
  let h1 ← rr (← ExceptT.mk [[b / a * c:real = (b * c) / a]])
  prove ([[!n. bb n / aa n < bb (n + 1) / aa (n + 1)]])
   (GEN_TAC THEN SIMP_TAC [REAL_SUB_LT, AA_POS_LT, REAL_LT_RDIV_EQ] THEN
    ONCE_REWRITE_TAC [h1] THEN
    SIMP_TAC [AA_POS_LT, REAL_LT_LDIV_EQ] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ONCE_REWRITE_TAC [(← HolLight.GSYM REAL_SUB_LT)] THEN
    REWRITE_TAC [(← HolLight.GSYM dd), DD_EXPLICIT] THEN
    MATCH_MP_TAC REAL_LT_DIV THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    MATCH_MP_TAC REAL_POW_LT THEN REAL_ARITH_TAC2)
  : ExceptT String IO thm).run
#eval BB_OVER_AA_INCREASES

#eval phrase 240
def BB_OVER_AA_LT_ZETA3 : thm := keep "BB_OVER_AA_LT_ZETA3" fun _ => (do
  let h2 ← ar (← ExceptT.mk [[n + 1 < MAX m (n + 2)]])
  let h1 ← ar (← ExceptT.mk [[m <= MAX m n]])
  prove ([[!n. bb n / aa n < ZETA(&3)]])
   (REWRITE_TAC [(← HolLight.GSYM REAL_NOT_LE)] THEN REPEAT STRIP_TAC THEN
    MP_TAC BB_OVER_AA_LIM THEN REWRITE_TAC [SessionMultiLib.RealAnalysis.REALLIM_SEQUENTIALLY] THEN
    DISCH_THEN (MP_TAC o HolLight.SPEC ([[bb(n + 1) / aa(n + 1) - bb n / aa n]])) THEN
    REWRITE_TAC [REAL_SUB_LT, BB_OVER_AA_INCREASES] THEN
    DISCH_THEN (X_CHOOSE_THEN ([[m:num]]) (MP_TAC o HolLight.SPEC ([[MAX m (n + 2)]]))) THEN
    REWRITE_TAC [h1] THEN SUBGOAL_THEN ([[bb (n + 1) / aa (n + 1) < bb(MAX m (n + 2)) / aa(MAX m (n + 2))]]) MP_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    MP_TAC h2 THEN
    SPEC_TAC (([[MAX m (n + 2)]]), ([[r:num]])) THEN SPEC_TAC (([[n + 1]]), ([[s:num]])) THEN
    MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN REWRITE_TAC [REAL_LT_TRANS] THEN
    REWRITE_TAC [ADD1, BB_OVER_AA_INCREASES])
  : ExceptT String IO thm).run
#eval BB_OVER_AA_LT_ZETA3

/- ------------------------------------------------------------------------- -/
/- Hence put everything together.                                            -/
/- ------------------------------------------------------------------------- -/

#eval phrase 241
def IRRATIONAL_ZETA3 : thm := keep "IRRATIONAL_ZETA3" fun _ => (do
  let h10 ← rr (← ExceptT.mk [[b:real < a ==> ~(a = b)]])
  let h9 ← rf (← ExceptT.mk [[&0 < a ==> (b = z * a <=> z = b / a)]])
  let h8 ← ar (← ExceptT.mk [[MAX M N <= n <=> M <= n /\ N <= n]])
  let h7 ← rr (← ExceptT.mk [[&0 < &31]])
  let h6 ← rr (← ExceptT.mk [[a - b <= e /\ b < a ==> abs(b - a) <= e]])
  let h5 ← rr (← ExceptT.mk [[&27 = &3 pow 3]])
  let h4 ← ar (← ExceptT.mk [[MAX N1 N2 <= n <=> N1 <= n /\ N2 <= n]])
  let h3 ← rr (← ExceptT.mk [[tsn * &6 * z * ia * inv t31 * inv(&31 pow 1) =
         (&6 / &31 * z * ia) * tsn / t31]])
  let h2 ← rr (← ExceptT.mk [[a * b / c:real = b * a / c]])
  let h1 ← rr (← ExceptT.mk [[x pow 3 * y * z:real = (x * x * z) * (x * y)]])
  prove ([[~rational(ZETA(&3))]])
   (STRIP_TAC THEN
    SUBGOAL_THEN ([[?N. !n. N <= n
            ==> integer(&2 * &(LCM(1..n)) pow 3 * (bb n - ZETA(&3) * aa n))]]) STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o HolLight.GEN_REWRITE_RULE HolCore.Lib.I [RATIONAL_ALT]) THEN
      DISCH_THEN (X_CHOOSE_THEN ([[p:num]]) MP_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC ([[q:num]]) THEN STRIP_TAC THEN
      GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [REAL_SUB_LDISTRIB] THEN
      MATCH_MP_TAC INTEGER_SUB THEN REWRITE_TAC [BB_INTEGER] THEN
      MATCH_MP_TAC INTEGER_MUL THEN REWRITE_TAC [INTEGER_CLOSED] THEN
      REWRITE_TAC [h1] THEN
      MATCH_MP_TAC INTEGER_MUL THEN SIMP_TAC [INTEGER_CLOSED, AA_INTEGER] THEN
      ONCE_REWRITE_TAC [(← HolLight.GSYM INTEGER_ABS)] THEN
      ASM_REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_NUM] THEN
      ONCE_REWRITE_TAC [h2] THEN
      MATCH_MP_TAC INTEGER_MUL THEN REWRITE_TAC [INTEGER_CLOSED] THEN
      REWRITE_TAC [INTEGER_DIV] THEN
      DISJ2_TAC THEN MATCH_MP_TAC DIVIDES_LCM_SET THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN ([[((\n. &2 * &(LCM(1..n)) pow 3 * (bb n - ZETA(&3) * aa n)) ---> &0)
    sequentially]]) MP_TAC THENL
     [MATCH_MP_TAC REALLIM_NULL_LMUL THEN MP_TAC AA_LOWERBOUND THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [([[A:real]]), ([[N1:num]])] THEN STRIP_TAC THEN
      X_CHOOSE_TAC ([[N2:num]]) LCM_BOUND_SIMPLE THEN
      MATCH_MP_TAC REALLIM_NULL_COMPARISON THEN
      EXISTS_TAC ([[\n. &27 pow n * &6 * ZETA(&3) / (A * &31 pow (n + 1))]]) THEN
      CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [real_div, REAL_INV_MUL, REAL_POW_ADD, h3] THEN
        MATCH_MP_TAC REALLIM_NULL_LMUL THEN
        REWRITE_TAC [(← HolLight.GSYM REAL_POW_DIV), (← HolLight.GSYM real_div)] THEN
        MATCH_MP_TAC REALLIM_POWN THEN CONV_TAC REAL_RAT_REDUCE_CONV] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC ([[MAX N1 N2]]) THEN
      REWRITE_TAC [h4] THEN
      X_GEN_TAC ([[n:num]]) THEN STRIP_TAC THEN
      REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_POW, REAL_ABS_NUM] THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN
      SIMP_TAC [REAL_POW_LE, REAL_POS, REAL_ABS_POS] THEN CONJ_TAC THENL
       [REWRITE_TAC [h5, REAL_POW_POW] THEN
        ONCE_REWRITE_TAC [MULT_SYM] THEN REWRITE_TAC [(← HolLight.GSYM REAL_POW_POW)] THEN
        MATCH_MP_TAC REAL_POW_LE2 THEN
        ASM_SIMP_TAC [REAL_OF_NUM_POW, REAL_OF_NUM_LE, LE_0, LT_IMP_LE],
        ALL_TAC] THEN
      TRANS_TAC REAL_LE_TRANS ([[&6 * ZETA (&3) / aa (n + 1)]]) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC h6 THEN
        REWRITE_TAC [APPROXIMATION_BOUND] THEN
        ASM_SIMP_TAC [(← HolLight.GSYM REAL_LT_LDIV_EQ), AA_POS_LT, BB_OVER_AA_LT_ZETA3],
        ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_POS, real_div] THEN
      SIMP_TAC [REAL_LE_LMUL_EQ, ZETA3_POS] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      ASM_SIMP_TAC [REAL_LT_MUL, REAL_POW_LT, h7] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [SessionMultiLib.RealAnalysis.REALLIM_SEQUENTIALLY] THEN DISCH_THEN (MP_TAC o HolLight.SPEC ([[&1]])) THEN
    REWRITE_TAC [REAL_LT_01] THEN DISCH_THEN (X_CHOOSE_TAC ([[M:num]])) THEN
    SUBGOAL_THEN ([[!n. MAX M N <= n
        ==> &2 * &(LCM (1..n)) pow 3 * (bb n - ZETA (&3) * aa n) = &0]]) MP_TAC THENL
     [REWRITE_TAC [h8] THEN
      ASM_MESON_TAC [INTEGER_CLOSED, REAL_EQ_INTEGERS_IMP],
      ALL_TAC] THEN
    SIMP_TAC [REAL_ENTIRE, REAL_POW_EQ_0, REAL_OF_NUM_EQ, LCM_NONZERO, ARITH] THEN
    REWRITE_TAC [REAL_SUB_0] THEN
    SIMP_TAC [AA_POS_LT, h9] THEN
    DISCH_THEN (fun th => HolLight.tactic_of do
        pure (MP_TAC (← HolLight.SPEC ([[MAX M N]]) th) THEN MP_TAC (← HolLight.SPEC ([[MAX M N + 1]]) th))) THEN
    REWRITE_TAC [LE_REFL, LE_ADD] THEN DISCH_THEN SUBST1_TAC THEN
    MATCH_MP_TAC h10 THEN
    REWRITE_TAC [BB_OVER_AA_INCREASES])
  : ExceptT String IO thm).run
#eval IRRATIONAL_ZETA3

