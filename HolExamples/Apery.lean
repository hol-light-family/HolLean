/- The harmonic kernel uses order-2 recurrences for vv = cc * ss and the     -/
/- degree-20 certificate Q_flat recorded in include/ann_v.v. Its interior    -/
/- identity is checked below by triangular rational reduction; the boundary  -/
/- is handled separately.                                                    -/

#eval phrase 66
#eval Session.prioritize_real

/- ---- ss order-2 recurrences (D_STEP_K, SS_SK2, SS_SN2) ---- -/

#eval phrase 67
def D_STEP_K : thm := keep "D_STEP_K" fun _ => (do
  let h1 ← rr (← ExceptT.mk [[(&n + &m) + &1 = &n + &m + &1]])
  prove ([[!n m. 1 <= m /\ m + 1 <= n
         ==> d_term n (m+1) =
             --(&m pow 3) / ((&m + &1) * (&n + &m + &1) * (&n - &m)) * d_term n m]])
   (REPEAT STRIP_TAC THEN REWRITE_TAC [d_term] THEN
    SUBGOAL_THEN ([[(m + 1) - 1 = SUC(m - 1)]]) SUBST1_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [real_pow] THEN
    SUBGOAL_THEN ([[n + m + 1 = (n + m) + 1]]) SUBST1_TAC THENL [ARITH_TAC, ALL_TAC] THEN
    MP_TAC (← HolLight.ISPECL [([[n + m:num]]), ([[m:num]])] BINOM_BOTH_STEP_REAL) THEN
    MP_TAC (← HolLight.ISPECL [([[n:num]]), ([[m:num]])] BINOM_BOTTOM_STEP_REAL) THEN
    DISCH_THEN SUBST1_TAC THEN DISCH_THEN SUBST1_TAC THEN
    SUBGOAL_THEN ([[&m < &n /\ &1 <= &m]]) STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [REAL_OF_NUM_LT, REAL_OF_NUM_LE] THEN ASM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)] THEN
    REWRITE_TAC [h1] THEN
    SUBGOAL_THEN ([[~(&(binom(n+m,m)) = &0) /\ ~(&(binom(n,m)) = &0) /\
    ~(&m + &1 = &0) /\ ~(&n - &m = &0) /\ ~(&n + &m + &1 = &0) /\ ~(&m = &0)]]) MP_TAC THENL
     [REPEAT CONJ_TAC THEN
       TRY (REWRITE_TAC [REAL_OF_NUM_EQ, BINOM_EQ_0, NOT_LT] THEN ASM_ARITH_TAC) THEN
       ASM_REAL_ARITH_TAC,
      REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)] THEN CONV_TAC rf])
  : ExceptT String IO thm).run
#eval D_STEP_K

/- The order-2 k-recurrence recorded as Sk2 in annotated_recs_s.v. -/

#eval phrase 68
def SS_SK2 : thm := keep "SS_SK2" fun _ => (do
  let h2 ← ar (← ExceptT.mk [[(k+1)+1 = k+2]])
  let h1 ← ar (← ExceptT.mk [[k + 2 = (k + 1) + 1]])
  prove ([[!n k. k + 1 < n
         ==> ss n (k+2) =
             (--(&1) * (&k + &1) pow 3) /
               ((&k + &2) * (&n + &2 + &k) * (--(&n) + &k + &1)) * ss n k +
             (&2 * &k pow 3 + &8 * &k pow 2 + &11 * &k + &5 - &k * &n - &k * &n pow 2 -
              &2 * &n pow 2 - &2 * &n) /
               ((&k + &2) * (&n + &2 + &k) * (--(&n) + &k + &1)) * ss n (k+1)]])
   (REPEAT STRIP_TAC THEN
    SUBST1_TAC h1 THEN
    REWRITE_TAC [SS_DIFF_K] THEN
    MP_TAC (← HolLight.SPECL [([[n:num]]), ([[k+1]])] D_STEP_K) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [h2] THEN
    SUBGOAL_THEN ([[&(k + 1) = &k + &1]]) SUBST1_TAC THENL
     [REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)], ALL_TAC] THEN
    DISCH_THEN SUBST1_TAC THEN
    SUBGOAL_THEN ([[~(&k + &2 = &0) /\ ~(&n + &2 + &k = &0) /\ ~(--(&n) + &k + &1 = &0) /\
    ~((&k + &1) + &1 = &0)]]) MP_TAC THENL
     [REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)] THEN
      SUBGOAL_THEN ([[&k + &1 < &n]]) MP_TAC THENL
       [REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LT] THEN ASM_ARITH_TAC,
        REAL_ARITH_TAC2],
      REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)] THEN CONV_TAC rf])
  : ExceptT String IO thm).run
#eval SS_SK2

/- ------------------------------------------------------------------------- -/
/- SS_SN2 (order 2 in n) replaces the full d-tower of the Coq proof with a   -/
/- direct m-telescoping certificate. For R from D_STEP_K, solve              -/
/- rho(m) = sigma(m + 1) R(m) - sigma(m). The lower boundary sigma(n,1)      -/
/- vanishes and sigma(n,k + 1) = c01(n,k), so summing gives SS_SN2. Its      -/
/- c00, c10 and c01 coefficients are those of s_Sn2 in annotated_recs_s.v.   -/
/- ------------------------------------------------------------------------- -/
/- The k-independent m-telescoping certificate for SS_SN2. -/

#eval phrase 69
def SIGMA_DEF : thm := keep "SIGMA_DEF" fun _ => new_definition
 [[sigma_s n m = ((&4 * &n + &6) / (&n + &2) pow 3 * &m pow 3 - (&4 * &n + &6) / (&n + &2) pow 2 * &m pow 2 + (&4 * &n pow 2 + &10 * &n + &6) / (&n + &2) pow 3 * &m) / (&n + &m + &1)]]
#eval SIGMA_DEF

/- Reduce d(n+1,m), d(n+2,m) and d(n,m+1) to d_term n m using D_STEP_N and   -/
/- D_STEP_K. REAL_FIELD then treats d_term n m as an atom.                   -/

#eval phrase 70
def SSN2_SUMMAND : thm := keep "SSN2_SUMMAND" fun _ => (do
  let h1 ← ar (← ExceptT.mk [[n + 2 = (n + 1) + 1]])
  prove ([[!n k m. 1 <= m /\ m <= k /\ k < n ==> ((((--(&2) - &9 * &n pow 2 + &3 * &k * &n - &6 * &k pow 2 - &n pow 4 - &5 * &n pow 3 - &6 * &k pow 3 - &k * &n pow 3 + &k * &n pow 2 + &4 * &k pow 2 * &n pow 2 + &2 * &k pow 2 * &n - &4 * &k pow 3 * &n - &k - &7 * &n) / ((&n + &2) pow 3 * (&n + &2 + &k))) + (&2 * &k * (&2 * &n + &3) * (&k + &1) * (--(&n) + &k) / ((&n + &2) pow 3 * (&n + &2 + &k)))) * d_term n m + ((&2 * &n + &3) * (&n pow 2 + &3 * &n + &3) / (&n + &2) pow 3) * d_term (n+1) m - d_term (n+2) m = sigma_s n m * d_term n m - sigma_s n (m+1) * d_term n (m+1))]])
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SIGMA_DEF] THEN
    SUBGOAL_THEN ([[d_term (n+1) m = (&n + &1 - &m) / (&n + &1 + &m) * d_term n m]]) SUBST1_TAC THENL [MATCH_MP_TAC D_STEP_N THEN ASM_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN ([[d_term (n+2) m = (&n + &2 - &m) / (&n + &2 + &m) * ((&n + &1 - &m) / (&n + &1 + &m) * d_term n m)]]) SUBST1_TAC THENL
     [SUBST1_TAC h1 THEN
      MP_TAC (← HolLight.SPECL [([[n+1]]), ([[m:num]])] D_STEP_N) THEN ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN
      MP_TAC (← HolLight.SPECL [([[n:num]]), ([[m:num]])] D_STEP_N) THEN ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)] THEN REAL_ARITH_TAC2,
      ALL_TAC] THEN
    SUBGOAL_THEN ([[d_term n (m+1) = --(&m pow 3) / ((&m + &1) * (&n + &m + &1) * (&n - &m)) * d_term n m]]) SUBST1_TAC THENL [MATCH_MP_TAC D_STEP_K THEN ASM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)] THEN
    SUBGOAL_THEN ([[~(&n + &2 = &0) /\ ~(&n + &2 + &k = &0) /\ ~(&n + &1 + &m = &0) /\ ~(&n + &2 + &m = &0) /\ ~(&m + &1 = &0) /\ ~(&n + &m + &1 = &0) /\ ~(&n - &m = &0) /\ ~(&n + (&m + &1) + &1 = &0)]]) MP_TAC THENL
     [SUBGOAL_THEN ([[&m < &n]]) ASSUME_TAC THENL
       [REWRITE_TAC [REAL_OF_NUM_LT] THEN ASM_ARITH_TAC, ALL_TAC] THEN
      REPEAT CONJ_TAC THEN ASM_REAL_ARITH_TAC,
      CONV_TAC rf])
  : ExceptT String IO thm).run
#eval SSN2_SUMMAND

#eval phrase 71
def SIGMA_1 : thm := keep "SIGMA_1" fun _ => (do
  prove ([[!n. sigma_s n 1 = &0]])
   (GEN_TAC THEN REWRITE_TAC [SIGMA_DEF] THEN
    SUBGOAL_THEN ([[~(&n + &2 = &0) /\ ~(&n + &1 + &1 = &0)]]) MP_TAC THENL
