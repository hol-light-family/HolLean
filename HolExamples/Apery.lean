-- let prove_factor_nz_imp f = ...;;
def prove_factor_nz_imp (f : term) : ExceptT String IO thm := do
  let tac := REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD), (← HolLight.GSYM REAL_OF_NUM_LT),
                          (← HolLight.GSYM REAL_OF_NUM_LE)] THEN
    STRIP_TAC THEN REWRITE_TAC [(← HolLight.GSYM REAL_OF_NUM_ADD)] THEN ASM_REAL_ARITH_TAC
  let hyp ← ExceptT.mk [[1 <= k /\ k + 1 < n]]
  prove (← ec (HolCore.Bool.mk_imp hyp (← ec (HolCore.Bool.mk_neg (← mkEq f zero_tm))))) tac
#eval IO.println "<fun>"

