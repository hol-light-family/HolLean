-- let apery_bigd_poly = REAL_POLY_CONV apery_bigd and apery_bigd_nz = ...;;
def apery_bigd_poly : thm := keep "apery_bigd_poly" fun _ => (do
  ExceptT.mk (REAL_POLY_CONV apery_bigd)
  : ExceptT String IO thm).run
def apery_bigd_nz : thm := keep "apery_bigd_nz" fun _ => (do
  apery_prove_nz_product apery_bigd
  : ExceptT String IO thm).run
#eval (do replay apery_bigd_nz; IO.println (repr apery_bigd_poly); IO.println (repr apery_bigd_nz) : IO Unit)

#eval phrase 144
-- let apery_scale_fractions reduced = ...;;
def apery_scale_fractions (reduced : List (term × term × term × term)) : ExceptT String IO (List thm) :=
  reduced.mapM fun (num, den, cofactor, _) => do
    let decomp ← HolLight.TRANS apery_bigd_poly
      (← HolLight.SYM (← ExceptT.mk (REAL_POLY_CONV (← ec (mkBin mul_tm cofactor den)))))
    HolLight.MATCH_MP (← HolLight.SPECL [den, apery_bigd, cofactor, num] APERY_RAT_SCALE)
      (← HolLight.CONJ (← apery_prove_nz_product den) decomp)
#eval IO.println "<fun>"

#eval phrase 145
-- let rec apery_scale_sum fractions scale_thms = ...;;
partial def apery_scale_sum : List term → List thm → ExceptT String IO thm
  | [_], [scale_th] => pure scale_th
  | fraction :: rest, scale_th :: scale_rest => do
      let distribute ← HolLight.SPECL [apery_bigd, fraction, (← ec (apery_sum rest))] REAL_ADD_LDISTRIB
      let r ← apery_scale_sum rest scale_rest
      HolLight.TRANS distribute (← HolLight.MK_COMB ((← HolLight.AP_TERM add_tm scale_th), r))
  | _, _ => throw "apery_scale_sum"
#eval IO.println "<fun>"

#eval phrase 146
-- let apery_prove_coefficient coeff reduced = ...;;
def apery_prove_coefficient (coeff : term) (reduced : List (term × term × term × term)) :
    ExceptT String IO thm := do
  let summands ← ec (apery_rational_summands coeff)
  let collected ← apery_abstract_identity (← ec (apery_rational_leaves coeff))
    (← mkEq coeff (← ec (apery_sum summands)))
  let reductions ← apery_reduce_fractions (← apery_make_raw summands) reduced
  let reduced_th ← HolLight.TRANS collected (← apery_sum_theorems reductions)
  let scaled ← apery_scale_sum (← ec (reduced.mapM fun (num, den, _, _) => mkBin div_tm num den))
    (← apery_scale_fractions reduced)
  let scaled_zero ← HolLight.TRANS scaled
    (← ExceptT.mk (REAL_POLY_CONV (← ec (HolCore.Equal.rhs (concl scaled)))))
  let coeff_scaled ← HolLight.AP_TERM (← ec (HolCore.Kernel.mk_comb mul_tm apery_bigd)) reduced_th
  let cancel_eq ← HolLight.TRANS (← HolLight.TRANS coeff_scaled scaled_zero)
    (← HolLight.SYM (← HolLight.SPEC apery_bigd REAL_MUL_RZERO))
  HolLight.MATCH_MP (← HolLight.SPECL [apery_bigd, coeff, apery_zero] CANCEL_LEM)
    (← HolLight.CONJ apery_bigd_nz cancel_eq)
#eval IO.println "<fun>"

