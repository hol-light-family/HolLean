      ==> &0 < &12 * x pow 4 + &96 * x pow 3 + &283 * x pow 2 + &364 * x + &173]])
  let h1 ← rr (← ExceptT.mk [[&0 < x ==> ~(x = &0)]])
  prove ([[!n. ~(m2c n = &0)]])
