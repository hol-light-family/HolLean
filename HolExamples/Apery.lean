#eval phrase 72
def SIGMA_KP1 : thm := keep "SIGMA_KP1" fun _ => (do
  prove ([[!n k. sigma_s n (k+1) = &2 * &k * (&2 * &n + &3) * (&k + &1) * (--(&n) + &k) / ((&n + &2) pow 3 * (&n + &2 + &k))]])
   (REPEAT GEN_TAC THEN REWRITE_TAC [SIGMA_DEF] THEN
