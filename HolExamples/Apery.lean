-- let apery_add x y = ... and apery_sub ... and apery_neg ... and apery_mul ...;;
def apery_add (x y : term) : Except String term :=
  if x == apery_zero then pure y
  else if y == apery_zero then pure x
  else mkBin add_tm x y
def apery_sub (x y : term) : Except String term :=
  if y == apery_zero then pure x
  else if x == apery_zero then HolCore.Kernel.mk_comb neg_tm y
  else mkBin sub_tm x y
def apery_neg (x : term) : Except String term :=
  if x == apery_zero then pure apery_zero else HolCore.Kernel.mk_comb neg_tm x
def apery_mul (x y : term) : Except String term :=
  if x == apery_zero || y == apery_zero then pure apery_zero
  else if x == apery_one then pure y
  else if y == apery_one then pure x
  else mkBin mul_tm x y
#eval do IO.println "<fun>"; IO.println "<fun>"; IO.println "<fun>"; IO.println "<fun>"

