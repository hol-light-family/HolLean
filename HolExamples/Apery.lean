/- P_flat = M o L : a pure polynomial operator identity. -/

#eval phrase 58
def MOL_FACTOR : thm := keep "MOL_FACTOR" fun _ => (do
  let h4 ← ar (← ExceptT.mk [[(n+2)+1 = n+3]])
  let h3 ← ar (← ExceptT.mk [[(n+2)+2 = n+4]])
