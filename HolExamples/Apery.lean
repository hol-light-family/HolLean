#eval phrase 105
-- let rec PROVE_NZ nz_thms d = ...;;
partial def PROVE_NZ (nz_thms : List thm) (d : term) : ExceptT String IO thm := do
  if is_binop_op mul_tm d then
    let (a, b) ← ec (HolCore.Basics.dest_binop mul_tm d)
    let thb ← PROVE_NZ nz_thms b
    let tha ← PROVE_NZ nz_thms a
    HolLight.MATCH_MP REAL_MUL_NZ (← HolLight.CONJ tha thb)
  else if is_binop_op pow_tm d then
    let (a, n) ← ec (HolCore.Basics.dest_binop pow_tm d)
    let tha ← PROVE_NZ nz_thms a
    HolLight.MATCH_MP (← HolLight.SPECL [a, n] REAL_POW_NZ) tha
  else
    let goal ← ec (HolCore.Bool.mk_neg (← mkEq d zero_tm))
    match nz_thms.find? (fun th => concl th == goal) with
    | some th => pure th
    | none =>
      HolLight.tryWith (do HolLight.EQT_ELIM (← ExceptT.mk (REAL_RAT_REDUCE_CONV goal)))
        (do throw ("PROVE_NZ: " ++ (← ExceptT.lift (HolCore.Printer.string_of_term d))))
#eval IO.println "<fun>"

#eval phrase 106
-- let rec RATIONALIZE_CONV nz t = ...;;
partial def RATIONALIZE_CONV (nz : List thm) (t : term) : ExceptT String IO thm := do
  let parts (th : thm) : ExceptT String IO (term × term) := do
    ec (dest_div (← ec (HolCore.Equal.rhs (concl th))))
  let binop (op : term) (lemma : thm) (isdiv : Bool) : ExceptT String IO thm := do
    let (a, b) ← ec (HolCore.Basics.dest_binop op t)
    let tha ← RATIONALIZE_CONV nz a
    let thb ← RATIONALIZE_CONV nz b
    let (na, da) ← parts tha
    let (nb, db) ← parts thb
    let side ← if isdiv then do
        let n3 ← PROVE_NZ nz db
        let n2 ← PROVE_NZ nz nb
        let n1 ← PROVE_NZ nz da
        HolLight.CONJ n1 (← HolLight.CONJ n2 n3)
      else do
        let n2 ← PROVE_NZ nz db
        let n1 ← PROVE_NZ nz da
        HolLight.CONJ n1 n2
    HolLight.TRANS (← HolLight.MK_COMB ((← HolLight.AP_TERM op tha), thb))
      (← HolLight.MP (← HolLight.SPECL [na, da, nb, db] lemma) side)
  if !(has_div t) then HolLight.SPEC t DIV1
  else if is_binop_op add_tm t then binop add_tm RAT_ADD false
  else if is_binop_op sub_tm t then binop sub_tm RAT_SUB false
  else if is_binop_op mul_tm t then binop mul_tm RAT_MUL false
  else if is_binop_op div_tm t then binop div_tm RAT_DIV true
  else if is_binop_op pow_tm t then do
    let (a, nn) ← ec (HolCore.Basics.dest_binop pow_tm t)
    let tha ← RATIONALIZE_CONV nz a
    let (na, da) ← parts tha
    HolLight.TRANS (← HolLight.AP_THM (← HolLight.AP_TERM pow_tm tha) nn)
      (← HolLight.SPECL [na, da, nn] REAL_POW_DIV)
  else match t with
    | .Comb r a =>
      if r == inv_tm then do
        let tha ← RATIONALIZE_CONV nz a
        let (na, da) ← parts tha
        let n2 ← PROVE_NZ nz da
        let n1 ← PROVE_NZ nz na
        HolLight.TRANS (← HolLight.AP_TERM inv_tm tha)
          (← HolLight.MP (← HolLight.SPECL [na, da] RAT_INV) (← HolLight.CONJ n1 n2))
      else if r == neg_tm then do
        let tha ← RATIONALIZE_CONV nz a
        let (na, da) ← parts tha
        HolLight.TRANS (← HolLight.AP_TERM neg_tm tha) (← HolLight.SPECL [na, da] RAT_NEG)
      else HolLight.SPEC t DIV1
    | _ => HolLight.SPEC t DIV1
#eval IO.println "<fun>"

#eval phrase 107
-- let prove_rat_eq nz tm = ...;;
def prove_rat_eq (nz : List thm) (tm : term) : ExceptT String IO thm := do
  let (l, r) ← ec (HolCore.Kernel.dest_eq tm)
  let thl ← RATIONALIZE_CONV nz l
  let thr ← RATIONALIZE_CONV nz r
  let (nl, dl) ← ec (dest_div (← ec (HolCore.Equal.rhs (concl thl))))
  let (nr, dr) ← ec (dest_div (← ec (HolCore.Equal.rhs (concl thr))))
  let n2 ← PROVE_NZ nz dr
  let n1 ← PROVE_NZ nz dl
  let cross ← HolLight.MP (← HolLight.SPECL [nl, dl, nr, dr] RAT_EQ_CROSS) (← HolLight.CONJ n1 n2)
  let polygoal ← ec (HolCore.Equal.rhs (concl cross))
  let (pl, pr) ← ec (HolCore.Kernel.dest_eq polygoal)
  let thpr ← ExceptT.mk (REAL_POLY_CONV pr)
  let thpl ← ExceptT.mk (REAL_POLY_CONV pl)
  let polyth ← HolLight.TRANS thpl (← HolLight.SYM thpr)
  let step1 ← HolLight.MK_COMB ((← HolLight.AP_TERM eqr_tm thl), thr)
  HolLight.EQ_MP (← HolLight.SYM (← HolLight.TRANS step1 cross)) polyth
#eval IO.println "<fun>"

