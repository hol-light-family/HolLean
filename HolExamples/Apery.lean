-- let rec apery_scalar_leaves tm = ...;;
partial def apery_scalar_leaves (tm : term) : Except String (List term) := do
  if apery_atoms.contains tm then pure []
  else if !(apery_has_atom tm) then pure [tm]
  else if is_binop_op add_tm tm || is_binop_op sub_tm tm then
    let op := if is_binop_op add_tm tm then add_tm else sub_tm
    let (l, r) ← HolCore.Basics.dest_binop op tm
    pure ((← apery_scalar_leaves l) ++ (← apery_scalar_leaves r))
  else if (match tm with | .Comb r _ => r == neg_tm | _ => false) then
    apery_scalar_leaves (← HolCore.Kernel.rand tm)
  else if is_binop_op mul_tm tm then
    let (l, r) ← HolCore.Basics.dest_binop mul_tm tm
    if !(apery_has_atom l) then pure (l :: (← apery_scalar_leaves r))
    else if !(apery_has_atom r) then pure (r :: (← apery_scalar_leaves l))
    else throw "apery_scalar_leaves: nonlinear product"
  else throw "apery_scalar_leaves: unsupported term"
#eval IO.println "<fun>"

