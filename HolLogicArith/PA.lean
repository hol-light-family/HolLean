/- File: HolLogicArith/PA.lean
Translation of HOL Light's Arithmetic/pa.ml, phrase by phrase.
Part of the Lean4 translation of HOL Light by Chris Walton 2026.
-/
import HolLogicArith.SigmaComplete
open HolCore.Kernel HolCore.Lib HolCore.Basics Session HolLight.Syntax HolLogicArith
open scoped HolLight
-- Names from Arithmetic/fol.ml that pa.ml reuses.
open HolLogicArith.ArithFol (arithtrue holds termval valmod VALMOD VALMOD_VALMOD_BASIC
  HOLDS_VALMOD_OTHER HOLDS_VALUATION FV THEOREMS_TRUE)

namespace HolLogicArith.PA
-- Replay Arithmetic/sigmacomplete.ml (the one module pa.ml is run after).
#eval HolLogicArith.SigmaComplete.ensure

/- The session's `prove` lifted into `ExceptT String IO`, so tactic scripts
   read as the OCaml does. -/
private unsafe def prove (g : term) (tac : HolCore.Tactics.tactic) : ExceptT String IO thm :=
  ExceptT.mk (Session.prove g tac)

/- `new_inductive_definition` run eagerly, panicking with HOL Light's message
   on failure (as the toplevel throws); returns the (rules, induct, cases)
   triple directly, as the OCaml `let a,b,c = new_inductive_definition ...`. -/
private unsafe def defInductive (tm : term) : thm × thm × thm :=
  match unsafeIO (Session.new_inductive_definition tm) with
  | .ok (.ok trip) => trip
  | .ok (.error e) => panic! s!"new_inductive_definition: {e}"
  | .error e => panic! s!"new_inductive_definition IO: {e}"

#eval phrase 1
-- let PA_RULES,PA_INDUCT,PA_CASES = new_inductive_definition ...
unsafe def PA_triple : thm × thm × thm := keep "PA_triple" fun _ =>
  defInductive
    [[PA(!!1 (Not (Z === Suc(V 1)))) /\
      PA(!!0 (!!1 (Suc(V 0) === Suc(V 1) --> V 0 === V 1))) /\
      PA(!!1 (V 1 ++ Z === V 1)) /\
      PA(!!0 (!!1 (V 0 ++ Suc(V 1) === Suc(V 0 ++ V 1)))) /\
      PA(!!1 (V 1 ** Z === Z)) /\
      PA(!!0 (!!1 (V 0 ** Suc(V 1) === V 0 ** V 1 ++ V 0))) /\
      PA(!!0 (!!1 (V 0 <<= V 1 <-> ??2 (V 0 ++ V 2 === V 1)))) /\
      PA(!!0 (!!1 (V 0 << V 1 <-> Suc(V 0) <<= V 1))) /\
      (!i j p. ~(j IN FV(p))
               ==> PA
                    ((??i (V i === Z && p)) &&
                     (!!j (??i (V i === V j && p)
                               --> ??i (V i === Suc(V j) && p)))
                     --> !!i p))]]
unsafe def PA_RULES : thm := PA_triple.1
unsafe def PA_INDUCT : thm := PA_triple.2.1
unsafe def PA_CASES : thm := PA_triple.2.2
#eval do IO.println PA_RULES; IO.println PA_INDUCT; IO.println PA_CASES

#eval phrase 2
unsafe def PA_SOUND : thm := keep "PA_SOUND" fun _ => (do
  prove ([[!A p. (!a. a IN A ==> arithtrue a) /\ (PA UNION A) |-- p ==> arithtrue p]])
   (HolLight.tactic_of do
     let taut1 ← ExceptT.mk (TAUT [[(a \/ b ==> c) <=> (a ==> c) /\ (b ==> c)]])
     let meson1 ← ExceptT.mk (MESON [LE_EXISTS] [[(?d. m + d = n) <=> m <= n]])
     let sgtm ← HolCore.Parser.parse_term
       "!a b v. holds ((i |-> a) ((j |-> b) v)) q <=> holds ((i |-> a) v) q"
     pure
      (REPEAT STRIP_TAC THEN MATCH_MP_TAC THEOREMS_TRUE THEN
       EXISTS_TAC [[PA UNION A]] THEN
       ASM_SIMP_TAC [IN_UNION, taut1] THEN
       REWRITE_TAC [IN] THEN MATCH_MP_TAC PA_INDUCT THEN
       REWRITE_TAC [arithtrue, holds, termval] THEN
       REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
        [SIMP_TAC [ADD_CLAUSES, MULT_CLAUSES, EXP, SUC_INJ, NOT_SUC, valmod,
                  ARITH_EQ, meson1] THEN
         ARITH_TAC,
         ALL_TAC] THEN
       MAP_EVERY X_GEN_TAC [ [[i:num]], [[j:num]], [[q:form]] ] THEN
       ASM_CASES_TAC [[j:num = i]] THEN
       ASM_REWRITE_TAC [VALMOD, VALMOD_VALMOD_BASIC] THEN
       SIMP_TAC [HOLDS_VALMOD_OTHER] THENL [MESON_TAC [], ALL_TAC] THEN
       REWRITE_TAC [UNWIND_THM2] THEN DISCH_TAC THEN
       (SUBGOAL_THEN sgtm (fun th => REWRITE_TAC [th]))
       THENL
        [REPEAT STRIP_TAC THEN MATCH_MP_TAC HOLDS_VALUATION THEN
         ASM_REWRITE_TAC [valmod] THEN ASM_MESON_TAC [],
         GEN_TAC THEN STRIP_TAC THEN INDUCT_TAC THEN ASM_SIMP_TAC []]))
  : ExceptT String IO thm).run
#eval PA_SOUND

-- @@ENSURE BEGIN
/-- Replays this file, once per process (see Common.lean); generated by
    tools/tutorialdiff/ensuregen.py from the `#eval`s above. -/
unsafe def ensure : IO Unit := once "HolLogicArith.PA" do
  replay (
          HolLogicArith.SigmaComplete.ensure)
  replay (
          do IO.println PA_RULES; IO.println PA_INDUCT; IO.println PA_CASES)
  replay (
          PA_SOUND)
-- @@ENSURE END

end HolLogicArith.PA
