   (MESON_TAC [TRIVIAL_RING_POWSER_0, RING_POLYNOMIAL_IMP_POWERSERIES])

  let RING_CARRIER_POWSER_RING ← prove
   r"!(r:A ring) (s:V->bool).
        ring_carrier(powser_ring r s) =
        {p | (!m. p m IN ring_carrier r) /\
