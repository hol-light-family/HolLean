     REWRITE_TAC [ring_epimorphism] THEN ASM_REWRITE_TAC [] THEN
     REWRITE_TAC [ring_image, EXTENSION, IN_IMAGE] THEN
     X_GEN_TAC (← q "y:B") THEN EQ_TAC THENL
     [STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "y:B")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "a:A") (X_CHOOSE_THEN (← q "b:A") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q "ring_localequiv r s (a:A,b)") THEN
      SUBGOAL_THEN
       (← q "ring_localequiv r s (a:A,b) IN ring_carrier (ring_localization r s)")
      ASSUME_TAC THENL
       [MATCH_MP_TAC RING_LOCALEQUIV_IN_CARRIER THEN ASM_SIMP_TAC [],
        ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"ring_mul (r':B ring) y (alpha b) =
                  ring_mul r' (g (ring_localequiv r s (a:A,b))) (alpha b)")
      ASSUME_TAC THENL
       [USE_THEN "germ" (MP_TAC o SPECL [← q "a:A", ← q "b:A"]) THEN
        ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
        DISCH_THEN SUBST1_TAC THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q "ring_unit (r':B ring) (alpha (b:A))") MP_TAC THENL
       [ASM_SIMP_TAC [], ALL_TAC] THEN
      REWRITE_TAC [ring_unit] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q "g (ring_localequiv r s (a:A,b)) IN ring_carrier (r':B ring)")
      ASSUME_TAC THENL
       [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
      TRANS_TAC EQ_TRANS
        (← q "ring_mul (r':B ring) y (ring_mul r' (alpha (b:A)) (x:B))") THEN
      CONJ_TAC THENL [ASM_MESON_TAC [RING_MUL_RID], ALL_TAC] THEN
      TRANS_TAC EQ_TRANS
       (← q r"ring_mul (r':B ring) (g (ring_localequiv r s (a:A,b)))
