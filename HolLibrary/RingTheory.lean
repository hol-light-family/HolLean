        ==> ring_monomorphism(A,B) f"
   (REWRITE_TAC [ring_monomorphism, o_THM] THEN MESON_TAC [])

  let RING_EPIMORPHISM_COMPOSE ← prove
   r"!r1 r2 r3 (f:A->B) (g:B->C).
        ring_epimorphism(r1,r2) f /\ ring_epimorphism(r2,r3) g
