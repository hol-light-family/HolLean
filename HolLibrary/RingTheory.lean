   (REWRITE_TAC [ring_monomorphism, RING_HOMOMORPHISM_INTO_SUBRING_EQ_GEN] THEN
    MESON_TAC [])

  let RING_SUM_SUBRING_GENERATED_GEN ← prove
   r"!r s k (f:K->A).
