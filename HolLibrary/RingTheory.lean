/- ------------------------------------------------------------------------- -/
/- Gauss's lemma, continued: irreducibility over the fraction field.         -/
/- (ringtheory.ml 27986-28584)                                               -/
/- ------------------------------------------------------------------------- -/

structure GaussD where
  -- @@FIELDS
  IRREDUCIBLE_PRIMITIVE_POLY_FRACTION_RING : thm
  deriving Inhabited

@[nospecialize]
def setupGaussD [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDivides : Divides) (BDomains : Domains) (BHoms : Homs) (BKernels : Kernels) (BRingRule : RingRule) (BPrimes : Primes) (BLocalization : Localization) (BUFDs : UFDs) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BRenaming : Renaming) (BDegree : Degree) (BComposing : Composing) (BZerodivisors : Zerodivisors) (BGaussB : GaussB) (BGaussC : GaussC) :
    ExceptT String IO GaussD := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, MESON_TAC, .. } := D
  let { EQ_TRANS, .. } := D.core2
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IN_ELIM_THM, IN_IMAGE, .. } := D.core5
  let { SUBSET, SUBSET_UNIV, .. } := D.core7
  let { RING_MUL, RING_MUL_ASSOC, RING_MUL_LZERO, RING_MUL_RZERO, RING_MUL_SYM, .. } := BBasics
  let { RING_DIVIDES_LMUL, RING_DIVIDES_REFL, RING_DIVIDES_TRANS, RING_DIVIDES_UNIT,
        ring_divides, .. } := BDivides
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_UNIT, INTEGRAL_DOMAIN_MUL_LCANCEL, .. } := BDomains
  let { RING_HOMOMORPHISM_MUL, RING_MONOMORPHISM_EQ_0,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MONOMORPHISM_INJECTIVE_EQ,
        ring_homomorphism, ring_monomorphism, .. } := BHoms
  let { RING_UNIT_HOMOMORPHIC_IMAGE, .. } := BKernels
  let { RING_RULE, .. } := BRingRule
  let { RING_PRIME_DIVIDES_MUL, ring_irreducible, ring_prime, .. } := BPrimes
  let { FRACTION_FIELD, RING_MONOMORPHISM_FRACTIONATE, .. } := BLocalization
  let { UFD_IMP_INTEGRAL_DOMAIN, UFD_IRREDUCIBLE_EQ_PRIME, UFD_PRIME_FACTOR_EXISTS, .. } := BUFDs
  let { POLY_CONST_0, .. } := BPowerSeries
  let { IN_POLY_RING_CARRIER, POLY_CLAUSES, POLY_CONST, POLY_RING,
        RING_HOMOMORPHISM_POLY_CONST, .. } := BPolyRings
  let { POLY_CONST_DIVIDES_COEFFS, POLY_CONST_DIVIDES_COEFFS_EQ, .. } := BRenaming
  let { INTEGRAL_DOMAIN_POLY_RING, POLY_DEG_CONST, POLY_DEG_EQ_0, POLY_DEG_MUL, .. } := BDegree
  let { POLY_COMPOSE_HOMOMORPHISM_CONST, POLY_DEG_MONOMORPHIC_IMAGE,
        RING_MONOMORPHISM_POLY_RINGS, .. } := BComposing
  let { RING_UNIT_POLY_CONST, RING_UNIT_POLY_DOMAIN, .. } := BZerodivisors
  let { UFD_POLY_RING, .. } := BGaussB
  let { POLY_CLEAR_DENOMINATORS, .. } := BGaussC
  -- @@SCOPE END

  let IRREDUCIBLE_PRIMITIVE_POLY_FRACTION_RING ← prove
   r"!(r:A ring) f.
     UFD r /\
     f IN ring_carrier(poly_ring r (:1)) /\
     1 <= poly_deg r f /\
     (!p. ring_prime r p
          ==> ~ring_divides (poly_ring r (:1))
                (poly_const r p) f)
     ==> (ring_irreducible (poly_ring r (:1)) f <=>
          ring_irreducible
            (poly_ring (fraction_ring r) (:1))
            (ring_fractionate r
              {a | ring_regular r a} o f))"
   (← do
    let rr ← RING_RULE
        (← q r"!r a b c d:A.
            a IN ring_carrier r /\ b IN ring_carrier r /\
            c IN ring_carrier r /\ d IN ring_carrier r
            ==> ring_mul r (ring_mul r a b) (ring_mul r c d) =
                ring_mul r (ring_mul r a c) (ring_mul r b d)")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ABBREV_TAC
      (← q r"frc:A->(A#A->bool) =
       ring_fractionate r {a | ring_regular r a}") THEN
    SUBGOAL_THEN (← q "integral_domain (r:A ring)") ASSUME_TAC THENL
     [ASM_MESON_TAC [UFD_IMP_INTEGRAL_DOMAIN], ALL_TAC] THEN
    SUBGOAL_THEN (← q "field(fraction_ring (r:A ring))") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [FRACTION_FIELD], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q "ring_monomorphism (r:A ring,fraction_ring r) frc")
      ASSUME_TAC THENL
     [EXPAND_TAC "frc" THEN REWRITE_TAC [RING_MONOMORPHISM_FRACTIONATE],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"!x:A. x IN ring_carrier r
       ==> (frc:A->(A#A->bool)) x IN
           ring_carrier(fraction_ring r)")
      ASSUME_TAC THENL
     [UNDISCH_TAC (← q "ring_monomorphism(r:A ring,fraction_ring r) frc") THEN
      REWRITE_TAC [ring_monomorphism, ring_homomorphism,
        SUBSET, FORALL_IN_IMAGE] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"ring_monomorphism (poly_ring r (:1),
         poly_ring (fraction_ring r) (:1))
        (\p:(1->num)->A. (frc:A->(A#A->bool)) o p)")
      ASSUME_TAC THENL
     [MATCH_MP_TAC RING_MONOMORPHISM_POLY_RINGS THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q "ring_polynomial r (f:(1->num)->A)") ASSUME_TAC THENL
     [ASM_MESON_TAC [IN_POLY_RING_CARRIER], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"poly_deg (fraction_ring r)
        ((frc:A->(A#A->bool)) o (f:(1->num)->A)) = poly_deg r f")
      ASSUME_TAC THENL
     [MATCH_MP_TAC POLY_DEG_MONOMORPHIC_IMAGE THEN
      ASM_MESON_TAC [IN_POLY_RING_CARRIER, SUBSET_UNIV],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"ring_homomorphism (poly_ring r (:1),
         poly_ring (fraction_ring r) (:1))
        (\p:(1->num)->A. (frc:A->(A#A->bool)) o p)")
      ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"!p:(1->num)->A. p IN ring_carrier(poly_ring r (:1))
       ==> (frc:A->(A#A->bool)) o p IN
           ring_carrier(poly_ring (fraction_ring r) (:1))")
      ASSUME_TAC THENL
     [GEN_TAC THEN
      FIRST_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [ring_homomorphism]) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      CONV_TAC (DEPTH_CONV BETA_CONV) THEN MESON_TAC [],
      ALL_TAC] THEN
    EQ_TAC THENL
    [DISCH_TAC THEN
     SUBGOAL_THEN
       (← q r"integral_domain
         (poly_ring (fraction_ring (r:A ring)) (:1))")
       ASSUME_TAC THENL
      [ASM_MESON_TAC [INTEGRAL_DOMAIN_POLY_RING, FIELD_IMP_INTEGRAL_DOMAIN],
       ALL_TAC] THEN
     SUBGOAL_THEN
       (← q r"(frc:A->(A#A->bool)) o (f:(1->num)->A) IN
        ring_carrier(poly_ring (fraction_ring r) (:1))")
       ASSUME_TAC THENL
      [FIRST_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
       ALL_TAC] THEN
     SUBGOAL_THEN
       (← q r"~((frc:A->(A#A->bool)) o (f:(1->num)->A) =
         ring_0(poly_ring (fraction_ring (r:A ring)) (:1)))")
       ASSUME_TAC THENL
      [MP_TAC (← ISPECL
         [← q "poly_ring (r:A ring) (:1)",
          ← q "poly_ring (fraction_ring (r:A ring)) (:1)",
          ← q r"\p:(1->num)->A. (frc:A->(A#A->bool)) o p",
          ← q "f:(1->num)->A"] RING_MONOMORPHISM_EQ_0) THEN
