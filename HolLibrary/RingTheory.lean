@[nospecialize]
def setupSpecialIdeals [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BRingRule : RingRule) (BCosets : Cosets) (BQuotients : Quotients) (BPrimes : Primes) (BSquarefree : Squarefree) (BLocalization : Localization) :
    ExceptT String IO SpecialIdeals := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, basic_ss,
        new_definition, .. } := D
  let { ARITH_EQ, .. } := D.core1
  let { CONJ_ACI, CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, DISJOINT_SING, EQ_IMP,
        EXISTS_FINITE_SUBSET_IMAGE, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, EXISTS_PAIR_THM,
        EXTENSION, .. } := D.core2
  let { FINITE_IMAGE, FINITE_INTER, FINITE_SING, FINITE_UNION, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_PAIR_THM, IMAGE_CLAUSES, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, INSERT_SUBSET, INTER_SUBSET, .. } := D.core4
  let { IN_CROSS, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_SING,
        IN_UNIONS, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, NOT_SUC, PSUBSET, PSUBSET_ALT, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET,
        SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_RESTRICT, SUBSET_TRANS,
        SUBSET_UNIONS, UNIONS_GSPEC, UNIONS_SUBSET, UNION_SUBSET, .. } := D.core7
  let { ZL_SUBSETS_UNIONS_NONEMPTY, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_ASSOC, RING_ADD_LZERO, RING_ADD_RDISTRIB,
        RING_ADD_RNEG, RING_LNEG_UNIQUE, RING_MUL, RING_MUL_AC, RING_MUL_ASSOC,
        RING_MUL_RID, RING_MUL_SYM, RING_NEG, RING_NEG_ADD, RING_NEG_NEG,
        RING_SUB_RZERO, TRIVIAL_RING_10, TRIVIAL_RING_SUBSET, ring_sub, trivial_ring, .. } := BBasics
  let { RING_POW, RING_POW_2, ring_pow, .. } := BNumbers
  let { RING_ASSOCIATES_RMUL, RING_DIVIDES_IN_CARRIER, RING_DIVIDES_MUL2,
        RING_DIVIDES_ONE, RING_DIVIDES_REFL, RING_UNIT_0, RING_UNIT_1,
        RING_UNIT_MUL_EQ, RING_UNIT_NEG_EQ, RING_UNIT_POW_EQ, ring_divides, ring_unit, .. } := BDivides
  let { IDEALS_GENERATED_SING_EQ, IDEAL_GENERATED_0,
        IDEAL_GENERATED_BY_IDEAL_GENERATED, IDEAL_GENERATED_EMPTY,
        IDEAL_GENERATED_EQ_0, IDEAL_GENERATED_INC, IDEAL_GENERATED_INC_GEN,
        IDEAL_GENERATED_INSERT, IDEAL_GENERATED_MINIMAL, IDEAL_GENERATED_MINIMAL_EQ,
        IDEAL_GENERATED_MONO, IDEAL_GENERATED_RESTRICT, IDEAL_GENERATED_RING_IDEAL,
        IDEAL_GENERATED_SCALE, IDEAL_GENERATED_SETADD_SUBSET, IDEAL_GENERATED_SING,
        IDEAL_GENERATED_SING_ALT, IDEAL_GENERATED_SING_EQ_CARRIER,
        IDEAL_GENERATED_SUBSET, IDEAL_GENERATED_SUBSET_CARRIER_SUBSET,
        IDEAL_GENERATED_UNION, IN_IDEAL_GENERATED_SING_EQ, IN_RING_IDEAL_0,
        IN_RING_IDEAL_ADD, IN_RING_IDEAL_LMUL, IN_RING_IDEAL_NEG, IN_RING_IDEAL_RMUL,
        IN_RING_IDEAL_SUB, RING_ADD_IN_SETADD, RING_IDEAL_0, RING_IDEAL_CARRIER,
        RING_IDEAL_EQ_CARRIER, RING_IDEAL_EQ_CARRIER_UNIT, RING_IDEAL_IDEAL_GENERATED,
        RING_IDEAL_IMP_SUBSET, RING_IDEAL_QUOTIENT_LMUL, RING_IDEAL_QUOTIENT_RMUL,
        RING_IDEAL_SETADD, RING_IDEAL_UNIONS, RING_MULTIPLE_IN_IDEAL,
        RING_MUL_IN_SETMUL, RING_SETADD_SUBSET_IDEAL, RING_SETADD_SUPERSET_LEFT,
        RING_SETADD_SUPERSET_RIGHT, RING_SETMUL_IDEAL_GENERATED_SING,
        RING_SETMUL_IDEAL_LEFT, SUBSET_IDEALS_GENERATED_SING, ring_ideal, ring_setadd, .. } := BIdeals
  let { FIELD_EQ_ALL_UNITS, FIELD_IMP_INTEGRAL_DOMAIN, INTEGRAL_DOMAIN_MUL_LCANCEL,
        field, integral_domain, .. } := BDomains
  let { IDEAL_GENERATED_BY_EPIMORPHIC_IMAGE, RING_EPIMORPHISM_IMP_HOMOMORPHISM,
        RING_HOMOMORPHISM_1, RING_IDEAL_EPIMORPHIC_IMAGE,
        RING_IDEAL_HOMOMORPHIC_PREIMAGE, RING_ISOMORPHISM,
        RING_ISOMORPHISMS_ISOMORPHISM, RING_ISOMORPHISM_IMP_EPIMORPHISM,
        RING_ISOMORPHISM_IMP_HOMOMORPHISM, RING_MONOMORPHISM_EPIMORPHISM,
        ring_epimorphism, ring_homomorphism, ring_isomorphism, ring_isomorphisms, .. } := BHoms
  let { ISOMORPHIC_RING_SYM, isomorphic_ring, .. } := BIso
  let { ISOMORPHIC_RING_FIELDNESS, ISOMORPHIC_RING_INTEGRAL_DOMAINNESS,
        RING_IDEAL_ISOMORPHIC_IMAGE_EQ, RING_IDEAL_RING_KERNEL, RING_MONOMORPHISM,
        ring_kernel, .. } := BKernels
  let { RING_TAC, .. } := BRingRule
  let { RING_COSET_EQ, RING_COSET_EQ_IDEAL, .. } := BCosets
  let { FIRST_RING_ISOMORPHISM_THEOREM_GEN, QUOTIENT_RING, QUOTIENT_RING_0,
        QUOTIENT_RING_MUL, RING_EPIMORPHISM_RING_COSET, .. } := BQuotients
  let { INTEGRAL_DOMAIN_IRREDUCIBLE_ALT, INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE,
        ring_irreducible, ring_prime, .. } := BPrimes
  let { RING_MULTSYS_IMP_NONEMPTY, RING_MULTSYS_IMP_SUBSET, RING_MULYSYS_1,
        ring_multsys, .. } := BSquarefree
  let { IDEAL_GENERATED_RING_LOCALIZATION, RING_FRACTIONATE_IN_CARRIER, .. } := BLocalization
  -- @@SCOPE END

  let proper_ideal ← new_definition
   r"proper_ideal (r:A ring) j <=>
        ring_ideal r j /\ j PSUBSET ring_carrier r"

  let principal_ideal ← new_definition
   r"principal_ideal (r:A ring) j <=>
        ?a. a IN ring_carrier r /\ ideal_generated r {a} = j"

  let finitely_generated_ideal ← new_definition
   r"finitely_generated_ideal (r:A ring) j <=>
        ?s. FINITE s /\ s SUBSET ring_carrier r /\ ideal_generated r s = j"

  let prime_ideal ← new_definition
   r"prime_ideal (r:A ring) j <=>
        proper_ideal r j /\
        !x y. x IN ring_carrier r /\
              y IN ring_carrier r /\
              (ring_mul r x y) IN j
              ==> x IN j \/ y IN j"

  let maximal_ideal ← new_definition
   r"maximal_ideal (r:A ring) j <=>
        proper_ideal r j /\ ~(?j'. proper_ideal r j' /\ j PSUBSET j')"

  let PID ← new_definition
   r"PID (r:A ring) <=>
        integral_domain r /\
        !j. ring_ideal r j ==> principal_ideal r j"

  let noetherian_ring ← new_definition
   r"noetherian_ring (r:A ring) <=>
        !j. ring_ideal r j ==> finitely_generated_ideal r j"

  let PROPER_IMP_RING_IDEAL ← prove
   r"!r j:A->bool. proper_ideal r j ==> ring_ideal r j"
   (SIMP_TAC [proper_ideal])

  let PROPER_IDEAL_IMP_SUBSET ← prove
   r"!r s:A->bool. proper_ideal r s ==> s SUBSET ring_carrier r"
   (SIMP_TAC [ring_ideal, proper_ideal])

  let PROPER_IDEAL_IMP_PSUBSET ← prove
   r"!r s:A->bool. proper_ideal r s ==> s PSUBSET ring_carrier r"
   (SIMP_TAC [proper_ideal])

  let PRINCIPAL_IMP_RING_IDEAL ← prove
   r"!r j:A->bool. principal_ideal r j ==> ring_ideal r j"
   (REWRITE_TAC [principal_ideal] THEN MESON_TAC [RING_IDEAL_IDEAL_GENERATED])

  let PRINCIPAL_IDEAL_IMP_SUBSET ← prove
   r"!r s:A->bool. principal_ideal r s ==> s SUBSET ring_carrier r"
   (MESON_TAC [principal_ideal, IDEAL_GENERATED_SUBSET])

  let FINITELY_GENERATED_IMP_RING_IDEAL ← prove
   r"!r j:A->bool. finitely_generated_ideal r j ==> ring_ideal r j"
   (REWRITE_TAC [finitely_generated_ideal] THEN
    MESON_TAC [RING_IDEAL_IDEAL_GENERATED])

  let FINITELY_GENERATED_IDEAL_IMP_SUBSET ← prove
   r"!r s:A->bool. finitely_generated_ideal r s ==> s SUBSET ring_carrier r"
   (MESON_TAC [finitely_generated_ideal, IDEAL_GENERATED_SUBSET])

  let FINITELY_GENERATED_IDEAL_SUBSET ← prove
   r"!(r:A ring) j.
        finitely_generated_ideal r j <=>
        ?s. FINITE s /\ s SUBSET j /\ s SUBSET ring_carrier r /\
            ideal_generated r s = j"
   (MESON_TAC [finitely_generated_ideal, IDEAL_GENERATED_SUBSET_CARRIER_SUBSET])

  let PRIME_IMP_PROPER_IDEAL ← prove
   r"!r j:A->bool. prime_ideal r j ==> proper_ideal r j"
   (SIMP_TAC [prime_ideal])

  let PRIME_IMP_RING_IDEAL ← prove
   r"!r j:A->bool. prime_ideal r j ==> ring_ideal r j"
   (SIMP_TAC [prime_ideal, proper_ideal])

  let PRIME_IDEAL_IMP_SUBSET ← prove
   r"!r j:A->bool. prime_ideal r j ==> j SUBSET ring_carrier r"
   (SIMP_TAC [RING_IDEAL_IMP_SUBSET, PRIME_IMP_RING_IDEAL])

  let PRIME_IDEAL_IMP_PSUBSET ← prove
   r"!r j:A->bool. prime_ideal r j ==> j PSUBSET ring_carrier r"
   (SIMP_TAC [PROPER_IDEAL_IMP_PSUBSET, PRIME_IMP_PROPER_IDEAL])

  let MAXIMAL_IMP_PROPER_IDEAL ← prove
   r"!r j:A->bool. maximal_ideal r j ==> proper_ideal r j"
   (SIMP_TAC [maximal_ideal])

  let MAXIMAL_IMP_RING_IDEAL ← prove
   r"!r j:A->bool. maximal_ideal r j ==> ring_ideal r j"
   (SIMP_TAC [maximal_ideal, proper_ideal])

  let MAXIMAL_IDEAL_IMP_SUBSET ← prove
   r"!r j:A->bool. maximal_ideal r j ==> j SUBSET ring_carrier r"
   (SIMP_TAC [RING_IDEAL_IMP_SUBSET, MAXIMAL_IMP_RING_IDEAL])

  let MAXIMAL_IDEAL_IMP_PSUBSET ← prove
   r"!r j:A->bool. maximal_ideal r j ==> j PSUBSET ring_carrier r"
   (SIMP_TAC [PROPER_IDEAL_IMP_PSUBSET, MAXIMAL_IMP_PROPER_IDEAL])

  let PROPER_IDEAL_0 ← prove
   r"!r:A ring. proper_ideal r {ring_0 r} <=> ~trivial_ring r"
   (GEN_TAC THEN REWRITE_TAC [proper_ideal, RING_IDEAL_0, trivial_ring] THEN
    MP_TAC (← ISPEC (← q "r:A ring") RING_0) THEN SET_TAC [])

  let PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL ← prove
   r"!r j:A->bool. principal_ideal r j ==> finitely_generated_ideal r j"
   (REPEAT GEN_TAC THEN REWRITE_TAC [principal_ideal, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
    REWRITE_TAC [finitely_generated_ideal] THEN
    EXISTS_TAC (← q "{a:A}") THEN ASM_REWRITE_TAC [SING_SUBSET, FINITE_SING])

  let PID_IMP_INTEGRAL_DOMAIN ← prove
   r"!r:A ring. PID r ==> integral_domain r"
   (SIMP_TAC [PID])

  let PID_IMP_NOETHERIAN_RING ← prove
   r"!r:A ring. PID r ==> noetherian_ring r"
   (REWRITE_TAC [PID, noetherian_ring] THEN
    MESON_TAC [PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL])

  let PRINCIPAL_IDEAL_ALT ← prove
   r"!(r:A ring) j.
        principal_ideal (r:A ring) j <=> ?a. ideal_generated r {a} = j"
   (REPEAT GEN_TAC THEN REWRITE_TAC [principal_ideal] THEN
    EQ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "a:A") MP_TAC) THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IDEAL_GENERATED_RESTRICT] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"~(x IN s) ==> s INTER {x} = {}")] THEN
    REWRITE_TAC [IDEAL_GENERATED_EMPTY] THEN
    MESON_TAC [IDEAL_GENERATED_0, RING_0])

  let PRINCIPAL_IDEAL_IDEAL_GENERATED_SING ← prove
   r"!r a:A. principal_ideal r (ideal_generated r {a})"
   (MESON_TAC [PRINCIPAL_IDEAL_ALT])

  let PRINCIPAL_IDEAL_0 ← prove
   r"!r:A ring. principal_ideal r {ring_0 r}"
   (REWRITE_TAC [principal_ideal] THEN
    MESON_TAC [IDEAL_GENERATED_0, RING_0])

  let FINITELY_GENERATED_IDEAL_0 ← prove
   r"!r:A ring. finitely_generated_ideal r {ring_0 r}"
   (MESON_TAC [PRINCIPAL_IDEAL_0, PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL])

  let PRINCIPAL_IDEAL_CARRIER ← prove
   r"!r:A ring. principal_ideal r (ring_carrier r)"
   (GEN_TAC THEN REWRITE_TAC [principal_ideal] THEN
    EXISTS_TAC (← q "ring_1 r:A") THEN
    SIMP_TAC [RING_IDEAL_EQ_CARRIER, RING_IDEAL_IDEAL_GENERATED, RING_1,
              IDEAL_GENERATED_INC_GEN, IN_SING])

  let FINITELY_GENERATED_IDEAL_CARRIER ← prove
   r"!r:A ring. finitely_generated_ideal r (ring_carrier r)"
   (MESON_TAC [PRINCIPAL_IDEAL_CARRIER, PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL])

  let PROPER_IDEAL_ALT ← prove
   r"!(r:A ring) j.
        proper_ideal r j <=> ring_ideal r j /\ ~(j = ring_carrier r)"
   (REWRITE_TAC [proper_ideal, PSUBSET] THEN
    MESON_TAC [RING_IDEAL_IMP_SUBSET])

  let NONPRINCIPAL_IMP_PROPER_IDEAL ← prove
   r"!r:A ring. ring_ideal r j /\ ~(principal_ideal r j) ==> proper_ideal r j"
   (SIMP_TAC [PROPER_IDEAL_ALT] THEN
    MESON_TAC [PRINCIPAL_IDEAL_CARRIER, ← SET_RULE (← q r"~(s PSUBSET s)")])

  let NONFINITELY_GENERATED_IMP_PROPER_IDEAL ← prove
   r"!r:A ring.
      ring_ideal r j /\ ~(finitely_generated_ideal r j) ==> proper_ideal r j"
   (MESON_TAC [NONPRINCIPAL_IMP_PROPER_IDEAL,
               PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL])

  let FINITELY_GENERATED_IDEAL_ALT ← prove
   r"!(r:A ring) j.
        finitely_generated_ideal (r:A ring) j <=>
        ?s. FINITE s /\ ideal_generated r s = j"
   (REPEAT GEN_TAC THEN REWRITE_TAC [finitely_generated_ideal] THEN
    EQ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(ring_carrier r INTER s):A->bool") THEN
    ASM_REWRITE_TAC [INTER_SUBSET, ← GSYM IDEAL_GENERATED_RESTRICT] THEN
    ASM_SIMP_TAC [FINITE_INTER])

  let FINITELY_GENERATED_IDEAL_GENERATED ← prove
   r"!(r:A ring) s.
        FINITE s ==> finitely_generated_ideal r (ideal_generated r s)"
   (REWRITE_TAC [FINITELY_GENERATED_IDEAL_ALT] THEN MESON_TAC [])

  let FINITELY_GENERATED_IDEAL_SETADD ← prove
   r"!r j k:A->bool.
        finitely_generated_ideal r j /\ finitely_generated_ideal r k
        ==> finitely_generated_ideal r (ring_setadd r j k)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [finitely_generated_ideal] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"s UNION t:A->bool") THEN
    ASM_REWRITE_TAC [FINITE_UNION, UNION_SUBSET, IDEAL_GENERATED_UNION])

  let PROPER_IDEAL ← prove
   r"!(r:A ring) j. proper_ideal r j <=> ring_ideal r j /\ ~(ring_1 r IN j)"
   (SIMP_TAC [proper_ideal, PSUBSET] THEN
    MESON_TAC [RING_IDEAL_IMP_SUBSET, RING_IDEAL_EQ_CARRIER])

  let PROPER_IDEAL_UNIT ← prove
   r"!(r:A ring) j.
        proper_ideal r j <=> ring_ideal r j /\ DISJOINT j {u | ring_unit r u}"
   (REWRITE_TAC [← SET_RULE (← q r"DISJOINT u {x | P x} <=> ~(?x. P x /\ x IN u)")] THEN
    SIMP_TAC [proper_ideal, PSUBSET] THEN
    MESON_TAC [RING_IDEAL_IMP_SUBSET, RING_IDEAL_EQ_CARRIER_UNIT])

  let PROPER_IDEAL_SUBSET_NONUNITS ← prove
   r"!r j:A->bool.
        proper_ideal r j
        ==> j SUBSET {x | x IN ring_carrier r /\ ~(ring_unit r x)}"
   (REWRITE_TAC [PROPER_IDEAL_UNIT, ← SET_RULE
     (← q r"t SUBSET {x | x IN s /\ P x} <=> t SUBSET s /\ !x. x IN t ==> P x")] THEN
    SIMP_TAC [RING_IDEAL_IMP_SUBSET] THEN SET_TAC [])

  let PROPER_IDEAL_UNIONS ← prove
   r"!r (u:(A->bool)->bool).
        ~(u = {}) /\
        (!h. h IN u ==> proper_ideal r h) /\
        (!g h. g IN u /\ h IN u ==> g SUBSET h \/ h SUBSET g)
        ==> proper_ideal r (UNIONS u)"
   (SIMP_TAC [PROPER_IDEAL, RING_IDEAL_UNIONS] THEN SET_TAC [])

  let PROPER_IDEAL_EXISTS ← prove
   r"!(r:A ring). (?j. proper_ideal r j) <=> ~(trivial_ring r)"
   (GEN_TAC THEN REWRITE_TAC [proper_ideal, TRIVIAL_RING_SUBSET] THEN EQ_TAC THENL
     [REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"j:A->bool") THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q r"j:A->bool"] IN_RING_IDEAL_0) THEN SET_TAC [],
      DISCH_TAC THEN EXISTS_TAC (← q "{ring_0 r:A}") THEN
      REWRITE_TAC [RING_IDEAL_0] THEN
      MP_TAC (← ISPEC (← q "r:A ring") RING_0) THEN ASM SET_TAC []])

  let FINITELY_GENERATED_IDEAL_EPIMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B) j.
         ring_epimorphism (r,r') f /\ finitely_generated_ideal r j
         ==> finitely_generated_ideal r' (IMAGE f j)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [finitely_generated_ideal] THEN FIRST_ASSUM
     (SUBST1_TAC o SYM o CONJUNCT2 o REWRITE_RULE [ring_epimorphism]) THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [IDEAL_GENERATED_BY_EPIMORPHIC_IMAGE])

  let PRINCIPAL_IDEAL_EPIMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B) j.
         ring_epimorphism (r,r') f /\ principal_ideal r j
         ==> principal_ideal r' (IMAGE f j)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [principal_ideal] THEN FIRST_ASSUM
     (SUBST1_TAC o SYM o CONJUNCT2 o REWRITE_RULE [ring_epimorphism]) THEN
    REWRITE_TAC [EXISTS_IN_IMAGE] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [IMAGE_CLAUSES, SING_SUBSET,
                   IDEAL_GENERATED_BY_EPIMORPHIC_IMAGE])

  let FINITELY_GENERATED_IDEAL_LOCALIZATION ← prove
   r"!r s (j:A->bool).
        ring_multsys r s /\ finitely_generated_ideal r j
        ==> finitely_generated_ideal (ring_localization r s)
              {ring_localequiv r s (a,b) | a,b | a IN j /\ b IN s}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [finitely_generated_ideal, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"k:A->bool") THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (ring_fractionate (r:A ring) s) k") THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_RING_LOCALIZATION, FINITE_IMAGE] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    ASM_MESON_TAC [RING_FRACTIONATE_IN_CARRIER, SUBSET])

  let PRINCIPAL_IDEAL_LOCALIZATION ← prove
   r"!r s (j:A->bool).
        ring_multsys r s /\ principal_ideal r j
        ==> principal_ideal (ring_localization r s)
              {ring_localequiv r s (a,b) | a,b | a IN j /\ b IN s}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [principal_ideal, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    DISCH_TAC THEN X_GEN_TAC (← q "a:A") THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q "ring_fractionate (r:A ring) s a") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [RING_FRACTIONATE_IN_CARRIER, SUBSET], ALL_TAC] THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    ASM_SIMP_TAC [← GSYM IDEAL_GENERATED_RING_LOCALIZATION, SING_SUBSET] THEN
    REWRITE_TAC [IMAGE_CLAUSES])

  let PROPER_IDEAL_HOMOMORPHIC_PREIMAGE ← prove
   r"!r r' (f:A->B) j.
        ring_homomorphism(r,r') f /\ proper_ideal r' j
        ==> proper_ideal r {x | x IN ring_carrier r /\ f x IN j}"
   (REWRITE_TAC [PROPER_IDEAL, IN_ELIM_THM, RING_1] THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC RING_IDEAL_HOMOMORPHIC_PREIMAGE THEN ASM SET_TAC [],
      ASM_MESON_TAC [RING_HOMOMORPHISM_1]])

  let PROPER_IDEAL_CORRESPONDENCE ← prove
   r"!r r' (f:A->B) j k.
         ring_homomorphism (r,r') f /\
         ring_ideal r' k /\
         {x | x IN ring_carrier r /\ f x IN k} = j
         ==> (proper_ideal r j <=> proper_ideal r' k)"
   (SIMP_TAC [PROPER_IDEAL] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, RING_1] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP RING_HOMOMORPHISM_1) THEN
    ASM_CASES_TAC (← q "(ring_1 r':B) IN k") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC RING_IDEAL_HOMOMORPHIC_PREIMAGE THEN ASM_MESON_TAC [])

  let PROPER_IDEAL_ISOMORPHIC_IMAGE_EQ ← prove
   r"!r r' (f:A->B) j.
        ring_isomorphism(r,r') f /\ j SUBSET ring_carrier r
        ==> (proper_ideal r' (IMAGE f j) <=> proper_ideal r j)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_IDEAL_ISOMORPHIC_IMAGE_EQ) THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> p) /\ (q' ==> p') /\ (p' ==> (q' <=> q))
    ==> (p' <=> p) ==> (q' <=> q)")) THEN
    REWRITE_TAC [PROPER_IMP_RING_IDEAL] THEN DISCH_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC PROPER_IDEAL_CORRESPONDENCE THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_SIMP_TAC [RING_ISOMORPHISM_IMP_HOMOMORPHISM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_isomorphism, ring_isomorphisms]) THEN
    ASM SET_TAC [])

  let PRIME_IDEAL_HOMOMORPHIC_PREIMAGE ← prove
   r"!r r' (f:A->B) j.
        ring_homomorphism(r,r') f /\ prime_ideal r' j
        ==> prime_ideal r {x | x IN ring_carrier r /\ f x IN j}"
   (REWRITE_TAC [prime_ideal, IN_ELIM_THM] THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC PROPER_IDEAL_HOMOMORPHIC_PREIMAGE THEN ASM SET_TAC [],
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism]) THEN ASM SET_TAC []])

  let RING_1_NOT_IN_PRIME_IDEAL ← prove
   r"!r j:A->bool.
        prime_ideal r j ==> ~(ring_1 r IN j)"
   (MESON_TAC [PROPER_IDEAL, prime_ideal])

  let RING_UNIT_NOT_IN_PRIME_IDEAL ← prove
   r"!r j x:A.
        prime_ideal r j /\ ring_unit r x ==> ~(x IN j)"
   (REWRITE_TAC [prime_ideal, PROPER_IDEAL_UNIT] THEN SET_TAC [])

  let RING_MUL_IN_PRIME_IDEAL ← prove
   r"!r j x y:A.
        prime_ideal r j /\ x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_mul r x y IN j <=> x IN j \/ y IN j)"
   (ASM_MESON_TAC [prime_ideal, proper_ideal, ring_ideal, RING_MUL_SYM, SUBSET])

  let RING_POW_IN_PRIME_IDEAL ← prove
   r"!r j (x:A) n.
        prime_ideal r j /\ x IN ring_carrier r
        ==> (ring_pow r x n IN j <=> ~(n = 0) /\ x IN j)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [ring_pow, RING_1_NOT_IN_PRIME_IDEAL] THEN
    ASM_SIMP_TAC [RING_MUL_IN_PRIME_IDEAL, RING_POW, NOT_SUC] THEN
    CONV_TAC (fun t => (TAUT t).run))

  let MAXIMAL_SUPERIDEAL_EXISTS ← prove
   r"!(r:A ring) j.
        proper_ideal r j ==> ?j'. maximal_ideal r j' /\ j SUBSET j'"
   (REWRITE_TAC [PROPER_IDEAL] THEN REPEAT STRIP_TAC THEN MP_TAC (← ISPEC
     (← q r"\j'. proper_ideal (r:A ring) j' /\ j SUBSET j'")
     ZL_SUBSETS_UNIONS_NONEMPTY) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [MEMBER_NOT_EMPTY, PROPER_IDEAL] THEN
      SIMP_TAC [RING_IDEAL_UNIONS] THEN ASM SET_TAC [],
      REWRITE_TAC [maximal_ideal, PROPER_IDEAL] THEN
      MATCH_MP_TAC MONO_EXISTS THEN SET_TAC []])

  let MAXIMAL_IDEAL_EXISTS ← prove
   r"!r:A ring. (?j. maximal_ideal r j) <=> ~(trivial_ring r)"
   (GEN_TAC THEN REWRITE_TAC [← GSYM PROPER_IDEAL_EXISTS] THEN
    MESON_TAC [MAXIMAL_IMP_PROPER_IDEAL, MAXIMAL_SUPERIDEAL_EXISTS])

  let RING_MULTSYS_NONPRIME ← prove
   r"!r j:A->bool.
        prime_ideal r j ==> ring_multsys r (ring_carrier r DIFF j)"
   (REWRITE_TAC [ring_multsys, IN_DIFF, prime_ideal, PROPER_IDEAL] THEN
    GEN_TAC THEN SIMP_TAC [RING_MUL, RING_1] THEN SET_TAC [])

  let RING_MULTSYS_NONPRIME_EQ ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> (ring_multsys r (ring_carrier r DIFF j) <=> prime_ideal r j)"
   (REWRITE_TAC [ring_multsys, IN_DIFF, prime_ideal, PROPER_IDEAL] THEN
    GEN_TAC THEN SIMP_TAC [RING_MUL, RING_1] THEN SET_TAC [])

  let RING_SATURATED_MULTSYS_NONPRIME ← prove
   r"!r j:A->bool.
        prime_ideal r j
        ==> ring_multsys r (ring_carrier r DIFF j) /\
            (!x y. x IN ring_carrier r /\ y IN ring_carrier r /\
                   ring_mul r x y IN ring_carrier r DIFF j
                   ==> x IN ring_carrier r DIFF j /\
                       y IN ring_carrier r DIFF j)"
   (SIMP_TAC [RING_MULTSYS_NONPRIME] THEN
    REWRITE_TAC [prime_ideal, proper_ideal, ring_ideal, SUBSET, IN_DIFF] THEN
    MESON_TAC [RING_MUL, RING_MUL_SYM])

  let MAXIMAL_EXCLUDING_IMP_PRIME_IDEAL ← prove
   r"!r s j:A->bool.
        ring_multsys r s /\
        ring_ideal r j /\ DISJOINT j s /\
        (!j'. ring_ideal r j' /\ j PSUBSET j' ==> ~DISJOINT j' s)
        ==> prime_ideal r j"
   (← do
    -- right to left: the SET_RULEs and TAUT in reverse text order
    let s6 ← SET_RULE
     (← q r"DISJOINT j s ==> z IN s /\ j' SUBSET j ==> z IN j' ==> F")
    let s5 ← SET_RULE
     (← q r"(P ==> a IN t ==> F) ==> (s SUBSET t ==> a IN s ==> ~P)")
    let s4 ← SET_RULE
     (← q r"~DISJOINT t s /\ ~DISJOINT u s ==> P <=>
         !x y. x IN s /\ y IN s ==> x IN t /\ y IN u ==> P")
    let s3 ← SET_RULE
     (← q r"!a. a IN s /\ ~(a IN j) /\
           j SUBSET ring_setadd r j s /\ s SUBSET ring_setadd r j s
           ==> j PSUBSET ring_setadd r j s")
    let t2 ← TAUT
     (← q r"(p /\ p') /\ (q /\ q' ==> r) ==> (p ==> q) ==> (p' ==> q') ==> r")
    let s1 ← SET_RULE
     (← q r"DISJOINT j s
      ==> j SUBSET c /\ s SUBSET c /\ ~(s = {}) ==> j PSUBSET c")
    pure (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [prime_ideal, proper_ideal] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s1) THEN
      ASM_MESON_TAC [RING_MULTSYS_IMP_SUBSET, RING_MULTSYS_IMP_NONEMPTY,
                     RING_IDEAL_IMP_SUBSET],
      MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [DE_MORGAN_THM] THEN STRIP_TAC THEN
     FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q "ring_setadd r j (ideal_generated r {b:A})") th) THEN
              MP_TAC (← SPEC (← q "ring_setadd r j (ideal_generated r {a:A})") th))) THEN
     MATCH_MP_TAC t2 THEN
     CONJ_TAC THENL
      [ASM_SIMP_TAC [RING_IDEAL_SETADD, RING_IDEAL_IDEAL_GENERATED] THEN
       CONJ_TAC THEN MATCH_MP_TAC s3
       THENL [EXISTS_TAC (← q "a:A"), EXISTS_TAC (← q "b:A")] THEN
       ASM_SIMP_TAC [IDEAL_GENERATED_INC, IN_SING, SING_SUBSET] THEN
       ASM_SIMP_TAC [RING_SETADD_SUPERSET_LEFT, IN_RING_IDEAL_0, SING_SUBSET,
                     RING_IDEAL_IMP_SUBSET, RING_IDEAL_IDEAL_GENERATED,
                     RING_SETADD_SUPERSET_RIGHT],
       REWRITE_TAC [s4] THEN
       MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
       DISCH_THEN (MP_TAC o ISPEC (← q "r:A ring") o MATCH_MP RING_MUL_IN_SETMUL) THEN
       wPart (fun t => do rand (← lhand t)) (fun t => do lhand (← rand t))
         RING_SETMUL_IDEAL_LEFT THEN
       ASM_REWRITE_TAC [IDEAL_GENERATED_SUBSET] THEN MATCH_MP_TAC s5 THEN
       DISCH_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s6) THEN
       CONJ_TAC THENL [ASM_MESON_TAC [ring_multsys], ALL_TAC] THEN
       ASM_SIMP_TAC [RING_SETMUL_IDEAL_GENERATED_SING] THEN
       MATCH_MP_TAC RING_SETADD_SUBSET_IDEAL THEN
       ASM_SIMP_TAC [SUBSET_REFL, IDEAL_GENERATED_MINIMAL, SING_SUBSET]]]))

  let MAXIMAL_IMP_PRIME_IDEAL ← prove
   r"!r j:A->bool. maximal_ideal r j ==> prime_ideal r j"
   (REWRITE_TAC [maximal_ideal, PROPER_IDEAL] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MAXIMAL_EXCLUDING_IMP_PRIME_IDEAL THEN
    EXISTS_TAC (← q "{ring_1 r:A}") THEN ASM_REWRITE_TAC [RING_MULYSYS_1] THEN
    ASM SET_TAC [])

  let MAXIMAL_AMONG_PRIME_IDEALS ← prove
   r"!r j:A->bool.
        maximal_ideal r j <=>
        prime_ideal r j /\ ~(?j'. prime_ideal r j' /\ j PSUBSET j')"
   (ASM_MESON_TAC [MAXIMAL_SUPERIDEAL_EXISTS, PRIME_IMP_PROPER_IDEAL,
                   MAXIMAL_IMP_PRIME_IDEAL, maximal_ideal,
                   ← SET_RULE (← q r"s PSUBSET t /\ t SUBSET u ==> s PSUBSET u")])

  let PRIME_IDEAL_0 ← prove
   r"!r:A ring. prime_ideal r {ring_0 r} <=> integral_domain r"
   (GEN_TAC THEN REWRITE_TAC [prime_ideal, PROPER_IDEAL, RING_IDEAL_0] THEN
    REWRITE_TAC [IN_SING, integral_domain])

  let MAXIMAL_IDEAL_0 ← prove
   r"!r:A ring. maximal_ideal r {ring_0 r} <=> field r"
   (← do
    let s2 ← SET_RULE
     (← q r"{z} PSUBSET s ==> ?a. z IN s /\ a IN s /\ ~(a = z)")
    let s1 ← SET_RULE
      (← q r"!x. x IN a /\ ring_0 r IN a /\ ~(x = ring_0 r) /\ (P ==> Q)
            ==> ~(~P /\ {ring_0 r} PSUBSET a) ==> Q")
    pure (REWRITE_TAC [maximal_ideal, PROPER_IDEAL, RING_IDEAL_IDEAL_GENERATED] THEN
    REWRITE_TAC [RING_IDEAL_0, IN_SING, field] THEN
    GEN_TAC THEN ASM_CASES_TAC (← q "ring_1 r:A = ring_0 r") THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "ideal_generated r {a:A}")) THEN
      REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED] THEN
      MATCH_MP_TAC s1 THEN
      EXISTS_TAC (← q "a:A") THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_INC_GEN, IN_SING] THEN
      SIMP_TAC [IN_RING_IDEAL_0, RING_IDEAL_IDEAL_GENERATED] THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_SING, IN_ELIM_THM, ring_divides] THEN
      MESON_TAC [RING_1],
      X_GEN_TAC (← q r"j:A->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q "a:A") STRIP_ASSUME_TAC o MATCH_MP s2) THEN
      SUBGOAL_THEN (← q "(a:A) IN ring_carrier r") ASSUME_TAC THENL
       [ASM_MESON_TAC [RING_IDEAL_IMP_SUBSET, SUBSET],
        ASM_MESON_TAC [IN_RING_IDEAL_RMUL]]]))

  let PRIME_SUPERIDEAL_EXISTS ← prove
   r"!(r:A ring) j.
        proper_ideal r j ==> ?j'. prime_ideal r j' /\ j SUBSET j'"
   (MESON_TAC [MAXIMAL_IMP_PRIME_IDEAL, MAXIMAL_SUPERIDEAL_EXISTS])

  let PRIME_IDEAL_EXISTS ← prove
   r"!r:A ring. (?j. prime_ideal r j) <=> ~trivial_ring r"
   (MESON_TAC [PRIME_SUPERIDEAL_EXISTS, PROPER_IDEAL_EXISTS,
               PRIME_IMP_PROPER_IDEAL])

  let PRIME_SUPERIDEAL_EXCLUDING_EXISTS ← prove
   r"!r s j:A->bool.
        ring_ideal r j /\ ring_multsys r s /\ DISJOINT j s
        ==> ?j'. prime_ideal r j' /\ j SUBSET j' /\ DISJOINT j' s"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPEC
     (← q r"\j'. ring_ideal (r:A ring) j' /\ j SUBSET j' /\ DISJOINT j' s")
     ZL_SUBSETS_UNIONS_NONEMPTY) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [MEMBER_NOT_EMPTY, RING_IDEAL_UNIONS] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [SUBSET_REFL], SET_TAC []],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:A->bool") THEN
      REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MAXIMAL_EXCLUDING_IMP_PRIME_IDEAL THEN
      EXISTS_TAC (← q r"s:A->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let PRIME_IDEAL_EXCLUDING_EXISTS ← prove
   r"!r s:A->bool.
           ring_multsys r s /\ ~(ring_0 r IN s)
           ==> ?j. prime_ideal r j /\ DISJOINT j s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:A->bool", ← q "{ring_0 r:A}"]
          PRIME_SUPERIDEAL_EXCLUDING_EXISTS) THEN
    ASM_REWRITE_TAC [RING_IDEAL_0, DISJOINT_SING] THEN MESON_TAC [])

  let MAXIMAL_NONFG_IMP_PRIME_IDEAL ← prove
   r"!r j:A->bool.
      ring_ideal r j /\ ~finitely_generated_ideal r j /\
      (!j'. ring_ideal r j' /\ j PSUBSET j' ==> finitely_generated_ideal r j')
      ==> prime_ideal r j"
   (← do
    -- `let eqlemma = ... and sublemma = ...`: left to right
    let eqlemma ← prove
     r"!r s t:A->bool.
      ring_setadd r s t = IMAGE (\(x,y). ring_add r x y) (s CROSS t)"
     (REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE,
                   EXISTS_PAIR_THM, IN_CROSS] THEN
      REWRITE_TAC [ring_setadd, IN_ELIM_THM] THEN MESON_TAC [])
    let sublemma ← prove
     r"!r s:A#A->bool.
      IMAGE (\(x,y). ring_add r x y) s SUBSET
      ring_setadd r (IMAGE FST s) (IMAGE SND s)"
     (REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FORALL_PAIR_THM] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_ADD_IN_SETADD THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN ASM_MESON_TAC [])
    -- the main tactic's rules, right to left
    let s10 ← SET_RULE
     (← q r"G SUBSET s ==> (!x. x IN s ==> P x) ==> (!x. x IN G ==> P x)")
    let s9 ← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")
    let t8 ← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")
    let s7 ← SET_RULE (← q r"t SUBSET u /\ s SUBSET t /\ x IN s ==> x IN u")
    let s6 ← SET_RULE
     (← q r"G SUBSET s ==> (!x. x IN s ==> P x) ==> (!x. x IN G ==> P x)")
    let s5 ← SET_RULE
     (← q r"G SUBSET s ==> (!x. x IN s ==> P x) ==> (!x. x IN G ==> P x)")
    let s4 ← SET_RULE
     (← q r"j SUBSET r /\ s SUBSET j /\ (s SUBSET j ==> j SUBSET k)
    ==> s SUBSET r /\ r INTER s SUBSET j /\ j SUBSET k")
    let t3 ← TAUT (← q r"p /\ (p ==> ~q) ==> (p ==> q) ==> F")
    let t2 ← TAUT (← q r"p /\ (p ==> ~q) ==> (p ==> q) ==> F")
    let t1 ← TAUT (← q r"p \/ q <=> ~(~p /\ ~q)")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_IDEAL_IMP_SUBSET) THEN
    ASM_REWRITE_TAC [prime_ideal, proper_ideal, PSUBSET] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [FINITELY_GENERATED_IDEAL_CARRIER], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN
    REWRITE_TAC [t1] THEN REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q "J = ideal_generated r ((a:A) INSERT j)") THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"J:A->bool")) THEN
    MATCH_MP_TAC t2 THEN CONJ_TAC THENL
     [EXPAND_TAC "J" THEN REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED] THEN
      REWRITE_TAC [PSUBSET_ALT] THEN CONJ_TAC THENL
       [wPart rand (fun t => do rand (← rand t))
          IDEAL_GENERATED_SUBSET_CARRIER_SUBSET THEN
        ASM SET_TAC [],
        EXISTS_TAC (← q "a:A") THEN ASM_MESON_TAC [IDEAL_GENERATED_INC_GEN, IN_INSERT]],
      REPEAT STRIP_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE id [FINITELY_GENERATED_IDEAL_SUBSET]) THEN
    EXPAND_TAC "J" THEN REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (RAND_CONV o BINDER_CONV o RAND_CONV o LAND_CONV o RAND_CONV)
      [IDEAL_GENERATED_INSERT] THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_RING_IDEAL] THEN
    REWRITE_TAC [eqlemma, EXISTS_FINITE_SUBSET_IMAGE] THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"G:A#A->bool") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"K = {x:A | x IN ring_carrier r /\ ring_mul r a x IN j}") THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"K:A->bool")) THEN
    MATCH_MP_TAC t3 THEN CONJ_TAC THENL
     [EXPAND_TAC "K" THEN ASM_SIMP_TAC [RING_IDEAL_QUOTIENT_LMUL] THEN
      EXPAND_TAC "K" THEN REWRITE_TAC [PSUBSET_ALT, IN_ELIM_THM, SUBSET] THEN
      ASM_MESON_TAC [IN_RING_IDEAL_LMUL, SUBSET],
      STRIP_TAC] THEN
    REWRITE_TAC [finitely_generated_ideal] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"H:A->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
     [finitely_generated_ideal]) THEN
    ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"IMAGE (ring_mul r a) H UNION IMAGE SND (G:A#A->bool)") THEN
    ASM_SIMP_TAC [FINITE_UNION, FINITE_IMAGE] THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_MINIMAL_EQ, ← GSYM SUBSET_ANTISYM_EQ] THEN
    MATCH_MP_TAC s4 THEN
    ASM_REWRITE_TAC [UNION_SUBSET] THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN CONJ_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP IDEAL_GENERATED_SUBSET_CARRIER_SUBSET) THEN
        ASM SET_TAC [],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s5) THEN
        SIMP_TAC [FORALL_PAIR_THM, IN_CROSS]],
      STRIP_TAC] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q "z:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q "z IN ideal_generated r ((a:A) INSERT j)") MP_TAC THENL
     [MATCH_MP_TAC IDEAL_GENERATED_INC THEN
      ASM_REWRITE_TAC [IN_INSERT, INSERT_SUBSET],
      ASM_REWRITE_TAC [] THEN EXPAND_TAC "J"] THEN
    wPart (fun t => do rand (← rand (← lhand t))) lhand sublemma THEN
    DISCH_THEN (MP_TAC o SPEC (← q "r:A ring") o MATCH_MP IDEAL_GENERATED_MONO) THEN
    wPart (fun t => do rand (← lhand t)) (fun t => do lhand (← rand t))
      IDEAL_GENERATED_SETADD_SUBSET THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s6) THEN
      SIMP_TAC [FORALL_PAIR_THM, IN_CROSS] THEN
      MESON_TAC [SUBSET, IDEAL_GENERATED_SUBSET],
      REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC]] THEN
    DISCH_THEN (MP_TAC o MATCH_MP s7) THEN
    UNDISCH_TAC (← q "(z:A) IN j") THEN
    ONCE_REWRITE_TAC [t8] THEN
    SPEC_TAC (← q "z:A", ← q "z:A") THEN REWRITE_TAC [IDEAL_GENERATED_UNION] THEN
    REWRITE_TAC [ring_setadd, FORALL_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    MAP_EVERY EXISTS_TAC [← q "x:A", ← q "y:A"] THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q "(x:A) IN j") MP_TAC THENL
     [SUBGOAL_THEN (← q "(x:A) = ring_sub r (ring_add r x y) y") SUBST1_TAC THENL
       [RING_TAC THEN ASM_MESON_TAC [SUBSET, IDEAL_GENERATED_SUBSET],
        MATCH_MP_TAC IN_RING_IDEAL_SUB THEN ASM_REWRITE_TAC []] THEN
      ASM_MESON_TAC [IDEAL_GENERATED_MINIMAL, SUBSET],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q "x IN ideal_generated r {a:A}") MP_TAC THENL
     [ONCE_REWRITE_TAC [← GSYM IDEAL_GENERATED_BY_IDEAL_GENERATED] THEN
      UNDISCH_TAC (← q r"x IN ideal_generated r (IMAGE FST (G:A#A->bool))") THEN
      MATCH_MP_TAC s9 THEN
      MATCH_MP_TAC IDEAL_GENERATED_MONO THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s10) THEN
      SIMP_TAC [FORALL_PAIR_THM, IN_CROSS],
      ASM_SIMP_TAC [IN_IDEAL_GENERATED_SING_EQ, ring_divides] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "w:A") (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC) o
                 CONJUNCT2) THEN
      DISCH_TAC] THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_SCALE, IN_IMAGE] THEN EXISTS_TAC (← q "w:A") THEN
    ASM SET_TAC []))

  let PRIME_IDEAL_SING ← prove
   r"!r a:A. prime_ideal r (ideal_generated r {a}) <=>
           if ~(a IN ring_carrier r) \/ a = ring_0 r then integral_domain r
           else ring_prime r a"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THENL
     [COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IDEAL_GENERATED_0, PRIME_IDEAL_0] THEN
      ASM_SIMP_TAC [prime_ideal, PROPER_IDEAL, RING_IDEAL_IDEAL_GENERATED] THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_SING, IN_ELIM_THM, RING_DIVIDES_ONE] THEN
      ASM_REWRITE_TAC [ring_prime],
      ONCE_REWRITE_TAC [IDEAL_GENERATED_RESTRICT] THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_EMPTY, ← SET_RULE
        (← q r"~(a IN s) ==> s INTER {a} = {}")] THEN
      REWRITE_TAC [PRIME_IDEAL_0]])

  let RING_PRIME_IDEAL ← prove
   r"!r a:A.
        ring_prime r a <=>
        a IN ring_carrier r /\ ~(a = ring_0 r) /\
        prime_ideal r (ideal_generated r {a})"
   (MESON_TAC [ring_prime, PRIME_IDEAL_SING])

  let PROPER_IDEAL_IDEAL_GENERATED_SING ← prove
   r"!r a:A.
        a IN ring_carrier r
        ==> (proper_ideal r (ideal_generated r {a}) <=> ~(ring_unit r a))"
   (SIMP_TAC [PROPER_IDEAL_ALT, RING_IDEAL_IDEAL_GENERATED] THEN
    SIMP_TAC [IDEAL_GENERATED_SING_EQ_CARRIER])

  let MAXIMAL_CONTAINING_IDEAL_EXISTS ← prove
   r"!r a:A. a IN ring_carrier r /\ ~(ring_unit r a)
           ==> ?j. maximal_ideal r j /\ a IN j"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "ideal_generated r {a:A}"]
      MAXIMAL_SUPERIDEAL_EXISTS) THEN
    ASM_SIMP_TAC [PROPER_IDEAL_IDEAL_GENERATED_SING] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"j:A->bool") THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"a IN p ==> p SUBSET j ==> a IN j")) THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_INC, IN_SING, SING_SUBSET])

  let UNIONS_MAXIMAL_IDEALS ← prove
   r"!r:A ring.
        UNIONS {j | maximal_ideal r j} =
        {x | x IN ring_carrier r /\ ~(ring_unit r x)}"
   (GEN_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET] THEN
    REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM] THEN CONJ_TAC THENL
     [REWRITE_TAC [maximal_ideal, PROPER_IDEAL_UNIT, ring_ideal] THEN
      GEN_TAC THEN DISCH_THEN (MP_TAC o CONJUNCT1) THEN SET_TAC [],
      SIMP_TAC [← GSYM PROPER_IDEAL_IDEAL_GENERATED_SING, IMP_CONJ] THEN
      X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
      DISCH_THEN (MP_TAC o MATCH_MP MAXIMAL_SUPERIDEAL_EXISTS) THEN
      MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [SUBSET] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_INC_GEN, IN_SING]])

  let UNIONS_PROPER_IDEALS ← prove
   r"!r:A ring.
        UNIONS {j | proper_ideal r j} =
        {x | x IN ring_carrier r /\ ~(ring_unit r x)}"
   (GEN_TAC THEN REWRITE_TAC [← GSYM UNIONS_MAXIMAL_IDEALS] THEN MATCH_MP_TAC
     (← SET_RULE (← q r"(!s. P s ==> Q s) /\ (!s. Q s ==> ?s'. P s' /\ s SUBSET s')
              ==> UNIONS {x | Q x} = UNIONS {x | P x}")) THEN
    REWRITE_TAC [MAXIMAL_IMP_PROPER_IDEAL, MAXIMAL_SUPERIDEAL_EXISTS])

  let UNIONS_PRIME_IDEALS ← prove
   r"!r:A ring.
        UNIONS {j | prime_ideal r j} =
        {x | x IN ring_carrier r /\ ~(ring_unit r x)}"
   (GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [← GSYM UNIONS_PROPER_IDEALS],
      REWRITE_TAC [← GSYM UNIONS_MAXIMAL_IDEALS]] THEN
    MATCH_MP_TAC SUBSET_UNIONS THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    REWRITE_TAC [MAXIMAL_IMP_PRIME_IDEAL, PRIME_IMP_PROPER_IDEAL])

  let PROPER_IDEAL_NONUNITS ← prove
   r"!r:A ring.
        proper_ideal r {x | x IN ring_carrier r /\ ~(ring_unit r x)} <=>
        ring_ideal r {x | x IN ring_carrier r /\ ~(ring_unit r x)}"
   (GEN_TAC THEN
    REWRITE_TAC [proper_ideal, ← TAUT (← q r"(p /\ q <=> p) <=> p ==> q")] THEN
    DISCH_TAC THEN REWRITE_TAC [PSUBSET_ALT, SUBSET_RESTRICT] THEN
    EXISTS_TAC (← q "ring_1 r:A") THEN REWRITE_TAC [RING_1, IN_ELIM_THM, RING_UNIT_1])

  let MAXIMAL_IDEAL_NONUNITS ← prove
   r"!r:A ring.
        maximal_ideal r {x | x IN ring_carrier r /\ ~(ring_unit r x)} <=>
        ring_ideal r {x | x IN ring_carrier r /\ ~(ring_unit r x)}"
   (GEN_TAC THEN REWRITE_TAC [maximal_ideal, PROPER_IDEAL_NONUNITS] THEN
    REWRITE_TAC [← TAUT (← q r"(p /\ q <=> p) <=> p ==> q")] THEN DISCH_TAC THEN
    REWRITE_TAC [← GSYM UNIONS_PROPER_IDEALS] THEN SET_TAC [])

  let PRIME_IDEAL_NONUNITS ← prove
   r"!r:A ring.
        prime_ideal r {x | x IN ring_carrier r /\ ~(ring_unit r x)} <=>
        ring_ideal r {x | x IN ring_carrier r /\ ~(ring_unit r x)}"
   (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [PRIME_IMP_RING_IDEAL] THEN
    REWRITE_TAC [← GSYM MAXIMAL_IDEAL_NONUNITS, MAXIMAL_IMP_PRIME_IDEAL])

  let RING_IDEAL_NONUNITS ← prove
   r"!r:A ring.
        ring_ideal r {x | x IN ring_carrier r /\ ~(ring_unit r x)} <=>
        ~trivial_ring r /\
        !x y. x IN ring_carrier r /\ ~(ring_unit r x) /\
              y IN ring_carrier r /\ ~(ring_unit r y)
              ==> ~(ring_unit r (ring_add r x y))"
   (GEN_TAC THEN REWRITE_TAC [ring_ideal] THEN
    SIMP_TAC [IN_ELIM_THM, SUBSET_RESTRICT, RING_UNIT_NEG_EQ, RING_NEG,
              RING_UNIT_MUL_EQ, RING_MUL, RING_ADD, RING_0] THEN
    REWRITE_TAC [CONJ_ACI, RING_UNIT_0])

  let RING_IRREDUCIBLE_IMP_MAXIMAL_PRINCIPAL_IDEAL ← prove
   r"!r p:A.
        ring_irreducible r p
        ==> proper_ideal r (ideal_generated r {p}) /\
            ~(?j. principal_ideal r j /\
                  proper_ideal r j /\
                  ideal_generated r {p} PSUBSET j)"
   (REWRITE_TAC [ring_irreducible] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [PROPER_IDEAL_IDEAL_GENERATED_SING] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [principal_ideal]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "a:A")
     (CONJUNCTS_THEN2 ASSUME_TAC (SUBST_ALL_TAC o SYM))) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [PSUBSET]) THEN
    ASM_SIMP_TAC [SUBSET_IDEALS_GENERATED_SING, IDEALS_GENERATED_SING_EQ] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_divides]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "u:A") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "a:A", ← q "u:A"]) THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [RING_ASSOCIATES_RMUL, PROPER_IDEAL_IDEAL_GENERATED_SING])

  let RING_IRREDUCIBLE_EQ_MAXIMAL_PRINCIPAL_IDEAL ← prove
   r"!r p:A.
        integral_domain r
        ==> (ring_irreducible r p <=>
             p IN ring_carrier r /\ ~(p = ring_0 r) /\
             proper_ideal r (ideal_generated r {p}) /\
             ~(?j. principal_ideal r j /\
                   proper_ideal r j /\
                   ideal_generated r {p} PSUBSET j))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q "(p:A) IN ring_carrier r") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [ring_irreducible]] THEN
    ASM_CASES_TAC (← q "p:A = ring_0 r") THENL
     [ASM_MESON_TAC [ring_irreducible], ASM_REWRITE_TAC []] THEN
    EQ_TAC THEN REWRITE_TAC [RING_IRREDUCIBLE_IMP_MAXIMAL_PRINCIPAL_IDEAL] THEN
    ASM_SIMP_TAC [PROPER_IDEAL_IDEAL_GENERATED_SING, NOT_EXISTS_THM] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [INTEGRAL_DOMAIN_IRREDUCIBLE_ALT] THEN
    X_GEN_TAC (← q "d:A") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "ideal_generated r {d:A}")) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP RING_DIVIDES_IN_CARRIER) THEN
    REWRITE_TAC [PRINCIPAL_IDEAL_IDEAL_GENERATED_SING] THEN
    ASM_SIMP_TAC [PROPER_IDEAL_IDEAL_GENERATED_SING, DE_MORGAN_THM] THEN
    ASM_SIMP_TAC [PSUBSET, SUBSET_IDEALS_GENERATED_SING] THEN
    ASM_SIMP_TAC [IDEALS_GENERATED_SING_EQ])

  let MAXIMAL_IDEAL_SING_IMP_IRREDUCIBLE ← prove
   r"!r p:A.
        integral_domain r /\
        p IN ring_carrier r /\ ~(p = ring_0 r) /\
        maximal_ideal r (ideal_generated r {p})
        ==> ring_irreducible r p"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP MAXIMAL_IMP_PRIME_IDEAL) THEN
    ASM_SIMP_TAC [PRIME_IDEAL_SING])

  let RING_IRREDUCIBLE_EQ_MAXIMAL_IDEAL ← prove
   r"!r p:A.
        PID r
        ==> (ring_irreducible r p <=>
             p IN ring_carrier r /\ ~(p = ring_0 r) /\
             maximal_ideal r (ideal_generated r {p}))"
   (SIMP_TAC [PID, RING_IRREDUCIBLE_EQ_MAXIMAL_PRINCIPAL_IDEAL] THEN
    REWRITE_TAC [maximal_ideal] THEN MESON_TAC [proper_ideal])

  let MAXIMAL_IDEAL_SING ← prove
   r"!r p:A.
        PID r
        ==> (maximal_ideal r (ideal_generated r {p}) <=>
             if ~(p IN ring_carrier r) \/ p = ring_0 r then field r
             else ring_irreducible r p)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q "(p:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THENL
     [COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IDEAL_GENERATED_0, MAXIMAL_IDEAL_0] THEN
      ASM_SIMP_TAC [RING_IRREDUCIBLE_EQ_MAXIMAL_IDEAL],
      ONCE_REWRITE_TAC [IDEAL_GENERATED_RESTRICT] THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_EMPTY, ← SET_RULE
        (← q r"~(p IN s) ==> s INTER {p} = {}")] THEN
      REWRITE_TAC [MAXIMAL_IDEAL_0]])

  let PID_IRREDUCIBLE_EQ_PRIME ← prove
   r"!r p:A. PID r ==> (ring_irreducible r p <=> ring_prime r p)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [PID, INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE]] THEN
    ASM_SIMP_TAC [RING_IRREDUCIBLE_EQ_MAXIMAL_IDEAL, RING_PRIME_IDEAL] THEN
    SIMP_TAC [MAXIMAL_IMP_PRIME_IDEAL])

  let FIELD_EQ_TRIVIAL_IDEALS ← prove
   r"!r:A ring.
        field r <=>
        ~(trivial_ring r) /\
        !j. ring_ideal r j ==> j = {ring_0 r} \/ j = ring_carrier r"
   (GEN_TAC THEN REWRITE_TAC [← GSYM MAXIMAL_IDEAL_0, maximal_ideal] THEN
    REWRITE_TAC [PROPER_IDEAL_0, NOT_EXISTS_THM] THEN AP_TERM_TAC THEN
    REWRITE_TAC [proper_ideal, ← TAUT (← q r"~((p /\ q) /\ r) <=> p ==> ~r \/ ~q")] THEN
    SIMP_TAC [PSUBSET, RING_IDEAL_IMP_SUBSET, SING_SUBSET, IN_RING_IDEAL_0] THEN
    MESON_TAC [])

  let FIELD_EQ_TRIVIAL_IDEALS_EQ ← prove
   r"!r:A ring.
        field r <=>
        ~(trivial_ring r) /\
        !j. ring_ideal r j <=> j = {ring_0 r} \/ j = ring_carrier r"
   (REWRITE_TAC [FIELD_EQ_TRIVIAL_IDEALS] THEN
    MESON_TAC [RING_IDEAL_CARRIER, RING_IDEAL_0])

  let FIELD_EQ_NO_PROPER_IDEALS ← prove
   r"!r:A ring. field r <=>
               ~(trivial_ring r) /\
               !j. proper_ideal r j ==> j = {ring_0 r}"
   (REWRITE_TAC [proper_ideal, FIELD_EQ_TRIVIAL_IDEALS, PSUBSET] THEN
    MESON_TAC [RING_IDEAL_IMP_SUBSET])

  let FIELD_EQ_NO_PROPER_IDEALS_EQ ← prove
   r"!r:A ring. field r <=>
               ~(trivial_ring r) /\
               !j. proper_ideal r j <=> j = {ring_0 r}"
   (REWRITE_TAC [FIELD_EQ_NO_PROPER_IDEALS] THEN MESON_TAC [PROPER_IDEAL_0])

  let FIELD_EQ_PROPER_IMP_MAXIMAL_IDEAL ← prove
   r"!r:A ring. field r <=>
               ~(trivial_ring r) /\
               !j. proper_ideal r j ==> maximal_ideal r j"
   (MESON_TAC [FIELD_EQ_NO_PROPER_IDEALS, PROPER_IDEAL_0, MAXIMAL_IDEAL_0])

  let FIELD_EQ_PROPER_IMP_PRIME_IDEAL ← prove
   r"!r:A ring. field r <=>
               ~(trivial_ring r) /\
               !j. proper_ideal r j ==> prime_ideal r j"
   (GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [FIELD_EQ_PROPER_IMP_MAXIMAL_IDEAL, MAXIMAL_IMP_PRIME_IDEAL],
      STRIP_TAC THEN ASM_SIMP_TAC [FIELD_EQ_ALL_UNITS, ← GSYM TRIVIAL_RING_10]] THEN
    X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q "ideal_generated r {ring_pow r (a:A) 2}")) THEN
    REWRITE_TAC [← TAUT (← q r"(p ==> q) ==> r <=> (~p ==> r) /\ (q ==> r)")] THEN
    ASM_SIMP_TAC [PROPER_IDEAL_IDEAL_GENERATED_SING, RING_POW] THEN
    ASM_SIMP_TAC [RING_UNIT_POW_EQ, ARITH_EQ] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q "r:A ring", ← q "ideal_generated r {ring_pow r (a:A) 2}", ← q "a:A", ← q "2"]
     RING_POW_IN_PRIME_IDEAL) THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_INC_GEN, IN_SING, RING_POW, ARITH_EQ] THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_SING_ALT, RING_POW, IN_ELIM_THM, ring_unit] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "b:A") THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC INTEGRAL_DOMAIN_MUL_LCANCEL THEN
    MAP_EVERY EXISTS_TAC [← q "r:A ring", ← q "a:A"] THEN ASM_REWRITE_TAC [RING_1] THEN
    ASM_SIMP_TAC [RING_MUL_ASSOC, RING_MUL, ← GSYM RING_POW_2, RING_MUL_RID] THEN
    ASM_MESON_TAC [PRIME_IDEAL_0, PROPER_IDEAL_0])

  let FIELD_IMP_PID ← prove
   r"!r:A ring. field r ==> PID r"
   (GEN_TAC THEN SIMP_TAC [PID, FIELD_IMP_INTEGRAL_DOMAIN] THEN
    REWRITE_TAC [FIELD_EQ_TRIVIAL_IDEALS] THEN
    MESON_TAC [PRINCIPAL_IDEAL_0, PRINCIPAL_IDEAL_CARRIER])

  let FIELD_IMP_NOETHERIAN_RING ← prove
   r"!r:A ring. field r ==> noetherian_ring r"
   (SIMP_TAC [FIELD_IMP_PID, PID_IMP_NOETHERIAN_RING])

  let PID_MAXIMAL_EQ_PRIME_IDEAL ← prove
   r"!r j:A->bool.
        PID r /\ ~(j = {ring_0 r})
        ==> (maximal_ideal r j <=> prime_ideal r j)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_CASES_TAC (← q r"principal_ideal r (j:A->bool)") THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [principal_ideal]),
      ASM_MESON_TAC [PID, maximal_ideal, prime_ideal, proper_ideal]] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q "a:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
    ASM_REWRITE_TAC [IDEAL_GENERATED_EQ_0] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [MAXIMAL_IDEAL_SING, PRIME_IDEAL_SING,
                  PID_IMP_INTEGRAL_DOMAIN] THEN
    ASM_SIMP_TAC [PID_IRREDUCIBLE_EQ_PRIME])

  let PID_EQ_INTEGRAL_DOMAIN_PRIME_PRINCIPAL ← prove
   r"!r:A ring. PID r <=>
              integral_domain r /\
              (!j. prime_ideal r j ==> principal_ideal r j)"
   (← do
    -- right to left: the SET_RULEs (last first), the TAUTs, then the MESON
    let s7 ← SET_RULE
     (← q r"ideal_generated r (a INSERT k) = s
      ==> (a INSERT k) SUBSET ideal_generated r (a INSERT k) /\
          s INTER k SUBSET t
          ==> k SUBSET t")
    let s6 ← SET_RULE
     (← q r"{x | P x /\ f x IN k} = s ==> d IN s ==> f d IN k")
    let s5 ← SET_RULE (← q r"a IN s ==> s INTER {a} = {a}")
    let s4 ← SET_RULE (← q r"s SUBSET a INSERT s")
    let t3 ← TAUT (← q r"(p /\ ~q) /\ r ==> s <=> p /\ r /\ ~s ==> q")
    let t2 ← TAUT (← q r"p \/ q <=> ~(~p /\ ~q)")
    let m1 ← MESON [] (← q r"(!x. P x ==> Q x) <=> ~(?x. P x /\ ~Q x)")
    pure (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [PID, PRIME_IMP_RING_IDEAL],
      STRIP_TAC THEN ASM_REWRITE_TAC [PID]] THEN
    GEN_REWRITE_TAC id [m1] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"\j:A->bool. ring_ideal r j /\ ~principal_ideal r j")
     ZL_SUBSETS_UNIONS_NONEMPTY) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [MEMBER_NOT_EMPTY, PROPER_IDEAL] THEN
      SIMP_TAC [RING_IDEAL_UNIONS] THEN
      X_GEN_TAC (← q r"c:(A->bool)->bool") THEN STRIP_TAC THEN
      REWRITE_TAC [principal_ideal] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "a:A") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q "a:A") o GEN_REWRITE_RULE id [EXTENSION]) THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_INC_GEN, IN_SING, IN_UNIONS] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"i:A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q "ideal_generated r {a:A} = i") MP_TAC THENL
       [MATCH_MP_TAC SUBSET_ANTISYM, ASM_MESON_TAC [principal_ideal]] THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_MINIMAL_EQ] THEN ASM SET_TAC [],
      REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"k:A->bool") THEN
      FIRST_X_ASSUM ((fun (_ : thm) => ALL_TAC) o check (fun th => is_exists (concl th)))] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN
    ASM_REWRITE_TAC [CONTRAPOS_THM] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [prime_ideal, NONPRINCIPAL_IMP_PROPER_IDEAL] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [t2] THEN STRIP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [t3]) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q "ideal_generated r ((a:A) INSERT k)")) THEN
    REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED, NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q "(a:A) INSERT k") THEN
      REWRITE_TAC [s4] THEN
      MATCH_MP_TAC IDEAL_GENERATED_SUBSET_CARRIER_SUBSET THEN
      ASM_SIMP_TAC [INSERT_SUBSET, RING_IDEAL_IMP_SUBSET],
      GEN_REWRITE_TAC RAND_CONV [EXTENSION] THEN
      DISCH_THEN (MP_TAC o SPEC (← q "a:A")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC IDEAL_GENERATED_INC_GEN THEN
      ASM_REWRITE_TAC [IN_INSERT],
      REWRITE_TAC [principal_ideal] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "c:A") (STRIP_ASSUME_TAC o GSYM))] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"{x:A | x IN ring_carrier r /\ ring_mul r x a IN k}")) THEN
    ASM_SIMP_TAC [RING_IDEAL_QUOTIENT_RMUL, NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      ASM_MESON_TAC [IN_RING_IDEAL_RMUL, SUBSET, RING_IDEAL_IMP_SUBSET],
      GEN_REWRITE_TAC RAND_CONV [EXTENSION] THEN
      DISCH_THEN (MP_TAC o SPEC (← q "b:A")) THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      ASM_MESON_TAC [RING_MUL_SYM],
      REWRITE_TAC [principal_ideal] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "d:A") (STRIP_ASSUME_TAC o GSYM))] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [principal_ideal]) THEN
    REWRITE_TAC [] THEN EXISTS_TAC (← q "ring_mul r c d:A") THEN
    ASM_SIMP_TAC [RING_MUL, ← GSYM SUBSET_ANTISYM_EQ, IDEAL_GENERATED_MINIMAL_EQ,
                  SING_SUBSET, s5] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o
       GEN_REWRITE_RULE LAND_CONV [IDEAL_GENERATED_INSERT]) THEN
      REWRITE_TAC [EXTENSION] THEN DISCH_THEN (MP_TAC o SPEC (← q "c:A")) THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_INC_GEN, IN_SING] THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_RING_IDEAL, IDEAL_GENERATED_SING_ALT] THEN
      SPEC_TAC (← q "c:A", ← q "c:A") THEN
      UNDISCH_THEN (← q "(c:A) IN ring_carrier r") (fun (_ : thm) => ALL_TAC) THEN
      REWRITE_TAC [ring_setadd, FORALL_IN_GSPEC, IMP_CONJ,
                   RIGHT_FORALL_IMP_THM] THEN
      X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN X_GEN_TAC (← q "y:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q "(y:A) IN ring_carrier r") ASSUME_TAC THENL
       [ASM_MESON_TAC [RING_IDEAL_IMP_SUBSET, SUBSET], ALL_TAC] THEN
      ASM_SIMP_TAC [RING_ADD_RDISTRIB, RING_MUL] THEN
      MATCH_MP_TAC IN_RING_IDEAL_ADD THEN
      ASM_SIMP_TAC [IN_RING_IDEAL_RMUL] THEN
      SUBGOAL_THEN
       (← q "ring_mul r (ring_mul r a x) d:A = ring_mul r x (ring_mul r d a)")
      SUBST1_TAC THENL [ASM_SIMP_TAC [RING_MUL_AC], ALL_TAC] THEN
      MATCH_MP_TAC IN_RING_IDEAL_LMUL THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s6) THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_INC_GEN, IN_SING],
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP s7) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC IDEAL_GENERATED_SUBSET_CARRIER_SUBSET THEN
        ASM_SIMP_TAC [INSERT_SUBSET, RING_IDEAL_IMP_SUBSET],
        ASM_SIMP_TAC [IDEAL_GENERATED_SING_ALT]] THEN
      REWRITE_TAC [SUBSET, IN_INTER, IMP_CONJ, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q "u:A") THEN REPEAT DISCH_TAC THEN
      ASM_SIMP_TAC [← GSYM RING_SETMUL_IDEAL_GENERATED_SING] THEN
      MATCH_MP_TAC RING_MUL_IN_SETMUL THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_INC_GEN, IN_SING] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      MATCH_MP_TAC RING_MULTIPLE_IN_IDEAL THEN
      MAP_EVERY EXISTS_TAC [← q "r:A ring", ← q "ring_mul r u c:A"] THEN
      ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [RING_MUL_SYM], ALL_TAC] THEN
      MATCH_MP_TAC RING_DIVIDES_MUL2 THEN ASM_REWRITE_TAC [RING_DIVIDES_REFL] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "a:A") o GEN_REWRITE_RULE id [EXTENSION]) THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_INC_GEN, IN_INSERT] THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_SING, IN_ELIM_THM]]))

  let TRIVIAL_QUOTIENT_RING ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> (trivial_ring (quotient_ring r j) <=> ~proper_ideal r j)"
   (SIMP_TAC [TRIVIAL_RING_10, QUOTIENT_RING] THEN
    SIMP_TAC [RING_COSET_EQ, RING_0, RING_1, PROPER_IDEAL] THEN
    SIMP_TAC [RING_SUB_RZERO, RING_1])

  let INTEGRAL_DOMAIN_QUOTIENT_RING ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> (integral_domain(quotient_ring r j) <=> prime_ideal r j)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [integral_domain] THEN
    ASM_SIMP_TAC [← CONJUNCT1 QUOTIENT_RING] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [QUOTIENT_RING_0] THEN
    ASM_SIMP_TAC [← match (CONJUNCTS QUOTIENT_RING)[2]? with
      | some t => pure t | none => throw "tl"] THEN
    ASM_SIMP_TAC [RING_COSET_EQ_IDEAL, QUOTIENT_RING_MUL, RING_MUL, RING_1] THEN
    ASM_REWRITE_TAC [prime_ideal, PROPER_IDEAL] THEN MESON_TAC [])

  let FIELD_QUOTIENT_RING ← prove
   r"!r j:A->bool.
        ring_ideal r j ==> (field(quotient_ring r j) <=> maximal_ideal r j)"
   (← do
    -- right to left: the basic_ss, the second MESON, the two SET_RULEs
    -- (second first), the TAUT, then the first MESON
    let ss ← ExceptT.mk (basic_ss [])
    let m5 ← MESON []
     (← q r"x IN j /\
        ring_add r a (ring_add r x (ring_neg r a)) = x
        ==> (ring_add r a (ring_add r x (ring_neg r a))) IN j")
    let s4 ← SET_RULE (← q r"x IN s ==> s SUBSET t ==> x IN t")
    let s3 ← SET_RULE (← q r"~(a IN j) ==> a IN s ==> ~(j = s)")
    let t2 ← TAUT (← q r"q /\ (~p ==> r) ==> ~(p /\ q) ==> r")
    let m1 ← MESON [] (← q r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")
    let qr2 ← match (CONJUNCTS QUOTIENT_RING)[2]? with
      | some t => pure t | none => throw "tl"
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [field] THEN
    ASM_SIMP_TAC [← CONJUNCT1 QUOTIENT_RING] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM,
                 FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN
    ASM_SIMP_TAC [QUOTIENT_RING_0] THEN
    ONCE_REWRITE_TAC [m1] THEN
    ASM_SIMP_TAC [qr2] THEN
    ASM_SIMP_TAC [RING_COSET_EQ_IDEAL, QUOTIENT_RING_MUL, RING_MUL, RING_1,
                  RING_COSET_EQ] THEN
    ASM_CASES_TAC (← q "(ring_1 r:A) IN j") THEN
    ASM_REWRITE_TAC [maximal_ideal, PROPER_IDEAL, NOT_FORALL_THM, NOT_IMP,
                     NOT_EXISTS_THM, IMP_IMP] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"k:A->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
          GEN_REWRITE_RULE id [PSUBSET_ALT]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "a:A") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "a:A")) THEN
      SUBGOAL_THEN (← q "(a:A) IN ring_carrier r") ASSUME_TAC THENL
       [ASM_MESON_TAC [SUBSET, RING_IDEAL_IMP_SUBSET],
        ASM_REWRITE_TAC [NOT_EXISTS_THM]] THEN
      X_GEN_TAC (← q "b:A") THEN STRIP_TAC THEN
       UNDISCH_TAC (← q "~((ring_1 r:A) IN k)") THEN
      SUBGOAL_THEN
       (← q r"ring_1 r:A =
      ring_sub r (ring_mul r a b) (ring_sub r (ring_mul r a b) (ring_1 r))")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [ring_sub, RING_NEG_ADD, RING_NEG_NEG, RING_1, RING_MUL,
          RING_ADD, RING_NEG, RING_ADD_ASSOC, RING_ADD_RNEG, RING_ADD_LZERO],
        REWRITE_TAC [] THEN MATCH_MP_TAC IN_RING_IDEAL_SUB THEN
        ASM_MESON_TAC [SUBSET, ring_ideal, RING_MUL_SYM]],
      X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q "ring_setadd r j (ideal_generated r {a:A})")) THEN
      ASM_SIMP_TAC [RING_IDEAL_SETADD, RING_IDEAL_IDEAL_GENERATED,
                    SING_SUBSET] THEN
      MATCH_MP_TAC t2 THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [PSUBSET, RING_SETADD_SUPERSET_LEFT, IN_RING_IDEAL_0,
                      RING_IDEAL_IMP_SUBSET, RING_IDEAL_IDEAL_GENERATED] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s3) THEN
        wPart rand (fun t => do rand (← rand t)) RING_SETADD_SUPERSET_RIGHT THEN
        ASM_SIMP_TAC [IN_RING_IDEAL_0, IDEAL_GENERATED_SUBSET, SING_SUBSET] THEN
        MATCH_MP_TAC s4 THEN
        ASM_SIMP_TAC [IDEAL_GENERATED_INC, IN_SING, SING_SUBSET],
        ASM_SIMP_TAC [ring_setadd, IDEAL_GENERATED_SING_ALT] THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_AND_EXISTS_THM] THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A", ← q "z:A"] THEN
        STRIP_TAC THEN EXISTS_TAC (← q "z:A") THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q "(x:A) IN ring_carrier r") ASSUME_TAC THENL
         [ASM_MESON_TAC [ring_ideal, SUBSET], ALL_TAC] THEN
        ASM_SIMP_TAC [ring_sub, RING_NEG_ADD, RING_MUL] THEN
        MATCH_MP_TAC m5 THEN
        ASM_SIMP_TAC [IN_RING_IDEAL_NEG] THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC RING_LNEG_UNIQUE THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [RING_ADD, RING_NEG, RING_MUL], ALL_TAC] THEN
        ASM_SIMP_TAC [← GSYM RING_NEG_ADD, RING_MUL,
                      RING_ADD, RING_MUL, RING_NEG] THEN
        ASM (simpTac ss 4)
         [RING_ADD_ASSOC, RING_MUL, RING_NEG, RING_ADD, RING_ADD_RNEG]]]))

  let PRIME_IDEAL_CORRESPONDENCE ← prove
   r"!r r' (f:A->B) j k.
           ring_epimorphism (r,r') f /\
           ring_ideal r' k /\
           {x | x IN ring_carrier r /\ f x IN k} = j
        ==> (prime_ideal r j <=> prime_ideal r' k)"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "r':B ring", ← q r"f:A->B"]
      RING_IDEAL_HOMOMORPHIC_PREIMAGE) THEN
    ASM_SIMP_TAC [← GSYM INTEGRAL_DOMAIN_QUOTIENT_RING,
                  RING_EPIMORPHISM_IMP_HOMOMORPHISM] THEN
    DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
    MATCH_MP_TAC ISOMORPHIC_RING_INTEGRAL_DOMAINNESS THEN
    MATCH_MP_TAC FIRST_RING_ISOMORPHISM_THEOREM_GEN THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_REWRITE_TAC [])

  let PRIME_IDEAL_ISOMORPHIC_IMAGE_EQ ← prove
   r"!r r' (f:A->B) j.
        ring_isomorphism(r,r') f /\ j SUBSET ring_carrier r
        ==> (prime_ideal r' (IMAGE f j) <=> prime_ideal r j)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_IDEAL_ISOMORPHIC_IMAGE_EQ) THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> p) /\ (q' ==> p') /\ (p' ==> (q' <=> q))
    ==> (p' <=> p) ==> (q' <=> q)")) THEN
    REWRITE_TAC [PRIME_IMP_RING_IDEAL] THEN DISCH_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC PRIME_IDEAL_CORRESPONDENCE THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_SIMP_TAC [RING_ISOMORPHISM_IMP_EPIMORPHISM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_isomorphism, ring_isomorphisms]) THEN
    ASM SET_TAC [])

  let MAXIMAL_IDEAL_CORRESPONDENCE ← prove
   r"!r r' (f:A->B) j k.
           ring_epimorphism (r,r') f /\
           ring_ideal r' k /\
           {x | x IN ring_carrier r /\ f x IN k} = j
        ==> (maximal_ideal r j <=> maximal_ideal r' k)"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "r':B ring", ← q r"f:A->B"]
      RING_IDEAL_HOMOMORPHIC_PREIMAGE) THEN
    ASM_SIMP_TAC [← GSYM FIELD_QUOTIENT_RING,
                  RING_EPIMORPHISM_IMP_HOMOMORPHISM] THEN
    DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
    MATCH_MP_TAC ISOMORPHIC_RING_FIELDNESS THEN
    MATCH_MP_TAC FIRST_RING_ISOMORPHISM_THEOREM_GEN THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_REWRITE_TAC [])

  let MAXIMAL_IDEAL_EPIMORPHIC_PREIMAGE ← prove
   r"!r r' (f:A->B) j.
        ring_epimorphism(r,r') f /\ maximal_ideal r' j
        ==> maximal_ideal r {x | x IN ring_carrier r /\ f x IN j}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP MAXIMAL_IMP_RING_IDEAL) THEN
    UNDISCH_TAC (← q r"maximal_ideal r' (j:B->bool)") THEN
    MATCH_MP_TAC EQ_IMP THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC MAXIMAL_IDEAL_CORRESPONDENCE THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_REWRITE_TAC [])

  let MAXIMAL_IDEAL_ISOMORPHIC_IMAGE_EQ ← prove
   r"!r r' (f:A->B) j.
        ring_isomorphism(r,r') f /\ j SUBSET ring_carrier r
        ==> (maximal_ideal r' (IMAGE f j) <=> maximal_ideal r j)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_IDEAL_ISOMORPHIC_IMAGE_EQ) THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> p) /\ (q' ==> p') /\ (p' ==> (q' <=> q))
    ==> (p' <=> p) ==> (q' <=> q)")) THEN
    REWRITE_TAC [MAXIMAL_IMP_RING_IDEAL] THEN DISCH_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC MAXIMAL_IDEAL_CORRESPONDENCE THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_SIMP_TAC [RING_ISOMORPHISM_IMP_EPIMORPHISM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_isomorphism, ring_isomorphisms]) THEN
    ASM SET_TAC [])

  let ISOMORPHIC_RING_PIDNESS ← prove
   r"!(r:A ring) (r':B ring).
        r isomorphic_ring r' ==> (PID r <=> PID r')"
   (← do
    let lemma ← prove
     r"!(r:A ring) (r':B ring).
        r isomorphic_ring r' ==> PID r ==> PID r'"
     (REPEAT GEN_TAC THEN DISCH_TAC THEN
      REWRITE_TAC [PID] THEN MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [ASM_MESON_TAC [ISOMORPHIC_RING_INTEGRAL_DOMAINNESS], ALL_TAC] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"k:B->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"f:A->B") MP_TAC o
        REWRITE_RULE [isomorphic_ring]) THEN
      REWRITE_TAC [ring_isomorphism, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"g:B->A") THEN REWRITE_TAC [RING_ISOMORPHISMS_ISOMORPHISM] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (g:B->A) k")) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [RING_IDEAL_EPIMORPHIC_IMAGE,
                       RING_ISOMORPHISM_IMP_EPIMORPHISM],
        REWRITE_TAC [principal_ideal]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "a:A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(f:A->B) a") THEN CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [RING_ISOMORPHISM]) THEN ASM SET_TAC [],
        ONCE_REWRITE_TAC [← SET_RULE (← q r"{f a} = IMAGE f {a}")]] THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q "r':B ring", ← q r"f:A->B"]
          IDEAL_GENERATED_BY_EPIMORPHIC_IMAGE) THEN
      ASM_SIMP_TAC [SING_SUBSET, RING_ISOMORPHISM_IMP_EPIMORPHISM] THEN
      DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP RING_IDEAL_IMP_SUBSET) THEN ASM SET_TAC [])
    pure (REPEAT STRIP_TAC THEN EQ_TAC THEN MATCH_MP_TAC lemma THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [ISOMORPHIC_RING_SYM] THEN
      ASM_REWRITE_TAC []))

  let FIELD_HOMOMORPHISM_IMP_MONOMORPHISM ← prove
   r"!r r' (f:A->B).
        ring_homomorphism(r,r') f /\ field r
        ==> (!x. x IN ring_carrier r ==> f x = ring_0 r') \/
            ring_monomorphism(r,r') f"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [RING_MONOMORPHISM] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"ring_kernel(r,r') (f:A->B)") o
      CONJUNCT2 o GEN_REWRITE_RULE id [FIELD_EQ_TRIVIAL_IDEALS]) THEN
    ASM_SIMP_TAC [RING_IDEAL_RING_KERNEL] THEN
    REWRITE_TAC [ring_kernel] THEN SET_TAC [])

  let FIELD_EPIMORPHISM_IMP_ISOMORPHISM ← prove
   r"!r r' (f:A->B).
        ring_epimorphism(r,r') f /\ field r
        ==> (!x. x IN ring_carrier r ==> f x = ring_0 r') \/
            ring_isomorphism(r,r') f"
   (SIMP_TAC [← GSYM RING_MONOMORPHISM_EPIMORPHISM] THEN
    MESON_TAC [FIELD_HOMOMORPHISM_IMP_MONOMORPHISM,
               RING_EPIMORPHISM_IMP_HOMOMORPHISM])

  let RING_EPIMORPHISM_ONTO_FIELD_EXISTS ← prove
   r"!r:A ring.
        ~(trivial_ring r)
        ==> ?s (f:A->A->bool). ring_epimorphism(r,s) f /\ field s"
   (GEN_TAC THEN REWRITE_TAC [← GSYM MAXIMAL_IDEAL_EXISTS] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"j:A->bool")) THEN
    EXISTS_TAC (← q r"quotient_ring r (j:A->bool)") THEN
    EXISTS_TAC (← q r"ring_coset r (j:A->bool)") THEN
    ASM_SIMP_TAC [FIELD_QUOTIENT_RING, MAXIMAL_IMP_RING_IDEAL,
                  RING_EPIMORPHISM_RING_COSET])

  let FIELD_RING_HOMOMORPHISM_MONOMORPHISM ← prove
   r"!(k:A ring) (l:B ring) (h:A->B).
        field k /\ ring_homomorphism(k,l) h /\ ~(trivial_ring l)
        ==> ring_monomorphism(k,l) h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "k:A ring", ← q "l:B ring", ← q r"h:A->B"]
      FIELD_HOMOMORPHISM_IMP_MONOMORPHISM) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (DISJ_CASES_THEN2 ASSUME_TAC ACCEPT_TAC) THEN
    ASM_MESON_TAC [RING_HOMOMORPHISM_1, RING_1, TRIVIAL_RING_10])

  -- @@RETURN BEGIN
  return { proper_ideal, principal_ideal, finitely_generated_ideal, prime_ideal,
           maximal_ideal, PID, noetherian_ring, PROPER_IMP_RING_IDEAL,
           PROPER_IDEAL_IMP_SUBSET, PROPER_IDEAL_IMP_PSUBSET, PRINCIPAL_IMP_RING_IDEAL,
           PRINCIPAL_IDEAL_IMP_SUBSET, FINITELY_GENERATED_IMP_RING_IDEAL,
           FINITELY_GENERATED_IDEAL_IMP_SUBSET, FINITELY_GENERATED_IDEAL_SUBSET,
           PRIME_IMP_PROPER_IDEAL, PRIME_IMP_RING_IDEAL, PRIME_IDEAL_IMP_SUBSET,
           PRIME_IDEAL_IMP_PSUBSET, MAXIMAL_IMP_PROPER_IDEAL, MAXIMAL_IMP_RING_IDEAL,
           MAXIMAL_IDEAL_IMP_SUBSET, MAXIMAL_IDEAL_IMP_PSUBSET, PROPER_IDEAL_0,
           PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL, PID_IMP_INTEGRAL_DOMAIN,
           PID_IMP_NOETHERIAN_RING, PRINCIPAL_IDEAL_ALT,
           PRINCIPAL_IDEAL_IDEAL_GENERATED_SING, PRINCIPAL_IDEAL_0,
           FINITELY_GENERATED_IDEAL_0, PRINCIPAL_IDEAL_CARRIER,
           FINITELY_GENERATED_IDEAL_CARRIER, PROPER_IDEAL_ALT,
           NONPRINCIPAL_IMP_PROPER_IDEAL, NONFINITELY_GENERATED_IMP_PROPER_IDEAL,
           FINITELY_GENERATED_IDEAL_ALT, FINITELY_GENERATED_IDEAL_GENERATED,
           FINITELY_GENERATED_IDEAL_SETADD, PROPER_IDEAL, PROPER_IDEAL_UNIT,
           PROPER_IDEAL_SUBSET_NONUNITS, PROPER_IDEAL_UNIONS, PROPER_IDEAL_EXISTS,
           FINITELY_GENERATED_IDEAL_EPIMORPHIC_IMAGE, PRINCIPAL_IDEAL_EPIMORPHIC_IMAGE,
           FINITELY_GENERATED_IDEAL_LOCALIZATION, PRINCIPAL_IDEAL_LOCALIZATION,
           PROPER_IDEAL_HOMOMORPHIC_PREIMAGE, PROPER_IDEAL_CORRESPONDENCE,
           PROPER_IDEAL_ISOMORPHIC_IMAGE_EQ, PRIME_IDEAL_HOMOMORPHIC_PREIMAGE,
           RING_1_NOT_IN_PRIME_IDEAL, RING_UNIT_NOT_IN_PRIME_IDEAL,
           RING_MUL_IN_PRIME_IDEAL, RING_POW_IN_PRIME_IDEAL, MAXIMAL_SUPERIDEAL_EXISTS,
           MAXIMAL_IDEAL_EXISTS, RING_MULTSYS_NONPRIME, RING_MULTSYS_NONPRIME_EQ,
           RING_SATURATED_MULTSYS_NONPRIME, MAXIMAL_EXCLUDING_IMP_PRIME_IDEAL,
           MAXIMAL_IMP_PRIME_IDEAL, MAXIMAL_AMONG_PRIME_IDEALS, PRIME_IDEAL_0,
           MAXIMAL_IDEAL_0, PRIME_SUPERIDEAL_EXISTS, PRIME_IDEAL_EXISTS,
           PRIME_SUPERIDEAL_EXCLUDING_EXISTS, PRIME_IDEAL_EXCLUDING_EXISTS,
           MAXIMAL_NONFG_IMP_PRIME_IDEAL, PRIME_IDEAL_SING, RING_PRIME_IDEAL,
           PROPER_IDEAL_IDEAL_GENERATED_SING, MAXIMAL_CONTAINING_IDEAL_EXISTS,
           UNIONS_MAXIMAL_IDEALS, UNIONS_PROPER_IDEALS, UNIONS_PRIME_IDEALS,
           PROPER_IDEAL_NONUNITS, MAXIMAL_IDEAL_NONUNITS, PRIME_IDEAL_NONUNITS,
           RING_IDEAL_NONUNITS, RING_IRREDUCIBLE_IMP_MAXIMAL_PRINCIPAL_IDEAL,
           RING_IRREDUCIBLE_EQ_MAXIMAL_PRINCIPAL_IDEAL,
           MAXIMAL_IDEAL_SING_IMP_IRREDUCIBLE, RING_IRREDUCIBLE_EQ_MAXIMAL_IDEAL,
           MAXIMAL_IDEAL_SING, PID_IRREDUCIBLE_EQ_PRIME, FIELD_EQ_TRIVIAL_IDEALS,
           FIELD_EQ_TRIVIAL_IDEALS_EQ, FIELD_EQ_NO_PROPER_IDEALS,
           FIELD_EQ_NO_PROPER_IDEALS_EQ, FIELD_EQ_PROPER_IMP_MAXIMAL_IDEAL,
           FIELD_EQ_PROPER_IMP_PRIME_IDEAL, FIELD_IMP_PID, FIELD_IMP_NOETHERIAN_RING,
           PID_MAXIMAL_EQ_PRIME_IDEAL, PID_EQ_INTEGRAL_DOMAIN_PRIME_PRINCIPAL,
           TRIVIAL_QUOTIENT_RING, INTEGRAL_DOMAIN_QUOTIENT_RING, FIELD_QUOTIENT_RING,
           PRIME_IDEAL_CORRESPONDENCE, PRIME_IDEAL_ISOMORPHIC_IMAGE_EQ,
           MAXIMAL_IDEAL_CORRESPONDENCE, MAXIMAL_IDEAL_EPIMORPHIC_PREIMAGE,
           MAXIMAL_IDEAL_ISOMORPHIC_IMAGE_EQ, ISOMORPHIC_RING_PIDNESS,
           FIELD_HOMOMORPHISM_IMP_MONOMORPHISM, FIELD_EPIMORPHISM_IMP_ISOMORPHISM,
           RING_EPIMORPHISM_ONTO_FIELD_EXISTS, FIELD_RING_HOMOMORPHISM_MONOMORPHISM }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The radical ideal and in particular the nilradical.                       -/
/- (ringtheory.ml 12764-13006)                                               -/
/- ------------------------------------------------------------------------- -/

structure Radical where
  -- @@FIELDS
  radical : thm
  RADICAL_SUBSET : thm
  RADICAL_MONO : thm
  RING_IDEAL_RADICAL : thm
  RADICAL_0 : thm
  RADICAL_RING_CARRIER : thm
  RADICAL_ALT : thm
  RING_POW_IN_RADICAL : thm
  INTEGRAL_DOMAIN_NILRADICAL : thm
  FIELD_NILRADICAL : thm
  RADICAL : thm
  RING_NILRADICAL : thm
  INTERS_PRIME_IDEALS : thm
  RADICAL_RADICAL : thm
  RADICAL_EQ_CARRIER : thm
  PROPER_RADICAL : thm
  RADICAL_UNIONS : thm
  RADICAL_UNION : thm
  RADICAL_INTER : thm
  RADICAL_SETADD : thm
  COMAXIMAL_RADICALS : thm
  RADICAL_PRIME_IDEAL : thm
  RADICAL_SUBSET_PRIME_IDEAL_EQ : thm
  RADICAL_IDEAL_PRIME_IDEAL_EQ : thm
  PRIME_IDEAL_CONTAINS_NILPOTENTS : thm
  RING_NILPOTENT_ADD : thm
  RING_NILPOTENT_LMUL : thm
  RING_NILPOTENT_RMUL : thm
  RING_NILPOTENT_SUB : thm
  RING_NILPOTENT_SUM : thm
  RING_ZERODIVISOR_NILPOTENT_CLAUSES : thm
  RING_REGULAR_NILPOTENT_CLAUSES : thm
  RING_UNIT_NILPOTENT_CLAUSES_1 : thm
  RING_UNIT_NILPOTENT_CLAUSES : thm
  RING_NILPOTENT_UNIT : thm
  UNIQUE_PRIME_IDEAL : thm
  deriving Inhabited

@[nospecialize]
def setupRadical [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BRingRule : RingRule) (BSquarefree : Squarefree) (BSpecialIdeals : SpecialIdeals) :
    ExceptT String IO Radical := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, NUM_REDUCE_CONV,
        SET_RULE, SET_TAC, new_definition, .. } := D
  let { ADD_EQ_0, ARITH, .. } := D.core1
  let { CONTRAPOS_THM, EXISTS_UNIQUE_UNIONS_INTERS, EXTENSION, .. } := D.core2
  let { FINITE_INDUCT_STRONG, FINITE_NUMSEG_LT, FORALL_IN_INSERT, .. } := D.core3
  let { IMP_CONJ, INTERS_GSPEC, .. } := D.core4
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_SING, LEFT_IMP_EXISTS_THM, LE_0, .. } := D.core5
  let { LT_REFL, MONO_EXISTS, MULT_CLAUSES, MULT_EQ_0, MULT_SYM, NOT_EXISTS_THM,
        NOT_FORALL_THM, NUMSEG_CLAUSES_LT, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, SING_GSPEC, SING_SUBSET, SUBSET, SUBSET_ANTISYM,
        SUBSET_ANTISYM_EQ, SUBSET_TRANS, UNIONS_GSPEC, .. } := D.core7
  let { num_INDUCTION, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_LDISTRIB, RING_ADD_SYM, RING_MUL,
        RING_MUL_LID, RING_MUL_LZERO, RING_MUL_RZERO, RING_MUL_SYM, RING_NEG, RING_SUB,
        RING_SUB_REFL, ring_sub, trivial_ring, .. } := BBasics
  let { RING_MUL_POW, RING_OF_NUM, RING_POW, RING_POW_1, RING_POW_ADD, RING_POW_MUL,
        RING_POW_NEG, RING_POW_ONE, ring_pow, .. } := BNumbers
  let { RING_BINOMIAL_THEOREM, RING_SUM, RING_SUM_CLAUSES, .. } := BSums
  let { RING_NILPOTENT_0, RING_NILPOTENT_IN_CARRIER, RING_NILPOTENT_NEG,
        RING_REGULAR_IN_CARRIER, RING_REGULAR_NEG, RING_UNIT_0, RING_UNIT_1,
        RING_UNIT_MUL, RING_UNIT_MUL_EQ, RING_UNIT_NEG, RING_UNIT_NEG_EQ,
        RING_ZERODIVISOR_IN_CARRIER, RING_ZERODIVISOR_NEG, ring_nilpotent,
        ring_regular, ring_unit, ring_zerodivisor, .. } := BDivides
  let { IN_RING_IDEAL_0, IN_RING_IDEAL_LMUL, IN_RING_IDEAL_NEG, IN_RING_IDEAL_RMUL,
        IN_RING_IDEAL_SUM, RING_IDEAL_0, RING_IDEAL_EQ_CARRIER, RING_IDEAL_IMP_SUBSET,
        RING_IDEAL_INTER, RING_IDEAL_SETADD, RING_POW_IN_IDEAL, RING_SETADD_MONO,
        RING_SETADD_SUBRING, RING_SETADD_SUPERSET_LEFT, RING_SETADD_SUPERSET_RIGHT,
        ring_ideal, .. } := BIdeals
  let { FIELD_IMP_INTEGRAL_DOMAIN, INTEGRAL_DOMAIN_NILPOTENT, .. } := BDomains
  let { RING_RULE, RING_TAC, .. } := BRingRule
  let { RING_MULTSYS_POWERS, .. } := BSquarefree
  let { PRIME_IDEAL_EXISTS, PRIME_IDEAL_IMP_SUBSET, PRIME_IMP_RING_IDEAL,
        PRIME_SUPERIDEAL_EXCLUDING_EXISTS, PRIME_SUPERIDEAL_EXISTS, PROPER_IDEAL,
        PROPER_IDEAL_ALT, RING_POW_IN_PRIME_IDEAL, UNIONS_PRIME_IDEALS, .. } := BSpecialIdeals
  -- @@SCOPE END

  let radical ← new_definition
   r"radical r j = {x:A | x IN ring_carrier r /\
                       ?n. ~(n = 0) /\ ring_pow r x n IN j}"

  let RADICAL_SUBSET ← prove
   r"!r j:A->bool. j SUBSET radical r j <=> j SUBSET ring_carrier r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [radical] THEN
    EQ_TAC THENL [SET_TAC [], REWRITE_TAC [SUBSET, IN_ELIM_THM]] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [] THEN EXISTS_TAC (← q "1") THEN
    ASM_SIMP_TAC [RING_POW_1] THEN CONV_TAC NUM_REDUCE_CONV)

  let RADICAL_MONO ← prove
   r"!r j k:A->bool. j SUBSET k ==> radical r j SUBSET radical r k"
   (REWRITE_TAC [radical] THEN SET_TAC [])

  let RING_IDEAL_RADICAL ← prove
   r"!r j:A->bool. ring_ideal r j ==> ring_ideal r (radical r j)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ring_ideal, radical, SUBSET] THEN
    SIMP_TAC [IN_ELIM_THM, RING_0] THEN REPEAT CONJ_TAC THENL
     [EXISTS_TAC (← q "1") THEN CONV_TAC NUM_REDUCE_CONV THEN
      ASM_SIMP_TAC [RING_POW_1, RING_0, IN_RING_IDEAL_0],
      X_GEN_TAC (← q "x:A") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_SIMP_TAC [RING_NEG] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM_SIMP_TAC [RING_POW_NEG] THEN ASM_MESON_TAC [IN_RING_IDEAL_NEG],
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
      DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q "n:num") THEN STRIP_TAC THEN X_GEN_TAC (← q "m:num") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [RING_ADD] THEN EXISTS_TAC (← q "m + n:num") THEN
      ASM_SIMP_TAC [RING_BINOMIAL_THEOREM, ADD_EQ_0] THEN
      MATCH_MP_TAC IN_RING_IDEAL_SUM THEN ASM_REWRITE_TAC [IN_NUMSEG, LE_0] THEN
      X_GEN_TAC (← q "k:num") THEN DISCH_TAC THEN MATCH_MP_TAC IN_RING_IDEAL_LMUL THEN
      ASM_REWRITE_TAC [RING_OF_NUM] THEN
      FIRST_X_ASSUM (DISJ_CASES_THEN SUBST1_TAC o MATCH_MP (← ARITH_RULE
       (← q r"k:num <= m + n ==> k = m + (k - m) \/ (m + n) - k = n + (m - k)")))
      THENL
       [MATCH_MP_TAC IN_RING_IDEAL_RMUL, MATCH_MP_TAC IN_RING_IDEAL_LMUL] THEN
      ASM_SIMP_TAC [RING_POW] THEN ASM_SIMP_TAC [RING_POW_ADD] THEN
      MATCH_MP_TAC IN_RING_IDEAL_RMUL THEN ASM_SIMP_TAC [RING_POW],
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_SIMP_TAC [RING_MUL] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM_SIMP_TAC [RING_MUL_POW] THEN
      ASM_MESON_TAC [IN_RING_IDEAL_LMUL, RING_POW]])

  let RADICAL_0 ← prove
   r"!r:A ring. radical r {ring_0 r} = {x | ring_nilpotent r x}"
   (GEN_TAC THEN REWRITE_TAC [radical, ring_nilpotent, IN_SING])

  let RADICAL_RING_CARRIER ← prove
   r"!r:A ring. radical r (ring_carrier r) = ring_carrier r"
   (REWRITE_TAC [radical, EXTENSION, IN_ELIM_THM] THEN
    MESON_TAC [← ARITH_RULE (← q "~(1 = 0)"), RING_POW])

  let RADICAL_ALT ← prove
   r"!r j:A->bool.
      ring_ideal r j
      ==> radical r j = {x | x IN ring_carrier r /\ ?n. ring_pow r x n IN j}"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"j:A->bool = ring_carrier r") THENL
     [ASM_REWRITE_TAC [RADICAL_RING_CARRIER, EXTENSION, IN_ELIM_THM] THEN
      MESON_TAC [RING_POW],
      REWRITE_TAC [radical]] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q "x:A") THEN
    ASM_CASES_TAC (← q "(x:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"~P 0 ==> ((?n. ~(n = 0) /\ P n) <=> (?n. P n))")) THEN
    REWRITE_TAC [ring_pow] THEN ASM_MESON_TAC [PROPER_IDEAL, PROPER_IDEAL_ALT])

  let RING_POW_IN_RADICAL ← prove
   r"!r j (x:A) n.
        ring_ideal r j /\ x IN ring_carrier r /\ ~(n = 0)
        ==> (ring_pow r x n IN radical r j <=> x IN radical r j)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [RADICAL_ALT, IN_ELIM_THM, RING_POW] THEN
    ASM_SIMP_TAC [← GSYM RING_POW_MUL] THEN
    EQ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "m:num") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [MULT_SYM] THEN ASM_SIMP_TAC [RING_POW_MUL] THEN
    ASM_SIMP_TAC [RING_POW_IN_IDEAL])

  let INTEGRAL_DOMAIN_NILRADICAL ← prove
   r"!r:A ring. integral_domain r ==> radical r {ring_0 r} = {ring_0 r}"
   (SIMP_TAC [INTEGRAL_DOMAIN_NILPOTENT, RADICAL_0, SING_GSPEC])

  let FIELD_NILRADICAL ← prove
   r"!r:A ring. field r ==> radical r {ring_0 r} = {ring_0 r}"
   (SIMP_TAC [INTEGRAL_DOMAIN_NILRADICAL, FIELD_IMP_INTEGRAL_DOMAIN])

  let RADICAL ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> radical r j = if j = ring_carrier r then ring_carrier r
                          else INTERS {k | prime_ideal r k /\ j SUBSET k}"
   (← do
    let s3 ← SET_RULE
     (← q r"DISJOINT k {f n | n IN (:num)} ==> ~(f 1 IN k)")
    let t2 ← TAUT (← q r"(~p ==> r) /\ ~q ==> (p ==> q) ==> r")
    let t1 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [RADICAL_RING_CARRIER] THEN
    ASM_SIMP_TAC [RADICAL_ALT, EXTENSION, IN_ELIM_THM, INTERS_GSPEC] THEN
    X_GEN_TAC (← q "x:A") THEN EQ_TAC THENL
     [ASM_MESON_TAC [RING_POW_IN_PRIME_IDEAL, SUBSET], DISCH_TAC] THEN
    MATCH_MP_TAC t1 THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q "r:A ring", ← q r"j:A->bool"] PRIME_SUPERIDEAL_EXISTS) THEN
      ASM_REWRITE_TAC [PROPER_IDEAL_ALT] THEN
      ASM_MESON_TAC [PRIME_IDEAL_IMP_SUBSET, SUBSET],
      DISCH_TAC] THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q r"{ring_pow r (x:A) n | n IN (:num)}",
                   ← q r"j:A->bool"] PRIME_SUPERIDEAL_EXCLUDING_EXISTS) THEN
    ASM_SIMP_TAC [RING_MULTSYS_POWERS] THEN
    MATCH_MP_TAC t2 THEN
    CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP s3) THEN
    ASM_SIMP_TAC [RING_POW_1]))

  let RING_NILRADICAL ← prove
   r"!r:A ring.
        radical r {ring_0 r} =
        if trivial_ring r then {ring_0 r}
        else INTERS {j | prime_ideal r j}"
   (GEN_TAC THEN SIMP_TAC [RADICAL, RING_IDEAL_0] THEN
    ASM_CASES_TAC (← q "trivial_ring(r:A ring)") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [trivial_ring]) THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM, SING_SUBSET] THEN
    MESON_TAC [IN_RING_IDEAL_0, PRIME_IMP_RING_IDEAL])

  let INTERS_PRIME_IDEALS ← prove
   r"!r:A ring.
    ~(trivial_ring r) ==> INTERS {j | prime_ideal r j} = radical r {ring_0 r}"
   (SIMP_TAC [RING_NILRADICAL])

  let RADICAL_RADICAL ← prove
   r"!r j:A->bool. radical r (radical r j) = radical r j"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EXTENSION, radical, IN_ELIM_THM] THEN
    X_GEN_TAC (← q "a:A") THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THEN ASM_SIMP_TAC [RING_POW] THEN
    ASM_SIMP_TAC [RIGHT_AND_EXISTS_THM, ← GSYM RING_POW_MUL] THEN
    EQ_TAC THEN DISCH_THEN (X_CHOOSE_TAC (← q "n:num")) THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q "m:num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q "n * m:num") THEN ASM_SIMP_TAC [MULT_EQ_0],
      MAP_EVERY EXISTS_TAC [← q "1", ← q "n:num"] THEN
      ASM_REWRITE_TAC [MULT_CLAUSES, ARITH]])

  let RADICAL_EQ_CARRIER ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> (radical r j = ring_carrier r <=> j = ring_carrier r)"
   (SIMP_TAC [RING_IDEAL_EQ_CARRIER, RING_IDEAL_RADICAL] THEN
    SIMP_TAC [RADICAL_ALT, IN_ELIM_THM, RING_POW_ONE, RING_1])

  let PROPER_RADICAL ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> (proper_ideal r (radical r j) <=> proper_ideal r j)"
   (SIMP_TAC [PROPER_IDEAL_ALT, RADICAL_EQ_CARRIER,
              RING_IDEAL_RADICAL])

  let RADICAL_UNIONS ← prove
   r"!r u:(A->bool)->bool.
        radical r (UNIONS u) = UNIONS {radical r j | j IN u}"
   (REWRITE_TAC [radical, UNIONS_GSPEC] THEN SET_TAC [])

  let RADICAL_UNION ← prove
   r"!r j k:A->bool.
        radical r (j UNION k) = radical r j UNION radical r k"
   (REWRITE_TAC [radical] THEN SET_TAC [])

  let RADICAL_INTER ← prove
   r"!r j k:A->bool.
        ring_ideal r j /\ ring_ideal r k
        ==> radical r (j INTER k) = radical r j INTER radical r k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [RADICAL_ALT, RING_IDEAL_INTER] THEN
    CONJ_TAC THENL [SET_TAC [], REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INTER]] THEN
    X_GEN_TAC (← q "x:A") THEN ASM_CASES_TAC (← q "(x:A) IN ring_carrier r") THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_TAC (← q "m:num")) (X_CHOOSE_TAC (← q "n:num"))) THEN
    EXISTS_TAC (← q "m + n:num") THEN
    ASM_SIMP_TAC [RING_POW_ADD, IN_RING_IDEAL_LMUL, IN_RING_IDEAL_RMUL,
                  RING_POW])

  let RADICAL_SETADD ← prove
   r"!r j k:A->bool.
        ring_ideal r j /\ ring_ideal r k
        ==> radical r (ring_setadd r (radical r j) (radical r k)) =
            radical r (ring_setadd r j k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC RAND_CONV [← GSYM RADICAL_RADICAL] THEN
      MATCH_MP_TAC RADICAL_MONO THEN
      wPart rand (fun t => do rand (← rand t)) RING_SETADD_SUBRING THEN
      ASM_SIMP_TAC [RING_IDEAL_RADICAL, RING_IDEAL_SETADD] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC RING_SETADD_MONO THEN
      CONJ_TAC THEN MATCH_MP_TAC RADICAL_MONO THENL
       [MATCH_MP_TAC RING_SETADD_SUPERSET_LEFT,
        MATCH_MP_TAC RING_SETADD_SUPERSET_RIGHT] THEN
      ASM_SIMP_TAC [RING_IDEAL_IMP_SUBSET, IN_RING_IDEAL_0],
      MATCH_MP_TAC RADICAL_MONO THEN
      MATCH_MP_TAC RING_SETADD_MONO THEN
      ASM_SIMP_TAC [RADICAL_SUBSET, RING_IDEAL_IMP_SUBSET]])

  let COMAXIMAL_RADICALS ← prove
   r"!r j k:A->bool.
        ring_ideal r j /\ ring_ideal r k
        ==> (ring_setadd r (radical r j) (radical r k) = ring_carrier r <=>
             ring_setadd r j k = ring_carrier r)"
   (REPEAT STRIP_TAC THEN
    wPart rand (fun t => do rand (← rand t)) RADICAL_EQ_CARRIER THEN
    ASM_SIMP_TAC [RING_IDEAL_SETADD] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    wPart lhand (fun t => do rand (← rand t)) RADICAL_EQ_CARRIER THEN
    ASM_SIMP_TAC [RING_IDEAL_SETADD, RING_IDEAL_RADICAL] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_SIMP_TAC [RADICAL_SETADD])

  let RADICAL_PRIME_IDEAL ← prove
   r"!r j:A->bool. prime_ideal r j ==> radical r j = j"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP PRIME_IDEAL_IMP_SUBSET) THEN
    ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, RADICAL_SUBSET] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, radical] THEN
    ASM_SIMP_TAC [IMP_CONJ, RING_POW_IN_PRIME_IDEAL] THEN MESON_TAC [])

  let RADICAL_SUBSET_PRIME_IDEAL_EQ ← prove
   r"!r j k:A->bool.
        j SUBSET ring_carrier r /\ prime_ideal r k
        ==> (radical r j SUBSET k <=> j SUBSET k)"
   (MESON_TAC [RADICAL_PRIME_IDEAL, RADICAL_SUBSET, SUBSET_TRANS, RADICAL_MONO])

  let RADICAL_IDEAL_PRIME_IDEAL_EQ ← prove
   r"!r j k:A->bool.
        ring_ideal r j /\ prime_ideal r k
        ==> (radical r j SUBSET k <=> j SUBSET k)"
   (SIMP_TAC [RADICAL_SUBSET_PRIME_IDEAL_EQ, RING_IDEAL_IMP_SUBSET])

  let PRIME_IDEAL_CONTAINS_NILPOTENTS ← prove
   r"!r j:A->bool. prime_ideal r j ==> {x | ring_nilpotent r x} SUBSET j"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM RADICAL_0] THEN
    ASM_SIMP_TAC [RADICAL_SUBSET_PRIME_IDEAL_EQ, SING_SUBSET, RING_0] THEN
    ASM_MESON_TAC [IN_RING_IDEAL_0, PRIME_IMP_RING_IDEAL])

  -- More closure properties for nilpotents etc. (ringtheory.ml 13006-13194)

  let RING_NILPOTENT_ADD ← prove
   r"!r x y:A.
        ring_nilpotent r x /\ ring_nilpotent r y
        ==> ring_nilpotent r (ring_add r x y)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← MATCH_MP RING_IDEAL_RADICAL (← SPEC (← q "r:A ring") RING_IDEAL_0)) THEN
    REWRITE_TAC [RADICAL_0, ring_ideal] THEN SET_TAC [])

  let RING_NILPOTENT_LMUL ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ ring_nilpotent r y
        ==> ring_nilpotent r (ring_mul r x y)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← MATCH_MP RING_IDEAL_RADICAL (← SPEC (← q "r:A ring") RING_IDEAL_0)) THEN
    REWRITE_TAC [RADICAL_0, ring_ideal] THEN SET_TAC [])

  let RING_NILPOTENT_RMUL ← prove
   r"!r x y:A.
        ring_nilpotent r x /\ y IN ring_carrier r
        ==> ring_nilpotent r (ring_mul r x y)"
   (MESON_TAC [RING_NILPOTENT_LMUL, RING_MUL_SYM, RING_NILPOTENT_IN_CARRIER])

  let RING_NILPOTENT_SUB ← prove
   r"!r x y:A.
        ring_nilpotent r x /\ ring_nilpotent r y
        ==> ring_nilpotent r (ring_sub r x y)"
   (SIMP_TAC [ring_sub, RING_NILPOTENT_ADD, RING_NILPOTENT_NEG])

  let RING_NILPOTENT_SUM ← prove
   r"!(r:A ring) (f:K->A) s.
        FINITE s /\ (!i. i IN s ==> ring_nilpotent r (f i))
        ==> ring_nilpotent r (ring_sum r s f)"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [RING_SUM_CLAUSES, FORALL_IN_INSERT, RING_NILPOTENT_0] THEN
    MESON_TAC [RING_NILPOTENT_ADD, ring_nilpotent])

  let RING_ZERODIVISOR_NILPOTENT_CLAUSES ← prove
   r"(!r w z:A.
        ring_zerodivisor r w /\ ring_nilpotent r z
        ==> ring_zerodivisor r (ring_add r w z)) /\
   (!r w z:A.
        ring_nilpotent r z /\ ring_zerodivisor r w
        ==> ring_zerodivisor r (ring_add r z w)) /\
   (!r w z:A.
        ring_zerodivisor r w /\ ring_nilpotent r z
        ==> ring_zerodivisor r (ring_sub r w z)) /\
   (!r w z:A.
        ring_nilpotent r z /\ ring_zerodivisor r w
        ==> ring_zerodivisor r (ring_sub r z w))"
   (← do
    let t2 ← TAUT (← q r"p <=> ~p ==> F")
    let t1 ← TAUT
     (← q r"(p ==> q) /\ (p /\ q ==> r /\ s) /\ p ==> p /\ q /\ r /\ s")
    pure (MATCH_MP_TAC t1 THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [RING_ADD_SYM, RING_NILPOTENT_IN_CARRIER,
                 RING_ZERODIVISOR_IN_CARRIER],
      SIMP_TAC [ring_sub, RING_ZERODIVISOR_NEG, RING_NILPOTENT_NEG],
      MAP_EVERY X_GEN_TAC [← q "r:A ring", ← q "x:A", ← q "z:A"] THEN STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_ZERODIVISOR_IN_CARRIER) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_NILPOTENT_IN_CARRIER)] THEN
    ASM_SIMP_TAC [ring_zerodivisor, RING_ADD] THEN
    GEN_REWRITE_TAC id [t2] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_zerodivisor]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "w:A") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!n. ~(ring_mul r (ring_pow r z n) w:A = ring_0 r)")
    MP_TAC THENL
     [MATCH_MP_TAC num_INDUCTION THEN ASM_SIMP_TAC [ring_pow, RING_MUL_LID] THEN
      X_GEN_TAC (← q "n:num") THEN REWRITE_TAC [CONTRAPOS_THM] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "ring_mul r w (ring_pow r z n):A") o
                    REWRITE_RULE [NOT_EXISTS_THM]) THEN
      ASM_SIMP_TAC [RING_MUL, RING_POW] THEN
      FIRST_ASSUM (MP_TAC o SYM) THEN RING_TAC,
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_nilpotent]) THEN
      ASM_REWRITE_TAC [NOT_FORALL_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM_SIMP_TAC [RING_MUL_LZERO]]))

  let RING_REGULAR_NILPOTENT_CLAUSES ← prove
   r"(!r w z:A.
        ring_regular r w /\ ring_nilpotent r z
        ==> ring_regular r (ring_add r w z)) /\
   (!r w z:A.
        ring_nilpotent r z /\ ring_regular r w
        ==> ring_regular r (ring_add r z w)) /\
   (!r w z:A.
        ring_regular r w /\ ring_nilpotent r z
        ==> ring_regular r (ring_sub r w z)) /\
   (!r w z:A.
        ring_nilpotent r z /\ ring_regular r w
        ==> ring_regular r (ring_sub r z w))"
   (MATCH_MP_TAC (← TAUT
     (← q r"(p ==> q) /\ (p /\ q ==> r /\ s) /\ p ==> p /\ q /\ r /\ s")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [RING_ADD_SYM, RING_NILPOTENT_IN_CARRIER,
                 RING_REGULAR_IN_CARRIER],
      SIMP_TAC [ring_sub, RING_REGULAR_NEG, RING_NILPOTENT_NEG],
      MAP_EVERY X_GEN_TAC [← q "r:A ring", ← q "x:A", ← q "z:A"] THEN STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_REGULAR_IN_CARRIER) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_NILPOTENT_IN_CARRIER)] THEN
    UNDISCH_TAC (← q "ring_regular r (x:A)") THEN
    ASM_SIMP_TAC [ring_regular, RING_ADD, CONTRAPOS_THM] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q "x:A = ring_sub r (ring_add r x z) z") SUBST1_TAC THENL
     [RING_TAC, ASM_SIMP_TAC [RING_ZERODIVISOR_NILPOTENT_CLAUSES]])

  let RING_UNIT_NILPOTENT_CLAUSES_1 ← prove
   r"(!r z:A. ring_nilpotent r z ==> ring_unit r (ring_add r (ring_1 r) z)) /\
   (!r z:A. ring_nilpotent r z ==> ring_unit r (ring_add r z (ring_1 r))) /\
   (!r z:A. ring_nilpotent r z ==> ring_unit r (ring_sub r (ring_1 r) z)) /\
   (!r z:A. ring_nilpotent r z ==> ring_unit r (ring_sub r z (ring_1 r)))"
   (← do
    -- right to left: the last RING_RULE first, then the next, the TAUT and
    -- the first RING_RULE
    let rr4 ← RING_RULE (← q r"ring_1 r = ring_sub r (ring_1 r) (ring_0 r)")
    let rr3 ← RING_RULE
     (← q r"z IN ring_carrier r
     ==> ring_add r (ring_1 r) z = ring_sub r (ring_1 r) (ring_neg r z)")
    let t2 ← TAUT (← q r"(q ==> p) /\ q ==> p /\ p /\ q")
    let rr1 ← RING_RULE
     (← q r"z IN ring_carrier r
     ==> ring_add r z (ring_1 r) = ring_add r (ring_1 r) z /\
         ring_sub r z (ring_1 r) = ring_neg r (ring_sub r (ring_1 r) z)")
    pure (SIMP_TAC [RING_NILPOTENT_IN_CARRIER, rr1] THEN
    SIMP_TAC [RING_UNIT_NEG_EQ, RING_SUB, RING_1, RING_NILPOTENT_IN_CARRIER] THEN
    MATCH_MP_TAC t2 THEN
    SIMP_TAC [RING_NILPOTENT_IN_CARRIER, RING_NILPOTENT_NEG, rr3] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [ring_nilpotent, ring_unit] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q "n:num") STRIP_ASSUME_TAC)) THEN
    ASM_SIMP_TAC [RING_SUB, RING_1] THEN
    EXISTS_TAC (← q r"ring_sum r {i | i < n} (\i. ring_pow r z i):A") THEN
    REWRITE_TAC [RING_SUM] THEN
    GEN_REWRITE_TAC RAND_CONV [rr4] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← SYM th])) THEN
    UNDISCH_THEN (← q "~(n = 0)") (fun (_ : thm) => ALL_TAC) THEN
    SPEC_TAC (← q "n:num", ← q "k:num") THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [NUMSEG_CLAUSES_LT] THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES, FINITE_NUMSEG_LT] THEN
    ASM_SIMP_TAC [ring_pow, RING_SUB_REFL, RING_MUL_RZERO, RING_SUB, RING_1,
                  IN_ELIM_THM, LT_REFL, RING_POW] THEN
    ASM_SIMP_TAC [RING_ADD_LDISTRIB, RING_MUL, RING_SUB, RING_1, RING_SUM,
                  RING_POW] THEN
    RING_TAC THEN REWRITE_TAC [RING_SUM]))

  let RING_UNIT_NILPOTENT_CLAUSES ← prove
   r"(!r u z:A. ring_unit r u /\ ring_nilpotent r z
              ==> ring_unit r (ring_add r u z)) /\
   (!r u z:A. ring_nilpotent r z /\ ring_unit r u
              ==> ring_unit r (ring_add r z u)) /\
   (!r u z:A. ring_unit r u /\ ring_nilpotent r z
              ==> ring_unit r (ring_sub r u z)) /\
   (!r u z:A. ring_nilpotent r z /\ ring_unit r u
              ==> ring_unit r (ring_sub r z u))"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_unit]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q "v:A") STRIP_ASSUME_TAC)) THEN
    MP_TAC (← RING_RULE
     (← q r"u IN ring_carrier r /\ v IN ring_carrier r /\ z IN ring_carrier r /\
    ring_mul r u v:A = ring_1 r
    ==> ring_add r u z =
        ring_mul r u (ring_add r (ring_1 r) (ring_mul r v z)) /\
        ring_add r z u =
        ring_mul r u (ring_add r (ring_1 r) (ring_mul r v z)) /\
        ring_sub r u z =
        ring_mul r u (ring_sub r (ring_1 r) (ring_mul r v z)) /\
        ring_sub r z u =
        ring_mul r u (ring_neg r
           (ring_sub r (ring_1 r) (ring_mul r v z)))")) THEN
    ASM_SIMP_TAC [RING_NILPOTENT_IN_CARRIER] THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
    MATCH_MP_TAC RING_UNIT_MUL THEN
    ASM_SIMP_TAC [RING_UNIT_NILPOTENT_CLAUSES_1, RING_UNIT_NEG,
                  RING_NILPOTENT_NEG, RING_NILPOTENT_LMUL] THEN
    ASM_MESON_TAC [RING_UNIT_MUL_EQ, RING_UNIT_1])

  let RING_NILPOTENT_UNIT ← prove
   r"!r x:A. ring_unit r x /\ ring_nilpotent r x <=>
           trivial_ring r /\ x = ring_0 r"
   (MESON_TAC [RING_SUB_REFL, RING_UNIT_0, ring_unit, RING_UNIT_NILPOTENT_CLAUSES,
               RING_NILPOTENT_0, RING_UNIT_0, trivial_ring, IN_SING, RING_0])

  let UNIQUE_PRIME_IDEAL ← prove
   r"!r:A ring.
        (?!j. prime_ideal r j) <=>
        ~(trivial_ring r) /\
        !x. x IN ring_carrier r ==> ring_unit r x \/ ring_nilpotent r x"
   (GEN_TAC THEN ASM_CASES_TAC (← q "trivial_ring(r:A ring)") THENL
     [ASM_MESON_TAC [PRIME_IDEAL_EXISTS],
      REWRITE_TAC [EXISTS_UNIQUE_UNIONS_INTERS]] THEN
    ASM_SIMP_TAC [UNIONS_PRIME_IDEALS, INTERS_PRIME_IDEALS, RADICAL_0] THEN
    ASM SET_TAC [RING_NILPOTENT_UNIT, ring_unit, ring_nilpotent])

  -- @@RETURN BEGIN
  return { radical, RADICAL_SUBSET, RADICAL_MONO, RING_IDEAL_RADICAL, RADICAL_0,
           RADICAL_RING_CARRIER, RADICAL_ALT, RING_POW_IN_RADICAL,
           INTEGRAL_DOMAIN_NILRADICAL, FIELD_NILRADICAL, RADICAL, RING_NILRADICAL,
           INTERS_PRIME_IDEALS, RADICAL_RADICAL, RADICAL_EQ_CARRIER, PROPER_RADICAL,
           RADICAL_UNIONS, RADICAL_UNION, RADICAL_INTER, RADICAL_SETADD,
           COMAXIMAL_RADICALS, RADICAL_PRIME_IDEAL, RADICAL_SUBSET_PRIME_IDEAL_EQ,
           RADICAL_IDEAL_PRIME_IDEAL_EQ, PRIME_IDEAL_CONTAINS_NILPOTENTS,
           RING_NILPOTENT_ADD, RING_NILPOTENT_LMUL, RING_NILPOTENT_RMUL,
           RING_NILPOTENT_SUB, RING_NILPOTENT_SUM, RING_ZERODIVISOR_NILPOTENT_CLAUSES,
           RING_REGULAR_NILPOTENT_CLAUSES, RING_UNIT_NILPOTENT_CLAUSES_1,
           RING_UNIT_NILPOTENT_CLAUSES, RING_NILPOTENT_UNIT, UNIQUE_PRIME_IDEAL }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- UFDs.  (ringtheory.ml 13197-14177)                                        -/
/- ------------------------------------------------------------------------- -/

structure UFDs where
  -- @@FIELDS
  UFD : thm
  UFD_IMP_INTEGRAL_DOMAIN : thm
  PID_IMP_UFD : thm
  FIELD_IMP_UFD : thm
  ISOMORPHIC_RING_UFDNESS : thm
  UFD_EQ_PRIMEFACT : thm
  UFD_EQ_PRIMEFACT_NONUNIT : thm
  UFD_PRIME_FACTOR_EXISTS : thm
  UFD_IRREDUCIBLE_EQ_PRIME : thm
  UFD_EQ_ATOMIC : thm
  UFD_EQ_ATOMIC_NONUNIT : thm
  UFD_EQ_UNIQUE_FACTORIZATION : thm
  UFD_COPRIME : thm
  UFD_PRIME_FACTOR_INDUCT : thm
  UFD_IMP_GCD_EXISTS : thm
  PID_EQ_UFD_PRIME_MAXIMAL : thm
  RING_DIVIDES_LOCALEQUIV : thm
  UFD_LOCALIZATION : thm
  PROPER_IDEAL_LOCALIZATION : thm
  RING_LOCALEQUIV_IN_LOCALIZED_IDEAL : thm
  PRIME_IDEAL_LOCALIZATION_CONTRACTION : thm
  PRIME_IDEAL_LOCALIZATION : thm
  PRIME_IDEAL_LOCALIZATION_EXISTS : thm
  RING_LOCALIZATION_PRIME_IDEAL_CORRESPONDENCE : thm
  deriving Inhabited

@[nospecialize]
def setupUFDs [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BProducts : Products) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BRingRule : RingRule) (BPrimes : Primes) (BFactorizations : Factorizations) (BSquarefree : Squarefree) (BLocalization : Localization) (BSpecialIdeals : SpecialIdeals) :
    ExceptT String IO UFDs := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON,
        MESON_TAC, NUM_REDUCE_CONV, SET_RULE, SET_TAC, derive_strong_induction,
        new_definition, prove_inductive_relations_exist, .. } := D
  let { ADD_SUB, ADD_SYM, ARITH_EQ, CARD_NUMSEG_1, .. } := D.core1
  let { CONJ_ASSOC, DISJOINT, EQ_IMP, EQ_TRANS, ETA_AX, EXTENSION, .. } := D.core2
  let { FINITE_NUMSEG, FORALL_IN_GSPEC, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN, INJECTIVE_ON_ALT, .. } := D.core4
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_SING, LE, LEFT_IMP_EXISTS_THM, LE_REFL, .. } := D.core5
  let { MONO_AND, MONO_EXISTS, NOT_EXISTS_THM, NOT_IMP, NOT_IN_EMPTY, NUMSEG_ADD_SPLIT,
        NUMSEG_OFFSET_IMAGE, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET,
        SUBSET, SUBSET_ANTISYM, .. } := D.core7
  let { num_INDUCTION, numseg, o_DEF, o_THM, .. } := D.core8
  let { RING_0, RING_1, RING_MUL, RING_MUL_AC, RING_MUL_ASSOC, RING_MUL_LID,
        RING_MUL_RID, RING_MUL_RZERO, RING_MUL_SYM, RING_SUB, RING_SUB_EQ_0,
        RING_SUB_LDISTRIB, RING_SUB_REFL, TRIVIAL_RING_10, .. } := BBasics
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES_LEFT, RING_PRODUCT_CLAUSES_NUMSEG,
        RING_PRODUCT_CLAUSES_NUMSEG_ALT, RING_PRODUCT_EQ, RING_PRODUCT_IMAGE,
        RING_PRODUCT_SING, RING_PRODUCT_UNION, .. } := BProducts
  let { RING_ASSOCIATES_1, RING_ASSOCIATES_LMUL, RING_ASSOCIATES_MUL,
        RING_ASSOCIATES_REFL, RING_ASSOCIATES_SYM, RING_ASSOCIATES_TRANS,
        RING_COPRIME_00, RING_DIVIDES_0, RING_DIVIDES_ASSOCIATES,
        RING_DIVIDES_IN_CARRIER, RING_DIVIDES_LMUL, RING_DIVIDES_MUL2,
        RING_DIVIDES_PRODUCT_SUBSET, RING_DIVIDES_REFL, RING_DIVIDES_RMUL,
        RING_DIVIDES_RMUL_REV, RING_DIVIDES_TRANS, RING_DIVIDES_UNIT,
        RING_DIVIDES_ZERO, RING_UNIT_1, RING_UNIT_DIVIDES_ANY, RING_UNIT_DIVISOR,
        RING_UNIT_IN_CARRIER, RING_UNIT_MUL, RING_UNIT_MUL_EQ, ring_coprime,
        ring_divides, ring_unit, .. } := BDivides
  let { IDEAL_GENERATED_EQ_0, IDEAL_GENERATED_INC_GEN, IDEAL_GENERATED_MINIMAL_EQ,
        IDEAL_GENERATED_SING_ALT, IN_RING_IDEAL_0, IN_RING_IDEAL_LMUL,
        IN_RING_IDEAL_RMUL, RING_IDEAL_IDEAL_GENERATED, ring_ideal, .. } := BIdeals
  let { INTEGRAL_DOMAIN_ASSOCIATES, INTEGRAL_DOMAIN_DIVIDES_LMUL2,
        INTEGRAL_DOMAIN_MUL_EQ_0, INTEGRAL_DOMAIN_MUL_LCANCEL, integral_domain, .. } := BDomains
  let { RING_ISOMORPHISM, RING_ISOMORPHISM_IMP_HOMOMORPHISM, ring_homomorphism, .. } := BHoms
  let { ISOMORPHIC_RING_SYM, isomorphic_ring, .. } := BIso
  let { ISOMORPHIC_RING_INTEGRAL_DOMAINNESS, RING_DIVIDES_HOMOMORPHIC_IMAGE, .. } := BKernels
  let { RING_TAC, .. } := BRingRule
  let { INTEGRAL_DOMAIN_DIVIDES_PRIME_LMUL, INTEGRAL_DOMAIN_PRIME_COPRIME_EQ,
        INTEGRAL_DOMAIN_PRIME_DIVIDES_OR_COPRIME,
        INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE, RING_ASSOCIATES_PRIME,
        RING_IRREDUCIBLE_IN_CARRIER, RING_PRIME_DIVIDES_IRREDUCIBLE,
        RING_PRIME_DIVIDES_MUL, RING_PRIME_IN_CARRIER, RING_PRIME_ISOMORPHIC_IMAGE_EQ,
        ring_irreducible, ring_prime, .. } := BPrimes
  let { RING_ASSOCIATES_PRIMEFACTS_BIJECTION, .. } := BFactorizations
  let { RING_MULTSYS, RING_MULTSYS_IMP_SUBSET, ring_multsys, .. } := BSquarefree
  let { INTEGRAL_DOMAIN_LOCALIZATION, LOCALEQUIV_MUL_LCANCEL, LOCALEQUIV_MUL_RCANCEL,
        RING_FRACTIONATE_EQ_0_GEN, RING_FRACTIONATE_IN_CARRIER,
        RING_HOMOMORPHISM_FRACTIONATE, RING_IDEAL_LOCALIZATION, RING_LOCALEQUIV,
        RING_LOCALEQUIV_EQUIV, RING_LOCALEQUIV_EQ_0_GEN, RING_LOCALEQUIV_IN_CARRIER,
        RING_LOCALEQUIV_SYM, RING_LOCALIZATION_1, RING_LOCALIZATION_CARRIER,
        RING_LOCALIZATION_MUL, RING_UNIT_FRACTIONATE, ring_fractionate,
        ring_localequiv, .. } := BLocalization
  let { FIELD_IMP_PID, PID, PID_EQ_INTEGRAL_DOMAIN_PRIME_PRINCIPAL,
        PID_MAXIMAL_EQ_PRIME_IDEAL, PRIME_IDEAL_HOMOMORPHIC_PREIMAGE,
        PRIME_IDEAL_IMP_SUBSET, PRIME_IDEAL_SING, PRIME_IMP_PROPER_IDEAL,
        PRIME_IMP_RING_IDEAL, PRIME_SUPERIDEAL_EXCLUDING_EXISTS, PRINCIPAL_IDEAL_0,
        PROPER_IDEAL, PROPER_IDEAL_UNIT, RING_MUL_IN_PRIME_IDEAL, RING_PRIME_IDEAL,
        RING_UNIT_NOT_IN_PRIME_IDEAL, maximal_ideal, prime_ideal, principal_ideal,
        proper_ideal, .. } := BSpecialIdeals
  -- @@SCOPE END

  let UFD ← new_definition
   r"UFD (r:A ring) <=>
        integral_domain r /\
        !j. prime_ideal r j /\ ~(j = {ring_0 r})
            ==> ?p. ring_prime r p /\ p IN j"

  let UFD_IMP_INTEGRAL_DOMAIN ← prove
   r"!r:A ring. UFD r ==> integral_domain r"
   (SIMP_TAC [UFD])

  let PID_IMP_UFD ← prove
   r"!r:A ring. PID r ==> UFD r"
   (GEN_TAC THEN REWRITE_TAC [PID, UFD] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"j:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:A->bool")) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [prime_ideal, proper_ideal], SIMP_TAC [principal_ideal]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "p:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST_ALL_TAC o SYM)) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [PRIME_IDEAL_SING]) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
     [IDEAL_GENERATED_EQ_0]) THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_INC_GEN, IN_SING])

  let FIELD_IMP_UFD ← prove
   r"!r:A ring. field r ==> UFD r"
   (SIMP_TAC [FIELD_IMP_PID, PID_IMP_UFD])

  let ISOMORPHIC_RING_UFDNESS ← prove
   r"!(r:A ring) (r':B ring). r isomorphic_ring r' ==> (UFD r <=> UFD r')"
   (← do
    let lemma ← prove
     r"!(r:A ring) (r':B ring).
        r isomorphic_ring r' ==> UFD r ==> UFD r'"
     (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [UFD] THEN
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [ASM_MESON_TAC [ISOMORPHIC_RING_INTEGRAL_DOMAINNESS], ALL_TAC] THEN
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"f:A->B") o REWRITE_RULE [isomorphic_ring]) THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"k:B->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"{x | x IN ring_carrier r /\ (f:A->B) x IN k}")) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [MATCH_MP_TAC PRIME_IDEAL_HOMOMORPHIC_PREIMAGE THEN
          ASM_MESON_TAC [RING_ISOMORPHISM_IMP_HOMOMORPHISM],
          RULE_ASSUM_TAC (REWRITE_RULE [RING_ISOMORPHISM, ring_homomorphism]) THEN
          FIRST_X_ASSUM (MP_TAC o MATCH_MP PRIME_IDEAL_IMP_SUBSET) THEN
          ASM SET_TAC []],
        REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_MESON_TAC [RING_PRIME_ISOMORPHIC_IMAGE_EQ]])
    pure (REPEAT STRIP_TAC THEN EQ_TAC THEN MATCH_MP_TAC lemma THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [ISOMORPHIC_RING_SYM] THEN
      ASM_REWRITE_TAC []))

  let UFD_EQ_PRIMEFACT ← prove
   r"!r:A ring.
        UFD r <=>
        integral_domain r /\
        !x. x IN ring_carrier r /\ ~(x = ring_0 r)
            ==> ?n p. (!i. 1 <= i /\ i <= n ==> ring_prime r (p i)) /\
                      ring_associates r (ring_product r (1..n) p) x"
   (← do
    -- right to left: the rules in reverse text order, the
    -- prove_inductive_relations_exist call last
    let a10 ← ARITH_RULE (← q r"~(SUC n <= n)")
    let m9 ← MESON []
     (← q r"ring_associates r x z ==> y = x ==> ring_associates r y z")
    let a8 ← ARITH_RULE (← q r"1 <= SUC n")
    let a7 ← ARITH_RULE (← q r"~(1 <= i /\ i <= 0)")
    let a6 ← ARITH_RULE (← q r"1 <= SUC n")
    let a5 ← ARITH_RULE (← q r"SUC m <= n ==> m <= n")
    let m4 ← MESON []
     (← q r"(!x. R x ==> Q x) /\ (!x. Q x ==> R x)
    ==> ((!x. P x ==> Q x) <=> (!x. P x ==> R x))")
    let s3 ← SET_RULE (← q r"DISJOINT s t <=> !x. x IN s ==> ~(x IN t)")
    let t2 ← TAUT (← q r"(q ==> p) /\ q ==> p /\ q")
    let pir ← ExceptT.mk (prove_inductive_relations_exist
     (← q r"(!u:A. ring_unit r u ==> pp u) /\
    !p a. ring_prime r p /\ pp a ==> pp (ring_mul r p a)"))
    pure (GEN_TAC THEN REWRITE_TAC [UFD] THEN
    ASM_CASES_TAC (← q "integral_domain(r:A ring)") THEN ASM_REWRITE_TAC [] THEN
    X_CHOOSE_THEN (← q r"pp:A->bool") MP_TAC pir THEN
    DISCH_THEN (MP_TAC o CONJUNCT1 o ONCE_REWRITE_RULE [CONJ_ASSOC]) THEN
    DISCH_THEN (fun th => tactic_of do
      let (a, b) ← CONJ_PAIR th
      let d ← ExceptT.mk (derive_strong_induction a b)
      let c1 ← CONJUNCT1 th
      pure (MP_TAC c1 THEN MP_TAC d)) THEN
    MP_TAC (← ISPEC (← q r"pp:A->bool") IN) THEN
    DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
    STRIP_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!x:A. x IN pp ==> x IN ring_carrier r") ASSUME_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN SIMP_TAC [ring_unit, ring_prime, RING_MUL],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(!x u:A. x IN pp /\ ring_unit r u ==> ring_mul r x u IN pp) /\
    (!u x:A. ring_unit r u /\ x IN pp ==> ring_mul r u x IN pp)")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC t2 THEN CONJ_TAC THENL
       [ASM_MESON_TAC [RING_UNIT_IN_CARRIER, RING_MUL_SYM],
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM]] THEN
      GEN_TAC THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [RING_UNIT_MUL, RING_MUL_AC, RING_PRIME_IN_CARRIER],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!p:A. ring_prime r p ==> p IN pp") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_UNIT_1, RING_MUL_RID, RING_PRIME_IN_CARRIER],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x y:A. x IN ring_carrier r /\ y IN ring_carrier r
            ==> (ring_mul r x y IN pp <=> x IN pp /\ y IN pp)")
    ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"!x:A. x IN pp ==> !y. y IN pp ==> ring_mul r x y IN pp")
      ASSUME_TAC THENL
       [GEN_TAC THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_MESON_TAC [RING_MUL_AC, RING_PRIME_IN_CARRIER],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!z:A. z IN pp
            ==> !x y:A. x IN ring_carrier r /\
                        y IN ring_carrier r /\
                        ring_mul r x y = z
                        ==> x IN pp /\ y IN pp")
      MP_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      CONJ_TAC THENL [ASM_MESON_TAC [RING_UNIT_MUL_EQ], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q "p:A", ← q "z:A"] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [RING_MUL, RING_PRIME_IN_CARRIER] THEN
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_prime]) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (MP_TAC o SPECL [← q "x:A", ← q "y:A"]) THEN
      ASM_SIMP_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_REFL] THEN
      REWRITE_TAC [ring_divides] THEN DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "w:A")
       (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC))
      THENL
       [SUBGOAL_THEN (← q r"(w:A) IN pp /\ y IN pp") MP_TAC THENL
         [ALL_TAC, ASM_MESON_TAC []],
        SUBGOAL_THEN (← q r"(x:A) IN pp /\ w IN pp") MP_TAC THENL
         [ALL_TAC, ASM_MESON_TAC []]] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [] THEN
      MATCH_MP_TAC INTEGRAL_DOMAIN_MUL_LCANCEL THEN
      MAP_EVERY EXISTS_TAC [← q "r:A ring", ← q "p:A"] THEN
      ASM_SIMP_TAC [RING_MUL] THEN ASM_MESON_TAC [RING_MUL_AC, RING_MUL],
      ALL_TAC] THEN
    TRANS_TAC EQ_TRANS
     (← q r"!x:A. x IN ring_carrier r /\ ~(x = ring_0 r) ==> x IN pp") THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"!j. prime_ideal r j
          ==> !x:A. x IN pp
                    ==> x IN j /\ ~(ring_unit r x)
                         ==> ?p. ring_prime r p /\ p IN pp /\ p IN j")
      MP_TAC THENL
       [GEN_TAC THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        SIMP_TAC [] THEN MAP_EVERY X_GEN_TAC [← q "p:A", ← q "a:A"] THEN
        ASM_SIMP_TAC [RING_MUL_IN_PRIME_IDEAL, RING_PRIME_IN_CARRIER,
                      RING_UNIT_MUL_EQ] THEN
        ASM_CASES_TAC (← q "(p:A) IN j") THEN ASM_REWRITE_TAC [] THENL
         [ASM_MESON_TAC [ring_prime], REPEAT STRIP_TAC] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [prime_ideal]) THEN
        ASM_REWRITE_TAC [PROPER_IDEAL_UNIT, prime_ideal] THEN ASM SET_TAC [],
        REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
        FIRST_X_ASSUM ((fun (_ : thm) => ALL_TAC) o SPEC (← q r"ring_carrier r:A->bool")) THEN
        STRIP_TAC] THEN
      EQ_TAC THEN DISCH_TAC THENL
       [X_GEN_TAC (← q "x:A") THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q "(x:A) IN pp") THEN ASM_REWRITE_TAC [] THEN
        MP_TAC (← ISPECL
         [← q "r:A ring", ← q r"pp:A->bool", ← q "ideal_generated r {x:A}"]
          PRIME_SUPERIDEAL_EXCLUDING_EXISTS) THEN
        REWRITE_TAC [NOT_IMP, RING_IDEAL_IDEAL_GENERATED] THEN
        REWRITE_TAC [← GSYM CONJ_ASSOC, ring_multsys, SUBSET] THEN
        ASM_SIMP_TAC [RING_UNIT_1, IDEAL_GENERATED_SING_ALT] THEN
        REWRITE_TAC [s3] THEN
        ASM_SIMP_TAC [FORALL_IN_GSPEC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"j:A->bool") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:A->bool")) THEN
        ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
         [GEN_REWRITE_TAC RAND_CONV [EXTENSION] THEN
          DISCH_THEN (MP_TAC o SPEC (← q "ring_mul r x (ring_1 r):A")) THEN
          ASM_MESON_TAC [RING_1, IN_SING, RING_MUL_RID],
