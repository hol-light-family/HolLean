       UFD_POLY_RING_1) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"poly_ring (poly_ring r (t:V->bool) :((V->num)->A) ring) (:1)
