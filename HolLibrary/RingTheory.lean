           ((frc:A->(A#A->bool)) o (g':(1->num)->A)) = poly_deg r g'")
         ASSUME_TAC THENL
        [MATCH_MP_TAC POLY_DEG_MONOMORPHIC_IMAGE THEN ASM_REWRITE_TAC [],
         ALL_TAC] THEN
       SUBGOAL_THEN (← q "poly_deg r (g':(1->num)->A) = 0")
         ASSUME_TAC THENL
        [FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
         SUBGOAL_THEN
           (← q r"?c:(A#A->bool).
              ring_unit (fraction_ring (r:A ring)) c /\
              (frc:A->(A#A->bool)) o (g':(1->num)->A) =
              poly_const (fraction_ring r) c")
           STRIP_ASSUME_TAC THENL
          [ASM_MESON_TAC [RING_UNIT_POLY_DOMAIN, FIELD_IMP_INTEGRAL_DOMAIN],
           ALL_TAC] THEN
         ASM_REWRITE_TAC [POLY_DEG_CONST],
         ALL_TAC] THEN
       FIRST_ASSUM (MP_TAC o MATCH_MP POLY_DEG_EQ_0) THEN
       ASM_REWRITE_TAC [] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q "c:A") STRIP_ASSUME_TAC) THEN
       SUBGOAL_THEN (← q "ring_unit (r:A ring) (c:A)") ASSUME_TAC THENL
        [ASM_CASES_TAC (← q "c = ring_0 (r:A ring)") THENL
          [SUBGOAL_THEN
             (← q "(g':(1->num)->A) = ring_0(poly_ring (r:A ring) (:1))")
             ASSUME_TAC THENL
            [ASM_REWRITE_TAC [POLY_RING, POLY_CONST_0], ALL_TAC] THEN
           ASM_MESON_TAC [ring_divides, RING_MUL_LZERO, POLY_RING],
           ALL_TAC] THEN
         ASM_CASES_TAC (← q "ring_unit r (c:A)") THENL
          [ASM_REWRITE_TAC [], ALL_TAC] THEN
         MP_TAC (← ISPECL [← q "r:A ring", ← q "c:A"] UFD_PRIME_FACTOR_EXISTS) THEN
         ASM_REWRITE_TAC [] THEN
         DISCH_THEN (X_CHOOSE_THEN (← q "p:A") STRIP_ASSUME_TAC) THEN
         SUBGOAL_THEN
           (← q r"ring_divides (poly_ring r (:1))
             (poly_const (r:A ring) c) (f:(1->num)->A)") ASSUME_TAC THENL
          [UNDISCH_TAC
             (← q "ring_divides (poly_ring r (:1)) (g':(1->num)->A) f") THEN
           ASM_REWRITE_TAC [], ALL_TAC] THEN
         SUBGOAL_THEN
           (← q "!m:(1->num). ring_divides (r:A ring) c ((f:(1->num)->A) m)")
           ASSUME_TAC THENL
          [ASM_MESON_TAC [POLY_CONST_DIVIDES_COEFFS_EQ], ALL_TAC] THEN
         SUBGOAL_THEN
           (← q "!m:(1->num). ring_divides (r:A ring) p ((f:(1->num)->A) m)")
           ASSUME_TAC THENL
          [GEN_TAC THEN MATCH_MP_TAC RING_DIVIDES_TRANS THEN
           EXISTS_TAC (← q "c:A") THEN ASM_REWRITE_TAC [],
           ALL_TAC] THEN
         SUBGOAL_THEN
           (← q r"ring_divides (poly_ring r (:1))
             (poly_const (r:A ring) p) (f:(1->num)->A)") ASSUME_TAC THENL
          [MATCH_MP_TAC POLY_CONST_DIVIDES_COEFFS THEN
           ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [ring_prime],
           ALL_TAC] THEN
         UNDISCH_TAC
           (← q r"!p:A. ring_prime r p
             ==> ~ring_divides (poly_ring r (:1))
                   (poly_const r p) f") THEN
         DISCH_THEN (MP_TAC o SPEC (← q "p:A")) THEN ASM_REWRITE_TAC [] THEN
         UNDISCH_TAC
           (← q r"ring_divides (poly_ring r (:1))
             (poly_const (r:A ring) p) (f:(1->num)->A)") THEN
         MESON_TAC [],
         ALL_TAC] THEN
       ASM_SIMP_TAC [RING_UNIT_POLY_DOMAIN, UFD_IMP_INTEGRAL_DOMAIN] THEN
       ASM_MESON_TAC [],
       ALL_TAC] THEN
     SUBGOAL_THEN
       (← q r"ring_unit (poly_ring (fraction_ring r) (:1))
         ((frc:A->(A#A->bool)) o (g:(1->num)->A)) \/
        ring_unit (poly_ring (fraction_ring r) (:1))
         (frc o (h:(1->num)->A))") MP_TAC THENL
      [FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o CONJUNCT2 o CONJUNCT2 o
         GEN_REWRITE_RULE id [ring_irreducible]) THEN
       DISCH_THEN (MP_TAC o SPECL
         [← q "(frc:A->(A#A->bool)) o (g:(1->num)->A)",
          ← q "(frc:A->(A#A->bool)) o (h:(1->num)->A)"]) THEN
       ANTS_TAC THENL
        [UNDISCH_TAC
           (← q r"ring_homomorphism (poly_ring r (:1),
              poly_ring (fraction_ring r) (:1))
             (\p:(1->num)->A. (frc:A->(A#A->bool)) o p)") THEN
         REWRITE_TAC [ring_homomorphism] THEN STRIP_TAC THEN
         CONV_TAC (DEPTH_CONV BETA_CONV) THEN
         ASM_MESON_TAC [SUBSET, IN_IMAGE],
         SIMP_TAC []], ALL_TAC] THEN
     DISCH_TAC THEN
     SUBGOAL_THEN
       (← q r"ring_divides (poly_ring r (:1)) g f /\
        ring_divides (poly_ring r (:1)) (h:(1->num)->A) f")
       STRIP_ASSUME_TAC THENL
      [REWRITE_TAC [ring_divides] THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
        [EXISTS_TAC (← q "h:(1->num)->A") THEN ASM_REWRITE_TAC [],
         EXISTS_TAC (← q "g:(1->num)->A") THEN ASM_MESON_TAC [RING_MUL_SYM]],
       ALL_TAC] THEN
     ASM_MESON_TAC []]))

  -- @@RETURN BEGIN
  return { IRREDUCIBLE_PRIMITIVE_POLY_FRACTION_RING }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Eisenstein irreducibility criterion.  (ringtheory.ml 28585-29320)          -/
/- ------------------------------------------------------------------------- -/

structure Eisenstein where
  -- @@FIELDS
  EISENSTEIN_IRREDUCIBILITY_GEN : thm
  EISENSTEIN_IRREDUCIBILITY : thm
  EISENSTEIN_IRREDUCIBILITY_FRACTION_RING : thm
  deriving Inhabited

@[nospecialize]
def setupEisenstein [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BKernels : Kernels) (BCosets : Cosets) (BQuotients : Quotients) (BPrimes : Primes) (BLocalization : Localization) (BSpecialIdeals : SpecialIdeals) (BUFDs : UFDs) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BOneCoeff : OneCoeff) (BDegree : Degree) (BEvaluation : Evaluation) (BComposing : Composing) (BZerodivisors : Zerodivisors) (BDivision : Division) (BGaussA : GaussA) (BGaussD : GaussD) :
    ExceptT String IO Eisenstein := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, .. } := D
  let { ADD_EQ_0, ADD_SUB, ARITH_EQ, BETA_THM, .. } := D.core1
  let { CONTRAPOS_THM, .. } := D.core2
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IN_ELIM_THM, LE_ANTISYM, LE_REFL, .. } := D.core5
  let { NOT_LE, .. } := D.core6
  let { SUBSET, SUBSET_UNIV, .. } := D.core7
  let { num_WF, o_THM, .. } := D.core8
  let { RING_MUL, RING_MUL_ASSOC, RING_MUL_LZERO, RING_MUL_RZERO, RING_MUL_SYM,
        TRIVIAL_RING_10, .. } := BBasics
  let { RING_POW_2, .. } := BNumbers
  let { RING_ASSOCIATES_LMUL, RING_DIVIDES_LMUL, RING_DIVIDES_MUL2, RING_DIVIDES_RMUL,
        RING_DIVIDES_TRANS, ring_divides, .. } := BDivides
  let { IN_IDEAL_GENERATED_SING_EQ, .. } := BIdeals
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_UNIT, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING,
        INTEGRAL_DOMAIN_MUL_EQ_0, .. } := BDomains
  let { RING_HOMOMORPHISM_MUL, RING_MONOMORPHISM_EQ_0,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, ring_homomorphism, .. } := BHoms
  let { RING_DIVIDES_HOMOMORPHIC_IMAGE, .. } := BKernels
  let { RING_COSET_EQ_IDEAL, .. } := BCosets
  let { QUOTIENT_RING_0, RING_HOMOMORPHISM_RING_COSET, .. } := BQuotients
  let { RING_ASSOCIATES_IRREDUCIBLE, ring_irreducible, ring_prime, .. } := BPrimes
  let { FRACTION_FIELD, RING_MONOMORPHISM_FRACTIONATE, .. } := BLocalization
  let { INTEGRAL_DOMAIN_QUOTIENT_RING, RING_PRIME_IDEAL, prime_ideal, proper_ideal, .. } := BSpecialIdeals
  let { UFD_IMP_INTEGRAL_DOMAIN, UFD_PRIME_FACTOR_EXISTS, .. } := BUFDs
  let { MONOMIAL_DEG_UNIVARIATE, monomial_1, .. } := BMonomials
  let { POLY_CONST_0, POLY_MUL_CONST, POLY_MUL_MONOMIAL_1, POLY_VAR_EQ_CONST,
        RING_POLYNOMIAL_IMP_POWERSERIES, RING_POLYNOMIAL_VAR, poly_0, poly_const, .. } := BPowerSeries
  let { IN_POLY_RING_CARRIER, POLY_CONST, POLY_MONOMIAL_IN_CARRIER, POLY_RING,
        POLY_RING_CLAUSES, POLY_VAR_UNIV, RING_HOMOMORPHISM_POLY_CONST,
        RING_POLYNOMIAL, .. } := BPolyRings
  let { COEFF_0, COEFF_POLY_VAR_MUL, coeff, .. } := BOneCoeff
  let { INTEGRAL_DOMAIN_POLY_RING, POLY_DEG_0, POLY_DEG_EQ_0, POLY_DEG_GE,
        POLY_DEG_MUL, POLY_DEG_VAR, .. } := BDegree
  let { POLY_VAR_DIVIDES_UNIVARIATE, .. } := BEvaluation
  let { POLY_COMPOSE_HOMOMORPHISM_CONST, POLY_DEG_HOMOMORPHIC_IMAGE,
        RING_HOMOMORPHISM_POLY_RINGS, RING_MONOMORPHISM_POLY_RINGS, .. } := BComposing
  let { POLY_DEG_UNIT, RING_UNIT_POLY_CONST, .. } := BZerodivisors
  let { POLY_TOP_NONZERO, .. } := BDivision
  let { POLY_MAKE_PRIMITIVE, .. } := BGaussA
  let { IRREDUCIBLE_PRIMITIVE_POLY_FRACTION_RING, .. } := BGaussD
  -- @@SCOPE END

  let EISENSTEIN_IRREDUCIBILITY_GEN ← prove
   r"!(r:A ring) p (f:(1->num)->A).
     integral_domain r /\ ring_prime r p /\
     f IN ring_carrier(poly_ring r (:1)) /\
     1 <= poly_deg r f /\
     ~ring_divides r p (coeff (poly_deg r f) f) /\
     (!k. k < poly_deg r f ==> ring_divides r p (coeff k f)) /\
     ~ring_divides r (ring_pow r p 2) (f monomial_1)
     ==> !g h. g IN ring_carrier(poly_ring r (:1)) /\
               h IN ring_carrier(poly_ring r (:1)) /\
               ring_mul (poly_ring r (:1)) g h = f
               ==> poly_deg r g = 0 \/ poly_deg r h = 0"
   (← do
    let coeff_poly_varmul_alt ← prove
     r"!(r:A ring) (q:(1->num)->A) k.
       q IN ring_carrier(poly_ring r (:1))
       ==> (ring_mul (poly_ring r (:1)) (poly_var r one) q)
           (\v:1. k + 1) = q(\v:1. k)"
     (REWRITE_TAC [POLY_RING, IN_ELIM_THM, SUBSET_UNIV] THEN
      SIMP_TAC [RING_POLYNOMIAL_IMP_POWERSERIES, ← REWRITE_RULE [coeff]
                COEFF_POLY_VAR_MUL, ADD_EQ_0, ARITH_EQ, ADD_SUB])
    let peeling_lemma ← prove
     r"!d (r:A ring) (a:(1->num)->A) (b:(1->num)->A).
       integral_domain r /\
       a IN ring_carrier(poly_ring r (:1)) /\
       b IN ring_carrier(poly_ring r (:1)) /\
       ~(a = ring_0(poly_ring r (:1))) /\
       ~(b = ring_0(poly_ring r (:1))) /\
       ~(b monomial_1 = ring_0 r) /\
       a monomial_1 = ring_0 r /\
       1 <= poly_deg r b /\
       poly_deg r a = d /\
       (!k. k < d + poly_deg r b
            ==> (ring_mul (poly_ring r (:1)) a b)
                (\v:1. k) = ring_0 r)
       ==> F"
     (MATCH_MP_TAC num_WF THEN
      X_GEN_TAC (← q "d:num") THEN DISCH_THEN (LABEL_TAC "wf_ih") THEN
      MAP_EVERY X_GEN_TAC [← q "r:A ring", ← q "a:(1->num)->A", ← q "b:(1->num)->A"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q "~trivial_ring(r:A ring)") ASSUME_TAC THENL
      [ASM_MESON_TAC [INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING], ALL_TAC] THEN
      ASM_CASES_TAC (← q "d = 0") THENL
      [MP_TAC (← REWRITE_RULE [coeff]
         (← ISPECL [← q "r:A ring", ← q "a:(1->num)->A"] POLY_TOP_NONZERO)) THEN
       ASM_REWRITE_TAC [] THEN
       REWRITE_TAC [← GSYM monomial_1] THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"ring_divides (poly_ring r (:1))
        (poly_var r (one:1)) (a:(1->num)->A)") MP_TAC THENL
      [ASM_SIMP_TAC [POLY_VAR_DIVIDES_UNIVARIATE, RING_POLYNOMIAL, COEFF_0],
       ALL_TAC] THEN
      REWRITE_TAC [ring_divides, POLY_VAR_UNIV] THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "a':(1->num)->A")
        (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "a_eq"))) THEN
      SUBGOAL_THEN (← q "~(a' = ring_0(poly_ring r (:1)):(1->num)->A)")
        ASSUME_TAC THENL
      [DISCH_TAC THEN
       UNDISCH_TAC (← q "~(a = ring_0(poly_ring r (:1)):(1->num)->A)") THEN
       ASM_SIMP_TAC [RING_MUL_RZERO, POLY_VAR_UNIV], ALL_TAC] THEN
      SUBGOAL_THEN (← q "poly_deg r (a':(1->num)->A) = d - 1")
        ASSUME_TAC THENL
      [SUBGOAL_THEN (← q r"ring_polynomial r (poly_var r (one:1):(1->num)->A) /\
          ring_polynomial r (a':(1->num)->A)") STRIP_ASSUME_TAC THENL
       [CONJ_TAC THENL [REWRITE_TAC [RING_POLYNOMIAL_VAR],
         RULE_ASSUM_TAC (REWRITE_RULE [IN_POLY_RING_CARRIER]) THEN
         ASM_REWRITE_TAC []], ALL_TAC] THEN
       MP_TAC (← ISPECL [← q "r:A ring", ← q "poly_var r (one:1):(1->num)->A",
         ← q "a':(1->num)->A"] POLY_DEG_MUL) THEN
       ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN REWRITE_TAC [poly_0, POLY_VAR_EQ_CONST] THEN
        ASM_REWRITE_TAC [] THEN
        UNDISCH_TAC (← q "~(a' = ring_0(poly_ring r (:1)):(1->num)->A)") THEN
        REWRITE_TAC [POLY_RING_CLAUSES, poly_0], ALL_TAC] THEN
       SUBGOAL_THEN (← q r"poly_mul r (poly_var r (one:1)) (a':(1->num)->A) =
          (a:(1->num)->A)") (fun th => REWRITE_TAC [th]) THENL
       [ASM_REWRITE_TAC [POLY_RING_CLAUSES], ALL_TAC] THEN
       ASM_SIMP_TAC [POLY_DEG_VAR, ← GSYM TRIVIAL_RING_10] THEN
       ASM_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!k. (ring_mul (poly_ring r (:1))
               (a':(1->num)->A) b)(\v:1. k) =
             (ring_mul (poly_ring r (:1)) a b)(\v:1. k + 1)")
        ASSUME_TAC THENL
      [X_GEN_TAC (← q "k:num") THEN SUBGOAL_THEN
         (← q r"ring_mul (poly_ring r (:1)) (a:(1->num)->A) b =
          ring_mul (poly_ring r (:1)) (poly_var r one)
            (ring_mul (poly_ring r (:1)) a' b)") SUBST1_TAC THENL
       [ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, POLY_VAR_UNIV], ALL_TAC] THEN
       MATCH_MP_TAC (← GSYM coeff_poly_varmul_alt) THEN
       ASM_SIMP_TAC [RING_MUL], ALL_TAC] THEN
      SUBGOAL_THEN (← q "(a':(1->num)->A) monomial_1 = ring_0 r")
        ASSUME_TAC THENL
      [SUBGOAL_THEN (← q r"ring_polynomial r (a':(1->num)->A) /\
          ring_polynomial r (b:(1->num)->A)") STRIP_ASSUME_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [IN_POLY_RING_CARRIER]) THEN
        ASM_REWRITE_TAC [], ALL_TAC] THEN
       SUBGOAL_THEN (← q r"ring_mul r ((a':(1->num)->A) monomial_1)
                     ((b:(1->num)->A) monomial_1) = ring_0 r") MP_TAC THENL
       [SUBGOAL_THEN (← q r"ring_mul r ((a':(1->num)->A) monomial_1)
                      (b monomial_1) =
           (ring_mul (poly_ring r (:1)) a' b)
             (monomial_1:(1->num))") SUBST1_TAC THENL
        [MP_TAC (← ISPECL [← q "r:A ring", ← q "a':(1->num)->A",
           ← q "b:(1->num)->A"] POLY_MUL_MONOMIAL_1) THEN
         ASM_REWRITE_TAC [] THEN REWRITE_TAC [POLY_RING_CLAUSES] THEN
         DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])), ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(ring_mul (poly_ring r (:1))
             (a':(1->num)->A) b) monomial_1 =
           (ring_mul (poly_ring r (:1)) a b)
             (\v:1. 0 + 1)") SUBST1_TAC THENL
        [REWRITE_TAC [monomial_1] THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
        REWRITE_TAC [← ARITH_RULE (← q "0 + 1 = 1")] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        UNDISCH_TAC (← q "1 <= poly_deg r (b:(1->num)->A)") THEN
        UNDISCH_TAC (← q "~(d = 0)") THEN ASM_ARITH_TAC, ALL_TAC] THEN
       SUBGOAL_THEN (← q r"(a':(1->num)->A) monomial_1 IN ring_carrier r /\
          (b:(1->num)->A) monomial_1 IN ring_carrier r")
         STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER], ALL_TAC] THEN
       DISCH_TAC THEN MP_TAC (← ISPECL [← q "r:A ring",
         ← q "(a':(1->num)->A) monomial_1",
         ← q "(b:(1->num)->A) monomial_1"] INTEGRAL_DOMAIN_MUL_EQ_0) THEN
       ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
       ASM_REWRITE_TAC [], ALL_TAC] THEN
      USE_THEN "wf_ih" (MP_TAC o SPEC (← q "d - 1")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPECL
        [← q "r:A ring", ← q "a':(1->num)->A", ← q "b:(1->num)->A"]) THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q "k:num") THEN DISCH_TAC THEN
      USE_THEN "a_eq" (SUBST1_TAC o SYM) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC)
    pure (REWRITE_TAC [coeff] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q "g:(1->num)->A", ← q "h:(1->num)->A"] THEN
    STRIP_TAC THEN
    ASM_CASES_TAC (← q "poly_deg r (g:(1->num)->A) = 0") THENL
    [ASM_REWRITE_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q "poly_deg r (h:(1->num)->A) = 0") THENL
    [ASM_REWRITE_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"~(g = ring_0(poly_ring r (:1)):(1->num)->A) /\
       ~(h = ring_0(poly_ring r (:1)):(1->num)->A)")
      STRIP_ASSUME_TAC THENL
    [CONJ_TAC THEN DISCH_TAC THENL
     [UNDISCH_TAC (← q "~(poly_deg r (g:(1->num)->A) = 0)"),
      UNDISCH_TAC (← q "~(poly_deg r (h:(1->num)->A) = 0)")] THEN
     ASM_REWRITE_TAC [POLY_RING_CLAUSES, POLY_DEG_0], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_polynomial r (g:(1->num)->A) /\
       ring_polynomial r (h:(1->num)->A) /\
       ring_polynomial r (f:(1->num)->A)") STRIP_ASSUME_TAC THENL
    [RULE_ASSUM_TAC (REWRITE_RULE [IN_POLY_RING_CARRIER]) THEN
     ASM_REWRITE_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q "(p:A) IN ring_carrier r /\\ ~(p = ring_0 r)")
      STRIP_ASSUME_TAC THENL
    [ASM_MESON_TAC [ring_prime], ALL_TAC] THEN
    ABBREV_TAC (← q "j = ideal_generated (r:A ring) {p:A}") THEN
    SUBGOAL_THEN (← q "prime_ideal (r:A ring) j") ASSUME_TAC THENL
    [EXPAND_TAC "j" THEN ASM_MESON_TAC [RING_PRIME_IDEAL], ALL_TAC] THEN
    SUBGOAL_THEN (← q "ring_ideal (r:A ring) j") ASSUME_TAC THENL
    [ASM_MESON_TAC [prime_ideal, proper_ideal], ALL_TAC] THEN
    SUBGOAL_THEN (← q "integral_domain(quotient_ring (r:A ring) j)")
      ASSUME_TAC THENL
    [ASM_SIMP_TAC [INTEGRAL_DOMAIN_QUOTIENT_RING], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!a:A. a IN ring_carrier r
             ==> (ring_coset r j a = ring_0(quotient_ring r j) <=>
                  ring_divides r p a)") (LABEL_TAC "coset_eq") THENL
    [X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
     ASM_SIMP_TAC [QUOTIENT_RING_0] THEN
     ASM_SIMP_TAC [RING_COSET_EQ_IDEAL] THEN EXPAND_TAC "j" THEN
     ASM_SIMP_TAC [IN_IDEAL_GENERATED_SING_EQ], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_homomorphism (r, quotient_ring (r:A ring) j)
        (ring_coset r j)") (LABEL_TAC "hom_coset") THENL
    [MATCH_MP_TAC RING_HOMOMORPHISM_RING_COSET THEN
     ASM_REWRITE_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_homomorphism (poly_ring r (:1),
         poly_ring (quotient_ring (r:A ring) j) (:1))
