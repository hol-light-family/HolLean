  let POLY_VARS_CONST ← prove
   r"!(r:A ring) c. poly_vars r (poly_const r c) = {}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [poly_vars, poly_const] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
    REWRITE_TAC [← MESON [] (← q r"~(if p then q else T) <=> p /\ ~q")] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    ASM_CASES_TAC (← q "c:A = ring_0 r") THEN
    ASM_REWRITE_TAC [SING_GSPEC, EMPTY_GSPEC, IMAGE_CLAUSES] THEN
    REWRITE_TAC [UNIONS_1, UNIONS_0, MONOMIAL_VARS_1])

  let POLY_VARS_0 ← prove
   r"!r:A ring. poly_vars r (poly_0 r) = {}"
   (REWRITE_TAC [poly_0, POLY_VARS_CONST])

  let POLY_VARS_1 ← prove
   r"!r:A ring. poly_vars r (poly_1 r) = {}"
   (REWRITE_TAC [poly_1, POLY_VARS_CONST])

  let POLY_VARS_VAR ← prove
   r"!(r:A ring) (v:V).
        poly_vars r (poly_var r v) =
        if trivial_ring r then {} else {v}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [poly_vars, poly_var, TRIVIAL_RING_10] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
    ASM_REWRITE_TAC [← MESON [] (← q r"~(if p then q else T) <=> p /\ ~q")] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    ASM_REWRITE_TAC [SING_GSPEC, EMPTY_GSPEC, IMAGE_CLAUSES] THEN
    REWRITE_TAC [UNIONS_1, UNIONS_0, MONOMIAL_VARS_1, MONOMIAL_VARS_VAR])

  let POLY_VARS_NEG ← prove
   r"!r (p:(V->num)->A).
        ring_powerseries r p ==> poly_vars r (poly_neg r p) = poly_vars r p"
   (REWRITE_TAC [ring_powerseries, poly_vars, poly_neg] THEN
    SIMP_TAC [RING_NEG_EQ_0])

  let POLY_VARS_ADD ← prove
   r"!r (p1:(V->num)->A) (p2:(V->num)->A).
        ring_powerseries r p1 /\ ring_powerseries r p2
        ==> poly_vars r (poly_add r p1 p2) SUBSET
            poly_vars r p1 UNION poly_vars r p2"
   (REWRITE_TAC [ring_powerseries, poly_vars, poly_add, ← GSYM UNIONS_UNION] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_UNIONS THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN REWRITE_TAC [← GSYM IMAGE_UNION] THEN
    MATCH_MP_TAC IMAGE_SUBSET THEN
    REWRITE_TAC [SUBSET, IN_UNION, IN_ELIM_THM] THEN RING_TAC)

  let POLY_VARS_MUL ← prove
   r"!r (p1:(V->num)->A) (p2:(V->num)->A).
        ring_powerseries r p1 /\ ring_powerseries r p2
        ==> poly_vars r (poly_mul r p1 p2) SUBSET
            poly_vars r p1 UNION poly_vars r p2"
   (← do
    let rr ← RING_RULE
     (← q r"~(ring_mul r x y = ring_0 r)
      ==> x IN ring_carrier r /\ y IN ring_carrier r
          ==> ~(x = ring_0 r) /\ ~(y = ring_0 r)")
    pure (REWRITE_TAC [ring_powerseries, poly_vars, poly_mul] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET, UNIONS_GSPEC] THEN
    X_GEN_TAC (← q "x:V") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:V->num") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP
     (← ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM] RING_SUM_EQ_0)) THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, ← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ, FORALL_IN_GSPEC] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
    DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN DISCH_THEN (MP_TAC o MATCH_MP rr) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [MONOMIAL_VARS_MUL]) THEN
    ASM SET_TAC []))

  let FINITE_POLYNOMIAL_VARS ← prove
   r"!r (p:(V->num)->A). ring_polynomial r p ==> FINITE(poly_vars r p)"
   (REWRITE_TAC [ring_polynomial, ring_powerseries, INFINITE] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [poly_vars, FINITE_UNIONS] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN ASM SET_TAC [])

  -- @@RETURN BEGIN
  return { ring_powerseries, ring_polynomial, RING_POLYNOMIAL_IMP_POWERSERIES, poly_vars,
           poly_const, poly_0, poly_1, poly_neg, poly_add, poly_sub, poly_mul, poly_var,
           POLY_SUB, RING_POWERSERIES_MONOMIAL, RING_POLYNOMIAL_MONOMIAL, POLY_0,
           POLY_CONST_0, POLY_CONST_1, RING_POWERSERIES_CONST, RING_POWERSERIES_VAR,
           RING_POWERSERIES_0, RING_POWERSERIES_1, POLY_VAR_MONOMIAL_1,
           RING_POWERSERIES_NEG, RING_POWERSERIES_ADD, RING_POWERSERIES_SUB,
           RING_POWERSERIES_MUL, RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_VAR,
           POLY_VAR_EQ_CONST, RING_POLYNOMIAL_0, RING_POLYNOMIAL_1, RING_POLYNOMIAL_NEG,
           RING_POLYNOMIAL_ADD, RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_MUL, POLY_ADD_SYM,
           POLY_ADD_ASSOC, POLY_ADD_LZERO, POLY_ADD_RZERO, POLY_ADD_LNEG, POLY_MUL_SYM,
           POLY_ADD_LDISTRIB, POLY_MUL_LID, POLY_MUL_RID, POLY_MUL_ASSOC, POWSER_MUL_0,
           POLY_MUL_0, POWSER_MUL_MONOMIAL_1, POLY_MUL_MONOMIAL_1, POWSER_MUL_CONST,
           POLY_MUL_CONST, POWSER_VAR_MUL, POWSER_MUL_VAR, POLY_VAR_MUL, POLY_MUL_VAR,
           POLY_VARS_CONST, POLY_VARS_0, POLY_VARS_1, POLY_VARS_VAR, POLY_VARS_NEG,
           POLY_VARS_ADD, POLY_VARS_MUL, FINITE_POLYNOMIAL_VARS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Actual polynomial and power series rings.  (ringtheory.ml 18577-19451)    -/
/- ------------------------------------------------------------------------- -/

structure PolyRings where
  -- @@FIELDS
  powser_ring : thm
  poly_ring : thm
  POWSER_RING : thm
  POLY_RING_SUBRING_OF_POWSER_RING : thm
  POLY_RING_AS_SUBRING : thm
  POLY_RING_AS_SUBRING_ALT : thm
  POLY_RING_AS_SUBRING_FINITE : thm
  POLY_CARRIER_SUBRING_OF_POWSER_RING : thm
  RING_MONOMORPHISM_POLY_POWSER : thm
  POLY_RING : thm
  POLY_IN_POWSER_RING : thm
  poly_pow : thm
  POLY_POW : thm
  POLY_POW_ALT : thm
  RING_POWERSERIES_POW : thm
  RING_POLYNOMIAL_POW : thm
  POLY_POW_1 : thm
  POLY_POW_0 : thm
  POLY_VARS_POW : thm
  POWSER_RING_CLAUSES : thm
  POWSER_CLAUSES : thm
  POLY_RING_CLAUSES : thm
  POLY_CLAUSES : thm
  POLY_SUBRING_GENERATED_CLAUSES : thm
  POLY_CONST_SUBRING_GENERATED : thm
  POWSER_MONOMIAL_IN_CARRIER : thm
  POLY_MONOMIAL_IN_CARRIER : thm
  RING_POLYNOMIAL : thm
  RING_POWERSERIES : thm
  IN_POLY_RING_CARRIER : thm
  RING_POLYNOMIAL_CARRIER_GEN : thm
  RING_POLYNOMIAL_CARRIER : thm
  POLY_MONOMIALS_FINITE : thm
  FINITE_POLY_VARS : thm
  RING_CARRIER_POLY_RING_FINITE : thm
  POWSER_RING_MONO : thm
  POLY_RING_MONO : thm
  POLY_RING_POLY_VARS : thm
  POLY_RING_IN_POLY_VARS : thm
  POLY_RING_IN_FINITE_VARIABLES : thm
  IN_POLY_RING_SUBRING_GENERATED_FINITARY : thm
  POLY_VAR : thm
  POLY_VAR_UNIV : thm
  POLY_CONST : thm
  POWSER_VAR : thm
  POWSER_VAR_UNIV : thm
  POWSER_CONST : thm
  POLY_CONST_NEG : thm
  POLY_CONST_ADD : thm
  POLY_CONST_MUL : thm
  RING_OF_NUM_POWSER_RING : thm
  RING_OF_NUM_POLY_RING : thm
  POLY_CONST_OF_NUM : thm
  POLY_CONST_EQ : thm
  POLY_CONST_EQ_0 : thm
  POLY_CONST_EQ_1 : thm
  POWSER_VAR_MUL_EQ_0 : thm
  POWSER_VARPOW_MUL_EQ_0 : thm
  RING_HOMOMORPHISM_POLY_CONST : thm
  RING_MONOMORPHISM_POLY_CONST : thm
  RING_HOMOMORPHISM_POWSER_CONST : thm
  RING_MONOMORPHISM_POWSER_CONST : thm
  RING_HOMOMORPHISM_MONOMIAL_1 : thm
  POWSER_SUM : thm
  POLY_SUM : thm
  POLY_RING_VAR_POW : thm
  POLY_RING_PRODUCT_VAR_POW : thm
  POLY_RING_PRODUCT_VAR : thm
  POLY_RING_EXPAND : thm
  POLY_RING_INDUCT : thm
  POLY_RING_INDUCT_STRONG : thm
  POLY_RING_HOMOMORPHISM_UNIQUE : thm
  TRIVIAL_POWSER_RING : thm
  TRIVIAL_POLY_RING : thm
  TRIVIAL_RING_POWSER_0 : thm
  TRIVIAL_RING_POLY_0 : thm
  RING_CARRIER_POWSER_RING : thm
  POWSER_MONOMIALS : thm
  RING_CARRIER_POLY_RING : thm
  POLY_MONOMIALS : thm
  POLY_MONOMIALS_ALT : thm
  POWSER_RING_EQ : thm
  POWSER_RING_EQ_IMP : thm
  POLY_RING_EQ : thm
  POLY_RING_EQ_IMP : thm
  deriving Inhabited

@[nospecialize]
def setupPolyRings [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BProducts : Products) (BSubrings : Subrings) (BHoms : Homs) (BMonomials : Monomials) (BPowerSeries : PowerSeries) :
    ExceptT String IO PolyRings := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, SET_TAC,
        new_definition, .. } := D
  let { ADD_CLAUSES, AND_FORALL_THM, BETA_THM, COND_ID, .. } := D.core1
  let { EMPTY_SUBSET, EQ_IMP, EQ_SYM_EQ, EQ_TRANS, ETA_AX, .. } := D.core2
  let { FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_INSERT, FINITE_SUBSET,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, INFINITE, INSERT_SUBSET, .. } := D.core4
  let { IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_INSERT, IN_SING, IN_UNIV, LAMBDA_PAIR_THM, .. } := D.core5
  let { NOT_IN_EMPTY, NOT_SUC, PAIR, PAIR_EQ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL,
        SUBSET_UNIV, UNIONS_SUBSET, .. } := D.core7
  let { RING_0, RING_1, RING_ADD, RING_ADD_RZERO, RING_MUL, RING_MUL_LID,
        RING_MUL_LZERO, RING_MUL_RID, RING_MUL_RZERO, RING_NEG_0, TRIVIAL_RING_10,
        TRIVIAL_RING_SUBSET, ring_0, ring_1, ring_add, ring_carrier, ring_mul,
        ring_neg, ring_sub, ring_tybij, .. } := BBasics
  let { RING_OF_NUM, RING_POW, RING_POW_1, ring_of_num, ring_pow, .. } := BNumbers
  let { RING_SUM_CLAUSES, RING_SUM_DELTA, RING_SUM_EQ, .. } := BSums
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, RING_PRODUCT_EQ, .. } := BProducts
  let { CARRIER_SUBRING_GENERATED_SUBRING, RING_OF_NUM_SUBRING_GENERATED,
        RING_SUB_SUBRING_GENERATED, SUBRING_GENERATED, SUBRING_GENERATED_RESTRICT,
        SUBRING_SUBRING_GENERATED, SUBSET_SUBRING_GENERATED_FINITARY,
        TRIVIAL_RING_SUBRING_GENERATED, subring_generated, subring_of, .. } := BSubrings
  let { RING_HOMOMORPHISM, RING_MONOMORPHISM_INCLUSION, RING_SUM_SUBRING_GENERATED_GEN,
        TRIVIAL_RING_MONOMORPHIC_PREIMAGE, ring_homomorphism, ring_monomorphism, .. } := BHoms
  let { MONOMIAL_DIVIDES_REFL, MONOMIAL_MUL_LID, MONOMIAL_RULE,
        MONOMIAL_VAR_DIVIDES_MUL, monomial, monomial_1, monomial_mul, monomial_var,
        monomial_vars, .. } := BMonomials
  let { FINITE_POLYNOMIAL_VARS, POLY_0, POLY_ADD_ASSOC, POLY_ADD_LDISTRIB,
        POLY_ADD_LNEG, POLY_ADD_LZERO, POLY_ADD_SYM, POLY_CONST_0, POLY_CONST_1,
        POLY_MUL_0, POLY_MUL_ASSOC, POLY_MUL_LID, POLY_MUL_MONOMIAL_1, POLY_MUL_SYM,
        POLY_SUB, POLY_VARS_0, POLY_VARS_1, POLY_VARS_ADD, POLY_VARS_CONST,
        POLY_VARS_MUL, POLY_VARS_NEG, POLY_VARS_VAR, POWSER_MUL_0, POWSER_VAR_MUL,
        RING_POLYNOMIAL_0, RING_POLYNOMIAL_1, RING_POLYNOMIAL_ADD,
        RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_IMP_POWERSERIES, RING_POLYNOMIAL_MUL,
        RING_POLYNOMIAL_NEG, RING_POLYNOMIAL_VAR, RING_POWERSERIES_0,
        RING_POWERSERIES_1, RING_POWERSERIES_ADD, RING_POWERSERIES_CONST,
        RING_POWERSERIES_MUL, RING_POWERSERIES_NEG, RING_POWERSERIES_VAR, poly_0,
        poly_1, poly_add, poly_const, poly_mul, poly_neg, poly_sub, poly_var,
        poly_vars, ring_polynomial, ring_powerseries, .. } := BPowerSeries
  -- @@SCOPE END

  let powser_ring ← new_definition
   r"powser_ring (r:A ring) (s:V->bool) =
        ring({p | ring_powerseries r p /\ poly_vars r p SUBSET s},
             poly_0 r,poly_1 r,poly_neg r,poly_add r,poly_mul r)"

  let poly_ring ← new_definition
   r"poly_ring (r:A ring) (s:V->bool) =
        ring({p | ring_polynomial r p /\ poly_vars r p SUBSET s},
             poly_0 r,poly_1 r,poly_neg r,poly_add r,poly_mul r)"

  let POWSER_RING ← prove
   r"(!(r:A ring) (s:V->bool).
        ring_carrier(powser_ring r s) =
        {p | ring_powerseries r p /\ poly_vars r p SUBSET s}) /\
   (!(r:A ring) (s:V->bool). ring_0(powser_ring r s) = poly_0 r) /\
   (!(r:A ring) (s:V->bool). ring_1(powser_ring r s) = poly_1 r) /\
   (!(r:A ring) (s:V->bool). ring_neg(powser_ring r s) = poly_neg r) /\
   (!(r:A ring) (s:V->bool). ring_add(powser_ring r s) = poly_add r) /\
   (!(r:A ring) (s:V->bool). ring_mul(powser_ring r s) = poly_mul r)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    PURE_REWRITE_TAC
     [← GSYM PAIR_EQ, ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul,
      BETA_THM, PAIR] THEN
    PURE_REWRITE_TAC [powser_ring, ← GSYM (← CONJUNCT2 ring_tybij)] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    REWRITE_TAC [RING_POWERSERIES_0, POLY_VARS_0, EMPTY_SUBSET,
                 RING_POWERSERIES_1, POLY_VARS_1] THEN
    REPEAT CONJ_TAC THENL
     [SIMP_TAC [RING_POWERSERIES_NEG, POLY_VARS_NEG],
      SIMP_TAC [RING_POWERSERIES_ADD] THEN REPEAT STRIP_TAC THEN
      wPart lhand (fun t => do lhand (← rand t)) POLY_VARS_ADD THEN
      ASM SET_TAC [],
      SIMP_TAC [RING_POWERSERIES_MUL] THEN REPEAT STRIP_TAC THEN
      wPart lhand (fun t => do lhand (← rand t)) POLY_VARS_MUL THEN
      ASM SET_TAC [],
      MESON_TAC [POLY_ADD_SYM],
      MESON_TAC [POLY_ADD_ASSOC],
      MESON_TAC [POLY_ADD_LZERO],
      MESON_TAC [POLY_ADD_LNEG],
      MESON_TAC [POLY_MUL_SYM],
      MESON_TAC [POLY_MUL_ASSOC],
      MESON_TAC [POLY_MUL_LID],
      MESON_TAC [POLY_ADD_LDISTRIB]])

  let POLY_RING_SUBRING_OF_POWSER_RING ← prove
   r"!(r:A ring) (s:V->bool).
        {p | ring_polynomial r p /\ poly_vars r p SUBSET s}
        subring_of powser_ring r s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [subring_of, POWSER_RING, IN_ELIM_THM] THEN
    REWRITE_TAC [RING_POLYNOMIAL_0, POLY_VARS_0, EMPTY_SUBSET,
                 RING_POLYNOMIAL_1, POLY_VARS_1] THEN
    GEN_REWRITE_TAC LAND_CONV [SUBSET] THEN
    SIMP_TAC [IN_ELIM_THM, RING_POLYNOMIAL_IMP_POWERSERIES] THEN
    SIMP_TAC [RING_POLYNOMIAL_NEG, RING_POLYNOMIAL_ADD, RING_POLYNOMIAL_MUL] THEN
    SIMP_TAC [POLY_VARS_NEG, ring_polynomial] THEN REPEAT STRIP_TAC THENL
     [wPart lhand (fun t => do lhand (← rand t)) POLY_VARS_ADD,
      wPart lhand (fun t => do lhand (← rand t)) POLY_VARS_MUL] THEN
    ASM SET_TAC [])

  let POLY_RING_AS_SUBRING ← prove
   r"!(r:A ring) (s:V->bool).
        poly_ring r s =
        subring_generated (powser_ring r s)
                          {p | ring_polynomial r p /\ poly_vars r p SUBSET s}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [poly_ring, subring_generated, ← CONJUNCT2 POWSER_RING] THEN
    AP_TERM_TAC THEN REWRITE_TAC [PAIR_EQ] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT1 SUBRING_GENERATED)] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARRIER_SUBRING_GENERATED_SUBRING THEN
    REWRITE_TAC [POLY_RING_SUBRING_OF_POWSER_RING])

  let POLY_RING_AS_SUBRING_ALT ← prove
   r"!(r:A ring) (s:V->bool).
        poly_ring r s =
        subring_generated (powser_ring r s) {p | ring_polynomial r p}"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [SUBRING_GENERATED_RESTRICT] THEN
    REWRITE_TAC [POLY_RING_AS_SUBRING] THEN
    AP_TERM_TAC THEN REWRITE_TAC [POWSER_RING, ring_polynomial] THEN SET_TAC [])

  let POLY_RING_AS_SUBRING_FINITE ← prove
   r"!(r:A ring) (s:V->bool).
           poly_ring r s =
           subring_generated (powser_ring r s)
                             {p | FINITE {m | ~(p m = ring_0 r)}}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [POLY_RING_AS_SUBRING_ALT] THEN
    ONCE_REWRITE_TAC [SUBRING_GENERATED_RESTRICT] THEN AP_TERM_TAC THEN
    REWRITE_TAC [POWSER_RING, ring_polynomial] THEN SET_TAC [])

  let POLY_CARRIER_SUBRING_OF_POWSER_RING ← prove
   r"!(r:A ring) (s:V->bool).
        ring_carrier(poly_ring r s) subring_of powser_ring r s"
   (REWRITE_TAC [SUBRING_SUBRING_GENERATED, POLY_RING_AS_SUBRING])

  let RING_MONOMORPHISM_POLY_POWSER ← prove
   r"!r s:A->bool. ring_monomorphism(poly_ring r s,powser_ring r s) (\x. x)"
   (REWRITE_TAC [POLY_RING_AS_SUBRING, RING_MONOMORPHISM_INCLUSION])

  let POLY_RING ← prove
   r"(!(r:A ring) (s:V->bool).
        ring_carrier(poly_ring r s) =
        {p | ring_polynomial r p /\ poly_vars r p SUBSET s}) /\
   (!(r:A ring) (s:V->bool). ring_0(poly_ring r s) = poly_0 r) /\
   (!(r:A ring) (s:V->bool). ring_1(poly_ring r s) = poly_1 r) /\
   (!(r:A ring) (s:V->bool). ring_neg(poly_ring r s) = poly_neg r) /\
   (!(r:A ring) (s:V->bool). ring_add(poly_ring r s) = poly_add r) /\
   (!(r:A ring) (s:V->bool). ring_mul(poly_ring r s) = poly_mul r)"
   (REWRITE_TAC [POLY_RING_AS_SUBRING] THEN
    SIMP_TAC [CARRIER_SUBRING_GENERATED_SUBRING,
              POLY_RING_SUBRING_OF_POWSER_RING] THEN
    REWRITE_TAC [SUBRING_GENERATED] THEN REWRITE_TAC [POWSER_RING])

  let POLY_IN_POWSER_RING ← prove
   r"!(r:A ring) (v:V->bool) p.
        p IN ring_carrier(poly_ring r v)
        ==> p IN ring_carrier(powser_ring r v)"
   (REWRITE_TAC [POLY_RING, POWSER_RING, IN_ELIM_THM] THEN
    SIMP_TAC [RING_POLYNOMIAL_IMP_POWERSERIES])

  let poly_pow ← new_definition
   r"poly_pow (r:A ring) = ring_pow (powser_ring r (:V))"

  let POLY_POW ← prove
   r"(!r p. poly_pow r (p:(V->num)->A) 0 = poly_1 r) /\
   (!r p n. poly_pow r (p:(V->num)->A) (SUC n) =
            poly_mul r p (poly_pow r p n))"
   (REWRITE_TAC [poly_pow, ring_pow, POWSER_RING])

  let POLY_POW_ALT ← prove
   r"!r:A ring. poly_pow r = ring_pow (poly_ring r (:V))"
   (GEN_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN GEN_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [POLY_POW, ring_pow, POLY_RING])

  let RING_POWERSERIES_POW ← prove
   r"!r (p:(V->num)->A) n.
        ring_powerseries r p ==> ring_powerseries r (poly_pow r p n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN
    ASM_SIMP_TAC [POLY_POW, RING_POWERSERIES_MUL, RING_POWERSERIES_1])

  let RING_POLYNOMIAL_POW ← prove
   r"!r (p:(V->num)->A) n.
        ring_polynomial r p ==> ring_polynomial r (poly_pow r p n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN
    ASM_SIMP_TAC [POLY_POW, RING_POLYNOMIAL_MUL, RING_POLYNOMIAL_1])

  let POLY_POW_1 ← prove
   r"!r n. poly_pow r (poly_1 r:(V->num)->A) n = poly_1 r"
   (GEN_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [POLY_POW, RING_MUL_LID, RING_1,
                  RING_POWERSERIES_1, POLY_MUL_LID])

  let POLY_POW_0 ← prove
   r"!r n. poly_pow r (poly_0 r:(V->num)->A) n =
         if n = 0 then poly_1 r else poly_0 r"
   (GEN_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [POLY_POW, NOT_SUC] THEN
    COND_CASES_TAC THEN
    ASM_SIMP_TAC [POLY_MUL_0, RING_POLYNOMIAL_0, RING_POLYNOMIAL_1])

  let POLY_VARS_POW ← prove
   r"!r (p:(V->num)->A) n.
        ring_powerseries r p
        ==> poly_vars r (poly_pow r p n) SUBSET poly_vars r p"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [POLY_POW, POLY_VARS_1, EMPTY_SUBSET] THEN
    ASM SET_TAC [POLY_VARS_MUL, RING_POWERSERIES_POW])

  let POWSER_RING_CLAUSES ← prove
   r"(!(r:A ring) (s:V->bool).
        ring_carrier(powser_ring r s) =
        {p | ring_powerseries r p /\ poly_vars r p SUBSET s}) /\
   (!(r:A ring) (s:V->bool). ring_0(powser_ring r s) = poly_0 r) /\
   (!(r:A ring) (s:V->bool). ring_1(powser_ring r s) = poly_1 r) /\
   (!(r:A ring) (s:V->bool). ring_neg(powser_ring r s) = poly_neg r) /\
   (!(r:A ring) (s:V->bool). ring_add(powser_ring r s) = poly_add r) /\
   (!(r:A ring) (s:V->bool). ring_sub(powser_ring r s) = poly_sub r) /\
   (!(r:A ring) (s:V->bool). ring_mul(powser_ring r s) = poly_mul r) /\
   (!(r:A ring) (s:V->bool). ring_pow(powser_ring r s) = poly_pow r)"
   (REWRITE_TAC [POWSER_RING] THEN
    REPLICATE_TAC 2 (ONCE_REWRITE_TAC [FUN_EQ_THM]) THEN
    REWRITE_TAC [POLY_SUB, ring_sub, POWSER_RING] THEN
    REPLICATE_TAC 3 GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [POLY_POW, ring_pow, POWSER_RING])

  let POWSER_CLAUSES ← prove
   r"(!(r:A ring). {p | ring_powerseries r p} =
                 ring_carrier (powser_ring r (:V))) /\
   (!(r:A ring). poly_0 r = ring_0 (powser_ring r (:V))) /\
   (!(r:A ring). poly_1 r = ring_1 (powser_ring r (:V))) /\
   (!(r:A ring). poly_neg r = ring_neg (powser_ring r (:V))) /\
   (!(r:A ring). poly_add r = ring_add (powser_ring r (:V))) /\
   (!(r:A ring). poly_sub r = ring_sub (powser_ring r (:V))) /\
   (!(r:A ring). poly_mul r = ring_mul (powser_ring r (:V))) /\
   (!(r:A ring). poly_pow r = ring_pow (powser_ring r (:V)))"
   (REWRITE_TAC [POWSER_RING_CLAUSES, SUBSET_UNIV])

  let POLY_RING_CLAUSES ← prove
   r"(!(r:A ring) (s:V->bool).
        ring_carrier(poly_ring r s) =
        {p | ring_polynomial r p /\ poly_vars r p SUBSET s}) /\
   (!(r:A ring) (s:V->bool). ring_0(poly_ring r s) = poly_0 r) /\
   (!(r:A ring) (s:V->bool). ring_1(poly_ring r s) = poly_1 r) /\
   (!(r:A ring) (s:V->bool). ring_neg(poly_ring r s) = poly_neg r) /\
   (!(r:A ring) (s:V->bool). ring_add(poly_ring r s) = poly_add r) /\
   (!(r:A ring) (s:V->bool). ring_sub(poly_ring r s) = poly_sub r) /\
   (!(r:A ring) (s:V->bool). ring_mul(poly_ring r s) = poly_mul r) /\
   (!(r:A ring) (s:V->bool). ring_pow(poly_ring r s) = poly_pow r)"
   (REWRITE_TAC [POLY_RING] THEN
    REPLICATE_TAC 2 (ONCE_REWRITE_TAC [FUN_EQ_THM]) THEN
    REWRITE_TAC [POLY_SUB, ring_sub, POLY_RING] THEN
    REPLICATE_TAC 3 GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [POLY_POW, ring_pow, POLY_RING])

  let POLY_CLAUSES ← prove
   r"(!(r:A ring). {p | ring_polynomial r p} = ring_carrier (poly_ring r (:V))) /\
   (!(r:A ring). poly_0 r = ring_0 (poly_ring r (:V))) /\
   (!(r:A ring). poly_1 r = ring_1 (poly_ring r (:V))) /\
   (!(r:A ring). poly_neg r = ring_neg (poly_ring r (:V))) /\
   (!(r:A ring). poly_add r = ring_add (poly_ring r (:V))) /\
   (!(r:A ring). poly_sub r = ring_sub (poly_ring r (:V))) /\
   (!(r:A ring). poly_mul r = ring_mul (poly_ring r (:V))) /\
   (!(r:A ring). poly_pow r = ring_pow (poly_ring r (:V)))"
   (REWRITE_TAC [POLY_RING_CLAUSES, SUBSET_UNIV])

  let POLY_SUBRING_GENERATED_CLAUSES ← prove
   r"(!(r:A ring) s (v:V->bool).
        ring_0 (poly_ring (subring_generated r s) v) =
        ring_0 (poly_ring r v)) /\
   (!(r:A ring) s (v:V->bool).
        ring_1 (poly_ring (subring_generated r s) v) =
        ring_1 (poly_ring r v)) /\
   (!(r:A ring) s (v:V->bool).
        ring_neg (poly_ring (subring_generated r s) v) =
        ring_neg (poly_ring r v)) /\
   (!(r:A ring) s (v:V->bool).
        ring_add (poly_ring (subring_generated r s) v) =
        ring_add (poly_ring r v)) /\
   (!(r:A ring) s (v:V->bool) p q.
        (!m. p m IN ring_carrier(subring_generated r s)) /\
        (!m. q m IN ring_carrier(subring_generated r s))
        ==> ring_mul (poly_ring (subring_generated r s) v) p q =
            ring_mul (poly_ring r v) p q) /\
   (!(r:A ring) s (v:V->bool).
        ring_sub (poly_ring (subring_generated r s) v) =
        ring_sub (poly_ring r v))"
   (REWRITE_TAC [POLY_RING_CLAUSES, poly_0, poly_1, poly_add, poly_neg, poly_mul,
                 poly_sub, poly_const, FUN_EQ_THM, ← CONJUNCT2 SUBRING_GENERATED,
                 RING_SUB_SUBRING_GENERATED, RING_SUM_SUBRING_GENERATED_GEN] THEN
    REPEAT STRIP_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, FORALL_IN_GSPEC, SUBSET, IMP_CONJ] THEN
    REWRITE_TAC [IN_ELIM_PAIR_THM] THEN ONCE_REWRITE_TAC [IN_ELIM_THM] THEN
    REWRITE_TAC [IN_ELIM_PAIR_THM] THEN
    ASM_MESON_TAC [RING_MUL, ← CONJUNCT2 SUBRING_GENERATED])

  let POLY_CONST_SUBRING_GENERATED ← prove
   r"!r s c:A. poly_const (subring_generated r s) a = poly_const r a"
   (REWRITE_TAC [poly_const, SUBRING_GENERATED])

  let POWSER_MONOMIAL_IN_CARRIER ← prove
   r"!r s (p:(V->num)->A) m.
        p IN ring_carrier (powser_ring r s) ==> p m IN ring_carrier r"
   (SIMP_TAC [POWSER_RING, ring_powerseries, IN_ELIM_THM])

  let POLY_MONOMIAL_IN_CARRIER ← prove
   r"!r s (p:(V->num)->A) m.
        p IN ring_carrier (poly_ring r s) ==> p m IN ring_carrier r"
   (SIMP_TAC [POLY_RING, ring_polynomial, ring_powerseries, IN_ELIM_THM])

  let RING_POLYNOMIAL ← prove
   r"!(r:A ring) p. ring_polynomial r p <=> p IN ring_carrier(poly_ring r (:V))"
   (REWRITE_TAC [FUN_EQ_THM, POLY_RING, SUBSET_UNIV, IN_ELIM_THM])

  let RING_POWERSERIES ← prove
   r"!(r:A ring) p.
        ring_powerseries r p <=> p IN ring_carrier(powser_ring r (:V))"
   (REWRITE_TAC [POWSER_RING_CLAUSES, IN_ELIM_THM, SUBSET_UNIV])

  let IN_POLY_RING_CARRIER ← prove
   r"!(r:A ring) (s:V->bool).
        p IN ring_carrier(poly_ring r s) <=>
        ring_polynomial r p /\ poly_vars r p SUBSET s"
   (REWRITE_TAC [POLY_RING, IN_ELIM_THM])

  let RING_POLYNOMIAL_CARRIER_GEN ← prove
   r"!(r:A ring) (s:V->bool) p.
        poly_vars r p SUBSET s
        ==> (ring_polynomial r p <=> p IN ring_carrier(poly_ring r s))"
   (SIMP_TAC [IN_POLY_RING_CARRIER])

  let RING_POLYNOMIAL_CARRIER ← prove
   r"!r (p:(V->num)->A).
        ring_polynomial r p <=>
        p IN ring_carrier(poly_ring r (poly_vars r p))"
   (MESON_TAC [RING_POLYNOMIAL_CARRIER_GEN, SUBSET_REFL])

  let POLY_MONOMIALS_FINITE ← prove
   r"!(r:A ring) (s:V->bool).
        p IN ring_carrier(poly_ring r s)
        ==> FINITE {m | ~(p m = ring_0 r)}"
   (SIMP_TAC [IN_POLY_RING_CARRIER, ring_polynomial])

  let FINITE_POLY_VARS ← prove
   r"!(r:A ring) (s:V->bool) p.
        p IN ring_carrier(poly_ring r s) ==> FINITE(poly_vars r p)"
   (SIMP_TAC [FINITE_POLYNOMIAL_VARS, POLY_RING, IN_ELIM_THM])

  let RING_CARRIER_POLY_RING_FINITE ← prove
   r"!(r:A ring) (s:V->bool).
           ring_carrier(poly_ring r s) =
           ring_carrier(powser_ring r s) INTER
           {p | FINITE {m | ~(p m = ring_0 r)}}"
   (REWRITE_TAC [POLY_RING, POWSER_RING, ring_polynomial] THEN SET_TAC [])

  let POWSER_RING_MONO ← prove
   r"!r s t (p:(V->num)->A).
        s SUBSET t /\ p IN ring_carrier(powser_ring r s)
        ==> p IN ring_carrier(powser_ring r t)"
   (REWRITE_TAC [POWSER_RING] THEN SET_TAC [])

  let POLY_RING_MONO ← prove
   r"!r s t (p:(V->num)->A).
        s SUBSET t /\ p IN ring_carrier(poly_ring r s)
        ==> p IN ring_carrier(poly_ring r t)"
   (REWRITE_TAC [POLY_RING] THEN SET_TAC [])

  let POLY_RING_POLY_VARS ← prove
   r"!r (p:(V->num)->A).
        p IN ring_carrier(poly_ring r (poly_vars r p)) <=>
        ring_polynomial r p"
   (REWRITE_TAC [POLY_RING, IN_ELIM_THM, SUBSET_REFL])

  let POLY_RING_IN_POLY_VARS ← prove
   r"!(r:A ring) (v:V->bool) p.
        p IN ring_carrier(poly_ring r v)
        ==> p IN ring_carrier(poly_ring r (poly_vars r p))"
   (SIMP_TAC [POLY_RING, IN_ELIM_THM, SUBSET_REFL])

  let POLY_RING_IN_FINITE_VARIABLES ← prove
   r"!r v (p:(V->num)->A).
        p IN ring_carrier(poly_ring r v)
        ==> ?w. FINITE w /\ w SUBSET v /\ p IN ring_carrier(poly_ring r w)"
   (REWRITE_TAC [POLY_RING, IN_ELIM_THM] THEN
    MESON_TAC [FINITE_POLY_VARS, IN_POLY_RING_CARRIER, SUBSET_REFL])

  let IN_POLY_RING_SUBRING_GENERATED_FINITARY ← prove
   r"!r s v (p:(V->num)->A).
        p IN ring_carrier(poly_ring (subring_generated r s) v)
        ==> ?t. FINITE t /\
                t SUBSET s /\
                p IN ring_carrier(poly_ring (subring_generated r t) v)"
   (REWRITE_TAC [POLY_RING, ring_polynomial, ring_powerseries, poly_vars] THEN
    REWRITE_TAC [IN_ELIM_THM, ← CONJUNCT2 SUBRING_GENERATED] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL
     [← q "r:A ring", ← q "s:A->bool", ← q r"IMAGE (p:(V->num)->A) UNIV"]
     SUBSET_SUBRING_GENERATED_FINITARY) THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV] THEN
    DISCH_THEN MATCH_MP_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
     (← q r"ring_0 r INSERT IMAGE (p:(V->num)->A) {m | ~(p m = ring_0 r)}") THEN
    ASM_SIMP_TAC [FINITE_INSERT, FINITE_IMAGE] THEN SET_TAC [])

  let POLY_VAR ← prove
   r"!(r:A ring) (s:V->bool) i.
        poly_var r i IN ring_carrier(poly_ring r s) <=>
        trivial_ring r \/ i IN s"
   (REWRITE_TAC [POLY_RING, IN_ELIM_THM, RING_POLYNOMIAL_VAR] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [POLY_VARS_VAR] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [EMPTY_SUBSET, SING_SUBSET])

  let POLY_VAR_UNIV ← prove
   r"!(r:A ring) i. poly_var r i IN ring_carrier (poly_ring r (:V))"
   (REWRITE_TAC [POLY_VAR, IN_UNIV])

  let POLY_CONST ← prove
   r"!(r:A ring) (s:V->bool) c.
        poly_const r c IN ring_carrier(poly_ring r s) <=>
        c IN ring_carrier r"
   (REWRITE_TAC [POLY_RING, IN_ELIM_THM, RING_POLYNOMIAL_CONST] THEN
    REWRITE_TAC [POLY_VARS_CONST, EMPTY_SUBSET])

  let POWSER_VAR ← prove
   r"!(r:A ring) (s:V->bool) i.
        poly_var r i IN ring_carrier(powser_ring r s) <=>
        trivial_ring r \/ i IN s"
   (REWRITE_TAC [POWSER_RING, IN_ELIM_THM, RING_POWERSERIES_VAR] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [POLY_VARS_VAR] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [EMPTY_SUBSET, SING_SUBSET])

  let POWSER_VAR_UNIV ← prove
   r"!(r:A ring) i. poly_var r i IN ring_carrier (powser_ring r (:V))"
   (REWRITE_TAC [POWSER_VAR, IN_UNIV])

  let POWSER_CONST ← prove
   r"!(r:A ring) (s:V->bool) c.
        poly_const r c IN ring_carrier(powser_ring r s) <=>
        c IN ring_carrier r"
   (REWRITE_TAC [POWSER_RING, IN_ELIM_THM, RING_POWERSERIES_CONST] THEN
    REWRITE_TAC [POLY_VARS_CONST, EMPTY_SUBSET])

  let POLY_CONST_NEG ← prove
   r"!r x. poly_const r (ring_neg r x):(V->num)->A =
         poly_neg r (poly_const r x)"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"m:V->num") THEN REWRITE_TAC [poly_const, poly_neg] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [RING_NEG_0])

  let POLY_CONST_ADD ← prove
   r"!r x y.
        poly_const r (ring_add r x y):(V->num)->A =
        poly_add r (poly_const r x) (poly_const r y)"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"m:V->num") THEN REWRITE_TAC [poly_const, poly_add] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [RING_ADD_RZERO, RING_0])

  let POLY_CONST_MUL ← prove
   r"!r x y.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> poly_const r (ring_mul r x y):(V->num)->A =
            poly_mul r (poly_const r x) (poly_const r y)"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"m:V->num") THEN REWRITE_TAC [poly_const, poly_mul] THEN
    ASM_SIMP_TAC [← MESON [RING_0, RING_MUL_LZERO, RING_MUL_RZERO]
     (← q r"x IN ring_carrier r /\ y IN ring_carrier r
      ==> ring_mul r (if p then x else ring_0 r)
                      (if q then y else ring_0 r) =
          (if p /\ q then ring_mul r x y else ring_0 r)")] THEN
    ASM_REWRITE_TAC [← GSYM PAIR_EQ, ← GSYM LAMBDA_PAIR_THM] THEN
    ASM_SIMP_TAC [RING_SUM_DELTA, IN_ELIM_PAIR_THM, RING_MUL] THEN
    REWRITE_TAC [MONOMIAL_MUL_LID] THEN MESON_TAC [])

  let RING_OF_NUM_POWSER_RING ← prove
   r"!(r:A ring) (s:V->bool) n.
        ring_of_num (powser_ring r s) n = poly_const r (ring_of_num r n)"
   (GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THEN
    REWRITE_TAC [ring_of_num, POWSER_RING_CLAUSES] THENL
     [REWRITE_TAC [← GSYM POLY_CONST_0], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM POLY_CONST_1, ← GSYM POLY_CONST_ADD, RING_OF_NUM, RING_1])

  let RING_OF_NUM_POLY_RING ← prove
   r"!(r:A ring) (s:V->bool) n.
        ring_of_num (poly_ring r s) n = poly_const r (ring_of_num r n)"
   (REWRITE_TAC [POLY_RING_AS_SUBRING, RING_OF_NUM_SUBRING_GENERATED] THEN
    REWRITE_TAC [RING_OF_NUM_POWSER_RING])

  let POLY_CONST_OF_NUM ← prove
   r"!(r:A ring) n.
   poly_const r (ring_of_num r n) = ring_of_num (poly_ring r (:V)) n"
   (REWRITE_TAC [RING_OF_NUM_POLY_RING])

  let POLY_CONST_EQ ← prove
   r"!r x y. poly_const r x :(V->num)->A = poly_const r y <=> x = y"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN
    REWRITE_TAC [poly_const] THEN MESON_TAC [])

  let POLY_CONST_EQ_0 ← prove
   r"!r x. poly_const r x :(V->num)->A = poly_0 r <=> x = ring_0 r"
   (REWRITE_TAC [← GSYM POLY_CONST_0, POLY_CONST_EQ])

  let POLY_CONST_EQ_1 ← prove
   r"!r x. poly_const r x :(V->num)->A = poly_1 r <=> x = ring_1 r"
   (REWRITE_TAC [← GSYM POLY_CONST_1, POLY_CONST_EQ])

  let POWSER_VAR_MUL_EQ_0 ← prove
   r"(!(r:A ring) p (x:V).
        ring_powerseries r p
        ==> (poly_mul r (poly_var r x) p = poly_0 r <=> p = poly_0 r)) /\
   (!(r:A ring) p (x:V).
        ring_powerseries r p
        ==> (poly_mul r p (poly_var r x) = poly_0 r <=> p = poly_0 r))"
   (← do
    -- right to left: the MONOMIAL_RULE, then the TAUT
    let mr ← MONOMIAL_RULE (← q "monomial_div (monomial_mul m1 m2) m1 = m2")
    let tt ← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")
    pure (MATCH_MP_TAC tt THEN CONJ_TAC THENL
     [MESON_TAC [POLY_MUL_SYM, RING_POWERSERIES_VAR],
      REPEAT STRIP_TAC] THEN
    EQ_TAC THEN
    SIMP_TAC [POWSER_MUL_0, RING_POLYNOMIAL_IMP_POWERSERIES,
              RING_POWERSERIES_VAR] THEN
    ASM_SIMP_TAC [POWSER_VAR_MUL] THEN GEN_REWRITE_TAC BINOP_CONV [FUN_EQ_THM] THEN
    REWRITE_TAC [POLY_0] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"m:V->num") THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "monomial_mul (monomial_var(x:V)) m")) THEN
    REWRITE_TAC [MONOMIAL_VAR_DIVIDES_MUL, MONOMIAL_DIVIDES_REFL] THEN
    REWRITE_TAC [mr] THEN
    MESON_TAC []))

  let POWSER_VARPOW_MUL_EQ_0 ← prove
   r"(!(r:A ring) p (x:V) k.
        ring_powerseries r p
        ==> (poly_mul r (poly_pow r (poly_var r x) k) p = poly_0 r <=>
             p = poly_0 r)) /\
   (!(r:A ring) p (x:V) k.
        ring_powerseries r p
        ==> (poly_mul r p (poly_pow r (poly_var r x) k) = poly_0 r <=>
             p = poly_0 r))"
   (MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN CONJ_TAC THENL
     [MESON_TAC [POLY_MUL_SYM, RING_POWERSERIES_VAR, RING_POWERSERIES_POW],
      REPEAT STRIP_TAC] THEN
    SPEC_TAC (← q "k:num", ← q "k:num") THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [POLY_POW, POLY_MUL_LID, RING_POWERSERIES_MUL,
                  ← GSYM POLY_MUL_ASSOC, RING_POWERSERIES_POW, RING_POWERSERIES_VAR,
                  POWSER_VAR_MUL_EQ_0])

  let RING_HOMOMORPHISM_POLY_CONST ← prove
   r"!(r:A ring) (s:V->bool).
        ring_homomorphism (r,poly_ring r s) (poly_const r)"
   (REWRITE_TAC [ring_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    SIMP_TAC [POLY_CONST, POLY_CONST_NEG, POLY_CONST_ADD, POLY_CONST_MUL] THEN
    REWRITE_TAC [POLY_RING, poly_0, poly_1])

  let RING_MONOMORPHISM_POLY_CONST ← prove
   r"!(r:A ring) (s:V->bool).
        ring_monomorphism (r,poly_ring r s) (poly_const r)"
   (REWRITE_TAC [ring_monomorphism, RING_HOMOMORPHISM_POLY_CONST] THEN
    SIMP_TAC [POLY_CONST_EQ])

  let RING_HOMOMORPHISM_POWSER_CONST ← prove
   r"!(r:A ring) (s:V->bool).
        ring_homomorphism (r,powser_ring r s) (poly_const r)"
   (REWRITE_TAC [ring_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    SIMP_TAC [POWSER_CONST, POLY_CONST_NEG, POLY_CONST_ADD, POLY_CONST_MUL] THEN
