            POLY_CONST, RING_ADD],
           ALL_TAC] THEN
          SUBGOAL_THEN (← q r"~(nn = 0) /\
            kk + poly_deg (r:A ring) (g:(1->num)->A) = nn")
           STRIP_ASSUME_TAC THENL
          [SUBGOAL_THEN (← q "~(poly_deg (r:A ring) (g:(1->num)->A) = 0)") MP_TAC THENL
           [DISCH_TAC THEN
            UNDISCH_TAC
             (← q "(g:(1->num)->A) IN ring_carrier(poly_ring r (:1))") THEN
            REWRITE_TAC [IN_POLY_RING_CARRIER] THEN
            DISCH_THEN (MP_TAC o MATCH_MP POLY_DEG_EQ_0 o
