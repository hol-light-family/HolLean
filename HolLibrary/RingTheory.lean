    wPart lhand (fun t => do lhand (← rand t)) MONOMIAL_DEG_MUL THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [RING_POLYNOMIAL_CARRIER, POLY_MONOMIALS, MONOMIAL_UNIV],
      DISCH_THEN SUBST1_TAC] THEN
