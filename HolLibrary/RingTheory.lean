        x IN ring_carrier(poly_ring r w) /\ x IN j}"))) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:(V->num)->A")
      (CONJUNCTS_THEN2 ASSUME_TAC
        (STRIP_ASSUME_TAC o REWRITE_RULE [IN_ELIM_THM]))) THEN
    EXISTS_TAC (← q r"p:(V->num)->A") THEN CONJ_TAC THENL
    [MP_TAC (← ISPECL [← q "r:A ring", ← q r"w:V->bool", ← q r"s:V->bool",
       ← q r"p:(V->num)->A"] RING_PRIME_POLY_RING_MONO) THEN
     ASM_REWRITE_TAC [],
     ASM_REWRITE_TAC []]))

  -- @@RETURN BEGIN
  return { UFD_POLY_RING }
