  let RING_POLYNOMIAL_MUL ← prove
   r"!r p1 (p2:(V->num)->A).
        ring_polynomial r p1 /\ ring_polynomial r p2
        ==> ring_polynomial r (poly_mul r p1 p2)"
   (REPEAT GEN_TAC THEN SIMP_TAC [ring_polynomial, RING_POWERSERIES_MUL] THEN
