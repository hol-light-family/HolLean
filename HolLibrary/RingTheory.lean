     [DISCH_TAC THEN
      UNDISCH_TAC (← q "1 <= poly_deg r (f:(1->num)->A)") THEN
      ASM_REWRITE_TAC [POLY_RING, POLY_DEG_0] THEN ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "f:(1->num)->A"] POLY_MAKE_PRIMITIVE) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "c:A") (X_CHOOSE_THEN (← q "g:(1->num)->A")
        STRIP_ASSUME_TAC)) THEN
    SUBGOAL_THEN
      (← q r"!m:(1->num). (f:(1->num)->A) m =
       ring_mul (r:A ring) c ((g:(1->num)->A) m)")
    ASSUME_TAC THENL
     [GEN_TAC THEN ASM_SIMP_TAC [POLY_RING_CLAUSES,
        POLY_MUL_CONST, RING_POLYNOMIAL, BETA_THM],
      ALL_TAC] THEN
    ABBREV_TAC (← q "n = poly_deg r (f:(1->num)->A)") THEN
    SUBGOAL_THEN (← q "poly_deg r (g:(1->num)->A) = n") ASSUME_TAC THENL
     [ASM_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q "(p:A) IN ring_carrier r") ASSUME_TAC THENL
     [ASM_MESON_TAC [ring_prime], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"(g:(1->num)->A) (\v:1. n) IN ring_carrier r")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER], ALL_TAC] THEN
    SUBGOAL_THEN (← q "~ring_divides r (p:A) c") ASSUME_TAC THENL
     [DISCH_TAC THEN
      UNDISCH_TAC
        (← q r"~ring_divides r (p:A)
          ((f:(1->num)->A) (\v:1. n))") THEN
      REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(\v:1. (n:num))")) THEN
      DISCH_THEN SUBST1_TAC THEN  MATCH_MP_TAC RING_DIVIDES_RMUL THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"~ring_divides r (p:A) ((g:(1->num)->A) (\v:1. n))")
    ASSUME_TAC THENL
     [UNDISCH_TAC
        (← q r"~ring_divides r (p:A)
          ((f:(1->num)->A) (\v:1. n))") THEN
      REWRITE_TAC [CONTRAPOS_THM] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o
        SPEC (← q r"(\v:1. (n:num))")) THEN
      DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC RING_DIVIDES_LMUL THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"!k. k < n ==>
       ring_divides r (p:A) ((g:(1->num)->A) (\v:1. k))")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q "k:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN
        (← q r"ring_divides r p
          (ring_mul r (c:A) ((g:(1->num)->A) (\v:1. k)))")
      MP_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(\v:1. k):(1->num)")) THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        ASM_MESON_TAC [ring_prime, POLY_MONOMIAL_IN_CARRIER]],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"~ring_divides r (ring_pow r (p:A) 2)
         ((g:(1->num)->A) monomial_1)")
    ASSUME_TAC THENL
     [DISCH_TAC THEN
      UNDISCH_TAC
        (← q r"~ring_divides r (ring_pow r (p:A) 2)
          ((f:(1->num)->A) monomial_1)") THEN
      REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "monomial_1:(1->num)")) THEN
      DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC RING_DIVIDES_LMUL THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q "ring_irreducible (poly_ring r (:1)) (g:(1->num)->A)")
      ASSUME_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE [coeff] EISENSTEIN_IRREDUCIBILITY) THEN
      EXISTS_TAC (← q "p:A") THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"ring_irreducible
        (poly_ring (fraction_ring r) (:1))
        ((frc:A->(A#A->bool)) o (g:(1->num)->A))")
      ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q "r:A ring", ← q "g:(1->num)->A"]
        IRREDUCIBLE_PRIMITIVE_POLY_FRACTION_RING) THEN
      ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      UNDISCH_TAC
        (← q r"ring_fractionate (r:A ring) {a | ring_regular r a} =
         (frc:A->(A#A->bool))") THEN
      DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"(frc:A->(A#A->bool)) o (f:(1->num)->A) =
       ring_mul (poly_ring (fraction_ring r) (:1))
         (poly_const (fraction_ring r) (frc c))
         (frc o (g:(1->num)->A))")
      ASSUME_TAC THENL
     [SUBGOAL_THEN
        (← q r"(frc:A->(A#A->bool)) o
           poly_const (r:A ring) c =
         poly_const (fraction_ring r) (frc c)
         :(1->num)->(A#A->bool)")
        ASSUME_TAC THENL
      [MATCH_MP_TAC POLY_COMPOSE_HOMOMORPHISM_CONST THEN
       ASM_REWRITE_TAC [], ALL_TAC] THEN
      UNDISCH_TAC
        (← q r"f = ring_mul (poly_ring r (:1))
          (poly_const r (c:A)) (g:(1->num)->A)") THEN
      DISCH_THEN SUBST1_TAC THEN
      UNDISCH_TAC
        (← q r"ring_homomorphism (poly_ring r (:1),
          poly_ring (fraction_ring r) (:1))
          (\p:(1->num)->A. (frc:A->(A#A->bool)) o p)") THEN
      DISCH_THEN (MP_TAC o MATCH_MP RING_HOMOMORPHISM_MUL) THEN
      DISCH_THEN (MP_TAC o SPECL
        [← q "poly_const r (c:A):(1->num)->A",
         ← q "g:(1->num)->A"]) THEN
      ANTS_TAC THENL
      [ASM_SIMP_TAC [POLY_CONST], ALL_TAC] THEN
      CONV_TAC (DEPTH_CONV BETA_CONV) THEN
      DISCH_THEN SUBST1_TAC THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"ring_unit (poly_ring (fraction_ring (r:A ring)) (:1))
        (poly_const (fraction_ring r) ((frc:A->(A#A->bool)) c)
         :(1->num)->(A#A->bool))")
      ASSUME_TAC THENL
     [REWRITE_TAC [RING_UNIT_POLY_CONST] THEN
      MP_TAC (← ISPEC (← q "fraction_ring (r:A ring)") FIELD_UNIT) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [],
        ASM_MESON_TAC [RING_MONOMORPHISM_EQ_0]],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"(frc:A->(A#A->bool)) o (g:(1->num)->A) IN
       ring_carrier(poly_ring (fraction_ring r) (:1))")
      ASSUME_TAC THENL
     [UNDISCH_TAC
        (← q r"ring_homomorphism (poly_ring r (:1),
          poly_ring (fraction_ring r) (:1))
          (\p:(1->num)->A. (frc:A->(A#A->bool)) o p)") THEN
      REWRITE_TAC [ring_homomorphism, SUBSET,
        FORALL_IN_IMAGE] THEN
      CONV_TAC (DEPTH_CONV BETA_CONV) THEN
      DISCH_THEN (MP_TAC o CONJUNCT1) THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
      [← q "poly_ring (fraction_ring (r:A ring)) (:1)",
       ← q "(frc:A->(A#A->bool)) o (g:(1->num)->A)",
       ← q "(frc:A->(A#A->bool)) o (f:(1->num)->A)"]
      RING_ASSOCIATES_IRREDUCIBLE) THEN
    ANTS_TAC THENL
    [CONJ_TAC THENL
     [ASM_MESON_TAC [INTEGRAL_DOMAIN_POLY_RING,
        FIELD_IMP_INTEGRAL_DOMAIN],
      UNDISCH_TAC
        (← q r"(frc:A->(A#A->bool)) o (f:(1->num)->A) =
         ring_mul (poly_ring (fraction_ring r) (:1))
           (poly_const (fraction_ring r) (frc c))
           (frc o (g:(1->num)->A))") THEN
      DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC RING_ASSOCIATES_LMUL THEN
      ASM_REWRITE_TAC []],
     DISCH_THEN (fun th => tactic_of do pure (ASM_REWRITE_TAC [← GSYM th]))])

  -- @@RETURN BEGIN
  return { EISENSTEIN_IRREDUCIBILITY_GEN, EISENSTEIN_IRREDUCIBILITY,
           EISENSTEIN_IRREDUCIBILITY_FRACTION_RING }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The order of an element in a ring (or in its multiplicative monoid).      -/
/- (ringtheory.ml 29320-29498)                                               -/
/- ------------------------------------------------------------------------- -/

structure RingOrder where
  -- @@FIELDS
  RING_ORDER_DIVIDES : thm
  RING_POW_EQ_1 : thm
  RING_ORDER_EQ_0 : thm
  RING_ORDER_EQ_1 : thm
  RING_ORDER_UNIQUE : thm
  RING_POW_RING_ORDER : thm
  RING_ORDER_1 : thm
  RING_POW_GCD_EQ_1 : thm
  RING_POW_COPRIME_EQ_1 : thm
  RING_ORDER_MUL_DIVIDES_GEN : thm
  RING_ORDER_MUL_DIVIDES : thm
  RING_ORDER_MUL_DIVIDES_LCM : thm
  RING_POW_MOD_ORDER_GEN : thm
  RING_POW_MOD_ORDER : thm
  RING_ORDER_POW : thm
  RING_ORDER_POW_GEN : thm
  RING_ORDER_POW_DIVIDES : thm
  RING_ORDER_UNIQUE_PRIME : thm
  RING_ORDER_MUL : thm
  deriving Inhabited

@[nospecialize]
def setupRingOrder [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) :
    ExceptT String IO RingOrder := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, NUMBER_RULE, NUMBER_TAC, new_specification, .. } := D
  let { COPRIME_GCD, DIVIDES_ANTISYM, DIVIDES_ONE, DIVIDES_REFL, DIVISION_SIMP,
        DIV_MULT, EQ_TRANS, .. } := D.core2
  let { IMP_CONJ, .. } := D.core4
  let { MULT_SYM, ORDER_EXISTENCE_GEN, .. } := D.core6
  let { SKOLEM_THM, .. } := D.core7
  let { divides, prime, .. } := D.core8
  let { RING_1, RING_MUL, RING_MUL_LID, RING_MUL_RID, .. } := BBasics
  let { RING_MUL_POW, RING_POW, RING_POW_1, RING_POW_ADD, RING_POW_MUL, RING_POW_ONE,
        ring_pow, .. } := BNumbers
  -- @@SCOPE END

  let RING_ORDER_DIVIDES ← do
    let eth ← prove
     r"!r x:A. ?d. !n. x IN ring_carrier r ==> ring_pow r x n = ring_1 r <=>
                     d divides n"
     (REPEAT GEN_TAC THEN MP_TAC (← ISPECL
       [← q r"\y. (x:A) IN ring_carrier r ==> y = ring_1 r", ← q r"\n. ring_pow r (x:A) n"]
       ORDER_EXISTENCE_GEN) THEN
      REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
      SIMP_TAC [ring_pow, RING_POW_ADD, RING_MUL_LID, RING_POW])
    new_specification ["ring_order"] (← REWRITE_RULE [SKOLEM_THM] (← GSYM eth))

  let RING_POW_EQ_1 ← prove
   r"!r (x:A) n.
        x IN ring_carrier r
        ==> (ring_pow r x n = ring_1 r <=> ring_order r x divides n)"
   (SIMP_TAC [RING_ORDER_DIVIDES])

  let RING_ORDER_EQ_0 ← prove
   r"!r (x:A).
        x IN ring_carrier r
        ==> (ring_order r x = 0 <=>
             !n. ring_pow r x n = ring_1 r <=> n = 0)"
   (SIMP_TAC [RING_POW_EQ_1] THEN MESON_TAC [← NUMBER_RULE
     (← q r"(!n:num. n divides n) /\ (!n. 0 divides n <=> n = 0)")])

  let RING_ORDER_EQ_1 ← prove
   r"!r (x:A).
        x IN ring_carrier r
        ==> (ring_order r x = 1 <=> x = ring_1 r)"
   (SIMP_TAC [← GSYM DIVIDES_ONE, RING_ORDER_DIVIDES, RING_POW_1])

  let RING_ORDER_UNIQUE ← prove
   r"!r (x:A) d.
        x IN ring_carrier r
        ==> (ring_order r x = d <=>
             !n. ring_pow r x n = ring_1 r <=> d divides n)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_POW_EQ_1) THEN
    EQ_TAC THENL [ASM_MESON_TAC [], ASM_REWRITE_TAC []] THEN
    MESON_TAC [DIVIDES_ANTISYM, ← NUMBER_RULE (← q "(n:num) divides n")])

  let RING_POW_RING_ORDER ← prove
   r"!r (x:A). x IN ring_carrier r ==> ring_pow r x (ring_order r x) = ring_1 r"
   (SIMP_TAC [RING_POW_EQ_1, DIVIDES_REFL])

  let RING_ORDER_1 ← prove
   r"!r:A ring. ring_order r (ring_1 r) = 1"
   (SIMP_TAC [RING_ORDER_EQ_1, RING_1])

  let RING_POW_GCD_EQ_1 ← prove
   r"!r (x:A) m n.
        x IN ring_carrier r
        ==> (ring_pow r x (gcd(m,n)) = ring_1 r <=>
             ring_pow r x m = ring_1 r /\ ring_pow r x n = ring_1 r)"
   (SIMP_TAC [RING_POW_EQ_1] THEN CONV_TAC (fun t => (NUMBER_RULE t).run))

  let RING_POW_COPRIME_EQ_1 ← prove
   r"!r (x:A) m n.
        x IN ring_carrier r /\ coprime(m,n)
        ==> (ring_pow r x m = ring_1 r /\ ring_pow r x n = ring_1 r <=>
             x = ring_1 r)"
   (SIMP_TAC [← GSYM RING_POW_GCD_EQ_1, COPRIME_GCD, RING_POW_1])

  let RING_ORDER_MUL_DIVIDES_GEN ← prove
   r"!r (x:A) y n.
        x IN ring_carrier r /\ y IN ring_carrier r /\
        ring_order r x divides n /\ ring_order r y divides n
        ==> ring_order r (ring_mul r x y) divides n"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [← GSYM RING_POW_EQ_1, IMP_CONJ, RING_MUL] THEN
    SIMP_TAC [RING_MUL_POW, RING_MUL_LID, RING_1])

  let RING_ORDER_MUL_DIVIDES ← prove
   r"!r (x:A) y.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_order r (ring_mul r x y) divides
            (ring_order r x * ring_order r y)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_ORDER_MUL_DIVIDES_GEN THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => (NUMBER_RULE t).run))

  let RING_ORDER_MUL_DIVIDES_LCM ← prove
   r"!r (x:A) y.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_order r (ring_mul r x y) divides
            lcm(ring_order r x,ring_order r y)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_ORDER_MUL_DIVIDES_GEN THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => (NUMBER_RULE t).run))

  let RING_POW_MOD_ORDER_GEN ← prove
   r"!r (x:A) d k.
        x IN ring_carrier r /\ ring_pow r x d = ring_1 r
        ==> ring_pow r x k = ring_pow r x (k MOD d)"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS (← q "ring_pow r (x:A) (d * k DIV d + k MOD d)") THEN
    CONJ_TAC THENL [REWRITE_TAC [DIVISION_SIMP], ALL_TAC] THEN
    ASM_SIMP_TAC [RING_POW_ADD, RING_POW_MUL, RING_POW_ONE] THEN
    ASM_SIMP_TAC [RING_MUL_LID, RING_POW])

  let RING_POW_MOD_ORDER ← prove
   r"!r (x:A) n.
        x IN ring_carrier r
        ==> ring_pow r x (n MOD ring_order r x) = ring_pow r x n"
   (MESON_TAC [RING_POW_RING_ORDER, RING_POW_MOD_ORDER_GEN])

  let RING_ORDER_POW ← prove
   r"!r (x:A) k. x IN ring_carrier r /\ ~(k = 0) /\
    k divides ring_order r x
    ==> ring_order r (ring_pow r x k) = ring_order r x DIV k"
   (SIMP_TAC [RING_ORDER_UNIQUE, RING_POW, ← GSYM RING_POW_MUL] THEN
    SIMP_TAC [RING_POW_EQ_1] THEN REWRITE_TAC [divides] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM SUBST1_TAC THEN
    ASM_SIMP_TAC [← GSYM divides, DIV_MULT] THEN
    UNDISCH_TAC (← q "~(k = 0)") THEN CONV_TAC (fun t => (NUMBER_RULE t).run))

  let RING_ORDER_POW_GEN ← prove
   r"!r (x:A) k. x IN ring_carrier r
    ==> ring_order r (ring_pow r x k) =
        if k = 0 then 1
        else ring_order r x DIV gcd(ring_order r x,k)"
   (← do
    -- right to left: the second NUMBER_RULE, then the first
    let n2 ← NUMBER_RULE (← q r"gcd(d,k) = 0 <=> d = 0 /\ k = 0")
    let n1 ← NUMBER_RULE (← q "gcd(d:num,k) divides d")
    pure (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [ring_pow, RING_ORDER_1] THEN
    ASM_SIMP_TAC [RING_ORDER_UNIQUE, RING_POW] THEN
    ASM_SIMP_TAC [← GSYM RING_POW_MUL] THEN
    ASM_SIMP_TAC [RING_POW_EQ_1] THEN X_GEN_TAC (← q "n:num") THEN
    SPEC_TAC (← q "ring_order r (x:A)", ← q "d:num") THEN GEN_TAC THEN
    MP_TAC n1 THEN
    GEN_REWRITE_TAC LAND_CONV [divides] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "m:num") MP_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o LAND_CONV) [th] THEN
      MP_TAC (← SYM th))) THEN
    ASM_SIMP_TAC [DIV_MULT, n2] THEN
    UNDISCH_TAC (← q "~(k = 0)") THEN NUMBER_TAC))

  let RING_ORDER_POW_DIVIDES ← prove
   r"!r (x:A) n. x IN ring_carrier r
    ==> ring_order r (ring_pow r x n) divides ring_order r x"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [← GSYM RING_POW_EQ_1, RING_POW] THEN
    ASM_SIMP_TAC [← GSYM RING_POW_MUL] THEN
    ASM_SIMP_TAC [RING_POW_EQ_1] THEN CONV_TAC (fun t => (NUMBER_RULE t).run))

  let RING_ORDER_UNIQUE_PRIME ← prove
   r"!r (x:A) p. x IN ring_carrier r /\ prime p
    ==> (ring_order r x = p <=>
         ~(x = ring_1 r) /\ ring_pow r x p = ring_1 r)"
   (SIMP_TAC [RING_POW_EQ_1, ← GSYM RING_ORDER_EQ_1] THEN
    REWRITE_TAC [prime] THEN
    MESON_TAC [← NUMBER_RULE (← q r"1 divides n /\ n divides n")])

  let RING_ORDER_MUL ← prove
   r"!r (x:A) y.
        x IN ring_carrier r /\ y IN ring_carrier r /\
        coprime(ring_order r x, ring_order r y)
        ==> ring_order r (ring_mul r x y) = ring_order r x * ring_order r y"
   (← do
    -- right to left: the MESON, then the NUMBER_RULE
    let m2 ← MESON []
     (← q r"(ring_mul r (ring_pow r x m) (ring_pow r y m) = ring_pow r x m /\
       ring_mul r (ring_pow r x n) (ring_pow r y n) = ring_pow r (y:A) n) /\
      (ring_mul r (ring_pow r x m) (ring_pow r y m) = ring_1 r /\
       ring_mul r (ring_pow r x n) (ring_pow r y n) = ring_1 r)
      ==> ring_pow r x m = ring_1 r /\ ring_pow r y n = ring_1 r")
    let n1 ← NUMBER_RULE
     (← q r"(a:num) divides (b * c) /\ b divides (a * c) /\ coprime(a,b)
      ==> (a * b) divides c")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM DIVIDES_ANTISYM] THEN
    ASM_SIMP_TAC [RING_ORDER_MUL_DIVIDES] THEN
    MATCH_MP_TAC n1 THEN
    ASM_SIMP_TAC [← GSYM RING_POW_EQ_1] THEN
    MATCH_MP_TAC m2 THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [RING_POW_MUL, RING_POW_RING_ORDER, RING_POW_ONE] THEN
      ASM_SIMP_TAC [RING_MUL_LID, RING_MUL_RID, RING_POW],
      ASM_SIMP_TAC [← GSYM RING_MUL_POW] THEN
      ONCE_REWRITE_TAC [MULT_SYM] THEN
      ASM_SIMP_TAC [RING_POW_MUL, RING_MUL, RING_POW_RING_ORDER] THEN
      REWRITE_TAC [RING_POW_ONE]]))

  -- @@RETURN BEGIN
  return { RING_ORDER_DIVIDES, RING_POW_EQ_1, RING_ORDER_EQ_0, RING_ORDER_EQ_1,
           RING_ORDER_UNIQUE, RING_POW_RING_ORDER, RING_ORDER_1, RING_POW_GCD_EQ_1,
           RING_POW_COPRIME_EQ_1, RING_ORDER_MUL_DIVIDES_GEN, RING_ORDER_MUL_DIVIDES,
           RING_ORDER_MUL_DIVIDES_LCM, RING_POW_MOD_ORDER_GEN, RING_POW_MOD_ORDER,
           RING_ORDER_POW, RING_ORDER_POW_GEN, RING_ORDER_POW_DIVIDES,
           RING_ORDER_UNIQUE_PRIME, RING_ORDER_MUL }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The Frobenius automorphism.  (ringtheory.ml 29498-29597)                   -/
/- ------------------------------------------------------------------------- -/

structure Frobenius where
  -- @@FIELDS
  RING_ENDOMORPHISM_FROBENIUS : thm
  RING_MONOMORPHISM_FROBENIUS_GEN : thm
  RING_MONOMORPHISM_FROBENIUS : thm
  RING_AUTOMORPHISM_FROBENIUS : thm
  FROBENIUS_FIXED : thm
  deriving Inhabited

@[nospecialize]
def setupFrobenius [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BDivides : Divides) (BSubrings : Subrings) (BDomains : Domains) (BHoms : Homs) (BKernels : Kernels) (BCosets : Cosets) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BDegree : Degree) (BEvaluation : Evaluation) (BXMinusA : XMinusA) :
    ExceptT String IO Frobenius := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, SET_RULE, .. } := D
  let { CARD_IMAGE_INJ, CARD_NUMSEG_LT, CARD_SUBSET_LE, .. } := D.core1
  let { CONG_IMP_EQ, .. } := D.core2
  let { FINITE_NUMSEG_LT, FORALL_IN_IMAGE, .. } := D.core3
  let { IN_ELIM_THM, IN_UNIV, .. } := D.core5
  let { PRIME_1, PRIME_IMP_NZ, .. } := D.core6
  let { SIMPLE_IMAGE_GEN, SUBSET, .. } := D.core7
  let { RING_SUB, RING_SUB_EQ_0, .. } := BBasics
  let { RING_MUL_POW, RING_OF_NUM_EQ, RING_POW, RING_POW_ONE, .. } := BNumbers
  let { RING_BINOMIAL_FRESHMAN, .. } := BSums
  let { ring_nilpotent, .. } := BDivides
  let { PRIME_SUBRING_MINIMAL, .. } := BSubrings
  let { FIELD_IMP_INTEGRAL_DOMAIN, FINITE_INTEGRAL_DOMAIN_CHAR,
        INTEGRAL_DOMAIN_NILPOTENT, INTEGRAL_DOMAIN_NONTRIVIAL, .. } := BDomains
  let { RING_HOMOMORPHISM, RING_ISOMORPHISM_EQ_MONOMORPHISM_FINITE,
        SUBRING_OF_FIXPOINTS, ring_automorphism, ring_endomorphism, .. } := BHoms
  let { RING_MONOMORPHISM_ALT, .. } := BKernels
  let { PRIME_SUBRING_FINITE, .. } := BCosets
  let { RING_POLYNOMIAL_VAR, .. } := BPowerSeries
  let { POLY_CLAUSES, POLY_RING, POLY_RING_CLAUSES, POLY_VAR, RING_POLYNOMIAL, .. } := BPolyRings
  let { POLY_DEG_0, POLY_DEG_SUB, POLY_DEG_VAR, POLY_DEG_VAR_POW, .. } := BDegree
  let { POLY_EVAL, POLY_EVAL_POW, POLY_EVAL_SUB, POLY_EVAL_VAR, .. } := BEvaluation
  let { POLY_ROOT_BOUND, .. } := BXMinusA
  -- @@SCOPE END

  let RING_ENDOMORPHISM_FROBENIUS ← prove
   r"!r:A ring.
        prime(ring_char r)
        ==> ring_endomorphism r (\x. ring_pow r x (ring_char r))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ring_endomorphism, RING_HOMOMORPHISM] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RING_POW_ONE] THEN
    SIMP_TAC [RING_POW, RING_MUL_POW] THEN
    ASM_SIMP_TAC [RING_BINOMIAL_FRESHMAN])

  let RING_MONOMORPHISM_FROBENIUS_GEN ← prove
   r"!r:A ring.
        prime(ring_char r) /\ (!x. ring_nilpotent r x ==> x = ring_0 r)
        ==> ring_monomorphism (r,r) (\x. ring_pow r x (ring_char r))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [RING_MONOMORPHISM_ALT, ← GSYM ring_endomorphism,
                  RING_ENDOMORPHISM_FROBENIUS] THEN
    X_GEN_TAC (← q "x:A") THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [ring_nilpotent] THEN
    ASM_MESON_TAC [PRIME_IMP_NZ])

  let RING_MONOMORPHISM_FROBENIUS ← prove
   r"!(r:A ring).
        integral_domain r /\ prime(ring_char r)
        ==> ring_monomorphism (r,r) (\x. ring_pow r x (ring_char r))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_MONOMORPHISM_FROBENIUS_GEN THEN
    ASM_MESON_TAC [INTEGRAL_DOMAIN_NILPOTENT])

  let RING_AUTOMORPHISM_FROBENIUS ← prove
   r"!r:A ring.
        field r /\ FINITE(ring_carrier r)
        ==> ring_automorphism r (\x. ring_pow r x (ring_char r))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_automorphism] THEN
    ASM_SIMP_TAC [RING_ISOMORPHISM_EQ_MONOMORPHISM_FINITE] THEN
    MATCH_MP_TAC RING_MONOMORPHISM_FROBENIUS THEN
    ASM_SIMP_TAC [FINITE_INTEGRAL_DOMAIN_CHAR, FIELD_IMP_INTEGRAL_DOMAIN])

  let FROBENIUS_FIXED ← prove
   r"!r:A ring.
        integral_domain r /\ prime(ring_char r)
        ==> { x | x IN ring_carrier r /\ ring_pow r x (ring_char r) = x} =
            { ring_of_int r n | n IN (:int)}"
   (← do
    -- right to left: the SET_RULE, the two MESONs (later first), the
    -- ARITH_RULE, then the TAUT
    let s5 ← SET_RULE
     (← q r"{x | x IN s /\ P x} = {x | x IN s /\ Q x} <=>
                          !x. x IN s ==> (P x <=> Q x)")
    let m4 ← MESON []
     (← q r"s = t ==> FINITE s /\ CARD s <= n ==> FINITE t /\ CARD t <= n")
    let m3 ← MESON [POLY_DEG_0, POLY_RING]
       (← q "p = ring_0(poly_ring r s) ==> poly_deg r p = 0")
    let a2 ← ARITH_RULE (← q "~(x = 0) ==> MAX x 1 = x")
    let t1 ← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")
    pure (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARD_SUBSET_LE THEN
    ONCE_REWRITE_TAC [t1] THEN CONJ_TAC THENL
     [MATCH_MP_TAC PRIME_SUBRING_MINIMAL THEN
      MATCH_MP_TAC SUBRING_OF_FIXPOINTS THEN
      ASM_SIMP_TAC [RING_ENDOMORPHISM_FROBENIUS],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q "CARD {ring_of_int r n:A | n IN (:int)} = ring_char r")
    SUBST1_TAC THENL
     [ASM_SIMP_TAC [PRIME_SUBRING_FINITE, PRIME_IMP_NZ] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM CARD_NUMSEG_LT] THEN
      MATCH_MP_TAC CARD_IMAGE_INJ THEN
      REWRITE_TAC [FINITE_NUMSEG_LT, IN_ELIM_THM, RING_OF_NUM_EQ, CONG_IMP_EQ],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q "q = poly_pow (r:A ring) (poly_var r one) (ring_char r)") THEN
    MP_TAC (← ISPECL
      [← q "r:A ring",
       ← q "ring_sub (poly_ring (r:A ring) (:1)) q (poly_var r one)"]
      POLY_ROOT_BOUND) THEN
    SUBGOAL_THEN (← q "q IN ring_carrier(poly_ring (r:A ring) (:1))") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_SUB, POLY_RING_CLAUSES, POLY_VAR, IN_UNIV, RING_POW],
      ALL_TAC] THEN
    ASM_SIMP_TAC [RING_SUB, POLY_VAR, IN_UNIV] THEN
    SUBGOAL_THEN
      (← q r"poly_deg r (ring_sub (poly_ring r (:1)) q (poly_var r one)) =
       ring_char(r:A ring)")
    ASSUME_TAC THENL
     [REWRITE_TAC [POLY_RING_CLAUSES] THEN
      wPart lhand (fun t => do lhand (← rand t)) POLY_DEG_SUB THEN
      EXPAND_TAC "q" THEN
      REWRITE_TAC [POLY_CLAUSES, POLY_DEG_VAR_POW, POLY_DEG_VAR] THEN
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_NONTRIVIAL, POLY_RING_CLAUSES] THEN
      ASM_SIMP_TAC [PRIME_IMP_NZ, a2] THEN
     DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [RING_POLYNOMIAL_VAR, IN_UNIV] THEN
      ASM_MESON_TAC [RING_POLYNOMIAL, PRIME_1],
      ASM_REWRITE_TAC []] THEN
    ANTS_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP m3) THEN
      ASM_SIMP_TAC [PRIME_IMP_NZ],
      ALL_TAC] THEN
    MATCH_MP_TAC m4 THEN
    REWRITE_TAC [s5] THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM RING_POLYNOMIAL]) THEN
    ASM_SIMP_TAC [POLY_EVAL_SUB, POLY_RING_CLAUSES, RING_POLYNOMIAL_VAR] THEN
    ASM_SIMP_TAC [RING_SUB_EQ_0, POLY_EVAL, POLY_EVAL_VAR] THEN
    EXPAND_TAC "q" THEN
    ASM_SIMP_TAC [POLY_EVAL_POW, RING_POLYNOMIAL_VAR, POLY_EVAL_VAR]))

  -- @@RETURN BEGIN
  return { RING_ENDOMORPHISM_FROBENIUS, RING_MONOMORPHISM_FROBENIUS_GEN,
           RING_MONOMORPHISM_FROBENIUS, RING_AUTOMORPHISM_FROBENIUS, FROBENIUS_FIXED }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Decision procedure for integral domains (ringtheory.ml 29598-29759).      -/
/- ------------------------------------------------------------------------- -/

/-- What `INTEGRAL_DOMAIN_RULE` builds once (ringtheory.ml 29607-29759). -/
structure IdRuleCtx where
  INTEGRAL_DOMAIN_TOTALIZATION : thm
  imp_imp_rule : thm → ExceptT String IO thm
  left_exists_rule : thm → ExceptT String IO thm
  disch_disj_rule : thm → ExceptT String IO thm
  disch_ndisj_rule : thm → ExceptT String IO thm
  RING_MONOMORPHIC_IMAGE_RULE : thm → ExceptT String IO (term → ExceptT String IO thm)
  RING_INTEGRAL_DOMAIN_UNIVERSAL : term → ExceptT String IO thm
  RING_CHAR_MONOMORPHIC_IMAGE : thm
  core_pth : thm
  ptm : term
  qtm : term
  DISJ_ACI_RULE : term → Except String thm
  init_conv : ioconv
  true_tm : term

/-- `ringtypes` in INTEGRAL_DOMAIN_RULE (ringtheory.ml 29647-29660). -/
partial def idRingtypes (tm : term) : List hol_type :=
  match tm with
  | .Comb (.Const "!" _) (.Abs _ t) => idRingtypes t
  | .Comb (.Const "?" _) (.Abs _ t) => idRingtypes t
  | .Comb (.Const "~" _) t => idRingtypes t
  | .Comb (.Comb (.Const "/\\" _) s) t => union (idRingtypes s) (idRingtypes t)
  | .Comb (.Comb (.Const "\\/" _) s) t => union (idRingtypes s) (idRingtypes t)
  | .Comb (.Comb (.Const "==>" _) s) t => union (idRingtypes s) (idRingtypes t)
  | .Comb (.Comb (.Const "=" _) s) t =>
      let ty := type_of t
      if ty == bool_ty then union (idRingtypes s) (idRingtypes t) else [ty]
  | .Comb (.Comb (.Const "IN" _) t) (.Comb (.Const "ring_carrier" _) _) => [type_of t]
  | _ => []

/-- `INTEGRAL_DOMAIN_WORD` (ringtheory.ml 29665-29714). -/
def idWord [HolBase] (C : IdRuleCtx) (tm : term) : ExceptT String IO thm := do
  let dty ← match idRingtypes tm with
    | [ty] => pure ty
    | _ => throw "INTEGRAL_DOMAIN_RULE: can't deduce which ring"
  let rty ← ExceptT.mk (mk_type "ring" [dty])
  let rtm ← match (frees tm).filter (fun t => type_of t == rty) with
    | [t] => pure t
    | _ => throw "INTEGRAL_DOMAIN_RULE: can't deduce which ring"
  let tvs := type_vars_in_term tm
  let names ← liftExcept (tvs.mapM dest_vartype)
  let dty' := mk_vartype ("Z" ++ itlist (fun n acc => n ++ acc) names "")
  let rty' ← ExceptT.mk (mk_type "ring" [dty'])
  let avvers ← liftExcept (variables tm)
  -- `let rtm' = ... and htm = ...`: left to right
  let rtm' ← liftExcept (variant avvers (mk_var "r'" rty'))
  let htm ← liftExcept (variant avvers (mk_var "h" (← ExceptT.mk (mk_fun_ty dty dty'))))
  let pr ← ExceptT.mk (HolMath.Pair.mk_pair (rtm, rtm'))
  let hasm ← ExceptT.mk (list_mk_icomb "ring_monomorphism" [pr, htm])
  let hth ← ASSUME hasm
  let rmi ← C.RING_MONOMORPHIC_IMAGE_RULE hth
  let th ← rmi tm
  let utm ← liftExcept (rand (concl th))
  let hvs := find_terms (fun t =>
    is_comb t && (match rator t with | .ok f => f == htm | .error _ => false) &&
    (match rand t with | .ok x => is_var x | .error _ => false)) utm
  let gvs ← liftExcept (hvs.mapM (fun t => do
    let v ← rand t
    return mk_var (← dest_var v).1 (type_of t)))
  let sf ← ExceptT.mk (subst (← liftExcept (zip gvs hvs)))
  let vtm ← ExceptT.mk (sf utm)
  let arty ← ExceptT.mk (mk_type "ring" [aty])
  let vs ← liftExcept (vsubst [(mk_var "r" arty, mk_var (← liftExcept (dest_var rtm')).1 arty)])
  let atm := vs (inst [(aty, dty')] vtm)
  let th1 ← C.RING_INTEGRAL_DOMAIN_UNIVERSAL atm
  let th2 ← INST_TYPE [(dty', aty)] th1
  let th3 ← INST [(rtm', mk_var "r" rty')] th2
  let th4 ← INST (← liftExcept (zip hvs gvs)) th3
  let th5 ← EQ_MP (← SYM th) th4
  let xtms := (hyp th5).filter (fun t => !([hasm].contains t))
  -- `funpow n UNDISCH (SUBS [SYM(MATCH_MP ...)] (itlist DISCH xtms th5))`
  let dth ← xtms.foldrM (fun t acc => DISCH t acc) th5
  let sth ← SYM (← MATCH_MP C.RING_CHAR_MONOMORPHIC_IMAGE hth)
  let s1 ← SUBS [sth] dth
  let th6 ← (List.range xtms.length).foldlM (fun acc _ => UNDISCH acc) s1
  let mkEq ← ExceptT.mk mk_eq
  -- `let ueq = ... and idt = ...`: left to right
  let univ ← ExceptT.mk (mk_const "UNIV" [(dty', aty)])
  let car ← ExceptT.mk (list_mk_icomb "ring_carrier" [rtm'])
  let ueq ← liftExcept (mkEq (car, univ))
  let idt ← ExceptT.mk (list_mk_icomb "integral_domain" [rtm'])
  let th7 ← C.imp_imp_rule (← DISCH idt
              (← C.imp_imp_rule (← DISCH ueq (← DISCH hasm th6))))
  let th8 ← C.left_exists_rule (← GEN htm th7)
  let th9 ← C.left_exists_rule (← GEN rtm' th8)
  let numty ← ExceptT.mk (mk_type "num" [])
  let prodty ← ExceptT.mk (mk_type "prod" [numty, dty])
  let th10 ← INST_TYPE [(prodty, dty')] th9
  let th11 ← PART_MATCH rand C.INTEGRAL_DOMAIN_TOTALIZATION
    (← liftExcept (lhand (concl th10)))
  MP th10 (← UNDISCH th11)

/-- `INTEGRAL_DOMAIN_CORE` (ringtheory.ml 29715-29728). -/
def idCore [HolBase] (C : IdRuleCtx) (tm : term) : ExceptT String IO thm := do
  let (negdjs, posdjs) := partition is_neg (disjuncts tm)
  -- `let hyper,nsides = ... and concs,psides = ...`: left to right
  let (hyper, nsides) := partition (fun t => match rand t with
    | .ok x => is_eq x | .error _ => false) negdjs
  let (concs, psides) := partition is_eq posdjs
  let th0 ← idWord C (← liftExcept (HolCore.Bool.list_mk_disj (hyper ++ concs)))
  let th1 ← nsides.foldrM (fun nst th => do
    C.disch_disj_rule (← DISCH (← liftExcept (rand nst)) th)) th0
  let negs ← liftExcept (psides.mapM HolCore.Bool.mk_neg)
  let th2 ← negs.foldrM (fun pst th => do C.disch_ndisj_rule (← DISCH pst th)) th1
  let th3 ← INST [(concl th2, C.ptm), (tm, C.qtm)] C.core_pth
  let ath ← liftExcept (C.DISJ_ACI_RULE (← liftExcept (rand (concl th3))))
  MP (← EQ_MP (← SYM th3) ath) th2

/-- `INTEGRAL_DOMAIN_RULE_BASIC` (ringtheory.ml 29741-29754). -/
def idRuleBasic [HolBase] (C : IdRuleCtx) (tm : term) : ExceptT String IO thm := do
  let (avs, bod) := strip_forall tm
  let th1 ← ExceptT.mk (C.init_conv bod)
  let tm' ← liftExcept (rand (concl th1))
  if tm' == C.true_tm then EQT_ELIM th1 else
  let (avs', bod') := strip_forall tm'
  let th2 ← HolLight.end_itlist CONJ (← (conjuncts bod').mapM (idCore C))
  let th3 ← EQ_MP (← SYM th1) (← GENL avs' th2)
  let imps := hyp th3
  let th4 ← if imps.isEmpty then pure th3 else do
    let cs := CONJUNCTS (← ASSUME (← liftExcept (HolCore.Bool.list_mk_conj imps)))
    DISCH_ALL (← cs.foldrM (fun th acc => PROVE_HYP th acc) th3)
  GENL avs th4

/-- `INTEGRAL_DOMAIN_RULE` (ringtheory.ml 29755-29759). -/
def idRule [HolBase] (C : IdRuleCtx) (tm : term) : ExceptT String IO thm := do
  let tvs := type_vars_in_term tm
  let names ← liftExcept (tvs.mapM dest_vartype)
  let ty := mk_vartype ("Y" ++ itlist (fun n acc => n ++ acc) names "")
  let tm' := inst [(ty, aty)] tm
  INST_TYPE [(aty, ty)] (← idRuleBasic C tm')

/-- `find_terms` with an `IO` predicate (for `can (term_match ...)` tests);
    the same traversal and `insert` order as HolCore's `find_terms`. -/
partial def findTermsIO (p : term → IO Bool) (tm : term) : IO (List term) :=
  let rec accum (tl : List term) (tm : term) : IO (List term) := do
    let tl' := if ← p tm then insert tm tl else tl
    if is_abs tm then
      match body tm with
      | .ok bod => accum tl' bod
      | .error _ => pure tl'
    else if is_comb tm then
      match rator tm, rand tm with
      | .ok f, .ok x => do accum (← accum tl' f) x
      | _, _ => pure tl'
    else pure tl'
  accum [] tm

structure IntegralDomainRule where
  -- @@FIELDS
  INTEGRAL_DOMAIN_RULE : term → ExceptT String IO thm
  FIELD_TAC : tactic
  FIELD_INV_EQ_0 : thm
  FIELD_DIV_EQ_0 : thm
  deriving Inhabited

@[nospecialize]
def setupIntegralDomainRule [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDivides : Divides) (BDomains : Domains) (BRules : Rules) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BLimits : Limits) (BPolyRings : PolyRings) (BDegree : Degree) (BCardinalities : Cardinalities) :
    ExceptT String IO IntegralDomainRule := do
  -- @@SCOPE BEGIN
  let { CNF_CONV, CONDS_ELIM_CONV, DISJ_ACI_RULE, MESON, NNFC_CONV, PRENEX_CONV,
        PRESIMP_CONV, SKOLEM_CONV, .. } := D
  let { CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_EQ_TRANS, CARD_LE_MUL, CARD_LE_REFL,
        CARD_LE_SUBSET, CARD_LE_TRANS, CARD_MUL_ABSORB, CARD_MUL_LID, CARD_SING_LE, .. } := D.core1
  let { CONJ_ASSOC, CROSS, CROSS_UNIV, DE_MORGAN_THM, DISJ_ASSOC, EQ_IMP, .. } := D.core2
  let { IMP_CONJ_ALT, IMP_IMP, INFINITE_CROSS_UNIV, .. } := D.core4
  let { LEFT_AND_EXISTS_THM, LEFT_FORALL_IMP_THM, .. } := D.core5
  let { MONO_EXISTS, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, SUBSET_UNIV, UNIV_NOT_EMPTY, UNWIND_THM1, .. } := D.core7
  let { mul_c, num_INFINITE, .. } := D.core8
  let { RING_CARRIER_NONEMPTY, RING_SUB, RING_SUB_EQ_0, .. } := BBasics
  let { RING_INV, RING_INV_0, ring_div, .. } := BDivides
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_MUL_RINV, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, .. } := BDomains
  let { RING_CARRIER_TAC, RING_INTEGRAL_DOMAIN_UNIVERSAL, .. } := BRules
  let { RING_CHAR_MONOMORPHIC_IMAGE, RING_ISOMORPHISM_IMP_MONOMORPHISM,
        RING_MONOMORPHISM_COMPOSE, .. } := BHoms
  let { ISOMORPHIC_COPY_OF_RING, isomorphic_ring, .. } := BIso
  let { ISOMORPHIC_RING_INTEGRAL_DOMAINNESS, .. } := BKernels
  let { RING_MONOMORPHIC_IMAGE_RULE, .. } := BLimits
  let { RING_MONOMORPHISM_POLY_CONST, .. } := BPolyRings
  let { INTEGRAL_DOMAIN_POLY_RING, .. } := BDegree
  let { CARD_EQ_POLY_RING_INFINITE, .. } := BCardinalities
  -- @@SCOPE END

  let INTEGRAL_DOMAIN_RULE : term → ExceptT String IO thm ← do
    let INTEGRAL_DOMAIN_TOTALIZATION ← prove
     r"!r:A ring.
        integral_domain r
        ==> ?r' f. integral_domain r' /\
                   ring_carrier r' = (:num#A) /\
                   ring_monomorphism(r,r') f"
     (REPEAT STRIP_TAC THEN MP_TAC (← EQ_IMP_RULE (← ISPECL
       [← q "poly_ring (r:A ring) (:num#A)", ← q "(:num#A)"]
       ISOMORPHIC_COPY_OF_RING)).2 THEN
      ANTS_TAC THENL
       [MP_TAC (← ISPECL [← q "r:A ring", ← q "(:num#A)"]
            CARD_EQ_POLY_RING_INFINITE) THEN
        ASM_REWRITE_TAC [INFINITE_CROSS_UNIV, num_INFINITE] THEN
        ASM_SIMP_TAC [INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
        MATCH_MP_TAC CARD_MUL_ABSORB THEN
        REWRITE_TAC [INFINITE_CROSS_UNIV, num_INFINITE,
                     RING_CARRIER_NONEMPTY] THEN
        TRANS_TAC CARD_LE_TRANS (← q "(:A)") THEN
        SIMP_TAC [CARD_LE_SUBSET, SUBSET_UNIV] THEN
        REWRITE_TAC [← GSYM CROSS_UNIV, CROSS, ← GSYM mul_c] THEN
        TRANS_TAC CARD_LE_TRANS (← q "{0} *_c (:A)") THEN CONJ_TAC THENL
         [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
          REWRITE_TAC [CARD_MUL_LID],
          MATCH_MP_TAC CARD_LE_MUL THEN REWRITE_TAC [CARD_LE_REFL] THEN
          REWRITE_TAC [CARD_SING_LE, UNIV_NOT_EMPTY]],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "r':(num#A)ring") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [isomorphic_ring]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q "f:((num#A->num)->A)->num#A")) THEN
      EXISTS_TAC (← q "(f:((num#A->num)->A)->num#A) o poly_const (r:A ring)") THEN
      CONJ_TAC THENL
       [SUBGOAL_THEN (← q "integral_domain(poly_ring (r:A ring) (:num#A))")
        MP_TAC THENL
         [ASM_REWRITE_TAC [INTEGRAL_DOMAIN_POLY_RING], MATCH_MP_TAC EQ_IMP] THEN
        MATCH_MP_TAC ISOMORPHIC_RING_INTEGRAL_DOMAINNESS THEN ASM_REWRITE_TAC [],
        MATCH_MP_TAC RING_MONOMORPHISM_COMPOSE THEN
        EXISTS_TAC (← q "poly_ring (r:A ring) (:num#A)") THEN
        REWRITE_TAC [RING_MONOMORPHISM_POLY_CONST] THEN
        ASM_SIMP_TAC [RING_ISOMORPHISM_IMP_MONOMORPHISM]])
    -- `let imp_imp_rule = ... and left_exists_rule = ...
    -- and disch_disj_rule = ... and disch_ndisj_rule = ...`: left to right
    let ddTaut ← TAUT (← q r"p ==> q <=> ~p \/ q")
    let dnTaut ← TAUT (← q r"~p ==> q <=> p \/ q")
    -- INTEGRAL_DOMAIN_CORE: `let pth = TAUT ... and ptm = ... and qtm = ...`
    let core_pth ← TAUT (← q r"p ==> q <=> (p \/ q <=> q)")
    let ptm ← q "p:bool"
    let qtm ← q "q:bool"
    -- init_conv, and true_tm
    let gDisjAssoc ← GSYM DISJ_ASSOC
    let gConjAssoc ← GSYM CONJ_ASSOC
    let init_conv : ioconv :=
      TOP_DEPTH_CONV BETA_CONV THENC
      PRESIMP_CONV THENC
      CONDS_ELIM_CONV THENC
      NNFC_CONV THENC CNF_CONV THENC
      SKOLEM_CONV THENC PRENEX_CONV THENC
      GEN_REWRITE_CONV REDEPTH_CONV
       [RIGHT_AND_EXISTS_THM, LEFT_AND_EXISTS_THM] THENC
      GEN_REWRITE_CONV TOP_DEPTH_CONV [gDisjAssoc] THENC
      GEN_REWRITE_CONV TOP_DEPTH_CONV [gConjAssoc]
    let true_tm ← q "T"
    let C : IdRuleCtx := {
      INTEGRAL_DOMAIN_TOTALIZATION,
      imp_imp_rule := GEN_REWRITE_RULE id [IMP_IMP],
      left_exists_rule := GEN_REWRITE_RULE id [LEFT_FORALL_IMP_THM],
      disch_disj_rule := GEN_REWRITE_RULE id [ddTaut],
      disch_ndisj_rule := GEN_REWRITE_RULE id [dnTaut],
      RING_MONOMORPHIC_IMAGE_RULE, RING_INTEGRAL_DOMAIN_UNIVERSAL,
      RING_CHAR_MONOMORPHIC_IMAGE, core_pth, ptm, qtm,
      DISJ_ACI_RULE, init_conv, true_tm }
    pure (idRule C)

  let FIELD_TAC : tactic ← do
    -- `let carrier_tac = ... and rabinify_tac = ... and invelim_tac = ...`:
    -- left to right
    let carrier_tac : tactic :=
      W (fun (asl, w) => tactic_of do
          let tyA ← qty "A"
          let vs := (union (frees w) (freesl (asl.map (fun p => concl p.2)))).filter
            (fun t => type_of t == tyA)
          let cjs ← vs.mapM (fun x => do
            let pat ← q "(x:A) IN ring_carrier f"
            let xv ← q "x:A"
            let sf ← liftExcept (vsubst [(x, xv)])
            pure (sf pat))
          if cjs.isEmpty then pure ALL_TAC else
          pure (SUBGOAL_THEN (← liftExcept (HolCore.Bool.list_mk_conj cjs)) STRIP_ASSUME_TAC THENL
           [REPEAT CONJ_TAC THEN RING_CARRIER_TAC, ALL_TAC]))
    let rabinowitsch_lemma ← prove
     r"!x y:A. ~(x = y)
               ==> !r. field r /\ x IN ring_carrier r /\ y IN ring_carrier r
                        ==> ?z. z IN ring_carrier r /\
                                ring_mul r (ring_sub r x y) z = ring_1 r"
     (REPEAT STRIP_TAC THEN EXISTS_TAC (← q "ring_inv r (ring_sub r x y):A") THEN
      ASM_SIMP_TAC [FIELD_MUL_RINV, RING_SUB_EQ_0, RING_INV, RING_SUB])
    let fA ← q "f:A ring"
    let rabinify_tac : tactic :=
      REPEAT
       (FIRST_X_ASSUM (MP_TAC o ISPEC fA o
           MATCH_MP rabinowitsch_lemma) THEN
        ANTS_TAC THENL
         [ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THEN
          RING_CARRIER_TAC, STRIP_TAC])
    -- `let is_fieldinv = ... and pth = ...`: left to right
    let fipat ← q "ring_inv f (x:A)"
    let pth ← prove
     r"!f t:A.
            field f
            ==> t IN ring_carrier f
                ==> ring_inv f t = ring_0 f /\ t = ring_0 f \/
                    (?z. z IN ring_carrier f /\
                         ring_inv f t = z /\ ring_mul f t z = ring_1 f)"
     (ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
      REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q "t:A = ring_0 f") THEN
      ASM_SIMP_TAC [RING_INV_0, UNWIND_THM1, FIELD_MUL_RINV, RING_INV])
    let invelim_tac : tactic :=
      W (fun (_asl, w) => tactic_of do
          let ctms0 ← (findTermsIO (fun t => do
            match ← HolCore.Drule.term_match [] fipat t with
            | .ok _ => pure true
            | .error _ => pure false) w : IO (List term))
          let ctms := sort free_in ctms0
          match ctms with
          | [] => throw "invelim_tac"
          | c :: _ => do
            let a ← liftExcept (rand c)
            pure (FIRST_ASSUM (MP_TAC o ISPEC a o MATCH_MP pth) THEN
              ANTS_TAC THENL [RING_CARRIER_TAC, ALL_TAC] THEN
              DISCH_THEN (DISJ_CASES_THEN2
               (CONJUNCTS_THEN2 SUBST1_TAC MP_TAC)
               (CHOOSE_THEN (CONJUNCTS_THEN2 ASSUME_TAC
                 (CONJUNCTS_THEN2 SUBST1_TAC MP_TAC))))))
    let mm ← MESON [] (← q "(~(a = b) ==> F) ==> a = b")
    pure (REWRITE_TAC [DE_MORGAN_THM] THEN
      REPEAT STRIP_TAC THEN
      TRY (MATCH_MP_TAC mm THEN DISCH_TAC) THEN
      TRY (FIRST_ASSUM (HolCore.Tactics.CONTR_TAC HolBase.B)) THEN
      carrier_tac THEN
      ASM_REWRITE_TAC [] THEN
      rabinify_tac THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o check (fun th =>
        match find_term is_eq (concl th) with | .ok _ => true | .error _ => false))) THEN
      REWRITE_TAC [ring_div] THEN
      REPEAT invelim_tac THEN
      W (fun (_asl, w) => tactic_of do
            let th ← INTEGRAL_DOMAIN_RULE w
            pure (MATCH_ACCEPT_TAC th ORELSE (fun g => MATCH_MP_TAC th g))) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
      REPEAT CONJ_TAC THEN TRY RING_CARRIER_TAC)

  let FIELD_INV_EQ_0 ← prove
   r"!f x:A. field f /\ x IN ring_carrier f
           ==> (ring_inv f x = ring_0 f <=> x = ring_0 f)"
   FIELD_TAC

  let FIELD_DIV_EQ_0 ← prove
   r"!f x y:A. field f /\ x IN ring_carrier f /\ y IN ring_carrier f
           ==> (ring_div f x y = ring_0 f <=> x = ring_0 f \/ y = ring_0 f)"
   FIELD_TAC

  -- @@RETURN BEGIN
  return { INTEGRAL_DOMAIN_RULE, FIELD_TAC, FIELD_INV_EQ_0, FIELD_DIV_EQ_0 }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- A more direct tactic to pull division terms up.  (ringtheory.ml 29836-end) -/
/- ------------------------------------------------------------------------- -/

/-- `sideprove` in RING_PULL_DIV_CONV (ringtheory.ml 29893-29899). -/
partial def ringPullDivSideprove [HolBase]
    (siders : List (term → ExceptT String IO thm))
    (carrierRule : List thm → term → ExceptT String IO thm)
    (asm : List thm) (t : term) : ExceptT String IO thm := do
  match find (fun a => concl a == t) asm with
  | .ok a => pure a
  | .error _ =>
    try carrierRule asm t catch _ =>
    tryfindF (fun sfn => do
        let th ← sfn t
        let scs := conjuncts (← liftExcept (do return (← dest_imp (concl th)).1))
        MP th (← HolLight.end_itlist CONJ
          (← scs.mapM (ringPullDivSideprove siders carrierRule asm))))
      siders

structure RingPullDiv where
  -- @@FIELDS
  RING_PULL_DIV : thm
  RING_PULL_DIV_CONV : List thm → ioconv
  RING_PULL_DIV_TAC : tactic
  deriving Inhabited

@[nospecialize]
def setupRingPullDiv [HolBase] (D : RingTheoryDeps) (BNumbers : Numbers) (BDivides : Divides) (BDomains : Domains) (BRules : Rules) (BIntegralDomainRule : IntegralDomainRule) :
    ExceptT String IO RingPullDiv := do
  -- @@SCOPE BEGIN
  let { CONJ_ASSOC, .. } := D.core2
  let { FORALL_AND_THM, .. } := D.core3
  let { IMP_IMP, .. } := D.core4
  let { RIGHT_IMP_FORALL_THM, .. } := D.core7
  let { RING_MUL_POW, .. } := BNumbers
  let { RING_INV, RING_POW_INV, ring_div, .. } := BDivides
  let { FIELD_POW_EQ_0, .. } := BDomains
  let { RING_CARRIER_RULE, .. } := BRules
  let { FIELD_TAC, .. } := BIntegralDomainRule
  -- @@SCOPE END

  let RING_PULL_DIV ← prove
   r"!f:A ring.
    field f
    ==> (!x y n. x IN ring_carrier f /\ y IN ring_carrier f
                 ==> ring_pow f (ring_div f x y) n =
                     ring_div f (ring_pow f x n) (ring_pow f y n)) /\
        (!x1 y1 x2 y2.
                x1 IN ring_carrier f /\ x2 IN ring_carrier f /\
                y1 IN ring_carrier f /\ y2 IN ring_carrier f
                ==> ring_div f (ring_div f x1 y1) (ring_div f x2 y2) =
                    ring_div f (ring_mul f x1 y2) (ring_mul f x2 y1)) /\
        (!x1 x2 y. x1 IN ring_carrier f /\ x2 IN ring_carrier f /\
                   y IN ring_carrier f /\ ~(y = ring_0 f)
                   ==> ring_add f (ring_div f x1 y) (ring_div f x2 y) =
                       ring_div f (ring_add f x1 x2) y /\
                       ring_sub f (ring_div f x1 y) (ring_div f x2 y) =
                       ring_div f (ring_sub f x1 x2) y /\
                       (ring_div f x1 y = ring_div f x2 y <=> x1 = x2) /\
                       ring_add f (ring_div f x1 y) x2 =
                       ring_div f (ring_add f x1 (ring_mul f x2 y)) y /\
                       ring_add f x1 (ring_div f x2 y) =
                       ring_div f (ring_add f (ring_mul f x1 y) x2) y /\
                       ring_sub f (ring_div f x1 y) x2 =
                       ring_div f (ring_sub f x1 (ring_mul f x2 y)) y /\
                       ring_sub f x1 (ring_div f x2 y) =
                       ring_div f (ring_sub f (ring_mul f x1 y) x2) y /\
                       ring_mul f (ring_div f x1 y) x2 =
                       ring_div f (ring_mul f x1 x2) y /\
                       ring_mul f x1 (ring_div f x2 y) =
                       ring_div f (ring_mul f x1 x2) y /\
                       (ring_div f x1 y = x2 <=> x1 = ring_mul f x2 y) /\
                       (x1 = ring_div f x2 y <=> ring_mul f x1 y = x2)) /\
        (!x y. x IN ring_carrier f /\ y IN ring_carrier f /\
               ~(x = ring_0 f) /\ ~(y = ring_0 f)
               ==> ~(ring_mul f x y = ring_0 f)) /\
        (!x n. x IN ring_carrier f /\ ~(x = ring_0 f)
               ==> ~(ring_pow f x n = ring_0 f))"
   (SIMP_TAC [FIELD_POW_EQ_0] THEN
    GEN_TAC THEN DISCH_TAC THEN CONJ_TAC THENL
     [SIMP_TAC [ring_div, RING_MUL_POW, RING_POW_INV, RING_INV],
      FIELD_TAC])

  let RING_PULL_DIV_CONV : List thm → ioconv ← do
    let gConjAssoc ← GSYM CONJ_ASSOC
    let tt ← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")
    let rw ← REWRITE_RULE [FORALL_AND_THM, IMP_IMP, gConjAssoc,
                           RIGHT_IMP_FORALL_THM, tt] RING_PULL_DIV
    let (divthms, sidethms) ← liftExcept (chop_list 13 (CONJUNCTS rw))
    -- `let simpers = ... and siders = ...`: left to right
    let simpers := divthms.map (fun th t => PART_MATCH (fun x => do lhand (← rand x)) th t)
    let siders := sidethms.map (fun th t => PART_MATCH rand th t)
    pure (fun asm tm => (tryfindF (fun sfn => do
        let th ← sfn tm
        let scs := conjuncts (← liftExcept (do return (← dest_imp (concl th)).1))
        MP th (← HolLight.end_itlist CONJ
          (← scs.mapM (ringPullDivSideprove siders RING_CARRIER_RULE asm))))
      simpers).run)

  let RING_PULL_DIV_TAC : tactic ← pure (fun g =>
    CONV_TAC (REDEPTH_CONV (RING_PULL_DIV_CONV (g.1.map (fun p => p.2)))) g)

  -- @@RETURN BEGIN
  return { RING_PULL_DIV, RING_PULL_DIV_CONV, RING_PULL_DIV_TAC }
  -- @@RETURN END

end HolLibrary.RingTheory
