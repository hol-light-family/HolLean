                t SUBSET s /\
                x IN ring_carrier(subring_generated r t)"
   (GEN_TAC THEN GEN_TAC THEN
    MATCH_MP_TAC SUBRING_GENERATED_INDUCT_STRONG THEN
    CONJ_TAC THENL
     [MESON_TAC [SUBRING_GENERATED_INC, FINITE_SING, SING_SUBSET, IN_SING],
      REWRITE_TAC [RING_0_IN_SUBRING_GENERATED, RING_1_IN_SUBRING_GENERATED]] THEN
    REPLICATE_TAC 2
     (CONJ_TAC THENL [MESON_TAC [FINITE_EMPTY, EMPTY_SUBSET], ALL_TAC]) THEN
    CONJ_TAC THENL [MESON_TAC [RING_NEG_IN_SUBRING_GENERATED], ALL_TAC] THEN
    CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
    REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    DISCH_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"t1:A->bool") THEN
    REPLICATE_TAC 3 DISCH_TAC THEN X_GEN_TAC (← q r"t2:A->bool") THEN
    REPEAT DISCH_TAC THEN EXISTS_TAC (← q r"t1 UNION t2:A->bool") THEN
    ASM_REWRITE_TAC [FINITE_UNION, UNION_SUBSET] THENL
     [MATCH_MP_TAC RING_ADD_IN_SUBRING_GENERATED,
      MATCH_MP_TAC RING_MUL_IN_SUBRING_GENERATED] THEN
    CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
    MATCH_MP_TAC SUBRING_GENERATED_MONO THEN SET_TAC [])

  let SUBRING_GENERATED_FINITARY ← prove
   r"!r s:A->bool.
        ring_carrier(subring_generated r s) =
        UNIONS { ring_carrier(subring_generated r t) | t |
                 FINITE t /\ t SUBSET s}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [SUBRING_GENERATED_MONO, UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
    ONCE_REWRITE_TAC [SUBSET] THEN REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM] THEN
    REWRITE_TAC [IN_SUBRING_GENERATED_FINITARY, ← GSYM CONJ_ASSOC])

  let SUBSET_SUBRING_GENERATED_FINITARY ← prove
   r"!r s (u:A->bool).
        FINITE u /\ u SUBSET ring_carrier(subring_generated r s)
        ==> ?t. FINITE t /\
                t SUBSET s /\
                u SUBSET ring_carrier(subring_generated r t)"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [EMPTY_SUBSET, INSERT_SUBSET] THEN
    CONJ_TAC THENL [MESON_TAC [FINITE_EMPTY, EMPTY_SUBSET], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q "x:A", ← q r"u:A->bool"] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"t1:A->bool") STRIP_ASSUME_TAC o
      MATCH_MP IN_SUBRING_GENERATED_FINITARY) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"t2:A->bool") STRIP_ASSUME_TAC)
      STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"t1 UNION t2:A->bool") THEN
    ASM_REWRITE_TAC [FINITE_UNION, UNION_SUBSET] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"x IN s ==> s SUBSET t ==> x IN t"))),
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS))] THEN
    MATCH_MP_TAC SUBRING_GENERATED_MONO THEN SET_TAC [])

  let SUBRING_GENERATED_PRIME_SUBRING ← prove
   r"!r:A ring.
        subring_generated r { ring_of_int r x | x IN (:int)} =
        subring_generated r {ring_0 r}"
   (GEN_TAC THEN MATCH_MP_TAC SUBRINGS_GENERATED_EQ THEN
    SIMP_TAC [PRIME_SUBRING_MINIMAL, SUBRING_SUBRING_GENERATED] THEN
    REWRITE_TAC [SING_SUBSET, RING_0_IN_SUBRING_GENERATED])

  let RING_CARRIER_SUBRING_GENERATED_0 ← prove
   r"!r:A ring.
        ring_carrier(subring_generated r {ring_0 r}) =
        { ring_of_int r x | x IN (:int)}"
   (SIMP_TAC [← GSYM SUBRING_GENERATED_PRIME_SUBRING, PRIME_SUBRING,
              CARRIER_SUBRING_GENERATED_SUBRING])

  -- @@RETURN BEGIN
  return { subring_of, subring_generated, IN_SUBRING_0, IN_SUBRING_1, IN_SUBRING_NEG,
           IN_SUBRING_ADD, IN_SUBRING_MUL, IN_SUBRING_SUB, IN_SUBRING_POW,
           IN_SUBRING_NUM, IN_SUBRING_INT, IN_SUBRING_SUM, IN_SUBRING_PRODUCT,
           SUBRING_OF_INTERS, SUBRING_OF_INTER, SUBRING_OF_UNIONS, SUBRING_OF_IMP_SUBSET,
           SUBRING_OF_IMP_NONEMPTY, CARRIER_SUBRING_OF, PRIME_SUBRING,
           PRIME_SUBRING_MINIMAL, SUBRING_GENERATED, SUBRING_GENERATED_EQ,
           RING_SUB_SUBRING_GENERATED, RING_POW_SUBRING_GENERATED,
           RING_OF_NUM_SUBRING_GENERATED, RING_OF_INT_SUBRING_GENERATED,
           RING_0_IN_SUBRING_GENERATED, RING_1_IN_SUBRING_GENERATED,
           RING_NEG_IN_SUBRING_GENERATED, RING_ADD_IN_SUBRING_GENERATED,
           RING_MUL_IN_SUBRING_GENERATED, RING_POW_IN_SUBRING_GENERATED,
           SUBRING_GENERATED_RESTRICT, SUBRING_SUBRING_GENERATED, SUBRING_GENERATED_MONO,
           SUBRING_GENERATED_MINIMAL, SUBRINGS_GENERATED_EQ, SUBRING_GENERATED_INDUCT,
           SUBRING_GENERATED_INDUCT_STRONG, RING_CARRIER_SUBRING_GENERATED_SUBSET,
           SUBRING_OF_SUBRING_GENERATED_EQ, SUBRING_GENERATED_SUPERSET,
           FINITE_SUBRING_GENERATED, SUBRING_GENERATED_SUBSET_CARRIER,
           SUBSET_CARRIER_SUBRING_GENERATED, CARRIER_SUBRING_GENERATED_SUBRING,
           SUBRING_GENERATED_MINIMAL_EQ, SUBRING_OF_SUBRING_GENERATED_SUBRING_EQ,
           SUBRING_GENERATED_RING_CARRIER, SUBRING_OF_SUBRING_GENERATED,
           SUBRING_GENERATED_SUBSET_CARRIER_SUBSET, SUBRING_GENERATED_REFL,
           SUBRING_GENERATED_INC, SUBRING_GENERATED_INC_GEN,
           SUBRING_OF_SUBRING_GENERATED_REV, TRIVIAL_RING_SUBRING_GENERATED,
           SUBRING_GENERATED_BY_SUBRING_GENERATED, SUBRING_GENERATED_INSERT_ZERO,
           RING_CARRIER_SUBRING_GENERATED_MONO, SUBRING_GENERATED_IDEMPOT_GEN,
           SUBRING_GENERATED_IDEMPOT, SUBRING_GENERATED_SUBRING_GENERATED,
           SUBRING_GENERATED_BY_SUBRING_GENERATED_IDEMPOT, SUBRING_GENERATED_UNION_LEFT,
           SUBRING_GENERATED_UNION_RIGHT, SUBRING_GENERATED_UNION,
           RING_CHAR_SUBRING_GENERATED, IN_SUBRING_GENERATED_FINITARY,
           SUBRING_GENERATED_FINITARY, SUBSET_SUBRING_GENERATED_FINITARY,
           SUBRING_GENERATED_PRIME_SUBRING, RING_CARRIER_SUBRING_GENERATED_0 }
  -- @@RETURN END

