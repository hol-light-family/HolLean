           RING_POWERSERIES, IN_POLY_RING_CARRIER, RING_POLYNOMIAL_CARRIER_GEN,
           RING_POLYNOMIAL_CARRIER, POLY_MONOMIALS_FINITE, FINITE_POLY_VARS,
           RING_CARRIER_POLY_RING_FINITE, POWSER_RING_MONO, POLY_RING_MONO,
           POLY_RING_POLY_VARS, POLY_RING_IN_POLY_VARS, POLY_RING_IN_FINITE_VARIABLES,
           IN_POLY_RING_SUBRING_GENERATED_FINITARY, POLY_VAR, POLY_VAR_UNIV, POLY_CONST,
           POWSER_VAR, POWSER_VAR_UNIV, POWSER_CONST, POLY_CONST_NEG, POLY_CONST_ADD,
           POLY_CONST_MUL, RING_OF_NUM_POWSER_RING, RING_OF_NUM_POLY_RING,
           POLY_CONST_OF_NUM, POLY_CONST_EQ, POLY_CONST_EQ_0, POLY_CONST_EQ_1,
           POWSER_VAR_MUL_EQ_0, POWSER_VARPOW_MUL_EQ_0, RING_HOMOMORPHISM_POLY_CONST,
           RING_MONOMORPHISM_POLY_CONST, RING_HOMOMORPHISM_POWSER_CONST,
           RING_MONOMORPHISM_POWSER_CONST, RING_HOMOMORPHISM_MONOMIAL_1, POWSER_SUM,
           POLY_SUM, POLY_RING_VAR_POW, POLY_RING_PRODUCT_VAR_POW, POLY_RING_PRODUCT_VAR,
           POLY_RING_EXPAND, POLY_RING_INDUCT, POLY_RING_INDUCT_STRONG,
           POLY_RING_HOMOMORPHISM_UNIQUE, TRIVIAL_POWSER_RING, TRIVIAL_POLY_RING,
           TRIVIAL_RING_POWSER_0, TRIVIAL_RING_POLY_0, RING_CARRIER_POWSER_RING,
           POWSER_MONOMIALS, RING_CARRIER_POLY_RING, POLY_MONOMIALS, POLY_MONOMIALS_ALT,
           POWSER_RING_EQ, POWSER_RING_EQ_IMP, POLY_RING_EQ, POLY_RING_EQ_IMP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The extension of a homomorphism to one from a polynomial ring.            -/
/- (ringtheory.ml 19451-20091)                                               -/
/- ------------------------------------------------------------------------- -/

structure HomExtend where
  -- @@FIELDS
  poly_extend : thm
  POLY_EXTEND_FROM_SUBRING_GENERATED : thm
  POLY_EXTEND : thm
  POLY_EXTEND_SUPERSET : thm
  POLY_EXTEND_POLYNOMIAL : thm
  POLY_EXTEND_CONST : thm
  POLY_EXTEND_0 : thm
  POLY_EXTEND_1 : thm
  POLY_EXTEND_VAR : thm
  POLY_EXTEND_NEG : thm
  POLY_EXTEND_ADD : thm
  POLY_EXTEND_SUB : thm
  POLY_EXTEND_MUL : thm
  POLY_EXTEND_POW : thm
  RING_HOMOMORPHISM_POLY_EXTEND : thm
  POLY_EXTEND_RING_SUM : thm
  POLY_EXTEND_RING_PRODUCT : thm
  POLY_EXTEND_UNIQUE : thm
  POLY_EXTEND_EQ : thm
  POLY_EXTEND_ID : thm
  POLY_EXTEND_COMPOSE : thm
  POLY_EXTEND_HOMOMORPHIC_IMAGE : thm
  POWSER_EXTEND_AT_0 : thm
  POLY_EXTEND_AT_0 : thm
  RING_HOMOMORPHISM_POWSER_EXTEND_AT_0 : thm
  POLY_SUBRING_GENERATED : thm
  RING_HOMOMORPHISMS_EQ_FROM_POLY_RING : thm
  POLY_SUBRING_GENERATED_1 : thm
  IMAGE_POLY_EXTEND : thm
  IMAGE_POLY_EXTEND_1 : thm
  POLY_EXTEND_INTO_SUBRING_GENERATED : thm
  deriving Inhabited

@[nospecialize]
def setupHomExtend [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BProducts : Products) (BSubrings : Subrings) (BHoms : Homs) (BRingRule : RingRule) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) :
    ExceptT String IO HomExtend := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, basic_ss,
        new_definition, .. } := D
  let { COND_RAND, COND_RATOR, COND_SWAP, CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM,
        EMPTY_GSPEC, ETA_AX, EXISTS_PAIR_THM, EXTENSION, .. } := D.core2
  let { FINITE_PRODUCT_DEPENDENT, FINITE_RESTRICT, FINITE_UNION, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_IN_UNION, FORALL_PAIR_THM, FUN_EQ_THM, IMAGE_CLAUSES,
        IMAGE_EQ, .. } := D.core3
  let { IMAGE_UNION, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INFINITE, .. } := D.core4
  let { IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_IMAGE, IN_UNION, IN_UNIV, LAMBDA_PAIR_THM, .. } := D.core5
  let { PAIR_EQ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SING_GSPEC, SUBSET,
        SUBSET_ANTISYM_EQ, SUBSET_RESTRICT, SUBSET_UNION, SUBSET_UNIV, UNIONS_SUBSET,
        UNION_COMM, UNION_SUBSET, UNIV_1, .. } := D.core7
  let { o_DEF, o_THM, .. } := D.core8
  let { RING_0, RING_1, RING_ADD_RDISTRIB, RING_MUL, RING_MUL_LID, RING_MUL_LNEG,
        RING_MUL_LZERO, RING_MUL_RID, RING_MUL_RZERO, RING_NEG_EQ_0, TRIVIAL_RING_10,
        ring_sub, trivial_ring, .. } := BBasics
  let { RING_POW, RING_POW_1, RING_POW_ADD, RING_POW_ZERO, ring_pow, .. } := BNumbers
  let { RING_SUM, RING_SUM_ADD, RING_SUM_CLAUSES, RING_SUM_EQ, RING_SUM_EQ_0,
        RING_SUM_IMAGE, RING_SUM_IMAGE_GEN, RING_SUM_LMUL, RING_SUM_NEG,
        RING_SUM_RESTRICT_SET, RING_SUM_RMUL, RING_SUM_SING, RING_SUM_SUM_PRODUCT,
        RING_SUM_SUPERSET, .. } := BSums
  let { RING_PRODUCT, RING_PRODUCT_0, RING_PRODUCT_CLAUSES, RING_PRODUCT_EQ,
        RING_PRODUCT_MUL, RING_PRODUCT_RESTRICT_SET, RING_PRODUCT_SING,
        RING_PRODUCT_SUPERSET, .. } := BProducts
  let { IN_SUBRING_MUL, IN_SUBRING_POW, IN_SUBRING_PRODUCT, IN_SUBRING_SUM,
        RING_CARRIER_SUBRING_GENERATED_SUBSET, RING_MUL_IN_SUBRING_GENERATED,
        RING_POW_IN_SUBRING_GENERATED, RING_POW_SUBRING_GENERATED, SUBRING_GENERATED,
        SUBRING_GENERATED_BY_SUBRING_GENERATED, SUBRING_GENERATED_EQ,
        SUBRING_GENERATED_INC, SUBRING_SUBRING_GENERATED, .. } := BSubrings
  let { RING_HOMOMORPHISM, RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED,
        RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_COMPOSE,
        RING_HOMOMORPHISM_FROM_TRIVIAL_RING, RING_HOMOMORPHISM_ID,
        RING_HOMOMORPHISM_INTO_SUBRING_EQ_GEN, RING_HOMOMORPHISM_MUL,
        RING_HOMOMORPHISM_POW, RING_HOMOMORPHISM_PRODUCT, RING_HOMOMORPHISM_SUM,
        RING_PRODUCT_SUBRING_GENERATED, RING_SUM_SUBRING_GENERATED,
        SUBRING_GENERATED_BY_HOMOMORPHIC_IMAGE, ring_homomorphism, .. } := BHoms
  let { RING_RULE, RING_TAC, .. } := BRingRule
  let { MONOMIAL_FINITE_DIVISORPAIRS, MONOMIAL_MUL_SYM, MONOMIAL_VARS_1,
        MONOMIAL_VARS_EQ_EMPTY, MONOMIAL_VARS_MUL, MONOMIAL_VARS_VAR, monomial,
        monomial_mul, monomial_var, monomial_vars, .. } := BMonomials
  let { POLY_SUB, POWSER_MUL_MONOMIAL_1, RING_POLYNOMIAL_IMP_POWERSERIES,
        RING_POLYNOMIAL_MUL, RING_POLYNOMIAL_NEG, RING_POWERSERIES_ADD,
        RING_POWERSERIES_MUL, poly_0, poly_1, poly_add, poly_const, poly_mul, poly_neg,
        poly_var, poly_vars, ring_polynomial, ring_powerseries, .. } := BPowerSeries
  let { POLY_CONST, POLY_MONOMIALS, POLY_MONOMIAL_IN_CARRIER, POLY_POW, POLY_RING,
        POLY_RING_HOMOMORPHISM_UNIQUE, POLY_VAR, POLY_VARS_POW, POWSER_RING,
        RING_CARRIER_POLY_RING, RING_HOMOMORPHISM_POLY_CONST, RING_POLYNOMIAL_POW, .. } := BPolyRings
  -- @@SCOPE END

  let poly_extend ← new_definition
   r"poly_extend (r,r') (h:A->B) (x:V->B) p =
        ring_sum r' {m | ~(p m = ring_0 r)}
                    (\m. ring_mul r' (h (p m))
                           (ring_product r' (monomial_vars m)
                                            (\i. ring_pow r' (x i) (m i))))"

  let POLY_EXTEND_FROM_SUBRING_GENERATED ← prove
   r"!r s r'.
      poly_extend(subring_generated r s,r'):(A->B)->(V->B)->((V->num)->A)->B =
      poly_extend(r,r')"
   (REWRITE_TAC [FUN_EQ_THM, poly_extend, ← CONJUNCT2 SUBRING_GENERATED])

  let POLY_EXTEND ← prove
   r"!r r' (h:A->B) p (x:V->B). poly_extend (r,r') h x p IN ring_carrier r'"
   (REWRITE_TAC [poly_extend, RING_SUM])

  let POLY_EXTEND_SUPERSET ← prove
   r"!s r r' (h:A->B) p (x:V->B).
        ring_homomorphism(r,r') h /\
        {m | ~(p m = ring_0 r)} SUBSET s
        ==> poly_extend (r,r') h x (p:(V->num)->A) =
            ring_sum r' s (\m. ring_mul r' (h (p m))
                                (ring_product r' (monomial_vars m)
                                         (\i. ring_pow r' (x i) (m i))))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_extend] THEN
    REWRITE_TAC [] THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_SUM_SUPERSET THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_HOMOMORPHISM_0) THEN
    ASM_SIMP_TAC [IN_ELIM_THM, RING_MUL_LZERO, RING_PRODUCT])

  let POLY_EXTEND_POLYNOMIAL ← prove
   r"!(h:A->B) r s (v:V->bool) x p.
        p IN ring_carrier(poly_ring r v) /\ ring_homomorphism (r,s) h
        ==> poly_extend (r,s) h x p =
            ring_sum s {m | monomial v m}
                       (\m. ring_mul s (h (p m))
                                  (ring_product s (monomial_vars m)
                                           (\i. ring_pow s (x i) (m i))))"
   (REWRITE_TAC [RING_CARRIER_POLY_RING, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC POLY_EXTEND_SUPERSET THEN ASM SET_TAC [])

  let POLY_EXTEND_CONST ← prove
   r"!r r' (h:A->B) (x:V->B) c.
        ring_homomorphism(r,r') h /\ c IN ring_carrier r
        ==> poly_extend (r,r') h x (poly_const r c) = h c"
   (REWRITE_TAC [ring_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [poly_extend, poly_const] THEN
    REWRITE_TAC [] THEN ONCE_REWRITE_TAC [COND_RAND] THEN
    ONCE_REWRITE_TAC [COND_RATOR] THEN
    REWRITE_TAC [← MESON [] (← q r"~(if p then q else T) <=> p /\ ~q")] THEN
    ASM_CASES_TAC (← q "c:A = ring_0 r") THEN
    ASM_REWRITE_TAC [EMPTY_GSPEC, RING_SUM_CLAUSES] THEN
    REWRITE_TAC [RING_SUM_SING, SING_GSPEC, MONOMIAL_VARS_1] THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, RING_MUL_RID])

  let POLY_EXTEND_0 ← prove
   r"!r r' (h:A->B) (x:V->B).
        ring_homomorphism(r,r') h
        ==> poly_extend (r,r') h x (poly_0 r) = ring_0 r'"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [poly_0, POLY_EXTEND_CONST, RING_0] THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_0 THEN ASM_REWRITE_TAC [])

  let POLY_EXTEND_1 ← prove
   r"!r r' (h:A->B) (x:V->B).
        ring_homomorphism(r,r') h
        ==> poly_extend (r,r') h x (poly_1 r) = ring_1 r'"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [poly_1, POLY_EXTEND_CONST, RING_1] THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_1 THEN ASM_REWRITE_TAC [])

  let POLY_EXTEND_VAR ← prove
   r"!r r' (h:A->B) (x:V->B) i.
        ring_homomorphism(r,r') h /\ x i IN ring_carrier r'
        ==> poly_extend (r,r') h x (poly_var r i) = x i"
   (← do
    -- right to left: the MESON, then the SET_RULE
    let mm ← MESON [] (← q r"~(if p then q else T) <=> p /\ ~q")
    let ss ← SET_RULE (← q r"a IN s ==> (s = {z} /\ P) /\ b IN s ==> a = b")
    pure (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q "trivial_ring (r:A ring)") THENL
     [ASM_SIMP_TAC [RING_HOMOMORPHISM_FROM_TRIVIAL_RING] THEN
      REWRITE_TAC [trivial_ring] THEN MATCH_MP_TAC ss THEN
      REWRITE_TAC [POLY_EXTEND],
      RULE_ASSUM_TAC (REWRITE_RULE [TRIVIAL_RING_10])] THEN
    REWRITE_TAC [ring_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [poly_extend, poly_var] THEN
    REWRITE_TAC [] THEN ONCE_REWRITE_TAC [COND_RAND] THEN
    ONCE_REWRITE_TAC [COND_RATOR] THEN
    ASM_REWRITE_TAC [mm] THEN
    REWRITE_TAC [RING_SUM_SING, SING_GSPEC] THEN
    SIMP_TAC [RING_MUL_LID, RING_PRODUCT, MONOMIAL_VARS_VAR] THEN
    REWRITE_TAC [RING_PRODUCT_SING] THEN
    ASM_SIMP_TAC [RING_POW, monomial_var, RING_POW_1]))

  let POLY_EXTEND_NEG ← prove
   r"!r r' (h:A->B) (x:V->B) p.
      ring_homomorphism(r,r') h /\ ring_polynomial r p
      ==> poly_extend (r,r') h x (poly_neg r p) =
          ring_neg r' (poly_extend (r,r') h x p)"
   (REWRITE_TAC [ring_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [ring_polynomial, ring_powerseries] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [poly_extend, poly_neg] THEN
    ASM_SIMP_TAC [RING_NEG_EQ_0, ← GSYM RING_SUM_NEG, RING_MUL, RING_PRODUCT] THEN
    ASM_SIMP_TAC [RING_MUL_LNEG, RING_PRODUCT])

  let POLY_EXTEND_ADD ← prove
   r"!r r' (h:A->B) (x:V->B) p1 p2.
      ring_homomorphism(r,r') h /\
      ring_polynomial r p1 /\ ring_polynomial r p2
      ==> poly_extend (r,r') h x (poly_add r p1 p2) =
          ring_add r' (poly_extend (r,r') h x p1) (poly_extend (r,r') h x p2)"
   (REWRITE_TAC [ring_polynomial, ring_powerseries] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_homomorphism]) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{m | ~((p1:(V->num)->A) m = ring_0 r)} UNION
                    {m | ~((p2:(V->num)->A) m = ring_0 r)}",
                   ← q "r:A ring", ← q "r':B ring", ← q "h:A->B"] POLY_EXTEND_SUPERSET) THEN
    ASM_SIMP_TAC [SUBSET_UNION] THEN DISCH_THEN (fun th =>
     wPart lhand (fun t => do lhand (← rand t)) th) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [poly_add, SUBSET, IN_UNION, IN_ELIM_THM] THEN RING_TAC,
      DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [RING_ADD_RDISTRIB, RING_PRODUCT, RING_SUM_ADD, RING_MUL,
                  FINITE_UNION, poly_add])

  let POLY_EXTEND_SUB ← prove
   r"!r r' (h:A->B) (x:V->B) p1 p2.
      ring_homomorphism(r,r') h /\
      ring_polynomial r p1 /\ ring_polynomial r p2
      ==> poly_extend (r,r') h x (poly_sub r p1 p2) =
          ring_sub r' (poly_extend (r,r') h x p1) (poly_extend (r,r') h x p2)"
   (SIMP_TAC [POLY_SUB, POLY_EXTEND_ADD, POLY_EXTEND_NEG, RING_POLYNOMIAL_NEG,
              ring_sub])

  let POLY_EXTEND_MUL ← prove
   r"!r r' (h:A->B) (x:V->B) p1 p2.
      ring_homomorphism(r,r') h /\
      ring_polynomial r p1 /\ ring_polynomial r p2 /\
      (!i. i IN poly_vars r p1 UNION poly_vars r p2 ==> x i IN ring_carrier r')
      ==> poly_extend (r,r') h x (poly_mul r p1 p2) =
          ring_mul r' (poly_extend (r,r') h x p1) (poly_extend (r,r') h x p2)"
   (← do
    let lemma ← prove
     r"{x,y | P x y} = IMAGE (\(x,y). y,x) {x,y | P y x}"
     (REWRITE_TAC [EXTENSION, IN_IMAGE, FORALL_PAIR_THM, EXISTS_PAIR_THM] THEN
      REWRITE_TAC [IN_ELIM_PAIR_THM] THEN
      REWRITE_TAC [PAIR_EQ] THEN MESON_TAC [])
    -- right to left: the second MESON[INFINITE], the MESON on ring_product,
    -- the RING_RULE, the MESON on rsum t, the first MESON[INFINITE], the
    -- MESON[RING_SUM_CLAUSES], the MESON on rsum UNIV, the SET_RULE, and
    -- the basic_ss []
    let mi2 ← MESON [INFINITE] (← q r"~INFINITE s <=> FINITE s")
    let mp ← MESON []
     (← q r"(ring_product r s f = ring_product r u f /\
       ring_product r t g = ring_product r u g) /\
      ring_mul r (ring_product r u f) (ring_product r u g) =
      ring_product r u h
      ==> ring_mul r (ring_product r s f) (ring_product r t g) =
          ring_product r u h")
    let rr ← RING_RULE
     (← q r"a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r /\
      x IN ring_carrier r /\ y IN ring_carrier r /\
      ring_mul r a b = c
      ==> ring_mul r (ring_mul r x y) c =
          ring_mul r (ring_mul r x a) (ring_mul r y b)")
    let mt ← MESON []
     (← q r"rsum s f = rsum t f /\ rsum t f = rsum t g
      ==> rsum s f = rsum t g")
    let mi1 ← MESON [INFINITE] (← q r"~INFINITE s <=> FINITE s")
    let mc ← MESON [RING_SUM_CLAUSES]
       (← q r"s = {} ==> ring_sum r s f = ring_0 r")
    let mu ← MESON []
     (← q r"(rsum UNIV f = rsum s f /\ rsum UNIV g = rsum t g) /\
      rsum UNIV f = rsum UNIV g
      ==> rsum s f = rsum t g")
    let sr ← SET_RULE
     (← q r"{z | z IN {x,y | P x y} /\ Q z} = {x,y | P x y /\ Q(x,y)}")
    let ss ← ExceptT.mk (basic_ss [])
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_extend] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_homomorphism]) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN STRIP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_polynomial, ring_powerseries]) THEN
    ASM_SIMP_TAC [← GSYM RING_SUM_LMUL, RING_SUM, RING_MUL, RING_PRODUCT] THEN
    ASM_SIMP_TAC [← GSYM RING_SUM_RMUL, RING_SUM, RING_MUL, RING_PRODUCT] THEN
    ASM (simpTac ss 4)
     [RING_SUM_SUM_PRODUCT, RING_MUL, RING_PRODUCT] THEN
    MP_TAC (← ISPECL [← q "r':B ring", ← q r"\(m1:V->num,m2). monomial_mul m1 m2"]
          RING_SUM_IMAGE_GEN) THEN
    ASM_SIMP_TAC [FINITE_PRODUCT_DEPENDENT] THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
    REWRITE_TAC [sr] THEN
    MATCH_MP_TAC mu THEN
   CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC RING_SUM_SUPERSET THEN
      REWRITE_TAC [SUBSET_UNIV, IN_UNIV, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [RING_MUL_LZERO, RING_PRODUCT] THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_PAIR_THM] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC mc THEN
      ASM SET_TAC [],
      MATCH_MP_TAC RING_SUM_EQ] THEN
    X_GEN_TAC (← q r"m:V->num") THEN REWRITE_TAC [IN_UNIV] THEN
    ASM_CASES_TAC (← q r"INFINITE(monomial_vars m:V->bool)") THENL
     [MP_TAC (← ISPECL [← q "r:A ring", ← q r"p1:(V->num)->A", ← q r"p2:(V->num)->A"]
        RING_POLYNOMIAL_MUL) THEN
      ASM_SIMP_TAC [ring_polynomial, ring_powerseries] THEN STRIP_TAC THEN
      SIMP_TAC [RING_MUL_LZERO, RING_PRODUCT] THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC RING_SUM_EQ_0 THEN
      REWRITE_TAC [IMP_CONJ] THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"m1:V->num", ← q r"m2:V->num"] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC (SUBST_ALL_TAC o SYM)) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [MONOMIAL_VARS_MUL]) THEN
      ASM_REWRITE_TAC [INFINITE, FINITE_UNION, monomial_vars] THEN
      REWRITE_TAC [← GSYM INFINITE, ← GSYM monomial_vars, DE_MORGAN_THM] THEN
      ASM_MESON_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [mi1])] THEN
    REWRITE_TAC [poly_mul] THEN FIRST_ASSUM (fun th => tactic_of do
     pure (wPart (fun t => do lhand (← lhand t)) (fun t => do lhand (← rand t))
       (← MATCH_MP RING_HOMOMORPHISM_SUM th))) THEN
    ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [MONOMIAL_FINITE_DIVISORPAIRS] THEN ASM_SIMP_TAC [RING_MUL],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [o_DEF]] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o RAND_CONV) [LAMBDA_PAIR_THM] THEN
    ASM_SIMP_TAC [] THEN
