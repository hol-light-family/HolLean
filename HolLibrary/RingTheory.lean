      CONJ_TAC THENL
      [SUBGOAL_THEN
         (← q r"ring_mul (r':B ring) y (ring_mul r' (alpha (b:A)) (x:B)) =
        ring_mul r' (ring_mul r' y (alpha b)) x /\
        ring_mul (r':B ring) (g (ring_localequiv r s (a:A,b)))
