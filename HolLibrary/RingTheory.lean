      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [monomial]) THEN
      REWRITE_TAC [monomial_vars] THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"p:(V->num)->A") THEN STRIP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE
       [RING_CARRIER_POWSER_RING, monomial, IN_ELIM_THM]) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [POWSER_RING, poly_0, poly_const, COND_ID] THEN
        ONCE_REWRITE_TAC [FUN_EQ_THM] THEN REWRITE_TAC [] THEN
        MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
         (← q r"UNIONS { {d | monomial_divides d m} |
                   m IN {m | ~((p:(V->num)->A) m = ring_0 r)}}") THEN
        ASM_SIMP_TAC [FINITE_UNIONS, SIMPLE_IMAGE, FINITE_IMAGE] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, UNIONS_IMAGE, FORALL_IN_GSPEC] THEN
        CONJ_TAC THENL
         [REWRITE_TAC [MONOMIAL_FINITE_DIVISORS] THEN ASM SET_TAC [],
          GEN_REWRITE_TAC id [SUBSET] THEN REWRITE_TAC [IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"n:V->num") THEN REWRITE_TAC [NOT_FORALL_THM, m6] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"p:V->num") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"monomial_mul n p:V->num") THEN
          ASM_SIMP_TAC [MONOMIAL_DIVIDES_RMUL, MONOMIAL_DIVIDES_REFL]],
        X_GEN_TAC (← q r"m:V->num") THEN
        ASM_SIMP_TAC [RING_CARRIER_POWSER_RING, IN_ELIM_THM] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [RING_0], ALL_TAC] THEN
        MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
         (← q r"UNIONS { {d | monomial_divides d m} |
                   m IN {m | ~((p:(V->num)->A) m = ring_0 r)}}") THEN
        ASM_SIMP_TAC [FINITE_UNIONS, SIMPLE_IMAGE, FINITE_IMAGE] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, UNIONS_IMAGE, FORALL_IN_GSPEC] THEN
        CONJ_TAC THENL
         [REWRITE_TAC [MONOMIAL_FINITE_DIVISORS] THEN ASM SET_TAC [],
          GEN_REWRITE_TAC id [SUBSET] THEN REWRITE_TAC [IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"n:V->num") THEN STRIP_TAC THEN
          EXISTS_TAC (← q r"monomial_mul m n:V->num") THEN
          ASM_SIMP_TAC [MONOMIAL_DIVIDES_LMUL, MONOMIAL_DIVIDES_REFL]]]]))

  let ISOMORPHIC_RING_POLY_POLY ← prove
   r"!(r:A ring) u v:V->bool.
        DISJOINT u v
        ==> poly_ring (poly_ring r u) v isomorphic_ring
            poly_ring r (u UNION v)"
   (MP_TAC RING_ISOMORPHISMS_POLY_POLY_RING THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [isomorphic_ring, ring_isomorphism] THEN
    MESON_TAC [])

  let ISOMORPHIC_RING_POLY_POLY_GEN ← prove
   r"!(r:A ring) (r':B ring) (u:U->bool) (v:V->bool) (w:W->bool).
        r isomorphic_ring r' /\ u +_c v =_c w
        ==> poly_ring (poly_ring r u) v isomorphic_ring poly_ring r' w"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC ISOMORPHIC_RING_TRANS
     (← q r"poly_ring (r:A ring) ((u:U->bool) +_c (v:V->bool))") THEN
    ASM_SIMP_TAC [ISOMORPHIC_POLY_RINGS, CARD_EQ_REFL] THEN
    REWRITE_TAC [add_c] THEN
    wPart rand (fun t => do rand (← rand t)) ISOMORPHIC_RING_POLY_POLY THEN
    REWRITE_TAC [sum_DISTINCT, ← SET_RULE
       (← q r"DISJOINT {f x | x IN s} {g y | y IN t} <=>
        !x y. x IN s /\ y IN t ==> ~(f x = g y)")] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] ISOMORPHIC_RING_TRANS) THEN
    REPEAT (MATCH_MP_TAC ISOMORPHIC_POLY_RINGS THEN CONJ_TAC) THEN
    REWRITE_TAC [ISOMORPHIC_RING_REFL] THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
    REWRITE_TAC [SIMPLE_IMAGE] THEN MATCH_MP_TAC CARD_EQ_IMAGE THEN
    SIMP_TAC [sum_INJECTIVE])

  let POLY_EXTEND_EXTEND ← prove
   r"!(h:A->B) r s u v x (p:(V->num)->A).
        p IN ring_carrier(poly_ring r (u UNION v)) /\
        DISJOINT u v /\
        ring_homomorphism (r,s) h
        ==> poly_extend (poly_ring r u,s) (poly_extend (r,s) h x) x
                        (\m1 m2. if monomial v m1 /\ monomial u m2
                                 then p (monomial_mul m1 m2)
                                 else ring_0 r) =
            poly_extend (r,s) h x p"
   (← do
    -- right to left: the SET_RULE, the MONOMIAL_RULE, the TAUT, the MESON
    let sr ← SET_RULE (← q r"DISJOINT s t ==> !x. ~(x IN s /\ x IN t)")
    let mr ← MONOMIAL_RULE (← q r"monomial_mul m2 m1:V->num = monomial_mul m1 m2")
    let tt ← TAUT (← q r"r /\ (r ==> q) /\ (q ==> p) ==> (p /\ q) /\ r")
    let mm ← MESON []
     (← q r"(FINITE s /\ (!x. x IN s ==> FINITE(t x))) /\
      (FINITE s /\ (!x. x IN s ==> FINITE(t x))
       ==> ring_sum r s (\x. ring_mul r (ring_sum r (t x)  (f x)) (c x)) =
           ring_sum r s (\x. ring_sum r (t x) (\y. ring_mul r (f x y) (c x))) /\
           ring_sum r s (\x. ring_sum r (t x) (\y. ring_mul r (f x y) (c x))) = w)
      ==> ring_sum r s (\x. ring_mul r (ring_sum r (t x) (f x)) (c x)) = w")
    pure (REWRITE_TAC [RING_CARRIER_POLY_RING, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [poly_extend] THEN MATCH_MP_TAC mm THEN
    CONJ_TAC THENL
     [REWRITE_TAC [IN_ELIM_THM] THEN
      CONJ_TAC THENL [ALL_TAC, X_GEN_TAC (← q r"m1:V->num") THEN STRIP_TAC] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
        (← q r"UNIONS { {d | monomial_divides d m} |
                  ~((p:(V->num)->A) m = ring_0 r)}") THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      REWRITE_TAC [FINITE_UNIONS, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_GSPEC, IMAGE_ID] THEN
      REWRITE_TAC [MONOMIAL_FINITE_DIVISORS] THEN
      (CONJ_TAC THENL [ASM_MESON_TAC [monomial], ALL_TAC]) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, UNIONS_IMAGE] THEN
      X_GEN_TAC (← q r"m2:V->num") THENL
       [GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [FUN_EQ_THM] THEN
        REWRITE_TAC [NOT_FORALL_THM, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"m1:V->num") THEN REWRITE_TAC [POLY_RING, POLY_0] THEN
        ONCE_REWRITE_TAC [MONOMIAL_MUL_SYM],
        ALL_TAC] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"monomial_mul m1 m2:V->num") THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => (MONOMIAL_RULE t).run),
      REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"m2:V->num") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_SUM_RMUL THEN
      ASM_SIMP_TAC [IN_ELIM_THM, RING_PRODUCT] THEN
      X_GEN_TAC (← q r"m1:V->num") THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      DISCH_TAC THEN MATCH_MP_TAC RING_MUL THEN REWRITE_TAC [RING_PRODUCT] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism]) THEN ASM SET_TAC [],
      ALL_TAC] THEN
     wPart lhand (fun t => do lhand (← rand t)) RING_SUM_SUM_PRODUCT THEN
     ASM_REWRITE_TAC [IN_ELIM_THM, RING_PRODUCT] THEN ANTS_TAC THENL
      [MAP_EVERY X_GEN_TAC [← q r"m2:V->num", ← q r"m1:V->num"] THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
       REPEAT (MATCH_MP_TAC RING_MUL THEN REWRITE_TAC [RING_PRODUCT]) THEN
       RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism]) THEN ASM SET_TAC [],
       DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC RING_SUM_EQ_GENERAL_INVERSES THEN
    EXISTS_TAC (← q r"\((m2:V->num),m1). monomial_mul m1 m2") THEN
    EXISTS_TAC (← q r"\m:V->num. monomial_restrict v m,monomial_restrict u m") THEN
    REWRITE_TAC [IN_ELIM_PAIR_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"m:V->num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"monomial (u UNION v) (m:V->num)")
        (fun th => ASSUME_TAC th THEN MP_TAC th)
      THENL
       [ASM SET_TAC [], GEN_REWRITE_TAC LAND_CONV [monomial] THEN STRIP_TAC] THEN
      ASM_SIMP_TAC [MONOMIAL_RESTRICT_EQ, FINITE_INTER] THEN
      MATCH_MP_TAC tt THEN
      REPEAT CONJ_TAC THENL
       [ASM_SIMP_TAC [MONOMIAL_MUL_RESTRICT, MONOMIAL_RESTRICT_REFL],
        ASM_MESON_TAC [MONOMIAL_MUL_SYM],
        DISCH_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"monomial_restrict u m:V->num")) THEN
        ASM_SIMP_TAC [MONOMIAL_RESTRICT_EQ, FINITE_INTER] THEN
        ASM_REWRITE_TAC [POLY_0, POLY_RING]],
      MAP_EVERY X_GEN_TAC [← q r"m2:V->num", ← q r"m1:V->num"] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC) THEN
      SUBST1_TAC mr THEN
      DISCH_THEN (ASSUME_TAC o CONJUNCT2) THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [PAIR_EQ, FUN_EQ_THM] THEN
        REWRITE_TAC [monomial_restrict, monomial_mul] THEN CONJ_TAC THEN
        REPEAT (FIRST_X_ASSUM
         (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [monomial])) THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP sr) THEN
        REWRITE_TAC [SUBSET, IMP_IMP, AND_FORALL_THM, monomial_vars] THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q "i:V") THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        MAP_EVERY ASM_CASES_TAC [← q "(i:V) IN u", ← q "(i:V) IN v"] THEN
        ASM_REWRITE_TAC [] THEN ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(h:A->B)(p(monomial_mul m1 m2:V->num)) IN ring_carrier s")
      ASSUME_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism]) THEN ASM SET_TAC [],
        ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, RING_PRODUCT]] THEN
      AP_TERM_TAC THEN REWRITE_TAC [MONOMIAL_VARS_MUL] THEN
      wPart lhand (fun t => do lhand (← rand t)) RING_PRODUCT_UNION THEN
      ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [monomial]) THEN ASM SET_TAC [],
        DISCH_THEN SUBST1_TAC] THEN
      BINOP_TAC THEN MATCH_MP_TAC RING_PRODUCT_EQ THEN
      X_GEN_TAC (← q "i:V") THEN DISCH_TAC THEN
      REWRITE_TAC [] THEN AP_TERM_TAC THEN
      REWRITE_TAC [monomial_mul, EQ_ADD_LCANCEL_0, EQ_ADD_RCANCEL_0] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [monomial, monomial_vars]) THEN
      ASM SET_TAC []]))

  -- @@RETURN BEGIN
  return { RING_ISOMORPHISM_POWSER_RING_TRIVIAL, RING_ISOMORPHISM_POLY_RING_TRIVIAL,
           ISOMORPHIC_POWSER_RING_TRIVIAL, ISOMORPHIC_POLY_RING_TRIVIAL,
           RING_ISOMORPHISMS_POWSER_RINGS, ISOMORPHIC_POWSER_RINGS,
           RING_ISOMORPHISMS_POLY_RINGS, ISOMORPHIC_POLY_RINGS,
           RING_ISOMORPHISMS_POWSER_POWSER_RING, ISOMORPHIC_RING_POWSER_POWSER,
           ISOMORPHIC_RING_POWSER_POWSER_GEN, RING_CARRIER_POWSER_SUBRING_GENERATED,
           RING_CARRIER_POLY_SUBRING_GENERATED,
           RING_CARRIER_POWSER_SUBRING_GENERATED_MONO,
           RING_CARRIER_POLY_SUBRING_GENERATED_MONO,
           RING_CARRIER_POWSER_SUBRING_GENERATED_SUBSET,
           RING_CARRIER_POLY_SUBRING_GENERATED_SUBSET, SUBRING_POWSER_INTO_SUBRING,
           SUBRING_POLY_INTO_SUBRING, RING_ISOMORPHISMS_POWSER_SUBRING_GENERATED,
           ISOMORPHIC_RINGS_POWSER_SUBRING_GENERATED,
           RING_ISOMORPHISMS_POLY_SUBRING_GENERATED,
           ISOMORPHIC_RINGS_POLY_SUBRING_GENERATED, RING_ISOMORPHISMS_POLY_POLY_RING,
           ISOMORPHIC_RING_POLY_POLY, ISOMORPHIC_RING_POLY_POLY_GEN, POLY_EXTEND_EXTEND }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The special case of renaming polynomial variables via a bijection.        -/
/- (ringtheory.ml 21031-21305)                                               -/
/- ------------------------------------------------------------------------- -/

structure Renaming where
  -- @@FIELDS
  poly_reindex : thm
  RING_ISOMORPHISMS_POWSER_REINDEX : thm
  RING_ISOMORPHISM_POWSER_REINDEX : thm
  RING_ISOMORPHISMS_POLY_REINDEX : thm
  POLY_VARS_REINDEX : thm
  RING_ISOMORPHISM_POLY_REINDEX : thm
  POLY_REINDEX_CONST : thm
  POLY_REINDEX_VAR : thm
  MONOMIALS_POLY_REINDEX : thm
  POLY_EXTEND_REINDEX : thm
  RING_POWERSERIES_REINDEX : thm
  POLY_RING_HOMOMORPHISM_I : thm
  POLY_CONST_DIVIDES_COEFFS : thm
  POLY_CONST_DIVIDES_COEFFS_REV : thm
  POLY_CONST_DIVIDES_COEFFS_EQ : thm
  POLY_CONST_DIVIDES_CONST : thm
  deriving Inhabited

@[nospecialize]
def setupRenaming [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BSums : Sums) (BProducts : Products) (BDivides : Divides) (BHoms : Homs) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BHomExtend : HomExtend) (BNatIso : NatIso) :
    ExceptT String IO Renaming := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, METIS_TAC, SET_TAC, new_definition, .. } := D
  let { BIJ, COND_ID, .. } := D.core1
  let { CONJ_ASSOC, CONTRAPOS_THM, EMPTY_SUBSET, EXTENSION, .. } := D.core2
  let { FINITE_IMAGE_INJ_EQ, FINITE_SUBSET, FORALL_AND_THM, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, INFINITE, INJ, INJECTIVE_ON_LEFT_INVERSE, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, I_THM, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_AND, NOT_FORALL_THM, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, SING_SUBSET, SKOLEM_THM, SUBSET, SUBSET_ANTISYM_EQ, SURJ,
        UNIONS_SUBSET, .. } := D.core7
  let { o_DEF, o_THM, .. } := D.core8
  let { RING_0, RING_MUL_RZERO, .. } := BBasics
  let { RING_SUM_EQ, RING_SUM_IMAGE, .. } := BSums
  let { RING_PRODUCT_EQ, RING_PRODUCT_IMAGE, .. } := BProducts
  let { RING_DIVIDES_IN_CARRIER, ring_divides, .. } := BDivides
  let { RING_ISOMORPHISMS_EQ, RING_ISOMORPHISMS_ID, ring_homomorphism,
        ring_isomorphism, .. } := BHoms
  let { MONOMIAL_VARS_1, MONOMIAL_VARS_VAR, monomial_1, monomial_var, monomial_vars, .. } := BMonomials
  let { POLY_MUL_CONST, poly_const, poly_var, poly_vars, ring_polynomial,
        ring_powerseries, .. } := BPowerSeries
  let { IN_POLY_RING_CARRIER, POLY_CONST, POLY_MONOMIAL_IN_CARRIER, POLY_RING, .. } := BPolyRings
  let { poly_extend, .. } := BHomExtend
  let { RING_ISOMORPHISMS_POLY_RINGS, RING_ISOMORPHISMS_POWSER_RINGS, .. } := BNatIso
  -- @@SCOPE END

  let poly_reindex ← new_definition
   r"poly_reindex (r:R ring) (q:(Y->num)->R) (f:X->Y) (A:X->bool) (B:Y->bool) =
  \m. if monomial_vars m SUBSET A
      then q (\b. if b IN B then m (@a. a IN A /\ f a = b) else 0)
      else ring_0 r"

  let RING_ISOMORPHISMS_POWSER_REINDEX ← prove
   r"!(r:A ring) s t (i:V->W) j.
        (!x. x IN s ==> i(x) IN t /\ j(i x) = x) /\
        (!y. y IN t ==> j(y) IN s /\ i(j y) = y)
        ==> ring_isomorphisms (powser_ring r s,powser_ring r t)
                              ((\p. poly_reindex r p j t s),
                               (\q. poly_reindex r q i s t))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "r:A ring", ← q r"s:V->bool", ← q r"t:W->bool",
                   ← q r"\x:A. x", ← q r"\x:A. x", ← q r"i:V->W", ← q r"j:W->V"]
          RING_ISOMORPHISMS_POWSER_RINGS) THEN
    ASM_REWRITE_TAC [RING_ISOMORPHISMS_ID, poly_reindex] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] RING_ISOMORPHISMS_EQ) THEN
    REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN REWRITE_TAC [] THEN
    GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN ABS_TAC THEN ASM_MESON_TAC [])

  let RING_ISOMORPHISM_POWSER_REINDEX ← prove
   r"!(r:A ring) s t (i:W->V).
        BIJ i s t
        ==> ring_isomorphism (powser_ring r t,powser_ring r s)
                             (\q. poly_reindex r q i s t)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [BIJ, INJ, SURJ] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INJECTIVE_ON_LEFT_INVERSE]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"j:V->W")) THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"t:V->bool", ← q r"s:W->bool",
                   ← q r"j:V->W", ← q r"i:W->V"] RING_ISOMORPHISMS_POWSER_REINDEX) THEN
    REWRITE_TAC [ring_isomorphism] THEN ASM SET_TAC [])

  let RING_ISOMORPHISMS_POLY_REINDEX ← prove
   r"!(r:A ring) s t (i:V->W) j.
        (!x. x IN s ==> i(x) IN t /\ j(i x) = x) /\
        (!y. y IN t ==> j(y) IN s /\ i(j y) = y)
        ==> ring_isomorphisms (poly_ring r s,poly_ring r t)
                              ((\p. poly_reindex r p j t s),
                               (\q. poly_reindex r q i s t))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "r:A ring", ← q r"s:V->bool", ← q r"t:W->bool",
                   ← q r"\x:A. x", ← q r"\x:A. x", ← q r"i:V->W", ← q r"j:W->V"]
          RING_ISOMORPHISMS_POLY_RINGS) THEN
    ASM_REWRITE_TAC [RING_ISOMORPHISMS_ID, poly_reindex] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] RING_ISOMORPHISMS_EQ) THEN
    REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN REWRITE_TAC [] THEN
    GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN ABS_TAC THEN ASM_MESON_TAC [])

  let POLY_VARS_REINDEX ← prove
   r"!(r:R ring) A B q f:X->Y.
       poly_vars r q SUBSET B
       ==> poly_vars r (poly_reindex r q f A B) SUBSET A"
   (REWRITE_TAC [poly_reindex, poly_vars, UNIONS_SUBSET, IN_ELIM_THM] THEN
    REWRITE_TAC [monomial_vars, SUBSET, IN_ELIM_THM, EXTENSION] THEN
    MESON_TAC [])

  let RING_ISOMORPHISM_POLY_REINDEX ← prove
   r"!(r:A ring) s t (i:W->V).
        BIJ i s t
        ==> ring_isomorphism (poly_ring r t,poly_ring r s)
                             (\q. poly_reindex r q i s t)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [BIJ, INJ, SURJ] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INJECTIVE_ON_LEFT_INVERSE]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"j:V->W")) THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"t:V->bool", ← q r"s:W->bool",
                   ← q r"j:V->W", ← q r"i:W->V"] RING_ISOMORPHISMS_POLY_REINDEX) THEN
    REWRITE_TAC [ring_isomorphism] THEN ASM SET_TAC [])

  let POLY_REINDEX_CONST ← prove
   r"!(r:A ring) f (s:V->bool) (t:W->bool) a.
        BIJ f s t ==> poly_reindex r (poly_const r a) f s t = poly_const r a"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_reindex, poly_const] THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"m:V->num") THEN
    REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"m:V->num = monomial_1") THENL
     [ASM_REWRITE_TAC [MONOMIAL_VARS_1, EMPTY_SUBSET] THEN
      ASM_REWRITE_TAC [monomial_1, COND_ID],
      ASM_REWRITE_TAC []] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [FUN_EQ_THM]) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FUN_EQ_THM]) THEN
    REWRITE_TAC [monomial_1] THEN
    REWRITE_TAC [← MESON [] (← q r"(if p then x else 0) = 0 <=> p ==> x = 0")] THEN
    DISCH_TAC THEN
    REWRITE_TAC [NOT_FORALL_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "i:V") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "i:V") o GEN_REWRITE_RULE id [SUBSET]) THEN
    ASM_REWRITE_TAC [monomial_vars, IN_ELIM_THM] THEN DISCH_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [BIJ, INJ, SURJ]) THEN ASM_MESON_TAC [])

  let POLY_REINDEX_VAR ← prove
   r"!(r:A ring) f (s:V->bool) (t:W->bool) x.
        BIJ f s t /\ x IN s
        ==> poly_reindex r (poly_var r (f x)) f s t = poly_var r x"
   (← do
    -- right to left: the TAUT, then the MESON
    let tt ← TAUT (← q "F ==> p")
    let mm ← MESON [] (← q "p ==> (if p then x else y) = x")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_reindex, poly_var] THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"m:V->num") THEN
    REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"m:V->num = monomial_var x") THENL
     [ASM_REWRITE_TAC [MONOMIAL_VARS_VAR, SING_SUBSET] THEN
      ASM_REWRITE_TAC [monomial_var] THEN MATCH_MP_TAC mm THEN
      GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [BIJ, INJ, SURJ]) THEN ASM_MESON_TAC [],
      ASM_REWRITE_TAC []] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC tt THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [FUN_EQ_THM]) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FUN_EQ_THM]) THEN
    REWRITE_TAC [monomial_var] THEN DISCH_TAC THEN
    X_GEN_TAC (← q "i:V") THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(f:V->W) i")) THEN
    ASM_CASES_TAC (← q "i:V = x") THEN ASM_REWRITE_TAC [] THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [BIJ, INJ, SURJ]) THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q "i:V") o GEN_REWRITE_RULE id [SUBSET]) THEN
    ASM_REWRITE_TAC [monomial_vars, IN_ELIM_THM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [BIJ, INJ, SURJ]) THEN ASM_MESON_TAC []))

  let MONOMIALS_POLY_REINDEX ← prove
   r"!(r:R ring) A B q f:X->Y.
        BIJ f A B /\ poly_vars r q SUBSET B
        ==> {m | ~((poly_reindex r q f A B) m = ring_0 r)} =
            IMAGE (\m. \a. if a IN A then m (f a) else 0)
                  {m | ~(q m = ring_0 r)}"
   (REWRITE_TAC [poly_vars, UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [poly_reindex] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN ONCE_REWRITE_TAC [SUBSET] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_IMAGE, IN_ELIM_THM] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"m:X->num") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"\b:Y. if b IN B then m(@a:X. a IN A /\ f a = b) else 0"),
      X_GEN_TAC (← q r"m:Y->num") THEN DISCH_TAC THEN
      REWRITE_TAC [monomial_vars, SUBSET, IN_ELIM_THM] THEN
      COND_CASES_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
        (← q r"~(q m = z) ==> m = m' ==> ~(q m' = z)")))] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [BIJ, INJ, SURJ, monomial_vars, SUBSET, IN_ELIM_THM]) THEN
    REWRITE_TAC [FUN_EQ_THM] THEN ASM_MESON_TAC [])

  let POLY_EXTEND_REINDEX ← prove
   r"!(h:R->S) r s A B q f:X->Y c:Y->S.
        BIJ f A B /\ poly_vars r q SUBSET B
        ==> poly_extend (r,s) h (c o f) (poly_reindex r q f A B) =
            poly_extend (r,s) h c q"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [poly_extend, MONOMIALS_POLY_REINDEX] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [poly_vars, UNIONS_SUBSET, FORALL_IN_GSPEC]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE
       [BIJ, INJ, SURJ, monomial_vars, SUBSET, IN_ELIM_THM]) THEN
    wPart lhand (fun t => do lhand (← rand t)) RING_SUM_IMAGE THEN
    ANTS_TAC THENL
     [REWRITE_TAC [IN_ELIM_THM, FUN_EQ_THM] THEN ASM METIS_TAC [],
      DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC RING_SUM_EQ THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"m:Y->num") THEN DISCH_TAC THEN REWRITE_TAC [o_THM] THEN
    BINOP_TAC THENL
     [AP_TERM_TAC THEN REWRITE_TAC [poly_reindex] THEN
      REWRITE_TAC [monomial_vars, SUBSET, IN_ELIM_THM] THEN
      COND_CASES_TAC THENL [AP_TERM_TAC, ASM_MESON_TAC []] THEN
      REWRITE_TAC [FUN_EQ_THM] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"monomial_vars (m:Y->num) =
      IMAGE f (monomial_vars (\a:X. if a IN A then m(f a) else 0))")
    SUBST1_TAC THENL
     [REWRITE_TAC [monomial_vars, EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
      REWRITE_TAC [FUN_EQ_THM] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    wPart rand (fun t => do lhand (← rand t)) RING_PRODUCT_IMAGE THEN
    ANTS_TAC THENL
     [REWRITE_TAC [monomial_vars, EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
      REWRITE_TAC [FUN_EQ_THM] THEN ASM_MESON_TAC [],
      DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC RING_PRODUCT_EQ THEN
    REWRITE_TAC [monomial_vars, EXTENSION, IN_IMAGE, o_DEF, IN_ELIM_THM] THEN
    ASM_MESON_TAC [])

  let RING_POWERSERIES_REINDEX ← prove
   r"!(r:R ring) A B q f:X->Y.
        BIJ f A B /\ ring_powerseries r q
        ==> ring_powerseries r (poly_reindex r q f A B)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_powerseries, poly_reindex] THEN
    REPEAT STRIP_TAC THENL [ASM_MESON_TAC [RING_0], ALL_TAC] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INFINITE]) THEN
    REWRITE_TAC [INFINITE, CONTRAPOS_THM, monomial_vars] THEN
    MP_TAC (← ISPECL [← q r"f:X->Y", ← q r"{i:X | ~(m i = 0)}"] FINITE_IMAGE_INJ_EQ) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [monomial_vars, SUBSET, IN_ELIM_THM]) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN ASM SET_TAC [])

  let POLY_RING_HOMOMORPHISM_I ← prove
   r"!(r:A ring) (t:V->bool) s.
     t SUBSET s
     ==> ring_homomorphism (poly_ring r t,poly_ring r s) I"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ring_homomorphism, I_THM, POLY_RING,
                 IMAGE, SUBSET, IN_ELIM_THM] THEN
    ASM SET_TAC [])

  let POLY_CONST_DIVIDES_COEFFS ← prove
   r"!(r:A ring) (s:V->bool) c (p:(V->num)->A).
        p IN ring_carrier(poly_ring r s) /\
        (!m. ring_divides r c (p m))
        ==> ring_divides (poly_ring r s) (poly_const r c) p"
   (← do
    -- right to left: the MESON, then the TAUT
    let mm ← MESON [] (← q r"(if p then z else x) = z <=> p \/ x = z")
    let tt ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [ring_divides]) THEN
    REWRITE_TAC [FORALL_AND_THM, SKOLEM_THM] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_REWRITE_TAC [ring_divides, RIGHT_AND_EXISTS_THM, POLY_CONST] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:(V->num)->A") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC
     (← q r"q' = \m. if p m = ring_0 r then ring_0 r else (q:(V->num)->A) m") THEN
    EXISTS_TAC (← q r"q':(V->num)->A") THEN
    MATCH_MP_TAC tt THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"(p:(V->num)->A) IN ring_carrier (poly_ring r s)") THEN
      REWRITE_TAC [POLY_RING, IN_ELIM_THM, ring_polynomial, ring_powerseries] THEN
      ASM_REWRITE_TAC [poly_vars] THEN EXPAND_TAC "q'" THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC] THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [mm] THEN
      DISCH_THEN (fun th =>
        CONJ_TAC THENL [ASM_MESON_TAC [RING_0], MP_TAC th]) THEN
      MATCH_MP_TAC MONO_AND THEN SIMP_TAC [] THEN
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN SET_TAC [],
        SET_TAC []],
      REWRITE_TAC [IN_POLY_RING_CARRIER] THEN
      ASM_SIMP_TAC [POLY_MUL_CONST, ← CONJUNCT2 POLY_RING] THEN
      EXPAND_TAC "q'" THEN REWRITE_TAC [FUN_EQ_THM] THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [RING_MUL_RZERO]]))

  let POLY_CONST_DIVIDES_COEFFS_REV ← prove
   r"!(r:A ring) (s:V->bool) c (p:(V->num)->A) m.
        ring_divides (poly_ring r s) (poly_const r c) p
        ==> ring_divides r c (p m)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_divides, POLY_CONST] THEN
    REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    DISCH_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"q:(V->num)->A") THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [] THEN DISCH_THEN (ASSUME_TAC o SYM) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER], ALL_TAC] THEN
    EXISTS_TAC (← q r"(q:(V->num)->A) m") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER], ALL_TAC] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [POLY_RING] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [POLY_RING, IN_ELIM_THM]) THEN
    ASM_SIMP_TAC [POLY_MUL_CONST])

  let POLY_CONST_DIVIDES_COEFFS_EQ ← prove
   r"!(r:A ring) (s:V->bool) c (p:(V->num)->A).
        ring_divides (poly_ring r s) (poly_const r c) p <=>
        p IN ring_carrier(poly_ring r s) /\
        (!m. ring_divides r c (p m))"
   (MESON_TAC [POLY_CONST_DIVIDES_COEFFS, POLY_CONST_DIVIDES_COEFFS_REV,
               RING_DIVIDES_IN_CARRIER])

  let POLY_CONST_DIVIDES_CONST ← prove
   r"!(r:A ring) (s:V->bool) c d.
        ring_divides (poly_ring r s) (poly_const r c) (poly_const r d) <=>
        ring_divides r c d"
   (REWRITE_TAC [POLY_CONST_DIVIDES_COEFFS_EQ, POLY_CONST] THEN
    REWRITE_TAC [ring_divides, poly_const, FORALL_AND_THM] THEN
    MESON_TAC [RING_0, RING_MUL_RZERO])

  -- @@RETURN BEGIN
  return { poly_reindex, RING_ISOMORPHISMS_POWSER_REINDEX,
           RING_ISOMORPHISM_POWSER_REINDEX, RING_ISOMORPHISMS_POLY_REINDEX,
           POLY_VARS_REINDEX, RING_ISOMORPHISM_POLY_REINDEX, POLY_REINDEX_CONST,
           POLY_REINDEX_VAR, MONOMIALS_POLY_REINDEX, POLY_EXTEND_REINDEX,
           RING_POWERSERIES_REINDEX, POLY_RING_HOMOMORPHISM_I, POLY_CONST_DIVIDES_COEFFS,
           POLY_CONST_DIVIDES_COEFFS_REV, POLY_CONST_DIVIDES_COEFFS_EQ,
           POLY_CONST_DIVIDES_CONST }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Monomial divisibility as a partial order, and the general monomial order. -/
/- (ringtheory.ml 21311-22002)                                               -/
/- ------------------------------------------------------------------------- -/

structure MonomialOrders where
  -- @@FIELDS
  POSET_MONOMIAL_DIVIDES : thm
  FLD_MONOMIAL_DIVIDES : thm
  COMPATIBLE_MONOMIAL_ORDER : thm
  WQOSET_COMPATIBLE_MONOMIAL_ORDER : thm
  WF_COMPATIBLE_MONOMIAL_ORDER : thm
  WOSET_COMPATIBLE_MONOMIAL_ORDER : thm
  monomial_le : thm
  monomial_lt : thm
  PROPERLY_MONOMIAL_LE : thm
  MONOMIAL_LE_MONO : thm
  MONOMIAL_LT_MONO : thm
  MONOMIAL_LE_PROPERLY : thm
  MONOMIAL_LT_PROPERLY : thm
  MONOMIAL_LE_IMPROPERLY : thm
  MONOMIAL_LT_IMPROPERLY : thm
  MONOMIAL_LE_REFL : thm
  MONOMIAL_LT_REFL : thm
  MONOMIAL_LT_IMP_LE : thm
  MONOMIAL_LE_LT : thm
  MONOMIAL_LE_TRANS : thm
  QOSET_MONOMIAL_LE : thm
  FLD_MONOMIAL_LE : thm
  MONOMIAL_LE_LMUL : thm
  MONOMIAL_LE_RMUL : thm
  MONOMIAL_LT_LMUL : thm
  MONOMIAL_LT_RMUL : thm
  MONOMIAL_LE_MUL2 : thm
  MONOMIAL_LE_DIVISOR : thm
  MONOMIAL_GE_1 : thm
  MONOMIAL_LE_VARS : thm
  MONOMIAL_LT_VARS : thm
  MONOMIAL_LE_POSET : thm
  MONOMIAL_LE_ANTISYM : thm
  MONOMIAL_LET_ANTISYM : thm
  MONOMIAL_LTE_ANTISYM : thm
  MONOMIAL_LT_ANTISYM : thm
  MONOMIAL_LET_TRANS : thm
  MONOMIAL_LTE_TRANS : thm
  MONOMIAL_LT_TRANS : thm
  MONOMIAL_LET_MUL2 : thm
  MONOMIAL_LTE_MUL2 : thm
  MONOMIAL_LT_MUL2 : thm
  POSET_MONOMIAL_LE : thm
  MONOMIAL_LE_VARS_EQ : thm
  MONOMIAL_LT_VARS_EQ : thm
  MONOMIAL_LT_TOSET : thm
  MONOMIAL_LE_TOSET : thm
  TOSET_MONOMIAL_LE : thm
  WF_MONOMIAL_LT : thm
  WOSET_MONOMIAL_LE : thm
  deriving Inhabited

@[nospecialize]
def setupMonomialOrders [HolBase] (D : RingTheoryDeps) (BMonomials : Monomials) :
    ExceptT String IO MonomialOrders := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_METIS_TAC, MESON,
        MESON_TAC, SET_RULE, SET_TAC, new_definition, prove_inductive_relations_exist, .. } := D
  let { ADD_CLAUSES, .. } := D.core1
  let { CONJ_ACI, CONJ_ASSOC, CONJ_SYM, CONTRAPOS_THM, DE_MORGAN_THM, EQ_IMP,
        EQ_SYM_EQ, ETA_AX, EXISTS_IN_GSPEC, EXTENSION, .. } := D.core2
  let { FINITE_RESTRICT, FINITE_SING, FINITE_SUBSET, FINITE_UNION, FLD_RESTRICT_QOSET,
        FORALL_IN_GSPEC, FORALL_UNWIND_THM2, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, IN_GSPEC, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_1, LT,
        LT_ANTISYM, .. } := D.core5
  let { LT_REFL, LT_TRANS, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_OR, NOT_EXISTS_THM,
        NOT_IMP, NOT_IN_EMPTY, NOT_LT, OR_EXISTS_THM, POSET_IMP_QOSET, POSET_MAX,
        PROPERLY_PROPERLY, QOSET_FLD, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_UNIV,
        SWAP_FORALL_THM, TOSET_IMP_POSET, TOSET_IMP_QOSET, TOSET_MAX, UNIV_GSPEC,
        UNWIND_THM2, WF, WF_ANTISYM, .. } := D.core7
  let { WF_IND, WF_SUBSET, WOSET_IMP_TOSET, WOSET_WF, WOSET_WQOSET, WQOSET_IMP_WF,
        WQOSET_POINTWISE, WQOSET_RESTRICT, WQOSET_SUPERSET, WQOSET_num, fld, poset,
        properly, qoset, strictly, toset, .. } := D.core8
  let { MONOMIAL, MONOMIAL_1, MONOMIAL_DIV, MONOMIAL_DIVIDES_1,
        MONOMIAL_DIVIDES_ANTISYM, MONOMIAL_DIVIDES_REFL, MONOMIAL_DIVIDES_TRANS,
        MONOMIAL_DIVISOR, MONOMIAL_DIV_LMUL, MONOMIAL_DIV_LMUL_EQ,
        MONOMIAL_DIV_RMUL_EQ, MONOMIAL_INDUCT, MONOMIAL_MUL, MONOMIAL_MUL_ASSOC,
        MONOMIAL_MUL_LCANCEL, MONOMIAL_MUL_LID, MONOMIAL_MUL_RCANCEL, MONOMIAL_MUL_RID,
        MONOMIAL_MUL_SYM, MONOMIAL_RULE, MONOMIAL_VAR, MONOMIAL_VARS_1,
        MONOMIAL_VARS_MUL, MONOMIAL_VARS_VAR, MONOMIAL_VAR_EQ, monomial, monomial_1,
        monomial_div, monomial_divides, monomial_mul, monomial_var, monomial_vars, .. } := BMonomials
  -- @@SCOPE END

  let POSET_MONOMIAL_DIVIDES ← prove
   r"poset(monomial_divides:(V->num)->(V->num)->bool)"
   (REWRITE_TAC [poset, MONOMIAL_DIVIDES_REFL] THEN
    REWRITE_TAC [MONOMIAL_DIVIDES_TRANS, MONOMIAL_DIVIDES_ANTISYM])

  let FLD_MONOMIAL_DIVIDES ← prove
   r"fld(monomial_divides) = (:V->num)"
   (SIMP_TAC [QOSET_FLD, POSET_IMP_QOSET, POSET_MONOMIAL_DIVIDES] THEN
    REWRITE_TAC [MONOMIAL_DIVIDES_REFL, UNIV_GSPEC])

  let COMPATIBLE_MONOMIAL_ORDER ← prove
   r"!(<<=) (s:V->bool).
     (!m. monomial s m ==> monomial_1 <<= m) /\
     (!m n p. monomial s m /\ monomial s n /\ monomial s p /\ n <<= p
              ==> monomial_mul m n <<= monomial_mul m p)
     ==> !m n. monomial s m /\ monomial s n /\ monomial_divides m n
               ==> m <<= n"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"m:V->num", ← q r"monomial_1:V->num", ← q r"monomial_div n m:V->num"]) THEN
    ASM_SIMP_TAC [MONOMIAL_DIV, MONOMIAL_DIV_LMUL] THEN
    REWRITE_TAC [MONOMIAL_1, MONOMIAL_MUL_RID])

  let WQOSET_COMPATIBLE_MONOMIAL_ORDER ← prove
   r"!(<<=) (s:V->bool).
       FINITE s /\ qoset(<<=) /\ fld(<<=) SUBSET {m | monomial s m} /\
       (!m n. monomial s m /\ monomial s n /\ monomial_divides m n ==> m <<= n)
       ==> wqoset(<<=)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC WQOSET_SUPERSET THEN
    EXISTS_TAC (← q r"\m (n:V->num). monomial s m /\ monomial s n /\
                               monomial_divides m n") THEN
    ASM_SIMP_TAC [FLD_RESTRICT_QOSET, POSET_IMP_QOSET, POSET_MONOMIAL_DIVIDES,
                  FLD_MONOMIAL_DIVIDES, IN_UNIV, IN_GSPEC] THEN
    MP_TAC (← ISPECL [← q "(<=):num->num->bool", ← q r"s:V->bool"]
          WQOSET_POINTWISE) THEN
    ASM_REWRITE_TAC [WQOSET_num] THEN DISCH_THEN (MP_TAC o SPEC
      (← q r"monomial (s:V->bool)") o MATCH_MP WQOSET_RESTRICT) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, monomial, monomial_vars, monomial_divides] THEN
    MP_TAC (← ARITH_RULE (← q "0 <= 0")) THEN SET_TAC [])

  let WF_COMPATIBLE_MONOMIAL_ORDER ← prove
   r"!(<<=) (s:V->bool).
       FINITE s /\ qoset(<<=) /\ fld(<<=) SUBSET {m | monomial s m} /\
       (!m n. monomial s m /\ monomial s n /\ monomial_divides m n ==> m <<= n)
       ==> WF(strictly(<<=))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP WQOSET_COMPATIBLE_MONOMIAL_ORDER) THEN
    REWRITE_TAC [WQOSET_IMP_WF])

  let WOSET_COMPATIBLE_MONOMIAL_ORDER ← prove
   r"!(<<=) (s:V->bool).
       FINITE s /\ toset(<<=) /\ fld(<<=) SUBSET {m | monomial s m} /\
       (!m n. monomial s m /\ monomial s n /\ monomial_divides m n ==> m <<= n)
       ==> woset(<<=)"
   (SIMP_TAC [WOSET_WQOSET] THEN
    MESON_TAC [WQOSET_COMPATIBLE_MONOMIAL_ORDER, TOSET_IMP_QOSET])

  let monomial_le ← new_definition
   r"monomial_le (<<=) (m1:V->num) m2 <=>
        monomial (:V) m1 /\ monomial (:V) m2 /\
        ?ma mb. monomial (:V) ma /\ monomial (:V) mb /\
                monomial_mul m1 ma = monomial_mul m2 mb /\
                !i. i IN monomial_vars mb
                    ==> ?j. j IN monomial_vars ma /\ properly(<<=) i j"

  let monomial_lt ← new_definition
   r"monomial_lt (<<=) (m1:V->num) m2 <=>
        ~(m1 = m2) /\ monomial_le (<<=) (m1:V->num) m2"

  let PROPERLY_MONOMIAL_LE ← prove
   r"!(<<=):V->V->bool. properly(monomial_le(<<=)) = monomial_lt(<<=)"
   (REWRITE_TAC [FUN_EQ_THM, properly, monomial_lt] THEN MESON_TAC [])

  let MONOMIAL_LE_MONO ← prove
   r"!l l'. (!x y. l x y ==> l' x y)
         ==> (!m n. monomial_le l m n ==> monomial_le l' m n)"
   (REWRITE_TAC [monomial_le, properly] THEN MESON_TAC [])

  let MONOMIAL_LT_MONO ← prove
   r"!l l'. (!x y. l x y ==> l' x y)
         ==> (!m n. monomial_lt l m n ==> monomial_lt l' m n)"
   (REWRITE_TAC [monomial_lt, monomial_le, properly] THEN MESON_TAC [])

  let MONOMIAL_LE_PROPERLY ← prove
   r"!(<<=):V->V->bool. monomial_le (properly(<<=)) = monomial_le (<<=)"
   (REWRITE_TAC [FUN_EQ_THM, monomial_le, PROPERLY_PROPERLY])

  let MONOMIAL_LT_PROPERLY ← prove
   r"!(<<=):V->V->bool. monomial_lt (properly(<<=)) = monomial_lt (<<=)"
   (REWRITE_TAC [FUN_EQ_THM, monomial_lt, monomial_le, PROPERLY_PROPERLY])

  let MONOMIAL_LE_IMPROPERLY ← prove
   r"!(<<):V->V->bool.
        monomial_le (\x y. x << y \/ x = y) = monomial_le (<<)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM MONOMIAL_LE_PROPERLY] THEN
    AP_TERM_TAC THEN REWRITE_TAC [properly, FUN_EQ_THM] THEN MESON_TAC [])

  let MONOMIAL_LT_IMPROPERLY ← prove
   r"!(<<):V->V->bool. monomial_lt (\x y. x << y \/ x = y) = monomial_lt (<<)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM MONOMIAL_LT_PROPERLY] THEN
    AP_TERM_TAC THEN REWRITE_TAC [properly, FUN_EQ_THM] THEN MESON_TAC [])

  let MONOMIAL_LE_REFL ← prove
   r"!(<<=) m. monomial_le (<<=) m m <=> monomial (:V) m"
   (REPEAT GEN_TAC THEN REWRITE_TAC [monomial_le] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (EXISTS_TAC (← q r"monomial_1:V->num")) THEN
    REWRITE_TAC [MONOMIAL_VARS_1, MONOMIAL_MUL_LID, MONOMIAL_MUL_RID] THEN
    REWRITE_TAC [MONOMIAL_1, NOT_IN_EMPTY])

  let MONOMIAL_LT_REFL ← prove
   r"!(<<) m:V->num. ~(monomial_lt (<<) m m)"
   (REWRITE_TAC [monomial_lt])

  let MONOMIAL_LT_IMP_LE ← prove
   r"!(<<) m1 m2:V->num. monomial_lt (<<) m1 m2 ==> monomial_le (<<) m1 m2"
   (SIMP_TAC [monomial_lt])

  let MONOMIAL_LE_LT ← prove
   r"!(<<) m1 m2:V->num.
        monomial_le (<<) m1 m2 <=>
        monomial_lt (<<) m1 m2 \/
        monomial (:V) m1 /\ monomial (:V) m2 /\ m1 = m2"
   (REWRITE_TAC [monomial_lt] THEN MESON_TAC [MONOMIAL_LE_REFL])

  let MONOMIAL_LE_TRANS ← prove
   r"!(<<=) m1 m2 m3:V->num.
        monomial_le (<<=) m1 m2 /\ monomial_le (<<=) m2 m3
        ==> monomial_le (<<=) m1 m3"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    REWRITE_TAC [monomial_le, LEFT_IMP_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"ma:V->num", ← q r"mb:V->num"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"mc:V->num", ← q r"md:V->num"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"monomial_mul ma mc:V->num") THEN
    EXISTS_TAC (← q r"monomial_mul mb md:V->num") THEN
    ASM_REWRITE_TAC [MONOMIAL_MUL, MONOMIAL_VARS_MUL] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SYM)) THEN
    CONV_TAC (fun t => (MONOMIAL_RULE t).run))

  let QOSET_MONOMIAL_LE ← prove
   r"!(<<=):V->V->bool. qoset(monomial_le (<<=))"
   (REWRITE_TAC [qoset, MONOMIAL_LE_TRANS, MONOMIAL_LE_REFL] THEN
    REWRITE_TAC [fld, monomial_le, IN_ELIM_THM] THEN MESON_TAC [])

  let FLD_MONOMIAL_LE ← prove
   r"!(<<=). fld(monomial_le(<<=)) = {m | monomial (:V) m}"
   (GEN_TAC THEN REWRITE_TAC [← GSYM MONOMIAL_LE_REFL] THEN
    MATCH_MP_TAC QOSET_FLD THEN REWRITE_TAC [QOSET_MONOMIAL_LE])

  let MONOMIAL_LE_LMUL ← prove
   r"!(<<=) m m1 m2:V->num.
        monomial_le (<<=) (monomial_mul m m1) (monomial_mul m m2) <=>
        monomial (:V) m /\ monomial_le (<<=) m1 m2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [monomial_le] THEN
    REWRITE_TAC [MONOMIAL_VARS_MUL, MONOMIAL_MUL] THEN
    REWRITE_TAC [← GSYM MONOMIAL_MUL_ASSOC, MONOMIAL_MUL_LCANCEL] THEN
    REWRITE_TAC [CONJ_ACI])

  let MONOMIAL_LE_RMUL ← prove
   r"!(<<=) m m1 m2:V->num.
        monomial_le (<<=) (monomial_mul m1 m) (monomial_mul m2 m) <=>
        monomial (:V) m /\ monomial_le (<<=) m1 m2"
   (ONCE_REWRITE_TAC [MONOMIAL_MUL_SYM] THEN
    REWRITE_TAC [MONOMIAL_LE_LMUL])

  let MONOMIAL_LT_LMUL ← prove
   r"!(<<=) m m1 m2:V->num.
        monomial_lt (<<=) (monomial_mul m m1) (monomial_mul m m2) <=>
        monomial (:V) m /\ monomial_lt (<<=) m1 m2"
   (REWRITE_TAC [monomial_lt, MONOMIAL_MUL_LCANCEL, MONOMIAL_LE_LMUL] THEN
    MESON_TAC [])

  let MONOMIAL_LT_RMUL ← prove
   r"!(<<=) m m1 m2:V->num.
        monomial_lt (<<=) (monomial_mul m1 m) (monomial_mul m2 m) <=>
        monomial (:V) m /\ monomial_lt (<<=) m1 m2"
   (REWRITE_TAC [monomial_lt, MONOMIAL_MUL_RCANCEL, MONOMIAL_LE_RMUL] THEN
    MESON_TAC [])

  let MONOMIAL_LE_MUL2 ← prove
   r"!(<<=) m1 m1' m2 m2':V->num.
         monomial_le (<<=) m1 m1' /\
         monomial_le (<<=) m2 m2'
        ==> monomial_le (<<=) (monomial_mul m1 m2) (monomial_mul m1' m2')"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MONOMIAL_LE_TRANS THEN
    EXISTS_TAC (← q r"monomial_mul m1' m2:V->num") THEN
    ASM_REWRITE_TAC [MONOMIAL_LE_LMUL, MONOMIAL_LE_RMUL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [monomial_le]) THEN ASM_REWRITE_TAC [])

  let MONOMIAL_LE_DIVISOR ← prove
   r"!m d:V->num. monomial (:V) m /\ monomial_divides d m
                ==> monomial_le (<<=) d m"
   (REPEAT GEN_TAC THEN REWRITE_TAC [monomial_le] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [MONOMIAL_DIVISOR], ALL_TAC] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"monomial_div m d:V->num", ← q r"monomial_1:V->num"] THEN
    ASM_REWRITE_TAC [MONOMIAL_DIV_LMUL_EQ, MONOMIAL_MUL_RID] THEN
    ASM_SIMP_TAC [MONOMIAL_DIV, MONOMIAL_1, MONOMIAL_VARS_1, NOT_IN_EMPTY])

  let MONOMIAL_GE_1 ← prove
   r"!(<<=) (m:V->num).
        monomial_le (<<=) monomial_1 m <=> monomial (:V) m"
   (REPEAT GEN_TAC THEN EQ_TAC THENL [SIMP_TAC [monomial_le], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] MONOMIAL_LE_DIVISOR) THEN
    REWRITE_TAC [MONOMIAL_DIVIDES_1])

  let MONOMIAL_LE_VARS ← prove
   r"!(<<=) v w:V.
    v <<= w ==> monomial_le (<<=) (monomial_var v) (monomial_var w)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q "v:V = w") THEN ASM_REWRITE_TAC [MONOMIAL_LE_REFL] THEN
    REWRITE_TAC [monomial_le, MONOMIAL_VAR, IN_UNIV] THEN
    REWRITE_TAC [FINITE_SING] THEN MAP_EVERY EXISTS_TAC
     [← q "monomial_var(w:V)", ← q "monomial_var(v:V)"] THEN
    REWRITE_TAC [MONOMIAL_VARS_VAR, MONOMIAL_VAR, IN_UNIV] THEN
    REWRITE_TAC [MONOMIAL_MUL_SYM, properly] THEN ASM SET_TAC [])

  let MONOMIAL_LT_VARS ← prove
   r"!(<<=) v w:V.
    properly(<<=) v w ==> monomial_lt (<<=) (monomial_var v) (monomial_var w)"
   (SIMP_TAC [monomial_lt, MONOMIAL_VAR_EQ, properly, MONOMIAL_LE_VARS])

  let MONOMIAL_LE_POSET ← prove
   r"!(<<=):V->V->bool.
        poset(<<=)
        ==> monomial_le (<<=) =
            \m1 m2. monomial (:V) m1 /\ monomial (:V) m2 /\
                    !i. m2 i < m1 i ==> ?j. i <<= j /\ m1 j < m2 j"
   (← do
    -- right to left: the two ARITH_RULEs in the last ASM_MESON_TAC list
    -- (second first), the MESON, the ARITH_RULE in MESON_TAC, the first one
    let a5 ← ARITH_RULE (← q r"a <= b /\ ~(a = 0) ==> ~(b = 0)")
    let a4 ← ARITH_RULE (← q r"a < b ==> ~(b = 0)")
    let m3 ← MESON [] (← q r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")
    let a2 ← ARITH_RULE
       (← q r"a + b:num = c + d ==> (b < d <=> c < a) /\ (a < c <=> d < b)")
    let a1 ← ARITH_RULE (← q r"~(a - b = 0) <=> b < a")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"m1:V->num", ← q r"m2:V->num"] THEN
    REWRITE_TAC [monomial_le, properly, MONOMIAL] THEN
    ASM_CASES_TAC (← q r"FINITE(monomial_vars m1:V->bool)") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"FINITE(monomial_vars m2:V->bool)") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THENL
     [ALL_TAC,
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"\i. (m2:V->num) i - m1 i") THEN
      EXISTS_TAC (← q r"\i. (m1:V->num) i - m2 i") THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"monomial_vars(m2:V->num)"),
        MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"monomial_vars(m1:V->num)"),
        REWRITE_TAC [monomial_mul] THEN ABS_TAC THEN ARITH_TAC,
        X_GEN_TAC (← q "i:V") THEN REWRITE_TAC [monomial_vars, IN_ELIM_THM] THEN
        REWRITE_TAC [a1] THEN
        ASM_MESON_TAC [LT_ANTISYM]] THEN
      ASM_REWRITE_TAC [SUBSET, monomial_vars, IN_ELIM_THM] THEN ARITH_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
    MAP_EVERY X_GEN_TAC [← q r"ma:V->num", ← q r"mb:V->num"] THEN
    REPLICATE_TAC 3 DISCH_TAC THEN
    REWRITE_TAC [monomial_vars, IN_ELIM_THM] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!i. (ma:V->num) i < mb i ==> (?j. i <<= j /\ mb j < ma j)")
    MP_TAC THENL
     [ALL_TAC,
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FUN_EQ_THM]) THEN
      REWRITE_TAC [monomial_mul] THEN MESON_TAC [a2]] THEN
    X_GEN_TAC (← q "i:V") THEN DISCH_TAC THEN ONCE_REWRITE_TAC [m3] THEN
    REWRITE_TAC [NOT_LT] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"\x y:V. x = y \/ x <<= y",
                   ← q r"{j:V | j IN monomial_vars mb /\ (i:V) <<= j}"]
          POSET_MAX) THEN
    ASM_SIMP_TAC [NOT_IMP, FINITE_RESTRICT] THEN REWRITE_TAC [monomial_vars] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, FORALL_IN_GSPEC, strictly] THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM MEMBER_NOT_EMPTY] THEN
    REPEAT CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [poset]) THEN
      REWRITE_TAC [poset, fld] THEN SET_TAC [],
      ASM_MESON_TAC [a4, a5],
      REWRITE_TAC [fld] THEN SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q "j:V") STRIP_ASSUME_TAC) THEN
      UNDISCH_THEN
       (← q r"!i:V. ~(mb i = 0) ==> (?j. ~(ma j = 0) /\ i <<= j /\ ~(i = j))")
       (MP_TAC o SPEC (← q "j:V")) THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q "k:V") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"((i:V) <<= (k:V)):bool") ASSUME_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [poset]) THEN ASM_MESON_TAC [], ALL_TAC] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q "k:V"))) THEN ASM_REWRITE_TAC [] THEN
      DISCH_TAC THEN REWRITE_TAC [NOT_IMP] THEN
      CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      REWRITE_TAC [properly] THEN RULE_ASSUM_TAC (REWRITE_RULE [poset]) THEN
      ASM_MESON_TAC []]))

  let MONOMIAL_LE_ANTISYM ← prove
   r"!(<<=) m1 m2:V->num.
        poset(<<=) /\
        monomial_le (<<=) m1 m2 /\
        monomial_le (<<=) m2 m1
        ==> m1 = m2"
   (← do
    -- right to left: the SET_RULE, then the ARITH_RULE
    let sr ← SET_RULE
     (← q r"~(~({i | P i} = {})) /\ ~(~({i | Q i} = {}))
      ==> !i. ~(P i) /\ ~(Q i)")
    let ar ← ARITH_RULE (← q r"m:num = n <=> ~(m < n) /\ ~(n < m)")
    pure (REPEAT GEN_TAC THEN GEN_REWRITE_TAC id [IMP_CONJ] THEN
    SIMP_TAC [MONOMIAL_LE_POSET] THEN REWRITE_TAC [poset] THEN
    REPEAT STRIP_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    REWRITE_TAC [ar] THEN
    MATCH_MP_TAC sr THEN
    CONJ_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"\x y:V. x = y \/ x <<= y") POSET_MAX) THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"{i | (m1:V->num) i < m2 i}")),
      DISCH_THEN (MP_TAC o SPEC (← q r"{i | (m2:V->num) i < m1 i}"))] THEN
    (ASM_REWRITE_TAC [NOT_IMP, SUBSET, IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [poset] THEN ASM_MESON_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [MONOMIAL]) THEN MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"monomial_vars(monomial_mul m1 m2:V->num)") THEN
      ASM_REWRITE_TAC [MONOMIAL_VARS_MUL, FINITE_UNION] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, monomial_vars, IN_UNION] THEN ARITH_TAC,
      REWRITE_TAC [fld, IN_ELIM_THM] THEN ASM_MESON_TAC [],
      REWRITE_TAC [properly] THEN ASM_METIS_TAC [LT_ANTISYM]])))

  let MONOMIAL_LET_ANTISYM ← prove
   r"!(<<=) m1 m2.
        poset(<<=)
        ==> ~(monomial_le (<<=) m1 m2 /\ monomial_lt (<<=) m2 m1)"
   (REWRITE_TAC [monomial_lt, ← TAUT (← q r"~(p /\ ~q /\ r) <=> r /\ p ==> q")] THEN
    REWRITE_TAC [IMP_IMP, MONOMIAL_LE_ANTISYM])

  let MONOMIAL_LTE_ANTISYM ← prove
   r"!(<<=) m1 m2.
        poset(<<=)
        ==> ~(monomial_lt (<<=) m1 m2 /\ monomial_le (<<=) m2 m1)"
   (REWRITE_TAC [monomial_lt, ← TAUT (← q r"~((~p /\ q) /\ r) <=> q /\ r ==> p")] THEN
    REWRITE_TAC [IMP_IMP, MONOMIAL_LE_ANTISYM])

  let MONOMIAL_LT_ANTISYM ← prove
   r"!(<<=) m1 m2.
        poset(<<=)
        ==> ~(monomial_lt (<<=) m1 m2 /\ monomial_lt (<<=) m2 m1)"
   (MESON_TAC [MONOMIAL_LT_IMP_LE, MONOMIAL_LTE_ANTISYM])

  let MONOMIAL_LET_TRANS ← prove
   r"!(<<=) m1 m2 m3:V->num.
        poset(<<=) /\
        monomial_le (<<=) m1 m2 /\
        monomial_lt (<<=) m2 m3
        ==> monomial_lt (<<=) m1 m3"
   (REWRITE_TAC [monomial_lt] THEN
    MESON_TAC [MONOMIAL_LE_TRANS, MONOMIAL_LE_ANTISYM])

  let MONOMIAL_LTE_TRANS ← prove
   r"!(<<=) m1 m2 m3.
        poset(<<=) /\
        monomial_lt (<<=) m1 m2 /\
        monomial_le (<<=) m2 m3
        ==> monomial_lt (<<=) m1 m3"
   (REWRITE_TAC [monomial_lt] THEN
    MESON_TAC [MONOMIAL_LE_TRANS, MONOMIAL_LE_ANTISYM])

  let MONOMIAL_LT_TRANS ← prove
   r"!(<<=) m1 m2 m3.
        poset(<<=) /\
        monomial_lt (<<=) m1 m2 /\
        monomial_lt (<<=) m2 m3
        ==> monomial_lt (<<=) m1 m3"
   (MESON_TAC [MONOMIAL_LT_IMP_LE, MONOMIAL_LTE_TRANS])

  let MONOMIAL_LET_MUL2 ← prove
   r"!(<<=) m1 m1' m2 m2':V->num.
        poset(<<=) /\
        monomial_le (<<=) m1 m1' /\ monomial_lt (<<=) m2 m2'
        ==> monomial_lt (<<=) (monomial_mul m1 m2) (monomial_mul m1' m2')"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MONOMIAL_LET_TRANS THEN
    EXISTS_TAC (← q r"monomial_mul m1' m2:V->num") THEN
    ASM_REWRITE_TAC [MONOMIAL_LT_LMUL, MONOMIAL_LE_RMUL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [monomial_lt, monomial_le]) THEN
    ASM_REWRITE_TAC [])

  let MONOMIAL_LTE_MUL2 ← prove
   r"!(<<=) m1 m1' m2 m2':V->num.
        poset(<<=) /\
        monomial_lt (<<=) m1 m1' /\ monomial_le (<<=) m2 m2'
        ==> monomial_lt (<<=) (monomial_mul m1 m2) (monomial_mul m1' m2')"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [MONOMIAL_MUL_SYM] THEN
    MATCH_MP_TAC MONOMIAL_LET_MUL2 THEN ASM_MESON_TAC [])

  let MONOMIAL_LT_MUL2 ← prove
   r"!(<<=) m1 m1' m2 m2':V->num.
        poset(<<=) /\
        monomial_lt (<<=) m1 m1' /\ monomial_lt (<<=) m2 m2'
        ==> monomial_lt (<<=) (monomial_mul m1 m2) (monomial_mul m1' m2')"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MONOMIAL_LET_MUL2 THEN
    ASM_SIMP_TAC [MONOMIAL_LT_IMP_LE])

  let POSET_MONOMIAL_LE ← prove
   r"!(<<=):V->V->bool. poset(<<=) ==> poset(monomial_le(<<=))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [poset, FLD_MONOMIAL_LE, MONOMIAL_LE_REFL] THEN
    REWRITE_TAC [IN_ELIM_THM, MONOMIAL_LE_TRANS] THEN
    ASM_MESON_TAC [MONOMIAL_LE_ANTISYM])

  let MONOMIAL_LE_VARS_EQ ← prove
   r"!(<<=) v w.
        poset(<<=) /\ fld(<<=) = (:V)
        ==> (monomial_le (<<=) (monomial_var v) (monomial_var w) <=>
             v <<= w)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [MONOMIAL_LE_VARS] THEN
    ASM_SIMP_TAC [MONOMIAL_LE_POSET, MONOMIAL_VARS_VAR] THEN
    REWRITE_TAC [FINITE_SING, monomial_var] THEN
    SIMP_TAC [← MESON [← ARITH_RULE (← q r"0 < 1 /\ ~(1 < 0)"), LT_REFL]
     (← q r"(if p then 1 else 0) < (if q then 1 else 0) <=> ~p /\ q")] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    REWRITE_TAC [UNWIND_THM2, IMP_CONJ, FORALL_UNWIND_THM2] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [poset]) THEN ASM SET_TAC [])

  let MONOMIAL_LT_VARS_EQ ← prove
   r"!(<<=) v w:V.
        poset(<<=)
        ==> (monomial_lt (<<=) (monomial_var v) (monomial_var w) <=>
             v <<= w /\ ~(v = w))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [monomial_lt] THEN
    ASM_CASES_TAC (← q "v:V = w") THEN ASM_REWRITE_TAC [MONOMIAL_VAR_EQ] THEN
    ASM_SIMP_TAC [MONOMIAL_LE_POSET, MONOMIAL_VARS_VAR,
                  MONOMIAL_VAR, IN_UNIV] THEN
    SIMP_TAC [monomial_var, ← MESON [← ARITH_RULE (← q r"0 < 1 /\ ~(1 < 0)"), LT_REFL]
     (← q r"(if p then 1 else 0) < (if q then 1 else 0) <=> ~p /\ q")] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    REWRITE_TAC [UNWIND_THM2, IMP_CONJ, FORALL_UNWIND_THM2] THEN
    ASM_REWRITE_TAC [])

  let MONOMIAL_LT_TOSET ← prove
   r"!(<<=) m1 m2.
        toset (<<=) /\ fld (<<=) = (:V)
        ==> (monomial_lt (<<=) m1 m2 <=>
             monomial (:V) m1 /\ monomial (:V) m2 /\
             ?i. m1 i < m2 i /\ !j. properly (<<=) i j ==> m1 j = m2 j)"
   (← do
    -- right to left: the ARITH_RULE, then the TAUT
    let ar ← ARITH_RULE (← q r"~(a:num = b) /\ ~(a < b) ==> b < a")
    let tt ← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [monomial_lt] THEN
    ASM_CASES_TAC (← q r"m1:V->num = m2") THEN ASM_REWRITE_TAC [LT_REFL] THEN
    ASM_SIMP_TAC [MONOMIAL_LE_POSET, TOSET_IMP_POSET, properly, CONJ_ASSOC] THEN
    REWRITE_TAC [MONOMIAL, ← GSYM FINITE_UNION] THEN
    MATCH_MP_TAC tt THEN
    DISCH_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"(<<=):V->V->bool", ← q r"{i | ~((m1:V->num) i = m2 i)}"]
          TOSET_MAX) THEN
      ASM_REWRITE_TAC [SUBSET_UNIV, IN_ELIM_THM] THEN ANTS_TAC THENL
       [CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION, monomial_vars] THEN
          ARITH_TAC,
          REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
          REWRITE_TAC [← GSYM FUN_EQ_THM] THEN ASM_REWRITE_TAC [ETA_AX]],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "i:V") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [toset]) THEN
        ASM_REWRITE_TAC [IN_UNIV] THEN
        REPEAT STRIP_TAC THENL [ALL_TAC, ASM_MESON_TAC [LT_ANTISYM]] THEN
        MATCH_MP_TAC ar THEN
        ASM_METIS_TAC [LT_ANTISYM, LT_TRANS]],
      DISCH_THEN (X_CHOOSE_THEN (← q "j:V") STRIP_ASSUME_TAC) THEN
      X_GEN_TAC (← q "i:V") THEN DISCH_TAC THEN EXISTS_TAC (← q "j:V") THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [toset]) THEN
      ASM_REWRITE_TAC [IN_UNIV] THEN ASM_METIS_TAC [LT_ANTISYM, LT_TRANS]]))

  let MONOMIAL_LE_TOSET ← prove
   r"!(<<=) m1 m2.
        toset (<<=) /\ fld (<<=) = (:V)
        ==> (monomial_le (<<=) m1 m2 <=>
             monomial (:V) m1 /\ monomial (:V) m2 /\
             (m1 = m2 \/
              ?i. m1 i < m2 i /\ !j. properly (<<=) i j ==> m1 j = m2 j))"
   (SIMP_TAC [MONOMIAL_LE_LT, MONOMIAL_LT_TOSET] THEN MESON_TAC [])

  let TOSET_MONOMIAL_LE ← prove
   r"!(<<=). toset (<<=) /\ fld (<<=) = (:V) ==> toset(monomial_le (<<=))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [toset, FLD_MONOMIAL_LE] THEN
    ASM_SIMP_TAC [MONOMIAL_LE_TOSET] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN REPEAT CONJ_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:V->num", ← q r"y:V->num"] THEN
    TRY (X_GEN_TAC (← q r"z:V->num")) THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    REPEAT (FIRST_X_ASSUM (DISJ_CASES_THEN2 SUBST_ALL_TAC MP_TAC)
           THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
    ASM_REWRITE_TAC [properly] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [toset]) THEN
    ASM_REWRITE_TAC [IN_UNIV] THEN STRIP_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q "i:V") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "j:V") STRIP_ASSUME_TAC) THEN DISJ2_TAC THEN
      SUBGOAL_THEN (← q r"(i:V) <<= (j:V) \/ j <<= i")
      MP_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      STRIP_TAC THENL [EXISTS_TAC (← q "j:V"), EXISTS_TAC (← q "i:V")] THEN
      ASM_MESON_TAC [LT_ANTISYM, LT_TRANS],
      DISCH_THEN (X_CHOOSE_THEN (← q "i:V") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "j:V") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(i:V) <<= (j:V) \/ j <<= i")
      MP_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      ASM_MESON_TAC [LT_ANTISYM, LT_TRANS],
      ASM_CASES_TAC (← q r"x:V->num = y") THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"(<<=):V->V->bool", ← q r"{i | ~((x:V->num) i = y i)}"]
          TOSET_MAX) THEN
      ASM_REWRITE_TAC [SUBSET_UNIV, IN_ELIM_THM] THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [toset, IN_UNIV] THEN CONJ_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [MONOMIAL]) THEN
          MATCH_MP_TAC FINITE_SUBSET THEN
          EXISTS_TAC (← q r"monomial_vars(x:V->num) UNION monomial_vars y") THEN
          ASM_REWRITE_TAC [FINITE_UNION] THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION, monomial_vars] THEN
          ARITH_TAC,
          REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
          REWRITE_TAC [← GSYM FUN_EQ_THM] THEN ASM_REWRITE_TAC [ETA_AX]],
        REWRITE_TAC [OR_EXISTS_THM] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "i:V") THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
         (← q r"~(m:num = n) ==> m < n \/ n < m"))) THEN
        MATCH_MP_TAC MONO_OR THEN ASM_MESON_TAC []]])

  let WF_MONOMIAL_LT ← prove
   r"!(<<):V->V->bool. WF(<<) ==> WF(monomial_lt(<<))"
   (← do
    -- right to left: the MESON, the second TAUT, the SET_RULE, the second
    -- prove_inductive_relations_exist, the first TAUT, the first one
    let mm ← MESON []
     (← q r"(!x y. Q x y ==> R x y) ==> (!x y. P x y /\ Q x y ==> R x y)")
    let t2 ← TAUT (← q r"a ==> b <=> a ==> a /\ b")
    let sr ← SET_RULE (← q r"!m:V->num. w m <=> m IN w")
    let pir2 ← ExceptT.mk (prove_inductive_relations_exist
     (← q r"!m. monomial (:V) m /\ (!m'. monomial_lt (<<) m' m ==> w m') ==> w m"))
    let t1 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    let pir1 ← ExceptT.mk (prove_inductive_relations_exist
     (← q r"(!x y. x << y ==> x <<< y) /\
      (!(x:V) y z. x <<< y /\ y <<< z ==> x <<< z)"))
    pure (SUBGOAL_THEN
     (← q r"!(<<):V->V->bool.
          WF(<<) /\
          (\m1 m2. monomial (:V) m1 /\ monomial (:V) m2 /\
                   !i. m2 i < m1 i ==> ?j. i << j /\ m1 j < m2 j) =
          monomial_le (<<)
          ==> WF(monomial_lt(<<))")
    ASSUME_TAC THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"(<<):V->V->bool") THEN STRIP_TAC THEN
      X_CHOOSE_THEN (← q r"(<<<):V->V->bool") MP_TAC pir1 THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (ASSUME_TAC o CONJUNCT1)) THEN
      MATCH_MP_TAC WF_SUBSET THEN
      EXISTS_TAC (← q r"monomial_lt((<<<):V->V->bool)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC MONOMIAL_LT_MONO THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC t1 THEN CONJ_TAC THENL
       [REWRITE_TAC [WF] THEN X_GEN_TAC (← q r"P:V->bool") THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\y:V. ?z:V. P z /\ z <<< y") o
          GEN_REWRITE_RULE id [WF]) THEN
        SUBGOAL_THEN (← q r"!x:V z:V. x <<< z ==> x << z \/ ?y:V. x <<< y /\ y << z")
        MP_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [], MESON_TAC []],
        FIRST_X_ASSUM ((fun (_ : thm) => ALL_TAC) o GEN_REWRITE_RULE id [WF]) THEN
        DISCH_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM MONOMIAL_LE_IMPROPERLY] THEN
      wPart rand (fun t => do lhand (← rand t)) MONOMIAL_LE_POSET THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP WF_ANTISYM) THEN
        REWRITE_TAC [poset] THEN ASM_MESON_TAC [],
        DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
        MESON_TAC [LT_ANTISYM]]] THEN
    X_GEN_TAC (← q r"(<<):V->V->bool") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "D")) THEN
    X_CHOOSE_THEN (← q r"w:(V->num)->bool") MP_TAC pir2 THEN
    MP_TAC sr THEN
    DISCH_THEN (fun th => ONCE_REWRITE_TAC [th]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "R") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "I") (LABEL_TAC "C" o GSYM)) THEN
    SUBGOAL_THEN (← q r"!m. monomial (:V) m ==> m IN w") ASSUME_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [WF_IND] THEN X_GEN_TAC (← q r"P:(V->num)->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"!m:V->num. m IN w ==> P m") MP_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
        RULE_ASSUM_TAC (REWRITE_RULE
          [monomial_lt, monomial_le, ← GSYM MONOMIAL]) THEN
        ASM_MESON_TAC []]] THEN
    MATCH_MP_TAC MONOMIAL_INDUCT THEN REWRITE_TAC [IN_UNIV] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [MONOMIAL_1] THEN
      REWRITE_TAC [monomial_lt] THEN USE_THEN "D" (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [monomial_1, LT, FUN_EQ_THM] THEN MESON_TAC [LE_1],
      GEN_REWRITE_TAC id [SWAP_FORALL_THM]] THEN
    SUBGOAL_THEN
     (← q r"!P. (!m. m IN w /\ (!m'. monomial_lt (<<) m' m ==> P m') ==> P m)
             ==> !m:V->num. m IN w ==> P m")
     (LABEL_TAC "J")
    THENL
     [GEN_TAC THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [t2] THEN
      REMOVE_THEN "I" MATCH_MP_TAC THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC mm THEN
    FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [WF_IND]) THEN
    X_GEN_TAC (← q "a:V") THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
     [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    DISCH_TAC THEN
    USE_THEN "J" MATCH_MP_TAC THEN REWRITE_TAC [IMP_IMP] THEN
    X_GEN_TAC (← q r"m0:V->num") THEN STRIP_TAC THEN
    USE_THEN "R" MATCH_MP_TAC THEN
    REWRITE_TAC [MONOMIAL_MUL, MONOMIAL_VAR, IN_UNIV] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], X_GEN_TAC (← q r"n:V->num") THEN DISCH_TAC] THEN
    ASM_CASES_TAC (← q r"(n:V->num)(a) = m0(a) + 1") THENL
     [ABBREV_TAC (← q r"n0:V->num = \b. if b = a then m0(a) else (n:V->num) b") THEN
      SUBGOAL_THEN (← q r"n = monomial_mul (monomial_var a) (n0:V->num)")
      SUBST_ALL_TAC THENL
       [EXPAND_TAC "n0" THEN
        REWRITE_TAC [FUN_EQ_THM, monomial_mul, monomial_var] THEN
        X_GEN_TAC (← q "i:V") THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [ADD_CLAUSES] THEN ARITH_TAC,
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [MONOMIAL_LT_LMUL]],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"n0:V->num = \b. if m0(b) < n(b) /\ b << (a:V) then m0(b) else n b") THEN
    SUBGOAL_THEN (← q r"monomial_le (<<) (n0:V->num) m0") ASSUME_TAC THENL
     [EXPAND_TAC "n0" THEN USE_THEN "D" (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o REWRITE_RULE [monomial_lt]) THEN
        USE_THEN "D" (SUBST1_TAC o SYM) THEN REWRITE_TAC [CONJ_ASSOC] THEN
        DISCH_THEN (MP_TAC o CONJUNCT1) THEN REWRITE_TAC [MONOMIAL_MUL] THEN
        SIMP_TAC [MONOMIAL_VAR, IN_UNIV] THEN
        REWRITE_TAC [MONOMIAL, ← GSYM FINITE_UNION] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
        REWRITE_TAC [monomial_vars, SUBSET, IN_UNION, IN_ELIM_THM] THEN
        MESON_TAC [],
        ALL_TAC] THEN
      X_GEN_TAC (← q "i:V") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [LT_REFL] THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [DE_MORGAN_THM]) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o REWRITE_RULE [monomial_lt]) THEN
      USE_THEN "D" (SUBST1_TAC o SYM) THEN REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q "i:V") o CONJUNCT2 o CONJUNCT2) THEN
      ASM_REWRITE_TAC [monomial_mul, monomial_var] THEN
      ASM_CASES_TAC (← q "i:V = a") THEN ASM_REWRITE_TAC [] THENL
       [ALL_TAC,
        ASM_REWRITE_TAC [ADD_CLAUSES] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q "j:V") THEN ASM_CASES_TAC (← q "j:V = a") THENL
         [ASM_MESON_TAC [], ASM_REWRITE_TAC []] THEN
        ASM_REWRITE_TAC [ADD_CLAUSES] THEN ASM_ARITH_TAC] THEN
      UNDISCH_THEN (← q "i:V = a") SUBST_ALL_TAC THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q "j:V") THEN ASM_CASES_TAC (← q "j:V = a") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [ADD_CLAUSES] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(n0:V->num) IN w") ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"n0:V->num = m0") THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [monomial_lt],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?k:V->num. monomial {b | b << (a:V)} k /\ n = monomial_mul k n0")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"monomial_div (n:V->num) n0") THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM EQ_SYM_EQ] THEN
      REWRITE_TAC [MONOMIAL_DIV_RMUL_EQ] THEN EXPAND_TAC "n0" THEN
      REWRITE_TAC [monomial, monomial_div, monomial_divides] THEN
      CONJ_TAC THENL [ALL_TAC, ARITH_TAC] THEN
      REWRITE_TAC [monomial_vars, SUBSET, IN_ELIM_THM] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [monomial_lt]) THEN
        DISCH_THEN (MP_TAC o CONJUNCT2) THEN
        USE_THEN "D" (SUBST1_TAC o SYM) THEN REWRITE_TAC [MONOMIAL] THEN
        DISCH_THEN (MP_TAC o CONJUNCT1) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
        REWRITE_TAC [SUBSET, monomial_vars, IN_ELIM_THM] THEN ARITH_TAC,
        GEN_TAC THEN GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
        SIMP_TAC [] THEN ARITH_TAC],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"monomial {b:V | b << (a:V)} k") THEN ASM_REWRITE_TAC [] THEN
    SPEC_TAC (← q r"k:V->num", ← q r"k:V->num") THEN
    MATCH_MP_TAC MONOMIAL_INDUCT THEN
    REWRITE_TAC [IN_ELIM_THM, MONOMIAL_MUL_LID, ← GSYM MONOMIAL_MUL_ASSOC] THEN
    REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC []))

  let WOSET_MONOMIAL_LE ← prove
   r"!(<<=). woset(<<=) /\ fld(<<=) = (:V) ==> woset(monomial_le(<<=))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [WOSET_WF] THEN CONJ_TAC THENL
     [MP_TAC (← SPEC (← q r"(<<=):V->V->bool") TOSET_MONOMIAL_LE) THEN
      ASM_SIMP_TAC [WOSET_IMP_TOSET] THEN SIMP_TAC [toset],
      REWRITE_TAC [PROPERLY_MONOMIAL_LE] THEN
      ONCE_REWRITE_TAC [← GSYM MONOMIAL_LT_PROPERLY] THEN
      MATCH_MP_TAC WF_MONOMIAL_LT THEN ASM_MESON_TAC [WOSET_WF]])

  -- @@RETURN BEGIN
  return { POSET_MONOMIAL_DIVIDES, FLD_MONOMIAL_DIVIDES, COMPATIBLE_MONOMIAL_ORDER,
           WQOSET_COMPATIBLE_MONOMIAL_ORDER, WF_COMPATIBLE_MONOMIAL_ORDER,
           WOSET_COMPATIBLE_MONOMIAL_ORDER, monomial_le, monomial_lt,
           PROPERLY_MONOMIAL_LE, MONOMIAL_LE_MONO, MONOMIAL_LT_MONO,
           MONOMIAL_LE_PROPERLY, MONOMIAL_LT_PROPERLY, MONOMIAL_LE_IMPROPERLY,
           MONOMIAL_LT_IMPROPERLY, MONOMIAL_LE_REFL, MONOMIAL_LT_REFL,
           MONOMIAL_LT_IMP_LE, MONOMIAL_LE_LT, MONOMIAL_LE_TRANS, QOSET_MONOMIAL_LE,
           FLD_MONOMIAL_LE, MONOMIAL_LE_LMUL, MONOMIAL_LE_RMUL, MONOMIAL_LT_LMUL,
           MONOMIAL_LT_RMUL, MONOMIAL_LE_MUL2, MONOMIAL_LE_DIVISOR, MONOMIAL_GE_1,
           MONOMIAL_LE_VARS, MONOMIAL_LT_VARS, MONOMIAL_LE_POSET, MONOMIAL_LE_ANTISYM,
           MONOMIAL_LET_ANTISYM, MONOMIAL_LTE_ANTISYM, MONOMIAL_LT_ANTISYM,
           MONOMIAL_LET_TRANS, MONOMIAL_LTE_TRANS, MONOMIAL_LT_TRANS, MONOMIAL_LET_MUL2,
           MONOMIAL_LTE_MUL2, MONOMIAL_LT_MUL2, POSET_MONOMIAL_LE, MONOMIAL_LE_VARS_EQ,
           MONOMIAL_LT_VARS_EQ, MONOMIAL_LT_TOSET, MONOMIAL_LE_TOSET, TOSET_MONOMIAL_LE,
           WF_MONOMIAL_LT, WOSET_MONOMIAL_LE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Functions out of the 1-element type; the univariate accessor coeff.       -/
/- (ringtheory.ml 22002-22304)                                               -/
/- ------------------------------------------------------------------------- -/

structure OneCoeff where
  -- @@FIELDS
  EXISTS_FUN_FROM_1 : thm
  FORALL_FUN_FROM_1 : thm
  LAMBDA_1_EQ : thm
  FUN_ONE_NUM_EQ : thm
  FUN_ONE_EQ_ONE : thm
  FINITE_FUN_FROM_1 : thm
  MONOMIAL_DIVISORS_1 : thm
  coeff : thm
  COEFF : thm
  COEFF_0 : thm
  FUN_EQ_COEFF : thm
  RING_POLYNOMIAL_POWERSERIES_COEFF : thm
  RING_POWERSERIES_COEFF : thm
  COEFF_IN_CARRIER : thm
  COEFF_IN_CARRIER_ALT : thm
  RING_POLYNOMIAL_COEFF : thm
  COEFF_COMPOSE : thm
  COEFF_POLY_CONST : thm
  COEFF_POLY_0 : thm
  COEFF_POLY_1 : thm
  COEFF_POLY_VAR : thm
  COEFF_POLY_NEG : thm
  COEFF_POLY_ADD : thm
  COEFF_POLY_SUB : thm
  COEFF_POLY_MUL_ALT : thm
  COEFF_POLY_MUL : thm
  COEFF_POLY_VARPOW : thm
  COEFF_POLY_LMUL : thm
  COEFF_POLY_RMUL : thm
  COEFF_POLY_VAR_MUL : thm
  COEFF_POLY_MUL_VAR : thm
  COEFF_POLY_VARPOW_MUL : thm
  COEFF_POLY_MUL_VARPOW : thm
  POLY_MUL_UNIVARIATE : thm
  RING_POLYNOMIAL_SUBRING_COEFF : thm
  FINITE_COEFF_SUPPORT : thm
  RING_POLYNOMIAL_COEFF_BOUND : thm
  RING_POLYNOMIAL_COEFF_ZERO_FROM : thm
  deriving Inhabited

@[nospecialize]
def setupOneCoeff [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BSums : Sums) (BSubrings : Subrings) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) :
    ExceptT String IO OneCoeff := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, new_definition, .. } := D
  let { COND_ID, .. } := D.core1
  let { COND_RAND, COND_RATOR, COND_SWAP, EQ_IMP, EXISTS_PAIR_THM, EXTENSION, .. } := D.core2
  let { FINITE_IMAGE, FINITE_NUMSEG_LE, FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_ONE_THM,
        FORALL_PAIR_THM, FUN_EQ_THM, .. } := D.core3
  let { INFINITE, .. } := D.core4
  let { IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, LE_0, .. } := D.core5
  let { NOT_FORALL_THM, NOT_LE, PAIR_EQ, .. } := D.core6
  let { SUBSET, SUB_0, .. } := D.core7
  let { o_DEF, o_THM, one, .. } := D.core8
  let { RING_MUL, RING_MUL_LID, RING_MUL_LZERO, RING_MUL_SYM, .. } := BBasics
  let { RING_SUM_DELTA, RING_SUM_EQ_GENERAL_INVERSES, RING_SUM_IMAGE, .. } := BSums
  let { SUBRING_GENERATED, .. } := BSubrings
  let { FINITE_MONOMIAL_VARS_1, monomial_1, monomial_mul, monomial_var, .. } := BMonomials
  let { POLY_MUL_SYM, RING_POWERSERIES_CONST, RING_POWERSERIES_VAR, poly_0, poly_1,
        poly_add, poly_const, poly_mul, poly_neg, poly_sub, poly_var, ring_polynomial,
        ring_powerseries, .. } := BPowerSeries
  let { POLY_RING_CLAUSES, POLY_RING_VAR_POW, RING_POWERSERIES_POW, .. } := BPolyRings
  -- @@SCOPE END

  let EXISTS_FUN_FROM_1 ← prove
   r"!P. (?f. P (f one) f) <=> (?z:A. P z (\v. z))"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [EXISTS_TAC (← q "(f:1->A) one"), EXISTS_TAC (← q r"(\v. z):1->A")] THEN
    ASM_REWRITE_TAC [] THEN POP_ASSUM MP_TAC THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN MESON_TAC [one])

  let FORALL_FUN_FROM_1 ← prove
   r"!P. (!f. P (f one) f) <=> (!z:A. P z (\v. z))"
   (GEN_TAC THEN GEN_REWRITE_TAC id [← TAUT (← q r"(p <=> q) <=> (~p <=> ~q)")] THEN
    REWRITE_TAC [NOT_FORALL_THM, EXISTS_FUN_FROM_1])

  let LAMBDA_1_EQ ← prove
   r"(\v:1. a:A) = (\v. b) <=> a = b"
   (REWRITE_TAC [FUN_EQ_THM, FORALL_ONE_THM])

  let FUN_ONE_NUM_EQ ← prove
   r"!f:1->num c. f = (\v:1. c) <=> f one = c"
   (REWRITE_TAC [FORALL_FUN_FROM_1, LAMBDA_1_EQ])

  let FUN_ONE_EQ_ONE ← prove
   r"!m:1->num. m = (\v:1. m one)"
   (GEN_TAC THEN REWRITE_TAC [FUN_ONE_NUM_EQ])

  let FINITE_FUN_FROM_1 ← prove
   r"!P. FINITE {m:1->num | P m} <=> FINITE {d:num | P(\v:1. d)}"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (\(m:1->num). m one) {m | P m}") THEN
      ASM_SIMP_TAC [FINITE_IMAGE] THEN
      REWRITE_TAC [SUBSET, IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q "d:num") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(\v:1. d):1->num") THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (\(d:num) (v:1). d) {d | P(\v:1. d)}") THEN
      ASM_SIMP_TAC [FINITE_IMAGE] THEN
      REWRITE_TAC [SUBSET, IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q "m:1->num") THEN DISCH_TAC THEN
      EXISTS_TAC (← q "(m:1->num) one") THEN
      SUBGOAL_THEN (← q r"(\v:1. (m:1->num) one) = m")
       (fun th => ASM_REWRITE_TAC [th]) THEN
      REWRITE_TAC [FUN_EQ_THM, FORALL_ONE_THM]])

  let MONOMIAL_DIVISORS_1 ← prove
   r"!n. {(m1,m2) | monomial_mul m1 m2 = (\v:1. n)} =
       IMAGE (\i. ((\v:1. i), (\v:1. n - i))) (0..n)"
   (GEN_TAC THEN
    REWRITE_TAC [EXTENSION, FORALL_PAIR_THM, IN_IMAGE, IN_ELIM_PAIR_THM,
                 IN_NUMSEG, EXISTS_PAIR_THM, PAIR_EQ] THEN
    MAP_EVERY X_GEN_TAC [← q "m1:1->num", ← q "m2:1->num"] THEN
    REWRITE_TAC [monomial_mul, FUN_ONE_NUM_EQ] THEN EQ_TAC THENL
     [DISCH_TAC THEN EXISTS_TAC (← q "(m1:1->num) one") THEN
      ASM_ARITH_TAC,
      DISCH_THEN (X_CHOOSE_THEN (← q "i:num") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC])

  let coeff ← new_definition
   r"coeff = \i (p:(1->num)->A). p(\v:1. i)"

  let COEFF ← prove
   r"!i (p:(1->num)->A). coeff i p = p(\v:1. i)"
   (REWRITE_TAC [coeff])

  let COEFF_0 ← prove
   r"!p:(1->num)->A. coeff 0 p = p(monomial_1)"
   (REWRITE_TAC [monomial_1, coeff])

  let FUN_EQ_COEFF ← prove
   r"!(p:(1->num)->A) q. (!d. coeff d p = coeff d q) <=> p = q"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [coeff] THEN DISCH_TAC THEN
      REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q "m:1->num") THEN
      SUBGOAL_THEN (← q r"m:1->num = (\v:1. (m:1->num) one)") SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, FORALL_ONE_THM], ASM_REWRITE_TAC []],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC []])

  let RING_POLYNOMIAL_POWERSERIES_COEFF ← prove
   r"!r p. ring_polynomial r p <=>
         ring_powerseries r p /\ FINITE {i | ~(coeff i p:A = ring_0 r)}"
   (REWRITE_TAC [ring_polynomial, FINITE_FUN_FROM_1, coeff])

  let RING_POWERSERIES_COEFF ← prove
   r"!r (p:(1->num)->A).
        ring_powerseries r p <=> (!d. coeff d p IN ring_carrier r)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_powerseries, coeff] THEN EQ_TAC THENL
     [SIMP_TAC [],
      DISCH_TAC THEN CONJ_TAC THENL
       [X_GEN_TAC (← q "m:1->num") THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q "(m:1->num) one")) THEN
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM, FORALL_ONE_THM],
        MESON_TAC [FINITE_MONOMIAL_VARS_1, INFINITE]]])

  let COEFF_IN_CARRIER ← prove
   r"!r (p:(1->num)->A) d.
        ring_powerseries r p ==> coeff d p IN ring_carrier r"
   (SIMP_TAC [RING_POWERSERIES_COEFF])

  let COEFF_IN_CARRIER_ALT ← prove
   r"!r (p:(1->num)->A) d.
        ring_polynomial r p ==> coeff d p IN ring_carrier r"
   (MESON_TAC [COEFF_IN_CARRIER, ring_polynomial])

  let RING_POLYNOMIAL_COEFF ← prove
   r"!r (p:(1->num)->A).
        ring_polynomial r p <=>
        (!d. coeff d p IN ring_carrier r) /\
        FINITE {d | ~(coeff d p = ring_0 r)}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [ring_polynomial, RING_POWERSERIES_COEFF] THEN
    AP_TERM_TAC THEN REWRITE_TAC [coeff] THEN
    ONCE_REWRITE_TAC [← GSYM FINITE_FUN_FROM_1] THEN
    REFL_TAC)

  let COEFF_COMPOSE ← prove
   r"!(h:A->B) p i. coeff i (h o p) = h(coeff i p)"
   (REWRITE_TAC [coeff, o_THM])

  let COEFF_POLY_CONST ← prove
   r"!r c d. coeff d (poly_const r c :(1->num)->A) =
           if d = 0 then c else ring_0 r"
   (REWRITE_TAC [coeff, poly_const, monomial_1, LAMBDA_1_EQ])

  let COEFF_POLY_0 ← prove
   r"!r d. coeff d (poly_0 r :(1->num)->A) = ring_0 r"
   (REWRITE_TAC [poly_0, COEFF_POLY_CONST, COND_ID])

  let COEFF_POLY_1 ← prove
   r"!r d. coeff d (poly_1 r :(1->num)->A) =
         if d = 0 then ring_1 r else ring_0 r"
   (REWRITE_TAC [poly_1, COEFF_POLY_CONST])

  let COEFF_POLY_VAR ← prove
   r"!r d x. coeff d (poly_var r x) = if d = 1 then ring_1 r else ring_0 r"
   (REWRITE_TAC [FORALL_ONE_THM, poly_var, coeff, monomial_var] THEN
    ONCE_REWRITE_TAC [one] THEN REWRITE_TAC [LAMBDA_1_EQ])

  let COEFF_POLY_NEG ← prove
   r"!r p d. coeff d (poly_neg r p :(1->num)->A) = ring_neg r (coeff d p)"
   (REWRITE_TAC [coeff, poly_neg])

  let COEFF_POLY_ADD ← prove
   r"!r p q d. coeff d (poly_add r p q :(1->num)->A) =
             ring_add r (coeff d p) (coeff d q)"
   (REWRITE_TAC [coeff, poly_add])

  let COEFF_POLY_SUB ← prove
   r"!r p q d. coeff d (poly_sub r p q :(1->num)->A) =
             ring_sub r (coeff d p) (coeff d q)"
   (REWRITE_TAC [coeff, poly_sub])

  let COEFF_POLY_MUL_ALT ← prove
   r"!(r:A ring) p q d.
        coeff d (poly_mul r p q :(1->num)->A) =
        ring_sum r {i,j | i,j | i + j = d}
                   (\(i,j). ring_mul r (coeff i p) (coeff j q))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [poly_mul, coeff] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_SUM_EQ_GENERAL_INVERSES THEN
    EXISTS_TAC (← q r"\(m1,m2). m1 one:num,m2 one:num") THEN
    EXISTS_TAC (← q r"\(i:num,j:num). (\v:1. i),(\v:1. j)") THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_PAIR_THM] THEN
    SIMP_TAC [FORALL_FUN_FROM_1, monomial_mul] THEN SIMP_TAC [FUN_EQ_THM])

  let COEFF_POLY_MUL ← prove
   r"!r p q d. coeff d (poly_mul r p q :(1->num)->A) =
             ring_sum r (0..d)
                        (\a. ring_mul r (coeff a p) (coeff (d - a) q))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [poly_mul, coeff] THEN
    REWRITE_TAC [MONOMIAL_DIVISORS_1] THEN
    wPart lhand (fun t => do lhand (← rand t)) RING_SUM_IMAGE THEN
    REWRITE_TAC [IN_NUMSEG, PAIR_EQ, FUN_ONE_NUM_EQ, o_DEF] THEN
    DISCH_THEN MATCH_MP_TAC THEN ARITH_TAC)

  let COEFF_POLY_VARPOW ← prove
   r"!(r:A ring) x k d.
        coeff d (poly_pow r (poly_var r x) k) =
        if d = k then ring_1 r else ring_0 r"
   (REWRITE_TAC [FORALL_ONE_THM] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "(:1)", ← q "one", ← q "k:num"]
          POLY_RING_VAR_POW) THEN
    REWRITE_TAC [POLY_RING_CLAUSES] THEN DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [coeff, ← EQT_INTRO (← SPEC_ALL one), LAMBDA_1_EQ])

  let COEFF_POLY_LMUL ← prove
   r"!r c (p:(1->num)->A) d.
        c IN ring_carrier r /\ ring_powerseries r p
        ==> coeff d (poly_mul r (poly_const r c) p) =
            ring_mul r c (coeff d p)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [COEFF_POLY_MUL, COEFF_POLY_CONST] THEN
    SUBGOAL_THEN
     (← q r"!a. ring_mul r (if a = 0 then c else ring_0 r)
                      (coeff (d - a) (p:(1->num)->A)) =
          if a = 0 then ring_mul r c (coeff d p) else ring_0 r")
      (fun th => REWRITE_TAC [th]) THENL
     [X_GEN_TAC (← q "a:num") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [SUB_0] THEN
      MATCH_MP_TAC RING_MUL_LZERO THEN ASM_SIMP_TAC [COEFF_IN_CARRIER],
      REWRITE_TAC [RING_SUM_DELTA, IN_NUMSEG, LE_0] THEN
      ASM_SIMP_TAC [RING_MUL, COEFF_IN_CARRIER, RING_POWERSERIES_COEFF]])

  let COEFF_POLY_RMUL ← prove
   r"!r c (p:(1->num)->A) d.
        c IN ring_carrier r /\ ring_powerseries r p
        ==> coeff d (poly_mul r p (poly_const r c)) =
            ring_mul r (coeff d p) c"
   (MESON_TAC [COEFF_POLY_LMUL, POLY_MUL_SYM, RING_POWERSERIES_CONST,
               RING_MUL_SYM, COEFF_IN_CARRIER])

  let COEFF_POLY_VAR_MUL ← prove
   r"!r (p:(1->num)->A) x d.
        ring_powerseries r p
        ==> coeff d (poly_mul r (poly_var r x) p) =
            if d = 0 then ring_0 r else coeff (d - 1) p"
   (REWRITE_TAC [FORALL_ONE_THM] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [COEFF_POLY_MUL, COEFF_POLY_VAR] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [COND_RAND, COND_RATOR] THEN
    ASM_SIMP_TAC [COEFF_IN_CARRIER, RING_MUL_LZERO, RING_SUM_DELTA, RING_MUL_LID,
                  IN_NUMSEG, LE_0] THEN
    REWRITE_TAC [← ARITH_RULE (← q "1 <= d <=> ~(d = 0)"), COND_SWAP])

  let COEFF_POLY_MUL_VAR ← prove
   r"!r (p:(1->num)->A) x d.
        ring_powerseries r p
        ==> coeff d (poly_mul r p (poly_var r x)) =
            if d = 0 then ring_0 r else coeff (d - 1) p"
   (MESON_TAC [COEFF_POLY_VAR_MUL, POLY_MUL_SYM, RING_POWERSERIES_VAR])

  let COEFF_POLY_VARPOW_MUL ← prove
   r"!r (p:(1->num)->A) x k d.
        ring_powerseries r p
        ==> coeff d (poly_mul r (poly_pow r (poly_var r x) k) p) =
            if d < k then ring_0 r else coeff (d - k) p"
   (REWRITE_TAC [FORALL_ONE_THM] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [COEFF_POLY_MUL, COEFF_POLY_VARPOW] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [COND_RAND, COND_RATOR] THEN
    ASM_SIMP_TAC [COEFF_IN_CARRIER, RING_MUL_LZERO, RING_SUM_DELTA, RING_MUL_LID,
                  IN_NUMSEG, LE_0, ← GSYM NOT_LE, COND_SWAP])

  let COEFF_POLY_MUL_VARPOW ← prove
   r"!r (p:(1->num)->A) x k d.
        ring_powerseries r p
        ==> coeff d (poly_mul r p (poly_pow r (poly_var r x) k)) =
            if d < k then ring_0 r else coeff (d - k) p"
   (MESON_TAC [COEFF_POLY_VARPOW_MUL, POLY_MUL_SYM,
               RING_POWERSERIES_VAR, RING_POWERSERIES_POW])

  let POLY_MUL_UNIVARIATE ← prove
   r"!r (p:(1->num)->R) q.
      poly_mul r p q =
      \m. ring_sum r (0..m one)
              (\i. ring_mul r (coeff i p) (coeff (m one - i) q))"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q "m:1->num") THEN REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"m:1->num = (\v:1. m one)") SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, FORALL_ONE_THM], ALL_TAC] THEN
    REWRITE_TAC [← GSYM COEFF, COEFF_POLY_MUL])

  let RING_POLYNOMIAL_SUBRING_COEFF ← prove
   r"!r G (p:(1->num)->A).
        ring_polynomial r p /\
        (!d. coeff d p IN ring_carrier(subring_generated r G))
        ==> ring_polynomial (subring_generated r G) p"
   (REPEAT GEN_TAC THEN REWRITE_TAC [RING_POLYNOMIAL_COEFF] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [SUBRING_GENERATED])

  let FINITE_COEFF_SUPPORT ← prove
   r"!r (p:(1->num)->A).
        ring_polynomial r p ==> FINITE {d | ~(coeff d p = ring_0 r)}"
   (SIMP_TAC [RING_POLYNOMIAL_COEFF])

  let RING_POLYNOMIAL_COEFF_BOUND ← prove
   r"!r (p:(1->num)->A) n.
        ring_powerseries r p /\
        (!d. ~(coeff d p = ring_0 r) ==> d <= n)
        ==> ring_polynomial r p"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [RING_POLYNOMIAL_COEFF] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [RING_POWERSERIES_COEFF],
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q "{d:num | d <= n}") THEN
      REWRITE_TAC [FINITE_NUMSEG_LE, SUBSET, IN_ELIM_THM] THEN
      ASM_MESON_TAC []])

  let RING_POLYNOMIAL_COEFF_ZERO_FROM ← prove
   r"!r (p:(1->num)->A) n.
        ring_powerseries r p /\
        (!d. n <= d ==> coeff d p = ring_0 r)
        ==> ring_polynomial r p"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_POLYNOMIAL_COEFF_BOUND THEN
    EXISTS_TAC (← q "n:num") THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q "d:num") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q "n <= d:num") THENL
     [UNDISCH_TAC (← q "~(coeff d (p:(1->num)->A) = ring_0 r)") THEN ASM_SIMP_TAC [],
      POP_ASSUM MP_TAC THEN ARITH_TAC])

  -- @@RETURN BEGIN
  return { EXISTS_FUN_FROM_1, FORALL_FUN_FROM_1, LAMBDA_1_EQ, FUN_ONE_NUM_EQ,
           FUN_ONE_EQ_ONE, FINITE_FUN_FROM_1, MONOMIAL_DIVISORS_1, coeff, COEFF, COEFF_0,
           FUN_EQ_COEFF, RING_POLYNOMIAL_POWERSERIES_COEFF, RING_POWERSERIES_COEFF,
           COEFF_IN_CARRIER, COEFF_IN_CARRIER_ALT, RING_POLYNOMIAL_COEFF, COEFF_COMPOSE,
           COEFF_POLY_CONST, COEFF_POLY_0, COEFF_POLY_1, COEFF_POLY_VAR, COEFF_POLY_NEG,
           COEFF_POLY_ADD, COEFF_POLY_SUB, COEFF_POLY_MUL_ALT, COEFF_POLY_MUL,
           COEFF_POLY_VARPOW, COEFF_POLY_LMUL, COEFF_POLY_RMUL, COEFF_POLY_VAR_MUL,
           COEFF_POLY_MUL_VAR, COEFF_POLY_VARPOW_MUL, COEFF_POLY_MUL_VARPOW,
           POLY_MUL_UNIVARIATE, RING_POLYNOMIAL_SUBRING_COEFF, FINITE_COEFF_SUPPORT,
           RING_POLYNOMIAL_COEFF_BOUND, RING_POLYNOMIAL_COEFF_ZERO_FROM }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Degree (multidegree, total degree in multivariate case) of polynomial.    -/
/- (ringtheory.ml 22304-23102)                                               -/
/- ------------------------------------------------------------------------- -/

structure Degree where
  -- @@FIELDS
  poly_deg : thm
  POLY_DEG_SUBRING_GENERATED : thm
  POLY_DEG_CONST : thm
  POLY_DEG_0 : thm
  POLY_DEG_1 : thm
  POLY_DEG_LE_EQ : thm
  POLY_DEG_LE : thm
  MONOMIAL_DEG_LE_POLY_DEG : thm
  POLY_DEG_GE_EQ : thm
  POLY_DEG_GE : thm
  COEFF_ABOVE_DEG : thm
  POLY_DEG_MONOMIAL_EXISTS : thm
  POLY_TOP_MONOMIAL_LE : thm
  POLY_TOP_MONOMIAL_LT : thm
  POLY_DEG_EQ_0_ALT : thm
  POLY_DEG_EQ_0 : thm
  POLY_DEG_EQ : thm
  POLY_DEG_UNIQUE : thm
  POLY_DEG_VAR : thm
  COEFF_NONZERO_LE_DEG : thm
  COEFF_NONZERO_LE : thm
  POLY_DEG_LE_COEFF_EQ : thm
  POLY_DEG_LE_COEFF : thm
  POLY_DEG_GE_COEFF_EQ : thm
  POLY_DEG_GE_COEFF : thm
  POLY_DEG_EQ_COEFF_EQ : thm
  POLY_DEG_EQ_COEFF : thm
  POLY_DEG_EQ_FROM_LE : thm
  COEFF_POWSER_SUM : thm
  COEFF_POLY_SUM : thm
  POLY_DEG_NEG : thm
  POLY_DEG_ADD_LE : thm
  POLY_DEG_SUB_LE : thm
  POLY_DEG_ADD : thm
  POLY_DEG_SUB : thm
  POLY_DEG_MUL_LE : thm
  POLY_DEG_POW_LE : thm
  POLY_DEG_MUL : thm
  POLY_DEG_CMUL : thm
  POLY_MUL_LEADING_COEFF : thm
  POLY_DEG_MUL_UNIVARIATE : thm
  POLY_DEG_VAR_MUL : thm
  POLY_DEG_MUL_VAR : thm
  POLY_DEG_VARPOW_MUL : thm
  POLY_DEG_MUL_VARPOW : thm
  INTEGRAL_DOMAIN_POLY_RING : thm
  POLY_DEG_POW : thm
  POLY_DEG_DIVIDES_LE : thm
  POLY_DEG_RING_ADD_LE : thm
  POLY_DEG_RING_SUB_LE : thm
  POLY_DEG_RING_SUM_LE : thm
  POLY_DEG_VAR_POW : thm
  POLY_POLY_DEG_EQ_0 : thm
  POLY_VARS_MUL_EQ : thm
  POLY_VARS_POW_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupDegree [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BSums : Sums) (BDivides : Divides) (BSubrings : Subrings) (BDomains : Domains) (BHoms : Homs) (BKernels : Kernels) (BRingRule : RingRule) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BNatIso : NatIso) (BMonomialOrders : MonomialOrders) (BOneCoeff : OneCoeff) :
    ExceptT String IO Degree := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON,
        MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { ADD_CLAUSES, ADD_EQ_0, ADD_SUB2, ADD_SYM, ARITH_EQ, COND_ID, .. } := D.core1
  let { COND_RAND, COND_RATOR, CONJ_ASSOC, CONTRAPOS_THM, EQ_SYM_EQ, ETA_AX,
        EXISTS_IN_GSPEC, .. } := D.core2
  let { FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_INTER, FINITE_SUBSET,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_IN_UNION,
        FORALL_IN_UNIONS, FORALL_UNWIND_THM2, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, INFINITE, .. } := D.core4
  let { IN_ELIM_THM, IN_NUMSEG, IN_SING, IN_UNIV, LE, LEFT_IMP_EXISTS_THM, LE_0,
        LE_ADD, LE_ADD2, LE_ANTISYM, LE_LT, LE_REFL, LE_TRANS, LT, .. } := D.core5
  let { MINIMAL_LE, MINIMAL_UNIQUE, MULT_CLAUSES, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, NOT_LE, NOT_LT, NOT_SUC, NSUM_DELTA, PAIR_EQ, PSUBSET_ALT, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SELECT_UNIQUE, SUBSET, SUBSET_UNION, SUBSET_UNIV,
        SWAP_FORALL_THM, TOSET_MAX, UNION_EMPTY, .. } := D.core7
  let { WO, WOSET_IMP_POSET, WOSET_IMP_TOSET, minimal, num_FINITE, .. } := D.core8
  let { RING_0, RING_ADD, RING_ADD_LZERO, RING_MUL, RING_MUL_LZERO, RING_MUL_RZERO,
        RING_NEG_EQ_0, RING_SUB, TRIVIAL_RING_10, .. } := BBasics
  let { RING_SUM, RING_SUM_CLAUSES, RING_SUM_DELTA, RING_SUM_EQ, RING_SUM_EQ_0,
        RING_SUM_SING, RING_SUM_SUPERSET, .. } := BSums
  let { ring_divides, .. } := BDivides
  let { SUBRING_GENERATED, .. } := BSubrings
  let { INTEGRAL_DOMAIN_MUL_EQ_0, INTEGRAL_DOMAIN_POW_EQ_0, integral_domain, .. } := BDomains
  let { RING_ISOMORPHISMS_ISOMORPHISM, RING_ISOMORPHISM_IMP_MONOMORPHISM,
        ring_homomorphism, ring_isomorphisms, .. } := BHoms
  let { INTEGRAL_DOMAIN_MONOMORPHIC_PREIMAGE, RING_MONOMORPHISM_ALT_EQ, .. } := BKernels
  let { RING_RULE, .. } := BRingRule
  let { MONOMIAL_DEG, MONOMIAL_DEG_1, MONOMIAL_DEG_EQ_0, MONOMIAL_DEG_MUL,
        MONOMIAL_DEG_UNIVARIATE, MONOMIAL_DEG_VAR, MONOMIAL_DIVIDES_REFL,
        MONOMIAL_MUL_RESTRICT, MONOMIAL_MUL_SYM, MONOMIAL_RESTRICT_EQ,
        MONOMIAL_RESTRICT_REFL, MONOMIAL_RULE, MONOMIAL_UNIV, MONOMIAL_VAR,
        MONOMIAL_VARS_EQ_EMPTY, MONOMIAL_VARS_MUL, MONOMIAL_VAR_DIVIDES_MUL, monomial,
        monomial_1, monomial_restrict, monomial_vars, .. } := BMonomials
  let { POLY_0, POLY_MUL_0, POLY_MUL_ASSOC, POLY_MUL_LID, POLY_MUL_SYM, POLY_SUB,
        POLY_VARS_0, POLY_VARS_1, POLY_VARS_MUL, POLY_VAR_MUL, RING_POLYNOMIAL_0,
        RING_POLYNOMIAL_ADD, RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_IMP_POWERSERIES,
        RING_POLYNOMIAL_MONOMIAL, RING_POLYNOMIAL_MUL, RING_POLYNOMIAL_NEG,
        RING_POLYNOMIAL_VAR, poly_0, poly_1, poly_add, poly_const, poly_mul, poly_neg,
        poly_var, poly_vars, ring_polynomial, ring_powerseries, .. } := BPowerSeries
  let { IN_POLY_RING_CARRIER, POLY_CLAUSES, POLY_CONST_EQ, POLY_CONST_EQ_0,
        POLY_CONST_MUL, POLY_MONOMIALS, POLY_POW, POLY_POW_0, POLY_RING,
        POLY_RING_CLAUSES, POLY_RING_VAR_POW, POWSER_RING, POWSER_VARPOW_MUL_EQ_0,
        RING_MONOMORPHISM_POLY_CONST, RING_POLYNOMIAL, RING_POLYNOMIAL_CARRIER,
        RING_POLYNOMIAL_POW, TRIVIAL_POLY_RING, .. } := BPolyRings
  let { RING_ISOMORPHISMS_POLY_POLY_RING, .. } := BNatIso
  let { FLD_MONOMIAL_LE, MONOMIAL_LT_LMUL, MONOMIAL_LT_MUL2, MONOMIAL_LT_REFL,
        MONOMIAL_LT_RMUL, TOSET_MONOMIAL_LE, monomial_lt, .. } := BMonomialOrders
  let { COEFF, COEFF_IN_CARRIER, COEFF_IN_CARRIER_ALT, COEFF_POLY_0, COEFF_POLY_ADD,
        COEFF_POLY_MUL, EXISTS_FUN_FROM_1, FORALL_FUN_FROM_1,
        RING_POLYNOMIAL_COEFF_BOUND, coeff, .. } := BOneCoeff
  -- @@SCOPE END

  let poly_deg ← new_definition
   r"poly_deg r (p:(V->num)->A) =
        minimal d. !m. ~(p m = ring_0 r) ==> monomial_deg m <= d"

  let POLY_DEG_SUBRING_GENERATED ← prove
   r"!r s (p:(V->num)->A).
        poly_deg (subring_generated r s) p = poly_deg r p"
   (REWRITE_TAC [poly_deg, ← CONJUNCT2 SUBRING_GENERATED])

  let POLY_DEG_CONST ← prove
   r"!r c. poly_deg r (poly_const r c:(V->num)->A) = 0"
   (REPEAT GEN_TAC THEN REWRITE_TAC [poly_deg, poly_const] THEN
    REWRITE_TAC [COND_RAND, COND_RATOR] THEN
    REWRITE_TAC [← TAUT (← q r"(if p then q else T) <=> p ==> q")] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2, MONOMIAL_DEG_1, LE_0] THEN
    REWRITE_TAC [minimal] THEN MATCH_MP_TAC SELECT_UNIQUE THEN
    REWRITE_TAC [NOT_LT] THEN MESON_TAC [LE_0, LE])

  let POLY_DEG_0 ← prove
   r"!r. poly_deg r (poly_0 r:(V->num)->A) = 0"
   (REWRITE_TAC [poly_0, POLY_DEG_CONST])

  let POLY_DEG_1 ← prove
   r"!r. poly_deg r (poly_1 r:(V->num)->A) = 0"
   (REWRITE_TAC [poly_1, POLY_DEG_CONST])

  let POLY_DEG_LE_EQ ← prove
   r"!r (p:(V->num)->A) n.
        ring_polynomial r p
        ==> (poly_deg r p <= n <=>
             !m. ~(p m = ring_0 r) ==> monomial_deg m <= n)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_deg] THEN
    wPart lhand (fun t => do lhand (← rand t)) MINIMAL_LE THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o REWRITE_RULE [ring_polynomial]) THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"monomial_deg:(V->num)->num") o
        MATCH_MP FINITE_IMAGE) THEN
      REWRITE_TAC [num_FINITE, FORALL_IN_IMAGE, IN_ELIM_THM],
      DISCH_THEN SUBST1_TAC THEN MESON_TAC [LE_TRANS, LE_REFL]])

  let POLY_DEG_LE ← prove
   r"!r (p:(V->num)->A) n.
        ring_polynomial r p /\
        (!m. ~(p m = ring_0 r) ==> monomial_deg m <= n)
        ==> poly_deg r p <= n"
   (MESON_TAC [POLY_DEG_LE_EQ])

  let MONOMIAL_DEG_LE_POLY_DEG ← prove
   r"!r (p:(V->num)->A) m.
        ring_polynomial r p /\ ~(p m = ring_0 r)
        ==> monomial_deg m <= poly_deg r p"
   (MESON_TAC [POLY_DEG_LE_EQ, LE_REFL])

  let POLY_DEG_GE_EQ ← prove
   r"!r (p:(V->num)->A) n.
        ring_polynomial r p
        ==> (n <= poly_deg r p <=>
             n = 0 \/ ?m. ~(p m = ring_0 r) /\ n <= monomial_deg m)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← ARITH_RULE (← q r"n <= x <=> n = 0 \/ ~(x <= n - 1)")] THEN
    ASM_CASES_TAC (← q "n = 0") THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP POLY_DEG_LE_EQ th])) THEN
    MESON_TAC [])

  let POLY_DEG_GE ← prove
   r"!r (p:(V->num)->A) m n.
        ring_polynomial r p /\
        ~(p m = ring_0 r) /\ n <= monomial_deg m
        ==> n <= poly_deg r p"
   (MESON_TAC [POLY_DEG_GE_EQ])

  let COEFF_ABOVE_DEG ← prove
   r"!r (p:(1->num)->A) d.
     ring_polynomial r p /\ poly_deg r p < d
     ==> coeff d p = ring_0 r"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "p:(1->num)->A", ← q "poly_deg r (p:(1->num)->A)"]
      POLY_DEG_LE_EQ) THEN
    ASM_REWRITE_TAC [LE_REFL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(\v:1. d):(1->num)")) THEN
    REWRITE_TAC [MONOMIAL_DEG_UNIVARIATE, coeff, MONOMIAL_UNIV] THEN
    ASM_MESON_TAC [NOT_LE])

  let POLY_DEG_MONOMIAL_EXISTS ← prove
   r"!r (p:(V->num)->A).
        ring_polynomial r p /\ ~(p = poly_0 r)
        ==> ?m. ~(p m = ring_0 r) /\ monomial_deg m = poly_deg r p"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← MESON [LE_LT]
     (← q r"(!m. Q m ==> monomial_deg m <= n) /\ ~(!m. Q m ==> monomial_deg m < n)
      ==> ?m. Q m /\ monomial_deg m = n")) THEN
    ASM_SIMP_TAC [MONOMIAL_DEG_LE_POLY_DEG] THEN
    ASM_CASES_TAC (← q r"poly_deg r (p:(V->num)->A) = 0") THEN ASM_REWRITE_TAC [LT] THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [FUN_EQ_THM]) THEN
      REWRITE_TAC [poly_0, poly_const, COND_ID],
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, NOT_LT] THEN
      ASM_MESON_TAC [POLY_DEG_GE_EQ, LE_REFL]])

  let POLY_TOP_MONOMIAL_LE ← prove
   r"!(<<=) r (p:(V->num)->A).
        toset(<<=) /\ fld(<<=) = (:V) /\
        ring_polynomial r p /\ ~(p = poly_0 r)
        ==> ?m. ~(p m = ring_0 r) /\ monomial_deg m = poly_deg r p /\
                !m'. ~(p m' = ring_0 r) /\ monomial_deg m' = poly_deg r p
                     ==> monomial_le(<<=) m' m"
   (REWRITE_TAC [ring_powerseries, ring_polynomial, INFINITE] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN ONCE_REWRITE_TAC [← SET_RULE
     (← q r"~(p m = ring_0 r) /\ monomial_deg m = d <=>
      m IN {m | ~(p m = ring_0 r) /\ monomial_deg m = d}")] THEN
    MATCH_MP_TAC TOSET_MAX THEN ASM_REWRITE_TAC [ETA_AX, FLD_MONOMIAL_LE] THEN
    ASM_SIMP_TAC [TOSET_MONOMIAL_LE, monomial, SUBSET_UNIV] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
      SET_TAC [],
      MP_TAC (← ISPECL [← q "r:A ring", ← q r"p:(V->num)->A"] POLY_DEG_MONOMIAL_EXISTS) THEN
      ASM_REWRITE_TAC [ring_powerseries, ring_polynomial, INFINITE] THEN
      ASM SET_TAC []])

  let POLY_TOP_MONOMIAL_LT ← prove
   r"!(<<=) r (p:(V->num)->A).
        toset(<<=) /\ fld(<<=) = (:V) /\
        ring_polynomial r p /\ ~(p = poly_0 r)
        ==> ?m. ~(p m = ring_0 r) /\ monomial_deg m = poly_deg r p /\
                !m'. ~(p m' = ring_0 r) /\ monomial_deg m' = poly_deg r p /\
                     ~(m' = m)
                     ==> monomial_lt(<<=) m' m"
   (SIMP_TAC [monomial_lt] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP POLY_TOP_MONOMIAL_LE) THEN
    MESON_TAC [POLY_TOP_MONOMIAL_LE])

  let POLY_DEG_EQ_0_ALT ← prove
   r"!r (p:(V->num)->A).
      ring_polynomial r p
      ==> (poly_deg r p = 0 <=> p = poly_const r (p monomial_1))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM (← CONJUNCT1 LE)] THEN
    ASM_SIMP_TAC [POLY_DEG_LE_EQ] THEN REWRITE_TAC [LE] THEN
    GEN_REWRITE_TAC RAND_CONV [FUN_EQ_THM] THEN REWRITE_TAC [poly_const] THEN
    ASM_MESON_TAC [RING_POLYNOMIAL_CARRIER, POLY_MONOMIALS, MONOMIAL_DEG_EQ_0])

  let POLY_DEG_EQ_0 ← prove
   r"!r (p:(V->num)->A).
      ring_polynomial r p
      ==> (poly_deg r p = 0 <=>
           ?c. c IN ring_carrier r /\ p = poly_const r c)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [POLY_DEG_CONST, LEFT_IMP_EXISTS_THM] THEN
    ASM_SIMP_TAC [POLY_DEG_EQ_0_ALT] THEN DISCH_THEN SUBST1_TAC THEN
    EXISTS_TAC (← q r"(p:(V->num)->A) monomial_1") THEN
    ASM_MESON_TAC [ring_polynomial, ring_powerseries])

  let POLY_DEG_EQ ← prove
   r"!r (p:(V->num)->A) n.
        ring_polynomial r p
        ==> (poly_deg r p = n <=>
             (!m. ~(p m = ring_0 r) ==> monomial_deg m <= n) /\
             (n = 0 \/ ?m. ~(p m = ring_0 r) /\ monomial_deg m = n))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM LE_ANTISYM] THEN
    ASM_SIMP_TAC [POLY_DEG_LE_EQ, POLY_DEG_GE_EQ] THEN
    ASM_MESON_TAC [LE_ANTISYM])

  let POLY_DEG_UNIQUE ← prove
   r"!r (p:(V->num)->A) n.
        ring_polynomial r p /\
        (!m. ~(p m = ring_0 r) ==> monomial_deg m <= n) /\
        (n = 0 \/ ?m. ~(p m = ring_0 r) /\ monomial_deg m = n)
        ==> poly_deg r p = n"
   (MESON_TAC [POLY_DEG_EQ])

  let POLY_DEG_VAR ← prove
   r"!r. poly_deg r (poly_var r v:(V->num)->A) =
       if ring_1 r = ring_0 r then 0 else 1"
   (GEN_TAC THEN MATCH_MP_TAC POLY_DEG_UNIQUE THEN
    REWRITE_TAC [RING_POLYNOMIAL_VAR] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [poly_var, ARITH_EQ, LE, COND_ID] THEN
    ASM_SIMP_TAC [LE_REFL, COND_RAND, COND_RATOR, MONOMIAL_DEG_VAR] THEN
    MESON_TAC [])

  let COEFF_NONZERO_LE_DEG ← prove
   r"!r (p:(1->num)->A) d.
        ring_polynomial r p /\ ~(coeff d p = ring_0 r)
        ==> d <= poly_deg r p"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"monomial_deg (\v:1. d) <= poly_deg r (p:(1->num)->A)") MP_TAC THENL
     [MATCH_MP_TAC MONOMIAL_DEG_LE_POLY_DEG THEN ASM_REWRITE_TAC [] THEN
      UNDISCH_TAC (← q "~(coeff d (p:(1->num)->A) = ring_0 r)") THEN REWRITE_TAC [coeff],
      REWRITE_TAC [MONOMIAL_DEG_UNIVARIATE]])

  let COEFF_NONZERO_LE ← prove
   r"!r (p:(1->num)->A) n d.
        ring_polynomial r p /\ poly_deg r p <= n /\
        ~(coeff d p = ring_0 r)
        ==> d <= n"
   (MESON_TAC [COEFF_NONZERO_LE_DEG, LE_TRANS])

  let POLY_DEG_LE_COEFF_EQ ← prove
   r"!r (p:(1->num)->A) n.
        ring_polynomial r p
        ==> (poly_deg r p <= n <=>
             !d. ~(coeff d p = ring_0 r) ==> d <= n)"
   (ASM_SIMP_TAC [POLY_DEG_LE_EQ] THEN
    ASM_REWRITE_TAC [FORALL_FUN_FROM_1, MONOMIAL_DEG_UNIVARIATE, ← GSYM COEFF])

  let POLY_DEG_LE_COEFF ← prove
   r"!r (p:(1->num)->A) n.
        ring_powerseries r p /\
        (!d. ~(coeff d p = ring_0 r) ==> d <= n)
        ==> poly_deg r p <= n"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q "ring_polynomial r (p:(1->num)->A)") ASSUME_TAC THENL
     [MATCH_MP_TAC RING_POLYNOMIAL_COEFF_BOUND THEN
      EXISTS_TAC (← q "n:num") THEN ASM_REWRITE_TAC [],
      ASM_SIMP_TAC [POLY_DEG_LE_COEFF_EQ]])

  let POLY_DEG_GE_COEFF_EQ ← prove
   r"!r (p:(1->num)->A) n.
        ring_polynomial r p
        ==> (n <= poly_deg r p <=>
             n = 0 \/ ?d. ~(coeff d p = ring_0 r) /\ n <= d)"
   (ASM_SIMP_TAC [POLY_DEG_GE_EQ] THEN
    ASM_REWRITE_TAC [EXISTS_FUN_FROM_1, MONOMIAL_DEG_UNIVARIATE, ← GSYM COEFF])

  let POLY_DEG_GE_COEFF ← prove
   r"!r (p:(1->num)->A) d n.
        ring_polynomial r p /\
        ~(coeff d p = ring_0 r) /\ n <= d
        ==> n <= poly_deg r p"
   (MESON_TAC [POLY_DEG_GE_COEFF_EQ])

  let POLY_DEG_EQ_COEFF_EQ ← prove
   r"!r (p:(1->num)->A) n.
        ring_polynomial r p
        ==> (poly_deg r p = n <=>
             (!d. ~(coeff d p = ring_0 r) ==> d <= n) /\
             (n = 0 \/ ~(coeff n p = ring_0 r)))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [POLY_DEG_EQ] THEN
    ASM_REWRITE_TAC [FORALL_FUN_FROM_1, EXISTS_FUN_FROM_1] THEN
    REWRITE_TAC [MONOMIAL_DEG_UNIVARIATE, ← GSYM COEFF] THEN
    MESON_TAC [LE_ANTISYM])

  let POLY_DEG_EQ_COEFF ← prove
   r"!r (p:(1->num)->A) n.
        ring_powerseries r p /\
        (!d. ~(coeff d p = ring_0 r) ==> d <= n) /\
        ~(coeff n p = ring_0 r)
        ==> poly_deg r p = n"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q "ring_polynomial r (p:(1->num)->A)") ASSUME_TAC THENL
     [MATCH_MP_TAC RING_POLYNOMIAL_COEFF_BOUND THEN
      EXISTS_TAC (← q "n:num") THEN ASM_REWRITE_TAC [],
      ASM_SIMP_TAC [POLY_DEG_EQ_COEFF_EQ]])

  let POLY_DEG_EQ_FROM_LE ← prove
   r"!r (p:(1->num)->A) n.
        ring_polynomial r p /\
        poly_deg r p <= n /\
        ~(coeff n p = ring_0 r)
        ==> poly_deg r p = n"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [← GSYM LE_ANTISYM] THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC COEFF_NONZERO_LE_DEG THEN ASM_REWRITE_TAC [])

  let COEFF_POWSER_SUM ← prove
   r"!r (p:K->(1->num)->A) d (s:K->bool).
        FINITE s /\ (!x. x IN s ==> ring_powerseries r (p x))
        ==> coeff d (ring_sum (powser_ring r (:1)) s p) =
            ring_sum r s (\x. coeff d (p x))"
   (REWRITE_TAC [IMP_CONJ] THEN REPLICATE_TAC 3 GEN_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES, FORALL_IN_INSERT] THEN
    SIMP_TAC [POWSER_RING, IN_ELIM_THM, COEFF_IN_CARRIER, SUBSET_UNIV] THEN
    SIMP_TAC [COEFF_POLY_0, COEFF_POLY_ADD])

  let COEFF_POLY_SUM ← prove
   r"!r (p:K->(1->num)->A) d (s:K->bool).
        FINITE s /\ (!x. x IN s ==> ring_polynomial r (p x))
        ==> coeff d (ring_sum (poly_ring r (:1)) s p) =
            ring_sum r s (\x. coeff d (p x))"
   (REWRITE_TAC [IMP_CONJ] THEN REPLICATE_TAC 3 GEN_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES, FORALL_IN_INSERT] THEN
    SIMP_TAC [POLY_RING, IN_ELIM_THM, COEFF_IN_CARRIER_ALT, SUBSET_UNIV] THEN
    SIMP_TAC [COEFF_POLY_0, COEFF_POLY_ADD])

  let POLY_DEG_NEG ← prove
   r"!r (p:(V->num)->A).
        ring_polynomial r p ==> poly_deg r (poly_neg r p) = poly_deg r p"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_deg, poly_neg] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    ASM_MESON_TAC [ring_polynomial, ring_powerseries, RING_NEG_EQ_0])

  let POLY_DEG_ADD_LE ← prove
   r"!r (p:(V->num)->A) q.
        ring_polynomial r p /\ ring_polynomial r q
        ==> poly_deg r (poly_add r p q) <= MAX (poly_deg r p) (poly_deg r q)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC POLY_DEG_LE THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_ADD] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          MONOMIAL_DEG_LE_POLY_DEG))) THEN
    ASM_SIMP_TAC [poly_add, POLY_DEG_LE_EQ, ← ARITH_RULE
     (← q r"x <= MAX m n <=> x <= m \/ x <= n")] THEN
    MESON_TAC [RING_ADD_LZERO, RING_0])

  let POLY_DEG_SUB_LE ← prove
   r"!r (p:(V->num)->A) q.
        ring_polynomial r p /\ ring_polynomial r q
        ==> poly_deg r (poly_sub r p q) <= MAX (poly_deg r p) (poly_deg r q)"
   (MESON_TAC [POLY_SUB, POLY_DEG_ADD_LE, POLY_DEG_NEG, RING_POLYNOMIAL_NEG])

  let POLY_DEG_ADD ← prove
   r"!r (p:(V->num)->A) q.
        ring_polynomial r p /\ ring_polynomial r q /\
        ~(poly_deg r p = poly_deg r q)
        ==> poly_deg r (poly_add r p q) = MAX (poly_deg r p) (poly_deg r q)"
   (← do
    -- right to left: the second RING_RULE, then the first
    let r2 ← RING_RULE (← q r"ring_sub r (ring_add r x y) y:A = x")
    let r1 ← RING_RULE (← q r"ring_sub r (ring_add r x y) x:A = y")
    pure (REWRITE_TAC [RING_POLYNOMIAL] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q "r:A ring", ← q r"p:(V->num)->A", ← q r"q:(V->num)->A"]
          POLY_DEG_ADD_LE) THEN
    MP_TAC (← SPECL [← q "r:A ring", ← q r"poly_add r p q:(V->num)->A", ← q r"p:(V->num)->A"]
          POLY_DEG_SUB_LE) THEN
    MP_TAC (← SPECL [← q "r:A ring", ← q r"poly_add r p q:(V->num)->A", ← q r"q:(V->num)->A"]
          POLY_DEG_SUB_LE) THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL] THEN
    ASM_SIMP_TAC [POLY_CLAUSES, RING_ADD, RING_SUB, r1, r2] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN ARITH_TAC))

  let POLY_DEG_SUB ← prove
   r"!r (p:(V->num)->A) q.
        ring_polynomial r p /\ ring_polynomial r q /\
        ~(poly_deg r p = poly_deg r q)
        ==> poly_deg r (poly_sub r p q) = MAX (poly_deg r p) (poly_deg r q)"
   (SIMP_TAC [POLY_SUB, POLY_DEG_NEG] THEN
    ASM_SIMP_TAC [POLY_DEG_ADD, POLY_DEG_NEG, RING_POLYNOMIAL_NEG])

  let POLY_DEG_MUL_LE ← prove
   r"!r (p:(V->num)->A) q.
        ring_polynomial r p /\ ring_polynomial r q
        ==> poly_deg r (poly_mul r p q) <= poly_deg r p + poly_deg r q"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC POLY_DEG_LE THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_MUL] THEN
    X_GEN_TAC (← q r"m:V->num") THEN REWRITE_TAC [poly_mul] THEN
