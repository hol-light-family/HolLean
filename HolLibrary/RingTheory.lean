/- ------------------------------------------------------------------------- -/
/- Gauss's lemma, continued: clearing denominators.                          -/
/- (ringtheory.ml 27716-27986)                                               -/
/- ------------------------------------------------------------------------- -/

structure GaussC where
  -- @@FIELDS
  POLY_CLEAR_DENOMINATORS : thm
  deriving Inhabited

@[nospecialize]
def setupGaussC [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDomains : Domains) (BHoms : Homs) (BRingRule : RingRule) (BSquarefree : Squarefree) (BLocalization : Localization) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BComposing : Composing) :
    ExceptT String IO GaussC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, .. } := D
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IN_ELIM_THM, IN_UNIV, .. } := D.core5
  let { SUBSET, .. } := D.core7
  let { RING_1, RING_ADD, RING_MUL, RING_MUL_LID, TRIVIAL_RING_10, .. } := BBasics
  let { INTEGRAL_DOMAIN_MUL_EQ_0, INTEGRAL_DOMAIN_NONTRIVIAL, INTEGRAL_DOMAIN_REGULAR, .. } := BDomains
  let { RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_MUL,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, ring_homomorphism, .. } := BHoms
  let { RING_RULE, .. } := BRingRule
  let { RING_MULTSYS_REGULAR, .. } := BSquarefree
  let { LOCALEQUIV_MUL_RCANCEL, RING_LOCALIZATION_CARRIER,
        RING_MONOMORPHISM_FRACTIONATE, fraction_ring, .. } := BLocalization
  let { poly_1, .. } := BPowerSeries
  let { POLY_CONST, POLY_CONST_EQ, POLY_CONST_MUL, POLY_RING_CLAUSES,
        POLY_RING_INDUCT_STRONG, POLY_VAR, .. } := BPolyRings
  let { POLY_COMPOSE_HOMOMORPHISM_CONST, POLY_COMPOSE_HOMOMORPHISM_VAR,
        RING_HOMOMORPHISM_POLY_RINGS, .. } := BComposing
  -- @@SCOPE END

  let POLY_CLEAR_DENOMINATORS ← prove
   r"!(r:A ring) q.
     integral_domain r /\
     q IN ring_carrier(poly_ring (fraction_ring r) (:1))
     ==> ?c g. c IN ring_carrier r /\
               ~(c = ring_0 r) /\
               g IN ring_carrier(poly_ring r (:1)) /\
               ring_mul (poly_ring (fraction_ring r) (:1))
                 (poly_const (fraction_ring r)
                   (ring_fractionate r
                     {a | ring_regular r a} c))
                 q =
               ring_fractionate r
                 {a | ring_regular r a} o g"
   (← do
    let clear_denom_subst_tac : tactic :=
      SUBGOAL_THEN
        (← q r"(frc:A->(A#A->bool)) o (g1:(1->num)->A) =
         ring_mul (poly_ring (fraction_ring (r:A ring)) (:1))
