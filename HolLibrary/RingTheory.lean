/- Integral domain and field.  (ringtheory.ml 4638-5077)                     -/
/- ------------------------------------------------------------------------- -/

structure Domains where
  -- @@FIELDS
  integral_domain : thm
  field : thm
  INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING : thm
  FIELD_IMP_NONTRIVIAL_RING : thm
  INTEGRAL_DOMAIN_NONTRIVIAL : thm
  FIELD_NONTRIVIAL : thm
  INTEGRAL_DOMAIN_EQ_NO_ZERODIVISORS : thm
  INTEGRAL_DOMAIN_EQ_ALL_REGULAR : thm
  INTEGRAL_DOMAIN_ZERODIVISOR : thm
  INTEGRAL_DOMAIN_REGULAR : thm
  INTEGRAL_DOMAIN_MUL_EQ_0 : thm
  INTEGRAL_DOMAIN_POW_EQ_0 : thm
  INTEGRAL_DOMAIN_NILPOTENT : thm
  INTEGRAL_DOMAIN_PRODUCT_EQ_0 : thm
  INTEGRAL_DOMAIN_MUL_LCANCEL : thm
  INTEGRAL_DOMAIN_MUL_LCANCEL_EQ : thm
  INTEGRAL_DOMAIN_MUL_RCANCEL : thm
  INTEGRAL_DOMAIN_MUL_RCANCEL_EQ : thm
  INTEGRAL_DOMAIN_DIVIDES_LMUL2 : thm
  INTEGRAL_DOMAIN_DIVIDES_RMUL2 : thm
  INTEGRAL_DOMAIN_ASSOCIATES_LMUL2 : thm
  INTEGRAL_DOMAIN_ASSOCIATES_RMUL2 : thm
  INTEGRAL_DOMAIN_MUL_EQ_SELF : thm
  INTEGRAL_DOMAIN_DIVIDES_MUL_SELF : thm
  INTEGRAL_DOMAIN_DIVIDES_ASSOCIATES_MUL_SELF : thm
  FIELD_EQ_ALL_UNITS : thm
  FIELD_EQ_ALL_DIVIDE_1 : thm
  FIELD_UNIT : thm
  FIELD_MUL_LINV : thm
  FIELD_MUL_RINV : thm
  FIELD_DIVIDES : thm
  FIELD_ASSOCIATES : thm
  FIELD_COPRIME : thm
  FIELD_IMP_INTEGRAL_DOMAIN : thm
  FIELD_ZERODIVISOR : thm
  FIELD_REGULAR : thm
  FIELD_NILPOTENT : thm
  FIELD_MUL_EQ_0 : thm
  FIELD_POW_EQ_0 : thm
  FIELD_PRODUCT_EQ_0 : thm
  FINITE_INTEGRAL_DOMAIN_IMP_FIELD : thm
  FINITE_INTEGRAL_DOMAIN_EQ_FIELD : thm
  INTEGRAL_DOMAIN_CHAR : thm
  RING_CHAR_DIVIDES_MUL : thm
  RING_CHAR_DIVIDES_PRIME : thm
  FINITE_INTEGRAL_DOMAIN_CHAR : thm
  INTEGRAL_DOMAIN_SUBRING_GENERATED : thm
  INTEGRAL_DOMAIN_ASSOCIATES : thm
  INTEGRAL_DOMAIN_10 : thm
  FIELD_10 : thm
  deriving Inhabited

@[nospecialize]
def setupDomains [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BProducts : Products) (BDivides : Divides) (BSubrings : Subrings) :
    ExceptT String IO Domains := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, NUMBER_RULE, SET_TAC,
        new_definition, .. } := D
  let { COND_SWAP, DE_MORGAN_THM, EQ_MULT_LCANCEL, EQ_SYM_EQ, EQ_TRANS,
        EXISTS_IN_INSERT, .. } := D.core2
  let { FINITE_INDUCT_STRONG, FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_EXISTS, MULT_ASSOC, MULT_EQ_0, MULT_EQ_1, NOT_IN_EMPTY, NOT_SUC, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SUBSET, SURJECTIVE_IFF_INJECTIVE,
        SWAP_FORALL_THM, .. } := D.core7
  let { ZERO_ONE_OR_PRIME_DIVPROD, divides, prime, .. } := D.core8
  let { RING_0, RING_1, RING_MUL, RING_MUL_ASSOC, RING_MUL_LID, RING_MUL_LZERO,
        RING_MUL_RID, RING_MUL_RZERO, RING_MUL_SYM, RING_SUB, RING_SUB_EQ_0,
        RING_SUB_LDISTRIB, TRIVIAL_RING_10, .. } := BBasics
  let { RING_CHAR_EQ_1, RING_CHAR_FINITE, RING_OF_NUM, RING_OF_NUM_EQ_0,
        RING_OF_NUM_MUL, RING_POW, ring_pow, .. } := BNumbers
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, .. } := BProducts
  let { RING_ASSOCIATES_0, RING_DIVIDES_LMUL, RING_DIVIDES_LMUL2, RING_DIVIDES_ONE,
        RING_DIVIDES_REFL, RING_DIVIDES_RMUL, RING_DIVIDES_ZERO, RING_MUL_LINV,
        RING_MUL_RINV, RING_UNIT_0, RING_UNIT_1, RING_UNIT_DIVIDES_ALL,
        RING_ZERODIVISOR_0, ring_associates, ring_coprime, ring_divides,
        ring_nilpotent, ring_regular, ring_unit, ring_zerodivisor, .. } := BDivides
  let { RING_CARRIER_SUBRING_GENERATED_SUBSET, SUBRING_GENERATED,
        TRIVIAL_RING_SUBRING_GENERATED, .. } := BSubrings
  -- @@SCOPE END
  let tautConv : ioconv := fun t => (TAUT t).run

  let integral_domain ← new_definition
   r"integral_domain (r:A ring) <=>
        ~(ring_1 r = ring_0 r) /\
        (!x y. x IN ring_carrier r /\
               y IN ring_carrier r /\
               ring_mul r x y = ring_0 r
               ==> x = ring_0 r \/ y = ring_0 r)"

  let field ← new_definition
   r"field (r:A ring) <=>
        ~(ring_1 r = ring_0 r) /\
        !x. x IN ring_carrier r /\ ~(x = ring_0 r)
            ==> ?y. y IN ring_carrier r /\
                    ring_mul r x y = ring_1 r"

  let INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING ← prove
   r"!r:A ring. integral_domain r ==> ~(trivial_ring r)"
   (SIMP_TAC [integral_domain, TRIVIAL_RING_10])

  let FIELD_IMP_NONTRIVIAL_RING ← prove
   r"!r:A ring. field r ==> ~(trivial_ring r)"
   (SIMP_TAC [field, TRIVIAL_RING_10])

  let INTEGRAL_DOMAIN_NONTRIVIAL ← prove
   r"!r:A ring. integral_domain r ==> ~(ring_1 r = ring_0 r)"
   (SIMP_TAC [integral_domain])

  let FIELD_NONTRIVIAL ← prove
   r"!f:A ring. field f ==> ~(ring_1 f = ring_0 f)"
   (SIMP_TAC [field])

  let INTEGRAL_DOMAIN_EQ_NO_ZERODIVISORS ← prove
   r"!r:A ring.
        integral_domain r <=>
        ~(ring_1 r = ring_0 r) /\
        !x. ring_zerodivisor r x ==> x = ring_0 r"
   (REWRITE_TAC [integral_domain, ring_zerodivisor] THEN MESON_TAC [])

  let INTEGRAL_DOMAIN_EQ_ALL_REGULAR ← prove
   r"!r:A ring.
        integral_domain r <=>
        ~(ring_1 r = ring_0 r) /\
        !x. ring_regular r x <=> x IN ring_carrier r /\ ~(x = ring_0 r)"
   (REWRITE_TAC [ring_regular, INTEGRAL_DOMAIN_EQ_NO_ZERODIVISORS] THEN
    MESON_TAC [ring_zerodivisor, RING_ZERODIVISOR_0, TRIVIAL_RING_10])

  let INTEGRAL_DOMAIN_ZERODIVISOR ← prove
   r"!r a:A.
        integral_domain r
        ==> (ring_zerodivisor r a <=> a = ring_0 r)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [INTEGRAL_DOMAIN_EQ_NO_ZERODIVISORS],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [ring_zerodivisor, RING_0] THEN
      ASM_MESON_TAC [integral_domain, RING_1, RING_MUL_LZERO]])

  let INTEGRAL_DOMAIN_REGULAR ← prove
   r"!r a:A. integral_domain r
           ==> (ring_regular r a <=> a IN ring_carrier r /\ ~(a = ring_0 r))"
   (SIMP_TAC [ring_regular, INTEGRAL_DOMAIN_ZERODIVISOR])

  let INTEGRAL_DOMAIN_MUL_EQ_0 ← prove
   r"!r a b:A.
        integral_domain r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_mul r a b = ring_0 r <=> a = ring_0 r \/ b = ring_0 r)"
   (REWRITE_TAC [integral_domain] THEN
    MESON_TAC [RING_MUL_LZERO, RING_MUL_RZERO])

  let INTEGRAL_DOMAIN_POW_EQ_0 ← prove
   r"!r (a:A) n.
        integral_domain r /\ a IN ring_carrier r
        ==> (ring_pow r a n = ring_0 r <=> a = ring_0 r /\ ~(n = 0))"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_MUL_EQ_0, ring_pow, RING_POW, NOT_SUC] THEN
    ASM_MESON_TAC [integral_domain])

  let INTEGRAL_DOMAIN_NILPOTENT ← prove
   r"!r a:A. integral_domain r ==> (ring_nilpotent r a <=> a = ring_0 r)"
   (REWRITE_TAC [ring_nilpotent] THEN
    MESON_TAC [INTEGRAL_DOMAIN_POW_EQ_0, NOT_SUC, RING_0])

  let INTEGRAL_DOMAIN_PRODUCT_EQ_0 ← prove
   r"!r k (f:K->A).
        integral_domain r /\ FINITE k
        ==> (ring_product r k f = ring_0 r <=> ?i. i IN k /\ f i = ring_0 r)"
   (GEN_TAC THEN GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [RING_PRODUCT_CLAUSES, EXISTS_IN_INSERT, NOT_IN_EMPTY] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [integral_domain], ALL_TAC] THEN
    SIMP_TAC [RING_PRODUCT_CLAUSES, COND_SWAP] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_MUL_EQ_0, RING_PRODUCT] THEN
    ASM_MESON_TAC [RING_0])

  let INTEGRAL_DOMAIN_MUL_LCANCEL ← prove
   r"!r a x y:A.
        integral_domain r /\
        a IN ring_carrier r /\ ~(a = ring_0 r) /\
        x IN ring_carrier r /\ y IN ring_carrier r /\
        ring_mul r a x = ring_mul r a y
        ==> x = y"
   (REWRITE_TAC [integral_domain] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "a:A", ← q "ring_sub r x y:A"]) THEN
    ASM_SIMP_TAC [RING_SUB_LDISTRIB, RING_SUB, RING_SUB_EQ_0, RING_MUL])

  let INTEGRAL_DOMAIN_MUL_LCANCEL_EQ ← prove
   r"!r a x y:A.
        integral_domain r /\
        a IN ring_carrier r /\
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_mul r a x = ring_mul r a y <=>
             a = ring_0 r \/ x = y)"
   (MESON_TAC [RING_MUL_LZERO, INTEGRAL_DOMAIN_MUL_LCANCEL])

  let INTEGRAL_DOMAIN_MUL_RCANCEL ← prove
   r"!r a x y:A.
        integral_domain r /\
        a IN ring_carrier r /\ ~(a = ring_0 r) /\
        x IN ring_carrier r /\ y IN ring_carrier r /\
        ring_mul r x a = ring_mul r y a
        ==> x = y"
   (MESON_TAC [INTEGRAL_DOMAIN_MUL_LCANCEL, RING_MUL_SYM])

  let INTEGRAL_DOMAIN_MUL_RCANCEL_EQ ← prove
   r"!r a x y:A.
        integral_domain r /\
        a IN ring_carrier r /\
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_mul r x a = ring_mul r y a <=>
             x = y \/ a = ring_0 r)"
   (MESON_TAC [INTEGRAL_DOMAIN_MUL_LCANCEL_EQ, RING_MUL_SYM])

  let INTEGRAL_DOMAIN_DIVIDES_LMUL2 ← prove
   r"!r a b c:A.
        integral_domain r /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r
        ==> (ring_divides r (ring_mul r a b) (ring_mul r a c) <=>
             a = ring_0 r \/ ring_divides r b c)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q "a:A = ring_0 r") THEN
    ASM_SIMP_TAC [RING_MUL_LZERO, RING_DIVIDES_REFL, RING_0] THEN
    EQ_TAC THEN ASM_SIMP_TAC [RING_DIVIDES_LMUL2] THEN
    ASM_SIMP_TAC [RING_MUL, ring_divides] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q "d:A") THEN ASM_CASES_TAC (← q "(d:A) IN ring_carrier r") THEN
    ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, INTEGRAL_DOMAIN_MUL_LCANCEL_EQ,
                  RING_MUL])

  let INTEGRAL_DOMAIN_DIVIDES_RMUL2 ← prove
   r"!r a b c:A.
        integral_domain r /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r
        ==> (ring_divides r (ring_mul r a c) (ring_mul r b c) <=>
             ring_divides r a b \/ c = ring_0 r)"
   (MESON_TAC [INTEGRAL_DOMAIN_DIVIDES_LMUL2, RING_MUL_SYM])

  let INTEGRAL_DOMAIN_ASSOCIATES_LMUL2 ← prove
   r"!r a b c:A.
        integral_domain r /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r
        ==> (ring_associates r (ring_mul r a b) (ring_mul r a c) <=>
             a = ring_0 r \/ ring_associates r b c)"
   (SIMP_TAC [ring_associates, INTEGRAL_DOMAIN_DIVIDES_LMUL2] THEN
    CONV_TAC tautConv)

  let INTEGRAL_DOMAIN_ASSOCIATES_RMUL2 ← prove
   r"!r a b c:A.
        integral_domain r /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r
        ==> (ring_associates r (ring_mul r a c) (ring_mul r b c) <=>
             ring_associates r a b \/ c = ring_0 r)"
   (SIMP_TAC [ring_associates, INTEGRAL_DOMAIN_DIVIDES_RMUL2] THEN
    CONV_TAC tautConv)

  let INTEGRAL_DOMAIN_MUL_EQ_SELF ← prove
   r"(!r a b:A.
        integral_domain r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_mul r a b = b <=> a = ring_1 r \/ b = ring_0 r)) /\
   (!r a b:A.
        integral_domain r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_mul r a b = a <=> a = ring_0 r \/ b = ring_1 r))"
   (MESON_TAC [INTEGRAL_DOMAIN_MUL_RCANCEL_EQ, INTEGRAL_DOMAIN_MUL_LCANCEL_EQ,
               RING_1, RING_0, RING_MUL_LID, RING_MUL_RID])

  let INTEGRAL_DOMAIN_DIVIDES_MUL_SELF ← prove
   r"(!r a b:A.
        integral_domain r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_divides r (ring_mul r a b) b <=>
             ring_unit r a \/ b = ring_0 r)) /\
   (!r a b:A.
        integral_domain r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_divides r (ring_mul r a b) a <=>
             a = ring_0 r \/ ring_unit r b))"
   (REWRITE_TAC [← GSYM RING_DIVIDES_ONE] THEN
    SIMP_TAC [← GSYM INTEGRAL_DOMAIN_DIVIDES_LMUL2, RING_1, RING_MUL_RID,
              ← GSYM INTEGRAL_DOMAIN_DIVIDES_RMUL2, RING_MUL_LID])

  let INTEGRAL_DOMAIN_DIVIDES_ASSOCIATES_MUL_SELF ← prove
   r"(!r a b:A.
        integral_domain r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_associates r (ring_mul r a b) b <=>
             ring_unit r a \/ b = ring_0 r)) /\
   (!r a b:A.
        integral_domain r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_associates r (ring_mul r a b) a <=>
             a = ring_0 r \/ ring_unit r b)) /\
   (!r a b:A.
        integral_domain r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_associates r b (ring_mul r a b) <=>
             ring_unit r a \/ b = ring_0 r)) /\
   (!r a b:A.
        integral_domain r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_associates r a (ring_mul r a b) <=>
             a = ring_0 r \/ ring_unit r b))"
   (REWRITE_TAC [ring_associates] THEN
    SIMP_TAC [RING_DIVIDES_LMUL, RING_DIVIDES_RMUL, RING_DIVIDES_REFL] THEN
    SIMP_TAC [INTEGRAL_DOMAIN_DIVIDES_MUL_SELF])

  let FIELD_EQ_ALL_UNITS ← prove
   r"!r:A ring.
        field r <=>
        ~(ring_1 r = ring_0 r) /\
        !x. x IN ring_carrier r /\ ~(x = ring_0 r) ==> ring_unit r x"
   (REWRITE_TAC [field, ring_unit] THEN MESON_TAC [])

  let FIELD_EQ_ALL_DIVIDE_1 ← prove
   r"!r:A ring.
        field r <=>
        ~(ring_1 r = ring_0 r) /\
        !a. a IN ring_carrier r /\ ~(a = ring_0 r)
            ==> ring_divides r a (ring_1 r)"
   (REWRITE_TAC [field, ring_divides] THEN MESON_TAC [RING_1])

  let FIELD_UNIT ← prove
   r"!r a:A.
      field r ==> (ring_unit r a <=> a IN ring_carrier r /\ ~(a = ring_0 r))"
   (REWRITE_TAC [field, ← GSYM TRIVIAL_RING_10] THEN
    MESON_TAC [FIELD_EQ_ALL_UNITS, RING_UNIT_0, ring_unit])

  let FIELD_MUL_LINV ← prove
   r"!r a:A. field r /\ a IN ring_carrier r /\ ~(a = ring_0 r)
           ==> ring_mul r (ring_inv r a) a = ring_1 r"
   (SIMP_TAC [FIELD_UNIT, RING_MUL_LINV])

  let FIELD_MUL_RINV ← prove
   r"!r a:A. field r /\ a IN ring_carrier r /\ ~(a = ring_0 r)
           ==> ring_mul r a (ring_inv r a) = ring_1 r"
   (SIMP_TAC [FIELD_UNIT, RING_MUL_RINV])

  let FIELD_DIVIDES ← prove
   r"!r a b:A.
        field r
        ==> (ring_divides r a b <=>
             a IN ring_carrier r /\ b IN ring_carrier r /\
             (a = ring_0 r ==> b = ring_0 r))"
   (MESON_TAC [RING_UNIT_DIVIDES_ALL, FIELD_UNIT,
               RING_DIVIDES_ZERO, ring_divides])

  let FIELD_ASSOCIATES ← prove
   r"!r a b:A.
        field r
        ==> (ring_associates r a b <=>
             a IN ring_carrier r /\ b IN ring_carrier r /\
             (a = ring_0 r <=> b = ring_0 r))"
   (SIMP_TAC [ring_associates, FIELD_DIVIDES] THEN MESON_TAC [])

  let FIELD_COPRIME ← prove
   r"!r a b:A.
        field r
        ==> (ring_coprime r (a,b) <=>
             a IN ring_carrier r /\ b IN ring_carrier r /\
             ~(a = ring_0 r /\ b = ring_0 r))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [ring_coprime, FIELD_DIVIDES, FIELD_UNIT] THEN
    MESON_TAC [RING_0])

  let FIELD_IMP_INTEGRAL_DOMAIN ← prove
   r"!r:A ring. field r ==> integral_domain r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [field, integral_domain] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "y:A")) THEN
    ASM_CASES_TAC (← q "y:A = ring_0 r") THEN ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "y':A") THEN STRIP_TAC THEN
    TRANS_TAC EQ_TRANS (← q "ring_mul r x (ring_mul r y y'):A") THEN
    CONJ_TAC THENL [ASM_SIMP_TAC [RING_MUL_RID], ALL_TAC] THEN
    ASM_SIMP_TAC [RING_MUL_ASSOC, RING_MUL, RING_MUL_LZERO])

  let FIELD_ZERODIVISOR ← prove
   r"!r a:A. field r ==> (ring_zerodivisor r a <=> a = ring_0 r)"
   (SIMP_TAC [INTEGRAL_DOMAIN_ZERODIVISOR, FIELD_IMP_INTEGRAL_DOMAIN])

  let FIELD_REGULAR ← prove
   r"!r a:A. field r
           ==> (ring_regular r a <=> a IN ring_carrier r /\ ~(a = ring_0 r))"
   (SIMP_TAC [ring_regular, FIELD_ZERODIVISOR])

  let FIELD_NILPOTENT ← prove
   r"!r a:A. field r ==> (ring_nilpotent r a <=> a = ring_0 r)"
   (SIMP_TAC [INTEGRAL_DOMAIN_NILPOTENT, FIELD_IMP_INTEGRAL_DOMAIN])

  let FIELD_MUL_EQ_0 ← prove
   r"!r a b:A.
        field r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_mul r a b = ring_0 r <=> a = ring_0 r \/ b = ring_0 r)"
   (SIMP_TAC [INTEGRAL_DOMAIN_MUL_EQ_0, FIELD_IMP_INTEGRAL_DOMAIN])

  let FIELD_POW_EQ_0 ← prove
   r"!r (a:A) n.
        field r /\ a IN ring_carrier r
        ==> (ring_pow r a n = ring_0 r <=> a = ring_0 r /\ ~(n = 0))"
   (SIMP_TAC [INTEGRAL_DOMAIN_POW_EQ_0, FIELD_IMP_INTEGRAL_DOMAIN])

  let FIELD_PRODUCT_EQ_0 ← prove
   r"!r k (f:K->A).
        field r /\ FINITE k
        ==> (ring_product r k f = ring_0 r <=> ?i. i IN k /\ f i = ring_0 r)"
   (SIMP_TAC [INTEGRAL_DOMAIN_PRODUCT_EQ_0, FIELD_IMP_INTEGRAL_DOMAIN])

  let FINITE_INTEGRAL_DOMAIN_IMP_FIELD ← prove
   r"!r:A ring. FINITE(ring_carrier r) /\ integral_domain r ==> field r"
   (GEN_TAC THEN REWRITE_TAC [integral_domain, field] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"ring_carrier r:A->bool",
      ← q r"\x:A. ring_mul r a x"] SURJECTIVE_IFF_INJECTIVE) THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, RING_MUL] THEN
    DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).2)) THEN
    ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC [RING_1]] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_DOMAIN_MUL_LCANCEL THEN
    EXISTS_TAC (← q "r:A ring") THEN ASM_REWRITE_TAC [integral_domain] THEN
    ASM_MESON_TAC [])

  let FINITE_INTEGRAL_DOMAIN_EQ_FIELD ← prove
   r"!r:A ring.
        FINITE(ring_carrier r) ==> (integral_domain r <=> field r)"
   (MESON_TAC [FINITE_INTEGRAL_DOMAIN_IMP_FIELD, FIELD_IMP_INTEGRAL_DOMAIN])

  let INTEGRAL_DOMAIN_CHAR ← prove
   r"!r:A ring.
        integral_domain r ==> ring_char r = 0 \/ prime(ring_char r)"
   (← do
    -- right to left: the two ARITH_RULEs, last first, then the NUMBER_RULE
    let a2 ← ARITH_RULE (← q "m = m * n <=> m * n = m * 1")
    let a1 ← ARITH_RULE (← q "n:num = m * n * d <=> n = n * m * d")
    let n1 ← NUMBER_RULE (← q "!n:num. n divides n")
    pure (REWRITE_TAC [integral_domain, ← GSYM TRIVIAL_RING_10] THEN REPEAT STRIP_TAC THEN
      ASM_REWRITE_TAC [prime, RING_CHAR_EQ_1] THEN
      ASM_CASES_TAC (← q "ring_char(r:A ring) = 0") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [divides, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q "m:num", ← q "n:num"] THEN DISCH_THEN (ASSUME_TAC o SYM) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q "ring_of_num r m:A", ← q "ring_of_num r n:A"]) THEN
      ASM_REWRITE_TAC [RING_OF_NUM, ← GSYM RING_OF_NUM_MUL] THEN
      REWRITE_TAC [RING_OF_NUM_EQ_0, n1] THEN
      FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [MULT_EQ_0, DE_MORGAN_THM]) THEN
      ASM_REWRITE_TAC [divides, ← GSYM MULT_ASSOC] THEN
      REWRITE_TAC [a1] THEN
      REWRITE_TAC [a2] THEN
      ASM_REWRITE_TAC [EQ_MULT_LCANCEL, MULT_EQ_1] THEN MESON_TAC []))

  let RING_CHAR_DIVIDES_MUL ← prove
   r"!(r:A ring) m n.
        integral_domain r \/ field r
        ==> (ring_char r divides m * n <=>
             ring_char r divides m \/ ring_char r divides n)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← TAUT
     (← q r"(q ==> p) /\ (p ==> r) ==> (p \/ q ==> r)")) THEN
    REWRITE_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o MATCH_MP INTEGRAL_DOMAIN_CHAR) THEN
    ASM_MESON_TAC [ZERO_ONE_OR_PRIME_DIVPROD])

  let RING_CHAR_DIVIDES_PRIME ← prove
   r"!(r:A ring) p.
        (integral_domain r \/ field r) /\ prime p
        ==> (ring_char r divides p <=> ring_char r = p)"
   (← do
    -- right to left: the two NUMBER_RULEs, last first, then the TAUT
    let n2 ← NUMBER_RULE (← q "0 divides n <=> n = 0")
    let n1 ← NUMBER_RULE (← q "(n:num) divides n")
    let t1 ← TAUT (← q r"(q ==> p) /\ (p ==> r) ==> (p \/ q ==> r)")
    pure (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      MATCH_MP_TAC t1 THEN
      REWRITE_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o MATCH_MP INTEGRAL_DOMAIN_CHAR) THEN
      ASM_MESON_TAC [prime, n1, n2]))

  let FINITE_INTEGRAL_DOMAIN_CHAR ← prove
   r"!r:A ring.
        integral_domain r /\ FINITE(ring_carrier r) ==> prime(ring_char r)"
   (MESON_TAC [RING_CHAR_FINITE, INTEGRAL_DOMAIN_CHAR])

  let INTEGRAL_DOMAIN_SUBRING_GENERATED ← prove
   r"!r s:A->bool.
        integral_domain r ==> integral_domain (subring_generated r s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [integral_domain, ← GSYM TRIVIAL_RING_10] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [TRIVIAL_RING_SUBRING_GENERATED] THEN
    REWRITE_TAC [← CONJUNCT2 SUBRING_GENERATED] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:A->bool"]
          RING_CARRIER_SUBRING_GENERATED_SUBSET) THEN
    ASM SET_TAC [])

  let INTEGRAL_DOMAIN_ASSOCIATES ← prove
   r"!r a b:A.
        integral_domain r
        ==> (ring_associates r a b <=>
             a IN ring_carrier r /\ b IN ring_carrier r /\
             ?u. ring_unit r u /\ ring_mul r a u = b)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q "a:A = ring_0 r") THENL
     [ASM_REWRITE_TAC [RING_0, RING_ASSOCIATES_0] THEN
      ASM_MESON_TAC [RING_MUL_LZERO, RING_UNIT_1, RING_0, ring_unit],
      ALL_TAC] THEN
    REWRITE_TAC [ring_associates, ring_divides] THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q "(b:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, ring_unit] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_AND_EXISTS_THM] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q "u:A") THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q "v:A") THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [MATCH_MP_TAC INTEGRAL_DOMAIN_MUL_LCANCEL THEN
      MAP_EVERY EXISTS_TAC [← q "r:A ring", ← q "a:A"] THEN
      ASM_SIMP_TAC [RING_MUL_ASSOC, RING_1, RING_MUL, RING_MUL_RID],
      UNDISCH_THEN (← q "ring_mul r a u:A = b") (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, RING_MUL_RID]])

  let INTEGRAL_DOMAIN_10 ← prove
   r"!r:A ring.
        ring_carrier r = {ring_0 r,ring_1 r}
        ==> (integral_domain r <=> ~(ring_1 r = ring_0 r))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [integral_domain, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
    SIMP_TAC [RING_1, RING_MUL_LID])

  let FIELD_10 ← prove
   r"!r:A ring.
        ring_carrier r = {ring_0 r,ring_1 r}
        ==> (field r <=> ~(ring_1 r = ring_0 r))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [field, IMP_CONJ] THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, EXISTS_IN_INSERT, NOT_IN_EMPTY] THEN
    SIMP_TAC [RING_1, RING_MUL_LID])

  -- @@RETURN BEGIN
  return { integral_domain, field, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING,
           FIELD_IMP_NONTRIVIAL_RING, INTEGRAL_DOMAIN_NONTRIVIAL, FIELD_NONTRIVIAL,
           INTEGRAL_DOMAIN_EQ_NO_ZERODIVISORS, INTEGRAL_DOMAIN_EQ_ALL_REGULAR,
           INTEGRAL_DOMAIN_ZERODIVISOR, INTEGRAL_DOMAIN_REGULAR,
           INTEGRAL_DOMAIN_MUL_EQ_0, INTEGRAL_DOMAIN_POW_EQ_0, INTEGRAL_DOMAIN_NILPOTENT,
           INTEGRAL_DOMAIN_PRODUCT_EQ_0, INTEGRAL_DOMAIN_MUL_LCANCEL,
           INTEGRAL_DOMAIN_MUL_LCANCEL_EQ, INTEGRAL_DOMAIN_MUL_RCANCEL,
           INTEGRAL_DOMAIN_MUL_RCANCEL_EQ, INTEGRAL_DOMAIN_DIVIDES_LMUL2,
           INTEGRAL_DOMAIN_DIVIDES_RMUL2, INTEGRAL_DOMAIN_ASSOCIATES_LMUL2,
           INTEGRAL_DOMAIN_ASSOCIATES_RMUL2, INTEGRAL_DOMAIN_MUL_EQ_SELF,
           INTEGRAL_DOMAIN_DIVIDES_MUL_SELF, INTEGRAL_DOMAIN_DIVIDES_ASSOCIATES_MUL_SELF,
           FIELD_EQ_ALL_UNITS, FIELD_EQ_ALL_DIVIDE_1, FIELD_UNIT, FIELD_MUL_LINV,
           FIELD_MUL_RINV, FIELD_DIVIDES, FIELD_ASSOCIATES, FIELD_COPRIME,
           FIELD_IMP_INTEGRAL_DOMAIN, FIELD_ZERODIVISOR, FIELD_REGULAR, FIELD_NILPOTENT,
           FIELD_MUL_EQ_0, FIELD_POW_EQ_0, FIELD_PRODUCT_EQ_0,
           FINITE_INTEGRAL_DOMAIN_IMP_FIELD, FINITE_INTEGRAL_DOMAIN_EQ_FIELD,
           INTEGRAL_DOMAIN_CHAR, RING_CHAR_DIVIDES_MUL, RING_CHAR_DIVIDES_PRIME,
           FINITE_INTEGRAL_DOMAIN_CHAR, INTEGRAL_DOMAIN_SUBRING_GENERATED,
           INTEGRAL_DOMAIN_ASSOCIATES, INTEGRAL_DOMAIN_10, FIELD_10 }
  -- @@RETURN END

/-- `try x with Failure _ -> h ()`: OCaml's `Failure` handlers do not catch
    `Match_failure` or `Invalid_argument`. -/
def tryF {α : Type} (x : ExceptT String IO α) (h : Unit → ExceptT String IO α) :
    ExceptT String IO α :=
  tryCatch x (fun e =>
    if e == "Match_failure" || e.startsWith "Invalid_argument " then throw e else h ())

/-- The partial rules `RING_CARRIER_RULE` builds once (ringtheory.ml 5084-5094). -/
structure CarrierRules where
  (rule_0 rule_1 rule_n rule_z rule_neg rule_inv rule_pow rule_add rule_sub rule_mul
   rule_div : term → ExceptT String IO thm)

/-- `RING_CARRIER_RULE asm`'s `rule` (ringtheory.ml 5096-5124). -/
partial def carrierRule [HolBase] (C : CarrierRules) (asm : List thm) (tm : term) :
    ExceptT String IO thm :=
  let rule_nullary (tm : term) : ExceptT String IO thm :=
    tryF (liftExcept (find (fun a => concl a == tm) asm)) fun _ =>
    tryF (C.rule_0 tm) fun _ =>
    tryF (C.rule_1 tm) fun _ =>
    tryF (C.rule_n tm) fun _ =>
    C.rule_z tm
  let rule_unary (tm : term) : ExceptT String IO thm :=
    tryF (C.rule_neg tm) fun _ =>
    tryF (C.rule_inv tm) fun _ =>
    C.rule_pow tm
  let rule_binary (tm : term) : ExceptT String IO thm :=
    tryF (C.rule_add tm) fun _ =>
    tryF (C.rule_sub tm) fun _ =>
    tryF (C.rule_mul tm) fun _ =>
    C.rule_div tm
  tryF (rule_nullary tm) fun _ =>
  tryF (do
    let th ← rule_unary tm
    MP th (← carrierRule C asm (← liftExcept (lhand (concl th))))) fun _ =>
  tryF (do
    let th ← rule_binary tm
    -- `CONJ a b`: right to left
    let b ← carrierRule C asm (← liftExcept (do rand (← lhand (concl th))))
    let a ← carrierRule C asm (← liftExcept (do lhand (← lhand (concl th))))
    MP th (← CONJ a b)) fun _ =>
  ASSUME tm

/-- `repeat UNDISCH` (lib.ml `repeat`): undischarge until it fails. -/
partial def repeatUndisch [HolBase] (th : thm) : ExceptT String IO thm :=
  tryF (do repeatUndisch (← UNDISCH th)) (fun _ => pure th)

/- ------------------------------------------------------------------------- -/
/- Rule and tactic methods of proving carrier membership by backchaining;    -/
/- the normalizer and ring procedure for a ring with the whole type as its   -/
/- carrier.  (ringtheory.ml 5078-5320)                                       -/
/- ------------------------------------------------------------------------- -/

structure Rules where
  -- @@FIELDS
  RING_CARRIER_RULE : List thm → term → ExceptT String IO thm
  RING_CARRIER_TAC : tactic
  RING_POLY_UNIVERSAL_CONV : ioconv
  RING_INTEGRAL_DOMAIN_UNIVERSAL : (term → ExceptT String IO thm)
  ring_ring_cofactors_universal : (List term → term → IO (Except String (List term)))
  deriving Inhabited

@[nospecialize]
def setupRules [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BDomains : Domains) :
    ExceptT String IO Rules := do
  -- @@SCOPE BEGIN
  let { INTEGER_RULE, INT_ADD_CONV, INT_MUL_CONV, INT_POW_CONV, INT_SUB_CONV,
        RING_AND_IDEAL_CONV, SEMIRING_NORMALIZERS_CONV, mk_intconst, .. } := D
  let { IMP_CONJ, .. } := D.core4
  let { IN_UNIV, .. } := D.core5
  let { TRUTH, .. } := D.core7
  let { num_divides, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_AC, RING_ADD_LCANCEL, RING_ADD_LDISTRIB,
        RING_ADD_LZERO, RING_ADD_RDISTRIB, RING_MUL, RING_MUL_AC, RING_MUL_LID,
        RING_MUL_LNEG, RING_MUL_LZERO, RING_MUL_RNEG, RING_NEG, RING_NEG_ADD,
        RING_NEG_NEG, RING_SUB, RING_SUB_EQ_0, ring_sub, .. } := BBasics
  let { RING_OF_INT, RING_OF_INT_ADD, RING_OF_INT_EQ, RING_OF_INT_MUL, RING_OF_INT_NEG,
        RING_OF_INT_OF_NUM, RING_OF_INT_POW, RING_OF_NUM, RING_OF_NUM_0, RING_OF_NUM_1,
        RING_POW, ring_of_num, ring_pow, .. } := BNumbers
  let { RING_DIV, RING_INV, .. } := BDivides
  let { INTEGRAL_DOMAIN_MUL_EQ_0, integral_domain, .. } := BDomains
  -- @@SCOPE END

  let RING_CARRIER_RULE : List thm → term → ExceptT String IO thm ← do
    let C : CarrierRules :=
      ⟨PART_MATCH pure RING_0, PART_MATCH pure RING_1, PART_MATCH pure RING_OF_NUM,
       PART_MATCH pure RING_OF_INT, PART_MATCH rand RING_NEG, PART_MATCH rand RING_INV,
       PART_MATCH rand RING_POW, PART_MATCH rand RING_ADD, PART_MATCH rand RING_SUB,
       PART_MATCH rand RING_MUL, PART_MATCH rand RING_DIV⟩
    pure (fun asm tm => do
      match tm with
      | .Comb (.Comb (.Const "IN" _) _) (.Comb (.Const "ring_carrier" _) _) =>
        carrierRule C asm tm
      | _ => throw "RING_CARRIER_RULE")

  let RING_CARRIER_TAC : tactic ← do
    let tac_0 := MATCH_ACCEPT_TAC RING_0
    let tac_1 := MATCH_ACCEPT_TAC RING_1
    let tac_n := MATCH_ACCEPT_TAC RING_OF_NUM
    let tac_z := MATCH_ACCEPT_TAC RING_OF_INT
    let tac_neg := MATCH_MP_TAC RING_NEG
    let tac_inv := MATCH_MP_TAC RING_INV
    let tac_pow := MATCH_MP_TAC RING_POW
    let tac_add := MATCH_MP_TAC RING_ADD
    let tac_sub := MATCH_MP_TAC RING_SUB
    let tac_mul := MATCH_MP_TAC RING_MUL
    let tac_div := MATCH_MP_TAC RING_DIV
    let tac_nullary := tac_0 ORELSE tac_1 ORELSE tac_n ORELSE tac_z
    let tac_unary := tac_neg ORELSE tac_inv ORELSE tac_pow
    let tac_binary := tac_add ORELSE tac_sub ORELSE tac_mul ORELSE tac_div
    let base_tac :=
      FIRST_ASSUM ACCEPT_TAC ORELSE
      tac_nullary ORELSE tac_unary ORELSE (tac_binary THEN CONJ_TAC)
    let pat ← q r"(x:A) IN ring_carrier r"
    let checker (w : term) : IO Bool := do
      match ← (term_match [] pat w).run with
      | .ok _ => pure true
      | .error _ => pure false
    pure ((fun g => do (if ← checker g.2 then ALL_TAC else NO_TAC) g) THEN
      REPEAT (base_tac ORELSE
             (FIRST_ASSUM (fun th => tactic_of do
                pure (GEN_REWRITE_TAC LAND_CONV [← SYM th])) THEN
              base_tac)))

  -- Instantiate the normalizer and ring procedure for the case of a ring
  -- "r:A ring" with the whole type A as the carrier.

  let RING_POLY_UNIVERSAL_CONV : ioconv ← do
    -- `let pth = ... and sth = ... and RING_INT_ADD_CONV = ... and ... and
    -- ith = ...`, left to right
    let pth ← UNDISCH (← SPEC_ALL (← prove
     r"!r. ring_carrier r = (:A)
          ==> (!x y z. ring_add r x (ring_add r y z) =
                       ring_add r (ring_add r x y) z) /\
              (!x y. ring_add r x y = ring_add r y x) /\
              (!x. ring_add r (ring_of_int r (&0)) x = x) /\
              (!x y z. ring_mul r x (ring_mul r y z) =
                       ring_mul r (ring_mul r x y) z) /\
              (!x y. ring_mul r x y = ring_mul r y x) /\
              (!x. ring_mul r (ring_of_int r (&1)) x = x) /\
              (!x. ring_mul r (ring_of_int r (&0)) x = ring_of_int r (&0)) /\
              (!x y z. ring_mul r x (ring_add r y z) =
                       ring_add r (ring_mul r x y) (ring_mul r x z)) /\
              (!x. ring_pow r x 0 = ring_of_int r (&1)) /\
              (!x n. ring_pow r x (SUC n) = ring_mul r x (ring_pow r x n))"
     (REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_1, ← CONJUNCT1 ring_of_num] THEN
      SIMP_TAC [RING_ADD_LZERO, RING_MUL_LID, RING_MUL_LZERO, IN_UNIV] THEN
      SIMP_TAC [ring_pow, RING_ADD_LDISTRIB, IN_UNIV] THEN
      SIMP_TAC [RING_ADD_AC, RING_MUL_AC, IN_UNIV])))
    let sth ← UNDISCH (← SPEC_ALL (← prove
     r"!r. ring_carrier r = (:A)
          ==> (!x. ring_neg r x = ring_mul r (ring_of_int r (-- &1)) x) /\
              (!x y. ring_sub r x y =
                     ring_add r x (ring_mul r (ring_of_int r (-- &1)) y))"
     (SIMP_TAC [RING_OF_INT_NEG, RING_MUL_LNEG, IN_UNIV, ring_sub] THEN
      REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_1, ← CONJUNCT1 ring_of_num] THEN
      SIMP_TAC [ring_sub, RING_MUL_LNEG, RING_MUL_LID, IN_UNIV])))
    let RING_INT_ADD_CONV : ioconv :=
      GEN_REWRITE_CONV id [← GSYM RING_OF_INT_ADD] THENC RAND_CONV INT_ADD_CONV
    let RING_INT_MUL_CONV : ioconv :=
      GEN_REWRITE_CONV id [← GSYM RING_OF_INT_MUL] THENC RAND_CONV INT_MUL_CONV
    let RING_INT_POW_CONV : ioconv :=
      GEN_REWRITE_CONV id [← GSYM RING_OF_INT_POW] THENC RAND_CONV INT_POW_CONV
    let is_ringconst (tm : term) : Bool :=
      match tm with
      | .Comb (.Comb (.Const "ring_of_int" _) _) n => HolMath.Int.is_intconst n
      | _ => false
    let ith ← prove
     r"ring_0 r = ring_of_int r (&0) /\
     ring_1 r = ring_of_int r (&1)"
     (REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_1, ← CONJUNCT1 ring_of_num])
    let (_, _, _, _, _, RING_POLY_CONV) ← SEMIRING_NORMALIZERS_CONV pth sth
     (is_ringconst, RING_INT_ADD_CONV, RING_INT_MUL_CONV, RING_INT_POW_CONV)
     HolMath.RealArith.term_lt
    pure (GEN_REWRITE_CONV ONCE_DEPTH_CONV [ith, ← GSYM RING_OF_INT_OF_NUM] THENC
      RING_POLY_CONV)

  let (RING_INTEGRAL_DOMAIN_UNIVERSAL, ring_ring_cofactors_universal) : (term → ExceptT String IO thm) × (List term → term → IO (Except String (List term))) ← do
    -- `let RING_INTEGRAL = ... and neth_b = ... and ... and neth_h = ...`,
    -- left to right
    let RING_INTEGRAL ← repeatUndisch (← prove
     r"integral_domain r
     ==> ring_carrier r = (:A)
         ==> (!x. ring_mul r (ring_of_int r (&0)) x = ring_of_int r (&0)) /\
             (!x y z. ring_add r x y = ring_add r x z <=> y = z) /\
             (!w x y z.
                      ring_add r (ring_mul r w y) (ring_mul r x z) =
                      ring_add r (ring_mul r w z) (ring_mul r x y) <=>
                      w = x \/ y = z)"
     (REPEAT GEN_TAC THEN REPEAT DISCH_TAC THEN
      REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_0] THEN
      ASM_SIMP_TAC [RING_MUL_LZERO, RING_ADD_LCANCEL, IN_UNIV] THEN
      REPEAT GEN_TAC THEN
      MP_TAC (← ISPEC (← q "r:A ring") RING_SUB_EQ_0) THEN
      ASM_REWRITE_TAC [IN_UNIV] THEN
      DISCH_THEN (fun th => tactic_of do pure (ONCE_REWRITE_TAC [← GSYM th])) THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            INTEGRAL_DOMAIN_MUL_EQ_0)) THEN
      ASM_REWRITE_TAC [IN_UNIV] THEN
      DISCH_THEN (fun th => tactic_of do pure (ONCE_REWRITE_TAC [← GSYM th])) THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [ring_sub, IN_UNIV, RING_ADD_LDISTRIB, RING_ADD_RDISTRIB,
                    RING_NEG_NEG, RING_NEG_ADD, RING_MUL_LNEG, RING_MUL_RNEG] THEN
      ASM_SIMP_TAC [RING_MUL_AC, IN_UNIV] THEN
      ASM_SIMP_TAC [RING_ADD_AC, IN_UNIV]))
    let neth_b ← prove
     r"ring_of_int r n :A = ring_of_int r n <=> T"
     (REWRITE_TAC [])
    let neth_l ← UNDISCH (← prove
     r"integral_domain (r:A ring)
     ==> (ring_of_int r (&1) = ring_of_int r (&0) <=> F)"
     (REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_0, RING_OF_NUM_1] THEN
      SIMP_TAC [integral_domain]))
    let neth_r ← UNDISCH (← prove
     r"integral_domain (r:A ring)
     ==> (ring_of_int r (&0) = ring_of_int r (&1) <=> F)"
     (REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_0, RING_OF_NUM_1] THEN
      SIMP_TAC [integral_domain]))
    let neth_g ← prove
     r"(ring_of_int r m :A = ring_of_int r n <=> F) <=>
     ~(&(ring_char r) divides (m - n))"
     (REWRITE_TAC [RING_OF_INT_EQ] THEN CONV_TAC (fun t => (INTEGER_RULE t).run))
    let neth_h ← prove
     r"(&(ring_char(r:A ring)) divides --(&n) <=> ring_char r divides n) /\
     (&(ring_char(r:A ring)) divides &n <=> ring_char r divides n)"
     (REWRITE_TAC [num_divides] THEN CONV_TAC (fun t => (INTEGER_RULE t).run))
    -- `let rule1 = ... and conv1 = ...`
    let rule1 := PART_MATCH (fun t => do lhand (← lhand t)) neth_g
    let conv1 : ioconv :=
      RAND_CONV INT_SUB_CONV THENC GEN_REWRITE_CONV TRY_CONV [neth_h]
    -- `let RING_EQ_CONV = ... and dest_ringconst = ... and mk_ringconst = ...`
    let RING_EQ_CONV : ioconv := fun tm => ExceptT.run (
      tryF (PART_MATCH lhand neth_b tm) fun _ =>
      tryF (PART_MATCH lhand neth_l tm) fun _ =>
      tryF (PART_MATCH lhand neth_r tm) fun _ =>
      tryF (do
        let th1 ← rule1 tm
        let th2 ← CONV_RULE (RAND_CONV (RAND_CONV conv1)) th1
        UNDISCH (← EQ_IMP_RULE th2).2) fun _ =>
      throw "RING_EQ_CONV")
    let dest_ringconst (tm : term) : Except String Rat :=
      match tm with
      | .Comb (.Comb (.Const "ring_of_int" _) _) n => HolMath.Int.dest_intconst n
      | _ => failwith "dest_ringconst"
    let ptm ← q "ring_of_int (r:A ring)"
    let mk_ringconst (n : Rat) : Except String term := do mk_comb ptm (← mk_intconst n)
    let cth ← prove
     r"ring_0 r:A = ring_of_int r (&0) /\
     ring_1 r:A = ring_of_int r (&1)"
     (REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_0, RING_OF_NUM_1])
    let decorule : ioconv :=
      GEN_REWRITE_CONV ONCE_DEPTH_CONV [cth, ← GSYM RING_OF_INT_OF_NUM]
    -- the parameter tuple, right to left
    let t_pow ← q "ring_pow(r:A ring)"
    let t_div ← q "ring_div(r:A ring)"
    let t_mul ← q "ring_mul(r:A ring)"
    let t_inv ← q "ring_inv(r:A ring)"
    let t_sub ← q "ring_sub(r:A ring)"
    let t_add ← q "ring_add(r:A ring)"
    let t_neg ← q "ring_neg(r:A ring)"
    let (basic_rule, idealconv) ← RING_AND_IDEAL_CONV
      { ring_dest_const := dest_ringconst, ring_mk_const := mk_ringconst,
        RING_EQ_CONV := RING_EQ_CONV, ring_neg_tm := t_neg, ring_add_tm := t_add,
        ring_sub_tm := t_sub, ring_inv_tm := t_inv, ring_mul_tm := t_mul,
        ring_div_tm := t_div, ring_pow_tm := t_pow, RING_INTEGRAL := RING_INTEGRAL,
        RABINOWITSCH_THM := TRUTH, RING_NORMALIZE_CONV := RING_POLY_UNIVERSAL_CONV }
    let rule (tm : term) : ExceptT String IO thm := do
      let th ← ExceptT.mk (decorule tm)
      EQ_MP (← SYM th) (← ExceptT.mk (basic_rule (← liftExcept (rand (concl th)))))
    pure (rule, idealconv)

  -- @@RETURN BEGIN
  return { RING_CARRIER_RULE, RING_CARRIER_TAC, RING_POLY_UNIVERSAL_CONV,
           RING_INTEGRAL_DOMAIN_UNIVERSAL, ring_ring_cofactors_universal }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Homomorphisms etc.  (ringtheory.ml 5321-6413)                             -/
/- ------------------------------------------------------------------------- -/

structure Homs where
  -- @@FIELDS
  ring_homomorphism : thm
  ring_monomorphism : thm
  ring_epimorphism : thm
  ring_endomorphism : thm
  ring_isomorphisms : thm
  ring_isomorphism : thm
  ring_automorphism : thm
  RING_HOMOMORPHISM_EQ : thm
  RING_MONOMORPHISM_EQ : thm
  RING_EPIMORPHISM_EQ : thm
