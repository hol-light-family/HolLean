    REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_GSPEC] THEN
    SIMP_TAC [POLY_CONST, POLY_VAR] THEN ASM_REWRITE_TAC [])

  let POLY_SUBRING_GENERATED_1 ← prove
   r"!(r:A ring).
        subring_generated (poly_ring r (:1))
         (poly_var r one INSERT IMAGE (poly_const r) (ring_carrier r)) =
        poly_ring r (:1)"
   (GEN_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM POLY_SUBRING_GENERATED] THEN
    AP_TERM_TAC THEN REWRITE_TAC [UNIV_1] THEN SET_TAC [])

  let IMAGE_POLY_EXTEND ← prove
   r"!(f:A->B) k l (s:V->bool) a.
        ring_homomorphism(k,l) f /\
        (!i. i IN s ==> a i IN ring_carrier l)
        ==> IMAGE (poly_extend(k,l) f a) (ring_carrier(poly_ring k s)) =
            ring_carrier
             (subring_generated l (IMAGE a s UNION IMAGE f (ring_carrier k)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"poly_ring (k:A ring) (s:V->bool)", ← q "l:B ring",
                   ← q r"poly_extend(k,l) (f:A->B) (a:V->B)",
                   ← q r"{poly_const (k:A ring) c | c | c IN ring_carrier k} UNION
                    {poly_var k (x:V) | x IN s}"]
          SUBRING_GENERATED_BY_HOMOMORPHIC_IMAGE) THEN
    REWRITE_TAC [POLY_SUBRING_GENERATED] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_UNION, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [RING_HOMOMORPHISM_POLY_EXTEND, POLY_VAR, POLY_CONST] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [IMAGE_UNION, ← GSYM IMAGE_o, SIMPLE_IMAGE] THEN
    GEN_REWRITE_TAC RAND_CONV [UNION_COMM] THEN BINOP_TAC THEN
    MATCH_MP_TAC IMAGE_EQ THEN
    ASM_SIMP_TAC [POLY_EXTEND_VAR, POLY_EXTEND_CONST, o_THM])

  let IMAGE_POLY_EXTEND_1 ← prove
   r"!(f:A->B) k l a.
        ring_homomorphism(k,l) f /\ a IN ring_carrier l
        ==> IMAGE (poly_extend(k,l) f (\v. a))
                  (ring_carrier(poly_ring k (:1))) =
            ring_carrier
             (subring_generated l (a INSERT IMAGE f (ring_carrier k)))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [IMAGE_POLY_EXTEND] THEN
    REWRITE_TAC [UNIV_1, IMAGE_CLAUSES] THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let POLY_EXTEND_INTO_SUBRING_GENERATED ← prove
   r"!r r' s (h:A->B) v (x:V->B) p.
        p IN ring_carrier(poly_ring r v) /\
        ring_homomorphism(r,subring_generated r' s) h /\
        (!i. i IN v ==> x i IN ring_carrier(subring_generated r' s))
        ==> poly_extend (r,subring_generated r' s) h x p =
            poly_extend (r,r') h x p"
   (← do
    -- right to left: the TAUT, the SET_RULE, then the MESON
    let tt ← TAUT (← q r"(p ==> r) ==> p /\ ~(p /\ r) ==> s")
    let sr ← SET_RULE (← q r"{x | P x /\ Q x} = {x | P x} <=> !x. P x ==> Q x")
    let mm ← MESON [RING_SUM_EQ]
     (← q r"s = t /\ (!x. x IN t ==> f x = g x)
      ==> ring_sum r s f = ring_sum r t g")
    pure (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!i. i IN v ==> (x:V->B) i IN ring_carrier r'") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, RING_CARRIER_SUBRING_GENERATED_SUBSET], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o GEN_REWRITE_RULE id
     [RING_HOMOMORPHISM_INTO_SUBRING_EQ_GEN]) THEN
    REWRITE_TAC [poly_extend, SUBRING_GENERATED, RING_POW_SUBRING_GENERATED] THEN
    ONCE_REWRITE_TAC [← GSYM SUBRING_GENERATED_BY_SUBRING_GENERATED] THEN
    SIMP_TAC [RING_SUM_SUBRING_GENERATED, SUBRING_SUBRING_GENERATED] THEN
    MATCH_MP_TAC mm THEN
    REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
     [REWRITE_TAC [sr] THEN
      X_GEN_TAC (← q r"m:V->num") THEN DISCH_TAC THEN
      MATCH_MP_TAC RING_MUL_IN_SUBRING_GENERATED THEN
      REWRITE_TAC [SUBRING_GENERATED_BY_SUBRING_GENERATED, RING_PRODUCT] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP POLY_MONOMIAL_IN_CARRIER) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism]) THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"m:V->num") THEN DISCH_TAC THEN AP_TERM_TAC] THEN
    SIMP_TAC [RING_PRODUCT_SUBRING_GENERATED, SUBRING_SUBRING_GENERATED] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_PRODUCT_SUPERSET THEN
    REWRITE_TAC [SUBSET_RESTRICT, IN_ELIM_THM] THEN X_GEN_TAC (← q "i:V") THEN
    MATCH_MP_TAC tt THEN
    DISCH_TAC THEN MATCH_MP_TAC RING_POW_IN_SUBRING_GENERATED THEN
    RULE_ASSUM_TAC (REWRITE_RULE [POLY_RING, poly_vars, IN_ELIM_THM]) THEN
    ASM SET_TAC []))

  -- @@RETURN BEGIN
  return { poly_extend, POLY_EXTEND_FROM_SUBRING_GENERATED, POLY_EXTEND,
           POLY_EXTEND_SUPERSET, POLY_EXTEND_POLYNOMIAL, POLY_EXTEND_CONST,
           POLY_EXTEND_0, POLY_EXTEND_1, POLY_EXTEND_VAR, POLY_EXTEND_NEG,
           POLY_EXTEND_ADD, POLY_EXTEND_SUB, POLY_EXTEND_MUL, POLY_EXTEND_POW,
           RING_HOMOMORPHISM_POLY_EXTEND, POLY_EXTEND_RING_SUM, POLY_EXTEND_RING_PRODUCT,
           POLY_EXTEND_UNIQUE, POLY_EXTEND_EQ, POLY_EXTEND_ID, POLY_EXTEND_COMPOSE,
           POLY_EXTEND_HOMOMORPHIC_IMAGE, POWSER_EXTEND_AT_0, POLY_EXTEND_AT_0,
           RING_HOMOMORPHISM_POWSER_EXTEND_AT_0, POLY_SUBRING_GENERATED,
           RING_HOMOMORPHISMS_EQ_FROM_POLY_RING, POLY_SUBRING_GENERATED_1,
           IMAGE_POLY_EXTEND, IMAGE_POLY_EXTEND_1, POLY_EXTEND_INTO_SUBRING_GENERATED }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Some "natural" isomorphisms between polynomial / power series variants.   -/
/- (ringtheory.ml 20091-21031)                                               -/
/- ------------------------------------------------------------------------- -/

structure NatIso where
  -- @@FIELDS
  RING_ISOMORPHISM_POWSER_RING_TRIVIAL : thm
  RING_ISOMORPHISM_POLY_RING_TRIVIAL : thm
  ISOMORPHIC_POWSER_RING_TRIVIAL : thm
  ISOMORPHIC_POLY_RING_TRIVIAL : thm
  RING_ISOMORPHISMS_POWSER_RINGS : thm
  ISOMORPHIC_POWSER_RINGS : thm
  RING_ISOMORPHISMS_POLY_RINGS : thm
  ISOMORPHIC_POLY_RINGS : thm
  RING_ISOMORPHISMS_POWSER_POWSER_RING : thm
  ISOMORPHIC_RING_POWSER_POWSER : thm
  ISOMORPHIC_RING_POWSER_POWSER_GEN : thm
  RING_CARRIER_POWSER_SUBRING_GENERATED : thm
  RING_CARRIER_POLY_SUBRING_GENERATED : thm
  RING_CARRIER_POWSER_SUBRING_GENERATED_MONO : thm
  RING_CARRIER_POLY_SUBRING_GENERATED_MONO : thm
  RING_CARRIER_POWSER_SUBRING_GENERATED_SUBSET : thm
  RING_CARRIER_POLY_SUBRING_GENERATED_SUBSET : thm
  SUBRING_POWSER_INTO_SUBRING : thm
  SUBRING_POLY_INTO_SUBRING : thm
  RING_ISOMORPHISMS_POWSER_SUBRING_GENERATED : thm
  ISOMORPHIC_RINGS_POWSER_SUBRING_GENERATED : thm
  RING_ISOMORPHISMS_POLY_SUBRING_GENERATED : thm
  ISOMORPHIC_RINGS_POLY_SUBRING_GENERATED : thm
  RING_ISOMORPHISMS_POLY_POLY_RING : thm
  ISOMORPHIC_RING_POLY_POLY : thm
  ISOMORPHIC_RING_POLY_POLY_GEN : thm
  POLY_EXTEND_EXTEND : thm
  deriving Inhabited

@[nospecialize]
def setupNatIso [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BSums : Sums) (BProducts : Products) (BSubrings : Subrings) (BHoms : Homs) (BIso : Iso) (BRingRule : RingRule) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BHomExtend : HomExtend) :
    ExceptT String IO NatIso := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ADD_CLAUSES, ADD_EQ_0, AND_FORALL_THM, CARD_EQ_IMAGE, CARD_EQ_REFL,
        CARD_EQ_SYM, COND_ID, .. } := D.core1
  let { CONJ_ASSOC, CONJ_SYM, DE_MORGAN_THM, DISJOINT_SYM, EMPTY_GSPEC, EMPTY_SUBSET,
        EMPTY_UNIONS, EQ_ADD_LCANCEL_0, EQ_ADD_RCANCEL_0, EQ_C_BIJECTIONS, EQ_TRANS,
        EXISTS_IN_GSPEC, .. } := D.core2
  let { FINITE_IMAGE, FINITE_INTER, FINITE_PRODUCT_DEPENDENT, FINITE_RESTRICT,
        FINITE_SUBSET, FINITE_UNION, FINITE_UNIONS, FORALL_AND_THM, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, IMAGE_I, IMAGE_ID, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, INFINITE, INFINITE_IMAGE, INFINITE_SUPERSET, INTER_ASSOC,
        INTER_SUBSET, .. } := D.core4
  let { IN_ELIM_PAIR_THM, IN_ELIM_QUAD_THM, IN_ELIM_THM, IN_IMAGE, IN_INTER, I_O_ID,
        I_THM, LAMBDA_PAIR, LAMBDA_PAIR_THM, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_AND, MONO_FORALL, MONO_IMP, MONO_OR, NOT_FORALL_THM, PAIR_EQ, .. } := D.core6
  let { RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SUBSET, SUBSET_ANTISYM,
        SUBSET_EMPTY, SUBSET_RESTRICT, UNIONS_IMAGE, UNIONS_SUBSET, UNION_COMM, .. } := D.core7
  let { add_c, o_DEF, o_THM, sum_DISTINCT, sum_INJECTIVE, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_LZERO, RING_MUL, RING_MUL_ASSOC,
        RING_MUL_LZERO, RING_MUL_RZERO, RING_NEG, .. } := BBasics
  let { RING_SUM_CLOSED, RING_SUM_EQ, RING_SUM_EQ_0, RING_SUM_EQ_GENERAL_INVERSES,
        RING_SUM_IMAGE, RING_SUM_RESTRICT_SET, RING_SUM_RMUL, RING_SUM_SUM_PRODUCT, .. } := BSums
  let { RING_PRODUCT, RING_PRODUCT_EQ, RING_PRODUCT_UNION, .. } := BProducts
  let { CARRIER_SUBRING_GENERATED_SUBRING, SUBRING_GENERATED,
        SUBRING_GENERATED_BY_SUBRING_GENERATED, SUBRING_GENERATED_MONO,
        SUBRING_GENERATED_RESTRICT, SUBRING_GENERATED_SUBRING_GENERATED,
        SUBRING_OF_SUBRING_GENERATED_REV, SUBRING_SUBRING_GENERATED, subring_of, .. } := BSubrings
  let { RING_HOMOMORPHISM, RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_MUL,
        RING_HOMOMORPHISM_SUM, RING_ISOMORPHISMS, RING_ISOMORPHISMS_BETWEEN_SUBRINGS,
        RING_ISOMORPHISMS_COMPOSE, RING_ISOMORPHISMS_SYM,
        RING_ISOMORPHISM_MONOMORPHISM_ALT, RING_SUM_SUBRING_GENERATED,
        ring_homomorphism, ring_isomorphism, ring_isomorphisms, .. } := BHoms
  let { ISOMORPHIC_RING_REFL, ISOMORPHIC_RING_SYM, ISOMORPHIC_RING_TRANS,
        isomorphic_ring, .. } := BIso
  let { RING_RULE, .. } := BRingRule
  let { MONOMIAL_1, MONOMIAL_DIVIDES_LMUL, MONOMIAL_DIVIDES_REFL,
        MONOMIAL_DIVIDES_RMUL, MONOMIAL_FINITE_DIVISORPAIRS, MONOMIAL_FINITE_DIVISORS,
        MONOMIAL_MUL, MONOMIAL_MUL_EQ_1, MONOMIAL_MUL_RESTRICT, MONOMIAL_MUL_SYM,
        MONOMIAL_RESTRICT_EQ, MONOMIAL_RESTRICT_REFL, MONOMIAL_RULE,
        MONOMIAL_VARS_EQ_EMPTY, MONOMIAL_VARS_MUL, MONOMIAL_VARS_RESTRICT, monomial,
        monomial_1, monomial_mul, monomial_restrict, monomial_vars, .. } := BMonomials
  let { POLY_0, poly_0, poly_1, poly_add, poly_const, poly_mul, poly_neg, poly_vars,
        ring_polynomial, ring_powerseries, .. } := BPowerSeries
  let { POLY_CARRIER_SUBRING_OF_POWSER_RING, POLY_RING, POLY_RING_AS_SUBRING,
        POLY_RING_AS_SUBRING_FINITE, POWSER_RING, POWSER_SUM, RING_CARRIER_POLY_RING,
        RING_CARRIER_POLY_RING_FINITE, RING_CARRIER_POWSER_RING,
        RING_MONOMORPHISM_POLY_CONST, RING_MONOMORPHISM_POWSER_CONST, .. } := BPolyRings
  let { poly_extend, .. } := BHomExtend
  -- @@SCOPE END

  let (RING_ISOMORPHISM_POWSER_RING_TRIVIAL, RING_ISOMORPHISM_POLY_RING_TRIVIAL) : thm × thm ← do
   CONJ_PAIR (← prove
   r"(!r. ring_isomorphism (r,powser_ring r {})
                         (poly_const r:A->(V->num)->A)) /\
   (!r. ring_isomorphism (r,poly_ring r {})
                         (poly_const r:A->(V->num)->A))"
   (CONJ_TAC THEN GEN_TAC THEN
    REWRITE_TAC [RING_ISOMORPHISM_MONOMORPHISM_ALT] THEN
    REWRITE_TAC [RING_MONOMORPHISM_POLY_CONST, RING_MONOMORPHISM_POWSER_CONST,
                 POLY_RING, POWSER_RING] THEN
    GEN_REWRITE_TAC id [SUBSET] THEN
    X_GEN_TAC (← q r"p:(V->num)->A") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    REWRITE_TAC [poly_vars, SUBSET_EMPTY, EMPTY_UNIONS,
                 ring_polynomial, ring_powerseries] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, MONOMIAL_VARS_EQ_EMPTY] THEN
    DISCH_TAC THEN REWRITE_TAC [IN_IMAGE, poly_const] THEN
    EXISTS_TAC (← q r"(p:(V->num)->A) monomial_1") THEN
    ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    REWRITE_TAC [] THEN ASM_MESON_TAC []))

  let ISOMORPHIC_POWSER_RING_TRIVIAL ← prove
   r"(!r. (powser_ring r {}:((V->num)->A)ring) isomorphic_ring r) /\
   (!r. r isomorphic_ring (powser_ring r {}:((V->num)->A)ring))"
   (GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [ISOMORPHIC_RING_SYM] THEN
    REWRITE_TAC [] THEN GEN_TAC THEN REWRITE_TAC [isomorphic_ring] THEN
    MESON_TAC [RING_ISOMORPHISM_POWSER_RING_TRIVIAL])

  let ISOMORPHIC_POLY_RING_TRIVIAL ← prove
   r"(!r. (poly_ring r {}:((V->num)->A)ring) isomorphic_ring r) /\
   (!r. r isomorphic_ring (poly_ring r {}:((V->num)->A)ring))"
   (GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [ISOMORPHIC_RING_SYM] THEN
    REWRITE_TAC [] THEN GEN_TAC THEN REWRITE_TAC [isomorphic_ring] THEN
    MESON_TAC [RING_ISOMORPHISM_POLY_RING_TRIVIAL])

  let RING_ISOMORPHISMS_POWSER_RINGS ← prove
   r"!r r' s s' (f:A->B) g (i:V->W) j.
        ring_isomorphisms(r,r') (f,g) /\
        (!x. x IN s ==> i(x) IN s' /\ j(i x) = x) /\
        (!y. y IN s' ==> j(y) IN s /\ i(j y) = y)
        ==> ring_isomorphisms (powser_ring r s,powser_ring r' s')
            ((\p m. if monomial_vars m SUBSET s'
                    then f(p(\v. if v IN s then m(i v) else 0))
                    else ring_0 r'),
             (\q m. if monomial_vars m SUBSET s
                    then g(q(\v. if v IN s' then m(j v) else 0))
                    else ring_0 r))"
   (← do
    -- right to left: the MESON on monomial_mul, the RING_RULE, the MESON
    -- on !j, the TAUT, the MESON on g(f(p m)), the MESON on if-then-0
    let m6 ← MESON []
       (← q r"monomial_mul m1 m2 = m
        ==> (INFINITE(monomial_vars(monomial_mul m1 m2)) <=>
             INFINITE(monomial_vars m))")
    let rr ← RING_RULE
       (← q r"x IN ring_carrier r /\ y IN ring_carrier r /\
        (x = ring_0 r \/ y = ring_0 r)
        ==> ring_mul r x y = ring_0 r")
    let m4 ← MESON []
       (← q r"!j. (!x. P(j x) ==> Q x) ==> (!x. P x) ==> (!x. Q x)")
    let tt ← TAUT (← q r"~p ==> p ==> q")
    let m2 ← MESON [] (← q r"n = m /\ g(f(p m)) = p m ==> g(f(p n)) = p m")
    let m1 ← MESON [] (← q r"~((if p then x else 0) = 0) <=> p /\ ~(x = 0)")
    pure (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [ring_isomorphisms] THEN
    REWRITE_TAC [ring_homomorphism] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [SUBSET] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN STRIP_TAC THEN
    REWRITE_TAC [o_DEF, RING_ISOMORPHISMS] THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [POWSER_RING, ring_powerseries, poly_vars] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, UNIONS_SUBSET] THEN
      REWRITE_TAC [IN_ELIM_THM, monomial_vars] THEN CONJ_TAC THENL
       [GEN_TAC THEN STRIP_TAC,
        X_GEN_TAC (← q r"q:(W->num)->B") THEN STRIP_TAC THEN
        REPEAT CONJ_TAC THENL
         [ASM_MESON_TAC [RING_0],
          X_GEN_TAC (← q r"m:V->num") THEN
          COND_CASES_TAC THEN REWRITE_TAC [] THEN DISCH_TAC THEN
          FIRST_X_ASSUM (fun th => tactic_of do
            pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
          AP_TERM_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          MATCH_MP_TAC INFINITE_SUPERSET THEN
          EXISTS_TAC (← q r"IMAGE (i:V->W) {i | ~(m i = 0)}") THEN
          CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
          MATCH_MP_TAC INFINITE_IMAGE THEN ASM SET_TAC [],
          MESON_TAC [],
          ALL_TAC]] THEN
       (GEN_REWRITE_TAC id [FUN_EQ_THM] THEN GEN_TAC THEN
        ASM_SIMP_TAC [] THEN
        COND_CASES_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        REWRITE_TAC [m1] THEN
        REWRITE_TAC [SUBSET_RESTRICT] THEN
        MATCH_MP_TAC m2 THEN
        CONJ_TAC THENL
         [REWRITE_TAC [FUN_EQ_THM] THEN ASM SET_TAC [],
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC []])] THEN
    REWRITE_TAC [RING_HOMOMORPHISM] THEN REPEAT CONJ_TAC THENL
     [GEN_REWRITE_TAC id [SUBSET] THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      REWRITE_TAC [POWSER_RING, ring_powerseries, poly_vars] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, UNIONS_SUBSET] THEN
      REWRITE_TAC [IN_ELIM_THM, monomial_vars] THEN
      X_GEN_TAC (← q r"p:(V->num)->A") THEN STRIP_TAC THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [RING_0],
        X_GEN_TAC (← q r"m:W->num") THEN
        COND_CASES_TAC THEN REWRITE_TAC [] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
        AP_TERM_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        MATCH_MP_TAC INFINITE_SUPERSET THEN
        EXISTS_TAC (← q r"IMAGE (j:W->V) {i | ~(m i = 0)}") THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC INFINITE_IMAGE THEN ASM SET_TAC [],
        MESON_TAC []],
      REWRITE_TAC [POWSER_RING, poly_1, poly_const] THEN
      GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"m:W->num") THEN
      REWRITE_TAC [monomial_1, monomial_vars] THEN
      ASM_CASES_TAC (← q r"m = \v:W. 0") THEN ASM_REWRITE_TAC [] THENL
       [ASM_REWRITE_TAC [COND_ID, EMPTY_GSPEC, EMPTY_SUBSET], ALL_TAC] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FUN_EQ_THM]) THEN
      MATCH_MP_TAC tt THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [FUN_EQ_THM]) THEN
      ASM SET_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"p:(V->num)->A", ← q r"q:(V->num)->A"] THEN
      REWRITE_TAC [POWSER_RING, ring_powerseries, poly_vars] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, UNIONS_SUBSET] THEN
      REWRITE_TAC [IN_ELIM_THM, monomial_vars, INFINITE] THEN STRIP_TAC THEN
      GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"m:W->num") THEN
      REWRITE_TAC [poly_add] THEN
      ASM_CASES_TAC (← q r"{i:W | ~(m i = 0)} SUBSET s'") THEN
      ASM_REWRITE_TAC [] THEN SIMP_TAC [RING_0, RING_ADD_LZERO] THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q "r':B ring", ← q "f:A->B"]
          RING_HOMOMORPHISM_ADD) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [ring_homomorphism, SUBSET, FORALL_IN_IMAGE],
        ASM_SIMP_TAC []],
      MAP_EVERY X_GEN_TAC [← q r"p:(V->num)->A", ← q r"q:(V->num)->A"] THEN
      REWRITE_TAC [POWSER_RING, ring_powerseries, poly_vars] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, UNIONS_SUBSET] THEN
      REWRITE_TAC [IN_ELIM_THM, monomial_vars, INFINITE] THEN STRIP_TAC THEN
      GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"m:W->num") THEN
      REWRITE_TAC [poly_mul]] THEN
