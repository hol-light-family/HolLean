   (REWRITE_TAC [ring_monomorphism] THEN
    MESON_TAC [RING_HOMOMORPHISM_INTO_SUBRING])

  let RING_MONOMORPHISM_BETWEEN_SUBRINGS ← prove
   r"!r r' s t (f:A->B).
      ring_monomorphism(r,r') f /\ IMAGE f s SUBSET t
