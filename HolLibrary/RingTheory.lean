    let mc ← MESON [POLY_ADD_RZERO, RING_POWERSERIES_0]
     (← q r"ring_powerseries r p /\ q = poly_0 r ==> poly_add r p q = p")
    let mb ← MESON []
     (← q r"poly_add r x y = z
      ==> poly_sub r z y IN j /\
