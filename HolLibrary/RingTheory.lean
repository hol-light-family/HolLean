         USE_THEN "IH_n" (MP_TAC o SPEC
          (← q "poly_deg r (hh':(1->num)->A)")) THEN
         ANTS_TAC THENL
         [MP_TAC (← REWRITE_RULE [coeff]
            (← ISPECL [← q "r:A ring", ← q "g:(1->num)->A"] POLY_TOP_TAIL)) THEN
