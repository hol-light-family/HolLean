        EXISTS_TAC (← q "g:(1->num)->A") THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN
         (← q r"!nn (hh:(1->num)->A). hh IN j /\ poly_deg (r:A ring) hh = nn
