        ==> !p. p IN ring_carrier(poly_ring r s) ==> P p"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [POLY_RING]) THEN
    REWRITE_TAC [IN_ELIM_THM, ring_polynomial, ring_powerseries] THEN
