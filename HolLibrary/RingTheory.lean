       ASM_MESON_TAC [SUBSET],
       ALL_TAC] THEN
      ASM_SIMP_TAC [RING_MUL_RID] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC IN_RING_IDEAL_LMUL THEN ASM_REWRITE_TAC [] THEN
      ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q "c:A") STRIP_ASSUME_TAC) THEN
      MAP_EVERY EXISTS_TAC [← q "ring_mul r c (x:A)", ← q "c:A"] THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q "(c:A) IN ring_carrier r") ASSUME_TAC THENL
      [ASM SET_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:A->bool", ← q "x:A", ← q "ring_1 r:A",
                       ← q "ring_mul r c (x:A)", ← q "c:A"]
        RING_LOCALEQUIV_EQUIV) THEN
      ANTS_TAC THENL [ASM_SIMP_TAC [RING_MUL, RING_1], ALL_TAC] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [RING_LOCALEQUIV, RING_MUL, RING_1] THEN
      EXISTS_TAC (← q "ring_1 r:A") THEN ASM_REWRITE_TAC [] THEN
      RING_TAC THEN ASM_SIMP_TAC []])

  let IDEAL_GENERATED_RING_LOCALIZATION ← prove
   r"!r s (u:A->bool).
