    -- right to left: the rules in reverse text order
    let a9 ← ARITH_RULE
     (← q r"s:num < m ==> m <= n /\ q <= n - m ==> q + s <= n - 1")
    let a8 ← ARITH_RULE (← q r"~(n = 0) ==> (x < n <=> x <= n - 1)")
    let t7 ← TAUT (← q r"p \/ q ==> (q ==> p) ==> p")
    let r6 ← RING_RULE
