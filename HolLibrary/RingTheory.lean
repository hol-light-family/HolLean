            ASM_REWRITE_TAC [] THEN
            DISCH_THEN (X_CHOOSE_THEN (← q "c0:A") STRIP_ASSUME_TAC) THEN
            SUBGOAL_THEN (← q "(c0:A) = ring_0 r")
             SUBST_ALL_TAC THENL
            [ASM_MESON_TAC [],
