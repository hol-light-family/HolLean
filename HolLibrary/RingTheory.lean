    REWRITE_TAC [← GSYM INT_OF_NUM_MUL, INT_REM_REM_MUL])

  let VNREGULAR_INTEGER_MOD_RING ← prove
   r"!n. vnregular_ring(integer_mod_ring n) <=> squarefree n"
   (GEN_TAC THEN REWRITE_TAC [vnregular_ring, INTEGER_MOD_RING_CLAUSES] THEN
    REWRITE_TAC [RING_CARRIER_INTEGER_MOD_RING] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE, IN_UNIV] THEN
    CONV_TAC INT_REM_DOWN_CONV THEN
    REWRITE_TAC [INT_REM_EQ, ← INTEGER_RULE
     (← q r"(?x:int. (a * x * a == a) (mod n)) <=> gcd(a pow 2,n) divides a")] THEN
    ONCE_REWRITE_TAC [← GSYM INT_DIVIDES_RABS] THEN
    ONCE_REWRITE_TAC [← GSYM INT_POW2_ABS] THEN
    REWRITE_TAC [← GSYM INT_FORALL_ABS, INT_OF_NUM_CLAUSES, ← GSYM NUM_GCD] THEN
    REWRITE_TAC [← GSYM num_divides, ← GSYM SQUAREFREE_GCD_SQUARE])

  let INTEGER_QUOTIENT_RING_ISOMORPHIC_MOD ← prove
   r"quotient_ring integer_ring (ideal_generated integer_ring {&n})
   isomorphic_ring integer_mod_ring n"
   (← do
    -- right to left: the INTEGER_RULEs (last first), then the SET_RULE
    let i6 ← INTEGER_RULE (← q r"(x:int == x) (mod n)")
    let i5 ← INTEGER_RULE (← q r"(x == y) (mod(&0)) <=> x:int = y")
    let i4 ← INTEGER_RULE (← q r"(x:int == x) (mod n)")
    let i3 ← INTEGER_RULE (← q r"(x:int == x) (mod n)")
    let i2 ← INTEGER_RULE (← q r"(d:int) divides x - y <=> (x == y) (mod d)")
    let s1 ← SET_RULE (← q r"(s SUBSET t /\ P) /\ (s = t /\ Q) <=>
                        s SUBSET t /\ t SUBSET s /\ P /\ Q")
    let ci ← CONJUNCT1 INTEGER_RING
    let ci' ← CONJUNCT1 INTEGER_RING
    pure (ONCE_REWRITE_TAC [ISOMORPHIC_RING_SYM] THEN REWRITE_TAC [isomorphic_ring] THEN
    EXISTS_TAC (← q "ring_coset integer_ring (ideal_generated integer_ring {&n})") THEN
    REWRITE_TAC [RING_ISOMORPHISM, RING_HOMOMORPHISM] THEN
    REWRITE_TAC [s1] THEN
    SIMP_TAC [QUOTIENT_RING_ADD, QUOTIENT_RING_MUL, QUOTIENT_RING_1,
              QUOTIENT_RING_0, QUOTIENT_RING_CARRIER, FORALL_IN_GSPEC,
              RING_COSET_IDEAL_GENERATED_SING_EQ, SUBSET, FORALL_IN_IMAGE,
              RING_IDEAL_IDEAL_GENERATED, ci, IN_UNIV] THEN
    SIMP_TAC [IN_IMAGE, IN_ELIM_THM, RING_COSET_IDEAL_GENERATED_SING_EQ,
              RING_IDEAL_IDEAL_GENERATED, ci', IN_UNIV] THEN
    REWRITE_TAC [INTEGER_RING, INTEGER_MOD_RING, INTEGER_RING_DIVIDES,
                 IN_INTEGER_MOD_RING_CARRIER, ring_sub, ← GSYM INT_SUB] THEN
    REWRITE_TAC [i2] THEN
    REWRITE_TAC [INT_CONG_LREM, i3] THEN
    CONJ_TAC THENL [MESON_TAC [i4], ALL_TAC] THEN
    ASM_CASES_TAC (← q "n = 0") THEN
    ASM_REWRITE_TAC [INT_OF_NUM_EQ, ← GSYM EXISTS_REFL, i5] THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q "a:int") THEN EXISTS_TAC (← q "a rem (&n)") THEN
      REWRITE_TAC [INT_CONG_RREM, i6] THEN
      ASM_REWRITE_TAC [INT_REM_POS_EQ, INT_LT_REM_EQ, INT_OF_NUM_EQ] THEN
      ASM_SIMP_TAC [INT_OF_NUM_CLAUSES, LE_1],
      REPEAT STRIP_TAC THEN MATCH_MP_TAC INT_CONG_IMP_EQ THEN
      EXISTS_TAC (← q "&n:int") THEN ASM_REWRITE_TAC [] THEN ASM_INT_ARITH_TAC]))

  let RING_ISOMORPHISM_PRIME_SUBRING ← prove
   r"!r:A ring.
        ring_isomorphism
         (integer_mod_ring (ring_char r),
          subring_generated r {ring_of_int r n | n IN (:int)})
         (ring_of_int r)"
   (GEN_TAC THEN
    MP_TAC (← SPECL [← q "r:A ring", ← q "ring_char(r:A ring)"]
          RING_MONOMORPHISM_INTEGER_MOD_RING_OF_INT) THEN
    REWRITE_TAC [← GSYM RING_ISOMORPHISM_ONTO_IMAGE, isomorphic_ring] THEN
    REWRITE_TAC [ring_image] THEN
    ASM_CASES_TAC (← q "ring_char(r:A ring) = 0") THEN
    ASM_SIMP_TAC [INTEGER_MOD_RING_TRIVIAL, INTEGER_RING] THEN
    ASM_SIMP_TAC [← GSYM SIMPLE_IMAGE, INTEGER_MOD_RING, LE_1] THEN
    ASM_SIMP_TAC [PRIME_SUBRING_FINITE, ← GSYM RING_OF_INT_OF_NUM] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_ELIM_THM, IMP_CONJ, ← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [← GSYM INT_FORALL_POS, ← GSYM INT_EXISTS_POS] THEN
    MESON_TAC [INT_OF_NUM_LT])

  let ISOMORPHIC_PRIME_SUBRING ← prove
   r"!r:A ring. subring_generated r {ring_of_int r n | n IN (:int)}
              isomorphic_ring (integer_mod_ring (ring_char r))"
   (GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_RING_SYM] THEN
    REWRITE_TAC [isomorphic_ring] THEN EXISTS_TAC (← q r"ring_of_int r:int->A") THEN
    REWRITE_TAC [RING_ISOMORPHISM_PRIME_SUBRING])

  let FIELD_PRIME_SUBRING ← prove
   r"!r:A ring.
        field(subring_generated r {ring_of_int r n | n IN (:int)}) <=>
        prime(ring_char r)"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q "r:A ring") ISOMORPHIC_PRIME_SUBRING) THEN
    DISCH_THEN (MP_TAC o MATCH_MP ISOMORPHIC_RING_FIELDNESS) THEN
    REWRITE_TAC [FIELD_INTEGER_MOD_RING])

  -- @@RETURN BEGIN
  return { integer_mod_ring, INTEGER_MOD_RING, IN_INTEGER_MOD_RING_CARRIER,
           RING_CARRIER_INTEGER_MOD_RING, INTEGER_MOD_RING_CARRIER_REM,
           INTEGER_MOD_RING_TRIVIAL, INTEGER_MOD_RING_SUB, INTEGER_MOD_RING_POW,
           INTEGER_MOD_RING_OF_NUM, INTEGER_MOD_RING_OF_INT, INTEGER_MOD_RING_CLAUSES,
           INTEGER_MOD_RING_CHAR, INTEGER_MOD_RING_DIVIDES, INTEGER_MOD_RING_ASSOCIATES,
           INTEGER_MOD_RING_UNIT, TRIVIAL_INTEGER_MOD_RING, FINITE_INTEGER_MOD_RING,
           CARD_INTEGER_MOD_RING, FIELD_INTEGER_MOD_RING,
           INTEGRAL_DOMAIN_INTEGER_MOD_RING, RING_HOMOMORPHISM_INTEGER_MOD_RING_OF_INT,
           RING_MONOMORPHISM_INTEGER_MOD_RING_OF_INT,
           RING_HOMOMORPHISM_FROM_INTEGER_MOD_RING,
           RING_MONOMORPHISM_FROM_INTEGER_MOD_RING, RING_HOMOMORPHISM_INTEGER_MOD_RINGS,
           RING_HOMOMORPHISM_INTEGER_MOD_RINGS_POW,
           RING_HOMOMORPHISM_PROD_INTEGER_MOD_RING,
           RING_ISOMORPHISM_PROD_INTEGER_MOD_RING, ISOMORPHIC_PROD_INTEGER_MOD_RING,
           VNREGULAR_INTEGER_MOD_RING, INTEGER_QUOTIENT_RING_ISOMORPHIC_MOD,
           RING_ISOMORPHISM_PRIME_SUBRING, ISOMORPHIC_PRIME_SUBRING, FIELD_PRIME_SUBRING }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Conversion for explicit calculation over integer_mod_ring n.              -/
/- (ringtheory.ml 17328-17409)                                               -/
/- ------------------------------------------------------------------------- -/

structure IntegerModConv where
  -- @@FIELDS
  RING_INV_INTEGER_MOD_RING : thm
  INTEGER_MOD_RING_RED_CONV : ioconv
  deriving Inhabited

@[nospecialize]
def setupIntegerModConv [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDivides : Divides) (BIntegerModRing : IntegerModRing) :
    ExceptT String IO IntegerModConv := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, COPRIME_CONV, INT_ADD_CONV, INT_ARITH_TAC, INT_MUL_CONV,
        INT_NEG_CONV, INT_POW_REM_CONV, INT_REM_CONV, INT_REM_DOWN_CONV, INT_SUB_CONV,
        INVERSE_MOD_CONV, NUM_RED_CONV, .. } := D
  let { ARITH, COND_CLAUSES, .. } := D.core1
  let { COND_SWAP, CONG, COPRIME_0, COPRIME_SYM, .. } := D.core2
  let { IMP_CONJ, INT_FORALL_POS, INT_MUL_LID, INT_MUL_RZERO, INT_OF_NUM_CLAUSES,
        INT_OF_NUM_LE, INT_OF_NUM_LT, INT_OF_NUM_REM, INT_REM_0, INT_REM_1, .. } := D.core4
  let { INT_REM_ZERO, INT_SUB, INVERSE_MOD_BOUND, INVERSE_MOD_RMUL_EQ,
        INVERSE_MOD_UNIQUE, IN_ELIM_THM, IN_UNIV, LE_0, LE_1, LT_IMP_LE, .. } := D.core5
  let { SELECT_UNIQUE, .. } := D.core7
  let { inverse_mod, num_coprime, .. } := D.core8
  let { ring_sub, .. } := BBasics
  let { ring_div, ring_inv, .. } := BDivides
  let { INTEGER_MOD_RING, INTEGER_MOD_RING_OF_NUM, INTEGER_MOD_RING_POW,
        INTEGER_MOD_RING_UNIT, .. } := BIntegerModRing
  -- @@SCOPE END

  let RING_INV_INTEGER_MOD_RING ← prove
   r"!n a. ring_inv (integer_mod_ring n) (&a) =
         if (n = 0 \/ ~(n = 1) /\ a < n) /\ coprime(a,n)
         then &(inverse_mod n a) else &0"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_inv] THEN
    SIMP_TAC [INTEGER_MOD_RING, INTEGER_MOD_RING_UNIT, ← GSYM num_coprime] THEN
    ASM_CASES_TAC (← q "coprime(a:num,n)") THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM MP_TAC THEN ASM_CASES_TAC (← q "n = 0") THENL
     [ASM_SIMP_TAC [COPRIME_0, INTEGER_MOD_RING, LE_1, inverse_mod, ARITH] THEN
      REWRITE_TAC [IN_UNIV, INT_MUL_LID, IN_ELIM_THM, INT_REM_0, SELECT_UNIQUE],
      ASM_SIMP_TAC [INTEGER_MOD_RING, LE_1, IN_ELIM_THM] THEN
      REWRITE_TAC [INT_OF_NUM_LT, INT_OF_NUM_LE, LE_0] THEN DISCH_TAC] THEN
    ASM_CASES_TAC (← q "a:num < n") THEN ASM_REWRITE_TAC [COND_SWAP] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SELECT_UNIQUE THENL
     [REWRITE_TAC [INT_REM_1] THEN INT_ARITH_TAC, ALL_TAC] THEN
    X_GEN_TAC (← q "p:int") THEN REWRITE_TAC [] THEN EQ_TAC THENL
     [SPEC_TAC (← q "p:int", ← q "p:int") THEN
      REWRITE_TAC [IMP_CONJ, ← GSYM INT_FORALL_POS] THEN
      REWRITE_TAC [INT_OF_NUM_CLAUSES, INT_OF_NUM_REM] THEN
      REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC INVERSE_MOD_UNIQUE THEN ASM_SIMP_TAC [CONG, LT_IMP_LE],
      DISCH_THEN SUBST1_TAC THEN
      ASM_REWRITE_TAC [INT_OF_NUM_CLAUSES, INT_OF_NUM_REM, ← GSYM CONG] THEN
      REWRITE_TAC [INVERSE_MOD_BOUND, INVERSE_MOD_RMUL_EQ] THEN
      ONCE_REWRITE_TAC [COPRIME_SYM] THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC])

  let INTEGER_MOD_RING_RED_CONV : ioconv ← do
    -- `let [pth_0; ...; pth_pow] = (CONJUNCTS o prove) ... and pth_inv = ...
    -- and pth_div = ...`: left to right
    let pths := CONJUNCTS (← prove
     r"ring_0 (integer_mod_ring n) = &0 /\
     ring_1 (integer_mod_ring n) = &1 rem &n /\
     ring_of_num (integer_mod_ring n) m = &m rem &n /\
     ring_neg (integer_mod_ring n) (&a) = --(&a) rem &n /\
     ring_add (integer_mod_ring n) (&a) (&b) = (&a + &b) rem &n /\
     ring_sub (integer_mod_ring n) (&a) (&b) = (&a - &b) rem &n /\
     ring_mul (integer_mod_ring n) (&a) (&b) = (&a * &b) rem &n /\
     ring_pow (integer_mod_ring n) (&a) k = (&a pow k) rem &n"
     (REWRITE_TAC [ring_sub, INT_SUB, INTEGER_MOD_RING_OF_NUM] THEN
      REWRITE_TAC [INTEGER_MOD_RING_POW, INTEGER_MOD_RING] THEN
      CONV_TAC INT_REM_DOWN_CONV THEN REFL_TAC))
    let (pth_0, pth_1, pth_num, pth_neg, pth_add, pth_sub, pth_mul, pth_pow) ←
      match pths with
      | [a, b, c, d, e, f, g, h] => pure (a, b, c, d, e, f, g, h)
      | _ => throw "Match_failure"
    let pth_inv ← SPEC_ALL RING_INV_INTEGER_MOD_RING
    let pth_div ← prove
     r"ring_div (integer_mod_ring n) (&a) (&b) =
        if (n = 0 \/ ~(n = 1) /\ b < n) /\ coprime(b,n)
         then (&a * &(inverse_mod n b)) rem &n else &0"
     (REWRITE_TAC [ring_div, RING_INV_INTEGER_MOD_RING] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [INTEGER_MOD_RING] THEN
      REWRITE_TAC [INT_MUL_RZERO, INT_REM_ZERO])
    -- `baseconv`: the CONJUNCT2/CONJUNCT1 (SPEC_ALL COND_CLAUSES) arguments
    -- are computed where they appear
    let cc2a ← CONJUNCT2 (← SPEC_ALL COND_CLAUSES)
    let cc1a ← CONJUNCT1 (← SPEC_ALL COND_CLAUSES)
    let cc2b ← CONJUNCT2 (← SPEC_ALL COND_CLAUSES)
    let cc1b ← CONJUNCT1 (← SPEC_ALL COND_CLAUSES)
    let baseconv : ioconv :=
      GEN_REWRITE_CONV id [pth_0] ORELSEC
      ((GEN_REWRITE_CONV id [pth_1, pth_num] ORELSEC
        (GEN_REWRITE_CONV id [pth_neg] THENC
         LAND_CONV (TRY_CONV INT_NEG_CONV)) ORELSEC
        (GEN_REWRITE_CONV id [pth_add] THENC
         LAND_CONV (TRY_CONV INT_ADD_CONV)) ORELSEC
        (GEN_REWRITE_CONV id [pth_sub] THENC
         LAND_CONV (TRY_CONV INT_SUB_CONV)) ORELSEC
        (GEN_REWRITE_CONV id [pth_mul] THENC
         LAND_CONV (TRY_CONV INT_MUL_CONV))) THENC
       INT_REM_CONV) ORELSEC
      (GEN_REWRITE_CONV id [pth_pow] THENC INT_POW_REM_CONV) ORELSEC
      (GEN_REWRITE_CONV id [pth_inv] THENC
       RATOR_CONV (LAND_CONV (DEPTH_CONV (NUM_RED_CONV ORELSEC COPRIME_CONV))) THENC
       (GEN_REWRITE_CONV id [cc2a] ORELSEC
        (GEN_REWRITE_CONV id [cc1a] THENC
         RAND_CONV INVERSE_MOD_CONV))) ORELSEC
      (GEN_REWRITE_CONV id [pth_div] THENC
       RATOR_CONV (LAND_CONV (DEPTH_CONV (NUM_RED_CONV ORELSEC COPRIME_CONV))) THENC
       (GEN_REWRITE_CONV id [cc2b] ORELSEC
        (GEN_REWRITE_CONV id [cc1b] THENC
         LAND_CONV (RAND_CONV (RAND_CONV INVERSE_MOD_CONV) THENC
                   INT_MUL_CONV) THENC
         INT_REM_CONV)))
    pure fun tm => ExceptT.run do
      let th ← ExceptT.mk (baseconv tm)
      if HolMath.Int.is_intconst (← liftExcept (rand (concl th))) then pure th
      else throw "INTEGER_MOD_RING_RED_CONV"

  -- @@RETURN BEGIN
  return { RING_INV_INTEGER_MOD_RING, INTEGER_MOD_RING_RED_CONV }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The ring (and field) of real numbers.  (ringtheory.ml 17410-17495)        -/
/- ------------------------------------------------------------------------- -/

structure RealRing where
  -- @@FIELDS
  real_ring : thm
  REAL_RING_CLAUSES : thm
  FIELD_REAL_RING : thm
  INTEGRAL_DOMAIN_REAL_RING : thm
  REAL_RING_OF_NUM : thm
  REAL_RING_OF_INT : thm
  REAL_RING_CHAR : thm
  REAL_RING_SUB : thm
  REAL_RING_INV : thm
  REAL_RING_DIV : thm
  REAL_RING_POW : thm
  REAL_FIELD_CLAUSES : thm
  deriving Inhabited

@[nospecialize]
def setupRealRing [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BDomains : Domains) :
    ExceptT String IO RealRing := do
  -- @@SCOPE BEGIN
  let { INDUCT_TAC, MESON_TAC, REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV,
        REAL_RING, new_definition, .. } := D
  let { BETA_THM, .. } := D.core1
  let { COND_SWAP, .. } := D.core2
  let { FORALL_INT_CASES, FUN_EQ_THM, .. } := D.core3
  let { IN_UNIV, I_THM, .. } := D.core5
  let { PAIR, PAIR_EQ, REAL_ENTIRE, REAL_INV_0, REAL_MUL_RINV, REAL_OF_NUM_EQ,
        REAL_OF_NUM_SUC, .. } := D.core6
  let { SELECT_UNIQUE, .. } := D.core7
  let { int_neg_th, int_of_num_th, real_pow, .. } := D.core8
  let { ring_0, ring_1, ring_add, ring_carrier, ring_mul, ring_neg, ring_sub,
        ring_tybij, .. } := BBasics
  let { RING_CHAR_EQ_0, RING_OF_INT_CASES, ring_of_num, ring_pow, .. } := BNumbers
  let { ring_div, ring_inv, .. } := BDivides
  let { FIELD_UNIT, field, integral_domain, .. } := BDomains
  -- @@SCOPE END

  let real_ring ← new_definition
   r"real_ring = ring((:real),&0,&1,( -- ),( + ),( * ))"

  let REAL_RING_CLAUSES ← prove
   r"ring_carrier real_ring = (:real) /\
   ring_0 real_ring = &0 /\
   ring_1 real_ring = &1 /\
   ring_neg real_ring = ( -- ) /\
   ring_add real_ring = ( + ) /\
   ring_mul real_ring = ( * )"
   (PURE_REWRITE_TAC
     [← GSYM PAIR_EQ, ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul,
      BETA_THM, PAIR] THEN
    PURE_REWRITE_TAC [real_ring, ← GSYM (← CONJUNCT2 ring_tybij)] THEN
    REWRITE_TAC [IN_UNIV] THEN CONV_TAC (fun t => (REAL_RING t).run))

  let FIELD_REAL_RING ← prove
   r"field real_ring"
   (REWRITE_TAC [field, REAL_RING_CLAUSES, IN_UNIV] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    MESON_TAC [REAL_MUL_RINV])

  let INTEGRAL_DOMAIN_REAL_RING ← prove
   r"integral_domain real_ring"
   (REWRITE_TAC [integral_domain, REAL_RING_CLAUSES, REAL_ENTIRE, IN_UNIV] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let REAL_RING_OF_NUM ← prove
   r"ring_of_num real_ring = real_of_num"
   (REWRITE_TAC [FUN_EQ_THM] THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [ring_of_num, REAL_RING_CLAUSES, ← GSYM REAL_OF_NUM_SUC])

  let REAL_RING_OF_INT ← prove
   r"ring_of_int real_ring = real_of_int"
   (REWRITE_TAC [FUN_EQ_THM, I_THM] THEN
    REWRITE_TAC [RING_OF_INT_CASES, FORALL_INT_CASES] THEN
    REWRITE_TAC [int_neg_th, int_of_num_th, REAL_RING_OF_NUM] THEN
    REWRITE_TAC [REAL_RING_CLAUSES])

  let REAL_RING_CHAR ← prove
   r"ring_char real_ring = 0"
   (SIMP_TAC [RING_CHAR_EQ_0, REAL_RING_OF_NUM, REAL_RING_CLAUSES,
              REAL_OF_NUM_EQ])

  let REAL_RING_SUB ← prove
   r"ring_sub real_ring = (-)"
   (REWRITE_TAC [FUN_EQ_THM, ring_sub, REAL_RING_CLAUSES] THEN REAL_ARITH_TAC)

  let REAL_RING_INV ← prove
   r"ring_inv real_ring = inv"
   (REWRITE_TAC [FUN_EQ_THM, ring_inv, REAL_RING_CLAUSES] THEN
    SIMP_TAC [FIELD_UNIT, FIELD_REAL_RING, REAL_RING_CLAUSES,
              IN_UNIV, COND_SWAP] THEN
    GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_INV_0] THEN
    MATCH_MP_TAC SELECT_UNIQUE THEN POP_ASSUM MP_TAC THEN
    CONV_TAC (fun t => (REAL_FIELD t).run))

  let REAL_RING_DIV ← prove
   r"ring_div real_ring = (/)"
   (REWRITE_TAC [FUN_EQ_THM, ring_div, REAL_RING_CLAUSES, REAL_RING_INV] THEN
    REAL_ARITH_TAC)

  let REAL_RING_POW ← prove
   r"ring_pow real_ring = (pow)"
   (REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [ring_pow, real_pow, REAL_RING_CLAUSES])

  let REAL_FIELD_CLAUSES ← prove
   r"ring_carrier real_ring = (:real) /\
   ring_0 real_ring = &0 /\
   ring_1 real_ring = &1 /\
   ring_neg real_ring = ( -- ) /\
   ring_add real_ring = ( + ) /\
   ring_mul real_ring = ( * ) /\
   ring_of_num real_ring = real_of_num /\
   ring_sub real_ring = (-) /\
   ring_inv real_ring = inv /\
   ring_div real_ring = (/) /\
   ring_pow real_ring = (pow)"
   (REWRITE_TAC [REAL_RING_CLAUSES, REAL_RING_OF_NUM, REAL_RING_SUB,
                 REAL_RING_INV, REAL_RING_DIV, REAL_RING_POW])

  -- @@RETURN BEGIN
  return { real_ring, REAL_RING_CLAUSES, FIELD_REAL_RING, INTEGRAL_DOMAIN_REAL_RING,
           REAL_RING_OF_NUM, REAL_RING_OF_INT, REAL_RING_CHAR, REAL_RING_SUB,
           REAL_RING_INV, REAL_RING_DIV, REAL_RING_POW, REAL_FIELD_CLAUSES }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Monoid of monomials over an arbitrary set of "variables".                 -/
/- (ringtheory.ml 17496-17978)                                               -/
/- ------------------------------------------------------------------------- -/

structure Monomials where
  -- @@FIELDS
  monomial_1 : thm
  monomial_mul : thm
  monomial_div : thm
  monomial_restrict : thm
  monomial_divides : thm
  monomial_var : thm
  monomial_vars : thm
  monomial_deg : thm
  monomial : thm
  MONOMIAL_POINTWISE_TAC : tactic
  MONOMIAL_TAC : tactic
  MONOMIAL_RULE : term → ExceptT String IO thm
  FINITE_MONOMIAL_VARS : thm
  FINITE_MONOMIAL_VARS_1 : thm
  MONOMIAL_DEG : thm
  MONOMIAL_VAR_1 : thm
  MONOMIAL_VARS_1 : thm
  MONOMIAL_VARS_EQ_EMPTY : thm
  MONOMIAL_VARS_MUL : thm
  MONOMIAL_VARS_VAR : thm
  MONOMIAL_VARS_RESTRICT : thm
  MONOMIAL_RESTRICT_EQ : thm
  MONOMIAL_RESTRICT_REFL : thm
  MONOMIAL_MONO : thm
  MONOMIAL_UNIV : thm
  MONOMIAL_1 : thm
  MONOMIAL_MUL : thm
  MONOMIAL_RESTRICT_MUL : thm
  MONOMIAL_MUL_RESTRICT : thm
  MONOMIAL_DIVISOR : thm
  MONOMIAL_VAR : thm
  MONOMIAL_RESTRICT : thm
  MONOMIAL : thm
  MONOMIAL_UNIV_1 : thm
  MONOMIAL_DEG_1 : thm
  MONOMIAL_DEG_VAR : thm
  MONOMIAL_DEG_EQ_0_ALT : thm
  MONOMIAL_DEG_EQ_0 : thm
  MONOMIAL_DIV_DIVIDES : thm
  MONOMIAL_DIV : thm
  MONOMIAL_DIVIDES_1 : thm
  MONOMIAL_DIVIDES_EXISTS : thm
  MONOMIAL_VAR_DIVIDES_MUL : thm
  MONOMIAL_MUL_EQ_VAR : thm
  MONOMIAL_DEG_MUL : thm
  MONOMIAL_DEG_LE : thm
  MONOMIAL_VAR_EQ : thm
  MONOMIAL_MUL_LID : thm
  MONOMIAL_MUL_RID : thm
  MONOMIAL_MUL_SYM : thm
  MONOMIAL_MUL_ASSOC : thm
  MONOMIAL_MUL_AC : thm
  MONOMIAL_MUL_EQ_1 : thm
  MONOMIAL_MUL_LCANCEL : thm
  MONOMIAL_MUL_RCANCEL : thm
  MONOMIAL_DIVIDES_REFL : thm
  MONOMIAL_DIVIDES_TRANS : thm
  MONOMIAL_DIVIDES_ANTISYM : thm
  MONOMIAL_DIVIDES_LMUL : thm
  MONOMIAL_DIVIDES_RMUL : thm
  MONOMIAL_DIV_LMUL_EQ : thm
  MONOMIAL_DIV_LMUL : thm
  MONOMIAL_DIV_RMUL_EQ : thm
  MONOMIAL_DIV_RMUL : thm
  MONOMIAL_VAR_DIVIDES : thm
  MONOMIAL_VARS_DIVISOR : thm
  MONOMIAL_FINITE_DIVISORS : thm
  MONOMIAL_FINITE_DIVISORPAIRS : thm
  MONOMIAL_INDUCT : thm
  MONOMIAL_VARS_UNIVARIATE : thm
  MONOMIAL_DEG_UNIVARIATE : thm
  MONOMIAL_MUL_VAR_ONE : thm
  MONOMIAL_DEG_ONE : thm
  deriving Inhabited

@[nospecialize]
def setupMonomials [HolBase] (D : RingTheoryDeps) :
    ExceptT String IO Monomials := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC,
        NUM_REDUCE_CONV, SET_RULE, SET_TAC, new_definition, .. } := D
  let { ADD_EQ_0, AND_FORALL_THM, .. } := D.core1
  let { COND_RAND, COND_RATOR, CONJ_ACI, CONJ_ASSOC, CONJ_SYM, CONTRAPOS_THM,
        EMPTY_GSPEC, EMPTY_SUBSET, EQ_TRANS, EXISTS_IN_GSPEC, EXTENSION, .. } := D.core2
  let { EXTENSIONAL_UNIV, FINITE_1, FINITE_CARTESIAN_PRODUCT, FINITE_CROSS_EQ,
        FINITE_EMPTY, FINITE_IMAGE, FINITE_IMAGE_INJ_EQ, FINITE_INTER, FINITE_NUMSEG,
        FINITE_SING, FINITE_SUBSET, FINITE_UNION, FORALL_AND_THM, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_ONE_THM, FORALL_UNWIND_THM2, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INTER_SUBSET, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, IN_SING,
        IN_UNION, IN_UNIV, LE, LEFT_IMP_EXISTS_THM, LE_0, LE_ADD, .. } := D.core5
  let { MEMBER_NOT_EMPTY, MONO_FORALL, NOT_IN_EMPTY, NOT_SUC, NSUM_ADD, NSUM_CLAUSES,
        NSUM_EQ_0_IFF, NSUM_SING, NSUM_SUPERSET, .. } := D.core6
  let { SING_GSPEC, SING_SUBSET, SKOLEM_THM, SUBSET, SUBSET_TRANS, SUBSET_UNIV,
        SUC_INJ, UNION_SUBSET, UNIV_1, UNIV_GSPEC, UNWIND_THM2, .. } := D.core7
  let { num_INDUCTION, .. } := D.core8
  -- @@SCOPE END

  let monomial_1 ← new_definition
   r"monomial_1 = \i:V. 0"

  let monomial_mul ← new_definition
   r"monomial_mul (m1:V->num) (m2:V->num) =
     \i. m1 i + m2 i"

  let monomial_div ← new_definition
   r"monomial_div (m1:V->num) (m2:V->num) =
     \i. m1 i - m2 i"

  let monomial_restrict ← new_definition
   r"monomial_restrict s (m:V->num) = \i. if i IN s then m i else 0"

  let monomial_divides ← new_definition
   r"monomial_divides (m1:V->num) (m2:V->num) <=> !i. m1 i <= m2 i"

  let monomial_var ← new_definition
   r"monomial_var (v:V) = \i. if i = v then 1 else 0"

  let monomial_vars ← new_definition
   r"monomial_vars m = {i:V | ~(m i = 0)}"

  let monomial_deg ← new_definition
   r"monomial_deg m = nsum (monomial_vars m) (m:V->num)"

  let monomial ← new_definition
   r"monomial (s:V->bool) m <=>
     FINITE(monomial_vars m) /\ (monomial_vars m) SUBSET s"

  let MONOMIAL_POINTWISE_TAC : tactic ← do
    let monomial_eq ← prove
     r"!m1 m2:V->num. m1 = m2 <=> !x. m1 x = m2 x"
     (REWRITE_TAC [FUN_EQ_THM])
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [monomial_eq, monomial_divides] THEN
      REWRITE_TAC [monomial_1, monomial_mul, monomial_div,
                   monomial_restrict, monomial_var] THEN
      REWRITE_TAC [← GSYM SKOLEM_THM] THEN TRY EQ_TAC THEN
      REWRITE_TAC [AND_FORALL_THM, IMP_IMP] THEN
      TRY (MATCH_MP_TAC MONO_FORALL))

  let MONOMIAL_TAC : tactic ← pure (
    MONOMIAL_POINTWISE_TAC THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
    ASM_ARITH_TAC)

  let MONOMIAL_RULE : term → ExceptT String IO thm ← pure fun tm =>
    ExceptT.mk (HolCore.Tactics.prove HolBase.B tm MONOMIAL_TAC)

  let FINITE_MONOMIAL_VARS ← prove
   r"!m:V->num. FINITE(:V) ==> FINITE(monomial_vars m)"
   (MESON_TAC [FINITE_SUBSET, SUBSET_UNIV])

  let FINITE_MONOMIAL_VARS_1 ← prove
   r"!m:1->num. FINITE(monomial_vars m)"
   (MESON_TAC [FINITE_MONOMIAL_VARS, FINITE_1])

  let MONOMIAL_DEG ← prove
   r"!m:V->num. monomial_deg m = nsum UNIV m"
   (GEN_TAC THEN REWRITE_TAC [monomial_deg] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC NSUM_SUPERSET THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV, monomial_vars, IN_ELIM_THM])

  let MONOMIAL_VAR_1 ← prove
   r"(!v:V. ~(monomial_var v = monomial_1)) /\
   (!v:V. ~(monomial_1 = monomial_var v))"
   (REWRITE_TAC [monomial_var, monomial_1, FUN_EQ_THM] THEN
    MESON_TAC [← ARITH_RULE (← q "~(1 = 0)")])

  let MONOMIAL_VARS_1 ← prove
   r"monomial_vars (monomial_1:V->num) = {}"
   (REWRITE_TAC [monomial_vars, monomial_1, EMPTY_GSPEC])

  let MONOMIAL_VARS_EQ_EMPTY ← prove
   r"!m:V->num. monomial_vars m = {} <=> m = monomial_1"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [EXTENSION] THEN
    GEN_REWRITE_TAC RAND_CONV [FUN_EQ_THM] THEN
    REWRITE_TAC [NOT_IN_EMPTY, monomial_vars, monomial_1, IN_ELIM_THM] THEN
    MESON_TAC [])

  let MONOMIAL_VARS_MUL ← prove
   r"!m1 m2:V->num.
        monomial_vars(monomial_mul m1 m2) =
        monomial_vars m1 UNION monomial_vars m2"
   (REWRITE_TAC [monomial_vars, monomial_mul, ADD_EQ_0] THEN SET_TAC [])

  let MONOMIAL_VARS_VAR ← prove
   r"!v:V. monomial_vars(monomial_var v) = {v}"
   (GEN_TAC THEN REWRITE_TAC [monomial_vars, monomial_var] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
    CONV_TAC NUM_REDUCE_CONV THEN SET_TAC [])

  let MONOMIAL_VARS_RESTRICT ← prove
   r"!s m:V->num.
        monomial_vars(monomial_restrict s m) = s INTER monomial_vars m"
   (REWRITE_TAC [monomial_vars, monomial_restrict] THEN SET_TAC [])

  let MONOMIAL_RESTRICT_EQ ← prove
   r"!(m:V->num) s.
        monomial s (monomial_restrict s m) <=>
        FINITE(s INTER monomial_vars m)"
   (REWRITE_TAC [monomial, MONOMIAL_VARS_RESTRICT, INTER_SUBSET])

  let MONOMIAL_RESTRICT_REFL ← prove
   r"!s m:V->num. monomial s m ==> monomial_restrict s m = m"
   (REWRITE_TAC [monomial, FUN_EQ_THM, monomial_restrict, monomial_vars] THEN
    SET_TAC [])

  let MONOMIAL_MONO ← prove
   r"!s t (m:V->num).
        monomial s m /\ s SUBSET t ==> monomial t m"
   (REWRITE_TAC [monomial] THEN SET_TAC [])

  let MONOMIAL_UNIV ← prove
   r"!s m. monomial s m ==> monomial (:V) m"
   (REWRITE_TAC [monomial] THEN SET_TAC [])

  let MONOMIAL_1 ← prove
   r"!s:V->bool. monomial s monomial_1"
   (REWRITE_TAC [monomial, monomial_1, monomial_vars, EMPTY_GSPEC] THEN
    REWRITE_TAC [FINITE_EMPTY, EMPTY_SUBSET])

  let MONOMIAL_MUL ← prove
   r"!(s:V->bool) m1 m2.
        monomial s (monomial_mul m1 m2) <=> monomial s m1 /\ monomial s m2"
   (REWRITE_TAC [monomial, monomial_mul, monomial_vars, ADD_EQ_0, ← SET_RULE
     (← q r"{x | ~(P x /\ Q x)} = {x | ~P x} UNION {x | ~Q x}")] THEN
    REWRITE_TAC [UNION_SUBSET, FINITE_UNION] THEN REWRITE_TAC [CONJ_ACI])

  let MONOMIAL_RESTRICT_MUL ← prove
   r"!(m1:V->num) m2 s.
        monomial_restrict s (monomial_mul m1 m2) =
        monomial_mul (monomial_restrict s m1) (monomial_restrict s m2)"
   MONOMIAL_TAC

  let MONOMIAL_MUL_RESTRICT ← prove
   r"!(m:V->num) u v.
        DISJOINT u v
        ==> monomial_mul (monomial_restrict u m) (monomial_restrict v m) =
            monomial_restrict (u UNION v) m"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC RAND_CONV [FUN_EQ_THM] THEN
    REWRITE_TAC [← SET_RULE (← q r"DISJOINT s t <=> !x. ~(x IN s /\ x IN t)")] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q "i:V") THEN
    REWRITE_TAC [monomial_mul, monomial_restrict, IN_UNION] THEN
    MAP_EVERY ASM_CASES_TAC [← q "(i:V) IN u", ← q "(i:V) IN v"] THEN
    ASM_REWRITE_TAC [] THEN ARITH_TAC)

  let MONOMIAL_DIVISOR ← prove
   r"!(s:V->bool) d m.
        monomial s m /\ monomial_divides d m ==> monomial s d"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [monomial, monomial_vars, monomial_divides] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← MESON [FINITE_SUBSET, SUBSET_TRANS]
     (← q r"s SUBSET t ==> FINITE t /\ t SUBSET u ==> FINITE s /\ s SUBSET u")) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, CONTRAPOS_THM] THEN
    POP_ASSUM MP_TAC THEN MATCH_MP_TAC MONO_FORALL THEN ARITH_TAC)

  let MONOMIAL_VAR ← prove
   r"!(s:V->bool) v. monomial s (monomial_var v) <=> v IN s"
   (REWRITE_TAC [monomial, monomial_vars, monomial_var] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    REWRITE_TAC [← MESON [] (← q r"~(if p then F else T) <=> p")] THEN
    REWRITE_TAC [SING_GSPEC, FINITE_SING, SING_SUBSET])

  let MONOMIAL_RESTRICT ← prove
   r"!(s:V->bool) m. FINITE s ==> monomial s (monomial_restrict s m)"
   (REWRITE_TAC [monomial, MONOMIAL_VARS_RESTRICT] THEN
    SIMP_TAC [FINITE_INTER, INTER_SUBSET])

  let MONOMIAL ← prove
   r"monomial (:V) m <=> FINITE(monomial_vars m)"
   (REWRITE_TAC [monomial, SUBSET_UNIV])

  let MONOMIAL_UNIV_1 ← prove
   r"!m:1->num. monomial (:1) m"
   (REWRITE_TAC [MONOMIAL, FINITE_MONOMIAL_VARS_1])

  let MONOMIAL_DEG_1 ← prove
   r"monomial_deg (monomial_1:V->num) = 0"
   (REWRITE_TAC [monomial_deg, MONOMIAL_VARS_1, NSUM_CLAUSES])

  let MONOMIAL_DEG_VAR ← prove
   r"!v:V. monomial_deg (monomial_var v) = 1"
   (REWRITE_TAC [monomial_deg, MONOMIAL_VARS_VAR, NSUM_SING] THEN
    REWRITE_TAC [monomial_var])

  let MONOMIAL_DEG_EQ_0_ALT ← prove
   r"!m. monomial (:V) m ==> (monomial_deg m = 0 <=> m = monomial_1)"
   (REWRITE_TAC [MONOMIAL] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THEN SIMP_TAC [MONOMIAL_DEG_1] THEN
    ASM_SIMP_TAC [monomial_deg, NSUM_EQ_0_IFF] THEN
    REWRITE_TAC [← GSYM MONOMIAL_VARS_EQ_EMPTY, monomial_vars] THEN SET_TAC [])

  let MONOMIAL_DEG_EQ_0 ← prove
   r"!s m. monomial s m ==> (monomial_deg m = 0 <=> m = monomial_1)"
   (SIMP_TAC [monomial, SUBSET_UNIV, MONOMIAL_DEG_EQ_0_ALT])

  let MONOMIAL_DIV_DIVIDES ← prove
   r"!m d:V->num. monomial_divides (monomial_div m d) m"
   MONOMIAL_TAC

  let MONOMIAL_DIV ← prove
   r"!s m d:V->num. monomial s m ==> monomial s (monomial_div m d)"
   (MESON_TAC [MONOMIAL_DIVISOR, MONOMIAL_DIV_DIVIDES])

  let MONOMIAL_DIVIDES_1 ← prove
   r"!m:V->num. monomial_divides monomial_1 m"
   MONOMIAL_TAC

  let MONOMIAL_DIVIDES_EXISTS ← prove
   r"!m1 m2:V->num.
        monomial_divides m1 m2 <=> ?m. m2 = monomial_mul m1 m"
   (MONOMIAL_POINTWISE_TAC THEN REWRITE_TAC [UNWIND_THM2,
     ← ARITH_RULE (← q r"a:num = b + m <=> m = a - b /\ b <= a")] THEN
    ARITH_TAC)

  let MONOMIAL_VAR_DIVIDES_MUL ← prove
   r"!m1 m2 x:V.
        monomial_divides (monomial_var x) (monomial_mul m1 m2) <=>
        monomial_divides (monomial_var x) m1 \/
        monomial_divides (monomial_var x) m2"
   (MONOMIAL_POINTWISE_TAC THEN
    REWRITE_TAC [COND_RAND, COND_RATOR, LE_0] THEN
    SIMP_TAC [← MESON [] (← q r"(if p  then q else true) <=> p ==> q")] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2] THEN ARITH_TAC)

  let MONOMIAL_MUL_EQ_VAR ← prove
   r"!m1 m2 x:V.
        monomial_mul m1 m2 = monomial_var x <=>
        m1 = monomial_var x /\ m2 = monomial_1 \/
        m1 = monomial_1 /\ m2 = monomial_var x"
   (MONOMIAL_POINTWISE_TAC THEN
    REWRITE_TAC [COND_RAND, COND_RATOR, LE_0] THEN
    SIMP_TAC [← MESON [] (← q r"(if p then x else y) <=> (p ==> x) /\ (~p ==> y)")] THEN
    SIMP_TAC [FORALL_AND_THM, FORALL_UNWIND_THM2, ADD_EQ_0] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [] THEN ASM_ARITH_TAC)

  let MONOMIAL_DEG_MUL ← prove
   r"!(m1:V->num) m2.
        monomial (:V) m1 /\ monomial (:V) m2
        ==> monomial_deg(monomial_mul m1 m2) =
            monomial_deg m1 + monomial_deg m2"
   (REWRITE_TAC [monomial, monomial_vars] THEN
    REPEAT STRIP_TAC THEN
    REWRITE_TAC [monomial_deg, monomial_vars, monomial_mul, ADD_EQ_0] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{i | ~(P i /\ Q i)} = {i | ~P i} UNION {i | ~Q i}")] THEN
    ASM_SIMP_TAC [NSUM_ADD, FINITE_UNION] THEN BINOP_TAC THEN
    MATCH_MP_TAC NSUM_SUPERSET THEN SET_TAC [])

  let MONOMIAL_DEG_LE ← prove
   r"!(m1:V->num) m2.
        monomial (:V) m2 /\
        monomial_divides m1 m2
        ==> monomial_deg m1 <= monomial_deg m2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [MONOMIAL, CONJ_ASSOC, monomial_vars] THEN
    ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN
    REWRITE_TAC [MONOMIAL_DIVIDES_EXISTS, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"m:V->num") THEN DISCH_THEN SUBST1_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [monomial_mul] THEN
    REWRITE_TAC [ADD_EQ_0, FINITE_UNION, ← SET_RULE
     (← q r"{i | ~(P i /\ Q i)} = {i | ~P i} UNION {i | ~Q i}")] THEN
    SIMP_TAC [MONOMIAL_DEG_MUL, MONOMIAL, ← GSYM monomial_vars, LE_ADD])

  let MONOMIAL_VAR_EQ ← prove
   r"!v w:V. monomial_var v = monomial_var w <=> v = w"
   (REWRITE_TAC [monomial_var, FUN_EQ_THM] THEN
    MESON_TAC [← ExceptT.mk (NUM_REDUCE_CONV (← q "1 = 0"))])

  let MONOMIAL_MUL_LID ← prove
   r"!m:V->num. monomial_mul monomial_1 m = m"
   MONOMIAL_TAC

  let MONOMIAL_MUL_RID ← prove
   r"!m:V->num. monomial_mul m monomial_1 = m"
   MONOMIAL_TAC

  let MONOMIAL_MUL_SYM ← prove
   r"!m1 m2:V->num.
        monomial_mul m1 m2 = monomial_mul m2 m1"
   MONOMIAL_TAC

  let MONOMIAL_MUL_ASSOC ← prove
   r"!m1 m2 m3:V->num.
        monomial_mul m1 (monomial_mul m2 m3) =
        monomial_mul (monomial_mul m1 m2) m3"
   MONOMIAL_TAC

  let MONOMIAL_MUL_AC ← prove
   r"(!m1 m2. monomial_mul m1 m2 = monomial_mul m2 m1) /\
   (!m1 m2 m3. monomial_mul (monomial_mul m1 m2) m3 =
            monomial_mul m1 (monomial_mul m2 m3)) /\
   (!m1 m2 m3. monomial_mul m1 (monomial_mul m2 m3) =
            monomial_mul m2 (monomial_mul m1 m3))"
   MONOMIAL_TAC

  let MONOMIAL_MUL_EQ_1 ← prove
   r"!m1 m2:V->num.
        monomial_mul m1 m2 = monomial_1 <=>
        m1 = monomial_1 /\ m2 = monomial_1"
   MONOMIAL_TAC

  let MONOMIAL_MUL_LCANCEL ← prove
   r"!m m1 m2:V->num. monomial_mul m m1 = monomial_mul m m2 <=> m1 = m2"
   MONOMIAL_TAC

  let MONOMIAL_MUL_RCANCEL ← prove
   r"!m m1 m2:V->num. monomial_mul m1 m = monomial_mul m2 m <=> m1 = m2"
   MONOMIAL_TAC

  let MONOMIAL_DIVIDES_REFL ← prove
   r"!m:V->num. monomial_divides m m"
   MONOMIAL_TAC

  let MONOMIAL_DIVIDES_TRANS ← prove
   r"!m1 m2 m3:V->num.
        monomial_divides m1 m2 /\ monomial_divides m2 m3
        ==> monomial_divides m1 m3"
   MONOMIAL_TAC

  let MONOMIAL_DIVIDES_ANTISYM ← prove
   r"!m1 m2:V->num.
        monomial_divides m1 m2 /\ monomial_divides m2 m1 <=> m1 = m2"
   MONOMIAL_TAC

  let MONOMIAL_DIVIDES_LMUL ← prove
   r"!d m1 m2:V->num.
        monomial_divides d m2 ==> monomial_divides d (monomial_mul m1 m2)"
   MONOMIAL_TAC

  let MONOMIAL_DIVIDES_RMUL ← prove
   r"!d m1 m2:V->num.
        monomial_divides d m1 ==> monomial_divides d (monomial_mul m1 m2)"
   MONOMIAL_TAC

  let MONOMIAL_DIV_LMUL_EQ ← prove
   r"!m1 m2:V->num.
        monomial_mul m2 (monomial_div m1 m2) = m1 <=> monomial_divides m2 m1"
   MONOMIAL_TAC

  let MONOMIAL_DIV_LMUL ← prove
   r"!m1 m2:V->num.
        monomial_divides m2 m1 ==> monomial_mul m2 (monomial_div m1 m2) = m1"
   MONOMIAL_TAC

  let MONOMIAL_DIV_RMUL_EQ ← prove
   r"!m1 m2:V->num.
        monomial_mul (monomial_div m1 m2) m2 = m1 <=> monomial_divides m2 m1"
   MONOMIAL_TAC

  let MONOMIAL_DIV_RMUL ← prove
   r"!m1 m2:V->num.
        monomial_divides m2 m1 ==> monomial_mul (monomial_div m1 m2) m2 = m1"
   MONOMIAL_TAC

  let MONOMIAL_VAR_DIVIDES ← prove
   r"!m v:V. monomial_divides (monomial_var v) m <=> v IN monomial_vars m"
   (REPEAT GEN_TAC THEN REWRITE_TAC [monomial_divides, monomial_var] THEN
    REWRITE_TAC [monomial_vars, IN_ELIM_THM] THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o SPEC (← q "v:V")) THEN REWRITE_TAC [] THEN ARITH_TAC,
      DISCH_TAC THEN GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_ARITH_TAC])

  let MONOMIAL_VARS_DIVISOR ← prove
   r"!d m:V->num.
        monomial_divides d m ==> monomial_vars d SUBSET monomial_vars m"
   (REPEAT GEN_TAC THEN REWRITE_TAC [monomial_divides, monomial_vars] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, CONTRAPOS_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN ARITH_TAC)

  let MONOMIAL_FINITE_DIVISORS ← prove
   r"!m:V->num. FINITE {d | monomial_divides d m} <=> FINITE(monomial_vars m)"
   (GEN_TAC THEN EQ_TAC THENL
     [MP_TAC (← ISPECL
       [← q r"monomial_var:V->V->num", ← q r"monomial_vars m:V->bool"]
        FINITE_IMAGE_INJ_EQ) THEN
      SIMP_TAC [MONOMIAL_VAR_EQ] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, monomial_vars, IN_ELIM_THM] THEN
      REWRITE_TAC [monomial_divides, monomial_var] THEN
      REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_ARITH_TAC,
      REWRITE_TAC [monomial_vars] THEN DISCH_TAC THEN
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"cartesian_product UNIV (\i:V. 0..m i)") THEN
      REWRITE_TAC [FINITE_CARTESIAN_PRODUCT, FINITE_NUMSEG, IN_UNIV] THEN
       REWRITE_TAC [SUBSET, monomial_divides, IN_CARTESIAN_PRODUCT] THEN
       SIMP_TAC [EXTENSIONAL_UNIV, IN_UNIV, IN_ELIM_THM, IN_NUMSEG, LE_0] THEN
       DISJ2_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
          (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
       REWRITE_TAC [SUBSET, IN_ELIM_THM, CONTRAPOS_THM, IN_SING] THEN
       MESON_TAC [LE]])

  let MONOMIAL_FINITE_DIVISORPAIRS ← prove
   r"!m:V->num. FINITE {(m1,m2) | monomial_mul m1 m2 = m} <=>
              FINITE(monomial_vars m)"
   (GEN_TAC THEN REWRITE_TAC [← GSYM MONOMIAL_FINITE_DIVISORS] THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o ISPEC (← q r"FST:(V->num)#(V->num)->V->num") o
          MATCH_MP FINITE_IMAGE) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
      REWRITE_TAC [SUBSET, IN_IMAGE] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [EXISTS_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"n:V->num") THEN REWRITE_TAC [monomial_mul, monomial_divides] THEN
      DISCH_TAC THEN MAP_EVERY EXISTS_TAC
       [← q r"n:V->num", ← q r"\v. (m:V->num) v - n v"] THEN
      ASM_REWRITE_TAC [FUN_EQ_THM, ← ARITH_RULE (← q r"n + m - n:num = m <=> n <= m")],
      DISCH_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC
       (← q r"{d:V->num | monomial_divides d m} CROSS {d | monomial_divides d m}") THEN
      ASM_REWRITE_TAC [FINITE_CROSS_EQ] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [IN_CROSS, IN_ELIM_THM] THEN
      MESON_TAC [MONOMIAL_DIVIDES_LMUL, MONOMIAL_DIVIDES_RMUL,
                 MONOMIAL_DIVIDES_REFL]])

  let MONOMIAL_INDUCT ← prove
   r"!s (P:(V->num)->bool).
        P monomial_1 /\
        (!m v. monomial s m /\ P m /\ v IN s
               ==> P(monomial_mul (monomial_var v) m))
        ==> !m. monomial s m ==> P m"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!d m:V->num. monomial s m /\ monomial_deg m = d ==> P m")
    MP_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    MATCH_MP_TAC num_INDUCTION THEN
    CONJ_TAC THENL [ASM_MESON_TAC [MONOMIAL_DEG_EQ_0], ALL_TAC] THEN
    X_GEN_TAC (← q "d:num") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"m:V->num") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(monomial_vars(m:V->num) = {})") MP_TAC THENL
     [ASM_MESON_TAC [MONOMIAL_VARS_EQ_EMPTY, MONOMIAL_DEG_1, NOT_SUC],
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q "v:V") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o
     SPECL [← q "monomial_div m (monomial_var(v:V))", ← q "v:V"]) THEN
    ASM_SIMP_TAC [MONOMIAL_DIV_LMUL, MONOMIAL_VAR_DIVIDES] THEN
    DISCH_THEN MATCH_MP_TAC THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [MONOMIAL_DIVISOR, MONOMIAL_DIV_DIVIDES],
      FIRST_X_ASSUM MATCH_MP_TAC,
      RULE_ASSUM_TAC (REWRITE_RULE [monomial]) THEN ASM SET_TAC []] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [MONOMIAL_DIVISOR, MONOMIAL_DIV_DIVIDES],
      GEN_REWRITE_TAC id [← GSYM SUC_INJ]] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN TRANS_TAC EQ_TRANS
     (← q r"monomial_deg(monomial_mul (monomial_var v)
                              (monomial_div m (monomial_var v)):V->num)") THEN
    CONJ_TAC THENL
     [ALL_TAC, ASM_SIMP_TAC [MONOMIAL_DIV_LMUL, MONOMIAL_VAR_DIVIDES]] THEN
    wPart rand (fun t => do lhand (← rand t)) MONOMIAL_DEG_MUL THEN
    ANTS_TAC THENL
     [REWRITE_TAC [← GSYM MONOMIAL, MONOMIAL_VAR, IN_UNIV] THEN
      MATCH_MP_TAC MONOMIAL_DIV THEN ASM_MESON_TAC [MONOMIAL_UNIV],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [MONOMIAL_DEG_VAR] THEN ARITH_TAC])

  let MONOMIAL_VARS_UNIVARIATE ← prove
   r"!i. monomial_vars(\v:1. i) = if i = 0 then {} else {one}"
   (GEN_TAC THEN REWRITE_TAC [monomial_vars] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [EMPTY_GSPEC, UNIV_GSPEC, UNIV_1])

  let MONOMIAL_DEG_UNIVARIATE ← prove
   r"!i. monomial_deg(\v:1. i) = i"
   (GEN_TAC THEN REWRITE_TAC [monomial_deg, MONOMIAL_VARS_UNIVARIATE] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [NSUM_CLAUSES, NSUM_SING])

  let MONOMIAL_MUL_VAR_ONE ← prove
   r"!n. monomial_mul (monomial_var (one:1)) (\v:1. n) = (\v:1. n + 1)"
   (GEN_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, FORALL_ONE_THM, monomial_mul,
                 monomial_var] THEN
    ARITH_TAC)

  let MONOMIAL_DEG_ONE ← prove
   r"!m:1->num. monomial_deg m = m one"
   (GEN_TAC THEN
    SUBGOAL_THEN (← q r"m:1->num = (\v:1. m one)") SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, FORALL_ONE_THM],
      REWRITE_TAC [MONOMIAL_DEG_UNIVARIATE]])

  -- @@RETURN BEGIN
  return { monomial_1, monomial_mul, monomial_div, monomial_restrict, monomial_divides,
           monomial_var, monomial_vars, monomial_deg, monomial, MONOMIAL_POINTWISE_TAC,
           MONOMIAL_TAC, MONOMIAL_RULE, FINITE_MONOMIAL_VARS, FINITE_MONOMIAL_VARS_1,
           MONOMIAL_DEG, MONOMIAL_VAR_1, MONOMIAL_VARS_1, MONOMIAL_VARS_EQ_EMPTY,
           MONOMIAL_VARS_MUL, MONOMIAL_VARS_VAR, MONOMIAL_VARS_RESTRICT,
           MONOMIAL_RESTRICT_EQ, MONOMIAL_RESTRICT_REFL, MONOMIAL_MONO, MONOMIAL_UNIV,
           MONOMIAL_1, MONOMIAL_MUL, MONOMIAL_RESTRICT_MUL, MONOMIAL_MUL_RESTRICT,
           MONOMIAL_DIVISOR, MONOMIAL_VAR, MONOMIAL_RESTRICT, MONOMIAL, MONOMIAL_UNIV_1,
           MONOMIAL_DEG_1, MONOMIAL_DEG_VAR, MONOMIAL_DEG_EQ_0_ALT, MONOMIAL_DEG_EQ_0,
           MONOMIAL_DIV_DIVIDES, MONOMIAL_DIV, MONOMIAL_DIVIDES_1,
           MONOMIAL_DIVIDES_EXISTS, MONOMIAL_VAR_DIVIDES_MUL, MONOMIAL_MUL_EQ_VAR,
           MONOMIAL_DEG_MUL, MONOMIAL_DEG_LE, MONOMIAL_VAR_EQ, MONOMIAL_MUL_LID,
           MONOMIAL_MUL_RID, MONOMIAL_MUL_SYM, MONOMIAL_MUL_ASSOC, MONOMIAL_MUL_AC,
           MONOMIAL_MUL_EQ_1, MONOMIAL_MUL_LCANCEL, MONOMIAL_MUL_RCANCEL,
           MONOMIAL_DIVIDES_REFL, MONOMIAL_DIVIDES_TRANS, MONOMIAL_DIVIDES_ANTISYM,
           MONOMIAL_DIVIDES_LMUL, MONOMIAL_DIVIDES_RMUL, MONOMIAL_DIV_LMUL_EQ,
           MONOMIAL_DIV_LMUL, MONOMIAL_DIV_RMUL_EQ, MONOMIAL_DIV_RMUL,
           MONOMIAL_VAR_DIVIDES, MONOMIAL_VARS_DIVISOR, MONOMIAL_FINITE_DIVISORS,
           MONOMIAL_FINITE_DIVISORPAIRS, MONOMIAL_INDUCT, MONOMIAL_VARS_UNIVARIATE,
           MONOMIAL_DEG_UNIVARIATE, MONOMIAL_MUL_VAR_ONE, MONOMIAL_DEG_ONE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- General power series / polynomial sets and operations.                    -/
/- (ringtheory.ml 17979-18576)                                               -/
/- ------------------------------------------------------------------------- -/

structure PowerSeries where
  -- @@FIELDS
  ring_powerseries : thm
  ring_polynomial : thm
  RING_POLYNOMIAL_IMP_POWERSERIES : thm
  poly_vars : thm
  poly_const : thm
  poly_0 : thm
  poly_1 : thm
  poly_neg : thm
  poly_add : thm
  poly_sub : thm
  poly_mul : thm
  poly_var : thm
  POLY_SUB : thm
  RING_POWERSERIES_MONOMIAL : thm
  RING_POLYNOMIAL_MONOMIAL : thm
  POLY_0 : thm
  POLY_CONST_0 : thm
  POLY_CONST_1 : thm
  RING_POWERSERIES_CONST : thm
  RING_POWERSERIES_VAR : thm
  RING_POWERSERIES_0 : thm
  RING_POWERSERIES_1 : thm
  POLY_VAR_MONOMIAL_1 : thm
  RING_POWERSERIES_NEG : thm
  RING_POWERSERIES_ADD : thm
  RING_POWERSERIES_SUB : thm
  RING_POWERSERIES_MUL : thm
  RING_POLYNOMIAL_CONST : thm
  RING_POLYNOMIAL_VAR : thm
  POLY_VAR_EQ_CONST : thm
  RING_POLYNOMIAL_0 : thm
  RING_POLYNOMIAL_1 : thm
  RING_POLYNOMIAL_NEG : thm
  RING_POLYNOMIAL_ADD : thm
  RING_POLYNOMIAL_SUB : thm
  RING_POLYNOMIAL_MUL : thm
  POLY_ADD_SYM : thm
  POLY_ADD_ASSOC : thm
  POLY_ADD_LZERO : thm
  POLY_ADD_RZERO : thm
  POLY_ADD_LNEG : thm
  POLY_MUL_SYM : thm
  POLY_ADD_LDISTRIB : thm
  POLY_MUL_LID : thm
  POLY_MUL_RID : thm
  POLY_MUL_ASSOC : thm
  POWSER_MUL_0 : thm
  POLY_MUL_0 : thm
  POWSER_MUL_MONOMIAL_1 : thm
  POLY_MUL_MONOMIAL_1 : thm
  POWSER_MUL_CONST : thm
  POLY_MUL_CONST : thm
  POWSER_VAR_MUL : thm
  POWSER_MUL_VAR : thm
  POLY_VAR_MUL : thm
  POLY_MUL_VAR : thm
  POLY_VARS_CONST : thm
  POLY_VARS_0 : thm
  POLY_VARS_1 : thm
  POLY_VARS_VAR : thm
  POLY_VARS_NEG : thm
  POLY_VARS_ADD : thm
  POLY_VARS_MUL : thm
  FINITE_POLYNOMIAL_VARS : thm
  deriving Inhabited

@[nospecialize]
def setupPowerSeries [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BSums : Sums) (BRingRule : RingRule) (BMonomials : Monomials) :
    ExceptT String IO PowerSeries := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { COND_ID, .. } := D.core1
  let { COND_RAND, COND_RATOR, CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, EMPTY_GSPEC,
        EQ_IMP, .. } := D.core2
  let { FINITE_EMPTY, FINITE_IMAGE, FINITE_PRODUCT_DEPENDENT, FINITE_SING,
        FINITE_SUBSET, FINITE_UNION, FINITE_UNIONS, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FORALL_PAIR_THM, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_SUBSET, .. } := D.core3
  let { IMAGE_UNION, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INFINITE, .. } := D.core4
  let { IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_ELIM_TRIPLE_THM, IN_SING, IN_UNION,
        LAMBDA_PAIR, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, PAIR_EQ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SING_GSPEC, SUBSET, SUBSET_UNIONS,
        SUBSET_UNIV, UNIONS_0, UNIONS_1, UNIONS_GSPEC, UNIONS_UNION, .. } := D.core7
  let { RING_0, RING_1, RING_ADD, RING_ADD_LZERO, RING_ADD_RZERO, RING_MUL,
        RING_MUL_LID, RING_MUL_LZERO, RING_MUL_RZERO, RING_NEG, RING_NEG_0,
        RING_NEG_EQ_0, RING_SUB, RING_SUB_RZERO, TRIVIAL_RING_10, ring_sub, .. } := BBasics
  let { RING_SUM, RING_SUM_ADD, RING_SUM_CLAUSES, RING_SUM_EQ, RING_SUM_EQ_0,
        RING_SUM_EQ_GENERAL_INVERSES, RING_SUM_LMUL, RING_SUM_RESTRICT_SET,
        RING_SUM_SING, RING_SUM_SUM_PRODUCT, RING_SUM_SUPERSET, .. } := BSums
  let { RING_RULE, RING_TAC, .. } := BRingRule
  let { MONOMIAL_FINITE_DIVISORPAIRS, MONOMIAL_MUL_AC, MONOMIAL_MUL_EQ_1,
        MONOMIAL_MUL_LID, MONOMIAL_MUL_SYM, MONOMIAL_TAC, MONOMIAL_VARS_1,
        MONOMIAL_VARS_MUL, MONOMIAL_VARS_VAR, MONOMIAL_VAR_1, monomial, .. } := BMonomials
  -- @@SCOPE END

  let ring_powerseries ← new_definition
   r"ring_powerseries r p <=>
        (!m. p m IN ring_carrier r) /\
        !m. INFINITE(monomial_vars m) ==> p m = ring_0 r"

  let ring_polynomial ← new_definition
   r"ring_polynomial r p <=>
        ring_powerseries r p /\ FINITE {m | ~(p m = ring_0 r)}"

  let RING_POLYNOMIAL_IMP_POWERSERIES ← prove
   r"!r (p:(V->num)->A). ring_polynomial r p ==> ring_powerseries r p"
   (SIMP_TAC [ring_polynomial])

  let poly_vars ← new_definition
   r"poly_vars r p = UNIONS { monomial_vars m | ~(p m = ring_0 r)}"

  let poly_const ← new_definition
   r"poly_const (r:A ring) (c:A) =
        \m:V->num. if m = monomial_1 then c else ring_0 r"

  let poly_0 ← new_definition
   r"poly_0 (r:A ring) = poly_const r (ring_0 r)"

  let poly_1 ← new_definition
   r"poly_1 (r:A ring) = poly_const r (ring_1 r)"

  let poly_neg ← new_definition
   r"poly_neg (r:A ring) p = \m:V->num. ring_neg r (p m)"

  let poly_add ← new_definition
   r"poly_add (r:A ring) p1 p2 = \m:V->num. ring_add r (p1 m) (p2 m)"

  let poly_sub ← new_definition
   r"poly_sub (r:A ring) p1 p2 = \m:V->num. ring_sub r (p1 m) (p2 m)"

  let poly_mul ← new_definition
   r"poly_mul (r:A ring) p1 p2 =
        \m:V->num. ring_sum r {(m1,m2) | monomial_mul m1 m2 = m}
                              (\(m1,m2). ring_mul r (p1 m1) (p2 m2))"

  let poly_var ← new_definition
   r"poly_var (r:A ring) (v:V) =
        \m:V->num. if m = monomial_var v then ring_1 r else ring_0 r"

  let POLY_SUB ← prove
   r"!r (p:(V->num)->A) q. poly_sub r p q = poly_add r p (poly_neg r q)"
   (REWRITE_TAC [poly_sub, poly_add, poly_neg, ring_sub])

  let RING_POWERSERIES_MONOMIAL ← prove
   r"!r p m. ring_powerseries r p /\ ~(p m:A = ring_0 r) ==> monomial (:V) m"
   (REWRITE_TAC [ring_powerseries, monomial, SUBSET_UNIV, INFINITE] THEN
    MESON_TAC [])

  let RING_POLYNOMIAL_MONOMIAL ← prove
   r"!r p m. ring_polynomial r p /\ ~(p m:A = ring_0 r) ==> monomial (:V) m"
   (MESON_TAC [ring_polynomial, RING_POWERSERIES_MONOMIAL])

  let POLY_0 ← prove
   r"!r. poly_0 r :(V->num)->A = \m. ring_0 r"
   (REWRITE_TAC [poly_0, poly_const, COND_ID])

  let POLY_CONST_0 ← prove
   r"!r:A ring. poly_const r (ring_0 r):(V->num)->A = poly_0 r"
   (REWRITE_TAC [poly_const, poly_0, COND_ID])

  let POLY_CONST_1 ← prove
   r"!r:A ring. poly_const r (ring_1 r):(V->num)->A = poly_1 r"
   (REWRITE_TAC [poly_const, poly_1, COND_ID])

  let RING_POWERSERIES_CONST ← prove
   r"!r c. ring_powerseries r (poly_const r c :(V->num)->A) <=>
         c IN ring_carrier r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_powerseries, poly_const] THEN
    REWRITE_TAC [COND_RATOR, COND_RAND] THEN
    SIMP_TAC [RING_0, MONOMIAL_VARS_1, INFINITE, FINITE_EMPTY, COND_ID] THEN
    MESON_TAC [])

  let RING_POWERSERIES_VAR ← prove
   r"!r v. ring_powerseries r (poly_var r v:(V->num)->A)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_powerseries, poly_var] THEN
    REWRITE_TAC [COND_RATOR, COND_RAND] THEN
    SIMP_TAC [RING_0, RING_1, MONOMIAL_VARS_VAR, INFINITE, FINITE_SING] THEN
    REWRITE_TAC [COND_ID])

  let RING_POWERSERIES_0 ← prove
   r"!r. ring_powerseries r (poly_0 r:(V->num)->A)"
   (REWRITE_TAC [poly_0, RING_POWERSERIES_CONST, RING_0])

  let RING_POWERSERIES_1 ← prove
   r"!r. ring_powerseries r (poly_1 r:(V->num)->A)"
   (REWRITE_TAC [poly_1, RING_POWERSERIES_CONST, RING_1])

  let POLY_VAR_MONOMIAL_1 ← prove
   r"!(r:A ring) (v:V).
     (poly_var r v:(V->num)->A) monomial_1 = ring_0 r"
   (REWRITE_TAC [poly_var, MONOMIAL_VAR_1])

  let RING_POWERSERIES_NEG ← prove
   r"!r (p:(V->num)->A).
        ring_powerseries r p ==> ring_powerseries r (poly_neg r p)"
   (SIMP_TAC [ring_powerseries, poly_neg, RING_NEG, RING_NEG_0])

  let RING_POWERSERIES_ADD ← prove
   r"!r p1 (p2:(V->num)->A).
        ring_powerseries r p1 /\ ring_powerseries r p2
        ==> ring_powerseries r (poly_add r p1 p2)"
   (SIMP_TAC [ring_powerseries, poly_add, RING_ADD, RING_0, RING_ADD_LZERO])

  let RING_POWERSERIES_SUB ← prove
   r"!r p1 (p2:(V->num)->A).
        ring_powerseries r p1 /\ ring_powerseries r p2
        ==> ring_powerseries r (poly_sub r p1 p2)"
   (SIMP_TAC [ring_powerseries, poly_sub, RING_SUB, RING_0, RING_SUB_RZERO])

  let RING_POWERSERIES_MUL ← prove
   r"!r p1 (p2:(V->num)->A).
        ring_powerseries r p1 /\ ring_powerseries r p2
        ==> ring_powerseries r (poly_mul r p1 p2)"
   (SIMP_TAC [ring_powerseries, poly_mul, RING_SUM] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"m:V->num") THEN DISCH_TAC THEN
    MATCH_MP_TAC RING_SUM_EQ_0 THEN REWRITE_TAC [FORALL_IN_GSPEC, IMP_CONJ] THEN
    REPEAT GEN_TAC THEN
    DISCH_THEN (SUBST_ALL_TAC o SYM) THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [MONOMIAL_VARS_MUL, INFINITE, FINITE_UNION]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM INFINITE, DE_MORGAN_THM]) THEN
    FIRST_X_ASSUM DISJ_CASES_TAC THEN
    ASM_SIMP_TAC [RING_MUL_LZERO, RING_MUL_RZERO])

  let RING_POLYNOMIAL_CONST ← prove
   r"!r c. ring_polynomial r (poly_const r c :(V->num)->A) <=>
         c IN ring_carrier r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_polynomial, RING_POWERSERIES_CONST] THEN
    MATCH_MP_TAC (← TAUT (← q r"q ==> (p /\ q <=> p)")) THEN
    MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{(monomial_1:V->num)}") THEN
    REWRITE_TAC [FINITE_SING, SUBSET, IN_ELIM_THM, IN_SING] THEN
    REWRITE_TAC [poly_const] THEN MESON_TAC [])

  let RING_POLYNOMIAL_VAR ← prove
   r"!r v. ring_polynomial r (poly_var r v:(V->num)->A)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_polynomial, RING_POWERSERIES_VAR] THEN
    MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{(monomial_var v:V->num)}") THEN
    REWRITE_TAC [FINITE_SING, SUBSET, IN_ELIM_THM, IN_SING] THEN
    REWRITE_TAC [poly_var] THEN MESON_TAC [])

  let POLY_VAR_EQ_CONST ← prove
   r"!(r:A ring) (v:V) c.
        poly_var r v = poly_const r c <=> trivial_ring r /\ c = ring_0 r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [poly_var, poly_const, TRIVIAL_RING_10] THEN
    EQ_TAC THEN SIMP_TAC [COND_ID] THEN
    GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN DISCH_THEN (fun th => tactic_of do
      let t1 ← SPEC (← q r"monomial_1:V->num") th
      let tv ← SPEC (← q "monomial_var (v:V)") th
      pure (MP_TAC tv THEN MP_TAC t1)) THEN
    REWRITE_TAC [MONOMIAL_VAR_1] THEN MESON_TAC [])

  let RING_POLYNOMIAL_0 ← prove
   r"!r. ring_polynomial r (poly_0 r:(V->num)->A)"
   (REWRITE_TAC [poly_0, RING_POLYNOMIAL_CONST, RING_0])

  let RING_POLYNOMIAL_1 ← prove
