        ==> ring_0 r = ring_sum (powser_ring r t) s f m")
    let s2 ← SET_RULE
       (← q r"{x | x IN s /\ P x} = {x | x IN {y | P y} /\ x IN s}")
    let m1 ← MESON []
       (← q r"~((if p then x else 0) = 0) <=> p /\ ~(x = 0)")
    pure (MAP_EVERY X_GEN_TAC [← q "r:A ring", ← q r"v:V->bool", ← q r"u:V->bool"] THEN
