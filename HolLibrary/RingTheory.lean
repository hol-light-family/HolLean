     STRIP_ASSUME_TAC THENL
      [UNDISCH_TAC (← q r"(z:A#A->bool) IN ring_carrier (ring_localization r s)") THEN
       ASM_SIMP_TAC [RING_LOCALIZATION_CARRIER, IN_ELIM_THM] THEN MESON_TAC [],
       ALL_TAC] THEN
     SUBGOAL_THEN (← q r"(alpha:A->B) a = ring_0 r'") ASSUME_TAC THENL
     [USE_THEN "germ" (MP_TAC o SPECL [← q "a:A", ← q "b:A"]) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      SUBST1_TAC (← SYM (← ASSUME (← q "z = ring_localequiv r s (a:A,b)"))) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC RING_MUL_LZERO THEN ASM_MESON_TAC [RING_UNIT_IN_CARRIER],
      ALL_TAC] THEN
     ASM_REWRITE_TAC [] THEN MP_TAC (← ISPECL
      [← q "r:A ring", ← q r"s:A->bool", ← q "a:A", ← q "b:A"] RING_LOCALEQUIV_EQ_0_GEN) THEN
     ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
     FIRST_X_ASSUM (← do
       let z0 ← q "ring_0 r:A"
