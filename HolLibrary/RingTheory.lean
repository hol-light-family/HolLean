       EXISTS_TAC (← q "g:(1->num)->A") THEN CONJ_TAC THENL
       [ASM_REWRITE_TAC [RING_PRIME_IDEAL] THEN
        SUBGOAL_THEN (← q "ideal_generated (poly_ring r (:1)) {g:(1->num)->A} = j")
