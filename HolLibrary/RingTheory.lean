    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"~(q:(V->num)->A = poly_0 r)") THEN
      ASM_SIMP_TAC [← CONJUNCT1 POLY_MUL_0, ← CONJUNCT2 POLY_MUL_0],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"poly_deg r (poly_mul r (p:(V->num)->A) (x:(V->num)->A)) =
