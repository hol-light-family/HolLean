    let s6 ← SET_RULE
     (← q r"{x | x IN {f a b | P a b} /\ Q x} = {f a b |a,b| P a b /\ Q(f a b)}")
    let m5 ← MESON [RING_0, RING_MUL_LZERO, RING_MUL_RZERO]
