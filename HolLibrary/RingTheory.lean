  SUBRING_OF_SETWISE : thm
  RING_IDEAL_SETWISE : thm
  RING_SETNEG_EQ_EMPTY : thm
  RING_SETADD_EQ_EMPTY : thm
  RING_SETMUL_EQ_EMPTY : thm
  RING_SETNEG_SING : thm
  RING_SETADD_SING : thm
