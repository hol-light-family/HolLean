        p IN ring_carrier(poly_ring r (:1)) /\
        d IN ring_carrier(poly_ring r (:1)) /\
        ring_unit r (coeff (poly_deg r d) d)
        ==> poly_div r p d IN ring_carrier(poly_ring r (:1)) /\
            poly_rem r p d IN ring_carrier(poly_ring r (:1)) /\
            (poly_deg r (poly_rem r p d) < poly_deg r d \/
             poly_rem r p d = ring_0(poly_ring r (:1))) /\
            ring_add (poly_ring r (:1))
                     (ring_mul (poly_ring r (:1)) (poly_div r p d) d)
                     (poly_rem r p d) = p"
   (← do
    -- right to left: the RING_RULE, then the REWRITE_CONV
    let rr ← RING_RULE (← q r"ring_sub r p x = t <=> ring_add r x t = p")
    let rc ← REWRITE_CONV [poly_div] (← q "poly_div (r:A ring) p d")
    pure (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP POLY_DIVISION_GEN) THEN
    DISCH_THEN (MP_TAC o SELECT_RULE) THEN
    MP_TAC rc THEN
    ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q "t:(1->num)->A") (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC))) THEN
    SUBGOAL_THEN (← q "poly_rem (r:A ring) p d = t")
     (fun th => ASM_REWRITE_TAC [th]) THEN
    REWRITE_TAC [poly_rem] THEN
    ASM_SIMP_TAC [RING_MUL, rr]))

  let POLY_DIV ← prove
   r"!(r:A ring) p d.
        p IN ring_carrier(poly_ring r (:1)) /\
        d IN ring_carrier(poly_ring r (:1))
        ==> poly_div r p d IN ring_carrier(poly_ring r (:1))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q "ring_unit r (coeff (poly_deg r d) d:A)") THENL
     [ASM_SIMP_TAC [POLY_DIV_REM],
      ASM_REWRITE_TAC [poly_div, RING_0]])

  let RING_POLYNOMIAL_DIV ← prove
   r"!(r:A ring) p d.
        ring_polynomial r p /\ ring_polynomial r d
        ==> ring_polynomial r (poly_div r p d)"
   (REWRITE_TAC [RING_POLYNOMIAL, POLY_DIV])

  let POLY_REM ← prove
   r"!(r:A ring) p d.
        p IN ring_carrier(poly_ring r (:1)) /\
        d IN ring_carrier(poly_ring r (:1))
        ==> poly_rem r p d IN ring_carrier(poly_ring r (:1))"
   (SIMP_TAC [poly_rem, POLY_DIV, RING_MUL, RING_SUB])

  let RING_POLYNOMIAL_REM ← prove
   r"!(r:A ring) p d.
        ring_polynomial r p /\ ring_polynomial r d
        ==> ring_polynomial r (poly_rem r p d)"
   (REWRITE_TAC [RING_POLYNOMIAL, POLY_REM])

  let POLY_DIV_REM_SIMP ← prove
   r"!(r:A ring) p d.
        p IN ring_carrier(poly_ring r (:1)) /\
        d IN ring_carrier(poly_ring r (:1))
        ==> ring_add (poly_ring r (:1))
                     (ring_mul (poly_ring r (:1)) (poly_div r p d) d)
                     (poly_rem r p d) = p"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q "ring_unit r (coeff (poly_deg r d) d:A)") THEN
    ASM_SIMP_TAC [POLY_DIV_REM] THEN
    ASM_REWRITE_TAC [poly_rem, poly_div] THEN REPEAT (POP_ASSUM MP_TAC) THEN
    SPEC_TAC (← q "poly_ring (r:A ring) (:1)", ← q "R:((1->num)->A)ring") THEN
    RING_TAC)

  let POLY_DEG_REM ← prove
   r"!(r:A ring) p d.
        p IN ring_carrier(poly_ring r (:1)) /\
        d IN ring_carrier(poly_ring r (:1)) /\
        ring_unit r (coeff (poly_deg r d) d)
        ==> poly_deg r (poly_rem r p d) < poly_deg r d \/
            poly_rem r p d = ring_0(poly_ring r (:1))"
   (MESON_TAC [POLY_DIV_REM])

  let POLY_DEG_REM_ALT ← prove
   r"!(k:A ring) p d.
        field k /\
        p IN ring_carrier(poly_ring k (:1)) /\
        d IN ring_carrier(poly_ring k (:1)) /\
        ~(d = ring_0(poly_ring k (:1)))
        ==> poly_deg k (poly_rem k p d) < poly_deg k d \/
            poly_rem k p d = ring_0(poly_ring k (:1))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC POLY_DEG_REM THEN
    ASM_MESON_TAC [FIELD_UNIT, POLY_TOP_EQ_0, RING_POLYNOMIAL,
                   POLY_CLAUSES, COEFF_IN_CARRIER_ALT])

  let POLY_DIVIDES_REM ← prove
   r"!(r:A ring) p d.
        p IN ring_carrier(poly_ring r (:1)) /\
        d IN ring_carrier(poly_ring r (:1))
        ==> ring_divides (poly_ring r (:1)) d
               (ring_sub (poly_ring r (:1)) p (poly_rem r p d))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP POLY_DIV_REM_SIMP) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← SYM th])) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP POLY_DIV) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP POLY_REM) THEN
    ASM_SIMP_TAC [ring_divides] THEN CONJ_TAC THENL
     [RING_CARRIER_TAC THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q "poly_div (r:A ring) p d") THEN
    ASM_SIMP_TAC [POLY_DIV] THEN REPEAT (POP_ASSUM MP_TAC) THEN
    SPEC_TAC (← q "poly_ring (r:A ring) (:1)", ← q "R:((1->num)->A)ring") THEN RING_TAC)

  let POLY_REM_UNIQUE ← prove
   r"!(r:A ring) p q t.
        p IN ring_carrier(poly_ring r (:1)) /\
        q IN ring_carrier(poly_ring r (:1)) /\
        t IN ring_carrier(poly_ring r (:1))
        ==> (poly_rem r p q = t <=>
             if ring_unit r (coeff (poly_deg r q) q) then
                (poly_deg r t < poly_deg r q \/
                 t = ring_0(poly_ring r (:1))) /\
                ring_divides (poly_ring r (:1))
                             q (ring_sub (poly_ring r (:1)) p t)
             else p = t)"
   (← do
    let lemma ← prove
     r"!(r:A ring) p q d.
          p IN ring_carrier(poly_ring r (:1)) /\
          q IN ring_carrier(poly_ring r (:1)) /\
          d IN ring_carrier(poly_ring r (:1)) /\
          ring_regular r (coeff (poly_deg r d) d) /\
          poly_deg r p < poly_deg r d /\
          poly_deg r q < poly_deg r d /\
          ring_divides (poly_ring r (:1))
                       d (ring_sub (poly_ring r (:1)) p q)
          ==> p = q"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q "d:(1->num)->A",
                     ← q "ring_sub (poly_ring (r:A ring) (:1)) p q"]
            POLY_DEG_DIVIDES_LE_UNIVARIATE) THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q "p:(1->num)->A", ← q "q:(1->num)->A"]
            POLY_DEG_SUB_LE) THEN
      ASM_SIMP_TAC [RING_SUB_EQ_0, ← CONJUNCT2 POLY_CLAUSES, RING_POLYNOMIAL] THEN
      ASM_ARITH_TAC)
    let tt ← TAUT (← q r"p /\ q ==> r /\ s ==> t <=> p /\ r ==> s /\ q ==> t")
    pure (REPEAT STRIP_TAC THEN COND_CASES_TAC THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [poly_rem, poly_div] THEN REPEAT (POP_ASSUM MP_TAC) THEN
      SPEC_TAC (← q "poly_ring (r:A ring) (:1)", ← q "R:((1->num)->A)ring") THEN
      RING_TAC] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "p:(1->num)->A", ← q "q:(1->num)->A"]
          POLY_DIVIDES_REM) THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "p:(1->num)->A", ← q "q:(1->num)->A"]
          POLY_DEG_REM) THEN
    ASM_REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (fun th => EQ_TAC THENL [MESON_TAC [th], MP_TAC th]) THEN
    ASM_CASES_TAC (← q "poly_deg r (q:(1->num)->A) = 0") THEN
    ASM_SIMP_TAC [LT] THEN
    SUBGOAL_THEN
     (← q r"!p. p IN ring_carrier (poly_ring (r:A ring) (:1))
          ==> (poly_deg r p < poly_deg r q \/ p = ring_0 (poly_ring r (:1)) <=>
               poly_deg r p < poly_deg r (q:(1->num)->A))")
    (fun th => ASM_SIMP_TAC [th, POLY_REM]) THENL
     [REWRITE_TAC [POLY_RING] THEN ASM_MESON_TAC [POLY_DEG_0, LE_1], ALL_TAC] THEN
    ONCE_REWRITE_TAC [tt] THEN
    STRIP_TAC THEN DISCH_TAC THEN MATCH_MP_TAC lemma THEN
    MAP_EVERY EXISTS_TAC [← q "r:A ring", ← q "q:(1->num)->A"] THEN
    ASM_SIMP_TAC [POLY_REM, RING_UNIT_IMP_REGULAR] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_DIVIDES_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    ABBREV_TAC (← q "R = poly_ring (r:A ring) (:1)") THEN
    POP_ASSUM (fun th => tactic_of do pure (RING_TAC THEN SUBST_ALL_TAC (← SYM th))) THEN
    ASM_SIMP_TAC [POLY_REM]))

  -- @@RETURN BEGIN
  return { POLY_TOP_NONZERO, POLY_TOP_TAIL, POLY_TOP_EQ_0, POLY_DEG_LT_FROM_LE,
           POLY_DEG_DIVIDES_LE_UNIVARIATE, POLY_DIVISION_GEN, POLY_DIVISION,
           EUCLIDEAN_POLY_RING, PID_POLY_RING, POLY_DEG_1_ROOT, poly_div, poly_rem,
           POLY_DIV_REM, POLY_DIV, RING_POLYNOMIAL_DIV, POLY_REM, RING_POLYNOMIAL_REM,
           POLY_DIV_REM_SIMP, POLY_DEG_REM, POLY_DEG_REM_ALT, POLY_DIVIDES_REM,
           POLY_REM_UNIQUE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The Hilbert Basis Theorem.  (ringtheory.ml 25321-25878)                    -/
/- ------------------------------------------------------------------------- -/

structure Hilbert where
  -- @@FIELDS
  NOETHERIAN_POLY_RING_1 : thm
  NOETHERIAN_POLY_RING : thm
  KAPLANSKY_LEMMA : thm
  NOETHERIAN_POWSER_RING_1 : thm
  NOETHERIAN_POWSER_RING : thm
  deriving Inhabited

@[nospecialize]
def setupHilbert [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BIdeals : Ideals) (BRules : Rules) (BHoms : Homs) (BIso : Iso) (BRingRule : RingRule) (BSpecialIdeals : SpecialIdeals) (BNoetherian : Noetherian) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BNatIso : NatIso) (BOneCoeff : OneCoeff) (BDegree : Degree) (BEvaluation : Evaluation) (BDivision : Division) :
    ExceptT String IO Hilbert := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON,
        MESON_TAC, SET_RULE, SET_TAC, prove_recursive_functions_exist, .. } := D
  let { ADD1, CARD_ADD_C, CARD_ADD_FINITE_EQ, CARD_CLAUSES, CARD_EQ_CARD, .. } := D.core1
  let { CONJ_ASSOC, EXISTS_FINITE_SUBSET_IMAGE, EXISTS_IN_IMAGE, .. } := D.core2
  let { FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_INSERT, FINITE_NUMSEG_LT,
        FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_IN_IMAGE, HAS_SIZE, HAS_SIZE_1,
        IMAGE_EQ_EMPTY, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INFINITE, INFINITE_CARD_LE, INJECTIVE_ALT,
        INSERT_SUBSET, .. } := D.core4
  let { IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_NUMSEG, IN_SING, IN_UNIV,
        LEFT_IMP_EXISTS_THM, LE_0, LE_1, LT, .. } := D.core5
  let { LT_IMP_NE, LT_REFL, LT_SUC_LE, LT_TRANS, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_EXISTS_THM, NOT_IMP, NOT_LE, PSUBSET, PSUBSET_ALT, .. } := D.core6
  let { RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, SUBSET_ANTISYM,
        SUB_ADD, SWAP_EXISTS_THM, .. } := D.core7
  let { WF_REC_EXISTS, WF_num, le_c, num_INDUCTION, num_RECURSION, num_WOP, .. } := D.core8
  let { RING_0, RING_1, RING_ADD_LZERO, RING_ADD_RZERO, RING_MUL, RING_MUL_RID,
        RING_MUL_RZERO, RING_SUB_REFL, TRIVIAL_RING_10, .. } := BBasics
  let { RING_POW, .. } := BNumbers
  let { RING_SUM, RING_SUM_EQ, RING_SUM_EQ_0, RING_SUM_LMUL, RING_SUM_SUB, .. } := BSums
  let { IDEAL_GENERATED_FINITE_IMAGE, IDEAL_GENERATED_INC, IDEAL_GENERATED_INC_GEN,
        IDEAL_GENERATED_INDUCT_STRONG, IDEAL_GENERATED_MINIMAL, IDEAL_GENERATED_MONO,
        IDEAL_GENERATED_SUBSET, IN_RING_IDEAL_0, IN_RING_IDEAL_ADD, IN_RING_IDEAL_LMUL,
        IN_RING_IDEAL_RMUL, IN_RING_IDEAL_SUB, IN_RING_IDEAL_SUM,
        RING_IDEAL_IDEAL_GENERATED, RING_IDEAL_IMP_SUBSET, .. } := BIdeals
  let { RING_CARRIER_TAC, .. } := BRules
  let { RING_IDEAL_EPIMORPHIC_IMAGE, .. } := BHoms
  let { ISOMORPHIC_RING_REFL, ISOMORPHIC_RING_SYM, ISOMORPHIC_TRIVIAL_RINGS, .. } := BIso
  let { RING_RULE, RING_TAC, .. } := BRingRule
  let { FINITELY_GENERATED_IDEAL_EPIMORPHIC_IMAGE, FINITELY_GENERATED_IDEAL_SUBSET,
        PRIME_IDEAL_IMP_SUBSET, PRIME_IMP_RING_IDEAL, finitely_generated_ideal,
        noetherian_ring, prime_ideal, .. } := BSpecialIdeals
  let { ISOMORPHIC_RING_NOETHERIANNESS, NOETHERIAN_RING_EPIMORPHIC_IMAGE,
        NOETHERIAN_RING_EQ_ACC, NOETHERIAN_RING_EQ_FG_PRIME_IDEALS, .. } := BNoetherian
  let { MONOMIAL_VARS_VAR, MONOMIAL_VAR_DIVIDES, .. } := BMonomials
  let { POLY_ADD_LDISTRIB, POLY_ADD_RZERO, POLY_MUL_LID, POWSER_MUL_0, POWSER_MUL_VAR,
        RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_IMP_POWERSERIES, RING_POLYNOMIAL_SUB,
        RING_POWERSERIES_0, RING_POWERSERIES_CONST, RING_POWERSERIES_MUL,
        RING_POWERSERIES_SUB, RING_POWERSERIES_VAR, poly_var, .. } := BPowerSeries
  let { POLY_CLAUSES, POLY_CONST, POLY_POW, POLY_RING, POLY_RING_CLAUSES, POLY_VAR,
        POLY_VAR_UNIV, POWSER_CLAUSES, POWSER_CONST, POWSER_RING, POWSER_RING_CLAUSES,
        POWSER_SUM, POWSER_VAR, POWSER_VAR_UNIV, RING_POLYNOMIAL, RING_POWERSERIES,
        RING_POWERSERIES_POW, TRIVIAL_POLY_RING, TRIVIAL_POWSER_RING, .. } := BPolyRings
  let { ISOMORPHIC_POLY_RING_TRIVIAL, ISOMORPHIC_POWSER_RING_TRIVIAL,
        ISOMORPHIC_RING_POLY_POLY_GEN, ISOMORPHIC_RING_POWSER_POWSER_GEN, .. } := BNatIso
  let { COEFF_IN_CARRIER, COEFF_IN_CARRIER_ALT, COEFF_POLY_0, COEFF_POLY_ADD,
        COEFF_POLY_CONST, COEFF_POLY_LMUL, COEFF_POLY_MUL, COEFF_POLY_SUB,
        COEFF_POLY_VARPOW, COEFF_POLY_VARPOW_MUL, COEFF_POLY_VAR_MUL, FUN_EQ_COEFF,
        RING_POWERSERIES_COEFF, coeff, .. } := BOneCoeff
  let { COEFF_POWSER_SUM, POLY_DEG_0, POLY_DEG_ADD_LE, POLY_DEG_CONST, POLY_DEG_MUL_LE,
        POLY_DEG_SUB_LE, POLY_DEG_VARPOW_MUL, .. } := BDegree
  let { POLY_EVALUATE, POLY_EVALUATE_0, POLY_EVALUATE_ADD, POLY_EVALUATE_MUL,
        POLY_EVALUATE_VAR, POWSER_RING_EPIMORPHISM_COEFF_0, RING_EPIMORPHISM_POLY_EVAL, .. } := BEvaluation
  let { POLY_DEG_LT_FROM_LE, .. } := BDivision
  -- @@SCOPE END

  let NOETHERIAN_POLY_RING_1 ← prove
   r"!r:A ring.
     noetherian_ring (poly_ring r (:1)) <=> noetherian_ring r"
   (← do
    -- right to left: the rules in reverse text order
    let r9 ← RING_RULE (← q "x = ring_add r (ring_sub r x y) y")
    let t8 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    let a7 ← ARITH_RULE (← q r"m:num <= n ==> m + n - m = n /\ n - (n - m) = m")
    let a6 ← ARITH_RULE (← q "~(d:num < d - a)")
    let s5 ← SET_RULE
     (← q r"(!n. ~(p n IN s n)) ==> s m SUBSET s n ==> ~(p n IN s m)")
    let s4 ← SET_RULE (← q r"!x. x IN t /\ ~(x IN s) ==> ~(s = t)")
    let s3 ← SET_RULE (← q r"i SUBSET j /\ ~(i = j) ==> ~(j DIFF i = {})")
    let s2 ← SET_RULE (← q r"{f x | P x} = {y | ?x. ~(P x ==> ~(f x = y))}")
    let m1 ← MESON [] (← q r"(?x. P x /\ Q x /\ R x) <=> ~(!x. P x /\ Q x ==> ~R x)")
    let alpha (v : term) : ioconv := fun t => pure (HolCore.Equal.ALPHA_CONV v t)
    pure (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC
     [← MATCH_MP (← REWRITE_RULE [IMP_CONJ] NOETHERIAN_RING_EPIMORPHIC_IMAGE)
           (← ISPEC (← q "(:1)") (← MATCH_MP RING_EPIMORPHISM_POLY_EVAL
               (← SPEC (← q "r:A ring") RING_0)))] THEN
    STRIP_TAC THEN REWRITE_TAC [noetherian_ring] THEN
    X_GEN_TAC (← q "j:((1->num)->A)->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_IDEAL_IMP_SUBSET) THEN
    ASM_REWRITE_TAC [finitely_generated_ideal, m1] THEN
    DISCH_TAC THEN MP_TAC (← ISPEC
     (← q r"\(p:num->(1->num)->A) n q.
          q IN j DIFF ideal_generated (poly_ring r (:1)) {p m | m < n} /\
          !q'. q' IN j DIFF ideal_generated (poly_ring r (:1)) {p m | m < n}
               ==> poly_deg r q <= poly_deg r q'")
     (← MATCH_MP WF_REC_EXISTS WF_num)) THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [ONCE_REWRITE_TAC [s2] THEN
      SIMP_TAC [],
      MAP_EVERY X_GEN_TAC [← q "p:num->(1->num)->A", ← q "n:num"] THEN DISCH_TAC THEN
      MP_TAC (← EQ_IMP_RULE (← ISPEC
       (← q r"\d. d IN IMAGE (poly_deg (r:A ring))
                  (j DIFF ideal_generated (poly_ring r (:1)) {p m | m:num < n})")
          num_WOP)).1 THEN
      REWRITE_TAC [EXISTS_IN_IMAGE, MEMBER_NOT_EMPTY, IMAGE_EQ_EMPTY] THEN
      ANTS_TAC THENL [ALL_TAC, SET_TAC [NOT_LE]] THEN
      MATCH_MP_TAC s3 THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC IDEAL_GENERATED_MINIMAL THEN ASM SET_TAC [],
        FIRST_X_ASSUM MATCH_MP_TAC THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT] THEN ASM SET_TAC []],
      DISCH_THEN (X_CHOOSE_THEN (← q "p:num->(1->num)->A")
       (MP_TAC o CONV_RULE (RAND_CONV (alpha (← q "n:num")))))  THEN
      REWRITE_TAC [FORALL_AND_THM, IN_DIFF] THEN STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n. ideal_generated (poly_ring (r:A ring) (:1)) {p m | m:num < n} SUBSET j")
    ASSUME_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC IDEAL_GENERATED_MINIMAL THEN ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOETHERIAN_RING_EQ_ACC]) THEN
    REWRITE_TAC [] THEN EXISTS_TAC
     (← q r"\n:num. ideal_generated (r:A ring)
                 {coeff (poly_deg r (p m)) (p m) | m < n}") THEN
    REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED, PSUBSET] THEN
    X_GEN_TAC (← q "n:num") THEN CONJ_TAC THENL
     [MATCH_MP_TAC IDEAL_GENERATED_MONO THEN
      REWRITE_TAC [← GSYM ADD1, LT] THEN SET_TAC [],
      MATCH_MP_TAC s4] THEN
    EXISTS_TAC (← q "coeff (poly_deg r (p(n:num))) (p n):A") THEN CONJ_TAC THENL
     [MATCH_MP_TAC IDEAL_GENERATED_INC THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, ← GSYM ADD1, LT] THEN
      CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC COEFF_IN_CARRIER_ALT THEN
      ASM_MESON_TAC [RING_POLYNOMIAL, SUBSET],
      DISCH_TAC] THEN
    ABBREV_TAC (← q "d = poly_deg r ((p:num->(1->num)->A) n)") THEN
    SUBGOAL_THEN (← q "!m. ring_polynomial r ((p:num->(1->num)->A) m)")
    ASSUME_TAC THENL
     [REWRITE_TAC [RING_POLYNOMIAL] THEN ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q "!m d. coeff d ((p:num->(1->num)->A) m) IN ring_carrier r")
    ASSUME_TAC THENL [ASM_SIMP_TAC [COEFF_IN_CARRIER_ALT], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q "!m. m < n ==> poly_deg r ((p:num->(1->num)->A) m) <= poly_deg r (p n)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s5) THEN
      MATCH_MP_TAC IDEAL_GENERATED_MONO THEN ASM SET_TAC [LT_TRANS],
      ALL_TAC] THEN
    SUBGOAL_THEN
