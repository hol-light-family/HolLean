  RING_SETMUL_IDEAL_LEFT : thm
  RING_SETMUL_IDEAL_RIGHT : thm
  RING_SETMUL_SUBSET_IDEAL : thm
  RING_SETADD_LCANCEL : thm
  RING_SETADD_RCANCEL : thm
  RING_SETADD_LCANCEL_SET : thm
  RING_SETADD_RCANCEL_SET : thm
  RING_IDEAL_SETADD : thm
