  PRIME_SUPERIDEAL_EXCLUDING_EXISTS : thm
  PRIME_IDEAL_EXCLUDING_EXISTS : thm
  MAXIMAL_NONFG_IMP_PRIME_IDEAL : thm
  PRIME_IDEAL_SING : thm
  RING_PRIME_IDEAL : thm
