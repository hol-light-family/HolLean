structure ProdRings where
  -- @@FIELDS
  prod_ring : thm
  PROD_RING : thm
  RING_HOMOMORPHISM_PAIRWISE : thm
  RING_HOMOMORPHISM_PAIRED : thm
  RING_HOMOMORPHISM_DIAG : thm
  RING_MONOMORPHISM_DIAG : thm
  RING_HOMOMORPHISM_PAIRED2 : thm
  RING_ISOMORPHISMS_PAIRED2 : thm
  RING_ISOMORPHISM_PAIRED2 : thm
  ISOMORPHIC_RING_PROD_RINGS : thm
  RING_HOMOMORPHISM_OF_FST : thm
  RING_HOMOMORPHISM_OF_SND : thm
  RING_EPIMORPHISM_OF_FST : thm
  RING_EPIMORPHISM_OF_SND : thm
  RING_HOMOMORPHISM_FST : thm
  RING_HOMOMORPHISM_SND : thm
  RING_EPIMORPHISM_FST : thm
  RING_EPIMORPHISM_SND : thm
  RING_ISOMORPHISM_FST : thm
  RING_ISOMORPHISM_SND : thm
  RING_ISOMORPHISMS_PROD_RING_SWAP : thm
  ISOMORPHIC_RING_PROD_RING_SYM : thm
  ISOMORPHIC_RING_PROD_RING_SWAP_LEFT : thm
  ISOMORPHIC_RING_PROD_RING_SWAP_RIGHT : thm
  ISOMORPHIC_PROD_TRIVIAL_RING : thm
  TRIVIAL_PROD_RING : thm
  FINITE_PROD_RING : thm
