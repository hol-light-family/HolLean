    ASSUME_TAC THENL [ASM_SIMP_TAC [RING_POWERSERIES_COEFF], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"p = ring_sum (powser_ring (r:A ring) (:1)) k
                   (\i. ring_mul (powser_ring r (:1)) (cf i) i)")
    SUBST1_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC IN_RING_IDEAL_SUM THEN
      REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED] THEN
      X_GEN_TAC (← q "g:(1->num)->A") THEN DISCH_TAC THEN
      MATCH_MP_TAC IN_RING_IDEAL_LMUL THEN
      ASM_SIMP_TAC [RING_IDEAL_IDEAL_GENERATED, ← GSYM RING_POWERSERIES] THEN
      MATCH_MP_TAC IDEAL_GENERATED_INC_GEN THEN ASM SET_TAC []] THEN
    ABBREV_TAC (← q r"cf':num->((1->num)->A)->(1->num)->A =
                \n i m. if m one < n then cf i m else ring_0 r") THEN
    SUBGOAL_THEN
     (← q r"!g n d. coeff d ((cf':num->((1->num)->A)->(1->num)->A) n g) =
              (if d < n then coeff d (cf g) else ring_0 r)")
    ASSUME_TAC THENL
     [EXPAND_TAC "cf'" THEN REWRITE_TAC [coeff], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!(n:num) g:(1->num)->A. g IN k ==> ring_powerseries r (cf' n g:(1->num)->A)")
    ASSUME_TAC THENL
     [ASM_REWRITE_TAC [RING_POWERSERIES_COEFF] THEN
      ASM_MESON_TAC [COEFF_IN_CARRIER, RING_0],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n. poly_add r (poly_mul r (poly_pow r (poly_var r one) n) (q n))
                     (ring_sum (powser_ring r (:1)) k
                          (\i. poly_mul (r:A ring) (cf' n i) i)) =
          p")
    ASSUME_TAC THENL
     [INDUCT_TAC THENL
       [ASM_SIMP_TAC [POLY_POW, POLY_MUL_LID] THEN
        MATCH_MP_TAC mc THEN
        ASM_REWRITE_TAC [POWSER_CLAUSES] THEN MATCH_MP_TAC RING_SUM_EQ_0 THEN
        REWRITE_TAC [POWSER_RING] THEN X_GEN_TAC (← q "i:(1->num)->A") THEN
        STRIP_TAC THEN MATCH_MP_TAC md THEN
        ASM_SIMP_TAC [← GSYM FUN_EQ_COEFF, COEFF_POLY_0, LT],
        ALL_TAC] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o RAND_CONV) [← GSYM th])) THEN
      REWRITE_TAC [POLY_POW] THEN
      wPart (fun t => do lhand (← rand t)) (fun t => do lhand (← rand t))
        POLY_ADD_LDISTRIB THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [RING_POWERSERIES_POW, RING_POWERSERIES_VAR,
                       RING_POWERSERIES_MUL, RING_POWERSERIES, RING_SUM],
        DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [POWSER_CLAUSES] THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_IMP] re) THEN
      CONJ_TAC THENL
       [REPEAT CONJ_TAC THEN RING_CARRIER_TAC THEN
        REWRITE_TAC [POWSER_VAR_UNIV, RING_SUM] THEN
        ASM_MESON_TAC [RING_POWERSERIES],
        ALL_TAC] THEN
      wPart lhand (fun t => do rand (← rand t)) RING_SUM_SUB THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        RING_CARRIER_TAC THEN ASM_MESON_TAC [RING_POWERSERIES],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      wPart rand (fun t => do rand (← rand t)) RING_SUM_LMUL THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        RING_CARRIER_TAC THEN REWRITE_TAC [POWSER_VAR_UNIV, POWSER_CONST] THEN
        ASM_MESON_TAC [RING_POWERSERIES],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q "i:(1->num)->A") THEN DISCH_TAC THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_IMP] rf) THEN
      CONJ_TAC THENL
       [REPEAT CONJ_TAC THEN RING_CARRIER_TAC THEN
        REWRITE_TAC [POWSER_CONST, POWSER_VAR_UNIV] THEN
        ASM_MESON_TAC [RING_POWERSERIES],
        ALL_TAC] THEN
      REWRITE_TAC [← GSYM FUN_EQ_COEFF, POWSER_RING_CLAUSES] THEN
      ASM_SIMP_TAC [COEFF_POLY_ADD, COEFF_POLY_LMUL, COEFF_POLY_VARPOW,
                    RING_POWERSERIES_VAR, RING_POWERSERIES_POW] THEN
      X_GEN_TAC (← q "d:num") THEN REWRITE_TAC [LT] THEN
      ASM_CASES_TAC (← q "d:num = n") THEN ASM_REWRITE_TAC [LT_REFL] THEN
      ASM_SIMP_TAC [RING_MUL_RID, RING_ADD_LZERO] THEN
      COND_CASES_TAC THEN
      ASM_SIMP_TAC [RING_MUL_RZERO, RING_ADD_RZERO, RING_0],
      ALL_TAC] THEN
    REWRITE_TAC [← GSYM FUN_EQ_COEFF] THEN X_GEN_TAC (← q "d:num") THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV)
        [← SYM (← SPEC (← q "SUC d") th)])) THEN
    ASM_SIMP_TAC [COEFF_POLY_ADD, COEFF_POLY_VARPOW_MUL, LT] THEN
    SIMP_TAC [RING_ADD_LZERO, COEFF_IN_CARRIER, RING_POWERSERIES, RING_SUM] THEN
    ASM_SIMP_TAC [COEFF_POWSER_SUM, RING_POWERSERIES_MUL, POWSER_RING_CLAUSES,
                  RING_POWERSERIES_CONST, COEFF_POLY_LMUL] THEN
    MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q "i:(1->num)->A") THEN
    DISCH_TAC THEN REWRITE_TAC [COEFF_POLY_MUL] THEN
    MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q "j:num") THEN
    REWRITE_TAC [IN_NUMSEG, LE_0] THEN DISCH_TAC THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ASM_REWRITE_TAC [LT_SUC_LE]))

  let NOETHERIAN_POWSER_RING_1 ← prove
   r"!r:A ring.
     noetherian_ring (powser_ring r (:1)) <=> noetherian_ring r"
   (GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [POWSER_RING_EPIMORPHISM_COEFF_0,
                 NOETHERIAN_RING_EPIMORPHIC_IMAGE],
      GEN_REWRITE_TAC LAND_CONV [noetherian_ring] THEN
      DISCH_TAC THEN REWRITE_TAC [NOETHERIAN_RING_EQ_FG_PRIME_IDEALS]] THEN
    X_GEN_TAC (← q "j:((1->num)->A)->bool") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [KAPLANSKY_LEMMA] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [RING_IDEAL_EPIMORPHIC_IMAGE, POWSER_RING_EPIMORPHISM_COEFF_0,
                   PRIME_IMP_RING_IDEAL])

  let NOETHERIAN_POWSER_RING ← prove
   r"!(r:A ring) (s:V->bool).
      noetherian_ring (powser_ring r s) <=>
      noetherian_ring r /\ (FINITE s \/ trivial_ring r)"
   (← do
    -- right to left: the SET_RULE, the second ARITH_RULE, then the first
    let s3 ← SET_RULE (← q r"!P. ~P a /\ (!y. y IN s ==> P y) ==> ~(a IN s)")
    let a2 ← ARITH_RULE (← q r"i < n + 1 <=> i < n \/ i = n")
    let a1 ← ARITH_RULE (← q r"i < n + 1 <=> i < n \/ i = n")
    pure (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"FINITE(s:V->bool)") THEN
    ASM_REWRITE_TAC [] THENL
     [UNDISCH_TAC (← q r"FINITE(s:V->bool)") THEN
      SPEC_TAC (← q r"s:V->bool", ← q r"s:V->bool") THEN
      MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
       [MATCH_MP_TAC ISOMORPHIC_RING_NOETHERIANNESS THEN
        REWRITE_TAC [ISOMORPHIC_POWSER_RING_TRIVIAL],
        MAP_EVERY X_GEN_TAC [← q "x:V", ← q r"s:V->bool"] THEN
        DISCH_THEN (CONJUNCTS_THEN2 (SUBST1_TAC o SYM) STRIP_ASSUME_TAC) THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM NOETHERIAN_POWSER_RING_1] THEN
        MATCH_MP_TAC ISOMORPHIC_RING_NOETHERIANNESS THEN
        ONCE_REWRITE_TAC [ISOMORPHIC_RING_SYM] THEN
        MATCH_MP_TAC ISOMORPHIC_RING_POWSER_POWSER_GEN THEN
        ASM_SIMP_TAC [CARD_EQ_CARD, CARD_ADD_C, FINITE_INSERT, CARD_CLAUSES,
                      CARD_ADD_FINITE_EQ, ← REWRITE_RULE [HAS_SIZE] HAS_SIZE_1] THEN
        REWRITE_TAC [ISOMORPHIC_RING_REFL, ADD1]],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q "trivial_ring(r:A ring)") THEN ASM_REWRITE_TAC [] THENL
     [MATCH_MP_TAC ISOMORPHIC_RING_NOETHERIANNESS THEN
      MATCH_MP_TAC ISOMORPHIC_TRIVIAL_RINGS THEN
      ASM_REWRITE_TAC [TRIVIAL_POWSER_RING],
      ALL_TAC] THEN
    REWRITE_TAC [NOETHERIAN_RING_EQ_ACC] THEN
    MP_TAC (← ISPEC (← q r"s:V->bool") INFINITE_CARD_LE) THEN
    ASM_REWRITE_TAC [INFINITE, le_c, INJECTIVE_ALT, IN_UNIV] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:num->V") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC
     (← q r"(\n. ideal_generated (powser_ring r s) {poly_var r (v i) | i < n})
      :num->((V->num)->A)->bool") THEN
    REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED] THEN
    X_GEN_TAC (← q "n:num") THEN REWRITE_TAC [PSUBSET_ALT] THEN CONJ_TAC THENL
     [MATCH_MP_TAC IDEAL_GENERATED_MONO THEN
      REWRITE_TAC [a1] THEN SET_TAC [],
      EXISTS_TAC (← q r"poly_var r (v(n:num)):(V->num)->A")] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC IDEAL_GENERATED_INC THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, POWSER_VAR] THEN
      REWRITE_TAC [a2] THEN SET_TAC [],
      MATCH_MP_TAC s3] THEN
    EXISTS_TAC (← q r"\p. (p:(V->num)->A) (monomial_var(v(n:num))) = ring_0 r") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [poly_var, ← GSYM TRIVIAL_RING_10],
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN]] THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_FINITE_IMAGE, FINITE_NUMSEG_LT,
                  SUBSET, FORALL_IN_IMAGE, POWSER_VAR] THEN
    ASM_SIMP_TAC [POWSER_SUM, RING_MUL, POWSER_VAR, FORALL_IN_GSPEC,
                  FINITE_NUMSEG_LT] THEN
    REWRITE_TAC [POWSER_RING_CLAUSES, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC RING_SUM_EQ_0 THEN REWRITE_TAC [IMP_CONJ, IN_ELIM_THM] THEN
    X_GEN_TAC (← q "m:num") THEN DISCH_TAC THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
    ASM_SIMP_TAC [POWSER_MUL_VAR] THEN
    REWRITE_TAC [MONOMIAL_VAR_DIVIDES, MONOMIAL_VARS_VAR] THEN
    ASM_SIMP_TAC [IN_SING, LT_IMP_NE]))

  -- @@RETURN BEGIN
  return { NOETHERIAN_POLY_RING_1, NOETHERIAN_POLY_RING, KAPLANSKY_LEMMA,
           NOETHERIAN_POWSER_RING_1, NOETHERIAN_POWSER_RING }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Monic polynomials (leading coefficient = ring identity).                  -/
/- (ringtheory.ml 25878-26100)                                               -/
/- ------------------------------------------------------------------------- -/

structure Monic where
  -- @@FIELDS
  monic : thm
  MONIC_POLY_1 : thm
  MONIC_POLY_0 : thm
  MONIC_IMP_NONZERO : thm
  MONIC_IN_TRIVIAL_RING : thm
  MONIC_POLY_CONST : thm
  MONIC_DEG_0 : thm
  MONIC_POLY_VAR : thm
  MONIC_SUBRING_GENERATED : thm
  POLY_DEG_MUL_MONIC : thm
  MONIC_POLY_MUL : thm
  MONIC_POLY_POW : thm
  MONIC_POLY_PRODUCT : thm
  MONIC_ASSOCIATES_EQ : thm
  MONIC_CMUL : thm
  FIELD_MONIC_ASSOCIATE : thm
  FIELD_MONIC_IRREDUCIBLE_ASSOCIATE : thm
  RING_COPRIME_DISTINCT_MONIC_IRREDUCIBLES : thm
  POLY_DEG_DIVIDES_LE_MONIC : thm
  deriving Inhabited

@[nospecialize]
def setupMonic [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BProducts : Products) (BDivides : Divides) (BSubrings : Subrings) (BDomains : Domains) (BPrimes : Primes) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BOneCoeff : OneCoeff) (BDegree : Degree) (BZerodivisors : Zerodivisors) (BDivision : Division) :
    ExceptT String IO Monic := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { ADD_CLAUSES, .. } := D.core1
  let { FINITE_INDUCT_STRONG, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_ELIM_THM, IN_INSERT, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { NOT_IN_EMPTY, .. } := D.core6
  let { SUBSET_UNIV, .. } := D.core7
  let { RING_1, RING_MUL_LID, TRIVIAL_RING_10, trivial_ring, .. } := BBasics
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, .. } := BProducts
  let { RING_ASSOCIATES_IN_CARRIER, RING_ASSOCIATES_LMUL, RING_INV, RING_INV_0,
        RING_INV_INV, RING_MUL_LINV, RING_REGULAR_1, RING_UNIT_0, RING_UNIT_INV,
        ring_unit, .. } := BDivides
  let { SUBRING_GENERATED, .. } := BSubrings
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_UNIT, INTEGRAL_DOMAIN_ASSOCIATES,
        INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, .. } := BDomains
  let { RING_ASSOCIATES_IRREDUCIBLE, RING_IRREDUCIBLES_COPRIME_OR_ASSOCIATES,
        ring_irreducible, .. } := BPrimes
  let { POLY_CONST_1, POLY_MUL_0, POLY_MUL_RID, RING_POLYNOMIAL_0,
        RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_IMP_POWERSERIES, RING_POLYNOMIAL_MUL, .. } := BPowerSeries
  let { POLY_CLAUSES, POLY_CONST_EQ_0, POLY_POW, POLY_RING, POLY_RING_CLAUSES,
        RING_POLYNOMIAL, RING_POLYNOMIAL_POW, TRIVIAL_RING_POLY_0, .. } := BPolyRings
  let { COEFF_IN_CARRIER_ALT, COEFF_POLY_0, COEFF_POLY_1, COEFF_POLY_CONST,
        COEFF_POLY_VAR, RING_POWERSERIES_COEFF, .. } := BOneCoeff
  let { INTEGRAL_DOMAIN_POLY_RING, POLY_DEG_0, POLY_DEG_1, POLY_DEG_CMUL,
        POLY_DEG_CONST, POLY_DEG_EQ_0, POLY_DEG_MUL, POLY_DEG_MUL_UNIVARIATE,
        POLY_DEG_SUBRING_GENERATED, POLY_DEG_VAR, POLY_MUL_LEADING_COEFF, .. } := BDegree
  let { RING_UNIT_POLY_CONST, RING_UNIT_POLY_DOMAIN, .. } := BZerodivisors
  let { POLY_DEG_DIVIDES_LE_UNIVARIATE, POLY_TOP_NONZERO, .. } := BDivision
  -- @@SCOPE END

  let monic ← new_definition
   r"monic (r:A ring) (p:(1->num)->A) <=> coeff (poly_deg r p) p = ring_1 r"

  let MONIC_POLY_1 ← prove
   r"!r:A ring. monic r (poly_1 r)"
   (REWRITE_TAC [monic, POLY_DEG_1, COEFF_POLY_1])

  let MONIC_POLY_0 ← prove
   r"!r:A ring. monic r (poly_0 r) <=> trivial_ring r"
   (REWRITE_TAC [monic, POLY_DEG_0, COEFF_POLY_0, TRIVIAL_RING_10] THEN
    MESON_TAC [])

  let MONIC_IMP_NONZERO ← prove
   r"!r:A ring p.
     ring_polynomial r p /\ monic r p /\ ~trivial_ring r
     ==> ~(p = poly_0 r)"
   (MESON_TAC [TRIVIAL_RING_POLY_0, MONIC_POLY_0])

  let MONIC_IN_TRIVIAL_RING ← prove
   r"!r:A ring p.
        ring_powerseries r p /\ trivial_ring r ==> monic r p"
   (REWRITE_TAC [trivial_ring, RING_POWERSERIES_COEFF, monic] THEN
    SET_TAC [RING_1])

  let MONIC_POLY_CONST ← prove
   r"!r c:A. monic r (poly_const r c) <=> c = ring_1 r"
   (REWRITE_TAC [monic, POLY_DEG_CONST, COEFF_POLY_CONST])

  let MONIC_DEG_0 ← prove
   r"!r:A ring p.
     ring_polynomial r p /\ monic r p /\ poly_deg r p = 0
     ==> p = poly_1 r"
   (MESON_TAC [POLY_DEG_EQ_0, POLY_CONST_1, MONIC_POLY_CONST])

  let MONIC_POLY_VAR ← prove
   r"!r:A ring. monic r (poly_var r one)"
   (GEN_TAC THEN REWRITE_TAC [monic, POLY_DEG_VAR, COEFF_POLY_VAR] THEN
    MESON_TAC [TRIVIAL_RING_10])

  let MONIC_SUBRING_GENERATED ← prove
   r"!r:A ring s p. monic (subring_generated r s) p <=> monic r p"
   (REWRITE_TAC [monic, POLY_DEG_SUBRING_GENERATED, SUBRING_GENERATED])

  let POLY_DEG_MUL_MONIC ← prove
   r"!r (p:(1->num)->A) q.
     ring_polynomial r p /\ ring_polynomial r q /\
     monic r p /\ monic r q
     ==> poly_deg r (poly_mul r p q) = poly_deg r p + poly_deg r q"
   (REWRITE_TAC [monic] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q "trivial_ring(r:A ring)") THENL
     [ASM_SIMP_TAC [TRIVIAL_RING_POLY_0] THEN
      SIMP_TAC [POLY_MUL_0, RING_POLYNOMIAL_0, POLY_DEG_0, ADD_CLAUSES],
      MATCH_MP_TAC POLY_DEG_MUL_UNIVARIATE THEN
      ASM_SIMP_TAC [RING_MUL_LID, RING_1, ← GSYM TRIVIAL_RING_10]])

  let MONIC_POLY_MUL ← prove
   r"!r p q:(1->num)->A.
     ring_polynomial r p /\ ring_polynomial r q /\ monic r p /\ monic r q
     ==> monic r (poly_mul r p q)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [monic] THEN
    ASM_SIMP_TAC [POLY_DEG_MUL_MONIC, POLY_MUL_LEADING_COEFF] THEN
    UNDISCH_TAC (← q "monic (r:A ring) (p:(1->num)->A)") THEN
    UNDISCH_TAC (← q "monic (r:A ring) (q:(1->num)->A)") THEN
    SIMP_TAC [monic, RING_MUL_LID, RING_1])

  let MONIC_POLY_POW ← prove
   r"!r (p:(1->num)->A) n.
     ring_polynomial r p /\ monic r p ==> monic r (poly_pow r p n)"
   (GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THENL
     [REWRITE_TAC [POLY_POW] THEN REPEAT STRIP_TAC THEN
      REWRITE_TAC [MONIC_POLY_1],
      REWRITE_TAC [POLY_POW] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC MONIC_POLY_MUL THEN ASM_SIMP_TAC [] THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_POW]])

  let MONIC_POLY_PRODUCT ← prove
   r"!r (f:K->(1->num)->A) s.
     FINITE s /\
     (!i. i IN s ==> ring_polynomial r (f i)) /\
     (!i. i IN s ==> monic r (f i))
     ==> monic r (ring_product (poly_ring r (:1)) s f)"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
     [REWRITE_TAC [RING_PRODUCT_CLAUSES, NOT_IN_EMPTY, POLY_RING_CLAUSES] THEN
      REWRITE_TAC [MONIC_POLY_1], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q "x:K", ← q "t:K->bool"] THEN
    STRIP_TAC THEN REPEAT DISCH_TAC THEN
    SUBGOAL_THEN (← q "(f:K->(1->num)->A) x IN ring_carrier(poly_ring r (:1))")
    ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN ASM_SIMP_TAC [IN_INSERT],
      ALL_TAC] THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, ← GSYM POLY_RING] THEN
    REWRITE_TAC [POLY_RING_CLAUSES] THEN
    MATCH_MP_TAC MONIC_POLY_MUL THEN
    ASM_SIMP_TAC [IN_INSERT] THEN
    REWRITE_TAC [RING_POLYNOMIAL] THEN REWRITE_TAC [RING_PRODUCT])

  let MONIC_ASSOCIATES_EQ ← prove
   r"!r p q:(1->num)->A.
        integral_domain r /\
        monic r p /\ monic r q /\ ring_associates (poly_ring r (:1)) p q
        ==> p = q"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q "ring_polynomial r (p:(1->num)->A) /\\ ring_polynomial r (q:(1->num)->A)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_ASSOCIATES_IN_CARRIER, RING_POLYNOMIAL], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q "poly_ring (r:A ring) (:1)", ← q "p:(1->num)->A",
                   ← q "q:(1->num)->A"]
      INTEGRAL_DOMAIN_ASSOCIATES) THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_POLY_RING, ← GSYM RING_POLYNOMIAL] THEN
    ASM_SIMP_TAC [POLY_RING_CLAUSES, RING_UNIT_POLY_DOMAIN] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, LEFT_AND_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "u:(1->num)->A", ← q "c:A"] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) ASSUME_TAC) THEN
    DISCH_THEN SUBST_ALL_TAC THEN UNDISCH_TAC (← q "monic r (q:(1->num)->A)") THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    SUBGOAL_THEN (← q "(c:A) IN ring_carrier r /\\ ~(c = ring_0 r)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [ring_unit, RING_UNIT_0, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q "~(p:(1->num)->A = poly_0 r)") ASSUME_TAC THENL
     [ASM_MESON_TAC [MONIC_IMP_NONZERO, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING],
      REWRITE_TAC [monic]] THEN
    ASM_SIMP_TAC [POLY_DEG_MUL, POLY_CONST_EQ_0, RING_POLYNOMIAL_CONST] THEN
    ASM_SIMP_TAC [POLY_MUL_LEADING_COEFF, RING_POLYNOMIAL_CONST] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [monic]) THEN
    ASM_SIMP_TAC [POLY_DEG_CONST, COEFF_POLY_CONST, RING_MUL_LID] THEN
    ASM_SIMP_TAC [POLY_CONST_1, RING_POLYNOMIAL_IMP_POWERSERIES, POLY_MUL_RID])

  let MONIC_CMUL ← prove
   r"!r (p:(1->num)->A).
     integral_domain r /\
     ring_polynomial r p /\
     ring_unit r (coeff (poly_deg r p) p)
     ==> monic r (poly_mul r
                    (poly_const r (ring_inv r (coeff (poly_deg r p) p))) p)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q "p:(1->num)->A = poly_0 r") THENL
     [ASM_REWRITE_TAC [COEFF_POLY_0, RING_UNIT_0] THEN
      MESON_TAC [INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING],
      STRIP_TAC THEN REWRITE_TAC [monic]] THEN
    wPart (fun t => do lhand (← lhand t)) (fun t => do lhand (← rand t)) POLY_DEG_MUL
    THEN ANTS_TAC THENL
     [ASM_MESON_TAC [RING_UNIT_0, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING,
                     RING_INV_INV, RING_INV_0, RING_INV, COEFF_IN_CARRIER_ALT,
                     POLY_CONST_EQ_0, RING_POLYNOMIAL_CONST],
      DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [POLY_MUL_LEADING_COEFF, RING_POLYNOMIAL_CONST,
                  COEFF_IN_CARRIER_ALT, RING_INV] THEN
    ASM_SIMP_TAC [COEFF_POLY_CONST, POLY_DEG_CONST, RING_MUL_LINV])

  let FIELD_MONIC_ASSOCIATE ← prove
   r"!f (p:(1->num)->A).
     field f /\ ring_polynomial f p /\ ~(p = poly_0 f)
     ==> ?q. ring_polynomial f q /\
             monic f q /\
             ring_associates (poly_ring f (:1)) p q /\
             poly_deg f q = poly_deg f p"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q "integral_domain (f:A ring)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN], ALL_TAC] THEN
    SUBGOAL_THEN (← q "coeff (poly_deg (f:A ring) p) p IN ring_carrier f")
    ASSUME_TAC THENL [ASM_MESON_TAC [COEFF_IN_CARRIER_ALT], ALL_TAC] THEN
    SUBGOAL_THEN (← q "~(coeff (poly_deg (f:A ring) p) p = ring_0 f)") ASSUME_TAC THENL
     [MATCH_MP_TAC POLY_TOP_NONZERO THEN
      ASM_REWRITE_TAC [← GSYM RING_POLYNOMIAL, POLY_RING_CLAUSES],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q "ring_unit (f:A ring) (coeff (poly_deg f p) p)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [FIELD_UNIT], ALL_TAC] THEN
    ABBREV_TAC (← q "c_inv = ring_inv (f:A ring) (coeff (poly_deg f p) p)") THEN
    SUBGOAL_THEN (← q "(c_inv:A) IN ring_carrier f") ASSUME_TAC THENL
     [EXPAND_TAC "c_inv" THEN ASM_SIMP_TAC [RING_INV], ALL_TAC] THEN
    EXISTS_TAC (← q "poly_mul f (poly_const f c_inv) (p:(1->num)->A)") THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_MUL, RING_POLYNOMIAL_CONST] THEN
    REPEAT CONJ_TAC THENL
     [EXPAND_TAC "c_inv" THEN MATCH_MP_TAC MONIC_CMUL THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [POLY_CLAUSES] THEN MATCH_MP_TAC RING_ASSOCIATES_LMUL THEN
      ASM_REWRITE_TAC [RING_UNIT_POLY_CONST, ← GSYM POLY_CLAUSES, IN_ELIM_THM] THEN
      ASM_MESON_TAC [RING_UNIT_INV],
      MATCH_MP_TAC POLY_DEG_CMUL THEN ASM_MESON_TAC [RING_INV_INV, RING_INV_0]])

  let FIELD_MONIC_IRREDUCIBLE_ASSOCIATE ← prove
   r"!f (p:(1->num)->A).
     field f /\ ring_irreducible (poly_ring f (:1)) p
     ==> ?q. ring_polynomial f q /\
             monic f q /\
             ring_irreducible (poly_ring f (:1)) q /\
             ring_associates (poly_ring f (:1)) p q /\
             poly_deg f q = poly_deg f p"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"ring_polynomial (f:A ring) (p:(1->num)->A) /\
                  ~(p = poly_0 f)") STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_irreducible]) THEN
      REWRITE_TAC [POLY_RING_CLAUSES, IN_ELIM_THM, SUBSET_UNIV] THEN
      MESON_TAC [],
      MP_TAC (← ISPECL [← q "f:A ring", ← q "p:(1->num)->A"] FIELD_MONIC_ASSOCIATE) THEN
      ASM_MESON_TAC [RING_ASSOCIATES_IRREDUCIBLE, FIELD_IMP_INTEGRAL_DOMAIN,
                     INTEGRAL_DOMAIN_POLY_RING]])

  let RING_COPRIME_DISTINCT_MONIC_IRREDUCIBLES ← prove
   r"!r (p:(1->num)->A) q.
     integral_domain r /\
     monic r p /\ monic r q /\
     ring_irreducible (poly_ring r (:1)) p /\
     ring_irreducible (poly_ring r (:1)) q /\
     ~(p = q)
     ==> ring_coprime (poly_ring r (:1)) (p, q)"
   (MESON_TAC [RING_IRREDUCIBLES_COPRIME_OR_ASSOCIATES,
               MONIC_ASSOCIATES_EQ])

  let POLY_DEG_DIVIDES_LE_MONIC ← prove
   r"!(r:A ring) p q.
        ring_divides (poly_ring r (:1)) p q /\
        monic r p /\
        ~(q = poly_0 r)
        ==> poly_deg r p <= poly_deg r q"
   (MESON_TAC [POLY_DEG_DIVIDES_LE_UNIVARIATE, RING_REGULAR_1, monic])

  -- @@RETURN BEGIN
  return { monic, MONIC_POLY_1, MONIC_POLY_0, MONIC_IMP_NONZERO, MONIC_IN_TRIVIAL_RING,
           MONIC_POLY_CONST, MONIC_DEG_0, MONIC_POLY_VAR, MONIC_SUBRING_GENERATED,
           POLY_DEG_MUL_MONIC, MONIC_POLY_MUL, MONIC_POLY_POW, MONIC_POLY_PRODUCT,
           MONIC_ASSOCIATES_EQ, MONIC_CMUL, FIELD_MONIC_ASSOCIATE,
           FIELD_MONIC_IRREDUCIBLE_ASSOCIATE, RING_COPRIME_DISTINCT_MONIC_IRREDUCIBLES,
           POLY_DEG_DIVIDES_LE_MONIC }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Reciprocal / reflection of univariate polynomial, reversing coeffs.       -/
/- (ringtheory.ml 26100-26457)                                               -/
/- ------------------------------------------------------------------------- -/

structure Reciprocal where
  -- @@FIELDS
  poly_recip : thm
  COEFF_POLY_RECIP : thm
  RING_POWERSERIES_RECIP : thm
  RING_POLYNOMIAL_RECIP : thm
  POLY_RECIP_IN_CARRIER : thm
  COEFF_0_POLY_RECIP_EQ_0 : thm
  POLY_DEG_RECIP_LE : thm
  POLY_DEG_RECIP : thm
  POLY_RECIP_RECIP : thm
  POLY_VARPOW_RECIP_RECIP : thm
  POLY_DIVIDES_RECIP_RECIP : thm
  POLY_RECIP_CONST : thm
  RING_UNIT_POLY_RECIP : thm
  RING_UNIT_POLY_RECIP_EQ : thm
  POLY_RECIP_0 : thm
  POLY_RECIP_EQ_0 : thm
  POLY_RECIP_RECIP_EQ : thm
  POLY_RECIP_1 : thm
  POLY_RECIP_NEG : thm
  POLY_RECIP_MUL_GEN : thm
  POLY_RECIP_MUL : thm
  POLY_DIVIDES_RECIP : thm
  POLY_DIVIDES_RECIP_GALOIS : thm
  POLY_DIVIDES_RECIP_EQ : thm
  RING_PRIME_POLY_RECIP : thm
  RING_PRIME_POLY_RECIP_EQ : thm
  RING_IRREDUCIBLE_POLY_RECIP : thm
  RING_IRREDUCIBLE_POLY_RECIP_EQ : thm
  POLY_EVAL_RECIP : thm
  deriving Inhabited

@[nospecialize]
def setupReciprocal [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BDivides : Divides) (BDomains : Domains) (BRingRule : RingRule) (BPrimes : Primes) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BOneCoeff : OneCoeff) (BDegree : Degree) (BEvaluation : Evaluation) (BZerodivisors : Zerodivisors) (BDivision : Division) :
    ExceptT String IO Reciprocal := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, basic_ss,
        new_definition, .. } := D
  let { FINITE_NUMSEG, FORALL_ONE_THM, FORALL_PAIR_THM, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_NUMSEG, LE, LEFT_IMP_EXISTS_THM, LE_0,
        LE_REFL, LE_TRANS, LT, .. } := D.core5
  let { MONO_OR, NOT_LE, NUMSEG_SING, PAIR_EQ, .. } := D.core6
  let { SUBSET_NUMSEG, SUBSET_UNIV, SUB_0, SUB_REFL, .. } := D.core7
  let { RING_0, RING_MUL, RING_MUL_LZERO, RING_MUL_RZERO, RING_NEG_0, .. } := BBasics
  let { RING_MUL_POW, RING_POW, RING_POW_ADD, RING_POW_ONE, .. } := BNumbers
  let { RING_SUM_EQ, RING_SUM_EQ_0, RING_SUM_EQ_GENERAL_INVERSES, RING_SUM_LMUL,
        RING_SUM_REFLECT, RING_SUM_SING, RING_SUM_SUPERSET, RING_SUM_SUPPORT, .. } := BSums
  let { RING_DIVIDES_ALT, RING_DIVIDES_TRANS, RING_INV, RING_MUL_RINV,
        RING_UNIT_IN_CARRIER, ring_divides, .. } := BDivides
  let { integral_domain, .. } := BDomains
  let { RING_TAC, .. } := BRingRule
  let { ring_irreducible, ring_prime, .. } := BPrimes
  let { POLY_CONST_0, POLY_CONST_1, POLY_MUL_0, RING_POLYNOMIAL_IMP_POWERSERIES,
        RING_POLYNOMIAL_MUL, RING_POLYNOMIAL_VAR, .. } := BPowerSeries
  let { POLY_RING, RING_POLYNOMIAL, RING_POLYNOMIAL_POW, .. } := BPolyRings
  let { COEFF_IN_CARRIER, COEFF_IN_CARRIER_ALT, COEFF_POLY_0, COEFF_POLY_CONST,
        COEFF_POLY_MUL, COEFF_POLY_MUL_ALT, COEFF_POLY_NEG, COEFF_POLY_VARPOW_MUL,
        FUN_EQ_COEFF, RING_POLYNOMIAL_COEFF_BOUND, RING_POWERSERIES_COEFF, coeff, .. } := BOneCoeff
  let { COEFF_ABOVE_DEG, POLY_DEG_CONST, POLY_DEG_EQ_FROM_LE, POLY_DEG_LE_COEFF_EQ,
        POLY_DEG_MUL_LE, POLY_DEG_NEG, POLY_MUL_LEADING_COEFF, .. } := BDegree
  let { POLY_EVAL_EXPAND, .. } := BEvaluation
  let { RING_UNIT_POLY_DOMAIN, .. } := BZerodivisors
  let { POLY_TOP_EQ_0, .. } := BDivision
  -- @@SCOPE END

  let poly_recip ← new_definition
   r"poly_recip (r:A ring) p =
        \m. if m one <= poly_deg r p then p(\v:1. poly_deg r p - m one)
            else ring_0 r"

  let COEFF_POLY_RECIP ← prove
   r"!(r:A ring) p i.
        coeff i (poly_recip r p) =
        if i <= poly_deg r p then coeff (poly_deg r p - i) p else ring_0 r"
   (REWRITE_TAC [coeff, poly_recip])

  let RING_POWERSERIES_RECIP ← prove
   r"!(r:A ring) p.
        ring_powerseries r p ==> ring_powerseries r (poly_recip r p)"
   (REWRITE_TAC [RING_POWERSERIES_COEFF, COEFF_POLY_RECIP] THEN
    MESON_TAC [RING_0])

  let RING_POLYNOMIAL_RECIP ← prove
   r"!(r:A ring) p. ring_polynomial r p ==> ring_polynomial r (poly_recip r p)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_POLYNOMIAL_COEFF_BOUND THEN
    ASM_SIMP_TAC [RING_POWERSERIES_RECIP, RING_POLYNOMIAL_IMP_POWERSERIES] THEN
    EXISTS_TAC (← q "poly_deg r (p:(1->num)->A)") THEN
    REWRITE_TAC [COEFF_POLY_RECIP] THEN MESON_TAC [])

  let POLY_RECIP_IN_CARRIER ← prove
   r"!(r:A ring) p.
        p IN ring_carrier(poly_ring r (:1))
        ==> poly_recip r p IN ring_carrier(poly_ring r (:1))"
   (REWRITE_TAC [← GSYM RING_POLYNOMIAL, RING_POLYNOMIAL_RECIP])

  let COEFF_0_POLY_RECIP_EQ_0 ← prove
   r"!(r:A ring) p.
        ring_polynomial r p
        ==> (coeff 0 (poly_recip r p) = ring_0 r <=> p = poly_0 r)"
   (SIMP_TAC [COEFF_POLY_RECIP, LE_0, SUB_0, POLY_TOP_EQ_0])

  let POLY_DEG_RECIP_LE ← prove
   r"!(r:A ring) p.
        ring_polynomial r p
        ==> poly_deg r (poly_recip r p) <= poly_deg r p"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [POLY_DEG_LE_COEFF_EQ, RING_POLYNOMIAL_RECIP] THEN
    REWRITE_TAC [COEFF_POLY_RECIP] THEN MESON_TAC [])

  let POLY_DEG_RECIP ← prove
   r"!(r:A ring) p.
        ring_polynomial r p /\ ~(coeff 0 p = ring_0 r)
        ==> poly_deg r (poly_recip r p) = poly_deg r p"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC POLY_DEG_EQ_FROM_LE THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_RECIP, POLY_DEG_RECIP_LE] THEN
    ASM_REWRITE_TAC [COEFF_POLY_RECIP, SUB_REFL, LE_REFL])

  let POLY_RECIP_RECIP ← prove
   r"!(r:A ring) p.
        ring_polynomial r p /\ ~(coeff 0 p = ring_0 r)
        ==> poly_recip r (poly_recip r p) = p"
   (← do
    -- right to left: the second ARITH_RULE, then the first
    let a2 ← ARITH_RULE (← q "p - d:num <= p")
    let a1 ← ARITH_RULE (← q "d:num <= p ==> p - (p - d) = d")
    pure (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM FUN_EQ_COEFF, COEFF_POLY_RECIP, POLY_DEG_RECIP] THEN
    SIMP_TAC [a1] THEN
    GEN_TAC THEN REWRITE_TAC [a2] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [COEFF_ABOVE_DEG, NOT_LE]))

  let POLY_VARPOW_RECIP_RECIP ← prove
   r"!(r:A ring) x p.
      ring_polynomial r p
      ==> poly_mul r (poly_pow r (poly_var r x)
                                 (poly_deg r p - poly_deg r (poly_recip r p)))
                     (poly_recip r (poly_recip r p)) = p"
   (REWRITE_TAC [FORALL_ONE_THM, ← GSYM FUN_EQ_COEFF] THEN REPEAT STRIP_TAC THEN
    wPart lhand (fun t => do lhand (← rand t)) COEFF_POLY_VARPOW_MUL THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [RING_POLYNOMIAL_IMP_POWERSERIES, RING_POLYNOMIAL_RECIP],
      DISCH_THEN SUBST1_TAC] THEN
    REWRITE_TAC [COEFF_POLY_RECIP] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP POLY_DEG_RECIP_LE) THEN DISCH_TAC THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THENL
     [MP_TAC (← ISPECL [← q "r:A ring", ← q "poly_recip (r:A ring) p",
                   ← q "poly_deg r (p:(1->num)->A) - d"] COEFF_ABOVE_DEG) THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_RECIP] THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
      REWRITE_TAC [COEFF_POLY_RECIP, ← ARITH_RULE (← q "n - m:num <= n")] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN ASM_ARITH_TAC,
      AP_THM_TAC THEN AP_TERM_TAC THEN ASM_ARITH_TAC,
      ASM_ARITH_TAC,
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC COEFF_ABOVE_DEG THEN
      ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC])

  let POLY_DIVIDES_RECIP_RECIP ← prove
   r"!(r:A ring) p.
      ring_polynomial r p
      ==> ring_divides (poly_ring r (:1)) (poly_recip r (poly_recip r p)) p"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [RING_DIVIDES_ALT] THEN
    ASM_SIMP_TAC [← GSYM RING_POLYNOMIAL, RING_POLYNOMIAL_RECIP] THEN
    EXISTS_TAC (← q r"poly_pow r (poly_var (r:A ring) one)
                           (poly_deg r p - poly_deg r (poly_recip r p))") THEN
    ASM_SIMP_TAC [POLY_VARPOW_RECIP_RECIP, POLY_RING] THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR])

  let POLY_RECIP_CONST ← prove
   r"!r c:A. poly_recip r (poly_const r c) = poly_const r c"
   (REWRITE_TAC [← GSYM FUN_EQ_COEFF, COEFF_POLY_RECIP, COEFF_POLY_CONST] THEN
    REWRITE_TAC [POLY_DEG_CONST, ← CONJUNCT1 LE, SUB_0])

  let RING_UNIT_POLY_RECIP ← prove
   r"!(r:A ring) p.
        integral_domain r /\
        ring_unit (poly_ring r (:1)) p
        ==> ring_unit (poly_ring r (:1)) (poly_recip r p)"
   (MESON_TAC [RING_UNIT_POLY_DOMAIN, POLY_RECIP_CONST])

  let RING_UNIT_POLY_RECIP_EQ ← prove
   r"!(r:A ring) p.
        integral_domain r /\ ring_polynomial r p /\ ~(coeff 0 p = ring_0 r)
        ==> (ring_unit (poly_ring r (:1)) (poly_recip r p) <=>
             ring_unit (poly_ring r (:1)) p)"
   (MESON_TAC [RING_UNIT_POLY_RECIP, POLY_RECIP_RECIP])

  let POLY_RECIP_0 ← prove
   r"!(r:A ring). poly_recip r (poly_0 r) = poly_0 r"
   (REWRITE_TAC [← GSYM POLY_CONST_0, POLY_RECIP_CONST])

  let POLY_RECIP_EQ_0 ← prove
   r"!(r:A ring) p.
        ring_polynomial r p
        ==> (poly_recip r p = poly_0 r <=> p = poly_0 r)"
   (MESON_TAC [COEFF_0_POLY_RECIP_EQ_0, COEFF_POLY_0, POLY_RECIP_0])

  let POLY_RECIP_RECIP_EQ ← prove
   r"!(r:A ring) p.
        ring_polynomial r p
        ==> (poly_recip r (poly_recip r p) = p <=>
             coeff 0 p = ring_0 r ==> p = poly_0 r)"
   (MESON_TAC [POLY_RECIP_RECIP, POLY_RECIP_EQ_0, RING_POLYNOMIAL_RECIP,
               COEFF_0_POLY_RECIP_EQ_0])

  let POLY_RECIP_1 ← prove
   r"!(r:A ring). poly_recip r (poly_1 r) = poly_1 r"
   (REWRITE_TAC [← GSYM POLY_CONST_1, POLY_RECIP_CONST])

  let POLY_RECIP_NEG ← prove
   r"!(r:A ring) p.
        ring_polynomial r p
        ==> poly_recip r (poly_neg r p) = poly_neg r (poly_recip r p)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM FUN_EQ_COEFF, COEFF_POLY_RECIP, COEFF_POLY_NEG] THEN
    GEN_TAC THEN ASM_SIMP_TAC [POLY_DEG_NEG] THEN ASM_MESON_TAC [RING_NEG_0])

  let POLY_RECIP_MUL_GEN ← prove
   r"!(r:A ring) p q.
      ring_polynomial r p /\
      ring_polynomial r q /\
      (ring_mul r (coeff (poly_deg r p) p) (coeff (poly_deg r q) q) = ring_0 r
       ==> coeff (poly_deg r p) p = ring_0 r \/
           coeff (poly_deg r q) q = ring_0 r)
      ==> poly_recip r (poly_mul r p q) =
          poly_mul r (poly_recip r p) (poly_recip r q)"
   (← do
    -- right to left: the second ARITH_RULE, then the first
    let a2 ← ARITH_RULE (← q "i:num <= n ==> n - (n - i) = i")
    let a1 ← ARITH_RULE (← q "n - i:num <= n")
    pure (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_SIMP_TAC [POLY_TOP_EQ_0] THEN
    ASM_CASES_TAC (← q "p:(1->num)->A = poly_0 r") THEN
    ASM_SIMP_TAC [POLY_MUL_0, POLY_RECIP_0, RING_POLYNOMIAL_RECIP] THEN
    ASM_CASES_TAC (← q "q:(1->num)->A = poly_0 r") THEN
    ASM_SIMP_TAC [POLY_MUL_0, POLY_RECIP_0, RING_POLYNOMIAL_RECIP] THEN
    DISCH_TAC THEN
    REWRITE_TAC [← GSYM FUN_EQ_COEFF, COEFF_POLY_RECIP, COEFF_POLY_MUL_ALT] THEN
    SUBGOAL_THEN
     (← q "poly_deg r (poly_mul r p q:(1->num)->A) = poly_deg r p + poly_deg r q")
    SUBST1_TAC THENL
     [MATCH_MP_TAC POLY_DEG_EQ_FROM_LE THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_MUL, POLY_DEG_MUL_LE] THEN
      ASM_SIMP_TAC [POLY_MUL_LEADING_COEFF],
      X_GEN_TAC (← q "n:num")] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [ONCE_REWRITE_TAC [← GSYM RING_SUM_SUPPORT] THEN
      MATCH_MP_TAC RING_SUM_EQ_GENERAL_INVERSES THEN
      REPEAT (EXISTS_TAC
       (← q r"\(i,j). poly_deg r (p:(1->num)->A) - i,
                poly_deg r (q:(1->num)->A) - j")) THEN
      REWRITE_TAC [FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN
      ONCE_REWRITE_TAC [IN_ELIM_THM] THEN
      REWRITE_TAC [IN_ELIM_PAIR_THM] THEN
      REWRITE_TAC [a1, PAIR_EQ] THEN
      CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q "i:num", ← q "j:num"] THENL
       [REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
        ASM_SIMP_TAC [RING_MUL_LZERO, RING_MUL_RZERO, COEFF_IN_CARRIER, RING_0,
                      RING_POLYNOMIAL_IMP_POWERSERIES] THEN
        ASM_ARITH_TAC,
        ASM_CASES_TAC (← q "i <= poly_deg r (p:(1->num)->A)") THENL
         [ALL_TAC,
          ASM_MESON_TAC [COEFF_ABOVE_DEG, NOT_LE, RING_MUL_LZERO,
                         COEFF_IN_CARRIER, RING_POLYNOMIAL_IMP_POWERSERIES]] THEN
        ASM_CASES_TAC (← q "j <= poly_deg r (q:(1->num)->A)") THENL
         [ALL_TAC,
          ASM_MESON_TAC [COEFF_ABOVE_DEG, NOT_LE, RING_MUL_RZERO,
                         COEFF_IN_CARRIER, RING_POLYNOMIAL_IMP_POWERSERIES]] THEN
        ASM_SIMP_TAC [a2] THEN
        ASM_ARITH_TAC],
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_SUM_EQ_0 THEN
      REWRITE_TAC [FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN
      REPEAT STRIP_TAC THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
        ASM_SIMP_TAC [RING_MUL_LZERO, RING_MUL_RZERO, COEFF_IN_CARRIER, RING_0,
                      RING_POLYNOMIAL_IMP_POWERSERIES] THEN
      ASM_ARITH_TAC]))

  let POLY_RECIP_MUL ← prove
   r"!(r:A ring) p q.
        integral_domain r /\
        ring_polynomial r p /\
        ring_polynomial r q
        ==> poly_recip r (poly_mul r p q) =
            poly_mul r (poly_recip r p) (poly_recip r q)"
   (REWRITE_TAC [integral_domain] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC POLY_RECIP_MUL_GEN THEN
    ASM_MESON_TAC [COEFF_IN_CARRIER_ALT])

  let POLY_DIVIDES_RECIP ← prove
   r"!(r:A ring) p q.
        integral_domain r /\
        ring_divides (poly_ring r (:1)) p q
        ==> ring_divides (poly_ring r (:1)) (poly_recip r p) (poly_recip r q)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [ring_divides, LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
    REWRITE_TAC [← GSYM RING_POLYNOMIAL, ← CONJUNCT2 POLY_RING] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "s:(1->num)->A") THEN
    REPEAT DISCH_TAC THEN ASM_SIMP_TAC [RING_POLYNOMIAL_RECIP] THEN
    EXISTS_TAC (← q "poly_recip (r:A ring) s") THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_RECIP, POLY_RECIP_MUL])

  let POLY_DIVIDES_RECIP_GALOIS ← prove
   r"!(r:A ring) p q.
        integral_domain r /\
        ring_polynomial r q /\
        ring_divides (poly_ring r (:1)) p (poly_recip r q)
        ==> ring_divides (poly_ring r (:1)) (poly_recip r p) q"
   (MESON_TAC [POLY_DIVIDES_RECIP, POLY_DIVIDES_RECIP_RECIP,
               RING_DIVIDES_TRANS])

  let POLY_DIVIDES_RECIP_EQ ← prove
   r"!(r:A ring) p q.
    integral_domain r /\
    ring_polynomial r p /\ ring_polynomial r q /\
    ~(coeff 0 p = ring_0 r)
    ==> (ring_divides (poly_ring r (:1)) (poly_recip r p) (poly_recip r q) <=>
         ring_divides (poly_ring r (:1)) p q)"
   (MESON_TAC [POLY_DIVIDES_RECIP, POLY_DIVIDES_RECIP_GALOIS, POLY_RECIP_RECIP])

  let RING_PRIME_POLY_RECIP ← prove
   r"!(r:A ring) p.
        integral_domain r /\ ~(coeff 0 p = ring_0 r) /\
        ring_prime (poly_ring r (:1)) p
        ==> ring_prime (poly_ring r (:1)) (poly_recip r p)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [ring_prime, POLY_RING, SUBSET_UNIV, IN_ELIM_THM] THEN
    STRIP_TAC THEN
    ASM_SIMP_TAC [RING_UNIT_POLY_RECIP_EQ, RING_POLYNOMIAL_RECIP,
                  POLY_RECIP_EQ_0] THEN
    MAP_EVERY X_GEN_TAC [← q "d:(1->num)->A", ← q "e:(1->num)->A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q "poly_recip (r:A ring) d", ← q "poly_recip (r:A ring) e"]) THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_RECIP] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [POLY_DIVIDES_RECIP, POLY_RECIP_RECIP, POLY_RECIP_MUL],
      MATCH_MP_TAC MONO_OR] THEN
    ASM_MESON_TAC [POLY_DIVIDES_RECIP, POLY_DIVIDES_RECIP_RECIP,
                   RING_DIVIDES_TRANS])

  let RING_PRIME_POLY_RECIP_EQ ← prove
   r"!(r:A ring) p.
        integral_domain r /\ ring_polynomial r p /\ ~(coeff 0 p = ring_0 r)
        ==> (ring_prime (poly_ring r (:1)) (poly_recip r p) <=>
             ring_prime (poly_ring r (:1)) p)"
   (MESON_TAC [RING_PRIME_POLY_RECIP, POLY_RECIP_RECIP,
               COEFF_0_POLY_RECIP_EQ_0, COEFF_POLY_0])

  let RING_IRREDUCIBLE_POLY_RECIP ← prove
   r"!(r:A ring) p.
        integral_domain r /\ ~(coeff 0 p = ring_0 r) /\
        ring_irreducible (poly_ring r (:1)) p
        ==> ring_irreducible (poly_ring r (:1)) (poly_recip r p)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [ring_irreducible, POLY_RING, SUBSET_UNIV, IN_ELIM_THM] THEN
    STRIP_TAC THEN
    ASM_SIMP_TAC [RING_UNIT_POLY_RECIP_EQ, RING_POLYNOMIAL_RECIP,
                  POLY_RECIP_EQ_0] THEN
    MAP_EVERY X_GEN_TAC [← q "d:(1->num)->A", ← q "e:(1->num)->A"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SYM o AP_TERM (← q "coeff 0:((1->num)->A)->A")) THEN
    REWRITE_TAC [COEFF_POLY_MUL, NUMSEG_SING, RING_SUM_SING] THEN
    ASM_SIMP_TAC [RING_MUL, COEFF_IN_CARRIER_ALT, SUB_0] THEN
    MAP_EVERY ASM_CASES_TAC
     [← q "coeff 0 d:A = ring_0 r", ← q "coeff 0 e:A = ring_0 r"] THEN
    ASM_SIMP_TAC [RING_MUL_LZERO, RING_MUL_RZERO, COEFF_IN_CARRIER_ALT, RING_0,
                  COEFF_0_POLY_RECIP_EQ_0] THEN
    DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN FIRST_X_ASSUM (MP_TAC o SPECL
     [← q "poly_recip (r:A ring) d", ← q "poly_recip (r:A ring) e"]) THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_RECIP, RING_UNIT_POLY_RECIP_EQ] THEN
    ASM_SIMP_TAC [← GSYM POLY_RECIP_MUL, POLY_RECIP_RECIP])

  let RING_IRREDUCIBLE_POLY_RECIP_EQ ← prove
   r"!(r:A ring) p.
        integral_domain r /\ ring_polynomial r p /\ ~(coeff 0 p = ring_0 r)
        ==> (ring_irreducible (poly_ring r (:1)) (poly_recip r p) <=>
             ring_irreducible (poly_ring r (:1)) p)"
   (MESON_TAC [RING_IRREDUCIBLE_POLY_RECIP, POLY_RECIP_RECIP,
               COEFF_0_POLY_RECIP_EQ_0, COEFF_POLY_0])

  let POLY_EVAL_RECIP ← prove
   r"!r p x:A.
        ring_polynomial r p /\ ring_unit r x
        ==> poly_eval r (poly_recip r p) x =
            ring_mul r (ring_pow r x (poly_deg r p))
                       (poly_eval r p (ring_inv r x))"
   (← do
    -- right to left: the ARITH_RULE, the MESON, then the basic_ss []
    let a3 ← ARITH_RULE (← q "i:num <= p ==> (p - i) + i = p")
    let m2 ← MESON []
     (← q r"ring_sum r t g = ring_sum r s g /\
      ring_sum r s f = ring_sum r s g
      ==> ring_sum r s f = ring_sum r t g")
    let ss ← ExceptT.mk (basic_ss [])
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_UNIT_IN_CARRIER) THEN
    ASM_SIMP_TAC [POLY_EVAL_EXPAND, RING_INV, RING_POLYNOMIAL_RECIP, ← GSYM
                  RING_POLYNOMIAL] THEN
    wPart (fun t => do rand (← rand t)) (fun t => do lhand (← rand t))
      RING_SUM_REFLECT THEN
    REWRITE_TAC [← CONJUNCT1 LT, SUB_0] THEN
    ANTS_TAC THENL [ALL_TAC, DISCH_THEN SUBST1_TAC] THEN
    ASM (simpTac ss 4)
     [POLY_EVAL_EXPAND, ← GSYM RING_POLYNOMIAL, RING_INV, FINITE_NUMSEG,
      RING_POLYNOMIAL_RECIP, POLY_DEG_RECIP, ← GSYM RING_SUM_LMUL,
      RING_MUL, RING_POW, COEFF_IN_CARRIER_ALT] THEN
    MATCH_MP_TAC m2 THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_SUM_SUPERSET THEN
      REWRITE_TAC [SUBSET_NUMSEG, ← CONJUNCT1 LT, LE_0, IN_NUMSEG] THEN
      ASM_SIMP_TAC [POLY_DEG_RECIP_LE, NOT_LE] THEN
      X_GEN_TAC (← q "i:num") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q "poly_recip (r:A ring) p", ← q "i:num"]
          COEFF_ABOVE_DEG) THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_RECIP, COEFF_POLY_RECIP] THEN
      RING_TAC THEN ASM_SIMP_TAC [COEFF_IN_CARRIER_ALT, RING_INV],
      MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q "i:num") THEN
      REWRITE_TAC [IN_NUMSEG, LE_0, COEFF_POLY_RECIP] THEN
      DISCH_TAC THEN COND_CASES_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [POLY_DEG_RECIP_LE, LE_TRANS]] THEN
      FIRST_ASSUM (MP_TAC o SPECL [← q "poly_deg r (p:(1->num)->A) - i", ← q "i:num"] o
        MATCH_MP RING_POW_ADD) THEN
      ASM_SIMP_TAC [a3] THEN
      DISCH_THEN SUBST1_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP RING_MUL_RINV) THEN
      DISCH_THEN (MP_TAC o AP_TERM
       (← q r"\x:A. ring_pow r x (poly_deg r (p:(1->num)->A) - i)")) THEN
      ASM_SIMP_TAC [RING_MUL_POW, RING_INV, RING_POW_ONE] THEN
      RING_TAC THEN ASM_SIMP_TAC [COEFF_IN_CARRIER_ALT, RING_INV]]))

  -- @@RETURN BEGIN
  return { poly_recip, COEFF_POLY_RECIP, RING_POWERSERIES_RECIP, RING_POLYNOMIAL_RECIP,
           POLY_RECIP_IN_CARRIER, COEFF_0_POLY_RECIP_EQ_0, POLY_DEG_RECIP_LE,
           POLY_DEG_RECIP, POLY_RECIP_RECIP, POLY_VARPOW_RECIP_RECIP,
           POLY_DIVIDES_RECIP_RECIP, POLY_RECIP_CONST, RING_UNIT_POLY_RECIP,
           RING_UNIT_POLY_RECIP_EQ, POLY_RECIP_0, POLY_RECIP_EQ_0, POLY_RECIP_RECIP_EQ,
           POLY_RECIP_1, POLY_RECIP_NEG, POLY_RECIP_MUL_GEN, POLY_RECIP_MUL,
           POLY_DIVIDES_RECIP, POLY_DIVIDES_RECIP_GALOIS, POLY_DIVIDES_RECIP_EQ,
           RING_PRIME_POLY_RECIP, RING_PRIME_POLY_RECIP_EQ, RING_IRREDUCIBLE_POLY_RECIP,
           RING_IRREDUCIBLE_POLY_RECIP_EQ, POLY_EVAL_RECIP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Formal derivative of a univariate polynomial.                             -/
/- (ringtheory.ml 26457-26720)                                               -/
/- ------------------------------------------------------------------------- -/

structure Derivative where
  -- @@FIELDS
  poly_deriv : thm
  POLY_DERIV_SUBRING_GENERATED : thm
  COEFF_POLY_DERIV : thm
  RING_POWERSERIES_POLY_DERIV : thm
  POWSER_DERIV_IN_CARRIER : thm
  RING_POLYNOMIAL_POLY_DERIV : thm
  POLY_DERIV_IN_CARRIER : thm
  POLY_DEG_DERIV_LE : thm
  POLY_DEG_DERIV : thm
  POLY_DERIV_NONZERO_CHAR0 : thm
  POLY_DERIV_CONST : thm
  POLY_DERIV_0 : thm
  POLY_DERIV_1 : thm
  POLY_DERIV_VAR : thm
  POLY_DERIV_ADD : thm
  POLY_DERIV_NEG : thm
  POLY_DERIV_SUB : thm
  POLY_DERIV_CMUL : thm
  POLY_DERIV_HOMOMORPHIC_IMAGE : thm
  POLY_DERIV_MUL : thm
  POLY_DERIV_SUM : thm
  POLY_DERIV_PRODUCT : thm
  POLY_DERIV_POW : thm
  POLY_DERIV_VAR_POW : thm
  deriving Inhabited

@[nospecialize]
def setupDerivative [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BProducts : Products) (BSubrings : Subrings) (BDomains : Domains) (BHoms : Homs) (BRingRule : RingRule) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BOneCoeff : OneCoeff) (BDegree : Degree) (BDivision : Division) :
    ExceptT String IO Derivative := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_RULE, new_definition, .. } := D
  let { ADD1, ADD_CLAUSES, ADD_EQ_0, ADD_SUB, ARITH_EQ, CARD_DELETE, CARD_NUMSEG_1, .. } := D.core1
  let { CONTRAPOS_THM, DIVIDES_ZERO, .. } := D.core2
  let { FINITE_DELETE, FINITE_INDUCT_STRONG, FINITE_NUMSEG, FINITE_SUBSET_NUMSEG,
        FORALL_IN_INSERT, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, .. } := D.core4
  let { IN_DELETE, IN_ELIM_THM, IN_NUMSEG, LE_0, LE_1, LE_REFL, .. } := D.core5
  let { MONO_AND, MONO_EXISTS, NOT_IN_EMPTY, NOT_LT, .. } := D.core6
  let { SUBSET, SUB_0, SUB_ADD, .. } := D.core7
  let { RING_0, RING_1, RING_ADD, RING_ADD_LDISTRIB, RING_MUL, RING_MUL_AC,
        RING_MUL_LID, RING_MUL_RNEG, RING_MUL_RZERO, .. } := BBasics
  let { RING_OF_NUM, RING_OF_NUM_1, RING_OF_NUM_ADD, RING_OF_NUM_EQ_0, RING_POW, .. } := BNumbers
  let { RING_SUM, RING_SUM_ADD, RING_SUM_CLAUSES, RING_SUM_CLAUSES_LEFT,
        RING_SUM_CLAUSES_RIGHT, RING_SUM_CONST, RING_SUM_EQ, RING_SUM_LMUL,
        RING_SUM_OFFSET, .. } := BSums
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, RING_PRODUCT_CONST, .. } := BProducts
  let { RING_OF_NUM_SUBRING_GENERATED, SUBRING_GENERATED, .. } := BSubrings
  let { INTEGRAL_DOMAIN_MUL_EQ_0, .. } := BDomains
  let { RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_RING_OF_NUM, .. } := BHoms
  let { RING_RULE, RING_TAC, .. } := BRingRule
  let { POLY_CONST_0, POLY_CONST_1, POLY_MUL_LID, POLY_SUB, RING_POWERSERIES_NEG,
        RING_POWERSERIES_VAR, poly_1, .. } := BPowerSeries
  let { POLY_RING_CLAUSES, POWSER_CLAUSES, RING_OF_NUM_POWSER_RING, RING_POLYNOMIAL,
        RING_POWERSERIES, RING_POWERSERIES_POW, .. } := BPolyRings
  let { COEFF, COEFF_COMPOSE, COEFF_IN_CARRIER, COEFF_IN_CARRIER_ALT, COEFF_POLY_0,
        COEFF_POLY_ADD, COEFF_POLY_CONST, COEFF_POLY_LMUL, COEFF_POLY_MUL,
        COEFF_POLY_NEG, COEFF_POLY_VAR, FUN_EQ_COEFF, RING_POLYNOMIAL_COEFF,
        RING_POWERSERIES_COEFF, .. } := BOneCoeff
  let { COEFF_POWSER_SUM, POLY_DEG_0, POLY_DEG_EQ_FROM_LE, POLY_DEG_GE_COEFF,
        POLY_DEG_LE_COEFF_EQ, .. } := BDegree
  let { POLY_TOP_EQ_0, .. } := BDivision
  -- @@SCOPE END

  let poly_deriv ← new_definition
   r"poly_deriv (r:A ring) (p:(1->num)->A) =
    \m:1->num. ring_mul r (ring_of_num r (SUC(m one)))
                          (coeff (SUC(m one)) p)"

  let POLY_DERIV_SUBRING_GENERATED ← prove
   r"!(r:A ring) (s:A->bool) p.
    poly_deriv (subring_generated r s) p = poly_deriv r p"
   (REWRITE_TAC [poly_deriv, SUBRING_GENERATED, RING_OF_NUM_SUBRING_GENERATED])

  let COEFF_POLY_DERIV ← prove
   r"!(r:A ring) p d.
     coeff d (poly_deriv r p) =
     ring_mul r (ring_of_num r (d + 1)) (coeff (d + 1) p)"
   (REWRITE_TAC [COEFF, poly_deriv, ADD1])

  let RING_POWERSERIES_POLY_DERIV ← prove
   r"!(r:A ring) p.
     ring_powerseries r p ==> ring_powerseries r (poly_deriv r p)"
   (REWRITE_TAC [RING_POWERSERIES_COEFF, COEFF_POLY_DERIV] THEN
    SIMP_TAC [RING_MUL, RING_OF_NUM])

  let POWSER_DERIV_IN_CARRIER ← prove
   r"!(r:A ring) p.
      p IN ring_carrier(powser_ring r (:1))
      ==> poly_deriv r p IN ring_carrier(powser_ring r (:1))"
   (REWRITE_TAC [← GSYM RING_POWERSERIES, RING_POWERSERIES_POLY_DERIV])

  let RING_POLYNOMIAL_POLY_DERIV ← prove
   r"!(r:A ring) p.
     ring_polynomial r p ==> ring_polynomial r (poly_deriv r p)"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [RING_POLYNOMIAL_COEFF, COEFF_POLY_DERIV] THEN
    MATCH_MP_TAC MONO_AND THEN SIMP_TAC [RING_MUL, RING_OF_NUM] THEN
    REWRITE_TAC [FINITE_SUBSET_NUMSEG] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_NUMSEG, LE_0] THEN
    REWRITE_TAC [← GSYM NOT_LT, CONTRAPOS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [← ARITH_RULE (← q "n < x ==> n < x + 1")] THEN
    SIMP_TAC [RING_MUL_RZERO, RING_OF_NUM])

  let POLY_DERIV_IN_CARRIER ← prove
   r"!(r:A ring) p.
      p IN ring_carrier(poly_ring r (:1))
      ==> poly_deriv r p IN ring_carrier(poly_ring r (:1))"
   (REWRITE_TAC [← GSYM RING_POLYNOMIAL, RING_POLYNOMIAL_POLY_DERIV])

  let POLY_DEG_DERIV_LE ← prove
   r"!(r:A ring) p.
    ring_polynomial r p ==> poly_deg r (poly_deriv r p) <= poly_deg r p - 1"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [POLY_DEG_LE_COEFF_EQ, RING_POLYNOMIAL_POLY_DERIV] THEN
    REWRITE_TAC [COEFF_POLY_DERIV] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ARITH_RULE (← q "d + 1 <= i ==> d <= i - 1")) THEN
    MATCH_MP_TAC POLY_DEG_GE_COEFF THEN EXISTS_TAC (← q "d + 1") THEN
    ASM_MESON_TAC [RING_MUL_RZERO, RING_OF_NUM, LE_REFL])

  let POLY_DEG_DERIV ← prove
   r"!(r:A ring) (p:(1->num)->A).
        integral_domain r /\ ring_char r = 0 /\ ring_polynomial r p
        ==> poly_deg r (poly_deriv r p) = poly_deg r p - 1"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP POLY_DEG_DERIV_LE) THEN
    ASM_CASES_TAC (← q "poly_deg r (p:(1->num)->A) = 0") THENL
     [ASM_ARITH_TAC, MATCH_MP_TAC POLY_DEG_EQ_FROM_LE] THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_POLY_DERIV, COEFF_POLY_DERIV] THEN
    ASM_SIMP_TAC [COEFF_IN_CARRIER_ALT, INTEGRAL_DOMAIN_MUL_EQ_0, RING_OF_NUM,
                  ← ARITH_RULE (← q "~(n = 0) ==> n - 1 + 1 = n")] THEN
    ASM_SIMP_TAC [POLY_TOP_EQ_0, RING_OF_NUM_EQ_0, DIVIDES_ZERO] THEN
    ASM_MESON_TAC [POLY_DEG_0])

  let POLY_DERIV_NONZERO_CHAR0 ← prove
   r"!(k:A ring) p.
    integral_domain k /\ ring_char k = 0 /\
    ring_polynomial k p /\
    1 <= poly_deg k p
    ==> ~(poly_deriv k p = poly_0 k)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM FUN_EQ_COEFF, COEFF_POLY_DERIV, COEFF_POLY_0] THEN
    DISCH_THEN (MP_TAC o SPEC (← q "poly_deg k (p:(1->num)->A) - 1")) THEN
    ASM_SIMP_TAC [COEFF_IN_CARRIER_ALT, INTEGRAL_DOMAIN_MUL_EQ_0, RING_OF_NUM,
                  SUB_ADD, POLY_TOP_EQ_0, RING_OF_NUM_EQ_0, DIVIDES_ZERO] THEN
    ASM_MESON_TAC [POLY_DEG_0, LE_1])

  let POLY_DERIV_CONST ← prove
   r"!(r:A ring) c. poly_deriv r (poly_const r c) = poly_0 r"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM FUN_EQ_COEFF, COEFF_POLY_DERIV] THEN
    REWRITE_TAC [COEFF_POLY_0, COEFF_POLY_CONST] THEN
    SIMP_TAC [ADD_EQ_0, ARITH_EQ, RING_MUL_RZERO, RING_OF_NUM])

  let POLY_DERIV_0 ← prove
   r"!(r:A ring). poly_deriv r (poly_0 r) = poly_0 r"
   (SIMP_TAC [← GSYM POLY_CONST_0, POLY_DERIV_CONST, RING_0])

  let POLY_DERIV_1 ← prove
   r"!(r:A ring). poly_deriv r (poly_1 r) = poly_0 r"
   (SIMP_TAC [← GSYM POLY_CONST_1, POLY_DERIV_CONST, RING_1])

  let POLY_DERIV_VAR ← prove
   r"!(r:A ring). poly_deriv r (poly_var r (one:1)) = poly_const r (ring_1 r)"
   (REWRITE_TAC [← GSYM FUN_EQ_COEFF] THEN
    REWRITE_TAC [COEFF_POLY_DERIV, COEFF_POLY_VAR, COEFF_POLY_CONST] THEN
    REWRITE_TAC [← ARITH_RULE (← q "d + 1 = 1 <=> d = 0")] THEN
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [RING_MUL_RZERO, RING_OF_NUM] THEN
    SIMP_TAC [ADD_CLAUSES, RING_OF_NUM_1, RING_MUL_LID, RING_1])

  let POLY_DERIV_ADD ← prove
   r"!(r:A ring) p q.
     ring_powerseries r p /\ ring_powerseries r q
     ==> poly_deriv r (poly_add r p q) =
         poly_add r (poly_deriv r p) (poly_deriv r q)"
   (REWRITE_TAC [← GSYM FUN_EQ_COEFF] THEN
    REWRITE_TAC [COEFF_POLY_DERIV, COEFF_POLY_ADD] THEN
    MESON_TAC [COEFF_IN_CARRIER, RING_OF_NUM, RING_ADD_LDISTRIB])

  let POLY_DERIV_NEG ← prove
   r"!(r:A ring) p.
     ring_powerseries r p
     ==> poly_deriv r (poly_neg r p) = poly_neg r (poly_deriv r p)"
   (REWRITE_TAC [← GSYM FUN_EQ_COEFF] THEN
    REWRITE_TAC [COEFF_POLY_DERIV, COEFF_POLY_NEG] THEN
    MESON_TAC [COEFF_IN_CARRIER, RING_OF_NUM, RING_MUL_RNEG])

  let POLY_DERIV_SUB ← prove
   r"!(r:A ring) p q.
     ring_powerseries r p /\ ring_powerseries r q
     ==> poly_deriv r (poly_sub r p q) =
         poly_sub r (poly_deriv r p) (poly_deriv r q)"
   (REWRITE_TAC [POLY_SUB] THEN
    ASM_SIMP_TAC [POLY_DERIV_ADD, POLY_DERIV_NEG, RING_POWERSERIES_NEG])

  let POLY_DERIV_CMUL ← prove
   r"!(r:A ring) c p.
     c IN ring_carrier r /\ ring_powerseries r p
     ==> poly_deriv r (poly_mul r (poly_const r c) p) =
         poly_mul r (poly_const r c) (poly_deriv r p)"
   (REWRITE_TAC [← GSYM FUN_EQ_COEFF] THEN
    ASM_SIMP_TAC [COEFF_POLY_DERIV, COEFF_POLY_LMUL,
                  RING_POWERSERIES_POLY_DERIV] THEN
    ASM_SIMP_TAC [RING_MUL_AC, RING_OF_NUM, RING_MUL, COEFF_IN_CARRIER])

  let POLY_DERIV_HOMOMORPHIC_IMAGE ← prove
   r"!(k:A ring) (l:B ring) (h:A->B) (p:(1->num)->A).
    ring_homomorphism(k,l) h /\ ring_powerseries k p
    ==> poly_deriv l (h o p) = h o poly_deriv k p"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM FUN_EQ_COEFF] THEN
    GEN_TAC THEN ASM_SIMP_TAC [COEFF_POLY_DERIV, COEFF_COMPOSE] THEN
    ASM_MESON_TAC [RING_HOMOMORPHISM_RING_OF_NUM, RING_HOMOMORPHISM_MUL,
                   RING_OF_NUM, COEFF_IN_CARRIER])

  let POLY_DERIV_MUL ← prove
   r"!(r:A ring) p q.
        ring_powerseries r p /\ ring_powerseries r q
        ==> poly_deriv r (poly_mul r p q) =
            poly_add r (poly_mul r (poly_deriv r p) q)
                       (poly_mul r p (poly_deriv r q))"
   (← do
    -- right to left: the RING_RULE, the second ARITH_RULE, then the first
    let r3 ← RING_RULE
       (← q r"t0' = t0 /\ t1' = t1 /\ ring_add r s2 s3 = s1
        ==> ring_add r t0 (ring_add r s1 t1) =
            ring_add r (ring_add r s2 t1') (ring_add r t0' s3)")
    let a2 ← ARITH_RULE (← q r"0 < n + 1 /\ 0 + 1 <= n + 1")
    let a1 ← ARITH_RULE (← q "n - i = (n + 1) - (i + 1)")
    pure (REWRITE_TAC [RING_POWERSERIES_COEFF] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM FUN_EQ_COEFF] THEN X_GEN_TAC (← q "n:num") THEN
    REWRITE_TAC [COEFF_POLY_DERIV, COEFF_POLY_ADD, COEFF_POLY_MUL] THEN
    ASM_SIMP_TAC [← GSYM RING_SUM_LMUL, FINITE_NUMSEG, RING_MUL, RING_OF_NUM] THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o ONCE_DEPTH_CONV) [a1] THEN
    REWRITE_TAC [← GSYM (← SPEC (← q "1") RING_SUM_OFFSET)] THEN
    SIMP_TAC [RING_SUM_CLAUSES_LEFT, LE_0] THEN
    SIMP_TAC [RING_SUM_CLAUSES_RIGHT, a2] THEN
    ASM_SIMP_TAC [RING_MUL, RING_OF_NUM, RING_SUM, SUB_0, RING_ADD] THEN
    REWRITE_TAC [ADD_SUB, ADD_CLAUSES] THEN MATCH_MP_TAC
     (← REWRITE_RULE [IMP_IMP] r3) THEN
    ASM_SIMP_TAC [RING_MUL, RING_OF_NUM, RING_SUM, SUB_0, RING_ADD] THEN
    REPEAT (CONJ_TAC THENL [RING_TAC, ALL_TAC]) THEN
    ASM_SIMP_TAC [← GSYM RING_SUM_ADD, FINITE_NUMSEG, RING_MUL, RING_OF_NUM] THEN
    MATCH_MP_TAC RING_SUM_EQ THEN REWRITE_TAC [IN_NUMSEG] THEN
    X_GEN_TAC (← q "i:num") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q "(n + 1) - i = n - i + 1") SUBST1_TAC THENL
     [ASM_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q "n + 1 = i + (n - i + 1)") SUBST1_TAC THENL
     [ASM_ARITH_TAC, REWRITE_TAC [RING_OF_NUM_ADD] THEN RING_TAC]))

  let POLY_DERIV_SUM ← prove
   r"!(r:A ring) (f:B->(1->num)->A) s.
        FINITE s /\ (!x. x IN s ==> ring_powerseries r (f x))
        ==> poly_deriv r (ring_sum (powser_ring r (:1)) s f) =
            ring_sum (powser_ring r (:1)) s (\x. poly_deriv r (f x))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM FUN_EQ_COEFF] THEN
    X_GEN_TAC (← q "d:num") THEN REWRITE_TAC [COEFF_POLY_DERIV] THEN
    ASM_SIMP_TAC [COEFF_POWSER_SUM, RING_POWERSERIES_POLY_DERIV] THEN
    REWRITE_TAC [COEFF_POLY_DERIV] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_SUM_LMUL THEN
    ASM_SIMP_TAC [RING_OF_NUM, COEFF_IN_CARRIER])

  let POLY_DERIV_PRODUCT ← prove
   r"!(r:A ring) (f:K->(1->num)->A) s.
        FINITE s /\ (!x. x IN s ==> ring_powerseries r (f x))
        ==> poly_deriv r (ring_product (powser_ring r (:1)) s f) =
            ring_sum (powser_ring r (:1)) s
               (\x. poly_mul r (poly_deriv r (f x))
                    (ring_product (powser_ring r (:1))
                                  (s DELETE x) f))"
   (← do
    -- right to left: the second SET_RULE, then the first
    let s2 ← SET_RULE
     (← q r"~(i IN k) /\ j IN k ==> (i INSERT k) DELETE j = i INSERT (k DELETE j)")
    let s1 ← SET_RULE (← q r"~(i IN k) ==> (i INSERT k) DELETE i = k")
    pure (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [NOT_IN_EMPTY, RING_PRODUCT_CLAUSES, FORALL_IN_INSERT,
              RING_SUM_CLAUSES, POWSER_CLAUSES, RING_POWERSERIES,
              RING_MUL, RING_PRODUCT, POWSER_DERIV_IN_CARRIER] THEN
    REWRITE_TAC [← GSYM POWSER_CLAUSES, IN_ELIM_THM, POLY_DERIV_1] THEN
    MAP_EVERY X_GEN_TAC [← q "i:K", ← q "k:K->bool"] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [POLY_DERIV_MUL, RING_POWERSERIES, RING_PRODUCT] THEN
    ASM_SIMP_TAC [s1] THEN
    AP_TERM_TAC THEN ASM_SIMP_TAC [s2] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [RING_POWERSERIES]) THEN
    REWRITE_TAC [POWSER_CLAUSES] THEN
    wPart lhand (fun t => do rand (← rand t)) RING_SUM_LMUL THEN
    ASM_SIMP_TAC [RING_PRODUCT, RING_MUL, POWSER_DERIV_IN_CARRIER] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC RING_SUM_EQ THEN
    REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, FINITE_DELETE, IN_DELETE] THEN
    ASM_SIMP_TAC [RING_PRODUCT, RING_MUL, POWSER_DERIV_IN_CARRIER,
                  RING_MUL_AC]))

  let POLY_DERIV_POW ← prove
   r"!(r:A ring) (p:(1->num)->A) n.
        ring_powerseries r p
        ==> poly_deriv r (poly_pow r p n) =
            poly_mul r (poly_const r (ring_of_num r n))
                       (poly_mul r (poly_deriv r p) (poly_pow r p (n - 1)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"(\i. p):num->(1->num)->A", ← q "1..n"]
          POLY_DERIV_PRODUCT) THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [RING_POWERSERIES]) THEN
    ASM_SIMP_TAC [RING_PRODUCT_CONST, FINITE_NUMSEG, CARD_NUMSEG_1,
                  FINITE_DELETE, CARD_DELETE] THEN
    ASM_SIMP_TAC [POWSER_CLAUSES, RING_MUL, POWSER_DERIV_IN_CARRIER,
                  RING_POW, RING_SUM_CONST, FINITE_NUMSEG, CARD_NUMSEG_1] THEN
    REWRITE_TAC [RING_OF_NUM_POWSER_RING])

  let POLY_DERIV_VAR_POW ← prove
   r"!(r:A ring) n.
    poly_deriv r (poly_pow r (poly_var r one) n) =
    ring_mul (poly_ring r (:1))
      (poly_const r (ring_of_num r n))
      (poly_pow r (poly_var r one) (n - 1))"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "poly_var (r:A ring) (one:1)", ← q "n:num"]
      POLY_DERIV_POW) THEN
    REWRITE_TAC [RING_POWERSERIES_VAR, POLY_DERIV_VAR] THEN
    DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [POLY_RING_CLAUSES] THEN
    REWRITE_TAC [← GSYM poly_1] THEN
    SIMP_TAC [POLY_MUL_LID, RING_POWERSERIES_POW, RING_POWERSERIES_VAR])

  -- @@RETURN BEGIN
  return { poly_deriv, POLY_DERIV_SUBRING_GENERATED, COEFF_POLY_DERIV,
           RING_POWERSERIES_POLY_DERIV, POWSER_DERIV_IN_CARRIER,
           RING_POLYNOMIAL_POLY_DERIV, POLY_DERIV_IN_CARRIER, POLY_DEG_DERIV_LE,
           POLY_DEG_DERIV, POLY_DERIV_NONZERO_CHAR0, POLY_DERIV_CONST, POLY_DERIV_0,
           POLY_DERIV_1, POLY_DERIV_VAR, POLY_DERIV_ADD, POLY_DERIV_NEG, POLY_DERIV_SUB,
           POLY_DERIV_CMUL, POLY_DERIV_HOMOMORPHIC_IMAGE, POLY_DERIV_MUL, POLY_DERIV_SUM,
           POLY_DERIV_PRODUCT, POLY_DERIV_POW, POLY_DERIV_VAR_POW }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Separable polynomials and relation to squarefree-ness.                    -/
/- (ringtheory.ml 26720-26949)                                               -/
/- ------------------------------------------------------------------------- -/

structure Separable where
  -- @@FIELDS
  POLY_NONCONSTANT_IRREDUCIBLE_IMP_SEPARABLE : thm
  POLY_IRREDUCIBLE_IMP_SEPARABLE : thm
  POLY_SQUARE_DIVIDES_DERIV : thm
  REPEATED_ROOT_POLY_DERIV_ZERO : thm
  POLY_SEPARABLE_IMP_SQUAREFREE : thm
  POLY_SQUARE_DIVIDES_DERIV_EQ : thm
  POLY_SQUAREFREE_IMP_SEPARABLE : thm
  POLY_SEPARABLE_EQ_SQUAREFREE : thm
  POLY_ROOT_COUNT_IMP_SQUAREFREE : thm
  deriving Inhabited

@[nospecialize]
def setupSeparable [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BDomains : Domains) (BRingRule : RingRule) (BPrimes : Primes) (BSquarefree : Squarefree) (BUFDs : UFDs) (BACCP : ACCP) (BGcdDomain : GcdDomain) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BDegree : Degree) (BEvaluation : Evaluation) (BZerodivisors : Zerodivisors) (BXMinusA : XMinusA) (BDivision : Division) (BDerivative : Derivative) :
    ExceptT String IO Separable := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, .. } := D
  let { ARITH, ARITH_EQ, CARD_SUBSET, CARD_UNION_LE, .. } := D.core1
  let { FINITE_UNION, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, .. } := D.core4
  let { IN_ELIM_THM, IN_UNION, LEFT_IMP_EXISTS_THM, LET_TRANS, LE_1, LE_ADD2, LE_TRANS, .. } := D.core5
  let { NOT_FORALL_THM, NOT_IMP, .. } := D.core6
  let { SUBSET, .. } := D.core7
  let { RING_MUL, RING_MUL_LZERO, RING_MUL_RZERO, RING_SUB, RING_SUB_REFL, .. } := BBasics
  let { RING_OF_NUM, RING_POW, RING_POW_2, RING_POW_ZERO, .. } := BNumbers
  let { RING_COPRIME_SYM, RING_DIVIDES_LMUL2, RING_DIVIDES_REFL, RING_DIVIDES_RMUL,
        RING_DIVIDES_TRANS, RING_DIVIDES_ZERO, ring_coprime, ring_divides, .. } := BDivides
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING, INTEGRAL_DOMAIN_MUL_EQ_0,
        INTEGRAL_DOMAIN_POW_EQ_0, .. } := BDomains
  let { RING_TAC, .. } := BRingRule
  let { RING_IRREDUCIBLE_DIVIDES_OR_COPRIME, RING_IRREDUCIBLE_IN_CARRIER,
        ring_irreducible, .. } := BPrimes
  let { RING_SQUAREFREE_0, RING_SQUAREFREE_IN_CARRIER, ring_squarefree, .. } := BSquarefree
  let { PID_IMP_UFD, .. } := BUFDs
  let { NOETHERIAN_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS, .. } := BACCP
  let { RING_COPRIME_DIVPROD_RIGHT, .. } := BGcdDomain
  let { RING_POLYNOMIAL_ADD, RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_IMP_POWERSERIES,
        RING_POLYNOMIAL_MUL, RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_VAR, .. } := BPowerSeries
  let { POLY_CLAUSES, POLY_CONST_OF_NUM, POLY_POW_ALT, POLY_RING, POLY_RING_CLAUSES,
        RING_POLYNOMIAL, RING_POWERSERIES_POW, TRIVIAL_POLY_RING, .. } := BPolyRings
  let { INTEGRAL_DOMAIN_POLY_RING, POLY_DEG_DIVIDES_LE, POLY_DEG_MUL, POLY_DEG_POW, .. } := BDegree
  let { POLY_EVAL, POLY_EVAL_CONST, POLY_EVAL_MUL, POLY_EVAL_POW, POLY_EVAL_SUB,
        POLY_EVAL_VAR, .. } := BEvaluation
  let { IRREDUCIBLE_IMP_POLY_DEG_NZ, POLY_DEG_EQ_0_UNIT, .. } := BZerodivisors
  let { POLY_ROOT_BOUND, .. } := BXMinusA
  let { PID_POLY_RING, .. } := BDivision
  let { POLY_DEG_DERIV_LE, POLY_DERIV_IN_CARRIER, POLY_DERIV_MUL,
        POLY_DERIV_NONZERO_CHAR0, POLY_DERIV_POW, RING_POLYNOMIAL_POLY_DERIV, .. } := BDerivative
  -- @@SCOPE END

  let POLY_NONCONSTANT_IRREDUCIBLE_IMP_SEPARABLE ← prove
   r"!(r:A ring) p.
    integral_domain r /\ ring_char r = 0 /\
    ring_irreducible(poly_ring r (:1)) p /\ ~(poly_deg r p = 0)
    ==> ring_coprime(poly_ring r (:1)) (p, poly_deriv r p)"
   (← do
    -- right to left: the ARITH_RULE, then the TAUT
    let a2 ← ARITH_RULE (← q r"d <= d' /\ ~(d = 0) ==> d' <= d - 1 ==> F")
    let t1 ← TAUT (← q r"~p ==> p \/ q ==> q")
    pure (REPEAT STRIP_TAC THEN
    wPart pure (fun t => do rand (← rand t)) RING_IRREDUCIBLE_DIVIDES_OR_COPRIME THEN
    ASM_SIMP_TAC [POLY_DERIV_IN_CARRIER, RING_IRREDUCIBLE_IN_CARRIER] THEN
    MATCH_MP_TAC t1 THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "p:(1->num)->A"] POLY_DEG_DERIV_LE) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [RING_POLYNOMIAL, ring_irreducible],
      MATCH_MP_TAC a2] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC POLY_DEG_DIVIDES_LE THEN
    EXISTS_TAC (← q "(:1)") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC POLY_DERIV_NONZERO_CHAR0 THEN ASM_SIMP_TAC [LE_1] THEN
    ASM_MESON_TAC [RING_POLYNOMIAL, ring_irreducible]))

  let POLY_IRREDUCIBLE_IMP_SEPARABLE ← prove
   r"!(k:A ring) p.
        field k /\ ring_char k = 0 /\
        ring_irreducible(poly_ring k (:1)) p
        ==> ring_coprime(poly_ring k (:1)) (p, poly_deriv k p)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC POLY_NONCONSTANT_IRREDUCIBLE_IMP_SEPARABLE THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
    ASM_MESON_TAC [IRREDUCIBLE_IMP_POLY_DEG_NZ])

  let POLY_SQUARE_DIVIDES_DERIV ← prove
   r"!(r:A ring) (p:(1->num)->A) f.
        ring_polynomial r p /\
        ring_divides (poly_ring r (:1)) (poly_pow r p 2) f
        ==> ring_divides (poly_ring r (:1)) p (poly_deriv r f)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [ring_divides, LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
    REWRITE_TAC [← GSYM RING_POLYNOMIAL, ← CONJUNCT2 POLY_RING_CLAUSES] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "q:(1->num)->A") THEN DISCH_TAC THEN
    DISCH_THEN SUBST1_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_POLY_DERIV, RING_POLYNOMIAL_MUL] THEN
    ASM_SIMP_TAC [POLY_DERIV_MUL, RING_POLYNOMIAL_IMP_POWERSERIES,
                  POLY_DERIV_POW, RING_POWERSERIES_POW, ARITH] THEN
    EXISTS_TAC
     (← q r"poly_add r (poly_mul r (poly_const r (ring_of_num r 2:A))
                             (poly_mul r (poly_deriv r p) q))
                 (poly_mul r p (poly_deriv r q)):(1->num)->A") THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [RING_POLYNOMIAL_CONST, RING_OF_NUM, RING_POLYNOMIAL_MUL,
                     RING_POLYNOMIAL_ADD, RING_POLYNOMIAL_POLY_DERIV],
      REWRITE_TAC [← CONJUNCT2 POLY_CLAUSES, ← GSYM RING_POLYNOMIAL] THEN
      REWRITE_TAC [POLY_CONST_OF_NUM] THEN
      ABBREV_TAC (← q "R = poly_ring (r:A ring) (:1)") THEN
      POP_ASSUM (fun th => tactic_of do pure (RING_TAC THEN SUBST1_TAC (← SYM th))) THEN
      ASM_SIMP_TAC [← GSYM RING_POLYNOMIAL, RING_POLYNOMIAL_POLY_DERIV]])

  let REPEATED_ROOT_POLY_DERIV_ZERO ← prove
   r"!(r:A ring) p a.
    a IN ring_carrier r /\
    ring_divides (poly_ring r (:1))
         (poly_pow r (poly_sub r (poly_var r one) (poly_const r a)) 2) p
    ==> poly_eval r (poly_deriv r p) a = ring_0 r"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          POLY_SQUARE_DIVIDES_DERIV)) THEN
    ASM_SIMP_TAC [ring_divides, RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_VAR,
                  RING_POLYNOMIAL_CONST, ← GSYM RING_POLYNOMIAL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "d:(1->num)->A")
       (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC) o CONJUNCT2) THEN
    ASM_SIMP_TAC [← CONJUNCT2 POLY_RING, POLY_EVAL_MUL, POLY_EVAL_SUB,
                  RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_VAR, POLY_EVAL_VAR,
                  RING_POLYNOMIAL_CONST, POLY_EVAL_CONST] THEN
    ASM_SIMP_TAC [RING_SUB_REFL, RING_MUL_LZERO, POLY_EVAL])

  let POLY_SEPARABLE_IMP_SQUAREFREE ← prove
   r"!(k:A ring) p.
        ring_coprime(poly_ring k (:1)) (p, poly_deriv k p)
        ==> ring_squarefree (poly_ring k (:1)) p"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_squarefree] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [ring_coprime], ALL_TAC] THEN
    X_GEN_TAC (← q "q:(1->num)->A") THEN STRIP_TAC THEN
    SUBGOAL_THEN
      (← q "ring_divides (poly_ring (k:A ring) (:1)) (q:(1->num)->A) (p:(1->num)->A)")
      ASSUME_TAC THENL
     [MATCH_MP_TAC RING_DIVIDES_TRANS THEN
      EXISTS_TAC (← q "ring_pow (poly_ring (k:A ring) (:1)) (q:(1->num)->A) 2") THEN
      ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [RING_POW_2] THEN
      ASM_SIMP_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_REFL],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"ring_divides (poly_ring (k:A ring) (:1))
        (q:(1->num)->A) (poly_deriv k p)") ASSUME_TAC THENL
     [MATCH_MP_TAC POLY_SQUARE_DIVIDES_DERIV THEN
      ASM_REWRITE_TAC [RING_POLYNOMIAL, POLY_POW_ALT],
      ASM_MESON_TAC [ring_coprime]])

  let POLY_SQUARE_DIVIDES_DERIV_EQ ← prove
   r"!(k:A ring) (p:(1->num)->A) f.
        field k /\ ring_char k = 0 /\
        ring_irreducible (poly_ring k (:1)) p
        ==> (ring_divides (poly_ring k (:1)) p f /\
             ring_divides (poly_ring k (:1)) p (poly_deriv k f) <=>
             ring_divides (poly_ring k (:1)) (poly_pow k p 2) f)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC),
      FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP RING_IRREDUCIBLE_IN_CARRIER) THEN
      ASM_SIMP_TAC [POLY_SQUARE_DIVIDES_DERIV, RING_POLYNOMIAL] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] RING_DIVIDES_TRANS) THEN
      ASM_SIMP_TAC [POLY_POW_ALT, RING_POW_2, RING_DIVIDES_RMUL,
                    RING_DIVIDES_REFL]] THEN
    GEN_REWRITE_TAC LAND_CONV [ring_divides] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "s:(1->num)->A") STRIP_ASSUME_TAC o GSYM) THEN
    ASM_SIMP_TAC [RING_POW_2, POLY_POW_ALT] THEN
    EXPAND_TAC "f" THEN MATCH_MP_TAC RING_DIVIDES_LMUL2 THEN
    ASM_REWRITE_TAC [] THEN MP_TAC (← ISPECL [← q "k:A ring", ← q "p:(1->num)->A"]
      POLY_IRREDUCIBLE_IMP_SEPARABLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC RING_COPRIME_DIVPROD_RIGHT THEN
    EXISTS_TAC (← q "poly_deriv (k:A ring) p") THEN
    ASM_SIMP_TAC [PID_POLY_RING, PID_IMP_UFD, POLY_DERIV_IN_CARRIER] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [RING_COPRIME_SYM]] THEN
    ASM_SIMP_TAC [RING_MUL, POLY_DERIV_IN_CARRIER, ring_divides] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_divides]) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MP_TAC (← ISPECL
     [← q "k:A ring", ← q "p:(1->num)->A", ← q "s:(1->num)->A"] POLY_DERIV_MUL) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [RING_POLYNOMIAL, RING_POLYNOMIAL_IMP_POWERSERIES],
      ASM_REWRITE_TAC [← CONJUNCT2 POLY_CLAUSES] THEN DISCH_THEN SUBST1_TAC] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q "d:(1->num)->A")) THEN
    EXISTS_TAC (← q "ring_sub (poly_ring (k:A ring) (:1)) d (poly_deriv k s)") THEN
    ASM_SIMP_TAC [RING_SUB, POLY_DERIV_IN_CARRIER] THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ABBREV_TAC (← q "R = poly_ring (k:A ring) (:1)") THEN
    POP_ASSUM (fun th => tactic_of do pure (RING_TAC THEN SUBST_ALL_TAC (← SYM th))) THEN
    ASM_SIMP_TAC [POLY_DERIV_IN_CARRIER])

  let POLY_SQUAREFREE_IMP_SEPARABLE ← prove
   r"!(k:A ring) p.
        field k /\ ring_char k = 0 /\
        ring_squarefree (poly_ring k (:1)) p
        ==> ring_coprime(poly_ring k (:1)) (p, poly_deriv k p)"
   (← do
    -- right to left: the second TAUT, then the first
    let t2 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    let t1 ← TAUT (← q "p <=> ~p ==> F")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_SQUAREFREE_IN_CARRIER) THEN
    ASM_SIMP_TAC [ring_coprime, POLY_DERIV_IN_CARRIER] THEN
    X_GEN_TAC (← q "d:(1->num)->A") THEN
    ASM_CASES_TAC (← q "d = ring_0(poly_ring (k:A ring) (:1))") THENL
     [ASM_REWRITE_TAC [RING_DIVIDES_ZERO] THEN
      ASM_MESON_TAC [RING_SQUAREFREE_0, TRIVIAL_POLY_RING,
                     FIELD_IMP_NONTRIVIAL_RING],
      STRIP_TAC THEN
      GEN_REWRITE_TAC id [t1] THEN DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q "poly_ring (k:A ring) (:1)", ← q "d:(1->num)->A"]
          NOETHERIAN_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS) THEN
    ASM_SIMP_TAC [PID_POLY_RING, PID_IMP_UFD, NOT_IMP] THEN
    MATCH_MP_TAC t2 THEN
    CONJ_TAC THENL [ASM_MESON_TAC [ring_divides], DISCH_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "q:(1->num)->A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_squarefree]) THEN
    ASM_REWRITE_TAC [NOT_FORALL_THM] THEN EXISTS_TAC (← q "q:(1->num)->A") THEN
    ASM_SIMP_TAC [RING_IRREDUCIBLE_IN_CARRIER, NOT_IMP] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [ring_irreducible]] THEN
    ASM_SIMP_TAC [← GSYM POLY_SQUARE_DIVIDES_DERIV_EQ, ← GSYM POLY_POW_ALT] THEN
    ASM_MESON_TAC [RING_DIVIDES_TRANS]))

  let POLY_SEPARABLE_EQ_SQUAREFREE ← prove
   r"!(k:A ring) p.
    field k /\ ring_char k = 0
    ==> (ring_coprime(poly_ring k (:1)) (p, poly_deriv k p) <=>
         ring_squarefree (poly_ring k (:1)) p)"
   (MESON_TAC [POLY_SEPARABLE_IMP_SQUAREFREE, POLY_SQUAREFREE_IMP_SEPARABLE])

  let POLY_ROOT_COUNT_IMP_SQUAREFREE ← prove
   r"!(k:A ring) p.
    field k /\
    p IN ring_carrier (poly_ring k (:1)) /\
    ~(p = ring_0 (poly_ring k (:1))) /\
    CARD {x | x IN ring_carrier k /\ poly_eval k p x = ring_0 k} = poly_deg k p
    ==> ring_squarefree (poly_ring k (:1)) p"
   (← do
    -- right to left: the second ARITH_RULE, the first, then the TAUT
    let a3 ← ARITH_RULE (← q r"d + q < 2 * d + q <=> ~(d = 0)")
    let a2 ← ARITH_RULE (← q "a:num = b ==> a < b ==> F")
    let t1 ← TAUT (← q "(~p ==> F) ==> p")
    pure (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [ring_squarefree] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) THEN
    X_GEN_TAC (← q "d:(1->num)->A") THEN
    REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM, ring_divides] THEN
    DISCH_TAC THEN REPEAT (DISCH_THEN (fun (_ : thm) => ALL_TAC)) THEN
    X_GEN_TAC (← q "q:(1->num)->A") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q "d:(1->num)->A = ring_0 (poly_ring k (:1))") THEN
    ASM_SIMP_TAC [RING_POW_ZERO, ARITH_EQ, RING_MUL_LZERO] THEN
    ASM_CASES_TAC (← q "q:(1->num)->A = ring_0 (poly_ring k (:1))") THEN
    ASM_SIMP_TAC [RING_POW, RING_MUL_RZERO] THEN
    DISCH_THEN (ASSUME_TAC o SYM) THEN
    MATCH_MP_TAC t1 THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP a2) THEN
    MATCH_MP_TAC LET_TRANS THEN
    EXISTS_TAC
     (← q r"CARD{x | x IN ring_carrier k /\ poly_eval k (d:(1->num)->A) x = ring_0 k} +
      CARD{x | x IN ring_carrier k /\ poly_eval k (q:(1->num)->A) x = ring_0 k}")
    THEN CONJ_TAC THENL
     [wPart rand (fun t => do rand (← rand t)) CARD_UNION_LE THEN
      ASM_SIMP_TAC [POLY_ROOT_BOUND] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LE_TRANS) THEN
      MATCH_MP_TAC CARD_SUBSET THEN
      ASM_SIMP_TAC [POLY_ROOT_BOUND, FINITE_UNION] THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION] THEN
      X_GEN_TAC (← q "x:A") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_SIMP_TAC [← REWRITE_RULE [RING_POLYNOMIAL, ← CONJUNCT2 POLY_CLAUSES]
                     (← CONJ POLY_EVAL_MUL POLY_EVAL_POW), RING_POW] THEN
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_MUL_EQ_0, RING_POW, POLY_EVAL,
                    INTEGRAL_DOMAIN_POW_EQ_0, ARITH_EQ],
      ALL_TAC] THEN
    TRANS_TAC LET_TRANS
     (← q "poly_deg k (d:(1->num)->A) + poly_deg k (q:(1->num)->A)") THEN
    CONJ_TAC THENL [ASM_SIMP_TAC [POLY_ROOT_BOUND, LE_ADD2], ALL_TAC] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [← CONJUNCT2 POLY_RING] THEN
    wPart rand (fun t => do lhand (← rand t)) POLY_DEG_MUL THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL, ← CONJUNCT2 POLY_CLAUSES] THEN
    ASM_SIMP_TAC [RING_POW, INTEGRAL_DOMAIN_POW_EQ_0, ARITH_EQ,
                  INTEGRAL_DOMAIN_POLY_RING] THEN
    DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [← CONJUNCT2 POLY_RING_CLAUSES] THEN
    wPart (fun t => do lhand (← rand t)) (fun t => do lhand (← rand t)) POLY_DEG_POW THEN
    ASM_REWRITE_TAC [RING_POLYNOMIAL] THEN DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [a3] THEN
    ASM_MESON_TAC [POLY_DEG_EQ_0_UNIT, RING_POLYNOMIAL]))

  -- @@RETURN BEGIN
  return { POLY_NONCONSTANT_IRREDUCIBLE_IMP_SEPARABLE, POLY_IRREDUCIBLE_IMP_SEPARABLE,
           POLY_SQUARE_DIVIDES_DERIV, REPEATED_ROOT_POLY_DERIV_ZERO,
           POLY_SEPARABLE_IMP_SQUAREFREE, POLY_SQUARE_DIVIDES_DERIV_EQ,
           POLY_SQUAREFREE_IMP_SEPARABLE, POLY_SEPARABLE_EQ_SQUAREFREE,
           POLY_ROOT_COUNT_IMP_SQUAREFREE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Gauss's lemma and preservation of the UFD property in polynomial rings.   -/
/- (ringtheory.ml 26949-28584, first part)                                    -/
/- ------------------------------------------------------------------------- -/

structure GaussA where
  -- @@FIELDS
  POLY_PRIMITIVE_CONST_CANCEL : thm
  MAKE_PRIMITIVE_IN_IDEAL : thm
  POLY_MAKE_PRIMITIVE : thm
  RING_PRIME_POLY_RING_MONO : thm
  deriving Inhabited

@[nospecialize]
def setupGaussA [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDivides : Divides) (BDomains : Domains) (BHoms : Homs) (BPrimes : Primes) (BSpecialIdeals : SpecialIdeals) (BUFDs : UFDs) (BACCP : ACCP) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BNatIso : NatIso) (BOneCoeff : OneCoeff) (BDegree : Degree) (BZerodivisors : Zerodivisors) (BDivision : Division) :
    ExceptT String IO GaussA := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { BETA_THM, .. } := D.core1
  let { DE_MORGAN_THM, .. } := D.core2
  let { FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { MEMBER_NOT_EMPTY, NOT_CLAUSES, NOT_FORALL_THM, NOT_IMP, .. } := D.core6
  let { SUBSET_UNION, .. } := D.core7
  let { RING_1, RING_MUL, RING_MUL_ASSOC, RING_MUL_LID, RING_MUL_RZERO, RING_MUL_SYM,
        TRIVIAL_RING_10, .. } := BBasics
  let { RING_ASSOCIATES_LMUL, RING_DIVIDES_LMUL, RING_DIVIDES_REFL, RING_DIVIDES_TRANS,
        ring_associates, ring_divides, .. } := BDivides
  let { INTEGRAL_DOMAIN_DIVIDES_MUL_SELF, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING,
        INTEGRAL_DOMAIN_MUL_EQ_0, INTEGRAL_DOMAIN_MUL_LCANCEL, .. } := BDomains
  let { ring_isomorphism, ring_isomorphisms, .. } := BHoms
  let { RING_PRIME_ISOMORPHIC_IMAGE_EQ, ring_prime, .. } := BPrimes
  let { RING_MUL_IN_PRIME_IDEAL, .. } := BSpecialIdeals
  let { UFD_IMP_INTEGRAL_DOMAIN, UFD_PRIME_FACTOR_INDUCT, .. } := BUFDs
  let { RING_PROPER_DIVISOR_INDUCT, .. } := BACCP
  let { MONOMIAL_MONO, MONOMIAL_RESTRICT_REFL, MONOMIAL_VARS_EQ_EMPTY,
        MONOMIAL_VARS_RESTRICT, monomial, .. } := BMonomials
  let { POLY_0, POLY_CONST_0, POLY_CONST_1, POLY_MUL_CONST, RING_POLYNOMIAL_CONST,
        poly_const, .. } := BPowerSeries
  let { POLY_CONST, POLY_CONST_EQ, POLY_CONST_MUL, POLY_MONOMIALS, POLY_MONOMIALS_ALT,
        POLY_MONOMIAL_IN_CARRIER, POLY_RING, POLY_RING_CLAUSES, RING_POLYNOMIAL, .. } := BPolyRings
  let { RING_ISOMORPHISMS_POLY_POLY_RING, .. } := BNatIso
  let { coeff, .. } := BOneCoeff
  let { INTEGRAL_DOMAIN_POLY_RING, POLY_DEG_CONST, POLY_DEG_MUL, .. } := BDegree
  let { RING_PRIME_POLY_CONST, RING_UNIT_POLY_CONST, .. } := BZerodivisors
  let { POLY_TOP_NONZERO, .. } := BDivision
  -- @@SCOPE END

  let POLY_PRIMITIVE_CONST_CANCEL ← prove
   r"!(r:A ring) (s:V->bool) f a c.
     UFD r /\ f IN ring_carrier(poly_ring r s) /\
     a IN ring_carrier(poly_ring r s) /\ c IN ring_carrier r /\
     (!p. ring_prime r p
          ==> ~ring_divides (poly_ring r s)
                ((poly_const r p):(V->num)->A) f) /\
     ring_divides (poly_ring r s) f
       (ring_mul (poly_ring r s) (poly_const r c) a)
     ==> c = ring_0 r \/ ring_divides (poly_ring r s) f a"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP UFD_IMP_INTEGRAL_DOMAIN) THEN
    SUBGOAL_THEN
     (← q r"!c:A. c IN ring_carrier r
      ==> (c = ring_0 r \/
           (ring_divides (poly_ring r (s:V->bool)) f
             (ring_mul (poly_ring r s) (poly_const r c) a)
            ==> ring_divides (poly_ring r s) f a))") MP_TAC THENL
    [ALL_TAC,
     DISCH_THEN (MP_TAC o SPEC (← q "c:A")) THEN ASM_MESON_TAC []] THEN
    MATCH_MP_TAC UFD_PRIME_FACTOR_INDUCT THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
    [X_GEN_TAC (← q "u:A") THEN DISCH_TAC THEN DISJ2_TAC THEN DISCH_TAC THEN
     MATCH_MP_TAC RING_DIVIDES_TRANS THEN
     EXISTS_TAC (← q r"ring_mul (poly_ring r (s:V->bool))
       (poly_const r (u:A)) (a:(V->num)->A)") THEN
     ASM_MESON_TAC [RING_ASSOCIATES_LMUL, RING_UNIT_POLY_CONST, ring_associates],
     MAP_EVERY X_GEN_TAC [← q "pp:A", ← q "dd:A"] THEN STRIP_TAC THENL
     [DISJ1_TAC THEN ASM_MESON_TAC [ring_prime, RING_MUL_RZERO], ALL_TAC] THEN
     DISJ2_TAC THEN
     FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [ring_prime]) THEN
     DISCH_TAC THEN
     SUBGOAL_THEN
      (← q r"ring_mul (poly_ring r (s:V->bool))
        (poly_const r (ring_mul r (pp:A) dd)) a =
       ring_mul (poly_ring r s) (poly_const r pp)
        (ring_mul (poly_ring r s) (poly_const r dd) (a:(V->num)->A))")
     SUBST_ALL_TAC THENL
     [REWRITE_TAC [POLY_RING] THEN ASM_SIMP_TAC [POLY_CONST_MUL] THEN
      REWRITE_TAC [← GSYM POLY_RING] THEN
      ASM_MESON_TAC [RING_MUL_ASSOC, POLY_CONST],
      ALL_TAC] THEN
     FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"h:(V->num)->A") STRIP_ASSUME_TAC o
      CONJUNCT2 o CONJUNCT2 o GEN_REWRITE_RULE id [ring_divides]) THEN
     SUBGOAL_THEN (← q r"ring_prime (poly_ring r (s:V->bool)) (poly_const r (pp:A))")
      (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [ring_prime]) THENL
     [ASM_SIMP_TAC [RING_PRIME_POLY_CONST], ALL_TAC] THEN
     FIRST_X_ASSUM (MP_TAC o SPECL [← q r"f:(V->num)->A", ← q r"h:(V->num)->A"]) THEN
     ANTS_TAC THENL
     [ASM_MESON_TAC [ring_divides, RING_MUL, POLY_CONST], ALL_TAC] THEN
     DISCH_THEN DISJ_CASES_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
     FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"h':(V->num)->A") STRIP_ASSUME_TAC o
      CONJUNCT2 o CONJUNCT2 o GEN_REWRITE_RULE id [ring_divides]) THEN
     SUBGOAL_THEN
      (← q r"ring_mul (poly_ring r (s:V->bool)) (poly_const r (dd:A)) (a:(V->num)->A) =
       ring_mul (poly_ring r s) (f:(V->num)->A) (h':(V->num)->A)")
     ASSUME_TAC THENL
     [MATCH_MP_TAC (← ISPECL [← q r"poly_ring (r:A ring) (s:V->bool)",
        ← q r"(poly_const r (pp:A)):(V->num)->A"] INTEGRAL_DOMAIN_MUL_LCANCEL) THEN
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_POLY_RING, POLY_CONST, RING_MUL] THEN
      ASM_MESON_TAC [RING_MUL_ASSOC, RING_MUL_SYM, RING_MUL, POLY_CONST],
      ALL_TAC] THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN
     ASM_MESON_TAC [ring_divides, RING_MUL, POLY_CONST]])

  let MAKE_PRIMITIVE_IN_IDEAL ← prove
   r"!(r:A ring) j (f:(1->num)->A).
     UFD r /\ prime_ideal (poly_ring r (:1)) j /\
     (!c:A. c IN ring_carrier r /\
       (poly_const r c:(1->num)->A) IN j ==> c = ring_0 r) /\
     f IN ring_carrier(poly_ring r (:1)) /\ f IN j /\
     ~(f = ring_0(poly_ring r (:1)))
     ==> ?g:(1->num)->A.
           g IN ring_carrier(poly_ring r (:1)) /\ g IN j /\
           ~(g = ring_0(poly_ring r (:1))) /\
           (!p. ring_prime r p
                ==> ~ring_divides (poly_ring r (:1)) (poly_const r p) g) /\
           poly_deg r g = poly_deg r f"
   (← do
    let lemma ← prove
     r"!(r:A ring) j (ff:(1->num)->A) pp.
       integral_domain r /\ prime_ideal (poly_ring r (:1)) j /\
       (!c:A. c IN ring_carrier r /\
         (poly_const r c:(1->num)->A) IN j ==> c = ring_0 r) /\
       ff IN ring_carrier(poly_ring r (:1)) /\ ff IN j /\
       ~(ff = ring_0(poly_ring r (:1))) /\ ring_prime r pp /\
       ring_divides (poly_ring r (:1)) (poly_const r pp:(1->num)->A) ff
       ==> ?ff':(1->num)->A.
         ff' IN ring_carrier(poly_ring r (:1)) /\ ff' IN j /\
         ~(ff' = ring_0(poly_ring r (:1))) /\
         poly_deg r ff' = poly_deg r ff /\
         ff = ring_mul (poly_ring r (:1)) (poly_const r pp) ff'"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [ring_divides]) THEN
      EXISTS_TAC (← q "x:(1->num)->A") THEN
      SUBGOAL_THEN
        (← q r"(pp:A) IN ring_carrier r /\ ~(pp = ring_0 r) /\
         (x:(1->num)->A) IN j /\ ~(x = ring_0(poly_ring (r:A ring) (:1)))")
        STRIP_ASSUME_TAC THENL
      [ASM_MESON_TAC [ring_prime, RING_MUL_IN_PRIME_IDEAL,
         POLY_CONST, RING_MUL_RZERO],
       ALL_TAC] THEN
      REPEAT CONJ_TAC THEN TRY (ASM_REWRITE_TAC [] THEN NO_TAC) THEN
      SUBGOAL_THEN
        (← q r"poly_deg (r:A ring) (ff:(1->num)->A) =
         poly_deg r (poly_const r (pp:A):(1->num)->A) +
         poly_deg r (x:(1->num)->A)")
        (fun th => REWRITE_TAC [th, POLY_DEG_CONST] THEN ARITH_TAC) THEN
      ASM_REWRITE_TAC [POLY_RING_CLAUSES] THEN
      MATCH_MP_TAC POLY_DEG_MUL THEN
      ASM_REWRITE_TAC [RING_POLYNOMIAL_CONST, RING_POLYNOMIAL] THEN
      ASM_MESON_TAC [POLY_CONST_0, POLY_CONST_EQ, POLY_RING])
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP UFD_IMP_INTEGRAL_DOMAIN) THEN
    SUBGOAL_THEN
      (← q r"!(a:A). a IN ring_carrier r ==>
         !(ff:(1->num)->A).
           ff IN ring_carrier(poly_ring r (:1)) /\ ff IN j /\
           ~(ff = ring_0(poly_ring r (:1))) /\ ff(\v:1. poly_deg r ff) = a
           ==> ?(g:(1->num)->A).
             g IN ring_carrier(poly_ring r (:1)) /\ g IN j /\
             ~(g = ring_0(poly_ring r (:1))) /\
             (!p:A. ring_prime r p ==>
               ~ring_divides (poly_ring r (:1))
                 (poly_const r p :(1->num)->A) g) /\
             poly_deg r g = poly_deg r ff") MP_TAC THENL
    [MATCH_MP_TAC RING_PROPER_DIVISOR_INDUCT THEN
     CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
     X_GEN_TAC (← q "a:A") THEN
     DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "IH")) THEN
     X_GEN_TAC (← q "ff:(1->num)->A") THEN STRIP_TAC THEN
     ASM_CASES_TAC (← q r"!p:A. ring_prime r p ==>
       ~ring_divides (poly_ring r (:1)) (poly_const r p :(1->num)->A) ff") THENL
     [EXISTS_TAC (← q "ff:(1->num)->A") THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM]) THEN
     REWRITE_TAC [NOT_IMP, NOT_CLAUSES] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q "pp:A") STRIP_ASSUME_TAC) THEN
     MP_TAC (← ISPECL [← q "r:A ring", ← q "j:((1->num)->A)->bool",
       ← q "ff:(1->num)->A", ← q "pp:A"] lemma) THEN
     ASM_REWRITE_TAC [] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q "ff':(1->num)->A") STRIP_ASSUME_TAC) THEN
     SUBGOAL_THEN (← q "(pp:A) IN ring_carrier r /\\ ~ring_unit (r:A ring) (pp:A)")
       STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [ring_prime], ALL_TAC] THEN
     SUBGOAL_THEN (← q r"!m:(1->num). (ff:(1->num)->A) m =
       ring_mul (r:A ring) pp ((ff':(1->num)->A) m)") ASSUME_TAC THENL
     [GEN_TAC THEN ASM_SIMP_TAC [POLY_RING_CLAUSES, POLY_MUL_CONST,
        RING_POLYNOMIAL, BETA_THM],
      ALL_TAC] THEN
     SUBGOAL_THEN
       (← q r"(ff':(1->num)->A) (\v:1. poly_deg r ff') IN ring_carrier (r:A ring) /\
        ~(ff' (\v:1. poly_deg r ff') = ring_0 (r:A ring))")
       STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER,
                     ← REWRITE_RULE [coeff] POLY_TOP_NONZERO],
      ALL_TAC] THEN
     USE_THEN "IH" (MP_TAC o SPEC
       (← q r"(ff':(1->num)->A) (\v:1. poly_deg r ff')")) THEN
     ANTS_TAC THENL
     [SUBGOAL_THEN (← q r"(a:A) = ring_mul (r:A ring) pp
        ((ff':(1->num)->A) (\v:1. poly_deg r ff'))") SUBST1_TAC THENL
      [ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL
      [MATCH_MP_TAC RING_DIVIDES_LMUL THEN ASM_MESON_TAC [RING_DIVIDES_REFL],
       ASM_SIMP_TAC [← CONJUNCT1 INTEGRAL_DOMAIN_DIVIDES_MUL_SELF,
         DE_MORGAN_THM]],
      ALL_TAC] THEN
     DISCH_THEN (MP_TAC o SPEC (← q "ff':(1->num)->A")) THEN
     ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
     DISCH_THEN (MP_TAC o SPEC (← q r"(f:(1->num)->A) (\v:1. poly_deg r f)")) THEN
     ANTS_TAC THENL
     [ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER], ALL_TAC] THEN
     DISCH_THEN (MP_TAC o SPEC (← q "f:(1->num)->A")) THEN ASM_MESON_TAC []]))

  let POLY_MAKE_PRIMITIVE ← prove
   r"!(r:A ring) (f:(1->num)->A).
     UFD r /\
     f IN ring_carrier(poly_ring r (:1)) /\
     ~(f = ring_0(poly_ring r (:1)))
     ==> ?(c:A) (g:(1->num)->A).
           c IN ring_carrier r /\ ~(c = ring_0 r) /\
           g IN ring_carrier(poly_ring r (:1)) /\
           ~(g = ring_0(poly_ring r (:1))) /\
           f = ring_mul (poly_ring r (:1)) (poly_const r c) g /\
           poly_deg r g = poly_deg r f /\
           (!p. ring_prime r p
                ==> ~ring_divides (poly_ring r (:1))
                      (poly_const r p) g)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP UFD_IMP_INTEGRAL_DOMAIN) THEN
    SUBGOAL_THEN
      (← q r"!(a:A). a IN ring_carrier (r:A ring) ==>
       !(ff:(1->num)->A).
         ff IN ring_carrier(poly_ring r (:1)) /\
         ~(ff = ring_0(poly_ring r (:1))) /\
         ff(\v:1. poly_deg r ff) = a
         ==> ?(c:A) (g:(1->num)->A).
               c IN ring_carrier r /\ ~(c = ring_0 r) /\
               g IN ring_carrier(poly_ring r (:1)) /\
               ~(g = ring_0(poly_ring r (:1))) /\
               ff = ring_mul (poly_ring r (:1))
                 (poly_const r c) g /\
               poly_deg r g = poly_deg r ff /\
               (!p:A. ring_prime r p ==>
                 ~ring_divides (poly_ring r (:1))
                   (poly_const r p :(1->num)->A) g)")
      MP_TAC THENL
    [MATCH_MP_TAC RING_PROPER_DIVISOR_INDUCT THEN
     CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN X_GEN_TAC (← q "a:A") THEN
     DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "IH")) THEN
     X_GEN_TAC (← q "ff:(1->num)->A") THEN STRIP_TAC THEN
     ASM_CASES_TAC (← q r"!p:A. ring_prime r p ==>
       ~ring_divides (poly_ring r (:1))
         (poly_const r p :(1->num)->A) ff") THENL
     [MAP_EVERY EXISTS_TAC [← q "ring_1 r:A", ← q "ff:(1->num)->A"] THEN
      ASM_REWRITE_TAC [RING_1] THEN REPEAT CONJ_TAC THENL
      [ASM_MESON_TAC [INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, TRIVIAL_RING_10],
       CONV_TAC SYM_CONV THEN SUBGOAL_THEN
         (← q r"poly_const r (ring_1 (r:A ring)):(1->num)->A =
          ring_1(poly_ring r (:1))") SUBST1_TAC THENL
       [REWRITE_TAC [POLY_RING, POLY_CONST_1], ALL_TAC] THEN
       MATCH_MP_TAC RING_MUL_LID THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM]) THEN
     REWRITE_TAC [NOT_IMP, NOT_CLAUSES] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q "q:A") STRIP_ASSUME_TAC) THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_divides]) THEN
     DISCH_THEN (CONJUNCTS_THEN2 (fun (_ : thm) => ALL_TAC) (CONJUNCTS_THEN2
       (fun (_ : thm) => ALL_TAC)
       (X_CHOOSE_THEN (← q "ff':(1->num)->A") STRIP_ASSUME_TAC))) THEN
     SUBGOAL_THEN (← q r"(q:A) IN ring_carrier r /\ ~(q = ring_0 r) /\
       ~ring_unit r q") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [ring_prime], ALL_TAC] THEN
     SUBGOAL_THEN (← q "~(ff' = ring_0(poly_ring r (:1)):(1->num)->A)")
       ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_MUL_RZERO, POLY_RING, POLY_CONST],
      ALL_TAC] THEN
     SUBGOAL_THEN (← q r"!m:(1->num). (ff:(1->num)->A) m =
       ring_mul (r:A ring) q ((ff':(1->num)->A) m)") ASSUME_TAC THENL
     [GEN_TAC THEN ASM_SIMP_TAC [POLY_RING_CLAUSES, POLY_MUL_CONST,
        RING_POLYNOMIAL, BETA_THM],
      ALL_TAC] THEN
     SUBGOAL_THEN (← q r"poly_deg r (ff':(1->num)->A) =
       poly_deg r (ff:(1->num)->A)") ASSUME_TAC THENL
     [SUBGOAL_THEN
        (← q r"poly_deg (r:A ring) (ff:(1->num)->A) =
         poly_deg r (poly_const r (q:A):(1->num)->A) +
         poly_deg r (ff':(1->num)->A)")
        (fun th =>
          REWRITE_TAC [th, POLY_DEG_CONST] THEN ARITH_TAC) THEN
      ASM_REWRITE_TAC [POLY_RING_CLAUSES] THEN
      MATCH_MP_TAC POLY_DEG_MUL THEN
      ASM_REWRITE_TAC [RING_POLYNOMIAL_CONST, RING_POLYNOMIAL] THEN
      ASM_MESON_TAC [POLY_CONST_0, POLY_CONST_EQ, POLY_RING],
      ALL_TAC] THEN
     SUBGOAL_THEN (← q r"(ff':(1->num)->A) (\v:1. poly_deg r ff') IN
       ring_carrier (r:A ring) /\
       ~(ff' (\v:1. poly_deg r ff') = ring_0 (r:A ring))")
       STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER,
                     ← REWRITE_RULE [coeff] POLY_TOP_NONZERO],
      ALL_TAC] THEN
     USE_THEN "IH" (MP_TAC o
       SPEC (← q r"(ff':(1->num)->A) (\v:1. poly_deg r ff')")) THEN
     ANTS_TAC THENL
     [SUBGOAL_THEN (← q r"(a:A) = ring_mul (r:A ring) q
        ((ff':(1->num)->A) (\v:1. poly_deg r ff'))") SUBST1_TAC THENL
      [ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL
      [MATCH_MP_TAC RING_DIVIDES_LMUL THEN
       ASM_MESON_TAC [RING_DIVIDES_REFL],
       ASM_SIMP_TAC [← CONJUNCT1 INTEGRAL_DOMAIN_DIVIDES_MUL_SELF,
         DE_MORGAN_THM]],
      ALL_TAC] THEN
     DISCH_THEN (MP_TAC o SPEC (← q "ff':(1->num)->A")) THEN
     ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_THEN (← q "c':A")
       (X_CHOOSE_THEN (← q "g:(1->num)->A") STRIP_ASSUME_TAC)) THEN
     MAP_EVERY EXISTS_TAC
       [← q "ring_mul r (q:A) c'", ← q "g:(1->num)->A"] THEN
     ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC RING_MUL THEN ASM_REWRITE_TAC [],
      MP_TAC (← ISPECL [← q "r:A ring", ← q "q:A", ← q "c':A"]
        INTEGRAL_DOMAIN_MUL_EQ_0) THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q "poly_ring (r:A ring) (:1)",
        ← q "poly_const r (q:A):(1->num)->A",
        ← q "poly_const r (c':A):(1->num)->A",
        ← q "g:(1->num)->A"] RING_MUL_ASSOC) THEN
      ANTS_TAC THENL
      [ASM_SIMP_TAC [POLY_CONST, RING_MUL], ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [POLY_RING] THEN
      MATCH_MP_TAC (← GSYM POLY_CONST_MUL) THEN ASM_REWRITE_TAC []],
     DISCH_THEN (MP_TAC o
       SPEC (← q r"(f:(1->num)->A) (\v:1. poly_deg r f)")) THEN
     ANTS_TAC THENL
     [ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER], ALL_TAC] THEN
     DISCH_THEN (MP_TAC o SPEC (← q "f:(1->num)->A")) THEN
     ASM_MESON_TAC []])

  let RING_PRIME_POLY_RING_MONO ← prove
   r"!(r:A ring) (t:V->bool) s (q:(V->num)->A).
     t SUBSET s /\ ring_prime (poly_ring r t) q
     ==> ring_prime (poly_ring r s) q"
   (← do
    let lemma ← prove
     r"!(r:A ring) (t:V->bool) u s (q:(V->num)->A).
          DISJOINT t u /\ t UNION u = s /\ q IN ring_carrier (poly_ring r t)
          ==> (\p m.
                   if monomial s m
                   then p (monomial_restrict u m) (monomial_restrict t m)
                   else ring_0 r)
              (poly_const (poly_ring r t) q) = q"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
      X_GEN_TAC (← q r"m:V->num") THEN
      REWRITE_TAC [poly_const, POLY_RING, POLY_0] THEN
      ASM_CASES_TAC (← q r"monomial (s:V->bool) (m:V->num)") THEN
      ASM_REWRITE_TAC [] THENL
      [ASM_CASES_TAC (← q r"monomial_restrict (u:V->bool) (m:V->num) = monomial_1") THEN
       ASM_REWRITE_TAC [] THENL
       [AP_TERM_TAC THEN MATCH_MP_TAC MONOMIAL_RESTRICT_REFL THEN
        RULE_ASSUM_TAC (REWRITE_RULE
         [monomial, ← GSYM MONOMIAL_VARS_EQ_EMPTY,
          MONOMIAL_VARS_RESTRICT]) THEN
        REWRITE_TAC [monomial] THEN ASM SET_TAC [],
        MATCH_MP_TAC (← GSYM POLY_MONOMIALS_ALT) THEN
        EXISTS_TAC (← q r"t:V->bool") THEN
        RULE_ASSUM_TAC (REWRITE_RULE
         [monomial, ← GSYM MONOMIAL_VARS_EQ_EMPTY,
          MONOMIAL_VARS_RESTRICT, ← GSYM MEMBER_NOT_EMPTY]) THEN
        ASM_REWRITE_TAC [monomial] THEN ASM SET_TAC []],
       ASM_MESON_TAC [POLY_MONOMIALS, MONOMIAL_MONO, SUBSET_UNION]])
    pure (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"u = s DIFF (t:V->bool)") THEN
    SUBGOAL_THEN (← q r"DISJOINT (t:V->bool) u /\ t UNION u = s")
    STRIP_ASSUME_TAC THENL
    [EXPAND_TAC "u" THEN ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(q:(V->num)->A) IN ring_carrier(poly_ring r t)")
    ASSUME_TAC THENL
    [ASM_MESON_TAC [ring_prime], ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"poly_ring r (t:V->bool) :((V->num)->A) ring",
      ← q r"u:V->bool", ← q r"q:(V->num)->A"] RING_PRIME_POLY_CONST) THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_POLY_RING] THEN
    SUBGOAL_THEN
     (← q r"ring_isomorphism
       (poly_ring (poly_ring r (t:V->bool) :((V->num)->A) ring) u,
        poly_ring r (s:V->bool) :((V->num)->A) ring)
       (\p (m:V->num).
         if monomial s m
         then (p:(V->num)->(V->num)->A)
               (monomial_restrict u m) (monomial_restrict t m)
         else ring_0 r)") ASSUME_TAC THENL
    [MP_TAC (← ISPECL [← q "r:A ring", ← q r"t:V->bool", ← q r"u:V->bool"]
      RING_ISOMORPHISMS_POLY_POLY_RING) THEN
     ASM_REWRITE_TAC [] THEN
     MESON_TAC [ring_isomorphisms, ring_isomorphism],
     ALL_TAC] THEN
    DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o
      SPEC (← q r"poly_const (poly_ring r (t:V->bool) :((V->num)->A) ring)
            (q:(V->num)->A) :(V->num)->(V->num)->A") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        RING_PRIME_ISOMORPHIC_IMAGE_EQ)) THEN
    ASM_REWRITE_TAC [POLY_CONST] THEN
    MP_TAC (← ISPECL
     [← q "r:A ring", ← q r"t:V->bool", ← q r"u:V->bool",
      ← q r"s:V->bool", ← q r"q:(V->num)->A"] lemma) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN ASM_REWRITE_TAC []))

  -- @@RETURN BEGIN
  return { POLY_PRIMITIVE_CONST_CANCEL, MAKE_PRIMITIVE_IN_IDEAL, POLY_MAKE_PRIMITIVE,
           RING_PRIME_POLY_RING_MONO }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Gauss's lemma, continued: UFD_POLY_RING.  (ringtheory.ml 27350-27716)     -/
/- ------------------------------------------------------------------------- -/

structure GaussB where
  -- @@FIELDS
  UFD_POLY_RING : thm
  deriving Inhabited

@[nospecialize]
def setupGaussB [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BIso : Iso) (BRingRule : RingRule) (BSpecialIdeals : SpecialIdeals) (BUFDs : UFDs) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BNatIso : NatIso) (BRenaming : Renaming) (BOneCoeff : OneCoeff) (BDegree : Degree) (BZerodivisors : Zerodivisors) (BDivision : Division) (BGaussA : GaussA) :
    ExceptT String IO GaussB := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ADD_CLAUSES, .. } := D.core1
  let { EXTENSION, .. } := D.core2
  let { FINITE_INDUCT_STRONG, .. } := D.core3
  let { IMP_CONJ_ALT, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, IN_SING, IN_UNIV, I_THM, LE_0, LE_REFL, LE_TRANS, .. } := D.core5
  let { NOT_EXISTS_THM, NOT_LT, .. } := D.core6
  let { SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUB_ADD, .. } := D.core7
  let { eq_c, num_WF, num_WOP, one, .. } := D.core8
  let { RING_ADD, RING_MUL, RING_MUL_RZERO, RING_SUB, .. } := BBasics
  let { RING_POW, RING_POW_ADD, .. } := BNumbers
  let { RING_DIVIDES_0, RING_DIVIDES_ADD, RING_DIVIDES_LMUL, RING_DIVIDES_REFL, .. } := BDivides
  let { IDEAL_GENERATED_MINIMAL, IDEAL_GENERATED_SING, IN_RING_IDEAL_0,
        IN_RING_IDEAL_LMUL, IN_RING_IDEAL_SUB, RING_IDEAL_IMP_SUBSET, .. } := BIdeals
  let { integral_domain, .. } := BDomains
  let { ISOMORPHIC_RING_REFL, ISOMORPHIC_RING_TRANS, .. } := BIso
  let { RING_RULE, .. } := BRingRule
  let { PRIME_IDEAL_HOMOMORPHIC_PREIMAGE, PRIME_IMP_RING_IDEAL, RING_PRIME_IDEAL,
        prime_ideal, proper_ideal, .. } := BSpecialIdeals
  let { ISOMORPHIC_RING_UFDNESS, UFD, UFD_IMP_INTEGRAL_DOMAIN, .. } := BUFDs
  let { POLY_CONST_0, RING_POLYNOMIAL_CONST, .. } := BPowerSeries
  let { IN_POLY_RING_CARRIER, POLY_CONST, POLY_MONOMIAL_IN_CARRIER, POLY_RING,
        POLY_RING_CLAUSES, POLY_RING_IN_FINITE_VARIABLES, POLY_VAR_UNIV,
        RING_HOMOMORPHISM_POLY_CONST, RING_POLYNOMIAL, .. } := BPolyRings
  let { ISOMORPHIC_POLY_RINGS, ISOMORPHIC_POLY_RING_TRIVIAL, ISOMORPHIC_RING_POLY_POLY, .. } := BNatIso
  let { POLY_RING_HOMOMORPHISM_I, .. } := BRenaming
  let { coeff, .. } := BOneCoeff
  let { INTEGRAL_DOMAIN_POLY_RING, POLY_DEG_0, POLY_DEG_CONST, POLY_DEG_EQ_0,
        POLY_DEG_MUL_LE, POLY_DEG_RING_SUB_LE, POLY_DEG_VAR_POW, .. } := BDegree
  let { RING_PRIME_POLY_CONST, .. } := BZerodivisors
  let { POLY_TOP_NONZERO, POLY_TOP_TAIL, .. } := BDivision
  let { MAKE_PRIMITIVE_IN_IDEAL, POLY_PRIMITIVE_CONST_CANCEL,
        RING_PRIME_POLY_RING_MONO, .. } := BGaussA
  -- @@SCOPE END

  let UFD_POLY_RING ← prove
   r"!(r:A ring) (s:V->bool). UFD r ==> UFD(poly_ring r s)"
   (← do
    let UFD_POLY_RING_1 ← prove
     r"!(r:A ring). UFD r ==> UFD(poly_ring r (:1))"
     (← do
      -- right to left: the second RING_RULE, the two ARITH_RULEs (later
      -- first), the first RING_RULE, then the TAUT
      let r5 ← RING_RULE
       (← q r"(x:(1->num)->A) IN ring_carrier rr /\ y IN ring_carrier rr
         ==> x = ring_add rr (ring_sub rr x y) y")
      let a4 ← ARITH_RULE (← q r"~(nn = 0) /\ x <= nn - 1 ==> x < nn")
      let a3 ← ARITH_RULE
       (← q r"s:num < m ==> m <= n /\ q <= n - m ==> q + s <= n - 1")
      let r2 ← RING_RULE
       (← q r"ring_mul (rr:(((1->num)->A)ring)) xk xdg = xn
         ==> ring_sub rr
          (ring_mul rr a (ring_add rr (ring_mul rr b xn) t))
          (ring_mul rr (ring_mul rr b xk)
           (ring_add rr (ring_mul rr a xdg) s)) =
         ring_sub rr (ring_mul rr a t)
          (ring_mul rr (ring_mul rr b xk) s)")
      let t1 ← TAUT (← q r"~(p /\ ~q /\ r) <=> p /\ r ==> q")
      pure (GEN_TAC THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP UFD_IMP_INTEGRAL_DOMAIN) THEN
      REWRITE_TAC [UFD] THEN CONJ_TAC THENL
      [ASM_REWRITE_TAC [INTEGRAL_DOMAIN_POLY_RING], ALL_TAC] THEN
      X_GEN_TAC (← q "j:((1->num)->A)->bool") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"?c:A. c IN ring_carrier r /\ ~(c = ring_0 r) /\
        (poly_const r c:(1->num)->A) IN j") THENL
      [FIRST_X_ASSUM (X_CHOOSE_THEN (← q "c:A") STRIP_ASSUME_TAC) THEN
       SUBGOAL_THEN
        (← q r"prime_ideal (r:A ring)
          {x | x IN ring_carrier r /\ (poly_const r x:(1->num)->A) IN j} /\
         ~({x:A | x IN ring_carrier r /\
           (poly_const r x:(1->num)->A) IN j} = {ring_0 r})") MP_TAC THENL
       [CONJ_TAC THENL
        [MP_TAC (← ISPECL [← q "r:A ring", ← q "poly_ring (r:A ring) (:1)",
           ← q "poly_const (r:A ring):A->(1->num)->A", ← q "j:((1->num)->A)->bool"]
           PRIME_IDEAL_HOMOMORPHIC_PREIMAGE) THEN
         ASM_REWRITE_TAC [RING_HOMOMORPHISM_POLY_CONST],
         REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_SING] THEN
         DISCH_THEN (MP_TAC o SPEC (← q "c:A")) THEN ASM_REWRITE_TAC []],
        ALL_TAC] THEN
       FIRST_ASSUM (fun th => tactic_of do
        let c2 ← CONJUNCT2 (← REWRITE_RULE [UFD] th)
        pure (DISCH_THEN (MP_TAC o MATCH_MP c2))) THEN
       REWRITE_TAC [IN_ELIM_THM] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q "p:A") STRIP_ASSUME_TAC) THEN
       EXISTS_TAC (← q "poly_const (r:A ring) p:(1->num)->A") THEN
       ASM_SIMP_TAC [RING_PRIME_POLY_CONST],
       FIRST_X_ASSUM (ASSUME_TAC o
         REWRITE_RULE [t1] o
         GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
       SUBGOAL_THEN
        (← q r"?g:(1->num)->A.
           g IN ring_carrier(poly_ring r (:1)) /\ g IN j /\
           ~(g = ring_0(poly_ring r (:1))) /\
           (!p. ring_prime r p
                ==> ~ring_divides (poly_ring r (:1)) (poly_const r p) g) /\
           (!h. h IN j ==> ring_divides (poly_ring r (:1)) g h)")
        STRIP_ASSUME_TAC THENL
       [SUBGOAL_THEN
         (← q r"ring_ideal (poly_ring (r:A ring) (:1)) j /\
          j SUBSET ring_carrier (poly_ring r (:1))") STRIP_ASSUME_TAC THENL
        [ASM_MESON_TAC [PRIME_IMP_RING_IDEAL, RING_IDEAL_IMP_SUBSET],
         ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"?f:(1->num)->A.
            f IN ring_carrier(poly_ring r (:1)) /\ f IN j /\
            ~(f = ring_0(poly_ring r (:1))) /\
            !h. h IN j /\ ~(h = ring_0(poly_ring r (:1)))
                ==> poly_deg r f <= poly_deg r h") STRIP_ASSUME_TAC THENL
