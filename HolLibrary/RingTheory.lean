  let INTEGER_MOD_RING_ASSOCIATES ← prove
   r"!n x y. ring_associates (integer_mod_ring n) x y <=>
           x IN ring_carrier(integer_mod_ring n) /\
           y IN ring_carrier(integer_mod_ring n) /\
