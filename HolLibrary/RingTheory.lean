    EXISTS_TAC (← q r"(x:K->A) IN ring_carrier(product_ring k r)") THEN
    REWRITE_TAC [RING_NILPOTENT_IN_CARRIER] THEN
    SIMP_TAC [ring_nilpotent, PRODUCT_RING, IN_CARTESIAN_PRODUCT,
              RING_POW_PRODUCT_RING, RESTRICTION_EXTENSION] THEN
    MESON_TAC [])

  let RING_NILPOTENT_PRODUCT_RING ← prove
   r"!k (r:K->A ring) x.
        FINITE k
        ==> (ring_nilpotent (product_ring k r) x <=>
             EXTENSIONAL k x /\
             !i. i IN k ==> ring_nilpotent (r i) (x i))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [RING_NILPOTENT_PRODUCT_RING_GEN] THEN
    EQ_TAC THEN SIMP_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [ring_nilpotent] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
     [RIGHT_AND_EXISTS_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"m:K->num")) THEN
    MP_TAC (← ISPEC (← q r"IMAGE (m:K->num) k") FINITE_SUBSET_NUMSEG) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, SUBSET, IN_NUMSEG, LE_0, FORALL_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q "n:num")) THEN EXISTS_TAC (← q "SUC n") THEN
    REWRITE_TAC [NOT_SUC] THEN X_GEN_TAC (← q "i:K") THEN DISCH_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q "i:K"))) THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LE_EXISTS]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "d:num") SUBST1_TAC) THEN
    REWRITE_TAC [← ARITH_RULE (← q "SUC(m + d) = m + SUC d")] THEN
    ASM_SIMP_TAC [RING_POW_ADD, RING_MUL_LZERO, RING_POW])

  let ISOMORPHIC_PRODUCT_RING_DISJOINT_UNION ← prove
   r"!(f:K->A ring) k l.
        DISJOINT k l
        ==> product_ring (k UNION l) f isomorphic_ring
            prod_ring (product_ring k f) (product_ring l f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [isomorphic_ring, ring_isomorphism] THEN
    REWRITE_TAC [RING_ISOMORPHISMS] THEN
    EXISTS_TAC (← q r"\(f:K->A). RESTRICTION k f,RESTRICTION l f") THEN
    EXISTS_TAC (← q r"\((f:K->A),g) x. if x IN k then f x else g x") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [RING_HOMOMORPHISM_PAIRED,
                   RING_HOMOMORPHISM_COMPONENTWISE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
      SIMP_TAC [RESTRICTION, RING_HOMOMORPHISM_PRODUCT_PROJECTION, IN_UNION],
      REWRITE_TAC [PROD_RING, FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
      SIMP_TAC [RESTRICTION_UNIQUE, IN_CARTESIAN_PRODUCT, PRODUCT_RING] THEN
      REWRITE_TAC [EXTENSIONAL, IN_ELIM_THM] THEN
      REWRITE_TAC [FUN_EQ_THM, RESTRICTION] THEN ASM SET_TAC []])

  let ISOMORPHIC_PRODUCT_RING_SING ← prove
   r"!(r:K->A ring) k. product_ring {k} r isomorphic_ring r k"
   (REWRITE_TAC [isomorphic_ring] THEN
    MESON_TAC [RING_ISOMORPHISM_PRODUCT_PROJECTION])

  let ISOMORPHIC_PRODUCT_RING_SUPPORT ← prove
   r"!k (r:K->A ring).
        product_ring {i | i IN k /\ ~trivial_ring(r i)} r isomorphic_ring
        product_ring k r"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_RING_SYM] THEN
    REWRITE_TAC [isomorphic_ring, ring_isomorphism, RING_ISOMORPHISMS] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x:K->A. RESTRICTION {i | i IN k /\ ~trivial_ring((r:K->A ring) i)} x",
      ← q r"\x. RESTRICTION k (\i. if trivial_ring((r:K->A ring) i)
                            then ring_0(r i) else x i)"] THEN
    REWRITE_TAC [RING_HOMOMORPHISM_COMPONENTWISE] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
    REWRITE_TAC [PRODUCT_RING, RESTRICTION_IN_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [RESTRICTION_UNIQUE] THEN SIMP_TAC [IN_ELIM_THM] THEN
    SIMP_TAC [RESTRICTION, IN_ELIM_THM, EXTENSIONAL] THEN
    SIMP_TAC [RING_HOMOMORPHISM_PRODUCT_PROJECTION] THEN
    MESON_TAC [RING_0, trivial_ring, IN_SING])

  let ISOMORPHIC_PRODUCT_RING_SYMDIFF ← prove
   r"!k l (r:K->A ring).
        (!i. i IN (k DIFF l) UNION (l DIFF k) ==> trivial_ring(r i))
        ==> product_ring k r isomorphic_ring product_ring l r"
   (REPEAT STRIP_TAC THEN
    wPart lhand rand ISOMORPHIC_PRODUCT_RING_SUPPORT THEN
    GEN_REWRITE_TAC LAND_CONV [ISOMORPHIC_RING_SYM] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] ISOMORPHIC_RING_TRANS) THEN
    wPart rand rand ISOMORPHIC_PRODUCT_RING_SUPPORT THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] ISOMORPHIC_RING_TRANS) THEN
    MATCH_MP_TAC (← MESON [ISOMORPHIC_RING_REFL]
     (← q r"r = s ==> r isomorphic_ring s")) THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let ISOMORPHIC_PRODUCT_RING_BIJECTIONS ← prove
   r"!s (r:K->A ring) t (r':L->B ring) f g.
        (!x. x IN s ==> f(x) IN t /\ g(f x) = x) /\
        (!y. y IN t ==> g(y) IN s /\ f(g y) = y) /\
        (!i. i IN s ==> (r i) isomorphic_ring r'(f i))
        ==> product_ring s r isomorphic_ring product_ring t r'"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [isomorphic_ring, ring_isomorphism] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"h:K->A->B", ← q r"k:K->B->A"] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
     [ring_isomorphisms, FORALL_AND_THM,
      ← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\(x:K->A). RESTRICTION t (\j:L. (h:K->A->B) (g j) (x (g j)))",
      ← q r"\(y:L->B). RESTRICTION s (\i:K. (k:K->B->A) i (y (f i)))"] THEN
    REWRITE_TAC [ring_isomorphisms] THEN
    REWRITE_TAC [RESTRICTION_EXTENSION, PRODUCT_RING, FORALL_IN_GSPEC,
      IMP_CONJ, CARTESIAN_PRODUCT_AS_RESTRICTIONS] THEN
    ASM_SIMP_TAC [RESTRICTION] THEN
    REWRITE_TAC [RING_HOMOMORPHISM_COMPONENTWISE] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PRODUCT_RING] THEN
    REWRITE_TAC [RESTRICTION_IN_EXTENSIONAL] THEN SIMP_TAC [RESTRICTION] THEN
    CONJ_TAC THENL [X_GEN_TAC (← q "j:L"), X_GEN_TAC (← q "i:K")] THEN
    DISCH_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THENL
     [EXISTS_TAC (← q r"(r:K->A ring) (g(j:L))"),
      EXISTS_TAC (← q r"(r':L->B ring) (f(i:K))")] THEN
    ASM_SIMP_TAC [RING_HOMOMORPHISM_PRODUCT_PROJECTION] THEN
    ASM_MESON_TAC [])

  let RING_ISOMORPHISMS_PRODUCT_RING_DISJOINT_UNION ← prove
   r"!(f:K->A ring) k l.
        DISJOINT k l
        ==> ring_isomorphisms
                (product_ring (k UNION l) f,
                 prod_ring (product_ring k f) (product_ring l f))
                ((\f. RESTRICTION k f,RESTRICTION l f),
                 (\(f,g) x. if x IN k then f x else g x))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [RING_ISOMORPHISMS] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [RING_HOMOMORPHISM_PAIRED,
                   RING_HOMOMORPHISM_COMPONENTWISE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
      SIMP_TAC [RESTRICTION, RING_HOMOMORPHISM_PRODUCT_PROJECTION, IN_UNION],
      REWRITE_TAC [PROD_RING, FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
      SIMP_TAC [RESTRICTION_UNIQUE, IN_CARTESIAN_PRODUCT, PRODUCT_RING] THEN
      REWRITE_TAC [EXTENSIONAL, IN_ELIM_THM] THEN
      REWRITE_TAC [FUN_EQ_THM, RESTRICTION] THEN ASM SET_TAC []])

  let RING_ISOMORPHISM_PRODUCT_RING_DISJOINT_UNION ← prove
   r"!(f:K->A ring) k l.
        DISJOINT k l
        ==> ring_isomorphism
                (product_ring (k UNION l) f,
                 prod_ring (product_ring k f) (product_ring l f))
                (\f. RESTRICTION k f,RESTRICTION l f)"
   (REWRITE_TAC [ring_isomorphism] THEN
    MESON_TAC [RING_ISOMORPHISMS_PRODUCT_RING_DISJOINT_UNION])

  let ISOMORPHIC_PRODUCT_RING_INSERT ← prove
   r"!(f:K->A ring) i k.
        ~(i IN k)
        ==> product_ring (i INSERT k) f isomorphic_ring
            prod_ring (f i) (product_ring k f)"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC ISOMORPHIC_RING_TRANS
     (← q r"prod_ring (product_ring {i} f) (product_ring k (f:K->A ring))") THEN
    SUBST1_TAC (← SET_RULE (← q r"(i:K) INSERT k = {i} UNION k")) THEN
    ASM_SIMP_TAC [ISOMORPHIC_PRODUCT_RING_DISJOINT_UNION, DISJOINT_SING] THEN
    MATCH_MP_TAC ISOMORPHIC_RING_PROD_RINGS THEN
    REWRITE_TAC [ISOMORPHIC_RING_REFL, ISOMORPHIC_PRODUCT_RING_SING])

  -- @@RETURN BEGIN
  return { prod_ring, PROD_RING, RING_HOMOMORPHISM_PAIRWISE, RING_HOMOMORPHISM_PAIRED,
           RING_HOMOMORPHISM_DIAG, RING_MONOMORPHISM_DIAG, RING_HOMOMORPHISM_PAIRED2,
           RING_ISOMORPHISMS_PAIRED2, RING_ISOMORPHISM_PAIRED2,
           ISOMORPHIC_RING_PROD_RINGS, RING_HOMOMORPHISM_OF_FST,
           RING_HOMOMORPHISM_OF_SND, RING_EPIMORPHISM_OF_FST, RING_EPIMORPHISM_OF_SND,
           RING_HOMOMORPHISM_FST, RING_HOMOMORPHISM_SND, RING_EPIMORPHISM_FST,
           RING_EPIMORPHISM_SND, RING_ISOMORPHISM_FST, RING_ISOMORPHISM_SND,
           RING_ISOMORPHISMS_PROD_RING_SWAP, ISOMORPHIC_RING_PROD_RING_SYM,
           ISOMORPHIC_RING_PROD_RING_SWAP_LEFT, ISOMORPHIC_RING_PROD_RING_SWAP_RIGHT,
           ISOMORPHIC_PROD_TRIVIAL_RING, TRIVIAL_PROD_RING, FINITE_PROD_RING,
           CROSS_SUBRING_OF_PROD_RING, PROD_RING_SUBRING_GENERATED, RING_IDEAL_CROSS,
           RING_IDEAL_PROD_RING, IDEAL_GENERATED_PAIRWISE, IDEAL_GENERATED_CROSS,
           RING_POW_PROD_RING, RING_DIVIDES_PROD_RING, RING_OF_NUM_PROD_RING,
           RING_OF_INT_PROD_RING, RING_ASSOCIATES_PROD_RING, RING_ZERODIVISOR_PROD_RING,
           RING_REGULAR_PROD_RING, RING_NILPOTENT_PROD_RING, product_ring, PRODUCT_RING,
           TRIVIAL_PRODUCT_RING, ISOMORPHIC_RING_PRODUCT_RING,
           RING_HOMOMORPHISM_COMPONENTWISE, RING_HOMOMORPHISM_COMPONENTWISE_UNIV,
           RING_PRODUCT_INJECTION, RING_HOMOMORPHISM_DIAGONAL,
           RING_HOMOMORPHISM_DIAGONAL_UNIV, RING_MONOMORPHISM_DIAGONAL,
           RING_MONOMORPHISM_DIAGONAL_UNIV, RING_HOMOMORPHISM_PRODUCT_PROJECTION,
           RING_EPIMORPHISM_PRODUCT_PROJECTION, RING_ISOMORPHISM_PRODUCT_PROJECTION,
           CARTESIAN_PRODUCT_SUBRING_OF_PRODUCT_RING, PRODUCT_RING_SUBRING_GENERATED,
           FINITE_PRODUCT_RING, RING_IDEAL_CARTESIAN_PRODUCT, RING_SUM_PRODUCT_RING,
           RING_IDEAL_PRODUCT_RING, IDEAL_GENERATED_COMPONENTWISE,
           IDEAL_GENERATED_CARTESIAN_PRODUCT, RING_POW_PRODUCT_RING,
           RING_DIVIDES_PRODUCT_RING, RING_ASSOCIATES_PRODUCT_RING,
           RING_ZERODIVISOR_PRODUCT_RING, RING_REGULAR_PRODUCT_RING,
           RING_NILPOTENT_PRODUCT_RING_GEN, RING_NILPOTENT_PRODUCT_RING,
           ISOMORPHIC_PRODUCT_RING_DISJOINT_UNION, ISOMORPHIC_PRODUCT_RING_SING,
           ISOMORPHIC_PRODUCT_RING_SUPPORT, ISOMORPHIC_PRODUCT_RING_SYMDIFF,
           ISOMORPHIC_PRODUCT_RING_BIJECTIONS,
           RING_ISOMORPHISMS_PRODUCT_RING_DISJOINT_UNION,
           RING_ISOMORPHISM_PRODUCT_RING_DISJOINT_UNION, ISOMORPHIC_PRODUCT_RING_INSERT }
  -- @@RETURN END

/-- `splitlist CONJ_PAIR th` (lib.ml `splitlist`): split off left conjuncts
    while `CONJ_PAIR` succeeds. -/
partial def splitConjPair [HolBase] (th : thm) : ExceptT String IO (List thm × thm) :=
  tryF (do
    let (a, b) ← CONJ_PAIR th
    let (l, z) ← splitConjPair b
    pure (a :: l, z)) (fun _ => pure ([], th))

/-- The theorems `RING_MONOMORPHIC_IMAGE_RULE hth` destructures
    (ringtheory.ml 8371-8375). -/
structure MonoImageThms where
  (pth_eq pth_asm pth_0 pth_1 pth_num pth_int pth_neg pth_pow pth_add pth_sub
   pth_mul : thm)

/-- `mterm` (ringtheory.ml 8377-8402). -/
partial def monoImageMterm [HolBase] (P : MonoImageThms) (tm : term) :
    ExceptT String IO thm :=
  match tm with
  | .Comb (.Const "ring_0" _) _ => pure P.pth_0
  | .Comb (.Const "ring_1" _) _ => pure P.pth_1
  | .Comb (.Comb (.Const "ring_of_num" _) _) n => SPEC n P.pth_num
  | .Comb (.Comb (.Const "ring_of_int" _) _) n => SPEC n P.pth_int
  | .Comb (.Comb (.Const "ring_neg" _) _) s => do
      let sth ← monoImageMterm P s
      MATCH_MP P.pth_neg sth
  | .Comb (.Comb (.Comb (.Const "ring_pow" _) _) s) n => do
      let sth ← monoImageMterm P s
      MATCH_MP (← SPEC n P.pth_pow) sth
  | .Comb (.Comb (.Comb (.Const "ring_add" _) _) s) t => do
      let sth ← monoImageMterm P s
      let tth ← monoImageMterm P t
      MATCH_MP P.pth_add (← CONJ sth tth)
  | .Comb (.Comb (.Comb (.Const "ring_sub" _) _) s) t => do
      let sth ← monoImageMterm P s
      let tth ← monoImageMterm P t
      MATCH_MP P.pth_sub (← CONJ sth tth)
  | .Comb (.Comb (.Comb (.Const "ring_mul" _) _) s) t => do
      let sth ← monoImageMterm P s
      let tth ← monoImageMterm P t
      MATCH_MP P.pth_mul (← CONJ sth tth)
  | _ => do UNDISCH (← SPEC tm P.pth_asm)

/-- `mform` (ringtheory.ml 8403-8412). -/
partial def monoImageMform [HolBase] (P : MonoImageThms) (tm : term) :
    ExceptT String IO thm :=
  let mform : ioconv := fun t => (monoImageMform P t).run
  if is_neg tm then
    ExceptT.mk (RAND_CONV mform tm)
  else if HolCore.Bool.is_iff tm || is_imp tm || is_conj tm || is_disj tm then
    ExceptT.mk (BINOP_CONV mform tm)
  else if is_eq tm then do
    let (s, t) ← liftExcept (dest_eq tm)
    let sth ← monoImageMterm P s
    let tth ← monoImageMterm P t
    MATCH_MP P.pth_eq (← CONJ sth tth)
  else throw "RING_MONOMORPHIC_IMAGE_RULE: unhandled formula"

/-- lib.ml `mapfilter`, catching `Failure` only: the tail is done first. -/
def mapfilterF {α β : Type} (f : α → ExceptT String IO β) :
    List α → ExceptT String IO (List β)
  | [] => pure []
  | h :: t => do
      let rest ← mapfilterF f t
      tryF (do return (← f h) :: rest) (fun _ => pure rest)

/-- lib.ml `tryfind`, catching `Failure` only. -/
def tryfindF {α β : Type} (f : α → ExceptT String IO β) : List α → ExceptT String IO β
  | [] => throw "tryfind"
  | h :: t => tryF (f h) (fun _ => tryfindF f t)

/-- lib.ml `map2`, left to right. -/
def map2F {α β γ : Type} (f : α → β → ExceptT String IO γ) :
    List α → List β → ExceptT String IO (List γ)
  | [], [] => pure []
  | h1 :: t1, h2 :: t2 => do
      let h ← f h1 h2
      return h :: (← map2F f t1 t2)
  | _, _ => throw "map2: length mismatch"

/-- What `RING_RULE` builds once (ringtheory.ml 8424-8624). -/
structure RingRuleCtx where
  RING_TOTALIZATION : thm
  -- RING_WORD_UNIVERSAL
  bth : thm
  mth : thm
  dth : thm
  decorule : term → ExceptT String IO thm
  RING_POLY_UNIVERSAL_CONV : ioconv
  ring_ring_cofactors_universal : List term → term → IO (Except String (List term))
  -- RING_RING_WORD
  imp_imp_rule : thm → ExceptT String IO thm
  left_exists_rule : thm → ExceptT String IO thm
  or_elim_rule : thm → ExceptT String IO thm
  RING_MONOMORPHIC_IMAGE_RULE : thm → ExceptT String IO (term → ExceptT String IO thm)
  -- RING_RING_HORN, RING_RING_CORE
  ddj_conv : ioconv
  core_pth : thm
  ptm : term
  qtm : term
  DISJ_ACI_RULE : term → Except String thm
  -- RING_RULE_BASIC
  init_conv : ioconv
  true_tm : term

/-- `RING_WORD_UNIVERSAL` (ringtheory.ml 8487-8512). -/
def ringWordUniversal [HolBase] (C : RingRuleCtx) (tm : term) : ExceptT String IO thm := do
  let (avs, bod) := strip_forall tm
  if is_imp bod then do
    let (ant, con) ← liftExcept (dest_imp bod)
    -- `let aths = ... and cth = ...`: left to right
    let aths ← mapfilterF (CONV_RULE (fun t => (C.decorule t).run))
      (CONJUNCTS (← ASSUME ant))
    let cth ← C.decorule con
    let atms ← aths.mapM (fun th => liftExcept (lhand (concl th)))
    let ctm ← liftExcept (do lhand (← rand (concl cth)))
    let ctms ← ExceptT.mk (C.ring_ring_cofactors_universal atms ctm)
    let zths ← map2F (fun c th => do SPEC c (← MATCH_MP C.mth th)) ctms aths
    let zth ← HolLight.end_itlist (fun th1 th2 => do MATCH_MP C.dth (← CONJ th1 th2)) zths
    -- `TRANS a b`: b first
    let b ← SYM (← ExceptT.mk (C.RING_POLY_UNIVERSAL_CONV (← liftExcept (lhand (concl zth)))))
    let a ← ExceptT.mk (C.RING_POLY_UNIVERSAL_CONV ctm)
    let eth ← TRANS a b
    let t2 ← TRANS eth zth
    GENL avs (← DISCH ant (← EQ_MP (← SYM cth) t2))
  else do
    let th1 ← C.decorule tm
    let th2 ← CONV_RULE (RAND_CONV (LAND_CONV C.RING_POLY_UNIVERSAL_CONV)) th1
    EQ_MP (← SYM th2) C.bth

/-- `RING_RING_WORD` (ringtheory.ml 8513-8569). -/
def ringRingWord [HolBase] (C : RingRuleCtx) (ths : List thm) (tm : term) :
    ExceptT String IO thm := do
  let dty := type_of (← liftExcept (rand tm))
  let rty ← ExceptT.mk (mk_type "ring" [dty])
  let rtms := (freesl (tm :: ths.map concl)).filter (fun t => type_of t == rty)
  if rtms.length != 1 then throw "RING_RULE: can't deduce which ring"
  let rtm := rtms.head!
  let tvs := itlist (fun th acc => union (type_vars_in_term (concl th)) acc) ths
               (type_vars_in_term tm)
  let names ← liftExcept (tvs.mapM dest_vartype)
  let dty' := mk_vartype ("Z" ++ itlist (fun n acc => n ++ acc) names "")
  let rty' ← ExceptT.mk (mk_type "ring" [dty'])
  let avvers ← liftExcept (do
    let base ← variables tm
    ths.foldrM (fun th acc => do return union (← variables (concl th)) acc) base)
  -- `let rtm' = ... and htm = ...`: left to right
  let rtm' ← liftExcept (variant avvers (mk_var "r'" rty'))
  let htm ← liftExcept (variant avvers (mk_var "h" (← ExceptT.mk (mk_fun_ty dty dty'))))
  let pr ← ExceptT.mk (HolMath.Pair.mk_pair (rtm, rtm'))
  let hasm ← ExceptT.mk (list_mk_icomb "ring_monomorphism" [pr, htm])
  let hth ← ASSUME hasm
  -- `let ths' = mapfilter (CONV_RULE(RING_MONOMORPHIC_IMAGE_RULE hth)) ths
  --  and th' = RING_MONOMORPHIC_IMAGE_RULE hth tm`: left to right
  let rmi1 ← C.RING_MONOMORPHIC_IMAGE_RULE hth
  let ths' ← mapfilterF (CONV_RULE (fun t => (rmi1 t).run)) ths
  let rmi2 ← C.RING_MONOMORPHIC_IMAGE_RULE hth
  let th' ← rmi2 tm
  let utm ← if ths'.isEmpty then liftExcept (rand (concl th'))
    else liftExcept (do HolCore.Bool.mk_imp (← HolCore.Bool.list_mk_conj (ths'.map concl)) (← rand (concl th')))
  let hvs := find_terms (fun t =>
    is_comb t && (match rator t with | .ok f => f == htm | .error _ => false) &&
    (match rand t with | .ok x => is_var x | .error _ => false)) utm
  let gvs ← (hvs.mapM (fun t => genvar (type_of t)) : IO (List term))
  let sf ← ExceptT.mk (subst (← liftExcept (zip gvs hvs)))
  let vtm ← ExceptT.mk (sf utm)
  let arty ← ExceptT.mk (mk_type "ring" [aty])
  let vs ← liftExcept (vsubst [(mk_var "r" arty, mk_var (← liftExcept (dest_var rtm')).1 arty)])
  let atm := vs (inst [(aty, dty')] vtm)
  let th1 ← ringWordUniversal C atm
  let th2 ← INST_TYPE [(dty', aty)] th1
  let th3 ← INST [(rtm', mk_var "r" rty')] th2
  let th4 ← INST (← liftExcept (zip hvs gvs)) th3
  let th5 ← if ths'.isEmpty then pure th4
    else do MP th4 (← HolLight.end_itlist CONJ ths')
  let th6 ← ths.foldrM (fun th acc => PROVE_HYP th acc) (← EQ_MP (← SYM th') th5)
  let mkEq ← ExceptT.mk mk_eq
  let univ ← ExceptT.mk (mk_const "UNIV" [(dty', aty)])
  let car ← ExceptT.mk (list_mk_icomb "ring_carrier" [rtm'])
  let ueq ← liftExcept (mkEq (car, univ))
  let th7 ← C.imp_imp_rule (← DISCH ueq (← DISCH hasm th6))
  let th8 ← C.left_exists_rule (← GEN htm th7)
  let th9 ← C.left_exists_rule (← GEN rtm' th8)
  let th10 ← ISPEC rtm C.RING_TOTALIZATION
  -- `CONJ a b`: b first
  let b ← PART_MATCH lhand th9 (← liftExcept (rand (concl th10)))
  let a ← PART_MATCH lhand th9 (← liftExcept (lhand (concl th10)))
  let th11 ← CONJ a b
  MP (← C.or_elim_rule th11) th10

/-- `RING_RING_HORN` (ringtheory.ml 8570-8585). -/
def ringRingHorn [HolBase] (C : RingRuleCtx) (tm : term) : ExceptT String IO thm := do
  if !(is_disj tm) then ringRingWord C [] tm else
  let th0 ← ExceptT.mk (C.ddj_conv tm)
  let tm' ← liftExcept (rand (concl th0))
  let abod ← liftExcept (lhand tm')
  let ths := CONJUNCTS (← ASSUME abod)
  let th1 ← ringRingWord C ths (← liftExcept (rand tm'))
  let th2 ← ths.foldrM (fun th acc => PROVE_HYP th acc) th1
  EQ_MP (← SYM th0) (← DISCH abod th2)

/-- `RING_RING_CORE` (ringtheory.ml 8586-8595). -/
def ringRingCore [HolBase] (C : RingRuleCtx) (tm : term) : ExceptT String IO thm := do
  let (negdjs, posdjs) := partition is_neg (disjuncts tm)
  let th ← tryfindF (fun p => do ringRingHorn C (← liftExcept (HolCore.Bool.list_mk_disj (p :: negdjs))))
    posdjs
  let th1 ← INST [(concl th, C.ptm), (tm, C.qtm)] C.core_pth
  let ath ← liftExcept (C.DISJ_ACI_RULE (← liftExcept (rand (concl th1))))
  MP (← EQ_MP (← SYM th1) ath) th

/-- `RING_RULE_BASIC` (ringtheory.ml 8607-8621). -/
def ringRuleBasic [HolBase] (C : RingRuleCtx) (tm : term) : ExceptT String IO thm := do
  let (avs, bod) := strip_forall tm
  let th1 ← ExceptT.mk (C.init_conv bod)
  let tm' ← liftExcept (rand (concl th1))
  if tm' == C.true_tm then EQT_ELIM th1 else
  let (avs', bod') := strip_forall tm'
  let th2 ← HolLight.end_itlist CONJ (← (conjuncts bod').mapM (ringRingCore C))
  let th3 ← EQ_MP (← SYM th1) (← GENL avs' th2)
  let imps := hyp th3
  let th4 ← if imps.isEmpty then pure th3 else do
    let cs := CONJUNCTS (← ASSUME (← liftExcept (HolCore.Bool.list_mk_conj imps)))
    DISCH_ALL (← cs.foldrM (fun th acc => PROVE_HYP th acc) th3)
  GENL avs th4

/-- `RING_RULE` (ringtheory.ml 8622-8626). -/
def ringRule [HolBase] (C : RingRuleCtx) (tm : term) : ExceptT String IO thm := do
  let tvs := type_vars_in_term tm
  let names ← liftExcept (tvs.mapM dest_vartype)
  let ty := mk_vartype ("Y" ++ itlist (fun n acc => n ++ acc) names "")
  let tm' := inst [(ty, aty)] tm
  INST_TYPE [(aty, ty)] (← ringRuleBasic C tm')

/- ------------------------------------------------------------------------- -/
/- Direct limits, and RING_MONOMORPHIC_IMAGE_RULE.  (ringtheory.ml 8238-8417) -/
/- ------------------------------------------------------------------------- -/

structure Limits where
  -- @@FIELDS
  RING_DIRECT_LIMIT : thm
  RING_MONOMORPHIC_IMAGE_RULE : thm → ExceptT String IO (term → ExceptT String IO thm)
  deriving Inhabited

@[nospecialize]
def setupLimits [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BHoms : Homs) :
    ExceptT String IO Limits := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, let_CONV, .. } := D
  let { CONJ_SYM, EMPTY_SUBSET, EXISTS_IN_GSPEC, .. } := D.core2
  let { FINITE_EMPTY, FINITE_INSERT, FINITE_SUBSET_UNIONS_DIRECTED_EQ, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, IMAGE_I, IMAGE_ID, .. } := D.core3
  let { IMP_CONJ, INSERT_SUBSET, .. } := D.core4
  let { IN_ELIM_THM, I_DEF, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MEMBER_NOT_EMPTY, MONO_AND, PAIR, PAIR_EQ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, UNIONS_GSPEC, .. } := D.core7
  let { RING_0, RING_1, RING_ADD, RING_ADD_ASSOC, RING_ADD_LDISTRIB, RING_ADD_LNEG,
        RING_ADD_LZERO, RING_ADD_SYM, RING_MUL, RING_MUL_ASSOC, RING_MUL_LID,
        RING_MUL_RID, RING_MUL_SYM, RING_NEG, RING_SUB, ring_0, ring_1, ring_add,
        ring_carrier, ring_mul, ring_neg, ring_tybij, .. } := BBasics
  let { RING_OF_INT, RING_OF_NUM, RING_POW, .. } := BNumbers
  let { RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_ADD,
        RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_NEG, RING_HOMOMORPHISM_POW,
        RING_HOMOMORPHISM_RING_OF_INT, RING_HOMOMORPHISM_RING_OF_NUM,
        RING_HOMOMORPHISM_SUB, ring_homomorphism, ring_monomorphism, .. } := BHoms
  -- @@SCOPE END

  let RING_DIRECT_LIMIT ← prove
   r"!c:(A ring->bool).
        ~(c = {}) /\
        (!r r'. r IN c /\ r' IN c
                ==> ?R. R IN c /\
                        ring_monomorphism(r,R) I /\
                        ring_monomorphism(r',R) I)
        ==> ?R. ring_carrier R = UNIONS {ring_carrier r | r IN c} /\
                !r. r IN c ==> ring_monomorphism(r,R) I"
   (← do
    -- OCaml evaluates the two SET_RULE calls in reverse text order.
    let s2 ← SET_RULE (← q r"{f x | x IN s} = {} <=> s = {}")
    let s1 ← SET_RULE (← q r"x IN s /\ y IN s <=> {x,y} SUBSET s")
    pure (REPEAT STRIP_TAC THEN
    MAP_EVERY ABBREV_TAC
     [← q r"r0:A = let r = @r. r IN c in ring_0 r",
      ← q r"r1:A = let r = @r. r IN c in ring_1 r",
      ← q r"neg = \x:A. let r = @r. r IN c /\ x IN ring_carrier r in
                 ring_neg r x",
      ← q r"add = \x y:A.
            let r = @r. r IN c /\ x IN ring_carrier r /\ y IN ring_carrier r in
            ring_add r x y",
      ← q r"mul = \x y:A.
            let r = @r. r IN c /\ x IN ring_carrier r /\ y IN ring_carrier r in
            ring_mul r x y"] THEN
    SUBGOAL_THEN
     (← q r"(!r. r IN c ==> r0:A = ring_0 r) /\
    (!r. r IN c ==> r1 = ring_1 r) /\
    (!r x. r IN c /\ x IN ring_carrier r ==> neg x = ring_neg r x) /\
    (!r x y. r IN c /\ x IN ring_carrier r /\ y IN ring_carrier r
              ==> add x y = ring_add r x y) /\
    (!r x y. r IN c /\ x IN ring_carrier r /\ y IN ring_carrier r
              ==> mul x y = ring_mul r x y)")
    MP_TAC THENL
     [FIRST_ASSUM (MP_TAC o check (fun th => is_forall (concl th))) THEN
      REWRITE_TAC [ring_monomorphism, ring_homomorphism, IMAGE_ID, I_DEF] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      MAP_EVERY EXPAND_TAC ["r0", "r1", "neg", "add", "mul"] THEN
      CONV_TAC (ONCE_DEPTH_CONV let_CONV) THEN MESON_TAC [],
      REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
        let _ ← SYM (← SYM th); pure ALL_TAC)) THEN STRIP_TAC] THEN
    ABBREV_TAC (← q r"R = ring(UNIONS {ring_carrier r:A->bool | r IN c},
                       r0,r1,neg,add,mul)") THEN
    SUBGOAL_THEN
     (← q r"ring_carrier R = UNIONS {ring_carrier r | r IN c} /\
    ring_0 R:A = r0 /\
    ring_1 R = r1 /\
    ring_neg R = neg /\
    ring_add R = add /\
    ring_mul R = mul")
    MP_TAC THENL
     [GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o RATOR_CONV) [ring_carrier] THEN
      REWRITE_TAC [ring_0, ring_1, ring_neg, ring_add, ring_mul] THEN
      REWRITE_TAC [PAIR, ← GSYM PAIR_EQ] THEN EXPAND_TAC "R" THEN
      REWRITE_TAC [← GSYM (← CONJUNCT2 ring_tybij)] THEN
      REWRITE_TAC [s1] THEN
      REWRITE_TAC [← GSYM INSERT_SUBSET] THEN
      MP_TAC (← ISPEC (← q r"{ring_carrier r:A->bool | r IN c}")
          FINITE_SUBSET_UNIONS_DIRECTED_EQ) THEN
      ASM_REWRITE_TAC [s2] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE
          [ring_monomorphism, ring_homomorphism, IMAGE_I]) THEN
        ASM_MESON_TAC [],
        SIMP_TAC [FINITE_INSERT, FINITE_EMPTY] THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
        REWRITE_TAC [INSERT_SUBSET, EXISTS_IN_GSPEC,
                     UNIONS_GSPEC, EMPTY_SUBSET]] THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      ASM_SIMP_TAC [RING_ADD, RING_MUL, RING_0, RING_1, RING_NEG] THEN
      ASM_SIMP_TAC [RING_ADD_ASSOC, RING_ADD_LDISTRIB, RING_MUL_RID,
        RING_MUL_ASSOC, RING_ADD_LNEG, RING_MUL_LID, RING_ADD_LZERO] THEN
      ASM_MESON_TAC [MEMBER_NOT_EMPTY, RING_0, RING_1, RING_NEG, RING_ADD,
                     RING_MUL, RING_MUL_SYM, RING_ADD_SYM],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (REPEAT_TCL CONJUNCTS_THEN (SUBST_ALL_TAC o SYM))) THEN
      EXISTS_TAC (← q "R:A ring") THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [ring_monomorphism, ring_homomorphism, IMAGE_ID, I_DEF] THEN
      ASM SET_TAC []]))

  let RING_MONOMORPHIC_IMAGE_RULE : thm → ExceptT String IO (term → ExceptT String IO thm) ← do
    let pth ← prove
     r"!r r' (f:A->B).
          ring_monomorphism(r,r') f
          ==> (!x x' y y'.
                  (x IN ring_carrier r /\ f x = x') /\
                  (y IN ring_carrier r /\ f y = y')
                  ==> (x = y <=> x' = y')) /\
              (!x. x IN ring_carrier r
                   ==> x IN ring_carrier r /\ f x = f x) /\
              (ring_0 r IN ring_carrier r /\ f(ring_0 r) = ring_0 r') /\
              (ring_1 r IN ring_carrier r /\ f(ring_1 r) = ring_1 r') /\
              (!n. ring_of_num r n IN ring_carrier r /\
                   f(ring_of_num r n) = ring_of_num r' n) /\
              (!n. ring_of_int r n IN ring_carrier r /\
                   f(ring_of_int r n) = ring_of_int r' n) /\
              (!x x'. x IN ring_carrier r /\ f x = x'
                      ==> ring_neg r x IN ring_carrier r /\
                          f(ring_neg r x) = ring_neg r' x') /\
              (!n x x'.
                  x IN ring_carrier r /\ f x = x'
                  ==> ring_pow r x n IN ring_carrier r /\
                      f(ring_pow r x n) = ring_pow r' x' n) /\
              (!x x' y y'.
                  (x IN ring_carrier r /\ f x = x') /\
                  (y IN ring_carrier r /\ f y = y')
                  ==> ring_add r x y IN ring_carrier r /\
                      f(ring_add r x y) = ring_add r' x' y') /\
              (!x x' y y'.
                  (x IN ring_carrier r /\ f x = x') /\
                  (y IN ring_carrier r /\ f y = y')
                  ==> ring_sub r x y IN ring_carrier r /\
                      f(ring_sub r x y) = ring_sub r' x' y') /\
              (!x x' y y'.
                  (x IN ring_carrier r /\ f x = x') /\
                  (y IN ring_carrier r /\ f y = y')
                  ==> ring_mul r x y IN ring_carrier r /\
                      f(ring_mul r x y) = ring_mul r' x' y')"
     (REPEAT GEN_TAC THEN REWRITE_TAC [ring_monomorphism] THEN
      GEN_REWRITE_TAC LAND_CONV [CONJ_SYM] THEN MATCH_MP_TAC MONO_AND THEN
      CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      MESON_TAC [RING_0, RING_1, RING_OF_NUM, RING_OF_INT, RING_NEG,
                 RING_POW, RING_ADD, RING_SUB, RING_MUL,
                 RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1,
                 RING_HOMOMORPHISM_RING_OF_NUM, RING_HOMOMORPHISM_RING_OF_INT,
                 RING_HOMOMORPHISM_NEG, RING_HOMOMORPHISM_POW,
                 RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_SUB,
                 RING_HOMOMORPHISM_MUL])
    pure fun hth => do
      -- `let ... and htm = rand(concl hth)`: htm is unused.
      match ← splitConjPair (← MATCH_MP pth hth) with
      | ([pth_eq, pth_asm, pth_0, pth_1, pth_num, pth_int, pth_neg, pth_pow,
          pth_add, pth_sub], pth_mul) =>
        let _htm ← liftExcept (rand (concl hth))
        let P : MonoImageThms := ⟨pth_eq, pth_asm, pth_0, pth_1, pth_num, pth_int,
          pth_neg, pth_pow, pth_add, pth_sub, pth_mul⟩
        pure fun tm => monoImageMform P tm
      | _ => throw "Match_failure"

  -- @@RETURN BEGIN
  return { RING_DIRECT_LIMIT, RING_MONOMORPHIC_IMAGE_RULE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- A decision procedure for the universal theory of rings; a naive tactic   -/
/- form.  (ringtheory.ml 8418-8640)                                          -/
/- ------------------------------------------------------------------------- -/

structure RingRule where
  -- @@FIELDS
  RING_RULE : term → ExceptT String IO thm
  RING_TAC : tactic
  deriving Inhabited

@[nospecialize]
def setupRingRule [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BRules : Rules) (BHoms : Homs) (BIso : Iso) (BProdRings : ProdRings) (BLimits : Limits) :
    ExceptT String IO RingRule := do
  -- @@SCOPE BEGIN
  let { CNF_CONV, CONDS_ELIM_CONV, DISJ_ACI_RULE, NNFC_CONV, NUM_REDUCE_CONV,
        PRENEX_CONV, PRESIMP_CONV, SKOLEM_CONV, .. } := D
  let { CARD_BOOL, CARD_CLAUSES, CARD_EXP_ABSORB, CARD_EXP_CANTOR, CARD_EXP_UNIV,
        CARD_LE_CARD, CARD_LE_SUBSET, CARD_LE_TRANS, CARD_LT_IMP_LE,
        CARD_MUL_FINITE_EQ, CARTESIAN_PRODUCT_CONST, .. } := D.core1
  let { CONJ_ASSOC, DE_MORGAN_THM, DISJ_ASSOC, EMPTY_SUBSET, EXTENSION, .. } := D.core2
  let { FINITE_BOOL, FINITE_EMPTY, FINITE_INSERT, FORALL_ONE_THM, IMAGE_CONST, .. } := D.core3
  let { IMP_IMP, INFINITE, INSERT_SUBSET, .. } := D.core4
  let { IN_INSERT, IN_SING, IN_UNIV, LEFT_AND_EXISTS_THM, LEFT_FORALL_IMP_THM, .. } := D.core5
  let { MONO_EXISTS, MUL_C_UNIV, NOT_IN_EMPTY, PAIR_EQ, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, SUBSET_UNIV, UNIV_NOT_EMPTY, .. } := D.core7
  let { le_c, num_INFINITE, .. } := D.core8
  let { RING_0, RING_1, RING_ADD_RZERO, RING_CARRIER_NONEMPTY, RING_MUL_RZERO,
        RING_SUB_EQ_0, SINGLETON_RING, TRIVIAL_RING_10, TRIVIAL_RING_SINGLETON_RING, .. } := BBasics
  let { RING_OF_INT_OF_NUM, RING_OF_NUM_0, RING_OF_NUM_1, .. } := BNumbers
  let { RING_POLY_UNIVERSAL_CONV, ring_ring_cofactors_universal, .. } := BRules
  let { RING_HOMOMORPHISM_FROM_TRIVIAL_RING, RING_ISOMORPHISM_IMP_MONOMORPHISM,
        RING_MONOMORPHISM_COMPOSE, RING_MONOMORPHISM_FROM_TRIVIAL_RING, .. } := BHoms
  let { ISOMORPHIC_COPY_OF_RING, isomorphic_ring, .. } := BIso
  let { PRODUCT_RING, RING_MONOMORPHISM_DIAGONAL_UNIV, .. } := BProdRings
  let { RING_MONOMORPHIC_IMAGE_RULE, .. } := BLimits
  -- @@SCOPE END

  let RING_RULE : term → ExceptT String IO thm ← do
    let RING_TOTALIZATION ← prove
     r"!r:A ring.
          (?r' f. ring_carrier r' = (:1) /\
                  ring_monomorphism(r,r') f) \/
          (?r' f. ring_carrier r' = (:num#A->bool) /\
                  ring_monomorphism(r,r') f)"
     (← do
      let lemma ← prove
       r"!r:A ring.
            ~(trivial_ring r) /\ INFINITE(:B) /\ (:A) <=_c (:B)
            ==> ring_carrier(product_ring (:B) (\i. r)) =_c (:B->bool)"
       (REPEAT STRIP_TAC THEN REWRITE_TAC [PRODUCT_RING] THEN
        REWRITE_TAC [CARTESIAN_PRODUCT_CONST, ← GSYM CARD_EXP_UNIV] THEN
        MATCH_MP_TAC CARD_EXP_ABSORB THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [TRANS_TAC CARD_LE_TRANS (← q r"{ring_0 r:A,ring_1 r:A}") THEN
          CONJ_TAC THENL
           [SIMP_TAC [CARD_LE_CARD, FINITE_INSERT, FINITE_EMPTY, FINITE_BOOL,
                      CARD_BOOL, CARD_CLAUSES] THEN
            RULE_ASSUM_TAC (REWRITE_RULE [TRIVIAL_RING_10]) THEN
            ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
            CONV_TAC NUM_REDUCE_CONV,
            MATCH_MP_TAC CARD_LE_SUBSET THEN
            REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, RING_0, RING_1]],
          TRANS_TAC CARD_LE_TRANS (← q "(:A)") THEN
          ASM_SIMP_TAC [CARD_LE_SUBSET, SUBSET_UNIV] THEN
          TRANS_TAC CARD_LE_TRANS (← q "(:B)") THEN ASM_REWRITE_TAC [] THEN
          SIMP_TAC [CARD_EXP_CANTOR, CARD_LT_IMP_LE]])
      pure (GEN_TAC THEN ASM_CASES_TAC (← q "trivial_ring(r:A ring)") THENL
       [DISJ1_TAC THEN EXISTS_TAC (← q "singleton_ring one") THEN
        EXISTS_TAC (← q r"(\x. one):A->1") THEN
        ASM_SIMP_TAC [RING_MONOMORPHISM_FROM_TRIVIAL_RING,
                      RING_HOMOMORPHISM_FROM_TRIVIAL_RING] THEN
        ASM_SIMP_TAC [TRIVIAL_RING_SINGLETON_RING, SINGLETON_RING] THEN
        REWRITE_TAC [IMAGE_CONST, RING_CARRIER_NONEMPTY] THEN
        REWRITE_TAC [EXTENSION, IN_UNIV, IN_SING, FORALL_ONE_THM],
        DISJ2_TAC] THEN
      MP_TAC (← EQ_IMP_RULE (← ISPECL
       [← q r"product_ring (:num#A) (\i. (r:A ring))", ← q r"(:num#A->bool)"]
       ISOMORPHIC_COPY_OF_RING)).2 THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC lemma THEN
        ASM_REWRITE_TAC [← GSYM MUL_C_UNIV, INFINITE, CARD_MUL_FINITE_EQ] THEN
        REWRITE_TAC [UNIV_NOT_EMPTY, DE_MORGAN_THM, ← GSYM INFINITE] THEN
        REWRITE_TAC [num_INFINITE, MUL_C_UNIV] THEN
        REWRITE_TAC [le_c] THEN EXISTS_TAC (← q r"\x:A. 0,x") THEN
        REWRITE_TAC [IN_UNIV, PAIR_EQ],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r':(num#A->bool)ring") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [isomorphic_ring]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"f:(num#A->A)->num#A->bool")) THEN
      EXISTS_TAC (← q r"(f:(num#A->A)->num#A->bool) o (\x i. x)") THEN
      MATCH_MP_TAC RING_MONOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"product_ring (:num#A) (\i. (r:A ring))") THEN
      REWRITE_TAC [RING_MONOMORPHISM_DIAGONAL_UNIV] THEN
      ASM_SIMP_TAC [RING_ISOMORPHISM_IMP_MONOMORPHISM]))
    -- RING_WORD_UNIVERSAL: `let cth = ... and pth = ... and bth = ...
    -- and mth = ... and dth = ...`, left to right
    let cth ← prove
     r"ring_0 r = ring_of_int r (&0) /\
       ring_1 r = ring_of_int r (&1)"
     (REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_0, RING_OF_NUM_1])
    let pth ← UNDISCH (← prove
     r"ring_carrier r = (:A)
       ==> (x = y <=> ring_sub r x y = ring_of_int r (&0))"
     (SIMP_TAC [RING_SUB_EQ_0, IN_UNIV, RING_OF_INT_OF_NUM, RING_OF_NUM_0]))
    let bth := REFL (← q "ring_of_int r (&0):A")
    let mth ← UNDISCH (← prove
     r"ring_carrier r = (:A)
       ==> p = ring_of_int r (&0) ==> !c. ring_mul r c p = ring_of_int r (&0)"
     (SIMP_TAC [RING_MUL_RZERO, RING_OF_INT_OF_NUM, RING_OF_NUM_0, IN_UNIV]))
    let dth ← UNDISCH (← prove
     r"ring_carrier r = (:A)
       ==> p = ring_of_int r (&0) /\ q = ring_of_int r (&0)
           ==> ring_add r p q = ring_of_int r (&0)"
     (SIMP_TAC [RING_ADD_RZERO, RING_OF_INT_OF_NUM, RING_OF_NUM_0, IN_UNIV]))
    let gOfInt ← GSYM RING_OF_INT_OF_NUM
    let decorule (tm : term) : ExceptT String IO thm := do
      GEN_REWRITE_RULE (RAND_CONV o ONCE_DEPTH_CONV) [cth, gOfInt]
        (← PART_MATCH lhand pth tm)
    -- RING_RING_WORD: `let imp_imp_rule = ... and left_exists_rule = ...
    -- and or_elim_rule = ...`, left to right
    let orTaut ← TAUT (← q r"(p ==> q) /\ (p' ==> q) <=> p \/ p' ==> q")
    -- RING_RING_HORN's ddj_conv: the arguments of THENC right to left
    let ddjB ← TAUT (← q r"p \/ ~q <=> q ==> p")
    let ddjA ← TAUT (← q r"~p \/ ~q <=> ~(p /\ q)")
    let ddj_conv : ioconv :=
      GEN_REWRITE_CONV (RAND_CONV o DEPTH_CONV) [ddjA] THENC
      GEN_REWRITE_CONV id [ddjB]
    -- RING_RING_CORE: `let pth = TAUT ... and ptm = ... and qtm = ...`
    let core_pth ← TAUT (← q r"p ==> q <=> (p \/ q <=> q)")
    let ptm ← q "p:bool"
    let qtm ← q "q:bool"
    -- init_conv, and true_tm
    let gDisjAssoc ← GSYM DISJ_ASSOC
    let gConjAssoc ← GSYM CONJ_ASSOC
    let init_conv : ioconv :=
      TOP_DEPTH_CONV BETA_CONV THENC
      PRESIMP_CONV THENC
      CONDS_ELIM_CONV THENC
      NNFC_CONV THENC CNF_CONV THENC
      SKOLEM_CONV THENC PRENEX_CONV THENC
      GEN_REWRITE_CONV REDEPTH_CONV
       [RIGHT_AND_EXISTS_THM, LEFT_AND_EXISTS_THM] THENC
      GEN_REWRITE_CONV TOP_DEPTH_CONV [gDisjAssoc] THENC
      GEN_REWRITE_CONV TOP_DEPTH_CONV [gConjAssoc]
    let true_tm ← q "T"
    let C : RingRuleCtx := {
      RING_TOTALIZATION, bth, mth, dth, decorule,
      RING_POLY_UNIVERSAL_CONV, ring_ring_cofactors_universal,
      imp_imp_rule := GEN_REWRITE_RULE id [IMP_IMP],
      left_exists_rule := GEN_REWRITE_RULE id [LEFT_FORALL_IMP_THM],
      or_elim_rule := GEN_REWRITE_RULE id [orTaut],
      RING_MONOMORPHIC_IMAGE_RULE, ddj_conv, core_pth, ptm, qtm,
      DISJ_ACI_RULE, init_conv, true_tm }
    pure (ringRule C)

  let RING_TAC : tactic ← pure (
    REPEAT GEN_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o check (fun th => is_eq (concl th)))) THEN
    W (fun (_asl, w) => tactic_of do
          let th ← RING_RULE w
          pure (MATCH_ACCEPT_TAC th ORELSE
           ((fun g => MATCH_MP_TAC th g) THEN ASM_REWRITE_TAC []))))

  -- @@RETURN BEGIN
  return { RING_RULE, RING_TAC }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Cosets in a ring.  (ringtheory.ml 8643-9054)                              -/
/- ------------------------------------------------------------------------- -/

structure Cosets where
  -- @@FIELDS
  ring_coset : thm
  RING_COSET_SETADD : thm
  RING_COSET : thm
  RING_COSET_0 : thm
  RING_COSET_TRIVIAL : thm
  RING_COSET_CARRIER : thm
  RING_COSET_EQ : thm
  RING_COSET_EQ_IDEAL : thm
  RING_COSET_EQ_EMPTY : thm
  RING_COSET_NONEMPTY : thm
  IN_RING_COSET_SELF : thm
  UNIONS_RING_COSETS : thm
  RING_COSETS_EQ : thm
  IN_RING_COSET : thm
  RING_COSET_RELATIONAL : thm
  DISJOINT_RING_COSETS : thm
  PAIRWISE_DISJOINT_RING_COSETS : thm
  IMAGE_RING_COSET_SWITCH : thm
  CARD_EQ_RING_COSETS : thm
  CARD_EQ_RING_COSET_IDEAL : thm
  LAGRANGE_THEOREM_RING_EXPLICIT : thm
  LAGRANGE_THEOREM_RING : thm
  PRIME_SUBRING_FINITE : thm
  HAS_SIZE_PRIME_SUBRING : thm
  CARD_PRIME_SUBRING : thm
  FINITE_PRIME_SUBRING : thm
  RING_CHAR_DIVIDES_ORDER : thm
  CARD_DIVIDES_RING_MONOMORPHIC_IMAGE : thm
  CARD_DIVIDES_RING_EPIMORPHIC_IMAGE : thm
  CARD_RING_COSETS_DIVIDES : thm
  RING_SETADD_PROD_RING : thm
  RING_COSET_PROD_RING : thm
  RING_SETADD_PRODUCT_RING : thm
  RING_COSET_PRODUCT_RING : thm
  RING_SETNEG_SUBRING_GENERATED : thm
  RING_SETADD_SUBRING_GENERATED : thm
  RING_SETNEG_COSET : thm
  RING_SETADD_COSETS : thm
  RING_SETMUL_COSETS : thm
  RING_COSET_IDEAL_GENERATED_SING : thm
  RING_COSET_IDEAL_GENERATED_SING_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupCosets [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BSubrings : Subrings) (BIdeals : Ideals) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BProdRings : ProdRings) (BRingRule : RingRule) :
    ExceptT String IO Cosets := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INTEGER_RULE, MESON_TAC, NUMBER_RULE, NUMBER_TAC, SET_RULE,
        SET_TAC, new_definition, .. } := D
  let { CARD_CROSS, CARD_EQ_CARD_IMP, CARD_UNIONS, CARTESIAN_PRODUCT_AS_RESTRICTIONS,
        CARTESIAN_PRODUCT_SINGS_GEN, .. } := D.core1
  let { CONG, CONTRAPOS_THM, CROSS, CROSS_SING, DISJOINT, DISJOINT_EMPTY_REFL,
        EQ_SYM_EQ, EQ_TRANS, .. } := D.core2
  let { FINITE_CROSS, FINITE_IMAGE, FINITE_RESTRICT, FINITE_SUBSET, FORALL_AND_THM,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_UNWIND_THM2, FUN_EQ_THM, HAS_SIZE,
        HAS_SIZE_IMAGE_INJ, HAS_SIZE_NUMSEG_LT, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IN, INFINITE, INFINITE_IMAGE, INJECTIVE_ON_ALT,
        INT_EXISTS_POS, INT_LT_REM_EQ, INT_OF_NUM_CLAUSES, INT_OF_NUM_LT, .. } := D.core4
  let { INT_REM_POS_EQ, IN_ELIM_THM, IN_GSPEC, IN_IMAGE, IN_SING, IN_UNIV,
        LEFT_AND_EXISTS_THM, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, LE_1, .. } := D.core5
  let { MOD_LT, MONO_EXISTS, NOT_INSERT_EMPTY, NSUM_CONST, NSUM_EQ, PAIRWISE_IMAGE, .. } := D.core6
  let { RESTRICTION, RESTRICTION_EXTENSION, RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SING_SUBSET, SKOLEM_THM,
        SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, UNIONS_GSPEC, UNIONS_SUBSET, .. } := D.core7
  let { divides, eq_c, int_INFINITE, mul_c, pairwise, .. } := D.core8
  let { RING_0, RING_ADD, RING_ADD_ASSOC, RING_ADD_LCANCEL, RING_ADD_LNEG,
        RING_ADD_RNEG, RING_ADD_RZERO, RING_ADD_SYM, RING_MUL, RING_NEG, RING_NEG_ADD,
        RING_NEG_NEG, RING_SUB, ring_sub, .. } := BBasics
  let { RING_CHAR_FINITE, RING_OF_INT_EQ, RING_OF_INT_OF_NUM, RING_OF_INT_REM,
        RING_OF_NUM_EQ, .. } := BNumbers
  let { ring_divides, .. } := BDivides
  let { IN_SUBRING_NEG, PRIME_SUBRING, SUBRING_GENERATED, SUBRING_OF_IMP_NONEMPTY,
        SUBRING_OF_IMP_SUBSET, subring_of, .. } := BSubrings
  let { IDEAL_GENERATED_SING, IN_RING_IDEAL_NEG, RING_IDEAL_CARRIER,
        RING_IDEAL_IDEAL_GENERATED, RING_IDEAL_IMP_NONEMPTY, RING_IDEAL_IMP_SUBSET,
        RING_SETADD, RING_SETADD_ASSOC, RING_SETADD_EQ_EMPTY, RING_SETADD_IDEAL_RIGHT,
        RING_SETADD_LSUBSET, RING_SETADD_LSUBSET_EQ, RING_SETADD_LZERO,
        RING_SETADD_RCANCEL_SET, RING_SETADD_SING, RING_SETMUL_IDEAL_RIGHT,
        RING_SETMUL_SING, ring_ideal, ring_setadd, ring_setneg, .. } := BIdeals
  let { ring_monomorphism, .. } := BHoms
  let { CARD_EQ_RING_MONOMORPHIC_IMAGE, FINITE_RING_MONOMORPHIC_PREIMAGE, .. } := BIso
  let { CARD_EQ_RING_IMAGE_KERNEL, RING_EPIMORPHISM, SUBRING_RING_IMAGE, ring_image,
        ring_kernel, .. } := BKernels
  let { PRODUCT_RING, PROD_RING, .. } := BProdRings
  let { RING_TAC, .. } := BRingRule
  -- @@SCOPE END

  let ring_coset ← new_definition
   r"ring_coset (r:A ring) j = \a. {ring_add r a x | x IN j}"

  let RING_COSET_SETADD ← prove
   r"!r s a:A. ring_coset r s a = ring_setadd r {a} s"
   (REWRITE_TAC [ring_setadd, ring_coset] THEN SET_TAC [])

  let RING_COSET ← prove
   r"!r t x:A.
        x IN ring_carrier r /\ t SUBSET ring_carrier r
        ==> ring_coset r t x SUBSET ring_carrier r"
   (SIMP_TAC [RING_COSET_SETADD, RING_SETADD, SING_SUBSET])

  let RING_COSET_0 ← prove
   r"!r t:A->bool.
        t SUBSET ring_carrier r ==> ring_coset r t (ring_0 r) = t"
   (SIMP_TAC [RING_COSET_SETADD, RING_SETADD_LZERO])

  let RING_COSET_TRIVIAL ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_coset r {ring_0 r} x = {x}"
   (SIMP_TAC [RING_COSET_SETADD, RING_SETADD_SING, RING_0, RING_ADD_RZERO])

  let RING_COSET_CARRIER ← prove
   r"!r x:A. x IN ring_carrier r
           ==> ring_coset r (ring_carrier r) x = ring_carrier r"
   (SIMP_TAC [RING_COSET_SETADD, RING_SETADD_LSUBSET, SING_SUBSET,
              NOT_INSERT_EMPTY, RING_IDEAL_CARRIER])

  let RING_COSET_EQ ← prove
   r"!r j x y:A.
        (ring_ideal r j \/ j subring_of r) /\
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_coset r j x = ring_coset r j y <=> ring_sub r x y IN j)"
   (SIMP_TAC [RING_SETADD_RCANCEL_SET, RING_COSET_SETADD])

  let RING_COSET_EQ_IDEAL ← prove
   r"!r j x:A.
        (ring_ideal r j \/ j subring_of r) /\ x IN ring_carrier r
        ==> (ring_coset r j x = j <=> x IN j)"
   (SIMP_TAC [RING_COSET_SETADD, RING_SETADD_LSUBSET_EQ, SING_SUBSET] THEN
    REWRITE_TAC [NOT_INSERT_EMPTY])

  let RING_COSET_EQ_EMPTY ← prove
   r"!r j x:A. ring_coset r j x = {} <=> j = {}"
   (REWRITE_TAC [RING_COSET_SETADD, RING_SETADD_EQ_EMPTY, NOT_INSERT_EMPTY])

  let RING_COSET_NONEMPTY ← prove
   r"!r j x:A. ring_ideal r j \/ j subring_of r ==> ~(ring_coset r j x = {})"
   (MESON_TAC [RING_COSET_EQ_EMPTY, SUBRING_OF_IMP_NONEMPTY,
               RING_IDEAL_IMP_NONEMPTY])

  let IN_RING_COSET_SELF ← prove
   r"!r j x:A.
      (ring_ideal r j \/ j subring_of r) /\ x IN ring_carrier r
      ==> x IN ring_coset r j x"
   (REWRITE_TAC [ring_ideal, subring_of, RING_COSET_SETADD, ring_setadd,
                 IN_ELIM_THM, IN_SING] THEN
    MESON_TAC [RING_ADD_RZERO])

  let UNIONS_RING_COSETS ← prove
   r"!r j:A->bool.
        ring_ideal r j \/ j subring_of r
        ==> UNIONS {ring_coset r j x |x| x IN ring_carrier r} =
            ring_carrier r"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [RING_COSET, RING_IDEAL_IMP_SUBSET, SUBRING_OF_IMP_SUBSET] THEN
    REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, SUBSET] THEN
    ASM_MESON_TAC [IN_RING_COSET_SELF])

  let RING_COSETS_EQ ← prove
   r"!r j x y:A.
        (ring_ideal r j \/ j subring_of r) /\
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_coset r j x = ring_coset r j y <=>
             ~(DISJOINT (ring_coset r j x) (ring_coset r j y)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [← GSYM DISJOINT_EMPTY_REFL, RING_COSET_NONEMPTY] THEN
    ASM_SIMP_TAC [RING_COSET_EQ, LEFT_IMP_EXISTS_THM, IMP_CONJ, ← SET_RULE
     (← q r"~DISJOINT s t <=> ?x. x IN s /\ ?y. y IN t /\ x = y")] THEN
    REWRITE_TAC [RING_COSET_SETADD, ring_setadd, FORALL_IN_GSPEC, IN_SING] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2] THEN
    X_GEN_TAC (← q "u:A") THEN DISCH_TAC THEN X_GEN_TAC (← q "v:A") THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"\x:A. ring_sub r x u")) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_ideal, subring_of, SUBSET]) THEN
    REWRITE_TAC [ring_sub] THEN
    ASM_SIMP_TAC [← GSYM RING_ADD_ASSOC, RING_ADD_RNEG, RING_ADD_RZERO] THEN
    DISCH_THEN SUBST1_TAC THEN
    wPart lhand (fun t => do lhand (← rand t)) RING_ADD_SYM THEN
    (ANTS_TAC THENL
     [ASM_MESON_TAC [RING_ADD, RING_NEG], DISCH_THEN SUBST1_TAC]) THEN
    ASM_SIMP_TAC [RING_ADD_ASSOC, RING_SUB, RING_ADD, RING_NEG, RING_ADD_LNEG])

  let IN_RING_COSET ← prove
   r"!r j x y:A.
        (ring_ideal r j \/ j subring_of r) /\
        x IN ring_carrier r /\
        y IN ring_carrier r
        ==> (x IN ring_coset r j y <=>
             ring_coset r j x = ring_coset r j y)"
   (MESON_TAC [IN_RING_COSET_SELF, RING_COSETS_EQ,
               ← SET_RULE (← q r"~(DISJOINT s t) <=> ?a. a IN s /\ a IN t")])

  let RING_COSET_RELATIONAL ← prove
   r"!r j x y:A.
           (ring_ideal r j \/ j subring_of r) /\
           x IN ring_carrier r /\
           y IN ring_carrier r
           ==> (ring_coset r j x y <=> ring_coset r j x = ring_coset r j y)"
   (MESON_TAC [IN_RING_COSET, IN])

  let DISJOINT_RING_COSETS ← prove
   r"!r j x y:A.
        (ring_ideal r j \/ j subring_of r) /\
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (DISJOINT (ring_coset r j x) (ring_coset r j y) <=>
             ~(ring_coset r j x = ring_coset r j y))"
   (SIMP_TAC [RING_COSETS_EQ])

  let PAIRWISE_DISJOINT_RING_COSETS ← prove
   r"!r j:A->bool.
        ring_ideal r j \/ j subring_of r
        ==> pairwise DISJOINT {ring_coset r j x |x| x IN ring_carrier r}"
   (REWRITE_TAC [SIMPLE_IMAGE, PAIRWISE_IMAGE] THEN
    SIMP_TAC [pairwise, DISJOINT_RING_COSETS])

  let IMAGE_RING_COSET_SWITCH ← prove
   r"!r j x y:A.
        (ring_ideal r j \/ j subring_of r) /\
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> IMAGE (\a. ring_add r (ring_sub r y x) a)
                  (ring_coset r j x) =
            ring_coset r j y"
   (REPEAT STRIP_TAC THEN TRANS_TAC EQ_TRANS
     (← q r"ring_setadd r {ring_sub r y x:A} (ring_coset r j x)") THEN
    (CONJ_TAC THENL [REWRITE_TAC [ring_setadd] THEN SET_TAC [], ALL_TAC]) THENL
     [FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_IDEAL_IMP_SUBSET),
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBRING_OF_IMP_SUBSET)] THEN
    REWRITE_TAC [RING_COSET_SETADD, ring_sub] THEN
    ASM_SIMP_TAC [RING_SETADD_ASSOC, RING_SETADD, SING_SUBSET,
                  RING_ADD, RING_NEG, RING_SETADD_SING, ← GSYM RING_ADD_ASSOC,
                  RING_ADD_LNEG, RING_ADD_RZERO])

  let CARD_EQ_RING_COSETS ← prove
   r"!r j x y:A.
        (ring_ideal r j \/ j subring_of r) /\
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_coset r j x =_c ring_coset r j y"
   (← do
    let lemma ← prove
     r"!f g. (IMAGE f s = t /\ IMAGE g t = s) /\
           (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
     ==> s =_c t"
     (REWRITE_TAC [eq_c, LEFT_FORALL_IMP_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [])
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma THEN
      EXISTS_TAC (← q r"\a:A. ring_add r (ring_sub r y x) a") THEN
      EXISTS_TAC (← q r"\a:A. ring_add r (ring_sub r x y) a") THEN
      ASM_SIMP_TAC [IMAGE_RING_COSET_SWITCH, INJECTIVE_ON_ALT] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_ADD_LCANCEL THEN
      ASM_MESON_TAC [RING_SUB, SUBSET, RING_COSET,
                     SUBRING_OF_IMP_SUBSET, RING_IDEAL_IMP_SUBSET]))

  let CARD_EQ_RING_COSET_IDEAL ← prove
   r"!r j x:A.
        (ring_ideal r j \/ j subring_of r) /\
        x IN ring_carrier r
        ==> ring_coset r j x =_c j"
   (MESON_TAC [CARD_EQ_RING_COSETS, RING_0, RING_COSET_0,
               SUBRING_OF_IMP_SUBSET, RING_IDEAL_IMP_SUBSET])

  let LAGRANGE_THEOREM_RING_EXPLICIT ← prove
   r"!r j:A->bool.
        FINITE(ring_carrier r) /\
        (ring_ideal r j \/ j subring_of r)
        ==> CARD {ring_coset r j x |x| x IN ring_carrier r} * CARD j =
            CARD(ring_carrier r)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"FINITE(j:A->bool)") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_SUBSET, ring_ideal, subring_of], ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (RAND_CONV o RAND_CONV)
        [← SYM (← MATCH_MP UNIONS_RING_COSETS th)])) THEN
    wPart rand (fun t => do lhand (← rand t)) CARD_UNIONS THEN
    ASM_REWRITE_TAC [SIMPLE_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, FINITE_IMAGE] THEN
    ASM_SIMP_TAC [← GSYM DISJOINT, DISJOINT_RING_COSETS] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [FINITE_SUBSET, RING_COSET, ring_ideal, subring_of],
      DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [← GSYM NSUM_CONST, FINITE_IMAGE] THEN
    MATCH_MP_TAC NSUM_EQ THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
    REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC CARD_EQ_CARD_IMP THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [CARD_EQ_RING_COSET_IDEAL])

  let LAGRANGE_THEOREM_RING ← prove
   r"!r j:A->bool.
        FINITE(ring_carrier r) /\
        (ring_ideal r j \/ j subring_of r)
        ==> (CARD j) divides CARD(ring_carrier r)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (SUBST1_TAC o SYM o MATCH_MP LAGRANGE_THEOREM_RING_EXPLICIT) THEN
    NUMBER_TAC)

  let PRIME_SUBRING_FINITE ← prove
   r"!r:A ring.
        ~(ring_char r = 0)
        ==> { ring_of_int r x | x IN (:int) } =
            { ring_of_num r n | n |  n < ring_char r }"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    CONJ_TAC THENL [ALL_TAC, SET_TAC [RING_OF_INT_OF_NUM]] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_UNIV] THEN
    X_GEN_TAC (← q "n:int") THEN
    REWRITE_TAC [IN_IMAGE, ← GSYM RING_OF_INT_OF_NUM] THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM INT_OF_NUM_LT, INT_EXISTS_POS] THEN
    EXISTS_TAC (← q "n rem &(ring_char(r:A ring))") THEN
    REWRITE_TAC [RING_OF_INT_REM, INT_REM_POS_EQ, INT_LT_REM_EQ] THEN
    ASM_SIMP_TAC [INT_OF_NUM_CLAUSES, LE_1])

  let HAS_SIZE_PRIME_SUBRING ← prove
   r"!r:A ring.
        ~(ring_char r = 0)
        ==> {ring_of_int r n | n IN (:int)} HAS_SIZE ring_char r"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [PRIME_SUBRING_FINITE] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN
    REWRITE_TAC [HAS_SIZE_NUMSEG_LT, IN_ELIM_THM] THEN
    SIMP_TAC [IMP_CONJ, IN_ELIM_THM, RING_OF_NUM_EQ, CONG, MOD_LT])

  let CARD_PRIME_SUBRING ← prove
   r"!r:A ring.
        ~(ring_char r = 0)
        ==> CARD {ring_of_int r n | n IN (:int)} = ring_char r"
   (MESON_TAC [HAS_SIZE_PRIME_SUBRING, HAS_SIZE])

  let FINITE_PRIME_SUBRING ← prove
   r"!r:A ring. FINITE {ring_of_int r n | n IN (:int)} <=> ~(ring_char r = 0)"
   (GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [HAS_SIZE, HAS_SIZE_PRIME_SUBRING]] THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [] THEN DISCH_TAC THEN
    REWRITE_TAC [← GSYM INFINITE] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    MATCH_MP_TAC INFINITE_IMAGE THEN REWRITE_TAC [IN_GSPEC, int_INFINITE] THEN
    ASM_REWRITE_TAC [IN_UNIV, RING_OF_INT_EQ] THEN
    CONV_TAC (fun t => (INTEGER_RULE t).run))

  let RING_CHAR_DIVIDES_ORDER ← prove
   r"!r:A ring.
        FINITE(ring_carrier r) ==> ring_char r divides CARD(ring_carrier r)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"ring_char r = CARD {ring_of_int r n:A | n IN (:int)}")
    SUBST1_TAC THENL
     [ASM_SIMP_TAC [CARD_PRIME_SUBRING, RING_CHAR_FINITE],
      MATCH_MP_TAC LAGRANGE_THEOREM_RING THEN ASM_REWRITE_TAC [PRIME_SUBRING]])

  let CARD_DIVIDES_RING_MONOMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B).
        ring_monomorphism(r,r') f /\ FINITE(ring_carrier r')
        ==> CARD(ring_carrier r) divides CARD(ring_carrier r')"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"CARD(ring_carrier r) = CARD(ring_image (r,r') (f:A->B))")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARD_EQ_CARD_IMP THEN
      REWRITE_TAC [ring_image] THEN
      ASM_MESON_TAC [CARD_EQ_RING_MONOMORPHIC_IMAGE,
                     FINITE_RING_MONOMORPHIC_PREIMAGE],
      MATCH_MP_TAC LAGRANGE_THEOREM_RING THEN
      ASM_MESON_TAC [SUBRING_RING_IMAGE, ring_monomorphism]])

  let CARD_DIVIDES_RING_EPIMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B).
        ring_epimorphism(r,r') f /\ FINITE(ring_carrier r)
        ==> CARD(ring_carrier r') divides CARD(ring_carrier r)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [RING_EPIMORPHISM] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CARD_EQ_RING_IMAGE_KERNEL) THEN DISCH_THEN
     (MP_TAC o (MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_CARD_IMP))) THEN
    ASM_REWRITE_TAC [ring_image, mul_c, ← GSYM CROSS, ring_kernel] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [FINITE_CROSS, CARD_CROSS, FINITE_IMAGE, FINITE_RESTRICT] THEN
    CONV_TAC (fun t => (NUMBER_RULE t).run))

  let CARD_RING_COSETS_DIVIDES ← prove
   r"!r j:A->bool.
        FINITE(ring_carrier r) /\
        (ring_ideal r j \/ j subring_of r)
        ==> CARD {ring_coset r j x | x | x IN ring_carrier r} divides
            CARD(ring_carrier r)"
   (MESON_TAC [divides, LAGRANGE_THEOREM_RING_EXPLICIT])

  let RING_SETADD_PROD_RING ← prove
   r"!(r1:A ring) (r2:B ring) s1 s2 t1 t2.
        ring_setadd (prod_ring r1 r2) (s1 CROSS s2) (t1 CROSS t2) =
        (ring_setadd r1 s1 t1) CROSS (ring_setadd r2 s2 t2)"
   (REWRITE_TAC [ring_setadd, CROSS, PROD_RING, ← SET_RULE
     (← q r"{f x y | x IN {s a b | P a b} /\ y IN {t c d | Q c d}} =
    {f (s a b) (t c d) | P a b /\ Q c d}")] THEN
    SET_TAC [])

  let RING_COSET_PROD_RING ← prove
   r"!r1 r2 s1 s2 (x1:A) (x2:B).
        ring_coset (prod_ring r1 r2) (s1 CROSS s2) (x1,x2) =
        (ring_coset r1 s1 x1) CROSS (ring_coset r2 s2 x2)"
   (REWRITE_TAC [RING_COSET_SETADD, ← GSYM CROSS_SING, RING_SETADD_PROD_RING])

  let RING_SETADD_PRODUCT_RING ← prove
   r"!(r:K->A ring) k s t.
        ring_setadd (product_ring k r)
                     (cartesian_product k s) (cartesian_product k t) =
        cartesian_product k (\i. ring_setadd (r i) (s i) (t i))"
   (← do
    -- right to left: the MATCH_MP_TAC SET_RULE, the second SET_RULE, the
    -- TAUT, then the first SET_RULE
    let s4 ← SET_RULE
     (← q r"(!x y. R x y ==> f x y = s x y)
    ==> {f x y | R x y} = {s x y | R x y}")
    let s3 ← SET_RULE
     (← q r"{RESTRICTION k f | f | ?x y. RESTRICTION k f = RESTRICTION k (s x y) /\
                                 R x y} =
    {RESTRICTION k (s x y) | R x y}")
    let t2 ← TAUT
     (← q r"p ==> (q /\ r) /\ s <=> (p ==> s) /\ (p ==> q) /\ (p ==> r)")
    let s1 ← SET_RULE
     (← q r"{f x y | x,y | x IN {s x | P x} /\ y IN {s f | Q f}} =
    {f (s x) (s y) | P x /\ Q y}")
    pure (REPEAT GEN_TAC THEN
      REWRITE_TAC [ring_setadd, CARTESIAN_PRODUCT_AS_RESTRICTIONS,
                   PRODUCT_RING] THEN
      REWRITE_TAC [IN_ELIM_THM, s1] THEN
      GEN_REWRITE_TAC (RAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, t2] THEN
      REWRITE_TAC [← GSYM RESTRICTION_EXTENSION, s3] THEN
      MATCH_MP_TAC s4 THEN
      REWRITE_TAC [RESTRICTION_EXTENSION] THEN SIMP_TAC [RESTRICTION]))

  let RING_COSET_PRODUCT_RING ← prove
   r"!(r:K->A ring) j x k.
        ring_coset (product_ring k r) (cartesian_product k j) x =
        cartesian_product k (\i. ring_coset (r i) (j i) (x i))"
   (← do
    let s2 ← SET_RULE
     (← q r"(!x. x IN s ==> f x = g x) ==> {f x | x IN s} = {g x | x IN s}")
    let s1 ← SET_RULE (← q r"{f x y | x,y | x IN {a} /\ P y} = {f a x | P x}")
    pure (REWRITE_TAC [RING_COSET_SETADD, ← GSYM RING_SETADD_PRODUCT_RING] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [CARTESIAN_PRODUCT_SINGS_GEN] THEN
      REWRITE_TAC [ring_setadd, PRODUCT_RING, s1] THEN
      MATCH_MP_TAC s2 THEN
      REWRITE_TAC [RESTRICTION_EXTENSION] THEN SIMP_TAC [RESTRICTION]))

  let RING_SETNEG_SUBRING_GENERATED ← prove
   r"!r s:A->bool.
        ring_setneg (subring_generated r s) = ring_setneg r"
   (REWRITE_TAC [ring_setneg, FUN_EQ_THM, SUBRING_GENERATED])

  let RING_SETADD_SUBRING_GENERATED ← prove
   r"!r s:A->bool.
        ring_setadd (subring_generated r s) = ring_setadd r"
   (REWRITE_TAC [ring_setadd, FUN_EQ_THM, SUBRING_GENERATED])

  let RING_SETNEG_COSET ← prove
   r"!r j a:A.
        a IN ring_carrier r /\ (ring_ideal r j \/ j subring_of r)
        ==> ring_setneg r (ring_coset r j a) = ring_coset r j (ring_neg r a)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_coset] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [SUBSET, ring_setneg, FORALL_IN_GSPEC, IMP_CONJ,
                 RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x | x IN {g a | P a}} = {f (g a) | P a}")] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN EXISTS_TAC (← q "ring_neg r x:A") THEN
    ASM_SIMP_TAC [IN_RING_IDEAL_NEG, IN_SUBRING_NEG] THEN
    (FIRST_X_ASSUM (MP_TAC o MATCH_MP RING_IDEAL_IMP_SUBSET) ORELSE
     FIRST_X_ASSUM (MP_TAC o MATCH_MP SUBRING_OF_IMP_SUBSET)) THEN
    ASM_SIMP_TAC [SUBSET, RING_NEG_ADD, RING_NEG_NEG, RING_NEG])

  let RING_SETADD_COSETS ← prove
   r"!r j a b:A.
        (ring_ideal r j \/ j subring_of r) /\
        a IN ring_carrier r /\ b IN ring_carrier r
        ==> ring_setadd r (ring_coset r j a) (ring_coset r j b) =
            ring_coset r j (ring_add r a b)"
   (REWRITE_TAC [RING_COSET_SETADD] THEN
    ASM_SIMP_TAC [RING_SETADD_IDEAL_RIGHT, SING_SUBSET, IN_SING] THEN
    REWRITE_TAC [RING_SETADD_SING])

  let RING_SETMUL_COSETS ← prove
   r"!r j a b:A.
        a IN ring_carrier r /\ b IN ring_carrier r /\ ring_ideal r j
        ==> ring_setmul r (ring_coset r j a) (ring_coset r j b)
            SUBSET ring_coset r j (ring_mul r a b)"
   (REWRITE_TAC [RING_COSET_SETADD] THEN
    ASM_SIMP_TAC [RING_SETMUL_IDEAL_RIGHT, ← GSYM RING_SETMUL_SING, SING_SUBSET])

  let RING_COSET_IDEAL_GENERATED_SING ← prove
   r"!r a x:A.
        a IN ring_carrier r /\ x IN ring_carrier r
        ==> ring_coset r (ideal_generated r {a}) x =
            {y | y IN ring_carrier r /\
                 ring_divides r a (ring_sub r x y)}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [ring_coset, IDEAL_GENERATED_SING] THEN
    REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q "y:A") THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, ring_divides] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_AND_EXISTS_THM] THEN
    EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
     [MAP_EVERY X_GEN_TAC [← q "w:A", ← q "z:A"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q "ring_neg r z:A") THEN REPEAT (FIRST_X_ASSUM SUBST_ALL_TAC),
      X_GEN_TAC (← q "z:A") THEN STRIP_TAC THEN MAP_EVERY EXISTS_TAC
       [← q "ring_mul r a (ring_neg r z):A", ← q "ring_neg r z:A"]] THEN
    ASM_SIMP_TAC [RING_ADD, RING_SUB, RING_MUL, RING_NEG] THEN RING_TAC)

  let RING_COSET_IDEAL_GENERATED_SING_EQ ← prove
   r"!r a x y:A.
        a IN ring_carrier r /\ x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_coset r (ideal_generated r {a}) x =
             ring_coset r (ideal_generated r {a}) y <=>
             ring_divides r a (ring_sub r x y))"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [EQ_SYM_EQ] THEN
    ASM_SIMP_TAC [← GSYM IN_RING_COSET, RING_IDEAL_IDEAL_GENERATED] THEN
    ASM_SIMP_TAC [RING_COSET_IDEAL_GENERATED_SING, IN_ELIM_THM])

  -- @@RETURN BEGIN
  return { ring_coset, RING_COSET_SETADD, RING_COSET, RING_COSET_0, RING_COSET_TRIVIAL,
           RING_COSET_CARRIER, RING_COSET_EQ, RING_COSET_EQ_IDEAL, RING_COSET_EQ_EMPTY,
           RING_COSET_NONEMPTY, IN_RING_COSET_SELF, UNIONS_RING_COSETS, RING_COSETS_EQ,
           IN_RING_COSET, RING_COSET_RELATIONAL, DISJOINT_RING_COSETS,
           PAIRWISE_DISJOINT_RING_COSETS, IMAGE_RING_COSET_SWITCH, CARD_EQ_RING_COSETS,
           CARD_EQ_RING_COSET_IDEAL, LAGRANGE_THEOREM_RING_EXPLICIT,
           LAGRANGE_THEOREM_RING, PRIME_SUBRING_FINITE, HAS_SIZE_PRIME_SUBRING,
           CARD_PRIME_SUBRING, FINITE_PRIME_SUBRING, RING_CHAR_DIVIDES_ORDER,
           CARD_DIVIDES_RING_MONOMORPHIC_IMAGE, CARD_DIVIDES_RING_EPIMORPHIC_IMAGE,
           CARD_RING_COSETS_DIVIDES, RING_SETADD_PROD_RING, RING_COSET_PROD_RING,
           RING_SETADD_PRODUCT_RING, RING_COSET_PRODUCT_RING,
           RING_SETNEG_SUBRING_GENERATED, RING_SETADD_SUBRING_GENERATED,
           RING_SETNEG_COSET, RING_SETADD_COSETS, RING_SETMUL_COSETS,
           RING_COSET_IDEAL_GENERATED_SING, RING_COSET_IDEAL_GENERATED_SING_EQ }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Quotient rings.  (ringtheory.ml 9055-9437)                                -/
/- ------------------------------------------------------------------------- -/

structure Quotients where
  -- @@FIELDS
  quotient_ring : thm
  RING_HOMOMORPHISM_RING_COSET : thm
  QUOTIENT_RING : thm
  RING_EPIMORPHISM_RING_COSET : thm
  QUOTIENT_RING_CARRIER : thm
  QUOTIENT_RING_0 : thm
  QUOTIENT_RING_1 : thm
  QUOTIENT_RING_NEG : thm
  QUOTIENT_RING_ADD : thm
  QUOTIENT_RING_MUL : thm
  RING_KERNEL_RING_COSET : thm
  CARD_LE_QUOTIENT_RING : thm
  CARD_QUOTIENT_RING_DIVIDES : thm
  QUOTIENT_RING_UNIVERSAL_EXPLICIT : thm
  QUOTIENT_RING_UNIVERSAL : thm
  QUOTIENT_RING_UNIVERSAL_EPIMORPHISM : thm
  FIRST_RING_ISOMORPHISM_THEOREM : thm
  FIRST_RING_EPIMORPHISM_THEOREM : thm
  SECOND_RING_ISOMORPHISM_THEOREM : thm
  THIRD_RING_ISOMORPHISM_THEOREM : thm
  QUOTIENT_RING_SUBRING_CORRESPONDENCE : thm
  QUOTIENT_RING_IDEAL_CORRESPONDENCE : thm
  FIRST_RING_ISOMORPHISM_THEOREM_GEN : thm
  FIRST_RING_ISOMORPHISM_THEOREM_GEN_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupQuotients [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BSubrings : Subrings) (BIdeals : Ideals) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BCosets : Cosets) :
    ExceptT String IO Quotients := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, basic_ss, new_definition, .. } := D
  let { AND_FORALL_THM, BETA_THM, .. } := D.core1
  let { EQ_IMP, ETA_AX, EXTENSION, .. } := D.core2
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUNCTION_FACTORS_LEFT_GEN, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, .. } := D.core5
  let { MONO_EXISTS, PAIR, PAIR_EQ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_ANTISYM, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_ASSOC, RING_ADD_LDISTRIB, RING_ADD_LNEG,
        RING_ADD_LZERO, RING_ADD_RDISTRIB, RING_ADD_RNEG, RING_ADD_RZERO, RING_ADD_SYM,
        RING_MUL, RING_MUL_ASSOC, RING_MUL_LID, RING_MUL_SYM, RING_NEG, RING_SUB,
        RING_SUB_EQ_0, RING_SUB_RZERO, ring_0, ring_1, ring_add, ring_carrier,
        ring_mul, ring_neg, ring_sub, ring_tybij, .. } := BBasics
  let { CARRIER_SUBRING_GENERATED_SUBRING, SUBRING_GENERATED,
        SUBRING_GENERATED_IDEMPOT, SUBRING_GENERATED_RING_CARRIER, subring_of, .. } := BSubrings
  let { IN_RING_IDEAL_0, IN_RING_IDEAL_ADD, IN_RING_IDEAL_LMUL, IN_RING_IDEAL_RMUL,
        RING_IDEAL_IMP_SUBSET, RING_IDEAL_SUBRING_GENERATED, RING_SETADD_SUPERSET_LEFT,
        RING_SETADD_SUPERSET_RIGHT, RING_SUBRING_INTER_IDEAL, SUBRING_SETADD_RIGHT,
        ring_ideal, ring_setadd, ring_setmul, .. } := BIdeals
  let { RING_EPIMORPHISM_COMPOSE, RING_HOMOMORPHISM_FROM_SUBRING_GENERATED,
        RING_HOMOMORPHISM_INTO_SUBRING_EQ, RING_HOMOMORPHISM_SUB, RING_ISOMORPHISM,
        ring_epimorphism, ring_homomorphism, .. } := BHoms
  let { CARD_LE_RING_EPIMORPHIC_IMAGE, ISOMORPHIC_RING_REFL, ISOMORPHIC_RING_SYM,
        ISOMORPHIC_RING_TRANS, isomorphic_ring, .. } := BIso
  let { RING_EPIMORPHISM_ALT, RING_EPIMORPHISM_IDEAL_CORRESPONDENCE,
        RING_EPIMORPHISM_IDEAL_CORRESPONDENCE_ALT,
        RING_EPIMORPHISM_SUBRING_CORRESPONDENCE, RING_IDEAL_RING_KERNEL,
        RING_KERNEL_FROM_SUBRING_GENERATED, SUBRING_RING_IMAGE, ring_image,
        ring_kernel, .. } := BKernels
  let { CARD_RING_COSETS_DIVIDES, RING_COSET_0, RING_COSET_EQ, RING_COSET_EQ_IDEAL,
        RING_SETADD_COSETS, RING_SETNEG_COSET, ring_coset, .. } := BCosets
  -- @@SCOPE END

  let quotient_ring ← new_definition
   r"quotient_ring (r:A ring) j =
        ring({ring_coset r j a | a | a IN ring_carrier r},
             ring_coset r j (ring_0 r:A),
             ring_coset r j (ring_1 r),
             ring_setneg r,
             ring_setadd r,
             (\s t. ring_setadd r (ring_setmul r s t) j))"

  let (RING_HOMOMORPHISM_RING_COSET, QUOTIENT_RING) : thm × thm ← do
   CONJ_PAIR (← prove
   r"(!r j:A->bool.
        ring_ideal r j
        ==> ring_homomorphism (r,quotient_ring r j) (ring_coset r j)) /\
   (!r j:A->bool.
        ring_ideal r j
        ==> ring_carrier (quotient_ring r j) =
            {ring_coset r j a | a | a IN ring_carrier r}) /\
   (!r j:A->bool.
        ring_ideal r j
        ==> ring_0 (quotient_ring r j) = ring_coset r j (ring_0 r)) /\
   (!r j:A->bool.
        ring_ideal r j
        ==> ring_1 (quotient_ring r j) = ring_coset r j (ring_1 r)) /\
   (!r j:A->bool.
        ring_ideal r j ==> ring_neg (quotient_ring r j) = ring_setneg r) /\
   (!r j:A->bool.
        ring_ideal r j ==> ring_add (quotient_ring r j) = ring_setadd r) /\
   (!r j:A->bool.
        ring_ideal r j
        ==> ring_mul (quotient_ring r j) =
            (\s t. ring_setadd r (ring_setmul r s t) j))"
   (← do
    let lemma ← prove
     r"!r j a b:A.
          ring_ideal r j /\ a IN ring_carrier r /\ b IN ring_carrier r
          ==> ring_setadd r
                (ring_setmul r (ring_coset r j a) (ring_coset r j b)) j =
              ring_coset r j (ring_mul r a b)"
     (← do
      -- right to left: the second basic_ss, the first, then the two
      -- SET_RULEs, second first
      let ss2 ← ExceptT.mk (basic_ss [])
      let ss1 ← ExceptT.mk (basic_ss [])
      let s2 ← SET_RULE
       (← q r"{f x y | x IN {g a b | P a b} /\ y IN t} =
       {f (g a b) y | P a b /\ y IN t}")
      let s1 ← SET_RULE
       (← q r"{f x y | x IN {g a | P a} /\ y IN {h b | Q b}} =
      {f (g a) (h b) | P a /\ Q b}")
      pure (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_coset] THEN
        MATCH_MP_TAC SUBSET_ANTISYM THEN
        REWRITE_TAC [SUBSET, ring_setmul, ring_setadd, FORALL_IN_GSPEC, IMP_CONJ,
                     RIGHT_FORALL_IMP_THM] THEN
        REWRITE_TAC [s1] THEN
        REWRITE_TAC [s2] THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN CONJ_TAC THENL
         [MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A", ← q "z:A"] THEN STRIP_TAC THEN
          EXISTS_TAC (← q r"ring_add r (ring_mul r x b)
       (ring_add r (ring_mul r a y) (ring_add r (ring_mul r x y) z)):A") THEN
          FIRST_ASSUM (MP_TAC o MATCH_MP RING_IDEAL_IMP_SUBSET) THEN
          ASM (simpTac ss1 5)
           [SUBSET, IN_RING_IDEAL_ADD, IN_RING_IDEAL_LMUL, RING_ADD_LDISTRIB,
            IN_RING_IDEAL_RMUL, RING_ADD, RING_MUL] THEN
          ASM_SIMP_TAC [RING_ADD, RING_ADD_RDISTRIB] THEN
          ASM (simpTac ss2 5)
           [← GSYM RING_ADD_ASSOC, RING_MUL, RING_ADD],
          X_GEN_TAC (← q "z:A") THEN DISCH_TAC THEN
          MAP_EVERY EXISTS_TAC [← q "ring_0 r:A", ← q "ring_0 r:A", ← q "z:A"] THEN
          ASM_SIMP_TAC [RING_0, RING_ADD_RZERO, IN_RING_IDEAL_0]]))
    let t1 ← TAUT (← q r"(q ==> p) /\ q ==> p /\ q")
    pure (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"ring_ideal r (j:A->bool)") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC t1 THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [ring_homomorphism, RING_SETNEG_COSET,
                    RING_SETADD_COSETS, lemma] THEN
      SET_TAC [],
      ALL_TAC] THEN
    GEN_REWRITE_TAC (DEPTH_BINOP_CONV (← q r"/\") o LAND_CONV o ONCE_DEPTH_CONV)
     [ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul] THEN
    PURE_REWRITE_TAC [← GSYM PAIR_EQ, BETA_THM, PAIR] THEN
    PURE_REWRITE_TAC [quotient_ring, ← GSYM (← CONJUNCT2 ring_tybij)] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [RING_SETNEG_COSET, RING_SETADD_COSETS, lemma,
                  RING_0, RING_1, RING_NEG, RING_ADD, RING_MUL] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THENL
     [MESON_TAC [RING_0],
      MESON_TAC [RING_1],
      ASM_MESON_TAC [RING_NEG],
      ASM_MESON_TAC [RING_ADD],
      ASM_MESON_TAC [RING_MUL],
      ASM_SIMP_TAC [RING_ADD_SYM],
      ASM_SIMP_TAC [RING_ADD_ASSOC],
      ASM_SIMP_TAC [RING_ADD_LZERO],
      ASM_SIMP_TAC [RING_ADD_LNEG],
      ASM_SIMP_TAC [RING_MUL_SYM],
      ASM_SIMP_TAC [RING_MUL_ASSOC],
      ASM_SIMP_TAC [RING_MUL_LID],
      ASM_SIMP_TAC [RING_ADD_LDISTRIB]])))

  let RING_EPIMORPHISM_RING_COSET ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> ring_epimorphism (r,quotient_ring r j) (ring_coset r j)"
   (SIMP_TAC [ring_epimorphism, RING_HOMOMORPHISM_RING_COSET] THEN
    SIMP_TAC [QUOTIENT_RING] THEN SET_TAC [])

  let QUOTIENT_RING_CARRIER ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> ring_carrier (quotient_ring r j) =
            {ring_coset r j a | a | a IN ring_carrier r}"
   (REWRITE_TAC [QUOTIENT_RING])

  let QUOTIENT_RING_0 ← prove
   r"!r j:A->bool.
        ring_ideal r j ==> ring_0(quotient_ring r j) = j"
   (SIMP_TAC [QUOTIENT_RING, RING_COSET_0, RING_IDEAL_IMP_SUBSET])

  let QUOTIENT_RING_1 ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> ring_1(quotient_ring r j) = ring_coset r j (ring_1 r)"
   (REWRITE_TAC [QUOTIENT_RING])

  let QUOTIENT_RING_NEG ← prove
   r"!r j a:A.
        ring_ideal r j /\ a IN ring_carrier r
        ==>  ring_neg (quotient_ring r j) (ring_coset r j a) =
             ring_coset r j (ring_neg r a)"
   (SIMP_TAC [← REWRITE_RULE [ring_homomorphism] RING_HOMOMORPHISM_RING_COSET])

  let QUOTIENT_RING_ADD ← prove
   r"!r j a b:A.
        ring_ideal r j /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==>  ring_add (quotient_ring r j)
                      (ring_coset r j a) (ring_coset r j b) =
             ring_coset r j (ring_add r a b)"
   (SIMP_TAC [← REWRITE_RULE [ring_homomorphism] RING_HOMOMORPHISM_RING_COSET])

  let QUOTIENT_RING_MUL ← prove
   r"!r j a b:A.
        ring_ideal r j /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==>  ring_mul (quotient_ring r j)
                      (ring_coset r j a) (ring_coset r j b) =
             ring_coset r j (ring_mul r a b)"
   (SIMP_TAC [← REWRITE_RULE [ring_homomorphism] RING_HOMOMORPHISM_RING_COSET])

  let RING_KERNEL_RING_COSET ← prove
   r"!r j:A->bool.
        ring_ideal r j
        ==> ring_kernel(r,quotient_ring r j) (ring_coset r j) = j"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [ring_kernel, QUOTIENT_RING_0] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    ASM_MESON_TAC [RING_COSET_EQ_IDEAL, RING_IDEAL_IMP_SUBSET, SUBSET])

  let CARD_LE_QUOTIENT_RING ← prove
   r"!r j:A->bool.
    ring_ideal r j ==> ring_carrier(quotient_ring r j) <=_c ring_carrier r"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP RING_EPIMORPHISM_RING_COSET) THEN
    REWRITE_TAC [CARD_LE_RING_EPIMORPHIC_IMAGE])

  let CARD_QUOTIENT_RING_DIVIDES ← prove
   r"!r j:A->bool.
        FINITE(ring_carrier r) /\ ring_ideal r j
        ==> CARD(ring_carrier(quotient_ring r j)) divides
            CARD(ring_carrier r)"
   (SIMP_TAC [QUOTIENT_RING, CARD_RING_COSETS_DIVIDES])

  let QUOTIENT_RING_UNIVERSAL_EXPLICIT ← prove
   r"!r r' j (f:A->B).
        ring_homomorphism (r,r') f /\ ring_ideal r j /\
        (!x y. x IN ring_carrier r /\ y IN ring_carrier r /\
               ring_coset r j x = ring_coset r j y
               ==> f x = f y)
        ==> ?g. ring_homomorphism(quotient_ring r j,r') g /\
                !x. x IN ring_carrier r ==> g(ring_coset r j x) = f x"
   (REWRITE_TAC [ring_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM
     (MP_TAC o GSYM o GEN_REWRITE_RULE id [FUNCTION_FACTORS_LEFT_GEN]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:(A->bool)->B") THEN
    DISCH_TAC THEN ASM_SIMP_TAC [← CONJUNCT1 QUOTIENT_RING] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [RING_ADD, QUOTIENT_RING_ADD, RING_MUL, QUOTIENT_RING_MUL,
                  RING_NEG, QUOTIENT_RING_NEG, RING_1, QUOTIENT_RING_1] THEN
    ASM_SIMP_TAC [QUOTIENT_RING, RING_0])

  let QUOTIENT_RING_UNIVERSAL ← prove
   r"!r r' j (f:A->B).
        ring_homomorphism (r,r') f /\
        ring_ideal r j /\
        j SUBSET ring_kernel(r,r') f
        ==> ?g. ring_homomorphism(quotient_ring r j,r') g /\
                !x. x IN ring_carrier r ==> g(ring_coset r j x) = f x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC QUOTIENT_RING_UNIVERSAL_EXPLICIT THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "ring_sub r x y:A") o REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [← GSYM RING_COSET_EQ, ring_kernel, IN_ELIM_THM, RING_SUB] THEN
    ASM_SIMP_TAC [RING_HOMOMORPHISM_SUB] THEN
    MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC RING_SUB_EQ_0 THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_SIMP_TAC [])

  let QUOTIENT_RING_UNIVERSAL_EPIMORPHISM ← prove
   r"!r r' j (f:A->B).
        ring_epimorphism (r,r') f /\
        ring_ideal r j /\
        j SUBSET ring_kernel(r,r') f
        ==> ?g. ring_epimorphism(quotient_ring r j,r') g /\
                !x. x IN ring_carrier r ==> g(ring_coset r j x) = f x"
   (REWRITE_TAC [ring_epimorphism] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "r':B ring", ← q r"j:A->bool", ← q r"f:A->B"]
          QUOTIENT_RING_UNIVERSAL) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_SIMP_TAC [QUOTIENT_RING] THEN ASM SET_TAC [])

  let FIRST_RING_ISOMORPHISM_THEOREM ← prove
   r"!r r' (f:A->B).
        ring_homomorphism(r,r') f
        ==> (quotient_ring r (ring_kernel (r,r') f)) isomorphic_ring
            (subring_generated r' (ring_image (r,r') f))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [isomorphic_ring, RING_ISOMORPHISM] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"ring_kernel (r,r') (f:A->B)") o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] QUOTIENT_RING_UNIVERSAL_EXPLICIT)) THEN
    ASM_SIMP_TAC [RING_IDEAL_RING_KERNEL] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [IMP_CONJ, RING_COSET_EQ, RING_IDEAL_RING_KERNEL],
      MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"g:(A->bool)->B") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [RING_HOMOMORPHISM_INTO_SUBRING_EQ, SUBRING_RING_IMAGE,
                    CARRIER_SUBRING_GENERATED_SUBRING] THEN
      ASM_SIMP_TAC [QUOTIENT_RING, RING_IDEAL_RING_KERNEL] THEN
      REWRITE_TAC [ring_image] THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      SIMP_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
      ASM_SIMP_TAC [RING_COSET_EQ, RING_IDEAL_RING_KERNEL]] THEN
    ASM_SIMP_TAC [ring_kernel, IN_ELIM_THM, RING_HOMOMORPHISM_SUB] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_SIMP_TAC [RING_SUB, RING_SUB_EQ_0])

  let FIRST_RING_EPIMORPHISM_THEOREM ← prove
   r"!r r' (f:A->B).
        ring_epimorphism(r,r') f
        ==> (quotient_ring r (ring_kernel(r,r') f)) isomorphic_ring r'"
   (REWRITE_TAC [ring_epimorphism] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FIRST_RING_ISOMORPHISM_THEOREM) THEN
    ASM_REWRITE_TAC [ring_image, SUBRING_GENERATED_RING_CARRIER])

  let SECOND_RING_ISOMORPHISM_THEOREM ← prove
   r"!r s j:A->bool.
        s subring_of r /\ ring_ideal r j
        ==> ring_ideal (subring_generated r (ring_setadd r s j)) j /\
            ring_ideal (subring_generated r s) (s INTER j) /\
            quotient_ring (subring_generated r (ring_setadd r s j)) j
            isomorphic_ring
            quotient_ring (subring_generated r s) (s INTER j)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(p /\ q) /\ (p /\ q ==> r) ==> p /\ q /\ r")) THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC RING_IDEAL_SUBRING_GENERATED THEN
      ASM_SIMP_TAC [SUBRING_SETADD_RIGHT] THEN
      MATCH_MP_TAC RING_SETADD_SUPERSET_RIGHT THEN
      ASM_MESON_TAC [subring_of, ring_ideal],
      ASM_SIMP_TAC [RING_SUBRING_INTER_IDEAL],
      STRIP_TAC] THEN
    ONCE_REWRITE_TAC [ISOMORPHIC_RING_SYM] THEN
    MP_TAC (← ISPECL [← q "subring_generated r s:A ring",
     ← q r"quotient_ring (subring_generated r (ring_setadd r s (j:A->bool))) j",
     ← q r"ring_coset r (j:A->bool)"]
      FIRST_RING_EPIMORPHISM_THEOREM) THEN
    ANTS_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [RING_KERNEL_FROM_SUBRING_GENERATED] THEN
      ASM_SIMP_TAC [ring_kernel, QUOTIENT_RING] THEN
      ASM_SIMP_TAC [RING_COSET_0, RING_IDEAL_IMP_SUBSET] THEN
      GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q "x:A") THEN
      REWRITE_TAC [IN_ELIM_THM, IN_INTER] THEN
      ASM_MESON_TAC [RING_COSET_EQ_IDEAL, RING_IDEAL_IMP_SUBSET, SUBSET]] THEN
    SUBGOAL_THEN
     (← q r"subring_generated r s =
    subring_generated (subring_generated r (ring_setadd r s j)) (s:A->bool)")
     (fun th => tactic_of do pure (SUBST1_TAC th THEN ASSUME_TAC (← SYM th)))
    THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUBRING_GENERATED_IDEMPOT THEN
      MATCH_MP_TAC RING_SETADD_SUPERSET_LEFT THEN
      ASM_MESON_TAC [subring_of, ring_ideal],
      ALL_TAC] THEN
    REWRITE_TAC [RING_EPIMORPHISM_ALT] THEN CONJ_TAC THENL
     [MATCH_MP_TAC RING_HOMOMORPHISM_FROM_SUBRING_GENERATED THEN
      wPart lhand (fun t => do lhand (← rand t)) RING_HOMOMORPHISM_RING_COSET THEN
      ASM_SIMP_TAC [] THEN
      REWRITE_TAC [ring_coset, SUBRING_GENERATED],
      ASM_SIMP_TAC [QUOTIENT_RING, ring_image] THEN
      ASM_SIMP_TAC [CARRIER_SUBRING_GENERATED_SUBRING, SUBRING_SETADD_RIGHT] THEN
      REWRITE_TAC [ring_coset, SUBRING_GENERATED] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, ring_setadd] THEN
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
      REWRITE_TAC [IN_IMAGE] THEN REWRITE_TAC [← GSYM (← REWRITE_RULE []
       (← ONCE_REWRITE_RULE [FUN_EQ_THM] ring_coset))] THEN
      SUBGOAL_THEN (← q r"(x:A) IN ring_carrier r /\ y IN ring_carrier r")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [ring_ideal, subring_of, SUBSET],
        EXISTS_TAC (← q "x:A") THEN     ASM_SIMP_TAC [RING_COSET_EQ, RING_ADD]] THEN
      SUBGOAL_THEN (← q "ring_add r x y:A = ring_add r y x") SUBST1_TAC THENL
       [ASM_MESON_TAC [RING_ADD_SYM], REWRITE_TAC [ring_sub]] THEN
      ASM_SIMP_TAC [← GSYM RING_ADD_ASSOC, RING_NEG,
                    RING_ADD_RNEG, RING_ADD_RZERO]])

  let THIRD_RING_ISOMORPHISM_THEOREM ← prove
   r"!r j k:A->bool.
        ring_ideal r j /\ ring_ideal r k /\ j SUBSET k
        ==> quotient_ring (quotient_ring r j) (IMAGE (ring_coset r j) k)
             isomorphic_ring quotient_ring r k"
   (← do
    -- right to left: the TAUT, the SET_RULE, then the MESON
    let t1 ← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")
    let s1 ← SET_RULE
     (← q r"{y | y IN {f x | P x} /\ Q y} = IMAGE f {x | P x /\ Q(f x)}")
    let m1 ← MESON [ISOMORPHIC_RING_REFL] (← q r"s = t ==> s isomorphic_ring t")
    pure (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q "r:A ring", ← q r"quotient_ring r (k:A->bool)", ← q r"j:A->bool",
      ← q r"ring_coset r (k:A->bool)"] QUOTIENT_RING_UNIVERSAL_EPIMORPHISM) THEN
    ASM_SIMP_TAC [RING_EPIMORPHISM_RING_COSET, RING_KERNEL_RING_COSET] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(A->bool)->(A->bool)") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FIRST_RING_EPIMORPHISM_THEOREM) THEN
      ASM_SIMP_TAC [ring_kernel, QUOTIENT_RING] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] ISOMORPHIC_RING_TRANS) THEN
    MATCH_MP_TAC m1 THEN
    AP_TERM_TAC THEN REWRITE_TAC [s1] THEN
    REWRITE_TAC [ETA_AX] THEN AP_TERM_TAC THEN
    ONCE_REWRITE_TAC [t1] THEN
    ASM_SIMP_TAC [RING_COSET_EQ, RING_0, RING_SUB_RZERO] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP RING_IDEAL_IMP_SUBSET)) THEN
    SET_TAC []))

  let QUOTIENT_RING_SUBRING_CORRESPONDENCE ← prove
   r"!(r:A ring) j t.
        ring_ideal r j
        ==> (t subring_of (quotient_ring r j) <=>
             ?s. s subring_of r /\ j SUBSET s /\
                 {x | x IN ring_carrier r /\ ring_coset r j x IN t} = s /\
                 IMAGE (ring_coset r j) s = t)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_EPIMORPHISM_RING_COSET) THEN
    DISCH_THEN (MP_TAC o MATCH_MP RING_EPIMORPHISM_SUBRING_CORRESPONDENCE) THEN
    ASM_SIMP_TAC [RING_KERNEL_RING_COSET])

  let QUOTIENT_RING_IDEAL_CORRESPONDENCE ← prove
   r"!(r:A ring) j k.
        ring_ideal r j
        ==> (ring_ideal (quotient_ring r j) k <=>
             ?i. ring_ideal r i /\ j SUBSET i /\
                 {x | x IN ring_carrier r /\ ring_coset r j x IN k} = i /\
                 IMAGE (ring_coset r j) i = k)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_EPIMORPHISM_RING_COSET) THEN
    DISCH_THEN (MP_TAC o MATCH_MP RING_EPIMORPHISM_IDEAL_CORRESPONDENCE) THEN
    ASM_SIMP_TAC [RING_KERNEL_RING_COSET])

  let FIRST_RING_ISOMORPHISM_THEOREM_GEN ← prove
   r"!r r' (f:A->B) j k.
        ring_epimorphism(r,r') f /\
        ring_ideal r' k /\ {x | x IN ring_carrier r /\ f x IN k} = j
        ==> quotient_ring r j isomorphic_ring quotient_ring r' k"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"quotient_ring r' (k:B->bool)",
                     ← q r"ring_coset r' k o (f:A->B)"]
          FIRST_RING_EPIMORPHISM_THEOREM) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC RING_EPIMORPHISM_COMPOSE THEN EXISTS_TAC (← q "r':B ring") THEN
      ASM_SIMP_TAC [RING_EPIMORPHISM_RING_COSET],
      MATCH_MP_TAC EQ_IMP] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    ASM_SIMP_TAC [ring_kernel, QUOTIENT_RING_0, o_THM] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN EXPAND_TAC "j" THEN
    X_GEN_TAC (← q "x:A") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    ASM_CASES_TAC (← q "(x:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC RING_COSET_EQ_IDEAL THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_epimorphism]) THEN ASM SET_TAC [])

  let FIRST_RING_ISOMORPHISM_THEOREM_GEN_ALT ← prove
   r"!r r' (f:A->B) j k.
        ring_epimorphism(r,r') f /\
        ring_ideal r j /\ ring_kernel (r,r') f SUBSET j /\ IMAGE f j = k
        ==> quotient_ring r j isomorphic_ring quotient_ring r' k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FIRST_RING_ISOMORPHISM_THEOREM_GEN THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [RING_EPIMORPHISM_IDEAL_CORRESPONDENCE_ALT])

  -- @@RETURN BEGIN
  return { quotient_ring, RING_HOMOMORPHISM_RING_COSET, QUOTIENT_RING,
           RING_EPIMORPHISM_RING_COSET, QUOTIENT_RING_CARRIER, QUOTIENT_RING_0,
           QUOTIENT_RING_1, QUOTIENT_RING_NEG, QUOTIENT_RING_ADD, QUOTIENT_RING_MUL,
           RING_KERNEL_RING_COSET, CARD_LE_QUOTIENT_RING, CARD_QUOTIENT_RING_DIVIDES,
           QUOTIENT_RING_UNIVERSAL_EXPLICIT, QUOTIENT_RING_UNIVERSAL,
           QUOTIENT_RING_UNIVERSAL_EPIMORPHISM, FIRST_RING_ISOMORPHISM_THEOREM,
           FIRST_RING_EPIMORPHISM_THEOREM, SECOND_RING_ISOMORPHISM_THEOREM,
           THIRD_RING_ISOMORPHISM_THEOREM, QUOTIENT_RING_SUBRING_CORRESPONDENCE,
           QUOTIENT_RING_IDEAL_CORRESPONDENCE, FIRST_RING_ISOMORPHISM_THEOREM_GEN,
           FIRST_RING_ISOMORPHISM_THEOREM_GEN_ALT }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Prime and irreducible elements.  (ringtheory.ml 9438-9851)                -/
/- ------------------------------------------------------------------------- -/

structure Primes where
  -- @@FIELDS
  ring_prime : thm
  ring_irreducible : thm
  RING_PRIME_IN_CARRIER : thm
  RING_IRREDUCIBLE_IN_CARRIER : thm
  RING_PRIME_NEG : thm
  RING_IRREDUCIBLE_NEG : thm
  RING_PRIME_IMP_NONTRIVIAL_RING : thm
  RING_IRREDUCIBLE_IMP_NONTRIVIAL_RING : thm
  FIELD_PRIME : thm
  FIELD_IRREDUCIBLE : thm
  RING_ASSOCIATES_PRIME : thm
  RING_NONUNIT_DIVIDES_IRREDUCIBLE : thm
  RING_PRIME_DIVIDES_IRREDUCIBLE : thm
  RING_PRIME_DIVIDES_MUL : thm
  RING_PRIME_DIVIDES_POW : thm
  RING_PRIME_DIVIDES_PRODUCT : thm
  INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE : thm
  INTEGRAL_DOMAIN_IRREDUCIBLE : thm
  INTEGRAL_DOMAIN_IRREDUCIBLE_ALT : thm
  INTEGRAL_DOMAIN_IRREDUCIBLE_DIVISORS : thm
  RING_ASSOCIATES_IRREDUCIBLE : thm
  INTEGRAL_DOMAIN_DIVIDES_PRIME_LMUL : thm
  INTEGRAL_DOMAIN_DIVIDES_PRIME_RMUL : thm
  RING_IRREDUCIBLE_DIVIDES_OR_COPRIME : thm
  RING_IRREDUCIBLE_COPRIME_EQ : thm
  RING_IRREDUCIBLES_COPRIME_OR_ASSOCIATES : thm
  INTEGRAL_DOMAIN_PRIME_DIVIDES_OR_COPRIME : thm
  INTEGRAL_DOMAIN_PRIME_COPRIME_EQ : thm
  INTEGRAL_DOMAIN_PRIMES_COPRIME_OR_ASSOCIATES : thm
  INTEGRAL_DOMAIN_PRIMES_DIVIDES_EQ_ASSOCIATES : thm
  RING_PRIME_ISOMORPHIC_IMAGE_EQ : thm
  RING_IRREDUCIBLE_ISOMORPHIC_IMAGE_EQ : thm
  RING_PRIME_MUL_DIVIDES : thm
  RING_PRIME_MUL_DIVIDES_EQ : thm
  RING_PRIME_PRODUCT_DIVIDES : thm
  INTEGRAL_DOMAIN_PRIME_PRODUCT_DIVIDES : thm
  deriving Inhabited

@[nospecialize]
def setupPrimes [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BProducts : Products) (BDivides : Divides) (BDomains : Domains) (BHoms : Homs) (BKernels : Kernels) :
    ExceptT String IO Primes := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { CONTRAPOS_THM, DISJ_SYM, EQ_SYM_EQ, EXISTS_IN_INSERT, .. } := D.core2
  let { FINITE_INDUCT_STRONG, FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_EXISTS, MONO_FORALL, MONO_OR, NOT_IN_EMPTY, PAIRWISE_INSERT, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SWAP_FORALL_THM, .. } := D.core7
  let { pairwise, .. } := D.core8
  let { RING_1, RING_MUL, RING_MUL_AC, RING_MUL_ASSOC, RING_MUL_LNEG, RING_MUL_LZERO,
        RING_MUL_RID, RING_MUL_RZERO, RING_MUL_SYM, RING_NEG, RING_NEG_EQ_0,
        RING_NEG_NEG, trivial_ring, .. } := BBasics
  let { RING_POW, ring_pow, .. } := BNumbers
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, .. } := BProducts
  let { RING_ASSOCIATES_ASSOCIATES, RING_ASSOCIATES_DIVIDES, RING_ASSOCIATES_EQ_0,
        RING_ASSOCIATES_IN_CARRIER, RING_ASSOCIATES_REFL, RING_ASSOCIATES_RMUL,
        RING_ASSOCIATES_SYM, RING_ASSOCIATES_UNIT, RING_COPRIME_IN_CARRIER,
        RING_COPRIME_SYM, RING_DIVIDES_1, RING_DIVIDES_ASSOCIATES, RING_DIVIDES_LMUL,
        RING_DIVIDES_LMUL_REV, RING_DIVIDES_NEG_EQ, RING_DIVIDES_ONE,
        RING_DIVIDES_REFL, RING_DIVIDES_RMUL, RING_DIVIDES_RMUL_REV, RING_UNIT_NEG_EQ,
        ring_associates, ring_coprime, ring_divides, ring_unit, .. } := BDivides
  let { FIELD_DIVIDES, FIELD_UNIT, INTEGRAL_DOMAIN_DIVIDES_MUL_SELF,
        INTEGRAL_DOMAIN_MUL_LCANCEL, integral_domain, .. } := BDomains
  let { RING_HOMOMORPHISM_MUL, RING_ISOMORPHISM, RING_ISOMORPHISM_IMP_HOMOMORPHISM,
        RING_ISOMORPHISM_IMP_MONOMORPHISM, RING_MONOMORPHISM_INJECTIVE_EQ, .. } := BHoms
  let { RING_DIVIDES_ISOMORPHIC_IMAGE_EQ, RING_MONOMORPHISM_ALT_EQ,
        RING_UNIT_ISOMORPHIC_IMAGE_EQ, .. } := BKernels
  -- @@SCOPE END

  let ring_prime ← new_definition
   r"ring_prime r (p:A) <=>
        p IN ring_carrier r /\ ~(p = ring_0 r) /\ ~(ring_unit r p) /\
        !a b. a IN ring_carrier r /\
              b IN ring_carrier r /\
              ring_divides r p (ring_mul r a b)
              ==> ring_divides r p a \/ ring_divides r p b"

  let ring_irreducible ← new_definition
   r"ring_irreducible r (p:A) <=>
        p IN ring_carrier r /\ ~(p = ring_0 r) /\ ~(ring_unit r p) /\
        !a b. a IN ring_carrier r /\
              b IN ring_carrier r /\
              ring_mul r a b = p
              ==> ring_unit r a \/ ring_unit r b"

  let RING_PRIME_IN_CARRIER ← prove
   r"!r a:A. ring_prime r a ==> a IN ring_carrier r"
   (SIMP_TAC [ring_prime])

  let RING_IRREDUCIBLE_IN_CARRIER ← prove
   r"!r a:A. ring_irreducible r a ==> a IN ring_carrier r"
   (SIMP_TAC [ring_irreducible])

  let RING_PRIME_NEG ← prove
   r"!r x:A.
        x IN ring_carrier r
        ==> (ring_prime r (ring_neg r x) <=> ring_prime r x)"
   (SIMP_TAC [ring_prime, RING_UNIT_NEG_EQ, RING_NEG_EQ_0, RING_NEG] THEN
    MESON_TAC [RING_DIVIDES_NEG_EQ, RING_MUL])

  let RING_IRREDUCIBLE_NEG ← prove
   r"!r x:A.
        x IN ring_carrier r
        ==> (ring_irreducible r (ring_neg r x) <=> ring_irreducible r x)"
   (SIMP_TAC [ring_irreducible, RING_UNIT_NEG_EQ, RING_NEG_EQ_0, RING_NEG] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "ring_neg r a:A", ← q "b:A"]) THEN
    ASM_SIMP_TAC [RING_NEG, RING_MUL_LNEG, RING_UNIT_NEG_EQ, RING_NEG_NEG])

  let RING_PRIME_IMP_NONTRIVIAL_RING ← prove
   r"!r p:A. ring_prime r p ==> ~trivial_ring r"
   (REWRITE_TAC [ring_prime, trivial_ring] THEN SET_TAC [])

  let RING_IRREDUCIBLE_IMP_NONTRIVIAL_RING ← prove
   r"!r p:A. ring_irreducible r p ==> ~trivial_ring r"
   (REWRITE_TAC [ring_irreducible, trivial_ring] THEN SET_TAC [])

  let FIELD_PRIME ← prove
   r"!r a:A. field r ==> ~(ring_prime r a)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [ring_prime, FIELD_DIVIDES, FIELD_UNIT] THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q "a:A = ring_0 r") THEN ASM_REWRITE_TAC [])

  let FIELD_IRREDUCIBLE ← prove
   r"!r a:A. field r ==> ~(ring_irreducible r a)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [ring_irreducible, FIELD_DIVIDES, FIELD_UNIT] THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q "a:A = ring_0 r") THEN ASM_REWRITE_TAC [])

  let RING_ASSOCIATES_PRIME ← prove
   r"!r a a':A.
        ring_associates r a a' ==> (ring_prime r a <=> ring_prime r a')"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_prime] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP RING_ASSOCIATES_IN_CARRIER) THEN
    ASM_REWRITE_TAC [] THEN
    BINOP_TAC THENL [ASM_MESON_TAC [RING_ASSOCIATES_EQ_0], ALL_TAC] THEN
    BINOP_TAC THENL [ASM_MESON_TAC [RING_ASSOCIATES_UNIT], ALL_TAC] THEN
    ASM_MESON_TAC [RING_MUL, RING_ASSOCIATES_DIVIDES, RING_ASSOCIATES_REFL])

  let RING_NONUNIT_DIVIDES_IRREDUCIBLE ← prove
   r"!r p q:A.
        ~(ring_unit r p) /\
        ring_irreducible r q /\
        ring_divides r p q
        ==> ring_associates r p q"
   (SIMP_TAC [ring_irreducible, ring_associates] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_divides]) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "x:A")
     (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC)) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "p:A", ← q "x:A"]) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC RING_DIVIDES_ASSOCIATES THEN
    ONCE_REWRITE_TAC [RING_ASSOCIATES_SYM] THEN
    ASM_SIMP_TAC [RING_ASSOCIATES_RMUL])

  let RING_PRIME_DIVIDES_IRREDUCIBLE ← prove
   r"!r p q:A.
        ring_prime r p /\
        ring_irreducible r q /\
        ring_divides r p q
        ==> ring_prime r q"
   (MESON_TAC [ring_prime, RING_ASSOCIATES_PRIME,
               RING_NONUNIT_DIVIDES_IRREDUCIBLE])

  let RING_PRIME_DIVIDES_MUL ← prove
   r"!r p a b:A.
        ring_prime r p /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_divides r p (ring_mul r a b) <=>
             ring_divides r p a \/ ring_divides r p b)"
   (MESON_TAC [ring_prime, RING_DIVIDES_RMUL, RING_DIVIDES_LMUL])

  let RING_PRIME_DIVIDES_POW ← prove
   r"!r p (x:A) n.
        ring_prime r p /\ x IN ring_carrier r /\
        ring_divides r p (ring_pow r x n)
        ==> ring_divides r p x"
   (GEN_TAC THEN GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THENL
     [SIMP_TAC [ring_pow, RING_DIVIDES_ONE] THEN MESON_TAC [ring_prime],
      REWRITE_TAC [ring_pow] THEN
      ASM_MESON_TAC [RING_PRIME_DIVIDES_MUL, RING_POW]])

  let RING_PRIME_DIVIDES_PRODUCT ← prove
   r"!r p k (f:K->A).
        ring_prime r p /\ FINITE k /\ (!i. i IN k ==> f i IN ring_carrier r)
        ==> (ring_divides r p (ring_product r k f) <=>
             ?i. i IN k /\ ring_divides r p (f i))"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [NOT_IN_EMPTY, FORALL_IN_INSERT, EXISTS_IN_INSERT] THEN
    SIMP_TAC [RING_PRODUCT_CLAUSES, RING_DIVIDES_ONE] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [ring_prime], ALL_TAC] THEN
    ASM_SIMP_TAC [RING_PRIME_DIVIDES_MUL, RING_PRODUCT])

  let INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE ← prove
   r"!r p:A. integral_domain r /\ ring_prime r p ==> ring_irreducible r p"
   (REPEAT GEN_TAC THEN SIMP_TAC [ring_prime, ring_irreducible] THEN
    STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
    GEN_REWRITE_TAC id [DISJ_SYM] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "a:A", ← q "b:A"]) THEN
    ASM_REWRITE_TAC [RING_DIVIDES_REFL] THEN
    MATCH_MP_TAC MONO_OR THEN CONJ_TAC THEN
    ASM_REWRITE_TAC [ring_divides, ring_unit] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "x:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC INTEGRAL_DOMAIN_MUL_LCANCEL THEN
    EXISTS_TAC (← q "r:A ring") THEN EXISTS_TAC (← q "p:A") THEN
    ASM_SIMP_TAC [RING_MUL, RING_1, RING_MUL_RID] THEN
    ASM_MESON_TAC [RING_MUL_AC])

  let INTEGRAL_DOMAIN_IRREDUCIBLE ← prove
   r"!r a:A.
        integral_domain r
        ==> (ring_irreducible r a <=>
             a IN ring_carrier r /\
             ~(a = ring_0 r) /\
             ~ring_unit r a /\
             !d. ring_divides r d a
                 ==> ring_unit r d \/ ring_divides r a d)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_irreducible] THEN
    REPEAT (MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> q')) ==> (p /\ q <=> p /\ q')")) THEN
           DISCH_TAC) THEN
    GEN_REWRITE_TAC (RAND_CONV o BINDER_CONV o LAND_CONV) [ring_divides] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN EQ_TAC THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q "x:A") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q "y:A") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th THEN ASM_REWRITE_TAC []) THEN
    ASM_CASES_TAC (← q "ring_unit r (x:A)") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THENL
     [ASM_MESON_TAC [RING_ASSOCIATES_RMUL, RING_DIVIDES_REFL,
                     RING_ASSOCIATES_DIVIDES, RING_ASSOCIATES_REFL],
      ASM_REWRITE_TAC [ring_divides, ring_unit] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q "u:A") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SYM)) THEN
      ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC] THEN DISCH_TAC THEN
      MATCH_MP_TAC INTEGRAL_DOMAIN_MUL_LCANCEL THEN
      MAP_EVERY EXISTS_TAC [← q "r:A ring", ← q "x:A"] THEN
      ASM_SIMP_TAC [RING_1, RING_MUL_RID, RING_MUL] THEN
      ASM_MESON_TAC [RING_MUL_LZERO]])

  let INTEGRAL_DOMAIN_IRREDUCIBLE_ALT ← prove
   r"!r a:A.
        integral_domain r
        ==> (ring_irreducible r a <=>
             a IN ring_carrier r /\
             ~(a = ring_0 r) /\
             ~ring_unit r a /\
             !d. ring_divides r d a
                 ==> ring_unit r d \/ ring_associates r d a)"
   (SIMP_TAC [ring_associates, INTEGRAL_DOMAIN_IRREDUCIBLE])

  let INTEGRAL_DOMAIN_IRREDUCIBLE_DIVISORS ← prove
   r"!r a:A.
         integral_domain r
         ==> (ring_irreducible r a <=>
              a IN ring_carrier r /\
              ~(a = ring_0 r) /\
              ~ring_unit r a /\
              !b c. b IN ring_carrier r /\ c IN ring_carrier r /\
                    ring_mul r b c = a
                    ==> ring_divides r a b \/ ring_divides r a c)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [integral_domain, ring_irreducible] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q "b:A", ← q "c:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "b:A", ← q "c:A"]) THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_DIVIDES_MUL_SELF] THEN
    ASM_MESON_TAC [RING_MUL_LZERO, RING_MUL_RZERO])

  let RING_ASSOCIATES_IRREDUCIBLE ← prove
   r"!r a a':A.
        integral_domain r /\ ring_associates r a a'
        ==> (ring_irreducible r a <=> ring_irreducible r a')"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [INTEGRAL_DOMAIN_IRREDUCIBLE_ALT] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP RING_ASSOCIATES_IN_CARRIER) THEN
    ASM_REWRITE_TAC [] THEN
    BINOP_TAC THENL [ASM_MESON_TAC [RING_ASSOCIATES_EQ_0], ALL_TAC] THEN
    BINOP_TAC THENL [ASM_MESON_TAC [RING_ASSOCIATES_UNIT], ALL_TAC] THEN
    ASM_MESON_TAC [ring_divides, RING_ASSOCIATES_DIVIDES, RING_ASSOCIATES_REFL,
                   RING_ASSOCIATES_ASSOCIATES])

  let INTEGRAL_DOMAIN_DIVIDES_PRIME_LMUL ← prove
   r"!r p a b:A.
        integral_domain r /\ ring_prime r p /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ ~(ring_divides r p a)
        ==> (ring_divides r a (ring_mul r p b) <=> ring_divides r a b)"
   (REWRITE_TAC [ring_prime] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THEN ASM_SIMP_TAC [RING_DIVIDES_LMUL] THEN
    GEN_REWRITE_TAC LAND_CONV [ring_divides] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "x:A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "a:A", ← q "x:A"]) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_REFL], ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [ring_divides] THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q "y:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC) THEN
    ASM_REWRITE_TAC [ring_divides] THEN EXISTS_TAC (← q "y:A") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC INTEGRAL_DOMAIN_MUL_LCANCEL THEN
    MAP_EVERY EXISTS_TAC [← q "r:A ring", ← q "p:A"] THEN
    ASM_SIMP_TAC [RING_MUL] THEN ASM_SIMP_TAC [RING_MUL_AC])

  let INTEGRAL_DOMAIN_DIVIDES_PRIME_RMUL ← prove
   r"!r p a b:A.
        integral_domain r /\ ring_prime r p /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ ~(ring_divides r p a)
        ==> (ring_divides r a (ring_mul r b p) <=> ring_divides r a b)"
   (MESON_TAC [INTEGRAL_DOMAIN_DIVIDES_PRIME_LMUL, RING_MUL_SYM,
               RING_PRIME_IN_CARRIER])

  let RING_IRREDUCIBLE_DIVIDES_OR_COPRIME ← prove
   r"!r p a:A.
        ring_irreducible r p /\ a IN ring_carrier r
        ==> ring_divides r p a \/ ring_coprime r (p,a)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [ring_coprime, RING_IRREDUCIBLE_IN_CARRIER] THEN
    ASM_MESON_TAC [RING_NONUNIT_DIVIDES_IRREDUCIBLE, RING_ASSOCIATES_DIVIDES,
                   RING_ASSOCIATES_REFL])

  let RING_IRREDUCIBLE_COPRIME_EQ ← prove
   r"!r p a:A.
        ring_irreducible r p
        ==> (ring_coprime r (p,a) <=>
             a IN ring_carrier r /\ ~(ring_divides r p a))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [RING_COPRIME_IN_CARRIER]] THEN
    EQ_TAC THENL
     [GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [] THEN DISCH_TAC,
      ASM_MESON_TAC [RING_IRREDUCIBLE_DIVIDES_OR_COPRIME]] THEN
    ASM_REWRITE_TAC [ring_coprime] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q "p:A"))) THEN
    ASM_MESON_TAC [RING_DIVIDES_REFL, ring_irreducible])

  let RING_IRREDUCIBLES_COPRIME_OR_ASSOCIATES ← prove
   r"!r p q:A.
        ring_irreducible r p /\ ring_irreducible r q
        ==> ring_coprime r (p,q) \/ ring_associates r p q"
   (REWRITE_TAC [ring_associates] THEN
    MESON_TAC [RING_IRREDUCIBLE_DIVIDES_OR_COPRIME, RING_COPRIME_SYM,
               ring_irreducible])

  let INTEGRAL_DOMAIN_PRIME_DIVIDES_OR_COPRIME ← prove
   r"!r p a:A.
        integral_domain r /\ ring_prime r p /\ a IN ring_carrier r
        ==> ring_divides r p a \/ ring_coprime r (p,a)"
   (MESON_TAC [RING_IRREDUCIBLE_DIVIDES_OR_COPRIME,
               INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE])

  let INTEGRAL_DOMAIN_PRIME_COPRIME_EQ ← prove
   r"!r p a:A.
        integral_domain r /\ ring_prime r p
        ==> (ring_coprime r (p,a) <=>
             a IN ring_carrier r /\ ~(ring_divides r p a))"
   (MESON_TAC [RING_IRREDUCIBLE_COPRIME_EQ,
               INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE])

  let INTEGRAL_DOMAIN_PRIMES_COPRIME_OR_ASSOCIATES ← prove
   r"!r p q:A.
        integral_domain r /\ ring_prime r p /\ ring_prime r q
        ==> ring_coprime r (p,q) \/ ring_associates r p q"
   (MESON_TAC [RING_IRREDUCIBLES_COPRIME_OR_ASSOCIATES,
               INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE])

  let INTEGRAL_DOMAIN_PRIMES_DIVIDES_EQ_ASSOCIATES ← prove
   r"!r p q:A.
        integral_domain r /\ ring_prime r p /\ ring_prime r q
        ==> (ring_divides r p q <=> ring_associates r p q)"
   (MESON_TAC [ring_associates, INTEGRAL_DOMAIN_PRIMES_COPRIME_OR_ASSOCIATES,
               INTEGRAL_DOMAIN_PRIME_COPRIME_EQ])

  let RING_PRIME_ISOMORPHIC_IMAGE_EQ ← prove
   r"!r r' (f:A->B) a.
        ring_isomorphism(r,r') f /\ a IN ring_carrier r
        ==> (ring_prime r' (f a) <=> ring_prime r a)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_prime] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let ths := CONJUNCTS (← REWRITE_RULE [RING_ISOMORPHISM] th)
      match ths[1]? with
      | some t => pure (SUBST1_TAC (← SYM t))
      | none => throw "tl") THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [FUN_IN_IMAGE] THEN FIRST_ASSUM (fun th => tactic_of do
      pure (ASM_SIMP_TAC [← GSYM (← MATCH_MP RING_HOMOMORPHISM_MUL
          (← MATCH_MP RING_ISOMORPHISM_IMP_HOMOMORPHISM th))])) THEN
    FIRST_ASSUM (fun th => tactic_of do
     pure (ASM_SIMP_TAC [RING_MUL, ← MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          RING_DIVIDES_ISOMORPHIC_IMAGE_EQ) th])) THEN
    BINOP_TAC THENL [ALL_TAC, ASM_MESON_TAC [RING_UNIT_ISOMORPHIC_IMAGE_EQ]] THEN
    ASM_MESON_TAC [RING_MONOMORPHISM_ALT_EQ,
                   RING_ISOMORPHISM_IMP_MONOMORPHISM])

  let RING_IRREDUCIBLE_ISOMORPHIC_IMAGE_EQ ← prove
   r"!r r' (f:A->B) a.
        ring_isomorphism(r,r') f /\ a IN ring_carrier r
        ==> (ring_irreducible r' (f a) <=> ring_irreducible r a)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_irreducible] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let ths := CONJUNCTS (← REWRITE_RULE [RING_ISOMORPHISM] th)
      match ths[1]? with
      | some t => pure (SUBST1_TAC (← SYM t))
      | none => throw "tl") THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [FUN_IN_IMAGE] THEN FIRST_ASSUM (fun th => tactic_of do
      pure (ASM_SIMP_TAC [← GSYM (← MATCH_MP RING_HOMOMORPHISM_MUL
          (← MATCH_MP RING_ISOMORPHISM_IMP_HOMOMORPHISM th))])) THEN
    FIRST_ASSUM (fun th => tactic_of do
     pure (ASM_SIMP_TAC [← MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          RING_UNIT_ISOMORPHIC_IMAGE_EQ) th])) THEN
    BINOP_TAC THENL
     [ASM_MESON_TAC [RING_MONOMORPHISM_ALT_EQ, RING_ISOMORPHISM_IMP_MONOMORPHISM],
      ALL_TAC] THEN
    BINOP_TAC THENL [ASM_MESON_TAC [RING_UNIT_ISOMORPHIC_IMAGE_EQ], ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
     pure (ASM_SIMP_TAC [RING_MUL, ← MATCH_MP
      (← ONCE_REWRITE_RULE [IMP_CONJ] RING_MONOMORPHISM_INJECTIVE_EQ)
         (← MATCH_MP RING_ISOMORPHISM_IMP_MONOMORPHISM th)])))

  let RING_PRIME_MUL_DIVIDES ← prove
   r"!r a b x:A.
        ring_prime r a /\ ~(ring_divides r a b) /\
        ring_divides r a x /\ ring_divides r b x
        ==> ring_divides r (ring_mul r a b) x"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_divides]) THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q "ring_divides r a (x':A)") MP_TAC THENL
     [SUBGOAL_THEN (← q "ring_divides r a (ring_mul r b (x':A))") MP_TAC THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      ASM_MESON_TAC [RING_PRIME_DIVIDES_MUL, ring_prime],
      ASM_REWRITE_TAC [ring_divides] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [RING_MUL, ring_prime] THEN
      EXISTS_TAC (← q "x'':A") THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [RING_MUL_AC, RING_MUL, ring_prime]])

  let RING_PRIME_MUL_DIVIDES_EQ ← prove
   r"!r p q x:A.
        ring_prime r p /\ q IN ring_carrier r /\ ~(ring_divides r p q)
        ==> (ring_divides r (ring_mul r p q) x <=>
             ring_divides r p x /\ ring_divides r q x)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [RING_DIVIDES_RMUL_REV, RING_DIVIDES_LMUL_REV, ring_prime],
      ASM_MESON_TAC [RING_PRIME_MUL_DIVIDES]])

  let RING_PRIME_PRODUCT_DIVIDES ← prove
   r"!r p (s:K->bool) x:A.
        FINITE s /\
        x IN ring_carrier r /\
        (!i. i IN s ==> ring_prime r (p i)) /\
        pairwise (\i j. ~ring_divides r (p i) (p j)) s
        ==> (ring_divides r (ring_product r s p) x <=>
             !i. i IN s ==> ring_divides r (p i) x)"
   (GEN_TAC THEN GEN_TAC THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN GEN_TAC THEN
    ASM_CASES_TAC (← q "(x:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, NOT_IN_EMPTY, FORALL_IN_INSERT] THEN
    ASM_REWRITE_TAC [RING_DIVIDES_1, PAIRWISE_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q "i:K", ← q r"s:K->bool"] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_PRIME_IN_CARRIER) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC RING_PRIME_MUL_DIVIDES_EQ THEN
    ASM_REWRITE_TAC [RING_PRODUCT] THEN
    ASM_SIMP_TAC [RING_PRIME_DIVIDES_PRODUCT, RING_PRIME_IN_CARRIER] THEN
    ASM_MESON_TAC [])

  let INTEGRAL_DOMAIN_PRIME_PRODUCT_DIVIDES ← prove
   r"!r p (s:K->bool) x:A.
        integral_domain r /\
        FINITE s /\
        x IN ring_carrier r /\
        (!i. i IN s ==> ring_prime r (p i)) /\
        pairwise (\i j. ~ring_associates r (p i) (p j)) s
        ==> (ring_divides r (ring_product r s p) x <=>
             !i. i IN s ==> ring_divides r (p i) x)"
   (REWRITE_TAC [pairwise] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC RING_PRIME_PRODUCT_DIVIDES THEN
    ASM_REWRITE_TAC [pairwise] THEN
    ASM_MESON_TAC [INTEGRAL_DOMAIN_PRIMES_DIVIDES_EQ_ASSOCIATES])

  -- @@RETURN BEGIN
  return { ring_prime, ring_irreducible, RING_PRIME_IN_CARRIER,
           RING_IRREDUCIBLE_IN_CARRIER, RING_PRIME_NEG, RING_IRREDUCIBLE_NEG,
           RING_PRIME_IMP_NONTRIVIAL_RING, RING_IRREDUCIBLE_IMP_NONTRIVIAL_RING,
           FIELD_PRIME, FIELD_IRREDUCIBLE, RING_ASSOCIATES_PRIME,
           RING_NONUNIT_DIVIDES_IRREDUCIBLE, RING_PRIME_DIVIDES_IRREDUCIBLE,
           RING_PRIME_DIVIDES_MUL, RING_PRIME_DIVIDES_POW, RING_PRIME_DIVIDES_PRODUCT,
           INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE, INTEGRAL_DOMAIN_IRREDUCIBLE,
           INTEGRAL_DOMAIN_IRREDUCIBLE_ALT, INTEGRAL_DOMAIN_IRREDUCIBLE_DIVISORS,
           RING_ASSOCIATES_IRREDUCIBLE, INTEGRAL_DOMAIN_DIVIDES_PRIME_LMUL,
           INTEGRAL_DOMAIN_DIVIDES_PRIME_RMUL, RING_IRREDUCIBLE_DIVIDES_OR_COPRIME,
           RING_IRREDUCIBLE_COPRIME_EQ, RING_IRREDUCIBLES_COPRIME_OR_ASSOCIATES,
           INTEGRAL_DOMAIN_PRIME_DIVIDES_OR_COPRIME, INTEGRAL_DOMAIN_PRIME_COPRIME_EQ,
           INTEGRAL_DOMAIN_PRIMES_COPRIME_OR_ASSOCIATES,
           INTEGRAL_DOMAIN_PRIMES_DIVIDES_EQ_ASSOCIATES, RING_PRIME_ISOMORPHIC_IMAGE_EQ,
           RING_IRREDUCIBLE_ISOMORPHIC_IMAGE_EQ, RING_PRIME_MUL_DIVIDES,
           RING_PRIME_MUL_DIVIDES_EQ, RING_PRIME_PRODUCT_DIVIDES,
           INTEGRAL_DOMAIN_PRIME_PRODUCT_DIVIDES }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Prime factorizations are automatically unique.  (ringtheory.ml 9852-10101) -/
/- ------------------------------------------------------------------------- -/

structure Factorizations where
  -- @@FIELDS
  RING_DIVIDES_PRIMEFACTS_INJECTION : thm
  RING_DIVIDES_PRIMEFACTS_INJECTION_EQ : thm
  RING_DIVIDES_PRIMEFACTS_LE : thm
  RING_ASSOCIATES_PRIMEFACTS_BIJECTION : thm
  RING_ASSOCIATES_PRIMEFACTS_BIJECTIONS : thm
  RING_ASSOCIATES_PRIMEFACTS_BIJECTIONS_EQ : thm
  RING_ASSOCIATES_PRIMEFACTS_BIJECTION_EQ : thm
  RING_ASSOCIATES_PRIMEFACTS_EQ : thm
  RING_DIVIDES_PRIMEFACTS_LT : thm
  deriving Inhabited

@[nospecialize]
def setupFactorizations [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BProducts : Products) (BDivides : Divides) (BDomains : Domains) (BPrimes : Primes) :
    ExceptT String IO Factorizations := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, .. } := D
  let { CARD_CLAUSES, CARD_DELETE, CARD_IMAGE_INJ, CARD_PSUBSET, CARD_SUBSET, .. } := D.core1
  let { CONJ_ASSOC, EQ_IMP_LE, .. } := D.core2
  let { FINITE_DELETE, FINITE_DIFF, FINITE_IMAGE, FINITE_INDUCT_STRONG,
        FORALL_IN_IMAGE, FORALL_IN_INSERT, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INJECTIVE_ON_ALT, INJECTIVE_ON_LEFT_INVERSE, .. } := D.core4
  let { IN_DELETE, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, LET_TRANS, LE_0, LE_TRANS, .. } := D.core5
  let { MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.core7
  let { o_DEF, o_THM, .. } := D.core8
  let { RING_1, .. } := BBasics
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, RING_PRODUCT_IMAGE, RING_PRODUCT_RELATED,
        RING_PRODUCT_UNION, .. } := BProducts
  let { RING_ASSOCIATES_MUL, RING_ASSOCIATES_PRODUCT, RING_ASSOCIATES_REFL,
        RING_ASSOCIATES_SYM, RING_ASSOCIATES_TRANS, RING_DIVIDES_ASSOCIATES,
        RING_DIVIDES_MUL2, RING_DIVIDES_PRODUCT_SUBSET, RING_DIVIDES_REFL,
        RING_DIVIDES_RMUL2, RING_DIVIDES_RMUL_REV, RING_DIVIDES_TRANS,
        RING_UNIT_PRODUCT, ring_associates, .. } := BDivides
  let { INTEGRAL_DOMAIN_DIVIDES_ASSOCIATES_MUL_SELF, INTEGRAL_DOMAIN_DIVIDES_LMUL2,
        INTEGRAL_DOMAIN_PRODUCT_EQ_0, .. } := BDomains
  let { RING_IRREDUCIBLE_IN_CARRIER, RING_NONUNIT_DIVIDES_IRREDUCIBLE,
        RING_PRIME_DIVIDES_PRODUCT, RING_PRIME_IN_CARRIER, ring_irreducible,
        ring_prime, .. } := BPrimes
  -- @@SCOPE END

  let RING_DIVIDES_PRIMEFACTS_INJECTION ← prove
   r"!r s (f:K->A) t (g:L->A).
        integral_domain r /\
        FINITE s /\ (!i. i IN s ==> ring_prime r (f i)) /\
        FINITE t /\ (!j. j IN t ==> ring_irreducible r (g j)) /\
        ring_divides r (ring_product r s f) (ring_product r t g)
        ==> ?h. IMAGE h s SUBSET t /\
                (!i j. i IN s /\ j IN s /\ h i = h j ==> i = j) /\
                (!i. i IN s ==> ring_associates r (f i) (g(h i)))"
   (REWRITE_TAC [INJECTIVE_ON_ALT, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, CARD_CLAUSES, LE_0] THEN
    MAP_EVERY X_GEN_TAC [← q "i:K", ← q r"s:K->bool"] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"f:K->A") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"t:L->bool") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"g:L->A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:K->A")) THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
     [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    DISCH_TAC THEN ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, RING_PRIME_IN_CARRIER] THEN
    DISCH_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     (← REWRITE_RULE [CONJ_ASSOC] RING_DIVIDES_RMUL_REV))) THEN
    ASM_SIMP_TAC [RING_PRODUCT, RING_PRIME_IN_CARRIER] THEN
    ASM_SIMP_TAC [RING_PRIME_DIVIDES_PRODUCT, RING_IRREDUCIBLE_IN_CARRIER] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "j:L") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "t DELETE (j:L)", ← q r"g:L->A"]) THEN
    ASM_SIMP_TAC [FINITE_DELETE, IN_DELETE, CARD_DELETE, CARD_CLAUSES] THEN
    SUBGOAL_THEN (← q r"ring_associates r ((f:K->A) i) ((g:L->A) j)") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_NONUNIT_DIVIDES_IRREDUCIBLE, ring_prime], ALL_TAC] THEN
    ANTS_TAC THENL
     [ALL_TAC,
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:K->L") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\k. if k = i then j else (h:K->L) k") THEN
      ASM SET_TAC []] THEN
    SUBGOAL_THEN
     (← q r"ring_divides r (ring_mul r (f i) (ring_product r s (f:K->A)))
                   (ring_mul r (f i) (ring_product r (t DELETE (j:L)) g))")
    MP_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_DIVIDES_LMUL2,
                    RING_PRIME_IN_CARRIER, RING_PRODUCT] THEN
      ASM_MESON_TAC [ring_prime]] THEN
    TRANS_TAC RING_DIVIDES_TRANS
     (← q r"ring_mul r ((g:L->A) j) (ring_product r (t DELETE j) g)") THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          RING_DIVIDES_TRANS)) THEN
      MATCH_MP_TAC (← MESON [RING_DIVIDES_REFL]
       (← q r"a IN ring_carrier r /\ b = a ==> ring_divides r a b")) THEN
      REWRITE_TAC [RING_PRODUCT] THEN
      ABBREV_TAC (← q r"u = t DELETE (j:L)") THEN
      SUBGOAL_THEN (← q r"t = (j:L) INSERT u") SUBST1_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      EXPAND_TAC "u" THEN
      ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, FINITE_DELETE] THEN
      EXPAND_TAC "u" THEN REWRITE_TAC [IN_DELETE] THEN
      ASM_SIMP_TAC [RING_IRREDUCIBLE_IN_CARRIER],
      MATCH_MP_TAC RING_DIVIDES_RMUL2 THEN REWRITE_TAC [RING_PRODUCT] THEN
      MATCH_MP_TAC RING_DIVIDES_ASSOCIATES THEN
      ONCE_REWRITE_TAC [RING_ASSOCIATES_SYM] THEN
      ASM_REWRITE_TAC []])

  let RING_DIVIDES_PRIMEFACTS_INJECTION_EQ ← prove
   r"!r s (f:K->A) t (g:L->A).
        integral_domain r /\
        FINITE s /\ (!i. i IN s ==> ring_prime r (f i)) /\
        FINITE t /\ (!j. j IN t ==> ring_irreducible r (g j))
        ==> (ring_divides r (ring_product r s f) (ring_product r t g) <=>
             ?h. IMAGE h s SUBSET t /\
                 (!i j. i IN s /\ j IN s /\ h i = h j ==> i = j) /\
                 (!i. i IN s ==> ring_associates r (f i) (g(h i))))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN MATCH_MP_TAC RING_DIVIDES_PRIMEFACTS_INJECTION THEN
      ASM_REWRITE_TAC [],
      REWRITE_TAC [INJECTIVE_ON_ALT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:K->L") STRIP_ASSUME_TAC)] THEN
    TRANS_TAC RING_DIVIDES_TRANS
     (← q r"ring_product r (IMAGE (h:K->L) s) (g:L->A)") THEN
    ASM_SIMP_TAC [RING_DIVIDES_PRODUCT_SUBSET] THEN
    wPart rand (fun t => do lhand (← rand t)) RING_PRODUCT_IMAGE THEN
    ASM_REWRITE_TAC [INJECTIVE_ON_ALT] THEN DISCH_THEN SUBST1_TAC THEN
    MATCH_MP_TAC RING_PRODUCT_RELATED THEN
    ASM_REWRITE_TAC [RING_DIVIDES_REFL, RING_1, o_THM] THEN
    SIMP_TAC [RING_DIVIDES_MUL2] THEN RULE_ASSUM_TAC
     (REWRITE_RULE [ring_associates, ring_prime, ring_irreducible]) THEN
    ASM SET_TAC [])

  let RING_DIVIDES_PRIMEFACTS_LE ← prove
   r"!r s (f:K->A) t (g:L->A).
        integral_domain r /\
        FINITE s /\ (!i. i IN s ==> ring_prime r (f i)) /\
        FINITE t /\ (!j. j IN t ==> ring_irreducible r (g j)) /\
        ring_divides r (ring_product r s f) (ring_product r t g)
        ==> CARD s <= CARD t"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_DIVIDES_PRIMEFACTS_INJECTION) THEN
    REWRITE_TAC [INJECTIVE_ON_ALT, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:K->L") THEN DISCH_TAC THEN
    TRANS_TAC LE_TRANS (← q r"CARD(IMAGE (h:K->L) s)") THEN
    ASM_SIMP_TAC [CARD_SUBSET] THEN MATCH_MP_TAC EQ_IMP_LE THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARD_IMAGE_INJ THEN
    ASM_REWRITE_TAC [INJECTIVE_ON_ALT])

  let RING_ASSOCIATES_PRIMEFACTS_BIJECTION ← prove
   r"!r s (f:K->A) t (g:L->A).
        integral_domain r /\
        FINITE s /\ (!i. i IN s ==> ring_prime r (f i)) /\
        FINITE t /\ (!j. j IN t ==> ring_irreducible r (g j)) /\
        ring_associates r (ring_product r s f) (ring_product r t g)
        ==> ?h. IMAGE h s = t /\
                (!i j. i IN s /\ j IN s /\ h i = h j ==> i = j) /\
                (!i. i IN s ==> ring_associates r (f i) (g(h i)))"
   (← do
    -- right to left: the THENL list's two SET_RULEs (second first), then the
    -- MATCH_MP_TAC SET_RULE
    let s3 ← SET_RULE (← q r"s SUBSET t ==> s UNION (t DIFF s) = t")
    let s2 ← SET_RULE (← q r"DISJOINT s (t DIFF s)")
    let s1 ← SET_RULE (← q r"s SUBSET t /\ (~(t DIFF s = {}) ==> F) ==> s = t")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:K->bool", ← q r"f:K->A", ← q r"t:L->bool",
                     ← q r"g:L->A"]
          RING_DIVIDES_PRIMEFACTS_INJECTION) THEN
    REWRITE_TAC [INJECTIVE_ON_ALT] THEN
    ASM_SIMP_TAC [RING_DIVIDES_ASSOCIATES] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h:K->L") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC s1 THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
      (← q r"ring_associates r
        (ring_product r s (f:K->A))
        (ring_mul r (ring_product r s f)
                    (ring_product r (t DIFF IMAGE (h:K->L) s) g))")
    MP_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_DIVIDES_ASSOCIATES_MUL_SELF, RING_PRODUCT,
         RING_UNIT_PRODUCT, FINITE_DIFF, INTEGRAL_DOMAIN_PRODUCT_EQ_0] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [ring_prime, ring_irreducible]) THEN
      ASM SET_TAC []] THEN
    TRANS_TAC RING_ASSOCIATES_TRANS
     (← q r"ring_mul r (ring_product r (IMAGE h s) g)
               (ring_product r (t DIFF IMAGE (h:K->L) s) g):A") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [← GSYM RING_PRODUCT_UNION, FINITE_DIFF, FINITE_IMAGE, s2] THEN
      ASM_SIMP_TAC [s3],
      MATCH_MP_TAC RING_ASSOCIATES_MUL THEN
      REWRITE_TAC [RING_ASSOCIATES_REFL, RING_PRODUCT] THEN
      ASM_SIMP_TAC [RING_PRODUCT_IMAGE, INJECTIVE_ON_ALT] THEN
      MATCH_MP_TAC RING_ASSOCIATES_PRODUCT THEN
      ASM_REWRITE_TAC [o_DEF] THEN ASM_MESON_TAC [RING_ASSOCIATES_SYM]]))

  let RING_ASSOCIATES_PRIMEFACTS_BIJECTIONS ← prove
   r"!r s (f:K->A) t (g:L->A).
        integral_domain r /\
        FINITE s /\ (!i. i IN s ==> ring_prime r (f i)) /\
        FINITE t /\ (!j. j IN t ==> ring_irreducible r (g j)) /\
        ring_associates r (ring_product r s f) (ring_product r t g)
        ==> ?h k. IMAGE h s = t /\ IMAGE k t = s /\
                  (!i. i IN s ==> k(h i) = i) /\
                  (!j. j IN t ==> h(k j) = j) /\
                  (!i. i IN s ==> ring_associates r (f i) (g(h i))) /\
                  (!j. j IN t ==> ring_associates r (g j) (f(k j)))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP RING_ASSOCIATES_PRIMEFACTS_BIJECTION) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h:K->L") THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE, LEFT_AND_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"k:L->K") THEN
    GEN_REWRITE_TAC (funpow 6 RAND_CONV o ONCE_DEPTH_CONV)
     [RING_ASSOCIATES_SYM] THEN
    SET_TAC [])

  let RING_ASSOCIATES_PRIMEFACTS_BIJECTIONS_EQ ← prove
   r"!r s (f:K->A) t (g:L->A).
        integral_domain r /\
        FINITE s /\ (!i. i IN s ==> ring_prime r (f i)) /\
        FINITE t /\ (!j. j IN t ==> ring_irreducible r (g j))
        ==> (ring_associates r (ring_product r s f) (ring_product r t g) <=>
             ?h k. IMAGE h s = t /\ IMAGE k t = s /\
                   (!i. i IN s ==> k(h i) = i) /\
                   (!j. j IN t ==> h(k j) = j) /\
                   (!i. i IN s ==> ring_associates r (f i) (g(h i))) /\
                   (!j. j IN t ==> ring_associates r (g j) (f(k j))))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [RING_ASSOCIATES_PRIMEFACTS_BIJECTIONS] THEN STRIP_TAC THEN
    UNDISCH_THEN (← q r"IMAGE (h:K->L) s = t") (SUBST1_TAC o SYM) THEN
    wPart rand (fun t => do lhand (← rand t)) RING_PRODUCT_IMAGE THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC RING_ASSOCIATES_PRODUCT THEN ASM_REWRITE_TAC [o_THM])

  let RING_ASSOCIATES_PRIMEFACTS_BIJECTION_EQ ← prove
   r"!r s (f:K->A) t (g:L->A).
        integral_domain r /\
        FINITE s /\ (!i. i IN s ==> ring_prime r (f i)) /\
        FINITE t /\ (!j. j IN t ==> ring_irreducible r (g j))
        ==> (ring_associates r (ring_product r s f) (ring_product r t g) <=>
             ?h. IMAGE h s = t /\
                 (!i j. i IN s /\ j IN s /\ h i = h j ==> i = j) /\
                 (!i. i IN s ==> ring_associates r (f i) (g(h i))))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [RING_ASSOCIATES_PRIMEFACTS_BIJECTIONS_EQ] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE, LEFT_AND_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o funpow 5 RAND_CONV o ONCE_DEPTH_CONV)
     [RING_ASSOCIATES_SYM] THEN
    ASM SET_TAC [])

  let RING_ASSOCIATES_PRIMEFACTS_EQ ← prove
   r"!r s (f:K->A) t (g:L->A).
        integral_domain r /\
        FINITE s /\ (!i. i IN s ==> ring_prime r (f i)) /\
        FINITE t /\ (!j. j IN t ==> ring_irreducible r (g j)) /\
        ring_associates r (ring_product r s f) (ring_product r t g)
        ==> CARD s = CARD t"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_ASSOCIATES_PRIMEFACTS_BIJECTION) THEN
    REWRITE_TAC [INJECTIVE_ON_ALT] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC CARD_IMAGE_INJ THEN ASM_MESON_TAC [])

  let RING_DIVIDES_PRIMEFACTS_LT ← prove
   r"!r s (f:K->A) t (g:L->A).
        integral_domain r /\
        FINITE s /\ (!i. i IN s ==> ring_prime r (f i)) /\
        FINITE t /\ (!j. j IN t ==> ring_irreducible r (g j)) /\
        ring_divides r (ring_product r s f) (ring_product r t g) /\
        ~(ring_divides r (ring_product r t g) (ring_product r s f))
        ==> CARD s < CARD t"
   (← do
    -- right to left: the second MESON first
    let m2 ← MESON [] (← q r"(?x. P x) /\ ~(?x. Q x) ==> ?x. P x /\ ~Q x")
    let m1 ← MESON [ring_associates]
     (← q r"ring_divides r x y /\ ~(ring_divides r y x) <=>
    ring_divides r x y /\ ~(ring_associates r x y)")
    pure (REPEAT GEN_TAC THEN
    REPLICATE_TAC 5 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [m1] THEN
    ASM_SIMP_TAC [RING_DIVIDES_PRIMEFACTS_INJECTION_EQ,
                  RING_ASSOCIATES_PRIMEFACTS_BIJECTION_EQ] THEN
    DISCH_THEN (MP_TAC o MATCH_MP m2) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, INJECTIVE_ON_ALT] THEN
    X_GEN_TAC (← q r"h:K->L") THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    TRANS_TAC LET_TRANS (← q r"CARD(IMAGE (h:K->L) s)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC CARD_IMAGE_INJ THEN ASM_MESON_TAC [],
      MATCH_MP_TAC CARD_PSUBSET THEN ASM SET_TAC []]))

  -- @@RETURN BEGIN
  return { RING_DIVIDES_PRIMEFACTS_INJECTION, RING_DIVIDES_PRIMEFACTS_INJECTION_EQ,
           RING_DIVIDES_PRIMEFACTS_LE, RING_ASSOCIATES_PRIMEFACTS_BIJECTION,
           RING_ASSOCIATES_PRIMEFACTS_BIJECTIONS,
           RING_ASSOCIATES_PRIMEFACTS_BIJECTIONS_EQ,
           RING_ASSOCIATES_PRIMEFACTS_BIJECTION_EQ, RING_ASSOCIATES_PRIMEFACTS_EQ,
           RING_DIVIDES_PRIMEFACTS_LT }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Squarefree elements; multiplicative systems.  (ringtheory.ml 10102-10345) -/
/- ------------------------------------------------------------------------- -/

structure Squarefree where
  -- @@FIELDS
  ring_squarefree : thm
  RING_SQUAREFREE_IN_CARRIER : thm
  RING_UNIT_IMP_SQUAREFREE : thm
  RING_SQUAREFREE_1 : thm
  RING_SQUAREFREE_DIVISOR : thm
  RING_SQUAREFREE_ASSOCIATES : thm
  RING_SQUAREFREE_0 : thm
  RING_SQUAREFREE_IMP_NONZERO : thm
  RING_IRREDUCIBLE_IMP_SQUAREFREE : thm
  RING_PRIME_IMP_SQUAREFREE : thm
  RING_SQUAREFREE_IMP_NO_PRIME_SQUARE : thm
  RING_SQUAREFREE_COPRIME : thm
  RING_SQUAREFREE_COPRIME_DIVISORS : thm
  RING_SQUAREFREE_MUL_IMP : thm
  RING_SQUAREFREE_POW : thm
  ring_multsys : thm
  RING_MULTSYS : thm
  RING_MULTSYS_IMP_SUBSET : thm
  RING_MULTSYS_IMP_NONEMPTY : thm
  RING_MULYSYS_1 : thm
  RING_MULYSYS_CARRIER : thm
  RING_MULTSYS_REGULAR : thm
  RING_MULTSYS_NONZERO : thm
  RING_MULTSYS_POWERS : thm
  RING_MULTSYS_UNITS : thm
  RING_MULTSYS_IDEMPOT : thm
  RING_MULTSYS_INTERS : thm
  RING_MULTSYS_INTER : thm
  RING_POW_IN_MULTSYS : thm
  RING_MULTSYS_NILPOTENT_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupSquarefree [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BDomains : Domains) (BPrimes : Primes) :
    ExceptT String IO Squarefree := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_TAC,
        new_definition, .. } := D
  let { DE_MORGAN_THM, EMPTY_SUBSET, .. } := D.core2
  let { FORALL_IN_GSPEC, FORALL_IN_INSERT, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, INSERT_SUBSET, .. } := D.core4
  let { IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_INTERS, IN_SING, IN_UNIV, .. } := D.core5
  let { NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_REFL, .. } := D.core7
  let { RING_0, RING_1, RING_MUL, RING_MUL_ASSOC, RING_MUL_LID, RING_MUL_RID,
        trivial_ring, .. } := BBasics
  let { RING_POW, RING_POW_1, RING_POW_2, RING_POW_ADD, ring_pow, .. } := BNumbers
  let { RING_DIVIDES_0, RING_DIVIDES_LMUL, RING_DIVIDES_MUL2, RING_DIVIDES_REFL,
        RING_DIVIDES_RMUL, RING_DIVIDES_TRANS, RING_NILPOTENT_0, RING_REGULAR_1,
        RING_REGULAR_MUL, RING_UNIT_0, RING_UNIT_1, RING_UNIT_DIVISOR, RING_UNIT_MUL,
        RING_UNIT_POW, RING_UNIT_POW_EQ, ring_associates, ring_coprime, ring_divides,
        ring_nilpotent, ring_regular, ring_unit, .. } := BDivides
  let { integral_domain, .. } := BDomains
  let { INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE, ring_irreducible, ring_prime, .. } := BPrimes
  -- @@SCOPE END

  let ring_squarefree ← new_definition
   r"ring_squarefree (r:A ring) (a:A) <=>
  a IN ring_carrier r /\
  !q. q IN ring_carrier r /\ ring_divides r (ring_pow r q 2) a
      ==> ring_unit r q"

  let RING_SQUAREFREE_IN_CARRIER ← prove
   r"!r (a:A). ring_squarefree r a ==> a IN ring_carrier r"
   (SIMP_TAC [ring_squarefree])

  let RING_UNIT_IMP_SQUAREFREE ← prove
   r"!r (a:A). ring_unit r a ==> ring_squarefree r a"
   (REWRITE_TAC [ring_squarefree] THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [ring_unit],
      MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "ring_pow r (q:A) 2"]
        RING_UNIT_DIVISOR) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      ASM_MESON_TAC [RING_UNIT_POW_EQ, ← ARITH_RULE (← q "~(2 = 0)")]])

  let RING_SQUAREFREE_1 ← prove
   r"!r:A ring. ring_squarefree r (ring_1 r)"
   (MESON_TAC [RING_UNIT_IMP_SQUAREFREE, RING_UNIT_1])

  let RING_SQUAREFREE_DIVISOR ← prove
   r"!r d (a:A).
        ring_squarefree r a /\ ring_divides r d a
        ==> ring_squarefree r d"
   (REWRITE_TAC [ring_squarefree] THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [ring_divides],
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [RING_DIVIDES_TRANS]])

  let RING_SQUAREFREE_ASSOCIATES ← prove
   r"!r a (b:A).
        ring_associates r a b
        ==> (ring_squarefree r a <=> ring_squarefree r b)"
   (MESON_TAC [RING_SQUAREFREE_DIVISOR, ring_associates])

  let RING_SQUAREFREE_0 ← prove
   r"!r:A ring. ring_squarefree r (ring_0 r) <=> trivial_ring r"
   (GEN_TAC THEN REWRITE_TAC [ring_squarefree, RING_0, RING_DIVIDES_0] THEN
    SIMP_TAC [IMP_CONJ, RING_POW] THEN EQ_TAC THENL
     [MESON_TAC [RING_UNIT_0, RING_0],
      SIMP_TAC [trivial_ring, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
      REWRITE_TAC [RING_UNIT_0, trivial_ring]])

  let RING_SQUAREFREE_IMP_NONZERO ← prove
   r"!r (a:A). ~trivial_ring r /\ ring_squarefree r a ==> ~(a = ring_0 r)"
   (MESON_TAC [RING_SQUAREFREE_0])

  let RING_IRREDUCIBLE_IMP_SQUAREFREE ← prove
   r"!r (a:A). ring_irreducible r a ==> ring_squarefree r a"
   (REWRITE_TAC [ring_irreducible, ring_squarefree] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q "q:A") THEN STRIP_TAC THEN
    UNDISCH_TAC (← q "ring_divides r (ring_pow r (q:A) 2) a") THEN
    ASM_SIMP_TAC [ring_divides, RING_POW_2, RING_MUL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "e:A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "q:A", ← q "ring_mul r (q:A) e"]) THEN
    ASM_SIMP_TAC [RING_MUL, RING_MUL_ASSOC] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [RING_UNIT_DIVISOR, RING_DIVIDES_RMUL, RING_DIVIDES_REFL])

  let RING_PRIME_IMP_SQUAREFREE ← prove
   r"!r (a:A). integral_domain r /\ ring_prime r a ==> ring_squarefree r a"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_IRREDUCIBLE_IMP_SQUAREFREE THEN
    ASM_MESON_TAC [INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE])

  let RING_SQUAREFREE_IMP_NO_PRIME_SQUARE ← prove
   r"!r a p:A.
        ring_squarefree r a /\ ring_prime r p
        ==> ~ring_divides r (ring_pow r p 2) a"
   (REWRITE_TAC [ring_squarefree] THEN MESON_TAC [ring_prime])

  let RING_SQUAREFREE_COPRIME ← prove
   r"!r (a:A).
     ring_squarefree r a <=>
     a IN ring_carrier r /\
     !b c. b IN ring_carrier r /\ c IN ring_carrier r /\ ring_mul r b c = a
           ==> ring_coprime r (b,c)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [ring_squarefree] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REPEAT GEN_TAC THEN STRIP_TAC THEN
      REWRITE_TAC [ring_coprime] THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [ring_divides, RING_DIVIDES_MUL2, RING_POW_2],
      STRIP_TAC THEN REWRITE_TAC [ring_squarefree] THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q "q:A") THEN STRIP_TAC THEN
      UNDISCH_TAC (← q "ring_divides r (ring_pow r (q:A) 2) a") THEN
      ASM_SIMP_TAC [RING_POW_2, ring_divides, RING_MUL] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q "q:A", ← q "ring_mul r (q:A) x"]) THEN
      ASM_SIMP_TAC [RING_MUL, RING_MUL_ASSOC] THEN
      REWRITE_TAC [ring_coprime] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [RING_DIVIDES_REFL, RING_DIVIDES_RMUL]])

  let RING_SQUAREFREE_COPRIME_DIVISORS ← prove
   r"!r (a:A).
     ring_squarefree r a <=>
     a IN ring_carrier r /\
     !b c. b IN ring_carrier r /\ c IN ring_carrier r /\
           ring_divides r (ring_mul r b c) a
           ==> ring_coprime r (b,c)"
   (GEN_TAC THEN GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THENL
       [ASM_MESON_TAC [RING_SQUAREFREE_IN_CARRIER], ALL_TAC] THEN
      ASM_MESON_TAC [RING_SQUAREFREE_DIVISOR, RING_SQUAREFREE_COPRIME, RING_MUL],
      STRIP_TAC THEN REWRITE_TAC [ring_squarefree] THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [RING_POW_2, ring_coprime, RING_DIVIDES_REFL]])

  let RING_SQUAREFREE_MUL_IMP ← prove
   r"!r a (b:A).
        a IN ring_carrier r /\ b IN ring_carrier r /\
        ring_squarefree r (ring_mul r a b)
        ==> ring_coprime r (a,b) /\
            ring_squarefree r a /\ ring_squarefree r b"
   (MESON_TAC [RING_SQUAREFREE_COPRIME, RING_SQUAREFREE_DIVISOR,
               RING_DIVIDES_RMUL, RING_DIVIDES_LMUL, RING_DIVIDES_REFL])

  let RING_SQUAREFREE_POW ← prove
   r"!r (a:A) k.
        a IN ring_carrier r
        ==> (ring_squarefree r (ring_pow r a k) <=>
             ring_unit r a \/ k = 0 \/ ring_squarefree r a /\ k = 1)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q "ring_unit r (a:A)") THENL
     [ASM_SIMP_TAC [RING_UNIT_IMP_SQUAREFREE, RING_UNIT_POW], ALL_TAC] THEN
    ASM_CASES_TAC (← q "k = 0") THENL
     [ASM_REWRITE_TAC [ring_pow, RING_SQUAREFREE_1], ALL_TAC] THEN
    ASM_CASES_TAC (← q "k = 1") THENL
     [ASM_SIMP_TAC [RING_POW_1], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [ring_squarefree, DE_MORGAN_THM, NOT_FORALL_THM, NOT_IMP] THEN
    DISJ2_TAC THEN EXISTS_TAC (← q "a:A") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q "k = 2 + (k - 2)") SUBST1_TAC THENL
     [ASM_ARITH_TAC, ALL_TAC] THEN
    ASM_SIMP_TAC [RING_POW_ADD] THEN
    ASM_MESON_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_REFL, RING_POW])

  let ring_multsys ← new_definition
   r"ring_multsys (r:A ring) s <=>
        s SUBSET ring_carrier r /\
        ring_1 r IN s /\
        (!x y. x IN s /\ y IN s ==> ring_mul r x y IN s)"

  let RING_MULTSYS ← prove
   r"(!r s x:A. ring_multsys r s /\ x IN s ==> x IN ring_carrier r) /\
   (!r s:A->bool. ring_multsys r s ==> ring_1 r IN s) /\
   (!r s x y:A. ring_multsys r s /\ x IN s /\ y IN s
                ==> ring_mul r x y IN s)"
   (REWRITE_TAC [ring_multsys] THEN SET_TAC [])

  let RING_MULTSYS_IMP_SUBSET ← prove
   r"!r s:A->bool. ring_multsys r s ==> s SUBSET ring_carrier r"
   (SIMP_TAC [ring_multsys])

  let RING_MULTSYS_IMP_NONEMPTY ← prove
   r"!r s:A->bool. ring_multsys r s ==> ~(s = {})"
   (MESON_TAC [ring_multsys, NOT_IN_EMPTY])

  let RING_MULYSYS_1 ← prove
   r"!r:A ring. ring_multsys r {ring_1 r}"
   (GEN_TAC THEN REWRITE_TAC [ring_multsys, SING_SUBSET, IN_SING] THEN
    SIMP_TAC [RING_1, RING_MUL_LID])

  let RING_MULYSYS_CARRIER ← prove
   r"!r:A ring. ring_multsys r (ring_carrier r)"
   (GEN_TAC THEN REWRITE_TAC [ring_multsys, SUBSET_REFL] THEN
    SIMP_TAC [RING_1, RING_MUL])

  let RING_MULTSYS_REGULAR ← prove
   r"!r:A ring.
        ring_multsys r {a | ring_regular r a}"
   (GEN_TAC THEN REWRITE_TAC [ring_multsys, IN_ELIM_THM] THEN
    REWRITE_TAC [RING_REGULAR_MUL, RING_REGULAR_1] THEN
    REWRITE_TAC [ring_regular] THEN SET_TAC [])

  let RING_MULTSYS_NONZERO ← prove
   r"!r:A ring.
        ring_multsys r (ring_carrier r DIFF {ring_0 r}) <=>
        integral_domain r"
   (REWRITE_TAC [ring_multsys, IN_DIFF, IN_SING, integral_domain] THEN
    GEN_TAC THEN SIMP_TAC [RING_MUL, RING_1] THEN SET_TAC [])

  let RING_MULTSYS_POWERS ← prove
   r"!r x:A. x IN ring_carrier r
           ==> ring_multsys r {ring_pow r x n | n IN (:num)}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_multsys] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC, IN_UNIV] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_SIMP_TAC [← GSYM RING_POW_ADD] THEN
    ASM_MESON_TAC [RING_POW, ring_pow])

  let RING_MULTSYS_UNITS ← prove
   r"!r:A ring. ring_multsys r {u | ring_unit r u}"
   (SIMP_TAC [ring_multsys, IN_ELIM_THM, SUBSET, RING_UNIT_MUL, RING_UNIT_1] THEN
    SIMP_TAC [ring_unit])

  let RING_MULTSYS_IDEMPOT ← prove
   r"!r x:A.
        x IN ring_carrier r /\ ring_mul r x x = x
        ==> ring_multsys r {ring_1 r,x}"
   (REWRITE_TAC [ring_multsys, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, IMP_IMP] THEN
    SIMP_TAC [IN_INSERT, NOT_IN_EMPTY, INSERT_SUBSET, EMPTY_SUBSET] THEN
    SIMP_TAC [RING_1, RING_MUL_LID, RING_MUL_RID])

  let RING_MULTSYS_INTERS ← prove
   r"!r gs.
         (!g. g IN gs ==> ring_multsys r g) /\ ~(gs = {})
         ==> ring_multsys r (INTERS gs)"
   (REWRITE_TAC [ring_multsys, SUBSET, IN_INTERS] THEN SET_TAC [])

  let RING_MULTSYS_INTER ← prove
   r"!r s t:A->bool.
        ring_multsys r s /\ ring_multsys r t ==> ring_multsys r (s INTER t)"
   (REWRITE_TAC [ring_multsys] THEN SET_TAC [])

  let RING_POW_IN_MULTSYS ← prove
   r"!r s (x:A) n.
        ring_multsys r s /\ x IN s ==> ring_pow r x n IN s"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM, ring_multsys] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [ring_pow])

  let RING_MULTSYS_NILPOTENT_EXISTS ← prove
   r"!r s:A->bool.
        ring_multsys r s
        ==> ((?x. ring_nilpotent r x /\ x IN s) <=> ring_0 r IN s)"
   (REPEAT STRIP_TAC THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC [RING_NILPOTENT_0]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "x:A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_nilpotent]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "n:num")
     (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM))) THEN
    ASM_SIMP_TAC [RING_POW_IN_MULTSYS])

  -- @@RETURN BEGIN
  return { ring_squarefree, RING_SQUAREFREE_IN_CARRIER, RING_UNIT_IMP_SQUAREFREE,
           RING_SQUAREFREE_1, RING_SQUAREFREE_DIVISOR, RING_SQUAREFREE_ASSOCIATES,
           RING_SQUAREFREE_0, RING_SQUAREFREE_IMP_NONZERO,
           RING_IRREDUCIBLE_IMP_SQUAREFREE, RING_PRIME_IMP_SQUAREFREE,
           RING_SQUAREFREE_IMP_NO_PRIME_SQUARE, RING_SQUAREFREE_COPRIME,
           RING_SQUAREFREE_COPRIME_DIVISORS, RING_SQUAREFREE_MUL_IMP,
           RING_SQUAREFREE_POW, ring_multsys, RING_MULTSYS, RING_MULTSYS_IMP_SUBSET,
           RING_MULTSYS_IMP_NONEMPTY, RING_MULYSYS_1, RING_MULYSYS_CARRIER,
           RING_MULTSYS_REGULAR, RING_MULTSYS_NONZERO, RING_MULTSYS_POWERS,
           RING_MULTSYS_UNITS, RING_MULTSYS_IDEMPOT, RING_MULTSYS_INTERS,
           RING_MULTSYS_INTER, RING_POW_IN_MULTSYS, RING_MULTSYS_NILPOTENT_EXISTS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Localization, special case of total ring or field of fractions.          -/
/- (ringtheory.ml 10346-11481)                                               -/
/- ------------------------------------------------------------------------- -/

structure Localization where
  -- @@FIELDS
  ring_localequiv : thm
  RING_LOCALEQUIV : thm
  RING_LOCALEQUIV_REFL : thm
  RING_LOCALEQUIV_SYM : thm
  RING_LOCALEQUIV_TRANS : thm
  RING_LOCALEQUIV_EQUIV : thm
  RING_LOCALEQUIV_NEG : thm
  RING_LOCALEQUIV_ADD : thm
  RING_LOCALEQUIV_MUL : thm
  ring_localization : thm
  RING_LOCALIZATION : thm
  RING_LOCALIZATION_NEG : thm
  RING_LOCALIZATION_ADD : thm
  RING_LOCALIZATION_MUL : thm
  RING_LOCALIZATION_CARRIER : thm
  RING_LOCALIZATION_0 : thm
  RING_LOCALIZATION_1 : thm
  TRIVIAL_RING_LOCALIZATION : thm
  RING_LOCALEQUIV_IN_CARRIER : thm
  RING_UNIT_LOCALEQUIV : thm
  RING_UNIT_LOCALEQUIV_EQ : thm
  RING_UNIT_LOCALIZATION : thm
  RING_LOCALEQUIV_EQ_0_GEN : thm
  RING_IDEAL_LOCALIZATION : thm
  ring_fractionate : thm
  RING_FRACTIONATE_IN_CARRIER : thm
  RING_UNIT_FRACTIONATE : thm
  RING_FRACTIONATE_EQ_0_GEN : thm
  RING_HOMOMORPHISM_FRACTIONATE : thm
  RING_MONOMORPHISM_FRACTIONATE_GEN : thm
  RING_ISOMORPHISM_FRACTIONATE_GEN : thm
  RING_LOCALIZATION_UNCHANGED : thm
  RING_LOCALIZATION_UNIVERSAL : thm
  RING_LOCALEQUIV_SPLIT_EXPLICIT : thm
  RING_LOCALEQUIV_SPLIT : thm
  LOCALEQUIV_MUL_RCANCEL : thm
  LOCALEQUIV_MUL_LCANCEL : thm
  RING_LOCALIZATION_HOMOMORPHISM_UNIQUE : thm
  RING_LOCALIZATION_UNIQUE : thm
  IDEAL_LOCALIZATION_CONTRACTION : thm
  IDEAL_GENERATED_RING_LOCALIZATION : thm
  fraction_ring : thm
  RING_LOCALEQUIV_EQ_0 : thm
  RING_FRACTIONATE_EQ_0 : thm
  RING_MONOMORPHISM_FRACTIONATE : thm
  FRACTION_RING_UNIVERSAL : thm
  RING_UNIT_FRACTION_RING : thm
  RING_ZERODIVISOR_FRACTION_RING : thm
  FRACTION_RING_UNIT_EQ_REGULAR : thm
  FRACTION_RING_UNIT_OR_ZERODIVISOR : thm
  TRIVIAL_FRACTION_RING : thm
  FRACTION_FIELD : thm
  FRACTION_DOMAIN : thm
  INTEGRAL_DOMAIN_LOCALIZATION : thm
  deriving Inhabited

@[nospecialize]
def setupLocalization [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BRingRule : RingRule) (BSquarefree : Squarefree) :
    ExceptT String IO Localization := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_METIS_TAC, MESON, MESON_TAC, SET_TAC, basic_ss,
        new_definition, .. } := D
  let { AND_FORALL_THM, BETA_THM, .. } := D.core1
  let { CONJ_ASSOC, EQ_SYM_EQ, EQ_TRANS, EXTENSION, .. } := D.core2
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_PAIR_THM, FORALL_UNPAIR_THM,
        FUNCTION_FACTORS_LEFT_GEN, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, PAIR,
        PAIR_EQ, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM,
        SUBSET, SUBSET_ANTISYM, SUBSET_REFL, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_MUL, RING_MUL_ASSOC, RING_MUL_LID,
        RING_MUL_LNEG, RING_MUL_LZERO, RING_MUL_RID, RING_MUL_RZERO, RING_MUL_SYM,
        RING_NEG, RING_SUB, RING_SUB_EQ_0, RING_SUB_LDISTRIB, RING_SUB_REFL,
        RING_SUB_RZERO, TRIVIAL_RING_10, ring_0, ring_1, ring_add, ring_carrier,
        ring_mul, ring_neg, ring_tybij, .. } := BBasics
  let { RING_INV, RING_INV_1, RING_INV_MUL, RING_MUL_LCANCEL, RING_MUL_LINV,
        RING_MUL_RINV, RING_REGULAR_0, RING_REGULAR_1, RING_REGULAR_IN_CARRIER,
        RING_REGULAR_MUL, RING_RINV_UNIQUE, RING_UNIT_IMP_REGULAR,
        RING_UNIT_IN_CARRIER, RING_ZERODIVISOR_IMP_NONUNIT, ring_div, ring_regular,
        ring_unit, ring_zerodivisor, .. } := BDivides
  let { IDEAL_GENERATED_INC, IDEAL_GENERATED_MINIMAL, IDEAL_GENERATED_SUBSET,
        IN_RING_IDEAL_LMUL, IN_RING_IDEAL_RMUL, RING_IDEAL, RING_IDEAL_IDEAL_GENERATED,
        RING_IDEAL_IMP_SUBSET, ring_ideal, .. } := BIdeals
  let { FIELD_EQ_ALL_UNITS, FIELD_IMP_INTEGRAL_DOMAIN,
        INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, INTEGRAL_DOMAIN_MUL_EQ_0,
        INTEGRAL_DOMAIN_REGULAR, integral_domain, .. } := BDomains
  let { IDEAL_GENERATED_BY_HOMOMORPHIC_IMAGE, RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1,
        RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_SUB,
        RING_MONOMORPHISM_EPIMORPHISM, ring_epimorphism, ring_homomorphism,
        ring_monomorphism, .. } := BHoms
  let { ISOMORPHIC_RING_SYM, isomorphic_ring, .. } := BIso
  let { INTEGRAL_DOMAIN_MONOMORPHIC_PREIMAGE, RING_EPIMORPHISM_ALT,
        RING_MONOMORPHISM_ALT, RING_UNIT_HOMOMORPHIC_IMAGE, ring_image, .. } := BKernels
  let { RING_RULE, RING_TAC, .. } := BRingRule
  let { RING_MULTSYS, RING_MULTSYS_IMP_SUBSET, RING_MULTSYS_REGULAR, ring_multsys, .. } := BSquarefree
  -- @@SCOPE END

  let ring_localequiv ← new_definition
   r"ring_localequiv r s (a,b) (a',b') <=>
        a IN ring_carrier r /\ a' IN ring_carrier r /\ b IN s /\ b' IN s /\
        ?u. u IN s /\
            ring_mul r u (ring_sub r (ring_mul r a b') (ring_mul r a' b)) =
            ring_0 r"

  let RING_LOCALEQUIV ← prove
   r"!r s a b a' b':A.
      ring_multsys r s
      ==> (ring_localequiv r s (a,b) (a',b') <=>
           a IN ring_carrier r /\ a' IN ring_carrier r /\
           b IN ring_carrier r /\ b' IN ring_carrier r /\
           b IN s /\ b' IN s /\
           ?u. u IN s /\
               ring_mul r u (ring_sub r (ring_mul r a b') (ring_mul r a' b)) =
               ring_0 r)"
   (REWRITE_TAC [ring_multsys, ring_localequiv, SUBSET] THEN MESON_TAC [])

  let RING_LOCALEQUIV_REFL ← prove
   r"!r s a b:A.
        ring_multsys r s
        ==> (ring_localequiv r s (a,b) (a,b) <=>
             a IN ring_carrier r /\ b IN s)"
   (REWRITE_TAC [ring_multsys, SUBSET] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [ring_localequiv] THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THEN
    ASM_CASES_TAC (← q "(b:A) IN s") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [RING_MUL, RING_SUB_REFL] THEN
    ASM_MESON_TAC [RING_MUL_RZERO])

  let RING_LOCALEQUIV_SYM ← prove
   r"!r s a b a' b':A.
        ring_multsys r s
        ==> (ring_localequiv r s (a,b) (a',b') <=>
             ring_localequiv r s (a',b') (a,b))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_multsys, SUBSET] THEN
    DISCH_THEN (ASSUME_TAC o CONJUNCT1) THEN
    REWRITE_TAC [ring_localequiv, RIGHT_AND_EXISTS_THM] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "u:A") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN RING_TAC THEN ASM SET_TAC [])

  let RING_LOCALEQUIV_TRANS ← prove
   r"!r s a b a' b' a'' b'':A.
        ring_multsys r s /\
        ring_localequiv r s (a,b) (a',b') /\
        ring_localequiv r s (a',b') (a'',b'')
        ==> ring_localequiv r s (a,b) (a'',b'')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_multsys] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [ring_localequiv, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "u:A") THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "v:A") THEN
    REPEAT DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q "ring_mul r b' (ring_mul r u v):A") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], RING_TAC THEN ASM SET_TAC []])

  let RING_LOCALEQUIV_EQUIV ← prove
   r"!r s a b a' b'.
        ring_multsys r s /\
        a IN ring_carrier r /\ a' IN ring_carrier r /\ b IN s /\ b' IN s
        ==> (ring_localequiv r s (a,b) (a',b') <=>
             ring_localequiv r s (a,b) = ring_localequiv r s (a',b'))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM, FORALL_PAIR_THM] THEN
    ASM_MESON_TAC [RING_LOCALEQUIV_REFL, RING_LOCALEQUIV_SYM,
                   RING_LOCALEQUIV_TRANS])

  let RING_LOCALEQUIV_NEG ← prove
   r"!r s a b a' b':A.
        ring_multsys r s /\
        ring_localequiv r s (a,b) (a',b')
        ==> ring_localequiv r s (ring_neg r a,b) (ring_neg r a',b')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_multsys] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [ring_localequiv, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "u:A") THEN
    REPEAT DISCH_TAC THEN ASM_SIMP_TAC [RING_NEG] THEN
    EXISTS_TAC (← q "u:A") THEN ASM_REWRITE_TAC [] THEN
    RING_TAC THEN ASM SET_TAC [])

  let RING_LOCALEQUIV_ADD ← prove
   r"!r s a1 b1 a1' b1' a2 b2 a2' b2':A.
        ring_multsys r s /\
        ring_localequiv r s (a1,b1) (a1',b1') /\
        ring_localequiv r s (a2,b2) (a2',b2')
        ==> ring_localequiv r s
             (ring_add r (ring_mul r a1 b2) (ring_mul r a2 b1),
              ring_mul r b1 b2)
             (ring_add r (ring_mul r a1' b2') (ring_mul r a2' b1'),
              ring_mul r b1' b2')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_multsys, SUBSET] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [ring_localequiv, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "u:A") THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "v:A") THEN
    REPEAT DISCH_TAC THEN ASM_SIMP_TAC [RING_MUL, RING_ADD] THEN
    EXISTS_TAC (← q "ring_mul r u v:A") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], RING_TAC THEN ASM SET_TAC []])

  let RING_LOCALEQUIV_MUL ← prove
   r"!r s a1 b1 a1' b1' a2 b2 a2' b2':A.
        ring_multsys r s /\
        ring_localequiv r s (a1,b1) (a1',b1') /\
        ring_localequiv r s (a2,b2) (a2',b2')
        ==> ring_localequiv r s
             (ring_mul r a1 a2,ring_mul r b1 b2)
             (ring_mul r a1' a2',ring_mul r b1' b2')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_multsys] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [ring_localequiv, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "u:A") THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "v:A") THEN
    REPEAT DISCH_TAC THEN ASM_SIMP_TAC [RING_MUL] THEN
    EXISTS_TAC (← q "ring_mul r u v:A") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], RING_TAC THEN ASM SET_TAC []])

  let ring_localization ← new_definition
   r"ring_localization (r:A ring) s =
        ring({ring_localequiv r s (a,b) |a,b| a IN ring_carrier r /\ b IN s},
             ring_localequiv r s (ring_0 r,ring_1 r),
             ring_localequiv r s (ring_1 r,ring_1 r),
             (@f. !a b. a IN ring_carrier r /\ b IN s
                      ==> f (ring_localequiv r s (a,b)) =
                          ring_localequiv r s (ring_neg r a,b)),
             (@f. !a1 b1 a2 b2.
                        a1 IN ring_carrier r /\ b1 IN s /\
                        a2 IN ring_carrier r /\ b2 IN s
                        ==> f (ring_localequiv r s (a1,b1))
                              (ring_localequiv r s (a2,b2)) =
                            ring_localequiv r s
                             (ring_add r (ring_mul r a1 b2) (ring_mul r a2 b1),
                              ring_mul r b1 b2)),
             (@f. !a1 b1 a2 b2.
                        a1 IN ring_carrier r /\ b1 IN s /\
                        a2 IN ring_carrier r /\ b2 IN s
                        ==> f (ring_localequiv r s (a1,b1))
                              (ring_localequiv r s (a2,b2)) =
                            ring_localequiv r s
                              (ring_mul r a1 a2,ring_mul r b1 b2)))"

  let (RING_LOCALIZATION, RING_LOCALIZATION_NEG, RING_LOCALIZATION_ADD, RING_LOCALIZATION_MUL) : thm × thm × thm × thm ← do
    let lemma ← prove
     r"!(r:A->B) P.
     (!x x' y y'.
          P x y /\ P x' y' /\ r x = r x' /\ r y = r y'
          ==> r (f x y) = r (f x' y'))
      ==> ?g. !x y. P x y ==> g (r x) (r y) = r (f x y)"
     (REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← MESON []
       (← q r"(!x y. P x y ==> g (r x) (r y) = r (f x y)) <=>
      (!w z x y. P x y /\ r x = w /\ r y = z ==> g w z = r (f x y))")] THEN
      REWRITE_TAC [← GSYM SKOLEM_THM] THEN ASM_METIS_TAC [])
    -- `let localization_neg_exists = ... and localization_mul_exists = ...
    -- and localization_add_exists = ...`: left to right
    let localization_neg_exists ← prove
     r"!r s:A->bool.
          ring_multsys r s
          ==> ?f. !a b. a IN ring_carrier r /\ b IN s
                        ==> f (ring_localequiv r s (a,b)) =
                            ring_localequiv r s (ring_neg r a,b)"
     (REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC BINDER_CONV [FORALL_UNPAIR_THM] THEN
      GEN_REWRITE_TAC ONCE_DEPTH_CONV [EQ_SYM_EQ] THEN
      REWRITE_TAC [← GSYM FUNCTION_FACTORS_LEFT_GEN] THEN
      REWRITE_TAC [FORALL_PAIR_THM] THEN REPEAT GEN_TAC THEN
      REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
      ASM_SIMP_TAC [← GSYM RING_LOCALEQUIV_EQUIV, RING_NEG] THEN STRIP_TAC THEN
      MATCH_MP_TAC RING_LOCALEQUIV_NEG THEN ASM_REWRITE_TAC [])
    let localization_mul_exists ← prove
     r"!r s:A->bool.
          ring_multsys r s
          ==> ?f. !a1 b1 a2 b2.
                        a1 IN ring_carrier r /\ b1 IN s /\
                        a2 IN ring_carrier r /\ b2 IN s
                        ==> f (ring_localequiv r s (a1,b1))
                              (ring_localequiv r s (a2,b2)) =
                            ring_localequiv r s
                              (ring_mul r a1 a2,ring_mul r b1 b2)"
     (REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC BINDER_CONV [FORALL_UNPAIR_THM] THEN
      GEN_REWRITE_TAC (BINDER_CONV o BINDER_CONV) [FORALL_UNPAIR_THM] THEN
      REWRITE_TAC [PAIR] THEN
      MATCH_MP_TAC (← ISPEC (← q r"ring_localequiv (r:A ring) s") lemma) THEN
      REWRITE_TAC [FORALL_PAIR_THM] THEN REPEAT GEN_TAC THEN
      REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [ring_multsys]) THEN
      ASM_SIMP_TAC [← GSYM RING_LOCALEQUIV_EQUIV, RING_MUL] THEN STRIP_TAC THEN
      MATCH_MP_TAC RING_LOCALEQUIV_MUL THEN ASM_REWRITE_TAC [])
    let localization_add_exists ← prove
     r"!r s:A->bool.
          ring_multsys r s
          ==> ?f. !a1 b1 a2 b2.
                        a1 IN ring_carrier r /\ b1 IN s /\
                        a2 IN ring_carrier r /\ b2 IN s
                        ==> f (ring_localequiv r s (a1,b1))
                              (ring_localequiv r s (a2,b2)) =
                            ring_localequiv r s
                             (ring_add r (ring_mul r a1 b2) (ring_mul r a2 b1),
                              ring_mul r b1 b2)"
     (← do
      let ss ← ExceptT.mk (basic_ss [])
      pure (REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC BINDER_CONV [FORALL_UNPAIR_THM] THEN
      GEN_REWRITE_TAC (BINDER_CONV o BINDER_CONV) [FORALL_UNPAIR_THM] THEN
      REWRITE_TAC [PAIR] THEN
      MATCH_MP_TAC (← ISPEC (← q r"ring_localequiv (r:A ring) s") lemma) THEN
      REWRITE_TAC [FORALL_PAIR_THM] THEN REPEAT GEN_TAC THEN
      REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [ring_multsys]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM (simpTac ss 4)
        [← GSYM RING_LOCALEQUIV_EQUIV, RING_MUL, RING_ADD] THEN
      STRIP_TAC THEN
      MATCH_MP_TAC RING_LOCALEQUIV_ADD THEN ASM_REWRITE_TAC []))
    let th ← prove
     r"((!r s:A->bool.
         ring_multsys r s
         ==> ring_carrier (ring_localization r s) =
             { ring_localequiv r s (a,b) |a,b|
               a IN ring_carrier r /\ b IN s}) /\
    (!r s:A->bool.
         ring_multsys r s
         ==> ring_0 (ring_localization r s) =
             ring_localequiv r s (ring_0 r,ring_1 r)) /\
    (!r s:A->bool.
         ring_multsys r s
         ==> ring_1 (ring_localization r s) =
             ring_localequiv r s (ring_1 r,ring_1 r)) /\
    (!r s:A->bool.
         ring_multsys r s
         ==> ring_neg (ring_localization r s) =
             @f. !a b. a IN ring_carrier r /\ b IN s
                       ==> f (ring_localequiv r s (a,b)) =
                           ring_localequiv r s (ring_neg r a,b)) /\
    (!r s:A->bool.
         ring_multsys r s
         ==> ring_add (ring_localization r s) =
             @f. !a1 b1 a2 b2.
                        a1 IN ring_carrier r /\ b1 IN s /\
                        a2 IN ring_carrier r /\ b2 IN s
                        ==> f (ring_localequiv r s (a1,b1))
                              (ring_localequiv r s (a2,b2)) =
                            ring_localequiv r s
                             (ring_add r (ring_mul r a1 b2) (ring_mul r a2 b1),
                              ring_mul r b1 b2)) /\
     (!r s:A->bool.
         ring_multsys r s
         ==> ring_mul (ring_localization r s) =
             @f. !a1 b1 a2 b2.
                        a1 IN ring_carrier r /\ b1 IN s /\
                        a2 IN ring_carrier r /\ b2 IN s
                        ==> f (ring_localequiv r s (a1,b1))
                              (ring_localequiv r s (a2,b2)) =
                            ring_localequiv r s
                              (ring_mul r a1 a2,ring_mul r b1 b2))) /\
   ((!r s a b:A.
        ring_multsys r s /\ a IN ring_carrier r /\ b IN s
        ==> ring_neg (ring_localization r s) (ring_localequiv r s (a,b)) =
            ring_localequiv r s (ring_neg r a,b)) /\
    (!r s a1 b1 a2 b2:A.
        ring_multsys r s /\
        a1 IN ring_carrier r /\ b1 IN s /\
        a2 IN ring_carrier r /\ b2 IN s
        ==> ring_add (ring_localization r s)
             (ring_localequiv r s (a1,b1)) (ring_localequiv r s (a2,b2)) =
            ring_localequiv r s
             (ring_add r (ring_mul r a1 b2) (ring_mul r a2 b1),
              ring_mul r b1 b2)) /\
    (!r s a1 b1 a2 b2:A.
        ring_multsys r s /\
        a1 IN ring_carrier r /\ b1 IN s /\
        a2 IN ring_carrier r /\ b2 IN s
        ==> ring_mul (ring_localization r s)
             (ring_localequiv r s (a1,b1)) (ring_localequiv r s (a2,b2)) =
            ring_localequiv r s (ring_mul r a1 a2, ring_mul r b1 b2)))"
     (← do
      -- right to left: the three basic_ss (last first), then the TAUT
      let ss3 ← ExceptT.mk (basic_ss [])
      let ss2 ← ExceptT.mk (basic_ss [])
      let ss1 ← ExceptT.mk (basic_ss [])
      let t1 ← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")
      pure (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
      REWRITE_TAC [← GSYM AND_FORALL_THM] THEN
      ASM_CASES_TAC (← q r"ring_multsys r (s:A->bool)") THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY ABBREV_TAC
       [← q r"lneg = @f. !a b:A. a IN ring_carrier r /\ b IN s
                        ==> f (ring_localequiv r s (a,b)) =
                            ring_localequiv r s (ring_neg r a,b)",
        ← q r"ladd =  @f. !a1 b1 a2 b2:A.
                        a1 IN ring_carrier r /\ b1 IN s /\
                        a2 IN ring_carrier r /\ b2 IN s
                        ==> f (ring_localequiv r s (a1,b1))
                              (ring_localequiv r s (a2,b2)) =
                            ring_localequiv r s
                             (ring_add r (ring_mul r a1 b2) (ring_mul r a2 b1),
                              ring_mul r b1 b2)",
        ← q r"lmul =  @f. !a1 b1 a2 b2:A.
                        a1 IN ring_carrier r /\ b1 IN s /\
                        a2 IN ring_carrier r /\ b2 IN s
                        ==> f (ring_localequiv r s (a1,b1))
                              (ring_localequiv r s (a2,b2)) =
                            ring_localequiv r s
                             (ring_mul r a1 a2,ring_mul r b1 b2)"] THEN
      FIRST_ASSUM (MP_TAC o SELECT_RULE o MATCH_MP localization_neg_exists) THEN
      FIRST_ASSUM (MP_TAC o SELECT_RULE o MATCH_MP localization_add_exists) THEN
      FIRST_ASSUM (MP_TAC o SELECT_RULE o MATCH_MP localization_mul_exists) THEN
      ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
      MATCH_MP_TAC t1 THEN CONJ_TAC THENL
       [DISCH_THEN (fun th => ASM_SIMP_TAC [th]), ALL_TAC] THEN
      GEN_REWRITE_TAC (DEPTH_BINOP_CONV (← q r"/\") o LAND_CONV o ONCE_DEPTH_CONV)
       [ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul] THEN
      PURE_REWRITE_TAC [← GSYM PAIR_EQ, BETA_THM, PAIR] THEN
      ASM_REWRITE_TAC [ring_localization, ← GSYM (← CONJUNCT2 ring_tybij)] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      REPEAT (FIRST_X_ASSUM ((fun (_ : thm) => ALL_TAC) o SYM)) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [ring_multsys, SUBSET]) THEN
      ASM (simpTac ss1 4)
       [RING_0, RING_1, RING_NEG, RING_ADD, RING_MUL] THEN
      REPLICATE_TAC 3
       (CONJ_TAC THENL
         [REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [RING_0, RING_1, RING_NEG],
          ALL_TAC]) THEN
      CONJ_TAC THENL
       [MAP_EVERY X_GEN_TAC [← q "a1:A", ← q "b1:A"] THEN STRIP_TAC THEN
        MAP_EVERY X_GEN_TAC [← q "a2:A", ← q "b2:A"] THEN STRIP_TAC THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        EXISTS_TAC (← q "ring_add r (ring_mul r a1 b2) (ring_mul r a2 b1):A") THEN
        EXISTS_TAC (← q "ring_mul r b1 b2:A") THEN
        ASM_MESON_TAC [RING_ADD, RING_MUL],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [RING_MUL], ALL_TAC] THEN
      REPEAT CONJ_TAC THEN
      MP_TAC (← GSYM (← ISPECL [← q "r:A ring", ← q r"s:A->bool"] RING_LOCALEQUIV_EQUIV)) THEN
      ASM_REWRITE_TAC [ring_multsys, SUBSET] THEN
      ASM (simpTac ss2 6)
       [RING_0, RING_1, RING_NEG, RING_ADD, RING_MUL] THEN
      DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN REPEAT STRIP_TAC THEN
      REWRITE_TAC [ring_localequiv] THEN
      ASM (simpTac ss3 5)
       [RING_0, RING_1, RING_NEG, RING_ADD, RING_MUL] THEN
      EXISTS_TAC (← q "ring_1 r:A") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [PAIR_EQ] THEN RING_TAC THEN ASM SET_TAC []))
    match ← splitConjPair th with
    | ([a, b, c], d) => pure (a, b, c, d)
    | _ => throw "Match_failure"

  let RING_LOCALIZATION_CARRIER ← prove
   r"!r s:A->bool.
        ring_multsys r s
        ==> ring_carrier (ring_localization r s) =
             { ring_localequiv r s (a,b) |a,b|
               a IN ring_carrier r /\ b IN s}"
   (REWRITE_TAC [RING_LOCALIZATION])

  let RING_LOCALIZATION_0 ← prove
   r"!r s:A->bool.
        ring_multsys r s
        ==> ring_0 (ring_localization r s) =
             ring_localequiv r s (ring_0 r,ring_1 r)"
   (REWRITE_TAC [RING_LOCALIZATION])

  let RING_LOCALIZATION_1 ← prove
   r"!r s:A->bool.
        ring_multsys r s
        ==> ring_1 (ring_localization r s) =
             ring_localequiv r s (ring_1 r,ring_1 r)"
   (REWRITE_TAC [RING_LOCALIZATION])

  let RING_LOCALEQUIV_REFL ← prove
   r"!r s a:A.
        ring_multsys r s /\ a IN s
        ==> ring_localequiv r s (a,a) = ring_1(ring_localization r s)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_multsys]) THEN
    REWRITE_TAC [SUBSET] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM RING_LOCALEQUIV_EQUIV, RING_LOCALIZATION_1] THEN
    ASM_SIMP_TAC [ring_localequiv] THEN EXISTS_TAC (← q "ring_1 r:A") THEN
    ASM_SIMP_TAC [RING_MUL_LID, RING_MUL_RID, RING_SUB_REFL,
                  RING_MUL_LID, RING_0])

  let TRIVIAL_RING_LOCALIZATION ← prove
   r"!r s:A->bool.
        ring_multsys r s
        ==> (trivial_ring(ring_localization r s) <=> ring_0 r IN s)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o GEN_REWRITE_RULE id [ring_multsys]) THEN
    ASM_SIMP_TAC [TRIVIAL_RING_10, RING_LOCALIZATION_1, RING_LOCALIZATION_0,
      ← GSYM RING_LOCALEQUIV_EQUIV, RING_0, RING_1, ring_localequiv] THEN
    SIMP_TAC [RING_1, RING_0, RING_MUL_RID, RING_SUB_RZERO] THEN
    ASM_MESON_TAC [RING_MUL_RID, RING_MUL_LID, SUBSET])

  let RING_LOCALEQUIV_IN_CARRIER ← prove
   r"!r s a b:A.
        ring_multsys r s /\ a IN ring_carrier r /\ b IN s
        ==> ring_localequiv r s (a,b) IN ring_carrier(ring_localization r s)"
   (SIMP_TAC [RING_LOCALIZATION_CARRIER] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [])

  let RING_UNIT_LOCALEQUIV ← prove
   r"!r s a b:A.
        ring_multsys r s /\ a IN s /\ b IN s
        ==> ring_unit (ring_localization r s) (ring_localequiv r s (a,b))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [ring_multsys]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [ring_unit, RING_LOCALEQUIV_IN_CARRIER] THEN
    EXISTS_TAC (← q "ring_localequiv r s (b:A,a)") THEN
    ASM_SIMP_TAC [RING_LOCALEQUIV_IN_CARRIER] THEN
    ASM_SIMP_TAC [RING_LOCALIZATION_MUL, RING_LOCALIZATION_1] THEN
    ASM_SIMP_TAC [← GSYM RING_LOCALEQUIV_EQUIV, RING_MUL_LID, RING_MUL_RID] THEN
    ASM_SIMP_TAC [ring_localequiv, RING_1] THEN
    EXISTS_TAC (← q "ring_1 r:A") THEN ASM_REWRITE_TAC [] THEN
    RING_TAC THEN ASM_SIMP_TAC [])

  let RING_UNIT_LOCALEQUIV_EQ ← prove
   r"!(r:A ring) s a b.
       ring_multsys r s /\
       (!x y. x IN ring_carrier r /\ y IN ring_carrier r /\ ring_mul r x y IN s
              ==> x IN s /\ y IN s) /\
       a IN ring_carrier r /\ b IN s
       ==> (ring_unit (ring_localization r s) (ring_localequiv r s (a,b)) <=>
            a IN s)"
   (← do
    let ss ← ExceptT.mk (basic_ss [])
    pure (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [RING_UNIT_LOCALEQUIV]] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [ring_multsys]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [ring_unit, ← CONJUNCT1 RING_LOCALIZATION] THEN
    DISCH_THEN (MP_TAC o CONJUNCT2) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, FORALL_IN_GSPEC, IMP_CONJ] THEN
    MAP_EVERY X_GEN_TAC [← q "a':A", ← q "b':A"] THEN DISCH_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [RING_LOCALIZATION_MUL, RING_LOCALIZATION_1] THEN
    ASM_SIMP_TAC [← GSYM RING_LOCALEQUIV_EQUIV, RING_MUL, RING_MULTSYS, RING_1] THEN
    ASM_SIMP_TAC [ring_localequiv, RING_MUL_LID, RING_MUL_RID, RING_MUL] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
    X_GEN_TAC (← q "t:A") THEN DISCH_TAC THEN
    ASM (simpTac ss 4)
        [RING_SUB_LDISTRIB, RING_MUL, RING_SUB_EQ_0] THEN
    ASM_MESON_TAC [RING_MUL]))

  let RING_UNIT_LOCALIZATION ← prove
   r"!(r:A ring) s c.
      ring_multsys r s /\
      (!x y. x IN ring_carrier r /\ y IN ring_carrier r /\ ring_mul r x y IN s
             ==> x IN s /\ y IN s)
      ==> (ring_unit (ring_localization r s) c <=>
           ?a b. a IN s /\ b IN s /\ c = ring_localequiv r s (a,b))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [RING_UNIT_LOCALEQUIV]] THEN
    MATCH_MP_TAC (← MESON [ring_unit]
     (← q r"(!x. x IN ring_carrier r ==> ring_unit r x ==> P x)
    ==> ring_unit r c ==> P c")) THEN
    ASM_SIMP_TAC [← CONJUNCT1 RING_LOCALIZATION, FORALL_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC  THEN
    wPart lhand (fun t => do lhand (← rand t)) RING_UNIT_LOCALEQUIV_EQ THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN ASM_MESON_TAC [])

  let RING_LOCALEQUIV_EQ_0_GEN ← prove
   r"!r s a b:A.
        ring_multsys r s /\ a IN ring_carrier r /\ b IN s
        ==> (ring_localequiv r s (a,b) = ring_0(ring_localization r s) <=>
             ?c. c IN s /\ ring_mul r c a = ring_0 r)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [ring_multsys]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [RING_LOCALIZATION_0, ← GSYM RING_LOCALEQUIV_EQUIV, RING_0] THEN
    ASM_SIMP_TAC [ring_localequiv, RING_0, RING_MUL_RID, RING_MUL_LZERO] THEN
    ASM_SIMP_TAC [RING_SUB_RZERO])

  let RING_IDEAL_LOCALIZATION ← prove
   r"!r s (j:A->bool).
        ring_multsys r s /\ ring_ideal r j
        ==> ring_ideal (ring_localization r s)
                       {ring_localequiv r s (a,b) |a,b| a IN j /\ b IN s}"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM
     (ASSUME_TAC o REWRITE_RULE [SUBSET] o MATCH_MP RING_IDEAL_IMP_SUBSET) THEN
    ASM_SIMP_TAC [RING_IDEAL, RING_LOCALIZATION_CARRIER] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IMP_IMP, RIGHT_IMP_FORALL_THM] THEN
    ASM_SIMP_TAC [RING_LOCALIZATION_ADD, RING_LOCALIZATION_MUL,
                  RING_LOCALIZATION_0] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_ideal, ring_multsys, SUBSET]) THEN
    REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN STRIP_ASSUME_TAC)) THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [RING_0, RING_1],
      ASM_MESON_TAC [RING_0, RING_1],
      MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A", ← q "c:A", ← q "d:A"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q "ring_add r (ring_mul r a d) (ring_mul r c b):A") THEN
      EXISTS_TAC (← q "ring_mul r b d:A") THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [RING_MUL_SYM],
      ASM_MESON_TAC [RING_MUL_SYM]])

  let ring_fractionate ← new_definition
   r"ring_fractionate r s = \x:A. ring_localequiv r s (x,ring_1 r)"

  let RING_FRACTIONATE_IN_CARRIER ← prove
   r"!r s a:A.
        ring_multsys r s /\ a IN ring_carrier r
        ==> ring_fractionate r s a IN ring_carrier (ring_localization r s)"
