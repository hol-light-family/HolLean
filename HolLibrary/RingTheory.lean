  FIELD_HOMOMORPHISM_DIV : thm
  RING_HOMOMORPHISM_RING_OF_NUM : thm
  RING_HOMOMORPHISM_RING_OF_INT : thm
  RING_CHAR_HOMOMORPHIC_IMAGE : thm
  RING_HOMOMORPHISM_SUM : thm
  RING_HOMOMORPHISM_PRODUCT : thm
  RING_MONOMORPHISM_SUM : thm
  RING_MONOMORPHISM_PRODUCT : thm
  RING_MONOMORPHISM_SUM_GEN : thm
  RING_MONOMORPHISM_PRODUCT_GEN : thm
  RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED : thm
  RING_MONOMORPHISM_IMP_HOMOMORPHISM : thm
  RING_EPIMORPHISM_IMP_HOMOMORPHISM : thm
  RING_MONOMORPHISM_INJECTIVE_EQ : thm
  RING_MONOMORPHISM_EQ_0 : thm
  RING_HOMOMORPHISM_ID : thm
  RING_HOMOMORPHISM_I : thm
  RING_MONOMORPHISM_ID : thm
  RING_MONOMORPHISM_I : thm
  RING_EPIMORPHISM_ID : thm
  RING_EPIMORPHISM_I : thm
  RING_ISOMORPHISMS_ID : thm
  RING_ISOMORPHISMS_I : thm
  RING_ISOMORPHISM_ID : thm
  RING_ISOMORPHISM_I : thm
  RING_AUTOMORPHISM_ID : thm
  RING_AUTOMORPHISM_I : thm
  RING_HOMOMORPHISM_COMPOSE : thm
  RING_MONOMORPHISM_COMPOSE : thm
  RING_MONOMORPHISM_COMPOSE_REV : thm
  RING_EPIMORPHISM_COMPOSE : thm
  RING_EPIMORPHISM_COMPOSE_REV : thm
  RING_MONOMORPHISM_LEFT_INVERTIBLE : thm
  RING_EPIMORPHISM_RIGHT_INVERTIBLE : thm
  RING_HOMOMORPHISM_INTO_SUBRING : thm
  RING_HOMOMORPHISM_INTO_SUBRING_EQ_GEN : thm
  RING_HOMOMORPHISM_INTO_SUBRING_EQ : thm
  RING_HOMOMORPHISM_FROM_SUBRING_GENERATED : thm
  RING_MONOMORPHISM_FROM_SUBRING_GENERATED : thm
  RING_HOMOMORPHISM_INCLUSION : thm
  RING_MONOMORPHISM_INCLUSION : thm
  RING_HOMOMORPHISM_BETWEEN_SUBRINGS : thm
  RING_HOMOMORPHISM_BETWEEN_SUBRINGS_ALT : thm
  RING_MONOMORPHISM_INTO_SUBRING : thm
  RING_MONOMORPHISM_BETWEEN_SUBRINGS : thm
  RING_MONOMORPHISM_INTO_SUPERRING : thm
  RING_SUM_SUBRING_GENERATED_GEN : thm
  RING_SUM_SUBRING_GENERATED : thm
  RING_PRODUCT_SUBRING_GENERATED_GEN : thm
  RING_PRODUCT_SUBRING_GENERATED : thm
  SUBRING_GENERATED_BY_HOMOMORPHIC_IMAGE : thm
  RING_EPIMORPHISM_BETWEEN_SUBRINGS : thm
  RING_ISOMORPHISM : thm
  RING_ISOMORPHISM_SUBSET : thm
  SUBRING_OF_HOMOMORPHIC_IMAGE : thm
  RING_IDEAL_EPIMORPHIC_IMAGE : thm
  SUBRING_OF_HOMOMORPHIC_PREIMAGE : thm
  SUBRING_OF_EPIMORPHIC_PREIMAGE : thm
  SUBRING_OF_HOMOMORPHIC_EQUALITIES : thm
  SUBRING_OF_FIXPOINTS : thm
  RING_IDEAL_HOMOMORPHIC_PREIMAGE : thm
  IDEAL_GENERATED_BY_HOMOMORPHIC_IMAGE : thm
  IDEAL_GENERATED_BY_EPIMORPHIC_IMAGE : thm
  RING_MONOMORPHISM_EPIMORPHISM : thm
  SUBRING_MONOMORPHISM_EPIMORPHISM : thm
  RING_ISOMORPHISM_EPIMORPHISM : thm
  RING_ISOMORPHISM_MONOMORPHISM : thm
  RING_ISOMORPHISM_MONOMORPHISM_ALT : thm
  RING_ISOMORPHISM_IMP_MONOMORPHISM : thm
  RING_ISOMORPHISM_IMP_EPIMORPHISM : thm
  RING_ISOMORPHISM_IMP_HOMOMORPHISM : thm
  RING_AUTOMORPHISM_IMP_ENDOMORPHISM : thm
  RING_ISOMORPHISMS_ISOMORPHISM : thm
  RING_ISOMORPHISM_EQ_MONOMORPHISM_FINITE : thm
  RING_ISOMORPHISM_EQ_EPIMORPHISM_FINITE : thm
  RING_ISOMORPHISMS_BETWEEN_SUBRINGS : thm
  RING_ISOMORPHISMS_BETWEEN_SUBRINGS_ALT : thm
  RING_ISOMORPHISM_BETWEEN_SUBRINGS : thm
  RING_ISOMORPHISMS_COMPOSE : thm
  RING_ISOMORPHISM_COMPOSE : thm
  RING_ISOMORPHISM_COMPOSE_REV : thm
  RING_EPIMORPHISM_ISOMORPHISM_COMPOSE_REV : thm
  RING_MONOMORPHISM_ISOMORPHISM_COMPOSE_REV : thm
  RING_ISOMORPHISM_INVERSE : thm
  RING_HOMOMORPHISM_FROM_TRIVIAL_RING : thm
  RING_MONOMORPHISM_FROM_TRIVIAL_RING : thm
  RING_MONOMORPHISM_TO_TRIVIAL_RING : thm
  RING_EPIMORPHISM_FROM_TRIVIAL_RING : thm
  RING_EPIMORPHISM_TO_TRIVIAL_RING : thm
  TRIVIAL_RING_MONOMORPHIC_PREIMAGE : thm
  TRIVIAL_RING_HOMOMORPHIC_IMAGE : thm
  TRIVIAL_RING_MONOMORPHIC_IMAGE_EQ : thm
  RING_NILPOTENT_HOMOMORPHIC_IMAGE : thm
  RING_NILPOTENT_MONOMORPHIC_IMAGE_EQ : thm
  RING_CHAR_MONOMORPHIC_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupHoms [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BProducts : Products) (BDivides : Divides) (BSubrings : Subrings) (BIdeals : Ideals) (BDomains : Domains) :
    ExceptT String IO Homs := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { EQ_IMP, ETA_AX, EXTENSION, .. } := D.core2
  let { FINITE_INDUCT_STRONG, FINITE_INSERT, FORALL_INT_CASES, FORALL_IN_IMAGE,
        FORALL_IN_IMAGE_2, FORALL_IN_INSERT, FUN_IN_IMAGE, IMAGE_ID, IMAGE_SUBSET, .. } := D.core3
  let { IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, INFINITE, INJECTIVE_ON_ALT,
        INJECTIVE_ON_LEFT_INVERSE, INTERS_GSPEC, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, I_DEF, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_AND, MONO_EXISTS, NOT_IMP, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM,
        SUBSET_REFL, SURJECTIVE_IFF_INJECTIVE_GEN, .. } := D.core7
  let { o_ASSOC, o_DEF, o_THM, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_LZERO, RING_ADD_RNEG, RING_LNEG_UNIQUE,
        RING_LZERO_UNIQUE, RING_MUL, RING_MUL_LZERO, RING_NEG, TRIVIAL_RING_10,
        ring_sub, trivial_ring, .. } := BBasics
  let { RING_CHAR_UNIQUE, RING_OF_INT_CASES, RING_OF_NUM, RING_OF_NUM_CHAR,
        RING_OF_NUM_EQ_0, RING_POW, ring_of_num, ring_pow, .. } := BNumbers
  let { RING_SUM, RING_SUM_CLAUSES, RING_SUM_RESTRICT, RING_SUM_SUPPORT,
        RING_SUM_TRIVIAL, .. } := BSums
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, RING_PRODUCT_RESTRICT,
        RING_PRODUCT_SUPPORT, RING_PRODUCT_TRIVIAL, .. } := BProducts
  let { RING_INV, RING_INV_0, RING_LINV_UNIQUE, RING_MUL_LINV, ring_div,
        ring_nilpotent, ring_unit, .. } := BDivides
  let { CARRIER_SUBRING_GENERATED_SUBRING, RING_CARRIER_SUBRING_GENERATED_SUBSET,
        SUBRING_GENERATED, SUBRING_GENERATED_INC, SUBRING_GENERATED_INDUCT,
        SUBRING_GENERATED_INDUCT_STRONG, SUBRING_GENERATED_RESTRICT,
        SUBRING_GENERATED_SUBSET_CARRIER, subring_of, .. } := BSubrings
  let { IDEAL_GENERATED_MINIMAL, IDEAL_GENERATED_SUBSET_CARRIER_SUBSET,
        RING_IDEAL_IDEAL_GENERATED, ring_ideal, .. } := BIdeals
  let { FIELD_UNIT, .. } := BDomains
  -- @@SCOPE END

  let ring_homomorphism ← new_definition
   r"ring_homomorphism (r,r') (f:A->B) <=>
        IMAGE f (ring_carrier r) SUBSET ring_carrier r' /\
        f (ring_0 r) = ring_0 r' /\
        f (ring_1 r) = ring_1 r' /\
        (!x. x IN ring_carrier r
             ==> f(ring_neg r x) = ring_neg r' (f x)) /\
        (!x y. x IN ring_carrier r /\ y IN ring_carrier r
               ==> f(ring_add r x y) = ring_add r' (f x) (f y)) /\
        (!x y. x IN ring_carrier r /\ y IN ring_carrier r
               ==> f(ring_mul r x y) = ring_mul r' (f x) (f y))"

  let ring_monomorphism ← new_definition
   r"ring_monomorphism (r,r') (f:A->B) <=>
        ring_homomorphism (r,r') f /\
        !x y. x IN ring_carrier r /\ y IN ring_carrier r /\ f x = f y
             ==> x = y"

  let ring_epimorphism ← new_definition
   r"ring_epimorphism (r,r') (f:A->B) <=>
        ring_homomorphism (r,r') f /\
        IMAGE f (ring_carrier r) = ring_carrier r'"

  let ring_endomorphism ← new_definition
   r"ring_endomorphism r (f:A->A) <=> ring_homomorphism (r,r) f"

  let ring_isomorphisms ← new_definition
   r"ring_isomorphisms (r,r') ((f:A->B),g) <=>
        ring_homomorphism (r,r') f /\
        ring_homomorphism (r',r) g /\
        (!x. x IN ring_carrier r ==> g(f x) = x) /\
        (!y. y IN ring_carrier r' ==> f(g y) = y)"

  let ring_isomorphism ← new_definition
   r"ring_isomorphism (r,r') (f:A->B) <=> ?g. ring_isomorphisms (r,r') (f,g)"

  let ring_automorphism ← new_definition
   r"ring_automorphism r (f:A->A) <=> ring_isomorphism (r,r) f"

  let RING_HOMOMORPHISM_EQ ← prove
   r"!r r' (f:A->B) f'.
        ring_homomorphism(r,r') f /\
        (!x. x IN ring_carrier r ==> f' x = f x)
        ==> ring_homomorphism (r,r') f'"
   (REWRITE_TAC [ring_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    SIMP_TAC [RING_0, RING_1, RING_NEG, RING_ADD, RING_MUL])

  let RING_MONOMORPHISM_EQ ← prove
   r"!r r' (f:A->B) f'.
        ring_monomorphism(r,r') f /\
        (!x. x IN ring_carrier r ==> f' x = f x)
        ==> ring_monomorphism (r,r') f'"
   (REWRITE_TAC [ring_monomorphism, ring_homomorphism, SUBSET] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN
    SIMP_TAC [RING_0, RING_1, RING_NEG, RING_ADD, RING_MUL] THEN
    MESON_TAC [])

  let RING_EPIMORPHISM_EQ ← prove
   r"!r r' (f:A->B) f'.
        ring_epimorphism(r,r') f /\
        (!x. x IN ring_carrier r ==> f' x = f x)
        ==> ring_epimorphism (r,r') f'"
   (REWRITE_TAC [ring_epimorphism, ring_homomorphism, SUBSET] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [RING_0, RING_1, RING_NEG, RING_ADD, RING_MUL] THEN SET_TAC [])

  let RING_ENDOMORPHISM_EQ ← prove
   r"!r (f:A->A) f'.
        ring_endomorphism r f /\
        (!x. x IN ring_carrier r ==> f' x = f x)
        ==> ring_endomorphism r f'"
   (REWRITE_TAC [ring_endomorphism, RING_HOMOMORPHISM_EQ])

  let RING_ISOMORPHISMS_EQ ← prove
   r"!r r' (f:A->B) g.
        ring_isomorphisms(r,r') (f,g) /\
        (!x. x IN ring_carrier r ==> f' x = f x) /\
        (!y. y IN ring_carrier r' ==> g' y = g y)
        ==> ring_isomorphisms(r,r') (f',g')"
   (SIMP_TAC [ring_isomorphisms, ring_homomorphism, SUBSET] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [RING_0, RING_1, RING_NEG, RING_ADD, RING_MUL] THEN SET_TAC [])

  let RING_ISOMORPHISM_EQ ← prove
   r"!r r' (f:A->B) f'.
        ring_isomorphism(r,r') f /\
        (!x. x IN ring_carrier r ==> f' x = f x)
        ==> ring_isomorphism (r,r') f'"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [ring_isomorphism] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [RING_ISOMORPHISMS_EQ])

  let RING_AUTOMORPHISM_EQ ← prove
   r"!r (f:A->A) f'.
        ring_automorphism r f /\
        (!x. x IN ring_carrier r ==> f' x = f x)
        ==> ring_automorphism r f'"
   (REWRITE_TAC [ring_automorphism, RING_ISOMORPHISM_EQ])

  let RING_ISOMORPHISMS_SYM ← prove
   r"!r r' (f:A->B) g.
        ring_isomorphisms (r,r') (f,g) <=> ring_isomorphisms(r',r) (g,f)"
   (REWRITE_TAC [ring_isomorphisms] THEN MESON_TAC [])

  let RING_ISOMORPHISMS_IMP_ISOMORPHISM ← prove
   r"!(f:A->B) g r r'.
        ring_isomorphisms (r,r') (f,g) ==> ring_isomorphism (r,r') f"
   (REWRITE_TAC [ring_isomorphism] THEN MESON_TAC [])

  let RING_ISOMORPHISMS_IMP_ISOMORPHISM_ALT ← prove
   r"!(f:A->B) g r r'.
        ring_isomorphisms (r,r') (f,g) ==> ring_isomorphism (r',r) g"
   (MESON_TAC [RING_ISOMORPHISMS_SYM, RING_ISOMORPHISMS_IMP_ISOMORPHISM])

  let RING_HOMOMORPHISM ← prove
   r"!r r' f:A->B.
        ring_homomorphism (r,r') (f:A->B) <=>
        IMAGE f (ring_carrier r) SUBSET ring_carrier r' /\
        f(ring_1 r) = ring_1 r' /\
        (!x y. x IN ring_carrier r /\ y IN ring_carrier r
               ==> f(ring_add r x y) = ring_add r' (f x) (f y)) /\
        (!x y. x IN ring_carrier r /\ y IN ring_carrier r
               ==> f(ring_mul r x y) = ring_mul r' (f x) (f y))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_homomorphism] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL [← q "ring_0 r:A", ← q "ring_0 r:A"])) THEN
      SIMP_TAC [RING_0, RING_ADD_LZERO] THEN
      ASM_MESON_TAC [RING_LZERO_UNIQUE, RING_0],
      REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC RING_LNEG_UNIQUE THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL [← q "x:A", ← q "ring_neg r x:A"])) THEN
      ASM_SIMP_TAC [RING_NEG, RING_ADD_RNEG]])

  let RING_ISOMORPHISMS ← prove
   r"!r r' (f:A->B) g.
        ring_isomorphisms(r,r') (f,g) <=>
        ring_homomorphism(r,r') f /\
        (!x. x IN ring_carrier r ==> g(f x) = x) /\
        (!y. y IN ring_carrier r' ==> g y IN ring_carrier r /\ f(g y) = y)"
   (REWRITE_TAC [ring_isomorphisms, ring_homomorphism] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    ASM_MESON_TAC [RING_0, RING_1, RING_NEG, RING_ADD, RING_MUL])

  let RING_HOMOMORPHISM_IN_CARRIER ← prove
   r"!r r' (f:A->B) x.
    ring_homomorphism (r,r') f /\ x IN ring_carrier r
    ==> f x IN ring_carrier r'"
   (REWRITE_TAC [RING_HOMOMORPHISM] THEN SET_TAC [])

  let RING_HOMOMORPHISM_0 ← prove
   r"!r r' (f:A->B). ring_homomorphism(r,r') f ==> f(ring_0 r) = ring_0 r'"
   (SIMP_TAC [ring_homomorphism])

  let RING_HOMOMORPHISM_1 ← prove
   r"!r r' (f:A->B). ring_homomorphism(r,r') f ==> f(ring_1 r) = ring_1 r'"
   (SIMP_TAC [ring_homomorphism])

  let RING_HOMOMORPHISM_NEG ← prove
   r"!r r' (f:A->B).
        ring_homomorphism(r,r') f
        ==> !x. x IN ring_carrier r
                ==> f(ring_neg r x) = ring_neg r' (f x)"
   (SIMP_TAC [ring_homomorphism])

  let RING_HOMOMORPHISM_ADD ← prove
   r"!r r' (f:A->B).
        ring_homomorphism(r,r') f
        ==> !x y. x IN ring_carrier r /\ y IN ring_carrier r
                  ==> f(ring_add r x y) = ring_add r' (f x) (f y)"
   (SIMP_TAC [ring_homomorphism])

  let RING_HOMOMORPHISM_MUL ← prove
   r"!r r' (f:A->B).
        ring_homomorphism(r,r') f
        ==> !x y. x IN ring_carrier r /\ y IN ring_carrier r
                  ==> f(ring_mul r x y) = ring_mul r' (f x) (f y)"
   (SIMP_TAC [ring_homomorphism])

  let RING_HOMOMORPHISM_SUB ← prove
   r"!r r' (f:A->B).
        ring_homomorphism(r,r') f
        ==> !x y. x IN ring_carrier r /\ y IN ring_carrier r
                  ==> f(ring_sub r x y) = ring_sub r' (f x) (f y)"
   (REWRITE_TAC [ring_homomorphism, ring_sub] THEN
    MESON_TAC [RING_ADD, RING_NEG])

  let RING_HOMOMORPHISM_POW ← prove
   r"!r r' (f:A->B).
        ring_homomorphism(r,r') f
        ==> !x n. x IN ring_carrier r
                  ==> f(ring_pow r x n) = ring_pow r' (f x) n"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_homomorphism] THEN DISCH_TAC THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [ring_pow, RING_POW])

  let RING_HOMOMORPHISM_INV ← prove
   r"!r r' (f:A->B).
        ring_homomorphism (r,r') f
        ==> !x. ring_unit r x ==> f(ring_inv r x) = ring_inv r' (f x)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q "(x:A) IN ring_carrier r") ASSUME_TAC THENL
     [ASM_MESON_TAC [ring_unit], ALL_TAC] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_LINV_UNIQUE THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o GSYM)) THEN
    ASM_SIMP_TAC [RING_INV] THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
    AP_TERM_TAC THEN ASM_SIMP_TAC [RING_MUL_LINV])

  let FIELD_HOMOMORPHISM_INV ← prove
   r"!r r' (f:A->B).
        field r /\ ring_homomorphism (r,r') f
        ==> !x. x IN ring_carrier r ==> f(ring_inv r x) = ring_inv r' (f x)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q "x:A = ring_0 r") THENL
     [ALL_TAC, ASM_MESON_TAC [RING_HOMOMORPHISM_INV, FIELD_UNIT]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [ring_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_SIMP_TAC [RING_INV_0])

  let FIELD_HOMOMORPHISM_DIV ← prove
   r"!r r' (f:A->B).
        field r /\ ring_homomorphism (r,r') f
        ==> !x y. x IN ring_carrier r /\ y IN ring_carrier r
                  ==> f(ring_div r x y) = ring_div r' (f x) (f y)"
   (REWRITE_TAC [ring_div] THEN
    MESON_TAC [FIELD_HOMOMORPHISM_INV, RING_HOMOMORPHISM_MUL, RING_INV])

  let RING_HOMOMORPHISM_RING_OF_NUM ← prove
   r"!r r' (f:A->B).
        ring_homomorphism(r,r') f
        ==> !n. f(ring_of_num r n) = ring_of_num r' n"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    INDUCT_TAC THEN REWRITE_TAC [ring_of_num] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP RING_HOMOMORPHISM_0) THEN
    FIRST_ASSUM (fun th => tactic_of do pure (ASM_SIMP_TAC
     [← MATCH_MP RING_HOMOMORPHISM_ADD th, RING_OF_NUM, RING_1])) THEN
    ASM_MESON_TAC [RING_HOMOMORPHISM_1])

  let RING_HOMOMORPHISM_RING_OF_INT ← prove
   r"!r r' (f:A->B).
        ring_homomorphism(r,r') f
        ==> !n. f(ring_of_int r n) = ring_of_int r' n"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [FORALL_INT_CASES, RING_OF_INT_CASES] THEN
    FIRST_ASSUM (fun th => tactic_of do pure (ASM_SIMP_TAC
     [RING_NEG, RING_OF_NUM, ← MATCH_MP RING_HOMOMORPHISM_NEG th])) THEN
    FIRST_ASSUM (fun th => tactic_of do pure (
     ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_RING_OF_NUM th])))

  let RING_CHAR_HOMOMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B).
