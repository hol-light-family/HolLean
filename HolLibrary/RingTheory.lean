   (REWRITE_TAC [POLY_RING_CLAUSES, IN_ELIM_THM] THEN
    MESON_TAC [POLY_DEG_ADD_LE, ← ARITH_RULE
     (← q r"a <= n /\ b <= n /\ c <= MAX a b ==> c <= n")])

  let POLY_DEG_RING_SUB_LE ← prove
   r"!r s p (q:(V->num)->A) n.
        p IN ring_carrier(poly_ring r s) /\
        q IN ring_carrier(poly_ring r s) /\
        poly_deg r p <= n /\ poly_deg r q <= n
        ==> poly_deg r (ring_sub (poly_ring r s) p q) <= n"
   (REWRITE_TAC [POLY_RING_CLAUSES, IN_ELIM_THM] THEN
    MESON_TAC [POLY_DEG_SUB_LE, ← ARITH_RULE
     (← q r"a <= n /\ b <= n /\ c <= MAX a b ==> c <= n")])

  let POLY_DEG_RING_SUM_LE ← prove
   r"!r s (f:K->(V->num)->A) k n.
        FINITE k /\
        (!i. i IN k
             ==> f i IN ring_carrier(poly_ring r s) /\ poly_deg r (f i) <= n)
        ==> poly_deg r (ring_sum (poly_ring r s) k f) <= n"
   (REPLICATE_TAC 3 GEN_TAC THEN
    GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, RING_SUM_CLAUSES] THEN
    CONJ_TAC THENL [REWRITE_TAC [POLY_RING, POLY_DEG_0, LE_0], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC POLY_DEG_RING_ADD_LE THEN
    ASM_SIMP_TAC [RING_SUM])

  let POLY_DEG_VAR_POW ← prove
   r"!(r:A ring) (s:V->bool) i k.
        poly_deg r (ring_pow (poly_ring r s) (poly_var r i) k) =
        if ring_1 r = ring_0 r then 0 else k"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [poly_deg, POLY_RING_VAR_POW] THEN
    REWRITE_TAC [← MESON []
     (← q r"(!m. ~((if m = a then w else z) = z) ==> P m) <=> (w = z \/ P a)")] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [MATCH_MP_TAC MINIMAL_UNIQUE THEN MESON_TAC [LT],
      REWRITE_TAC [MONOMIAL_DEG, NSUM_DELTA, IN_UNIV]] THEN
    MATCH_MP_TAC MINIMAL_UNIQUE THEN MESON_TAC [NOT_LE, LE_REFL])

  let POLY_POLY_DEG_EQ_0 ← prove
   r"!r u v (p:(V->num)->A).
        DISJOINT u v /\
        p IN ring_carrier(poly_ring r (u UNION v))
        ==> (poly_deg (poly_ring r u)
              (\m1 m2. if monomial v m1 /\ monomial u m2
                       then p(monomial_mul m1 m2) else ring_0 r) = 0 <=>
             poly_vars r p SUBSET u)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"u:V->bool", ← q r"v:V->bool"]
          RING_ISOMORPHISMS_POLY_POLY_RING) THEN
    ASM_REWRITE_TAC [ring_isomorphisms] THEN
    DISCH_THEN (fun th => tactic_of do
      match (CONJUNCTS th)[1]? with
      | some c1 => do
          let c2 ← REWRITE_RULE [ring_homomorphism, SUBSET, FORALL_IN_IMAGE] c1
          match (CONJUNCTS c2).head? with
          | some h => pure (ASSUME_TAC h)
          | none => throw "hd"
      | none => throw "el") THEN
    ONCE_REWRITE_TAC [← GSYM (← CONJUNCT1 LE)] THEN
    wPart lhand (fun t => do lhand (← rand t)) POLY_DEG_LE_EQ THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [IN_POLY_RING_CARRIER], DISCH_THEN SUBST1_TAC] THEN
    REWRITE_TAC [POLY_RING, POLY_0, ← CONJUNCT1 LE, SUBSET, poly_vars] THEN
    REWRITE_TAC [FORALL_IN_UNIONS, IMP_CONJ] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [FUN_EQ_THM] THEN
    REWRITE_TAC [NOT_FORALL_THM, ← MESON []
     (← q r"~((if p then x else z) = z) <=> p /\ ~(x = z)")] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"m:V->num") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"monomial (u UNION v) (m:V->num)") MP_TAC THENL
       [ASM_MESON_TAC [POLY_MONOMIALS],
        DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
        DISCH_THEN (STRIP_ASSUME_TAC o REWRITE_RULE [monomial])] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"monomial_restrict (v:V->bool) m",
        ← q r"monomial_restrict (u:V->bool) m"]) THEN
      ASM_SIMP_TAC [MONOMIAL_RESTRICT_EQ, FINITE_INTER] THEN
      ONCE_REWRITE_TAC [MONOMIAL_MUL_SYM] THEN
      ASM_SIMP_TAC [MONOMIAL_MUL_RESTRICT, MONOMIAL_RESTRICT_REFL] THEN
      MP_TAC (← ISPECL [← q r"v:V->bool", ← q r"monomial_restrict v m:V->num"]
       MONOMIAL_DEG_EQ_0) THEN
      ASM_SIMP_TAC [MONOMIAL_RESTRICT_EQ, FINITE_INTER] THEN
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [FUN_EQ_THM, monomial_1, monomial_restrict] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE LAND_CONV [monomial_vars]) THEN
      REWRITE_TAC [monomial_vars] THEN ASM SET_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"m2:V->num", ← q r"m1:V->num"] THEN
      ONCE_REWRITE_TAC [MONOMIAL_MUL_SYM] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"monomial_mul m1 m2:V->num")) THEN
      ASM_REWRITE_TAC [MONOMIAL_VARS_MUL, FORALL_IN_UNION] THEN
      MP_TAC (← ISPECL [← q r"v:V->bool", ← q r"m2:V->num"] MONOMIAL_DEG_EQ_0) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      UNDISCH_TAC (← q r"monomial v (m2:V->num)") THEN
      REWRITE_TAC [← GSYM MONOMIAL_VARS_EQ_EMPTY, monomial] THEN
      ASM SET_TAC []])

  let POLY_VARS_MUL_EQ ← prove
   r"!r p1 (p2:(V->num)->A).
        integral_domain r /\
        ring_polynomial r p1 /\ ring_polynomial r p2 /\
        (p1 = poly_0 r <=> p2 = poly_0 r)
        ==> poly_vars r (poly_mul r p1 p2) =
            poly_vars r p1 UNION poly_vars r p2"
   (← do
    -- right to left: the second TAUT, the three SET_RULEs (last first),
    -- then the first TAUT
    let t5 ← TAUT
     (← q r"~(q /\ s) /\ (~(p /\ r) ==> t)
     ==> (p <=> q) ==> (r <=> s) ==> t")
    let fv ← q r"f:((V->num)->A)->((V->num)->(V->num)->A)"
    let s4 ← SET_RULE
     (← q r"t DELETE a = s ==> a IN t ==> s UNION {a} = t")
    let s3 ← SET_RULE
     (← q r"s SUBSET t ==> !a. ~(a IN s) ==> s SUBSET t DELETE a")
    let s2 ← SET_RULE (← q r"t = s <=> t SUBSET s /\ ~(t PSUBSET s)")
    let t1 ← TAUT (← q r"(p <=> q) <=> p /\ q \/ ~p /\ ~q")
    let mkEq ← ExceptT.mk mk_eq
    let abbrevF : tactic := fun gl => ExceptT.run do
      let t ← liftExcept (do rand (← lhand gl.2))
      let e ← liftExcept (mkEq (fv, t))
      ExceptT.mk (ABBREV_TAC e gl)
    pure (REWRITE_TAC [t1] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [POLY_MUL_0, RING_POLYNOMIAL_0] THEN
    REWRITE_TAC [POLY_VARS_0, UNION_EMPTY] THEN
    REWRITE_TAC [s2] THEN
    ASM_SIMP_TAC [POLY_VARS_MUL, RING_POLYNOMIAL_IMP_POWERSERIES] THEN
    REWRITE_TAC [PSUBSET_ALT] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "a:V") STRIP_ASSUME_TAC) THEN ABBREV_TAC
     (← q r"s = (poly_vars (r:A ring) p1 UNION poly_vars r p2) DELETE (a:V)") THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "a:V") o MATCH_MP s3) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:V->bool", ← q "{a:V}"]
      POLY_POLY_DEG_EQ_0) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, NOT_IMP] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:V->bool", ← q "{a:V}"]
          RING_ISOMORPHISMS_POLY_POLY_RING) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP s4) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [RING_ISOMORPHISMS_ISOMORPHISM] THEN
    DISCH_THEN (fun th => tactic_of do
      match (CONJUNCTS th)[1]? with
      | some c => pure (MP_TAC c)
      | none => throw "el") THEN
    abbrevF THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FUN_EQ_THM]) THEN
    SIMP_TAC [] THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN DISCH_TAC THEN
    DISCH_THEN (fun th => tactic_of do
      let a1 ← SPEC (← q r"p1:(V->num)->A") th
      let a2 ← SPEC (← q r"p2:(V->num)->A") th
      let a3 ← SPEC (← q r"poly_mul r p1 p2:(V->num)->A") th
      pure (MP_TAC a3 THEN MP_TAC a2 THEN MP_TAC a1)) THEN
    ASM_REWRITE_TAC [IN_POLY_RING_CARRIER, SUBSET_UNION] THEN
    MATCH_MP_TAC t5 THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [← GSYM ADD_EQ_0]] THEN
    DISCH_TAC THEN ASM_SIMP_TAC [NOT_IMP, RING_POLYNOMIAL_MUL] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP RING_ISOMORPHISM_IMP_MONOMORPHISM) THEN
    REWRITE_TAC [RING_MONOMORPHISM_ALT_EQ] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
      let a1 ← SPEC (← q r"p1:(V->num)->A") th
      let a2 ← SPEC (← q r"p2:(V->num)->A") th
      pure (MP_TAC a2 THEN MP_TAC a1)) THEN
    ASM_REWRITE_TAC [IN_POLY_RING_CARRIER, SUBSET_UNION] THEN
    ASM_REWRITE_TAC [POLY_RING] THEN DISCH_TAC THEN DISCH_TAC THEN
      MP_TAC (← ISPECL
     [← q r"poly_ring (r:A ring) (s:V->bool)",
      ← q r"(f:((V->num)->A)->((V->num)->(V->num)->A)) p1",
      ← q r"(f:((V->num)->A)->((V->num)->(V->num)->A)) p2"]
     POLY_DEG_MUL) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_homomorphism]) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN DISCH_THEN (fun th => tactic_of do
      let c5 ← match (CONJUNCTS th)[5]? with
        | some c => pure c
        | none => throw "el"
      let b3 ← SPECL [← q r"p1:(V->num)->A", ← q r"p2:(V->num)->A"] c5
      let b2 ← SPEC (← q r"p1:(V->num)->A") (← CONJUNCT1 th)
      let b1 ← SPEC (← q r"p2:(V->num)->A") (← CONJUNCT1 th)
      pure (MP_TAC b1 THEN MP_TAC b2 THEN MP_TAC b3)) THEN
    ASM_REWRITE_TAC [IN_POLY_RING_CARRIER, SUBSET_UNION] THEN
    ASM_SIMP_TAC [POLY_RING, INTEGRAL_DOMAIN_POLY_RING]))

  let POLY_VARS_POW_EQ ← prove
   r"!r (p:(V->num)->A) n.
        integral_domain r /\ ring_polynomial r p
        ==> poly_vars r (poly_pow r p n) =
            if n = 0 then {} else poly_vars r p"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"p:(V->num)->A = poly_0 r") THENL
     [ASM_REWRITE_TAC [POLY_POW_0] THEN ASM_MESON_TAC [POLY_VARS_0, POLY_VARS_1],
      ALL_TAC] THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [POLY_POW, POLY_VARS_1, NOT_SUC] THEN
    wPart lhand (fun t => do lhand (← rand t)) POLY_VARS_MUL_EQ THEN
    ANTS_TAC THENL [ASM_SIMP_TAC [RING_POLYNOMIAL_POW], ASM SET_TAC []] THEN
    MP_TAC (← ISPECL [← q "poly_ring (r:A ring) (:V)", ← q r"p:(V->num)->A", ← q "n:num"]
          INTEGRAL_DOMAIN_POW_EQ_0) THEN
    ASM_SIMP_TAC [← GSYM RING_POLYNOMIAL, INTEGRAL_DOMAIN_POLY_RING] THEN
    ASM_REWRITE_TAC [POLY_RING_CLAUSES])

  -- @@RETURN BEGIN
  return { poly_deg, POLY_DEG_SUBRING_GENERATED, POLY_DEG_CONST, POLY_DEG_0, POLY_DEG_1,
           POLY_DEG_LE_EQ, POLY_DEG_LE, MONOMIAL_DEG_LE_POLY_DEG, POLY_DEG_GE_EQ,
           POLY_DEG_GE, COEFF_ABOVE_DEG, POLY_DEG_MONOMIAL_EXISTS, POLY_TOP_MONOMIAL_LE,
           POLY_TOP_MONOMIAL_LT, POLY_DEG_EQ_0_ALT, POLY_DEG_EQ_0, POLY_DEG_EQ,
           POLY_DEG_UNIQUE, POLY_DEG_VAR, COEFF_NONZERO_LE_DEG, COEFF_NONZERO_LE,
           POLY_DEG_LE_COEFF_EQ, POLY_DEG_LE_COEFF, POLY_DEG_GE_COEFF_EQ,
           POLY_DEG_GE_COEFF, POLY_DEG_EQ_COEFF_EQ, POLY_DEG_EQ_COEFF,
           POLY_DEG_EQ_FROM_LE, COEFF_POWSER_SUM, COEFF_POLY_SUM, POLY_DEG_NEG,
           POLY_DEG_ADD_LE, POLY_DEG_SUB_LE, POLY_DEG_ADD, POLY_DEG_SUB, POLY_DEG_MUL_LE,
           POLY_DEG_POW_LE, POLY_DEG_MUL, POLY_DEG_CMUL, POLY_MUL_LEADING_COEFF,
           POLY_DEG_MUL_UNIVARIATE, POLY_DEG_VAR_MUL, POLY_DEG_MUL_VAR,
           POLY_DEG_VARPOW_MUL, POLY_DEG_MUL_VARPOW, INTEGRAL_DOMAIN_POLY_RING,
           POLY_DEG_POW, POLY_DEG_DIVIDES_LE, POLY_DEG_RING_ADD_LE, POLY_DEG_RING_SUB_LE,
           POLY_DEG_RING_SUM_LE, POLY_DEG_VAR_POW, POLY_POLY_DEG_EQ_0, POLY_VARS_MUL_EQ,
           POLY_VARS_POW_EQ }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Cardinalities of sets of monomials, polynomials and of power series.      -/
/- (ringtheory.ml 23102-23234)                                               -/
/- ------------------------------------------------------------------------- -/

structure Cardinalities where
  -- @@FIELDS
  CARD_EQ_MONOMIALS_FINITE : thm
  CARD_EQ_MONOMIALS_INFINITE : thm
  CARD_EQ_MONOMIALS_COUNTABLE : thm
  CARD_EQ_POWSER_RING_COUNTABLE : thm
  CARD_EQ_POWSER_RING_FINITE : thm
  CARD_EQ_POWSER_RING_INFINITE : thm
  CARD_EQ_POLY_RING_COUNTABLE : thm
  CARD_EQ_POLY_RING_FINITE : thm
  CARD_EQ_POLY_RING_INFINITE : thm
  deriving Inhabited

@[nospecialize]
def setupCardinalities [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BMonomials : Monomials) (BPolyRings : PolyRings) :
    ExceptT String IO Cardinalities := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, MESON, SET_RULE, SET_TAC, .. } := D
  let { CARD_EQ_CONG, CARD_EQ_EXP_INFINITE_FINITE, CARD_EQ_FUNSPACE, CARD_EQ_INFINITE,
        CARD_EQ_REFL, CARD_EQ_REFL_IMP, CARD_EQ_RESTRICTED_FUNSPACE_INFINITE,
        CARD_EQ_TRANS, CARD_EXP_CONG, CARD_MUL_ABSORB, CARD_MUL_CONG, CARD_MUL_SYM, .. } := D.core1
  let { COUNTABLE_CASES, EQ_IMP, .. } := D.core2
  let { FINITE_IMP_COUNTABLE, FINITE_SUBSET, FORALL_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, INFINITE_CARD_LE, .. } := D.core4
  let { SUBSET, SUBSET_UNIV, UNIV_NOT_EMPTY, .. } := D.core7
  let { num_INFINITE, .. } := D.core8
  let { RING_0, TRIVIAL_RING_ALT, .. } := BBasics
  let { monomial, monomial_vars, .. } := BMonomials
  let { RING_CARRIER_POLY_RING, RING_CARRIER_POWSER_RING, .. } := BPolyRings
  -- @@SCOPE END

  let CARD_EQ_MONOMIALS_FINITE ← prove
   r"!s:V->bool. FINITE s /\ ~(s = {}) ==> {m | monomial s m} =_c (:num)"
   (← do
    -- right to left: the SET_RULE, then the MESON
    let sr ← SET_RULE
     (← q r"{x | ~(f x = k x)} SUBSET s <=>
      IMAGE f s SUBSET UNIV /\ {x | ~(f x = k x)} SUBSET s")
    let mm ← MESON [FINITE_SUBSET]
     (← q r"FINITE s ==> (FINITE t /\ t SUBSET s <=> t SUBSET s)")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [monomial, monomial_vars] THEN
    ASM_SIMP_TAC [mm] THEN
    ONCE_REWRITE_TAC [sr] THEN
    wPart lhand lhand CARD_EQ_FUNSPACE THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
    MATCH_MP_TAC CARD_EQ_EXP_INFINITE_FINITE THEN
    ASM_REWRITE_TAC [num_INFINITE]))

  let CARD_EQ_MONOMIALS_INFINITE ← prove
   r"!s:V->bool. INFINITE s ==> {m | monomial s m} =_c s"
   (← do
    -- right to left: the ARITH_RULE, then the SET_RULE
    let ar ← ARITH_RULE (← q "~(1 = 0)")
    let sr ← SET_RULE
     (← q r"{m | FINITE {i | ~(m i = 0)} /\ {i | ~(m i = 0)} SUBSET s} =
      {m | IMAGE m s SUBSET (:num) /\
           {i | ~(m i = 0)} SUBSET s /\
           FINITE {i | ~(m i = 0)}}")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [monomial, monomial_vars] THEN
    ONCE_REWRITE_TAC [sr] THEN
    wPart lhand (fun t => do lhand (← rand t)) CARD_EQ_RESTRICTED_FUNSPACE_INFINITE THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REWRITE_TAC [SUBSET_UNIV] THEN MP_TAC ar THEN
      ASM SET_TAC [],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS)] THEN
    wPart lhand lhand CARD_MUL_SYM THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
    MATCH_MP_TAC CARD_MUL_ABSORB THEN
    ASM_REWRITE_TAC [← GSYM INFINITE_CARD_LE, UNIV_NOT_EMPTY]))

  let CARD_EQ_MONOMIALS_COUNTABLE ← prove
   r"!s:V->bool. COUNTABLE s /\ ~(s = {}) ==> {m | monomial s m} =_c (:num)"
   (REWRITE_TAC [COUNTABLE_CASES] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [CARD_EQ_MONOMIALS_FINITE] THEN
    TRANS_TAC CARD_EQ_TRANS (← q r"s:V->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CARD_EQ_MONOMIALS_INFINITE THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CARD_EQ_INFINITE)) THEN
    REWRITE_TAC [num_INFINITE])

  let CARD_EQ_POWSER_RING_COUNTABLE ← prove
   r"!(r:A ring) (s:V->bool).
        COUNTABLE s /\ ~(s = {})
        ==> ring_carrier(powser_ring r s) =_c (ring_carrier r) ^_c (:num)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{m | monomial (s:V->bool) m}", ← q "ring_carrier r:A->bool",
      ← q r"(\m. ring_0 r):(V->num)->A"] CARD_EQ_FUNSPACE) THEN
    MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC CARD_EQ_CONG THEN
    ASM_SIMP_TAC [CARD_EXP_CONG, CARD_EQ_REFL, CARD_EQ_MONOMIALS_COUNTABLE] THEN
    MATCH_MP_TAC CARD_EQ_REFL_IMP THEN
    REWRITE_TAC [RING_CARRIER_POWSER_RING] THEN
    MP_TAC (← ISPEC (← q "r:A ring") RING_0) THEN SET_TAC [])

  let CARD_EQ_POWSER_RING_FINITE ← prove
   r"!(r:A ring) (s:V->bool).
        FINITE s /\ ~(s = {})
        ==> ring_carrier(powser_ring r s) =_c (ring_carrier r) ^_c (:num)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CARD_EQ_POWSER_RING_COUNTABLE THEN
    ASM_SIMP_TAC [FINITE_IMP_COUNTABLE])

  let CARD_EQ_POWSER_RING_INFINITE ← prove
   r"!(r:A ring) (s:V->bool).
        INFINITE s
        ==> ring_carrier(powser_ring r s) =_c (ring_carrier r) ^_c s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{m | monomial (s:V->bool) m}", ← q "ring_carrier r:A->bool",
      ← q r"(\m. ring_0 r):(V->num)->A"] CARD_EQ_FUNSPACE) THEN
    MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC CARD_EQ_CONG THEN
    ASM_SIMP_TAC [CARD_EXP_CONG, CARD_EQ_REFL, CARD_EQ_MONOMIALS_INFINITE] THEN
    MATCH_MP_TAC CARD_EQ_REFL_IMP THEN
    REWRITE_TAC [RING_CARRIER_POWSER_RING] THEN
    MP_TAC (← ISPEC (← q "r:A ring") RING_0) THEN SET_TAC [])

  let CARD_EQ_POLY_RING_COUNTABLE ← prove
   r"!(r:A ring) (s:V->bool).
        ~trivial_ring r /\ COUNTABLE s /\ ~(s = {})
        ==> ring_carrier(poly_ring r s) =_c (ring_carrier r) *_c (:num)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{m | monomial (s:V->bool) m}", ← q "ring_carrier r:A->bool",
      ← q r"(\m. ring_0 r):(V->num)->A"] CARD_EQ_RESTRICTED_FUNSPACE_INFINITE) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [← GSYM TRIVIAL_RING_ALT] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RING_0] THEN
      MATCH_MP_TAC (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] CARD_EQ_INFINITE)
          num_INFINITE) THEN
      MATCH_MP_TAC CARD_EQ_MONOMIALS_COUNTABLE THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC CARD_EQ_CONG] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CARD_EQ_REFL_IMP THEN
      REWRITE_TAC [RING_CARRIER_POLY_RING] THEN
      MP_TAC (← ISPEC (← q "r:A ring") RING_0) THEN SET_TAC [],
      wPart lhand lhand CARD_MUL_SYM THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
      ASM_SIMP_TAC [CARD_MUL_CONG, CARD_EQ_REFL, CARD_EQ_MONOMIALS_COUNTABLE]])

  let CARD_EQ_POLY_RING_FINITE ← prove
   r"!(r:A ring) (s:V->bool).
        ~trivial_ring r /\ FINITE s /\ ~(s = {})
        ==> ring_carrier(poly_ring r s) =_c (ring_carrier r) *_c (:num)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CARD_EQ_POLY_RING_COUNTABLE THEN
    ASM_SIMP_TAC [FINITE_IMP_COUNTABLE])

  let CARD_EQ_POLY_RING_INFINITE ← prove
   r"!(r:A ring) (s:V->bool).
        ~trivial_ring r /\ INFINITE s
        ==> ring_carrier(poly_ring r s) =_c (ring_carrier r) *_c s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{m | monomial (s:V->bool) m}", ← q "ring_carrier r:A->bool",
      ← q r"(\m. ring_0 r):(V->num)->A"] CARD_EQ_RESTRICTED_FUNSPACE_INFINITE) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [← GSYM TRIVIAL_RING_ALT] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RING_0] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← REWRITE_RULE [IMP_CONJ] CARD_EQ_INFINITE)) THEN
      MATCH_MP_TAC CARD_EQ_MONOMIALS_INFINITE THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC CARD_EQ_CONG] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CARD_EQ_REFL_IMP THEN
      REWRITE_TAC [RING_CARRIER_POLY_RING] THEN
      MP_TAC (← ISPEC (← q "r:A ring") RING_0) THEN SET_TAC [],
      wPart lhand lhand CARD_MUL_SYM THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
      ASM_SIMP_TAC [CARD_MUL_CONG, CARD_EQ_REFL, CARD_EQ_MONOMIALS_INFINITE]])

  -- @@RETURN BEGIN
  return { CARD_EQ_MONOMIALS_FINITE, CARD_EQ_MONOMIALS_INFINITE,
           CARD_EQ_MONOMIALS_COUNTABLE, CARD_EQ_POWSER_RING_COUNTABLE,
           CARD_EQ_POWSER_RING_FINITE, CARD_EQ_POWSER_RING_INFINITE,
           CARD_EQ_POLY_RING_COUNTABLE, CARD_EQ_POLY_RING_FINITE,
           CARD_EQ_POLY_RING_INFINITE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Polynomial evaluation.  (ringtheory.ml 23234-23703)                        -/
/- ------------------------------------------------------------------------- -/

structure Evaluation where
  -- @@FIELDS
  poly_evaluate : thm
  POLY_EVALUATE : thm
  POLY_EVALUATE_0 : thm
  POLY_EVALUATE_1 : thm
  POLY_EVALUATE_VAR : thm
  POLY_EVALUATE_CONST : thm
  POLY_EVALUATE_ADD : thm
  POLY_EVALUATE_SUB : thm
  POLY_EVALUATE_MUL : thm
  POLY_EVALUATE_POW : thm
  POLY_EVALUATE_RING_SUM : thm
  POLY_EVALUATE_RING_PRODUCT : thm
  RING_HOMOMORPHISM_POLY_EVALUATE : thm
  RING_EPIMORPHISM_POLY_EVALUATE : thm
  POLY_EVALUATE_HOMOMORPHIC_IMAGE : thm
  POLY_EXTEND_EVALUATE : thm
  POLY_EVALUATE_EQ : thm
  POWSER_EVALUATE_AT_0 : thm
  POLY_EVALUATE_AT_0 : thm
  RING_HOMOMORPHISM_POWSER_EVALUATE_AT_0 : thm
  RING_EPIMORPHISM_POWSER_EVALUATE_AT_0 : thm
  POLY_EVALUATE_REINDEX : thm
  poly_eval : thm
  POLY_EVAL : thm
  POLY_EVAL_0 : thm
  POLY_EVAL_1 : thm
  POLY_EVAL_VAR : thm
  POLY_EVAL_CONST : thm
  POLY_EVAL_ADD : thm
  POLY_EVAL_SUB : thm
  POLY_EVAL_MUL : thm
  POLY_EVAL_POW : thm
  POLY_EVAL_RING_SUM : thm
  POLY_EVAL_RING_PRODUCT : thm
  RING_HOMOMORPHISM_POLY_EVAL : thm
  RING_EPIMORPHISM_POLY_EVAL : thm
  POLY_EVAL_HOMOMORPHIC_IMAGE : thm
  POLY_EXTEND_UNIVARIATE : thm
  POLY_EVAL_EXPAND : thm
  POLY_EXPAND : thm
  POWSER_EVAL_AT_0 : thm
  POLY_EVAL_AT_0 : thm
  RING_HOMOMORPHISM_POWSER_EVAL_AT_0 : thm
  RING_EPIMORPHISM_POWSER_EVAL_AT_0 : thm
  POWSER_RING_HOMOMORPHISM_COEFF_0 : thm
  POLY_RING_HOMOMORPHISM_COEFF_0 : thm
  POWSER_RING_EPIMORPHISM_COEFF_0 : thm
  POLY_RING_EPIMORPHISM_COEFF_0 : thm
  POLY_EVAL_COEFF : thm
  IMAGE_POLY_EVAL : thm
  POLY_VAR_DIVIDES_UNIVARIATE : thm
  deriving Inhabited

@[nospecialize]
def setupEvaluation [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BProducts : Products) (BDivides : Divides) (BSubrings : Subrings) (BHoms : Homs) (BKernels : Kernels) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BHomExtend : HomExtend) (BRenaming : Renaming) (BOneCoeff : OneCoeff) (BDegree : Degree) :
    ExceptT String IO Evaluation := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, SET_TAC, new_definition, .. } := D
  let { CONTRAPOS_THM, DE_MORGAN_THM, ETA_AX, .. } := D.core2
  let { FINITE_SUBSET_NUMSEG, FORALL_IN_IMAGE, FORALL_ONE_THM, FUN_EQ_THM, IMAGE_I, .. } := D.core3
  let { IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, I_THM, LE_0, LE_1, LE_REFL, .. } := D.core5
  let { MONO_EXISTS, NOT_LE, .. } := D.core6
  let { SUBSET, SUBSET_NUMSEG, SUBSET_UNIV, SUB_ADD, .. } := D.core7
  let { o_DEF, o_THM, .. } := D.core8
  let { RING_0, RING_MUL_LZERO, .. } := BBasics
  let { RING_POW, ring_pow, .. } := BNumbers
  let { RING_SUM_EQ_GENERAL_INVERSES, RING_SUM_SUPERSET, .. } := BSums
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, RING_PRODUCT_SING, .. } := BProducts
  let { ring_divides, .. } := BDivides
  let { CARRIER_SUBRING_GENERATED_SUBRING, .. } := BSubrings
  let { RING_EPIMORPHISM_EQ, RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_EQ,
        RING_HOMOMORPHISM_FROM_SUBRING_GENERATED, RING_HOMOMORPHISM_I, .. } := BHoms
  let { RING_EPIMORPHISM_ALT, ring_image, .. } := BKernels
  let { MONOMIAL_DEG_UNIVARIATE, MONOMIAL_VARS_UNIVARIATE, monomial_1, .. } := BMonomials
  let { RING_POLYNOMIAL_IMP_POWERSERIES, ring_polynomial, .. } := BPowerSeries
  let { POLY_CONST, POLY_RING, POLY_VAR_UNIV, POWSER_CONST, POWSER_RING,
        RING_HOMOMORPHISM_POLY_CONST, RING_POLYNOMIAL, .. } := BPolyRings
  let { IMAGE_POLY_EXTEND_1, POLY_EXTEND, POLY_EXTEND_0, POLY_EXTEND_1,
        POLY_EXTEND_ADD, POLY_EXTEND_AT_0, POLY_EXTEND_CONST, POLY_EXTEND_EQ,
        POLY_EXTEND_FROM_SUBRING_GENERATED, POLY_EXTEND_HOMOMORPHIC_IMAGE,
        POLY_EXTEND_ID, POLY_EXTEND_MUL, POLY_EXTEND_POW, POLY_EXTEND_RING_PRODUCT,
        POLY_EXTEND_RING_SUM, POLY_EXTEND_SUB, POLY_EXTEND_VAR, POWSER_EXTEND_AT_0,
        RING_HOMOMORPHISM_POLY_EXTEND, RING_HOMOMORPHISM_POWSER_EXTEND_AT_0,
        poly_extend, .. } := BHomExtend
  let { POLY_EXTEND_REINDEX, .. } := BRenaming
  let { COEFF_POLY_VAR_MUL, FUN_EQ_COEFF, RING_POLYNOMIAL_COEFF, coeff, .. } := BOneCoeff
  let { COEFF_NONZERO_LE_DEG, MONOMIAL_DEG_LE_POLY_DEG, .. } := BDegree
  -- @@SCOPE END

  let poly_evaluate ← new_definition
   r"poly_evaluate r p (x:V->A) = poly_extend (r,r) I x p"

  let POLY_EVALUATE ← prove
   r"!r p (x:V->A). poly_evaluate r p x IN ring_carrier r"
   (REWRITE_TAC [poly_evaluate, POLY_EXTEND])

  let POLY_EVALUATE_0 ← prove
   r"!r (x:V->A). poly_evaluate r (poly_0 r) x = ring_0 r"
   (SIMP_TAC [poly_evaluate, POLY_EXTEND_0, RING_HOMOMORPHISM_I])

  let POLY_EVALUATE_1 ← prove
   r"!r (x:V->A). poly_evaluate r (poly_1 r) x = ring_1 r"
   (SIMP_TAC [poly_evaluate, POLY_EXTEND_1, RING_HOMOMORPHISM_I])

  let POLY_EVALUATE_VAR ← prove
   r"!(r:A ring) (i:V) x.
        x i IN ring_carrier r ==> poly_evaluate r (poly_var r i) x = x i"
   (SIMP_TAC [poly_evaluate, POLY_EXTEND_VAR, RING_HOMOMORPHISM_I])

  let POLY_EVALUATE_CONST ← prove
   r"!r a (x:V->A).
        a IN ring_carrier r ==> poly_evaluate r (poly_const r a) x = a"
   (SIMP_TAC [poly_evaluate, POLY_EXTEND_CONST, I_THM, RING_HOMOMORPHISM_I])

  let POLY_EVALUATE_ADD ← prove
   r"!r p q (x:V->A).
        ring_polynomial r p /\ ring_polynomial r q
        ==> poly_evaluate r (poly_add r p q) x =
            ring_add r (poly_evaluate r p x) (poly_evaluate r q x)"
   (SIMP_TAC [poly_evaluate, POLY_EXTEND_ADD, I_THM, RING_HOMOMORPHISM_I])

  let POLY_EVALUATE_SUB ← prove
   r"!r p q (x:V->A).
        ring_polynomial r p /\ ring_polynomial r q
        ==> poly_evaluate r (poly_sub r p q) x =
            ring_sub r (poly_evaluate r p x) (poly_evaluate r q x)"
   (SIMP_TAC [poly_evaluate, POLY_EXTEND_SUB, I_THM, RING_HOMOMORPHISM_I])

  let POLY_EVALUATE_MUL ← prove
   r"!r p q (x:V->A).
        ring_polynomial r p /\ ring_polynomial r q /\
        (!i. i IN poly_vars r p UNION poly_vars r q
             ==> x i IN ring_carrier r)
        ==> poly_evaluate r (poly_mul r p q) x =
            ring_mul r (poly_evaluate r p x) (poly_evaluate r q x)"
   (SIMP_TAC [poly_evaluate, POLY_EXTEND_MUL, I_THM, RING_HOMOMORPHISM_I])

  let POLY_EVALUATE_POW ← prove
   r"!r p (x:V->A) n.
        ring_polynomial r p /\
        (!i. i IN poly_vars r p ==> x i IN ring_carrier r)
        ==> poly_evaluate r (poly_pow r p n) x =
            ring_pow r (poly_evaluate r p x) n"
   (SIMP_TAC [poly_evaluate, POLY_EXTEND_POW, I_THM, RING_HOMOMORPHISM_I])

  let POLY_EVALUATE_RING_SUM ← prove
   r"!(r:A ring) (v:V->bool) (s:W->bool) f x.
        (!i. i IN v ==> x i IN ring_carrier r) /\
        FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier(poly_ring r v))
        ==> poly_evaluate r (ring_sum (poly_ring r v) s f) x =
            ring_sum r s (\a. poly_evaluate r (f a) x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_evaluate] THEN
    MATCH_MP_TAC POLY_EXTEND_RING_SUM THEN
    ASM_REWRITE_TAC [RING_HOMOMORPHISM_I] THEN ASM SET_TAC [])

  let POLY_EVALUATE_RING_PRODUCT ← prove
   r"!(r:A ring) (v:V->bool) (s:W->bool) f x.
        (!i. i IN v ==> x i IN ring_carrier r) /\
        FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier(poly_ring r v))
        ==> poly_evaluate r (ring_product (poly_ring r v) s f) x =
            ring_product r s (\a. poly_evaluate r (f a) x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_evaluate] THEN
    MATCH_MP_TAC POLY_EXTEND_RING_PRODUCT THEN
    ASM_REWRITE_TAC [RING_HOMOMORPHISM_I] THEN ASM SET_TAC [])

  let RING_HOMOMORPHISM_POLY_EVALUATE ← prove
   r"!r s (x:V->A).
        IMAGE x s SUBSET ring_carrier r
        ==> ring_homomorphism (poly_ring r s,r) (\p. poly_evaluate r p x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_evaluate, ETA_AX] THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_POLY_EXTEND THEN
    REWRITE_TAC [RING_HOMOMORPHISM_I] THEN ASM SET_TAC [])

  let RING_EPIMORPHISM_POLY_EVALUATE ← prove
   r"!r s (x:V->A).
        IMAGE x s SUBSET ring_carrier r
        ==> ring_epimorphism (poly_ring r s,r) (\p. poly_evaluate r p x)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [RING_EPIMORPHISM_ALT, RING_HOMOMORPHISM_POLY_EVALUATE] THEN
    REWRITE_TAC [ring_image, SUBSET, IN_IMAGE] THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"poly_const r a:(V->num)->A") THEN
    ASM_SIMP_TAC [POLY_CONST, POLY_EVALUATE_CONST])

  let POLY_EVALUATE_HOMOMORPHIC_IMAGE ← prove
   r"!(r:A ring) (s:B ring) (x:V->A) f v p.
        ring_homomorphism (r,s) f /\
        IMAGE x v SUBSET ring_carrier r /\
        p IN ring_carrier (poly_ring r v)
        ==> f(poly_evaluate r p x) = poly_evaluate s (f o p) (f o x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_evaluate] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "r:A ring", ← q "s:B ring", ← q "I:A->A",
                   ← q r"v:V->bool", ← q r"x:V->A", ← q "f:A->B", ← q r"p:(V->num)->A"]
      POLY_EXTEND_HOMOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [RING_HOMOMORPHISM_I] THEN DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [poly_extend, o_THM, I_THM] THEN
    MATCH_MP_TAC RING_SUM_SUPERSET THEN
    SIMP_TAC [IN_ELIM_THM, RING_MUL_LZERO, RING_PRODUCT,
              SUBSET, CONTRAPOS_THM] THEN
    ASM_MESON_TAC [RING_HOMOMORPHISM_0])

  let POLY_EXTEND_EVALUATE ← prove
   r"!r s (f:A->B) (x:V->B) p.
        ring_homomorphism(r,s) f
        ==> poly_extend (r,s) f x p = poly_evaluate s (f o p) x"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [poly_extend, poly_evaluate, o_THM, I_THM] THEN
    MATCH_MP_TAC RING_SUM_SUPERSET THEN
    SIMP_TAC [IN_ELIM_THM, RING_MUL_LZERO, RING_PRODUCT,
              SUBSET, CONTRAPOS_THM] THEN
    ASM_MESON_TAC [RING_HOMOMORPHISM_0])

  let POLY_EVALUATE_EQ ← prove
   r"!r s (p:(V->num)->A) x y.
        (!i. i IN s ==> x i IN ring_carrier r) /\
        (!i. i IN s ==> x i = y i) /\
        p IN ring_carrier(poly_ring r s)
        ==> poly_evaluate r p x = poly_evaluate r p y"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_evaluate] THEN
    MATCH_MP_TAC POLY_EXTEND_EQ THEN EXISTS_TAC (← q r"s:V->bool") THEN
    ASM_REWRITE_TAC [])

  let POWSER_EVALUATE_AT_0 ← prove
   r"!r (p:(V->num)->A).
        ring_powerseries r p
        ==> poly_evaluate r p (\x. ring_0 r) = p monomial_1"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_evaluate] THEN
    ASM_MESON_TAC [POWSER_EXTEND_AT_0, RING_HOMOMORPHISM_I, I_THM])

  let POLY_EVALUATE_AT_0 ← prove
   r"!r v (p:(V->num)->A).
        p IN ring_carrier (poly_ring r v)
        ==> poly_evaluate r p (\x. ring_0 r) = p monomial_1"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_evaluate] THEN
    ASM_MESON_TAC [POLY_EXTEND_AT_0, RING_HOMOMORPHISM_I, I_THM])

  let RING_HOMOMORPHISM_POWSER_EVALUATE_AT_0 ← prove
   r"!(r:A ring) (s:V->bool).
        ring_homomorphism (powser_ring r s,r)
                          (\p. poly_evaluate r p (\i. ring_0 r))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_evaluate, ETA_AX] THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_POWSER_EXTEND_AT_0 THEN
    REWRITE_TAC [RING_HOMOMORPHISM_I] THEN ASM SET_TAC [])

  let RING_EPIMORPHISM_POWSER_EVALUATE_AT_0 ← prove
   r"!(r:A ring) (s:V->bool).
        ring_epimorphism (powser_ring r s,r)
                         (\p. poly_evaluate r p (\i. ring_0 r))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [RING_EPIMORPHISM_ALT,
                  RING_HOMOMORPHISM_POWSER_EVALUATE_AT_0] THEN
    REWRITE_TAC [ring_image, SUBSET, IN_IMAGE] THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"poly_const r a:(V->num)->A") THEN
    ASM_SIMP_TAC [POWSER_CONST, POLY_EVALUATE_CONST])

  let POLY_EVALUATE_REINDEX ← prove
   r"!(r:R ring) A B q f:X->Y c:Y->R.
        BIJ f A B /\ poly_vars r q SUBSET B
        ==> poly_evaluate r (poly_reindex r q f A B) (c o f) =
            poly_evaluate r q c"
   (REWRITE_TAC [poly_evaluate, POLY_EXTEND_REINDEX])

  let poly_eval ← new_definition
   r"poly_eval (r:A ring) p x = poly_evaluate r p (\v:1. x)"

  let POLY_EVAL ← prove
   r"!r p (x:A). poly_eval r p x IN ring_carrier r"
   (REWRITE_TAC [poly_eval, POLY_EVALUATE])

  let POLY_EVAL_0 ← prove
   r"!(r:A ring) x. poly_eval r (poly_0 r) x = ring_0 r"
   (SIMP_TAC [poly_eval, POLY_EVALUATE_0])

  let POLY_EVAL_1 ← prove
   r"!(r:A ring) x. poly_eval r (poly_1 r) x = ring_1 r"
   (SIMP_TAC [poly_eval, POLY_EVALUATE_1])

  let POLY_EVAL_VAR ← prove
   r"!(r:A ring) x.
        x IN ring_carrier r ==> poly_eval r (poly_var r one) x = x"
   (SIMP_TAC [poly_eval, POLY_EVALUATE_VAR])

  let POLY_EVAL_CONST ← prove
   r"!(r:A ring) a x.
        a IN ring_carrier r ==> poly_eval r (poly_const r a) x = a"
   (SIMP_TAC [poly_eval, POLY_EVALUATE_CONST])

  let POLY_EVAL_ADD ← prove
   r"!(r:A ring) p q x.
        ring_polynomial r p /\ ring_polynomial r q
        ==> poly_eval r (poly_add r p q) x =
            ring_add r (poly_eval r p x) (poly_eval r q x)"
   (SIMP_TAC [poly_eval, POLY_EVALUATE_ADD])

  let POLY_EVAL_SUB ← prove
   r"!(r:A ring) p q x.
        ring_polynomial r p /\ ring_polynomial r q
        ==> poly_eval r (poly_sub r p q) x =
            ring_sub r (poly_eval r p x) (poly_eval r q x)"
   (SIMP_TAC [poly_eval, POLY_EVALUATE_SUB])

  let POLY_EVAL_MUL ← prove
   r"!(r:A ring) p q x.
        ring_polynomial r p /\ ring_polynomial r q /\ x IN ring_carrier r
        ==> poly_eval r (poly_mul r p q) x =
            ring_mul r (poly_eval r p x) (poly_eval r q x)"
   (SIMP_TAC [poly_eval, POLY_EVALUATE_MUL])

  let POLY_EVAL_POW ← prove
   r"!(r:A ring) p n x.
        ring_polynomial r p /\ x IN ring_carrier r
        ==> poly_eval r (poly_pow r p n) x =
            ring_pow r (poly_eval r p x) n"
   (SIMP_TAC [poly_eval, POLY_EVALUATE_POW])

  let POLY_EVAL_RING_SUM ← prove
   r"!(r:A ring) (s:W->bool) (f:W->(1->num)->A) (x:A).
        x IN ring_carrier r /\ FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier(poly_ring r (:1)))
        ==> poly_eval r (ring_sum (poly_ring r (:1)) s f) x =
            ring_sum r s (\a. poly_eval r (f a) x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_eval] THEN
    MATCH_MP_TAC POLY_EVALUATE_RING_SUM THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE])

  let POLY_EVAL_RING_PRODUCT ← prove
   r"!(r:A ring) (s:W->bool) (f:W->(1->num)->A) (x:A).
        x IN ring_carrier r /\ FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier(poly_ring r (:1)))
        ==> poly_eval r (ring_product (poly_ring r (:1)) s f) x =
            ring_product r s (\a. poly_eval r (f a) x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_eval] THEN
    MATCH_MP_TAC POLY_EVALUATE_RING_PRODUCT THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE])

  let RING_HOMOMORPHISM_POLY_EVAL ← prove
   r"!r s x:A.
        x IN ring_carrier r
        ==> ring_homomorphism (poly_ring r s,r) (\p. poly_eval r p x)"
   (SIMP_TAC [poly_eval, RING_HOMOMORPHISM_POLY_EVALUATE, SUBSET,
              FORALL_IN_IMAGE])

  let RING_EPIMORPHISM_POLY_EVAL ← prove
   r"!r s x:A.
        x IN ring_carrier r
        ==> ring_epimorphism (poly_ring r s,r) (\p. poly_eval r p x)"
   (SIMP_TAC [poly_eval, RING_EPIMORPHISM_POLY_EVALUATE, SUBSET,
              FORALL_IN_IMAGE])

  let POLY_EVAL_HOMOMORPHIC_IMAGE ← prove
   r"!(r:A ring) (s:B ring) x f p.
        ring_homomorphism (r,s) f /\
        x IN ring_carrier r /\
        p IN ring_carrier (poly_ring r (:1))
        ==> f(poly_eval r p x) = poly_eval s (f o p) (f x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_eval] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "s:B ring", ← q r"(\v. x):1->A",
                   ← q "f:A->B", ← q "(:1)", ← q "p:(1->num)->A"]
          POLY_EVALUATE_HOMOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, o_DEF])

  let POLY_EXTEND_UNIVARIATE ← prove
   r"!r r' (h:A->B) x p.
      ring_homomorphism(r,r') h /\ x one IN ring_carrier r' /\
      p IN ring_carrier (poly_ring r (:1))
      ==> poly_extend (r,r') h x p =
          ring_sum r' (0..poly_deg r p)
                      (\i. ring_mul r' (h(coeff i p)) (ring_pow r' (x one) i))"
   (← do
    -- right to left: the TAUT, then the MESON
    let tt ← TAUT (← q r"r /\ (r ==> (q <=> p)) ==> ~p ==> ~q /\ r")
    let mm ← MESON [RING_SUM_SUPERSET]
     (← q r"!t. t SUBSET s /\ (!x. x IN s /\ ~(x IN t) ==> f x = ring_0 r) /\
           ring_sum r t f = p
          ==> p = ring_sum r s f")
    pure (REWRITE_TAC [coeff] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC mm THEN
    EXISTS_TAC (← q r"{i | ~((p:(1->num)->A) (\v. i) = ring_0 r)}") THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_NUMSEG, LE_0] THEN REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q "i:num") THEN DISCH_TAC THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM MONOMIAL_DEG_UNIVARIATE] THEN
      MATCH_MP_TAC MONOMIAL_DEG_LE_POLY_DEG THEN
      ASM_REWRITE_TAC [RING_POLYNOMIAL],
      X_GEN_TAC (← q "i:num") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [RING_HOMOMORPHISM_0, RING_POW, RING_MUL_LZERO],
      REWRITE_TAC [poly_extend]] THEN
    MATCH_MP_TAC RING_SUM_EQ_GENERAL_INVERSES THEN
    MAP_EVERY EXISTS_TAC [← q r"\(i:num) (v:1). i", ← q r"\m:1->num. m one"] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q "m:1->num") THEN MATCH_MP_TAC tt THEN
      SIMP_TAC [] THEN REWRITE_TAC [FUN_EQ_THM, FORALL_ONE_THM],
      X_GEN_TAC (← q "i:num") THEN DISCH_TAC THEN ASM_REWRITE_TAC []] THEN
    AP_TERM_TAC THEN REWRITE_TAC [MONOMIAL_VARS_UNIVARIATE] THEN
    COND_CASES_TAC THEN
    ASM_SIMP_TAC [ring_pow, RING_PRODUCT_CLAUSES, RING_PRODUCT_SING, RING_POW]))

  let POLY_EVAL_EXPAND ← prove
   r"!(r:A ring) x p.
        x IN ring_carrier r /\
        p IN ring_carrier (poly_ring r (:1))
        ==> poly_eval r p x =
            ring_sum r (0..poly_deg r p)
                       (\i. ring_mul r (coeff i p) (ring_pow r x i))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_eval, poly_evaluate] THEN
    ASM_SIMP_TAC [RING_HOMOMORPHISM_I, I_THM, POLY_EXTEND_UNIVARIATE])

  let POLY_EXPAND ← prove
   r"!r (p:(1->num)->A).
        p IN ring_carrier (poly_ring r (:1))
        ==> p = ring_sum
                  (poly_ring r (:1)) (0..poly_deg r p)
                  (\i. ring_mul (poly_ring r (:1))
                         (poly_const r (coeff i p))
                         (ring_pow (poly_ring r (:1)) (poly_var r one) i))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "(:1)", ← q "p:(1->num)->A"] POLY_EXTEND_ID) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => tactic_of do
      pure (GEN_REWRITE_TAC LAND_CONV [← SYM th])) THEN
    MATCH_MP_TAC POLY_EXTEND_UNIVARIATE THEN
    ASM_REWRITE_TAC [RING_HOMOMORPHISM_POLY_CONST, POLY_VAR_UNIV])

  let POWSER_EVAL_AT_0 ← prove
   r"!(r:A ring) p.
        ring_powerseries r p
        ==> poly_eval r p (ring_0 r) = coeff 0 p"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [coeff, poly_eval, ← GSYM monomial_1] THEN
    ASM_MESON_TAC [POWSER_EVALUATE_AT_0])

  let POLY_EVAL_AT_0 ← prove
   r"!(r:A ring) p.
        p IN ring_carrier (poly_ring r (:1))
        ==> poly_eval r p (ring_0 r) = coeff 0 p"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [coeff, poly_eval, ← GSYM monomial_1] THEN
    ASM_MESON_TAC [POLY_EVALUATE_AT_0])

  let RING_HOMOMORPHISM_POWSER_EVAL_AT_0 ← prove
   r"!(r:A ring) s. ring_homomorphism (powser_ring r s,r)
                                    (\p. poly_eval r p (ring_0 r))"
   (SIMP_TAC [poly_eval, RING_HOMOMORPHISM_POWSER_EVALUATE_AT_0])

  let RING_EPIMORPHISM_POWSER_EVAL_AT_0 ← prove
   r"!(r:A ring) s. ring_epimorphism (powser_ring r s,r)
                                   (\p. poly_eval r p (ring_0 r))"
   (SIMP_TAC [poly_eval, RING_EPIMORPHISM_POWSER_EVALUATE_AT_0])

  let POWSER_RING_HOMOMORPHISM_COEFF_0 ← prove
   r"!(r:A ring) s. ring_homomorphism (powser_ring r s,r) (coeff 0)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC RING_HOMOMORPHISM_EQ THEN
    EXISTS_TAC (← q r"\p. poly_eval r p (ring_0 r:A)") THEN
    ASM_SIMP_TAC [RING_HOMOMORPHISM_POWSER_EVAL_AT_0, POWSER_EVAL_AT_0,
                  POWSER_RING, IN_ELIM_THM])

  let POLY_RING_HOMOMORPHISM_COEFF_0 ← prove
   r"!(r:A ring) s. ring_homomorphism (poly_ring r s,r) (coeff 0)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC RING_HOMOMORPHISM_EQ THEN
    EXISTS_TAC (← q r"\p. poly_eval r p (ring_0 r:A)") THEN
    ASM_SIMP_TAC [RING_HOMOMORPHISM_POLY_EVAL, RING_0, POWSER_EVAL_AT_0,
                  POLY_RING, ring_polynomial, IN_ELIM_THM])

  let POWSER_RING_EPIMORPHISM_COEFF_0 ← prove
   r"!(r:A ring) s. ring_epimorphism (powser_ring r s,r) (coeff 0)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC RING_EPIMORPHISM_EQ THEN
    EXISTS_TAC (← q r"\p. poly_eval r p (ring_0 r:A)") THEN
    ASM_SIMP_TAC [RING_EPIMORPHISM_POWSER_EVAL_AT_0, POWSER_EVAL_AT_0,
                  POWSER_RING, IN_ELIM_THM])

  let POLY_RING_EPIMORPHISM_COEFF_0 ← prove
   r"!(r:A ring) s. ring_epimorphism (poly_ring r s,r) (coeff 0)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC RING_EPIMORPHISM_EQ THEN
    EXISTS_TAC (← q r"\p. poly_eval r p (ring_0 r:A)") THEN
    ASM_SIMP_TAC [RING_EPIMORPHISM_POLY_EVAL, RING_0, POWSER_EVAL_AT_0,
                  POLY_RING, ring_polynomial, IN_ELIM_THM])

  let POLY_EVAL_COEFF ← prove
   r"!r (p:(1->num)->A) x n.
        ring_polynomial r p /\
        x IN ring_carrier r /\
        poly_deg r p <= n
        ==> poly_eval r p x =
            ring_sum r (0..n)
                       (\d. ring_mul r (coeff d p) (ring_pow r x d))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q "(p:(1->num)->A) IN ring_carrier(poly_ring r (:1))")
    ASSUME_TAC THENL
     [REWRITE_TAC [POLY_RING, IN_ELIM_THM, SUBSET_UNIV] THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"poly_eval r (p:(1->num)->A) x =
     ring_sum r (0..poly_deg r p)
               (\i. ring_mul r (coeff i p) (ring_pow r x i))")
     SUBST1_TAC THENL
     [MATCH_MP_TAC POLY_EVAL_EXPAND THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC (← GSYM RING_SUM_SUPERSET) THEN
    REWRITE_TAC [SUBSET_NUMSEG, LE_REFL, LE_0] THEN
    ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q "i:num") THEN
    REWRITE_TAC [IN_NUMSEG, LE_0, DE_MORGAN_THM, NOT_LE] THEN
    STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    SUBGOAL_THEN (← q "coeff i (p:(1->num)->A) = ring_0 r") SUBST1_TAC THENL
     [ASM_CASES_TAC (← q "coeff i (p:(1->num)->A) = ring_0 r") THENL
       [ASM_REWRITE_TAC [],
        MP_TAC (← SPECL [← q "r:A ring", ← q "p:(1->num)->A", ← q "i:num"]
           COEFF_NONZERO_LE_DEG) THEN
        ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC],
      ASM_SIMP_TAC [RING_MUL_LZERO, RING_POW]])

  let IMAGE_POLY_EVAL ← prove
   r"!l k a:A.
        k subring_of l /\ a IN ring_carrier l
        ==> IMAGE (\p. poly_eval l p a)
                  (ring_carrier(poly_ring (subring_generated l k) (:1))) =
            ring_carrier (subring_generated l (a INSERT k))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_eval, poly_evaluate, ETA_AX] THEN
    MP_TAC (← ISPECL [← q "I:A->A", ← q "subring_generated l k:A ring", ← q "l:A ring",
                   ← q "a:A"] IMAGE_POLY_EXTEND_1) THEN
    ASM_SIMP_TAC [CARRIER_SUBRING_GENERATED_SUBRING, IMAGE_I,
                  RING_HOMOMORPHISM_FROM_SUBRING_GENERATED,
                  RING_HOMOMORPHISM_I, POLY_EXTEND_FROM_SUBRING_GENERATED])

  let POLY_VAR_DIVIDES_UNIVARIATE ← prove
   r"!(r:A ring) p.
        ring_divides (poly_ring r (:1)) (poly_var r one) p <=>
        ring_polynomial r p /\ coeff 0 p = ring_0 r"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q "ring_polynomial r (p:(1->num)->A)") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [RING_POLYNOMIAL, ring_divides]] THEN
    EQ_TAC THENL
     [REWRITE_TAC [ring_divides, ← GSYM RING_POLYNOMIAL] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [COEFF_POLY_VAR_MUL, POLY_RING, RING_POLYNOMIAL_IMP_POWERSERIES],
      DISCH_TAC THEN ASM_SIMP_TAC [ring_divides, POLY_VAR_UNIV] THEN
      ASM_REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN
      EXISTS_TAC (← q r"\m. (p:(1->num)->A) (\v. m one + 1)") THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [RING_POLYNOMIAL_COEFF]) THEN
        REWRITE_TAC [RING_POLYNOMIAL_COEFF, coeff] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FINITE_SUBSET_NUMSEG]) THEN
        REWRITE_TAC [FINITE_SUBSET_NUMSEG] THEN MATCH_MP_TAC MONO_EXISTS THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_NUMSEG, LE_0] THEN GEN_TAC THEN
        GEN_REWRITE_TAC (BINOP_CONV o ONCE_DEPTH_CONV) [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [NOT_LE] THEN DISCH_TAC THEN GEN_TAC THEN DISCH_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        DISCH_TAC THEN REWRITE_TAC [← GSYM FUN_EQ_COEFF, POLY_RING] THEN
        ASM_SIMP_TAC [COEFF_POLY_VAR_MUL, RING_POLYNOMIAL_IMP_POWERSERIES] THEN
        GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [coeff, SUB_ADD, LE_1]]])

  -- @@RETURN BEGIN
  return { poly_evaluate, POLY_EVALUATE, POLY_EVALUATE_0, POLY_EVALUATE_1,
           POLY_EVALUATE_VAR, POLY_EVALUATE_CONST, POLY_EVALUATE_ADD, POLY_EVALUATE_SUB,
           POLY_EVALUATE_MUL, POLY_EVALUATE_POW, POLY_EVALUATE_RING_SUM,
           POLY_EVALUATE_RING_PRODUCT, RING_HOMOMORPHISM_POLY_EVALUATE,
           RING_EPIMORPHISM_POLY_EVALUATE, POLY_EVALUATE_HOMOMORPHIC_IMAGE,
           POLY_EXTEND_EVALUATE, POLY_EVALUATE_EQ, POWSER_EVALUATE_AT_0,
           POLY_EVALUATE_AT_0, RING_HOMOMORPHISM_POWSER_EVALUATE_AT_0,
           RING_EPIMORPHISM_POWSER_EVALUATE_AT_0, POLY_EVALUATE_REINDEX, poly_eval,
           POLY_EVAL, POLY_EVAL_0, POLY_EVAL_1, POLY_EVAL_VAR, POLY_EVAL_CONST,
           POLY_EVAL_ADD, POLY_EVAL_SUB, POLY_EVAL_MUL, POLY_EVAL_POW,
           POLY_EVAL_RING_SUM, POLY_EVAL_RING_PRODUCT, RING_HOMOMORPHISM_POLY_EVAL,
           RING_EPIMORPHISM_POLY_EVAL, POLY_EVAL_HOMOMORPHIC_IMAGE,
           POLY_EXTEND_UNIVARIATE, POLY_EVAL_EXPAND, POLY_EXPAND, POWSER_EVAL_AT_0,
           POLY_EVAL_AT_0, RING_HOMOMORPHISM_POWSER_EVAL_AT_0,
           RING_EPIMORPHISM_POWSER_EVAL_AT_0, POWSER_RING_HOMOMORPHISM_COEFF_0,
           POLY_RING_HOMOMORPHISM_COEFF_0, POWSER_RING_EPIMORPHISM_COEFF_0,
           POLY_RING_EPIMORPHISM_COEFF_0, POLY_EVAL_COEFF, IMAGE_POLY_EVAL,
           POLY_VAR_DIVIDES_UNIVARIATE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Composing polynomials and power series with homomorphisms.                -/
/- (ringtheory.ml 23703-23962)                                               -/
/- ------------------------------------------------------------------------- -/

structure Composing where
  -- @@FIELDS
  RING_POWERSERIES_COMPOSE : thm
  IN_RING_POWERSERIES_CARRIER_COMPOSE : thm
  RING_POLYNOMIAL_COMPOSE : thm
  IN_RING_POLYNOMIAL_CARRIER_COMPOSE : thm
  POLY_DEG_HOMOMORPHIC_IMAGE : thm
  POLY_DEG_MONOMORPHIC_IMAGE : thm
  POLY_EQ_0_MONOMORPHIC_IMAGE : thm
  RING_HOMOMORPHISM_POWSER_RINGS : thm
  RING_HOMOMORPHISM_POLY_RINGS : thm
  RING_MONOMORPHISM_POWSER_RINGS : thm
  RING_MONOMORPHISM_POLY_RINGS : thm
  RING_EPIMORPHISM_POWSER_RINGS : thm
  RING_EPIMORPHISM_POLY_RINGS : thm
  RING_ISOMORPHISM_POWSER_RINGS : thm
  RING_ISOMORPHISM_POLY_RINGS : thm
  POLY_COMPOSE_HOMOMORPHISM_VAR : thm
  POLY_COMPOSE_HOMOMORPHISM_CONST : thm
  POLY_COMPOSE_HOMOMORPHISM_NEG : thm
  POLY_COMPOSE_HOMOMORPHISM_MUL : thm
  POLY_COMPOSE_HOMOMORPHISM_SUB : thm
  POLY_COMPOSE_HOMOMORPHISM_ADD : thm
  POLY_COMPOSE_HOMOMORPHISM_POW : thm
  deriving Inhabited

@[nospecialize]
def setupComposing [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BSums : Sums) (BHoms : Homs) (BKernels : Kernels) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BDegree : Degree) :
    ExceptT String IO Composing := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, .. } := D
  let { CONTRAPOS_THM, DE_MORGAN_THM, .. } := D.core2
  let { FINITE_SUBSET, FINITE_UNION, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, INFINITE, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, .. } := D.core5
  let { SUBSET, SURJECTIVE_ON_RIGHT_INVERSE, UNIONS_SUBSET, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { RING_0, RING_MUL, RING_MUL_LZERO, RING_MUL_RZERO, .. } := BBasics
  let { RING_SUM_EQ, RING_SUM_EQ_0, .. } := BSums
  let { RING_HOMOMORPHISM, RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1,
        RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_NEG,
        RING_HOMOMORPHISM_POW, RING_HOMOMORPHISM_SUB, RING_HOMOMORPHISM_SUM,
        RING_MONOMORPHISM_EPIMORPHISM, RING_MONOMORPHISM_EQ_0, ring_homomorphism, .. } := BHoms
  let { RING_EPIMORPHISM_ALT, RING_MONOMORPHISM_ALT, ring_image, .. } := BKernels
  let { MONOMIAL_FINITE_DIVISORPAIRS, MONOMIAL_VARS_MUL, .. } := BMonomials
  let { POLY_0, poly_1, poly_add, poly_const, poly_mul, poly_var, poly_vars,
        ring_polynomial, ring_powerseries, .. } := BPowerSeries
  let { POLY_RING, POWSER_RING, POWSER_RING_CLAUSES, RING_POWERSERIES, .. } := BPolyRings
  let { MONOMIAL_DEG_LE_POLY_DEG, POLY_DEG_LE, poly_deg, .. } := BDegree
  -- @@SCOPE END

  let RING_POWERSERIES_COMPOSE ← prove
   r"!r s (f:A->B) (p:(V->num)->A).
        ring_homomorphism(r,s) f /\ ring_powerseries r p
        ==> ring_powerseries s (f o p)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [ring_powerseries, ring_homomorphism, o_THM] THEN SET_TAC [])

  let IN_RING_POWERSERIES_CARRIER_COMPOSE ← prove
   r"!r s (v:V->bool) (f:A->B) p.
        ring_homomorphism(r,s) f /\
        p IN ring_carrier(powser_ring r v)
        ==> (f o p) IN ring_carrier(powser_ring s v)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [POWSER_RING, IN_ELIM_THM, poly_vars, UNIONS_SUBSET, o_THM] THEN
    REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [RING_POWERSERIES_COMPOSE], ALL_TAC] THEN
    ASM SET_TAC [ring_homomorphism])

  let RING_POLYNOMIAL_COMPOSE ← prove
   r"!r s (f:A->B) (p:(V->num)->A).
        ring_homomorphism(r,s) f /\ ring_polynomial r p
        ==> ring_polynomial s (f o p)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [ring_polynomial, ring_powerseries, ring_homomorphism, o_THM] THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN ASM SET_TAC [])

  let IN_RING_POLYNOMIAL_CARRIER_COMPOSE ← prove
   r"!r s (f:A->B) v p.
        ring_homomorphism(r,s) f /\
        p IN ring_carrier(poly_ring r v)
        ==> (f o p) IN ring_carrier(poly_ring s v)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [POLY_RING, IN_ELIM_THM, poly_vars, UNIONS_SUBSET, o_THM] THEN
    REPEAT STRIP_TAC THENL [ASM_MESON_TAC [RING_POLYNOMIAL_COMPOSE], ALL_TAC] THEN
    ASM SET_TAC [ring_homomorphism])

  let POLY_DEG_HOMOMORPHIC_IMAGE ← prove
   r"!r s (f:A->B) (p:(V->num)->A).
        ring_homomorphism (r,s) f /\ ring_polynomial r p
        ==> poly_deg s (f o p) <= poly_deg r p"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC POLY_DEG_LE THEN CONJ_TAC THENL
     [MATCH_MP_TAC RING_POLYNOMIAL_COMPOSE THEN ASM_MESON_TAC [],
      GEN_TAC THEN DISCH_THEN (fun th =>
       MATCH_MP_TAC MONOMIAL_DEG_LE_POLY_DEG THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [CONTRAPOS_THM, o_THM] THEN
      ASM_MESON_TAC [RING_HOMOMORPHISM_0]])

  let POLY_DEG_MONOMORPHIC_IMAGE ← prove
   r"!r s (f:A->B) (p:(V->num)->A).
        ring_monomorphism (r,s) f /\ ring_polynomial r p
        ==> poly_deg s (f o p) = poly_deg r p"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_deg] THEN
    AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_polynomial, ring_powerseries]) THEN
    REWRITE_TAC [o_THM] THEN ASM_MESON_TAC [RING_MONOMORPHISM_EQ_0])

  let POLY_EQ_0_MONOMORPHIC_IMAGE ← prove
   r"!r s (f:A->B) (p:(V->num)->A).
        ring_monomorphism (r,s) f /\ ring_polynomial r p
        ==> (f o p = poly_0 s <=> p = poly_0 r)"
   (REWRITE_TAC [ring_polynomial, ring_powerseries] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM, POLY_0, o_THM] THEN
    ASM_MESON_TAC [RING_MONOMORPHISM_EQ_0])

  let (RING_HOMOMORPHISM_POWSER_RINGS, RING_HOMOMORPHISM_POLY_RINGS) : thm × thm ← do
   CONJ_PAIR (← prove
   r"(!r s (f:A->B) (v:V->bool).
        ring_homomorphism (r,s) f
        ==> ring_homomorphism (powser_ring r v,powser_ring s v) (\p. f o p)) /\
   (!r s (f:A->B) (v:V->bool).
        ring_homomorphism (r,s) f
        ==> ring_homomorphism (poly_ring r v,poly_ring s v) (\p. f o p))"
   (CONJ_TAC THEN
    (← do
     let mm ← MESON []
       (← q r"f(ring_0 r) = ring_0 s
        ==> x = ring_0 r /\ y = ring_0 s ==> f x = y")
     pure (REPEAT STRIP_TAC THEN
    REWRITE_TAC [RING_HOMOMORPHISM, SUBSET, FORALL_IN_IMAGE] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [IN_RING_POWERSERIES_CARRIER_COMPOSE,
                     IN_RING_POLYNOMIAL_CARRIER_COMPOSE],
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_homomorphism]) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN STRIP_TAC] THEN
    REWRITE_TAC [POWSER_RING, POLY_RING,
                 poly_1, poly_const, poly_add, poly_mul] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"m:V->num") THEN
    REWRITE_TAC [o_THM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_polynomial, ring_powerseries]) THENL
     [ASM_MESON_TAC [], ASM_MESON_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"FINITE(monomial_vars(m:V->num))") THENL
     [FIRST_ASSUM (fun th => tactic_of do
        pure (wPart lhand (fun t => do lhand (← rand t))
          (← MATCH_MP RING_HOMOMORPHISM_SUM th))) THEN
      ASM_SIMP_TAC [MONOMIAL_FINITE_DIVISORPAIRS, FORALL_IN_GSPEC, RING_MUL] THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC RING_SUM_EQ THEN
      ASM_SIMP_TAC [FORALL_IN_GSPEC, o_THM],
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP mm) THEN
      CONJ_TAC THEN MATCH_MP_TAC RING_SUM_EQ_0 THEN
      ASM_SIMP_TAC [IMP_CONJ, FORALL_IN_GSPEC, RING_MUL] THEN
      REPEAT GEN_TAC THEN DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM INFINITE]) THEN
      REWRITE_TAC [INFINITE, MONOMIAL_VARS_MUL, FINITE_UNION] THEN
      REWRITE_TAC [DE_MORGAN_THM, ← GSYM INFINITE] THEN
      ASM_MESON_TAC [RING_MUL_LZERO, RING_MUL_RZERO]]))))

  let (RING_MONOMORPHISM_POWSER_RINGS, RING_MONOMORPHISM_POLY_RINGS) : thm × thm ← do
   CONJ_PAIR (← prove
   r"(!r s (f:A->B) (v:V->bool).
        ring_monomorphism (r,s) f
        ==> ring_monomorphism (powser_ring r v,powser_ring s v) (\p. f o p)) /\
   (!r s (f:A->B) (v:V->bool).
        ring_monomorphism (r,s) f
        ==> ring_monomorphism (poly_ring r v,poly_ring s v) (\p. f o p))"
   (CONJ_TAC THEN REWRITE_TAC [RING_MONOMORPHISM_ALT] THEN
    SIMP_TAC [RING_HOMOMORPHISM_POWSER_RINGS, RING_HOMOMORPHISM_POLY_RINGS] THEN
    REWRITE_TAC [POLY_RING, POWSER_RING, POLY_0, IN_ELIM_THM] THEN
    REWRITE_TAC [ring_polynomial, ring_powerseries] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC BINOP_CONV [FUN_EQ_THM] THEN REWRITE_TAC [o_THM] THEN
    ASM_MESON_TAC []))

  let (RING_EPIMORPHISM_POWSER_RINGS, RING_EPIMORPHISM_POLY_RINGS) : thm × thm ← do
   CONJ_PAIR (← prove
   r"(!r s (f:A->B) (v:V->bool).
        ring_epimorphism (r,s) f
        ==> ring_epimorphism (powser_ring r v,powser_ring s v) (\p. f o p)) /\
   (!r s (f:A->B) (v:V->bool).
        ring_epimorphism (r,s) f
        ==> ring_epimorphism (poly_ring r v,poly_ring s v) (\p. f o p))"
   (CONJ_TAC THEN
    (← do
     let mm ← MESON []
       (← q r"(?g. Q g) /\ (!g. Q g ==> ?h. P h /\ Q h) ==> ?g. P g /\ Q g")
     pure (REWRITE_TAC [RING_EPIMORPHISM_ALT] THEN
    SIMP_TAC [RING_HOMOMORPHISM_POWSER_RINGS, RING_HOMOMORPHISM_POLY_RINGS] THEN
    REWRITE_TAC [POLY_RING, POWSER_RING, POLY_0, IN_ELIM_THM,
                 ring_polynomial, ring_powerseries, poly_vars,
                 SUBSET, ring_image, IN_ELIM_THM, IN_IMAGE] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [ring_homomorphism] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?g:B->A. g(ring_0 s) = ring_0 r /\
               !y. y IN ring_carrier s ==> g(y) IN ring_carrier r /\ f(g y) = y")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC mm THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← GSYM SURJECTIVE_ON_RIGHT_INVERSE] THEN ASM SET_TAC [],
        X_GEN_TAC (← q "g:B->A") THEN STRIP_TAC] THEN
      EXISTS_TAC (← q r"\y. if y = ring_0 s then ring_0 r else (g:B->A) y") THEN
      REWRITE_TAC [] THEN ASM_MESON_TAC [RING_0],
      X_GEN_TAC (← q r"p:(V->num)->B") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(g:B->A) o (p:(V->num)->B)") THEN
      REWRITE_TAC [FUN_EQ_THM, o_THM] THEN REPEAT CONJ_TAC THEN
      TRY (FIRST_X_ASSUM (MATCH_MP_TAC o
             MATCH_MP (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET))) THEN
      ASM SET_TAC []]))))

  let RING_ISOMORPHISM_POWSER_RINGS ← prove
   r"!r s (f:A->B) (v:V->bool).
        ring_isomorphism (r,s) f
        ==> ring_isomorphism (powser_ring r v,powser_ring s v) (\p. f o p)"
   (REWRITE_TAC [← GSYM RING_MONOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [RING_MONOMORPHISM_POWSER_RINGS, RING_EPIMORPHISM_POWSER_RINGS])

  let RING_ISOMORPHISM_POLY_RINGS ← prove
   r"!r s (f:A->B) (v:V->bool).
        ring_isomorphism (r,s) f
        ==> ring_isomorphism (poly_ring r v,poly_ring s v) (\p. f o p)"
   (REWRITE_TAC [← GSYM RING_MONOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [RING_MONOMORPHISM_POLY_RINGS, RING_EPIMORPHISM_POLY_RINGS])

  let POLY_COMPOSE_HOMOMORPHISM_VAR ← prove
   r"!(r:A ring) (r':B ring) (f:A->B) (i:V).
        ring_homomorphism(r,r') f
        ==> f o poly_var r i = poly_var r' i"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM, o_THM, poly_var] THEN
    X_GEN_TAC (← q r"m:V->num") THEN COND_CASES_TAC THENL
    [ASM_MESON_TAC [RING_HOMOMORPHISM_1],
     ASM_MESON_TAC [RING_HOMOMORPHISM_0]])

  let POLY_COMPOSE_HOMOMORPHISM_CONST ← prove
   r"!(r:A ring) (r':B ring) (f:A->B) (c:A).
        ring_homomorphism(r,r') f /\ c IN ring_carrier r
        ==> f o (poly_const r c:(V->num)->A) = poly_const r' (f c)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM, o_THM, poly_const] THEN
    X_GEN_TAC (← q r"m:V->num") THEN
    COND_CASES_TAC THEN ASM_MESON_TAC [RING_HOMOMORPHISM_0])

  let POLY_COMPOSE_HOMOMORPHISM_NEG ← prove
   r"!(r:A ring) (r':B ring) (f:A->B) (p:(V->num)->A).
        ring_homomorphism(r,r') f /\ ring_powerseries r p
        ==> f o poly_neg r p = poly_neg r' (f o p)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "r':B ring", ← q "f:A->B", ← q "(:V)"]
      RING_HOMOMORPHISM_POWSER_RINGS) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o MATCH_MP RING_HOMOMORPHISM_NEG) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"p:(V->num)->A")) THEN
    ASM_REWRITE_TAC [← GSYM RING_POWERSERIES] THEN
    REWRITE_TAC [POWSER_RING_CLAUSES] THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN DISCH_THEN ACCEPT_TAC)

  let (POLY_COMPOSE_HOMOMORPHISM_MUL, POLY_COMPOSE_HOMOMORPHISM_SUB, POLY_COMPOSE_HOMOMORPHISM_ADD) : thm × thm × thm ← do
   let th ← prove
     r"(!(r:A ring) (r':B ring) (f:A->B)
          (p:(V->num)->A) (q:(V->num)->A).
          ring_homomorphism(r,r') f /\
          ring_powerseries r p /\ ring_powerseries r q
          ==> f o poly_mul r p q =
              poly_mul r' (f o p) (f o q)) /\
     (!(r:A ring) (r':B ring) (f:A->B)
          (p:(V->num)->A) (q:(V->num)->A).
          ring_homomorphism(r,r') f /\
          ring_powerseries r p /\ ring_powerseries r q
          ==> f o poly_sub r p q =
              poly_sub r' (f o p) (f o q)) /\
     (!(r:A ring) (r':B ring) (f:A->B)
          (p:(V->num)->A) (q:(V->num)->A).
          ring_homomorphism(r,r') f /\
          ring_powerseries r p /\ ring_powerseries r q
          ==> f o poly_add r p q =
              poly_add r' (f o p) (f o q))"
     (← do
      let POLY_COMPOSE_HOM_TAC (thm' : thm) : ExceptT String IO tactic := do
        pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
        MP_TAC (← ISPECL [← q "r:A ring", ← q "r':B ring", ← q "f:A->B", ← q "(:V)"]
          RING_HOMOMORPHISM_POWSER_RINGS) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o MATCH_MP thm') THEN
        DISCH_THEN (MP_TAC o SPECL
          [← q r"p:(V->num)->A", ← q r"q:(V->num)->A"]) THEN
        ANTS_TAC THENL
        [ASM_REWRITE_TAC [← GSYM RING_POWERSERIES],
         ALL_TAC] THEN
        REWRITE_TAC [POWSER_RING_CLAUSES] THEN
        CONV_TAC (DEPTH_CONV BETA_CONV) THEN
        DISCH_THEN ACCEPT_TAC)
      -- the THENL list is built right to left
      let t3 ← POLY_COMPOSE_HOM_TAC RING_HOMOMORPHISM_ADD
      let t2 ← POLY_COMPOSE_HOM_TAC RING_HOMOMORPHISM_SUB
      let t1 ← POLY_COMPOSE_HOM_TAC RING_HOMOMORPHISM_MUL
      pure (REPEAT CONJ_TAC THENL [t1, t2, t3]))
   match CONJUNCTS th with
   | [a, b, c] => pure (a, b, c)
   | _ => throw "POLY_COMPOSE_HOMOMORPHISM_*: expected 3 conjuncts"

  let POLY_COMPOSE_HOMOMORPHISM_POW ← prove
   r"!(r:A ring) (r':B ring) (f:A->B) (p:(V->num)->A) n.
        ring_homomorphism(r,r') f /\ ring_powerseries r p
        ==> f o poly_pow r p n = poly_pow r' (f o p) n"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "r':B ring", ← q "f:A->B", ← q "(:V)"]
      RING_HOMOMORPHISM_POWSER_RINGS) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o MATCH_MP RING_HOMOMORPHISM_POW) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"p:(V->num)->A", ← q "n:num"]) THEN
    ASM_REWRITE_TAC [← GSYM RING_POWERSERIES] THEN
    REWRITE_TAC [POWSER_RING_CLAUSES] THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN DISCH_THEN ACCEPT_TAC)

  -- @@RETURN BEGIN
  return { RING_POWERSERIES_COMPOSE, IN_RING_POWERSERIES_CARRIER_COMPOSE,
           RING_POLYNOMIAL_COMPOSE, IN_RING_POLYNOMIAL_CARRIER_COMPOSE,
           POLY_DEG_HOMOMORPHIC_IMAGE, POLY_DEG_MONOMORPHIC_IMAGE,
           POLY_EQ_0_MONOMORPHIC_IMAGE, RING_HOMOMORPHISM_POWSER_RINGS,
           RING_HOMOMORPHISM_POLY_RINGS, RING_MONOMORPHISM_POWSER_RINGS,
           RING_MONOMORPHISM_POLY_RINGS, RING_EPIMORPHISM_POWSER_RINGS,
           RING_EPIMORPHISM_POLY_RINGS, RING_ISOMORPHISM_POWSER_RINGS,
           RING_ISOMORPHISM_POLY_RINGS, POLY_COMPOSE_HOMOMORPHISM_VAR,
           POLY_COMPOSE_HOMOMORPHISM_CONST, POLY_COMPOSE_HOMOMORPHISM_NEG,
           POLY_COMPOSE_HOMOMORPHISM_MUL, POLY_COMPOSE_HOMOMORPHISM_SUB,
           POLY_COMPOSE_HOMOMORPHISM_ADD, POLY_COMPOSE_HOMOMORPHISM_POW }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Zerodivisors, nilpotents and units in polynomial and power series rings.  -/
/- (ringtheory.ml 23963-24576)                                               -/
/- ------------------------------------------------------------------------- -/

structure Zerodivisors where
  -- @@FIELDS
  INTEGRAL_DOMAIN_POWSER_RING : thm
  RING_UNIT_POLY_CONST : thm
  RING_UNIT_POLY_DOMAIN : thm
  RING_NILPOTENT_POLY_RING : thm
  RING_UNIT_POLY_RING : thm
  RING_UNIT_POLY_RING_1 : thm
  RING_UNIT_POLY_VAR : thm
  FIELD_POLY_RING : thm
  POLY_DEG_UNIT : thm
  POLY_DEG_EQ_0_UNIT : thm
  IRREDUCIBLE_IMP_POLY_DEG_NZ : thm
  POLY_DEG_1_IMP_IRREDUCIBLE : thm
  RING_UNIT_POWSER_RING : thm
  LOCAL_POWSER_RING : thm
  RING_PRIME_POLY_VAR_UNIVARIATE : thm
  RING_PRIME_POLY_VAR : thm
  RING_IRREDUCIBLE_POLY_VAR : thm
  RING_PRIME_POLY_CONST : thm
  RING_IRREDUCIBLE_POLY_CONST : thm
  deriving Inhabited

@[nospecialize]
def setupZerodivisors [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BSums : Sums) (BProducts : Products) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BRingRule : RingRule) (BCosets : Cosets) (BQuotients : Quotients) (BPrimes : Primes) (BSpecialIdeals : SpecialIdeals) (BRadical : Radical) (BLocalRings : LocalRings) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BHomExtend : HomExtend) (BNatIso : NatIso) (BRenaming : Renaming) (BMonomialOrders : MonomialOrders) (BOneCoeff : OneCoeff) (BDegree : Degree) (BEvaluation : Evaluation) (BComposing : Composing) :
    ExceptT String IO Zerodivisors := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ADD_EQ_0, AND_FORALL_THM, BIJ, COND_ID, .. } := D.core1
  let { CONTRAPOS_THM, DE_MORGAN_THM, EQ_TRANS, ETA_AX, EXTENSION, .. } := D.core2
  let { FINITE_DELETE, FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FORALL_IN_INSERT, FORALL_ONE_THM, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, INJ, .. } := D.core4
  let { IN_DELETE, IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_INTERS, IN_SING, IN_UNIV,
        LEFT_IMP_EXISTS_THM, LE_1, .. } := D.core5
  let { MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY,
        PAIR_EQ, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, SING_SUBSET, SUBSET, SURJ, .. } := D.core7
  let { WF_REC_EXISTS, WO, WOSET, WOSET_IMP_POSET, WOSET_WF, o_THM, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_MUL, RING_MUL_ASSOC, RING_MUL_LID,
        RING_MUL_LZERO, RING_MUL_RID, RING_MUL_RZERO, RING_SUB, TRIVIAL_RING_10,
        trivial_ring, .. } := BBasics
  let { RING_SUM, RING_SUM_CLAUSES, RING_SUM_DELETE, RING_SUM_EQ, RING_SUM_SING,
        RING_SUM_SUPERSET, .. } := BSums
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, .. } := BProducts
  let { RING_DIVIDES_ZERO, RING_NILPOTENT_0, RING_NILPOTENT_1, RING_UNIT_0,
        ring_nilpotent, ring_unit, .. } := BDivides
  let { IDEAL_GENERATED_INC, IDEAL_GENERATED_SING, IN_IDEAL_GENERATED_SING_EQ,
        RING_IDEAL_IDEAL_GENERATED, RING_IDEAL_IMP_SUBSET, .. } := BIdeals
  let { FIELD_EQ_ALL_UNITS, FIELD_IMP_INTEGRAL_DOMAIN, FIELD_UNIT,
        INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, INTEGRAL_DOMAIN_MUL_EQ_0,
        INTEGRAL_DOMAIN_NILPOTENT, INTEGRAL_DOMAIN_NONTRIVIAL, integral_domain, .. } := BDomains
  let { RING_HOMOMORPHISM_MUL, RING_ISOMORPHISMS_IMP_ISOMORPHISM,
        RING_ISOMORPHISMS_SYM, RING_NILPOTENT_HOMOMORPHIC_IMAGE, ring_homomorphism, .. } := BHoms
  let { ISOMORPHIC_RING_EQ, ISOMORPHIC_RING_TRANS, .. } := BIso
  let { INTEGRAL_DOMAIN_MONOMORPHIC_PREIMAGE, ISOMORPHIC_RING_FIELDNESS,
        ISOMORPHIC_RING_INTEGRAL_DOMAINNESS, RING_DIVIDES_HOMOMORPHIC_IMAGE,
        RING_UNIT_HOMOMORPHIC_IMAGE, ring_kernel, .. } := BKernels
  let { RING_RULE, RING_TAC, .. } := BRingRule
  let { RING_COSET_0, RING_COSET_EQ_IDEAL, .. } := BCosets
  let { FIRST_RING_EPIMORPHISM_THEOREM, QUOTIENT_RING, RING_HOMOMORPHISM_RING_COSET, .. } := BQuotients
  let { INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE, RING_PRIME_IMP_NONTRIVIAL_RING,
        RING_PRIME_IN_CARRIER, RING_PRIME_ISOMORPHIC_IMAGE_EQ, ring_irreducible,
        ring_prime, .. } := BPrimes
  let { INTEGRAL_DOMAIN_QUOTIENT_RING, PRIME_IDEAL_SING, PRIME_IMP_RING_IDEAL,
        RING_IDEAL_NONUNITS, .. } := BSpecialIdeals
  let { RADICAL_0, RING_NILPOTENT_RMUL, RING_NILPOTENT_SUM, RING_NILRADICAL,
        RING_UNIT_NILPOTENT_CLAUSES, .. } := BRadical
  let { LOCAL_RING_IDEAL_NONUNITS, .. } := BLocalRings
  let { MONOMIAL, MONOMIAL_1, MONOMIAL_FINITE_DIVISORPAIRS, MONOMIAL_MUL,
        MONOMIAL_MUL_EQ_1, MONOMIAL_MUL_EQ_VAR, MONOMIAL_MUL_LID, MONOMIAL_VAR,
        MONOMIAL_VARS_1, MONOMIAL_VAR_1, monomial, monomial_1, .. } := BMonomials
  let { POLY_0, POLY_CONST_0, POLY_MUL_0, POLY_VAR_EQ_CONST, poly_0, poly_1, poly_add,
        poly_const, poly_mul, poly_var, .. } := BPowerSeries
  let { IN_POLY_RING_CARRIER, POLY_CONST, POLY_CONST_EQ, POLY_CONST_EQ_0,
        POLY_CONST_MUL, POLY_MONOMIALS_FINITE, POLY_MONOMIAL_IN_CARRIER, POLY_RING,
        POLY_VAR, POWSER_RING, POWSER_RING_EQ, RING_CARRIER_POWSER_RING,
        RING_HOMOMORPHISM_MONOMIAL_1, RING_HOMOMORPHISM_POLY_CONST,
        RING_MONOMORPHISM_POWSER_CONST, RING_POLYNOMIAL, TRIVIAL_POLY_RING,
        TRIVIAL_POWSER_RING, .. } := BPolyRings
  let { POLY_EXTEND_ID, poly_extend, .. } := BHomExtend
  let { ISOMORPHIC_POLY_RING_TRIVIAL, RING_ISOMORPHISMS_POLY_POLY_RING, .. } := BNatIso
  let { POLY_CONST_DIVIDES_COEFFS, POLY_CONST_DIVIDES_CONST, POLY_REINDEX_VAR,
        RING_ISOMORPHISM_POLY_REINDEX, .. } := BRenaming
  let { FLD_MONOMIAL_LE, MONOMIAL_GE_1, MONOMIAL_LET_MUL2, MONOMIAL_LTE_MUL2,
        MONOMIAL_LT_REFL, MONOMIAL_LT_RMUL, PROPERLY_MONOMIAL_LE, WOSET_MONOMIAL_LE,
        monomial_lt, .. } := BMonomialOrders
  let { FORALL_FUN_FROM_1, LAMBDA_1_EQ, coeff, .. } := BOneCoeff
  let { INTEGRAL_DOMAIN_POLY_RING, POLY_DEG_1, POLY_DEG_CONST, POLY_DEG_EQ_0,
        POLY_DEG_MUL, .. } := BDegree
  let { POLY_EVAL_AT_0, POLY_VAR_DIVIDES_UNIVARIATE, RING_EPIMORPHISM_POLY_EVAL, .. } := BEvaluation
  let { RING_HOMOMORPHISM_POLY_RINGS, .. } := BComposing
  -- @@SCOPE END

  let INTEGRAL_DOMAIN_POWSER_RING ← prove
   r"!(r:A ring) (s:V->bool).
        integral_domain(powser_ring r s) <=> integral_domain r"
   (← do
    -- right to left: the MESON[MONOMIAL_LT_REFL], the TAUT, the MESON
    let m3 ← MESON [MONOMIAL_LT_REFL]
     (← q r"m' = m ==> !l. ~monomial_lt l m m'")
    let tt ← TAUT (← q r"~p ==> p ==> q")
    let m1 ← MESON []
     (← q r"!m. ~(ring_sum r {m} f = z) /\ ring_sum r s f = ring_sum r {m} f
          ==> ~(ring_sum r s f = z)")
    pure (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
       INTEGRAL_DOMAIN_MONOMORPHIC_PREIMAGE) THEN
      MESON_TAC [RING_MONOMORPHISM_POWSER_CONST],
      REWRITE_TAC [integral_domain, ← GSYM TRIVIAL_RING_10]] THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [TRIVIAL_POWSER_RING] THEN
    REWRITE_TAC [RING_CARRIER_POWSER_RING] THEN REWRITE_TAC [POWSER_RING] THEN
    DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"p:(V->num)->A", ← q r"q:(V->num)->A"] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [DE_MORGAN_THM, FUN_EQ_THM, NOT_FORALL_THM, poly_0] THEN
    REWRITE_TAC [POLY_CONST_0, POLY_0, poly_mul] THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q "(:V)") WO) THEN DISCH_THEN (X_CHOOSE_TAC (← q r"l:V->V->bool")) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP WOSET_MONOMIAL_LE) THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [WOSET]) THEN
    REWRITE_TAC [FLD_MONOMIAL_LE] THEN DISCH_THEN (fun th => tactic_of do
      let tp ← SPEC (← q r"{m | ~((p:(V->num)->A) m = ring_0 r)}") th
      let tq ← SPEC (← q r"{m | ~((q:(V->num)->A) m = ring_0 r)}") th
      pure (MP_TAC tq THEN MP_TAC tp)) THEN
    ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, MONOMIAL, IN_ELIM_THM, SUBSET] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [monomial], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"mp:V->num") STRIP_ASSUME_TAC) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [monomial], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"mq:V->num") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"monomial_mul mp mq:V->num") THEN MATCH_MP_TAC m1 THEN
    EXISTS_TAC (← q r"(mp:V->num),(mq:V->num)") THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [RING_SUM_SING, RING_MUL] THEN ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC RING_SUM_SUPERSET THEN
    REWRITE_TAC [SING_SUBSET, FORALL_IN_GSPEC, IMP_CONJ] THEN
    REWRITE_TAC [IN_ELIM_PAIR_THM, IN_SING] THEN
    MAP_EVERY X_GEN_TAC [← q r"np:V->num", ← q r"nq:V->num"] THEN
    DISCH_TAC THEN REWRITE_TAC [PAIR_EQ, DE_MORGAN_THM] THEN
    ASM_CASES_TAC (← q r"(p:(V->num)->A) np = ring_0 r") THENL
     [ASM_SIMP_TAC [RING_MUL_LZERO], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"(q:(V->num)->A) nq = ring_0 r") THENL
     [ASM_SIMP_TAC [RING_MUL_RZERO], ALL_TAC] THEN
    MATCH_MP_TAC tt THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP m3) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"l:V->V->bool")) THEN REWRITE_TAC [] THENL
     [MATCH_MP_TAC MONOMIAL_LTE_MUL2,
      MATCH_MP_TAC MONOMIAL_LET_MUL2] THEN
    ASM_SIMP_TAC [monomial_lt, WOSET_IMP_POSET]))

  let RING_UNIT_POLY_CONST ← prove
   r"!r s c. ring_unit (poly_ring r s) (poly_const r c:(V->num)->A) <=>
           ring_unit r c"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:V->bool"] RING_HOMOMORPHISM_MONOMIAL_1) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"poly_const r c:(V->num)->A") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] RING_UNIT_HOMOMORPHIC_IMAGE)) THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [poly_const],
      MATCH_MP_TAC RING_UNIT_HOMOMORPHIC_IMAGE THEN
      EXISTS_TAC (← q "r:A ring") THEN
      ASM_REWRITE_TAC [RING_HOMOMORPHISM_POLY_CONST]])

  let RING_UNIT_POLY_DOMAIN ← prove
   r"!r s (p:(V->num)->A).
        integral_domain r
        ==> (ring_unit (poly_ring r s) p <=>
             ?c. ring_unit r c /\ p = poly_const r c)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!x. Q(f x) <=> P x) /\ (!y. Q y ==> ?x. y = f x)
      ==> (Q y <=> ?x. P x /\ y = f x)")) THEN
    REWRITE_TAC [RING_UNIT_POLY_CONST] THEN
    X_GEN_TAC (← q r"p:(V->num)->A") THEN REWRITE_TAC [ring_unit] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"q:(V->num)->A") THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MAP_EVERY ASM_CASES_TAC
     [← q r"p:(V->num)->A = ring_0(poly_ring r s)",
      ← q r"q:(V->num)->A = ring_0(poly_ring r s)"] THEN
    ASM_SIMP_TAC [RING_MUL_LZERO, INTEGRAL_DOMAIN_NONTRIVIAL, RING_0,
                  INTEGRAL_DOMAIN_POLY_RING, RING_MUL_RZERO] THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"poly_deg r:((V->num)->A)->num")) THEN
    REWRITE_TAC [POLY_RING, POLY_DEG_1] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [POLY_RING, IN_ELIM_THM]) THEN
    ASM_SIMP_TAC [POLY_DEG_MUL, ADD_EQ_0] THEN ASM_MESON_TAC [POLY_DEG_EQ_0])

  let RING_NILPOTENT_POLY_RING ← prove
   r"!r s (p:(V->num)->A).
        ring_nilpotent (poly_ring r s) p <=>
        p IN ring_carrier(poly_ring r s) /\ (!m. ring_nilpotent r (p m))"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(p:(V->num)->A) IN ring_carrier(poly_ring r s)") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [ring_nilpotent]] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"m:V->num") THEN
      MP_TAC (← ISPEC (← q "r:A ring") RING_NILRADICAL) THEN
      GEN_REWRITE_TAC LAND_CONV [EXTENSION] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(p:(V->num)->A) m")) THEN
      REWRITE_TAC [RADICAL_0, IN_ELIM_THM] THEN
      DISCH_THEN SUBST1_TAC THEN COND_CASES_TAC THENL
       [FIRST_X_ASSUM (SUBST1_TAC o SYM o GEN_REWRITE_RULE id [trivial_ring]) THEN
        ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER],
        REWRITE_TAC [IN_INTERS, FORALL_IN_GSPEC]] THEN
      X_GEN_TAC (← q "j:A->bool") THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP PRIME_IMP_RING_IDEAL) THEN
      SUBGOAL_THEN
       (← q r"ring_nilpotent
          (poly_ring (quotient_ring r j) s)
          (ring_coset r (j:A->bool) o (p:(V->num)->A))")
      MP_TAC THENL
       [MATCH_MP_TAC RING_NILPOTENT_HOMOMORPHIC_IMAGE THEN
        EXISTS_TAC (← q r"poly_ring (r:A ring) (s:V->bool)") THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [ETA_AX] RING_HOMOMORPHISM_POLY_RINGS) THEN
        ASM_SIMP_TAC [RING_HOMOMORPHISM_RING_COSET, PRIME_IMP_RING_IDEAL],
        ASM_SIMP_TAC [INTEGRAL_DOMAIN_NILPOTENT, INTEGRAL_DOMAIN_POLY_RING,
                      INTEGRAL_DOMAIN_QUOTIENT_RING]] THEN
      GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"m:V->num")) THEN
      ASM_SIMP_TAC [POLY_RING, POLY_0, o_THM, QUOTIENT_RING, RING_COSET_0,
                    RING_IDEAL_IMP_SUBSET] THEN
      ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER, RING_COSET_EQ_IDEAL],
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP POLY_MONOMIALS_FINITE) THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP POLY_EXTEND_ID) THEN
      REWRITE_TAC [poly_extend] THEN MATCH_MP_TAC RING_NILPOTENT_SUM THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"m:V->num") THEN
      DISCH_TAC THEN MATCH_MP_TAC RING_NILPOTENT_RMUL THEN
      REWRITE_TAC [RING_PRODUCT] THEN
      MATCH_MP_TAC RING_NILPOTENT_HOMOMORPHIC_IMAGE THEN
      EXISTS_TAC (← q "r:A ring") THEN
      ASM_REWRITE_TAC [RING_HOMOMORPHISM_POLY_CONST]])

  let RING_UNIT_POLY_RING ← prove
   r"!r s (p:(V->num)->A).
        ring_unit (poly_ring r s) p <=>
        p IN ring_carrier(poly_ring r s) /\
        ring_unit r (p monomial_1) /\
        (!m. ~(m = monomial_1) ==> ring_nilpotent r (p m))"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(p:(V->num)->A) IN ring_carrier(poly_ring r s)") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [ring_unit]] THEN
    EQ_TAC THEN DISCH_TAC THEN TRY CONJ_TAC THENL
     [MP_TAC (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] RING_UNIT_HOMOMORPHIC_IMAGE)
           (← ISPECL [← q "r:A ring", ← q r"s:V->bool"] RING_HOMOMORPHISM_MONOMIAL_1)) THEN
      ASM_SIMP_TAC [],
      X_GEN_TAC (← q r"m:V->num") THEN DISCH_TAC THEN
      MP_TAC (← ISPEC (← q "r:A ring") RING_NILRADICAL) THEN
      GEN_REWRITE_TAC LAND_CONV [EXTENSION] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(p:(V->num)->A) m")) THEN
      REWRITE_TAC [RADICAL_0, IN_ELIM_THM] THEN
      DISCH_THEN SUBST1_TAC THEN COND_CASES_TAC THENL
       [FIRST_X_ASSUM (SUBST1_TAC o SYM o GEN_REWRITE_RULE id [trivial_ring]) THEN
        ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER],
        REWRITE_TAC [IN_INTERS, FORALL_IN_GSPEC]] THEN
      X_GEN_TAC (← q "j:A->bool") THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP PRIME_IMP_RING_IDEAL) THEN
       MP_TAC (← ISPECL
        [← q "quotient_ring r (j:A->bool)", ← q r"s:V->bool",
         ← q r"ring_coset r (j:A->bool) o (p:(V->num)->A)"]
        RING_UNIT_POLY_DOMAIN) THEN
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_POLY_RING, INTEGRAL_DOMAIN_QUOTIENT_RING] THEN
      DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).1)) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC RING_UNIT_HOMOMORPHIC_IMAGE THEN
        EXISTS_TAC (← q r"poly_ring (r:A ring) (s:V->bool)") THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [ETA_AX] RING_HOMOMORPHISM_POLY_RINGS) THEN
        ASM_SIMP_TAC [RING_HOMOMORPHISM_RING_COSET, PRIME_IMP_RING_IDEAL],
        DISCH_THEN (X_CHOOSE_THEN (← q "c:A->bool") STRIP_ASSUME_TAC)] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"m:V->num") o
         GEN_REWRITE_RULE id [FUN_EQ_THM]) THEN
      ASM_SIMP_TAC [poly_const, o_THM, QUOTIENT_RING, RING_COSET_0,
                    RING_IDEAL_IMP_SUBSET] THEN
      ASM_MESON_TAC [POLY_MONOMIAL_IN_CARRIER, RING_COSET_EQ_IDEAL],
      ASM_CASES_TAC (← q "trivial_ring (r:A ring)") THENL
       [ASM_MESON_TAC [TRIVIAL_POLY_RING, trivial_ring, RING_UNIT_0, IN_SING],
        ALL_TAC] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP POLY_MONOMIALS_FINITE) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP POLY_MONOMIAL_IN_CARRIER) THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP POLY_EXTEND_ID) THEN
      REWRITE_TAC [poly_extend] THEN
      SUBGOAL_THEN
       (← q r"{m | ~((p:(V->num)->A) m = ring_0 r)} =
        monomial_1 INSERT ({m | ~(p m = ring_0 r)} DELETE monomial_1)")
      SUBST1_TAC THENL
       [REWRITE_TAC [← SET_RULE
         (← q r"{x | P x} = a INSERT ({x | P x} DELETE a) <=> P a")] THEN
        ASM_MESON_TAC [RING_UNIT_0],
        ASM_SIMP_TAC [RING_SUM_CLAUSES, FINITE_DELETE, RING_MUL, POLY_CONST,
                      RING_PRODUCT, IN_DELETE]] THEN
      MATCH_MP_TAC (← CONJUNCT1 RING_UNIT_NILPOTENT_CLAUSES) THEN CONJ_TAC THENL
       [REWRITE_TAC [MONOMIAL_VARS_1, RING_PRODUCT_CLAUSES] THEN
        ASM_SIMP_TAC [RING_MUL_RID, POLY_CONST, RING_UNIT_POLY_CONST],
        MATCH_MP_TAC RING_NILPOTENT_SUM THEN
        ASM_REWRITE_TAC [FINITE_DELETE, IN_ELIM_THM, IN_DELETE] THEN
        X_GEN_TAC (← q r"m:V->num") THEN
        DISCH_TAC THEN MATCH_MP_TAC RING_NILPOTENT_RMUL THEN
        REWRITE_TAC [RING_PRODUCT] THEN
        MATCH_MP_TAC RING_NILPOTENT_HOMOMORPHIC_IMAGE THEN
        EXISTS_TAC (← q "r:A ring") THEN
        ASM_SIMP_TAC [RING_HOMOMORPHISM_POLY_CONST]]])

  let RING_UNIT_POLY_RING_1 ← prove
   r"!(r:A ring) p.
        ring_unit (poly_ring r (:1)) p <=>
        p IN ring_carrier (poly_ring r (:1)) /\
        ring_unit r (coeff 0 p) /\
        !i. 0 < i ==> ring_nilpotent r (coeff i p)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [RING_UNIT_POLY_RING] THEN
    REWRITE_TAC [FORALL_FUN_FROM_1, monomial_1, coeff] THEN
    REWRITE_TAC [LAMBDA_1_EQ] THEN MESON_TAC [LE_1])

  let RING_UNIT_POLY_VAR ← prove
   r"!(r:A ring) (v:V->bool) x.
        ring_unit (poly_ring r v) (poly_var r x) <=> trivial_ring r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [RING_UNIT_POLY_RING, POLY_VAR] THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o LAND_CONV o ONCE_DEPTH_CONV)
      [poly_var] THEN
    REWRITE_TAC [MONOMIAL_VAR_1, RING_UNIT_0] THEN
    ASM_CASES_TAC (← q "trivial_ring(r:A ring)") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [poly_var] THEN
    ASM_MESON_TAC [RING_NILPOTENT_0, RING_NILPOTENT_1])

  let FIELD_POLY_RING ← prove
   r"!(r:A ring) (s:V->bool). field(poly_ring r s) <=> field r /\ s = {}"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:V->bool = {}") THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [ISOMORPHIC_POLY_RING_TRIVIAL, ISOMORPHIC_RING_FIELDNESS],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY])] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q "x:V")) THEN
    REWRITE_TAC [FIELD_EQ_ALL_UNITS, ← GSYM TRIVIAL_RING_10, TRIVIAL_POLY_RING] THEN
    ASM_CASES_TAC (← q "trivial_ring(r:A ring)") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [RING_UNIT_POLY_RING] THEN
    DISCH_THEN (MP_TAC o SPEC (← q "poly_var (r:A ring) (x:V)")) THEN
    ASM_REWRITE_TAC [POLY_VAR] THEN
    REWRITE_TAC [POLY_RING, ← GSYM POLY_CONST_0, POLY_VAR_EQ_CONST] THEN
    ASM_SIMP_TAC [poly_var, MONOMIAL_VAR_1, NOT_IMP, RING_UNIT_0])

  let POLY_DEG_UNIT ← prove
   r"!(r:A ring) (s:V->bool) p.
        integral_domain r /\ ring_unit (poly_ring r s) p ==> poly_deg r p = 0"
   (MESON_TAC [RING_UNIT_POLY_DOMAIN, POLY_DEG_CONST])

  let POLY_DEG_EQ_0_UNIT ← prove
   r"!(f:A ring) (s:V->bool) p.
        field f /\ ring_polynomial f p
        ==> (poly_deg f p = 0 <=>
             ring_unit(poly_ring f s) p \/ p = ring_0(poly_ring f s))"
   (SIMP_TAC [POLY_DEG_EQ_0, RING_UNIT_POLY_DOMAIN, FIELD_IMP_INTEGRAL_DOMAIN,
              FIELD_UNIT] THEN
    MESON_TAC [POLY_CONST_0, RING_0, POLY_RING])

  let IRREDUCIBLE_IMP_POLY_DEG_NZ ← prove
   r"!(k:A ring) p.
        field k /\ ring_irreducible (poly_ring k (:1)) p
        ==> ~(poly_deg k p = 0)"
   (MESON_TAC [POLY_DEG_EQ_0_UNIT, RING_POLYNOMIAL, ring_irreducible])

  let POLY_DEG_1_IMP_IRREDUCIBLE ← prove
   r"!(f:A ring) (s:V->bool) p.
    field f /\ p IN ring_carrier(poly_ring f s) /\ poly_deg f p = 1
    ==> ring_irreducible (poly_ring f s) p"
   (← do
    -- right to left: the second ARITH_RULE, the first, then the TAUT
    let a2 ← ARITH_RULE (← q "a + b = 1 ==> a = 0 \\/ b = 0")
    let a1 ← ARITH_RULE (← q "~(1 = 0)")
    let tt ← TAUT (← q r"(p /\ q) /\ (p /\ q ==> r) ==> p /\ q /\ r")
    pure (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [ring_irreducible] THEN
    MATCH_MP_TAC tt THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [IN_POLY_RING_CARRIER, POLY_DEG_EQ_0_UNIT, a1],
      REWRITE_TAC [IN_POLY_RING_CARRIER] THEN STRIP_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_POLY_RING_CARRIER, POLY_RING]) THEN
    MAP_EVERY X_GEN_TAC [← q r"q:(V->num)->A", ← q r"r:(V->num)->A"] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_CASES_TAC (← q r"q:(V->num)->A = poly_0 f") THEN
    ASM_SIMP_TAC [POLY_MUL_0, POLY_RING] THEN
    ASM_CASES_TAC (← q r"r:(V->num)->A = poly_0 f") THEN
    ASM_SIMP_TAC [POLY_MUL_0, POLY_RING] THEN DISCH_TAC THEN
    UNDISCH_TAC (← q r"poly_deg f (p:(V->num)->A) = 1") THEN EXPAND_TAC "p" THEN
    ASM_SIMP_TAC [POLY_DEG_MUL, FIELD_IMP_INTEGRAL_DOMAIN] THEN
    DISCH_THEN (MP_TAC o MATCH_MP a2) THEN
    ASM_SIMP_TAC [POLY_DEG_EQ_0_UNIT] THEN ASM_MESON_TAC [POLY_RING]))

  let RING_UNIT_POWSER_RING ← prove
   r"!(r:A ring) (s:V->bool) p.
        ring_unit (powser_ring r s) p <=>
        p IN ring_carrier(powser_ring r s) /\
        ring_unit r (p monomial_1)"
   (← do
    -- right to left: the third, second TAUT, the RING_RULE, the first TAUT,
    -- then the SET_RULE
    let t3 ← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")
    let t2 ← TAUT (← q r"(p ==> (q <=> r)) ==> (p ==> q <=> p ==> r)")
    let rr ← RING_RULE
     (← q r"x IN ring_carrier r /\ y IN ring_carrier r
       ==> x = ring_add r y (ring_sub r x y)")
    let t1 ← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")
    let sr ← SET_RULE (← q r"{f x y | x = a /\ y = b} = {f a b}")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [ring_unit] THEN
    EQ_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_REWRITE_TAC [] THENL
     [CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
         [RING_CARRIER_POWSER_RING]) THEN
        SIMP_TAC [IN_ELIM_THM],
        FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"q:(V->num)->A") MP_TAC) THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        REWRITE_TAC [POWSER_RING] THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"(q:(V->num)->A) monomial_1") THEN
        RULE_ASSUM_TAC (REWRITE_RULE [RING_CARRIER_POWSER_RING, IN_ELIM_THM]) THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          pure (MP_TAC (← AP_THM th (← q r"monomial_1:V->num")))) THEN
        ASM_REWRITE_TAC [poly_mul, poly_1, MONOMIAL_MUL_EQ_1, poly_const] THEN
        REWRITE_TAC [sr] THEN
        ASM_SIMP_TAC [RING_SUM_SING, RING_MUL]],
      ONCE_REWRITE_TAC [t1] THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:V->bool"] POWSER_RING_EQ) THEN
      ASM_SIMP_TAC [POWSER_RING_EQ, RING_MUL, RING_1] THEN
      DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
      REWRITE_TAC [RING_CARRIER_POWSER_RING, ← CONJUNCT2 POWSER_RING] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
         [RING_CARRIER_POWSER_RING]) THEN
      REWRITE_TAC [IN_ELIM_THM, poly_mul, poly_1, poly_const]] THEN
    SUBGOAL_THEN
     (← q r"!(q:(V->num)->A) m.
        monomial s m /\
        (!m. p m IN ring_carrier r) /\
        (!m. q m IN ring_carrier r)
        ==> ring_sum r {m1,m2 | monomial_mul m1 m2 = m}
                       (\(m1,m2). ring_mul r (p m1) (q m2)) =
            ring_add r (ring_mul r (p monomial_1) (q m))
                       (ring_sum r ({m1,m2 | monomial_mul m1 m2 = m} DELETE
                                    (monomial_1,m))
                                   (\(m1,m2). ring_mul r (p m1) (q m2)))")
    MP_TAC THENL
     [SIMP_TAC [RING_SUM_DELETE, RING_MUL, MONOMIAL_MUL_LID,
                MONOMIAL_FINITE_DIVISORPAIRS, monomial, IN_ELIM_PAIR_THM] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC rr THEN
      ASM_SIMP_TAC [RING_SUM, RING_MUL],
      SIMP_TAC [] THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN STRIP_TAC] THEN
    REWRITE_TAC [NOT_IMP, AND_FORALL_THM] THEN
    MP_TAC (← ISPEC (← q "(:V)") WO) THEN DISCH_THEN (X_CHOOSE_TAC (← q r"l:V->V->bool")) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP WOSET_MONOMIAL_LE) THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [WOSET_WF]) THEN
    REWRITE_TAC [PROPERLY_MONOMIAL_LE] THEN
    DISCH_THEN (MATCH_MP_TAC o MATCH_MP WF_REC_EXISTS) THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN AP_TERM_TAC THEN
      MATCH_MP_TAC t2 THEN
      REWRITE_TAC [monomial] THEN STRIP_TAC THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      MATCH_MP_TAC RING_SUM_EQ THEN
      REWRITE_TAC [IN_DELETE, IMP_CONJ, FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"m1:V->num", ← q r"m2:V->num"] THEN
      ASM_CASES_TAC (← q r"m1:V->num = monomial_1") THEN
      ASM_SIMP_TAC [PAIR_EQ, MONOMIAL_MUL_LID] THEN DISCH_TAC THEN
      AP_TERM_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o SYM) THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM MONOMIAL_MUL_LID] THEN
      REWRITE_TAC [MONOMIAL_LT_RMUL] THEN
      ASM_REWRITE_TAC [monomial_lt, MONOMIAL_GE_1] THEN
      ASM_MESON_TAC [MONOMIAL_MUL, MONOMIAL],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"q:(V->num)->A", ← q r"m:V->num"] THEN
    REWRITE_TAC [t3] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN STRIP_ASSUME_TAC o CONJUNCT1) THEN
    ASM_CASES_TAC (← q r"monomial s (m:V->num)") THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC, MESON_TAC [RING_0]] THEN
    SUBGOAL_THEN
     (← q r"!w x z:A.
       w IN ring_carrier r /\ x IN ring_carrier r /\ z IN ring_carrier r /\
       (!z. z IN ring_carrier r
            ==> ?y. y IN ring_carrier r /\
                    ring_mul r x y = z)
       ==> ?y. y IN ring_carrier r /\
               ring_add r (ring_mul r x y) z = w")
    MATCH_MP_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A", ← q "c:A"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (MP_TAC o SPEC (← q "ring_sub r a c:A")) THEN
      ASM_SIMP_TAC [RING_SUB] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "d:A") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_REWRITE_TAC [] THEN RING_TAC,
      ASM_REWRITE_TAC [RING_SUM]] THEN
    CONJ_TAC THENL [MESON_TAC [RING_0, RING_1], ALL_TAC] THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q "b:A") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q "ring_mul r b a:A") THEN
    ASM_SIMP_TAC [RING_MUL, RING_MUL_ASSOC, RING_MUL_LID]))

  let LOCAL_POWSER_RING ← prove
   r"!(r:A ring) (s:V->bool).
        local_ring r ==> local_ring(powser_ring r s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [LOCAL_RING_IDEAL_NONUNITS, RING_IDEAL_NONUNITS] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [TRIVIAL_POWSER_RING] THEN
    ASM_SIMP_TAC [RING_UNIT_POWSER_RING, RING_ADD] THEN
    REWRITE_TAC [← CONJUNCT2 POWSER_RING, poly_add] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM SET_TAC [RING_CARRIER_POWSER_RING])

  let RING_PRIME_POLY_VAR_UNIVARIATE ← prove
   r"!(r:A ring).
        ring_prime (poly_ring r (:1)) (poly_var r one) <=>
        integral_domain r"
   (GEN_TAC THEN
    TRANS_TAC EQ_TRANS
     (← q r"prime_ideal (poly_ring (r:A ring) (:1))
       (ideal_generated (poly_ring r (:1)) {poly_var r one})") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [PRIME_IDEAL_SING, POLY_VAR, IN_UNIV] THEN
      REWRITE_TAC [POLY_VAR_EQ_CONST, POLY_RING, poly_0] THEN
      REWRITE_TAC [INTEGRAL_DOMAIN_POLY_RING] THEN MATCH_MP_TAC (← TAUT
       (← q r"(i ==> ~t) /\ (p ==> ~t) ==> (p <=> if t then i else p)")) THEN
      REWRITE_TAC [INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING] THEN
      MESON_TAC [TRIVIAL_POLY_RING, RING_PRIME_IMP_NONTRIVIAL_RING],
      SIMP_TAC [RING_IDEAL_IDEAL_GENERATED,
                ← GSYM INTEGRAL_DOMAIN_QUOTIENT_RING]] THEN
    MATCH_MP_TAC ISOMORPHIC_RING_INTEGRAL_DOMAINNESS THEN
    MP_TAC (← ISPECL [← q "poly_ring (r:A ring) (:1)", ← q "r:A ring",
                   ← q r"\p. poly_eval (r:A ring) p (ring_0 r)"]
          FIRST_RING_EPIMORPHISM_THEOREM) THEN
    SIMP_TAC [RING_EPIMORPHISM_POLY_EVAL, RING_0] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] ISOMORPHIC_RING_TRANS) THEN
    MATCH_MP_TAC ISOMORPHIC_RING_EQ THEN AP_TERM_TAC THEN
    SIMP_TAC [ring_kernel, IDEAL_GENERATED_SING, POLY_VAR, IN_UNIV] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, POLY_VAR_DIVIDES_UNIVARIATE] THEN
    REWRITE_TAC [RING_POLYNOMIAL] THEN MESON_TAC [POLY_EVAL_AT_0])

  let RING_PRIME_POLY_VAR ← prove
   r"!(r:A ring) v x:V.
        ring_prime (poly_ring r v) (poly_var r x) <=>
        integral_domain r /\ x IN v"
   (← do
    let lemma ← prove
     r"!(r:A ring) x:V.
          ring_prime (poly_ring r {x}) (poly_var r x) <=>
          integral_domain r"
     (REPEAT GEN_TAC THEN
      MP_TAC (← SPEC (← q "r:A ring") RING_PRIME_POLY_VAR_UNIVARIATE) THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      SUBGOAL_THEN (← q r"BIJ (\v:V. one) {x} (:1)") ASSUME_TAC THENL
       [REWRITE_TAC [BIJ, INJ, SURJ] THEN
        REWRITE_TAC [FORALL_ONE_THM, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
        SET_TAC [],
        MP_TAC (← ISPECL [← q "r:A ring", ← q "{x:V}", ← q "(:1)", ← q r"(\v:V. one)"]
            RING_ISOMORPHISM_POLY_REINDEX) THEN ASM_REWRITE_TAC []] THEN
      DISCH_THEN (MP_TAC o SPEC (← q "poly_var (r:A ring) one") o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] RING_PRIME_ISOMORPHIC_IMAGE_EQ)) THEN
      REWRITE_TAC [POLY_VAR, IN_UNIV] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MP_TAC (← ISPECL
       [← q "r:A ring", ← q r"(\v:V. one)", ← q "{x:V}", ← q "(:1)", ← q "x:V"]
            POLY_REINDEX_VAR) THEN
      ASM_SIMP_TAC [IN_SING])
    let sr ← SET_RULE (← q r"x IN v ==> v DELETE x UNION {x} = v")
    pure (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q "(x:V) IN v") THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC,
      ASM_MESON_TAC [RING_PRIME_IN_CARRIER, RING_PRIME_IMP_NONTRIVIAL_RING,
                     POLY_VAR, TRIVIAL_POLY_RING]] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "v DELETE (x:V)", ← q "{x:V}"]
          RING_ISOMORPHISMS_POLY_POLY_RING) THEN
    ANTS_TAC THENL [SET_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [sr] THEN
    ONCE_REWRITE_TAC [RING_ISOMORPHISMS_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP RING_ISOMORPHISMS_IMP_ISOMORPHISM) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"poly_var r x:(V->num)->A") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] RING_PRIME_ISOMORPHIC_IMAGE_EQ)) THEN
    ASM_REWRITE_TAC [POLY_VAR] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MP_TAC (← ISPECL [← q "poly_ring (r:A ring) (v DELETE (x:V))", ← q "x:V"] lemma) THEN
    REWRITE_TAC [INTEGRAL_DOMAIN_POLY_RING] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN REWRITE_TAC [poly_var] THEN
    REWRITE_TAC [MONOMIAL_MUL_EQ_VAR] THEN X_GEN_TAC (← q r"m1:V->num") THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [MONOMIAL_VAR_1] THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"m2:V->num") THEN
    REWRITE_TAC [POLY_RING, poly_0, poly_1, COND_ID, MONOMIAL_VAR, IN_SING,
                 poly_const]
    THENL [MESON_TAC [MONOMIAL_1], ALL_TAC] THEN
    ASM_CASES_TAC (← q "m2 = monomial_var (x:V)") THEN
    ASM_REWRITE_TAC [MONOMIAL_VAR, IN_DELETE, COND_ID]))

  let RING_IRREDUCIBLE_POLY_VAR ← prove
   r"!(r:A ring) v x:V.
        integral_domain r /\ x IN v
        ==> ring_irreducible (poly_ring r v) (poly_var r x)"
   (MESON_TAC [INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE, RING_PRIME_POLY_VAR,
               INTEGRAL_DOMAIN_POLY_RING])

  let RING_PRIME_POLY_CONST ← prove
   r"!(r:A ring) (s:V->bool) p.
     ring_prime (poly_ring r s) (poly_const r p) <=> ring_prime r p"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [ring_prime, POLY_CONST, RING_UNIT_POLY_CONST] THEN
      ASM_CASES_TAC (← q "(p:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q "p:A = ring_0 r") THENL
       [ASM_MESON_TAC [POLY_RING, POLY_CONST_EQ_0], ALL_TAC] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(poly_const r a):(V->num)->A", ← q r"(poly_const r b):(V->num)->A"]) THEN
      ASM_REWRITE_TAC [POLY_CONST, POLY_CONST_DIVIDES_CONST] THEN
      ASM_SIMP_TAC [← GSYM POLY_CONST_MUL, POLY_RING, POLY_CONST_DIVIDES_CONST],
      DISCH_TAC] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE id [ring_prime]) THEN
    ABBREV_TAC
      (← q "j = ideal_generated r {p:A}") THEN
    SUBGOAL_THEN (← q "ring_ideal r (j:A->bool)") ASSUME_TAC THENL
    [EXPAND_TAC "j" THEN REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"integral_domain
        (poly_ring (quotient_ring r (j:A->bool)) (s:V->bool))") ASSUME_TAC THENL
    [ASM_SIMP_TAC [INTEGRAL_DOMAIN_POLY_RING,
       INTEGRAL_DOMAIN_QUOTIENT_RING] THEN
     EXPAND_TAC "j" THEN ASM_SIMP_TAC [PRIME_IDEAL_SING],
     ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"ring_homomorphism (poly_ring r (s:V->bool),
         poly_ring (quotient_ring r (j:A->bool)) s)
        (\q:(V->num)->A. ring_coset r j o q)") ASSUME_TAC THENL
    [ASM_SIMP_TAC [RING_HOMOMORPHISM_POLY_RINGS, RING_HOMOMORPHISM_RING_COSET],
     ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o REWRITE_RULE [SUBSET, FORALL_IN_IMAGE] o
      CONJUNCT1 o GEN_REWRITE_RULE id [ring_homomorphism]) THEN
    SUBGOAL_THEN
      (← q r"(\q:(V->num)->A. ring_coset r (j:A->bool) o q) (poly_const r p) =
       ring_0 (poly_ring (quotient_ring r j) (s:V->bool))") ASSUME_TAC THENL
    [CONV_TAC (LAND_CONV BETA_CONV) THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
     X_GEN_TAC (← q r"m:V->num") THEN
     REWRITE_TAC [o_THM, poly_const, POLY_RING, POLY_0] THEN
     COND_CASES_TAC THEN
     ASM_SIMP_TAC [QUOTIENT_RING, RING_COSET_0, RING_IDEAL_IMP_SUBSET] THEN
     ASM_MESON_TAC [RING_COSET_EQ_IDEAL, IDEAL_GENERATED_INC,
       IN_SING, SING_SUBSET],
     ALL_TAC] THEN
    REWRITE_TAC [ring_prime] THEN REPEAT CONJ_TAC THENL
    [ASM_REWRITE_TAC [POLY_RING, POLY_CONST],
     ASM_MESON_TAC [POLY_RING, POLY_CONST_0, POLY_CONST_EQ],
     ASM_MESON_TAC [RING_UNIT_POLY_CONST, ring_prime],
     ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:(V->num)->A", ← q r"g:(V->num)->A"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"(!m:V->num. ring_divides r p ((f:(V->num)->A) m)) \/
       (!m. ring_divides r p ((g:(V->num)->A) m))") MP_TAC THENL
    [ALL_TAC,
     DISCH_THEN DISJ_CASES_TAC THENL [DISJ1_TAC, DISJ2_TAC] THEN
     MATCH_MP_TAC POLY_CONST_DIVIDES_COEFFS THEN ASM_REWRITE_TAC []] THEN
    SUBGOAL_THEN
      (← q r"(\q:(V->num)->A. ring_coset r (j:A->bool) o q)
        (ring_mul (poly_ring r (s:V->bool)) (f:(V->num)->A) g) =
       ring_0 (poly_ring (quotient_ring r j) s)") ASSUME_TAC THENL
    [SUBGOAL_THEN
       (← q r"ring_divides (poly_ring (quotient_ring r (j:A->bool)) (s:V->bool))
         ((\q:(V->num)->A. ring_coset r j o q) (poly_const r p))
         ((\q. ring_coset r j o q)
            (ring_mul (poly_ring r s) (f:(V->num)->A) g))") MP_TAC THENL
     [MATCH_MP_TAC RING_DIVIDES_HOMOMORPHIC_IMAGE THEN
      EXISTS_TAC (← q r"poly_ring (r:A ring) (s:V->bool)") THEN ASM_REWRITE_TAC [],
      ASM_REWRITE_TAC [RING_DIVIDES_ZERO]],
     ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"(\q:(V->num)->A. ring_coset r (j:A->bool) o q) (f:(V->num)->A) =
       ring_0 (poly_ring (quotient_ring r j) (s:V->bool)) \/
       (\q:(V->num)->A. ring_coset r (j:A->bool) o q) (g:(V->num)->A) =
       ring_0 (poly_ring (quotient_ring r j) s)") MP_TAC THENL
    [MP_TAC (← ISPEC (← q r"poly_ring (quotient_ring (r:A ring) (j:A->bool)) (s:V->bool)")
       INTEGRAL_DOMAIN_MUL_EQ_0) THEN
     ASM_SIMP_TAC [] THEN ASM_MESON_TAC [RING_HOMOMORPHISM_MUL],
     ALL_TAC] THEN
    DISCH_THEN DISJ_CASES_TAC THENL [DISJ1_TAC, DISJ2_TAC] THEN
    X_GEN_TAC (← q r"m:V->num") THEN
    FIRST_X_ASSUM (MP_TAC o AP_TERM
      (← q r"\(ff:(V->num)->(A->bool)). ff (m:V->num)")) THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN
    ASM_SIMP_TAC [o_THM, POLY_RING, POLY_0, QUOTIENT_RING,
      RING_COSET_0, RING_IDEAL_IMP_SUBSET] THEN
    DISCH_TAC THEN EXPAND_TAC "j" THEN
    ASM_MESON_TAC [RING_COSET_EQ_IDEAL, IN_IDEAL_GENERATED_SING_EQ,
      POLY_MONOMIAL_IN_CARRIER])

  let RING_IRREDUCIBLE_POLY_CONST ← prove
   r"!(r:A ring) (s:V->bool) p.
        integral_domain r
        ==> (ring_irreducible (poly_ring r s) (poly_const r p) <=>
             ring_irreducible r p)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ring_irreducible, POLY_CONST, RING_UNIT_POLY_CONST] THEN
    ASM_CASES_TAC (← q "(p:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 POLY_RING), POLY_CONST_EQ_0] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(poly_const r a):(V->num)->A", ← q r"(poly_const r b):(V->num)->A"]) THEN
      ASM_REWRITE_TAC [POLY_CONST] THEN
      ASM_SIMP_TAC [← GSYM POLY_CONST_MUL, POLY_RING, RING_UNIT_POLY_CONST],
      MAP_EVERY X_GEN_TAC [← q r"u:(V->num)->A", ← q r"v:(V->num)->A"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      SUBGOAL_THEN
       (← q r"ring_polynomial r (u:(V->num)->A) /\
        ring_polynomial r (v:(V->num)->A)")
      STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [IN_POLY_RING_CARRIER], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SYM) THEN REWRITE_TAC [← CONJUNCT2 POLY_RING] THEN
      ASM_CASES_TAC (← q r"u:(V->num)->A = poly_0 r") THEN
      ASM_SIMP_TAC [POLY_MUL_0, POLY_CONST_EQ_0] THEN
      ASM_CASES_TAC (← q r"v:(V->num)->A = poly_0 r") THEN
      ASM_SIMP_TAC [POLY_MUL_0, POLY_CONST_EQ_0] THEN
      DISCH_THEN (ASSUME_TAC o SYM) THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q r"u:(V->num)->A", ← q r"v:(V->num)->A"]
          POLY_DEG_MUL) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [IN_POLY_RING_CARRIER], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SYM) THEN ASM_REWRITE_TAC [POLY_DEG_CONST] THEN
      ASM_SIMP_TAC [ADD_EQ_0, POLY_DEG_EQ_0] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
      X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN
      X_GEN_TAC (← q "b:A") THEN DISCH_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN
      ASM_SIMP_TAC [RING_UNIT_POLY_CONST] THEN
      ASM_MESON_TAC [POLY_CONST_MUL, POLY_CONST_EQ]])

  -- @@RETURN BEGIN
  return { INTEGRAL_DOMAIN_POWSER_RING, RING_UNIT_POLY_CONST, RING_UNIT_POLY_DOMAIN,
           RING_NILPOTENT_POLY_RING, RING_UNIT_POLY_RING, RING_UNIT_POLY_RING_1,
           RING_UNIT_POLY_VAR, FIELD_POLY_RING, POLY_DEG_UNIT, POLY_DEG_EQ_0_UNIT,
           IRREDUCIBLE_IMP_POLY_DEG_NZ, POLY_DEG_1_IMP_IRREDUCIBLE,
           RING_UNIT_POWSER_RING, LOCAL_POWSER_RING, RING_PRIME_POLY_VAR_UNIVARIATE,
           RING_PRIME_POLY_VAR, RING_IRREDUCIBLE_POLY_VAR, RING_PRIME_POLY_CONST,
           RING_IRREDUCIBLE_POLY_CONST }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- X - a divides p(X) - p(a) and consequences like finiteness of roots.      -/
/- (ringtheory.ml 24576-24774)                                               -/
/- ------------------------------------------------------------------------- -/

structure XMinusA where
  -- @@FIELDS
  POLY_DEG_X_MINUS_A : thm
  POLY_X_MINUS_A_NONZERO : thm
  POLY_X_MINUS_A_IN_CARRIER : thm
  POLY_DIVIDES_X_MINUS_A : thm
  POLY_DIVIDES_X_MINUS_ROOT : thm
  POLY_DIVIDES_X_MINUS_ROOT_EQ : thm
  POLY_DEG_MUL_X_MINUS_A : thm
  POLY_ROOT_BOUND : thm
  INFINITE_INTEGRAL_DOMAIN_POLY_EVAL_ALL_ZERO : thm
  deriving Inhabited

@[nospecialize]
def setupXMinusA [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDivides : Divides) (BDomains : Domains) (BRingRule : RingRule) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BDegree : Degree) (BEvaluation : Evaluation) :
    ExceptT String IO XMinusA := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, NUM_REDUCE_CONV, SET_TAC,
        WF_INDUCT_TAC, .. } := D
  let { ADD_SYM, AND_FORALL_THM, ARITH_EQ, CARD_CLAUSES, .. } := D.core1
  let { DISJ_ACI, EXTENSION, .. } := D.core2
  let { FINITE_EMPTY, FINITE_INSERT, FORALL_IN_INSERT, .. } := D.core3
  let { IMP_CONJ, INFINITE, .. } := D.core4
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, LE_0, .. } := D.core5
  let { MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET_UNIV, UNIV_1, .. } := D.core7
  let { RING_ADD, RING_MUL, RING_MUL_LZERO, RING_MUL_RZERO, RING_SUB, RING_SUB_EQ_0,
        RING_SUB_REFL, RING_SUB_RZERO, TRIVIAL_RING_10, .. } := BBasics
  let { RING_DIVIDES_0, RING_DIVIDES_REFL, ring_divides, .. } := BDivides
  let { INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, INTEGRAL_DOMAIN_MUL_EQ_0,
        INTEGRAL_DOMAIN_NONTRIVIAL, .. } := BDomains
  let { RING_TAC, .. } := BRingRule
  let { POLY_CONST_0, RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_VAR, .. } := BPowerSeries
  let { POLY_CLAUSES, POLY_CONST, POLY_CONST_ADD, POLY_CONST_MUL, POLY_RING,
        POLY_RING_CLAUSES, POLY_RING_INDUCT_STRONG, POLY_VAR_UNIV, RING_POLYNOMIAL, .. } := BPolyRings
  let { POLY_DEG_0, POLY_DEG_CONST, POLY_DEG_MUL, POLY_DEG_SUB, POLY_DEG_VAR, .. } := BDegree
  let { POLY_EVAL, POLY_EVAL_ADD, POLY_EVAL_CONST, POLY_EVAL_MUL, POLY_EVAL_SUB,
        POLY_EVAL_VAR, .. } := BEvaluation
  -- @@SCOPE END

  let POLY_DEG_X_MINUS_A ← prove
   r"!r (a:A).
     ~trivial_ring r /\ a IN ring_carrier r
     ==> poly_deg r (poly_sub r (poly_var r (one:1)) (poly_const r a)) = 1"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL [← q "r:A ring",
      ← q "poly_var (r:A ring) (one:1):(1->num)->A",
      ← q "poly_const (r:A ring) (a:A):(1->num)->A"] POLY_DEG_SUB) THEN
    ASM_REWRITE_TAC [RING_POLYNOMIAL_VAR, RING_POLYNOMIAL_CONST,
                     POLY_DEG_VAR, POLY_DEG_CONST,
                     ← GSYM TRIVIAL_RING_10] THEN ARITH_TAC)

  let POLY_X_MINUS_A_NONZERO ← prove
   r"!r (a:A).
     ~trivial_ring r /\ a IN ring_carrier r
     ==> ~(poly_sub r (poly_var r (one:1))
                       (poly_const r a) = poly_0 r)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q "r:A ring", ← q "a:A"] POLY_DEG_X_MINUS_A) THEN
    ASM_REWRITE_TAC [POLY_DEG_0] THEN ARITH_TAC)

  let POLY_X_MINUS_A_IN_CARRIER ← prove
   r"!r (a:A).
        a IN ring_carrier r
        ==> poly_sub r (poly_var r (one:1)) (poly_const r a)
            IN ring_carrier(poly_ring r (:1))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN
    MATCH_MP_TAC RING_POLYNOMIAL_SUB THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_VAR, RING_POLYNOMIAL_CONST])

  let POLY_DIVIDES_X_MINUS_A ← prove
   r"!r (a:A) p.
        a IN ring_carrier r /\ p IN ring_carrier(poly_ring r (:1))
        ==> ring_divides (poly_ring r (:1))
              (poly_sub r (poly_var r one) (poly_const r a))
              (poly_sub r p (poly_const r (poly_eval r p a)))"
   (← do
    let lemma ← prove
     r"!r a x x' y y':A.
      x IN ring_carrier r /\ x' IN ring_carrier r /\
      y IN ring_carrier r /\ y' IN ring_carrier r /\
      ring_divides r a (ring_sub r x x') /\
      ring_divides r a (ring_sub r y y')
      ==> ring_divides r a (ring_sub r (ring_add r x y) (ring_add r x' y')) /\
          ring_divides r a (ring_sub r (ring_mul r x y) (ring_mul r x' y'))"
     (REPEAT GEN_TAC THEN REWRITE_TAC [ring_divides, IMP_CONJ] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN REPEAT DISCH_TAC THEN
      X_GEN_TAC (← q "d:A") THEN STRIP_TAC THEN REPEAT DISCH_TAC THEN
      X_GEN_TAC (← q "e:A") THEN STRIP_TAC THEN REPEAT DISCH_TAC THEN
      ASM_SIMP_TAC [RING_ADD, RING_SUB, RING_MUL] THEN CONJ_TAC THENL
       [EXISTS_TAC (← q "ring_add r d e:A"),
        EXISTS_TAC (← q "ring_add r (ring_mul r d y) (ring_mul r e x'):A")] THEN
      ASM_SIMP_TAC [RING_ADD, RING_MUL] THEN RING_TAC)
    pure (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC POLY_RING_INDUCT_STRONG THEN
    ASM_SIMP_TAC [POLY_EVAL_CONST, POLY_EVAL_VAR, POLY_EVAL_ADD, POLY_EVAL_MUL,
                  POLY_RING, IN_ELIM_THM, SUBSET_UNIV] THEN
    ASM_SIMP_TAC [UNIV_1, FORALL_IN_INSERT, NOT_IN_EMPTY, POLY_EVAL_VAR] THEN
    ASM_SIMP_TAC [POLY_CONST_ADD, POLY_CONST_MUL, POLY_EVAL] THEN
    REWRITE_TAC [POLY_CLAUSES, ← GSYM UNIV_1,
                 RING_POLYNOMIAL] THEN
    ASM_SIMP_TAC [RING_DIVIDES_REFL, RING_SUB, RING_SUB_REFL, POLY_CONST,
                  RING_DIVIDES_0, POLY_VAR_UNIV] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    STRIP_TAC THEN MATCH_MP_TAC lemma THEN
    ASM_REWRITE_TAC [POLY_CONST, POLY_VAR_UNIV, POLY_EVAL]))

  let POLY_DIVIDES_X_MINUS_ROOT ← prove
   r"!r (a:A) p.
        a IN ring_carrier r /\
        p IN ring_carrier(poly_ring r (:1)) /\
        poly_eval r p a = ring_0 r
        ==> ring_divides (poly_ring r (:1))
                         (poly_sub r (poly_var r one) (poly_const r a)) p"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "p:(1->num)->A"]
      POLY_DIVIDES_X_MINUS_A) THEN
    ASM_SIMP_TAC [POLY_CLAUSES, POLY_CONST_0] THEN
    ASM_SIMP_TAC [RING_SUB_RZERO])

  let POLY_DIVIDES_X_MINUS_ROOT_EQ ← prove
   r"!r (a:A) p.
        a IN ring_carrier r /\
        p IN ring_carrier(poly_ring r (:1))
        ==> (ring_divides (poly_ring r (:1))
                          (poly_sub r (poly_var r one) (poly_const r a)) p <=>
             poly_eval r p a = ring_0 r)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [POLY_DIVIDES_X_MINUS_ROOT] THEN REWRITE_TAC [ring_divides] THEN
    REWRITE_TAC [POLY_RING_CLAUSES, IN_ELIM_THM, SUBSET_UNIV] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "q:(1->num)->A")
     (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
    ASM_SIMP_TAC [POLY_EVAL_MUL, POLY_EVAL_SUB, RING_POLYNOMIAL_VAR,
                  RING_POLYNOMIAL_CONST, POLY_EVAL_VAR, POLY_EVAL_CONST] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [POLY_CLAUSES]) THEN
    ASM_SIMP_TAC [RING_SUB_REFL, RING_MUL_LZERO, POLY_EVAL])

  let POLY_DEG_MUL_X_MINUS_A ← prove
   r"!r (a:A) (q:(1->num)->A).
      integral_domain r /\ a IN ring_carrier r /\
      q IN ring_carrier(poly_ring r (:1)) /\ ~(q = poly_0 r)
      ==> poly_deg r
           (poly_mul r (poly_sub r (poly_var r (one:1)) (poly_const r a)) q) =
          poly_deg r q + 1"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q "~trivial_ring (r:A ring)") ASSUME_TAC THENL
     [ASM_MESON_TAC [INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"poly_sub (r:A ring) (poly_var r (one:1))
                (poly_const r (a:A)):(1->num)->A",
      ← q "q:(1->num)->A"] POLY_DEG_MUL) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [POLY_X_MINUS_A_NONZERO,
        RING_POLYNOMIAL, RING_POLYNOMIAL_SUB,
        RING_POLYNOMIAL_VAR, RING_POLYNOMIAL_CONST],
      DISCH_THEN SUBST1_TAC THEN SUBGOAL_THEN (← q r"poly_deg (r:A ring)
           (poly_sub r (poly_var r (one:1)) (poly_const r (a:A))) = 1")
      SUBST1_TAC THENL
       [MATCH_MP_TAC POLY_DEG_X_MINUS_A THEN ASM_REWRITE_TAC [], ARITH_TAC]])

  let POLY_ROOT_BOUND ← prove
   r"!(r:A ring) p.
        integral_domain r /\
        p IN ring_carrier(poly_ring r (:1)) /\
        ~(p = ring_0 (poly_ring r (:1)))
        ==> FINITE {x | x IN ring_carrier r /\ poly_eval r p x = ring_0 r} /\
            CARD {x | x IN ring_carrier r /\ poly_eval r p x = ring_0 r}
            <= poly_deg r p"
   (← do
    -- right to left: the second ARITH_RULE, then the first
    let a2 ← ARITH_RULE (← q "q < q + 1")
    let a1 ← ARITH_RULE (← q "~(1 = 0)")
    pure (REPEAT GEN_TAC THEN WF_INDUCT_TAC (← q "poly_deg r (p:(1->num)->A)") THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q "r:A ring")) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    ASM_CASES_TAC
     (← q r"{x:A | x IN ring_carrier r /\ poly_eval r p x = ring_0 r} = {}") THEN
    ASM_REWRITE_TAC [CARD_CLAUSES, FINITE_EMPTY, LE_0] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "p:(1->num)->A"]
      POLY_DIVIDES_X_MINUS_ROOT) THEN
    ASM_REWRITE_TAC [ring_divides, POLY_CLAUSES] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q "q:(1->num)->A")
          (STRIP_ASSUME_TAC o GSYM))) THEN
    SUBGOAL_THEN (← q "~(q:(1->num)->A = ring_0 (poly_ring r (:1)))") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_MUL_RZERO], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q "poly_deg r (poly_sub r (poly_var r one) (poly_const r a):(1->num)->A) = 1")
    ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [POLY_RING_CLAUSES]) THEN
      ASM_SIMP_TAC [POLY_DEG_SUB, POLY_DEG_VAR, POLY_DEG_CONST, ARITH_EQ,
                    INTEGRAL_DOMAIN_NONTRIVIAL, POLY_RING_CLAUSES,
                    RING_POLYNOMIAL_VAR, RING_POLYNOMIAL_CONST] THEN
      CONV_TAC NUM_REDUCE_CONV,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q "poly_deg r (p:(1->num)->A) = poly_deg r (q:(1->num)->A) + 1")
    SUBST_ALL_TAC THENL
     [EXPAND_TAC "p" THEN ONCE_REWRITE_TAC [POLY_RING_CLAUSES] THEN
      wPart lhand (fun t => do lhand (← rand t)) POLY_DEG_MUL THEN
      ASM_REWRITE_TAC [POLY_CLAUSES, RING_POLYNOMIAL] THEN
      REWRITE_TAC [ADD_SYM] THEN DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [POLY_RING_CLAUSES] THEN
      ASM_MESON_TAC [POLY_DEG_0, a1],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "q:(1->num)->A"))] THEN
    ASM_REWRITE_TAC [a2] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{x:A | x IN ring_carrier r /\ poly_eval r p x = ring_0 r} =
      a INSERT {x | x IN ring_carrier r /\ poly_eval r q x = ring_0 r}")
    SUBST1_TAC THENL
     [SUBGOAL_THEN
       (← q r"!x. x IN ring_carrier r
            ==> (poly_eval r p x = ring_0 r <=>
                 poly_eval r q x = ring_0 r \/ x:A = a)")
      MP_TAC THENL [EXPAND_TAC "p", ASM SET_TAC []] THEN
      X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN REWRITE_TAC [POLY_RING_CLAUSES] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [POLY_RING_CLAUSES, IN_ELIM_THM]) THEN
      ASM_SIMP_TAC [POLY_EVAL_MUL, POLY_EVAL_SUB, RING_POLYNOMIAL_VAR,
                    RING_POLYNOMIAL_CONST, POLY_EVAL_VAR, POLY_EVAL_CONST] THEN
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_MUL_EQ_0, POLY_EVAL, RING_SUB,
                    RING_SUB_EQ_0] THEN
      REWRITE_TAC [DISJ_ACI],
      ASM_SIMP_TAC [FINITE_INSERT, CARD_CLAUSES] THEN ASM_ARITH_TAC]))

  let INFINITE_INTEGRAL_DOMAIN_POLY_EVAL_ALL_ZERO ← prove
   r"!r:A ring p.
        integral_domain r /\ INFINITE(ring_carrier r) /\
        p IN ring_carrier(poly_ring r (:1)) /\
        (!x. x IN ring_carrier r ==> poly_eval r p x = ring_0 r)
        ==> p = ring_0 (poly_ring r (:1))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q "(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "p:(1->num)->A"] POLY_ROOT_BOUND) THEN
      ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"{x:A | x IN ring_carrier r /\ poly_eval r p x = ring_0 r} =
      ring_carrier (r:A ring)")
      SUBST1_TAC THENL [REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
        ASM_MESON_TAC [], ALL_TAC] THEN
    STRIP_TAC THEN UNDISCH_TAC (← q "INFINITE(ring_carrier (r:A ring))") THEN
    ASM_REWRITE_TAC [INFINITE])

  -- @@RETURN BEGIN
  return { POLY_DEG_X_MINUS_A, POLY_X_MINUS_A_NONZERO, POLY_X_MINUS_A_IN_CARRIER,
           POLY_DIVIDES_X_MINUS_A, POLY_DIVIDES_X_MINUS_ROOT,
           POLY_DIVIDES_X_MINUS_ROOT_EQ, POLY_DEG_MUL_X_MINUS_A, POLY_ROOT_BOUND,
           INFINITE_INTEGRAL_DOMAIN_POLY_EVAL_ALL_ZERO }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- More general Euclidean division of univariate polynomials.                -/
/- (ringtheory.ml 24774-25321)                                               -/
/- ------------------------------------------------------------------------- -/

structure Division where
  -- @@FIELDS
  POLY_TOP_NONZERO : thm
  POLY_TOP_TAIL : thm
  POLY_TOP_EQ_0 : thm
  POLY_DEG_LT_FROM_LE : thm
  POLY_DEG_DIVIDES_LE_UNIVARIATE : thm
  POLY_DIVISION_GEN : thm
  POLY_DIVISION : thm
  EUCLIDEAN_POLY_RING : thm
  PID_POLY_RING : thm
  POLY_DEG_1_ROOT : thm
  poly_div : thm
  poly_rem : thm
  POLY_DIV_REM : thm
  POLY_DIV : thm
  RING_POLYNOMIAL_DIV : thm
  POLY_REM : thm
  RING_POLYNOMIAL_REM : thm
  POLY_DIV_REM_SIMP : thm
  POLY_DEG_REM : thm
  POLY_DEG_REM_ALT : thm
  POLY_DIVIDES_REM : thm
  POLY_REM_UNIQUE : thm
  deriving Inhabited

@[nospecialize]
def setupDivision [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BSums : Sums) (BDivides : Divides) (BDomains : Domains) (BRules : Rules) (BRingRule : RingRule) (BEuclidean : Euclidean) (BMonomials : Monomials) (BPowerSeries : PowerSeries) (BPolyRings : PolyRings) (BOneCoeff : OneCoeff) (BDegree : Degree) (BEvaluation : Evaluation) :
    ExceptT String IO Division := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC,
        new_definition, .. } := D
  let { ADD_CLAUSES, .. } := D.core1
  let { CONJ_SYM, CONTRAPOS_THM, EQ_IMP, .. } := D.core2
  let { FINITE_NUMSEG, FORALL_UNWIND_THM1, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, IN_NUMSEG, LE, LEFT_IMP_EXISTS_THM, LE_0, LE_1, LE_ADD, LE_TRANS,
        LT, .. } := D.core5
  let { MONO_EXISTS, NOT_LT, NUMSEG_SING, .. } := D.core6
  let { RIGHT_EXISTS_AND_THM, RIGHT_IMP_FORALL_THM, SUBSET_UNIV, SUB_ADD,
        SWAP_EXISTS_THM, SWAP_FORALL_THM, UNWIND_THM2, .. } := D.core7
  let { num_WF, .. } := D.core8
  let { RING_0, RING_ADD, RING_ADD_ASSOC, RING_ADD_LZERO, RING_ADD_RCANCEL,
        RING_ADD_RDISTRIB, RING_ADD_RZERO, RING_ADD_SYM, RING_MUL, RING_MUL_LZERO,
        RING_MUL_RZERO, RING_MUL_SYM, RING_SUB, RING_SUB_EQ_0, RING_SUB_RZERO,
        TRIVIAL_RING_10, trivial_ring, .. } := BBasics
  let { RING_POW, RING_POW_ADD, .. } := BNumbers
  let { RING_SUM, RING_SUM_CLAUSES_RIGHT, RING_SUM_SING, .. } := BSums
  let { RING_DIV, RING_DIVIDES_SUB, RING_INV, RING_MUL_RINV_EQ, RING_UNIT_0,
        RING_UNIT_IMP_REGULAR, ring_div, ring_divides, ring_regular, ring_zerodivisor, .. } := BDivides
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING, FIELD_UNIT,
        INTEGRAL_DOMAIN_MUL_EQ_0, .. } := BDomains
  let { RING_CARRIER_TAC, .. } := BRules
  let { RING_RULE, RING_TAC, .. } := BRingRule
  let { EUCLIDEAN_DOMAIN_IMP_PID, euclidean_ring, .. } := BEuclidean
  let { MONOMIAL_DEG_UNIVARIATE, .. } := BMonomials
  let { POLY_0, POLY_ADD_LZERO, POLY_CONST_0, POLY_MUL_0, RING_POLYNOMIAL_CONST,
        RING_POLYNOMIAL_IMP_POWERSERIES, RING_POLYNOMIAL_MUL, ring_polynomial,
        ring_powerseries, .. } := BPowerSeries
  let { POLY_CLAUSES, POLY_CONST, POLY_CONST_MUL, POLY_MONOMIAL_IN_CARRIER, POLY_RING,
        POLY_RING_CLAUSES, POLY_VAR_UNIV, RING_POLYNOMIAL, TRIVIAL_POLY_RING, .. } := BPolyRings
  let { COEFF, COEFF_IN_CARRIER_ALT, COEFF_POLY_0, EXISTS_FUN_FROM_1, coeff, .. } := BOneCoeff
  let { INTEGRAL_DOMAIN_POLY_RING, POLY_DEG_0, POLY_DEG_ADD, POLY_DEG_CONST,
        POLY_DEG_EQ_0, POLY_DEG_LE_COEFF_EQ, POLY_DEG_MONOMIAL_EXISTS, POLY_DEG_MUL,
        POLY_DEG_MUL_LE, POLY_DEG_MUL_UNIVARIATE, POLY_DEG_RING_SUB_LE,
        POLY_DEG_RING_SUM_LE, POLY_DEG_SUB_LE, POLY_DEG_VAR, POLY_DEG_VAR_POW, .. } := BDegree
  let { POLY_EVAL, POLY_EVAL_ADD, POLY_EVAL_CONST, POLY_EVAL_MUL, POLY_EVAL_VAR,
        POLY_EXPAND, .. } := BEvaluation
  -- @@SCOPE END

  let POLY_TOP_NONZERO ← prove
   r"!r (p:(1->num)->A).
        p IN ring_carrier(poly_ring r (:1)) /\ ~(p = ring_0(poly_ring r (:1)))
        ==> ~(coeff (poly_deg r p) p = ring_0 r)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "p:(1->num)->A"] POLY_DEG_MONOMIAL_EXISTS) THEN
    ASM_REWRITE_TAC [RING_POLYNOMIAL, POLY_CLAUSES, EXISTS_FUN_FROM_1] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN
    ASM_REWRITE_TAC [MONOMIAL_DEG_UNIVARIATE, UNWIND_THM2, ← GSYM COEFF])

  let POLY_TOP_TAIL ← prove
   r"!r (p:(1->num)->A).
        p IN ring_carrier(poly_ring r (:1)) /\ ~(p = ring_0(poly_ring r (:1)))
        ==> ?q. q IN ring_carrier(poly_ring r (:1)) /\
                (poly_deg r q < poly_deg r p \/
                 q = ring_0(poly_ring r (:1))) /\
                ring_add (poly_ring r (:1))
                         (ring_mul (poly_ring r (:1))
                                   (poly_const r (coeff (poly_deg r p) p))
                                   (ring_pow (poly_ring r (:1))
                                              (poly_var r one) (poly_deg r p)))
                         q = p"
   (← do
    -- right to left: the ARITH_RULE, then the MESON
    let ar ← ARITH_RULE (← q r"~(n = 0) /\ x <= n - 1 ==> x < n")
    let mm ← MESON [RING_ADD_SYM]
     (← q r"t IN ring_carrier r /\ q IN ring_carrier r /\ P q
      ==> ring_add r q t = p
       ==> ?q. q IN ring_carrier r /\ (P q \/ Q q) /\ ring_add r t q = p")
    pure (REPEAT STRIP_TAC THEN ABBREV_TAC (← q "n = poly_deg r (p:(1->num)->A)") THEN
    FIRST_ASSUM (MP_TAC o SYM o MATCH_MP POLY_EXPAND) THEN
    REWRITE_TAC [coeff] THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP POLY_MONOMIAL_IN_CARRIER) THEN
    ASM_CASES_TAC (← q "n = 0") THENL
     [ASM_REWRITE_TAC [NUMSEG_SING, RING_SUM_SING] THEN
      ASM_SIMP_TAC [RING_MUL, RING_POW, POLY_CONST, POLY_VAR_UNIV] THEN
      DISCH_THEN SUBST1_TAC THEN
      EXISTS_TAC (← q "ring_0(poly_ring r (:1)):(1->num)->A") THEN
      ASM_SIMP_TAC [RING_0, RING_ADD_RZERO],
      ASM_SIMP_TAC [RING_SUM_CLAUSES_RIGHT, LE_1, LE_0]] THEN
    ASM_SIMP_TAC [RING_MUL, RING_POW, POLY_CONST, POLY_VAR_UNIV] THEN
    MATCH_MP_TAC mm THEN
    ASM_SIMP_TAC [RING_SUM, RING_MUL, RING_POW, POLY_CONST, POLY_VAR_UNIV] THEN
    MATCH_MP_TAC ar THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC POLY_DEG_RING_SUM_LE THEN
    ASM_SIMP_TAC [RING_MUL, RING_POW, POLY_CONST, POLY_VAR_UNIV] THEN
    ASM_SIMP_TAC [FINITE_NUMSEG, IN_NUMSEG, LE_0] THEN
    X_GEN_TAC (← q "i:num") THEN DISCH_TAC THEN REWRITE_TAC [POLY_RING] THEN
    wPart lhand (fun t => do lhand (← rand t)) POLY_DEG_MUL_LE THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL, POLY_CONST, POLY_VAR_UNIV, RING_POW] THEN
