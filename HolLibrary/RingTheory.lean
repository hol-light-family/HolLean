       ==> (ring_localequiv r s (a,b) IN
            {ring_localequiv r s (a',b') | a',b' | a' IN p /\ b' IN s}
            <=> a IN p)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
    EQ_TAC THENL [REWRITE_TAC [LEFT_IMP_EXISTS_THM], ASM_MESON_TAC []] THEN
    MAP_EVERY X_GEN_TAC [← q "a':A", ← q "b':A"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    SUBGOAL_THEN (← q "(a':A) IN ring_carrier r") ASSUME_TAC THENL
     [ASM_MESON_TAC [prime_ideal, proper_ideal, ring_ideal, SUBSET],
      ASM_SIMP_TAC [← GSYM RING_LOCALEQUIV_EQUIV]] THEN
    ASM_SIMP_TAC [RING_LOCALEQUIV, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q "u:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q "(u:A) IN ring_carrier r") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_MULTSYS_IMP_SUBSET, SUBSET],
      ASM_SIMP_TAC [RING_SUB_LDISTRIB, RING_MUL, RING_SUB_EQ_0]] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(x IN p ==> a IN p) /\ y IN p ==> x = y ==> a IN p")) THEN
    ASM_SIMP_TAC [RING_MUL_IN_PRIME_IDEAL, RING_MUL] THEN ASM SET_TAC [])

  let PRIME_IDEAL_LOCALIZATION_CONTRACTION ← prove
   r"!r s (p:A->bool) x.
     ring_multsys r s /\ prime_ideal r p /\ p INTER s = {} /\
     x IN ring_carrier r
     ==> (ring_fractionate r s x IN
          {ring_localequiv r s (a,b) | a,b | a IN p /\ b IN s}
          <=> x IN p)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_fractionate] THEN
    MATCH_MP_TAC RING_LOCALEQUIV_IN_LOCALIZED_IDEAL THEN
    ASM_MESON_TAC [ring_multsys])

  let PRIME_IDEAL_LOCALIZATION ← prove
   r"!r s (p:A->bool).
     ring_multsys r s /\ prime_ideal r p /\ p INTER s = {}
     ==> prime_ideal (ring_localization r s)
          {ring_localequiv r s (a,b) | a,b | a IN p /\ b IN s}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [prime_ideal] THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [PROPER_IDEAL_LOCALIZATION, PRIME_IMP_RING_IDEAL],
      ASM_SIMP_TAC [RING_LOCALIZATION_CARRIER]] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q "a1:A", ← q "b1:A"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q "a2:A", ← q "b2:A"] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [RING_LOCALIZATION_MUL] THEN
    SUBGOAL_THEN (← q "ring_mul r b1 (b2:A) IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [ring_multsys],
      ASM_SIMP_TAC [RING_LOCALEQUIV_IN_LOCALIZED_IDEAL, RING_MUL]] THEN
    ASM_MESON_TAC [RING_MUL_IN_PRIME_IDEAL])

  let PRIME_IDEAL_LOCALIZATION_EXISTS ← prove
   r"!r (s:A->bool) q.
        ring_multsys r s /\
        prime_ideal (ring_localization r s) q
        ==> ?p. prime_ideal r p /\ p INTER s = {} /\
                q = {ring_localequiv r s (a,b) | a,b | a IN p /\ b IN s}"
   (← do
    let t1 ← TAUT (← q r"a /\ b /\ (a ==> c) ==> a /\ b /\ c")
    let ams ← ASSUME (← q r"ring_multsys r (s:A->bool)")
    pure (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"{a:A | a IN ring_carrier r /\ ring_fractionate r s a IN q}") THEN
    SUBGOAL_THEN (← q r"ring_ideal (ring_localization r (s:A->bool)) q") ASSUME_TAC THENL
     [ASM_MESON_TAC [prime_ideal, proper_ideal], ALL_TAC] THEN
    MATCH_MP_TAC t1 THEN
    REPEAT CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q "r:A ring", ← q r"ring_localization r (s:A->bool)",
                       ← q r"ring_fractionate r (s:A->bool)", ← q r"q:(A#A->bool)->bool"]
        PRIME_IDEAL_HOMOMORPHIC_PREIMAGE) THEN
      ASM_SIMP_TAC [RING_HOMOMORPHISM_FRACTIONATE] THEN
      REWRITE_TAC [ring_fractionate, ETA_AX],
      REWRITE_TAC [EXTENSION, IN_INTER, IN_ELIM_THM, NOT_IN_EMPTY] THEN
      X_GEN_TAC (← q "c:A") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:A->bool", ← q "c:A"] RING_UNIT_FRACTIONATE) THEN
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPEC (← q r"ring_localization r (s:A->bool)") PROPER_IDEAL_UNIT) THEN
      REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, IN_ELIM_THM, NOT_IN_EMPTY] THEN
      ASM_MESON_TAC [prime_ideal],
      DISCH_TAC] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"z:(A#A->bool)") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(z:(A#A->bool)) IN ring_carrier(ring_localization r s)")
      ASSUME_TAC THENL [ASM_MESON_TAC [ring_ideal, SUBSET], ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
       [← MATCH_MP RING_LOCALIZATION_CARRIER ams]) THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "a:A") (X_CHOOSE_THEN (← q "b:A") STRIP_ASSUME_TAC)) THEN
      MAP_EVERY EXISTS_TAC [← q "a:A", ← q "b:A"] THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"ring_fractionate r s (a:A) =
      ring_mul (ring_localization r (s:A->bool)) z (ring_fractionate r s b)")
        SUBST1_TAC THENL
      [ONCE_ASM_REWRITE_TAC [] THEN
       MATCH_MP_TAC (← GSYM LOCALEQUIV_MUL_LCANCEL) THEN ASM_REWRITE_TAC [],
       MATCH_MP_TAC (← ISPEC
        (← q r"ring_localization r (s:A->bool)") IN_RING_IDEAL_RMUL) THEN
       ASM_REWRITE_TAC [] THEN
       MATCH_MP_TAC RING_FRACTIONATE_IN_CARRIER THEN
       ASM_REWRITE_TAC [] THEN
       FIRST_X_ASSUM (MP_TAC o MATCH_MP RING_MULTSYS_IMP_SUBSET) THEN
       ASM SET_TAC []],
     REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
     X_GEN_TAC (← q r"z:(A#A->bool)") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
     SUBGOAL_THEN (← q "(b:A) IN ring_carrier r") ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP RING_MULTSYS_IMP_SUBSET) THEN ASM SET_TAC [],
      ALL_TAC] THEN
     SUBGOAL_THEN (← q r"ring_1 r IN (s:A->bool)") ASSUME_TAC THENL
      [MP_TAC (← CONJUNCT1 (← CONJUNCT2 RING_MULTSYS)) THEN
       DISCH_THEN (MP_TAC o SPECL [← q "r:A ring", ← q r"s:A->bool"]) THEN
       ASM_REWRITE_TAC [],
       ALL_TAC] THEN
     SUBGOAL_THEN (← q r"ring_localequiv r s (a:A,b) =
     ring_mul (ring_localization r (s:A->bool))
              (ring_localequiv r s (ring_1 r, b))
              (ring_fractionate r s a)") SUBST1_TAC THENL
      [REWRITE_TAC [ring_fractionate] THEN
       ASM_SIMP_TAC [RING_LOCALIZATION_MUL, RING_1] THEN
       SUBGOAL_THEN
         (← q r"ring_localequiv r s
         (ring_mul r (ring_1 r) a, ring_mul r b (ring_1 r)) (a:A, b)")
       MP_TAC THENL
       [ASM_SIMP_TAC [RING_LOCALEQUIV, RING_MUL, RING_1] THEN
        ASM_SIMP_TAC [RING_MUL_LID, RING_MUL_RID, RING_MUL] THEN
        EXISTS_TAC (← q "ring_1 r:A") THEN ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [RING_SUB_REFL, RING_MUL, RING_MUL_RZERO, RING_1],
        DISCH_TAC THEN FIRST_ASSUM (MP_TAC o REWRITE_RULE
         [← MATCH_MP RING_LOCALEQUIV_SYM ams]) THEN
        ASM_SIMP_TAC [RING_LOCALEQUIV_EQUIV, RING_MUL, RING_1, RING_MULTSYS]],
       MATCH_MP_TAC (← ISPEC (← q r"ring_localization r (s:A->bool)")
          IN_RING_IDEAL_LMUL) THEN
       ASM_REWRITE_TAC [] THEN
       ASM_SIMP_TAC [RING_LOCALEQUIV_IN_CARRIER, RING_1]]]))

  let RING_LOCALIZATION_PRIME_IDEAL_CORRESPONDENCE ← prove
   r"!r:A ring s Q.
      ring_multsys r s
      ==> (prime_ideal (ring_localization r s) Q <=>
           ?p. prime_ideal r p /\ p INTER s = {} /\
               {x | x IN ring_carrier r /\ ring_fractionate r s x IN Q} = p /\
               {ring_localequiv r s (a,b) | a,b | a IN p /\ b IN s} = Q)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:A->bool", ← q r"Q:(A#A->bool)->bool"]
                    PRIME_IDEAL_LOCALIZATION_EXISTS) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"p:A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q "ring_ideal (r:A ring) p") ASSUME_TAC THENL
       [ASM_MESON_TAC [PRIME_IMP_RING_IDEAL], ALL_TAC] THEN
      GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q "x:A") THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:A->bool", ← q r"p:A->bool", ← q "x:A"]
                    PRIME_IDEAL_LOCALIZATION_CONTRACTION) THEN
      ASM_CASES_TAC (← q "(x:A) IN ring_carrier r") THENL
       [ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_ELIM_THM]) THEN ASM_REWRITE_TAC [],
        REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [PRIME_IDEAL_IMP_SUBSET, SUBSET]],
      STRIP_TAC THEN EXPAND_TAC "Q" THEN
      MATCH_MP_TAC PRIME_IDEAL_LOCALIZATION THEN ASM_REWRITE_TAC []])

  -- @@RETURN BEGIN
  return { UFD, UFD_IMP_INTEGRAL_DOMAIN, PID_IMP_UFD, FIELD_IMP_UFD,
           ISOMORPHIC_RING_UFDNESS, UFD_EQ_PRIMEFACT, UFD_EQ_PRIMEFACT_NONUNIT,
           UFD_PRIME_FACTOR_EXISTS, UFD_IRREDUCIBLE_EQ_PRIME, UFD_EQ_ATOMIC,
           UFD_EQ_ATOMIC_NONUNIT, UFD_EQ_UNIQUE_FACTORIZATION, UFD_COPRIME,
           UFD_PRIME_FACTOR_INDUCT, UFD_IMP_GCD_EXISTS, PID_EQ_UFD_PRIME_MAXIMAL,
           RING_DIVIDES_LOCALEQUIV, UFD_LOCALIZATION, PROPER_IDEAL_LOCALIZATION,
           RING_LOCALEQUIV_IN_LOCALIZED_IDEAL, PRIME_IDEAL_LOCALIZATION_CONTRACTION,
           PRIME_IDEAL_LOCALIZATION, PRIME_IDEAL_LOCALIZATION_EXISTS,
           RING_LOCALIZATION_PRIME_IDEAL_CORRESPONDENCE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Euclidean rings.  (ringtheory.ml 14178-14458)                             -/
/- ------------------------------------------------------------------------- -/

structure Euclidean where
  -- @@FIELDS
  euclidean_ring : thm
  EUCLIDEAN_RING : thm
  EUCLIDEAN_RING_ALT : thm
  EUCLIDEAN_IMP_PRINCIPAL_IDEAL_RING : thm
  EUCLIDEAN_DOMAIN_IMP_PID : thm
  EUCLIDEAN_RING_UNIVERSAL_SIDE_DIVISOR : thm
  EUCLIDEAN_RING_EPIMORPHIC_IMAGE : thm
  EUCLIDEAN_QUOTIENT_RING : thm
  ISOMORPHIC_RING_EUCLIDEANNESS : thm
  deriving Inhabited

@[nospecialize]
def setupEuclidean [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BIso : Iso) (BQuotients : Quotients) (BSpecialIdeals : SpecialIdeals) :
    ExceptT String IO Euclidean := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, SET_TAC, new_definition, .. } := D
  let { CONJ_ASSOC, DE_MORGAN_THM, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, .. } := D.core2
  let { FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_EQ_EMPTY, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.core4
  let { IN_DELETE, IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM, LET_TRANS, LE_REFL, .. } := D.core5
  let { MEMBER_NOT_EMPTY, MINIMAL, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, NOT_LE, NOT_LT, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM_EQ, .. } := D.core7
  let { num_WOP, o_THM, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_ASSOC, RING_ADD_LDISTRIB, RING_ADD_LNEG,
        RING_ADD_LZERO, RING_ADD_RNEG, RING_ADD_RZERO, RING_ADD_SYM, RING_EQ_SUB_LADD,
        RING_EQ_SUB_RADD, RING_MUL, RING_MUL_ASSOC, RING_MUL_LZERO, RING_MUL_RID,
        RING_NEG, RING_NEG_ADD, RING_NEG_NEG, RING_SUB, RING_SUB_EQ_0, TRIVIAL_RING_10,
        ring_sub, .. } := BBasics
  let { RING_DIVIDES_REFL, RING_DIVIDES_RMUL, ring_divides, .. } := BDivides
  let { IDEAL_GENERATED_MINIMAL_EQ, IDEAL_GENERATED_SING_ALT, IN_RING_IDEAL_0,
        IN_RING_IDEAL_ADD, IN_RING_IDEAL_NEG, IN_RING_IDEAL_RMUL,
        RING_IDEAL_IMP_SUBSET, .. } := BIdeals
  let { FIELD_EQ_ALL_UNITS, .. } := BDomains
  let { RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_MUL,
        RING_ISOMORPHISMS_ISOMORPHISM, RING_ISOMORPHISM_IMP_EPIMORPHISM,
        ring_epimorphism, ring_isomorphism, .. } := BHoms
  let { isomorphic_ring, .. } := BIso
  let { RING_EPIMORPHISM_RING_COSET, .. } := BQuotients
  let { PID, PRINCIPAL_IDEAL_0, principal_ideal, .. } := BSpecialIdeals
  -- @@SCOPE END

  let euclidean_ring ← new_definition
   r"euclidean_ring r <=>
        ?n:A->num.
            !a b. a IN ring_carrier r /\ b IN ring_carrier r /\ ~(b = ring_0 r)
                  ==> ?q t. q IN ring_carrier r /\ t IN ring_carrier r /\
                            ring_add r (ring_mul r b q) t = a /\
                            (t = ring_0 r \/ n(t) < n(b))"

  let EUCLIDEAN_RING ← prove
   r"!r:A ring.
        euclidean_ring r <=>
        ?n:A->num.
            !a b. a IN ring_carrier r /\ b IN ring_carrier r /\
                  ~(b = ring_0 r) /\ n(b) <= n(a)
                  ==> ?q. q IN ring_carrier r /\
                          (ring_mul r b q = a \/
                           n(ring_sub r a (ring_mul r b q)) < n a)"
   (← do
    let t3 ← TAUT (← q r"p ==> ~q <=> q ==> ~p")
    let m2 ← MESON [] (← q r"(!x. ~(P x /\ a = f x)) <=> !x. P x ==> ~(f x = a)")
    let a1 ← ARITH_RULE (← q r"t:num < b ==> b <= a /\ u = t ==> u < a")
    pure (GEN_TAC THEN REWRITE_TAC [euclidean_ring] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"n:A->num") THEN
    REWRITE_TAC [] THEN EQ_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q "a:A", ← q "b:A"]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q "q:A") THEN DISCH_THEN (X_CHOOSE_THEN (← q "t:A") MP_TAC) THEN
      REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_CASES_TAC (← q "t:A = ring_0 r") THEN
      ASM_SIMP_TAC [RING_MUL, RING_ADD_RZERO] THEN
      STRIP_TAC THEN DISJ2_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP a1) THEN
      ASM_REWRITE_TAC [] THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [RING_EQ_SUB_RADD, RING_MUL] THEN
      ASM_MESON_TAC [RING_ADD_SYM, RING_MUL],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q "ring_divides r b (a:A)") THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_divides]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      REPEAT STRIP_TAC THEN EXISTS_TAC (← q "ring_0 r:A") THEN
      ASM_SIMP_TAC [RING_0, RING_ADD_RZERO, RING_MUL],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [ring_divides]) THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM, m2] THEN
      DISCH_TAC] THEN
    MP_TAC (← EQ_IMP_RULE (← SPEC
     (← q r"\m. m IN IMAGE (n:A->num)
              {ring_sub r a (ring_mul r b q) | q | q IN ring_carrier r}")
     num_WOP)).1 THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, EXISTS_IN_GSPEC] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ONCE_REWRITE_TAC [t3] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_GSPEC, NOT_LT] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "q:A") THEN STRIP_TAC THEN
    EXISTS_TAC (← q "ring_sub r a (ring_mul r b q):A") THEN
    ASM_SIMP_TAC [← GSYM RING_EQ_SUB_LADD, RING_MUL, RING_SUB] THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [ring_sub, RING_NEG_ADD, RING_NEG, RING_MUL, RING_NEG_NEG,
                    RING_ADD_ASSOC, RING_ADD_RNEG, RING_ADD_LZERO],
      DISJ2_TAC THEN REWRITE_TAC [← GSYM NOT_LE] THEN DISCH_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "ring_sub r a (ring_mul r b q):A", ← q "b:A"]) THEN
    ASM_SIMP_TAC [RING_MUL, RING_SUB, RING_SUB_EQ_0] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "p:A") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [DE_MORGAN_THM] THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [RING_EQ_SUB_LADD, RING_MUL, ← GSYM RING_ADD_LDISTRIB] THEN
      ASM_SIMP_TAC [RING_ADD],
      ASM_SIMP_TAC [ring_sub, ← GSYM RING_NEG_ADD, ← GSYM RING_ADD_ASSOC,
                    RING_NEG, RING_MUL, ← GSYM RING_ADD_LDISTRIB, NOT_LT] THEN
      ASM_SIMP_TAC [← GSYM ring_sub, RING_ADD]]))

  let EUCLIDEAN_RING_ALT ← prove
   r"!r:A ring.
        euclidean_ring r <=>
         ?n:A->num.
           (!a b. ring_divides r a b /\ (b = ring_0 r ==> a = ring_0 r)
                  ==> n(a) <= n(b)) /\
           (!a b. a IN ring_carrier r /\ b IN ring_carrier r /\ ~(b = ring_0 r)
                   ==> ?q t. q IN ring_carrier r /\ t IN ring_carrier r /\
                            ring_add r (ring_mul r b q) t = a /\
                            (t = ring_0 r \/ n(t) < n(b)))"
   (← do
    let t4 ← TAUT (← q r"p \/ q ==> p \/ ~p /\ q")
    let t3 ← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")
    let t2 ← TAUT (← q r"p ==> ~q <=> q ==> ~p")
    let t1 ← TAUT (← q r"p <=> p /\ T")
    pure (GEN_TAC THEN REWRITE_TAC [euclidean_ring] THEN
    EQ_TAC THENL [ALL_TAC, MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC []] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"n:A->num")) THEN
    ASSUME_TAC (← ISPEC (← q "r:A ring") RING_0) THEN
    SUBGOAL_THEN
     (← q r"!a. a IN ring_carrier r /\ ~(a = ring_0 r)
        ==> ?m. m IN { (n:A->num) (ring_mul r a b) | b |
                       b IN ring_carrier r /\ ~(ring_mul r a b = ring_0 r)}")
    MP_TAC THENL
     [X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
      GEN_REWRITE_TAC BINDER_CONV [t1] THEN
      PURE_REWRITE_TAC [EXISTS_IN_GSPEC] THEN EXISTS_TAC (← q "ring_1 r:A") THEN
      ASM_SIMP_TAC [RING_MUL_RID, RING_1],
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV o RAND_CONV) [num_WOP]] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [t2] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, LEFT_IMP_EXISTS_THM, SKOLEM_THM, NOT_LT] THEN
    REWRITE_TAC [FORALL_AND_THM, t3] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    X_GEN_TAC (← q r"dd:A->A") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(n:A->num) o (\x. ring_mul r x (dd x))") THEN
    REWRITE_TAC [o_THM] THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN
      REWRITE_TAC [ring_divides, LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
      DISCH_TAC THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN X_GEN_TAC (← q "c:A") THEN
      DISCH_TAC THEN DISCH_THEN SUBST1_TAC THEN
      ASM_CASES_TAC (← q "a:A = ring_0 r") THEN
      ASM_SIMP_TAC [RING_MUL_LZERO, LE_REFL] THEN DISCH_TAC THEN
      ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, RING_MUL] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [RING_MUL_ASSOC, RING_MUL],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
    UNDISCH_THEN
     (← q r"!a b. a IN ring_carrier r /\ b IN ring_carrier r /\ ~(b = ring_0 r)
          ==> (?q t.
                   q IN ring_carrier r /\
                   t IN ring_carrier r /\
                   ring_add r (ring_mul r b q) t = a /\
                   (t = ring_0 r \/ (n:A->num) t < n b))")
     (MP_TAC o SPECL [← q "a:A", ← q "ring_mul r b (dd b):A"]) THEN
    ASM_SIMP_TAC [RING_MUL, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "q:A", ← q "t:A"] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MAP_EVERY EXISTS_TAC [← q r"ring_mul r ((dd:A->A) b) q", ← q "t:A"] THEN
    ASM_SIMP_TAC [RING_MUL_ASSOC, RING_MUL] THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o MATCH_MP t4) THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] LET_TRANS)) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "t:A", ← q "ring_1 r:A"]) THEN
    ASM_SIMP_TAC [RING_MUL_RID, RING_1]))

  let EUCLIDEAN_IMP_PRINCIPAL_IDEAL_RING ← prove
   r"!r j:A->bool. euclidean_ring r /\ ring_ideal r j ==> principal_ideal r j"
   (← do
    let t3 ← TAUT (← q r"p ==> ~p ==> q")
    let t2 ← TAUT (← q r"p ==> ~q <=> q ==> ~p")
    let t1 ← TAUT (← q r"p /\ (q ==> r) ==> (p <=> q) ==> r")
    pure (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [euclidean_ring]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"n:A->num")) THEN
    ASM_CASES_TAC (← q "j = {ring_0 r:A}") THEN ASM_REWRITE_TAC [PRINCIPAL_IDEAL_0] THEN
    MP_TAC (← SPEC (← q r"\m. m IN IMAGE (n:A->num) (j DELETE ring_0 r)") num_WOP) THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, MEMBER_NOT_EMPTY, IMAGE_EQ_EMPTY] THEN
    MATCH_MP_TAC t1 THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q "r:A ring", ← q r"j:A->bool"] IN_RING_IDEAL_0) THEN ASM SET_TAC [],
      ONCE_REWRITE_TAC [t2]] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_DELETE, principal_ideal] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "b:A") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q "(b:A) IN ring_carrier r") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_IDEAL_IMP_SUBSET, SUBSET], ASM_REWRITE_TAC []] THEN
    ASM_SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, IDEAL_GENERATED_MINIMAL_EQ] THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [SUBSET]] THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q "(a:A) IN ring_carrier r") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_IDEAL_IMP_SUBSET, SUBSET], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "a:A", ← q "b:A"]) THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_SING_ALT, IN_ELIM_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "q:A") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "t:A") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_CASES_TAC (← q "t:A = ring_0 r") THEN
    ASM_SIMP_TAC [RING_MUL, RING_ADD_RZERO] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "t:A")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC t3 THEN
    SUBGOAL_THEN (← q r"t = ring_add r (ring_neg r (ring_mul r b q))
                               (ring_add r (ring_mul r b q) t):A")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM ((fun (_ : thm) => ALL_TAC) o SYM) THEN
      ASM_SIMP_TAC [RING_ADD_ASSOC, RING_ADD_LNEG, RING_MUL, RING_NEG,
                    RING_ADD_LZERO],
      MATCH_MP_TAC IN_RING_IDEAL_ADD THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC IN_RING_IDEAL_NEG THEN ASM_SIMP_TAC [IN_RING_IDEAL_RMUL]]))

  let EUCLIDEAN_DOMAIN_IMP_PID ← prove
   r"!r:A ring. integral_domain r /\ euclidean_ring r ==> PID r"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [PID] THEN
    ASM_SIMP_TAC [EUCLIDEAN_IMP_PRINCIPAL_IDEAL_RING])

  let EUCLIDEAN_RING_UNIVERSAL_SIDE_DIVISOR ← prove
   r"!r:A ring.
        euclidean_ring r /\ ~trivial_ring r /\ ~field r
        ==> ?a. a IN ring_carrier r /\ ~(a = ring_0 r) /\ ~(ring_unit r a) /\
                !b. b IN ring_carrier r
                    ==> ?u. (ring_unit r u \/ u = ring_0 r) /\
                            ring_divides r a (ring_sub r b u)"
   (SIMP_TAC [IMP_CONJ, FIELD_EQ_ALL_UNITS, TRIVIAL_RING_10] THEN
    GEN_TAC THEN DISCH_TAC THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [euclidean_ring]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"n:A->num")) THEN
    MP_TAC (← EQ_IMP_RULE (← ISPEC
     (← q r"\m. m IN IMAGE (n:A->num)
                   {x | x IN ring_carrier r /\
                        ~(x = ring_0 r) /\ ~ring_unit r x}")
     num_WOP)).1 THEN
    REWRITE_TAC [EXISTS_IN_IMAGE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "a:A") THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p ==> ~q <=> q ==> ~p")] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM, NOT_LT] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q "b:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "b:A", ← q "a:A"]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "q:A") MP_TAC) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "u:A") THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (SUBST1_TAC o SYM) MP_TAC) THEN
    ASM_SIMP_TAC [ring_sub, ← GSYM RING_ADD_ASSOC, RING_MUL, RING_NEG,
                  RING_ADD_RNEG, RING_ADD_RZERO] THEN
    ASM_SIMP_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_REFL] THEN
    ASM_CASES_TAC (← q "u:A = ring_0 r") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [NOT_LT])

  let EUCLIDEAN_RING_EPIMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B).
        ring_epimorphism(r,r') f /\ euclidean_ring r ==> euclidean_ring r'"
   (← do
    let t2 ← TAUT (← q r"p ==> ~q <=> q ==> ~p")
    let t1 ← TAUT (← q r"p ==> ~q <=> q ==> ~p")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [ring_epimorphism, euclidean_ring] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, EXISTS_IN_IMAGE] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, RIGHT_AND_EXISTS_THM] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:A->num") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\y. minimal p.
    p IN IMAGE n {x | x IN ring_carrier r /\ (f:A->B) x = y}") THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
    MP_TAC (← REWRITE_RULE [] (← EQ_IMP_RULE (← ISPEC
     (← q r"\p:num. p IN IMAGE n {x | x IN ring_carrier r /\ (f:A->B) x = f b}")
     MINIMAL)).1) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC []] THEN
    SPEC_TAC
     (← q r"minimal p. p IN IMAGE n {x | x IN ring_carrier r /\ (f:A->B) x = f b}",
      ← q "c:num") THEN
    ONCE_REWRITE_TAC [t1] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, IN_ELIM_THM, NOT_LT] THEN
    X_GEN_TAC (← q "b':A") THEN DISCH_TAC THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q "b:A")) THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "a:A", ← q "b':A"]) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_0], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "q:A") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "t:A") (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC)) THEN
    MP_TAC (← REWRITE_RULE [] (← EQ_IMP_RULE (← ISPEC
     (← q r"\p:num. p IN IMAGE n {x | x IN ring_carrier r /\ (f:A->B) x = f t}")
     MINIMAL)).1) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC []] THEN
    ABBREV_TAC
     (← q r"v = minimal p.
          p IN IMAGE n {x | x IN ring_carrier r /\ (f:A->B) x = f t}") THEN
    ONCE_REWRITE_TAC [t2] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM, NOT_LT] THEN
    GEN_REWRITE_TAC id [IMP_CONJ] THEN REWRITE_TAC [IN_IMAGE, IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "t':A")
     (CONJUNCTS_THEN2 SUBST_ALL_TAC STRIP_ASSUME_TAC)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q "t:A")) THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    EXISTS_TAC (← q "t':A") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_IMAGE, IN_ELIM_THM]) THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_ADD, RING_MUL],
      ALL_TAC] THEN
    FIRST_X_ASSUM DISJ_CASES_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_0], ASM_MESON_TAC [LET_TRANS]]))

  let EUCLIDEAN_QUOTIENT_RING ← prove
   r"!r j:A->bool.
        euclidean_ring r /\ ring_ideal r j
        ==> euclidean_ring (quotient_ring r j)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EUCLIDEAN_RING_EPIMORPHIC_IMAGE) THEN
    ASM_MESON_TAC [RING_EPIMORPHISM_RING_COSET])

  let ISOMORPHIC_RING_EUCLIDEANNESS ← prove
   r"!(r:A ring) (r':B ring).
        r isomorphic_ring r' ==> (euclidean_ring r <=> euclidean_ring r')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [isomorphic_ring] THEN
    REWRITE_TAC [ring_isomorphism, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [RING_ISOMORPHISMS_ISOMORPHISM] THEN REPEAT STRIP_TAC THEN
    ASM_MESON_TAC [EUCLIDEAN_RING_EPIMORPHIC_IMAGE,
                   RING_ISOMORPHISM_IMP_EPIMORPHISM])

  -- @@RETURN BEGIN
  return { euclidean_ring, EUCLIDEAN_RING, EUCLIDEAN_RING_ALT,
           EUCLIDEAN_IMP_PRINCIPAL_IDEAL_RING, EUCLIDEAN_DOMAIN_IMP_PID,
           EUCLIDEAN_RING_UNIVERSAL_SIDE_DIVISOR, EUCLIDEAN_RING_EPIMORPHIC_IMAGE,
           EUCLIDEAN_QUOTIENT_RING, ISOMORPHIC_RING_EUCLIDEANNESS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- A bit more about Noetherian rings.  (ringtheory.ml 14459-14761)          -/
/- ------------------------------------------------------------------------- -/

structure Noetherian where
  -- @@FIELDS
  NOETHERIAN_RING : thm
  NOETHERIAN_RING_EQ_ACC : thm
  NOETHERIAN_RING_EQ_MAXIMAL : thm
  NOETHERIAN_RING_EPIMORPHIC_IMAGE : thm
  NOETHERIAN_QUOTIENT_RING : thm
  ISOMORPHIC_RING_NOETHERIANNESS : thm
  NOETHERIAN_PROD_RING : thm
  NOETHERIAN_PRODUCT_RING : thm
  NOETHERIAN_RING_EQ_FG_PRIME_IDEALS : thm
  NOETHERIAN_RING_LOCALIZATION : thm
  deriving Inhabited

@[nospecialize]
def setupNoetherian [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BIdeals : Ideals) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BProdRings : ProdRings) (BQuotients : Quotients) (BSpecialIdeals : SpecialIdeals) (BUFDs : UFDs) :
    ExceptT String IO Noetherian := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ADD1, CARTESIAN_PRODUCT_EQ, CARTESIAN_PRODUCT_EQ_EMPTY, .. } := D.core1
  let { CONTRAPOS_THM, DEPENDENT_CHOICE, DE_MORGAN_THM, EMPTY_SUBSET, EXISTS_IN_IMAGE, .. } := D.core2
  let { FINITE_CARTESIAN_PRODUCT, FINITE_CROSS, FINITE_EMPTY, FINITE_IMAGE,
        FINITE_INSERT, FINITE_RULES, FINITE_SUBSET, FINITE_SUBSET_UNIONS_CHAIN,
        FINITE_UNION, FINITE_UNIONS, FORALL_AND_THM, FORALL_IN_IMAGE,
        FORALL_IN_IMAGE_2, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INFINITE, INSERT_SUBSET, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_ELIM_THM, IN_INSERT, IN_UNION, IN_UNIV,
        LEFT_IMP_EXISTS_THM, LE_CASES, .. } := D.core5
  let { MEMBER_NOT_EMPTY, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_INSERT_EMPTY,
        PSUBSET, PSUBSET_ALT, .. } := D.core6
  let { RESTRICTION, RESTRICTION_IN_CARTESIAN_PRODUCT, RIGHT_IMP_EXISTS_THM,
        SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ,
        SUBSET_CARTESIAN_PRODUCT, SUBSET_CROSS, SUBSET_RESTRICT, SUBSET_TRANS,
        TRANSITIVE_STEPWISE_LE, UNIONS_GSPEC, UNION_SUBSET, WF, WF_DCHAIN, .. } := D.core7
  let { ZL_SUBSETS_UNIONS_NONEMPTY, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_LZERO, RING_MUL, RING_MUL_RZERO, RING_NEG,
        RING_NEG_0, TRIVIAL_RING_10, trivial_ring, .. } := BBasics
  let { IDEAL_GENERATED_INC_GEN, IDEAL_GENERATED_INDUCT, IDEAL_GENERATED_INSERT_ZERO,
        IDEAL_GENERATED_MINIMAL, IDEAL_GENERATED_MINIMAL_EQ, IDEAL_GENERATED_MONO,
        IDEAL_GENERATED_SUBSET_CARRIER_SUBSET, RING_IDEAL_IDEAL_GENERATED,
        RING_IDEAL_UNIONS, ring_ideal, .. } := BIdeals
  let { IDEAL_GENERATED_BY_EPIMORPHIC_IMAGE, RING_ISOMORPHISM_IMP_EPIMORPHISM,
        ring_epimorphism, .. } := BHoms
  let { ISOMORPHIC_RING_SYM, isomorphic_ring, .. } := BIso
  let { RING_EPIMORPHISM_IDEAL_CORRESPONDENCE, .. } := BKernels
  let { IDEAL_GENERATED_CARTESIAN_PRODUCT, IDEAL_GENERATED_CROSS, PRODUCT_RING,
        PROD_RING, RING_EPIMORPHISM_FST, RING_EPIMORPHISM_PRODUCT_PROJECTION,
        RING_EPIMORPHISM_SND, RING_IDEAL_PRODUCT_RING, RING_IDEAL_PROD_RING, .. } := BProdRings
  let { RING_EPIMORPHISM_RING_COSET, .. } := BQuotients
  let { FINITELY_GENERATED_IDEAL_LOCALIZATION, MAXIMAL_NONFG_IMP_PRIME_IDEAL,
        PRIME_IMP_RING_IDEAL, PROPER_IDEAL, finitely_generated_ideal, noetherian_ring, .. } := BSpecialIdeals
  let { RING_LOCALIZATION_PRIME_IDEAL_CORRESPONDENCE, .. } := BUFDs
  -- @@SCOPE END

  let NOETHERIAN_RING ← prove
   r"!r:A ring.
        noetherian_ring r <=>
        WF(\j j'. ring_ideal r j /\ ring_ideal r j' /\ j' PSUBSET j)"
   (← do
    -- right to left: the second MESON, the first, the SET_RULEs, the TAUTs
    let m6 ← MESON [LE_CASES]
     (← q r"(!m n. m <= n ==> (s:num->A->bool) m SUBSET s n)
        ==> !m n. s m SUBSET s n \/ s n SUBSET s m")
    let m5 ← MESON [LE_CASES]
     (← q r"(!m n. m <= n ==> (s:num->A->bool) m SUBSET s n)
        ==> !m n. s m SUBSET s n \/ s n SUBSET s m")
    let s4 ← SET_RULE (← q r"s SUBSET a INSERT s")
    let s3 ← SET_RULE (← q r"~(s SUBSET t) <=> ?x. x IN s /\ ~(x IN t)")
    let t2 ← TAUT (← q r"(p /\ q) /\ (~r ==> s) ==> ~(p /\ q /\ r) ==> s")
    let t1 ← TAUT (← q r"(~p ==> ~q) /\ (p ==> q) ==> (p <=> q)")
    pure (GEN_TAC THEN MATCH_MP_TAC t1 THEN
    CONJ_TAC THENL
     [REWRITE_TAC [noetherian_ring, WF_DCHAIN, NOT_FORALL_THM, NOT_IMP] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"j:A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"?s:num->A->bool.
        (!n. FINITE(s n) /\ s n SUBSET j) /\
        (!n. ideal_generated r (s n) PSUBSET ideal_generated r (s(SUC n)))")
      STRIP_ASSUME_TAC THENL
       [ALL_TAC,
        EXISTS_TAC (← q r"\n. ideal_generated r ((s:num->A->bool) n)") THEN
        ASM_REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED]] THEN
      MATCH_MP_TAC DEPENDENT_CHOICE THEN
      CONJ_TAC THENL [MESON_TAC [EMPTY_SUBSET, FINITE_RULES], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q "n:num", ← q r"k:A->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE RAND_CONV [finitely_generated_ideal]) THEN
      REWRITE_TAC [NOT_EXISTS_THM, ← GSYM SUBSET_ANTISYM_EQ] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"k:A->bool")) THEN
      ASM_SIMP_TAC [IDEAL_GENERATED_MINIMAL_EQ] THEN
      MATCH_MP_TAC t2 THEN
      CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [ring_ideal]) THEN ASM SET_TAC [],
        REWRITE_TAC [s3]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "a:A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q "(a:A) INSERT k") THEN
      ASM_REWRITE_TAC [FINITE_INSERT, INSERT_SUBSET] THEN
      SIMP_TAC [PSUBSET_ALT, IDEAL_GENERATED_MONO, s4] THEN
      EXISTS_TAC (← q "a:A") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC IDEAL_GENERATED_INC_GEN THEN
      RULE_ASSUM_TAC (REWRITE_RULE [ring_ideal]) THEN ASM SET_TAC [],
      REWRITE_TAC [noetherian_ring, WF_DCHAIN, FORALL_AND_THM] THEN
      DISCH_TAC THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:num->A->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"UNIONS (IMAGE (s:num->A->bool) (:num))")) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC RING_IDEAL_UNIONS THEN
        CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, IN_UNIV] THEN
        MATCH_MP_TAC m5 THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM SET_TAC [],
        REWRITE_TAC [finitely_generated_ideal, NOT_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"k:A->bool") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"IMAGE (s:num->A->bool) (:num)", ← q r"k:A->bool"]
          FINITE_SUBSET_UNIONS_CHAIN) THEN
      ASM_REWRITE_TAC [EXISTS_IN_IMAGE, FORALL_IN_IMAGE_2, IN_UNIV, NOT_IMP] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [IDEAL_GENERATED_SUBSET_CARRIER_SUBSET],
        SET_TAC [],
        MATCH_MP_TAC m6 THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM SET_TAC [],
        DISCH_THEN (X_CHOOSE_TAC (← q "m:num")) THEN
        SUBGOAL_THEN (← q r"(s:num->A->bool) (SUC m) SUBSET s(m)")
        MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        TRANS_TAC SUBSET_TRANS (← q r"ideal_generated r k:A->bool") THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC IDEAL_GENERATED_MINIMAL THEN ASM_REWRITE_TAC []]]))

  let NOETHERIAN_RING_EQ_ACC ← prove
   r"!r:A ring.
        noetherian_ring r <=>
        ~(?j. (!n. ring_ideal r (j n)) /\
              (!n. j n PSUBSET j(n + 1)))"
   (REWRITE_TAC [NOETHERIAN_RING, WF_DCHAIN, ADD1] THEN MESON_TAC [])

  let NOETHERIAN_RING_EQ_MAXIMAL ← prove
   r"!r:A ring.
        noetherian_ring r <=>
        !u. ~(u = {}) /\ (!j. j IN u ==> ring_ideal r j)
            ==> ?k. k IN u /\ !j. j IN u ==> ~(k PSUBSET j)"
   (GEN_TAC THEN REWRITE_TAC [NOETHERIAN_RING, WF] THEN
    AP_TERM_TAC THEN ABS_TAC THEN ASM SET_TAC [])

  let NOETHERIAN_RING_EPIMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B).
        ring_epimorphism(r,r') f /\ noetherian_ring r
        ==> noetherian_ring r'"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [noetherian_ring] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP RING_EPIMORPHISM_IDEAL_CORRESPONDENCE th])) THEN
    X_GEN_TAC (← q r"k:B->bool") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"j:A->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:A->bool") o REWRITE_RULE [noetherian_ring]) THEN
    ASM_REWRITE_TAC [finitely_generated_ideal] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) s") THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
    CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [ring_epimorphism]) THEN ASM SET_TAC [],
      ASM_MESON_TAC [IDEAL_GENERATED_BY_EPIMORPHIC_IMAGE]])

  let NOETHERIAN_QUOTIENT_RING ← prove
   r"!r j:A->bool.
        noetherian_ring r /\ ring_ideal r j
        ==> noetherian_ring (quotient_ring r j)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] NOETHERIAN_RING_EPIMORPHIC_IMAGE) THEN
    ASM_MESON_TAC [RING_EPIMORPHISM_RING_COSET])

  let ISOMORPHIC_RING_NOETHERIANNESS ← prove
   r"!(r:A ring) (r':B ring).
         r isomorphic_ring r' ==> (noetherian_ring r <=> noetherian_ring r')"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] NOETHERIAN_RING_EPIMORPHIC_IMAGE) THEN
    ASM_MESON_TAC [ISOMORPHIC_RING_SYM, isomorphic_ring,
                   RING_ISOMORPHISM_IMP_EPIMORPHISM])

  let NOETHERIAN_PROD_RING ← prove
   r"!(r1:A ring) (r2:B ring).
        noetherian_ring(prod_ring r1 r2) <=>
        noetherian_ring r1 /\ noetherian_ring r2"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] NOETHERIAN_RING_EPIMORPHIC_IMAGE) THEN
      MESON_TAC [RING_EPIMORPHISM_FST, RING_EPIMORPHISM_SND],
      STRIP_TAC] THEN
    REWRITE_TAC [noetherian_ring] THEN ONCE_REWRITE_TAC [RING_IDEAL_PROD_RING] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:A#B->bool", ← q r"k1:A->bool", ← q r"k2:B->bool"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"k2:B->bool") o REWRITE_RULE [noetherian_ring]) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"k1:A->bool") o REWRITE_RULE [noetherian_ring]) THEN
    ASM_REWRITE_TAC [finitely_generated_ideal, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"s1:A->bool") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"s2:B->bool") THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (SUBST_ALL_TAC o SYM)) THEN
    EXISTS_TAC (← q r"(ring_0 r1 INSERT s1:A->bool) CROSS
              (ring_0 r2 INSERT s2:B->bool)") THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_CROSS, PROD_RING, SUBSET_CROSS,
                  INSERT_SUBSET, RING_0, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [IDEAL_GENERATED_INSERT_ZERO] THEN
    MATCH_MP_TAC FINITE_CROSS THEN ASM_REWRITE_TAC [FINITE_INSERT])

  let NOETHERIAN_PRODUCT_RING ← prove
   r"!(r:K->A ring) k.
        noetherian_ring(product_ring k r) <=>
        FINITE {i | i IN k /\ ~trivial_ring(r i)} /\
        !i. i IN k ==> noetherian_ring (r i)"
   (← do
    -- right to left: the TAUT, the SET_RULE, then the two MESONs
    let t4 ← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")
    let s3 ← SET_RULE
     (← q r"ideal_generated r s = s'
          ==> s SUBSET ideal_generated r s /\ (!x. x IN s' ==> P x)
              ==> !x. x IN s ==> P x")
    let m2 ← MESON [FINITE_EMPTY, MEMBER_NOT_EMPTY]
     (← q r"(!x. x IN s ==> F) ==> FINITE s")
    let m1 ← MESON [INFINITE] (← q r"FINITE s <=> ~INFINITE s")
    pure (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THENL
       [ALL_TAC,
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
          (← REWRITE_RULE [IMP_CONJ_ALT] NOETHERIAN_RING_EPIMORPHIC_IMAGE)) THEN
        ASM_MESON_TAC [RING_EPIMORPHISM_PRODUCT_PROJECTION]] THEN
      REWRITE_TAC [m1] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [noetherian_ring]) THEN
      DISCH_THEN (MP_TAC o SPEC
       (← q r"{x | x IN ring_carrier(product_ring k (r:K->A ring)) /\
           FINITE {i | i IN k /\ ~(x i = ring_0(r i))}}")) THEN
      REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
       [REWRITE_TAC [ring_ideal, SUBSET_RESTRICT] THEN
        SIMP_TAC [IN_ELIM_THM, RING_0, RING_NEG, RING_ADD, RING_MUL] THEN
        REPEAT CONJ_TAC THEN REPEAT GEN_TAC THENL
         [MATCH_MP_TAC m2 THEN
          SIMP_TAC [IN_ELIM_THM, PRODUCT_RING, RESTRICTION] THEN MESON_TAC [],
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC),
          DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
          REWRITE_TAC [IMP_IMP, ← GSYM FINITE_UNION],
          REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC))] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q "i:K") THEN
        ASM_CASES_TAC (← q "(i:K) IN k") THEN
        ASM_REWRITE_TAC [CONTRAPOS_THM, IN_UNION, IN_ELIM_THM,
                         ← GSYM DE_MORGAN_THM] THEN
        ASM_REWRITE_TAC [PRODUCT_RING, RESTRICTION] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [PRODUCT_RING, IN_CARTESIAN_PRODUCT]) THEN
        ASM_SIMP_TAC [RING_NEG_0, RING_ADD_LZERO, RING_0, RING_MUL_RZERO],
        REWRITE_TAC [finitely_generated_ideal] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"s:(K->A)->bool") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN
         (← q r"!x. x IN ideal_generated (product_ring k (r:K->A ring)) s
            ==> {i | i IN k /\ ~(x i = ring_0(r i))} SUBSET
                UNIONS {{i | i IN k /\ ~(y i = ring_0(r i))} | y |
                        y IN s}")
        MP_TAC THENL
         [MATCH_MP_TAC IDEAL_GENERATED_INDUCT THEN REPEAT CONJ_TAC THENL
           [REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [],
            SIMP_TAC [PRODUCT_RING, RESTRICTION] THEN SET_TAC [],
            GEN_TAC,
            REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM UNION_SUBSET],
            REPEAT GEN_TAC THEN
            DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q "i:K") THEN
          ASM_CASES_TAC (← q "(i:K) IN k") THEN
          ASM_REWRITE_TAC [CONTRAPOS_THM, IN_UNION, IN_ELIM_THM,
                           ← GSYM DE_MORGAN_THM] THEN
          ASM_REWRITE_TAC [PRODUCT_RING, RESTRICTION] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [PRODUCT_RING, IN_CARTESIAN_PRODUCT]) THEN
          ASM_SIMP_TAC [RING_NEG_0, RING_ADD_LZERO, RING_0, RING_MUL_RZERO],
          ASM_REWRITE_TAC [NOT_FORALL_THM, IN_ELIM_THM]] THEN
        ABBREV_TAC
          (← q r"k' = UNIONS {{i | i IN k /\ ~(y i = ring_0((r:K->A ring) i))} | y |
                       y IN s}") THEN
        SUBGOAL_THEN (← q r"FINITE(k':K->bool)") ASSUME_TAC THENL
         [EXPAND_TAC "k'" THEN REWRITE_TAC [FINITE_UNIONS] THEN
          ASM_SIMP_TAC [FINITE_IMAGE, SIMPLE_IMAGE, FORALL_IN_IMAGE] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s3) THEN
          ASM_SIMP_TAC [IDEAL_GENERATED_SUBSET_CARRIER_SUBSET, IN_ELIM_THM],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"~({i | i IN k /\ ~trivial_ring ((r:K->A ring) i)} SUBSET k')")
        MP_TAC THENL
         [ASM_MESON_TAC [INFINITE, FINITE_SUBSET], ALL_TAC] THEN
        REWRITE_TAC [SUBSET, NOT_IMP, IN_ELIM_THM, NOT_FORALL_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q "a:K") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"RESTRICTION k
                    (\i. if i IN a INSERT k' then ring_1(r i)
                         else ring_0((r:K->A ring) i))") THEN
        REWRITE_TAC [PRODUCT_RING, RESTRICTION_IN_CARTESIAN_PRODUCT] THEN
        REPEAT CONJ_TAC THENL
         [MESON_TAC [RING_0, RING_1],
          MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q "(a:K) INSERT k'") THEN
          SIMP_TAC [RESTRICTION, FINITE_INSERT] THEN ASM SET_TAC [],
          EXISTS_TAC (← q "a:K") THEN ASM_REWRITE_TAC [] THEN
          ASM_REWRITE_TAC [RESTRICTION, IN_INSERT, ← GSYM TRIVIAL_RING_10]]],
      STRIP_TAC] THEN
    REWRITE_TAC [noetherian_ring] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (ONCE_REWRITE_TAC [← MATCH_MP RING_IDEAL_PRODUCT_RING th])) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(K->A)->bool", ← q r"j:K->A->bool"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    SUBGOAL_THEN
     (← q r"!i. i IN k ==> finitely_generated_ideal ((r:K->A ring) i) (j i)")
    MP_TAC THENL [ASM_MESON_TAC [noetherian_ring], ALL_TAC] THEN
    REWRITE_TAC [finitely_generated_ideal] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM, t4] THEN
    X_GEN_TAC (← q r"s:K->(A->bool)") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"cartesian_product k
                (\i. ring_0 ((r:K->A ring) i) INSERT s i)") THEN
    REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [FINITE_CARTESIAN_PRODUCT, FINITE_INSERT] THEN
      DISJ2_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_REWRITE_TAC [CONTRAPOS_THM, trivial_ring] THEN ASM SET_TAC [],
      REWRITE_TAC [PRODUCT_RING, SUBSET_CARTESIAN_PRODUCT] THEN
      ASM_SIMP_TAC [INSERT_SUBSET, RING_0],
      ASM_SIMP_TAC [IDEAL_GENERATED_CARTESIAN_PRODUCT, INSERT_SUBSET, RING_0] THEN
      REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, NOT_INSERT_EMPTY] THEN
      ASM_SIMP_TAC [CARTESIAN_PRODUCT_EQ, IDEAL_GENERATED_INSERT_ZERO]]))

  let NOETHERIAN_RING_EQ_FG_PRIME_IDEALS ← prove
   r"!r:A ring.
        noetherian_ring r <=>
        !j. prime_ideal r j ==> finitely_generated_ideal r j"
   (GEN_TAC THEN REWRITE_TAC [noetherian_ring] THEN EQ_TAC THENL
     [MESON_TAC [PRIME_IMP_RING_IDEAL], STRIP_TAC] THEN
    GEN_REWRITE_TAC id [← MESON [] (← q r"(!x. P x ==> Q x) <=> ~(?x. P x /\ ~Q x)")] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"\j:A->bool. ring_ideal r j /\ ~finitely_generated_ideal r j")
     ZL_SUBSETS_UNIONS_NONEMPTY) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [MEMBER_NOT_EMPTY, PROPER_IDEAL] THEN
      SIMP_TAC [RING_IDEAL_UNIONS] THEN
      X_GEN_TAC (← q r"c:(A->bool)->bool") THEN STRIP_TAC THEN
      REWRITE_TAC [finitely_generated_ideal] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"c:(A->bool)->bool", ← q r"k:A->bool"]
          FINITE_SUBSET_UNIONS_CHAIN) THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [IDEAL_GENERATED_SUBSET_CARRIER_SUBSET],
        DISCH_THEN (X_CHOOSE_THEN (← q r"j:A->bool") STRIP_ASSUME_TAC)] THEN
      SUBGOAL_THEN (← q r"finitely_generated_ideal r (j:A->bool)")
        (fun th => ASM_MESON_TAC [th]) THEN
      REWRITE_TAC [finitely_generated_ideal] THEN EXISTS_TAC (← q r"k:A->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_MESON_TAC [IDEAL_GENERATED_MINIMAL],
      ASM_MESON_TAC [MAXIMAL_NONFG_IMP_PRIME_IDEAL, PSUBSET]])

  let NOETHERIAN_RING_LOCALIZATION ← prove
   r"!r (s:A->bool).
        ring_multsys r s /\ noetherian_ring r
        ==> noetherian_ring (ring_localization r s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [NOETHERIAN_RING_EQ_FG_PRIME_IDEALS] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"j:(A#A->bool)->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"j:(A#A->bool)->bool") o
          MATCH_MP RING_LOCALIZATION_PRIME_IDEAL_CORRESPONDENCE) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"p:A->bool") THEN STRIP_TAC THEN
    EXPAND_TAC "j" THEN ASM_SIMP_TAC [FINITELY_GENERATED_IDEAL_LOCALIZATION])

  -- @@RETURN BEGIN
  return { NOETHERIAN_RING, NOETHERIAN_RING_EQ_ACC, NOETHERIAN_RING_EQ_MAXIMAL,
           NOETHERIAN_RING_EPIMORPHIC_IMAGE, NOETHERIAN_QUOTIENT_RING,
           ISOMORPHIC_RING_NOETHERIANNESS, NOETHERIAN_PROD_RING, NOETHERIAN_PRODUCT_RING,
           NOETHERIAN_RING_EQ_FG_PRIME_IDEALS, NOETHERIAN_RING_LOCALIZATION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The special case of ACC for principal ideals (ACCP), which holds in UFDs. -/
/- (ringtheory.ml 14762-14966)                                               -/
/- ------------------------------------------------------------------------- -/

structure ACCP where
  -- @@FIELDS
  RING_ACCP : thm
  RING_DIVIDES_WF : thm
  RING_PRINCIPAL_IDEALS_WF : thm
  ACCP_RING_PROPER_DIVISOR_INDUCT : thm
  RING_PROPER_DIVISOR_INDUCT : thm
  ACCP_DOMAIN_ATOMIC : thm
  ACCP_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS : thm
  NOETHERIAN_DOMAIN_ATOMIC : thm
  NOETHERIAN_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS : thm
  UFD_EQ_ACCP : thm
  deriving Inhabited

@[nospecialize]
def setupACCP [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BProducts : Products) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BPrimes : Primes) (BFactorizations : Factorizations) (BSpecialIdeals : SpecialIdeals) (BUFDs : UFDs) (BNoetherian : Noetherian) :
    ExceptT String IO ACCP := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, .. } := D
  let { ADD_SUB, ADD_SYM, ARITH, ARITH_EQ, CARD_NUMSEG_1, .. } := D.core1
  let { CONJ_ASSOC, DE_MORGAN_THM, DISJOINT, EXTENSION, .. } := D.core2
  let { FINITE_NUMSEG, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, LEFT_IMP_EXISTS_THM, LE_REFL, .. } := D.core5
  let { NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, NUMSEG_ADD_SPLIT, NUMSEG_OFFSET_IMAGE,
        NUMSEG_SING, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, .. } := D.core7
  let { WF_IND, WF_LEX, WF_MEASURE_GEN, WF_SUBSET, WF_num, num_INDUCTION, o_THM, .. } := D.core8
  let { RING_0, .. } := BBasics
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES_NUMSEG, RING_PRODUCT_EQ, RING_PRODUCT_IMAGE,
        RING_PRODUCT_SING, RING_PRODUCT_UNION, .. } := BProducts
  let { RING_ASSOCIATES_1, RING_ASSOCIATES_DIVIDES, RING_ASSOCIATES_MUL,
        RING_ASSOCIATES_REFL, RING_ASSOCIATES_TRANS, RING_DIVIDES_0,
        RING_DIVIDES_IN_CARRIER, RING_DIVIDES_LMUL, RING_DIVIDES_REFL,
        RING_DIVIDES_RMUL, ring_divides, .. } := BDivides
  let { PSUBSET_IDEALS_GENERATED_SING, .. } := BIdeals
  let { INTEGRAL_DOMAIN_DIVIDES_MUL_SELF, INTEGRAL_DOMAIN_MUL_EQ_0, .. } := BDomains
  let { INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE, RING_IRREDUCIBLE_IN_CARRIER,
        ring_irreducible, .. } := BPrimes
  let { RING_DIVIDES_PRIMEFACTS_LT, .. } := BFactorizations
  let { PRINCIPAL_IDEAL_IDEAL_GENERATED_SING, PRINCIPAL_IMP_RING_IDEAL,
        principal_ideal, .. } := BSpecialIdeals
  let { UFD_EQ_ATOMIC, UFD_EQ_PRIMEFACT, UFD_IMP_INTEGRAL_DOMAIN,
        UFD_IRREDUCIBLE_EQ_PRIME, .. } := BUFDs
  let { NOETHERIAN_RING, .. } := BNoetherian
  -- @@SCOPE END

  let RING_ACCP ← prove
   r"!r:A ring.
    WF (\j j'. principal_ideal r j /\ principal_ideal r j' /\ j' PSUBSET j) <=>
    WF (\x y. ring_divides r x y /\ ~(ring_divides r y x))"
   (GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o ISPEC (← q r"\x:A. ideal_generated r {x}") o
          MATCH_MP WF_MEASURE_GEN) THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] WF_SUBSET) THEN
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
      REWRITE_TAC [PRINCIPAL_IDEAL_IDEAL_GENERATED_SING] THEN STRIP_TAC THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP RING_DIVIDES_IN_CARRIER) THEN
      ASM_SIMP_TAC [PSUBSET_IDEALS_GENERATED_SING],
      SUBGOAL_THEN
       (← q r"?g. !j. principal_ideal r j
              ==> g j IN ring_carrier r /\ ideal_generated r {g j:A} = j")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [← GSYM SKOLEM_THM, principal_ideal] THEN MESON_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"g:(A->bool)->A") o MATCH_MP
       (← INST_TYPE [(← qty "B->bool", ← qty "A")] WF_MEASURE_GEN)) THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] WF_SUBSET) THEN
      REWRITE_TAC [] THEN ASM_MESON_TAC [PSUBSET_IDEALS_GENERATED_SING]])

  let RING_DIVIDES_WF ← prove
   r"!r:A ring.
        noetherian_ring r \/ UFD r
        ==> WF (\x y. ring_divides r x y /\ ~(ring_divides r y x))"
   (REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOETHERIAN_RING]) THEN
      REWRITE_TAC [← GSYM RING_ACCP] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] WF_SUBSET) THEN
      SIMP_TAC [PRINCIPAL_IMP_RING_IDEAL],
      FIRST_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
        GEN_REWRITE_RULE id [UFD_EQ_PRIMEFACT]) THEN
      REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:A->num", ← q r"p:A->num->A"] THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"\x. (if x = ring_0 r then 1 else 0),(n:A->num) x")
        (← MATCH_MP WF_MEASURE_GEN
          (← MATCH_MP WF_LEX (← CONJ WF_num WF_num)))) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] WF_SUBSET) THEN
      REWRITE_TAC [] THEN MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
      ASM_CASES_TAC (← q r"(x:A) IN ring_carrier r /\ y IN ring_carrier r") THENL
       [FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC),
        ASM_MESON_TAC [ring_divides]] THEN
      ASM_CASES_TAC (← q "x:A = ring_0 r") THEN ASM_SIMP_TAC [RING_DIVIDES_0] THEN
      ASM_CASES_TAC (← q "y:A = ring_0 r") THEN ASM_REWRITE_TAC [ARITH] THEN
      STRIP_TAC THEN MP_TAC (← ISPECL
       [← q "r:A ring", ← q "1..n(x:A)", ← q r"(p:A->num->A) x",
        ← q "1..n(y:A)", ← q r"(p:A->num->A) y"]
          RING_DIVIDES_PRIMEFACTS_LT) THEN
      ASM_REWRITE_TAC [CARD_NUMSEG_1] THEN DISCH_THEN MATCH_MP_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        let ty ← SPEC (← q "y:A") th
        let tx ← SPEC (← q "x:A") th
        pure (MP_TAC ty THEN MP_TAC tx)) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN STRIP_TAC THEN
      ASM_SIMP_TAC [IN_NUMSEG, FINITE_NUMSEG,
                    INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE] THEN
      ASM_MESON_TAC [RING_ASSOCIATES_DIVIDES]])

  let RING_PRINCIPAL_IDEALS_WF ← prove
   r"!r:A ring.
        noetherian_ring r \/ UFD r
        ==> WF (\j j'. principal_ideal r j /\ principal_ideal r j' /\
                       j' PSUBSET j)"
   (REWRITE_TAC [RING_ACCP, RING_DIVIDES_WF])

  let ACCP_RING_PROPER_DIVISOR_INDUCT ← prove
   r"!r P:A->bool.
        WF (\x y. ring_divides r x y /\ ~(ring_divides r y x)) /\
        (!a. a IN ring_carrier r /\
             (!d. ring_divides r d a /\ ~(ring_divides r a d) ==> P d)
             ==> P a)
        ==> !a. a IN ring_carrier r ==> P a"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [WF_IND]) THEN
    REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_MESON_TAC [ring_divides])

  let RING_PROPER_DIVISOR_INDUCT ← prove
   r"!r P:A->bool.
        (noetherian_ring r \/ UFD r) /\
        (!a. a IN ring_carrier r /\
             (!d. ring_divides r d a /\ ~(ring_divides r a d) ==> P d)
             ==> P a)
        ==> !a. a IN ring_carrier r ==> P a"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC ACCP_RING_PROPER_DIVISOR_INDUCT THEN
    ASM_SIMP_TAC [RING_DIVIDES_WF])

  let ACCP_DOMAIN_ATOMIC ← prove
   r"!r a:A.
        integral_domain r /\
        WF (\x y. ring_divides r x y /\ ~ring_divides r y x) /\
        a IN ring_carrier r /\ ~(a = ring_0 r)
        ==> ?n p. (!i. 1 <= i /\ i <= n ==> ring_irreducible r (p i)) /\
                  ring_associates r (ring_product r (1..n) p) a"
   (← do
    let m2 ← MESON [RING_ASSOCIATES_REFL]
     (← q r"y IN ring_carrier r /\ x = y ==> ring_associates r x y")
    let a1 ← ARITH_RULE (← q "1 <= n + 1")
    pure (GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT DISCH_TAC THEN MATCH_MP_TAC ACCP_RING_PROPER_DIVISOR_INDUCT THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q "a:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [IMP_CONJ] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q "ring_unit r (a:A)") THENL
     [MAP_EVERY EXISTS_TAC [← q "0", ← q r"(\i. ring_0 r):num->A"] THEN
      REWRITE_TAC [RING_PRODUCT_CLAUSES_NUMSEG, ARITH_EQ, RING_0] THEN
      ASM_REWRITE_TAC [RING_ASSOCIATES_1] THEN ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q "ring_irreducible r (a:A)") THENL
     [MAP_EVERY EXISTS_TAC [← q "1", ← q r"(\i. a):num->A"] THEN
      ASM_REWRITE_TAC [NUMSEG_SING, RING_PRODUCT_SING, RING_ASSOCIATES_REFL],
      RULE_ASSUM_TAC (REWRITE_RULE [IMP_IMP, ← GSYM CONJ_ASSOC])] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [ring_irreducible]) THEN
    ASM_REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, DE_MORGAN_THM] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "b:A", ← q "c:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (fun t => tactic_of do
      let tc ← SPEC (← q "c:A") t
      let tb ← SPEC (← q "b:A") t
      pure (MP_TAC tc THEN MP_TAC tb)) THEN
    ASM_REWRITE_TAC [] THEN UNDISCH_TAC (← q "~(a:A = ring_0 r)") THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_MUL_EQ_0, DE_MORGAN_THM] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_LMUL, RING_DIVIDES_REFL] THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_DIVIDES_MUL_SELF, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "n1:num", ← q r"p1:num->A"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q "n2:num", ← q r"p2:num->A"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q "n1 + n2:num") THEN
    EXISTS_TAC (← q r"\i. if i <= n1 then (p1:num->A) i else p2(i - n1)") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      SIMP_TAC [NUMSEG_ADD_SPLIT, a1]] THEN
    wPart lhand (fun t => do lhand (← rand t)) RING_PRODUCT_UNION THEN
    ANTS_TAC THENL
     [REWRITE_TAC [FINITE_NUMSEG, DISJOINT, EXTENSION, IN_ELIM_THM] THEN
      REWRITE_TAC [NOT_IN_EMPTY, IN_INTER, IN_NUMSEG] THEN ARITH_TAC,
      DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC RING_ASSOCIATES_MUL THEN CONJ_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [ADD_SYM] THEN REWRITE_TAC [NUMSEG_OFFSET_IMAGE] THEN
      wPart lhand (fun t => do lhand (← rand t)) RING_PRODUCT_IMAGE THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL [ARITH_TAC, DISCH_THEN SUBST1_TAC]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
      RING_ASSOCIATES_TRANS)) THEN
    MATCH_MP_TAC m2 THEN
    REWRITE_TAC [RING_PRODUCT] THEN MATCH_MP_TAC RING_PRODUCT_EQ THEN
    GEN_TAC THEN REWRITE_TAC [IN_NUMSEG, o_THM] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [ADD_SUB] THEN ASM_ARITH_TAC))

  let ACCP_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS ← prove
   r"!r x:A.
        integral_domain r /\
        WF (\x y. ring_divides r x y /\ ~ring_divides r y x) /\
        x IN ring_carrier r /\ ~(x = ring_0 r) /\ ~(ring_unit r x)
        ==> ?p. ring_irreducible r p /\ ring_divides r p x"
   (← do
    let a3 ← ARITH_RULE (← q "1 <= SUC n")
    let a2 ← ARITH_RULE (← q "1 <= SUC n")
    let a1 ← ARITH_RULE (← q "1 <= SUC n")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "x:A"] ACCP_DOMAIN_ATOMIC) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MATCH_MP_TAC num_INDUCTION THEN REWRITE_TAC [IMP_CONJ] THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES_NUMSEG, ARITH_EQ, RING_ASSOCIATES_1,
      a1, LE_REFL, RING_IRREDUCIBLE_IN_CARRIER] THEN
    X_GEN_TAC (← q "n:num") THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
    X_GEN_TAC (← q r"q:num->A") THEN REWRITE_TAC [IMP_IMP] THEN STRIP_TAC THEN
    EXISTS_TAC (← q "q(SUC n):A") THEN
    ASM_SIMP_TAC [a2, LE_REFL] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          RING_ASSOCIATES_DIVIDES)) THEN
    REPEAT (DISCH_THEN (MP_TAC o SPEC (← q "q(SUC n):A"))) THEN
    ASM_SIMP_TAC [a3, LE_REFL, RING_IRREDUCIBLE_IN_CARRIER,
                  RING_ASSOCIATES_REFL, RING_DIVIDES_LMUL, RING_DIVIDES_REFL,
                  RING_PRODUCT]))

  let NOETHERIAN_DOMAIN_ATOMIC ← prove
   r"!r a:A.
        integral_domain r /\
        (noetherian_ring r \/ UFD r) /\
        a IN ring_carrier r /\ ~(a = ring_0 r)
        ==> ?n p. (!i. 1 <= i /\ i <= n ==> ring_irreducible r (p i)) /\
                  ring_associates r (ring_product r (1..n) p) a"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC ACCP_DOMAIN_ATOMIC THEN
    ASM_SIMP_TAC [RING_DIVIDES_WF])

  let NOETHERIAN_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS ← prove
   r"!r x:A.
        (integral_domain r /\ noetherian_ring r \/ UFD r) /\
        x IN ring_carrier r /\ ~(x = ring_0 r) /\ ~(ring_unit r x)
        ==> ?p. ring_irreducible r p /\ ring_divides r p x"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ACCP_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS THEN
    ASM_SIMP_TAC [UFD_IMP_INTEGRAL_DOMAIN, RING_DIVIDES_WF])

  let UFD_EQ_ACCP ← prove
   r"!r:A ring.
        UFD r <=>
        integral_domain r /\
        (!p. ring_irreducible r p ==> ring_prime r p) /\
        WF (\x y. ring_divides r x y /\ ~ring_divides r y x)"
   (GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [UFD_IMP_INTEGRAL_DOMAIN, UFD_IRREDUCIBLE_EQ_PRIME,
                RING_DIVIDES_WF],
      STRIP_TAC THEN ASM_REWRITE_TAC [UFD_EQ_ATOMIC] THEN
      ASM_SIMP_TAC [ACCP_DOMAIN_ATOMIC]])

  -- @@RETURN BEGIN
  return { RING_ACCP, RING_DIVIDES_WF, RING_PRINCIPAL_IDEALS_WF,
           ACCP_RING_PROPER_DIVISOR_INDUCT, RING_PROPER_DIVISOR_INDUCT,
           ACCP_DOMAIN_ATOMIC, ACCP_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS,
           NOETHERIAN_DOMAIN_ATOMIC, NOETHERIAN_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS,
           UFD_EQ_ACCP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- An actual (somewhat carefully totalized) function for the ring gcd.      -/
/- (ringtheory.ml 14967-15174)                                               -/
/- ------------------------------------------------------------------------- -/

structure RingGcd where
  -- @@FIELDS
  ring_gcd : thm
  RING_GCD_WORKS : thm
  RING_GCD_UNIQUE : thm
  RING_GCD_REFL : thm
  RING_GCD : thm
  RING_GCD_EQ : thm
  RING_GCD_SYM : thm
  RING_GCD_DIVIDES : thm
  RING_UNIT_GCD : thm
  RING_GCD_EQ_1 : thm
  UFD_DIVIDES_GCD : thm
  UFD_DIVIDES_GCD_EQ : thm
  RING_GCD_00 : thm
  FIELD_GCD : thm
  deriving Inhabited

@[nospecialize]
def setupRingGcd [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BDomains : Domains) (BUFDs : UFDs) :
    ExceptT String IO RingGcd := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, new_definition, .. } := D
  let { CONTRAPOS_THM, .. } := D.core2
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, .. } := D.core4
  let { LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_AND, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, .. } := D.core6
  let { SUBSET, .. } := D.core7
  let { RING_0, RING_1, .. } := BBasics
  let { RING_OF_NUM, .. } := BNumbers
  let { RING_ASSOCIATES_0, RING_DIVIDES_0, RING_DIVIDES_1, RING_DIVIDES_IN_CARRIER,
        RING_DIVIDES_ONE, RING_DIVIDES_REFL, RING_DIVIDES_TRANS, RING_DIVIDES_UNIT,
        RING_UNIT_1, ring_associates, ring_coprime, ring_divides, .. } := BDivides
  let { FIELD_COPRIME, .. } := BDomains
  let { UFD_IMP_GCD_EXISTS, .. } := BUFDs
  -- @@SCOPE END

  let ring_gcd ← new_definition
   r"ring_gcd (r:A ring) (a,b) =
        if a IN ring_carrier r /\ b IN ring_carrier r ==> ring_coprime r (a,b)
        then ring_1 r
        else if ?d. d IN IMAGE (ring_of_num r) (:num) /\
                    ring_divides r d a /\
                    ring_divides r d b /\
                    !d'. ring_divides r d' a /\ ring_divides r d' b
                         ==> ring_divides r d' d
        then @d. d IN IMAGE (ring_of_num r) (:num) /\
                 ring_divides r d a /\
                 ring_divides r d b /\
                 !d'. ring_divides r d' a /\ ring_divides r d' b
                      ==> ring_divides r d' d
        else if ?d. d IN ring_carrier r /\
                    ring_divides r d a /\
                    ring_divides r d b /\
                    !d'. ring_divides r d' a /\ ring_divides r d' b
                         ==> ring_divides r d' d
        then @d. d IN ring_carrier r /\
                 ring_divides r d a /\
                 ring_divides r d b /\
                 !d'. ring_divides r d' a /\ ring_divides r d' b
                      ==> ring_divides r d' d
        else @d. ring_divides r d a /\ ring_divides r d b /\
                 ~(ring_unit r d)"

  let RING_GCD_WORKS ← prove
   r"!r a b:A.
        ring_gcd r (a,b) IN ring_carrier r /\
        ring_divides r (ring_gcd r (a,b)) a /\
        ring_divides r (ring_gcd r (a,b)) b /\
        (!d'. ring_divides r d' a /\ ring_divides r d' b
              ==> ring_divides r d' (ring_gcd r (a,b))) <=>
        ?d. d IN ring_carrier r /\
            ring_divides r d a /\ ring_divides r d b /\
            !d'. ring_divides r d' a /\ ring_divides r d' b
                 ==> ring_divides r d' d"
   (REPEAT GEN_TAC THEN EQ_TAC THENL [MESON_TAC [], DISCH_TAC] THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THENL
     [ALL_TAC, ASM_MESON_TAC [ring_divides]] THEN
    ASM_CASES_TAC (← q "(b:A) IN ring_carrier r") THENL
     [ALL_TAC, ASM_MESON_TAC [ring_divides]] THEN
    ASM_CASES_TAC (← q "ring_coprime r (a:A,b)") THEN ASM_REWRITE_TAC [ring_gcd] THENL
     [REWRITE_TAC [RING_DIVIDES_1, RING_1, RING_DIVIDES_ONE] THEN
      ASM_REWRITE_TAC [← GSYM ring_coprime],
      ALL_TAC] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SELECT_RULE) THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RING_OF_NUM])

  let RING_GCD_UNIQUE ← prove
   r"!r a b d:A.
        ring_divides r d a /\ ring_divides r d b /\
        (!d'. ring_divides r d' a /\ ring_divides r d' b
              ==> ring_divides r d' d)
        ==> ring_associates r (ring_gcd r (a,b)) d"
   (REPEAT STRIP_TAC THEN MP_TAC (← EQ_IMP_RULE
     (← ISPECL [← q "r:A ring", ← q "a:A", ← q "b:A"] RING_GCD_WORKS)).2 THEN
    ANTS_TAC THENL [ASM_MESON_TAC [ring_divides], ALL_TAC] THEN
    REWRITE_TAC [ring_associates] THEN ASM_MESON_TAC [])

  let RING_GCD_REFL ← prove
   r"!r a:A. a IN ring_carrier r ==> ring_associates r (ring_gcd r (a,a)) a"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_GCD_UNIQUE THEN
    ASM_REWRITE_TAC [RING_DIVIDES_REFL])

  let RING_GCD ← prove
   r"!r a b:A. ring_gcd r (a,b) IN ring_carrier r"
   (← do
    let m3 ← MESON [] (← q r"(?x. P x) ==> (!x. P x ==> Q x) ==> ~(!x. ~(Q x))")
    let t2 ← TAUT (← q r"~p ==> p ==> q")
    let t1 ← TAUT (← q r"(p ==> r) /\ (~q ==> r) ==> (p <=> q) ==> r")
    pure (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "b:A"] RING_GCD_WORKS) THEN
    MATCH_MP_TAC t1 THEN
    CONJ_TAC THENL [SIMP_TAC [], DISCH_TAC] THEN ASM_REWRITE_TAC [ring_gcd] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [RING_1] THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [NOT_IMP]) THEN
    COND_CASES_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      MATCH_MP_TAC t2 THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP m3) THEN
      ONCE_REWRITE_TAC [IMP_CONJ] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, RING_OF_NUM],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [ring_coprime]) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [ring_divides]]))

  let RING_GCD_EQ ← prove
   r"!r a b a' b':A.
        (!d. d IN ring_carrier r
             ==> (ring_divides r d a /\ ring_divides r d b <=>
                  ring_divides r d a' /\ ring_divides r d b'))
        ==> ring_gcd r (a,b) = ring_gcd r (a',b')"
   (← do
    let t3 ← TAUT (← q r"ring_divides r d a /\ ring_divides r d b /\ q <=>
                    (ring_divides r d a /\ ring_divides r d b) /\ q")
    let t2 ← TAUT (← q r"p /\ q /\ r /\ s <=> p /\ (q /\ r) /\ s")
    let m1 ← MESON [] (← q r"(!d. P d ==> Q d) ==> (!d. ~(P d) ==> Q d) ==> (!d. Q d)")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP m1) THEN
    ANTS_TAC THENL [SIMP_TAC [ring_divides], DISCH_TAC] THEN
    REWRITE_TAC [ring_gcd, ring_coprime] THEN
    REWRITE_TAC [t2] THEN
    REWRITE_TAC [t3] THEN
    ASM_REWRITE_TAC [] THEN AP_THM_TAC THEN AP_THM_TAC THEN
    AP_TERM_TAC THEN SIMP_TAC [] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q "ring_1 r:A")) THEN
    SIMP_TAC [RING_DIVIDES_1]))

  let RING_GCD_SYM ← prove
   r"!r a b:A. ring_gcd r (a,b) = ring_gcd r (b,a)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_GCD_EQ THEN
    CONV_TAC (fun t => (TAUT t).run))

  let RING_GCD_DIVIDES ← prove
   r"(!r a b:A. ring_divides r (ring_gcd r (a,b)) a <=> a IN ring_carrier r) /\
   (!r a b:A. ring_divides r (ring_gcd r (a,b)) b <=> b IN ring_carrier r)"
   (← do
    let m3 ← MESON [] (← q r"(?x. P x) ==> (!x. P x ==> Q x) ==> ~(!x. ~(Q x))")
    let t2 ← TAUT (← q r"~p ==> p ==> q")
    let t1 ← TAUT (← q r"(p ==> r) /\ (~q ==> r) ==> (p <=> q) ==> r")
    pure (REPEAT STRIP_TAC THEN
    (EQ_TAC THENL [MESON_TAC [RING_DIVIDES_IN_CARRIER], DISCH_TAC]) THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "b:A"] RING_GCD_WORKS) THEN
    MATCH_MP_TAC t1 THEN
    (CONJ_TAC THENL [SIMP_TAC [], DISCH_TAC]) THEN ASM_REWRITE_TAC [ring_gcd] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [RING_DIVIDES_1] THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [NOT_IMP]) THEN
    (COND_CASES_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      MATCH_MP_TAC t2 THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP m3) THEN
      ONCE_REWRITE_TAC [IMP_CONJ] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, RING_OF_NUM],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [ring_coprime]) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [ring_divides]])))

  let RING_UNIT_GCD ← prove
   r"!r a b:A.
        ring_unit r (ring_gcd r (a,b)) <=>
        a IN ring_carrier r /\ b IN ring_carrier r ==> ring_coprime r (a,b)"
   (← do
    let m3 ← MESON [] (← q r"(?x. P x) ==> (!x. P x ==> Q x) ==> ~(!x. ~(Q x))")
    let t2 ← TAUT (← q r"~p ==> p ==> q")
    let t1 ← TAUT (← q r"(p ==> r) /\ (~q ==> r) ==> (p <=> q) ==> r")
    pure (REPEAT GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, SIMP_TAC [ring_gcd, RING_UNIT_1]] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "b:A"] RING_GCD_WORKS) THEN
    MATCH_MP_TAC t1 THEN
    CONJ_TAC THENL
     [STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [ring_coprime]) THEN
      ASM_REWRITE_TAC [NOT_FORALL_THM, LEFT_IMP_EXISTS_THM, NOT_IMP] THEN
      X_GEN_TAC (← q "d:A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "d:A")) THEN ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      ASM_SIMP_TAC [RING_DIVIDES_UNIT],
      DISCH_TAC] THEN
    ASM_REWRITE_TAC [ring_gcd] THEN COND_CASES_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      MATCH_MP_TAC t2 THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP m3) THEN
      ONCE_REWRITE_TAC [IMP_CONJ] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, RING_OF_NUM],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [ring_coprime]) THEN
    ASM_REWRITE_TAC [] THEN MESON_TAC [ring_divides]))

  let RING_GCD_EQ_1 ← prove
   r"!r a b:A.
        ring_gcd r (a,b) = ring_1 r <=>
        a IN ring_carrier r /\ b IN ring_carrier r ==> ring_coprime r (a,b)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL [ALL_TAC, SIMP_TAC [ring_gcd]] THEN
    REWRITE_TAC [← GSYM RING_UNIT_GCD] THEN SIMP_TAC [RING_UNIT_1])

  let UFD_DIVIDES_GCD ← prove
   r"!r a b d:A.
        UFD r /\ ring_divides r d a /\ ring_divides r d b
        ==> ring_divides r d (ring_gcd r (a,b))"
   (MESON_TAC [← REWRITE_RULE [← GSYM RING_GCD_WORKS] UFD_IMP_GCD_EXISTS,
               RING_DIVIDES_IN_CARRIER])

  let UFD_DIVIDES_GCD_EQ ← prove
   r"!r a b d:A.
        UFD r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_divides r d (ring_gcd r (a,b)) <=>
             ring_divides r d a /\ ring_divides r d b)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [UFD_DIVIDES_GCD] THEN
    DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] RING_DIVIDES_TRANS) THEN
    ASM_REWRITE_TAC [RING_GCD_DIVIDES])

  let RING_GCD_00 ← prove
   r"!r:A ring. ring_gcd r (ring_0 r,ring_0 r) = ring_0 r"
   (GEN_TAC THEN
    GEN_REWRITE_TAC id [← GSYM (← CONJUNCT1 RING_ASSOCIATES_0)] THEN
    MATCH_MP_TAC RING_GCD_UNIQUE THEN
    REWRITE_TAC [RING_DIVIDES_0, RING_0])

  let FIELD_GCD ← prove
   r"!r a b:A.
        field r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> ring_gcd r (a,b) =
            if a = ring_0 r /\ b = ring_0 r then ring_0 r else ring_1 r"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [RING_GCD_00] THEN
    ASM_SIMP_TAC [RING_GCD_EQ_1, FIELD_COPRIME])

  -- @@RETURN BEGIN
  return { ring_gcd, RING_GCD_WORKS, RING_GCD_UNIQUE, RING_GCD_REFL, RING_GCD,
           RING_GCD_EQ, RING_GCD_SYM, RING_GCD_DIVIDES, RING_UNIT_GCD, RING_GCD_EQ_1,
           UFD_DIVIDES_GCD, UFD_DIVIDES_GCD_EQ, RING_GCD_00, FIELD_GCD }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Bezout rings, where gcds also work and we have Bezout identity.           -/
/- (ringtheory.ml 15175-15558)                                               -/
/- ------------------------------------------------------------------------- -/

structure Bezout where
  -- @@FIELDS
  bezout_ring : thm
  BEZOUT_RING_FINITELY_GENERATED_EQ_PRINCIPAL_IDEAL : thm
  PID_IMP_BEZOUT_RING : thm
  FIELD_IMP_BEZOUT_RING : thm
  BEZOUT_RING_2 : thm
  BEZOUT_RING_SETADD : thm
  PID_EQ_NOETHERIAN_BEZOUT_DOMAIN : thm
  BEZOUT_RING_IMP_BEZOUT : thm
  RING_IMP_GCD_EXISTS : thm
  BEZOUT_RING_IMP_GCD : thm
  BEZOUT_RING : thm
  BEZOUT_RING_COPRIME : thm
  BEZOUT_RING_COPRIME_COMAXIMAL : thm
  BEZOUT_RING_COMAXIMAL_COPRIME : thm
  RING_DIVIDES_GCD : thm
  RING_DIVIDES_GCD_EQ : thm
  BEZOUT_RING_IRREDUCIBLE_IMP_PRIME : thm
  BEZOUT_DOMAIN_IRREDUCIBLE_EQ_PRIME : thm
  PID_EQ_ACCP_BEZOUT_DOMAIN : thm
  PID_EQ_UFD_BEZOUT_RING : thm
  PID_EQ_BEZOUT_ATOMIC : thm
  BEZOUT_RING_EPIMORPHIC_IMAGE : thm
  BEZOUT_QUOTIENT_RING : thm
  ISOMORPHIC_RING_BEZOUTNESS : thm
  RING_COPRIME_HOMOMORPHIC_IMAGE : thm
  BEZOUT_RING_LOCALIZATION : thm
  PID_RING_LOCALIZATION : thm
  deriving Inhabited

@[nospecialize]
def setupBezout [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDivides : Divides) (BIdeals : Ideals) (BHoms : Homs) (BIso : Iso) (BRingRule : RingRule) (BQuotients : Quotients) (BPrimes : Primes) (BSquarefree : Squarefree) (BLocalization : Localization) (BSpecialIdeals : SpecialIdeals) (BUFDs : UFDs) (BNoetherian : Noetherian) (BACCP : ACCP) (BRingGcd : RingGcd) :
    ExceptT String IO Bezout := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, basic_ss, new_definition, .. } := D
  let { CONTRAPOS_THM, EMPTY_SUBSET, EXTENSION, .. } := D.core2
  let { FINITE_EMPTY, FINITE_INDUCT_STRONG, FINITE_INSERT, FINITE_RULES,
        FORALL_FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INSERT_SUBSET, .. } := D.core4
  let { IN_ELIM_THM, IN_INSERT, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_EXISTS, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ,
        SWAP_FORALL_THM, WF, .. } := D.core7
  let { RING_1, RING_ADD, RING_ADD_LDISTRIB, RING_ADD_RDISTRIB, RING_MUL, RING_MUL_AC,
        RING_MUL_ASSOC, RING_MUL_LID, RING_MUL_RID, .. } := BBasics
  let { RING_ASSOCIATES_SYM, RING_DIVIDES_ADD, RING_DIVIDES_ASSOCIATES,
        RING_DIVIDES_IN_CARRIER, RING_DIVIDES_ONE, RING_DIVIDES_REFL,
        RING_DIVIDES_RMUL, RING_DIVIDES_TRANS, RING_UNIT_DIVIDES, ring_coprime,
        ring_divides, .. } := BDivides
  let { IDEAL_GENERATED_2, IDEAL_GENERATED_EMPTY, IDEAL_GENERATED_INC,
        IDEAL_GENERATED_INSERT, IDEAL_GENERATED_MINIMAL, IDEAL_GENERATED_MINIMAL_EQ,
        IDEAL_GENERATED_SING, IDEAL_GENERATED_SING_ALT, IDEAL_GENERATED_UNION,
        IN_RING_IDEAL_0, IN_RING_IDEAL_ADD, IN_RING_IDEAL_RMUL, RING_IDEAL_EQ_CARRIER,
        RING_IDEAL_IDEAL_GENERATED, RING_IDEAL_IMP_SUBSET, RING_IDEAL_SETADD,
        ring_setadd, .. } := BIdeals
  let { IDEAL_GENERATED_BY_EPIMORPHIC_IMAGE, RING_ISOMORPHISMS_ISOMORPHISM,
        RING_ISOMORPHISM_IMP_EPIMORPHISM, ring_epimorphism, ring_homomorphism,
        ring_isomorphism, .. } := BHoms
  let { isomorphic_ring, .. } := BIso
  let { RING_TAC, .. } := BRingRule
  let { RING_EPIMORPHISM_RING_COSET, .. } := BQuotients
  let { INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE, RING_IRREDUCIBLE_COPRIME_EQ,
        ring_irreducible, ring_prime, .. } := BPrimes
  let { ring_multsys, .. } := BSquarefree
  let { INTEGRAL_DOMAIN_LOCALIZATION, RING_FRACTIONATE_IN_CARRIER,
        RING_HOMOMORPHISM_FRACTIONATE, RING_LOCALEQUIV_EQUIV, RING_LOCALIZATION_ADD,
        RING_LOCALIZATION_CARRIER, RING_LOCALIZATION_MUL, ring_fractionate,
        ring_localequiv, .. } := BLocalization
  let { FIELD_IMP_PID, FINITELY_GENERATED_IDEAL_GENERATED,
        FINITELY_GENERATED_IDEAL_SETADD, FINITELY_GENERATED_IMP_RING_IDEAL, PID,
        PID_IMP_INTEGRAL_DOMAIN, PRINCIPAL_IDEAL_0, PRINCIPAL_IDEAL_EPIMORPHIC_IMAGE,
        PRINCIPAL_IDEAL_IDEAL_GENERATED_SING, PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL,
        finitely_generated_ideal, noetherian_ring, principal_ideal, .. } := BSpecialIdeals
  let { PID_IMP_UFD, RING_DIVIDES_LOCALEQUIV, UFD_EQ_ATOMIC, UFD_IMP_GCD_EXISTS,
        UFD_IMP_INTEGRAL_DOMAIN, .. } := BUFDs
  let { NOETHERIAN_RING_LOCALIZATION, .. } := BNoetherian
  let { RING_DIVIDES_WF, .. } := BACCP
  let { RING_GCD, RING_GCD_DIVIDES, RING_GCD_EQ_1, RING_GCD_UNIQUE, RING_GCD_WORKS, .. } := BRingGcd
  -- @@SCOPE END

  let bezout_ring ← new_definition
   r"bezout_ring (r:A ring) <=>
        !j. finitely_generated_ideal r j ==> principal_ideal r j"

  let BEZOUT_RING_FINITELY_GENERATED_EQ_PRINCIPAL_IDEAL ← prove
   r"!r j:A->bool.
        bezout_ring (r:A ring)
        ==> (finitely_generated_ideal r j <=> principal_ideal r j)"
   (MESON_TAC [bezout_ring, PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL])

  let PID_IMP_BEZOUT_RING ← prove
   r"!r:A ring. PID r ==> bezout_ring r"
   (SIMP_TAC [PID, bezout_ring, FINITELY_GENERATED_IMP_RING_IDEAL])

  let FIELD_IMP_BEZOUT_RING ← prove
   r"!r:A ring. field r ==> bezout_ring r"
   (SIMP_TAC [FIELD_IMP_PID, PID_IMP_BEZOUT_RING])

  let BEZOUT_RING_2 ← prove
   r"!r:A ring.
        bezout_ring r <=>
        !a b. a IN ring_carrier r /\ b IN ring_carrier r
              ==> principal_ideal r (ideal_generated r {a,b})"
   (GEN_TAC THEN REWRITE_TAC [bezout_ring] THEN EQ_TAC THEN
    SIMP_TAC [FINITELY_GENERATED_IDEAL_GENERATED, FINITE_INSERT,
              FINITE_EMPTY] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!s:A->bool.
        FINITE s
        ==> s SUBSET ring_carrier r
            ==> principal_ideal r (ideal_generated r s)")
    MP_TAC THENL [ALL_TAC, MESON_TAC [finitely_generated_ideal]] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN SIMP_TAC [INSERT_SUBSET] THEN
    REWRITE_TAC [IDEAL_GENERATED_EMPTY, PRINCIPAL_IDEAL_0] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q r"s:A->bool"] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [principal_ideal]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "b:A") (STRIP_ASSUME_TAC o GSYM)) THEN
    ONCE_REWRITE_TAC [IDEAL_GENERATED_INSERT] THEN
    ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [← GSYM IDEAL_GENERATED_INSERT])

  let BEZOUT_RING_SETADD ← prove
   r"!r:A ring.
        bezout_ring r <=>
        !j k. principal_ideal r j /\ principal_ideal r k
              ==> principal_ideal r (ring_setadd r j k)"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [← GSYM BEZOUT_RING_FINITELY_GENERATED_EQ_PRINCIPAL_IDEAL,
              FINITELY_GENERATED_IDEAL_SETADD] THEN
    STRIP_TAC THEN REWRITE_TAC [BEZOUT_RING_2] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b} = {a} UNION {b}")] THEN
    REWRITE_TAC [IDEAL_GENERATED_UNION] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [PRINCIPAL_IDEAL_IDEAL_GENERATED_SING])

  let PID_EQ_NOETHERIAN_BEZOUT_DOMAIN ← prove
   r"!r:A ring. PID r <=>
              integral_domain r /\
              noetherian_ring r /\
              bezout_ring r"
   (REWRITE_TAC [PID, noetherian_ring, bezout_ring] THEN
    MESON_TAC [PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL,
               FINITELY_GENERATED_IMP_RING_IDEAL])

  let BEZOUT_RING_IMP_BEZOUT ← prove
   r"!r a b:A.
        bezout_ring r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> ?d. d IN ring_carrier r /\
                ring_divides r d a /\ ring_divides r d b /\
                ?x y. x IN ring_carrier r /\ y IN ring_carrier r /\
                      ring_add r (ring_mul r a x) (ring_mul r b y) = d"
   (REWRITE_TAC [bezout_ring] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "ideal_generated r {a:A,b}")) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [finitely_generated_ideal] THEN
      EXISTS_TAC (← q "{a:A,b}") THEN
      ASM_SIMP_TAC [INSERT_SUBSET, EMPTY_SUBSET, FINITE_RULES],
      ALL_TAC] THEN
    REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED, principal_ideal] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "d:A") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EXTENSION]) THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_SING, IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q "d:A")) THEN ASM_REWRITE_TAC [RING_DIVIDES_REFL] THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_INC, IN_INSERT,
                  INSERT_SUBSET, EMPTY_SUBSET] THEN
    ONCE_REWRITE_TAC [IDEAL_GENERATED_INSERT] THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_SING_ALT] THEN
    REWRITE_TAC [ring_setadd, IN_ELIM_THM] THEN MESON_TAC [])

  let RING_IMP_GCD_EXISTS ← prove
   r"!r a b:A.
        (UFD r \/ bezout_ring r) /\
        a IN ring_carrier r /\ b IN ring_carrier r
        ==> ?d. d IN ring_carrier r /\
                ring_divides r d a /\ ring_divides r d b /\
                !d'. ring_divides r d' a /\ ring_divides r d' b
                     ==> ring_divides r d' d"
   (REPEAT STRIP_TAC THENL [ASM_SIMP_TAC [UFD_IMP_GCD_EXISTS], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "b:A"] BEZOUT_RING_IMP_BEZOUT) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_SIMP_TAC [RING_DIVIDES_ADD, RING_DIVIDES_RMUL])

  let BEZOUT_RING_IMP_GCD ← prove
   r"!r a b:A.
        bezout_ring r /\
        a IN ring_carrier r /\ b IN ring_carrier r
        ==> ?x y. x IN ring_carrier r /\ y IN ring_carrier r /\
                  ring_add r (ring_mul r a x) (ring_mul r b y) =
                  ring_gcd r (a,b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "b:A"] BEZOUT_RING_IMP_BEZOUT) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q "d:A") THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "b:A", ← q "d:A"] RING_GCD_UNIQUE) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [RING_DIVIDES_ADD, RING_DIVIDES_RMUL],
      GEN_REWRITE_TAC LAND_CONV [RING_ASSOCIATES_SYM]] THEN
    DISCH_THEN (MP_TAC o MATCH_MP RING_DIVIDES_ASSOCIATES) THEN
    REWRITE_TAC [ring_divides] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "u:A") (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
    MAP_EVERY EXISTS_TAC [← q "ring_mul r x u:A", ← q "ring_mul r y u:A"] THEN
    ASM_SIMP_TAC [RING_MUL_ASSOC, RING_MUL, ← GSYM RING_ADD_RDISTRIB])

  let BEZOUT_RING ← prove
   r"!r:A ring.
        bezout_ring r <=>
        !a b. a IN ring_carrier r /\ b IN ring_carrier r
              ==> ?d x y. d IN ring_carrier r /\
                          x IN ring_carrier r /\ y IN ring_carrier r /\
                          ring_add r (ring_mul r a x) (ring_mul r b y) = d /\
                          ring_divides r d a /\ ring_divides r d b"
   (GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN EXISTS_TAC (← q "ring_gcd r (a:A,b)") THEN
      ASM_SIMP_TAC [RING_GCD_DIVIDES, RING_GCD, BEZOUT_RING_IMP_GCD],
      DISCH_TAC THEN REWRITE_TAC [BEZOUT_RING_2, principal_ideal]] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "a:A", ← q "b:A"]) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "d:A") THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "u:A", ← q "v:A"] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    CONJ_TAC THEN MATCH_MP_TAC IDEAL_GENERATED_MINIMAL THEN
    ASM_SIMP_TAC [RING_IDEAL_IDEAL_GENERATED, INSERT_SUBSET, EMPTY_SUBSET] THENL
     [ASM_SIMP_TAC [IDEAL_GENERATED_2, IN_ELIM_THM] THEN ASM SET_TAC [],
      ASM_SIMP_TAC [IDEAL_GENERATED_SING, IN_ELIM_THM]])

  let BEZOUT_RING_COPRIME ← prove
   r"!r a b:A.
        bezout_ring r
        ==> (ring_coprime r (a,b) <=>
             a IN ring_carrier r /\ b IN ring_carrier r /\
             ?x y. x IN ring_carrier r /\ y IN ring_carrier r /\
                   ring_add r (ring_mul r a x) (ring_mul r b y) = ring_1 r)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [ring_coprime]] THEN
    ASM_CASES_TAC (← q "(b:A) IN ring_carrier r") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [ring_coprime]] THEN
    EQ_TAC THENL
     [MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "b:A"] RING_GCD_EQ_1) THEN
      ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN (SUBST1_TAC o SYM)) THEN
      MATCH_MP_TAC BEZOUT_RING_IMP_GCD THEN ASM_REWRITE_TAC [],
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      ASM_REWRITE_TAC [ring_coprime, ← GSYM RING_DIVIDES_ONE] THEN
      ASM_SIMP_TAC [RING_DIVIDES_ADD, RING_DIVIDES_RMUL]])

  let BEZOUT_RING_COPRIME_COMAXIMAL ← prove
   r"!r a b:A.
        bezout_ring r
        ==> (ring_coprime r (a,b) <=>
             a IN ring_carrier r /\
             b IN ring_carrier r /\
             ring_setadd r (ideal_generated r {a}) (ideal_generated r {b}) =
             ring_carrier r)"
   (SIMP_TAC [BEZOUT_RING_COPRIME, RING_IDEAL_EQ_CARRIER, RING_IDEAL_SETADD,
              RING_IDEAL_IDEAL_GENERATED] THEN
    REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q "(b:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_SING_ALT, ring_setadd, IN_ELIM_THM] THEN
    ASM_MESON_TAC [])

  let BEZOUT_RING_COMAXIMAL_COPRIME ← prove
   r"!r j k:A->bool.
        bezout_ring r /\ ring_ideal r j /\ ring_ideal r k
        ==> (ring_setadd r j k = ring_carrier r <=>
             ?a b. a IN j /\ b IN k /\ ring_coprime r (a,b))"
   (SIMP_TAC [RING_IDEAL_EQ_CARRIER, RING_IDEAL_SETADD, BEZOUT_RING_COPRIME] THEN
    REWRITE_TAC [ring_setadd, IN_ELIM_THM] THEN
    ASM_MESON_TAC [RING_MUL_RID, SUBSET, RING_IDEAL_IMP_SUBSET,
                   IN_RING_IDEAL_RMUL, RING_1])

  let RING_DIVIDES_GCD ← prove
   r"!r a b d:A.
        (UFD r \/ bezout_ring r) /\ ring_divides r d a /\ ring_divides r d b
        ==> ring_divides r d (ring_gcd r (a,b))"
   (MESON_TAC [← REWRITE_RULE [← GSYM RING_GCD_WORKS] RING_IMP_GCD_EXISTS,
               RING_DIVIDES_IN_CARRIER])

  let RING_DIVIDES_GCD_EQ ← prove
   r"!r a b d:A.
        (UFD r \/ bezout_ring r) /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_divides r d (ring_gcd r (a,b)) <=>
             ring_divides r d a /\ ring_divides r d b)"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    EQ_TAC THEN ASM_SIMP_TAC [RING_DIVIDES_GCD] THEN
    DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] RING_DIVIDES_TRANS) THEN
    ASM_REWRITE_TAC [RING_GCD_DIVIDES])

  let BEZOUT_RING_IRREDUCIBLE_IMP_PRIME ← prove
   r"!r p:A. bezout_ring r /\ ring_irreducible r p ==> ring_prime r p"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_irreducible, ring_prime] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
    REWRITE_TAC [← TAUT (← q r"p \/ q <=> ~p ==> q")] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "p:A", ← q "a:A"] o
          MATCH_MP BEZOUT_RING_COPRIME) THEN
    ASM_SIMP_TAC [RING_IRREDUCIBLE_COPRIME_EQ, ring_irreducible] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    SUBGOAL_THEN (← q "b:A = ring_mul r b (ring_1 r:A)") SUBST1_TAC THENL
     [ASM_MESON_TAC [RING_MUL_RID], ASM_REWRITE_TAC []] THEN
    ASM_SIMP_TAC [RING_ADD_LDISTRIB, ← GSYM RING_MUL_ASSOC, RING_MUL] THEN
    MATCH_MP_TAC RING_DIVIDES_ADD THEN
    ASM_MESON_TAC [RING_MUL_AC, RING_MUL, RING_DIVIDES_RMUL, RING_DIVIDES_REFL])

  let BEZOUT_DOMAIN_IRREDUCIBLE_EQ_PRIME ← prove
   r"!r p:A. integral_domain r /\ bezout_ring r
           ==> (ring_irreducible r p <=> ring_prime r p)"
   (MESON_TAC [BEZOUT_RING_IRREDUCIBLE_IMP_PRIME,
               INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE])

  let PID_EQ_ACCP_BEZOUT_DOMAIN ← prove
   r"!r:A ring.
        PID r <=>
        integral_domain r /\
        bezout_ring r /\
        WF (\x y. ring_divides r x y /\ ~ring_divides r y x)"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [PID_IMP_UFD, PID_IMP_BEZOUT_RING, RING_DIVIDES_WF,
              PID_IMP_INTEGRAL_DOMAIN] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [PID] THEN
    X_GEN_TAC (← q r"j:A->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_IDEAL_IMP_SUBSET) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\x:A. x IN j") o GEN_REWRITE_RULE id [WF]) THEN
    ASM_REWRITE_TAC [principal_ideal] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [IN_RING_IDEAL_0], MATCH_MP_TAC MONO_EXISTS] THEN
    X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM SET_TAC [], DISCH_TAC] THEN
    ASM_SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, IDEAL_GENERATED_MINIMAL_EQ] THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [SUBSET]] THEN
    X_GEN_TAC (← q "b:A") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_SING, IN_ELIM_THM] THEN
    SUBGOAL_THEN (← q "(b:A) IN ring_carrier r") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "ring_gcd r (a,b):A")) THEN
    ASM_SIMP_TAC [RING_GCD_DIVIDES, RING_DIVIDES_GCD_EQ] THEN
    ASM_REWRITE_TAC [CONTRAPOS_THM, RING_DIVIDES_REFL] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "a:A", ← q "b:A"] BEZOUT_RING_IMP_GCD) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_SIMP_TAC [IN_RING_IDEAL_ADD, IN_RING_IDEAL_RMUL])

  let PID_EQ_UFD_BEZOUT_RING ← prove
   r"!r:A ring. PID r <=> UFD r /\ bezout_ring r"
   (GEN_TAC THEN EQ_TAC THEN SIMP_TAC [PID_IMP_UFD, PID_IMP_BEZOUT_RING] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [PID_EQ_ACCP_BEZOUT_DOMAIN] THEN
    ASM_SIMP_TAC [UFD_IMP_INTEGRAL_DOMAIN, RING_DIVIDES_WF])

  let PID_EQ_BEZOUT_ATOMIC ← prove
   r"!r:A ring.
        PID r <=>
        integral_domain r /\
        bezout_ring r /\
        !x. x IN ring_carrier r /\ ~(x = ring_0 r)
            ==> ?n p. (!i. 1 <= i /\ i <= n ==> ring_irreducible r (p i)) /\
                      ring_associates r (ring_product r (1..n) p) x"
   (REWRITE_TAC [PID_EQ_UFD_BEZOUT_RING, UFD_EQ_ATOMIC] THEN
    MESON_TAC [BEZOUT_RING_IRREDUCIBLE_IMP_PRIME])

  let BEZOUT_RING_EPIMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B).
        ring_epimorphism(r,r') f /\ bezout_ring r ==> bezout_ring r'"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [bezout_ring, finitely_generated_ideal] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← MESON [] (← q r"(!x. a = x ==> P x) <=> P a")] THEN
    REWRITE_TAC [IMP_IMP] THEN FIRST_ASSUM
     (SUBST1_TAC o SYM o CONJUNCT2 o REWRITE_RULE [ring_epimorphism]) THEN
    REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"s:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [PRINCIPAL_IDEAL_EPIMORPHIC_IMAGE,
                   IDEAL_GENERATED_BY_EPIMORPHIC_IMAGE])

  let BEZOUT_QUOTIENT_RING ← prove
   r"!r j:A->bool.
        bezout_ring r /\ ring_ideal r j
        ==> bezout_ring (quotient_ring r j)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] BEZOUT_RING_EPIMORPHIC_IMAGE) THEN
    ASM_MESON_TAC [RING_EPIMORPHISM_RING_COSET])

  let ISOMORPHIC_RING_BEZOUTNESS ← prove
   r"!(r:A ring) (r':B ring).
        r isomorphic_ring r' ==> (bezout_ring r <=> bezout_ring r')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [isomorphic_ring] THEN
    REWRITE_TAC [ring_isomorphism, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [RING_ISOMORPHISMS_ISOMORPHISM] THEN REPEAT STRIP_TAC THEN
    ASM_MESON_TAC [BEZOUT_RING_EPIMORPHIC_IMAGE,
                   RING_ISOMORPHISM_IMP_EPIMORPHISM])

  let RING_COPRIME_HOMOMORPHIC_IMAGE ← prove
   r"!r s (f:A->B) a b.
     ring_homomorphism(r,s) f /\
     bezout_ring r /\
     ring_coprime r (a,b)
     ==> ring_coprime s (f a, f b)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN DISCH_TAC THEN
    SIMP_TAC [BEZOUT_RING_COPRIME] THEN REPEAT STRIP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
    FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"f:A->B")) THEN ASM_SIMP_TAC [RING_MUL] THEN
    ASM_SIMP_TAC [ring_coprime, RING_UNIT_DIVIDES] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_MESON_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_ADD])

  let BEZOUT_RING_LOCALIZATION ← prove
   r"!r (s:A->bool).
        ring_multsys r s /\ bezout_ring r
        ==> bezout_ring (ring_localization r s)"
   (← do
    let ss ← ExceptT.mk (basic_ss [])
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [BEZOUT_RING] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_multsys]) THEN
    REWRITE_TAC [SUBSET] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [RING_LOCALIZATION_CARRIER] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN X_GEN_TAC (← q "p:A") THEN DISCH_TAC THEN
    X_GEN_TAC (← q "b:A") THEN DISCH_TAC THEN X_GEN_TAC (← q "q:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "a:A", ← q "b:A"] o
      GEN_REWRITE_RULE id [BEZOUT_RING]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "d:A", ← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q "ring_fractionate r s (d:A)",
      ← q "ring_fractionate r s (ring_mul r p x:A)",
      ← q "ring_fractionate r s (ring_mul r q y:A)"] THEN
    ASM_SIMP_TAC [RING_FRACTIONATE_IN_CARRIER, ← GSYM RING_LOCALIZATION_CARRIER,
                  RING_DIVIDES_LOCALEQUIV, RING_MUL] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_HOMOMORPHISM_FRACTIONATE) THEN
    REWRITE_TAC [ring_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [RING_MUL] THEN
    ASM (simpTac ss 6)
     [ring_fractionate, RING_LOCALIZATION_MUL, RING_LOCALIZATION_ADD,
      RING_MUL, RING_1, RING_MUL_LID, RING_MUL_RID, RING_ADD,
      ← GSYM RING_LOCALEQUIV_EQUIV, ring_localequiv] THEN
    EXISTS_TAC (← q "ring_1 r:A") THEN ASM_SIMP_TAC [] THEN
    RING_TAC THEN ASM_SIMP_TAC []))

  let PID_RING_LOCALIZATION ← prove
   r"!r s:A->bool.
        ring_multsys r s /\ PID r /\ ~(ring_0 r IN s)
        ==> PID (ring_localization r s)"
   (SIMP_TAC [PID_EQ_NOETHERIAN_BEZOUT_DOMAIN, BEZOUT_RING_LOCALIZATION,
              INTEGRAL_DOMAIN_LOCALIZATION, NOETHERIAN_RING_LOCALIZATION])

  -- @@RETURN BEGIN
  return { bezout_ring, BEZOUT_RING_FINITELY_GENERATED_EQ_PRINCIPAL_IDEAL,
           PID_IMP_BEZOUT_RING, FIELD_IMP_BEZOUT_RING, BEZOUT_RING_2, BEZOUT_RING_SETADD,
           PID_EQ_NOETHERIAN_BEZOUT_DOMAIN, BEZOUT_RING_IMP_BEZOUT, RING_IMP_GCD_EXISTS,
           BEZOUT_RING_IMP_GCD, BEZOUT_RING, BEZOUT_RING_COPRIME,
           BEZOUT_RING_COPRIME_COMAXIMAL, BEZOUT_RING_COMAXIMAL_COPRIME,
           RING_DIVIDES_GCD, RING_DIVIDES_GCD_EQ, BEZOUT_RING_IRREDUCIBLE_IMP_PRIME,
           BEZOUT_DOMAIN_IRREDUCIBLE_EQ_PRIME, PID_EQ_ACCP_BEZOUT_DOMAIN,
           PID_EQ_UFD_BEZOUT_RING, PID_EQ_BEZOUT_ATOMIC, BEZOUT_RING_EPIMORPHIC_IMAGE,
           BEZOUT_QUOTIENT_RING, ISOMORPHIC_RING_BEZOUTNESS,
           RING_COPRIME_HOMOMORPHIC_IMAGE, BEZOUT_RING_LOCALIZATION,
           PID_RING_LOCALIZATION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- More divisibility properties that need something like GCD domain.        -/
/- (ringtheory.ml 15559-15781)                                               -/
/- ------------------------------------------------------------------------- -/

structure GcdDomain where
  -- @@FIELDS
  RING_GCD_LMUL : thm
  RING_GCD_RMUL : thm
  RING_COPRIME_DIVPROD_LEFT : thm
  RING_COPRIME_DIVPROD_RIGHT : thm
  RING_DIVIDES_MUL : thm
  RING_DIVIDES_MUL_EQ : thm
  RING_COPRIME_LMUL : thm
  RING_COPRIME_RMUL : thm
  RING_COPRIME_PRODUCT_EQ : thm
  RING_COPRIME_PRODUCT : thm
  RING_COPRIME_RPOW : thm
  RING_COPRIME_LPOW : thm
  RING_COPRIME_PRODUCT_DIVIDES_ALT : thm
  RING_COPRIME_PRODUCT_DIVIDES : thm
  deriving Inhabited

@[nospecialize]
def setupGcdDomain [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BProducts : Products) (BDivides : Divides) (BDomains : Domains) (BUFDs : UFDs) (BRingGcd : RingGcd) (BBezout : Bezout) :
    ExceptT String IO GcdDomain := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, .. } := D
  let { COND_SWAP, EQ_TRANS, .. } := D.core2
  let { FINITE_INDUCT_STRONG, FORALL_IN_INSERT, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { NOT_IN_EMPTY, PAIRWISE_INSERT, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SWAP_FORALL_THM, .. } := D.core7
  let { RING_0, RING_1, RING_MUL, RING_MUL_LID, RING_MUL_LZERO, RING_MUL_SYM, .. } := BBasics
  let { RING_POW, ring_pow, .. } := BNumbers
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, .. } := BProducts
  let { RING_ASSOCIATES_MUL, RING_ASSOCIATES_REFL, RING_ASSOCIATES_SAME_DIVISORS,
        RING_COPRIME_IN_CARRIER, RING_COPRIME_SYM, RING_DIVIDES_1,
        RING_DIVIDES_IN_CARRIER, RING_DIVIDES_LMUL, RING_DIVIDES_MUL2,
        RING_DIVIDES_ONE, RING_DIVIDES_REFL, RING_DIVIDES_RMUL, RING_DIVIDES_RMUL_REV,
        RING_DIVIDES_TRANS, ring_associates, ring_coprime, ring_divides, .. } := BDivides
  let { INTEGRAL_DOMAIN_DIVIDES_LMUL2, .. } := BDomains
  let { UFD, .. } := BUFDs
  let { RING_GCD, RING_GCD_00, RING_GCD_EQ_1, .. } := BRingGcd
  let { RING_DIVIDES_GCD_EQ, .. } := BBezout
  -- @@SCOPE END

  let RING_GCD_LMUL ← prove
   r"!r a b c:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r
        ==> ring_associates r (ring_gcd r (ring_mul r c a,ring_mul r c b))
                              (ring_mul r c (ring_gcd r (a,b)))"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q "integral_domain(r:A ring)") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [UFD]] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_CASES_TAC (← q "c:A = ring_0 r") THENL
     [ASM_SIMP_TAC [RING_MUL_LZERO, RING_GCD_00, RING_ASSOCIATES_REFL,
                    RING_GCD, RING_0],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q "ring_divides r (c:A) (ring_gcd r (ring_mul r c a,ring_mul r c b))")
    MP_TAC THENL
     [ASM_SIMP_TAC [RING_DIVIDES_GCD_EQ, RING_MUL] THEN
      ASM_SIMP_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_REFL],
      GEN_REWRITE_TAC LAND_CONV [ring_divides]] THEN
    DISCH_THEN (fun th => tactic_of do
      match (CONJUNCTS th).getLast? with
      | some c => pure (X_CHOOSE_THEN (← q "e:A") STRIP_ASSUME_TAC c)
      | none => throw "last") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC RING_ASSOCIATES_MUL THEN
    ASM_REWRITE_TAC [RING_ASSOCIATES_REFL] THEN
    ASM_REWRITE_TAC [RING_ASSOCIATES_SAME_DIVISORS, RING_GCD] THEN
    X_GEN_TAC (← q "d:A") THEN DISCH_TAC THEN
    TRANS_TAC EQ_TRANS (← q "ring_divides r (ring_mul r c d) (ring_mul r c e:A)") THEN
    CONJ_TAC THENL [ASM_SIMP_TAC [INTEGRAL_DOMAIN_DIVIDES_LMUL2], ALL_TAC] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [RING_DIVIDES_GCD_EQ, RING_MUL, INTEGRAL_DOMAIN_DIVIDES_LMUL2])

  let RING_GCD_RMUL ← prove
   r"!r a b c:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r
        ==> ring_associates r (ring_gcd r (ring_mul r a c,ring_mul r b c))
                              (ring_mul r (ring_gcd r (a,b)) c)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_GCD_LMUL) THEN
    ASM_MESON_TAC [RING_MUL_SYM, RING_MUL, RING_GCD])

  let RING_COPRIME_DIVPROD_LEFT ← prove
   r"!r a b c:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        a IN ring_carrier r /\ b IN ring_carrier r /\
        ring_divides r c (ring_mul r a b) /\ ring_coprime r (a,c)
        ==> ring_divides r c b"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q "integral_domain(r:A ring)") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [UFD]] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_CASES_TAC (← q "(c:A) IN ring_carrier r") THENL
     [ALL_TAC, ASM_MESON_TAC [ring_divides]] THEN
    SUBGOAL_THEN (← q "b:A = ring_mul r (ring_gcd r (a,c)) b") SUBST1_TAC THENL
     [ASM_MESON_TAC [RING_GCD_EQ_1, RING_MUL_LID], ALL_TAC] THEN
    wPart rand (fun t => do rand (← rand t)) RING_GCD_RMUL THEN
    ASM_REWRITE_TAC [ring_associates] THEN DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] RING_DIVIDES_TRANS) THEN
    ASM_SIMP_TAC [RING_DIVIDES_GCD_EQ, RING_MUL] THEN
    ASM_SIMP_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_REFL])

  let RING_COPRIME_DIVPROD_RIGHT ← prove
   r"!r a b c:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        a IN ring_carrier r /\ b IN ring_carrier r /\
        ring_divides r c (ring_mul r a b) /\ ring_coprime r (b,c)
        ==> ring_divides r c a"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "b:A", ← q "a:A", ← q "c:A"]
     RING_COPRIME_DIVPROD_LEFT) THEN
    ASM_MESON_TAC [RING_MUL_SYM])

  let RING_DIVIDES_MUL ← prove
   r"!r a b c:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        ring_coprime r (a,b) /\ ring_divides r a c /\ ring_divides r b c
        ==> ring_divides r (ring_mul r a b) c"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q "integral_domain(r:A ring)") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [UFD]] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THENL
     [ALL_TAC, ASM_MESON_TAC [ring_divides]] THEN
    ASM_CASES_TAC (← q "(b:A) IN ring_carrier r") THENL
     [ALL_TAC, ASM_MESON_TAC [ring_divides]] THEN
    ASM_CASES_TAC (← q "(c:A) IN ring_carrier r") THENL
     [ALL_TAC, ASM_MESON_TAC [ring_divides]] THEN
    SUBGOAL_THEN (← q "c:A = ring_mul r (ring_gcd r (a,b)) c") SUBST1_TAC THENL
     [ASM_MESON_TAC [RING_GCD_EQ_1, RING_MUL_LID], ALL_TAC] THEN
    wPart rand (fun t => do rand (← rand t)) RING_GCD_RMUL THEN
    ASM_REWRITE_TAC [ring_associates] THEN DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] RING_DIVIDES_TRANS) THEN
    ASM_SIMP_TAC [RING_DIVIDES_GCD_EQ, RING_MUL] THEN
    ASM_MESON_TAC [RING_DIVIDES_MUL2, RING_DIVIDES_REFL, RING_MUL_SYM])

  let RING_DIVIDES_MUL_EQ ← prove
   r"!r a b c:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        ring_coprime r (a,b)
        ==> (ring_divides r (ring_mul r a b) c <=>
             ring_divides r a c /\ ring_divides r b c)"
   (MESON_TAC [RING_DIVIDES_MUL, RING_DIVIDES_RMUL_REV,
               RING_MUL_SYM, ring_coprime])

  let RING_COPRIME_LMUL ← prove
   r"!r a b c:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r
        ==> (ring_coprime r (ring_mul r a b,c) <=>
             ring_coprime r (a,c) /\ ring_coprime r (b,c))"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q "integral_domain(r:A ring)") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [UFD]] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_SIMP_TAC [ring_coprime, RING_MUL] THEN EQ_TAC THENL
     [ASM_MESON_TAC [RING_DIVIDES_LMUL, RING_DIVIDES_RMUL, RING_DIVIDES_TRANS,
                     RING_DIVIDES_REFL],
      DISCH_TAC] THEN
    X_GEN_TAC (← q "d:A") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q "(d:A) IN ring_carrier r") THENL
     [ALL_TAC, ASM_MESON_TAC [ring_divides]] THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MATCH_MP_TAC) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC RING_COPRIME_DIVPROD_LEFT THEN
    EXISTS_TAC (← q "a:A") THEN ASM_REWRITE_TAC [] THEN
    ASM_REWRITE_TAC [ring_coprime] THEN ASM_MESON_TAC [RING_DIVIDES_TRANS])

  let RING_COPRIME_RMUL ← prove
   r"!r a b c:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r
        ==> (ring_coprime r (a,ring_mul r b c) <=>
             ring_coprime r (a,b) /\ ring_coprime r (a,c))"
   (ONCE_REWRITE_TAC [RING_COPRIME_SYM] THEN SIMP_TAC [RING_COPRIME_LMUL])

  let RING_COPRIME_PRODUCT_EQ ← prove
   r"!r (a:A) (f:K->A) s.
     (UFD r \/ integral_domain r /\ bezout_ring r) /\
     a IN ring_carrier r /\ FINITE s /\
     (!i. i IN s ==> f i IN ring_carrier r)
     ==> (ring_coprime r (a, ring_product r s f) <=>
          !i. i IN s ==> ring_coprime r (a, f i))"
   (GEN_TAC THEN GEN_TAC THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [RING_PRODUCT_CLAUSES, NOT_IN_EMPTY, FORALL_IN_INSERT] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [ring_coprime, RING_1] THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [RING_DIVIDES_ONE], ALL_TAC] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f:K->A) x IN ring_carrier r") ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [RING_COPRIME_RMUL, RING_PRODUCT])

  let RING_COPRIME_PRODUCT ← prove
   r"!r (a:A) (f:K->A) s.
     (UFD r \/ integral_domain r /\ bezout_ring r) /\
     a IN ring_carrier r /\ FINITE s /\
     (!i. i IN s ==> ring_coprime r (a, f i))
     ==> ring_coprime r (a, ring_product r s f)"
   (MESON_TAC [RING_COPRIME_PRODUCT_EQ, RING_COPRIME_IN_CARRIER])

  let RING_COPRIME_RPOW ← prove
   r"!r a (b:A) n.
     (UFD r \/ integral_domain r /\ bezout_ring r) /\
     a IN ring_carrier r /\ b IN ring_carrier r /\
     ring_coprime r (a, b)
     ==> ring_coprime r (a, ring_pow r b n)"
   (GEN_TAC THEN GEN_TAC THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT DISCH_TAC THEN INDUCT_TAC THENL
     [REWRITE_TAC [ring_pow, ring_coprime, RING_1] THEN
      ASM_MESON_TAC [RING_DIVIDES_ONE],
      ASM_SIMP_TAC [ring_pow, RING_COPRIME_RMUL, RING_POW]])

  let RING_COPRIME_LPOW ← prove
   r"!r a (b:A) n.
     (UFD r \/ integral_domain r /\ bezout_ring r) /\
     a IN ring_carrier r /\ b IN ring_carrier r /\
     ring_coprime r (a, b)
     ==> ring_coprime r (ring_pow r a n, b)"
   (MESON_TAC [RING_COPRIME_RPOW, RING_COPRIME_SYM])

  let RING_COPRIME_PRODUCT_DIVIDES_ALT ← prove
   r"!r p (s:K->bool) x:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        FINITE s /\
        x IN ring_carrier r /\
        pairwise (\i j. ring_coprime r (p i,p j)) s
        ==> ((!i. i IN s ==> ring_divides r (p i) x) <=>
             (!i. i IN s ==> p i IN ring_carrier r) /\
             ring_divides r (ring_product r s p) x)"
   (GEN_TAC THEN GEN_TAC THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN GEN_TAC THEN
    ASM_CASES_TAC (← q "(x:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    DISCH_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, NOT_IN_EMPTY, FORALL_IN_INSERT] THEN
    ASM_REWRITE_TAC [RING_DIVIDES_1, PAIRWISE_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q "i:K", ← q r"s:K->bool"] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [COND_SWAP] THEN COND_CASES_TAC THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [RING_DIVIDES_IN_CARRIER]] THEN
    ASM_CASES_TAC (← q r"!i. i IN s ==> (p:K->A) i IN ring_carrier r") THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC RING_DIVIDES_MUL_EQ THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC RING_COPRIME_PRODUCT THEN ASM_MESON_TAC [])

  let RING_COPRIME_PRODUCT_DIVIDES ← prove
   r"!r p (s:K->bool) x:A.
        (UFD r \/ integral_domain r /\ bezout_ring r) /\
        FINITE s /\
        x IN ring_carrier r /\
        (!i. i IN s ==> p i IN ring_carrier r) /\
        pairwise (\i j. ring_coprime r (p i,p j)) s
        ==> (ring_divides r (ring_product r s p) x <=>
             !i. i IN s ==> ring_divides r (p i) x)"
   (MESON_TAC [RING_COPRIME_PRODUCT_DIVIDES_ALT])

  -- @@RETURN BEGIN
  return { RING_GCD_LMUL, RING_GCD_RMUL, RING_COPRIME_DIVPROD_LEFT,
           RING_COPRIME_DIVPROD_RIGHT, RING_DIVIDES_MUL, RING_DIVIDES_MUL_EQ,
           RING_COPRIME_LMUL, RING_COPRIME_RMUL, RING_COPRIME_PRODUCT_EQ,
           RING_COPRIME_PRODUCT, RING_COPRIME_RPOW, RING_COPRIME_LPOW,
           RING_COPRIME_PRODUCT_DIVIDES_ALT, RING_COPRIME_PRODUCT_DIVIDES }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Additional properties of squarefree elements, mainly assuming UFD etc.   -/
/- (ringtheory.ml 15781-16001)                                               -/
/- ------------------------------------------------------------------------- -/

structure SquarefreeUFD where
  -- @@FIELDS
  RING_SQUAREFREE_GCD : thm
  RING_SQUAREFREE_PRIME_EQ : thm
  RING_SQUAREFREE_PRIME_DIVISOR_EQ : thm
  RING_SQUAREFREE_DIVIDES : thm
  RING_SQUAREFREE_DIVPOW : thm
  RING_SQUAREFREE_DIVPOW_EQ : thm
  RING_SQUAREFREE_DIVIDES_SQUARE : thm
  RING_SQUAREFREE_MUL_EQ : thm
  RING_SQUAREFREE_PRODUCT : thm
  RING_SQUAREFREE_ALT : thm
  RING_SQUAREFREE : thm
  RING_SQUAREFREE_DECOMPOSITION : thm
  deriving Inhabited

@[nospecialize]
def setupSquarefreeUFD [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BProducts : Products) (BDivides : Divides) (BDomains : Domains) (BRingRule : RingRule) (BPrimes : Primes) (BSquarefree : Squarefree) (BUFDs : UFDs) (BRingGcd : RingGcd) (BGcdDomain : GcdDomain) :
    ExceptT String IO SquarefreeUFD := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { DE_MORGAN_THM, .. } := D.core2
  let { FINITE_INDUCT_STRONG, FORALL_IN_INSERT, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { MONO_EXISTS, MONO_FORALL, NOT_IMP, NOT_IN_EMPTY, PAIRWISE_EMPTY,
        PAIRWISE_INSERT, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, .. } := D.core7
  let { num_CASES, .. } := D.core8
  let { RING_0, RING_1, RING_MUL, RING_MUL_LZERO, RING_MUL_RID, RING_MUL_RZERO,
        TRIVIAL_RING_10, .. } := BBasics
  let { RING_POW, RING_POW_2, RING_POW_ONE, RING_POW_ZERO, ring_pow, .. } := BNumbers
  let { RING_PRODUCT, RING_PRODUCT_CLAUSES, .. } := BProducts
  let { RING_COPRIME_DIVISORS, RING_COPRIME_SYM, RING_DIVIDES_LMUL,
        RING_DIVIDES_LMUL_REV, RING_DIVIDES_MUL2, RING_DIVIDES_ONE, RING_DIVIDES_REFL,
        RING_DIVIDES_RMUL, RING_DIVIDES_TRANS, RING_DIVIDES_ZERO,
        RING_UNIT_DIVIDES_ANY, ring_divides, ring_unit, .. } := BDivides
  let { INTEGRAL_DOMAIN_DIVIDES_RMUL2, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING,
        INTEGRAL_DOMAIN_MUL_EQ_0, integral_domain, .. } := BDomains
  let { RING_TAC, .. } := BRingRule
  let { INTEGRAL_DOMAIN_PRIME_COPRIME_EQ, RING_PRIME_DIVIDES_MUL,
        RING_PRIME_DIVIDES_POW, RING_PRIME_IN_CARRIER, ring_prime, .. } := BPrimes
  let { RING_PRIME_IMP_SQUAREFREE, RING_SQUAREFREE_0, RING_SQUAREFREE_1,
        RING_SQUAREFREE_DIVISOR, RING_SQUAREFREE_IMP_NONZERO,
        RING_SQUAREFREE_IMP_NO_PRIME_SQUARE, RING_SQUAREFREE_IN_CARRIER,
        RING_SQUAREFREE_MUL_IMP, RING_UNIT_IMP_SQUAREFREE, ring_squarefree, .. } := BSquarefree
  let { UFD, UFD_IMP_INTEGRAL_DOMAIN, UFD_PRIME_FACTOR_EXISTS, UFD_PRIME_FACTOR_INDUCT, .. } := BUFDs
  let { RING_GCD_DIVIDES, .. } := BRingGcd
  let { RING_COPRIME_DIVPROD_LEFT, RING_COPRIME_DIVPROD_RIGHT, RING_COPRIME_PRODUCT_EQ,
        RING_COPRIME_RPOW, RING_DIVIDES_MUL, .. } := BGcdDomain
  -- @@SCOPE END

  let RING_SQUAREFREE_GCD ← prove
   r"!r (a:A) b. ring_squarefree r a \/ ring_squarefree r b
               ==> ring_squarefree r (ring_gcd r (a,b))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC RING_SQUAREFREE_DIVISOR THENL
     [EXISTS_TAC (← q "a:A"), EXISTS_TAC (← q "b:A")] THEN
    ASM_MESON_TAC [RING_GCD_DIVIDES, RING_SQUAREFREE_IN_CARRIER])

  let RING_SQUAREFREE_PRIME_EQ ← prove
   r"!r (a:A). UFD r /\ a IN ring_carrier r /\ ~(a = ring_0 r)
             ==> (ring_squarefree r a <=>
                  !p. ring_prime r p ==> ~ring_divides r (ring_pow r p 2) a)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [RING_SQUAREFREE_IMP_NO_PRIME_SQUARE], ALL_TAC] THEN
    REWRITE_TAC [ring_squarefree] THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q "q:A") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q "ring_unit r (q:A)") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q "q:A = ring_0 r") THENL
     [ASM_MESON_TAC [RING_POW_ZERO, ← ARITH_RULE (← q "~(2 = 0)"),
                     RING_DIVIDES_ZERO], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "q:A"] UFD_PRIME_FACTOR_EXISTS) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "p:A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "p:A")) THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q "ring_divides r (ring_pow r (p:A) 2) (ring_pow r q 2)")
        ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_DIVIDES_MUL2, RING_POW_2, ring_prime, ring_divides],
      ASM_MESON_TAC [RING_DIVIDES_TRANS]])

  let RING_SQUAREFREE_PRIME_DIVISOR_EQ ← prove
   r"!r (a:A).
        UFD r /\ a IN ring_carrier r /\ ~(a = ring_0 r)
        ==> (ring_squarefree r a <=>
             !p. ring_prime r p /\ ring_divides r p a
                 ==> ~ring_divides r (ring_pow r p 2) a)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [RING_SQUAREFREE_PRIME_EQ] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN
    MESON_TAC [RING_DIVIDES_LMUL_REV, ring_prime, RING_POW_2])

  let RING_SQUAREFREE_DIVIDES ← prove
   r"!r q n:A.
        UFD r /\ ring_squarefree r q /\ ~(q = ring_0 r) /\ n IN ring_carrier r
        ==> (ring_divides r q n <=>
             !p. ring_prime r p /\ ring_divides r p q ==> ring_divides r p n)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q "~trivial_ring (r:A ring)") ASSUME_TAC THENL
     [ASM_MESON_TAC [INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, UFD_IMP_INTEGRAL_DOMAIN],
      ONCE_REWRITE_TAC [← MESON [ring_squarefree]
       (← q r"ring_squarefree r x <=> x IN ring_carrier r /\ ring_squarefree r x")]] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC UFD_PRIME_FACTOR_INDUCT THEN
    ASM_REWRITE_TAC [RING_SQUAREFREE_0] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [RING_UNIT_DIVIDES_ANY, RING_DIVIDES_TRANS], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [RING_DIVIDES_TRANS], DISCH_TAC] THEN
    MATCH_MP_TAC RING_DIVIDES_MUL THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [RING_SQUAREFREE_MUL_IMP, RING_SQUAREFREE_IMP_NONZERO,
          ring_prime, RING_DIVIDES_LMUL, RING_DIVIDES_RMUL, RING_DIVIDES_REFL])

  let RING_SQUAREFREE_DIVPOW ← prove
   r"!r (a:A) x n.
        UFD r /\ ring_squarefree r a /\ x IN ring_carrier r /\
        ring_divides r a (ring_pow r x n)
        ==> ring_divides r a x"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q "a:A = ring_0 r") THENL
     [ASM_MESON_TAC [RING_SQUAREFREE_IMP_NONZERO, UFD_IMP_INTEGRAL_DOMAIN,
                     INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING],
      ASM_MESON_TAC [RING_PRIME_DIVIDES_POW, RING_DIVIDES_TRANS,
                     RING_SQUAREFREE_DIVIDES]])

  let RING_SQUAREFREE_DIVPOW_EQ ← prove
   r"!r (a:A) x n.
        UFD r /\ ring_squarefree r a /\ x IN ring_carrier r /\ ~(n = 0)
        ==> (ring_divides r a (ring_pow r x n) <=> ring_divides r a x)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [RING_SQUAREFREE_DIVPOW], ALL_TAC] THEN
    DISCH_TAC THEN MATCH_MP_TAC RING_DIVIDES_TRANS THEN
    EXISTS_TAC (← q "x:A") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q "?m. n = SUC m") (CHOOSE_THEN SUBST1_TAC) THENL
     [ASM_MESON_TAC [num_CASES], ALL_TAC] THEN
    ONCE_REWRITE_TAC [← CONJUNCT2 ring_pow] THEN
    ASM_SIMP_TAC [RING_DIVIDES_RMUL, RING_DIVIDES_REFL, RING_POW])

  let RING_SQUAREFREE_DIVIDES_SQUARE ← prove
   r"!r (a:A) b.
        UFD r /\ ring_squarefree r a /\
        b IN ring_carrier r /\ ring_divides r a (ring_pow r b 2)
        ==> ring_divides r a b"
   (MESON_TAC [RING_SQUAREFREE_DIVPOW])

  let RING_SQUAREFREE_MUL_EQ ← prove
   r"!r a (b:A).
        UFD r /\ a IN ring_carrier r /\ b IN ring_carrier r
        ==> (ring_squarefree r (ring_mul r a b) <=>
             ring_coprime r (a,b) /\
             ring_squarefree r a /\ ring_squarefree r b)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [RING_SQUAREFREE_MUL_IMP], STRIP_TAC] THEN
    ASM_CASES_TAC
     (← q r"~(a:A = ring_0 r) /\ ~(b = ring_0 r) /\ ~(ring_mul r a b = ring_0 r)")
    THENL
     [FIRST_X_ASSUM (CONJUNCTS_THEN STRIP_ASSUME_TAC),
      ASM_MESON_TAC [RING_MUL_LZERO, RING_MUL_RZERO, UFD, integral_domain,
                     RING_SQUAREFREE_0, TRIVIAL_RING_10]] THEN
    ASM_SIMP_TAC [RING_SQUAREFREE_PRIME_DIVISOR_EQ, RING_MUL] THEN
    ASM_SIMP_TAC [IMP_CONJ, RING_PRIME_DIVIDES_MUL] THEN REPEAT STRIP_TAC THENL
     [UNDISCH_TAC (← q "ring_squarefree r (a:A)"),
      UNDISCH_TAC (← q "ring_squarefree r (b:A)")] THEN
    ASM_SIMP_TAC [RING_SQUAREFREE_PRIME_EQ] THEN
    DISCH_THEN (MP_TAC o SPEC (← q "p:A")) THEN ASM_REWRITE_TAC [] THENL
     [MATCH_MP_TAC RING_COPRIME_DIVPROD_RIGHT THEN EXISTS_TAC (← q "b:A"),
      MATCH_MP_TAC RING_COPRIME_DIVPROD_LEFT THEN EXISTS_TAC (← q "a:A")] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC RING_COPRIME_RPOW THEN
    ASM_SIMP_TAC [RING_PRIME_IN_CARRIER] THEN
    MATCH_MP_TAC RING_COPRIME_DIVISORS THEN
    ASM_MESON_TAC [RING_DIVIDES_REFL, RING_COPRIME_SYM])

  let RING_SQUAREFREE_PRODUCT ← prove
   r"!r (f:K->A) s.
     UFD r /\ FINITE s /\
     (!i. i IN s ==> f i IN ring_carrier r) /\
     ~(ring_product r s f = ring_0 r)
     ==> (ring_squarefree r (ring_product r s f) <=>
          pairwise (\i j. ring_coprime r (f i, f j)) s /\
          !i. i IN s ==> ring_squarefree r (f i))"
   (GEN_TAC THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [RING_PRODUCT_CLAUSES, PAIRWISE_EMPTY, NOT_IN_EMPTY,
              RING_SQUAREFREE_1, FORALL_IN_INSERT, PAIRWISE_INSERT] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN STRIP_TAC THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(f:K->A) x IN ring_carrier r") ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q "integral_domain (r:A ring)") ASSUME_TAC THENL
     [ASM_MESON_TAC [UFD_IMP_INTEGRAL_DOMAIN], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~((f:K->A) x = ring_0 r) /\ ~(ring_product r s f = ring_0 r)")
        STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [INTEGRAL_DOMAIN_MUL_EQ_0, RING_PRODUCT], ALL_TAC] THEN
    ASM_SIMP_TAC [RING_SQUAREFREE_MUL_EQ, RING_PRODUCT] THEN
    ASM_SIMP_TAC [RING_COPRIME_PRODUCT_EQ, RING_PRODUCT] THEN
    ASM_MESON_TAC [RING_COPRIME_SYM])

  let (RING_SQUAREFREE_ALT, RING_SQUAREFREE) : thm × thm ← do
   CONJ_PAIR (← prove
   r"(!r (a:A).
        UFD r /\ a IN ring_carrier r
        ==> (ring_squarefree r a <=>
             ~(a = ring_0 r) /\
             !b k. b IN ring_carrier r /\ ring_divides r a (ring_pow r b k)
                   ==> ring_divides r a b)) /\
   (!r (a:A).
        UFD r /\ a IN ring_carrier r
        ==> (ring_squarefree r a <=>
             ~(a = ring_0 r) /\
             !b. b IN ring_carrier r /\ ring_divides r a (ring_pow r b 2)
                 ==> ring_divides r a b))"
   (← do
    let t2 ← TAUT
     (← q r"((p ==> q) /\ (q ==> r)) /\ (r ==> p) ==> (p <=> q) /\ (p <=> r)")
    let t1 ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")
    pure (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [t1] THEN
    STRIP_TAC THEN MATCH_MP_TAC t2 THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [RING_SQUAREFREE_DIVPOW, RING_SQUAREFREE_0, RING_POW,
                     UFD_IMP_INTEGRAL_DOMAIN, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING],
      STRIP_TAC THEN ASM_SIMP_TAC [RING_SQUAREFREE_PRIME_EQ]] THEN
    X_GEN_TAC (← q "p:A") THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_PRIME_IN_CARRIER) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_divides]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o CONJUNCT2) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "q:A")
     (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC)) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "ring_mul r p q:A")) THEN
    ASM_SIMP_TAC [RING_MUL, NOT_IMP] THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [ring_divides, RING_MUL, RING_POW] THEN
      EXISTS_TAC (← q "q:A") THEN ASM_REWRITE_TAC [] THEN RING_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q "ring_mul r p q:A = ring_mul r (ring_mul r (ring_1 r) p) q")
    SUBST1_TAC THENL [RING_TAC, ASM_SIMP_TAC [RING_POW_2]] THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_DIVIDES_RMUL2, RING_MUL, RING_1, DE_MORGAN_THM,
                  UFD_IMP_INTEGRAL_DOMAIN, RING_DIVIDES_ONE] THEN
    ASM_MESON_TAC [ring_prime, RING_POW, RING_MUL_RZERO])))

  let RING_SQUAREFREE_DECOMPOSITION ← prove
   r"!r (a:A). UFD r /\ a IN ring_carrier r
             ==> ?s t. ring_squarefree r s /\
                       t IN ring_carrier r /\
                       ring_mul r s (ring_pow r t 2) = a"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC UFD_PRIME_FACTOR_INDUCT THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [MAP_EVERY EXISTS_TAC [← q "ring_1 r:A", ← q "ring_0 r:A"] THEN
      SIMP_TAC [RING_SQUAREFREE_1, RING_0, RING_POW_ZERO,
                ← ARITH_RULE (← q "~(2 = 0)"), RING_MUL_RZERO, RING_1],
      X_GEN_TAC (← q "u:A") THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q "u:A", ← q "ring_1 r:A"] THEN
      SUBGOAL_THEN (← q "(u:A) IN ring_carrier r") ASSUME_TAC THENL
       [ASM_MESON_TAC [ring_unit], ALL_TAC] THEN
      ASM_SIMP_TAC [RING_UNIT_IMP_SQUAREFREE, RING_1, RING_POW_ONE, RING_MUL_RID],
      ALL_TAC] THEN
    REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q "s:A") (X_CHOOSE_THEN (← q "t:A") STRIP_ASSUME_TAC)))) THEN
    SUBGOAL_THEN (← q "integral_domain (r:A ring)") ASSUME_TAC THENL
     [ASM_MESON_TAC [UFD_IMP_INTEGRAL_DOMAIN], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(p:A) IN ring_carrier r /\ s IN ring_carrier r")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [ring_prime, ring_squarefree], ALL_TAC] THEN
    ASM_CASES_TAC (← q "ring_divides r (p:A) s") THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_divides]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q "s':A") THEN STRIP_TAC THEN EXISTS_TAC (← q "ring_mul r p t:A") THEN
      ASM_SIMP_TAC [RING_MUL] THEN CONJ_TAC THENL [ALL_TAC, RING_TAC] THEN
      ASM_MESON_TAC [RING_SQUAREFREE_DIVISOR, RING_DIVIDES_LMUL,
                     RING_DIVIDES_REFL],
      MAP_EVERY EXISTS_TAC [← q "ring_mul r p (s:A)", ← q "t:A"] THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, RING_TAC] THEN
      ASM_SIMP_TAC [RING_SQUAREFREE_MUL_EQ, RING_PRIME_IMP_SQUAREFREE] THEN
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_PRIME_COPRIME_EQ, UFD_IMP_INTEGRAL_DOMAIN]])

  -- @@RETURN BEGIN
  return { RING_SQUAREFREE_GCD, RING_SQUAREFREE_PRIME_EQ,
           RING_SQUAREFREE_PRIME_DIVISOR_EQ, RING_SQUAREFREE_DIVIDES,
           RING_SQUAREFREE_DIVPOW, RING_SQUAREFREE_DIVPOW_EQ,
           RING_SQUAREFREE_DIVIDES_SQUARE, RING_SQUAREFREE_MUL_EQ,
           RING_SQUAREFREE_PRODUCT, RING_SQUAREFREE_ALT, RING_SQUAREFREE,
           RING_SQUAREFREE_DECOMPOSITION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The general concept of a Boolean ring.  (ringtheory.ml 16002-16274)       -/
/- ------------------------------------------------------------------------- -/

structure BooleanRings where
  -- @@FIELDS
  boolean_ring : thm
  BOOLEAN_RING_SQUARE : thm
  BOOLEAN_RING_DOUBLE : thm
  BOOLEAN_RING_NEG : thm
  BOOLEAN_RING_POW : thm
  BOOLEAN_RING_OF_NUM : thm
  BOOLEAN_RING_CHAR : thm
  BOOLEAN_RING_UNIT : thm
  BOOLEAN_RING_ZERODIVISOR : thm
  BOOLEAN_RING_REGULAR : thm
  BOOLEAN_RING_IRREDUCIBLE : thm
  BOOLEAN_RING_DIVIDES : thm
  BOOLEAN_RING_NILPOTENT : thm
  BOOLEAN_RING_RADICAL : thm
  TRIVIAL_IMP_BOOLEAN_RING : thm
  BOOLEAN_RING_10 : thm
  BOOLEAN_RING_2 : thm
  ISOMORPHIC_RING_BOOLEANNESS : thm
  BOOLEAN_RING_EPIMORPHIC_IMAGE : thm
  BOOLEAN_QUOTIENT_RING : thm
  BOOLEAN_RING_SUBRING_GENERATED : thm
  BOOLEAN_RING_MONOMORPHIC_PREIMAGE : thm
  BOOLEAN_PROD_RING : thm
  BOOLEAN_PRODUCT_RING : thm
  BOOLEAN_IMP_BEZOUT_RING : thm
  BOOLEAN_RING_MAXIMAL_EQ_PRIME_IDEAL : thm
  BOOLEAN_RING_MULTSYS : thm
  BOOLEAN_PROPER_IDEAL_COMPLEMENT : thm
  BOOLEAN_INTEGRAL_DOMAIN : thm
  deriving Inhabited

@[nospecialize]
def setupBooleanRings [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BSubrings : Subrings) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BProdRings : ProdRings) (BRingRule : RingRule) (BQuotients : Quotients) (BPrimes : Primes) (BSquarefree : Squarefree) (BSpecialIdeals : SpecialIdeals) (BRadical : Radical) (BBezout : Bezout) :
    ExceptT String IO BooleanRings := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CARTESIAN_PRODUCT_EQ_EMPTY, .. } := D.core1
  let { COND_SWAP, CONTRAPOS_THM, DIVIDES_ANTISYM, EMPTY_SUBSET, EQ_TRANS, EVEN_EXISTS, .. } := D.core2
  let { FINITE_EMPTY, FINITE_INSERT, FINITE_SUBSET,
        FORALL_CARTESIAN_PRODUCT_ELEMENTS_EQ, FORALL_IN_INSERT, FORALL_PAIR_THM, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, INSERT_SUBSET, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_CROSS, IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_SING,
        LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { NOT_EVEN, NOT_IN_EMPTY, ODD, PAIR_EQ, .. } := D.core6
  let { RESTRICTION_UNIQUE, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET,
        SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, .. } := D.core7
  let { divides, num_INDUCTION, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_AC, RING_ADD_ASSOC, RING_ADD_LCANCEL_IMP,
        RING_ADD_LDISTRIB, RING_ADD_LZERO, RING_ADD_RDISTRIB, RING_ADD_RZERO,
        RING_CARRIER_HAS_SIZE_2, RING_CARRIER_NONEMPTY, RING_LNEG_UNIQUE, RING_MUL,
        RING_MUL_AC, RING_MUL_ASSOC, RING_MUL_LID, RING_MUL_LZERO, RING_MUL_RID,
        RING_MUL_SYM, RING_SUB, RING_SUB_EQ_0, RING_SUB_LDISTRIB, TRIVIAL_RING_10,
        trivial_ring, .. } := BBasics
  let { RING_CHAR_EQ_1, RING_OF_NUM_EQ_0, RING_POW_1, RING_POW_IDEMPOTENT, ring_of_num, .. } := BNumbers
  let { RING_UNIT_1, RING_ZERODIVISOR_1, RING_ZERODIVISOR_IN_CARRIER, ring_divides,
        ring_nilpotent, ring_regular, ring_unit, ring_zerodivisor, .. } := BDivides
  let { RING_CARRIER_SUBRING_GENERATED_SUBSET, SUBRING_GENERATED, .. } := BSubrings
  let { IDEAL_GENERATED_INC_GEN, IDEAL_GENERATED_MINIMAL, IDEAL_GENERATED_SING,
        IN_RING_IDEAL_ADD, IN_RING_IDEAL_MUL, IN_RING_IDEAL_RMUL, IN_RING_IDEAL_SUB,
        RING_IDEAL_IDEAL_GENERATED, RING_IDEAL_IMP_SUBSET, ring_ideal, .. } := BIdeals
  let { FINITE_INTEGRAL_DOMAIN_IMP_FIELD, INTEGRAL_DOMAIN_10,
        INTEGRAL_DOMAIN_ZERODIVISOR, integral_domain, .. } := BDomains
  let { ring_epimorphism, ring_homomorphism, ring_isomorphism, ring_isomorphisms, .. } := BHoms
  let { isomorphic_ring, .. } := BIso
  let { SUBRING_IMP_MONOMORPHIC_PROPERTY, .. } := BKernels
  let { PRODUCT_RING, PROD_RING, .. } := BProdRings
  let { RING_TAC, .. } := BRingRule
  let { RING_EPIMORPHISM_RING_COSET, .. } := BQuotients
  let { ring_irreducible, .. } := BPrimes
  let { RING_MULTSYS_IDEMPOT, ring_multsys, .. } := BSquarefree
  let { FIELD_QUOTIENT_RING, INTEGRAL_DOMAIN_QUOTIENT_RING, MAXIMAL_IMP_PRIME_IDEAL,
        PRIME_IMP_RING_IDEAL, PRINCIPAL_IDEAL_ALT, proper_ideal, .. } := BSpecialIdeals
  let { RADICAL_SUBSET, radical, .. } := BRadical
  let { BEZOUT_RING_2, .. } := BBezout
  -- @@SCOPE END

  let boolean_ring ← new_definition
   r"boolean_ring (r:A ring) <=>
        !x. x IN ring_carrier r ==> ring_mul r x x = x"

  let BOOLEAN_RING_SQUARE ← prove
   r"!r x:A.
        boolean_ring r /\ x IN ring_carrier r
        ==> ring_mul r x x = x"
   (SIMP_TAC [boolean_ring])

  let BOOLEAN_RING_DOUBLE ← prove
   r"!r x:A.
        boolean_ring r /\ x IN ring_carrier r
        ==> ring_add r x x = ring_0 r"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_ADD_LCANCEL_IMP THEN
    MAP_EVERY EXISTS_TAC [← q "r:A ring", ← q "ring_add r x x :A"] THEN
    ASM_SIMP_TAC [RING_ADD, RING_0, RING_ADD_RZERO] THEN
    TRANS_TAC EQ_TRANS (← q "ring_mul r (ring_add r x x) (ring_add r x x):A") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [boolean_ring, RING_ADD]] THEN
    ASM_SIMP_TAC [RING_ADD, RING_ADD_LDISTRIB, RING_ADD_RDISTRIB] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [boolean_ring]) THEN
    ASM_SIMP_TAC [← GSYM RING_ADD_ASSOC, RING_ADD])

  let BOOLEAN_RING_NEG ← prove
   r"!r x:A. boolean_ring r /\ x IN ring_carrier r ==> ring_neg r x = x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_LNEG_UNIQUE THEN
    ASM_SIMP_TAC [BOOLEAN_RING_DOUBLE])

  let BOOLEAN_RING_POW ← prove
   r"!r (x:A) n.
        boolean_ring r /\ x IN ring_carrier r
        ==> ring_pow r x n = if n = 0 then ring_1 r else x"
   (SIMP_TAC [boolean_ring, RING_POW_IDEMPOTENT])

  let BOOLEAN_RING_OF_NUM ← prove
   r"!(r:A ring) n.
        boolean_ring r
        ==> ring_of_num r n = if ODD n then ring_1 r else ring_0 r"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC num_INDUCTION THEN ASM_REWRITE_TAC [ring_of_num, ODD] THEN
    X_GEN_TAC (← q "n:num") THEN ASM_CASES_TAC (← q "ODD n") THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN SUBST1_TAC THEN SIMP_TAC [RING_ADD_LZERO, RING_1] THEN
    ASM_MESON_TAC [BOOLEAN_RING_DOUBLE, RING_1])

  let BOOLEAN_RING_CHAR ← prove
   r"!r:A ring.
        boolean_ring r ==> ring_char r = if trivial_ring r then 1 else 2"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [RING_CHAR_EQ_1] THEN
    MATCH_MP_TAC (← MESON [DIVIDES_ANTISYM]
     (← q r"(!n:num. m divides n <=> p divides n) ==> m = p")) THEN
    ASM_SIMP_TAC [← GSYM RING_OF_NUM_EQ_0, BOOLEAN_RING_OF_NUM] THEN
    REWRITE_TAC [← GSYM NOT_EVEN, COND_SWAP, EVEN_EXISTS, ← GSYM divides] THEN
    GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [← GSYM TRIVIAL_RING_10])

  let BOOLEAN_RING_UNIT ← prove
   r"!r x:A. boolean_ring r ==> (ring_unit r x <=> x = ring_1 r)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL [ALL_TAC, MESON_TAC [RING_UNIT_1]] THEN
    REWRITE_TAC [ring_unit, LEFT_IMP_EXISTS_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q "y:A") STRIP_ASSUME_TAC)) THEN
    TRANS_TAC EQ_TRANS (← q "ring_mul r x (ring_mul r x y):A") THEN
    CONJ_TAC THENL [ASM_SIMP_TAC [RING_MUL_RID], ALL_TAC] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [boolean_ring]) THEN
    ASM_SIMP_TAC [RING_MUL_ASSOC])

  let BOOLEAN_RING_ZERODIVISOR ← prove
   r"!r x:A.
        boolean_ring r
        ==> (ring_zerodivisor r x <=> x IN ring_carrier r /\ ~(x = ring_1 r))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q "x:A = ring_1 r") THEN
    ASM_REWRITE_TAC [RING_ZERODIVISOR_1] THEN
    EQ_TAC THEN REWRITE_TAC [RING_ZERODIVISOR_IN_CARRIER] THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [ring_zerodivisor] THEN
    EXISTS_TAC (← q "ring_sub r (x:A) (ring_1 r)") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [boolean_ring]) THEN
    ASM_SIMP_TAC [RING_SUB, RING_1, RING_SUB_EQ_0, RING_SUB_LDISTRIB,
                  RING_MUL_RID])

  let BOOLEAN_RING_REGULAR ← prove
   r"!r x:A.
        boolean_ring r ==> (ring_regular r x <=> x = ring_1 r)"
   (SIMP_TAC [ring_regular, BOOLEAN_RING_ZERODIVISOR] THEN MESON_TAC [RING_1])

  let BOOLEAN_RING_IRREDUCIBLE ← prove
   r"!r x:A. boolean_ring r ==> ~(ring_irreducible r x)"
   (SIMP_TAC [ring_irreducible, BOOLEAN_RING_UNIT] THEN
    REWRITE_TAC [boolean_ring] THEN MESON_TAC [])

  let BOOLEAN_RING_DIVIDES ← prove
   r"!r x y:A.
        boolean_ring r
        ==> (ring_divides r x y <=>
             x IN ring_carrier r /\ y IN ring_carrier r /\
             ring_mul r x y = y)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_divides] THEN
    ASM_CASES_TAC (← q "(x:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q "(y:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THENL [ALL_TAC, ASM_MESON_TAC [RING_MUL_SYM]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "z:A") (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [boolean_ring]) THEN
    ASM_SIMP_TAC [RING_MUL_ASSOC])

  let BOOLEAN_RING_NILPOTENT ← prove
   r"!r x:A. boolean_ring r ==> (ring_nilpotent r x <=> x = ring_0 r)"
   (REWRITE_TAC [ring_nilpotent] THEN
    MESON_TAC [BOOLEAN_RING_POW, RING_POW_1, RING_0, ← ARITH_RULE (← q "~(1 = 0)")])

  let BOOLEAN_RING_RADICAL ← prove
   r"!r j:A->bool.
        boolean_ring r /\ ring_ideal r j ==> radical r j = j"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, RADICAL_SUBSET] THEN
    ASM_SIMP_TAC [RING_IDEAL_IMP_SUBSET] THEN
    REWRITE_TAC [SUBSET, radical, IN_ELIM_THM] THEN
    REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    ASM_SIMP_TAC [BOOLEAN_RING_POW])

  let TRIVIAL_IMP_BOOLEAN_RING ← prove
   r"!r:A ring. trivial_ring r ==> boolean_ring r"
   (SIMP_TAC [trivial_ring, boolean_ring, IN_SING, RING_MUL_LZERO, RING_0])

  let BOOLEAN_RING_10 ← prove
   r"!r:A ring. ring_carrier r = {ring_0 r,ring_1 r} ==> boolean_ring r"
   (SIMP_TAC [boolean_ring, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
    SIMP_TAC [RING_MUL_LZERO, RING_MUL_LID, RING_0, RING_1])

  let BOOLEAN_RING_2 ← prove
   r"!r:A ring. ring_carrier r HAS_SIZE 2 ==> boolean_ring r"
   (SIMP_TAC [RING_CARRIER_HAS_SIZE_2, BOOLEAN_RING_10])

  let ISOMORPHIC_RING_BOOLEANNESS ← prove
   r"!r r'. r isomorphic_ring r' ==> (boolean_ring r <=> boolean_ring r')"
   (REWRITE_TAC [isomorphic_ring, boolean_ring, ring_isomorphism,
                 ring_isomorphisms, ring_homomorphism] THEN
    SET_TAC [])

  let BOOLEAN_RING_EPIMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B).
        ring_epimorphism(r,r') f /\ boolean_ring r ==> boolean_ring r'"
   (REWRITE_TAC [boolean_ring, ring_epimorphism, ring_homomorphism] THEN
    SET_TAC [])

  let BOOLEAN_QUOTIENT_RING ← prove
   r"!r j:A->bool.
        boolean_ring r /\ ring_ideal r j
        ==> boolean_ring (quotient_ring r j)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] BOOLEAN_RING_EPIMORPHIC_IMAGE) THEN
    ASM_MESON_TAC [RING_EPIMORPHISM_RING_COSET])

  let BOOLEAN_RING_SUBRING_GENERATED ← prove
   r"!r s:A->bool. boolean_ring r ==> boolean_ring (subring_generated r s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [boolean_ring] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:A->bool"]
          RING_CARRIER_SUBRING_GENERATED_SUBSET) THEN
    REWRITE_TAC [← CONJUNCT2 SUBRING_GENERATED] THEN ASM SET_TAC [])

  let BOOLEAN_RING_MONOMORPHIC_PREIMAGE ← prove
   r"!r r' (f:A->B).
        ring_monomorphism(r,r') f /\ boolean_ring r' ==> boolean_ring r"
   (MATCH_MP_TAC SUBRING_IMP_MONOMORPHIC_PROPERTY THEN
    REWRITE_TAC [BOOLEAN_RING_SUBRING_GENERATED] THEN
    REWRITE_TAC [ISOMORPHIC_RING_BOOLEANNESS])

  let BOOLEAN_PROD_RING ← prove
   r"!(r1:A ring) (r2:B ring).
        boolean_ring (prod_ring r1 r2) <=>
        boolean_ring r1 /\ boolean_ring r2"
   (REWRITE_TAC [boolean_ring, PROD_RING, FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
    MESON_TAC [RING_0])

  let BOOLEAN_PRODUCT_RING ← prove
   r"!k (r:K->A ring).
        boolean_ring (product_ring k r) <=>
        !i. i IN k ==> boolean_ring (r i)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [boolean_ring, PRODUCT_RING] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, RESTRICTION_UNIQUE] THEN
    SIMP_TAC [FORALL_CARTESIAN_PRODUCT_ELEMENTS_EQ,
              CARTESIAN_PRODUCT_EQ_EMPTY, RING_CARRIER_NONEMPTY] THEN
    SIMP_TAC [IN_CARTESIAN_PRODUCT] THEN MESON_TAC [])

  let BOOLEAN_IMP_BEZOUT_RING ← prove
   r"!r:A ring. boolean_ring r ==> bezout_ring r"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [BEZOUT_RING_2] THEN
    MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
    REWRITE_TAC [PRINCIPAL_IDEAL_ALT] THEN
    EXISTS_TAC (← q "ring_add r (ring_add r x y) (ring_mul r x y):A") THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THEN
    MATCH_MP_TAC IDEAL_GENERATED_MINIMAL THEN
    ASM_SIMP_TAC [INSERT_SUBSET, EMPTY_SUBSET, RING_IDEAL_IDEAL_GENERATED] THEN
    ASM_SIMP_TAC [IN_RING_IDEAL_ADD, IN_RING_IDEAL_MUL, IN_INSERT,
                  RING_IDEAL_IDEAL_GENERATED, IDEAL_GENERATED_INC_GEN] THEN
    ASM_SIMP_TAC [IDEAL_GENERATED_SING, RING_ADD, RING_MUL, IN_ELIM_THM] THEN
    ASM_SIMP_TAC [ring_divides, RING_ADD, RING_MUL] THEN CONJ_TAC THENL
     [EXISTS_TAC (← q "x:A"), EXISTS_TAC (← q "y:A")] THEN
    ASM_SIMP_TAC [RING_ADD_RDISTRIB, RING_ADD, RING_MUL] THENL
     [SUBGOAL_THEN
       (← q "ring_mul r (ring_mul r x y) x:A = ring_mul r y (ring_mul r x x)")
      SUBST1_TAC THENL [ASM_MESON_TAC [RING_MUL_AC, RING_MUL], ALL_TAC],
      SUBGOAL_THEN
       (← q r"ring_add r (ring_mul r x y) (ring_mul r y y):A =
      ring_add r (ring_mul r y y) (ring_mul r x y)")
      SUBST1_TAC THENL [ASM_SIMP_TAC [RING_ADD_AC, RING_MUL], ALL_TAC]] THEN
    ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, ← GSYM RING_ADD_ASSOC, RING_MUL] THEN
    ASM_SIMP_TAC [BOOLEAN_RING_SQUARE, BOOLEAN_RING_DOUBLE, RING_MUL] THEN
    ASM_SIMP_TAC [RING_ADD_RZERO])

  let BOOLEAN_RING_MAXIMAL_EQ_PRIME_IDEAL ← prove
   r"!r j:A->bool.
           boolean_ring r ==> (maximal_ideal r j <=> prime_ideal r j)"
   (← do
    let s2 ← SET_RULE
     (← q r"(!a. a IN s /\ ~(a = z) <=> a = w) ==> s SUBSET {w,z}")
    let t1 ← TAUT (← q r"p ==> q <=> p ==> p ==> q")
    pure (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [MAXIMAL_IMP_PRIME_IDEAL] THEN
    ASM_CASES_TAC (← q r"ring_ideal r (j:A->bool)") THENL
     [ALL_TAC, ASM_MESON_TAC [PRIME_IMP_RING_IDEAL]] THEN
    ASM_SIMP_TAC [← GSYM INTEGRAL_DOMAIN_QUOTIENT_RING,
                  ← GSYM FIELD_QUOTIENT_RING] THEN
    ONCE_REWRITE_TAC [t1] THEN DISCH_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] FINITE_INTEGRAL_DOMAIN_IMP_FIELD) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP INTEGRAL_DOMAIN_ZERODIVISOR) THEN
    ASM_SIMP_TAC [BOOLEAN_RING_ZERODIVISOR, BOOLEAN_QUOTIENT_RING] THEN
    DISCH_THEN (MP_TAC o MATCH_MP s2) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET) THEN
    REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY]))

  let BOOLEAN_RING_MULTSYS ← prove
   r"!r x:A.
        boolean_ring r
        ==> (ring_multsys r {ring_1 r,x} <=> x IN ring_carrier r)"
   (REWRITE_TAC [boolean_ring] THEN REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [RING_MULTSYS_IDEMPOT] THEN REWRITE_TAC [ring_multsys] THEN
    ASM SET_TAC [])

  let BOOLEAN_PROPER_IDEAL_COMPLEMENT ← prove
   r"!r j x:A.
        boolean_ring r /\ proper_ideal r j /\ x IN j
        ==> ?y. y IN ring_carrier r DIFF j /\ ring_mul r x y = ring_0 r"
   (REWRITE_TAC [proper_ideal] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q "(x:A) IN ring_carrier r") ASSUME_TAC THENL
     [ASM_MESON_TAC [ring_ideal, SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?z:A. z IN ring_carrier r /\ ~(z IN j)") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q "ring_add r z (ring_mul r x z):A") THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [IN_DIFF, RING_ADD, RING_MUL] THEN
      UNDISCH_TAC (← q "~((z:A) IN j)") THEN REWRITE_TAC [CONTRAPOS_THM] THEN
      DISCH_TAC THEN SUBGOAL_THEN
       (← q "z:A = ring_sub r (ring_add r z (ring_mul r x z)) (ring_mul r x z)")
      SUBST1_TAC THENL [RING_TAC, MATCH_MP_TAC IN_RING_IDEAL_SUB] THEN
      ASM_SIMP_TAC [IN_RING_IDEAL_RMUL],
      MP_TAC (← ISPECL [← q "r:A ring", ← q "x:A"] BOOLEAN_RING_SQUARE) THEN
      MP_TAC (← ISPECL [← q "r:A ring", ← q "ring_mul r x z:A"] BOOLEAN_RING_DOUBLE) THEN
      ASM_SIMP_TAC [RING_MUL] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN RING_TAC])

  let BOOLEAN_INTEGRAL_DOMAIN ← prove
   r"!r:A ring.
        boolean_ring r /\ integral_domain r <=> ring_carrier r HAS_SIZE 2"
   (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [RING_CARRIER_HAS_SIZE_2] THEN
    SIMP_TAC [TRIVIAL_RING_10, INTEGRAL_DOMAIN_10, BOOLEAN_RING_10] THEN
    REWRITE_TAC [integral_domain] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"a IN s /\ b IN s /\ (!c. c IN s /\ ~(c = a) /\ ~(c = b) ==> F)
    ==> s = {a,b}")) THEN
    REWRITE_TAC [RING_0, RING_1] THEN X_GEN_TAC (← q "x:A") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q "x:A", ← q "ring_sub r x (ring_1 r):A"]) THEN
    ASM_SIMP_TAC [RING_SUB, RING_1, RING_SUB_LDISTRIB, RING_MUL_RID] THEN
    ASM_SIMP_TAC [RING_SUB_EQ_0, RING_1, RING_MUL] THEN
    ASM_MESON_TAC [boolean_ring])

  -- @@RETURN BEGIN
  return { boolean_ring, BOOLEAN_RING_SQUARE, BOOLEAN_RING_DOUBLE, BOOLEAN_RING_NEG,
           BOOLEAN_RING_POW, BOOLEAN_RING_OF_NUM, BOOLEAN_RING_CHAR, BOOLEAN_RING_UNIT,
           BOOLEAN_RING_ZERODIVISOR, BOOLEAN_RING_REGULAR, BOOLEAN_RING_IRREDUCIBLE,
           BOOLEAN_RING_DIVIDES, BOOLEAN_RING_NILPOTENT, BOOLEAN_RING_RADICAL,
           TRIVIAL_IMP_BOOLEAN_RING, BOOLEAN_RING_10, BOOLEAN_RING_2,
           ISOMORPHIC_RING_BOOLEANNESS, BOOLEAN_RING_EPIMORPHIC_IMAGE,
           BOOLEAN_QUOTIENT_RING, BOOLEAN_RING_SUBRING_GENERATED,
           BOOLEAN_RING_MONOMORPHIC_PREIMAGE, BOOLEAN_PROD_RING, BOOLEAN_PRODUCT_RING,
           BOOLEAN_IMP_BEZOUT_RING, BOOLEAN_RING_MAXIMAL_EQ_PRIME_IDEAL,
           BOOLEAN_RING_MULTSYS, BOOLEAN_PROPER_IDEAL_COMPLEMENT,
           BOOLEAN_INTEGRAL_DOMAIN }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Local rings.  (ringtheory.ml 16275-16396)                                 -/
/- ------------------------------------------------------------------------- -/

structure LocalRings where
  -- @@FIELDS
  local_ring : thm
  LOCAL_IMP_NONTRIVIAL_RING : thm
  LOCAL_RING_IDEAL_NONUNITS : thm
  FIELD_IMP_LOCAL_RING : thm
  UNIQUE_PRIME_IDEAL_IMP_LOCAL_RING : thm
  LOCAL_RING_EPIMORPHIC_IMAGE : thm
  LOCAL_QUOTIENT_RING : thm
  ISOMORPHIC_RING_LOCALITY : thm
  LOCAL_RING_LOCALIZATION : thm
  NOETHERIAN_LOCAL_RING_LOCALIZATION : thm
  deriving Inhabited

@[nospecialize]
def setupLocalRings [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BIdeals : Ideals) (BHoms : Homs) (BIso : Iso) (BQuotients : Quotients) (BSquarefree : Squarefree) (BLocalization : Localization) (BSpecialIdeals : SpecialIdeals) (BNoetherian : Noetherian) :
    ExceptT String IO LocalRings := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, basic_ss, new_definition, .. } := D
  let { EXISTS_UNIQUE, EXISTS_UNIQUE_DEF, .. } := D.core2
  let { FORALL_IN_GSPEC, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, .. } := D.core4
  let { IN_DIFF, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_EXISTS, NOT_EXISTS_THM, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, UNIONS_1, .. } := D.core7
  let { RING_ADD, RING_MUL, RING_MUL_SYM, .. } := BBasics
  let { IN_RING_IDEAL_0, ring_ideal, .. } := BIdeals
  let { RING_ISOMORPHISMS_ISOMORPHISM, RING_ISOMORPHISM_IMP_EPIMORPHISM,
        ring_epimorphism, ring_isomorphism, .. } := BHoms
  let { ISOMORPHIC_RING_TRIVIALITY, isomorphic_ring, .. } := BIso
  let { RING_EPIMORPHISM_RING_COSET, .. } := BQuotients
  let { ring_multsys, .. } := BSquarefree
  let { RING_LOCALIZATION, RING_LOCALIZATION_ADD, RING_UNIT_LOCALEQUIV_EQ,
        TRIVIAL_RING_LOCALIZATION, .. } := BLocalization
  let { FIELD_EQ_NO_PROPER_IDEALS, MAXIMAL_IDEAL_0, MAXIMAL_IDEAL_EPIMORPHIC_PREIMAGE,
        MAXIMAL_IDEAL_EXISTS, MAXIMAL_IDEAL_IMP_SUBSET, MAXIMAL_IDEAL_NONUNITS,
        MAXIMAL_IMP_PRIME_IDEAL, MAXIMAL_IMP_PROPER_IDEAL, MAXIMAL_SUPERIDEAL_EXISTS,
        PRIME_IMP_PROPER_IDEAL, PRIME_IMP_RING_IDEAL, PROPER_IDEAL_NONUNITS,
        PROPER_IDEAL_SUBSET_NONUNITS, PROPER_IMP_RING_IDEAL, RING_IDEAL_NONUNITS,
        RING_MULTSYS_NONPRIME, RING_SATURATED_MULTSYS_NONPRIME, TRIVIAL_QUOTIENT_RING,
        UNIONS_MAXIMAL_IDEALS, maximal_ideal, proper_ideal, .. } := BSpecialIdeals
  let { NOETHERIAN_RING_LOCALIZATION, .. } := BNoetherian
  -- @@SCOPE END

  let local_ring ← new_definition
   r"local_ring (r:A ring) <=> ?!j. maximal_ideal r j"

  let LOCAL_IMP_NONTRIVIAL_RING ← prove
   r"!r:A ring. local_ring r ==> ~trivial_ring r"
   (MESON_TAC [MAXIMAL_IDEAL_EXISTS, local_ring])

  let LOCAL_RING_IDEAL_NONUNITS ← prove
   r"!r:A ring.
        local_ring (r:A ring) <=>
        ring_ideal r {x | x IN ring_carrier r /\ ~(ring_unit r x)}"
   (← do
    -- right to left: the last SET_RULE, the MESON, then the first SET_RULE
    let s3 ← SET_RULE (← q r"s = t <=> s SUBSET t /\ ~(s PSUBSET t)")
    let sa ← SPEC_ALL UNIONS_MAXIMAL_IDEALS
    let m2 ← MESON [UNIONS_1] (← q r"UNIONS u = t ==> ((?a. u = {a}) <=> u = {t})")
    let s1 ← SET_RULE (← q r"(?!x. P x) <=> ?a. {x | P x} = {a}")
    pure (GEN_TAC THEN REWRITE_TAC [local_ring] THEN EQ_TAC THENL
     [REWRITE_TAC [s1] THEN
      REWRITE_TAC [← MATCH_MP m2 sa] THEN
      REWRITE_TAC [maximal_ideal, proper_ideal] THEN SET_TAC [],
      DISCH_TAC THEN REWRITE_TAC [EXISTS_UNIQUE] THEN
      EXISTS_TAC (← q r"{x:A | x IN ring_carrier r /\ ~(ring_unit r x)}") THEN
      ASM_REWRITE_TAC [MAXIMAL_IDEAL_NONUNITS] THEN
      X_GEN_TAC (← q r"j:A->bool") THEN REWRITE_TAC [maximal_ideal] THEN STRIP_TAC THEN
      REWRITE_TAC [s3] THEN
      ASM_SIMP_TAC [PROPER_IDEAL_SUBSET_NONUNITS] THEN
      FIRST_X_ASSUM (MP_TAC o
        SPEC (← q r"{x:A | x IN ring_carrier r /\ ~(ring_unit r x)}") o
        GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      ASM_REWRITE_TAC [PROPER_IDEAL_NONUNITS]]))

  let FIELD_IMP_LOCAL_RING ← prove
   r"!r:A ring. field r ==> local_ring r"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [local_ring, EXISTS_UNIQUE] THEN
    ASM_MESON_TAC [FIELD_EQ_NO_PROPER_IDEALS, MAXIMAL_IDEAL_0,
                   MAXIMAL_IMP_PROPER_IDEAL])

  let UNIQUE_PRIME_IDEAL_IMP_LOCAL_RING ← prove
   r"!r:A ring. (?!j. prime_ideal r j) ==> local_ring r"
   (GEN_TAC THEN REWRITE_TAC [local_ring, EXISTS_UNIQUE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    MESON_TAC [MAXIMAL_SUPERIDEAL_EXISTS, MAXIMAL_IMP_PRIME_IDEAL,
               PRIME_IMP_PROPER_IDEAL])

  let LOCAL_RING_EPIMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B).
        ring_epimorphism(r,r') f /\ local_ring r /\ ~trivial_ring r'
        ==> local_ring r'"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MAXIMAL_IDEAL_EXISTS]) THEN
    REWRITE_TAC [local_ring, EXISTS_UNIQUE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:B->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"j:B->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [local_ring]) THEN
    REWRITE_TAC [EXISTS_UNIQUE_DEF] THEN DISCH_THEN (MP_TAC o SPECL
     [← q r"{x | x IN ring_carrier r /\ (f:A->B) x IN j}",
      ← q r"{x | x IN ring_carrier r /\ (f:A->B) x IN k}"] o CONJUNCT2) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [MAXIMAL_IDEAL_EPIMORPHIC_PREIMAGE], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_epimorphism]) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP MAXIMAL_IDEAL_IMP_SUBSET)) THEN
    ASM SET_TAC [])

  let LOCAL_QUOTIENT_RING ← prove
   r"!r j:A->bool.
        local_ring r /\ proper_ideal r j
        ==> local_ring (quotient_ring r j)"
   (ASM_MESON_TAC [PROPER_IMP_RING_IDEAL, TRIVIAL_QUOTIENT_RING,
                   RING_EPIMORPHISM_RING_COSET, LOCAL_RING_EPIMORPHIC_IMAGE])

  let ISOMORPHIC_RING_LOCALITY ← prove
   r"!(r:A ring) (r':B ring).
        r isomorphic_ring r' ==> (local_ring r <=> local_ring r')"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ISOMORPHIC_RING_TRIVIALITY) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [isomorphic_ring]) THEN
    REWRITE_TAC [ring_isomorphism, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [RING_ISOMORPHISMS_ISOMORPHISM] THEN REPEAT STRIP_TAC THEN
    ASM_MESON_TAC [LOCAL_RING_EPIMORPHIC_IMAGE, LOCAL_IMP_NONTRIVIAL_RING,
                   RING_ISOMORPHISM_IMP_EPIMORPHISM])

  let LOCAL_RING_LOCALIZATION ← prove
   r"!r j:A->bool.
        prime_ideal r j
        ==> local_ring(ring_localization r (ring_carrier r DIFF j))"
   (← do
    -- right to left: the second TAUT, the basic_ss, then the first TAUT
    let t3 ← TAUT (← q r"q ==> ~(p /\ ~q)")
    let ss ← ExceptT.mk (basic_ss [])
    let t1 ← TAUT (← q r"p /\ ~q /\ r /\ ~s <=> p /\ r /\ ~q /\ ~s")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP RING_SATURATED_MULTSYS_NONPRIME) THEN
    ABBREV_TAC (← q r"s:A->bool = ring_carrier r DIFF j") THEN
    REWRITE_TAC [LOCAL_RING_IDEAL_NONUNITS, RING_IDEAL_NONUNITS] THEN
    ASM_SIMP_TAC [TRIVIAL_RING_LOCALIZATION] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [IN_RING_IDEAL_0, PRIME_IMP_RING_IDEAL, IN_DIFF],
      REWRITE_TAC [t1]] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [← CONJUNCT1 RING_LOCALIZATION, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [RING_LOCALIZATION_ADD] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [IMP_IMP] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:A->bool"] RING_UNIT_LOCALEQUIV_EQ) THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM ((fun (_ : thm) => ALL_TAC) o check (fun th => is_forall (concl th))) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_multsys, SUBSET]) THEN
    ASM (simpTac ss 4)
        [RING_ADD, RING_MUL] THEN
    DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN EXPAND_TAC "s" THEN
    REWRITE_TAC [IN_DIFF] THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MATCH_MP_TAC t3 THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP PRIME_IMP_RING_IDEAL) THEN
    REWRITE_TAC [ring_ideal, SUBSET] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [RING_MUL_SYM]))

  let NOETHERIAN_LOCAL_RING_LOCALIZATION ← prove
   r"!r (p:A->bool).
     noetherian_ring r /\ prime_ideal r p
     ==> noetherian_ring(ring_localization r (ring_carrier r DIFF p)) /\
         local_ring(ring_localization r (ring_carrier r DIFF p))"
   (REPEAT STRIP_TAC THENL
    [MATCH_MP_TAC NOETHERIAN_RING_LOCALIZATION THEN
     ASM_SIMP_TAC [RING_MULTSYS_NONPRIME],
     ASM_SIMP_TAC [LOCAL_RING_LOCALIZATION]])

  -- @@RETURN BEGIN
  return { local_ring, LOCAL_IMP_NONTRIVIAL_RING, LOCAL_RING_IDEAL_NONUNITS,
           FIELD_IMP_LOCAL_RING, UNIQUE_PRIME_IDEAL_IMP_LOCAL_RING,
           LOCAL_RING_EPIMORPHIC_IMAGE, LOCAL_QUOTIENT_RING, ISOMORPHIC_RING_LOCALITY,
           LOCAL_RING_LOCALIZATION, NOETHERIAN_LOCAL_RING_LOCALIZATION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Von Neumann regular rings.  (ringtheory.ml 16397-16659)                   -/
/- ------------------------------------------------------------------------- -/

structure VonNeumann where
  -- @@FIELDS
  vnregular_ring : thm
  FIELD_IMP_VNREGULAR_RING : thm
  BOOLEAN_IMP_VNREGULAR_RING : thm
  VNREGULAR_RING_EPIMORPHIC_IMAGE : thm
  VNREGULAR_QUOTIENT_RING : thm
  ISOMORPHIC_RING_VNREGULARITY : thm
  VNREGULAR_PROD_RING : thm
  VNREGULAR_PRODUCT_RING : thm
  VNREGULAR_IMP_REDUCED_RING : thm
  VNREGULAR_RING_NILPOTENT : thm
  VNREGULAR_RING_REGULAR : thm
  VNREGULAR_DOMAIN : thm
  VNREGULAR_RING_PRINCIPAL_IDEALS : thm
  VNREGULAR_IMP_BEZOUT_RING : thm
  VNREGULAR_RING_FINITELY_GENERATED_IDEALS : thm
  VNREGULAR_RING_IDEAL_IDEMPOT : thm
  VNREGULAR_RING : thm
  VNREGULAR_RING_ALT : thm
  VNREGULAR_RING_LOCALIZATION : thm
  VNREGULAR_FRACTION_RING : thm
  deriving Inhabited

@[nospecialize]
def setupVonNeumann [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BIso : Iso) (BProdRings : ProdRings) (BRingRule : RingRule) (BQuotients : Quotients) (BSquarefree : Squarefree) (BLocalization : Localization) (BSpecialIdeals : SpecialIdeals) (BUFDs : UFDs) (BBezout : Bezout) (BBooleanRings : BooleanRings) :
    ExceptT String IO VonNeumann := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, basic_ss, new_definition, .. } := D
  let { CARTESIAN_PRODUCT_AS_RESTRICTIONS, .. } := D.core1
  let { EMPTY_SUBSET, EXISTS_CARTESIAN_PRODUCT_ELEMENT, EXISTS_IN_IMAGE,
        EXISTS_PAIR_THM, .. } := D.core2
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_PAIR_THM, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, INSERT_SUBSET, .. } := D.core4
  let { IN_CROSS, IN_ELIM_THM, IN_INSERT, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MONO_EXISTS, NOT_EXISTS_THM, PAIR_EQ, .. } := D.core6
  let { RESTRICTION, RESTRICTION_EXTENSION, SUBSET, SUBSET_ANTISYM, SUBSET_REFL, .. } := D.core7
  let { RING_0, RING_1, RING_ADD, RING_MUL, RING_MUL_AC, RING_MUL_ASSOC, RING_MUL_LID,
        RING_MUL_LZERO, RING_MUL_RID, RING_MUL_RZERO, RING_SUB, TRIVIAL_RING_10,
        trivial_ring, .. } := BBasics
  let { RING_MUL_POW, RING_POW, RING_POW_IDEMPOTENT, .. } := BNumbers
  let { RING_DIVIDES_LMUL, RING_DIVIDES_REFL, RING_INV, RING_NILPOTENT_0,
        RING_UNIT_IMP_REGULAR, ring_associates, ring_divides, ring_nilpotent,
        ring_regular, ring_unit, ring_zerodivisor, .. } := BDivides
  let { IDEALS_GENERATED_SING_EQ, IDEAL_GENERATED_INC_GEN, IDEAL_GENERATED_INSERT,
        IDEAL_GENERATED_MINIMAL_EQ, IDEAL_GENERATED_SING_ALT, IN_RING_IDEAL_ADD,
        IN_RING_IDEAL_LMUL, IN_RING_IDEAL_MUL, IN_RING_IDEAL_SUB,
        RING_IDEAL_IDEAL_GENERATED, RING_IDEAL_IMP_SUBSET, RING_SETMUL_SUBSET_IDEAL,
        ring_setmul, .. } := BIdeals
  let { FIELD_EQ_ALL_UNITS, FIELD_IMP_INTEGRAL_DOMAIN, FIELD_MUL_LINV,
        INTEGRAL_DOMAIN_EQ_ALL_REGULAR, .. } := BDomains
  let { RING_ISOMORPHISMS_ISOMORPHISM, RING_ISOMORPHISM_IMP_EPIMORPHISM,
        ring_epimorphism, ring_homomorphism, ring_isomorphism, .. } := BHoms
  let { isomorphic_ring, .. } := BIso
  let { PRODUCT_RING, PROD_RING, RING_EPIMORPHISM_PRODUCT_PROJECTION, .. } := BProdRings
  let { RING_RULE, RING_TAC, .. } := BRingRule
  let { RING_EPIMORPHISM_RING_COSET, .. } := BQuotients
  let { RING_MULTSYS_REGULAR, ring_multsys, .. } := BSquarefree
  let { RING_FRACTIONATE_IN_CARRIER, RING_LOCALEQUIV_EQUIV, RING_LOCALIZATION_CARRIER,
        RING_LOCALIZATION_MUL, RING_LOCALIZATION_UNCHANGED, fraction_ring,
        ring_fractionate, ring_localequiv, .. } := BLocalization
  let { PRINCIPAL_IDEAL_ALT, PRINCIPAL_IDEAL_IDEAL_GENERATED_SING,
        PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL, principal_ideal, .. } := BSpecialIdeals
  let { RING_DIVIDES_LOCALEQUIV, .. } := BUFDs
  let { BEZOUT_RING_FINITELY_GENERATED_EQ_PRINCIPAL_IDEAL, BEZOUT_RING_SETADD, .. } := BBezout
  let { boolean_ring, .. } := BBooleanRings
  -- @@SCOPE END

  let vnregular_ring ← new_definition
   r"vnregular_ring (r:A ring) <=>
        !a. a IN ring_carrier r
            ==> ?x. x IN ring_carrier r /\
                    ring_mul r a (ring_mul r x a) = a"

  let FIELD_IMP_VNREGULAR_RING ← prove
   r"!r:A ring. field r ==> vnregular_ring r"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [vnregular_ring] THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN EXISTS_TAC (← q "ring_inv r x:A") THEN
    ASM_CASES_TAC (← q "x:A = ring_0 r") THEN
    ASM_SIMP_TAC [RING_INV, RING_MUL, RING_MUL_LZERO, RING_0] THEN
    ASM_SIMP_TAC [FIELD_MUL_LINV, RING_MUL_RID])

  let BOOLEAN_IMP_VNREGULAR_RING ← prove
   r"!r:A ring. boolean_ring r ==> vnregular_ring r"
   (GEN_TAC THEN REWRITE_TAC [boolean_ring, vnregular_ring] THEN
    STRIP_TAC THEN X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q "x:A") THEN ASM_SIMP_TAC [])

  let VNREGULAR_RING_EPIMORPHIC_IMAGE ← prove
   r"!r r' (f:A->B).
        ring_epimorphism(r,r') f /\ vnregular_ring r ==> vnregular_ring r'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_epimorphism, vnregular_ring] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN DISCH_TAC THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "a:A")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "x:A") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [ring_homomorphism]) THEN
    ASM_MESON_TAC [RING_MUL])

  let VNREGULAR_QUOTIENT_RING ← prove
   r"!r j:A->bool.
        vnregular_ring r /\ ring_ideal r j
        ==> vnregular_ring (quotient_ring r j)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] VNREGULAR_RING_EPIMORPHIC_IMAGE) THEN
    ASM_MESON_TAC [RING_EPIMORPHISM_RING_COSET])

  let ISOMORPHIC_RING_VNREGULARITY ← prove
   r"!(r:A ring) (r':B ring).
        r isomorphic_ring r' ==> (vnregular_ring r <=> vnregular_ring r')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [isomorphic_ring] THEN
    REWRITE_TAC [ring_isomorphism, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [RING_ISOMORPHISMS_ISOMORPHISM] THEN REPEAT STRIP_TAC THEN
    ASM_MESON_TAC [VNREGULAR_RING_EPIMORPHIC_IMAGE,
                   RING_ISOMORPHISM_IMP_EPIMORPHISM])

  let VNREGULAR_PROD_RING ← prove
   r"!(r1:A ring) (r2:B ring).
        vnregular_ring(prod_ring r1 r2) <=>
        vnregular_ring r1 /\ vnregular_ring r2"
   (REWRITE_TAC [vnregular_ring, PROD_RING] THEN
    REWRITE_TAC [FORALL_PAIR_THM, EXISTS_PAIR_THM] THEN
    REWRITE_TAC [IN_CROSS, PAIR_EQ] THEN MESON_TAC [RING_0])

  let VNREGULAR_PRODUCT_RING ← prove
   r"!(r:K->A ring) k.
        vnregular_ring(product_ring k r) <=>
        !i. i IN k ==> vnregular_ring (r i)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ_ALT] VNREGULAR_RING_EPIMORPHIC_IMAGE)) THEN
      ASM_MESON_TAC [RING_EPIMORPHISM_PRODUCT_PROJECTION],
      DISCH_TAC] THEN
    REWRITE_TAC [vnregular_ring, PRODUCT_RING] THEN
    GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV o ONCE_DEPTH_CONV)
     [CARTESIAN_PRODUCT_AS_RESTRICTIONS] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, RESTRICTION_EXTENSION] THEN
    SIMP_TAC [RESTRICTION] THEN REWRITE_TAC [EXISTS_CARTESIAN_PRODUCT_ELEMENT] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [vnregular_ring]) THEN ASM SET_TAC [])

  let VNREGULAR_IMP_REDUCED_RING ← prove
   r"!r (x:A) n.
        vnregular_ring r /\ x IN ring_carrier r /\ ring_pow r x n = ring_0 r
        ==> x = ring_0 r"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "x:A") o REWRITE_RULE [vnregular_ring]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "y:A") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q "ring_mul r y x:A", ← q "n:num"]
          RING_POW_IDEMPOTENT) THEN
    ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, RING_MUL] THEN
    DISCH_THEN (MP_TAC o SYM) THEN
    ASM_SIMP_TAC [RING_MUL_POW, RING_MUL_RZERO, RING_POW] THEN
    COND_CASES_TAC THENL
     [REWRITE_TAC [← GSYM TRIVIAL_RING_10, trivial_ring] THEN ASM SET_TAC [],
      ASM_MESON_TAC [RING_MUL_RZERO]])

  let VNREGULAR_RING_NILPOTENT ← prove
   r"!r x:A.
        vnregular_ring r ==> (ring_nilpotent r x <=> x = ring_0 r)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [RING_NILPOTENT_0] THEN
    REWRITE_TAC [ring_nilpotent] THEN ASM_MESON_TAC [VNREGULAR_IMP_REDUCED_RING])

  let VNREGULAR_RING_REGULAR ← prove
   r"!r a:A. vnregular_ring r ==> (ring_regular r a <=> ring_unit r a)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [RING_UNIT_IMP_REGULAR] THEN
    REWRITE_TAC [ring_regular, ring_zerodivisor, ring_unit] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "a:A") o GEN_REWRITE_RULE id [vnregular_ring]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q "b:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "ring_sub r (ring_mul r a b) (ring_1 r):A")) THEN
    ASM_SIMP_TAC [RING_1, RING_SUB, RING_MUL] THEN
    FIRST_X_ASSUM (MP_TAC o SYM) THEN RING_TAC)

  let VNREGULAR_DOMAIN ← prove
   r"!r:A ring.
        vnregular_ring r /\ integral_domain r <=> field r"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [FIELD_IMP_VNREGULAR_RING, FIELD_IMP_INTEGRAL_DOMAIN] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [FIELD_EQ_ALL_UNITS, ← GSYM VNREGULAR_RING_REGULAR] THEN
    SIMP_TAC [INTEGRAL_DOMAIN_EQ_ALL_REGULAR])

  let VNREGULAR_RING_PRINCIPAL_IDEALS ← prove
   r"!r:A ring.
        vnregular_ring r <=>
        !j. principal_ideal r j
            ==> ?e. e IN ring_carrier r /\
                    ring_mul r e e = e /\
                    j = ideal_generated r {e}"
   (GEN_TAC THEN REWRITE_TAC [vnregular_ring] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"j:A->bool") THEN REWRITE_TAC [principal_ideal] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "x:A") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "x:A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "y:A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q "ring_mul r y x:A") THEN
      ASM_SIMP_TAC [RING_MUL, ← GSYM RING_MUL_ASSOC] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC LAND_CONV [← SYM th])) THEN
      ASM_SIMP_TAC [IDEALS_GENERATED_SING_EQ, RING_MUL] THEN
      ASM_SIMP_TAC [ring_associates, RING_DIVIDES_REFL, RING_DIVIDES_LMUL] THEN
      ASM_SIMP_TAC [ring_divides, RING_MUL] THEN
      EXISTS_TAC (← q "x:A") THEN ASM_MESON_TAC [RING_MUL_AC, RING_MUL],
      X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "ideal_generated r {x:A}")) THEN
      REWRITE_TAC [PRINCIPAL_IDEAL_IDEAL_GENERATED_SING] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "e:A") MP_TAC) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_SIMP_TAC [IDEALS_GENERATED_SING_EQ, ring_associates] THEN
      ASM_REWRITE_TAC [ring_divides] THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q "y:A") STRIP_ASSUME_TAC)
       (X_CHOOSE_THEN (← q "z:A") STRIP_ASSUME_TAC) o GSYM) THEN
      EXISTS_TAC (← q "z:A") THEN ASM_MESON_TAC [RING_MUL, RING_MUL_AC]])

  let VNREGULAR_IMP_BEZOUT_RING ← prove
   r"!r:A ring. vnregular_ring r ==> bezout_ring r"
   (GEN_TAC THEN
    REWRITE_TAC [BEZOUT_RING_SETADD, VNREGULAR_RING_PRINCIPAL_IDEALS] THEN
    DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"j:A->bool", ← q r"k:A->bool"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
      let tk ← SPEC (← q r"k:A->bool") th
      let tj ← SPEC (← q r"j:A->bool") th
      pure (MP_TAC tk THEN MP_TAC tj)) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "e:A") THEN STRIP_TAC THEN
    X_GEN_TAC (← q "i:A") THEN STRIP_TAC THEN
    REWRITE_TAC [PRINCIPAL_IDEAL_ALT] THEN
    EXISTS_TAC (← q "ring_sub r (ring_add r e i) (ring_mul r e i):A") THEN
    ASM_REWRITE_TAC [← GSYM IDEAL_GENERATED_INSERT] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [IDEAL_GENERATED_MINIMAL_EQ, RING_IDEAL_IDEAL_GENERATED] THEN
    CONJ_TAC THEN MATCH_MP_TAC (← SET_RULE (← q r"t SUBSET u ==> s INTER t SUBSET u")) THEN
    REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET] THENL
     [MATCH_MP_TAC IN_RING_IDEAL_SUB THEN
      REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED] THEN CONJ_TAC THENL
       [MATCH_MP_TAC IN_RING_IDEAL_ADD,
        MATCH_MP_TAC IN_RING_IDEAL_MUL] THEN
      REWRITE_TAC [RING_IDEAL_IDEAL_GENERATED] THEN CONJ_TAC THEN
      MATCH_MP_TAC IDEAL_GENERATED_INC_GEN THEN ASM_REWRITE_TAC [IN_INSERT],
      ASM_SIMP_TAC [IDEAL_GENERATED_SING_ALT, RING_SUB, RING_ADD, RING_MUL] THEN
      REWRITE_TAC [IN_ELIM_THM]] THEN
    CONJ_TAC THENL [EXISTS_TAC (← q "e:A"), EXISTS_TAC (← q "i:A")] THEN
    ASM_REWRITE_TAC [] THEN REPEAT (POP_ASSUM MP_TAC) THEN
    CONV_TAC (fun t => (RING_RULE t).run))

  let VNREGULAR_RING_FINITELY_GENERATED_IDEALS ← prove
   r"!r:A ring.
        vnregular_ring r <=>
        !j. finitely_generated_ideal r j
            ==> ?e. e IN ring_carrier r /\
                    ring_mul r e e = e /\
                    j = ideal_generated r {e}"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [BEZOUT_RING_FINITELY_GENERATED_EQ_PRINCIPAL_IDEAL,
                  VNREGULAR_IMP_BEZOUT_RING] THEN
    ASM_REWRITE_TAC [← GSYM VNREGULAR_RING_PRINCIPAL_IDEALS] THEN
    REWRITE_TAC [VNREGULAR_RING_PRINCIPAL_IDEALS] THEN
    ASM_MESON_TAC [PRINCIPAL_IMP_FINITELY_GENERATED_IDEAL])

  let VNREGULAR_RING_IDEAL_IDEMPOT ← prove
   r"!r j:A->bool.
        vnregular_ring r /\ ring_ideal r j ==> ring_setmul r j j = j"
   (REWRITE_TAC [vnregular_ring] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [RING_SETMUL_SUBSET_IDEAL,
                  RING_IDEAL_IMP_SUBSET, SUBSET_REFL] THEN
    REWRITE_TAC [SUBSET, ring_setmul, IN_ELIM_THM] THEN
    ASM_MESON_TAC [IN_RING_IDEAL_LMUL, RING_IDEAL_IMP_SUBSET, SUBSET])

  let VNREGULAR_RING ← prove
   r"!r:A ring.
        vnregular_ring (r:A ring) <=>
        !a. a IN ring_carrier r
            ==> ?x. x IN ring_carrier r /\
                    ring_mul r a (ring_mul r x a) = a /\
                    ring_mul r x (ring_mul r a x) = x"
   (GEN_TAC THEN REWRITE_TAC [vnregular_ring] THEN
    EQ_TAC THENL [DISCH_TAC, MESON_TAC []] THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "a:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "x:A") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q "ring_mul r x (ring_mul r a x):A") THEN
    ASM_SIMP_TAC [RING_MUL] THEN REPEAT (POP_ASSUM MP_TAC) THEN
    CONV_TAC (fun t => (RING_RULE t).run))

  let VNREGULAR_RING_ALT ← prove
   r"!r:A ring.
        vnregular_ring (r:A ring) <=>
        !a. a IN ring_carrier r
            ==> ?!x. x IN ring_carrier r /\
                     ring_mul r a (ring_mul r x a) = a /\
                     ring_mul r x (ring_mul r a x) = x"
   (GEN_TAC THEN REWRITE_TAC [VNREGULAR_RING] THEN MATCH_MP_TAC (← MESON []
     (← q r"(!a x y. P a /\ R a x /\ R a y ==> x = y)
    ==> ((!a. P a ==> ?x. R a x) <=> (!a. P a ==> ?!x. R a x))")) THEN
    CONV_TAC (fun t => (RING_RULE t).run))

  let VNREGULAR_RING_LOCALIZATION ← prove
   r"!r s:A->bool.
        vnregular_ring r /\ ring_multsys r s
        ==> vnregular_ring (ring_localization r s)"
   (← do
    let ss ← ExceptT.mk (basic_ss [])
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [vnregular_ring] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [RING_LOCALIZATION_CARRIER, FORALL_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "p:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "a:A")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "x:A") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ring_multsys]) THEN
    REWRITE_TAC [SUBSET] THEN STRIP_TAC THEN
    EXISTS_TAC (← q "ring_fractionate r s (ring_mul r p x:A)") THEN
    ASM_SIMP_TAC [RING_FRACTIONATE_IN_CARRIER, ← GSYM RING_LOCALIZATION_CARRIER,
                  RING_DIVIDES_LOCALEQUIV, RING_MUL] THEN
    ASM (simpTac ss 5)
     [ring_fractionate, RING_LOCALIZATION_MUL, RING_MUL, RING_MUL_LID,
      ← GSYM RING_LOCALEQUIV_EQUIV, ring_localequiv] THEN
    EXISTS_TAC (← q "ring_1 r:A") THEN ASM_SIMP_TAC [] THEN
    RING_TAC THEN ASM_SIMP_TAC []))

  let VNREGULAR_FRACTION_RING ← prove
   r"!r:A ring.
        vnregular_ring r ==> (fraction_ring r) isomorphic_ring r"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [fraction_ring] THEN
    MATCH_MP_TAC RING_LOCALIZATION_UNCHANGED THEN
    REWRITE_TAC [RING_MULTSYS_REGULAR] THEN
    ASM_SIMP_TAC [VNREGULAR_RING_REGULAR, SUBSET_REFL])

  -- @@RETURN BEGIN
  return { vnregular_ring, FIELD_IMP_VNREGULAR_RING, BOOLEAN_IMP_VNREGULAR_RING,
           VNREGULAR_RING_EPIMORPHIC_IMAGE, VNREGULAR_QUOTIENT_RING,
           ISOMORPHIC_RING_VNREGULARITY, VNREGULAR_PROD_RING, VNREGULAR_PRODUCT_RING,
           VNREGULAR_IMP_REDUCED_RING, VNREGULAR_RING_NILPOTENT, VNREGULAR_RING_REGULAR,
           VNREGULAR_DOMAIN, VNREGULAR_RING_PRINCIPAL_IDEALS, VNREGULAR_IMP_BEZOUT_RING,
           VNREGULAR_RING_FINITELY_GENERATED_IDEALS, VNREGULAR_RING_IDEAL_IDEMPOT,
           VNREGULAR_RING, VNREGULAR_RING_ALT, VNREGULAR_RING_LOCALIZATION,
           VNREGULAR_FRACTION_RING }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The ring of Booleans under xor, and, basically the field GF(2).          -/
/- (ringtheory.ml 16660-16726)                                               -/
/- ------------------------------------------------------------------------- -/

structure BoolRing where
  -- @@FIELDS
  bool_ring : thm
  BOOL_RING : thm
  FIELD_BOOL_RING : thm
  NOT_TRIVIAL_BOOL_RING : thm
  BOOLEAN_RING_BOOL_RING : thm
  INTEGRAL_DOMAIN_BOOL_RING : thm
  BOOL_RING_CARRIER_HAS_SIZE_2 : thm
  ISOMORPHIC_RING_BOOL_RING : thm
  deriving Inhabited

@[nospecialize]
def setupBoolRing [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BDomains : Domains) (BHoms : Homs) (BIso : Iso) (BRingRule : RingRule) (BBooleanRings : BooleanRings) :
    ExceptT String IO BoolRing := do
  -- @@SCOPE BEGIN
  let { SET_RULE, new_definition, .. } := D
  let { BETA_THM, .. } := D.core1
  let { EXISTS_BOOL_THM, .. } := D.core2
  let { FORALL_BOOL_THM, FORALL_IN_IMAGE, FORALL_IN_INSERT, HAS_SIZE_BOOL, .. } := D.core3
  let { IN_IMAGE, IN_UNIV, I_THM, .. } := D.core5
  let { NOT_IN_EMPTY, PAIR, PAIR_EQ, .. } := D.core6
  let { SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core7
  let { RING_0, RING_1, RING_ADD, RING_ADD_EQ_LEFT, RING_ADD_LZERO, RING_ADD_RZERO,
        RING_CARRIER_HAS_SIZE_2, RING_MUL_LID, RING_MUL_LZERO, RING_MUL_RID,
        RING_NEG_0, TRIVIAL_RING_10, ring_0, ring_1, ring_add, ring_carrier, ring_mul,
        ring_neg, ring_tybij, .. } := BBasics
  let { FIELD_IMP_INTEGRAL_DOMAIN, field, .. } := BDomains
  let { RING_ISOMORPHISM, ring_homomorphism, .. } := BHoms
  let { ISOMORPHIC_RING_SIZE, ISOMORPHIC_RING_SYM, isomorphic_ring, .. } := BIso
  let { RING_RULE, .. } := BRingRule
  let { boolean_ring, .. } := BBooleanRings
  -- @@SCOPE END

  let bool_ring ← new_definition
   r"bool_ring = ring((:bool),F,T,I,(\x y. ~(x <=> y)),(/\))"

  let BOOL_RING ← prove
   r"ring_carrier bool_ring = (:bool) /\
   ring_0 bool_ring = F /\
   ring_1 bool_ring = T /\
   ring_neg bool_ring = I /\
   ring_add bool_ring = (\x y. ~(x <=> y)) /\
   ring_mul bool_ring = (/\)"
   (PURE_REWRITE_TAC
     [← GSYM PAIR_EQ, ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul,
      BETA_THM, PAIR] THEN
    PURE_REWRITE_TAC [bool_ring, ← GSYM (← CONJUNCT2 ring_tybij)] THEN
    REWRITE_TAC [IN_UNIV, I_THM] THEN CONV_TAC (fun t => (TAUT t).run))

  let FIELD_BOOL_RING ← prove
   r"field bool_ring"
   (REWRITE_TAC [field, BOOL_RING, EXISTS_BOOL_THM, FORALL_BOOL_THM])

  let NOT_TRIVIAL_BOOL_RING ← prove
   r"~trivial_ring bool_ring"
   (REWRITE_TAC [TRIVIAL_RING_10, BOOL_RING])

  let BOOLEAN_RING_BOOL_RING ← prove
   r"boolean_ring bool_ring"
   (REWRITE_TAC [boolean_ring, BOOL_RING])

  let INTEGRAL_DOMAIN_BOOL_RING ← prove
   r"integral_domain bool_ring"
   (SIMP_TAC [FIELD_BOOL_RING, FIELD_IMP_INTEGRAL_DOMAIN])

  let BOOL_RING_CARRIER_HAS_SIZE_2 ← prove
   r"ring_carrier bool_ring HAS_SIZE 2"
   (REWRITE_TAC [BOOL_RING, HAS_SIZE_BOOL])

  let ISOMORPHIC_RING_BOOL_RING ← prove
   r"(!r:A ring. r isomorphic_ring bool_ring <=> ring_carrier r HAS_SIZE 2) /\
   (!r:A ring. bool_ring isomorphic_ring r <=> ring_carrier r HAS_SIZE 2)"
   (← do
    -- right to left: the SET_RULE first, then the RING_RULE
    let s2 ← SET_RULE (← q r"s = {a,b} ==> x IN s /\ ~(x = b) ==> x = a")
    let rr1 ← RING_RULE
     (← q r"x IN ring_carrier r /\ y IN ring_carrier r /\
    ring_add r x y = ring_0 r
    ==> y = ring_neg r x /\ ring_0 r = ring_add r x y")
    pure (GEN_REWRITE_TAC (RAND_CONV o BINDER_CONV o LAND_CONV)
     [ISOMORPHIC_RING_SYM] THEN
    REWRITE_TAC [] THEN GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP ISOMORPHIC_RING_SIZE th])) THEN
      REWRITE_TAC [BOOL_RING_CARRIER_HAS_SIZE_2],
      REWRITE_TAC [RING_CARRIER_HAS_SIZE_2, TRIVIAL_RING_10] THEN STRIP_TAC] THEN
    ONCE_REWRITE_TAC [ISOMORPHIC_RING_SYM] THEN
    REWRITE_TAC [isomorphic_ring, BOOL_RING] THEN
    EXISTS_TAC (← q r"(\p. if p then ring_1 r else ring_0 r):bool->A") THEN
    REWRITE_TAC [RING_ISOMORPHISM, ring_homomorphism, BOOL_RING] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, I_THM, IN_UNIV,
                 ← GSYM SUBSET_ANTISYM_EQ, IN_IMAGE] THEN
    REWRITE_TAC [FORALL_BOOL_THM, EXISTS_BOOL_THM] THEN
    ASM_SIMP_TAC [FORALL_IN_INSERT, RING_0, RING_1, NOT_IN_EMPTY,
                  RING_MUL_LID, RING_ADD_LZERO, RING_MUL_LZERO,
                  RING_MUL_RID, RING_ADD_RZERO, RING_NEG_0] THEN
    MATCH_MP_TAC rr1 THEN
    REWRITE_TAC [RING_1] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s2) THEN
    ASM_SIMP_TAC [RING_ADD, RING_1, RING_ADD_EQ_LEFT]))

  -- @@RETURN BEGIN
  return { bool_ring, BOOL_RING, FIELD_BOOL_RING, NOT_TRIVIAL_BOOL_RING,
           BOOLEAN_RING_BOOL_RING, INTEGRAL_DOMAIN_BOOL_RING,
           BOOL_RING_CARRIER_HAS_SIZE_2, ISOMORPHIC_RING_BOOL_RING }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The ring of integers.  (ringtheory.ml 16727-16883)                        -/
/- ------------------------------------------------------------------------- -/

structure IntegerRing where
  -- @@FIELDS
  integer_ring : thm
  INTEGER_RING : thm
  INTEGER_RING_POW : thm
  INTEGER_RING_UNIT : thm
  INTEGER_RING_DIVIDES : thm
  NOT_TRIVIAL_INTEGER_RING : thm
  NOT_FIELD_INTEGER_RING : thm
  RING_HOMOMORPHISM_INTEGER_RING_OF_INT : thm
  RING_MONOMORPHISM_INTEGER_RING_OF_INT : thm
  INTEGRAL_DOMAIN_INTEGER_RING : thm
  EUCLIDEAN_INTEGER_RING : thm
  PID_INTEGER_RING : thm
  UFD_INTEGER_RING : thm
  BEZOUT_INTEGER_RING : thm
  INTEGER_RING_OF_NUM : thm
  INTEGER_RING_OF_INT : thm
  INTEGER_RING_CHAR : thm
  INTEGER_RING_COPRIME : thm
  INTEGER_RING_ASSOCIATES : thm
  INTEGER_RING_GCD : thm
  INTEGER_RING_IDEAL_GENERATED_SING : thm
  INTEGER_RING_COSET_IDEAL_GENERATED_SING : thm
  deriving Inhabited

@[nospecialize]
def setupIntegerRing [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BKernels : Kernels) (BCosets : Cosets) (BUFDs : UFDs) (BEuclidean : Euclidean) (BRingGcd : RingGcd) (BBezout : Bezout) :
    ExceptT String IO IntegerRing := do
  -- @@SCOPE BEGIN
  let { INDUCT_TAC, INTEGER_RULE, INT_ARITH, INT_ARITH_TAC, INT_REDUCE_CONV, INT_RING,
        MESON, MESON_TAC, new_definition, .. } := D
  let { BETA_THM, .. } := D.core1
  let { EXISTS_OR_THM, .. } := D.core2
  let { FORALL_INT_CASES, FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, INT_ABS_POS, INT_DIVISION, INT_ENTIRE, INT_MUL_EQ_1,
        INT_OF_NUM_EQ, INT_OF_NUM_EXISTS, INT_OF_NUM_LT, INT_OF_NUM_OF_INT,
        INT_OF_NUM_SUC, INT_POS, INT_POW, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, IN_UNIV, I_THM, .. } := D.core5
  let { PAIR, PAIR_EQ, .. } := D.core6
  let { RIGHT_OR_DISTRIB, SUBSET, UNWIND_THM2, .. } := D.core7
  let { int_coprime, int_divides, int_gcd, int_mod, o_DEF, .. } := D.core8
  let { TRIVIAL_RING_10, ring_0, ring_1, ring_add, ring_carrier, ring_mul, ring_neg,
        ring_sub, ring_tybij, .. } := BBasics
  let { RING_CHAR_EQ_0, RING_OF_INT, RING_OF_INT_0, RING_OF_INT_1, RING_OF_INT_ADD,
        RING_OF_INT_CASES, RING_OF_INT_EQ_0, RING_OF_INT_MUL, RING_OF_INT_NEG,
        ring_of_num, ring_pow, .. } := BNumbers
  let { ring_associates, ring_divides, ring_unit, .. } := BDivides
  let { IDEAL_GENERATED_SING, .. } := BIdeals
  let { FIELD_EQ_ALL_UNITS, INTEGRAL_DOMAIN_ASSOCIATES, integral_domain, .. } := BDomains
  let { ring_homomorphism, .. } := BHoms
  let { RING_MONOMORPHISM_ALT, .. } := BKernels
  let { RING_COSET_IDEAL_GENERATED_SING, .. } := BCosets
  let { PID_IMP_UFD, .. } := BUFDs
  let { EUCLIDEAN_DOMAIN_IMP_PID, euclidean_ring, .. } := BEuclidean
  let { ring_gcd, .. } := BRingGcd
  let { BEZOUT_RING_COPRIME, PID_IMP_BEZOUT_RING, .. } := BBezout
  -- @@SCOPE END

  let integer_ring ← new_definition
   r"integer_ring = ring((:int),&0,&1,( -- ),( + ),( * ))"

  let INTEGER_RING ← prove
   r"ring_carrier integer_ring = (:int) /\
   ring_0 integer_ring = &0 /\
   ring_1 integer_ring = &1 /\
   ring_neg integer_ring = ( -- ) /\
   ring_add integer_ring = ( + ) /\
   ring_mul integer_ring = ( * )"
   (PURE_REWRITE_TAC
     [← GSYM PAIR_EQ, ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul,
      BETA_THM, PAIR] THEN
    PURE_REWRITE_TAC [integer_ring, ← GSYM (← CONJUNCT2 ring_tybij)] THEN
    REWRITE_TAC [IN_UNIV] THEN CONV_TAC (fun t => (INT_RING t).run))

  let INTEGER_RING_POW ← prove
   r"!q:int n. ring_pow integer_ring q n = q pow n"
   (GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [ring_pow, INT_POW, INTEGER_RING])

  let INTEGER_RING_UNIT ← prove
   r"!x. ring_unit integer_ring x <=> x = &1 \/ x = -- &1"
   (REWRITE_TAC [ring_unit, INTEGER_RING, INT_MUL_EQ_1, IN_UNIV] THEN
    MESON_TAC [])

  let INTEGER_RING_DIVIDES ← prove
   r"!a b. ring_divides integer_ring a b <=> a divides b"
   (REWRITE_TAC [ring_divides, INTEGER_RING, IN_UNIV, int_divides])

  let NOT_TRIVIAL_INTEGER_RING ← prove
   r"~trivial_ring integer_ring"
   (REWRITE_TAC [TRIVIAL_RING_10, INTEGER_RING] THEN
    CONV_TAC INT_REDUCE_CONV)

  let NOT_FIELD_INTEGER_RING ← prove
   r"~field integer_ring"
   (REWRITE_TAC [FIELD_EQ_ALL_UNITS, INTEGER_RING_UNIT, INTEGER_RING] THEN
    DISCH_THEN (MP_TAC o SPEC (← q "&2:int") o CONJUNCT2) THEN REWRITE_TAC [IN_UNIV] THEN
    CONV_TAC INT_REDUCE_CONV)

  let RING_HOMOMORPHISM_INTEGER_RING_OF_INT ← prove
   r"!r:A ring. ring_homomorphism (integer_ring,r) (ring_of_int r)"
   (GEN_TAC THEN REWRITE_TAC [ring_homomorphism, INTEGER_RING] THEN
    REWRITE_TAC [IN_UNIV, RING_OF_INT_0, RING_OF_INT_1, RING_OF_INT_NEG] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RING_OF_INT] THEN
    REWRITE_TAC [RING_OF_INT_ADD, RING_OF_INT_MUL])

  let RING_MONOMORPHISM_INTEGER_RING_OF_INT ← prove
   r"!r:A ring. ring_monomorphism (integer_ring,r) (ring_of_int r) <=>
              ring_char r = 0"
   (← do
    let i2 ← INTEGER_RULE (← q r"!x:int. x divides x")
    let i1 ← INTEGER_RULE (← q r"!x:int. &0 divides x <=> x = &0")
    pure (SIMP_TAC [RING_MONOMORPHISM_ALT, RING_HOMOMORPHISM_INTEGER_RING_OF_INT] THEN
    REWRITE_TAC [RING_OF_INT_EQ_0, INTEGER_RING, IN_UNIV, ← GSYM INT_OF_NUM_EQ] THEN
    MESON_TAC [i1, i2]))

  let INTEGRAL_DOMAIN_INTEGER_RING ← prove
   r"integral_domain integer_ring"
   (REWRITE_TAC [integral_domain, INTEGER_RING, INT_ENTIRE, IN_UNIV] THEN
    CONV_TAC INT_REDUCE_CONV)

  let EUCLIDEAN_INTEGER_RING ← prove
   r"euclidean_ring integer_ring"
   (REWRITE_TAC [euclidean_ring, INTEGER_RING, IN_UNIV] THEN
    EXISTS_TAC (← q "num_of_int o abs") THEN
    REWRITE_TAC [← GSYM INT_OF_NUM_LT, o_DEF] THEN
    SIMP_TAC [INT_OF_NUM_OF_INT, INT_ABS_POS] THEN
    MAP_EVERY X_GEN_TAC [← q "a:int", ← q "b:int"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q "a div b:int", ← q "a rem b:int"] THEN
    MP_TAC (← SPECL [← q "a:int", ← q "b:int"] INT_DIVISION) THEN
    ASM_REWRITE_TAC [] THEN INT_ARITH_TAC)

  let PID_INTEGER_RING ← prove
   r"PID integer_ring"
   (MATCH_MP_TAC EUCLIDEAN_DOMAIN_IMP_PID THEN
    REWRITE_TAC [INTEGRAL_DOMAIN_INTEGER_RING, EUCLIDEAN_INTEGER_RING])

  let UFD_INTEGER_RING ← prove
   r"UFD integer_ring"
   (SIMP_TAC [PID_IMP_UFD, PID_INTEGER_RING])

  let BEZOUT_INTEGER_RING ← prove
   r"bezout_ring integer_ring"
   (SIMP_TAC [PID_INTEGER_RING, PID_IMP_BEZOUT_RING])

  let INTEGER_RING_OF_NUM ← prove
   r"ring_of_num integer_ring = int_of_num"
   (REWRITE_TAC [FUN_EQ_THM] THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [ring_of_num, INTEGER_RING, ← GSYM INT_OF_NUM_SUC])

  let INTEGER_RING_OF_INT ← prove
   r"ring_of_int integer_ring = I"
   (REWRITE_TAC [FUN_EQ_THM, I_THM] THEN
    REWRITE_TAC [RING_OF_INT_CASES, FORALL_INT_CASES] THEN
    REWRITE_TAC [INTEGER_RING_OF_NUM, INTEGER_RING])

  let INTEGER_RING_CHAR ← prove
   r"ring_char integer_ring = 0"
   (SIMP_TAC [RING_CHAR_EQ_0, INTEGER_RING_OF_NUM, INTEGER_RING, INT_OF_NUM_EQ])

  let INTEGER_RING_COPRIME ← prove
   r"ring_coprime integer_ring = coprime"
   (REWRITE_TAC [FUN_EQ_THM, FORALL_PAIR_THM, int_coprime] THEN
    SIMP_TAC [BEZOUT_RING_COPRIME, BEZOUT_INTEGER_RING] THEN
    REWRITE_TAC [INTEGER_RING, IN_UNIV])

  let INTEGER_RING_ASSOCIATES ← prove
   r"!x y. ring_associates integer_ring x y <=> x = y \/ x = --y"
   (SIMP_TAC [INTEGRAL_DOMAIN_ASSOCIATES, INTEGRAL_DOMAIN_INTEGER_RING] THEN
    REWRITE_TAC [INTEGER_RING_UNIT, INTEGER_RING, IN_UNIV] THEN
    REWRITE_TAC [RIGHT_OR_DISTRIB, UNWIND_THM2, EXISTS_OR_THM] THEN
    INT_ARITH_TAC)

  let INTEGER_RING_GCD ← prove
   r"ring_gcd integer_ring = gcd"
   (← do
    -- right to left: the INTEGER_RULE, the second INT_ARITH, the MESON,
    -- then the first INT_ARITH
    let i4 ← INTEGER_RULE
     (← q r"(n:int) divides a /\ n divides b ==> n divides gcd(a,b)")
    let a3 ← INT_ARITH
     (← q r"&0:int <= x /\ &0 <= y /\ (x = y \/ x = --y) ==> x = y")
    let m2 ← MESON []
     (← q r"P x /\ (!x'. P x' ==> x' = x)
    ==> (if ?x. P x then @x. P x else a) = x")
    let a1 ← INT_ARITH
     (← q r"&0:int <= x /\ (x = &1 \/ x = -- &1) ==> &1 = x")
    let ir : ioconv := fun t => (INTEGER_RULE t).run
    pure (REWRITE_TAC [FUN_EQ_THM, FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "a:int", ← q "b:int"] THEN
    REWRITE_TAC [ring_gcd, INTEGER_RING, IN_UNIV, INTEGER_RING_COPRIME] THEN
    COND_CASES_TAC THENL
     [MATCH_MP_TAC a1 THEN
      REWRITE_TAC [int_gcd, ← GSYM INTEGER_RING_ASSOCIATES] THEN
      REWRITE_TAC [ring_associates, INTEGER_RING_DIVIDES] THEN
      CONJ_TAC THEN POP_ASSUM MP_TAC THEN CONV_TAC ir,
      ALL_TAC] THEN
    MATCH_MP_TAC m2 THEN
    REWRITE_TAC [INTEGER_RING_DIVIDES] THEN CONJ_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, CONV_TAC ir] THEN
      REWRITE_TAC [IN_IMAGE, INTEGER_RING_OF_NUM, IN_UNIV] THEN
      REWRITE_TAC [INT_OF_NUM_EXISTS, int_gcd],
      REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, INTEGER_RING_OF_NUM, IN_UNIV]] THEN
    X_GEN_TAC (← q "n:num") THEN REWRITE_TAC [IMP_IMP] THEN STRIP_TAC THEN
    MATCH_MP_TAC a3 THEN
    REWRITE_TAC [INT_POS, int_gcd, ← GSYM INTEGER_RING_ASSOCIATES] THEN
    REWRITE_TAC [ring_associates, INTEGER_RING_DIVIDES] THEN
    ASM_SIMP_TAC [i4] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN CONV_TAC ir))

  let INTEGER_RING_IDEAL_GENERATED_SING ← prove
   r"!n. ideal_generated integer_ring {n} = {x | n divides x}"
   (SIMP_TAC [IDEAL_GENERATED_SING, ← CONJUNCT1 INTEGER_RING, IN_UNIV] THEN
    REWRITE_TAC [INTEGER_RING_DIVIDES])

  let INTEGER_RING_COSET_IDEAL_GENERATED_SING ← prove
   r"!n. ring_coset integer_ring (ideal_generated integer_ring {n}) = mod n"
   (SIMP_TAC [FUN_EQ_THM, RING_COSET_IDEAL_GENERATED_SING, INTEGER_RING, IN_UNIV,
              INTEGER_RING_DIVIDES, int_mod, ring_sub, IN_ELIM_THM] THEN
    CONV_TAC (fun t => (INTEGER_RULE t).run))

  -- @@RETURN BEGIN
  return { integer_ring, INTEGER_RING, INTEGER_RING_POW, INTEGER_RING_UNIT,
           INTEGER_RING_DIVIDES, NOT_TRIVIAL_INTEGER_RING, NOT_FIELD_INTEGER_RING,
           RING_HOMOMORPHISM_INTEGER_RING_OF_INT, RING_MONOMORPHISM_INTEGER_RING_OF_INT,
           INTEGRAL_DOMAIN_INTEGER_RING, EUCLIDEAN_INTEGER_RING, PID_INTEGER_RING,
           UFD_INTEGER_RING, BEZOUT_INTEGER_RING, INTEGER_RING_OF_NUM,
           INTEGER_RING_OF_INT, INTEGER_RING_CHAR, INTEGER_RING_COPRIME,
           INTEGER_RING_ASSOCIATES, INTEGER_RING_GCD, INTEGER_RING_IDEAL_GENERATED_SING,
           INTEGER_RING_COSET_IDEAL_GENERATED_SING }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Ring of integers mod n, defaulting to all integers when n = 0.           -/
/- (ringtheory.ml 16884-17327)                                               -/
/- ------------------------------------------------------------------------- -/

structure IntegerModRing where
  -- @@FIELDS
  integer_mod_ring : thm
  INTEGER_MOD_RING : thm
  IN_INTEGER_MOD_RING_CARRIER : thm
  RING_CARRIER_INTEGER_MOD_RING : thm
  INTEGER_MOD_RING_CARRIER_REM : thm
  INTEGER_MOD_RING_TRIVIAL : thm
  INTEGER_MOD_RING_SUB : thm
  INTEGER_MOD_RING_POW : thm
  INTEGER_MOD_RING_OF_NUM : thm
  INTEGER_MOD_RING_OF_INT : thm
  INTEGER_MOD_RING_CLAUSES : thm
  INTEGER_MOD_RING_CHAR : thm
  INTEGER_MOD_RING_DIVIDES : thm
  INTEGER_MOD_RING_ASSOCIATES : thm
  INTEGER_MOD_RING_UNIT : thm
  TRIVIAL_INTEGER_MOD_RING : thm
  FINITE_INTEGER_MOD_RING : thm
  CARD_INTEGER_MOD_RING : thm
  FIELD_INTEGER_MOD_RING : thm
  INTEGRAL_DOMAIN_INTEGER_MOD_RING : thm
  RING_HOMOMORPHISM_INTEGER_MOD_RING_OF_INT : thm
  RING_MONOMORPHISM_INTEGER_MOD_RING_OF_INT : thm
  RING_HOMOMORPHISM_FROM_INTEGER_MOD_RING : thm
  RING_MONOMORPHISM_FROM_INTEGER_MOD_RING : thm
  RING_HOMOMORPHISM_INTEGER_MOD_RINGS : thm
  RING_HOMOMORPHISM_INTEGER_MOD_RINGS_POW : thm
  RING_HOMOMORPHISM_PROD_INTEGER_MOD_RING : thm
  RING_ISOMORPHISM_PROD_INTEGER_MOD_RING : thm
  ISOMORPHIC_PROD_INTEGER_MOD_RING : thm
  VNREGULAR_INTEGER_MOD_RING : thm
  INTEGER_QUOTIENT_RING_ISOMORPHIC_MOD : thm
  RING_ISOMORPHISM_PRIME_SUBRING : thm
  ISOMORPHIC_PRIME_SUBRING : thm
  FIELD_PRIME_SUBRING : thm
  deriving Inhabited

@[nospecialize]
def setupIntegerModRing [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) (BDivides : Divides) (BIdeals : Ideals) (BDomains : Domains) (BHoms : Homs) (BIso : Iso) (BKernels : Kernels) (BProdRings : ProdRings) (BCosets : Cosets) (BQuotients : Quotients) (BVonNeumann : VonNeumann) (BIntegerRing : IntegerRing) :
    ExceptT String IO IntegerModRing := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_INT_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, INTEGER_RULE,
        INTEGER_TAC, INT_ARITH, INT_REM_DOWN_CONV, MESON, MESON_TAC, NUMBER_RULE,
        NUMBER_TAC, NUM_REDUCE_CONV, SET_RULE, new_definition, .. } := D
  let { AND_FORALL_THM, ARITH_EQ, BETA_THM, CARD_IMAGE_INJ, CARD_NUMSEG_LT, .. } := D.core1
  let { CONJ_ASSOC, DIVIDES_EXP_LE_IMP, DIVIDES_LCM_GCD, DIVIDES_LE, DIVIDES_REFL,
        EQ_IMP, ETA_AX, EXISTS_IN_IMAGE, EXISTS_REFL, .. } := D.core2
  let { FINITE_INT_SEG, FINITE_NUMSEG_LT, FORALL_AND_THM, FORALL_INT_CASES,
        FORALL_IN_CROSS, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_ID, .. } := D.core3
  let { IMAGE_o, IMP_CONJ, INFINITE, INT_ABS_NUM, INT_ADD_LID, INT_ADD_LINV,
        INT_ADD_REM, INT_ADD_RID, INT_CONG_IMP_EQ, INT_CONG_LREM, INT_CONG_RREM,
        INT_DIVIDES_RABS, INT_DIVISION, INT_EXISTS_POS, INT_FORALL_ABS, INT_FORALL_POS,
        INT_LE_REFL, INT_LT_REM, INT_LT_REM_EQ, INT_MUL_LID, INT_MUL_REM, INT_NEG_REM,
        INT_OF_NUM_CLAUSES, INT_OF_NUM_EQ, INT_OF_NUM_LT, INT_OF_NUM_MUL,
        INT_OF_NUM_SUC, INT_POS, INT_POW, INT_POW2_ABS, INT_REM_0, .. } := D.core4
  let { INT_REM_EQ, INT_REM_EQ_SELF, INT_REM_LT, INT_REM_POS, INT_REM_POS_EQ,
        INT_REM_REFL, INT_REM_REM, INT_REM_REM_MUL, INT_REM_ZERO, INT_SUB, IN_CROSS,
        IN_ELIM_THM, IN_IMAGE, IN_UNIV, LCM, LE_1, LE_LT, .. } := D.core5
  let { LT_REFL, NOT_LE, NUM_GCD, NUM_LCM, PAIR, PAIR_EQ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SQUAREFREE_GCD_SQUARE, SUBSET,
        SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, UNWIND_THM1, .. } := D.core7
  let { coprime, int_INFINITE, int_gcd, num_coprime, num_divides, o_THM, prime, .. } := D.core8
  let { RING_1, TRIVIAL_RING_10, ring_0, ring_1, ring_add, ring_carrier, ring_mul,
        ring_neg, ring_sub, ring_tybij, .. } := BBasics
  let { RING_CHAR_UNIQUE, RING_OF_INT, RING_OF_INT_1, RING_OF_INT_ADD,
        RING_OF_INT_CASES, RING_OF_INT_EQ, RING_OF_INT_EQ_0, RING_OF_INT_MUL,
        RING_OF_INT_OF_NUM, ring_of_num, ring_pow, .. } := BNumbers
  let { RING_UNIT_DIVIDES, ring_associates, ring_divides, .. } := BDivides
  let { RING_IDEAL_IDEAL_GENERATED, .. } := BIdeals
  let { FIELD_EQ_ALL_UNITS, FINITE_INTEGRAL_DOMAIN_EQ_FIELD, integral_domain, .. } := BDomains
  let { RING_CHAR_HOMOMORPHIC_IMAGE, RING_CHAR_MONOMORPHIC_IMAGE, RING_HOMOMORPHISM,
        RING_HOMOMORPHISM_RING_OF_INT, RING_ISOMORPHISM, RING_ISOMORPHISM_EQ,
        RING_ISOMORPHISM_IMP_HOMOMORPHISM, RING_ISOMORPHISM_SUBSET, .. } := BHoms
  let { ISOMORPHIC_RING_SYM, isomorphic_ring, .. } := BIso
  let { ISOMORPHIC_RING_FIELDNESS, RING_ISOMORPHISM_ONTO_IMAGE, RING_MONOMORPHISM_ALT,
        ring_image, .. } := BKernels
  let { PROD_RING, RING_OF_INT_PROD_RING, .. } := BProdRings
  let { PRIME_SUBRING_FINITE, RING_COSET_IDEAL_GENERATED_SING_EQ, .. } := BCosets
  let { QUOTIENT_RING_0, QUOTIENT_RING_1, QUOTIENT_RING_ADD, QUOTIENT_RING_CARRIER,
        QUOTIENT_RING_MUL, .. } := BQuotients
  let { vnregular_ring, .. } := BVonNeumann
  let { INTEGER_RING, INTEGER_RING_ASSOCIATES, INTEGER_RING_DIVIDES,
        INTEGRAL_DOMAIN_INTEGER_RING, NOT_FIELD_INTEGER_RING, NOT_TRIVIAL_INTEGER_RING, .. } := BIntegerRing
  -- @@SCOPE END

  let integer_mod_ring ← new_definition
   r"integer_mod_ring n =
        if n = 0 then integer_ring else
        ring({m | &0 <= m /\ m < &n},
             &0,
             &1 rem &n,
             (\a. --a rem &n),
             (\a b. (a + b) rem &n),
             (\a b. (a * b) rem &n))"

  let INTEGER_MOD_RING ← prove
   r"ring_carrier (integer_mod_ring 0) = (:int) /\
   (!n. 0 < n
        ==> ring_carrier(integer_mod_ring n) = {m | &0 <= m /\ m < &n}) /\
   (!n. ring_0 (integer_mod_ring n) = &0) /\
   (!n. ring_1 (integer_mod_ring n) = &1 rem &n) /\
   (!n. ring_neg (integer_mod_ring n) = (\a. --a rem &n)) /\
   (!n. ring_add (integer_mod_ring n) = (\a b. (a + b) rem &n)) /\
   (!n. ring_mul (integer_mod_ring n) = (\a b. (a * b) rem &n))"
   (REWRITE_TAC [integer_mod_ring, INTEGER_RING] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q "n:num") THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [INTEGER_RING, LT_REFL, INT_REM_0] THENL
     [REWRITE_TAC [FUN_EQ_THM], ASM_SIMP_TAC [LE_1]] THEN
    PURE_REWRITE_TAC
     [← GSYM PAIR_EQ, ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul,
      BETA_THM, PAIR] THEN
    PURE_REWRITE_TAC [integer_mod_ring, ← GSYM (← CONJUNCT2 ring_tybij)] THEN
    MP_TAC (← GEN (← q "m:int") (← SPECL [← q "m:int", ← q "&n:int"] INT_DIVISION)) THEN
    ASM_REWRITE_TAC [INT_OF_NUM_EQ, INT_ABS_NUM, FORALL_AND_THM] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, INT_LE_REFL] THEN
    ASM_SIMP_TAC [INT_OF_NUM_LT, LE_1, INT_ADD_LID, INT_ADD_RID] THEN
