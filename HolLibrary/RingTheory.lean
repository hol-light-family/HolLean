           ASSUME_TAC THENL
          [ASM_CASES_TAC (← q "qhh:(1->num)->A = ring_0(poly_ring r (:1))") THENL
           [ASM_SIMP_TAC [RING_MUL_RZERO, POLY_CONST] THEN
            REWRITE_TAC [POLY_RING, POLY_DEG_0, LE_0],
