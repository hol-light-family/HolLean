  MAXIMAL_IDEAL_CORRESPONDENCE : thm
  MAXIMAL_IDEAL_EPIMORPHIC_PREIMAGE : thm
  MAXIMAL_IDEAL_ISOMORPHIC_IMAGE_EQ : thm
