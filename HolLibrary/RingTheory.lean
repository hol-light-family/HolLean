    ASM_SIMP_TAC [LE_REFL, a2] THEN
    REWRITE_TAC [RING_PRODUCT] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC))

  let UFD_IMP_GCD_EXISTS ← prove
