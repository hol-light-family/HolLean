     (← q r"ring_sub r y y2 = y1
      ==> ring_add r (ring_mul r (ring_mul r x n) q) y =
          ring_add r (ring_add r (ring_mul r n (ring_mul r x q)) y1) y2")
    let md ← MESON [POWSER_MUL_0]
     (← q r"ring_powerseries r q /\ p = poly_0 r
