@[nospecialize]
def setupBasics [HolBase] (D : RingTheoryDeps) :
    ExceptT String IO Basics := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, HAS_SIZE_CONV, MESON, MESON_TAC, SET_RULE, SET_TAC,
        new_definition, new_type_definition, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { EQ_TRANS, EXISTS_UNPAIR_THM, EXTENSION, .. } := D.core2
  let { FINITE_SING, .. } := D.core3
  let { IN_SING, LEFT_IMP_EXISTS_THM, .. } := D.core5
  let { MEMBER_NOT_EMPTY, PAIR_EQ, .. } := D.core6
  let { SING_SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core7
  -- @@SCOPE END

  let ring_tybij ← do
    let eth ← prove
     r"?s (z:A) w n a m.
          z IN s /\
          w IN s /\
          (!x. x IN s ==> n x IN s) /\
          (!x y. x IN s /\ y IN s ==> a x y IN s) /\
          (!x y. x IN s /\ y IN s ==> m x y IN s) /\
          (!x y. x IN s /\ y IN s ==> a x y = a y x) /\
          (!x y z. x IN s /\ y IN s /\ z IN s ==> a x (a y z) = a (a x y) z) /\
          (!x. x IN s ==> a z x = x) /\
          (!x. x IN s ==> a (n x) x = z) /\
          (!x y. x IN s /\ y IN s ==> m x y = m y x) /\
          (!x y z. x IN s /\ y IN s /\ z IN s ==> m x (m y z) = m (m x y) z) /\
          (!x. x IN s ==> m w x = x) /\
          (!x y z. x IN s /\ y IN s /\ z IN s
                   ==>  m x (a y z) = a (m x y) (m x z))"
     (MAP_EVERY EXISTS_TAC
       [← q "{ARB:A}", ← q "ARB:A", ← q "ARB:A", ← q r"(\x. ARB):A->A",
        ← q r"(\x y. ARB):A->A->A", ← q r"(\x y. ARB):A->A->A"] THEN
      REWRITE_TAC [IN_SING] THEN MESON_TAC [])
    new_type_definition "ring" ("ring", "ring_operations")
     (← GEN_REWRITE_RULE DEPTH_CONV [EXISTS_UNPAIR_THM] eth)

  -- The ring operations, primitive plus subtraction as a derived operation.

  let ring_carrier ← new_definition
   r"(ring_carrier:(A)ring->A->bool) =
    \r. FST(ring_operations r)"

  let ring_0 ← new_definition
   r"(ring_0:(A)ring->A) =
    \r. FST(SND(ring_operations r))"

  let ring_1 ← new_definition
   r"(ring_1:(A)ring->A) =
    \r. FST(SND(SND(ring_operations r)))"

  let ring_neg ← new_definition
   r"(ring_neg:(A)ring->A->A) =
    \r. FST(SND(SND(SND(ring_operations r))))"

  let ring_add ← new_definition
   r"(ring_add:(A)ring->A->A->A) =
    \r. FST(SND(SND(SND(SND(ring_operations r)))))"

  let ring_mul ← new_definition
   r"(ring_mul:(A)ring->A->A->A) =
    \r. SND(SND(SND(SND(SND(ring_operations r)))))"

  let ring_sub ← new_definition
   r"ring_sub r x y = ring_add r x (ring_neg r y)"

  let RINGS_EQ ← prove
   r"!r r':A ring.
        r = r' <=>
        ring_carrier r = ring_carrier r' /\
        ring_0 r = ring_0 r' /\
        ring_1 r = ring_1 r' /\
        ring_neg r = ring_neg r' /\
        ring_add r = ring_add r' /\
        ring_mul r = ring_mul r'"
   (REWRITE_TAC [← GSYM PAIR_EQ] THEN
    REWRITE_TAC [ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul] THEN
    MESON_TAC [← CONJUNCT1 ring_tybij])

  -- Ring properties and other elementary consequences.

  let RING_PROPERTIES ← MATCH_MP
    (← MESON [] (← q r"(!x. f(g x) = x) /\ (!y. P y <=> g(f y) = y) ==> !x. P(g x)"))
    ring_tybij

  let RING_0 ← prove
   r"!r:A ring. ring_0 r IN ring_carrier r"
   (REWRITE_TAC [ring_carrier, ring_0] THEN MESON_TAC [RING_PROPERTIES])

  let RING_1 ← prove
   r"!r:A ring. ring_1 r IN ring_carrier r"
   (REWRITE_TAC [ring_carrier, ring_1] THEN MESON_TAC [RING_PROPERTIES])

  let RING_NEG ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_neg r x IN ring_carrier r"
   (REWRITE_TAC [ring_neg, ring_carrier] THEN MESON_TAC [RING_PROPERTIES])

  let RING_ADD ← prove
   r"!r x y:A. x IN ring_carrier r /\ y IN ring_carrier r
             ==> ring_add r x y IN ring_carrier r"
   (REWRITE_TAC [ring_add, ring_carrier] THEN MESON_TAC [RING_PROPERTIES])

  let RING_SUB ← prove
   r"!r x y:A. x IN ring_carrier r /\ y IN ring_carrier r
             ==> ring_sub r x y IN ring_carrier r"
   (SIMP_TAC [ring_sub, RING_ADD, RING_NEG])

  let RING_MUL ← prove
   r"!r x y:A. x IN ring_carrier r /\ y IN ring_carrier r
             ==> ring_mul r x y IN ring_carrier r"
   (REWRITE_TAC [ring_mul, ring_carrier] THEN MESON_TAC [RING_PROPERTIES])

  let RING_ADD_SYM ← prove
   r"!r x y:A. x IN ring_carrier r /\ y IN ring_carrier r
             ==> ring_add r x y = ring_add r y x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_add, ring_carrier] THEN
    MESON_TAC [RING_PROPERTIES])

  let RING_MUL_SYM ← prove
   r"!r x y:A. x IN ring_carrier r /\ y IN ring_carrier r
             ==> ring_mul r x y = ring_mul r y x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_mul, ring_carrier] THEN
    MESON_TAC [RING_PROPERTIES])

  let RING_ADD_ASSOC ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==> ring_add r x (ring_add r y z) = ring_add r (ring_add r x y) z"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_add, ring_0, ring_carrier] THEN
    MESON_TAC [RING_PROPERTIES])

  let RING_MUL_ASSOC ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==> ring_mul r x (ring_mul r y z) = ring_mul r (ring_mul r x y) z"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_mul, ring_carrier] THEN
    MESON_TAC [RING_PROPERTIES])

  let RING_ADD_LDISTRIB ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==>  ring_mul r x (ring_add r y z) =
             ring_add r (ring_mul r x y) (ring_mul r x z)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_add, ring_mul, ring_carrier] THEN
    MESON_TAC [RING_PROPERTIES])

  let RING_ADD_RDISTRIB ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==> ring_mul r (ring_add r x y) z =
            ring_add r (ring_mul r x z) (ring_mul r y z)"
   (MESON_TAC [RING_MUL_SYM, RING_ADD, RING_ADD_LDISTRIB])

  let RING_ADD_LZERO ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_add r (ring_0 r) x = x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_add, ring_0, ring_carrier] THEN
    MESON_TAC [RING_PROPERTIES])

  let RING_ADD_RZERO ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_add r x (ring_0 r) = x"
   (MESON_TAC [RING_ADD_SYM, RING_0, RING_ADD_LZERO])

  let RING_MUL_LID ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_mul r (ring_1 r) x = x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_mul, ring_1, ring_carrier] THEN
    MESON_TAC [RING_PROPERTIES])

  let RING_MUL_RID ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_mul r x (ring_1 r) = x"
   (MESON_TAC [RING_MUL_SYM, RING_1, RING_MUL_LID])

  let RING_ADD_LNEG ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_add r (ring_neg r x) x = ring_0 r"
   (REWRITE_TAC [ring_add, ring_neg, ring_0, ring_carrier] THEN
    MESON_TAC [RING_PROPERTIES])

  let RING_ADD_RNEG ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_add r x (ring_neg r x) = ring_0 r"
   (MESON_TAC [RING_ADD_SYM, RING_NEG, RING_ADD_LNEG])

  let RING_ADD_AC ← prove
   r"!r:A ring.
        (!x y. x IN ring_carrier r /\ y IN ring_carrier r
               ==> ring_add r x y = ring_add r y x) /\
        (!x y z. x IN ring_carrier r /\ y IN ring_carrier r /\
                 z IN ring_carrier r
                 ==> ring_add r (ring_add r x y) z =
                     ring_add r x (ring_add r y z)) /\
        (!x y z. x IN ring_carrier r /\ y IN ring_carrier r /\
                 z IN ring_carrier r
                 ==> ring_add r x (ring_add r y z) =
                     ring_add r y (ring_add r x z))"
   (MESON_TAC [RING_ADD_SYM, RING_ADD_ASSOC, RING_ADD])

  let RING_MUL_AC ← prove
   r"!r:A ring.
        (!x y. x IN ring_carrier r /\ y IN ring_carrier r
               ==> ring_mul r x y = ring_mul r y x) /\
        (!x y z. x IN ring_carrier r /\ y IN ring_carrier r /\
                 z IN ring_carrier r
                 ==> ring_mul r (ring_mul r x y) z =
                     ring_mul r x (ring_mul r y z)) /\
        (!x y z. x IN ring_carrier r /\ y IN ring_carrier r /\
                 z IN ring_carrier r
                 ==> ring_mul r x (ring_mul r y z) =
                     ring_mul r y (ring_mul r x z))"
   (MESON_TAC [RING_MUL_SYM, RING_MUL_ASSOC, RING_MUL])

  let RING_ADD_LCANCEL ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==> (ring_add r x y = ring_add r x z <=> y = z)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"\y:A. ring_add r (ring_neg r x) y")) THEN
    ASM_SIMP_TAC [RING_ADD_ASSOC, RING_NEG, RING_ADD_LNEG, RING_ADD_LZERO])

  let RING_ADD_RCANCEL ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==> (ring_add r x z = ring_add r y z <=> x = y)"
   (MESON_TAC [RING_ADD_SYM, RING_ADD_LCANCEL])

  let RING_ADD_LCANCEL_IMP ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r /\
        ring_add r x y = ring_add r x z
        ==> y = z"
   (MESON_TAC [RING_ADD_LCANCEL])

  let RING_ADD_RCANCEL_IMP ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r /\
        ring_add r x z = ring_add r y z
        ==> x = y"
   (MESON_TAC [RING_ADD_RCANCEL])

  let RING_ADD_EQ_RIGHT ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_add r x y = y <=> x = ring_0 r)"
   (MESON_TAC [RING_ADD_RCANCEL, RING_NEG, RING_0, RING_ADD_LZERO])

  let RING_ADD_EQ_LEFT ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_add r x y = x <=> y = ring_0 r)"
   (MESON_TAC [RING_ADD_EQ_RIGHT, RING_ADD_SYM])

  let RING_LZERO_UNIQUE ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ ring_add r x y = y
        ==> x = ring_0 r"
   (MESON_TAC [RING_ADD_EQ_RIGHT])

  let RING_RZERO_UNIQUE ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ ring_add r x y = x
        ==> y = ring_0 r"
   (MESON_TAC [RING_ADD_EQ_LEFT])

  let RING_ADD_EQ_0 ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_add r x y = ring_0 r <=> ring_neg r x = y)"
   (MESON_TAC [RING_ADD_LCANCEL, RING_NEG, RING_0, RING_ADD_RNEG])

  let RING_LNEG_UNIQUE ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ ring_add r x y = ring_0 r
        ==> ring_neg r x = y"
   (MESON_TAC [RING_ADD_EQ_0])

  let RING_RNEG_UNIQUE ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ ring_add r x y = ring_0 r
        ==> ring_neg r y = x"
   (MESON_TAC [RING_ADD_EQ_0, RING_ADD_SYM])

  let RING_NEG_NEG ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_neg r (ring_neg r x) = x"
   (ASM_MESON_TAC [RING_LNEG_UNIQUE, RING_NEG, RING_ADD_LNEG])

  let RING_NEG_EQ_SWAP ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_neg r x = y <=> ring_neg r y = x)"
   (MESON_TAC [RING_NEG_NEG])

  let RING_NEG_EQ ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_neg r x = ring_neg r y <=> x = y)"
   (MESON_TAC [RING_NEG_NEG])

  let RING_NEG_0 ← prove
   r"!r:A ring. ring_neg r (ring_0 r) = ring_0 r"
   (MESON_TAC [RING_LNEG_UNIQUE, RING_0, RING_ADD_RZERO])

  let RING_NEG_EQ_0 ← prove
   r"!r x:A.
        x IN ring_carrier r
        ==> (ring_neg r x = ring_0 r <=> x = ring_0 r)"
   (MESON_TAC [RING_NEG_NEG, RING_NEG_0])

  let RING_MUL_LZERO ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_mul r (ring_0 r) x = ring_0 r"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← MESON [RING_LZERO_UNIQUE]
     (← q r"(x:A) IN ring_carrier r /\ ring_add r x x = x ==> x = ring_0 r")) THEN
    ASM_SIMP_TAC [← GSYM RING_ADD_RDISTRIB, RING_0, RING_MUL, RING_ADD_LZERO])

  let RING_MUL_RZERO ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_mul r x (ring_0 r) = ring_0 r"
   (MESON_TAC [RING_MUL_LZERO, RING_MUL_SYM, RING_0])

  let RING_MUL_LNEG ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_mul r (ring_neg r x) y = ring_neg r (ring_mul r x y)"
   (REPEAT STRIP_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_LNEG_UNIQUE THEN
    ASM_SIMP_TAC [← GSYM RING_ADD_RDISTRIB, RING_NEG, RING_MUL, RING_ADD_RNEG,
                  RING_MUL_LZERO])

  let RING_MUL_RNEG ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_mul r x (ring_neg r y) = ring_neg r (ring_mul r x y)"
   (MESON_TAC [RING_MUL_LNEG, RING_MUL_SYM, RING_NEG])

  let RING_NEG_ADD ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_neg r (ring_add r x y) =
            ring_add r (ring_neg r x) (ring_neg r y)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_LNEG_UNIQUE THEN
    ASM_SIMP_TAC [RING_ADD, RING_NEG] THEN
    TRANS_TAC EQ_TRANS
     (← q r"ring_add r (ring_add r y
      (ring_add r x (ring_neg r x))) (ring_neg r y):A") THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [RING_ADD_ASSOC, RING_ADD_SYM, RING_NEG, RING_ADD],
      ASM_SIMP_TAC [RING_ADD_RNEG, RING_ADD_RZERO]])

  let RING_SUB_REFL ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_sub r x x = ring_0 r"
   (SIMP_TAC [ring_sub, RING_ADD_RNEG])

  let RING_SUB_LZERO ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_sub r (ring_0 r) x = ring_neg r x"
   (MESON_TAC [ring_sub, RING_0, RING_NEG, RING_ADD_LZERO])

  let RING_SUB_RZERO ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_sub r x (ring_0 r) = x"
   (MESON_TAC [ring_sub, RING_NEG_0, RING_ADD_RZERO])

  let RING_SUB_EQ_0 ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> (ring_sub r x y = ring_0 r <=> x = y)"
   (SIMP_TAC [ring_sub, RING_ADD_EQ_0, RING_NEG, RING_NEG_EQ])

  let RING_SUB_LDISTRIB ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==> ring_mul r x (ring_sub r y z) =
            ring_sub r (ring_mul r x y) (ring_mul r x z)"
   (SIMP_TAC [ring_sub, RING_MUL_RNEG, RING_ADD_LDISTRIB, RING_NEG])

  let RING_SUB_RDISTRIB ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==> ring_mul r (ring_sub r x y) z =
            ring_sub r (ring_mul r x z) (ring_mul r y z)"
   (MESON_TAC [RING_SUB_LDISTRIB, RING_MUL_SYM, RING_MUL, RING_SUB])

  let RING_EQ_SUB_LADD ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==> (x = ring_sub r y z <=> ring_add r x z = y)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_THEN SUBST1_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
    ASM_SIMP_TAC [ring_sub, ← GSYM RING_ADD_ASSOC, RING_NEG, RING_NEG_ADD,
                  RING_ADD, RING_ADD_LNEG, RING_ADD_RNEG, RING_ADD_RZERO])

  let RING_EQ_SUB_RADD ← prove
   r"!r x y z:A.
        x IN ring_carrier r /\ y IN ring_carrier r /\ z IN ring_carrier r
        ==> (ring_sub r x y = z <=> x = ring_add r z y)"
   (MESON_TAC [RING_EQ_SUB_LADD])

  let RING_SUB_TELESCOPE ← prove
   r"!r (a:A) b c.
     a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r
     ==> ring_add r (ring_sub r a b) (ring_sub r b c) =
         ring_sub r a c"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_sub] THEN
    ASM_SIMP_TAC [← GSYM RING_ADD_ASSOC, RING_NEG, RING_ADD] THEN
    AP_TERM_TAC THEN
    ASM_SIMP_TAC [RING_ADD_ASSOC, RING_NEG, RING_ADD] THEN
    ASM_SIMP_TAC [RING_ADD_LNEG, RING_ADD_LZERO, RING_NEG])

  let RING_NEG_SUB ← prove
   r"!r x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_neg r (ring_sub r x y) = ring_sub r y x"
   (SIMP_TAC [ring_sub, RING_NEG_ADD, RING_NEG, RING_NEG_NEG] THEN
    MESON_TAC [RING_ADD_SYM, RING_NEG])

  let RING_CARRIER_NONEMPTY ← prove
   r"!r:A ring. ~(ring_carrier r = {})"
   (MESON_TAC [MEMBER_NOT_EMPTY, RING_0])

  -- Charaterizing trivial (zero) rings.

  let trivial_ring ← new_definition
   r"trivial_ring r <=> ring_carrier r = {ring_0 r}"

  let TRIVIAL_IMP_FINITE_RING ← prove
   r"!r:A ring. trivial_ring r ==> FINITE(ring_carrier r)"
   (SIMP_TAC [trivial_ring, FINITE_SING])

  let TRIVIAL_RING_SUBSET ← prove
   r"!r:A ring. trivial_ring r <=> ring_carrier r SUBSET {ring_0 r}"
   (SIMP_TAC [trivial_ring, ← GSYM SUBSET_ANTISYM_EQ, SING_SUBSET, RING_0])

  let TRIVIAL_RING ← prove
   r"!r:A ring. trivial_ring r <=> ?a. ring_carrier r = {a}"
   (GEN_TAC THEN REWRITE_TAC [trivial_ring] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"c IN s ==> (s = {c} <=> ?a. s = {a})")) THEN
    REWRITE_TAC [RING_0])

  let TRIVIAL_RING_ALT ← prove
   r"!r:A ring. trivial_ring r <=> ?a. ring_carrier r SUBSET {a}"
   (REWRITE_TAC [TRIVIAL_RING, RING_CARRIER_NONEMPTY, ← SET_RULE
     (← q r"(?a. s = {a}) <=> (?a. s SUBSET {a}) /\ ~(s = {})")])

  let TRIVIAL_RING_10 ← prove
   r"!r:A ring. trivial_ring r <=> ring_1 r = ring_0 r"
   (REWRITE_TAC [trivial_ring, EXTENSION, IN_SING] THEN
    MESON_TAC [RING_1, RING_0, RING_MUL_LID, RING_MUL_LZERO])

  let RING_CARRIER_HAS_SIZE_1 ← prove
   r"!r:A ring. ring_carrier r HAS_SIZE 1 <=> trivial_ring r"
   (GEN_TAC THEN CONV_TAC (LAND_CONV HAS_SIZE_CONV) THEN
    REWRITE_TAC [TRIVIAL_RING])

  let TRIVIAL_RING_HAS_SIZE_1 ← prove
   r"!r:A ring. trivial_ring r <=> ring_carrier(r) HAS_SIZE 1"
   (REWRITE_TAC [RING_CARRIER_HAS_SIZE_1])

  let RING_CARRIER_HAS_SIZE_2 ← prove
   r"!r:A ring.
        ring_carrier r HAS_SIZE 2 <=>
        ~(trivial_ring r) /\
        ring_carrier r = {ring_0 r,ring_1 r}"
   (GEN_TAC THEN CONV_TAC (LAND_CONV HAS_SIZE_CONV) THEN EQ_TAC THENL
     [REWRITE_TAC [LEFT_IMP_EXISTS_THM], ASM_MESON_TAC [TRIVIAL_RING_10]] THEN
    MAP_EVERY X_GEN_TAC [← q "a:A", ← q "b:A"] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REWRITE_TAC [TRIVIAL_RING] THEN ASM SET_TAC [],
      REWRITE_TAC [TRIVIAL_RING_10] THEN MP_TAC (← ISPEC (← q "r:A ring") RING_1) THEN
      MP_TAC (← ISPEC (← q "r:A ring") RING_0) THEN ASM_REWRITE_TAC [] THEN SET_TAC []])

  -- The singleton ring, the trivial ring containing a given object.

  let singleton_ring ← new_definition
   r"singleton_ring (a:A) = ring({a},a,a,(\x. a),(\x y. a),(\x y. a))"

  let SINGLETON_RING ← prove
   r"(!a:A. ring_carrier(singleton_ring a) = {a}) /\
   (!a:A. ring_0(singleton_ring a) = a) /\
   (!a:A. ring_1(singleton_ring a) = a) /\
   (!a:A. ring_neg(singleton_ring a) = \x. a) /\
   (!a:A. ring_add(singleton_ring a) = \x y. a) /\
   (!a:A. ring_mul(singleton_ring a) = \x y. a)"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN
    MP_TAC (← EQ_IMP_RULE
     (← ISPEC (← liftExcept (do rand (← rand (strip_forall (concl singleton_ring)).2)))
       (← CONJUNCT2 ring_tybij))).1 THEN
    REWRITE_TAC [← GSYM singleton_ring] THEN SIMP_TAC [IN_SING] THEN
    SIMP_TAC [ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul])

  let TRIVIAL_RING_SINGLETON_RING ← prove
   r"!a:A. trivial_ring(singleton_ring a)"
   (REWRITE_TAC [trivial_ring, SINGLETON_RING])

  let FINITE_SINGLETON_RING ← prove
   r"!a:A. FINITE(ring_carrier(singleton_ring a))"
   (SIMP_TAC [TRIVIAL_IMP_FINITE_RING, TRIVIAL_RING_SINGLETON_RING])

  -- @@RETURN BEGIN
  return { ring_tybij, ring_carrier, ring_0, ring_1, ring_neg, ring_add, ring_mul,
           ring_sub, RINGS_EQ, RING_PROPERTIES, RING_0, RING_1, RING_NEG, RING_ADD,
           RING_SUB, RING_MUL, RING_ADD_SYM, RING_MUL_SYM, RING_ADD_ASSOC,
           RING_MUL_ASSOC, RING_ADD_LDISTRIB, RING_ADD_RDISTRIB, RING_ADD_LZERO,
           RING_ADD_RZERO, RING_MUL_LID, RING_MUL_RID, RING_ADD_LNEG, RING_ADD_RNEG,
           RING_ADD_AC, RING_MUL_AC, RING_ADD_LCANCEL, RING_ADD_RCANCEL,
           RING_ADD_LCANCEL_IMP, RING_ADD_RCANCEL_IMP, RING_ADD_EQ_RIGHT,
           RING_ADD_EQ_LEFT, RING_LZERO_UNIQUE, RING_RZERO_UNIQUE, RING_ADD_EQ_0,
           RING_LNEG_UNIQUE, RING_RNEG_UNIQUE, RING_NEG_NEG, RING_NEG_EQ_SWAP,
           RING_NEG_EQ, RING_NEG_0, RING_NEG_EQ_0, RING_MUL_LZERO, RING_MUL_RZERO,
           RING_MUL_LNEG, RING_MUL_RNEG, RING_NEG_ADD, RING_SUB_REFL, RING_SUB_LZERO,
           RING_SUB_RZERO, RING_SUB_EQ_0, RING_SUB_LDISTRIB, RING_SUB_RDISTRIB,
           RING_EQ_SUB_LADD, RING_EQ_SUB_RADD, RING_SUB_TELESCOPE, RING_NEG_SUB,
           RING_CARRIER_NONEMPTY, trivial_ring, TRIVIAL_IMP_FINITE_RING,
           TRIVIAL_RING_SUBSET, TRIVIAL_RING, TRIVIAL_RING_ALT, TRIVIAL_RING_10,
           RING_CARRIER_HAS_SIZE_1, TRIVIAL_RING_HAS_SIZE_1, RING_CARRIER_HAS_SIZE_2,
           singleton_ring, SINGLETON_RING, TRIVIAL_RING_SINGLETON_RING,
           FINITE_SINGLETON_RING }
  -- @@RETURN END

/-- `NO_TAC` (tactics.ml), absent from HolMath.Base. -/
def NO_TAC : tactic := HolCore.Tactics.NO_TAC

/-- `W(MP_TAC o PART_MATCH f th o g o snd)`: match `th`'s part `f` against
    the part `g` of the goal, and MP_TAC the instance. -/
def wPart [HolBase] (g : term → Except String term) (f : term → Except String term)
    (th : thm) : tactic := fun gl =>
  ExceptT.run do
    let t ← liftExcept (g gl.2)
    ExceptT.mk (MP_TAC (← PART_MATCH f th t) gl)

/-- `check (is_var o lhand o concl)`-style predicates on a theorem: OCaml's
    `check` fails when the predicate's own projection fails, which a caller
    such as FIRST_X_ASSUM treats as "no". -/
def thmLhandIsVar (th : thm) : Bool :=
  match lhand (concl th) with
  | .ok t => is_var t
  | .error _ => false

/- ------------------------------------------------------------------------- -/
/- Mapping natural numbers and integers into a ring; the characteristic;     -/
/- natural number powers of a ring element.  (ringtheory.ml 502-842)         -/
/- ------------------------------------------------------------------------- -/

structure Numbers where
  -- @@FIELDS
  ring_of_num : thm
  ring_of_int : thm
  RING_OF_NUM : thm
  RING_OF_INT : thm
  RING_OF_INT_OF_NUM : thm
  RING_OF_NUM_0 : thm
  RING_OF_NUM_1 : thm
  RING_OF_NUM_ADD : thm
  RING_OF_NUM_MUL : thm
  RING_OF_INT_0 : thm
  RING_OF_INT_1 : thm
  RING_OF_INT_CASES : thm
  RING_OF_INT_NEG : thm
  RING_OF_INT_ADD : thm
  RING_OF_INT_MUL : thm
  RING_OF_INT_SUB : thm
  RING_OF_NUM_EQ_0 : thm
  RING_CHAR_EQ_0 : thm
  RING_CHAR_EQ_1 : thm
  RING_OF_INT_EQ_0 : thm
  RING_OF_INT_EQ : thm
  RING_OF_NUM_EQ : thm
  RING_OF_INT_REM : thm
  RING_OF_NUM_MOD : thm
  RING_OF_NUM_CHAR : thm
  RING_CHAR_INFINITE : thm
  RING_CHAR_FINITE : thm
  RING_CHAR_UNIQUE : thm
  ring_pow : thm
  RING_POW : thm
  RING_POW_ZERO : thm
  RING_POW_0 : thm
  RING_POW_1 : thm
  RING_POW_2 : thm
  RING_POW_ONE : thm
  RING_POW_ADD : thm
  RING_POW_MUL : thm
  RING_POW_POW : thm
  RING_MUL_POW : thm
  RING_OF_NUM_EXP : thm
  RING_OF_INT_POW : thm
  RING_POW_NEG : thm
  RING_POW_IDEMPOTENT : thm
  RING_OF_NUM_CLAUSES : thm
  RING_OF_INT_CLAUSES : thm
  deriving Inhabited

@[nospecialize]
def setupNumbers [HolBase] (D : RingTheoryDeps) (BBasics : Basics) :
    ExceptT String IO Numbers := do
  -- @@SCOPE BEGIN
  let { INDUCT_TAC, INTEGER_RULE, INT_ARITH, INT_REM_DOWN_CONV, MESON, MESON_TAC,
        MOD_DOWN_CONV, NUMBER_RULE, NUMBER_TAC, new_definition,
        new_recursive_definition, new_specification, num_CONV, .. } := D
  let { ADD_CLAUSES, .. } := D.core1
  let { COND_SWAP, CONG, DIVIDES_ANTISYM, DIVIDES_REFL, EVEN, EXP, .. } := D.core2
  let { FORALL_INT_CASES, FORALL_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ_ALT, INFINITE, INFINITE_IMAGE_INJ, INFINITE_SUPERSET, INT_MUL_LNEG,
        INT_MUL_RNEG, INT_NEG_0, INT_NEG_ADD, INT_NEG_EQ, INT_NEG_NEG, INT_OF_NUM_ADD,
        INT_OF_NUM_EQ, INT_OF_NUM_MUL, INT_POS, INT_POW, .. } := D.core4
  let { INT_REM_EQ, INT_SUB, .. } := D.core5
  let { MULT_CLAUSES, NOT_SUC, NUM_OF_INT_OF_NUM, ORDER_EXISTENCE_GEN, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SKOLEM_THM, SUBSET, .. } := D.core7
  let { num_INDUCTION, num_INFINITE, num_RECURSION, num_congruent, num_divides, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_AC, RING_ADD_ASSOC, RING_ADD_LZERO,
        RING_ADD_RDISTRIB, RING_ADD_RNEG, RING_ADD_RZERO, RING_ADD_SYM,
        RING_EQ_SUB_LADD, RING_MUL, RING_MUL_AC, RING_MUL_ASSOC, RING_MUL_LID,
        RING_MUL_LNEG, RING_MUL_LZERO, RING_MUL_RID, RING_MUL_RNEG, RING_NEG,
        RING_NEG_0, RING_NEG_ADD, RING_NEG_EQ_0, RING_NEG_NEG, RING_SUB_EQ_0,
        TRIVIAL_RING_10, ring_sub, .. } := BBasics
  -- @@SCOPE END

  let ring_of_num ← new_recursive_definition num_RECURSION
   r"ring_of_num (r:A ring) 0 = ring_0 r /\
  ring_of_num (r:A ring) (SUC n) = ring_add r (ring_of_num r n) (ring_1 r)"

  let ring_of_int ← new_definition
   r"ring_of_int (r:A ring) n =
        if &0 <= n then ring_of_num r (num_of_int n)
        else ring_neg r (ring_of_num r (num_of_int(--n)))"

  let RING_OF_NUM ← prove
   r"!(r:A ring) n. ring_of_num r n IN ring_carrier r"
   (GEN_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [ring_of_num, RING_0, RING_1, RING_ADD])

  let RING_OF_INT ← prove
   r"!(r:A ring) n. ring_of_int r n IN ring_carrier r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_of_int] THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [RING_NEG, RING_OF_NUM])

  let RING_OF_INT_OF_NUM ← prove
   r"!(r:A ring) n. ring_of_int r (&n) = ring_of_num r n"
   (REWRITE_TAC [ring_of_int, INT_POS, NUM_OF_INT_OF_NUM])

  let RING_OF_NUM_0 ← prove
   r"!r:A ring. ring_of_num r 0 = ring_0 r"
   (REWRITE_TAC [ring_of_num])

  let RING_OF_NUM_1 ← prove
   r"!r:A ring. ring_of_num r 1 = ring_1 r"
   (SIMP_TAC [← ExceptT.mk (num_CONV (← q "1")), ring_of_num, RING_ADD_LZERO, RING_1])

  let RING_OF_NUM_ADD ← prove
   r"!(r:A ring) m n.
      ring_of_num r (m + n) = ring_add r (ring_of_num r m) (ring_of_num r n)"
   (GEN_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [ADD_CLAUSES, ring_of_num, RING_ADD_LZERO, RING_OF_NUM] THEN
    ASM_SIMP_TAC [RING_ADD_AC, RING_OF_NUM, RING_ADD, RING_0, RING_1])

  let RING_OF_NUM_MUL ← prove
   r"!(r:A ring) m n.
      ring_of_num r (m * n) = ring_mul r (ring_of_num r m) (ring_of_num r n)"
   (GEN_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [MULT_CLAUSES, RING_OF_NUM_0, RING_MUL_LZERO, RING_OF_NUM] THEN
    ASM_REWRITE_TAC [RING_OF_NUM_ADD, ring_of_num] THEN
    SIMP_TAC [RING_ADD_RDISTRIB, RING_1, RING_OF_NUM, RING_MUL_LID])

  let RING_OF_INT_0 ← prove
   r"!r:A ring. ring_of_int r (&0) = ring_0 r"
   (REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_0])

  let RING_OF_INT_1 ← prove
   r"!r:A ring. ring_of_int r (&1) = ring_1 r"
   (REWRITE_TAC [RING_OF_INT_OF_NUM, RING_OF_NUM_1])

  let RING_OF_INT_CASES ← prove
   r"(!(r:A ring) n. ring_of_int r (&n) = ring_of_num r n) /\
   (!(r:A ring) n. ring_of_int r (-- &n) = ring_neg r (ring_of_num r n))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [RING_OF_INT_OF_NUM] THEN
    REWRITE_TAC [ring_of_int, ← INT_ARITH (← q r"&0:int <= -- &n <=> &n:int = &0")] THEN
    SIMP_TAC [INT_NEG_NEG, INT_OF_NUM_EQ, INT_NEG_0, NUM_OF_INT_OF_NUM] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [ring_of_num, RING_NEG_0])

  let RING_OF_INT_NEG ← prove
   r"!(r:A ring) n. ring_of_int r (--n) = ring_neg r (ring_of_int r n)"
   (SIMP_TAC [FORALL_INT_CASES, RING_OF_INT_CASES, INT_NEG_NEG,
              RING_NEG_NEG, RING_OF_NUM])

  let RING_OF_INT_ADD ← prove
   r"!(r:A ring) m n.
      ring_of_int r (m + n) = ring_add r (ring_of_int r m) (ring_of_int r n)"
   (← do
    -- right to left: the two MESONs, then the two INT_ARITHs
    let m2 ← MESON [RING_ADD_SYM]
     (← q r"x IN ring_carrier r /\ y IN ring_carrier r /\ ring_add r x y = z
    ==> ring_add r y x = z")
    let m1 ← MESON [RING_ADD_SYM, RING_NEG]
     (← q r"!x y. x IN ring_carrier r /\ y IN ring_carrier r
         ==> ring_add r (ring_neg r x) y = ring_add r y (ring_neg r x)")
    let i2 ← INT_ARITH
     (← q r"(&a + &b:int = -- &c <=> &a:int = &0 /\ &b:int = &0 /\ &c:int = &0) /\
    (!m n p. m + --n:int = &p <=> m = n + &p) /\
    (!m n p. m + --n:int = -- &p <=> m + &p = n)")
    let i1 ← INT_ARITH (← q r"--b + a:int = a + --b")
    pure (SUBGOAL_THEN
     (← q r"!(r:A ring) m n p.
        m + n = p ==>
      ring_of_int r p = ring_add r (ring_of_int r m) (ring_of_int r n)")
     (fun th => MESON_TAC [th]) THEN
    GEN_TAC THEN REWRITE_TAC [FORALL_INT_CASES, RING_OF_INT_CASES] THEN
    ONCE_REWRITE_TAC [i1] THEN
    REWRITE_TAC [← GSYM INT_NEG_ADD, INT_NEG_EQ, INT_NEG_NEG] THEN
    REWRITE_TAC [i2] THEN
    REWRITE_TAC [INT_OF_NUM_ADD, INT_OF_NUM_EQ] THEN
    REPEAT STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (SUBST1_TAC o check thmLhandIsVar)) THEN
    REPEAT (FIRST_X_ASSUM (SUBST1_TAC o SYM)) THEN
    REWRITE_TAC [RING_OF_NUM_ADD, RING_OF_NUM_0] THEN
    SIMP_TAC [RING_NEG_0, RING_ADD_LZERO, RING_ADD_RZERO, RING_0] THEN
    SIMP_TAC [← GSYM RING_NEG_ADD, RING_OF_NUM] THEN SIMP_TAC
     [RING_ADD, RING_OF_NUM, m1] THEN
    REWRITE_TAC [← GSYM ring_sub] THEN
    SIMP_TAC [RING_EQ_SUB_LADD, RING_OF_NUM, RING_ADD, RING_NEG] THEN
    TRY (SIMP_TAC [RING_ADD_AC, RING_OF_NUM] THEN NO_TAC) THEN
    MATCH_MP_TAC m2 THEN
    SIMP_TAC [RING_NEG, RING_OF_NUM, RING_ADD] THEN
    SIMP_TAC [← GSYM RING_ADD_ASSOC, RING_ADD, RING_NEG, RING_OF_NUM,
              RING_ADD_RNEG, RING_ADD_RZERO]))

  let RING_OF_INT_MUL ← prove
   r"!(r:A ring) m n.
      ring_of_int r (m * n) = ring_mul r (ring_of_int r m) (ring_of_int r n)"
   (REWRITE_TAC [FORALL_INT_CASES, INT_MUL_LNEG, INT_MUL_RNEG, INT_NEG_NEG] THEN
    REWRITE_TAC [RING_OF_INT_CASES, INT_OF_NUM_MUL, RING_OF_NUM_MUL] THEN
    SIMP_TAC [RING_MUL_LNEG, RING_MUL_RNEG, RING_OF_NUM, RING_NEG,
              RING_NEG_NEG, RING_MUL])

  let RING_OF_INT_SUB ← prove
   r"!(r:A ring) m n.
      ring_of_int r (m - n) = ring_sub r (ring_of_int r m) (ring_of_int r n)"
   (SIMP_TAC [INT_SUB, ring_sub, RING_OF_INT_ADD, RING_OF_INT_NEG,
              RING_NEG, RING_OF_INT])

  -- Characteristic of a ring, characterized by RING_OF_NUM_EQ_0.

  let RING_OF_NUM_EQ_0 ← do
    let eth ← prove
     r"!r:A ring. ?p. !n. ring_of_num r n = ring_0 r <=> p divides n"
     (GEN_TAC THEN MP_TAC (← ISPECL [← q r"\x:A. x = ring_0 r", ← q r"\n. ring_of_num r n:A"]
          ORDER_EXISTENCE_GEN) THEN
      REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
      SIMP_TAC [ring_of_num, RING_OF_NUM_ADD, RING_ADD_LZERO, RING_OF_NUM])
    new_specification ["ring_char"] (← REWRITE_RULE [SKOLEM_THM] eth)

  let RING_CHAR_EQ_0 ← prove
   r"!r:A ring. ring_char r = 0 <=> !n. ring_of_num r n = ring_0 r <=> n = 0"
   (REWRITE_TAC [RING_OF_NUM_EQ_0] THEN MESON_TAC [← NUMBER_RULE
     (← q r"(!n:num. n divides n) /\ (!n. 0 divides n <=> n = 0)")])

  let RING_CHAR_EQ_1 ← prove
   r"!r:A ring. ring_char r = 1 <=> trivial_ring r"
   (REWRITE_TAC [TRIVIAL_RING_10, ← GSYM RING_OF_NUM_1, RING_OF_NUM_EQ_0] THEN
    NUMBER_TAC)

  let RING_OF_INT_EQ_0 ← prove
   r"!(r:A ring) n.
        ring_of_int r n = ring_0 r <=> &(ring_char r) divides n"
   (REWRITE_TAC [FORALL_INT_CASES, RING_OF_INT_CASES] THEN
    SIMP_TAC [RING_NEG_EQ_0, RING_OF_NUM, RING_OF_NUM_EQ_0] THEN
    REWRITE_TAC [num_divides] THEN REPEAT STRIP_TAC THEN
    CONV_TAC (fun t => (INTEGER_RULE t).run))

  let RING_OF_INT_EQ ← prove
   r"!(r:A ring) m n.
        ring_of_int r m = ring_of_int r n <=> (m == n) (mod &(ring_char r))"
   (REPEAT STRIP_TAC THEN
    wPart lhand (fun t => do rand (← rand t)) RING_SUB_EQ_0 THEN
    REWRITE_TAC [RING_OF_INT, ← GSYM RING_OF_INT_SUB] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [RING_OF_INT_EQ_0] THEN
    CONV_TAC (fun t => (INTEGER_RULE t).run))

  let RING_OF_NUM_EQ ← prove
   r"!(r:A ring) m n.
        ring_of_num r m = ring_of_num r n <=> (m == n) (mod (ring_char r))"
   (REWRITE_TAC [← GSYM RING_OF_INT_OF_NUM, RING_OF_INT_EQ, num_congruent])

  let RING_OF_INT_REM ← prove
   r"!(f:A ring) n. ring_of_int f (n rem &(ring_char f)) = ring_of_int f n"
   (REWRITE_TAC [RING_OF_INT_EQ, ← GSYM INT_REM_EQ] THEN
    CONV_TAC (ONCE_DEPTH_CONV INT_REM_DOWN_CONV) THEN REWRITE_TAC [])

  let RING_OF_NUM_MOD ← prove
   r"!(f:A ring) n. ring_of_num f (n MOD ring_char f) = ring_of_num f n"
   (REWRITE_TAC [RING_OF_NUM_EQ, CONG] THEN
    CONV_TAC (ONCE_DEPTH_CONV MOD_DOWN_CONV) THEN REWRITE_TAC [])

  let RING_OF_NUM_CHAR ← prove
   r"!r:A ring. ring_of_num r (ring_char r) = ring_0 r"
   (REWRITE_TAC [RING_OF_NUM_EQ_0, DIVIDES_REFL])

  let RING_CHAR_INFINITE ← prove
   r"!r:A ring. ring_char r = 0 ==> INFINITE(ring_carrier r)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q "ring_of_num r:num->A") INFINITE_IMAGE_INJ) THEN
    ASM_REWRITE_TAC [RING_OF_NUM_EQ] THEN ANTS_TAC THENL
     [CONV_TAC (fun t => (NUMBER_RULE t).run), DISCH_THEN (MP_TAC o SPEC (← q "(:num)"))] THEN
    REWRITE_TAC [num_INFINITE] THEN MATCH_MP_TAC
     (← REWRITE_RULE [IMP_CONJ_ALT] INFINITE_SUPERSET) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RING_OF_NUM])

  let RING_CHAR_FINITE ← prove
   r"!r:A ring. FINITE(ring_carrier r) ==> ~(ring_char r = 0)"
   (MESON_TAC [RING_CHAR_INFINITE, INFINITE])

  let RING_CHAR_UNIQUE ← prove
   r"!(r:A ring) p.
        ring_char r = p <=> !n. ring_of_num r n = ring_0 r <=> p divides n"
   (← do
    -- the list `[N1; N2]`, right to left
    let n2 ← NUMBER_RULE (← q r"!m n p:num. m divides n /\ n divides p ==> m divides p")
    let n1 ← NUMBER_RULE (← q r"!n:num. n divides n")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [RING_OF_NUM_EQ_0] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM DIVIDES_ANTISYM] THEN
      MESON_TAC [n1, n2]))

  -- Natural number powers of a ring element.

  let ring_pow ← new_recursive_definition num_RECURSION
   r"ring_pow r x 0 = ring_1 r /\
  ring_pow r x (SUC n) = ring_mul r x (ring_pow r x n)"

  let RING_POW ← prove
   r"!r (x:A) n. x IN ring_carrier r ==> ring_pow r x n IN ring_carrier r"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [ring_pow, RING_1, RING_MUL])

  let RING_POW_ZERO ← prove
   r"!r k. ring_pow r (ring_0 r) k = if k = 0 then ring_1 r else ring_0 r"
   (GEN_TAC THEN INDUCT_TAC THEN ASM_REWRITE_TAC [ring_pow, NOT_SUC] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [RING_MUL_LZERO, RING_0, RING_1])

  let RING_POW_0 ← prove
   r"!r (x:A). ring_pow r x 0 = ring_1 r"
   (REWRITE_TAC [ring_pow])

  let RING_POW_1 ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_pow r x 1 = x"
   (SIMP_TAC [← ExceptT.mk (num_CONV (← q "1")), ring_pow, RING_MUL_RID])

  let RING_POW_2 ← prove
   r"!r x:A. x IN ring_carrier r ==> ring_pow r x 2 = ring_mul r x x"
   (← do
    -- `[num_CONV `2`; num_CONV `1`; ...]`, right to left
    let c1 ← ExceptT.mk (num_CONV (← q "1"))
    let c2 ← ExceptT.mk (num_CONV (← q "2"))
    pure (SIMP_TAC [c2, c1, ring_pow, RING_MUL_RID]))

  let RING_POW_ONE ← prove
   r"!n. ring_pow r (ring_1 r) n = ring_1 r"
   (INDUCT_TAC THEN ASM_SIMP_TAC [ring_pow, RING_1, RING_MUL_LID])

  let RING_POW_ADD ← prove
   r"!r (x:A) m n.
        x IN ring_carrier r
        ==> ring_pow r x (m + n) =
            ring_mul r (ring_pow r x m) (ring_pow r x n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN
    ASM_SIMP_TAC [ring_pow, ADD_CLAUSES, RING_POW, RING_MUL_LID] THEN
    ASM_SIMP_TAC [RING_MUL_ASSOC, RING_POW])

  let RING_POW_MUL ← prove
   r"!r (x:A) m n.
        x IN ring_carrier r
        ==> ring_pow r x (m * n) = ring_pow r (ring_pow r x m) n"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    INDUCT_TAC THEN REWRITE_TAC [RING_POW_0, MULT_CLAUSES] THEN
    ASM_SIMP_TAC [RING_POW_ADD, ← CONJUNCT2 ring_pow])

  let RING_POW_POW ← prove
   r"!r (x:A) m n.
        x IN ring_carrier r
        ==> ring_pow r (ring_pow r x m) n = ring_pow r x (m * n)"
   (SIMP_TAC [RING_POW_MUL])

  let RING_MUL_POW ← prove
   r"!r (x:A) (y:A) n.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_pow r (ring_mul r x y) n =
            ring_mul r (ring_pow r x n) (ring_pow r y n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [ring_pow, RING_MUL_LID, RING_1] THEN
    ASM_SIMP_TAC [RING_MUL_ASSOC, RING_MUL, RING_POW] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [← GSYM (← CONJUNCT2 ring_pow)] THEN
    ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, RING_MUL, RING_POW] THEN
    ASM_SIMP_TAC [ring_pow, RING_MUL_AC, RING_POW, RING_MUL])

  let RING_OF_NUM_EXP ← prove
   r"!(r:A ring) m n.
        ring_of_num r (m EXP n) = ring_pow r (ring_of_num r m) n"
   (GEN_TAC THEN GEN_TAC THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [ring_pow, EXP, RING_OF_NUM_1] THEN
    ASM_REWRITE_TAC [RING_OF_NUM_MUL])

  let RING_OF_INT_POW ← prove
   r"!(r:A ring) x n.
        ring_of_int r (x pow n) = ring_pow r (ring_of_int r x) n"
   (GEN_TAC THEN GEN_TAC THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [ring_pow, INT_POW, RING_OF_INT_1] THEN
    ASM_REWRITE_TAC [RING_OF_INT_MUL])

  let RING_POW_NEG ← prove
   r"!r (x:A) n.
        x IN ring_carrier r
        ==> ring_pow r (ring_neg r x) n =
            if EVEN n then ring_pow r x n else ring_neg r (ring_pow r x n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC num_INDUCTION THEN SIMP_TAC [EVEN, ring_pow, COND_SWAP] THEN
    X_GEN_TAC (← q "n:num") THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [RING_MUL_LNEG, RING_MUL_RNEG, RING_POW, RING_NEG, RING_MUL,
                  RING_NEG_NEG])

  let RING_POW_IDEMPOTENT ← prove
   r"!r (x:A) n.
        x IN ring_carrier r /\ ring_mul r x x = x
        ==> ring_pow r x n = if n = 0 then ring_1 r else x"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [ring_pow, NOT_SUC] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [RING_MUL_RID])

  let RING_OF_NUM_CLAUSES ← prove
   r"(!(r:A ring).
     ring_0 r = ring_of_num r 0) /\
   (!(r:A ring).
     ring_1 r = ring_of_num r 1) /\
   (!(r:A ring) m n.
     ring_add r (ring_of_num r m) (ring_of_num r n) = ring_of_num r (m + n)) /\
   (!(r:A ring) m n.
     ring_mul r (ring_of_num r m) (ring_of_num r n) = ring_of_num r (m * n)) /\
   (!(r:A ring) m n.
     ring_pow r (ring_of_num r m) n = ring_of_num r (m EXP n))"
   (REWRITE_TAC [RING_OF_NUM_0, RING_OF_NUM_1, RING_OF_NUM_ADD,
                 RING_OF_NUM_MUL, RING_OF_NUM_EXP])

  let RING_OF_INT_CLAUSES ← prove
   r"(!(r:A ring).
     ring_0 r = ring_of_int r (&0)) /\
   (!(r:A ring).
     ring_1 r = ring_of_int r (&1)) /\
   (!(r:A ring) n.
     ring_neg r (ring_of_int r n) = ring_of_int r (--n)) /\
   (!(r:A ring) m n.
     ring_add r (ring_of_int r m) (ring_of_int r n) = ring_of_int r (m + n)) /\
   (!(r:A ring) m n.
     ring_sub r (ring_of_int r m) (ring_of_int r n) = ring_of_int r (m - n)) /\
   (!(r:A ring) m n.
     ring_mul r (ring_of_int r m) (ring_of_int r n) = ring_of_int r (m * n)) /\
   (!(r:A ring) m n.
     ring_pow r (ring_of_int r m) n = ring_of_int r (m pow n))"
   (REWRITE_TAC [RING_OF_INT_0, RING_OF_INT_1, RING_OF_INT_NEG, RING_OF_INT_ADD,
                 RING_OF_INT_SUB, RING_OF_INT_MUL, RING_OF_INT_POW])

  -- @@RETURN BEGIN
  return { ring_of_num, ring_of_int, RING_OF_NUM, RING_OF_INT, RING_OF_INT_OF_NUM,
           RING_OF_NUM_0, RING_OF_NUM_1, RING_OF_NUM_ADD, RING_OF_NUM_MUL, RING_OF_INT_0,
           RING_OF_INT_1, RING_OF_INT_CASES, RING_OF_INT_NEG, RING_OF_INT_ADD,
           RING_OF_INT_MUL, RING_OF_INT_SUB, RING_OF_NUM_EQ_0, RING_CHAR_EQ_0,
           RING_CHAR_EQ_1, RING_OF_INT_EQ_0, RING_OF_INT_EQ, RING_OF_NUM_EQ,
           RING_OF_INT_REM, RING_OF_NUM_MOD, RING_OF_NUM_CHAR, RING_CHAR_INFINITE,
           RING_CHAR_FINITE, RING_CHAR_UNIQUE, ring_pow, RING_POW, RING_POW_ZERO,
           RING_POW_0, RING_POW_1, RING_POW_2, RING_POW_ONE, RING_POW_ADD, RING_POW_MUL,
           RING_POW_POW, RING_MUL_POW, RING_OF_NUM_EXP, RING_OF_INT_POW, RING_POW_NEG,
           RING_POW_IDEMPOTENT, RING_OF_NUM_CLAUSES, RING_OF_INT_CLAUSES }
  -- @@RETURN END

/-- `CONV_TAC o GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV ss lev`, as a function of
    the theorem list (used with `ASM`); `ss` is evaluated by the caller, as
    OCaml evaluates `basic_ss []` when it builds the tactic. -/
def simpTac [HolBase] (ss : HolCore.Simp.simpset) (lev : Int) (ths : List thm) : tactic :=
  fun g => do
    match ← HolCore.Simp.GEN_SIMPLIFY_CONV HolBase.B (HolCore.Simp.TOP_DEPTH_SQCONV HolBase.B)
        ss lev ths with
    | .ok c => CONV_TAC c g
    | .error e => pure (.error e)

/- ------------------------------------------------------------------------- -/
/- Sum in a ring.  (ringtheory.ml 843-1491)                                  -/
/- ------------------------------------------------------------------------- -/

structure Sums where
  -- @@FIELDS
  ring_sum : thm
  NEUTRAL_RING_ADD : thm
  MONOIDAL_RING_ADD : thm
  RING_SUM : thm
  RING_SUM_RESTRICT : thm
  RING_SUM_SUPPORT : thm
  RING_SUM_TRIVIAL : thm
  RING_SUM_CLAUSES : thm
  RING_SUM_SING : thm
  RING_SUM_CLAUSES_NUMSEG_ALT : thm
  RING_SUM_CLAUSES_NUMSEG : thm
  RING_SUM_CLAUSES_LEFT : thm
  RING_SUM_CLAUSES_RIGHT : thm
  RING_SUM_UNION : thm
  RING_SUM_DIFF : thm
  RING_SUM_INCL_EXCL : thm
  RING_SUM_CLOSED : thm
  RING_SUM_RELATED : thm
  RING_SUM_EQ_0 : thm
  RING_SUM_0 : thm
  RING_SUM_DELETE : thm
  RING_SUM_NEG : thm
  RING_SUM_ADD : thm
  RING_SUM_SUB : thm
  RING_SUM_EQ : thm
  RING_SUM_DELTA : thm
  RING_SUM_LMUL : thm
  RING_SUM_RMUL : thm
  RING_SUM_SWAP : thm
  RING_SUM_REFLECT : thm
  RING_SUM_SUM_PRODUCT : thm
  RING_SUM_SUPERSET : thm
  RING_SUM_RESTRICT_SET : thm
  RING_SUM_CASES : thm
  RING_SUM_IMAGE : thm
  RING_SUM_EQ_GENERAL_INVERSES : thm
  RING_SUM_OFFSET : thm
  RING_SUM_CONST : thm
  RING_SUM_IMAGE_GEN : thm
  RING_BINOMIAL_THEOREM : thm
  RING_BINOMIAL_FRESHMAN : thm
  RING_SUM_DIFFS : thm
  RING_SUM_DIFFS_ALT : thm
  RING_GEOM_SERIES_GEN : thm
  RING_GEOM_SERIES : thm
  deriving Inhabited

@[nospecialize]
def setupSums [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) :
    ExceptT String IO Sums := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON,
        MESON_TAC, SET_RULE, SET_TAC, SIMP_RULE, basic_ss, extend_basic_congs,
        new_definition, .. } := D
  let { ADD1, ADD_CLAUSES, ADD_SYM, ARITH, BINOM_LT, BINOM_REFL, CARD_CLAUSES, COND_ID, .. } := D.core1
  let { COND_RAND, COND_RATOR, COND_SWAP, DIFF_RESTRICT, DIVIDES_PRIME_BINOM,
        EMPTY_GSPEC, EMPTY_NUMSEG, EQ_ADD_RCANCEL, EQ_IMP, EQ_TRANS, ETA_AX, .. } := D.core2
  let { FINITE_EMPTY, FINITE_INDUCT_STRONG, FINITE_INSERT, FINITE_NUMSEG,
        FINITE_RESTRICT, FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_PAIR_THM,
        FUN_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INFINITE, INSERT_RESTRICT, INTER_RESTRICT, .. } := D.core4
  let { IN_DELETE, IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_GSPEC, IN_NUMSEG, ITERATE_CLAUSES,
        ITERATE_CLOSED, ITERATE_DIFF, ITERATE_EQ, ITERATE_IMAGE, ITERATE_IMAGE_GEN,
        ITERATE_INCL_EXCL, ITERATE_ITERATE_PRODUCT, ITERATE_REFLECT, ITERATE_SUPERSET,
        ITERATE_SUPPORT, ITERATE_UNION, LE_0, LE_1, LE_EXISTS, LE_REFL, LE_SUC, LT, .. } := D.core5
  let { NOT_IMP, NOT_IN_EMPTY, NOT_LT, NUMSEG_CLAUSES, NUMSEG_LREC,
        NUMSEG_OFFSET_IMAGE, NUMSEG_RREC, NUMSEG_SING, PAIR_EQ, PRIME_IMP_NZ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SELECT_UNIQUE, SUBSET,
        SUBSET_ANTISYM, SUBSET_RESTRICT, SUB_0, SUB_REFL, SUB_SUC, UNION_RESTRICT, .. } := D.core7
  let { binom, iterate, monoidal, neutral, numseg, o_DEF, o_THM, support, .. } := D.core8
  let { RING_0, RING_1, RING_ADD, RING_ADD_AC, RING_ADD_LDISTRIB, RING_ADD_LZERO,
        RING_ADD_RDISTRIB, RING_ADD_RZERO, RING_ADD_SYM, RING_EQ_SUB_LADD, RING_MUL,
        RING_MUL_AC, RING_MUL_LID, RING_MUL_LZERO, RING_MUL_RID, RING_MUL_RZERO,
        RING_NEG, RING_NEG_0, RING_NEG_ADD, RING_NEG_SUB, RING_SUB, RING_SUB_RDISTRIB,
        RING_SUB_TELESCOPE, ring_sub, .. } := BBasics
  let { RING_OF_NUM, RING_OF_NUM_0, RING_OF_NUM_1, RING_OF_NUM_ADD, RING_OF_NUM_EQ_0,
        RING_POW, RING_POW_ONE, ring_pow, .. } := BNumbers
  -- @@SCOPE END

  let ring_sum ← new_definition
   r"ring_sum r s (f:K->A) =
        iterate (\x y. if x IN ring_carrier r /\ y IN ring_carrier r
                       then ring_add r x y
                       else if x IN ring_carrier r then y
                       else if y IN ring_carrier r then x
                       else @z:A. ~(z IN ring_carrier r))
                {x | x IN s /\ f(x) IN ring_carrier r} f"

  let NEUTRAL_RING_ADD ← prove
   r"!r:A ring.
        neutral (\x y. if x IN ring_carrier r /\ y IN ring_carrier r
                       then ring_add r x y
                       else if x IN ring_carrier r then y
                       else if y IN ring_carrier r then x
                       else @z. ~(z IN ring_carrier r)) = ring_0 r"
   (GEN_TAC THEN REWRITE_TAC [neutral] THEN MATCH_MP_TAC SELECT_UNIQUE THEN
    X_GEN_TAC (← q "x:A") THEN REWRITE_TAC [] THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o SPEC (← q "ring_0 r:A")), DISCH_THEN SUBST1_TAC] THEN
    SIMP_TAC [RING_0, RING_ADD_LZERO, RING_ADD_RZERO, COND_ID])

  let MONOIDAL_RING_ADD ← prove
   r"!r:A ring.
        monoidal (\x y. if x IN ring_carrier r /\ y IN ring_carrier r
                        then ring_add r x y
                        else if x IN ring_carrier r then y
                         else if y IN ring_carrier r then x
                        else @z. ~(z IN ring_carrier r))"
   (REWRITE_TAC [monoidal, NEUTRAL_RING_ADD] THEN
    SIMP_TAC [RING_0, RING_ADD_LZERO, COND_ID] THEN
    GEN_TAC THEN CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
    TRY (X_GEN_TAC (← q "z:A")) THEN
    MAP_EVERY ASM_CASES_TAC
     [← q "(x:A) IN ring_carrier r", ← q "(y:A) IN ring_carrier r",
      ← q "(z:A) IN ring_carrier r"] THEN
    ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [RING_ADD] THEN
    ASM_SIMP_TAC [RING_ADD_AC, RING_ADD] THEN ASM_MESON_TAC [])

  let RING_SUM ← prove
   r"!r s (f:K->A). ring_sum r s f IN ring_carrier r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_sum] THEN
    MATCH_MP_TAC
     (← SIMP_RULE [NEUTRAL_RING_ADD, RING_0, RING_ADD]
       (← ISPEC (← q r"\x:B. x IN ring_carrier r")
       (← MATCH_MP ITERATE_CLOSED (← ISPEC (← q "r:C ring") MONOIDAL_RING_ADD)))) THEN
    SIMP_TAC [IN_ELIM_THM])

  let RING_SUM_RESTRICT ← prove
   r"!s f. ring_sum r {a | a IN s /\ f a IN ring_carrier r} f = ring_sum r s f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_sum] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let RING_SUM_SUPPORT ← prove
   r"!s (f:K->A).
        ring_sum r {a | a IN s /\ ~(f a = ring_0 r)} f = ring_sum r s f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_sum] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM ITERATE_SUPPORT] THEN
    REWRITE_TAC [support, NEUTRAL_RING_ADD] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let RING_SUM_TRIVIAL ← prove
   r"!r k (f:K->A).
        INFINITE {i | i IN k /\ f i IN ring_carrier r /\ ~(f i = ring_0 r)}
        ==> ring_sum r k f = ring_0 r"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM RING_SUM_SUPPORT] THEN
    REWRITE_TAC [ring_sum] THEN ONCE_REWRITE_TAC [iterate] THEN
    REWRITE_TAC [NEUTRAL_RING_ADD, support] THEN
    ONCE_REWRITE_TAC [← GSYM COND_SWAP] THEN
    REWRITE_TAC [← GSYM INFINITE, IN_ELIM_THM] THEN
    ASM_REWRITE_TAC [← TAUT (← q r"((p /\ q) /\ r) /\ q <=> p /\ r /\ q")])

  let RING_SUM_CLAUSES ← prove
   r"(!r f:K->A. ring_sum r {} f = ring_0 r) /\
   (!r x (f:K->A) s.
          FINITE s
          ==> ring_sum r (x INSERT s) f =
              (if f(x) IN ring_carrier r ==> x IN s
               then ring_sum r s f else ring_add r (f x) (ring_sum r s f)))"
   (REWRITE_TAC [ring_sum, ← SET_RULE (← q r"{x | x IN {} /\ P x} = {}")] THEN
    REWRITE_TAC [INSERT_RESTRICT] THEN
    REPEAT STRIP_TAC THEN TRY COND_CASES_TAC THEN
    ASM_SIMP_TAC [ITERATE_CLAUSES, MONOIDAL_RING_ADD,
                  NOT_IN_EMPTY, EMPTY_GSPEC, FINITE_RESTRICT] THEN
    ASM_REWRITE_TAC [NEUTRAL_RING_ADD, ← GSYM ring_sum, IN_ELIM_THM, RING_SUM])

  let RING_SUM_SING ← prove
   r"!r (f:K->A) a.
        ring_sum r {a} f = if f a IN ring_carrier r then f a else ring_0 r"
   (SIMP_TAC [RING_SUM_CLAUSES, FINITE_EMPTY, NOT_IN_EMPTY, COND_SWAP] THEN
    MESON_TAC [RING_ADD_RZERO])

  let RING_SUM_CLAUSES_NUMSEG_ALT ← prove
   r"(!r m f:num->A.
        ring_sum r (m..0) f =
        if m = 0 /\ f 0 IN ring_carrier r then f 0 else ring_0 r) /\
   (!r m n f:num->A.
        ring_sum r (m..SUC n) f =
        if m <= SUC n /\ f(SUC n) IN ring_carrier r
        then ring_add r (f(SUC n)) (ring_sum r (m..n) f)
        else ring_sum r (m..n) f)"
   (REWRITE_TAC [NUMSEG_CLAUSES] THEN REPEAT STRIP_TAC THENL
     [ASM_CASES_TAC (← q "m = 0"), ASM_CASES_TAC (← q "m <= SUC n")] THEN
    ASM_REWRITE_TAC [RING_SUM_SING, ← CONJUNCT1 RING_SUM_CLAUSES] THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES, FINITE_NUMSEG] THEN
    REWRITE_TAC [IN_NUMSEG, ← ARITH_RULE (← q "~(SUC n <= n)"), COND_SWAP])

  let RING_SUM_CLAUSES_NUMSEG ← prove
   r"(!r m f:num->A.
        ring_sum r (m..0) f =
        if m = 0 /\ f 0 IN ring_carrier r then f 0 else ring_0 r) /\
   (!r m n f:num->A.
        ring_sum r (m..SUC n) f =
        if m <= SUC n /\ f(SUC n) IN ring_carrier r
        then ring_add r (ring_sum r (m..n) f) (f(SUC n))
        else ring_sum r (m..n) f)"
   (REWRITE_TAC [RING_SUM_CLAUSES_NUMSEG_ALT] THEN
    MESON_TAC [RING_SUM, RING_ADD_SYM])

  let RING_SUM_CLAUSES_LEFT ← prove
   r"!r (f:num->A) m n.
        m <= n
        ==> ring_sum r (m..n) f =
            if f m IN ring_carrier r
            then ring_add r (f m) (ring_sum r (m+1..n) f)
            else ring_sum r (m+1..n) f"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM NUMSEG_LREC, RING_SUM_CLAUSES, FINITE_NUMSEG] THEN
    REWRITE_TAC [IN_NUMSEG, ← ARITH_RULE (← q "~(n + 1 <= n)"), COND_SWAP])

  let RING_SUM_CLAUSES_RIGHT ← prove
   r"!r (f:num->A) m n.
        0 < n /\ m <= n
        ==> ring_sum r (m..n) f =
            if f n IN ring_carrier r
            then ring_add r (ring_sum r (m..n-1) f) (f n)
            else ring_sum r (m..n-1) f"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM NUMSEG_RREC, RING_SUM_CLAUSES, FINITE_NUMSEG] THEN
    ASM_SIMP_TAC [IN_NUMSEG, ← ARITH_RULE (← q "n <= n - 1 <=> n = 0"), COND_SWAP] THEN
    ASM_MESON_TAC [LE_1, RING_ADD_SYM, RING_SUM])

  let RING_SUM_UNION ← prove
   r"!r (f:K->A) s t.
        FINITE s /\ FINITE t /\ DISJOINT s t
        ==> ring_sum r (s UNION t) f =
            ring_add r (ring_sum r s f) (ring_sum r t f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_sum, UNION_RESTRICT] THEN
    wPart lhand (fun t => do lhand (← rand t)) (← MATCH_MP ITERATE_UNION
      (← ISPEC (← q "r:C ring") MONOIDAL_RING_ADD)) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_RESTRICT] THEN ASM SET_TAC [],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC []] THEN
    REWRITE_TAC [← GSYM ring_sum, RING_SUM])

  let RING_SUM_DIFF ← prove
   r"!r (f:K->A) s t.
        FINITE s /\ t SUBSET s
        ==> ring_sum r (s DIFF t) f =
            ring_sub r (ring_sum r s f) (ring_sum r t f)"
   (REPEAT STRIP_TAC THEN SIMP_TAC [RING_EQ_SUB_LADD, RING_SUM] THEN
    SIMP_TAC [ring_sum, DIFF_RESTRICT] THEN
    wPart (fun t => do lhand (← lhand t)) (fun t => do lhand (← lhand (← rand t)))
      (← MATCH_MP ITERATE_DIFF (← ISPEC (← q "r:C ring") MONOIDAL_RING_ADD)) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_RESTRICT] THEN ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← GSYM ring_sum, RING_SUM, ← GSYM DIFF_RESTRICT])

  let RING_SUM_INCL_EXCL ← prove
   r"!r (f:K->A) s t.
        FINITE s /\ FINITE t
        ==> ring_add r (ring_sum r s f) (ring_sum r t f) =
            ring_add r (ring_sum r (s UNION t) f)
                       (ring_sum r (s INTER t) f)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ring_sum, INTER_RESTRICT, UNION_RESTRICT] THEN
    wPart (fun t => do rand (← rand t)) (funpowM 3 rand) (← MATCH_MP ITERATE_INCL_EXCL
      (← ISPEC (← q "r:C ring") MONOIDAL_RING_ADD)) THEN
    ASM_SIMP_TAC [FINITE_RESTRICT] THEN
    REWRITE_TAC [← GSYM INTER_RESTRICT, ← GSYM UNION_RESTRICT] THEN
    REWRITE_TAC [← GSYM ring_sum, RING_SUM])

  let RING_SUM_CLOSED ← prove
   r"!r P (f:K->A) s.
        P(ring_0 r) /\
        (!x y. x IN ring_carrier r /\ y IN ring_carrier r /\ P x /\ P y
               ==> P(ring_add r x y)) /\
        (!a. a IN s ==> P(f a))
        ==> P(ring_sum r s f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_sum] THEN
    MP_TAC (← ISPECL
     [← q r"\x:A. x IN ring_carrier r /\ P x",
      ← q r"f:K->A", ← q r"{a | a IN s /\ (f:K->A) a IN ring_carrier r}"]
     (← MATCH_MP (← REWRITE_RULE [RIGHT_IMP_FORALL_THM] ITERATE_CLOSED)
               (← ISPEC (← q "r:C ring") MONOIDAL_RING_ADD))) THEN
    ASM_SIMP_TAC [NEUTRAL_RING_ADD, IMP_IMP, RING_0, RING_ADD, IN_ELIM_THM])

  let RING_SUM_RELATED ← prove
   r"!r R (f:K->A) g s.
        R (ring_0 r) (ring_0 r)/\
        (!x y x' y'. x IN ring_carrier r /\ y IN ring_carrier r /\
                     x' IN ring_carrier r /\ y' IN ring_carrier r /\
                     R x y /\ R x' y'
                     ==> R (ring_add r x x') (ring_add r y y')) /\
        FINITE s /\
        (!a. a IN s
             ==> (f a IN ring_carrier r <=> g a IN ring_carrier r) /\
                 R (f a) (g a))
        ==> R (ring_sum r s f) (ring_sum r s g)"
   (REPLICATE_TAC 4 GEN_TAC THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [FORALL_IN_INSERT, RING_SUM_CLAUSES] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [COND_SWAP] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [RING_SUM])

  let RING_SUM_EQ_0 ← prove
   r"!r (f:K->A) s.
        (!a. a IN s /\ f a IN ring_carrier r ==> f a = ring_0 r)
        ==> ring_sum r s f = ring_0 r"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM RING_SUM_RESTRICT] THEN
    ONCE_REWRITE_TAC [← GSYM RING_SUM_SUPPORT] THEN
    MATCH_MP_TAC (← MESON [RING_SUM_CLAUSES]
     (← q "s = {} ==> ring_sum r s f = ring_0 r")) THEN
    ASM SET_TAC [])

  let RING_SUM_0 ← prove
   r"!r s. ring_sum r s (\i:K. ring_0 r):A = ring_0 r"
   (SIMP_TAC [RING_SUM_EQ_0])

  let RING_SUM_DELETE ← prove
   r"!r (f:K->A) s a.
        FINITE s /\ a IN s /\ f a IN ring_carrier r
        ==> ring_sum r (s DELETE a) f = ring_sub r (ring_sum r s f) (f a)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q "(a:K) IN s") THEN ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q "t = s DELETE (a:K)") THEN
    SUBGOAL_THEN (← q "s = (a:K) INSERT t") SUBST1_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [FINITE_INSERT] THEN STRIP_TAC] THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES] THEN
    EXPAND_TAC "t" THEN REWRITE_TAC [IN_DELETE] THEN
    ASM_SIMP_TAC [RING_EQ_SUB_LADD, RING_SUM, RING_ADD] THEN
    ASM_SIMP_TAC [RING_ADD_SYM, RING_SUM])

  let RING_SUM_NEG ← prove
   r"!r (f:K->A) s.
        FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier r)
        ==> ring_sum r s (\x. ring_neg r (f x)) =
            ring_neg r (ring_sum r s f)"
   (REPLICATE_TAC 2 GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES, FORALL_IN_INSERT, RING_NEG] THEN
    SIMP_TAC [RING_NEG_ADD, RING_SUM, RING_NEG_0])

  let RING_SUM_ADD ← prove
   r"!r (f:K->A) (g:K->A) s.
        FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier r /\ g a IN ring_carrier r)
        ==> ring_sum r s (\x. ring_add r (f x) (g x)) =
            ring_add r (ring_sum r s f) (ring_sum r s g)"
   (REPLICATE_TAC 3 GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES, FORALL_IN_INSERT, RING_ADD] THEN
    ASM_SIMP_TAC [RING_ADD_AC, RING_SUM, RING_ADD] THEN
    SIMP_TAC [RING_ADD_LZERO, RING_0])

  let RING_SUM_SUB ← prove
   r"!r (f:K->A) (g:K->A) s.
        FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier r /\ g a IN ring_carrier r)
        ==> ring_sum r s (\x. ring_sub r (f x) (g x)) =
            ring_sub r (ring_sum r s f) (ring_sum r s g)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_sub] THEN
    ASM_SIMP_TAC [RING_SUM_NEG, RING_SUM_ADD, RING_NEG])

  let RING_SUM_EQ ← prove
   r"!r (f:K->A) g s.
        (!a. a IN s ==> f a = g a) ==> ring_sum r s f = ring_sum r s g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_sum] THEN
    SUBGOAL_THEN
     (← q r"{a | a IN s /\ (g:K->A) a IN ring_carrier r} =
    {a | a IN s /\ (f:K->A) a IN ring_carrier r}")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← MATCH_MP ITERATE_EQ (← ISPEC (← q "r:C ring") MONOIDAL_RING_ADD)) THEN
    ASM SET_TAC [])

  let RING_SUM_DELTA ← prove
   r"!r s (i:K) (a:A).
        ring_sum r s (\j. if j = i then a else ring_0 r) =
        if i IN s /\ a IN ring_carrier r then a else ring_0 r"
   (← do
    -- right to left: the last SET_RULE first, the first TAUT last
    let s2 ← SET_RULE (← q r"i IN s ==> {j | j IN s /\ j = i} = {i}")
    let t2 ← TAUT (← q r"~((p /\ q) /\ ~q)")
    let s1 ← SET_RULE (← q r"~(i IN s) ==> {j | (j IN s /\ j = i /\ P j) /\ Q j} = {}")
    let t1 ← TAUT (← q r"(if p then q else T) <=> p ==> q")
    pure (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM RING_SUM_SUPPORT] THEN
      ONCE_REWRITE_TAC [← GSYM RING_SUM_RESTRICT] THEN REWRITE_TAC [IN_ELIM_THM] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [COND_RAND] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [COND_RATOR] THEN
      REWRITE_TAC [RING_0, NOT_IMP, t1] THEN
      ASM_CASES_TAC (← q "(i:K) IN s") THEN ASM_SIMP_TAC [RING_SUM_CLAUSES, s1] THEN
      ASM_CASES_TAC (← q "a:A = ring_0 r") THEN
      ASM_REWRITE_TAC [COND_ID, EMPTY_GSPEC, RING_SUM_CLAUSES] THEN
      ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THEN
      ASM_SIMP_TAC [t2, EMPTY_GSPEC, RING_SUM_CLAUSES] THEN
      ASM_SIMP_TAC [s2] THEN
      ASM_REWRITE_TAC [RING_SUM_SING]))

  let RING_SUM_LMUL ← prove
   r"!r (f:K->A) c s.
        c IN ring_carrier r /\
        FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier r)
        ==> ring_sum r s (\x. ring_mul r c (f x)) =
            ring_mul r c (ring_sum r s f)"
   (REPLICATE_TAC 3 GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES, FORALL_IN_INSERT, RING_MUL,
                  RING_ADD_LDISTRIB, RING_MUL_RZERO, RING_SUM])

  let RING_SUM_RMUL ← prove
   r"!r (f:K->A) c s.
        c IN ring_carrier r /\
        FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier r)
        ==> ring_sum r s (\x. ring_mul r (f x) c) =
            ring_mul r (ring_sum r s f) c"
   (REPLICATE_TAC 3 GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES, FORALL_IN_INSERT, RING_MUL,
                  RING_ADD_RDISTRIB, RING_MUL_LZERO, RING_SUM])

  let RING_SUM_SWAP ← prove
   r"!r (f:K->L->A) s t.
        FINITE s /\ FINITE t /\
        (!i j. i IN s /\ j IN t ==> f i j IN ring_carrier r)
        ==> ring_sum r s (\i. ring_sum r t (f i)) =
            ring_sum r t (\j. ring_sum r s (\i. f i j))"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [FORALL_IN_INSERT, RING_SUM_CLAUSES, RING_SUM, RING_SUM_0,
                  ← GSYM RING_SUM_ADD] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_SUM_EQ THEN ASM_SIMP_TAC [])

  let RING_SUM_REFLECT ← prove
   r"!r (x:num->A) m n.
        (!i. m <= i /\ i <= n ==> x i IN ring_carrier r)
        ==> ring_sum r (m..n) x =
            if n < m then ring_0 r
            else ring_sum r (0..n-m) (\i. x(n - i))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"~(n < m)
    ==> !j. 0 <= j /\ j <= n - m ==> (x:num->A) (n - j) IN ring_carrier r")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [ring_sum, IN_NUMSEG] THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | P x /\ f x IN s} = {x | P x /\ (P x ==> f x IN s)}")] THEN
    ASM_SIMP_TAC [] THEN REWRITE_TAC [← GSYM numseg] THEN
    MP_TAC (← ISPECL [← q r"x:num->A", ← q "m:num", ← q "n:num"]
     (← MATCH_MP ITERATE_REFLECT (← ISPEC (← q "r:C ring") MONOIDAL_RING_ADD))) THEN
    ASM_REWRITE_TAC [NEUTRAL_RING_ADD])

  let RING_SUM_SUM_PRODUCT ← prove
   r"!r s t (x:K->L->A).
        FINITE s /\
        (!i. i IN s ==> FINITE(t i)) /\
        (!i j. i IN s /\ j IN t i ==> x i j IN ring_carrier r)
        ==> ring_sum r s (\i. ring_sum r (t i) (x i)) =
            ring_sum r {i,j | i IN s /\ j IN t i} (\(i,j). x i j)"
   (← do
    -- right to left: the second MESON first
    let m2 ← MESON [ITERATE_EQ]
     (← q r"monoidal op /\ s = t /\ (!i. i IN s ==> f i = g i)
    ==> iterate op s f = iterate op t g")
    let m1 ← MESON [] (← q r"t' = t /\ s' = s ==> s = t ==> s' = t'")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_sum] THEN
      MP_TAC (← ISPECL [← q r"s:K->bool", ← q r"t:K->L->bool", ← q r"x:K->L->A"]
      (← MATCH_MP ITERATE_ITERATE_PRODUCT (← ISPEC (← q "r:D ring") MONOIDAL_RING_ADD))) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC m1 THEN
      CONJ_TAC THENL
       [AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
        REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN
        REWRITE_TAC [IN_ELIM_THM, PAIR_EQ] THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC m2 THEN
      REWRITE_TAC [MONOIDAL_RING_ADD] THEN
      REWRITE_TAC [← GSYM ring_sum, RING_SUM, IN_GSPEC] THEN
      X_GEN_TAC (← q "i:K") THEN DISCH_TAC THEN REWRITE_TAC [ring_sum] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN
      REWRITE_TAC [IN_ELIM_THM, PAIR_EQ] THEN ASM_MESON_TAC []))

  let RING_SUM_SUPERSET ← prove
   r"!r (f:K->A) u v.
        u SUBSET v /\ (!x. x IN v /\ ~(x IN u) ==> f x = ring_0 r)
        ==> ring_sum r v f = ring_sum r u f"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM RING_SUM_SUPPORT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let RING_SUM_RESTRICT_SET ← prove
   r"!P r s (f:K->A).
        ring_sum r {x | x IN s /\ P x} f =
        ring_sum r s (\x. if P x then f x else ring_0 r)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"ring_sum r s' f = ring_sum r s' f' /\
    ring_sum r s f' = ring_sum r s' f'
    ==> ring_sum r s' f = ring_sum r s f'")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_SUM_EQ THEN SET_TAC [],
      MATCH_MP_TAC RING_SUM_SUPERSET THEN
      SIMP_TAC [IN_ELIM_THM, SUBSET_RESTRICT] THEN MESON_TAC []])

  let RING_SUM_CASES ← prove
   r"!r s P (f:K->A) g.
        FINITE s
        ==> ring_sum r s (\x. if P x then f x else g x) =
            ring_add r (ring_sum r {x | x IN s /\ P x} f)
                       (ring_sum r {x | x IN s /\ ~P x} g)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"\x. if P x then (f:K->A) x else g x",
                      ← q r"{x:K | x IN s /\ P x}", ← q r"{x:K | x IN s /\ ~P x}"]
          RING_SUM_UNION) THEN
    ANTS_TAC THENL [ASM_SIMP_TAC [FINITE_RESTRICT] THEN SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
     [AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [],
      BINOP_TAC THEN MATCH_MP_TAC RING_SUM_EQ THEN SET_TAC []])

  let RING_SUM_IMAGE ← prove
   r"!r (f:K->L) (g:L->A) s.
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> ring_sum r (IMAGE f s) g = ring_sum r s (g o f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_sum] THEN
    wPart rand (fun t => do rand (← rand t))
     (← MATCH_MP ITERATE_IMAGE (← ISPEC (← q "r:C ring") MONOIDAL_RING_ADD)) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [o_THM] THEN ASM SET_TAC [])

  let RING_SUM_EQ_GENERAL_INVERSES ← prove
   r"!r s t (f:K->A) (g:L->A) h k.
        (!y. y IN t ==> k y IN s /\ h (k y) = y) /\
        (!x. x IN s ==> h x IN t /\ k (h x) = x /\ g (h x) = f x)
        ==> ring_sum r s f = ring_sum r t g"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS (← q r"ring_sum r s ((g:L->A) o (h:K->L))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_SUM_EQ THEN ASM_SIMP_TAC [o_THM],
      wPart lhand (fun t => do rand (← rand t)) RING_SUM_IMAGE THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let RING_SUM_OFFSET ← prove
   r"!p r (f:num->A) m n.
        ring_sum r (m+p..n+p) f = ring_sum r (m..n) (\i. f(i + p))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [NUMSEG_OFFSET_IMAGE] THEN
    MATCH_MP_TAC (← REWRITE_RULE [o_DEF] RING_SUM_IMAGE) THEN
    SIMP_TAC [EQ_ADD_RCANCEL])

  let RING_SUM_CONST ← prove
   r"!(r:A ring) (c:A) (s:B->bool).
        FINITE s /\ c IN ring_carrier r
        ==> ring_sum r s (\i. c) = ring_mul r (ring_of_num r (CARD s)) c"
   (REWRITE_TAC [IMP_CONJ_ALT, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES, CARD_CLAUSES, RING_OF_NUM_0, RING_MUL_LZERO,
                  ADD1, RING_OF_NUM_ADD, RING_OF_NUM_1] THEN
    ASM_SIMP_TAC [RING_ADD_RDISTRIB, RING_OF_NUM, RING_1, RING_MUL_LID] THEN
    ASM_MESON_TAC [RING_ADD_SYM, RING_MUL, RING_OF_NUM])

  let RING_SUM_IMAGE_GEN ← prove
   r"!r (f:K->B) (g:K->A) s.
         FINITE s
         ==> ring_sum r s g =
             ring_sum r (IMAGE f s)
                        (\y. ring_sum r {x | x IN s /\ f x = y} g)"
   (← do
    -- right to left: the SET_RULE first, then the TAUT
    let s1 ← SET_RULE (← q r"(x IN s /\ f x = a) /\ P x <=>
                        x IN {x | x IN s /\ f x = a} /\ P x")
    let t1 ← TAUT (← q r"(x IN s /\ y IN t) /\ a = b <=> (x IN s /\ a = b) /\ y IN t")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_sum] THEN
      MP_TAC (← ISPECL
       [← q r"f:K->B", ← q r"g:K->A", ← q r"{x | x IN s /\ (g:K->A) x IN ring_carrier r}"]
        (← MATCH_MP ITERATE_IMAGE_GEN (← ISPEC (← q "r:C ring") MONOIDAL_RING_ADD))) THEN
      ANTS_TAC THENL [ASM_SIMP_TAC [FINITE_RESTRICT], DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [IN_ELIM_THM, t1] THEN
      CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
            ITERATE_SUPERSET) THEN
      REWRITE_TAC [MONOIDAL_RING_ADD] THEN
      REWRITE_TAC [s1] THEN
      REWRITE_TAC [← GSYM ring_sum, RING_SUM, NEUTRAL_RING_ADD] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IMP_CONJ, FORALL_IN_IMAGE] THEN
      SIMP_TAC [FUN_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC RING_SUM_EQ_0 THEN ASM SET_TAC []))

  let RING_BINOMIAL_THEOREM ← prove
   r"!r n x y:A.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_pow r (ring_add r x y) n =
            ring_sum r (0..n)
              (\k. ring_mul r (ring_of_num r (binom(n,k)))
                    (ring_mul r (ring_pow r x k) (ring_pow r y (n - k))))"
   (← do
    -- right to left, from the end of the text: the last ARITH_RULE, the
    -- fourth `basic_ss []`, the REWRITE_CONV, the MESON, the third and
    -- second `basic_ss []`, the first ARITH_RULE, the first `basic_ss []`
    let a2 ← ARITH_RULE (← q "k <= n ==> SUC n - k = SUC(n - k)")
    let ss4 ← ExceptT.mk (basic_ss [])
    let rc ← SYM (← REWRITE_CONV [RING_SUM_OFFSET] (← q r"ring_sum r (m+1..n+1) (\i. f i)"))
    let m1 ← MESON [RING_ADD_AC]
     (← q r"a IN ring_carrier r /\ b IN ring_carrier r /\ c IN ring_carrier r /\
    d IN ring_carrier r /\ e IN ring_carrier r /\
    a = e /\ b = ring_add r c d
    ==> ring_add r a b = ring_add r c (ring_add r d e)")
    let ss3 ← ExceptT.mk (basic_ss [])
    let ss2 ← ExceptT.mk (basic_ss [])
    let a1 ← ARITH_RULE (← q "0 <= n + 1")
    let ss1 ← ExceptT.mk (basic_ss [])
    pure (GEN_TAC THEN INDUCT_TAC THEN REPEAT STRIP_TAC THEN
      ASM_SIMP_TAC [NUMSEG_SING, RING_SUM_SING, binom, SUB_REFL, ring_pow,
                    RING_MUL_LID, RING_OF_NUM_1, RING_1] THEN
      ASM (simpTac ss1 4)
       [RING_SUM_CLAUSES_LEFT, ADD1, a1,
        RING_SUM_OFFSET, RING_POW, RING_MUL, RING_1, RING_OF_NUM] THEN
      ASM (simpTac ss2 4)
       [ring_pow, binom, ← GSYM ADD1, ← GSYM RING_SUM_LMUL, FINITE_NUMSEG,
        RING_POW, RING_MUL, RING_1, RING_OF_NUM, RING_ADD] THEN
      ASM (simpTac ss3 5)
       [RING_OF_NUM_ADD, RING_MUL_LID, SUB_0, RING_ADD_RDISTRIB, RING_SUM_ADD,
        RING_POW, RING_MUL, RING_1, RING_OF_NUM, RING_ADD, FINITE_NUMSEG,
        RING_OF_NUM_1] THEN
      MATCH_MP_TAC m1 THEN
      ASM_SIMP_TAC [RING_SUM, RING_MUL, RING_POW, RING_OF_NUM] THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [SUB_SUC, RING_MUL_AC, RING_MUL, RING_OF_NUM, RING_POW],
        REWRITE_TAC [← GSYM ring_pow]] THEN
      ASM_SIMP_TAC [ADD1, rc] THEN
      ASM_SIMP_TAC [RING_SUM_CLAUSES_NUMSEG, ← GSYM ADD1, LE_SUC, LE_0,
                    RING_MUL, RING_POW, RING_OF_NUM] THEN
      ASM (simpTac ss4 5)
       [RING_SUM_CLAUSES_LEFT, LE_0, BINOM_LT, LT, RING_MUL_LID, SUB_0,
                   RING_OF_NUM_1, ring_pow, binom, RING_MUL_LZERO, RING_ADD_RZERO,
                   RING_OF_NUM_0, RING_ADD_LZERO, RING_SUM,
                   RING_MUL, RING_POW, RING_OF_NUM] THEN
      REWRITE_TAC [ARITH] THEN AP_TERM_TAC THEN MATCH_MP_TAC RING_SUM_EQ THEN
      SIMP_TAC [IN_NUMSEG, a2] THEN
      ASM_SIMP_TAC [ring_pow, RING_MUL_AC, RING_POW, RING_MUL, RING_OF_NUM]))

  let RING_BINOMIAL_FRESHMAN ← prove
   r"!(r:A ring) x y.
        prime(ring_char r) /\
        x IN ring_carrier r /\ y IN ring_carrier r
         ==> ring_pow r (ring_add r x y) (ring_char r) =
             ring_add r (ring_pow r x (ring_char r))
                        (ring_pow r y (ring_char r))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [RING_BINOMIAL_THEOREM] THEN
    ASM_SIMP_TAC [RING_SUM_CLAUSES_RIGHT, PRIME_IMP_NZ, LE_1, LE_0] THEN
    SIMP_TAC [RING_SUM_CLAUSES_LEFT, LE_0] THEN
    ASM_SIMP_TAC [RING_MUL, RING_OF_NUM, RING_POW, SUB_REFL, ring_pow,
                  RING_OF_NUM_1, SUB_0, ADD_CLAUSES,
                  RING_MUL_LID, RING_MUL_RID, BINOM_REFL, ← CONJUNCT1 binom] THEN
    wPart (fun t => do rand (← lhand (← lhand t))) (fun t => do lhand (← rand t))
      RING_SUM_EQ_0 THEN
    ANTS_TAC THENL
     [X_GEN_TAC (← q "i:num") THEN REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← MESON [RING_MUL_LZERO]
       (← q r"x = ring_0 r /\ y IN ring_carrier r ==> ring_mul r x y = ring_0 r")) THEN
      ASM_SIMP_TAC [RING_MUL, RING_POW, RING_OF_NUM_EQ_0] THEN
      MATCH_MP_TAC DIVIDES_PRIME_BINOM THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP PRIME_IMP_NZ) THEN
      ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
      DISCH_THEN SUBST1_TAC THEN ASM_SIMP_TAC [RING_ADD_RZERO, RING_POW] THEN
      MATCH_MP_TAC RING_ADD_SYM THEN ASM_SIMP_TAC [RING_POW]])

  let RING_SUM_DIFFS ← prove
   r"!r (f:num->A) m n.
        (!i. m <= i /\ i <= n + 1 ==> f i IN ring_carrier r)
        ==> ring_sum r (m..n) (\k. ring_sub r (f k) (f(k + 1))) =
            if m <= n then ring_sub r (f m) (f(n + 1)) else ring_0 r"
   (← do
    -- `let lemma = prove (...) in tactic`: the lemma first (its rules right
    -- to left), then the tactic
    let lemma ← prove
     r"!r (f:num->A) n.
          (!i. i <= n + 1 ==> f i IN ring_carrier r)
          ==> ring_sum r (0..n) (\k. ring_sub r (f k) (f(SUC k))) =
              ring_sub r (f 0) (f(SUC n))"
     (← do
      let a2 ← ARITH_RULE (← q "i <= n ==> i <= SUC n")
      let a1 ← ARITH_RULE (← q "n <= SUC n")
      pure (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [← GSYM ADD1] THEN INDUCT_TAC THENL
       [SIMP_TAC [ARITH, NUMSEG_CLAUSES, RING_SUM_SING, RING_SUB],
        REWRITE_TAC [RING_SUM_CLAUSES_NUMSEG, LE_0] THEN
        SIMP_TAC [RING_SUB, LE_REFL, a1] THEN
        DISCH_TAC THEN ASM_SIMP_TAC [a2] THEN
        MATCH_MP_TAC RING_SUB_TELESCOPE THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC]))
    pure (REPEAT STRIP_TAC THEN COND_CASES_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [EMPTY_NUMSEG, NOT_LT, RING_SUM_CLAUSES]] THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q "d:num") SUBST_ALL_TAC o
       ONCE_REWRITE_RULE [ADD_SYM] o GEN_REWRITE_RULE id [LE_EXISTS]) THEN
      GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o LAND_CONV)
       [← GSYM (← CONJUNCT1 ADD_CLAUSES)] THEN
      REWRITE_TAC [RING_SUM_OFFSET] THEN
      MP_TAC (← SPECL [← q "r:A ring", ← q r"\i. (f:num->A)(i + m)", ← q "d:num"] lemma) THEN
      ASM_REWRITE_TAC [← GSYM ADD1, ADD_CLAUSES] THEN DISCH_THEN MATCH_MP_TAC THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC))

  let RING_SUM_DIFFS_ALT ← prove
   r"!r (f:num->A) m n.
        (!i. m <= i /\ i <= n + 1 ==> f i IN ring_carrier r)
        ==> ring_sum r (m..n) (\k. ring_sub r (f(k + 1)) (f k)) =
            if m <= n then ring_sub r (f(n + 1)) (f m) else ring_0 r"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o AP_TERM (← q "ring_neg (r:A ring)") o
          MATCH_MP RING_SUM_DIFFS) THEN
    MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
     [wPart lhand (fun t => do rand (← rand t)) RING_SUM_NEG THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN ANTS_TAC THENL
       [REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_SUB,
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC RING_SUM_EQ THEN
        REWRITE_TAC [IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC RING_NEG_SUB],
      COND_CASES_TAC THEN REWRITE_TAC [RING_NEG_0] THEN
      MATCH_MP_TAC RING_NEG_SUB] THEN
    REPEAT CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC)

  let RING_GEOM_SERIES_GEN ← prove
   r"!(r:A ring) x y n.
        x IN ring_carrier r /\ y IN ring_carrier r
        ==> ring_mul r (ring_sub r x y)
             (ring_sum r (0..n)
                (\i. ring_mul r (ring_pow r x i) (ring_pow r y (n - i)))) =
             ring_sub r (ring_pow r x (SUC n)) (ring_pow r y (SUC n))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM RING_SUM_LMUL, RING_SUB, RING_POW, RING_MUL,
                  FINITE_NUMSEG, RING_SUB_RDISTRIB] THEN
    MP_TAC (← ISPECL
     [← q "r:A ring", ← q r"\i. ring_mul r (ring_pow r x i:A) (ring_pow r y (SUC n - i))",
      ← q "0", ← q "n:num"] RING_SUM_DIFFS_ALT) THEN
    ASM_SIMP_TAC [RING_MUL, RING_POW, SUB_0, ← GSYM ADD1, SUB_REFL, LE_0] THEN
    ASM_SIMP_TAC [← CONJUNCT1 ring_pow, RING_MUL_LID, RING_POW,
                  SUB_SUC, RING_MUL_RID, RING_MUL] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC RING_SUM_EQ THEN
    X_GEN_TAC (← q "i:num") THEN REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [← ARITH_RULE (← q "i <= n ==> SUC n - i = SUC(n - i)"), ring_pow] THEN
    ASM_SIMP_TAC [RING_MUL_AC, RING_POW])

  let RING_GEOM_SERIES ← prove
   r"!r (x:A) n.
        x IN ring_carrier r
        ==> ring_mul r (ring_sub r x (ring_1 r))
                       (ring_sum r (0..n) (\i. ring_pow r x i)) =
            ring_sub r (ring_pow r x (SUC n)) (ring_1 r)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q "r:A ring", ← q "x:A", ← q "ring_1 r:A", ← q "n:num"] RING_GEOM_SERIES_GEN) THEN
    ASM_SIMP_TAC [RING_POW_ONE, RING_1, RING_MUL_RID, RING_POW])

  -- `let th = prove (...) in extend_basic_congs [SPEC_ALL th]`
  do
    let th ← prove
     r"!r (f:K->A) g s.
    (!a. a IN s ==> f a = g a) ==> ring_sum r s (\i. f i) = ring_sum r s g"
     (REWRITE_TAC [ETA_AX, RING_SUM_EQ])
    extend_basic_congs [← SPEC_ALL th]

  -- @@RETURN BEGIN
  return { ring_sum, NEUTRAL_RING_ADD, MONOIDAL_RING_ADD, RING_SUM, RING_SUM_RESTRICT,
           RING_SUM_SUPPORT, RING_SUM_TRIVIAL, RING_SUM_CLAUSES, RING_SUM_SING,
           RING_SUM_CLAUSES_NUMSEG_ALT, RING_SUM_CLAUSES_NUMSEG, RING_SUM_CLAUSES_LEFT,
           RING_SUM_CLAUSES_RIGHT, RING_SUM_UNION, RING_SUM_DIFF, RING_SUM_INCL_EXCL,
           RING_SUM_CLOSED, RING_SUM_RELATED, RING_SUM_EQ_0, RING_SUM_0, RING_SUM_DELETE,
           RING_SUM_NEG, RING_SUM_ADD, RING_SUM_SUB, RING_SUM_EQ, RING_SUM_DELTA,
           RING_SUM_LMUL, RING_SUM_RMUL, RING_SUM_SWAP, RING_SUM_REFLECT,
           RING_SUM_SUM_PRODUCT, RING_SUM_SUPERSET, RING_SUM_RESTRICT_SET,
           RING_SUM_CASES, RING_SUM_IMAGE, RING_SUM_EQ_GENERAL_INVERSES, RING_SUM_OFFSET,
           RING_SUM_CONST, RING_SUM_IMAGE_GEN, RING_BINOMIAL_THEOREM,
           RING_BINOMIAL_FRESHMAN, RING_SUM_DIFFS, RING_SUM_DIFFS_ALT,
           RING_GEOM_SERIES_GEN, RING_GEOM_SERIES }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Very closely analogous: products in a ring.  (ringtheory.ml 1492-1931)    -/
/- ------------------------------------------------------------------------- -/

structure Products where
  -- @@FIELDS
  ring_product : thm
  NEUTRAL_RING_MUL : thm
  MONOIDAL_RING_MUL : thm
  RING_PRODUCT : thm
  RING_PRODUCT_RESTRICT : thm
  RING_PRODUCT_SUPPORT : thm
  RING_PRODUCT_TRIVIAL : thm
  RING_PRODUCT_CLAUSES : thm
  RING_PRODUCT_SING : thm
  RING_PRODUCT_CLAUSES_NUMSEG_ALT : thm
  RING_PRODUCT_CLAUSES_NUMSEG : thm
  RING_PRODUCT_CLAUSES_LEFT : thm
  RING_PRODUCT_UNION : thm
  RING_PRODUCT_INCL_EXCL : thm
  RING_PRODUCT_CLOSED : thm
  RING_PRODUCT_RELATED : thm
  RING_PRODUCT_EQ_1 : thm
  RING_PRODUCT_1 : thm
  RING_PRODUCT_0 : thm
  RING_PRODUCT_MUL : thm
  RING_PRODUCT_EQ : thm
  RING_PRODUCT_DELTA : thm
  RING_PRODUCT_CONST : thm
  RING_PRODUCT_LMUL : thm
  RING_PRODUCT_SWAP : thm
  RING_PRODUCT_REFLECT : thm
  RING_PRODUCT_SUPERSET : thm
  RING_PRODUCT_RESTRICT_SET : thm
  RING_PRODUCT_CASES : thm
  RING_PRODUCT_IMAGE : thm
  RING_PRODUCT_EQ_GENERAL_INVERSES : thm
  RING_PRODUCT_OFFSET : thm
  RING_PRODUCT_IMAGE_GEN : thm
  RING_PRODUCT_NSUM : thm
  deriving Inhabited

@[nospecialize]
def setupProducts [HolBase] (D : RingTheoryDeps) (BBasics : Basics) (BNumbers : Numbers) :
    ExceptT String IO Products := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        SIMP_RULE, extend_basic_congs, new_definition, .. } := D
  let { CARD_CLAUSES, COND_ID, .. } := D.core1
  let { COND_RAND, COND_RATOR, COND_SWAP, EMPTY_GSPEC, EQ_ADD_RCANCEL, EQ_IMP,
        EQ_TRANS, ETA_AX, .. } := D.core2
  let { FINITE_EMPTY, FINITE_INDUCT_STRONG, FINITE_NUMSEG, FINITE_RESTRICT,
        FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, INFINITE, INSERT_RESTRICT, INTER_RESTRICT, .. } := D.core4
  let { IN_ELIM_THM, IN_GSPEC, IN_NUMSEG, IN_SING, ITERATE_CLAUSES, ITERATE_CLOSED,
        ITERATE_EQ, ITERATE_IMAGE, ITERATE_IMAGE_GEN, ITERATE_INCL_EXCL,
        ITERATE_REFLECT, ITERATE_SUPERSET, ITERATE_SUPPORT, ITERATE_UNION, .. } := D.core5
  let { NOT_IMP, NOT_INSERT_EMPTY, NOT_IN_EMPTY, NSUM_CLAUSES, NUMSEG_CLAUSES,
        NUMSEG_LREC, NUMSEG_OFFSET_IMAGE, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SELECT_UNIQUE, SUBSET,
        SUBSET_RESTRICT, UNION_RESTRICT, .. } := D.core7
  let { iterate, monoidal, neutral, numseg, o_DEF, o_THM, support, .. } := D.core8
  let { RING_0, RING_1, RING_MUL, RING_MUL_AC, RING_MUL_LID, RING_MUL_LZERO,
        RING_MUL_RID, RING_MUL_SYM, TRIVIAL_RING_10, trivial_ring, .. } := BBasics
  let { RING_POW, RING_POW_0, RING_POW_ADD, ring_pow, .. } := BNumbers
  -- @@SCOPE END

  let ring_product ← new_definition
   r"ring_product r s (f:K->A) =
        iterate (\x y. if x IN ring_carrier r /\ y IN ring_carrier r
                       then ring_mul r x y
                       else if x IN ring_carrier r then y
                       else if y IN ring_carrier r then x
                       else @z:A. ~(z IN ring_carrier r))
                {x | x IN s /\ f(x) IN ring_carrier r} f"

  let NEUTRAL_RING_MUL ← prove
   r"!r:A ring.
        neutral (\x y. if x IN ring_carrier r /\ y IN ring_carrier r
                       then ring_mul r x y
                       else if x IN ring_carrier r then y
                       else if y IN ring_carrier r then x
                       else @z. ~(z IN ring_carrier r)) = ring_1 r"
   (GEN_TAC THEN REWRITE_TAC [neutral] THEN MATCH_MP_TAC SELECT_UNIQUE THEN
    X_GEN_TAC (← q "x:A") THEN REWRITE_TAC [] THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o SPEC (← q "ring_1 r:A")), DISCH_THEN SUBST1_TAC] THEN
    SIMP_TAC [RING_1, RING_MUL_LID, RING_MUL_RID, COND_ID])

  let MONOIDAL_RING_MUL ← prove
   r"!r:A ring.
        monoidal (\x y. if x IN ring_carrier r /\ y IN ring_carrier r
                        then ring_mul r x y
                        else if x IN ring_carrier r then y
                         else if y IN ring_carrier r then x
                        else @z. ~(z IN ring_carrier r))"
   (REWRITE_TAC [monoidal, NEUTRAL_RING_MUL] THEN
    SIMP_TAC [RING_1, RING_MUL_LID, COND_ID] THEN
    GEN_TAC THEN CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
    TRY (X_GEN_TAC (← q "z:A")) THEN
    MAP_EVERY ASM_CASES_TAC
     [← q "(x:A) IN ring_carrier r", ← q "(y:A) IN ring_carrier r",
      ← q "(z:A) IN ring_carrier r"] THEN
    ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [RING_MUL] THEN
    ASM_SIMP_TAC [RING_MUL_AC, RING_MUL] THEN ASM_MESON_TAC [])

  let RING_PRODUCT ← prove
   r"!r s (f:K->A). ring_product r s f IN ring_carrier r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_product] THEN
    MATCH_MP_TAC
     (← SIMP_RULE [NEUTRAL_RING_MUL, RING_1, RING_MUL]
       (← ISPEC (← q r"\x:B. x IN ring_carrier r")
       (← MATCH_MP ITERATE_CLOSED (← ISPEC (← q "r:C ring") MONOIDAL_RING_MUL)))) THEN
    SIMP_TAC [IN_ELIM_THM])

  let RING_PRODUCT_RESTRICT ← prove
   r"!s f. ring_product r {a | a IN s /\ f a IN ring_carrier r} f =
         ring_product r s f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_product] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let RING_PRODUCT_SUPPORT ← prove
   r"!s (f:K->A).
        ring_product r {a | a IN s /\ ~(f a = ring_1 r)} f =
        ring_product r s f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ring_product] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM ITERATE_SUPPORT] THEN
    REWRITE_TAC [support, NEUTRAL_RING_MUL] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let RING_PRODUCT_TRIVIAL ← prove
   r"!r k (f:K->A).
        INFINITE {i | i IN k /\ f i IN ring_carrier r /\ ~(f i = ring_1 r)}
        ==> ring_product r k f = ring_1 r"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM RING_PRODUCT_SUPPORT] THEN
    REWRITE_TAC [ring_product] THEN ONCE_REWRITE_TAC [iterate] THEN
    REWRITE_TAC [NEUTRAL_RING_MUL, support] THEN
    ONCE_REWRITE_TAC [← GSYM COND_SWAP] THEN
    REWRITE_TAC [← GSYM INFINITE, IN_ELIM_THM] THEN
    ASM_REWRITE_TAC [← TAUT (← q r"((p /\ q) /\ r) /\ q <=> p /\ r /\ q")])

  let RING_PRODUCT_CLAUSES ← prove
   r"(!r f:K->A. ring_product r {} f = ring_1 r) /\
   (!r x (f:K->A) s.
          FINITE s
          ==> ring_product r (x INSERT s) f =
              (if f(x) IN ring_carrier r ==> x IN s
               then ring_product r s f
               else ring_mul r (f x) (ring_product r s f)))"
   (REWRITE_TAC [ring_product, ← SET_RULE (← q r"{x | x IN {} /\ P x} = {}")] THEN
    REWRITE_TAC [INSERT_RESTRICT] THEN
    REPEAT STRIP_TAC THEN TRY COND_CASES_TAC THEN
    ASM_SIMP_TAC [ITERATE_CLAUSES, MONOIDAL_RING_MUL,
                  NOT_IN_EMPTY, EMPTY_GSPEC, FINITE_RESTRICT] THEN
    ASM_REWRITE_TAC [NEUTRAL_RING_MUL, ← GSYM ring_product,
                     IN_ELIM_THM, RING_PRODUCT])

  let RING_PRODUCT_SING ← prove
   r"!r (f:K->A) a.
       ring_product r {a} f = if f a IN ring_carrier r then f a else ring_1 r"
   (SIMP_TAC [RING_PRODUCT_CLAUSES, FINITE_EMPTY, NOT_IN_EMPTY, COND_SWAP] THEN
    MESON_TAC [RING_MUL_RID])

  let RING_PRODUCT_CLAUSES_NUMSEG_ALT ← prove
   r"(!r m f:num->A.
        ring_product r (m..0) f =
        if m = 0 /\ f 0 IN ring_carrier r then f 0 else ring_1 r) /\
   (!r m n f:num->A.
        ring_product r (m..SUC n) f =
        if m <= SUC n /\ f(SUC n) IN ring_carrier r
        then ring_mul r (f(SUC n)) (ring_product r (m..n) f)
        else ring_product r (m..n) f)"
   (REWRITE_TAC [NUMSEG_CLAUSES] THEN REPEAT STRIP_TAC THENL
     [ASM_CASES_TAC (← q "m = 0"), ASM_CASES_TAC (← q "m <= SUC n")] THEN
    ASM_REWRITE_TAC [RING_PRODUCT_SING, ← CONJUNCT1 RING_PRODUCT_CLAUSES] THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, FINITE_NUMSEG] THEN
    REWRITE_TAC [IN_NUMSEG, ← ARITH_RULE (← q "~(SUC n <= n)"), COND_SWAP])

  let RING_PRODUCT_CLAUSES_NUMSEG ← prove
   r"(!r m f:num->A.
        ring_product r (m..0) f =
        if m = 0 /\ f 0 IN ring_carrier r then f 0 else ring_1 r) /\
   (!r m n f:num->A.
        ring_product r (m..SUC n) f =
        if m <= SUC n /\ f(SUC n) IN ring_carrier r
        then ring_mul r (ring_product r (m..n) f) (f(SUC n))
        else ring_product r (m..n) f)"
   (REWRITE_TAC [RING_PRODUCT_CLAUSES_NUMSEG_ALT] THEN
    MESON_TAC [RING_MUL_SYM, RING_PRODUCT])

  let RING_PRODUCT_CLAUSES_LEFT ← prove
   r"!r (f:num->A) m n.
        m <= n
        ==> ring_product r (m..n) f =
            if f m IN ring_carrier r
            then ring_mul r (f m) (ring_product r (m+1..n) f)
            else ring_product r (m+1..n) f"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM NUMSEG_LREC, RING_PRODUCT_CLAUSES, FINITE_NUMSEG] THEN
    REWRITE_TAC [IN_NUMSEG, ← ARITH_RULE (← q "~(n + 1 <= n)"), COND_SWAP])

  let RING_PRODUCT_UNION ← prove
   r"!r (f:K->A) s t.
        FINITE s /\ FINITE t /\ DISJOINT s t
        ==> ring_product r (s UNION t) f =
            ring_mul r (ring_product r s f) (ring_product r t f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_product, UNION_RESTRICT] THEN
    wPart lhand (fun t => do lhand (← rand t)) (← MATCH_MP ITERATE_UNION
      (← ISPEC (← q "r:C ring") MONOIDAL_RING_MUL)) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_RESTRICT] THEN ASM SET_TAC [],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC []] THEN
    REWRITE_TAC [← GSYM ring_product, RING_PRODUCT])

  let RING_PRODUCT_INCL_EXCL ← prove
   r"!r (f:K->A) s t.
        FINITE s /\ FINITE t
        ==> ring_mul r (ring_product r s f) (ring_product r t f) =
            ring_mul r (ring_product r (s UNION t) f)
                       (ring_product r (s INTER t) f)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ring_product, INTER_RESTRICT, UNION_RESTRICT] THEN
    wPart (fun t => do rand (← rand t)) (funpowM 3 rand) (← MATCH_MP ITERATE_INCL_EXCL
      (← ISPEC (← q "r:C ring") MONOIDAL_RING_MUL)) THEN
    ASM_SIMP_TAC [FINITE_RESTRICT] THEN
    REWRITE_TAC [← GSYM INTER_RESTRICT, ← GSYM UNION_RESTRICT] THEN
    REWRITE_TAC [← GSYM ring_product, RING_PRODUCT])

  let RING_PRODUCT_CLOSED ← prove
   r"!r P (f:K->A) s.
        P(ring_1 r) /\
        (!x y. x IN ring_carrier r /\ y IN ring_carrier r /\ P x /\ P y
               ==> P(ring_mul r x y)) /\
        (!a. a IN s ==> P(f a))
        ==> P(ring_product r s f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_product] THEN
    MP_TAC (← ISPECL
     [← q r"\x:A. x IN ring_carrier r /\ P x",
      ← q r"f:K->A", ← q r"{a | a IN s /\ (f:K->A) a IN ring_carrier r}"]
     (← MATCH_MP (← REWRITE_RULE [RIGHT_IMP_FORALL_THM] ITERATE_CLOSED)
               (← ISPEC (← q "r:C ring") MONOIDAL_RING_MUL))) THEN
    ASM_SIMP_TAC [NEUTRAL_RING_MUL, IMP_IMP, RING_1, RING_MUL, IN_ELIM_THM])

  let RING_PRODUCT_RELATED ← prove
   r"!r R (f:K->A) g s.
        R (ring_1 r) (ring_1 r)/\
        (!x y x' y'. x IN ring_carrier r /\ y IN ring_carrier r /\
                     x' IN ring_carrier r /\ y' IN ring_carrier r /\
                     R x y /\ R x' y'
                     ==> R (ring_mul r x x') (ring_mul r y y')) /\
        FINITE s /\
        (!a. a IN s
             ==> (f a IN ring_carrier r <=> g a IN ring_carrier r) /\
                 R (f a) (g a))
        ==> R (ring_product r s f) (ring_product r s g)"
   (REPLICATE_TAC 4 GEN_TAC THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [FORALL_IN_INSERT, RING_PRODUCT_CLAUSES] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [COND_SWAP] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [RING_PRODUCT])

  let RING_PRODUCT_EQ_1 ← prove
   r"!r (f:K->A) s.
        (!a. a IN s /\ f a IN ring_carrier r ==> f a = ring_1 r)
        ==> ring_product r s f = ring_1 r"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM RING_PRODUCT_RESTRICT] THEN
    ONCE_REWRITE_TAC [← GSYM RING_PRODUCT_SUPPORT] THEN
    MATCH_MP_TAC (← MESON [RING_PRODUCT_CLAUSES]
     (← q "s = {} ==> ring_product r s f = ring_1 r")) THEN
    ASM SET_TAC [])

  let RING_PRODUCT_1 ← prove
   r"!r s. ring_product r s (\i:K. ring_1 r):A = ring_1 r"
   (SIMP_TAC [RING_PRODUCT_EQ_1])

  let RING_PRODUCT_0 ← prove
   r"!r s. ring_product r s (\i:K. ring_0 r):A =
         if s = {} \/ INFINITE s then ring_1 r else ring_0 r"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q "trivial_ring(r:A ring)") THENL
     [ASM_MESON_TAC [trivial_ring, IN_SING, RING_0, RING_1, RING_PRODUCT],
      RULE_ASSUM_TAC (REWRITE_RULE [TRIVIAL_RING_10])] THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:K->bool", ← q r"(\x. ring_0 r):K->A"]
          RING_PRODUCT_TRIVIAL) THEN
    ASM_REWRITE_TAC [RING_0, IN_GSPEC] THEN
    ASM_CASES_TAC (← q r"FINITE(s:K->bool)") THEN ASM_REWRITE_TAC [INFINITE] THEN
    UNDISCH_TAC (← q r"FINITE(s:K->bool)") THEN SPEC_TAC (← q r"s:K->bool", ← q r"s:K->bool") THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, RING_0, NOT_INSERT_EMPTY] THEN
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [RING_MUL_LZERO, RING_1, RING_0])

  let RING_PRODUCT_MUL ← prove
   r"!r (f:K->A) (g:K->A) s.
        FINITE s /\
        (!a. a IN s ==> f a IN ring_carrier r /\ g a IN ring_carrier r)
        ==> ring_product r s (\x. ring_mul r (f x) (g x)) =
            ring_mul r (ring_product r s f) (ring_product r s g)"
   (REPLICATE_TAC 3 GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, FORALL_IN_INSERT, RING_MUL] THEN
    ASM_SIMP_TAC [RING_MUL_AC, RING_PRODUCT, RING_MUL] THEN
    SIMP_TAC [RING_MUL_LID, RING_1])

  let RING_PRODUCT_EQ ← prove
   r"!r (f:K->A) g s.
       (!a. a IN s ==> f a = g a) ==> ring_product r s f = ring_product r s g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_product] THEN
    SUBGOAL_THEN
     (← q r"{a | a IN s /\ (g:K->A) a IN ring_carrier r} =
    {a | a IN s /\ (f:K->A) a IN ring_carrier r}")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← MATCH_MP ITERATE_EQ (← ISPEC (← q "r:C ring") MONOIDAL_RING_MUL)) THEN
    ASM SET_TAC [])

  let RING_PRODUCT_DELTA ← prove
   r"!r s (i:K) (a:A).
        ring_product r s (\j. if j = i then a else ring_1 r) =
        if i IN s /\ a IN ring_carrier r then a else ring_1 r"
   (← do
    -- right to left: the last SET_RULE first, the first TAUT last
    let s2 ← SET_RULE (← q r"i IN s ==> {j | j IN s /\ j = i} = {i}")
    let t2 ← TAUT (← q r"~((p /\ q) /\ ~q)")
    let s1 ← SET_RULE (← q r"~(i IN s) ==> {j | (j IN s /\ j = i /\ P j) /\ Q j} = {}")
    let t1 ← TAUT (← q r"(if p then q else T) <=> p ==> q")
    pure (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM RING_PRODUCT_SUPPORT] THEN
      ONCE_REWRITE_TAC [← GSYM RING_PRODUCT_RESTRICT] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [COND_RAND] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [COND_RATOR] THEN
      REWRITE_TAC [RING_1, NOT_IMP, t1] THEN
      ASM_CASES_TAC (← q "(i:K) IN s") THEN ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, s1] THEN
      ASM_CASES_TAC (← q "a:A = ring_1 r") THEN
      ASM_REWRITE_TAC [COND_ID, EMPTY_GSPEC, RING_PRODUCT_CLAUSES] THEN
      ASM_CASES_TAC (← q "(a:A) IN ring_carrier r") THEN
      ASM_SIMP_TAC [t2, EMPTY_GSPEC, RING_PRODUCT_CLAUSES] THEN
      ASM_SIMP_TAC [s2] THEN
      ASM_REWRITE_TAC [RING_PRODUCT_SING]))

  let RING_PRODUCT_CONST ← prove
   r"!r (x:A) (s:K->bool).
     FINITE s /\ x IN ring_carrier r
     ==> ring_product r s (\i. x) = ring_pow r x (CARD s)"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
    [REWRITE_TAC [RING_PRODUCT_CLAUSES, CARD_CLAUSES, ring_pow], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q "a:K", ← q r"t:K->bool"] THEN STRIP_TAC THEN
    DISCH_TAC THEN
    ASM_SIMP_TAC [RING_PRODUCT_CLAUSES, CARD_CLAUSES, ring_pow])

  let RING_PRODUCT_LMUL ← prove
   r"!r (x:A) (s:A->bool).
     FINITE s /\ x IN ring_carrier r /\
     (!y. y IN s ==> y IN ring_carrier r)
     ==> ring_product r s (\y. ring_mul r x y) =
         ring_mul r (ring_pow r x (CARD s)) (ring_product r s (\y. y))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"ring_product r s (\y:A. ring_mul r x y) =
     ring_mul r (ring_product r s (\y:A. x)) (ring_product r s (\y:A. y))")
    SUBST1_TAC THENL
    [MATCH_MP_TAC RING_PRODUCT_MUL THEN
     ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
     AP_THM_TAC THEN AP_TERM_TAC THEN
     MATCH_MP_TAC RING_PRODUCT_CONST THEN ASM_REWRITE_TAC []])

  let RING_PRODUCT_SWAP ← prove
   r"!r (f:K->L->A) s t.
        FINITE s /\ FINITE t /\
        (!i j. i IN s /\ j IN t ==> f i j IN ring_carrier r)
        ==> ring_product r s (\i. ring_product r t (f i)) =
            ring_product r t (\j. ring_product r s (\i. f i j))"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [FORALL_IN_INSERT, RING_PRODUCT_CLAUSES, RING_PRODUCT,
                  RING_PRODUCT_1, ← GSYM RING_PRODUCT_MUL] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_PRODUCT_EQ THEN ASM_SIMP_TAC [])

  let RING_PRODUCT_REFLECT ← prove
   r"!r (x:num->A) m n.
        (!i. m <= i /\ i <= n ==> x i IN ring_carrier r)
        ==> ring_product r (m..n) x =
            if n < m then ring_1 r
            else ring_product r (0..n-m) (\i. x(n - i))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"~(n < m)
    ==> !j. 0 <= j /\ j <= n - m ==> (x:num->A) (n - j) IN ring_carrier r")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [ring_product, IN_NUMSEG] THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | P x /\ f x IN s} = {x | P x /\ (P x ==> f x IN s)}")] THEN
    ASM_SIMP_TAC [] THEN REWRITE_TAC [← GSYM numseg] THEN
    MP_TAC (← ISPECL [← q r"x:num->A", ← q "m:num", ← q "n:num"]
     (← MATCH_MP ITERATE_REFLECT (← ISPEC (← q "r:C ring") MONOIDAL_RING_MUL))) THEN
    ASM_REWRITE_TAC [NEUTRAL_RING_MUL])

  let RING_PRODUCT_SUPERSET ← prove
   r"!r (f:K->A) u v.
        u SUBSET v /\ (!x. x IN v /\ ~(x IN u) ==> f x = ring_1 r)
        ==> ring_product r v f = ring_product r u f"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM RING_PRODUCT_SUPPORT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let RING_PRODUCT_RESTRICT_SET ← prove
   r"!P r s (f:K->A).
        ring_product r {x | x IN s /\ P x} f =
        ring_product r s (\x. if P x then f x else ring_1 r)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"ring_product r s' f = ring_product r s' f' /\
    ring_product r s f' = ring_product r s' f'
    ==> ring_product r s' f = ring_product r s f'")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_PRODUCT_EQ THEN SET_TAC [],
      MATCH_MP_TAC RING_PRODUCT_SUPERSET THEN
      SIMP_TAC [IN_ELIM_THM, SUBSET_RESTRICT] THEN MESON_TAC []])

  let RING_PRODUCT_CASES ← prove
   r"!r s P (f:K->A) g.
        FINITE s
        ==> ring_product r s (\x. if P x then f x else g x) =
            ring_mul r (ring_product r {x | x IN s /\ P x} f)
                       (ring_product r {x | x IN s /\ ~P x} g)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "r:A ring", ← q r"\x. if P x then (f:K->A) x else g x",
                      ← q r"{x:K | x IN s /\ P x}", ← q r"{x:K | x IN s /\ ~P x}"]
          RING_PRODUCT_UNION) THEN
    ANTS_TAC THENL [ASM_SIMP_TAC [FINITE_RESTRICT] THEN SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
     [AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [],
      BINOP_TAC THEN MATCH_MP_TAC RING_PRODUCT_EQ THEN SET_TAC []])

  let RING_PRODUCT_IMAGE ← prove
   r"!r (f:K->L) (g:L->A) s.
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> ring_product r (IMAGE f s) g = ring_product r s (g o f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_product] THEN
    wPart rand (fun t => do rand (← rand t))
     (← MATCH_MP ITERATE_IMAGE (← ISPEC (← q "r:C ring") MONOIDAL_RING_MUL)) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [o_THM] THEN ASM SET_TAC [])

  let RING_PRODUCT_EQ_GENERAL_INVERSES ← prove
   r"!r s t (f:K->A) (g:L->A) h k.
        (!y. y IN t ==> k y IN s /\ h (k y) = y) /\
        (!x. x IN s ==> h x IN t /\ k (h x) = x /\ g (h x) = f x)
        ==> ring_product r s f = ring_product r t g"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS (← q r"ring_product r s ((g:L->A) o (h:K->L))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_PRODUCT_EQ THEN ASM_SIMP_TAC [o_THM],
      wPart lhand (fun t => do rand (← rand t)) RING_PRODUCT_IMAGE THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let RING_PRODUCT_OFFSET ← prove
   r"!p r (f:num->A) m n.
        ring_product r (m+p..n+p) f = ring_product r (m..n) (\i. f(i + p))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [NUMSEG_OFFSET_IMAGE] THEN
    MATCH_MP_TAC (← REWRITE_RULE [o_DEF] RING_PRODUCT_IMAGE) THEN
    SIMP_TAC [EQ_ADD_RCANCEL])

  let RING_PRODUCT_IMAGE_GEN ← prove
   r"!r (f:K->B) (g:K->A) s.
         FINITE s
         ==> ring_product r s g =
             ring_product r (IMAGE f s)
                            (\y. ring_product r {x | x IN s /\ f x = y} g)"
   (← do
    -- right to left: the SET_RULE first, then the TAUT
    let s1 ← SET_RULE (← q r"(x IN s /\ f x = a) /\ P x <=>
                        x IN {x | x IN s /\ f x = a} /\ P x")
    let t1 ← TAUT (← q r"(x IN s /\ y IN t) /\ a = b <=> (x IN s /\ a = b) /\ y IN t")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [ring_product] THEN
      MP_TAC (← ISPECL
       [← q r"f:K->B", ← q r"g:K->A", ← q r"{x | x IN s /\ (g:K->A) x IN ring_carrier r}"]
        (← MATCH_MP ITERATE_IMAGE_GEN (← ISPEC (← q "r:C ring") MONOIDAL_RING_MUL))) THEN
      ANTS_TAC THENL [ASM_SIMP_TAC [FINITE_RESTRICT], DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [IN_ELIM_THM, t1] THEN
      CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
            ITERATE_SUPERSET) THEN
      REWRITE_TAC [MONOIDAL_RING_MUL] THEN
      REWRITE_TAC [s1] THEN
      REWRITE_TAC [← GSYM ring_product, RING_PRODUCT, NEUTRAL_RING_MUL] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IMP_CONJ, FORALL_IN_IMAGE] THEN
      SIMP_TAC [FUN_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC RING_PRODUCT_EQ_1 THEN ASM SET_TAC []))

  let RING_PRODUCT_NSUM ← prove
   r"!(r:A ring) s (e:K->num) a.
      FINITE s /\ a IN ring_carrier r
      ==> ring_pow r a (nsum s e) = ring_product r s (\i. ring_pow r a (e i))"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
    [SIMP_TAC [RING_PRODUCT_CLAUSES, NSUM_CLAUSES, RING_POW_0],
     ASM_SIMP_TAC [RING_POW_ADD, NSUM_CLAUSES, RING_PRODUCT_CLAUSES, RING_POW]])

  -- `let th = prove (...) in extend_basic_congs [SPEC_ALL th]`
  do
    let th ← prove
     r"!r (f:K->A) g s.
    (!a. a IN s ==> f a = g a)
    ==> ring_product r s (\i. f i) = ring_product r s g"
     (REWRITE_TAC [ETA_AX, RING_PRODUCT_EQ])
    extend_basic_congs [← SPEC_ALL th]

  -- @@RETURN BEGIN
  return { ring_product, NEUTRAL_RING_MUL, MONOIDAL_RING_MUL, RING_PRODUCT,
           RING_PRODUCT_RESTRICT, RING_PRODUCT_SUPPORT, RING_PRODUCT_TRIVIAL,
           RING_PRODUCT_CLAUSES, RING_PRODUCT_SING, RING_PRODUCT_CLAUSES_NUMSEG_ALT,
           RING_PRODUCT_CLAUSES_NUMSEG, RING_PRODUCT_CLAUSES_LEFT, RING_PRODUCT_UNION,
           RING_PRODUCT_INCL_EXCL, RING_PRODUCT_CLOSED, RING_PRODUCT_RELATED,
           RING_PRODUCT_EQ_1, RING_PRODUCT_1, RING_PRODUCT_0, RING_PRODUCT_MUL,
           RING_PRODUCT_EQ, RING_PRODUCT_DELTA, RING_PRODUCT_CONST, RING_PRODUCT_LMUL,
           RING_PRODUCT_SWAP, RING_PRODUCT_REFLECT, RING_PRODUCT_SUPERSET,
           RING_PRODUCT_RESTRICT_SET, RING_PRODUCT_CASES, RING_PRODUCT_IMAGE,
           RING_PRODUCT_EQ_GENERAL_INVERSES, RING_PRODUCT_OFFSET, RING_PRODUCT_IMAGE_GEN,
           RING_PRODUCT_NSUM }
  -- @@RETURN END

