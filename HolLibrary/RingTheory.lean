      [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q "(b:A) IN ring_carrier r") ASSUME_TAC THENL
      [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"ring_localequiv r (s:A->bool) (x,ring_1 r) (a,b)") MP_TAC THENL
      [MP_TAC (← ISPECL [← q "r:A ring", ← q r"s:A->bool", ← q "x:A", ← q "ring_1 r:A",
                        ← q "a:A", ← q "b:A"]
        RING_LOCALEQUIV_EQUIV) THEN
       ASM_REWRITE_TAC [RING_1] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
       ASM_REWRITE_TAC [],
       ALL_TAC] THEN
      ASM_SIMP_TAC [RING_LOCALEQUIV, RING_1] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "u:A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q "ring_mul r u (b:A)") THEN CONJ_TAC THENL
       [ASM_MESON_TAC [ring_multsys], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"ring_mul r (ring_mul r u b) (x:A) =
                  ring_mul r u (ring_mul r a (ring_1 r))") MP_TAC THENL
      [MP_TAC (← RING_RULE
        (← q r"ring_mul r u (ring_sub r (ring_mul r x b) (ring_mul r a (ring_1 r))):A =
