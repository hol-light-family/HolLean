  RING_IRREDUCIBLE_IMP_MAXIMAL_PRINCIPAL_IDEAL : thm
  RING_IRREDUCIBLE_EQ_MAXIMAL_PRINCIPAL_IDEAL : thm
  MAXIMAL_IDEAL_SING_IMP_IRREDUCIBLE : thm
