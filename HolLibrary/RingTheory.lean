   (SIMP_TAC [ring_epimorphism, IMAGE_o] THEN
    MESON_TAC [RING_HOMOMORPHISM_COMPOSE])

  let RING_EPIMORPHISM_COMPOSE_REV ← prove
   r"!(f:A->B) (g:B->C) A B C.
        ring_homomorphism(A,B) f /\ ring_homomorphism(B,C) g /\
