  RING_SETADD_ASSOC : thm
  RING_SETMUL_ASSOC : thm
  RING_SETADD_AC : thm
  RING_SETMUL_AC : thm
  RING_SETADD_SUPERSET_LEFT : thm
  RING_SETADD_SUPERSET_RIGHT : thm
  RING_SETNEG_SETADD : thm
  RING_SETADD_LDISTRIB : thm
  RING_SETADD_RDISTRIB : thm
  RING_SETNEG_IDEAL : thm
  RING_SETNEG_SUBRING : thm
  RING_SETADD_LSUBSET : thm
  RING_SETADD_RSUBSET : thm
  RING_SETADD_LSUBSET_EQ : thm
  RING_SETADD_RSUBSET_EQ : thm
