                      ← q r"m:(B#num) ring"]
      GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_NORMAL) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN,
                  ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD] THEN
    REWRITE_TAC [BIJ, SURJ] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"RESTRICTION (ring_carrier l) (e:B->B#num)") o
               CONJUNCT2 o CONJUNCT2) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS THEN
      ASM_REWRITE_TAC [o_THM],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:B->B") (CONJUNCTS_THEN2 ASSUME_TAC
      (MP_TAC o flip AP_THM (← q r"x:B")))) THEN
    ASM_REWRITE_TAC [RESTRICTION, o_THM] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"f:B->B") THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"ring_monomorphism(l:B ring,m) (j:B->B#num)"
      if !(concl th == c) then throw "check"
      pure ((MATCH_MP_TAC o CONJUNCT2 o
             GEN_REWRITE_RULE I [ring_monomorphism]) th)) THEN
    ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_IN_IMAGE])

  let GALOIS_GROUP_ORBIT_FINITE ← prove
   r"!(h:A->B) k l x.
        algebraic_extension(k,l) h /\ x IN ring_carrier l
        ==> FINITE {f x | f IN group_carrier(galois_group(k,l) h)}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(h:A->B) o minimal_polynomial(k,l) h x IN ring_carrier(poly_ring l (:1))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER],
      ALL_TAC] THEN
    MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC (← q r"{y | y IN ring_carrier l /\
                   poly_eval l ((h:A->B) o minimal_polynomial(k,l) h x) y =
                   ring_0 l}") THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"l:B ring", ← q r"(h:A->B) o minimal_polynomial(k,l) h x"]
        POLY_ROOT_BOUND) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, POLY_RING_CLAUSES] THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      ASM_MESON_TAC [POLY_EQ_0_MONOMORPHIC_IMAGE, RING_POLYNOMIAL,
                     MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_NONZERO],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN CONJ_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_IN_IMAGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"minimal_polynomial(k,l) (h:A->B) x", ← q r"x:B"]
      GALOIS_GROUP_POLY_EVAL) THEN
    ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"l:B ring",
                      ← q r"x:B"] MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [RING_HOMOMORPHISM_I, I_O_ID, I_THM] THEN
    DISCH_THEN SUBST1_TAC THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_0 THEN
    ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM])

  -- @@RETURN BEGIN
  return { GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_GEN,
           GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS,
           GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_NORMAL, CARD_GALOIS_GROUP_LE,
           FINITE_GALOIS_GROUP, CARD_GALOIS_GROUP_LE_SEPARABLE_DEGREE,
           NORMAL_EXTENSION_EQ_CARD_GALOIS_GROUP, GALOIS_GROUP_ORBIT,
           GALOIS_GROUP_ORBIT_FINITE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Galois extensions: normal and separable. A finite extension is Galois     -/
/- exactly when its Galois group has [l:k] elements, and exactly when it is  -/
/- the splitting extension of a separable polynomial.                        -/
/- ------------------------------------------------------------------------- -/

structure GaloisExtension where
  -- @@FIELDS
  galois_extension : thm
  GALOIS_IMP_NORMAL_EXTENSION : thm
  GALOIS_IMP_SEPARABLE_EXTENSION : thm
  GALOIS_IMP_ALGEBRAIC_EXTENSION : thm
  GALOIS_IMP_FIELD_EXTENSION : thm
  GALOIS_EXTENSION_REFL : thm
  GALOIS_EXTENSION_ISOMORPHISM : thm
  GALOIS_EXTENSION_EQ_CARD : thm
  GALOIS_EXTENSION_INTERMEDIATE : thm
  GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisExtension [HolBase] (D : GaloisDeps) (BGaloisExtensions : GaloisExtensions) :
    ExceptT String IO GaloisExtension := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { FIELD_ALGEBRAIC_EXTENSION, FIELD_IMP_INTEGRAL_DOMAIN,
        FINITE_IMP_FIELD_EXTENSION, .. } := D.core1
  let { IN_ELIM_THM, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, I_O_ID, I_THM,
        MINIMAL_POLYNOMIAL, MINIMAL_POLYNOMIAL_DIVIDES, MINIMAL_POLYNOMIAL_IN_CARRIER,
        MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE,
        NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT, NORMAL_EXTENSION_INTERMEDIATE,
        NORMAL_EXTENSION_ISOMORPHISM, NORMAL_EXTENSION_REFL,
        NORMAL_IMP_ALGEBRAIC_EXTENSION, NORMAL_IMP_FIELD_EXTENSION,
        POLY_EQ_0_MONOMORPHIC_IMAGE, POLY_EXTEND_EVALUATE, POLY_RING_CLAUSES,
        POLY_ROOT_BOUND, POLY_SEPARABLE_DIVISOR, .. } := D.core2
  let { PRIMITIVE_ELEMENT_THEOREM, RING_HOMOMORPHISM_I,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_POLYNOMIAL, .. } := D.core3
  let { SEPARABLE_DEGREE_EQ_EXTENSION_DEGREE, SEPARABLE_DEGREE_LE_EXTENSION_DEGREE,
        SEPARABLE_EXTENSION_GENERATED_BY_SEPARABLE, SEPARABLE_EXTENSION_INTERMEDIATE,
        SEPARABLE_EXTENSION_ISOMORPHISM, SEPARABLE_EXTENSION_REFL,
        SPLITTING_EXTENSION_IMP_NORMAL, SPLITTING_IMP_ALGEBRAIC_EXTENSION,
        SPLITTING_IMP_FINITE_EXTENSION, SUBFIELD_GENERATED_SUPERSET,
        SUBRING_EQ_SUBFIELD_GENERATED, SUBRING_GENERATED_MONO,
        SUBRING_SUBSET_SUBFIELD_GENERATED, SUBSET_TRANS, algebraic_extension,
        field_extension, poly_eval, separable_element, separable_extension,
        splitting_extension, .. } := D.core4
  let { CARD_GALOIS_GROUP_LE_SEPARABLE_DEGREE, NORMAL_EXTENSION_EQ_CARD_GALOIS_GROUP, .. } := BGaloisExtensions
  -- @@SCOPE END

  let galois_extension ← new_definition
   r"galois_extension (k:A ring,l:B ring) (h:A->B) <=>
        normal_extension (k,l) h /\ separable_extension (k,l) h"

  let GALOIS_IMP_NORMAL_EXTENSION ← prove
   r"!(h:A->B) k l. galois_extension(k,l) h ==> normal_extension(k,l) h"
   (SIMP_TAC [galois_extension])

  let GALOIS_IMP_SEPARABLE_EXTENSION ← prove
   r"!(h:A->B) k l. galois_extension(k,l) h ==> separable_extension(k,l) h"
   (SIMP_TAC [galois_extension])

  let GALOIS_IMP_ALGEBRAIC_EXTENSION ← prove
   r"!(h:A->B) k l. galois_extension(k,l) h ==> algebraic_extension(k,l) h"
   (SIMP_TAC [galois_extension, NORMAL_IMP_ALGEBRAIC_EXTENSION])

  let GALOIS_IMP_FIELD_EXTENSION ← prove
   r"!(h:A->B) k l. galois_extension(k,l) h ==> field_extension(k,l) h"
   (SIMP_TAC [galois_extension, NORMAL_IMP_FIELD_EXTENSION])

  let GALOIS_EXTENSION_REFL ← prove
   r"!k:A ring. galois_extension(k,k) I <=> field k"
   (REWRITE_TAC [galois_extension, NORMAL_EXTENSION_REFL,
                 SEPARABLE_EXTENSION_REFL])

  let GALOIS_EXTENSION_ISOMORPHISM ← prove
   r"!(f:A->B) k l.
        (field k \/ field l) /\ ring_isomorphism(k,l) f
        ==> galois_extension(k,l) f"
   (SIMP_TAC [galois_extension, NORMAL_EXTENSION_ISOMORPHISM,
              SEPARABLE_EXTENSION_ISOMORPHISM])

  let GALOIS_EXTENSION_EQ_CARD ← prove
   r"!(h:A->B) k l.
        finite_extension(k,l) h
        ==> (galois_extension(k,l) h <=>
             CARD(group_carrier(galois_group(k,l) h)) =
             extension_degree(k,l) h)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [galois_extension] THEN
    ASM_SIMP_TAC [NORMAL_EXTENSION_EQ_CARD_GALOIS_GROUP,
                  ← GSYM SEPARABLE_DEGREE_EQ_EXTENSION_DEGREE] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      CARD_GALOIS_GROUP_LE_SEPARABLE_DEGREE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      SEPARABLE_DEGREE_LE_EXTENSION_DEGREE) THEN
    ASM_REWRITE_TAC [] THEN ARITH_TAC)

  let GALOIS_EXTENSION_INTERMEDIATE ← prove
   r"!(f:A->B) (g:B->C) k l m.
        field_extension(k,l) f /\ field_extension(l,m) g /\
        galois_extension(k,m) (g o f)
        ==> galois_extension(l,m) g"
   (REWRITE_TAC [galois_extension] THEN
    MESON_TAC [NORMAL_EXTENSION_INTERMEDIATE, SEPARABLE_EXTENSION_INTERMEDIATE])

  let GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING ← prove
   r"!(h:A->B) k l.
        finite_extension(k,l) h /\ galois_extension(k,l) h <=>
        ?p. poly_separable k p /\ splitting_extension(k,l) h p"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [galois_extension] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
        PRIMITIVE_ELEMENT_THEOREM) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:B") (CONJUNCTS_THEN2 ASSUME_TAC
        (ASSUME_TAC o AP_TERM (← q r"ring_carrier:B ring->B->bool")))) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
      SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) a") ASSUME_TAC THENL
       [ASM_MESON_TAC [algebraic_extension, NORMAL_IMP_ALGEBRAIC_EXTENSION],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"minimal_polynomial(k,l) (h:A->B) a") THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [separable_extension, separable_element], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
        MINIMAL_POLYNOMIAL) THEN
      ASM_REWRITE_TAC [splitting_extension] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"l:B ring",
                        ← q r"a:B"] MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [RING_HOMOMORPHISM_I, I_O_ID, I_THM] THEN DISCH_TAC THEN
      REWRITE_TAC [SUBFIELD_GENERATED_SUPERSET] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"ring_carrier(l:B ring)"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure (GEN_REWRITE_TAC LAND_CONV [← SYM th])) THEN
      TRANS_TAC SUBSET_TRANS
       (← q r"ring_carrier(subring_generated l
       (IMAGE (h:A->B) (ring_carrier k) UNION
        {x | x IN ring_carrier l /\
             poly_eval l (h o minimal_polynomial (k,l) h a) x =
             ring_0 l}))") THEN
      REWRITE_TAC [SUBRING_SUBSET_SUBFIELD_GENERATED] THEN
      MATCH_MP_TAC SUBRING_GENERATED_MONO THEN ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:(1->num)->A") STRIP_ASSUME_TAC)] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_IMP_ALGEBRAIC_EXTENSION) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [splitting_extension]) THEN
    ABBREV_TAC
     (← q r"R = {x | x IN ring_carrier l /\
             poly_eval l ((h:A->B) o (p:(1->num)->A)) x = ring_0 l}") THEN
    STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    REWRITE_TAC [galois_extension] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [SPLITTING_IMP_FINITE_EXTENSION],
      ASM_MESON_TAC [SPLITTING_EXTENSION_IMP_NORMAL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(h:A->B) o (p:(1->num)->A) IN ring_carrier(poly_ring l (:1))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"FINITE(R:B->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "R" THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"(h:A->B) o (p:(1->num)->A)"]
        POLY_ROOT_BOUND) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, POLY_RING_CLAUSES] THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      ASM_MESON_TAC [POLY_EQ_0_MONOMORPHIC_IMAGE, RING_POLYNOMIAL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!x. x IN R ==> algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
     [EXPAND_TAC "R" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      ASM_MESON_TAC [algebraic_extension],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!x. x IN R ==> separable_element(k,l) (h:A->B) x")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
       [ASM_SIMP_TAC [], ALL_TAC] THEN
      UNDISCH_TAC (← q r"(x:B) IN R") THEN EXPAND_TAC "R" THEN
      REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      REWRITE_TAC [separable_element] THEN MATCH_MP_TAC POLY_SEPARABLE_DIVISOR THEN
      EXISTS_TAC (← q r"p:(1->num)->A") THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_DIVIDES] THEN
      ASM_SIMP_TAC [POLY_EXTEND_EVALUATE, RING_MONOMORPHISM_IMP_HOMOMORPHISM] THEN
      ASM_REWRITE_TAC [← GSYM poly_eval],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"R:B->bool"]
      SEPARABLE_EXTENSION_GENERATED_BY_SEPARABLE) THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"subring_generated l (IMAGE (h:A->B) (ring_carrier k) UNION R) = l")
     (fun th => REWRITE_TAC [th]) THEN
    ASM_MESON_TAC [SUBRING_EQ_SUBFIELD_GENERATED, FIELD_ALGEBRAIC_EXTENSION])

  -- @@RETURN BEGIN
  return { galois_extension, GALOIS_IMP_NORMAL_EXTENSION, GALOIS_IMP_SEPARABLE_EXTENSION,
           GALOIS_IMP_ALGEBRAIC_EXTENSION, GALOIS_IMP_FIELD_EXTENSION,
           GALOIS_EXTENSION_REFL, GALOIS_EXTENSION_ISOMORPHISM, GALOIS_EXTENSION_EQ_CARD,
           GALOIS_EXTENSION_INTERMEDIATE, GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Fixed fields. The fixed field of a set G of maps is the set of elements   -/
/- of l fixed by all of them; for endomorphisms of a field it is a subfield, -/
/- used as a ring through subfield_generated l (fixed_field l G) with I.     -/
/- ------------------------------------------------------------------------- -/

structure FixedFields where
  -- @@FIELDS
  fixed_field : thm
  IN_FIXED_FIELD : thm
  FIXED_FIELD_SUBSET : thm
  SUBFIELD_OF_FIXED_FIELD : thm
  FIXED_FIELD_ANTIMONO : thm
  FIXED_FIELD_EMPTY : thm
  FIXED_FIELD_UNION : thm
  IMAGE_SUBSET_FIXED_FIELD_GALOIS_GROUP : thm
  FIXED_FIELD_GALOIS_SUBSET : thm
  SUBSET_GALOIS_GROUP_FIXED_FIELD : thm
  deriving Inhabited

@[nospecialize]
def setupFixedFields [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) :
    ExceptT String IO FixedFields := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_ELIM_THM, I_THM, NOT_IN_EMPTY, .. } := D.core2
  let { RING_AUTOMORPHISM_IMP_ENDOMORPHISM, RING_HOMOMORPHISM_IN_CARRIER,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core3
  let { SUBFIELD_OF_COMMON_FIXPOINTS, SUBSET, SUBSET_TRANS, field_extension,
        ring_endomorphism, .. } := D.core4
  let { GALOIS_GROUP_FIXES, GALOIS_GROUP_RING_HOMOMORPHISM, IN_GALOIS_GROUP, .. } := BGaloisGroup
  -- @@SCOPE END

  let fixed_field ← new_definition
   r"fixed_field (l:B ring) (G:(B->B)->bool) =
        {x | x IN ring_carrier l /\ !f. f IN G ==> f x = x}"

  let IN_FIXED_FIELD ← prove
   r"!(l:B ring) G x.
        x IN fixed_field l G <=>
        x IN ring_carrier l /\ !f. f IN G ==> f x = x"
   (REWRITE_TAC [fixed_field, IN_ELIM_THM])

  let FIXED_FIELD_SUBSET ← prove
   r"!(l:B ring) G. fixed_field l G SUBSET ring_carrier l"
   (SIMP_TAC [fixed_field, SUBSET, IN_ELIM_THM])

  let SUBFIELD_OF_FIXED_FIELD ← prove
   r"!(l:B ring) G.
        field l /\ (!f. f IN G ==> ring_endomorphism l f)
        ==> fixed_field l G subfield_of l"
   (REWRITE_TAC [fixed_field] THEN MATCH_ACCEPT_TAC SUBFIELD_OF_COMMON_FIXPOINTS)

  let FIXED_FIELD_ANTIMONO ← prove
   r"!(l:B ring) G H. G SUBSET H ==> fixed_field l H SUBSET fixed_field l G"
   (REWRITE_TAC [fixed_field] THEN SET_TAC [])

  let FIXED_FIELD_EMPTY ← prove
   r"!l:B ring. fixed_field l {} = ring_carrier l"
   (REWRITE_TAC [fixed_field, NOT_IN_EMPTY] THEN SET_TAC [])

  let FIXED_FIELD_UNION ← prove
   r"!(l:B ring) G H.
        fixed_field l (G UNION H) = fixed_field l G INTER fixed_field l H"
   (REWRITE_TAC [fixed_field] THEN SET_TAC [])

  let IMAGE_SUBSET_FIXED_FIELD_GALOIS_GROUP ← prove
   r"!(h:A->B) k l.
        ring_homomorphism(k,l) h
        ==> IMAGE h (ring_carrier k) SUBSET
            fixed_field l (group_carrier(galois_group(k,l) h))"
   (REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_FIXED_FIELD] THEN
    MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER, GALOIS_GROUP_FIXES])

  let FIXED_FIELD_GALOIS_SUBSET ← prove
   r"!(h:A->B) k l H.
        field_extension(k,l) h /\ H SUBSET group_carrier(galois_group(k,l) h)
        ==> fixed_field l H subfield_of l /\
            IMAGE h (ring_carrier k) SUBSET fixed_field l H"
   (REPEAT GEN_TAC THEN REWRITE_TAC [field_extension] THEN STRIP_TAC THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUBFIELD_OF_FIXED_FIELD THEN
      ASM_MESON_TAC [SUBSET, GALOIS_GROUP_RING_HOMOMORPHISM,
                     ring_endomorphism],
      TRANS_TAC SUBSET_TRANS
       (← q r"fixed_field l (group_carrier(galois_group(k,l) (h:A->B)))") THEN
      ASM_SIMP_TAC [FIXED_FIELD_ANTIMONO,
                    IMAGE_SUBSET_FIXED_FIELD_GALOIS_GROUP,
                    RING_MONOMORPHISM_IMP_HOMOMORPHISM]])

  let SUBSET_GALOIS_GROUP_FIXED_FIELD ← prove
   r"!(l:B ring) G.
        field l /\
        (!f. f IN G ==> f permutes ring_carrier l /\ ring_automorphism l f)
        ==> G SUBSET
            group_carrier
             (galois_group(subfield_generated l (fixed_field l G),l) I)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"ring_carrier(subfield_generated l (fixed_field l G)) =
    fixed_field (l:B ring) G")
    ASSUME_TAC THENL
     [MATCH_MP_TAC CARRIER_SUBFIELD_GENERATED_SUBFIELD THEN
      MATCH_MP_TAC SUBFIELD_OF_FIXED_FIELD THEN
      ASM_MESON_TAC [RING_AUTOMORPHISM_IMP_ENDOMORPHISM],
      ALL_TAC] THEN
    ASM_SIMP_TAC [SUBSET, IN_GALOIS_GROUP, I_THM, IN_FIXED_FIELD])

  -- @@RETURN BEGIN
  return { fixed_field, IN_FIXED_FIELD, FIXED_FIELD_SUBSET, SUBFIELD_OF_FIXED_FIELD,
           FIXED_FIELD_ANTIMONO, FIXED_FIELD_EMPTY, FIXED_FIELD_UNION,
           IMAGE_SUBSET_FIXED_FIELD_GALOIS_GROUP, FIXED_FIELD_GALOIS_SUBSET,
           SUBSET_GALOIS_GROUP_FIXED_FIELD }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Artin: a finite group G of automorphisms of a field l is the Galois group -/
/- of l over its fixed field, of degree CARD G. The proof follows Lang       -/
/- (Algebra, VI 1.8): the polynomial with simple roots the G-orbit of an     -/
/- element a has its coefficients in the fixed field, so a is separable over -/
/- the fixed field with split minimal polynomial of degree at most CARD G.   -/
/- The same argument for the full Galois group of an algebraic extension     -/
/- characterizes Galois extensions by their fixed field.                     -/
/- ------------------------------------------------------------------------- -/

structure Artin where
  -- @@FIELDS
  RING_PRODUCT_X_MINUS_A_IN_FIXED_FIELD : thm
  MINIMAL_POLYNOMIAL_FINITE_ORBIT : thm
  ARTIN_FIXED_FIELD : thm
  GALOIS_EXTENSION_FIXED_FIELD_FINITE_ORBITS : thm
  GALOIS_EXTENSION_EQ_FIXED_FIELD : thm
  FIXED_FIELD_GALOIS_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupArtin [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BFixedFields : FixedFields) :
    ExceptT String IO Artin := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, CARD_IMAGE_LE, CARD_SING, CARD_SUBSET,
        CARD_SUBSET_EQ, CARRIER_SUBFIELD_GENERATED_SUBFIELD, EQ_TRANS, EXTENSION,
        FIELD_EXTENSION_SUBFIELD_GENERATED, FIELD_IMP_INTEGRAL_DOMAIN,
        FIELD_IMP_NONTRIVIAL_RING, FINITE_IMAGE, FORALL_IN_GSPEC, GROUP_ID, .. } := D.core1
  let { IMAGE_I, IN_ELIM_THM, IN_IMAGE, IN_POLY_RING_CARRIER, IN_SING, I_THM, LE_REFL,
        LE_TRANS, MINIMAL_POLYNOMIAL_DEG_EQ_1, MINIMAL_POLYNOMIAL_DEG_LE,
        MINIMAL_POLYNOMIAL_DIVIDES, MINIMAL_POLYNOMIAL_IN_CARRIER,
        MINIMAL_POLYNOMIAL_NONZERO, MONIC_IMP_NONZERO,
        NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT, PERMUTES_INVERSES,
        PERMUTES_IN_IMAGE, POLY_COMPOSE_HOMOMORPHISM_CONST,
        POLY_COMPOSE_HOMOMORPHISM_SUB, POLY_COMPOSE_HOMOMORPHISM_VAR,
        POLY_DEG_MONOMORPHIC_IMAGE, POLY_EQ_0_MONOMORPHIC_IMAGE, POLY_EXTEND_EVALUATE,
        POLY_RING_CLAUSES, POLY_RING_MONOMORPHIC_PREIMAGE, POLY_SEPARABLE_DIVISOR, .. } := D.core2
  let { POLY_SPLITS_DIVISOR, POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT_EQ,
        POLY_X_MINUS_A_IN_CARRIER, RING_AUTOMORPHISM_IMP_ENDOMORPHISM,
        RING_DIVIDES_HOMOMORPHIC_IMAGE, RING_HOMOMORPHISM_POLY_RINGS,
        RING_HOMOMORPHISM_PRODUCT, RING_ISOMORPHISM, RING_ISOMORPHISM_IMP_HOMOMORPHISM,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_POLYNOMIAL, RING_POWERSERIES_CONST,
        RING_POWERSERIES_VAR, RING_PRODUCT, RING_PRODUCT_EQ, RING_PRODUCT_IMAGE,
        RING_PRODUCT_X_MINUS_A, .. } := D.core3
  let { SEPARABLE_EXTENSION_BOUNDED_DEGREE, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM,
        SUBSET_REFL, SYMMETRIC_GROUP, algebraic_extension, algebraic_over,
        field_extension, o_DEF, o_THM, poly_eval, poly_splits_over, ring_automorphism,
        ring_polynomial, ring_powerseries, separable_element, separable_extension,
        subgroup_of, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_RING_AUTOMORPHISM, GALOIS_GROUP_SUBGROUP, .. } := BGaloisGroup
  let { CARD_GALOIS_GROUP_LE, GALOIS_GROUP_ORBIT, GALOIS_GROUP_ORBIT_FINITE, .. } := BGaloisExtensions
  let { GALOIS_IMP_ALGEBRAIC_EXTENSION, GALOIS_IMP_NORMAL_EXTENSION,
        GALOIS_IMP_SEPARABLE_EXTENSION, galois_extension, .. } := BGaloisExtension
  let { IMAGE_SUBSET_FIXED_FIELD_GALOIS_GROUP, IN_FIXED_FIELD, SUBFIELD_OF_FIXED_FIELD,
        SUBSET_GALOIS_GROUP_FIXED_FIELD, .. } := BFixedFields
  -- @@SCOPE END

  let RING_PRODUCT_X_MINUS_A_IN_FIXED_FIELD ← prove
   r"!(l:B ring) G s.
        (!f. f IN G ==> ring_automorphism l f /\ IMAGE f s = s) /\
        FINITE s /\ s SUBSET ring_carrier l
        ==> !m. ring_product (poly_ring l (:1)) s
                  (\b. poly_sub l (poly_var l one) (poly_const l b)) m
                IN fixed_field l G"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"P = ring_product (poly_ring l (:1)) s
     (\b. poly_sub l (poly_var l one) (poly_const (l:B ring) b))") THEN
    SUBGOAL_THEN (← q r"P IN ring_carrier(poly_ring (l:B ring) (:1))") ASSUME_TAC THENL
     [EXPAND_TAC "P" THEN REWRITE_TAC [RING_PRODUCT], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!f:B->B. f IN G ==> f o P = (P:(1->num)->B)") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"ring_homomorphism(l,l) (f:B->B)") ASSUME_TAC THENL
       [ASM_MESON_TAC [ring_automorphism, RING_ISOMORPHISM_IMP_HOMOMORPHISM],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"f:B->B", ← q r"(:1)"]
        RING_HOMOMORPHISM_POLY_RINGS) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o ISPECL
       [← q r"\b. poly_sub l (poly_var l one) (poly_const (l:B ring) b)",
        ← q r"s:B->bool"] o MATCH_MP RING_HOMOMORPHISM_PRODUCT) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC POLY_X_MINUS_A_IN_CARRIER THEN ASM SET_TAC [],
        ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN EXPAND_TAC "P" THEN
      TRANS_TAC EQ_TRANS
       (← q r"ring_product (poly_ring l (:1)) s
        (\b. poly_sub l (poly_var l one)
                        (poly_const (l:B ring) ((f:B->B) b)))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC RING_PRODUCT_EQ THEN X_GEN_TAC (← q r"b:B") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(b:B) IN ring_carrier l") ASSUME_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        REWRITE_TAC [o_THM] THEN
        MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"f:B->B",
                          ← q r"poly_var (l:B ring) (one:1)",
                          ← q r"poly_const (l:B ring) (b:B):(1->num)->B"]
          POLY_COMPOSE_HOMOMORPHISM_SUB) THEN
        ASM_REWRITE_TAC [RING_POWERSERIES_VAR, RING_POWERSERIES_CONST] THEN
        DISCH_THEN SUBST1_TAC THEN BINOP_TAC THENL
         [MATCH_MP_TAC POLY_COMPOSE_HOMOMORPHISM_VAR,
          MATCH_MP_TAC POLY_COMPOSE_HOMOMORPHISM_CONST] THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"poly_ring (l:B ring) (:1)", ← q r"f:B->B",
                        ← q r"\b. poly_sub l (poly_var l one) (poly_const (l:B ring) b)",
                        ← q r"s:B->bool"] RING_PRODUCT_IMAGE) THEN
      ANTS_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:B->B")) THEN
        ASM_REWRITE_TAC [ring_automorphism, RING_ISOMORPHISM] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:B->B")) THEN ASM_SIMP_TAC [o_DEF],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"m:1->num") THEN REWRITE_TAC [IN_FIXED_FIELD] THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"P IN ring_carrier(poly_ring (l:B ring) (:1))") THEN
      SIMP_TAC [IN_POLY_RING_CARRIER, ring_polynomial, ring_powerseries],
      X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← AP_THM (← MATCH_MP th (← ASSUME (← q r"(f:B->B) IN G")))
                               (← q r"m:1->num")))) THEN
      REWRITE_TAC [o_THM]])

  let MINIMAL_POLYNOMIAL_FINITE_ORBIT ← prove
   r"!(h:A->B) k l G a.
        field_extension(k,l) h /\
        G subgroup_of symmetric_group(ring_carrier l) /\
        (!f. f IN G ==> ring_automorphism l f) /\
        fixed_field l G SUBSET IMAGE h (ring_carrier k) /\
        a IN ring_carrier l /\ FINITE {f a | f IN G}
        ==> algebraic_over(k,l) h a /\ separable_element(k,l) h a /\
            poly_splits_over(k,l) h (minimal_polynomial(k,l) h a) /\
            poly_deg k (minimal_polynomial(k,l) h a) <= CARD {f a | f IN G}"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    ABBREV_TAC (← q r"t = {(f:B->B) a | f IN G}") THEN
    FIRST_ASSUM (fun th => tactic_of do
      if !(is_binary "subgroup_of" (concl th)) then throw "check"
      pure ((STRIP_ASSUME_TAC o
             REWRITE_RULE [subgroup_of, SYMMETRIC_GROUP, SUBSET, IN_ELIM_THM]) th)) THEN
    SUBGOAL_THEN (← q r"(t:B->bool) SUBSET ring_carrier l") ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      ASM_MESON_TAC [PERMUTES_IN_IMAGE],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(a:B) IN t") ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"I:B->B") THEN ASM_REWRITE_TAC [I_THM],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!f:B->B. f IN G ==> IMAGE f t = t") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN EXPAND_TAC "t" THEN
      REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"y:B") THEN EQ_TAC THENL
       [ASM_MESON_TAC [o_THM],
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"inverse (f:B->B) (y:B)") THEN CONJ_TAC THENL
         [ASM_MESON_TAC [PERMUTES_INVERSES],
          EXISTS_TAC (← q r"inverse (f:B->B) o (g:B->B)") THEN
          ASM_SIMP_TAC [o_THM]]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"G:(B->B)->bool", ← q r"t:B->bool"]
      RING_PRODUCT_X_MINUS_A_IN_FIXED_FIELD) THEN
    ASM_SIMP_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"t:B->bool"] RING_PRODUCT_X_MINUS_A) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
    ABBREV_TAC (← q r"P = ring_product (poly_ring l (:1)) t
     (\b. poly_sub l (poly_var l one) (poly_const (l:B ring) b))") THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"(:1)", ← q r"P:(1->num)->B"]
      POLY_RING_MONOMORPHIC_PREIMAGE) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [] THEN ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:(1->num)->A") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"ring_polynomial k (q:(1->num)->A)") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_POLYNOMIAL], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~((q:(1->num)->A) = poly_0 k)") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"q:(1->num)->A"]
        POLY_EQ_0_MONOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC MONIC_IMP_NONZERO THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING] THEN ASM_MESON_TAC [RING_POLYNOMIAL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"poly_deg k (q:(1->num)->A) = CARD(t:B->bool)") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"q:(1->num)->A"]
        POLY_DEG_MONOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"poly_splits_over (k,l) (h:A->B) q") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [poly_splits_over], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"poly_separable k (q:(1->num)->A)") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"q:(1->num)->A"]
        POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT_EQ) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"poly_extend (k,l) (h:A->B) (\v:1. a) q = ring_0 l")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [POLY_EXTEND_EVALUATE, ← GSYM poly_eval] THEN
      MP_TAC (← ASSUME (← q r"{x | x IN ring_carrier l /\
                        poly_eval l (P:(1->num)->B) x = ring_0 l} = t")) THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:B")) THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_over (k,l) (h:A->B) a") ASSUME_TAC THENL
     [REWRITE_TAC [algebraic_over] THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"q:(1->num)->A") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [POLY_RING_CLAUSES] THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_divides (poly_ring k (:1)) (minimal_polynomial (k,l) (h:A->B) a) q")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_DIVIDES], ALL_TAC] THEN
    ASM_REWRITE_TAC [separable_element] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC POLY_SEPARABLE_DIVISOR THEN EXISTS_TAC (← q r"q:(1->num)->A") THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER],
      REWRITE_TAC [poly_splits_over] THEN MATCH_MP_TAC POLY_SPLITS_DIVISOR THEN
      EXISTS_TAC (← q r"P:(1->num)->B") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC MONIC_IMP_NONZERO THEN
        ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING] THEN
        ASM_MESON_TAC [RING_POLYNOMIAL],
        FIRST_X_ASSUM (fun th => tactic_of do
          let c ← q r"(h:A->B) o (q:(1->num)->A) = P"
          if !(concl th == c) then throw "check"
          pure ((SUBST1_TAC o SYM) th)) THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          let c ← q r"ring_divides (poly_ring k (:1))
               (minimal_polynomial (k,l) (h:A->B) a) q"
          if !(concl th == c) then throw "check"
          let c1 ← ISPEC (← q r"(:1)") (← MATCH_MP RING_HOMOMORPHISM_POLY_RINGS
            (← ASSUME (← q r"ring_homomorphism(k:A ring,l:B ring) h")))
          pure ((MP_TAC o MATCH_MP RING_DIVIDES_HOMOMORPHIC_IMAGE) (← CONJ c1 th))) THEN
        REWRITE_TAC []],
      TRANS_TAC LE_TRANS (← q r"poly_deg k (q:(1->num)->A)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC MINIMAL_POLYNOMIAL_DEG_LE THEN ASM_REWRITE_TAC [],
        ASM_REWRITE_TAC [LE_REFL]]])

  let ARTIN_FIXED_FIELD ← prove
   r"!(l:B ring) G.
        field l /\ FINITE G /\ G subgroup_of symmetric_group(ring_carrier l) /\
        (!f. f IN G ==> ring_automorphism l f)
        ==> finite_extension(subfield_generated l (fixed_field l G),l) I /\
            galois_extension(subfield_generated l (fixed_field l G),l) I /\
            extension_degree(subfield_generated l (fixed_field l G),l) I =
            CARD G /\
            group_carrier
             (galois_group(subfield_generated l (fixed_field l G),l) I) = G"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!f:B->B. f IN G ==> f permutes ring_carrier l") ASSUME_TAC THENL
     [FIRST_ASSUM (fun th => tactic_of do
        if !(is_binary "subgroup_of" (concl th)) then throw "check"
        pure ((MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE I [subgroup_of]) th)) THEN
      REWRITE_TAC [SYMMETRIC_GROUP, SUBSET, IN_ELIM_THM],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"G SUBSET
    group_carrier(galois_group(subfield_generated l (fixed_field l G),l)
                               (I:B->B))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC SUBSET_GALOIS_GROUP_FIXED_FIELD THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"fixed_field l (G:(B->B)->bool) subfield_of l") ASSUME_TAC THENL
     [MATCH_MP_TAC SUBFIELD_OF_FIXED_FIELD THEN
      ASM_MESON_TAC [RING_AUTOMORPHISM_IMP_ENDOMORPHISM],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"K = subfield_generated l (fixed_field l (G:(B->B)->bool))") THEN
    SUBGOAL_THEN (← q r"ring_carrier K = fixed_field l (G:(B->B)->bool)")
    ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field_extension(K,l) (I:B->B)") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN ASM_REWRITE_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a:B. a IN ring_carrier l
          ==> algebraic_over(K,l) I a /\ separable_element(K,l) I a /\
              poly_splits_over(K,l) I (minimal_polynomial(K,l) I a) /\
              poly_deg K (minimal_polynomial(K,l) I a) <= CARD(G:(B->B)->bool)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"a:B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring", ← q r"G:(B->B)->bool", ← q r"a:B"]
        MINIMAL_POLYNOMIAL_FINITE_ORBIT) THEN
      ASM_REWRITE_TAC [IMAGE_I, SUBSET_REFL] THEN
      REWRITE_TAC [SIMPLE_IMAGE] THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      TRANS_TAC LE_TRANS (← q r"CARD(IMAGE (\f:B->B. f a) G)") THEN
      ASM_SIMP_TAC [CARD_IMAGE_LE],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_extension(K,l) (I:B->B)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [algebraic_extension], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"separable_extension(K,l) (I:B->B)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [separable_extension], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"normal_extension(K,l) (I:B->B)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring", ← q r"CARD(G:(B->B)->bool)"]
      SEPARABLE_EXTENSION_BOUNDED_DEGREE) THEN
    ASM_SIMP_TAC [] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring"] CARD_GALOIS_GROUP_LE) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"CARD(G:(B->B)->bool) <= CARD(group_carrier(galois_group(K,l) (I:B->B)))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC CARD_SUBSET THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"extension_degree(K,l) (I:B->B) = CARD(G:(B->B)->bool)")
    ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    ASM_REWRITE_TAC [galois_extension] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARD_SUBSET_EQ THEN
    ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC)

  /- Artin for a group G of automorphisms with finite orbits, not         -/
  /- necessarily finite: every element of l is separable over the fixed   -/
  /- field of G with split minimal polynomial                             -/
  /- (MINIMAL_POLYNOMIAL_FINITE_ORBIT), so l is Galois over it. The Galois -/
  /- group is then the closure of G in the Krull topology                 -/
  /- (ARTIN_FIXED_FIELD_FINITE_ORBITS in Multivariate/infinite_galois.ml). -/
  let GALOIS_EXTENSION_FIXED_FIELD_FINITE_ORBITS ← prove
   r"!(l:B ring) G.
        field l /\ G subgroup_of symmetric_group(ring_carrier l) /\
        (!f. f IN G ==> ring_automorphism l f) /\
        (!x. x IN ring_carrier l ==> FINITE {f x | f IN G})
        ==> galois_extension(subfield_generated l (fixed_field l G),l) I"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"fixed_field l (G:(B->B)->bool) subfield_of l") ASSUME_TAC THENL
     [MATCH_MP_TAC SUBFIELD_OF_FIXED_FIELD THEN
      ASM_MESON_TAC [RING_AUTOMORPHISM_IMP_ENDOMORPHISM],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"K = subfield_generated l (fixed_field l (G:(B->B)->bool))") THEN
    SUBGOAL_THEN (← q r"ring_carrier K = fixed_field l (G:(B->B)->bool)")
    ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field_extension(K,l) (I:B->B)") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN ASM_REWRITE_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a:B. a IN ring_carrier l
            ==> algebraic_over(K,l) I a /\ separable_element(K,l) I a /\
                poly_splits_over(K,l) I (minimal_polynomial(K,l) I a)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"a:B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring", ← q r"G:(B->B)->bool", ← q r"a:B"]
        MINIMAL_POLYNOMIAL_FINITE_ORBIT) THEN
      ASM_SIMP_TAC [IMAGE_I, SUBSET_REFL],
      ALL_TAC] THEN
    ASM_SIMP_TAC [galois_extension, NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT,
                  separable_extension, algebraic_extension])

  let GALOIS_EXTENSION_EQ_FIXED_FIELD ← prove
   r"!(h:A->B) k l.
        algebraic_extension(k,l) h
        ==> (galois_extension(k,l) h <=>
             fixed_field l (group_carrier(galois_group(k,l) h)) =
             IMAGE h (ring_carrier k))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    EQ_TAC THENL
     [DISCH_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
      ASM_SIMP_TAC [IMAGE_SUBSET_FIXED_FIELD_GALOIS_GROUP] THEN
      REWRITE_TAC [SUBSET, IN_FIXED_FIELD] THEN
      X_GEN_TAC (← q r"x:B") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
       [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
      ASM_SIMP_TAC [← GSYM MINIMAL_POLYNOMIAL_DEG_EQ_1] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
        GALOIS_GROUP_ORBIT) THEN
      ASM_SIMP_TAC [GALOIS_IMP_NORMAL_EXTENSION] THEN
      SUBGOAL_THEN
       (← q r"{f x | f IN group_carrier(galois_group(k:A ring,l) (h:A->B))} = {x:B}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_SING] THEN
        ASM_MESON_TAC [GROUP_ID, GALOIS_GROUP, I_THM],
        DISCH_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                        ← q r"minimal_polynomial(k,l) (h:A->B) x"]
        POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT_EQ) THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM o check (is_eq o concl)) THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_NONZERO,
                    CARD_SING] THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT,
                       GALOIS_IMP_NORMAL_EXTENSION],
        DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).1))] THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [GALOIS_IMP_SEPARABLE_EXTENSION, separable_extension,
                       separable_element],
        ARITH_TAC],
      DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a. a IN ring_carrier l
        ==> separable_element(k,l) (h:A->B) a /\
            poly_splits_over(k,l) h (minimal_polynomial(k,l) h a)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"a:B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                        ← q r"group_carrier(galois_group(k:A ring,l:B ring) h)", ← q r"a:B"]
        MINIMAL_POLYNOMIAL_FINITE_ORBIT) THEN
      ASM_REWRITE_TAC [GALOIS_GROUP_SUBGROUP, SUBSET_REFL] THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      CONJ_TAC THENL [MESON_TAC [GALOIS_GROUP_RING_AUTOMORPHISM], ALL_TAC] THEN
      MATCH_MP_TAC GALOIS_GROUP_ORBIT_FINITE THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [galois_extension, NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT,
                  separable_extension])

  let FIXED_FIELD_GALOIS_GROUP ← prove
   r"!(h:A->B) k l.
        galois_extension(k,l) h
        ==> fixed_field l (group_carrier(galois_group(k,l) h)) =
            IMAGE h (ring_carrier k)"
   (MESON_TAC [GALOIS_EXTENSION_EQ_FIXED_FIELD, GALOIS_IMP_ALGEBRAIC_EXTENSION])

  -- @@RETURN BEGIN
  return { RING_PRODUCT_X_MINUS_A_IN_FIXED_FIELD, MINIMAL_POLYNOMIAL_FINITE_ORBIT,
           ARTIN_FIXED_FIELD, GALOIS_EXTENSION_FIXED_FIELD_FINITE_ORBITS,
           GALOIS_EXTENSION_EQ_FIXED_FIELD, FIXED_FIELD_GALOIS_GROUP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Elements of the Galois group are determined by their values on            -/
/- generators, and the Galois group depends on the extension only up to      -/
/- isomorphism; in particular all splitting extensions of a polynomial have  -/
/- isomorphic Galois groups.                                                 -/
/- ------------------------------------------------------------------------- -/

structure GaloisIsomorphic where
  -- @@FIELDS
  GALOIS_GROUP_EQ_ON_GENERATORS : thm
  GALOIS_PRIMITIVE_ELEMENT_DERIVATIVE : thm
  ISOMORPHIC_GALOIS_GROUPS : thm
  ISOMORPHIC_GALOIS_GROUPS_SPLITTING : thm
  GALOIS_EXTENSION_HOMOMORPHIC_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisIsomorphic [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) :
    ExceptT String IO GaloisIsomorphic := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, .. } := D
  let { EQ_IMP, FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_ISOMORPHISM,
        FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FINITE_IMP_ALGEBRAIC_EXTENSION, FINITE_IMP_FIELD_EXTENSION, FORALL_IN_IMAGE,
        FUN_EQ_THM, GROUP_HOMOMORPHISM, GROUP_ISOMORPHISMS, .. } := D.core1
  let { IN_IMAGE, IN_INSERT, IN_UNION, I_THM, MINIMAL_POLYNOMIAL_IN_CARRIER,
        MINIMAL_POLYNOMIAL_MONIC, MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE,
        MONIC_HOMOMORPHIC_IMAGE, MONIC_POLY_EQ_ROOTS_PRODUCT,
        NORMAL_EXTENSION_ISOMORPHIC_IMAGE, PERMUTES_EQ, PERMUTES_IN_IMAGE,
        POLY_DEG_MONOMORPHIC_IMAGE, POLY_DERIV_HOMOMORPHIC_IMAGE,
        POLY_EVAL_DERIV_RING_PRODUCT_X_MINUS, POLY_EXTEND_EVALUATE, .. } := D.core2
  let { RESTRICT_PERMUTES_EQ, RING_AUTOMORPHISM_EQ,
        RING_HOMOMORPHISMS_EQ_FROM_SUBFIELD_GENERATED,
        RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED, RING_HOMOMORPHISM_IN_CARRIER,
        RING_ISOMORPHISM, RING_ISOMORPHISMS_SYM, RING_ISOMORPHISM_COMPOSE,
        RING_ISOMORPHISM_I, RING_ISOMORPHISM_ONTO_SUBFIELD_IMAGE,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_POLYNOMIAL, RING_POLYNOMIAL_COMPOSE,
        RING_POLYNOMIAL_IMP_POWERSERIES, .. } := D.core3
  let { SEPARABLE_EXTENSION_ISOMORPHISM, SEPARABLE_EXTENSION_TRANS_EQ,
        SPLITTING_EXTENSION_UNIQUE_EXPLICIT, SPLITTING_IMP_FIELD_EXTENSION,
        SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC, SUBSET, algebraic_extension,
        field_extension, group_isomorphism, isomorphic_group, o_DEF, o_THM, permutes,
        poly_eval, ring_automorphism, ring_isomorphism, ring_isomorphisms,
        ring_polynomial, ring_powerseries, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_FIXES, GALOIS_GROUP_I, GALOIS_GROUP_PERMUTES,
        GALOIS_GROUP_RING_HOMOMORPHISM, IN_GALOIS_GROUP, .. } := BGaloisGroup
  let { FINITE_GALOIS_GROUP, .. } := BGaloisExtensions
  let { GALOIS_EXTENSION_EQ_CARD, GALOIS_IMP_FIELD_EXTENSION,
        GALOIS_IMP_NORMAL_EXTENSION, GALOIS_IMP_SEPARABLE_EXTENSION, galois_extension, .. } := BGaloisExtension
  -- @@SCOPE END

  let GALOIS_GROUP_EQ_ON_GENERATORS ← prove
   r"!(h:A->B) f g k l s.
        field l /\
        subfield_generated l (IMAGE h (ring_carrier k) UNION s) = l /\
        f IN group_carrier(galois_group(k,l) h) /\
        g IN group_carrier(galois_group(k,l) h) /\
        (!x. x IN s ==> f x = g x)
        ==> f = g"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:B->B", ← q r"g:B->B", ← q r"l:B ring", ← q r"l:B ring",
                      ← q r"IMAGE (h:A->B) (ring_carrier k) UNION s"]
      RING_HOMOMORPHISMS_EQ_FROM_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [IN_UNION, IN_IMAGE] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM, GALOIS_GROUP_FIXES],
      DISCH_TAC] THEN
    MATCH_MP_TAC PERMUTES_EQ THEN EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
    ASM_MESON_TAC [GALOIS_GROUP_PERMUTES])

  /- In a finite Galois extension l = k(a): f(a) = a for f in G only if   -/
  /- f = I, and Df(a) is the product of the a - g(a), g in G, g <> I.     -/
  let GALOIS_PRIMITIVE_ELEMENT_DERIVATIVE ← prove
   r"!(h:A->B) k l a.
        finite_extension(k,l) h /\ galois_extension(k,l) h /\
        a IN ring_carrier l /\
        subring_generated l (a INSERT IMAGE h (ring_carrier k)) = l
        ==> (!f g. f IN group_carrier(galois_group(k,l) h) /\
                   g IN group_carrier(galois_group(k,l) h) /\ f a = g a
                   ==> f = g) /\
            poly_extend (k,l) h (\v. a)
              (poly_deriv k (minimal_polynomial (k,l) h a)) =
            ring_product l (group_carrier(galois_group(k,l) h) DELETE I)
              (\f. ring_sub l a (f a))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"G = group_carrier(galois_group(k,l) (h:A->B))") THEN
    ABBREV_TAC (← q r"f = minimal_polynomial (k,l) (h:A->B) a") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"algebraic_over (k,l) (h:A->B) a") ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP FINITE_IMP_ALGEBRAIC_EXTENSION) THEN
      REWRITE_TAC [algebraic_extension] THEN
      DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"FINITE(G:(B->B)->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "G" THEN ASM_SIMP_TAC [FINITE_GALOIS_GROUP], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(I:B->B) IN G") ASSUME_TAC THENL
     [EXPAND_TAC "G" THEN REWRITE_TAC [GALOIS_GROUP_I], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!g:B->B. g IN G
               ==> ring_homomorphism(l,l) g /\
                   (!x. x IN ring_carrier k ==> g((h:A->B) x) = h x) /\
                   g a IN ring_carrier l")
    ASSUME_TAC THENL
     [EXPAND_TAC "G" THEN X_GEN_TAC (← q r"g:B->B") THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM) THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"g IN group_carrier(galois_group(k,l) (h:A->B))") THEN
        SIMP_TAC [IN_GALOIS_GROUP],
        MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
        EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!f g:B->B. f IN G /\ g IN G /\ f a = g a ==> f = g")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"f1:B->B", ← q r"g1:B->B"] THEN STRIP_TAC THEN
      REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:B") THEN
      ASM_CASES_TAC (← q r"(x:B) IN ring_carrier l") THENL
       [ALL_TAC,
        SUBGOAL_THEN
         (← q r"(f1:B->B) permutes ring_carrier l /\ (g1:B->B) permutes ring_carrier l")
        MP_TAC THENL
         [UNDISCH_TAC (← q r"(f1:B->B) IN G") THEN UNDISCH_TAC (← q r"(g1:B->B) IN G") THEN
          EXPAND_TAC "G" THEN MESON_TAC [GALOIS_GROUP_PERMUTES],
          REWRITE_TAC [permutes] THEN
          DISCH_THEN (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"x:B") o CONJUNCT1)) THEN
          ASM_REWRITE_TAC [] THEN SIMP_TAC []]] THEN
      MP_TAC (← ISPECL [← q r"f1:B->B", ← q r"g1:B->B", ← q r"l:B ring", ← q r"l:B ring",
                        ← q r"(a:B) INSERT IMAGE (h:A->B) (ring_carrier k)"]
        RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED) THEN
      ASM_SIMP_TAC [] THEN ANTS_TAC THENL
       [REWRITE_TAC [IN_INSERT, IN_IMAGE] THEN
        X_GEN_TAC (← q r"y:B") THEN STRIP_TAC THEN ASM_SIMP_TAC [],
        DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"poly_deg k (f:(1->num)->A) = CARD(G:(B->B)->bool)")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
        GALOIS_EXTENSION_EQ_CARD) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
        SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (CONJUNCTS_THEN2 (ASSUME_TAC o SYM) MP_TAC) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_polynomial k (f:(1->num)->A) /\ monic k f")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "f" THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL, MINIMAL_POLYNOMIAL_IN_CARRIER,
                    MINIMAL_POLYNOMIAL_MONIC],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"poly_extend (k,l) (h:A->B) (\v. a) (poly_deriv k f) =
      poly_eval l (poly_deriv l ((h:A->B) o (f:(1->num)->A))) a")
    SUBST1_TAC THENL
     [ASM_SIMP_TAC [POLY_EXTEND_EVALUATE, poly_eval] THEN AP_THM_TAC THEN
      AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC POLY_DERIV_HOMOMORPHIC_IMAGE THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_IMP_POWERSERIES],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(h:A->B) o (f:(1->num)->A) =
      ring_product (poly_ring l (:1)) G
        (\g:B->B. poly_sub l (poly_var l one) (poly_const l (g a)))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC MONIC_POLY_EQ_ROOTS_PRODUCT THEN REWRITE_TAC [] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC FIELD_IMP_INTEGRAL_DOMAIN THEN ASM_REWRITE_TAC [],
        REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN
        MATCH_MP_TAC RING_POLYNOMIAL_COMPOSE THEN EXISTS_TAC (← q r"k:A ring") THEN
        ASM_REWRITE_TAC [],
        MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"f:(1->num)->A"]
          MONIC_HOMOMORPHIC_IMAGE) THEN
        ASM_REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN
        ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
        ASM_REWRITE_TAC [],
        MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"f:(1->num)->A"]
          POLY_DEG_MONOMORPHIC_IMAGE) THEN
        ASM_REWRITE_TAC [],
        X_GEN_TAC (← q r"g:B->B") THEN DISCH_TAC THEN
        FIRST_ASSUM (STRIP_ASSUME_TAC o C MATCH_MP (← ASSUME (← q r"(g:B->B) IN G"))) THEN
        ASM_REWRITE_TAC [] THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"l:B ring",
                          ← q r"a:B"] MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [FUN_EQ_THM, o_THM] THEN X_GEN_TAC (← q r"u:1->num") THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        UNDISCH_TAC (← q r"ring_polynomial k (f:(1->num)->A)") THEN
        SIMP_TAC [ring_polynomial, ring_powerseries],
        FIRST_ASSUM MATCH_ACCEPT_TAC],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"\g:B->B. g a", ← q r"G:(B->B)->bool", ← q r"I:B->B"]
      POLY_EVAL_DERIV_RING_PRODUCT_X_MINUS) THEN
    ASM_SIMP_TAC [I_THM])

  let ISOMORPHIC_GALOIS_GROUPS ← (do
    let lemma ← prove
     r"!(h:A->B) (h':A->C) (f:B->C) f' k l l' s.
        ring_isomorphisms(l,l') (f,f') /\
        (!x. x IN ring_carrier k ==> h x IN ring_carrier l /\ f(h x) = h' x) /\
        s IN group_carrier(galois_group(k,l) h)
        ==> (\y. if y IN ring_carrier l' then f(s(f' y)) else y) IN
            group_carrier(galois_group(k,l') h')"
     (REPEAT GEN_TAC THEN REWRITE_TAC [IN_GALOIS_GROUP] THEN STRIP_TAC THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [ring_isomorphisms]) THEN
      SUBGOAL_THEN (← q r"ring_automorphism l' ((f:B->C) o (s:B->B) o (f':C->B))")
      ASSUME_TAC THENL
       [REWRITE_TAC [ring_automorphism] THEN
        MATCH_MP_TAC RING_ISOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"l:B ring") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC RING_ISOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"l:B ring") THEN
          ASM_REWRITE_TAC [← GSYM ring_automorphism] THEN
          ASM_MESON_TAC [ring_isomorphism, RING_ISOMORPHISMS_SYM],
          ASM_MESON_TAC [ring_isomorphism]],
        ALL_TAC] THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [RESTRICT_PERMUTES_EQ] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [ring_automorphism]) THEN
        REWRITE_TAC [RING_ISOMORPHISM, o_DEF] THEN MESON_TAC [],
        MATCH_MP_TAC RING_AUTOMORPHISM_EQ THEN
        EXISTS_TAC (← q r"(f:B->C) o (s:B->B) o (f':C->B)") THEN
        ASM_SIMP_TAC [o_THM],
        X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          let c ← q r"h':A->C"
          if !(free_in c (concl th)) then throw "check"
          if !(is_forall (concl th)) then throw "check"
          pure ((MP_TAC o SPEC (← q r"x:A")) th)) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
        ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER]])
    prove
     r"!(h:A->B) (h':A->C) (f:B->C) k l l'.
        ring_homomorphism(k,l) h /\ ring_isomorphism(l,l') f /\
        (!x. x IN ring_carrier k ==> f(h x) = h' x)
        ==> galois_group(k,l) h isomorphic_group galois_group(k,l') h'"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"f':C->B") o GEN_REWRITE_RULE I
       [ring_isomorphism]) THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [ring_isomorphisms]) THEN
      SUBGOAL_THEN (← q r"!x. x IN ring_carrier k ==> (h:A->B) x IN ring_carrier l")
      ASSUME_TAC THENL [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
      REWRITE_TAC [isomorphic_group, group_isomorphism] THEN
      EXISTS_TAC (← q r"\s y. if y IN ring_carrier l' then (f:B->C)(s((f':C->B) y))
                    else y") THEN
      EXISTS_TAC (← q r"\t x. if x IN ring_carrier l then (f':C->B)(t((f:B->C) x))
                    else x") THEN
      REWRITE_TAC [GROUP_ISOMORPHISMS, GROUP_HOMOMORPHISM, SUBSET,
                   FORALL_IN_IMAGE] THEN
      REWRITE_TAC [← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP))] THEN
      REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"s:B->B") THEN DISCH_TAC THEN MATCH_MP_TAC lemma THEN
        MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"l:B ring"] THEN ASM_SIMP_TAC [],
        MAP_EVERY X_GEN_TAC [← q r"s:B->B", ← q r"t:B->B"] THEN STRIP_TAC THEN
        REWRITE_TAC [FUN_EQ_THM, o_THM] THEN X_GEN_TAC (← q r"y:C") THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"(t:B->B)((f':C->B) y) IN ring_carrier l") ASSUME_TAC THENL
         [ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_IN_IMAGE,
                         RING_HOMOMORPHISM_IN_CARRIER],
          ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(f:B->C)((t:B->B)((f':C->B) y)) IN ring_carrier l'")
          (fun th => ASM_SIMP_TAC [th]) THEN
        ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
        X_GEN_TAC (← q r"s:B->B") THEN DISCH_TAC THEN
        REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:B") THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_PERMUTES) THEN
        COND_CASES_TAC THENL
         [SUBGOAL_THEN (← q r"(f:B->C) x IN ring_carrier l'")
            (fun th => REWRITE_TAC [th]) THENL
           [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
          ASM_MESON_TAC [PERMUTES_IN_IMAGE],
          ASM_MESON_TAC [permutes]],
        X_GEN_TAC (← q r"t:C->C") THEN DISCH_TAC THEN CONJ_TAC THENL
         [MATCH_MP_TAC lemma THEN
          MAP_EVERY EXISTS_TAC [← q r"h':A->C", ← q r"l':C ring"] THEN
          ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
           [ONCE_REWRITE_TAC [RING_ISOMORPHISMS_SYM] THEN ASM_REWRITE_TAC [],
            ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER]],
          ALL_TAC] THEN
        REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"y:C") THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_PERMUTES) THEN
        COND_CASES_TAC THENL
         [SUBGOAL_THEN (← q r"(f':C->B) y IN ring_carrier l")
            (fun th => REWRITE_TAC [th]) THENL
           [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
          ASM_MESON_TAC [PERMUTES_IN_IMAGE],
          ASM_MESON_TAC [permutes]]]))

  let ISOMORPHIC_GALOIS_GROUPS_SPLITTING ← prove
   r"!(h:A->B) (h':A->C) k l l' p.
        splitting_extension(k,l) h p /\ splitting_extension(k,l') h' p
        ==> galois_group(k,l) h isomorphic_group galois_group(k,l') h'"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"h':A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"l':C ring",
                      ← q r"p:(1->num)->A"] SPLITTING_EXTENSION_UNIQUE_EXPLICIT) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:B->C") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC ISOMORPHIC_GALOIS_GROUPS THEN EXISTS_TAC (← q r"f:B->C") THEN
    ASM_MESON_TAC [SPLITTING_IMP_FIELD_EXTENSION,
                   FIELD_EXTENSION_IMP_HOMOMORPHISM])

  let GALOIS_EXTENSION_HOMOMORPHIC_IMAGE ← prove
   r"!(h:A->B) (j:B->C) k l m.
        galois_extension(k,l) h /\ field m /\ ring_homomorphism(l,m) j
        ==> galois_extension
             (k,subfield_generated m (IMAGE j (ring_carrier l))) (j o h) /\
            galois_group(k,l) h isomorphic_group
            galois_group(k,subfield_generated m (IMAGE j (ring_carrier l)))
                        (j o h)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MP_TAC (← ISPECL [← q r"j:B->C", ← q r"l:B ring", ← q r"m:C ring"]
      RING_ISOMORPHISM_ONTO_SUBFIELD_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"s = IMAGE (j:B->C) (ring_carrier l)") THEN STRIP_TAC THEN
    CONJ_TAC THENL
     [REWRITE_TAC [galois_extension] THEN CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->C) o (h:A->B)", ← q r"I:A->A", ← q r"j:B->C",
                          ← q r"k:A ring", ← q r"l:B ring", ← q r"k:A ring",
                          ← q r"subfield_generated m (s:C->bool)"]
          NORMAL_EXTENSION_ISOMORPHIC_IMAGE) THEN
        DISCH_THEN MATCH_MP_TAC THEN
        ASM_SIMP_TAC [RING_ISOMORPHISM_I, I_THM, o_THM,
                      GALOIS_IMP_NORMAL_EXTENSION],
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->C", ← q r"k:A ring", ← q r"l:B ring",
                          ← q r"subfield_generated m (s:C->bool)"]
          SEPARABLE_EXTENSION_TRANS_EQ) THEN
        ASM_SIMP_TAC [FIELD_EXTENSION_ISOMORPHISM, GALOIS_IMP_SEPARABLE_EXTENSION,
                      SEPARABLE_EXTENSION_ISOMORPHISM]],
      MATCH_MP_TAC ISOMORPHIC_GALOIS_GROUPS THEN EXISTS_TAC (← q r"j:B->C") THEN
      ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM, o_THM]])

  -- @@RETURN BEGIN
  return { GALOIS_GROUP_EQ_ON_GENERATORS, GALOIS_PRIMITIVE_ELEMENT_DERIVATIVE,
           ISOMORPHIC_GALOIS_GROUPS, ISOMORPHIC_GALOIS_GROUPS_SPLITTING,
           GALOIS_EXTENSION_HOMOMORPHIC_IMAGE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The Galois correspondence. An intermediate field of an extension (k,l) h  -/
/- is a subfield s of l containing the image of k; for finite Galois         -/
/- extensions s and the subgroups H of the Galois group are in an            -/
/- inclusion-reversing bijection, with degrees and indices matching.         -/
/- ------------------------------------------------------------------------- -/

structure GaloisCorrespondence where
  -- @@FIELDS
  SUBGROUP_OF_GALOIS_GROUP : thm
  IN_GALOIS_GROUP_INTERMEDIATE : thm
  GALOIS_GROUP_INTERMEDIATE_SUBGROUP : thm
  GALOIS_GROUP_INTERMEDIATE_SUBGROUP_GENERATED : thm
  GALOIS_EXTENSION_SUBFIELD_GENERATED : thm
  FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE : thm
  GALOIS_GROUP_FIXED_FIELD : thm
  GALOIS_CORRESPONDENCE : thm
  GALOIS_GROUP_ANTIMONO_EQ : thm
  FIXED_FIELD_ANTIMONO_EQ : thm
  GALOIS_CORRESPONDENCE_DEGREE : thm
  GALOIS_CORRESPONDENCE_INDEX : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisCorrespondence [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BFixedFields : FixedFields) (BArtin : Artin) :
    ExceptT String IO GaloisCorrespondence := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, .. } := D
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
        EQ_MULT_RCANCEL, EXTENSION_DEGREE_EQ_0, EXTENSION_DEGREE_TOWER_LAW,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_EXTENSION_SUBFIELD_GENERATED,
        FINITE_EXTENSION_SUBFIELD_GENERATED, FINITE_IMP_FIELD_EXTENSION, FINITE_SUBSET,
        GROUPS_EQ, .. } := D.core1
  let { IMAGE_I, I_O_ID, I_THM, LAGRANGE_THEOREM_RIGHT, .. } := D.core2
  let { RING_AUTOMORPHISM_IMP_ENDOMORPHISM, RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core3
  let { SUBGROUP_GENERATED, SUBGROUP_OF_SUBGROUP_GENERATED_EQ, SUBSET, SUBSET_TRANS,
        field_extension, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_ANTIMONO, GALOIS_GROUP_RING_AUTOMORPHISM,
        GALOIS_GROUP_SUBGROUP, IN_GALOIS_GROUP, galois_group, .. } := BGaloisGroup
  let { CARD_GALOIS_GROUP_LE, .. } := BGaloisExtensions
  let { GALOIS_EXTENSION_EQ_CARD, GALOIS_EXTENSION_INTERMEDIATE,
        GALOIS_IMP_FIELD_EXTENSION, .. } := BGaloisExtension
  let { FIXED_FIELD_ANTIMONO, IMAGE_SUBSET_FIXED_FIELD_GALOIS_GROUP,
        SUBFIELD_OF_FIXED_FIELD, .. } := BFixedFields
  let { ARTIN_FIXED_FIELD, FIXED_FIELD_GALOIS_GROUP, .. } := BArtin
  -- @@SCOPE END

  let SUBGROUP_OF_GALOIS_GROUP ← prove
   r"!(h:A->B) k l G.
        G subgroup_of galois_group(k,l) h <=>
        G subgroup_of symmetric_group(ring_carrier l) /\
        G SUBSET group_carrier(galois_group(k,l) h)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [galois_group] THEN
    REWRITE_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_EQ, ← GSYM galois_group])

  let IN_GALOIS_GROUP_INTERMEDIATE ← prove
   r"!(h:A->B) f k l s.
        s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
        ==> (f IN group_carrier(galois_group(subfield_generated l s,l) I) <=>
             f IN group_carrier(galois_group(k,l) h) /\
             !x. x IN s ==> f x = x)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [IN_GALOIS_GROUP, CARRIER_SUBFIELD_GENERATED_SUBFIELD, I_THM] THEN
    EQ_TAC THEN SIMP_TAC [] THEN ASM SET_TAC [])

  let GALOIS_GROUP_INTERMEDIATE_SUBGROUP ← prove
   r"!(h:A->B) k l s.
        s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
        ==> group_carrier(galois_group(subfield_generated l s,l) I)
            subgroup_of galois_group(k,l) h"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [SUBGROUP_OF_GALOIS_GROUP, GALOIS_GROUP_SUBGROUP, SUBSET] THEN
    X_GEN_TAC (← q r"f:B->B") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      IN_GALOIS_GROUP_INTERMEDIATE) THEN
    ASM_SIMP_TAC [])

  let GALOIS_GROUP_INTERMEDIATE_SUBGROUP_GENERATED ← prove
   r"!(h:A->B) k l s.
        s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
        ==> subgroup_generated (galois_group(k,l) h)
              (group_carrier(galois_group(subfield_generated l s,l) I)) =
            galois_group(subfield_generated l s,l) I"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [GROUPS_EQ] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                  GALOIS_GROUP_INTERMEDIATE_SUBGROUP] THEN
    REWRITE_TAC [SUBGROUP_GENERATED, GALOIS_GROUP])

  let GALOIS_EXTENSION_SUBFIELD_GENERATED ← prove
   r"!(h:A->B) k l s.
        galois_extension(k,l) h /\ IMAGE h (ring_carrier k) SUBSET s
        ==> galois_extension(subfield_generated l s,l) I"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GALOIS_EXTENSION_INTERMEDIATE THEN
    MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN
    ASM_REWRITE_TAC [I_O_ID] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
                  FIELD_EXTENSION_SUBFIELD_GENERATED])

  let FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE ← prove
   r"!(h:A->B) k l s.
        galois_extension(k,l) h /\
        s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
        ==> fixed_field l
             (group_carrier(galois_group(subfield_generated l s,l) I)) = s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring"]
      FIXED_FIELD_GALOIS_GROUP) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [GALOIS_EXTENSION_SUBFIELD_GENERATED],
      ASM_SIMP_TAC [IMAGE_I, CARRIER_SUBFIELD_GENERATED_SUBFIELD]])

  let GALOIS_GROUP_FIXED_FIELD ← prove
   r"!(h:A->B) k l H.
        finite_extension(k,l) h /\ H subgroup_of galois_group(k,l) h
        ==> fixed_field l H subfield_of l /\
            IMAGE h (ring_carrier k) SUBSET fixed_field l H /\
            group_carrier
             (galois_group(subfield_generated l (fixed_field l H),l) I) = H"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE I [SUBGROUP_OF_GALOIS_GROUP]) THEN
    SUBGOAL_THEN (← q r"!f:B->B. f IN H ==> ring_automorphism l f") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, GALOIS_GROUP_RING_AUTOMORPHISM], ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC SUBFIELD_OF_FIXED_FIELD THEN
      ASM_MESON_TAC [RING_AUTOMORPHISM_IMP_ENDOMORPHISM],
      TRANS_TAC SUBSET_TRANS
       (← q r"fixed_field l (group_carrier(galois_group(k:A ring,l:B ring) h))") THEN
      ASM_SIMP_TAC [FIXED_FIELD_ANTIMONO, IMAGE_SUBSET_FIXED_FIELD_GALOIS_GROUP,
                    RING_MONOMORPHISM_IMP_HOMOMORPHISM],
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"H:(B->B)->bool"] ARTIN_FIXED_FIELD) THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"group_carrier(galois_group(k:A ring,l:B ring) h)") THEN
      ASM_SIMP_TAC [CARD_GALOIS_GROUP_LE]])

  let GALOIS_CORRESPONDENCE ← prove
   r"!(h:A->B) k l.
     finite_extension(k,l) h /\ galois_extension(k,l) h
     ==> (!H. H subgroup_of galois_group(k,l) h
              ==> fixed_field l H subfield_of l /\
                  IMAGE h (ring_carrier k) SUBSET fixed_field l H /\
                  group_carrier(galois_group
                    (subfield_generated l (fixed_field l H),l) I) = H) /\
         (!s. s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
              ==> group_carrier(galois_group(subfield_generated l s,l) I)
                  subgroup_of galois_group(k,l) h /\
                  fixed_field l
                    (group_carrier(galois_group(subfield_generated l s,l) I)) =
                  s)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN CONJ_TAC THEN GEN_TAC THEN STRIP_TAC THENL
     [MATCH_MP_TAC GALOIS_GROUP_FIXED_FIELD THEN ASM_REWRITE_TAC [],
      ASM_SIMP_TAC [GALOIS_GROUP_INTERMEDIATE_SUBGROUP] THEN
      MATCH_MP_TAC FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN ASM_REWRITE_TAC []])

  let GALOIS_GROUP_ANTIMONO_EQ ← prove
   r"!(h:A->B) k l s t.
        galois_extension(k,l) h /\
        s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
        t subfield_of l /\ IMAGE h (ring_carrier k) SUBSET t
        ==> (group_carrier(galois_group(subfield_generated l t,l) I) SUBSET
             group_carrier(galois_group(subfield_generated l s,l) I) <=>
             s SUBSET t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
        FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"t:B->bool"]
        FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (fun th1 => DISCH_THEN (fun th2 => tactic_of do
        pure (GEN_REWRITE_TAC BINOP_CONV [← SYM th1, ← SYM th2]))) THEN
      MATCH_MP_TAC FIXED_FIELD_ANTIMONO THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC GALOIS_GROUP_ANTIMONO THEN
      ASM_SIMP_TAC [IMAGE_I, CARRIER_SUBFIELD_GENERATED_SUBFIELD]])

  let FIXED_FIELD_ANTIMONO_EQ ← prove
   r"!(h:A->B) k l G H.
        finite_extension(k,l) h /\
        G subgroup_of galois_group(k,l) h /\ H subgroup_of galois_group(k,l) h
        ==> (fixed_field l H SUBSET fixed_field l G <=> G SUBSET H)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [FIXED_FIELD_ANTIMONO] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"G:(B->B)->bool"]
      GALOIS_GROUP_FIXED_FIELD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"H:(B->B)->bool"]
      GALOIS_GROUP_FIXED_FIELD) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"H:(B->B)->bool"
      if !((← liftExcept (rand (concl th))) == c) then throw "check"
      pure ((SUBST1_TAC o SYM) th)) THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"G:(B->B)->bool"
      if !((← liftExcept (rand (concl th))) == c) then throw "check"
      pure ((SUBST1_TAC o SYM) th)) THEN
    MATCH_MP_TAC GALOIS_GROUP_ANTIMONO THEN
    ASM_SIMP_TAC [IMAGE_I, CARRIER_SUBFIELD_GENERATED_SUBFIELD])

  let GALOIS_CORRESPONDENCE_DEGREE ← prove
   r"!(h:A->B) k l s.
     finite_extension(k,l) h /\ galois_extension(k,l) h /\
     s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
     ==> extension_degree(subfield_generated l s,l) I =
         CARD(group_carrier(galois_group(subfield_generated l s,l) I)) /\
         extension_degree(k,subfield_generated l s) h *
         CARD(group_carrier(galois_group(subfield_generated l s,l) I)) =
         CARD(group_carrier(galois_group(k,l) h))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      GALOIS_EXTENSION_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN SUBST1_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                      ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring"]
      EXTENSION_DEGREE_TOWER_LAW) THEN
    ASM_SIMP_TAC [I_O_ID, FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
                  FIELD_EXTENSION_SUBFIELD_GENERATED])

  let GALOIS_CORRESPONDENCE_INDEX ← prove
   r"!(h:A->B) k l s.
     finite_extension(k,l) h /\ galois_extension(k,l) h /\
     s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
     ==> CARD {right_coset (galois_group(k,l) h)
                (group_carrier(galois_group(subfield_generated l s,l) I)) x |
               x | x IN group_carrier(galois_group(k,l) h)} =
         extension_degree(k,subfield_generated l s) h"
   (← do
    let m1 ← MESON [EQ_MULT_RCANCEL]
     (← q r"!a b c n:num. a * n = c /\ b * n = c /\ ~(n = 0) ==> a = b")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      GALOIS_CORRESPONDENCE_DEGREE) THEN
    MP_TAC (← ISPECL
     [← q r"galois_group(k:A ring,l:B ring) h",
      ← q r"group_carrier(galois_group(subfield_generated l (s:B->bool),l) I)"]
     LAGRANGE_THEOREM_RIGHT) THEN
    ASM_SIMP_TAC [CARD_GALOIS_GROUP_LE, GALOIS_GROUP_INTERMEDIATE_SUBGROUP] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"~(CARD(group_carrier
        (galois_group(subfield_generated l s,l) (I:B->B))) = 0)")
    ASSUME_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"extension_degree(subfield_generated l s,l) (I:B->B)"
        if !((← liftExcept (lhs (concl th))) == c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      ASM_SIMP_TAC [EXTENSION_DEGREE_EQ_0, FIELD_EXTENSION_SUBFIELD_GENERATED],
      MATCH_MP_TAC m1 THEN
      MAP_EVERY EXISTS_TAC
       [← q r"CARD(group_carrier(galois_group(k:A ring,l:B ring) h))",
        ← q r"CARD(group_carrier
         (galois_group(subfield_generated l s,l) (I:B->B)))"] THEN
      ASM_REWRITE_TAC []]))

  -- @@RETURN BEGIN
  return { SUBGROUP_OF_GALOIS_GROUP, IN_GALOIS_GROUP_INTERMEDIATE,
           GALOIS_GROUP_INTERMEDIATE_SUBGROUP,
           GALOIS_GROUP_INTERMEDIATE_SUBGROUP_GENERATED,
           GALOIS_EXTENSION_SUBFIELD_GENERATED, FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE,
           GALOIS_GROUP_FIXED_FIELD, GALOIS_CORRESPONDENCE, GALOIS_GROUP_ANTIMONO_EQ,
           FIXED_FIELD_ANTIMONO_EQ, GALOIS_CORRESPONDENCE_DEGREE,
           GALOIS_CORRESPONDENCE_INDEX }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Normal intermediate fields. For a normal extension l over k every         -/
/- homomorphism from an intermediate field into l fixing the image of k      -/
/- extends to an element of the Galois group. An intermediate field s is     -/
/- normal over k exactly when it is mapped into itself by the Galois group,  -/
/- and for a Galois extension exactly when the Galois group of l over s is a -/
/- normal subgroup.                                                          -/
/- ------------------------------------------------------------------------- -/

structure NormalIntermediate where
  -- @@FIELDS
  GALOIS_GROUP_EXTEND_HOMOMORPHISM : thm
  GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE : thm
  NORMAL_EXTENSION_EQ_GALOIS_STABLE : thm
  GALOIS_GROUP_INTERMEDIATE_NORMAL_SUBGROUP : thm
  deriving Inhabited

@[nospecialize]
def setupNormalIntermediate [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisCorrespondence : GaloisCorrespondence) :
    ExceptT String IO NormalIntermediate := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH,
        ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM, ALGEBRAIC_EXTENSION_TRANS_EQ,
        ALGEBRAIC_IMP_FIELD_EXTENSION, BIJ, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
        EXTENSION, FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_IMP_MONOMORPHISM,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_EXTENSION_SUBFIELD_GENERATED,
        FIELD_IMP_INTEGRAL_DOMAIN, FORALL_IN_IMAGE, GROUP_CONJUGATION, .. } := D.core1
  let { IMAGE_I, IN_ELIM_THM, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, I_O_ID, I_THM,
        MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_MONOMORPHIC_IMAGE,
        NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT, NORMAL_EXTENSION_IMAGES_EQ,
        NORMAL_IMP_ALGEBRAIC_EXTENSION, NORMAL_SUBGROUP_CONJUGATION, PERMUTES_INVERSES,
        PERMUTES_IN_IMAGE, .. } := D.core2
  let { POLY_SPLITS_MONOMORPHIC_PREIMAGE, RESTRICTION,
        RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS, RING_HOMOMORPHISM_COMPOSE,
        RING_HOMOMORPHISM_FROM_SUBFIELD_GENERATED, RING_HOMOMORPHISM_IN_CARRIER,
        RING_HOMOMORPHISM_SUBFIELD_INCLUSION, RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core3
  let { SUBFIELD_OF_IMP_SUBSET, SUBSET, SURJ, algebraic_extension, field_extension,
        group_conjugation, o_THM, poly_splits_over, ring_monomorphism, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_FIXES, GALOIS_GROUP_INVERSE, GALOIS_GROUP_PERMUTES,
        GALOIS_GROUP_RING_HOMOMORPHISM, .. } := BGaloisGroup
  let { GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_NORMAL, GALOIS_GROUP_ORBIT, .. } := BGaloisExtensions
  let { GALOIS_GROUP_INTERMEDIATE_SUBGROUP, IN_GALOIS_GROUP_INTERMEDIATE, .. } := BGaloisCorrespondence
  -- @@SCOPE END

  let GALOIS_GROUP_EXTEND_HOMOMORPHISM ← prove
   r"!(h:A->B) g k l s.
     normal_extension(k,l) h /\
     s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
     ring_homomorphism(subfield_generated l s,l) g /\
     (!x. x IN ring_carrier k ==> g(h x) = h x)
     ==> ?f. f IN group_carrier(galois_group(k,l) h) /\
             !x. x IN s ==> f x = g x"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP NORMAL_IMP_ALGEBRAIC_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    ABBREV_TAC (← q r"S = subfield_generated l (s:B->bool)") THEN
    SUBGOAL_THEN (← q r"ring_carrier S = (s:B->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"field_extension(k,S) (h:A->B) /\ field_extension(S,l) (I:B->B)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN
      ASM_SIMP_TAC [FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
                    FIELD_EXTENSION_SUBFIELD_GENERATED],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_extension(S,l) (I:B->B)") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"S:B ring", ← q r"l:B ring"]
        ALGEBRAIC_EXTENSION_TRANS_EQ) THEN
      ASM_SIMP_TAC [I_O_ID],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"l:B ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:(B#num) ring")
     (X_CHOOSE_THEN (← q r"j:B->B#num") STRIP_ASSUME_TAC)) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"algebraic_extension(l:B ring,m) (j:B->B#num)"
      if !(concl th == c) then throw "check"
      pure ((ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) th)) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"field_extension(l:B ring,m) (j:B->B#num)"
      if !(concl th == c) then throw "check"
      pure ((ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_MONOMORPHISM) th)) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"ring_monomorphism(l:B ring,m) (j:B->B#num)"
      if !(concl th == c) then throw "check"
      pure ((ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) th)) THEN
    MP_TAC (← ISPECL [← q r"S:B ring", ← q r"l:B ring", ← q r"m:(B#num) ring", ← q r"I:B->B",
                      ← q r"(j:B->B#num) o (g:B->B)"]
      ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [I_THM, o_THM]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:B->B#num") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->B#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:(B#num) ring"]
      GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_NORMAL) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN,
                  ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD] THEN
    REWRITE_TAC [BIJ, SURJ] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"RESTRICTION (ring_carrier l) (e:B->B#num)") o
               CONJUNCT2 o CONJUNCT2) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS THEN
      ASM_REWRITE_TAC [o_THM] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(h:A->B) x IN s") ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"IMAGE (h:A->B) (ring_carrier k) SUBSET s") THEN
        UNDISCH_TAC (← q r"(x:A) IN ring_carrier k") THEN SET_TAC [],
        ASM_SIMP_TAC []],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:B->B") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"f:B->B") THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(x:B) IN ring_carrier l") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBFIELD_OF_IMP_SUBSET, SUBSET], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o flip AP_THM (← q r"x:B")) THEN
    ASM_REWRITE_TAC [RESTRICTION, o_THM] THEN
    SUBGOAL_THEN (← q r"(e:B->B#num) x = j((g:B->B) x)") SUBST1_TAC THENL
     [ASM_SIMP_TAC [], DISCH_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"ring_monomorphism(l:B ring,m) (j:B->B#num)"
      if !(concl th == c) then throw "check"
      pure ((MATCH_MP_TAC o CONJUNCT2 o
             GEN_REWRITE_RULE I [ring_monomorphism]) th)) THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_IN_IMAGE],
      ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER]])

  let GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE ← prove
   r"!(h:A->B) f k l s.
        field l /\ s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
        normal_extension(k,subfield_generated l s) h /\
        f IN group_carrier(galois_group(k,l) h)
        ==> IMAGE f s = s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"I:B->B", ← q r"k:A ring",
                      ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring"]
      NORMAL_EXTENSION_IMAGES_EQ) THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, IMAGE_I,
                  FIELD_IMP_INTEGRAL_DOMAIN, I_THM,
                  RING_HOMOMORPHISM_SUBFIELD_INCLUSION] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_MESON_TAC [GALOIS_GROUP_FIXES, GALOIS_GROUP_RING_HOMOMORPHISM,
                   RING_HOMOMORPHISM_FROM_SUBFIELD_GENERATED])

  let NORMAL_EXTENSION_EQ_GALOIS_STABLE ← prove
   r"!(h:A->B) k l s.
        normal_extension(k,l) h /\
        s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
        ==> (normal_extension(k,subfield_generated l s) h <=>
             !f. f IN group_carrier(galois_group(k,l) h)
                 ==> IMAGE f s SUBSET s)"
   (← do
    let s1 ← SET_RULE (← q r"(s:B->bool) = t ==> s SUBSET t")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP NORMAL_IMP_ALGEBRAIC_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    EQ_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC s1 THEN
      MATCH_MP_TAC GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] THEN
      ASM_REWRITE_TAC [],
      DISCH_TAC] THEN
    ABBREV_TAC (← q r"S = subfield_generated l (s:B->bool)") THEN
    SUBGOAL_THEN (← q r"ring_carrier S = (s:B->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"field_extension(k,S) (h:A->B) /\ field_extension(S,l) (I:B->B)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN
      ASM_SIMP_TAC [FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
                    FIELD_EXTENSION_SUBFIELD_GENERATED],
      ALL_TAC] THEN
    REWRITE_TAC [NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT] THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"S:B ring", ← q r"l:B ring"]
        ALGEBRAIC_EXTENSION_TRANS_EQ) THEN
      ASM_SIMP_TAC [I_O_ID],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(x:B) IN ring_carrier l") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBFIELD_OF_IMP_SUBSET, SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      GALOIS_GROUP_ORBIT) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"S:B ring", ← q r"l:B ring",
                      ← q r"x:B"] MINIMAL_POLYNOMIAL_MONOMORPHIC_IMAGE) THEN
    ASM_SIMP_TAC [I_O_ID, I_THM, FIELD_EXTENSION_IMP_HOMOMORPHISM,
                  FIELD_EXTENSION_IMP_MONOMORPHISM] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    ABBREV_TAC (← q r"q = minimal_polynomial (k,l) (h:A->B) x") THEN
    REWRITE_TAC [poly_splits_over] THEN
    MATCH_MP_TAC POLY_SPLITS_MONOMORPHIC_PREIMAGE THEN
    MAP_EVERY EXISTS_TAC [← q r"l:B ring", ← q r"I:B->B"] THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_IMP_MONOMORPHISM, I_O_ID, IMAGE_I] THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT,
                     poly_splits_over],
      MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN
      ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM] THEN
      EXPAND_TAC "q" THEN ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER],
      X_GEN_TAC (← q r"y:B") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:B") o
        GEN_REWRITE_RULE I [EXTENSION] o check (is_eq o concl)) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:B->B") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:B->B")) THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:B")) THEN ASM_REWRITE_TAC []]))

  let GALOIS_GROUP_INTERMEDIATE_NORMAL_SUBGROUP ← prove
   r"!(h:A->B) k l s.
        s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
        (!f. f IN group_carrier(galois_group(k,l) h) ==> IMAGE f s SUBSET s)
        ==> group_carrier(galois_group(subfield_generated l s,l) I)
            normal_subgroup_of galois_group(k,l) h"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION] THEN
    ASM_SIMP_TAC [GALOIS_GROUP_INTERMEDIATE_SUBGROUP] THEN
    X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"t:B->B") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"t:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      IN_GALOIS_GROUP_INTERMEDIATE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B",
                      ← q r"group_conjugation (galois_group(k,l) (h:A->B)) f t",
                      ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      IN_GALOIS_GROUP_INTERMEDIATE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    ASM_SIMP_TAC [GROUP_CONJUGATION] THEN
    REWRITE_TAC [group_conjugation, ← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP)] THEN
    X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN REWRITE_TAC [o_THM] THEN
    SUBGOAL_THEN (← q r"inverse (f:B->B) y IN s") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inverse(f:B->B)")) THEN
      ASM_SIMP_TAC [GALOIS_GROUP_INVERSE, SUBSET, FORALL_IN_IMAGE],
      ASM_SIMP_TAC []] THEN
    ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_INVERSES])

  -- @@RETURN BEGIN
  return { GALOIS_GROUP_EXTEND_HOMOMORPHISM, GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE,
           NORMAL_EXTENSION_EQ_GALOIS_STABLE, GALOIS_GROUP_INTERMEDIATE_NORMAL_SUBGROUP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Normal intermediate fields, continued: restriction to a normal            -/
/- intermediate field s is an epimorphism onto the Galois group of s over k  -/
/- with kernel the Galois group of l over s, whence the quotient theorem.    -/
/- ------------------------------------------------------------------------- -/

structure GaloisRestriction where
  -- @@FIELDS
  GALOIS_CORRESPONDENCE_NORMAL : thm
  GALOIS_GROUP_RESTRICT : thm
  GALOIS_GROUP_RESTRICTION_HOMOMORPHISM : thm
  GALOIS_GROUP_RESTRICTION : thm
  GALOIS_GROUP_RESTRICTION_NORMAL : thm
  GALOIS_GROUP_QUOTIENT : thm
  GALOIS_EXTENSION_NORMAL_SUBGROUP : thm
  GALOIS_EXTENSION_GENERATED_CONJUGATES : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisRestriction [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtension : GaloisExtension) (BFixedFields : FixedFields) (BGaloisCorrespondence : GaloisCorrespondence) (BNormalIntermediate : NormalIntermediate) :
    ExceptT String IO GaloisRestriction := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
        EXISTS_IN_GSPEC, EXTENSION, FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
        FIELD_EXTENSION_SUBFIELD_GENERATED, FIELD_SUBFIELD_GENERATED,
        FINITE_EXTENSION_SUBFIELD_GENERATED, FINITE_IMP_FIELD_EXTENSION,
        FIRST_GROUP_EPIMORPHISM_THEOREM, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FORALL_IN_UNIONS, FUN_EQ_THM, GROUP_HOMOMORPHISM, .. } := D.core1
  let { IMAGE_I, IMAGE_UNIONS, IMP_CONJ, IN_ELIM_THM, IN_IMAGE, IN_UNIONS, I_O_ID,
        I_THM, MONO_EXISTS, NORMAL_IMP_ALGEBRAIC_EXTENSION, NORMAL_IMP_FIELD_EXTENSION,
        NORMAL_SUBGROUP_CONJUGATION, PERMUTES_INJECTIVE, PERMUTES_INVERSES,
        PERMUTES_INVERSE_INVERSE, PERMUTES_IN_IMAGE, .. } := D.core2
  let { RESTRICT_COMPOSE, RESTRICT_PERMUTES_EQ, RIGHT_FORALL_IMP_THM,
        RING_HOMOMORPHISM_COMPOSE, RING_HOMOMORPHISM_EQ,
        RING_HOMOMORPHISM_FROM_SUBFIELD_GENERATED, RING_HOMOMORPHISM_INTO_SUBRING,
        RING_HOMOMORPHISM_SUBFIELD_INCLUSION, RING_ISOMORPHISM, .. } := D.core3
  let { SEPARABLE_EXTENSION_SUBFIELD, SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE,
        SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, SUBFIELD_GENERATED_MONO,
        SUBFIELD_OF_IMP_SUBSET, SUBFIELD_SUBFIELD_GENERATED,
        SUBRING_EQ_SUBFIELD_GENERATED, SUBSET, SUBSET_ANTISYM,
        SUBSET_CARRIER_SUBFIELD_GENERATED, SUBSET_REFL, SUBSET_TRANS, UNIONS_SUBSET,
        field_extension, group_conjugation, group_epimorphism, group_homomorphism,
        group_kernel, o_THM, permutes, ring_automorphism, ring_homomorphism,
        ring_monomorphism, subfield_of, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_COMPOSE, GALOIS_GROUP_FIXES, GALOIS_GROUP_I,
        GALOIS_GROUP_INVERSE, GALOIS_GROUP_IN_CARRIER, GALOIS_GROUP_PERMUTES,
        GALOIS_GROUP_RING_HOMOMORPHISM, GALOIS_GROUP_RING_MONOMORPHISM,
        IN_GALOIS_GROUP, .. } := BGaloisGroup
  let { GALOIS_IMP_FIELD_EXTENSION, GALOIS_IMP_NORMAL_EXTENSION,
        GALOIS_IMP_SEPARABLE_EXTENSION, galois_extension, .. } := BGaloisExtension
  let { IN_FIXED_FIELD, .. } := BFixedFields
  let { FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE, IN_GALOIS_GROUP_INTERMEDIATE, .. } := BGaloisCorrespondence
  let { GALOIS_GROUP_EXTEND_HOMOMORPHISM, GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE,
        GALOIS_GROUP_INTERMEDIATE_NORMAL_SUBGROUP, NORMAL_EXTENSION_EQ_GALOIS_STABLE, .. } := BNormalIntermediate
  -- @@SCOPE END

  let GALOIS_CORRESPONDENCE_NORMAL ← prove
   r"!(h:A->B) k l s.
     galois_extension(k,l) h /\
     s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
     ==> (normal_extension(k,subfield_generated l s) h <=>
          group_carrier(galois_group(subfield_generated l s,l) I)
          normal_subgroup_of galois_group(k,l) h) /\
         (normal_extension(k,subfield_generated l s) h <=>
          !f. f IN group_carrier(galois_group(k,l) h) ==> IMAGE f s SUBSET s)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_NORMAL_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      NORMAL_EXTENSION_EQ_GALOIS_STABLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [] THEN
    EQ_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_INTERMEDIATE_NORMAL_SUBGROUP], ALL_TAC] THEN
    REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION] THEN
    DISCH_THEN (MP_TAC o CONJUNCT2) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_PERMUTES) THEN
    X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (fun th => tactic_of do pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
    REWRITE_TAC [IN_FIXED_FIELD] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [PERMUTES_IN_IMAGE, SUBFIELD_OF_IMP_SUBSET, SUBSET],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"t:B->B") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inverse(f:B->B)")) THEN
    ASM_SIMP_TAC [GALOIS_GROUP_INVERSE] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"t:B->B")) THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"h:A->B",
                      ← q r"group_conjugation (galois_group(k,l) (h:A->B))
                    (inverse f) t",
                      ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      IN_GALOIS_GROUP_INTERMEDIATE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"y:B") o CONJUNCT2) THEN
    ASM_REWRITE_TAC [group_conjugation, ← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP)] THEN
    ASM_SIMP_TAC [o_THM, ← MATCH_MP PERMUTES_INVERSE_INVERSE
     (← ASSUME (← q r"(f:B->B) permutes ring_carrier l"))] THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"f:B->B")) THEN
    ASM_MESON_TAC [PERMUTES_INVERSES])

  let GALOIS_GROUP_RESTRICT ← prove
   r"!(h:A->B) f k l s.
        s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
        f IN group_carrier(galois_group(k,l) h) /\ IMAGE f s = s
        ==> (\x. if x IN s then f x else x) IN
            group_carrier(galois_group(k,subfield_generated l s) h)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_PERMUTES) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM) THEN
    ABBREV_TAC (← q r"S = subfield_generated l (s:B->bool)") THEN
    SUBGOAL_THEN (← q r"ring_carrier S = (s:B->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(S,S) (f:B->B)") ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"S = subring_generated l (s:B->bool)")
       (fun th => GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [th])
      THENL
       [EXPAND_TAC "S" THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC SUBRING_EQ_SUBFIELD_GENERATED THEN
        ASM_MESON_TAC [subfield_of],
        MATCH_MP_TAC RING_HOMOMORPHISM_INTO_SUBRING THEN
        ASM_REWRITE_TAC [SUBSET_REFL] THEN EXPAND_TAC "S" THEN
        ASM_SIMP_TAC [RING_HOMOMORPHISM_FROM_SUBFIELD_GENERATED]],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [IN_GALOIS_GROUP, RESTRICT_PERMUTES_EQ] THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [PERMUTES_INJECTIVE],
      REWRITE_TAC [ring_automorphism, RING_ISOMORPHISM] THEN
      ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC RING_HOMOMORPHISM_EQ THEN EXISTS_TAC (← q r"f:B->B") THEN
        ASM_SIMP_TAC [],
        UNDISCH_TAC (← q r"IMAGE (f:B->B) s = s") THEN SET_TAC [],
        ASM_MESON_TAC [PERMUTES_INJECTIVE]],
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(h:A->B) x IN s") (fun th => REWRITE_TAC [th]) THENL
       [UNDISCH_TAC (← q r"IMAGE (h:A->B) (ring_carrier k) SUBSET s") THEN
        UNDISCH_TAC (← q r"(x:A) IN ring_carrier k") THEN SET_TAC [],
        ASM_MESON_TAC [GALOIS_GROUP_FIXES]]])

  let GALOIS_GROUP_RESTRICTION_HOMOMORPHISM ← prove
   r"!(h:A->B) k l s.
     field l /\ s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
     normal_extension(k,subfield_generated l s) h
     ==> group_homomorphism
           (galois_group(k,l) h,galois_group(k,subfield_generated l s) h)
           (\f x. if x IN s then f x else x) /\
         group_kernel
           (galois_group(k,l) h,galois_group(k,subfield_generated l s) h)
           (\f x. if x IN s then f x else x) =
         group_carrier(galois_group(subfield_generated l s,l) I)"
   (← do
    let t1 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!f:B->B. f IN group_carrier(galois_group(k,l) (h:A->B))
             ==> IMAGE f s = s /\
                 (\x. if x IN s then f x else x) IN
                 group_carrier(galois_group(k,subfield_generated l s) h)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      MATCH_MP_TAC t1 THEN CONJ_TAC THENL
       [MATCH_MP_TAC GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE THEN
        MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] THEN
        ASM_REWRITE_TAC [],
        DISCH_TAC THEN MATCH_MP_TAC GALOIS_GROUP_RESTRICT THEN
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [GROUP_HOMOMORPHISM] THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE], ALL_TAC] THEN
      REWRITE_TAC [← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP))] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
      MATCH_MP_TAC RESTRICT_COMPOSE THEN
      EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
      ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, SUBFIELD_OF_IMP_SUBSET],
      REWRITE_TAC [group_kernel, ← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)] THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"f:B->B") THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
        IN_GALOIS_GROUP_INTERMEDIATE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [FUN_EQ_THM, I_THM] THEN MESON_TAC []]))

  let GALOIS_GROUP_RESTRICTION ← prove
   r"!(h:A->B) k l s.
     normal_extension(k,l) h /\
     s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
     normal_extension(k,subfield_generated l s) h
     ==> group_epimorphism
           (galois_group(k,l) h,galois_group(k,subfield_generated l s) h)
           (\f x. if x IN s then f x else x) /\
         group_kernel
           (galois_group(k,l) h,galois_group(k,subfield_generated l s) h)
           (\f x. if x IN s then f x else x) =
         group_carrier(galois_group(subfield_generated l s,l) I)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"normal_extension(k:A ring,l:B ring) h"
      if !(concl th == c) then throw "check"
      pure ((ASSUME_TAC o MATCH_MP NORMAL_IMP_FIELD_EXTENSION) th)) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      GALOIS_GROUP_RESTRICTION_HOMOMORPHISM) THEN
    ASM_REWRITE_TAC [group_epimorphism] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [FIRST_ASSUM (fun th => tactic_of do
        if !(is_binary "group_homomorphism" (concl th)) then throw "check"
        pure ((ACCEPT_TAC o CONJUNCT1 o GEN_REWRITE_RULE I
               [group_homomorphism]) th)),
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_IMAGE] THEN X_GEN_TAC (← q r"t:B->B") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"t:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      GALOIS_GROUP_EXTEND_HOMOMORPHISM) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [SUBST1_TAC (← SYM (← CONJUNCT1 (← ISPEC (← q r"t:B->B") I_O_ID))) THEN
        MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN
        EXISTS_TAC (← q r"subfield_generated l (s:B->bool)") THEN
        REWRITE_TAC [RING_HOMOMORPHISM_SUBFIELD_INCLUSION] THEN
        ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM],
        ASM_MESON_TAC [GALOIS_GROUP_FIXES]],
      MATCH_MP_TAC MONO_EXISTS] THEN
    X_GEN_TAC (← q r"f:B->B") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"t IN group_carrier
             (galois_group(k,subfield_generated l s) (h:A->B))"
      if !(concl th == c) then throw "check"
      pure ((MP_TAC o MATCH_MP GALOIS_GROUP_PERMUTES) th)) THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
    REWRITE_TAC [permutes, FUN_EQ_THM] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"x:B") THEN COND_CASES_TAC THEN ASM_SIMP_TAC [])

  let GALOIS_GROUP_RESTRICTION_NORMAL ← prove
   r"!(h:A->B) k l s.
        field_extension(k,l) h /\ s subfield_of l /\
        normal_extension(k,subfield_generated l s) h
        ==> (!f. f IN group_carrier(galois_group(k,l) h) ==> IMAGE f s = s) /\
            group_homomorphism
             (galois_group(k,l) h,galois_group(k,subfield_generated l s) h)
             (\f x. if x IN s then f x else x) /\
            (normal_extension(k,l) h
             ==> group_epimorphism
                  (galois_group(k,l) h,galois_group(k,subfield_generated l s) h)
                  (\f x. if x IN s then f x else x))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN (← q r"IMAGE (h:A->B) (ring_carrier k) SUBSET s") ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP NORMAL_IMP_ALGEBRAIC_EXTENSION) THEN
      DISCH_THEN (MP_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
      ASM_SIMP_TAC [field_extension, ring_monomorphism, ring_homomorphism,
                    CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE],
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
                    GALOIS_GROUP_RESTRICTION_HOMOMORPHISM) THEN
      ASM_SIMP_TAC [],
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
                    GALOIS_GROUP_RESTRICTION) THEN
      ASM_SIMP_TAC []])

  let GALOIS_GROUP_QUOTIENT ← prove
   r"!(h:A->B) k l s.
     normal_extension(k,l) h /\
     s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
     normal_extension(k,subfield_generated l s) h
     ==> quotient_group (galois_group(k,l) h)
           (group_carrier(galois_group(subfield_generated l s,l) I))
         isomorphic_group galois_group(k,subfield_generated l s) h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      GALOIS_GROUP_RESTRICTION) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (SUBST1_TAC o SYM)) THEN
    MATCH_ACCEPT_TAC FIRST_GROUP_EPIMORPHISM_THEOREM)

  let GALOIS_EXTENSION_NORMAL_SUBGROUP ← prove
   r"!(h:A->B) k l s.
     galois_extension(k,l) h /\
     s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
     group_carrier(galois_group(subfield_generated l s,l) I)
     normal_subgroup_of galois_group(k,l) h
     ==> galois_extension(k,subfield_generated l s) h /\
         quotient_group (galois_group(k,l) h)
           (group_carrier(galois_group(subfield_generated l s,l) I))
         isomorphic_group galois_group(k,subfield_generated l s) h"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN (← q r"normal_extension(k,subfield_generated l s) (h:A->B)")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
        GALOIS_CORRESPONDENCE_NORMAL) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN (SUBST1_TAC o CONJUNCT1)] THEN
      FIRST_ASSUM ACCEPT_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [GALOIS_GROUP_QUOTIENT, GALOIS_IMP_NORMAL_EXTENSION] THEN
    ASM_REWRITE_TAC [galois_extension] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                      ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring"]
      SEPARABLE_EXTENSION_SUBFIELD) THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [I_O_ID, GALOIS_IMP_SEPARABLE_EXTENSION,
                  FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
                  FIELD_EXTENSION_SUBFIELD_GENERATED])

  /- In a finite Galois extension the subfield generated by the           -/
  /- conjugates of a subset s containing the image of k, the images of s  -/
  /- under the Galois group, is finite and Galois over k (the normal      -/
  /- closure of s).                                                        -/
  let GALOIS_EXTENSION_GENERATED_CONJUGATES ← prove
   r"!(h:A->B) k l s.
        finite_extension(k,l) h /\ galois_extension(k,l) h /\
        s SUBSET ring_carrier l /\ IMAGE h (ring_carrier k) SUBSET s
        ==> finite_extension
             (k,subfield_generated l
               (UNIONS {IMAGE f s | f IN group_carrier(galois_group(k,l) h)}))
             h /\
            galois_extension
             (k,subfield_generated l
               (UNIONS {IMAGE f s | f IN group_carrier(galois_group(k,l) h)}))
             h"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ABBREV_TAC
     (← q r"X = UNIONS {IMAGE f s | f IN group_carrier(galois_group(k,l) (h:A->B))}")
    THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"field(l:B ring)") ASSUME_TAC THENL
     [ASM_MESON_TAC [field_extension], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(s:B->bool) SUBSET X /\ X SUBSET ring_carrier l")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "X" THEN CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, IN_UNIONS, EXISTS_IN_GSPEC] THEN
        X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN EXISTS_TAC (← q r"I:B->B") THEN
        ASM_REWRITE_TAC [GALOIS_GROUP_I, IMAGE_I],
        REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC, SUBSET, FORALL_IN_IMAGE] THEN
        ASM_MESON_TAC [GALOIS_GROUP_IN_CARRIER, SUBSET]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!f. f IN group_carrier(galois_group(k,l) (h:A->B))
          ==> IMAGE f X SUBSET X")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN EXPAND_TAC "X" THEN
      REWRITE_TAC [IMAGE_UNIONS, SUBSET, FORALL_IN_UNIONS, IMP_CONJ,
                   RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"g:B->B") THEN DISCH_TAC THEN X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
      REWRITE_TAC [IN_UNIONS, EXISTS_IN_GSPEC] THEN
      EXISTS_TAC (← q r"(f:B->B) o (g:B->B)") THEN
      ASM_SIMP_TAC [GALOIS_GROUP_COMPOSE] THEN
      REWRITE_TAC [IN_IMAGE, o_THM] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"IMAGE (h:A->B) (ring_carrier k) SUBSET X") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [FINITE_EXTENSION_SUBFIELD_GENERATED] THEN
    SUBGOAL_THEN
     (← q r"normal_extension(k,subfield_generated l X) (h:A->B)")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                       ← q r"ring_carrier(subfield_generated l (X:B->bool))"]
        NORMAL_EXTENSION_EQ_GALOIS_STABLE) THEN
      ASM_SIMP_TAC [GALOIS_IMP_NORMAL_EXTENSION, SUBFIELD_SUBFIELD_GENERATED,
                    SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
      ANTS_TAC THENL
       [TRANS_TAC SUBSET_TRANS (← q r"X:B->bool") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC SUBSET_CARRIER_SUBFIELD_GENERATED THEN
        ASM_REWRITE_TAC [SUBSET_REFL],
        DISCH_THEN SUBST1_TAC] THEN
      X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"f:B->B", ← q r"X:B->bool"]
        SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE) THEN
      ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [GALOIS_GROUP_RING_MONOMORPHISM], ALL_TAC] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (h:A->B) (ring_carrier k) SUBSET
      ring_carrier(subfield_generated l X)")
    ASSUME_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"X:B->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_CARRIER_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [SUBSET_REFL],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"ring_carrier(subfield_generated l (X:B->bool))"]
      GALOIS_CORRESPONDENCE_NORMAL) THEN
    ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED,
                  SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"ring_carrier(subfield_generated l (X:B->bool))"]
      GALOIS_EXTENSION_NORMAL_SUBGROUP) THEN
    ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED,
                  SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED])

  -- @@RETURN BEGIN
  return { GALOIS_CORRESPONDENCE_NORMAL, GALOIS_GROUP_RESTRICT,
           GALOIS_GROUP_RESTRICTION_HOMOMORPHISM, GALOIS_GROUP_RESTRICTION,
           GALOIS_GROUP_RESTRICTION_NORMAL, GALOIS_GROUP_QUOTIENT,
           GALOIS_EXTENSION_NORMAL_SUBGROUP, GALOIS_EXTENSION_GENERATED_CONJUGATES }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The fundamental theorem of Galois theory for a finite Galois extension,   -/
/- collecting the correspondence, the order reversal in both directions, the -/
/- degrees and indices, normality and the quotient theorem.                  -/
/- ------------------------------------------------------------------------- -/

structure FundamentalTheorem where
  -- @@FIELDS
  FUNDAMENTAL_THEOREM_OF_GALOIS_THEORY : thm
  GALOIS_CYCLIC_INTERMEDIATE_UNIQUE : thm
  deriving Inhabited

@[nospecialize]
def setupFundamentalTheorem [HolBase] (D : GaloisDeps) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BGaloisCorrespondence : GaloisCorrespondence) (BGaloisRestriction : GaloisRestriction) :
    ExceptT String IO FundamentalTheorem := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, .. } := D
  let { CARD_EQ_0, CARD_LE_1, COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS, EQ_MULT_LCANCEL,
        FINITE_POWERSET, FINITE_SUBSET, GROUP_CARRIER_NONEMPTY, .. } := D.core1
  let { IN_ELIM_THM, IN_SING, LE_REFL, MEMBER_NOT_EMPTY, MULT_CLAUSES, MULT_SYM, .. } := D.core2
  let { SUBSET, divides, subgroup_of, .. } := D.core4
  let { FINITE_GALOIS_GROUP, .. } := BGaloisExtensions
  let { GALOIS_IMP_NORMAL_EXTENSION, .. } := BGaloisExtension
  let { FIXED_FIELD_ANTIMONO_EQ, FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE,
        GALOIS_CORRESPONDENCE_DEGREE, GALOIS_CORRESPONDENCE_INDEX,
        GALOIS_GROUP_ANTIMONO_EQ, GALOIS_GROUP_FIXED_FIELD,
        GALOIS_GROUP_INTERMEDIATE_SUBGROUP, .. } := BGaloisCorrespondence
  let { GALOIS_CORRESPONDENCE_NORMAL, GALOIS_GROUP_QUOTIENT, .. } := BGaloisRestriction
  -- @@SCOPE END

  let FUNDAMENTAL_THEOREM_OF_GALOIS_THEORY ← prove
   r"!(h:A->B) k l.
     finite_extension(k,l) h /\ galois_extension(k,l) h
     ==> (!H. H subgroup_of galois_group(k,l) h
              ==> fixed_field l H subfield_of l /\
                  IMAGE h (ring_carrier k) SUBSET fixed_field l H /\
                  group_carrier(galois_group
                    (subfield_generated l (fixed_field l H),l) I) = H) /\
         (!s. s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
              ==> group_carrier(galois_group(subfield_generated l s,l) I)
                  subgroup_of galois_group(k,l) h /\
                  fixed_field l
                    (group_carrier(galois_group(subfield_generated l s,l) I)) =
                  s) /\
         (!s t. s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
                t subfield_of l /\ IMAGE h (ring_carrier k) SUBSET t
                ==> (group_carrier
                      (galois_group(subfield_generated l t,l) I) SUBSET
                     group_carrier
                      (galois_group(subfield_generated l s,l) I) <=>
                     s SUBSET t)) /\
         (!G H. G subgroup_of galois_group(k,l) h /\
                H subgroup_of galois_group(k,l) h
                ==> (fixed_field l H SUBSET fixed_field l G <=> G SUBSET H)) /\
         (!s. s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
              ==> extension_degree(subfield_generated l s,l) I =
                  CARD(group_carrier
                        (galois_group(subfield_generated l s,l) I)) /\
                  extension_degree(k,subfield_generated l s) h *
                  CARD(group_carrier
                        (galois_group(subfield_generated l s,l) I)) =
                  CARD(group_carrier(galois_group(k,l) h)) /\
                  CARD {right_coset (galois_group(k,l) h)
                         (group_carrier
                           (galois_group(subfield_generated l s,l) I)) x |
                        x | x IN group_carrier(galois_group(k,l) h)} =
                  extension_degree(k,subfield_generated l s) h) /\
         (!s. s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s
              ==> (normal_extension(k,subfield_generated l s) h <=>
                   group_carrier(galois_group(subfield_generated l s,l) I)
                   normal_subgroup_of galois_group(k,l) h)) /\
         (!s. s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
              normal_extension(k,subfield_generated l s) h
              ==> quotient_group (galois_group(k,l) h)
                    (group_carrier(galois_group(subfield_generated l s,l) I))
                  isomorphic_group galois_group(k,subfield_generated l s) h)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_NORMAL_EXTENSION) THEN
    REPEAT CONJ_TAC THEN REPEAT GEN_TAC THEN STRIP_TAC THENL
     [MATCH_MP_TAC GALOIS_GROUP_FIXED_FIELD THEN ASM_REWRITE_TAC [],
      ASM_SIMP_TAC [GALOIS_GROUP_INTERMEDIATE_SUBGROUP] THEN
      MATCH_MP_TAC FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC GALOIS_GROUP_ANTIMONO_EQ THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC FIXED_FIELD_ANTIMONO_EQ THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN ASM_REWRITE_TAC [],
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
        GALOIS_CORRESPONDENCE_INDEX) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
        GALOIS_CORRESPONDENCE_DEGREE) THEN
      ASM_SIMP_TAC [],
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
        GALOIS_CORRESPONDENCE_NORMAL) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (ACCEPT_TAC o CONJUNCT1),
      MATCH_MP_TAC GALOIS_GROUP_QUOTIENT THEN ASM_REWRITE_TAC []])

  /- A cyclic Galois group has one intermediate field of each degree.     -/
  let GALOIS_CYCLIC_INTERMEDIATE_UNIQUE ← prove
   r"!(h:A->B) k l s t.
        finite_extension(k,l) h /\ galois_extension(k,l) h /\
        cyclic_group(galois_group(k,l) h) /\
        s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
        t subfield_of l /\ IMAGE h (ring_carrier k) SUBSET t /\
        extension_degree(k,subfield_generated l s) h =
        extension_degree(k,subfield_generated l t) h
        ==> s = t"
   (← do
    let m1 ← MESON [EQ_MULT_LCANCEL]
       (← q r"!a x y:num. ~(a = 0) /\ a * x = a * y ==> x = y")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      FUNDAMENTAL_THEOREM_OF_GALOIS_THEORY) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (fun th => tactic_of do
      let th2 ← CONJUNCT1 (← CONJUNCT2 th)
      let th5 ← CONJUNCT1 (← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 th))))
      pure (MP_TAC (← CONJ (← SPEC (← q r"s:B->bool") th2) (← SPEC (← q r"t:B->bool") th2)) THEN
            MP_TAC (← CONJ (← SPEC (← q r"s:B->bool") th5) (← SPEC (← q r"t:B->bool") th5)))) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC
     (← q r"Hs = group_carrier(galois_group(subfield_generated l s,l) (I:B->B))") THEN
    ABBREV_TAC
     (← q r"Ht = group_carrier(galois_group(subfield_generated l t,l) (I:B->B))") THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(Hs:(B->B)->bool) = Ht") (fun th =>
      ASM_MESON_TAC [th]) THEN
    SUBGOAL_THEN (← q r"FINITE(group_carrier(galois_group(k,l) (h:A->B)))")
    ASSUME_TAC THENL [ASM_SIMP_TAC [FINITE_GALOIS_GROUP], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"CARD(Hs:(B->B)->bool) = CARD(Ht:(B->B)->bool)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC m1 THEN
      EXISTS_TAC (← q r"extension_degree(k,subfield_generated l t) (h:A->B)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"galois_group(k,l) (h:A->B)") GROUP_CARRIER_NONEMPTY) THEN
      ASM_SIMP_TAC [CARD_EQ_0, ← GSYM MEMBER_NOT_EMPTY] THEN
      ASM_MESON_TAC [MULT_CLAUSES, CARD_EQ_0],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"CARD(Ht:(B->B)->bool) divides
                  CARD(group_carrier(galois_group(k,l) (h:A->B)))")
    ASSUME_TAC THENL
     [REWRITE_TAC [divides] THEN
      EXISTS_TAC (← q r"extension_degree(k,subfield_generated l t) (h:A->B)") THEN
      ASM_MESON_TAC [MULT_SYM],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"CARD(Ht:(B->B)->bool)"]
      COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"FINITE {H | H subgroup_of galois_group(k,l) (h:A->B) /\
                  CARD H = CARD(Ht:(B->B)->bool)}")
    ASSUME_TAC THENL
     [MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"{H | H SUBSET group_carrier(galois_group(k,l) (h:A->B))}") THEN
      ASM_SIMP_TAC [FINITE_POWERSET] THEN
      SIMP_TAC [SUBSET, IN_ELIM_THM, subgroup_of],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"{H | H subgroup_of galois_group(k,l) (h:A->B) /\
                       CARD H = CARD(Ht:(B->B)->bool)}") CARD_LE_1) THEN
    ASM_REWRITE_TAC [LE_REFL] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_SING] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"H0:(B->B)->bool")) THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"Hs:(B->B)->bool") th) THEN
            MP_TAC (← SPEC (← q r"Ht:(B->B)->bool") th))) THEN
    ASM_REWRITE_TAC [] THEN MESON_TAC []))

  -- @@RETURN BEGIN
  return { FUNDAMENTAL_THEOREM_OF_GALOIS_THEORY, GALOIS_CYCLIC_INTERMEDIATE_UNIQUE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The lattice of intermediate fields and conjugation: Galois groups over    -/
/- subfields generated by a set, composita, generators.                      -/
/- ------------------------------------------------------------------------- -/

structure GaloisLattice where
  -- @@FIELDS
  IN_GALOIS_GROUP_SUBFIELD_GENERATED : thm
  GALOIS_GROUP_COMPOSITUM : thm
  FIXED_FIELD_SUBGROUP_GENERATED : thm
  FIXED_FIELD_GALOIS_GROUP_GENERATORS : thm
  GALOIS_EXTENSION_GENERATORS_EQ : thm
  GALOIS_EXTENSION_SIMPLE_EQ : thm
  GALOIS_EXTENSION_SIMPLE_CYCLIC_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisLattice [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtension : GaloisExtension) (BFixedFields : FixedFields) (BArtin : Artin) (BGaloisIsomorphic : GaloisIsomorphic) (BGaloisCorrespondence : GaloisCorrespondence) :
    ExceptT String IO GaloisLattice := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXTENSION, FINITE_CYCLIC_SUBGROUP_EXPLICIT, FORALL_UNWIND_THM2, FUN_IN_IMAGE,
        GROUP_ID, GROUP_POW, .. } := D.core1
  let { GROUP_POW_EQ_ID, IN_ELIM_THM, IN_INTER, IN_SING, IN_UNION, I_THM,
        PERMUTES_INVERSES, .. } := D.core2
  let { RING_AUTOMORPHISM_IMP_ENDOMORPHISM, RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core3
  let { SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, SUBFIELD_GENERATED_EQ,
        SUBFIELD_GENERATED_INC_GEN, SUBFIELD_GENERATED_MINIMAL_EQ,
        SUBFIELD_GENERATED_SUBSET_CARRIER, SUBFIELD_OF_FIXPOINTS,
        SUBFIELD_SUBFIELD_GENERATED, SUBGROUP_GENERATED_ELEMENT_ORDER,
        SUBGROUP_GENERATED_MINIMAL, SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET, SUBSET,
        SUBSET_ANTISYM, field_extension, o_THM, permutes, ring_homomorphism,
        subgroup_of, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_COMPOSE, GALOIS_GROUP_INVERSE,
        GALOIS_GROUP_PERMUTES, IN_GALOIS_GROUP, .. } := BGaloisGroup
  let { GALOIS_IMP_FIELD_EXTENSION, .. } := BGaloisExtension
  let { FIXED_FIELD_ANTIMONO, IN_FIXED_FIELD, .. } := BFixedFields
  let { FIXED_FIELD_GALOIS_GROUP, .. } := BArtin
  let { GALOIS_GROUP_EQ_ON_GENERATORS, .. } := BGaloisIsomorphic
  let { FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE, .. } := BGaloisCorrespondence
  -- @@SCOPE END

  let IN_GALOIS_GROUP_SUBFIELD_GENERATED ← prove
   r"!(l:B ring) s f.
        field l
        ==> (f IN group_carrier(galois_group(subfield_generated l s,l) I) <=>
             f permutes ring_carrier l /\ ring_automorphism l f /\
             !x. x IN s ==> f x = x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [IN_GALOIS_GROUP, I_THM] THEN
    ASM_CASES_TAC (← q r"(f:B->B) permutes ring_carrier l") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"ring_automorphism l (f:B->B)") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"(x:B) IN ring_carrier l") THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN
        MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN ASM_REWRITE_TAC [],
        ASM_MESON_TAC [permutes]],
      SUBGOAL_THEN
       (← q r"ring_carrier(subfield_generated l (s:B->bool)) SUBSET
      {x | x IN ring_carrier l /\ (f:B->B) x = x}")
      MP_TAC THENL
       [ASM_SIMP_TAC [SUBFIELD_GENERATED_MINIMAL_EQ, SUBFIELD_OF_FIXPOINTS,
                      RING_AUTOMORPHISM_IMP_ENDOMORPHISM] THEN
        ASM SET_TAC [],
        SET_TAC []]])

  let GALOIS_GROUP_COMPOSITUM ← prove
   r"!(l:B ring) s t.
        field l
        ==> group_carrier(galois_group(subfield_generated l (s UNION t),l) I) =
            group_carrier(galois_group(subfield_generated l s,l) I) INTER
            group_carrier(galois_group(subfield_generated l t,l) I)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [EXTENSION, IN_INTER] THEN
    ASM_SIMP_TAC [IN_GALOIS_GROUP_SUBFIELD_GENERATED, IN_UNION] THEN
    MESON_TAC [])

  let FIXED_FIELD_SUBGROUP_GENERATED ← prove
   r"!(h:A->B) k l G.
        G SUBSET group_carrier(galois_group(k,l) h)
        ==> fixed_field l
              (group_carrier(subgroup_generated (galois_group(k,l) h) G)) =
            fixed_field l G"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC FIXED_FIELD_ANTIMONO THEN
      MATCH_MP_TAC SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_FIXED_FIELD] THEN X_GEN_TAC (← q r"a:B") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"group_carrier(subgroup_generated (galois_group(k,l) (h:A->B)) G) SUBSET
    {f | f IN group_carrier(galois_group(k,l) h) /\ f a = a}")
    MP_TAC THENL [ALL_TAC, SET_TAC []] THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [subgroup_of, SUBSET, IN_ELIM_THM, ← CONJUNCT2 GALOIS_GROUP] THEN
    SIMP_TAC [I_THM] THEN REPEAT CONJ_TAC THENL
     [MP_TAC (← ISPEC (← q r"galois_group(k:A ring,l:B ring) h") GROUP_ID) THEN
      REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)],
      X_GEN_TAC (← q r"f:B->B") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [GALOIS_GROUP_INVERSE] THEN
      FIRST_ASSUM (MP_TAC o CONJUNCT2 o MATCH_MP PERMUTES_INVERSES o
        MATCH_MP GALOIS_GROUP_PERMUTES) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:B")) THEN ASM_REWRITE_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [GALOIS_GROUP_COMPOSE, o_THM]])

  let FIXED_FIELD_GALOIS_GROUP_GENERATORS ← prove
   r"!(h:A->B) k l G.
        galois_extension(k,l) h /\
        G SUBSET group_carrier(galois_group(k,l) h) /\
        subgroup_generated (galois_group(k,l) h) G = galois_group(k,l) h
        ==> fixed_field l G = IMAGE h (ring_carrier k)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"G:(B->B)->bool"]
      FIXED_FIELD_SUBGROUP_GENERATED) THEN
    ASM_SIMP_TAC [FIXED_FIELD_GALOIS_GROUP] THEN MESON_TAC [])

  let GALOIS_EXTENSION_GENERATORS_EQ ← prove
   r"!(h:A->B) k l s.
        galois_extension(k,l) h
        ==> (subfield_generated l (IMAGE h (ring_carrier k) UNION s) = l <=>
             !f. f IN group_carrier(galois_group(k,l) h) /\
                 (!x. x IN s ==> f x = x)
                 ==> f = I)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"f:B->B") THEN STRIP_TAC THEN
      MATCH_MP_TAC GALOIS_GROUP_EQ_ON_GENERATORS THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"] THEN
      ASM_REWRITE_TAC [I_THM] THEN
      MP_TAC (← ISPEC (← q r"galois_group(k:A ring,l:B ring) h") GROUP_ID) THEN
      REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
      ← q r"ring_carrier(subfield_generated l
       (IMAGE (h:A->B) (ring_carrier k) UNION s))"]
     FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE) THEN
    ASM_REWRITE_TAC [SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
    SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED, ← ASSUME (← q r"field(l:B ring)")] THEN
    ANTS_TAC THENL
     [MP_TAC (← ISPECL [← q r"l:B ring", ← q r"IMAGE (h:A->B) (ring_carrier k) UNION s"]
        SUBFIELD_GENERATED_SUBSET_CARRIER) THEN
      FIRST_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE I [ring_homomorphism] o
        MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
      SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [SUBFIELD_GENERATED_EQ] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [EXTENSION, IN_FIXED_FIELD] THEN X_GEN_TAC (← q r"x:B") THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN X_GEN_TAC (← q r"f:B->B") THEN
    SIMP_TAC [IN_GALOIS_GROUP_SUBFIELD_GENERATED, ← ASSUME (← q r"field(l:B ring)"),
              IN_UNION] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"f = (I:B->B)") (fun th => REWRITE_TAC [th, I_THM]) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [IN_GALOIS_GROUP] THEN
    ASM_MESON_TAC [FUN_IN_IMAGE])

  let GALOIS_EXTENSION_SIMPLE_EQ ← prove
   r"!(h:A->B) k l a.
        galois_extension(k,l) h
        ==> (subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l <=>
             !f. f IN group_carrier(galois_group(k,l) h) /\ f a = a ==> f = I)"
   (← do
    let s1 ← SET_RULE (← q r"(a:B) INSERT s = s UNION {a}")
    pure (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [s1] THEN
    ASM_SIMP_TAC [GALOIS_EXTENSION_GENERATORS_EQ, IN_SING, FORALL_UNWIND_THM2]))

  let GALOIS_EXTENSION_SIMPLE_CYCLIC_EQ ← prove
   r"!(h:A->B) g k l a.
        galois_extension(k,l) h /\
        FINITE(group_carrier(galois_group(k,l) h)) /\
        g IN group_carrier(galois_group(k,l) h) /\
        subgroup_generated (galois_group(k,l) h) {g} = galois_group(k,l) h
        ==> (subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l <=>
             !j. group_pow (galois_group(k,l) h) g j a = a
                 ==> CARD(group_carrier(galois_group(k,l) h)) divides j)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [GALOIS_EXTENSION_SIMPLE_EQ] THEN
    SUBGOAL_THEN
     (← q r"!j. group_pow (galois_group(k,l) (h:A->B)) g j = I <=>
        CARD(group_carrier(galois_group(k,l) h)) divides j")
    (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THENL
     [GEN_TAC THEN
      MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"g:B->B"]
        SUBGROUP_GENERATED_ELEMENT_ORDER) THEN
      MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"g:B->B", ← q r"j:num"]
        GROUP_POW_EQ_ID) THEN
      ASM_REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [GROUP_POW],
      X_GEN_TAC (← q r"f:B->B") THEN STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"g:B->B"]
      FINITE_CYCLIC_SUBGROUP_EXPLICIT) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"f:B->B") o REWRITE_RULE [EXTENSION]) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"j:num") (SUBST_ALL_TAC o CONJUNCT2)) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN FIRST_ASSUM ACCEPT_TAC)

  -- @@RETURN BEGIN
  return { IN_GALOIS_GROUP_SUBFIELD_GENERATED, GALOIS_GROUP_COMPOSITUM,
           FIXED_FIELD_SUBGROUP_GENERATED, FIXED_FIELD_GALOIS_GROUP_GENERATORS,
           GALOIS_EXTENSION_GENERATORS_EQ, GALOIS_EXTENSION_SIMPLE_EQ,
           GALOIS_EXTENSION_SIMPLE_CYCLIC_EQ }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The lattice of intermediate fields and conjugation, continued:            -/
/- intersections and conjugates.                                             -/
/- ------------------------------------------------------------------------- -/

structure GaloisLattice2 where
  -- @@FIELDS
  GALOIS_GROUP_INTER : thm
  FIXED_FIELD_INTER : thm
  FIXED_FIELD_CONJUGATE : thm
  GALOIS_GROUP_CONJUGATE : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisLattice2 [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BFixedFields : FixedFields) (BArtin : Artin) (BGaloisCorrespondence : GaloisCorrespondence) (BGaloisLattice : GaloisLattice) :
    ExceptT String IO GaloisLattice2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, .. } := D
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, EXTENSION, FINITE_IMP_FIELD_EXTENSION,
        FINITE_SUBSET, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IMAGE_I, IN_IMAGE, I_THM, PERMUTES_COMPOSE, PERMUTES_INVERSE,
        PERMUTES_INVERSES, PERMUTES_IN_IMAGE, .. } := D.core2
  let { RING_AUTOMORPHISM_COMPOSE, RING_ISOMORPHISM_IMP_MONOMORPHISM, .. } := D.core3
  let { SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED,
        SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET, SUBFIELD_OF_MONOMORPHIC_IMAGE,
        SUBFIELD_SUBFIELD_GENERATED, SUBGROUP_SUBGROUP_GENERATED, SUBSET, SUBSET_TRANS,
        SUBSET_UNION, UNION_SUBSET, field_extension, o_THM, ring_automorphism,
        subgroup_of, .. } := D.core4
  let { GALOIS_GROUP_INVERSE, GALOIS_GROUP_PERMUTES, GALOIS_GROUP_RING_AUTOMORPHISM,
        IN_GALOIS_GROUP, .. } := BGaloisGroup
  let { CARD_GALOIS_GROUP_LE, .. } := BGaloisExtensions
  let { FIXED_FIELD_SUBSET, FIXED_FIELD_UNION, IN_FIXED_FIELD, .. } := BFixedFields
  let { ARTIN_FIXED_FIELD, .. } := BArtin
  let { FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE, GALOIS_GROUP_FIXED_FIELD,
        GALOIS_GROUP_INTERMEDIATE_SUBGROUP, SUBGROUP_OF_GALOIS_GROUP, .. } := BGaloisCorrespondence
  let { FIXED_FIELD_SUBGROUP_GENERATED, GALOIS_GROUP_COMPOSITUM, .. } := BGaloisLattice
  -- @@SCOPE END

  let GALOIS_GROUP_INTER ← prove
   r"!(h:A->B) k l s t.
        finite_extension(k,l) h /\ galois_extension(k,l) h /\
        s subfield_of l /\ t subfield_of l /\
        IMAGE h (ring_carrier k) SUBSET s /\ IMAGE h (ring_carrier k) SUBSET t
        ==> group_carrier(galois_group(subfield_generated l (s INTER t),l) I) =
            group_carrier(subgroup_generated (galois_group(k,l) h)
              (group_carrier(galois_group(subfield_generated l s,l) I) UNION
               group_carrier(galois_group(subfield_generated l t,l) I)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      GALOIS_GROUP_INTERMEDIATE_SUBGROUP) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"t:B->bool"]
      GALOIS_GROUP_INTERMEDIATE_SUBGROUP) THEN
    ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
    ABBREV_TAC
     (← q r"K = group_carrier(subgroup_generated (galois_group(k,l) (h:A->B))
          (group_carrier(galois_group(subfield_generated l s,l) I) UNION
           group_carrier(galois_group(subfield_generated l t,l) I)))") THEN
    SUBGOAL_THEN (← q r"fixed_field l (K:(B->B)->bool) = s INTER t") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN
      wPart lhand (fun t => do lhand (← rand t)) FIXED_FIELD_SUBGROUP_GENERATED THEN
      ANTS_TAC THENL
       [REWRITE_TAC [UNION_SUBSET] THEN ASM_MESON_TAC [subgroup_of],
        DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [FIXED_FIELD_UNION] THEN BINOP_TAC THEN
      MATCH_MP_TAC FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"K:(B->B)->bool"]
      GALOIS_GROUP_FIXED_FIELD) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN EXPAND_TAC "K" THEN
      REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED],
      ASM_SIMP_TAC []])

  let FIXED_FIELD_INTER ← prove
   r"!(h:A->B) k l G H.
        finite_extension(k,l) h /\
        G subgroup_of galois_group(k,l) h /\ H subgroup_of galois_group(k,l) h
        ==> fixed_field l (G INTER H) =
            ring_carrier(subfield_generated l
              (fixed_field l G UNION fixed_field l H))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"G:(B->B)->bool"]
      GALOIS_GROUP_FIXED_FIELD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"H:(B->B)->bool"]
      GALOIS_GROUP_FIXED_FIELD) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"galois_extension(subfield_generated l (fixed_field l G),l) (I:B->B)")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"l:B ring", ← q r"G:(B->B)->bool"] ARTIN_FIXED_FIELD) THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      MP_TAC (← GEN_REWRITE_RULE I [SUBGROUP_OF_GALOIS_GROUP]
       (← ASSUME (← q r"G subgroup_of galois_group(k,l) (h:A->B)"))) THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"group_carrier(galois_group(k:A ring,l:B ring) h)") THEN
        ASM_SIMP_TAC [CARD_GALOIS_GROUP_LE],
        ASM_MESON_TAC [SUBSET, GALOIS_GROUP_RING_AUTOMORPHISM]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"I:B->B", ← q r"subfield_generated l (fixed_field l (G:(B->B)->bool))",
      ← q r"l:B ring",
      ← q r"ring_carrier(subfield_generated l
       (fixed_field l G UNION fixed_field l (H:(B->B)->bool)))"]
     FIXED_FIELD_GALOIS_GROUP_INTERMEDIATE) THEN
    ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED, IMAGE_I,
                  CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"fixed_field l G UNION fixed_field l (H:(B->B)->bool)") THEN
      REWRITE_TAC [SUBSET_UNION] THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET THEN
      REWRITE_TAC [UNION_SUBSET, FIXED_FIELD_SUBSET],
      ALL_TAC] THEN
    REWRITE_TAC [SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
    ASM_SIMP_TAC [GALOIS_GROUP_COMPOSITUM])

  let FIXED_FIELD_CONJUGATE ← prove
   r"!(l:B ring) f H.
        f permutes ring_carrier l
        ==> fixed_field l (IMAGE (\g. f o g o inverse f) H) =
            IMAGE f (fixed_field l H)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP PERMUTES_INVERSES) THEN
    REWRITE_TAC [EXTENSION, IN_FIXED_FIELD, IN_IMAGE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_THM] THEN X_GEN_TAC (← q r"x:B") THEN EQ_TAC THENL
     [STRIP_TAC THEN EXISTS_TAC (← q r"inverse (f:B->B) x") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [PERMUTES_IN_IMAGE, PERMUTES_INVERSE], ALL_TAC] THEN
      X_GEN_TAC (← q r"g:B->B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"g:B->B")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"inverse(f:B->B)")) THEN ASM_REWRITE_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:B") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [PERMUTES_IN_IMAGE]])

  let GALOIS_GROUP_CONJUGATE ← prove
   r"!(h:A->B) k l f s.
        f IN group_carrier(galois_group(k,l) h) /\ s subfield_of l
        ==> group_carrier(galois_group(subfield_generated l (IMAGE f s),l) I) =
            IMAGE (\g. f o g o inverse f)
              (group_carrier(galois_group(subfield_generated l s,l) I))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_PERMUTES) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_RING_AUTOMORPHISM) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP PERMUTES_INVERSES) THEN
    SUBGOAL_THEN
     (← q r"inverse(f:B->B) permutes ring_carrier l /\ ring_automorphism l (inverse f)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_INVERSE, GALOIS_GROUP_PERMUTES,
                     GALOIS_GROUP_RING_AUTOMORPHISM],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"IMAGE (f:B->B) s subfield_of l") ASSUME_TAC THENL
     [MATCH_MP_TAC SUBFIELD_OF_MONOMORPHIC_IMAGE THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_MESON_TAC [ring_automorphism, RING_ISOMORPHISM_IMP_MONOMORPHISM],
      ALL_TAC] THEN
    REWRITE_TAC [EXTENSION] THEN X_GEN_TAC (← q r"g:B->B") THEN
    GEN_REWRITE_TAC RAND_CONV [IN_IMAGE] THEN
    ASM_SIMP_TAC [IN_GALOIS_GROUP, I_THM, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
                  FORALL_IN_IMAGE] THEN
    EQ_TAC THENL
     [STRIP_TAC THEN EXISTS_TAC (← q r"inverse(f:B->B) o g o f") THEN
      ASM_REWRITE_TAC [FUN_EQ_THM, o_THM] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [PERMUTES_COMPOSE],
        ASM_MESON_TAC [RING_AUTOMORPHISM_COMPOSE],
        ASM_SIMP_TAC []],
      DISCH_THEN (X_CHOOSE_THEN (← q r"g':B->B") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [o_THM] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [PERMUTES_COMPOSE],
        ASM_MESON_TAC [RING_AUTOMORPHISM_COMPOSE],
        ASM_SIMP_TAC []]])

  -- @@RETURN BEGIN
  return { GALOIS_GROUP_INTER, FIXED_FIELD_INTER, FIXED_FIELD_CONJUGATE,
           GALOIS_GROUP_CONJUGATE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Natural irrationalities and composita of Galois extensions. If s is       -/
/- finite and Galois over the image of k and t is any intermediate field,    -/
/- then the compositum of s and t is finite and Galois over t, and           -/
/- restriction to s is an isomorphism from its Galois group over t onto the  -/
/- Galois group of s over s INTER t (Lang, Algebra, VI 1.12); so the degree  -/
/- of the compositum over t divides the degree of s over k (VI 1.13).        -/
/- ------------------------------------------------------------------------- -/

structure NaturalIrrationalities where
  -- @@FIELDS
  GALOIS_EXTENSION_LIFT : thm
  GALOIS_COMPOSITUM_MONOMORPHISM : thm
  GALOIS_COMPOSITUM : thm
  GALOIS_COMPOSITUM_DEGREE : thm
  deriving Inhabited

@[nospecialize]
def setupNaturalIrrationalities [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BFixedFields : FixedFields) (BArtin : Artin) (BGaloisIsomorphic : GaloisIsomorphic) (BGaloisCorrespondence : GaloisCorrespondence) (BNormalIntermediate : NormalIntermediate) (BGaloisRestriction : GaloisRestriction) :
    ExceptT String IO NaturalIrrationalities := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, TAUT, .. } := D
  let { CARD_EQ_CARD, CARRIER_SUBFIELD_GENERATED_SUBFIELD, CARRIER_SUBGROUP_OF,
        DIVIDES_LMUL, DIVIDES_REFL, EXTENSION, EXTENSION_DEGREE_TOWER_LAW,
        FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
        FIELD_EXTENSION_SUBFIELD_GENERATED, FIELD_EXTENSION_TRANS,
        FIELD_SUBFIELD_GENERATED, FINITE_EXTENSION_SUBFIELD_GENERATED,
        FINITE_IMP_FIELD_EXTENSION, FORALL_IN_IMAGE, GROUP_HOMOMORPHISM,
        GROUP_ISOMORPHISM_IMP_ISOMORPHIC, GROUP_MONOMORPHISM_EPIMORPHISM, .. } := D.core1
  let { IMAGE_I, INTER_SUBSET, IN_INTER, ISOMORPHIC_GROUP_CARD_EQ, I_O_ID, I_THM, .. } := D.core2
  let { POLY_SEPARABLE_MONOMORPHIC_IMAGE, RESTRICT_COMPOSE, .. } := D.core3
  let { SPLITTING_EXTENSION_IN_POLY_RING, SPLITTING_EXTENSION_LIFT,
        SUBFIELD_GENERATED_IDEMPOT_GEN, SUBFIELD_GENERATED_INC_GEN,
        SUBFIELD_OF_IMP_SUBSET, SUBFIELD_OF_INTER, SUBFIELD_OF_SUBFIELD_GENERATED,
        SUBGROUP_OF_HOMOMORPHIC_IMAGE, SUBSET, SUBSET_CARRIER_SUBFIELD_GENERATED,
        SUBSET_INTER, SUBSET_UNION, UNION_SUBSET, field_extension, group_epimorphism,
        group_monomorphism, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_ANTIMONO, GALOIS_GROUP_FIXES, GALOIS_GROUP_PERMUTES,
        IN_GALOIS_GROUP, .. } := BGaloisGroup
  let { FINITE_GALOIS_GROUP, .. } := BGaloisExtensions
  let { GALOIS_EXTENSION_EQ_CARD, GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING,
        GALOIS_IMP_NORMAL_EXTENSION, .. } := BGaloisExtension
  let { IN_FIXED_FIELD, .. } := BFixedFields
  let { FIXED_FIELD_GALOIS_GROUP, .. } := BArtin
  let { GALOIS_GROUP_EQ_ON_GENERATORS, .. } := BGaloisIsomorphic
  let { GALOIS_EXTENSION_SUBFIELD_GENERATED, GALOIS_GROUP_FIXED_FIELD, .. } := BGaloisCorrespondence
  let { GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE, .. } := BNormalIntermediate
  let { GALOIS_GROUP_RESTRICT, .. } := BGaloisRestriction
  -- @@SCOPE END

  let GALOIS_EXTENSION_LIFT ← prove
   r"!(h:A->B) k l s t.
        field l /\ s subfield_of l /\ t subfield_of l /\
        IMAGE h (ring_carrier k) SUBSET t /\
        finite_extension(k,subfield_generated l s) h /\
        galois_extension(k,subfield_generated l s) h
        ==> finite_extension
              (subfield_generated l t,subfield_generated l (s UNION t)) I /\
            galois_extension
              (subfield_generated l t,subfield_generated l (s UNION t)) I"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)"]
      GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:(1->num)->A") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING] THEN
    EXISTS_TAC (← q r"(h:A->B) o (p:(1->num)->A)") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC SPLITTING_EXTENSION_LIFT THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC POLY_SEPARABLE_MONOMORPHIC_IMAGE THEN
    EXISTS_TAC (← q r"k:A ring") THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    ASM_MESON_TAC [SPLITTING_EXTENSION_IN_POLY_RING,
                   FIELD_EXTENSION_IMP_HOMOMORPHISM,
                   FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
                   FIELD_EXTENSION_TRANS, FIELD_EXTENSION_SUBFIELD_GENERATED,
                   FINITE_IMP_FIELD_EXTENSION, I_O_ID])

  let GALOIS_COMPOSITUM_MONOMORPHISM ← prove
   r"!(h:A->B) k l s t.
        field l /\ s subfield_of l /\ t subfield_of l /\
        IMAGE h (ring_carrier k) SUBSET s /\
        IMAGE h (ring_carrier k) SUBSET t /\
        normal_extension(k,subfield_generated l s) h
        ==> group_monomorphism
              (galois_group
                (subfield_generated l t,subfield_generated l (s UNION t)) I,
               galois_group
                (subfield_generated l (s INTER t),subfield_generated l s) I)
              (\f x. if x IN s then f x else x)"
   (← do
    let t1 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(s:B->bool) SUBSET ring_carrier(subfield_generated l (s UNION t)) /\
    (t:B->bool) SUBSET ring_carrier(subfield_generated l (s UNION t))")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC SUBSET_CARRIER_SUBFIELD_GENERATED THEN
      ASM_SIMP_TAC [SUBFIELD_OF_IMP_SUBSET] THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field(subfield_generated l (s UNION t:B->bool))") ASSUME_TAC
    THENL [ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(s:B->bool) subfield_of subfield_generated l (s UNION t)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC SUBFIELD_OF_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [SUBSET_UNION],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!f. f IN group_carrier(galois_group(subfield_generated l t,
                                        subfield_generated l (s UNION t))
                                       (I:B->B))
        ==> f IN group_carrier
                  (galois_group(k,subfield_generated l (s UNION t))
                               (h:A->B)) /\
            IMAGE f s = s")
    (LABEL_TAC "res") THENL
     [X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      MATCH_MP_TAC t1 THEN CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                          ← q r"subfield_generated l (t:B->bool)",
                          ← q r"subfield_generated l (s UNION t:B->bool)"]
          GALOIS_GROUP_ANTIMONO) THEN
        ASM_SIMP_TAC [IMAGE_I, CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
        ASM SET_TAC [],
        DISCH_TAC THEN MATCH_MP_TAC GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE THEN
        MAP_EVERY EXISTS_TAC
         [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s UNION t:B->bool)"] THEN
        ASM_SIMP_TAC [SUBFIELD_GENERATED_IDEMPOT_GEN]],
      ALL_TAC] THEN
    REWRITE_TAC [group_monomorphism, GROUP_HOMOMORPHISM, SUBSET,
                 FORALL_IN_IMAGE] THEN
    REWRITE_TAC [← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP))] THEN
    REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:B->B") THEN DISCH_THEN (fun th =>
        ASSUME_TAC th THEN USE_THEN "res" (fun r => tactic_of do
          pure (STRIP_ASSUME_TAC (← MATCH_MP r th)))) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring",
                        ← q r"subfield_generated l (s UNION t:B->bool)", ← q r"s:B->bool"]
        GALOIS_GROUP_RESTRICT) THEN
      ASM_SIMP_TAC [SUBFIELD_GENERATED_IDEMPOT_GEN, IN_GALOIS_GROUP] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, SUBFIELD_OF_INTER,
                    IN_INTER, I_THM] THEN
      X_GEN_TAC (← q r"x:B") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"f:B->B", ← q r"subfield_generated l (t:B->bool)",
                        ← q r"subfield_generated l (s UNION t:B->bool)", ← q r"x:B"]
        GALOIS_GROUP_FIXES) THEN
      ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, I_THM],
      MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
      MATCH_MP_TAC RESTRICT_COMPOSE THEN
      EXISTS_TAC (← q r"ring_carrier(subfield_generated l (s UNION t:B->bool))") THEN
      ASM_MESON_TAC [GALOIS_GROUP_PERMUTES],
      MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"I:B->B") GALOIS_GROUP_EQ_ON_GENERATORS) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"subfield_generated l (t:B->bool)",
        ← q r"subfield_generated l (s UNION t:B->bool)", ← q r"s:B->bool"] THEN
      ASM_SIMP_TAC [IMAGE_I, CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
      CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"t UNION s:B->bool = s UNION t") SUBST1_TAC THENL
         [SET_TAC [], ASM_SIMP_TAC [SUBFIELD_GENERATED_IDEMPOT_GEN, UNION_SUBSET]],
        X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          let ok := is_eq (concl th) &&
            (match lhs (concl th) with | .ok t => is_abs t | .error _ => false)
          if !ok then throw "check"
          pure (MP_TAC (← AP_THM th (← q r"x:B")))) THEN
        ASM_REWRITE_TAC []]]))

  let GALOIS_COMPOSITUM ← prove
   r"!(h:A->B) k l s t.
        field l /\ s subfield_of l /\ t subfield_of l /\
        IMAGE h (ring_carrier k) SUBSET s /\
        IMAGE h (ring_carrier k) SUBSET t /\
        finite_extension(k,subfield_generated l s) h /\
        galois_extension(k,subfield_generated l s) h
        ==> finite_extension
              (subfield_generated l t,subfield_generated l (s UNION t)) I /\
            galois_extension
              (subfield_generated l t,subfield_generated l (s UNION t)) I /\
            group_isomorphism
              (galois_group
                (subfield_generated l t,subfield_generated l (s UNION t)) I,
               galois_group
                (subfield_generated l (s INTER t),subfield_generated l s) I)
              (\f x. if x IN s then f x else x)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_EXTENSION_LIFT) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_COMPOSITUM_MONOMORPHISM) THEN
    ASM_SIMP_TAC [GALOIS_IMP_NORMAL_EXTENSION] THEN DISCH_TAC THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    ASM_REWRITE_TAC [group_epimorphism] THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o GEN_REWRITE_RULE I
     [group_monomorphism]) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC
     (← q r"H = IMAGE (\f x. if x IN s then f x else x)
          (group_carrier(galois_group(subfield_generated l t,
                                      subfield_generated l (s UNION t))
                                     (I:B->B)))") THEN
    SUBGOAL_THEN
     (← q r"H subgroup_of galois_group(subfield_generated l (s INTER t),
                               subfield_generated l s) (I:B->B)")
    ASSUME_TAC THENL
     [EXPAND_TAC "H" THEN MATCH_MP_TAC SUBGROUP_OF_HOMOMORPHIC_IMAGE THEN
      EXISTS_TAC
       (← q r"galois_group(subfield_generated l t,subfield_generated l (s UNION t))
                  (I:B->B)") THEN
      ASM_REWRITE_TAC [CARRIER_SUBGROUP_OF],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"finite_extension(subfield_generated l (s INTER t),subfield_generated l s)
                    (I:B->B)")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)",
                        ← q r"s INTER t:B->bool"]
        FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
      ASM_SIMP_TAC [SUBSET_INTER, SUBFIELD_GENERATED_IDEMPOT_GEN, INTER_SUBSET,
                    CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"subfield_generated l (s INTER t:B->bool)",
                      ← q r"subfield_generated l (s:B->bool)", ← q r"H:(B->B)->bool"]
      GALOIS_GROUP_FIXED_FIELD) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (GEN_REWRITE_TAC LAND_CONV [← SYM (← CONJUNCT2 (← CONJUNCT2 th))])) THEN
    SUBGOAL_THEN (← q r"fixed_field (subfield_generated l s) H = s INTER (t:B->bool)")
    SUBST1_TAC THENL
     [EXPAND_TAC "H" THEN
      REWRITE_TAC [EXTENSION, IN_FIXED_FIELD, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, IN_INTER] THEN
      X_GEN_TAC (← q r"x:B") THEN ASM_CASES_TAC (← q r"(x:B) IN s") THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"subfield_generated l (t:B->bool)",
                        ← q r"subfield_generated l (s UNION t:B->bool)"]
        FIXED_FIELD_GALOIS_GROUP) THEN
      ASM_SIMP_TAC [IMAGE_I, CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:B") o GEN_REWRITE_RULE I [EXTENSION]) THEN
      REWRITE_TAC [IN_FIXED_FIELD] THEN
      SUBGOAL_THEN (← q r"(x:B) IN ring_carrier(subfield_generated l (s UNION t))")
        (fun th => REWRITE_TAC [th]) THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
      UNDISCH_TAC (← q r"(x:B) IN s") THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"s:B->bool"] SUBFIELD_OF_IMP_SUBSET) THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [],
      ASM_SIMP_TAC [SUBFIELD_GENERATED_IDEMPOT_GEN, INTER_SUBSET,
                    CARRIER_SUBFIELD_GENERATED_SUBFIELD]])

  let GALOIS_COMPOSITUM_DEGREE ← prove
   r"!(h:A->B) k l s t.
        field l /\ s subfield_of l /\ t subfield_of l /\
        IMAGE h (ring_carrier k) SUBSET s /\
        IMAGE h (ring_carrier k) SUBSET t /\
        finite_extension(k,subfield_generated l s) h /\
        galois_extension(k,subfield_generated l s) h
        ==> extension_degree
              (subfield_generated l t,subfield_generated l (s UNION t)) I =
            extension_degree
              (subfield_generated l (s INTER t),subfield_generated l s) I /\
            extension_degree
              (subfield_generated l t,subfield_generated l (s UNION t)) I
            divides extension_degree(k,subfield_generated l s) h"
   (← do
    let m1 ← MESON [DIVIDES_LMUL, DIVIDES_REFL]
     (← q r"!a b c:num. a = b ==> a = b /\ a divides c * b")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_COMPOSITUM) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"finite_extension(k,subfield_generated l (s INTER t)) (h:A->B) /\
    finite_extension(subfield_generated l (s INTER t),subfield_generated l s)
                    (I:B->B) /\
    galois_extension(subfield_generated l (s INTER t),subfield_generated l s)
                    (I:B->B)")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)",
                        ← q r"s INTER t:B->bool"]
        FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)",
                        ← q r"s INTER t:B->bool"]
        GALOIS_EXTENSION_SUBFIELD_GENERATED) THEN
      ASM_SIMP_TAC [SUBSET_INTER, SUBFIELD_GENERATED_IDEMPOT_GEN, INTER_SUBSET,
                    CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"extension_degree(k,subfield_generated l s) (h:A->B) =
    extension_degree(k,subfield_generated l (s INTER t)) h *
    extension_degree(subfield_generated l (s INTER t),subfield_generated l s)
                    (I:B->B)")
    SUBST1_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                        ← q r"subfield_generated l (s INTER t:B->bool)",
                        ← q r"subfield_generated l (s:B->bool)"]
        EXTENSION_DEGREE_TOWER_LAW) THEN
      ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION, I_O_ID],
      MATCH_MP_TAC m1] THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"subfield_generated l (t:B->bool)",
                      ← q r"subfield_generated l (s UNION t:B->bool)"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"subfield_generated l (s INTER t:B->bool)",
                      ← q r"subfield_generated l (s:B->bool)"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN (SUBST1_TAC o SYM)) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_CARD_EQ o
      MATCH_MP GROUP_ISOMORPHISM_IMP_ISOMORPHIC) THEN
    ASM_SIMP_TAC [CARD_EQ_CARD, FINITE_GALOIS_GROUP]))

  -- @@RETURN BEGIN
  return { GALOIS_EXTENSION_LIFT, GALOIS_COMPOSITUM_MONOMORPHISM, GALOIS_COMPOSITUM,
           GALOIS_COMPOSITUM_DEGREE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Composita of Galois extensions, continued: the compositum of two finite   -/
/- Galois extensions s and t is finite Galois, and the pair of restrictions  -/
/- embeds its Galois group into the product of the Galois groups of s and t, -/
/- an isomorphism when s INTER t is the image of k (VI 1.14).                -/
/- ------------------------------------------------------------------------- -/

structure GaloisComposita where
  -- @@FIELDS
  GALOIS_COMPOSITUM_DISJOINT : thm
  GALOIS_EXTENSION_COMPOSITUM : thm
  GALOIS_COMPOSITUM_PROD_GROUP_MONOMORPHISM : thm
  GALOIS_COMPOSITUM_PROD_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisComposita [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BGaloisIsomorphic : GaloisIsomorphic) (BGaloisRestriction : GaloisRestriction) (BNaturalIrrationalities : NaturalIrrationalities) :
    ExceptT String IO GaloisComposita := do
  -- @@SCOPE BEGIN
  let { SET_TAC, TAUT, .. } := D
  let { CARD_CROSS, CARRIER_SUBFIELD_GENERATED_SUBFIELD, EXTENSION_DEGREE_EQ_IMAGE,
        EXTENSION_DEGREE_TOWER_LAW, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_SUBFIELD_GENERATED, FIELD_SUBFIELD_GENERATED, FINITE_CROSS,
        FINITE_EXTENSION_TRANS, FINITE_IMP_FIELD_EXTENSION, GROUP_HOMOMORPHISM_PAIRED,
        GROUP_ISOMORPHISM_EQ_MONOMORPHISM_FINITE, .. } := D.core1
  let { IMAGE_I, IN_UNION, I_O_ID, MULT_SYM, NORMAL_EXTENSION_COMPOSITUM, PAIR_EQ, .. } := D.core2
  let { PROD_GROUP, .. } := D.core3
  let { SEPARABLE_EXTENSION_TRANS_EQ, SUBFIELD_GENERATED_IDEMPOT_GEN,
        SUBFIELD_OF_IMP_SUBSET, SUBFIELD_OF_INTER, SUBFIELD_OF_SUBFIELD_GENERATED,
        SUBSET_CARRIER_SUBFIELD_GENERATED, SUBSET_UNION, UNION_SUBSET,
        group_monomorphism, ring_homomorphism, .. } := D.core4
  let { GALOIS_GROUP_EQ_IMAGE, .. } := BGaloisGroup
  let { FINITE_GALOIS_GROUP, .. } := BGaloisExtensions
  let { GALOIS_EXTENSION_EQ_CARD, GALOIS_IMP_NORMAL_EXTENSION,
        GALOIS_IMP_SEPARABLE_EXTENSION, galois_extension, .. } := BGaloisExtension
  let { GALOIS_GROUP_EQ_ON_GENERATORS, .. } := BGaloisIsomorphic
  let { GALOIS_GROUP_RESTRICTION_HOMOMORPHISM, .. } := BGaloisRestriction
  let { GALOIS_COMPOSITUM, GALOIS_COMPOSITUM_DEGREE, GALOIS_EXTENSION_LIFT, .. } := BNaturalIrrationalities
  -- @@SCOPE END

  let GALOIS_COMPOSITUM_DISJOINT ← prove
   r"!(h:A->B) k l s t.
        field l /\ s subfield_of l /\ t subfield_of l /\
        finite_extension(k,subfield_generated l s) h /\
        galois_extension(k,subfield_generated l s) h /\
        s INTER t = IMAGE h (ring_carrier k)
        ==> group_isomorphism
              (galois_group
                (subfield_generated l t,subfield_generated l (s UNION t)) I,
               galois_group(k,subfield_generated l s) h)
              (\f x. if x IN s then f x else x)"
   (← do
    let t1 ← TAUT (← q r"(r <=> s) ==> p /\ q /\ r ==> s")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_COMPOSITUM) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC t1 THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    MATCH_MP_TAC GALOIS_GROUP_EQ_IMAGE THEN
    ASM_SIMP_TAC [IMAGE_I, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
                  SUBFIELD_OF_INTER]))

  let GALOIS_EXTENSION_COMPOSITUM ← prove
   r"!(h:A->B) k l s t.
        field l /\ s subfield_of l /\ t subfield_of l /\
        finite_extension(k,subfield_generated l s) h /\
        galois_extension(k,subfield_generated l s) h /\
        finite_extension(k,subfield_generated l t) h /\
        galois_extension(k,subfield_generated l t) h
        ==> finite_extension(k,subfield_generated l (s UNION t)) h /\
            galois_extension(k,subfield_generated l (s UNION t)) h"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!u. u subfield_of l /\ finite_extension(k,subfield_generated l u) h
        ==> IMAGE (h:A->B) (ring_carrier k) SUBSET u")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE I [ring_homomorphism] o
        MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM o
        MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
      ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_EXTENSION_LIFT) THEN
    ASM_SIMP_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"field_extension(k,subfield_generated l t) (h:A->B) /\
    field_extension(subfield_generated l t,subfield_generated l (s UNION t))
                   (I:B->B)")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION], ALL_TAC] THEN
    CONJ_TAC THENL
     [SUBST1_TAC (← SYM (← CONJUNCT1 (← ISPEC (← q r"h:A->B") I_O_ID))) THEN
      MATCH_MP_TAC FINITE_EXTENSION_TRANS THEN
      EXISTS_TAC (← q r"subfield_generated l (t:B->bool)") THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [galois_extension]] THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"h:A->B", ← q r"I:B->B", ← q r"I:B->B", ← q r"k:A ring",
                        ← q r"subfield_generated l (s:B->bool)",
                        ← q r"subfield_generated l (t:B->bool)", ← q r"l:B ring"]
        NORMAL_EXTENSION_COMPOSITUM) THEN
      ASM_SIMP_TAC [GALOIS_IMP_NORMAL_EXTENSION, IMAGE_I, I_O_ID,
                    FIELD_EXTENSION_SUBFIELD_GENERATED,
                    CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                        ← q r"subfield_generated l (t:B->bool)",
                        ← q r"subfield_generated l (s UNION t:B->bool)"]
        SEPARABLE_EXTENSION_TRANS_EQ) THEN
      ASM_SIMP_TAC [GALOIS_IMP_SEPARABLE_EXTENSION, I_O_ID]])

  let GALOIS_COMPOSITUM_PROD_GROUP_MONOMORPHISM ← prove
   r"!(h:A->B) k l s t.
        field l /\ s subfield_of l /\ t subfield_of l /\
        IMAGE h (ring_carrier k) SUBSET s /\
        IMAGE h (ring_carrier k) SUBSET t /\
        normal_extension(k,subfield_generated l s) h /\
        normal_extension(k,subfield_generated l t) h
        ==> group_monomorphism
              (galois_group(k,subfield_generated l (s UNION t)) h,
               prod_group (galois_group(k,subfield_generated l s) h)
                          (galois_group(k,subfield_generated l t) h))
              (\f. (\x. if x IN s then f x else x),
                   (\x. if x IN t then f x else x))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(s:B->bool) SUBSET ring_carrier(subfield_generated l (s UNION t)) /\
    (t:B->bool) SUBSET ring_carrier(subfield_generated l (s UNION t))")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC SUBSET_CARRIER_SUBFIELD_GENERATED THEN
      ASM_SIMP_TAC [SUBFIELD_OF_IMP_SUBSET] THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field(subfield_generated l (s UNION t:B->bool))") ASSUME_TAC
    THENL [ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED], ALL_TAC] THEN
    REWRITE_TAC [group_monomorphism, GROUP_HOMOMORPHISM_PAIRED] THEN
    REPEAT CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring",
                        ← q r"subfield_generated l (s UNION t:B->bool)", ← q r"s:B->bool"]
        GALOIS_GROUP_RESTRICTION_HOMOMORPHISM) THEN
      ASM_SIMP_TAC [SUBFIELD_GENERATED_IDEMPOT_GEN, SUBFIELD_OF_SUBFIELD_GENERATED,
                    SUBSET_UNION],
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring",
                        ← q r"subfield_generated l (s UNION t:B->bool)", ← q r"t:B->bool"]
        GALOIS_GROUP_RESTRICTION_HOMOMORPHISM) THEN
      ASM_SIMP_TAC [SUBFIELD_GENERATED_IDEMPOT_GEN, SUBFIELD_OF_SUBFIELD_GENERATED,
                    SUBSET_UNION],
      MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN
      REWRITE_TAC [PAIR_EQ] THEN STRIP_TAC THEN
      MATCH_MP_TAC GALOIS_GROUP_EQ_ON_GENERATORS THEN
      MAP_EVERY EXISTS_TAC
       [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s UNION t:B->bool)",
        ← q r"s UNION t:B->bool"] THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [SUBGOAL_THEN
         (← q r"IMAGE (h:A->B) (ring_carrier k) UNION s UNION t = s UNION t")
        SUBST1_TAC THENL
         [ASM SET_TAC [],
          ASM_SIMP_TAC [SUBFIELD_GENERATED_IDEMPOT_GEN, UNION_SUBSET]],
        X_GEN_TAC (← q r"x:B") THEN REWRITE_TAC [IN_UNION] THEN STRIP_TAC THENL
         [FIRST_X_ASSUM (fun th => tactic_of do
            let c ← q r"s:B->bool"
            if !(is_eq (concl th) && free_in c (concl th)) then throw "check"
            pure (MP_TAC (← AP_THM th (← q r"x:B")))),
          FIRST_X_ASSUM (fun th => tactic_of do
            let c ← q r"t:B->bool"
            if !(is_eq (concl th) && free_in c (concl th)) then throw "check"
            pure (MP_TAC (← AP_THM th (← q r"x:B"))))] THEN
        ASM_REWRITE_TAC []]])

  let GALOIS_COMPOSITUM_PROD_GROUP ← prove
   r"!(h:A->B) k l s t.
        field l /\ s subfield_of l /\ t subfield_of l /\
        finite_extension(k,subfield_generated l s) h /\
        galois_extension(k,subfield_generated l s) h /\
        finite_extension(k,subfield_generated l t) h /\
        galois_extension(k,subfield_generated l t) h /\
        s INTER t = IMAGE h (ring_carrier k)
        ==> group_isomorphism
              (galois_group(k,subfield_generated l (s UNION t)) h,
               prod_group (galois_group(k,subfield_generated l s) h)
                          (galois_group(k,subfield_generated l t) h))
              (\f. (\x. if x IN s then f x else x),
                   (\x. if x IN t then f x else x))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"IMAGE (h:A->B) (ring_carrier k) SUBSET s /\
    IMAGE (h:A->B) (ring_carrier k) SUBSET t")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_EXTENSION_COMPOSITUM) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_COMPOSITUM_DEGREE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_EXTENSION_LIFT) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_COMPOSITUM_PROD_GROUP_MONOMORPHISM) THEN
    ASM_SIMP_TAC [GALOIS_IMP_NORMAL_EXTENSION] THEN REPEAT STRIP_TAC THEN
    wPart (fun t => pure t) (fun t => do lhand (← rand t))
      GROUP_ISOMORPHISM_EQ_MONOMORPHISM_FINITE THEN
    ANTS_TAC THENL [ALL_TAC, DISCH_THEN SUBST1_TAC THEN ASM_REWRITE_TAC []] THEN
    ASM_SIMP_TAC [FINITE_GALOIS_GROUP, ← CONJUNCT1 PROD_GROUP, FINITE_CROSS,
                  CARD_CROSS] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (t:B->bool)"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring",
                      ← q r"subfield_generated l (s UNION t:B->bool)"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN SUBST1_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                      ← q r"subfield_generated l (t:B->bool)",
                      ← q r"subfield_generated l (s UNION t:B->bool)"]
      EXTENSION_DEGREE_TOWER_LAW) THEN
    ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION, I_O_ID] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"h:A->B", ← q r"subfield_generated l (s INTER t:B->bool)",
                      ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)"]
      EXTENSION_DEGREE_EQ_IMAGE) THEN
    ASM_SIMP_TAC [IMAGE_I, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
                  SUBFIELD_OF_INTER] THEN
    DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [MULT_SYM])

  -- @@RETURN BEGIN
  return { GALOIS_COMPOSITUM_DISJOINT, GALOIS_EXTENSION_COMPOSITUM,
           GALOIS_COMPOSITUM_PROD_GROUP_MONOMORPHISM, GALOIS_COMPOSITUM_PROD_GROUP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Finite Galois subextensions. finite_galois_subfields (k,l) h is the set   -/
/- of subfields e of l containing the image of k with e finite and Galois    -/
/- over k: the directed system of infinite Galois theory.                    -/
/- ------------------------------------------------------------------------- -/

structure FiniteGaloisSubfields where
  -- @@FIELDS
  finite_galois_subfields : thm
  IN_FINITE_GALOIS_SUBFIELDS : thm
  FINITE_GALOIS_SUBFIELDS_ELEMENT : thm
  FINITE_GALOIS_SUBFIELDS_UPPER_BOUND : thm
  FINITE_GALOIS_SUBFIELDS_UPPER_BOUNDS : thm
  FINITE_GALOIS_SUBFIELDS_FINITE : thm
  GALOIS_EXTENSION_UNION_FINITE_GALOIS_SUBFIELDS : thm
  FINITE_GALOIS_SUBFIELD_RESTRICTION_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupFiniteGaloisSubfields [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BGaloisIsomorphic : GaloisIsomorphic) (BGaloisRestriction : GaloisRestriction) (BGaloisComposita : GaloisComposita) :
    ExceptT String IO FiniteGaloisSubfields := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { ALGEBRAIC_OVER_MONOMORPHIC_IMAGE, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
        EMPTY_SUBSET, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_IMP_MONOMORPHISM, FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
        FIELD_EXTENSION_SUBFIELD_GENERATED, FIELD_SUBFIELD_GENERATED,
        FINITE_IMP_ALGEBRAIC_EXTENSION, FINITE_IMP_FIELD_EXTENSION,
        FINITE_IMP_FINITELY_GENERATED_EXTENSION, FINITE_INDUCT_STRONG, FORALL_IN_IMAGE,
        FORALL_IN_INSERT, .. } := D.core1
  let { IMP_CONJ, INSERT_SUBSET, IN_ELIM_THM, IN_IMAGE,
        IN_RING_POLYNOMIAL_CARRIER_COMPOSE, IN_UNION, I_O_ID, I_THM,
        MINIMAL_POLYNOMIAL, MONO_EXISTS, NOT_INSERT_EMPTY, NOT_IN_EMPTY,
        POLY_EVAL_HOMOMORPHIC_IMAGE, .. } := D.core2
  let { POLY_SPLITS_HOMOMORPHIC_IMAGE, RIGHT_FORALL_IMP_THM, RING_1,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core3
  let { SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE, SPLITTING_EXTENSION_GENERATED_BY_ROOTS,
        SUBFIELD_GENERATED, SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED,
        SUBFIELD_GENERATED_IDEMPOT_GEN, SUBFIELD_GENERATED_INC, SUBFIELD_OF_IMP_SUBSET,
        SUBFIELD_SUBFIELD_GENERATED, SUBSET, SUBSET_REFL, UNION_SUBSET,
        algebraic_extension, field_extension, finitely_generated_extension,
        group_homomorphism, normal_extension, poly_splits_over, ring_homomorphism,
        ring_irreducible, ring_monomorphism, separable_element, separable_extension, .. } := D.core4
  let { GALOIS_GROUP_I, .. } := BGaloisGroup
  let { GALOIS_GROUP_ORBIT, .. } := BGaloisExtensions
  let { GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING, GALOIS_IMP_ALGEBRAIC_EXTENSION,
        GALOIS_IMP_FIELD_EXTENSION, GALOIS_IMP_NORMAL_EXTENSION,
        GALOIS_IMP_SEPARABLE_EXTENSION, galois_extension, .. } := BGaloisExtension
  let { GALOIS_GROUP_EQ_ON_GENERATORS, .. } := BGaloisIsomorphic
  let { GALOIS_GROUP_RESTRICTION_HOMOMORPHISM, .. } := BGaloisRestriction
  let { GALOIS_EXTENSION_COMPOSITUM, .. } := BGaloisComposita
  -- @@SCOPE END

  let finite_galois_subfields ← new_definition
   r"finite_galois_subfields (k:A ring,l:B ring) (h:A->B) =
        {e | e subfield_of l /\ IMAGE h (ring_carrier k) SUBSET e /\
             finite_extension(k,subfield_generated l e) h /\
             galois_extension(k,subfield_generated l e) h}"

  let IN_FINITE_GALOIS_SUBFIELDS ← prove
   r"!(h:A->B) k l e.
        e IN finite_galois_subfields(k,l) h <=>
        e subfield_of l /\ IMAGE h (ring_carrier k) SUBSET e /\
        finite_extension(k,subfield_generated l e) h /\
        galois_extension(k,subfield_generated l e) h"
   (REWRITE_TAC [finite_galois_subfields, IN_ELIM_THM])

  let FINITE_GALOIS_SUBFIELDS_ELEMENT ← prove
   r"!(h:A->B) k l x.
        galois_extension(k,l) h /\ x IN ring_carrier l
        ==> ?e. e IN finite_galois_subfields(k,l) h /\ x IN e"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [IN_FINITE_GALOIS_SUBFIELDS] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_NORMAL_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_SEPARABLE_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
                  MINIMAL_POLYNOMIAL) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [GALOIS_IMP_ALGEBRAIC_EXTENSION, algebraic_extension],
      STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"poly_eval l ((h:A->B) o minimal_polynomial(k,l) h x) x = ring_0 l")
    ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"(x:B) IN {f x | f IN group_carrier(galois_group(k,l) (h:A->B))}")
      MP_TAC THENL
       [REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"I:B->B") THEN
        REWRITE_TAC [GALOIS_GROUP_I, I_THM],
        ASM_SIMP_TAC [GALOIS_GROUP_ORBIT] THEN SIMP_TAC [IN_ELIM_THM]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"poly_splits_over (k,l) (h:A->B) (minimal_polynomial(k,l) h x)")
    ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"normal_extension(k,l) (h:A->B)") THEN
      REWRITE_TAC [normal_extension] THEN DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN
      ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"x:B") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"t = IMAGE (h:A->B) (ring_carrier k) UNION
        {y | y IN ring_carrier l /\
             poly_eval l (h o minimal_polynomial(k,l) h x) y = ring_0 l}") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"minimal_polynomial(k,l) (h:A->B) x"]
                  SPLITTING_EXTENSION_GENERATED_BY_ROOTS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"finite_extension(k,subfield_generated l t) (h:A->B) /\
    galois_extension(k,subfield_generated l t) h")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING] THEN
      EXISTS_TAC (← q r"minimal_polynomial(k,l) (h:A->B) x") THEN
      ASM_REWRITE_TAC [] THEN
      UNDISCH_TAC (← q r"separable_extension(k,l) (h:A->B)") THEN
      REWRITE_TAC [separable_extension, separable_element] THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(t:B->bool) SUBSET ring_carrier l") ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN REWRITE_TAC [UNION_SUBSET] THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"ring_monomorphism(k:A ring,l:B ring) h") THEN
        SIMP_TAC [ring_monomorphism, ring_homomorphism],
        SET_TAC []],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"ring_carrier(subfield_generated l (t:B->bool))") THEN
    ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED,
                  SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_INC THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "t" THEN REWRITE_TAC [IN_UNION] THEN DISJ1_TAC THEN
      REWRITE_TAC [IN_IMAGE] THEN ASM_MESON_TAC [],
      MATCH_MP_TAC SUBFIELD_GENERATED_INC THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "t" THEN REWRITE_TAC [IN_UNION, IN_ELIM_THM] THEN
      ASM_REWRITE_TAC []])

  let FINITE_GALOIS_SUBFIELDS_UPPER_BOUND ← prove
   r"!(h:A->B) k l e1 e2.
        field l /\
        e1 IN finite_galois_subfields(k,l) h /\
        e2 IN finite_galois_subfields(k,l) h
        ==> ?e. e IN finite_galois_subfields(k,l) h /\
                e1 SUBSET e /\ e2 SUBSET e"
   (REWRITE_TAC [IN_FINITE_GALOIS_SUBFIELDS] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"e1:B->bool", ← q r"e2:B->bool"]
                  GALOIS_EXTENSION_COMPOSITUM) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"ring_carrier(subfield_generated l (e1 UNION e2:B->bool))") THEN
    ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED,
                  SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
    SUBGOAL_THEN
     (← q r"(e1 UNION e2:B->bool) SUBSET
    ring_carrier(subfield_generated l (e1 UNION e2))")
    MP_TAC THENL
     [REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_INC THEN
      ASM_SIMP_TAC [UNION_SUBSET, SUBFIELD_OF_IMP_SUBSET],
      ASM SET_TAC []])

  let FINITE_GALOIS_SUBFIELDS_UPPER_BOUNDS ← prove
   r"!(h:A->B) k l c.
        field l /\ FINITE c /\ ~(c = {}) /\
        c SUBSET finite_galois_subfields(k,l) h
        ==> ?e. e IN finite_galois_subfields(k,l) h /\
                !e'. e' IN c ==> e' SUBSET e"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [NOT_INSERT_EMPTY, INSERT_SUBSET, FORALL_IN_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q r"e1:B->bool", ← q r"c:(B->bool)->bool"] THEN
    ASM_CASES_TAC (← q r"c:(B->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY] THENL [MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o check (is_imp o concl)) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e2:B->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"e1:B->bool", ← q r"e2:B->bool"]
                  FINITE_GALOIS_SUBFIELDS_UPPER_BOUND) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  let FINITE_GALOIS_SUBFIELDS_FINITE ← prove
   r"!(h:A->B) k l s.
        galois_extension(k,l) h /\ FINITE s /\ s SUBSET ring_carrier l
        ==> ?e. e IN finite_galois_subfields(k,l) h /\ s SUBSET e"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"ring_1 l:B"]
                    FINITE_GALOIS_SUBFIELDS_ELEMENT) THEN
      ASM_REWRITE_TAC [RING_1, EMPTY_SUBSET] THEN MESON_TAC [],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"s:B->bool"] THEN
    REWRITE_TAC [INSERT_SUBSET] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o check (is_imp o concl)) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e1:B->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
                  FINITE_GALOIS_SUBFIELDS_ELEMENT) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e2:B->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"e1:B->bool", ← q r"e2:B->bool"]
                  FINITE_GALOIS_SUBFIELDS_UPPER_BOUND) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [GALOIS_IMP_FIELD_EXTENSION, field_extension],
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []])

  /- Conversely, for any field extension, a subfield s containing the     -/
  /- image of k in which every element lies in a finite Galois            -/
  /- subextension contained in s is Galois over k.                        -/
  let GALOIS_EXTENSION_UNION_FINITE_GALOIS_SUBFIELDS ← prove
   r"!(h:A->B) k l s.
        field_extension(k,l) h /\ s subfield_of l /\
        IMAGE h (ring_carrier k) SUBSET s /\
        (!x. x IN s
             ==> ?e. e IN finite_galois_subfields(k,l) h /\
                     e SUBSET s /\ x IN e)
        ==> galois_extension(k,subfield_generated l s) h"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"ring_carrier(subfield_generated l s) = s /\
      field_extension(k,subfield_generated l s) (h:A->B)")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
      MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"m = subfield_generated l (s:B->bool)") THEN
    SUBGOAL_THEN
     (← q r"!x. x IN s
          ==> ?e. ring_carrier(subfield_generated m e) = e /\ x IN e /\
                  ring_homomorphism(k,subfield_generated m e) (h:A->B) /\
                  finite_extension(k,subfield_generated m e) h /\
                  galois_extension(k,subfield_generated m e) h /\
                  ring_monomorphism(subfield_generated m e,m) I")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:B")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:B->bool") THEN
      REWRITE_TAC [IN_FINITE_GALOIS_SUBFIELDS] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"ring_monomorphism(subfield_generated m e,m) (I:B->B)")
      ASSUME_TAC THENL
       [MATCH_MP_TAC FIELD_EXTENSION_IMP_MONOMORPHISM THEN
        REWRITE_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED] THEN
        ASM_MESON_TAC [field_extension],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"subfield_generated m e = subfield_generated l (e:B->bool)")
      SUBST_ALL_TAC THENL
       [EXPAND_TAC "m" THEN MATCH_MP_TAC SUBFIELD_GENERATED_IDEMPOT_GEN THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
      ASM_MESON_TAC [FINITE_IMP_FIELD_EXTENSION,
                     FIELD_EXTENSION_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_extension(k,m) (h:A->B)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [algebraic_extension] THEN X_GEN_TAC (← q r"x:B") THEN
      DISCH_TAC THEN FIRST_ASSUM (MP_TAC o C MATCH_MP (← ASSUME (← q r"(x:B) IN s"))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:B->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                        ← q r"subfield_generated m (e:B->bool)", ← q r"m:B ring", ← q r"x:B"]
        ALGEBRAIC_OVER_MONOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [I_O_ID, I_THM] THEN DISCH_THEN SUBST1_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP FINITE_IMP_ALGEBRAIC_EXTENSION) THEN
      ASM_SIMP_TAC [algebraic_extension],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [galois_extension, separable_extension] THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [normal_extension] THEN X_GEN_TAC (← q r"p:(1->num)->A") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"a:B") STRIP_ASSUME_TAC)) THEN
      FIRST_ASSUM (MP_TAC o C MATCH_MP (← ASSUME (← q r"(a:B) IN s"))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:B->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"p IN ring_carrier(poly_ring (k:A ring) (:1))") ASSUME_TAC
      THENL [ASM_MESON_TAC [ring_irreducible], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"((h:A->B) o p) IN
        ring_carrier(poly_ring (subfield_generated m (e:B->bool)) (:1))")
      ASSUME_TAC THENL
       [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
        EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"poly_splits_over (k,subfield_generated m e) (h:A->B) p")
      MP_TAC THENL
       [FIRST_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE I [normal_extension] o
          MATCH_MP GALOIS_IMP_NORMAL_EXTENSION) THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
        EXISTS_TAC (← q r"a:B") THEN ASM_REWRITE_TAC [] THEN
        MP_TAC (← ISPECL [← q r"subfield_generated m (e:B->bool)", ← q r"m:B ring", ← q r"a:B",
                          ← q r"I:B->B", ← q r"(h:A->B) o (p:(1->num)->A)"]
          POLY_EVAL_HOMOMORPHIC_IMAGE) THEN
        ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM, I_THM, I_O_ID] THEN
        REWRITE_TAC [SUBFIELD_GENERATED],
        REWRITE_TAC [poly_splits_over] THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"subfield_generated m (e:B->bool)", ← q r"m:B ring",
                          ← q r"I:B->B", ← q r"(h:A->B) o (p:(1->num)->A)"]
          POLY_SPLITS_HOMOMORPHIC_IMAGE) THEN
        ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM, I_O_ID]],
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o C MATCH_MP (← ASSUME (← q r"(x:B) IN s"))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:B->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                        ← q r"subfield_generated m (e:B->bool)", ← q r"m:B ring", ← q r"x:B"]
        SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [I_O_ID, I_THM] THEN DISCH_THEN SUBST1_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP GALOIS_IMP_SEPARABLE_EXTENSION) THEN
      ASM_SIMP_TAC [separable_extension]])

  let FINITE_GALOIS_SUBFIELD_RESTRICTION_EQ ← prove
   r"!(h:A->B) k l e.
        field_extension(k,l) h /\ e IN finite_galois_subfields(k,l) h
        ==> ?b. FINITE b /\ b SUBSET e /\
                !f g. f IN group_carrier(galois_group(k,l) h) /\
                      g IN group_carrier(galois_group(k,l) h)
                      ==> ((\x. if x IN e then f x else x) =
                           (\x. if x IN e then g x else x) <=>
                           !x. x IN b ==> f x = g x)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE I [IN_FINITE_GALOIS_SUBFIELDS]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FINITE_IMP_FINITELY_GENERATED_EXTENSION) THEN
    REWRITE_TAC [finitely_generated_extension] THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
    DISCH_THEN (fun th => tactic_of do
      match (CONJUNCTS th).getLast? with
      | some c => pure (X_CHOOSE_THEN (← q r"b:B->bool") STRIP_ASSUME_TAC c)
      | none => throw "last")
    THEN EXISTS_TAC (← q r"b:B->bool") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"e:B->bool"]
                  GALOIS_GROUP_RESTRICTION_HOMOMORPHISM) THEN
    ASM_SIMP_TAC [GALOIS_IMP_NORMAL_EXTENSION] THEN
    REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    DISCH_THEN (ASSUME_TAC o CONJUNCT1 o CONJUNCT1) THEN
    MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
    EQ_TAC THENL
     [DISCH_THEN (fun th => tactic_of do
        pure (X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
              MP_TAC (← AP_THM th (← q r"x:B")))) THEN
      SUBGOAL_THEN (← q r"(x:B) IN e") (fun th => REWRITE_TAC [th]) THEN
      ASM SET_TAC [],
      DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"\x. if x IN e then (f:B->B) x else x",
                      ← q r"\x. if x IN e then (g:B->B) x else x", ← q r"k:A ring",
                      ← q r"subfield_generated l (e:B->bool)", ← q r"b:B->bool"]
                  GALOIS_GROUP_EQ_ON_GENERATORS) THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED] THEN
    X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(x:B) IN e") (fun th => REWRITE_TAC [th]) THEN
    ASM SET_TAC [])

  -- @@RETURN BEGIN
  return { finite_galois_subfields, IN_FINITE_GALOIS_SUBFIELDS,
           FINITE_GALOIS_SUBFIELDS_ELEMENT, FINITE_GALOIS_SUBFIELDS_UPPER_BOUND,
           FINITE_GALOIS_SUBFIELDS_UPPER_BOUNDS, FINITE_GALOIS_SUBFIELDS_FINITE,
           GALOIS_EXTENSION_UNION_FINITE_GALOIS_SUBFIELDS,
           FINITE_GALOIS_SUBFIELD_RESTRICTION_EQ }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The Galois group of a polynomial. For a normal extension the Galois group -/
/- acts transitively on the roots in l of an irreducible polynomial. For a   -/
/- splitting extension of p it acts faithfully on the roots of p, so it      -/
/- embeds in their symmetric group. If p is irreducible, the number of roots -/
/- is a prime and some element moves exactly two roots, then the image is a  -/
/- transitive subgroup containing a transposition, hence the whole symmetric -/
/- group.                                                                    -/
/- ------------------------------------------------------------------------- -/

structure GaloisPolynomial where
  -- @@FIELDS
  GALOIS_GROUP_TRANSITIVE_ON_ROOTS : thm
  GALOIS_GROUP_IMAGE_ROOTS : thm
  GALOIS_GROUP_ACTION_ON_ROOTS : thm
  GALOIS_GROUP_ACTION_ON_ROOTS_TRANSITIVE : thm
  GALOIS_GROUP_CARD_ROOTS_DIVIDES : thm
  GALOIS_GROUP_PRIME_TRANSPOSITION_EXPLICIT : thm
  GALOIS_GROUP_PRIME_TRANSPOSITION : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisPolynomial [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisIsomorphic : GaloisIsomorphic) :
    ExceptT String IO GaloisPolynomial := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, HAS_SIZE_CONV, MESON, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { CONJ_ASSOC, DE_MORGAN_THM, DIVIDES_REFL, DIVIDES_RMUL, EXISTS_IN_IMAGE,
        EXTENSION, FIELD_IMP_INTEGRAL_DOMAIN, FORALL_IN_IMAGE, FUN_EQ_THM,
        FUN_IN_IMAGE, GROUP_HOMOMORPHISM, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_GROUP_ORBIT, IN_IMAGE, IN_INSERT,
        IRREDUCIBLE_IMP_POLY_DEG_NZ, I_THM, MINIMAL_POLYNOMIAL_ROOTS_IRREDUCIBLE,
        NORMAL_IMP_FIELD_EXTENSION, NOT_IN_EMPTY, ORBIT_STABILIZER_MUL,
        PERMUTES_DOUBLETON, PERMUTES_INJECTIVE, PERMUTES_INVERSES, PERMUTES_IN_IMAGE,
        PERMUTES_SUPERSET, POLY_DEG_MONOMORPHIC_IMAGE, POLY_ROOT_BOUND_EXTENSION, .. } := D.core2
  let { POLY_SPLITS_HAS_ROOT, RESTRICT_COMPOSE, RESTRICT_PERMUTES_EQ,
        RING_HOMOMORPHISM_0, RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_POLYNOMIAL, .. } := D.core3
  let { SPLITTING_EXTENSION_IMP_NORMAL, SPLITTING_IMP_FINITE_EXTENSION, SUBSET,
        SUBSET_ANTISYM, SYMMETRIC_GROUP,
        TRANSITIVE_TRANSPOSITION_SYMMETRIC_ISOMORPHISM, field_extension,
        group_homomorphism, group_image, group_monomorphism, isomorphic_group,
        poly_splits_over, splitting_extension, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_ACTION, GALOIS_GROUP_INVERSE, GALOIS_GROUP_PERMUTES,
        GALOIS_GROUP_POLY_EVAL, GALOIS_GROUP_RING_HOMOMORPHISM, .. } := BGaloisGroup
  let { CARD_GALOIS_GROUP_LE, GALOIS_GROUP_ORBIT, .. } := BGaloisExtensions
  let { GALOIS_GROUP_EQ_ON_GENERATORS, .. } := BGaloisIsomorphic
  -- @@SCOPE END

  let GALOIS_GROUP_TRANSITIVE_ON_ROOTS ← prove
   r"!(h:A->B) k l p a b.
     normal_extension(k,l) h /\ ring_irreducible(poly_ring k (:1)) p /\
     a IN ring_carrier l /\ poly_eval l (h o p) a = ring_0 l /\
     b IN ring_carrier l /\ poly_eval l (h o p) b = ring_0 l
     ==> ?f. f IN group_carrier(galois_group(k,l) h) /\ f a = b"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP NORMAL_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
      GALOIS_GROUP_ORBIT) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A", ← q r"a:B"]
      MINIMAL_POLYNOMIAL_ROOTS_IRREDUCIBLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"b:B")) THEN ASM_REWRITE_TAC [] THEN
    MESON_TAC [])

  let GALOIS_GROUP_IMAGE_ROOTS ← prove
   r"!(h:A->B) f k l p.
        ring_homomorphism(k,l) h /\ f IN group_carrier(galois_group(k,l) h) /\
        p IN ring_carrier(poly_ring k (:1))
        ==> IMAGE f {x | x IN ring_carrier l /\
                         poly_eval l (h o p) x = ring_0 l} =
            {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!g. g IN group_carrier(galois_group(k,l) (h:A->B))
        ==> IMAGE g {x | x IN ring_carrier l /\
                         poly_eval l (h o p) x = ring_0 l} SUBSET
            {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"g:B->B") THEN DISCH_TAC THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:B") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring",
                        ← q r"p:(1->num)->A", ← q r"x:B"] GALOIS_GROUP_POLY_EVAL) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_IN_IMAGE,
                     RING_HOMOMORPHISM_0, GALOIS_GROUP_RING_HOMOMORPHISM],
      ALL_TAC] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN ASM_SIMP_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inverse(f:B->B)")) THEN
    ASM_SIMP_TAC [GALOIS_GROUP_INVERSE] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_PERMUTES) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_IMAGE] THEN
    ASM_MESON_TAC [PERMUTES_INVERSES])

  let GALOIS_GROUP_ACTION_ON_ROOTS ← prove
   r"!(h:A->B) k l p.
     splitting_extension(k,l) h p
     ==> group_monomorphism
          (galois_group(k,l) h,
           symmetric_group
            {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l})
          (\f x. if x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l
                 then f x else x)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [splitting_extension]) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN
     (← q r"!f. f IN group_carrier(galois_group(k,l) (h:A->B))
        ==> IMAGE f {x | x IN ring_carrier l /\
                         poly_eval l (h o p) x = ring_0 l} =
            {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC GALOIS_GROUP_IMAGE_ROOTS THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"l:B ring"
      let ok := is_eq (concl th) &&
        (match rhs (concl th) with | .ok t => t == c | .error _ => false)
      if !ok then throw "check"
      pure (MP_TAC th)) THEN
    SUBGOAL_THEN
     (← q r"(\f x. if x IN ring_carrier l /\ poly_eval l ((h:A->B) o p) x = ring_0 l
           then (f:B->B) x else x) =
    (\f x. if x IN {x | x IN ring_carrier l /\
                        poly_eval l (h o p) x = ring_0 l}
           then f x else x)")
    SUBST1_TAC THENL [REWRITE_TAC [IN_ELIM_THM], ALL_TAC] THEN
    ABBREV_TAC
     (← q r"R = {x | x IN ring_carrier l /\
             poly_eval l ((h:A->B) o p) x = ring_0 l}") THEN
    REPEAT DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(R:B->bool) SUBSET ring_carrier l") ASSUME_TAC THENL
     [EXPAND_TAC "R" THEN SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [group_monomorphism, GROUP_HOMOMORPHISM, SYMMETRIC_GROUP,
                 ← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP))] THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [RESTRICT_PERMUTES_EQ] THEN
      ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_INJECTIVE],
      MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
      MATCH_MP_TAC RESTRICT_COMPOSE THEN
      EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
      ASM_MESON_TAC [GALOIS_GROUP_PERMUTES],
      MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
      MATCH_MP_TAC GALOIS_GROUP_EQ_ON_GENERATORS THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"R:B->bool"] THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o flip AP_THM (← q r"x:B")) THEN ASM_REWRITE_TAC []])

  let GALOIS_GROUP_ACTION_ON_ROOTS_TRANSITIVE ← prove
   r"!(h:A->B) k l p.
     splitting_extension(k,l) h p /\ ring_irreducible(poly_ring k (:1)) p
     ==> !a b. a IN ring_carrier l /\ poly_eval l (h o p) a = ring_0 l /\
               b IN ring_carrier l /\ poly_eval l (h o p) b = ring_0 l
               ==> ?g. g IN group_image
                             (galois_group(k,l) h,
                              symmetric_group
                               {x | x IN ring_carrier l /\
                                    poly_eval l (h o p) x = ring_0 l})
                             (\f x. if x IN ring_carrier l /\
                                       poly_eval l (h o p) x = ring_0 l
                                    then f x else x) /\
                       g a = b"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_IMP_NORMAL) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A",
                      ← q r"a:B", ← q r"b:B"] GALOIS_GROUP_TRANSITIVE_ON_ROOTS) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:B->B") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [group_image, EXISTS_IN_IMAGE] THEN
    EXISTS_TAC (← q r"f:B->B") THEN ASM_REWRITE_TAC [])

  let GALOIS_GROUP_CARD_ROOTS_DIVIDES ← prove
   r"!(h:A->B) k l p.
     splitting_extension(k,l) h p /\ ring_irreducible(poly_ring k (:1)) p
     ==> CARD {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}
         divides CARD(group_carrier(galois_group(k,l) h))"
   (← do
    let m1 ← MESON [DIVIDES_REFL]
     (← q r"(s:B->bool) = t ==> CARD s divides CARD t")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_IMP_FINITE_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_IMP_NORMAL) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [splitting_extension]) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"(h:A->B) o (p:(1->num)->A)"]
      POLY_SPLITS_HAS_ROOT) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [poly_splits_over], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"p:(1->num)->A"]
        POLY_DEG_MONOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [RING_POLYNOMIAL] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC IRREDUCIBLE_IMP_POLY_DEG_NZ THEN ASM_REWRITE_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:B") STRIP_ASSUME_TAC)] THEN
    ASSUME_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      (← CONJUNCT1 GALOIS_GROUP_ACTION)) THEN
    MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"ring_carrier l:B->bool",
                      ← q r"\(f:B->B) (x:B). f x", ← q r"a:B"] ORBIT_STABILIZER_MUL) THEN
    ASM_SIMP_TAC [CARD_GALOIS_GROUP_LE] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC DIVIDES_RMUL THEN
    MATCH_MP_TAC m1 THEN
    REWRITE_TAC [EXTENSION, IN_GROUP_ORBIT, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"y:B") THEN ASM_REWRITE_TAC [] THEN EQ_TAC THEN STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A",
                        ← q r"a:B", ← q r"y:B"] GALOIS_GROUP_TRANSITIVE_ON_ROOTS) THEN
      ASM_REWRITE_TAC [],
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring",
                        ← q r"p:(1->num)->A", ← q r"a:B"] GALOIS_GROUP_POLY_EVAL) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      ASM_MESON_TAC [RING_HOMOMORPHISM_0, GALOIS_GROUP_RING_HOMOMORPHISM]]))

  let GALOIS_GROUP_PRIME_TRANSPOSITION_EXPLICIT ← prove
   r"!(h:A->B) f k l p.
     splitting_extension(k,l) h p /\ ring_irreducible(poly_ring k (:1)) p /\
     prime(CARD {x | x IN ring_carrier l /\
                     poly_eval l (h o p) x = ring_0 l}) /\
     f IN group_carrier(galois_group(k,l) h) /\
     {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l /\
          ~(f x = x)} HAS_SIZE 2
     ==> group_isomorphism
          (galois_group(k,l) h,
           symmetric_group
            {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l})
          (\g x. if x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l
                 then g x else x)"
   (← do
    let t1 ← TAUT (← q r"p /\ ~q ==> (p <=> q \/ r) ==> r")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [splitting_extension]) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
      POLY_ROOT_BOUND_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
      GALOIS_GROUP_ACTION_ON_ROOTS) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
      GALOIS_GROUP_ACTION_ON_ROOTS_TRANSITIVE) THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o check (is_binary "HAS_SIZE" o concl)) THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"prime"
      let ok := is_comb (concl th) &&
        (match rator (concl th) with | .ok t => t == c | .error _ => false)
      if !ok then throw "check"
      pure (MP_TAC th)) THEN
    CONV_TAC (ONCE_DEPTH_CONV HAS_SIZE_CONV) THEN
    SUBGOAL_THEN
     (← q r"!P. {x | x IN ring_carrier l /\ poly_eval l ((h:A->B) o p) x = ring_0 l /\
             P x} =
        {x | x IN {x | x IN ring_carrier l /\
                       poly_eval l ((h:A->B) o p) x = ring_0 l} /\ P x}")
    (fun th => ONCE_REWRITE_TAC [th]) THENL
     [REWRITE_TAC [IN_ELIM_THM, CONJ_ASSOC], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a b. a IN ring_carrier l /\ poly_eval l ((h:A->B) o p) a = ring_0 l /\
          b IN ring_carrier l /\ poly_eval l (h o p) b = ring_0 l <=>
          a IN {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l} /\
          b IN {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}")
    (fun th => REWRITE_TAC [th]) THENL
     [REWRITE_TAC [IN_ELIM_THM, CONJ_ASSOC], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(\f x. if x IN ring_carrier l /\ poly_eval l ((h:A->B) o p) x = ring_0 l
           then (f:B->B) x else x) =
    (\f x. if x IN {x | x IN ring_carrier l /\
                        poly_eval l (h o p) x = ring_0 l}
           then f x else x)")
    SUBST1_TAC THENL [REWRITE_TAC [IN_ELIM_THM], ALL_TAC] THEN
    ABBREV_TAC
     (← q r"R = {x | x IN ring_carrier l /\
             poly_eval l ((h:A->B) o p) x = ring_0 l}") THEN
    ABBREV_TAC (← q r"rho = \g x. if x IN R then (g:B->B) x else x") THEN
    DISCH_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:B") (X_CHOOSE_THEN (← q r"b:B")
     (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC))) THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INSERT, NOT_IN_EMPTY] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"(a:B) IN R /\ ~(f a = a) /\ (b:B) IN R /\ ~(f b = b) /\
    !x. x IN R /\ ~(x = a) /\ ~(x = b) ==> f x = x")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"a:B") th) THEN MP_TAC (← SPEC (← q r"b:B") th) THEN
              MP_TAC th)) THEN
      REWRITE_TAC [] THEN MESON_TAC [],
      ALL_TAC] THEN
    REPEAT DISCH_TAC THEN
    MATCH_MP_TAC TRANSITIVE_TRANSPOSITION_SYMMETRIC_ISOMORPHISM THEN
    MAP_EVERY EXISTS_TAC [← q r"a:B", ← q r"b:B"] THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"(rho:(B->B)->B->B) f permutes R") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE I
       [group_homomorphism] o CONJUNCT1 o GEN_REWRITE_RULE I
       [group_monomorphism]) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, SYMMETRIC_GROUP, IN_ELIM_THM] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(rho:(B->B)->B->B) f = swap(a,b)") (SUBST1_TAC o SYM) THENL
     [MP_TAC (← ISPECL [← q r"(rho:(B->B)->B->B) f", ← q r"a:B", ← q r"b:B"]
        PERMUTES_DOUBLETON) THEN
      MATCH_MP_TAC t1 THEN CONJ_TAC THENL
       [MATCH_MP_TAC PERMUTES_SUPERSET THEN EXISTS_TAC (← q r"R:B->bool") THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_INSERT, NOT_IN_EMPTY, DE_MORGAN_THM] THEN
        EXPAND_TAC "rho" THEN ASM_SIMP_TAC [],
        EXPAND_TAC "rho" THEN REWRITE_TAC [FUN_EQ_THM, I_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a:B")) THEN ASM_REWRITE_TAC []],
      REWRITE_TAC [group_image] THEN MATCH_MP_TAC FUN_IN_IMAGE THEN
      ASM_REWRITE_TAC []]))

  let GALOIS_GROUP_PRIME_TRANSPOSITION ← prove
   r"!(h:A->B) f k l p.
     splitting_extension(k,l) h p /\ ring_irreducible(poly_ring k (:1)) p /\
     prime(CARD {x | x IN ring_carrier l /\
                     poly_eval l (h o p) x = ring_0 l}) /\
     f IN group_carrier(galois_group(k,l) h) /\
     {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l /\
          ~(f x = x)} HAS_SIZE 2
     ==> galois_group(k,l) h isomorphic_group
         symmetric_group
           {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}"
   (REWRITE_TAC [isomorphic_group] THEN
    MESON_TAC [GALOIS_GROUP_PRIME_TRANSPOSITION_EXPLICIT])

  -- @@RETURN BEGIN
  return { GALOIS_GROUP_TRANSITIVE_ON_ROOTS, GALOIS_GROUP_IMAGE_ROOTS,
           GALOIS_GROUP_ACTION_ON_ROOTS, GALOIS_GROUP_ACTION_ON_ROOTS_TRANSITIVE,
           GALOIS_GROUP_CARD_ROOTS_DIVIDES, GALOIS_GROUP_PRIME_TRANSPOSITION_EXPLICIT,
           GALOIS_GROUP_PRIME_TRANSPOSITION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Discriminants and the alternating group. Let p be a separable polynomial  -/
/- of degree n with leading coefficient c, and number the roots of h o p in  -/
/- a splitting extension l as x_0, ..., x_(n-1). Then                        -/
/- d = h(c)^(n-1) det(x_i^j) is a nonzero square root of h(disc p), and each -/
/- element f of the Galois group maps d to its product with the sign of the  -/
/- permutation of the roots induced by f.                                    -/
/- ------------------------------------------------------------------------- -/

structure GaloisDiscriminant where
  -- @@FIELDS
  GALOIS_GROUP_VANDERMONDE_ROOTS : thm
  GALOIS_GROUP_DISCRIMINANT_SQUARE_ROOT : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisDiscriminant [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisPolynomial : GaloisPolynomial) :
    ExceptT String IO GaloisDiscriminant := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, RING_RULE, SET_TAC, TAUT, .. } := D
  let { COEFF_IN_CARRIER_ALT, EXISTS_UNIQUE_THM, EXTENSION, FIELD_IMP_INTEGRAL_DOMAIN,
        FINITE_NUMSEG_LT, .. } := D.core1
  let { HAS_SIZE, HAS_SIZE_INDEX, INJECTIVE_ON_LEFT_INVERSE, INTEGRAL_DOMAIN_MUL_EQ_0,
        INTEGRAL_DOMAIN_POW_EQ_0, INTEGRAL_DOMAIN_PRODUCT_EQ_0, IN_ELIM_THM, IN_IMAGE,
        IN_RING_POLYNOMIAL_CARRIER_COMPOSE, MONO_EXISTS, NOT_EXISTS_THM,
        PERMUTES_INJECTIVE, POLY_DEG_MONOMORPHIC_IMAGE, POLY_DISCRIMINANT_HOMOMORPHISM,
        POLY_DISCRIMINANT_VANDERMONDE, POLY_RING_CLAUSES, POLY_ROOT_BOUND_EXTENSION,
        POLY_ROOT_COUNT_IMP_PRODUCT, .. } := D.core2
  let { POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT, POLY_TOP_NONZERO, RESTRICT_PERMUTES_EQ,
        RIGHT_EXISTS_AND_THM, RING_DET, RING_DET_EQ, RING_DET_HOMOMORPHISM,
        RING_DET_PERMUTE_ROWS, RING_DET_REINDEX, RING_DET_VANDERMONDE,
        RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_POW,
        RING_MONOMORPHISM_EQ_0, RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL,
        RING_POLYNOMIAL, RING_POW, RING_PRODUCT_IMAGE, RING_SIGN, RING_SUB_EQ_0, .. } := D.core3
  let { coeff, field_extension, o_DEF, o_THM, splitting_extension, .. } := D.core4
  let { GALOIS_GROUP_FIXES, GALOIS_GROUP_PERMUTES, GALOIS_GROUP_RING_HOMOMORPHISM, .. } := BGaloisGroup
  let { GALOIS_GROUP_IMAGE_ROOTS, .. } := BGaloisPolynomial
  -- @@SCOPE END

  let GALOIS_GROUP_VANDERMONDE_ROOTS ← prove
   r"!(h:A->B) f k l p (e:B->num).
        ring_homomorphism(k,l) h /\ f IN group_carrier(galois_group(k,l) h) /\
        p IN ring_carrier(poly_ring k (:1)) /\
        FINITE {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}
        ==> f(ring_det l
               {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}
               (\u v. ring_pow l u (e v))) =
            ring_mul l
             (ring_sign l
               (\x. if x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l
                    then f x else x))
             (ring_det l
               {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}
               (\u v. ring_pow l u (e v)))"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"(\x. if x IN ring_carrier l /\ poly_eval l ((h:A->B) o p) x = ring_0 l
         then (f:B->B) x else x) =
    (\x. if x IN {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}
         then f x else x)")
    SUBST1_TAC THENL [REWRITE_TAC [IN_ELIM_THM], ALL_TAC] THEN
    ABBREV_TAC
     (← q r"R = {x | x IN ring_carrier l /\
             poly_eval l ((h:A->B) o (p:(1->num)->A)) x = ring_0 l}") THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(R:B->bool) SUBSET ring_carrier l") ASSUME_TAC THENL
     [EXPAND_TAC "R" THEN SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
      GALOIS_GROUP_IMAGE_ROOTS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"f:B->B", ← q r"R:B->bool",
                      ← q r"\u v. ring_pow (l:B ring) u ((e:B->num) v)"]
      RING_DET_HOMOMORPHISM) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_POW THEN
      ASM SET_TAC [],
      DISCH_THEN SUBST1_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"R:B->bool",
                      ← q r"\u v. ring_pow (l:B ring) u ((e:B->num) v)",
                      ← q r"\x. if x IN R then (f:B->B) x else x"]
      RING_DET_PERMUTE_ROWS) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [RESTRICT_PERMUTES_EQ] THEN
      ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_INJECTIVE],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC RING_DET_EQ THEN
    MAP_EVERY X_GEN_TAC [← q r"u:B", ← q r"v:B"] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP RING_HOMOMORPHISM_POW) THEN
    ASM SET_TAC [])

  let GALOIS_GROUP_DISCRIMINANT_SQUARE_ROOT ← prove
   r"!(h:A->B) k l p.
        splitting_extension(k,l) h p /\ poly_separable k p
        ==> ?d. d IN ring_carrier l /\ ~(d = ring_0 l) /\
                ring_pow l d 2 = h(poly_discriminant k p) /\
                !f. f IN group_carrier(galois_group(k,l) h)
                    ==> f d =
                        ring_mul l
                         (ring_sign l
                           (\x. if x IN ring_carrier l /\
                                   poly_eval l (h o p) x = ring_0 l
                                then f x else x))
                         d"
   (← do
    -- right to left: the RING_RULE, then the TAUT
    let r2 ← RING_RULE
     (← q r"ring_mul (r:B ring) x (ring_mul r s v) =
    ring_mul r s (ring_mul r x v)")
    let t1 ← TAUT (← q r"~(p /\ q) <=> p ==> ~q")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [splitting_extension]) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"integral_domain(l:B ring)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_polynomial k (p:(1->num)->A)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [RING_POLYNOMIAL], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(h:A->B) o (p:(1->num)->A) IN ring_carrier(poly_ring l (:1))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"n = poly_deg k (p:(1->num)->A)") THEN
    ABBREV_TAC
     (← q r"R = {x | x IN ring_carrier l /\
             poly_eval l ((h:A->B) o (p:(1->num)->A)) x = ring_0 l}") THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"p:(1->num)->A"]
      POLY_DEG_MONOMORPHIC_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
      POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
      POLY_ROOT_BOUND_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN REPEAT DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(R:B->bool) SUBSET ring_carrier l") ASSUME_TAC THENL
     [EXPAND_TAC "R" THEN SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?(z:num->B) (e:B->num).
        IMAGE z {i | i < n} = R /\ !i. i IN {i | i < n} ==> e(z i) = i")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"R:B->bool", ← q r"n:num"] HAS_SIZE_INDEX) THEN
      ASM_REWRITE_TAC [HAS_SIZE, EXISTS_UNIQUE_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:num->B") THEN STRIP_TAC THEN
      REWRITE_TAC [RIGHT_EXISTS_AND_THM, ← GSYM INJECTIVE_ON_LEFT_INVERSE] THEN
      REWRITE_TAC [IN_ELIM_THM, EXTENSION, IN_IMAGE] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!i. i < n ==> (z:num->B) i IN ring_carrier l") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    ABBREV_TAC (← q r"a = (h:A->B)(coeff n (p:(1->num)->A))") THEN
    SUBGOAL_THEN (← q r"(a:B) IN ring_carrier l /\ ~(a = ring_0 l)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "a" THEN
      SUBGOAL_THEN (← q r"coeff n (p:(1->num)->A) IN ring_carrier k /\
                  ~(coeff n p = ring_0 k)")
      STRIP_ASSUME_TAC THENL
       [UNDISCH_THEN (← q r"poly_deg k (p:(1->num)->A) = n") (SUBST1_TAC o SYM) THEN
        ASM_SIMP_TAC [COEFF_IN_CARRIER_ALT] THEN
        MATCH_MP_TAC POLY_TOP_NONZERO THEN
        ASM_REWRITE_TAC [← CONJUNCT2 POLY_RING_CLAUSES],
        MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B",
                          ← q r"coeff n (p:(1->num)->A)"] RING_MONOMORPHISM_EQ_0) THEN
        ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"(h:A->B) o (p:(1->num)->A)", ← q r"a:B", ← q r"z:num->B"]
      POLY_DISCRIMINANT_VANDERMONDE) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [MP_TAC (← ISPECL [← q r"l:B ring", ← q r"(h:A->B) o (p:(1->num)->A)"]
        POLY_ROOT_COUNT_IMP_PRODUCT) THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"coeff n ((h:A->B) o (p:(1->num)->A)) = a") SUBST1_TAC THENL
       [EXPAND_TAC "a" THEN REWRITE_TAC [coeff, o_THM], ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [← CONJUNCT2 POLY_RING_CLAUSES] THEN
      AP_TERM_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        let c ← q r"IMAGE (z:num->B) {i | i < n} = R"
        if !(aconv (concl th) c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      wPart lhand (fun t => do lhand (← rand t)) RING_PRODUCT_IMAGE THEN
      ANTS_TAC THENL
       [REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE] THEN
        EXISTS_TAC (← q r"e:B->num") THEN FIRST_ASSUM ACCEPT_TAC,
        DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [o_DEF],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"V = ring_det l {i | i < n} (\i j. ring_pow l ((z:num->B) i) j)") THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
      POLY_DISCRIMINANT_HOMOMORPHISM) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    SUBGOAL_THEN (← q r"~(V:B = ring_0 l)") ASSUME_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"V:B"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      ASM_SIMP_TAC [RING_DET_VANDERMONDE, INTEGRAL_DOMAIN_PRODUCT_EQ_0,
                    FINITE_NUMSEG_LT, IN_ELIM_THM, NOT_EXISTS_THM] THEN
      REWRITE_TAC [t1, NOT_EXISTS_THM] THEN
      X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"i:num < n") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      ASM_SIMP_TAC [RING_SUB_EQ_0] THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"e:B->num")) THEN
      ASM_SIMP_TAC [IN_ELIM_THM] THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(V:B) IN ring_carrier l") ASSUME_TAC THENL
     [EXPAND_TAC "V" THEN REWRITE_TAC [RING_DET], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_det l R (\u v. ring_pow l u ((e:B->num) v)) = V")
    ASSUME_TAC THENL
     [EXPAND_TAC "V" THEN
      FIRST_ASSUM (fun th => tactic_of do
        let c ← q r"IMAGE (z:num->B) {i | i < n} = R"
        if !(aconv (concl th) c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      wPart lhand (fun t => do lhand (← rand t)) RING_DET_REINDEX THEN
      ANTS_TAC THENL
       [REWRITE_TAC [FINITE_NUMSEG_LT, INJECTIVE_ON_LEFT_INVERSE] THEN
        EXISTS_TAC (← q r"e:B->num") THEN FIRST_ASSUM ACCEPT_TAC,
        DISCH_THEN SUBST1_TAC] THEN
      MATCH_MP_TAC RING_DET_EQ THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"ring_mul l (ring_pow l a (n - 1)) V:B") THEN
    ASM_SIMP_TAC [RING_MUL, RING_POW, INTEGRAL_DOMAIN_MUL_EQ_0,
                  INTEGRAL_DOMAIN_POW_EQ_0] THEN
    X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"p:(1->num)->A", ← q r"e:B->num"]
      GALOIS_GROUP_VANDERMONDE_ROOTS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(l,l) (f:B->B)") ASSUME_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(f:B->B) a = a") ASSUME_TAC THENL
     [EXPAND_TAC "a" THEN MATCH_MP_TAC GALOIS_GROUP_FIXES THEN
      MAP_EVERY EXISTS_TAC [← q r"k:A ring", ← q r"l:B ring"] THEN
      ASM_SIMP_TAC [COEFF_IN_CARRIER_ALT],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"f:B->B"] RING_HOMOMORPHISM_MUL) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"f:B->B"] RING_HOMOMORPHISM_POW) THEN
    ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN ASM_SIMP_TAC [RING_POW] THEN
    MATCH_MP_TAC r2 THEN
    ASM_SIMP_TAC [RING_SIGN, RING_POW]))

  -- @@RETURN BEGIN
  return { GALOIS_GROUP_VANDERMONDE_ROOTS, GALOIS_GROUP_DISCRIMINANT_SQUARE_ROOT }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Discriminants and the alternating group, continued. If 2 is not 0 in k,   -/
/- the Galois group acts on the roots by even permutations if and only if    -/
/- the discriminant of p is a square in k. The Galois group of an            -/
/- irreducible separable cubic has order 3 if its discriminant is a square   -/
/- in k, and order 6 if not.                                                 -/
/- ------------------------------------------------------------------------- -/

structure GaloisCubic where
  -- @@FIELDS
  GALOIS_GROUP_EVEN_EQ_DISCRIMINANT_SQUARE : thm
  GALOIS_GROUP_CUBIC : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisCubic [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BFixedFields : FixedFields) (BArtin : Artin) (BGaloisPolynomial : GaloisPolynomial) (BGaloisDiscriminant : GaloisDiscriminant) :
    ExceptT String IO GaloisCubic := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, DIVIDES_CONV, EXPAND_CASES_CONV, HAS_SIZE_CONV,
        MESON, NUM_REDUCE_CONV, RING_RULE, num_CONV, .. } := D
  let { ARITH, CARD_IMAGE_INJ, CARD_SUBSET_EQ, CARD_SYMMETRIC_GROUP, COND_ID,
        DIVIDES_LE, EQ_TRANS, EVENPERM_GROUP_POW, EVENPERM_ID, EVENPERM_SWAP,
        EXTENSION, FACT, FIELD_IMP_INTEGRAL_DOMAIN, FINITE_SYMMETRIC_GROUP,
        FORALL_IN_IMAGE, GROUP_HOMOMORPHISM_POW, .. } := D.core1
  let { GROUP_POW_GROUP_ORDER, HAS_SIZE, INTEGRAL_DOMAIN_MUL_EQ_0,
        INTEGRAL_DOMAIN_SQUARE_EQ, IN_ELIM_THM, IN_IMAGE, IN_INSERT, I_THM,
        NOT_FORALL_THM, NOT_IMP, PERMUTATION_PERMUTES, PERMUTES_SWAP,
        POLY_DISCRIMINANT_IN_CARRIER, POLY_ROOT_BOUND_EXTENSION, .. } := D.core2
  let { POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT, RING_1, RING_ADD_EQ_0,
        RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_NEG, RING_HOMOMORPHISM_POW,
        RING_HOMOMORPHISM_RING_OF_NUM, RING_MONOMORPHISM_EQ_0,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL_LID, RING_MUL_LNEG, RING_NEG,
        RING_OF_NUM, RING_POW, .. } := D.core3
  let { SPLITTING_EXTENSION_DEGREE_DIVIDES_FACT, SUBSET, SYMMETRIC_GROUP,
        field_extension, group_homomorphism, group_monomorphism, ring_monomorphism,
        ring_sign, splitting_extension, .. } := D.core4
  let { GALOIS_GROUP, .. } := BGaloisGroup
  let { FINITE_GALOIS_GROUP, .. } := BGaloisExtensions
  let { GALOIS_EXTENSION_EQ_CARD, GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING, .. } := BGaloisExtension
  let { IN_FIXED_FIELD, .. } := BFixedFields
  let { FIXED_FIELD_GALOIS_GROUP, .. } := BArtin
  let { GALOIS_GROUP_ACTION_ON_ROOTS, GALOIS_GROUP_CARD_ROOTS_DIVIDES, .. } := BGaloisPolynomial
  let { GALOIS_GROUP_DISCRIMINANT_SQUARE_ROOT, .. } := BGaloisDiscriminant
  -- @@SCOPE END

  let GALOIS_GROUP_EVEN_EQ_DISCRIMINANT_SQUARE ← prove
   r"!(h:A->B) k l p.
        splitting_extension(k,l) h p /\ poly_separable k p /\
        ~(ring_of_num k 2 = ring_0 k)
        ==> ((!f. f IN group_carrier(galois_group(k,l) h)
                  ==> evenperm
                       (\x. if x IN ring_carrier l /\
                               poly_eval l (h o p) x = ring_0 l
                            then f x else x)) <=>
             ?d. d IN ring_carrier k /\
                 ring_pow k d 2 = poly_discriminant k p)"
   (← do
    -- right to left: the RING_RULE, then the MESON
    let r2 ← RING_RULE
     (← q r"ring_mul (r:B ring) (ring_of_num r 2) x = ring_add r x x")
    let m1 ← MESON []
     (← q r"(!f:B->B. P f ==> (Q f <=> R f))
      ==> ((!f. P f ==> Q f) <=> (!f. P f ==> R f))")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
      GALOIS_GROUP_DISCRIMINANT_SQUARE_ROOT) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:B") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [splitting_extension]) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"integral_domain(l:B ring)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"galois_extension(k,l) (h:A->B)") ASSUME_TAC THENL
     [ASM_MESON_TAC [GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING], ALL_TAC] THEN
    TRANS_TAC EQ_TRANS (← q r"(d:B) IN IMAGE (h:A->B) (ring_carrier k)") THEN
    CONJ_TAC THENL
     [FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP FIXED_FIELD_GALOIS_GROUP th)])) THEN
      ASM_REWRITE_TAC [IN_FIXED_FIELD] THEN
      MATCH_MP_TAC m1 THEN
      X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (SUBST1_TAC (← MATCH_MP th (← ASSUME
          (← q r"(f:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))))) THEN
      REWRITE_TAC [ring_sign] THEN COND_CASES_TAC THEN
      ASM_SIMP_TAC [RING_MUL_LID, RING_MUL_LNEG, RING_1] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"ring_mul l (ring_of_num l 2) (d:B) = ring_0 l") MP_TAC THENL
       [UNDISCH_TAC (← q r"ring_neg l d = (d:B)") THEN
        ASM_SIMP_TAC [← GSYM RING_ADD_EQ_0] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
        ASM_SIMP_TAC [r2],
        ASM_SIMP_TAC [INTEGRAL_DOMAIN_MUL_EQ_0, RING_OF_NUM] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (REWRITE_TAC [← GSYM (← MATCH_MP RING_HOMOMORPHISM_RING_OF_NUM th)])) THEN
        ASM_MESON_TAC [RING_MONOMORPHISM_EQ_0, RING_OF_NUM]],
      ALL_TAC] THEN
    REWRITE_TAC [IN_IMAGE] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"e:A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"e:A") THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MATCH_MP_TAC o CONJUNCT2 o
        GEN_REWRITE_RULE I [ring_monomorphism]) THEN
      ASM_SIMP_TAC [RING_POW, POLY_DISCRIMINANT_IN_CARRIER] THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B"]
        RING_HOMOMORPHISM_POW) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => ASM_SIMP_TAC [th]) THEN
      UNDISCH_THEN (← q r"(d:B) = h(e:A)") (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:A") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(h:A->B) e IN ring_carrier l") ASSUME_TAC THENL
       [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"d:B", ← q r"(h:A->B) e"]
        INTEGRAL_DOMAIN_SQUARE_EQ) THEN
      ASM_REWRITE_TAC [] THEN
      UNDISCH_THEN (← q r"ring_pow k (e:A) 2 = poly_discriminant k p")
       (SUBST1_TAC o SYM) THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B"]
        RING_HOMOMORPHISM_POW) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => ASM_SIMP_TAC [th]) THEN
      STRIP_TAC THENL
       [EXISTS_TAC (← q r"e:A") THEN ASM_REWRITE_TAC [],
        EXISTS_TAC (← q r"ring_neg k e:A") THEN
        ASM_SIMP_TAC [RING_NEG] THEN ASM_MESON_TAC [RING_HOMOMORPHISM_NEG]]]))

  let GALOIS_GROUP_CUBIC ← (do
    let lemma ← prove
     r"!c. c divides FACT 3 /\ 3 divides c ==> c = 3 \/ c = 6"
     (REWRITE_TAC [FACT, ← ExceptT.mk (num_CONV (← q r"3")),
                   ← ExceptT.mk (num_CONV (← q r"2")),
                   ← ExceptT.mk (num_CONV (← q r"1"))] THEN
      CONV_TAC NUM_REDUCE_CONV THEN
      GEN_TAC THEN ASM_CASES_TAC (← q r"c < 7") THENL
       [POP_ASSUM MP_TAC THEN SPEC_TAC (← q r"c:num", ← q r"c:num") THEN
        CONV_TAC EXPAND_CASES_CONV THEN
        CONV_TAC (ONCE_DEPTH_CONV DIVIDES_CONV) THEN
        CONV_TAC NUM_REDUCE_CONV,
        DISCH_THEN (MP_TAC o MATCH_MP DIVIDES_LE o CONJUNCT1) THEN
        ASM_ARITH_TAC])
    prove
     r"!(h:A->B) k l p.
        splitting_extension(k,l) h p /\ ring_irreducible(poly_ring k (:1)) p /\
        poly_separable k p /\ poly_deg k p = 3 /\
        ~(ring_of_num k 2 = ring_0 k)
        ==> (CARD(group_carrier(galois_group(k,l) h)) = 3 <=>
             ?d. d IN ring_carrier k /\
                 ring_pow k d 2 = poly_discriminant k p) /\
            (CARD(group_carrier(galois_group(k,l) h)) = 6 <=>
             ~(?d. d IN ring_carrier k /\
                   ring_pow k d 2 = poly_discriminant k p))"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
        GALOIS_GROUP_EVEN_EQ_DISCRIMINANT_SQUARE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [splitting_extension]) THEN
      SUBGOAL_THEN (← q r"finite_extension(k,l) (h:A->B) /\ galois_extension(k,l) h")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] FINITE_GALOIS_GROUP) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
        GALOIS_GROUP_ACTION_ON_ROOTS) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
        GALOIS_GROUP_CARD_ROOTS_DIVIDES) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
        POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
        POLY_ROOT_BOUND_EXTENSION) THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"!f:B->B. (\x. if x IN ring_carrier l /\
                     poly_eval l ((h:A->B) o p) x = ring_0 l
                  then f x else x) =
             (\x. if x IN {x | x IN ring_carrier l /\
                               poly_eval l (h o p) x = ring_0 l}
                  then f x else x)")
      (fun th => REWRITE_TAC [th]) THENL [REWRITE_TAC [IN_ELIM_THM], ALL_TAC] THEN
      ABBREV_TAC
       (← q r"R = {x | x IN ring_carrier l /\
             poly_eval l ((h:A->B) o (p:(1->num)->A)) x = ring_0 l}") THEN
      REPEAT (DISCH_THEN STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o GEN_REWRITE_RULE I
       [group_monomorphism]) THEN
      SUBGOAL_THEN
       (← q r"!f. f IN group_carrier(galois_group(k,l) (h:A->B))
        ==> (\x. if x IN R then f x else x) permutes R")
      ASSUME_TAC THENL
       [FIRST_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE I
         [group_homomorphism]) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, SYMMETRIC_GROUP, IN_ELIM_THM] THEN
        DISCH_THEN ACCEPT_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"CARD(group_carrier(galois_group(k,l) (h:A->B))) = 3 \/
    CARD(group_carrier(galois_group(k,l) h)) = 6")
      MP_TAC THENL
       [MATCH_MP_TAC lemma THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
          GALOIS_EXTENSION_EQ_CARD) THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
          SPLITTING_EXTENSION_DEGREE_DIVIDES_FACT) THEN
        ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
        UNDISCH_TAC
         (← q r"CARD(R:B->bool) divides
      CARD(group_carrier(galois_group(k,l) (h:A->B)))") THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (DISJ_CASES_THEN (fun th =>
        ASSUME_TAC th THEN REWRITE_TAC [th])) THEN
      CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [] THENL
       [X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"f:B->B"]
          GROUP_POW_GROUP_ORDER) THEN
        ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"symmetric_group(R:B->bool)",
                          ← q r"\f x. if x IN R then (f:B->B) x else x"]
          GROUP_HOMOMORPHISM_POW) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPECL [← q r"f:B->B", ← q r"3"]) THEN
        ASM_REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP), I_THM, COND_ID] THEN
        DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"\x. if x IN R then (f:B->B) x else x", ← q r"R:B->bool", ← q r"3"]
          EVENPERM_GROUP_POW) THEN
        ANTS_TAC THENL
         [REWRITE_TAC [PERMUTATION_PERMUTES] THEN EXISTS_TAC (← q r"R:B->bool") THEN
          ASM_SIMP_TAC [],
          FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [EVENPERM_ID, ARITH]],
        SUBGOAL_THEN (← q r"?a b:B. a IN R /\ b IN R /\ ~(a = b)")
        STRIP_ASSUME_TAC THENL
         [MP_TAC (← ExceptT.mk (HAS_SIZE_CONV (← q r"(R:B->bool) HAS_SIZE 3"))) THEN
          ASM_REWRITE_TAC [HAS_SIZE] THEN STRIP_TAC THEN
          MAP_EVERY EXISTS_TAC [← q r"a:B", ← q r"a':B"] THEN ASM_REWRITE_TAC [IN_INSERT],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"IMAGE (\f x. if x IN R then (f:B->B) x else x)
            (group_carrier(galois_group(k,l) (h:A->B))) =
      group_carrier(symmetric_group R)")
        MP_TAC THENL
         [MATCH_MP_TAC CARD_SUBSET_EQ THEN
          ASM_SIMP_TAC [FINITE_SYMMETRIC_GROUP, CARD_SYMMETRIC_GROUP] THEN
          CONJ_TAC THENL
           [FIRST_ASSUM (ACCEPT_TAC o CONJUNCT1 o
              GEN_REWRITE_RULE I [group_homomorphism]),
            wPart lhand (fun t => do lhand (← rand t)) CARD_IMAGE_INJ THEN
            ANTS_TAC THENL
             [CONJ_TAC THENL
               [FIRST_ASSUM (ACCEPT_TAC o CONJUNCT2 o
                  GEN_REWRITE_RULE I [group_monomorphism]),
                FIRST_ASSUM ACCEPT_TAC],
              DISCH_THEN SUBST1_TAC] THEN
            ASM_REWRITE_TAC [FACT, ← ExceptT.mk (num_CONV (← q r"3")),
                             ← ExceptT.mk (num_CONV (← q r"2")),
                             ← ExceptT.mk (num_CONV (← q r"1"))] THEN
            CONV_TAC NUM_REDUCE_CONV],
          ALL_TAC] THEN
        REWRITE_TAC [EXTENSION, IN_IMAGE, SYMMETRIC_GROUP, IN_ELIM_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"swap(a:B,b)")) THEN
        ASM_SIMP_TAC [PERMUTES_SWAP] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:B->B") STRIP_ASSUME_TAC) THEN
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN EXISTS_TAC (← q r"f:B->B") THEN
        FIRST_X_ASSUM (SUBST1_TAC o SYM o check (is_eq o concl)) THEN
        ASM_REWRITE_TAC [EVENPERM_SWAP]]))

  -- @@RETURN BEGIN
  return { GALOIS_GROUP_EVEN_EQ_DISCRIMINANT_SQUARE, GALOIS_GROUP_CUBIC }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Galois groups of finite fields. A finite field l is a finite Galois       -/
/- extension of each subfield k, being the splitting extension of the        -/
/- separable polynomial X^|l| - X. The Frobenius map x |-> x^q, q the number -/
/- of elements of k (the identity outside the carrier of l), is in the       -/
/- Galois group, and its order is [l:k], since its d-th power, the map       -/
/- x |-> x^(q^d), fixes at most q^d elements. Hence the Galois group is      -/
/- cyclic of order [l:k], generated by the Frobenius map. For each divisor d -/
/- of [l:k] the fixed field of the d-th power of the Frobenius map, the set  -/
/- of solutions of x^(q^d) = x, is an intermediate field of degree d, and it -/
/- is the only one of that degree; there are none of other degrees.          -/
/- ------------------------------------------------------------------------- -/

structure FiniteFieldGalois where
  -- @@FIELDS
  FINITE_FIELD_GALOIS_EXTENSION : thm
  GALOIS_GROUP_POW_RING_POW : thm
  GALOIS_GROUP_POW_ROOT : thm
  GALOIS_GROUP_FROBENIUS : thm
  GALOIS_GROUP_FINITE_FIELD : thm
  CYCLIC_GALOIS_GROUP_FINITE_FIELD : thm
  FINITE_FIELD_INTERMEDIATE_FIELD_DIVISOR : thm
  FINITE_FIELD_INTERMEDIATE_FIELDS : thm
  deriving Inhabited

@[nospecialize]
def setupFiniteFieldGalois [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BGaloisCorrespondence : GaloisCorrespondence) :
    ExceptT String IO FiniteFieldGalois := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, SET_TAC, .. } := D
  let { CARD_CYCLIC_SUBGROUP_ORDER, CARD_EQ_0, CARD_EXTENSION_DEGREE, CARD_SUBSET,
        CYCLIC_GROUP_ALT, DIVIDES_DIV_MULT, DIVIDES_LE, DIVIDES_REFL, DIVIDES_ZERO,
        DIV_EQ_0, EQ_MULT_RCANCEL, EXISTS_UNIQUE_THM, EXP, EXP_1,
        EXTENSION_DEGREE_EQ_0, EXTENSION_DEGREE_TOWER_LAW,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_EXTENSION_SUBFIELD_GENERATED,
        FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FINITE_CYCLIC_SUBGROUP_ORDER,
        FINITE_EQ_FIELD_EXTENSION, FINITE_FIELD_CARD_GE_2,
        FINITE_FIELD_INTERMEDIATE_FIELD_EXPLICIT, FINITE_FIELD_SPLITTING_EXTENSION,
        FINITE_RING_MONOMORPHIC_PREIMAGE, FUN_EQ_THM,
        GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER, GROUP_ELEMENT_ORDER_POW, GROUP_POW, .. } := D.core1
  let { GROUP_POW_EQ_ID, IN_ELIM_THM, I_O_ID, I_THM, LE_EXP, LE_TRANS, MULT_SYM,
        NOT_LT, .. } := D.core2
  let { RESTRICT_PERMUTES_EQ, RING_AUTOMORPHISM_EQ, RING_ENDOMORPHISM_POW_CARD,
        RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_POW, RING_ISOMORPHISM,
        RING_ISOMORPHISM_EQ_MONOMORPHISM_FINITE, RING_MONOMORPHISM_IMP_HOMOMORPHISM,
        RING_POW, RING_POW_1, RING_POW_FIXPOINTS_BOUND, RING_POW_POW, .. } := D.core3
  let { SUBGROUP_GENERATED_ELEMENT_ORDER, SUBGROUP_SUBGROUP_GENERATED, SUBSET, divides,
        field_extension, group_pow, o_THM, ring_automorphism, ring_endomorphism, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_RING_HOMOMORPHISM, IN_GALOIS_GROUP, .. } := BGaloisGroup
  let { CARD_GALOIS_GROUP_LE, .. } := BGaloisExtensions
  let { GALOIS_EXTENSION_EQ_CARD, GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING, .. } := BGaloisExtension
  let { GALOIS_CORRESPONDENCE_DEGREE, GALOIS_GROUP_FIXED_FIELD, .. } := BGaloisCorrespondence
  -- @@SCOPE END

  let FINITE_FIELD_GALOIS_EXTENSION ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h /\ FINITE(ring_carrier l)
        ==> finite_extension(k,l) h /\ galois_extension(k,l) h"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      FINITE_FIELD_SPLITTING_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN MESON_TAC [])

  /- Powers in the Galois group are compositions, so the powers of a power map -/
  /- are power maps; no hypotheses are needed.                                 -/
  let GALOIS_GROUP_POW_RING_POW ← prove
   r"!(h:A->B) k l n j.
        group_pow (galois_group(k,l) h)
                  (\x. if x IN ring_carrier l then ring_pow l x n else x) j =
        (\x. if x IN ring_carrier l then ring_pow l x (n EXP j) else x)"
   (REPEAT GEN_TAC THEN SPEC_TAC (← q r"j:num", ← q r"j:num") THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [group_pow, GALOIS_GROUP] THEN
    REWRITE_TAC [FUN_EQ_THM, I_THM, o_THM, EXP] THEN X_GEN_TAC (← q r"x:B") THEN
    ASM_CASES_TAC (← q r"(x:B) IN ring_carrier l") THEN
    ASM_SIMP_TAC [RING_POW_1, RING_POW, RING_POW_POW, MULT_SYM])

  /- Likewise at one element: if f(z) = z^c then f^d(z) = z^(c^d).        -/
  let GALOIS_GROUP_POW_ROOT ← prove
   r"!(h:A->B) k l f z c d.
        f IN group_carrier(galois_group(k,l) h) /\ z IN ring_carrier l /\
        f z = ring_pow l z c
        ==> group_pow (galois_group(k,l) h) f d z = ring_pow l z (c EXP d)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM) THEN
    SPEC_TAC (← q r"d:num", ← q r"d:num") THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [group_pow, GALOIS_GROUP, I_THM, EXP, RING_POW_1, o_THM] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"f:B->B"] RING_HOMOMORPHISM_POW) THEN
    ASM_SIMP_TAC [RING_POW_POW])

  /- If the d-th power of the Frobenius map is the identity, all |k|^[l:k]     -/
  /- elements of l satisfy x^(q^d) = x, so [l:k] <= d                          -/
  /- (RING_POW_FIXPOINTS_BOUND).                                               -/
  let GALOIS_GROUP_FROBENIUS ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h /\ FINITE(ring_carrier l)
        ==> (\x. if x IN ring_carrier l
                 then ring_pow l x (CARD(ring_carrier k)) else x)
            IN group_carrier(galois_group(k,l) h) /\
            group_element_order (galois_group(k,l) h)
             (\x. if x IN ring_carrier l
                  then ring_pow l x (CARD(ring_carrier k)) else x) =
            extension_degree(k,l) h"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"FINITE(ring_carrier(k:A ring))") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_RING_MONOMORPHIC_PREIMAGE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"finite_extension(k,l) (h:A->B)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [FINITE_EQ_FIELD_EXTENSION], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] CARD_GALOIS_GROUP_LE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] CARD_EXTENSION_DEGREE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"q = CARD(ring_carrier(k:A ring))") THEN
    ABBREV_TAC (← q r"n = extension_degree(k,l) (h:A->B)") THEN
    ABBREV_TAC (← q r"f = \x. if x IN ring_carrier l then ring_pow l x q else x:B") THEN
    SUBGOAL_THEN (← q r"2 <= q") ASSUME_TAC THENL
     [EXPAND_TAC "q" THEN ASM_SIMP_TAC [FINITE_FIELD_CARD_GE_2], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"f IN group_carrier(galois_group(k,l) (h:A->B))")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"1"]
        RING_ENDOMORPHISM_POW_CARD) THEN
      ASM_REWRITE_TAC [EXP_1] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"ring_automorphism l (\x:B. ring_pow l x q)") MP_TAC THENL
       [REWRITE_TAC [ring_automorphism] THEN
        ASM_SIMP_TAC [RING_ISOMORPHISM_EQ_MONOMORPHISM_FINITE] THEN
        MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
        ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING, ← GSYM ring_endomorphism],
        DISCH_TAC] THEN
      EXPAND_TAC "f" THEN REWRITE_TAC [IN_GALOIS_GROUP] THEN REPEAT CONJ_TAC THENL
       [UNDISCH_TAC (← q r"ring_automorphism l (\x:B. ring_pow l x q)") THEN
        REWRITE_TAC [ring_automorphism, RING_ISOMORPHISM] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [RESTRICT_PERMUTES_EQ],
        MATCH_MP_TAC RING_AUTOMORPHISM_EQ THEN
        EXISTS_TAC (← q r"\x:B. ring_pow l x q") THEN ASM_SIMP_TAC [],
        ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER]],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"d = group_element_order (galois_group(k,l) (h:A->B)) f") THEN
    SUBGOAL_THEN (← q r"~(d = 0) /\ d <= n") STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"f:B->B"]
        GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER) THEN
      SUBGOAL_THEN (← q r"~(group_carrier(galois_group(k,l) (h:A->B)) = {})")
      MP_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC [← GSYM CARD_EQ_0]] THEN
      REPEAT DISCH_TAC THEN CONJ_TAC THENL
       [DISCH_TAC THEN UNDISCH_TAC
         (← q r"d divides CARD(group_carrier(galois_group(k,l) (h:A->B)))") THEN
        ASM_REWRITE_TAC [DIVIDES_ZERO],
        FIRST_X_ASSUM (MP_TAC o MATCH_MP DIVIDES_LE) THEN ASM_ARITH_TAC],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!x:B. x IN ring_carrier l ==> ring_pow l x (q EXP d) = x")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"f:B->B", ← q r"d:num"]
        GROUP_POW_EQ_ID) THEN
      ASM_REWRITE_TAC [DIVIDES_REFL] THEN EXPAND_TAC "f" THEN
      REWRITE_TAC [GALOIS_GROUP_POW_RING_POW, GALOIS_GROUP] THEN
      REWRITE_TAC [FUN_EQ_THM, I_THM] THEN MESON_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"q EXP d"] RING_POW_FIXPOINTS_BOUND) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
      TRANS_TAC LE_TRANS (← q r"q EXP 1") THEN
      ASM_REWRITE_TAC [EXP_1, LE_EXP] THEN ASM_ARITH_TAC,
      STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"q EXP n <= q EXP d") MP_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"CARD(ring_carrier(l:B ring))"
        let ok := is_eq (concl th) &&
          (match lhs (concl th) with | .ok t => t == c | .error _ => false)
        if !ok then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      TRANS_TAC LE_TRANS
       (← q r"CARD {x:B | x IN ring_carrier l /\ ring_pow l x (q EXP d) = x}") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CARD_SUBSET THEN
      ASM_SIMP_TAC [SUBSET, IN_ELIM_THM],
      ASM_REWRITE_TAC [LE_EXP] THEN ASM_ARITH_TAC])

  let GALOIS_GROUP_FINITE_FIELD ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h /\ FINITE(ring_carrier l)
        ==> (\x. if x IN ring_carrier l
                 then ring_pow l x (CARD(ring_carrier k)) else x)
            IN group_carrier(galois_group(k,l) h) /\
            subgroup_generated (galois_group(k,l) h)
              {\x. if x IN ring_carrier l
                   then ring_pow l x (CARD(ring_carrier k)) else x} =
            galois_group(k,l) h /\
            CARD(group_carrier(galois_group(k,l) h)) = extension_degree(k,l) h"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      FINITE_FIELD_GALOIS_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] CARD_GALOIS_GROUP_LE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] GALOIS_GROUP_FROBENIUS) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN STRIP_ASSUME_TAC) THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_ELEMENT_ORDER])

  let CYCLIC_GALOIS_GROUP_FINITE_FIELD ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h /\ FINITE(ring_carrier l)
        ==> cyclic_group(galois_group(k,l) h)"
   (REWRITE_TAC [CYCLIC_GROUP_ALT] THEN MESON_TAC [GALOIS_GROUP_FINITE_FIELD])

  /- The fixed field of the subgroup generated by the d-th power of the        -/
  /- Frobenius map, of order [l:k] / d, has degree d over k; by                -/
  /- FINITE_FIELD_INTERMEDIATE_FIELD_EXPLICIT it is the set of solutions of    -/
  /- x^(q^d) = x.                                                              -/
  let FINITE_FIELD_INTERMEDIATE_FIELD_DIVISOR ← prove
   r"!(h:A->B) k l d.
        field_extension(k,l) h /\ FINITE(ring_carrier l) /\
        d divides extension_degree(k,l) h
        ==> {x | x IN ring_carrier l /\
                 ring_pow l x (CARD(ring_carrier k) EXP d) = x} subfield_of l /\
            IMAGE h (ring_carrier k) SUBSET
            {x | x IN ring_carrier l /\
                 ring_pow l x (CARD(ring_carrier k) EXP d) = x} /\
            extension_degree
             (k,subfield_generated l
                 {x | x IN ring_carrier l /\
                      ring_pow l x (CARD(ring_carrier k) EXP d) = x}) h = d"
   (← do
    let m1 ← MESON [EQ_MULT_RCANCEL]
     (← q r"!a b c m:num. a * c = m ==> b * c = m /\ ~(c = 0) ==> a = b")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      FINITE_FIELD_GALOIS_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      GALOIS_GROUP_FINITE_FIELD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] GALOIS_GROUP_FROBENIUS) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] EXTENSION_DEGREE_EQ_0) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] CARD_GALOIS_GROUP_LE) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"n = extension_degree(k,l) (h:A->B)") THEN
    ABBREV_TAC
     (← q r"f = \x. if x IN ring_carrier l
            then ring_pow l x (CARD(ring_carrier(k:A ring))) else x:B") THEN
    REPEAT (DISCH_THEN STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"~(d = 0) /\ d * (n DIV d) = n /\ ~(n DIV d = 0)")
    STRIP_ASSUME_TAC THENL
     [ONCE_REWRITE_TAC [MULT_SYM] THEN
      ASM_REWRITE_TAC [← GSYM DIVIDES_DIV_MULT] THEN
      ASM_CASES_TAC (← q r"d:num = 0") THENL
       [UNDISCH_TAC (← q r"(d:num) divides n") THEN ASM_REWRITE_TAC [DIVIDES_ZERO],
        ASM_SIMP_TAC [DIV_EQ_0, NOT_LT]] THEN
      MP_TAC (← SPECL [← q r"d:num", ← q r"n:num"] DIVIDES_LE) THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"H = group_carrier(subgroup_generated (galois_group(k,l) (h:A->B))
                       {group_pow (galois_group(k,l) h) f d})") THEN
    SUBGOAL_THEN (← q r"CARD(H:(B->B)->bool) = n DIV d") ASSUME_TAC THENL
     [EXPAND_TAC "H" THEN
      MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"f:B->B", ← q r"d:num"]
        GROUP_ELEMENT_ORDER_POW) THEN
      MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)",
                     ← q r"group_pow (galois_group(k,l) (h:A->B)) f d"]
        CARD_CYCLIC_SUBGROUP_ORDER) THEN
      MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)",
                     ← q r"group_pow (galois_group(k,l) (h:A->B)) f d"]
        FINITE_CYCLIC_SUBGROUP_ORDER) THEN
      ASM_SIMP_TAC [GROUP_POW],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"H:(B->B)->bool"]
      GALOIS_GROUP_FIXED_FIELD) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN EXPAND_TAC "H" THEN
      REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED],
      STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"fixed_field l (H:(B->B)->bool)"]
      GALOIS_CORRESPONDENCE_DEGREE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o CONJUNCT2) THEN
    DISCH_THEN (MP_TAC o MATCH_MP m1) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"d:num")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"fixed_field l (H:(B->B)->bool)"]
      FINITE_FIELD_INTERMEDIATE_FIELD_EXPLICIT) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_REWRITE_TAC []))

  let FINITE_FIELD_INTERMEDIATE_FIELDS ← prove
   r"!(h:A->B) k l d.
        field_extension(k,l) h /\ FINITE(ring_carrier l)
        ==> (d divides extension_degree(k,l) h <=>
             ?!s. s subfield_of l /\ IMAGE h (ring_carrier k) SUBSET s /\
                  extension_degree(k,subfield_generated l s) h = d)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [EXISTS_UNIQUE_THM] THEN
    EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"d:num"]
          FINITE_FIELD_INTERMEDIATE_FIELD_DIVISOR) THEN
        ASM_REWRITE_TAC [] THEN MESON_TAC [],
        MAP_EVERY X_GEN_TAC [← q r"s:B->bool", ← q r"t:B->bool"] THEN STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"t:B->bool"]
          FINITE_FIELD_INTERMEDIATE_FIELD_EXPLICIT) THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
          FINITE_FIELD_INTERMEDIATE_FIELD_EXPLICIT) THEN
        ASM_REWRITE_TAC [] THEN MESON_TAC []],
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:B->bool") STRIP_ASSUME_TAC o CONJUNCT1) THEN
      REWRITE_TAC [divides] THEN
      EXISTS_TAC (← q r"extension_degree(subfield_generated l (s:B->bool),l) I") THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                     ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring"]
        EXTENSION_DEGREE_TOWER_LAW) THEN
      ASM_SIMP_TAC [I_O_ID, FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
                   FIELD_EXTENSION_SUBFIELD_GENERATED] THEN
      ASM_MESON_TAC [field_extension]])

  -- @@RETURN BEGIN
  return { FINITE_FIELD_GALOIS_EXTENSION, GALOIS_GROUP_POW_RING_POW,
           GALOIS_GROUP_POW_ROOT, GALOIS_GROUP_FROBENIUS, GALOIS_GROUP_FINITE_FIELD,
           CYCLIC_GALOIS_GROUP_FINITE_FIELD, FINITE_FIELD_INTERMEDIATE_FIELD_DIVISOR,
           FINITE_FIELD_INTERMEDIATE_FIELDS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Hilbert 90. The norm and the trace of a finite Galois extension are       -/
/- written as the product and the sum over the Galois group G: they lie in   -/
/- the fixed field of G (for a Galois extension, in the image of the base),  -/
/- are multiplicative and additive, and do not change when x is replaced by  -/
/- f(x) for f in G. By the independence of the elements of G, due to         -/
/- Dedekind, some element has sum 1 over G. Every multiplicative 1-cocycle c -/
/- of G (c(f o g) = c(f) * f(c(g)), c(f) nonzero) is a coboundary f(b) / b,  -/
/- and every additive one (c(f o g) = c(f) + f(c(g))) is f(b) - b (Noether). -/
/- For G generated by g, x has product 1 over G exactly when x = y / g(y),   -/
/- and sum 0 exactly when x = y - g(y). The Galois hypothesis is not needed  -/
/- in these results: they hold for the Galois group of any finite extension. -/
/- ------------------------------------------------------------------------- -/

structure Hilbert90 where
  -- @@FIELDS
  RING_SUM_GROUP_TRANSLATION : thm
  RING_PRODUCT_GROUP_TRANSLATION : thm
  RING_SUM_CYCLIC_GROUP : thm
  RING_PRODUCT_CYCLIC_GROUP : thm
  GALOIS_PRODUCT_IN_FIXED_FIELD : thm
  GALOIS_PRODUCT_IN_BASE : thm
  GALOIS_PRODUCT_CONJUGATE : thm
  GALOIS_PRODUCT_MUL : thm
  GALOIS_SUM_ADD : thm
  GALOIS_PRODUCT_EQ_0 : thm
  GALOIS_PRODUCT_BASE : thm
  ALGEBRA_TRACE_NORM_GALOIS : thm
  ALGEBRA_TRACE_NORM_FINITE_FIELD : thm
  GALOIS_GROUP_INDEPENDENT : thm
  GALOIS_SUM_EQ_1_EXISTS : thm
  HILBERT_90 : thm
  HILBERT_90_ADDITIVE : thm
  deriving Inhabited

@[nospecialize]
def setupHilbert90 [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BFixedFields : FixedFields) (BArtin : Artin) (BFiniteFieldGalois : FiniteFieldGalois) :
    ExceptT String IO Hilbert90 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, FIELD_TAC, GROUP_TAC, MESON, MESON_TAC, RING_RULE, SET_TAC,
        TAUT, .. } := D
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, ALGEBRAIC_IMP_FIELD_EXTENSION,
        ALGEBRA_TRACE_NORM_EMBEDDINGS_SEPARABLE, ALGEBRA_TRACE_NORM_IN_CARRIER,
        AND_FORALL_THM, BIJ, CONG_IMP_EQ, EQ_TRANS, FIELD_EXTENSION_IMP_SUBSET,
        FIELD_HOMOMORPHISM_INV, FIELD_IMP_INTEGRAL_DOMAIN, FIELD_INV_EQ_0,
        FIELD_MUL_RINV, FIELD_NONTRIVIAL, FINITE_CYCLIC_GROUP_POWERS,
        FINITE_IMP_FIELD_EXTENSION, FUN_IN_IMAGE, GROUP_INV, GROUP_MUL, .. } := D.core1
  let { INJ, INTEGRAL_DOMAIN_PRODUCT_EQ_0, IN_ELIM_THM, I_THM, LEFT_IMP_EXISTS_THM,
        PERMUTES_EQ, .. } := D.core2
  let { RESTRICTION, RING_1, RING_ADD_RDISTRIB, RING_HOMOMORPHISMS_INDEPENDENT_SET,
        RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_COMPOSE, RING_HOMOMORPHISM_IN_CARRIER,
        RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_NEG, RING_HOMOMORPHISM_PRODUCT,
        RING_HOMOMORPHISM_SUM, RING_INV, RING_MONOMORPHISM_EQ_0,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MONOMORPHISM_PRODUCT,
        RING_MONOMORPHISM_SUM, RING_MUL, RING_MUL_ASSOC, RING_MUL_LID, RING_MUL_RID,
        RING_NEG, RING_PRODUCT, RING_PRODUCT_CONST, RING_PRODUCT_EQ,
        RING_PRODUCT_EQ_GENERAL_INVERSES, RING_PRODUCT_IMAGE, RING_PRODUCT_MUL,
        RING_SUM, RING_SUM_ADD, RING_SUM_CONST, RING_SUM_EQ,
        RING_SUM_EQ_GENERAL_INVERSES, RING_SUM_IMAGE, RING_SUM_LMUL, RING_SUM_RMUL, .. } := D.core3
  let { SUBSET, SURJ, field_extension, o_DEF, o_THM, ring_monomorphism, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_FIXES, GALOIS_GROUP_I, GALOIS_GROUP_IN_CARRIER,
        GALOIS_GROUP_PERMUTES, GALOIS_GROUP_RING_HOMOMORPHISM,
        GALOIS_GROUP_RING_MONOMORPHISM, .. } := BGaloisGroup
  let { FINITE_GALOIS_GROUP, GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_NORMAL, .. } := BGaloisExtensions
  let { GALOIS_IMP_NORMAL_EXTENSION, GALOIS_IMP_SEPARABLE_EXTENSION, .. } := BGaloisExtension
  let { IN_FIXED_FIELD, .. } := BFixedFields
  let { FIXED_FIELD_GALOIS_GROUP, .. } := BArtin
  let { FINITE_FIELD_GALOIS_EXTENSION, GALOIS_GROUP_FINITE_FIELD,
        GALOIS_GROUP_POW_RING_POW, .. } := BFiniteFieldGalois
  -- @@SCOPE END

  /- Sums and products over a group are invariant under left and right         -/
  /- translations; products and sums over the Galois group of the images of    -/
  /- x lie in the fixed field, so in the image of k for a Galois extension.    -/

  let RING_SUM_GROUP_TRANSLATION ← prove
   r"!G (r:B ring) (u:A->B) a.
        a IN group_carrier G
        ==> ring_sum r (group_carrier G) (\x. u(group_mul G a x)) =
            ring_sum r (group_carrier G) u /\
            ring_sum r (group_carrier G) (\x. u(group_mul G x a)) =
            ring_sum r (group_carrier G) u"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN CONJ_TAC THEN
    MATCH_MP_TAC RING_SUM_EQ_GENERAL_INVERSES THENL
     [MAP_EVERY EXISTS_TAC
       [← q r"group_mul G (a:A)", ← q r"group_mul G (group_inv G a:A)"],
      MAP_EVERY EXISTS_TAC
       [← q r"\x. group_mul G x (a:A)", ← q r"\x. group_mul G x (group_inv G a:A)"]] THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV] THEN REPEAT STRIP_TAC THEN GROUP_TAC)

  let RING_PRODUCT_GROUP_TRANSLATION ← prove
   r"!G (r:B ring) (u:A->B) a.
        a IN group_carrier G
        ==> ring_product r (group_carrier G) (\x. u(group_mul G a x)) =
            ring_product r (group_carrier G) u /\
            ring_product r (group_carrier G) (\x. u(group_mul G x a)) =
            ring_product r (group_carrier G) u"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN CONJ_TAC THEN
    MATCH_MP_TAC RING_PRODUCT_EQ_GENERAL_INVERSES THENL
     [MAP_EVERY EXISTS_TAC
       [← q r"group_mul G (a:A)", ← q r"group_mul G (group_inv G a:A)"],
      MAP_EVERY EXISTS_TAC
       [← q r"\x. group_mul G x (a:A)", ← q r"\x. group_mul G x (group_inv G a:A)"]] THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV] THEN REPEAT STRIP_TAC THEN GROUP_TAC)

  let RING_SUM_CYCLIC_GROUP ← prove
   r"!G (a:A) (r:B ring) u.
        FINITE(group_carrier G) /\ a IN group_carrier G /\
        subgroup_generated G {a} = G
        ==> ring_sum r (group_carrier G) u =
            ring_sum r {i | i < CARD(group_carrier G)}
                       (\i. u(group_pow G a i))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP FINITE_CYCLIC_GROUP_POWERS) THEN
    ABBREV_TAC (← q r"n = CARD(group_carrier(G:A group))") THEN
    DISCH_THEN (CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"r:B ring", ← q r"group_pow G (a:A)", ← q r"u:A->B", ← q r"{i:num | i < n}"]
      RING_SUM_IMAGE) THEN
    REWRITE_TAC [o_DEF, IN_ELIM_THM] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_MESON_TAC [CONG_IMP_EQ])

  let RING_PRODUCT_CYCLIC_GROUP ← prove
   r"!G (a:A) (r:B ring) u.
        FINITE(group_carrier G) /\ a IN group_carrier G /\
        subgroup_generated G {a} = G
        ==> ring_product r (group_carrier G) u =
            ring_product r {i | i < CARD(group_carrier G)}
                           (\i. u(group_pow G a i))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP FINITE_CYCLIC_GROUP_POWERS) THEN
    ABBREV_TAC (← q r"n = CARD(group_carrier(G:A group))") THEN
    DISCH_THEN (CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"r:B ring", ← q r"group_pow G (a:A)", ← q r"u:A->B", ← q r"{i:num | i < n}"]
      RING_PRODUCT_IMAGE) THEN
    REWRITE_TAC [o_DEF, IN_ELIM_THM] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_MESON_TAC [CONG_IMP_EQ])

  let GALOIS_PRODUCT_IN_FIXED_FIELD ← prove
   r"!(h:A->B) k l x.
        x IN ring_carrier l
        ==> ring_product l (group_carrier(galois_group(k,l) h)) (\f. f x) IN
            fixed_field l (group_carrier(galois_group(k,l) h)) /\
            ring_sum l (group_carrier(galois_group(k,l) h)) (\f. f x) IN
            fixed_field l (group_carrier(galois_group(k,l) h))"
   (← do
    let t1 ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")
    pure (REPEAT GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [IN_FIXED_FIELD, RING_PRODUCT, RING_SUM, AND_FORALL_THM] THEN
    X_GEN_TAC (← q r"g:B->B") THEN
    REWRITE_TAC [t1] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!f. f IN group_carrier(galois_group(k,l) (h:A->B))
          ==> (f:B->B) x IN ring_carrier l")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_IN_CARRIER], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_RING_MONOMORPHISM) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (ASM_SIMP_TAC [← MATCH_MP RING_MONOMORPHISM_PRODUCT th,
                          ← MATCH_MP RING_MONOMORPHISM_SUM th])) THEN
    MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"l:B ring", ← q r"\f:B->B. f x",
                   ← q r"g:B->B"] RING_PRODUCT_GROUP_TRANSLATION) THEN
    MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"l:B ring", ← q r"\f:B->B. f x",
                   ← q r"g:B->B"] RING_SUM_GROUP_TRANSLATION) THEN
    ASM_REWRITE_TAC [← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP)), o_DEF] THEN
    SIMP_TAC []))

  let GALOIS_PRODUCT_IN_BASE ← prove
   r"!(h:A->B) k l x.
        galois_extension(k,l) h /\ x IN ring_carrier l
        ==> ring_product l (group_carrier(galois_group(k,l) h)) (\f. f x) IN
            IMAGE h (ring_carrier k) /\
            ring_sum l (group_carrier(galois_group(k,l) h)) (\f. f x) IN
            IMAGE h (ring_carrier k)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP FIXED_FIELD_GALOIS_GROUP) THEN
    ASM_SIMP_TAC [GALOIS_PRODUCT_IN_FIXED_FIELD])

  /- The product and the sum over the Galois group are unchanged when x is     -/
  /- replaced by f(x) for f in the group. For a finite extension the product   -/
  /- is multiplicative and vanishes only at 0, the sum is additive, and at an  -/
  /- element of the image of k they are its power and its multiple by the      -/
  /- order of the group.                                                       -/

  let GALOIS_PRODUCT_CONJUGATE ← prove
   r"!(h:A->B) f k l x.
        f IN group_carrier(galois_group(k,l) h)
        ==> ring_product l (group_carrier(galois_group(k,l) h)) (\g. g(f x)) =
            ring_product l (group_carrier(galois_group(k,l) h)) (\g. g x) /\
            ring_sum l (group_carrier(galois_group(k,l) h)) (\g. g(f x)) =
            ring_sum l (group_carrier(galois_group(k,l) h)) (\g. g x)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"l:B ring", ← q r"\g:B->B. g x",
                   ← q r"f:B->B"] RING_PRODUCT_GROUP_TRANSLATION) THEN
    MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"l:B ring", ← q r"\g:B->B. g x",
                   ← q r"f:B->B"] RING_SUM_GROUP_TRANSLATION) THEN
    ASM_REWRITE_TAC [← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP)), o_DEF] THEN
    SIMP_TAC [])

  let GALOIS_PRODUCT_MUL ← prove
   r"!(h:A->B) k l x y.
        finite_extension(k,l) h /\ x IN ring_carrier l /\ y IN ring_carrier l
        ==> ring_product l (group_carrier(galois_group(k,l) h))
                           (\f. f(ring_mul l x y)) =
            ring_mul l
             (ring_product l (group_carrier(galois_group(k,l) h)) (\f. f x))
             (ring_product l (group_carrier(galois_group(k,l) h)) (\f. f y))"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS
     (← q r"ring_product l (group_carrier(galois_group(k,l) (h:A->B)))
                 (\f. ring_mul l ((f:B->B) x) (f y))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_PRODUCT_EQ THEN X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL
          (← MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM th)])),
      MATCH_MP_TAC RING_PRODUCT_MUL THEN
      ASM_MESON_TAC [FINITE_GALOIS_GROUP, GALOIS_GROUP_IN_CARRIER]])

  let GALOIS_SUM_ADD ← prove
   r"!(h:A->B) k l x y.
        finite_extension(k,l) h /\ x IN ring_carrier l /\ y IN ring_carrier l
        ==> ring_sum l (group_carrier(galois_group(k,l) h))
                       (\f. f(ring_add l x y)) =
            ring_add l
             (ring_sum l (group_carrier(galois_group(k,l) h)) (\f. f x))
             (ring_sum l (group_carrier(galois_group(k,l) h)) (\f. f y))"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS
     (← q r"ring_sum l (group_carrier(galois_group(k,l) (h:A->B)))
             (\f. ring_add l ((f:B->B) x) (f y))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_ADD
          (← MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM th)])),
      MATCH_MP_TAC RING_SUM_ADD THEN
      ASM_MESON_TAC [FINITE_GALOIS_GROUP, GALOIS_GROUP_IN_CARRIER]])

  let GALOIS_PRODUCT_EQ_0 ← prove
   r"!(h:A->B) k l x.
        finite_extension(k,l) h /\ x IN ring_carrier l
        ==> (ring_product l (group_carrier(galois_group(k,l) h)) (\f. f x) =
             ring_0 l <=> x = ring_0 l)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"integral_domain(l:B ring) /\
      FINITE(group_carrier(galois_group(k,l) (h:A->B)))")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_GALOIS_GROUP, FINITE_IMP_FIELD_EXTENSION,
                    field_extension, FIELD_IMP_INTEGRAL_DOMAIN],
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_PRODUCT_EQ_0]] THEN
    EQ_TAC THENL
     [ASM_MESON_TAC [RING_MONOMORPHISM_EQ_0, GALOIS_GROUP_RING_MONOMORPHISM],
      DISCH_TAC THEN EXISTS_TAC (← q r"I:B->B") THEN
      ASM_REWRITE_TAC [GALOIS_GROUP_I, I_THM]])

  let GALOIS_PRODUCT_BASE ← prove
   r"!(h:A->B) k l x.
        finite_extension(k,l) h /\ x IN ring_carrier k
        ==> ring_product l (group_carrier(galois_group(k,l) h)) (\f. f(h x)) =
            ring_pow l (h x) (CARD(group_carrier(galois_group(k,l) h))) /\
            ring_sum l (group_carrier(galois_group(k,l) h)) (\f. f(h x)) =
            ring_mul l
             (ring_of_num l (CARD(group_carrier(galois_group(k,l) h)))) (h x)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(h:A->B) x IN ring_carrier l /\
      FINITE(group_carrier(galois_group(k,l) h)) /\
      !f. f IN group_carrier(galois_group(k,l) h) ==> f(h x) = h x")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_GALOIS_GROUP, FINITE_IMP_FIELD_EXTENSION,
                    FIELD_EXTENSION_IMP_SUBSET, GALOIS_GROUP_FIXES, SUBSET,
                    FUN_IN_IMAGE],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"\f:B->B. f((h:A->B) x)", ← q r"\f:B->B. (h:A->B) x",
                   ← q r"group_carrier(galois_group(k,l) (h:A->B))"]
      RING_PRODUCT_EQ) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"\f:B->B. f((h:A->B) x)", ← q r"\f:B->B. (h:A->B) x",
                   ← q r"group_carrier(galois_group(k,l) (h:A->B))"]
      RING_SUM_EQ) THEN
    ASM_SIMP_TAC [RING_PRODUCT_CONST, RING_SUM_CONST])

  /- For a finite Galois extension the norm and the trace are the product and  -/
  /- the sum over the Galois group.                                            -/

  let ALGEBRA_TRACE_NORM_GALOIS ← prove
   r"!(h:A->B) k l x.
        finite_extension(k,l) h /\ galois_extension(k,l) h /\
        x IN ring_carrier l
        ==> h(algebra_norm(k,l) h x) =
            ring_product l (group_carrier(galois_group(k,l) h)) (\s. s x) /\
            h(algebra_trace(k,l) h x) =
            ring_sum l (group_carrier(galois_group(k,l) h)) (\s. s x)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    MP_TAC (← ISPEC (← q r"l:B ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:(B#num)ring", ← q r"j:B->B#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"j:B->B#num"
      if !((← liftExcept (rand (concl th))) == c) then throw "check"
      pure (ASSUME_TAC (← MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM th))) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"n:(B#num)ring", ← q r"x:B"]
      ALGEBRA_TRACE_NORM_EMBEDDINGS_SEPARABLE) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [GALOIS_IMP_SEPARABLE_EXTENSION] THEN
      MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_REWRITE_TAC [],
      REWRITE_TAC [o_THM] THEN STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->B#num", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"n:(B#num)ring"]
      GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_NORMAL) THEN
    ASM_SIMP_TAC [GALOIS_IMP_NORMAL_EXTENSION, FIELD_IMP_INTEGRAL_DOMAIN] THEN
    ABBREV_TAC (← q r"Gal = group_carrier(galois_group(k,l) (h:A->B))") THEN
    ABBREV_TAC (← q r"E = ring_homomorphism_extensions (k,l,n)
                    (h:A->B,(j:B->B#num) o h)") THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"E = IMAGE (\f:B->B. RESTRICTION (ring_carrier l) ((j:B->B#num) o f))
              Gal /\
      (!f f'. f IN Gal /\ f' IN Gal /\
              RESTRICTION (ring_carrier l) ((j:B->B#num) o f) =
              RESTRICTION (ring_carrier l) (j o f')
              ==> f = f')")
    STRIP_ASSUME_TAC THENL
     [UNDISCH_TAC
       (← q r"BIJ (\f:B->B. RESTRICTION (ring_carrier l) ((j:B->B#num) o f))
            Gal E") THEN
      REWRITE_TAC [BIJ, INJ, SURJ] THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"FINITE(Gal:(B->B)->bool) /\
                  (!s:B->B. s IN Gal ==> s x IN ring_carrier l)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "Gal" THEN ASM_SIMP_TAC [FINITE_GALOIS_GROUP] THEN
      ASM_MESON_TAC [GALOIS_GROUP_IN_CARRIER],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_product n E (\s:B->B#num. s x) =
      (j:B->B#num) (ring_product l Gal (\s:B->B. s x)) /\
      ring_sum n E (\s:B->B#num. s x) =
      (j:B->B#num) (ring_sum l Gal (\s:B->B. s x))")
    STRIP_ASSUME_TAC THENL
     [SUBST1_TAC (← ASSUME
       (← q r"E = IMAGE (\f:B->B. RESTRICTION (ring_carrier l) ((j:B->B#num) o f))
                  Gal")) THEN
      MP_TAC (← ISPECL [← q r"n:(B#num)ring",
        ← q r"\f:B->B. RESTRICTION (ring_carrier l) ((j:B->B#num) o f)",
        ← q r"\s:B->B#num. s x", ← q r"Gal:(B->B)->bool"] RING_PRODUCT_IMAGE) THEN
      MP_TAC (← ISPECL [← q r"n:(B#num)ring",
        ← q r"\f:B->B. RESTRICTION (ring_carrier l) ((j:B->B#num) o f)",
        ← q r"\s:B->B#num. s x", ← q r"Gal:(B->B)->bool"] RING_SUM_IMAGE) THEN
      REPEAT (ANTS_TAC THENL
       [REWRITE_TAC [] THEN FIRST_ASSUM ACCEPT_TAC,
        DISCH_THEN SUBST1_TAC]) THEN
      REWRITE_TAC [o_DEF] THEN
      (← do
        let th ← ASSUME (← q r"ring_homomorphism(l,n) (j:B->B#num)")
        pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_PRODUCT th,
                            ← MATCH_MP RING_HOMOMORPHISM_SUM th])) THEN
      REWRITE_TAC [o_DEF] THEN CONJ_TAC THENL
       [MATCH_MP_TAC RING_PRODUCT_EQ, MATCH_MP_TAC RING_SUM_EQ] THEN
      ASM_SIMP_TAC [RESTRICTION, o_THM],
      ALL_TAC] THEN
    UNDISCH_THEN
     (← q r"!f f':B->B. f IN Gal /\ f' IN Gal /\
                  RESTRICTION (ring_carrier l) ((j:B->B#num) o f) =
                  RESTRICTION (ring_carrier l) (j o f')
                  ==> f = f'")
     (K ALL_TAC : thm → tactic) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      ALGEBRA_TRACE_NORM_IN_CARRIER) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    CONJ_TAC THEN
    MATCH_MP_TAC (← CONJUNCT2 (← REWRITE_RULE [ring_monomorphism]
     (← ASSUME (← q r"ring_monomorphism(l,n) (j:B->B#num)")))) THEN
    ASM_REWRITE_TAC [RING_PRODUCT, RING_SUM] THEN
    MATCH_MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B"]
      RING_HOMOMORPHISM_IN_CARRIER) THEN
    ASM_REWRITE_TAC [])

  /- For finite fields the Galois group is cyclic of order [l:k], generated by -/
  /- the Frobenius map x |-> x^q, q the number of elements of k                -/
  /- (GALOIS_GROUP_FINITE_FIELD), so the norm and the trace are the product    -/
  /- and the sum of the x^(q^i) for i < [l:k].                                 -/

  let ALGEBRA_TRACE_NORM_FINITE_FIELD ← prove
   r"!(h:A->B) k l x.
        field_extension(k,l) h /\ FINITE(ring_carrier l) /\ x IN ring_carrier l
        ==> h(algebra_norm(k,l) h x) =
            ring_product l {i | i < extension_degree(k,l) h}
                         (\i. ring_pow l x (CARD(ring_carrier k) EXP i)) /\
            h(algebra_trace(k,l) h x) =
            ring_sum l {i | i < extension_degree(k,l) h}
                     (\i. ring_pow l x (CARD(ring_carrier k) EXP i))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      FINITE_FIELD_GALOIS_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      ALGEBRA_TRACE_NORM_GALOIS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (CONJUNCTS_THEN SUBST1_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      GALOIS_GROUP_FINITE_FIELD) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC
     (← q r"g = \y. if y IN ring_carrier l
            then ring_pow l y (CARD(ring_carrier(k:A ring))) else y:B") THEN
    STRIP_TAC THEN
    UNDISCH_THEN
     (← q r"CARD(group_carrier(galois_group(k,l) (h:A->B))) = extension_degree(k,l) h")
     (SUBST1_TAC o SYM) THEN
    MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"g:B->B", ← q r"l:B ring",
                   ← q r"\s:B->B. s x"] RING_PRODUCT_CYCLIC_GROUP) THEN
    MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"g:B->B", ← q r"l:B ring",
                   ← q r"\s:B->B. s x"] RING_SUM_CYCLIC_GROUP) THEN
    ASM_SIMP_TAC [FINITE_GALOIS_GROUP] THEN
    REPEAT (DISCH_THEN SUBST1_TAC) THEN
    EXPAND_TAC "g" THEN REWRITE_TAC [GALOIS_GROUP_POW_RING_POW] THEN
    ASM_REWRITE_TAC [])

  /- The elements of the Galois group of a finite extension are linearly       -/
  /- independent over l (Dedekind), so some element has sum 1 over the group.  -/

  let GALOIS_GROUP_INDEPENDENT ← prove
   r"!(h:A->B) k l c.
        finite_extension(k,l) h /\
        (!f. f IN group_carrier(galois_group(k,l) h)
             ==> c f IN ring_carrier l) /\
        (!x. x IN ring_carrier l
             ==> ring_sum l (group_carrier(galois_group(k,l) h))
                   (\f. ring_mul l (c f) (f x)) = ring_0 l)
        ==> !f. f IN group_carrier(galois_group(k,l) h) ==> c f = ring_0 l"
   (← do
    let m1 ← MESON []
     (← q r"~(!x:B. P x ==> (f:B->B) x = g x) ==> ?x. P x /\ ~(f x = g x)")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring",
                   ← q r"group_carrier(galois_group(k,l) (h:A->B))",
                   ← q r"c:(B->B)->B"] RING_HOMOMORPHISMS_INDEPENDENT_SET) THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_FIELD_EXTENSION, field_extension,
                    FIELD_IMP_INTEGRAL_DOMAIN],
      ASM_MESON_TAC [FINITE_GALOIS_GROUP],
      REWRITE_TAC [GALOIS_GROUP_RING_HOMOMORPHISM],
      MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
      MATCH_MP_TAC m1 THEN
      ASM_MESON_TAC [PERMUTES_EQ, GALOIS_GROUP_PERMUTES]]))

  let GALOIS_SUM_EQ_1_EXISTS ← prove
   r"!(h:A->B) k l.
        finite_extension(k,l) h
        ==> ?x. x IN ring_carrier l /\
                ring_sum l (group_carrier(galois_group(k,l) h)) (\f. f x) =
                ring_1 l"
   (← do
    let t1 ← TAUT (← q r"~q /\ (~p ==> r) ==> (r ==> q) ==> p")
    pure (REPEAT GEN_TAC THEN
    ABBREV_TAC (← q r"G = group_carrier(galois_group(k,l) (h:A->B))") THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"field(l:B ring) /\ FINITE(G:(B->B)->bool) /\
      (!f. f IN G ==> ring_homomorphism(l,l) (f:B->B)) /\
      (!f x. f IN G /\ x IN ring_carrier l ==> (f:B->B) x IN ring_carrier l)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "G" THEN
      REWRITE_TAC [GALOIS_GROUP_IN_CARRIER, GALOIS_GROUP_RING_HOMOMORPHISM] THEN
      ASM_MESON_TAC [FINITE_GALOIS_GROUP, FINITE_IMP_FIELD_EXTENSION,
                    field_extension],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?x. x IN ring_carrier l /\ ~(ring_sum l G (\f. (f:B->B) x) = ring_0 l)")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                     ← q r"\f:B->B. ring_1(l:B ring)"] GALOIS_GROUP_INDEPENDENT) THEN
      ASM_REWRITE_TAC [RING_1] THEN
      SUBGOAL_THEN
       (← q r"!x. x IN ring_carrier l
            ==> ring_sum l G (\f. ring_mul l (ring_1 l) ((f:B->B) x)) =
                ring_sum l G (\f. f x)")
       (fun th => SIMP_TAC [th])
      THENL
       [REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_SUM_EQ THEN
        ASM_SIMP_TAC [RING_MUL_LID],
        ALL_TAC] THEN
      MATCH_MP_TAC t1 THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [FIELD_NONTRIVIAL, GALOIS_GROUP_I], MESON_TAC []],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"t = ring_sum l G (\f. (f:B->B) x)") THEN
    SUBGOAL_THEN
     (← q r"(t:B) IN ring_carrier l /\ !f. f IN G ==> (f:B->B) t = t")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
        GALOIS_PRODUCT_IN_FIXED_FIELD) THEN
      ASM_REWRITE_TAC [IN_FIXED_FIELD] THEN MESON_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"ring_mul l x (ring_inv l t):B") THEN
    ASM_SIMP_TAC [RING_MUL, RING_INV] THEN
    TRANS_TAC EQ_TRANS
     (← q r"ring_sum l G (\f. ring_mul l ((f:B->B) x) (ring_inv l t))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"ring_homomorphism(l,l) (f:B->B)") ASSUME_TAC THENL
       [ASM_SIMP_TAC [], ALL_TAC] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL th,
          ← MATCH_MP FIELD_HOMOMORPHISM_INV
              (← CONJ (← ASSUME (← q r"field(l:B ring)")) th),
          RING_INV])),
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"\f:B->B. f x", ← q r"ring_inv l t:B",
                     ← q r"G:(B->B)->bool"] RING_SUM_RMUL) THEN
      ASM_SIMP_TAC [RING_INV, FIELD_MUL_RINV]]))

  /- Hilbert 90 in the form of Noether: multiplicative and additive 1-cocycles -/
  /- of the Galois group of a finite extension are coboundaries. The cocycle   -/
  /- c is twisted into an element b = sum over f of c(f) * f(x) (with x chosen -/
  /- by Dedekind so that b is nonzero, resp. with x of sum 1), and then        -/
  /- g(b) = b / c(g), resp. g(b) = b - c(g), for each g in the group.          -/

  let HILBERT_90 ← (do
    let lemma ← prove
     r"!f a b c:A.
          field f /\ a IN ring_carrier f /\ b IN ring_carrier f /\
          c IN ring_carrier f /\ ~(b = ring_0 f) /\ ring_mul f c a = b
          ==> c = ring_div f (ring_inv f a) (ring_inv f b)"
     FIELD_TAC
    prove
     r"!(h:A->B) k l c.
          finite_extension(k,l) h /\
          (!f. f IN group_carrier(galois_group(k,l) h)
               ==> c f IN ring_carrier l /\ ~(c f = ring_0 l)) /\
          (!f g. f IN group_carrier(galois_group(k,l) h) /\
                 g IN group_carrier(galois_group(k,l) h)
                 ==> c(f o g) = ring_mul l (c f) (f(c g)))
          ==> ?b. b IN ring_carrier l /\ ~(b = ring_0 l) /\
                  !f. f IN group_carrier(galois_group(k,l) h)
                      ==> c f = ring_div l (f b) b"
     (REPEAT GEN_TAC THEN
      ABBREV_TAC (← q r"G = group_carrier(galois_group(k,l) (h:A->B))") THEN
      STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"field(l:B ring) /\ FINITE(G:(B->B)->bool) /\
        (!f. f IN G ==> ring_homomorphism(l,l) (f:B->B)) /\
        (!f x. f IN G /\ x IN ring_carrier l ==> (f:B->B) x IN ring_carrier l)")
      STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "G" THEN
        REWRITE_TAC [GALOIS_GROUP_IN_CARRIER, GALOIS_GROUP_RING_HOMOMORPHISM] THEN
        ASM_MESON_TAC [FINITE_GALOIS_GROUP, FINITE_IMP_FIELD_EXTENSION,
                      field_extension],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?x. x IN ring_carrier l /\
            ~(ring_sum l G (\f. ring_mul l (c f) ((f:B->B) x)) = ring_0 l)")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"c:(B->B)->B"]
          GALOIS_GROUP_INDEPENDENT) THEN
        ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [GALOIS_GROUP_I],
        ALL_TAC] THEN
      ABBREV_TAC (← q r"b = ring_sum l G (\f. ring_mul l (c f) ((f:B->B) x))") THEN
      SUBGOAL_THEN (← q r"(b:B) IN ring_carrier l") ASSUME_TAC THENL
       [EXPAND_TAC "b" THEN REWRITE_TAC [RING_SUM], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!g. g IN G ==> ring_mul l (c g) ((g:B->B) b) = b")
      ASSUME_TAC THENL
       [X_GEN_TAC (← q r"g:B->B") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"ring_homomorphism(l,l) (g:B->B)") ASSUME_TAC THENL
         [ASM_SIMP_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"(g:B->B) b = ring_sum l G (\f. ring_mul l (g(c f)) (g((f:B->B) x)))")
        SUBST1_TAC THENL
         [EXPAND_TAC "b" THEN
          FIRST_ASSUM (MP_TAC o ISPECL
           [← q r"\f:B->B. ring_mul l (c f) (f x)", ← q r"G:(B->B)->bool"] o
           MATCH_MP RING_HOMOMORPHISM_SUM) THEN
          ASM_SIMP_TAC [RING_MUL] THEN DISCH_THEN SUBST1_TAC THEN
          MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
          REWRITE_TAC [o_THM] THEN
          FIRST_ASSUM (fun th => tactic_of do
            pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL th])),
          ALL_TAC] THEN
        TRANS_TAC EQ_TRANS
         (← q r"ring_sum l G
            (\f. ring_mul l (c g) (ring_mul l ((g:B->B)(c f)) (g(f x))))") THEN
        CONJ_TAC THENL
         [CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_SUM_LMUL THEN
          ASM_SIMP_TAC [RING_MUL],
          ALL_TAC] THEN
        EXPAND_TAC "b" THEN
        MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"l:B ring",
                       ← q r"\f:B->B. ring_mul l (c f) (f x)", ← q r"g:B->B"]
            RING_SUM_GROUP_TRANSLATION) THEN
        ASM_REWRITE_TAC [← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP))] THEN
        DISCH_THEN (SUBST1_TAC o SYM o CONJUNCT1) THEN
        MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
        BETA_TAC THEN REWRITE_TAC [o_THM] THEN ASM_SIMP_TAC [] THEN
        MATCH_MP_TAC RING_MUL_ASSOC THEN ASM_SIMP_TAC [],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"ring_inv l b:B") THEN
      ASM_SIMP_TAC [RING_INV, FIELD_INV_EQ_0] THEN
      X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"ring_homomorphism(l,l) (f:B->B)") ASSUME_TAC THENL
       [ASM_SIMP_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"f:B->B"] FIELD_HOMOMORPHISM_INV) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => ASM_SIMP_TAC [th]) THEN
      MATCH_MP_TAC lemma THEN ASM_SIMP_TAC []))

  let HILBERT_90_ADDITIVE ← prove
   r"!(h:A->B) k l c.
        finite_extension(k,l) h /\
        (!f. f IN group_carrier(galois_group(k,l) h)
             ==> c f IN ring_carrier l) /\
        (!f g. f IN group_carrier(galois_group(k,l) h) /\
               g IN group_carrier(galois_group(k,l) h)
               ==> c(f o g) = ring_add l (c f) (f(c g)))
        ==> ?b. b IN ring_carrier l /\
                !f. f IN group_carrier(galois_group(k,l) h)
                    ==> c f = ring_sub l (f b) b"
   (← do
    let r1 ← RING_RULE
     (← q r"!r a x y:B.
          a IN ring_carrier r /\ x IN ring_carrier r /\ y IN ring_carrier r
          ==> ring_add r a y = x
              ==> a = ring_sub r (ring_neg r y) (ring_neg r x)")
    pure (REPEAT GEN_TAC THEN
    ABBREV_TAC (← q r"G = group_carrier(galois_group(k,l) (h:A->B))") THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"field(l:B ring) /\ FINITE(G:(B->B)->bool) /\
      (!f. f IN G ==> ring_homomorphism(l,l) (f:B->B)) /\
      (!f x. f IN G /\ x IN ring_carrier l ==> (f:B->B) x IN ring_carrier l)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "G" THEN
      REWRITE_TAC [GALOIS_GROUP_IN_CARRIER, GALOIS_GROUP_RING_HOMOMORPHISM] THEN
      ASM_MESON_TAC [FINITE_GALOIS_GROUP, FINITE_IMP_FIELD_EXTENSION,
                    field_extension],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] GALOIS_SUM_EQ_1_EXISTS) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:B") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"b = ring_sum l G (\f. ring_mul l (c f) ((f:B->B) t))") THEN
    SUBGOAL_THEN (← q r"(b:B) IN ring_carrier l") ASSUME_TAC THENL
     [EXPAND_TAC "b" THEN REWRITE_TAC [RING_SUM], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!g. g IN G ==> ring_add l (c g) ((g:B->B) b) = b")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"g:B->B") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"ring_homomorphism(l,l) (g:B->B)") ASSUME_TAC THENL
       [ASM_SIMP_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(g:B->B) b = ring_sum l G (\f. ring_mul l (g(c f)) (g((f:B->B) t)))")
      SUBST1_TAC THENL
       [EXPAND_TAC "b" THEN
        FIRST_ASSUM (MP_TAC o ISPECL
         [← q r"\f:B->B. ring_mul l (c f) (f t)", ← q r"G:(B->B)->bool"] o
         MATCH_MP RING_HOMOMORPHISM_SUM) THEN
        ASM_SIMP_TAC [RING_MUL] THEN DISCH_THEN SUBST1_TAC THEN
        MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
        REWRITE_TAC [o_THM] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL th])),
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"c(g:B->B) = ring_sum l G (\f. ring_mul l (c g) (g((f:B->B) t)))")
      SUBST1_TAC THENL
       [MP_TAC (← ISPECL [← q r"l:B ring", ← q r"\f:B->B. (g:B->B)(f t)", ← q r"(c:(B->B)->B) g",
                       ← q r"G:(B->B)->bool"] RING_SUM_LMUL) THEN
        ASM_SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
        MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"l:B ring",
                       ← q r"\f:B->B. f t", ← q r"g:B->B"]
          RING_SUM_GROUP_TRANSLATION) THEN
        ASM_REWRITE_TAC [← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP)), o_THM] THEN
        DISCH_THEN (SUBST1_TAC o CONJUNCT1) THEN ASM_SIMP_TAC [RING_MUL_RID],
        ALL_TAC] THEN
      wPart lhand (fun t => do rand (← rand t)) RING_SUM_ADD THEN
      ANTS_TAC THENL [ASM_SIMP_TAC [RING_MUL], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      EXPAND_TAC "b" THEN
      MP_TAC (← ISPECL [← q r"galois_group(k,l) (h:A->B)", ← q r"l:B ring",
                     ← q r"\f:B->B. ring_mul l (c f) (f t)", ← q r"g:B->B"]
          RING_SUM_GROUP_TRANSLATION) THEN
      ASM_REWRITE_TAC [← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP))] THEN
      DISCH_THEN (SUBST1_TAC o SYM o CONJUNCT1) THEN
      MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      BETA_TAC THEN REWRITE_TAC [o_THM] THEN ASM_SIMP_TAC [] THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_ADD_RDISTRIB THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"ring_neg l b:B") THEN ASM_SIMP_TAC [RING_NEG] THEN
    X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(l,l) (f:B->B)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_NEG th])) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:B->B")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC r1 THEN
    ASM_SIMP_TAC []))

  -- @@RETURN BEGIN
  return { RING_SUM_GROUP_TRANSLATION, RING_PRODUCT_GROUP_TRANSLATION,
           RING_SUM_CYCLIC_GROUP, RING_PRODUCT_CYCLIC_GROUP,
           GALOIS_PRODUCT_IN_FIXED_FIELD, GALOIS_PRODUCT_IN_BASE,
           GALOIS_PRODUCT_CONJUGATE, GALOIS_PRODUCT_MUL, GALOIS_SUM_ADD,
           GALOIS_PRODUCT_EQ_0, GALOIS_PRODUCT_BASE, ALGEBRA_TRACE_NORM_GALOIS,
           ALGEBRA_TRACE_NORM_FINITE_FIELD, GALOIS_GROUP_INDEPENDENT,
           GALOIS_SUM_EQ_1_EXISTS, HILBERT_90, HILBERT_90_ADDITIVE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Hilbert 90, continued: the cyclic forms. For the Galois group generated   -/
/- by g, with n elements, the partial products p(m) = x * g(x) * ... *       -/
/- g^(m-1)(x) satisfy p(i + j) = p(i) * g^i(p(j)); when the product of x     -/
/- over the group is 1, p(n) = 1 and p is periodic, so c(g^m) = p(m) is a    -/
/- well-defined cocycle with c(g) = x, and HILBERT_90 gives x = y / g(y).    -/
/- Similarly for the sums. The converse directions hold for any g in the     -/
/- group.                                                                    -/
/- ------------------------------------------------------------------------- -/

structure Hilbert90Cyclic where
  -- @@FIELDS
  HILBERT_90_CYCLIC : thm
  HILBERT_90_ADDITIVE_CYCLIC : thm
  HILBERT_90_CYCLIC_EQ : thm
  HILBERT_90_ADDITIVE_CYCLIC_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupHilbert90Cyclic [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BHilbert90 : Hilbert90) :
    ExceptT String IO Hilbert90Cyclic := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, FIELD_TAC, INDUCT_TAC, RING_RULE, .. } := D
  let { ADD_CLAUSES, ETA_AX, FIELD_HOMOMORPHISM_INV, FIELD_IMP_INTEGRAL_DOMAIN,
        FIELD_INV_EQ_0, FIELD_MUL_LINV, FIELD_NONTRIVIAL, FINITE_CYCLIC_GROUP_POWERS,
        FINITE_IMP_FIELD_EXTENSION, FINITE_NUMSEG_LT, FORALL_IN_IMAGE, FUN_EQ_THM,
        GROUP_POW, GROUP_POW_0, GROUP_POW_1, .. } := D.core1
  let { GROUP_POW_ADD, GROUP_POW_PERIODIC, IMP_CONJ, INTEGRAL_DOMAIN_PRODUCT_EQ_0,
        IN_ELIM_THM, I_THM, LT_REFL, NUMSEG_CLAUSES_LT, ONE, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RING_ADD_AC, RING_ADD_RZERO, RING_HOMOMORPHISM_0,
        RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_MUL,
        RING_HOMOMORPHISM_NEG, RING_INV, RING_MONOMORPHISM_EQ_0,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL_AC, RING_MUL_ASSOC, RING_MUL_RID,
        RING_NEG, RING_PRODUCT, RING_PRODUCT_CLAUSES, RING_SUB, RING_SUM,
        RING_SUM_CLAUSES, .. } := D.core3
  let { SUBGROUP_GENERATED_ELEMENT_ORDER, field_extension, o_THM, ring_div, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_IN_CARRIER, GALOIS_GROUP_RING_MONOMORPHISM, .. } := BGaloisGroup
  let { FINITE_GALOIS_GROUP, .. } := BGaloisExtensions
  let { GALOIS_PRODUCT_CONJUGATE, GALOIS_PRODUCT_EQ_0, GALOIS_PRODUCT_MUL,
        GALOIS_SUM_ADD, HILBERT_90, HILBERT_90_ADDITIVE, RING_PRODUCT_CYCLIC_GROUP,
        RING_SUM_CYCLIC_GROUP, .. } := BHilbert90
  -- @@SCOPE END

  let HILBERT_90_CYCLIC ← (do
    let lemma ← prove
     r"!f a b:A.
          field f /\ a IN ring_carrier f /\ b IN ring_carrier f /\
          ~(b = ring_0 f)
          ==> ring_div f (ring_inv f b) (ring_inv f a) = ring_div f a b"
     FIELD_TAC
    prove
     r"!(h:A->B) k l g x.
          finite_extension(k,l) h /\
          g IN group_carrier(galois_group(k,l) h) /\
          subgroup_generated (galois_group(k,l) h) {g} = galois_group(k,l) h /\
          x IN ring_carrier l /\
          ring_product l (group_carrier(galois_group(k,l) h)) (\f. f x) =
          ring_1 l
          ==> ?y. y IN ring_carrier l /\ ~(y = ring_0 l) /\
                  x = ring_div l y (g y)"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"field(l:B ring) /\ FINITE(group_carrier(galois_group(k,l) (h:A->B))) /\
        group_id(galois_group(k,l) h) = I /\ group_mul(galois_group(k,l) h) = (o) /\
        (!f. f IN group_carrier(galois_group(k,l) h)
             ==> ring_monomorphism(l,l) f) /\
        (!f x. f IN group_carrier(galois_group(k,l) h) /\ x IN ring_carrier l
               ==> f x IN ring_carrier l)")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [← CONJUNCT2 GALOIS_GROUP, GALOIS_GROUP_IN_CARRIER,
                    GALOIS_GROUP_RING_MONOMORPHISM] THEN
        ASM_MESON_TAC [FINITE_GALOIS_GROUP, FINITE_IMP_FIELD_EXTENSION,
                      field_extension],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"~(x:B = ring_0 l)") ASSUME_TAC THENL
       [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
          GALOIS_PRODUCT_EQ_0) THEN
        ASM_SIMP_TAC [FIELD_NONTRIVIAL],
        ALL_TAC] THEN
      ABBREV_TAC (← q r"G = galois_group(k,l) (h:A->B)") THEN
      MP_TAC (← ISPECL [← q r"G:(B->B)group", ← q r"g:B->B"]
        SUBGROUP_GENERATED_ELEMENT_ORDER) THEN
      ASM_REWRITE_TAC [] THEN
      ABBREV_TAC (← q r"n = CARD(group_carrier G:(B->B)->bool)") THEN
      ABBREV_TAC (← q r"e = group_pow G (g:B->B)") THEN
      DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"(!i y. y IN ring_carrier l ==> (e:num->B->B) i y IN ring_carrier l) /\
        (!i y z. y IN ring_carrier l /\ z IN ring_carrier l
                 ==> e i (ring_mul l y z) = ring_mul l (e i y) (e i z)) /\
        (!i. e i (ring_1 l) = ring_1 l) /\
        (!i y. y IN ring_carrier l ==> (e i y = ring_0 l <=> y = ring_0 l)) /\
        (!i j y. e(i + j) y = e i (e j y)) /\ (!y. e 0 y = y) /\ e 1 = g")
      STRIP_ASSUME_TAC THENL
       [SUBGOAL_THEN (← q r"!i. ring_monomorphism(l,l) ((e:num->B->B) i)") ASSUME_TAC
        THENL [EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW], ALL_TAC] THEN
        REPEAT CONJ_TAC THENL
         [EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW],
          GEN_TAC THEN FIRST_ASSUM (MATCH_ACCEPT_TAC o
            MATCH_MP RING_HOMOMORPHISM_MUL o
            MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM o SPEC (← q r"i:num")),
          GEN_TAC THEN FIRST_ASSUM (MATCH_ACCEPT_TAC o
            MATCH_MP RING_HOMOMORPHISM_1 o
            MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM o SPEC (← q r"i:num")),
          REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_MONOMORPHISM_EQ_0 THEN
          ASM_REWRITE_TAC [ETA_AX],
          EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW_ADD, o_THM],
          EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW_0, I_THM],
          EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW_1]],
        ALL_TAC] THEN
      ABBREV_TAC (← q r"p = \j. ring_product l {i | i < j} (\i. (e:num->B->B) i x)") THEN
      SUBGOAL_THEN
       (← q r"(!j. (p:num->B) j IN ring_carrier l /\ ~(p j = ring_0 l)) /\
        p 0 = ring_1 l /\ p n = ring_1 l /\
        (!j. p(SUC j) = ring_mul l ((e:num->B->B) j x) (p j))")
      STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "p" THEN
        ASM_SIMP_TAC [RING_PRODUCT, NUMSEG_CLAUSES_LT, RING_PRODUCT_CLAUSES,
                     FINITE_NUMSEG_LT, IN_ELIM_THM, LT_REFL,
                     FIELD_IMP_INTEGRAL_DOMAIN, INTEGRAL_DOMAIN_PRODUCT_EQ_0] THEN
        MP_TAC (← ISPECL [← q r"G:(B->B)group", ← q r"g:B->B", ← q r"l:B ring", ← q r"\f:B->B. f x"]
          RING_PRODUCT_CYCLIC_GROUP) THEN
        ASM_REWRITE_TAC [] THEN BETA_TAC THEN DISCH_THEN (ACCEPT_TAC o SYM),
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!i j. (p:num->B)(i + j) = ring_mul l (p i) ((e:num->B->B) i (p j))")
      ASSUME_TAC THENL
       [GEN_TAC THEN INDUCT_TAC THEN ASM_SIMP_TAC [ADD_CLAUSES, RING_MUL_RID] THEN
        MATCH_MP_TAC (← CONJUNCT2 (← CONJUNCT2 (← SPEC_ALL RING_MUL_AC))) THEN
        ASM_SIMP_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"G:(B->B)group", ← q r"g:B->B", ← q r"p:num->B"] GROUP_POW_PERIODIC) THEN
      ASM_SIMP_TAC [RING_MUL_RID] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"c:(B->B)->B")) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"c:(B->B)->B"]
        HILBERT_90) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [MP_TAC (← ISPECL [← q r"G:(B->B)group", ← q r"g:B->B"] FINITE_CYCLIC_GROUP_POWERS) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o CONJUNCT1) THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
        ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(e:num->B->B) i o e j = e(i + j)") SUBST1_TAC THENL
         [ASM_REWRITE_TAC [FUN_EQ_THM, o_THM], ASM_REWRITE_TAC []],
        ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:B") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"g:B->B")) THEN
      SUBGOAL_THEN (← q r"(c:(B->B)->B) g = x") SUBST1_TAC THENL
       [UNDISCH_TAC (← q r"(e:num->B->B) 1 = g") THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
        ASM_REWRITE_TAC [ONE] THEN ASM_SIMP_TAC [RING_MUL_RID],
        ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"ring_inv l b:B") THEN
      ASM_SIMP_TAC [RING_INV, FIELD_INV_EQ_0] THEN
      SUBGOAL_THEN (← q r"ring_homomorphism(l,l) (g:B->B)") ASSUME_TAC THENL
       [MATCH_MP_TAC RING_MONOMORPHISM_IMP_HOMOMORPHISM THEN ASM_SIMP_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"g:B->B"] FIELD_HOMOMORPHISM_INV) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => ASM_SIMP_TAC [th]) THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC lemma THEN ASM_SIMP_TAC []))

  let HILBERT_90_ADDITIVE_CYCLIC ← prove
   r"!(h:A->B) k l g x.
        finite_extension(k,l) h /\
        g IN group_carrier(galois_group(k,l) h) /\
        subgroup_generated (galois_group(k,l) h) {g} = galois_group(k,l) h /\
        x IN ring_carrier l /\
        ring_sum l (group_carrier(galois_group(k,l) h)) (\f. f x) = ring_0 l
        ==> ?y. y IN ring_carrier l /\ x = ring_sub l y (g y)"
   (← do
    let r1 ← RING_RULE
     (← q r"!r x y:B.
          x IN ring_carrier r /\ y IN ring_carrier r
          ==> ring_sub r x y = ring_sub r (ring_neg r y) (ring_neg r x)")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"field(l:B ring) /\ FINITE(group_carrier(galois_group(k,l) (h:A->B))) /\
      group_id(galois_group(k,l) h) = I /\ group_mul(galois_group(k,l) h) = (o) /\
      (!f. f IN group_carrier(galois_group(k,l) h)
           ==> ring_monomorphism(l,l) f) /\
      (!f x. f IN group_carrier(galois_group(k,l) h) /\ x IN ring_carrier l
             ==> f x IN ring_carrier l)")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← CONJUNCT2 GALOIS_GROUP, GALOIS_GROUP_IN_CARRIER,
                  GALOIS_GROUP_RING_MONOMORPHISM] THEN
      ASM_MESON_TAC [FINITE_GALOIS_GROUP, FINITE_IMP_FIELD_EXTENSION,
                    field_extension],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"G = galois_group(k,l) (h:A->B)") THEN
    MP_TAC (← ISPECL [← q r"G:(B->B)group", ← q r"g:B->B"]
      SUBGROUP_GENERATED_ELEMENT_ORDER) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"n = CARD(group_carrier G:(B->B)->bool)") THEN
    ABBREV_TAC (← q r"e = group_pow G (g:B->B)") THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"(!i y. y IN ring_carrier l ==> (e:num->B->B) i y IN ring_carrier l) /\
      (!i y z. y IN ring_carrier l /\ z IN ring_carrier l
               ==> e i (ring_add l y z) = ring_add l (e i y) (e i z)) /\
      (!i. e i (ring_0 l) = ring_0 l) /\
      (!i j y. e(i + j) y = e i (e j y)) /\ (!y. e 0 y = y) /\ e 1 = g")
    STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"!i. ring_monomorphism(l,l) ((e:num->B->B) i)") ASSUME_TAC
      THENL [EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW], ALL_TAC] THEN
      REPEAT CONJ_TAC THENL
       [EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW],
        GEN_TAC THEN FIRST_ASSUM (MATCH_ACCEPT_TAC o
          MATCH_MP RING_HOMOMORPHISM_ADD o
          MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM o SPEC (← q r"i:num")),
        GEN_TAC THEN FIRST_ASSUM (MATCH_ACCEPT_TAC o
          MATCH_MP RING_HOMOMORPHISM_0 o
          MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM o SPEC (← q r"i:num")),
        EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW_ADD, o_THM],
        EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW_0, I_THM],
        EXPAND_TAC "e" THEN ASM_SIMP_TAC [GROUP_POW_1]],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"s = \j. ring_sum l {i | i < j} (\i. (e:num->B->B) i x)") THEN
    SUBGOAL_THEN
     (← q r"(!j. (s:num->B) j IN ring_carrier l) /\ s 0 = ring_0 l /\
      s n = ring_0 l /\ (!j. s(SUC j) = ring_add l ((e:num->B->B) j x) (s j))")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "s" THEN
      ASM_SIMP_TAC [RING_SUM, NUMSEG_CLAUSES_LT, RING_SUM_CLAUSES,
                   FINITE_NUMSEG_LT, IN_ELIM_THM, LT_REFL] THEN
      MP_TAC (← ISPECL [← q r"G:(B->B)group", ← q r"g:B->B", ← q r"l:B ring", ← q r"\f:B->B. f x"]
        RING_SUM_CYCLIC_GROUP) THEN
      ASM_REWRITE_TAC [] THEN BETA_TAC THEN DISCH_THEN (ACCEPT_TAC o SYM),
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i j. (s:num->B)(i + j) = ring_add l (s i) ((e:num->B->B) i (s j))")
    ASSUME_TAC THENL
     [GEN_TAC THEN INDUCT_TAC THEN ASM_SIMP_TAC [ADD_CLAUSES, RING_ADD_RZERO] THEN
      MATCH_MP_TAC (← CONJUNCT2 (← CONJUNCT2 (← SPEC_ALL RING_ADD_AC))) THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"G:(B->B)group", ← q r"g:B->B", ← q r"s:num->B"] GROUP_POW_PERIODIC) THEN
    ASM_SIMP_TAC [RING_ADD_RZERO] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"c:(B->B)->B")) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"c:(B->B)->B"]
      HILBERT_90_ADDITIVE) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [MP_TAC (← ISPECL [← q r"G:(B->B)group", ← q r"g:B->B"] FINITE_CYCLIC_GROUP_POWERS) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o CONJUNCT1) THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
      ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(e:num->B->B) i o e j = e(i + j)") SUBST1_TAC THENL
       [ASM_REWRITE_TAC [FUN_EQ_THM, o_THM], ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:B") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"g:B->B")) THEN
    SUBGOAL_THEN (← q r"(c:(B->B)->B) g = x") SUBST1_TAC THENL
     [UNDISCH_TAC (← q r"(e:num->B->B) 1 = g") THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [ONE] THEN ASM_SIMP_TAC [RING_ADD_RZERO],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"ring_neg l b:B") THEN ASM_SIMP_TAC [RING_NEG] THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(l,l) (g:B->B)") ASSUME_TAC THENL
     [MATCH_MP_TAC RING_MONOMORPHISM_IMP_HOMOMORPHISM THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_NEG th])) THEN
    MATCH_MP_TAC r1 THEN
    ASM_SIMP_TAC []))

  let HILBERT_90_CYCLIC_EQ ← (do
    let lemma ← prove
     r"!f a b:A.
          field f /\ a IN ring_carrier f /\ b IN ring_carrier f /\
          ~(b = ring_0 f) /\ ring_mul f a b = b
          ==> a = ring_1 f"
     FIELD_TAC
    prove
     r"!(h:A->B) k l g x.
          finite_extension(k,l) h /\
          g IN group_carrier(galois_group(k,l) h) /\
          subgroup_generated (galois_group(k,l) h) {g} = galois_group(k,l) h /\
          x IN ring_carrier l
          ==> (ring_product l (group_carrier(galois_group(k,l) h)) (\f. f x) =
               ring_1 l <=>
               ?y. y IN ring_carrier l /\ ~(y = ring_0 l) /\
                   x = ring_div l y (g y))"
     (REPEAT STRIP_TAC THEN EQ_TAC THENL
       [ASM_MESON_TAC [HILBERT_90_CYCLIC], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:B") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"field(l:B ring)") ASSUME_TAC THENL
       [ASM_MESON_TAC [FINITE_IMP_FIELD_EXTENSION, field_extension], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(g:B->B) y IN ring_carrier l /\ ~(g y = ring_0 l)")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [GALOIS_GROUP_IN_CARRIER, RING_MONOMORPHISM_EQ_0,
                      GALOIS_GROUP_RING_MONOMORPHISM],
        ALL_TAC] THEN
      MATCH_MP_TAC lemma THEN
      EXISTS_TAC
       (← q r"ring_product l (group_carrier(galois_group(k,l) (h:A->B))) (\f. f y)") THEN
      ASM_SIMP_TAC [RING_PRODUCT, GALOIS_PRODUCT_EQ_0] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B", ← q r"(g:B->B) y"]
        GALOIS_PRODUCT_MUL) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"y:B"]
        GALOIS_PRODUCT_CONJUGATE) THEN
      ASM_SIMP_TAC [] THEN DISCH_THEN (SUBST1_TAC o CONJUNCT1) THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [ring_div, ← GSYM RING_MUL_ASSOC, RING_INV, FIELD_MUL_LINV,
                   RING_MUL_RID]))

  let HILBERT_90_ADDITIVE_CYCLIC_EQ ← prove
   r"!(h:A->B) k l g x.
        finite_extension(k,l) h /\
        g IN group_carrier(galois_group(k,l) h) /\
        subgroup_generated (galois_group(k,l) h) {g} = galois_group(k,l) h /\
        x IN ring_carrier l
        ==> (ring_sum l (group_carrier(galois_group(k,l) h)) (\f. f x) =
             ring_0 l <=>
             ?y. y IN ring_carrier l /\ x = ring_sub l y (g y))"
   (← do
    -- right to left: the second RING_RULE, then the first
    let r2 ← RING_RULE
     (← q r"!r a b:B. a IN ring_carrier r /\ b IN ring_carrier r
                ==> b = ring_add r a b ==> a = ring_0 r")
    let r1 ← RING_RULE
     (← q r"!r a b:B. a IN ring_carrier r /\ b IN ring_carrier r
                ==> ring_add r (ring_sub r a b) b = a")
    pure (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [HILBERT_90_ADDITIVE_CYCLIC], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:B")
     (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC)) THEN
    SUBGOAL_THEN (← q r"(g:B->B) y IN ring_carrier l") ASSUME_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_IN_CARRIER], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"ring_sub l y ((g:B->B) y)",
                   ← q r"(g:B->B) y"] GALOIS_SUM_ADD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"y:B"]
      GALOIS_PRODUCT_CONJUGATE) THEN
    ASM_SIMP_TAC [RING_SUB, r1] THEN
    DISCH_THEN (SUBST1_TAC o CONJUNCT2) THEN
    MATCH_MP_TAC r2 THEN
    REWRITE_TAC [RING_SUM]))

  -- @@RETURN BEGIN
  return { HILBERT_90_CYCLIC, HILBERT_90_ADDITIVE_CYCLIC, HILBERT_90_CYCLIC_EQ,
           HILBERT_90_ADDITIVE_CYCLIC_EQ }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Radical extensions. The extension (k,l) h is radical when l is generated  -/
/- over the image of k by finitely many elements a(0), ..., a(n-1) such that -/
/- a positive power of each a(i) lies in the subfield generated by the image -/
/- of k and the earlier a(j). Radical extensions are finite. They are closed -/
/- under towers and homomorphic images, a radical extension is radical over  -/
/- each intermediate field, and inside a field the compositum of finitely    -/
/- many radical subextensions is radical.                                    -/
/- ------------------------------------------------------------------------- -/

structure RadicalExtensions where
  -- @@FIELDS
  radical_extension : thm
  RADICAL_IMP_FIELD_EXTENSION : thm
  RADICAL_EXTENSION_EQ : thm
  RADICAL_EXTENSION_ISOMORPHISM : thm
  RADICAL_EXTENSION_REFL : thm
  RADICAL_EXTENSION_IMP_FINITE : thm
  RADICAL_EXTENSION_SIMPLE : thm
  RADICAL_GENERATORS_APPEND : thm
  deriving Inhabited

@[nospecialize]
def setupRadicalExtensions [HolBase] (D : GaloisDeps) :
    ExceptT String IO RadicalExtensions := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_RULE, new_definition, .. } := D
  let { ADD_SUB2, ALGEBRAIC_OVER_POW_EQ, ALGEBRAIC_OVER_SUBFIELD_GENERATED_ALGEBRAIC,
        EMPTY_GSPEC, EXTENSION, FIELD_EXTENSION_EQ, FIELD_EXTENSION_IMP_SUBSET,
        FIELD_EXTENSION_ISOMORPHISM, FIELD_EXTENSION_REFL,
        FINITE_EQ_FINITELY_GENERATED_ALGEBRAIC_EXTENSION, FINITE_IMAGE,
        FINITE_NUMSEG_LT, FORALL_IN_IMAGE, FORALL_UNWIND_THM2, .. } := D.core1
  let { IMAGE_CLAUSES, IN_ELIM_THM, IN_IMAGE, IN_UNION, LE_EXISTS, LT, LT_IMP_LE,
        LT_TRANS, NOT_LT, .. } := D.core2
  let { RING_ISOMORPHISM, RING_ISOMORPHISM_I, .. } := D.core3
  let { SING_GSPEC, SUBFIELD_GENERATED_INC, SUBFIELD_GENERATED_MONO,
        SUBFIELD_GENERATED_RING_CARRIER, SUBFIELD_GENERATED_UNION_LEFT, SUBSET,
        SUBSET_REFL, SUBSET_TRANS, UNION_ASSOC, UNION_EMPTY, algebraic_extension,
        finitely_generated_extension, num_WF, .. } := D.core4
  -- @@SCOPE END

  let radical_extension ← new_definition
   r"radical_extension (k:A ring,l:B ring) (h:A->B) <=>
        field_extension (k,l) h /\
        ?n (a:num->B) (m:num->num).
          (!i. i < n
               ==> ~(m i = 0) /\ a i IN ring_carrier l /\
                   ring_pow l (a i) (m i) IN
                   ring_carrier(subfield_generated l
                     (IMAGE h (ring_carrier k) UNION IMAGE a {j | j < i}))) /\
          subfield_generated l
            (IMAGE h (ring_carrier k) UNION IMAGE a {i | i < n}) = l"

  let RADICAL_IMP_FIELD_EXTENSION ← prove
   r"!(h:A->B) k l. radical_extension(k,l) h ==> field_extension(k,l) h"
   (SIMP_TAC [radical_extension])

  let RADICAL_EXTENSION_EQ ← prove
   r"!(f:A->B) f' k l.
        radical_extension(k,l) f /\
        (!x. x IN ring_carrier k ==> f' x = f x)
        ==> radical_extension(k,l) f'"
   (← do
    let s1 ← SET_RULE
     (← q r"(!x:A. x IN s ==> (f':A->B) x = f x) ==> IMAGE f' s = IMAGE f s")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [radical_extension] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)
      ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"IMAGE (f':A->B) (ring_carrier k) = IMAGE f (ring_carrier k)")
    SUBST1_TAC THENL
     [MATCH_MP_TAC s1 THEN
      ASM_REWRITE_TAC [],
      DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC FIELD_EXTENSION_EQ THEN EXISTS_TAC (← q r"f:A->B") THEN
      ASM_REWRITE_TAC []]))

  let RADICAL_EXTENSION_ISOMORPHISM ← prove
   r"!(f:A->B) k l.
        (field k \/ field l) /\ ring_isomorphism (k,l) f
        ==> radical_extension (k,l) f"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_ISOMORPHISM) THEN
    ASM_REWRITE_TAC [radical_extension] THEN
    MAP_EVERY EXISTS_TAC [← q r"0", ← q r"(\i. ring_0 l):num->B", ← q r"(\i. 1):num->num"] THEN
    REWRITE_TAC [LT, EMPTY_GSPEC, IMAGE_CLAUSES, UNION_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o CONJUNCT2) THEN
    SIMP_TAC [RING_ISOMORPHISM, SUBFIELD_GENERATED_RING_CARRIER])

  let RADICAL_EXTENSION_REFL ← prove
   r"!k:A ring. radical_extension(k,k) I <=> field k"
   (GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [RADICAL_IMP_FIELD_EXTENSION, FIELD_EXTENSION_REFL],
      DISCH_TAC THEN MATCH_MP_TAC RADICAL_EXTENSION_ISOMORPHISM THEN
      ASM_REWRITE_TAC [RING_ISOMORPHISM_I]])

  let RADICAL_EXTENSION_IMP_FINITE ← prove
   r"!(h:A->B) k l. radical_extension(k,l) h ==> finite_extension(k,l) h"
   (REPEAT GEN_TAC THEN REWRITE_TAC [radical_extension] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"n:num") (X_CHOOSE_THEN (← q r"a:num->B")
       (X_CHOOSE_THEN (← q r"m:num->num") STRIP_ASSUME_TAC)))) THEN
    REWRITE_TAC [FINITE_EQ_FINITELY_GENERATED_ALGEBRAIC_EXTENSION] THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [finitely_generated_extension] THEN
      EXISTS_TAC (← q r"IMAGE (a:num->B) {i | i < n}") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!i. i < n ==> algebraic_over(k,l) (h:A->B) ((a:num->B) i)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q r"i:num") THEN REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"(a:num->B) i",
                     ← q r"(m:num->num) i"] ALGEBRAIC_OVER_POW_EQ) THEN
      ANTS_TAC THENL [ASM_SIMP_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                     ← q r"IMAGE (a:num->B) {j | j < i}"]
        ALGEBRAIC_OVER_SUBFIELD_GENERATED_ALGEBRAIC) THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [LT_TRANS], DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC []],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [algebraic_extension] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"IMAGE (a:num->B) {i | i < n}"]
      ALGEBRAIC_OVER_SUBFIELD_GENERATED_ALGEBRAIC) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM])

  let RADICAL_EXTENSION_SIMPLE ← prove
   r"!(h:A->B) k l a n.
     field_extension(k,l) h /\ a IN ring_carrier l /\ ~(n = 0) /\
     ring_pow l a n IN IMAGE h (ring_carrier k) /\
     subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l
     ==> radical_extension(k,l) h"
   (← do
    -- right to left: the SET_RULE, then the ARITH_RULE
    let s1 ← SET_RULE (← q r"s UNION {a:B} = a INSERT s")
    let a1 ← ARITH_RULE (← q r"i < 1 <=> i = 0")
    pure (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [radical_extension] THEN
    MAP_EVERY EXISTS_TAC [← q r"1", ← q r"(\i. a):num->B", ← q r"(\i. n):num->num"] THEN
    REWRITE_TAC [a1, SING_GSPEC, FORALL_UNWIND_THM2,
                LT, EMPTY_GSPEC, IMAGE_CLAUSES, UNION_EMPTY] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUBFIELD_GENERATED_INC THEN
      ASM_SIMP_TAC [FIELD_EXTENSION_IMP_SUBSET],
      ASM_REWRITE_TAC [s1]]))

  /- Two sequences of radical generators can be concatenated when the base set -/
  /- of the second lies in the subfield generated by the first.                -/

  let RADICAL_GENERATORS_APPEND ← prove
   r"!(l:B ring) s t n (p:num) (a:num->B) b (m:num->num) m'.
        (!i. i < n
             ==> ~(m i = 0) /\ a i IN ring_carrier l /\
                 ring_pow l (a i) (m i) IN
                 ring_carrier(subfield_generated l
                   (s UNION IMAGE a {j | j < i}))) /\
        (!i. i < p
             ==> ~(m' i = 0) /\ b i IN ring_carrier l /\
                 ring_pow l (b i) (m' i) IN
                 ring_carrier(subfield_generated l
                   (t UNION IMAGE b {j | j < i}))) /\
        t SUBSET
        ring_carrier(subfield_generated l (s UNION IMAGE a {j | j < n}))
        ==> ?q c m''.
              (!i. i < q:num
                   ==> ~(m'' i = 0) /\ c i IN ring_carrier l /\
                       ring_pow l (c i) (m'' i) IN
                       ring_carrier(subfield_generated l
                         (s UNION IMAGE c {j | j < i}))) /\
              IMAGE c {i | i < q} =
              IMAGE a {i | i < n} UNION IMAGE b {i | i < p}"
   (← do
    -- right to left: the rules in reverse order of appearance
    let s3 ← SET_RULE
     (← q r"t SUBSET u ==> t UNION v SUBSET u UNION v:B->bool")
    let s2 ← SET_RULE
     (← q r"(y:B) IN s0 ==> s0 SUBSET t0 ==> y IN t0")
    let a1 ← ARITH_RULE (← q r"~(n + j < n:num)")
    let s1 ← SET_RULE
     (← q r"(!x:num. x IN s ==> (f:num->B) x = g x) ==> IMAGE f s = IMAGE g s")
    pure (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "a")
     (CONJUNCTS_THEN2 (LABEL_TAC "b") ASSUME_TAC)) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"n + p:num", ← q r"\i. if i < n then (a:num->B) i else b(i - n)",
      ← q r"\i. if i < n then (m:num->num) i else m'(i - n)"] THEN
    SUBGOAL_THEN
     (← q r"!i. i <= n
          ==> IMAGE (\i. if i < n then (a:num->B) i else b(i - n)) {j | j < i} =
              IMAGE a {j | j < i}")
    (LABEL_TAC "lo") THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC s1 THEN
      REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
      COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i. IMAGE (\i. if i < n then (a:num->B) i else b(i - n)) {j | j < n + i} =
          IMAGE a {j | j < n} UNION IMAGE b {j | j < i}")
    (LABEL_TAC "hi") THENL
     [GEN_TAC THEN REWRITE_TAC [EXTENSION, IN_UNION, IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"y:B") THEN EQ_TAC THENL
       [DISCH_THEN (X_CHOOSE_THEN (← q r"j:num")
         (CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC)) THEN
        COND_CASES_TAC THENL
         [DISJ1_TAC THEN EXISTS_TAC (← q r"j:num") THEN ASM_REWRITE_TAC [],
          DISJ2_TAC THEN EXISTS_TAC (← q r"j - n:num") THEN REWRITE_TAC [] THEN
          ASM_ARITH_TAC],
        DISCH_THEN (DISJ_CASES_THEN (X_CHOOSE_THEN (← q r"j:num")
          (CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC))) THENL
         [EXISTS_TAC (← q r"j:num") THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
          EXISTS_TAC (← q r"n + j:num") THEN
          REWRITE_TAC [a1, ADD_SUB2] THEN
          ASM_ARITH_TAC]],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"i < n:num") THEN ASM_REWRITE_TAC [] THENL
     [REMOVE_THEN "lo" (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP th
          (← MATCH_MP LT_IMP_LE (← ASSUME (← q r"i < n:num")))])) THEN
      REMOVE_THEN "a" (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"~(i < n:num)"
      if !(concl th == c) then throw "check"
      pure (X_CHOOSE_THEN (← q r"d:num") SUBST_ALL_TAC
        (← REWRITE_RULE [NOT_LT, LE_EXISTS] th))) THEN
    ASM_REWRITE_TAC [ADD_SUB2] THEN
    REMOVE_THEN "b" (MP_TAC o SPEC (← q r"d:num")) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s2) THEN
    MATCH_MP_TAC SUBSET_TRANS THEN
    EXISTS_TAC (← q r"ring_carrier(subfield_generated l
       (ring_carrier(subfield_generated l (s UNION IMAGE (a:num->B) {j | j < n}))
        UNION IMAGE (b:num->B) {j | j < d}))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN
      MATCH_MP_TAC s3 THEN
      FIRST_ASSUM ACCEPT_TAC,
      REWRITE_TAC [SUBFIELD_GENERATED_UNION_LEFT, UNION_ASSOC, SUBSET_REFL]]))

  -- @@RETURN BEGIN
  return { radical_extension, RADICAL_IMP_FIELD_EXTENSION, RADICAL_EXTENSION_EQ,
           RADICAL_EXTENSION_ISOMORPHISM, RADICAL_EXTENSION_REFL,
           RADICAL_EXTENSION_IMP_FINITE, RADICAL_EXTENSION_SIMPLE,
           RADICAL_GENERATORS_APPEND }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Radical extensions, continued: towers, intermediate fields, homomorphic   -/
/- images, and composita of radical subextensions.                           -/
/- ------------------------------------------------------------------------- -/

structure RadicalExtensions2 where
  -- @@FIELDS
  RADICAL_EXTENSION_TRANS : thm
  RADICAL_EXTENSION_INTERMEDIATE : thm
  RADICAL_EXTENSION_HOMOMORPHIC_IMAGE : thm
  RADICAL_EXTENSION_HOMOMORPHIC_IMAGE_GEN : thm
  RADICAL_EXTENSION_BASE : thm
  RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED : thm
  RADICAL_EXTENSION_COMPOSITUM : thm
  RADICAL_EXTENSION_UNIONS : thm
  deriving Inhabited

@[nospecialize]
def setupRadicalExtensions2 [HolBase] (D : GaloisDeps) (BRadicalExtensions : RadicalExtensions) :
    ExceptT String IO RadicalExtensions2 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, CARRIER_SUBFIELD_OF,
        FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_IMP_SUBSET,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_EXTENSION_SUBFIELD_GENERATED,
        FIELD_EXTENSION_TRANS, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FIELD_SUBFIELD_GENERATED,
        FINITE_INDUCT_STRONG, FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_IN_IMAGE, .. } := D.core1
  let { IMAGE_SUBSET, IMAGE_UNION, IMAGE_o, IMP_CONJ, IN_ELIM_THM, IN_IMAGE, IN_UNION,
        I_O_ID, LE_REFL, LT_IMP_LE, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_POW,
        RING_ISOMORPHISM, RING_MONOMORPHISM_IMP_HOMOMORPHISM,
        RING_POW_SUBFIELD_GENERATED, .. } := D.core3
  let { SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE,
        SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, SUBFIELD_GENERATED_IDEMPOT_GEN,
        SUBFIELD_GENERATED_INC_GEN, SUBFIELD_GENERATED_MONO,
        SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET, SUBFIELD_GENERATED_SUPERSET,
        SUBFIELD_GENERATED_UNION, SUBFIELD_GENERATED_UNION_LEFT,
        SUBFIELD_GENERATED_UNION_RIGHT, SUBFIELD_OF_IMP_SUBSET,
        SUBFIELD_OF_MONOMORPHIC_IMAGE, SUBFIELD_SUBFIELD_GENERATED, SUBSET,
        SUBSET_REFL, SUBSET_TRANS, SUBSET_UNION, UNIONS_0, UNIONS_INSERT, UNION_ASSOC,
        UNION_EMPTY, UNION_SUBSET, field_extension, o_THM, ring_monomorphism, .. } := D.core4
  let { RADICAL_EXTENSION_EQ, RADICAL_EXTENSION_ISOMORPHISM, RADICAL_EXTENSION_REFL,
        RADICAL_GENERATORS_APPEND, RADICAL_IMP_FIELD_EXTENSION, radical_extension, .. } := BRadicalExtensions
  -- @@SCOPE END

  let RADICAL_EXTENSION_TRANS ← prove
   r"!(f:A->B) (g:B->C) k l m.
     radical_extension(k,l) f /\ radical_extension(l,m) g
     ==> radical_extension(k,m) (g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [radical_extension] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"n:num") (X_CHOOSE_THEN (← q r"a:num->B")
         (X_CHOOSE_THEN (← q r"ma:num->num")
           (CONJUNCTS_THEN2 (LABEL_TAC "a") ASSUME_TAC)))))
     (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"p:num") (X_CHOOSE_THEN (← q r"b:num->C")
         (X_CHOOSE_THEN (← q r"mb:num->num")
           (CONJUNCTS_THEN2 (LABEL_TAC "b") ASSUME_TAC)))))) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [FIELD_EXTENSION_TRANS], ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"field_extension(l:B ring,m:C ring) g"
      if !(concl th == c) then throw "check"
      pure (STRIP_ASSUME_TAC (← GEN_REWRITE_RULE I [field_extension] th))) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN
     (← q r"!i. i <= n:num
          ==> ring_carrier(subfield_generated m
                (IMAGE ((g:B->C) o (f:A->B)) (ring_carrier k) UNION
                 IMAGE (g o a) {j | j < i})) =
              IMAGE g (ring_carrier(subfield_generated l
                (IMAGE f (ring_carrier k) UNION IMAGE a {j | j < i})))")
    (LABEL_TAC "im") THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [IMAGE_o, ← GSYM IMAGE_UNION] THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE THEN
      ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED, UNION_SUBSET] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [FIELD_EXTENSION_IMP_SUBSET],
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        USE_THEN "a" (MP_TAC o SPEC (← q r"j:num")) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_carrier(subfield_generated m
        (IMAGE ((g:B->C) o (f:A->B)) (ring_carrier k) UNION
         IMAGE (g o (a:num->B)) {j | j < n})) =
      IMAGE g (ring_carrier l)")
    ASSUME_TAC THENL
     [USE_THEN "im" (MP_TAC o SPEC (← q r"n:num")) THEN REWRITE_TAC [LE_REFL] THEN
      DISCH_THEN SUBST1_TAC THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"m:C ring", ← q r"IMAGE ((g:B->C) o (f:A->B)) (ring_carrier k)",
                   ← q r"IMAGE (g:B->C) (ring_carrier l)", ← q r"n:num", ← q r"p:num",
                   ← q r"(g:B->C) o (a:num->B)", ← q r"b:num->C", ← q r"ma:num->num",
                   ← q r"mb:num->num"] RADICAL_GENERATORS_APPEND) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [SUBSET_REFL] THEN X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      USE_THEN "a" (fun th => tactic_of do
        pure (STRIP_ASSUME_TAC (← MATCH_MP th (← ASSUME (← q r"i < n:num"))))) THEN
      ASM_REWRITE_TAC [o_THM] THEN CONJ_TAC THENL
       [MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
        EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"m:C ring", ← q r"g:B->C"]
        RING_HOMOMORPHISM_POW) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP th
          (← ASSUME (← q r"(a:num->B) i IN ring_carrier l")))])) THEN
      USE_THEN "im" (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP th
          (← MATCH_MP LT_IMP_LE (← ASSUME (← q r"i < n:num")))])) THEN
      MATCH_MP_TAC FUN_IN_IMAGE THEN FIRST_ASSUM ACCEPT_TAC,
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:num") (X_CHOOSE_THEN (← q r"c:num->C")
      (X_CHOOSE_THEN (← q r"mc:num->num") STRIP_ASSUME_TAC))) THEN
    MAP_EVERY EXISTS_TAC [← q r"q:num", ← q r"c:num->C", ← q r"mc:num->num"] THEN
    ASM_REWRITE_TAC [← GSYM UNION_ASSOC] THEN
    ONCE_REWRITE_TAC [← GSYM SUBFIELD_GENERATED_UNION_LEFT] THEN
    ASM_REWRITE_TAC [])

  let RADICAL_EXTENSION_INTERMEDIATE ← prove
   r"!(f:A->B) (g:B->C) k l m.
     field_extension(k,l) f /\ field_extension(l,m) g /\
     radical_extension(k,m) (g o f)
     ==> radical_extension(l,m) g"
   (← do
    -- right to left: the second SET_RULE, then the first
    let s2 ← SET_RULE
     (← q r"(y:C) IN s0 ==> s0 SUBSET t0 ==> y IN t0")
    let s1 ← SET_RULE
     (← q r"s SUBSET t ==> s UNION u SUBSET t UNION u:C->bool")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [radical_extension] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"n:num")
       (X_CHOOSE_THEN (← q r"a:num->C") (X_CHOOSE_THEN (← q r"ma:num->num")
         STRIP_ASSUME_TAC)))))) THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY EXISTS_TAC [← q r"n:num", ← q r"a:num->C", ← q r"ma:num->num"] THEN
    SUBGOAL_THEN
     (← q r"!t. IMAGE ((g:B->C) o (f:A->B)) (ring_carrier k) UNION t SUBSET
          IMAGE g (ring_carrier l) UNION t")
    ASSUME_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC s1 THEN
      REWRITE_TAC [IMAGE_o] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
      ASM_MESON_TAC [FIELD_EXTENSION_IMP_SUBSET],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"ma:num->num"
        if !(free_in c (concl th)) then throw "check"
        if !(is_forall (concl th)) then throw "check"
        pure (MP_TAC (← SPEC (← q r"i:num") th))) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s2) THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [SUBFIELD_GENERATED_SUPERSET] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"ring_carrier(subfield_generated m
        (IMAGE ((g:B->C) o (f:A->B)) (ring_carrier k) UNION
         IMAGE (a:num->C) {i | i < n}))") THEN
      CONJ_TAC THENL
       [ASM_REWRITE_TAC [SUBSET_REFL],
        MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN ASM_REWRITE_TAC []]]))

  let RADICAL_EXTENSION_HOMOMORPHIC_IMAGE ← prove
   r"!(h:A->B) (j:B->C) k l m.
     radical_extension(k,l) h /\ field m /\ ring_homomorphism(l,m) j
     ==> radical_extension
           (k,subfield_generated m (IMAGE j (ring_carrier l))) (j o h)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RADICAL_EXTENSION_TRANS THEN
    EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC RADICAL_EXTENSION_ISOMORPHISM THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP RADICAL_IMP_FIELD_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"ring_monomorphism(l:B ring,m:C ring) j") ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"IMAGE (j:B->C) (ring_carrier l) subfield_of m") ASSUME_TAC THENL
     [MATCH_MP_TAC SUBFIELD_OF_MONOMORPHIC_IMAGE THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_REWRITE_TAC [CARRIER_SUBFIELD_OF],
      ALL_TAC] THEN
    REWRITE_TAC [RING_ISOMORPHISM] THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN CONJ_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_IMP_HOMOMORPHISM THEN
      MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [field_extension, SUBSET_REFL],
      ASM_MESON_TAC [ring_monomorphism]])

  let RADICAL_EXTENSION_HOMOMORPHIC_IMAGE_GEN ← prove
   r"!(h:A->B) (g:A->C) (e:B->C) k l m.
        radical_extension(k,l) h /\ field m /\ ring_homomorphism(l,m) e /\
        (!x. x IN ring_carrier k ==> e(h x) = g x)
        ==> IMAGE e (ring_carrier l) subfield_of m /\
            radical_extension(k,subfield_generated m (IMAGE e (ring_carrier l)))
                             g"
   (REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC SUBFIELD_OF_MONOMORPHIC_IMAGE THEN
      EXISTS_TAC (← q r"l:B ring") THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
        MATCH_MP RADICAL_IMP_FIELD_EXTENSION) THEN
      ASM_REWRITE_TAC [CARRIER_SUBFIELD_OF] THEN
      MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      MATCH_MP_TAC RADICAL_EXTENSION_EQ THEN
      EXISTS_TAC (← q r"(e:B->C) o (h:A->B)") THEN
      ASM_SIMP_TAC [RADICAL_EXTENSION_HOMOMORPHIC_IMAGE, o_THM]])

  let RADICAL_EXTENSION_BASE ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h
        ==> radical_extension(k,subfield_generated l (IMAGE h (ring_carrier k)))
                             h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"I:A->A", ← q r"h:A->B", ← q r"k:A ring", ← q r"k:A ring", ← q r"l:B ring"]
      RADICAL_EXTENSION_HOMOMORPHIC_IMAGE) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    ASM_SIMP_TAC [RADICAL_EXTENSION_REFL, I_O_ID,
                 RING_MONOMORPHISM_IMP_HOMOMORPHISM])

  /- An intermediate field s of a field extension (k,l) h is radical over k    -/
  /- exactly when s is generated in l over the image of k by a sequence of     -/
  /- radical generators. Hence composita of radical subextensions of a field   -/
  /- are radical.                                                              -/

  let RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED ← prove
   r"!(h:A->B) k l s.
        field_extension(k,l) h /\ s subfield_of l
        ==> (radical_extension(k,subfield_generated l s) h <=>
             IMAGE h (ring_carrier k) SUBSET s /\
             ?n:num a m.
               (!i. i < n
                    ==> ~(m i = 0) /\ a i IN ring_carrier l /\
                        ring_pow l (a i) (m i) IN
                        ring_carrier(subfield_generated l
                          (IMAGE h (ring_carrier k) UNION
                           IMAGE a {j | j < i}))) /\
               ring_carrier(subfield_generated l
                 (IMAGE h (ring_carrier k) UNION IMAGE a {i | i < n})) = s)"
   (← do
    -- right to left: the SET_RULE, then the TAUT
    let s1 ← SET_RULE (← q r"!x:B s t. x IN s /\ s SUBSET t ==> x IN t")
    let t1 ← TAUT
     (← q r"(p <=> p') /\ (p' ==> (q <=> q')) ==> (p /\ q <=> p' /\ q')")
    pure (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [radical_extension, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
                 RING_POW_SUBFIELD_GENERATED] THEN
    MATCH_MP_TAC t1 THEN
    CONJ_TAC THENL
     [EQ_TAC THEN DISCH_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP FIELD_EXTENSION_IMP_SUBSET) THEN
        ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
        MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
        ASM_REWRITE_TAC []],
      DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n (a:num->B).
        (!i. i < n ==> a i IN s)
        ==> !i. i <= n
                ==> subfield_generated (subfield_generated l s)
                      (IMAGE (h:A->B) (ring_carrier k) UNION
                       IMAGE a {j | j < i}) =
                    subfield_generated l
                      (IMAGE h (ring_carrier k) UNION IMAGE a {j | j < i})")
    (LABEL_TAC "sg") THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBFIELD_GENERATED_IDEMPOT_GEN THEN
      ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, UNION_SUBSET] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!t. subfield_generated l t = subfield_generated l s <=>
          ring_carrier(subfield_generated l t) = (s:B->bool)")
    (LABEL_TAC "eq") THENL
     [GEN_TAC THEN EQ_TAC THENL
       [DISCH_THEN SUBST1_TAC THEN
        ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED]],
      ALL_TAC] THEN
    EQ_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (X_CHOOSE_THEN (← q r"a:num->B")
      (X_CHOOSE_THEN (← q r"m:num->num") (CONJUNCTS_THEN2 (LABEL_TAC "a")
        ASSUME_TAC)))) THEN
    MAP_EVERY EXISTS_TAC [← q r"n:num", ← q r"a:num->B", ← q r"m:num->num"] THENL
     [SUBGOAL_THEN (← q r"!i. i < n ==> (a:num->B) i IN s") ASSUME_TAC THENL
       [USE_THEN "a" (fun th => MESON_TAC [th]), ALL_TAC] THEN
      USE_THEN "sg" (MP_TAC o SPECL [← q r"n:num", ← q r"a:num->B"]) THEN
      ANTS_TAC THENL [FIRST_ASSUM ACCEPT_TAC, DISCH_THEN (LABEL_TAC "sgn")] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
        USE_THEN "a" (fun th => tactic_of do
          pure (STRIP_ASSUME_TAC (← MATCH_MP th (← ASSUME (← q r"i < n:num"))))) THEN
        USE_THEN "sgn" (fun th => tactic_of do
          pure (MP_TAC (← MATCH_MP th
            (← MATCH_MP LT_IMP_LE (← ASSUME (← q r"i < n:num")))))) THEN
        DISCH_THEN (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN
                             REWRITE_TAC [th]) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC s1 THEN
        EXISTS_TAC (← q r"s:B->bool") THEN ASM_SIMP_TAC [SUBFIELD_OF_IMP_SUBSET],
        USE_THEN "sgn" (fun th => tactic_of do
          pure (MP_TAC (← MATCH_MP th (← SPEC (← q r"n:num") LE_REFL)))) THEN
        DISCH_THEN (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th])) THEN
        REMOVE_THEN "eq" (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th])) THEN
        ASM_REWRITE_TAC []],
      SUBGOAL_THEN (← q r"!i. i < n ==> (a:num->B) i IN s") ASSUME_TAC THENL
       [X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
        FIRST_ASSUM (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN CONJ_TAC THENL
         [USE_THEN "a" (fun th => tactic_of do
            pure (MESON_TAC [th, ← ASSUME (← q r"i < n:num")])),
          REWRITE_TAC [IN_UNION, IN_IMAGE, IN_ELIM_THM] THEN DISJ2_TAC THEN
          EXISTS_TAC (← q r"i:num") THEN ASM_REWRITE_TAC []],
        ALL_TAC] THEN
      USE_THEN "sg" (MP_TAC o SPECL [← q r"n:num", ← q r"a:num->B"]) THEN
      ANTS_TAC THENL [FIRST_ASSUM ACCEPT_TAC, DISCH_THEN (LABEL_TAC "sgn")] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
        USE_THEN "a" (fun th => tactic_of do
          pure (STRIP_ASSUME_TAC (← MATCH_MP th (← ASSUME (← q r"i < n:num"))))) THEN
        USE_THEN "sgn" (fun th => tactic_of do
          pure (MP_TAC (← MATCH_MP th
            (← MATCH_MP LT_IMP_LE (← ASSUME (← q r"i < n:num")))))) THEN
        DISCH_THEN (fun th => REWRITE_TAC [th]) THEN ASM_SIMP_TAC [],
        USE_THEN "sgn" (fun th => tactic_of do
          pure (MP_TAC (← MATCH_MP th (← SPEC (← q r"n:num") LE_REFL)))) THEN
        DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
        USE_THEN "eq" (fun th => REWRITE_TAC [th]) THEN
        FIRST_ASSUM ACCEPT_TAC]]))

  let RADICAL_EXTENSION_COMPOSITUM ← prove
   r"!(h:A->B) k l s t.
     field l /\ s subfield_of l /\ t subfield_of l /\
     radical_extension(k,subfield_generated l s) h /\
     radical_extension(k,subfield_generated l t) h
     ==> radical_extension(k,subfield_generated l (s UNION t)) h"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"field_extension(k:A ring,l:B ring) h") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                     ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring"]
        FIELD_EXTENSION_TRANS) THEN
      ASM_SIMP_TAC [RADICAL_IMP_FIELD_EXTENSION,
                   FIELD_EXTENSION_SUBFIELD_GENERATED, I_O_ID],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← GSYM SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"ring_carrier(subfield_generated l (s UNION t:B->bool))"]
      RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED], DISCH_THEN SUBST1_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"t:B->bool"]
      RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"n:num")
      (X_CHOOSE_THEN (← q r"a:num->B") (X_CHOOSE_THEN (← q r"ma:num->num")
        STRIP_ASSUME_TAC)))) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"p:num")
      (X_CHOOSE_THEN (← q r"b:num->B") (X_CHOOSE_THEN (← q r"mb:num->num")
        STRIP_ASSUME_TAC)))) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"s:B->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"s UNION t:B->bool") THEN REWRITE_TAC [SUBSET_UNION] THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET THEN
      ASM_SIMP_TAC [UNION_SUBSET, SUBFIELD_OF_IMP_SUBSET],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"IMAGE (h:A->B) (ring_carrier k)",
                   ← q r"IMAGE (h:A->B) (ring_carrier k)", ← q r"n:num", ← q r"p:num",
                   ← q r"a:num->B", ← q r"b:num->B", ← q r"ma:num->num", ← q r"mb:num->num"]
      RADICAL_GENERATORS_APPEND) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:num") (X_CHOOSE_THEN (← q r"c:num->B")
      (X_CHOOSE_THEN (← q r"mc:num->num") STRIP_ASSUME_TAC))) THEN
    MAP_EVERY EXISTS_TAC [← q r"q:num", ← q r"c:num->B", ← q r"mc:num->num"] THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"t:B->bool"
      let ok := is_eq (concl th) &&
        (match rand (concl th) with | .ok u => u == c | .error _ => false)
      if !ok then throw "check"
      pure ((SUBST1_TAC o SYM) th)) THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"s:B->bool"
      let ok := is_eq (concl th) &&
        (match rand (concl th) with | .ok u => u == c | .error _ => false)
      if !ok then throw "check"
      pure ((SUBST1_TAC o SYM) th)) THEN
    REWRITE_TAC [SUBFIELD_GENERATED_UNION] THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let RADICAL_EXTENSION_UNIONS ← prove
   r"!(h:A->B) k l f.
        field_extension(k,l) h /\ FINITE f /\
        (!s. s IN f
             ==> s subfield_of l /\
                 radical_extension(k,subfield_generated l s) h)
        ==> radical_extension
              (k,subfield_generated l (IMAGE h (ring_carrier k) UNION UNIONS f))
              h"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [UNIONS_0, UNION_EMPTY, RADICAL_EXTENSION_BASE] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:B->bool", ← q r"f:(B->bool)->bool"] THEN
    REWRITE_TAC [FORALL_IN_INSERT] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ANTS_TAC THENL [FIRST_ASSUM ACCEPT_TAC, DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (h:A->B) (ring_carrier k) UNION UNIONS (s INSERT f) =
      s UNION (IMAGE h (ring_carrier k) UNION UNIONS f)")
    SUBST1_TAC THENL [REWRITE_TAC [UNIONS_INSERT] THEN SET_TAC [], ALL_TAC] THEN
    ONCE_REWRITE_TAC [← GSYM SUBFIELD_GENERATED_UNION_RIGHT] THEN
    MATCH_MP_TAC RADICAL_EXTENSION_COMPOSITUM THEN
    ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED,
                 SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED])

  -- @@RETURN BEGIN
  return { RADICAL_EXTENSION_TRANS, RADICAL_EXTENSION_INTERMEDIATE,
           RADICAL_EXTENSION_HOMOMORPHIC_IMAGE, RADICAL_EXTENSION_HOMOMORPHIC_IMAGE_GEN,
           RADICAL_EXTENSION_BASE, RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED,
           RADICAL_EXTENSION_COMPOSITUM, RADICAL_EXTENSION_UNIONS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Radical elements. An element x of l is radical over k when it lies in a   -/
/- subfield of l that is radical over k, that is, x can be expressed by      -/
/- radicals over the image of k inside l. Finitely many radical elements lie -/
/- in one radical subextension, so the radical elements form a subfield of l -/
/- containing the image of k, closed under roots and mapped to radical       -/
/- elements by homomorphisms. An extension generated by finitely many of its -/
/- radical elements is radical, and a finite extension is radical exactly    -/
/- when all of its elements are radical.                                     -/
/- ------------------------------------------------------------------------- -/

structure RadicalElements where
  -- @@FIELDS
  radical_element : thm
  RADICAL_ELEMENT_IN_CARRIER : thm
  RADICAL_ELEMENT_BASE : thm
  RADICAL_ELEMENT_NEG : thm
  RADICAL_ELEMENT_INV : thm
  RADICAL_ELEMENT_POW : thm
  RADICAL_ELEMENTS_COMMON_RADICAL_EXTENSION : thm
  RADICAL_ELEMENT_PAIR : thm
  RADICAL_ELEMENT_ADD : thm
  RADICAL_ELEMENT_SUB : thm
  RADICAL_ELEMENT_MUL : thm
  RADICAL_ELEMENT_DIV : thm
  RADICAL_ELEMENT_ROOT : thm
  SUBFIELD_OF_RADICAL_ELEMENTS : thm
  RADICAL_ELEMENT_HOMOMORPHIC_IMAGE : thm
  RADICAL_EXTENSION_GENERATED_BY_RADICAL_ELEMENTS : thm
  RADICAL_EXTENSION_EQ_RADICAL_ELEMENTS : thm
  deriving Inhabited

@[nospecialize]
def setupRadicalElements [HolBase] (D : GaloisDeps) (BRadicalExtensions : RadicalExtensions) (BRadicalExtensions2 : RadicalExtensions2) :
    ExceptT String IO RadicalElements := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, CARRIER_SUBFIELD_OF, CONJ_ASSOC,
        EMPTY_GSPEC, EMPTY_SUBSET, FIELD_EXTENSION_IMP_SUBSET, FINITE_EMPTY,
        FINITE_IMP_FINITELY_GENERATED_EXTENSION, FINITE_INDUCT_STRONG, FINITE_INSERT,
        FORALL_IN_INSERT, FORALL_UNWIND_THM2, FUN_IN_IMAGE, .. } := D.core1
  let { IMAGE_CLAUSES, IMP_CONJ, INSERT_SUBSET, IN_ELIM_THM, IN_INSERT,
        IN_SUBFIELD_ADD, IN_SUBFIELD_INV, IN_SUBFIELD_MUL, IN_SUBFIELD_NEG,
        IN_SUBFIELD_POW, IN_SUBFIELD_SUB, IN_UNION, LT, NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RING_0, RING_1, RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1,
        RING_HOMOMORPHISM_FROM_SUBFIELD_GENERATED, RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core3
  let { SING_GSPEC, SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, SUBFIELD_GENERATED_EQ,
        SUBFIELD_GENERATED_INC, SUBFIELD_GENERATED_INC_GEN, SUBFIELD_GENERATED_MINIMAL,
        SUBFIELD_GENERATED_RING_CARRIER, SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET,
        SUBFIELD_OF_FIELD_INV, SUBFIELD_OF_IMP_SUBSET, SUBFIELD_SUBFIELD_GENERATED,
        SUBSET, SUBSET_ANTISYM, SUBSET_CARRIER_SUBFIELD_GENERATED, SUBSET_REFL,
        SUBSET_UNION, UNION_EMPTY, UNION_SUBSET, field_extension,
        finitely_generated_extension, o_THM, ring_div, subring_of, .. } := D.core4
  let { RADICAL_EXTENSION_IMP_FINITE, RADICAL_GENERATORS_APPEND,
        RADICAL_IMP_FIELD_EXTENSION, .. } := BRadicalExtensions
  let { RADICAL_EXTENSION_BASE, RADICAL_EXTENSION_COMPOSITUM,
        RADICAL_EXTENSION_HOMOMORPHIC_IMAGE_GEN,
        RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED, .. } := BRadicalExtensions2
  -- @@SCOPE END

  /- The radical tower must lie inside the specified ambient field l. For     -/
  /- solvability by radicals with auxiliary roots in a larger field, use an    -/
  /- algebraically closed ambient field, as in GALOIS_SOLVABLE_EQ_RADICAL.      -/
  let radical_element ← new_definition
   r"radical_element (k:A ring,l:B ring) (h:A->B) x <=>
        ?s. s subfield_of l /\ x IN s /\
            radical_extension (k,subfield_generated l s) h"

  let RADICAL_ELEMENT_IN_CARRIER ← prove
   r"!(h:A->B) k l x. radical_element(k,l) h x ==> x IN ring_carrier l"
   (REWRITE_TAC [radical_element] THEN
    MESON_TAC [SUBFIELD_OF_IMP_SUBSET, SUBSET])

  let RADICAL_ELEMENT_BASE ← prove
   r"!(h:A->B) k l x.
     field_extension(k,l) h /\ x IN ring_carrier k
     ==> radical_element(k,l) h (h x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [radical_element] THEN
    EXISTS_TAC
     (← q r"ring_carrier(subfield_generated l (IMAGE (h:A->B) (ring_carrier k)))") THEN
    ASM_SIMP_TAC [SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED,
                 RADICAL_EXTENSION_BASE] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUBFIELD_SUBFIELD_GENERATED THEN
      ASM_MESON_TAC [field_extension],
      MATCH_MP_TAC SUBFIELD_GENERATED_INC THEN
      ASM_SIMP_TAC [FIELD_EXTENSION_IMP_SUBSET, FUN_IN_IMAGE]])

  let RADICAL_ELEMENT_NEG ← prove
   r"!(h:A->B) k l x.
     radical_element(k,l) h x ==> radical_element(k,l) h (ring_neg l x)"
   (REWRITE_TAC [radical_element] THEN MESON_TAC [IN_SUBFIELD_NEG])

  let RADICAL_ELEMENT_INV ← prove
   r"!(h:A->B) k l x.
     radical_element(k,l) h x ==> radical_element(k,l) h (ring_inv l x)"
   (REWRITE_TAC [radical_element] THEN MESON_TAC [IN_SUBFIELD_INV])

  let RADICAL_ELEMENT_POW ← prove
   r"!(h:A->B) k l x n.
     radical_element(k,l) h x ==> radical_element(k,l) h (ring_pow l x n)"
   (REWRITE_TAC [radical_element] THEN MESON_TAC [IN_SUBFIELD_POW])

  let RADICAL_ELEMENTS_COMMON_RADICAL_EXTENSION ← prove
   r"!(h:A->B) k l b.
        field_extension(k,l) h /\ FINITE b /\
        (!x. x IN b ==> radical_element(k,l) h x)
        ==> ?s. s subfield_of l /\ b SUBSET s /\
                radical_extension(k,subfield_generated l s) h"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
     [DISCH_THEN (K ALL_TAC : thm → tactic) THEN EXISTS_TAC
       (← q r"ring_carrier(subfield_generated l (IMAGE (h:A->B) (ring_carrier k)))") THEN
      ASM_SIMP_TAC [SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, EMPTY_SUBSET,
                   RADICAL_EXTENSION_BASE, SUBFIELD_SUBFIELD_GENERATED],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"b:B->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [FORALL_IN_INSERT, INSERT_SUBSET] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ANTS_TAC THENL [FIRST_ASSUM ACCEPT_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:B->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"v:B->bool") STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE I [radical_element]) THEN
    EXISTS_TAC (← q r"ring_carrier(subfield_generated l (v UNION u:B->bool))") THEN
    SUBGOAL_THEN
     (← q r"(v UNION u:B->bool) SUBSET ring_carrier(subfield_generated l (v UNION u))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET THEN
      ASM_SIMP_TAC [UNION_SUBSET, SUBFIELD_OF_IMP_SUBSET],
      ALL_TAC] THEN
    ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED,
                 SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED,
                 RADICAL_EXTENSION_COMPOSITUM] THEN
    ASM SET_TAC [])

  let RADICAL_ELEMENT_PAIR ← prove
   r"!(h:A->B) k l x y.
     field_extension(k,l) h /\
     radical_element(k,l) h x /\ radical_element(k,l) h y
     ==> ?s. s subfield_of l /\ x IN s /\ y IN s /\
             radical_extension(k,subfield_generated l s) h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"{x:B,y}"]
      RADICAL_ELEMENTS_COMMON_RADICAL_EXTENSION) THEN
    ASM_REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY, FORALL_IN_INSERT,
                    NOT_IN_EMPTY, INSERT_SUBSET, EMPTY_SUBSET, ← GSYM CONJ_ASSOC])

  let RADICAL_ELEMENT_ADD ← prove
   r"!(h:A->B) k l x y.
     field_extension(k,l) h /\
     radical_element(k,l) h x /\ radical_element(k,l) h y
     ==> radical_element(k,l) h (ring_add l x y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP RADICAL_ELEMENT_PAIR) THEN
    REWRITE_TAC [radical_element] THEN MESON_TAC [IN_SUBFIELD_ADD])

  let RADICAL_ELEMENT_SUB ← prove
   r"!(h:A->B) k l x y.
     field_extension(k,l) h /\
     radical_element(k,l) h x /\ radical_element(k,l) h y
     ==> radical_element(k,l) h (ring_sub l x y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP RADICAL_ELEMENT_PAIR) THEN
    REWRITE_TAC [radical_element] THEN MESON_TAC [IN_SUBFIELD_SUB])

  let RADICAL_ELEMENT_MUL ← prove
   r"!(h:A->B) k l x y.
     field_extension(k,l) h /\
     radical_element(k,l) h x /\ radical_element(k,l) h y
     ==> radical_element(k,l) h (ring_mul l x y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP RADICAL_ELEMENT_PAIR) THEN
    REWRITE_TAC [radical_element] THEN MESON_TAC [IN_SUBFIELD_MUL])

  let RADICAL_ELEMENT_DIV ← prove
   r"!(h:A->B) k l x y.
     field_extension(k,l) h /\
     radical_element(k,l) h x /\ radical_element(k,l) h y
     ==> radical_element(k,l) h (ring_div l x y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP RADICAL_ELEMENT_PAIR) THEN
    REWRITE_TAC [radical_element, ring_div] THEN
    MESON_TAC [IN_SUBFIELD_MUL, IN_SUBFIELD_INV])

  let RADICAL_ELEMENT_ROOT ← prove
   r"!(h:A->B) k l x n.
     field_extension(k,l) h /\ x IN ring_carrier l /\ ~(n = 0) /\
     radical_element(k,l) h (ring_pow l x n)
     ==> radical_element(k,l) h x"
   (← do
    -- right to left: the second ARITH_RULE, then the first
    let a2 ← ARITH_RULE (← q r"i < 1 <=> i = 0")
    let a1 ← ARITH_RULE (← q r"i < 1 <=> i = 0")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [radical_element] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"s:B->bool")
       STRIP_ASSUME_TAC)))) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"p:num")
      (X_CHOOSE_THEN (← q r"a:num->B") (X_CHOOSE_THEN (← q r"ma:num->num")
        STRIP_ASSUME_TAC)))) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"IMAGE (h:A->B) (ring_carrier k)",
                   ← q r"s:B->bool", ← q r"p:num", ← q r"1", ← q r"a:num->B", ← q r"(\i. x):num->B",
                   ← q r"ma:num->num", ← q r"(\i. n):num->num"]
      RADICAL_GENERATORS_APPEND) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [SUBSET_REFL, a1,
                   FORALL_UNWIND_THM2, LT, EMPTY_GSPEC, IMAGE_CLAUSES,
                   UNION_EMPTY, CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    REWRITE_TAC [a2, SING_GSPEC, IMAGE_CLAUSES] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:num") (X_CHOOSE_THEN (← q r"c:num->B")
      (X_CHOOSE_THEN (← q r"mc:num->num") STRIP_ASSUME_TAC))) THEN
    EXISTS_TAC (← q r"ring_carrier(subfield_generated l
      (IMAGE (h:A->B) (ring_carrier k) UNION IMAGE c {i | i < q:num}))") THEN
    REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED],
      MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
      ASM_REWRITE_TAC [IN_UNION, IN_INSERT],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
       ← q r"ring_carrier(subfield_generated l
         (IMAGE (h:A->B) (ring_carrier k) UNION IMAGE c {i | i < q:num}))"]
      RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED], DISCH_THEN SUBST1_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUBSET_CARRIER_SUBFIELD_GENERATED THEN
      ASM_SIMP_TAC [SUBSET_UNION, FIELD_EXTENSION_IMP_SUBSET],
      MAP_EVERY EXISTS_TAC [← q r"q:num", ← q r"c:num->B", ← q r"mc:num->num"] THEN
      ASM_REWRITE_TAC []]))

  let SUBFIELD_OF_RADICAL_ELEMENTS ← prove
   r"!(h:A->B) k l.
     field_extension(k,l) h
     ==> {x | radical_element(k,l) h x} subfield_of l"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBFIELD_OF_FIELD_INV THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    ASM_REWRITE_TAC [subring_of, IN_ELIM_THM, SUBSET] THEN
    ASM_SIMP_TAC [RADICAL_ELEMENT_ADD, RADICAL_ELEMENT_MUL,
                 RADICAL_ELEMENT_NEG, RADICAL_ELEMENT_INV] THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [RADICAL_ELEMENT_IN_CARRIER],
      SUBST1_TAC (← SYM (← MATCH_MP RING_HOMOMORPHISM_0
        (← ASSUME (← q r"ring_homomorphism(k:A ring,l:B ring) h")))),
      SUBST1_TAC (← SYM (← MATCH_MP RING_HOMOMORPHISM_1
        (← ASSUME (← q r"ring_homomorphism(k:A ring,l:B ring) h"))))] THEN
    MATCH_MP_TAC RADICAL_ELEMENT_BASE THEN ASM_REWRITE_TAC [RING_0, RING_1])

  let RADICAL_ELEMENT_HOMOMORPHIC_IMAGE ← prove
   r"!(h:A->B) (j:B->C) k l m x.
     field m /\ ring_homomorphism(l,m) j /\ radical_element(k,l) h x
     ==> radical_element(k,m) (j o h) (j x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [radical_element] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"s:B->bool") STRIP_ASSUME_TAC))) THEN
    EXISTS_TAC (← q r"IMAGE (j:B->C) s") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->C) o (h:A->B)", ← q r"j:B->C", ← q r"k:A ring",
                   ← q r"subfield_generated l (s:B->bool)", ← q r"m:C ring"]
      RADICAL_EXTENSION_HOMOMORPHIC_IMAGE_GEN) THEN
    ASM_SIMP_TAC [RING_HOMOMORPHISM_FROM_SUBFIELD_GENERATED, o_THM,
                 CARRIER_SUBFIELD_GENERATED_SUBFIELD, FUN_IN_IMAGE])

  let RADICAL_EXTENSION_GENERATED_BY_RADICAL_ELEMENTS ← prove
   r"!(h:A->B) k l s.
        field_extension(k,l) h /\ FINITE s /\
        (!x. x IN s ==> radical_element(k,l) h x) /\
        subfield_generated l (IMAGE h (ring_carrier k) UNION s) = l
        ==> radical_extension(k,l) h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      RADICAL_ELEMENTS_COMMON_RADICAL_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:B->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"subfield_generated l (t:B->bool) = l")
     (fun th => tactic_of do pure (SUBST1_TAC (← SYM th) THEN ASM_REWRITE_TAC [])) THEN
    ASM_SIMP_TAC [SUBFIELD_GENERATED_EQ, CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN ASM_SIMP_TAC [SUBFIELD_OF_IMP_SUBSET] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"l:B ring"
      let ok := is_eq (concl th) &&
        (match rand (concl th) with | .ok u => u == c | .error _ => false)
      if !ok then throw "check"
      pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← SYM th])) THEN
    MATCH_MP_TAC SUBFIELD_GENERATED_MINIMAL THEN
    ASM_REWRITE_TAC [UNION_SUBSET] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FIELD_EXTENSION_IMP_SUBSET o
      MATCH_MP RADICAL_IMP_FIELD_EXTENSION) THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD])

  let RADICAL_EXTENSION_EQ_RADICAL_ELEMENTS ← prove
   r"!(h:A->B) k l.
     radical_extension(k,l) h <=>
     finite_extension(k,l) h /\
     !x. x IN ring_carrier l ==> radical_element(k,l) h x"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN ASM_SIMP_TAC [RADICAL_EXTENSION_IMP_FINITE] THEN
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN REWRITE_TAC [radical_element] THEN
      EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
      ASM_REWRITE_TAC [SUBFIELD_GENERATED_RING_CARRIER, CARRIER_SUBFIELD_OF] THEN
      ASM_MESON_TAC [RADICAL_IMP_FIELD_EXTENSION, field_extension],
      STRIP_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FINITE_IMP_FINITELY_GENERATED_EXTENSION) THEN
    REWRITE_TAC [finitely_generated_extension] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"b:B->bool") STRIP_ASSUME_TAC)) THEN
    MATCH_MP_TAC RADICAL_EXTENSION_GENERATED_BY_RADICAL_ELEMENTS THEN
    EXISTS_TAC (← q r"b:B->bool") THEN ASM_MESON_TAC [SUBSET])

  -- @@RETURN BEGIN
  return { radical_element, RADICAL_ELEMENT_IN_CARRIER, RADICAL_ELEMENT_BASE,
           RADICAL_ELEMENT_NEG, RADICAL_ELEMENT_INV, RADICAL_ELEMENT_POW,
           RADICAL_ELEMENTS_COMMON_RADICAL_EXTENSION, RADICAL_ELEMENT_PAIR,
           RADICAL_ELEMENT_ADD, RADICAL_ELEMENT_SUB, RADICAL_ELEMENT_MUL,
           RADICAL_ELEMENT_DIV, RADICAL_ELEMENT_ROOT, SUBFIELD_OF_RADICAL_ELEMENTS,
           RADICAL_ELEMENT_HOMOMORPHIC_IMAGE,
           RADICAL_EXTENSION_GENERATED_BY_RADICAL_ELEMENTS,
           RADICAL_EXTENSION_EQ_RADICAL_ELEMENTS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The normal closure of a radical extension. For l radical over k and an    -/
/- embedding j of l into an algebraically closed field m, the normal closure -/
/- N of l inside m given by FINITE_EXTENSION_NORMAL_CLOSURE is radical over  -/
/- k: it is generated by finitely many elements of images e(l) of l under    -/
/- embeddings over k, and each e(l) is a radical subextension of N. Hence a  -/
/- radical element of an algebraically closed field lies in a subfield that  -/
/- is both radical and normal over k.                                        -/
/- ------------------------------------------------------------------------- -/

structure RadicalNormalClosure where
  -- @@FIELDS
  RADICAL_EXTENSION_NORMAL_CLOSURE : thm
  RADICAL_ELEMENT_NORMAL_CLOSURE : thm
  deriving Inhabited

@[nospecialize]
def setupRadicalNormalClosure [HolBase] (D : GaloisDeps) (BRadicalExtensions : RadicalExtensions) (BRadicalExtensions2 : RadicalExtensions2) (BRadicalElements : RadicalElements) :
    ExceptT String IO RadicalNormalClosure := do
  -- @@SCOPE BEGIN
  let { SET_TAC, .. } := D
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
        FINITE_EXTENSION_NORMAL_CLOSURE, FINITE_IMP_FIELD_EXTENSION, .. } := D.core1
  let { IMAGE_I, I_O_ID, MONO_EXISTS, .. } := D.core2
  let { RING_HOMOMORPHISM_SUBFIELD_INCLUSION, .. } := D.core3
  let { SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, SUBFIELD_GENERATED_IDEMPOT,
        SUBFIELD_GENERATED_IDEMPOT_GEN, SUBFIELD_OF_SUBFIELD_GENERATED_EQ,
        SUBFIELD_SUBFIELD_GENERATED, o_THM, .. } := D.core4
  let { RADICAL_EXTENSION_IMP_FINITE, .. } := BRadicalExtensions
  let { RADICAL_EXTENSION_HOMOMORPHIC_IMAGE_GEN, .. } := BRadicalExtensions2
  let { RADICAL_EXTENSION_GENERATED_BY_RADICAL_ELEMENTS, radical_element, .. } := BRadicalElements
  -- @@SCOPE END

  let RADICAL_EXTENSION_NORMAL_CLOSURE ← prove
   r"!(h:A->B) (j:B->C) k l m.
     radical_extension(k,l) h /\
     algebraically_closed_field m /\ ring_homomorphism(l,m) j
     ==> ?s. s subfield_of m /\ IMAGE j (ring_carrier l) SUBSET s /\
             radical_extension(k,subfield_generated m s) (j o h) /\
             normal_extension(k,subfield_generated m s) (j o h)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
      FINITE_EXTENSION_NORMAL_CLOSURE) THEN
    ASM_SIMP_TAC [RADICAL_EXTENSION_IMP_FINITE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:C->bool") (CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 (LABEL_TAC "s") (CONJUNCTS_THEN2 (LABEL_TAC "e")
       STRIP_ASSUME_TAC)))) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    ABBREV_TAC
     (← q r"N = subfield_generated m
          (IMAGE ((j:B->C) o (h:A->B)) (ring_carrier k) UNION s)") THEN
    EXISTS_TAC (← q r"ring_carrier N:C->bool") THEN
    SUBGOAL_THEN (← q r"subfield_generated m (ring_carrier N) = N:C ring")
    SUBST1_TAC THENL
     [EXPAND_TAC "N" THEN REWRITE_TAC [SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [EXPAND_TAC "N" THEN ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED],
      USE_THEN "e" (MP_TAC o SPEC (← q r"j:B->C")) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], SIMP_TAC []],
      ALL_TAC] THEN
    MATCH_MP_TAC RADICAL_EXTENSION_GENERATED_BY_RADICAL_ELEMENTS THEN
    EXISTS_TAC (← q r"s:C->bool") THEN
    ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:C") THEN DISCH_TAC THEN
      USE_THEN "s" (fun th => tactic_of do
        pure (MP_TAC (← MATCH_MP th (← ASSUME (← q r"(x:C) IN s"))))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:B->C") STRIP_ASSUME_TAC) THEN
      USE_THEN "e" (MP_TAC o SPEC (← q r"e:B->C")) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->C) o (h:A->B)", ← q r"e:B->C",
                     ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
        RADICAL_EXTENSION_HOMOMORPHIC_IMAGE_GEN) THEN
      ASM_REWRITE_TAC [o_THM] THEN STRIP_TAC THEN
      REWRITE_TAC [radical_element] THEN
      EXISTS_TAC (← q r"IMAGE (e:B->C) (ring_carrier l)") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [EXPAND_TAC "N" THEN REWRITE_TAC [SUBFIELD_OF_SUBFIELD_GENERATED_EQ] THEN
        ASM_REWRITE_TAC [],
        MP_TAC (← ISPECL [← q r"m:C ring", ← q r"IMAGE (e:B->C) (ring_carrier l)",
                       ← q r"IMAGE ((j:B->C) o (h:A->B)) (ring_carrier k) UNION s"]
          SUBFIELD_GENERATED_IDEMPOT_GEN) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
        FIRST_ASSUM ACCEPT_TAC],
      EXPAND_TAC "N" THEN REWRITE_TAC [SUBFIELD_GENERATED_IDEMPOT]])

  let RADICAL_ELEMENT_NORMAL_CLOSURE ← prove
   r"!(h:A->B) k l x.
     algebraically_closed_field l /\ radical_element(k,l) h x
     ==> ?s. s subfield_of l /\ x IN s /\
             radical_extension(k,subfield_generated l s) h /\
             normal_extension(k,subfield_generated l s) h"
   (REPEAT GEN_TAC THEN REWRITE_TAC [radical_element] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"t:B->bool") STRIP_ASSUME_TAC)) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                   ← q r"subfield_generated l (t:B->bool)", ← q r"l:B ring"]
      RADICAL_EXTENSION_NORMAL_CLOSURE) THEN
    ASM_SIMP_TAC [I_O_ID, IMAGE_I, RING_HOMOMORPHISM_SUBFIELD_INCLUSION,
                 CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:B->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  -- @@RETURN BEGIN
  return { RADICAL_EXTENSION_NORMAL_CLOSURE, RADICAL_ELEMENT_NORMAL_CLOSURE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Cyclotomic and Kummer extensions. An extension generated over the image   -/
/- of k by deg p distinct roots of a polynomial p over k is finite and       -/
/- Galois (p splits and is separable). Its Galois group is abelian when its  -/
/- elements commute on a set of generators, in particular when l is          -/
/- generated over the image of k by an element z of finite order (they send  -/
/- z to powers of z) or by an element a which they multiply by elements of   -/
/- the image of k. Adjoining a root of unity z gives an extension of the     -/
/- first kind for X^d - 1, d the order of z, whose roots are the d powers of -/
/- z: it is abelian Galois in any characteristic. Adjoining an n-th root a   -/
/- of an element of k, when k has n distinct n-th roots of unity, gives one  -/
/- for X^n - a^n (for X when a = 0), whose roots are the products of a with  -/
/- the roots of unity, so the elements of the Galois group multiply a by     -/
/- roots of unity: again abelian Galois. Both are also stated for an         -/
/- intermediate field s of l and the subfield generated by s and the new     -/
/- element, the form used in towers.                                         -/
/- ------------------------------------------------------------------------- -/

structure CyclotomicKummer where
  -- @@FIELDS
  GALOIS_EXTENSION_DISTINCT_ROOTS : thm
  ABELIAN_GALOIS_GROUP_ON_GENERATORS : thm
  ABELIAN_GALOIS_GROUP_ROOT_OF_UNITY : thm
  ABELIAN_GALOIS_GROUP_RADICAL : thm
  CYCLOTOMIC_EXTENSION_ABELIAN : thm
  KUMMER_EXTENSION_ABELIAN : thm
  CYCLOTOMIC_EXTENSION_ABELIAN_INTERMEDIATE : thm
  KUMMER_EXTENSION_ABELIAN_INTERMEDIATE : thm
  deriving Inhabited

@[nospecialize]
def setupCyclotomicKummer [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtension : GaloisExtension) (BGaloisIsomorphic : GaloisIsomorphic) :
    ExceptT String IO CyclotomicKummer := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ARITH_EQ, CARD_SING, CARRIER_SUBFIELD_GENERATED_SUBFIELD, CONJ_ASSOC,
        DIVIDES_ZERO, FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
        FIELD_EXTENSION_SUBFIELD_GENERATED, FIELD_IMP_INTEGRAL_DOMAIN,
        FIELD_NONTRIVIAL, FINITE_SING, FORALL_IN_IMAGE, FORALL_UNWIND_THM2, .. } := D.core1
  let { HAS_SIZE, HAS_SIZE_IMAGE_INJ, IMAGE_I, INTEGRAL_DOMAIN_MUL_RCANCEL,
        IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_SING, PERMUTES_IN_IMAGE,
        POLY_EVAL_VAR_POW_SUB_CONST, .. } := D.core2
  let { POLY_SPLITS_OVER_DISTINCT_ROOTS, POLY_VAR_POW_SUB_CONST, RING_0, RING_1,
        RING_ENDOMORPHISM_ROOT_OF_UNITY, RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1,
        RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_POW,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL, RING_MUL_AC, RING_MUL_LID,
        RING_MUL_POW, RING_MUL_RZERO, RING_POW_1, RING_POW_EQ_1, RING_POW_ONE,
        RING_POW_POW, RING_POW_RING_ORDER, RING_POW_SUBFIELD_GENERATED, RING_SUB_REFL, .. } := D.core3
  let { ROOTS_OF_UNITY_HAS_SIZE_NONZERO, ROOTS_OF_UNITY_RING_ORDER, SUBFIELD_GENERATED,
        SUBFIELD_GENERATED_IDEMPOT, SUBFIELD_GENERATED_INC_GEN,
        SUBFIELD_GENERATED_MONO, SUBFIELD_GENERATED_SUPERSET, SUBSET_REFL,
        SUBSET_TRANS, abelian_group, field_extension, o_THM, ring_endomorphism,
        ring_monomorphism, splitting_extension, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_COMPOSE, GALOIS_GROUP_FIXES, GALOIS_GROUP_PERMUTES,
        GALOIS_GROUP_POLY_EVAL, GALOIS_GROUP_RING_HOMOMORPHISM, .. } := BGaloisGroup
  let { GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING, .. } := BGaloisExtension
  let { GALOIS_GROUP_EQ_ON_GENERATORS, .. } := BGaloisIsomorphic
  -- @@SCOPE END

  let GALOIS_EXTENSION_DISTINCT_ROOTS ← prove
   r"!(h:A->B) k l p s.
        field_extension(k,l) h /\
        p IN ring_carrier(poly_ring k (:1)) /\ ~(p = poly_0 k) /\
        s HAS_SIZE poly_deg k p /\
        (!x. x IN s
             ==> x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l) /\
        subfield_generated l (IMAGE h (ring_carrier k) UNION s) = l
        ==> finite_extension(k,l) h /\ galois_extension(k,l) h"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A",
                   ← q r"s:B->bool"] POLY_SPLITS_OVER_DISTINCT_ROOTS) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    REWRITE_TAC [GALOIS_EXTENSION_EQ_SEPARABLE_SPLITTING] THEN
    EXISTS_TAC (← q r"p:(1->num)->A") THEN ASM_REWRITE_TAC [splitting_extension])

  let ABELIAN_GALOIS_GROUP_ON_GENERATORS ← prove
   r"!(h:A->B) k l s.
        field l /\
        subfield_generated l (IMAGE h (ring_carrier k) UNION s) = l /\
        (!f g x. f IN group_carrier(galois_group(k,l) h) /\
                 g IN group_carrier(galois_group(k,l) h) /\ x IN s
                 ==> f(g x) = g(f x))
        ==> abelian_group(galois_group(k,l) h)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [abelian_group, ← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP))] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
    MATCH_MP_TAC GALOIS_GROUP_EQ_ON_GENERATORS THEN
    MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"] THEN
    ASM_SIMP_TAC [GALOIS_GROUP_COMPOSE, o_THM])

  let ABELIAN_GALOIS_GROUP_ROOT_OF_UNITY ← prove
   r"!(h:A->B) k l z.
        field l /\ z IN ring_carrier l /\ ~(ring_order l z = 0) /\
        subfield_generated l (z INSERT IMAGE h (ring_carrier k)) = l
        ==> abelian_group(galois_group(k,l) h)"
   (← do
    let s1 ← SET_RULE (← q r"(s:B->bool) UNION {a} = a INSERT s")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC ABELIAN_GALOIS_GROUP_ON_GENERATORS THEN
    EXISTS_TAC (← q r"{z:B}") THEN
    ASM_REWRITE_TAC [s1, IN_SING] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B", ← q r"x:B"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    SUBGOAL_THEN
     (← q r"ring_homomorphism(l,l) (f:B->B) /\ ring_homomorphism(l,l) (g:B->B)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"f:B->B", ← q r"z:B"]
      RING_ENDOMORPHISM_ROOT_OF_UNITY) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"g:B->B", ← q r"z:B"]
      RING_ENDOMORPHISM_ROOT_OF_UNITY) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, ring_endomorphism] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"j:num")) THEN DISCH_THEN (X_CHOOSE_TAC (← q r"i:num")) THEN
    ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_POW
                  (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)")),
                 ← MATCH_MP RING_HOMOMORPHISM_POW
                  (← ASSUME (← q r"ring_homomorphism(l,l) (g:B->B)"))] THEN
    ASM_SIMP_TAC [RING_POW_POW] THEN AP_TERM_TAC THEN ARITH_TAC))

  let ABELIAN_GALOIS_GROUP_RADICAL ← prove
   r"!(h:A->B) k l a.
        field_extension(k,l) h /\ a IN ring_carrier l /\
        subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l /\
        (!f. f IN group_carrier(galois_group(k,l) h)
             ==> ?c. c IN ring_carrier k /\ f a = ring_mul l (h c) a)
        ==> abelian_group(galois_group(k,l) h)"
   (← do
    let s1 ← SET_RULE (← q r"(s:B->bool) UNION {a} = a INSERT s")
    let lastAC ← match (CONJUNCTS (← ISPEC (← q r"l:B ring") RING_MUL_AC)).getLast? with
      | some c => pure c
      | none => throw "last"
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    MATCH_MP_TAC ABELIAN_GALOIS_GROUP_ON_GENERATORS THEN
    EXISTS_TAC (← q r"{a:B}") THEN
    ASM_REWRITE_TAC [s1, IN_SING] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B", ← q r"x:B"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"f:B->B")) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"g:B->B")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:A") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:A") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"v:A"]
      GALOIS_GROUP_FIXES) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"w:A"]
      GALOIS_GROUP_FIXES) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"v:A"]
      RING_HOMOMORPHISM_IN_CARRIER) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"w:A"]
      RING_HOMOMORPHISM_IN_CARRIER) THEN
    ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"ring_homomorphism(l,l) (f:B->B) /\ ring_homomorphism(l,l) (g:B->B)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM], ALL_TAC] THEN
    ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL
                  (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)")),
                 ← MATCH_MP RING_HOMOMORPHISM_MUL
                  (← ASSUME (← q r"ring_homomorphism(l,l) (g:B->B)"))] THEN
    MATCH_MP_TAC lastAC THEN
    ASM_SIMP_TAC []))

  let CYCLOTOMIC_EXTENSION_ABELIAN ← prove
   r"!(h:A->B) k l z n.
        field_extension(k,l) h /\ ~(n = 0) /\
        z IN ring_carrier l /\ ring_pow l z n = ring_1 l /\
        subfield_generated l (z INSERT IMAGE h (ring_carrier k)) = l
        ==> finite_extension(k,l) h /\ galois_extension(k,l) h /\
            abelian_group(galois_group(k,l) h)"
   (← do
    let s1 ← SET_RULE (← q r"(z:B) IN s ==> z INSERT t SUBSET t UNION s")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    ABBREV_TAC (← q r"d = ring_order l (z:B)") THEN
    SUBGOAL_THEN (← q r"~(d = 0)") ASSUME_TAC THENL
     [DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"z:B", ← q r"n:num"] RING_POW_EQ_1) THEN
      ASM_REWRITE_TAC [DIVIDES_ZERO],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_pow l (z:B) d = ring_1 l") ASSUME_TAC THENL
     [EXPAND_TAC "d" THEN MATCH_MP_TAC RING_POW_RING_ORDER THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC ABELIAN_GALOIS_GROUP_ROOT_OF_UNITY THEN
      EXISTS_TAC (← q r"z:B") THEN ASM_REWRITE_TAC []] THEN
    ABBREV_TAC
     (← q r"p = poly_sub k (poly_pow k (poly_var k one) d) (poly_const k (ring_1 k))
          :(1->num)->A") THEN
    ABBREV_TAC (← q r"s = {x:B | x IN ring_carrier l /\ ring_pow l x d = ring_1 l}") THEN
    SUBGOAL_THEN
     (← q r"p IN ring_carrier(poly_ring k (:1)) /\ poly_deg k p = d /\
      ~(p:(1->num)->A = poly_0 k)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "p" THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"d:num", ← q r"ring_1 k:A"]
        POLY_VAR_POW_SUB_CONST) THEN
      ASM_SIMP_TAC [RING_1, FIELD_NONTRIVIAL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(s:B->bool) HAS_SIZE poly_deg k (p:(1->num)->A)")
    ASSUME_TAC THENL
     [ASM_REWRITE_TAC [] THEN EXPAND_TAC "s" THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"z:B", ← q r"d:num"] ROOTS_OF_UNITY_RING_ORDER) THEN
      ANTS_TAC THENL [ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN], SIMP_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x:B. x IN s
            ==> x IN ring_carrier l /\
                poly_eval l ((h:A->B) o p) x = ring_0 l")
    ASSUME_TAC THENL
     [EXPAND_TAC "s" THEN EXPAND_TAC "p" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:B") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [POLY_EVAL_VAR_POW_SUB_CONST, RING_1] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP RING_HOMOMORPHISM_1 th])) THEN
      ASM_SIMP_TAC [RING_SUB_REFL, RING_1],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"subfield_generated l (IMAGE (h:A->B) (ring_carrier k) UNION s) = l")
    ASSUME_TAC THENL
     [REWRITE_TAC [SUBFIELD_GENERATED_SUPERSET] THEN
      TRANS_TAC SUBSET_TRANS
       (← q r"ring_carrier(subfield_generated l
          ((z:B) INSERT IMAGE (h:A->B) (ring_carrier k)))") THEN
      CONJ_TAC THENL
       [ASM_REWRITE_TAC [SUBSET_REFL],
        MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN
        MATCH_MP_TAC s1 THEN
        EXPAND_TAC "s" THEN REWRITE_TAC [IN_ELIM_THM] THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A",
                   ← q r"s:B->bool"] GALOIS_EXTENSION_DISTINCT_ROOTS) THEN
    ANTS_TAC THENL [REPEAT CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC, SIMP_TAC []]))

  let KUMMER_EXTENSION_ABELIAN ← prove
   r"!(h:A->B) k l a n.
        field_extension(k,l) h /\
        {x | x IN ring_carrier k /\ ring_pow k x n = ring_1 k} HAS_SIZE n /\
        a IN ring_carrier l /\ ring_pow l a n IN IMAGE h (ring_carrier k) /\
        subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l
        ==> finite_extension(k,l) h /\ galois_extension(k,l) h /\
            abelian_group(galois_group(k,l) h)"
   (← do
    let s1 ← SET_RULE (← q r"(a:B) IN s ==> a INSERT t SUBSET t UNION s")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    UNDISCH_TAC (← q r"ring_pow l (a:B) n IN IMAGE (h:A->B) (ring_carrier k)") THEN
    REWRITE_TAC [IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:A") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"!x:A. x IN ring_carrier k ==> (h:A->B) x IN ring_carrier l")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(h:A->B)(ring_1 k) = ring_1 l /\ h(ring_0 k) = ring_0 l")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_0], ALL_TAC] THEN
    ABBREV_TAC (← q r"u = {x:A | x IN ring_carrier k /\ ring_pow k x n = ring_1 k}") THEN
    SUBGOAL_THEN (← q r"~(n = 0)") ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"(u:A->bool) HAS_SIZE n") THEN EXPAND_TAC "u" THEN
      MATCH_ACCEPT_TAC ROOTS_OF_UNITY_HAS_SIZE_NONZERO,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?p s. p IN ring_carrier(poly_ring k (:1)) /\ ~(p = poly_0 k) /\
            s HAS_SIZE poly_deg k p /\
            (!x. x IN s
                 ==> x IN ring_carrier l /\
                     poly_eval l ((h:A->B) o p) x = ring_0 l) /\
            (a:B) IN s /\
            (!x. x IN s ==> ?v. v IN ring_carrier k /\ x = ring_mul l (h v) a)")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"a = ring_0 (l:B ring)") THENL
       [EXISTS_TAC
         (← q r"poly_sub k (poly_pow k (poly_var k one) 1) (poly_const k (ring_0 k))
          :(1->num)->A") THEN
        EXISTS_TAC (← q r"{a:B}") THEN
        MP_TAC (← ISPECL [← q r"k:A ring", ← q r"1", ← q r"ring_0 k:A"] POLY_VAR_POW_SUB_CONST) THEN
        ASM_SIMP_TAC [FIELD_NONTRIVIAL, RING_0, ARITH_EQ] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [IN_SING, FORALL_UNWIND_THM2, HAS_SIZE, FINITE_SING,
                        CARD_SING] THEN
        CONJ_TAC THENL
         [ASM_SIMP_TAC [RING_0, POLY_EVAL_VAR_POW_SUB_CONST, RING_POW_1,
                       RING_SUB_REFL],
          EXISTS_TAC (← q r"ring_1 k:A") THEN ASM_SIMP_TAC [RING_1, RING_MUL_RZERO]],
        ALL_TAC] THEN
      EXISTS_TAC
       (← q r"poly_sub k (poly_pow k (poly_var k one) n) (poly_const k c)
        :(1->num)->A") THEN
      EXISTS_TAC (← q r"IMAGE (\x. ring_mul l ((h:A->B) x) a) u") THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"n:num", ← q r"c:A"] POLY_VAR_POW_SUB_CONST) THEN
      ASM_SIMP_TAC [FIELD_NONTRIVIAL] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_IMAGE] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "u" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o CONJUNCT2 o
          GEN_REWRITE_RULE I [ring_monomorphism]) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC INTEGRAL_DOMAIN_MUL_RCANCEL THEN
        MAP_EVERY EXISTS_TAC [← q r"l:B ring", ← q r"a:B"] THEN
        ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN],
        EXPAND_TAC "u" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
        ASM_SIMP_TAC [RING_MUL, POLY_EVAL_VAR_POW_SUB_CONST] THEN
        ASM_SIMP_TAC [RING_MUL_POW] THEN
        SUBGOAL_THEN (← q r"ring_pow l ((h:A->B) x) n = ring_1 l") SUBST1_TAC THENL
         [ASM_SIMP_TAC [← GSYM (← MATCH_MP RING_HOMOMORPHISM_POW
            (← ASSUME (← q r"ring_homomorphism(k,l) (h:A->B)")))],
          ALL_TAC] THEN
        ASM_SIMP_TAC [RING_MUL_LID, RING_SUB_REFL],
        EXISTS_TAC (← q r"ring_1 k:A") THEN EXPAND_TAC "u" THEN
        ASM_SIMP_TAC [IN_ELIM_THM, RING_1, RING_POW_ONE, RING_MUL_LID],
        EXPAND_TAC "u" THEN REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"subfield_generated l (IMAGE (h:A->B) (ring_carrier k) UNION s) = l")
    ASSUME_TAC THENL
     [REWRITE_TAC [SUBFIELD_GENERATED_SUPERSET] THEN
      TRANS_TAC SUBSET_TRANS
       (← q r"ring_carrier(subfield_generated l
          ((a:B) INSERT IMAGE (h:A->B) (ring_carrier k)))") THEN
      CONJ_TAC THENL
       [ASM_REWRITE_TAC [SUBSET_REFL],
        MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN
        MATCH_MP_TAC s1 THEN
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A",
                   ← q r"s:B->bool"] POLY_SPLITS_OVER_DISTINCT_ROOTS) THEN
    ANTS_TAC THENL [REPEAT CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC, STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A",
                   ← q r"s:B->bool"] GALOIS_EXTENSION_DISTINCT_ROOTS) THEN
    ANTS_TAC THENL
     [REPEAT CONJ_TAC THEN FIRST_ASSUM ACCEPT_TAC,
      DISCH_THEN (fun th => REWRITE_TAC [th])] THEN
    MATCH_MP_TAC ABELIAN_GALOIS_GROUP_RADICAL THEN
    EXISTS_TAC (← q r"a:B") THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(f:B->B) a IN s") MP_TAC THENL
     [ALL_TAC,
      MESON_TAC [← ASSUME (← q r"!x:B. x IN s
                          ==> ?v. v IN ring_carrier k /\
                                  x = ring_mul l ((h:A->B) v) a")]] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"s:B->bool"
      let ok := is_eq (concl th) &&
        (match rand (concl th) with | .ok u => u == c | .error _ => false)
      if !ok then throw "check"
      pure ((SUBST1_TAC o SYM) th)) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_IN_IMAGE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"p:(1->num)->A", ← q r"a:B"] GALOIS_GROUP_POLY_EVAL) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN SUBST1_TAC] THEN
    SUBGOAL_THEN (← q r"poly_eval l ((h:A->B) o p) a = ring_0 l") SUBST1_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_0 THEN
    MATCH_MP_TAC GALOIS_GROUP_RING_HOMOMORPHISM THEN
    MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN ASM_REWRITE_TAC []))

  let CYCLOTOMIC_EXTENSION_ABELIAN_INTERMEDIATE ← prove
   r"!(l:B ring) s z n.
        field l /\ s subfield_of l /\ ~(n = 0) /\
        z IN ring_carrier l /\ ring_pow l z n = ring_1 l
        ==> finite_extension
             (subfield_generated l s,subfield_generated l (z INSERT s)) I /\
            galois_extension
             (subfield_generated l s,subfield_generated l (z INSERT s)) I /\
            abelian_group
             (galois_group
               (subfield_generated l s,subfield_generated l (z INSERT s)) I)"
   (← do
    let sg2 ← match (CONJUNCTS SUBFIELD_GENERATED)[2]? with
      | some c => pure c
      | none => throw "el"
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CYCLOTOMIC_EXTENSION_ABELIAN THEN
    MAP_EVERY EXISTS_TAC [← q r"z:B", ← q r"n:num"] THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, IMAGE_I,
                 SUBFIELD_GENERATED_IDEMPOT, RING_POW_SUBFIELD_GENERATED,
                 sg2,
                 SUBFIELD_GENERATED_INC_GEN, IN_INSERT] THEN
    MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED, IMAGE_I,
                 CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
    SET_TAC []))

  let KUMMER_EXTENSION_ABELIAN_INTERMEDIATE ← prove
   r"!(l:B ring) s a n.
        field l /\ s subfield_of l /\
        {x | x IN s /\ ring_pow l x n = ring_1 l} HAS_SIZE n /\
        a IN ring_carrier l /\ ring_pow l a n IN s
        ==> finite_extension
             (subfield_generated l s,subfield_generated l (a INSERT s)) I /\
            galois_extension
             (subfield_generated l s,subfield_generated l (a INSERT s)) I /\
            abelian_group
             (galois_group
               (subfield_generated l s,subfield_generated l (a INSERT s)) I)"
   (← do
    let sg2 ← match (CONJUNCTS SUBFIELD_GENERATED)[2]? with
      | some c => pure c
      | none => throw "el"
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC KUMMER_EXTENSION_ABELIAN THEN
    MAP_EVERY EXISTS_TAC [← q r"a:B", ← q r"n:num"] THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, IMAGE_I,
                 SUBFIELD_GENERATED_IDEMPOT, RING_POW_SUBFIELD_GENERATED,
                 sg2,
                 SUBFIELD_GENERATED_INC_GEN, IN_INSERT] THEN
    MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED, IMAGE_I,
                 CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
    SET_TAC []))

  -- @@RETURN BEGIN
  return { GALOIS_EXTENSION_DISTINCT_ROOTS, ABELIAN_GALOIS_GROUP_ON_GENERATORS,
           ABELIAN_GALOIS_GROUP_ROOT_OF_UNITY, ABELIAN_GALOIS_GROUP_RADICAL,
           CYCLOTOMIC_EXTENSION_ABELIAN, KUMMER_EXTENSION_ABELIAN,
           CYCLOTOMIC_EXTENSION_ABELIAN_INTERMEDIATE,
           KUMMER_EXTENSION_ABELIAN_INTERMEDIATE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Cyclotomic and Kummer extensions, continued. If a^n lies in the image of  -/
/- k and k has n distinct n-th roots of unity, every element of the Galois   -/
/- group multiplies a by the image of an n-th root of unity of k. When the   -/
/- elements of the Galois group multiply a generator a in this way,          -/
/- f |-> f(a) / a embeds the Galois group in the finite group of n-th roots  -/
/- of unity of l, so the Galois group is cyclic of order dividing n. Hence   -/
/- Kummer extensions have cyclic Galois groups, also in the intermediate     -/
/- form used in towers.                                                      -/
/- ------------------------------------------------------------------------- -/

structure KummerCyclic where
  -- @@FIELDS
  GALOIS_GROUP_KUMMER_ROOT_OF_UNITY : thm
  GALOIS_GROUP_POW_MUL_FIXED : thm
  GALOIS_GROUP_POW_ADD_FIXED : thm
  CYCLIC_GALOIS_GROUP_RADICAL : thm
  KUMMER_EXTENSION_CYCLIC : thm
  KUMMER_EXTENSION_CYCLIC_INTERMEDIATE : thm
  deriving Inhabited

@[nospecialize]
def setupKummerCyclic [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisIsomorphic : GaloisIsomorphic) :
    ExceptT String IO KummerCyclic := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ADD1, CARD_CYCLIC_SUBGROUP_ORDER, CARD_SING, CARD_SUBSET, CARD_SUBSET_EQ,
        CARRIER_SUBFIELD_GENERATED_SUBFIELD, DIVIDES_1, EXTENSION,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_EXTENSION_SUBFIELD_GENERATED,
        FIELD_IMP_INTEGRAL_DOMAIN, FIELD_MUL_LINV, FIELD_MUL_RINV, FIELD_NONTRIVIAL,
        FINITE_CYCLIC_SUBGROUP, FINITE_RING_MULTSYS_CYCLIC, FINITE_SUBSET,
        FORALL_IN_IMAGE, FORALL_UNWIND_THM2, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET,
        GROUP_ID, GROUP_POW, .. } := D.core1
  let { GROUP_POW_EQ_ID, HAS_SIZE, HAS_SIZE_IMAGE_INJ, IMAGE_I,
        INTEGRAL_DOMAIN_POW_EQ_0, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_SING,
        IN_SUBGROUP_POW, I_THM, LE_1, LE_ANTISYM, MONO_EXISTS, .. } := D.core2
  let { RING_1, RING_ADD_AC, RING_ADD_RDISTRIB, RING_ADD_RZERO, RING_HOMOMORPHISM_0,
        RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_IN_CARRIER,
        RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_POW, RING_HOMOMORPHISM_RING_OF_NUM,
        RING_INV, RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL, RING_MUL_ASSOC,
        RING_MUL_LID, RING_MUL_LZERO, RING_MUL_POW, RING_MUL_RID, RING_MUL_RZERO,
        RING_MUL_SYM, RING_OF_NUM, RING_OF_NUM_0, RING_OF_NUM_1, RING_OF_NUM_ADD,
        RING_POW, RING_POW_INV, RING_POW_ONE, RING_POW_SUBFIELD_GENERATED,
        RING_POW_ZERO, .. } := D.core3
  let { ROOTS_OF_UNITY_BOUND, ROOTS_OF_UNITY_HAS_SIZE_NONZERO, SUBFIELD_GENERATED,
        SUBFIELD_GENERATED_IDEMPOT, SUBFIELD_GENERATED_INC_GEN, SUBGROUP_GENERATED_EQ,
        SUBGROUP_GENERATED_INC_GEN, SUBGROUP_SUBGROUP_GENERATED, SUBSET,
        SUBSET_ANTISYM, TRIVIAL_IMP_CYCLIC_GROUP, cyclic_group, field_extension,
        group_pow, o_THM, ring_monomorphism, ring_multsys, ring_pow, trivial_group, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_COMPOSE, GALOIS_GROUP_FIXES,
        GALOIS_GROUP_RING_HOMOMORPHISM, .. } := BGaloisGroup
  let { GALOIS_GROUP_EQ_ON_GENERATORS, .. } := BGaloisIsomorphic
  -- @@SCOPE END

  let GALOIS_GROUP_KUMMER_ROOT_OF_UNITY ← prove
   r"!(h:A->B) f k l a n.
        field_extension(k,l) h /\
        {x | x IN ring_carrier k /\ ring_pow k x n = ring_1 k} HAS_SIZE n /\
        a IN ring_carrier l /\ ring_pow l a n IN IMAGE h (ring_carrier k) /\
        f IN group_carrier(galois_group(k,l) h)
        ==> ?c. c IN ring_carrier k /\ ring_pow k c n = ring_1 k /\
                f a = ring_mul l (h c) a"
   (REPEAT GEN_TAC THEN
    ABBREV_TAC (← q r"u = {x:A | x IN ring_carrier k /\ ring_pow k x n = ring_1 k}") THEN
    STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"~(n = 0)") ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"(u:A->bool) HAS_SIZE n") THEN EXPAND_TAC "u" THEN
      MATCH_ACCEPT_TAC ROOTS_OF_UNITY_HAS_SIZE_NONZERO,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(f:B->B)(ring_0 l) = ring_0 l /\ (h:A->B)(ring_1 k) = ring_1 l")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"a = ring_0(l:B ring)") THENL
     [EXISTS_TAC (← q r"ring_1 k:A") THEN
      ASM_REWRITE_TAC [RING_1, RING_POW_ONE] THEN
      ASM_SIMP_TAC [RING_MUL_RZERO, RING_1],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(f:B->B) a IN ring_carrier l") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(f:B->B)(ring_pow l a n) = ring_pow l a n") ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"ring_pow l (a:B) n IN IMAGE (h:A->B) (ring_carrier k)") THEN
      REWRITE_TAC [IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c0:A") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"c0:A"]
        GALOIS_GROUP_FIXES) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?b. b IN ring_carrier l /\ ring_pow l b n = ring_1 l /\
          (f:B->B) a = ring_mul l b a")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"ring_mul l ((f:B->B) a) (ring_inv l a)") THEN
      ASM_SIMP_TAC [RING_MUL, RING_INV, RING_MUL_POW, RING_POW_INV] THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [← GSYM (← MATCH_MP RING_HOMOMORPHISM_POW
          (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)")))] THEN
        MATCH_MP_TAC FIELD_MUL_RINV THEN
        ASM_SIMP_TAC [RING_POW, INTEGRAL_DOMAIN_POW_EQ_0,
                     FIELD_IMP_INTEGRAL_DOMAIN],
        ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, RING_INV, FIELD_MUL_LINV,
                     RING_MUL_RID]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (h:A->B) u = {x | x IN ring_carrier l /\ ring_pow l x n = ring_1 l}")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"l:B ring", ← q r"n:num"] ROOTS_OF_UNITY_BOUND) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, LE_1] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"IMAGE (h:A->B) u HAS_SIZE n") MP_TAC THENL
       [MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "u" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_MESON_TAC [ring_monomorphism],
        REWRITE_TAC [HAS_SIZE] THEN STRIP_TAC] THEN
      SUBGOAL_THEN
       (← q r"IMAGE (h:A->B) u SUBSET
        {x | x IN ring_carrier l /\ ring_pow l x n = ring_1 l}")
      ASSUME_TAC THENL
       [EXPAND_TAC "u" THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
        ASM_SIMP_TAC [← GSYM (← MATCH_MP RING_HOMOMORPHISM_POW
          (← ASSUME (← q r"ring_homomorphism(k,l) (h:A->B)")))] THEN
        ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
        ALL_TAC] THEN
      MATCH_MP_TAC CARD_SUBSET_EQ THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM LE_ANTISYM] THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"IMAGE (h:A->B) u",
                     ← q r"{x:B | x IN ring_carrier l /\ ring_pow l x n = ring_1 l}"]
        CARD_SUBSET) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(b:B) IN IMAGE (h:A->B) u") MP_TAC THENL
     [ASM_REWRITE_TAC [IN_ELIM_THM], ALL_TAC] THEN
    EXPAND_TAC "u" THEN REWRITE_TAC [IN_IMAGE, IN_ELIM_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:A") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [])

  /- Powers of an element f of the Galois group that multiplies a by an        -/
  /- element c fixed by f, or adds c to a: the n-th power multiplies a by c^n, -/
  /- or adds n c.                                                              -/

  let GALOIS_GROUP_POW_MUL_FIXED ← prove
   r"!(h:A->B) f k l a c n.
        f IN group_carrier(galois_group(k,l) h) /\
        a IN ring_carrier l /\ c IN ring_carrier l /\
        f c = c /\ f a = ring_mul l c a
        ==> group_pow (galois_group(k,l) h) f n a =
            ring_mul l (ring_pow l c n) a"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM) THEN
    SPEC_TAC (← q r"n:num", ← q r"n:num") THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [group_pow, ← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP),
                    ← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP)), o_THM,
                    I_THM] THENL
     [ASM_SIMP_TAC [ring_pow, RING_MUL_LID], ALL_TAC] THEN
    ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL
                  (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)")), RING_POW] THEN
    ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_POW
                  (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)"))] THEN
    ASM_SIMP_TAC [ring_pow, RING_POW, RING_MUL_ASSOC] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC RING_MUL_SYM THEN
    ASM_SIMP_TAC [RING_POW])

  let GALOIS_GROUP_POW_ADD_FIXED ← prove
   r"!(h:A->B) f k l a c n.
        f IN group_carrier(galois_group(k,l) h) /\
        a IN ring_carrier l /\ c IN ring_carrier l /\
        f c = c /\ f a = ring_add l a c
        ==> group_pow (galois_group(k,l) h) f n a =
            ring_add l a (ring_mul l (ring_of_num l n) c)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM) THEN
    SPEC_TAC (← q r"n:num", ← q r"n:num") THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [group_pow, ← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP),
                    ← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP)), o_THM,
                    I_THM] THENL
     [ASM_SIMP_TAC [RING_OF_NUM_0, RING_MUL_LZERO, RING_ADD_RZERO], ALL_TAC] THEN
    ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_ADD
                  (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)")),
                 ← MATCH_MP RING_HOMOMORPHISM_MUL
                  (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)")),
                 ← MATCH_MP RING_HOMOMORPHISM_RING_OF_NUM
                  (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)")),
                 RING_OF_NUM, RING_MUL] THEN
    REWRITE_TAC [ADD1, RING_OF_NUM_ADD, RING_OF_NUM_1] THEN
    ASM_SIMP_TAC [RING_ADD_RDISTRIB, RING_OF_NUM, RING_1, RING_MUL_LID] THEN
    ASM_SIMP_TAC [RING_ADD_AC, RING_MUL, RING_OF_NUM])

  let CYCLIC_GALOIS_GROUP_RADICAL ← prove
   r"!(h:A->B) k l a n.
        field_extension(k,l) h /\ a IN ring_carrier l /\
        subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l /\
        ~(n = 0) /\
        (!f. f IN group_carrier(galois_group(k,l) h)
             ==> ?c. c IN ring_carrier k /\ ring_pow k c n = ring_1 k /\
                     f a = ring_mul l (h c) a)
        ==> cyclic_group(galois_group(k,l) h) /\
            CARD(group_carrier(galois_group(k,l) h)) divides n"
   (← do
    -- right to left: the second SET_RULE, then the first
    let s2 ← SET_RULE (← q r"(s:B->bool) UNION {a} = a INSERT s")
    let s1 ← SET_RULE (← q r"(s:B->bool) UNION {a} = a INSERT s")
    pure (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
      (LABEL_TAC "roots"))))) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"integral_domain(l:B ring)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!x:A. x IN ring_carrier k ==> (h:A->B) x IN ring_carrier l")
    ASSUME_TAC THENL [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(I:B->B) IN group_carrier(galois_group(k,l) (h:A->B))")
    ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"galois_group(k:A ring,l:B ring) h") GROUP_ID) THEN
      REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"a = ring_0(l:B ring)") THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"a = ring_0(l:B ring)"
        if !(concl th == c) then throw "check"
        pure (SUBST_ALL_TAC th)) THEN
      SUBGOAL_THEN (← q r"trivial_group(galois_group(k:A ring,l:B ring) h)")
      ASSUME_TAC THENL
       [REWRITE_TAC [trivial_group, ← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)] THEN
        REWRITE_TAC [EXTENSION, IN_SING] THEN X_GEN_TAC (← q r"f:B->B") THEN
        EQ_TAC THENL
         [DISCH_TAC, DISCH_THEN SUBST1_TAC THEN ASM_REWRITE_TAC []] THEN
        MATCH_MP_TAC GALOIS_GROUP_EQ_ON_GENERATORS THEN
        MAP_EVERY EXISTS_TAC
         [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"{ring_0 l:B}"] THEN
        ASM_REWRITE_TAC [s1,
                        IN_SING, FORALL_UNWIND_THM2, I_THM] THEN
        MATCH_MP_TAC RING_HOMOMORPHISM_0 THEN
        MATCH_MP_TAC GALOIS_GROUP_RING_HOMOMORPHISM THEN
        MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN ASM_REWRITE_TAC [],
        ASM_SIMP_TAC [TRIVIAL_IMP_CYCLIC_GROUP] THEN
        FIRST_X_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE I [trivial_group]) THEN
        REWRITE_TAC [CARD_SING, DIVIDES_1]],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"S = {x | (?c. c IN ring_carrier k /\ ring_pow k c n = ring_1 k /\
                    x = (h:A->B) c) /\
               ?f. f IN group_carrier(galois_group(k,l) h) /\
                   f a = ring_mul l x a}") THEN
    SUBGOAL_THEN
     (← q r"!x. x IN S
          ==> x IN ring_carrier l /\ ring_pow l x n = ring_1 l /\
              !f. f IN group_carrier(galois_group(k,l) (h:A->B)) ==> f x = x")
    (LABEL_TAC "Sprop") THENL
     [EXPAND_TAC "S" THEN REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:B") THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"c:A") (CONJUNCTS_THEN2 ASSUME_TAC
         (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)))
       (K ALL_TAC : thm → tactic)) THEN
      ASM_SIMP_TAC [← GSYM (← MATCH_MP RING_HOMOMORPHISM_POW
        (← ASSUME (← q r"ring_homomorphism(k,l) (h:A->B)")))] THEN
      REWRITE_TAC [← MATCH_MP RING_HOMOMORPHISM_1
        (← ASSUME (← q r"ring_homomorphism(k,l) (h:A->B)"))] THEN
      X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"c:A"]
        GALOIS_GROUP_FIXES) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_multsys l (S:B->bool)") ASSUME_TAC THENL
     [REWRITE_TAC [ring_multsys] THEN REPEAT CONJ_TAC THENL
       [ASM_SIMP_TAC [SUBSET],
        EXPAND_TAC "S" THEN REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
         [EXISTS_TAC (← q r"ring_1 k:A") THEN
          REWRITE_TAC [RING_1, RING_POW_ONE, ← MATCH_MP RING_HOMOMORPHISM_1
            (← ASSUME (← q r"ring_homomorphism(k,l) (h:A->B)"))],
          EXISTS_TAC (← q r"I:B->B") THEN ASM_SIMP_TAC [I_THM, RING_MUL_LID]],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"y:B"] THEN
      EXPAND_TAC "S" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"c:A") STRIP_ASSUME_TAC)
                        (X_CHOOSE_THEN (← q r"f:B->B") STRIP_ASSUME_TAC))
       (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"d:A") STRIP_ASSUME_TAC)
                        (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC))) THEN
      CONJ_TAC THENL
       [EXISTS_TAC (← q r"ring_mul k c d:A") THEN
        ASM_SIMP_TAC [RING_MUL, RING_MUL_POW, RING_MUL_LID, RING_1] THEN
        ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL
          (← ASSUME (← q r"ring_homomorphism(k,l) (h:A->B)"))],
        EXISTS_TAC (← q r"(f:B->B) o (g:B->B)") THEN
        ASM_SIMP_TAC [GALOIS_GROUP_COMPOSE] THEN ASM_REWRITE_TAC [o_THM] THEN
        ASSUME_TAC (← MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM
         (← ASSUME (← q r"(f:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))) THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"d:A"]
          GALOIS_GROUP_FIXES) THEN
        ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL
          (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)"))] THEN
        ASM_SIMP_TAC [RING_MUL_ASSOC] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        MATCH_MP_TAC RING_MUL_SYM THEN ASM_SIMP_TAC []],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"S:B->bool"] FINITE_RING_MULTSYS_CYCLIC) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{x:B | x IN ring_carrier l /\ ring_pow l x n = ring_1 l}") THEN
        ASM_SIMP_TAC [ROOTS_OF_UNITY_BOUND, LE_1] THEN
        ASM_SIMP_TAC [SUBSET, IN_ELIM_THM],
        DISCH_THEN (fun th => USE_THEN "Sprop" (fun sp => tactic_of do
          pure (MP_TAC (← MATCH_MP sp th)))) THEN
        ASM_REWRITE_TAC [RING_POW_ZERO] THEN
        ASM_MESON_TAC [FIELD_NONTRIVIAL]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:B")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "gen")))] THEN
    SUBGOAL_THEN
     (← q r"?f0. f0 IN group_carrier(galois_group(k,l) (h:A->B)) /\
           f0 a = ring_mul l w a")
    STRIP_ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"(w:B) IN S") THEN EXPAND_TAC "S" THEN
      REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!m. group_pow (galois_group(k,l) (h:A->B)) f0 m IN
          group_carrier(galois_group(k,l) h) /\
          group_pow (galois_group(k,l) h) f0 m a =
          ring_mul l (ring_pow l w m) a")
    (LABEL_TAC "pow") THENL
     [GEN_TAC THEN CONJ_TAC THENL
       [MATCH_MP_TAC GROUP_POW THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC GALOIS_GROUP_POW_MUL_FIXED THEN ASM_REWRITE_TAC [] THEN
      USE_THEN "Sprop" (fun th => tactic_of do
        pure (MP_TAC (← MATCH_MP th (← ASSUME (← q r"(w:B) IN S"))))) THEN
      STRIP_TAC THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!f g. f IN group_carrier(galois_group(k,l) (h:A->B)) /\
            g IN group_carrier(galois_group(k,l) h) /\ f a = g a
            ==> f = g")
    (LABEL_TAC "inj") THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC GALOIS_GROUP_EQ_ON_GENERATORS THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"{a:B}"] THEN
      ASM_REWRITE_TAC [s2, IN_SING,
                      FORALL_UNWIND_THM2],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!f. f IN group_carrier(galois_group(k,l) (h:A->B))
          ==> ?m. f = group_pow (galois_group(k,l) h) f0 m")
    (LABEL_TAC "every") THENL
     [X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      USE_THEN "roots" (fun th => tactic_of do
        pure (MP_TAC (← MATCH_MP th
         (← ASSUME (← q r"(f:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:A") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(h:A->B) c IN S") ASSUME_TAC THENL
       [EXPAND_TAC "S" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        CONJ_TAC THENL
         [EXISTS_TAC (← q r"c:A") THEN ASM_REWRITE_TAC [],
          EXISTS_TAC (← q r"f:B->B") THEN ASM_REWRITE_TAC []],
        ALL_TAC] THEN
      USE_THEN "gen" (fun th => tactic_of do
        pure (MP_TAC (← MATCH_MP th (← ASSUME (← q r"(h:A->B) c IN S"))))) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
      USE_THEN "inj" MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"subgroup_generated (galois_group(k,l) (h:A->B)) {f0} =
      galois_group(k,l) h")
    ASSUME_TAC THENL
     [REWRITE_TAC [SUBGROUP_GENERATED_EQ] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
      REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET] THEN
      REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      USE_THEN "every" (fun th => tactic_of do
        pure (X_CHOOSE_THEN (← q r"m:num") SUBST1_TAC (← MATCH_MP th
          (← ASSUME (← q r"(f:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))))) THEN
      MATCH_MP_TAC IN_SUBGROUP_POW THEN
      REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
      MATCH_MP_TAC SUBGROUP_GENERATED_INC_GEN THEN
      ASM_REWRITE_TAC [IN_SING],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"group_pow (galois_group(k,l) (h:A->B)) f0 n =
      group_id(galois_group(k,l) h)")
    ASSUME_TAC THENL
     [REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)] THEN
      USE_THEN "inj" MATCH_MP_TAC THEN ASM_REWRITE_TAC [I_THM] THEN
      USE_THEN "Sprop" (fun th => tactic_of do
        pure (MP_TAC (← MATCH_MP th (← ASSUME (← q r"(w:B) IN S"))))) THEN
      SIMP_TAC [RING_MUL_LID, ← ASSUME (← q r"(a:B) IN ring_carrier l")],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [cyclic_group] THEN EXISTS_TAC (← q r"f0:B->B") THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"f0:B->B"]
      CARD_CYCLIC_SUBGROUP_ORDER) THEN
    MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"f0:B->B"]
      FINITE_CYCLIC_SUBGROUP) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
    ANTS_TAC THENL
     [EXISTS_TAC (← q r"n:num") THEN ASM_REWRITE_TAC [], DISCH_THEN SUBST1_TAC] THEN
    MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"f0:B->B", ← q r"n:num"]
      GROUP_POW_EQ_ID) THEN
    ASM_REWRITE_TAC []))

  let KUMMER_EXTENSION_CYCLIC ← prove
   r"!(h:A->B) k l a n.
        field_extension(k,l) h /\
        {x | x IN ring_carrier k /\ ring_pow k x n = ring_1 k} HAS_SIZE n /\
        a IN ring_carrier l /\ ring_pow l a n IN IMAGE h (ring_carrier k) /\
        subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l
        ==> cyclic_group(galois_group(k,l) h) /\
            CARD(group_carrier(galois_group(k,l) h)) divides n"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CYCLIC_GALOIS_GROUP_RADICAL THEN EXISTS_TAC (← q r"a:B") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [ROOTS_OF_UNITY_HAS_SIZE_NONZERO],
      REPEAT STRIP_TAC THEN MATCH_MP_TAC GALOIS_GROUP_KUMMER_ROOT_OF_UNITY THEN
      ASM_REWRITE_TAC []])

  let KUMMER_EXTENSION_CYCLIC_INTERMEDIATE ← prove
   r"!(l:B ring) s a n.
        field l /\ s subfield_of l /\
        {x | x IN s /\ ring_pow l x n = ring_1 l} HAS_SIZE n /\
        a IN ring_carrier l /\ ring_pow l a n IN s
        ==> cyclic_group
             (galois_group
               (subfield_generated l s,subfield_generated l (a INSERT s)) I) /\
            CARD(group_carrier
                  (galois_group
                    (subfield_generated l s,subfield_generated l (a INSERT s))
                    I)) divides n"
   (← do
    let sg2 ← match (CONJUNCTS SUBFIELD_GENERATED)[2]? with
      | some c => pure c
      | none => throw "el"
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC KUMMER_EXTENSION_CYCLIC THEN
    EXISTS_TAC (← q r"a:B") THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, IMAGE_I,
                 SUBFIELD_GENERATED_IDEMPOT, RING_POW_SUBFIELD_GENERATED,
                 sg2,
                 SUBFIELD_GENERATED_INC_GEN, IN_INSERT] THEN
    MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED, IMAGE_I,
                 CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
    SET_TAC []))

  -- @@RETURN BEGIN
  return { GALOIS_GROUP_KUMMER_ROOT_OF_UNITY, GALOIS_GROUP_POW_MUL_FIXED,
           GALOIS_GROUP_POW_ADD_FIXED, CYCLIC_GALOIS_GROUP_RADICAL,
           KUMMER_EXTENSION_CYCLIC, KUMMER_EXTENSION_CYCLIC_INTERMEDIATE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Kummer theory: if k has n distinct n-th roots of unity, every cyclic      -/
/- Galois extension of degree n is generated by an n-th root of an element   -/
/- of k. For a generator g of the Galois group and a root of unity z of      -/
/- order n in k, the norm of the inverse of h(z) is 1, so by Hilbert 90 it   -/
/- is y / g(y) for some nonzero y; then g(y) = h(z) y and g^j(y) = h(z)^j y, -/
/- so only the identity in the Galois group fixes y, which therefore         -/
/- generates l, and y^n is fixed by g, so it lies in the image of k.         -/
/- Together with KUMMER_EXTENSION_CYCLIC: the extensions generated by an     -/
/- n-th root of an element of k are exactly the finite cyclic Galois         -/
/- extensions of degree dividing n.                                          -/
/- ------------------------------------------------------------------------- -/

structure KummerTheory where
  -- @@FIELDS
  KUMMER_CYCLIC_EXTENSION : thm
  KUMMER_CYCLIC_EXTENSION_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupKummerTheory [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BFixedFields : FixedFields) (BGaloisLattice : GaloisLattice) (BHilbert90Cyclic : Hilbert90Cyclic) (BCyclotomicKummer : CyclotomicKummer) (BKummerCyclic : KummerCyclic) :
    ExceptT String IO KummerTheory := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, RING_RULE, .. } := D
  let { EQ_TRANS, FIELD_HOMOMORPHISM_INV, FIELD_IMP_INTEGRAL_DOMAIN, FIELD_MUL_LINV,
        FIELD_MUL_RINV, FIELD_NONTRIVIAL, FINITE_IMP_FIELD_EXTENSION,
        FORALL_UNWIND_THM2, .. } := D.core1
  let { INTEGRAL_DOMAIN_MUL_EQ_SELF, IN_IMAGE, IN_SING, MONO_EXISTS,
        PERMUTES_INJECTIVE, .. } := D.core2
  let { RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_POW,
        RING_INV, RING_INV_1, RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL_LID,
        RING_MUL_POW, RING_ORDER_0, RING_ORDER_MONOMORPHIC_IMAGE, RING_POW,
        RING_POW_EQ_1, RING_POW_INV, RING_POW_POW, RING_POW_RING_ORDER,
        RING_PRODUCT_CONST, RING_PRODUCT_EQ, .. } := D.core3
  let { ROOTS_OF_UNITY_HAS_SIZE_DIVISOR, ROOTS_OF_UNITY_HAS_SIZE_NONZERO,
        ROOTS_OF_UNITY_HAS_SIZE_PRIMITIVE, SING_SUBSET, TRIVIAL_RING_10, cyclic_group,
        divides, field_extension, ring_div, .. } := D.core4
  let { GALOIS_GROUP_FIXES, GALOIS_GROUP_PERMUTES, GALOIS_GROUP_RING_HOMOMORPHISM, .. } := BGaloisGroup
  let { CARD_GALOIS_GROUP_LE, .. } := BGaloisExtensions
  let { IN_FIXED_FIELD, .. } := BFixedFields
  let { FIXED_FIELD_GALOIS_GROUP_GENERATORS, GALOIS_EXTENSION_SIMPLE_CYCLIC_EQ, .. } := BGaloisLattice
  let { HILBERT_90_CYCLIC, .. } := BHilbert90Cyclic
  let { KUMMER_EXTENSION_ABELIAN, .. } := BCyclotomicKummer
  let { GALOIS_GROUP_POW_MUL_FIXED, KUMMER_EXTENSION_CYCLIC, .. } := BKummerCyclic
  -- @@SCOPE END

  let KUMMER_CYCLIC_EXTENSION ← prove
   r"!(h:A->B) k l n.
        finite_extension(k,l) h /\ galois_extension(k,l) h /\
        cyclic_group(galois_group(k,l) h) /\
        CARD(group_carrier(galois_group(k,l) h)) = n /\
        {x | x IN ring_carrier k /\ ring_pow k x n = ring_1 k} HAS_SIZE n
        ==> ?a. a IN ring_carrier l /\
                ring_pow l a n IN IMAGE h (ring_carrier k) /\
                subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l"
   (← do
    let r1 ← RING_RULE
     (← q r"!r u v w x y:A.
          u IN ring_carrier r /\ v IN ring_carrier r /\ w IN ring_carrier r /\
          x IN ring_carrier r /\ y IN ring_carrier r /\
          ring_mul r u v = ring_1 r /\ ring_mul r w x = ring_1 r /\
          v = ring_mul r y w
          ==> x = ring_mul r u y")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o MATCH_MP CARD_GALOIS_GROUP_LE) THEN
    SUBGOAL_THEN (← q r"~(n = 0)") ASSUME_TAC THENL
     [ASM_MESON_TAC [ROOTS_OF_UNITY_HAS_SIZE_NONZERO],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"n:num"] ROOTS_OF_UNITY_HAS_SIZE_PRIMITIVE) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:A") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"(h:A->B) z IN ring_carrier l /\ ring_order l (h z) = n")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
        EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
        ASM_MESON_TAC [RING_ORDER_MONOMORPHIC_IMAGE]],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"u = (h:A->B) z") THEN
    SUBGOAL_THEN (← q r"ring_pow l (u:B) n = ring_1 l /\ ~(u = ring_0 l)")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"l:B ring", ← q r"u:B"] RING_POW_RING_ORDER) THEN
        ASM_REWRITE_TAC [],
        DISCH_TAC THEN UNDISCH_TAC (← q r"~(n = 0)") THEN
        UNDISCH_TAC (← q r"ring_order l (u:B) = n") THEN
        ASM_SIMP_TAC [RING_ORDER_0, TRIVIAL_RING_10, FIELD_NONTRIVIAL]],
      ALL_TAC] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE I [cyclic_group]) THEN
    ASSUME_TAC (← MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM
     (← ASSUME (← q r"(g:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))) THEN
    ASSUME_TAC (← MATCH_MP GALOIS_GROUP_PERMUTES
     (← ASSUME (← q r"(g:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"g:B->B",
                   ← q r"ring_inv l u:B"] HILBERT_90_CYCLIC) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [RING_INV] THEN
      TRANS_TAC EQ_TRANS
       (← q r"ring_product l (group_carrier(galois_group(k,l) (h:A->B)))
                       (\f. ring_inv l u)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC RING_PRODUCT_EQ THEN X_GEN_TAC (← q r"f:B->B") THEN
        DISCH_TAC THEN REWRITE_TAC [] THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"z:A"]
          GALOIS_GROUP_FIXES) THEN
        MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"f:B->B"]
          FIELD_HOMOMORPHISM_INV) THEN
        ASM_SIMP_TAC [← MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM
         (← ASSUME (← q r"(f:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))],
        ASM_SIMP_TAC [RING_PRODUCT_CONST, RING_INV, RING_POW_INV, RING_INV_1]],
      REWRITE_TAC [ring_div] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:B") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN (← q r"(g:B->B) y IN ring_carrier l /\ ~((g:B->B) y = ring_0 l)")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
        EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
        SUBST1_TAC (← SYM (← MATCH_MP RING_HOMOMORPHISM_0
         (← ASSUME (← q r"ring_homomorphism(l,l) (g:B->B)")))) THEN
        ASM_MESON_TAC [PERMUTES_INJECTIVE]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(g:B->B) y = ring_mul l u y") ASSUME_TAC THENL
     [MATCH_MP_TAC r1 THEN
      MAP_EVERY EXISTS_TAC [← q r"ring_inv l u:B", ← q r"ring_inv l ((g:B->B) y)"] THEN
      ASM_SIMP_TAC [RING_INV, FIELD_MUL_RINV, FIELD_MUL_LINV],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"y:B") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"{g:B->B}"]
        FIXED_FIELD_GALOIS_GROUP_GENERATORS) THEN
      ASM_REWRITE_TAC [SING_SUBSET] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [IN_FIXED_FIELD, IN_SING, FORALL_UNWIND_THM2] THEN
      ASM_SIMP_TAC [RING_POW, ← MATCH_MP RING_HOMOMORPHISM_POW
        (← ASSUME (← q r"ring_homomorphism(l,l) (g:B->B)"))] THEN
      ASM_SIMP_TAC [RING_MUL_POW, RING_POW, RING_MUL_LID],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"y:B"]
      GALOIS_EXTENSION_SIMPLE_CYCLIC_EQ) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN X_GEN_TAC (← q r"j:num") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"z:A"]
      GALOIS_GROUP_FIXES) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"y:B", ← q r"u:B",
                   ← q r"j:num"] GALOIS_GROUP_POW_MUL_FIXED) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_MUL_EQ_SELF, FIELD_IMP_INTEGRAL_DOMAIN,
                 RING_POW, RING_POW_EQ_1]))

  let KUMMER_CYCLIC_EXTENSION_EQ ← prove
   r"!(h:A->B) k l n.
        field_extension(k,l) h /\
        {x | x IN ring_carrier k /\ ring_pow k x n = ring_1 k} HAS_SIZE n
        ==> (finite_extension(k,l) h /\ galois_extension(k,l) h /\
             cyclic_group(galois_group(k,l) h) /\
             CARD(group_carrier(galois_group(k,l) h)) divides n <=>
             ?a. a IN ring_carrier l /\
                 ring_pow l a n IN IMAGE h (ring_carrier k) /\
                 subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [STRIP_TAC,
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:B") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B", ← q r"n:num"]
        KUMMER_EXTENSION_ABELIAN) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B", ← q r"n:num"]
        KUMMER_EXTENSION_CYCLIC) THEN
      ASM_SIMP_TAC []] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"CARD(group_carrier(galois_group(k,l) (h:A->B)))"]
      KUMMER_CYCLIC_EXTENSION) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC ROOTS_OF_UNITY_HAS_SIZE_DIVISOR THEN
      EXISTS_TAC (← q r"n:num") THEN ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:B") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC
     (← q r"CARD(group_carrier(galois_group(k,l) (h:A->B))) divides n") THEN
    REWRITE_TAC [divides] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") SUBST1_TAC) THEN
    ASM_SIMP_TAC [← GSYM RING_POW_POW] THEN
    UNDISCH_TAC
     (← q r"ring_pow l (a:B) (CARD(group_carrier(galois_group(k,l) (h:A->B)))) IN
      IMAGE h (ring_carrier k)") THEN
    REWRITE_TAC [IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:A") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"ring_pow k (c:A) m") THEN ASM_SIMP_TAC [RING_POW] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RING_HOMOMORPHISM_POW o
      MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    ASM_SIMP_TAC [])

  -- @@RETURN BEGIN
  return { KUMMER_CYCLIC_EXTENSION, KUMMER_CYCLIC_EXTENSION_EQ }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Artin-Schreier extensions. In characteristic p, adjoining a root a of     -/
/- X^p - X - c with c in k gives a finite Galois extension, since the roots  -/
/- of X^p - X - c are the p distinct elements a + j, j in the prime field.   -/
/- The Galois group moves a by elements of the prime field, so               -/
/- f |-> f(a) - a embeds it in the prime field, and an element that moves a  -/
/- has order p: the Galois group is cyclic of order 1 or p, and of order p   -/
/- when a is not in the image of k. Conversely a cyclic Galois extension of  -/
/- degree p is generated by such a root: the trace of -1 is -p = 0, so by    -/
/- the additive form of Hilbert 90 there is y with g(y) = y + 1 for a        -/
/- generator g, and then y^p - y is fixed by g. Hence, as in the Kummer      -/
/- case, the extensions generated by a root of some X^p - X - c are exactly  -/
/- the finite cyclic Galois extensions of degree dividing p.                 -/
/- ------------------------------------------------------------------------- -/

structure ArtinSchreier where
  -- @@FIELDS
  GALOIS_EXTENSION_ARTIN_SCHREIER : thm
  GALOIS_GROUP_ARTIN_SCHREIER : thm
  deriving Inhabited

@[nospecialize]
def setupArtinSchreier [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BCyclotomicKummer : CyclotomicKummer) :
    ExceptT String IO ArtinSchreier := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, RING_RULE, SET_RULE, .. } := D
  let { CONG_IMP_EQ, EXTENSION, FIELD_IMP_INTEGRAL_DOMAIN, FIELD_NONTRIVIAL,
        FORALL_IN_IMAGE, FROBENIUS_FIXED, .. } := D.core1
  let { HAS_SIZE_IMAGE_INJ, HAS_SIZE_NUMSEG_LT, IN_ELIM_THM, IN_IMAGE, IN_UNIV, LE_1,
        MONO_EXISTS, POLY_DEG_0, POLY_DEG_SUB_CONST, POLY_EXTEND_CONST,
        POLY_EXTEND_EVALUATE, POLY_EXTEND_SUB, POLY_EXTEND_VAR, POLY_EXTEND_VARPOW, .. } := D.core2
  let { POLY_VAR_POW_SUB_VAR, PRIME_GE_2, PRIME_IMP_NZ, RING_ADD, RING_ADD_LCANCEL,
        RING_ADD_RZERO, RING_CHAR_MONOMORPHIC_IMAGE, RING_ENDOMORPHISM_FROBENIUS,
        RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_POW,
        RING_HOMOMORPHISM_SUB, RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_OF_INT_OF_NUM,
        RING_OF_NUM, RING_OF_NUM_0, RING_OF_NUM_EQ, RING_POLYNOMIAL,
        RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_POW, RING_POLYNOMIAL_SUB,
        RING_POLYNOMIAL_VAR, RING_POW, RING_SUB, .. } := D.core3
  let { SUBFIELD_GENERATED_MONO, SUBFIELD_GENERATED_SUPERSET, SUBSET_REFL,
        SUBSET_TRANS, field_extension, poly_eval, ring_endomorphism, .. } := D.core4
  let { GALOIS_GROUP_FIXES, GALOIS_GROUP_RING_HOMOMORPHISM, .. } := BGaloisGroup
  let { GALOIS_EXTENSION_DISTINCT_ROOTS, .. } := BCyclotomicKummer
  -- @@SCOPE END

  let GALOIS_EXTENSION_ARTIN_SCHREIER ← prove
   r"!(h:A->B) k l a p.
        field_extension(k,l) h /\ prime p /\ ring_char k = p /\
        a IN ring_carrier l /\
        ring_sub l (ring_pow l a p) a IN IMAGE h (ring_carrier k) /\
        subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l
        ==> finite_extension(k,l) h /\ galois_extension(k,l) h"
   (← do
    -- right to left: the SET_RULE, then the RING_RULE
    let s1 ← SET_RULE (← q r"(a:B) IN s ==> a INSERT t SUBSET t UNION s")
    let r1 ← RING_RULE
     (← q r"!r a b q:A. a IN ring_carrier r /\ b IN ring_carrier r /\
                    q IN ring_carrier r
                    ==> ring_sub r (ring_sub r (ring_add r q b) (ring_add r a b))
                                   (ring_sub r q a) = ring_0 r")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"ring_char(l:B ring) = p") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE], ALL_TAC] THEN
    UNDISCH_TAC
     (← q r"ring_sub l (ring_pow l a p) a IN IMAGE (h:A->B) (ring_carrier k)") THEN
    REWRITE_TAC [IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:A") (STRIP_ASSUME_TAC o GSYM)) THEN
    ABBREV_TAC
     (← q r"q = poly_sub k (poly_sub k (poly_pow k (poly_var k one) p)
                                 (poly_var k one))
                     (poly_const k c):(1->num)->A") THEN
    SUBGOAL_THEN
     (← q r"(q:(1->num)->A) IN ring_carrier(poly_ring k (:1)) /\ poly_deg k q = p")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"p:num"] POLY_VAR_POW_SUB_VAR) THEN
      ASM_SIMP_TAC [FIELD_NONTRIVIAL, PRIME_GE_2] THEN
      REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN STRIP_TAC THEN
      EXPAND_TAC "q" THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_CONST,
                   POLY_DEG_SUB_CONST],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(q:(1->num)->A = poly_0 k)") ASSUME_TAC THENL
     [DISCH_THEN (MP_TAC o AP_TERM (← q r"poly_deg (k:A ring):((1->num)->A)->num")) THEN
      ASM_REWRITE_TAC [POLY_DEG_0] THEN ASM_SIMP_TAC [PRIME_IMP_NZ],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN ring_carrier l
          ==> poly_eval l ((h:A->B) o q) x =
              ring_sub l (ring_sub l (ring_pow l x p) x) (h c)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN EXPAND_TAC "q" THEN REWRITE_TAC [poly_eval] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP POLY_EXTEND_EVALUATE th)])) THEN
      ASM_SIMP_TAC [POLY_EXTEND_SUB, POLY_EXTEND_VARPOW, POLY_EXTEND_VAR,
                   POLY_EXTEND_CONST, RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR,
                   RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_CONST],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"s = IMAGE (\j. ring_add l (a:B) (ring_of_num l j)) {j | j < p}") THEN
    SUBGOAL_THEN (← q r"(s:B->bool) HAS_SIZE poly_deg k (q:(1->num)->A)")
    ASSUME_TAC THENL
     [ASM_REWRITE_TAC [] THEN EXPAND_TAC "s" THEN
      MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN REWRITE_TAC [HAS_SIZE_NUMSEG_LT] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN
      ASM_SIMP_TAC [RING_ADD_LCANCEL, RING_OF_NUM, RING_OF_NUM_EQ] THEN
      MESON_TAC [CONG_IMP_EQ],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x:B. x IN s
            ==> x IN ring_carrier l /\
                poly_eval l ((h:A->B) o q) x = ring_0 l")
    ASSUME_TAC THENL
     [EXPAND_TAC "s" THEN REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [RING_ADD, RING_OF_NUM] THEN
      SUBGOAL_THEN
       (← q r"ring_pow l (ring_of_num l j) p = ring_of_num (l:B ring) j")
      ASSUME_TAC THENL
       [MP_TAC (← ISPEC (← q r"l:B ring") FROBENIUS_FIXED) THEN
        ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"ring_of_num l j:B") o
          REWRITE_RULE [EXTENSION]) THEN
        REWRITE_TAC [IN_ELIM_THM, RING_OF_NUM] THEN
        DISCH_THEN SUBST1_TAC THEN EXISTS_TAC (← q r"&j:int") THEN
        REWRITE_TAC [IN_UNIV, RING_OF_INT_OF_NUM],
        ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"l:B ring") RING_ENDOMORPHISM_FROBENIUS) THEN
      ASM_REWRITE_TAC [ring_endomorphism] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"a:B", ← q r"ring_of_num l j:B"] o
        MATCH_MP RING_HOMOMORPHISM_ADD) THEN
      ASM_SIMP_TAC [RING_OF_NUM] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC r1 THEN
      ASM_SIMP_TAC [RING_POW, RING_OF_NUM],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"subfield_generated l (IMAGE (h:A->B) (ring_carrier k) UNION s) = l")
    ASSUME_TAC THENL
     [REWRITE_TAC [SUBFIELD_GENERATED_SUPERSET] THEN
      TRANS_TAC SUBSET_TRANS
       (← q r"ring_carrier(subfield_generated l
          ((a:B) INSERT IMAGE (h:A->B) (ring_carrier k)))") THEN
      CONJ_TAC THENL
       [ASM_REWRITE_TAC [SUBSET_REFL],
        MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN
        MATCH_MP_TAC s1 THEN
        EXPAND_TAC "s" THEN REWRITE_TAC [IN_IMAGE, IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"0") THEN
        ASM_SIMP_TAC [RING_OF_NUM_0, RING_ADD_RZERO, PRIME_IMP_NZ, LE_1]],
      ALL_TAC] THEN
    MATCH_MP_TAC GALOIS_EXTENSION_DISTINCT_ROOTS THEN
    MAP_EVERY EXISTS_TAC [← q r"q:(1->num)->A", ← q r"s:B->bool"] THEN
    ASM_REWRITE_TAC []))

  let GALOIS_GROUP_ARTIN_SCHREIER ← prove
   r"!(h:A->B) f k l a p.
        field_extension(k,l) h /\ prime p /\ ring_char k = p /\
        a IN ring_carrier l /\
        ring_sub l (ring_pow l a p) a IN IMAGE h (ring_carrier k) /\
        f IN group_carrier(galois_group(k,l) h)
        ==> ?n. f a = ring_add l a (ring_of_int l n)"
   (← do
    -- right to left: the second RING_RULE, then the first
    let r2 ← RING_RULE
     (← q r"!r x y:A. x IN ring_carrier r /\ y IN ring_carrier r
                  ==> x = ring_add r y (ring_sub r x y)")
    let r1 ← RING_RULE
     (← q r"!r x y u v:A. x IN ring_carrier r /\ y IN ring_carrier r /\
                      u IN ring_carrier r /\ v IN ring_carrier r /\
                      ring_sub r u x = ring_sub r v y
                      ==> ring_sub r u v = ring_sub r x y")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN (← q r"ring_char(l:B ring) = p") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE], ALL_TAC] THEN
    ASSUME_TAC (← MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM
     (← ASSUME (← q r"(f:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))) THEN
    SUBGOAL_THEN (← q r"(f:B->B) a IN ring_carrier l") ASSUME_TAC THENL
     [MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
      EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_sub l (ring_pow l ((f:B->B) a) p) (f a) =
      ring_sub l (ring_pow l a p) a")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [RING_POW, ← GSYM (← MATCH_MP RING_HOMOMORPHISM_POW
        (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)")))] THEN
      ASM_SIMP_TAC [RING_POW, ← GSYM (← MATCH_MP RING_HOMOMORPHISM_SUB
        (← ASSUME (← q r"ring_homomorphism(l,l) (f:B->B)")))] THEN
      UNDISCH_TAC
       (← q r"ring_sub l (ring_pow l a p) a IN IMAGE (h:A->B) (ring_carrier k)") THEN
      REWRITE_TAC [IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:A") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [GALOIS_GROUP_FIXES],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_sub l ((f:B->B) a) a IN {ring_of_int l n | n IN (:int)}")
    MP_TAC THENL
     [MP_TAC (← ISPEC (← q r"l:B ring") FROBENIUS_FIXED) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [IN_ELIM_THM, RING_SUB] THEN
      MP_TAC (← ISPEC (← q r"l:B ring") RING_ENDOMORPHISM_FROBENIUS) THEN
      ASM_REWRITE_TAC [ring_endomorphism] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"(f:B->B) a", ← q r"a:B"] o
        MATCH_MP RING_HOMOMORPHISM_SUB) THEN
      ASM_SIMP_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC r1 THEN
      ASM_SIMP_TAC [RING_POW],
      REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"n:int") THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC r2 THEN
      ASM_REWRITE_TAC []]))

  -- @@RETURN BEGIN
  return { GALOIS_EXTENSION_ARTIN_SCHREIER, GALOIS_GROUP_ARTIN_SCHREIER }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Artin-Schreier extensions, continued: the Galois group of an extension   -/
/- generated by an element moved by translations in the prime field is      -/
/- cyclic of order 1 or p, and the Artin-Schreier extensions are exactly the -/
/- finite cyclic Galois extensions of degree dividing p.                     -/
/- ------------------------------------------------------------------------- -/

structure ArtinSchreier2 where
  -- @@FIELDS
  CYCLIC_GALOIS_GROUP_TRANSLATION : thm
  ARTIN_SCHREIER_CYCLIC : thm
  ARTIN_SCHREIER_EXTENSION : thm
  ARTIN_SCHREIER_EXTENSION_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupArtinSchreier2 [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BFixedFields : FixedFields) (BArtin : Artin) (BGaloisIsomorphic : GaloisIsomorphic) (BGaloisLattice : GaloisLattice) (BHilbert90Cyclic : Hilbert90Cyclic) (BKummerCyclic : KummerCyclic) (BArtinSchreier : ArtinSchreier) :
    ExceptT String IO ArtinSchreier2 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, RING_RULE, SET_RULE, SET_TAC, .. } := D
  let { CARD_EQ_0, CARD_IMAGE_INJ, CARD_SING, CARD_SUBSET, DIVIDES_1, DIVIDES_LE,
        DIVIDES_REFL, EQ_TRANS, FIELD_EXTENSION_IMP_HOMOMORPHISM, FINITE_IMAGE_INJ_EQ,
        FINITE_IMP_FIELD_EXTENSION, FINITE_SUBSET, FORALL_IN_IMAGE, FORALL_UNWIND_THM2,
        GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER, GROUP_ELEMENT_ORDER_UNIQUE_PRIME,
        GROUP_ID, GROUP_POW, .. } := D.core1
  let { HAS_SIZE, HAS_SIZE_PRIME_SUBRING, IN_ELIM_THM, IN_IMAGE, IN_SING, IN_UNIV,
        I_THM, NOT_FORALL_THM, NOT_IMP, .. } := D.core2
  let { PRIME_IMP_NZ, PRIME_ORDER_IMP_CYCLIC_GROUP, RING_0, RING_1, RING_ADD,
        RING_ADD_RZERO, RING_CHAR_MONOMORPHIC_IMAGE, RING_CHAR_UNIQUE,
        RING_ENDOMORPHISM_FROBENIUS, RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1,
        RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_NEG,
        RING_HOMOMORPHISM_POW, RING_HOMOMORPHISM_RING_OF_INT, RING_HOMOMORPHISM_SUB,
        RING_MUL_LZERO, RING_MUL_RID, RING_NEG, RING_OF_INT, RING_OF_NUM,
        RING_OF_NUM_CHAR, RING_POW, RING_POW_ONE, RING_POW_ZERO, RING_SUB,
        RING_SUB_REFL, RING_SUM_CONST, RING_SUM_EQ, .. } := D.core3
  let { SING_SUBSET, SUBSET, TRIVIAL_GROUP_HAS_SIZE_1, cyclic_group, field_extension,
        prime, ring_endomorphism, trivial_group, .. } := D.core4
  let { GALOIS_GROUP, GALOIS_GROUP_RING_HOMOMORPHISM, .. } := BGaloisGroup
  let { CARD_GALOIS_GROUP_LE, .. } := BGaloisExtensions
  let { IN_FIXED_FIELD, .. } := BFixedFields
  let { FIXED_FIELD_GALOIS_GROUP, .. } := BArtin
  let { GALOIS_GROUP_EQ_ON_GENERATORS, .. } := BGaloisIsomorphic
  let { FIXED_FIELD_GALOIS_GROUP_GENERATORS, GALOIS_EXTENSION_SIMPLE_CYCLIC_EQ,
        GALOIS_EXTENSION_SIMPLE_EQ, .. } := BGaloisLattice
  let { HILBERT_90_ADDITIVE_CYCLIC, .. } := BHilbert90Cyclic
  let { GALOIS_GROUP_POW_ADD_FIXED, .. } := BKummerCyclic
  let { GALOIS_EXTENSION_ARTIN_SCHREIER, GALOIS_GROUP_ARTIN_SCHREIER, .. } := BArtinSchreier
  -- @@SCOPE END

  let CYCLIC_GALOIS_GROUP_TRANSLATION ← prove
   r"!(h:A->B) k l a p.
        field_extension(k,l) h /\ prime p /\ ring_char k = p /\
        a IN ring_carrier l /\
        subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l /\
        (!f. f IN group_carrier(galois_group(k,l) h)
             ==> ?n. f a = ring_add l a (ring_of_int l n))
        ==> cyclic_group(galois_group(k,l) h) /\
            CARD(group_carrier(galois_group(k,l) h)) divides p"
   (← do
    -- right to left: the rules in reverse order of appearance
    let r2 ← RING_RULE
     (← q r"!r x y:A. x IN ring_carrier r /\ y IN ring_carrier r
                  ==> ring_sub r (ring_add r x y) x = y")
    let r1 ← RING_RULE
     (← q r"!r x y z:A. x IN ring_carrier r /\ y IN ring_carrier r /\
                    z IN ring_carrier r /\ ring_sub r x z = ring_sub r y z
                    ==> x = y")
    let s1 ← SET_RULE (← q r"(s:B->bool) UNION {a} = a INSERT s")
    pure (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
      (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "trans")))))) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN (← q r"ring_char(l:B ring) = p") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(I:B->B) IN group_carrier(galois_group(k,l) (h:A->B))")
    ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"galois_group(k:A ring,l:B ring) h") GROUP_ID) THEN
      REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!f g. f IN group_carrier(galois_group(k,l) (h:A->B)) /\
            g IN group_carrier(galois_group(k,l) h) /\
            ring_sub l (f a) a = ring_sub l (g a) a
            ==> f = g")
    (LABEL_TAC "inj") THENL
     [MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
      MATCH_MP_TAC GALOIS_GROUP_EQ_ON_GENERATORS THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"{a:B}"] THEN
      ASM_REWRITE_TAC [s1, IN_SING,
                      FORALL_UNWIND_THM2] THEN
      MATCH_MP_TAC r1 THEN
      MAP_EVERY EXISTS_TAC [← q r"l:B ring", ← q r"a:B"] THEN ASM_REWRITE_TAC [] THEN
      USE_THEN "trans" (fun th => tactic_of do
        pure (X_CHOOSE_THEN (← q r"m:int") SUBST1_TAC (← MATCH_MP th (← ASSUME
          (← q r"(f:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))) THEN
        X_CHOOSE_THEN (← q r"n:int") SUBST1_TAC (← MATCH_MP th (← ASSUME
          (← q r"(g:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))))) THEN
      ASM_SIMP_TAC [RING_ADD, RING_OF_INT],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (\f. ring_sub l ((f:B->B) a) a)
            (group_carrier(galois_group(k,l) (h:A->B))) SUBSET
      {ring_of_int l n | n IN (:int)}")
    ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      USE_THEN "trans" (fun th => tactic_of do
        pure (X_CHOOSE_THEN (← q r"n:int") SUBST1_TAC (← MATCH_MP th
         (← ASSUME (← q r"(f:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))))) THEN
      EXISTS_TAC (← q r"n:int") THEN
      MATCH_MP_TAC r2 THEN
      ASM_REWRITE_TAC [RING_OF_INT],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"l:B ring") HAS_SIZE_PRIME_SUBRING) THEN
    ASM_SIMP_TAC [PRIME_IMP_NZ, HAS_SIZE] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"FINITE(group_carrier(galois_group(k,l) (h:A->B))) /\
      CARD(group_carrier(galois_group(k,l) h)) <= p")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"\f. ring_sub l ((f:B->B) a) a",
                     ← q r"group_carrier(galois_group(k,l) (h:A->B))"]
        CARD_IMAGE_INJ) THEN
      MP_TAC (← ISPECL [← q r"\f. ring_sub l ((f:B->B) a) a",
                     ← q r"group_carrier(galois_group(k,l) (h:A->B))"]
        FINITE_IMAGE_INJ_EQ) THEN
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL
       [← q r"IMAGE (\f. ring_sub l ((f:B->B) a) a)
               (group_carrier(galois_group(k,l) (h:A->B)))",
        ← q r"{ring_of_int l n | n IN (:int)}:B->bool"] CARD_SUBSET) THEN
      MP_TAC (← ISPECL
       [← q r"IMAGE (\f. ring_sub l ((f:B->B) a) a)
               (group_carrier(galois_group(k,l) (h:A->B)))",
        ← q r"{ring_of_int l n | n IN (:int)}:B->bool"] FINITE_SUBSET) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"CARD(group_carrier(galois_group(k,l) (h:A->B))) = 1 \/
      CARD(group_carrier(galois_group(k,l) h)) = p")
    MP_TAC THENL
     [ALL_TAC,
      STRIP_TAC THEN ASM_REWRITE_TAC [DIVIDES_1, DIVIDES_REFL] THEN
      MATCH_MP_TAC PRIME_ORDER_IMP_CYCLIC_GROUP THEN ASM_REWRITE_TAC []] THEN
    ASM_CASES_TAC
     (← q r"!f. f IN group_carrier(galois_group(k,l) (h:A->B)) ==> f = I")
    THENL
     [DISJ1_TAC THEN
      SUBGOAL_THEN (← q r"group_carrier(galois_group(k,l) (h:A->B)) = {I}")
      SUBST1_TAC THENL [ASM SET_TAC [], REWRITE_TAC [CARD_SING]],
      DISJ2_TAC] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"f0:B->B") STRIP_ASSUME_TAC o
      REWRITE_RULE [NOT_FORALL_THM, NOT_IMP]) THEN
    USE_THEN "trans" (fun th => tactic_of do
      pure (X_CHOOSE_TAC (← q r"n0:int") (← MATCH_MP th
       (← ASSUME (← q r"(f0:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))))) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f0:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B",
                   ← q r"ring_of_int l n0:B", ← q r"p:num"] GALOIS_GROUP_POW_ADD_FIXED) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [RING_OF_INT, ← MATCH_MP RING_HOMOMORPHISM_RING_OF_INT
       (← MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM
         (← ASSUME (← q r"(f0:B->B) IN group_carrier(galois_group(k,l) (h:A->B))")))],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_of_num l p = ring_0(l:B ring)") SUBST1_TAC THENL
     [UNDISCH_TAC (← q r"ring_char(l:B ring) = p") THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [RING_OF_NUM_CHAR],
      ALL_TAC] THEN
    SIMP_TAC [RING_MUL_LZERO, RING_OF_INT, RING_ADD_RZERO,
             ← ASSUME (← q r"(a:B) IN ring_carrier l")] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"group_element_order (galois_group(k,l) (h:A->B)) f0 = p")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"f0:B->B", ← q r"p:num"]
        GROUP_ELEMENT_ORDER_UNIQUE_PRIME) THEN
      ASM_REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)] THEN
      DISCH_THEN SUBST1_TAC THEN
      REMOVE_THEN "inj" MATCH_MP_TAC THEN ASM_SIMP_TAC [GROUP_POW, I_THM],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(CARD(group_carrier(galois_group(k,l) (h:A->B))) = 0)")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [CARD_EQ_0] THEN ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"f0:B->B"]
      GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o MATCH_MP DIVIDES_LE) THEN ASM_ARITH_TAC))

  let ARTIN_SCHREIER_CYCLIC ← prove
   r"!(h:A->B) k l a p.
        field_extension(k,l) h /\ prime p /\ ring_char k = p /\
        a IN ring_carrier l /\ ~(a IN IMAGE h (ring_carrier k)) /\
        ring_sub l (ring_pow l a p) a IN IMAGE h (ring_carrier k) /\
        subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l
        ==> finite_extension(k,l) h /\ galois_extension(k,l) h /\
            cyclic_group(galois_group(k,l) h) /\
            CARD(group_carrier(galois_group(k,l) h)) = p"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B", ← q r"p:num"]
      GALOIS_EXTENSION_ARTIN_SCHREIER) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP CARD_GALOIS_GROUP_LE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B", ← q r"p:num"]
      CYCLIC_GALOIS_GROUP_TRANSLATION) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B", ← q r"p:num"]
        GALOIS_GROUP_ARTIN_SCHREIER) THEN
      ASM_REWRITE_TAC [],
      STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
    SUBGOAL_THEN (← q r"~(CARD(group_carrier(galois_group(k,l) (h:A->B))) = 1)")
    MP_TAC THENL
     [DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"galois_group(k:A ring,l:B ring) h")
        TRIVIAL_GROUP_HAS_SIZE_1) THEN
      ASM_REWRITE_TAC [trivial_group, ← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP),
                      HAS_SIZE] THEN
      DISCH_TAC THEN
      UNDISCH_TAC (← q r"~((a:B) IN IMAGE (h:A->B) (ring_carrier k))") THEN
      REWRITE_TAC [] THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP FIXED_FIELD_GALOIS_GROUP) THEN
      ASM_REWRITE_TAC [IN_FIXED_FIELD, IN_SING, FORALL_UNWIND_THM2, I_THM],
      UNDISCH_TAC
       (← q r"CARD(group_carrier(galois_group(k,l) (h:A->B))) divides p") THEN
      UNDISCH_TAC (← q r"prime p") THEN REWRITE_TAC [prime] THEN MESON_TAC []])

  let ARTIN_SCHREIER_EXTENSION ← prove
   r"!(h:A->B) k l p.
        finite_extension(k,l) h /\ galois_extension(k,l) h /\
        prime p /\ ring_char k = p /\
        CARD(group_carrier(galois_group(k,l) h)) = p
        ==> ?a. a IN ring_carrier l /\
                ring_sub l (ring_pow l a p) a IN IMAGE h (ring_carrier k) /\
                subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l"
   (← do
    -- right to left: the rules in reverse order of appearance
    let r3 ← RING_RULE
     (← q r"!r y c:A. y IN ring_carrier r /\ c IN ring_carrier r
                  ==> (ring_add r y c = y <=> c = ring_0 r)")
    let r2 ← RING_RULE
     (← q r"!r y q:A. y IN ring_carrier r /\ q IN ring_carrier r
                  ==> ring_sub r (ring_add r q (ring_1 r))
                                 (ring_add r y (ring_1 r)) =
                      ring_sub r q y")
    let r1 ← RING_RULE
     (← q r"!r x y:A. x IN ring_carrier r /\ y IN ring_carrier r /\
                  ring_neg r (ring_1 r) = ring_sub r y x
                  ==> x = ring_add r y (ring_1 r)")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o MATCH_MP CARD_GALOIS_GROUP_LE) THEN
    SUBGOAL_THEN (← q r"ring_char(l:B ring) = p") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"galois_group(k:A ring,l:B ring) h")
      PRIME_ORDER_IMP_CYCLIC_GROUP) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE I [cyclic_group]) THEN
    ASSUME_TAC (← MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM
     (← ASSUME (← q r"(g:B->B) IN group_carrier(galois_group(k,l) (h:A->B))"))) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"g:B->B",
                   ← q r"ring_neg l (ring_1 l):B"] HILBERT_90_ADDITIVE_CYCLIC) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [RING_NEG, RING_1] THEN
      TRANS_TAC EQ_TRANS
       (← q r"ring_sum l (group_carrier(galois_group(k,l) (h:A->B)))
                   (\f. ring_neg l (ring_1 l))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"f:B->B") THEN
        DISCH_THEN (MP_TAC o MATCH_MP GALOIS_GROUP_RING_HOMOMORPHISM) THEN
        DISCH_THEN (fun th => tactic_of do
          pure (SIMP_TAC [RING_1, ← MATCH_MP RING_HOMOMORPHISM_NEG th,
                          ← MATCH_MP RING_HOMOMORPHISM_1 th])),
        ASM_SIMP_TAC [RING_SUM_CONST, RING_NEG, RING_1] THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          let c ← q r"ring_char(l:B ring)"
          if !((← liftExcept (lhand (concl th))) == c) then throw "check"
          pure ((SUBST1_TAC o SYM) th)) THEN
        SIMP_TAC [RING_OF_NUM_CHAR, RING_MUL_LZERO, RING_NEG, RING_1]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:B") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN (← q r"(g:B->B) y = ring_add l y (ring_1 l)") ASSUME_TAC THENL
     [MATCH_MP_TAC r1 THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
      EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"y:B") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"{g:B->B}"]
        FIXED_FIELD_GALOIS_GROUP_GENERATORS) THEN
      ASM_REWRITE_TAC [SING_SUBSET] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [IN_FIXED_FIELD, IN_SING, FORALL_UNWIND_THM2] THEN
      ASM_SIMP_TAC [RING_POW, RING_SUB] THEN
      ASM_SIMP_TAC [RING_POW, ← MATCH_MP RING_HOMOMORPHISM_SUB
        (← ASSUME (← q r"ring_homomorphism(l,l) (g:B->B)"))] THEN
      ASM_SIMP_TAC [RING_POW, ← MATCH_MP RING_HOMOMORPHISM_POW
        (← ASSUME (← q r"ring_homomorphism(l,l) (g:B->B)"))] THEN
      MP_TAC (← ISPEC (← q r"l:B ring") RING_ENDOMORPHISM_FROBENIUS) THEN
      ASM_REWRITE_TAC [ring_endomorphism] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"y:B", ← q r"ring_1 l:B"] o
        MATCH_MP RING_HOMOMORPHISM_ADD) THEN
      ASM_SIMP_TAC [RING_1, RING_POW_ONE] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC r2 THEN
      ASM_SIMP_TAC [RING_POW],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"y:B"]
      GALOIS_EXTENSION_SIMPLE_CYCLIC_EQ) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN X_GEN_TAC (← q r"j:num") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"y:B",
                   ← q r"ring_1 l:B", ← q r"j:num"] GALOIS_GROUP_POW_ADD_FIXED) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [RING_1, ← MATCH_MP RING_HOMOMORPHISM_1
        (← ASSUME (← q r"ring_homomorphism(l,l) (g:B->B)"))],
      DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [RING_MUL_RID, RING_OF_NUM] THEN
    SUBGOAL_THEN
     (← q r"ring_add l (y:B) (ring_of_num l j) = y <=> ring_of_num l j = ring_0 l")
    SUBST1_TAC THENL
     [MATCH_MP_TAC r3 THEN
      ASM_REWRITE_TAC [RING_OF_NUM],
      UNDISCH_TAC (← q r"ring_char(l:B ring) = p") THEN
      REWRITE_TAC [RING_CHAR_UNIQUE] THEN SIMP_TAC []]))

  let ARTIN_SCHREIER_EXTENSION_EQ ← prove
   r"!(h:A->B) k l p.
        field_extension(k,l) h /\ prime p /\ ring_char k = p
        ==> (finite_extension(k,l) h /\ galois_extension(k,l) h /\
             cyclic_group(galois_group(k,l) h) /\
             CARD(group_carrier(galois_group(k,l) h)) divides p <=>
             ?a. a IN ring_carrier l /\
                 ring_sub l (ring_pow l a p) a IN IMAGE h (ring_carrier k) /\
                 subfield_generated l (a INSERT IMAGE h (ring_carrier k)) = l)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [STRIP_TAC,
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:B") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B", ← q r"p:num"]
        GALOIS_EXTENSION_ARTIN_SCHREIER) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
      MATCH_MP_TAC CYCLIC_GALOIS_GROUP_TRANSLATION THEN
      EXISTS_TAC (← q r"a:B") THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"f:B->B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B", ← q r"p:num"]
        GALOIS_GROUP_ARTIN_SCHREIER) THEN
      ASM_REWRITE_TAC []] THEN
    SUBGOAL_THEN
     (← q r"CARD(group_carrier(galois_group(k,l) (h:A->B))) = 1 \/
      CARD(group_carrier(galois_group(k,l) h)) = p")
    STRIP_ASSUME_TAC THENL
     [UNDISCH_TAC
       (← q r"CARD(group_carrier(galois_group(k,l) (h:A->B))) divides p") THEN
      UNDISCH_TAC (← q r"prime p") THEN REWRITE_TAC [prime] THEN MESON_TAC [],
      ALL_TAC,
      MATCH_MP_TAC ARTIN_SCHREIER_EXTENSION THEN ASM_REWRITE_TAC []] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP CARD_GALOIS_GROUP_LE) THEN
    MP_TAC (← ISPEC (← q r"galois_group(k:A ring,l:B ring) h")
      TRIVIAL_GROUP_HAS_SIZE_1) THEN
    ASM_REWRITE_TAC [trivial_group, ← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP),
                    HAS_SIZE] THEN
    DISCH_TAC THEN EXISTS_TAC (← q r"ring_0 l:B") THEN
    ASM_SIMP_TAC [GALOIS_EXTENSION_SIMPLE_EQ, IN_SING, RING_0] THEN
    ASM_SIMP_TAC [RING_POW_ZERO, PRIME_IMP_NZ, RING_SUB_REFL, RING_0] THEN
    REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"ring_0 k:A") THEN
    REWRITE_TAC [RING_0] THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_0 THEN
    ASM_MESON_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM])

  -- @@RETURN BEGIN
  return { CYCLIC_GALOIS_GROUP_TRANSLATION, ARTIN_SCHREIER_CYCLIC,
           ARTIN_SCHREIER_EXTENSION, ARTIN_SCHREIER_EXTENSION_EQ }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Solvable towers. The Galois group of l over the subfield generated by the -/
/- image of k is the Galois group of l over k. A chain of intermediate       -/
/- fields from the image of k to l in which each step is normal with abelian -/
/- Galois group gives a chain of Galois groups as in the definition of       -/
/- solvable_group: each is normal in the previous one, as the kernel of the  -/
/- restriction to the next step, with quotient embedded in the abelian       -/
/- Galois group of the step. Nothing is assumed about l over k except that l -/
/- is a field. In particular the Galois group is solvable when l is          -/
/- generated over the image of k by an element z of finite order followed by -/
/- finitely many elements each of which has a power, with exponent dividing  -/
/- the order of z, in the subfield generated by the earlier ones: a          -/
/- cyclotomic step followed by Kummer steps, in any characteristic. Finally  -/
/- a normal extension that embeds over k into a normal extension with        -/
/- solvable Galois group has a solvable Galois group, an epimorphic image    -/
/- under restriction.                                                        -/
/- ------------------------------------------------------------------------- -/

structure SolvableTowers where
  -- @@FIELDS
  GALOIS_GROUP_SUBFIELD_GENERATED_IMAGE : thm
  SOLVABLE_GALOIS_TOWER : thm
  SOLVABLE_GALOIS_RADICAL_TOWER : thm
  SOLVABLE_GALOIS_SUBEXTENSION : thm
  deriving Inhabited

@[nospecialize]
def setupSolvableTowers [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtension : GaloisExtension) (BGaloisIsomorphic : GaloisIsomorphic) (BGaloisCorrespondence : GaloisCorrespondence) (BGaloisRestriction : GaloisRestriction) (BCyclotomicKummer : CyclotomicKummer) :
    ExceptT String IO SolvableTowers := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { ABELIAN_SUBGROUP_GENERATED, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
        CARRIER_SUBFIELD_OF, EMPTY_GSPEC, EXTENSION, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_IMP_INTEGRAL_DOMAIN,
        FIELD_IMP_NONTRIVIAL_RING, FIELD_RING_HOMOMORPHISM_MONOMORPHISM,
        FIRST_GROUP_ISOMORPHISM_THEOREM, FORALL_IN_IMAGE, FUN_IN_IMAGE, GROUPS_EQ, .. } := D.core1
  let { IMAGE_CLAUSES, IMAGE_I, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_UNION,
        ISOMORPHIC_GROUP_ABELIANNESS, ISOMORPHIC_GROUP_SOLVABILITY, I_THM, LT, LT_SUC,
        NORMAL_EXTENSION_ISOMORPHIC_IMAGE, NORMAL_IMP_FIELD_EXTENSION,
        NORMAL_SUBGROUP_GROUP_KERNEL, NOT_SUC, .. } := D.core2
  let { RING_AUTOMORPHISM_IMP_ENDOMORPHISM, RING_HOMOMORPHISM_IN_CARRIER,
        RING_ISOMORPHISM, RING_ISOMORPHISM_I, RING_MONOMORPHISM_IMP_HOMOMORPHISM,
        RING_POW_RING_ORDER, .. } := D.core3
  let { ROOTS_OF_UNITY_RING_ORDER_DIVISOR, SOLVABLE_GROUP_EPIMORPHIC_IMAGE,
        SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, SUBFIELD_GENERATED_INC_GEN,
        SUBFIELD_GENERATED_INSERT, SUBFIELD_GENERATED_MINIMAL_EQ,
        SUBFIELD_GENERATED_MONO, SUBFIELD_GENERATED_RING_CARRIER,
        SUBFIELD_IMP_SUBRING_OF, SUBFIELD_OF_FIXPOINTS, SUBFIELD_OF_IMP_SUBSET,
        SUBFIELD_OF_MONOMORPHIC_IMAGE, SUBFIELD_SUBFIELD_GENERATED, SUBSET,
        SUBSET_CARRIER_SUBFIELD_GENERATED, SUBSET_REFL, SUC_SUB1, UNION_EMPTY,
        field_extension, num_INDUCTION, permutes, ring_monomorphism, solvable_group,
        trivial_group, .. } := D.core4
  let { GALOIS_GROUP, TRIVIAL_GALOIS_GROUP, .. } := BGaloisGroup
  let { GALOIS_IMP_NORMAL_EXTENSION, .. } := BGaloisExtension
  let { ISOMORPHIC_GALOIS_GROUPS, .. } := BGaloisIsomorphic
  let { GALOIS_GROUP_INTERMEDIATE_SUBGROUP_GENERATED, .. } := BGaloisCorrespondence
  let { GALOIS_GROUP_RESTRICTION, GALOIS_GROUP_RESTRICTION_HOMOMORPHISM, .. } := BGaloisRestriction
  let { CYCLOTOMIC_EXTENSION_ABELIAN_INTERMEDIATE,
        KUMMER_EXTENSION_ABELIAN_INTERMEDIATE, .. } := BCyclotomicKummer
  -- @@SCOPE END

  let GALOIS_GROUP_SUBFIELD_GENERATED_IMAGE ← prove
   r"!(h:A->B) k l.
        field l
        ==> galois_group(subfield_generated l (IMAGE h (ring_carrier k)),l) I =
            galois_group(k,l) h"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [GROUPS_EQ, GALOIS_GROUP] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, I_THM] THEN X_GEN_TAC (← q r"f:B->B") THEN
    ASM_CASES_TAC (← q r"(f:B->B) permutes ring_carrier l") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"ring_automorphism l (f:B->B)") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"(h:A->B) x IN ring_carrier l") THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN
        MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN ASM SET_TAC [],
        ASM_MESON_TAC [permutes]],
      SUBGOAL_THEN
       (← q r"ring_carrier(subfield_generated l (IMAGE (h:A->B) (ring_carrier k)))
        SUBSET {x | x IN ring_carrier l /\ (f:B->B) x = x}")
      MP_TAC THENL
       [ASM_SIMP_TAC [SUBFIELD_GENERATED_MINIMAL_EQ, SUBFIELD_OF_FIXPOINTS,
                     RING_AUTOMORPHISM_IMP_ENDOMORPHISM] THEN
        ASM SET_TAC [],
        SET_TAC []]])

  let SOLVABLE_GALOIS_TOWER ← prove
   r"!(h:A->B) k l n (s:num->B->bool).
        field l /\
        s 0 = IMAGE h (ring_carrier k) /\ s n = ring_carrier l /\
        (!i. i < n
             ==> s i subfield_of l /\ s i SUBSET s(SUC i) /\
                 normal_extension
                  (subfield_generated l (s i),subfield_generated l (s(SUC i)))
                  I /\
                 abelian_group
                  (galois_group
                    (subfield_generated l (s i),
                     subfield_generated l (s(SUC i))) I))
        ==> solvable_group(galois_group(k,l) h)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "tower")))) THEN
    SUBGOAL_THEN
     (← q r"!i. i <= n
          ==> (s:num->B->bool) i subfield_of l /\
              IMAGE (h:A->B) (ring_carrier k) SUBSET s i")
    (LABEL_TAC "sub") THENL
     [MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
       [DISCH_TAC THEN CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [SUBSET_REFL]] THEN
        ASM_CASES_TAC (← q r"n = 0") THENL
         [UNDISCH_TAC (← q r"(s:num->B->bool) n = ring_carrier l") THEN
          ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
          ASM_REWRITE_TAC [CARRIER_SUBFIELD_OF],
          USE_THEN "tower" (MP_TAC o SPEC (← q r"0")) THEN
          ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []]],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"i:num") THEN DISCH_THEN (fun ih => DISCH_TAC THEN MP_TAC ih) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, STRIP_TAC] THEN
      USE_THEN "tower" (MP_TAC o SPEC (← q r"i:num")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, STRIP_TAC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_CASES_TAC (← q r"SUC i = n") THENL
       [ASM_REWRITE_TAC [CARRIER_SUBFIELD_OF],
        USE_THEN "tower" (MP_TAC o SPEC (← q r"SUC i")) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []]],
      ALL_TAC] THEN
    REWRITE_TAC [solvable_group] THEN EXISTS_TAC (← q r"n:num") THEN
    EXISTS_TAC
     (← q r"\i. group_carrier
           (galois_group(subfield_generated l ((s:num->B->bool) i),l) I)") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [GALOIS_GROUP_SUBFIELD_GENERATED_IMAGE],
      ASM_REWRITE_TAC [SUBFIELD_GENERATED_RING_CARRIER] THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"l:B ring", ← q r"l:B ring"] TRIVIAL_GALOIS_GROUP) THEN
      REWRITE_TAC [IMAGE_I, SUBSET_REFL, trivial_group, GALOIS_GROUP],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
    USE_THEN "tower" (MP_TAC o SPEC (← q r"i:num")) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], STRIP_TAC] THEN
    USE_THEN "sub" (MP_TAC o SPEC (← q r"i:num")) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, STRIP_TAC] THEN
    USE_THEN "sub" (MP_TAC o SPEC (← q r"SUC i")) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"(s:num->B->bool) i"]
      GALOIS_GROUP_INTERMEDIATE_SUBGROUP_GENERATED) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN SUBST1_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_carrier(subfield_generated l ((s:num->B->bool) i)) = s i")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"subfield_generated l ((s:num->B->bool) i)",
                   ← q r"l:B ring", ← q r"(s:num->B->bool)(SUC i)"]
      GALOIS_GROUP_RESTRICTION_HOMOMORPHISM) THEN
    ASM_REWRITE_TAC [IMAGE_I] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
    ASM_SIMP_TAC [NORMAL_SUBGROUP_GROUP_KERNEL] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_ABELIANNESS o
      MATCH_MP FIRST_GROUP_ISOMORPHISM_THEOREM) THEN
    DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC ABELIAN_SUBGROUP_GENERATED THEN
    ASM_REWRITE_TAC [])

  let SOLVABLE_GALOIS_RADICAL_TOWER ← prove
   r"!(h:A->B) k l z n (a:num->B) (m:num->num).
        field_extension(k,l) h /\
        z IN ring_carrier l /\ ~(ring_order l z = 0) /\
        (!i. i < n
             ==> m i divides ring_order l z /\ a i IN ring_carrier l /\
                 ring_pow l (a i) (m i) IN
                 ring_carrier(subfield_generated l
                   (z INSERT IMAGE h (ring_carrier k) UNION
                    IMAGE a {j | j < i}))) /\
        subfield_generated l
          (z INSERT IMAGE h (ring_carrier k) UNION IMAGE a {i | i < n}) = l
        ==> solvable_group(galois_group(k,l) h)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 (LABEL_TAC "a")
       ASSUME_TAC)))) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN (← q r"IMAGE (h:A->B) (ring_carrier k) subfield_of l") ASSUME_TAC THENL
     [MATCH_MP_TAC SUBFIELD_OF_MONOMORPHIC_IMAGE THEN EXISTS_TAC (← q r"k:A ring") THEN
      ASM_REWRITE_TAC [CARRIER_SUBFIELD_OF],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?t:num->B->bool.
        !i. t i = ring_carrier(subfield_generated l
                    (z INSERT IMAGE (h:A->B) (ring_carrier k) UNION
                     IMAGE (a:num->B) {j | j < i}))")
    (X_CHOOSE_THEN (← q r"t:num->B->bool") (LABEL_TAC "tdef")) THENL
     [EXISTS_TAC
       (← q r"\i. ring_carrier(subfield_generated l
              ((z:B) INSERT IMAGE (h:A->B) (ring_carrier k) UNION
               IMAGE (a:num->B) {j | j < i}))") THEN
      REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i. (t:num->B->bool) i subfield_of l /\ z IN t i /\
          IMAGE (h:A->B) (ring_carrier k) SUBSET t i /\ t i SUBSET t(SUC i) /\
          subfield_generated l (t(SUC i)) =
          subfield_generated l ((a:num->B) i INSERT t i)")
    (LABEL_TAC "t") THENL
     [X_GEN_TAC (← q r"i:num") THEN USE_THEN "tdef" (fun th => REWRITE_TAC [th]) THEN
      ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED,
                   SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED,
                   SUBFIELD_GENERATED_INSERT] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
        ASM_REWRITE_TAC [IN_INSERT, IN_UNION],
        MATCH_MP_TAC SUBSET_CARRIER_SUBFIELD_GENERATED THEN
        ASM_SIMP_TAC [SUBFIELD_OF_IMP_SUBSET] THEN SET_TAC [],
        MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN
        REWRITE_TAC [IN_ELIM_THM, LT] THEN SET_TAC [],
        AP_TERM_TAC THEN
        REWRITE_TAC [EXTENSION, IN_INSERT, IN_UNION, IN_IMAGE, IN_ELIM_THM,
                    LT] THEN
        MESON_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"subfield_generated l ((t:num->B->bool) 0) =
      subfield_generated l (z INSERT IMAGE (h:A->B) (ring_carrier k)) /\
      t n = ring_carrier l /\
      !i. i < n ==> ring_pow l ((a:num->B) i) ((m:num->num) i) IN t i")
    STRIP_ASSUME_TAC THENL
     [USE_THEN "tdef" (fun th => REWRITE_TAC [th]) THEN
      REWRITE_TAC [SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, LT, EMPTY_GSPEC,
                  IMAGE_CLAUSES, UNION_EMPTY] THEN
      CONJ_TAC THENL
       [FIRST_ASSUM (fun th => tactic_of do
          let c ← q r"l:B ring"
          let ok := is_eq (concl th) &&
            (match rand (concl th) with | .ok u => u == c | .error _ => false)
          if !ok then throw "check"
          pure (SUBST1_TAC th)) THEN
        REFL_TAC,
        USE_THEN "a" (fun th => SIMP_TAC [th])],
      ALL_TAC] THEN
    REMOVE_THEN "tdef" (K ALL_TAC : thm → tactic) THEN
    MATCH_MP_TAC SOLVABLE_GALOIS_TOWER THEN
    MAP_EVERY EXISTS_TAC
     [← q r"SUC n",
      ← q r"\i. if i = 0 then IMAGE (h:A->B) (ring_carrier k)
           else (t:num->B->bool)(i - 1)"] THEN
    ASM_REWRITE_TAC [NOT_SUC, SUC_SUB1] THEN
    MATCH_MP_TAC num_INDUCTION THEN REWRITE_TAC [NOT_SUC, SUC_SUB1, LT_SUC] THEN
    CONJ_TAC THENL
     [DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
      USE_THEN "t" (fun th => REWRITE_TAC [th]) THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"IMAGE (h:A->B) (ring_carrier k)", ← q r"z:B",
                     ← q r"ring_order l (z:B)"]
        CYCLOTOMIC_EXTENSION_ABELIAN_INTERMEDIATE) THEN
      ASM_SIMP_TAC [RING_POW_RING_ORDER] THEN
      MESON_TAC [GALOIS_IMP_NORMAL_EXTENSION],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"i:num") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN DISCH_TAC THEN
    USE_THEN "t" (fun th => REWRITE_TAC [th]) THEN
    USE_THEN "a" (fun th => tactic_of do
      pure (STRIP_ASSUME_TAC (← MATCH_MP th (← ASSUME (← q r"i < n:num"))))) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"(t:num->B->bool) i", ← q r"(a:num->B) i",
                   ← q r"(m:num->num) i"]
      KUMMER_EXTENSION_ABELIAN_INTERMEDIATE) THEN
    ANTS_TAC THENL [ALL_TAC, MESON_TAC [GALOIS_IMP_NORMAL_EXTENSION]] THEN
    USE_THEN "t" (STRIP_ASSUME_TAC o SPEC (← q r"i:num")) THEN
    ASM_SIMP_TAC [] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"(t:num->B->bool) i", ← q r"z:B",
                   ← q r"ring_order l (z:B)", ← q r"(m:num->num) i"]
      ROOTS_OF_UNITY_RING_ORDER_DIVISOR) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, SUBFIELD_IMP_SUBRING_OF])

  let SOLVABLE_GALOIS_SUBEXTENSION ← prove
   r"!(h:A->B) (g:A->C) (j:B->C) k l m.
        normal_extension(k,l) h /\ normal_extension(k,m) g /\
        ring_homomorphism(l,m) j /\
        (!x. x IN ring_carrier k ==> j(h x) = g x) /\
        solvable_group(galois_group(k,m) g)
        ==> solvable_group(galois_group(k,l) h)"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY (fun t => FIRST_ASSUM (fun th => tactic_of do
      if !(concl th == t) then throw "check"
      pure (STRIP_ASSUME_TAC (← GEN_REWRITE_RULE I [field_extension]
        (← MATCH_MP NORMAL_IMP_FIELD_EXTENSION th)))))
     [← q r"normal_extension(k:A ring,l:B ring) h",
      ← q r"normal_extension(k:A ring,m:C ring) g"] THEN
    SUBGOAL_THEN (← q r"ring_monomorphism(l:B ring,m:C ring) j") ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"t = IMAGE (j:B->C) (ring_carrier l)") THEN
    SUBGOAL_THEN (← q r"(t:C->bool) subfield_of m") ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN MATCH_MP_TAC SUBFIELD_OF_MONOMORPHIC_IMAGE THEN
      EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [CARRIER_SUBFIELD_OF],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"IMAGE (g:A->C) (ring_carrier k) SUBSET t") ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure ((SUBST1_TAC o SYM) (← MATCH_MP th
         (← ASSUME (← q r"(x:A) IN ring_carrier k"))))) THEN
      MATCH_MP_TAC FUN_IN_IMAGE THEN
      ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER, ring_monomorphism],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_isomorphism(l,subfield_generated m t) (j:B->C)")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [RING_ISOMORPHISM, CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC FIELD_EXTENSION_IMP_HOMOMORPHISM THEN
        MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
        ASM_REWRITE_TAC [field_extension, SUBSET_REFL],
        ASM_MESON_TAC [ring_monomorphism]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"j:B->C", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"subfield_generated m (t:C->bool)"]
      ISOMORPHIC_GALOIS_GROUPS) THEN
    ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_SOLVABILITY) THEN
    MATCH_MP_TAC (← ISPEC (← q r"galois_group(k:A ring,m:C ring) g")
      SOLVABLE_GROUP_EPIMORPHIC_IMAGE) THEN
    EXISTS_TAC (← q r"\(f:C->C) x. if x IN t then f x else x") THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"g:A->C", ← q r"k:A ring", ← q r"m:C ring", ← q r"t:C->bool"]
      GALOIS_GROUP_RESTRICTION) THEN
    ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"I:A->A", ← q r"j:B->C", ← q r"k:A ring",
                   ← q r"l:B ring", ← q r"k:A ring", ← q r"subfield_generated m (t:C->bool)"]
      NORMAL_EXTENSION_ISOMORPHIC_IMAGE) THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [RING_ISOMORPHISM_I, I_THM])

  -- @@RETURN BEGIN
  return { GALOIS_GROUP_SUBFIELD_GENERATED_IMAGE, SOLVABLE_GALOIS_TOWER,
           SOLVABLE_GALOIS_RADICAL_TOWER, SOLVABLE_GALOIS_SUBEXTENSION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Galois groups of radical extensions. A radical subextension s of a field  -/
/- l comes with an n <> 0 such that adjoining to s any element of l of order -/
/- n gives an extension with solvable Galois group over k (the exponents of  -/
/- the radicals divide n). In characteristic zero an algebraically closed    -/
/- field has elements of every order n <> 0, and for a normal radical        -/
/- extension l the field obtained by adjoining such an element to an image   -/
/- of l is again normal, as the compositum of l with a cyclotomic extension; -/
/- so normal radical extensions have solvable Galois groups. With the normal -/
/- closure, the same holds for normal extensions that embed into radical     -/
/- extensions, and for the splitting extension of an irreducible polynomial  -/
/- with a root expressible by radicals in some extension field.              -/
/- ------------------------------------------------------------------------- -/

structure RadicalGaloisGroups where
  -- @@FIELDS
  SOLVABLE_GALOIS_RADICAL_ROOT_OF_UNITY : thm
  RADICAL_NORMAL_EXTENSION_SOLVABLE : thm
  RADICAL_EXTENSION_SOLVABLE : thm
  RADICAL_ROOT_SOLVABLE : thm
  deriving Inhabited

@[nospecialize]
def setupRadicalGaloisGroups [HolBase] (D : GaloisDeps) (BGaloisExtension : GaloisExtension) (BRadicalExtensions : RadicalExtensions) (BRadicalExtensions2 : RadicalExtensions2) (BRadicalElements : RadicalElements) (BRadicalNormalClosure : RadicalNormalClosure) (BCyclotomicKummer : CyclotomicKummer) (BSolvableTowers : SolvableTowers) :
    ExceptT String IO RadicalGaloisGroups := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, SET_RULE, SET_TAC, .. } := D
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD,
        ALGEBRAICALLY_CLOSED_FIELD_PRIMITIVE_ROOT_OF_UNITY,
        ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, ALGEBRAIC_IMP_FIELD_EXTENSION, ARITH_EQ,
        CARRIER_SUBFIELD_GENERATED_SUBFIELD, DIVIDES_LMUL, DIVIDES_REFL, DIVIDES_RMUL,
        DIVIDES_ZERO, EQ_IMP, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_IMP_MONOMORPHISM, FIELD_EXTENSION_IMP_SUBSET,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_EXTENSION_SUBFIELD_GENERATED,
        FIELD_EXTENSION_TRANS, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FORALL_IN_IMAGE, .. } := D.core1
  let { IMAGE_I, IMAGE_SUBSET, IMAGE_o, INSERT_SUBSET, INSERT_UNION_EQ, IN_ELIM_THM,
        IN_IMAGE, IN_INSERT, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, IN_UNION, I_O_ID,
        I_THM, LE_REFL, LT, LTE_TRANS, LT_IMP_LE, MONO_EXISTS, MULT_EQ_0,
        NORMAL_EXTENSION_COMPOSITUM, NORMAL_IMP_FIELD_EXTENSION,
        POLY_EVAL_HOMOMORPHIC_IMAGE, .. } := D.core2
  let { RING_CHAR_MONOMORPHIC_IMAGE, RING_HOMOMORPHISM_0,
        RING_HOMOMORPHISM_SUBFIELD_INCLUSION, RING_MONOMORPHISM_IMP_HOMOMORPHISM,
        RING_ORDER_SUBFIELD_GENERATED, RING_POW_RING_ORDER,
        RING_POW_SUBFIELD_GENERATED, .. } := D.core3
  let { SPLITTING_EXTENSION_EXTEND_HOMOMORPHISM, SPLITTING_EXTENSION_IMP_NORMAL,
        SPLITTING_EXTENSION_IN_POLY_RING, SUBFIELD_GENERATED,
        SUBFIELD_GENERATED_IDEMPOT, SUBFIELD_GENERATED_IDEMPOT_GEN,
        SUBFIELD_GENERATED_INC_GEN, SUBFIELD_GENERATED_INSERT, SUBFIELD_GENERATED_MONO,
        SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET, SUBFIELD_GENERATED_UNION_RIGHT,
        SUBFIELD_OF_IMP_SUBSET, SUBSET, SUBSET_TRANS, field_extension,
        normal_extension, o_ASSOC, o_THM, .. } := D.core4
  let { GALOIS_IMP_NORMAL_EXTENSION, .. } := BGaloisExtension
  let { RADICAL_IMP_FIELD_EXTENSION, .. } := BRadicalExtensions
  let { RADICAL_EXTENSION_HOMOMORPHIC_IMAGE_GEN,
        RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED, .. } := BRadicalExtensions2
  let { RADICAL_ELEMENT_HOMOMORPHIC_IMAGE, RADICAL_ELEMENT_IN_CARRIER, .. } := BRadicalElements
  let { RADICAL_ELEMENT_NORMAL_CLOSURE, RADICAL_EXTENSION_NORMAL_CLOSURE, .. } := BRadicalNormalClosure
  let { CYCLOTOMIC_EXTENSION_ABELIAN, .. } := BCyclotomicKummer
  let { SOLVABLE_GALOIS_RADICAL_TOWER, SOLVABLE_GALOIS_SUBEXTENSION, .. } := BSolvableTowers
  -- @@SCOPE END

  let SOLVABLE_GALOIS_RADICAL_ROOT_OF_UNITY ← prove
   r"!(h:A->B) k l s.
        field l /\ s subfield_of l /\
        radical_extension(k,subfield_generated l s) h
        ==> ?n. ~(n = 0) /\
                !z. z IN ring_carrier l /\ ring_order l z = n
                    ==> solvable_group
                          (galois_group(k,subfield_generated l (z INSERT s))
                                       h)"
   (← do
    -- right to left: the second SET_RULE, then the first
    let s2 ← SET_RULE (← q r"(y:B) IN s0 ==> s0 SUBSET t0 ==> y IN t0")
    let s1 ← SET_RULE
     (← q r"!z:B s t u. t SUBSET s /\ u SUBSET s ==> z INSERT t UNION u SUBSET
                                                 z INSERT s")
    pure (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"field_extension(k:A ring,l:B ring) h") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                     ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring"]
        FIELD_EXTENSION_TRANS) THEN
      ASM_SIMP_TAC [RADICAL_IMP_FIELD_EXTENSION,
                   FIELD_EXTENSION_SUBFIELD_GENERATED, I_O_ID],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      RADICAL_EXTENSION_INTO_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"p:num")
      (X_CHOOSE_THEN (← q r"a:num->B") (X_CHOOSE_THEN (← q r"m:num->num")
        (CONJUNCTS_THEN2 (LABEL_TAC "a") (LABEL_TAC "s")))))) THEN
    SUBGOAL_THEN
     (← q r"!q. q <= p ==> ?n. ~(n = 0) /\ !i. i < q ==> (m:num->num) i divides n")
    (MP_TAC o SPEC (← q r"p:num")) THENL
     [INDUCT_TAC THEN DISCH_TAC THENL
       [EXISTS_TAC (← q r"1") THEN REWRITE_TAC [LT, ARITH_EQ], ALL_TAC] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        if !(is_imp (concl th)) then throw "check"
        pure (MP_TAC th)) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
      USE_THEN "a" (MP_TAC o SPEC (← q r"q:num")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, STRIP_TAC] THEN
      EXISTS_TAC (← q r"n * (m:num->num) q") THEN ASM_REWRITE_TAC [MULT_EQ_0, LT] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [DIVIDES_LMUL, DIVIDES_RMUL, DIVIDES_REFL],
      REWRITE_TAC [LE_REFL] THEN MATCH_MP_TAC MONO_EXISTS] THEN
    X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"z:B") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!i. i < p ==> (a:num->B) i IN s") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      USE_THEN "s" (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN CONJ_TAC THENL
       [USE_THEN "a" (fun th => ASM_MESON_TAC [th]),
        REWRITE_TAC [IN_UNION, IN_IMAGE, IN_ELIM_THM] THEN DISJ2_TAC THEN
        EXISTS_TAC (← q r"i:num") THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i. i <= p
          ==> subfield_generated (subfield_generated l (z INSERT s))
                ((z:B) INSERT IMAGE (h:A->B) (ring_carrier k) UNION
                 IMAGE (a:num->B) {j | j < i}) =
              subfield_generated l
                (z INSERT IMAGE h (ring_carrier k) UNION IMAGE a {j | j < i})")
    (LABEL_TAC "idem") THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBFIELD_GENERATED_IDEMPOT_GEN THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"(z:B) INSERT s") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET THEN
        ASM_SIMP_TAC [INSERT_SUBSET, SUBFIELD_OF_IMP_SUBSET]] THEN
      MATCH_MP_TAC s1 THEN
      CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC, ALL_TAC] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      ASM_MESON_TAC [LTE_TRANS],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(z:B) IN ring_carrier(subfield_generated l (z INSERT s))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN ASM_REWRITE_TAC [IN_INSERT],
      ALL_TAC] THEN
    MATCH_MP_TAC SOLVABLE_GALOIS_RADICAL_TOWER THEN
    MAP_EVERY EXISTS_TAC [← q r"z:B", ← q r"p:num", ← q r"a:num->B", ← q r"m:num->num"] THEN
    USE_THEN "idem" (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP th (← SPEC (← q r"p:num") LE_REFL)])) THEN
    ASM_SIMP_TAC [RING_ORDER_SUBFIELD_GENERATED, RING_POW_SUBFIELD_GENERATED] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      USE_THEN "idem" (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP th
          (← MATCH_MP LT_IMP_LE (← ASSUME (← q r"i < p:num")))])) THEN
      USE_THEN "a" (fun th => tactic_of do
        pure (STRIP_ASSUME_TAC (← MATCH_MP th (← ASSUME (← q r"i < p:num"))))) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN ASM_SIMP_TAC [IN_INSERT],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s2) THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN SET_TAC [],
      USE_THEN "s" (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [SUBFIELD_GENERATED_INSERT, INSERT_UNION_EQ]]))

  let RADICAL_NORMAL_EXTENSION_SOLVABLE ← prove
   r"!(h:A->B) k l.
        ring_char k = 0 /\ radical_extension(k,l) h /\ normal_extension(k,l) h
        ==> solvable_group(galois_group(k,l) h)"
   (← do
    let s1 ← SET_RULE
     (← q r"!z:B#num s t. t SUBSET s ==> s UNION (z INSERT t) = z INSERT s")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RADICAL_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    MP_TAC (← ISPEC (← q r"l:B ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"om:(B#num)ring") (X_CHOOSE_THEN (← q r"j:B->B#num")
      STRIP_ASSUME_TAC)) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"field_extension(l:B ring,om:(B#num)ring) j"
      if !(concl th == c) then throw "check"
      pure (ASSUME_TAC (← MATCH_MP FIELD_EXTENSION_IMP_MONOMORPHISM th)))
    THEN
    SUBGOAL_THEN
     (← q r"field_extension(k:A ring,om:(B#num)ring) ((j:B->B#num) o (h:A->B))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_TRANS THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"j:B->B#num",
                   ← q r"k:A ring", ← q r"l:B ring", ← q r"om:(B#num)ring"]
      RADICAL_EXTENSION_HOMOMORPHIC_IMAGE_GEN) THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM, o_THM] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(j:B->B#num) o (h:A->B)", ← q r"k:A ring", ← q r"om:(B#num)ring",
                   ← q r"IMAGE (j:B->B#num) (ring_carrier l)"]
      SOLVABLE_GALOIS_RADICAL_ROOT_OF_UNITY) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"om:(B#num)ring", ← q r"n:num"]
      ALGEBRAICALLY_CLOSED_FIELD_PRIMITIVE_ROOT_OF_UNITY) THEN
    ANTS_TAC THENL
     [SUBGOAL_THEN (← q r"ring_char(om:(B#num)ring) = 0")
       (fun th => ASM_REWRITE_TAC [th, DIVIDES_ZERO]) THEN
      ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE],
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:B#num") STRIP_ASSUME_TAC o CONJUNCT2)] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"j:B->B#num",
                   ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"subfield_generated om
                      ((z:B#num) INSERT IMAGE (j:B->B#num) (ring_carrier l))"]
      SOLVABLE_GALOIS_SUBEXTENSION) THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC [o_THM] THEN CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC FIELD_EXTENSION_IMP_HOMOMORPHISM THEN
      MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [] THEN SET_TAC []] THEN
    ABBREV_TAC
     (← q r"c = subfield_generated om
            ((z:B#num) INSERT IMAGE ((j:B->B#num) o (h:A->B)) (ring_carrier k))")
    THEN
    SUBGOAL_THEN
     (← q r"normal_extension(k:A ring,c:(B#num)ring) ((j:B->B#num) o (h:A->B))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC GALOIS_IMP_NORMAL_EXTENSION THEN
      MP_TAC (← ISPECL [← q r"(j:B->B#num) o (h:A->B)", ← q r"k:A ring", ← q r"c:(B#num)ring",
                     ← q r"z:B#num", ← q r"n:num"] CYCLOTOMIC_EXTENSION_ABELIAN) THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      EXPAND_TAC "c" THEN
      REWRITE_TAC [SUBFIELD_GENERATED_IDEMPOT, RING_POW_SUBFIELD_GENERATED,
                  ← CONJUNCT2 SUBFIELD_GENERATED] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
        ASM_REWRITE_TAC [] THEN SET_TAC [],
        FIRST_ASSUM ACCEPT_TAC,
        MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
        ASM_REWRITE_TAC [IN_INSERT],
        FIRST_X_ASSUM (fun th => tactic_of do
          let c ← q r"ring_order om (z:B#num) = n"
          if !(concl th == c) then throw "check"
          pure ((SUBST1_TAC o SYM) th)) THEN
        MATCH_MP_TAC RING_POW_RING_ORDER THEN FIRST_ASSUM ACCEPT_TAC],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"j:B->B#num",
                   ← q r"I:(B#num)->(B#num)", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"c:(B#num)ring", ← q r"om:(B#num)ring"]
      NORMAL_EXTENSION_COMPOSITUM) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [o_THM, I_THM] THEN EXPAND_TAC "c" THEN
      REWRITE_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED] THEN
      FIRST_ASSUM ACCEPT_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    AP_TERM_TAC THEN EXPAND_TAC "c" THEN
    REWRITE_TAC [IMAGE_I, SUBFIELD_GENERATED_UNION_RIGHT] THEN
    AP_TERM_TAC THEN REWRITE_TAC [IMAGE_o] THEN
    MATCH_MP_TAC s1 THEN
    MATCH_MP_TAC IMAGE_SUBSET THEN
    ASM_MESON_TAC [FIELD_EXTENSION_IMP_SUBSET]))

  let RADICAL_EXTENSION_SOLVABLE ← prove
   r"!(h:A->B) (g:A->C) (j:B->C) k l m.
        ring_char k = 0 /\ normal_extension(k,l) h /\
        radical_extension(k,m) g /\
        ring_homomorphism(l,m) j /\ (!x. x IN ring_carrier k ==> j(h x) = g x)
        ==> solvable_group(galois_group(k,l) h)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP RADICAL_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP NORMAL_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"field_extension(l:B ring,m:C ring) j") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [field_extension] THEN
      MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"m:C ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"om:(C#num)ring") (X_CHOOSE_THEN (← q r"i:C->C#num")
      STRIP_ASSUME_TAC)) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"g:A->C", ← q r"i:C->C#num", ← q r"k:A ring", ← q r"m:C ring",
                   ← q r"om:(C#num)ring"] RADICAL_EXTENSION_NORMAL_CLOSURE) THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:(C#num)->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(i:C->C#num) o (g:A->C)",
                   ← q r"(i:C->C#num) o (j:B->C)", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"subfield_generated om (s:(C#num)->bool)"]
      SOLVABLE_GALOIS_SUBEXTENSION) THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [RADICAL_NORMAL_EXTENSION_SOLVABLE, o_THM] THEN
    MATCH_MP_TAC FIELD_EXTENSION_IMP_HOMOMORPHISM THEN
    MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN CONJ_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_TRANS THEN EXISTS_TAC (← q r"m:C ring") THEN
      ASM_REWRITE_TAC [],
      REWRITE_TAC [IMAGE_o] THEN MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"IMAGE (i:C->C#num) (ring_carrier m)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
      MATCH_MP_TAC FIELD_EXTENSION_IMP_SUBSET THEN ASM_REWRITE_TAC []])

  let RADICAL_ROOT_SOLVABLE ← prove
   r"!(h:A->B) (g:A->C) k l m p x.
        ring_char k = 0 /\ splitting_extension(k,l) h p /\
        ring_irreducible(poly_ring k (:1)) p /\
        field_extension(k,m) g /\ radical_element(k,m) g x /\
        poly_eval m (g o p) x = ring_0 m
        ==> solvable_group(galois_group(k,l) h)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"field_extension(k:A ring,m:C ring) g"
      if !(concl th == c) then throw "check"
      pure (STRIP_ASSUME_TAC (← GEN_REWRITE_RULE I [field_extension] th))) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"ring_monomorphism(k:A ring,m:C ring) g"
      if !(concl th == c) then throw "check"
      pure (ASSUME_TAC (← MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM th))) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RADICAL_ELEMENT_IN_CARRIER) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_IN_POLY_RING) THEN
    MP_TAC (← ISPEC (← q r"m:C ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"om:(C#num)ring") (X_CHOOSE_THEN (← q r"i:C->C#num")
      STRIP_ASSUME_TAC)) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM o
      MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"g:A->C", ← q r"i:C->C#num", ← q r"k:A ring", ← q r"m:C ring",
                   ← q r"om:(C#num)ring", ← q r"x:C"]
      RADICAL_ELEMENT_HOMOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"(i:C->C#num) o (g:A->C)", ← q r"k:A ring", ← q r"om:(C#num)ring",
                   ← q r"(i:C->C#num) x"] RADICAL_ELEMENT_NORMAL_CLOSURE) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:(C#num)->bool") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"n = subfield_generated om (s:(C#num)->bool)") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP NORMAL_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"ring_carrier n = (s:(C#num)->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "n" THEN MATCH_MP_TAC CARRIER_SUBFIELD_GENERATED_SUBFIELD THEN
      FIRST_ASSUM ACCEPT_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(i:C->C#num) o (g:A->C)", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"n:(C#num)ring", ← q r"p:(1->num)->A"]
      SPLITTING_EXTENSION_EXTEND_HOMOMORPHISM) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:B->C#num") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(i:C->C#num) o (g:A->C)", ← q r"e:B->C#num",
                     ← q r"k:A ring", ← q r"l:B ring", ← q r"n:(C#num)ring"]
        RADICAL_EXTENSION_SOLVABLE) THEN
      DISCH_THEN MATCH_MP_TAC THEN
      ASM_MESON_TAC [SPLITTING_EXTENSION_IMP_NORMAL]] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"normal_extension(k:A ring,n:(C#num)ring)
                                    ((i:C->C#num) o (g:A->C))"
      if !(concl th == c) then throw "check"
      pure (MATCH_MP_TAC (← CONJUNCT2 (← GEN_REWRITE_RULE I [normal_extension] th)))) THEN
    ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"(i:C->C#num) x") THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"n:(C#num)ring", ← q r"om:(C#num)ring", ← q r"(i:C->C#num) x",
                   ← q r"I:(C#num)->(C#num)",
                   ← q r"((i:C->C#num) o (g:A->C)) o (p:(1->num)->A)"]
      POLY_EVAL_HOMOMORPHIC_IMAGE) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [EXPAND_TAC "n" THEN REWRITE_TAC [RING_HOMOMORPHISM_SUBFIELD_INCLUSION],
        MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
        EXISTS_TAC (← q r"k:A ring") THEN
        ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM]],
      REWRITE_TAC [I_THM, I_O_ID] THEN DISCH_THEN SUBST1_TAC] THEN
    EXPAND_TAC "n" THEN REWRITE_TAC [← CONJUNCT2 SUBFIELD_GENERATED] THEN
    REWRITE_TAC [← GSYM o_ASSOC] THEN
    MP_TAC (← ISPECL [← q r"m:C ring", ← q r"om:(C#num)ring", ← q r"x:C", ← q r"i:C->C#num",
                   ← q r"(g:A->C) o (p:(1->num)->A)"] POLY_EVAL_HOMOMORPHIC_IMAGE) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
      DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [RING_HOMOMORPHISM_0]])

  -- @@RETURN BEGIN
  return { SOLVABLE_GALOIS_RADICAL_ROOT_OF_UNITY, RADICAL_NORMAL_EXTENSION_SOLVABLE,
           RADICAL_EXTENSION_SOLVABLE, RADICAL_ROOT_SOLVABLE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Polynomials with no root expressible by radicals. In characteristic zero  -/
/- an irreducible polynomial whose Galois group is not solvable has no root  -/
/- expressible by radicals in any extension field. This applies when the     -/
/- degree is a prime at least 5 and some element of the Galois group moves   -/
/- exactly two roots, for then the Galois group is the symmetric group on    -/
/- the roots. In the last form the Galois group element is an automorphism   -/
/- of a field in which the polynomial splits, for example complex            -/
/- conjugation when the field is that of the complex numbers.                -/
/- ------------------------------------------------------------------------- -/

structure NoRadicalRoot where
  -- @@FIELDS
  NOT_SOLVABLE_IMP_NO_RADICAL_ROOT : thm
  PRIME_TRANSPOSITION_NO_RADICAL_ROOT : thm
  PRIME_TRANSPOSITION_NO_RADICAL_ROOT_SPLITS : thm
  deriving Inhabited

@[nospecialize]
def setupNoRadicalRoot [HolBase] (D : GaloisDeps) (BNormalIntermediate : NormalIntermediate) (BGaloisRestriction : GaloisRestriction) (BGaloisPolynomial : GaloisPolynomial) (BRadicalGaloisGroups : RadicalGaloisGroups) :
    ExceptT String IO NoRadicalRoot := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, .. } := D
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, EXTENSION,
        FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_IMP_SUBSET, .. } := D.core1
  let { IN_ELIM_THM, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, IN_UNION,
        ISOMORPHIC_GROUP_SOLVABILITY, NOT_SOLVABLE_SYMMETRIC_GROUP,
        PERFECT_FIELD_CHAR_0, PERFECT_FIELD_IMP_SEPARABLE,
        POLY_EVAL_SUBFIELD_GENERATED, POLY_RING_CLAUSES, POLY_ROOT_BOUND_EXTENSION, .. } := D.core2
  let { POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT, RING_IRREDUCIBLE_IN_CARRIER, .. } := D.core3
  let { SPLITTING_EXTENSION_GENERATED_BY_ROOTS, SPLITTING_EXTENSION_IMP_NORMAL,
        SPLITTING_EXTENSION_IN_POLY_RING, SPLITTING_EXTENSION_NONZERO,
        SPLITTING_EXTENSION_SPLITS, SPLITTING_IMP_FIELD_EXTENSION, SUBFIELD_GENERATED,
        SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, SUBFIELD_GENERATED_INC_GEN,
        SUBFIELD_OF_IMP_SUBSET, SUBFIELD_SUBFIELD_GENERATED, SUBSET,
        SUBSET_CARRIER_SUBFIELD_GENERATED, SUBSET_UNION, field_extension,
        ring_irreducible, .. } := D.core4
  let { GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE, .. } := BNormalIntermediate
  let { GALOIS_GROUP_RESTRICT, .. } := BGaloisRestriction
  let { GALOIS_GROUP_PRIME_TRANSPOSITION, .. } := BGaloisPolynomial
  let { RADICAL_ROOT_SOLVABLE, .. } := BRadicalGaloisGroups
  -- @@SCOPE END

  let NOT_SOLVABLE_IMP_NO_RADICAL_ROOT ← prove
   r"!(h:A->B) (g:A->C) k l m p.
        ring_char k = 0 /\ splitting_extension(k,l) h p /\
        ring_irreducible(poly_ring k (:1)) p /\
        ~solvable_group(galois_group(k,l) h) /\ field_extension(k,m) g
        ==> ~(?x. radical_element(k,m) g x /\
                  poly_eval m (g o p) x = ring_0 m)"
   (MESON_TAC [RADICAL_ROOT_SOLVABLE])

  let PRIME_TRANSPOSITION_NO_RADICAL_ROOT ← prove
   r"!(h:A->B) (g:A->C) f k l m p.
        ring_char k = 0 /\ splitting_extension(k,l) h p /\
        ring_irreducible(poly_ring k (:1)) p /\
        prime(poly_deg k p) /\ 5 <= poly_deg k p /\
        f IN group_carrier(galois_group(k,l) h) /\
        {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l /\
             ~(f x = x)} HAS_SIZE 2 /\
        field_extension(k,m) g
        ==> ~(?x. radical_element(k,m) g x /\
                  poly_eval m (g o p) x = ring_0 m)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                   ← q r"p:(1->num)->A"] NOT_SOLVABLE_IMP_NO_RADICAL_ROOT) THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_IN_POLY_RING) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_NONZERO) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_SPLITS) THEN
    SUBGOAL_THEN
     (← q r"FINITE {x | x IN ring_carrier l /\
                  poly_eval l ((h:A->B) o p) x = ring_0 l} /\
      CARD {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l} =
      poly_deg k (p:(1->num)->A)")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
          POLY_ROOT_BOUND_EXTENSION) THEN
        ASM_SIMP_TAC [],
        MATCH_MP_TAC POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC PERFECT_FIELD_IMP_SEPARABLE THEN
        ASM_SIMP_TAC [PERFECT_FIELD_CHAR_0] THEN
        ASM_MESON_TAC [field_extension]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"p:(1->num)->A"] GALOIS_GROUP_PRIME_TRANSPOSITION) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_SOLVABILITY) THEN
    MATCH_MP_TAC NOT_SOLVABLE_SYMMETRIC_GROUP THEN ASM_REWRITE_TAC [])

  let PRIME_TRANSPOSITION_NO_RADICAL_ROOT_SPLITS ← prove
   r"!(g:A->B) f k m p.
        ring_char k = 0 /\ field_extension(k,m) g /\
        ring_irreducible(poly_ring k (:1)) p /\ poly_splits_over(k,m) g p /\
        prime(poly_deg k p) /\ 5 <= poly_deg k p /\
        f IN group_carrier(galois_group(k,m) g) /\
        {x | x IN ring_carrier m /\ poly_eval m (g o p) x = ring_0 m /\
             ~(f x = x)} HAS_SIZE 2
        ==> ~(?x. radical_element(k,m) g x /\
                  poly_eval m (g o p) x = ring_0 m)"
   (← do
    let m1 ← MESON []
     (← q r"!t u:B->bool. t HAS_SIZE 2 ==> u = t ==> u HAS_SIZE 2")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_IRREDUCIBLE_IN_CARRIER) THEN
    SUBGOAL_THEN (← q r"~((p:(1->num)->A) = poly_0 k)") ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o CONJUNCT1 o CONJUNCT2 o
        GEN_REWRITE_RULE I [ring_irreducible]) THEN
      REWRITE_TAC [POLY_RING_CLAUSES],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"g:A->B", ← q r"k:A ring", ← q r"m:B ring", ← q r"p:(1->num)->A"]
      SPLITTING_EXTENSION_GENERATED_BY_ROOTS) THEN
    ONCE_REWRITE_TAC [← GSYM SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"ring_carrier(subfield_generated m
        (IMAGE (g:A->B) (ring_carrier k) UNION
         {x | x IN ring_carrier m /\ poly_eval m (g o p) x = ring_0 m}))
      subfield_of m /\
      IMAGE (g:A->B) (ring_carrier k) SUBSET
      ring_carrier(subfield_generated m
        (IMAGE (g:A->B) (ring_carrier k) UNION
         {x | x IN ring_carrier m /\ poly_eval m (g o p) x = ring_0 m})) /\
      (!x. x IN ring_carrier m /\ poly_eval m (g o p) x = ring_0 m
           ==> x IN ring_carrier(subfield_generated m
                  (IMAGE (g:A->B) (ring_carrier k) UNION
                   {x | x IN ring_carrier m /\
                        poly_eval m (g o p) x = ring_0 m})))")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED] THEN CONJ_TAC THENL
       [MATCH_MP_TAC SUBSET_CARRIER_SUBFIELD_GENERATED THEN
        ASM_SIMP_TAC [FIELD_EXTENSION_IMP_SUBSET, SUBSET_UNION],
        REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
        ASM_REWRITE_TAC [IN_UNION, IN_ELIM_THM]],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"s = ring_carrier(subfield_generated m
            (IMAGE (g:A->B) (ring_carrier k) UNION
             {x | x IN ring_carrier m /\ poly_eval m (g o p) x = ring_0 m}))") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBFIELD_OF_IMP_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"g:A->B", ← q r"g:A->B", ← q r"\x. if x IN s then (f:B->B) x else x",
                   ← q r"k:A ring", ← q r"subfield_generated m (s:B->bool)", ← q r"m:B ring",
                   ← q r"p:(1->num)->A"] PRIME_TRANSPOSITION_NO_RADICAL_ROOT) THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC GALOIS_GROUP_RESTRICT THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC GALOIS_GROUP_IMAGE_NORMAL_INTERMEDIATE THEN
      ASM_MESON_TAC [SPLITTING_EXTENSION_IMP_NORMAL],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP m1) THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(k,subfield_generated m s) (g:A->B)")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [SPLITTING_IMP_FIELD_EXTENSION,
                    FIELD_EXTENSION_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD,
                 ← CONJUNCT2 SUBFIELD_GENERATED] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:B") THEN
    ASM_CASES_TAC (← q r"(x:B) IN s") THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC, ASM_MESON_TAC []] THEN
    SUBGOAL_THEN (← q r"(x:B) IN ring_carrier m") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET], ASM_REWRITE_TAC []] THEN
    MP_TAC (← ISPECL [← q r"m:B ring", ← q r"s:B->bool", ← q r"(g:A->B) o (p:(1->num)->A)",
                   ← q r"x:B"] POLY_EVAL_SUBFIELD_GENERATED) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD] THEN
      MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC []]))

  -- @@RETURN BEGIN
  return { NOT_SOLVABLE_IMP_NO_RADICAL_ROOT, PRIME_TRANSPOSITION_NO_RADICAL_ROOT,
           PRIME_TRANSPOSITION_NO_RADICAL_ROOT_SPLITS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Solvable Galois groups and radicals: the converse of Abel-Ruffini. If k   -/
/- has n distinct n-th roots of unity, a finite Galois extension of k whose  -/
/- degree divides n and whose Galois group is solvable is radical: a chain   -/
/- of subgroups with cyclic quotients gives a chain of intermediate fields,  -/
/- each a Kummer extension of the previous one. In general one adjoins to an -/
/- image of l a root of unity z of order N, a multiple of [l:k]: by natural  -/
/- irrationalities the result is finite Galois over the field generated by   -/
/- the image of k and z, with a solvable Galois group of order dividing N,   -/
/- and that field is radical over k. So when the characteristic of k does    -/
/- not divide [l:k], every element of a finite Galois extension with         -/
/- solvable Galois group is expressible by radicals in each algebraically    -/
/- closed field into which l embeds. In characteristic zero this gives the   -/
/- iff forms: a finite normal extension has a solvable Galois group exactly  -/
/- when all of its elements are expressible by radicals, and the splitting   -/
/- extension of a polynomial has a solvable Galois group exactly when all    -/
/- roots of the polynomial in an algebraically closed field are expressible  -/
/- by radicals, or for an irreducible polynomial, some root.                 -/
/- ------------------------------------------------------------------------- -/

structure SolvableRadicals where
  -- @@FIELDS
  RADICAL_EXTENSION_CYCLIC_QUOTIENT : thm
  SOLVABLE_IMP_RADICAL_EXTENSION : thm
  GALOIS_COMPOSITUM_SOLVABLE : thm
  RADICAL_EXTENSION_ROOT_OF_UNITY : thm
  deriving Inhabited

@[nospecialize]
def setupSolvableRadicals [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) (BGaloisExtensions : GaloisExtensions) (BGaloisExtension : GaloisExtension) (BFixedFields : FixedFields) (BArtin : Artin) (BGaloisCorrespondence : GaloisCorrespondence) (BGaloisRestriction : GaloisRestriction) (BNaturalIrrationalities : NaturalIrrationalities) (BRadicalExtensions : RadicalExtensions) (BRadicalExtensions2 : RadicalExtensions2) (BKummerTheory : KummerTheory) :
    ExceptT String IO SolvableRadicals := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { CARD_EQ_CARD_IMP, CARD_EQ_GROUP_ISOMORPHIC_IMAGE,
        CARRIER_SUBFIELD_GENERATED_SUBFIELD, CARRIER_SUBGROUP_OF, DIVIDES_REFL,
        DIVIDES_TRANS, DIVIDES_ZERO, EXTENSION_DEGREE_EQ_0,
        EXTENSION_DEGREE_SUBFIELD_GENERATED_DIVIDES, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_IMP_INTEGRAL_DOMAIN,
        FINITE_EXTENSION_SUBFIELD_GENERATED, FINITE_IMP_FIELD_EXTENSION, FINITE_SUBSET,
        FORALL_UNWIND_THM2, GROUP_ISOMORPHISM_IMP_ISOMORPHIC, .. } := D.core1
  let { INTER_SUBSET, IN_IMAGE, IN_INSERT, IN_SING, ISOMORPHIC_GROUP_CYCLICITY,
        ISOMORPHIC_GROUP_SOLVABILITY, I_O_ID, I_THM, LAGRANGE_THEOREM, LE_REFL,
        NORMAL_SUBGROUP_IMP_SUBGROUP, .. } := D.core2
  let { RING_1, RING_HOMOMORPHISM_1, RING_ORDER_MONOMORPHIC_IMAGE,
        RING_POW_SUBFIELD_GENERATED, .. } := D.core3
  let { ROOTS_OF_UNITY_HAS_SIZE_NONZERO, ROOTS_OF_UNITY_HAS_SIZE_PRIMITIVE,
        ROOTS_OF_UNITY_RING_ORDER_DIVISOR, SOLVABLE_GROUP_CYCLIC_CHAIN,
        SOLVABLE_GROUP_SUBGROUP, SUBFIELD_GENERATED, SUBFIELD_GENERATED_IDEMPOT,
        SUBFIELD_GENERATED_IDEMPOT_GEN, SUBFIELD_GENERATED_INC_GEN,
        SUBFIELD_GENERATED_RING_CARRIER, SUBFIELD_IMP_SUBRING_OF, SUBFIELD_OF_INTER,
        SUBFIELD_OF_SUBFIELD_GENERATED_EQ, SUBGROUP_OF_IMP_SUBSET,
        SUBGROUP_OF_SUBGROUP_GENERATED_REV, SUBSET_INTER, field_extension,
        num_INDUCTION, .. } := D.core4
  let { GALOIS_GROUP, .. } := BGaloisGroup
  let { FINITE_GALOIS_GROUP, .. } := BGaloisExtensions
  let { GALOIS_EXTENSION_EQ_CARD, GALOIS_IMP_FIELD_EXTENSION, .. } := BGaloisExtension
  let { fixed_field, .. } := BFixedFields
  let { FIXED_FIELD_GALOIS_GROUP, .. } := BArtin
  let { GALOIS_EXTENSION_SUBFIELD_GENERATED, GALOIS_GROUP_FIXED_FIELD,
        GALOIS_GROUP_INTERMEDIATE_SUBGROUP,
        GALOIS_GROUP_INTERMEDIATE_SUBGROUP_GENERATED, .. } := BGaloisCorrespondence
  let { GALOIS_EXTENSION_NORMAL_SUBGROUP, .. } := BGaloisRestriction
  let { GALOIS_COMPOSITUM, .. } := BNaturalIrrationalities
  let { RADICAL_EXTENSION_SIMPLE, .. } := BRadicalExtensions
  let { RADICAL_EXTENSION_BASE, RADICAL_EXTENSION_TRANS, .. } := BRadicalExtensions2
  let { KUMMER_CYCLIC_EXTENSION_EQ, .. } := BKummerTheory
  -- @@SCOPE END

  /- One step of a tower: if k has n distinct n-th roots of unity and n is a   -/
  /- multiple of [l:k], the fixed field of a normal subgroup H of the Galois   -/
  /- group with cyclic quotient is generated over k by an n-th root of an      -/
  /- element of k. Finiteness is implied: [l:k] divides n, which is nonzero.   -/

  let RADICAL_EXTENSION_CYCLIC_QUOTIENT ← prove
   r"!(h:A->B) k l n H.
     galois_extension(k,l) h /\
     extension_degree(k,l) h divides n /\
     {x | x IN ring_carrier k /\ ring_pow k x n = ring_1 k} HAS_SIZE n /\
     H normal_subgroup_of galois_group(k,l) h /\
     cyclic_group(quotient_group (galois_group(k,l) h) H)
     ==> radical_extension(k,subfield_generated l (fixed_field l H)) h"
   (← do
    let t1 ← TAUT (← q r"p /\ (q ==> r) ==> (p <=> q) ==> r")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ROOTS_OF_UNITY_HAS_SIZE_NONZERO) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"finite_extension(k:A ring,l:B ring) h") ASSUME_TAC THENL
     [ASM_MESON_TAC [EXTENSION_DEGREE_EQ_0, DIVIDES_ZERO], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"H:(B->B)->bool"]
      GALOIS_GROUP_FIXED_FIELD) THEN
    ASM_SIMP_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP] THEN
    ABBREV_TAC (← q r"s = fixed_field (l:B ring) H") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"H:(B->B)->bool"
      let ok := is_eq (concl th) &&
        (match rand (concl th) with | .ok u => u == c | .error _ => false)
      if !ok then throw "check"
      pure ((SUBST_ALL_TAC o SYM) th)) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      GALOIS_EXTENSION_NORMAL_SUBGROUP) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)",
                   ← q r"n:num"] KUMMER_CYCLIC_EXTENSION_EQ) THEN
    ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION] THEN
    MATCH_MP_TAC t1 THEN CONJ_TAC THENL
     [CONJ_TAC THENL
       [FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP ISOMORPHIC_GROUP_CYCLICITY) THEN
        FIRST_ASSUM ACCEPT_TAC,
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)"]
        GALOIS_EXTENSION_EQ_CARD) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC DIVIDES_TRANS THEN
      EXISTS_TAC (← q r"extension_degree(k:A ring,l:B ring) h") THEN
      ASM_SIMP_TAC [EXTENSION_DEGREE_SUBFIELD_GENERATED_DIVIDES],
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:B") STRIP_ASSUME_TAC) THEN
      MATCH_MP_TAC RADICAL_EXTENSION_SIMPLE THEN
      MAP_EVERY EXISTS_TAC [← q r"a:B", ← q r"n:num"] THEN
      ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION]]))

  /- The converse of Abel-Ruffini over a field with enough roots of unity. The -/
  /- chain c(0), ..., c(r) of SOLVABLE_GROUP_CYCLIC_CHAIN gives the fixed      -/
  /- fields F(i) of the c(i), with F(0) the image of k and F(r) = l; F(i+1) is -/
  /- the fixed field of the normal subgroup c(i+1), with cyclic quotient, of   -/
  /- the Galois group c(i) of l over F(i), whose roots of unity include those  -/
  /- of k. As above, finiteness follows from [l:k] dividing n.                 -/

  let SOLVABLE_IMP_RADICAL_EXTENSION ← prove
   r"!(h:A->B) k l n.
        galois_extension(k,l) h /\
        solvable_group(galois_group(k,l) h) /\
        extension_degree(k,l) h divides n /\
        {x | x IN ring_carrier k /\ ring_pow k x n = ring_1 k} HAS_SIZE n
        ==> radical_extension(k,l) h"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ROOTS_OF_UNITY_HAS_SIZE_NONZERO) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"finite_extension(k:A ring,l:B ring) h") ASSUME_TAC THENL
     [ASM_MESON_TAC [EXTENSION_DEGREE_EQ_0, DIVIDES_ZERO], ALL_TAC] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN
     (← q r"!s. s subfield_of l /\ IMAGE (h:A->B) (ring_carrier k) SUBSET s
          ==> {x | x IN s /\ ring_pow l x n = ring_1 l} HAS_SIZE n")
    (LABEL_TAC "roots") THENL
     [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"n:num"] ROOTS_OF_UNITY_HAS_SIZE_PRIMITIVE) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:A") STRIP_ASSUME_TAC) THEN
      X_GEN_TAC (← q r"s:B->bool") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"z:A"]
        RING_ORDER_MONOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"s:B->bool", ← q r"(h:A->B) z", ← q r"n:num", ← q r"n:num"]
        ROOTS_OF_UNITY_RING_ORDER_DIVISOR) THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, SUBFIELD_IMP_SUBRING_OF,
                   DIVIDES_REFL] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"galois_group(k:A ring,l:B ring) h")
      SOLVABLE_GROUP_CYCLIC_CHAIN) THEN
    ASM_SIMP_TAC [FINITE_GALOIS_GROUP, ← CONJUNCT1 (← CONJUNCT2 GALOIS_GROUP)] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:num") (X_CHOOSE_THEN (← q r"c:num->(B->B)->bool")
      (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
        (LABEL_TAC "c"))))) THEN
    SUBGOAL_THEN
     (← q r"!i. i <= r
          ==> (c:num->(B->B)->bool) i subgroup_of galois_group(k,l) (h:A->B)")
    (LABEL_TAC "sub") THENL
     [INDUCT_TAC THENL [ASM_REWRITE_TAC [CARRIER_SUBGROUP_OF], ALL_TAC] THEN
      DISCH_TAC THEN USE_THEN "c" (MP_TAC o SPEC (← q r"i:num")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      MESON_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP,
                SUBGROUP_OF_SUBGROUP_GENERATED_REV],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"fixed_field (l:B ring) {I} = ring_carrier l") ASSUME_TAC THENL
     [REWRITE_TAC [fixed_field, IN_SING, FORALL_UNWIND_THM2, I_THM] THEN
      SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i. i <= r
          ==> radical_extension
               (k,subfield_generated l (fixed_field l ((c:num->(B->B)->bool) i)))
               (h:A->B)")
    (MP_TAC o SPEC (← q r"r:num")) THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [LE_REFL, SUBFIELD_GENERATED_RING_CARRIER]] THEN
    MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
     [DISCH_TAC THEN
      ASM_SIMP_TAC [FIXED_FIELD_GALOIS_GROUP, RADICAL_EXTENSION_BASE],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"i:num") THEN DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                   ← q r"subfield_generated l
                     (fixed_field l ((c:num->(B->B)->bool) i))",
                   ← q r"subfield_generated l
                     (fixed_field l ((c:num->(B->B)->bool) (SUC i)))"]
      RADICAL_EXTENSION_TRANS) THEN
    ASM_REWRITE_TAC [I_O_ID] THEN DISCH_THEN MATCH_MP_TAC THEN
    USE_THEN "sub" (MP_TAC o SPEC (← q r"i:num")) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"(c:num->(B->B)->bool) i"] GALOIS_GROUP_FIXED_FIELD) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"u = fixed_field l ((c:num->(B->B)->bool) i)") THEN STRIP_TAC THEN
    USE_THEN "c" (MP_TAC o SPEC (← q r"i:num")) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"u:B->bool"]
      GALOIS_GROUP_INTERMEDIATE_SUBGROUP_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC RADICAL_EXTENSION_CYCLIC_QUOTIENT THEN
    EXISTS_TAC (← q r"n:num") THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"u:B->bool"]
        GALOIS_EXTENSION_SUBFIELD_GENERATED) THEN
      ASM_SIMP_TAC [],
      MATCH_MP_TAC DIVIDES_TRANS THEN
      EXISTS_TAC (← q r"extension_degree(k:A ring,l:B ring) h") THEN
      ASM_SIMP_TAC [EXTENSION_DEGREE_SUBFIELD_GENERATED_DIVIDES],
      ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD,
                   RING_POW_SUBFIELD_GENERATED, ← CONJUNCT2 SUBFIELD_GENERATED]])

  /- Natural irrationalities for solvable groups: if s is finite Galois over   -/
  /- the image of k with solvable Galois group, then for any intermediate      -/
  /- field t the compositum of s and t is finite Galois over t with solvable   -/
  /- Galois group, and its degree over t divides [s:k] (its Galois group is    -/
  /- isomorphic to a subgroup of that of s over k).                            -/

  let GALOIS_COMPOSITUM_SOLVABLE ← prove
   r"!(h:A->B) k l s t.
        field l /\ s subfield_of l /\ t subfield_of l /\
        IMAGE h (ring_carrier k) SUBSET s /\
        IMAGE h (ring_carrier k) SUBSET t /\
        finite_extension(k,subfield_generated l s) h /\
        galois_extension(k,subfield_generated l s) h /\
        solvable_group(galois_group(k,subfield_generated l s) h)
        ==> finite_extension
              (subfield_generated l t,subfield_generated l (s UNION t)) I /\
            galois_extension
              (subfield_generated l t,subfield_generated l (s UNION t)) I /\
            solvable_group
              (galois_group
                (subfield_generated l t,subfield_generated l (s UNION t)) I) /\
            extension_degree
              (subfield_generated l t,subfield_generated l (s UNION t)) I
            divides extension_degree(k,subfield_generated l s) h"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool", ← q r"t:B->bool"]
      GALOIS_COMPOSITUM) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"(s INTER t:B->bool) subfield_of subfield_generated l s /\
      IMAGE (h:A->B) (ring_carrier k) SUBSET s INTER t /\
      subfield_generated (subfield_generated l s) (s INTER t) =
      subfield_generated l (s INTER t)")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [SUBFIELD_OF_SUBFIELD_GENERATED_EQ, SUBFIELD_OF_INTER,
                   CARRIER_SUBFIELD_GENERATED_SUBFIELD, SUBSET_INTER,
                   INTER_SUBSET] THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_IDEMPOT_GEN THEN
      ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, INTER_SUBSET],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)",
                   ← q r"s INTER t:B->bool"]
      GALOIS_GROUP_INTERMEDIATE_SUBGROUP_GENERATED) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)",
                   ← q r"s INTER t:B->bool"]
      GALOIS_GROUP_INTERMEDIATE_SUBGROUP) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THENL
     [FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_SOLVABILITY o
        MATCH_MP GROUP_ISOMORPHISM_IMP_ISOMORPHIC) THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC SOLVABLE_GROUP_SUBGROUP THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"subfield_generated l (t:B->bool)",
                   ← q r"subfield_generated l (s UNION t:B->bool)"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)"]
      GALOIS_EXTENSION_EQ_CARD) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT (DISCH_THEN (SUBST1_TAC o SYM)) THEN
    SUBGOAL_THEN
     (← q r"CARD(group_carrier
            (galois_group
              (subfield_generated l t,subfield_generated l (s UNION t)) I)) =
      CARD(group_carrier
            (galois_group
              (subfield_generated l (s INTER t),subfield_generated l s)
              (I:B->B)))")
    SUBST1_TAC THENL
     [MATCH_MP_TAC CARD_EQ_CARD_IMP THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"group_carrier(galois_group(k,subfield_generated l s)
                                              (h:A->B))") THEN
        ASM_SIMP_TAC [FINITE_GALOIS_GROUP, SUBGROUP_OF_IMP_SUBSET],
        FIRST_ASSUM (ACCEPT_TAC o MATCH_MP CARD_EQ_GROUP_ISOMORPHIC_IMAGE)],
      MATCH_MP_TAC LAGRANGE_THEOREM THEN
      ASM_SIMP_TAC [FINITE_GALOIS_GROUP]])

  /- Adjoining a root of unity to the image of k gives a radical extension.    -/

  let RADICAL_EXTENSION_ROOT_OF_UNITY ← prove
   r"!(h:A->B) k l z n.
        field_extension(k,l) h /\ z IN ring_carrier l /\ ~(n = 0) /\
        ring_pow l z n = ring_1 l
        ==> radical_extension
             (k,subfield_generated l (z INSERT IMAGE h (ring_carrier k))) h"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RADICAL_EXTENSION_SIMPLE THEN
    MAP_EVERY EXISTS_TAC [← q r"z:B", ← q r"n:num"] THEN
    ASM_REWRITE_TAC [RING_POW_SUBFIELD_GENERATED, SUBFIELD_GENERATED_IDEMPOT] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [],
      MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN ASM_REWRITE_TAC [IN_INSERT],
      REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"ring_1 k:A") THEN
      REWRITE_TAC [RING_1] THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC RING_HOMOMORPHISM_1 THEN
      MATCH_MP_TAC FIELD_EXTENSION_IMP_HOMOMORPHISM THEN
      FIRST_ASSUM ACCEPT_TAC])

  -- @@RETURN BEGIN
  return { RADICAL_EXTENSION_CYCLIC_QUOTIENT, SOLVABLE_IMP_RADICAL_EXTENSION,
           GALOIS_COMPOSITUM_SOLVABLE, RADICAL_EXTENSION_ROOT_OF_UNITY }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Solvable Galois groups and radicals, continued: adjoining a root of unity -/
/- of suitable order to an image of l gives a radical extension, and the     -/
/- iff forms of solvability by radicals.                                     -/
/- ------------------------------------------------------------------------- -/

structure SolvableRadicals2 where
  -- @@FIELDS
  SOLVABLE_IMP_RADICAL_ROOT_OF_UNITY : thm
  SOLVABLE_IMP_RADICAL : thm
  GALOIS_SOLVABLE_EQ_RADICAL : thm
  SOLVABLE_BY_RADICALS_EQ : thm
  SOLVABLE_BY_RADICALS_IRREDUCIBLE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupSolvableRadicals2 [HolBase] (D : GaloisDeps) (BGaloisExtension : GaloisExtension) (BGaloisIsomorphic : GaloisIsomorphic) (BRadicalExtensions : RadicalExtensions) (BRadicalExtensions2 : RadicalExtensions2) (BRadicalElements : RadicalElements) (BRadicalGaloisGroups : RadicalGaloisGroups) (BSolvableRadicals : SolvableRadicals) :
    ExceptT String IO SolvableRadicals2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, .. } := D
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS,
        ALGEBRAICALLY_CLOSED_FIELD_PRIMITIVE_ROOT_OF_UNITY,
        CARRIER_SUBFIELD_GENERATED_SUBFIELD, DIVIDES_0, DIVIDES_REFL, DIVIDES_TRANS,
        DIVIDES_ZERO, EXTENSION_DEGREE_EQ_0, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_IMP_MONOMORPHISM, FIELD_EXTENSION_IMP_SUBSET,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_EXTENSION_TRANS,
        FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FIELD_SUBFIELD_GENERATED,
        FINITE_EXTENSION_HOMOMORPHIC_IMAGE, FINITE_IMAGE, FINITE_IMP_FIELD_EXTENSION,
        FINITE_IMP_FINITELY_GENERATED_EXTENSION, FORALL_IN_IMAGE, FUN_IN_IMAGE, .. } := D.core1
  let { IMAGE_SUBSET, IMAGE_UNION, IMAGE_o, IN_ELIM_THM, IN_INSERT,
        IN_RING_POLYNOMIAL_CARRIER_COMPOSE, IN_UNION, IRREDUCIBLE_IMP_POLY_DEG_NZ,
        ISOMORPHIC_GROUP_SOLVABILITY, I_O_ID, I_THM, NORMAL_IMP_ALGEBRAIC_EXTENSION,
        POLY_DEG_MONOMORPHIC_IMAGE, .. } := D.core2
  let { RING_CHAR_MONOMORPHIC_IMAGE, RING_HOMOMORPHISM_IN_CARRIER,
        RING_HOMOMORPHISM_SUBFIELD_INCLUSION, RING_ISOMORPHISM_ONTO_SUBFIELD_IMAGE,
        RING_MONOMORPHISM_COMPOSE, RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_POLYNOMIAL,
        RING_POW_RING_ORDER, RING_POW_SUBFIELD_GENERATED, .. } := D.core3
  let { ROOTS_OF_UNITY_RING_ORDER_DIVISOR, SEPARABLE_EXTENSION_CHAR0,
        SPLITTING_EXTENSION_GENERATED_BY_ROOTS, SPLITTING_EXTENSION_IMP_NORMAL,
        SPLITTING_EXTENSION_IN_POLY_RING, SPLITTING_EXTENSION_NONZERO,
        SPLITTING_IMP_FINITE_EXTENSION, SUBFIELD_GENERATED,
        SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE,
        SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED, SUBFIELD_GENERATED_INC_GEN,
        SUBFIELD_GENERATED_MINIMAL, SUBFIELD_GENERATED_UNION_RIGHT,
        SUBFIELD_IMP_SUBRING_OF, SUBFIELD_SUBFIELD_GENERATED, SUBSET,
        SUBSET_CARRIER_SUBFIELD_GENERATED, UNION_SUBSET, algebraically_closed_field,
        field_extension, finitely_generated_extension, o_THM, poly_splits_over, .. } := D.core4
  let { GALOIS_IMP_FIELD_EXTENSION, galois_extension, .. } := BGaloisExtension
  let { GALOIS_EXTENSION_HOMOMORPHIC_IMAGE, ISOMORPHIC_GALOIS_GROUPS_SPLITTING, .. } := BGaloisIsomorphic
  let { RADICAL_IMP_FIELD_EXTENSION, .. } := BRadicalExtensions
  let { RADICAL_EXTENSION_TRANS, .. } := BRadicalExtensions2
  let { RADICAL_ELEMENTS_COMMON_RADICAL_EXTENSION, RADICAL_ELEMENT_BASE,
        SUBFIELD_OF_RADICAL_ELEMENTS, radical_element, .. } := BRadicalElements
  let { RADICAL_EXTENSION_SOLVABLE, RADICAL_ROOT_SOLVABLE, .. } := BRadicalGaloisGroups
  let { GALOIS_COMPOSITUM_SOLVABLE, RADICAL_EXTENSION_ROOT_OF_UNITY,
        SOLVABLE_IMP_RADICAL_EXTENSION, .. } := BSolvableRadicals
  -- @@SCOPE END

  /- Adjoining a root of unity: if l is Galois over k with solvable Galois     -/
  /- group, j embeds l into a field m and z in m has finite order a multiple   -/
  /- of [l:k] (so l is finite over k), then the subfield of m generated by z   -/
  /- and the image of l is radical over k. No assumption on the characteristic -/
  /- is needed here.                                                           -/

  let SOLVABLE_IMP_RADICAL_ROOT_OF_UNITY ← prove
   r"!(h:A->B) (j:B->C) k l m z.
        galois_extension(k,l) h /\
        solvable_group(galois_group(k,l) h) /\
        field m /\ ring_homomorphism(l,m) j /\
        z IN ring_carrier m /\ ~(ring_order m z = 0) /\
        extension_degree(k,l) h divides ring_order m z
        ==> radical_extension
             (k,subfield_generated m (z INSERT IMAGE j (ring_carrier l)))
             (j o h)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"finite_extension(k:A ring,l:B ring) h") ASSUME_TAC THENL
     [ASM_MESON_TAC [EXTENSION_DEGREE_EQ_0, DIVIDES_ZERO], ALL_TAC] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN (← q r"field_extension(k:A ring,m:C ring) ((j:B->C) o (h:A->B))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_TRANS THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_REWRITE_TAC [field_extension] THEN
      MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"IMAGE ((j:B->C) o (h:A->B)) (ring_carrier k) SUBSET
      IMAGE j (ring_carrier l) /\
      ring_carrier(subfield_generated m
       (z INSERT IMAGE ((j:B->C) o (h:A->B)) (ring_carrier k))) subfield_of m /\
      IMAGE ((j:B->C) o (h:A->B)) (ring_carrier k) SUBSET
      ring_carrier(subfield_generated m
       (z INSERT IMAGE ((j:B->C) o (h:A->B)) (ring_carrier k))) /\
      (z:C) IN ring_carrier(subfield_generated m
       (z INSERT IMAGE ((j:B->C) o (h:A->B)) (ring_carrier k)))")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED] THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [IMAGE_o] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
        MATCH_MP_TAC FIELD_EXTENSION_IMP_SUBSET THEN FIRST_ASSUM ACCEPT_TAC,
        MATCH_MP_TAC SUBSET_CARRIER_SUBFIELD_GENERATED THEN
        ASM_SIMP_TAC [FIELD_EXTENSION_IMP_SUBSET] THEN SET_TAC [],
        MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
        ASM_REWRITE_TAC [IN_INSERT]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
      GALOIS_EXTENSION_HOMOMORPHIC_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
      FINITE_EXTENSION_HOMOMORPHIC_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"j:B->C", ← q r"l:B ring", ← q r"m:C ring"]
      RING_ISOMORPHISM_ONTO_SUBFIELD_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_SOLVABILITY) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    ABBREV_TAC (← q r"N = ring_order (m:C ring) z") THEN
    ABBREV_TAC (← q r"s = IMAGE (j:B->C) (ring_carrier l)") THEN
    ABBREV_TAC
     (← q r"t = ring_carrier(subfield_generated m
            (z INSERT IMAGE ((j:B->C) o (h:A->B)) (ring_carrier k)))") THEN
    MP_TAC (← ISPECL [← q r"(j:B->C) o (h:A->B)", ← q r"k:A ring", ← q r"m:C ring", ← q r"s:C->bool",
                   ← q r"t:C->bool"] GALOIS_COMPOSITUM_SOLVABLE) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"subfield_generated m (s UNION t) = subfield_generated m ((z:C) INSERT s)")
    SUBST_ALL_TAC THENL
     [EXPAND_TAC "t" THEN REWRITE_TAC [SUBFIELD_GENERATED_UNION_RIGHT] THEN
      AP_TERM_TAC THEN UNDISCH_TAC
       (← q r"IMAGE ((j:B->C) o (h:A->B)) (ring_carrier k) SUBSET s") THEN
      SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"I:C->C", ← q r"subfield_generated m (t:C->bool)",
                   ← q r"subfield_generated m ((z:C) INSERT s)", ← q r"N:num"]
      SOLVABLE_IMP_RADICAL_EXTENSION) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC DIVIDES_TRANS THEN
        EXISTS_TAC (← q r"extension_degree(k:A ring,l:B ring) h") THEN
        ASM_REWRITE_TAC [],
        ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD,
                     RING_POW_SUBFIELD_GENERATED,
                     ← CONJUNCT2 SUBFIELD_GENERATED] THEN
        MP_TAC (← ISPECL [← q r"m:C ring", ← q r"t:C->bool", ← q r"z:C", ← q r"N:num", ← q r"N:num"]
          ROOTS_OF_UNITY_RING_ORDER_DIVISOR) THEN
        ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, SUBFIELD_IMP_SUBRING_OF,
                     DIVIDES_REFL]],
      DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"radical_extension(k,subfield_generated m t) ((j:B->C) o (h:A->B))")
    ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN
      REWRITE_TAC [SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
      MATCH_MP_TAC RADICAL_EXTENSION_ROOT_OF_UNITY THEN
      EXISTS_TAC (← q r"N:num") THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "N" THEN MATCH_MP_TAC RING_POW_RING_ORDER THEN
      FIRST_ASSUM ACCEPT_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"(j:B->C) o (h:A->B)", ← q r"I:C->C", ← q r"k:A ring",
                   ← q r"subfield_generated m (t:C->bool)",
                   ← q r"subfield_generated m ((z:C) INSERT s)"]
      RADICAL_EXTENSION_TRANS) THEN
    ASM_REWRITE_TAC [I_O_ID])

  /- The converse of Abel-Ruffini: if the characteristic of k does not divide  -/
  /- [l:k], every element of a finite Galois extension l of k with solvable    -/
  /- Galois group is expressible by radicals over k in any algebraically       -/
  /- closed field m into which l embeds (m has an element of order [l:k]).     -/
  /- No finiteness hypothesis is needed: the condition forces [l:k] <> 0.      -/

  let SOLVABLE_IMP_RADICAL ← prove
   r"!(h:A->B) (j:B->C) k l m.
        galois_extension(k,l) h /\
        ~(ring_char k divides extension_degree(k,l) h) /\
        solvable_group(galois_group(k,l) h) /\
        algebraically_closed_field m /\ ring_homomorphism(l,m) j
        ==> !x. x IN ring_carrier l ==> radical_element(k,m) (j o h) (j x)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GALOIS_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    SUBGOAL_THEN (← q r"ring_monomorphism(l:B ring,m:C ring) j") ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"m:C ring", ← q r"extension_degree(k:A ring,l:B ring) h"]
      ALGEBRAICALLY_CLOSED_FIELD_PRIMITIVE_ROOT_OF_UNITY) THEN
    ANTS_TAC THENL
     [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"m:C ring", ← q r"(j:B->C) o (h:A->B)"]
        RING_CHAR_MONOMORPHIC_IMAGE) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC RING_MONOMORPHISM_COMPOSE THEN
        EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
        DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_REWRITE_TAC []],
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:C") STRIP_ASSUME_TAC o CONJUNCT2)] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                   ← q r"z:C"] SOLVABLE_IMP_RADICAL_ROOT_OF_UNITY) THEN
    ASM_REWRITE_TAC [DIVIDES_REFL] THEN ANTS_TAC THENL
     [DISCH_TAC THEN UNDISCH_TAC
       (← q r"~(ring_char(k:A ring) divides extension_degree(k,l) (h:A->B))") THEN
      ASM_REWRITE_TAC [DIVIDES_0],
      DISCH_TAC] THEN
    X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN REWRITE_TAC [radical_element] THEN
    EXISTS_TAC
     (← q r"ring_carrier(subfield_generated m (z INSERT IMAGE (j:B->C)
                                                   (ring_carrier l)))") THEN
    ASM_SIMP_TAC [SUBFIELD_SUBFIELD_GENERATED,
                 SUBFIELD_GENERATED_BY_SUBFIELD_GENERATED] THEN
    MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
    ASM_SIMP_TAC [IN_INSERT, FUN_IN_IMAGE] THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
    EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [])

  /- In characteristic zero, for a finite normal extension: the Galois group   -/
  /- is solvable exactly when every element is expressible by radicals in an   -/
  /- algebraically closed field into which l embeds. For the converse          -/
  /- direction finitely many generators of l lie in one radical subextension   -/
  /- of m.                                                                     -/

  let GALOIS_SOLVABLE_EQ_RADICAL ← prove
   r"!(h:A->B) (j:B->C) k l m.
        ring_char k = 0 /\ finite_extension(k,l) h /\ normal_extension(k,l) h /\
        algebraically_closed_field m /\ ring_homomorphism(l,m) j
        ==> (solvable_group(galois_group(k,l) h) <=>
             !x. x IN ring_carrier l ==> radical_element(k,m) (j o h) (j x))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    SUBGOAL_THEN (← q r"field_extension(l:B ring,m:C ring) j") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [field_extension] THEN
      MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    EQ_TAC THENL
     [DISCH_TAC THEN MATCH_MP_TAC SOLVABLE_IMP_RADICAL THEN
      ASM_REWRITE_TAC [DIVIDES_ZERO, galois_extension] THEN CONJ_TAC THENL
       [MATCH_MP_TAC SEPARABLE_EXTENSION_CHAR0 THEN
        ASM_SIMP_TAC [NORMAL_IMP_ALGEBRAIC_EXTENSION],
        ASM_SIMP_TAC [EXTENSION_DEGREE_EQ_0]],
      DISCH_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FINITE_IMP_FINITELY_GENERATED_EXTENSION) THEN
    REWRITE_TAC [finitely_generated_extension] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:B->bool") STRIP_ASSUME_TAC o CONJUNCT2) THEN
    SUBGOAL_THEN (← q r"field_extension(k:A ring,m:C ring) ((j:B->C) o (h:A->B))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_TRANS THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"(j:B->C) o (h:A->B)", ← q r"k:A ring", ← q r"m:C ring",
                   ← q r"IMAGE (j:B->C) b"]
      RADICAL_ELEMENTS_COMMON_RADICAL_EXTENSION) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
     [ASM SET_TAC [], DISCH_THEN (X_CHOOSE_THEN (← q r"s:C->bool") STRIP_ASSUME_TAC)] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->C) o (h:A->B)", ← q r"j:B->C", ← q r"k:A ring",
                   ← q r"l:B ring", ← q r"subfield_generated m (s:C->bool)"]
      RADICAL_EXTENSION_SOLVABLE) THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [o_THM] THEN
    MATCH_MP_TAC FIELD_EXTENSION_IMP_HOMOMORPHISM THEN
    MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"ring_carrier(l:B ring) =
      ring_carrier(subfield_generated l
        (IMAGE (h:A->B) (ring_carrier k) UNION b))")
    SUBST1_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"m:C ring", ← q r"j:B->C",
                   ← q r"IMAGE (h:A->B) (ring_carrier k) UNION b"]
      SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED, FIELD_EXTENSION_IMP_MONOMORPHISM,
                   UNION_SUBSET, FIELD_EXTENSION_IMP_SUBSET],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC SUBFIELD_GENERATED_MINIMAL THEN
    ASM_REWRITE_TAC [IMAGE_UNION, UNION_SUBSET, ← GSYM IMAGE_o] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP FIELD_EXTENSION_IMP_SUBSET o
      MATCH_MP RADICAL_IMP_FIELD_EXTENSION) THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD])

  /- The polynomial forms in characteristic zero: the splitting extension of p -/
  /- has a solvable Galois group exactly when all roots of p in an             -/
  /- algebraically closed field m are expressible by radicals (the roots       -/
  /- generate a splitting extension of p inside m), and for irreducible p      -/
  /- exactly when some root is.                                                -/

  let SOLVABLE_BY_RADICALS_EQ ← prove
   r"!(h:A->B) (g:A->C) k l m p.
        ring_char k = 0 /\ splitting_extension(k,l) h p /\
        algebraically_closed_field m /\ field_extension(k,m) g
        ==> (solvable_group(galois_group(k,l) h) <=>
             !x. x IN ring_carrier m /\ poly_eval m (g o p) x = ring_0 m
                 ==> radical_element(k,m) g x)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_IN_POLY_RING) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_NONZERO) THEN
    ABBREV_TAC
     (← q r"r = {x | x IN ring_carrier m /\
               poly_eval m ((g:A->C) o (p:(1->num)->A)) x = ring_0 m}") THEN
    SUBGOAL_THEN
     (← q r"splitting_extension
       (k,subfield_generated m (IMAGE (g:A->C) (ring_carrier k) UNION r)) g p")
    ASSUME_TAC THENL
     [EXPAND_TAC "r" THEN MATCH_MP_TAC SPLITTING_EXTENSION_GENERATED_BY_ROOTS THEN
      ASM_REWRITE_TAC [poly_splits_over] THEN
      MATCH_MP_TAC ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring",
                   ← q r"subfield_generated m
                      (IMAGE (g:A->C) (ring_carrier k) UNION r)",
                   ← q r"p:(1->num)->A"] ISOMORPHIC_GALOIS_GROUPS_SPLITTING) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_SOLVABILITY) THEN
    MP_TAC (← ISPECL [← q r"g:A->C", ← q r"I:C->C", ← q r"k:A ring",
                   ← q r"subfield_generated m
                      (IMAGE (g:A->C) (ring_carrier k) UNION r)",
                   ← q r"m:C ring"] GALOIS_SOLVABLE_EQ_RADICAL) THEN
    ASM_REWRITE_TAC [RING_HOMOMORPHISM_SUBFIELD_INCLUSION, I_O_ID, I_THM] THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [SPLITTING_IMP_FINITE_EXTENSION,
                    SPLITTING_EXTENSION_IMP_NORMAL],
      DISCH_THEN SUBST1_TAC] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"x:C") THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
      EXPAND_TAC "r" THEN ASM_REWRITE_TAC [IN_UNION, IN_ELIM_THM],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"m:C ring", ← q r"{x | radical_element(k,m) (g:A->C) x}",
                   ← q r"IMAGE (g:A->C) (ring_carrier k) UNION r"]
      SUBFIELD_GENERATED_MINIMAL) THEN
    ASM_SIMP_TAC [SUBFIELD_OF_RADICAL_ELEMENTS] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [UNION_SUBSET, SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [RADICAL_ELEMENT_BASE] THEN EXPAND_TAC "r" THEN
      REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [],
      REWRITE_TAC [SUBSET, IN_ELIM_THM]])

  let SOLVABLE_BY_RADICALS_IRREDUCIBLE_EQ ← prove
   r"!(h:A->B) (g:A->C) k l m p.
        ring_char k = 0 /\ splitting_extension(k,l) h p /\
        ring_irreducible(poly_ring k (:1)) p /\
        algebraically_closed_field m /\ field_extension(k,m) g
        ==> (solvable_group(galois_group(k,l) h) <=>
             ?x. x IN ring_carrier m /\ poly_eval m (g o p) x = ring_0 m /\
                 radical_element(k,m) g x)"
   (← do
    let m1 ← MESON []
     (← q r"(?x:C. P x /\ R x) ==> (!x. P x /\ R x ==> Q x)
      ==> (?x. P x /\ R x /\ Q x)")
    pure (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC,
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:C") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                     ← q r"p:(1->num)->A", ← q r"x:C"] RADICAL_ROOT_SOLVABLE) THEN
      ASM_REWRITE_TAC []] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                   ← q r"p:(1->num)->A"] SOLVABLE_BY_RADICALS_EQ) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    MATCH_MP_TAC m1 THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT2 o
      GEN_REWRITE_RULE I [algebraically_closed_field]) THEN
    DISCH_THEN MATCH_MP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_IN_POLY_RING) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN
      ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"m:C ring", ← q r"g:A->C", ← q r"p:(1->num)->A"]
      POLY_DEG_MONOMORPHIC_IMAGE) THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL, IRREDUCIBLE_IMP_POLY_DEG_NZ]))

  -- @@RETURN BEGIN
  return { SOLVABLE_IMP_RADICAL_ROOT_OF_UNITY, SOLVABLE_IMP_RADICAL,
           GALOIS_SOLVABLE_EQ_RADICAL, SOLVABLE_BY_RADICALS_EQ,
           SOLVABLE_BY_RADICALS_IRREDUCIBLE_EQ }
  -- @@RETURN END

end HolLibrary.Galois
