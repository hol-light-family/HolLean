    CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"ring_automorphism l (e:B->B)") MP_TAC THENL
       [MATCH_MP_TAC RING_AUTOMORPHISM_EQ THEN EXISTS_TAC (← q r"f:B->B") THEN
        ASM_SIMP_TAC [],
