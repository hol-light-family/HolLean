/-- RingTheory's `wPart` (copied verbatim).  `W(MP_TAC o PART_MATCH f th o g
    o snd)`: match `th`'s part `f` against the part `g` of the goal, and
    MP_TAC the instance. -/
def wPart [HolBase] (g : term → Except String term) (f : term → Except String term)
    (th : thm) : tactic := fun gl =>
  ExceptT.run do
    let t ← liftExcept (g gl.2)
    ExceptT.mk (MP_TAC (← PART_MATCH f th t) gl)

/- ------------------------------------------------------------------------- -/
/- The Galois group of a field extension (k,l) h: the automorphisms of l     -/
/- fixing the image of k pointwise, as a subgroup of the symmetric group on  -/
/- the carrier of l (so its elements are the identity outside the carrier).  -/
/- ------------------------------------------------------------------------- -/

structure GaloisGroup where
  -- @@FIELDS
  galois_group : thm
  GALOIS_GROUP : thm
  IN_GALOIS_GROUP : thm
  GALOIS_GROUP_SUBGROUP : thm
  SUBGROUP_GENERATED_GALOIS_GROUP : thm
  GALOIS_GROUP_INVERSE : thm
  GALOIS_GROUP_COMPOSE : thm
  GALOIS_GROUP_PERMUTES : thm
  GALOIS_GROUP_RING_AUTOMORPHISM : thm
  GALOIS_GROUP_RING_HOMOMORPHISM : thm
  GALOIS_GROUP_FIXES : thm
  GALOIS_GROUP_IN_CARRIER : thm
  GALOIS_GROUP_IMAGE_INVERSE : thm
  GALOIS_GROUP_RING_MONOMORPHISM : thm
  GALOIS_GROUP_I : thm
  GALOIS_GROUP_ACTION : thm
  GALOIS_GROUP_POLY_EVAL : thm
  GALOIS_GROUP_LOCAL : thm
  GALOIS_GROUP_ANTIMONO : thm
  GALOIS_GROUP_EQ_IMAGE : thm
  TRIVIAL_GALOIS_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisGroup [HolBase] (D : GaloisDeps) :
    ExceptT String IO GaloisGroup := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, EQ_TRANS, EXTENSION, FINITE_EMPTY,
        FINITE_INSERT, FINITE_SING, FORALL_IN_IMAGE, FORALL_IN_INSERT,
        FORALL_UNWIND_THM2, FUN_EQ_THM, GROUP_ID, GROUP_INV, GROUP_MUL, .. } := D.core1
  let { IMAGE_EQ, IMAGE_I, IMAGE_ID, IMAGE_o, INTER, IN_ELIM_THM, IN_IMAGE,
        IN_POLY_RING_CARRIER, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, IN_SING, IN_UNIV,
        I_THM, NOT_IN_EMPTY, PERMUTES_COMPOSE, PERMUTES_EQ, PERMUTES_I, PERMUTES_IMAGE,
        PERMUTES_INJECTIVE, PERMUTES_INVERSE, PERMUTES_INVERSES, PERMUTES_IN_IMAGE,
        POLY_EVAL_HOMOMORPHIC_IMAGE, .. } := D.core2
  let { RING_AUTOMORPHISM_COMPOSE, RING_AUTOMORPHISM_I, RING_HOMOMORPHISM_0,
        RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_MUL,
        RING_HOMOMORPHISM_NEG, RING_ISOMORPHISM, RING_ISOMORPHISM_IMP_HOMOMORPHISM,
        RING_ISOMORPHISM_IMP_MONOMORPHISM, RING_ISOMORPHISM_INVERSE, .. } := D.core3
  let { SUBGROUP_GENERATED, SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_RESTRICT, SUBGROUP_SUBGROUP_GENERATED, SUBSET, SUBSET_REFL,
        SYMMETRIC_GROUP, group_action, o_THM, ring_automorphism, ring_homomorphism,
        ring_polynomial, ring_powerseries, subgroup_of, trivial_group, .. } := D.core4
  -- @@SCOPE END

  let galois_group ← new_definition
   r"galois_group (k:A ring,l:B ring) (h:A->B) =
    subgroup_generated (symmetric_group (ring_carrier l))
      {f | ring_automorphism l f /\ !x. x IN ring_carrier k ==> f(h x) = h x}"

  let GALOIS_GROUP ← prove
   r"(!(h:A->B) k l.
        group_carrier(galois_group(k,l) h) =
        {f | f permutes ring_carrier l /\ ring_automorphism l f /\
             !x. x IN ring_carrier k ==> f(h x) = h x}) /\
   (!(h:A->B) k l. group_id(galois_group(k,l) h) = I) /\
   (!(h:A->B) k l. group_inv(galois_group(k,l) h) = inverse) /\
   (!(h:A->B) k l. group_mul(galois_group(k,l) h) = (o))"
   (CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [galois_group, SUBGROUP_GENERATED, SYMMETRIC_GROUP]] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [galois_group] THEN
    ONCE_REWRITE_TAC [SUBGROUP_GENERATED_RESTRICT] THEN
    REWRITE_TAC [SYMMETRIC_GROUP, INTER, IN_ELIM_THM] THEN
    MATCH_MP_TAC CARRIER_SUBGROUP_GENERATED_SUBGROUP THEN
    REWRITE_TAC [subgroup_of, SYMMETRIC_GROUP, SUBSET, IN_ELIM_THM] THEN
    SIMP_TAC [PERMUTES_I, RING_AUTOMORPHISM_I, I_THM] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:B->B") THEN STRIP_TAC THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP PERMUTES_INVERSES) THEN
      ASM_SIMP_TAC [PERMUTES_INVERSE] THEN CONJ_TAC THENL
       [REWRITE_TAC [ring_automorphism] THEN
        MATCH_MP_TAC RING_ISOMORPHISM_INVERSE THEN
        EXISTS_TAC (← q r"f:B->B") THEN ASM_REWRITE_TAC [← GSYM ring_automorphism],
        ASM_MESON_TAC []],
      MAP_EVERY X_GEN_TAC [← q r"f:B->B", ← q r"g:B->B"] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [PERMUTES_COMPOSE, RING_AUTOMORPHISM_COMPOSE, o_THM]])

  let IN_GALOIS_GROUP ← prove
   r"!(h:A->B) f k l.
        f IN group_carrier(galois_group(k,l) h) <=>
        f permutes ring_carrier l /\ ring_automorphism l f /\
        !x. x IN ring_carrier k ==> f(h x) = h x"
   (REWRITE_TAC [GALOIS_GROUP, IN_ELIM_THM])

  let GALOIS_GROUP_SUBGROUP ← prove
   r"!(h:A->B) k l.
        group_carrier(galois_group(k,l) h) subgroup_of
        symmetric_group(ring_carrier l)"
   (REWRITE_TAC [galois_group, SUBGROUP_SUBGROUP_GENERATED])

  let SUBGROUP_GENERATED_GALOIS_GROUP ← prove
   r"!(h:A->B) k l.
        subgroup_generated (symmetric_group(ring_carrier l))
                           (group_carrier(galois_group(k,l) h)) =
        galois_group(k,l) h"
   (REWRITE_TAC [galois_group, SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED])

  let GALOIS_GROUP_INVERSE ← prove
   r"!(h:A->B) f k l.
        f IN group_carrier(galois_group(k,l) h)
        ==> inverse f IN group_carrier(galois_group(k,l) h)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"f:B->B"] GROUP_INV) THEN
    ASM_REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP))])

  let GALOIS_GROUP_COMPOSE ← prove
   r"!(h:A->B) f g k l.
        f IN group_carrier(galois_group(k,l) h) /\
        g IN group_carrier(galois_group(k,l) h)
        ==> f o g IN group_carrier(galois_group(k,l) h)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"galois_group(k:A ring,l:B ring) h", ← q r"f:B->B", ← q r"g:B->B"]
      GROUP_MUL) THEN
    ASM_REWRITE_TAC [← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 GALOIS_GROUP))])

  let GALOIS_GROUP_PERMUTES ← prove
   r"!(h:A->B) f k l.
        f IN group_carrier(galois_group(k,l) h) ==> f permutes ring_carrier l"
   (SIMP_TAC [IN_GALOIS_GROUP])

  let GALOIS_GROUP_RING_AUTOMORPHISM ← prove
   r"!(h:A->B) f k l.
        f IN group_carrier(galois_group(k,l) h) ==> ring_automorphism l f"
   (SIMP_TAC [IN_GALOIS_GROUP])

  let GALOIS_GROUP_RING_HOMOMORPHISM ← prove
   r"!(h:A->B) f k l.
        f IN group_carrier(galois_group(k,l) h) ==> ring_homomorphism(l,l) f"
   (SIMP_TAC [IN_GALOIS_GROUP, ring_automorphism,
              RING_ISOMORPHISM_IMP_HOMOMORPHISM])

  let GALOIS_GROUP_FIXES ← prove
   r"!(h:A->B) f k l x.
        f IN group_carrier(galois_group(k,l) h) /\ x IN ring_carrier k
        ==> f(h x) = h x"
   (SIMP_TAC [IN_GALOIS_GROUP])

  let GALOIS_GROUP_IN_CARRIER ← prove
   r"!(h:A->B) f k l x.
        f IN group_carrier(galois_group(k,l) h) /\ x IN ring_carrier l
        ==> f x IN ring_carrier l"
   (MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_IN_IMAGE])

  let GALOIS_GROUP_IMAGE_INVERSE ← prove
   r"!(h:A->B) f k l s.
        f IN group_carrier(galois_group(k,l) h) /\ IMAGE f s = s
        ==> IMAGE (inverse f) s = s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP GALOIS_GROUP_PERMUTES) THEN
    DISCH_THEN (STRIP_ASSUME_TAC o MATCH_MP PERMUTES_INVERSES) THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← SYM th])) THEN
    REWRITE_TAC [← GSYM IMAGE_o] THEN
    MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC (← q r"IMAGE (\x:B. x) s") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC IMAGE_EQ THEN ASM_REWRITE_TAC [o_THM],
      REWRITE_TAC [IMAGE_ID]])

  let GALOIS_GROUP_RING_MONOMORPHISM ← prove
   r"!(h:A->B) f k l.
        f IN group_carrier(galois_group(k,l) h) ==> ring_monomorphism(l,l) f"
   (MESON_TAC [GALOIS_GROUP_RING_AUTOMORPHISM, ring_automorphism,
               RING_ISOMORPHISM_IMP_MONOMORPHISM])

  let GALOIS_GROUP_I ← prove
   r"!(h:A->B) k l. I IN group_carrier(galois_group(k,l) h)"
   (MESON_TAC [GROUP_ID, GALOIS_GROUP])

  let GALOIS_GROUP_ACTION ← prove
   r"(!(h:A->B) k l.
        group_action (galois_group(k,l) h) (ring_carrier l) (\f x. f x)) /\
   (!(h:A->B) k l. group_action (galois_group(k,l) h) (:B->bool) IMAGE)"
   (REWRITE_TAC [group_action, ← CONJUNCT2 GALOIS_GROUP, IN_UNIV] THEN
    REWRITE_TAC [I_THM, o_THM, IMAGE_I, IMAGE_o] THEN
    MESON_TAC [GALOIS_GROUP_PERMUTES, PERMUTES_IN_IMAGE])

  let GALOIS_GROUP_POLY_EVAL ← prove
   r"!(h:A->B) f k l p x.
        ring_homomorphism(k,l) h /\ f IN group_carrier(galois_group(k,l) h) /\
        p IN ring_carrier(poly_ring k (:1)) /\ x IN ring_carrier l
        ==> poly_eval l (h o p) (f x) = f(poly_eval l (h o p) x)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"x:B", ← q r"f:B->B",
                      ← q r"(h:A->B) o (p:(1->num)->A)"]
      POLY_EVAL_HOMOMORPHIC_IMAGE) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM,
                     IN_RING_POLYNOMIAL_CARRIER_COMPOSE],
      DISCH_THEN SUBST1_TAC] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, o_THM] THEN X_GEN_TAC (← q r"m:1->num") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"(p:(1->num)->A) m"] GALOIS_GROUP_FIXES) THEN
    ASM_MESON_TAC [IN_POLY_RING_CARRIER, ring_polynomial, ring_powerseries])

  let GALOIS_GROUP_LOCAL ← prove
   r"!(h:A->B) k l f.
        f permutes ring_carrier l /\
        (!s. FINITE s
             ==> ?g. g IN group_carrier(galois_group(k,l) h) /\
                     !x. x IN s ==> g x = f x)
        ==> f IN group_carrier(galois_group(k,l) h)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [IN_GALOIS_GROUP, ring_automorphism, RING_ISOMORPHISM] THEN
    ASM_SIMP_TAC [PERMUTES_IMAGE] THEN
    REWRITE_TAC [ring_homomorphism] THEN
    ASM_SIMP_TAC [PERMUTES_IMAGE, SUBSET_REFL] THEN
    REPEAT CONJ_TAC THENL
     [FIRST_ASSUM (MP_TAC o SPEC (← q r"{ring_0 l:B}")) THEN
      REWRITE_TAC [FINITE_SING, IN_SING, FORALL_UNWIND_THM2] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM, RING_HOMOMORPHISM_0],
      FIRST_ASSUM (MP_TAC o SPEC (← q r"{ring_1 l:B}")) THEN
      REWRITE_TAC [FINITE_SING, IN_SING, FORALL_UNWIND_THM2] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM, RING_HOMOMORPHISM_1],
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"{x:B,ring_neg l x}")) THEN
      REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY, FORALL_IN_INSERT,
                   NOT_IN_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"g:B->B"] RING_HOMOMORPHISM_NEG) THEN
      ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM],
      MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"y:B"] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"{x:B,y,ring_add l x y}")) THEN
      REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY, FORALL_IN_INSERT,
                   NOT_IN_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"g:B->B"] RING_HOMOMORPHISM_ADD) THEN
      ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM],
      MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"y:B"] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"{x:B,y,ring_mul l x y}")) THEN
      REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY, FORALL_IN_INSERT,
                   NOT_IN_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l:B ring", ← q r"g:B->B"] RING_HOMOMORPHISM_MUL) THEN
      ASM_MESON_TAC [GALOIS_GROUP_RING_HOMOMORPHISM],
      ASM_MESON_TAC [PERMUTES_INJECTIVE],
      X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"{(h:A->B) a}")) THEN
      REWRITE_TAC [FINITE_SING, IN_SING, FORALL_UNWIND_THM2] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:B->B") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      ASM_MESON_TAC [GALOIS_GROUP_FIXES]])

  let GALOIS_GROUP_ANTIMONO ← prove
   r"!(h:A->B) (h':C->B) k k' l.
        IMAGE h (ring_carrier k) SUBSET IMAGE h' (ring_carrier k')
        ==> group_carrier(galois_group(k',l) h') SUBSET
            group_carrier(galois_group(k,l) h)"
   (REWRITE_TAC [SUBSET, IN_GALOIS_GROUP, FORALL_IN_IMAGE, IN_IMAGE] THEN
    MESON_TAC [])

  let GALOIS_GROUP_EQ_IMAGE ← prove
   r"!(h:A->B) (h':C->B) k k' l.
        IMAGE h (ring_carrier k) = IMAGE h' (ring_carrier k')
        ==> galois_group(k,l) h = galois_group(k',l) h'"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [galois_group] THEN
    AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"f:B->B") THEN AP_TERM_TAC THEN
    FIRST_ASSUM (MP_TAC o AP_TERM (← q r"\u:B->bool. !y. y IN u ==> (f:B->B) y = y")) THEN
    REWRITE_TAC [FORALL_IN_IMAGE])

  let TRIVIAL_GALOIS_GROUP ← prove
   r"!(h:A->B) k l.
        ring_carrier l SUBSET IMAGE h (ring_carrier k)
        ==> trivial_group(galois_group(k,l) h)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [trivial_group, GALOIS_GROUP, EXTENSION, IN_ELIM_THM, IN_SING] THEN
    X_GEN_TAC (← q r"f:B->B") THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [PERMUTES_I, RING_AUTOMORPHISM_I, I_THM] THEN
    MATCH_MP_TAC PERMUTES_EQ THEN EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
    ASM_REWRITE_TAC [PERMUTES_I, I_THM] THEN ASM SET_TAC [])

  -- @@RETURN BEGIN
  return { galois_group, GALOIS_GROUP, IN_GALOIS_GROUP, GALOIS_GROUP_SUBGROUP,
           SUBGROUP_GENERATED_GALOIS_GROUP, GALOIS_GROUP_INVERSE, GALOIS_GROUP_COMPOSE,
           GALOIS_GROUP_PERMUTES, GALOIS_GROUP_RING_AUTOMORPHISM,
           GALOIS_GROUP_RING_HOMOMORPHISM, GALOIS_GROUP_FIXES, GALOIS_GROUP_IN_CARRIER,
           GALOIS_GROUP_IMAGE_INVERSE, GALOIS_GROUP_RING_MONOMORPHISM, GALOIS_GROUP_I,
           GALOIS_GROUP_ACTION, GALOIS_GROUP_POLY_EVAL, GALOIS_GROUP_LOCAL,
           GALOIS_GROUP_ANTIMONO, GALOIS_GROUP_EQ_IMAGE, TRIVIAL_GALOIS_GROUP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Galois groups and extensions of homomorphisms. For algebraic l over k and -/
/- a monomorphism j from l into m, f |-> j o f (restricted to the carrier of -/
/- l) is a bijection from the Galois group onto the extensions of j o h to l -/
/- with image inside j(l); for normal l this is all of them. Hence the       -/
/- Galois group of a finite extension has at most separable_degree elements, -/
/- with equality exactly for normal extensions, and for normal extensions it -/
/- acts transitively on the roots of each minimal polynomial.                -/
/- ------------------------------------------------------------------------- -/

structure GaloisExtensions where
  -- @@FIELDS
  GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_GEN : thm
  GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS : thm
  GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_NORMAL : thm
  CARD_GALOIS_GROUP_LE : thm
  FINITE_GALOIS_GROUP : thm
  CARD_GALOIS_GROUP_LE_SEPARABLE_DEGREE : thm
  NORMAL_EXTENSION_EQ_CARD_GALOIS_GROUP : thm
  GALOIS_GROUP_ORBIT : thm
  GALOIS_GROUP_ORBIT_FINITE : thm
  deriving Inhabited

@[nospecialize]
def setupGaloisExtensions [HolBase] (D : GaloisDeps) (BGaloisGroup : GaloisGroup) :
    ExceptT String IO GaloisExtensions := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH,
        ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM_ROOT, ALGEBRAIC_IMP_FIELD_EXTENSION,
        AND_FORALL_THM, BIJ, CARD_IMAGE_INJ, CARD_RING_HOMOMORPHISM_EXTENSIONS_LE,
        CARD_SUBSET, CARD_SUBSET_EQ, EQ_IMP, ETA_AX, EXTENSION, EXTENSIONAL_EQ,
        FIELD_EXTENSION_IMP_MONOMORPHISM, FIELD_IMP_INTEGRAL_DOMAIN,
        FIELD_IMP_NONTRIVIAL_RING, FIELD_RING_HOMOMORPHISM_MONOMORPHISM,
        FINITE_IMAGE_INJ_EQ, FINITE_IMP_ALGEBRAIC_EXTENSION,
        FINITE_IMP_FIELD_EXTENSION, FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.core1
  let { HAS_SIZE, HAS_SIZE_SEPARABLE_DEGREE, IMAGE_I, IMAGE_RESTRICTION, IMAGE_o, INJ,
        INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, IN_ELIM_THM,
        IN_RING_POLYNOMIAL_CARRIER_COMPOSE, I_O_ID, I_THM,
        MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_NONZERO,
        MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE, NORMAL_EXTENSION_EQ_EMBEDDINGS,
        NORMAL_EXTENSION_IMAGES_EQ, NORMAL_IMP_ALGEBRAIC_EXTENSION,
        NORMAL_IMP_FIELD_EXTENSION, PERMUTES_EQ, PERMUTES_IMAGE, PERMUTES_IN_IMAGE,
        POLY_EQ_0_MONOMORPHIC_IMAGE, POLY_EVAL_HOMOMORPHIC_IMAGE, POLY_RING_CLAUSES,
        POLY_ROOT_BOUND, .. } := D.core2
  let { RESTRICTION, RESTRICTION_IN_EXTENSIONAL,
        RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS, RESTRICT_PERMUTES_EQ,
        RING_AUTOMORPHISM_EQ, RING_AUTOMORPHISM_OF_ALGEBRAIC_EXTENSION,
        RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_COMPOSE, RING_HOMOMORPHISM_EQ,
        RING_HOMOMORPHISM_EXTENSIONS_ROOT, RING_HOMOMORPHISM_I,
        RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_MONOMORPHISM_FACTOR,
        RING_ISOMORPHISM, RING_ISOMORPHISM_IMP_HOMOMORPHISM, RING_MONOMORPHISM_I,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_POLYNOMIAL, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM, SUBSET_REFL, SURJ, algebraic_extension,
        field_extension, o_ASSOC, o_THM, ring_automorphism, ring_homomorphism,
        ring_homomorphism_extensions, ring_monomorphism, .. } := D.core4
  let { GALOIS_GROUP_FIXES, GALOIS_GROUP_PERMUTES, GALOIS_GROUP_POLY_EVAL,
        GALOIS_GROUP_RING_HOMOMORPHISM, IN_GALOIS_GROUP, .. } := BGaloisGroup
  -- @@SCOPE END

  let GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_GEN ← prove
   r"!(h:A->B) (j:B->C) k l m.
        algebraic_extension(k,l) h /\ ring_monomorphism(l,m) j
        ==> BIJ (\f. RESTRICTION (ring_carrier l) (j o f))
                (group_carrier(galois_group(k,l) h))
                {g | g IN ring_homomorphism_extensions (k,l,m) (h,j o h) /\
                     IMAGE g (ring_carrier l) SUBSET IMAGE j (ring_carrier l)}"
   (← do
    let t1 ← TAUT (← q r"p /\ q /\ r ==> (p /\ q) /\ (p /\ r)")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN
     (← q r"ring_homomorphism(k:A ring,l:B ring) h /\
    ring_homomorphism(l:B ring,m:C ring) j")
    STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [ring_monomorphism], ALL_TAC] THEN
    REWRITE_TAC [BIJ, INJ, SURJ, IN_ELIM_THM] THEN
    MATCH_MP_TAC t1 THEN
    REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:B->B") THEN REWRITE_TAC [IN_GALOIS_GROUP] THEN STRIP_TAC THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS THEN
        ASM_SIMP_TAC [o_THM] THEN MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN
