    ASSUME_TAC THENL [EXPAND_TAC "S" THEN SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"FINITE(S:(B->B#num)->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"CARD(group_carrier(galois_group(k:A ring,l:B ring) h)) =
    CARD(S:(B->B#num)->bool)")
    SUBST1_TAC THENL
     [UNDISCH_TAC (← q r"FINITE(S:(B->B#num)->bool)") THEN
      SUBGOAL_THEN
       (← q r"S = IMAGE (\f:B->B. RESTRICTION (ring_carrier l) ((j:B->B#num) o f))
                (group_carrier(galois_group(k:A ring,l:B ring) h))")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"\f:B->B. RESTRICTION (ring_carrier l) ((j:B->B#num) o f)",
                        ← q r"group_carrier(galois_group(k:A ring,l:B ring) h)"]
        FINITE_IMAGE_INJ_EQ) THEN
      MP_TAC (← ISPECL [← q r"\f:B->B. RESTRICTION (ring_carrier l) ((j:B->B#num) o f)",
                        ← q r"group_carrier(galois_group(k:A ring,l:B ring) h)"]
        CARD_IMAGE_INJ) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [CARD_SUBSET] THEN
    SUBGOAL_THEN
     (← q r"CARD(S:(B->B#num)->bool) =
    CARD(ring_homomorphism_extensions (k:A ring,l:B ring,m)
           (h:A->B,(j:B->B#num) o h)) <=>
    S = ring_homomorphism_extensions (k,l,m) (h,j o h)")
    SUBST1_TAC THENL
     [EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN
      MATCH_MP_TAC CARD_SUBSET_EQ THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    EXPAND_TAC "S" THEN
    REWRITE_TAC [s2] THEN
    EQ_TAC THENL
     [REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM, o_THM] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC s3 THEN
      MATCH_MP_TAC NORMAL_EXTENSION_IMAGES_EQ THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"m:(B#num) ring"] THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN,
