    SUBGOAL_THEN (← q r"ring_homomorphism(k:A ring,m) ((j:B->B#num) o (h:A->B))")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_COMPOSE,
                     RING_MONOMORPHISM_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:(B#num) ring"] HAS_SIZE_SEPARABLE_DEGREE) THEN
    ASM_REWRITE_TAC [HAS_SIZE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->B#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:(B#num) ring"]
      GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_GEN) THEN
    ASM_REWRITE_TAC [BIJ, INJ, SURJ] THEN
    ABBREV_TAC
     (← q r"S = {g | g IN ring_homomorphism_extensions (k:A ring,l:B ring,m)
                    (h:A->B,(j:B->B#num) o h) /\
             IMAGE g (ring_carrier l) SUBSET IMAGE j (ring_carrier l)}") THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
