   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"l:B ring"]
      GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS_GEN) THEN
