    -- right to left: the second TAUT, the two SET_RULEs, then the first TAUT
    let t4 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    let s3 ← SET_RULE (← q r"(s:(B#num)->bool) = t ==> s SUBSET t")
    let s2 ← SET_RULE
     (← q r"{x:B->B#num | x IN s /\ P x} = s <=> !x. x IN s ==> P x")
