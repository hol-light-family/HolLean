  let GALOIS_GROUP_BIJ_RING_HOMOMORPHISM_EXTENSIONS ← prove
   r"!(h:A->B) k l.
        algebraic_extension(k,l) h
        ==> BIJ (RESTRICTION (ring_carrier l))
                (group_carrier(galois_group(k,l) h))
