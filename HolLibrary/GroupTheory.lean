/-- Turn an 8-element list of theorems into a tuple (cf. list6 in
    HolLibrary/Matroids.lean), so each `let [A; ...; H] = ...` element
    becomes a bundle field. -/
def list8 (l : List thm) :
    ExceptT String IO (thm × thm × thm × thm × thm × thm × thm × thm) :=
  match l with
  | [a, b, c, d, e, f, g, h] => pure (a, b, c, d, e, f, g, h)
  | _ => throw "Match_failure"

/-- RingTheory's `wPart` (copied verbatim; grouptheory does not depend on
    ringtheory).  `W(MP_TAC o PART_MATCH f th o g o snd)`: match `th`'s part
    `f` against the part `g` of the goal, and MP_TAC the instance. -/
def wPart [HolBase] (g : term → Except String term) (f : term → Except String term)
    (th : thm) : tactic := fun gl =>
  ExceptT.run do
    let t ← liftExcept (g gl.2)
    ExceptT.mk (MP_TAC (← PART_MATCH f th t) gl)

