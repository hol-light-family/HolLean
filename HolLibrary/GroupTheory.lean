   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN FIRST_ASSUM (MP_TAC o MATCH_MP
      FINITELY_GENERATED_ABELIAN_SUBGROUP_STRUCTURE_ISOMORPHISM) THEN
