    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [ISOMORPHIC_GROUP_SYM]) THEN
    REWRITE_TAC [isomorphic_group, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:(num->A)->A") THEN DISCH_TAC THEN
