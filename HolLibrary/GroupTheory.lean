    REWRITE_TAC [SUBSET, IN_INTER, IN_ELIM_THM, IN_SING] THEN X_GEN_TAC (← q r"x:A") THEN
    ASM_CASES_TAC (← q r"(x:A) IN group_carrier G") THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"k:num") THEN
    ASM_CASES_TAC (← q r"k = 0") THEN ASM_SIMP_TAC [EXP, GROUP_ELEMENT_ORDER_EQ_1] THEN
    UNDISCH_TAC (← q r"~(p divides CARD(group_carrier G:A->bool))") THEN
