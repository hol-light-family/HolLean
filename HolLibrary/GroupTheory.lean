/- group.  (grouptheory.ml 8-193)                                            -/
/- ------------------------------------------------------------------------- -/

structure Basics where
  -- @@FIELDS
  group_tybij : thm
  group_carrier : thm
  group_id : thm
  group_inv : thm
  group_mul : thm
  GROUP_PROPERTIES : List thm
  GROUP_ID : thm
  GROUP_INV : thm
  GROUP_MUL : thm
  GROUP_MUL_ASSOC : thm
  GROUP_MUL_LID : thm
  GROUP_MUL_RID : thm
  GROUP_MUL_LINV : thm
  GROUP_MUL_RINV : thm
  GROUPS_EQ : thm
  GROUP_CARRIER_NONEMPTY : thm
  singleton_group : thm
  SINGLETON_GROUP : thm
  trivial_group : thm
  TRIVIAL_IMP_FINITE_GROUP : thm
  TRIVIAL_GROUP_SINGLETON_GROUP : thm
  FINITE_SINGLETON_GROUP : thm
  TRIVIAL_GROUP_SUBSET : thm
  TRIVIAL_GROUP : thm
  TRIVIAL_GROUP_ALT : thm
  TRIVIAL_GROUP_HAS_SIZE_1 : thm
  GROUP_CARRIER_HAS_SIZE_1 : thm
  opposite_group : thm
  OPPOSITE_GROUP : thm
  OPPOSITE_OPPOSITE_GROUP : thm
  OPPOSITE_GROUP_INV : thm
  OPPOSITE_GROUP_MUL : thm
  OPPOSITE_SINGLETON_GROUP : thm
  TRIVIAL_OPPOSITE_GROUP : thm
  FINITE_OPPOSITE_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupBasics [HolBase] (D : GroupTheoryDeps) :
    ExceptT String IO Basics := do
  -- @@SCOPE BEGIN
  let { HAS_SIZE_CONV, MESON, MESON_TAC, SET_RULE, new_definition, new_type_definition, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { ETA_AX, EXISTS_UNPAIR_THM, .. } := D.core2
  let { FINITE_SING, .. } := D.core3
  let { IN_SING, .. } := D.core5
  let { MEMBER_NOT_EMPTY, PAIR_EQ, .. } := D.core6
  let { SING_SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core7
  -- @@SCOPE END

  let group_tybij ← do
    let eth ← prove
     r"?s (z:A) n a.
          z IN s /\
          (!x. x IN s ==> n x IN s) /\
          (!x y. x IN s /\ y IN s ==> a x y IN s) /\
          (!x y z. x IN s /\ y IN s /\ z IN s
                   ==> a x (a y z) = a (a x y) z) /\
          (!x. x IN s ==> a z x = x /\ a x z = x) /\
          (!x. x IN s ==> a (n x) x = z /\ a x (n x) = z)"
     (MAP_EVERY EXISTS_TAC
       [← q "{ARB:A}", ← q "ARB:A", ← q r"(\x. ARB):A->A", ← q r"(\x y. ARB):A->A->A"] THEN
      REWRITE_TAC [IN_SING] THEN MESON_TAC [])
    new_type_definition "group" ("group", "group_operations")
     (← GEN_REWRITE_RULE DEPTH_CONV [EXISTS_UNPAIR_THM] eth)

  let group_carrier ← new_definition
   r"(group_carrier:(A)group->A->bool) = \g. FST(group_operations g)"

  let group_id ← new_definition
   r"(group_id:(A)group->A) = \g. FST(SND(group_operations g))"

  let group_inv ← new_definition
   r"(group_inv:(A)group->A->A) = \g. FST(SND(SND(group_operations g)))"

  let group_mul ← new_definition
   r"(group_mul:(A)group->A->A->A) = \g. SND(SND(SND(group_operations g)))"

  let GROUP_PROPERTIES : List thm ← pure (CONJUNCTS (← prove
   r"(!G:A group. group_id G IN group_carrier G) /\
   (!G x:A. x IN group_carrier G ==> group_inv G x IN group_carrier G) /\
   (!G x y:A. x IN group_carrier G /\ y IN group_carrier G
              ==> group_mul G x y IN group_carrier G) /\
   (!G x y z:A. x IN group_carrier G /\
                y IN group_carrier G /\
                z IN group_carrier G
                ==> group_mul G x (group_mul G y z) =
                    group_mul G (group_mul G x y) z) /\
   (!G x:A. x IN group_carrier G ==> group_mul G (group_id G) x = x) /\
   (!G x:A. x IN group_carrier G ==> group_mul G x (group_id G) = x) /\
   (!G x:A. x IN group_carrier G
            ==> group_mul G (group_inv G x) x = group_id G) /\
   (!G x:A. x IN group_carrier G
            ==> group_mul G x(group_inv G x) = group_id G)"
   (← do
    let m1 ← MESON []
     (← q r"(!a. mk(dest a) = a) /\ (!r. P r <=> dest(mk r) = r)
    ==> !a. P(dest a)")
    pure (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN
    MP_TAC (← SPEC (← q "G:A group") (← MATCH_MP m1 group_tybij)) THEN
    REWRITE_TAC [group_carrier, group_id, group_inv, group_mul] THEN
    SIMP_TAC []))))

  let (GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC,
       GROUP_MUL_LID, GROUP_MUL_RID, GROUP_MUL_LINV, GROUP_MUL_RINV) ←
    list8 GROUP_PROPERTIES

  let GROUPS_EQ ← prove
   r"!G H:A group.
        G = H <=>
        group_carrier G = group_carrier H /\
        group_id G = group_id H /\
        group_inv G = group_inv H /\
        group_mul G = group_mul H"
   (REWRITE_TAC [← GSYM PAIR_EQ] THEN
    REWRITE_TAC [group_carrier, group_id, group_inv, group_mul] THEN
    MESON_TAC [← CONJUNCT1 group_tybij])

  let GROUP_CARRIER_NONEMPTY ← prove
   r"!G:A group. ~(group_carrier G = {})"
   (MESON_TAC [MEMBER_NOT_EMPTY, GROUP_ID])

  /- --------------------------------------------------------------------- -/
  /- The trivial group on a given object.                                  -/
  /- --------------------------------------------------------------------- -/

  let singleton_group ← new_definition
   r"singleton_group (a:A) = group({a},a,(\x. a),(\x y. a))"

  let SINGLETON_GROUP ← prove
   r"(!a:A. group_carrier(singleton_group a) = {a}) /\
   (!a:A. group_id(singleton_group a) = a) /\
   (!a:A. group_inv(singleton_group a) = \x. a) /\
   (!a:A. group_mul(singleton_group a) = \x y. a)"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN
    MP_TAC (← EQ_IMP_RULE
     (← ISPEC (← liftExcept (do rand (← rand (strip_forall (concl singleton_group)).2)))
       (← CONJUNCT2 group_tybij))).1 THEN
    REWRITE_TAC [← GSYM singleton_group] THEN SIMP_TAC [IN_SING] THEN
    SIMP_TAC [group_carrier, group_id, group_inv, group_mul])

  let trivial_group ← new_definition
   r"trivial_group G <=> group_carrier G = {group_id G}"

  let TRIVIAL_IMP_FINITE_GROUP ← prove
   r"!G:A group. trivial_group G ==> FINITE(group_carrier G)"
   (SIMP_TAC [trivial_group, FINITE_SING])

  let TRIVIAL_GROUP_SINGLETON_GROUP ← prove
   r"!a:A. trivial_group(singleton_group a)"
   (REWRITE_TAC [trivial_group, SINGLETON_GROUP])

  let FINITE_SINGLETON_GROUP ← prove
   r"!a:A. FINITE(group_carrier(singleton_group a))"
   (SIMP_TAC [TRIVIAL_IMP_FINITE_GROUP, TRIVIAL_GROUP_SINGLETON_GROUP])

  let TRIVIAL_GROUP_SUBSET ← prove
   r"!G:A group. trivial_group G <=> group_carrier G SUBSET {group_id G}"
   (SIMP_TAC [trivial_group, ← GSYM SUBSET_ANTISYM_EQ, SING_SUBSET, GROUP_ID])

  let TRIVIAL_GROUP ← prove
   r"!G:A group. trivial_group G <=> ?a. group_carrier G = {a}"
   (← do
    let s1 ← SET_RULE (← q r"c IN s ==> (s = {c} <=> ?a. s = {a})")
    pure (GEN_TAC THEN REWRITE_TAC [trivial_group] THEN MATCH_MP_TAC s1 THEN
    REWRITE_TAC [GROUP_ID]))

  let TRIVIAL_GROUP_ALT ← prove
   r"!G:A group. trivial_group G <=> ?a. group_carrier G SUBSET {a}"
   (← do
    let s1 ← SET_RULE
     (← q r"(?a. s = {a}) <=> (?a. s SUBSET {a}) /\ ~(s = {})")
    pure (REWRITE_TAC [TRIVIAL_GROUP, GROUP_CARRIER_NONEMPTY, s1]))

  let TRIVIAL_GROUP_HAS_SIZE_1 ← prove
   r"!G:A group. trivial_group G <=> group_carrier(G) HAS_SIZE 1"
   (GEN_TAC THEN CONV_TAC (RAND_CONV HAS_SIZE_CONV) THEN
    REWRITE_TAC [TRIVIAL_GROUP])

  let GROUP_CARRIER_HAS_SIZE_1 ← prove
   r"!G:A group. group_carrier(G) HAS_SIZE 1 <=> trivial_group G"
   (REWRITE_TAC [TRIVIAL_GROUP_HAS_SIZE_1])

  /- --------------------------------------------------------------------- -/
  /- Opposite group (mainly just to avoid some duplicated variant proofs). -/
  /- --------------------------------------------------------------------- -/

  let opposite_group ← new_definition
   r"opposite_group(G:A group) =
        group(group_carrier G,group_id G,group_inv G,
              \x y. group_mul G y x)"

  let OPPOSITE_GROUP ← prove
   r"!G:A group.
        group_carrier(opposite_group G) = group_carrier G /\
        group_id(opposite_group G) = group_id G /\
        group_inv(opposite_group G) = group_inv G /\
        group_mul(opposite_group G) = \x y. group_mul G y x"
   (GEN_TAC THEN
    MP_TAC (← EQ_IMP_RULE
     (← ISPEC (← liftExcept (do rand (← rand (strip_forall (concl opposite_group)).2)))
       (← CONJUNCT2 group_tybij))).1 THEN
    REWRITE_TAC [← GSYM opposite_group] THEN ANTS_TAC THENL
     [SIMP_TAC GROUP_PROPERTIES,
      SIMP_TAC [group_carrier, group_id, group_inv, group_mul]])

  let OPPOSITE_OPPOSITE_GROUP ← prove
   r"!G:A group. opposite_group (opposite_group G) = G"
   (GEN_TAC THEN ONCE_REWRITE_TAC [opposite_group] THEN
    REWRITE_TAC [OPPOSITE_GROUP, ETA_AX] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM (← CONJUNCT1 group_tybij)] THEN
    AP_TERM_TAC THEN REWRITE_TAC [group_carrier, group_id, group_inv, group_mul])

  let OPPOSITE_GROUP_INV ← prove
   r"!G x:A. group_inv(opposite_group G) x = group_inv G x"
   (REWRITE_TAC [OPPOSITE_GROUP])

  let OPPOSITE_GROUP_MUL ← prove
   r"!G x y:A. group_mul(opposite_group G) x y = group_mul G y x"
   (REWRITE_TAC [OPPOSITE_GROUP])

  let OPPOSITE_SINGLETON_GROUP ← prove
   r"!a:A. opposite_group(singleton_group a) = singleton_group a"
   (REWRITE_TAC [GROUPS_EQ, SINGLETON_GROUP, OPPOSITE_GROUP])

  let TRIVIAL_OPPOSITE_GROUP ← prove
   r"!G:A group. trivial_group(opposite_group G) <=> trivial_group G"
   (REWRITE_TAC [trivial_group, OPPOSITE_GROUP])

  let FINITE_OPPOSITE_GROUP ← prove
   r"!G:A group. FINITE(group_carrier(opposite_group G)) <=>
               FINITE(group_carrier G)"
   (REWRITE_TAC [OPPOSITE_GROUP])

  -- @@RETURN BEGIN
  return { group_tybij, group_carrier, group_id, group_inv, group_mul, GROUP_PROPERTIES,
           GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_RID,
           GROUP_MUL_LINV, GROUP_MUL_RINV, GROUPS_EQ, GROUP_CARRIER_NONEMPTY,
           singleton_group, SINGLETON_GROUP, trivial_group, TRIVIAL_IMP_FINITE_GROUP,
           TRIVIAL_GROUP_SINGLETON_GROUP, FINITE_SINGLETON_GROUP, TRIVIAL_GROUP_SUBSET,
           TRIVIAL_GROUP, TRIVIAL_GROUP_ALT, TRIVIAL_GROUP_HAS_SIZE_1,
           GROUP_CARRIER_HAS_SIZE_1, opposite_group, OPPOSITE_GROUP,
           OPPOSITE_OPPOSITE_GROUP, OPPOSITE_GROUP_INV, OPPOSITE_GROUP_MUL,
           OPPOSITE_SINGLETON_GROUP, TRIVIAL_OPPOSITE_GROUP, FINITE_OPPOSITE_GROUP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Derived operations and derived properties, including separate "powers"    -/
/- for natural number (group_pow) and integer (group_zpow) indices.          -/
/- (grouptheory.ml 195-458)                                                  -/
/- ------------------------------------------------------------------------- -/

structure Derived where
  -- @@FIELDS
  group_div : thm
  GROUP_DIV : thm
  GROUP_MUL_LCANCEL : thm
  GROUP_MUL_LCANCEL_IMP : thm
  GROUP_MUL_RCANCEL : thm
  GROUP_MUL_RCANCEL_IMP : thm
  GROUP_LID_UNIQUE : thm
  GROUP_RID_UNIQUE : thm
  GROUP_LID_EQ : thm
  GROUP_RID_EQ : thm
  GROUP_LINV_UNIQUE : thm
  GROUP_RINV_UNIQUE : thm
  GROUP_LINV_EQ : thm
  GROUP_RINV_EQ : thm
  GROUP_MUL_EQ_ID : thm
  GROUP_INV_INV : thm
  GROUP_INV_ID : thm
  GROUP_INV_EQ_ID : thm
  GROUP_INV_MUL : thm
  GROUP_INV_EQ : thm
  GROUP_DIV_REFL : thm
  GROUP_DIV_EQ_ID : thm
  GROUP_COMMUTES_INV : thm
  GROUP_COMMUTES_INV_EQ : thm
  GROUP_COMMUTES_MUL : thm
  FORALL_IN_GROUP_CARRIER_INV : thm
  EXISTS_IN_GROUP_CARRIER_INV : thm
  group_pow : thm
  GROUP_POW : thm
  GROUP_POW_0 : thm
  GROUP_POW_1 : thm
  GROUP_POW_2 : thm
  GROUP_POW_ID : thm
  GROUP_POW_ADD : thm
  GROUP_POW_SUB : thm
  GROUP_POW_SUB_ALT : thm
  GROUP_INV_POW : thm
  GROUP_POW_MUL : thm
  GROUP_POW_POW : thm
  deriving Inhabited

@[nospecialize]
def setupDerived [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) :
    ExceptT String IO Derived := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, INDUCT_TAC, MESON_TAC, new_definition, new_recursive_definition,
        num_CONV, .. } := D
  let { ADD1, ADD_CLAUSES, .. } := D.core1
  let { MULT_CLAUSES, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUB_ADD, .. } := D.core7
  let { num_RECURSION, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, OPPOSITE_GROUP, OPPOSITE_GROUP_MUL, .. } := BBasics
  -- @@SCOPE END

  let group_div ← new_definition
   r"group_div G x y = group_mul G x (group_inv G y)"

  let GROUP_DIV ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_div G x y) IN group_carrier G"
   (SIMP_TAC [group_div, GROUP_MUL, GROUP_INV])

  let GROUP_MUL_LCANCEL ← prove
   r"!G x y z:A.
        x IN group_carrier G /\ y IN group_carrier G /\ z IN group_carrier G
        ==> (group_mul G x y = group_mul G x z <=> y = z)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"group_mul G (group_inv G x):A->A")) THEN
    ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_INV, GROUP_MUL_LINV, GROUP_MUL_LID])

  let GROUP_MUL_LCANCEL_IMP ← prove
   r"!G x y z:A.
        x IN group_carrier G /\ y IN group_carrier G /\ z IN group_carrier G /\
        group_mul G x y = group_mul G x z
        ==> y = z"
   (MESON_TAC [GROUP_MUL_LCANCEL])

  let GROUP_MUL_RCANCEL ← prove
   r"!G x y z:A.
        x IN group_carrier G /\ y IN group_carrier G /\ z IN group_carrier G
        ==> (group_mul G x z = group_mul G y z <=> x = y)"
   (ONCE_REWRITE_TAC [← GSYM OPPOSITE_GROUP_MUL] THEN
    SIMP_TAC [GROUP_MUL_LCANCEL, OPPOSITE_GROUP])

  let GROUP_MUL_RCANCEL_IMP ← prove
   r"!G x y z:A.
        x IN group_carrier G /\ y IN group_carrier G /\ z IN group_carrier G /\
        group_mul G x z = group_mul G y z
        ==> x = y"
   (MESON_TAC [GROUP_MUL_RCANCEL])

  let GROUP_LID_UNIQUE ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\ group_mul G x y = y
        ==> x = group_id G"
   (MESON_TAC [GROUP_MUL_RCANCEL, GROUP_MUL_LID, GROUP_MUL, GROUP_ID])

  let GROUP_RID_UNIQUE ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\ group_mul G x y = x
        ==> y = group_id G"
   (MESON_TAC [GROUP_MUL_LCANCEL, GROUP_MUL_RID, GROUP_MUL, GROUP_ID])

  let GROUP_LID_EQ ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_mul G x y = y <=> x = group_id G)"
   (MESON_TAC [GROUP_LID_UNIQUE, GROUP_MUL_LID])

  let GROUP_RID_EQ ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_mul G x y = x <=> y = group_id G)"
   (MESON_TAC [GROUP_RID_UNIQUE, GROUP_MUL_RID])

  let GROUP_LINV_UNIQUE ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\
        group_mul G x y = group_id G
        ==> group_inv G x = y"
   (MESON_TAC [GROUP_MUL_LCANCEL, GROUP_INV, GROUP_MUL_RINV])

  let GROUP_RINV_UNIQUE ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\
        group_mul G x y = group_id G
        ==> group_inv G y = x"
   (MESON_TAC [GROUP_MUL_RCANCEL, GROUP_INV, GROUP_MUL_LINV])

  let GROUP_LINV_EQ ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_inv G x = y <=> group_mul G x y = group_id G)"
   (MESON_TAC [GROUP_LINV_UNIQUE, GROUP_MUL_RINV])

  let GROUP_RINV_EQ ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_inv G x = y <=> group_mul G y x = group_id G)"
   (MESON_TAC [GROUP_RINV_UNIQUE, GROUP_MUL_LINV])

  let GROUP_MUL_EQ_ID ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_mul G x y = group_id G <=> group_mul G y x = group_id G)"
   (MESON_TAC [GROUP_RINV_EQ, GROUP_LINV_EQ])

  let GROUP_INV_INV ← prove
   r"!G x:A. x IN group_carrier G ==> group_inv G (group_inv G x) = x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_LINV_UNIQUE THEN
    ASM_SIMP_TAC [GROUP_INV, GROUP_MUL_LINV])

  let GROUP_INV_ID ← prove
   r"!G:A group. group_inv G (group_id G) = group_id G"
   (GEN_TAC THEN MATCH_MP_TAC GROUP_LINV_UNIQUE THEN
    SIMP_TAC [GROUP_ID, GROUP_MUL_LID])

  let GROUP_INV_EQ_ID ← prove
   r"!G x:A.
        x IN group_carrier G
        ==> (group_inv G x = group_id G <=> x = group_id G)"
   (MESON_TAC [GROUP_INV_INV, GROUP_INV_ID])

  let GROUP_INV_MUL ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> group_inv G (group_mul G x y) =
            group_mul G (group_inv G y) (group_inv G x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_LINV_UNIQUE THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV, GROUP_MUL_ASSOC] THEN
    wPart (fun t => do lhand (← lhand t)) (fun t => do rand (← rand t))
      GROUP_MUL_ASSOC THEN
    ASM_SIMP_TAC [GROUP_MUL_RINV, GROUP_INV] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [GROUP_MUL_RINV, GROUP_INV, GROUP_MUL_RID])

  let GROUP_INV_EQ ← prove
   r"!G x y:A. x IN group_carrier G /\ y IN group_carrier G
             ==> (group_inv G x = group_inv G y <=> x = y)"
   (MESON_TAC [GROUP_INV_INV])

  let GROUP_DIV_REFL ← prove
   r"!G x:A. x IN group_carrier G ==> group_div G x x = group_id G"
   (SIMP_TAC [group_div, GROUP_MUL_RINV])

  let GROUP_DIV_EQ_ID ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_div G x y = group_id G <=> x = y)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"group_id G:A = group_div G y y") SUBST1_TAC THENL
     [ASM_SIMP_TAC [GROUP_DIV_REFL],
      ASM_SIMP_TAC [group_div, GROUP_MUL_RCANCEL, GROUP_INV]])

  let GROUP_COMMUTES_INV ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\
        group_mul G x y = group_mul G y x
        ==>  group_mul G (group_inv G x) y = group_mul G y (group_inv G x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_MUL_LCANCEL_IMP THEN
    MAP_EVERY EXISTS_TAC [← q "G:A group", ← q "x:A"] THEN
    ASM_SIMP_TAC [GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_RINV] THEN
    ASM_SIMP_TAC [GROUP_INV, GROUP_MUL, ← GSYM GROUP_MUL_ASSOC, GROUP_MUL_RINV] THEN
    ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_MUL_RID])

  let GROUP_COMMUTES_INV_EQ ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_mul G (group_inv G x) y = group_mul G y (group_inv G x) <=>
             group_mul G x y = group_mul G y x)"
   (MESON_TAC [GROUP_COMMUTES_INV, GROUP_INV_INV, GROUP_INV])

  let GROUP_COMMUTES_MUL ← prove
   r"!G x y z:A.
        x IN group_carrier G /\
        y IN group_carrier G /\
        z IN group_carrier G /\
        group_mul G x z = group_mul G z x /\
        group_mul G y z = group_mul G z y
        ==> group_mul G (group_mul G x y) z = group_mul G z (group_mul G x y)"
   (MESON_TAC [GROUP_MUL, GROUP_MUL_ASSOC])

  let FORALL_IN_GROUP_CARRIER_INV ← prove
   r"!(P:A->bool) G.
        (!x. x IN group_carrier G ==> P(group_inv G x)) <=>
        (!x. x IN group_carrier G ==> P x)"
   (MESON_TAC [GROUP_INV, GROUP_INV_INV])

  let EXISTS_IN_GROUP_CARRIER_INV ← prove
   r"!P G:A group.
        (?x. x IN group_carrier G /\ P(group_inv G x)) <=>
        (?x. x IN group_carrier G /\ P x)"
   (MESON_TAC [GROUP_INV, GROUP_INV_INV])

  let group_pow ← new_recursive_definition num_RECURSION
   r"group_pow G x 0 = group_id G /\
  group_pow G x (SUC n) = group_mul G x (group_pow G x n)"

  let GROUP_POW ← prove
   r"!G (x:A) n. x IN group_carrier G ==> group_pow G x n IN group_carrier G"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [group_pow, GROUP_ID, GROUP_MUL])

  let GROUP_POW_0 ← prove
   r"!G (x:A). group_pow G x 0 = group_id G"
   (REWRITE_TAC [group_pow])

  let GROUP_POW_1 ← prove
   r"!G x:A. x IN group_carrier G ==> group_pow G x 1 = x"
   (← do
    let c1 ← ExceptT.mk (num_CONV (← q "1"))
    pure (SIMP_TAC [c1, group_pow, GROUP_MUL_RID]))

  let GROUP_POW_2 ← prove
   r"!G x:A. x IN group_carrier G ==> group_pow G x 2 = group_mul G x x"
   (← do
    let c1 ← ExceptT.mk (num_CONV (← q "1"))
    let c2 ← ExceptT.mk (num_CONV (← q "2"))
    pure (SIMP_TAC [c2, c1, group_pow, GROUP_MUL_RID]))

  let GROUP_POW_ID ← prove
   r"!n. group_pow G (group_id G) n = group_id G"
   (INDUCT_TAC THEN ASM_SIMP_TAC [group_pow, GROUP_ID, GROUP_MUL_LID])

  let GROUP_POW_ADD ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> group_pow G x (m + n) =
            group_mul G (group_pow G x m) (group_pow G x n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN
    ASM_SIMP_TAC [group_pow, ADD_CLAUSES, GROUP_POW, GROUP_MUL_LID] THEN
    ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_POW])

  let GROUP_POW_SUB ← prove
   r"!G (x:A) m n.
        x IN group_carrier G /\ n <= m
        ==> group_pow G x (m - n) =
            group_div G (group_pow G x m) (group_pow G x n)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_MUL_RCANCEL_IMP THEN
    MAP_EVERY EXISTS_TAC [← q "G:A group", ← q "group_pow G x n:A"] THEN
    ASM_SIMP_TAC [GROUP_POW, GROUP_MUL, GROUP_INV, group_div,
                 ← GSYM GROUP_MUL_ASSOC, GROUP_MUL_LINV, GROUP_MUL_RID,
                 ← GSYM GROUP_POW_ADD, SUB_ADD])

  let GROUP_POW_SUB_ALT ← prove
   r"!G (x:A) m n.
        x IN group_carrier G /\ n <= m
        ==> group_pow G x (m - n) =
            group_mul G (group_inv G (group_pow G x n)) (group_pow G x m)"
   (← do
    let a1 ← ARITH_RULE (← q r"n:num <= m ==> n + m - n = m")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_MUL_LCANCEL_IMP THEN
    MAP_EVERY EXISTS_TAC [← q "G:A group", ← q "group_pow G x n:A"] THEN
    ASM_SIMP_TAC [GROUP_POW, GROUP_MUL, GROUP_INV, group_div, GROUP_MUL_ASSOC,
                 GROUP_MUL_RINV, GROUP_MUL_LID, ← GSYM GROUP_POW_ADD,
                 a1]))

  let GROUP_INV_POW ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> group_inv G (group_pow G x n) = group_pow G (group_inv G x) n"
   (← do
    let a1 ← ARITH_RULE (← q r"SUC n = 1 + n")
    pure (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN REWRITE_TAC [← CONJUNCT1 group_pow, GROUP_INV_ID] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [a1] THEN
    ASM_SIMP_TAC [ADD1, GROUP_POW_ADD, GROUP_INV, GROUP_INV_MUL, GROUP_POW,
                 GROUP_POW_1]))

  let GROUP_POW_MUL ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> group_pow G x (m * n) = group_pow G (group_pow G x m) n"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    INDUCT_TAC THEN REWRITE_TAC [GROUP_POW_0, MULT_CLAUSES] THEN
    ASM_SIMP_TAC [GROUP_POW_ADD, ← CONJUNCT2 group_pow])

  let GROUP_POW_POW ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> group_pow G (group_pow G x m) n = group_pow G x (m * n)"
   (SIMP_TAC [GROUP_POW_MUL])

  -- @@RETURN BEGIN
  return { group_div, GROUP_DIV, GROUP_MUL_LCANCEL, GROUP_MUL_LCANCEL_IMP,
           GROUP_MUL_RCANCEL, GROUP_MUL_RCANCEL_IMP, GROUP_LID_UNIQUE, GROUP_RID_UNIQUE,
           GROUP_LID_EQ, GROUP_RID_EQ, GROUP_LINV_UNIQUE, GROUP_RINV_UNIQUE,
           GROUP_LINV_EQ, GROUP_RINV_EQ, GROUP_MUL_EQ_ID, GROUP_INV_INV, GROUP_INV_ID,
           GROUP_INV_EQ_ID, GROUP_INV_MUL, GROUP_INV_EQ, GROUP_DIV_REFL, GROUP_DIV_EQ_ID,
           GROUP_COMMUTES_INV, GROUP_COMMUTES_INV_EQ, GROUP_COMMUTES_MUL,
           FORALL_IN_GROUP_CARRIER_INV, EXISTS_IN_GROUP_CARRIER_INV, group_pow,
           GROUP_POW, GROUP_POW_0, GROUP_POW_1, GROUP_POW_2, GROUP_POW_ID, GROUP_POW_ADD,
           GROUP_POW_SUB, GROUP_POW_SUB_ALT, GROUP_INV_POW, GROUP_POW_MUL, GROUP_POW_POW }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Powers (natural and integer) in a group.  (grouptheory.ml 460-638)        -/
/- ------------------------------------------------------------------------- -/

structure Pow where
  -- @@FIELDS
  GROUP_COMMUTES_POW : thm
  GROUP_MUL_POW : thm
  group_zpow : thm
  GROUP_ZPOW : thm
  GROUP_NPOW : thm
  GROUP_ZPOW_0 : thm
  GROUP_ZPOW_1 : thm
  GROUP_ZPOW_2 : thm
  GROUP_ZPOW_ID : thm
  GROUP_ZPOW_NEG : thm
  GROUP_ZPOW_MINUS1 : thm
  GROUP_ZPOW_POW : thm
  GROUP_ZPOW_ABS_EQ_ID : thm
  GROUP_ZPOW_ADD : thm
  GROUP_ZPOW_SUB : thm
  GROUP_ZPOW_SUB_ALT : thm
  GROUP_INV_ZPOW : thm
  GROUP_ZPOW_INV : thm
  GROUP_ZPOW_MUL : thm
  GROUP_COMMUTES_ZPOW : thm
  GROUP_MUL_ZPOW : thm
  deriving Inhabited

@[nospecialize]
def setupPow [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) :
    ExceptT String IO Pow := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, INT_ARITH, MESON_TAC, new_definition, .. } := D
  let { ADD_SYM, COND_ID, .. } := D.core1
  let { FORALL_INT_CASES, .. } := D.core3
  let { INT_ABS_NEG, INT_ABS_NUM, INT_IMAGE, INT_MUL_LNEG, INT_MUL_RNEG, INT_NEG_0, .. } := D.core4
  let { INT_NEG_ADD, INT_NEG_NEG, INT_OF_NUM_ADD, INT_OF_NUM_EQ, INT_OF_NUM_MUL,
        INT_OF_NUM_SUB, INT_POS, INT_SUB, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, NUM_OF_INT_OF_NUM, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, .. } := D.core7
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_COMMUTES_INV, GROUP_INV_EQ_ID, GROUP_INV_ID, GROUP_INV_INV,
        GROUP_INV_MUL, GROUP_INV_POW, GROUP_POW, GROUP_POW_0, GROUP_POW_1, GROUP_POW_2,
        GROUP_POW_ADD, GROUP_POW_ID, GROUP_POW_MUL, GROUP_POW_SUB, GROUP_POW_SUB_ALT,
        group_div, group_pow, .. } := BDerived
  -- @@SCOPE END

  let GROUP_COMMUTES_POW ← prove
   r"!G (x:A) (y:A) n.
        x IN group_carrier G /\ y IN group_carrier G /\
        group_mul G x y = group_mul G y x
        ==> group_mul G (group_pow G x n) y = group_mul G y (group_pow G x n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [group_pow, GROUP_MUL_LID, GROUP_MUL_RID] THEN
    ASM_MESON_TAC [GROUP_MUL_ASSOC, GROUP_POW])

  let GROUP_MUL_POW ← prove
   r"!G (x:A) (y:A) n.
        x IN group_carrier G /\ y IN group_carrier G /\
        group_mul G x y = group_mul G y x
        ==> group_pow G (group_mul G x y) n =
            group_mul G (group_pow G x n) (group_pow G y n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [group_pow, GROUP_MUL_LID, GROUP_ID] THEN
    ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_MUL, GROUP_POW] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [← GSYM (← CONJUNCT2 group_pow)] THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL, GROUP_POW] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 group_pow)] THEN
    ASM_MESON_TAC [GROUP_COMMUTES_POW])

  let group_zpow ← new_definition
   r"group_zpow G (x:A) n =
      if &0 <= n then group_pow G x (num_of_int n)
      else group_inv G (group_pow G x (num_of_int(--n)))"

  let GROUP_ZPOW ← prove
   r"!G (x:A) n. x IN group_carrier G ==> group_zpow G x n IN group_carrier G"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_zpow] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [GROUP_POW, GROUP_INV])

  let GROUP_NPOW ← prove
   r"!G (x:A) n. group_zpow G x (&n) = group_pow G x n"
   (REWRITE_TAC [NUM_OF_INT_OF_NUM, group_zpow, INT_POS])

  let GROUP_ZPOW_0 ← prove
   r"!G (x:A). group_zpow G x (&0) = group_id G"
   (REWRITE_TAC [GROUP_NPOW, GROUP_POW_0])

  let GROUP_ZPOW_1 ← prove
   r"!G x:A. x IN group_carrier G ==> group_zpow G x (&1) = x"
   (REWRITE_TAC [GROUP_NPOW, GROUP_POW_1])

  let GROUP_ZPOW_2 ← prove
   r"!G x:A. x IN group_carrier G ==> group_zpow G x (&2) = group_mul G x x"
   (REWRITE_TAC [GROUP_NPOW, GROUP_POW_2])

  let GROUP_ZPOW_ID ← prove
   r"!n. group_zpow G (group_id G) n = group_id G"
   (GEN_TAC THEN REWRITE_TAC [group_zpow, GROUP_POW_ID, GROUP_INV_ID, COND_ID])

  let GROUP_ZPOW_NEG ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> group_zpow G x (--n) = group_inv G (group_zpow G x n)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"n:int = &0") THEN
    ASM_REWRITE_TAC [INT_NEG_0, GROUP_NPOW, group_pow, GROUP_INV_ID] THEN
    REWRITE_TAC [group_zpow, INT_NEG_NEG] THEN
    ASM_SIMP_TAC [← INT_ARITH
      (← q r"~(n:int = &0) ==> (&0 <= --n <=> ~(&0 <= n))")] THEN
    ASM_CASES_TAC (← q r"&0:int <= n") THEN
    ASM_SIMP_TAC [GROUP_INV_INV, GROUP_POW])

  let GROUP_ZPOW_MINUS1 ← prove
   r"!G x:A. x IN group_carrier G ==> group_zpow G x (-- &1) = group_inv G x"
   (SIMP_TAC [GROUP_ZPOW_NEG, GROUP_ZPOW_1])

  let GROUP_ZPOW_POW ← prove
   r"(!G (x:A) n. group_zpow G x (&n) = group_pow G x n) /\
     (!G (x:A) n. group_zpow G x (-- &n) = group_inv G (group_pow G x n))"
   (SIMP_TAC [group_zpow, INT_POS, NUM_OF_INT_OF_NUM, INT_OF_NUM_EQ, INT_NEG_0,
             INT_NEG_NEG, ← INT_ARITH (← q r"&0:int <= -- &n <=> &n:int = &0")] THEN
    REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [group_pow, GROUP_INV_ID])

  let GROUP_ZPOW_ABS_EQ_ID ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> (group_zpow G x (abs n) = group_id G <=>
             group_zpow G x n = group_id G)"
   (REWRITE_TAC [FORALL_INT_CASES, INT_ABS_NEG, INT_ABS_NUM] THEN
    SIMP_TAC [GROUP_ZPOW_NEG, GROUP_NPOW] THEN
    MESON_TAC [GROUP_INV_EQ_ID, GROUP_POW])

  let GROUP_ZPOW_ADD ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> group_zpow G x (m + n) =
            group_mul G (group_zpow G x m) (group_zpow G x n)"
   (← do
    let r6 ← INT_ARITH (← q r"y + --x:int = --(x - y)")
    let r5 ← INT_ARITH (← q r"y + --x:int = y - x")
    let r4 ← ARITH_RULE (← q r"q:num <= p \/ p <= q")
    let r3 ← INT_ARITH (← q r"--x + y:int = --(x - y)")
    let r2 ← INT_ARITH (← q r"--x + y:int = y - x")
    let r1 ← ARITH_RULE (← q r"p:num <= q \/ q <= p")
    pure (REPEAT STRIP_TAC THEN
    DISJ_CASES_THEN MP_TAC (← SPEC (← q r"n:int") INT_IMAGE) THEN
    DISJ_CASES_THEN MP_TAC (← SPEC (← q r"m:int") INT_IMAGE) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "p:num") THEN DISCH_THEN SUBST1_TAC THEN
    X_GEN_TAC (← q "q:num") THEN DISCH_THEN SUBST1_TAC THEN
    ASM_SIMP_TAC [← GSYM INT_NEG_ADD, GROUP_ZPOW_NEG, GROUP_NPOW,
                 INT_OF_NUM_ADD] THEN
    REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [GROUP_POW_ADD],
      DISJ_CASES_TAC r1 THENL
       [ASM_REWRITE_TAC [r2],
        ASM_REWRITE_TAC [r3]] THEN
      ASM_SIMP_TAC [GROUP_ZPOW_NEG, INT_OF_NUM_SUB, GROUP_NPOW] THEN
      ASM_SIMP_TAC [GROUP_POW_SUB_ALT, GROUP_INV_MUL, GROUP_INV_INV,
                   GROUP_POW, GROUP_INV, GROUP_MUL],
      DISJ_CASES_TAC r4 THENL
       [ASM_REWRITE_TAC [r5],
        ASM_REWRITE_TAC [r6]] THEN
      ASM_SIMP_TAC [GROUP_ZPOW_NEG, INT_OF_NUM_SUB, GROUP_NPOW] THEN
      ASM_SIMP_TAC [GROUP_POW_SUB, GROUP_INV_MUL, GROUP_INV_INV,
                   GROUP_POW, GROUP_INV, GROUP_MUL, group_div],
      ONCE_REWRITE_TAC [ADD_SYM] THEN
      ASM_SIMP_TAC [GROUP_POW_ADD, GROUP_INV_MUL, GROUP_POW]]))

  let GROUP_ZPOW_SUB ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> group_zpow G x (m - n) =
            group_div G (group_zpow G x m) (group_zpow G x n)"
   (SIMP_TAC [group_div, INT_SUB, GROUP_ZPOW_ADD, GROUP_ZPOW_NEG])

  let GROUP_ZPOW_SUB_ALT ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> group_zpow G x (m - n) =
            group_mul G (group_inv G (group_zpow G x n)) (group_zpow G x m)"
   (REWRITE_TAC [← INT_ARITH (← q r"x - y:int = --y + x")] THEN
    SIMP_TAC [GROUP_ZPOW_ADD, GROUP_ZPOW_NEG])

  let GROUP_INV_ZPOW ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> group_inv G (group_zpow G x n) = group_zpow G (group_inv G x) n"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_zpow] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [GROUP_INV_POW])

  let GROUP_ZPOW_INV ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> group_zpow G (group_inv G x) n = group_zpow G x (--n)"
   (SIMP_TAC [← GSYM GROUP_INV_ZPOW, ← GSYM GROUP_ZPOW_NEG])

  let GROUP_ZPOW_MUL ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> group_zpow G x (m * n) = group_zpow G (group_zpow G x m) n"
   (REPEAT STRIP_TAC THEN
    DISJ_CASES_THEN MP_TAC (← SPEC (← q r"n:int") INT_IMAGE) THEN
    DISJ_CASES_THEN MP_TAC (← SPEC (← q r"m:int") INT_IMAGE) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "p:num") THEN DISCH_THEN SUBST1_TAC THEN
    X_GEN_TAC (← q "q:num") THEN DISCH_THEN SUBST1_TAC THEN
    ASM_REWRITE_TAC [INT_MUL_LNEG, INT_MUL_RNEG, INT_NEG_NEG] THEN
    ASM_SIMP_TAC [GROUP_ZPOW_NEG, INT_OF_NUM_MUL, GROUP_NPOW,
                 GROUP_INV, GROUP_POW, GROUP_POW_MUL, GROUP_INV_POW,
                 GROUP_INV_INV])

  let GROUP_COMMUTES_ZPOW ← prove
   r"!G (x:A) (y:A) n.
      x IN group_carrier G /\ y IN group_carrier G /\
      group_mul G x y = group_mul G y x
      ==> group_mul G (group_zpow G x n) y = group_mul G y (group_zpow G x n)"
   (REWRITE_TAC [FORALL_INT_CASES, GROUP_ZPOW_POW] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [GROUP_COMMUTES_POW] THEN ASM_SIMP_TAC [GROUP_INV_POW] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_COMMUTES_POW THEN
    ASM_MESON_TAC [GROUP_COMMUTES_INV, GROUP_INV])

  let GROUP_MUL_ZPOW ← prove
   r"!G (x:A) (y:A) n.
        x IN group_carrier G /\ y IN group_carrier G /\
        group_mul G x y = group_mul G y x
        ==> group_zpow G (group_mul G x y) n =
            group_mul G (group_zpow G x n) (group_zpow G y n)"
   (REWRITE_TAC [FORALL_INT_CASES, GROUP_ZPOW_POW, GROUP_MUL_POW] THEN
    SIMP_TAC [← GSYM GROUP_INV_MUL, GROUP_POW, GROUP_INV] THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_POW])

  -- @@RETURN BEGIN
  return { GROUP_COMMUTES_POW, GROUP_MUL_POW, group_zpow, GROUP_ZPOW, GROUP_NPOW,
           GROUP_ZPOW_0, GROUP_ZPOW_1, GROUP_ZPOW_2, GROUP_ZPOW_ID, GROUP_ZPOW_NEG,
           GROUP_ZPOW_MINUS1, GROUP_ZPOW_POW, GROUP_ZPOW_ABS_EQ_ID, GROUP_ZPOW_ADD,
           GROUP_ZPOW_SUB, GROUP_ZPOW_SUB_ALT, GROUP_INV_ZPOW, GROUP_ZPOW_INV,
           GROUP_ZPOW_MUL, GROUP_COMMUTES_ZPOW, GROUP_MUL_ZPOW }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Abelian groups.  (grouptheory.ml 640-696)                                 -/
/- ------------------------------------------------------------------------- -/

structure Abelian where
  -- @@FIELDS
  abelian_group : thm
  TRIVIAL_IMP_ABELIAN_GROUP : thm
  ABELIAN_SINGLETON_GROUP : thm
  ABELIAN_OPPOSITE_GROUP : thm
  ABELIAN_GROUP_MUL_POW : thm
  ABELIAN_GROUP_MUL_ZPOW : thm
  ABELIAN_GROUP_DIV_ZPOW : thm
  ABELIAN_GROUP_MUL_AC : thm
  deriving Inhabited

@[nospecialize]
def setupAbelian [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) :
    ExceptT String IO Abelian := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, new_definition, .. } := D
  let { IN_SING, .. } := D.core5
  let { GROUP_INV, GROUP_MUL_ASSOC, OPPOSITE_GROUP, OPPOSITE_GROUP_MUL,
        TRIVIAL_GROUP_SINGLETON_GROUP, trivial_group, .. } := BBasics
  let { group_div, .. } := BDerived
  let { GROUP_INV_ZPOW, GROUP_MUL_POW, GROUP_MUL_ZPOW, .. } := BPow
  -- @@SCOPE END

  let abelian_group ← new_definition
   r"abelian_group (G:A group) <=>
    !x y. x IN group_carrier G /\ y IN group_carrier G
          ==> group_mul G x y = group_mul G y x"

  let TRIVIAL_IMP_ABELIAN_GROUP ← prove
   r"!G:A group. trivial_group G ==> abelian_group G"
   (SIMP_TAC [trivial_group, abelian_group, IN_SING])

  let ABELIAN_SINGLETON_GROUP ← prove
   r"!a:A. abelian_group(singleton_group a)"
   (SIMP_TAC [TRIVIAL_IMP_ABELIAN_GROUP, TRIVIAL_GROUP_SINGLETON_GROUP])

  let ABELIAN_OPPOSITE_GROUP ← prove
   r"!G:A group. abelian_group (opposite_group G) <=> abelian_group G"
   (SIMP_TAC [abelian_group, OPPOSITE_GROUP_MUL, OPPOSITE_GROUP] THEN
    MESON_TAC [])

  let ABELIAN_GROUP_MUL_POW ← prove
   r"!G (x:A) (y:A) n.
        abelian_group G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> group_pow G (group_mul G x y) n =
            group_mul G (group_pow G x n) (group_pow G y n)"
   (MESON_TAC [GROUP_MUL_POW, abelian_group])

  let ABELIAN_GROUP_MUL_ZPOW ← prove
   r"!G (x:A) (y:A) n.
        abelian_group G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> group_zpow G (group_mul G x y) n =
            group_mul G (group_zpow G x n) (group_zpow G y n)"
   (MESON_TAC [GROUP_MUL_ZPOW, abelian_group])

  let ABELIAN_GROUP_DIV_ZPOW ← prove
   r"!G x (y:A) n.
        abelian_group G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> group_zpow G (group_div G x y) n =
            group_div G (group_zpow G x n) (group_zpow G y n)"
   (MESON_TAC [group_div, GROUP_INV_ZPOW, ABELIAN_GROUP_MUL_ZPOW, GROUP_INV])

  let ABELIAN_GROUP_MUL_AC ← prove
   r"!G:A group.
        abelian_group G <=>
        (!x y. x IN group_carrier G /\ y IN group_carrier G
               ==> group_mul G x y = group_mul G y x) /\
        (!x y z. x IN group_carrier G /\ y IN group_carrier G /\
                 z IN group_carrier G
                 ==> group_mul G (group_mul G x y) z =
                     group_mul G x (group_mul G y z)) /\
        (!x y z. x IN group_carrier G /\ y IN group_carrier G /\
                 z IN group_carrier G
                 ==> group_mul G x (group_mul G y z) =
                     group_mul G y (group_mul G x z))"
   (REWRITE_TAC [abelian_group] THEN MESON_TAC [GROUP_MUL_ASSOC])

  -- @@RETURN BEGIN
  return { abelian_group, TRIVIAL_IMP_ABELIAN_GROUP, ABELIAN_SINGLETON_GROUP,
           ABELIAN_OPPOSITE_GROUP, ABELIAN_GROUP_MUL_POW, ABELIAN_GROUP_MUL_ZPOW,
           ABELIAN_GROUP_DIV_ZPOW, ABELIAN_GROUP_MUL_AC }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Totalized versions of the group operations (using additive terminology    -/
/- for variety's sake). This totalization can be quite convenient, e.g. for  -/
/- normalization and use of the "iterate" construct in the Abelian case.     -/
/- (grouptheory.ml 698-851)                                                   -/
/- ------------------------------------------------------------------------- -/

structure Totalized where
  -- @@FIELDS
  group_neg : thm
  group_add : thm
  group_nmul : thm
  GROUP_NEG : thm
  GROUP_ADD : thm
  GROUP_NEG_EQ_INV : thm
  GROUP_ADD_EQ_MUL : thm
  GROUP_ADD_LID : thm
  GROUP_ADD_RID : thm
  GROUP_ADD_ASSOC : thm
  GROUP_NEG_ADD : thm
  GROUP_NEG_NEG : thm
  GROUP_NEG_ID : thm
  GROUP_ADD_EQ_ID : thm
  GROUP_NEG_EQ_ID : thm
  GROUP_NMUL_EQ_POW : thm
  GROUP_NMUL_ADD : thm
  GROUP_NMUL_MUL : thm
  GROUP_NMUL_1 : thm
  GROUP_NEG_NMUL : thm
  GROUP_ADD_SYM : thm
  GROUP_ADD_SYM_EQ : thm
  GROUP_ADD_NMUL : thm
  NEUTRAL_GROUP_ADD : thm
  MONOIDAL_GROUP_ADD : thm
  deriving Inhabited

@[nospecialize]
def setupTotalized [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) :
    ExceptT String IO Totalized := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, new_definition, new_recursive_definition,
        num_CONV, .. } := D
  let { ADD1, ADD_CLAUSES, ADD_SYM, COND_ID, .. } := D.core1
  let { MULT_CLAUSES, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, monoidal, .. } := D.core7
  let { neutral, num_RECURSION, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_INV_EQ_ID, GROUP_INV_ID, GROUP_INV_INV, GROUP_INV_MUL, GROUP_MUL_EQ_ID,
        GROUP_POW, group_pow, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  -- @@SCOPE END

  let group_neg ← new_definition
   r"group_neg G x = if x IN group_carrier G then group_inv G x else x"

  let group_add ← new_definition
   r"group_add G x (y:A) =
          if x IN group_carrier G /\ y IN group_carrier G
          then group_mul G x y
          else if x IN group_carrier G then y
          else if y IN group_carrier G then x
          else @w. ~(w IN group_carrier G)"

  let group_nmul ← new_recursive_definition num_RECURSION
   r"group_nmul G 0 x = group_id G /\
    group_nmul G (SUC n) x = group_add G x (group_nmul G n x)"

  let GROUP_NEG ← prove
   r"!G x:A. group_neg G x IN group_carrier G <=> x IN group_carrier G"
   (REWRITE_TAC [group_neg] THEN MESON_TAC [GROUP_INV])

  let GROUP_ADD ← prove
   r"!G x y:A.
        group_add G x y IN group_carrier G <=>
        x IN group_carrier G /\ y IN group_carrier G"
   (REWRITE_TAC [group_add] THEN MESON_TAC [GROUP_MUL])

  let GROUP_NEG_EQ_INV ← prove
   r"!G x:A. x IN group_carrier G ==> group_neg G x = group_inv G x"
   (SIMP_TAC [group_neg])

  let GROUP_ADD_EQ_MUL ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> group_add G x y = group_mul G x y"
   (SIMP_TAC [group_add])

  let GROUP_ADD_LID ← prove
   r"!G x:A. group_add G (group_id G) x = x"
   (SIMP_TAC [group_add, GROUP_ID, GROUP_MUL_LID, COND_ID])

  let GROUP_ADD_RID ← prove
   r"!G x:A. group_add G x (group_id G) = x"
   (SIMP_TAC [group_add, GROUP_ID, GROUP_MUL_RID, COND_ID])

  let GROUP_ADD_ASSOC ← prove
   r"!G x y z:A.
        group_add G x (group_add G y z) = group_add G (group_add G x y) z"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_add] THEN
    MAP_EVERY ASM_CASES_TAC
     [← q r"(x:A) IN group_carrier G",
      ← q r"(y:A) IN group_carrier G",
      ← q r"(z:A) IN group_carrier G"] THEN
    ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_MUL_ASSOC, COND_ID] THEN
    ASM_MESON_TAC [])

  let GROUP_NEG_ADD ← prove
   r"!G x y:A. group_neg G (group_add G x y) =
               group_add G (group_neg G y) (group_neg G x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_add, group_neg] THEN
    MAP_EVERY ASM_CASES_TAC
     [← q r"(x:A) IN group_carrier G",
      ← q r"(y:A) IN group_carrier G"] THEN
    ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV_MUL, GROUP_INV, COND_ID] THEN
    ASM_MESON_TAC [])

  let GROUP_NEG_NEG ← prove
   r"!G x:A. group_neg G (group_neg G x) = x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_neg] THEN
    MESON_TAC [GROUP_INV, GROUP_INV_INV])

  let GROUP_NEG_ID ← prove
   r"!G:A group. group_neg G (group_id G) = group_id G"
   (SIMP_TAC [group_neg, GROUP_INV_ID, GROUP_ID])

  let GROUP_ADD_EQ_ID ← prove
   r"!G x y:A. group_add G x y = group_id G <=> group_add G y x = group_id G"
   (REWRITE_TAC [group_add] THEN
    ASM_MESON_TAC [GROUP_ID, GROUP_ADD, GROUP_MUL_EQ_ID])

  let GROUP_NEG_EQ_ID ← prove
   r"!G x:A. group_neg G x = group_id G <=> x = group_id G"
   (MESON_TAC [GROUP_ID, GROUP_NEG, GROUP_INV_EQ_ID, GROUP_NEG_EQ_INV])

  let GROUP_NMUL_EQ_POW ← prove
   r"!G (x:A) n. x IN group_carrier G ==> group_nmul G n x = group_pow G x n"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN
    DISCH_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [group_nmul, group_pow, GROUP_ADD_EQ_MUL, GROUP_POW])

  let GROUP_NMUL_ADD ← prove
   r"!G (x:A) m n.
        group_nmul G (m + n) x =
        group_add G (group_nmul G m x) (group_nmul G n x)"
   (GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [group_nmul, ADD_CLAUSES, GROUP_ADD_LID] THEN
    REWRITE_TAC [GROUP_ADD_ASSOC])

  let GROUP_NMUL_MUL ← prove
   r"!G (x:A) m n.
        group_nmul G (m * n) x = group_nmul G m (group_nmul G n x)"
   (GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [← CONJUNCT1 group_nmul, MULT_CLAUSES] THEN
    ONCE_REWRITE_TAC [ADD_SYM] THEN
    ASM_REWRITE_TAC [GROUP_NMUL_ADD, ← CONJUNCT2 group_nmul])

  let GROUP_NMUL_1 ← prove
   r"!G x:A. group_nmul G 1 x = x"
   (← do
    let c1 ← ExceptT.mk (num_CONV (← q "1"))
    pure (REWRITE_TAC [c1, group_nmul, GROUP_ADD_RID]))

  let GROUP_NEG_NMUL ← prove
   r"!G (x:A) n.
        group_neg G (group_nmul G n x) = group_nmul G n (group_neg G x)"
   (GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THENL
     [REWRITE_TAC [group_nmul, GROUP_NEG_ID], ALL_TAC] THEN
    GEN_REWRITE_TAC RAND_CONV [group_nmul] THEN
    REWRITE_TAC [ADD1, GROUP_NMUL_ADD, GROUP_NEG_ADD] THEN
    ASM_REWRITE_TAC [GROUP_NMUL_1])

  let GROUP_ADD_SYM ← prove
   r"!G x y:A. abelian_group G ==> group_add G x y = group_add G y x"
   (SIMP_TAC [group_add, abelian_group] THEN MESON_TAC [])

  let GROUP_ADD_SYM_EQ ← prove
   r"!G:A group. (!x y. group_add G x y = group_add G y x) <=> abelian_group G"
   (REWRITE_TAC [group_add, abelian_group] THEN MESON_TAC [])

  let GROUP_ADD_NMUL ← prove
   r"!G (x:A) y n.
        abelian_group G
        ==> group_nmul G n (group_add G x y) =
            group_add G (group_nmul G n x) (group_nmul G n y)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN GEN_TAC THEN DISCH_TAC THEN
    GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [group_nmul, GROUP_ADD_LID] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM GROUP_ADD_SYM_EQ]) THEN
    REWRITE_TAC [GROUP_ADD_ASSOC] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    ASM_MESON_TAC [GROUP_ADD_ASSOC])

  let NEUTRAL_GROUP_ADD ← prove
   r"!G:A group. neutral(group_add G) = group_id G"
   (GEN_TAC THEN REWRITE_TAC [neutral] THEN
    MESON_TAC [GROUP_ADD_LID, GROUP_ADD_RID])

  let MONOIDAL_GROUP_ADD ← prove
   r"!G:A group. monoidal(group_add G) <=> abelian_group G"
   (REWRITE_TAC [monoidal, GROUP_ADD_ASSOC, NEUTRAL_GROUP_ADD, GROUP_ADD_LID,
                ← GSYM GROUP_ADD_SYM_EQ])

  -- @@RETURN BEGIN
  return { group_neg, group_add, group_nmul, GROUP_NEG, GROUP_ADD, GROUP_NEG_EQ_INV,
           GROUP_ADD_EQ_MUL, GROUP_ADD_LID, GROUP_ADD_RID, GROUP_ADD_ASSOC,
           GROUP_NEG_ADD, GROUP_NEG_NEG, GROUP_NEG_ID, GROUP_ADD_EQ_ID, GROUP_NEG_EQ_ID,
           GROUP_NMUL_EQ_POW, GROUP_NMUL_ADD, GROUP_NMUL_MUL, GROUP_NMUL_1,
           GROUP_NEG_NMUL, GROUP_ADD_SYM, GROUP_ADD_SYM_EQ, GROUP_ADD_NMUL,
           NEUTRAL_GROUP_ADD, MONOIDAL_GROUP_ADD }
  -- @@RETURN END

/- GROUP_RULE and GROUP_TAC: a decision procedure for the universal
   theory of groups and a naive tactic form.  (grouptheory.ml 874-1072)

   The local `let rec` functions of GROUP_RULE become top-level `partial
   def`s taking the context `C` of theorems and matchers they close over, as
   RingTheory.lean does for RING_RULE. -/

/-- The theorems and matchers `GROUP_RULE` builds once (grouptheory.ml
    874-1017), closed over by its local functions. -/
structure GroupRuleCtx where
  -- GROUP_MEM
  GROUP_ID : thm
  GROUP_INV : thm
  GROUP_POW : thm
  GROUP_ZPOW : thm
  GROUP_MUL : thm
  GROUP_DIV : thm
  -- GROUP_CANONIZE_CONV's totalizers (`(MATCH_MP o prove) ...`)
  mfn_inv : thm
  mfn_neg : thm
  mfn_pow : thm
  mfn_nmul : thm
  mfn_mul : thm
  mfn_add : thm
  in_tm : term
  gc_tm : term
  GROUP_NMUL_EQ_POW : thm
  GROUP_ZPOW_POW : thm
  group_div : thm
  NUM_REDUCE_CONV : ioconv
  INT_REDUCE_CONV : ioconv
  -- GROUP_NORM_CONV
  conv_thm : thm
  gsym_add_assoc : thm
  group_nmul : thm
  num_CONV : ioconv
  GROUP_NEG_ADD : thm
  GROUP_NEG_NEG : thm
  GROUP_NEG_ID : thm
  GROUP_ADD_LID : thm
  GROUP_ADD_RID : thm
  GROUP_ADD_ASSOC : thm
  -- main
  GROUP_DIV_EQ_ID : thm
  GROUP_ADD_EQ_ID : thm
  GROUP_NEG_EQ_ID : thm
  MESON : List thm → term → ExceptT String IO thm

/-- `GROUP_MEM` (grouptheory.ml 875-887): prove membership of a built-up
    group term, or `ASSUME` it. -/
partial def groupMem [HolBase] (C : GroupRuleCtx) (tm : term) : ExceptT String IO thm := do
  if is_conj tm then do
    CONJ (← groupMem C (← liftExcept (lhand tm))) (← groupMem C (← liftExcept (rand tm)))
  else
  tryWith (PART_MATCH .ok C.GROUP_ID tm) (do
    tryWith (do
      let th ← tryWith (PART_MATCH rand C.GROUP_INV tm) (
               tryWith (PART_MATCH rand C.GROUP_POW tm) (
               tryWith (PART_MATCH rand C.GROUP_ZPOW tm) (
               tryWith (PART_MATCH rand C.GROUP_MUL tm) (
               PART_MATCH rand C.GROUP_DIV tm))))
      MP th (← groupMem C (← liftExcept (do lhand (concl th)))))
     (ASSUME tm))

/-- `GROUP_REWR_CONV` (grouptheory.ml 888-891). -/
def groupRewrConv [HolBase] (C : GroupRuleCtx) (th : thm) : ioconv :=
  if !(is_imp (strip_forall (concl th)).2) then REWR_CONV th else
  fun tm => ExceptT.run do
    let ith ← PART_MATCH (lhand o rand) th tm
    MP ith (← groupMem C (← liftExcept (do lhand (concl ith))))

/-- `GROUP_TOTALIZE` (grouptheory.ml 925-947), the recursive totalizer
    inside `GROUP_CANONIZE_CONV`. -/
partial def groupTotalize [HolBase] (C : GroupRuleCtx) (g : term) (tm : term) :
    ExceptT String IO thm := do
  match tm with
  | .Comb (.Comb (.Comb (.Const "group_mul" _) _g) s) t =>
      MATCH_MP C.mfn_mul (← CONJ (← groupTotalize C g s) (← groupTotalize C g t))
  | .Comb (.Comb (.Comb (.Const "group_add" _) _g) s) t =>
      MATCH_MP C.mfn_add (← CONJ (← groupTotalize C g s) (← groupTotalize C g t))
  | .Comb (.Comb (.Comb (.Const "group_pow" _) _g) t) n =>
      SPEC n (← MATCH_MP C.mfn_pow (← groupTotalize C g t))
  | .Comb (.Comb (.Comb (.Const "group_nmul" _) _g) n) t =>
      SPEC n (← MATCH_MP C.mfn_nmul (← groupTotalize C g t))
  | .Comb (.Comb (.Const "group_inv" _) _g) t =>
      MATCH_MP C.mfn_inv (← groupTotalize C g t)
  | .Comb (.Comb (.Const "group_neg" _) _g) t =>
      MATCH_MP C.mfn_neg (← groupTotalize C g t)
  | .Comb (.Const "group_id" _) _g =>
      CONJ (REFL tm) (← ISPEC g C.GROUP_ID)
  | _ => do
      let ifn := inst [(type_of tm, aty)]
      CONJ (REFL tm)
           (← ASSUME (← liftExcept (do mk_comb (← mk_comb (ifn C.in_tm) tm) (← mk_comb (ifn C.gc_tm) g))))

/-- `GROUP_CANONIZE_CONV`'s inner matcher (grouptheory.ml 948-958). -/
def groupCanonizeMatch [HolBase] (C : GroupRuleCtx) : ioconv := fun tm => ExceptT.run do
  match tm with
  | .Comb (.Comb (.Comb (.Const "group_mul" _) g) _s) _t
  | .Comb (.Comb (.Comb (.Const "group_add" _) g) _s) _t
  | .Comb (.Comb (.Comb (.Const "group_pow" _) g) _s) _t
  | .Comb (.Comb (.Comb (.Const "group_nmul" _) g) _s) _t =>
      CONJUNCT1 (← groupTotalize C g tm)
  | .Comb (.Comb (.Const "group_inv" _) g) _t
  | .Comb (.Comb (.Const "group_neg" _) g) _t =>
      CONJUNCT1 (← groupTotalize C g tm)
  | _ => pure (REFL tm)

/-- `GROUP_CANONIZE_CONV` (grouptheory.ml 959-962), the final THENC chain. -/
def groupCanonizeConv [HolBase] (C : GroupRuleCtx) : ioconv :=
  C.NUM_REDUCE_CONV THENC C.INT_REDUCE_CONV THENC
  GEN_REWRITE_CONV TOP_DEPTH_CONV [C.GROUP_ZPOW_POW, C.group_div] THENC
  groupCanonizeMatch C

/-- `GROUP_NMUL_CONV` (grouptheory.ml 975-979), recursive inside
    `GROUP_NORM_CONV`. -/
partial def groupNmulConv [HolBase] (C : GroupRuleCtx) : ioconv := fun tm =>
  (tryWith (do REWR_CONV (← CONJUNCT1 C.group_nmul) tm |> ExceptT.mk) (do
    let c2 ← CONJUNCT2 C.group_nmul
    ExceptT.mk ((LAND_CONV C.num_CONV THENC
       REWR_CONV c2 THENC
       RAND_CONV (groupNmulConv C)) tm))).run

/-- `GROUP_NORM_CONV` (grouptheory.ml 963-985).  Its local
    `conv = (FIRST_CONV o map GROUP_REWR_CONV o CONJUNCTS o prove)(...)` is
    rebuilt here from the proved theorem `C.conv_thm`. -/
def groupNormConv [HolBase] (C : GroupRuleCtx) : ioconv :=
  let conv := FIRST_CONV ((CONJUNCTS C.conv_thm).map (groupRewrConv C))
  groupCanonizeConv C THENC
  TOP_DEPTH_CONV (groupNmulConv C) THENC
  GEN_REWRITE_CONV TOP_DEPTH_CONV
   [C.GROUP_NEG_ADD, C.GROUP_NEG_NEG, C.GROUP_NEG_ID] THENC
  GEN_REWRITE_CONV DEPTH_CONV [C.GROUP_ADD_LID, C.GROUP_ADD_RID] THENC
  GEN_REWRITE_CONV TOP_DEPTH_CONV [C.gsym_add_assoc] THENC
  TOP_DEPTH_CONV
   (GEN_REWRITE_CONV id [C.GROUP_ADD_LID, C.GROUP_ADD_RID] ORELSEC conv)

/-- `GROUP_EQ_RULE` (grouptheory.ml 986-988). -/
def groupEqRule [HolBase] (C : GroupRuleCtx) (tm : term) : ExceptT String IO thm := do
  let (l, r) ← liftExcept (dest_eq tm)
  TRANS (← ExceptT.mk ((groupNormConv C) l)) (← SYM (← ExceptT.mk ((groupNormConv C) r)))

/-- `is_groupty` (grouptheory.ml 989). -/
def isGroupty (ty : hol_type) : Bool :=
  match ty with | .Tyapp "group" [_] => true | _ => false

/-- `list_of_gtm` (grouptheory.ml 990-998). -/
partial def listOfGtm (tm : term) : List (Bool × term) :=
  match tm with
  | .Comb (.Const "group_id" _) _ => []
  | .Comb (.Comb (.Const "group_neg" _) _) x => [(false, x)]
  | .Comb (.Comb (.Comb (.Const "group_add" _) _)
      (.Comb (.Comb (.Const "group_neg" _) _) x)) y => (false, x) :: listOfGtm y
  | .Comb (.Comb (.Comb (.Const "group_add" _) _) x) y => (true, x) :: listOfGtm y
  | _ => [(true, tm)]

/-- `find_rot` (grouptheory.ml 999-1001). -/
def findRot (l l' : List (Bool × term)) : Except String Nat :=
  find (fun n => match chop_list n l with
    | .ok (l1, l2) => l2 ++ l1 == l'
    | .error _ => false)
    (List.range l.length)

/-- `GROUP_REASSOC_CONV` (grouptheory.ml 1002-1004). -/
partial def groupReassocConv [HolBase] (C : GroupRuleCtx) (n : Nat) : ioconv := fun tm =>
  if n == 0 then pure (.ok (REFL tm))
  else (REWR_CONV C.GROUP_ADD_ASSOC THENC groupReassocConv C (n - 1)) tm

/-- `GROUP_ROTATE_CONV` (grouptheory.ml 1005-1009). -/
def groupRotateConv [HolBase] (C : GroupRuleCtx) (n : Nat) : ioconv :=
  if n == 0 then (fun tm => pure (.ok (REFL tm))) else
  LAND_CONV (groupReassocConv C (n - 1)) THENC
  REWR_CONV C.GROUP_ADD_EQ_ID THENC
  LAND_CONV (groupNormConv C)

/-- `GROUP_EQ_HYPERNORM_CONV` (grouptheory.ml 1010-1016). -/
partial def groupEqHypernormConv [HolBase] (C : GroupRuleCtx) : ioconv := fun tm => ExceptT.run do
  let ts := listOfGtm (← liftExcept (lhand tm))
  if ts.length > 2 &&
     (let (p, v) := ts.head!; let (q, w) := ts.getLast!; !(p == q) && v == w)
  then ExceptT.mk ((groupRotateConv C 1 THENC groupEqHypernormConv C) tm)
  else pure (REFL tm)

/-- `GROUP_RULE` (grouptheory.ml 1017-1058): the main function. -/
def groupRule [HolBase] (C : GroupRuleCtx) (tm : term) : ExceptT String IO thm := do
  let gvs := setify (find_terms (isGroupty o type_of) tm)
  if gvs == [] then C.MESON [] tm else
  if gvs.length > 1 then throw "GROUP_RULE: Several groups involved" else
  let g := gvs.head!
  let group_eq_norm_conv : ioconv :=
    groupRewrConv C (← GSYM (← ISPEC g C.GROUP_DIV_EQ_ID)) THENC
    LAND_CONV (groupNormConv C)
  let (avs, bod) := strip_forall tm
  let (ant, con) ← if is_imp bod then do pure ([← liftExcept (lhand bod)], ← liftExcept (rand bod))
                   else pure ([], bod)
  let th1 ←
    if !(HolCore.Bool.is_iff con) then groupEqRule C con else do
    let (eq1, eq2) ← liftExcept (HolCore.Bool.dest_iff con)
    -- `let th1 = ... and th2 = ...`: left to right
    let th1 ← ExceptT.mk ((group_eq_norm_conv THENC groupEqHypernormConv C) eq1)
    let th2 ← ExceptT.mk ((group_eq_norm_conv THENC groupEqHypernormConv C) eq2)
    let ls1 := listOfGtm (← liftExcept (do lhand (← rand (concl th1))))
    let ls2 := listOfGtm (← liftExcept (do lhand (← rand (concl th2))))
    tryWith (do
      let n ← liftExcept (findRot ls1 ls2)
      TRANS (← CONV_RULE (RAND_CONV (groupRotateConv C n)) th1) (← SYM th2))
     (do
      -- `let th1' = ... and ls1' = ...`: left to right
      let th1' ←
        GEN_REWRITE_RULE (RAND_CONV o TOP_DEPTH_CONV)
          [← GSYM C.GROUP_ADD_ASSOC]
          (← GEN_REWRITE_RULE (RAND_CONV o TOP_DEPTH_CONV)
           [C.GROUP_NEG_ADD, C.GROUP_NEG_NEG]
           (← GEN_REWRITE_RULE RAND_CONV [← GSYM C.GROUP_NEG_EQ_ID] th1))
      let ls1' := (ls1.reverse).map (fun (p, v) => (!p, v))
      let n ← liftExcept (findRot ls1' ls2)
      TRANS (← CONV_RULE (RAND_CONV (groupRotateConv C n)) th1') (← SYM th2))
  let th2 ←
    if ant == [] then pure th1
    else (CONJUNCTS (← ASSUME ant.head!)).foldrM (fun c acc => PROVE_HYP c acc) th1
  let asl := hyp th2
  let th3 ←
    if asl == [] then pure th2 else do
    let asm ← liftExcept (HolCore.Bool.list_mk_conj asl)
    DISCH asm (← (CONJUNCTS (← ASSUME asm)).foldrM (fun c acc => PROVE_HYP c acc) th2)
  let th4 ← GENL avs th3
  let bvs := frees (concl th4)
  GENL (sort (fun a b => compare a b == Ordering.lt) bvs) th4

/- ------------------------------------------------------------------------- -/
/- The GROUP_RULE / GROUP_TAC bundle.  (grouptheory.ml 874-1072)             -/
/- ------------------------------------------------------------------------- -/

structure GroupRule where
  -- @@FIELDS
  GROUP_RULE : term → ExceptT String IO thm
  GROUP_TAC : tactic
  deriving Inhabited

@[nospecialize]
def setupGroupRule [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BTotalized : Totalized) :
    ExceptT String IO GroupRule := do
  -- @@SCOPE BEGIN
  let { INT_REDUCE_CONV, MESON, NUM_REDUCE_CONV, num_CONV, .. } := D
  let { IMP_CONJ, .. } := D.core4
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_LINV, GROUP_MUL_RINV, .. } := BBasics
  let { GROUP_DIV, GROUP_DIV_EQ_ID, GROUP_POW, group_div, .. } := BDerived
  let { GROUP_ZPOW, GROUP_ZPOW_POW, .. } := BPow
  let { GROUP_ADD, GROUP_ADD_ASSOC, GROUP_ADD_EQ_ID, GROUP_ADD_EQ_MUL, GROUP_ADD_LID,
        GROUP_ADD_RID, GROUP_NEG, GROUP_NEG_ADD, GROUP_NEG_EQ_ID, GROUP_NEG_EQ_INV,
        GROUP_NEG_ID, GROUP_NEG_NEG, GROUP_NMUL_EQ_POW, group_add, group_neg,
        group_nmul, .. } := BTotalized
  -- @@SCOPE END

  let GROUP_RULE : term → ExceptT String IO thm ← do
    -- GROUP_CANONIZE_CONV: `let mfn_inv = ... and mfn_neg = ... and mfn_pow =
    -- ... and mfn_nmul = ... and mfn_mul = ... and mfn_add = ... and in_tm =
    -- ... and gc_tm = ...`, left to right.
    let mfn_inv ← prove
     r"!G t t':A.
            t = t' /\ t IN group_carrier G
            ==> group_inv G t = group_neg G t' /\
                group_inv G t IN group_carrier G"
     (SIMP_TAC [IMP_CONJ, group_neg, GROUP_INV])
    let mfn_neg ← prove
     r"!G t t':A.
            t = t' /\ t IN group_carrier G
            ==> group_neg G t = group_neg G t' /\
                group_neg G t IN group_carrier G"
     (SIMP_TAC [GROUP_NEG])
    let mfn_pow ← prove
     r"!G t (t':A) n.
            t = t' /\ t IN group_carrier G
            ==> group_pow G t n = group_nmul G n t' /\
                group_pow G t n IN group_carrier G"
     (SIMP_TAC [GROUP_NMUL_EQ_POW, IMP_CONJ, GROUP_POW])
    let mfn_nmul ← prove
     r"!G t (t':A) n.
            t = t' /\ t IN group_carrier G
            ==> group_nmul G n t = group_nmul G n t' /\
                group_nmul G n t IN group_carrier G"
     (SIMP_TAC [GROUP_NMUL_EQ_POW, GROUP_POW, IMP_CONJ])
    let mfn_mul ← prove
     r"!G s t s' t':A.
            (s = s' /\ s IN group_carrier G) /\
            (t = t' /\ t IN group_carrier G)
            ==> group_mul G s t = group_add G s' t' /\
                group_mul G s t IN group_carrier G"
     (SIMP_TAC [IMP_CONJ, group_add, GROUP_MUL])
    let mfn_add ← prove
     r"!G s t s' t':A.
            (s = s' /\ s IN group_carrier G) /\
            (t = t' /\ t IN group_carrier G)
            ==> group_add G s t = group_add G s' t' /\
                group_add G s t IN group_carrier G"
     (SIMP_TAC [GROUP_ADD])
    let in_tm ← q "(IN):A->(A->bool)->bool"
    let gc_tm ← q "group_carrier:(A)group->A->bool"
    -- GROUP_NORM_CONV: `let conv = (FIRST_CONV o map GROUP_REWR_CONV o
    -- CONJUNCTS o prove) (...)`.  The `prove` runs now; the FIRST_CONV net is
    -- built from the proved conjuncts once GROUP_REWR_CONV is applied.
    let conv_thm ← prove
     r"(!G x:A. x IN group_carrier G
                ==> group_add G x (group_neg G x) = group_id G) /\
       (!G x:A. x IN group_carrier G
                ==> group_add G (group_neg G x) x = group_id G) /\
       (!G x y:A. x IN group_carrier G
                ==> group_add G x (group_add G (group_neg G x) y) = y) /\
       (!G x y:A. x IN group_carrier G
                ==> group_add G (group_neg G x) (group_add G x y) = y)"
     (REWRITE_TAC [GROUP_ADD_ASSOC] THEN
      SIMP_TAC [GROUP_NEG_EQ_INV, GROUP_ADD_EQ_MUL, GROUP_MUL_LINV,
               GROUP_MUL_RINV, GROUP_INV, GROUP_ADD_LID])
    let gsym_add_assoc ← GSYM GROUP_ADD_ASSOC
    let C : GroupRuleCtx := {
      GROUP_ID, GROUP_INV, GROUP_POW, GROUP_ZPOW, GROUP_MUL, GROUP_DIV,
      mfn_inv, mfn_neg, mfn_pow, mfn_nmul, mfn_mul, mfn_add, in_tm, gc_tm,
      GROUP_NMUL_EQ_POW, GROUP_ZPOW_POW, group_div, NUM_REDUCE_CONV, INT_REDUCE_CONV,
      conv_thm, gsym_add_assoc,
      group_nmul, num_CONV, GROUP_NEG_ADD, GROUP_NEG_NEG, GROUP_NEG_ID,
      GROUP_ADD_LID, GROUP_ADD_RID, GROUP_ADD_ASSOC, GROUP_DIV_EQ_ID,
      GROUP_ADD_EQ_ID, GROUP_NEG_EQ_ID, MESON }
    pure (groupRule C)

  let GROUP_TAC : tactic ← do
    let group_tac_pth ← MESON [] (← q r"(u = v <=> s = t) ==> (u = v ==> s = t)")
    pure (
      REPEAT GEN_TAC THEN
      TRY (MATCH_MP_TAC group_tac_pth) THEN
      W (fun (_asl, w) => tactic_of do
            let th ← GROUP_RULE w
            pure (MATCH_ACCEPT_TAC th ORELSE
             ((fun g => MATCH_MP_TAC th g) THEN ASM_REWRITE_TAC []))))

  -- @@RETURN BEGIN
  return { GROUP_RULE, GROUP_TAC }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Iterated operation on groups, the first one being in a specific           -/
/- order given as an argument, the latter picking some arbitrary             -/
/- wellorder, usually with the expectation that it will be immaterial.       -/
/- (grouptheory.ml 1074-1310)                                                -/
/- ------------------------------------------------------------------------- -/

structure GroupProduct where
  -- @@FIELDS
  group_product : thm
  group_sum : thm
  GROUP_PRODUCT_EQ : thm
  GROUP_SUM_EQ : thm
  GROUP_PRODUCT_CLOSED : thm
  GROUP_SUM_CLOSED : thm
  GROUP_PRODUCT : thm
  GROUP_SUM : thm
  GROUP_PRODUCT_SUPPORT : thm
  GROUP_SUM_SUPPORT : thm
  GROUP_PRODUCT_RESTRICT : thm
  GROUP_SUM_RESTRICT : thm
  GROUP_PRODUCT_EXPAND_CASES : thm
  GROUP_SUM_EXPAND_CASES : thm
  GROUP_PRODUCT_RESTRICT_SET : thm
  GROUP_SUM_RESTRICT_SET : thm
  GROUP_PRODUCT_SUPERSET : thm
  GROUP_SUM_SUPERSET : thm
  GROUP_PRODUCT_CLAUSES : thm
  GROUP_PRODUCT_CLAUSES_EXISTS : thm
  GROUP_SUM_CLAUSES_EXISTS : thm
  GROUP_PRODUCT_EQ_ID : thm
  GROUP_SUM_EQ_ID : thm
  GROUP_PRODUCT_ID : thm
  GROUP_SUM_ID : thm
  GROUP_COMMUTES_PRODUCT : thm
  GROUP_COMMUTES_SUM : thm
  GROUP_PRODUCT_SING : thm
  GROUP_SUM_SING : thm
  deriving Inhabited

@[nospecialize]
def setupGroupProduct [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) :
    ExceptT String IO GroupProduct := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, extend_basic_congs, new_definition, .. } := D
  let { COND_SWAP, CONJ_ASSOC, .. } := D.core1
  let { EMPTY_GSPEC, ETA_AX, .. } := D.core2
  let { FINITE_EMPTY, .. } := D.core3
  let { IN_ELIM_THM, ITERATO_CLAUSES, ITERATO_CLAUSES_EXISTS, ITERATO_CLOSED,
        ITERATO_EQ, ITERATO_EXPAND_CASES, ITERATO_SUPPORT, .. } := D.core5
  let { NOT_IMP, NOT_IN_EMPTY, .. } := D.core6
  let { GROUP_ID, GROUP_MUL, GROUP_MUL_LID, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_COMMUTES_MUL, .. } := BDerived
  -- @@SCOPE END

  let group_product ← new_definition
   r"group_product (G:A group) =
          iterato (group_carrier G) (group_id G) (group_mul G)"

  let group_sum ← new_definition
   r"group_sum (G:A group) =
          group_product G (@l. woset l /\ fld l = (:K))"

  let GROUP_PRODUCT_EQ ← prove
   r"!G (<<=) k (f:K->A) g.
          (!i. i IN k ==> f i = g i)
          ==> group_product G (<<=) k f = group_product G (<<=) k g"
   (REWRITE_TAC [group_product, ITERATO_EQ])

  let GROUP_SUM_EQ ← prove
   r"!G k (f:K->A) g.
          (!i. i IN k ==> f i = g i) ==> group_sum G k f = group_sum G k g"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT_EQ])

  -- `let th = prove (...) in extend_basic_congs (map SPEC_ALL (CONJUNCTS th))`
  let loc_th ← prove
   r"(!G (<<=) k f (g:K->A).
           (!i. i IN k ==> f i = g i)
           ==> group_product G (<<=) k (\i. f i) = group_product G (<<=) k g) /\
     (!G k f (g:K->A).
           (!i. i IN k ==> f i = g i)
           ==> group_sum G k (\i. f i) = group_sum G k g)"
   (REWRITE_TAC [ETA_AX, GROUP_PRODUCT_EQ, GROUP_SUM_EQ])
  let loc_specs ← (CONJUNCTS loc_th).mapM SPEC_ALL
  (extend_basic_congs loc_specs : IO Unit)

  let GROUP_PRODUCT_CLOSED ← prove
   r"!P G (<<=) k (f:K->A).
         P(group_id G) /\
         (!x y. x IN group_carrier G /\ y IN group_carrier G /\
                P x /\ P y
                ==> P(group_mul G x y)) /\
         (!i. i IN k /\ f i IN group_carrier G /\ ~(f i = group_id G) ==> P(f i))
         ==> P(group_product G (<<=) k f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_product] THEN
    MP_TAC (← ISPECL
     [← q r"group_carrier G:A->bool", ← q r"group_id G:A", ← q r"group_mul G:A->A->A",
      ← q r"(<<=):K->K->bool", ← q r"k:K->bool", ← q r"f:K->A",
      ← q r"\x:A. x IN group_carrier G /\ P x"]
     ITERATO_CLOSED) THEN
    ASM_SIMP_TAC [GROUP_ID, GROUP_MUL])

  let GROUP_SUM_CLOSED ← prove
   r"!P G k (f:K->A).
         P(group_id G) /\
         (!x y. x IN group_carrier G /\ y IN group_carrier G /\
                P x /\ P y
                ==> P(group_mul G x y)) /\
         (!i. i IN k /\ f i IN group_carrier G /\ ~(f i = group_id G) ==> P(f i))
         ==> P(group_sum G k f)"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT_CLOSED])

  let GROUP_PRODUCT ← prove
   r"!G (<<=) k (f:K->A). group_product G (<<=) k f IN group_carrier G"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← REWRITE_RULE []
     (← ISPEC (← q r"\x:A. x IN group_carrier G") GROUP_PRODUCT_CLOSED)) THEN
    SIMP_TAC [GROUP_ID, GROUP_MUL])

  let GROUP_SUM ← prove
   r"!G k (f:K->A). group_sum G k f IN group_carrier G"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT])

  let GROUP_PRODUCT_SUPPORT ← prove
   r"!G (<<=) k (f:K->A).
          group_product G (<<=) {i | i IN k /\ ~(f i = group_id G)} f =
          group_product G (<<=) k f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_product] THEN
    ONCE_REWRITE_TAC [← GSYM ITERATO_SUPPORT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let GROUP_SUM_SUPPORT ← prove
   r"!G k (f:K->A).
        group_sum G {i | i IN k /\ ~(f i = group_id G)} f =
        group_sum G k f"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT_SUPPORT])

  let GROUP_PRODUCT_RESTRICT ← prove
   r"!G (<<=) k (f:K->A).
          group_product G (<<=) {i | i IN k /\ f i IN group_carrier G} f =
          group_product G (<<=) k f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_product] THEN
    ONCE_REWRITE_TAC [← GSYM ITERATO_SUPPORT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let GROUP_SUM_RESTRICT ← prove
   r"!G k (f:K->A).
          group_sum G {i | i IN k /\ f i IN group_carrier G} f =
          group_sum G k f"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT_RESTRICT])

  let GROUP_PRODUCT_EXPAND_CASES ← prove
   r"!G (<<=) k (f:K->A).
          group_product G (<<=) k f =
          if FINITE {i | i IN k /\ f i IN group_carrier G DIFF {group_id G}}
          then group_product G (<<=)
                {i | i IN k /\ f i IN group_carrier G DIFF {group_id G}} f
          else group_id G"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_product] THEN
    MATCH_ACCEPT_TAC ITERATO_EXPAND_CASES)

  let GROUP_SUM_EXPAND_CASES ← prove
   r"!G k (f:K->A).
          group_sum G k f =
          if FINITE {i | i IN k /\ f i IN group_carrier G DIFF {group_id G}}
          then group_sum G
                {i | i IN k /\ f i IN group_carrier G DIFF {group_id G}} f
          else group_id G"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_sum] THEN
    MATCH_ACCEPT_TAC GROUP_PRODUCT_EXPAND_CASES)

  let GROUP_PRODUCT_RESTRICT_SET ← prove
   r"!G (<<=) P s (f:K->A).
          group_product G (<<=) {x | x IN s /\ P x} f =
          group_product G (<<=) s (\x. if P x then f x else group_id G)"
   (← do
    let m1 ← MESON [] (← q r"~((if p then x else z) = z) <=> p /\ ~(x = z)")
    pure (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM GROUP_PRODUCT_SUPPORT] THEN
    REWRITE_TAC [m1] THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM CONJ_ASSOC] THEN
    MATCH_MP_TAC GROUP_PRODUCT_EQ THEN SIMP_TAC [IN_ELIM_THM]))

  let GROUP_SUM_RESTRICT_SET ← prove
   r"!G P s (f:K->A).
          group_sum G {x | x IN s /\ P x} f =
          group_sum G s (\x. if P x then f x else group_id G)"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT_RESTRICT_SET])

  let GROUP_PRODUCT_SUPERSET ← prove
   r"!G (<<=) s t (f:K->A).
          t SUBSET s /\ (!x. x IN s /\ ~(x IN t) ==> f x = group_id G)
          ==> group_product G (<<=) s f = group_product G (<<=) t f"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM GROUP_PRODUCT_SUPPORT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let GROUP_SUM_SUPERSET ← prove
   r"!G s t (f:K->A).
          t SUBSET s /\ (!x. x IN s /\ ~(x IN t) ==> f x = group_id G)
          ==> group_sum G s f = group_sum G t f"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT_SUPERSET])

  let GROUP_PRODUCT_CLAUSES ← prove
   r"!G (<<=) (f:K->A).
        group_product G (<<=) {} f = group_id G /\
        (!i k. FINITE {j | j IN k /\ f j IN group_carrier G DIFF {group_id G}} /\
               (!j. j IN k ==> i <<= j /\ ~(j <<= i))
               ==> group_product G (<<=) (i INSERT k) f =
                     if f i IN group_carrier G ==> i IN k
                     then group_product G (<<=) k f
                     else group_mul G (f i) (group_product G (<<=) k f))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [group_product, ITERATO_CLAUSES] THEN
    ASM_CASES_TAC (← q r"(i:K) IN k") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(f:K->A) i = group_id G") THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [GROUP_MUL_LID, ← GSYM group_product, GROUP_PRODUCT, GROUP_ID])

  let GROUP_PRODUCT_CLAUSES_EXISTS ← prove
   r"!G (<<=) (f:K->A).
        group_product G (<<=) {} f = group_id G /\
        (!k. FINITE {i | i IN k /\ f i IN group_carrier G DIFF {group_id G}} /\
             ~({i | i IN k /\ f i IN group_carrier G DIFF {group_id G}} = {})
             ==> ?i. i IN k /\
                     f i IN group_carrier G DIFF {group_id G} /\
                     group_product G (<<=) k f =
                     group_mul G (f i) (group_product G (<<=) (k DELETE i) f))"
   (REWRITE_TAC [group_product] THEN
    MATCH_ACCEPT_TAC ITERATO_CLAUSES_EXISTS)

  let GROUP_SUM_CLAUSES_EXISTS ← prove
   r"!G (f:K->A).
        group_sum G {} f = group_id G /\
        (!k. FINITE {i | i IN k /\ f i IN group_carrier G DIFF {group_id G}} /\
             ~({i | i IN k /\ f i IN group_carrier G DIFF {group_id G}} = {})
             ==> ?i. i IN k /\
                     f i IN group_carrier G DIFF {group_id G} /\
                     group_sum G k f =
                     group_mul G (f i) (group_sum G (k DELETE i) f))"
   (REWRITE_TAC [group_sum] THEN MATCH_ACCEPT_TAC GROUP_PRODUCT_CLAUSES_EXISTS)

  let GROUP_PRODUCT_EQ_ID ← prove
   r"!(G:A group) (<<=) (s:K->bool) f.
          (!i. i IN s ==> f i = group_id G)
          ==> group_product G (<<=) s f = group_id G"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM GROUP_PRODUCT_SUPPORT] THEN
    ASM_SIMP_TAC [← GSYM NOT_IMP, EMPTY_GSPEC] THEN
    REWRITE_TAC [GROUP_PRODUCT_CLAUSES])

  let GROUP_SUM_EQ_ID ← prove
   r"!(G:A group) (s:K->bool) f.
          (!i. i IN s ==> f i = group_id G)
          ==> group_sum G s f = group_id G"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT_EQ_ID])

  let GROUP_PRODUCT_ID ← prove
   r"!(G:A group) (<<=) (s:K->bool).
          group_product G (<<=) s (\x. group_id G) = group_id G"
   (SIMP_TAC [GROUP_PRODUCT_EQ_ID])

  let GROUP_SUM_ID ← prove
   r"!(G:A group) (s:K->bool).
          group_sum G s (\x. group_id G) = group_id G"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT_ID])

  let GROUP_COMMUTES_PRODUCT ← prove
   r"!G (<<=) k (f:K->A) z.
          (!i. i IN k /\ f i IN group_carrier G /\ ~(f i = group_id G)
               ==> group_mul G (f i) z = group_mul G z (f i)) /\
          z IN group_carrier G
          ==> group_mul G (group_product G (<<=) k f) z =
              group_mul G z (group_product G (<<=) k f)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE []
     (← ISPEC (← q r"\x:A. group_mul G x z = group_mul G z x") GROUP_PRODUCT_CLOSED)) THEN
    ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_MUL_RID] THEN
    ASM_MESON_TAC [GROUP_COMMUTES_MUL])

  let GROUP_COMMUTES_SUM ← prove
   r"!G k (f:K->A) z.
          (!i. i IN k /\ f i IN group_carrier G /\ ~(f i = group_id G)
               ==> group_mul G (f i) z = group_mul G z (f i)) /\
          z IN group_carrier G
          ==> group_mul G (group_sum G k f) z = group_mul G z (group_sum G k f)"
   (REWRITE_TAC [group_sum, GROUP_COMMUTES_PRODUCT])

  let GROUP_PRODUCT_SING ← prove
   r"!G (<<=) i (f:K->A).
          group_product G (<<=) {i} f =
          if f i IN group_carrier G then f i else group_id G"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [GROUP_PRODUCT_CLAUSES, NOT_IN_EMPTY, EMPTY_GSPEC, FINITE_EMPTY] THEN
    SIMP_TAC [COND_SWAP, GROUP_MUL_RID])

  let GROUP_SUM_SING ← prove
   r"!G i (f:K->A).
          group_sum G {i} f =
          if f i IN group_carrier G then f i else group_id G"
   (REWRITE_TAC [group_sum, GROUP_PRODUCT_SING])

  -- @@RETURN BEGIN
  return { group_product, group_sum, GROUP_PRODUCT_EQ, GROUP_SUM_EQ,
           GROUP_PRODUCT_CLOSED, GROUP_SUM_CLOSED, GROUP_PRODUCT, GROUP_SUM,
           GROUP_PRODUCT_SUPPORT, GROUP_SUM_SUPPORT, GROUP_PRODUCT_RESTRICT,
           GROUP_SUM_RESTRICT, GROUP_PRODUCT_EXPAND_CASES, GROUP_SUM_EXPAND_CASES,
           GROUP_PRODUCT_RESTRICT_SET, GROUP_SUM_RESTRICT_SET, GROUP_PRODUCT_SUPERSET,
           GROUP_SUM_SUPERSET, GROUP_PRODUCT_CLAUSES, GROUP_PRODUCT_CLAUSES_EXISTS,
           GROUP_SUM_CLAUSES_EXISTS, GROUP_PRODUCT_EQ_ID, GROUP_SUM_EQ_ID,
           GROUP_PRODUCT_ID, GROUP_SUM_ID, GROUP_COMMUTES_PRODUCT, GROUP_COMMUTES_SUM,
           GROUP_PRODUCT_SING, GROUP_SUM_SING }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Products over an arbitrary wellorder (continued): unions, left/right and  -/
/- numseg clauses, commuting clauses.  (grouptheory.ml 1310-1507)            -/
/- ------------------------------------------------------------------------- -/

structure GroupProductClauses where
  -- @@FIELDS
  GROUP_PRODUCT_UNION : thm
  GROUP_PRODUCT_CLAUSES_LEFT : thm
  GROUP_PRODUCT_CLAUSES_RIGHT : thm
  GROUP_PRODUCT_CLAUSES_NUMSEG : thm
  GROUP_PRODUCT_CLAUSES_COMMUTING : thm
  ABELIAN_GROUP_PRODUCT_CLAUSES : thm
  GROUP_SUM_CLAUSES_COMMUTING : thm
  ABELIAN_GROUP_SUM_CLAUSES : thm
  deriving Inhabited

@[nospecialize]
def setupGroupProductClauses [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BAbelian : Abelian) (BGroupProduct : GroupProduct) :
    ExceptT String IO GroupProductClauses := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC,
        SELECT_CONV, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARD_DELETE, CARD_EQ_0, CONJ_ASSOC, .. } := D.core1
  let { EMPTY_NUMSEG, .. } := D.core2
  let { FINITE_DELETE, FINITE_INSERT, FINITE_NUMSEG, FINITE_RESTRICT, FINITE_SING,
        FINITE_SUBSET, FINITE_UNION, FLD_num, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, .. } := D.core4
  let { IN_DELETE, IN_NUMSEG, IN_SING, IN_UNION, IN_UNIV, .. } := D.core5
  let { LE, LEFT_IMP_EXISTS_THM, NOT_IMP, NOT_LE, NOT_SUC, NUMSEG_CLAUSES, NUMSEG_LREC,
        NUMSEG_RREC, NUMSEG_SING, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET_UNIV, SUB_0, SUC_SUB1, UNION_EMPTY, WO, WOSET_num, .. } := D.core7
  let { num_WF, woset, .. } := D.core8
  let { GROUP_ID, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_RID, .. } := BBasics
  let { abelian_group, .. } := BAbelian
  let { GROUP_COMMUTES_PRODUCT, GROUP_PRODUCT, GROUP_PRODUCT_CLAUSES,
        GROUP_PRODUCT_CLAUSES_EXISTS, GROUP_PRODUCT_EXPAND_CASES,
        GROUP_PRODUCT_RESTRICT, GROUP_PRODUCT_SING, GROUP_PRODUCT_SUPPORT, group_sum, .. } := BGroupProduct
  -- @@SCOPE END

  let GROUP_PRODUCT_UNION ← prove
   r"!G (<<=) (f:K->A) s t.
        woset(<<=) /\ fld(<<=) = (:K) /\
        (FINITE {i | i IN s /\ f i IN group_carrier G DIFF {group_id G}} <=>
         FINITE {i | i IN t /\ f i IN group_carrier G DIFF {group_id G}}) /\
        (!x y. x IN s /\ y IN t ==> x <<= y /\ ~(x = y))
        ==> group_product G (<<=) (s UNION t) f =
            group_mul G (group_product G (<<=) s f)
                        (group_product G (<<=) t f)"
   (← do
    let a4 ← ARITH_RULE (← q r"n - 1 < n <=> ~(n = 0)")
    let s6 ← SET_RULE (← q r"i IN s ==> i INSERT (s DELETE i UNION t) = s UNION t")
    let s5 ← SET_RULE (← q r"i IN s ==> i INSERT (s DELETE i) = s")
    let m3 ← MESON []
      (← q r"(!n s. FINITE s /\ CARD s = n ==> P s) ==> !s. FINITE s ==> P s")
    let t2 ← TAUT (← q r"(p <=> q) ==> (q ==> q /\ p)")
    let s1 ← SET_RULE
      (← q r"{x | x IN s UNION t /\ P x} =
    {x | x IN s /\ P x} UNION {x | x IN t /\ P x}")
    pure (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [GROUP_PRODUCT_EXPAND_CASES] THEN
    REWRITE_TAC [s1] THEN
    REWRITE_TAC [FINITE_UNION] THEN ASM_CASES_TAC
    (← q r"FINITE {i | i IN t /\ (f:K->A) i IN group_carrier G DIFF {group_id G}}") THEN
    ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_ID] THEN
    SUBGOAL_THEN
     (← q r"(!i. i IN {i | i IN s /\ (f:K->A) i IN group_carrier G DIFF {group_id G}}
           ==> f i IN group_carrier G /\ ~(f i = group_id G)) /\
      (!i. i IN {i | i IN t /\ (f:K->A) i IN group_carrier G DIFF {group_id G}}
           ==> f i IN group_carrier G /\ ~(f i = group_id G))")
    MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN {i | i IN s /\ f i IN group_carrier G DIFF {group_id G}} /\
            y IN {i | i IN t /\ (f:K->A) i IN group_carrier G DIFF {group_id G}}
            ==> x <<= y /\ ~(x = y)")
    MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP t2) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    MAP_EVERY UNDISCH_TAC [← q r"fld(<<=) = (:K)", ← q r"woset((<<=):K->K->bool)"] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN DISCH_TAC THEN DISCH_TAC THEN
    SPEC_TAC (← q r"{i | i IN s /\ (f:K->A) i IN group_carrier G DIFF {group_id G}}",
             ← q r"s:K->bool") THEN
    SPEC_TAC (← q r"{i | i IN t /\ (f:K->A) i IN group_carrier G DIFF {group_id G}}",
             ← q r"t:K->bool") THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    X_GEN_TAC (← q r"t:K->bool") THEN DISCH_TAC THEN ASM_CASES_TAC
     (← q r"!i. i IN t ==> (f:K->A) i IN group_carrier G /\ ~(f i = group_id G)") THEN
    ASM_REWRITE_TAC [← GSYM CONJ_ASSOC, IMP_IMP] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC m3 THEN
    MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q "n:num") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"s:K->bool") THEN
    ASM_CASES_TAC (← q r"s:K->bool = {}") THEN
    ASM_REWRITE_TAC [UNION_EMPTY, GROUP_PRODUCT_CLAUSES_EXISTS] THEN
    SIMP_TAC [GROUP_MUL_LID, GROUP_PRODUCT] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do pure (MP_TAC (← SPEC (← q r"s:K->bool")
      (← liftExcept (last (CONJUNCTS (← GEN_REWRITE_RULE I [woset] th))))))) THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "i:K") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"(<<=):K->K->bool", ← q r"f:K->A"]
          GROUP_PRODUCT_CLAUSES) THEN
    DISCH_THEN (MP_TAC o SPEC (← q "i:K") o CONJUNCT2) THEN DISCH_THEN (fun th => tactic_of do
      let a ← SPEC (← q r"s DELETE (i:K)") th
      let b ← SPEC (← q r"(s DELETE (i:K)) UNION t") th
      pure (MP_TAC a THEN MP_TAC b)) THEN
    ASM_SIMP_TAC [FINITE_DELETE, FINITE_UNION, FINITE_RESTRICT,
      IN_DELETE, IN_UNION, s5, s6] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [woset]) THEN
    ASM_REWRITE_TAC [IN_UNIV] THEN STRIP_TAC THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN SUBST1_TAC] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN SUBST1_TAC] THEN
    COND_CASES_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "n - 1")) THEN
    REWRITE_TAC [a4] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [CARD_EQ_0], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s DELETE (i:K)")) THEN
    ASM_SIMP_TAC [FINITE_DELETE, CARD_DELETE, IN_DELETE] THEN
    ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_MUL, GROUP_PRODUCT]))

  let GROUP_PRODUCT_CLAUSES_LEFT ← prove
   r"!G (f:num->A) m n.
        group_product G (<=) (m..n) f =
        if m <= n then
           if f m IN group_carrier G
           then group_mul G (f m) (group_product G (<=) (m+1..n) f)
           else group_product G (<=) (m+1..n) f
         else group_id G"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THENL
     [ASM_SIMP_TAC [← GSYM NUMSEG_LREC],
      ASM_SIMP_TAC [EMPTY_NUMSEG, ← GSYM NOT_LE, GROUP_PRODUCT_CLAUSES]] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = {a} UNION s")] THEN
    wPart lhand (fun t => do lhand (← rand t)) GROUP_PRODUCT_UNION THEN
    SIMP_TAC [WOSET_num, FLD_num, FINITE_RESTRICT, FINITE_SING, FINITE_NUMSEG,
             IN_NUMSEG, IN_SING] THEN
    ANTS_TAC THENL [ARITH_TAC, DISCH_THEN SUBST1_TAC] THEN
    REWRITE_TAC [GROUP_PRODUCT_SING] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_PRODUCT])

  let GROUP_PRODUCT_CLAUSES_RIGHT ← prove
   r"!G (f:num->A) m n.
        group_product G (<=) (m..n) f =
        if m <= n then
           if f n IN group_carrier G
           then if n = 0 then f 0
                else group_mul G (group_product G (<=) (m..n-1) f) (f n)
           else group_product G (<=) (m..n-1) f
         else group_id G"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q "n = 0") THENL
     [ASM_SIMP_TAC [← CONJUNCT1 LE, SUB_0, NUMSEG_CLAUSES] THEN
      ASM_CASES_TAC (← q "m = 0") THEN ASM_SIMP_TAC [GROUP_PRODUCT_SING] THEN
      REWRITE_TAC [GROUP_PRODUCT_CLAUSES],
      ASM_REWRITE_TAC []] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM_SIMP_TAC [← GSYM NUMSEG_RREC],
      ASM_SIMP_TAC [EMPTY_NUMSEG, ← GSYM NOT_LE, GROUP_PRODUCT_CLAUSES]] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = s UNION {a}")] THEN
    wPart lhand (fun t => do lhand (← rand t)) GROUP_PRODUCT_UNION THEN
    SIMP_TAC [WOSET_num, FLD_num, FINITE_RESTRICT, FINITE_SING, FINITE_NUMSEG,
             IN_NUMSEG, IN_SING] THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC] THEN
    REWRITE_TAC [GROUP_PRODUCT_SING] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [GROUP_MUL_RID, GROUP_PRODUCT])

  let GROUP_PRODUCT_CLAUSES_NUMSEG ← prove
   r"(!G m f:num->A.
        group_product G (<=) (m..0) f =
        if m = 0 /\ f 0 IN group_carrier G then f 0 else group_id G) /\
   (!G m n f:num->A.
        group_product G (<=) (m..SUC n) f =
        if m <= SUC n /\ f(SUC n) IN group_carrier G
        then group_mul G (group_product G (<=) (m..n) f) (f(SUC n))
        else group_product G (<=) (m..n) f)"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [GROUP_PRODUCT_CLAUSES_RIGHT] THEN
    SIMP_TAC [← CONJUNCT1 LE, NOT_SUC, SUC_SUB1, SUB_0, NUMSEG_SING,
             GROUP_PRODUCT_SING]
    THENL [MESON_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q "m <= SUC n") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [EMPTY_NUMSEG, ← ARITH_RULE (← q r"~(m <= SUC n) ==> n < m")] THEN
    REWRITE_TAC [GROUP_PRODUCT_CLAUSES])

  let GROUP_PRODUCT_CLAUSES_COMMUTING ← prove
   r"!G (<<=) i k (f:K->A).
        woset(<<=) /\ fld(<<=) = (:K) /\
        FINITE {j | j IN k /\ f j IN group_carrier G DIFF {group_id G}} /\
        (!j. j IN k /\ j <<= i /\ ~(j = i) /\
             f i IN group_carrier G /\ f j IN group_carrier G
             ==> group_mul G (f i) (f j) = group_mul G (f j) (f i))
        ==> group_product G (<<=) (i INSERT k) f =
                if f i IN group_carrier G ==> i IN k
                then group_product G (<<=) k f
                else group_mul G (f i) (group_product G (<<=) k f)"
   (← do
    -- `let tac pfn = ... in`: a function, so its MESON, TAUT and `i:K` are
    -- evaluated afresh at each of its three calls (right to left inside).
    let tac (pfn : term → Except String term) : ExceptT String IO tactic := do
      let qiK ← q "i:K"
      let m1 ← MESON [FINITE_INSERT, FINITE_SUBSET]
        (← q r"FINITE s ==> !i. t SUBSET i INSERT s ==> FINITE t")
      let t1 ← TAUT (← q r"p /\ q ==> (p <=> q)")
      pure (wPart pfn (fun t => do lhand (← rand t)) GROUP_PRODUCT_UNION THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
         [MATCH_MP_TAC t1 THEN CONJ_TAC THEN
          FIRST_X_ASSUM (fun th => tactic_of do pure (MATCH_MP_TAC (← MATCH_MP m1 th))) THEN
          EXISTS_TAC qiK THEN SET_TAC [],
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [woset]) THEN
          ASM_REWRITE_TAC [IN_UNIV] THEN ASM SET_TAC []],
        DISCH_THEN SUBST1_TAC])
    -- OCaml order: tac (rand o rand), tac (lhand o lhand), the second
    -- SET_RULE, tac lhand, the first SET_RULE.
    let tac3 ← tac (fun t => do rand (← rand t))
    let tac2 ← tac (fun t => do lhand (← lhand t))
    let sB ← SET_RULE (← q r"i INSERT s = s UNION {i}")
    let tac1 ← tac lhand
    let sA ← SET_RULE (← q r"i INSERT (l UNION r) = (i INSERT l) UNION r")
    pure (REPEAT STRIP_TAC THEN COND_CASES_TAC THENL
     [ONCE_REWRITE_TAC [← GSYM GROUP_PRODUCT_RESTRICT] THEN
      ONCE_REWRITE_TAC [← GSYM GROUP_PRODUCT_SUPPORT] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC [],
      FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [NOT_IMP])] THEN
    SUBGOAL_THEN
     (← q r"k = {j:K | j IN k /\ j <<= i /\ ~(j = i)} UNION
          {j | j IN k /\ i <<= j /\ ~(j = i)}")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [woset]) THEN
      ASM_REWRITE_TAC [IN_UNIV] THEN ASM SET_TAC [],
      ONCE_REWRITE_TAC [sA]] THEN
    tac1 THEN
    ONCE_REWRITE_TAC [sB] THEN
    tac2 THEN
    tac3 THEN
     ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_PRODUCT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ASM_REWRITE_TAC [GROUP_PRODUCT_SING] THEN
    MATCH_MP_TAC GROUP_COMMUTES_PRODUCT THEN ASM SET_TAC []))

  let ABELIAN_GROUP_PRODUCT_CLAUSES ← prove
   r"!G (<<=) i k (f:K->A).
        woset(<<=) /\ fld(<<=) = (:K) /\
        abelian_group G /\
        FINITE {j | j IN k /\ f j IN group_carrier G DIFF {group_id G}}
        ==> group_product G (<<=) (i INSERT k) f =
                if f i IN group_carrier G ==> i IN k
                then group_product G (<<=) k f
                else group_mul G (f i) (group_product G (<<=) k f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_PRODUCT_CLAUSES_COMMUTING THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [abelian_group])

  let GROUP_SUM_CLAUSES_COMMUTING ← prove
   r"!G i k (f:K->A).
        FINITE {j | j IN k /\ f j IN group_carrier G DIFF {group_id G}} /\
        (!j. j IN k /\ ~(j = i) /\
             f i IN group_carrier G /\ f j IN group_carrier G
             ==> group_mul G (f i) (f j) = group_mul G (f j) (f i))
        ==> group_sum G (i INSERT k) f =
                if f i IN group_carrier G ==> i IN k
                then group_sum G k f
                else group_mul G (f i) (group_sum G k f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_sum] THEN
    MATCH_MP_TAC GROUP_PRODUCT_CLAUSES_COMMUTING THEN ASM_SIMP_TAC [] THEN
    CONV_TAC SELECT_CONV THEN REWRITE_TAC [WO])

  let ABELIAN_GROUP_SUM_CLAUSES ← prove
   r"!G i k (f:K->A).
        abelian_group G /\
        FINITE {j | j IN k /\ f j IN group_carrier G DIFF {group_id G}}
        ==> group_sum G (i INSERT k) f =
                if f i IN group_carrier G ==> i IN k
                then group_sum G k f
                else group_mul G (f i) (group_sum G k f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_SUM_CLAUSES_COMMUTING THEN
    ASM_MESON_TAC [abelian_group])

  -- @@RETURN BEGIN
  return { GROUP_PRODUCT_UNION, GROUP_PRODUCT_CLAUSES_LEFT, GROUP_PRODUCT_CLAUSES_RIGHT,
           GROUP_PRODUCT_CLAUSES_NUMSEG, GROUP_PRODUCT_CLAUSES_COMMUTING,
           ABELIAN_GROUP_PRODUCT_CLAUSES, GROUP_SUM_CLAUSES_COMMUTING,
           ABELIAN_GROUP_SUM_CLAUSES }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Products/sums over a wellorder: multiplicativity, inverses, powers,       -/
/- image reindexing, and the link to `iterate`.  (grouptheory.ml 1507-1794)  -/
/- ------------------------------------------------------------------------- -/

structure GroupProductMul where
  -- @@FIELDS
  GROUP_PRODUCT_MUL : thm
  GROUP_SUM_MUL : thm
  ABELIAN_GROUP_SUM_MUL : thm
  GROUP_SUM_INV : thm
  ABELIAN_GROUP_SUM_INV : thm
  GROUP_SUM_POW : thm
  ABELIAN_GROUP_SUM_POW : thm
  GROUP_SUM_ZPOW : thm
  ABELIAN_GROUP_SUM_ZPOW : thm
  GROUP_SUM_IMAGE : thm
  ABELIAN_GROUP_PRODUCT_ITERATE : thm
  ABELIAN_GROUP_SUM_ITERATE : thm
  ABELIAN_GROUP_ITERATE : thm
  deriving Inhabited

@[nospecialize]
def setupGroupProductMul [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BTotalized : Totalized) (BGroupProduct : GroupProduct) (BGroupProductClauses : GroupProductClauses) :
    ExceptT String IO GroupProductMul := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, MESON, SELECT_CONV, SET_RULE, SET_TAC,
        TAUT, .. } := D
  let { CARD_DELETE, CARD_EQ_0, .. } := D.core1
  let { CONTRAPOS_THM, EQ_IMP, .. } := D.core2
  let { FINITE_DELETE, FINITE_IMAGE, FINITE_IMAGE_INJ_EQ, FINITE_INDUCT_STRONG,
        FINITE_RESTRICT, FINITE_SING, FINITE_SUBSET, FINITE_UNION, FORALL_INT_CASES,
        FORALL_IN_INSERT, .. } := D.core3
  let { IMAGE_CLAUSES, IMP_CONJ, IMP_IMP, INJECTIVE_ON_ALT, .. } := D.core4
  let { IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_SING, ITERATE_CLAUSES,
        ITERATE_EXPAND_CASES, .. } := D.core5
  let { NOT_IMP, PAIRWISE_IMP, PAIRWISE_MONO, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_UNIV, SWAP_FORALL_THM, WO, .. } := D.core7
  let { num_WF, o_THM, pairwise, support, woset, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_RID,
        GROUP_MUL_RINV, .. } := BBasics
  let { GROUP_COMMUTES_INV, GROUP_INV_EQ_ID, GROUP_LINV_UNIQUE, GROUP_POW,
        GROUP_POW_ID, group_pow, .. } := BDerived
  let { GROUP_COMMUTES_POW, GROUP_NPOW, GROUP_ZPOW_NEG, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { GROUP_ADD_EQ_MUL, MONOIDAL_GROUP_ADD, NEUTRAL_GROUP_ADD, .. } := BTotalized
  let { GROUP_COMMUTES_PRODUCT, GROUP_PRODUCT, GROUP_PRODUCT_CLAUSES,
        GROUP_PRODUCT_CLAUSES_EXISTS, GROUP_PRODUCT_EXPAND_CASES,
        GROUP_PRODUCT_RESTRICT, GROUP_PRODUCT_SING, GROUP_PRODUCT_SUPPORT, GROUP_SUM,
        GROUP_SUM_CLAUSES_EXISTS, GROUP_SUM_EQ_ID, GROUP_SUM_EXPAND_CASES,
        GROUP_SUM_ID, group_sum, .. } := BGroupProduct
  let { ABELIAN_GROUP_PRODUCT_CLAUSES, ABELIAN_GROUP_SUM_CLAUSES, GROUP_PRODUCT_UNION, .. } := BGroupProductClauses
  -- @@SCOPE END

  let GROUP_PRODUCT_MUL ← prove
   r"!G (<<=) k f (g:K->A).
      woset(<<=) /\ fld(<<=) = (:K) /\
      FINITE {i | i IN k /\ ~(f i = group_id G)} /\
      FINITE {i | i IN k /\ ~(g i = group_id G)} /\
      (!i. i IN k ==> f i IN group_carrier G /\ g i IN group_carrier G) /\
      pairwise (\i j. group_mul G (f i) (g j) = group_mul G (g j) (f i)) k
      ==> group_product G (<<=) k (\i. group_mul G (f i) (g i)) =
          group_mul G (group_product G (<<=) k f) (group_product G (<<=) k g)"
   (← do
    let a4 ← ARITH_RULE (← q r"n - 1 < n <=> ~(n = 0)")
    let m3 ← MESON []
      (← q r"(!s. ~(s = {}) ==> P s) /\ ~(t = {}) ==> P t")
    let m2 ← MESON [CARD_EQ_0]
      (← q r"CARD s = n ==> FINITE s /\ ~(n = 0) ==> ~(s = {})")
    let m1 ← MESON []
      (← q r"(!n s. FINITE s /\ CARD s = n ==> P s)
    ==> !s. FINITE s ==> P s")
    -- `W(fun (asl,w) -> ABBREV_TAC(mk_eq(`t:K->bool`,rand(lhand w))))`
    let abbrevT : tactic := fun gl => tactic_of (do
      let (_asl, w) := gl
      let mkeq ← ExceptT.mk mk_eq
      let tv ← q "t:K->bool"
      let rl ← liftExcept (do rand (← lhand w))
      let eq ← liftExcept (mkeq (tv, rl))
      pure (ABBREV_TAC eq)) gl
    pure (GEN_REWRITE_TAC (funpow 2 BINDER_CONV) [SWAP_FORALL_THM] THEN
    GEN_REWRITE_TAC (funpow 3 BINDER_CONV) [SWAP_FORALL_THM] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN DISCH_TAC THEN GEN_TAC THEN GEN_TAC THEN
    ONCE_REWRITE_TAC [IMP_IMP] THEN REWRITE_TAC [← GSYM FINITE_UNION] THEN
    X_GEN_TAC (← q r"s:K->bool") THEN
    abbrevT THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"group_product G (<<=) t (\i. group_mul G (f i) (g i)) =
      group_mul G (group_product G (<<=) t (f:K->A)) (group_product G (<<=) t g)")
    MP_TAC THENL
     [SUBGOAL_THEN
       (← q r"!i. i IN t ==> (f:K->A) i IN group_carrier G /\ g i IN group_carrier G")
      MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:K->bool") o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] PAIRWISE_MONO)) THEN
      ANTS_TAC THENL [ASM SET_TAC [], UNDISCH_TAC (← q r"FINITE(t:K->bool)")] THEN
      FIRST_X_ASSUM ((fun (_ : thm) => ALL_TAC) o SYM) THEN
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o check (is_forall o concl)),
      MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
       [ALL_TAC, BINOP_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM GROUP_PRODUCT_RESTRICT] THEN
      ONCE_REWRITE_TAC [← GSYM GROUP_PRODUCT_SUPPORT] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      MP_TAC (← ISPEC (← q "G:A group") GROUP_MUL_LID) THEN
      MP_TAC (← ISPEC (← q "G:A group") GROUP_MUL_RID) THEN ASM SET_TAC []] THEN
    SPEC_TAC (← q r"t:K->bool", ← q r"s:K->bool") THEN MATCH_MP_TAC m1 THEN
    MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q "n:num") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"s:K->bool") THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    ASM_CASES_TAC (← q "n = 0") THENL
     [ASM_SIMP_TAC [CARD_EQ_0] THEN
      REWRITE_TAC [GROUP_PRODUCT_CLAUSES] THEN SIMP_TAC [GROUP_MUL_LID, GROUP_ID],
      REPEAT DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP m2) THEN
      ASM_REWRITE_TAC []] THEN
    FIRST_ASSUM (fun th => tactic_of do pure (MP_TAC
      (← liftExcept (last (CONJUNCTS (← GEN_REWRITE_RULE I [woset] th)))))) THEN
    ASM_REWRITE_TAC [IMP_IMP, SUBSET_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP m3) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "i:K") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"s = {i:K} UNION (s DELETE i)") SUBST1_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    wPart lhand (fun t => do lhand (← rand t)) GROUP_PRODUCT_UNION THEN
    ASM_SIMP_TAC [FINITE_DELETE, FINITE_RESTRICT, FINITE_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
    wPart (fun t => do lhand (← rand t)) (fun t => do lhand (← rand t)) GROUP_PRODUCT_UNION THEN
    ASM_SIMP_TAC [FINITE_DELETE, FINITE_RESTRICT, FINITE_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
    wPart (fun t => do rand (← rand t)) (fun t => do lhand (← rand t)) GROUP_PRODUCT_UNION THEN
    ASM_SIMP_TAC [FINITE_DELETE, FINITE_RESTRICT, FINITE_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
    REWRITE_TAC [GROUP_PRODUCT_SING] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "n - 1")) THEN
    REWRITE_TAC [a4] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [CARD_EQ_0], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s DELETE (i:K)")) THEN
    ASM_SIMP_TAC [FINITE_DELETE, CARD_DELETE, IN_DELETE] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do pure (MATCH_MP_TAC
       (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] PAIRWISE_MONO) th))) THEN
      SET_TAC [],
      DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL, GROUP_PRODUCT] THEN
    AP_TERM_TAC THEN
    ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_MUL, GROUP_PRODUCT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC GROUP_COMMUTES_PRODUCT THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [pairwise]) THEN ASM SET_TAC []))

  let GROUP_SUM_MUL ← prove
   r"!G k f (g:K->A).
        FINITE {i | i IN k /\ ~(f i = group_id G)} /\
        FINITE {i | i IN k /\ ~(g i = group_id G)} /\
        (!i. i IN k ==> f i IN group_carrier G /\ g i IN group_carrier G) /\
        pairwise (\i j. group_mul G (f i) (g j) = group_mul G (g j) (f i)) k
        ==> group_sum G k (\i. group_mul G (f i) (g i)) =
            group_mul G (group_sum G k f) (group_sum G k g)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_sum] THEN
    MATCH_MP_TAC GROUP_PRODUCT_MUL THEN ASM_REWRITE_TAC [] THEN
    CONV_TAC SELECT_CONV THEN REWRITE_TAC [WO])

  let ABELIAN_GROUP_SUM_MUL ← prove
   r"!G k f (g:K->A).
        abelian_group G /\
        FINITE {i | i IN k /\ ~(f i = group_id G)} /\
        FINITE {i | i IN k /\ ~(g i = group_id G)} /\
        (!i. i IN k ==> f i IN group_carrier G /\ g i IN group_carrier G)
        ==> group_sum G k (\i. group_mul G (f i) (g i)) =
            group_mul G (group_sum G k f) (group_sum G k g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_SUM_MUL THEN
    ASM_REWRITE_TAC [pairwise] THEN ASM_MESON_TAC [abelian_group])

  let GROUP_SUM_INV ← prove
   r"!G k (f:K->A).
        FINITE {i | i IN k /\ ~(f i = group_id G)} /\
        (!i. i IN k ==> f i IN group_carrier G) /\
        pairwise (\i j. group_mul G (f i) (f j) = group_mul G (f j) (f i)) k
        ==> group_sum G k (\i. group_inv G (f i)) =
            group_inv G (group_sum G k f)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC GROUP_LINV_UNIQUE THEN REWRITE_TAC [GROUP_SUM] THEN
    wPart lhand (fun t => do rand (← rand t)) GROUP_SUM_MUL THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [GROUP_INV] THEN
      ASM_SIMP_TAC [← GSYM NOT_IMP, GROUP_INV_EQ_ID] THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN
      FIRST_X_ASSUM (fun th => tactic_of do pure (MATCH_MP_TAC
        (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] PAIRWISE_IMP) th))) THEN
      ASM_MESON_TAC [GROUP_COMMUTES_INV],
      DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC GROUP_SUM_EQ_ID THEN
      ASM_SIMP_TAC [GROUP_MUL_RINV]])

  let ABELIAN_GROUP_SUM_INV ← prove
   r"!G k (f:K->A).
        abelian_group G /\
        FINITE {i | i IN k /\ ~(f i = group_id G)} /\
        (!i. i IN k ==> f i IN group_carrier G)
        ==> group_sum G k (\i. group_inv G (f i)) =
            group_inv G (group_sum G k f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_SUM_INV THEN
    ASM_REWRITE_TAC [pairwise] THEN ASM_MESON_TAC [abelian_group])

  let GROUP_SUM_POW ← prove
   r"!G k (f:K->A) n.
        FINITE {i | i IN k /\ ~(f i = group_id G)} /\
        (!i. i IN k ==> f i IN group_carrier G) /\
        pairwise (\i j. group_mul G (f i) (f j) = group_mul G (f j) (f i)) k
        ==> group_sum G k (\i. group_pow G (f i) n) =
            group_pow G (group_sum G k f) n"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [group_pow, GROUP_SUM_ID] THEN
    wPart lhand (fun t => do lhand (← rand t)) GROUP_SUM_MUL THEN
    ASM_SIMP_TAC [GROUP_POW] THEN DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do pure (MATCH_MP_TAC
        (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET) th))) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_SIMP_TAC [CONTRAPOS_THM, GROUP_POW_ID],
       FIRST_X_ASSUM (fun th => tactic_of do pure (MATCH_MP_TAC
        (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] PAIRWISE_IMP) th))) THEN
      ASM_MESON_TAC [GROUP_COMMUTES_POW]])

  let ABELIAN_GROUP_SUM_POW ← prove
   r"!G k (f:K->A) n.
        abelian_group G /\
        FINITE {i | i IN k /\ ~(f i = group_id G)} /\
        (!i. i IN k ==> f i IN group_carrier G)
        ==> group_sum G k (\i. group_pow G (f i) n) =
            group_pow G (group_sum G k f) n"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_SUM_POW THEN
    ASM_REWRITE_TAC [pairwise] THEN ASM_MESON_TAC [abelian_group])

  let GROUP_SUM_ZPOW ← prove
   r"!G k (f:K->A) n.
        FINITE {i | i IN k /\ ~(f i = group_id G)} /\
        (!i. i IN k ==> f i IN group_carrier G) /\
        pairwise (\i j. group_mul G (f i) (f j) = group_mul G (f j) (f i)) k
        ==> group_sum G k (\i. group_zpow G (f i) n) =
            group_zpow G (group_sum G k f) n"
   (SIMP_TAC [FORALL_INT_CASES, GROUP_NPOW, GROUP_ZPOW_NEG, GROUP_SUM] THEN
    REWRITE_TAC [GROUP_SUM_POW] THEN REPEAT STRIP_TAC THEN
    wPart lhand (fun t => do lhand (← rand t)) GROUP_SUM_INV THEN
    ASM_SIMP_TAC [GROUP_SUM_POW, GROUP_POW] THEN
    DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do pure (MATCH_MP_TAC
        (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET) th))) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_SIMP_TAC [CONTRAPOS_THM, GROUP_POW_ID],
       FIRST_X_ASSUM (fun th => tactic_of do pure (MATCH_MP_TAC
        (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] PAIRWISE_IMP) th))) THEN
      ASM_MESON_TAC [GROUP_COMMUTES_POW, GROUP_POW]])

  let ABELIAN_GROUP_SUM_ZPOW ← prove
   r"!G k (f:K->A) n.
        abelian_group G /\
        FINITE {i | i IN k /\ ~(f i = group_id G)} /\
        (!i. i IN k ==> f i IN group_carrier G)
        ==> group_sum G k (\i. group_zpow G (f i) n) =
            group_zpow G (group_sum G k f) n"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_SUM_ZPOW THEN
    ASM_REWRITE_TAC [pairwise] THEN ASM_MESON_TAC [abelian_group])

  let GROUP_SUM_IMAGE ← prove
   r"!G (f:K->A) (g:A->B) s.
        abelian_group G /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> group_sum G (IMAGE f s) g = group_sum G s (g o f)"
   (← do
    let m3 ← MESON []
      (← q r"(p <=> q) /\ (q ==> x = y)
      ==> (if p then x else z) = (if q then y else z)")
    let s2 ← SET_RULE
      (← q r"{y | y IN IMAGE f s /\ P y} = IMAGE f {x | x IN s /\ P(f x)}")
    let m1 ← MESON []
      (← q r"((!s. FINITE s ==> P s) ==> (!s. P s)) /\ (!s. FINITE s ==> P s)
    ==> !s. P s")
    pure (ONCE_REWRITE_TAC [IMP_CONJ] THEN REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN GEN_TAC THEN MATCH_MP_TAC m1 THEN
    REWRITE_TAC [IMP_IMP] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [GROUP_SUM_EXPAND_CASES] THEN
      REWRITE_TAC [o_THM, s2] THEN
      MATCH_MP_TAC m3 THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_IMAGE_INJ_EQ THEN ASM SET_TAC [], DISCH_TAC] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [],
      REWRITE_TAC [INJECTIVE_ON_ALT] THEN ONCE_REWRITE_TAC [IMP_CONJ]] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [GROUP_SUM_CLAUSES_EXISTS, IMAGE_CLAUSES] THEN
    ASM_SIMP_TAC [ABELIAN_GROUP_SUM_CLAUSES, FINITE_RESTRICT, FINITE_IMAGE] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN ASM_REWRITE_TAC [o_THM] THEN
    ASM_CASES_TAC (← q r"(f:K->A) x IN IMAGE f s") THEN ASM_REWRITE_TAC [] THEN
    ASM SET_TAC []))

  let ABELIAN_GROUP_PRODUCT_ITERATE ← prove
   r"!G (<<=) (x:K->A) k.
        woset(<<=) /\
        fld(<<=) = (:K) /\
        abelian_group G /\
        (!i. i IN k ==> x i IN group_carrier G)
        ==> group_product G (<<=) k x = iterate (group_add G) k x"
   (← do
    let m2 ← MESON []
      (← q r"(p ==> q ==> x = y)
    ==> q ==> ((if p then x else z) = (if p then y else z))")
    let t1 ← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")
    pure (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    ONCE_REWRITE_TAC [GROUP_PRODUCT_EXPAND_CASES, ITERATE_EXPAND_CASES] THEN
    REWRITE_TAC [support, NEUTRAL_GROUP_ADD] THEN
    ONCE_REWRITE_TAC [t1] THEN
    ASM_SIMP_TAC [IN_DIFF, IN_SING] THEN REWRITE_TAC [NOT_IMP] THEN
    SUBGOAL_THEN
     (← q r"!i. i IN {j | j IN k /\ ~((x:K->A) j = group_id G)}
          ==> x i IN group_carrier G /\ ~(x i = group_id G)")
    MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN MATCH_MP_TAC m2 THEN
    FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o check (is_forall o concl)) THEN
    SPEC_TAC (← q r"{j | j IN k /\ ~((x:K->A) j = group_id G)}", ← q r"k:K->bool") THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [← CONJUNCT1 (← SPEC_ALL GROUP_PRODUCT_CLAUSES_EXISTS),
                 ITERATE_CLAUSES,
                 ABELIAN_GROUP_PRODUCT_CLAUSES, MONOIDAL_GROUP_ADD,
                 FINITE_RESTRICT, FORALL_IN_INSERT, NEUTRAL_GROUP_ADD] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ADD_EQ_MUL THEN
    ASM_REWRITE_TAC [GROUP_PRODUCT]))

  let ABELIAN_GROUP_SUM_ITERATE ← prove
   r"!G (x:K->A) k.
        abelian_group G /\
        (!i. i IN k ==> x i IN group_carrier G)
        ==> group_sum G k x = iterate (group_add G) k x"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_sum] THEN
    MATCH_MP_TAC ABELIAN_GROUP_PRODUCT_ITERATE THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC SELECT_CONV THEN REWRITE_TAC [WO])

  let ABELIAN_GROUP_ITERATE ← prove
   r"!G (x:K->A) k.
        abelian_group G /\
        (!i. i IN k ==> x i IN group_carrier G)
        ==> iterate (group_add G) k x IN group_carrier G"
   (SIMP_TAC [← GSYM ABELIAN_GROUP_SUM_ITERATE, GROUP_SUM])

  -- @@RETURN BEGIN
  return { GROUP_PRODUCT_MUL, GROUP_SUM_MUL, ABELIAN_GROUP_SUM_MUL, GROUP_SUM_INV,
           ABELIAN_GROUP_SUM_INV, GROUP_SUM_POW, ABELIAN_GROUP_SUM_POW, GROUP_SUM_ZPOW,
           ABELIAN_GROUP_SUM_ZPOW, GROUP_SUM_IMAGE, ABELIAN_GROUP_PRODUCT_ITERATE,
           ABELIAN_GROUP_SUM_ITERATE, ABELIAN_GROUP_ITERATE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Congugation.                                                              -/
/- ------------------------------------------------------------------------- -/

structure Conjugation where
  -- @@FIELDS
  group_conjugation : thm
  GROUP_CONJUGATION : thm
  GROUP_CONJUGATION_CONJUGATION : thm
  GROUP_CONJUGATION_EQ : thm
  GROUP_CONJUGATION_EQ_SELF : thm
  GROUP_CONJUGATION_EQ_ID : thm
  GROUP_CONJUGATION_BY_ID : thm
  GROUP_CONJUGATION_LINV : thm
  GROUP_CONJUGATION_RINV : thm
  IN_IMAGE_GROUP_CONJUGATION : thm
  IMAGE_GROUP_CONJUGATION_SUBSET : thm
  IMAGE_GROUP_CONJUGATION_BY_ID : thm
  IMAGE_GROUP_CONJUGATION_BY_MUL : thm
  IMAGE_GROUP_CONJUGATION_BY_INV : thm
  IMAGE_GROUP_CONJUGATION_EQ_SWAP : thm
  IMAGE_GROUP_CONJUGATION_EQ_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupConjugation [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BGroupRule : GroupRule) :
    ExceptT String IO Conjugation := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, .. } := D
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IMAGE_EQ, IMAGE_o, .. } := D.core4
  let { SUBSET, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { GROUP_INV, GROUP_MUL, GROUP_MUL_LINV, GROUP_MUL_RINV, .. } := BBasics
  let { GROUP_TAC, .. } := BGroupRule
  -- @@SCOPE END

  let group_conjugation ← D.new_definition
   r"group_conjugation G a x = group_mul G a (group_mul G x (group_inv G a))"

  let GROUP_CONJUGATION ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> group_conjugation G x y IN group_carrier G"
   (SIMP_TAC [group_conjugation, GROUP_MUL, GROUP_INV])

  let GROUP_CONJUGATION_CONJUGATION ← prove
   r"!G a b x:A.
        a IN group_carrier G /\ b IN group_carrier G /\ x IN group_carrier G
        ==> group_conjugation G a (group_conjugation G b x) =
            group_conjugation G (group_mul G a b) x"
   (SIMP_TAC [group_conjugation] THEN GROUP_TAC)

  let GROUP_CONJUGATION_EQ ← prove
   r"!G a x y:A.
        a IN group_carrier G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> (group_conjugation G a x = group_conjugation G a y <=> x = y)"
   (REWRITE_TAC [group_conjugation] THEN GROUP_TAC)

  let GROUP_CONJUGATION_EQ_SELF ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_conjugation G x y = y <=>
             group_mul G x y = group_mul G y x)"
   (REWRITE_TAC [group_conjugation] THEN GROUP_TAC)

  let GROUP_CONJUGATION_EQ_ID ← prove
   r"!G a x:A.
        a IN group_carrier G /\ x IN group_carrier G
        ==> (group_conjugation G a x = group_id G <=> x = group_id G)"
   (REWRITE_TAC [group_conjugation] THEN GROUP_TAC)

  let GROUP_CONJUGATION_BY_ID ← prove
   r"!G x:A. x IN group_carrier G ==> group_conjugation G (group_id G) x = x"
   (REWRITE_TAC [group_conjugation] THEN GROUP_TAC)

  let GROUP_CONJUGATION_LINV ← prove
   r"!G a x:A.
        a IN group_carrier G /\ x IN group_carrier G
        ==> group_conjugation G (group_inv G a) (group_conjugation G a x) = x"
   (SIMP_TAC [GROUP_CONJUGATION_CONJUGATION, GROUP_INV] THEN
    SIMP_TAC [GROUP_MUL_LINV, GROUP_CONJUGATION_BY_ID])

  let GROUP_CONJUGATION_RINV ← prove
   r"!G a x:A.
        a IN group_carrier G /\ x IN group_carrier G
        ==> group_conjugation G a (group_conjugation G (group_inv G a) x) = x"
   (SIMP_TAC [GROUP_CONJUGATION_CONJUGATION, GROUP_INV] THEN
    SIMP_TAC [GROUP_MUL_RINV, GROUP_CONJUGATION_BY_ID])

  let IN_IMAGE_GROUP_CONJUGATION ← prove
   r"!G s x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\
        s SUBSET group_carrier G
        ==> (x IN IMAGE (group_conjugation G y) s <=>
             group_conjugation G (group_inv G y) x IN s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"!u. s SUBSET u /\ x IN u /\
        (!x. x IN u ==> f(g x) = x /\ g(f x) = x)
        ==> (x IN IMAGE f s <=> g x IN s)")) THEN
    EXISTS_TAC (← q r"group_carrier G:A->bool") THEN
    ASM_SIMP_TAC [GROUP_CONJUGATION_LINV, GROUP_CONJUGATION_RINV])

  let IMAGE_GROUP_CONJUGATION_SUBSET ← prove
   r"!G (a:A) s.
        a IN group_carrier G /\ s SUBSET group_carrier G
        ==> IMAGE (group_conjugation G a) s SUBSET group_carrier G"
   (SIMP_TAC [SUBSET, FORALL_IN_IMAGE, GROUP_CONJUGATION])

  let IMAGE_GROUP_CONJUGATION_BY_ID ← prove
   r"!G s:A->bool.
        s SUBSET group_carrier G
        ==> IMAGE (group_conjugation G (group_id G)) s = s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"(!x. x IN s ==> f x = x) ==> IMAGE f s = s")) THEN
    ASM_MESON_TAC [GROUP_CONJUGATION_BY_ID, SUBSET])

  let IMAGE_GROUP_CONJUGATION_BY_MUL ← prove
   r"!G s a b:A.
        a IN group_carrier G /\
        b IN group_carrier G /\
        s SUBSET group_carrier G
        ==> IMAGE (group_conjugation G (group_mul G a b)) s =
            IMAGE (group_conjugation G a) (IMAGE (group_conjugation G b) s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM IMAGE_o] THEN
    MATCH_MP_TAC IMAGE_EQ THEN
    ASM_MESON_TAC [GROUP_CONJUGATION_CONJUGATION, o_THM, SUBSET])

  let IMAGE_GROUP_CONJUGATION_BY_INV ← prove
   r"!G (a:A) s t.
        a IN group_carrier G /\
        s SUBSET group_carrier G /\
        t SUBSET group_carrier G
        ==> (IMAGE (group_conjugation G (group_inv G a)) s = t <=>
             IMAGE (group_conjugation G a) t = s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN s ==> g(f x) = x) /\ (!y. y IN t ==> f(g y) = y)
    ==> (IMAGE f s = t <=> IMAGE g t = s)")) THEN
    ASM_MESON_TAC [SUBSET, GROUP_CONJUGATION_LINV, GROUP_CONJUGATION_RINV])

  let IMAGE_GROUP_CONJUGATION_EQ_SWAP ← prove
   r"!G (a:A) s t.
        a IN group_carrier G /\
        s SUBSET group_carrier G /\
        t SUBSET group_carrier G /\
        IMAGE (group_conjugation G (group_inv G a)) s = t
        ==> IMAGE (group_conjugation G a) t = s"
   (MESON_TAC [IMAGE_GROUP_CONJUGATION_BY_INV])

  let IMAGE_GROUP_CONJUGATION_EQ_PREIMAGE ← prove
   r"!G (a:A) s t.
        a IN group_carrier G /\
        s SUBSET group_carrier G /\
        t SUBSET group_carrier G
        ==> (IMAGE (group_conjugation G a) s = t <=>
             {x | x IN group_carrier G /\
                  group_conjugation G a x IN t} = s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"!g. s SUBSET u /\ t SUBSET u /\
        (!x. x IN u ==> f(x) IN u /\ g(f x) = x) /\
        (!y. y IN u ==> g(y) IN u /\ f(g(y)) = y)
       ==> (IMAGE f s = t <=> {x | x IN u /\ f x IN t} = s)")) THEN
    EXISTS_TAC (← q r"group_conjugation G (group_inv G (a:A))") THEN
    ASM_SIMP_TAC [GROUP_CONJUGATION, GROUP_INV, GROUP_CONJUGATION_LINV,
                 GROUP_CONJUGATION_RINV])

  -- @@RETURN BEGIN
  return { group_conjugation, GROUP_CONJUGATION, GROUP_CONJUGATION_CONJUGATION,
           GROUP_CONJUGATION_EQ, GROUP_CONJUGATION_EQ_SELF, GROUP_CONJUGATION_EQ_ID,
           GROUP_CONJUGATION_BY_ID, GROUP_CONJUGATION_LINV, GROUP_CONJUGATION_RINV,
           IN_IMAGE_GROUP_CONJUGATION, IMAGE_GROUP_CONJUGATION_SUBSET,
           IMAGE_GROUP_CONJUGATION_BY_ID, IMAGE_GROUP_CONJUGATION_BY_MUL,
           IMAGE_GROUP_CONJUGATION_BY_INV, IMAGE_GROUP_CONJUGATION_EQ_SWAP,
           IMAGE_GROUP_CONJUGATION_EQ_PREIMAGE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Subgroups. We treat them as *sets* which seems to be a common convention. -/
/- And "subgroup_generated" can be used in the degenerate case where the set -/
/- is closed under the operations to cast from "subset" to "group".          -/
/- ------------------------------------------------------------------------- -/

structure Subgroups where
  -- @@FIELDS
  subgroup_of : thm
  IN_SUBGROUP_ID : thm
  IN_SUBGROUP_INV : thm
  IN_SUBGROUP_MUL : thm
  IN_SUBGROUP_DIV : thm
  IN_SUBGROUP_POW : thm
  IN_SUBGROUP_ZPOW : thm
  IN_SUBGROUP_CONJUGATION : thm
  IN_SUBGROUP_PRODUCT : thm
  IN_SUBGROUP_SUM : thm
  IMAGE_GROUP_CONJUGATION_SUBGROUP : thm
  SUBGROUP_OF_INTERS : thm
  SUBGROUP_OF_INTER : thm
  SUBGROUP_OF_UNIONS : thm
  SUBGROUP_OF_OPPOSITE_GROUP : thm
  SUBGROUP_OF_IMP_SUBSET : thm
  SUBGROUP_OF_IMP_NONEMPTY : thm
  TRIVIAL_SUBGROUP_OF : thm
  CARRIER_SUBGROUP_OF : thm
  FINITE_SUBGROUPS : thm
  FINITE_RESTRICTED_SUBGROUPS : thm
  deriving Inhabited

@[nospecialize]
def setupSubgroups [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BGroupProduct : GroupProduct) (BConjugation : Conjugation) :
    ExceptT String IO Subgroups := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition,
        parse_as_infix, .. } := D
  let { FINITE_POWERSET, FINITE_SUBSET, .. } := D.core3
  let { IN_INTER, IN_INTERS, IN_SING, .. } := D.core5
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_REFL, .. } := D.core7
  let { GROUP_INV, GROUP_PROPERTIES, OPPOSITE_GROUP, .. } := BBasics
  let { group_div, group_pow, .. } := BDerived
  let { group_zpow, .. } := BPow
  let { GROUP_PRODUCT_CLOSED, group_sum, .. } := BGroupProduct
  let { GROUP_CONJUGATION_LINV, GROUP_CONJUGATION_RINV, group_conjugation, .. } := BConjugation
  -- @@SCOPE END

  parse_as_infix ("subgroup_of", (12, "right"))

  let subgroup_of ← new_definition
   r"(s:A->bool) subgroup_of (G:A group) <=>
        s SUBSET group_carrier G /\
        group_id G IN s /\
        (!x. x IN s ==> group_inv G x IN s) /\
        (!x y. x IN s /\ y IN s ==> group_mul G x y IN s)"

  let IN_SUBGROUP_ID ← prove
   r"!G h:A->bool. h subgroup_of G ==> group_id G IN h"
   (SIMP_TAC [subgroup_of])

  let IN_SUBGROUP_INV ← prove
   r"!G h x:A. h subgroup_of G /\ x IN h ==> group_inv G x IN h"
   (SIMP_TAC [subgroup_of])

  let IN_SUBGROUP_MUL ← prove
   r"!G h x y:A. h subgroup_of G /\ x IN h /\ y IN h ==> group_mul G x y IN h"
   (SIMP_TAC [subgroup_of])

  let IN_SUBGROUP_DIV ← prove
   r"!G h x y:A. h subgroup_of G /\ x IN h /\ y IN h ==> group_div G x y IN h"
   (SIMP_TAC [group_div, IN_SUBGROUP_MUL, IN_SUBGROUP_INV])

  let IN_SUBGROUP_POW ← prove
   r"!G h (x:A) n. h subgroup_of G /\ x IN h ==> group_pow G x n IN h"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN INDUCT_TAC THEN
    ASM_SIMP_TAC [group_pow, IN_SUBGROUP_ID, IN_SUBGROUP_MUL])

  let IN_SUBGROUP_ZPOW ← prove
   r"!G h (x:A) n. h subgroup_of G /\ x IN h ==> group_zpow G x n IN h"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_zpow] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [IN_SUBGROUP_INV, IN_SUBGROUP_POW])

  let IN_SUBGROUP_CONJUGATION ← prove
   r"!G h a x:A.
        h subgroup_of G /\ a IN h /\ x IN h ==> group_conjugation G a x IN h"
   (SIMP_TAC [subgroup_of, group_conjugation])

  let IN_SUBGROUP_PRODUCT ← prove
   r"!G h (<<=) k (f:K->A).
        h subgroup_of G /\
        (!i. i IN k /\ f i IN group_carrier G ==> f i IN h)
        ==> group_product G (<<=) k f IN h"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [] (← ISPEC (← q r"\x:A. x IN h") GROUP_PRODUCT_CLOSED)) THEN
    ASM_MESON_TAC [subgroup_of])

  let IN_SUBGROUP_SUM ← prove
   r"!G h k (f:K->A).
        h subgroup_of G /\
        (!i. i IN k /\ f i IN group_carrier G ==> f i IN h)
        ==> group_sum G k f IN h"
   (REWRITE_TAC [group_sum, IN_SUBGROUP_PRODUCT])

  let IMAGE_GROUP_CONJUGATION_SUBGROUP ← prove
   r"!G h a:A.
        h subgroup_of G /\ a IN h ==> IMAGE (group_conjugation G a) h = h"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"!g. (!x. x IN s ==> f x IN s /\ g x IN s /\ g(f x) = x /\ f(g x) = x)
    ==> IMAGE f s = s")) THEN
    EXISTS_TAC (← q r"group_conjugation G (group_inv G a:A)") THEN
    ASM_MESON_TAC [IN_SUBGROUP_CONJUGATION, GROUP_CONJUGATION_LINV,
                  GROUP_INV, GROUP_CONJUGATION_RINV, subgroup_of, SUBSET])

  let SUBGROUP_OF_INTERS ← prove
   r"!G (gs:(A->bool)->bool).
        (!g. g IN gs ==> g subgroup_of G) /\ ~(gs = {})
        ==> (INTERS gs) subgroup_of G"
   (REWRITE_TAC [subgroup_of, SUBSET, IN_INTERS] THEN SET_TAC [])

  let SUBGROUP_OF_INTER ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G ==> (g INTER h) subgroup_of G"
   (REWRITE_TAC [subgroup_of, SUBSET, IN_INTER] THEN SET_TAC [])

  let SUBGROUP_OF_UNIONS ← prove
   r"!G (u:(A->bool)->bool).
        ~(u = {}) /\
        (!h. h IN u ==> h subgroup_of G) /\
        (!g h. g IN u /\ h IN u ==> g SUBSET h \/ h SUBSET g)
        ==> (UNIONS u) subgroup_of G"
   (REWRITE_TAC [subgroup_of] THEN SET_TAC [])

  let SUBGROUP_OF_OPPOSITE_GROUP ← prove
   r"!G h:A->bool. h subgroup_of opposite_group G <=> h subgroup_of G"
   (REWRITE_TAC [subgroup_of, OPPOSITE_GROUP] THEN MESON_TAC [])

  let SUBGROUP_OF_IMP_SUBSET ← prove
   r"!G s:A->bool. s subgroup_of G ==> s SUBSET group_carrier G"
   (SIMP_TAC [subgroup_of])

  let SUBGROUP_OF_IMP_NONEMPTY ← prove
   r"!G s:A->bool. s subgroup_of G ==> ~(s = {})"
   (REWRITE_TAC [subgroup_of] THEN SET_TAC [])

  let TRIVIAL_SUBGROUP_OF ← prove
   r"!G:A group. {group_id G} subgroup_of G"
   (SIMP_TAC [subgroup_of, IN_SING, SING_SUBSET] THEN
    MESON_TAC GROUP_PROPERTIES)

  let CARRIER_SUBGROUP_OF ← prove
   r"!G:A group. (group_carrier G) subgroup_of G"
   (REWRITE_TAC [subgroup_of, SUBSET_REFL] THEN MESON_TAC GROUP_PROPERTIES)

  let FINITE_SUBGROUPS ← prove
   r"!(G:A group). FINITE(group_carrier G) ==> FINITE {h | h subgroup_of G}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC (← q r"{h:A->bool | h SUBSET group_carrier G}") THEN
    ASM_SIMP_TAC [FINITE_POWERSET, subgroup_of] THEN SET_TAC [])

  let FINITE_RESTRICTED_SUBGROUPS ← prove
   r"!P (G:A group).
        FINITE(group_carrier G) ==> FINITE {h | h subgroup_of G /\ P h}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC (← q r"{h:A->bool | h SUBSET group_carrier G}") THEN
    ASM_SIMP_TAC [FINITE_POWERSET, subgroup_of] THEN SET_TAC [])

  -- @@RETURN BEGIN
  return { subgroup_of, IN_SUBGROUP_ID, IN_SUBGROUP_INV, IN_SUBGROUP_MUL,
           IN_SUBGROUP_DIV, IN_SUBGROUP_POW, IN_SUBGROUP_ZPOW, IN_SUBGROUP_CONJUGATION,
           IN_SUBGROUP_PRODUCT, IN_SUBGROUP_SUM, IMAGE_GROUP_CONJUGATION_SUBGROUP,
           SUBGROUP_OF_INTERS, SUBGROUP_OF_INTER, SUBGROUP_OF_UNIONS,
           SUBGROUP_OF_OPPOSITE_GROUP, SUBGROUP_OF_IMP_SUBSET, SUBGROUP_OF_IMP_NONEMPTY,
           TRIVIAL_SUBGROUP_OF, CARRIER_SUBGROUP_OF, FINITE_SUBGROUPS,
           FINITE_RESTRICTED_SUBGROUPS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- subgroup_generated.                                                       -/
/- ------------------------------------------------------------------------- -/

structure SubgroupGenerated where
  -- @@FIELDS
  subgroup_generated : thm
  SUBGROUP_GENERATED : thm
  SUBGROUP_GENERATED_EQ : thm
  GROUP_ID_SUBGROUP : thm
  GROUP_INV_SUBGROUP : thm
  GROUP_MUL_SUBGROUP : thm
  ABELIAN_SUBGROUP_GENERATED : thm
  GROUP_DIV_SUBGROUP_GENERATED : thm
  GROUP_POW_SUBGROUP_GENERATED : thm
  GROUP_ZPOW_SUBGROUP_GENERATED : thm
  GROUP_CONJUGATION_SUBGROUP_GENERATED : thm
  SUBGROUP_GENERATED_RESTRICT : thm
  SUBGROUP_SUBGROUP_GENERATED : thm
  SUBGROUP_GENERATED_MONO : thm
  SUBGROUP_GENERATED_MINIMAL : thm
  SUBGROUPS_GENERATED_EQ : thm
  SUBGROUP_GENERATED_INDUCT : thm
  GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET : thm
  SUBGROUP_GENERATED_SUPERSET : thm
  SUBGROUP_OF_SUBGROUP_GENERATED_EQ : thm
  SUBGROUP_GENERATED_INDUCT_STRONG : thm
  SUBGROUP_GENERATED_INDUCT_ALT : thm
  SUBGROUP_GENERATED_INDUCT_LEFT : thm
  deriving Inhabited

@[nospecialize]
def setupSubgroupGenerated [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BConjugation : Conjugation) (BSubgroups : Subgroups) :
    ExceptT String IO SubgroupGenerated := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, .. } := D.core1
  let { FUN_EQ_THM, .. } := D.core3
  let { INTERS_GSPEC, INTER_SUBSET, .. } := D.core4
  let { IN_ELIM_THM, IN_INTER, IN_INTERS, .. } := D.core5
  let { MEMBER_NOT_EMPTY, .. } := D.core6
  let { SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_TRANS, .. } := D.core7
  let { GROUPS_EQ, GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID,
        GROUP_MUL_RID, GROUP_PROPERTIES, group_carrier, group_id, group_inv, group_mul,
        group_tybij, .. } := BBasics
  let { GROUP_INV_ID, GROUP_INV_INV, GROUP_INV_MUL, group_div, group_pow, .. } := BDerived
  let { group_zpow, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { group_conjugation, .. } := BConjugation
  let { CARRIER_SUBGROUP_OF, SUBGROUP_OF_INTERS, subgroup_of, .. } := BSubgroups
  -- @@SCOPE END

  let subgroup_generated ← new_definition
   r"subgroup_generated G (s:A->bool) =
      group(INTERS {h | h subgroup_of G /\ (group_carrier G INTER s) SUBSET h},
            group_id G,group_inv G,group_mul G)"

  let SUBGROUP_GENERATED ← prove
   r"(!G s:A->bool.
        group_carrier (subgroup_generated G s) =
          INTERS {h | h subgroup_of G /\ (group_carrier G INTER s) SUBSET h}) /\
    (!G s:A->bool. group_id (subgroup_generated G s) = group_id G) /\
    (!G s:A->bool. group_inv (subgroup_generated G s) = group_inv G) /\
    (!G s:A->bool. group_mul (subgroup_generated G s) = group_mul G)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MP_TAC (← EQ_IMP_RULE
     (← ISPEC (← liftExcept (do rand (← rand (strip_forall (concl subgroup_generated)).2)))
       (← CONJUNCT2 group_tybij))).1 THEN
    REWRITE_TAC [← GSYM subgroup_generated] THEN ANTS_TAC THENL
     [REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM] THEN
      REPLICATE_TAC 2 (GEN_REWRITE_TAC id [CONJ_ASSOC]) THEN CONJ_TAC THENL
       [MESON_TAC [subgroup_of], ALL_TAC] THEN
      REPEAT STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"group_carrier G:A->bool"))) THEN
      REWRITE_TAC [INTER_SUBSET, SUBSET_REFL, CARRIER_SUBGROUP_OF] THEN
      MESON_TAC GROUP_PROPERTIES,
      DISCH_TAC THEN
      ASM_REWRITE_TAC [group_carrier, group_id, group_inv, group_mul]])

  let SUBGROUP_GENERATED_EQ ← prove
   r"!G s:A->bool.
        subgroup_generated G s = G <=>
        group_carrier(subgroup_generated G s) = group_carrier G"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [GROUPS_EQ] THEN
    REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED])

  let GROUP_ID_SUBGROUP ← prove
   r"!G s:A->bool. group_id G IN group_carrier(subgroup_generated G s)"
   (MESON_TAC [GROUP_ID, SUBGROUP_GENERATED])

  let GROUP_INV_SUBGROUP ← prove
   r"!x. x IN group_carrier (subgroup_generated G s)
       ==> group_inv G x IN group_carrier(subgroup_generated G s)"
   (MESON_TAC [GROUP_INV, SUBGROUP_GENERATED])

  let GROUP_MUL_SUBGROUP ← prove
   r"!x y. x IN group_carrier (subgroup_generated G s) /\
         y IN group_carrier (subgroup_generated G s)
         ==> group_mul G x y IN group_carrier(subgroup_generated G s)"
   (MESON_TAC [GROUP_MUL, SUBGROUP_GENERATED])

  let ABELIAN_SUBGROUP_GENERATED ← prove
   r"!G h:A->bool.
        abelian_group G ==> abelian_group(subgroup_generated G h)"
   (SIMP_TAC [abelian_group, SUBGROUP_GENERATED] THEN
    REWRITE_TAC [IN_INTERS, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"group_carrier(G:A group)"))) THEN
    ASM_REWRITE_TAC [CARRIER_SUBGROUP_OF, INTER_SUBSET] THEN
    ASM_MESON_TAC [])

  let GROUP_DIV_SUBGROUP_GENERATED ← prove
   r"!G s:A->bool. group_div (subgroup_generated G s) = group_div G"
   (REWRITE_TAC [FUN_EQ_THM, group_div, SUBGROUP_GENERATED])

  let GROUP_POW_SUBGROUP_GENERATED ← prove
   r"!G s:A->bool. group_pow (subgroup_generated G s) = group_pow G"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [group_pow, SUBGROUP_GENERATED])

  let GROUP_ZPOW_SUBGROUP_GENERATED ← prove
   r"!G s:A->bool. group_zpow (subgroup_generated G s) = group_zpow G"
   (REWRITE_TAC [group_zpow, GROUP_POW_SUBGROUP_GENERATED,
                SUBGROUP_GENERATED, FUN_EQ_THM])

  let GROUP_CONJUGATION_SUBGROUP_GENERATED ← prove
   r"!G s:A->bool.
    group_conjugation (subgroup_generated G s) = group_conjugation G"
   (REWRITE_TAC [group_conjugation, SUBGROUP_GENERATED, FUN_EQ_THM])

  let SUBGROUP_GENERATED_RESTRICT ← prove
   r"!G s:A->bool.
        subgroup_generated G s =
        subgroup_generated G (group_carrier G INTER s)"
   (REWRITE_TAC [subgroup_generated, ← SET_RULE (← q r"g INTER g INTER s = g INTER s")])

  let SUBGROUP_SUBGROUP_GENERATED ← prove
   r"!G s:A->bool. group_carrier(subgroup_generated G s) subgroup_of G"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC SUBGROUP_OF_INTERS THEN
    SIMP_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"group_carrier G:A->bool") THEN
    REWRITE_TAC [CARRIER_SUBGROUP_OF, INTER_SUBSET])

  let SUBGROUP_GENERATED_MONO ← prove
   r"!G s t:A->bool.
        s SUBSET t
        ==> group_carrier(subgroup_generated G s) SUBSET
            group_carrier(subgroup_generated G t)"
   (REWRITE_TAC [SUBGROUP_GENERATED] THEN SET_TAC [])

  let SUBGROUP_GENERATED_MINIMAL ← prove
   r"!G h s:A->bool.
        s SUBSET h /\ h subgroup_of G
        ==> group_carrier(subgroup_generated G s) SUBSET h"
   (REWRITE_TAC [SUBGROUP_GENERATED, INTERS_GSPEC] THEN SET_TAC [])

  let SUBGROUPS_GENERATED_EQ ← prove
   r"!G s t:A->bool.
        s SUBSET group_carrier(subgroup_generated G t) /\
        t SUBSET group_carrier(subgroup_generated G s)
        ==> subgroup_generated G s = subgroup_generated G t"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC id [GROUPS_EQ] THEN
    REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_MINIMAL, SUBGROUP_SUBGROUP_GENERATED])

  let SUBGROUP_GENERATED_INDUCT ← prove
   r"!G P s:A->bool.
        (!x. x IN group_carrier G /\ x IN s ==> P x) /\
        P(group_id G) /\
        (!x. P x ==> P(group_inv G x)) /\
        (!x y. P x /\ P y ==> P(group_mul G x y))
        ==> !x. x IN group_carrier(subgroup_generated G s) ==> P x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM IN_INTER] THEN
    ONCE_REWRITE_TAC [SUBGROUP_GENERATED_RESTRICT] THEN MP_TAC (← SET_RULE
      (← q r"group_carrier G INTER (s:A->bool) SUBSET group_carrier G")) THEN
    SPEC_TAC (← q r"group_carrier G INTER (s:A->bool)", ← q r"s:A->bool") THEN
    GEN_TAC THEN DISCH_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"{x:A | x IN group_carrier G /\ P x}",
                   ← q r"s:A->bool"] SUBGROUP_GENERATED_MINIMAL) THEN
    ANTS_TAC THENL [ALL_TAC, SET_TAC []] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [subgroup_of, IN_ELIM_THM, SUBSET, GROUP_MUL, GROUP_INV,
                 GROUP_ID])

  let GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET ← prove
   r"!G h:A->bool.
        group_carrier (subgroup_generated G h) SUBSET group_carrier G"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"a IN s ==> INTERS s SUBSET a")) THEN
    REWRITE_TAC [IN_ELIM_THM, CARRIER_SUBGROUP_OF, INTER_SUBSET])

  let SUBGROUP_GENERATED_SUPERSET ← prove
   r"!G s:A->bool.
    subgroup_generated G s = G <=>
    group_carrier G SUBSET group_carrier(subgroup_generated G s)"
   (REWRITE_TAC [SUBGROUP_GENERATED_EQ, ← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET])

  let SUBGROUP_OF_SUBGROUP_GENERATED_EQ ← prove
   r"!G h k:A->bool.
        h subgroup_of (subgroup_generated G k) <=>
        h subgroup_of G /\ h SUBSET group_carrier(subgroup_generated G k)"
   (REWRITE_TAC [subgroup_of, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET_TRANS])

  let SUBGROUP_GENERATED_INDUCT_STRONG ← prove
   r"!G P s:A->bool.
        (!x. x IN group_carrier G /\ x IN s ==> P x) /\
        P (group_id G) /\
        (!x. x IN group_carrier G /\ P x ==> P (group_inv G x)) /\
        (!x y. x IN group_carrier G /\ y IN group_carrier G /\ P x /\ P y
               ==> P (group_mul G x y))
         ==> !x. x IN group_carrier (subgroup_generated G s) ==> P x"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN group_carrier (subgroup_generated G s)
        ==> (x:A) IN group_carrier G /\ P x")
    MP_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT THEN
    ASM_SIMP_TAC [GROUP_ID, GROUP_INV, GROUP_MUL])

  let SUBGROUP_GENERATED_INDUCT_ALT ← prove
   r"!G P s:A->bool.
        P (group_id G) /\
        (!x. x IN group_carrier G /\ x IN s ==> P x /\ P(group_inv G x)) /\
        (!x y. x IN group_carrier G /\ y IN group_carrier G /\ P x /\ P y
               ==> P (group_mul G x y))
        ==> !x. x IN group_carrier (subgroup_generated G s) ==> P x"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x:A. x IN group_carrier (subgroup_generated G s)
          ==> P x /\ P(group_inv G x)")
    MP_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT_STRONG THEN
    ASM_MESON_TAC [GROUP_INV, GROUP_INV_INV, GROUP_INV_MUL, GROUP_INV_ID])

  let SUBGROUP_GENERATED_INDUCT_LEFT ← prove
   r"!G P s:A->bool.
        P (group_id G) /\
        (!x y. x IN group_carrier G /\ x IN s /\ y IN group_carrier G /\ P y
               ==> P (group_mul G x y) /\ P (group_mul G (group_inv G x) y))
        ==> !x. x IN group_carrier(subgroup_generated G s) ==> P x"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x:A. x IN group_carrier (subgroup_generated G s)
          ==> !y. y IN group_carrier G /\ P y ==> P(group_mul G x y)")
    MP_TAC THENL
     [ALL_TAC,
      ASM_MESON_TAC [GROUP_MUL_RID, GROUP_ID, ← REWRITE_RULE [SUBSET]
       GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET]] THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT_ALT THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL])

  -- @@RETURN BEGIN
  return { subgroup_generated, SUBGROUP_GENERATED, SUBGROUP_GENERATED_EQ,
           GROUP_ID_SUBGROUP, GROUP_INV_SUBGROUP, GROUP_MUL_SUBGROUP,
           ABELIAN_SUBGROUP_GENERATED, GROUP_DIV_SUBGROUP_GENERATED,
           GROUP_POW_SUBGROUP_GENERATED, GROUP_ZPOW_SUBGROUP_GENERATED,
           GROUP_CONJUGATION_SUBGROUP_GENERATED, SUBGROUP_GENERATED_RESTRICT,
           SUBGROUP_SUBGROUP_GENERATED, SUBGROUP_GENERATED_MONO,
           SUBGROUP_GENERATED_MINIMAL, SUBGROUPS_GENERATED_EQ, SUBGROUP_GENERATED_INDUCT,
           GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED_SUPERSET,
           SUBGROUP_OF_SUBGROUP_GENERATED_EQ, SUBGROUP_GENERATED_INDUCT_STRONG,
           SUBGROUP_GENERATED_INDUCT_ALT, SUBGROUP_GENERATED_INDUCT_LEFT }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Subgroup generated by a set: cardinality, minimality, idempotence.        -/
/- (grouptheory.ml 2256-2458)                                                -/
/- ------------------------------------------------------------------------- -/

structure SubgroupGen1 where
  -- @@FIELDS
  FINITE_SUBGROUP_GENERATED : thm
  CARD_LE_SUBGROUP_GENERATED : thm
  COUNTABLE_SUBGROUP_GENERATED : thm
  SUBGROUP_GENERATED_SUBSET_CARRIER : thm
  SUBSET_CARRIER_SUBGROUP_GENERATED : thm
  SUBGROUP_GENERATED_MINIMAL_EQ : thm
  CARRIER_SUBGROUP_GENERATED_SUBGROUP : thm
  SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ : thm
  SUBGROUP_GENERATED_GROUP_CARRIER : thm
  SUBGROUP_OF_SUBGROUP_GENERATED : thm
  SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET : thm
  SUBGROUP_GENERATED_REFL : thm
  SUBGROUP_GENERATED_INC : thm
  SUBGROUP_GENERATED_INC_GEN : thm
  SUBGROUP_OF_SUBGROUP_GENERATED_REV : thm
  TRIVIAL_GROUP_SUBGROUP_GENERATED : thm
  TRIVIAL_GROUP_SUBGROUP_GENERATED_TRIVIAL : thm
  TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ : thm
  TRIVIAL_GROUP_GENERATED_BY_ANYTHING : thm
  SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED : thm
  deriving Inhabited

@[nospecialize]
def setupSubgroupGen1 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) :
    ExceptT String IO SubgroupGen1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC,
        prove_general_recursive_function_exists, .. } := D
  let { ALL, ALL_MEM, CARD_EQ_IMP_LE, CARD_EQ_LIST_GEN, CARD_LE_FINITE_INFINITE,
        CARD_LE_IMAGE, CARD_LE_SUBSET, CARD_LE_TRANS, CARD_MUL_ABSORB, .. } := D.core1
  let { COUNTABLE, COUNTABLE_SUBSET, CROSS, EQ_SYM_EQ, .. } := D.core2
  let { FINITE_BOOL, FINITE_CROSS_EQ, FINITE_EMPTY, FINITE_SUBSET, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, INFINITE, INTERS_GSPEC, INTERS_SUBSET_STRONG, .. } := D.core4
  let { IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIV, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, LE_C, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM, SUBSET_INTER, SUBSET_INTERS,
        SUBSET_REFL, SUBSET_TRANS, SURJECTIVE_ON_RIGHT_INVERSE, UNIV_NOT_EMPTY, ge_c,
        mul_c, .. } := D.core7
  let { num_INFINITE, .. } := D.core8
  let { GROUPS_EQ, TRIVIAL_GROUP_ALT, TRIVIAL_GROUP_SUBSET, trivial_group, .. } := BBasics
  let { CARRIER_SUBGROUP_OF, TRIVIAL_SUBGROUP_OF, subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_INDUCT_LEFT, SUBGROUP_GENERATED_MINIMAL,
        SUBGROUP_GENERATED_RESTRICT, SUBGROUP_OF_SUBGROUP_GENERATED_EQ,
        SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  -- @@SCOPE END

  let FINITE_SUBGROUP_GENERATED ← prove
   r"!G s:A->bool.
        FINITE(group_carrier G)
        ==> FINITE(group_carrier(subgroup_generated G s))"
   (MESON_TAC [FINITE_SUBSET, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET])

  let CARD_LE_SUBGROUP_GENERATED ← prove
   r"!(G:A group) s (k:K->bool).
      INFINITE k /\ s <=_c k ==> group_carrier(subgroup_generated G s) <=_c k"
   (← do
    let rr2 ← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_TRANS
    let rr1 ← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_TRANS
    let grp ← prove_general_recursive_function_exists (← q
      r"?groupel:(bool#K)list->A.
        groupel [] = group_id G /\
        (!x l. groupel (CONS (F,x) l) = group_mul G (gdecmap x) (groupel l)) /\
        (!x l. groupel (CONS (T,x) l) =
               group_mul G (group_inv G (gdecmap x)) (groupel l))")
    pure (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LE_C]) THEN
    REWRITE_TAC [SURJECTIVE_ON_RIGHT_INVERSE, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"gdecmap:K->A", ← q r"gencmap:A->K"] THEN DISCH_TAC THEN
    CHOOSE_TAC grp THEN
    TRANS_TAC CARD_LE_TRANS
     (← q r"IMAGE (groupel:(bool#K)list->A)
          {l | !x. MEM x l ==> x IN (:bool) CROSS k}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CARD_LE_SUBSET THEN
      REWRITE_TAC [SUBSET, IN_IMAGE, ALL_MEM, IN_ELIM_THM],
      wPart (fun t => do lhand t) lhand CARD_LE_IMAGE THEN
      MATCH_MP_TAC rr1 THEN
      wPart (fun t => do lhand t) (fun t => do lhand (← rand t)) CARD_EQ_LIST_GEN THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [INFINITE, FINITE_CROSS_EQ, FINITE_EMPTY, UNIV_NOT_EMPTY],
        DISCH_THEN (MP_TAC o MATCH_MP CARD_EQ_IMP_LE)] THEN
      MATCH_MP_TAC rr2 THEN
      MATCH_MP_TAC CARD_EQ_IMP_LE THEN REWRITE_TAC [CROSS, ← GSYM mul_c] THEN
      MATCH_MP_TAC CARD_MUL_ABSORB THEN ASM_REWRITE_TAC [UNIV_NOT_EMPTY] THEN
      MATCH_MP_TAC CARD_LE_FINITE_INFINITE THEN
      ASM_REWRITE_TAC [FINITE_BOOL]] THEN
    ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT_LEFT THEN CONJ_TAC THENL
     [EXISTS_TAC (← q r"[]:(bool#K)list") THEN ASM_REWRITE_TAC [ALL],
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"l:(bool#K)list") STRIP_ASSUME_TAC) THEN
      CONJ_TAC THENL
       [EXISTS_TAC (← q r"CONS (F,(gencmap:A->K) x) l"),
        EXISTS_TAC (← q r"CONS (T,(gencmap:A->K) x) l")] THEN
      ASM_SIMP_TAC [ALL, IN_CROSS, IN_UNIV]]))

  let COUNTABLE_SUBGROUP_GENERATED ← prove
   r"!G s:A->bool.
        COUNTABLE(group_carrier G) \/ COUNTABLE s
        ==> COUNTABLE(group_carrier(subgroup_generated G s))"
   (← do
    let rr ← REWRITE_RULE [IMP_CONJ] CARD_LE_SUBGROUP_GENERATED
    pure (REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, COUNTABLE_SUBSET],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [COUNTABLE])] THEN
    REWRITE_TAC [COUNTABLE, ge_c] THEN
    MATCH_MP_TAC rr THEN
    REWRITE_TAC [num_INFINITE]))

  let SUBGROUP_GENERATED_SUBSET_CARRIER ← prove
   r"!G h:A->bool.
     group_carrier G INTER h SUBSET group_carrier(subgroup_generated G h)"
   (REWRITE_TAC [subgroup_of, SUBGROUP_GENERATED, SUBSET_INTERS] THEN SET_TAC [])

  let SUBSET_CARRIER_SUBGROUP_GENERATED ← prove
   r"!G s t:A->bool.
        s SUBSET group_carrier G /\ s SUBSET t
        ==> s SUBSET group_carrier(subgroup_generated G t)"
   (MESON_TAC [SUBSET_TRANS, SUBSET_INTER, SUBGROUP_GENERATED_SUBSET_CARRIER])

  let SUBGROUP_GENERATED_MINIMAL_EQ ← prove
   r"!G h s:A->bool.
        h subgroup_of G
        ==> (group_carrier (subgroup_generated G s) SUBSET h <=>
             group_carrier G INTER s SUBSET h)"
   (← do
    let rr ← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS
    pure (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC rr THEN
      REWRITE_TAC [SUBGROUP_GENERATED_SUBSET_CARRIER],
      ONCE_REWRITE_TAC [SUBGROUP_GENERATED_RESTRICT] THEN
      ASM_SIMP_TAC [SUBGROUP_GENERATED_MINIMAL]]))

  let CARRIER_SUBGROUP_GENERATED_SUBGROUP ← prove
   r"!G h:A->bool.
        h subgroup_of G ==> group_carrier (subgroup_generated G h) = h"
   (← do
    let s1 ← SET_RULE (← q r"h SUBSET g ==> g INTER h = h")
    pure (REWRITE_TAC [subgroup_of, SUBGROUP_GENERATED, INTERS_GSPEC] THEN
    REPEAT GEN_TAC THEN SIMP_TAC [s1] THEN
    STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    CONJ_TAC THENL [GEN_REWRITE_TAC I [SUBSET], ASM SET_TAC []] THEN
    X_GEN_TAC (← q "x:A") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"h:A->bool")) THEN ASM_REWRITE_TAC [SUBSET_REFL]))

  let SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ ← prove
   r"!G h k:A->bool.
        k subgroup_of G
        ==> (h subgroup_of (subgroup_generated G k) <=>
             h subgroup_of G /\ h SUBSET k)"
   (REWRITE_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_EQ] THEN
    SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP])

  let SUBGROUP_GENERATED_GROUP_CARRIER ← prove
   r"!G:A group. subgroup_generated G (group_carrier G) = G"
   (GEN_TAC THEN REWRITE_TAC [GROUPS_EQ] THEN
    SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, CARRIER_SUBGROUP_OF] THEN
    REWRITE_TAC [SUBGROUP_GENERATED])

  let SUBGROUP_OF_SUBGROUP_GENERATED ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ g SUBSET h
        ==> g subgroup_of (subgroup_generated G h)"
   (SIMP_TAC [subgroup_of, SUBGROUP_GENERATED, SUBSET_INTERS] THEN SET_TAC [])

  let SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET ← prove
   r"!G s:A->bool.
        s SUBSET group_carrier G
        ==> s SUBSET group_carrier(subgroup_generated G s)"
   (← do
    let s1 ← SET_RULE (← q r"s SUBSET t <=> t INTER s = s")
    pure (MESON_TAC [SUBGROUP_GENERATED_SUBSET_CARRIER, s1]))

  let SUBGROUP_GENERATED_REFL ← prove
   r"!G s:A->bool. group_carrier G SUBSET s ==> subgroup_generated G s = G"
   (← do
    let s1 ← SET_RULE (← q r"u SUBSET s ==> u INTER s = u")
    pure (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [SUBGROUP_GENERATED_RESTRICT] THEN
    ASM_SIMP_TAC [s1] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_GROUP_CARRIER]))

  let SUBGROUP_GENERATED_INC ← prove
   r"!G s x:A.
        s SUBSET group_carrier G /\ x IN s
        ==> x IN group_carrier(subgroup_generated G s)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, ← GSYM SUBSET] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET])

  let SUBGROUP_GENERATED_INC_GEN ← prove
   r"!G s x:A.
        x IN group_carrier G /\ x IN s
        ==> x IN group_carrier(subgroup_generated G s)"
   (MESON_TAC [SUBGROUP_GENERATED_SUBSET_CARRIER, IN_INTER, SUBSET])

  let SUBGROUP_OF_SUBGROUP_GENERATED_REV ← prove
   r"!G g h:A->bool.
        g subgroup_of (subgroup_generated G h)
        ==> g subgroup_of G"
   (← do
    let c2 ← CONJUNCT2 SUBGROUP_GENERATED
    pure (SIMP_TAC [subgroup_of, c2] THEN
    MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET_TRANS]))

  let TRIVIAL_GROUP_SUBGROUP_GENERATED ← prove
   r"!G s:A->bool.
        trivial_group G ==> trivial_group(subgroup_generated G s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TRIVIAL_GROUP_ALT] THEN
    MESON_TAC [SUBSET_TRANS, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET])

  let TRIVIAL_GROUP_SUBGROUP_GENERATED_TRIVIAL ← prove
   r"!G s:A->bool.
        s SUBSET {group_id G} ==> trivial_group(subgroup_generated G s)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [TRIVIAL_GROUP_ALT, SUBGROUP_GENERATED] THEN
    EXISTS_TAC (← q r"group_id G:A") THEN
    MATCH_MP_TAC INTERS_SUBSET_STRONG THEN
    EXISTS_TAC (← q r"{group_id G:A}") THEN
    REWRITE_TAC [IN_ELIM_THM, TRIVIAL_SUBGROUP_OF] THEN ASM SET_TAC [])

  let TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ ← prove
   r"!G s:A->bool.
        trivial_group(subgroup_generated G s) <=>
        group_carrier G INTER s SUBSET {group_id G}"
   (← do
    let c2 ← CONJUNCT2 SUBGROUP_GENERATED
    pure (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [SUBGROUP_GENERATED_RESTRICT] THEN
    EQ_TAC THEN REWRITE_TAC [TRIVIAL_GROUP_SUBGROUP_GENERATED_TRIVIAL] THEN
    REWRITE_TAC [TRIVIAL_GROUP_SUBSET] THEN
    REWRITE_TAC [c2] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
    REWRITE_TAC [← GSYM SUBGROUP_GENERATED_RESTRICT] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_SUBSET_CARRIER]))

  let TRIVIAL_GROUP_GENERATED_BY_ANYTHING ← prove
   r"!G s:A->bool. trivial_group G ==> subgroup_generated G s = G"
   (← do
    let c2b ← CONJUNCT2 SUBGROUP_GENERATED
    let c2a ← CONJUNCT2 SUBGROUP_GENERATED
    pure (REPEAT STRIP_TAC THEN
    REWRITE_TAC [GROUPS_EQ, c2a] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"s:A->bool") o
      MATCH_MP TRIVIAL_GROUP_SUBGROUP_GENERATED) THEN
    POP_ASSUM MP_TAC THEN
    SIMP_TAC [trivial_group, c2b]))

  let SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED ← prove
   r"!G s:A->bool.
        subgroup_generated G (group_carrier(subgroup_generated G s)) =
        subgroup_generated G s"
   (← do
    let c2 ← CONJUNCT2 SUBGROUP_GENERATED
    pure (REPEAT GEN_TAC THEN
    REWRITE_TAC [GROUPS_EQ, c2] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN
      REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED, SUBSET_REFL],
      MATCH_MP_TAC SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET THEN
      REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET]]))

  -- @@RETURN BEGIN
  return { FINITE_SUBGROUP_GENERATED, CARD_LE_SUBGROUP_GENERATED,
           COUNTABLE_SUBGROUP_GENERATED, SUBGROUP_GENERATED_SUBSET_CARRIER,
           SUBSET_CARRIER_SUBGROUP_GENERATED, SUBGROUP_GENERATED_MINIMAL_EQ,
           CARRIER_SUBGROUP_GENERATED_SUBGROUP,
           SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ, SUBGROUP_GENERATED_GROUP_CARRIER,
           SUBGROUP_OF_SUBGROUP_GENERATED, SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET,
           SUBGROUP_GENERATED_REFL, SUBGROUP_GENERATED_INC, SUBGROUP_GENERATED_INC_GEN,
           SUBGROUP_OF_SUBGROUP_GENERATED_REV, TRIVIAL_GROUP_SUBGROUP_GENERATED,
           TRIVIAL_GROUP_SUBGROUP_GENERATED_TRIVIAL, TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ,
           TRIVIAL_GROUP_GENERATED_BY_ANYTHING, SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Subgroup generated: insertion of id, monotonicity, idempotence, unions,   -/
/- commuting elements and abelianness.  (grouptheory.ml 2449-2615)           -/
/- ------------------------------------------------------------------------- -/

structure SubgroupGen2 where
  -- @@FIELDS
  SUBGROUP_GENERATED_INSERT_ID : thm
  GROUP_CARRIER_SUBGROUP_GENERATED_MONO : thm
  SUBGROUP_GENERATED_IDEMPOT_GEN : thm
  SUBGROUP_GENERATED_IDEMPOT : thm
  SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED_IDEMPOT : thm
  SUBGROUP_GENERATED_UNION_LEFT : thm
  SUBGROUP_GENERATED_UNION_RIGHT : thm
  SUBGROUP_GENERATED_UNION : thm
  TRIVIAL_GROUP_SUBGROUP_GENERATED_EMPTY : thm
  SUBGROUP_OF_COMMUTING_ELEMENTS : thm
  GROUP_COMMUTES_SUBGROUP_GENERATED_EQ : thm
  GROUP_COMMUTES_SUBGROUP_GENERATED : thm
  GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ : thm
  ABELIAN_GROUP_SUBGROUP_GENERATED_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupSubgroupGen2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) :
    ExceptT String IO SubgroupGen2 := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { EQ_SYM_EQ, .. } := D.core2
  let { EXTENSION, FORALL_AND_THM, FORALL_UNWIND_THM2, .. } := D.core3
  let { IMP_CONJ_ALT, IMP_IMP, INTERS_ANTIMONO_GEN, INTERS_GSPEC, INTER_SUBSET, .. } := D.core4
  let { IN_ELIM_THM, IN_GSPEC, IN_INSERT, IN_INTER, .. } := D.core5
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_ANTISYM,
        SUBSET_INTER, SUBSET_RESTRICT, SWAP_FORALL_THM, UNION_COMM, UNION_OVER_INTER,
        UNION_SUBSET, .. } := D.core7
  let { GROUPS_EQ, GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_LID, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_COMMUTES_INV, GROUP_COMMUTES_MUL, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { SUBGROUP_OF_INTER, subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_MINIMAL, SUBGROUP_GENERATED_MONO,
        SUBGROUP_GENERATED_RESTRICT, SUBGROUP_OF_SUBGROUP_GENERATED_EQ,
        SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED, SUBGROUP_GENERATED_MINIMAL_EQ,
        SUBGROUP_GENERATED_SUBSET_CARRIER, SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET,
        SUBGROUP_OF_SUBGROUP_GENERATED_REV, TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGen1
  -- @@SCOPE END

  let SUBGROUP_GENERATED_INSERT_ID ← prove
   r"!G s:A->bool.
        subgroup_generated G (group_id G INSERT s) = subgroup_generated G s"
   (← do
    let t1 ← TAUT (← q
     r"p /\ (q \/ r) ==> s <=> (q ==> p ==> s) /\ (p /\ r ==> s)")
    pure (REWRITE_TAC [GROUPS_EQ, SUBGROUP_GENERATED] THEN
    REWRITE_TAC [EXTENSION, INTERS_GSPEC, IN_ELIM_THM] THEN
    REWRITE_TAC [SUBSET, IN_INTER, IN_INSERT, t1] THEN
    REWRITE_TAC [FORALL_AND_THM, FORALL_UNWIND_THM2, GROUP_ID] THEN
    MESON_TAC [subgroup_of]))

  let GROUP_CARRIER_SUBGROUP_GENERATED_MONO ← prove
   r"!G s t:A->bool.
        group_carrier(subgroup_generated (subgroup_generated G s) t) SUBSET
        group_carrier(subgroup_generated G t)"
   (ONCE_REWRITE_TAC [SUBGROUP_GENERATED] THEN
    REWRITE_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_EQ] THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC INTERS_ANTIMONO_GEN THEN
    X_GEN_TAC (← q r"h:A->bool") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"h INTER group_carrier (subgroup_generated G s):A->bool") THEN
    REWRITE_TAC [INTER_SUBSET, SUBSET_INTER] THEN
    ASM_SIMP_TAC [SUBGROUP_OF_INTER, SUBGROUP_SUBGROUP_GENERATED] THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"s:A->bool"]
      GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET) THEN
    ASM SET_TAC [])

  let SUBGROUP_GENERATED_IDEMPOT_GEN ← prove
   r"!G s t:A->bool.
        s SUBSET group_carrier(subgroup_generated G t)
        ==> subgroup_generated (subgroup_generated G t) s =
            subgroup_generated G s"
   (← do
    let c2 ← CONJUNCT2 SUBGROUP_GENERATED
    pure (REPEAT STRIP_TAC THEN
    REWRITE_TAC [GROUPS_EQ, c2] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_MONO] THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET] THEN
    MESON_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_REV, SUBGROUP_SUBGROUP_GENERATED]))

  let SUBGROUP_GENERATED_IDEMPOT ← prove
   r"!G s t:A->bool.
        s SUBSET t
        ==> subgroup_generated (subgroup_generated G t) s =
            subgroup_generated G s"
   (← do
    let s1 ← SET_RULE (← q r"t SUBSET u ==> t INTER s = t INTER u INTER s")
    pure (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q "G:A group", ← q r"group_carrier G INTER s:A->bool", ← q r"t:A->bool"]
     SUBGROUP_GENERATED_IDEMPOT_GEN) THEN
    REWRITE_TAC [← GSYM SUBGROUP_GENERATED_RESTRICT] THEN ANTS_TAC THENL
     [wPart (fun t => do rand t) rand SUBGROUP_GENERATED_SUBSET_CARRIER THEN ASM SET_TAC [],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    ONCE_REWRITE_TAC [SUBGROUP_GENERATED_RESTRICT] THEN AP_TERM_TAC THEN
    MATCH_MP_TAC s1 THEN
    REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET]))

  let SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED_IDEMPOT ← prove
   r"!G s t:A->bool.
        s SUBSET t
        ==> subgroup_generated (subgroup_generated G t)
                               (group_carrier (subgroup_generated G s)) =
            subgroup_generated G s"
   (MESON_TAC [SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED,
              SUBGROUP_GENERATED_IDEMPOT, SUBGROUP_GENERATED_MONO])

  let SUBGROUP_GENERATED_UNION_LEFT ← prove
   r"!G s t:A->bool.
        subgroup_generated G (group_carrier(subgroup_generated G s) UNION t) =
        subgroup_generated G (s UNION t)"
   (← do
    let c2 ← CONJUNCT2 SUBGROUP_GENERATED
    pure (REPEAT GEN_TAC THEN GEN_REWRITE_TAC I [GROUPS_EQ] THEN
    REWRITE_TAC [c2] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [SUBGROUP_GENERATED_MINIMAL_EQ, SUBGROUP_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [UNION_OVER_INTER, UNION_SUBSET] THEN
    SIMP_TAC [← GSYM SUBGROUP_GENERATED_MINIMAL_EQ,
             SUBGROUP_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED] THEN
    REPEAT CONJ_TAC THENL
     [ALL_TAC, ALL_TAC,
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV)
       [← GSYM SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED],
      ALL_TAC] THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_MONO THEN SET_TAC []))

  let SUBGROUP_GENERATED_UNION_RIGHT ← prove
   r"!G s t:A->bool.
        subgroup_generated G (s UNION group_carrier(subgroup_generated G t)) =
        subgroup_generated G (s UNION t)"
   (ONCE_REWRITE_TAC [UNION_COMM] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_UNION_LEFT])

  let SUBGROUP_GENERATED_UNION ← prove
   r"!G s t:A->bool.
        subgroup_generated G (group_carrier(subgroup_generated G s) UNION
                              group_carrier(subgroup_generated G t)) =
        subgroup_generated G (s UNION t)"
   (REWRITE_TAC [SUBGROUP_GENERATED_UNION_LEFT,
                SUBGROUP_GENERATED_UNION_RIGHT])

  let TRIVIAL_GROUP_SUBGROUP_GENERATED_EMPTY ← prove
   r"!G:A group. trivial_group(subgroup_generated G {})"
   (REWRITE_TAC [TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ] THEN SET_TAC [])

  let SUBGROUP_OF_COMMUTING_ELEMENTS ← prove
   r"!G z:A.
        z IN group_carrier G
        ==> {x | x IN group_carrier G /\ group_mul G x z = group_mul G z x}
            subgroup_of G"
   (REWRITE_TAC [subgroup_of, SUBSET_RESTRICT, IN_ELIM_THM] THEN
    SIMP_TAC [GROUP_MUL_LID, GROUP_MUL_RID, GROUP_COMMUTES_MUL,
             GROUP_COMMUTES_INV, GROUP_MUL, GROUP_INV, GROUP_ID])

  let GROUP_COMMUTES_SUBGROUP_GENERATED_EQ ← prove
   r"!G s z:A.
        z IN group_carrier G
        ==> ((!x. x IN group_carrier(subgroup_generated G s)
                  ==> group_mul G x z = group_mul G z x) <=>
             (!x. x IN group_carrier G /\ x IN s
                  ==> group_mul G x z = group_mul G z x))"
   (← do
    let s1 ← SET_RULE (← q
     r"s SUBSET {x | P x /\ Q x} <=>
    s SUBSET {x | P x} /\ s SUBSET {x | Q x}")
    pure (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP SUBGROUP_OF_COMMUTING_ELEMENTS) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s:A->bool") o
      MATCH_MP SUBGROUP_GENERATED_MINIMAL_EQ) THEN
    REWRITE_TAC [IN_GSPEC, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, s1] THEN
    SET_TAC []))

  let GROUP_COMMUTES_SUBGROUP_GENERATED ← prove
   r"!G s z:A.
        (!x. x IN s ==> group_mul G x z = group_mul G z x) /\
        z IN group_carrier G
        ==> (!x. x IN group_carrier(subgroup_generated G s)
                 ==> group_mul G x z = group_mul G z x)"
   (MESON_TAC [GROUP_COMMUTES_SUBGROUP_GENERATED_EQ])

  let GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ ← prove
   r"!G s t:A->bool.
        (!x y. x IN group_carrier(subgroup_generated G s) /\
               y IN group_carrier(subgroup_generated G t)
               ==> group_mul G x y = group_mul G y x) <=>
        (!x y. x IN group_carrier G /\ x IN s /\
               y IN group_carrier G /\ y IN t
               ==> group_mul G x y = group_mul G y x)"
   (← do
    let t1 ← TAUT (← q r"p /\ q /\ r /\ s ==> t <=> p /\ q ==> r /\ s ==> t")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [RIGHT_FORALL_IMP_THM, t1] THEN
    GEN_REWRITE_TAC (BINOP_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
    SIMP_TAC [← GSYM GROUP_COMMUTES_SUBGROUP_GENERATED_EQ] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    GEN_REWRITE_TAC (BINOP_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"t:A->bool"]
          GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET) THEN
    SIMP_TAC [GROUP_COMMUTES_SUBGROUP_GENERATED_EQ, SUBSET]))

  let ABELIAN_GROUP_SUBGROUP_GENERATED_GEN ← prove
   r"!G s:A->bool.
        (!x y. x IN group_carrier G /\ x IN s /\
               y IN group_carrier G /\ y IN s
               ==> group_mul G x y = group_mul G y x)
        ==> abelian_group (subgroup_generated G s)"
   (← do
    let c2 ← CONJUNCT2 SUBGROUP_GENERATED
    pure (REWRITE_TAC [abelian_group, c2] THEN
    REWRITE_TAC [GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ]))

  -- @@RETURN BEGIN
  return { SUBGROUP_GENERATED_INSERT_ID, GROUP_CARRIER_SUBGROUP_GENERATED_MONO,
           SUBGROUP_GENERATED_IDEMPOT_GEN, SUBGROUP_GENERATED_IDEMPOT,
           SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED_IDEMPOT,
           SUBGROUP_GENERATED_UNION_LEFT, SUBGROUP_GENERATED_UNION_RIGHT,
           SUBGROUP_GENERATED_UNION, TRIVIAL_GROUP_SUBGROUP_GENERATED_EMPTY,
           SUBGROUP_OF_COMMUTING_ELEMENTS, GROUP_COMMUTES_SUBGROUP_GENERATED_EQ,
           GROUP_COMMUTES_SUBGROUP_GENERATED, GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ,
           ABELIAN_GROUP_SUBGROUP_GENERATED_GEN }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Direct products and sums.  (grouptheory.ml 2616-2714)                     -/
/- ------------------------------------------------------------------------- -/

structure ProdGroup where
  -- @@FIELDS
  prod_group : thm
  PROD_GROUP : thm
  GROUP_POW_PROD_GROUP : thm
  GROUP_ZPOW_PROD_GROUP : thm
  OPPOSITE_PROD_GROUP : thm
  TRIVIAL_PROD_GROUP : thm
  FINITE_PROD_GROUP : thm
  ABELIAN_PROD_GROUP : thm
  CROSS_SUBGROUP_OF_PROD_GROUP : thm
  PROD_GROUP_SUBGROUP_GENERATED : thm
  product_group : thm
  deriving Inhabited

@[nospecialize]
def setupProdGroup [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) :
    ExceptT String IO ProdGroup := do
  -- @@SCOPE BEGIN
  let { INDUCT_TAC, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { CROSS_SING, .. } := D.core2
  let { FINITE_CROSS_EQ, FORALL_INT_CASES, FORALL_PAIR_THM, .. } := D.core3
  let { IN_CROSS, LAMBDA_PAIR_THM, .. } := D.core5
  let { PAIR_EQ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET_CROSS, .. } := D.core7
  let { GROUPS_EQ, GROUP_CARRIER_NONEMPTY, GROUP_ID, GROUP_INV, GROUP_MUL,
        GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV, GROUP_MUL_RID, GROUP_MUL_RINV,
        OPPOSITE_GROUP, TRIVIAL_GROUP_SUBSET, group_carrier, group_id, group_inv,
        group_mul, group_tybij, .. } := BBasics
  let { group_pow, .. } := BDerived
  let { GROUP_ZPOW_POW, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  -- @@SCOPE END

  -- `GROUP_PROPERTIES`, bound before this range as the conjuncts list of the
  -- basic group laws (grouptheory.ml 42-43); its components arrive via Core.
  let GROUP_PROPERTIES :=
    [GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC,
     GROUP_MUL_LID, GROUP_MUL_RID, GROUP_MUL_LINV, GROUP_MUL_RINV]

  let prod_group ← new_definition
   r"prod_group (G:A group) (G':B group) =
        group((group_carrier G) CROSS (group_carrier G'),
              (group_id G,group_id G'),
              (\(x,x'). group_inv G x,group_inv G' x'),
              (\(x,x') (y,y'). group_mul G x y,group_mul G' x' y'))"

  let PROD_GROUP ← prove
   r"(!(G:A group) (G':B group).
        group_carrier (prod_group G G') =
        (group_carrier G) CROSS (group_carrier G')) /\
   (!(G:A group) (G':B group).
        group_id (prod_group G G') = (group_id G,group_id G')) /\
   (!(G:A group) (G':B group).
        group_inv (prod_group G G') =
          \(x,x'). group_inv G x,group_inv G' x') /\
   (!(G:A group) (G':B group).
        group_mul (prod_group G G') =
          \(x,x') (y,y'). group_mul G x y,group_mul G' x' y')"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MP_TAC (← EQ_IMP_RULE
     (← ISPEC (← liftExcept (do rand (← rand (strip_forall (concl prod_group)).2)))
       (← CONJUNCT2 group_tybij))).1 THEN
    REWRITE_TAC [← GSYM prod_group] THEN ANTS_TAC THENL
     [REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
      SIMP_TAC GROUP_PROPERTIES,
      DISCH_TAC THEN
      ASM_REWRITE_TAC [group_carrier, group_id, group_inv, group_mul]])

  let GROUP_POW_PROD_GROUP ← prove
   r"!(G:A group) (H:B group) x y n.
        x IN group_carrier G /\ y IN group_carrier H
        ==> group_pow (prod_group G H) (x,y) n =
            (group_pow G x n,group_pow H y n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [group_pow, PROD_GROUP])

  let GROUP_ZPOW_PROD_GROUP ← prove
   r"!(G:A group) (H:B group) x y n.
        x IN group_carrier G /\ y IN group_carrier H
        ==> group_zpow (prod_group G H) (x,y) n =
            (group_zpow G x n,group_zpow H y n)"
   (REWRITE_TAC [FORALL_INT_CASES, GROUP_ZPOW_POW] THEN
    SIMP_TAC [GROUP_POW_PROD_GROUP, PROD_GROUP])

  let OPPOSITE_PROD_GROUP ← prove
   r"!(G1:A group) (G2:B group).
        opposite_group(prod_group G1 G2) =
        prod_group (opposite_group G1) (opposite_group G2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [GROUPS_EQ, OPPOSITE_GROUP, PROD_GROUP] THEN
    REWRITE_TAC [LAMBDA_PAIR_THM])

  let TRIVIAL_PROD_GROUP ← prove
   r"!(G:A group) (H:B group).
        trivial_group(prod_group G H) <=>
        trivial_group G /\ trivial_group H"
   (REWRITE_TAC [TRIVIAL_GROUP_SUBSET, PROD_GROUP, ← GSYM CROSS_SING] THEN
    REWRITE_TAC [SUBSET_CROSS, GROUP_CARRIER_NONEMPTY])

  let FINITE_PROD_GROUP ← prove
   r"!(G:A group) (H:B group).
        FINITE(group_carrier(prod_group G H)) <=>
        FINITE(group_carrier G) /\ FINITE(group_carrier H)"
   (REWRITE_TAC [PROD_GROUP, FINITE_CROSS_EQ, GROUP_CARRIER_NONEMPTY])

  let ABELIAN_PROD_GROUP ← prove
   r"!(G:A group) (H:B group).
        abelian_group(prod_group G H) <=>
        abelian_group G /\ abelian_group H"
   (REPEAT GEN_TAC THEN REWRITE_TAC [abelian_group, PROD_GROUP] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
    MAP_EVERY (fun t => tactic_of do pure (MP_TAC (← C ISPEC GROUP_CARRIER_NONEMPTY t)))
     [← q "G:A group", ← q "H:B group"] THEN SET_TAC [])

  let CROSS_SUBGROUP_OF_PROD_GROUP ← prove
   r"!(G1:A group) (G2:B group) h1 h2.
        (h1 CROSS h2) subgroup_of (prod_group G1 G2) <=>
        h1 subgroup_of G1 /\ h2 subgroup_of G2"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [subgroup_of, FORALL_PAIR_THM, PROD_GROUP, IN_CROSS] THEN
    REWRITE_TAC [SUBSET_CROSS] THEN SET_TAC [])

  let PROD_GROUP_SUBGROUP_GENERATED ← prove
   r"!(G1:A group) (G2:B group) h1 h2.
        h1 subgroup_of G1 /\ h2 subgroup_of G2
        ==> (prod_group (subgroup_generated G1 h1) (subgroup_generated G2 h2) =
             subgroup_generated (prod_group G1 G2) (h1 CROSS h2))"
   (← do
    let c2b ← CONJUNCT2 SUBGROUP_GENERATED
    let c2a ← CONJUNCT2 PROD_GROUP
    pure (SIMP_TAC [GROUPS_EQ, c2a, c2b] THEN
    SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP,
             CROSS_SUBGROUP_OF_PROD_GROUP, PROD_GROUP]))

  let product_group ← new_definition
   r"product_group k (G:K->A group) =
        group(cartesian_product k (\i. group_carrier(G i)),
              RESTRICTION k (\i. group_id (G i)),
              (\x. RESTRICTION k (\i. group_inv (G i) (x i))),
              (\x y. RESTRICTION k (\i. group_mul (G i) (x i) (y i))))"

  -- @@RETURN BEGIN
  return { prod_group, PROD_GROUP, GROUP_POW_PROD_GROUP, GROUP_ZPOW_PROD_GROUP,
           OPPOSITE_PROD_GROUP, TRIVIAL_PROD_GROUP, FINITE_PROD_GROUP,
           ABELIAN_PROD_GROUP, CROSS_SUBGROUP_OF_PROD_GROUP,
           PROD_GROUP_SUBGROUP_GENERATED, product_group }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Product group (grouptheory.ml 2715-2833).                                 -/
/- ------------------------------------------------------------------------- -/

structure ProductGroup where
  -- @@FIELDS
  PRODUCT_GROUP : thm
  GROUP_POW_PRODUCT_GROUP : thm
  GROUP_ZPOW_PRODUCT_GROUP : thm
  OPPOSITE_PRODUCT_GROUP : thm
  GROUP_PRODUCT_INJECTION : thm
  TRIVIAL_PRODUCT_GROUP : thm
  CARTESIAN_PRODUCT_SUBGROUP_OF_PRODUCT_GROUP : thm
  PRODUCT_GROUP_SUBGROUP_GENERATED : thm
  FINITE_PRODUCT_GROUP : thm
  ABELIAN_PRODUCT_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupProductGroup [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) :
    ExceptT String IO ProductGroup := do
  -- @@SCOPE BEGIN
  let { INDUCT_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { AND_FORALL_THM, CARTESIAN_PRODUCT_EQ, CARTESIAN_PRODUCT_EQ_EMPTY,
        CARTESIAN_PRODUCT_SINGS_GEN, .. } := D.core1
  let { EXTENSIONAL, FINITE_CARTESIAN_PRODUCT, FORALL_CARTESIAN_PRODUCT_ELEMENTS,
        FORALL_CARTESIAN_PRODUCT_ELEMENTS_EQ, FORALL_INT_CASES, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, .. } := D.core5
  let { RESTRICTION, RESTRICTION_EXTENSION, .. } := D.core6
  let { RESTRICTION_IN_CARTESIAN_PRODUCT, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SUBSET_CARTESIAN_PRODUCT, cartesian_product, .. } := D.core7
  let { GROUPS_EQ, GROUP_CARRIER_NONEMPTY, GROUP_ID, GROUP_PROPERTIES, OPPOSITE_GROUP,
        TRIVIAL_GROUP_ALT, TRIVIAL_GROUP_SUBSET, group_carrier, group_id, group_inv,
        group_mul, group_tybij, .. } := BBasics
  let { group_pow, .. } := BDerived
  let { GROUP_ZPOW_POW, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  let { product_group, .. } := BProdGroup
  -- @@SCOPE END

  let PRODUCT_GROUP ← prove
   r"(!k (G:K->A group).
        group_carrier(product_group k G) =
          cartesian_product k (\i. group_carrier(G i))) /\
   (!k (G:K->A group).
        group_id (product_group k G) =
          RESTRICTION k (\i. group_id (G i))) /\
   (!k (G:K->A group).
        group_inv (product_group k G) =
          \x. RESTRICTION k (\i. group_inv (G i) (x i))) /\
   (!k (G:K->A group).
        group_mul (product_group k G) =
          (\x y. RESTRICTION k (\i. group_mul (G i) (x i) (y i))))"
   (← do
    pure (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MP_TAC (← EQ_IMP_RULE
     (← ISPEC (← liftExcept (do rand (← rand (strip_forall (concl product_group)).2)))
       (← CONJUNCT2 group_tybij))).1 THEN
    REWRITE_TAC [← GSYM product_group] THEN ANTS_TAC THENL
     [REWRITE_TAC [cartesian_product, RESTRICTION, EXTENSIONAL, IN_ELIM_THM] THEN
      REWRITE_TAC [FUN_EQ_THM, RESTRICTION] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
      ASM_SIMP_TAC GROUP_PROPERTIES,
      DISCH_TAC THEN
      ASM_REWRITE_TAC [group_carrier, group_id, group_inv, group_mul]]))

  let GROUP_POW_PRODUCT_GROUP ← prove
   r"!(G:K->A group) k x n.
        group_pow (product_group k G) x n =
        RESTRICTION k (\i. group_pow (G i) (x i) n)"
   (REPLICATE_TAC 3 GEN_TAC THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [group_pow, PRODUCT_GROUP] THEN
    REWRITE_TAC [RESTRICTION_EXTENSION] THEN SIMP_TAC [RESTRICTION])

  let GROUP_ZPOW_PRODUCT_GROUP ← prove
   r"!(G:K->A group) k x n.
        group_zpow (product_group k G) x n =
        RESTRICTION k (\i. group_zpow (G i) (x i) n)"
   (REWRITE_TAC [FORALL_INT_CASES, GROUP_ZPOW_POW] THEN
    SIMP_TAC [GROUP_POW_PRODUCT_GROUP, PRODUCT_GROUP] THEN
    REWRITE_TAC [RESTRICTION_EXTENSION] THEN SIMP_TAC [RESTRICTION])

  let OPPOSITE_PRODUCT_GROUP ← prove
   r"!(G:K->A group) k.
        opposite_group(product_group k G) =
        product_group k (\i. opposite_group(G i))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [GROUPS_EQ, OPPOSITE_GROUP, PRODUCT_GROUP])

  let GROUP_PRODUCT_INJECTION ← prove
   r"!k (G:K->A group) a i.
        RESTRICTION k (\j. if j = i then a else group_id (G j)) IN
        group_carrier(product_group k G) <=>
        i IN k ==> a IN group_carrier(G i)"
   (SIMP_TAC [PRODUCT_GROUP, RESTRICTION_IN_CARTESIAN_PRODUCT, IN_ELIM_THM] THEN
    MESON_TAC [GROUP_ID])

  let TRIVIAL_PRODUCT_GROUP ← prove
   r"!k (G:K->A group).
        trivial_group(product_group k G) <=>
        !i. i IN k ==> trivial_group(G i)"
   (REWRITE_TAC [TRIVIAL_GROUP_SUBSET, PRODUCT_GROUP] THEN
    REWRITE_TAC [← GSYM CARTESIAN_PRODUCT_SINGS_GEN] THEN
    REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, GROUP_CARRIER_NONEMPTY])

  let CARTESIAN_PRODUCT_SUBGROUP_OF_PRODUCT_GROUP ← prove
   r"!k h G:K->A group.
        (cartesian_product k h) subgroup_of (product_group k G) <=>
        !i. i IN k ==> (h i) subgroup_of (G i)"
   (REWRITE_TAC [subgroup_of, PRODUCT_GROUP, RESTRICTION_IN_CARTESIAN_PRODUCT,
                SUBSET_CARTESIAN_PRODUCT] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_CASES_TAC (← q r"cartesian_product k (h:K->A->bool) = {}") THEN
    ASM_REWRITE_TAC [] THENL
     [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [CARTESIAN_PRODUCT_EQ_EMPTY]) THEN
      SET_TAC [],
      ASM_REWRITE_TAC [← REWRITE_RULE [IMP_CONJ, RIGHT_FORALL_IMP_THM]
            FORALL_CARTESIAN_PRODUCT_ELEMENTS] THEN
      MESON_TAC []])

  let PRODUCT_GROUP_SUBGROUP_GENERATED ← prove
   r"!k G (h:K->A->bool).
        (!i. i IN k ==> (h i) subgroup_of (G i))
        ==> product_group k (\i. subgroup_generated (G i) (h i)) =
            subgroup_generated (product_group k G) (cartesian_product k h)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [GROUPS_EQ] THEN
    REWRITE_TAC [← CONJUNCT2 PRODUCT_GROUP, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, PRODUCT_GROUP,
                 CARTESIAN_PRODUCT_SUBGROUP_OF_PRODUCT_GROUP] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP])

  let FINITE_PRODUCT_GROUP ← prove
   r"!k (G:K->A group).
        FINITE(group_carrier(product_group k G)) <=>
        FINITE {i | i IN k /\ ~trivial_group(G i)} /\
        !i. i IN k ==> FINITE(group_carrier(G i))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PRODUCT_GROUP] THEN
    REWRITE_TAC [FINITE_CARTESIAN_PRODUCT, CARTESIAN_PRODUCT_EQ_EMPTY] THEN
    REWRITE_TAC [TRIVIAL_GROUP_ALT, GROUP_CARRIER_NONEMPTY])

  let ABELIAN_PRODUCT_GROUP ← prove
   r"!k (G:K->A group).
        abelian_group(product_group k G) <=>
        !i. i IN k ==> abelian_group(G i)"
   (← do
    let a1 ← TAUT (← q r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")
    pure (REWRITE_TAC [abelian_group, PRODUCT_GROUP, RESTRICTION_EXTENSION] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    ONCE_REWRITE_TAC [a1] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [FORALL_CARTESIAN_PRODUCT_ELEMENTS_EQ, CARTESIAN_PRODUCT_EQ_EMPTY,
             GROUP_CARRIER_NONEMPTY] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    GEN_REWRITE_TAC (RAND_CONV o BINDER_CONV o RAND_CONV o ONCE_DEPTH_CONV)
     [RIGHT_IMP_FORALL_THM] THEN
    SIMP_TAC [IMP_IMP, FORALL_CARTESIAN_PRODUCT_ELEMENTS_EQ,
             CARTESIAN_PRODUCT_EQ_EMPTY, GROUP_CARRIER_NONEMPTY] THEN
    MESON_TAC []))

  -- @@RETURN BEGIN
  return { PRODUCT_GROUP, GROUP_POW_PRODUCT_GROUP, GROUP_ZPOW_PRODUCT_GROUP,
           OPPOSITE_PRODUCT_GROUP, GROUP_PRODUCT_INJECTION, TRIVIAL_PRODUCT_GROUP,
           CARTESIAN_PRODUCT_SUBGROUP_OF_PRODUCT_GROUP, PRODUCT_GROUP_SUBGROUP_GENERATED,
           FINITE_PRODUCT_GROUP, ABELIAN_PRODUCT_GROUP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Sum group (grouptheory.ml 2834-3010).                                     -/
/- ------------------------------------------------------------------------- -/

structure SumGroup where
  -- @@FIELDS
  sum_group : thm
  SUM_GROUP_ALT : thm
  SUM_GROUP_EQ_PRODUCT_GROUP : thm
  SUBGROUP_SUM_GROUP : thm
  SUM_GROUP_CLAUSES : thm
  GROUP_POW_SUM_GROUP : thm
  GROUP_ZPOW_SUM_GROUP : thm
  GROUP_SUM_INJECTION : thm
  TRIVIAL_SUM_GROUP : thm
  CARTESIAN_PRODUCT_SUBGROUP_OF_SUM_GROUP : thm
  SUM_GROUP_SUBGROUP_GENERATED : thm
  ABELIAN_SUM_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupSumGroup [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProductGroup : ProductGroup) :
    ExceptT String IO SumGroup := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, new_definition, .. } := D
  let { CONTRAPOS_THM, DE_MORGAN_THM, EMPTY_GSPEC, .. } := D.core2
  let { EXTENSION, EXTENSIONAL, FINITE_EMPTY, FINITE_RESTRICT, FINITE_SING,
        FINITE_SUBSET, FINITE_UNION, .. } := D.core3
  let { IMP_CONJ_ALT, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, IN_GSPEC, IN_INTER, IN_SING, IN_UNION, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, RESTRICTION,
        RESTRICTION_EXTENSION, .. } := D.core6
  let { RESTRICTION_IN_CARTESIAN_PRODUCT, SUBSET, SUBSET_CARTESIAN_PRODUCT,
        SUBSET_RESTRICT, cartesian_product, .. } := D.core7
  let { GROUPS_EQ, GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_LID, TRIVIAL_GROUP_SUBSET, .. } := BBasics
  let { GROUP_INV_EQ_ID, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { SUBGROUP_OF_INTER, subgroup_of, .. } := BSubgroups
  let { ABELIAN_SUBGROUP_GENERATED, GROUP_POW_SUBGROUP_GENERATED,
        GROUP_ZPOW_SUBGROUP_GENERATED, SUBGROUP_GENERATED, SUBGROUP_GENERATED_RESTRICT,
        SUBGROUP_OF_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_GROUP_CARRIER,
        TRIVIAL_GROUP_SUBGROUP_GENERATED, .. } := BSubgroupGen1
  let { ABELIAN_PRODUCT_GROUP, CARTESIAN_PRODUCT_SUBGROUP_OF_PRODUCT_GROUP,
        GROUP_POW_PRODUCT_GROUP, GROUP_ZPOW_PRODUCT_GROUP, PRODUCT_GROUP,
        TRIVIAL_PRODUCT_GROUP, .. } := BProductGroup
  -- @@SCOPE END

  let sum_group ← new_definition
   r"sum_group k (G:K->A group) =
        subgroup_generated
         (product_group k G)
         {x | x IN cartesian_product k (\i. group_carrier(G i)) /\
              FINITE {i | i IN k /\ ~(x i = group_id(G i))}}"

  let SUM_GROUP_ALT ← prove
   r"!k (G:K->A group).
      sum_group k G =
      subgroup_generated (product_group k G)
                 {x | FINITE {i | i IN k /\ ~(x i = group_id (G i))}}"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [SUBGROUP_GENERATED_RESTRICT] THEN
    REWRITE_TAC [sum_group] THEN AP_TERM_TAC THEN
    REWRITE_TAC [PRODUCT_GROUP] THEN SET_TAC [])

  let SUM_GROUP_EQ_PRODUCT_GROUP ← prove
   r"!k (G:K->A group). FINITE k ==> sum_group k G = product_group k G"
   (SIMP_TAC [sum_group, FINITE_RESTRICT] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT1 PRODUCT_GROUP), IN_GSPEC] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_GROUP_CARRIER])

  let SUBGROUP_SUM_GROUP ← prove
   r"!k (G:K->A group).
    {x | x IN cartesian_product k (\i. group_carrier(G i)) /\
         FINITE {i | i IN k /\ ~(x i = group_id(G i))}}
    subgroup_of product_group k G"
   (← do
    let a2 ← TAUT (← q r"~p \/ q <=> p ==> q")
    let a1 ← TAUT (← q r"p /\ ~q <=> ~(p ==> q)")
    pure (REWRITE_TAC [subgroup_of, PRODUCT_GROUP, SUBSET_RESTRICT] THEN
    REWRITE_TAC [RESTRICTION, cartesian_product, IN_ELIM_THM, EXTENSIONAL] THEN
    ONCE_REWRITE_TAC [a1] THEN
    SIMP_TAC [GROUP_ID, GROUP_INV_EQ_ID, GROUP_INV, GROUP_MUL] THEN
    REWRITE_TAC [EMPTY_GSPEC, FINITE_EMPTY] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [IMP_IMP, ← GSYM FINITE_UNION] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
    REWRITE_TAC [NOT_IMP, SUBSET, IN_ELIM_THM, IN_UNION] THEN
    GEN_TAC THEN GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [DE_MORGAN_THM] THEN STRIP_TAC THEN
    REWRITE_TAC [a2] THEN
    ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_ID]))

  let SUM_GROUP_CLAUSES ← prove
   r"(!k (G:K->A group).
        group_carrier(sum_group k G) =
          {x | x IN cartesian_product k (\i. group_carrier(G i)) /\
               FINITE {i | i IN k /\ ~(x i = group_id(G i))}}) /\
   (!k (G:K->A group).
        group_id (sum_group k G) =
          RESTRICTION k (\i. group_id (G i))) /\
   (!k (G:K->A group).
        group_inv (sum_group k G) =
          \x. RESTRICTION k (\i. group_inv (G i) (x i))) /\
   (!k (G:K->A group).
        group_mul (sum_group k G) =
          (\x y. RESTRICTION k (\i. group_mul (G i) (x i) (y i))))"
   (SIMP_TAC [sum_group, SUBGROUP_SUM_GROUP,
             CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    REWRITE_TAC [SUBGROUP_GENERATED, PRODUCT_GROUP])

  let GROUP_POW_SUM_GROUP ← prove
   r"!(G:K->A group) k x n.
        group_pow (sum_group k G) x n =
        RESTRICTION k (\i. group_pow (G i) (x i) n)"
   (REWRITE_TAC [SUM_GROUP_ALT, GROUP_POW_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [GROUP_POW_PRODUCT_GROUP])

  let GROUP_ZPOW_SUM_GROUP ← prove
   r"!(G:K->A group) k x n.
        group_zpow (sum_group k G) x n =
        RESTRICTION k (\i. group_zpow (G i) (x i) n)"
   (REWRITE_TAC [SUM_GROUP_ALT, GROUP_ZPOW_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [GROUP_ZPOW_PRODUCT_GROUP])

  let GROUP_SUM_INJECTION ← prove
   r"!k (G:K->A group) a i.
        RESTRICTION k (\j. if j = i then a else group_id (G j)) IN
        group_carrier(sum_group k G) <=>
        i IN k ==> a IN group_carrier(G i)"
   (← do
    let a1 ← TAUT (← q r"(p <=> r) /\ q ==> (p /\ q <=> r)")
    pure (REPEAT GEN_TAC THEN
    SIMP_TAC [SUM_GROUP_CLAUSES, RESTRICTION_IN_CARTESIAN_PRODUCT,
             IN_ELIM_THM] THEN
    MATCH_MP_TAC a1 THEN CONJ_TAC THENL
     [MESON_TAC [GROUP_ID], SIMP_TAC [← GSYM NOT_IMP, RESTRICTION]] THEN
    MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC (← q r"{i:K}") THEN REWRITE_TAC [FINITE_SING] THEN SET_TAC []))

  let TRIVIAL_SUM_GROUP ← prove
   r"!k (G:K->A group).
        trivial_group(sum_group k G) <=> !i. i IN k ==> trivial_group(G i)"
   (← do
    let a1 ← SET_RULE (← q r"~(s SUBSET {a}) <=> ?x. x IN s /\ ~(x = a)")
    pure (REPEAT GEN_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [TRIVIAL_GROUP_SUBSET] THEN X_GEN_TAC (← q "i:K") THEN
      REWRITE_TAC [a1] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q "a:A") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC
       (← q r"RESTRICTION k (\j. if j = i then a else group_id (G j)):K->A") THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, RESTRICTION_IN_CARTESIAN_PRODUCT,
                  IN_ELIM_THM] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [GROUP_ID],
        MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{i:K}") THEN
        REWRITE_TAC [FINITE_SING, SUBSET, IN_ELIM_THM, IN_SING, RESTRICTION] THEN
        MESON_TAC [],
        DISCH_THEN (MP_TAC o C AP_THM (← q "i:K")) THEN
        ASM_REWRITE_TAC [RESTRICTION]],
      DISCH_TAC THEN REWRITE_TAC [sum_group] THEN
      MATCH_MP_TAC TRIVIAL_GROUP_SUBGROUP_GENERATED THEN
      ASM_REWRITE_TAC [TRIVIAL_PRODUCT_GROUP]]))

  let CARTESIAN_PRODUCT_SUBGROUP_OF_SUM_GROUP ← prove
   r"!k h G:K->A group.
        (cartesian_product k h) subgroup_of (sum_group k G) <=>
        (!i. i IN k ==> (h i) subgroup_of (G i)) /\
        (!z. z IN cartesian_product k h
             ==> FINITE {i | i IN k /\ ~(z i = group_id(G i))})"
   (← do
    let a2 ← SET_RULE
      (← q r"s SUBSET t
    ==> ((!x. x IN s ==> x IN t /\ P x) <=> (!x. x IN s ==> P x))")
    let a1 ← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")
    pure (REPEAT GEN_TAC THEN
    REWRITE_TAC [sum_group, SUBGROUP_OF_SUBGROUP_GENERATED_EQ] THEN
    REWRITE_TAC [← GSYM sum_group, SUM_GROUP_CLAUSES] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_SUBGROUP_OF_PRODUCT_GROUP] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    MATCH_MP_TAC a1 THEN
    DISCH_TAC THEN MATCH_MP_TAC a2 THEN
    REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT] THEN
    ASM_MESON_TAC [subgroup_of]))

  let SUM_GROUP_SUBGROUP_GENERATED ← prove
   r"!k G (h:K->A->bool).
        (!i. i IN k ==> (h i) subgroup_of (G i))
        ==> sum_group k (\i. subgroup_generated (G i) (h i)) =
            subgroup_generated (sum_group k G) (cartesian_product k h)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [GROUPS_EQ] THEN
    REWRITE_TAC [← CONJUNCT2 SUM_GROUP_CLAUSES, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
     [SUBGROUP_GENERATED_RESTRICT] THEN
    wPart rand (fun t => do lhand (← rand t)) CARRIER_SUBGROUP_GENERATED_SUBGROUP THEN
    ANTS_TAC THENL
     [GEN_REWRITE_TAC RAND_CONV [sum_group] THEN
      REWRITE_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_EQ] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUBGROUP_OF_INTER THEN
        ASM_SIMP_TAC [CARTESIAN_PRODUCT_SUBGROUP_OF_PRODUCT_GROUP] THEN
        REWRITE_TAC [SUM_GROUP_CLAUSES, SUBGROUP_SUM_GROUP],
        SIMP_TAC [SUBGROUP_SUM_GROUP, CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
        REWRITE_TAC [SUM_GROUP_CLAUSES] THEN SET_TAC []],
      DISCH_THEN SUBST1_TAC] THEN
    GEN_REWRITE_TAC I [EXTENSION] THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, IN_INTER, IN_ELIM_THM, cartesian_product] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of]) THEN ASM SET_TAC [])

  let ABELIAN_SUM_GROUP ← prove
   r"!k (G:K->A group).
           abelian_group (sum_group k G) <=>
           (!i. i IN k ==> abelian_group (G i))"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [abelian_group] THEN DISCH_TAC THEN
      X_GEN_TAC (← q "i:K") THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"RESTRICTION k (\j. if j = i then x else group_id (G j)):K->A",
        ← q r"RESTRICTION k (\j. if j = i then y else group_id (G j)):K->A"]) THEN
      ASM_REWRITE_TAC [GROUP_SUM_INJECTION] THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, RESTRICTION_EXTENSION] THEN
      DISCH_THEN (MP_TAC o SPEC (← q "i:K")) THEN ASM_REWRITE_TAC [RESTRICTION],
      SIMP_TAC [ABELIAN_SUBGROUP_GENERATED, sum_group, ABELIAN_PRODUCT_GROUP]])

  -- @@RETURN BEGIN
  return { sum_group, SUM_GROUP_ALT, SUM_GROUP_EQ_PRODUCT_GROUP, SUBGROUP_SUM_GROUP,
           SUM_GROUP_CLAUSES, GROUP_POW_SUM_GROUP, GROUP_ZPOW_SUM_GROUP,
           GROUP_SUM_INJECTION, TRIVIAL_SUM_GROUP,
           CARTESIAN_PRODUCT_SUBGROUP_OF_SUM_GROUP, SUM_GROUP_SUBGROUP_GENERATED,
           ABELIAN_SUM_GROUP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Homomorphisms etc. (grouptheory.ml 3011-3173).                            -/
/- ------------------------------------------------------------------------- -/

structure Homomorphisms where
  -- @@FIELDS
  group_homomorphism : thm
  group_monomorphism : thm
  group_epimorphism : thm
  group_endomorphism : thm
  group_isomorphisms : thm
  group_isomorphism : thm
  group_automorphism : thm
  GROUP_HOMOMORPHISM_EQ : thm
  GROUP_MONOMORPHISM_EQ : thm
  GROUP_EPIMORPHISM_EQ : thm
  GROUP_ENDOMORPHISM_EQ : thm
  GROUP_ISOMORPHISMS_EQ : thm
  GROUP_ISOMORPHISM_EQ : thm
  GROUP_AUTOMORPHISM_EQ : thm
  GROUP_HOMOMORPHISMS_EQ_ON_GENERATORS : thm
  GROUP_ISOMORPHISMS_SYM : thm
  GROUP_ISOMORPHISMS_IMP_ISOMORPHISM : thm
  GROUP_ISOMORPHISMS_IMP_ISOMORPHISM_ALT : thm
  GROUP_HOMOMORPHISM : thm
  GROUP_EPIMORPHISM_SUBSET : thm
  GROUP_ISOMORPHISMS : thm
  GROUP_HOMOMORPHISM_OF_ID : thm
  deriving Inhabited

@[nospecialize]
def setupHomomorphisms [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BSubgroupGenerated : SubgroupGenerated) :
    ExceptT String IO Homomorphisms := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, TAUT, new_definition, .. } := D
  let { EQ_SYM_EQ, .. } := D.core2
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { MONO_EXISTS, .. } := D.core6
  let { SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core7
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_LID, GROUP_MUL_RINV, .. } := BBasics
  let { GROUP_LID_UNIQUE, GROUP_LINV_UNIQUE, .. } := BDerived
  let { SUBGROUP_GENERATED_INDUCT_STRONG, .. } := BSubgroupGenerated
  -- @@SCOPE END

  let group_homomorphism ← new_definition
   r"group_homomorphism (G,G') (f:A->B) <=>
        IMAGE f (group_carrier G) SUBSET group_carrier G' /\
        f (group_id G) = group_id G' /\
        (!x. x IN group_carrier G
             ==> f(group_inv G x) = group_inv G' (f x)) /\
        (!x y. x IN group_carrier G /\ y IN group_carrier G
               ==> f(group_mul G x y) = group_mul G' (f x) (f y))"

  let group_monomorphism ← new_definition
   r"group_monomorphism (G,G') (f:A->B) <=>
        group_homomorphism (G,G') f /\
        !x y. x IN group_carrier G /\ y IN group_carrier G /\ f x = f y
             ==> x = y"

  let group_epimorphism ← new_definition
   r"group_epimorphism (G,G') (f:A->B) <=>
        group_homomorphism (G,G') f /\
        IMAGE f (group_carrier G) = group_carrier G'"

  let group_endomorphism ← new_definition
   r"group_endomorphism G (f:A->A) <=> group_homomorphism (G,G) f"

  let group_isomorphisms ← new_definition
   r"group_isomorphisms (G,G') ((f:A->B),g) <=>
        group_homomorphism (G,G') f /\
        group_homomorphism (G',G) g /\
        (!x. x IN group_carrier G ==> g(f x) = x) /\
        (!y. y IN group_carrier G' ==> f(g y) = y)"

  let group_isomorphism ← new_definition
   r"group_isomorphism (G,G') (f:A->B) <=> ?g. group_isomorphisms (G,G') (f,g)"

  let group_automorphism ← new_definition
   r"group_automorphism G (f:A->A) <=> group_isomorphism (G,G) f"

  let GROUP_HOMOMORPHISM_EQ ← prove
   r"!G H (f:A->B) f'.
        group_homomorphism(G,H) f /\
        (!x. x IN group_carrier G ==> f' x = f x)
        ==> group_homomorphism (G,H) f'"
   (REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    SIMP_TAC [GROUP_ID, GROUP_INV, GROUP_MUL])

  let GROUP_MONOMORPHISM_EQ ← prove
   r"!G H (f:A->B) f'.
        group_monomorphism(G,H) f /\
        (!x. x IN group_carrier G ==> f' x = f x)
        ==> group_monomorphism (G,H) f'"
   (REWRITE_TAC [group_monomorphism, group_homomorphism, SUBSET] THEN
    SIMP_TAC [FORALL_IN_IMAGE, GROUP_ID, GROUP_INV, GROUP_MUL] THEN
    MESON_TAC [])

  let GROUP_EPIMORPHISM_EQ ← prove
   r"!G H (f:A->B) f'.
        group_epimorphism(G,H) f /\
        (!x. x IN group_carrier G ==> f' x = f x)
        ==> group_epimorphism (G,H) f'"
   (REWRITE_TAC [group_epimorphism, group_homomorphism, SUBSET] THEN
    SIMP_TAC [FORALL_IN_IMAGE, GROUP_ID, GROUP_INV, GROUP_MUL] THEN
    SET_TAC [])

  let GROUP_ENDOMORPHISM_EQ ← prove
   r"!G (f:A->A) f'.
        group_endomorphism G f /\
        (!x. x IN group_carrier G ==> f' x = f x)
        ==> group_endomorphism G f'"
   (REWRITE_TAC [group_endomorphism, GROUP_HOMOMORPHISM_EQ])

  let GROUP_ISOMORPHISMS_EQ ← prove
   r"!G H (f:A->B) g.
        group_isomorphisms(G,H) (f,g) /\
        (!x. x IN group_carrier G ==> f' x = f x) /\
        (!y. y IN group_carrier H ==> g' y = g y)
        ==> group_isomorphisms(G,H) (f',g')"
   (SIMP_TAC [group_isomorphisms, group_homomorphism, SUBSET] THEN
    SIMP_TAC [FORALL_IN_IMAGE, GROUP_ID, GROUP_INV, GROUP_MUL] THEN
    SET_TAC [])

  let GROUP_ISOMORPHISM_EQ ← prove
   r"!G H (f:A->B) f'.
        group_isomorphism(G,H) f /\
        (!x. x IN group_carrier G ==> f' x = f x)
        ==> group_isomorphism (G,H) f'"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [group_isomorphism] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [GROUP_ISOMORPHISMS_EQ])

  let GROUP_AUTOMORPHISM_EQ ← prove
   r"!G (f:A->A) f'.
        group_automorphism G f /\
        (!x. x IN group_carrier G ==> f' x = f x)
        ==> group_automorphism G f'"
   (REWRITE_TAC [group_automorphism, GROUP_ISOMORPHISM_EQ])

  let GROUP_HOMOMORPHISMS_EQ_ON_GENERATORS ← prove
   r"!G H s (f:A->B) g.
        group_homomorphism(G,H) f /\
        group_homomorphism(G,H) g /\
        (!x. x IN group_carrier G /\ x IN s ==> f x = g x)
        ==> !x. x IN group_carrier(subgroup_generated G s) ==> f x = g x"
   (REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT_STRONG THEN
    ASM_MESON_TAC [])

  let GROUP_ISOMORPHISMS_SYM ← prove
   r"!G G' (f:A->B) g.
        group_isomorphisms (G,G') (f,g) <=> group_isomorphisms(G',G) (g,f)"
   (REWRITE_TAC [group_isomorphisms] THEN MESON_TAC [])

  let GROUP_ISOMORPHISMS_IMP_ISOMORPHISM ← prove
   r"!(f:A->B) g G G'.
        group_isomorphisms (G,G') (f,g) ==> group_isomorphism (G,G') f"
   (REWRITE_TAC [group_isomorphism] THEN MESON_TAC [])

  let GROUP_ISOMORPHISMS_IMP_ISOMORPHISM_ALT ← prove
   r"!(f:A->B) g G G'.
        group_isomorphisms (G,G') (f,g) ==> group_isomorphism (G',G) g"
   (MESON_TAC [GROUP_ISOMORPHISMS_SYM, GROUP_ISOMORPHISMS_IMP_ISOMORPHISM])

  let GROUP_HOMOMORPHISM ← prove
   r"!G G' f:A->B.
        group_homomorphism (G,G') (f:A->B) <=>
        IMAGE f (group_carrier G) SUBSET group_carrier G' /\
        (!x y. x IN group_carrier G /\ y IN group_carrier G
               ==> f(group_mul G x y) = group_mul G' (f x) (f y))"
   (← do
    let a1 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [group_homomorphism] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) THEN
    MATCH_MP_TAC a1 THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q "group_id G:A", ← q "group_id G:A"]) THEN
      SIMP_TAC [GROUP_ID, GROUP_MUL_LID] THEN
      GEN_REWRITE_TAC LAND_CONV [EQ_SYM_EQ] THEN
      ASM_MESON_TAC [GROUP_LID_UNIQUE, GROUP_ID],
      REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC GROUP_LINV_UNIQUE THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q "x:A", ← q "group_inv G x:A"]) THEN
      ASM_SIMP_TAC [GROUP_INV, GROUP_MUL_RINV]]))

  let GROUP_EPIMORPHISM_SUBSET ← prove
   r"!G G' (f:A->B).
        group_epimorphism(G,G') f <=>
        group_homomorphism(G,G') f /\
        group_carrier G' SUBSET IMAGE f (group_carrier G)"
   (REWRITE_TAC [group_epimorphism, group_homomorphism] THEN
    MESON_TAC [SUBSET_ANTISYM_EQ])

  let GROUP_ISOMORPHISMS ← prove
   r"!G H (f:A->B) g.
        group_isomorphisms(G,H) (f,g) <=>
        group_homomorphism(G,H) f /\
        (!x. x IN group_carrier G ==> g(f x) = x) /\
        (!y. y IN group_carrier H ==> g y IN group_carrier G /\ f(g y) = y)"
   (REWRITE_TAC [group_isomorphisms, group_homomorphism] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    ASM_MESON_TAC [GROUP_ID, GROUP_INV, GROUP_MUL])

  let GROUP_HOMOMORPHISM_OF_ID ← prove
   r"!(f:A->B) G G'.
        group_homomorphism(G,G') f ==> f (group_id G) = group_id G'"
   (SIMP_TAC [group_homomorphism])

  -- @@RETURN BEGIN
  return { group_homomorphism, group_monomorphism, group_epimorphism, group_endomorphism,
           group_isomorphisms, group_isomorphism, group_automorphism,
           GROUP_HOMOMORPHISM_EQ, GROUP_MONOMORPHISM_EQ, GROUP_EPIMORPHISM_EQ,
           GROUP_ENDOMORPHISM_EQ, GROUP_ISOMORPHISMS_EQ, GROUP_ISOMORPHISM_EQ,
           GROUP_AUTOMORPHISM_EQ, GROUP_HOMOMORPHISMS_EQ_ON_GENERATORS,
           GROUP_ISOMORPHISMS_SYM, GROUP_ISOMORPHISMS_IMP_ISOMORPHISM,
           GROUP_ISOMORPHISMS_IMP_ISOMORPHISM_ALT, GROUP_HOMOMORPHISM,
           GROUP_EPIMORPHISM_SUBSET, GROUP_ISOMORPHISMS, GROUP_HOMOMORPHISM_OF_ID }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Homomorphisms: elementary properties, identity/composition, into and from -/
/- subgroups.  (grouptheory.ml 3175-3393)                                    -/
/- ------------------------------------------------------------------------- -/

structure Homomorphisms1 where
  -- @@FIELDS
  GROUP_HOMOMORPHISM_INV : thm
  GROUP_HOMOMORPHISM_MUL : thm
  GROUP_HOMOMORPHISM_DIV : thm
  GROUP_HOMOMORPHISM_POW : thm
  GROUP_HOMOMORPHISM_ZPOW : thm
  GROUP_HOMOMORPHISM_TRIVIAL : thm
  GROUP_HOMOMORPHISM_ID : thm
  GROUP_MONOMORPHISM_ID : thm
  GROUP_EPIMORPHISM_ID : thm
  GROUP_ISOMORPHISMS_ID : thm
  GROUP_ISOMORPHISM_ID : thm
  GROUP_HOMOMORPHISM_COMPOSE : thm
  GROUP_MONOMORPHISM_COMPOSE : thm
  GROUP_MONOMORPHISM_COMPOSE_REV : thm
  GROUP_EPIMORPHISM_COMPOSE : thm
  GROUP_EPIMORPHISM_COMPOSE_REV : thm
  GROUP_MONOMORPHISM_LEFT_INVERTIBLE : thm
  GROUP_EPIMORPHISM_RIGHT_INVERTIBLE : thm
  GROUP_HOMOMORPHISM_INTO_SUBGROUP : thm
  GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN : thm
  GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ : thm
  GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED : thm
  GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS : thm
  GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS_ALT : thm
  GROUP_MONOMORPHISM_FROM_SUBGROUP_GENERATED : thm
  GROUP_MONOMORPHISM_BETWEEN_SUBGROUPS : thm
  GROUP_MONOMORPHISM_INTO_SUPERGROUP : thm
  GROUP_HOMOMORPHISM_INCLUSION : thm
  GROUP_MONOMORPHISM_INCLUSION : thm
  deriving Inhabited

@[nospecialize]
def setupHomomorphisms1 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BHomomorphisms : Homomorphisms) :
    ExceptT String IO Homomorphisms1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IMAGE_ID, IMAGE_o, INJECTIVE_ON_ALT, INJECTIVE_ON_LEFT_INVERSE, INTERS_GSPEC, .. } := D.core4
  let { MONO_AND, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_LID, .. } := BBasics
  let { GROUP_INV_ID, GROUP_POW, group_div, group_pow, .. } := BDerived
  let { group_zpow, .. } := BPow
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_INDUCT, SUBGROUP_GENERATED_RESTRICT, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_SUBSET_CARRIER, .. } := BSubgroupGen1
  let { group_epimorphism, group_homomorphism, group_isomorphism, group_isomorphisms,
        group_monomorphism, .. } := BHomomorphisms
  -- @@SCOPE END

  let GROUP_HOMOMORPHISM_INV ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f
          ==> !x. x IN group_carrier G
                  ==> f(group_inv G x) = group_inv G' (f x)"
   (SIMP_TAC [group_homomorphism])

  let GROUP_HOMOMORPHISM_MUL ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f
          ==> !x y. x IN group_carrier G /\ y IN group_carrier G
                    ==> f(group_mul G x y) = group_mul G' (f x) (f y)"
   (SIMP_TAC [group_homomorphism])

  let GROUP_HOMOMORPHISM_DIV ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f
          ==> !x y. x IN group_carrier G /\ y IN group_carrier G
                    ==> f(group_div G x y) = group_div G' (f x) (f y)"
   (REWRITE_TAC [group_homomorphism, group_div] THEN
    MESON_TAC [GROUP_MUL, GROUP_INV])

  let GROUP_HOMOMORPHISM_POW ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f
          ==> !x n. x IN group_carrier G
                    ==> f(group_pow G x n) = group_pow G' (f x) n"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_homomorphism] THEN DISCH_TAC THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [group_pow, GROUP_POW])

  let GROUP_HOMOMORPHISM_ZPOW ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f
          ==> !x n. x IN group_carrier G
                    ==> f(group_zpow G x n) = group_zpow G' (f x) n"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_zpow] THEN
    COND_CASES_TAC THEN
    ASM_MESON_TAC [GROUP_HOMOMORPHISM_POW, GROUP_HOMOMORPHISM_INV, GROUP_POW])

  let GROUP_HOMOMORPHISM_TRIVIAL ← prove
   r"!G H. group_homomorphism (G,H) (\x. group_id H)"
   (SIMP_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE, GROUP_MUL_LID,
             GROUP_INV_ID, GROUP_ID])

  let GROUP_HOMOMORPHISM_ID ← prove
   r"!G:A group. group_homomorphism (G,G) (\x. x)"
   (REWRITE_TAC [group_homomorphism, IMAGE_ID, SUBSET_REFL])

  let GROUP_MONOMORPHISM_ID ← prove
   r"!G:A group. group_monomorphism (G,G) (\x. x)"
   (SIMP_TAC [group_monomorphism, GROUP_HOMOMORPHISM_ID])

  let GROUP_EPIMORPHISM_ID ← prove
   r"!G:A group. group_epimorphism (G,G) (\x. x)"
   (SIMP_TAC [group_epimorphism, GROUP_HOMOMORPHISM_ID, IMAGE_ID])

  let GROUP_ISOMORPHISMS_ID ← prove
   r"!G:A group. group_isomorphisms (G,G) ((\x. x),(\x. x))"
   (REWRITE_TAC [group_isomorphisms, GROUP_HOMOMORPHISM_ID])

  let GROUP_ISOMORPHISM_ID ← prove
   r"!G:A group. group_isomorphism (G,G) (\x. x)"
   (REWRITE_TAC [group_isomorphism] THEN MESON_TAC [GROUP_ISOMORPHISMS_ID])

  let GROUP_HOMOMORPHISM_COMPOSE ← prove
   r"!G1 G2 G3 (f:A->B) (g:B->C).
          group_homomorphism(G1,G2) f /\ group_homomorphism(G2,G3) g
          ==> group_homomorphism(G1,G3) (g o f)"
   (SIMP_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE, IMAGE_o, o_THM])

  let GROUP_MONOMORPHISM_COMPOSE ← prove
   r"!G1 G2 G3 (f:A->B) (g:B->C).
          group_monomorphism(G1,G2) f /\ group_monomorphism(G2,G3) g
          ==> group_monomorphism(G1,G3) (g o f)"
   (REWRITE_TAC [group_monomorphism, group_homomorphism, INJECTIVE_ON_ALT] THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IMAGE_o, o_THM])

  let GROUP_MONOMORPHISM_COMPOSE_REV ← prove
   r"!(f:A->B) (g:B->C) A B C.
          group_homomorphism(A,B) f /\ group_homomorphism(B,C) g /\
          group_monomorphism(A,C) (g o f)
          ==> group_monomorphism(A,B) f"
   (REWRITE_TAC [group_monomorphism, o_THM] THEN MESON_TAC [])

  let GROUP_EPIMORPHISM_COMPOSE ← prove
   r"!G1 G2 G3 (f:A->B) (g:B->C).
          group_epimorphism(G1,G2) f /\ group_epimorphism(G2,G3) g
          ==> group_epimorphism(G1,G3) (g o f)"
   (SIMP_TAC [group_epimorphism, IMAGE_o] THEN
    MESON_TAC [GROUP_HOMOMORPHISM_COMPOSE])

  let GROUP_EPIMORPHISM_COMPOSE_REV ← prove
   r"!(f:A->B) (g:B->C) A B C.
          group_homomorphism(A,B) f /\ group_homomorphism(B,C) g /\
          group_epimorphism(A,C) (g o f)
          ==> group_epimorphism(B,C) g"
   (REWRITE_TAC [group_epimorphism, group_homomorphism, o_THM, IMAGE_o] THEN
    SET_TAC [])

  let GROUP_MONOMORPHISM_LEFT_INVERTIBLE ← prove
   r"!G H (f:A->B) g.
          group_homomorphism(G,H) f /\
          (!x. x IN group_carrier G ==> g(f x) = x)
          ==> group_monomorphism (G,H) f"
   (REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE, group_monomorphism] THEN
    MESON_TAC [])

  let GROUP_EPIMORPHISM_RIGHT_INVERTIBLE ← prove
   r"!G H (f:A->B) g.
          group_homomorphism(G,H) f /\
          group_homomorphism(H,G) g /\
          (!x. x IN group_carrier G ==> g(f x) = x)
          ==> group_epimorphism (H,G) g"
   (SIMP_TAC [group_epimorphism] THEN REWRITE_TAC [group_homomorphism] THEN
    SET_TAC [])

  let GROUP_HOMOMORPHISM_INTO_SUBGROUP ← prove
   r"!G G' h (f:A->B).
          group_homomorphism (G,G') f /\ IMAGE f (group_carrier G) SUBSET h
          ==> group_homomorphism (G,subgroup_generated G' h) f"
   (REPEAT GEN_TAC THEN SIMP_TAC [group_homomorphism, SUBGROUP_GENERATED] THEN
    REWRITE_TAC [INTERS_GSPEC] THEN SET_TAC [])

  let GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN ← prove
   r"!(f:A->B) G H s.
        group_homomorphism(G,subgroup_generated H s) f <=>
        group_homomorphism(G,H) f /\
        IMAGE f (group_carrier G) SUBSET group_carrier(subgroup_generated H s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_homomorphism] THEN
    MP_TAC (← ISPECL [← q "H:B group", ← q r"s:B->bool"]
      GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET) THEN
    REWRITE_TAC [SUBGROUP_GENERATED] THEN SET_TAC [])

  let GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ ← prove
   r"!G G' h (f:A->B).
          h subgroup_of G'
          ==> (group_homomorphism (G,subgroup_generated G' h) f <=>
               group_homomorphism (G,G') f /\
               IMAGE f (group_carrier G) SUBSET h)"
   (SIMP_TAC [GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN,
             CARRIER_SUBGROUP_GENERATED_SUBGROUP])

  let GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED ← prove
   r"!(f:A->B) G H s.
          group_homomorphism (G,H) f
          ==> group_homomorphism(subgroup_generated G s,H) f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_homomorphism] THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"s:A->bool"]
          GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET) THEN
    SIMP_TAC [SUBSET, SUBGROUP_GENERATED] THEN SET_TAC [])

  let GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS ← prove
   r"!G H g h (f:A->B).
        group_homomorphism(G,H) f /\ IMAGE f g SUBSET h
        ==> group_homomorphism(subgroup_generated G g,subgroup_generated H h) f"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN] THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q <=> p ==> p /\ q")] THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT THEN RULE_ASSUM_TAC
     (REWRITE_RULE [group_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
    MP_TAC (← REWRITE_RULE [SUBSET] (← ISPECL [← q "G:A group", ← q r"g:A->bool"]
          GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET)) THEN
    ASM_SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN REPEAT CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [SUBSET] SUBGROUP_GENERATED_SUBSET_CARRIER) THEN
      ASM SET_TAC [],
      ASM_MESON_TAC [GROUP_ID, SUBGROUP_GENERATED],
      ASM_MESON_TAC [GROUP_ID, SUBGROUP_GENERATED],
      ASM_MESON_TAC [GROUP_INV, SUBGROUP_GENERATED],
      ASM_MESON_TAC [GROUP_MUL, SUBGROUP_GENERATED]])

  let GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS_ALT ← prove
   r"!G H g h (f:A->B).
        group_homomorphism(G,H) f /\ IMAGE f (group_carrier G INTER g) SUBSET h
        ==> group_homomorphism(subgroup_generated G g,subgroup_generated H h) f"
   (MESON_TAC [SUBGROUP_GENERATED_RESTRICT,
              GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS])

  let GROUP_MONOMORPHISM_FROM_SUBGROUP_GENERATED ← prove
   r"!(f:A->B) G H s.
          group_monomorphism (G,H) f
          ==> group_monomorphism(subgroup_generated G s,H) f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_monomorphism] THEN
    MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED] THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"s:A->bool"]
      GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET) THEN
    SET_TAC [])

  let GROUP_MONOMORPHISM_BETWEEN_SUBGROUPS ← prove
   r"!G H s t (f:A->B).
        group_monomorphism(G,H) f /\ IMAGE f s SUBSET t
        ==> group_monomorphism(subgroup_generated G s,subgroup_generated H t) f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_monomorphism] THEN
    SIMP_TAC [GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS] THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"s:A->bool"]
      GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET) THEN
    SET_TAC [])

  let GROUP_MONOMORPHISM_INTO_SUPERGROUP ← prove
   r"!G G' t (f:A->B).
          group_monomorphism(G,subgroup_generated G' t) f
          ==> group_monomorphism(G,G') f"
   (REWRITE_TAC [group_monomorphism, GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN] THEN
    MESON_TAC [])

  let GROUP_HOMOMORPHISM_INCLUSION ← prove
   r"!G s:A->bool. group_homomorphism(subgroup_generated G s,G) (\x. x)"
   (SIMP_TAC [GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED,
             GROUP_HOMOMORPHISM_ID])

  let GROUP_MONOMORPHISM_INCLUSION ← prove
   r"!G s:A->bool. group_monomorphism(subgroup_generated G s,G) (\x. x)"
   (SIMP_TAC [GROUP_MONOMORPHISM_FROM_SUBGROUP_GENERATED,
             GROUP_MONOMORPHISM_ID])

  -- @@RETURN BEGIN
  return { GROUP_HOMOMORPHISM_INV, GROUP_HOMOMORPHISM_MUL, GROUP_HOMOMORPHISM_DIV,
           GROUP_HOMOMORPHISM_POW, GROUP_HOMOMORPHISM_ZPOW, GROUP_HOMOMORPHISM_TRIVIAL,
           GROUP_HOMOMORPHISM_ID, GROUP_MONOMORPHISM_ID, GROUP_EPIMORPHISM_ID,
           GROUP_ISOMORPHISMS_ID, GROUP_ISOMORPHISM_ID, GROUP_HOMOMORPHISM_COMPOSE,
           GROUP_MONOMORPHISM_COMPOSE, GROUP_MONOMORPHISM_COMPOSE_REV,
           GROUP_EPIMORPHISM_COMPOSE, GROUP_EPIMORPHISM_COMPOSE_REV,
           GROUP_MONOMORPHISM_LEFT_INVERTIBLE, GROUP_EPIMORPHISM_RIGHT_INVERTIBLE,
           GROUP_HOMOMORPHISM_INTO_SUBGROUP, GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN,
           GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ,
           GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED,
           GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS,
           GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS_ALT,
           GROUP_MONOMORPHISM_FROM_SUBGROUP_GENERATED,
           GROUP_MONOMORPHISM_BETWEEN_SUBGROUPS, GROUP_MONOMORPHISM_INTO_SUPERGROUP,
           GROUP_HOMOMORPHISM_INCLUSION, GROUP_MONOMORPHISM_INCLUSION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Homomorphisms: images, isomorphisms, mono/epi/iso relations, cardinality  -/
/- and conjugation.  (grouptheory.ml 3394-3634)                              -/
/- ------------------------------------------------------------------------- -/

structure Homomorphisms2 where
  -- @@FIELDS
  SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE : thm
  SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE_EQ : thm
  SUBGROUP_GENERATED_BY_EPIMORPHIC_IMAGE : thm
  GROUP_EPIMORPHISM_BETWEEN_SUBGROUPS : thm
  GROUP_EPIMORPHISM_INTO_SUBGROUP_EQ_GEN : thm
  GROUP_EPIMORPHISM_INTO_SUBGROUP_EQ : thm
  GROUP_ISOMORPHISM : thm
  GROUP_ISOMORPHISM_SUBSET : thm
  SUBGROUP_OF_HOMOMORPHIC_IMAGE : thm
  SUBGROUP_OF_HOMOMORPHIC_PREIMAGE : thm
  SUBGROUP_OF_EPIMORPHIC_PREIMAGE : thm
  GROUP_MONOMORPHISM_EPIMORPHISM : thm
  GROUP_ISOMORPHISM_EPIMORPHISM : thm
  SUBGROUP_MONOMORPHISM_EPIMORPHISM : thm
  GROUP_ISOMORPHISM_IMP_MONOMORPHISM : thm
  GROUP_ISOMORPHISM_IMP_EPIMORPHISM : thm
  GROUP_MONOMORPHISM_IMP_HOMOMORPHISM : thm
  GROUP_EPIMORPHISM_IMP_HOMOMORPHISM : thm
  GROUP_ISOMORPHISM_IMP_HOMOMORPHISM : thm
  GROUP_AUTOMORPHISM_IMP_ENDOMORPHISM : thm
  GROUP_ISOMORPHISM_EQ_MONOMORPHISM_FINITE : thm
  GROUP_ISOMORPHISM_EQ_EPIMORPHISM_FINITE : thm
  GROUP_ISOMORPHISMS_CONJUGATION : thm
  GROUP_AUTOMORPHISM_CONJUGATION : thm
  GROUP_ISOMORPHISM_CONJUGATION : thm
  GROUP_HOMOMORPHISM_CONJUGATION : thm
  CARD_LE_GROUP_MONOMORPHIC_IMAGE : thm
  CARD_LE_GROUP_EPIMORPHIC_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupHomomorphisms2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BGroupRule : GroupRule) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) :
    ExceptT String IO Homomorphisms2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, FUN_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, INJECTIVE_ON_LEFT_INVERSE, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, .. } := D.core5
  let { LE_C, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, SUBSET, SUBSET_ANTISYM, SUBSET_REFL,
        SURJECTIVE_IFF_INJECTIVE_GEN, le_c, .. } := D.core7
  let { GROUPS_EQ, GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_LINV, GROUP_MUL_RINV,
        GROUP_PROPERTIES, .. } := BBasics
  let { GROUP_TAC, .. } := BGroupRule
  let { GROUP_CONJUGATION, GROUP_CONJUGATION_BY_ID, GROUP_CONJUGATION_CONJUGATION,
        group_conjugation, .. } := BConjugation
  let { subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_EQ, SUBGROUP_GENERATED_INDUCT, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_INC, .. } := BSubgroupGen1
  let { GROUP_HOMOMORPHISM, group_automorphism, group_endomorphism, group_epimorphism,
        group_homomorphism, group_isomorphism, group_isomorphisms, group_monomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS,
        GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED, GROUP_HOMOMORPHISM_INTO_SUBGROUP,
        GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN, GROUP_MONOMORPHISM_INTO_SUPERGROUP, .. } := BHomomorphisms1
  -- @@SCOPE END

  let SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE ← prove
   r"!G H (f:A->B) s.
          group_homomorphism(G,H) f /\ s SUBSET group_carrier G
          ==> group_carrier (subgroup_generated H (IMAGE f s)) =
              IMAGE f (group_carrier(subgroup_generated G s))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET] THEN MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT THEN
      REWRITE_TAC [FORALL_IN_IMAGE_2] THEN ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      MP_TAC (← REWRITE_RULE [SUBSET] (← ISPECL [← q "G:A group", ← q r"s:A->bool"]
          GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET)) THEN
      FIRST_X_ASSUM (MP_TAC o GSYM o GEN_REWRITE_RULE I [group_homomorphism]) THEN
      ASM_SIMP_TAC [SUBGROUP_GENERATED_INC, FUN_IN_IMAGE] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC FUN_IN_IMAGE THEN
      ASM_MESON_TAC [SUBGROUP_GENERATED, GROUP_ID, GROUP_INV, GROUP_MUL],
      FIRST_ASSUM (MP_TAC o ISPECL [← q r"s:A->bool", ← q r"IMAGE (f:A->B) s"] o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS)) THEN
      SIMP_TAC [group_homomorphism, SUBSET_REFL]])

  let SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE_EQ ← prove
   r"!G H s t (f:A->B).
          group_homomorphism (G,H) f /\
          s SUBSET group_carrier G /\
          t SUBSET group_carrier G /\
          subgroup_generated G s = subgroup_generated G t
          ==> subgroup_generated H (IMAGE f s) =
              subgroup_generated H (IMAGE f t)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE])

  let SUBGROUP_GENERATED_BY_EPIMORPHIC_IMAGE ← prove
   r"!G H s (f:A->B).
          group_epimorphism (G,H) f /\
          s SUBSET group_carrier G /\
          subgroup_generated G s = G
          ==> subgroup_generated H (IMAGE f s) = H"
   (REWRITE_TAC [SUBGROUP_GENERATED_EQ] THEN
    SIMP_TAC [group_epimorphism, SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE])

  let GROUP_EPIMORPHISM_BETWEEN_SUBGROUPS ← prove
   r"!G H (f:A->B).
          group_homomorphism(G,H) f /\ s SUBSET group_carrier G
          ==> group_epimorphism(subgroup_generated G s,
                                subgroup_generated H (IMAGE f s)) f"
   (REWRITE_TAC [group_epimorphism, GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN] THEN
    SIMP_TAC [GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED] THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE, SUBSET_REFL])

  let GROUP_EPIMORPHISM_INTO_SUBGROUP_EQ_GEN ← prove
   r"!(f:A->B) G H s.
        group_epimorphism(G,subgroup_generated H s) f <=>
        group_homomorphism(G,H) f /\
        IMAGE f (group_carrier G) = group_carrier(subgroup_generated H s)"
   (REWRITE_TAC [group_epimorphism, GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN] THEN
    SET_TAC [])

  let GROUP_EPIMORPHISM_INTO_SUBGROUP_EQ ← prove
   r"!G G' h (f:A->B).
          h subgroup_of G'
          ==> (group_epimorphism (G,subgroup_generated G' h) f <=>
               group_homomorphism (G,G') f /\
               IMAGE f (group_carrier G) = h)"
   (SIMP_TAC [GROUP_EPIMORPHISM_INTO_SUBGROUP_EQ_GEN,
             CARRIER_SUBGROUP_GENERATED_SUBGROUP])

  let GROUP_ISOMORPHISM ← prove
   r"!G G' f:A->B.
        group_isomorphism (G,G') (f:A->B) <=>
        group_homomorphism (G,G') f /\
        IMAGE f (group_carrier G) = group_carrier G' /\
        (!x y. x IN group_carrier G /\ y IN group_carrier G /\ f x = f y
               ==> x = y)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [group_isomorphism, group_isomorphisms, group_homomorphism] THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE, RIGHT_AND_EXISTS_THM] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBST1_TAC (← SYM (← ASSUME
      (← q r"IMAGE (f:A->B) (group_carrier G) = group_carrier G'"))) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_IMAGE_2] THEN
    ASM_SIMP_TAC [] THEN ASM_MESON_TAC GROUP_PROPERTIES)

  let GROUP_ISOMORPHISM_SUBSET ← prove
   r"!G G' f:A->B.
        group_isomorphism (G,G') (f:A->B) <=>
        group_homomorphism (G,G') f /\
        (!z. z IN group_carrier G' ==> ?x. x IN group_carrier G /\ f x = z) /\
        (!x y. x IN group_carrier G /\ y IN group_carrier G /\ f x = f y
               ==> x = y)"
   (REWRITE_TAC [GROUP_ISOMORPHISM, group_homomorphism] THEN
    SET_TAC [])

  let SUBGROUP_OF_HOMOMORPHIC_IMAGE ← prove
   r"!G G' (f:A->B).
          group_homomorphism (G,G') f /\ h subgroup_of G
          ==> IMAGE f h subgroup_of G'"
   (REWRITE_TAC [group_homomorphism, subgroup_of] THEN SET_TAC [])

  let SUBGROUP_OF_HOMOMORPHIC_PREIMAGE ← prove
   r"!G H (f:A->B) h.
          group_homomorphism(G,H) f /\ h subgroup_of H
          ==> {x | x IN group_carrier G /\ f x IN h} subgroup_of G"
   (REWRITE_TAC [group_homomorphism, subgroup_of, IN_ELIM_THM] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
    MESON_TAC [GROUP_ID, GROUP_INV, GROUP_MUL])

  let SUBGROUP_OF_EPIMORPHIC_PREIMAGE ← prove
   r"!G H (f:A->B) h.
          group_epimorphism(G,H) f /\ h subgroup_of H
          ==> {x | x IN group_carrier G /\ f x IN h} subgroup_of G /\
              IMAGE f {x | x IN group_carrier G /\ f x IN h} = h"
   (REWRITE_TAC [group_epimorphism] THEN
    REWRITE_TAC [group_homomorphism, subgroup_of, IN_ELIM_THM] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE] THEN
    MESON_TAC [GROUP_ID, GROUP_INV, GROUP_MUL])

  let GROUP_MONOMORPHISM_EPIMORPHISM ← prove
   r"!G G' f:A->B.
          group_monomorphism (G,G') f /\ group_epimorphism (G,G') f <=>
          group_isomorphism (G,G') f"
   (REWRITE_TAC [GROUP_ISOMORPHISM, group_monomorphism, group_epimorphism] THEN
    MESON_TAC [])

  let GROUP_ISOMORPHISM_EPIMORPHISM ← prove
   r"!G G' (f:A->B).
          group_isomorphism (G,G') f <=>
          group_epimorphism (G,G') f /\
          (!x y. x IN group_carrier G /\ y IN group_carrier G /\ f x = f y
                 ==> x = y)"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM,
                group_monomorphism, group_epimorphism] THEN
    MESON_TAC [])

  let SUBGROUP_MONOMORPHISM_EPIMORPHISM ← prove
   r"!G G' s (f:A->B).
          group_monomorphism(G,G') f /\
          group_epimorphism(G,subgroup_generated G' s) f <=>
          group_isomorphism(G,subgroup_generated G' s) f"
   (MESON_TAC [GROUP_MONOMORPHISM_EPIMORPHISM, GROUP_MONOMORPHISM_INTO_SUPERGROUP,
              GROUP_HOMOMORPHISM_INTO_SUBGROUP, group_monomorphism,
              group_epimorphism])

  let GROUP_ISOMORPHISM_IMP_MONOMORPHISM ← prove
   r"!G G' (f:A->B).
          group_isomorphism (G,G') f ==> group_monomorphism (G,G') f"
   (SIMP_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM])

  let GROUP_ISOMORPHISM_IMP_EPIMORPHISM ← prove
   r"!G G' (f:A->B).
          group_isomorphism (G,G') f ==> group_epimorphism (G,G') f"
   (SIMP_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM])

  let GROUP_MONOMORPHISM_IMP_HOMOMORPHISM ← prove
   r"!(f:A->B) G H. group_monomorphism(G,H) f ==> group_homomorphism(G,H) f"
   (SIMP_TAC [group_monomorphism])

  let GROUP_EPIMORPHISM_IMP_HOMOMORPHISM ← prove
   r"!(f:A->B) G H. group_epimorphism(G,H) f ==> group_homomorphism(G,H) f"
   (SIMP_TAC [group_epimorphism])

  let GROUP_ISOMORPHISM_IMP_HOMOMORPHISM ← prove
   r"!(f:A->B) G H. group_isomorphism(G,H) f ==> group_homomorphism(G,H) f"
   (SIMP_TAC [GROUP_ISOMORPHISM])

  let GROUP_AUTOMORPHISM_IMP_ENDOMORPHISM ← prove
   r"!G (f:A->A). group_automorphism G f ==> group_endomorphism G f"
   (REWRITE_TAC [group_automorphism, group_endomorphism] THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_HOMOMORPHISM])

  let GROUP_ISOMORPHISM_EQ_MONOMORPHISM_FINITE ← prove
   r"!G H (f:A->B).
          FINITE(group_carrier G) /\ FINITE(group_carrier H) /\
          CARD(group_carrier G) = CARD(group_carrier H)
          ==> (group_isomorphism(G,H) f <=> group_monomorphism(G,H) f)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_MONOMORPHISM] THEN
    SIMP_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [group_monomorphism, group_epimorphism] THEN
    REWRITE_TAC [group_homomorphism] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN MP_TAC (← ISPECL
     [← q r"group_carrier G:A->bool", ← q r"group_carrier H:B->bool", ← q "f:A->B"]
          SURJECTIVE_IFF_INJECTIVE_GEN) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let GROUP_ISOMORPHISM_EQ_EPIMORPHISM_FINITE ← prove
   r"!G H (f:A->B).
          FINITE(group_carrier G) /\ FINITE(group_carrier H) /\
          CARD(group_carrier G) = CARD(group_carrier H)
          ==> (group_isomorphism(G,H) f <=> group_epimorphism(G,H) f)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_EPIMORPHISM] THEN
    SIMP_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [group_monomorphism, group_epimorphism] THEN
    REWRITE_TAC [group_homomorphism] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN MP_TAC (← ISPECL
     [← q r"group_carrier G:A->bool", ← q r"group_carrier H:B->bool", ← q "f:A->B"]
          SURJECTIVE_IFF_INJECTIVE_GEN) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let GROUP_ISOMORPHISMS_CONJUGATION ← prove
   r"!G a:A.
          a IN group_carrier G
          ==> group_isomorphisms (G,G)
               (group_conjugation G a,group_conjugation G (group_inv G a))"
   (REWRITE_TAC [group_isomorphisms, GROUP_HOMOMORPHISM] THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE, GROUP_CONJUGATION, GROUP_MUL,
             GROUP_CONJUGATION_CONJUGATION, GROUP_INV] THEN
    SIMP_TAC [GROUP_MUL_LINV, GROUP_MUL_RINV, GROUP_CONJUGATION_BY_ID] THEN
    REWRITE_TAC [group_conjugation] THEN REPEAT STRIP_TAC THEN GROUP_TAC)

  let GROUP_AUTOMORPHISM_CONJUGATION ← prove
   r"!G a:A.
          a IN group_carrier G ==> group_automorphism G (group_conjugation G a)"
   (REWRITE_TAC [group_automorphism, group_isomorphism] THEN
    MESON_TAC [GROUP_ISOMORPHISMS_CONJUGATION])

  let GROUP_ISOMORPHISM_CONJUGATION ← prove
   r"!G a:A. a IN group_carrier G
             ==> group_isomorphism (G,G) (group_conjugation G a)"
   (REWRITE_TAC [← GSYM group_automorphism, GROUP_AUTOMORPHISM_CONJUGATION])

  let GROUP_HOMOMORPHISM_CONJUGATION ← prove
   r"!G a:A. a IN group_carrier G
             ==> group_homomorphism (G,G) (group_conjugation G a)"
   (SIMP_TAC [GROUP_ISOMORPHISM_CONJUGATION,
             GROUP_ISOMORPHISM_IMP_HOMOMORPHISM])

  let CARD_LE_GROUP_MONOMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
          group_monomorphism(G,H) f ==> group_carrier G <=_c group_carrier H"
   (REWRITE_TAC [group_monomorphism, le_c, group_homomorphism] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q "f:A->B") THEN ASM SET_TAC [])

  let CARD_LE_GROUP_EPIMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
          group_epimorphism(G,H) f ==> group_carrier H <=_c group_carrier G"
   (REWRITE_TAC [group_epimorphism, LE_C, group_homomorphism] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q "f:A->B") THEN ASM SET_TAC [])

  -- @@RETURN BEGIN
  return { SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE,
           SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE_EQ,
           SUBGROUP_GENERATED_BY_EPIMORPHIC_IMAGE, GROUP_EPIMORPHISM_BETWEEN_SUBGROUPS,
           GROUP_EPIMORPHISM_INTO_SUBGROUP_EQ_GEN, GROUP_EPIMORPHISM_INTO_SUBGROUP_EQ,
           GROUP_ISOMORPHISM, GROUP_ISOMORPHISM_SUBSET, SUBGROUP_OF_HOMOMORPHIC_IMAGE,
           SUBGROUP_OF_HOMOMORPHIC_PREIMAGE, SUBGROUP_OF_EPIMORPHIC_PREIMAGE,
           GROUP_MONOMORPHISM_EPIMORPHISM, GROUP_ISOMORPHISM_EPIMORPHISM,
           SUBGROUP_MONOMORPHISM_EPIMORPHISM, GROUP_ISOMORPHISM_IMP_MONOMORPHISM,
           GROUP_ISOMORPHISM_IMP_EPIMORPHISM, GROUP_MONOMORPHISM_IMP_HOMOMORPHISM,
           GROUP_EPIMORPHISM_IMP_HOMOMORPHISM, GROUP_ISOMORPHISM_IMP_HOMOMORPHISM,
           GROUP_AUTOMORPHISM_IMP_ENDOMORPHISM, GROUP_ISOMORPHISM_EQ_MONOMORPHISM_FINITE,
           GROUP_ISOMORPHISM_EQ_EPIMORPHISM_FINITE, GROUP_ISOMORPHISMS_CONJUGATION,
           GROUP_AUTOMORPHISM_CONJUGATION, GROUP_ISOMORPHISM_CONJUGATION,
           GROUP_HOMOMORPHISM_CONJUGATION, CARD_LE_GROUP_MONOMORPHIC_IMAGE,
           CARD_LE_GROUP_EPIMORPHIC_IMAGE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Homomorphisms: isomorphisms between/into subgroups, composition, inverse, -/
/- opposite and trivial groups, products and pairings.                       -/
/- (grouptheory.ml 3636-3957)                                                -/
/- ------------------------------------------------------------------------- -/

structure Homomorphisms3 where
  -- @@FIELDS
  CARD_EQ_GROUP_ISOMORPHIC_IMAGE : thm
  FINITE_GROUP_MONOMORPHIC_PREIMAGE : thm
  FINITE_GROUP_EPIMORPHIC_IMAGE : thm
  CARD_EQ_GROUP_MONOMORPHIC_IMAGE : thm
  GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS : thm
  GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS_ALT : thm
  GROUP_ISOMORPHISM_BETWEEN_SUBGROUPS : thm
  GROUP_ISOMORPHISMS_COMPOSE : thm
  GROUP_ISOMORPHISM_COMPOSE : thm
  GROUP_ISOMORPHISM_COMPOSE_REV : thm
  GROUP_EPIMORPHISM_ISOMORPHISM_COMPOSE_REV : thm
  GROUP_MONOMORPHISM_ISOMORPHISM_COMPOSE_REV : thm
  GROUP_ISOMORPHISM_INVERSE : thm
  GROUP_ISOMORPHISMS_OPPOSITE_GROUP : thm
  GROUP_ISOMORPHISM_OPPOSITE_GROUP : thm
  GROUP_HOMOMORPHISM_FROM_TRIVIAL_GROUP : thm
  GROUP_MONOMORPHISM_FROM_TRIVIAL_GROUP : thm
  GROUP_MONOMORPHISM_TO_TRIVIAL_GROUP : thm
  GROUP_EPIMORPHISM_FROM_TRIVIAL_GROUP : thm
  GROUP_EPIMORPHISM_TO_TRIVIAL_GROUP : thm
  GROUP_HOMOMORPHISM_PAIRWISE : thm
  GROUP_HOMOMORPHISM_PAIRED : thm
  GROUP_HOMOMORPHISM_PAIRED2 : thm
  GROUP_ISOMORPHISMS_PAIRED2 : thm
  GROUP_ISOMORPHISM_PAIRED2 : thm
  GROUP_HOMOMORPHISM_OF_FST : thm
  GROUP_HOMOMORPHISM_OF_SND : thm
  GROUP_EPIMORPHISM_OF_FST : thm
  GROUP_EPIMORPHISM_OF_SND : thm
  GROUP_HOMOMORPHISM_FST : thm
  GROUP_HOMOMORPHISM_SND : thm
  GROUP_EPIMORPHISM_FST : thm
  GROUP_EPIMORPHISM_SND : thm
  GROUP_ISOMORPHISM_FST : thm
  GROUP_ISOMORPHISM_SND : thm
  GROUP_ISOMORPHISMS_PROD_GROUP_SWAP : thm
  deriving Inhabited

@[nospecialize]
def setupHomomorphisms3 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BSubgroupGenerated : SubgroupGenerated) (BProdGroup : ProdGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) :
    ExceptT String IO Homomorphisms3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { CARD_EQ_IMAGE, CARD_LE_ANTISYM, CARD_LE_FINITE, .. } := D.core1
  let { CROSS_EQ, ETA_AX, .. } := D.core2
  let { FORALL_IN_CROSS, FORALL_IN_IMAGE, FORALL_PAIR_FUN_THM, FORALL_PAIR_THM, .. } := D.core3
  let { IMAGE_EQ_EMPTY, IMAGE_FST_CROSS, IMAGE_PAIRED_CROSS, IMAGE_SND_CROSS, IMAGE_o,
        IMP_CONJ_ALT, .. } := D.core4
  let { IN_CROSS, IN_SING, LAMBDA_PAIR, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, PAIR_EQ, .. } := D.core6
  let { SUBSET, SUBSET_REFL, .. } := D.core7
  let { o_ASSOC, o_DEF, o_THM, .. } := D.core8
  let { GROUP_CARRIER_NONEMPTY, GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_LID,
        OPPOSITE_GROUP, TRIVIAL_GROUP_ALT, trivial_group, .. } := BBasics
  let { GROUP_INV_ID, GROUP_INV_INV, GROUP_INV_MUL, .. } := BDerived
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED_RESTRICT, .. } := BSubgroupGenerated
  let { PROD_GROUP, .. } := BProdGroup
  let { GROUP_ISOMORPHISMS_SYM, GROUP_ISOMORPHISM_EQ, group_epimorphism,
        group_homomorphism, group_isomorphism, group_isomorphisms, group_monomorphism, .. } := BHomomorphisms
  let { GROUP_EPIMORPHISM_COMPOSE_REV, GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS,
        GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS_ALT, GROUP_HOMOMORPHISM_ID,
        GROUP_MONOMORPHISM_COMPOSE_REV, .. } := BHomomorphisms1
  let { CARD_LE_GROUP_EPIMORPHIC_IMAGE, CARD_LE_GROUP_MONOMORPHIC_IMAGE,
        GROUP_ISOMORPHISM, GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  -- @@SCOPE END

  let CARD_EQ_GROUP_ISOMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
          group_isomorphism(G,H) f ==> group_carrier G =_c group_carrier H"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM, ← GSYM CARD_LE_ANTISYM] THEN
    MESON_TAC [CARD_LE_GROUP_MONOMORPHIC_IMAGE, CARD_LE_GROUP_EPIMORPHIC_IMAGE])

  let FINITE_GROUP_MONOMORPHIC_PREIMAGE ← prove
   r"!G H (f:A->B).
          group_monomorphism(G,H) f /\ FINITE(group_carrier H)
          ==> FINITE(group_carrier G)"
   (MESON_TAC [CARD_LE_FINITE, CARD_LE_GROUP_MONOMORPHIC_IMAGE])

  let FINITE_GROUP_EPIMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
          group_epimorphism(G,H) f /\ FINITE(group_carrier G)
          ==> FINITE(group_carrier H)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_FINITE) THEN
    ASM_MESON_TAC [CARD_LE_GROUP_EPIMORPHIC_IMAGE])

  let CARD_EQ_GROUP_MONOMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
          group_monomorphism(G,H) f
          ==> IMAGE f (group_carrier G) =_c group_carrier G"
   (REWRITE_TAC [group_monomorphism] THEN MESON_TAC [CARD_EQ_IMAGE])

  let GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS ← prove
   r"!G H g h (f:A->B) f'.
        group_isomorphisms(G,H) (f,f') /\
        IMAGE f g SUBSET h /\ IMAGE f' h SUBSET g
        ==> group_isomorphisms (subgroup_generated G g,subgroup_generated H h)
                               (f,f')"
   (SIMP_TAC [group_isomorphisms, GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS] THEN
    MESON_TAC [SUBSET, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET])

  let GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS_ALT ← prove
   r"!G H g h (f:A->B) f'.
        group_isomorphisms(G,H) (f,f') /\
        IMAGE f (group_carrier G INTER g) SUBSET h /\
        IMAGE f' (group_carrier H INTER h) SUBSET g
        ==> group_isomorphisms (subgroup_generated G g,subgroup_generated H h)
                               (f,f')"
   (SIMP_TAC [group_isomorphisms, GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS_ALT] THEN
    MESON_TAC [SUBSET, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET])

  let GROUP_ISOMORPHISM_BETWEEN_SUBGROUPS ← prove
   r"!G H g h (f:A->B).
        group_isomorphism(G,H) f /\ g SUBSET group_carrier G /\ IMAGE f g = h
        ==> group_isomorphism(subgroup_generated G g,subgroup_generated H h) f"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [group_isomorphism] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"f':B->A") THEN
    REWRITE_TAC [group_isomorphisms] THEN REPEAT STRIP_TAC THENL
     [ASM_SIMP_TAC [GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS, SUBSET_REFL],
      ALL_TAC,
      ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET],
      ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET]] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [SUBGROUP_GENERATED_RESTRICT] THEN
    MATCH_MP_TAC GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS THEN
    ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN
    ASM SET_TAC [])

  let GROUP_ISOMORPHISMS_COMPOSE ← prove
   r"!G1 G2 G3 (f1:A->B) (f2:B->C) g1 g2.
          group_isomorphisms(G1,G2) (f1,g1) /\ group_isomorphisms(G2,G3) (f2,g2)
          ==> group_isomorphisms(G1,G3) (f2 o f1,g1 o g2)"
   (SIMP_TAC [group_isomorphisms, group_homomorphism,
             SUBSET, FORALL_IN_IMAGE, IMAGE_o, o_THM])

  let GROUP_ISOMORPHISM_COMPOSE ← prove
   r"!G1 G2 G3 (f:A->B) (g:B->C).
          group_isomorphism(G1,G2) f /\ group_isomorphism(G2,G3) g
          ==> group_isomorphism(G1,G3) (g o f)"
   (REWRITE_TAC [group_isomorphism] THEN MESON_TAC [GROUP_ISOMORPHISMS_COMPOSE])

  let GROUP_ISOMORPHISM_COMPOSE_REV ← prove
   r"!(f:A->B) (g:B->C) A B C.
          group_homomorphism(A,B) f /\ group_homomorphism(B,C) g /\
          group_isomorphism(A,C) (g o f)
          ==> group_monomorphism(A,B) f /\ group_epimorphism(B,C) g"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    MESON_TAC [GROUP_MONOMORPHISM_COMPOSE_REV, GROUP_EPIMORPHISM_COMPOSE_REV])

  let GROUP_EPIMORPHISM_ISOMORPHISM_COMPOSE_REV ← prove
   r"!(f:A->B) (g:B->C) A B C.
          group_epimorphism (A,B) f /\
          group_homomorphism (B,C) g /\
          group_isomorphism (A,C) (g o f)
          ==> group_isomorphism (A,B) f /\ group_isomorphism (B,C) g"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [GROUP_ISOMORPHISM_COMPOSE_REV, group_epimorphism,
                    GROUP_MONOMORPHISM_EPIMORPHISM],
      REWRITE_TAC [group_isomorphism, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"f':B->A") THEN DISCH_TAC THEN
      REWRITE_TAC [← GSYM group_isomorphism] THEN
      MATCH_MP_TAC GROUP_ISOMORPHISM_EQ THEN
      EXISTS_TAC (← q r"(g:B->C) o f o (f':B->A)") THEN CONJ_TAC THENL
       [REWRITE_TAC [o_ASSOC] THEN MATCH_MP_TAC GROUP_ISOMORPHISM_COMPOSE THEN
        ASM_MESON_TAC [GROUP_ISOMORPHISMS_SYM, group_isomorphism],
        RULE_ASSUM_TAC (REWRITE_RULE
         [group_isomorphisms, group_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
        ASM_SIMP_TAC [o_THM]]])

  let GROUP_MONOMORPHISM_ISOMORPHISM_COMPOSE_REV ← prove
   r"!(f:A->B) (g:B->C) A B C.
          group_homomorphism (A,B) f /\
          group_monomorphism (B,C) g /\
          group_isomorphism (A,C) (g o f)
          ==> group_isomorphism (A,B) f /\ group_isomorphism (B,C) g"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [GROUP_ISOMORPHISM_COMPOSE_REV, group_monomorphism,
                    GROUP_MONOMORPHISM_EPIMORPHISM],
      REWRITE_TAC [group_isomorphism, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"g':C->B") THEN DISCH_TAC THEN
      REWRITE_TAC [← GSYM group_isomorphism] THEN
      MATCH_MP_TAC GROUP_ISOMORPHISM_EQ THEN
      EXISTS_TAC (← q r"(g':C->B) o g o (f:A->B)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC GROUP_ISOMORPHISM_COMPOSE THEN
        ASM_MESON_TAC [GROUP_ISOMORPHISMS_SYM, group_isomorphism],
        RULE_ASSUM_TAC (REWRITE_RULE
         [group_isomorphisms, group_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
        ASM_SIMP_TAC [o_THM]]])

  let GROUP_ISOMORPHISM_INVERSE ← prove
   r"!(f:A->B) g G H.
          group_isomorphism(G,H) f /\
          (!x. x IN group_carrier G ==> g(f x) = x)
          ==> group_isomorphism(H,G) g"
   (REWRITE_TAC [group_isomorphism, group_isomorphisms, group_homomorphism] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_SIMP_TAC [] THEN
    SUBGOAL_THEN
     (← q r"!y. y IN group_carrier H ==> (g:B->A) y IN group_carrier G")
    ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!y. y IN group_carrier H ==> (f:A->B)(g y) = y")
    ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    ASM_MESON_TAC [GROUP_ID, GROUP_INV, GROUP_MUL])

  let GROUP_ISOMORPHISMS_OPPOSITE_GROUP ← prove
   r"!G:A group.
          group_isomorphisms(G,opposite_group G) (group_inv G,group_inv G)"
   (REWRITE_TAC [group_isomorphisms, group_homomorphism, OPPOSITE_GROUP] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, GROUP_INV_ID] THEN
    SIMP_TAC [GROUP_INV, GROUP_INV_MUL, GROUP_INV_INV])

  let GROUP_ISOMORPHISM_OPPOSITE_GROUP ← prove
   r"!G:A group.
          group_isomorphism(G,opposite_group G) (group_inv G)"
   (REWRITE_TAC [group_isomorphism] THEN
    MESON_TAC [GROUP_ISOMORPHISMS_OPPOSITE_GROUP])

  let GROUP_HOMOMORPHISM_FROM_TRIVIAL_GROUP ← prove
   r"!(f:A->B) G H.
          trivial_group G
          ==> (group_homomorphism(G,H) f <=> f(group_id G) = group_id H)"
   (REPEAT GEN_TAC THEN SIMP_TAC [trivial_group, group_homomorphism] THEN
    ASM_CASES_TAC (← q r"(f:A->B)(group_id G) = group_id H") THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
    ASM_SIMP_TAC [IN_SING, GROUP_MUL_LID, GROUP_ID, SUBSET, FORALL_IN_IMAGE,
                 GROUP_INV_ID])

  let GROUP_MONOMORPHISM_FROM_TRIVIAL_GROUP ← prove
   r"!(f:A->B) G H.
          trivial_group G
          ==> (group_monomorphism (G,H) f <=> group_homomorphism (G,H) f)"
   (REWRITE_TAC [group_monomorphism, trivial_group] THEN SET_TAC [])

  let GROUP_MONOMORPHISM_TO_TRIVIAL_GROUP ← prove
   r"!(f:A->B) G H.
          trivial_group H
          ==> (group_monomorphism (G,H) f <=>
               group_homomorphism (G,H) f /\ trivial_group G)"
   (SIMP_TAC [group_monomorphism, trivial_group, group_homomorphism] THEN
    REPEAT GEN_TAC THEN MP_TAC (← ISPEC (← q "G:A group") GROUP_ID) THEN SET_TAC [])

  let GROUP_EPIMORPHISM_FROM_TRIVIAL_GROUP ← prove
   r"!(f:A->B) G H.
          trivial_group G
          ==> (group_epimorphism (G,H) f <=>
               group_homomorphism (G,H) f /\ trivial_group H)"
   (SIMP_TAC [group_epimorphism, trivial_group, group_homomorphism] THEN
    SET_TAC [])

  let GROUP_EPIMORPHISM_TO_TRIVIAL_GROUP ← prove
   r"!(f:A->B) G H.
          trivial_group H
          ==> (group_epimorphism (G,H) f <=>
               group_homomorphism (G,H) f)"
   (REWRITE_TAC [group_epimorphism, trivial_group, group_homomorphism] THEN
    REPEAT GEN_TAC THEN
    MAP_EVERY (MP_TAC oTIO C ISPEC GROUP_ID) [← q "G:A group", ← q "H:B group"] THEN
    SET_TAC [])

  let GROUP_HOMOMORPHISM_PAIRWISE ← prove
   r"!(f:A->B#C) G H K.
          group_homomorphism(G,prod_group H K) f <=>
          group_homomorphism(G,H) (FST o f) /\
          group_homomorphism(G,K) (SND o f)"
   (REWRITE_TAC [group_homomorphism, PROD_GROUP] THEN
    REWRITE_TAC [FORALL_PAIR_FUN_THM, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_DEF, IN_CROSS, PAIR_EQ] THEN MESON_TAC [])

  let GROUP_HOMOMORPHISM_PAIRED ← prove
   r"!(f:A->B) (g:A->C) G H K.
          group_homomorphism(G,prod_group H K) (\x. f x,g x) <=>
          group_homomorphism(G,H) f /\
          group_homomorphism(G,K) g"
   (REWRITE_TAC [GROUP_HOMOMORPHISM_PAIRWISE, o_DEF, ETA_AX])

  let GROUP_HOMOMORPHISM_PAIRED2 ← prove
   r"!(f:A->B) (g:C->D) G H G' H'.
          group_homomorphism(prod_group G H,prod_group G' H')
                  (\(x,y). f x,g y) <=>
          group_homomorphism(G,G') f /\ group_homomorphism(H,H') g"
   (REWRITE_TAC [group_homomorphism, PROD_GROUP, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [PROD_GROUP, FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
    MESON_TAC [GROUP_ID])

  let GROUP_ISOMORPHISMS_PAIRED2 ← prove
   r"!(f:A->B) (g:C->D) f' g' G H G' H'.
          group_isomorphisms(prod_group G H,prod_group G' H')
                  ((\(x,y). f x,g y),(\(x,y). f' x,g' y)) <=>
          group_isomorphisms(G,G') (f,f') /\
          group_isomorphisms(H,H') (g,g')"
   (REWRITE_TAC [group_isomorphisms, GROUP_HOMOMORPHISM_PAIRED2] THEN
    REWRITE_TAC [PROD_GROUP, FORALL_IN_CROSS, PAIR_EQ] THEN
    MESON_TAC [GROUP_ID])

  let GROUP_ISOMORPHISM_PAIRED2 ← prove
   r"!(f:A->B) (g:C->D) G H G' H'.
          group_isomorphism(prod_group G H,prod_group G' H')
                  (\(x,y). f x,g y) <=>
          group_isomorphism(G,G') f /\ group_isomorphism(H,H') g"
   (REWRITE_TAC [GROUP_ISOMORPHISM, GROUP_HOMOMORPHISM_PAIRED2] THEN
    REWRITE_TAC [PROD_GROUP, FORALL_PAIR_THM, IN_CROSS, IMAGE_PAIRED_CROSS] THEN
    REWRITE_TAC [CROSS_EQ, IMAGE_EQ_EMPTY, GROUP_CARRIER_NONEMPTY, PAIR_EQ] THEN
    MESON_TAC [GROUP_ID])

  let GROUP_HOMOMORPHISM_OF_FST ← prove
   r"!(f:A->C) A (B:B group) C.
          group_homomorphism (prod_group A B,C) (f o FST) <=>
          group_homomorphism (A,C) f"
   (REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE, PROD_GROUP] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, o_DEF] THEN MESON_TAC [GROUP_ID])

  let GROUP_HOMOMORPHISM_OF_SND ← prove
   r"!(f:B->C) (A:A group) B C.
          group_homomorphism (prod_group A B,C) (f o SND) <=>
          group_homomorphism (B,C) f"
   (REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE, PROD_GROUP] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, o_DEF] THEN MESON_TAC [GROUP_ID])

  let GROUP_EPIMORPHISM_OF_FST ← prove
   r"!(f:A->C) A (B:B group) C.
          group_epimorphism (prod_group A B,C) (f o FST) <=>
          group_epimorphism (A,C) f"
   (REWRITE_TAC [group_epimorphism, GROUP_HOMOMORPHISM_OF_FST] THEN
    REWRITE_TAC [PROD_GROUP, IMAGE_o, IMAGE_FST_CROSS, GROUP_CARRIER_NONEMPTY])

  let GROUP_EPIMORPHISM_OF_SND ← prove
   r"!(f:B->C) (A:A group) B C.
          group_epimorphism (prod_group A B,C) (f o SND) <=>
          group_epimorphism (B,C) f"
   (REWRITE_TAC [group_epimorphism, GROUP_HOMOMORPHISM_OF_SND] THEN
    REWRITE_TAC [PROD_GROUP, IMAGE_o, IMAGE_SND_CROSS, GROUP_CARRIER_NONEMPTY])

  let GROUP_HOMOMORPHISM_FST ← prove
   r"!(A:A group) (B:B group). group_homomorphism (prod_group A B,A) FST"
   (REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE, PROD_GROUP] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, o_DEF] THEN MESON_TAC [GROUP_ID])

  let GROUP_HOMOMORPHISM_SND ← prove
   r"!(A:A group) (B:B group). group_homomorphism (prod_group A B,B) SND"
   (REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE, PROD_GROUP] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, o_DEF] THEN MESON_TAC [GROUP_ID])

  let GROUP_EPIMORPHISM_FST ← prove
   r"!(A:A group) (B:B group). group_epimorphism (prod_group A B,A) FST"
   (REWRITE_TAC [group_epimorphism, GROUP_HOMOMORPHISM_FST] THEN
    REWRITE_TAC [PROD_GROUP, IMAGE_o, IMAGE_FST_CROSS, GROUP_CARRIER_NONEMPTY])

  let GROUP_EPIMORPHISM_SND ← prove
   r"!(A:A group) (B:B group). group_epimorphism (prod_group A B,B) SND"
   (REWRITE_TAC [group_epimorphism, GROUP_HOMOMORPHISM_SND] THEN
    REWRITE_TAC [PROD_GROUP, IMAGE_o, IMAGE_SND_CROSS, GROUP_CARRIER_NONEMPTY])

  let GROUP_ISOMORPHISM_FST ← prove
   r"!(G:A group) (H:B group).
          group_isomorphism (prod_group G H,G) FST <=> trivial_group H"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    REWRITE_TAC [GROUP_EPIMORPHISM_FST] THEN
    REWRITE_TAC [group_monomorphism, GROUP_HOMOMORPHISM_FST] THEN
    SIMP_TAC [FORALL_PAIR_THM, PROD_GROUP, IN_CROSS, PAIR_EQ] THEN
    REWRITE_TAC [TRIVIAL_GROUP_ALT] THEN
    MP_TAC (← ISPEC (← q "G:A group") GROUP_CARRIER_NONEMPTY) THEN SET_TAC [])

  let GROUP_ISOMORPHISM_SND ← prove
   r"!(G:A group) (H:B group).
          group_isomorphism (prod_group G H,H) SND <=> trivial_group G"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    REWRITE_TAC [GROUP_EPIMORPHISM_SND] THEN
    REWRITE_TAC [group_monomorphism, GROUP_HOMOMORPHISM_SND] THEN
    SIMP_TAC [FORALL_PAIR_THM, PROD_GROUP, IN_CROSS, PAIR_EQ] THEN
    REWRITE_TAC [TRIVIAL_GROUP_ALT] THEN
    MP_TAC (← ISPEC (← q "H:B group") GROUP_CARRIER_NONEMPTY) THEN SET_TAC [])

  let GROUP_ISOMORPHISMS_PROD_GROUP_SWAP ← prove
   r"!(G:A group) (H:B group).
          group_isomorphisms (prod_group G H,prod_group H G)
                             ((\(x,y). y,x),(\(y,x). x,y))"
   (← do
    let a2 ← REWRITE_RULE [o_DEF] GROUP_HOMOMORPHISM_OF_SND
    let a1 ← REWRITE_RULE [o_DEF] GROUP_HOMOMORPHISM_OF_FST
    pure (REWRITE_TAC [group_isomorphisms, FORALL_PAIR_THM] THEN
     REWRITE_TAC [GROUP_HOMOMORPHISM_PAIRWISE, o_DEF, LAMBDA_PAIR] THEN
     REWRITE_TAC [a1, a2] THEN
     REWRITE_TAC [GROUP_HOMOMORPHISM_ID]))

  -- @@RETURN BEGIN
  return { CARD_EQ_GROUP_ISOMORPHIC_IMAGE, FINITE_GROUP_MONOMORPHIC_PREIMAGE,
           FINITE_GROUP_EPIMORPHIC_IMAGE, CARD_EQ_GROUP_MONOMORPHIC_IMAGE,
           GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS,
           GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS_ALT, GROUP_ISOMORPHISM_BETWEEN_SUBGROUPS,
           GROUP_ISOMORPHISMS_COMPOSE, GROUP_ISOMORPHISM_COMPOSE,
           GROUP_ISOMORPHISM_COMPOSE_REV, GROUP_EPIMORPHISM_ISOMORPHISM_COMPOSE_REV,
           GROUP_MONOMORPHISM_ISOMORPHISM_COMPOSE_REV, GROUP_ISOMORPHISM_INVERSE,
           GROUP_ISOMORPHISMS_OPPOSITE_GROUP, GROUP_ISOMORPHISM_OPPOSITE_GROUP,
           GROUP_HOMOMORPHISM_FROM_TRIVIAL_GROUP, GROUP_MONOMORPHISM_FROM_TRIVIAL_GROUP,
           GROUP_MONOMORPHISM_TO_TRIVIAL_GROUP, GROUP_EPIMORPHISM_FROM_TRIVIAL_GROUP,
           GROUP_EPIMORPHISM_TO_TRIVIAL_GROUP, GROUP_HOMOMORPHISM_PAIRWISE,
           GROUP_HOMOMORPHISM_PAIRED, GROUP_HOMOMORPHISM_PAIRED2,
           GROUP_ISOMORPHISMS_PAIRED2, GROUP_ISOMORPHISM_PAIRED2,
           GROUP_HOMOMORPHISM_OF_FST, GROUP_HOMOMORPHISM_OF_SND,
           GROUP_EPIMORPHISM_OF_FST, GROUP_EPIMORPHISM_OF_SND, GROUP_HOMOMORPHISM_FST,
           GROUP_HOMOMORPHISM_SND, GROUP_EPIMORPHISM_FST, GROUP_EPIMORPHISM_SND,
           GROUP_ISOMORPHISM_FST, GROUP_ISOMORPHISM_SND,
           GROUP_ISOMORPHISMS_PROD_GROUP_SWAP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Homomorphisms: componentwise/product/sum groups, projections, injections, -/
/- and abelian-group homomorphisms.  (grouptheory.ml 3958-4179)              -/
/- ------------------------------------------------------------------------- -/

structure Homomorphisms4 where
  -- @@FIELDS
  GROUP_HOMOMORPHISM_COMPONENTWISE : thm
  GROUP_HOMOMORPHISM_COMPONENTWISE_UNIV : thm
  GROUP_HOMOMORPHISM_PRODUCT_PROJECTION : thm
  GROUP_HOMOMORPHISM_SUM_PROJECTION : thm
  GROUP_HOMOMORPHISM_PRODUCT_INJECTION : thm
  GROUP_HOMOMORPHISM_SUM_INJECTION : thm
  GROUP_HOMOMORPHISM_PRODUCT : thm
  GROUP_HOMOMORPHISM_SUM : thm
  GROUP_EPIMORPHISM_PRODUCT_PROJECTION : thm
  GROUP_ISOMORPHISM_PRODUCT_PROJECTION : thm
  GROUP_EPIMORPHISM_SUM_PROJECTION : thm
  GROUP_ISOMORPHISM_SUM_PROJECTION : thm
  ABELIAN_GROUP_EPIMORPHIC_IMAGE : thm
  ABELIAN_GROUP_HOMOMORPHISM_GROUP_MUL : thm
  ABELIAN_GROUP_HOMOMORPHISM_INVERSION : thm
  ABELIAN_GROUP_ISOMORPHISMS_INVERSION : thm
  ABELIAN_GROUP_ISOMORPHISM_INVERSION : thm
  ABELIAN_GROUP_MONOMORPHISM_INVERSION : thm
  ABELIAN_GROUP_EPIMORPHISM_INVERSION : thm
  ABELIAN_GROUP_HOMOMORPHISM_POWERING : thm
  ABELIAN_GROUP_HOMOMORPHISM_ZPOWERING : thm
  deriving Inhabited

@[nospecialize]
def setupHomomorphisms4 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BProductGroup : ProductGroup) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) :
    ExceptT String IO Homomorphisms4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CARTESIAN_PRODUCT_AS_RESTRICTIONS, CARTESIAN_PRODUCT_EQ_EMPTY, .. } := D.core1
  let { CONTRAPOS_THM, .. } := D.core2
  let { EXTENSIONAL_UNIV, FINITE_SING, FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FORALL_IN_IMAGE_2, .. } := D.core3
  let { IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMP_CONJ, IMP_CONJ_ALT, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_ELIM_THM, IN_IMAGE, IN_SING, IN_UNIV, .. } := D.core5
  let { RESTRICTION, RESTRICTION_EXTENSION, .. } := D.core6
  let { RESTRICTION_IN_CARTESIAN_PRODUCT, RESTRICTION_IN_EXTENSIONAL,
        RESTRICTION_UNIQUE_ALT, RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { GROUP_CARRIER_NONEMPTY, GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_LID, .. } := BBasics
  let { FORALL_IN_GROUP_CARRIER_INV, GROUP_INV_INV, GROUP_INV_MUL, GROUP_POW, .. } := BDerived
  let { GROUP_ZPOW, .. } := BPow
  let { ABELIAN_GROUP_MUL_AC, ABELIAN_GROUP_MUL_POW, ABELIAN_GROUP_MUL_ZPOW,
        abelian_group, .. } := BAbelian
  let { PRODUCT_GROUP, .. } := BProductGroup
  let { SUM_GROUP_ALT, SUM_GROUP_CLAUSES, sum_group, .. } := BSumGroup
  let { GROUP_EPIMORPHISM_SUBSET, GROUP_HOMOMORPHISM, GROUP_HOMOMORPHISM_EQ,
        GROUP_HOMOMORPHISM_OF_ID, GROUP_ISOMORPHISMS, group_epimorphism,
        group_homomorphism, group_isomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS, GROUP_HOMOMORPHISM_COMPOSE,
        GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED, GROUP_HOMOMORPHISM_ID,
        GROUP_HOMOMORPHISM_INTO_SUBGROUP, GROUP_HOMOMORPHISM_TRIVIAL, .. } := BHomomorphisms1
  let { GROUP_EPIMORPHISM_IMP_HOMOMORPHISM, GROUP_ISOMORPHISM_EPIMORPHISM,
        GROUP_ISOMORPHISM_IMP_EPIMORPHISM, GROUP_ISOMORPHISM_IMP_HOMOMORPHISM,
        GROUP_ISOMORPHISM_IMP_MONOMORPHISM, GROUP_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := BHomomorphisms2
  -- @@SCOPE END

  let GROUP_HOMOMORPHISM_COMPONENTWISE ← prove
   r"!G k H (f:A->K->B).
          group_homomorphism(G,product_group k H) f <=>
          IMAGE f (group_carrier G) SUBSET EXTENSIONAL k /\
          !i. i IN k ==> group_homomorphism (G,H i) (\x. f x i)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [PRODUCT_GROUP, IN_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [RESTRICTION_UNIQUE_ALT] THEN
    REWRITE_TAC [← SET_RULE (← q r"f IN EXTENSIONAL s <=> EXTENSIONAL s f")] THEN
    ASM_CASES_TAC
     (← q r"!x. x IN group_carrier G ==> EXTENSIONAL k ((f:A->K->B) x)")
    THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    ASM_SIMP_TAC [GROUP_ID, GROUP_INV, GROUP_MUL] THEN
    MESON_TAC [])

  let GROUP_HOMOMORPHISM_COMPONENTWISE_UNIV ← prove
   r"!G H (f:A->K->B).
          group_homomorphism(G,product_group (:K) H) f <=>
          !i. group_homomorphism (G,H i) (\x. f x i)"
   (REWRITE_TAC [GROUP_HOMOMORPHISM_COMPONENTWISE, IN_UNIV] THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET P <=> !x. x IN s ==> P x")] THEN
    REWRITE_TAC [EXTENSIONAL_UNIV])

  let GROUP_HOMOMORPHISM_PRODUCT_PROJECTION ← prove
   r"!(G:K->A group) k i.
          i IN k ==> group_homomorphism (product_group k G,G i) (\x. x i)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"product_group k (G:K->A group)", ← q r"k:K->bool",
                   ← q r"G:K->A group", ← q r"\x:K->A. x"]
          GROUP_HOMOMORPHISM_COMPONENTWISE) THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_ID] THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_COMPONENTWISE])

  let GROUP_HOMOMORPHISM_SUM_PROJECTION ← prove
   r"!(G:K->A group) k i.
          i IN k ==> group_homomorphism (sum_group k G,G i) (\x. x i)"
   (REWRITE_TAC [sum_group] THEN
    SIMP_TAC [GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED,
             GROUP_HOMOMORPHISM_PRODUCT_PROJECTION])

  let GROUP_HOMOMORPHISM_PRODUCT_INJECTION ← prove
   r"!k (G:K->A group) i.
          group_homomorphism
            (G i,product_group k G)
            (\a. RESTRICTION k (\j. if j = i then a else group_id(G j)))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [GROUP_HOMOMORPHISM_COMPONENTWISE] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
    X_GEN_TAC (← q r"j:K") THEN DISCH_TAC THEN ASM_REWRITE_TAC [RESTRICTION] THEN
    ASM_CASES_TAC (← q r"j:K = i") THEN
    ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_ID, GROUP_HOMOMORPHISM_TRIVIAL])

  let GROUP_HOMOMORPHISM_SUM_INJECTION ← prove
   r"!k (G:K->A group) i.
          group_homomorphism
            (G i,sum_group k G)
            (\a. RESTRICTION k (\j. if j = i then a else group_id(G j)))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SUM_GROUP_ALT] THEN
    MATCH_MP_TAC GROUP_HOMOMORPHISM_INTO_SUBGROUP THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_PRODUCT_INJECTION] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC (← q r"{i:K}") THEN REWRITE_TAC [FINITE_SING] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_SING, RESTRICTION] THEN
    SET_TAC [])

  let GROUP_HOMOMORPHISM_PRODUCT ← prove
   r"!(f:K->A->B) k G H.
          group_homomorphism (product_group k G,product_group k H)
                             (\x. RESTRICTION k (\i. (f i) (x i))) <=>
          !i. i IN k ==> group_homomorphism(G i,H i) (f i)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC GROUP_HOMOMORPHISM_EQ THEN
      EXISTS_TAC
       (← q r"(\x. x i) o (\x. RESTRICTION k (\i. ((f:K->A->B) i) (x i))) o
        (\x. RESTRICTION k (\j. if j = i then x else group_id(G j)))") THEN
      ASM_REWRITE_TAC [o_THM, RESTRICTION] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"product_group k (H:K->B group)") THEN
      ASM_SIMP_TAC [GROUP_HOMOMORPHISM_PRODUCT_PROJECTION] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"product_group k (G:K->A group)") THEN
      ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_PRODUCT_INJECTION],
      REWRITE_TAC [GROUP_HOMOMORPHISM_COMPONENTWISE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
      X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN ASM_REWRITE_TAC [RESTRICTION] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_EQ THEN
      EXISTS_TAC (← q r"(f:K->A->B) i o (\x. x i)") THEN REWRITE_TAC [o_THM] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"(G:K->A group) i") THEN
      ASM_SIMP_TAC [GROUP_HOMOMORPHISM_PRODUCT_PROJECTION]])

  let GROUP_HOMOMORPHISM_SUM ← prove
   r"!(f:K->A->B) k G H.
          group_homomorphism (sum_group k G,sum_group k H)
                             (\x. RESTRICTION k (\i. (f i) (x i))) <=>
          !i. i IN k ==> group_homomorphism(G i,H i) (f i)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC GROUP_HOMOMORPHISM_EQ THEN
      EXISTS_TAC
       (← q r"(\x. x i) o (\x. RESTRICTION k (\i. ((f:K->A->B) i) (x i))) o
        (\x. RESTRICTION k (\j. if j = i then x else group_id(G j)))") THEN
      ASM_REWRITE_TAC [o_THM, RESTRICTION] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"sum_group k (H:K->B group)") THEN
      ASM_SIMP_TAC [GROUP_HOMOMORPHISM_SUM_PROJECTION] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"sum_group k (G:K->A group)") THEN
      ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_SUM_INJECTION],
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [SUM_GROUP_ALT] THEN
      REWRITE_TAC [sum_group] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_BETWEEN_SUBGROUPS THEN
      ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_PRODUCT] THEN
      GEN_REWRITE_TAC I [SUBSET] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      GEN_TAC THEN REWRITE_TAC [IN_CARTESIAN_PRODUCT] THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
      REWRITE_TAC [SUBSET, RESTRICTION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"i:K") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_REWRITE_TAC [CONTRAPOS_THM] THEN
      ASM_MESON_TAC [GROUP_HOMOMORPHISM_OF_ID]])

  let GROUP_EPIMORPHISM_PRODUCT_PROJECTION ← prove
   r"!(G:K->A group) k i.
          i IN k ==> group_epimorphism (product_group k G,G i) (\x. x i)"
   (SIMP_TAC [group_epimorphism, GROUP_HOMOMORPHISM_PRODUCT_PROJECTION] THEN
    SIMP_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT, PRODUCT_GROUP,
             CARTESIAN_PRODUCT_EQ_EMPTY, GROUP_CARRIER_NONEMPTY])

  let GROUP_ISOMORPHISM_PRODUCT_PROJECTION ← prove
   r"!G k. group_isomorphism (product_group {k} G,G k) (\x. x k)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [GROUP_ISOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [GROUP_EPIMORPHISM_PRODUCT_PROJECTION, IN_SING] THEN
    REWRITE_TAC [PRODUCT_GROUP, CARTESIAN_PRODUCT_AS_RESTRICTIONS] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [RESTRICTION_EXTENSION, RESTRICTION, IN_SING] THEN MESON_TAC [])

  let GROUP_EPIMORPHISM_SUM_PROJECTION ← prove
   r"!(G:K->A group) k i.
          i IN k ==> group_epimorphism (sum_group k G,G i) (\x. x i)"
   (SIMP_TAC [GROUP_EPIMORPHISM_SUBSET, GROUP_HOMOMORPHISM_SUM_PROJECTION] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [SUBSET, IN_IMAGE, SUM_GROUP_CLAUSES] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"RESTRICTION k (\j:K. if j = i then x:A else group_id(G j))") THEN
    REWRITE_TAC [IN_ELIM_THM, RESTRICTION_IN_CARTESIAN_PRODUCT] THEN
    ASM_REWRITE_TAC [RESTRICTION] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [GROUP_ID], ALL_TAC] THEN
    MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{i:K}") THEN
    REWRITE_TAC [FINITE_SING] THEN SET_TAC [])

  let GROUP_ISOMORPHISM_SUM_PROJECTION ← prove
   r"!G k. group_isomorphism (sum_group {k} G,G k) (\x. x k)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [GROUP_ISOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [GROUP_EPIMORPHISM_SUM_PROJECTION, IN_SING] THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, CARTESIAN_PRODUCT_AS_RESTRICTIONS] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [RESTRICTION_EXTENSION, RESTRICTION, IN_SING] THEN MESON_TAC [])

  let ABELIAN_GROUP_EPIMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
       group_epimorphism(G,H) f /\ abelian_group G ==> abelian_group H"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [group_epimorphism, group_homomorphism, abelian_group] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE_2] THEN ASM SET_TAC [])

  let ABELIAN_GROUP_HOMOMORPHISM_GROUP_MUL ← prove
   r"!(f:A->B) g A B.
          abelian_group B /\
          group_homomorphism(A,B) f /\ group_homomorphism(A,B) g
          ==> group_homomorphism(A,B) (\x. group_mul B (f x) (g x))"
   (REWRITE_TAC [group_homomorphism, ABELIAN_GROUP_MUL_AC] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    SIMP_TAC [GROUP_MUL_LID, GROUP_ID, GROUP_MUL, GROUP_INV_MUL, GROUP_INV])

  let ABELIAN_GROUP_HOMOMORPHISM_INVERSION ← prove
   r"!G:A group. group_homomorphism (G,G) (group_inv G) <=> abelian_group G"
   (REWRITE_TAC [GROUP_HOMOMORPHISM, SUBSET, FORALL_IN_IMAGE, GROUP_INV] THEN
    SIMP_TAC [GROUP_INV_MUL, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GROUP_CARRIER_INV, abelian_group] THEN MESON_TAC [])

  let ABELIAN_GROUP_ISOMORPHISMS_INVERSION ← prove
   r"!G:A group. group_isomorphisms (G,G) (group_inv G,group_inv G) <=>
                 abelian_group G"
   (SIMP_TAC [GROUP_ISOMORPHISMS, ABELIAN_GROUP_HOMOMORPHISM_INVERSION] THEN
    SIMP_TAC [GROUP_INV_INV, GROUP_INV])

  let ABELIAN_GROUP_ISOMORPHISM_INVERSION ← prove
   r"!G:A group. group_isomorphism (G,G) (group_inv G) <=> abelian_group G"
   (GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [GROUP_ISOMORPHISM_IMP_HOMOMORPHISM,
                ABELIAN_GROUP_HOMOMORPHISM_INVERSION],
      MESON_TAC [ABELIAN_GROUP_ISOMORPHISMS_INVERSION, group_isomorphism]])

  let ABELIAN_GROUP_MONOMORPHISM_INVERSION ← prove
   r"!G:A group. group_monomorphism (G,G) (group_inv G) <=> abelian_group G"
   (MESON_TAC [GROUP_ISOMORPHISM_IMP_MONOMORPHISM,
              GROUP_MONOMORPHISM_IMP_HOMOMORPHISM,
              ABELIAN_GROUP_HOMOMORPHISM_INVERSION,
              ABELIAN_GROUP_ISOMORPHISM_INVERSION])

  let ABELIAN_GROUP_EPIMORPHISM_INVERSION ← prove
   r"!G:A group. group_epimorphism (G,G) (group_inv G) <=> abelian_group G"
   (MESON_TAC [GROUP_ISOMORPHISM_IMP_EPIMORPHISM,
              GROUP_EPIMORPHISM_IMP_HOMOMORPHISM,
              ABELIAN_GROUP_HOMOMORPHISM_INVERSION,
              ABELIAN_GROUP_ISOMORPHISM_INVERSION])

  let ABELIAN_GROUP_HOMOMORPHISM_POWERING ← prove
   r"!(G:A group) n.
          abelian_group G ==> group_homomorphism(G,G) (\x. group_pow G x n)"
   (REWRITE_TAC [GROUP_HOMOMORPHISM, SUBSET, FORALL_IN_IMAGE, GROUP_POW] THEN
    SIMP_TAC [ABELIAN_GROUP_MUL_POW])

  let ABELIAN_GROUP_HOMOMORPHISM_ZPOWERING ← prove
   r"!(G:A group) n.
          abelian_group G ==> group_homomorphism(G,G) (\x. group_zpow G x n)"
   (REWRITE_TAC [GROUP_HOMOMORPHISM, SUBSET, FORALL_IN_IMAGE, GROUP_ZPOW] THEN
    SIMP_TAC [ABELIAN_GROUP_MUL_ZPOW])

  -- @@RETURN BEGIN
  return { GROUP_HOMOMORPHISM_COMPONENTWISE, GROUP_HOMOMORPHISM_COMPONENTWISE_UNIV,
           GROUP_HOMOMORPHISM_PRODUCT_PROJECTION, GROUP_HOMOMORPHISM_SUM_PROJECTION,
           GROUP_HOMOMORPHISM_PRODUCT_INJECTION, GROUP_HOMOMORPHISM_SUM_INJECTION,
           GROUP_HOMOMORPHISM_PRODUCT, GROUP_HOMOMORPHISM_SUM,
           GROUP_EPIMORPHISM_PRODUCT_PROJECTION, GROUP_ISOMORPHISM_PRODUCT_PROJECTION,
           GROUP_EPIMORPHISM_SUM_PROJECTION, GROUP_ISOMORPHISM_SUM_PROJECTION,
           ABELIAN_GROUP_EPIMORPHIC_IMAGE, ABELIAN_GROUP_HOMOMORPHISM_GROUP_MUL,
           ABELIAN_GROUP_HOMOMORPHISM_INVERSION, ABELIAN_GROUP_ISOMORPHISMS_INVERSION,
           ABELIAN_GROUP_ISOMORPHISM_INVERSION, ABELIAN_GROUP_MONOMORPHISM_INVERSION,
           ABELIAN_GROUP_EPIMORPHISM_INVERSION, ABELIAN_GROUP_HOMOMORPHISM_POWERING,
           ABELIAN_GROUP_HOMOMORPHISM_ZPOWERING }
  -- @@RETURN END

/-- `CONV_TAC o GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV ss lev`, as a function of
    the theorem list (used with `ASM`); `ss` is evaluated by the caller, as
    OCaml evaluates `basic_ss []` when it builds the tactic. -/
def simpTac [HolBase] (ss : HolCore.Simp.simpset) (lev : Int) (ths : List thm) : tactic :=
  fun g => do
    match ← HolCore.Simp.GEN_SIMPLIFY_CONV HolBase.B (HolCore.Simp.TOP_DEPTH_SQCONV HolBase.B)
        ss lev ths with
    | .ok c => CONV_TAC c g
    | .error e => pure (.error e)

/- ------------------------------------------------------------------------- -/
/- Relation of isomorphism.  (grouptheory.ml 4184-4395)                      -/
/- ------------------------------------------------------------------------- -/

structure Iso1 where
  -- @@FIELDS
  isomorphic_group : thm
  GROUP_ISOMORPHISM_IMP_ISOMORPHIC : thm
  ISOMORPHIC_PRODUCT_GROUP_SING : thm
  ISOMORPHIC_SUM_GROUP_SING : thm
  ISOMORPHIC_GROUP_REFL : thm
  ISOMORPHIC_GROUP_SYM : thm
  ISOMORPHIC_GROUP_TRANS : thm
  ISOMORPHIC_GROUP_OPPOSITE_GROUP : thm
  ISOMORPHIC_GROUP_TRIVIALITY : thm
  ISOMORPHIC_TO_TRIVIAL_GROUP : thm
  ISOMORPHIC_TRIVIAL_GROUPS : thm
  ISOMORPHIC_GROUP_SINGLETON_GROUP : thm
  ISOMORPHIC_GROUP_PROD_GROUPS : thm
  ISOMORPHIC_GROUP_PROD_GROUP_SYM : thm
  ISOMORPHIC_GROUP_PROD_GROUP_SWAP_LEFT : thm
  ISOMORPHIC_GROUP_PROD_GROUP_SWAP_RIGHT : thm
  ISOMORPHIC_PROD_TRIVIAL_GROUP : thm
  ISOMORPHIC_PRODUCT_GROUP_SUPPORT : thm
  ISOMORPHIC_PRODUCT_GROUP_SYMDIFF : thm
  ISOMORPHIC_SUM_GROUP_SUPPORT : thm
  ISOMORPHIC_SUM_GROUP_SYMDIFF : thm
  deriving Inhabited

@[nospecialize]
def setupIso1 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BProductGroup : ProductGroup) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms3 : Homomorphisms3) (BHomomorphisms4 : Homomorphisms4) :
    ExceptT String IO Iso1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, new_definition, parse_as_infix, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { EXTENSIONAL, FINITE_SUBSET, FORALL_IN_IMAGE, .. } := D.core3
  let { IMAGE_CLAUSES, IMP_CONJ, IMP_CONJ_ALT, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_ELIM_THM, IN_SING, .. } := D.core5
  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, RESTRICTION, .. } := D.core6
  let { RESTRICTION_IN_CARTESIAN_PRODUCT, RESTRICTION_IN_EXTENSIONAL,
        RESTRICTION_UNIQUE, RIGHT_AND_EXISTS_THM, SUBSET, SUBSET_REFL, .. } := D.core7
  let { GROUP_ID, GROUP_INV, GROUP_MUL, TRIVIAL_GROUP, TRIVIAL_GROUP_SINGLETON_GROUP,
        trivial_group, .. } := BBasics
  let { PRODUCT_GROUP, .. } := BProductGroup
  let { SUM_GROUP_ALT, .. } := BSumGroup
  let { GROUP_ISOMORPHISMS, GROUP_ISOMORPHISMS_SYM, group_homomorphism,
        group_isomorphism, group_isomorphisms, .. } := BHomomorphisms
  let { GROUP_ISOMORPHISM_ID, .. } := BHomomorphisms1
  let { GROUP_ISOMORPHISM, .. } := BHomomorphisms2
  let { GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS, GROUP_ISOMORPHISMS_OPPOSITE_GROUP,
        GROUP_ISOMORPHISMS_PAIRED2, GROUP_ISOMORPHISMS_PROD_GROUP_SWAP,
        GROUP_ISOMORPHISM_COMPOSE, GROUP_ISOMORPHISM_SND, .. } := BHomomorphisms3
  let { GROUP_HOMOMORPHISM_COMPONENTWISE, GROUP_HOMOMORPHISM_PRODUCT_PROJECTION,
        GROUP_ISOMORPHISM_PRODUCT_PROJECTION, GROUP_ISOMORPHISM_SUM_PROJECTION, .. } := BHomomorphisms4
  -- @@SCOPE END

  parse_as_infix ("isomorphic_group", (12, "right"))

  let isomorphic_group ← new_definition
   r"G isomorphic_group G' <=> ?f:A->B. group_isomorphism (G,G') f"

  let GROUP_ISOMORPHISM_IMP_ISOMORPHIC ← prove
   r"!G H f:A->B. group_isomorphism (G,H) f ==> G isomorphic_group H"
   (REWRITE_TAC [isomorphic_group] THEN MESON_TAC [])

  let ISOMORPHIC_PRODUCT_GROUP_SING ← prove
   r"!(G:K->A group) k. product_group {k} G isomorphic_group G k"
   (REWRITE_TAC [isomorphic_group] THEN
    MESON_TAC [GROUP_ISOMORPHISM_PRODUCT_PROJECTION])

  let ISOMORPHIC_SUM_GROUP_SING ← prove
   r"!(G:K->A group) k. sum_group {k} G isomorphic_group G k"
   (REWRITE_TAC [isomorphic_group] THEN
    MESON_TAC [GROUP_ISOMORPHISM_SUM_PROJECTION])

  let ISOMORPHIC_GROUP_REFL ← prove
   r"!G:A group. G isomorphic_group G"
   (GEN_TAC THEN REWRITE_TAC [isomorphic_group] THEN EXISTS_TAC (← q r"\x:A. x") THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_ID])

  let ISOMORPHIC_GROUP_SYM ← prove
   r"!(G:A group) (H:B group). G isomorphic_group H <=> H isomorphic_group G"
   (REWRITE_TAC [isomorphic_group, group_isomorphism] THEN
    MESON_TAC [GROUP_ISOMORPHISMS_SYM])

  let ISOMORPHIC_GROUP_TRANS ← prove
   r"!(G1:A group) (G2:B group) (G3:C group).
        G1 isomorphic_group G2 /\ G2 isomorphic_group G3
        ==> G1 isomorphic_group G3"
   (REWRITE_TAC [isomorphic_group] THEN MESON_TAC [GROUP_ISOMORPHISM_COMPOSE])

  let ISOMORPHIC_GROUP_OPPOSITE_GROUP ← prove
   r"!G:A group. (opposite_group G) isomorphic_group G"
   (ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    REWRITE_TAC [isomorphic_group, group_isomorphism] THEN
    MESON_TAC [GROUP_ISOMORPHISMS_OPPOSITE_GROUP])

  let ISOMORPHIC_GROUP_TRIVIALITY ← prove
   r"!(G:A group) (H:B group).
        G isomorphic_group H ==> (trivial_group G <=> trivial_group H)"
   (REWRITE_TAC [isomorphic_group, TRIVIAL_GROUP, group_isomorphism,
                group_isomorphisms, group_homomorphism] THEN
    SET_TAC [])

  let ISOMORPHIC_TO_TRIVIAL_GROUP ← prove
   r"(!(G:A group) (H:B group).
        trivial_group G ==> (G isomorphic_group H <=> trivial_group H)) /\
   (!(G:A group) (H:B group).
        trivial_group H ==> (G isomorphic_group H <=> trivial_group G))"
   (← do
    let lemma ← prove
     r"!(G:A group) (H:B group).
        trivial_group G ==> (G isomorphic_group H <=> trivial_group H)"
     (REPEAT STRIP_TAC THEN EQ_TAC THENL
       [ASM_MESON_TAC [ISOMORPHIC_GROUP_TRIVIALITY], ALL_TAC] THEN
      POP_ASSUM MP_TAC THEN
      REWRITE_TAC [TRIVIAL_GROUP, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
      X_GEN_TAC (← q "b:B") THEN DISCH_TAC THEN
      REWRITE_TAC [isomorphic_group, GROUP_ISOMORPHISM] THEN
      EXISTS_TAC (← q r"(\x. b):A->B") THEN
      ASM_REWRITE_TAC [group_homomorphism] THEN
      SIMP_TAC [IN_SING, IMAGE_CLAUSES, SUBSET_REFL] THEN
      ASM_MESON_TAC [GROUP_ID, GROUP_INV, GROUP_MUL, IN_SING])
    pure (REWRITE_TAC [lemma] THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [lemma]))

  let ISOMORPHIC_TRIVIAL_GROUPS ← prove
   r"!(G:A group) (H:B group).
        trivial_group G /\ trivial_group H
        ==> G isomorphic_group H"
   (MESON_TAC [ISOMORPHIC_TO_TRIVIAL_GROUP])

  let ISOMORPHIC_GROUP_SINGLETON_GROUP ← prove
   r"(!(G:A group) (b:B).
        G isomorphic_group singleton_group b <=> trivial_group G) /\
   (!a:A (G:B group).
        singleton_group a isomorphic_group G <=> trivial_group G)"
   (MESON_TAC [ISOMORPHIC_TO_TRIVIAL_GROUP, TRIVIAL_GROUP_SINGLETON_GROUP])

  let ISOMORPHIC_GROUP_PROD_GROUPS ← prove
   r"!(G:A group) (G':B group) (H:C group) (H':D group).
        G isomorphic_group G' /\ H isomorphic_group H'
        ==> (prod_group G H) isomorphic_group (prod_group G' H')"
   (REWRITE_TAC [isomorphic_group, group_isomorphism, RIGHT_AND_EXISTS_THM] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [← GSYM GROUP_ISOMORPHISMS_PAIRED2] THEN MESON_TAC [])

  let ISOMORPHIC_GROUP_PROD_GROUP_SYM ← prove
   r"!(G:A group) (H:B group).
        prod_group G H isomorphic_group prod_group H G"
   (REWRITE_TAC [isomorphic_group, group_isomorphism] THEN
    MESON_TAC [GROUP_ISOMORPHISMS_PROD_GROUP_SWAP])

  let ISOMORPHIC_GROUP_PROD_GROUP_SWAP_LEFT ← prove
   r"!(G:A group) (H:B group) (K:C group).
        prod_group G H isomorphic_group K <=>
        prod_group H G isomorphic_group K"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] ISOMORPHIC_GROUP_TRANS) THEN
    REWRITE_TAC [ISOMORPHIC_GROUP_PROD_GROUP_SYM])

  let ISOMORPHIC_GROUP_PROD_GROUP_SWAP_RIGHT ← prove
   r"!(G:A group) (H:B group) (K:C group).
        G isomorphic_group prod_group H K <=>
        G isomorphic_group prod_group K H"
   (ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    REWRITE_TAC [ISOMORPHIC_GROUP_PROD_GROUP_SWAP_LEFT])

  let ISOMORPHIC_PROD_TRIVIAL_GROUP ← prove
   r"(!(G:A group) (H:B group).
        trivial_group G ==> (prod_group G H isomorphic_group H)) /\
   (!(G:A group) (H:B group).
        trivial_group H ==> (prod_group G H isomorphic_group G)) /\
   (!(G:A group) (H:B group).
        trivial_group G ==> (H isomorphic_group prod_group G H)) /\
   (!(G:A group) (H:B group).
        trivial_group H ==> (G isomorphic_group prod_group G H))"
   (← do
    let lemma ← prove
     r"!(G:A group) (H:B group).
        trivial_group G ==> (prod_group G H isomorphic_group H)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [isomorphic_group] THEN
      EXISTS_TAC (← q r"SND:A#B->B") THEN ASM_REWRITE_TAC [GROUP_ISOMORPHISM_SND])
    pure (GEN_REWRITE_TAC I [CONJ_ASSOC] THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [] THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
       [ISOMORPHIC_GROUP_PROD_GROUP_SWAP_LEFT] THEN
      REWRITE_TAC [lemma]))

  let ISOMORPHIC_PRODUCT_GROUP_SUPPORT ← prove
   r"!k (G:K->A group).
        product_group {i | i IN k /\ ~trivial_group(G i)} G isomorphic_group
        product_group k G"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    REWRITE_TAC [isomorphic_group, group_isomorphism, GROUP_ISOMORPHISMS] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x:K->A. RESTRICTION {i | i IN k /\ ~trivial_group((G:K->A group) i)} x",
      ← q r"\x. RESTRICTION k (\i. if trivial_group((G:K->A group) i)
                            then group_id(G i) else x i)"] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_COMPONENTWISE] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
    REWRITE_TAC [PRODUCT_GROUP, RESTRICTION_IN_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [RESTRICTION_UNIQUE] THEN SIMP_TAC [IN_ELIM_THM] THEN
    SIMP_TAC [RESTRICTION, IN_ELIM_THM, EXTENSIONAL] THEN
    SIMP_TAC [GROUP_HOMOMORPHISM_PRODUCT_PROJECTION] THEN
    MESON_TAC [GROUP_ID, trivial_group, IN_SING])

  let ISOMORPHIC_PRODUCT_GROUP_SYMDIFF ← prove
   r"!k l (G:K->A group).
        (!i. i IN (k DIFF l) UNION (l DIFF k) ==> trivial_group(G i))
        ==> product_group k G isomorphic_group product_group l G"
   (← do
    let a1 ← MESON [ISOMORPHIC_GROUP_REFL]
     (← q r"G = H ==> G isomorphic_group H")
    let a2 ← REWRITE_RULE [IMP_CONJ] ISOMORPHIC_GROUP_TRANS
    let a3 ← REWRITE_RULE [IMP_CONJ_ALT] ISOMORPHIC_GROUP_TRANS
    pure (REPEAT STRIP_TAC THEN
      wPart lhand rand ISOMORPHIC_PRODUCT_GROUP_SUPPORT THEN
      GEN_REWRITE_TAC LAND_CONV [ISOMORPHIC_GROUP_SYM] THEN
      MATCH_MP_TAC a3 THEN
      wPart rand rand ISOMORPHIC_PRODUCT_GROUP_SUPPORT THEN
      MATCH_MP_TAC a2 THEN
      MATCH_MP_TAC a1 THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC []))

  let ISOMORPHIC_SUM_GROUP_SUPPORT ← prove
   r"!k (G:K->A group).
        sum_group {i | i IN k /\ ~trivial_group(G i)} G isomorphic_group
        sum_group k G"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    REWRITE_TAC [isomorphic_group, group_isomorphism] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x:K->A. RESTRICTION {i | i IN k /\ ~trivial_group((G:K->A group) i)} x",
      ← q r"\x. RESTRICTION k (\i. if trivial_group((G:K->A group) i)
                            then group_id(G i) else x i)"] THEN
    REWRITE_TAC [SUM_GROUP_ALT] THEN
    MATCH_MP_TAC GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS THEN CONJ_TAC THENL
     [REWRITE_TAC [GROUP_ISOMORPHISMS, GROUP_HOMOMORPHISM_COMPONENTWISE] THEN
      REWRITE_TAC [GROUP_HOMOMORPHISM_COMPONENTWISE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
      REWRITE_TAC [PRODUCT_GROUP, RESTRICTION_IN_CARTESIAN_PRODUCT] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_CARTESIAN_PRODUCT] THEN
      REWRITE_TAC [RESTRICTION_UNIQUE] THEN SIMP_TAC [IN_ELIM_THM] THEN
      SIMP_TAC [RESTRICTION, IN_ELIM_THM, EXTENSIONAL] THEN
      SIMP_TAC [GROUP_HOMOMORPHISM_PRODUCT_PROJECTION] THEN
      MESON_TAC [GROUP_ID, trivial_group, IN_SING],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      CONJ_TAC THEN GEN_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q "i:K") THEN
      ASM_CASES_TAC (← q r"(i:K) IN k") THEN
      ASM_REWRITE_TAC [RESTRICTION, IN_ELIM_THM] THEN MESON_TAC []])

  let ISOMORPHIC_SUM_GROUP_SYMDIFF ← prove
   r"!k l (G:K->A group).
        (!i. i IN (k DIFF l) UNION (l DIFF k) ==> trivial_group(G i))
        ==> sum_group k G isomorphic_group sum_group l G"
   (← do
    let a1 ← MESON [ISOMORPHIC_GROUP_REFL]
     (← q r"G = H ==> G isomorphic_group H")
    let a2 ← REWRITE_RULE [IMP_CONJ] ISOMORPHIC_GROUP_TRANS
    let a3 ← REWRITE_RULE [IMP_CONJ_ALT] ISOMORPHIC_GROUP_TRANS
    pure (REPEAT STRIP_TAC THEN
      wPart lhand rand ISOMORPHIC_SUM_GROUP_SUPPORT THEN
      GEN_REWRITE_TAC LAND_CONV [ISOMORPHIC_GROUP_SYM] THEN
      MATCH_MP_TAC a3 THEN
      wPart rand rand ISOMORPHIC_SUM_GROUP_SUPPORT THEN
      MATCH_MP_TAC a2 THEN
      MATCH_MP_TAC a1 THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC []))

  -- @@RETURN BEGIN
  return { isomorphic_group, GROUP_ISOMORPHISM_IMP_ISOMORPHIC,
           ISOMORPHIC_PRODUCT_GROUP_SING, ISOMORPHIC_SUM_GROUP_SING,
           ISOMORPHIC_GROUP_REFL, ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRANS,
           ISOMORPHIC_GROUP_OPPOSITE_GROUP, ISOMORPHIC_GROUP_TRIVIALITY,
           ISOMORPHIC_TO_TRIVIAL_GROUP, ISOMORPHIC_TRIVIAL_GROUPS,
           ISOMORPHIC_GROUP_SINGLETON_GROUP, ISOMORPHIC_GROUP_PROD_GROUPS,
           ISOMORPHIC_GROUP_PROD_GROUP_SYM, ISOMORPHIC_GROUP_PROD_GROUP_SWAP_LEFT,
           ISOMORPHIC_GROUP_PROD_GROUP_SWAP_RIGHT, ISOMORPHIC_PROD_TRIVIAL_GROUP,
           ISOMORPHIC_PRODUCT_GROUP_SUPPORT, ISOMORPHIC_PRODUCT_GROUP_SYMDIFF,
           ISOMORPHIC_SUM_GROUP_SUPPORT, ISOMORPHIC_SUM_GROUP_SYMDIFF }
  -- @@RETURN END

/- ======== END ISO1 ======== -/

/- ------------------------------------------------------------------------- -/
/- Relation of isomorphism (continued).  (grouptheory.ml 4396-4674)          -/
/- ------------------------------------------------------------------------- -/

structure Iso2 where
  -- @@FIELDS
  ISOMORPHIC_PRODUCT_GROUP_BIJECTIONS : thm
  ISOMORPHIC_SUM_GROUP_BIJECTIONS : thm
  ISOMORPHIC_GROUP_PRODUCT_GROUP : thm
  ISOMORPHIC_GROUP_SUM_GROUP : thm
  GROUP_ISOMORPHISMS_PRODUCT_GROUP_DISJOINT_UNION : thm
  GROUP_ISOMORPHISMS_SUM_GROUP_DISJOINT_UNION : thm
  GROUP_ISOMORPHISM_PRODUCT_GROUP_DISJOINT_UNION : thm
  GROUP_ISOMORPHISM_SUM_GROUP_DISJOINT_UNION : thm
  ISOMORPHIC_PRODUCT_GROUP_DISJOINT_UNION : thm
  ISOMORPHIC_SUM_GROUP_DISJOINT_UNION : thm
  ISOMORPHIC_PRODUCT_GROUP_INSERT : thm
  ISOMORPHIC_SUM_GROUP_INSERT : thm
  ISOMORPHIC_GROUP_CARD_EQ : thm
  ISOMORPHIC_GROUP_FINITENESS : thm
  ISOMORPHIC_GROUP_INFINITENESS : thm
  ISOMORPHIC_GROUP_HAS_ORDER : thm
  ISOMORPHIC_GROUP_ORDER : thm
  ISOMORPHIC_GROUP_ABELIANNESS : thm
  CREATE_ISOMORPHIC_COPY_OF_GROUP : thm
  ISOMORPHIC_COPY_OF_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupIso2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BSubgroupGenerated : SubgroupGenerated) (BProdGroup : ProdGroup) (BProductGroup : ProductGroup) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms3 : Homomorphisms3) (BHomomorphisms4 : Homomorphisms4) (BIso1 : Iso1) :
    ExceptT String IO Iso2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, TAUT, basic_ss, .. } := D
  let { BETA_THM, CARD_EQ_TRANS, CARD_FINITE_CONG, CARD_HAS_SIZE_CONG,
        CARTESIAN_PRODUCT_AS_RESTRICTIONS, .. } := D.core1
  let { DISJOINT_SING, EQ_C_BIJECTIONS, .. } := D.core2
  let { EXTENSIONAL, FINITE_IMAGE, FINITE_SUBSET, FINITE_UNION, FORALL_AND_THM,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, HAS_SIZE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, INFINITE, INTER_CROSS, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_CROSS, IN_ELIM_THM, IN_INTER, IN_UNION, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, NOT_IMP, PAIR, PAIR_EQ, RESTRICTION,
        RESTRICTION_EXTENSION, .. } := D.core6
  let { RESTRICTION_IN_EXTENSIONAL, RESTRICTION_UNIQUE, RIGHT_IMP_EXISTS_THM,
        SKOLEM_THM, SUBSET, .. } := D.core7
  let { o_DEF, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, group_carrier, group_id, group_inv, group_mul,
        group_tybij, .. } := BBasics
  let { SUBGROUP_GENERATED_RESTRICT, .. } := BSubgroupGenerated
  let { PROD_GROUP, PROD_GROUP_SUBGROUP_GENERATED, .. } := BProdGroup
  let { PRODUCT_GROUP, .. } := BProductGroup
  let { SUBGROUP_SUM_GROUP, SUM_GROUP_ALT, SUM_GROUP_CLAUSES, sum_group, .. } := BSumGroup
  let { GROUP_HOMOMORPHISM, GROUP_ISOMORPHISMS, GROUP_ISOMORPHISMS_SYM,
        group_homomorphism, group_isomorphism, group_isomorphisms, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_COMPOSE, .. } := BHomomorphisms1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { CARD_EQ_GROUP_ISOMORPHIC_IMAGE, GROUP_HOMOMORPHISM_PAIRED,
        GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS_ALT, .. } := BHomomorphisms3
  let { ABELIAN_GROUP_EPIMORPHIC_IMAGE, GROUP_HOMOMORPHISM_COMPONENTWISE,
        GROUP_HOMOMORPHISM_PRODUCT_PROJECTION, .. } := BHomomorphisms4
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, ISOMORPHIC_GROUP_PROD_GROUPS,
        ISOMORPHIC_GROUP_REFL, ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRANS,
        ISOMORPHIC_PRODUCT_GROUP_SING, ISOMORPHIC_SUM_GROUP_SING, isomorphic_group, .. } := BIso1
  -- @@SCOPE END

  let (ISOMORPHIC_PRODUCT_GROUP_BIJECTIONS, ISOMORPHIC_SUM_GROUP_BIJECTIONS) ←
   CONJ_PAIR (← prove
   r"(!s (G:K->A group) t (H:L->B group) f g.
        (!x. x IN s ==> f(x) IN t /\ g(f x) = x) /\
        (!y. y IN t ==> g(y) IN s /\ f(g y) = y) /\
        (!i. i IN s ==> (G i) isomorphic_group H(f i))
        ==> product_group s G isomorphic_group product_group t H) /\
   (!s (G:K->A group) t (H:L->B group) f g.
        (!x. x IN s ==> f(x) IN t /\ g(f x) = x) /\
        (!y. y IN t ==> g(y) IN s /\ f(g y) = y) /\
        (!i. i IN s ==> (G i) isomorphic_group H(f i))
        ==> sum_group s G isomorphic_group sum_group t H)"
   (← do
    let a2 ← MESON [FINITE_IMAGE, FINITE_SUBSET]
     (← q r"!f. t SUBSET IMAGE f s ==> FINITE s ==> FINITE t")
    let a1 ← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")
    pure (CONJ_TAC THEN REPEAT GEN_TAC THEN
      REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [isomorphic_group, group_isomorphism] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"h:K->A->B", ← q r"k:K->B->A"] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
       [group_isomorphisms, FORALL_AND_THM, a1] THEN
      STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"\(x:K->A). RESTRICTION t (\j:L. (h:K->A->B) (g j) (x (g j)))",
        ← q r"\(y:L->B). RESTRICTION s (\i:K. (k:K->B->A) i (y (f i)))"] THEN
      REWRITE_TAC [SUM_GROUP_ALT] THENL
       [ALL_TAC,
        MATCH_MP_TAC GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS_ALT THEN
        CONJ_TAC THENL
         [ALL_TAC,
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
          SIMP_TAC [← GSYM NOT_IMP, RESTRICTION] THEN
          REWRITE_TAC [NOT_IMP, IN_INTER, PRODUCT_GROUP] THEN
          REWRITE_TAC [IN_CARTESIAN_PRODUCT, IN_ELIM_THM] THEN
          CONJ_TAC THENL [X_GEN_TAC (← q r"x:K->A"), X_GEN_TAC (← q r"y:L->B")] THEN
          DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
          MATCH_MP_TAC a2
          THENL [EXISTS_TAC (← q r"f:K->L"), EXISTS_TAC (← q r"g:L->K")] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN
          ASM SET_TAC []]] THEN
     (REWRITE_TAC [group_isomorphisms] THEN
      REWRITE_TAC [RESTRICTION_EXTENSION, PRODUCT_GROUP, FORALL_IN_GSPEC,
        IMP_CONJ, SUM_GROUP_CLAUSES, CARTESIAN_PRODUCT_AS_RESTRICTIONS] THEN
      ASM_SIMP_TAC [RESTRICTION] THEN
      REWRITE_TAC [GROUP_HOMOMORPHISM_COMPONENTWISE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PRODUCT_GROUP] THEN
      REWRITE_TAC [RESTRICTION_IN_EXTENSIONAL] THEN SIMP_TAC [RESTRICTION] THEN
      CONJ_TAC THENL [X_GEN_TAC (← q r"j:L"), X_GEN_TAC (← q r"i:K")] THEN
      DISCH_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE THENL
       [EXISTS_TAC (← q r"(G:K->A group) (g(j:L))"),
        EXISTS_TAC (← q r"(H:L->B group) (f(i:K))")] THEN
      ASM_SIMP_TAC [GROUP_HOMOMORPHISM_PRODUCT_PROJECTION] THEN
      ASM_MESON_TAC []))))

  let ISOMORPHIC_GROUP_PRODUCT_GROUP ← prove
   r"!(G:K->A group) (H:K->B group) k.
        (!i. i IN k ==> (G i) isomorphic_group (H i))
        ==> (product_group k G) isomorphic_group (product_group k H)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC ISOMORPHIC_PRODUCT_GROUP_BIJECTIONS THEN
    REPEAT (EXISTS_TAC (← q r"\x:K. x")) THEN ASM_REWRITE_TAC [])

  let ISOMORPHIC_GROUP_SUM_GROUP ← prove
   r"!(G:K->A group) (H:K->B group) k.
        (!i. i IN k ==> (G i) isomorphic_group (H i))
        ==> (sum_group k G) isomorphic_group (sum_group k H)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC ISOMORPHIC_SUM_GROUP_BIJECTIONS THEN
    REPEAT (EXISTS_TAC (← q r"\x:K. x")) THEN ASM_REWRITE_TAC [])

  let GROUP_ISOMORPHISMS_PRODUCT_GROUP_DISJOINT_UNION ← prove
   r"!(f:K->A group) k l.
        DISJOINT k l
        ==> group_isomorphisms
                (product_group (k UNION l) f,
                 prod_group (product_group k f) (product_group l f))
                ((\f. RESTRICTION k f,RESTRICTION l f),
                 (\(f,g) x. if x IN k then f x else g x))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [GROUP_ISOMORPHISMS] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [GROUP_HOMOMORPHISM_PAIRED,
                  GROUP_HOMOMORPHISM_COMPONENTWISE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
      SIMP_TAC [RESTRICTION, GROUP_HOMOMORPHISM_PRODUCT_PROJECTION, IN_UNION],
      REWRITE_TAC [PROD_GROUP, FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
      SIMP_TAC [RESTRICTION_UNIQUE, IN_CARTESIAN_PRODUCT, PRODUCT_GROUP] THEN
      REWRITE_TAC [EXTENSIONAL, IN_ELIM_THM] THEN
      REWRITE_TAC [FUN_EQ_THM, RESTRICTION] THEN ASM SET_TAC []])

  let GROUP_ISOMORPHISMS_SUM_GROUP_DISJOINT_UNION ← prove
   r"!(f:K->A group) k l.
        DISJOINT k l
        ==> group_isomorphisms
                (sum_group (k UNION l) f,
                 prod_group (sum_group k f) (sum_group l f))
                ((\f. RESTRICTION k f,RESTRICTION l f),
                 (\(f,g) x. if x IN k then f x else g x))"
   (← do
    let a1 ← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")
    pure (REPEAT STRIP_TAC THEN
      SIMP_TAC [sum_group, SUBGROUP_SUM_GROUP, PROD_GROUP_SUBGROUP_GENERATED] THEN
      REWRITE_TAC [a1] THEN
      REWRITE_TAC [← GSYM INTER_CROSS] THEN
      REWRITE_TAC [← GSYM (← CONJUNCT1 PRODUCT_GROUP)] THEN
      REWRITE_TAC [← GSYM (← CONJUNCT1 PROD_GROUP)] THEN
      REWRITE_TAC [← GSYM SUBGROUP_GENERATED_RESTRICT] THEN
      MATCH_MP_TAC GROUP_ISOMORPHISMS_BETWEEN_SUBGROUPS_ALT THEN CONJ_TAC THENL
       [REWRITE_TAC [GROUP_ISOMORPHISMS] THEN
        CONJ_TAC THENL
         [REWRITE_TAC [GROUP_HOMOMORPHISM_PAIRED,
                      GROUP_HOMOMORPHISM_COMPONENTWISE] THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
          SIMP_TAC [RESTRICTION, GROUP_HOMOMORPHISM_PRODUCT_PROJECTION, IN_UNION],
          REWRITE_TAC [PROD_GROUP, FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
          SIMP_TAC [RESTRICTION_UNIQUE, IN_CARTESIAN_PRODUCT, PRODUCT_GROUP] THEN
          REWRITE_TAC [EXTENSIONAL, IN_ELIM_THM] THEN
          REWRITE_TAC [FUN_EQ_THM, RESTRICTION] THEN ASM SET_TAC []],
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PAIR_THM, IN_CROSS, IN_INTER,
                    IN_ELIM_THM] THEN
        CONJ_TAC THEN REPEAT GEN_TAC THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        REWRITE_TAC [← GSYM FINITE_UNION] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
        REWRITE_TAC [SUBSET, IN_UNION, IN_INTER, IN_ELIM_THM, RESTRICTION] THEN
        SET_TAC []]))

  let GROUP_ISOMORPHISM_PRODUCT_GROUP_DISJOINT_UNION ← prove
   r"!(f:K->A group) k l.
        DISJOINT k l
        ==> group_isomorphism
                (product_group (k UNION l) f,
                 prod_group (product_group k f) (product_group l f))
                (\f. RESTRICTION k f,RESTRICTION l f)"
   (REWRITE_TAC [group_isomorphism] THEN
    MESON_TAC [GROUP_ISOMORPHISMS_PRODUCT_GROUP_DISJOINT_UNION])

  let GROUP_ISOMORPHISM_SUM_GROUP_DISJOINT_UNION ← prove
   r"!(f:K->A group) k l.
        DISJOINT k l
        ==> group_isomorphism
                (sum_group (k UNION l) f,
                 prod_group (sum_group k f) (sum_group l f))
                (\f. RESTRICTION k f,RESTRICTION l f)"
   (REWRITE_TAC [group_isomorphism] THEN
    MESON_TAC [GROUP_ISOMORPHISMS_SUM_GROUP_DISJOINT_UNION])

  let ISOMORPHIC_PRODUCT_GROUP_DISJOINT_UNION ← prove
   r"!(f:K->A group) k l.
        DISJOINT k l
        ==> product_group (k UNION l) f isomorphic_group
            prod_group (product_group k f) (product_group l f)"
   (REWRITE_TAC [isomorphic_group] THEN
    MESON_TAC [GROUP_ISOMORPHISM_PRODUCT_GROUP_DISJOINT_UNION])

  let ISOMORPHIC_SUM_GROUP_DISJOINT_UNION ← prove
   r"!(f:K->A group) k l.
        DISJOINT k l
        ==> sum_group (k UNION l) f isomorphic_group
            prod_group (sum_group k f) (sum_group l f)"
   (REWRITE_TAC [isomorphic_group] THEN
    MESON_TAC [GROUP_ISOMORPHISM_SUM_GROUP_DISJOINT_UNION])

  let ISOMORPHIC_PRODUCT_GROUP_INSERT ← prove
   r"!(f:K->A group) i k.
        ~(i IN k)
        ==> product_group (i INSERT k) f isomorphic_group
            prod_group (f i) (product_group k f)"
   (← do
    let a1 ← SET_RULE (← q r"(i:K) INSERT k = {i} UNION k")
    pure (REPEAT STRIP_TAC THEN
      TRANS_TAC ISOMORPHIC_GROUP_TRANS
       (← q r"prod_group (product_group {i} f) (product_group k (f:K->A group))") THEN
      SUBST1_TAC a1 THEN
      ASM_SIMP_TAC [ISOMORPHIC_PRODUCT_GROUP_DISJOINT_UNION, DISJOINT_SING] THEN
      MATCH_MP_TAC ISOMORPHIC_GROUP_PROD_GROUPS THEN
      REWRITE_TAC [ISOMORPHIC_GROUP_REFL, ISOMORPHIC_PRODUCT_GROUP_SING]))

  let ISOMORPHIC_SUM_GROUP_INSERT ← prove
   r"!(f:K->A group) i k.
        ~(i IN k)
        ==> sum_group (i INSERT k) f isomorphic_group
            prod_group (f i) (sum_group k f)"
   (← do
    let a1 ← SET_RULE (← q r"(i:K) INSERT k = {i} UNION k")
    pure (REPEAT STRIP_TAC THEN
      TRANS_TAC ISOMORPHIC_GROUP_TRANS
       (← q r"prod_group (sum_group {i} f) (sum_group k (f:K->A group))") THEN
      SUBST1_TAC a1 THEN
      ASM_SIMP_TAC [ISOMORPHIC_SUM_GROUP_DISJOINT_UNION, DISJOINT_SING] THEN
      MATCH_MP_TAC ISOMORPHIC_GROUP_PROD_GROUPS THEN
      REWRITE_TAC [ISOMORPHIC_GROUP_REFL, ISOMORPHIC_SUM_GROUP_SING]))

  let ISOMORPHIC_GROUP_CARD_EQ ← prove
   r"!(G:A group) (H:B group).
        G isomorphic_group H ==> group_carrier G =_c group_carrier H"
   (REWRITE_TAC [isomorphic_group, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [CARD_EQ_GROUP_ISOMORPHIC_IMAGE])

  let ISOMORPHIC_GROUP_FINITENESS ← prove
   r"!(G:A group) (H:B group).
        G isomorphic_group H
        ==> (FINITE(group_carrier G) <=> FINITE(group_carrier H))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_CARD_EQ) THEN
    REWRITE_TAC [CARD_FINITE_CONG])

  let ISOMORPHIC_GROUP_INFINITENESS ← prove
   r"!(G:A group) (H:B group).
        G isomorphic_group H
        ==> (INFINITE(group_carrier G) <=> INFINITE(group_carrier H))"
   (← do
    let a1 ← TAUT (← q r"(~p <=> ~q) <=> (p <=> q)")
    pure (REWRITE_TAC [INFINITE, a1] THEN
      REWRITE_TAC [ISOMORPHIC_GROUP_FINITENESS]))

  let ISOMORPHIC_GROUP_HAS_ORDER ← prove
   r"!(G:A group) (H:B group) n.
        G isomorphic_group H
        ==> (group_carrier G HAS_SIZE n <=> group_carrier H HAS_SIZE n)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_CARD_EQ) THEN
    MESON_TAC [CARD_HAS_SIZE_CONG])

  let ISOMORPHIC_GROUP_ORDER ← prove
   r"!(G:A group) (H:B group).
        G isomorphic_group H /\
        (FINITE(group_carrier G) \/ FINITE(group_carrier H))
        ==> CARD(group_carrier G) = CARD(group_carrier H)"
   (MESON_TAC [ISOMORPHIC_GROUP_HAS_ORDER, HAS_SIZE,
              ISOMORPHIC_GROUP_FINITENESS])

  let ISOMORPHIC_GROUP_ABELIANNESS ← prove
   r"!(G:A group) (H:B group).
        G isomorphic_group H ==> (abelian_group G <=> abelian_group H)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] ABELIAN_GROUP_EPIMORPHIC_IMAGE) THEN
    ASM_MESON_TAC [isomorphic_group, ISOMORPHIC_GROUP_SYM,
                  GROUP_MONOMORPHISM_EPIMORPHISM])

  let CREATE_ISOMORPHIC_COPY_OF_GROUP ← prove
   r"!(f:A->B) g G s z i m.
        z IN s /\
        (!x. x IN group_carrier G ==> f x IN s /\ g(f x) = x) /\
        (!y. y IN s ==> g y IN group_carrier G /\ f(g y) = y) /\
        g z = group_id G /\
        (!x. x IN s ==> i x = f(group_inv G (g x))) /\
        (!x y. x IN s /\ y IN s ==> m x y = f(group_mul G (g x) (g y)))
        ==> group_isomorphisms (G,group(s,z,i,m)) (f,g) /\
            group_carrier (group(s,z,i,m)) = s /\
            group_id (group(s,z,i,m)) = z /\
            group_inv (group(s,z,i,m)) = i /\
            group_mul (group(s,z,i,m)) = m"
   (← do
    let a1 ← TAUT (← q r"(q ==> p) /\ q ==> p /\ q")
    let ss1 ← ExceptT.mk (basic_ss [])
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
      MATCH_MP_TAC a1 THEN CONJ_TAC THENL
       [STRIP_TAC THEN ONCE_REWRITE_TAC [GROUP_ISOMORPHISMS_SYM] THEN
        ASM_REWRITE_TAC [GROUP_ISOMORPHISMS, GROUP_HOMOMORPHISM] THEN
        ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, GROUP_MUL],
        PURE_REWRITE_TAC
         [← GSYM PAIR_EQ, group_carrier, group_id, group_inv, group_mul,
          BETA_THM, PAIR] THEN
        REWRITE_TAC [← GSYM (← CONJUNCT2 group_tybij)] THEN
        REWRITE_TAC (← [group_carrier, group_id, group_inv, group_mul].mapM
         (fun th => do GSYM (← REWRITE_RULE [FUN_EQ_THM] th))) THEN
        ASM (simpTac ss1 4)
          [GROUP_ID, GROUP_MUL, GROUP_INV, GROUP_MUL_ASSOC,
           GROUP_MUL_LID, GROUP_MUL_RID, GROUP_MUL_LINV, GROUP_MUL_RINV] THEN
        ASM_MESON_TAC [GROUP_ID]]))

  let ISOMORPHIC_COPY_OF_GROUP ← prove
   r"!(G:A group) (s:B->bool).
        (?G'. group_carrier G' = s /\ G isomorphic_group G') <=>
        group_carrier G =_c s"
   (← do
    let a1 ← MESON [GROUP_ISOMORPHISM_IMP_ISOMORPHIC, group_isomorphism]
     (← q r"(?G'. group_isomorphisms(G,G') (f:A->B,g) /\ group_carrier G' = s)
    ==> ?G'. group_carrier G' = s /\ G isomorphic_group G'")
    pure (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [ISOMORPHIC_GROUP_CARD_EQ, CARD_EQ_TRANS],
      REWRITE_TAC [EQ_C_BIJECTIONS, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN STRIP_TAC THEN
    MATCH_MP_TAC a1 THEN
    EXISTS_TAC (← q r"group(s:B->bool,
              f (group_id G:A),
              (\x. f(group_inv G (g x))),
              (\x1 x2. f(group_mul G (g x1) (g x2))))") THEN
    wPart lhand (fun t => do lhand (← rand t)) CREATE_ISOMORPHIC_COPY_OF_GROUP THEN
    ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
    ASM_SIMP_TAC [GROUP_ID]))

  -- @@RETURN BEGIN
  return { ISOMORPHIC_PRODUCT_GROUP_BIJECTIONS, ISOMORPHIC_SUM_GROUP_BIJECTIONS,
           ISOMORPHIC_GROUP_PRODUCT_GROUP, ISOMORPHIC_GROUP_SUM_GROUP,
           GROUP_ISOMORPHISMS_PRODUCT_GROUP_DISJOINT_UNION,
           GROUP_ISOMORPHISMS_SUM_GROUP_DISJOINT_UNION,
           GROUP_ISOMORPHISM_PRODUCT_GROUP_DISJOINT_UNION,
           GROUP_ISOMORPHISM_SUM_GROUP_DISJOINT_UNION,
           ISOMORPHIC_PRODUCT_GROUP_DISJOINT_UNION, ISOMORPHIC_SUM_GROUP_DISJOINT_UNION,
           ISOMORPHIC_PRODUCT_GROUP_INSERT, ISOMORPHIC_SUM_GROUP_INSERT,
           ISOMORPHIC_GROUP_CARD_EQ, ISOMORPHIC_GROUP_FINITENESS,
           ISOMORPHIC_GROUP_INFINITENESS, ISOMORPHIC_GROUP_HAS_ORDER,
           ISOMORPHIC_GROUP_ORDER, ISOMORPHIC_GROUP_ABELIANNESS,
           CREATE_ISOMORPHIC_COPY_OF_GROUP, ISOMORPHIC_COPY_OF_GROUP }
  -- @@RETURN END

/- ======== END ISO2 ======== -/

/- ------------------------------------------------------------------------- -/
/- Direct limits, in the special case where we are just using the            -/
/- inclusion map I as the monomorphism between rings in the directed family. -/
/- (grouptheory.ml 4676-4749)                                                -/
/- ------------------------------------------------------------------------- -/

structure DirectLimit where
  -- @@FIELDS
  GROUP_DIRECT_LIMIT : thm
  deriving Inhabited

@[nospecialize]
def setupDirectLimit [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BHomomorphisms : Homomorphisms) :
    ExceptT String IO DirectLimit := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, let_CONV, .. } := D
  let { EMPTY_SUBSET, EXISTS_IN_GSPEC, .. } := D.core2
  let { FINITE_EMPTY, FINITE_INSERT, FINITE_SUBSET_UNIONS_DIRECTED_EQ, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, .. } := D.core3
  let { IMAGE_I, IMAGE_ID, IMP_CONJ, INSERT_SUBSET, .. } := D.core4
  let { IN_ELIM_THM, I_DEF, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, PAIR, PAIR_EQ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, UNIONS_GSPEC, .. } := D.core7
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, group_carrier, group_id, group_inv, group_mul,
        group_tybij, .. } := BBasics
  let { group_homomorphism, group_monomorphism, .. } := BHomomorphisms
  -- @@SCOPE END

  let GROUP_DIRECT_LIMIT ← prove
   r"!c:(A group->bool).
        ~(c = {}) /\
        (!g g'. g IN c /\ g' IN c
                ==> ?G. G IN c /\
                        group_monomorphism(g,G) I /\
                        group_monomorphism(g',G) I)
        ==> ?G. group_carrier G = UNIONS {group_carrier g | g IN c} /\
                !g. g IN c ==> group_monomorphism(g,G) I"
   (← do
    -- OCaml evaluates the two SET_RULE calls in reverse text order.
    let s2 ← SET_RULE (← q r"{f x | x IN s} = {} <=> s = {}")
    let s1 ← SET_RULE (← q r"x IN s /\ y IN s <=> {x,y} SUBSET s")
    pure (REPEAT STRIP_TAC THEN
    MAP_EVERY ABBREV_TAC
     [← q r"gid:A = let g = @g. g IN c in group_id g",
      ← q r"ginv = \x:A. let g = @g. g IN c /\ x IN group_carrier g in
                  group_inv g x",
      ← q r"mul = \x y:A.
        let g = @g. g IN c /\ x IN group_carrier g /\ y IN group_carrier g in
        group_mul g x y"] THEN
    SUBGOAL_THEN
     (← q r"(!g. g IN c ==> gid:A = group_id g) /\
    (!g x. g IN c /\ x IN group_carrier g ==> ginv x = group_inv g x) /\
    (!g x y. g IN c /\ x IN group_carrier g /\ y IN group_carrier g
              ==> mul x y = group_mul g x y)")
    MP_TAC THENL
     [FIRST_ASSUM (MP_TAC o check (fun th => is_forall (concl th))) THEN
      REWRITE_TAC [group_monomorphism, group_homomorphism, IMAGE_ID, I_DEF] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      MAP_EVERY EXPAND_TAC ["gid", "ginv", "mul"] THEN
      CONV_TAC (ONCE_DEPTH_CONV let_CONV) THEN MESON_TAC [],
      REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
        let _ ← SYM (← SYM th); pure ALL_TAC)) THEN STRIP_TAC] THEN
    ABBREV_TAC (← q r"G = group(UNIONS {group_carrier g:A->bool | g IN c},
                        gid,ginv,mul)") THEN
    SUBGOAL_THEN
     (← q r"group_carrier G = UNIONS {group_carrier g | g IN c} /\
    group_id G :A = gid /\
    group_inv G = ginv /\
    group_mul G = mul")
    MP_TAC THENL
     [GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o RATOR_CONV) [group_carrier] THEN
      REWRITE_TAC [group_id, group_inv, group_mul] THEN
      REWRITE_TAC [PAIR, ← GSYM PAIR_EQ] THEN EXPAND_TAC "G" THEN
      REWRITE_TAC [← GSYM (← CONJUNCT2 group_tybij)] THEN
      REWRITE_TAC [s1] THEN
      REWRITE_TAC [← GSYM INSERT_SUBSET] THEN
      MP_TAC (← ISPEC (← q r"{group_carrier g:A->bool | g IN c}")
          FINITE_SUBSET_UNIONS_DIRECTED_EQ) THEN
      ASM_REWRITE_TAC [s2] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE
          [group_monomorphism, group_homomorphism, IMAGE_I]) THEN
        ASM_MESON_TAC [],
        SIMP_TAC [FINITE_INSERT, FINITE_EMPTY] THEN DISCH_THEN (fun (_ : thm) => ALL_TAC) THEN
        REWRITE_TAC [INSERT_SUBSET, EXISTS_IN_GSPEC,
                    UNIONS_GSPEC, EMPTY_SUBSET]] THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      ASM_SIMP_TAC [GROUP_MUL, GROUP_ID, GROUP_INV] THEN
      ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_MUL_RID, GROUP_MUL_LID,
                   GROUP_MUL_RINV, GROUP_MUL_LINV] THEN
      ASM_MESON_TAC [MEMBER_NOT_EMPTY, GROUP_ID, GROUP_INV, GROUP_MUL],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (REPEAT_TCL CONJUNCTS_THEN (SUBST_ALL_TAC o SYM))) THEN
      EXISTS_TAC (← q "G:A group") THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [group_monomorphism, group_homomorphism,
                      IMAGE_ID, I_DEF] THEN
      ASM SET_TAC []]))

  -- @@RETURN BEGIN
  return { GROUP_DIRECT_LIMIT }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Perform group operations setwise.  (grouptheory.ml 4750-4938)             -/
/- ------------------------------------------------------------------------- -/

structure Setwise1 where
  -- @@FIELDS
  group_setinv : thm
  group_setmul : thm
  GROUP_SETINV_AS_IMAGE : thm
  SUBGROUP_OF_SETWISE : thm
  FINITE_SUBGROUP_OF_SETWISE : thm
  OPPOSITE_GROUP_SETINV : thm
  OPPOSITE_GROUP_SETMUL : thm
  GROUP_SETINV_EQ_EMPTY : thm
  GROUP_SETMUL_EQ_EMPTY : thm
  GROUP_SETMUL_EMPTY : thm
  GROUP_SETINV_MONO : thm
  GROUP_SETMUL_MONO : thm
  GROUP_SETMUL_INC_GEN : thm
  GROUP_SETMUL_INC : thm
  FINITE_GROUP_SETMUL : thm
  GROUP_SETMUL_SYM_ELEMENTWISE : thm
  GROUP_SETINV_SING : thm
  GROUP_SETMUL_SING : thm
  GROUP_SETINV : thm
  GROUP_SETMUL : thm
  GROUP_SETMUL_LID : thm
  GROUP_SETMUL_RID : thm
  GROUP_SETMUL_ASSOC : thm
  GROUP_SETMUL_SYM : thm
  GROUP_SETINV_SUBGROUP : thm
  GROUP_SETMUL_LSUBSET : thm
  GROUP_SETMUL_RSUBSET : thm
  GROUP_SETMUL_LSUBSET_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupSetwise1 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BSubgroups : Subgroups) :
    ExceptT String IO Setwise1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, new_definition, .. } := D
  let { ETA_AX, .. } := D.core2
  let { FINITE_PRODUCT_DEPENDENT, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_ELIM_THM, .. } := D.core5
  let { MEMBER_NOT_EMPTY, .. } := D.core6
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM_EQ, SURJECTIVE_IFF_INJECTIVE, .. } := D.core7
  let { GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_RID,
        GROUP_MUL_RINV, OPPOSITE_GROUP, .. } := BBasics
  let { GROUP_INV_INV, GROUP_LINV_EQ, GROUP_MUL_LCANCEL, GROUP_RID_EQ, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { SUBGROUP_OF_IMP_NONEMPTY, SUBGROUP_OF_OPPOSITE_GROUP, subgroup_of, .. } := BSubgroups
  -- @@SCOPE END

  let group_setinv ← new_definition
   r"group_setinv G g = {group_inv G x | x IN g}"

  let group_setmul ← new_definition
   r"group_setmul G g h = {group_mul G x y | x IN g /\ y IN h}"

  let GROUP_SETINV_AS_IMAGE ← prove
   r"!G:A group. group_setinv G = IMAGE (group_inv G)"
   (REWRITE_TAC [FUN_EQ_THM, group_setinv, SIMPLE_IMAGE, ETA_AX])

  let SUBGROUP_OF_SETWISE ← prove
   r"!G s:A->bool.
        s subgroup_of G <=>
        s SUBSET group_carrier G /\
        group_id G IN s /\
        group_setinv G s SUBSET s /\
        group_setmul G s s SUBSET s"
   (REWRITE_TAC [subgroup_of, group_setinv, group_setmul] THEN SET_TAC [])

  let FINITE_SUBGROUP_OF_SETWISE ← prove
   r"!G s:A->bool.
        FINITE s
        ==> (s subgroup_of G <=>
             s SUBSET group_carrier G /\
             ~(s = {}) /\
             group_setmul G s s SUBSET s)"
   (← do
    let t1 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REWRITE_TAC [SUBGROUP_OF_SETWISE] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SUBSET, group_setmul, group_setinv, FORALL_IN_GSPEC] THEN
    STRIP_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    SUBGOAL_THEN
     (← q r"!x y:A. x IN s /\ y IN s ==> ?z. z IN s /\ group_mul G x z = y")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN MP_TAC
       (← SPECL [← q r"s:A->bool", ← q r"group_mul G (x:A)"] SURJECTIVE_IFF_INJECTIVE) THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, GROUP_MUL_LCANCEL, IMP_CONJ],
      ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC t1 THEN CONJ_TAC THENL
     [ASM_MESON_TAC [GROUP_RID_EQ], ASM_MESON_TAC [GROUP_LINV_EQ]]))

  let OPPOSITE_GROUP_SETINV ← prove
   r"!G s:A->bool.
        group_setinv (opposite_group G) s = group_setinv G s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_setinv, OPPOSITE_GROUP])

  let OPPOSITE_GROUP_SETMUL ← prove
   r"!G s t:A->bool.
        group_setmul (opposite_group G) s t = group_setmul G t s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_setmul, OPPOSITE_GROUP] THEN
    SET_TAC [])

  let GROUP_SETINV_EQ_EMPTY ← prove
   r"!G g:A->bool. group_setinv G g = {} <=> g = {}"
   (REWRITE_TAC [group_setinv] THEN SET_TAC [])

  let GROUP_SETMUL_EQ_EMPTY ← prove
   r"!G g h:A->bool. group_setmul G g h = {} <=> g = {} \/ h = {}"
   (REWRITE_TAC [group_setmul] THEN SET_TAC [])

  let GROUP_SETMUL_EMPTY ← prove
   r"(!G s:A->bool. group_setmul G s {} = {}) /\
   (!G t:A->bool. group_setmul G {} t = {})"
   (REWRITE_TAC [GROUP_SETMUL_EQ_EMPTY])

  let GROUP_SETINV_MONO ← prove
   r"!G s s':A->bool.
        s SUBSET s' ==> group_setinv G s SUBSET group_setinv G s'"
   (REWRITE_TAC [group_setinv] THEN SET_TAC [])

  let GROUP_SETMUL_MONO ← prove
   r"!G s t s' t':A->bool.
        s SUBSET s' /\ t SUBSET t'
        ==> group_setmul G s t SUBSET group_setmul G s' t'"
   (REWRITE_TAC [group_setmul] THEN SET_TAC [])

  let GROUP_SETMUL_INC_GEN ← prove
   r"(!G s t:A->bool.
        group_id G IN s /\ t SUBSET group_carrier G
        ==> t SUBSET group_setmul G s t) /\
   (!G s t:A->bool.
        s SUBSET group_carrier G /\ group_id G IN t
        ==> s SUBSET group_setmul G s t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_setmul, SUBSET, IN_ELIM_THM] THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THENL
     [MAP_EVERY EXISTS_TAC [← q r"group_id G:A", ← q "x:A"],
      MAP_EVERY EXISTS_TAC [← q "x:A", ← q r"group_id G:A"]] THEN
    ASM_MESON_TAC [SUBSET, GROUP_MUL_LID, GROUP_MUL_RID])

  let GROUP_SETMUL_INC ← prove
   r"(!G s t:A->bool.
        s subgroup_of G /\ t subgroup_of G ==> t SUBSET group_setmul G s t) /\
   (!G s t:A->bool.
        s subgroup_of G /\ t subgroup_of G ==> s SUBSET group_setmul G s t)"
   (MESON_TAC [GROUP_SETMUL_INC_GEN, subgroup_of])

  let FINITE_GROUP_SETMUL ← prove
   r"!G s t:A->bool.
        FINITE s /\ FINITE t ==> FINITE(group_setmul G s t)"
   (SIMP_TAC [group_setmul, FINITE_PRODUCT_DEPENDENT])

  let GROUP_SETMUL_SYM_ELEMENTWISE ← prove
   r"!G s t u:A->bool.
        (!a. a IN s ==> group_setmul G {a} t = group_setmul G u {a})
        ==> group_setmul G s t = group_setmul G u s"
   (REWRITE_TAC [group_setmul] THEN SET_TAC [])

  let GROUP_SETINV_SING ← prove
   r"!G x:A. group_setinv G {x} = {group_inv G x}"
   (REWRITE_TAC [group_setinv] THEN SET_TAC [])

  let GROUP_SETMUL_SING ← prove
   r"!G x y:A. group_setmul G {x} {y} = {group_mul G x y}"
   (REWRITE_TAC [group_setmul] THEN SET_TAC [])

  let GROUP_SETINV ← prove
   r"!G g:A->bool.
        g SUBSET group_carrier G ==> group_setinv G g SUBSET group_carrier G"
   (SIMP_TAC [group_setinv, SUBSET, FORALL_IN_GSPEC, GROUP_INV])

  let GROUP_SETMUL ← prove
   r"!G g h:A->bool.
        g SUBSET group_carrier G /\ h SUBSET group_carrier G==>
        group_setmul G g h SUBSET group_carrier G"
   (SIMP_TAC [group_setmul, SUBSET, FORALL_IN_GSPEC, GROUP_MUL])

  let GROUP_SETMUL_LID ← prove
   r"!G g:A->bool.
        g SUBSET group_carrier G ==> group_setmul G {group_id G} g = g"
   (← do
    let s1 ← SET_RULE (← q r"(!y. y IN s ==> f a y = y) ==> {f x y | x IN {a} /\ y IN s} = s")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [group_setmul] THEN MATCH_MP_TAC s1 THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN ASM_SIMP_TAC [GROUP_MUL_LID]))

  let GROUP_SETMUL_RID ← prove
   r"!G g:A->bool.
        g SUBSET group_carrier G ==> group_setmul G g {group_id G} = g"
   (ONCE_REWRITE_TAC [← GSYM OPPOSITE_GROUP_SETMUL] THEN
    MESON_TAC [GROUP_SETMUL_LID, OPPOSITE_GROUP])

  let GROUP_SETMUL_ASSOC ← prove
   r"!G g h i:A->bool.
        g SUBSET group_carrier G /\ h SUBSET group_carrier G /\
        i SUBSET group_carrier G
        ==> group_setmul G g (group_setmul G h i) =
            group_setmul G (group_setmul G g h) i"
   (← do
    let s3 ← SET_RULE (← q r"(!x y z. P x y z ==> f x y z = g x y z)
    ==> {f x y z | P x y z} = {g x y z | P x y z}")
    let s2 ← SET_RULE (← q r"{f x y |x,y| x IN {g w z | w IN s /\ z IN t} /\ y IN u} =
    {f (g x y) z | x IN s /\ y IN t /\ z IN u}")
    let s1 ← SET_RULE (← q r"{f x y |x,y| x IN s /\ y IN {g w z | w IN t /\ z IN u}} =
    {f x (g y z) | x IN s /\ y IN t /\ z IN u}")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [group_setmul] THEN
    REWRITE_TAC [s1] THEN
    REWRITE_TAC [s2] THEN
    MATCH_MP_TAC s3 THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_MUL_ASSOC THEN
    ASM SET_TAC []))

  let GROUP_SETMUL_SYM ← prove
   r"!G g h:A->bool.
        abelian_group G /\ g SUBSET group_carrier G /\ h SUBSET group_carrier G
        ==> group_setmul G g h = group_setmul G h g"
   (REWRITE_TAC [abelian_group, group_setmul] THEN SET_TAC [])

  let GROUP_SETINV_SUBGROUP ← prove
   r"!G h:A->bool. h subgroup_of G ==> group_setinv G h = h"
   (← do
    let s1 ← SET_RULE (← q r"(!x. x IN s ==> f x IN s /\ f(f x) = x) ==> {f x | x IN s} = s")
    pure (REWRITE_TAC [group_setinv, subgroup_of, SUBSET] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC s1 THEN
    ASM_SIMP_TAC [GROUP_INV_INV]))

  let GROUP_SETMUL_LSUBSET ← prove
   r"!G h s:A->bool.
        h subgroup_of G /\ s SUBSET h /\ ~(s = {}) ==> group_setmul G s h = h"
   (REWRITE_TAC [group_setmul, subgroup_of, SUBSET] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, GROUP_MUL, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q "y:A") o REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    MAP_EVERY EXISTS_TAC [← q "y:A", ← q r"group_mul G (group_inv G y) x:A"] THEN
    ASM_SIMP_TAC [] THEN
    wPart rand (fun t => do lhand (← rand t)) GROUP_MUL_ASSOC THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV, GROUP_MUL_RINV, GROUP_MUL_LID])

  let GROUP_SETMUL_RSUBSET ← prove
   r"!G h s:A->bool.
        h subgroup_of G /\ s SUBSET h /\ ~(s = {}) ==> group_setmul G h s = h"
   (ONCE_REWRITE_TAC [← GSYM OPPOSITE_GROUP_SETMUL] THEN
    SIMP_TAC [GROUP_SETMUL_LSUBSET, SUBGROUP_OF_OPPOSITE_GROUP, OPPOSITE_GROUP])

  let GROUP_SETMUL_LSUBSET_EQ ← prove
   r"!G h s:A->bool.
        h subgroup_of G /\ s SUBSET group_carrier G
        ==> (group_setmul G s h = h <=> s SUBSET h /\ ~(s = {}))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
     [ASM_MESON_TAC [GROUP_SETMUL_EQ_EMPTY, SUBGROUP_OF_IMP_NONEMPTY],
      ASM_REWRITE_TAC []] THEN
    EQ_TAC THENL [ALL_TAC, ASM_MESON_TAC [GROUP_SETMUL_LSUBSET]] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [group_setmul, IN_ELIM_THM, SUBSET] THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN
    MAP_EVERY EXISTS_TAC [← q "x:A", ← q r"group_id G:A"] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of, SUBSET]) THEN
    ASM_SIMP_TAC [GROUP_MUL_RID])

  -- @@RETURN BEGIN
  return { group_setinv, group_setmul, GROUP_SETINV_AS_IMAGE, SUBGROUP_OF_SETWISE,
           FINITE_SUBGROUP_OF_SETWISE, OPPOSITE_GROUP_SETINV, OPPOSITE_GROUP_SETMUL,
           GROUP_SETINV_EQ_EMPTY, GROUP_SETMUL_EQ_EMPTY, GROUP_SETMUL_EMPTY,
           GROUP_SETINV_MONO, GROUP_SETMUL_MONO, GROUP_SETMUL_INC_GEN, GROUP_SETMUL_INC,
           FINITE_GROUP_SETMUL, GROUP_SETMUL_SYM_ELEMENTWISE, GROUP_SETINV_SING,
           GROUP_SETMUL_SING, GROUP_SETINV, GROUP_SETMUL, GROUP_SETMUL_LID,
           GROUP_SETMUL_RID, GROUP_SETMUL_ASSOC, GROUP_SETMUL_SYM, GROUP_SETINV_SUBGROUP,
           GROUP_SETMUL_LSUBSET, GROUP_SETMUL_RSUBSET, GROUP_SETMUL_LSUBSET_EQ }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Perform group operations setwise (continued).  (grouptheory.ml 4938-5129) -/
/- ------------------------------------------------------------------------- -/

structure Setwise2 where
  -- @@FIELDS
  GROUP_SETMUL_RSUBSET_EQ : thm
  IMAGE_GROUP_CONJUGATION : thm
  IMAGE_GROUP_CONJUGATION_EQ : thm
  GROUP_SETMUL_SUBGROUP : thm
  GROUP_SETMUL_LCANCEL : thm
  GROUP_SETMUL_RCANCEL : thm
  GROUP_SETMUL_LCANCEL_SET : thm
  GROUP_SETMUL_RCANCEL_SET : thm
  SUBGROUP_SETMUL_EQ : thm
  SUBGROUP_SETMUL : thm
  SUBGROUP_GENERATED_SETMUL : thm
  CARRIER_SUBGROUP_GENERATED_UNION : thm
  deriving Inhabited

@[nospecialize]
def setupSetwise2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSetwise1 : Setwise1) :
    ExceptT String IO Setwise2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { EQ_SYM_EQ, EQ_TRANS, .. } := D.core2
  let { FORALL_IN_GSPEC, FORALL_IN_UNION, .. } := D.core3
  let { IMAGE, IMP_CONJ, .. } := D.core4
  let { IN_ELIM_THM, IN_UNION, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, NOT_INSERT_EMPTY, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUBSET_REFL,
        SUBSET_TRANS, UNION_SUBSET, .. } := D.core7
  let { GROUPS_EQ, GROUP_INV, GROUP_MUL, GROUP_MUL_LID, GROUP_MUL_LINV, GROUP_MUL_RID,
        GROUP_MUL_RINV, OPPOSITE_GROUP, .. } := BBasics
  let { GROUP_INV_INV, GROUP_INV_MUL, group_div, .. } := BDerived
  let { group_conjugation, .. } := BConjugation
  let { SUBGROUP_OF_IMP_NONEMPTY, SUBGROUP_OF_IMP_SUBSET, SUBGROUP_OF_OPPOSITE_GROUP,
        subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED, SUBGROUP_GENERATED_MINIMAL, SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_INC, .. } := BSubgroupGen1
  let { GROUP_SETMUL, GROUP_SETMUL_ASSOC, GROUP_SETMUL_LID, GROUP_SETMUL_LSUBSET,
        GROUP_SETMUL_LSUBSET_EQ, GROUP_SETMUL_RID, GROUP_SETMUL_SING, GROUP_SETMUL_SYM,
        OPPOSITE_GROUP_SETMUL, SUBGROUP_OF_SETWISE, group_setinv, group_setmul, .. } := BSetwise1
  -- @@SCOPE END

  let GROUP_SETMUL_RSUBSET_EQ ← prove
   r"!G h s:A->bool.
        h subgroup_of G /\ s SUBSET group_carrier G
        ==> (group_setmul G h s = h <=> s SUBSET h /\ ~(s = {}))"
   (ONCE_REWRITE_TAC [← GSYM OPPOSITE_GROUP_SETMUL] THEN
    SIMP_TAC [GROUP_SETMUL_LSUBSET_EQ, SUBGROUP_OF_OPPOSITE_GROUP,
             OPPOSITE_GROUP])

  let IMAGE_GROUP_CONJUGATION ← prove
   r"!G (a:A) s.
        IMAGE (group_conjugation G a) s =
        group_setmul G {a} (group_setmul G s {group_inv G a})"
   (REWRITE_TAC [group_conjugation, group_setmul, IMAGE] THEN SET_TAC [])

  let IMAGE_GROUP_CONJUGATION_EQ ← prove
   r"!G (a:A) s t.
        a IN group_carrier G /\
        s SUBSET group_carrier G /\
        t SUBSET group_carrier G
        ==> (IMAGE (group_conjugation G a) s = t <=>
             group_setmul G {a} s = group_setmul G t {a})"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [IMAGE_GROUP_CONJUGATION] THEN
    EQ_TAC THENL
     [DISCH_THEN (MP_TAC o AP_TERM (← q r"\s. group_setmul G s {a:A}")),
      DISCH_THEN (MP_TAC o AP_TERM (← q r"\s. group_setmul G s {group_inv G a:A}"))] THEN
    ASM_SIMP_TAC [← GSYM GROUP_SETMUL_ASSOC, SING_SUBSET, GROUP_SETMUL, GROUP_INV,
     GROUP_SETMUL_SING, GROUP_MUL_LINV, GROUP_MUL_RINV, GROUP_SETMUL_RID])

  let GROUP_SETMUL_SUBGROUP ← prove
   r"!G h:A->bool.
        h subgroup_of G ==> group_setmul G h h = h"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_SETMUL_LSUBSET THEN
    ASM_MESON_TAC [SUBGROUP_OF_IMP_NONEMPTY, SUBSET_REFL])

  let GROUP_SETMUL_LCANCEL ← prove
   r"!G g h x:A.
        x IN group_carrier G /\
        g SUBSET group_carrier G /\ h SUBSET group_carrier G
        ==> (group_setmul G {x} g = group_setmul G {x} h <=> g = h)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [] THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"group_setmul G {group_inv G x:A}")) THEN
    ASM_SIMP_TAC [GROUP_SETMUL_ASSOC, SING_SUBSET, GROUP_INV] THEN
    ASM_SIMP_TAC [GROUP_SETMUL_SING, GROUP_MUL_LINV, GROUP_SETMUL_LID])

  let GROUP_SETMUL_RCANCEL ← prove
   r"!G g h x:A.
        x IN group_carrier G /\ g SUBSET group_carrier G /\
        h SUBSET group_carrier G
        ==> (group_setmul G g {x} = group_setmul G h {x} <=> g = h)"
   (ONCE_REWRITE_TAC [← GSYM OPPOSITE_GROUP_SETMUL] THEN
    SIMP_TAC [GROUP_SETMUL_LCANCEL, OPPOSITE_GROUP])

  let GROUP_SETMUL_LCANCEL_SET ← prove
   r"!G h x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\ h subgroup_of G
        ==> (group_setmul G h {x} = group_setmul G h {y} <=>
             group_div G x y IN h)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    TRANS_TAC EQ_TRANS
     (← q r"group_setmul G (group_setmul G h {x}) {group_inv G y}  =
    group_setmul G (group_setmul G h {y:A}) {group_inv G y}") THEN
    CONJ_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC GROUP_SETMUL_RCANCEL THEN
      ASM_SIMP_TAC [GROUP_INV, GROUP_SETMUL, SING_SUBSET],
      ASM_SIMP_TAC [← GSYM GROUP_SETMUL_ASSOC, GROUP_INV, SING_SUBSET] THEN
      ASM_SIMP_TAC [GROUP_SETMUL_SING, GROUP_MUL_RINV, GROUP_SETMUL_RID] THEN
      ASM_SIMP_TAC [GROUP_SETMUL_RSUBSET_EQ, SING_SUBSET, group_div,
                   GROUP_INV, GROUP_MUL, NOT_INSERT_EMPTY]])

  let GROUP_SETMUL_RCANCEL_SET ← prove
   r"!G h x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\ h subgroup_of G
        ==> (group_setmul G {x} h = group_setmul G {y} h <=>
             group_mul G (group_inv G x) y IN h)"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [EQ_SYM_EQ] THEN
    ONCE_REWRITE_TAC [← GSYM OPPOSITE_GROUP_SETMUL] THEN
    ASM_SIMP_TAC [GROUP_SETMUL_LCANCEL_SET, OPPOSITE_GROUP,
                 SUBGROUP_OF_OPPOSITE_GROUP, group_div])

  let SUBGROUP_SETMUL_EQ ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> ((group_setmul G g h) subgroup_of G <=>
             group_setmul G g h = group_setmul G h g)"
   (← do
    let s1 ← SET_RULE (← q r"s = t ==> !x. x IN s ==> x IN t")
    pure (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
      REWRITE_TAC [SUBSET, group_setmul, FORALL_IN_GSPEC] THEN
      CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [subgroup_of]) THEN
      DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← liftExcept (el 2 (CONJUNCTS th))))) THENL
       [DISCH_THEN (MP_TAC o SPEC (← q r"group_mul G x y:A")) THEN
        REWRITE_TAC [group_setmul, IN_ELIM_THM] THEN
        ANTS_TAC THENL [ASM_MESON_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
        MAP_EVERY X_GEN_TAC [← q "w:A", ← q "z:A"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"group_inv (G:A group)")) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of, SUBSET]) THEN
        ASM_SIMP_TAC [GROUP_INV_INV, GROUP_MUL] THEN
        ASM_SIMP_TAC [GROUP_INV_MUL] THEN ASM_MESON_TAC [],
        DISCH_THEN (MP_TAC o SPEC
         (← q r"group_mul G (group_inv G y) (group_inv G x):A")) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of, SUBSET]) THEN
        REWRITE_TAC [group_setmul, IN_ELIM_THM] THEN
        ANTS_TAC THENL [ASM_MESON_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
        ASM_SIMP_TAC [GROUP_INV_MUL, GROUP_INV, GROUP_MUL, GROUP_INV_INV] THEN
        ASM_MESON_TAC []],
      DISCH_TAC THEN REWRITE_TAC [SUBGROUP_OF_SETWISE] THEN
      ASM_SIMP_TAC [GROUP_SETMUL, SUBGROUP_OF_IMP_SUBSET] THEN
      REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [REWRITE_TAC [group_setmul, group_setinv, SUBSET, IMP_CONJ,
                    RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of, SUBSET]) THEN
        ASM_SIMP_TAC [GROUP_INV_MUL, IN_ELIM_THM] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [GROUP_MUL_LID], ALL_TAC] THEN
        X_GEN_TAC (← q "y:A") THEN DISCH_TAC THEN X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP s1) THEN
        REWRITE_TAC [group_setmul, FORALL_IN_GSPEC] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"group_inv G x:A", ← q r"group_inv G y:A"]) THEN
        ASM SET_TAC [],
        TRANS_TAC SUBSET_TRANS
         (← q r"group_setmul G (group_setmul G h g) (group_setmul G g h):A->bool") THEN
        CONJ_TAC THENL [ASM_MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
        TRANS_TAC SUBSET_TRANS
         (← q r"group_setmul G h (group_setmul G g (group_setmul G g h)):A->bool") THEN
        CONJ_TAC THENL
         [ASM_MESON_TAC [GROUP_SETMUL_ASSOC, subgroup_of, GROUP_SETMUL,
                        SUBSET_REFL],
          ALL_TAC] THEN
        TRANS_TAC SUBSET_TRANS
         (← q r"group_setmul G h (group_setmul G (group_setmul G g g) h):A->bool") THEN
        CONJ_TAC THENL
         [ASM_MESON_TAC [GROUP_SETMUL_ASSOC, subgroup_of, GROUP_SETMUL,
                        SUBSET_REFL],
          ALL_TAC] THEN
        ASM_SIMP_TAC [GROUP_SETMUL_SUBGROUP] THEN
        ASM_SIMP_TAC [GROUP_SETMUL_ASSOC, SUBGROUP_OF_IMP_SUBSET] THEN
        ASM_SIMP_TAC [GROUP_SETMUL_SUBGROUP, SUBSET_REFL]]]))

  let SUBGROUP_SETMUL ← prove
   r"!G g h:A->bool.
        abelian_group G /\ g subgroup_of G /\ h subgroup_of G
        ==> (group_setmul G g h) subgroup_of G"
   (MESON_TAC [GROUP_SETMUL_SYM, SUBGROUP_SETMUL_EQ, subgroup_of])

  let SUBGROUP_GENERATED_SETMUL ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> subgroup_generated G (group_setmul G g h) =
            subgroup_generated G (g UNION h)"
   (← do
    let m1 ← MESON [SUBGROUP_GENERATED, GROUP_MUL]
     (← q r"x IN group_carrier(subgroup_generated G s) /\
      y IN group_carrier(subgroup_generated G s)
      ==> group_mul G x y IN group_carrier(subgroup_generated G s)")
    pure (REPEAT STRIP_TAC THEN
    REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN
    REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [SUBSET, group_setmul, FORALL_IN_GSPEC, FORALL_IN_UNION] THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC m1 THEN
      CONJ_TAC,
      REPEAT STRIP_TAC] THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_INC THEN
    ASM_SIMP_TAC [UNION_SUBSET, IN_UNION, SUBGROUP_OF_IMP_SUBSET] THEN
    ASM_SIMP_TAC [← GSYM group_setmul, GROUP_SETMUL, SUBGROUP_OF_IMP_SUBSET] THEN
    REWRITE_TAC [group_setmul, IN_ELIM_THM] THEN
    ASM_MESON_TAC [GROUP_MUL_LID, GROUP_MUL_RID, subgroup_of, SUBSET]))

  let CARRIER_SUBGROUP_GENERATED_UNION ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G /\
        group_setmul G g h = group_setmul G h g
        ==> group_carrier(subgroup_generated G (g UNION h)) =
            group_setmul G g h"
   (MESON_TAC [SUBGROUP_SETMUL_EQ, SUBGROUP_GENERATED_SETMUL,
              CARRIER_SUBGROUP_GENERATED_SUBGROUP])

  -- @@RETURN BEGIN
  return { GROUP_SETMUL_RSUBSET_EQ, IMAGE_GROUP_CONJUGATION, IMAGE_GROUP_CONJUGATION_EQ,
           GROUP_SETMUL_SUBGROUP, GROUP_SETMUL_LCANCEL, GROUP_SETMUL_RCANCEL,
           GROUP_SETMUL_LCANCEL_SET, GROUP_SETMUL_RCANCEL_SET, SUBGROUP_SETMUL_EQ,
           SUBGROUP_SETMUL, SUBGROUP_GENERATED_SETMUL, CARRIER_SUBGROUP_GENERATED_UNION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Group actions.                                                            -/
/- ------------------------------------------------------------------------- -/

structure GroupActions where
  -- @@FIELDS
  group_action : thm
  GROUP_ACTION_ALT : thm
  GROUP_ACTION_MUL : thm
  GROUP_ACTION_LINV : thm
  GROUP_ACTION_RINV : thm
  GROUP_ACTION_BIJECTIVE : thm
  GROUP_ACTION_SURJECTIVE : thm
  GROUP_ACTION_INJECTIVE : thm
  GROUP_ACTION_ON_SUBSET : thm
  GROUP_ACTION_FROM_SUBGROUP : thm
  GROUP_ACTIONS_EQ_ON_GENERATORS : thm
  GROUP_ACTION_IMAGE : thm
  GROUP_ACTION_IMAGE_SIZED : thm
  group_stabilizer : thm
  GROUP_STABILIZER_SUBSET_CARRIER : thm
  FINITE_GROUP_STABILIZER : thm
  SUBGROUP_OF_GROUP_STABILIZER : thm
  GROUP_STABILIZER_NONEMPTY : thm
  GROUP_STABILIZER_SUBGROUP_GENERATED : thm
  GROUP_STABILIZER_ON_SUBGROUP : thm
  GROUP_ACTION_KERNEL_POINTWISE : thm
  GROUP_ACTION_EQ : thm
  GROUP_ACTION_FIBRES : thm
  deriving Inhabited

@[nospecialize]
def setupGroupActions [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) :
    ExceptT String IO GroupActions := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { EXTENSION, FINITE_SUBSET, .. } := D.core3
  let { HAS_SIZE_IMAGE_INJ, IMP_CONJ, INTERS_GSPEC, .. } := D.core4
  let { IN_ELIM_THM, IN_INTER, .. } := D.core5
  let { MEMBER_NOT_EMPTY, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_RESTRICT, .. } := D.core7
  let { o_DEF, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RINV, .. } := BBasics
  let { GROUP_INV_INV, .. } := BDerived
  let { subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_INDUCT_STRONG, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  -- @@SCOPE END

  let group_action ← new_definition
   r"group_action G s (a:A->X->X) <=>
          (!g x. g IN group_carrier G /\ x IN s ==> a g x IN s) /\
          (!x. x IN s ==> a (group_id G) x = x) /\
          (!g h x. g IN group_carrier G /\ h IN group_carrier G /\ x IN s
                   ==> a (group_mul G g h) x = a g (a h x))"

  let GROUP_ACTION_ALT ← prove
   r"!G s (a:A->X->X).
          group_action G s (a:A->X->X) <=>
          (!g x. g IN group_carrier G /\ x IN s ==> a g x IN s) /\
          (!x. x IN s ==> a (group_id G) x = x) /\
          (!g h x. g IN group_carrier G /\ h IN group_carrier G /\ x IN s
                   ==> a g (a h x) = a (group_mul G g h) x)"
   (REWRITE_TAC [group_action] THEN MESON_TAC [])

  let GROUP_ACTION_MUL ← prove
   r"!G s (a:A->X->X) g h x.
          group_action G s a /\
          g IN group_carrier G /\
          h IN group_carrier G /\
          x IN s
          ==> a g (a h x) = a (group_mul G g h) x"
   (SIMP_TAC [group_action])

  let GROUP_ACTION_LINV ← prove
   r"!G s (a:A->X->X) g x.
          group_action G s a /\ g IN group_carrier G /\ x IN s
          ==> a (group_inv G g) (a g x) = x"
   (REWRITE_TAC [group_action] THEN MESON_TAC [GROUP_MUL_LINV, GROUP_INV])

  let GROUP_ACTION_RINV ← prove
   r"!G s (a:A->X->X) g x.
          group_action G s a /\ g IN group_carrier G /\ x IN s
          ==> a g (a (group_inv G g) x) = x"
   (REWRITE_TAC [group_action] THEN MESON_TAC [GROUP_MUL_RINV, GROUP_INV])

  let GROUP_ACTION_BIJECTIVE ← prove
   r"!G s (a:A->X->X) g.
          group_action G s a /\ g IN group_carrier G
          ==> !y. y IN s ==> ?!x. x IN s /\ a g x = y"
   (MESON_TAC [GROUP_ACTION_LINV, GROUP_INV, GROUP_INV_INV, group_action])

  let GROUP_ACTION_SURJECTIVE ← prove
   r"!G s (a:A->X->X) g y.
          group_action G s a /\ g IN group_carrier G /\ y IN s
          ==> ?x. a g x = y"
   (MESON_TAC [GROUP_ACTION_BIJECTIVE])

  let GROUP_ACTION_INJECTIVE ← prove
   r"!G s (a:A->X->X).
          group_action G s a /\ g IN group_carrier G /\ x IN s /\ y IN s
          ==> (a g x = a g y <=> x = y)"
   (MESON_TAC [GROUP_ACTION_BIJECTIVE, group_action])

  let GROUP_ACTION_ON_SUBSET ← prove
   r"!G s t (a:A->X->X).
          group_action G s a /\
          t SUBSET s /\
          (!g x. g IN group_carrier G /\ x IN t ==> a g x IN t)
          ==> group_action G t a"
   (REWRITE_TAC [group_action] THEN SET_TAC [])

  let GROUP_ACTION_FROM_SUBGROUP ← prove
   r"!G s h (a:A->X->X).
          group_action G s a ==> group_action (subgroup_generated G h) s a"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_action] THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"h:A->bool"]
          GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET) THEN
    REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED] THEN SET_TAC [])

  let GROUP_ACTIONS_EQ_ON_GENERATORS ← (do
    let a1 ← MESON []
     (← q r"!f:X->X.
          (!x y. x IN s /\ y IN s ==> (f x = f y <=> x = y)) /\
          g a IN s /\ h a IN s /\ f(g a) = a /\ f(h a) = a
          ==> g a = h a")
    let tac : tactic :=
      (REWRITE_TAC [group_action] THEN
       REPEAT GEN_TAC THEN STRIP_TAC THEN
       REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
       MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT_STRONG THEN
       ASM_SIMP_TAC [] THEN X_GEN_TAC (← q "g:A") THEN STRIP_TAC THEN
       X_GEN_TAC (← q "x:X") THEN DISCH_TAC THEN MATCH_MP_TAC a1 THEN
       EXISTS_TAC (← q r"(a:A->X->X) g") THEN
       CONJ_TAC THENL
        [REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ACTION_INJECTIVE THEN
         MAP_EVERY EXISTS_TAC [← q "G:A group", ← q r"s:X->bool"] THEN
         ASM_REWRITE_TAC [group_action],
         ASM_MESON_TAC [GROUP_ID, GROUP_MUL, GROUP_INV, GROUP_MUL_RINV]])
    ExceptT.mk (HolCore.Lib.time (fun (_ : Unit) =>
     (prove
      r"!G t s (a:A->X->X) a'.
          group_action G s a /\
          group_action G s a' /\
          (!g x. g IN group_carrier G /\ g IN t /\ x IN s ==> a g x = a' g x)
          ==> !g x. g IN group_carrier(subgroup_generated G t) /\ x IN s
                    ==> a g x = a' g x"
      tac).run) ()))

  let GROUP_ACTION_IMAGE ← prove
   r"!G u s (a:A->X->X).
          group_action G s a /\
          (!t. t IN u ==> t SUBSET s) /\
          (!g t. g IN group_carrier G /\ t IN u ==> IMAGE (a g) t IN u)
          ==> group_action G u (IMAGE o a)"
   (REWRITE_TAC [group_action, o_DEF] THEN SET_TAC [])

  let GROUP_ACTION_IMAGE_SIZED ← prove
   r"!G s k (a:A->X->X).
          group_action G s a
          ==> group_action G {t | t SUBSET s /\ t HAS_SIZE k} (IMAGE o a)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ACTION_IMAGE THEN
    EXISTS_TAC (← q r"s:X->bool") THEN ASM_SIMP_TAC [IN_ELIM_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "g:A", ← q r"t:X->bool"] THEN STRIP_TAC THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [group_action]) THEN ASM SET_TAC [],
      MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN
      ASM_MESON_TAC [GROUP_ACTION_INJECTIVE, SUBSET]])

  let group_stabilizer ← new_definition
   r"group_stabilizer G (a:A->X->X) x = {g | g IN group_carrier G /\ a g x = x}"

  let GROUP_STABILIZER_SUBSET_CARRIER ← prove
   r"!G a x. group_stabilizer G a x SUBSET group_carrier G"
   (REWRITE_TAC [group_stabilizer, SUBSET_RESTRICT])

  let FINITE_GROUP_STABILIZER ← prove
   r"!G (a:A->X->X) x.
          FINITE(group_carrier G) ==> FINITE(group_stabilizer G a x)"
   (MESON_TAC [GROUP_STABILIZER_SUBSET_CARRIER, FINITE_SUBSET])

  let SUBGROUP_OF_GROUP_STABILIZER ← prove
   r"!G s (a:A->X->X) x.
          group_action G s a /\ x IN s ==> group_stabilizer G a x subgroup_of G"
   (REWRITE_TAC [subgroup_of, group_stabilizer, SUBSET_RESTRICT] THEN
    SIMP_TAC [group_action, IN_ELIM_THM, GROUP_ID, GROUP_INV, GROUP_MUL] THEN
    ASM_MESON_TAC [GROUP_MUL_LINV, GROUP_INV])

  let GROUP_STABILIZER_NONEMPTY ← prove
   r"!G (a:A->X->X) s x.
          group_action G s a /\ x IN s ==> ~(group_stabilizer G a x = {})"
   (REWRITE_TAC [group_action, ← GSYM MEMBER_NOT_EMPTY] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q "group_id G:A") THEN
    ASM_SIMP_TAC [group_stabilizer, IN_ELIM_THM, GROUP_ID])

  let GROUP_STABILIZER_SUBGROUP_GENERATED ← prove
   r"!G h (a:A->X->X) x.
          group_stabilizer (subgroup_generated G h) a x =
          group_carrier(subgroup_generated G h) INTER group_stabilizer G a x"
   (REWRITE_TAC [group_stabilizer, EXTENSION, IN_INTER, IN_ELIM_THM] THEN
    MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET])

  let GROUP_STABILIZER_ON_SUBGROUP ← prove
   r"!G h (a:A->X->X) x.
          h subgroup_of G
          ==> group_stabilizer (subgroup_generated G h) a x =
              h INTER group_stabilizer G a x"
   (SIMP_TAC [GROUP_STABILIZER_SUBGROUP_GENERATED,
             CARRIER_SUBGROUP_GENERATED_SUBGROUP])

  let GROUP_ACTION_KERNEL_POINTWISE ← prove
   r"!G s (a:A->X->X).
          {g | g IN group_carrier G /\ !x. x IN s ==> a g x = x} =
          if s = {} then group_carrier G
          else INTERS {group_stabilizer G a x | x IN s}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [INTERS_GSPEC, group_stabilizer] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let GROUP_ACTION_EQ ← prove
   r"!G s (a:A->X->X) g h x.
          group_action G s a /\
          g IN group_carrier G /\ h IN group_carrier G /\
          x IN s
          ==> (a g x = a h x <=>
               group_mul G (group_inv G g) h IN group_stabilizer G a x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_stabilizer, IN_ELIM_THM] THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV] THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o AP_TERM (← q r"(a:A->X->X) (group_inv G g)")),
      DISCH_THEN (MP_TAC o AP_TERM (← q r"(a:A->X->X) g"))] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [GROUP_ACTION_ALT]) THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV, GROUP_MUL_LINV, GROUP_MUL_ASSOC,
                 GROUP_MUL_RINV, GROUP_MUL_LID] THEN
    MESON_TAC [])

  let GROUP_ACTION_FIBRES ← prove
   r"!G s (a:A->X->X) h x.
          group_action G s a /\ h IN group_carrier G /\ x IN s
          ==> {g | g IN group_carrier G /\ (a:A->X->X) g x = a h x} =
              IMAGE (group_mul G h) (group_stabilizer G a x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE (← q r"!g. (!x. x IN u ==> (P x <=> g x IN t)) /\ t SUBSET u /\
          (!y. y IN u ==> f y IN u /\ g(f y) = y /\ f(g y) = y)
          ==> {x | x IN u /\ P x} = IMAGE f t")) THEN
    EXISTS_TAC (← q r"group_mul G (group_inv G h:A)") THEN
    REWRITE_TAC [GROUP_STABILIZER_SUBSET_CARRIER] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [GROUP_ACTION_EQ], ALL_TAC] THEN
    ASM_SIMP_TAC [GROUP_MUL_LINV, GROUP_MUL_RINV, GROUP_MUL_ASSOC,
                 GROUP_MUL, GROUP_INV, GROUP_MUL_LID])

  -- @@RETURN BEGIN
  return { group_action, GROUP_ACTION_ALT, GROUP_ACTION_MUL, GROUP_ACTION_LINV,
           GROUP_ACTION_RINV, GROUP_ACTION_BIJECTIVE, GROUP_ACTION_SURJECTIVE,
           GROUP_ACTION_INJECTIVE, GROUP_ACTION_ON_SUBSET, GROUP_ACTION_FROM_SUBGROUP,
           GROUP_ACTIONS_EQ_ON_GENERATORS, GROUP_ACTION_IMAGE, GROUP_ACTION_IMAGE_SIZED,
           group_stabilizer, GROUP_STABILIZER_SUBSET_CARRIER, FINITE_GROUP_STABILIZER,
           SUBGROUP_OF_GROUP_STABILIZER, GROUP_STABILIZER_NONEMPTY,
           GROUP_STABILIZER_SUBGROUP_GENERATED, GROUP_STABILIZER_ON_SUBGROUP,
           GROUP_ACTION_KERNEL_POINTWISE, GROUP_ACTION_EQ, GROUP_ACTION_FIBRES }
  -- @@RETURN END

structure GroupOrbits where
  -- @@FIELDS
  group_orbit : thm
  GROUP_ORBIT_IN_SET : thm
  IN_GROUP_ORBIT : thm
  GROUP_ORBIT : thm
  GROUP_ORBIT_SUBSET : thm
  GROUP_ORBIT_ON_SUBSET : thm
  FINITE_GROUP_ORBIT : thm
  GROUP_ORBIT_REFL_EQ : thm
  GROUP_ORBIT_REFL : thm
  IN_GROUP_ORBIT_SELF : thm
  GROUP_ORBIT_EMPTY : thm
  GROUP_ORBIT_EQ_EMPTY : thm
  GROUP_ORBIT_SYM_EQ : thm
  GROUP_ORBIT_SYM : thm
  GROUP_ORBIT_TRANS : thm
  GROUP_ORBIT_EQ : thm
  CLOSED_GROUP_ORBIT : thm
  GROUP_ORBIT_EQ_SING : thm
  GROUP_ORBIT_EQ_SING_SELF : thm
  GROUP_ORBIT_HAS_SIZE_1 : thm
  GROUP_ACTION_INVARIANT_SUBSET : thm
  GROUP_ACTION_CLOSED : thm
  GROUP_ACTION_INVARIANT : thm
  INVARIANT_GROUP_ORBIT : thm
  SUBSET_GROUP_ORBIT_CLOSED : thm
  SUBSET_GROUP_ORBIT_INVARIANT : thm
  GROUP_ORBITS_EQ : thm
  DISJOINT_GROUP_ORBITS : thm
  PAIRWISE_DISJOINT_GROUP_ORBITS : thm
  UNIONS_GROUP_ORBITS_CLOSED : thm
  UNIONS_GROUP_ORBITS_INVARIANT : thm
  UNIONS_GROUP_ORBITS : thm
  NSUM_CARD_GROUP_ORBITS : thm
  deriving Inhabited

@[nospecialize]
def setupGroupOrbits [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BGroupActions : GroupActions) :
    ExceptT String IO GroupOrbits := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, HAS_SIZE_CONV, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CARD_UNIONS, .. } := D.core1
  let { DISJOINT, EMPTY_SUBSET, ETA_AX, .. } := D.core2
  let { EXTENSION, FINITE_IMAGE, FINITE_SUBSET, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core3
  let { IN, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_INSERT_EMPTY, PAIRWISE_IMAGE, .. } := D.core6
  let { SIMPLE_IMAGE, SUBSET, SUBSET_REFL, .. } := D.core7
  let { pairwise, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_LINV, GROUP_MUL_RINV, .. } := BBasics
  let { GROUP_ACTION_ALT, group_action, .. } := BGroupActions
  -- @@SCOPE END

  let group_orbit ← new_definition
   r"group_orbit G s (a:A->X->X) x y <=>
          x IN s /\ y IN s /\ ?g. g IN group_carrier G /\ a g x = y"

  let GROUP_ORBIT_IN_SET ← prove
   r"!G s (a:A->X->X) x y.
          group_orbit G s a x y ==> x IN s /\ y IN s"
   (SIMP_TAC [group_orbit])

  let IN_GROUP_ORBIT ← prove
   r"!G s (a:A->X->X) x y.
          y IN group_orbit G s a x <=>
          x IN s /\ y IN s /\ ?g. g IN group_carrier G /\ a g x = y"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [IN] THEN
    REWRITE_TAC [group_orbit])

  let GROUP_ORBIT ← prove
   r"!G s (a:A->X->X) x.
          group_action G s a
          ==> group_orbit G s a x =
              if x IN s then {a g x | g IN group_carrier G} else {}"
   (REWRITE_TAC [group_action] THEN REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ONCE_REWRITE_TAC [EXTENSION] THEN
    GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [IN] THEN
    ASM_REWRITE_TAC [group_orbit, IN_ELIM_THM] THEN ASM SET_TAC [])

  let GROUP_ORBIT_SUBSET ← prove
   r"!G s (a:A->X->X) x. group_orbit G s a x SUBSET s"
   (REWRITE_TAC [← SET_RULE (← q r"s SUBSET t <=> !x. s x ==> x IN t")] THEN
    REWRITE_TAC [group_orbit] THEN SET_TAC [])

  let GROUP_ORBIT_ON_SUBSET ← prove
   r"!G s t (a:A->X->X).
          t SUBSET s /\ x IN t
          ==> group_orbit G t a x = t INTER group_orbit G s a x"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"u = t INTER v <=> !x. u x <=> x IN t /\ v x")] THEN
    REWRITE_TAC [group_orbit] THEN ASM SET_TAC [])

  let FINITE_GROUP_ORBIT ← prove
   r"!G s (a:A->X->X) x.
          FINITE(group_carrier G) \/ FINITE s ==> FINITE(group_orbit G s a x)"
   (REPEAT STRIP_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [GROUP_ORBIT_SUBSET, FINITE_SUBSET]] THEN
    MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC (← q r"IMAGE (\g. (a:A->X->X) g x) (group_carrier G)") THEN
    ASM_SIMP_TAC [FINITE_IMAGE, ← SET_RULE (← q r"P SUBSET s <=> !x. P x ==> x IN s")] THEN
    REWRITE_TAC [IN_IMAGE, group_orbit] THEN SET_TAC [])

  let GROUP_ORBIT_REFL_EQ ← prove
   r"!G s (a:A->X->X) x.
          group_action G s a ==> (group_orbit G s a x x <=> x IN s)"
   (REWRITE_TAC [group_action, group_orbit] THEN MESON_TAC [GROUP_ID])

  let GROUP_ORBIT_REFL ← prove
   r"!G s (a:A->X->X) x.
          group_action G s a /\ x IN s
          ==> group_orbit G s a x x"
   (MESON_TAC [GROUP_ORBIT_REFL_EQ])

  let IN_GROUP_ORBIT_SELF ← prove
   r"!G s (a:A->X->X) x.
          group_action G s a /\ x IN s ==> x IN group_orbit G s a x"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [IN] THEN
    ASM_SIMP_TAC [GROUP_ORBIT_REFL])

  let GROUP_ORBIT_EMPTY ← prove
   r"!G s (a:A->X->X) x. ~(x IN s) ==> group_orbit G s a x = {}"
   (REWRITE_TAC [← SET_RULE (← q r"s = {} <=> !x. ~s x")] THEN SIMP_TAC [group_orbit])

  let GROUP_ORBIT_EQ_EMPTY ← prove
   r"!G s (a:A->X->X) x.
          group_action G s a
          ==> (group_orbit G s a x = {} <=> ~(x IN s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [GROUP_ORBIT_EMPTY] THEN
    ASM_MESON_TAC [MEMBER_NOT_EMPTY, IN_GROUP_ORBIT_SELF])

  let GROUP_ORBIT_SYM_EQ ← prove
   r"!G s (a:A->X->X) x y.
          group_action G s a
          ==> (group_orbit G s a x y <=> group_orbit G s a y x)"
   (REWRITE_TAC [group_action, group_orbit] THEN
    ASM_MESON_TAC [GROUP_INV, GROUP_MUL_LINV])

  let GROUP_ORBIT_SYM ← prove
   r"!G s (a:A->X->X) x y.
          group_action G s a /\ group_orbit G s a x y
          ==> group_orbit G s a y x"
   (MESON_TAC [GROUP_ORBIT_SYM_EQ])

  let GROUP_ORBIT_TRANS ← prove
   r"!G s (a:A->X->X) x y z.
          group_action G s a /\ group_orbit G s a x y /\ group_orbit G s a y z
          ==> group_orbit G s a x z"
   (REWRITE_TAC [group_action, group_orbit] THEN
    ASM_MESON_TAC [GROUP_MUL])

  let GROUP_ORBIT_EQ ← prove
   r"!G s (a:A->X->X) x y.
          group_action G s a /\ x IN s /\ y IN s
          ==> (group_orbit G s a x = group_orbit G s a y <=>
               group_orbit G s a x y)"
   (REWRITE_TAC [FUN_EQ_THM] THEN
    MESON_TAC [GROUP_ORBIT_REFL_EQ, GROUP_ORBIT_SYM_EQ, GROUP_ORBIT_TRANS])

  let CLOSED_GROUP_ORBIT ← prove
   r"!G s (a:A->X->X) x g.
          group_action G s a /\ g IN group_carrier G
          ==> IMAGE (a g) (group_orbit G s a x) SUBSET group_orbit G s a x"
   (REWRITE_TAC [group_action] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN REWRITE_TAC [IN] THEN
    REWRITE_TAC [group_orbit] THEN ASM_MESON_TAC [GROUP_MUL])

  let GROUP_ORBIT_EQ_SING ← prove
   r"!G s (a:A->X->X) x y.
          group_action G s a
          ==> (group_orbit G s a y = {x} <=>
               x IN s /\ y = x /\ !g. g IN group_carrier G ==> a g x = x)"
   (REPEAT STRIP_TAC THEN CONV_TAC (ONCE_DEPTH_CONV HAS_SIZE_CONV) THEN
    ASM_SIMP_TAC [GROUP_ORBIT] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [NOT_INSERT_EMPTY] THEN
    MP_TAC (← ISPEC (← q "G:A group") GROUP_ID) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_action]) THEN ASM SET_TAC [])

  let GROUP_ORBIT_EQ_SING_SELF ← prove
   r"!G s (a:A->X->X) x.
          group_action G s a
          ==> (group_orbit G s a x = {x} <=>
               x IN s /\ !g. g IN group_carrier G ==> a g x = x)"
   (SIMP_TAC [GROUP_ORBIT_EQ_SING])

  let GROUP_ORBIT_HAS_SIZE_1 ← prove
   r"!G s (a:A->X->X) x.
          group_action G s a
          ==> (group_orbit G s a x HAS_SIZE 1 <=>
               x IN s /\ !g. g IN group_carrier G ==> a g x = x)"
   (REPEAT STRIP_TAC THEN CONV_TAC (ONCE_DEPTH_CONV HAS_SIZE_CONV) THEN
    ASM_SIMP_TAC [GROUP_ORBIT_EQ_SING] THEN SET_TAC [])

  let GROUP_ACTION_INVARIANT_SUBSET ← prove
   r"!G s (a:A->X->X) t.
          group_action G s a /\ t SUBSET s
          ==> ((!g. g IN group_carrier G ==> IMAGE (a g) t SUBSET t) <=>
               (!g. g IN group_carrier G ==> IMAGE (a g) t = t))"
   (REWRITE_TAC [GROUP_ACTION_ALT] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THEN SIMP_TAC [SUBSET_REFL] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!g. (!x. x IN s ==> f(g x) = x /\ g(f x) = x) /\
          IMAGE f s SUBSET s /\ IMAGE g s SUBSET s
          ==> IMAGE f s = s")) THEN
    EXISTS_TAC (← q r"(a:A->X->X) (group_inv G g)") THEN
    ASM_SIMP_TAC [GROUP_INV] THEN RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [GROUP_INV, GROUP_MUL_LINV, GROUP_MUL_RINV])

  let GROUP_ACTION_CLOSED ← prove
   r"!G s (a:A->X->X) g.
          group_action G s a /\ g IN group_carrier G
          ==> IMAGE (a g) s SUBSET s"
   (REWRITE_TAC [group_action] THEN SET_TAC [])

  let GROUP_ACTION_INVARIANT ← prove
   r"!G s (a:A->X->X) g.
          group_action G s a /\ g IN group_carrier G
          ==> IMAGE (a g) s = s"
   (MESON_TAC [GROUP_ACTION_CLOSED, GROUP_ACTION_INVARIANT_SUBSET, SUBSET_REFL])

  let INVARIANT_GROUP_ORBIT ← prove
   r"!G s (a:A->X->X) x g.
          group_action G s a /\ g IN group_carrier G
          ==> IMAGE (a g) (group_orbit G s a x) = group_orbit G s a x"
   (MESON_TAC [GROUP_ACTION_INVARIANT_SUBSET, GROUP_ORBIT_SUBSET,
                  CLOSED_GROUP_ORBIT])

  let SUBSET_GROUP_ORBIT_CLOSED ← prove
   r"!G s (a:A->X->X) x t.
          group_action G s a /\ t SUBSET s /\
          (!g. g IN group_carrier G ==> IMAGE (a g) t SUBSET t)
          ==> (group_orbit G s a x SUBSET t <=>
               x IN s ==> ~DISJOINT (group_orbit G s a x) t)"
   (← do
     let a2 ← SET_RULE (← q r"~DISJOINT s t <=> ?z. z IN t /\ s z")
     let a1 ← SET_RULE (← q r"~(s = {}) /\ (~DISJOINT s t ==> s SUBSET t)
      ==> (s SUBSET t <=> ~DISJOINT s t)")
     pure (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(x:X) IN s") THEN
      ASM_SIMP_TAC [GROUP_ORBIT_EMPTY, EMPTY_SUBSET] THEN
      MATCH_MP_TAC a1 THEN
      ASM_SIMP_TAC [GROUP_ORBIT_EQ_EMPTY, LEFT_IMP_EXISTS_THM, a2] THEN
      X_GEN_TAC (← q "z:X") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      wPart lhand (rand o rand) GROUP_ORBIT_EQ THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      ASM_CASES_TAC (← q r"(z:X) IN s") THENL [DISCH_THEN SUBST1_TAC, ASM SET_TAC []] THEN
      ASM_SIMP_TAC [GROUP_ORBIT_EQ_EMPTY] THEN
      ASM_SIMP_TAC [GROUP_ORBIT] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [group_action]) THEN ASM SET_TAC []))

  let SUBSET_GROUP_ORBIT_INVARIANT ← prove
   r"!G s (a:A->X->X) x t.
          group_action G s a /\ t SUBSET s /\
          (!g. g IN group_carrier G ==> IMAGE (a g) t = t)
          ==> (group_orbit G s a x SUBSET t <=>
               x IN s ==> ~DISJOINT (group_orbit G s a x) t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_GROUP_ORBIT_CLOSED THEN
    ASM_SIMP_TAC [SUBSET_REFL])

  let GROUP_ORBITS_EQ ← prove
   r"!G s (a:A->X->X) x y.
          group_action G s a /\ x IN s /\ y IN s
          ==> (group_orbit G s a x = group_orbit G s a y <=>
               ~DISJOINT (group_orbit G s a x) (group_orbit G s a y))"
   (SIMP_TAC [GROUP_ORBIT_EQ, ← SET_RULE (← q r"DISJOINT s t <=> !x. ~(s x /\ t x)")] THEN
    MESON_TAC [GROUP_ORBIT_REFL_EQ, GROUP_ORBIT_SYM_EQ, GROUP_ORBIT_TRANS])

  let DISJOINT_GROUP_ORBITS ← prove
   r"!G s (a:A->X->X) x y.
          group_action G s a /\ x IN s /\ y IN s
          ==> (DISJOINT (group_orbit G s a x) (group_orbit G s a y) <=>
               ~(group_orbit G s a x = group_orbit G s a y))"
   (SIMP_TAC [GROUP_ORBITS_EQ])

  let PAIRWISE_DISJOINT_GROUP_ORBITS ← prove
   r"!G s (a:A->X->X).
          group_action G s a
          ==> pairwise DISJOINT {group_orbit G s a x |x| x IN s}"
   (REWRITE_TAC [SIMPLE_IMAGE, PAIRWISE_IMAGE] THEN
    SIMP_TAC [pairwise, DISJOINT_GROUP_ORBITS])

  let UNIONS_GROUP_ORBITS_CLOSED ← prove
   r"!G s (a:A->X->X) t.
          group_action G s a /\ t SUBSET s /\
          (!g. g IN group_carrier G ==> IMAGE (a g) t SUBSET t)
          ==> UNIONS {group_orbit G s a x |x| x IN t} = t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE (← q r"(!x. x IN t ==> x IN f x) /\
      (!x. x IN t /\ ~DISJOINT (f x) t ==> f x SUBSET t)
      ==> UNIONS {f x | x IN t} = t")) THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [IN_GROUP_ORBIT_SELF, SUBSET],
      ASM_MESON_TAC [SUBSET_GROUP_ORBIT_CLOSED, SUBSET]])

  let UNIONS_GROUP_ORBITS_INVARIANT ← prove
   r"!G s (a:A->X->X) t.
          group_action G s a /\ t SUBSET s /\
          (!g. g IN group_carrier G ==> IMAGE (a g) t = t)
          ==> UNIONS {group_orbit G s a x |x| x IN t} = t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC UNIONS_GROUP_ORBITS_CLOSED THEN
    ASM_SIMP_TAC [UNIONS_GROUP_ORBITS_CLOSED, SUBSET_REFL])

  let UNIONS_GROUP_ORBITS ← prove
   r"!G s (a:A->X->X).
          group_action G s a
          ==> UNIONS {group_orbit G s a x |x| x IN s} = s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC UNIONS_GROUP_ORBITS_INVARIANT THEN
    ASM_MESON_TAC [GROUP_ACTION_INVARIANT, SUBSET_REFL])

  let NSUM_CARD_GROUP_ORBITS ← prove
   r"!G s (a:A->X->X).
          group_action G s a /\ FINITE s
          ==> nsum {group_orbit G s a x | x | x IN s} CARD = CARD s"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    wPart rand (rand o rand) CARD_UNIONS THEN
    ASM_SIMP_TAC [UNIONS_GROUP_ORBITS, ← GSYM pairwise] THEN
    DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [← GSYM DISJOINT, ETA_AX] THEN
    ASM_SIMP_TAC [PAIRWISE_DISJOINT_GROUP_ORBITS] THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, FINITE_GROUP_ORBIT])

  -- @@RETURN BEGIN
  return { group_orbit, GROUP_ORBIT_IN_SET, IN_GROUP_ORBIT, GROUP_ORBIT,
           GROUP_ORBIT_SUBSET, GROUP_ORBIT_ON_SUBSET, FINITE_GROUP_ORBIT,
           GROUP_ORBIT_REFL_EQ, GROUP_ORBIT_REFL, IN_GROUP_ORBIT_SELF, GROUP_ORBIT_EMPTY,
           GROUP_ORBIT_EQ_EMPTY, GROUP_ORBIT_SYM_EQ, GROUP_ORBIT_SYM, GROUP_ORBIT_TRANS,
           GROUP_ORBIT_EQ, CLOSED_GROUP_ORBIT, GROUP_ORBIT_EQ_SING,
           GROUP_ORBIT_EQ_SING_SELF, GROUP_ORBIT_HAS_SIZE_1,
           GROUP_ACTION_INVARIANT_SUBSET, GROUP_ACTION_CLOSED, GROUP_ACTION_INVARIANT,
           INVARIANT_GROUP_ORBIT, SUBSET_GROUP_ORBIT_CLOSED,
           SUBSET_GROUP_ORBIT_INVARIANT, GROUP_ORBITS_EQ, DISJOINT_GROUP_ORBITS,
           PAIRWISE_DISJOINT_GROUP_ORBITS, UNIONS_GROUP_ORBITS_CLOSED,
           UNIONS_GROUP_ORBITS_INVARIANT, UNIONS_GROUP_ORBITS, NSUM_CARD_GROUP_ORBITS }
  -- @@RETURN END

structure OrbitStabilizer where
  -- @@FIELDS
  ORBIT_STABILIZER_MUL_GEN : thm
  ORBIT_STABILIZER_MUL : thm
  CARD_GROUP_ORBIT_DIVIDES : thm
  CARD_GROUP_STABILIZER_DIVIDES : thm
  GROUP_STABILIZER_OF_ACTION : thm
  GROUP_ACTION_SUBGROUP_TRANSLATION : thm
  GROUP_STABILIZER_SUBGROUP_TRANSLATION : thm
  GROUP_ACTION_GROUP_TRANSLATION : thm
  GROUP_STABILIZER_GROUP_TRANSLATION : thm
  GROUP_ACTION_SUBSET_TRANSLATION : thm
  GROUP_ACTION_CONJUGATION : thm
  CARD_GROUP_SETMUL_GEN : thm
  CARD_GROUP_SETMUL_MUL : thm
  CARD_GROUP_SETMUL : thm
  CARD_GROUP_SETMUL_DIVIDES : thm
  GROUP_ORBIT_COMMON_DIVISOR : thm
  GROUP_ORBIT_COMMON_INDEX : thm
  deriving Inhabited

@[nospecialize]
def setupOrbitStabilizer [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BGroupRule : GroupRule) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) (BSetwise1 : Setwise1) (BGroupActions : GroupActions) (BGroupOrbits : GroupOrbits) :
    ExceptT String IO OrbitStabilizer := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, NUMBER_RULE, .. } := D
  let { ADD_CLAUSES, CARD_CLAUSES, CARD_EQ_0, CARD_EQ_CARD, CARD_EQ_CONG,
        CARD_EQ_IMAGE, CARD_EQ_IMAGE_MUL_FIBRES, CARD_EQ_REFL, CARD_EQ_REFL_IMP,
        CARD_EQ_TRANS, CARD_MUL_C, CARD_MUL_CONG, CARD_MUL_FINITE, CARD_MUL_FINITE_EQ,
        CARD_UNIONS, CONJ_ASSOC, .. } := D.core1
  let { CROSS, DISJOINT, DIVIDES_0, DIVIDES_NSUM, DIV_UNIQ, EQ_IMP, EQ_TRANS,
        EXISTS_PAIR_THM, .. } := D.core2
  let { EXTENSION, FINITE_IMAGE, FINITE_INTER, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FORALL_PAIR_THM, .. } := D.core3
  let { IMAGE_EQ_EMPTY, IMP_CONJ, .. } := D.core4
  let { IN_CROSS, IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_IMAGE, IN_INTER, .. } := D.core5
  let { LE_INDEX, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, PAIR_EQ, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, SUBSET_RESTRICT,
        UNWIND_THM1, mul_c, .. } := D.core7
  let { GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, .. } := BBasics
  let { GROUP_MUL_LCANCEL_IMP, .. } := BDerived
  let { GROUP_RULE, GROUP_TAC, .. } := BGroupRule
  let { GROUP_CONJUGATION, GROUP_CONJUGATION_BY_ID, GROUP_CONJUGATION_CONJUGATION,
        IMAGE_GROUP_CONJUGATION_EQ_PREIMAGE, group_conjugation, .. } := BConjugation
  let { CARRIER_SUBGROUP_OF, SUBGROUP_OF_IMP_NONEMPTY, SUBGROUP_OF_INTER, subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_GROUP_CARRIER, .. } := BSubgroupGen1
  let { PROD_GROUP, .. } := BProdGroup
  let { FINITE_GROUP_SETMUL, group_setmul, .. } := BSetwise1
  let { FINITE_GROUP_STABILIZER, GROUP_ACTION_ALT, GROUP_ACTION_FIBRES,
        GROUP_ACTION_IMAGE, GROUP_ACTION_INJECTIVE, group_action, group_stabilizer, .. } := BGroupActions
  let { DISJOINT_GROUP_ORBITS, FINITE_GROUP_ORBIT, GROUP_ORBIT, GROUP_ORBIT_EQ_EMPTY,
        GROUP_ORBIT_SUBSET, UNIONS_GROUP_ORBITS, .. } := BGroupOrbits
  -- @@SCOPE END

  let ORBIT_STABILIZER_MUL_GEN ← prove
   r"!G s (a:A->X->X) x.
      group_action G s a /\ x IN s
      ==> group_orbit G s a x *_c group_stabilizer G a x =_c group_carrier G"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [GROUP_ORBIT, SIMPLE_IMAGE] THEN
    MATCH_MP_TAC CARD_EQ_IMAGE_MUL_FIBRES THEN
    X_GEN_TAC (← q "g:A") THEN DISCH_TAC THEN REWRITE_TAC [] THEN FIRST_ASSUM
     (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] GROUP_ACTION_FIBRES)) THEN
    ASM_SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
    MATCH_MP_TAC CARD_EQ_IMAGE THEN
    REWRITE_TAC [group_stabilizer, IN_ELIM_THM] THEN
    ASM_MESON_TAC [GROUP_MUL_LCANCEL_IMP])

  let ORBIT_STABILIZER_MUL ← prove
   r"!G s (a:A->X->X) x.
      FINITE(group_carrier G) /\ group_action G s a /\ x IN s
      ==> CARD(group_orbit G s a x) * CARD(group_stabilizer G a x) =
          CARD(group_carrier G)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ORBIT_STABILIZER_MUL_GEN) THEN
    ASM_SIMP_TAC [FINITE_GROUP_STABILIZER, FINITE_GROUP_ORBIT, CARD_EQ_CARD,
                  CARD_MUL_FINITE, CARD_MUL_C])

  let CARD_GROUP_ORBIT_DIVIDES ← prove
   r"!G s (a:A->X->X) x.
          FINITE(group_carrier G) /\ group_action G s a /\ x IN s
          ==> CARD(group_orbit G s a x) divides CARD(group_carrier G)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (SUBST1_TAC o SYM o MATCH_MP ORBIT_STABILIZER_MUL) THEN
    CONV_TAC NUMBER_RULE)

  let CARD_GROUP_STABILIZER_DIVIDES ← prove
   r"!G s (a:A->X->X) x.
          FINITE(group_carrier G) /\ group_action G s a /\ x IN s
          ==> CARD(group_stabilizer G a x) divides CARD(group_carrier G)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (SUBST1_TAC o SYM o MATCH_MP ORBIT_STABILIZER_MUL) THEN
    CONV_TAC NUMBER_RULE)

  let GROUP_STABILIZER_OF_ACTION ← prove
   r"!G s (a:A->X->X) g x.
          group_action G s a /\ g IN group_carrier G /\ x IN s
          ==> group_stabilizer G a (a g x) =
              IMAGE (group_conjugation G g) (group_stabilizer G a x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_stabilizer] THEN
    CONV_TAC SYM_CONV THEN
    ASM_SIMP_TAC [IMAGE_GROUP_CONJUGATION_EQ_PREIMAGE, SUBSET_RESTRICT] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, group_conjugation] THEN
    X_GEN_TAC (← q "h:A") THEN ASM_CASES_TAC (← q r"(h:A) IN group_carrier G") THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [GROUP_ACTION_ALT]) THEN
    ASM (simpTac (← ExceptT.mk (D.basic_ss [])) 4)
        [GROUP_MUL, GROUP_INV] THEN
    DISCH_THEN (K ALL_TAC) THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL, GROUP_INV,
                 GROUP_MUL_LINV, GROUP_MUL_RID] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [group_action]) THEN
    ASM_SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
    MATCH_MP_TAC GROUP_ACTION_INJECTIVE THEN
    ASM_MESON_TAC [group_action])

  let GROUP_ACTION_SUBGROUP_TRANSLATION ← prove
   r"!G (h:A->bool).
      group_action (subgroup_generated G h) (group_carrier G) (group_mul G)"
   (REWRITE_TAC [group_action, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    REPEAT STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP
     (← REWRITE_RULE [SUBSET] GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET))) THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_MUL_LID, GROUP_MUL_ASSOC])

  let GROUP_STABILIZER_SUBGROUP_TRANSLATION ← prove
   r"!G h a:A.
          h subgroup_of G /\ a IN group_carrier G
          ==> group_stabilizer (subgroup_generated G h) (group_mul G) a =
              {group_id G}"
   (← do
      let a2 ← GROUP_RULE (← q
         r"group_mul G g a = a <=> g = group_id G")
      let a1 ← D.SET_RULE (← q
         r"a IN s /\ (!x. x IN s ==> (P x <=> x = a))
          ==> {x | x IN s /\ P x} = {a}")
      pure (REPEAT STRIP_TAC THEN
       ASM_SIMP_TAC [group_stabilizer, CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
       MATCH_MP_TAC a1 THEN
       ASM_MESON_TAC [subgroup_of, SUBSET, a2]))

  let GROUP_ACTION_GROUP_TRANSLATION ← prove
   r"!G. group_action G (group_carrier G) (group_mul G)"
   (MESON_TAC [GROUP_ACTION_SUBGROUP_TRANSLATION,
              SUBGROUP_GENERATED_GROUP_CARRIER])

  let GROUP_STABILIZER_GROUP_TRANSLATION ← prove
   r"!G a:A.
          a IN group_carrier G
          ==> group_stabilizer G (group_mul G) a = {group_id G}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"group_carrier G:A->bool", ← q "a:A"]
          GROUP_STABILIZER_SUBGROUP_TRANSLATION) THEN
    ASM_REWRITE_TAC [CARRIER_SUBGROUP_OF, SUBGROUP_GENERATED_GROUP_CARRIER])

  let GROUP_ACTION_SUBSET_TRANSLATION ← prove
   r"!(G:A group) u.
        (!s. s IN u ==> s SUBSET group_carrier G) /\
        (!a s. a IN group_carrier G /\ s IN u ==> IMAGE (group_mul G a) s IN u)
        ==> group_action G u (IMAGE o group_mul G)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ACTION_IMAGE THEN
    ASM_MESON_TAC [GROUP_ACTION_GROUP_TRANSLATION])

  let GROUP_ACTION_CONJUGATION ← prove
   r"!G:A group. group_action G (group_carrier G) (group_conjugation G)"
   (REWRITE_TAC [group_action] THEN
    SIMP_TAC [GROUP_CONJUGATION, GROUP_CONJUGATION_BY_ID,
             ← GSYM GROUP_CONJUGATION_CONJUGATION])

  let CARD_GROUP_SETMUL_GEN ← prove
   r"!G g h:A->bool.
          g subgroup_of G /\ h subgroup_of G
          ==> (group_setmul G g h) *_c (g INTER h) =_c g *_c h"
   (← do
      let a2 ← D.SET_RULE (← q
         r"{z | z IN {x,y | P x y} /\ Q z} = {x,y | P x y /\ Q(x,y)}")
      let a1 ← D.TAUT (← q r"p /\ (p ==> q ==> r) ==> (p ==> q) ==> r")
      pure (REPEAT STRIP_TAC THEN
       MP_TAC (← ISPECL
        [← q r"prod_group (subgroup_generated G g) (subgroup_generated G h:A group)",
         ← q r"group_setmul (G:A group) g h",
         ← q r"\(x,y) (z:A). group_mul G x (group_mul G z (group_inv G y))",
         ← q "group_id G:A"]
        ORBIT_STABILIZER_MUL_GEN) THEN
       MATCH_MP_TAC a1 THEN
       CONJ_TAC THENL
        [ASM_SIMP_TAC [group_action, PROD_GROUP, FORALL_PAIR_THM, IN_CROSS,
           ← CONJUNCT2 SUBGROUP_GENERATED, CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
         REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
         REWRITE_TAC [group_setmul, FORALL_IN_GSPEC] THEN
         REWRITE_TAC [IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
          [X_GEN_TAC (← q "x1:A") THEN DISCH_TAC THEN X_GEN_TAC (← q "y1:A") THEN DISCH_TAC THEN
           MAP_EVERY X_GEN_TAC [← q "x2:A", ← q "y2:A"] THEN STRIP_TAC THEN
           EXISTS_TAC (← q r"group_mul G x1 x2:A") THEN
           EXISTS_TAC (← q r"group_mul G y2 (group_inv G y1):A") THEN
           CONJ_TAC THENL [ASM_MESON_TAC [subgroup_of], ALL_TAC],
           ALL_TAC,
           ALL_TAC,
           REPEAT (EXISTS_TAC (← q "group_id G:A")) THEN
           ASM_MESON_TAC [subgroup_of, SUBSET, GROUP_MUL_LID]] THEN
         REPEAT STRIP_TAC THEN GROUP_TAC THEN
         ASM_MESON_TAC [subgroup_of, SUBSET],
         STRIP_TAC THEN MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC CARD_EQ_CONG THEN
         ASM_SIMP_TAC [PROD_GROUP, CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
         REWRITE_TAC [CROSS, ← GSYM mul_c, CARD_EQ_REFL]] THEN
       MATCH_MP_TAC CARD_MUL_CONG THEN CONJ_TAC THENL
        [MATCH_MP_TAC CARD_EQ_REFL_IMP THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
         REWRITE_TAC [GROUP_ORBIT_SUBSET] THEN ASM_SIMP_TAC [GROUP_ORBIT] THEN
         REWRITE_TAC [SUBSET, group_setmul, FORALL_IN_GSPEC] THEN
         MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
         ASM_SIMP_TAC [IN_ELIM_THM, PROD_GROUP, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                      EXISTS_PAIR_THM, IN_CROSS] THEN
         MAP_EVERY EXISTS_TAC [← q "x:A", ← q r"group_inv G y:A"] THEN
         CONJ_TAC THENL [ASM_MESON_TAC [subgroup_of], ALL_TAC] THEN
         GROUP_TAC THEN ASM_MESON_TAC [subgroup_of, SUBSET],
         TRANS_TAC CARD_EQ_TRANS (← q r"IMAGE (\x:A. x,x) (g INTER h)") THEN
         SIMP_TAC [CARD_EQ_IMAGE, FORALL_PAIR_THM, PAIR_EQ] THEN
         MATCH_MP_TAC CARD_EQ_REFL_IMP THEN
         ASM_SIMP_TAC [IN_ELIM_THM, PROD_GROUP, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                      group_stabilizer] THEN
         REWRITE_TAC [CROSS, a2] THEN
         GEN_REWRITE_TAC I [EXTENSION] THEN
         REWRITE_TAC [FORALL_PAIR_THM, IN_IMAGE, PAIR_EQ, IN_ELIM_PAIR_THM] THEN
         REWRITE_TAC [← GSYM CONJ_ASSOC, UNWIND_THM1, IN_INTER] THEN
         MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN
         ASM_CASES_TAC (← q r"(x:A) IN g") THEN ASM_REWRITE_TAC [] THEN
         ASM_CASES_TAC (← q r"(y:A) IN h") THEN ASM_REWRITE_TAC [] THENL
          [ALL_TAC, ASM_MESON_TAC []] THEN
         TRANS_TAC EQ_TRANS (← q r"y:A = x") THEN
         CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
         GROUP_TAC THEN ASM_MESON_TAC [subgroup_of, SUBSET]]))

  let CARD_GROUP_SETMUL_MUL ← prove
   r"!G g h:A->bool.
          FINITE g /\ FINITE h /\ g subgroup_of G /\ h subgroup_of G
          ==> CARD(group_setmul G g h) * CARD(g INTER h) = CARD g * CARD h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"g:A->bool", ← q r"h:A->bool"]
          CARD_GROUP_SETMUL_GEN) THEN
    ASM_SIMP_TAC [CARD_EQ_CARD, FINITE_GROUP_SETMUL, FINITE_INTER,
                 CARD_MUL_FINITE_EQ, CARD_MUL_C])

  let CARD_GROUP_SETMUL ← prove
   r"!G g h:A->bool.
          FINITE g /\ FINITE h /\ g subgroup_of G /\ h subgroup_of G
          ==> CARD(group_setmul G g h) = (CARD g * CARD h) DIV CARD(g INTER h)"
   (← do
      let a1 ← D.ARITH_RULE (← q r"~(n = 0) ==> 0 < n")
      pure (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC DIV_UNIQ THEN
       EXISTS_TAC (← q "0") THEN ASM_SIMP_TAC [ADD_CLAUSES, CARD_GROUP_SETMUL_MUL] THEN
       MATCH_MP_TAC a1 THEN
       ASM_SIMP_TAC [CARD_EQ_0, FINITE_INTER] THEN
       MATCH_MP_TAC SUBGROUP_OF_IMP_NONEMPTY THEN
       ASM_MESON_TAC [SUBGROUP_OF_INTER]))

  let CARD_GROUP_SETMUL_DIVIDES ← prove
   r"!G g h:A->bool.
          FINITE g /\ FINITE h /\ g subgroup_of G /\ h subgroup_of G
          ==> CARD(group_setmul G g h) divides CARD(g) * CARD(h)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [← GSYM CARD_GROUP_SETMUL_MUL] THEN
    CONV_TAC NUMBER_RULE)

  let GROUP_ORBIT_COMMON_DIVISOR ← prove
   r"!G s (a:A->X->X) n.
          group_action G s a /\
          FINITE s /\
          (!x. x IN s ==> n divides CARD(group_orbit G s a x))
          ==> n divides CARD s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP UNIONS_GROUP_ORBITS) THEN
    wPart rand (fun t => do lhand (← rand t)) CARD_UNIONS THEN
    ASM_SIMP_TAC [FINITE_IMAGE, SIMPLE_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ,
                 RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE, FINITE_GROUP_ORBIT,
                 IMP_CONJ, ← GSYM DISJOINT, DISJOINT_GROUP_ORBITS] THEN
    DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC DIVIDES_NSUM THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, FINITE_IMAGE])

  let GROUP_ORBIT_COMMON_INDEX ← prove
   r"!G s (a:A->X->X) p k.
          group_action G s a /\
          FINITE s /\ (s = {} ==> k = 0) /\
          (!x. x IN s ==> k <= index p (CARD(group_orbit G s a x)))
          ==> k <= index p (CARD s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LE_INDEX] THEN
    SIMP_TAC [FINITE_GROUP_ORBIT, CARD_EQ_0, GROUP_ORBIT_EQ_EMPTY, IMP_CONJ] THEN
    ASM_CASES_TAC (← q r"s:X->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, CARD_CLAUSES, DIVIDES_0] THEN
    ASM_MESON_TAC [GROUP_ORBIT_COMMON_DIVISOR, MEMBER_NOT_EMPTY])

  -- @@RETURN BEGIN
  return { ORBIT_STABILIZER_MUL_GEN, ORBIT_STABILIZER_MUL, CARD_GROUP_ORBIT_DIVIDES,
           CARD_GROUP_STABILIZER_DIVIDES, GROUP_STABILIZER_OF_ACTION,
           GROUP_ACTION_SUBGROUP_TRANSLATION, GROUP_STABILIZER_SUBGROUP_TRANSLATION,
           GROUP_ACTION_GROUP_TRANSLATION, GROUP_STABILIZER_GROUP_TRANSLATION,
           GROUP_ACTION_SUBSET_TRANSLATION, GROUP_ACTION_CONJUGATION,
           CARD_GROUP_SETMUL_GEN, CARD_GROUP_SETMUL_MUL, CARD_GROUP_SETMUL,
           CARD_GROUP_SETMUL_DIVIDES, GROUP_ORBIT_COMMON_DIVISOR,
           GROUP_ORBIT_COMMON_INDEX }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Right and left cosets.                                                    -/
/- ------------------------------------------------------------------------- -/

structure Cosets where
  -- @@FIELDS
  right_coset : thm
  left_coset : thm
  LEFT_COSET_AS_IMAGE : thm
  RIGHT_COSET : thm
  LEFT_COSET : thm
  IN_RIGHT_COSET : thm
  IN_LEFT_COSET : thm
  IN_RIGHT_COSET_INV : thm
  IN_LEFT_COSET_INV : thm
  GROUP_SETINV_LEFT_COSET_GEN : thm
  GROUP_SETINV_RIGHT_COSET_GEN : thm
  RIGHT_COSET_OPPOSITE_GROUP : thm
  LEFT_COSET_OPPOSITE_GROUP : thm
  GROUP_CONJUGATION_RIGHT_COSET : thm
  RIGHT_COSET_GROUP_CONJUGATION : thm
  LEFT_COSET_LEFT_COSET : thm
  RIGHT_COSET_RIGHT_COSET : thm
  RIGHT_COSET_ID : thm
  LEFT_COSET_ID : thm
  LEFT_COSET_TRIVIAL : thm
  RIGHT_COSET_TRIVIAL : thm
  LEFT_COSET_CARRIER : thm
  RIGHT_COSET_CARRIER : thm
  RIGHT_COSET_EQ : thm
  LEFT_COSET_EQ : thm
  RIGHT_COSET_EQ_SUBGROUP : thm
  LEFT_COSET_EQ_SUBGROUP : thm
  RIGHT_COSET_EQ_EMPTY : thm
  LEFT_COSET_EQ_EMPTY : thm
  RIGHT_COSET_NONEMPTY : thm
  LEFT_COSET_NONEMPTY : thm
  IN_RIGHT_COSET_SELF : thm
  deriving Inhabited

@[nospecialize]
def setupCosets [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BSubgroups : Subgroups) (BSetwise1 : Setwise1) (BSetwise2 : Setwise2) :
    ExceptT String IO Cosets := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_TAC, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, .. } := D.core1
  let { IMAGE_EQ, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, NOT_INSERT_EMPTY, .. } := D.core6
  let { RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET,
        SUBSET, UNWIND_THM2, .. } := D.core7
  let { o_DEF, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, OPPOSITE_GROUP, .. } := BBasics
  let { FORALL_IN_GROUP_CARRIER_INV, GROUP_INV_INV, GROUP_INV_MUL, .. } := BDerived
  let { CARRIER_SUBGROUP_OF, IN_SUBGROUP_INV, SUBGROUP_OF_IMP_NONEMPTY,
        SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { GROUP_SETINV_AS_IMAGE, GROUP_SETMUL, GROUP_SETMUL_ASSOC, GROUP_SETMUL_EQ_EMPTY,
        GROUP_SETMUL_LSUBSET, GROUP_SETMUL_LSUBSET_EQ, GROUP_SETMUL_RID,
        GROUP_SETMUL_RSUBSET, GROUP_SETMUL_SING, OPPOSITE_GROUP_SETMUL, group_setmul, .. } := BSetwise1
  let { GROUP_SETMUL_LCANCEL_SET, GROUP_SETMUL_RCANCEL_SET, GROUP_SETMUL_RSUBSET_EQ,
        IMAGE_GROUP_CONJUGATION, .. } := BSetwise2
  -- @@SCOPE END

  let right_coset ← D.new_definition
   r"right_coset G h x = group_setmul G h {x}"

  let left_coset ← D.new_definition
   r"left_coset G x h = group_setmul G {x} h"

  let LEFT_COSET_AS_IMAGE ← prove
   r"!(x:A) h. left_coset G x h = IMAGE (group_mul G x) h"
   (REWRITE_TAC [left_coset, group_setmul] THEN SET_TAC [])

  let RIGHT_COSET ← prove
   r"!G h x:A.
          x IN group_carrier G /\ h SUBSET group_carrier G
          ==> right_coset G h x SUBSET group_carrier G"
   (SIMP_TAC [right_coset, GROUP_SETMUL, SING_SUBSET])

  let LEFT_COSET ← prove
   r"!G h x:A.
          x IN group_carrier G /\ h SUBSET group_carrier G
          ==> left_coset G x h SUBSET group_carrier G"
   (SIMP_TAC [left_coset, GROUP_SETMUL, SING_SUBSET])

  let IN_RIGHT_COSET ← prove
   r"!G h x a:A.
          h SUBSET group_carrier G /\
          a IN group_carrier G /\ x IN group_carrier G
          ==> (x IN right_coset G h a <=>
               group_mul G x (group_inv G a) IN h)"
   (← do
      let a2 ← D.MESON [] (← q r"P a ==> a IN h ==> ?y. y IN h /\ P y")
      let a1 ← D.TAUT (← q r"(p /\ q) /\ r <=> q /\ p /\ r")
      pure (REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN
       REWRITE_TAC [right_coset, group_setmul, IN_ELIM_THM, IN_SING] THEN
       REWRITE_TAC [a1, UNWIND_THM2] THEN
       EQ_TAC THENL
        [ALL_TAC,
         MATCH_MP_TAC a2] THEN
       ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, ← GSYM GROUP_MUL_ASSOC, GROUP_MUL_LINV,
                    GROUP_MUL_RINV, GROUP_MUL_RID, GROUP_INV]))

  let IN_LEFT_COSET ← prove
   r"!G h x a:A.
          h SUBSET group_carrier G /\
          a IN group_carrier G /\ x IN group_carrier G
          ==> (x IN left_coset G a h <=>
               group_mul G (group_inv G a) x IN h)"
   (← do
      let a1 ← D.MESON [] (← q r"P a ==> a IN h ==> ?y. y IN h /\ P y")
      pure (REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN
       REWRITE_TAC [left_coset, group_setmul, IN_ELIM_THM, IN_SING] THEN
       REWRITE_TAC [← GSYM CONJ_ASSOC, UNWIND_THM2, RIGHT_EXISTS_AND_THM] THEN
       EQ_TAC THENL
        [ALL_TAC,
         MATCH_MP_TAC a1] THEN
       ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, GROUP_MUL_ASSOC, GROUP_MUL_LINV,
                    GROUP_MUL_RINV, GROUP_MUL_LID, GROUP_INV]))

  let IN_RIGHT_COSET_INV ← prove
   r"!G h x y:A.
          h SUBSET group_carrier G /\
          x IN group_carrier G /\ y IN group_carrier G
          ==> (x IN right_coset G h (group_inv G y) <=>
               group_mul G x y IN h)"
   (SIMP_TAC [IN_RIGHT_COSET, GROUP_INV, GROUP_INV_INV])

  let IN_LEFT_COSET_INV ← prove
   r"!G h x y:A.
          h SUBSET group_carrier G /\
          x IN group_carrier G /\ y IN group_carrier G
          ==> (x IN left_coset G (group_inv G y) h <=>
               group_mul G y x IN h)"
   (SIMP_TAC [IN_LEFT_COSET, GROUP_INV, GROUP_INV_INV])

  let (GROUP_SETINV_LEFT_COSET_GEN, GROUP_SETINV_RIGHT_COSET_GEN) ←
   CONJ_PAIR (← prove
   r"(!G h a:A.
          h subgroup_of G /\ a IN group_carrier G
          ==> group_setinv G (left_coset G a h) =
              right_coset G h (group_inv G a)) /\
     (!G h a:A.
          h subgroup_of G /\ a IN group_carrier G
          ==> group_setinv G (right_coset G h a) =
              left_coset G (group_inv G a) h)"
   (← do
      let a2 ← D.SET_RULE (← q
         r"!u. s SUBSET u /\ t SUBSET u /\ (!x. x IN u ==> f(f x) = x) /\
              (!x. x IN u ==> (f x IN t <=> x IN s)) /\
              (!x. x IN u ==> (f x IN s <=> x IN t))
              ==> IMAGE f s = t /\ IMAGE f t = s")
      let a1 ← D.TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")
      pure (REWRITE_TAC [GROUP_SETINV_AS_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
       GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
        [← GSYM FORALL_IN_GROUP_CARRIER_INV] THEN
       REWRITE_TAC [RIGHT_IMP_FORALL_THM, AND_FORALL_THM, IMP_IMP] THEN
       REPEAT GEN_TAC THEN SIMP_TAC [GROUP_INV_INV] THEN
       REWRITE_TAC [a1] THEN
       DISCH_TAC THEN MATCH_MP_TAC a2 THEN
       EXISTS_TAC (← q r"group_carrier G:A->bool") THEN
       ASM_SIMP_TAC [IN_LEFT_COSET, IN_RIGHT_COSET, SUBGROUP_OF_IMP_SUBSET,
                    GROUP_INV_INV, GROUP_INV, LEFT_COSET, RIGHT_COSET] THEN
       REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
       FIRST_X_ASSUM (MP_TAC o ISPEC (← q "G:A group") o
         MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] IN_SUBGROUP_INV)) THEN
       ASM_SIMP_TAC [GROUP_INV_MUL, GROUP_INV_INV, GROUP_INV])))

  let RIGHT_COSET_OPPOSITE_GROUP ← prove
   r"!G h x:A. right_coset G h x = left_coset (opposite_group G) x h"
   (REWRITE_TAC [left_coset, right_coset, OPPOSITE_GROUP_SETMUL])

  let LEFT_COSET_OPPOSITE_GROUP ← prove
   r"!G h x:A. left_coset G x h = right_coset (opposite_group G) h x"
   (REWRITE_TAC [left_coset, right_coset, OPPOSITE_GROUP_SETMUL])

  let GROUP_CONJUGATION_RIGHT_COSET ← prove
   r"!G h x:A.
       x IN group_carrier G /\ h SUBSET group_carrier G
       ==> IMAGE (group_conjugation G x) (right_coset G h x) = left_coset G x h"
   (REWRITE_TAC [IMAGE_GROUP_CONJUGATION, left_coset, right_coset] THEN
    SIMP_TAC [← GSYM GROUP_SETMUL_ASSOC, SING_SUBSET, GROUP_SETMUL,
             GROUP_INV, GROUP_SETMUL_SING, GROUP_MUL_RINV, GROUP_SETMUL_RID])

  let RIGHT_COSET_GROUP_CONJUGATION ← prove
   r"!G h x:A.
       x IN group_carrier G /\ h SUBSET group_carrier G
       ==> right_coset G (IMAGE (group_conjugation G x) h) x =
           left_coset G x h"
   (REWRITE_TAC [IMAGE_GROUP_CONJUGATION, left_coset, right_coset] THEN
    SIMP_TAC [← GSYM GROUP_SETMUL_ASSOC, SING_SUBSET, GROUP_SETMUL,
             GROUP_INV, GROUP_SETMUL_SING, GROUP_MUL_LINV, GROUP_SETMUL_RID])

  let LEFT_COSET_LEFT_COSET ← prove
   r"!x y h:A->bool.
          x IN group_carrier G /\
          y IN group_carrier G /\
          h SUBSET group_carrier G
          ==> left_coset G x (left_coset G y h) =
              left_coset G (group_mul G x y) h"
   (REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [LEFT_COSET_AS_IMAGE, ← GSYM IMAGE_o, o_DEF] THEN
    MATCH_MP_TAC IMAGE_EQ THEN
    ASM_SIMP_TAC [GROUP_MUL_ASSOC, SUBSET])

  let RIGHT_COSET_RIGHT_COSET ← prove
   r"!x y h:A->bool.
          h SUBSET group_carrier G /\
          x IN group_carrier G /\
          y IN group_carrier G
          ==> right_coset G (right_coset G h x) y =
              right_coset G h (group_mul G x y)"
   (REWRITE_TAC [RIGHT_COSET_OPPOSITE_GROUP] THEN
    SIMP_TAC [LEFT_COSET_LEFT_COSET, OPPOSITE_GROUP])

  let RIGHT_COSET_ID ← prove
   r"!G h:A->bool.
          h SUBSET group_carrier G ==> right_coset G h (group_id G) = h"
   (← do
      let a2 ← D.SET_RULE (← q
         r"(!x. x IN s ==> f x = x) ==> {f x | x IN s} = s")
      let a1 ← D.SET_RULE (← q
         r"{f x y | P x /\ y IN {a}} = {f x a | P x}")
      pure (SIMP_TAC [right_coset, group_setmul, a1] THEN
       REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN MATCH_MP_TAC a2 THEN
       ASM_SIMP_TAC [GROUP_MUL_RID]))

  let LEFT_COSET_ID ← prove
   r"!G h:A->bool.
          h SUBSET group_carrier G ==> left_coset G (group_id G) h = h"
   (MESON_TAC [RIGHT_COSET_ID, LEFT_COSET_OPPOSITE_GROUP, OPPOSITE_GROUP])

  let LEFT_COSET_TRIVIAL ← prove
   r"!G x:A. x IN group_carrier G ==> left_coset G x {group_id G} = {x}"
   (SIMP_TAC [left_coset, GROUP_SETMUL_SING, GROUP_ID, GROUP_MUL_RID])

  let RIGHT_COSET_TRIVIAL ← prove
   r"!G x:A. x IN group_carrier G ==> right_coset G {group_id G} x = {x}"
   (SIMP_TAC [right_coset, GROUP_SETMUL_SING, GROUP_ID, GROUP_MUL_LID])

  let LEFT_COSET_CARRIER ← prove
   r"!G x:A. x IN group_carrier G
             ==> left_coset G x (group_carrier G) = group_carrier G"
   (SIMP_TAC [left_coset, GROUP_SETMUL_LSUBSET, SING_SUBSET, NOT_INSERT_EMPTY,
             CARRIER_SUBGROUP_OF])

  let RIGHT_COSET_CARRIER ← prove
   r"!G x:A. x IN group_carrier G
             ==> right_coset G (group_carrier G) x = group_carrier G"
   (SIMP_TAC [right_coset, GROUP_SETMUL_RSUBSET, SING_SUBSET, NOT_INSERT_EMPTY,
             CARRIER_SUBGROUP_OF])

  let RIGHT_COSET_EQ ← prove
   r"!G h x y:A.
          h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
          ==> (right_coset G h x = right_coset G h y <=> group_div G x y IN h)"
   (SIMP_TAC [GROUP_SETMUL_LCANCEL_SET, right_coset])

  let LEFT_COSET_EQ ← prove
   r"!G h x y:A.
          h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
          ==> (left_coset G x h = left_coset G y h <=>
               group_mul G (group_inv G x) y IN h)"
   (SIMP_TAC [GROUP_SETMUL_RCANCEL_SET, left_coset])

  let RIGHT_COSET_EQ_SUBGROUP ← prove
   r"!G h x:A.
          h subgroup_of G /\ x IN group_carrier G
          ==> (right_coset G h x = h <=> x IN h)"
   (SIMP_TAC [right_coset, GROUP_SETMUL_RSUBSET_EQ, SING_SUBSET] THEN
    REWRITE_TAC [NOT_INSERT_EMPTY])

  let LEFT_COSET_EQ_SUBGROUP ← prove
   r"!G h x:A.
          h subgroup_of G /\ x IN group_carrier G
          ==> (left_coset G x h = h <=> x IN h)"
   (SIMP_TAC [left_coset, GROUP_SETMUL_LSUBSET_EQ, SING_SUBSET] THEN
    REWRITE_TAC [NOT_INSERT_EMPTY])

  let RIGHT_COSET_EQ_EMPTY ← prove
   r"!G h x:A. right_coset G h x = {} <=> h = {}"
   (REWRITE_TAC [right_coset, GROUP_SETMUL_EQ_EMPTY, NOT_INSERT_EMPTY])

  let LEFT_COSET_EQ_EMPTY ← prove
   r"!G h x:A. left_coset G x h = {} <=> h = {}"
   (REWRITE_TAC [left_coset, GROUP_SETMUL_EQ_EMPTY, NOT_INSERT_EMPTY])

  let RIGHT_COSET_NONEMPTY ← prove
   r"!G h x:A. h subgroup_of G ==> ~(right_coset G h x = {})"
   (REWRITE_TAC [RIGHT_COSET_EQ_EMPTY, SUBGROUP_OF_IMP_NONEMPTY])

  let LEFT_COSET_NONEMPTY ← prove
   r"!G h x:A. h subgroup_of G ==> ~(left_coset G x h = {})"
   (REWRITE_TAC [LEFT_COSET_EQ_EMPTY, SUBGROUP_OF_IMP_NONEMPTY])

  let IN_RIGHT_COSET_SELF ← prove
   r"!G h x:A.
        h subgroup_of G /\ x IN group_carrier G ==> x IN right_coset G h x"
   (REWRITE_TAC [subgroup_of, right_coset, group_setmul, IN_ELIM_THM, IN_SING] THEN
    MESON_TAC [GROUP_MUL_LID])

  -- @@RETURN BEGIN
  return { right_coset, left_coset, LEFT_COSET_AS_IMAGE, RIGHT_COSET, LEFT_COSET,
           IN_RIGHT_COSET, IN_LEFT_COSET, IN_RIGHT_COSET_INV, IN_LEFT_COSET_INV,
           GROUP_SETINV_LEFT_COSET_GEN, GROUP_SETINV_RIGHT_COSET_GEN,
           RIGHT_COSET_OPPOSITE_GROUP, LEFT_COSET_OPPOSITE_GROUP,
           GROUP_CONJUGATION_RIGHT_COSET, RIGHT_COSET_GROUP_CONJUGATION,
           LEFT_COSET_LEFT_COSET, RIGHT_COSET_RIGHT_COSET, RIGHT_COSET_ID, LEFT_COSET_ID,
           LEFT_COSET_TRIVIAL, RIGHT_COSET_TRIVIAL, LEFT_COSET_CARRIER,
           RIGHT_COSET_CARRIER, RIGHT_COSET_EQ, LEFT_COSET_EQ, RIGHT_COSET_EQ_SUBGROUP,
           LEFT_COSET_EQ_SUBGROUP, RIGHT_COSET_EQ_EMPTY, LEFT_COSET_EQ_EMPTY,
           RIGHT_COSET_NONEMPTY, LEFT_COSET_NONEMPTY, IN_RIGHT_COSET_SELF }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Cosets: membership, unions, disjointness and cardinality.                 -/
/- (grouptheory.ml 6052-6264)                                                -/
/- ------------------------------------------------------------------------- -/

structure Cosets1 where
  -- @@FIELDS
  IN_LEFT_COSET_SELF : thm
  UNIONS_RIGHT_COSETS : thm
  UNIONS_LEFT_COSETS : thm
  RIGHT_COSETS_EQ : thm
  LEFT_COSETS_EQ : thm
  DISJOINT_RIGHT_COSETS : thm
  DISJOINT_LEFT_COSETS : thm
  PAIRWISE_DISJOINT_RIGHT_COSETS : thm
  PAIRWISE_DISJOINT_LEFT_COSETS : thm
  IMAGE_RIGHT_COSET_SWITCH : thm
  IMAGE_LEFT_COSET_SWITCH : thm
  CARD_EQ_LEFT_RIGHT_COSETS : thm
  HAS_SIZE_LEFT_RIGHT_COSETS : thm
  CARD_EQ_RIGHT_COSETS : thm
  GROUP_ID_IN_LEFT_COSET_GEN : thm
  GROUP_ID_IN_LEFT_COSET : thm
  SUBGROUP_OF_LEFT_COSET : thm
  GROUP_ID_IN_RIGHT_COSET_GEN : thm
  GROUP_ID_IN_RIGHT_COSET : thm
  SUBGROUP_OF_RIGHT_COSET : thm
  CARD_EQ_LEFT_COSETS : thm
  CARD_EQ_RIGHT_COSET_SUBGROUP : thm
  CARD_EQ_LEFT_COSET_SUBGROUP : thm
  deriving Inhabited

@[nospecialize]
def setupCosets1 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BSubgroups : Subgroups) (BSetwise1 : Setwise1) (BCosets : Cosets) :
    ExceptT String IO Cosets1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARD_HAS_SIZE_CONG, .. } := D.core1
  let { DISJOINT_EMPTY_REFL, EQ_C_INVOLUTION, EQ_TRANS, .. } := D.core2
  let { FORALL_AND_THM, FORALL_IN_GSPEC, FORALL_UNWIND_THM2, .. } := D.core3
  let { IMP_CONJ, INJECTIVE_ON_ALT, .. } := D.core4
  let { IN_ELIM_THM, IN_SING, .. } := D.core5
  let { LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, PAIRWISE_IMAGE, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_ANTISYM_EQ,
        UNIONS_GSPEC, UNIONS_SUBSET, eq_c, .. } := D.core7
  let { pairwise, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, OPPOSITE_GROUP, .. } := BBasics
  let { GROUP_INV_INV, GROUP_LINV_EQ, GROUP_MUL_RCANCEL, GROUP_RINV_EQ, group_div, .. } := BDerived
  let { SUBGROUP_OF_IMP_SUBSET, SUBGROUP_OF_OPPOSITE_GROUP, subgroup_of, .. } := BSubgroups
  let { GROUP_SETMUL, GROUP_SETMUL_ASSOC, GROUP_SETMUL_SING, group_setmul, .. } := BSetwise1
  let { GROUP_SETINV_LEFT_COSET_GEN, GROUP_SETINV_RIGHT_COSET_GEN, IN_RIGHT_COSET_SELF,
        LEFT_COSET, LEFT_COSET_EQ_SUBGROUP, LEFT_COSET_ID, LEFT_COSET_OPPOSITE_GROUP,
        RIGHT_COSET, RIGHT_COSET_EQ, RIGHT_COSET_EQ_SUBGROUP, RIGHT_COSET_ID,
        RIGHT_COSET_NONEMPTY, left_coset, right_coset, .. } := BCosets
  -- @@SCOPE END

  let IN_LEFT_COSET_SELF ← prove
   r"!G h x:A.
      h subgroup_of G /\ x IN group_carrier G ==> x IN left_coset G x h"
   (REWRITE_TAC [subgroup_of, left_coset, group_setmul, IN_ELIM_THM, IN_SING] THEN
    MESON_TAC [GROUP_MUL_RID])

  let UNIONS_RIGHT_COSETS ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> UNIONS {right_coset G h x |x| x IN group_carrier G} =
            group_carrier G"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [RIGHT_COSET, SUBGROUP_OF_IMP_SUBSET] THEN
    REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, SUBSET] THEN
    ASM_MESON_TAC [IN_RIGHT_COSET_SELF])

  let UNIONS_LEFT_COSETS ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> UNIONS {left_coset G x h |x| x IN group_carrier G} =
            group_carrier G"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [LEFT_COSET, SUBGROUP_OF_IMP_SUBSET] THEN
    REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, SUBSET] THEN
    ASM_MESON_TAC [IN_LEFT_COSET_SELF])

  let RIGHT_COSETS_EQ ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> (right_coset G h x = right_coset G h y <=>
             ~(DISJOINT (right_coset G h x) (right_coset G h y)))"
   (← do
    let s1 ← SET_RULE (← q
     r"~DISJOINT s t <=> ?x. x IN s /\ ?y. y IN t /\ x = y")
    pure (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [← GSYM DISJOINT_EMPTY_REFL, RIGHT_COSET_NONEMPTY] THEN
    ASM_SIMP_TAC [RIGHT_COSET_EQ, LEFT_IMP_EXISTS_THM, IMP_CONJ, s1] THEN
    REWRITE_TAC [right_coset, group_setmul, FORALL_IN_GSPEC, IN_SING] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2] THEN
    X_GEN_TAC (← q "u:A") THEN DISCH_TAC THEN X_GEN_TAC (← q "v:A") THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"group_mul G (group_inv G u):A->A")) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of, SUBSET]) THEN
    ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_INV, GROUP_MUL_LINV, GROUP_MUL_LID] THEN
    DISCH_THEN SUBST1_TAC THEN
    ASM_SIMP_TAC [group_div, ← GSYM GROUP_MUL_ASSOC, GROUP_INV, GROUP_MUL,
                 GROUP_MUL_RINV, GROUP_MUL_RID]))

  let LEFT_COSETS_EQ ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> (left_coset G x h = left_coset G y h <=>
             ~(DISJOINT (left_coset G x h) (left_coset G y h)))"
   (REWRITE_TAC [LEFT_COSET_OPPOSITE_GROUP] THEN
    SIMP_TAC [RIGHT_COSETS_EQ, SUBGROUP_OF_OPPOSITE_GROUP, OPPOSITE_GROUP])

  let DISJOINT_RIGHT_COSETS ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> (DISJOINT (right_coset G h x) (right_coset G h y) <=>
             ~(right_coset G h x = right_coset G h y))"
   (SIMP_TAC [RIGHT_COSETS_EQ])

  let DISJOINT_LEFT_COSETS ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> (DISJOINT (left_coset G x h) (left_coset G y h) <=>
             ~(left_coset G x h = left_coset G y h))"
   (SIMP_TAC [LEFT_COSETS_EQ])

  let PAIRWISE_DISJOINT_RIGHT_COSETS ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> pairwise DISJOINT {right_coset G h a |a| a IN group_carrier G}"
   (REWRITE_TAC [SIMPLE_IMAGE, PAIRWISE_IMAGE] THEN
    SIMP_TAC [pairwise, DISJOINT_RIGHT_COSETS])

  let PAIRWISE_DISJOINT_LEFT_COSETS ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> pairwise DISJOINT {left_coset G a h |a| a IN group_carrier G}"
   (REWRITE_TAC [SIMPLE_IMAGE, PAIRWISE_IMAGE] THEN
    SIMP_TAC [pairwise, DISJOINT_LEFT_COSETS])

  let IMAGE_RIGHT_COSET_SWITCH ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> IMAGE (\a. group_mul G a (group_mul G (group_inv G x) y))
                  (right_coset G h x) =
            right_coset G h y"
   (REPEAT STRIP_TAC THEN TRANS_TAC EQ_TRANS (← q
     r"group_setmul G (right_coset G h x) {group_mul G (group_inv G x) y:A}") THEN
    CONJ_TAC THENL [REWRITE_TAC [group_setmul] THEN SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    REWRITE_TAC [right_coset] THEN
    ASM_SIMP_TAC [← GSYM GROUP_SETMUL_ASSOC, GROUP_SETMUL, SING_SUBSET,
                 GROUP_MUL, GROUP_INV, GROUP_SETMUL_SING, GROUP_MUL_ASSOC,
                 GROUP_MUL_RINV, GROUP_MUL_LID])

  let IMAGE_LEFT_COSET_SWITCH ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> IMAGE (\a. group_mul G (group_div G y x) a)
                  (left_coset G x h) =
            left_coset G y h"
   (REPEAT STRIP_TAC THEN TRANS_TAC EQ_TRANS (← q
     r"group_setmul G {group_div G y x:A} (left_coset G x h)") THEN
    CONJ_TAC THENL [REWRITE_TAC [group_setmul] THEN SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    REWRITE_TAC [left_coset, group_div] THEN
    ASM_SIMP_TAC [GROUP_SETMUL_ASSOC, GROUP_SETMUL, SING_SUBSET,
                 GROUP_MUL, GROUP_INV, GROUP_SETMUL_SING, ← GSYM GROUP_MUL_ASSOC,
                 GROUP_MUL_LINV, GROUP_MUL_RID])

  let CARD_EQ_LEFT_RIGHT_COSETS ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> {left_coset G x h |x| x IN group_carrier G} =_c
            {right_coset G h x |x| x IN group_carrier G}"
   (← do
    let t1 ← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_C_INVOLUTION THEN
    EXISTS_TAC (← q r"group_setinv(G:A group)") THEN
    REWRITE_TAC [FORALL_IN_GSPEC, FORALL_AND_THM, t1] THEN
    ASM_SIMP_TAC [GROUP_SETINV_LEFT_COSET_GEN, GROUP_SETINV_RIGHT_COSET_GEN,
                 GROUP_INV, GROUP_INV_INV] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [GROUP_INV]))

  let HAS_SIZE_LEFT_RIGHT_COSETS ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> ({left_coset G x h | x | x IN group_carrier G} HAS_SIZE n <=>
             {right_coset G h x | x | x IN group_carrier G} HAS_SIZE n)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CARD_HAS_SIZE_CONG THEN
    MATCH_MP_TAC CARD_EQ_LEFT_RIGHT_COSETS THEN ASM_REWRITE_TAC [])

  let CARD_EQ_RIGHT_COSETS ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> right_coset G h x =_c right_coset G h y"
   (← do
    let lemma ← prove
     r"!f g. (IMAGE f s = t /\ IMAGE g t = s) /\
             (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
       ==> s =_c t"
     (REWRITE_TAC [eq_c, LEFT_FORALL_IMP_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [])
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma THEN
    EXISTS_TAC (← q r"\a:A. group_mul G a (group_mul G (group_inv G x) y)") THEN
    EXISTS_TAC (← q r"\a:A. group_mul G a (group_mul G (group_inv G y) x)") THEN
    ASM_SIMP_TAC [IMAGE_RIGHT_COSET_SWITCH, INJECTIVE_ON_ALT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_MUL_RCANCEL THEN
    ASM_MESON_TAC [GROUP_MUL, GROUP_INV, SUBSET, RIGHT_COSET,
                  SUBGROUP_OF_IMP_SUBSET]))

  let GROUP_ID_IN_LEFT_COSET_GEN ← prove
   r"!G h x:A.
        h SUBSET group_carrier G /\ x IN group_carrier G
        ==> (group_id G IN left_coset G x h <=> group_inv G x IN h)"
   (REWRITE_TAC [left_coset, group_setmul, IN_ELIM_THM, IN_SING, SUBSET] THEN
    MESON_TAC [GROUP_LINV_EQ])

  let GROUP_ID_IN_LEFT_COSET ← prove
   r"!G h x:A.
        h subgroup_of G /\ x IN group_carrier G
        ==> (group_id G IN left_coset G x h <=> x IN h)"
   (SIMP_TAC [subgroup_of, GROUP_ID_IN_LEFT_COSET_GEN] THEN
    MESON_TAC [GROUP_INV_INV, SUBSET])

  let SUBGROUP_OF_LEFT_COSET ← prove
   r"!G h x:A.
        h subgroup_of G /\ x IN group_carrier G
        ==> (left_coset G x h subgroup_of G <=> left_coset G x h = h)"
   (MESON_TAC [LEFT_COSET_EQ_SUBGROUP, subgroup_of, GROUP_ID_IN_LEFT_COSET])

  let GROUP_ID_IN_RIGHT_COSET_GEN ← prove
   r"!G h x:A.
        h SUBSET group_carrier G /\ x IN group_carrier G
        ==> (group_id G IN right_coset G h x <=> group_inv G x IN h)"
   (REWRITE_TAC [right_coset, group_setmul, IN_ELIM_THM, IN_SING, SUBSET] THEN
    MESON_TAC [GROUP_RINV_EQ])

  let GROUP_ID_IN_RIGHT_COSET ← prove
   r"!G h x:A.
        h subgroup_of G /\ x IN group_carrier G
        ==> (group_id G IN right_coset G h x <=> x IN h)"
   (SIMP_TAC [subgroup_of, GROUP_ID_IN_RIGHT_COSET_GEN] THEN
    MESON_TAC [GROUP_INV_INV, SUBSET])

  let SUBGROUP_OF_RIGHT_COSET ← prove
   r"!G h x:A.
        h subgroup_of G /\ x IN group_carrier G
        ==> (right_coset G h x subgroup_of G <=> right_coset G h x = h)"
   (MESON_TAC [RIGHT_COSET_EQ_SUBGROUP, subgroup_of, GROUP_ID_IN_RIGHT_COSET])

  let CARD_EQ_LEFT_COSETS ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> left_coset G x h =_c left_coset G y h"
   (SIMP_TAC [LEFT_COSET_OPPOSITE_GROUP, SUBGROUP_OF_OPPOSITE_GROUP,
             OPPOSITE_GROUP, CARD_EQ_RIGHT_COSETS])

  let CARD_EQ_RIGHT_COSET_SUBGROUP ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> right_coset G h x =_c h"
   (MESON_TAC [CARD_EQ_RIGHT_COSETS, GROUP_ID, RIGHT_COSET_ID,
              SUBGROUP_OF_IMP_SUBSET])

  let CARD_EQ_LEFT_COSET_SUBGROUP ← prove
   r"!G h x y:A.
        h subgroup_of G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> left_coset G x h =_c h"
   (MESON_TAC [CARD_EQ_LEFT_COSETS, GROUP_ID, LEFT_COSET_ID,
              SUBGROUP_OF_IMP_SUBSET])

  -- @@RETURN BEGIN
  return { IN_LEFT_COSET_SELF, UNIONS_RIGHT_COSETS, UNIONS_LEFT_COSETS, RIGHT_COSETS_EQ,
           LEFT_COSETS_EQ, DISJOINT_RIGHT_COSETS, DISJOINT_LEFT_COSETS,
           PAIRWISE_DISJOINT_RIGHT_COSETS, PAIRWISE_DISJOINT_LEFT_COSETS,
           IMAGE_RIGHT_COSET_SWITCH, IMAGE_LEFT_COSET_SWITCH, CARD_EQ_LEFT_RIGHT_COSETS,
           HAS_SIZE_LEFT_RIGHT_COSETS, CARD_EQ_RIGHT_COSETS, GROUP_ID_IN_LEFT_COSET_GEN,
           GROUP_ID_IN_LEFT_COSET, SUBGROUP_OF_LEFT_COSET, GROUP_ID_IN_RIGHT_COSET_GEN,
           GROUP_ID_IN_RIGHT_COSET, SUBGROUP_OF_RIGHT_COSET, CARD_EQ_LEFT_COSETS,
           CARD_EQ_RIGHT_COSET_SUBGROUP, CARD_EQ_LEFT_COSET_SUBGROUP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Orbit-stabilizer, Lagrange's theorem and cosets in product groups.        -/
/- (grouptheory.ml 6265-6522)                                                -/
/- ------------------------------------------------------------------------- -/

structure Cosets2 where
  -- @@FIELDS
  GROUP_ORBIT_SUBGROUP_TRANSLATION : thm
  GROUP_ORBIT_GROUP_TRANSLATION : thm
  ORBIT_STABILIZER_GEN : thm
  ORBIT_STABILIZER : thm
  GROUP_ACTION_LEFT_COSET_MULTIPLICATION : thm
  GROUP_ORBIT_LEFT_COSET_MULTIPLICATION : thm
  GROUP_STABILIZER_LEFT_COSET_MULTIPLICATION : thm
  GROUP_ORBIT_LEFT_COSET_MULTIPLICATION_ID : thm
  GROUP_STABILIZER_LEFT_COSET_MULTIPLICATION_ID : thm
  LAGRANGE_THEOREM_LEFT_GEN : thm
  LAGRANGE_THEOREM_RIGHT_GEN : thm
  LAGRANGE_THEOREM_LEFT : thm
  LAGRANGE_THEOREM_RIGHT : thm
  LAGRANGE_THEOREM : thm
  CARD_LEFT_COSETS_DIVIDES : thm
  CARD_RIGHT_COSETS_DIVIDES : thm
  LAGRANGE_THEOREM_LEFT_DIV : thm
  LAGRANGE_THEOREM_RIGHT_DIV : thm
  GROUP_SETMUL_PROD_GROUP : thm
  RIGHT_COSET_PROD_GROUP : thm
  LEFT_COSET_PROD_GROUP : thm
  GROUP_SETMUL_PRODUCT_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupCosets2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BGroupRule : GroupRule) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) (BProductGroup : ProductGroup) (BSetwise1 : Setwise1) (BGroupActions : GroupActions) (BGroupOrbits : GroupOrbits) (BOrbitStabilizer : OrbitStabilizer) (BCosets : Cosets) :
    ExceptT String IO Cosets2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, NUMBER_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARD_EQ_0, CARD_EQ_CARD, CARD_EQ_IMAGES, CARD_MUL_C, CARD_MUL_FINITE,
        CARTESIAN_PRODUCT_AS_RESTRICTIONS, .. } := D.core1
  let { CROSS, CROSS_SING, DIV_MULT, .. } := D.core2
  let { FINITE_IMAGE, FINITE_SUBSET, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.core3
  let { IMAGE_EQ, IMAGE_o, IMP_CONJ, .. } := D.core4
  let { IN_ELIM_THM, .. } := D.core5
  let { MULT_SYM, NOT_FORALL_THM, NOT_IMP, RESTRICTION, RESTRICTION_EXTENSION, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM_EQ, divides, .. } := D.core7
  let { o_DEF, o_THM, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, OPPOSITE_GROUP, .. } := BBasics
  let { GROUP_INV_MUL, .. } := BDerived
  let { GROUP_TAC, .. } := BGroupRule
  let { GROUP_CONJUGATION_BY_ID, group_conjugation, .. } := BConjugation
  let { CARRIER_SUBGROUP_OF, SUBGROUP_OF_IMP_NONEMPTY, SUBGROUP_OF_IMP_SUBSET,
        SUBGROUP_OF_OPPOSITE_GROUP, subgroup_of, .. } := BSubgroups
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_GROUP_CARRIER, .. } := BSubgroupGen1
  let { PROD_GROUP, .. } := BProdGroup
  let { PRODUCT_GROUP, .. } := BProductGroup
  let { GROUP_SETINV_SUBGROUP, group_setinv, group_setmul, .. } := BSetwise1
  let { FINITE_GROUP_STABILIZER, GROUP_ACTION_EQ, SUBGROUP_OF_GROUP_STABILIZER,
        group_stabilizer, .. } := BGroupActions
  let { FINITE_GROUP_ORBIT, GROUP_ORBIT, .. } := BGroupOrbits
  let { GROUP_ACTION_SUBGROUP_TRANSLATION, GROUP_ACTION_SUBSET_TRANSLATION,
        ORBIT_STABILIZER_MUL_GEN, .. } := BOrbitStabilizer
  let { LEFT_COSET, LEFT_COSET_AS_IMAGE, LEFT_COSET_EQ, LEFT_COSET_ID,
        LEFT_COSET_LEFT_COSET, RIGHT_COSET_CARRIER, RIGHT_COSET_OPPOSITE_GROUP,
        left_coset, right_coset, .. } := BCosets
  -- @@SCOPE END

  let GROUP_ORBIT_SUBGROUP_TRANSLATION ← prove
   r"!G h a:A.
     h subgroup_of G /\ a IN group_carrier G
     ==> group_orbit (subgroup_generated G h) (group_carrier G) (group_mul G) a =
         right_coset G h a"
   (SIMP_TAC [SUBGROUP_OF_IMP_SUBSET, GROUP_ORBIT,
             GROUP_ACTION_SUBGROUP_TRANSLATION] THEN
    SIMP_TAC [right_coset, group_setmul,
             CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    SET_TAC [])

  let GROUP_ORBIT_GROUP_TRANSLATION ← prove
   r"!G a:A.
      a IN group_carrier G
      ==> group_orbit G (group_carrier G) (group_mul G) a = group_carrier G"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"group_carrier G:A->bool", ← q "a:A"]
          GROUP_ORBIT_SUBGROUP_TRANSLATION) THEN
    ASM_REWRITE_TAC [CARRIER_SUBGROUP_OF, SUBGROUP_GENERATED_GROUP_CARRIER] THEN
    ASM_SIMP_TAC [RIGHT_COSET_CARRIER])

  let ORBIT_STABILIZER_GEN ← prove
   r"!G s (a:A->X->X) x.
      group_action G s a /\ x IN s
      ==> group_orbit G s a x =_c
          {left_coset G g (group_stabilizer G a x) |g| g IN group_carrier G}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [GROUP_ORBIT, SIMPLE_IMAGE] THEN
    MATCH_MP_TAC CARD_EQ_IMAGES THEN
    ASM_MESON_TAC [GROUP_ACTION_EQ, LEFT_COSET_EQ,
                  SUBGROUP_OF_GROUP_STABILIZER])

  let ORBIT_STABILIZER ← prove
   r"!G s (a:A->X->X) x.
      FINITE(group_carrier G) /\ group_action G s a /\ x IN s
      ==> CARD (group_orbit G s a x) =
          CARD {left_coset G g (group_stabilizer G a x) |g|
                g IN group_carrier G}"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ORBIT_STABILIZER_GEN) THEN
    ASM_SIMP_TAC [FINITE_GROUP_STABILIZER, FINITE_GROUP_ORBIT, CARD_EQ_CARD,
                 SIMPLE_IMAGE, FINITE_IMAGE])

  let GROUP_ACTION_LEFT_COSET_MULTIPLICATION ← prove
   r"!G h:A->bool.
        h SUBSET group_carrier G
        ==> group_action G {left_coset G x h | x | x IN group_carrier G}
                           (IMAGE o group_mul G)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ACTION_SUBSET_TRANSLATION THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [LEFT_COSET] THEN REWRITE_TAC [LEFT_COSET_AS_IMAGE] THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN X_GEN_TAC (← q "b:A") THEN DISCH_TAC THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM IMAGE_o, o_DEF] THEN
    EXISTS_TAC (← q r"group_mul G a b:A") THEN ASM_SIMP_TAC [GROUP_MUL] THEN
    MATCH_MP_TAC IMAGE_EQ THEN ASM_MESON_TAC [GROUP_MUL_ASSOC, SUBSET])

  let GROUP_ORBIT_LEFT_COSET_MULTIPLICATION ← prove
   r"!G h a:A.
        a IN group_carrier G /\ h subgroup_of G
        ==> group_orbit G { left_coset G x h | x | x IN group_carrier G}
                          (IMAGE o group_mul G) (left_coset G a h) =
            { left_coset G x h | x | x IN group_carrier G}"
   (← do
    let m2 ← MESON [subgroup_of] (← q
     r"h subgroup_of G ==> x = group_id G ==> x IN h")
    let m1 ← MESON [] (← q
     r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    ASM_SIMP_TAC [GROUP_ORBIT, GROUP_ACTION_LEFT_COSET_MULTIPLICATION] THEN
    COND_CASES_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [← GSYM LEFT_COSET_AS_IMAGE, LEFT_COSET_LEFT_COSET, o_DEF] THEN
    ASM_SIMP_TAC [IN_ELIM_THM, LEFT_COSET_EQ, GROUP_MUL, LEFT_COSET_LEFT_COSET,
     GROUP_INV_MUL, m1] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN
    CONJ_TAC THEN X_GEN_TAC (← q "b:A") THEN DISCH_TAC THENL
     [EXISTS_TAC (← q r"group_mul G b a:A"),
      EXISTS_TAC (← q r"group_mul G b (group_inv G a):A")] THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV] THEN
    FIRST_X_ASSUM (fun th => tactic_of do pure (MATCH_MP_TAC (← MATCH_MP m2 th))) THEN
    GROUP_TAC))

  let GROUP_STABILIZER_LEFT_COSET_MULTIPLICATION ← prove
   r"!G h a:A.
        a IN group_carrier G /\ h subgroup_of G
        ==> group_stabilizer G (IMAGE o group_mul G) (left_coset G a h) =
            IMAGE (group_conjugation G a) h"
   (← do
    let s1 ← SET_RULE (← q
     r"(!x. x IN s ==> f(g x) = x) /\ (!x. x IN s ==> f x IN s /\ g(f x) = x) /\
       t SUBSET s
       ==> {x | x IN s /\ g x IN t} = IMAGE f t")
    let t1 ← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [group_stabilizer] THEN
    FIRST_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC (RAND_CONV o RAND_CONV)
     [← SYM (← MATCH_MP GROUP_SETINV_SUBGROUP th)])) THEN
    REWRITE_TAC [group_setinv, SIMPLE_IMAGE, ← GSYM IMAGE_o, o_DEF] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    ONCE_REWRITE_TAC [t1] THEN
    REWRITE_TAC [group_stabilizer, o_THM, ← GSYM LEFT_COSET_AS_IMAGE] THEN
    ASM_SIMP_TAC [LEFT_COSET_LEFT_COSET, GROUP_MUL, LEFT_COSET_EQ] THEN
    REWRITE_TAC [NOT_IMP] THEN MATCH_MP_TAC s1 THEN
    ASM_SIMP_TAC [group_conjugation, GROUP_INV, GROUP_MUL] THEN
    REPEAT STRIP_TAC THEN GROUP_TAC))

  let GROUP_ORBIT_LEFT_COSET_MULTIPLICATION_ID ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> group_orbit G { left_coset G x h | x | x IN group_carrier G}
                          (IMAGE o group_mul G) h =
            { left_coset G x h | x | x IN group_carrier G}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"h:A->bool", ← q r"group_id G:A"]
          GROUP_ORBIT_LEFT_COSET_MULTIPLICATION) THEN
    ASM_SIMP_TAC [LEFT_COSET_ID, SUBGROUP_OF_IMP_SUBSET, GROUP_ID])

  let GROUP_STABILIZER_LEFT_COSET_MULTIPLICATION_ID ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> group_stabilizer G (IMAGE o group_mul G) h = h"
   (← do
    let s1 ← SET_RULE (← q
     r"(!x. x IN s ==> f x = x) ==> IMAGE f s = s")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"h:A->bool", ← q r"group_id G:A"]
          GROUP_STABILIZER_LEFT_COSET_MULTIPLICATION) THEN
    ASM_SIMP_TAC [LEFT_COSET_ID, SUBGROUP_OF_IMP_SUBSET, GROUP_ID] THEN
    DISCH_THEN (K ALL_TAC) THEN MATCH_MP_TAC s1 THEN
    ASM_MESON_TAC [GROUP_CONJUGATION_BY_ID, SUBSET, subgroup_of]))

  let LAGRANGE_THEOREM_LEFT_GEN ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> {left_coset G x h | x | x IN group_carrier G} *_c h =_c
            group_carrier G"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_ACTION_LEFT_COSET_MULTIPLICATION) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"h:A->bool") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] ORBIT_STABILIZER_MUL_GEN)) THEN
    ASM_SIMP_TAC [GROUP_ORBIT_LEFT_COSET_MULTIPLICATION_ID,
                 GROUP_STABILIZER_LEFT_COSET_MULTIPLICATION_ID] THEN
    DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"group_id G:A") THEN ASM_SIMP_TAC [LEFT_COSET_ID, GROUP_ID])

  let LAGRANGE_THEOREM_RIGHT_GEN ← prove
   r"!G h:A->bool.
        h subgroup_of G
        ==> {right_coset G h x | x | x IN group_carrier G} *_c h =_c
            group_carrier G"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [RIGHT_COSET_OPPOSITE_GROUP] THEN
    ONCE_REWRITE_TAC [← SYM (← CONJUNCT1 (← SPEC_ALL OPPOSITE_GROUP))] THEN
    MATCH_MP_TAC LAGRANGE_THEOREM_LEFT_GEN THEN
    ASM_REWRITE_TAC [SUBGROUP_OF_OPPOSITE_GROUP, OPPOSITE_GROUP])

  let LAGRANGE_THEOREM_LEFT ← prove
   r"!G h:A->bool.
        FINITE(group_carrier G) /\ h subgroup_of G
        ==> CARD {left_coset G x h |x| x IN group_carrier G} * CARD h =
            CARD(group_carrier G)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"FINITE(h:A->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [subgroup_of, FINITE_SUBSET], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LAGRANGE_THEOREM_LEFT_GEN) THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, CARD_EQ_CARD, FINITE_IMAGE,
                 CARD_MUL_FINITE, CARD_MUL_C])

  let LAGRANGE_THEOREM_RIGHT ← prove
   r"!G h:A->bool.
        FINITE(group_carrier G) /\ h subgroup_of G
        ==> CARD {right_coset G h x |x| x IN group_carrier G} * CARD h =
            CARD(group_carrier G)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [RIGHT_COSET_OPPOSITE_GROUP] THEN
    ONCE_REWRITE_TAC [← SYM (← CONJUNCT1 (← SPEC_ALL OPPOSITE_GROUP))] THEN
    MATCH_MP_TAC LAGRANGE_THEOREM_LEFT THEN
    ASM_REWRITE_TAC [SUBGROUP_OF_OPPOSITE_GROUP, OPPOSITE_GROUP])

  let LAGRANGE_THEOREM ← prove
   r"!G h:A->bool.
        FINITE(group_carrier G) /\ h subgroup_of G
        ==> (CARD h) divides CARD(group_carrier G)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (SUBST1_TAC o SYM o MATCH_MP LAGRANGE_THEOREM_RIGHT) THEN
    NUMBER_TAC)

  let CARD_LEFT_COSETS_DIVIDES ← prove
   r"!G h:A->bool.
        FINITE(group_carrier G) /\ h subgroup_of G
        ==> CARD {left_coset G x h | x | x IN group_carrier G} divides
            CARD(group_carrier G)"
   (MESON_TAC [divides, LAGRANGE_THEOREM_LEFT])

  let CARD_RIGHT_COSETS_DIVIDES ← prove
   r"!G h:A->bool.
        FINITE(group_carrier G) /\ h subgroup_of G
        ==> CARD {right_coset G h x | x | x IN group_carrier G} divides
            CARD(group_carrier G)"
   (MESON_TAC [divides, LAGRANGE_THEOREM_RIGHT])

  let LAGRANGE_THEOREM_LEFT_DIV ← prove
   r"!G h:A->bool.
        FINITE(group_carrier G) /\ h subgroup_of G
        ==> CARD {left_coset G x h | x | x IN group_carrier G} =
            CARD(group_carrier G) DIV CARD h"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP LAGRANGE_THEOREM_LEFT) THEN
    ONCE_REWRITE_TAC [MULT_SYM] THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC DIV_MULT THEN
    ASM_MESON_TAC [subgroup_of, FINITE_SUBSET, CARD_EQ_0,
                  SUBGROUP_OF_IMP_NONEMPTY])

  let LAGRANGE_THEOREM_RIGHT_DIV ← prove
   r"!G h:A->bool.
        FINITE(group_carrier G) /\ h subgroup_of G
        ==> CARD {right_coset G h x | x | x IN group_carrier G} =
            CARD(group_carrier G) DIV CARD h"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP LAGRANGE_THEOREM_RIGHT) THEN
    ONCE_REWRITE_TAC [MULT_SYM] THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC DIV_MULT THEN
    ASM_MESON_TAC [subgroup_of, FINITE_SUBSET, CARD_EQ_0,
                  SUBGROUP_OF_IMP_NONEMPTY])

  let GROUP_SETMUL_PROD_GROUP ← prove
   r"!(G1:A group) (G2:B group) s1 s2 t1 t2.
        group_setmul (prod_group G1 G2) (s1 CROSS s2) (t1 CROSS t2) =
        (group_setmul G1 s1 t1) CROSS (group_setmul G2 s2 t2)"
   (← do
    let s1 ← SET_RULE (← q
     r"{f x y | x IN {g a b | P a b} /\ y IN {h c d | Q c d}} =
       {f (g a b) (h c d) | P a b /\ Q c d}")
    pure (REWRITE_TAC [group_setmul, CROSS, PROD_GROUP, s1] THEN
    SET_TAC []))

  let RIGHT_COSET_PROD_GROUP ← prove
   r"!G1 G2 h1 h2 (x1:A) (x2:B).
        right_coset (prod_group G1 G2) (h1 CROSS h2) (x1,x2) =
        (right_coset G1 h1 x1) CROSS (right_coset G2 h2 x2)"
   (REWRITE_TAC [right_coset, ← GSYM CROSS_SING, GROUP_SETMUL_PROD_GROUP])

  let LEFT_COSET_PROD_GROUP ← prove
   r"!G1 G2 h1 h2 (x1:A) (x2:B).
        left_coset (prod_group G1 G2) (x1,x2) (h1 CROSS h2) =
        (left_coset G1 x1 h1) CROSS (left_coset G2 x2 h2)"
   (REWRITE_TAC [left_coset, ← GSYM CROSS_SING, GROUP_SETMUL_PROD_GROUP])

  let GROUP_SETMUL_PRODUCT_GROUP ← prove
   r"!(G:K->A group) k s t.
        group_setmul (product_group k G)
                     (cartesian_product k s) (cartesian_product k t) =
        cartesian_product k (\i. group_setmul (G i) (s i) (t i))"
   (← do
    let s3 ← SET_RULE (← q
     r"(!x y. R x y ==> f x y = g x y)
      ==> {f x y | R x y} = {g x y | R x y}")
    let s2 ← SET_RULE (← q
     r"{RESTRICTION k f | f | ?x y. RESTRICTION k f = RESTRICTION k (g x y) /\
                                   R x y} =
      {RESTRICTION k (g x y) | R x y}")
    let t1 ← TAUT (← q
     r"p ==> (q /\ r) /\ s <=> (p ==> s) /\ (p ==> q) /\ (p ==> r)")
    let s1 ← SET_RULE (← q
     r"{f x y | x,y | x IN {g x | P x} /\ y IN {g f | Q f}} =
      {f (g x) (g y) | P x /\ Q y}")
    pure (REPEAT GEN_TAC THEN
    REWRITE_TAC [group_setmul, CARTESIAN_PRODUCT_AS_RESTRICTIONS,
                PRODUCT_GROUP] THEN
    REWRITE_TAC [IN_ELIM_THM, s1] THEN
    GEN_REWRITE_TAC (RAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, t1] THEN
    REWRITE_TAC [← GSYM RESTRICTION_EXTENSION, s2] THEN
    MATCH_MP_TAC s3 THEN
    REWRITE_TAC [RESTRICTION_EXTENSION] THEN SIMP_TAC [RESTRICTION]))

  -- @@RETURN BEGIN
  return { GROUP_ORBIT_SUBGROUP_TRANSLATION, GROUP_ORBIT_GROUP_TRANSLATION,
           ORBIT_STABILIZER_GEN, ORBIT_STABILIZER,
           GROUP_ACTION_LEFT_COSET_MULTIPLICATION, GROUP_ORBIT_LEFT_COSET_MULTIPLICATION,
           GROUP_STABILIZER_LEFT_COSET_MULTIPLICATION,
           GROUP_ORBIT_LEFT_COSET_MULTIPLICATION_ID,
           GROUP_STABILIZER_LEFT_COSET_MULTIPLICATION_ID, LAGRANGE_THEOREM_LEFT_GEN,
           LAGRANGE_THEOREM_RIGHT_GEN, LAGRANGE_THEOREM_LEFT, LAGRANGE_THEOREM_RIGHT,
           LAGRANGE_THEOREM, CARD_LEFT_COSETS_DIVIDES, CARD_RIGHT_COSETS_DIVIDES,
           LAGRANGE_THEOREM_LEFT_DIV, LAGRANGE_THEOREM_RIGHT_DIV,
           GROUP_SETMUL_PROD_GROUP, RIGHT_COSET_PROD_GROUP, LEFT_COSET_PROD_GROUP,
           GROUP_SETMUL_PRODUCT_GROUP }
  -- @@RETURN END

structure CosetProducts where
  -- @@FIELDS
  RIGHT_COSET_PRODUCT_GROUP : thm
  LEFT_COSET_PRODUCT_GROUP : thm
  GROUP_SETINV_SUBGROUP_GENERATED : thm
  GROUP_SETMUL_SUBGROUP_GENERATED : thm
  RIGHT_COSET_SUBGROUP_GENERATED : thm
  LEFT_COSET_SUBGROUP_GENERATED : thm
  SCHREIER_TRANSVERSAL_LEMMA : thm
  deriving Inhabited

@[nospecialize]
def setupCosetProducts [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BGroupRule : GroupRule) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProductGroup : ProductGroup) (BSetwise1 : Setwise1) (BCosets : Cosets) (BCosets1 : Cosets1) (BCosets2 : Cosets2) :
    ExceptT String IO CosetProducts := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARTESIAN_PRODUCT_SINGS_GEN, CONJ_ASSOC, .. } := D.core1
  let { EXISTS_IN_IMAGE, .. } := D.core2
  let { FUN_EQ_THM, .. } := D.core3
  let { IN_ELIM_THM, IN_INTER, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, RESTRICTION,
        RESTRICTION_EXTENSION, .. } := D.core6
  let { RIGHT_EXISTS_AND_THM, SUBSET, SUBSET_ANTISYM, UNIONS_GSPEC, UNWIND_THM2, .. } := D.core7
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_TAC, .. } := BGroupRule
  let { IN_SUBGROUP_INV, IN_SUBGROUP_MUL, SUBGROUP_OF_IMP_SUBSET, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, GROUP_ID_SUBGROUP, SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_INDUCT_LEFT, SUBGROUP_GENERATED_MINIMAL,
        SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { SUBGROUP_GENERATED_INC_GEN, SUBGROUP_GENERATED_MINIMAL_EQ, .. } := BSubgroupGen1
  let { OPPOSITE_PRODUCT_GROUP, PRODUCT_GROUP, .. } := BProductGroup
  let { GROUP_SETINV_AS_IMAGE, group_setinv, group_setmul, .. } := BSetwise1
  let { LEFT_COSET_OPPOSITE_GROUP, left_coset, right_coset, .. } := BCosets
  let { GROUP_ID_IN_RIGHT_COSET, .. } := BCosets1
  let { GROUP_SETMUL_PRODUCT_GROUP, .. } := BCosets2
  -- @@SCOPE END

  let RIGHT_COSET_PRODUCT_GROUP ← prove
   r"!(G:K->A group) h x k.
          right_coset (product_group k G) (cartesian_product k h) x =
          cartesian_product k (\i. right_coset (G i) (h i) (x i))"
   (← do
    let a2 ← SET_RULE
     (← q r"(!x. x IN s ==> f x = g x) ==> {f x | x IN s} = {g x | x IN s}")
    let a1 ← SET_RULE (← q r"{f x y | x,y | P x /\ y IN {a}} = {f x a | P x}")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [right_coset] THEN
    REWRITE_TAC [← GSYM GROUP_SETMUL_PRODUCT_GROUP] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_SINGS_GEN] THEN
    REWRITE_TAC [group_setmul, PRODUCT_GROUP, a1] THEN
    MATCH_MP_TAC a2 THEN
    REWRITE_TAC [RESTRICTION_EXTENSION] THEN SIMP_TAC [RESTRICTION]))

  let LEFT_COSET_PRODUCT_GROUP ← prove
   r"!(G:K->A group) h x k.
          left_coset (product_group k G) x (cartesian_product k h) =
          cartesian_product k (\i. left_coset (G i) (x i) (h i))"
   (REWRITE_TAC [LEFT_COSET_OPPOSITE_GROUP, OPPOSITE_PRODUCT_GROUP] THEN
    REWRITE_TAC [RIGHT_COSET_PRODUCT_GROUP])

  let GROUP_SETINV_SUBGROUP_GENERATED ← prove
   r"!G h:A->bool.
          group_setinv (subgroup_generated G h) = group_setinv G"
   (REWRITE_TAC [group_setinv, FUN_EQ_THM, SUBGROUP_GENERATED])

  let GROUP_SETMUL_SUBGROUP_GENERATED ← prove
   r"!G h:A->bool.
          group_setmul (subgroup_generated G h) = group_setmul G"
   (REWRITE_TAC [group_setmul, FUN_EQ_THM, SUBGROUP_GENERATED])

  let RIGHT_COSET_SUBGROUP_GENERATED ← prove
   r"!G h k x. right_coset (subgroup_generated G h) k x = right_coset G k x"
   (REWRITE_TAC [right_coset, GROUP_SETMUL_SUBGROUP_GENERATED])

  let LEFT_COSET_SUBGROUP_GENERATED ← prove
   r"!G h k x. left_coset (subgroup_generated G h) x k = left_coset G x k"
   (REWRITE_TAC [left_coset, GROUP_SETMUL_SUBGROUP_GENERATED])

  let SCHREIER_TRANSVERSAL_LEMMA ← prove
   r"!(G:A group) h s t.
        h subgroup_of G /\
        s SUBSET group_carrier G /\
        subgroup_generated G s = G /\
        (!x. x IN s ==> group_inv G x IN s) /\
        t SUBSET group_carrier G /\
        UNIONS {right_coset G h x | x IN t} = group_carrier G /\
        t INTER h SUBSET {group_id G}
        ==> group_carrier(subgroup_generated G
             (h INTER group_setmul G t (group_setmul G s (group_setinv G t)))) =
            h"
   (← do
    let a5 ← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")
    let a4 ← SET_RULE (← q r"s SUBSET {z} ==> y IN s ==> y = z")
    let a3 ← TAUT
     (← q r"(p' ==> p) /\ (p /\ p' ==> q ==> q') ==> (p ==> q) ==> (p' ==> q')")
    let a2 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [SUBGROUP_GENERATED_MINIMAL_EQ] THEN SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    ABBREV_TAC
     (← q r"k:A->bool =
      h INTER group_setmul G t (group_setmul G s (group_setinv G t))") THEN
    SUBGOAL_THEN
     (← q r"!y x. y IN t /\ x IN s
            ==> ?z y'. z IN group_carrier G /\ y' IN group_carrier G /\
                       z IN k /\ y' IN t /\
                       group_mul G y x:A = group_mul G z y'")
    (LABEL_TAC "*") THENL
     [MAP_EVERY X_GEN_TAC [← q "y:A", ← q "x:A"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"x IN group_carrier G /\ (y:A) IN group_carrier G")
      STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"group_mul G y (x:A) IN UNIONS {right_coset G h x | x IN t}")
      MP_TAC THENL
       [ASM_SIMP_TAC [GROUP_MUL], REWRITE_TAC [UNIONS_GSPEC]] THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, right_coset, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q "y':A") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [group_setmul] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_SING] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM, UNWIND_THM2] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "z:A") THEN STRIP_TAC THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
      CONJ_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
      EXISTS_TAC (← q "y':A") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC a2 THEN
      CONJ_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
      EXPAND_TAC "k" THEN REWRITE_TAC [group_setmul, GROUP_SETINV_AS_IMAGE] THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, IN_INTER] THEN
      MAP_EVERY EXISTS_TAC [← q "y:A", ← q r"group_mul G x (group_inv G y'):A"] THEN
      ASM_REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM] THEN
      REWRITE_TAC [EXISTS_IN_IMAGE] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      UNDISCH_TAC (← q r"group_mul G y x:A = group_mul G z y'") THEN
      GROUP_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x:A. x IN group_carrier(subgroup_generated G s)
            ==> ~(x = group_id G)
                ==> !y. y IN t
                        ==> ?z y'. z IN group_carrier(subgroup_generated G k) /\
                                   y' IN t /\
                                   group_mul G y x = group_mul G z y'")
    MP_TAC THENL
     [MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT_LEFT THEN REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "xs:A"] THEN
      ASM_CASES_TAC (← q r"xs:A = group_id G") THEN ASM_REWRITE_TAC [] THENL
       [SIMP_TAC [GROUP_MUL_RID, GROUP_INV] THEN STRIP_TAC THEN
        CONJ_TAC THEN DISCH_THEN (K ALL_TAC) THEN
        X_GEN_TAC (← q "y:A") THEN DISCH_TAC THEN
        (SUBGOAL_THEN (← q r"(y:A) IN group_carrier G") ASSUME_TAC THENL
          [ASM SET_TAC [], ASM_SIMP_TAC [GROUP_MUL_RID, GROUP_INV]]) THENL
         [REMOVE_THEN "*" (MP_TAC o SPECL [← q "y:A", ← q "x:A"]),
          REMOVE_THEN "*" (MP_TAC o SPECL [← q "y:A", ← q r"group_inv G x:A"])] THEN
        ASM_SIMP_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "z:A") THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "y':A") THEN
        STRIP_TAC THEN ASM_SIMP_TAC [SUBGROUP_GENERATED_INC_GEN],
        REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        DISCH_THEN (LABEL_TAC "+") THEN CONJ_TAC THEN DISCH_THEN (K ALL_TAC) THEN
        X_GEN_TAC (← q "y:A") THEN DISCH_TAC THEN
        (SUBGOAL_THEN (← q r"(y:A) IN group_carrier G") ASSUME_TAC THENL
         [ASM SET_TAC [], ALL_TAC]) THENL
         [REMOVE_THEN "*" (MP_TAC o SPECL [← q "y:A", ← q "x:A"]),
          REMOVE_THEN "*" (MP_TAC o SPECL [← q "y:A", ← q r"group_inv G x:A"])] THEN
        ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q "z:A", ← q "y':A"] THEN STRIP_TAC THEN
        REMOVE_THEN "+" (MP_TAC o SPEC (← q "y':A")) THEN
        ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q "z':A", ← q "y'':A"] THEN STRIP_TAC THEN
        (SUBGOAL_THEN (← q r"(z':A) IN group_carrier G /\ y'' IN group_carrier G")
         STRIP_ASSUME_TAC THENL
          [ASM_MESON_TAC [SUBSET, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET],
           ALL_TAC]) THEN
        MAP_EVERY EXISTS_TAC [← q r"group_mul G z z':A", ← q "y'':A"] THEN
        ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_INV] THEN
        ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_INV] THEN
        MATCH_MP_TAC IN_SUBGROUP_MUL THEN
        ASM_REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
        MATCH_MP_TAC SUBGROUP_GENERATED_INC_GEN THEN ASM_REWRITE_TAC []],
      ASM_REWRITE_TAC [SUBSET]] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q "x:A") THEN
    ASM_CASES_TAC (← q r"x:A = group_id G") THEN ASM_REWRITE_TAC [GROUP_ID_SUBGROUP] THEN
    MATCH_MP_TAC a3 THEN
    CONJ_TAC THENL [ASM SET_TAC [], STRIP_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"group_id G:A")) THEN ANTS_TAC THENL
     [SUBGOAL_THEN (← q r"(group_id G:A) IN UNIONS {right_coset G h x | x IN t}")
      MP_TAC THENL [ASM_SIMP_TAC [GROUP_ID], REWRITE_TAC [UNIONS_GSPEC]] THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "w:A") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      SUBGOAL_THEN (← q r"(w:A) IN group_carrier G") ASSUME_TAC THENL
       [ASM SET_TAC [], ASM_SIMP_TAC [GROUP_ID_IN_RIGHT_COSET] THEN ASM SET_TAC []],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q "z:A", ← q "y':A"] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    SUBGOAL_THEN (← q r"(z:A) IN group_carrier G /\ y' IN group_carrier G")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET],
      DISCH_THEN (MP_TAC o SYM) THEN ASM_SIMP_TAC [GROUP_MUL_LID]] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"y':A = group_id G") SUBST_ALL_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [GROUP_MUL_RID]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP a4) THEN
    ASM_REWRITE_TAC [IN_INTER] THEN
    SUBGOAL_THEN (← q r"y':A = group_mul G (group_inv G z) x") SUBST1_TAC THENL
     [UNDISCH_TAC (← q r"group_mul G z y':A = x") THEN GROUP_TAC, ALL_TAC] THEN
    MATCH_MP_TAC IN_SUBGROUP_MUL THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC IN_SUBGROUP_INV THEN ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"(z:A) IN group_carrier (subgroup_generated G k)") THEN
    MATCH_MP_TAC a5 THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN ASM SET_TAC []))

  -- @@RETURN BEGIN
  return { RIGHT_COSET_PRODUCT_GROUP, LEFT_COSET_PRODUCT_GROUP,
           GROUP_SETINV_SUBGROUP_GENERATED, GROUP_SETMUL_SUBGROUP_GENERATED,
           RIGHT_COSET_SUBGROUP_GENERATED, LEFT_COSET_SUBGROUP_GENERATED,
           SCHREIER_TRANSVERSAL_LEMMA }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Normal subgroups.                                                         -/
/- ------------------------------------------------------------------------- -/

structure NormalSubgroups where
  -- @@FIELDS
  normal_subgroup_of : thm
  NORMAL_SUBGROUP_IMP_SUBGROUP : thm
  NORMAL_SUBGROUP_OF_IMP_SUBSET : thm
  NORMAL_SUBGROUP_OF_OPPOSITE_GROUP : thm
  ABELIAN_GROUP_NORMAL_SUBGROUP : thm
  NORMAL_SUBGROUP_CONJUGATE_ALT : thm
  NORMAL_SUBGROUP_CONJUGATE_INV : thm
  NORMAL_SUBGROUP_CONJUGATION_EQ : thm
  NORMAL_SUBGROUP_CONJUGATION : thm
  NORMAL_SUBGROUP_CONJUGATION_SUPERSET : thm
  ABELIAN_GROUP_CONJUGATION : thm
  NORMAL_SUBGROUP_OF_INTERS : thm
  NORMAL_SUBGROUP_OF_INTER : thm
  NORMAL_SUBGROUP_OF_UNIONS : thm
  NORMAL_SUBGROUP_ACTION_KERNEL : thm
  NORMAL_SUBGROUP_LEFT_EQ_RIGHT_COSETS : thm
  NORMAL_SUBGROUP_LEFT_SUBSET_RIGHT_COSETS : thm
  NORMAL_SUBGROUP_RIGHT_SUBSET_LEFT_COSETS : thm
  NORMAL_SUBGROUP_MUL_SYM : thm
  TRIVIAL_NORMAL_SUBGROUP_OF : thm
  CARRIER_NORMAL_SUBGROUP_OF : thm
  GROUP_SETINV_RIGHT_COSET : thm
  GROUP_SETINV_LEFT_COSET : thm
  deriving Inhabited

@[nospecialize]
def setupNormalSubgroups [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSetwise1 : Setwise1) (BSetwise2 : Setwise2) (BGroupActions : GroupActions) (BCosets : Cosets) (BCosets1 : Cosets1) :
    ExceptT String IO NormalSubgroups := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, basic_ss, new_definition,
        parse_as_infix, .. } := D
  let { DIFF_EQ_EMPTY, DIFF_UNIONS_PAIRWISE_DISJOINT, EMPTY_UNIONS, EQ_TRANS, .. } := D.core2
  let { EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, .. } := D.core3
  let { IMAGE_EQ, IMAGE_EQ_EMPTY, IMAGE_SUBSET, IMAGE_o, IMP_CONJ_ALT, INTERS_2, .. } := D.core4
  let { IN_ELIM_THM, .. } := D.core5
  let { NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core6
  let { SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL, .. } := D.core7
  let { o_DEF, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, OPPOSITE_GROUP, .. } := BBasics
  let { FORALL_IN_GROUP_CARRIER_INV, GROUP_INV_INV, GROUP_INV_MUL, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { GROUP_CONJUGATION_BY_ID, GROUP_CONJUGATION_CONJUGATION,
        GROUP_CONJUGATION_EQ_SELF, group_conjugation, .. } := BConjugation
  let { CARRIER_SUBGROUP_OF, SUBGROUP_OF_IMP_SUBSET, SUBGROUP_OF_INTERS,
        SUBGROUP_OF_OPPOSITE_GROUP, TRIVIAL_SUBGROUP_OF, subgroup_of, .. } := BSubgroups
  let { GROUP_SETINV_SUBGROUP, GROUP_SETMUL, GROUP_SETMUL_ASSOC, GROUP_SETMUL_LID,
        GROUP_SETMUL_RID, GROUP_SETMUL_SING, GROUP_SETMUL_SYM, OPPOSITE_GROUP_SETINV,
        group_setinv, group_setmul, .. } := BSetwise1
  let { IMAGE_GROUP_CONJUGATION, .. } := BSetwise2
  let { GROUP_ACTION_KERNEL_POINTWISE, GROUP_ACTION_RINV, SUBGROUP_OF_GROUP_STABILIZER,
        group_action, .. } := BGroupActions
  let { IN_LEFT_COSET_INV, IN_RIGHT_COSET_INV, IN_RIGHT_COSET_SELF, LEFT_COSET,
        LEFT_COSET_CARRIER, LEFT_COSET_NONEMPTY, LEFT_COSET_OPPOSITE_GROUP,
        LEFT_COSET_TRIVIAL, RIGHT_COSET, RIGHT_COSET_CARRIER, RIGHT_COSET_NONEMPTY,
        RIGHT_COSET_OPPOSITE_GROUP, RIGHT_COSET_TRIVIAL, left_coset, right_coset, .. } := BCosets
  let { DISJOINT_LEFT_COSETS, IN_LEFT_COSET_SELF, PAIRWISE_DISJOINT_LEFT_COSETS,
        PAIRWISE_DISJOINT_RIGHT_COSETS, UNIONS_LEFT_COSETS, UNIONS_RIGHT_COSETS, .. } := BCosets1
  -- @@SCOPE END

  parse_as_infix ("normal_subgroup_of", (12, "right"))

  let normal_subgroup_of ← new_definition
   r"(n:A->bool) normal_subgroup_of (G:A group) <=>
          n subgroup_of G /\
          !x. x IN group_carrier G ==> left_coset G x n = right_coset G n x"

  let NORMAL_SUBGROUP_IMP_SUBGROUP ← prove
   r"!G n:A->bool. n normal_subgroup_of G ==> n subgroup_of G"
   (SIMP_TAC [normal_subgroup_of])

  let NORMAL_SUBGROUP_OF_IMP_SUBSET ← prove
   r"!G n:A->bool. n normal_subgroup_of G ==> n SUBSET group_carrier G"
   (MESON_TAC [SUBGROUP_OF_IMP_SUBSET, normal_subgroup_of])

  let NORMAL_SUBGROUP_OF_OPPOSITE_GROUP ← prove
   r"!G n:A->bool.
          n normal_subgroup_of opposite_group G <=> n normal_subgroup_of G"
   (REWRITE_TAC [normal_subgroup_of, SUBGROUP_OF_OPPOSITE_GROUP] THEN
    REWRITE_TAC [← GSYM LEFT_COSET_OPPOSITE_GROUP, OPPOSITE_GROUP,
                ← GSYM RIGHT_COSET_OPPOSITE_GROUP] THEN
    MESON_TAC [])

  let ABELIAN_GROUP_NORMAL_SUBGROUP ← prove
   r"!G n:A->bool.
          abelian_group G ==> (n normal_subgroup_of G <=> n subgroup_of G)"
   (REWRITE_TAC [normal_subgroup_of, left_coset, right_coset, subgroup_of] THEN
    MESON_TAC [GROUP_SETMUL_SYM, SING_SUBSET])

  let NORMAL_SUBGROUP_CONJUGATE_ALT ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G <=>
          n subgroup_of G /\
          !x. x IN group_carrier G
              ==> group_setmul G {group_inv G x} (group_setmul G n {x}) = n"
   (REPEAT GEN_TAC THEN REWRITE_TAC [normal_subgroup_of] THEN
    ASM_CASES_TAC (← q r"(n:A->bool) subgroup_of G") THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "x:A")) THEN
    ASM_REWRITE_TAC [left_coset, right_coset] THENL
     [DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [GROUP_SETMUL_ASSOC, SING_SUBSET, GROUP_INV] THEN
      ASM_SIMP_TAC [GROUP_SETMUL_SING, GROUP_MUL_LINV, GROUP_SETMUL_LID],
      DISCH_THEN (MP_TAC o AP_TERM (← q r"group_setmul G {x:A}")) THEN
      ASM_SIMP_TAC [GROUP_SETMUL_ASSOC, GROUP_INV, GROUP_SETMUL, SING_SUBSET] THEN
      ASM_SIMP_TAC [GROUP_SETMUL_SING, GROUP_MUL_RINV, GROUP_SETMUL_LID]])

  let NORMAL_SUBGROUP_CONJUGATE_INV ← prove
   r"!G n:A->bool.
        n normal_subgroup_of G <=>
        n subgroup_of G /\
        !x. x IN group_carrier G
            ==> group_setmul G {group_inv G x} (group_setmul G n {x}) SUBSET n"
   (← do
    let ss ← ExceptT.mk (basic_ss [])
    let a3 ← SET_RULE
     (← q r"(!x. x IN s ==> f x = x) ==> IMAGE f s SUBSET t ==> s SUBSET t")
    let a2 ← SET_RULE (← q r"{f x y | P x /\ y IN {a}} = {f x a | P x}")
    let a1 ← SET_RULE (← q r"{f x y | x IN {a} /\ P y} = {f a y | P y}")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATE_ALT] THEN
    ASM_CASES_TAC (← q r"(n:A->bool) subgroup_of G") THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    EQ_TAC THEN SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    DISCH_TAC THEN X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"group_inv G (x:A)")) THEN
    ASM_SIMP_TAC [GROUP_INV, GROUP_INV_INV] THEN DISCH_THEN (MP_TAC o
     ISPEC (← q r"\y:A. group_mul G (group_inv G x) (group_mul G y x)") o
     MATCH_MP IMAGE_SUBSET) THEN
    REWRITE_TAC [group_setmul, SIMPLE_IMAGE, a1, a2] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN MATCH_MP_TAC a3 THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
    ASM (simpTac ss 4)
     [GROUP_MUL_ASSOC, GROUP_MUL, GROUP_INV, GROUP_MUL_LINV] THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL_LINV, GROUP_MUL, GROUP_INV] THEN
    ASM_SIMP_TAC [GROUP_MUL_LID] THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL_LINV, GROUP_MUL, GROUP_INV] THEN
    ASM_SIMP_TAC [GROUP_MUL_RID]))

  let NORMAL_SUBGROUP_CONJUGATION_EQ ← prove
   r"!G h:A->bool.
          h normal_subgroup_of G <=>
          h subgroup_of G /\
          !a. a IN group_carrier G ==> IMAGE (group_conjugation G a) h = h"
   (REPEAT GEN_TAC THEN REWRITE_TAC [normal_subgroup_of] THEN
    ASM_CASES_TAC (← q r"(h:A->bool) subgroup_of G") THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    REWRITE_TAC [IMAGE_GROUP_CONJUGATION, left_coset, right_coset] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q "x:A") THEN DISCH_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"group_inv G x:A")) THEN
      ASM_SIMP_TAC [GROUP_INV] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [GROUP_SETMUL_ASSOC, SING_SUBSET, GROUP_INV] THEN
      ASM_SIMP_TAC [GROUP_SETMUL_SING, GROUP_SETMUL_LID, GROUP_MUL_RINV],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "x:A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← SYM th])) THEN
      ASM_SIMP_TAC [← GSYM GROUP_SETMUL_ASSOC, SING_SUBSET, GROUP_INV, GROUP_SETMUL,
                   GROUP_SETMUL_SING, GROUP_MUL_LINV, GROUP_SETMUL_RID]])

  let NORMAL_SUBGROUP_CONJUGATION ← prove
   r"!G h:A->bool.
          h normal_subgroup_of G <=>
          h subgroup_of G /\
          !a. a IN group_carrier G ==> IMAGE (group_conjugation G a) h SUBSET h"
   (← do
    let a1 ← SET_RULE
     (← q r"(!x. x IN h ==> f(g x) = x)
      ==> IMAGE g h SUBSET h ==> h SUBSET IMAGE f h")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION_EQ] THEN
    ASM_CASES_TAC (← q r"(h:A->bool) subgroup_of G") THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    EQ_TAC THEN SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN DISCH_TAC THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"group_inv G x:A")) THEN
    ASM_SIMP_TAC [GROUP_INV] THEN MATCH_MP_TAC a1 THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [GROUP_CONJUGATION_CONJUGATION, GROUP_INV] THEN
    ASM_SIMP_TAC [GROUP_MUL_RINV, GROUP_CONJUGATION_BY_ID]))

  let NORMAL_SUBGROUP_CONJUGATION_SUPERSET ← prove
   r"!G h:A->bool.
          h normal_subgroup_of G <=>
          h subgroup_of G /\
          !a. a IN group_carrier G ==> h SUBSET IMAGE (group_conjugation G a) h"
   (← do
    let a1 ← SET_RULE
     (← q r"(!x. x IN h ==> g(f x) = x)
      ==> h SUBSET IMAGE f h ==> IMAGE g h SUBSET h")
    pure (REPEAT GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [NORMAL_SUBGROUP_CONJUGATION_EQ, SUBSET_REFL],
      SIMP_TAC [NORMAL_SUBGROUP_CONJUGATION] THEN STRIP_TAC] THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"group_inv G x:A")) THEN
    ASM_SIMP_TAC [GROUP_INV] THEN MATCH_MP_TAC a1 THEN
    RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of, SUBSET]) THEN
    ASM_SIMP_TAC [GROUP_CONJUGATION_CONJUGATION, GROUP_INV] THEN
    ASM_SIMP_TAC [GROUP_MUL_RINV, GROUP_CONJUGATION_BY_ID]))

  let ABELIAN_GROUP_CONJUGATION ← prove
   r"!G a x:A.
          abelian_group G /\ a IN group_carrier G /\ x IN group_carrier G
          ==> group_conjugation G a x = x"
   (SIMP_TAC [GROUP_CONJUGATION_EQ_SELF, abelian_group])

  let NORMAL_SUBGROUP_OF_INTERS ← prove
   r"!G gs. (!g. g IN gs ==> g normal_subgroup_of G) /\ ~(gs = {})
            ==> INTERS gs normal_subgroup_of G"
   (SIMP_TAC [NORMAL_SUBGROUP_CONJUGATION, SUBGROUP_OF_INTERS] THEN SET_TAC [])

  let NORMAL_SUBGROUP_OF_INTER ← prove
   r"!G g h:A->bool.
          g normal_subgroup_of G /\ h normal_subgroup_of G
          ==> g INTER h normal_subgroup_of G"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM INTERS_2] THEN
    MATCH_MP_TAC NORMAL_SUBGROUP_OF_INTERS THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, NOT_INSERT_EMPTY])

  let NORMAL_SUBGROUP_OF_UNIONS ← prove
   r"!G (u:(A->bool)->bool).
          ~(u = {}) /\
          (!h. h IN u ==> h normal_subgroup_of G) /\
          (!g h. g IN u /\ h IN u ==> g SUBSET h \/ h SUBSET g)
          ==> (UNIONS u) normal_subgroup_of G"
   (REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION, subgroup_of] THEN SET_TAC [])

  let NORMAL_SUBGROUP_ACTION_KERNEL ← prove
   r"!G s (a:A->X->X).
          group_action G s a
          ==> {g | g IN group_carrier G /\ !x. x IN s ==> a g x = x}
              normal_subgroup_of G"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [GROUP_ACTION_KERNEL_POINTWISE] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [CARRIER_SUBGROUP_OF] THEN
      MATCH_MP_TAC SUBGROUP_OF_INTERS THEN
      ASM_REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
      ASM_MESON_TAC [SUBGROUP_OF_GROUP_STABILIZER],
      X_GEN_TAC (← q "g:A") THEN DISCH_TAC] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
    X_GEN_TAC (← q "h:A") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [group_action]) THEN
    ASM_SIMP_TAC [GROUP_ID, GROUP_INV, GROUP_MUL, group_conjugation] THEN
    ASM_MESON_TAC [GROUP_ACTION_RINV])

  let NORMAL_SUBGROUP_LEFT_EQ_RIGHT_COSETS ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G <=>
          n subgroup_of G /\
          {left_coset G x n |x| x IN group_carrier G} =
          {right_coset G n x |x| x IN group_carrier G}"
   (← do
    let a2 ← SET_RULE
     (← q r"(!x. x IN s ==> x IN f x /\ x IN g x) /\
        (!x y. x IN s /\ y IN s /\ ~(f x = f y) ==> DISJOINT (f x) (f y)) /\
        {f x | x IN s} = {g x | x IN s}
        ==> !x. x IN s ==> f x = g x")
    let a1 ← SET_RULE
     (← q r"(!x. x IN s ==> f x = g x) ==> {f x | x IN s} = {g x | x IN s}")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [normal_subgroup_of] THEN
    ASM_CASES_TAC (← q r"(n:A->bool) subgroup_of G") THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THEN STRIP_TAC THENL
     [MATCH_MP_TAC a1 THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC a2 THEN
      ASM_SIMP_TAC [IN_LEFT_COSET_SELF, IN_RIGHT_COSET_SELF] THEN
      ASM_SIMP_TAC [DISJOINT_LEFT_COSETS]]))

  let (NORMAL_SUBGROUP_LEFT_SUBSET_RIGHT_COSETS,
       NORMAL_SUBGROUP_RIGHT_SUBSET_LEFT_COSETS) ← CONJ_PAIR (← prove
   r"(!G n:A->bool.
          n normal_subgroup_of G <=>
          n subgroup_of G /\
          {left_coset G x n |x| x IN group_carrier G} SUBSET
          {right_coset G n x |x| x IN group_carrier G}) /\
     (!G n:A->bool.
          n normal_subgroup_of G <=>
          n subgroup_of G /\
          {right_coset G n x |x| x IN group_carrier G} SUBSET
          {left_coset G x n |x| x IN group_carrier G})"
   (← do
    let a1 ← SET_RULE
     (← q r"(!x. x IN t ==> ~(P x))
      ==> (!x. x IN t DIFF s ==> P x) ==> t SUBSET s")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [NORMAL_SUBGROUP_LEFT_EQ_RIGHT_COSETS] THEN
    ASM_CASES_TAC (← q r"(n:A->bool) subgroup_of G") THEN
    ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_THEN (MP_TAC o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] DIFF_UNIONS_PAIRWISE_DISJOINT)) THEN
    ASM_SIMP_TAC [UNIONS_LEFT_COSETS, UNIONS_RIGHT_COSETS, DIFF_EQ_EMPTY,
      PAIRWISE_DISJOINT_RIGHT_COSETS, PAIRWISE_DISJOINT_LEFT_COSETS] THEN
    DISCH_THEN (MP_TAC o SYM) THEN REWRITE_TAC [EMPTY_UNIONS] THEN
    MATCH_MP_TAC a1 THEN
    ASM_SIMP_TAC [FORALL_IN_GSPEC, LEFT_COSET_NONEMPTY, RIGHT_COSET_NONEMPTY])))

  let NORMAL_SUBGROUP_MUL_SYM ← prove
   r"!G h:A->bool.
          h normal_subgroup_of G <=>
          h subgroup_of G /\
          !x y. x IN group_carrier G /\ y IN group_carrier G
                ==> (group_mul G x y IN h <=> group_mul G y x IN h)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [normal_subgroup_of] THEN
    ASM_CASES_TAC (← q r"(h:A->bool) subgroup_of G") THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM FORALL_IN_GROUP_CARRIER_INV] THEN
    TRANS_TAC EQ_TRANS
     (← q r"!x y:A. x IN group_carrier G /\ y IN group_carrier G
              ==> (y IN left_coset G (group_inv G x) h <=>
                   y IN right_coset G h (group_inv G x))") THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q "G:A group", ← q r"h:A->bool"] LEFT_COSET) THEN
      MP_TAC (← ISPECL [← q "G:A group", ← q r"h:A->bool"] RIGHT_COSET) THEN
      ASM_SIMP_TAC [SUBGROUP_OF_IMP_SUBSET] THEN
      REWRITE_TAC [SUBSET, EXTENSION] THEN MESON_TAC [GROUP_INV],
      ASM_SIMP_TAC [IN_LEFT_COSET_INV, IN_RIGHT_COSET_INV,
                   SUBGROUP_OF_IMP_SUBSET]])

  let TRIVIAL_NORMAL_SUBGROUP_OF ← prove
   r"!G:A group. {group_id G} normal_subgroup_of G"
   (SIMP_TAC [normal_subgroup_of, TRIVIAL_SUBGROUP_OF,
             RIGHT_COSET_TRIVIAL, LEFT_COSET_TRIVIAL])

  let CARRIER_NORMAL_SUBGROUP_OF ← prove
   r"!G:A group. (group_carrier G) normal_subgroup_of G"
   (SIMP_TAC [normal_subgroup_of, CARRIER_SUBGROUP_OF] THEN
    SIMP_TAC [LEFT_COSET_CARRIER, RIGHT_COSET_CARRIER])

  let GROUP_SETINV_RIGHT_COSET ← prove
   r"!G n a:A.
          n normal_subgroup_of G /\ a IN group_carrier G
          ==> group_setinv G (right_coset G n a) =
              right_coset G n (group_inv G a)"
   (← do
    let a2 ← SET_RULE (← q r"{f x y | x IN {a} /\ P y} = {f a y | P y}")
    let a1 ← SET_RULE (← q r"{f x y | P x /\ y IN {a}} = {f x a | P x}")
    pure (REWRITE_TAC [normal_subgroup_of, left_coset, right_coset] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    TRANS_TAC EQ_TRANS
      (← q r"group_setmul G {group_inv G a} (group_setinv G n):A->bool") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [group_setinv, group_setmul, a1, a2] THEN
      REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o] THEN
      MATCH_MP_TAC IMAGE_EQ THEN RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [GROUP_INV_MUL, o_DEF],
      ASM_SIMP_TAC [GROUP_SETINV_SUBGROUP, GROUP_INV]]))

  let GROUP_SETINV_LEFT_COSET ← prove
   r"!G n a:A.
          n normal_subgroup_of G /\ a IN group_carrier G
          ==> group_setinv G (left_coset G a n) =
              left_coset G (group_inv G a) n"
   (REWRITE_TAC [LEFT_COSET_OPPOSITE_GROUP] THEN
    ONCE_REWRITE_TAC [← GSYM OPPOSITE_GROUP_SETINV] THEN
    SIMP_TAC [GROUP_SETINV_RIGHT_COSET, NORMAL_SUBGROUP_OF_OPPOSITE_GROUP,
             OPPOSITE_GROUP])

  -- @@RETURN BEGIN
  return { normal_subgroup_of, NORMAL_SUBGROUP_IMP_SUBGROUP,
           NORMAL_SUBGROUP_OF_IMP_SUBSET, NORMAL_SUBGROUP_OF_OPPOSITE_GROUP,
           ABELIAN_GROUP_NORMAL_SUBGROUP, NORMAL_SUBGROUP_CONJUGATE_ALT,
           NORMAL_SUBGROUP_CONJUGATE_INV, NORMAL_SUBGROUP_CONJUGATION_EQ,
           NORMAL_SUBGROUP_CONJUGATION, NORMAL_SUBGROUP_CONJUGATION_SUPERSET,
           ABELIAN_GROUP_CONJUGATION, NORMAL_SUBGROUP_OF_INTERS,
           NORMAL_SUBGROUP_OF_INTER, NORMAL_SUBGROUP_OF_UNIONS,
           NORMAL_SUBGROUP_ACTION_KERNEL, NORMAL_SUBGROUP_LEFT_EQ_RIGHT_COSETS,
           NORMAL_SUBGROUP_LEFT_SUBSET_RIGHT_COSETS,
           NORMAL_SUBGROUP_RIGHT_SUBSET_LEFT_COSETS, NORMAL_SUBGROUP_MUL_SYM,
           TRIVIAL_NORMAL_SUBGROUP_OF, CARRIER_NORMAL_SUBGROUP_OF,
           GROUP_SETINV_RIGHT_COSET, GROUP_SETINV_LEFT_COSET }
  -- @@RETURN END

structure NormalSubgroups2 where
  -- @@FIELDS
  GROUP_SETMUL_RIGHT_COSET : thm
  GROUP_SETMUL_LEFT_COSET : thm
  CROSS_NORMAL_SUBGROUP_OF_PROD_GROUP : thm
  NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED_GEN : thm
  NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED : thm
  GROUP_SETMUL_NORMAL_SUBGROUP_LEFT : thm
  GROUP_SETMUL_NORMAL_SUBGROUP_RIGHT : thm
  GROUP_SETMUL_NORMAL_SUBGROUP : thm
  CARRIER_SUBGROUP_GENERATED_UNION_LEFT : thm
  CARRIER_SUBGROUP_GENERATED_UNION_RIGHT : thm
  deriving Inhabited

@[nospecialize]
def setupNormalSubgroups2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) (BSetwise1 : Setwise1) (BSetwise2 : Setwise2) (BCosets : Cosets) (BCosets2 : Cosets2) (BCosetProducts : CosetProducts) (BNormalSubgroups : NormalSubgroups) :
    ExceptT String IO NormalSubgroups2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CROSS_EQ, EQ_IMP, .. } := D.core2
  let { FORALL_PAIR_THM, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_CROSS, IN_SING, .. } := D.core5
  let { SING_SUBSET, SUBSET, SUBSET_INTER, SUBSET_TRANS, .. } := D.core7
  let { GROUP_ID, GROUP_MUL, OPPOSITE_GROUP, .. } := BBasics
  let { SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_OF_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_SUBSET_CARRIER, .. } := BSubgroupGen1
  let { CROSS_SUBGROUP_OF_PROD_GROUP, PROD_GROUP, .. } := BProdGroup
  let { GROUP_SETINV, GROUP_SETMUL, GROUP_SETMUL_ASSOC, GROUP_SETMUL_SING,
        OPPOSITE_GROUP_SETMUL, group_setmul, .. } := BSetwise1
  let { GROUP_SETMUL_SUBGROUP, SUBGROUP_GENERATED_SETMUL, SUBGROUP_SETMUL_EQ, .. } := BSetwise2
  let { LEFT_COSET_NONEMPTY, LEFT_COSET_OPPOSITE_GROUP, RIGHT_COSET_NONEMPTY,
        left_coset, right_coset, .. } := BCosets
  let { LEFT_COSET_PROD_GROUP, RIGHT_COSET_PROD_GROUP, .. } := BCosets2
  let { LEFT_COSET_SUBGROUP_GENERATED, RIGHT_COSET_SUBGROUP_GENERATED, .. } := BCosetProducts
  let { NORMAL_SUBGROUP_IMP_SUBGROUP, NORMAL_SUBGROUP_OF_OPPOSITE_GROUP,
        normal_subgroup_of, .. } := BNormalSubgroups
  -- @@SCOPE END

  let GROUP_SETMUL_RIGHT_COSET ← prove
   r"!G n a b:A.
        n normal_subgroup_of G /\ a IN group_carrier G /\ b IN group_carrier G
        ==> group_setmul G (right_coset G n a) (right_coset G n b) =
            right_coset G n (group_mul G a b)"
   (← do
    let m1 ← MESON [GROUP_SETMUL_ASSOC, GROUP_SETMUL, GROUP_SETINV]
     (← q r"a SUBSET group_carrier G /\ b SUBSET group_carrier G /\
    c SUBSET group_carrier G /\ d SUBSET group_carrier G
    ==> group_setmul G (group_setmul G a b) (group_setmul G c d) =
        group_setmul G a (group_setmul G (group_setmul G b c) d)")
    pure (REWRITE_TAC [normal_subgroup_of, left_coset, right_coset] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q "a:A")) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    ASM_SIMP_TAC [SING_SUBSET, m1] THEN
    ASM_SIMP_TAC [GROUP_SETMUL_SUBGROUP] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q "b:A")) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "group_mul G a b:A")) THEN
    ASM_SIMP_TAC [GROUP_MUL] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [GROUP_SETMUL_ASSOC, SING_SUBSET, GROUP_SETMUL_SING]))

  let GROUP_SETMUL_LEFT_COSET ← prove
   r"!G n a b:A.
          n normal_subgroup_of G /\ a IN group_carrier G /\ b IN group_carrier G
          ==> group_setmul G (left_coset G a n) (left_coset G b n) =
              left_coset G (group_mul G a b) n"
   (REWRITE_TAC [LEFT_COSET_OPPOSITE_GROUP] THEN
    ONCE_REWRITE_TAC [← GSYM OPPOSITE_GROUP_SETMUL] THEN
    SIMP_TAC [GROUP_SETMUL_RIGHT_COSET, NORMAL_SUBGROUP_OF_OPPOSITE_GROUP,
             OPPOSITE_GROUP])

  let CROSS_NORMAL_SUBGROUP_OF_PROD_GROUP ← prove
   r"!(G1:A group) (G2:B group) h1 h2.
          (h1 CROSS h2) normal_subgroup_of (prod_group G1 G2) <=>
          h1 normal_subgroup_of G1 /\ h2 normal_subgroup_of G2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [normal_subgroup_of] THEN
    REWRITE_TAC [FORALL_PAIR_THM, RIGHT_COSET_PROD_GROUP, LEFT_COSET_PROD_GROUP,
      CROSS_SUBGROUP_OF_PROD_GROUP, CROSS_EQ, PROD_GROUP, IN_CROSS] THEN
    ASM_CASES_TAC (← q r"(h1:A->bool) subgroup_of G1") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(h2:B->bool) subgroup_of G2") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [RIGHT_COSET_NONEMPTY, LEFT_COSET_NONEMPTY] THEN
    MESON_TAC [GROUP_ID])

  let NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED_GEN ← prove
   r"!G s h:A->bool.
          h normal_subgroup_of G /\
          h SUBSET group_carrier(subgroup_generated G s)
          ==> h normal_subgroup_of (subgroup_generated G s)"
   (SIMP_TAC [normal_subgroup_of, SUBGROUP_OF_SUBGROUP_GENERATED_EQ] THEN
    SIMP_TAC [LEFT_COSET_SUBGROUP_GENERATED, RIGHT_COSET_SUBGROUP_GENERATED] THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET])

  let NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED ← prove
   r"!G s h:A->bool.
          h normal_subgroup_of G /\ h SUBSET s
          ==> h normal_subgroup_of (subgroup_generated G s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED_GEN THEN
    ASM_REWRITE_TAC [] THEN
    wPart rand rand SUBGROUP_GENERATED_SUBSET_CARRIER THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
    ASM_SIMP_TAC [SUBSET_INTER, NORMAL_SUBGROUP_IMP_SUBGROUP,
                 SUBGROUP_OF_IMP_SUBSET])

  let GROUP_SETMUL_NORMAL_SUBGROUP_LEFT ← prove
   r"!G n h:A->bool.
          n normal_subgroup_of G /\ h subgroup_of G
          ==> group_setmul G n h subgroup_of G"
   (REWRITE_TAC [normal_subgroup_of, left_coset, right_coset] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [SUBGROUP_SETMUL_EQ] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_setmul, subgroup_of]) THEN
    CONV_TAC SYM_CONV THEN REWRITE_TAC [group_setmul] THEN MATCH_MP_TAC (← SET_RULE
    (← q r"(!x. x IN s ==> {f x y | y IN t} = {f y x | y IN t})
      ==> {f x y | x IN s /\ y IN t} = {f y x | y IN t /\ x IN s}")) THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q "x:A")) THEN
    REWRITE_TAC [group_setmul, IN_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC EQ_IMP THEN BINOP_TAC] THEN
    ASM SET_TAC [])

  let GROUP_SETMUL_NORMAL_SUBGROUP_RIGHT ← prove
   r"!G h n:A->bool.
          h subgroup_of G /\ n normal_subgroup_of G
          ==> group_setmul G h n subgroup_of G"
   (REWRITE_TAC [normal_subgroup_of, left_coset, right_coset] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [SUBGROUP_SETMUL_EQ] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_setmul, subgroup_of]) THEN
    REWRITE_TAC [group_setmul] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN s ==> {f x y | y IN t} = {f y x | y IN t})
      ==> {f x y | x IN s /\ y IN t} = {f y x | y IN t /\ x IN s}")) THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q "x:A")) THEN
    REWRITE_TAC [group_setmul, IN_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC EQ_IMP THEN BINOP_TAC] THEN
    ASM SET_TAC [])

  let GROUP_SETMUL_NORMAL_SUBGROUP ← prove
   r"!G h k:A->bool.
          h normal_subgroup_of G /\ k normal_subgroup_of G
          ==> group_setmul G h k normal_subgroup_of G"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [GROUP_SETMUL_NORMAL_SUBGROUP_RIGHT, left_coset, right_coset,
                 normal_subgroup_of, NORMAL_SUBGROUP_IMP_SUBGROUP] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [normal_subgroup_of])) THEN
    REWRITE_TAC [subgroup_of, left_coset, right_coset] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 (ASSUME_TAC o CONJUNCT1) ASSUME_TAC)) THEN
    ASM_MESON_TAC [GROUP_SETMUL_ASSOC, SING_SUBSET])

  let CARRIER_SUBGROUP_GENERATED_UNION_LEFT ← prove
   r"!G g h:A->bool.
          g normal_subgroup_of G /\ h subgroup_of G
          ==> group_carrier(subgroup_generated G (g UNION h)) =
              group_setmul G g h"
   (MESON_TAC [GROUP_SETMUL_NORMAL_SUBGROUP_LEFT,
              SUBGROUP_GENERATED_SETMUL, NORMAL_SUBGROUP_IMP_SUBGROUP,
              CARRIER_SUBGROUP_GENERATED_SUBGROUP])

  let CARRIER_SUBGROUP_GENERATED_UNION_RIGHT ← prove
   r"!G g h:A->bool.
          g subgroup_of G /\ h normal_subgroup_of G
          ==> group_carrier(subgroup_generated G (g UNION h)) =
              group_setmul G g h"
   (MESON_TAC [GROUP_SETMUL_NORMAL_SUBGROUP_RIGHT,
              SUBGROUP_GENERATED_SETMUL, NORMAL_SUBGROUP_IMP_SUBGROUP,
              CARRIER_SUBGROUP_GENERATED_SUBGROUP])

  -- @@RETURN BEGIN
  return { GROUP_SETMUL_RIGHT_COSET, GROUP_SETMUL_LEFT_COSET,
           CROSS_NORMAL_SUBGROUP_OF_PROD_GROUP,
           NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED_GEN,
           NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED, GROUP_SETMUL_NORMAL_SUBGROUP_LEFT,
           GROUP_SETMUL_NORMAL_SUBGROUP_RIGHT, GROUP_SETMUL_NORMAL_SUBGROUP,
           CARRIER_SUBGROUP_GENERATED_UNION_LEFT, CARRIER_SUBGROUP_GENERATED_UNION_RIGHT }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Congugate subgroups, or more generally subsets.                           -/
/- ------------------------------------------------------------------------- -/

structure Conjugate where
  -- @@FIELDS
  group_conjugate : thm
  GROUP_CONJUGATE_REFL : thm
  GROUP_CONJUGATE_SYM : thm
  GROUP_CONJUGATE_TRANS : thm
  GROUP_CONJUGATE_SUBGROUPS_GENERATED : thm
  GROUP_CONJUGATE_IMP_ISOMORPHIC : thm
  GROUP_CONJUGATE_IMP_CARD_EQ : thm
  GROUP_ORBIT_CONJUGATE_STABILIZERS : thm
  CARD_EQ_GROUP_ORBIT_STABILIZERS : thm
  deriving Inhabited

@[nospecialize]
def setupConjugate [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BConjugation : Conjugation) (BSubgroupGenerated : SubgroupGenerated) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms3 : Homomorphisms3) (BIso1 : Iso1) (BGroupActions : GroupActions) (BGroupOrbits : GroupOrbits) (BOrbitStabilizer : OrbitStabilizer) :
    ExceptT String IO Conjugate := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, new_definition, .. } := D
  let { CARD_EQ_IMAGE, CARD_EQ_SYM, .. } := D.core1
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, SUBSET, .. } := D.core7
  let { GROUP_ID, GROUP_MUL, .. } := BBasics
  let { EXISTS_IN_GROUP_CARRIER_INV, .. } := BDerived
  let { GROUP_CONJUGATION_EQ, IMAGE_GROUP_CONJUGATION_BY_ID,
        IMAGE_GROUP_CONJUGATION_BY_INV, IMAGE_GROUP_CONJUGATION_BY_MUL, .. } := BConjugation
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, .. } := BSubgroupGenerated
  let { GROUP_HOMOMORPHISM_CONJUGATION, GROUP_ISOMORPHISM_CONJUGATION,
        SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE, .. } := BHomomorphisms2
  let { GROUP_ISOMORPHISM_BETWEEN_SUBGROUPS, .. } := BHomomorphisms3
  let { isomorphic_group, .. } := BIso1
  let { GROUP_STABILIZER_SUBSET_CARRIER, .. } := BGroupActions
  let { group_orbit, .. } := BGroupOrbits
  let { GROUP_STABILIZER_OF_ACTION, .. } := BOrbitStabilizer
  -- @@SCOPE END

  let group_conjugate ← new_definition
   r"group_conjugate (G:A group) s t <=>
          s SUBSET group_carrier G /\
          t SUBSET group_carrier G /\
          ?a. a IN group_carrier G /\ IMAGE (group_conjugation G a) s = t"

  let GROUP_CONJUGATE_REFL ← prove
   r"!G s:A->bool.
          group_conjugate G s s <=> s SUBSET group_carrier G"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_conjugate] THEN
    MESON_TAC [GROUP_ID, IMAGE_GROUP_CONJUGATION_BY_ID])

  let GROUP_CONJUGATE_SYM ← prove
   r"!G s t:A->bool. group_conjugate G s t <=> group_conjugate G t s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_conjugate] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
     [← GSYM EXISTS_IN_GROUP_CARRIER_INV] THEN
    MESON_TAC [IMAGE_GROUP_CONJUGATION_BY_INV])

  let GROUP_CONJUGATE_TRANS ← prove
   r"!G s t u:A->bool.
          group_conjugate G s t /\ group_conjugate G t u
          ==> group_conjugate G s u"
   (REWRITE_TAC [group_conjugate] THEN
    MESON_TAC [GROUP_MUL, IMAGE_GROUP_CONJUGATION_BY_MUL])

  let GROUP_CONJUGATE_SUBGROUPS_GENERATED ← prove
   r"!G s t:A->bool.
          group_conjugate G s t
          ==> group_conjugate G (group_carrier(subgroup_generated G s))
                                (group_carrier(subgroup_generated G t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_conjugate] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET] THEN
    CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_CONJUGATION])

  let GROUP_CONJUGATE_IMP_ISOMORPHIC ← prove
   r"!G s t:A->bool.
        group_conjugate G s t
        ==> (subgroup_generated G s) isomorphic_group (subgroup_generated G t)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [group_conjugate, RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
    REWRITE_TAC [isomorphic_group] THEN
    EXISTS_TAC (← q r"group_conjugation G (a:A)") THEN
    MATCH_MP_TAC GROUP_ISOMORPHISM_BETWEEN_SUBGROUPS THEN
    ASM_SIMP_TAC [GROUP_ISOMORPHISM_CONJUGATION])

  let GROUP_CONJUGATE_IMP_CARD_EQ ← prove
   r"!G s t:A->bool. group_conjugate G s t ==> s =_c t"
   (REWRITE_TAC [group_conjugate] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN MATCH_MP_TAC CARD_EQ_IMAGE THEN
    ASM_MESON_TAC [GROUP_CONJUGATION_EQ, SUBSET])

  let GROUP_ORBIT_CONJUGATE_STABILIZERS ← prove
   r"!G s (a:A->X->X) x y.
        group_action G s a /\ group_orbit G s a x y
        ==> group_conjugate G (group_stabilizer G a x) (group_stabilizer G a y)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_orbit] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q "g:A") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
    REWRITE_TAC [group_conjugate, GROUP_STABILIZER_SUBSET_CARRIER] THEN
    ASM_MESON_TAC [GROUP_STABILIZER_OF_ACTION])

  let CARD_EQ_GROUP_ORBIT_STABILIZERS ← prove
   r"!G s (a:A->X->X) x y.
          group_action G s a /\ group_orbit G s a x y
          ==> group_stabilizer G a x =_c group_stabilizer G a y"
   (MESON_TAC [GROUP_ORBIT_CONJUGATE_STABILIZERS, GROUP_CONJUGATE_IMP_CARD_EQ])

  -- @@RETURN BEGIN
  return { group_conjugate, GROUP_CONJUGATE_REFL, GROUP_CONJUGATE_SYM,
           GROUP_CONJUGATE_TRANS, GROUP_CONJUGATE_SUBGROUPS_GENERATED,
           GROUP_CONJUGATE_IMP_ISOMORPHIC, GROUP_CONJUGATE_IMP_CARD_EQ,
           GROUP_ORBIT_CONJUGATE_STABILIZERS, CARD_EQ_GROUP_ORBIT_STABILIZERS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Centralizer and normalizer.                                               -/
/- ------------------------------------------------------------------------- -/

structure CentralizerNormalizer where
  -- @@FIELDS
  group_centralizer : thm
  group_normalizer : thm
  GROUP_CENTRALIZER : thm
  GROUP_NORMALIZER : thm
  GROUP_NORMALIZER_CONJUGATION_EQ : thm
  GROUP_NORMALIZER_CONJUGATION : thm
  GROUP_NORMALIZER_FINITE : thm
  GROUP_CENTRALIZER_RESTRICT : thm
  GROUP_NORMALIZER_RESTRICT : thm
  GROUP_CENTRALIZER_SUBSET_CARRIER : thm
  GROUP_NORMALIZER_SUBSET_CARRIER : thm
  FINITE_GROUP_CENTRALIZER : thm
  FINITE_GROUP_NORMALIZER : thm
  GROUP_CENTRALIZER_SUBSET_NORMALIZER : thm
  SUBGROUP_GROUP_CENTRALIZER : thm
  SUBGROUP_GROUP_NORMALIZER : thm
  GROUP_CENTRALIZER_SUBGROUP_GENERATED : thm
  GROUP_NORMALIZER_SUBGROUP_GENERATED : thm
  IN_GROUP_CENTRALIZER_ID : thm
  IN_GROUP_NORMALIZER_ID : thm
  GROUP_CENTRALIZER_NONEMPTY : thm
  GROUP_NORMALIZER_NONEMPTY : thm
  GROUP_CENTRALIZER_SUBSET : thm
  GROUP_CENTRALIZER_SUBSET_EQ : thm
  GROUP_CENTRE_EQ_CARRIER : thm
  GROUP_CENTRALIZER_CENTRALIZER_SUBSET : thm
  GROUP_NORMALIZER_MAXIMAL_GEN : thm
  GROUP_NORMALIZER_MAXIMAL : thm
  NORMAL_SUBGROUP_NORMALIZER_CONTAINS_CARRIER : thm
  NORMAL_SUBGROUP_NORMALIZER_EQ_CARRIER : thm
  GROUP_NORMALIZER_SUBSET : thm
  NORMAL_SUBGROUP_OF_NORMALIZER : thm
  GROUP_CENTRALIZER_POINTWISE : thm
  deriving Inhabited

@[nospecialize]
def setupCentralizerNormalizer [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSetwise1 : Setwise1) (BSetwise2 : Setwise2) (BCosetProducts : CosetProducts) (BNormalSubgroups : NormalSubgroups) :
    ExceptT String IO CentralizerNormalizer := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, new_definition, .. } := D
  let { CARD_IMAGE_INJ, CARD_SUBSET_EQ, .. } := D.core1
  let { EXTENSION, FINITE_SUBSET, .. } := D.core3
  let { INTERS_GSPEC, INTER_SUBSET, .. } := D.core4
  let { IN_ELIM_THM, IN_GSPEC, IN_SING, .. } := D.core5
  let { MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core6
  let { SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_RESTRICT, .. } := D.core7
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_COMMUTES_INV, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { GROUP_CONJUGATION_EQ, IMAGE_GROUP_CONJUGATION_BY_ID,
        IMAGE_GROUP_CONJUGATION_BY_INV, IMAGE_GROUP_CONJUGATION_BY_MUL, .. } := BConjugation
  let { CARRIER_SUBGROUP_OF, IMAGE_GROUP_CONJUGATION_SUBGROUP, SUBGROUP_OF_IMP_SUBSET,
        subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, GROUP_CONJUGATION_SUBGROUP_GENERATED,
        SUBGROUP_GENERATED, SUBGROUP_OF_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_GROUP_CARRIER,
        SUBGROUP_GENERATED_MINIMAL_EQ, .. } := BSubgroupGen1
  let { GROUP_SETMUL_SING, GROUP_SETMUL_SYM_ELEMENTWISE, .. } := BSetwise1
  let { IMAGE_GROUP_CONJUGATION_EQ, .. } := BSetwise2
  let { GROUP_SETMUL_SUBGROUP_GENERATED, .. } := BCosetProducts
  let { NORMAL_SUBGROUP_CONJUGATION_EQ, .. } := BNormalSubgroups
  -- @@SCOPE END

  let group_centralizer ← new_definition
   r"group_centralizer G s =
          {x:A | x IN group_carrier G /\
                 !y. y IN group_carrier G /\ y IN s
                     ==> group_mul G x y = group_mul G y x}"

  let group_normalizer ← new_definition
   r"group_normalizer G s =
          {x:A | x IN group_carrier G /\
                 group_setmul G {x} (group_carrier G INTER s) =
                 group_setmul G (group_carrier G INTER s) {x}}"

  let GROUP_CENTRALIZER ← prove
   r"!G s:A->bool.
          s SUBSET group_carrier G
          ==> group_centralizer G s =
               {x | x IN group_carrier G /\
                    !y. y IN s ==> group_mul G x y = group_mul G y x}"
   (REWRITE_TAC [group_centralizer] THEN SET_TAC [])

  let GROUP_NORMALIZER ← prove
   r"!G s:A->bool.
          s SUBSET group_carrier G
          ==> group_normalizer G s =
               {x | x IN group_carrier G /\
                    group_setmul G {x} s = group_setmul G s {x}}"
   (SIMP_TAC [group_normalizer, ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")])

  let GROUP_NORMALIZER_CONJUGATION_EQ ← prove
   r"!G s:A->bool.
          group_normalizer G s =
               {x | x IN group_carrier G /\
                    IMAGE (group_conjugation G x) (group_carrier G INTER s) =
                    (group_carrier G INTER s)}"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC I [EXTENSION] THEN
    REWRITE_TAC [group_normalizer, IN_ELIM_THM] THEN
    MESON_TAC [IMAGE_GROUP_CONJUGATION_EQ, INTER_SUBSET])

  let GROUP_NORMALIZER_CONJUGATION ← prove
   r"!G s:A->bool.
          s SUBSET group_carrier G
          ==> group_normalizer G s =
              {x | x IN group_carrier G /\ IMAGE (group_conjugation G x) s = s}"
   (SIMP_TAC [GROUP_NORMALIZER_CONJUGATION_EQ, ← SET_RULE
     (← q r"s SUBSET u ==> u INTER s = s")])

  let GROUP_NORMALIZER_FINITE ← prove
   r"!G s:A->bool.
          s SUBSET group_carrier G /\ FINITE s
          ==> group_normalizer G s =
              {x | x IN group_carrier G /\
                   IMAGE (group_conjugation G x) s SUBSET s}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [GROUP_NORMALIZER_CONJUGATION] THEN
    GEN_REWRITE_TAC I [EXTENSION] THEN X_GEN_TAC (← q "a:A") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN MATCH_MP_TAC CARD_SUBSET_EQ THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CARD_IMAGE_INJ THEN
    ASM_MESON_TAC [GROUP_CONJUGATION_EQ, SUBSET])

  let GROUP_CENTRALIZER_RESTRICT ← prove
   r"!G s:A->bool.
          group_centralizer G s =
          group_centralizer G (group_carrier G INTER s)"
   (REWRITE_TAC [group_centralizer] THEN SET_TAC [])

  let GROUP_NORMALIZER_RESTRICT ← prove
   r"!G s:A->bool.
          group_normalizer G s =
          group_normalizer G (group_carrier G INTER s)"
   (REWRITE_TAC [group_normalizer, ← SET_RULE (← q r"u INTER u INTER s = u INTER s")])

  let GROUP_CENTRALIZER_SUBSET_CARRIER ← prove
   r"!G s:A->bool. group_centralizer G s SUBSET group_carrier G"
   (REWRITE_TAC [group_centralizer, SUBSET_RESTRICT])

  let GROUP_NORMALIZER_SUBSET_CARRIER ← prove
   r"!G s:A->bool. group_normalizer G s SUBSET group_carrier G"
   (REWRITE_TAC [group_normalizer, SUBSET_RESTRICT])

  let FINITE_GROUP_CENTRALIZER ← prove
   r"!(G:A group) s. FINITE(group_carrier G) ==> FINITE(group_centralizer G s)"
   (MESON_TAC [FINITE_SUBSET, GROUP_CENTRALIZER_SUBSET_CARRIER])

  let FINITE_GROUP_NORMALIZER ← prove
   r"!(G:A group) s. FINITE(group_carrier G) ==> FINITE(group_normalizer G s)"
   (MESON_TAC [FINITE_SUBSET, GROUP_NORMALIZER_SUBSET_CARRIER])

  let GROUP_CENTRALIZER_SUBSET_NORMALIZER ← prove
   r"!G s:A->bool. group_centralizer G s SUBSET group_normalizer G s"
   (REWRITE_TAC [group_centralizer, group_normalizer, SUBSET, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC GROUP_SETMUL_SYM_ELEMENTWISE THEN
    REWRITE_TAC [GROUP_SETMUL_SING] THEN ASM SET_TAC [])

  let SUBGROUP_GROUP_CENTRALIZER ← prove
   r"!G s:A->bool. (group_centralizer G s) subgroup_of G"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [group_centralizer, subgroup_of, IN_ELIM_THM] THEN
    SIMP_TAC [SUBSET_RESTRICT, GROUP_ID, GROUP_MUL_LID, GROUP_MUL_RID] THEN
    SIMP_TAC [GROUP_INV, GROUP_MUL] THEN
    CONJ_TAC THENL [MESON_TAC [GROUP_COMMUTES_INV], ALL_TAC] THEN
    SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL] THEN
    SIMP_TAC [GROUP_MUL_ASSOC, GROUP_MUL] THEN
    SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL])

  let SUBGROUP_GROUP_NORMALIZER ← prove
   r"!G s:A->bool. (group_normalizer G s) subgroup_of G"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [GROUP_NORMALIZER_RESTRICT] THEN
    MP_TAC (← SET_RULE
     (← q r"group_carrier G INTER s SUBSET (group_carrier G:A->bool)")) THEN
    SPEC_TAC (← q r"group_carrier G INTER s:A->bool", ← q r"s:A->bool") THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [GROUP_NORMALIZER_CONJUGATION] THEN
    REWRITE_TAC [subgroup_of, IN_ELIM_THM, SUBSET_RESTRICT, GROUP_ID] THEN
    ASM_SIMP_TAC [IMAGE_GROUP_CONJUGATION_BY_ID, GROUP_INV, GROUP_MUL] THEN
    ASM_SIMP_TAC [IMAGE_GROUP_CONJUGATION_BY_INV] THEN
    ASM_SIMP_TAC [IMAGE_GROUP_CONJUGATION_BY_MUL])

  let GROUP_CENTRALIZER_SUBGROUP_GENERATED ← prove
   r"!G h s:A->bool.
          s SUBSET h /\ h subgroup_of G
          ==> group_centralizer (subgroup_generated G h) s =
               h INTER group_centralizer G s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(s:A->bool) SUBSET group_carrier G") ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of]) THEN ASM SET_TAC [],
      ASM_SIMP_TAC [GROUP_CENTRALIZER, CARRIER_SUBGROUP_GENERATED_SUBGROUP]] THEN
    REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of]) THEN ASM SET_TAC [])

  let GROUP_NORMALIZER_SUBGROUP_GENERATED ← prove
   r"!G h s:A->bool.
          s SUBSET h /\ h subgroup_of G
          ==> group_normalizer (subgroup_generated G h) s =
               h INTER group_normalizer G s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(s:A->bool) SUBSET group_carrier G") ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of]) THEN ASM SET_TAC [],
      ASM_SIMP_TAC [GROUP_NORMALIZER, CARRIER_SUBGROUP_GENERATED_SUBGROUP]] THEN
    REWRITE_TAC [GROUP_SETMUL_SUBGROUP_GENERATED] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of]) THEN ASM SET_TAC [])

  let IN_GROUP_CENTRALIZER_ID ← prove
   r"!(G:A group) s. group_id G IN group_centralizer G s"
   (REWRITE_TAC [group_centralizer, IN_ELIM_THM, GROUP_ID] THEN
    SIMP_TAC [GROUP_MUL_LID, GROUP_MUL_RID])

  let IN_GROUP_NORMALIZER_ID ← prove
   r"!(G:A group) s. group_id G IN group_normalizer G s"
   (MESON_TAC [SUBSET, GROUP_CENTRALIZER_SUBSET_NORMALIZER,
              IN_GROUP_CENTRALIZER_ID])

  let GROUP_CENTRALIZER_NONEMPTY ← prove
   r"!(G:A group) s. ~(group_centralizer G s = {})"
   (MESON_TAC [IN_GROUP_CENTRALIZER_ID, MEMBER_NOT_EMPTY])

  let GROUP_NORMALIZER_NONEMPTY ← prove
   r"!(G:A group) s. ~(group_normalizer G s = {})"
   (MESON_TAC [IN_GROUP_NORMALIZER_ID, MEMBER_NOT_EMPTY])

  let GROUP_CENTRALIZER_SUBSET ← prove
   r"!G s:A->bool.
          s SUBSET group_centralizer G s <=>
          s SUBSET group_carrier G /\
          !a b. a IN s /\ b IN s ==> group_mul G a b = group_mul G b a"
   (REWRITE_TAC [group_centralizer] THEN SET_TAC [])

  let GROUP_CENTRALIZER_SUBSET_EQ ← prove
   r"!G h:A->bool.
          h subgroup_of G
          ==> (h SUBSET group_centralizer G h <=>
               abelian_group(subgroup_generated G h))"
   (SIMP_TAC [abelian_group, CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    REWRITE_TAC [GROUP_CENTRALIZER_SUBSET, subgroup_of, SUBGROUP_GENERATED] THEN
    SET_TAC [])

  let GROUP_CENTRE_EQ_CARRIER ← prove
   r"!G:A group.
          group_centralizer G (group_carrier G) = group_carrier G <=>
          abelian_group G"
   (REWRITE_TAC [group_centralizer, abelian_group] THEN SET_TAC [])

  let GROUP_CENTRALIZER_CENTRALIZER_SUBSET ← prove
   r"!G s:A->bool.
          s SUBSET group_centralizer G (group_centralizer G s) <=>
          s SUBSET group_carrier G"
   (REWRITE_TAC [group_centralizer] THEN SET_TAC [])

  let GROUP_NORMALIZER_MAXIMAL_GEN ← prove
   r"!G h n:A->bool.
          h normal_subgroup_of (subgroup_generated G n) <=>
          h subgroup_of (subgroup_generated G n) /\
          group_carrier G INTER n SUBSET group_normalizer G h"
   (REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION_EQ,
                SUBGROUP_OF_SUBGROUP_GENERATED_EQ] THEN
    SIMP_TAC [← GSYM SUBGROUP_GENERATED_MINIMAL_EQ, SUBGROUP_GROUP_NORMALIZER] THEN
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(h:A->bool) subgroup_of G") THEN
    ASM_SIMP_TAC [GROUP_NORMALIZER_CONJUGATION, SUBGROUP_OF_IMP_SUBSET,
                 GROUP_CONJUGATION_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, ← SET_RULE
      (← q r"s SUBSET {x | x IN t /\ Q x} <=> s SUBSET t /\ !x. x IN s ==> Q x")])

  let GROUP_NORMALIZER_MAXIMAL ← prove
   r"!G h n:A->bool.
          n subgroup_of G
          ==> (h normal_subgroup_of (subgroup_generated G n) <=>
               h subgroup_of G /\ h SUBSET n /\ n SUBSET group_normalizer G h)"
   (SIMP_TAC [GROUP_NORMALIZER_MAXIMAL_GEN, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
             SUBGROUP_OF_SUBGROUP_GENERATED_EQ, SUBGROUP_OF_IMP_SUBSET,
             ← SET_RULE (← q r"s SUBSET t ==> t INTER s = s")] THEN
    MESON_TAC [])

  let NORMAL_SUBGROUP_NORMALIZER_CONTAINS_CARRIER ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G <=>
          n subgroup_of G /\ group_carrier G SUBSET group_normalizer G n"
   (REPEAT GEN_TAC THEN
    MP_TAC (← SPECL [← q "G:A group", ← q "n:A->bool", ← q "group_carrier G:A->bool"]
          GROUP_NORMALIZER_MAXIMAL) THEN
    REWRITE_TAC [SUBGROUP_GENERATED_GROUP_CARRIER, CARRIER_SUBGROUP_OF] THEN
    MESON_TAC [SUBGROUP_OF_IMP_SUBSET])

  let NORMAL_SUBGROUP_NORMALIZER_EQ_CARRIER ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G <=>
          n subgroup_of G /\ group_normalizer G n = group_carrier G"
   (REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, GROUP_NORMALIZER_SUBSET_CARRIER] THEN
    REWRITE_TAC [NORMAL_SUBGROUP_NORMALIZER_CONTAINS_CARRIER])

  let GROUP_NORMALIZER_SUBSET ← prove
   r"!G h:A->bool.
          h subgroup_of G ==> h SUBSET group_normalizer G h"
   (SIMP_TAC [GROUP_NORMALIZER_CONJUGATION, SUBGROUP_OF_IMP_SUBSET] THEN
    SIMP_TAC [SUBSET, IN_ELIM_THM, IMAGE_GROUP_CONJUGATION_SUBGROUP] THEN
    SIMP_TAC [subgroup_of, SUBSET])

  let NORMAL_SUBGROUP_OF_NORMALIZER ← prove
   r"!G h:A->bool.
          h normal_subgroup_of (subgroup_generated G (group_normalizer G h)) <=>
          h subgroup_of G"
   (SIMP_TAC [GROUP_NORMALIZER_MAXIMAL, SUBGROUP_GROUP_NORMALIZER] THEN
    REWRITE_TAC [SUBSET_REFL, ← TAUT (← q r"(p /\ q <=> p) <=> p ==> q")] THEN
    REWRITE_TAC [GROUP_NORMALIZER_SUBSET])

  let GROUP_CENTRALIZER_POINTWISE ← prove
   r"!G s:A->bool.
          group_centralizer G s =
          if s = {} then group_carrier G
          else INTERS {group_centralizer G {x} | x IN s}"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [group_centralizer, NOT_IN_EMPTY, IN_GSPEC] THEN
    REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_SING] THEN ASM SET_TAC [])

  -- @@RETURN BEGIN
  return { group_centralizer, group_normalizer, GROUP_CENTRALIZER, GROUP_NORMALIZER,
           GROUP_NORMALIZER_CONJUGATION_EQ, GROUP_NORMALIZER_CONJUGATION,
           GROUP_NORMALIZER_FINITE, GROUP_CENTRALIZER_RESTRICT,
           GROUP_NORMALIZER_RESTRICT, GROUP_CENTRALIZER_SUBSET_CARRIER,
           GROUP_NORMALIZER_SUBSET_CARRIER, FINITE_GROUP_CENTRALIZER,
           FINITE_GROUP_NORMALIZER, GROUP_CENTRALIZER_SUBSET_NORMALIZER,
           SUBGROUP_GROUP_CENTRALIZER, SUBGROUP_GROUP_NORMALIZER,
           GROUP_CENTRALIZER_SUBGROUP_GENERATED, GROUP_NORMALIZER_SUBGROUP_GENERATED,
           IN_GROUP_CENTRALIZER_ID, IN_GROUP_NORMALIZER_ID, GROUP_CENTRALIZER_NONEMPTY,
           GROUP_NORMALIZER_NONEMPTY, GROUP_CENTRALIZER_SUBSET,
           GROUP_CENTRALIZER_SUBSET_EQ, GROUP_CENTRE_EQ_CARRIER,
           GROUP_CENTRALIZER_CENTRALIZER_SUBSET, GROUP_NORMALIZER_MAXIMAL_GEN,
           GROUP_NORMALIZER_MAXIMAL, NORMAL_SUBGROUP_NORMALIZER_CONTAINS_CARRIER,
           NORMAL_SUBGROUP_NORMALIZER_EQ_CARRIER, GROUP_NORMALIZER_SUBSET,
           NORMAL_SUBGROUP_OF_NORMALIZER, GROUP_CENTRALIZER_POINTWISE }
  -- @@RETURN END

structure CentralizerNormalizer2 where
  -- @@FIELDS
  GROUP_CENTRALIZER_ALT : thm
  NORMAL_SUBGROUP_CENTRALIZER_NORMALIZER : thm
  NORMAL_SUBGROUP_CENTRALIZER : thm
  GROUP_NORMALIZER_SING : thm
  GROUP_CENTRALIZER_GALOIS_EQ : thm
  GROUP_CENTRALIZER_GALOIS : thm
  GROUP_CENTRALIZER_MONO : thm
  GROUP_ACTION_CONJUGATION_NORMAL_SUBGROUP : thm
  GROUP_STABILIZER_CONJUGATION : thm
  GROUP_ORBIT_CONJUGATION_GEN : thm
  GROUP_ORBIT_CONJUGATION : thm
  GROUP_ACTION_IMAGE_CONJUGATION : thm
  GROUP_STABILIZER_IMAGE_CONJUGATION : thm
  GROUP_ACTION_IMAGE_CONJUGATION_CARRIER : thm
  GROUP_ACTION_IMAGE_CONJUGATION_SUBGROUPS : thm
  GROUP_ORBIT_IMAGE_CONJUGATION : thm
  GROUP_ORBIT_IMAGE_CONJUGATION_GEN : thm
  CARD_CONJUGATE_SUBSETS_MUL_GEN : thm
  CARD_CONJUGATE_SUBSETS_MUL : thm
  CARD_CONJUGATE_SUBSETS : thm
  deriving Inhabited

@[nospecialize]
def setupCentralizerNormalizer2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BHomomorphisms2 : Homomorphisms2) (BSetwise1 : Setwise1) (BGroupActions : GroupActions) (BGroupOrbits : GroupOrbits) (BOrbitStabilizer : OrbitStabilizer) (BNormalSubgroups : NormalSubgroups) (BConjugate : Conjugate) (BCentralizerNormalizer : CentralizerNormalizer) :
    ExceptT String IO CentralizerNormalizer2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CARD_CLAUSES, CARD_CROSS, CARD_EQ_0, CARD_EQ_CARD_IMP, CARD_FINITE_CONG,
        CARD_MUL_FINITE_EQ, .. } := D.core1
  let { CROSS, CROSS_EMPTY, DIV_MULT, ETA_AX, .. } := D.core2
  let { EXTENSION, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core3
  let { IMAGE_CLAUSES, IMP_CONJ_ALT, INTER_EMPTY, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MULT_CLAUSES, MULT_SYM, NOT_IN_EMPTY, .. } := D.core6
  let { SING_SUBSET, SUBSET, SUBSET_REFL, mul_c, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { GROUP_INV, GROUP_MUL, .. } := BBasics
  let { GROUP_CONJUGATION, GROUP_CONJUGATION_CONJUGATION, GROUP_CONJUGATION_EQ_SELF,
        GROUP_CONJUGATION_LINV, GROUP_CONJUGATION_RINV, IMAGE_GROUP_CONJUGATION_SUBSET,
        group_conjugation, .. } := BConjugation
  let { SUBGROUP_OF_IMP_SUBSET, .. } := BSubgroups
  let { GROUP_CONJUGATION_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_GROUP_CARRIER,
        SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ, .. } := BSubgroupGen1
  let { GROUP_HOMOMORPHISM_CONJUGATION, SUBGROUP_OF_HOMOMORPHIC_IMAGE, .. } := BHomomorphisms2
  let { GROUP_SETMUL_EMPTY, GROUP_SETMUL_SING, .. } := BSetwise1
  let { GROUP_ACTION_IMAGE, GROUP_ACTION_ON_SUBSET, group_stabilizer, .. } := BGroupActions
  let { IN_GROUP_ORBIT, group_orbit, .. } := BGroupOrbits
  let { GROUP_ACTION_CONJUGATION, ORBIT_STABILIZER_MUL_GEN, .. } := BOrbitStabilizer
  let { NORMAL_SUBGROUP_CONJUGATION, .. } := BNormalSubgroups
  let { GROUP_CONJUGATE_REFL, group_conjugate, .. } := BConjugate
  let { FINITE_GROUP_NORMALIZER, GROUP_CENTRALIZER_RESTRICT,
        GROUP_CENTRALIZER_SUBSET_NORMALIZER, GROUP_NORMALIZER_CONJUGATION,
        GROUP_NORMALIZER_NONEMPTY, GROUP_NORMALIZER_RESTRICT,
        NORMAL_SUBGROUP_NORMALIZER_EQ_CARRIER, SUBGROUP_GROUP_CENTRALIZER,
        SUBGROUP_GROUP_NORMALIZER, group_centralizer, group_normalizer, .. } := BCentralizerNormalizer
  -- @@SCOPE END

  let GROUP_CENTRALIZER_ALT ← prove
   r"!G s:A->bool.
          group_centralizer G s =
           {x | x IN group_carrier G /\
                !y. y IN group_carrier G /\ y IN s
                    ==> group_conjugation G x y = y}"
   (REWRITE_TAC [group_centralizer, EXTENSION, IN_ELIM_THM] THEN
    MESON_TAC [GROUP_CONJUGATION_EQ_SELF])

  let NORMAL_SUBGROUP_CENTRALIZER_NORMALIZER ← prove
   r"!G h:A->bool.
          group_centralizer G h normal_subgroup_of
          subgroup_generated G (group_normalizer G h)"
   (← do
    let a2 ← MESON []
     (← q r"f(h y) = y /\ g(h y) = h y ==> f(g(h y)) = y")
    let a1 ← SET_RULE
     (← q r"group_carrier G INTER (h:A->bool) SUBSET group_carrier G")
    pure (REPEAT GEN_TAC THEN
     ONCE_REWRITE_TAC [GROUP_CENTRALIZER_RESTRICT, GROUP_NORMALIZER_RESTRICT] THEN
     MP_TAC a1 THEN
     SPEC_TAC (← q r"group_carrier G INTER (h:A->bool)", ← q r"h:A->bool") THEN
     REPEAT STRIP_TAC THEN
     REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION] THEN
     REWRITE_TAC [GROUP_CONJUGATION_SUBGROUP_GENERATED] THEN
     SIMP_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ,
              SUBGROUP_GROUP_CENTRALIZER, SUBGROUP_GROUP_NORMALIZER,
              CARRIER_SUBGROUP_GENERATED_SUBGROUP,
              GROUP_CENTRALIZER_SUBSET_NORMALIZER] THEN
     ASM_SIMP_TAC [GROUP_CENTRALIZER_ALT, GROUP_NORMALIZER_CONJUGATION] THEN
     REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
     X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
     X_GEN_TAC (← q "x:A") THEN STRIP_TAC THEN ASM_SIMP_TAC [GROUP_CONJUGATION] THEN
     X_GEN_TAC (← q "y:A") THEN STRIP_TAC THEN
     GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [group_conjugation] THEN
     ASM_SIMP_TAC [← GSYM GROUP_CONJUGATION_CONJUGATION, GROUP_MUL, GROUP_INV] THEN
     MATCH_MP_TAC a2 THEN
     ASM_SIMP_TAC [GROUP_CONJUGATION_RINV] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
     ASM_SIMP_TAC [GROUP_CONJUGATION, GROUP_INV] THEN UNDISCH_TAC (← q r"(y:A) IN h") THEN
     RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN FIRST_X_ASSUM (fun th => tactic_of do pure (
       GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← SYM th])) THEN
     ASM_SIMP_TAC [IN_IMAGE, LEFT_IMP_EXISTS_THM, GROUP_CONJUGATION_LINV]))

  let NORMAL_SUBGROUP_CENTRALIZER ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> group_centralizer G n normal_subgroup_of G"
   (MESON_TAC [NORMAL_SUBGROUP_NORMALIZER_EQ_CARRIER,
              SUBGROUP_GENERATED_GROUP_CARRIER,
              NORMAL_SUBGROUP_CENTRALIZER_NORMALIZER])

  let GROUP_NORMALIZER_SING ← prove
   r"!G a:A. group_normalizer G {a} = group_centralizer G {a}"
   (← do
    let a2 ← SET_RULE (← q r"~(a IN s) ==> s INTER {a} = {}")
    let a1 ← SET_RULE (← q r"a IN s ==> s INTER {a} = {a}")
    pure (REPEAT GEN_TAC THEN
     ONCE_REWRITE_TAC [GROUP_NORMALIZER_RESTRICT, GROUP_CENTRALIZER_RESTRICT] THEN
     REWRITE_TAC [group_normalizer, group_centralizer] THEN
     ASM_CASES_TAC (← q r"(a:A) IN group_carrier G") THENL
      [ASM_SIMP_TAC [GROUP_SETMUL_SING, a1] THEN
       ASM SET_TAC [],
       ASM_SIMP_TAC [a2, NOT_IN_EMPTY,
                    INTER_EMPTY, GROUP_SETMUL_EMPTY]]))

  let GROUP_CENTRALIZER_GALOIS_EQ ← prove
   r"!G s t:A->bool.
          s SUBSET group_carrier G /\ t SUBSET group_carrier G
          ==> (s SUBSET group_centralizer G t <=>
               t SUBSET group_centralizer G s)"
   (REWRITE_TAC [group_centralizer] THEN SET_TAC [])

  let GROUP_CENTRALIZER_GALOIS ← prove
   r"!G s t:A->bool.
          s SUBSET group_carrier G /\ t SUBSET group_centralizer G s
          ==> s SUBSET group_centralizer G t"
   (REWRITE_TAC [group_centralizer] THEN SET_TAC [])

  let GROUP_CENTRALIZER_MONO ← prove
   r"!G s t:A->bool.
          s SUBSET t ==> group_centralizer G t SUBSET group_centralizer G s"
   (REWRITE_TAC [group_centralizer] THEN SET_TAC [])

  let GROUP_ACTION_CONJUGATION_NORMAL_SUBGROUP ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> group_action G n (group_conjugation G)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ACTION_ON_SUBSET THEN
    EXISTS_TAC (← q r"group_carrier G:A->bool") THEN
    REWRITE_TAC [GROUP_ACTION_CONJUGATION] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [NORMAL_SUBGROUP_CONJUGATION]) THEN
    SIMP_TAC [SUBGROUP_OF_IMP_SUBSET] THEN SET_TAC [])

  let GROUP_STABILIZER_CONJUGATION ← prove
   r"!G a:A.
       a IN group_carrier G
       ==> group_stabilizer G (group_conjugation G) a =
           group_centralizer G {a}"
   (REWRITE_TAC [group_stabilizer, group_centralizer, IN_SING] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    MESON_TAC [GROUP_CONJUGATION_EQ_SELF])

  let GROUP_ORBIT_CONJUGATION_GEN ← prove
   r"!G s x:A.
          s SUBSET group_carrier G
          ==> group_orbit G s (group_conjugation G) x =
              if x IN s then {y | y IN s /\ group_conjugate G {x} {y}} else {}"
   (← do
    let a1 ← SET_RULE (← q r"{a} = {b} <=> a = b")
    pure (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC I [EXTENSION] THEN
     COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_ELIM_THM, NOT_IN_EMPTY] THEN
     ASM_REWRITE_TAC [IN_GROUP_ORBIT, group_conjugate] THEN
     ASM_REWRITE_TAC [SING_SUBSET, IMAGE_CLAUSES] THEN
     REWRITE_TAC [a1] THEN ASM SET_TAC []))

  let GROUP_ORBIT_CONJUGATION ← prove
   r"!G x:A.
          group_orbit G (group_carrier G) (group_conjugation G) x =
          if x IN group_carrier G
          then {y | y IN group_carrier G /\ group_conjugate G {x} {y}}
          else {}"
   (SIMP_TAC [GROUP_ORBIT_CONJUGATION_GEN, SUBSET_REFL])

  let GROUP_ACTION_IMAGE_CONJUGATION ← prove
   r"!G u:(A->bool)->bool.
          (!t. t IN u ==> t SUBSET group_carrier G) /\
          (!g t. g IN group_carrier G /\ t IN u
                 ==> IMAGE (group_conjugation G g) t IN u)
          ==> group_action G u (IMAGE o group_conjugation G)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ACTION_IMAGE THEN
    EXISTS_TAC (← q r"group_carrier G:A->bool") THEN
    ASM_REWRITE_TAC [GROUP_ACTION_CONJUGATION])

  let GROUP_STABILIZER_IMAGE_CONJUGATION ← prove
   r"!G s:A->bool.
          s SUBSET group_carrier G
          ==> group_stabilizer G (IMAGE o group_conjugation G) s =
              group_normalizer G s"
   (SIMP_TAC [GROUP_NORMALIZER_CONJUGATION, group_stabilizer, o_THM])

  let GROUP_ACTION_IMAGE_CONJUGATION_CARRIER ← prove
   r"!G:A group. group_action G {s | s SUBSET group_carrier G}
                                (IMAGE o group_conjugation G)"
   (GEN_TAC THEN MATCH_MP_TAC GROUP_ACTION_IMAGE_CONJUGATION THEN
    REWRITE_TAC [IN_ELIM_THM, IMAGE_GROUP_CONJUGATION_SUBSET])

  let GROUP_ACTION_IMAGE_CONJUGATION_SUBGROUPS ← prove
   r"!G:A group. group_action G {n | n subgroup_of G}
                                (IMAGE o group_conjugation G)"
   (GEN_TAC THEN MATCH_MP_TAC GROUP_ACTION_IMAGE_CONJUGATION THEN
    REWRITE_TAC [IN_ELIM_THM, SUBGROUP_OF_IMP_SUBSET] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBGROUP_OF_HOMOMORPHIC_IMAGE THEN
    ASM_MESON_TAC [GROUP_HOMOMORPHISM_CONJUGATION])

  let GROUP_ORBIT_IMAGE_CONJUGATION ← prove
   r"!G. group_orbit G {s | s SUBSET group_carrier G}
                       (IMAGE o group_conjugation G) =
         group_conjugate G"
   (REWRITE_TAC [FUN_EQ_THM, group_orbit, group_conjugate, IN_ELIM_THM, o_THM])

  let GROUP_ORBIT_IMAGE_CONJUGATION_GEN ← prove
   r"!G u s:A->bool.
          (!t. t IN u ==> t SUBSET group_carrier G) /\ s IN u
          ==> group_orbit G u (IMAGE o group_conjugation G) s =
              \t. t IN u /\ group_conjugate G s t"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    REWRITE_TAC [group_orbit, group_conjugate, o_THM] THEN ASM SET_TAC [])

  let CARD_CONJUGATE_SUBSETS_MUL_GEN ← prove
   r"!G s:A->bool.
          s SUBSET group_carrier G
          ==> {t | group_conjugate G s t} *_c group_normalizer G s =_c
              group_carrier G"
   (← do
    let a1 ← SET_RULE (← q r"{t | P t} = P")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [a1] THEN
     ASM_SIMP_TAC [← GSYM GROUP_STABILIZER_IMAGE_CONJUGATION, ETA_AX] THEN
     ASM_SIMP_TAC [← GSYM GROUP_ORBIT_IMAGE_CONJUGATION] THEN
     MATCH_MP_TAC ORBIT_STABILIZER_MUL_GEN THEN
     ASM_REWRITE_TAC [IN_ELIM_THM, GROUP_CONJUGATE_REFL] THEN
     MATCH_MP_TAC GROUP_ACTION_IMAGE_CONJUGATION THEN
     SIMP_TAC [IN_ELIM_THM, IMAGE_GROUP_CONJUGATION_SUBSET]))

  let CARD_CONJUGATE_SUBSETS_MUL ← prove
   r"!G s:A->bool.
          FINITE(group_carrier G) /\ s SUBSET group_carrier G
          ==> CARD {t | group_conjugate G s t} * CARD(group_normalizer G s) =
              CARD(group_carrier G)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CARD_CONJUGATE_SUBSETS_MUL_GEN) THEN
    FIRST_ASSUM (MP_TAC o GSYM o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_CARD_IMP)) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CARD_FINITE_CONG) THEN
    ASM_REWRITE_TAC [CARD_MUL_FINITE_EQ] THEN REWRITE_TAC [mul_c, ← GSYM CROSS] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [CROSS_EMPTY, CARD_CLAUSES, MULT_CLAUSES] THEN
    ASM_SIMP_TAC [CARD_CROSS])

  let CARD_CONJUGATE_SUBSETS ← prove
   r"!G s:A->bool.
          FINITE(group_carrier G) /\ s SUBSET group_carrier G
          ==> CARD {t | group_conjugate G s t} =
              CARD(group_carrier G) DIV CARD(group_normalizer G s)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP CARD_CONJUGATE_SUBSETS_MUL) THEN
    ONCE_REWRITE_TAC [MULT_SYM] THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC DIV_MULT THEN
    ASM_SIMP_TAC [CARD_EQ_0, FINITE_GROUP_NORMALIZER,
                 GROUP_NORMALIZER_NONEMPTY])

  -- @@RETURN BEGIN
  return { GROUP_CENTRALIZER_ALT, NORMAL_SUBGROUP_CENTRALIZER_NORMALIZER,
           NORMAL_SUBGROUP_CENTRALIZER, GROUP_NORMALIZER_SING,
           GROUP_CENTRALIZER_GALOIS_EQ, GROUP_CENTRALIZER_GALOIS, GROUP_CENTRALIZER_MONO,
           GROUP_ACTION_CONJUGATION_NORMAL_SUBGROUP, GROUP_STABILIZER_CONJUGATION,
           GROUP_ORBIT_CONJUGATION_GEN, GROUP_ORBIT_CONJUGATION,
           GROUP_ACTION_IMAGE_CONJUGATION, GROUP_STABILIZER_IMAGE_CONJUGATION,
           GROUP_ACTION_IMAGE_CONJUGATION_CARRIER,
           GROUP_ACTION_IMAGE_CONJUGATION_SUBGROUPS, GROUP_ORBIT_IMAGE_CONJUGATION,
           GROUP_ORBIT_IMAGE_CONJUGATION_GEN, CARD_CONJUGATE_SUBSETS_MUL_GEN,
           CARD_CONJUGATE_SUBSETS_MUL, CARD_CONJUGATE_SUBSETS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Quotient groups.                                                          -/
/- ------------------------------------------------------------------------- -/

structure QuotientGroups where
  -- @@FIELDS
  quotient_group : thm
  QUOTIENT_GROUP : thm
  ABELIAN_QUOTIENT_GROUP : thm
  FINITE_QUOTIENT_GROUP : thm
  TRIVIAL_QUOTIENT_GROUP : thm
  QUOTIENT_GROUP_ID : thm
  QUOTIENT_GROUP_INV : thm
  QUOTIENT_GROUP_MUL : thm
  QUOTIENT_GROUP_DIV : thm
  QUOTIENT_GROUP_POW : thm
  QUOTIENT_GROUP_ZPOW : thm
  GROUP_HOMOMORPHISM_RIGHT_COSET : thm
  GROUP_EPIMORPHISM_RIGHT_COSET : thm
  CARD_LE_QUOTIENT_GROUP : thm
  CARD_QUOTIENT_GROUP_DIVIDES : thm
  TRIVIAL_QUOTIENT_GROUP_EQ : thm
  TRIVIAL_QUOTIENT_GROUP_SELF : thm
  QUOTIENT_GROUP_TRIVIAL : thm
  GROUP_ISOMORPHISM_PROD_QUOTIENT_GROUP : thm
  ISOMORPHIC_QUOTIENT_PROD_GROUP : thm
  CARTESIAN_PRODUCT_NORMAL_SUBGROUP_OF_PRODUCT_GROUP : thm
  GROUP_ISOMORPHISM_PRODUCT_QUOTIENT_GROUP : thm
  ISOMORPHIC_QUOTIENT_PRODUCT_GROUP : thm
  SUBGROUP_OF_QUOTIENT_GROUP : thm
  SUBGROUP_OF_QUOTIENT_GROUP_ALT : thm
  SUBGROUP_OF_QUOTIENT_GROUP_GENERATED_BY : thm
  QUOTIENT_GROUP_SUBGROUP_GENERATED : thm
  deriving Inhabited

@[nospecialize]
def setupQuotientGroups [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) (BProductGroup : ProductGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BSetwise1 : Setwise1) (BSetwise2 : Setwise2) (BCosets : Cosets) (BCosets2 : Cosets2) (BCosetProducts : CosetProducts) (BNormalSubgroups : NormalSubgroups) (BNormalSubgroups2 : NormalSubgroups2) :
    ExceptT String IO QuotientGroups := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, TAUT,
        new_definition, .. } := D
  let { AND_FORALL_THM, CARTESIAN_PRODUCT_EQ, CARTESIAN_PRODUCT_EQ_EMPTY, CONJ_ASSOC, .. } := D.core1
  let { CONJ_SYM, CROSS_EQ, ETA_AX, EXISTS_IN_GSPEC, EXISTS_PAIR_THM, .. } := D.core2
  let { EXTENSIONAL, FINITE_IMAGE, FORALL_CARTESIAN_PRODUCT_ELEMENTS, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, IN, .. } := D.core4
  let { IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, PAIR_EQ, RESTRICTION, .. } := D.core6
  let { RESTRICTION_IN_EXTENSIONAL, RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE,
        SING_SUBSET, SKOLEM_THM, SUBSET, cartesian_product, .. } := D.core7
  let { GROUPS_EQ, GROUP_CARRIER_NONEMPTY, GROUP_ID, GROUP_INV, GROUP_MUL,
        GROUP_MUL_ASSOC, GROUP_MUL_LINV, GROUP_MUL_RINV, TRIVIAL_GROUP,
        TRIVIAL_GROUP_SUBSET, group_carrier, group_id, group_inv, group_mul,
        group_tybij, trivial_group, .. } := BBasics
  let { GROUP_DIV_EQ_ID, GROUP_POW, group_div, group_pow, .. } := BDerived
  let { group_zpow, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { IN_SUBGROUP_ID, SUBGROUP_OF_IMP_NONEMPTY, SUBGROUP_OF_IMP_SUBSET,
        TRIVIAL_SUBGROUP_OF, subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  let { PROD_GROUP, .. } := BProdGroup
  let { CARTESIAN_PRODUCT_SUBGROUP_OF_PRODUCT_GROUP, PRODUCT_GROUP, .. } := BProductGroup
  let { GROUP_HOMOMORPHISM, group_epimorphism, group_homomorphism, group_monomorphism, .. } := BHomomorphisms
  let { CARD_LE_GROUP_EPIMORPHIC_IMAGE, GROUP_ISOMORPHISM,
        GROUP_MONOMORPHISM_EPIMORPHISM, SUBGROUP_OF_EPIMORPHIC_PREIMAGE,
        SUBGROUP_OF_HOMOMORPHIC_IMAGE, .. } := BHomomorphisms2
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, ISOMORPHIC_GROUP_SYM, isomorphic_group, .. } := BIso1
  let { GROUP_SETMUL_ASSOC, GROUP_SETMUL_SYM, .. } := BSetwise1
  let { GROUP_SETMUL_SUBGROUP, .. } := BSetwise2
  let { RIGHT_COSET, RIGHT_COSET_EQ, RIGHT_COSET_EQ_EMPTY, RIGHT_COSET_EQ_SUBGROUP,
        RIGHT_COSET_ID, RIGHT_COSET_NONEMPTY, left_coset, right_coset, .. } := BCosets
  let { CARD_RIGHT_COSETS_DIVIDES, GROUP_SETMUL_PRODUCT_GROUP, GROUP_SETMUL_PROD_GROUP,
        RIGHT_COSET_PROD_GROUP, .. } := BCosets2
  let { GROUP_SETINV_SUBGROUP_GENERATED, GROUP_SETMUL_SUBGROUP_GENERATED,
        LEFT_COSET_PRODUCT_GROUP, RIGHT_COSET_PRODUCT_GROUP,
        RIGHT_COSET_SUBGROUP_GENERATED, .. } := BCosetProducts
  let { ABELIAN_GROUP_NORMAL_SUBGROUP, CARRIER_NORMAL_SUBGROUP_OF,
        GROUP_SETINV_RIGHT_COSET, NORMAL_SUBGROUP_IMP_SUBGROUP,
        TRIVIAL_NORMAL_SUBGROUP_OF, normal_subgroup_of, .. } := BNormalSubgroups
  let { CROSS_NORMAL_SUBGROUP_OF_PROD_GROUP, GROUP_SETMUL_RIGHT_COSET,
        NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED, .. } := BNormalSubgroups2
  -- @@SCOPE END

  let quotient_group ← new_definition
   r"quotient_group G (n:A->bool) =
          group ({right_coset G n x |x| x IN group_carrier G},
                 n,group_setinv G,group_setmul G)"

  let QUOTIENT_GROUP ← prove
   r"(!G n:A->bool.
          n normal_subgroup_of G
          ==> group_carrier(quotient_group G n) =
                {right_coset G n x |x| x IN group_carrier G}) /\
     (!G n:A->bool.
          n normal_subgroup_of G
          ==> group_id(quotient_group G n) = n) /\
     (!G n:A->bool.
          n normal_subgroup_of G
          ==> group_inv(quotient_group G n) = group_setinv G) /\
     (!G n:A->bool.
          n normal_subgroup_of G
          ==> group_mul(quotient_group G n) = group_setmul G)"
   (← do
    let a1 ← TAUT
     (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")
    pure (REWRITE_TAC [AND_FORALL_THM, a1] THEN
     REPEAT GEN_TAC THEN DISCH_TAC THEN
     MP_TAC (← EQ_IMP_RULE
      (← ISPEC (← liftExcept (do rand (← rand (strip_forall (concl quotient_group)).2)))
        (← CONJUNCT2 group_tybij))).1 THEN
     REWRITE_TAC [← GSYM quotient_group] THEN ANTS_TAC THENL
      [ALL_TAC, SIMP_TAC [group_carrier, group_id, group_inv, group_mul]] THEN
     REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_GSPEC] THEN
     ASM_SIMP_TAC [GROUP_SETMUL_RIGHT_COSET, GROUP_SETINV_RIGHT_COSET,
                  GROUP_MUL, GROUP_INV] THEN
     FIRST_ASSUM (STRIP_ASSUME_TAC o REWRITE_RULE [normal_subgroup_of]) THEN
     FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
     REWRITE_TAC [IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
      [ASM_MESON_TAC [RIGHT_COSET_ID, GROUP_ID],
       ASM_MESON_TAC [GROUP_INV],
       ASM_MESON_TAC [GROUP_MUL],
       ASM_SIMP_TAC [GROUP_MUL_ASSOC],
       X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN CONJ_TAC THENL
        [ASM_SIMP_TAC [right_coset, GROUP_SETMUL_ASSOC, SING_SUBSET],
         FIRST_X_ASSUM (MP_TAC o SPEC (← q "x:A")) THEN
         ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
         ASM_SIMP_TAC [left_coset, ← GSYM GROUP_SETMUL_ASSOC, SING_SUBSET]] THEN
       ASM_SIMP_TAC [GROUP_SETMUL_SUBGROUP],
       ASM_SIMP_TAC [GROUP_MUL_LINV, GROUP_MUL_RINV, RIGHT_COSET_ID]]))

  let ABELIAN_QUOTIENT_GROUP ← prove
   r"!G n:A->bool.
       abelian_group G /\ n subgroup_of G ==> abelian_group(quotient_group G n)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [abelian_group, QUOTIENT_GROUP, ABELIAN_GROUP_NORMAL_SUBGROUP,
                 IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [GROUP_SETMUL_SYM, RIGHT_COSET, SUBGROUP_OF_IMP_SUBSET])

  let FINITE_QUOTIENT_GROUP ← prove
   r"!G n:A->bool.
          FINITE(group_carrier G) /\ n normal_subgroup_of G
          ==> FINITE(group_carrier(quotient_group G n))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [QUOTIENT_GROUP] THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE])

  let TRIVIAL_QUOTIENT_GROUP ← prove
   r"!G n:A->bool.
          trivial_group G /\  n normal_subgroup_of G
          ==> trivial_group(quotient_group G n)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [trivial_group] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [TRIVIAL_GROUP, QUOTIENT_GROUP] THEN
    SET_TAC [])

  let QUOTIENT_GROUP_ID ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> group_id(quotient_group G n) = n"
   (REWRITE_TAC [QUOTIENT_GROUP])

  let QUOTIENT_GROUP_INV ← prove
   r"!G n a:A.
          n normal_subgroup_of G /\ a IN group_carrier G
          ==> group_inv (quotient_group G n) (right_coset G n a) =
              right_coset G n (group_inv G a)"
   (SIMP_TAC [QUOTIENT_GROUP, GROUP_SETINV_RIGHT_COSET])

  let QUOTIENT_GROUP_MUL ← prove
   r"!G n a b:A.
          n normal_subgroup_of G /\ a IN group_carrier G /\ b IN group_carrier G
          ==> group_mul (quotient_group G n)
                        (right_coset G n a) (right_coset G n b) =
              right_coset G n (group_mul G a b)"
   (SIMP_TAC [QUOTIENT_GROUP, GROUP_SETMUL_RIGHT_COSET])

  let QUOTIENT_GROUP_DIV ← prove
   r"!G n a b:A.
          n normal_subgroup_of G /\ a IN group_carrier G /\ b IN group_carrier G
          ==> group_div (quotient_group G n)
                        (right_coset G n a) (right_coset G n b) =
              right_coset G n (group_div G a b)"
   (SIMP_TAC [group_div, QUOTIENT_GROUP_INV, QUOTIENT_GROUP_MUL, GROUP_INV])

  let QUOTIENT_GROUP_POW ← prove
   r"!G n (a:A) k.
          n normal_subgroup_of G /\ a IN group_carrier G
          ==> group_pow (quotient_group G n) (right_coset G n a) k =
              right_coset G n (group_pow G a k)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [group_pow, QUOTIENT_GROUP_MUL, GROUP_POW] THEN
    ASM_SIMP_TAC [QUOTIENT_GROUP_ID, NORMAL_SUBGROUP_IMP_SUBGROUP,
                 SUBGROUP_OF_IMP_SUBSET, RIGHT_COSET_ID])

  let QUOTIENT_GROUP_ZPOW ← prove
   r"!G n (a:A) k.
          n normal_subgroup_of G /\ a IN group_carrier G
          ==> group_zpow (quotient_group G n) (right_coset G n a) k =
              right_coset G n (group_zpow G a k)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_zpow] THEN COND_CASES_TAC THEN
    ASM_MESON_TAC [QUOTIENT_GROUP_INV, QUOTIENT_GROUP_POW, GROUP_POW])

  let GROUP_HOMOMORPHISM_RIGHT_COSET ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> group_homomorphism (G,quotient_group G n) (right_coset G n)"
   (SIMP_TAC [group_homomorphism, QUOTIENT_GROUP_INV, QUOTIENT_GROUP_MUL] THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE, QUOTIENT_GROUP] THEN
    SIMP_TAC [normal_subgroup_of, subgroup_of, RIGHT_COSET_ID] THEN SET_TAC [])

  let GROUP_EPIMORPHISM_RIGHT_COSET ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> group_epimorphism (G,quotient_group G n) (right_coset G n)"
   (SIMP_TAC [group_epimorphism, GROUP_HOMOMORPHISM_RIGHT_COSET] THEN
    SIMP_TAC [QUOTIENT_GROUP] THEN SET_TAC [])

  let CARD_LE_QUOTIENT_GROUP ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> group_carrier(quotient_group G n) <=_c group_carrier G"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP GROUP_EPIMORPHISM_RIGHT_COSET) THEN
    REWRITE_TAC [CARD_LE_GROUP_EPIMORPHIC_IMAGE])

  let CARD_QUOTIENT_GROUP_DIVIDES ← prove
   r"!G n:A->bool.
          FINITE(group_carrier G) /\ n normal_subgroup_of G
          ==> CARD(group_carrier(quotient_group G n)) divides
              CARD(group_carrier G)"
   (SIMP_TAC [QUOTIENT_GROUP, CARD_RIGHT_COSETS_DIVIDES,
             NORMAL_SUBGROUP_IMP_SUBGROUP])

  let TRIVIAL_QUOTIENT_GROUP_EQ ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> (trivial_group(quotient_group G n) <=> n = group_carrier G)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [TRIVIAL_GROUP_SUBSET, QUOTIENT_GROUP] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_SING] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP NORMAL_SUBGROUP_IMP_SUBGROUP) THEN
    SIMP_TAC [RIGHT_COSET_EQ_SUBGROUP] THEN
    REWRITE_TAC [subgroup_of] THEN SET_TAC [])

  let TRIVIAL_QUOTIENT_GROUP_SELF ← prove
   r"!G:A group. trivial_group(quotient_group G (group_carrier G))"
   (SIMP_TAC [TRIVIAL_QUOTIENT_GROUP_EQ, CARRIER_NORMAL_SUBGROUP_OF])

  let QUOTIENT_GROUP_TRIVIAL ← prove
   r"!G:A group. quotient_group G {group_id G} isomorphic_group G"
   (GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    REWRITE_TAC [isomorphic_group] THEN
    EXISTS_TAC (← q r"right_coset G {group_id G:A}") THEN
    SIMP_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM, group_monomorphism,
             GROUP_EPIMORPHISM_RIGHT_COSET, GROUP_HOMOMORPHISM_RIGHT_COSET,
             TRIVIAL_SUBGROUP_OF, TRIVIAL_NORMAL_SUBGROUP_OF,
             RIGHT_COSET_EQ, IMP_CONJ, IN_SING, GROUP_DIV_EQ_ID])

  let GROUP_ISOMORPHISM_PROD_QUOTIENT_GROUP ← prove
   r"!(G1:A group) (G2:B group) n1 n2.
          n1 normal_subgroup_of G1 /\ n2 normal_subgroup_of G2
          ==> group_isomorphism(prod_group (quotient_group G1 n1)
                                           (quotient_group G2 n2),
                                quotient_group (prod_group G1 G2) (n1 CROSS n2))
                               (\(s,t). s CROSS t)"
   (← do
    let a1 ← SET_RULE
     (← q r"(IMAGE f s SUBSET t /\ P) /\ IMAGE f s = t /\ Q <=>
      IMAGE f s SUBSET t /\ t SUBSET IMAGE f s /\ P /\ Q")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [GROUP_ISOMORPHISM] THEN
     REWRITE_TAC [GROUP_HOMOMORPHISM, a1] THEN
     REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
     REWRITE_TAC [PROD_GROUP, FORALL_PAIR_THM, IN_CROSS] THEN
     REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
     REWRITE_TAC [← ONCE_REWRITE_RULE [CONJ_SYM] IN_IMAGE] THEN
     ASM_SIMP_TAC [← CONJUNCT1 QUOTIENT_GROUP,
                  CROSS_NORMAL_SUBGROUP_OF_PROD_GROUP] THEN
     REWRITE_TAC [EXISTS_PAIR_THM, IN_CROSS] THEN
     REWRITE_TAC [RIGHT_EXISTS_AND_THM, ← GSYM CONJ_ASSOC] THEN
     REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN
     REWRITE_TAC [RIGHT_COSET_PROD_GROUP, PROD_GROUP, IN_CROSS] THEN
     REWRITE_TAC [IN_ELIM_THM] THEN
     REPLICATE_TAC 2 (CONJ_TAC THENL [MESON_TAC [], ALL_TAC]) THEN
     ASM_SIMP_TAC [CROSS_EQ, PAIR_EQ, RIGHT_COSET_NONEMPTY,
                  NORMAL_SUBGROUP_IMP_SUBGROUP] THEN
     ASM_SIMP_TAC [QUOTIENT_GROUP, CROSS_NORMAL_SUBGROUP_OF_PROD_GROUP] THEN
     REWRITE_TAC [GROUP_SETMUL_PROD_GROUP]))

  let ISOMORPHIC_QUOTIENT_PROD_GROUP ← prove
   r"!(G1:A group) (G2:B group) n1 n2.
          n1 normal_subgroup_of G1 /\ n2 normal_subgroup_of G2
          ==> quotient_group (prod_group G1 G2) (n1 CROSS n2) isomorphic_group
              prod_group (quotient_group G1 n1) (quotient_group G2 n2)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP GROUP_ISOMORPHISM_PROD_QUOTIENT_GROUP) THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC])

  let CARTESIAN_PRODUCT_NORMAL_SUBGROUP_OF_PRODUCT_GROUP ← prove
   r"!(G:K->A group) h k.
          (cartesian_product k h) normal_subgroup_of (product_group k G) <=>
          !i. i IN k ==> (h i) normal_subgroup_of (G i)"
   (← do
    let a1 ← MESON [] (← q r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [normal_subgroup_of] THEN
     REWRITE_TAC [CARTESIAN_PRODUCT_SUBGROUP_OF_PRODUCT_GROUP] THEN
     REWRITE_TAC [RIGHT_COSET_PRODUCT_GROUP, LEFT_COSET_PRODUCT_GROUP] THEN
     REWRITE_TAC [CARTESIAN_PRODUCT_EQ, CARTESIAN_PRODUCT_EQ_EMPTY] THEN
     REWRITE_TAC [a1] THEN
     ASM_CASES_TAC (← q r"!i. i IN k ==> (h:K->A->bool) i subgroup_of G i") THENL
      [ASM_SIMP_TAC [RIGHT_COSET_NONEMPTY], ASM_MESON_TAC []] THEN
     REWRITE_TAC [RIGHT_IMP_FORALL_THM, PRODUCT_GROUP, IMP_IMP] THEN
     REWRITE_TAC [FORALL_CARTESIAN_PRODUCT_ELEMENTS] THEN
     REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, GROUP_CARRIER_NONEMPTY]))

  let GROUP_ISOMORPHISM_PRODUCT_QUOTIENT_GROUP ← prove
   r"!(G:K->A group) n k.
          (!i. i IN k ==> (n i) normal_subgroup_of (G i))
          ==> group_isomorphism
                (product_group k (\i. quotient_group (G i) (n i)),
                 quotient_group (product_group k G) (cartesian_product k n))
                (cartesian_product k)"
   (← do
    let a1 ← SET_RULE
     (← q r"(IMAGE f s SUBSET t /\ P) /\ IMAGE f s = t /\ Q <=>
      IMAGE f s SUBSET t /\ t SUBSET IMAGE f s /\ P /\ Q")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [GROUP_ISOMORPHISM] THEN
     REWRITE_TAC [GROUP_HOMOMORPHISM, a1] THEN
     REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
     ASM_SIMP_TAC [PRODUCT_GROUP, QUOTIENT_GROUP, RIGHT_COSET_PRODUCT_GROUP,
                  CARTESIAN_PRODUCT_NORMAL_SUBGROUP_OF_PRODUCT_GROUP,
                  GROUP_SETMUL_PRODUCT_GROUP, FORALL_IN_GSPEC] THEN
     REWRITE_TAC [CARTESIAN_PRODUCT_EQ, CARTESIAN_PRODUCT_EQ_EMPTY] THEN
     REPEAT CONJ_TAC THENL
      [X_GEN_TAC (← q "x:K->A->bool") THEN
       REWRITE_TAC [IN_ELIM_THM, CARTESIAN_PRODUCT_EQ] THEN
       REWRITE_TAC [IN_ELIM_THM, cartesian_product] THEN
       ASM_SIMP_TAC [QUOTIENT_GROUP, IN_ELIM_THM] THEN
       GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
       REWRITE_TAC [SKOLEM_THM, RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
       X_GEN_TAC (← q "y:K->A") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
       EXISTS_TAC (← q r"RESTRICTION k (y:K->A)") THEN
       REWRITE_TAC [← REWRITE_RULE [IN] RESTRICTION_IN_EXTENSIONAL] THEN
       SIMP_TAC [RESTRICTION] THEN ASM_MESON_TAC [],
       X_GEN_TAC (← q "x:K->A") THEN
       REWRITE_TAC [IN_ELIM_THM, IN_IMAGE, CARTESIAN_PRODUCT_EQ] THEN
       REWRITE_TAC [IN_ELIM_THM, cartesian_product] THEN STRIP_TAC THEN EXISTS_TAC
        (← q r"RESTRICTION k (\i. right_coset (G i) (n i) (x i)):K->A->bool") THEN
       REWRITE_TAC [← REWRITE_RULE [IN] RESTRICTION_IN_EXTENSIONAL] THEN
       ASM_SIMP_TAC [RESTRICTION, QUOTIENT_GROUP] THEN ASM SET_TAC [],
       ASM_SIMP_TAC [IN_ELIM_THM, cartesian_product, RESTRICTION, QUOTIENT_GROUP],
       REPEAT GEN_TAC THEN
       GEN_REWRITE_TAC RAND_CONV [FUN_EQ_THM] THEN
       ASM_SIMP_TAC [IN_ELIM_THM, cartesian_product, EXTENSIONAL,
                    QUOTIENT_GROUP] THEN
       ASM_MESON_TAC [RIGHT_COSET_EQ_EMPTY, SUBGROUP_OF_IMP_NONEMPTY,
                     normal_subgroup_of]]))

  let ISOMORPHIC_QUOTIENT_PRODUCT_GROUP ← prove
   r"!(G:K->A group) n k.
          (!i. i IN k ==> (n i) normal_subgroup_of (G i))
          ==> (quotient_group (product_group k G) (cartesian_product k n))
              isomorphic_group
              (product_group k (\i. quotient_group (G i) (n i)))"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP GROUP_ISOMORPHISM_PRODUCT_QUOTIENT_GROUP) THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC])

  let (SUBGROUP_OF_QUOTIENT_GROUP, SUBGROUP_OF_QUOTIENT_GROUP_ALT) ←
   CONJ_PAIR (← prove
   r"(!G n h:(A->bool)->bool.
          n normal_subgroup_of G
          ==> (h subgroup_of quotient_group G n <=>
               ?k. k subgroup_of G /\ { right_coset G n x | x IN k} = h)) /\
     (!G n h:(A->bool)->bool.
          n normal_subgroup_of G
          ==> (h subgroup_of quotient_group G n <=>
               ?k. k subgroup_of G /\
                   n SUBSET k /\
                   { right_coset G n x | x IN k} = h))"
   (← do
    let a4 ← SET_RULE
     (← q r"n SUBSET {x | x IN s /\ f x = z}
          ==> z IN h ==> n SUBSET {x | x IN s /\ f x IN h}")
    let a3 ← TAUT
     (← q r"q /\ p /\ r ==> p /\ q /\ r")
    let a2 ← TAUT
     (← q r"(r ==> q) /\ (p ==> r) /\ (q ==> p)
      ==> (p <=> q) /\ (p <=> r)")
    let a1 ← TAUT
     (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")
    pure (REWRITE_TAC [AND_FORALL_THM, a1] THEN
     REPEAT GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC a2 THEN
     REPEAT CONJ_TAC THENL
      [MESON_TAC [],
       DISCH_TAC THEN
       EXISTS_TAC (← q r"{x:A | x IN group_carrier G /\ right_coset G n x IN h}") THEN
       MATCH_MP_TAC a3 THEN CONJ_TAC THENL
        [FIRST_ASSUM (MP_TAC o MATCH_MP IN_SUBGROUP_ID) THEN
         MATCH_MP_TAC a4 THEN
         ASM_SIMP_TAC [QUOTIENT_GROUP, SUBSET, IN_ELIM_THM] THEN
         ASM_MESON_TAC [RIGHT_COSET_EQ_SUBGROUP, normal_subgroup_of,
                       subgroup_of, SUBSET],
         REWRITE_TAC [SIMPLE_IMAGE] THEN
         MATCH_MP_TAC SUBGROUP_OF_EPIMORPHIC_PREIMAGE THEN
         EXISTS_TAC (← q r"quotient_group (G:A group) n") THEN
         ASM_SIMP_TAC [GROUP_EPIMORPHISM_RIGHT_COSET, ETA_AX]],
       DISCH_THEN (X_CHOOSE_THEN (← q "k:A->bool")
        (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM))) THEN
       REWRITE_TAC [SIMPLE_IMAGE] THEN
       MATCH_MP_TAC SUBGROUP_OF_HOMOMORPHIC_IMAGE THEN
       EXISTS_TAC (← q r"G:A group") THEN
       ASM_SIMP_TAC [GROUP_HOMOMORPHISM_RIGHT_COSET, ETA_AX]])))

  let SUBGROUP_OF_QUOTIENT_GROUP_GENERATED_BY ← prove
   r"!G n h:(A->bool)->bool.
          n normal_subgroup_of G /\ h subgroup_of quotient_group G n
          ==> ?k. k subgroup_of G /\ n SUBSET k /\
                  quotient_group (subgroup_generated G k) n =
                  subgroup_generated (quotient_group G n) h"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o SPEC
     (← q r"h:(A->bool)->bool") o  MATCH_MP SUBGROUP_OF_QUOTIENT_GROUP_ALT) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q "k:A->bool") THEN STRIP_TAC THEN REWRITE_TAC [] THEN
    ASM_REWRITE_TAC [GROUPS_EQ] THEN
    ASM_SIMP_TAC [QUOTIENT_GROUP, ← CONJUNCT2 SUBGROUP_GENERATED,
                 NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED,
                 CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    ASM_REWRITE_TAC [GROUP_SETINV_SUBGROUP_GENERATED,
                    GROUP_SETMUL_SUBGROUP_GENERATED,
                    RIGHT_COSET_SUBGROUP_GENERATED])

  let QUOTIENT_GROUP_SUBGROUP_GENERATED ← prove
   r"!G h n:A->bool.
          n normal_subgroup_of G /\ h subgroup_of G /\ n SUBSET h
          ==> quotient_group (subgroup_generated G h) n =
              subgroup_generated (quotient_group G n)
                                 {right_coset G n x | x IN h}"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [GROUPS_EQ, QUOTIENT_GROUP, ← CONJUNCT2 SUBGROUP_GENERATED,
                 NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [GROUP_SETINV_SUBGROUP_GENERATED, GROUP_SETMUL_SUBGROUP_GENERATED,
                RIGHT_COSET_SUBGROUP_GENERATED] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_RIGHT_COSET) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          SUBGROUP_OF_HOMOMORPHIC_IMAGE)) THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, SIMPLE_IMAGE, ETA_AX])

  -- @@RETURN BEGIN
  return { quotient_group, QUOTIENT_GROUP, ABELIAN_QUOTIENT_GROUP, FINITE_QUOTIENT_GROUP,
           TRIVIAL_QUOTIENT_GROUP, QUOTIENT_GROUP_ID, QUOTIENT_GROUP_INV,
           QUOTIENT_GROUP_MUL, QUOTIENT_GROUP_DIV, QUOTIENT_GROUP_POW,
           QUOTIENT_GROUP_ZPOW, GROUP_HOMOMORPHISM_RIGHT_COSET,
           GROUP_EPIMORPHISM_RIGHT_COSET, CARD_LE_QUOTIENT_GROUP,
           CARD_QUOTIENT_GROUP_DIVIDES, TRIVIAL_QUOTIENT_GROUP_EQ,
           TRIVIAL_QUOTIENT_GROUP_SELF, QUOTIENT_GROUP_TRIVIAL,
           GROUP_ISOMORPHISM_PROD_QUOTIENT_GROUP, ISOMORPHIC_QUOTIENT_PROD_GROUP,
           CARTESIAN_PRODUCT_NORMAL_SUBGROUP_OF_PRODUCT_GROUP,
           GROUP_ISOMORPHISM_PRODUCT_QUOTIENT_GROUP, ISOMORPHIC_QUOTIENT_PRODUCT_GROUP,
           SUBGROUP_OF_QUOTIENT_GROUP, SUBGROUP_OF_QUOTIENT_GROUP_ALT,
           SUBGROUP_OF_QUOTIENT_GROUP_GENERATED_BY, QUOTIENT_GROUP_SUBGROUP_GENERATED }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Kernels and images of homomorphisms.                                      -/
/- ------------------------------------------------------------------------- -/

structure KernelsImages1 where
  -- @@FIELDS
  group_kernel : thm
  group_image : thm
  GROUP_KERNEL_ID : thm
  GROUP_KERNEL_NONEMPTY : thm
  GROUP_KERNEL_SUBSET_CARRIER : thm
  GROUP_MONOMORPHISM : thm
  GROUP_MONOMORPHISM_ALT : thm
  GROUP_MONOMORPHISM_ALT_EQ : thm
  GROUP_EPIMORPHISM : thm
  GROUP_EPIMORPHISM_ALT : thm
  GROUP_ISOMORPHISM_EPIMORPHISM_ALT : thm
  GROUP_ISOMORPHISM_GROUP_KERNEL_GROUP_IMAGE : thm
  GROUP_ISOMORPHISM_ALT : thm
  SUBGROUP_GROUP_KERNEL : thm
  SUBGROUP_GROUP_IMAGE : thm
  GROUP_KERNEL_TO_SUBGROUP_GENERATED : thm
  GROUP_IMAGE_TO_SUBGROUP_GENERATED : thm
  GROUP_KERNEL_FROM_SUBGROUP_GENERATED : thm
  GROUP_IMAGE_FROM_SUBGROUP_GENERATED : thm
  GROUP_ISOMORPHISM_ONTO_IMAGE : thm
  NORMAL_SUBGROUP_GROUP_KERNEL : thm
  GROUP_KERNEL_RIGHT_COSET : thm
  CARD_EQ_GROUP_IMAGE_KERNEL : thm
  CARD_DIVIDES_GROUP_MONOMORPHIC_IMAGE : thm
  CARD_DIVIDES_GROUP_EPIMORPHIC_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupKernelsImages1 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms3 : Homomorphisms3) (BSetwise1 : Setwise1) (BCosets : Cosets) (BCosets2 : Cosets2) (BNormalSubgroups : NormalSubgroups) (BQuotientGroups : QuotientGroups) :
    ExceptT String IO KernelsImages1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, NUMBER_RULE, SET_RULE, SET_TAC, TAUT, new_definition, .. } := D
  let { CARD_CROSS, CARD_EQ_CARD_IMP, CARD_EQ_IMAGE, CARD_EQ_IMAGE_MUL_FIBRES,
        CARD_EQ_REFL_IMP, CARD_EQ_TRANS, .. } := D.core1
  let { CROSS, .. } := D.core2
  let { FINITE_CROSS, FINITE_IMAGE, FINITE_RESTRICT, FORALL_IN_IMAGE,
        FORALL_IN_IMAGE_2, .. } := D.core3
  let { IMAGE_o, IMP_CONJ_ALT, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, IN_SING, .. } := D.core5
  let { NOT_IN_EMPTY, .. } := D.core6
  let { SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL,
        SUBSET_RESTRICT, mul_c, .. } := D.core7
  let { o_DEF, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, .. } := BBasics
  let { GROUP_DIV_EQ_ID, GROUP_INV_ID, GROUP_MUL_LCANCEL_IMP, group_div, .. } := BDerived
  let { SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  let { GROUP_HOMOMORPHISM, group_epimorphism, group_homomorphism, group_monomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN, .. } := BHomomorphisms1
  let { GROUP_ISOMORPHISM, GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { CARD_EQ_GROUP_MONOMORPHIC_IMAGE, FINITE_GROUP_MONOMORPHIC_PREIMAGE, .. } := BHomomorphisms3
  let { group_setmul, .. } := BSetwise1
  let { RIGHT_COSET_EQ_SUBGROUP, .. } := BCosets
  let { LAGRANGE_THEOREM, .. } := BCosets2
  let { NORMAL_SUBGROUP_CONJUGATE_INV, normal_subgroup_of, .. } := BNormalSubgroups
  let { QUOTIENT_GROUP_ID, .. } := BQuotientGroups
  -- @@SCOPE END

  let group_kernel ← new_definition
   r"group_kernel (G,G') (f:A->B) =
      {x | x IN group_carrier G /\ f x = group_id G'}"

  let group_image ← new_definition
   r"group_image (G:A group,G':B group) (f:A->B) = IMAGE f (group_carrier G)"

  let GROUP_KERNEL_ID ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f
          ==> group_id G IN group_kernel (G,G') f"
   (SIMP_TAC [group_homomorphism, group_kernel, IN_ELIM_THM, GROUP_ID])

  let GROUP_KERNEL_NONEMPTY ← prove
   r"!G H (f:A->B).
          group_homomorphism(G,H) f ==> ~(group_kernel(G,H) f = {})"
   (MESON_TAC [GROUP_KERNEL_ID, NOT_IN_EMPTY])

  let GROUP_KERNEL_SUBSET_CARRIER ← prove
   r"!G H (f:A->B). group_kernel(G,H) f SUBSET group_carrier G"
   (REWRITE_TAC [group_kernel, SUBSET_RESTRICT])

  let GROUP_MONOMORPHISM ← prove
   r"!G G' (f:A->B).
          group_monomorphism(G,G') f <=>
          group_homomorphism(G,G') f /\
          group_kernel (G,G') f = {group_id G}"
   (← do
    let a1 ← TAUT (← q r"(p /\ q <=> p /\ r) <=> p ==> (q <=> r)")
    pure (
    REPEAT GEN_TAC THEN REWRITE_TAC [group_monomorphism] THEN
    REWRITE_TAC [a1] THEN
    REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SING_SUBSET] THEN
    ASM_REWRITE_TAC [SUBSET, IN_SING, group_kernel, IN_ELIM_THM, GROUP_ID] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q "x:A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q "x:A", ← q "group_id G:A"]) THEN
      ASM_SIMP_TAC [GROUP_ID],
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q "group_div G x y:A")) THEN
      ASM_SIMP_TAC [group_div, GROUP_MUL, GROUP_INV] THEN
      REWRITE_TAC [← GSYM group_div] THEN
      wPart (fun t => do rand (← lhand t)) (fun t => do lhand (← rand t))
        GROUP_DIV_EQ_ID THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      DISCH_THEN MATCH_MP_TAC THEN
      wPart pure (fun t => do lhand (← rand t)) GROUP_DIV_EQ_ID THEN
      ASM_SIMP_TAC []]))

  let GROUP_MONOMORPHISM_ALT ← prove
   r"!G G' (f:A->B).
          group_monomorphism(G,G') f <=>
          group_homomorphism(G,G') f /\
          !x. x IN group_carrier G /\ f x = group_id G' ==> x = group_id G"
   (REPEAT GEN_TAC THEN REWRITE_TAC [GROUP_MONOMORPHISM, group_kernel] THEN
    MP_TAC (← ISPEC (← q "G:A group") GROUP_ID) THEN
    REWRITE_TAC [group_homomorphism] THEN SET_TAC [])

  let GROUP_MONOMORPHISM_ALT_EQ ← prove
   r"!G G' f:A->B.
          group_monomorphism (G,G') f <=>
          group_homomorphism (G,G') f /\
          !x. x IN group_carrier G ==> (f x = group_id G' <=> x = group_id G)"
   (MESON_TAC [GROUP_MONOMORPHISM_ALT, group_homomorphism])

  let GROUP_EPIMORPHISM ← prove
   r"!G G' (f:A->B).
          group_epimorphism(G,G') f <=>
          group_homomorphism(G,G') f /\
          group_image (G,G') f = group_carrier G'"
   (REWRITE_TAC [group_epimorphism, group_image] THEN MESON_TAC [])

  let GROUP_EPIMORPHISM_ALT ← prove
   r"!G G' (f:A->B).
          group_epimorphism(G,G') f <=>
          group_homomorphism(G,G') f /\
          group_carrier G' SUBSET group_image (G,G') f"
   (REWRITE_TAC [GROUP_EPIMORPHISM, group_homomorphism, group_image] THEN
    MESON_TAC [SUBSET_ANTISYM_EQ])

  let GROUP_ISOMORPHISM_EPIMORPHISM_ALT ← prove
   r"!G G' (f:A->B).
          group_isomorphism (G,G') f <=>
          group_epimorphism (G,G') f /\
          (!x. x IN group_carrier G /\ f x = group_id G' ==> x = group_id G)"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM,
                GROUP_MONOMORPHISM_ALT, group_epimorphism] THEN
    MESON_TAC [])

  let GROUP_ISOMORPHISM_GROUP_KERNEL_GROUP_IMAGE ← prove
   r"!G G' (f:A->B).
          group_isomorphism (G,G') f <=>
          group_homomorphism(G,G') f /\
          group_kernel (G,G') f = {group_id G} /\
          group_image (G,G') f = group_carrier G'"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    REWRITE_TAC [GROUP_MONOMORPHISM, GROUP_EPIMORPHISM] THEN MESON_TAC [])

  let GROUP_ISOMORPHISM_ALT ← prove
   r"!G G' (f:A->B).
        group_isomorphism (G,G') f <=>
        IMAGE f (group_carrier G) = group_carrier G' /\
        (!x y. x IN group_carrier G /\ y IN group_carrier G
               ==> f(group_mul G x y) = group_mul G' (f x) (f y)) /\
        (!x. x IN group_carrier G /\ f x = group_id G' ==> x = group_id G)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q "group_homomorphism (G,G') (f:A->B)") THENL
     [ALL_TAC,
      ASM_MESON_TAC [GROUP_HOMOMORPHISM, GROUP_ISOMORPHISM, SUBSET_REFL]] THEN
    ASM_REWRITE_TAC [GROUP_ISOMORPHISM_GROUP_KERNEL_GROUP_IMAGE,
                    group_kernel, group_image] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN
    MP_TAC (← ISPEC (← q "G:A group") GROUP_ID) THEN ASM SET_TAC [])

  let SUBGROUP_GROUP_KERNEL ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f ==> (group_kernel (G,G') f) subgroup_of G"
   (SIMP_TAC [group_homomorphism, subgroup_of, group_kernel, IN_ELIM_THM, SUBSET,
             FORALL_IN_IMAGE, GROUP_MUL_LID, GROUP_ID, GROUP_MUL,
             GROUP_INV_ID, GROUP_INV])

  let SUBGROUP_GROUP_IMAGE ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f ==> (group_image (G,G') f) subgroup_of G'"
   (SIMP_TAC [group_homomorphism, subgroup_of, group_image, SUBSET,
             FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, IN_IMAGE] THEN
    MESON_TAC [GROUP_MUL, GROUP_INV, GROUP_ID])

  let GROUP_KERNEL_TO_SUBGROUP_GENERATED ← prove
   r"!G H s (f:A->B).
          group_kernel (G,subgroup_generated H s) f = group_kernel(G,H) f"
   (REWRITE_TAC [group_kernel, SUBGROUP_GENERATED])

  let GROUP_IMAGE_TO_SUBGROUP_GENERATED ← prove
   r"!G H s (f:A->B).
          group_image (G,subgroup_generated H s) f = group_image(G,H) f"
   (REWRITE_TAC [group_image])

  let GROUP_KERNEL_FROM_SUBGROUP_GENERATED ← prove
   r"!G H s f:A->B.
          s subgroup_of G
          ==> group_kernel(subgroup_generated G s,H) f =
              group_kernel(G,H) f INTER s"
   (SIMP_TAC [group_kernel, CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    REWRITE_TAC [subgroup_of] THEN SET_TAC [])

  let GROUP_IMAGE_FROM_SUBGROUP_GENERATED ← prove
   r"!G H s f:A->B.
          s subgroup_of G
          ==> group_image(subgroup_generated G s,H) f =
              group_image(G,H) f INTER IMAGE f s"
   (SIMP_TAC [group_image, CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    REWRITE_TAC [subgroup_of] THEN SET_TAC [])

  let GROUP_ISOMORPHISM_ONTO_IMAGE ← prove
   r"!(f:A->B) G H.
          group_isomorphism(G,subgroup_generated H (group_image (G,H) f)) f <=>
          group_monomorphism(G,H) f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    REWRITE_TAC [group_monomorphism, group_epimorphism] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN] THEN
    ASM_CASES_TAC (← q "group_homomorphism (G,H) (f:A->B)") THEN
    ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GROUP_IMAGE] THEN
    REWRITE_TAC [group_image, SUBSET_REFL])

  let NORMAL_SUBGROUP_GROUP_KERNEL ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f
          ==> (group_kernel (G,G') f) normal_subgroup_of G"
   (← do
    let a2 ← SET_RULE (← q r"{f x y | x IN {a} /\ P y} = {f a y | P y}")
    let a1 ← SET_RULE (← q r"{f x y | P x /\ y IN {a}} = {f x a | P x}")
    pure (
    SIMP_TAC [NORMAL_SUBGROUP_CONJUGATE_INV, SUBGROUP_GROUP_KERNEL] THEN
    REWRITE_TAC [group_homomorphism, group_setmul] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o, o_DEF, a1, a2] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, group_kernel, IN_ELIM_THM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_SIMP_TAC [GROUP_INV, GROUP_MUL, GROUP_MUL_LID, GROUP_MUL_LINV]))

  let GROUP_KERNEL_RIGHT_COSET ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> group_kernel(G,quotient_group G n) (right_coset G n) = n"
   (← do
    let a1 ← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")
    pure (
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [group_kernel, QUOTIENT_GROUP_ID] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [normal_subgroup_of]) THEN
    REWRITE_TAC [a1] THEN
    ASM_SIMP_TAC [RIGHT_COSET_EQ_SUBGROUP] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN SET_TAC []))

  let CARD_EQ_GROUP_IMAGE_KERNEL ← prove
   r"!G H (f:A->B).
          group_homomorphism(G,H) f
          ==> group_image(G,H) f *_c group_kernel(G,H) f =_c group_carrier G"
   (REWRITE_TAC [group_homomorphism, group_image, SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CARD_EQ_IMAGE_MUL_FIBRES THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN TRANS_TAC CARD_EQ_TRANS
     (← q "IMAGE (group_mul G x) (group_kernel(G,H) (f:A->B))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CARD_EQ_REFL_IMP,
      MATCH_MP_TAC CARD_EQ_IMAGE THEN REWRITE_TAC [group_kernel, IN_ELIM_THM] THEN
      ASM_MESON_TAC [GROUP_MUL_LCANCEL_IMP]] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!g. IMAGE f s SUBSET t /\ IMAGE g t SUBSET s /\ (!y. y IN t ==> f(g y) = y)
          ==> t = IMAGE f s")) THEN
    EXISTS_TAC (← q "group_mul G (group_inv G x:A)") THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, group_kernel] THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV, GROUP_MUL_RID, GROUP_MUL_LID,
                 GROUP_MUL_LINV, GROUP_MUL_ASSOC, GROUP_MUL_RINV])

  let CARD_DIVIDES_GROUP_MONOMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
          group_monomorphism(G,H) f /\ FINITE(group_carrier H)
          ==> CARD(group_carrier G) divides CARD(group_carrier H)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q "CARD(group_carrier G) = CARD(group_image (G,H) (f:A->B))")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARD_EQ_CARD_IMP THEN
      REWRITE_TAC [group_image] THEN
      ASM_MESON_TAC [CARD_EQ_GROUP_MONOMORPHIC_IMAGE,
                    FINITE_GROUP_MONOMORPHIC_PREIMAGE],
      MATCH_MP_TAC LAGRANGE_THEOREM THEN
      ASM_MESON_TAC [SUBGROUP_GROUP_IMAGE, group_monomorphism]])

  let CARD_DIVIDES_GROUP_EPIMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
          group_epimorphism(G,H) f /\ FINITE(group_carrier G)
          ==> CARD(group_carrier H) divides CARD(group_carrier G)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [GROUP_EPIMORPHISM] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CARD_EQ_GROUP_IMAGE_KERNEL) THEN DISCH_THEN
     (MP_TAC o (MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_CARD_IMP))) THEN
    ASM_REWRITE_TAC [group_image, mul_c, ← GSYM CROSS, group_kernel] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [FINITE_CROSS, CARD_CROSS, FINITE_IMAGE, FINITE_RESTRICT] THEN
    CONV_TAC NUMBER_RULE)

  -- @@RETURN BEGIN
  return { group_kernel, group_image, GROUP_KERNEL_ID, GROUP_KERNEL_NONEMPTY,
           GROUP_KERNEL_SUBSET_CARRIER, GROUP_MONOMORPHISM, GROUP_MONOMORPHISM_ALT,
           GROUP_MONOMORPHISM_ALT_EQ, GROUP_EPIMORPHISM, GROUP_EPIMORPHISM_ALT,
           GROUP_ISOMORPHISM_EPIMORPHISM_ALT, GROUP_ISOMORPHISM_GROUP_KERNEL_GROUP_IMAGE,
           GROUP_ISOMORPHISM_ALT, SUBGROUP_GROUP_KERNEL, SUBGROUP_GROUP_IMAGE,
           GROUP_KERNEL_TO_SUBGROUP_GENERATED, GROUP_IMAGE_TO_SUBGROUP_GENERATED,
           GROUP_KERNEL_FROM_SUBGROUP_GENERATED, GROUP_IMAGE_FROM_SUBGROUP_GENERATED,
           GROUP_ISOMORPHISM_ONTO_IMAGE, NORMAL_SUBGROUP_GROUP_KERNEL,
           GROUP_KERNEL_RIGHT_COSET, CARD_EQ_GROUP_IMAGE_KERNEL,
           CARD_DIVIDES_GROUP_MONOMORPHIC_IMAGE, CARD_DIVIDES_GROUP_EPIMORPHIC_IMAGE }
  -- @@RETURN END

structure KernelsImages2 where
  -- @@FIELDS
  QUOTIENT_GROUP_UNIVERSAL_EXPLICIT : thm
  QUOTIENT_GROUP_UNIVERSAL : thm
  QUOTIENT_GROUP_UNIVERSAL_EPIMORPHISM : thm
  GROUP_KERNEL_FROM_TRIVIAL_GROUP : thm
  GROUP_IMAGE_FROM_TRIVIAL_GROUP : thm
  GROUP_KERNEL_TO_TRIVIAL_GROUP : thm
  GROUP_IMAGE_TO_TRIVIAL_GROUP : thm
  FIRST_GROUP_ISOMORPHISM_THEOREM : thm
  FIRST_GROUP_EPIMORPHISM_THEOREM : thm
  GROUP_HOMOMORPHISM_PREIMAGE_IMAGE_RIGHT : thm
  GROUP_HOMOMORPHISM_PREIMAGE_IMAGE_LEFT : thm
  GROUP_HOMOMORPHISM_IMAGE_PREIMAGE : thm
  GROUP_HOMOMORPHISM_PREIMAGE_IMAGE : thm
  GROUP_HOMOMORPHISM_IMAGE_PREIMAGE_EQ : thm
  GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE : thm
  deriving Inhabited

@[nospecialize]
def setupKernelsImages2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BTotalized : Totalized) (BSubgroups : Subgroups) (BSubgroupGen1 : SubgroupGen1) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BSetwise1 : Setwise1) (BSetwise2 : Setwise2) (BCosets : Cosets) (BNormalSubgroups : NormalSubgroups) (BNormalSubgroups2 : NormalSubgroups2) (BQuotientGroups : QuotientGroups) (BKernelsImages1 : KernelsImages1) :
    ExceptT String IO KernelsImages2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EQ_IMP, .. } := D.core2
  let { EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUNCTION_FACTORS_LEFT_GEN, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, .. } := D.core5
  let { MONO_EXISTS, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET,
        SUBSET_ANTISYM, SWAP_EXISTS_THM, .. } := D.core7
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, trivial_group, .. } := BBasics
  let { GROUP_DIV, GROUP_DIV_EQ_ID, group_div, .. } := BDerived
  let { GROUP_ADD, .. } := BTotalized
  let { IN_SUBGROUP_ID, SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_GROUP_CARRIER, .. } := BSubgroupGen1
  let { group_epimorphism, group_homomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_DIV, GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ,
        GROUP_HOMOMORPHISM_INV, GROUP_HOMOMORPHISM_MUL, .. } := BHomomorphisms1
  let { GROUP_EPIMORPHISM_IMP_HOMOMORPHISM, GROUP_ISOMORPHISM,
        SUBGROUP_OF_HOMOMORPHIC_IMAGE, SUBGROUP_OF_HOMOMORPHIC_PREIMAGE, .. } := BHomomorphisms2
  let { isomorphic_group, .. } := BIso1
  let { group_setmul, .. } := BSetwise1
  let { GROUP_SETMUL_RSUBSET_EQ, .. } := BSetwise2
  let { RIGHT_COSET_EQ, RIGHT_COSET_ID, .. } := BCosets
  let { GROUP_SETINV_RIGHT_COSET, NORMAL_SUBGROUP_IMP_SUBGROUP, normal_subgroup_of, .. } := BNormalSubgroups
  let { GROUP_SETMUL_RIGHT_COSET, .. } := BNormalSubgroups2
  let { QUOTIENT_GROUP, .. } := BQuotientGroups
  let { GROUP_EPIMORPHISM, GROUP_KERNEL_NONEMPTY, GROUP_KERNEL_SUBSET_CARRIER,
        NORMAL_SUBGROUP_GROUP_KERNEL, SUBGROUP_GROUP_IMAGE, SUBGROUP_GROUP_KERNEL,
        group_image, group_kernel, .. } := BKernelsImages1
  -- @@SCOPE END

  let QUOTIENT_GROUP_UNIVERSAL_EXPLICIT ← prove
   r"!G G' n (f:A->B).
          group_homomorphism (G,G') f /\ n normal_subgroup_of G /\
          (!x y. x IN group_carrier G /\ y IN group_carrier G /\
                 right_coset G n x = right_coset G n y
                 ==> f x = f y)
          ==> ?g. group_homomorphism(quotient_group G n,G') g /\
                  !x. x IN group_carrier G ==> g(right_coset G n x) = f x"
   (REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM
     (MP_TAC o GSYM o GEN_REWRITE_RULE I [FUNCTION_FACTORS_LEFT_GEN]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "g:(A->bool)->B") THEN
    DISCH_TAC THEN ASM_SIMP_TAC [QUOTIENT_GROUP] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [GROUP_SETINV_RIGHT_COSET, GROUP_SETMUL_RIGHT_COSET] THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV] THEN
    SUBGOAL_THEN (← q "n = right_coset G n (group_id G:A)") SUBST1_TAC THENL
     [ASM_MESON_TAC [RIGHT_COSET_ID, normal_subgroup_of,
                    SUBGROUP_OF_IMP_SUBSET],
      ASM_SIMP_TAC [GROUP_ID]])

  let QUOTIENT_GROUP_UNIVERSAL ← prove
   r"!G G' n (f:A->B).
          group_homomorphism (G,G') f /\
          n normal_subgroup_of G /\
          n SUBSET group_kernel (G,G') f
          ==> ?g. group_homomorphism(quotient_group G n,G') g /\
                  !x. x IN group_carrier G ==> g(right_coset G n x) = f x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC QUOTIENT_GROUP_UNIVERSAL_EXPLICIT THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "group_div G x y:A") o REWRITE_RULE [SUBSET]) THEN
    ASM_SIMP_TAC [← GSYM RIGHT_COSET_EQ, group_kernel, IN_ELIM_THM, GROUP_DIV,
                 NORMAL_SUBGROUP_IMP_SUBGROUP] THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_DIV] THEN
    MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC GROUP_DIV_EQ_ID THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [])

  let QUOTIENT_GROUP_UNIVERSAL_EPIMORPHISM ← prove
   r"!G G' n (f:A->B).
          group_epimorphism (G,G') f /\
          n normal_subgroup_of G /\
          n SUBSET group_kernel (G,G') f
          ==> ?g. group_epimorphism(quotient_group G n,G') g /\
                  !x. x IN group_carrier G ==> g(right_coset G n x) = f x"
   (REWRITE_TAC [group_epimorphism] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q "G':B group", ← q "n:A->bool", ← q "f:A->B"]
          QUOTIENT_GROUP_UNIVERSAL) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_SIMP_TAC [QUOTIENT_GROUP] THEN ASM SET_TAC [])

  let GROUP_KERNEL_FROM_TRIVIAL_GROUP ← prove
   r"!G H (f:A->B).
          group_homomorphism (G,H) f /\ trivial_group G
          ==> group_kernel (G,H) f = group_carrier G"
   (REWRITE_TAC [trivial_group, group_kernel, group_homomorphism] THEN
    SET_TAC [])

  let GROUP_IMAGE_FROM_TRIVIAL_GROUP ← prove
   r"!G H (f:A->B).
          group_homomorphism (G,H) f /\ trivial_group G
          ==> group_image (G,H) f = {group_id H}"
   (REWRITE_TAC [trivial_group, group_image, group_homomorphism] THEN
    SET_TAC [])

  let GROUP_KERNEL_TO_TRIVIAL_GROUP ← prove
   r"!G H (f:A->B).
          group_homomorphism (G,H) f /\ trivial_group H
          ==> group_kernel (G,H) f = group_carrier G"
   (REWRITE_TAC [trivial_group, group_kernel, group_homomorphism] THEN
    SET_TAC [])

  let GROUP_IMAGE_TO_TRIVIAL_GROUP ← prove
   r"!G H (f:A->B).
          group_homomorphism (G,H) f /\ trivial_group H
          ==> group_image (G,H) f = group_carrier H"
   (REWRITE_TAC [trivial_group, group_image, group_homomorphism] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [SING_SUBSET, IN_IMAGE] THEN
    ASM_MESON_TAC [GROUP_ID])

  let FIRST_GROUP_ISOMORPHISM_THEOREM ← prove
   r"!G G' (f:A->B).
          group_homomorphism(G,G') f
          ==> (quotient_group G (group_kernel (G,G') f)) isomorphic_group
              (subgroup_generated G' (group_image (G,G') f))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [isomorphic_group, GROUP_ISOMORPHISM] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q "group_kernel (G,G') (f:A->B)") o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
       QUOTIENT_GROUP_UNIVERSAL_EXPLICIT)) THEN
    ASM_SIMP_TAC [NORMAL_SUBGROUP_GROUP_KERNEL] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [IMP_CONJ, RIGHT_COSET_EQ, SUBGROUP_GROUP_KERNEL],
      MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q "g:(A->bool)->B") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ, SUBGROUP_GROUP_IMAGE,
               QUOTIENT_GROUP, NORMAL_SUBGROUP_GROUP_KERNEL,
               CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GROUP_KERNEL] THEN
      REWRITE_TAC [group_image] THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      SIMP_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
      ASM_SIMP_TAC [RIGHT_COSET_EQ, SUBGROUP_GROUP_KERNEL]] THEN
    SIMP_TAC [group_kernel, IN_ELIM_THM, GROUP_DIV] THEN RULE_ASSUM_TAC
     (REWRITE_RULE [group_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_SIMP_TAC [group_div, GROUP_INV] THEN
    ASM_SIMP_TAC [← GSYM group_div, GROUP_DIV_EQ_ID])

  let FIRST_GROUP_EPIMORPHISM_THEOREM ← prove
   r"!G G' (f:A->B).
          group_epimorphism(G,G') f
          ==> (quotient_group G (group_kernel (G,G') f)) isomorphic_group G'"
   (REWRITE_TAC [group_epimorphism] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FIRST_GROUP_ISOMORPHISM_THEOREM) THEN
    ASM_REWRITE_TAC [group_image, SUBGROUP_GENERATED_GROUP_CARRIER])

  let GROUP_HOMOMORPHISM_PREIMAGE_IMAGE_RIGHT ← prove
   r"!G H (f:A->B) s.
          group_homomorphism(G,H) f /\ s SUBSET group_carrier G
          ==> {x | x IN group_carrier G /\ f x IN IMAGE f s} =
              group_setmul G s (group_kernel(G,H) f)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, group_kernel, IN_ELIM_THM, group_setmul] THEN
    X_GEN_TAC (← q "z:A") THEN EQ_TAC THENL
     [STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_IMAGE]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "x:A") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q "(x:A) IN group_carrier G") ASSUME_TAC THENL
       [ASM SET_TAC [], ASM_REWRITE_TAC []] THEN
      EXISTS_TAC (← q "group_mul G (group_inv G x) z:A") THEN
      ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_MUL_RINV, GROUP_MUL_LID,
                   GROUP_INV, GROUP_MUL] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_MUL) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_INV) THEN
      ASM_SIMP_TAC [GROUP_INV] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC GROUP_MUL_LINV THEN
      RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [],
      REWRITE_TAC [IN_IMAGE, RIGHT_AND_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "x:A") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "y:A") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q "(x:A) IN group_carrier G") ASSUME_TAC THENL
       [ASM SET_TAC [], ASM_SIMP_TAC [GROUP_ADD]] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_MUL) THEN
      ASM_SIMP_TAC [GROUP_MUL] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC GROUP_MUL_RID THEN
      RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC []])

  let GROUP_HOMOMORPHISM_PREIMAGE_IMAGE_LEFT ← prove
   r"!G H (f:A->B) s.
          group_homomorphism(G,H) f /\ s SUBSET group_carrier G
          ==> {x | x IN group_carrier G /\ f x IN IMAGE f s} =
              group_setmul G (group_kernel(G,H) f) s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, group_kernel, IN_ELIM_THM, group_setmul] THEN
    X_GEN_TAC (← q "z:A") THEN EQ_TAC THENL
     [STRIP_TAC THEN GEN_REWRITE_TAC I [SWAP_EXISTS_THM] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_IMAGE]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN  X_GEN_TAC (← q "x:A") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q "(x:A) IN group_carrier G") ASSUME_TAC THENL
       [ASM SET_TAC [], ASM_REWRITE_TAC []] THEN
      EXISTS_TAC (← q "group_mul G z (group_inv G x):A") THEN
      ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL_LINV, GROUP_MUL_RID,
                   GROUP_INV, GROUP_MUL] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_MUL) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_INV) THEN
      ASM_SIMP_TAC [GROUP_INV] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC GROUP_MUL_RINV THEN
      RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [],
      REWRITE_TAC [IN_IMAGE, RIGHT_AND_EXISTS_THM] THEN
      GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "x:A") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "y:A") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q "(x:A) IN group_carrier G") ASSUME_TAC THENL
       [ASM SET_TAC [], ASM_SIMP_TAC [GROUP_ADD]] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_MUL) THEN
      ASM_SIMP_TAC [GROUP_MUL] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC GROUP_MUL_LID THEN
      RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC []])

  let GROUP_HOMOMORPHISM_IMAGE_PREIMAGE ← prove
   r"!G H (f:A->B) t.
          group_homomorphism(G,H) f
          ==> IMAGE f {x | x IN group_carrier G /\ f x IN t} =
              t INTER (group_image(G,H) f)"
   (REWRITE_TAC [group_homomorphism, group_image] THEN SET_TAC [])

  let GROUP_HOMOMORPHISM_PREIMAGE_IMAGE ← prove
   r"!G H (f:A->B) s.
          group_homomorphism(G,H) f /\
          group_kernel(G,H) f SUBSET s /\
          s subgroup_of G
          ==> {x | x IN group_carrier G /\ f x IN IMAGE f s} = s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    wPart (fun t => do lhand t) (fun t => do lhand (← rand t))
      GROUP_HOMOMORPHISM_PREIMAGE_IMAGE_RIGHT THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [subgroup_of], DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [GROUP_SETMUL_RSUBSET_EQ, GROUP_KERNEL_NONEMPTY,
                 GROUP_KERNEL_SUBSET_CARRIER])

  let GROUP_HOMOMORPHISM_IMAGE_PREIMAGE_EQ ← prove
   r"!G H (f:A->B) t.
          group_homomorphism(G,H) f /\ t SUBSET group_image(G,H) f
          ==> IMAGE f {x | x IN group_carrier G /\ f x IN t} = t"
   (SIMP_TAC [GROUP_HOMOMORPHISM_IMAGE_PREIMAGE] THEN SET_TAC [])

  let GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE ← prove
   r"!G H (f:A->B) k.
          group_epimorphism(G,H) f
          ==> (k subgroup_of H <=>
               ?j. j subgroup_of G /\
                   group_kernel(G,H) f SUBSET j /\
                   {x | x IN group_carrier G /\ f x IN k} = j /\
                   IMAGE f j = k)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GROUP_EPIMORPHISM_IMP_HOMOMORPHISM) THEN
    EQ_TAC THEN DISCH_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [SUBGROUP_OF_HOMOMORPHIC_IMAGE]] THEN
    EXISTS_TAC (← q r"{x | x IN group_carrier G /\ (f:A->B) x IN k}") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC SUBGROUP_OF_HOMOMORPHIC_PREIMAGE THEN ASM_MESON_TAC [],
      ASM_SIMP_TAC [group_kernel, SUBSET, IN_ELIM_THM, IN_SUBGROUP_ID],
      RULE_ASSUM_TAC (REWRITE_RULE
       [GROUP_EPIMORPHISM, group_image, subgroup_of]) THEN ASM SET_TAC []])

  -- @@RETURN BEGIN
  return { QUOTIENT_GROUP_UNIVERSAL_EXPLICIT, QUOTIENT_GROUP_UNIVERSAL,
           QUOTIENT_GROUP_UNIVERSAL_EPIMORPHISM, GROUP_KERNEL_FROM_TRIVIAL_GROUP,
           GROUP_IMAGE_FROM_TRIVIAL_GROUP, GROUP_KERNEL_TO_TRIVIAL_GROUP,
           GROUP_IMAGE_TO_TRIVIAL_GROUP, FIRST_GROUP_ISOMORPHISM_THEOREM,
           FIRST_GROUP_EPIMORPHISM_THEOREM, GROUP_HOMOMORPHISM_PREIMAGE_IMAGE_RIGHT,
           GROUP_HOMOMORPHISM_PREIMAGE_IMAGE_LEFT, GROUP_HOMOMORPHISM_IMAGE_PREIMAGE,
           GROUP_HOMOMORPHISM_PREIMAGE_IMAGE, GROUP_HOMOMORPHISM_IMAGE_PREIMAGE_EQ,
           GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE }
  -- @@RETURN END

structure SubgroupCorrespondence where
  -- @@FIELDS
  GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE_ALT : thm
  NORMAL_SUBGROUP_OF_HOMOMORPHIC_PREIMAGE : thm
  NORMAL_SUBGROUP_OF_EPIMORPHIC_IMAGE : thm
  NORMAL_SUBGROUP_OF_EPIMORPHIC_PREIMAGE_EQ : thm
  GROUP_EPIMORPHISM_NORMAL_SUBGROUP_CORRESPONDENCE : thm
  GROUP_EPIMORPHISM_NORMAL_SUBGROUP_CORRESPONDENCE_ALT : thm
  SUBGROUP_OF_ISOMORPHIC_IMAGE_EQ : thm
  NORMAL_SUBGROUP_OF_ISOMORPHIC_IMAGE_EQ : thm
  GROUP_CONJUGATE_SUBGROUP_OF : thm
  GROUP_CONJUGATE_NORMAL_SUBGROUP_OF : thm
  NORMAL_SUBGROUP_CONJUGATE : thm
  NORMAL_SUBGROUP_CONJUGATE_EQ : thm
  QUOTIENT_SUBGROUP_CORRESPONDENCE : thm
  QUOTIENT_NORMAL_SUBGROUP_CORRESPONDENCE : thm
  FIRST_GROUP_ISOMORPHISM_THEOREM_GEN : thm
  FIRST_GROUP_ISOMORPHISM_THEOREM_GEN_ALT : thm
  SIMPLE_GROUP_EPIMORPHIC_IMAGE_EQ : thm
  NO_PROPER_SUBGROUP_EPIMORPHIC_IMAGE_EQ : thm
  MAXIMAL_SUBGROUP : thm
  MAXIMAL_NORMAL_SUBGROUP : thm
  deriving Inhabited

@[nospecialize]
def setupSubgroupCorrespondence [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BSetwise1 : Setwise1) (BCosets : Cosets) (BNormalSubgroups : NormalSubgroups) (BConjugate : Conjugate) (BQuotientGroups : QuotientGroups) (BKernelsImages1 : KernelsImages1) (BKernelsImages2 : KernelsImages2) :
    ExceptT String IO SubgroupCorrespondence := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { EQ_IMP, .. } := D.core2
  let { EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_UNWIND_THM1,
        FORALL_UNWIND_THM2, FUN_EQ_THM, FUN_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_ELIM_THM, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, PSUBSET, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SUBSET, SWAP_FORALL_THM, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LINV, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_DIV, GROUP_DIV_EQ_ID, group_div, .. } := BDerived
  let { IMAGE_GROUP_CONJUGATION_SUBSET, .. } := BConjugation
  let { IN_SUBGROUP_ID, IN_SUBGROUP_MUL, SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { group_epimorphism, group_homomorphism, group_isomorphism, group_isomorphisms, .. } := BHomomorphisms
  let { GROUP_EPIMORPHISM_COMPOSE, GROUP_HOMOMORPHISM_DIV, GROUP_HOMOMORPHISM_MUL, .. } := BHomomorphisms1
  let { GROUP_EPIMORPHISM_IMP_HOMOMORPHISM, GROUP_ISOMORPHISM_CONJUGATION,
        GROUP_ISOMORPHISM_IMP_EPIMORPHISM, GROUP_ISOMORPHISM_IMP_HOMOMORPHISM,
        SUBGROUP_OF_EPIMORPHIC_PREIMAGE, SUBGROUP_OF_HOMOMORPHIC_IMAGE,
        SUBGROUP_OF_HOMOMORPHIC_PREIMAGE, .. } := BHomomorphisms2
  let { group_setmul, .. } := BSetwise1
  let { RIGHT_COSET_EQ_SUBGROUP, .. } := BCosets
  let { NORMAL_SUBGROUP_CONJUGATE_INV, NORMAL_SUBGROUP_CONJUGATION_EQ,
        NORMAL_SUBGROUP_IMP_SUBGROUP, NORMAL_SUBGROUP_MUL_SYM,
        NORMAL_SUBGROUP_OF_IMP_SUBSET, normal_subgroup_of, .. } := BNormalSubgroups
  let { GROUP_CONJUGATE_REFL, group_conjugate, .. } := BConjugate
  let { GROUP_EPIMORPHISM_RIGHT_COSET, QUOTIENT_GROUP_ID, .. } := BQuotientGroups
  let { GROUP_KERNEL_RIGHT_COSET, group_kernel, .. } := BKernelsImages1
  let { FIRST_GROUP_EPIMORPHISM_THEOREM, GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE, .. } := BKernelsImages2
  -- @@SCOPE END

  let GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE_ALT ← prove
   r"!G H (f:A->B) j.
          group_epimorphism(G,H) f
          ==> (j subgroup_of G /\ group_kernel(G,H) f SUBSET j <=>
               ?k. k subgroup_of H /\
                   {x | x IN group_carrier G /\ f x IN k} = j /\
                   IMAGE f j = k)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP GROUP_EPIMORPHISM_IMP_HOMOMORPHISM) THEN
    EQ_TAC THENL
     [STRIP_TAC THEN EXISTS_TAC (← q r"IMAGE (f:A->B) j") THEN CONJ_TAC THENL
       [ASM_MESON_TAC [SUBGROUP_OF_HOMOMORPHIC_IMAGE], ASM_REWRITE_TAC []] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"j SUBSET s /\ (!x y. x IN j /\ y IN s /\ f x = f y ==> y IN j)
        ==> {x | x IN s /\ f x IN IMAGE f j} = j")) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
      ASM_REWRITE_TAC [] THEN RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      MAP_EVERY X_GEN_TAC [← q "x:A", ← q "y:A"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"y:A = group_mul G (group_div G y x) x") SUBST1_TAC THENL
       [ASM_SIMP_TAC [group_div, ← GSYM GROUP_MUL_ASSOC, GROUP_INV,
                     GROUP_MUL_LINV, GROUP_MUL_RID],
        MATCH_MP_TAC IN_SUBGROUP_MUL THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_SIMP_TAC [group_kernel, IN_ELIM_THM, GROUP_DIV] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (ASM_SIMP_TAC [← MATCH_MP GROUP_HOMOMORPHISM_DIV th])) THEN
        wPart pure (fun t => do lhand (← rand t)) GROUP_DIV_EQ_ID THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
        RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC []],
      DISCH_THEN (X_CHOOSE_THEN (← q "k:B->bool") STRIP_ASSUME_TAC) THEN
      EXPAND_TAC "j" THEN CONJ_TAC THENL
       [MATCH_MP_TAC SUBGROUP_OF_HOMOMORPHIC_PREIMAGE THEN ASM_MESON_TAC [],
        REWRITE_TAC [SUBSET, group_kernel, IN_ELIM_THM] THEN
        ASM_MESON_TAC [IN_SUBGROUP_ID]]])

  let NORMAL_SUBGROUP_OF_HOMOMORPHIC_PREIMAGE ← prove
   r"!G H (f:A->B) j.
          group_homomorphism(G,H) f /\ j normal_subgroup_of H
          ==> {x | x IN group_carrier G /\ f x IN j} normal_subgroup_of G"
   (REPEAT GEN_TAC THEN REWRITE_TAC [NORMAL_SUBGROUP_MUL_SYM] THEN
    STRIP_TAC THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SUBGROUP_OF_HOMOMORPHIC_PREIMAGE], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_MUL) THEN
    SIMP_TAC [IN_ELIM_THM, GROUP_MUL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [])

  let NORMAL_SUBGROUP_OF_EPIMORPHIC_IMAGE ← prove
   r"!G H (f:A->B) n.
          group_epimorphism(G,H) f /\ n normal_subgroup_of G
          ==> IMAGE f n normal_subgroup_of H"
   (REPEAT GEN_TAC THEN REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATE_INV] THEN
    REWRITE_TAC [group_epimorphism] THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [SUBGROUP_OF_HOMOMORPHIC_IMAGE], ALL_TAC] THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q "a:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "a:A")) THEN
    REWRITE_TAC [group_setmul, SUBSET, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_SING, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2] THEN
    ASM_REWRITE_TAC [FORALL_IN_GSPEC, FORALL_IN_IMAGE] THEN DISCH_TAC THEN
    X_GEN_TAC (← q "x:A") THEN DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q "x:A")) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [group_homomorphism]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN DISCH_TAC THEN DISCH_THEN
     (CONJUNCTS_THEN2 ASSUME_TAC (STRIP_ASSUME_TAC o GSYM o CONJUNCT2)) THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV, FUN_IN_IMAGE])

  let NORMAL_SUBGROUP_OF_EPIMORPHIC_PREIMAGE_EQ ← prove
   r"!G H (f:A->B) j k.
          group_epimorphism (G,H) f /\
          k subgroup_of H /\
          {x | x IN group_carrier G /\ f x IN k} = j
          ==> (j normal_subgroup_of G <=> k normal_subgroup_of H)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC,
      ASM_MESON_TAC [NORMAL_SUBGROUP_OF_HOMOMORPHIC_PREIMAGE,
                    group_epimorphism]] THEN
    SUBGOAL_THEN (← q r"k = IMAGE (f:A->B) j") SUBST1_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [NORMAL_SUBGROUP_OF_EPIMORPHIC_IMAGE]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of, group_epimorphism]) THEN
    ASM SET_TAC [])

  let GROUP_EPIMORPHISM_NORMAL_SUBGROUP_CORRESPONDENCE ← prove
   r"!G H (f:A->B) k.
          group_epimorphism(G,H) f
          ==> (k normal_subgroup_of H <=>
               ?j. j normal_subgroup_of G /\
                   group_kernel(G,H) f SUBSET j /\
                   {x | x IN group_carrier G /\ f x IN k} = j /\
                   IMAGE f j = k)"
   (MESON_TAC [GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE,
              NORMAL_SUBGROUP_OF_EPIMORPHIC_PREIMAGE_EQ,
              NORMAL_SUBGROUP_IMP_SUBGROUP])

  let GROUP_EPIMORPHISM_NORMAL_SUBGROUP_CORRESPONDENCE_ALT ← prove
   r"!G H (f:A->B) j.
          group_epimorphism(G,H) f
          ==> (j normal_subgroup_of G /\ group_kernel(G,H) f SUBSET j <=>
               ?k. k normal_subgroup_of H /\
                   {x | x IN group_carrier G /\ f x IN k} = j /\
                   IMAGE f j = k)"
   (MESON_TAC [GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE_ALT,
              NORMAL_SUBGROUP_OF_EPIMORPHIC_PREIMAGE_EQ,
              NORMAL_SUBGROUP_IMP_SUBGROUP])

  let SUBGROUP_OF_ISOMORPHIC_IMAGE_EQ ← prove
   r"!G H (f:A->B) j.
          group_isomorphism(G,H) f /\ j SUBSET group_carrier G
          ==> ((IMAGE f j) subgroup_of H <=> j subgroup_of G)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC,
      ASM_MESON_TAC [GROUP_ISOMORPHISM_IMP_HOMOMORPHISM,
                    SUBGROUP_OF_HOMOMORPHIC_IMAGE]] THEN
    SUBGOAL_THEN
     (← q r"j = {x | x IN group_carrier G /\ (f:A->B) x IN IMAGE f j}")
    SUBST1_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [group_isomorphism, group_isomorphisms]) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC SUBGROUP_OF_HOMOMORPHIC_PREIMAGE THEN
      ASM_MESON_TAC [GROUP_ISOMORPHISM_IMP_HOMOMORPHISM]])

  let NORMAL_SUBGROUP_OF_ISOMORPHIC_IMAGE_EQ ← prove
   r"!G H (f:A->B) j.
          group_isomorphism(G,H) f /\ j SUBSET group_carrier G
          ==> ((IMAGE f j) normal_subgroup_of H <=> j normal_subgroup_of G)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SUBGROUP_OF_ISOMORPHIC_IMAGE_EQ) THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> p) /\ (q' ==> p') /\ (p' ==> (q' <=> q))
      ==> (p' <=> p) ==> (q' <=> q)")) THEN
    REWRITE_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP] THEN DISCH_TAC THEN
    CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC NORMAL_SUBGROUP_OF_EPIMORPHIC_PREIMAGE_EQ THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_SIMP_TAC [GROUP_ISOMORPHISM_IMP_EPIMORPHISM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_isomorphism, group_isomorphisms]) THEN
    ASM SET_TAC [])

  let GROUP_CONJUGATE_SUBGROUP_OF ← prove
   r"!G s t:A->bool.
          group_conjugate G s t
          ==> (s subgroup_of G <=> t subgroup_of G)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [group_conjugate, RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    CONV_TAC SYM_CONV THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC SUBGROUP_OF_ISOMORPHIC_IMAGE_EQ THEN
    ASM_SIMP_TAC [GROUP_ISOMORPHISM_CONJUGATION])

  let GROUP_CONJUGATE_NORMAL_SUBGROUP_OF ← prove
   r"!G s t:A->bool.
          group_conjugate G s t
          ==> (s normal_subgroup_of G <=> t normal_subgroup_of G)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [group_conjugate, RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q "a:A") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    CONV_TAC SYM_CONV THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC NORMAL_SUBGROUP_OF_ISOMORPHIC_IMAGE_EQ THEN
    ASM_SIMP_TAC [GROUP_ISOMORPHISM_CONJUGATION])

  let NORMAL_SUBGROUP_CONJUGATE ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G <=>
          n subgroup_of G /\ !n'. group_conjugate G n n' ==> n' = n"
   (REPEAT GEN_TAC THEN REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION_EQ] THEN
    REWRITE_TAC [group_conjugate] THEN
    MESON_TAC [IMAGE_GROUP_CONJUGATION_SUBSET, SUBGROUP_OF_IMP_SUBSET])

  let NORMAL_SUBGROUP_CONJUGATE_EQ ← prove
   r"!G n n':A->bool.
          n normal_subgroup_of G \/ n' normal_subgroup_of G
          ==> (group_conjugate G n n' <=> n = n')"
   (MESON_TAC [NORMAL_SUBGROUP_CONJUGATE, GROUP_CONJUGATE_NORMAL_SUBGROUP_OF,
              GROUP_CONJUGATE_REFL, NORMAL_SUBGROUP_OF_IMP_SUBSET])

  let QUOTIENT_SUBGROUP_CORRESPONDENCE ← prove
   r"!(G:A group) j k.
          j normal_subgroup_of G
          ==> (k subgroup_of (quotient_group G j) <=>
               ?i. i subgroup_of G /\ j SUBSET i /\
                   {x | x IN group_carrier G /\ right_coset G j x IN k} = i /\
                   IMAGE (right_coset G j) i = k)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_EPIMORPHISM_RIGHT_COSET) THEN
    DISCH_THEN (MP_TAC o MATCH_MP GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE) THEN
    ASM_SIMP_TAC [GROUP_KERNEL_RIGHT_COSET])

  let QUOTIENT_NORMAL_SUBGROUP_CORRESPONDENCE ← prove
   r"!(G:A group) j k.
          j normal_subgroup_of G
          ==> (k normal_subgroup_of (quotient_group G j) <=>
               ?i. i normal_subgroup_of G /\ j SUBSET i /\
                   {x | x IN group_carrier G /\ right_coset G j x IN k} = i /\
                   IMAGE (right_coset G j) i = k)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_EPIMORPHISM_RIGHT_COSET) THEN
    DISCH_THEN (MP_TAC o MATCH_MP
      GROUP_EPIMORPHISM_NORMAL_SUBGROUP_CORRESPONDENCE) THEN
    ASM_SIMP_TAC [GROUP_KERNEL_RIGHT_COSET])

  let FIRST_GROUP_ISOMORPHISM_THEOREM_GEN ← prove
   r"!G H (f:A->B) j k.
          group_epimorphism(G,H) f /\
          k normal_subgroup_of H /\ {x | x IN group_carrier G /\ f x IN k} = j
          ==> quotient_group G j isomorphic_group quotient_group H k"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"quotient_group H (k:B->bool)",
                   ← q r"right_coset H k o (f:A->B)"]
          FIRST_GROUP_EPIMORPHISM_THEOREM) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC GROUP_EPIMORPHISM_COMPOSE THEN EXISTS_TAC (← q "H:B group") THEN
      ASM_SIMP_TAC [GROUP_EPIMORPHISM_RIGHT_COSET],
      MATCH_MP_TAC EQ_IMP] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    ASM_SIMP_TAC [group_kernel, QUOTIENT_GROUP_ID, o_THM] THEN
    GEN_REWRITE_TAC I [EXTENSION] THEN EXPAND_TAC "j" THEN
    X_GEN_TAC (← q "x:A") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    ASM_CASES_TAC (← q r"(x:A) IN group_carrier G") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC RIGHT_COSET_EQ_SUBGROUP THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_epimorphism, normal_subgroup_of]) THEN
    ASM SET_TAC [])

  let FIRST_GROUP_ISOMORPHISM_THEOREM_GEN_ALT ← prove
   r"!G H (f:A->B) j k.
          group_epimorphism(G,H) f /\ j normal_subgroup_of G /\
          group_kernel (G,H) f SUBSET j /\ IMAGE f j = k
          ==> quotient_group G j isomorphic_group quotient_group H k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FIRST_GROUP_ISOMORPHISM_THEOREM_GEN THEN
    EXISTS_TAC (← q r"f:A->B") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [GROUP_EPIMORPHISM_NORMAL_SUBGROUP_CORRESPONDENCE_ALT])

  let SIMPLE_GROUP_EPIMORPHIC_IMAGE_EQ ← prove
   r"!G H (f:A->B).
        group_epimorphism(G,H) f
        ==> ((!k. k normal_subgroup_of H
                  ==> k = {group_id H} \/ k = group_carrier H) <=>
             (!h. h normal_subgroup_of G /\ group_kernel(G,H) f PSUBSET h
                  ==> h = group_carrier G))"
   (← do
    let a2 ← TAUT (← q r"p /\ q /\ r ==> s <=> q ==> p /\ r ==> s")
    let a1 ← TAUT (← q r"p /\ q /\ ~r ==> s <=> p /\ q ==> r \/ s")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [PSUBSET, a1] THEN
    ASM_SIMP_TAC [GROUP_EPIMORPHISM_NORMAL_SUBGROUP_CORRESPONDENCE_ALT] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    ONCE_REWRITE_TAC [a2] THEN
    REWRITE_TAC [FORALL_UNWIND_THM1] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      SUBGROUP_OF_EPIMORPHIC_PREIMAGE)) THEN
    SIMP_TAC [IMP_CONJ, NORMAL_SUBGROUP_IMP_SUBGROUP] THEN
    DISCH_THEN (K ALL_TAC) THEN REWRITE_TAC [group_kernel] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC I [FUN_EQ_THM] THEN
    X_GEN_TAC (← q "k:B->bool") THEN
    ASM_CASES_TAC (← q r"(k:B->bool) normal_subgroup_of H") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC
     (REWRITE_RULE [group_epimorphism, subgroup_of, normal_subgroup_of,
         group_homomorphism]) THEN
    ASM SET_TAC []))

  let NO_PROPER_SUBGROUP_EPIMORPHIC_IMAGE_EQ ← prove
   r"!G H (f:A->B).
        group_epimorphism(G,H) f
        ==> ((!k. k subgroup_of H
                  ==> k = {group_id H} \/ k = group_carrier H) <=>
             (!h. h subgroup_of G /\ group_kernel(G,H) f PSUBSET h
                  ==> h = group_carrier G))"
   (← do
    let a2 ← TAUT (← q r"p /\ q /\ r ==> s <=> q ==> p /\ r ==> s")
    let a1 ← TAUT (← q r"p /\ q /\ ~r ==> s <=> p /\ q ==> r \/ s")
    pure (REPEAT STRIP_TAC THEN REWRITE_TAC [PSUBSET, a1] THEN
    ASM_SIMP_TAC [GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE_ALT] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    ONCE_REWRITE_TAC [a2] THEN
    REWRITE_TAC [FORALL_UNWIND_THM1] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      SUBGROUP_OF_EPIMORPHIC_PREIMAGE)) THEN
    SIMP_TAC [IMP_CONJ] THEN DISCH_THEN (K ALL_TAC) THEN
    REWRITE_TAC [group_kernel] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC I [FUN_EQ_THM] THEN
    X_GEN_TAC (← q "k:B->bool") THEN
    ASM_CASES_TAC (← q r"(k:B->bool) subgroup_of H") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC
     (REWRITE_RULE [group_epimorphism, subgroup_of, group_homomorphism]) THEN
    ASM SET_TAC []))

  let MAXIMAL_SUBGROUP ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> ((!h. h subgroup_of G /\ n PSUBSET h ==> h = group_carrier G) <=>
               (!k. k subgroup_of quotient_group G n
                    ==> k = {group_id(quotient_group G n)} \/
                        k = group_carrier(quotient_group G n)))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_EPIMORPHISM_RIGHT_COSET) THEN
    DISCH_THEN (MP_TAC o MATCH_MP NO_PROPER_SUBGROUP_EPIMORPHIC_IMAGE_EQ) THEN
    DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
    ASM_SIMP_TAC [GROUP_KERNEL_RIGHT_COSET])

  let MAXIMAL_NORMAL_SUBGROUP ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> ((!h. h normal_subgroup_of G /\ n PSUBSET h
                    ==> h = group_carrier G) <=>
               (!k. k normal_subgroup_of quotient_group G n
                    ==> k = {group_id(quotient_group G n)} \/
                        k = group_carrier(quotient_group G n)))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_EPIMORPHISM_RIGHT_COSET) THEN
    DISCH_THEN (MP_TAC o MATCH_MP SIMPLE_GROUP_EPIMORPHIC_IMAGE_EQ) THEN
    DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
    ASM_SIMP_TAC [GROUP_KERNEL_RIGHT_COSET])

  -- @@RETURN BEGIN
  return { GROUP_EPIMORPHISM_SUBGROUP_CORRESPONDENCE_ALT,
           NORMAL_SUBGROUP_OF_HOMOMORPHIC_PREIMAGE, NORMAL_SUBGROUP_OF_EPIMORPHIC_IMAGE,
           NORMAL_SUBGROUP_OF_EPIMORPHIC_PREIMAGE_EQ,
           GROUP_EPIMORPHISM_NORMAL_SUBGROUP_CORRESPONDENCE,
           GROUP_EPIMORPHISM_NORMAL_SUBGROUP_CORRESPONDENCE_ALT,
           SUBGROUP_OF_ISOMORPHIC_IMAGE_EQ, NORMAL_SUBGROUP_OF_ISOMORPHIC_IMAGE_EQ,
           GROUP_CONJUGATE_SUBGROUP_OF, GROUP_CONJUGATE_NORMAL_SUBGROUP_OF,
           NORMAL_SUBGROUP_CONJUGATE, NORMAL_SUBGROUP_CONJUGATE_EQ,
           QUOTIENT_SUBGROUP_CORRESPONDENCE, QUOTIENT_NORMAL_SUBGROUP_CORRESPONDENCE,
           FIRST_GROUP_ISOMORPHISM_THEOREM_GEN, FIRST_GROUP_ISOMORPHISM_THEOREM_GEN_ALT,
           SIMPLE_GROUP_EPIMORPHIC_IMAGE_EQ, NO_PROPER_SUBGROUP_EPIMORPHIC_IMAGE_EQ,
           MAXIMAL_SUBGROUP, MAXIMAL_NORMAL_SUBGROUP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Trivial homomorphisms.                                                    -/
/- ------------------------------------------------------------------------- -/

structure TrivialHomomorphisms where
  -- @@FIELDS
  trivial_homomorphism : thm
  GROUP_KERNEL_IMAGE_TRIVIAL : thm
  TRIVIAL_HOMOMORPHISM_GROUP_KERNEL : thm
  TRIVIAL_HOMOMORPHISM_GROUP_IMAGE : thm
  TRIVIAL_HOMOMORPHISM_TRIVIAL : thm
  GROUP_MONOMORPHISM_TRIVIAL : thm
  GROUP_EPIMORPHISM_TRIVIAL : thm
  GROUP_ISOMORPHISM_TRIVIAL : thm
  deriving Inhabited

@[nospecialize]
def setupTrivialHomomorphisms [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BKernelsImages1 : KernelsImages1) :
    ExceptT String IO TrivialHomomorphisms := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { EQ_SYM_EQ, .. } := D.core2
  let { GROUP_CARRIER_NONEMPTY, GROUP_ID, TRIVIAL_GROUP_ALT, trivial_group, .. } := BBasics
  let { group_epimorphism, group_homomorphism, group_monomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_TRIVIAL, .. } := BHomomorphisms1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { group_image, group_kernel, .. } := BKernelsImages1
  -- @@SCOPE END

  let trivial_homomorphism ← new_definition
   r"trivial_homomorphism(G,G') (f:A->B) <=>
          group_homomorphism(G,G') f /\
          !x. x IN group_carrier G ==> f x = group_id G'"

  let GROUP_KERNEL_IMAGE_TRIVIAL ← prove
   r"!(f:A->B) G G'.
          group_homomorphism (G,G') f
          ==> (group_kernel(G,G') f = group_carrier G <=>
               group_image(G,G') f = {group_id G'})"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [group_homomorphism, group_image, group_kernel] THEN
    MP_TAC (← ISPEC (← q "G:A group") GROUP_ID) THEN SET_TAC [])

  let TRIVIAL_HOMOMORPHISM_GROUP_KERNEL ← prove
   r"!(f:A->B) G G'.
          trivial_homomorphism(G,G') f <=>
          group_homomorphism(G,G') f /\
          group_kernel(G,G') f = group_carrier G"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [trivial_homomorphism, group_kernel, group_homomorphism] THEN
    SET_TAC [])

  let TRIVIAL_HOMOMORPHISM_GROUP_IMAGE ← prove
   r"!(f:A->B) G G'.
          trivial_homomorphism(G,G') f <=>
          group_homomorphism(G,G') f /\
          group_image(G,G') f = {group_id G'}"
   (MESON_TAC [TRIVIAL_HOMOMORPHISM_GROUP_KERNEL, GROUP_KERNEL_IMAGE_TRIVIAL])

  let TRIVIAL_HOMOMORPHISM_TRIVIAL ← prove
   r"!G H. trivial_homomorphism (G,H) (\x. group_id H)"
   (REWRITE_TAC [trivial_homomorphism, GROUP_HOMOMORPHISM_TRIVIAL])

  let GROUP_MONOMORPHISM_TRIVIAL ← prove
   r"!G H. group_monomorphism (G,H) (\x. group_id H) <=> trivial_group G"
   (REWRITE_TAC [group_monomorphism, GROUP_HOMOMORPHISM_TRIVIAL] THEN
    REWRITE_TAC [TRIVIAL_GROUP_ALT] THEN SET_TAC [])

  let GROUP_EPIMORPHISM_TRIVIAL ← prove
   r"!G H. group_epimorphism (G,H) (\x. group_id H) <=> trivial_group H"
   (REWRITE_TAC [group_epimorphism, GROUP_HOMOMORPHISM_TRIVIAL] THEN
    SIMP_TAC [GROUP_CARRIER_NONEMPTY, ← SET_RULE
     (← q r"~(s = {}) ==> IMAGE (\x. a) s = {a}")] THEN
    REWRITE_TAC [trivial_group, EQ_SYM_EQ])

  let GROUP_ISOMORPHISM_TRIVIAL ← prove
   r"!G H. group_isomorphism (G,H) (\x. group_id H) <=>
           trivial_group G /\ trivial_group H"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    REWRITE_TAC [GROUP_MONOMORPHISM_TRIVIAL, GROUP_EPIMORPHISM_TRIVIAL])

  -- @@RETURN BEGIN
  return { trivial_homomorphism, GROUP_KERNEL_IMAGE_TRIVIAL,
           TRIVIAL_HOMOMORPHISM_GROUP_KERNEL, TRIVIAL_HOMOMORPHISM_GROUP_IMAGE,
           TRIVIAL_HOMOMORPHISM_TRIVIAL, GROUP_MONOMORPHISM_TRIVIAL,
           GROUP_EPIMORPHISM_TRIVIAL, GROUP_ISOMORPHISM_TRIVIAL }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The order of a group element. This is defined as 0 for the infinite case. -/
/- This keeps theorems uniform and is analogous to "characteristic zero".    -/
/- That is, x^n = 1 iff n is divisible by the order of x, in all cases.      -/
/- ------------------------------------------------------------------------- -/

structure GroupElementOrder where
  -- @@FIELDS
  group_element_order : thm
  GROUP_POW_EQ_ID : thm
  GROUP_POW_EQ_ID_DIVISOR : thm
  GROUP_POW_ELEMENT_ORDER : thm
  GROUP_ZPOW_EQ_ID : thm
  GROUP_ZPOW_EQ_ID_DIVISOR : thm
  GROUP_ZPOW_EQ_ALT : thm
  GROUP_ZPOW_EQ : thm
  GROUP_POW_EQ : thm
  GROUP_ZPOW_REM_ELEMENT_ORDER : thm
  GROUP_POW_MOD_ELEMENT_ORDER : thm
  GROUP_ELEMENT_ORDER_EQ_0 : thm
  GROUP_ELEMENT_ORDER_UNIQUE : thm
  GROUP_ELEMENT_ORDER_EQ_1 : thm
  GROUP_ELEMENT_ORDER_UNIQUE_PRIME : thm
  GROUP_ELEMENT_ORDER_ID : thm
  GROUP_ELEMENT_ORDER_INV : thm
  GROUP_POW_GCD_EQ_ID : thm
  GROUP_POW_COPRIME_EQ_ID : thm
  FINITE_GROUP_ELEMENT_ORDER_NONZERO : thm
  GROUP_ELEMENT_ORDER_POW : thm
  deriving Inhabited

@[nospecialize]
def setupGroupElementOrder [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) :
    ExceptT String IO GroupElementOrder := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INTEGER_RULE, MESON_TAC, NUMBER_RULE, NUMBER_TAC, SELECT_CONV,
        TAUT, new_definition, .. } := D
  let { CONTRAPOS_THM, COPRIME_GCD, DIVIDES_ANTISYM, DIVIDES_LE, DIVISION, DIV_MULT, .. } := D.core2
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, INFINITE, INFINITE_IMAGE, INFINITE_SUPERSET, INT_CONG_LREM,
        INT_IMAGE, .. } := D.core4
  let { INT_OF_NUM_REM, IN_UNIV, .. } := D.core5
  let { LT_NZ, MONO_EXISTS, MULT_SYM, NOT_FORALL_THM, NOT_IMP, NOT_LE, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, divides, .. } := D.core7
  let { num_INFINITE, num_WOP, num_congruent, num_divides, prime, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL_LID, .. } := BBasics
  let { GROUP_DIV_EQ_ID, GROUP_INV_EQ_ID, GROUP_INV_POW, GROUP_POW, GROUP_POW_1,
        GROUP_POW_ADD, GROUP_POW_ID, GROUP_POW_MUL, group_pow, .. } := BDerived
  let { GROUP_NPOW, GROUP_ZPOW, GROUP_ZPOW_NEG, GROUP_ZPOW_SUB, .. } := BPow
  -- @@SCOPE END

  let group_element_order ← new_definition
   r"group_element_order G (x:A) =
        @d. !n. group_pow G x n = group_id G <=> d divides n"

  let GROUP_POW_EQ_ID ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> (group_pow G x n = group_id G <=>
             (group_element_order G x) divides n)"
   (← do
     let a4 ← NUMBER_RULE (← q r"n divides 0")
     let a3 ← NUMBER_RULE (← q r"(d:num) divides (a * d + b) <=> d divides b")
     let a2 ← TAUT (← q
       r"p ==> q ==> r <=> ~r /\ p ==> ~q")
     let a1 ← NUMBER_RULE (← q r"0 divides n <=> n = 0")
     pure (
      REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
      REWRITE_TAC [group_element_order] THEN CONV_TAC SELECT_CONV THEN
      ASM_CASES_TAC (← q r"!n. group_pow G (x:A) n = group_id G ==> n = 0") THENL
       [EXISTS_TAC (← q r"0") THEN REWRITE_TAC [a1] THEN
        ASM_MESON_TAC [← CONJUNCT1 group_pow],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [NOT_FORALL_THM])] THEN
      GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"d:num") THEN REWRITE_TAC [NOT_IMP, ← GSYM LT_NZ, a2] THEN
      STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN
      MP_TAC (← SPECL [(← q r"n:num"), (← q r"d:num")] DIVISION) THEN
      ASM_REWRITE_TAC [← GSYM LT_NZ] THEN
      DISCH_THEN (CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC) THEN
      REWRITE_TAC [a3] THEN
      ONCE_REWRITE_TAC [MULT_SYM] THEN
      ASM_SIMP_TAC [GROUP_POW_ADD, GROUP_POW_MUL, GROUP_POW_ID] THEN
      ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_POW] THEN
      ASM_CASES_TAC (← q r"n MOD d = 0") THEN
      ASM_REWRITE_TAC [← CONJUNCT1 group_pow, a4] THEN
      ASM_SIMP_TAC [LT_NZ] THEN DISCH_THEN (MP_TAC o MATCH_MP DIVIDES_LE) THEN
      ASM_REWRITE_TAC [NOT_LE]))

  let GROUP_POW_EQ_ID_DIVISOR ← prove
   r"!G (x:A) m n.
        x IN group_carrier G /\
        group_pow G x m = group_id G /\
        m divides n
        ==> group_pow G x n = group_id G"
   (SIMP_TAC [IMP_CONJ, GROUP_POW_EQ_ID] THEN CONV_TAC NUMBER_RULE)

  let GROUP_POW_ELEMENT_ORDER ← prove
   r"!G x:A. x IN group_carrier G
           ==> group_pow G x (group_element_order G x) = group_id G"
   (← do
     let a1 ← NUMBER_RULE (← q r"(d:num) divides d")
     pure (
      SIMP_TAC [GROUP_POW_EQ_ID, a1]))

  let GROUP_ZPOW_EQ_ID ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> (group_zpow G x n = group_id G <=>
             &(group_element_order G x) divides n)"
   (← do
     let a1 ← INTEGER_RULE (← q r"m divides (--n:int) <=> m divides n")
     pure (
      REPEAT STRIP_TAC THEN DISJ_CASES_THEN
       (X_CHOOSE_THEN (← q r"m:num") SUBST1_TAC) (← SPEC (← q r"n:int") INT_IMAGE) THEN
      ASM_SIMP_TAC [GROUP_NPOW, GROUP_ZPOW_NEG, GROUP_INV_EQ_ID,
                   GROUP_POW, GROUP_POW_EQ_ID] THEN
      REWRITE_TAC [a1] THEN
      REWRITE_TAC [num_divides]))

  let GROUP_ZPOW_EQ_ID_DIVISOR ← prove
   r"!G (x:A) m n.
        x IN group_carrier G /\
        group_zpow G x m = group_id G /\
        m divides n
        ==> group_zpow G x n = group_id G"
   (SIMP_TAC [IMP_CONJ, GROUP_ZPOW_EQ_ID] THEN CONV_TAC INTEGER_RULE)

  let GROUP_ZPOW_EQ_ALT ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> (group_zpow G x m = group_zpow G x n <=>
             &(group_element_order G x) divides n - m)"
   (SIMP_TAC [← GSYM GROUP_ZPOW_EQ_ID, GROUP_ZPOW_SUB] THEN
    SIMP_TAC [GROUP_DIV_EQ_ID, GROUP_ZPOW] THEN MESON_TAC [])

  let GROUP_ZPOW_EQ ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> (group_zpow G x m = group_zpow G x n <=>
             (m == n) (mod &(group_element_order G x)))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [GROUP_ZPOW_EQ_ALT] THEN
    CONV_TAC INTEGER_RULE)

  let GROUP_POW_EQ ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> (group_pow G x m = group_pow G x n <=>
             (m == n) (mod (group_element_order G x)))"
   (SIMP_TAC [← GSYM GROUP_NPOW, GROUP_ZPOW_EQ, num_congruent])

  let GROUP_ZPOW_REM_ELEMENT_ORDER ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> group_zpow G x (n rem &(group_element_order G x)) =
            group_zpow G x n"
   (SIMP_TAC [GROUP_ZPOW_EQ, INT_CONG_LREM] THEN
    REPEAT STRIP_TAC THEN CONV_TAC INTEGER_RULE)

  let GROUP_POW_MOD_ELEMENT_ORDER ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> group_pow G x (n MOD group_element_order G x) =
            group_pow G x n"
   (REWRITE_TAC [← GSYM GROUP_NPOW, ← GSYM INT_OF_NUM_REM,
                GROUP_ZPOW_REM_ELEMENT_ORDER])

  let GROUP_ELEMENT_ORDER_EQ_0 ← prove
   r"!G (x:A).
        x IN group_carrier G
        ==> (group_element_order G x = 0 <=>
              !n. ~(n = 0) ==> ~(group_pow G x n = group_id G))"
   (← do
     let a2 ← NUMBER_RULE (← q r"!n:num. n divides n")
     let a1 ← NUMBER_RULE (← q r"0 divides n <=> n = 0")
     pure (
      SIMP_TAC [GROUP_POW_EQ_ID] THEN MESON_TAC [a1, a2]))

  let GROUP_ELEMENT_ORDER_UNIQUE ← prove
   r"!G (x:A) d.
        x IN group_carrier G
        ==> (group_element_order G x = d <=>
             !n. group_pow G x n = group_id G <=> d divides n)"
   (← do
     let a1 ← NUMBER_RULE (← q r"(n:num) divides n")
     pure (
      REPEAT STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP GROUP_POW_EQ_ID) THEN
      EQ_TAC THENL [ASM_MESON_TAC [], ASM_REWRITE_TAC []] THEN
      MESON_TAC [DIVIDES_ANTISYM, a1]))

  let GROUP_ELEMENT_ORDER_EQ_1 ← prove
   r"!G (x:A).
        x IN group_carrier G
        ==> (group_element_order G x = 1 <=> x = group_id G)"
   (← do
     let a1 ← NUMBER_RULE (← q r"1 divides n")
     pure (
      SIMP_TAC [GROUP_ELEMENT_ORDER_UNIQUE, a1] THEN
      MESON_TAC [GROUP_POW_ID, GROUP_POW_1]))

  let GROUP_ELEMENT_ORDER_UNIQUE_PRIME ← prove
   r"!G (x:A) p.
        x IN group_carrier G /\ prime p
        ==> (group_element_order G x = p <=>
             ~(x = group_id G) /\ group_pow G x p = group_id G)"
   (← do
     let a1 ← NUMBER_RULE (← q r"1 divides n /\ n divides n")
     pure (
      SIMP_TAC [GROUP_POW_EQ_ID, ← GSYM GROUP_ELEMENT_ORDER_EQ_1] THEN
      REWRITE_TAC [prime] THEN
      MESON_TAC [a1]))

  let GROUP_ELEMENT_ORDER_ID ← prove
   r"!G:A group. group_element_order G (group_id G) = 1"
   (SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_1, GROUP_ID])

  let GROUP_ELEMENT_ORDER_INV ← prove
   r"!G x:A.
        x IN group_carrier G
        ==> group_element_order G (group_inv G x) = group_element_order G x"
   (SIMP_TAC [GROUP_ELEMENT_ORDER_UNIQUE, GROUP_INV, ← GSYM GROUP_INV_POW] THEN
    SIMP_TAC [GROUP_INV_EQ_ID, GROUP_POW, GROUP_POW_EQ_ID])

  let GROUP_POW_GCD_EQ_ID ← prove
   r"!G (x:A) m n.
        x IN group_carrier G
        ==> (group_pow G x (gcd(m,n)) = group_id G <=>
             group_pow G x m = group_id G /\ group_pow G x n = group_id G)"
   (SIMP_TAC [GROUP_POW_EQ_ID] THEN REPEAT STRIP_TAC THEN NUMBER_TAC)

  let GROUP_POW_COPRIME_EQ_ID ← prove
   r"!G (x:A) m n.
        x IN group_carrier G /\ coprime(m,n)
        ==> (group_pow G x m = group_id G /\ group_pow G x n = group_id G <=>
             x = group_id G)"
   (SIMP_TAC [← GSYM GROUP_POW_GCD_EQ_ID, COPRIME_GCD, GROUP_POW_1])

  let FINITE_GROUP_ELEMENT_ORDER_NONZERO ← prove
   r"!G x:A.
        FINITE(group_carrier G) /\ x IN group_carrier G
        ==> ~(group_element_order G x = 0)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [← GSYM INFINITE] THEN DISCH_TAC THEN
    MATCH_MP_TAC INFINITE_SUPERSET THEN
    EXISTS_TAC (← q r"IMAGE (\n. group_pow G (x:A) n) (:num)") THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, GROUP_POW] THEN
    MATCH_MP_TAC INFINITE_IMAGE THEN
    ASM_SIMP_TAC [GROUP_POW_EQ, IN_UNIV, num_INFINITE] THEN
    CONV_TAC NUMBER_RULE)

  let GROUP_ELEMENT_ORDER_POW ← prove
   r"!G (x:A) k.
        x IN group_carrier G /\ ~(k = 0) /\ k divides group_element_order G x
        ==> group_element_order G (group_pow G x k) =
            group_element_order G x DIV k"
   (SIMP_TAC [GROUP_ELEMENT_ORDER_UNIQUE, GROUP_POW, ← GSYM GROUP_POW_MUL] THEN
    SIMP_TAC [GROUP_POW_EQ_ID] THEN REWRITE_TAC [divides] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM SUBST1_TAC THEN
    ASM_SIMP_TAC [← GSYM divides, DIV_MULT] THEN
    UNDISCH_TAC (← q r"~(k = 0)") THEN CONV_TAC NUMBER_RULE)

  -- @@RETURN BEGIN
  return { group_element_order, GROUP_POW_EQ_ID, GROUP_POW_EQ_ID_DIVISOR,
           GROUP_POW_ELEMENT_ORDER, GROUP_ZPOW_EQ_ID, GROUP_ZPOW_EQ_ID_DIVISOR,
           GROUP_ZPOW_EQ_ALT, GROUP_ZPOW_EQ, GROUP_POW_EQ, GROUP_ZPOW_REM_ELEMENT_ORDER,
           GROUP_POW_MOD_ELEMENT_ORDER, GROUP_ELEMENT_ORDER_EQ_0,
           GROUP_ELEMENT_ORDER_UNIQUE, GROUP_ELEMENT_ORDER_EQ_1,
           GROUP_ELEMENT_ORDER_UNIQUE_PRIME, GROUP_ELEMENT_ORDER_ID,
           GROUP_ELEMENT_ORDER_INV, GROUP_POW_GCD_EQ_ID, GROUP_POW_COPRIME_EQ_ID,
           FINITE_GROUP_ELEMENT_ORDER_NONZERO, GROUP_ELEMENT_ORDER_POW }
  -- @@RETURN END

structure GroupElementOrder2 where
  -- @@FIELDS
  GROUP_ELEMENT_ORDER_POW_GEN : thm
  GROUP_ELEMENT_ORDER_MUL_DIVIDES_GEN : thm
  ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES_GEN : thm
  GROUP_ELEMENT_ORDER_MUL_DIVIDES_LCM : thm
  ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES_LCM : thm
  GROUP_ELEMENT_ORDER_HOMOMORPHIC_IMAGE : thm
  GROUP_ELEMENT_ORDER_MONOMORPHIC_IMAGE : thm
  ISOMORPHIC_GROUP_TORSION : thm
  GROUP_ELEMENT_ORDER_CONJUGATION : thm
  GROUP_ELEMENT_ORDER_MUL_DIVIDES : thm
  ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES : thm
  GROUP_POW_MUL_EQ_ID_SYM : thm
  GROUP_ELEMENT_ORDER_MUL_SYM : thm
  GROUP_ELEMENT_ORDER_UNIQUE_ALT : thm
  GROUP_ELEMENT_ORDER_EQ_2 : thm
  GROUP_ELEMENT_ORDER_EQ_2_ALT : thm
  GROUP_ELEMENT_ORDER_POW_DIVIDES : thm
  GROUP_ELEMENT_ORDER_MUL_EQ : thm
  GROUP_ELEMENT_ORDER_EQ_MUL_GEN : thm
  GROUP_ELEMENT_ORDER_EQ_MUL : thm
  ABELIAN_GROUP_ELEMENT_ORDER_MUL_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupGroupElementOrder2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BGroupRule : GroupRule) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BKernelsImages1 : KernelsImages1) (BGroupElementOrder : GroupElementOrder) :
    ExceptT String IO GroupElementOrder2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC,
        NUMBER_RULE, NUMBER_TAC, NUM_RING, TAUT, .. } := D
  let { ARITH, .. } := D.core1
  let { CONTRAPOS_THM, DIVIDES_ANTISYM, DIVIDES_DIV_MULT, DIVIDES_GCD_RIGHT,
        DIVIDES_LE, DIVIDES_TRANS, DIVISION, DIV_MULT, EQ_TRANS, ETA_AX, .. } := D.core2
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { LEFT_IMP_EXISTS_THM, LE_1, MULT_SYM, .. } := D.core6
  let { SUBSET, divides, .. } := D.core7
  let { GROUP_ID, GROUP_MUL, GROUP_MUL_LID, GROUP_MUL_LINV, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_LINV_EQ, GROUP_POW, GROUP_POW_1, GROUP_POW_2, GROUP_POW_ADD,
        GROUP_POW_ID, GROUP_POW_MUL, GROUP_POW_POW, group_pow, .. } := BDerived
  let { GROUP_MUL_POW, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { GROUP_RULE, .. } := BGroupRule
  let { group_automorphism, group_epimorphism, group_homomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_POW, .. } := BHomomorphisms1
  let { GROUP_AUTOMORPHISM_CONJUGATION, GROUP_ISOMORPHISM_IMP_MONOMORPHISM,
        GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { isomorphic_group, .. } := BIso1
  let { GROUP_MONOMORPHISM_ALT_EQ, .. } := BKernelsImages1
  let { GROUP_ELEMENT_ORDER_ID, GROUP_ELEMENT_ORDER_UNIQUE, GROUP_POW_ELEMENT_ORDER,
        GROUP_POW_EQ_ID, group_element_order, .. } := BGroupElementOrder
  -- @@SCOPE END

  let GROUP_ELEMENT_ORDER_POW_GEN ← prove
   r"!G (x:A) k.
        x IN group_carrier G
        ==> group_element_order G (group_pow G x k) =
            if k = 0 then 1
            else group_element_order G x DIV gcd(group_element_order G x,k)"
   (← do
     let a2 ← NUMBER_RULE (← q r"gcd(d,k) = 0 <=> d = 0 /\ k = 0")
     let a1 ← NUMBER_RULE (← q r"gcd(d:num,k) divides d")
     pure (
      REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [← CONJUNCT1 group_pow, GROUP_ELEMENT_ORDER_ID] THEN
      ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_UNIQUE, GROUP_POW] THEN
      ASM_SIMP_TAC [← GSYM GROUP_POW_MUL] THEN
      ASM_SIMP_TAC [GROUP_POW_EQ_ID] THEN X_GEN_TAC (← q r"n:num") THEN
      SPEC_TAC ((← q r"group_element_order G (x:A)"), (← q r"d:num")) THEN GEN_TAC THEN
      MP_TAC a1 THEN
      GEN_REWRITE_TAC LAND_CONV [divides] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") MP_TAC) THEN
      DISCH_THEN (fun th => tactic_of do
        pure (GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o LAND_CONV) [th] THEN
          MP_TAC (← SYM th))) THEN
      ASM_SIMP_TAC [DIV_MULT, a2] THEN
      UNDISCH_TAC (← q r"~(k = 0)") THEN NUMBER_TAC))

  let GROUP_ELEMENT_ORDER_MUL_DIVIDES_GEN ← prove
   r"!G x (y:A) n.
        x IN group_carrier G /\
        y IN group_carrier G /\
        group_mul G x y = group_mul G y x /\
        group_element_order G x divides n /\
        group_element_order G y divides n
        ==> group_element_order G (group_mul G x y) divides n"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [← GSYM GROUP_POW_EQ_ID, IMP_CONJ, GROUP_MUL] THEN
    SIMP_TAC [GROUP_MUL_POW, GROUP_MUL_LID, GROUP_ID])

  let ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES_GEN ← prove
   r"!G x (y:A) n.
        abelian_group G /\
        x IN group_carrier G /\
        y IN group_carrier G /\
        group_element_order G x divides n /\
        group_element_order G y divides n
        ==> group_element_order G (group_mul G x y) divides n"
   (REWRITE_TAC [abelian_group] THEN
    MESON_TAC [GROUP_ELEMENT_ORDER_MUL_DIVIDES_GEN])

  let GROUP_ELEMENT_ORDER_MUL_DIVIDES_LCM ← prove
   r"!G x (y:A).
        x IN group_carrier G /\
        y IN group_carrier G /\
        group_mul G x y = group_mul G y x
        ==> group_element_order G (group_mul G x y) divides
            lcm(group_element_order G x,group_element_order G y)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ELEMENT_ORDER_MUL_DIVIDES_GEN THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC NUMBER_RULE)

  let ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES_LCM ← prove
   r"!G x (y:A).
        abelian_group G /\
        x IN group_carrier G /\
        y IN group_carrier G
        ==> group_element_order G (group_mul G x y) divides
            lcm(group_element_order G x,group_element_order G y)"
   (REWRITE_TAC [abelian_group] THEN
    MESON_TAC [GROUP_ELEMENT_ORDER_MUL_DIVIDES_LCM])

  let GROUP_ELEMENT_ORDER_HOMOMORPHIC_IMAGE ← prove
   r"!G H (f:A->B) x.
        group_homomorphism(G,H) f /\ x IN group_carrier G
        ==> group_element_order H (f x) divides group_element_order G x"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o REWRITE_RULE [group_homomorphism]) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM GROUP_POW_EQ_ID] THEN
    FIRST_ASSUM (MP_TAC o GSYM o MATCH_MP GROUP_HOMOMORPHISM_POW) THEN
    ASM_SIMP_TAC [GROUP_POW_ELEMENT_ORDER] THEN
    ASM_MESON_TAC [group_homomorphism])

  let GROUP_ELEMENT_ORDER_MONOMORPHIC_IMAGE ← prove
   r"!(f:A->B) G H x.
        group_monomorphism(G,H) f /\ x IN group_carrier G
        ==> group_element_order H (f x) = group_element_order G x"
   (REWRITE_TAC [GROUP_MONOMORPHISM_ALT_EQ] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [group_element_order] THEN
    ASM_SIMP_TAC [← GSYM GROUP_HOMOMORPHISM_POW, GROUP_POW])

  let ISOMORPHIC_GROUP_TORSION ← prove
   r"!P (G:A group) (H:B group).
        G isomorphic_group H
        ==> ((!x. x IN group_carrier G ==> P(group_element_order G x)) <=>
             (!y. y IN group_carrier H ==> P(group_element_order H y)))"
   (REWRITE_TAC [isomorphic_group, ← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [group_epimorphism] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE] THEN
    ASM_MESON_TAC [GROUP_ELEMENT_ORDER_MONOMORPHIC_IMAGE])

  let GROUP_ELEMENT_ORDER_CONJUGATION ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> group_element_order G (group_conjugation G x y) =
            group_element_order G y"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC GROUP_ELEMENT_ORDER_MONOMORPHIC_IMAGE THEN
    ASM_REWRITE_TAC [ETA_AX] THEN
    ASM_MESON_TAC [GROUP_ISOMORPHISM_IMP_MONOMORPHISM,
                  GROUP_AUTOMORPHISM_CONJUGATION, group_automorphism])

  let GROUP_ELEMENT_ORDER_MUL_DIVIDES ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\
        group_mul G x y = group_mul G y x
        ==> group_element_order G (group_mul G x y)
            divides (group_element_order G x * group_element_order G y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_SIMP_TAC [← GSYM GROUP_POW_EQ_ID, GROUP_MUL] THEN
    ASM_SIMP_TAC [GROUP_MUL_POW] THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV) [MULT_SYM] THEN
    ASM_SIMP_TAC [GROUP_POW_MUL, GROUP_POW_ELEMENT_ORDER] THEN
    SIMP_TAC [GROUP_POW_ID, GROUP_MUL_LID, GROUP_ID])

  let ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES ← prove
   r"!G x y:A.
        abelian_group G /\ x IN group_carrier G /\ y IN group_carrier G
        ==> group_element_order G (group_mul G x y)
            divides (group_element_order G x * group_element_order G y)"
   (MESON_TAC [GROUP_ELEMENT_ORDER_MUL_DIVIDES, abelian_group])

  let GROUP_POW_MUL_EQ_ID_SYM ← prove
   r"!G n x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> (group_pow G (group_mul G x y) n = group_id G <=>
             group_pow G (group_mul G y x) n = group_id G)"
   (← do
     let a2 ← GROUP_RULE (← q
       r"group_mul G (group_inv G x)
                    (group_mul G (group_mul G (group_mul G x y) z) x) =
        group_mul G (group_mul G y x)
                    (group_mul G (group_inv G x) (group_mul G z x))")
     let a1 ← GROUP_RULE (← q
       r"group_mul G (group_inv G x) (group_mul G z x) = group_id G <=>
          z = group_id G")
     pure (
      REPEAT STRIP_TAC THEN
      TRANS_TAC EQ_TRANS
       (← q r"group_mul G (group_inv G x)
                   (group_mul G (group_pow G (group_mul G x y) n) x):A =
        group_id G") THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [GROUP_MUL, GROUP_POW, a1],
        AP_THM_TAC THEN AP_TERM_TAC] THEN
      SPEC_TAC ((← q r"n:num"), (← q r"n:num")) THEN INDUCT_TAC THEN
      ASM_SIMP_TAC [group_pow, GROUP_MUL_LID, GROUP_MUL_LINV] THEN
      ASM_SIMP_TAC [GROUP_POW, GROUP_MUL, a2]))

  let GROUP_ELEMENT_ORDER_MUL_SYM ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G
        ==> group_element_order G (group_mul G x y) =
            group_element_order G (group_mul G y x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [group_element_order] THEN
    AP_TERM_TAC THEN ABS_TAC THEN ASM_MESON_TAC [GROUP_POW_MUL_EQ_ID_SYM])

  let GROUP_ELEMENT_ORDER_UNIQUE_ALT ← prove
   r"!G (x:A) n.
        x IN group_carrier G /\ ~(n = 0)
        ==> (group_element_order G x = n <=>
             group_pow G x n = group_id G /\
             !m. 0 < m /\ m < n ==> ~(group_pow G x m = group_id G))"
   (← do
     let a2 ← NUMBER_RULE (← q r"n divides 0")
     let a1 ← NUMBER_RULE (← q
       r"(n:num) divides (q * n + r) <=> n divides r")
     pure (
      REPEAT STRIP_TAC THEN EQ_TAC THENL
       [DISCH_THEN (SUBST1_TAC o SYM) THEN
        ASM_SIMP_TAC [GROUP_POW_ELEMENT_ORDER] THEN
        ASM_SIMP_TAC [GROUP_POW_EQ_ID] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP DIVIDES_LE) THEN
        ASM_ARITH_TAC,
        STRIP_TAC THEN ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_UNIQUE] THEN
        X_GEN_TAC (← q r"m:num") THEN EQ_TAC THEN DISCH_TAC THENL
         [UNDISCH_TAC (← q r"group_pow G (x:A) m = group_id G") THEN
          FIRST_ASSUM (MP_TAC o SPEC (← q r"m:num") o MATCH_MP DIVISION) THEN
          DISCH_THEN (CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC) THEN
          ASM_SIMP_TAC [GROUP_POW_ADD, a1] THEN
          ONCE_REWRITE_TAC [MULT_SYM] THEN
          ASM_SIMP_TAC [GROUP_POW_MUL, GROUP_POW_ID, GROUP_MUL_LID, GROUP_POW] THEN
          GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
          DISCH_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
          ASM_MESON_TAC [LE_1, a2],
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [divides]) THEN
          ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, GROUP_POW_MUL, GROUP_POW_ID]]]))

  let GROUP_ELEMENT_ORDER_EQ_2 ← prove
   r"!G x:A.
        x IN group_carrier G
        ==> (group_element_order G x = 2 <=>
             ~(x = group_id G) /\ group_pow G x 2 = group_id G)"
   (← do
     let a1 ← ARITH_RULE (← q r"0 < m /\ m < 2 <=> m = 1")
     pure (
      REPEAT STRIP_TAC THEN
      ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_UNIQUE_ALT, ARITH] THEN
      REWRITE_TAC [a1] THEN
      ASM_SIMP_TAC [GROUP_POW_1] THEN MESON_TAC []))

  let GROUP_ELEMENT_ORDER_EQ_2_ALT ← prove
   r"!G x:A.
        x IN group_carrier G
        ==> (group_element_order G x = 2 <=>
             ~(x = group_id G) /\ group_inv G x = x)"
   (SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_2, GROUP_LINV_EQ, GROUP_POW_2])

  let GROUP_ELEMENT_ORDER_POW_DIVIDES ← prove
   r"!G (x:A) n.
        x IN group_carrier G
        ==> group_element_order G (group_pow G x n) divides
            group_element_order G x"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [← GSYM GROUP_POW_EQ_ID, GROUP_POW] THEN
    ASM_SIMP_TAC [GROUP_POW_POW] THEN
    ASM_SIMP_TAC [GROUP_POW_EQ_ID] THEN CONV_TAC NUMBER_RULE)

  let GROUP_ELEMENT_ORDER_MUL_EQ ← prove
   r"!G x y:A.
        x IN group_carrier G /\ y IN group_carrier G /\
        group_mul G x y = group_mul G y x /\
        coprime(group_element_order G x,group_element_order G y)
        ==> group_element_order G (group_mul G x y) =
            group_element_order G x * group_element_order G y"
   (← do
     let a2 ← MESON []
       (← q r"(group_mul G (group_pow G x m) (group_pow G y m) = group_pow G x m /\
     group_mul G (group_pow G x n) (group_pow G y n) = group_pow G y n) /\
    (group_mul G (group_pow G x m) (group_pow G y m) = group_id G /\
     group_mul G (group_pow G x n) (group_pow G y n) = group_id G)
    ==> group_pow G x m = group_id G /\ group_pow G y n = group_id G")
     let a1 ← NUMBER_RULE
       (← q r"(a:num) divides (b * c) /\ b divides (a * c) /\ coprime(a,b)
    ==> (a * b) divides c")
     pure (
      REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM DIVIDES_ANTISYM] THEN
      ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_MUL_DIVIDES] THEN
      MATCH_MP_TAC a1 THEN
      ASM_SIMP_TAC [← GSYM GROUP_POW_EQ_ID] THEN
      MATCH_MP_TAC a2 THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [GROUP_POW_MUL, GROUP_POW_ELEMENT_ORDER, GROUP_POW_ID] THEN
        ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_MUL_RID, GROUP_POW],
        ASM_SIMP_TAC [← GSYM GROUP_MUL_POW] THEN
        ONCE_REWRITE_TAC [MULT_SYM] THEN
        ASM_SIMP_TAC [GROUP_POW_MUL, GROUP_MUL, GROUP_POW_ELEMENT_ORDER] THEN
        REWRITE_TAC [GROUP_POW_ID]]))

  let GROUP_ELEMENT_ORDER_EQ_MUL_GEN ← prove
   r"!G (x:A) k n.
        x IN group_carrier G /\ ~(k = 0)
        ==> (group_element_order G x = k * n <=>
             k divides group_element_order G x /\
             group_element_order G (group_pow G x k) = n)"
   (← do
     let a2 ← NUM_RING
       (← q r"~(k = 0) /\ x' * k = x ==> (x = k * n <=> x' = n)")
     let a1 ← TAUT
       (← q r"(p ==> q) /\ (q ==> (p <=> r)) ==> (p <=> q /\ r)")
     pure (
      REPEAT STRIP_TAC THEN ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_POW_GEN] THEN
      MATCH_MP_TAC a1 THEN
      CONJ_TAC THENL [CONV_TAC NUMBER_RULE, SIMP_TAC [DIVIDES_GCD_RIGHT]] THEN
      REWRITE_TAC [← GSYM DIVIDES_GCD_RIGHT] THEN DISCH_TAC THEN
      MATCH_MP_TAC a2 THEN
      ASM_SIMP_TAC [← GSYM DIVIDES_DIV_MULT]))

  let GROUP_ELEMENT_ORDER_EQ_MUL ← prove
   r"!G (x:A) k n.
        x IN group_carrier G /\ ~(k = 0) /\ k divides n
        ==> (group_element_order G x = k * n <=>
             group_element_order G (group_pow G x k) = n)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_MUL_GEN] THEN
    ASM_MESON_TAC [GROUP_ELEMENT_ORDER_POW_DIVIDES, DIVIDES_TRANS])

  let ABELIAN_GROUP_ELEMENT_ORDER_MUL_EQ ← prove
   r"!G x y:A.
        abelian_group G /\ x IN group_carrier G /\ y IN group_carrier G /\
        coprime(group_element_order G x,group_element_order G y)
        ==> group_element_order G (group_mul G x y) =
            group_element_order G x * group_element_order G y"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ELEMENT_ORDER_MUL_EQ THEN
    ASM_MESON_TAC [abelian_group])

  -- @@RETURN BEGIN
  return { GROUP_ELEMENT_ORDER_POW_GEN, GROUP_ELEMENT_ORDER_MUL_DIVIDES_GEN,
           ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES_GEN,
           GROUP_ELEMENT_ORDER_MUL_DIVIDES_LCM,
           ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES_LCM,
           GROUP_ELEMENT_ORDER_HOMOMORPHIC_IMAGE, GROUP_ELEMENT_ORDER_MONOMORPHIC_IMAGE,
           ISOMORPHIC_GROUP_TORSION, GROUP_ELEMENT_ORDER_CONJUGATION,
           GROUP_ELEMENT_ORDER_MUL_DIVIDES, ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES,
           GROUP_POW_MUL_EQ_ID_SYM, GROUP_ELEMENT_ORDER_MUL_SYM,
           GROUP_ELEMENT_ORDER_UNIQUE_ALT, GROUP_ELEMENT_ORDER_EQ_2,
           GROUP_ELEMENT_ORDER_EQ_2_ALT, GROUP_ELEMENT_ORDER_POW_DIVIDES,
           GROUP_ELEMENT_ORDER_MUL_EQ, GROUP_ELEMENT_ORDER_EQ_MUL_GEN,
           GROUP_ELEMENT_ORDER_EQ_MUL, ABELIAN_GROUP_ELEMENT_ORDER_MUL_EQ }
  -- @@RETURN END

structure OrderDecomp where
  -- @@FIELDS
  GROUP_ELEMENT_ORDER_LCM_EXISTS : thm
  ABELIAN_GROUP_ELEMENT_ORDER_LCM_EXISTS : thm
  ABELIAN_GROUP_ORDER_DIVIDES_MAXIMAL : thm
  ABELIAN_GROUP_ELEMENT_ORDER_DIVIDES_MAXIMAL_ALT : thm
  GROUP_ELEMENT_ORDER_SUBGROUP_GENERATED : thm
  GROUP_ELEMENT_ORDER_PROD_GROUP : thm
  GROUP_ELEMENT_ORDER_PROD_GROUP_ALT : thm
  GROUP_ELEMENT_ORDER_SUM_GROUP : thm
  GROUP_ELEMENT_ORDER_SUM_GROUP_EQ_0 : thm
  GROUP_ELEMENT_ORDER_COPRIME_DECOMP_EXPLICIT : thm
  GROUP_ELEMENT_ORDER_COPRIME_DECOMP_UNIQUE : thm
  GROUP_ELEMENT_ORDER_COPRIME_DECOMP : thm
  GROUP_ELEMENT_ORDER_COPRIME_DECOMP_DIVIDES : thm
  GROUP_POW_EQ_ID_DECOMP : thm
  GROUP_ELEMENT_ORDER_PRIMEPOW_DECOMP : thm
  deriving Inhabited

@[nospecialize]
def setupOrderDecomp [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BGroupRule : GroupRule) (BSubgroupGenerated : SubgroupGenerated) (BProdGroup : ProdGroup) (BSumGroup : SumGroup) (BGroupElementOrder : GroupElementOrder) (BGroupElementOrder2 : GroupElementOrder2) :
    ExceptT String IO OrderDecomp := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INTEGER_TAC, METIS_TAC, NUMBER_RULE, .. } := D
  let { COPRIME_LEXP, DIVIDES_LCM_LEFT, DIVIDES_LE, DIVIDES_REFL, DIV_MULT,
        EXISTS_IN_IMAGE, EXISTS_PAIR_THM, EXISTS_UNIQUE, EXISTS_UNIQUE_THM, .. } := D.core2
  let { FINITE_IMAGE, FINITE_SUBSET, FORALL_IN_IMAGE, FORALL_PAIR_THM, GCD, .. } := D.core3
  let { IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IN, INDEX_DECOMPOSITION, INT_ADD_SYM,
        INT_MUL_ASSOC, .. } := D.core4
  let { INT_OF_NUM_MUL, IN_CARTESIAN_PRODUCT, IN_CROSS, IN_ELIM_THM,
        ITERATE_LCM_DIVIDES_GEN, ITERATE_LCM_EQ_0_GEN, LAMBDA_PAIR, LCM, LCM_0,
        LCM_COPRIME_DECOMP, LCM_ZERO, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, LE_ANTISYM, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS,
        MULT_CLAUSES, MULT_SYM, PAIR_EQ, PRIME_1, PRIME_COPRIME_EQ,
        RESTRICTION_EXTENSION, .. } := D.core6
  let { SUBSET, divides, .. } := D.core7
  let { num_FINITE, num_MAX, num_coprime, num_divides, .. } := D.core8
  let { GROUP_CARRIER_NONEMPTY, GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC,
        GROUP_MUL_LID, .. } := BBasics
  let { GROUP_COMMUTES_INV, GROUP_POW, .. } := BDerived
  let { GROUP_COMMUTES_POW, GROUP_COMMUTES_ZPOW, GROUP_MUL_POW, GROUP_NPOW, GROUP_ZPOW,
        GROUP_ZPOW_1, GROUP_ZPOW_ADD, GROUP_ZPOW_MUL, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { GROUP_RULE, GROUP_TAC, .. } := BGroupRule
  let { GROUP_POW_SUBGROUP_GENERATED, SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { GROUP_POW_PROD_GROUP, PROD_GROUP, .. } := BProdGroup
  let { GROUP_POW_SUM_GROUP, SUM_GROUP_CLAUSES, .. } := BSumGroup
  let { FINITE_GROUP_ELEMENT_ORDER_NONZERO, GROUP_ELEMENT_ORDER_EQ_1,
        GROUP_ELEMENT_ORDER_INV, GROUP_ELEMENT_ORDER_UNIQUE, GROUP_POW_COPRIME_EQ_ID,
        GROUP_POW_EQ_ID, GROUP_ZPOW_EQ_ID, group_element_order, .. } := BGroupElementOrder
  let { GROUP_ELEMENT_ORDER_MUL_EQ, GROUP_ELEMENT_ORDER_POW_GEN, .. } := BGroupElementOrder2
  -- @@SCOPE END

  let GROUP_ELEMENT_ORDER_LCM_EXISTS ← prove
   r"!G x y:A.
          x IN group_carrier G /\ y IN group_carrier G /\
          group_mul G x y = group_mul G y x
          ==> ?z. z IN group_carrier G /\
                  group_element_order G z =
                  lcm(group_element_order G x,group_element_order G y)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"group_element_order G (x:A) = 0") THENL
     [ASM_MESON_TAC [LCM_0], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"group_element_order G (y:A) = 0") THENL
     [ASM_MESON_TAC [LCM_0], ALL_TAC] THEN
    MP_TAC (← SPECL [← q r"group_element_order G (x:A)", ← q r"group_element_order G (y:A)"]
          LCM_COPRIME_DECOMP) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
    REWRITE_TAC [divides, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"m':num") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"n':num") THEN DISCH_TAC THEN DISCH_TAC THEN
    DISCH_THEN (fun th => tactic_of do
      pure (SUBST1_TAC (← SYM th) THEN ASSUME_TAC (← SYM th))) THEN
    EXISTS_TAC (← q r"group_mul G (group_pow G x m') (group_pow G y n'):A") THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_POW] THEN
    SUBGOAL_THEN
     (← q r"group_element_order G (group_pow G (x:A) m') = m /\
      group_element_order G (group_pow G (y:A) n') = n")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_POW_GEN] THEN CONJ_TAC THEN
      (COND_CASES_TAC THENL [ASM_MESON_TAC [MULT_CLAUSES], ALL_TAC]) THEN
      REWRITE_TAC [← D.NUMBER_RULE (← q r"gcd(a * b:num,a) = a /\ gcd(a * b,b) = b")] THEN
      ONCE_REWRITE_TAC [MULT_SYM] THEN ASM_SIMP_TAC [DIV_MULT],
      wPart lhand (fun t => do lhand (← rand t)) GROUP_ELEMENT_ORDER_MUL_EQ THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [GROUP_POW] THEN MATCH_MP_TAC GROUP_COMMUTES_POW THEN
      ASM_SIMP_TAC [GROUP_POW] THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC GROUP_COMMUTES_POW THEN ASM_REWRITE_TAC []])

  let ABELIAN_GROUP_ELEMENT_ORDER_LCM_EXISTS ← prove
   r"!G x y:A.
          abelian_group G /\
          x IN group_carrier G /\ y IN group_carrier G
          ==> ?z. z IN group_carrier G /\
                  group_element_order G z =
                  lcm(group_element_order G x,group_element_order G y)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ELEMENT_ORDER_LCM_EXISTS THEN
    ASM_MESON_TAC [abelian_group])

  let ABELIAN_GROUP_ORDER_DIVIDES_MAXIMAL ← prove
   r"!G:A group.
        abelian_group G /\ FINITE(group_carrier G)
        ==> ?x. x IN group_carrier G /\
                !y. y IN group_carrier G
                    ==> group_element_order G y divides group_element_order G x"
   (REPEAT STRIP_TAC THEN MP_TAC ((← EQ_IMP_RULE (← ISPEC
     (← q r"IMAGE (group_element_order G) (group_carrier G:A->bool)") num_MAX)).1) THEN
    REWRITE_TAC [← D.MESON [IN] (← q r"IMAGE f s x <=> x IN IMAGE f s")] THEN
    ASM_SIMP_TAC [← GSYM num_FINITE, FINITE_IMAGE] THEN
    REWRITE_TAC [MEMBER_NOT_EMPTY, IMAGE_EQ_EMPTY, GROUP_CARRIER_NONEMPTY] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, FORALL_IN_IMAGE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:A") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    REWRITE_TAC [DIVIDES_LCM_LEFT] THEN REWRITE_TAC [← GSYM LE_ANTISYM] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [ABELIAN_GROUP_ELEMENT_ORDER_LCM_EXISTS],
      ASM_MESON_TAC [DIVIDES_LE, LCM, FINITE_GROUP_ELEMENT_ORDER_NONZERO,
                    LCM_ZERO]])

  let ABELIAN_GROUP_ELEMENT_ORDER_DIVIDES_MAXIMAL_ALT ← prove
   r"!G:A group.
          abelian_group G /\ FINITE(group_carrier G)
          ==> ?x. x IN group_carrier G /\
                  !y. y IN group_carrier G
                      ==> group_pow G y (group_element_order G x) = group_id G"
   (SIMP_TAC [GROUP_POW_EQ_ID] THEN
    REWRITE_TAC [ABELIAN_GROUP_ORDER_DIVIDES_MAXIMAL])

  let GROUP_ELEMENT_ORDER_SUBGROUP_GENERATED ← prove
   r"!G h x:A.
          group_element_order (subgroup_generated G h) x =
          group_element_order G x"
   (REWRITE_TAC [group_element_order, GROUP_POW_SUBGROUP_GENERATED,
                SUBGROUP_GENERATED])

  let GROUP_ELEMENT_ORDER_PROD_GROUP ← prove
   r"!(G:A group) (H:B group) x y.
          x IN group_carrier G /\ y IN group_carrier H
          ==> group_element_order (prod_group G H) (x,y) =
              lcm(group_element_order G x,group_element_order H y)"
   (SIMP_TAC [GROUP_ELEMENT_ORDER_UNIQUE, PROD_GROUP, IN_CROSS] THEN
    SIMP_TAC [GROUP_POW_PROD_GROUP, PAIR_EQ, GROUP_POW_EQ_ID] THEN
    CONV_TAC NUMBER_RULE)

  let GROUP_ELEMENT_ORDER_PROD_GROUP_ALT ← prove
   r"!(G:A group) (H:B group) z.
          z IN group_carrier(prod_group G H)
          ==> group_element_order (prod_group G H) z =
              lcm(group_element_order G (FST z),group_element_order H (SND z))"
   (REWRITE_TAC [FORALL_PAIR_THM, PROD_GROUP, IN_CROSS] THEN
    REWRITE_TAC [GROUP_ELEMENT_ORDER_PROD_GROUP])

  let GROUP_ELEMENT_ORDER_SUM_GROUP ← prove
   r"!(G:K->A group) k x.
          x IN group_carrier(sum_group k G)
          ==> (group_element_order (sum_group k G) x =
               iterate (\m n. lcm(m,n)) k
                       (\i. group_element_order (G i) (x i)))"
   (SIMP_TAC [GROUP_ELEMENT_ORDER_UNIQUE] THEN
    REWRITE_TAC [GROUP_POW_SUM_GROUP, SUM_GROUP_CLAUSES] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [IN_CARTESIAN_PRODUCT, IN_ELIM_THM] THEN
    STRIP_TAC THEN
    X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [RESTRICTION_EXTENSION] THEN
    ASM_SIMP_TAC [ITERATE_LCM_DIVIDES_GEN, ← GSYM GROUP_POW_EQ_ID] THEN
    MATCH_MP_TAC (← D.TAUT (← q r"q ==> (p <=> q ==> p)")) THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    ASM_SIMP_TAC [← GSYM GROUP_ELEMENT_ORDER_EQ_1])

  let GROUP_ELEMENT_ORDER_SUM_GROUP_EQ_0 ← prove
   r"!G k (x:K->A).
          x IN group_carrier (sum_group k G)
          ==> (group_element_order (sum_group k G) x = 0 <=>
               ?i. i IN k /\ group_element_order (G i) (x i) = 0)"
   (SIMP_TAC [GROUP_ELEMENT_ORDER_SUM_GROUP, ITERATE_LCM_EQ_0_GEN] THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, IN_ELIM_THM, IN_CARTESIAN_PRODUCT] THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC (← D.TAUT (← q
     r"(q ==> r ==> s) ==> (p /\ q) /\ r ==> (s /\ t <=> t)")) THEN
    DISCH_TAC THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
    ASM_SIMP_TAC [SUBSET, ← GSYM GROUP_ELEMENT_ORDER_EQ_1, IN_ELIM_THM])

  let GROUP_ELEMENT_ORDER_COPRIME_DECOMP_EXPLICIT ← prove
   r"!G (x:A) m n.
          coprime(m,n) /\
          x IN group_carrier G /\
          group_element_order G x = m * n
          ==> ?r s. group_element_order G (group_zpow G x r) = m /\
                    group_element_order G (group_zpow G x s) = n /\
                    group_mul G (group_zpow G x r) (group_zpow G x s) = x"
   (REWRITE_TAC [num_coprime] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← D.INTEGER_RULE (← q
      r"!m n:int. coprime(m,n) ==> ?a b. b * n + a * m = &1"))) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:int", ← q r"b:int"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"b * &n:int", ← q r"a * &m:int"] THEN
    ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_UNIQUE, GROUP_ZPOW] THEN
    ASM_SIMP_TAC [← GSYM GROUP_NPOW, ← GSYM GROUP_ZPOW_MUL] THEN
    ASM_SIMP_TAC [← GSYM GROUP_ZPOW_ADD, GROUP_ZPOW_1] THEN
    ASM_SIMP_TAC [GROUP_ZPOW_EQ_ID, ← GSYM INT_MUL_ASSOC] THEN
    REWRITE_TAC [num_divides, ← GSYM INT_OF_NUM_MUL] THEN
    MAP_EVERY UNDISCH_TAC [← q r"b * &n + a * &m:int = &1", ← q r"coprime(&m:int,&n)"] THEN
    INTEGER_TAC)

  let GROUP_ELEMENT_ORDER_COPRIME_DECOMP_UNIQUE ← prove
   r"!G (z:A) m n.
          coprime(m,n) /\
          z IN group_carrier G /\
          group_element_order G z = m * n
          ==> ?!(x,y). x IN group_carrier G /\ y IN group_carrier G /\
                       group_mul G x y = z /\
                       group_mul G y x = z /\
                       group_element_order G x = m /\
                       group_element_order G y = n"
   (← do
      -- counting rules in reverse text order: t4,t3,t2,t1
      let t4 ← D.MESON [GROUP_MUL_LID, GROUP_ID] (← q
         r"x = group_id G /\ y = group_id G ==> group_mul G x y = group_id G")
      let t3 ← GROUP_RULE (← q
         r"group_mul G (group_inv G x') x = group_mul G y' (group_inv G y) <=>
          group_mul G x y = group_mul G x' y'")
      let t2 ← D.MESON [GROUP_POW_COPRIME_EQ_ID] (← q
         r"coprime(m,n) /\ x IN group_carrier G /\ y IN group_carrier G /\ x = y /\
          group_pow G x m = group_id G /\ group_pow G y n = group_id G
          ==> x = group_id G /\ y = group_id G")
      let t1 ← D.TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
      pure (REPEAT GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM
        (MP_TAC o MATCH_MP GROUP_ELEMENT_ORDER_COPRIME_DECOMP_EXPLICIT) THEN
       REWRITE_TAC [LEFT_IMP_EXISTS_THM, EXISTS_UNIQUE, LAMBDA_PAIR] THEN
       MAP_EVERY X_GEN_TAC [← q r"r:int", ← q r"s:int"] THEN STRIP_TAC THEN
       REWRITE_TAC [EXISTS_PAIR_THM, FORALL_PAIR_THM] THEN
       MAP_EVERY EXISTS_TAC [← q r"group_zpow G (z:A) r", ← q r"group_zpow G (z:A) s"] THEN
       ASM_SIMP_TAC [GROUP_ZPOW, PAIR_EQ] THEN
       MATCH_MP_TAC t1 THEN CONJ_TAC THENL
        [ASM_MESON_TAC [GROUP_ZPOW_ADD, INT_ADD_SYM], DISCH_TAC] THEN
       MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
       SUBGOAL_THEN
        (← q r"group_mul G (group_inv G x:A) (group_zpow G z r) = group_id G /\
         group_mul G y (group_inv G (group_zpow G z s)) = group_id G")
       MP_TAC THENL
        [MATCH_MP_TAC t2,
         MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
         GROUP_TAC THEN ASM_SIMP_TAC [GROUP_ZPOW]] THEN
       ASM_SIMP_TAC [GROUP_MUL, GROUP_INV, GROUP_ZPOW, t3] THEN
       CONJ_TAC THEN
       (wPart lhand (fun t => do lhand (← rand t)) GROUP_MUL_POW THEN
        ANTS_TAC THENL
         [ASM_MESON_TAC [GROUP_COMMUTES_ZPOW, GROUP_COMMUTES_INV, GROUP_INV,
                        GROUP_ZPOW, GROUP_MUL_ASSOC],
          DISCH_THEN SUBST1_TAC THEN
          MATCH_MP_TAC t4 THEN
          ASM_SIMP_TAC [GROUP_POW_EQ_ID, GROUP_ZPOW, GROUP_INV,
                       GROUP_ELEMENT_ORDER_INV, DIVIDES_REFL]])))

  let GROUP_ELEMENT_ORDER_COPRIME_DECOMP ← prove
   r"!G (z:A) m n.
          coprime(m,n) /\
          z IN group_carrier G /\
          group_element_order G z = m * n
          ==> ?x y. x IN group_carrier G /\ y IN group_carrier G /\
                    group_mul G x y = z /\
                    group_mul G y x = z /\
                    group_element_order G x = m /\
                    group_element_order G y = n"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP GROUP_ELEMENT_ORDER_COPRIME_DECOMP_UNIQUE) THEN
    REWRITE_TAC [EXISTS_UNIQUE_THM, LAMBDA_PAIR] THEN
    DISCH_THEN (MP_TAC o CONJUNCT1) THEN REWRITE_TAC [EXISTS_PAIR_THM])

  let GROUP_ELEMENT_ORDER_COPRIME_DECOMP_DIVIDES ← prove
   r"!G (z:A) m n.
          coprime(m,n) /\
          z IN group_carrier G /\
          group_element_order G z divides m * n
          ==> ?x y. x IN group_carrier G /\ y IN group_carrier G /\
                    group_mul G x y = z /\
                    group_mul G y x = z /\
                    group_element_order G x divides m /\
                    group_element_order G y divides n"
   (← do
      let a2 ← D.NUMBER_RULE (← q
         r"coprime(m:num,n) /\ d divides m * n ==> gcd(d,m) * gcd(d,n) = d")
      let a1 ← D.NUMBER_RULE (← q
         r"coprime(m:num,n) ==> coprime(gcd(d,m),gcd(d,n))")
      pure (REPEAT STRIP_TAC THEN
       MP_TAC (← ISPECL [← q r"G:A group", ← q r"z:A",
         ← q r"gcd(group_element_order G (z:A),m)",
         ← q r"gcd(group_element_order G (z:A),n)"]
        GROUP_ELEMENT_ORDER_COPRIME_DECOMP) THEN
       ASM_SIMP_TAC [a1] THEN
       ASM_SIMP_TAC [a2] THEN
       REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
       STRIP_TAC THEN ASM_REWRITE_TAC [GCD]))

  let GROUP_POW_EQ_ID_DECOMP ← prove
   r"!G (z:A) m n.
          coprime(m,n) /\
          z IN group_carrier G /\
          group_pow G z (m * n) = group_id G
          ==> ?x y. x IN group_carrier G /\ y IN group_carrier G /\
                    group_mul G x y = z /\
                    group_mul G y x = z /\
                    group_pow G x m = group_id G /\
                    group_pow G y n = group_id G"
   (METIS_TAC [GROUP_ELEMENT_ORDER_COPRIME_DECOMP_DIVIDES, GROUP_POW_EQ_ID])

  let GROUP_ELEMENT_ORDER_PRIMEPOW_DECOMP ← prove
   r"!G (z:A) p.
          prime p /\
          z IN group_carrier G /\
          ~(group_element_order G z = 0)
          ==> ?x y. x IN group_carrier G /\ y IN group_carrier G /\
                    group_mul G x y = z /\
                    group_mul G y x = z /\
                    (?k. group_element_order G x = p EXP k) /\
                    coprime(p,group_element_order G y)"
   (← do
      let a1 ← D.MESON [PRIME_1] (← q r"prime p ==> ~(p = 1)")
      pure (REPEAT STRIP_TAC THEN
       MP_TAC (← SPECL [← q r"group_element_order G (z:A)", ← q r"p:num"]
         INDEX_DECOMPOSITION) THEN
       ABBREV_TAC (← q r"k = index p (group_element_order G (z:A))") THEN
       ASM_SIMP_TAC [a1] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
       MP_TAC (← ISPECL [← q r"G:A group", ← q r"z:A", ← q r"p EXP k", ← q r"n:num"]
             GROUP_ELEMENT_ORDER_COPRIME_DECOMP) THEN
       ASM_REWRITE_TAC [COPRIME_LEXP] THEN ASM_MESON_TAC [PRIME_COPRIME_EQ]))

  -- @@RETURN BEGIN
  return { GROUP_ELEMENT_ORDER_LCM_EXISTS, ABELIAN_GROUP_ELEMENT_ORDER_LCM_EXISTS,
           ABELIAN_GROUP_ORDER_DIVIDES_MAXIMAL,
           ABELIAN_GROUP_ELEMENT_ORDER_DIVIDES_MAXIMAL_ALT,
           GROUP_ELEMENT_ORDER_SUBGROUP_GENERATED, GROUP_ELEMENT_ORDER_PROD_GROUP,
           GROUP_ELEMENT_ORDER_PROD_GROUP_ALT, GROUP_ELEMENT_ORDER_SUM_GROUP,
           GROUP_ELEMENT_ORDER_SUM_GROUP_EQ_0,
           GROUP_ELEMENT_ORDER_COPRIME_DECOMP_EXPLICIT,
           GROUP_ELEMENT_ORDER_COPRIME_DECOMP_UNIQUE, GROUP_ELEMENT_ORDER_COPRIME_DECOMP,
           GROUP_ELEMENT_ORDER_COPRIME_DECOMP_DIVIDES, GROUP_POW_EQ_ID_DECOMP,
           GROUP_ELEMENT_ORDER_PRIMEPOW_DECOMP }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Torsion subgroups in various generalized forms are indeed subgroups.      -/
/- ------------------------------------------------------------------------- -/

structure TorsionSubgroups where
  -- @@FIELDS
  SUBGROUP_OF_TORSION_GENERAL : thm
  SUBGROUP_OF_TORSION_GEN : thm
  SUBGROUP_OF_TORSION : thm
  SUBGROUP_OF_PRIMES_TORSION : thm
  SUBGROUP_OF_PRIME_TORSION : thm
  SUBGROUP_OF_LOWER_ORDER : thm
  SUBGROUP_OF_LOWER_ORDER_ALT : thm
  SUBGROUP_OF_NONDIVISIBLE_ORDER : thm
  SUBGROUP_OF_COPRIME_ORDER : thm
  TORSION_FREE_GROUP : thm
  TORSION_FREE_GROUP_ALT : thm
  QUOTIENT_GROUP_POW_EQ_ID : thm
  TORSION_FREE_QUOTIENT_GROUP : thm
  IMAGE_GROUP_CONJUGATION_TORSION_GEN : thm
  NORMAL_SUBGROUP_OF_TORSION_GEN : thm
  NORMAL_SUBGROUP_OF_TORSION : thm
  deriving Inhabited

@[nospecialize]
def setupTorsionSubgroups [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BCosets : Cosets) (BNormalSubgroups : NormalSubgroups) (BQuotientGroups : QuotientGroups) (BGroupElementOrder : GroupElementOrder) (BGroupElementOrder2 : GroupElementOrder2) :
    ExceptT String IO TorsionSubgroups := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, NUMBER_RULE, .. } := D
  let { ARITH_EQ, .. } := D.core1
  let { DE_MORGAN_THM, DIVIDES_ONE, DIVIDES_TRANS, EQ_IMP, .. } := D.core2
  let { EXTENSION, FORALL_IN_GSPEC, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, .. } := D.core4
  let { IN_ELIM_THM, LCM_DIVIDES, LCM_DIVIDES_MUL, .. } := D.core5
  let { MULT_EQ_0, PRIME_1, PRIME_DIVPROD, PRIME_DIVPROD_EQ, PRIME_POWER_EXISTS, .. } := D.core6
  let { SUBSET, .. } := D.core7
  let { GROUP_ID, GROUP_INV, GROUP_MUL, .. } := BBasics
  let { GROUP_POW, GROUP_POW_POW, .. } := BDerived
  let { GROUP_CONJUGATION, GROUP_CONJUGATION_LINV, GROUP_CONJUGATION_RINV, .. } := BConjugation
  let { subgroup_of, .. } := BSubgroups
  let { RIGHT_COSET_EQ_SUBGROUP, .. } := BCosets
  let { ABELIAN_GROUP_NORMAL_SUBGROUP, NORMAL_SUBGROUP_CONJUGATION_EQ,
        NORMAL_SUBGROUP_IMP_SUBGROUP, .. } := BNormalSubgroups
  let { QUOTIENT_GROUP, QUOTIENT_GROUP_POW, .. } := BQuotientGroups
  let { GROUP_ELEMENT_ORDER_EQ_0, GROUP_ELEMENT_ORDER_EQ_1, GROUP_ELEMENT_ORDER_ID,
        GROUP_ELEMENT_ORDER_INV, GROUP_POW_EQ_ID, .. } := BGroupElementOrder
  let { ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES_LCM, GROUP_ELEMENT_ORDER_CONJUGATION, .. } := BGroupElementOrder2
  -- @@SCOPE END

  let SUBGROUP_OF_TORSION_GENERAL ← prove
   r"!P G:A group.
          abelian_group G /\
          P 1 /\ (!m n p. p divides lcm(m,n) /\ P m /\ P n ==> P p)
          ==> {x | x IN group_carrier G /\ P(group_element_order G x)}
              subgroup_of G"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [subgroup_of, SUBSET, IN_ELIM_THM] THEN
    SIMP_TAC [GROUP_ELEMENT_ORDER_ID, GROUP_ID, GROUP_INV, GROUP_MUL] THEN
    ASM_SIMP_TAC [ARITH_EQ, GROUP_ELEMENT_ORDER_INV] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT, ← GSYM DE_MORGAN_THM] THEN FIRST_X_ASSUM
     (MATCH_MP_TAC o ONCE_REWRITE_RULE [IMP_CONJ]) THEN
    ASM_SIMP_TAC [ABELIAN_GROUP_ELEMENT_ORDER_MUL_DIVIDES_LCM])

  let SUBGROUP_OF_TORSION_GEN ← prove
   r"!P G:A group.
          abelian_group G /\
          P 1 /\ (!m n p. p divides m * n /\ P m /\ P n ==> P p)
          ==> {x | x IN group_carrier G /\ P(group_element_order G x)}
              subgroup_of G"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBGROUP_OF_TORSION_GENERAL THEN
    ASM_REWRITE_TAC [] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN FIRST_X_ASSUM
     (MATCH_MP_TAC o ONCE_REWRITE_RULE [IMP_CONJ]) THEN
    ASM_MESON_TAC [LCM_DIVIDES_MUL, DIVIDES_TRANS])

  let SUBGROUP_OF_TORSION ← prove
   r"!G:A group.
          abelian_group G
          ==> {x | x IN group_carrier G /\ ~(group_element_order G x = 0)}
              subgroup_of G"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBGROUP_OF_TORSION_GEN THEN
    ASM_REWRITE_TAC [ARITH_EQ] THEN CONV_TAC NUMBER_RULE)

  let SUBGROUP_OF_PRIMES_TORSION ← prove
   r"!(G:A group) Q.
          abelian_group G
          ==> {x | x IN group_carrier G /\
                   !p. prime p /\ p divides group_element_order G x
                       ==> Q p}
              subgroup_of G"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBGROUP_OF_TORSION_GEN THEN
    ASM_MESON_TAC [DIVIDES_TRANS, PRIME_DIVPROD, DIVIDES_ONE, PRIME_1])

  let SUBGROUP_OF_PRIME_TORSION ← prove
   r"!(G:A group) p.
          abelian_group G /\ prime p
          ==> {x | x IN group_carrier G /\ ?k. group_element_order G x = p EXP k}
              subgroup_of G"
   (SIMP_TAC [PRIME_POWER_EXISTS, SUBGROUP_OF_PRIMES_TORSION])

  let SUBGROUP_OF_LOWER_ORDER ← prove
   r"!(G:A group) n.
          abelian_group G
          ==> {x | x IN group_carrier G /\ group_element_order G x divides n}
              subgroup_of G"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBGROUP_OF_TORSION_GENERAL THEN
    ASM_REWRITE_TAC [← GSYM LCM_DIVIDES, DIVIDES_TRANS] THEN CONV_TAC NUMBER_RULE)

  let SUBGROUP_OF_LOWER_ORDER_ALT ← prove
   r"!(G:A group) n.
          abelian_group G
          ==> {x | x IN group_carrier G /\ group_pow G x n = group_id G}
              subgroup_of G"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"n:num") o MATCH_MP SUBGROUP_OF_LOWER_ORDER) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN ASM_MESON_TAC [GROUP_POW_EQ_ID])

  let SUBGROUP_OF_NONDIVISIBLE_ORDER ← prove
   r"!(G:A group) p.
          abelian_group G /\ prime p
          ==> {x | x IN group_carrier G /\
                   ~(p divides group_element_order G x)}
              subgroup_of G"
   (← do
      let a1 ← D.MESON [PRIME_1] (← q r"prime p ==> ~(p = 1)")
      pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBGROUP_OF_TORSION_GEN THEN
       ASM_SIMP_TAC [DIVIDES_ONE, a1] THEN
       ASM_MESON_TAC [PRIME_DIVPROD_EQ, DIVIDES_TRANS]))

  let SUBGROUP_OF_COPRIME_ORDER ← prove
   r"!(G:A group) n.
          abelian_group G
          ==> {x | x IN group_carrier G /\
                   coprime(n,group_element_order G x)}
              subgroup_of G"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBGROUP_OF_TORSION_GEN THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC NUMBER_RULE)

  let TORSION_FREE_GROUP ← prove
   r"!G:A group.
          (!x. x IN group_carrier G ==> group_element_order G x <= 1) <=>
          (!x. x IN group_carrier G /\ ~(x = group_id G)
               ==> group_element_order G x = 0)"
   (← do
      let a1 ← D.ARITH_RULE (← q r"n <= 1 <=> n = 0 \/ n = 1")
      pure (REWRITE_TAC [a1] THEN
       SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_1] THEN MESON_TAC []))

  let TORSION_FREE_GROUP_ALT ← prove
   r"!G:A group.
          (!x. x IN group_carrier G ==> group_element_order G x <= 1) <=>
          (!x n. x IN group_carrier G /\ group_pow G x n = group_id G
                 ==> x = group_id G \/ n = 0)"
   (SIMP_TAC [TORSION_FREE_GROUP, GROUP_ELEMENT_ORDER_EQ_0] THEN MESON_TAC [])

  let QUOTIENT_GROUP_POW_EQ_ID ← prove
   r"!(G:A group) n x k.
          n normal_subgroup_of G /\ x IN group_carrier G
          ==> (group_pow (quotient_group G n) (right_coset G n x) k =
               group_id (quotient_group G n) <=>
               group_pow G x k IN n)"
   (SIMP_TAC [QUOTIENT_GROUP_POW, QUOTIENT_GROUP] THEN
    SIMP_TAC [RIGHT_COSET_EQ_SUBGROUP, GROUP_POW, NORMAL_SUBGROUP_IMP_SUBGROUP])

  let TORSION_FREE_QUOTIENT_GROUP ← prove
   r"!(G:A group) H.
          abelian_group G /\
          quotient_group
            G {x | x IN group_carrier G /\ ~(group_element_order G x = 0)} = H
          ==> !x. x IN group_carrier H ==> group_element_order H x <= 1"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [TORSION_FREE_GROUP] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_0] THEN
    ASM_SIMP_TAC [QUOTIENT_GROUP_POW, QUOTIENT_GROUP, FORALL_IN_GSPEC,
                 ABELIAN_GROUP_NORMAL_SUBGROUP, SUBGROUP_OF_TORSION,
                 RIGHT_COSET_EQ_SUBGROUP, GROUP_POW] THEN
    SIMP_TAC [IN_ELIM_THM, GROUP_POW, GROUP_ELEMENT_ORDER_EQ_0] THEN
    SIMP_TAC [GROUP_POW_POW] THEN MESON_TAC [MULT_EQ_0])

  let IMAGE_GROUP_CONJUGATION_TORSION_GEN ← prove
   r"!G P a:A.
          a IN group_carrier G
          ==> IMAGE (group_conjugation G a)
                    {x | x IN group_carrier G /\ P(group_element_order G x)} =
              {x | x IN group_carrier G /\ P(group_element_order G x)}"
   (← do
      let a1 ← D.SET_RULE (← q
         r"!g. (!x. x IN s ==> f x IN s /\ g(f x) = x) /\
          (!x. x IN s ==> g x IN s /\ f(g x) = x)
          ==> IMAGE f s = s")
      pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC a1 THEN
       EXISTS_TAC (← q r"group_conjugation G (group_inv G a:A)") THEN
       ASM_SIMP_TAC [IN_ELIM_THM, GROUP_ELEMENT_ORDER_CONJUGATION, GROUP_CONJUGATION,
                    GROUP_CONJUGATION_LINV, GROUP_CONJUGATION_RINV, GROUP_INV]))

  let NORMAL_SUBGROUP_OF_TORSION_GEN ← prove
   r"!P G:A group.
          {x | x IN group_carrier G /\ P(group_element_order G x)}
          normal_subgroup_of G <=>
          {x | x IN group_carrier G /\ P(group_element_order G x)}
          subgroup_of G"
   (GEN_TAC THEN REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION_EQ] THEN
    ASM_SIMP_TAC [IMAGE_GROUP_CONJUGATION_TORSION_GEN])

  let NORMAL_SUBGROUP_OF_TORSION ← prove
   r"!G:A group.
          {x | x IN group_carrier G /\ ~(group_element_order G x = 0)}
          normal_subgroup_of G <=>
          {x | x IN group_carrier G /\ ~(group_element_order G x = 0)}
          subgroup_of G"
   (REWRITE_TAC [NORMAL_SUBGROUP_OF_TORSION_GEN])

  -- @@RETURN BEGIN
  return { SUBGROUP_OF_TORSION_GENERAL, SUBGROUP_OF_TORSION_GEN, SUBGROUP_OF_TORSION,
           SUBGROUP_OF_PRIMES_TORSION, SUBGROUP_OF_PRIME_TORSION,
           SUBGROUP_OF_LOWER_ORDER, SUBGROUP_OF_LOWER_ORDER_ALT,
           SUBGROUP_OF_NONDIVISIBLE_ORDER, SUBGROUP_OF_COPRIME_ORDER, TORSION_FREE_GROUP,
           TORSION_FREE_GROUP_ALT, QUOTIENT_GROUP_POW_EQ_ID, TORSION_FREE_QUOTIENT_GROUP,
           IMAGE_GROUP_CONJUGATION_TORSION_GEN, NORMAL_SUBGROUP_OF_TORSION_GEN,
           NORMAL_SUBGROUP_OF_TORSION }
  -- @@RETURN END

/-- Turn a 4-element list of theorems into a tuple (cf. list6 in
    HolLibrary/Matroids.lean), so each `let [A;B;C;D] = ...` element becomes a
    bundle field. -/
def list4 (l : List thm) : ExceptT String IO (thm × thm × thm × thm) :=
  match l with
  | [a, b, c, d] => pure (a, b, c, d)
  | _ => throw "Match_failure"

/- ------------------------------------------------------------------------- -/
/- Cyclic groups.                                                            -/
/- ------------------------------------------------------------------------- -/

structure CyclicGroups1 where
  -- @@FIELDS
  SUBGROUP_OF_POWERS : thm
  CARRIER_SUBGROUP_GENERATED_BY_SING : thm
  cyclic_group : thm
  CYCLIC_GROUP : thm
  CYCLIC_IMP_ABELIAN_GROUP : thm
  TRIVIAL_IMP_CYCLIC_GROUP : thm
  CYCLIC_GROUP_ALT : thm
  CYCLIC_GROUP_GENERATED : thm
  CYCLIC_GROUP_EPIMORPHIC_IMAGE : thm
  ISOMORPHIC_GROUP_CYCLICITY : thm
  SUBGROUP_OF_CYCLIC_GROUP_EXPLICIT : thm
  SUBGROUP_OF_CYCLIC_GROUP : thm
  CYCLIC_GROUP_QUOTIENT_GROUP : thm
  NO_PROPER_SUBGROUPS_IMP_CYCLIC : thm
  deriving Inhabited

@[nospecialize]
def setupCyclicGroups1 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BNormalSubgroups : NormalSubgroups) (BQuotientGroups : QuotientGroups) :
    ExceptT String IO CyclicGroups1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, INT_ARITH, MESON, MESON_TAC, SET_RULE, SET_TAC,
        TAUT, new_definition, .. } := D
  let { FORALL_IN_GSPEC, .. } := D.core3
  let { IMP_CONJ, INT_ABS, INT_ABS_NUM, INT_ABS_NZ, INT_ABS_POS, INT_ADD_RID,
        INT_ADD_SYM, INT_DIVISION, INT_FORALL_POS, INT_IMAGE, INT_MUL_LZERO,
        INT_MUL_SYM, .. } := D.core4
  let { INT_OF_NUM_EQ, INT_OF_NUM_LT, INT_OF_NUM_OF_INT, IN_ELIM_THM, IN_SING, IN_UNIV, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, LT_NZ, MONO_EXISTS, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ,
        SUBSET_REFL, .. } := D.core7
  let { num_WOP, .. } := D.core8
  let { GROUPS_EQ, GROUP_ID, TRIVIAL_GROUP_SUBSET, trivial_group, .. } := BBasics
  let { group_pow, .. } := BDerived
  let { GROUP_NPOW, GROUP_ZPOW, GROUP_ZPOW_0, GROUP_ZPOW_1, GROUP_ZPOW_ADD,
        GROUP_ZPOW_MUL, GROUP_ZPOW_NEG, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { subgroup_of, .. } := BSubgroups
  let { GROUP_ZPOW_SUBGROUP_GENERATED, SUBGROUP_GENERATED, SUBGROUP_GENERATED_MINIMAL,
        SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_GROUP_CARRIER,
        SUBGROUP_GENERATED_INC, SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET,
        SUBGROUP_OF_SUBGROUP_GENERATED_REV, TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGen1
  let { SUBGROUP_GENERATED_IDEMPOT, .. } := BSubgroupGen2
  let { group_epimorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_ZPOW, .. } := BHomomorphisms1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { ISOMORPHIC_GROUP_SYM, isomorphic_group, .. } := BIso1
  let { ABELIAN_GROUP_NORMAL_SUBGROUP, .. } := BNormalSubgroups
  let { GROUP_EPIMORPHISM_RIGHT_COSET, .. } := BQuotientGroups
  -- @@SCOPE END

  let SUBGROUP_OF_POWERS ← prove
   r"!G (x:A).
        x IN group_carrier G ==> {group_zpow G x n | n IN (:int)} subgroup_of G"
   (REWRITE_TAC [subgroup_of, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_UNIV] THEN
    SIMP_TAC [GROUP_ZPOW, ← GSYM GROUP_ZPOW_ADD, ← GSYM GROUP_ZPOW_NEG] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [GROUP_NPOW, group_pow])

  let CARRIER_SUBGROUP_GENERATED_BY_SING ← prove
   r"!G x:A.
        x IN group_carrier G
        ==> group_carrier(subgroup_generated G {x}) =
            {group_zpow G x n | n IN (:int)}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN
      ASM_SIMP_TAC [SUBGROUP_OF_POWERS, SING_SUBSET, IN_ELIM_THM] THEN
      ASM_MESON_TAC [GROUP_ZPOW_1, IN_UNIV],
      MP_TAC (← ISPECL [← q "G:A group", ← q r"{x:A}"] SUBGROUP_SUBGROUP_GENERATED) THEN
      REWRITE_TAC [subgroup_of, SUBSET, FORALL_IN_GSPEC, IN_UNIV] THEN
      STRIP_TAC THEN X_GEN_TAC (← q "n:int") THEN
      DISJ_CASES_THEN MP_TAC (← SPEC (← q "n:int") INT_IMAGE) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "m:num") SUBST1_TAC) THEN
      ASM_SIMP_TAC [GROUP_ZPOW_NEG, GROUP_NPOW] THEN
      TRY (FIRST_X_ASSUM MATCH_MP_TAC) THEN SPEC_TAC (← q "m:num", ← q "m:num") THEN
      INDUCT_TAC THEN ASM_SIMP_TAC [group_pow] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM SING_SUBSET] THEN
      MATCH_MP_TAC SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET THEN
      ASM_REWRITE_TAC [SING_SUBSET]])

  let cyclic_group ← new_definition
   r"cyclic_group G <=>
        ?x. x IN group_carrier G /\ subgroup_generated G {x} = G"

  let CYCLIC_GROUP ← prove
   r"!G:A group.
        cyclic_group G <=>
        ?x. x IN group_carrier G /\
            group_carrier G = {group_zpow G x n | n IN (:int)}"
   (← do
    let m1 ← MESON []
     (← q r"(!x. P x ==> (Q x <=> R x))
    ==> ((?x. P x /\ Q x) <=> (?x. P x /\ R x))")
    pure (GEN_TAC THEN REWRITE_TAC [cyclic_group] THEN MATCH_MP_TAC m1 THEN
    SIMP_TAC [← GSYM CARRIER_SUBGROUP_GENERATED_BY_SING] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN MESON_TAC []))

  let CYCLIC_IMP_ABELIAN_GROUP ← prove
   r"!G:A group. cyclic_group G ==> abelian_group G"
   (SIMP_TAC [CYCLIC_GROUP, abelian_group, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    SIMP_TAC [← GSYM GROUP_ZPOW_ADD] THEN REWRITE_TAC [INT_ADD_SYM])

  let TRIVIAL_IMP_CYCLIC_GROUP ← prove
   r"!G:A group. trivial_group G ==> cyclic_group G"
   (REWRITE_TAC [trivial_group, cyclic_group] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q "group_id G:A") THEN
    ASM_MESON_TAC [SUBGROUP_GENERATED_GROUP_CARRIER, GROUP_ID])

  let CYCLIC_GROUP_ALT ← prove
   r"!G:A group. cyclic_group G <=> ?x. subgroup_generated G {x} = G"
   (GEN_TAC THEN EQ_TAC THENL [MESON_TAC [cyclic_group], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "a:A") MP_TAC) THEN
    ASM_CASES_TAC (← q r"(a:A) IN group_carrier G") THENL
     [ASM_MESON_TAC [cyclic_group], ALL_TAC] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC TRIVIAL_IMP_CYCLIC_GROUP THEN
    REWRITE_TAC [TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ] THEN
    ASM SET_TAC [])

  let CYCLIC_GROUP_GENERATED ← prove
   r"!G x:A. cyclic_group(subgroup_generated G {x})"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CYCLIC_GROUP_ALT] THEN
    EXISTS_TAC (← q "x:A") THEN
    REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    SIMP_TAC [SUBGROUP_GENERATED_IDEMPOT, SUBSET_REFL])

  let CYCLIC_GROUP_EPIMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
        group_epimorphism(G,H) f /\ cyclic_group G ==> cyclic_group H"
   (← do
    let s1 ← SET_RULE
     (← q r"t = IMAGE f s ==> !x. x IN s ==> f x IN t")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [group_epimorphism] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (STRIP_ASSUME_TAC o GSYM) MP_TAC) THEN
    REWRITE_TAC [CYCLIC_GROUP] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "x:A") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(f:A->B) x") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP s1) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (ASM_SIMP_TAC [← GSYM (← MATCH_MP GROUP_HOMOMORPHISM_ZPOW th)])) THEN
    SET_TAC []))

  let ISOMORPHIC_GROUP_CYCLICITY ← prove
   r"!(G:A group) (H:B group).
        G isomorphic_group H ==> (cyclic_group G <=> cyclic_group H)"
   (← do
    let r1 ← REWRITE_RULE [IMP_CONJ] CYCLIC_GROUP_EPIMORPHIC_IMAGE
    pure (REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC r1 THEN
    ASM_MESON_TAC [isomorphic_group, ISOMORPHIC_GROUP_SYM,
                  GROUP_MONOMORPHISM_EPIMORPHISM]))

  let SUBGROUP_OF_CYCLIC_GROUP_EXPLICIT ← prove
   r"!G h x:A.
        x IN group_carrier G /\ h subgroup_of (subgroup_generated G {x})
        ==> ?k. h = {group_zpow G x (&k * n) | n IN (:int)}"
   (← do
    let a8 ← INT_ARITH (← q r"&m:int = --(&k * q) + (q * &k + &m)")
    let t7 ← TAUT (← q r"p ==> ~p ==> q")
    let t6 ← TAUT (← q r"p /\ q /\ r ==> s <=> q ==> r /\ p ==> s")
    let s5 ← SET_RULE
     (← q r"h SUBSET {f x | x IN s} ==> (!x. f x IN h ==> P(f x))
   ==> !y. y IN h ==> P y")
    let t4 ← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")
    let t3 ← TAUT (← q r"(p ==> ~(q /\ r)) <=> q /\ p ==> ~r")
    let s2 ← SET_RULE
     (← q r"h SUBSET {f x | x IN (:int)} ==> ~(h SUBSET {f(&0)})
      ==> ?n. ~(n = &0) /\ f n IN h")
    let s1 ← SET_RULE (← q r"{a |x| x IN UNIV} = {a}")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    ASM_CASES_TAC (← q r"(h:A->bool) subgroup_of G") THENL
     [ALL_TAC, ASM_MESON_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_REV]] THEN
    SIMP_TAC [subgroup_of, CARRIER_SUBGROUP_GENERATED_BY_SING] THEN
    REWRITE_TAC [SUBGROUP_GENERATED] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"h SUBSET {group_zpow G (x:A) (&0)}") THENL
     [EXISTS_TAC (← q "0") THEN
      ASM_REWRITE_TAC [INT_MUL_LZERO, ← GSYM SUBSET_ANTISYM_EQ, s1] THEN
      ASM_REWRITE_TAC [GROUP_ZPOW_0, SING_SUBSET],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?n. 0 < n /\ group_pow G (x:A) n IN h") MP_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP s2) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "n:int") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"num_of_int(abs n)") THEN
      REWRITE_TAC [← GSYM GROUP_NPOW, ← GSYM INT_OF_NUM_LT] THEN
      SIMP_TAC [INT_OF_NUM_OF_INT, INT_ABS_POS] THEN
      ASM_REWRITE_TAC [← GSYM INT_ABS_NZ] THEN REWRITE_TAC [INT_ABS] THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [GROUP_ZPOW_NEG],
      GEN_REWRITE_TAC LAND_CONV [num_WOP]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "k:num") THEN
    REWRITE_TAC [t3] THEN
    STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
    MATCH_MP_TAC t4 THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"subgroup_generated G (h:A->bool)", ← q r"group_pow G x k:A"]
          GROUP_ZPOW) THEN
      REWRITE_TAC [GROUP_ZPOW_SUBGROUP_GENERATED] THEN
      ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
      ASM_SIMP_TAC [GROUP_ZPOW_MUL, GROUP_NPOW],
      DISCH_THEN (LABEL_TAC "*")] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP s5) THEN
    X_GEN_TAC (← q "m:int") THEN DISCH_THEN (fun th => tactic_of do
      pure (EXISTS_TAC (← q r"m div (&k)") THEN MP_TAC th)) THEN
    ONCE_REWRITE_TAC [INT_MUL_SYM] THEN
    MP_TAC (← SPECL [← q "m:int", ← q r"&k:int"] INT_DIVISION) THEN
    ASM_REWRITE_TAC [INT_OF_NUM_EQ, ← GSYM LT_NZ, INT_ABS_NUM] THEN
    SPEC_TAC (← q r"m div &k", ← q "q:int") THEN
    SPEC_TAC (← q r"m rem &k", ← q "r:int") THEN ONCE_REWRITE_TAC [t6] THEN
    REWRITE_TAC [← GSYM INT_FORALL_POS, RIGHT_FORALL_IMP_THM] THEN
    MAP_EVERY X_GEN_TAC [← q "m:num", ← q "q:int"] THEN
    REWRITE_TAC [INT_OF_NUM_LT] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC) THEN
    ASM_CASES_TAC (← q "m = 0") THEN ASM_REWRITE_TAC [INT_ADD_RID] THEN
    DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q "m:num")) THEN ASM_REWRITE_TAC [LT_NZ] THEN
    MATCH_MP_TAC t7 THEN REWRITE_TAC [← GSYM GROUP_NPOW] THEN
    SUBST1_TAC a8 THEN
    wPart lhand (fun t => do lhand (← rand t)) GROUP_ZPOW_ADD THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [GROUP_ZPOW_NEG]))

  let SUBGROUP_OF_CYCLIC_GROUP ← prove
   r"!G h:A->bool.
        cyclic_group G /\ h subgroup_of G
        ==> cyclic_group(subgroup_generated G h)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CYCLIC_GROUP] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [cyclic_group]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "x:A") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"h:A->bool", ← q "x:A"]
     SUBGROUP_OF_CYCLIC_GROUP_EXPLICIT) THEN
    ASM_REWRITE_TAC [GROUP_ZPOW_SUBGROUP_GENERATED] THEN
    ASM_SIMP_TAC [GROUP_ZPOW_MUL] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q "k:num")) THEN
    EXISTS_TAC (← q r"group_zpow G x (&k):A") THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"&1:int") THEN
    ASM_SIMP_TAC [IN_UNIV, GROUP_ZPOW_1, GROUP_ZPOW])

  let CYCLIC_GROUP_QUOTIENT_GROUP ← prove
   r"!G n:A->bool.
     cyclic_group G /\ n subgroup_of G ==> cyclic_group(quotient_group G n)"
   (MESON_TAC [CYCLIC_IMP_ABELIAN_GROUP, CYCLIC_GROUP_EPIMORPHIC_IMAGE,
              GROUP_EPIMORPHISM_RIGHT_COSET, ABELIAN_GROUP_NORMAL_SUBGROUP])

  let NO_PROPER_SUBGROUPS_IMP_CYCLIC ← prove
   r"!G:A group.
        (!h. h subgroup_of G ==> h SUBSET {group_id G} \/ h = group_carrier G)
        ==> cyclic_group G"
   (← do
    let t2 ← TAUT (← q r"~p ==> p \/ q ==> q")
    let s1 ← SET_RULE (← q r"~(s SUBSET {a}) <=> ?x. x IN s /\ ~(x = a)")
    pure (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"trivial_group(G:A group)") THEN
    ASM_SIMP_TAC [TRIVIAL_IMP_CYCLIC_GROUP] THEN FIRST_X_ASSUM
     (MP_TAC o GEN_REWRITE_RULE RAND_CONV [TRIVIAL_GROUP_SUBSET]) THEN
    REWRITE_TAC [s1] THEN
    REWRITE_TAC [cyclic_group] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q "a:A") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"group_carrier (subgroup_generated G {a:A})")) THEN
    REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC t2 THEN
    REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q "a:A")) THEN
    ASM_SIMP_TAC [IN_SING, SUBGROUP_GENERATED_INC, IN_SING, SING_SUBSET]))

  -- @@RETURN BEGIN
  return { SUBGROUP_OF_POWERS, CARRIER_SUBGROUP_GENERATED_BY_SING, cyclic_group,
           CYCLIC_GROUP, CYCLIC_IMP_ABELIAN_GROUP, TRIVIAL_IMP_CYCLIC_GROUP,
           CYCLIC_GROUP_ALT, CYCLIC_GROUP_GENERATED, CYCLIC_GROUP_EPIMORPHIC_IMAGE,
           ISOMORPHIC_GROUP_CYCLICITY, SUBGROUP_OF_CYCLIC_GROUP_EXPLICIT,
           SUBGROUP_OF_CYCLIC_GROUP, CYCLIC_GROUP_QUOTIENT_GROUP,
           NO_PROPER_SUBGROUPS_IMP_CYCLIC }
  -- @@RETURN END

structure CyclicGroups2 where
  -- @@FIELDS
  FINITE_CYCLIC_SUBGROUP : thm
  INFINITE_CYCLIC_SUBGROUP : thm
  FINITE_CYCLIC_SUBGROUP_ALT : thm
  INFINITE_CYCLIC_SUBGROUP_ALT : thm
  FINITE_CYCLIC_SUBGROUP_ORDER : thm
  INFINITE_CYCLIC_SUBGROUP_ORDER : thm
  FINITE_CYCLIC_SUBGROUP_EXPLICIT : thm
  FINITE_SUBGROUPS_EQ : thm
  CARD_CYCLIC_SUBGROUP_ORDER : thm
  PRIME_ORDER_IMP_NO_PROPER_SUBGROUPS : thm
  PRIME_ORDER_EQ_NO_PROPER_SUBGROUPS : thm
  NO_PROPER_SUBGROUPS_EQ_CYCLIC_PRIME_ORDER : thm
  deriving Inhabited

@[nospecialize]
def setupCyclicGroups2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BCosets2 : Cosets2) (BGroupElementOrder : GroupElementOrder) (BCyclicGroups1 : CyclicGroups1) :
    ExceptT String IO CyclicGroups2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INTEGER_RULE, INT_ARITH,
        INT_ARITH_TAC, MESON, MESON_TAC, NUMBER_RULE, SET_RULE, SET_TAC, TAUT, .. } := D
  let { AND_FORALL_THM, ARITH, CARD_CLAUSES, CARD_EQ_0, CARD_IMAGE_INJ, CARD_NUMSEG_LT,
        CARD_SING, CARD_SUBSET, CARD_SUBSET_EQ, .. } := D.core1
  let { CONTRAPOS_THM, DIVIDES_LE, DIV_EQ_0, DIV_MULT, EMPTY_SUBSET, .. } := D.core2
  let { EXTENSION, FINITE_DELETE, FINITE_EMPTY, FINITE_IMAGE, FINITE_INSERT,
        FINITE_NUMSEG, FINITE_NUMSEG_LT, FINITE_SUBSET, FINITE_UNIONS, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, HAS_SIZE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, INFINITE, INFINITE_IMAGE, INFINITE_IMAGE_INJ,
        INFINITE_SUPERSET, INSERT_SUBSET, INT_ABS, INT_ABS_NUM, INT_ABS_POS,
        INT_ABS_ZERO, INT_DIVISION, INT_FORALL_POS, INT_LT_IMP_LE, INT_MUL_SYM, .. } := D.core4
  let { INT_OF_NUM_EQ, INT_OF_NUM_LT, INT_OF_NUM_OF_INT, INT_OF_NUM_SUB, INT_SUB_0,
        INT_SUB_LT, INT_WLOG_LT, IN_DELETE, IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, IN_SING,
        IN_UNIV, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, LE_0, LE_TRANS, LT_IMP_LE, MONO_OR, MULT_SYM,
        NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, NOT_LT, ONE_OR_PRIME, .. } := D.core6
  let { SIMPLE_IMAGE_GEN, SUBSET, SUBSET_ANTISYM_EQ, UNIONS_GSPEC, UNIONS_SUBSET,
        WLOG_LE, WLOG_LT, divides, .. } := D.core7
  let { num_INFINITE, num_divides, .. } := D.core8
  let { GROUP_CARRIER_NONEMPTY, GROUP_MUL_LID, .. } := BBasics
  let { GROUP_DIV_REFL, GROUP_INV_ID, GROUP_POW, .. } := BDerived
  let { GROUP_NPOW, GROUP_ZPOW, GROUP_ZPOW_0, GROUP_ZPOW_1, GROUP_ZPOW_ADD,
        GROUP_ZPOW_ID, GROUP_ZPOW_MUL, GROUP_ZPOW_NEG, GROUP_ZPOW_SUB, .. } := BPow
  let { FINITE_SUBGROUPS, IN_SUBGROUP_ID, SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { SUBGROUP_GENERATED_INC_GEN, .. } := BSubgroupGen1
  let { LAGRANGE_THEOREM, .. } := BCosets2
  let { GROUP_ELEMENT_ORDER_EQ_0, GROUP_ELEMENT_ORDER_POW, GROUP_ZPOW_EQ,
        GROUP_ZPOW_EQ_ALT, .. } := BGroupElementOrder
  let { CARRIER_SUBGROUP_GENERATED_BY_SING, NO_PROPER_SUBGROUPS_IMP_CYCLIC,
        SUBGROUP_OF_POWERS, cyclic_group, .. } := BCyclicGroups1
  -- @@SCOPE END

  let (FINITE_CYCLIC_SUBGROUP, INFINITE_CYCLIC_SUBGROUP,
       FINITE_CYCLIC_SUBGROUP_ALT, INFINITE_CYCLIC_SUBGROUP_ALT) ←
   list4 (CONJUNCTS (← prove
   r"(!G x:A.
        x IN group_carrier G
        ==> (FINITE(group_carrier(subgroup_generated G {x})) <=>
             ?n. ~(n = 0) /\ group_pow G x n = group_id G)) /\
   (!G x:A.
        x IN group_carrier G
        ==> (INFINITE(group_carrier(subgroup_generated G {x})) <=>
             !m n. group_pow G x m = group_pow G x n ==> m = n)) /\
   (!G x:A.
        x IN group_carrier G
        ==> (FINITE(group_carrier(subgroup_generated G {x})) <=>
             ?n. ~(n = &0) /\ group_zpow G x n = group_id G)) /\
   (!G x:A.
        x IN group_carrier G
        ==> (INFINITE(group_carrier(subgroup_generated G {x})) <=>
             !m n. group_zpow G x m = group_zpow G x n ==> m = n))"
   (← do
    let t1 ← TAUT
     (← q r"(r ==> ~p) /\ (r' ==> r) /\ (~r' ==> q) /\ (q ==> q') /\ (q' ==> p)
    ==> (p <=> q) /\ (~p <=> r) /\ (p <=> q') /\ (~p <=> r')")
    pure (REWRITE_TAC [INFINITE, AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(x:A) IN group_carrier G") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC t1 THEN
    REPEAT CONJ_TAC THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"(:num)") o MATCH_MP INFINITE_IMAGE_INJ) THEN
      ASM_SIMP_TAC [num_INFINITE, CARRIER_SUBGROUP_GENERATED_BY_SING] THEN
      REWRITE_TAC [INFINITE, CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
      REWRITE_TAC [← GSYM GROUP_NPOW] THEN SET_TAC [],
      REWRITE_TAC [← GSYM GROUP_NPOW, ← GSYM INT_OF_NUM_EQ] THEN SET_TAC [],
      REWRITE_TAC [NOT_FORALL_THM, LEFT_IMP_EXISTS_THM, NOT_IMP] THEN
      MATCH_MP_TAC INT_WLOG_LT THEN REWRITE_TAC [] THEN
      CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q "m:int", ← q "n:int"] THEN REPEAT STRIP_TAC THEN
      EXISTS_TAC (← q r"num_of_int(n - m)") THEN
      ASM_SIMP_TAC [← GSYM GROUP_NPOW, INT_OF_NUM_OF_INT, INT_LT_IMP_LE,
                   INT_SUB_LT, ← GSYM INT_OF_NUM_EQ, INT_SUB_0, GROUP_ZPOW_SUB,
                   GROUP_DIV_REFL, GROUP_ZPOW],
      REWRITE_TAC [← GSYM INT_OF_NUM_EQ, ← GSYM GROUP_NPOW] THEN MESON_TAC [],
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"?n. ~(n = 0) /\ group_pow G (x:A) n = group_id G")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (X_CHOOSE_THEN (← q "n:int") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"num_of_int(abs n)") THEN
        REWRITE_TAC [← GSYM GROUP_NPOW, ← GSYM INT_OF_NUM_EQ] THEN
        SIMP_TAC [INT_OF_NUM_OF_INT, INT_ABS_POS, INT_ABS_ZERO] THEN
        ASM_REWRITE_TAC [INT_ABS] THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [GROUP_ZPOW_NEG, GROUP_INV_ID],
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE (group_pow G (x:A)) (0..n)") THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG] THEN
        ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_BY_SING, SUBSET] THEN
        REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, IN_IMAGE, IN_NUMSEG, LE_0] THEN
        X_GEN_TAC (← q "a:int") THEN
        MP_TAC (← ISPECL [← q "a:int", ← q r"&n:int"] INT_DIVISION) THEN
        ASM_REWRITE_TAC [INT_OF_NUM_EQ] THEN
        DISCH_THEN (CONJUNCTS_THEN2 SUBST1_TAC MP_TAC) THEN
        SPEC_TAC (← q r"a rem &n", ← q "b:int") THEN ONCE_REWRITE_TAC [INT_MUL_SYM] THEN
        REWRITE_TAC [IMP_CONJ, ← GSYM INT_FORALL_POS, INT_ABS_NUM,
                    INT_OF_NUM_LT] THEN
        X_GEN_TAC (← q "m:num") THEN DISCH_TAC THEN EXISTS_TAC (← q "m:num") THEN
        ASM_SIMP_TAC [LT_IMP_LE, GROUP_ZPOW_ADD, GROUP_ZPOW_MUL] THEN
        ASM_REWRITE_TAC [GROUP_NPOW, GROUP_ZPOW_ID] THEN
        ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_POW]]]))))

  let FINITE_CYCLIC_SUBGROUP_ORDER ← prove
   r"!G x:A.
        x IN group_carrier G
        ==> (FINITE(group_carrier(subgroup_generated G {x})) <=>
             ~(group_element_order G x = 0))"
   (SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_0, FINITE_CYCLIC_SUBGROUP] THEN
    MESON_TAC [])

  let INFINITE_CYCLIC_SUBGROUP_ORDER ← prove
   r"!G x:A.
        x IN group_carrier G
        ==> (INFINITE (group_carrier(subgroup_generated G {x})) <=>
             group_element_order G x = 0)"
   (SIMP_TAC [INFINITE, FINITE_CYCLIC_SUBGROUP_ORDER])

  let FINITE_CYCLIC_SUBGROUP_EXPLICIT ← prove
   r"!G x:A.
        FINITE(group_carrier(subgroup_generated G {x})) /\ x IN group_carrier G
        ==> group_carrier(subgroup_generated G {x}) =
            {group_pow G x n |n| n < group_element_order G x}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_BY_SING] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_UNIV, ← GSYM GROUP_NPOW] THEN
    CONJ_TAC THENL [ASM_SIMP_TAC [GROUP_ZPOW_EQ_ALT], MESON_TAC []] THEN
    X_GEN_TAC (← q "n:int") THEN
    MP_TAC (← ISPECL [← q "n:int", ← q r"&(group_element_order G (x:A)):int"]
          INT_DIVISION) THEN
    SPEC_TAC (← q r"n div &(group_element_order G (x:A))", ← q "q:int") THEN
    SPEC_TAC (← q r"n rem &(group_element_order G (x:A))", ← q "r:int") THEN
    REPEAT GEN_TAC THEN
    ASM_SIMP_TAC [INT_OF_NUM_EQ, ← GSYM FINITE_CYCLIC_SUBGROUP_ORDER] THEN
    REWRITE_TAC [INT_ABS_NUM] THEN STRIP_TAC THEN EXISTS_TAC (← q r"num_of_int r") THEN
    ASM_SIMP_TAC [INT_OF_NUM_OF_INT, ← GSYM INT_OF_NUM_LT] THEN
    CONV_TAC INTEGER_RULE)

  let FINITE_SUBGROUPS_EQ ← prove
   r"!G:A group. FINITE {h | h subgroup_of G} <=> FINITE(group_carrier G)"
   (← do
    let i1 ← INTEGER_RULE
     (← q r"(?n:int. (a == b * n) (mod (&0))) <=> b divides a")
    let s1 ← SET_RULE (← q r"!a. a IN s /\ ~(a IN t) ==> s = t ==> P")
    let m1 ← MESON [INFINITE]
     (← q r"FINITE s ==> INFINITE s ==> F")
    pure (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [FINITE_SUBGROUPS] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"group_carrier G:A->bool =
    UNIONS {group_carrier(subgroup_generated G {x}) |x| x IN group_carrier G}")
    SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, UNIONS_GSPEC] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q "x:A") THEN
      DISCH_TAC THEN EXISTS_TAC (← q "x:A") THEN
      ASM_SIMP_TAC [SUBGROUP_GENERATED_INC_GEN, IN_SING],
      REWRITE_TAC [FINITE_UNIONS, FORALL_IN_GSPEC]] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      SIMP_TAC [SUBGROUP_SUBGROUP_GENERATED, IN_ELIM_THM],
      SIMP_TAC [FINITE_CYCLIC_SUBGROUP_ORDER]] THEN
    X_GEN_TAC (← q "x:A") THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP m1) THEN
    MATCH_MP_TAC INFINITE_SUPERSET THEN EXISTS_TAC
     (← q r"IMAGE (\n. group_carrier(subgroup_generated G {group_pow G (x:A) n}))
          ((:num) DELETE 0)") THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_ELIM_THM, SUBGROUP_SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC INFINITE_IMAGE THEN REWRITE_TAC [INFINITE, FINITE_DELETE] THEN
    REWRITE_TAC [num_INFINITE, ← GSYM INFINITE, IN_UNIV, IN_DELETE] THEN
    MATCH_MP_TAC WLOG_LT THEN REPEAT (CONJ_TAC THENL [MESON_TAC [], ALL_TAC]) THEN
    MAP_EVERY X_GEN_TAC [← q "m:num", ← q "n:num"] THEN DISCH_TAC THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC s1 THEN
    EXISTS_TAC (← q r"group_pow G (x:A) m") THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_INC_GEN, IN_SING, GROUP_POW] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_BY_SING, GROUP_POW] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_UNIV, ← GSYM GROUP_NPOW] THEN
    ASM_SIMP_TAC [GROUP_ZPOW_EQ, ← GSYM GROUP_ZPOW_MUL] THEN
    REWRITE_TAC [← GSYM num_divides, i1] THEN
    DISCH_THEN (MP_TAC o MATCH_MP DIVIDES_LE) THEN ASM_ARITH_TAC))

  let CARD_CYCLIC_SUBGROUP_ORDER ← prove
   r"!G x:A.
        FINITE(group_carrier(subgroup_generated G {x})) /\ x IN group_carrier G
        ==> CARD(group_carrier(subgroup_generated G {x})) =
            group_element_order G x"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [FINITE_CYCLIC_SUBGROUP_EXPLICIT] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM CARD_NUMSEG_LT] THEN
    MATCH_MP_TAC CARD_IMAGE_INJ THEN
    REWRITE_TAC [FINITE_NUMSEG_LT, IN_ELIM_THM] THEN MATCH_MP_TAC WLOG_LE THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [← GSYM GROUP_NPOW, GROUP_ZPOW_EQ_ALT, INT_OF_NUM_SUB] THEN
    REWRITE_TAC [← GSYM num_divides] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP DIVIDES_LE) THEN ASM_ARITH_TAC)

  let PRIME_ORDER_IMP_NO_PROPER_SUBGROUPS ← prove
   r"!(G:A group) p.
        (group_carrier G) HAS_SIZE p /\ (p = 1 \/ prime p)
        ==> !h. h subgroup_of G
                ==> h = {group_id G} \/ h = group_carrier G"
   (← do
    let a3 ← ARITH_RULE (← q r"2 <= n ==> ~(n = 1)")
    let s2 ← SET_RULE
     (← q r"z IN s /\ (!x. x IN s /\ ~(x = z) ==> s = t) ==> s = {z} \/ s = t")
    let t1 ← TAUT (← q r"p ==> q \/ r <=> p /\ ~q ==> r")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_SIZE, ONE_OR_PRIME] THEN
    REPEAT STRIP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [t1]) THEN
    MATCH_MP_TAC s2 THEN
    ASM_SIMP_TAC [IN_SUBGROUP_ID] THEN
    X_GEN_TAC (← q "x:A") THEN STRIP_TAC THEN MATCH_MP_TAC CARD_SUBSET_EQ THEN
    ASM_SIMP_TAC [SUBGROUP_OF_IMP_SUBSET] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q r"h:A->bool"] LAGRANGE_THEOREM) THEN
    ASM_SIMP_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC a3 THEN
    TRANS_TAC LE_TRANS (← q r"CARD {group_id G:A,x}") THEN CONJ_TAC THENL
     [SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN
      ASM_REWRITE_TAC [IN_SING, NOT_IN_EMPTY, ARITH],
      MATCH_MP_TAC CARD_SUBSET THEN
      ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET] THEN
      ASM_MESON_TAC [subgroup_of, FINITE_SUBSET]]))

  let (PRIME_ORDER_EQ_NO_PROPER_SUBGROUPS,
       NO_PROPER_SUBGROUPS_EQ_CYCLIC_PRIME_ORDER) ← CONJ_PAIR (← prove
   r"(!(G:A group).
        FINITE(group_carrier G) /\
        (CARD(group_carrier G) = 1 \/ prime(CARD(group_carrier G))) <=>
        !h. h subgroup_of G ==> h = {group_id G} \/ h = group_carrier G) /\
   (!(G:A group).
        (!h. h subgroup_of G ==> h = {group_id G} \/ h = group_carrier G) <=>
        cyclic_group G /\
        FINITE(group_carrier G) /\
        (CARD(group_carrier G) = 1 \/ prime(CARD(group_carrier G))))"
   (← do
    let n5 ← NUMBER_RULE (← q r"0 divides n <=> n = 0")
    let a4 ← INT_ARITH (← q r"n:int <= &0 \/ &1 <= n ==> ~(&2 * n = &1)")
    let s3 ← SET_RULE (← q r"{f n | n IN (:int)} = {a} ==> f(&1) = a")
    let t2 ← TAUT (← q r"(~p <=> q) ==> ~q ==> p")
    let t1 ← TAUT
     (← q r"(p ==> n) /\ (n ==> c) /\ (c /\ n ==> p)
    ==> (p <=> n) /\ (n <=> c /\ p)")
    pure (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC t1 THEN
    REPEAT CONJ_TAC THENL
     [DISCH_TAC THEN
      MATCH_MP_TAC PRIME_ORDER_IMP_NO_PROPER_SUBGROUPS THEN
      REWRITE_TAC [HAS_SIZE] THEN ASM_MESON_TAC [],
      DISCH_TAC THEN MATCH_MP_TAC NO_PROPER_SUBGROUPS_IMP_CYCLIC THEN
      ASM SET_TAC [],
      STRIP_TAC THEN REWRITE_TAC [ONE_OR_PRIME]] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [cyclic_group]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q "x:A") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q "G:A group", ← q "x:A"] INFINITE_CYCLIC_SUBGROUP_ALT) THEN
    ASM_REWRITE_TAC [INFINITE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP t2) THEN
    ANTS_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"{group_zpow G (group_zpow G (x:A) (&2)) n | n IN (:int)}")) THEN
      ASM_SIMP_TAC [SUBGROUP_OF_POWERS, GROUP_ZPOW, ← GSYM GROUP_ZPOW_MUL] THEN
      DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL
       [DISCH_THEN (MP_TAC o MATCH_MP s3) THEN
        DISCH_TAC THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"&2 * &1:int", ← q r"&0:int"]) THEN
        ASM_REWRITE_TAC [GROUP_ZPOW_0] THEN CONV_TAC INT_ARITH,
        REWRITE_TAC [EXTENSION] THEN DISCH_THEN (MP_TAC o SPEC (← q "x:A")) THEN
        ASM_REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q "n:int") (STRIP_ASSUME_TAC o GSYM)) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"&2 * n:int", ← q r"&1:int"]) THEN
        ASM_SIMP_TAC [GROUP_ZPOW_1] THEN MATCH_MP_TAC a4 THEN
        INT_ARITH_TAC],
      DISCH_TAC THEN ASM_REWRITE_TAC []] THEN
    X_GEN_TAC (← q "n:num") THEN
    ASM_CASES_TAC (← q "n = 0") THEN
    ASM_SIMP_TAC [CARD_EQ_0, GROUP_CARRIER_NONEMPTY, n5] THEN
    DISCH_TAC THEN
    ABBREV_TAC (← q r"m = CARD(group_carrier(G:A group)) DIV n") THEN
    SUBGOAL_THEN (← q r"~(m = 0)") ASSUME_TAC THENL
     [EXPAND_TAC "m" THEN ASM_SIMP_TAC [DIV_EQ_0] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP DIVIDES_LE) THEN
      ASM_SIMP_TAC [CARD_EQ_0, GROUP_CARRIER_NONEMPTY, NOT_LT],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC
     (← q r"group_carrier(subgroup_generated G {group_pow G x m:A})")) THEN
    SUBGOAL_THEN (← q r"group_element_order G (group_pow G (x:A) m) = n")
    ASSUME_TAC THENL
     [wPart lhand (fun t => do lhand (← rand t)) GROUP_ELEMENT_ORDER_POW THEN
      ASM_REWRITE_TAC [] THEN
      UNDISCH_TAC (← q r"CARD(group_carrier G:A->bool) DIV n = m") THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [divides]) THEN
      ASM_SIMP_TAC [← GSYM CARD_CYCLIC_SUBGROUP_ORDER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q "r:num") SUBST1_TAC) THEN
      ASM_SIMP_TAC [DIV_MULT] THEN ONCE_REWRITE_TAC [MULT_SYM] THEN
      ASM_SIMP_TAC [DIV_MULT] THEN DISCH_TAC THEN
      DISCH_THEN MATCH_MP_TAC THEN CONV_TAC NUMBER_RULE,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"FINITE(group_carrier (subgroup_generated G {group_pow G x m:A}))")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [FINITE_CYCLIC_SUBGROUP_ORDER, GROUP_POW] THEN
      ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_POW],
      ALL_TAC] THEN
    REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC MONO_OR THEN CONJ_TAC THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"CARD:(A->bool)->num")) THEN
    ASM_SIMP_TAC [CARD_CYCLIC_SUBGROUP_ORDER, GROUP_POW, CARD_SING])))

  -- @@RETURN BEGIN
  return { FINITE_CYCLIC_SUBGROUP, INFINITE_CYCLIC_SUBGROUP, FINITE_CYCLIC_SUBGROUP_ALT,
           INFINITE_CYCLIC_SUBGROUP_ALT, FINITE_CYCLIC_SUBGROUP_ORDER,
           INFINITE_CYCLIC_SUBGROUP_ORDER, FINITE_CYCLIC_SUBGROUP_EXPLICIT,
           FINITE_SUBGROUPS_EQ, CARD_CYCLIC_SUBGROUP_ORDER,
           PRIME_ORDER_IMP_NO_PROPER_SUBGROUPS, PRIME_ORDER_EQ_NO_PROPER_SUBGROUPS,
           NO_PROPER_SUBGROUPS_EQ_CYCLIC_PRIME_ORDER }
  -- @@RETURN END

structure CyclicGroups3 where
  -- @@FIELDS
  ABELIAN_SIMPLE_GROUP : thm
  PRIME_ORDER_IMP_CYCLIC_GROUP : thm
  GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER : thm
  GROUP_POW_GROUP_ORDER : thm
  GROUP_ZPOW_REM_ORDER : thm
  GROUP_POW_MOD_ORDER : thm
  SUBGROUP_OF_FINITE_CYCLIC_GROUP : thm
  COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS : thm
  COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS_ALL : thm
  MAXIMAL_SUBGROUP_PRIME_INDEX : thm
  PRIME_INDEX_MAXIMAL_PROPER_SUBGROUP : thm
  MAXIMAL_PROPER_SUBGROUP_PRIME_INDEX : thm
  GROUP_ZPOW_CANCEL : thm
  GROUP_POW_CANCEL : thm
  deriving Inhabited

@[nospecialize]
def setupCyclicGroups3 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BCosets2 : Cosets2) (BNormalSubgroups : NormalSubgroups) (BQuotientGroups : QuotientGroups) (BSubgroupCorrespondence : SubgroupCorrespondence) (BGroupElementOrder : GroupElementOrder) (BGroupElementOrder2 : GroupElementOrder2) (BCyclicGroups1 : CyclicGroups1) (BCyclicGroups2 : CyclicGroups2) :
    ExceptT String IO CyclicGroups3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, HAS_SIZE_CONV, INTEGER_RULE, MESON, MESON_TAC, NUMBER_RULE,
        NUM_RING, SET_RULE, TAUT, .. } := D
  let { CARD_EQ_0, CARD_IMAGE_INJ, CONJ_ASSOC, .. } := D.core1
  let { DE_MORGAN_THM, DIVIDES_DIV_MULT, DIVIDES_ZERO, DIV_MULT, EQ_TRANS, .. } := D.core2
  let { EXTENSION, FORALL_UNWIND_THM2, GCD, HAS_SIZE, HAS_SIZE_0, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, INT_CONG_LREM, .. } := D.core4
  let { INT_OF_NUM_REM, IN_ELIM_THM, IN_UNIV, .. } := D.core5
  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MULT_EQ_0, MULT_SYM, NOT_IN_EMPTY,
        NUM_GCD, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET, SUBSET_ANTISYM,
        SWAP_EXISTS_THM, SWAP_FORALL_THM, UNWIND_THM2, divides, .. } := D.core7
  let { num_coprime, num_divides, prime, .. } := D.core8
  let { GROUP_CARRIER_NONEMPTY, TRIVIAL_GROUP_HAS_SIZE_1, .. } := BBasics
  let { GROUP_POW, .. } := BDerived
  let { GROUP_NPOW, GROUP_ZPOW, GROUP_ZPOW_1, GROUP_ZPOW_MUL, .. } := BPow
  let { FINITE_RESTRICTED_SUBGROUPS, FINITE_SUBGROUPS, .. } := BSubgroups
  let { SUBGROUP_GENERATED_MINIMAL, SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { FINITE_SUBGROUP_GENERATED, .. } := BSubgroupGen1
  let { LAGRANGE_THEOREM, .. } := BCosets2
  let { ABELIAN_GROUP_NORMAL_SUBGROUP, .. } := BNormalSubgroups
  let { QUOTIENT_GROUP, TRIVIAL_QUOTIENT_GROUP_EQ, .. } := BQuotientGroups
  let { MAXIMAL_SUBGROUP, .. } := BSubgroupCorrespondence
  let { GROUP_POW_EQ_ID, GROUP_ZPOW_EQ, .. } := BGroupElementOrder
  let { GROUP_ELEMENT_ORDER_POW_GEN, .. } := BGroupElementOrder2
  let { CARRIER_SUBGROUP_GENERATED_BY_SING, SUBGROUP_OF_CYCLIC_GROUP_EXPLICIT,
        cyclic_group, .. } := BCyclicGroups1
  let { CARD_CYCLIC_SUBGROUP_ORDER, NO_PROPER_SUBGROUPS_EQ_CYCLIC_PRIME_ORDER,
        PRIME_ORDER_EQ_NO_PROPER_SUBGROUPS, .. } := BCyclicGroups2
  -- @@SCOPE END

  let ABELIAN_SIMPLE_GROUP ← prove
   r"!G:A group.
          abelian_group G
          ==> ((!h. h normal_subgroup_of G
                    ==> h = {group_id G} \/ h = group_carrier G) <=>
               FINITE(group_carrier G) /\
               (CARD (group_carrier G) = 1 \/ prime(CARD(group_carrier G))))"
   (REWRITE_TAC [PRIME_ORDER_EQ_NO_PROPER_SUBGROUPS] THEN
    SIMP_TAC [ABELIAN_GROUP_NORMAL_SUBGROUP])

  let PRIME_ORDER_IMP_CYCLIC_GROUP ← prove
   r"!G:A group.
          FINITE(group_carrier G) /\
          (CARD(group_carrier G) = 1 \/ prime(CARD(group_carrier G)))
          ==> cyclic_group G"
   (REWRITE_TAC [PRIME_ORDER_EQ_NO_PROPER_SUBGROUPS] THEN
    REWRITE_TAC [NO_PROPER_SUBGROUPS_EQ_CYCLIC_PRIME_ORDER] THEN
    SIMP_TAC [])

  let GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER ← prove
   r"!G x:A.
          x IN group_carrier G /\ FINITE(group_carrier G)
          ==> (group_element_order G x) divides CARD(group_carrier G)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM CARD_CYCLIC_SUBGROUP_ORDER, FINITE_SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC LAGRANGE_THEOREM THEN
    ASM_REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED])

  let GROUP_POW_GROUP_ORDER ← prove
   r"!G x:A.
          x IN group_carrier G /\ FINITE(group_carrier G)
          ==> group_pow G x (CARD(group_carrier G)) = group_id G"
   (SIMP_TAC [GROUP_POW_EQ_ID, GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER])

  let GROUP_ZPOW_REM_ORDER ← prove
   r"!G (x:A) n.
          FINITE(group_carrier G) /\ x IN group_carrier G
          ==> group_zpow G x (n rem &(CARD(group_carrier G))) =
              group_zpow G x n"
   (← do
    let r1 ← INTEGER_RULE
      (← q r"!d:int. (x == y) (mod d) /\ e divides d ==> (x == y) (mod e)")
    pure (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [GROUP_ZPOW_EQ] THEN
     MATCH_MP_TAC r1 THEN
     EXISTS_TAC (← q r"&(CARD(group_carrier G:A->bool)):int") THEN
     ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER, INT_CONG_LREM,
                  ← GSYM num_divides] THEN
     CONV_TAC INTEGER_RULE))

  let GROUP_POW_MOD_ORDER ← prove
   r"!G (x:A) n. FINITE(group_carrier G) /\ x IN group_carrier G
             ==> group_pow G x (n MOD CARD(group_carrier G)) =
                 group_pow G x n"
   (REWRITE_TAC [← GSYM GROUP_NPOW, ← GSYM INT_OF_NUM_REM,
                GROUP_ZPOW_REM_ORDER])

  let SUBGROUP_OF_FINITE_CYCLIC_GROUP ← prove
   r"!G h a:A.
          FINITE(group_carrier G) /\
          a IN group_carrier G /\
          subgroup_generated G {a} = G
          ==> (h subgroup_of G <=>
               ?d. d divides CARD(group_carrier G) /\
                   h = group_carrier(subgroup_generated G {group_pow G a d}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC, MESON_TAC [SUBGROUP_SUBGROUP_GENERATED]] THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"h:A->bool"), (← q r"a:A")]
          SUBGROUP_OF_CYCLIC_GROUP_EXPLICIT) THEN
    ASM_SIMP_TAC [GROUP_ZPOW_MUL] THEN
    ASM_SIMP_TAC [← GSYM CARRIER_SUBGROUP_GENERATED_BY_SING, GROUP_ZPOW] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"k:num")) THEN
    EXISTS_TAC (← q r"gcd(k,CARD(group_carrier G:A->bool))") THEN
    ASM_REWRITE_TAC [GCD] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    CONJ_TAC THEN MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN
    ASM_SIMP_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_BY_SING, GROUP_POW, GROUP_NPOW] THEN
    REWRITE_TAC [SING_SUBSET, IN_ELIM_THM, IN_UNIV] THEN
    ASM_SIMP_TAC [← GSYM GROUP_NPOW, ← GSYM GROUP_ZPOW_MUL, GROUP_ZPOW_EQ] THEN
    REWRITE_TAC [NUM_GCD] THENL [CONV_TAC INTEGER_RULE, ALL_TAC] THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"a:A")] CARD_CYCLIC_SUBGROUP_ORDER) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    CONV_TAC INTEGER_RULE)

  let COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS ← prove
   r"!(G:A group) d.
          FINITE(group_carrier G) /\ cyclic_group G
          ==> (CARD {h | h subgroup_of G /\ CARD h = d} =
               if d divides CARD(group_carrier G) then 1 else 0)"
   (← do
    let r8 ← NUM_RING
      (← q r"g DIV k2 = g DIV k1
        ==> g DIV k1 * k1 = g /\ g DIV k2 * k2 = g /\ ~(g = 0)
            ==> k1 = k2")
    let r7 ← NUMBER_RULE (← q r"k divides g ==> gcd(g:num,k) = k")
    let r6 ← TAUT (← q r"(p /\ q) /\ r <=> q /\ p /\ r")
    let r5 ← NUMBER_RULE (← q r"k divides g ==> gcd(g:num,k) = k")
    let r4 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    let r3 ← TAUT (← q r"(p /\ q) /\ r <=> q /\ p /\ r")
    let r2 ← SET_RULE
      (← q r"(?x. P x) /\ (!x. P x ==> !x'. P x' ==> x = x')
      ==> ?a. {x | P x} = {a}")
    let r1 ← MESON [HAS_SIZE] (← q r"s HAS_SIZE 1 ==> CARD s = 1")
    pure (REPEAT STRIP_TAC THEN FIRST_X_ASSUM
      (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC o REWRITE_RULE [cyclic_group]) THEN
     COND_CASES_TAC THENL
      [MATCH_MP_TAC r1,
       ASM_SIMP_TAC [CARD_EQ_0, FINITE_RESTRICTED_SUBGROUPS] THEN
       REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
       ASM_MESON_TAC [LAGRANGE_THEOREM]] THEN
     CONV_TAC HAS_SIZE_CONV THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [divides]) THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") (ASSUME_TAC o SYM)) THEN
     SUBGOAL_THEN (← q r"~(d * k = 0)") MP_TAC THENL
      [ASM_SIMP_TAC [CARD_EQ_0, GROUP_CARRIER_NONEMPTY],
       REWRITE_TAC [DE_MORGAN_THM, MULT_EQ_0] THEN STRIP_TAC] THEN
     MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"a:A")] CARD_CYCLIC_SUBGROUP_ORDER) THEN
     ASM_REWRITE_TAC [] THEN DISCH_THEN (ASSUME_TAC o SYM) THEN
     MATCH_MP_TAC r2 THEN
     MP_TAC (← GEN (← q r"h:A->bool") (← ISPECL [(← q r"G:A group"), (← q r"h:A->bool"), (← q r"a:A")]
           SUBGROUP_OF_FINITE_CYCLIC_GROUP)) THEN
     ASM_SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN CONJ_TAC THENL
      [REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
       GEN_REWRITE_TAC I [SWAP_EXISTS_THM] THEN
       REWRITE_TAC [r3] THEN
       EXISTS_TAC (← q r"k:num") THEN REWRITE_TAC [UNWIND_THM2] THEN
       ASM_SIMP_TAC [CARD_CYCLIC_SUBGROUP_ORDER, FINITE_SUBGROUP_GENERATED,
                    GROUP_POW] THEN
       MATCH_MP_TAC r4 THEN
       CONJ_TAC THENL [ASM_MESON_TAC [divides, MULT_SYM], ALL_TAC] THEN
       ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_POW_GEN] THEN
       SIMP_TAC [r5] THEN
       ASM_MESON_TAC [MULT_SYM, DIV_MULT],
       REWRITE_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
       REWRITE_TAC [r6] THEN
       GEN_REWRITE_TAC I [SWAP_FORALL_THM] THEN X_GEN_TAC (← q r"k1:num") THEN
       GEN_REWRITE_TAC BINDER_CONV [IMP_CONJ] THEN
       REWRITE_TAC [FORALL_UNWIND_THM2] THEN STRIP_TAC THEN
       GEN_REWRITE_TAC I [SWAP_FORALL_THM] THEN X_GEN_TAC (← q r"k2:num") THEN
       GEN_REWRITE_TAC BINDER_CONV [IMP_CONJ] THEN
       REWRITE_TAC [FORALL_UNWIND_THM2] THEN
       DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
       FIRST_X_ASSUM (fun th => tactic_of do
         pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← SYM th])) THEN
       ASM_SIMP_TAC [CARD_CYCLIC_SUBGROUP_ORDER, GROUP_POW,
                    FINITE_SUBGROUP_GENERATED, GROUP_ELEMENT_ORDER_POW_GEN] THEN
       COND_CASES_TAC THENL [ASM_MESON_TAC [DIVIDES_ZERO, MULT_EQ_0], ALL_TAC] THEN
       COND_CASES_TAC THENL [ASM_MESON_TAC [DIVIDES_ZERO, MULT_EQ_0], ALL_TAC] THEN
       ASM_SIMP_TAC [r7] THEN
       DISCH_THEN (MP_TAC o MATCH_MP r8) THEN
       ASM_REWRITE_TAC [← GSYM DIVIDES_DIV_MULT] THEN
       ASM_SIMP_TAC [CARD_EQ_0, GROUP_CARRIER_NONEMPTY]]))

  let COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS_ALL ← prove
   r"!G:A group.
        FINITE(group_carrier G) /\ cyclic_group G
        ==> CARD {h | h subgroup_of G} =
            CARD {d | d divides CARD(group_carrier G)}"
   (← do
    let r3 ← HAS_SIZE_CONV (← q r"s HAS_SIZE 1")
    let r2 ← SET_RULE
      (← q r"(!y. y IN t ==> ?a. {x | x IN s /\ f x = y} = {a}) /\
      (!y. ~(y IN t) ==> {x | x IN s /\ f x = y} = {})
      ==> t = IMAGE f s /\ (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)")
    let r1 ← MESON [CARD_IMAGE_INJ]
      (← q r"!f. FINITE s /\
          t = IMAGE f s /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> CARD s = CARD t")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC r1 THEN
     EXISTS_TAC (← q r"CARD:(A->bool)->num") THEN ASM_SIMP_TAC [FINITE_SUBGROUPS] THEN
     MATCH_MP_TAC r2 THEN
     REWRITE_TAC [← GSYM r3, ← GSYM HAS_SIZE_0] THEN
     ASM_SIMP_TAC [IN_ELIM_THM, HAS_SIZE, FINITE_RESTRICTED_SUBGROUPS] THEN
     ASM_SIMP_TAC [COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS]))

  let MAXIMAL_SUBGROUP_PRIME_INDEX ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> ((!h. h subgroup_of G /\ n PSUBSET h ==> h = group_carrier G) <=>
               FINITE {right_coset G n x | x | x IN group_carrier G} /\
               (CARD {right_coset G n x | x | x IN group_carrier G} = 1 \/
                prime(CARD {right_coset G n x | x | x IN group_carrier G})))"
   (SIMP_TAC [MAXIMAL_SUBGROUP, ← GSYM PRIME_ORDER_EQ_NO_PROPER_SUBGROUPS] THEN
    SIMP_TAC [QUOTIENT_GROUP])

  let PRIME_INDEX_MAXIMAL_PROPER_SUBGROUP ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G
          ==> (FINITE {right_coset G n x | x | x IN group_carrier G} /\
               prime(CARD {right_coset G n x | x | x IN group_carrier G}) <=>
               ~(n = group_carrier G) /\
               !h. h subgroup_of G /\ n PSUBSET h ==> h = group_carrier G)"
   (SIMP_TAC [MAXIMAL_SUBGROUP_PRIME_INDEX] THEN
    SIMP_TAC [← GSYM TRIVIAL_QUOTIENT_GROUP_EQ] THEN
    SIMP_TAC [TRIVIAL_GROUP_HAS_SIZE_1, QUOTIENT_GROUP, HAS_SIZE] THEN
    MESON_TAC [prime])

  let MAXIMAL_PROPER_SUBGROUP_PRIME_INDEX ← prove
   r"!G n:A->bool.
          n normal_subgroup_of G /\ ~(n = group_carrier G)
          ==> ((!h. h subgroup_of G /\ n PSUBSET h ==> h = group_carrier G) <=>
               FINITE {right_coset G n x | x | x IN group_carrier G} /\
               prime(CARD {right_coset G n x | x | x IN group_carrier G}))"
   (SIMP_TAC [PRIME_INDEX_MAXIMAL_PROPER_SUBGROUP])

  let GROUP_ZPOW_CANCEL ← prove
   r"!G n x y:A.
          FINITE(group_carrier G) /\ coprime(n,&(CARD(group_carrier G))) /\
          x IN group_carrier G /\ y IN group_carrier G /\
          group_zpow G x n = group_zpow G y n
          ==> x = y"
   (← do
    let r3 ← INTEGER_RULE
      (← q r"(a:int == b) (mod d) ==> e divides d ==> (a == b) (mod e)")
    let r2 ← INTEGER_RULE
      (← q r"coprime(n:int,g) ==> ?m. (n * m == &1) (mod g)")
    let r1 ← SET_RULE
      (← q r"(?g. (!x. x IN s ==> g(f x) = x))
      ==> !x y. x IN s /\ y IN s /\ f x = f y ==> x = y")
    pure (GEN_TAC THEN GEN_TAC THEN
     REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN REPEAT DISCH_TAC THEN
     REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
     MATCH_MP_TAC r1 THEN
     FIRST_ASSUM (X_CHOOSE_TAC (← q r"m:int") o MATCH_MP r2) THEN
     EXISTS_TAC (← q r"\x:A. group_zpow G x m") THEN SIMP_TAC [← GSYM GROUP_ZPOW_MUL] THEN
     X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
     TRANS_TAC EQ_TRANS (← q r"group_zpow G (x:A) (&1)") THEN
     ASM_SIMP_TAC [GROUP_ZPOW_EQ] THEN ASM_SIMP_TAC [GROUP_ZPOW_1] THEN
     FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP r3) THEN
     ASM_SIMP_TAC [← GSYM num_divides, GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER]))

  let GROUP_POW_CANCEL ← prove
   r"!G n x y:A.
          FINITE(group_carrier G) /\ coprime(n,CARD(group_carrier G)) /\
          x IN group_carrier G /\ y IN group_carrier G /\
          group_pow G x n = group_pow G y n
          ==> x = y"
   (REWRITE_TAC [num_coprime, ← GSYM GROUP_NPOW, GROUP_ZPOW_CANCEL])

  -- @@RETURN BEGIN
  return { ABELIAN_SIMPLE_GROUP, PRIME_ORDER_IMP_CYCLIC_GROUP,
           GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER, GROUP_POW_GROUP_ORDER,
           GROUP_ZPOW_REM_ORDER, GROUP_POW_MOD_ORDER, SUBGROUP_OF_FINITE_CYCLIC_GROUP,
           COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS, COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS_ALL,
           MAXIMAL_SUBGROUP_PRIME_INDEX, PRIME_INDEX_MAXIMAL_PROPER_SUBGROUP,
           MAXIMAL_PROPER_SUBGROUP_PRIME_INDEX, GROUP_ZPOW_CANCEL, GROUP_POW_CANCEL }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Finitely generated groups.                                                -/
/- ------------------------------------------------------------------------- -/

structure FinitelyGenerated where
  -- @@FIELDS
  finitely_generated_group : thm
  FINITELY_GENERATED_GROUP : thm
  CYCLIC_IMP_FINITELY_GENERATED_GROUP : thm
  FINITE_IMP_FINITELY_GENERATED_GROUP : thm
  TRIVIAL_IMP_FINITELY_GENERATED_GROUP : thm
  FINITELY_GENERATED_GROUP_EPIMORPHIC_IMAGE : thm
  ISOMORPHIC_GROUP_FINITE_GENERATION : thm
  FINITELY_GENERATED_GROUP_QUOTIENT_GROUP : thm
  FINITELY_GENERATED_IMP_COUNTABLE_GROUP : thm
  FINITELY_GENERATED_PROD_GROUP : thm
  FINITELY_GENERATED_PRODUCT_GROUP : thm
  FINITELY_GENERATED_SUM_GROUP : thm
  FINITE_GROUP_ACTIONS : thm
  deriving Inhabited

@[nospecialize]
def setupFinitelyGenerated [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) (BProductGroup : ProductGroup) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms3 : Homomorphisms3) (BIso1 : Iso1) (BIso2 : Iso2) (BGroupActions : GroupActions) (BQuotientGroups : QuotientGroups) (BCyclicGroups1 : CyclicGroups1) :
    ExceptT String IO FinitelyGenerated := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, TAUT, new_definition, .. } := D
  let { CARTESIAN_PRODUCT_EQ_EMPTY, .. } := D.core1
  let { COUNTABLE_CARTESIAN_PRODUCT, .. } := D.core2
  let { FINITE_CARTESIAN_PRODUCT, FINITE_CROSS, FINITE_IMAGE, FINITE_IMAGE_GEN,
        FINITE_IMP_COUNTABLE, FINITE_INDUCT_STRONG, FINITE_INTER, FINITE_RESTRICT,
        FINITE_SING, FINITE_SUBSET, FINITE_UNION, FINITE_UNIONS, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_PAIR_THM, .. } := D.core3
  let { IMP_CONJ, INTER_SUBSET, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_CROSS, IN_ELIM_THM, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, PAIR_EQ,
        RESTRICTION, RESTRICTION_EXTENSION, .. } := D.core6
  let { RESTRICTION_IN_CARTESIAN_PRODUCT, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SING_SUBSET,
        SUBSET, SUBSET_UNION, UNIONS_IMAGE, UNION_COMM, UNION_SUBSET, .. } := D.core7
  let { GROUPS_EQ, GROUP_CARRIER_NONEMPTY, GROUP_ID, GROUP_MUL_LID, GROUP_MUL_RID,
        TRIVIAL_GROUP_ALT, TRIVIAL_GROUP_SUBSET, trivial_group, .. } := BBasics
  let { GROUP_INV_ID, .. } := BDerived
  let { IN_SUBGROUP_MUL, .. } := BSubgroups
  let { SUBGROUP_GENERATED, SUBGROUP_GENERATED_INDUCT, SUBGROUP_GENERATED_MONO,
        SUBGROUP_GENERATED_RESTRICT, SUBGROUP_GENERATED_SUPERSET,
        SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { COUNTABLE_SUBGROUP_GENERATED, SUBGROUP_GENERATED_GROUP_CARRIER, .. } := BSubgroupGen1
  let { PROD_GROUP, .. } := BProdGroup
  let { PRODUCT_GROUP, TRIVIAL_PRODUCT_GROUP, .. } := BProductGroup
  let { GROUP_SUM_INJECTION, SUM_GROUP_CLAUSES, TRIVIAL_SUM_GROUP, .. } := BSumGroup
  let { group_epimorphism, group_homomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_ID, GROUP_HOMOMORPHISM_TRIVIAL, .. } := BHomomorphisms1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE, .. } := BHomomorphisms2
  let { GROUP_EPIMORPHISM_FST, GROUP_EPIMORPHISM_SND, GROUP_HOMOMORPHISM_PAIRED, .. } := BHomomorphisms3
  let { ISOMORPHIC_GROUP_SYM, ISOMORPHIC_PRODUCT_GROUP_SUPPORT,
        ISOMORPHIC_SUM_GROUP_SUPPORT, isomorphic_group, .. } := BIso1
  let { ISOMORPHIC_PRODUCT_GROUP_INSERT, ISOMORPHIC_SUM_GROUP_INSERT, .. } := BIso2
  let { GROUP_ACTIONS_EQ_ON_GENERATORS, group_action, .. } := BGroupActions
  let { GROUP_EPIMORPHISM_RIGHT_COSET, .. } := BQuotientGroups
  let { cyclic_group, .. } := BCyclicGroups1
  -- @@SCOPE END

  let finitely_generated_group ← new_definition
   r"finitely_generated_group (G:A group) <=>
          ?s. FINITE s /\ subgroup_generated G s = G"

  let FINITELY_GENERATED_GROUP ← prove
   r"!G:A group.
          finitely_generated_group G <=>
          ?s. FINITE s /\
              s SUBSET group_carrier G /\
              subgroup_generated G s = G"
   (GEN_TAC THEN REWRITE_TAC [finitely_generated_group] THEN
    MESON_TAC [SUBGROUP_GENERATED_RESTRICT, FINITE_INTER, INTER_SUBSET])

  let CYCLIC_IMP_FINITELY_GENERATED_GROUP ← prove
   r"!G:A group. cyclic_group G ==> finitely_generated_group G"
   (REWRITE_TAC [cyclic_group, finitely_generated_group] THEN
    MESON_TAC [FINITE_SING, SING_SUBSET])

  let FINITE_IMP_FINITELY_GENERATED_GROUP ← prove
   r"!G:A group. FINITE(group_carrier G) ==> finitely_generated_group G"
   (REWRITE_TAC [finitely_generated_group] THEN
    MESON_TAC [SUBGROUP_GENERATED_GROUP_CARRIER])

  let TRIVIAL_IMP_FINITELY_GENERATED_GROUP ← prove
   r"!G:A group. trivial_group G ==> finitely_generated_group G"
   (REWRITE_TAC [trivial_group] THEN
    MESON_TAC [FINITE_IMP_FINITELY_GENERATED_GROUP, FINITE_SING])

  let FINITELY_GENERATED_GROUP_EPIMORPHIC_IMAGE ← prove
   r"!G H (f:A->B).
          group_epimorphism(G,H) f /\ finitely_generated_group G
          ==> finitely_generated_group H"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_epimorphism] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (STRIP_ASSUME_TAC o GSYM) MP_TAC) THEN
    REWRITE_TAC [FINITELY_GENERATED_GROUP] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) s") THEN
    ASM_SIMP_TAC [FINITE_IMAGE] THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [],
      REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
      ASM_MESON_TAC [SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE]])

  let ISOMORPHIC_GROUP_FINITE_GENERATION ← prove
   r"!(G:A group) (H:B group).
          G isomorphic_group H
          ==> (finitely_generated_group G <=> finitely_generated_group H)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
       FINITELY_GENERATED_GROUP_EPIMORPHIC_IMAGE) THEN
    ASM_MESON_TAC [isomorphic_group, ISOMORPHIC_GROUP_SYM,
                  GROUP_MONOMORPHISM_EPIMORPHISM])

  let FINITELY_GENERATED_GROUP_QUOTIENT_GROUP ← prove
   r"!G n:A->bool.
       finitely_generated_group G /\ n normal_subgroup_of G
       ==> finitely_generated_group(quotient_group G n)"
   (MESON_TAC [FINITELY_GENERATED_GROUP_EPIMORPHIC_IMAGE,
              GROUP_EPIMORPHISM_RIGHT_COSET])

  let FINITELY_GENERATED_IMP_COUNTABLE_GROUP ← prove
   r"!G:A group. finitely_generated_group G ==> COUNTABLE(group_carrier G)"
   (REWRITE_TAC [finitely_generated_group] THEN
    MESON_TAC [COUNTABLE_SUBGROUP_GENERATED, FINITE_IMP_COUNTABLE])

  let FINITELY_GENERATED_PROD_GROUP ← prove
   r"!(G:A group) (H:B group).
          finitely_generated_group(prod_group G H) <=>
          finitely_generated_group G /\ finitely_generated_group H"
   (← do
    let r1 ← SET_RULE
      (← q r"group_carrier(subgroup_generated G s) SUBSET
      group_carrier(subgroup_generated G (s UNION t)) /\
      x IN group_carrier(subgroup_generated G s)
      ==> x IN group_carrier(subgroup_generated G (s UNION t))")
    pure (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
       FINITELY_GENERATED_GROUP_EPIMORPHIC_IMAGE) THEN
      MESON_TAC [GROUP_EPIMORPHISM_FST, GROUP_EPIMORPHISM_SND],
      REWRITE_TAC [FINITELY_GENERATED_GROUP]] THEN
     DISCH_THEN (CONJUNCTS_THEN2
      (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC)
      (X_CHOOSE_THEN (← q r"t:B->bool") STRIP_ASSUME_TAC)) THEN
     EXISTS_TAC
      (← q r"IMAGE (\x:A. (x,group_id H)) s UNION
       IMAGE (\y:B. (group_id G,y)) t") THEN
     ASM_SIMP_TAC [FINITE_IMAGE, FINITE_UNION, UNION_SUBSET] THEN
     REWRITE_TAC [SUBGROUP_GENERATED_SUPERSET, PROD_GROUP] THEN
     SIMP_TAC [SUBSET, IN_CROSS, FORALL_PAIR_THM, FORALL_IN_IMAGE, GROUP_ID] THEN
     CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
     MAP_EVERY X_GEN_TAC [(← q r"x:A"), (← q r"y:B")] THEN STRIP_TAC THEN
     SUBGOAL_THEN (← q r"(x,y):A#B = group_mul (prod_group G H)
                                         (x,group_id H) (group_id G,y)")
     SUBST1_TAC THENL
      [ASM_SIMP_TAC [PROD_GROUP, PAIR_EQ, GROUP_MUL_LID, GROUP_MUL_RID],
       MATCH_MP_TAC IN_SUBGROUP_MUL THEN
       REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED]] THEN
     GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [UNION_COMM] THEN
     CONJ_TAC THEN MATCH_MP_TAC r1 THEN
     SIMP_TAC [SUBGROUP_GENERATED_MONO, SUBSET_UNION] THENL
      [MP_TAC (← ISPECL
        [(← q r"G:A group"), (← q r"prod_group (G:A group) (H:B group)"),
         (← q r"(\x. x,group_id H):A->A#B"), (← q r"s:A->bool")]
           SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE),
       MP_TAC (← ISPECL
        [(← q r"H:B group"), (← q r"prod_group (G:A group) (H:B group)"),
         (← q r"(\y. group_id G,y):B->A#B"), (← q r"t:B->bool")]
           SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE)] THEN
     ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_PAIRED] THEN
     REWRITE_TAC [GROUP_HOMOMORPHISM_TRIVIAL, GROUP_HOMOMORPHISM_ID] THEN
     DISCH_THEN SUBST1_TAC THEN ASM SET_TAC []))

  let FINITELY_GENERATED_PRODUCT_GROUP ← prove
   r"!k (G:K->A group).
          finitely_generated_group(product_group k G) <=>
          FINITE {i | i IN k /\ ~trivial_group(G i)} /\
          !i. i IN k ==> finitely_generated_group(G i)"
   (← do
    let r6 ← SET_RULE
      (← q r"i IN s /\ ~P i ==> Q i <=> i IN {i | i IN s /\ ~P i} ==> Q i")
    let r5 ← MESON [TRIVIAL_IMP_FINITELY_GENERATED_GROUP]
      (← q r"(!i. P i ==> finitely_generated_group(G i)) <=>
        (!i. P i /\ ~trivial_group(G i) ==> finitely_generated_group(G i))")
    let r4 ← TAUT (← q r"~p ==> (p' <=> p) ==> ~(p' /\ q)")
    let r3 ← TAUT (← q r"(~p ==> F) ==> p")
    let r2 ← SET_RULE
      (← q r"!i. i IN {i | i IN k /\ ~trivial_group (G i)}
            ==> ~trivial_group((G:K->A group) i)")
    let r1 ← TAUT
      (← q r"(p ==> q) /\ (q ==> (p <=> r)) ==> (p <=> q /\ r)")
    pure (REPEAT GEN_TAC THEN
     wPart (fun t => do rand (← lhand t)) rand ISOMORPHIC_PRODUCT_GROUP_SUPPORT THEN
     DISCH_THEN (SUBST1_TAC o SYM o
       MATCH_MP ISOMORPHIC_GROUP_FINITE_GENERATION) THEN
     MATCH_MP_TAC r1 THEN
     CONJ_TAC THENL
      [MP_TAC r2 THEN
       SPEC_TAC ((← q r"{i | i IN k /\ ~trivial_group ((G:K->A group) i)}"),
                (← q r"k:K->bool")) THEN
       REPEAT STRIP_TAC THEN
       MATCH_MP_TAC r3 THEN DISCH_TAC THEN
       FIRST_ASSUM (MP_TAC o MATCH_MP FINITELY_GENERATED_IMP_COUNTABLE_GROUP) THEN
       REWRITE_TAC [PRODUCT_GROUP, COUNTABLE_CARTESIAN_PRODUCT] THEN
       REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, GROUP_CARRIER_NONEMPTY] THEN
       FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP r4) THEN
       AP_TERM_TAC THEN REWRITE_TAC [← GSYM TRIVIAL_GROUP_ALT] THEN ASM SET_TAC [],
       DISCH_TAC THEN
       ONCE_REWRITE_TAC [r5] THEN
       ONCE_REWRITE_TAC [r6] THEN
       POP_ASSUM MP_TAC THEN
       SPEC_TAC ((← q r"{i | i IN k /\ ~trivial_group ((G:K->A group) i)}"),
                (← q r"k:K->bool")) THEN
       MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
       SIMP_TAC [TRIVIAL_IMP_FINITELY_GENERATED_GROUP, FORALL_IN_INSERT,
                TRIVIAL_PRODUCT_GROUP, NOT_IN_EMPTY] THEN
       REPEAT GEN_TAC THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
       ASM_REWRITE_TAC [← GSYM FINITELY_GENERATED_PROD_GROUP] THEN
       MATCH_MP_TAC ISOMORPHIC_GROUP_FINITE_GENERATION THEN
       ASM_SIMP_TAC [ISOMORPHIC_PRODUCT_GROUP_INSERT]]))

  let FINITELY_GENERATED_SUM_GROUP ← prove
   r"!k (G:K->A group).
          finitely_generated_group(sum_group k G) <=>
          FINITE {i | i IN k /\ ~trivial_group(G i)} /\
          !i. i IN k ==> finitely_generated_group(G i)"
   (← do
    let r3 ← SET_RULE
      (← q r"i IN s /\ ~P i ==> Q i <=> i IN {i | i IN s /\ ~P i} ==> Q i")
    let r2 ← MESON [TRIVIAL_IMP_FINITELY_GENERATED_GROUP]
      (← q r"(!i. P i ==> finitely_generated_group(G i)) <=>
        (!i. P i /\ ~trivial_group(G i) ==> finitely_generated_group(G i))")
    let r1 ← TAUT
      (← q r"(p ==> q) /\ (q ==> (p <=> r)) ==> (p <=> q /\ r)")
    pure (REPEAT GEN_TAC THEN MATCH_MP_TAC r1 THEN
     CONJ_TAC THENL
      [REWRITE_TAC [FINITELY_GENERATED_GROUP] THEN
       REWRITE_TAC [SUM_GROUP_CLAUSES, IN_ELIM_THM, IN_CARTESIAN_PRODUCT,
                   SUBSET, LEFT_IMP_EXISTS_THM] THEN
       X_GEN_TAC (← q r"s:(K->A)->bool") THEN STRIP_TAC THEN
       MATCH_MP_TAC FINITE_SUBSET THEN
       EXISTS_TAC (← q r"UNIONS {{i | i IN k /\ ~((f:K->A) i = group_id(G i))} |
                           f IN s}") THEN
       ASM_SIMP_TAC [FINITE_UNIONS, FORALL_IN_GSPEC] THEN
       ASM_SIMP_TAC [FINITE_IMAGE, SIMPLE_IMAGE, UNIONS_IMAGE] THEN
       REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"i:K") THEN STRIP_TAC THEN
       FIRST_X_ASSUM (MP_TAC o
         GEN_REWRITE_RULE RAND_CONV [TRIVIAL_GROUP_SUBSET]) THEN
       REWRITE_TAC [SUBSET, IN_SING, NOT_IMP, NOT_FORALL_THM] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"x:A") STRIP_ASSUME_TAC) THEN
       ASM_REWRITE_TAC [← GSYM NOT_IMP, ← GSYM NOT_FORALL_THM] THEN DISCH_TAC THEN
       SUBGOAL_THEN
        (← q r"!f:K->A. f IN group_carrier(subgroup_generated (sum_group k G) s)
                  ==> f i = group_id(G i)")
       MP_TAC THENL
        [MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT THEN
         ASM_SIMP_TAC [] THEN REWRITE_TAC [← CONJUNCT2 SUM_GROUP_CLAUSES] THEN
         UNDISCH_TAC (← q r"(i:K) IN k") THEN SIMP_TAC [RESTRICTION] THEN
         SIMP_TAC [GROUP_MUL_LID, GROUP_ID, GROUP_INV_ID],
         ASM_REWRITE_TAC []] THEN
       DISCH_THEN (MP_TAC o SPEC
       (← q r"RESTRICTION k (\j. if j = i then x else group_id((G:K->A group) j))")) THEN
       ASM_REWRITE_TAC [GROUP_SUM_INJECTION] THEN
       ASM_REWRITE_TAC [RESTRICTION],
       DISCH_TAC] THEN
     wPart (fun t => do rand (← lhand t)) rand ISOMORPHIC_SUM_GROUP_SUPPORT THEN
     DISCH_THEN (SUBST1_TAC o SYM o
       MATCH_MP ISOMORPHIC_GROUP_FINITE_GENERATION) THEN
     ONCE_REWRITE_TAC [r2] THEN
     ONCE_REWRITE_TAC [r3] THEN
     POP_ASSUM MP_TAC THEN
     SPEC_TAC ((← q r"{i | i IN k /\ ~trivial_group ((G:K->A group) i)}"),
              (← q r"k:K->bool")) THEN
     MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
     SIMP_TAC [TRIVIAL_IMP_FINITELY_GENERATED_GROUP, FORALL_IN_INSERT,
              TRIVIAL_SUM_GROUP, NOT_IN_EMPTY] THEN
     REPEAT GEN_TAC THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
     ASM_REWRITE_TAC [← GSYM FINITELY_GENERATED_PROD_GROUP] THEN
     MATCH_MP_TAC ISOMORPHIC_GROUP_FINITE_GENERATION THEN
     ASM_SIMP_TAC [ISOMORPHIC_SUM_GROUP_INSERT]))

  let FINITE_GROUP_ACTIONS ← prove
   r"!G s (f:(A->X->X)->B).
          finitely_generated_group G /\ FINITE s /\
          (!a a'. (!g x. g IN group_carrier G /\ x IN s ==> a g x = a' g x)
                  ==> f a = f a')
          ==> FINITE {f a | group_action G s a}"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [FINITELY_GENERATED_GROUP]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    MATCH_MP_TAC (← ISPEC
     (← q r"\a:A->X->X. RESTRICTION (t CROSS s) (\(g,x). a g x)") FINITE_IMAGE_GEN) THEN
    EXISTS_TAC (← q r"cartesian_product ((t:A->bool) CROSS (s:X->bool)) (\x. s)") THEN
    ASM_SIMP_TAC [FINITE_CARTESIAN_PRODUCT, FINITE_CROSS, FINITE_RESTRICT] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [RESTRICTION_EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS] THEN CONJ_TAC THENL
     [REWRITE_TAC [group_action] THEN ASM SET_TAC [], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [(← q r"a:A->X->X"), (← q r"a':A->X->X")] THEN
    STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC GROUP_ACTIONS_EQ_ON_GENERATORS THEN ASM_MESON_TAC [])

  -- @@RETURN BEGIN
  return { finitely_generated_group, FINITELY_GENERATED_GROUP,
           CYCLIC_IMP_FINITELY_GENERATED_GROUP, FINITE_IMP_FINITELY_GENERATED_GROUP,
           TRIVIAL_IMP_FINITELY_GENERATED_GROUP,
           FINITELY_GENERATED_GROUP_EPIMORPHIC_IMAGE, ISOMORPHIC_GROUP_FINITE_GENERATION,
           FINITELY_GENERATED_GROUP_QUOTIENT_GROUP,
           FINITELY_GENERATED_IMP_COUNTABLE_GROUP, FINITELY_GENERATED_PROD_GROUP,
           FINITELY_GENERATED_PRODUCT_GROUP, FINITELY_GENERATED_SUM_GROUP,
           FINITE_GROUP_ACTIONS }
  -- @@RETURN END

structure FinitelyGeneratedSubgroups where
  -- @@FIELDS
  FINITELY_GENERATED_FIXED_INDEX_SUBGROUPS : thm
  FINITELY_GENERATED_FINITE_INDEX_SUBGROUP : thm
  FINITELY_GENERATED_ABELIAN_SUBGROUP_EXPLICIT : thm
  deriving Inhabited

@[nospecialize]
def setupFinitelyGeneratedSubgroups [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BGroupRule : GroupRule) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BIso2 : Iso2) (BSetwise1 : Setwise1) (BGroupActions : GroupActions) (BCosets : Cosets) (BCosets1 : Cosets1) (BCosets2 : Cosets2) (BCosetProducts : CosetProducts) (BNormalSubgroups : NormalSubgroups) (BNormalSubgroups2 : NormalSubgroups2) (BQuotientGroups : QuotientGroups) (BKernelsImages1 : KernelsImages1) (BKernelsImages2 : KernelsImages2) (BCyclicGroups1 : CyclicGroups1) (BFinitelyGenerated : FinitelyGenerated) :
    ExceptT String IO FinitelyGeneratedSubgroups := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        TAUT, .. } := D
  let { CARD_CLAUSES, CARD_DELETE, CARD_EQ_0, CARD_EQ_BIJECTIONS_SPECIAL, CARD_EQ_SYM,
        CARD_IMAGE_LE, CARD_LE_EQ_SUBSET_UNIV, CARD_LE_IMAGE, CARD_LE_TRANS,
        CARD_LE_UNIV, CARD_NUMSEG_1, CONJ_ASSOC, .. } := D.core1
  let { EMPTY_GSPEC, EQ_IMP, EXISTS_REFL, .. } := D.core2
  let { FINITE_DELETE, FINITE_DIFF, FINITE_EMPTY, FINITE_IMAGE, FINITE_IMAGE_EQ,
        FINITE_INSERT, FINITE_INTER, FINITE_NUMSEG, FINITE_SUBSET, FINITE_UNION,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_UNION, FORALL_SMALL_SUBSET_IMAGE,
        FUN_IN_IMAGE, HAS_SIZE, HAS_SIZE_0, .. } := D.core3
  let { IMAGE_EQ_EMPTY, IMAGE_SUBSET, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        INSERT_SUBSET, INTER_SUBSET, .. } := D.core4
  let { IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_INTER, IN_NUMSEG, IN_UNION, .. } := D.core5
  let { LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, LET_TRANS, LE_0, LE_REFL,
        MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core6
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_REFL,
        SUBSET_TRANS, SUBSET_UNIONS, SWAP_EXISTS_THM, UNIONS_SUBSET, UNION_SUBSET, .. } := D.core7
  let { num_WF, o_THM, .. } := D.core8
  let { GROUPS_EQ, GROUP_CARRIER_NONEMPTY, GROUP_ID, GROUP_INV, TRIVIAL_GROUP_SUBSET,
        trivial_group, .. } := BBasics
  let { GROUP_INV_INV, .. } := BDerived
  let { GROUP_TAC, .. } := BGroupRule
  let { IMAGE_GROUP_CONJUGATION_BY_ID, .. } := BConjugation
  let { IN_SUBGROUP_ID, IN_SUBGROUP_INV, IN_SUBGROUP_MUL, SUBGROUP_OF_IMP_SUBSET,
        SUBGROUP_OF_INTER, TRIVIAL_SUBGROUP_OF, .. } := BSubgroups
  let { ABELIAN_SUBGROUP_GENERATED, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET,
        GROUP_ID_SUBGROUP, SUBGROUP_GENERATED, SUBGROUP_GENERATED_MINIMAL,
        SUBGROUP_GENERATED_MONO, SUBGROUP_GENERATED_RESTRICT,
        SUBGROUP_GENERATED_SUPERSET, SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_INC_GEN, SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET,
        SUBGROUP_OF_SUBGROUP_GENERATED, SUBSET_CARRIER_SUBGROUP_GENERATED,
        TRIVIAL_GROUP_SUBGROUP_GENERATED, TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGen1
  let { GROUP_CARRIER_SUBGROUP_GENERATED_MONO, SUBGROUP_GENERATED_IDEMPOT,
        SUBGROUP_GENERATED_IDEMPOT_GEN, SUBGROUP_GENERATED_UNION,
        TRIVIAL_GROUP_SUBGROUP_GENERATED_EMPTY, .. } := BSubgroupGen2
  let { GROUP_ISOMORPHISMS_IMP_ISOMORPHISM, group_epimorphism, group_homomorphism,
        group_isomorphism, group_isomorphisms, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_MUL, .. } := BHomomorphisms1
  let { GROUP_ISOMORPHISM_IMP_EPIMORPHISM, SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE,
        SUBGROUP_OF_HOMOMORPHIC_IMAGE, .. } := BHomomorphisms2
  let { isomorphic_group, .. } := BIso1
  let { ISOMORPHIC_COPY_OF_GROUP, ISOMORPHIC_GROUP_ABELIANNESS, .. } := BIso2
  let { FINITE_GROUP_SETMUL, GROUP_SETINV_AS_IMAGE, group_setmul, .. } := BSetwise1
  let { group_action, group_stabilizer, .. } := BGroupActions
  let { LEFT_COSET_ID, RIGHT_COSET, RIGHT_COSET_EQ_SUBGROUP, RIGHT_COSET_ID, .. } := BCosets
  let { HAS_SIZE_LEFT_RIGHT_COSETS, UNIONS_RIGHT_COSETS, .. } := BCosets1
  let { GROUP_ACTION_LEFT_COSET_MULTIPLICATION,
        GROUP_STABILIZER_LEFT_COSET_MULTIPLICATION, .. } := BCosets2
  let { SCHREIER_TRANSVERSAL_LEMMA, .. } := BCosetProducts
  let { ABELIAN_GROUP_NORMAL_SUBGROUP, .. } := BNormalSubgroups
  let { CARRIER_SUBGROUP_GENERATED_UNION_LEFT, .. } := BNormalSubgroups2
  let { ABELIAN_QUOTIENT_GROUP, GROUP_EPIMORPHISM_RIGHT_COSET,
        GROUP_HOMOMORPHISM_RIGHT_COSET, QUOTIENT_GROUP, .. } := BQuotientGroups
