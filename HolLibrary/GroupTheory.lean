@[nospecialize]
def setupFinGenAbelianStructure [HolBase] (D : GroupTheoryDeps) (BSumGroup : SumGroup) (BIso1 : Iso1) (BIso2 : Iso2) (BGroupElementOrder2 : GroupElementOrder2) (BOrderDecomp : OrderDecomp) (BTorsionSubgroups : TorsionSubgroups) (BCyclicGroups1 : CyclicGroups1) (BFinitelyGenerated : FinitelyGenerated) (BIntegerGroup : IntegerGroup) (BIntegerModGroup : IntegerModGroup) (BCyclicInteger : CyclicInteger) (BFinitelyGeneratedAbelian : FinitelyGeneratedAbelian) :
    ExceptT String IO FinGenAbelianStructure := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, NUM_REDUCE_CONV, TAUT, .. } := D
  let { ARITH_EQ, CARD_EQ_BIJECTIONS, CARD_NUMSEG_1, CARTESIAN_PRODUCT_AS_RESTRICTIONS,
        COND_RAND, COND_RATOR, CONJ_ASSOC, .. } := D.core1
