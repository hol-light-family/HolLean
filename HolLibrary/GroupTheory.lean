  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IMP, RESTRICTION, RESTRICTION_EXTENSION, .. } := D.core6
  let { RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SWAP_EXISTS_THM, .. } := D.core7
