  let FINITELY_GENERATED_ABELIAN_SUBGROUP_STRUCTURE_EXPLICIT_ALT ← prove
   r"!G (s:A->bool).
        abelian_group G /\ FINITE s
        ==> ?t. FINITE t /\ CARD t <= CARD s /\ t SUBSET group_carrier G /\
                subgroup_generated G t = subgroup_generated G s /\
                subgroup_generated G s isomorphic_group
                product_group t (\x. subgroup_generated G {x})"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP
      FINITELY_GENERATED_ABELIAN_SUBGROUP_STRUCTURE_EXPLICIT) THEN
    MATCH_MP_TAC MONO_EXISTS THEN MESON_TAC [SUM_GROUP_EQ_PRODUCT_GROUP])

  let FINITELY_GENERATED_ABELIAN_GROUP_STRUCTURE_EXPLICIT ← prove
   r"!G:A group.
        finitely_generated_group G /\ abelian_group G <=>
        ?t. FINITE t /\ t SUBSET group_carrier G /\
            G isomorphic_group sum_group t (\x. subgroup_generated G {x})"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [FINITELY_GENERATED_GROUP]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"s:A->bool")]
        FINITELY_GENERATED_ABELIAN_SUBGROUP_STRUCTURE_EXPLICIT) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [],
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_FINITE_GENERATION) THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_ABELIANNESS) THEN
      ASM_REWRITE_TAC [FINITELY_GENERATED_SUM_GROUP, ABELIAN_SUM_GROUP] THEN
      ASM_SIMP_TAC [FINITE_RESTRICT, CYCLIC_IMP_FINITELY_GENERATED_GROUP,
                   CYCLIC_IMP_ABELIAN_GROUP, CYCLIC_GROUP_GENERATED]])

  let FINITELY_GENERATED_ABELIAN_GROUP_STRUCTURE_EXPLICIT_ALT ← prove
   r"!G:A group.
        finitely_generated_group G /\ abelian_group G <=>
        ?t. FINITE t /\ t SUBSET group_carrier G /\
            G isomorphic_group product_group t (\x. subgroup_generated G {x})"
   (REWRITE_TAC [FINITELY_GENERATED_ABELIAN_GROUP_STRUCTURE_EXPLICIT] THEN
    MESON_TAC [SUM_GROUP_EQ_PRODUCT_GROUP])

  let FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_CYCLIC_GROUPS ← prove
   r"!G:A group.
        finitely_generated_group G /\ abelian_group G <=>
        ?n H:num->A group.
            (!i. 1 <= i /\ i <= n ==> cyclic_group (H i)) /\
            G isomorphic_group sum_group (1..n) H"
   (GEN_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV
       [FINITELY_GENERATED_ABELIAN_GROUP_STRUCTURE_EXPLICIT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [(← q r"t:A->bool"), (← q r"1..CARD(t:A->bool)")]
          CARD_EQ_BIJECTIONS) THEN
      ASM_REWRITE_TAC [FINITE_NUMSEG, CARD_NUMSEG_1, LEFT_IMP_EXISTS_THM] THEN
      ABBREV_TAC (← q r"n = CARD(t:A->bool)") THEN REWRITE_TAC [← GSYM IN_NUMSEG] THEN
      MAP_EVERY X_GEN_TAC [(← q r"f:A->num"), (← q r"g:num->A")] THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC
       [(← q r"n:num"), (← q r"\i. subgroup_generated G {(g:num->A) i}")] THEN
      REWRITE_TAC [CYCLIC_GROUP_GENERATED] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ISOMORPHIC_GROUP_TRANS)) THEN
      MATCH_MP_TAC ISOMORPHIC_SUM_GROUP_BIJECTIONS THEN
      MAP_EVERY EXISTS_TAC [(← q r"f:A->num"), (← q r"g:num->A")] THEN
      ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [ISOMORPHIC_GROUP_REFL],
      STRIP_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_FINITE_GENERATION) THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_ABELIANNESS) THEN
      REWRITE_TAC [FINITELY_GENERATED_SUM_GROUP, ABELIAN_SUM_GROUP] THEN
      ASM_SIMP_TAC [FINITE_RESTRICT, CYCLIC_IMP_FINITELY_GENERATED_GROUP,
                   CYCLIC_IMP_ABELIAN_GROUP, FINITE_NUMSEG, IN_NUMSEG]])

  let FINITELY_GENERATED_ABELIAN_GROUP_AS_PRODUCT_OF_CYCLIC_GROUPS ← prove
   r"!G:A group.
        finitely_generated_group G /\ abelian_group G <=>
        ?n H:num->A group.
            (!i. 1 <= i /\ i <= n ==> cyclic_group (H i)) /\
            G isomorphic_group product_group (1..n) H"
   (REWRITE_TAC [FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_CYCLIC_GROUPS] THEN
    SIMP_TAC [SUM_GROUP_EQ_PRODUCT_GROUP, FINITE_NUMSEG])

  let FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_INTEGER_MOD_GROUPS ← prove
   r"!G:A group.
      finitely_generated_group G /\ abelian_group G <=>
      ?n d. G isomorphic_group sum_group (1..n) (\i. integer_mod_group(d i))"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_CYCLIC_GROUPS] THEN
      REWRITE_TAC [ISOMORPHIC_GROUP_CYCLIC_INTEGER] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
       [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_AND_EXISTS_THM] THEN
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [SWAP_EXISTS_THM] THEN
      REWRITE_TAC [← GSYM IN_NUMSEG] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:num->num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ISOMORPHIC_GROUP_TRANS)) THEN
      MATCH_MP_TAC ISOMORPHIC_GROUP_SUM_GROUP THEN ASM_REWRITE_TAC [],
      STRIP_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_FINITE_GENERATION) THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_ABELIANNESS) THEN
      REWRITE_TAC [FINITELY_GENERATED_SUM_GROUP, ABELIAN_SUM_GROUP] THEN
      ASM_SIMP_TAC [FINITE_RESTRICT, CYCLIC_IMP_FINITELY_GENERATED_GROUP,
                   FINITE_NUMSEG, CYCLIC_IMP_ABELIAN_GROUP,
                   CYCLIC_GROUP_INTEGER_MOD_GROUP]])

  let FINITELY_GENERATED_ABELIAN_GROUP_AS_PRODUCT_OF_INTEGER_MOD_GROUPS ← prove
   r"!G:A group.
      finitely_generated_group G /\ abelian_group G <=>
      ?n d. G isomorphic_group
            product_group (1..n) (\i. integer_mod_group(d i))"
   (REWRITE_TAC
     [FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_INTEGER_MOD_GROUPS] THEN
    SIMP_TAC [SUM_GROUP_EQ_PRODUCT_GROUP, FINITE_NUMSEG])

  let FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_INTEGER_GROUPS ← prove
   r"!G:A group.
      finitely_generated_group G /\ abelian_group G /\
      (!x. x IN group_carrier G ==> group_element_order G x <= 1) <=>
      ?n. G isomorphic_group sum_group (1..n) (\i. integer_group)"
   (← do
    let a2 ← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")
    let a1 ← TAUT (← q r"(~p ==> F) ==> p")
    pure (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [CONJ_ASSOC,
       FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_INTEGER_MOD_GROUPS] THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [(← q r"n:num"), (← q r"d:num->num")] THEN REWRITE_TAC [IMP_CONJ] THEN
      DISCH_THEN (fun th => tactic_of do
        let r ← MATCH_MP ISOMORPHIC_GROUP_TORSION th
        pure (REWRITE_TAC [r] THEN MP_TAC th)) THEN
      wPart (fun t => do rand (← lhand t)) rand
        ISOMORPHIC_SUM_GROUP_SUPPORT THEN
      GEN_REWRITE_TAC LAND_CONV [ISOMORPHIC_GROUP_SYM] THEN
      GEN_REWRITE_TAC I [← GSYM IMP_CONJ_ALT] THEN
      DISCH_THEN (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_TRANS) THEN
      REWRITE_TAC [TRIVIAL_INTEGER_MOD_GROUP] THEN REPEAT STRIP_TAC THEN
      ABBREV_TAC (← q r"m = CARD {i | i IN 1..n /\ ~(d i = 1)}") THEN
      EXISTS_TAC (← q r"m:num") THEN MP_TAC (← ISPECL
       [(← q r"{i | i IN 1..n /\ ~(d i = 1)}"), (← q r"1..m")] CARD_EQ_BIJECTIONS) THEN
      ASM_SIMP_TAC [CARD_NUMSEG_1, FINITE_NUMSEG, FINITE_RESTRICT] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN
      MAP_EVERY X_GEN_TAC [(← q r"f:num->num"), (← q r"g:num->num")] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ISOMORPHIC_GROUP_TRANS)) THEN
      MATCH_MP_TAC ISOMORPHIC_SUM_GROUP_BIJECTIONS THEN
      MAP_EVERY EXISTS_TAC [(← q r"f:num->num"), (← q r"g:num->num")] THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      REWRITE_TAC [← GSYM INTEGER_MOD_GROUP_TRIVIAL] THEN
      REWRITE_TAC [ISOMORPHIC_INTEGER_MOD_GROUPS] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      MATCH_MP_TAC a1 THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"RESTRICTION (1..n)
          (\j. if j = i then &1 else group_id (integer_mod_group(d j)))") o
       REWRITE_RULE [TORSION_FREE_GROUP]) THEN
      SIMP_TAC [GROUP_ELEMENT_ORDER_SUM_GROUP_EQ_0] THEN
      REWRITE_TAC [GROUP_SUM_INJECTION] THEN
      ASM_REWRITE_TAC [INTEGER_MOD_GROUP_1, SUM_GROUP_CLAUSES] THEN
      REWRITE_TAC [RESTRICTION_EXTENSION, INTEGER_MOD_GROUP] THEN
      ONCE_REWRITE_TAC [a2] THEN
      SIMP_TAC [RESTRICTION] THEN ONCE_REWRITE_TAC [COND_RAND] THEN
      ONCE_REWRITE_TAC [COND_RATOR] THEN
      REWRITE_TAC [GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP] THEN
      REWRITE_TAC [INT_OF_NUM_EQ] THEN CONV_TAC NUM_REDUCE_CONV THEN
      REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"j:num") THEN
      ASM_CASES_TAC (← q r"j:num = i") THEN ASM_REWRITE_TAC [GCD_1, DIV_1] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [ARITH_EQ, GCD_0] THEN
      ASM_SIMP_TAC [DIV_REFL, ARITH_EQ],
      STRIP_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_FINITE_GENERATION) THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_ABELIANNESS) THEN
      REWRITE_TAC [FINITELY_GENERATED_SUM_GROUP, ABELIAN_SUM_GROUP] THEN
      ASM_SIMP_TAC [FINITE_RESTRICT, CYCLIC_IMP_FINITELY_GENERATED_GROUP,
                   FINITE_NUMSEG, CYCLIC_IMP_ABELIAN_GROUP,
                   CYCLIC_INTEGER_GROUP] THEN
      FIRST_ASSUM (fun th => tactic_of do
        let r ← MATCH_MP ISOMORPHIC_GROUP_TORSION th
        pure (REWRITE_TAC [r])) THEN
      REWRITE_TAC [TORSION_FREE_GROUP] THEN
      SIMP_TAC [GROUP_ELEMENT_ORDER_SUM_GROUP_EQ_0] THEN
      SIMP_TAC [GROUP_ELEMENT_ORDER_INTEGER_GROUP, INTEGER_GROUP] THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, IMP_CONJ, IN_ELIM_THM] THEN
      REWRITE_TAC [CARTESIAN_PRODUCT_AS_RESTRICTIONS, FORALL_IN_GSPEC,
                  IMP_CONJ, RESTRICTION_EXTENSION, INTEGER_GROUP] THEN
      GEN_TAC THEN DISCH_TAC THEN DISCH_TAC THEN REWRITE_TAC [NOT_FORALL_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      GEN_TAC THEN SIMP_TAC [NOT_IMP, RESTRICTION]]))

  let FINITELY_GENERATED_ABELIAN_GROUP_AS_PRODUCT_OF_INTEGER_GROUPS ← prove
   r"!G:A group.
      finitely_generated_group G /\ abelian_group G /\
      (!x. x IN group_carrier G ==> group_element_order G x <= 1) <=>
      ?n. G isomorphic_group product_group (1..n) (\i. integer_group)"
   (REWRITE_TAC [FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_INTEGER_GROUPS] THEN
    SIMP_TAC [SUM_GROUP_EQ_PRODUCT_GROUP, FINITE_NUMSEG])

  -- @@RETURN BEGIN
  return { FINITELY_GENERATED_ABELIAN_SUBGROUP_STRUCTURE_ISOMORPHISM_ALT,
           FINITELY_GENERATED_ABELIAN_SUBGROUP_STRUCTURE_EXPLICIT,
           FINITELY_GENERATED_ABELIAN_SUBGROUP_STRUCTURE_EXPLICIT_ALT,
           FINITELY_GENERATED_ABELIAN_GROUP_STRUCTURE_EXPLICIT,
           FINITELY_GENERATED_ABELIAN_GROUP_STRUCTURE_EXPLICIT_ALT,
           FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_CYCLIC_GROUPS,
           FINITELY_GENERATED_ABELIAN_GROUP_AS_PRODUCT_OF_CYCLIC_GROUPS,
           FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_INTEGER_MOD_GROUPS,
           FINITELY_GENERATED_ABELIAN_GROUP_AS_PRODUCT_OF_INTEGER_MOD_GROUPS,
           FINITELY_GENERATED_ABELIAN_GROUP_AS_SUM_OF_INTEGER_GROUPS,
           FINITELY_GENERATED_ABELIAN_GROUP_AS_PRODUCT_OF_INTEGER_GROUPS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Free Abelian groups on a set, using the "frag" type constructor.          -/
/- ------------------------------------------------------------------------- -/

structure FreeAbelianGroup where
  -- @@FIELDS
  free_abelian_group : thm
  FREE_ABELIAN_GROUP : thm
  ABELIAN_FREE_ABELIAN_GROUP : thm
  FREE_ABELIAN_GROUP_POW : thm
  FREE_ABELIAN_GROUP_ZPOW : thm
  FRAG_OF_IN_FREE_ABELIAN_GROUP : thm
  FREE_ABELIAN_GROUP_INDUCT : thm
  FREE_ABELIAN_GROUP_UNIVERSAL : thm
  ISOMORPHIC_GROUP_INTEGER_FREE_ABELIAN_GROUP_SING : thm
  GROUP_HOMOMORPHISM_FREE_ABELIAN_GROUPS_ID : thm
  GROUP_ISOMORPHISM_FREE_ABELIAN_GROUP_SUM : thm
  deriving Inhabited

@[nospecialize]
def setupFreeAbelianGroup [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BTotalized : Totalized) (BSubgroups : Subgroups) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BKernelsImages1 : KernelsImages1) (BIntegerGroup : IntegerGroup) :
    ExceptT String IO FreeAbelianGroup := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, FRAG_MODULE, INDUCT_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        TAUT, new_definition, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { CONTRAPOS_THM, DEST_FRAG_ADD, DEST_FRAG_OF, EMPTY_SUBSET, EQ_TRANS, .. } := D.core2
  let { EXTENSIONAL, FINITE_FRAG_SUPPORT, FINITE_SING, FINITE_SUBSET, FORALL_INT_CASES,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_IN_UNIONS,
        FRAG_INDUCTION, FRAG_OF_NONZERO, FRAG_SUPPORT_0, FRAG_SUPPORT_ADD,
        FRAG_SUPPORT_CMUL, FRAG_SUPPORT_EQ_EMPTY, FRAG_SUPPORT_NEG, FRAG_SUPPORT_OF,
        FRAG_SUPPORT_SUB, FRAG_SUPPORT_SUM, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, .. } := D.core4
  let { INT_OF_NUM_SUC, IN_DELETE, IN_ELIM_THM, IN_IMAGE, IN_SING, IN_UNIV,
        ITERATE_CLAUSES_GEN, ITERATE_CLOSED, ITERATE_EQ, ITERATE_OP_GEN, ITERATE_SING,
        ITERATE_SUPERSET, .. } := D.core5
  let { MONOIDAL_FRAG_ADD, NEUTRAL_FRAG_ADD, NOT_IN_EMPTY, RESTRICTION, .. } := D.core6
  let { RESTRICTION_IN_CARTESIAN_PRODUCT, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SING_SUBSET, SUBSET, SUBSET_TRANS, UNION_SUBSET, cartesian_product,
        frag_support, .. } := D.core7
  let { pairwise, support, .. } := D.core8
  let { GROUP_ID, group_carrier, group_id, group_inv, group_mul, group_tybij, .. } := BBasics
  let { group_div, group_pow, .. } := BDerived
  let { GROUP_NPOW, GROUP_ZPOW, GROUP_ZPOW_0, GROUP_ZPOW_1, GROUP_ZPOW_ADD,
        GROUP_ZPOW_POW, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { GROUP_ADD, GROUP_ADD_EQ_MUL, MONOIDAL_GROUP_ADD, NEUTRAL_GROUP_ADD, .. } := BTotalized
  let { IN_SUBGROUP_DIV, IN_SUBGROUP_ID, .. } := BSubgroups
  let { SUM_GROUP_CLAUSES, .. } := BSumGroup
  let { GROUP_HOMOMORPHISM, group_homomorphism, .. } := BHomomorphisms
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { isomorphic_group, .. } := BIso1
  let { GROUP_EPIMORPHISM_ALT, GROUP_MONOMORPHISM_ALT, SUBGROUP_GROUP_IMAGE,
        group_image, .. } := BKernelsImages1
  let { INTEGER_GROUP, .. } := BIntegerGroup
  -- @@SCOPE END

  let free_abelian_group ← new_definition
   r"free_abelian_group (s:A->bool) =
      group({c | frag_support c SUBSET s},frag_0,frag_neg,frag_add)"

  let FREE_ABELIAN_GROUP ← prove
   r"(!s:A->bool.
        group_carrier(free_abelian_group s) = {c | frag_support c SUBSET s}) /\
   (!s:A->bool. group_id(free_abelian_group s) = frag_0) /\
   (!s:A->bool. group_inv(free_abelian_group s) = frag_neg) /\
   (!s:A->bool. group_mul(free_abelian_group s) = frag_add)"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN
    MP_TAC (← EQ_IMP_RULE
     (← ISPEC (← liftExcept (do rand (← rand (strip_forall (concl free_abelian_group)).2)))
       (← CONJUNCT2 group_tybij))).1 THEN
    REWRITE_TAC [← GSYM free_abelian_group] THEN ANTS_TAC THENL
     [SIMP_TAC [IN_ELIM_THM, FRAG_SUPPORT_NEG, FRAG_SUPPORT_0, EMPTY_SUBSET] THEN
      CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN
        wPart lhand lhand FRAG_SUPPORT_ADD THEN
        ASM SET_TAC [],
        REPEAT STRIP_TAC THEN CONV_TAC (fun t => (FRAG_MODULE t).run)],
      SIMP_TAC [group_carrier, group_id, group_inv, group_mul]])

  let ABELIAN_FREE_ABELIAN_GROUP ← prove
   r"!s:A->bool. abelian_group(free_abelian_group s)"
   (REWRITE_TAC [abelian_group, FREE_ABELIAN_GROUP] THEN
    REPEAT STRIP_TAC THEN CONV_TAC (fun t => (FRAG_MODULE t).run))

  let FREE_ABELIAN_GROUP_POW ← prove
   r"!(s:A->bool) x n.
        group_pow (free_abelian_group s) x n = frag_cmul (&n) x"
   (GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [FREE_ABELIAN_GROUP, group_pow, ← GSYM INT_OF_NUM_SUC] THEN
    CONV_TAC (fun t => (FRAG_MODULE t).run))

  let FREE_ABELIAN_GROUP_ZPOW ← prove
   r"!(s:A->bool) x n.
        group_zpow (free_abelian_group s) x n = frag_cmul n x"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [FORALL_INT_CASES] THEN
    REWRITE_TAC [GROUP_ZPOW_POW, FREE_ABELIAN_GROUP_POW, FREE_ABELIAN_GROUP] THEN
    CONV_TAC (fun t => (FRAG_MODULE t).run))

  let FRAG_OF_IN_FREE_ABELIAN_GROUP ← prove
   r"!s x:A. frag_of x IN group_carrier(free_abelian_group s) <=> x IN s"
   (REWRITE_TAC [FREE_ABELIAN_GROUP, FRAG_SUPPORT_OF, SING_SUBSET, IN_ELIM_THM])

  let FREE_ABELIAN_GROUP_INDUCT ← prove
   r"!P s:A->bool.
        P(frag_0) /\
        (!x y. x IN group_carrier(free_abelian_group s) /\
               y IN group_carrier(free_abelian_group s) /\
               P x /\ P y
               ==> P(frag_sub x y)) /\
        (!a. a IN s ==> P(frag_of a))
        ==> !x. x IN group_carrier(free_abelian_group s) ==> P x"
   (← do
    let a1 ← TAUT (← q r"p ==> q <=> p ==> p /\ q")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [FREE_ABELIAN_GROUP, IN_ELIM_THM] THEN
    STRIP_TAC THEN
    ONCE_REWRITE_TAC [a1] THEN
    MATCH_MP_TAC FRAG_INDUCTION THEN
    ASM_SIMP_TAC [FRAG_SUPPORT_OF, FRAG_SUPPORT_0, EMPTY_SUBSET, SING_SUBSET] THEN
    ASM_MESON_TAC [FRAG_SUPPORT_SUB, SUBSET_TRANS, UNION_SUBSET]))

  let FREE_ABELIAN_GROUP_UNIVERSAL ← prove
   r"!(f:A->B) s G.
        IMAGE f s SUBSET group_carrier G /\ abelian_group G
        ==> ?h. group_homomorphism(free_abelian_group s,G) h /\
                !x. x IN s ==> h(frag_of x) = f x"
   (← do
    let a1 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\x. iterate (group_add G) s
                            (\a. group_zpow G ((f:A->B) a) (dest_frag x a))") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      TRANS_TAC EQ_TRANS
        (← q r"iterate (group_add G) {x}
           (\a. group_zpow G ((f:A->B) a) (dest_frag (frag_of x) a))") THEN
      CONJ_TAC THENL
       [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP ITERATE_SUPERSET o
          GEN_REWRITE_RULE I [← GSYM MONOIDAL_GROUP_ADD]) THEN
        SIMP_TAC [IN_UNIV, IN_SING, SUBSET, DEST_FRAG_OF, NEUTRAL_GROUP_ADD] THEN
        ASM_REWRITE_TAC [GROUP_ZPOW_0],
        ASM_SIMP_TAC [ITERATE_SING, MONOIDAL_GROUP_ADD] THEN
        ASM_SIMP_TAC [DEST_FRAG_OF, GROUP_ZPOW_1]]] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM, SUBSET, FORALL_IN_IMAGE] THEN
    MATCH_MP_TAC a1 THEN CONJ_TAC THENL
     [FIRST_ASSUM (MP_TAC o ISPEC (← q r"\x:B. x IN group_carrier G") o
        MATCH_MP ITERATE_CLOSED o
        GEN_REWRITE_RULE I [← GSYM MONOIDAL_GROUP_ADD]) THEN
      REWRITE_TAC [GROUP_ID, NEUTRAL_GROUP_ADD, GROUP_ADD] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [FREE_ABELIAN_GROUP, SUBSET, IN_ELIM_THM]) THEN
      X_GEN_TAC (← q r"a:A") THEN
      ASM_CASES_TAC (← q r"dest_frag x (a:A) = &0") THEN
      ASM_REWRITE_TAC [GROUP_ZPOW_0] THEN STRIP_TAC THEN
      MATCH_MP_TAC GROUP_ZPOW THEN
      RULE_ASSUM_TAC (REWRITE_RULE [frag_support]) THEN ASM SET_TAC [],
      DISCH_TAC] THEN
    ASM_SIMP_TAC [← GSYM GROUP_ADD_EQ_MUL] THEN
    MAP_EVERY X_GEN_TAC [(← q r"x:A frag"), (← q r"y:A frag")] THEN STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
     let m ← MATCH_MP ITERATE_OP_GEN (← GEN_REWRITE_RULE I [← GSYM MONOIDAL_GROUP_ADD] th)
     pure (wPart (fun t => do rand t) (fun t => do rand (← rand t)) m)) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC FINITE_SUBSET THENL
       [EXISTS_TAC (← q r"frag_support x:A->bool"),
        EXISTS_TAC (← q r"frag_support y:A->bool")] THEN
      REWRITE_TAC [FINITE_FRAG_SUPPORT] THEN
      REWRITE_TAC [support, frag_support, FREE_ABELIAN_GROUP] THEN
      SIMP_TAC [SUBSET, IN_ELIM_THM, IN_UNIV, CONTRAPOS_THM, IMP_CONJ] THEN
      REWRITE_TAC [NEUTRAL_GROUP_ADD, GROUP_NPOW, group_pow],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP ITERATE_EQ o
          GEN_REWRITE_RULE I [← GSYM MONOIDAL_GROUP_ADD]) THEN
    ASM_SIMP_TAC [GROUP_ADD_EQ_MUL, FREE_ABELIAN_GROUP, DEST_FRAG_ADD,
                 GROUP_ZPOW_ADD, GROUP_ZPOW]))

  let ISOMORPHIC_GROUP_INTEGER_FREE_ABELIAN_GROUP_SING ← prove
   r"!x:A. integer_group isomorphic_group free_abelian_group {x}"
   (← do
    let a7 ← FRAG_MODULE (← q r"frag_sub (frag_cmul a c) (frag_cmul b c) =
                 frag_cmul (a - b) c")
    let a6 ← FRAG_MODULE (← q r"frag_cmul (&1) x = x")
    let a5 ← FRAG_MODULE (← q r"frag_cmul (&0) x = frag_0")
    let a4 ← TAUT (← q r"p /\ p /\ q <=> p /\ q")
    let a3 ← FRAG_MODULE (← q r"frag_cmul c x = frag_0 <=> c = &0 \/ x = frag_0")
    let a2 ← FRAG_MODULE (← q
     r"frag_cmul(a + b) c = frag_add (frag_cmul a c) (frag_cmul b c)")
    let a1 ← FRAG_MODULE (← q r"frag_cmul (--n) x = frag_neg(frag_cmul n x)")
    pure (GEN_TAC THEN REWRITE_TAC [isomorphic_group] THEN
    EXISTS_TAC (← q r"\n. frag_cmul n (frag_of(x:A))") THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM, GROUP_MONOMORPHISM_ALT,
                GROUP_EPIMORPHISM_ALT, group_image] THEN
    REWRITE_TAC [group_homomorphism, INTEGER_GROUP, FREE_ABELIAN_GROUP] THEN
    REWRITE_TAC [IN_UNIV, FRAG_OF_NONZERO, a1, a2, a3] THEN
    ONCE_REWRITE_TAC [SUBSET] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM, IN_UNIV] THEN
    REWRITE_TAC [a4] THEN CONJ_TAC THENL
     [MESON_TAC [FRAG_SUPPORT_CMUL, FRAG_SUPPORT_OF], ALL_TAC] THEN
    MATCH_MP_TAC FRAG_INDUCTION THEN
    REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, IN_IMAGE, IN_UNIV] THEN
    MESON_TAC [a5, a6, a7]))

  let GROUP_HOMOMORPHISM_FREE_ABELIAN_GROUPS_ID ← prove
   r"!k k':A->bool.
    group_homomorphism (free_abelian_group k,free_abelian_group k') (\x. x) <=>
    k SUBSET k'"
   (REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [FREE_ABELIAN_GROUP, IN_ELIM_THM] THEN REPEAT GEN_TAC THEN
    EQ_TAC THENL [DISCH_TAC, SET_TAC []] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"frag_of(x:A)")) THEN
    ASM_REWRITE_TAC [FRAG_SUPPORT_OF, SING_SUBSET])

  let GROUP_ISOMORPHISM_FREE_ABELIAN_GROUP_SUM ← prove
   r"!k (f:K->A->bool).
        pairwise (\i j. DISJOINT (f i) (f j)) k
        ==> group_isomorphism (sum_group k (\i. free_abelian_group(f i)),
                               free_abelian_group(UNIONS {f i | i IN k}))
                              (iterate frag_add k)"
   (← do
    let a8 ← FRAG_MODULE (← q r"frag_add x (frag_neg y) = frag_sub x y")
    let a7 ← SET_RULE (← q
     r"DISJOINT a (UNIONS {f i | i IN s}) <=>
        !i. i IN s ==> DISJOINT a (f i)")
    let a6 ← SET_RULE (← q
     r"DISJOINT t u ==> s SUBSET t ==> DISJOINT s u")
    let a5 ← SET_RULE (← q
     r"!u. s SUBSET u /\ DISJOINT t u ==> s = t ==> t = {}")
    let a4 ← MESON [FRAG_SUPPORT_NEG] (← q
     r"x = frag_neg y ==> frag_support x = frag_support y")
    let a3 ← FRAG_MODULE (← q r"frag_add x y = frag_0 <=> y = frag_neg x")
    let a2 ← SET_RULE (← q r"x IN s ==> x INSERT (s DELETE x) = s")
    let a1 ← TAUT (← q r"p /\ q /\ (p ==> r) ==> (p /\ q) /\ (p /\ r)")
    pure (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM,
                GROUP_EPIMORPHISM_ALT, GROUP_MONOMORPHISM_ALT] THEN
    MATCH_MP_TAC a1 THEN
    CONJ_TAC THENL
     [REWRITE_TAC [GROUP_HOMOMORPHISM, SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, FREE_ABELIAN_GROUP, IN_ELIM_THM] THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN REPEAT STRIP_TAC THENL
       [wPart lhand lhand FRAG_SUPPORT_SUM THEN
        ASM SET_TAC [],
        wPart (fun t => do rand t) (fun t => do rand (← rand t))
          (← MATCH_MP ITERATE_OP_GEN MONOIDAL_FRAG_ADD) THEN
        ASM_REWRITE_TAC [support, NEUTRAL_FRAG_ADD] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC (← MATCH_MP ITERATE_EQ MONOIDAL_FRAG_ADD) THEN
        SIMP_TAC [RESTRICTION]],
      ONCE_REWRITE_TAC [SUBSET]] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [FREE_ABELIAN_GROUP, SUM_GROUP_CLAUSES, IN_ELIM_THM] THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM, EXTENSIONAL] THEN
      X_GEN_TAC (← q r"x:K->A frag") THEN STRIP_TAC THEN
      GEN_REWRITE_TAC I [FUN_EQ_THM] THEN X_GEN_TAC (← q r"i:K") THEN
      ASM_CASES_TAC (← q r"(i:K) IN k") THEN ASM_SIMP_TAC [RESTRICTION] THEN
      REWRITE_TAC [← GSYM FRAG_SUPPORT_EQ_EMPTY] THEN
      SUBGOAL_THEN
       (← q r"iterate frag_add (i INSERT (k DELETE i)) (x:K->A frag) = frag_0")
      MP_TAC THENL
       [ASM_SIMP_TAC [a2],
        wPart (fun t => do lhand (← lhand t)) (fun t => do lhand (← rand t))
         (← CONJUNCT2 (← MATCH_MP ITERATE_CLAUSES_GEN MONOIDAL_FRAG_ADD))] THEN
      REWRITE_TAC [IN_DELETE] THEN ANTS_TAC THENL
       [REWRITE_TAC [support, NEUTRAL_FRAG_ADD] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN SET_TAC [],
        DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [FREE_ABELIAN_GROUP, a3] THEN
      DISCH_THEN (MP_TAC o MATCH_MP a4) THEN
      MATCH_MP_TAC a5 THEN
      EXISTS_TAC (← q r"UNIONS {(f:K->A->bool) j | j IN (k DELETE i)}") THEN
      CONJ_TAC THENL
       [wPart lhand lhand FRAG_SUPPORT_SUM THEN
        ASM SET_TAC [],
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC a6 THEN
        REWRITE_TAC [a7] THEN
        X_GEN_TAC (← q r"j:K") THEN REWRITE_TAC [IN_DELETE] THEN STRIP_TAC THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM_MESON_TAC []],
      DISCH_THEN (ASSUME_TAC o MATCH_MP SUBGROUP_GROUP_IMAGE) THEN
      REWRITE_TAC [FREE_ABELIAN_GROUP, IN_ELIM_THM] THEN
      MATCH_MP_TAC FRAG_INDUCTION THEN REPEAT CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_SUBGROUP_ID) THEN
        REWRITE_TAC [FREE_ABELIAN_GROUP],
        ALL_TAC,
        FIRST_X_ASSUM (MP_TAC o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ, RIGHT_FORALL_IMP_THM] IN_SUBGROUP_DIV)) THEN
        REWRITE_TAC [FREE_ABELIAN_GROUP, group_div] THEN
        SIMP_TAC [a8]] THEN
      REWRITE_TAC [FORALL_IN_UNIONS] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
      REWRITE_TAC [group_image, IN_IMAGE] THEN EXISTS_TAC
       (← q r"RESTRICTION k (\j:K. if j = i then frag_of(a:A) else frag_0)") THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, IN_ELIM_THM, RESTRICTION_IN_CARTESIAN_PRODUCT] THEN
      REWRITE_TAC [FREE_ABELIAN_GROUP] THEN REPEAT CONJ_TAC THENL
       [TRANS_TAC EQ_TRANS
         (← q r"iterate frag_add {i}
           (RESTRICTION k (\j:K. if j = i then frag_of(a:A) else frag_0))") THEN
        CONJ_TAC THENL
         [SIMP_TAC [← MATCH_MP ITERATE_SING MONOIDAL_FRAG_ADD] THEN
          ASM_REWRITE_TAC [RESTRICTION],
          CONV_TAC SYM_CONV THEN MATCH_MP_TAC (← REWRITE_RULE
           [IMP_IMP, RIGHT_IMP_FORALL_THM] ITERATE_SUPERSET) THEN
          REWRITE_TAC [MONOIDAL_FRAG_ADD] THEN
          ASM_REWRITE_TAC [SING_SUBSET, IN_SING, NEUTRAL_FRAG_ADD] THEN
          SIMP_TAC [RESTRICTION, IN_ELIM_THM]],
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [IN_ELIM_THM, FRAG_SUPPORT_OF, SING_SUBSET] THEN
        REWRITE_TAC [FRAG_SUPPORT_0, EMPTY_SUBSET],
        MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{i:K}") THEN
        REWRITE_TAC [FINITE_SING, SUBSET, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"j:K") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        ASM_REWRITE_TAC [RESTRICTION, IN_SING] THEN
        MESON_TAC []]]))

  -- @@RETURN BEGIN
  return { free_abelian_group, FREE_ABELIAN_GROUP, ABELIAN_FREE_ABELIAN_GROUP,
           FREE_ABELIAN_GROUP_POW, FREE_ABELIAN_GROUP_ZPOW,
           FRAG_OF_IN_FREE_ABELIAN_GROUP, FREE_ABELIAN_GROUP_INDUCT,
           FREE_ABELIAN_GROUP_UNIVERSAL,
           ISOMORPHIC_GROUP_INTEGER_FREE_ABELIAN_GROUP_SING,
           GROUP_HOMOMORPHISM_FREE_ABELIAN_GROUPS_ID,
           GROUP_ISOMORPHISM_FREE_ABELIAN_GROUP_SUM }
  -- @@RETURN END

structure FreeAbelianExtra where
  -- @@FIELDS
  ISOMORPHIC_FREE_ABELIAN_GROUP_UNIONS : thm
  ISOMORPHIC_SUM_INTEGER_GROUP : thm
  CARD_EQ_FREE_ABELIAN_GROUP_INFINITE : thm
  CARD_EQ_HOMOMORPHISMS_FROM_FREE_ABELIAN_GROUP : thm
  ISOMORPHIC_FREE_ABELIAN_GROUPS : thm
  deriving Inhabited

@[nospecialize]
def setupFreeAbelianExtra [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BIso1 : Iso1) (BIso2 : Iso2) (BIntegerModGroup : IntegerModGroup) (BFreeAbelianGroup : FreeAbelianGroup) :
    ExceptT String IO FreeAbelianExtra := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, FRAG_MODULE, INT_ARITH, INT_REDUCE_CONV, MESON,
        MESON_TAC, NUM_REDUCE_CONV, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARD_CLAUSES, CARD_EQ_CARD, CARD_EQ_FINITE_SUBSETS, CARD_EQ_IMP_LE,
        CARD_EQ_SYM, CARD_EQ_TRANS, CARD_EXP_C, CARD_EXP_FINITE_EQ, CARD_FINITE_CONG,
        CARD_LE_ANTISYM, CARD_LE_COUNTABLE_INFINITE, CARD_LE_RESTRICTED_FUNSPACE,
        CARD_LE_TRANS, CARD_MUL_ABSORB, CARD_MUL_SYM, .. } := D.core1
  let { CROSS, DE_MORGAN_THM, EMPTY_SUBSET, EQ_C_BIJECTIONS, EQ_EXP, ETA_AX,
        EXISTS_UNIQUE_DEF, EXP_C, .. } := D.core2
  let { EXTENSIONAL, FINITE_CROSS_EQ, FINITE_EMPTY, FINITE_FRAG_SUPPORT, FINITE_INSERT,
        FORALL_IN_IMAGE, FRAG_EQ, FRAG_INDUCTION, FRAG_OF_EQ, FRAG_SUPPORT_0,
        FRAG_SUPPORT_ADD, FRAG_SUPPORT_NEG, FRAG_SUPPORT_OF, FRAG_SUPPORT_SUB,
        FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, IN, INFINITE, INFINITE_NONEMPTY, INT_COUNTABLE, .. } := D.core4
  let { IN_ELIM_THM, IN_GSPEC, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, RESTRICTION, .. } := D.core6
  let { RESTRICTION_IN_EXTENSIONAL, SING_SUBSET, SUBSET, SUBSET_TRANS, SUBSET_UNIV,
        UNIONS_SINGS, UNION_SUBSET, UNIV_NOT_EMPTY, eq_c, frag_support, le_c, mul_c, .. } := D.core7
  let { o_THM, pairwise, .. } := D.core8
  let { GROUP_MUL, .. } := BBasics
  let { group_div, .. } := BDerived
  let { GROUP_HOMOMORPHISM, GROUP_HOMOMORPHISM_EQ, group_homomorphism,
        group_isomorphism, group_isomorphisms, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_COMPOSE, GROUP_HOMOMORPHISM_DIV, .. } := BHomomorphisms1
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRANS,
        isomorphic_group, .. } := BIso1
  let { ISOMORPHIC_GROUP_CARD_EQ, ISOMORPHIC_GROUP_SUM_GROUP, .. } := BIso2
  let { ABELIAN_INTEGER_MOD_GROUP, INTEGER_MOD_GROUP, .. } := BIntegerModGroup
  let { ABELIAN_FREE_ABELIAN_GROUP, FREE_ABELIAN_GROUP, FREE_ABELIAN_GROUP_UNIVERSAL,
        GROUP_ISOMORPHISM_FREE_ABELIAN_GROUP_SUM,
        ISOMORPHIC_GROUP_INTEGER_FREE_ABELIAN_GROUP_SING, .. } := BFreeAbelianGroup
  -- @@SCOPE END

  let ISOMORPHIC_FREE_ABELIAN_GROUP_UNIONS ← prove
   r"!k:(A->bool)->bool.
        pairwise DISJOINT k
        ==> free_abelian_group(UNIONS k) isomorphic_group
            sum_group k free_abelian_group"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    MP_TAC (← ISPECL [← q r"k:(A->bool)->bool", ← q r"\x:A->bool. x"]
          GROUP_ISOMORPHISM_FREE_ABELIAN_GROUP_SUM) THEN
    ASM_REWRITE_TAC [ETA_AX] THEN
    DISCH_THEN (MP_TAC o MATCH_MP GROUP_ISOMORPHISM_IMP_ISOMORPHIC) THEN
    REWRITE_TAC [IN_GSPEC])

  let ISOMORPHIC_SUM_INTEGER_GROUP ← prove
   r"!k:A->bool.
        sum_group k (\i. integer_group) isomorphic_group free_abelian_group k"
   (GEN_TAC THEN
    TRANS_TAC ISOMORPHIC_GROUP_TRANS
      (← q r"sum_group k (\i:A. free_abelian_group {i})") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC ISOMORPHIC_GROUP_SUM_GROUP THEN
      REWRITE_TAC [ISOMORPHIC_GROUP_INTEGER_FREE_ABELIAN_GROUP_SING],
      MP_TAC (← ISPECL [← q r"k:A->bool", ← q r"\x:A. {x}"]
          GROUP_ISOMORPHISM_FREE_ABELIAN_GROUP_SUM) THEN
      REWRITE_TAC [pairwise, UNIONS_SINGS] THEN
      ANTS_TAC THENL [SET_TAC [], ALL_TAC] THEN
      MESON_TAC [isomorphic_group]])

  let CARD_EQ_FREE_ABELIAN_GROUP_INFINITE ← prove
   r"!s:A->bool. INFINITE s ==> group_carrier(free_abelian_group s) =_c s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FREE_ABELIAN_GROUP] THEN
    REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS
        (← q r"{f | IMAGE f s SUBSET (:int) /\
         {x | ~(f x = &0)} SUBSET s /\
         FINITE {x:A | ~(f x = &0)}}") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [SUBSET_UNIV, le_c] THEN
        EXISTS_TAC (← q r"dest_frag:A frag->A->int") THEN SIMP_TAC [← GSYM FRAG_EQ] THEN
        REWRITE_TAC [IN_ELIM_THM, FINITE_FRAG_SUPPORT, ← GSYM frag_support],
        wPart lhand lhand CARD_LE_RESTRICTED_FUNSPACE THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_TRANS) THEN
        MATCH_MP_TAC CARD_EQ_IMP_LE THEN
        wPart lhand (fun t => do lhand (← rand t))
          CARD_EQ_FINITE_SUBSETS THEN
        REWRITE_TAC [INFINITE, FINITE_CROSS_EQ] THEN
        ASM_SIMP_TAC [INFINITE_NONEMPTY, UNIV_NOT_EMPTY] THEN
        ASM_REWRITE_TAC [DE_MORGAN_THM, ← GSYM INFINITE] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
        REWRITE_TAC [CROSS, ← GSYM mul_c] THEN
        wPart lhand lhand CARD_MUL_SYM THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
        MATCH_MP_TAC CARD_MUL_ABSORB THEN
        ASM_REWRITE_TAC [UNIV_NOT_EMPTY] THEN
        MATCH_MP_TAC CARD_LE_COUNTABLE_INFINITE THEN
        ASM_REWRITE_TAC [INT_COUNTABLE]],
      REWRITE_TAC [le_c] THEN EXISTS_TAC (← q r"frag_of:A->A frag") THEN
      REWRITE_TAC [IN_ELIM_THM, FRAG_SUPPORT_OF, SING_SUBSET] THEN
      SIMP_TAC [FRAG_OF_EQ]])

  let CARD_EQ_HOMOMORPHISMS_FROM_FREE_ABELIAN_GROUP ← prove
   r"!(s:A->bool) (G:B group).
        abelian_group G
        ==> {f | EXTENSIONAL (group_carrier(free_abelian_group s)) f /\
                 group_homomorphism(free_abelian_group s,G) f} =_c
            (group_carrier G) ^_c s"
   (← do
    let a1 ← FRAG_MODULE (← q r"frag_add x (frag_neg y) = frag_sub x y")
    pure (
    REPEAT STRIP_TAC THEN REWRITE_TAC [EXP_C, eq_c] THEN
    EXISTS_TAC (← q r"\(f:(A)frag->B). RESTRICTION s (f o frag_of)") THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [← REWRITE_RULE [IN] RESTRICTION_IN_EXTENSIONAL] THEN
    CONJ_TAC THENL
     [SIMP_TAC [group_homomorphism, RESTRICTION, o_THM, FREE_ABELIAN_GROUP,
               SUBSET, FORALL_IN_IMAGE] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [IN_ELIM_THM, FRAG_SUPPORT_OF, IN_SING],
      X_GEN_TAC (← q r"f:A->B") THEN STRIP_TAC] THEN
    REWRITE_TAC [EXISTS_UNIQUE_DEF] THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"f:A->B", ← q r"s:A->bool", ← q r"G:B group"]
          FREE_ABELIAN_GROUP_UNIVERSAL) THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"g:(A)frag->B") THEN STRIP_TAC THEN EXISTS_TAC
       (← q r"RESTRICTION (group_carrier(free_abelian_group s)) (g:A frag->B)") THEN
      REWRITE_TAC [← REWRITE_RULE [IN] RESTRICTION_IN_EXTENSIONAL] THEN
      CONJ_TAC THENL
       [UNDISCH_TAC
         (← q r"group_homomorphism(free_abelian_group s,G) (g:A frag->B)") THEN
        REWRITE_TAC [GROUP_HOMOMORPHISM, SUBSET, FORALL_IN_IMAGE] THEN
        SIMP_TAC [RESTRICTION, GROUP_MUL],
        UNDISCH_TAC (← q r"EXTENSIONAL s (f:A->B)") THEN
        SIMP_TAC [EXTENSIONAL, RESTRICTION, FUN_EQ_THM, IN_ELIM_THM, o_THM] THEN
        DISCH_TAC THEN X_GEN_TAC (← q r"x:A") THEN ASM_CASES_TAC (← q r"(x:A) IN s") THEN
        ASM_SIMP_TAC [FREE_ABELIAN_GROUP, FRAG_SUPPORT_OF, SING_SUBSET,
                     IN_ELIM_THM]],
      MAP_EVERY X_GEN_TAC [← q r"g:A frag->B", ← q r"h:A frag->B"] THEN
      REWRITE_TAC [FUN_EQ_THM, EXTENSIONAL, IN_ELIM_THM] THEN
      REWRITE_TAC [FREE_ABELIAN_GROUP, IN_ELIM_THM] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"!c. frag_support c SUBSET s ==> (g:A frag->B) c = h c")
      MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q <=> p ==> p /\ q")] THEN
      MATCH_MP_TAC FRAG_INDUCTION THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [FRAG_SUPPORT_0, EMPTY_SUBSET],
        REPEAT (FIRST_X_ASSUM (fun th => tactic_of do pure (MP_TAC
          (← liftExcept (el 1 (CONJUNCTS (← GEN_REWRITE_RULE I [group_homomorphism] th))))))) THEN
        SIMP_TAC [FREE_ABELIAN_GROUP],
        X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A"))) THEN
        ASM_REWRITE_TAC [RESTRICTION, o_THM, FRAG_SUPPORT_OF, SING_SUBSET] THEN
        SIMP_TAC [],
        REPEAT STRIP_TAC THENL
         [ASM_MESON_TAC [FRAG_SUPPORT_SUB, SUBSET_TRANS, UNION_SUBSET],
          REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP GROUP_HOMOMORPHISM_DIV)) THEN
          REWRITE_TAC [group_div, FREE_ABELIAN_GROUP, IN_ELIM_THM] THEN
          REWRITE_TAC [a1] THEN
          ASM_SIMP_TAC []]]]))

  let ISOMORPHIC_FREE_ABELIAN_GROUPS ← prove
   r"!(s:A->bool) (t:B->bool).
      free_abelian_group s isomorphic_group free_abelian_group t <=>
      s =_c t"
   (← do
    let a6 ← FRAG_MODULE (← q r"frag_sub x y = frag_add x (frag_neg y)")
    let a7 ← SET_RULE (← q r"IMAGE f s SUBSET t <=> !x. x IN s ==> f x IN t")
    let a5 ← TAUT (← q r"p ==> q <=> p ==> p /\ q")
    let a4 ← TAUT (← q r"(p <=> q) <=> p /\ q \/ ~p /\ ~q")
    let a3 ← MESON [FINITE_EMPTY] (← q r"s = {} \/ FINITE s <=> FINITE s")
    let a2 ← SET_RULE (← q r"{a,b} SUBSET {c} <=> a = b /\ a = c")
    let aMeson ← MESON [GROUP_HOMOMORPHISM_EQ]
      (← q r"group_homomorphism(G,H) f /\
        (!x. x IN group_carrier G ==> RESTRICTION s f x = f x)
        ==> group_homomorphism(G,H) (RESTRICTION s f)")
    let a1 ← SET_RULE (← q r"{x | x = a \/ x = b} = {a,b}")
    let a0 ← INT_ARITH (← q r"&0:int <= m /\ m < &2 <=> m = &0 \/ m = &1")
    let aarith ← ARITH_RULE (← q r"0 < 2")
    pure (
    REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN
      SUBGOAL_THEN (← q r"{&0:int,&1} ^_c (s:A->bool) =_c {&0:int, &1} ^_c (t:B->bool)")
      ASSUME_TAC THENL
       [REPEAT STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"s:A->bool", ← q r"integer_mod_group 2"]
              CARD_EQ_HOMOMORPHISMS_FROM_FREE_ABELIAN_GROUP) THEN
        MP_TAC (← ISPECL [← q r"t:B->bool", ← q r"integer_mod_group 2"]
              CARD_EQ_HOMOMORPHISMS_FROM_FREE_ABELIAN_GROUP) THEN
        REWRITE_TAC [ABELIAN_INTEGER_MOD_GROUP] THEN
        SIMP_TAC [INTEGER_MOD_GROUP, aarith] THEN
        REWRITE_TAC [a0] THEN
        REWRITE_TAC [a1] THEN
        DISCH_THEN (fun th => tactic_of do pure (
          GEN_REWRITE_TAC LAND_CONV [CARD_EQ_SYM] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
          MP_TAC th THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CARD_EQ_TRANS))) THEN
        REWRITE_TAC [EQ_C_BIJECTIONS, IN_ELIM_THM] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [isomorphic_group]) THEN
        REWRITE_TAC [group_isomorphism, group_isomorphisms,
                    LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"f:A frag->B frag", ← q r"g:B frag->A frag"] THEN
        STRIP_TAC THEN MAP_EVERY EXISTS_TAC
         [← q r"\(h:A frag->int).
              RESTRICTION (group_carrier (free_abelian_group t))
                          (h o (g:B frag->A frag))",
          ← q r"\(h:B frag->int).
              RESTRICTION (group_carrier (free_abelian_group s))
                          (h o (f:A frag->B frag))"] THEN
        REWRITE_TAC [← REWRITE_RULE [IN] RESTRICTION_IN_EXTENSIONAL] THEN
        CONJ_TAC THENL
         [X_GEN_TAC (← q r"h:A frag->int"), X_GEN_TAC (← q r"k:B frag->int")] THEN
        STRIP_TAC THEN
        (CONJ_TAC THENL
         [MATCH_MP_TAC aMeson THEN
          SIMP_TAC [RESTRICTION] THEN ASM_MESON_TAC [GROUP_HOMOMORPHISM_COMPOSE],
          REPEAT (FIRST_X_ASSUM (MP_TAC o CONJUNCT1 o
            REWRITE_RULE [group_homomorphism])) THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
          RULE_ASSUM_TAC (REWRITE_RULE [EXTENSIONAL, IN_ELIM_THM]) THEN
          GEN_REWRITE_TAC I [FUN_EQ_THM] THEN GEN_TAC THEN
          ASM_SIMP_TAC [RESTRICTION, o_THM] THEN ASM_MESON_TAC []]),
        FIRST_ASSUM (MP_TAC o MATCH_MP CARD_FINITE_CONG) THEN
        REWRITE_TAC [CARD_EXP_FINITE_EQ, FINITE_INSERT, FINITE_EMPTY] THEN
        REWRITE_TAC [a2] THEN
        CONV_TAC INT_REDUCE_CONV THEN
        REWRITE_TAC [a3] THEN
        REWRITE_TAC [a4] THEN
        STRIP_TAC THENL
         [UNDISCH_TAC
           (← q r"{&0:int, &1} ^_c (s:A->bool) =_c {&0:int, &1} ^_c (t:B->bool)") THEN
          ASM_SIMP_TAC [CARD_EQ_CARD, CARD_EXP_FINITE_EQ, FINITE_INSERT,
                       FINITE_EMPTY, CARD_EXP_C] THEN
          REWRITE_TAC [EQ_EXP] THEN
          SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN
          REWRITE_TAC [IN_SING, NOT_IN_EMPTY] THEN
          CONV_TAC INT_REDUCE_CONV THEN CONV_TAC NUM_REDUCE_CONV,
          MP_TAC (← ISPEC (← q r"t:B->bool") CARD_EQ_FREE_ABELIAN_GROUP_INFINITE) THEN
          ASM_REWRITE_TAC [INFINITE] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CARD_EQ_TRANS) THEN
          ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
          MP_TAC (← ISPEC (← q r"s:A->bool") CARD_EQ_FREE_ABELIAN_GROUP_INFINITE) THEN
          ASM_REWRITE_TAC [INFINITE] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CARD_EQ_TRANS) THEN
          ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
          ASM_SIMP_TAC [ISOMORPHIC_GROUP_CARD_EQ]]],
      REWRITE_TAC [EQ_C_BIJECTIONS, isomorphic_group, group_isomorphism] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"frag_of o (f:A->B)", ← q r"s:A->bool", ← q r"free_abelian_group(t:B->bool)"]
            FREE_ABELIAN_GROUP_UNIVERSAL) THEN
      REWRITE_TAC [ABELIAN_FREE_ABELIAN_GROUP, SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FREE_ABELIAN_GROUP, o_THM, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [FRAG_SUPPORT_OF, SING_SUBSET] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h:A frag->B frag") THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"frag_of o (g:B->A)", ← q r"t:B->bool", ← q r"free_abelian_group(s:A->bool)"]
            FREE_ABELIAN_GROUP_UNIVERSAL) THEN
      REWRITE_TAC [ABELIAN_FREE_ABELIAN_GROUP, SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FREE_ABELIAN_GROUP, o_THM, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [FRAG_SUPPORT_OF, SING_SUBSET] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:B frag->A frag") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [group_isomorphisms] THEN
      REWRITE_TAC [FREE_ABELIAN_GROUP, IN_ELIM_THM] THEN
      CONJ_TAC THEN
      ONCE_REWRITE_TAC [a5] THEN
      MATCH_MP_TAC FRAG_INDUCTION THEN
      REWRITE_TAC [FRAG_SUPPORT_0, FRAG_SUPPORT_OF, IN_SING, EMPTY_SUBSET] THEN
      ASM_SIMP_TAC [SING_SUBSET] THEN REPEAT (FIRST_X_ASSUM (MP_TAC o
       GEN_REWRITE_RULE I [group_homomorphism])) THEN
      REWRITE_TAC [a7] THEN
      SIMP_TAC [FREE_ABELIAN_GROUP, IN_ELIM_THM] THEN
      REWRITE_TAC [a6] THEN
      SIMP_TAC [FRAG_SUPPORT_NEG] THEN REPEAT STRIP_TAC THEN
      wPart lhand lhand FRAG_SUPPORT_ADD THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
      ASM_REWRITE_TAC [UNION_SUBSET, FRAG_SUPPORT_NEG]]))

  -- @@RETURN BEGIN
  return { ISOMORPHIC_FREE_ABELIAN_GROUP_UNIONS, ISOMORPHIC_SUM_INTEGER_GROUP,
           CARD_EQ_FREE_ABELIAN_GROUP_INFINITE,
           CARD_EQ_HOMOMORPHISMS_FROM_FREE_ABELIAN_GROUP, ISOMORPHIC_FREE_ABELIAN_GROUPS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Solvable groups. This material was formalized by Claude Opus 4.6 starting -/
/- from Stillwell's "Galois Theory for Beginners" and the Wikipedia page.    -/
/- ------------------------------------------------------------------------- -/

structure SolvableGroup where
  -- @@FIELDS
  solvable_group : thm
  SOLVABLE_GROUP_ALT : thm
  ABELIAN_QUOTIENT_COMMUTATOR : thm
  TRIVIAL_IMP_SOLVABLE_GROUP : thm
  ABELIAN_IMP_SOLVABLE_GROUP : thm
  SOLVABLE_GROUP_NORMAL_EXTENSION : thm
  deriving Inhabited

@[nospecialize]
def setupSolvableGroup [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BCosets : Cosets) (BNormalSubgroups : NormalSubgroups) (BQuotientGroups : QuotientGroups) :
    ExceptT String IO SolvableGroup := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, NUM_REDUCE_CONV, SET_TAC,
        new_definition, .. } := D
  let { ARITH_EQ, COND_CLAUSES, .. } := D.core1
  let { IN_ELIM_THM, .. } := D.core5
  let { LT, NOT_SUC, .. } := D.core6
  let { SUBSET_REFL, SUBSET_TRANS, SUB_0, SUB_REFL, SUC_SUB1, .. } := D.core7
  let { GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, trivial_group, .. } := BBasics
  let { GROUP_INV_INV, GROUP_INV_MUL, group_div, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { CARRIER_SUBGROUP_OF, TRIVIAL_SUBGROUP_OF, .. } := BSubgroups
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_GROUP_CARRIER,
        SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ, .. } := BSubgroupGen1
  let { SUBGROUP_GENERATED_IDEMPOT, .. } := BSubgroupGen2
  let { RIGHT_COSET_EQ, .. } := BCosets
  let { NORMAL_SUBGROUP_IMP_SUBGROUP, TRIVIAL_NORMAL_SUBGROUP_OF, normal_subgroup_of, .. } := BNormalSubgroups
  let { ABELIAN_QUOTIENT_GROUP, QUOTIENT_GROUP, QUOTIENT_GROUP_MUL, .. } := BQuotientGroups
  -- @@SCOPE END

  -- Stillwell: A group G is solvable if it has a descending chain
  -- G = G_0 > G_1 > ... > G_k = {1} with each G_i normal in G_{i-1}
  -- and G_{i-1}/G_i abelian.

  let solvable_group ← new_definition
   r"solvable_group (G:A group) <=>
      ?k (c:num->A->bool).
        c 0 = group_carrier G /\
        c k = {group_id G} /\
        (!i. i < k
             ==> c(SUC i) normal_subgroup_of (subgroup_generated G (c i)) /\
                 abelian_group(quotient_group
                                 (subgroup_generated G (c i)) (c(SUC i))))"

  -- Alternative characterization with ascending chain (Wikipedia convention):
  -- {e} = G_0 <| G_1 <| ... <| G_k = G with G_i normal in G_{i+1} and
  -- G_{i+1}/G_i abelian. Equivalent by reindexing c'(i) = c(k - i).

  let SOLVABLE_GROUP_ALT ← prove
   r"!G:A group.
       solvable_group G <=>
       (?k c. c 0 = {group_id G} /\
              c k = group_carrier G /\
              (!i. i < k
                   ==> c i normal_subgroup_of
                       subgroup_generated G (c(SUC i)) /\
                       abelian_group
                       (quotient_group
                          (subgroup_generated G (c(SUC i))) (c i))))"
   (GEN_TAC THEN REWRITE_TAC [solvable_group] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") (X_CHOOSE_THEN (← q r"c:num->A->bool")
        STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"k:num") THEN
      EXISTS_TAC (← q r"\i. (c:num->A->bool)(k - i)") THEN
      CONV_TAC (DEPTH_CONV BETA_CONV) THEN
      ASM_REWRITE_TAC [SUB_0, SUB_REFL] THEN
      X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"k - i = SUC(k - SUC i)") SUBST1_TAC THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k - SUC i")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []],
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") (X_CHOOSE_THEN (← q r"c:num->A->bool")
        STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"k:num") THEN
      EXISTS_TAC (← q r"\i. (c:num->A->bool)(k - i)") THEN
      CONV_TAC (DEPTH_CONV BETA_CONV) THEN
      ASM_REWRITE_TAC [SUB_0, SUB_REFL] THEN
      X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"k - i = SUC(k - SUC i)") SUBST1_TAC THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k - SUC i")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []]])

  -- Stillwell: Since G_{i-1}/G_i is abelian, G_i is the kernel of a
  -- homomorphism of G_{i-1} onto [an] abelian group, and therefore
  -- sigma, tau in G_{i-1} => sigma^{-1} tau^{-1} sigma tau in G_i.
  -- We formalize this as: commutators land in the normal subgroup.

  let ABELIAN_QUOTIENT_COMMUTATOR ← prove
   r"!G (n:A->bool) x y.
       n normal_subgroup_of G /\
       abelian_group(quotient_group G n) /\
       x IN group_carrier G /\ y IN group_carrier G
       ==> group_mul G (group_inv G x)
             (group_mul G (group_inv G y)
               (group_mul G x y)) IN n"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(n:A->bool) subgroup_of G") ASSUME_TAC THENL
     [ASM_MESON_TAC [normal_subgroup_of], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"right_coset G (n:A->bool)
         (group_mul G (group_inv G x) (group_inv G y)) =
       right_coset G n
         (group_mul G (group_inv G y) (group_inv G x))")
      MP_TAC THENL
     [ASM_SIMP_TAC [← GSYM QUOTIENT_GROUP_MUL, GROUP_INV] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [abelian_group]) THEN
      DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [QUOTIENT_GROUP] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      CONJ_TAC THENL
       [EXISTS_TAC (← q r"group_inv G (x:A)") THEN ASM_SIMP_TAC [GROUP_INV],
        EXISTS_TAC (← q r"group_inv G (y:A)") THEN ASM_SIMP_TAC [GROUP_INV]],
      ALL_TAC] THEN
    ASM_SIMP_TAC [RIGHT_COSET_EQ, GROUP_MUL, GROUP_INV] THEN
    REWRITE_TAC [group_div] THEN
    ASM_SIMP_TAC [GROUP_INV_MUL, GROUP_INV, GROUP_INV_INV] THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_INV, GROUP_MUL])

  -- Trivial group is solvable

  let TRIVIAL_IMP_SOLVABLE_GROUP ← prove
   r"!G:A group. trivial_group G ==> solvable_group G"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [solvable_group] THEN
    EXISTS_TAC (← q r"0") THEN EXISTS_TAC (← q r"\n:num. group_carrier(G:A group)") THEN
    REWRITE_TAC [LT] THEN
    FIRST_X_ASSUM (MP_TAC o REWRITE_RULE [trivial_group]) THEN
    SET_TAC [])

  -- Abelian groups are solvable

  let ABELIAN_IMP_SOLVABLE_GROUP ← prove
   r"!G:A group. abelian_group G ==> solvable_group G"
   (← do
    let a1 ← ARITH_RULE (← q r"i < 1 <=> i = 0")
    pure (
    REPEAT STRIP_TAC THEN REWRITE_TAC [solvable_group] THEN
    EXISTS_TAC (← q r"1") THEN
    EXISTS_TAC (← q r"\n:num. if n = 0 then group_carrier(G:A group)
                        else {group_id G}") THEN
    REWRITE_TAC [NOT_SUC, a1] THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN
    REWRITE_TAC [ARITH_EQ, COND_CLAUSES] THEN
    GEN_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN
    REWRITE_TAC [ARITH_EQ, COND_CLAUSES] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_GROUP_CARRIER] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [TRIVIAL_NORMAL_SUBGROUP_OF],
      MATCH_MP_TAC ABELIAN_QUOTIENT_GROUP THEN
      ASM_REWRITE_TAC [TRIVIAL_SUBGROUP_OF]]))

  -- If N is normal in G with abelian quotient, and N is solvable, then G is
  -- solvable. This is used to concatenate the solvability chains from
  -- individual radical adjunction steps (Stillwell p.25, tower argument).

  let SOLVABLE_GROUP_NORMAL_EXTENSION ← prove
   r"!G (n:A->bool).
       n normal_subgroup_of G /\
       abelian_group(quotient_group G n) /\
       solvable_group(subgroup_generated G n)
       ==> solvable_group G"
   (← do
    let a2 ← ARITH_RULE (← q r"SUC j - 1 = j")
    let a1 ← ARITH_RULE (← q r"SUC(SUC j) - 1 = SUC j")
    pure (
    REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    SUBGOAL_THEN (← q r"n subgroup_of (G:A group)") ASSUME_TAC THENL
     [ASM_MESON_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP], ALL_TAC] THEN
    REWRITE_TAC [solvable_group] THEN
    SUBGOAL_THEN
      (← q r"group_carrier(subgroup_generated G (n:A->bool)) = n")
      (fun th => REWRITE_TAC [th]) THENL
     [ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"group_id(subgroup_generated G (n:A->bool)) = group_id G")
      (fun th => REWRITE_TAC [th]) THENL
     [REWRITE_TAC [SUBGROUP_GENERATED], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") (X_CHOOSE_THEN (← q r"d:num->(A->bool)")
      STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"SUC m") THEN
    EXISTS_TAC (← q r"\i. if i = 0 then group_carrier(G:A group)
                    else (d:num->(A->bool))(i - 1)") THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THENL
     [-- c(0) = group_carrier G
      CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [COND_CLAUSES],
      -- c(SUC m) = {group_id G}
      REWRITE_TAC [NOT_SUC, COND_CLAUSES, SUC_SUB1] THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    -- Auxiliary: d(j) subgroup_of (subgroup_generated G n) for all j <= m
    SUBGOAL_THEN
      (← q r"!j. j <= m
           ==> (d:num->(A->bool)) j subgroup_of
               subgroup_generated (G:A group) n /\
               d j SUBSET n")
      ASSUME_TAC THENL
     [INDUCT_TAC THENL
       [-- Base: d(0) = n, show n subgroup_of subgroup_generated G n /\
        --   n SUBSET n
        DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"(n:A->bool) subgroup_of subgroup_generated (G:A group) n")
          ASSUME_TAC THENL
         [MP_TAC (← ISPEC (← q r"subgroup_generated (G:A group) (n:A->bool)")
            CARRIER_SUBGROUP_OF) THEN
          ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP],
          ASM_REWRITE_TAC [SUBSET_REFL]],
        -- Step: d(SUC j) from d(j)
        DISCH_TAC THEN
        SUBGOAL_THEN (← q r"j <= (m:num)") ASSUME_TAC THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o check (is_imp o concl)) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"j < (m:num)") ASSUME_TAC THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN
        -- Get chain condition for j
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN ASM_REWRITE_TAC [] THEN
        STRIP_TAC THEN
        -- d(SUC j) subgroup_of subgroup_generated(subgroup_generated G n)(d j)
        SUBGOAL_THEN
          (← q r"(d:num->(A->bool))(SUC j) subgroup_of
           subgroup_generated (subgroup_generated (G:A group) n) (d j)")
          ASSUME_TAC THENL
         [ASM_MESON_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP], ALL_TAC] THEN
        -- Use equivalence to derive both properties
        SUBGOAL_THEN
          (← q r"(d:num->(A->bool))(SUC j) subgroup_of
           subgroup_generated (G:A group) n /\
           (d:num->(A->bool))(SUC j) SUBSET (d:num->(A->bool)) j")
          STRIP_ASSUME_TAC THENL
         [MP_TAC (← ISPECL [← q r"subgroup_generated (G:A group) (n:A->bool)",
                           ← q r"(d:num->(A->bool)) (SUC j)",
                           ← q r"(d:num->(A->bool)) j"]
            SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ) THEN
          ASM_REWRITE_TAC [] THEN
          DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        CONJ_TAC THENL
         [ASM_REWRITE_TAC [],
          MATCH_MP_TAC SUBSET_TRANS THEN
          EXISTS_TAC (← q r"(d:num->(A->bool)) j") THEN
          ASM_REWRITE_TAC []]],
      ALL_TAC] THEN
    -- Main: show each step is normal with abelian quotient
    X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"i = 0") THENL
     [-- i = 0: c(1) = d(0) = n, need n normal in G with abelian quotient
      ASM_REWRITE_TAC [NOT_SUC, COND_CLAUSES, SUC_SUB1] THEN
      ASM_REWRITE_TAC [SUBGROUP_GENERATED_GROUP_CARRIER],
      -- i > 0: c(SUC i) = d(i), c(i) = d(i-1)
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?j. i = SUC j /\ j < m") STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"i - 1") THEN ASM_ARITH_TAC, ALL_TAC] THEN
    ASM_REWRITE_TAC [a1, a2, NOT_SUC, COND_CLAUSES] THEN
    -- Goal: d(SUC j) normal_subgroup_of subgroup_generated G (d j) /\
    --   abelian_group(quotient_group (subgroup_generated G (d j)) (d(SUC j)))
    --   Chain gives same with subgroup_generated(subgroup_generated G n)(d j).
    --   Use SUBGROUP_GENERATED_IDEMPOT to equate them.
    SUBGOAL_THEN
      (← q r"subgroup_generated (subgroup_generated (G:A group) n)
         ((d:num->(A->bool)) j) = subgroup_generated G (d j)")
      (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THENL
     [MATCH_MP_TAC SUBGROUP_GENERATED_IDEMPOT THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []],
      ALL_TAC] THEN
    -- Skip past the auxiliary to get the chain condition
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN ASM_REWRITE_TAC []))

  -- @@RETURN BEGIN
  return { solvable_group, SOLVABLE_GROUP_ALT, ABELIAN_QUOTIENT_COMMUTATOR,
           TRIVIAL_IMP_SOLVABLE_GROUP, ABELIAN_IMP_SOLVABLE_GROUP,
           SOLVABLE_GROUP_NORMAL_EXTENSION }
  -- @@RETURN END

structure SolvableImage where
  -- @@FIELDS
  ABELIAN_QUOTIENT_EPIMORPHIC_IMAGE : thm
  SOLVABLE_GROUP_EPIMORPHIC_IMAGE : thm
  SOLVABLE_GROUP_QUOTIENT : thm
  ISOMORPHIC_GROUP_SOLVABILITY : thm
  COMMUTATOR_IMP_ABELIAN_QUOTIENT : thm
  ABELIAN_QUOTIENT_GROUP_DIV : thm
  deriving Inhabited

@[nospecialize]
def setupSolvableImage [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BSubgroupGenerated : SubgroupGenerated) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms4 : Homomorphisms4) (BIso1 : Iso1) (BCosets : Cosets) (BNormalSubgroups : NormalSubgroups) (BNormalSubgroups2 : NormalSubgroups2) (BQuotientGroups : QuotientGroups) (BKernelsImages1 : KernelsImages1) (BKernelsImages2 : KernelsImages2) (BSubgroupCorrespondence : SubgroupCorrespondence) (BSolvableGroup : SolvableGroup) :
    ExceptT String IO SolvableImage := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, SET_RULE, SET_TAC, .. } := D
  let { FORALL_IN_GSPEC, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, .. } := D.core5
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, .. } := BBasics
  let { GROUP_INV_INV, GROUP_INV_MUL, group_div, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, .. } := BSubgroupGenerated
  let { GROUP_HOMOMORPHISM_OF_ID, group_epimorphism, group_homomorphism, .. } := BHomomorphisms
  let { GROUP_EPIMORPHISM_COMPOSE, .. } := BHomomorphisms1
  let { GROUP_EPIMORPHISM_BETWEEN_SUBGROUPS, GROUP_ISOMORPHISM_IMP_EPIMORPHISM, .. } := BHomomorphisms2
  let { ABELIAN_GROUP_EPIMORPHIC_IMAGE, .. } := BHomomorphisms4
  let { ISOMORPHIC_GROUP_SYM, isomorphic_group, .. } := BIso1
  let { RIGHT_COSET_EQ, RIGHT_COSET_EQ_SUBGROUP, .. } := BCosets
  let { NORMAL_SUBGROUP_IMP_SUBGROUP, NORMAL_SUBGROUP_OF_IMP_SUBSET,
        normal_subgroup_of, .. } := BNormalSubgroups
  let { GROUP_SETMUL_RIGHT_COSET, .. } := BNormalSubgroups2
  let { GROUP_EPIMORPHISM_RIGHT_COSET, QUOTIENT_GROUP, QUOTIENT_GROUP_ID, .. } := BQuotientGroups
  let { group_kernel, .. } := BKernelsImages1
  let { QUOTIENT_GROUP_UNIVERSAL_EPIMORPHISM, .. } := BKernelsImages2
  let { NORMAL_SUBGROUP_OF_EPIMORPHIC_IMAGE, .. } := BSubgroupCorrespondence
  let { solvable_group, .. } := BSolvableGroup
  -- @@SCOPE END

  let ABELIAN_QUOTIENT_EPIMORPHIC_IMAGE ← prove
   r"!(G:A group) (H:B group) (f:A->B) n.
      group_epimorphism(G,H) f /\
      n normal_subgroup_of G /\
      abelian_group(quotient_group G n)
      ==> IMAGE f n normal_subgroup_of H /\
          abelian_group(quotient_group H (IMAGE f n))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:A->B) n normal_subgroup_of H") ASSUME_TAC THENL
     [ASM_MESON_TAC [NORMAL_SUBGROUP_OF_EPIMORPHIC_IMAGE], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"m:B->bool = IMAGE (f:A->B) n") THEN
    SUBGOAL_THEN
      (← q r"group_epimorphism(G:A group, quotient_group (H:B group) m)
        (right_coset H m o (f:A->B))")
      ASSUME_TAC THENL
     [MATCH_MP_TAC GROUP_EPIMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"H:B group") THEN
      ASM_SIMP_TAC [GROUP_EPIMORPHISM_RIGHT_COSET],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"n SUBSET group_kernel(G:A group, quotient_group (H:B group) m)
        (right_coset H m o (f:A->B))")
      ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET, group_kernel, IN_ELIM_THM, o_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN group_carrier G") ASSUME_TAC THENL
       [ASM_MESON_TAC [NORMAL_SUBGROUP_OF_IMP_SUBSET, SUBSET], ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [QUOTIENT_GROUP_ID] THEN
      SUBGOAL_THEN (← q r"(f:A->B) x IN group_carrier H") ASSUME_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [group_epimorphism, group_homomorphism]) THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      ASM_SIMP_TAC [RIGHT_COSET_EQ_SUBGROUP, NORMAL_SUBGROUP_IMP_SUBGROUP] THEN
      EXPAND_TAC "m" THEN REWRITE_TAC [IN_IMAGE] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"G:A group",
      ← q r"quotient_group (H:B group) (m:B->bool)",
      ← q r"n:A->bool",
      ← q r"right_coset (H:B group) (m:B->bool) o (f:A->B)"]
      QUOTIENT_GROUP_UNIVERSAL_EPIMORPHISM) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(A->bool)->(B->bool)") STRIP_ASSUME_TAC) THEN
    ASM_MESON_TAC [ABELIAN_GROUP_EPIMORPHIC_IMAGE])

  /- Epimorphic images of solvable groups are solvable.               -/
  /- Proof: the chain IMAGE f (c i) witnesses solvability of H, using -/
  /- ABELIAN_QUOTIENT_EPIMORPHIC_IMAGE to transfer each step.         -/

  let SOLVABLE_GROUP_EPIMORPHIC_IMAGE ← prove
   r"!(G:A group) (H:B group) (f:A->B).
      group_epimorphism(G,H) f /\ solvable_group G ==> solvable_group H"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [solvable_group] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (X_CHOOSE_THEN (← q r"k:num") (X_CHOOSE_THEN (← q r"c:num->A->bool")
        STRIP_ASSUME_TAC))) THEN
    EXISTS_TAC (← q r"k:num") THEN
    EXISTS_TAC (← q r"\i. IMAGE (f:A->B) ((c:num->A->bool) i)") THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN
    SUBGOAL_THEN (← q r"group_homomorphism(G:A group, H:B group) (f:A->B)")
      ASSUME_TAC THENL
     [ASM_MESON_TAC [group_epimorphism], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"IMAGE (f:A->B) (group_carrier G) = group_carrier (H:B group)")
      ASSUME_TAC THENL
     [ASM_MESON_TAC [group_epimorphism], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!j. j <= k ==> (c:num->A->bool) j SUBSET group_carrier G")
      ASSUME_TAC THENL
     [INDUCT_TAC THENL
       [DISCH_TAC THEN ASM_REWRITE_TAC [SUBSET_REFL],
        DISCH_TAC THEN
        SUBGOAL_THEN (← q r"j < (k:num)") ASSUME_TAC THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(c:num->A->bool)(SUC j) normal_subgroup_of
          subgroup_generated (G:A group) (c j)") ASSUME_TAC THENL
         [ASM_MESON_TAC [], ALL_TAC] THEN
        ASM_MESON_TAC [NORMAL_SUBGROUP_OF_IMP_SUBSET, SUBSET_TRANS,
                       GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET]],
      ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [ASM_REWRITE_TAC [],
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← SET_RULE (← q r"IMAGE (f:A->B) {a} = {f a}")] THEN
      ASM_MESON_TAC [GROUP_HOMOMORPHISM_OF_ID],
      X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN
        (← q r"(c:num->A->bool)(SUC i) normal_subgroup_of
           subgroup_generated (G:A group) (c i) /\
         abelian_group(quotient_group (subgroup_generated G (c i)) (c(SUC i)))")
        STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"group_epimorphism
          (subgroup_generated (G:A group) ((c:num->A->bool) i),
           subgroup_generated (H:B group) (IMAGE (f:A->B) (c i))) f")
        ASSUME_TAC THENL
       [MATCH_MP_TAC GROUP_EPIMORPHISM_BETWEEN_SUBGROUPS THEN
        ASM_REWRITE_TAC [] THEN
        FIRST_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"subgroup_generated (G:A group) ((c:num->A->bool) i)",
        ← q r"subgroup_generated (H:B group) (IMAGE (f:A->B) ((c:num->A->bool) i))",
        ← q r"f:A->B",
        ← q r"(c:num->A->bool)(SUC i)"]
        ABELIAN_QUOTIENT_EPIMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC []])

  /- Quotients of solvable groups are solvable -/

  let SOLVABLE_GROUP_QUOTIENT ← prove
   r"!(G:A group) n.
       solvable_group G /\ n normal_subgroup_of G
       ==> solvable_group(quotient_group G n)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SOLVABLE_GROUP_EPIMORPHIC_IMAGE THEN
    EXISTS_TAC (← q r"G:A group") THEN
    EXISTS_TAC (← q r"right_coset G (n:A->bool)") THEN
    ASM_SIMP_TAC [GROUP_EPIMORPHISM_RIGHT_COSET])

  /- Isomorphic groups have the same solvability -/

  let ISOMORPHIC_GROUP_SOLVABILITY ← prove
   r"!(G:A group) (H:B group).
       G isomorphic_group H ==> (solvable_group G <=> solvable_group H)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [isomorphic_group]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"f:A->B")) THEN
      MATCH_MP_TAC (← ISPECL [← q r"G:A group", ← q r"H:B group", ← q r"f:A->B"]
        SOLVABLE_GROUP_EPIMORPHIC_IMAGE) THEN
      ASM_MESON_TAC [GROUP_ISOMORPHISM_IMP_EPIMORPHISM],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM ISOMORPHIC_GROUP_SYM]) THEN
      DISCH_THEN (MP_TAC o GEN_REWRITE_RULE I [isomorphic_group]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"f:B->A")) THEN
      MATCH_MP_TAC (← ISPECL [← q r"H:B group", ← q r"G:A group", ← q r"f:B->A"]
        SOLVABLE_GROUP_EPIMORPHIC_IMAGE) THEN
      ASM_MESON_TAC [GROUP_ISOMORPHISM_IMP_EPIMORPHISM]])

  /- Converse of ABELIAN_QUOTIENT_COMMUTATOR: if all commutators are in n, -/
  /- then the quotient is abelian. Used for SOLVABLE_GROUP_SUBGROUP.       -/

  let COMMUTATOR_IMP_ABELIAN_QUOTIENT ← prove
   r"!G (n:A->bool).
       n normal_subgroup_of G /\
       (!x y. x IN group_carrier G /\ y IN group_carrier G
              ==> group_mul G (group_inv G x)
                    (group_mul G (group_inv G y)
                      (group_mul G x y)) IN n)
       ==> abelian_group(quotient_group G n)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(n:A->bool) subgroup_of G") ASSUME_TAC THENL
     [ASM_MESON_TAC [normal_subgroup_of], ALL_TAC] THEN
    REWRITE_TAC [abelian_group] THEN
    ASM_SIMP_TAC [QUOTIENT_GROUP, IMP_CONJ, RIGHT_FORALL_IMP_THM,
                 FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [GROUP_SETMUL_RIGHT_COSET] THEN
    ASM_SIMP_TAC [RIGHT_COSET_EQ, GROUP_MUL] THEN
    REWRITE_TAC [group_div] THEN
    ASM_SIMP_TAC [GROUP_INV_MUL, GROUP_MUL, GROUP_INV] THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL, GROUP_INV] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"group_inv G (x:A)", ← q r"group_inv G (y:A)"]) THEN
    ASM_SIMP_TAC [GROUP_INV, GROUP_INV_INV])

  let ABELIAN_QUOTIENT_GROUP_DIV ← prove
   r"!G (n:A->bool).
       n normal_subgroup_of G /\
       (!x y. x IN group_carrier G /\ y IN group_carrier G
              ==> group_div G (group_mul G x y) (group_mul G y x) IN n)
       ==> abelian_group(quotient_group G n)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(n:A->bool) subgroup_of G") ASSUME_TAC THENL
     [ASM_MESON_TAC [normal_subgroup_of], ALL_TAC] THEN
    REWRITE_TAC [abelian_group] THEN
    ASM_SIMP_TAC [QUOTIENT_GROUP, IMP_CONJ, RIGHT_FORALL_IMP_THM,
                 FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [GROUP_SETMUL_RIGHT_COSET] THEN
    ASM_SIMP_TAC [RIGHT_COSET_EQ, GROUP_MUL] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [])

  -- @@RETURN BEGIN
  return { ABELIAN_QUOTIENT_EPIMORPHIC_IMAGE, SOLVABLE_GROUP_EPIMORPHIC_IMAGE,
           SOLVABLE_GROUP_QUOTIENT, ISOMORPHIC_GROUP_SOLVABILITY,
           COMMUTATOR_IMP_ABELIAN_QUOTIENT, ABELIAN_QUOTIENT_GROUP_DIV }
  -- @@RETURN END

structure SolvableSubgroup where
  -- @@FIELDS
  SOLVABLE_GROUP_SUBGROUP : thm
  SOLVABLE_GROUP_MONOMORPHIC_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupSolvableSubgroup [HolBase] (D : GroupTheoryDeps) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BHomomorphisms : Homomorphisms) (BIso1 : Iso1) (BNormalSubgroups : NormalSubgroups) (BKernelsImages1 : KernelsImages1) (BSolvableGroup : SolvableGroup) (BSolvableImage : SolvableImage) :
    ExceptT String IO SolvableSubgroup := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, SET_RULE, SET_TAC, .. } := D
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IN_INTER, .. } := D.core5
  let { SUBSET, .. } := D.core7
  let { group_conjugation, .. } := BConjugation
  let { CARRIER_SUBGROUP_OF, IN_SUBGROUP_CONJUGATION, IN_SUBGROUP_INV, IN_SUBGROUP_MUL,
        SUBGROUP_OF_INTER, subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED, SUBGROUP_OF_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_OF_SUBGROUP_GENERATED_REV, .. } := BSubgroupGen1
  let { SUBGROUP_GENERATED_IDEMPOT, .. } := BSubgroupGen2
  let { group_monomorphism, .. } := BHomomorphisms
  let { isomorphic_group, .. } := BIso1
  let { NORMAL_SUBGROUP_CONJUGATION, NORMAL_SUBGROUP_IMP_SUBGROUP,
        NORMAL_SUBGROUP_OF_IMP_SUBSET, .. } := BNormalSubgroups
  let { GROUP_ISOMORPHISM_ONTO_IMAGE, SUBGROUP_GROUP_IMAGE, .. } := BKernelsImages1
  let { ABELIAN_QUOTIENT_COMMUTATOR, solvable_group, .. } := BSolvableGroup
  let { COMMUTATOR_IMP_ABELIAN_QUOTIENT, ISOMORPHIC_GROUP_SOLVABILITY, .. } := BSolvableImage
  -- @@SCOPE END

  /- Subgroups of solvable groups are solvable.                               -/
  /- Proof: intersect the solvability chain with the subgroup. The commutator -/
  /- and conjugation conditions transfer because subgroups are closed under   -/
  /- group operations.                                                        -/

  let SOLVABLE_GROUP_SUBGROUP ← prove
   r"!G (h:A->bool).
       h subgroup_of G /\ solvable_group G
       ==> solvable_group(subgroup_generated G h)"
   (← do
    let sr2 ← SET_RULE (← q r"{a:A} INTER (h:A->bool) = {a} <=> a IN h")
    let sr1 ← SET_RULE (← q r"(h:A->bool) SUBSET s ==> s INTER h = h")
    pure (REPEAT GEN_TAC THEN
    REWRITE_TAC [solvable_group] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (X_CHOOSE_THEN (← q r"k:num") (X_CHOOSE_THEN (← q r"c:num->A->bool")
        STRIP_ASSUME_TAC))) THEN
    SUBGOAL_THEN (← q r"group_carrier(subgroup_generated G (h:A->bool)) = h")
      ASSUME_TAC THENL
     [ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"group_id(subgroup_generated G (h:A->bool)) = group_id G")
      ASSUME_TAC THENL
     [REWRITE_TAC [SUBGROUP_GENERATED], ALL_TAC] THEN
    EXISTS_TAC (← q r"k:num") THEN
    EXISTS_TAC (← q r"\i. (c:num->A->bool) i INTER (h:A->bool)") THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THENL
     [-- c 0 INTER h = group_carrier(subgroup_generated G h)
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC sr1 THEN
      ASM_MESON_TAC [subgroup_of],
      -- c k INTER h = {group_id(subgroup_generated G h)}
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [sr2] THEN
      ASM_MESON_TAC [subgroup_of],
      -- Main step
      ALL_TAC] THEN
    -- Auxiliary: c(j) subgroup_of G for all j <= k
    SUBGOAL_THEN (← q r"!j. j <= k ==> (c:num->A->bool) j subgroup_of G")
      ASSUME_TAC THENL
     [INDUCT_TAC THENL
       [DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [CARRIER_SUBGROUP_OF],
        DISCH_TAC THEN
        SUBGOAL_THEN (← q r"j < (k:num)") ASSUME_TAC THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN
        SUBGOAL_THEN (← q r"j <= (k:num)") ASSUME_TAC THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o check (is_imp o concl)) THEN
        ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        MATCH_MP_TAC SUBGROUP_OF_SUBGROUP_GENERATED_REV THEN
        EXISTS_TAC (← q r"(c:num->A->bool) j") THEN
        ASM_MESON_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP]],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
    -- Get chain conditions for step i
    SUBGOAL_THEN
      (← q r"(c:num->A->bool)(SUC i) normal_subgroup_of
         subgroup_generated (G:A group) (c i) /\
       abelian_group(quotient_group (subgroup_generated G (c i)) (c(SUC i)))")
      STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(c:num->A->bool) i subgroup_of G") ASSUME_TAC THENL
     [FIRST_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(c:num->A->bool)(SUC i) subgroup_of G") ASSUME_TAC THENL
     [FIRST_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(c:num->A->bool)(SUC i) SUBSET c i") ASSUME_TAC THENL
     [ASM_MESON_TAC [NORMAL_SUBGROUP_OF_IMP_SUBSET,
                     CARRIER_SUBGROUP_GENERATED_SUBGROUP], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(c:num->A->bool) i INTER h subgroup_of G") ASSUME_TAC THENL
     [MATCH_MP_TAC SUBGROUP_OF_INTER THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(c:num->A->bool)(SUC i) INTER h subgroup_of G")
      ASSUME_TAC THENL
     [MATCH_MP_TAC SUBGROUP_OF_INTER THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    -- d(i) subgroup_of subgroup_generated G h
    SUBGOAL_THEN
      (← q r"(c:num->A->bool) i INTER h subgroup_of
       subgroup_generated (G:A group) (h:A->bool)") ASSUME_TAC THENL
     [REWRITE_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_EQ] THEN
      ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
      SET_TAC [],
      ALL_TAC] THEN
    -- Use SUBGROUP_GENERATED_IDEMPOT to simplify nesting
    SUBGOAL_THEN
      (← q r"subgroup_generated (subgroup_generated G (h:A->bool))
         ((c:num->A->bool) i INTER h) =
       subgroup_generated G (c i INTER h)")
      (fun th => REWRITE_TAC [th]) THENL
     [MATCH_MP_TAC SUBGROUP_GENERATED_IDEMPOT THEN SET_TAC [],
      ALL_TAC] THEN
    -- Goal: c(SUC i) INTER h normal_subgroup_of sg G (c i INTER h) /\
    --   abelian_group(quotient_group (sg G (c i INTER h)) (c(SUC i) INTER h))
    -- Carrier of sg G (c i INTER h) = c i INTER h
    SUBGOAL_THEN
      (← q r"group_carrier(subgroup_generated G ((c:num->A->bool) i INTER h)) =
       c i INTER h") ASSUME_TAC THENL
     [ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP], ALL_TAC] THEN
    -- c(SUC i) INTER h subgroup_of sg G (c i INTER h)
    SUBGOAL_THEN
      (← q r"(c:num->A->bool)(SUC i) INTER h subgroup_of
       subgroup_generated G (c i INTER h)") ASSUME_TAC THENL
     [REWRITE_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_EQ] THEN
      ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    -- Key conjugation lemma: conjugation preserves c(SUC i) INTER h
    SUBGOAL_THEN
      (← q r"!a x. a IN (c:num->A->bool) i INTER h /\ x IN c(SUC i) INTER h
             ==> group_conjugation G a x IN c(SUC i) INTER h")
      ASSUME_TAC THENL
     [REWRITE_TAC [IN_INTER] THEN
      REPEAT GEN_TAC THEN STRIP_TAC THEN CONJ_TAC THENL
       [-- group_conjugation G a x IN c(SUC i): from normality
        MP_TAC (← ASSUME
          (← q r"(c:num->A->bool)(SUC i) normal_subgroup_of
           subgroup_generated G (c i)")) THEN
        REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION] THEN
        ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a:A") o CONJUNCT2) THEN
        ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE,
                     group_conjugation, SUBGROUP_GENERATED] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
        -- group_conjugation G a x IN h: subgroup closure
        MATCH_MP_TAC IN_SUBGROUP_CONJUGATION THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    -- Normality
    SUBGOAL_THEN
      (← q r"(c:num->A->bool)(SUC i) INTER h normal_subgroup_of
       subgroup_generated G (c i INTER h)") ASSUME_TAC THENL
     [REWRITE_TAC [NORMAL_SUBGROUP_CONJUGATION] THEN
      ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"b:A") THEN DISCH_TAC THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
      REWRITE_TAC [group_conjugation, SUBGROUP_GENERATED] THEN
      REWRITE_TAC [← GSYM group_conjugation] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [IN_INTER] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTER]) THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    -- Abelianness via COMMUTATOR_IMP_ABELIAN_QUOTIENT
    MATCH_MP_TAC COMMUTATOR_IMP_ABELIAN_QUOTIENT THEN
    ASM_REWRITE_TAC [SUBGROUP_GENERATED] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
    REWRITE_TAC [IN_INTER] THEN CONJ_TAC THENL
     [-- Commutator in c(SUC i): from abelian quotient
      MP_TAC (← ISPECL [← q r"subgroup_generated G ((c:num->A->bool) i)",
                      ← q r"(c:num->A->bool)(SUC i)"]
        ABELIAN_QUOTIENT_COMMUTATOR) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
      ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
      REWRITE_TAC [SUBGROUP_GENERATED],
      -- Commutator in h: subgroup closure
      SUBGOAL_THEN (← q r"group_inv G (x:A) IN h /\ group_inv G y IN h")
        STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [IN_SUBGROUP_INV], ALL_TAC] THEN
      REPEAT (MATCH_MP_TAC IN_SUBGROUP_MUL THEN ASM_REWRITE_TAC [])]))

  let SOLVABLE_GROUP_MONOMORPHIC_PREIMAGE ← prove
   r"!(G:A group) (H:B group) (f:A->B).
       group_monomorphism(G,H) f /\ solvable_group H ==> solvable_group G"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"G:A group", ← q r"subgroup_generated H (group_image(G,H) (f:A->B))"]
     ISOMORPHIC_GROUP_SOLVABILITY) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [isomorphic_group, GROUP_ISOMORPHISM_ONTO_IMAGE],
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC SOLVABLE_GROUP_SUBGROUP THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBGROUP_GROUP_IMAGE THEN
      ASM_MESON_TAC [group_monomorphism]])

  -- @@RETURN BEGIN
  return { SOLVABLE_GROUP_SUBGROUP, SOLVABLE_GROUP_MONOMORPHIC_PREIMAGE }
  -- @@RETURN END

structure SolvableQuotient where
  -- @@FIELDS
  SOLVABLE_GROUP_SOLVABLE_QUOTIENT : thm
  deriving Inhabited

@[nospecialize]
def setupSolvableQuotient [HolBase] (D : GroupTheoryDeps) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BHomomorphisms : Homomorphisms) (BHomomorphisms2 : Homomorphisms2) (BIso2 : Iso2) (BNormalSubgroups : NormalSubgroups) (BQuotientGroups : QuotientGroups) (BKernelsImages1 : KernelsImages1) (BSubgroupCorrespondence : SubgroupCorrespondence) (BSolvableGroup : SolvableGroup) :
    ExceptT String IO SolvableQuotient := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC,
        SET_TAC, .. } := D
  let { ADD_CLAUSES, .. } := D.core1
  let { EXTENSION, FORALL_IN_IMAGE, .. } := D.core3
  let { IN_ELIM_THM, IN_SING, .. } := D.core5
  let { LE_0, LE_REFL, .. } := D.core6
  let { SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } := D.core7
  let { CARRIER_SUBGROUP_OF, subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_OF_SUBGROUP_GENERATED_REV, .. } := BSubgroupGen1
  let { SUBGROUP_GENERATED_IDEMPOT, .. } := BSubgroupGen2
  let { group_epimorphism, group_homomorphism, .. } := BHomomorphisms
  let { GROUP_EPIMORPHISM_BETWEEN_SUBGROUPS, SUBGROUP_OF_HOMOMORPHIC_PREIMAGE, .. } := BHomomorphisms2
  let { ISOMORPHIC_GROUP_ABELIANNESS, .. } := BIso2
  let { NORMAL_SUBGROUP_IMP_SUBGROUP, NORMAL_SUBGROUP_OF_IMP_SUBSET, .. } := BNormalSubgroups
  let { GROUP_EPIMORPHISM_RIGHT_COSET, QUOTIENT_GROUP_ID, .. } := BQuotientGroups
  let { GROUP_KERNEL_RIGHT_COSET, group_kernel, .. } := BKernelsImages1
  let { FIRST_GROUP_ISOMORPHISM_THEOREM_GEN, NORMAL_SUBGROUP_OF_HOMOMORPHIC_PREIMAGE, .. } := BSubgroupCorrespondence
  let { solvable_group, .. } := BSolvableGroup
  -- @@SCOPE END

  let SOLVABLE_GROUP_SOLVABLE_QUOTIENT ← prove
   r"!G (n:A->bool).
     n normal_subgroup_of G /\
     solvable_group(subgroup_generated G n) /\
     solvable_group(quotient_group G n)
     ==> solvable_group G"
   (← do
    let a4 ← ARITH_RULE (← q r"SUC 0 = 1")
    let a3 ← ARITH_RULE (← q r"SUC m - m = 1")
    let a2 ← ARITH_RULE (← q r"~(SUC m <= m)")
    let a1 ← ARITH_RULE (← q r"(m + p) - m:num = p")
    pure (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (CONJUNCTS_THEN2 MP_TAC MP_TAC)) THEN
    REWRITE_TAC [solvable_group] THEN
    SUBGOAL_THEN (← q r"(n:A->bool) subgroup_of G") ASSUME_TAC THENL
     [ASM_MESON_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"group_carrier(subgroup_generated G (n:A->bool)) = n")
      (fun th => REWRITE_TAC [th]) THENL
     [ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"group_id(subgroup_generated G (n:A->bool)) = group_id G")
      (fun th => REWRITE_TAC [th]) THENL
     [REWRITE_TAC [SUBGROUP_GENERATED], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:num")
      (X_CHOOSE_THEN (← q r"d:num->(A->bool)->bool")
        (CONJUNCTS_THEN2 ASSUME_TAC
          (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "d_cond"))))) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:num")
      (X_CHOOSE_THEN (← q r"e:num->A->bool")
        (CONJUNCTS_THEN2 ASSUME_TAC
          (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "e_cond"))))) THEN
    -- Epimorphism facts
    SUBGOAL_THEN
      (← q r"group_epimorphism(G,quotient_group G (n:A->bool)) (right_coset G n)")
      ASSUME_TAC THENL
     [ASM_SIMP_TAC [GROUP_EPIMORPHISM_RIGHT_COSET], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"group_homomorphism(G,quotient_group G (n:A->bool)) (right_coset G n)")
      ASSUME_TAC THENL
     [ASM_MESON_TAC [group_epimorphism], ALL_TAC] THEN
    -- d chain: subgroups of quotient_group G n
    SUBGOAL_THEN
      (← q r"!j. j <= m
           ==> (d:num->(A->bool)->bool) j subgroup_of
               quotient_group G (n:A->bool)")
      (LABEL_TAC "d_sub") THENL
     [INDUCT_TAC THENL
       [DISCH_TAC THEN ASM_REWRITE_TAC [] THEN REWRITE_TAC [CARRIER_SUBGROUP_OF],
        DISCH_TAC THEN
        SUBGOAL_THEN (← q r"j < (m:num)") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        SUBGOAL_THEN (← q r"j <= (m:num)") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o check (is_imp o concl)) THEN
        ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        MATCH_MP_TAC SUBGROUP_OF_SUBGROUP_GENERATED_REV THEN
        EXISTS_TAC (← q r"(d:num->(A->bool)->bool) j") THEN
        ASM_MESON_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP]],
      ALL_TAC] THEN
    -- e chain: subgroups of subgroup_generated G n, subset of n
    SUBGOAL_THEN
      (← q r"!j. j <= p
           ==> (e:num->A->bool) j subgroup_of subgroup_generated G (n:A->bool) /\
               e j SUBSET n")
      (LABEL_TAC "e_sub") THENL
     [INDUCT_TAC THENL
       [DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL
         [MP_TAC (← ISPEC (← q r"subgroup_generated G (n:A->bool)")
            CARRIER_SUBGROUP_OF) THEN
          ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP],
          SET_TAC []],
        DISCH_TAC THEN
        SUBGOAL_THEN (← q r"j < (p:num)") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        SUBGOAL_THEN (← q r"j <= (p:num)") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o check (is_imp o concl)) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
        SUBGOAL_THEN
          (← q r"(e:num->A->bool)(SUC j) subgroup_of subgroup_generated G (n:A->bool)")
          ASSUME_TAC THENL
         [MATCH_MP_TAC SUBGROUP_OF_SUBGROUP_GENERATED_REV THEN
          EXISTS_TAC (← q r"(e:num->A->bool) j") THEN
          ASM_MESON_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP], ALL_TAC] THEN
        ASM_REWRITE_TAC [] THEN
        ASM_MESON_TAC [NORMAL_SUBGROUP_OF_IMP_SUBSET,
                       CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBSET_TRANS]],
      ALL_TAC] THEN
    -- Key fact: preimage of d(m) = n, using GROUP_KERNEL_RIGHT_COSET
    SUBGOAL_THEN
      (← q r"{x:A | x IN group_carrier G /\
              right_coset G n x IN (d:num->(A->bool)->bool) m} = n")
      ASSUME_TAC THENL
     [ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [QUOTIENT_GROUP_ID] THEN
      REWRITE_TAC [IN_SING] THEN
      SUBGOAL_THEN
        (← q r"{x:A | x IN group_carrier G /\
                right_coset G n x = (n:A->bool)} =
         group_kernel(G,quotient_group G n) (right_coset G n)")
        SUBST1_TAC THENL
       [REWRITE_TAC [group_kernel] THEN ASM_SIMP_TAC [QUOTIENT_GROUP_ID],
        ASM_SIMP_TAC [GROUP_KERNEL_RIGHT_COSET]],
      ALL_TAC] THEN
    -- Provide combined chain
    EXISTS_TAC (← q r"m + p:num") THEN
    EXISTS_TAC (← q r"\i:num. if i <= m
      then {x:A | x IN group_carrier G /\
                  right_coset G n x IN (d:num->(A->bool)->bool) i}
      else (e:num->A->bool)(i - m)") THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN
    REPEAT CONJ_TAC THENL
     [-- c(0) = group_carrier G
      REWRITE_TAC [LE_0] THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
      GEN_TAC THEN EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o CONJUNCT1 o
        GEN_REWRITE_RULE I [group_homomorphism]) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
      -- c(m+p) = {group_id G}
      ASM_CASES_TAC (← q r"p = 0") THENL
       [FIRST_X_ASSUM SUBST_ALL_TAC THEN
        REWRITE_TAC [ADD_CLAUSES, LE_REFL] THEN
        SUBGOAL_THEN (← q r"(n:A->bool) = {group_id G}") ASSUME_TAC THENL
         [UNDISCH_TAC (← q r"(e:num->A->bool) 0 = {group_id(G:A group)}") THEN
          UNDISCH_TAC (← q r"(e:num->A->bool) 0 = (n:A->bool)") THEN
          MESON_TAC [],
          ASM_REWRITE_TAC []],
        SUBGOAL_THEN (← q r"~(m + p:num <= m)") (fun th => REWRITE_TAC [th]) THENL
         [UNDISCH_TAC (← q r"~(p = 0)") THEN ARITH_TAC, ALL_TAC] THEN
        ASM_REWRITE_TAC [a1]],
      -- Main: chain condition for all i < m + p
      ALL_TAC] THEN
    X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"i:num < m") THENL
     [-- Case 1: i < m, both c(i) and c(SUC i) in preimage branch
      SUBGOAL_THEN (← q r"i <= (m:num)") (fun th => REWRITE_TAC [th]) THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN (← q r"SUC i <= (m:num)") (fun th => REWRITE_TAC [th]) THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      -- First establish the d-chain subgroup facts we need
      SUBGOAL_THEN (← q r"(d:num->(A->bool)->bool) i subgroup_of
                    quotient_group G (n:A->bool)") ASSUME_TAC THENL
       [USE_THEN "d_sub" MATCH_MP_TAC THEN ASM_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(d:num->(A->bool)->bool)(SUC i) subgroup_of
                    quotient_group G (n:A->bool)") ASSUME_TAC THENL
       [USE_THEN "d_sub" MATCH_MP_TAC THEN ASM_ARITH_TAC, ALL_TAC] THEN
      -- Set up the restricted epimorphism
      ABBREV_TAC
        (← q r"ci = {x:A | x IN group_carrier G /\
                      right_coset G n x IN (d:num->(A->bool)->bool) i}") THEN
      ABBREV_TAC
        (← q r"csi = {x:A | x IN group_carrier G /\
                       right_coset G n x IN (d:num->(A->bool)->bool)(SUC i)}") THEN
      -- ci is a subgroup of G
      SUBGOAL_THEN (← q r"(ci:A->bool) subgroup_of G") ASSUME_TAC THENL
       [EXPAND_TAC "ci" THEN MATCH_MP_TAC SUBGROUP_OF_HOMOMORPHIC_PREIMAGE THEN
        EXISTS_TAC (← q r"quotient_group G (n:A->bool)") THEN
        CONV_TAC (ONCE_DEPTH_CONV D.ETA_CONV) THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      -- csi is a subgroup of G
      SUBGOAL_THEN (← q r"(csi:A->bool) subgroup_of G") ASSUME_TAC THENL
       [EXPAND_TAC "csi" THEN MATCH_MP_TAC SUBGROUP_OF_HOMOMORPHIC_PREIMAGE THEN
        EXISTS_TAC (← q r"quotient_group G (n:A->bool)") THEN
        CONV_TAC (ONCE_DEPTH_CONV D.ETA_CONV) THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      -- IMAGE (right_coset G n) ci = d i
      SUBGOAL_THEN
        (← q r"IMAGE (right_coset G (n:A->bool)) ci = (d:num->(A->bool)->bool) i")
        ASSUME_TAC THENL
       [EXPAND_TAC "ci" THEN
        SUBGOAL_THEN (← q r"(d:num->(A->bool)->bool) i SUBSET
                      IMAGE (right_coset G (n:A->bool)) (group_carrier G)")
          ASSUME_TAC THENL
         [MP_TAC (← ASSUME (← q r"group_epimorphism(G,quotient_group G (n:A->bool))
                           (right_coset G n)")) THEN
          REWRITE_TAC [group_epimorphism] THEN
          DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← CONJUNCT2 th])) THEN
          MP_TAC (← ASSUME (← q r"(d:num->(A->bool)->bool) i subgroup_of
                          quotient_group G (n:A->bool)")) THEN
          REWRITE_TAC [subgroup_of] THEN SET_TAC [],
          ASM SET_TAC []],
        ALL_TAC] THEN
      -- Restricted epimorphism
      SUBGOAL_THEN
        (← q r"group_epimorphism
          (subgroup_generated G ci,
           subgroup_generated (quotient_group G (n:A->bool))
             ((d:num->(A->bool)->bool) i))
          (right_coset G n)") ASSUME_TAC THENL
       [SUBGOAL_THEN
          (← q r"subgroup_generated (quotient_group G (n:A->bool))
             (IMAGE (right_coset G n) (ci:A->bool)) =
           subgroup_generated (quotient_group G n) ((d:num->(A->bool)->bool) i)")
          (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THENL
         [AP_TERM_TAC THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC GROUP_EPIMORPHISM_BETWEEN_SUBGROUPS THEN
        ASM_REWRITE_TAC [] THEN
        MP_TAC (← ASSUME (← q r"(ci:A->bool) subgroup_of G")) THEN
        REWRITE_TAC [subgroup_of] THEN SET_TAC [], ALL_TAC] THEN
      -- Preimage of d(SUC i) under restricted map = csi
      SUBGOAL_THEN
        (← q r"{x:A | x IN group_carrier(subgroup_generated G ci) /\
                right_coset G n x IN (d:num->(A->bool)->bool)(SUC i)} = csi")
        ASSUME_TAC THENL
       [ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
        EXPAND_TAC "ci" THEN EXPAND_TAC "csi" THEN
        REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:A") THEN EQ_TAC THENL
         [STRIP_TAC THEN ASM_REWRITE_TAC [],
          STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
          SUBGOAL_THEN
            (← q r"(d:num->(A->bool)->bool)(SUC i) SUBSET d i") MP_TAC THENL
           [USE_THEN "d_cond" (MP_TAC o SPEC (← q r"i:num")) THEN
            ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
            DISCH_THEN (MP_TAC o CONJUNCT1) THEN
            DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← MATCH_MP NORMAL_SUBGROUP_OF_IMP_SUBSET th))) THEN
            USE_THEN "d_sub" (MP_TAC o SPEC (← q r"i:num")) THEN
            ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
            ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP],
            ASM SET_TAC []]],
        ALL_TAC] THEN
      -- Chain condition for quotient: d(SUC i) normal in sg(G/N)(d i)
      SUBGOAL_THEN
        (← q r"(d:num->(A->bool)->bool)(SUC i) normal_subgroup_of
         subgroup_generated (quotient_group G (n:A->bool)) (d i) /\
         abelian_group(quotient_group
           (subgroup_generated (quotient_group G n) (d i)) (d(SUC i)))")
        STRIP_ASSUME_TAC THENL
       [USE_THEN "d_cond" (MP_TAC o SPEC (← q r"i:num")) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []],
        ALL_TAC] THEN
      -- Normality: csi normal in sg G ci
      CONJ_TAC THENL
       [SUBGOAL_THEN
          (← q r"(csi:A->bool) normal_subgroup_of subgroup_generated G ci")
          MP_TAC THENL
         [ALL_TAC, REWRITE_TAC []] THEN
        FIRST_X_ASSUM (fun th => tactic_of do pure (REWRITE_TAC [← SYM th])) THEN
        MATCH_MP_TAC NORMAL_SUBGROUP_OF_HOMOMORPHIC_PREIMAGE THEN
        EXISTS_TAC (← q r"subgroup_generated (quotient_group G (n:A->bool))
                      ((d:num->(A->bool)->bool) i)") THEN
        ASM_REWRITE_TAC [] THEN
        CONV_TAC (ONCE_DEPTH_CONV D.ETA_CONV) THEN
        FIRST_X_ASSUM (fun th => tactic_of do pure (ACCEPT_TAC (← CONJUNCT1 (← REWRITE_RULE [group_epimorphism] th)))), ALL_TAC] THEN
      -- Abelianness: quotient(sg G ci)(csi) abelian
      SUBGOAL_THEN
        (← q r"quotient_group (subgroup_generated G ci) (csi:A->bool)
         isomorphic_group
         quotient_group
           (subgroup_generated (quotient_group G (n:A->bool))
             ((d:num->(A->bool)->bool) i)) (d(SUC i))")
        MP_TAC THENL
       [MATCH_MP_TAC FIRST_GROUP_ISOMORPHISM_THEOREM_GEN THEN
        EXISTS_TAC (← q r"right_coset G (n:A->bool)") THEN
        ASM_REWRITE_TAC [],
        DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← MATCH_MP ISOMORPHIC_GROUP_ABELIANNESS th))) THEN
        ASM_REWRITE_TAC []],
      -- Case 2: i >= m
      SUBGOAL_THEN (← q r"~(i:num <= m) \/ i = m") MP_TAC THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (DISJ_CASES_THEN2 ASSUME_TAC SUBST_ALL_TAC) THENL
       [-- Subcase: i > m, both in N chain
        SUBGOAL_THEN (← q r"~(i <= m) /\ ~(SUC i <= m)") STRIP_ASSUME_TAC THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN
        ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"SUC i - m = SUC(i - m)") SUBST1_TAC THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN
        USE_THEN "e_sub" (MP_TAC o SPEC (← q r"i - m:num")) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        DISCH_THEN (ASSUME_TAC o CONJUNCT2) THEN
        USE_THEN "e_cond" (MP_TAC o SPEC (← q r"i - m:num")) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        MP_TAC (← MATCH_MP SUBGROUP_GENERATED_IDEMPOT
          (← ASSUME (← q r"(e:num->A->bool)(i - m) SUBSET (n:A->bool)"))) THEN
        DISCH_THEN (fun th => REWRITE_TAC [th]),
        -- Subcase: i = m, junction between d-chain and e-chain
        REWRITE_TAC [LE_REFL, a2] THEN
        REWRITE_TAC [a3] THEN
        ASM_REWRITE_TAC [] THEN
        USE_THEN "e_cond" (MP_TAC o SPEC (← q r"0")) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [a4,
                     (← ASSUME (← q r"(e:num->A->bool) 0 = (n:A->bool)"))] THEN
        MP_TAC (← ISPEC (← q r"G:A group")
          (← MATCH_MP SUBGROUP_GENERATED_IDEMPOT
            (← ISPEC (← q r"n:A->bool") SUBSET_REFL))) THEN
        DISCH_THEN (fun th => REWRITE_TAC [th])]]))

  -- @@RETURN BEGIN
  return { SOLVABLE_GROUP_SOLVABLE_QUOTIENT }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Basic things about exact sequences.                                       -/
/- ------------------------------------------------------------------------- -/

structure ExactSequences where
  -- @@FIELDS
  group_exactness : thm
  short_exact_sequence : thm
  SHORT_EXACT_SEQUENCE : thm
  GROUP_EXACTNESS_MONOMORPHISM : thm
  GROUP_EXACTNESS_EPIMORPHISM : thm
  EXTREMELY_SHORT_EXACT_SEQUENCE : thm
  GROUP_EXACTNESS_EPIMORPHISM_EQ_TRIVIALITY : thm
  GROUP_EXACTNESS_MONOMORPHISM_EQ_TRIVIALITY : thm
  VERY_SHORT_EXACT_SEQUENCE : thm
  GROUP_EXACTNESS_EQ_TRIVIALITY : thm
  GROUP_EXACTNESS_IMP_TRIVIALITY : thm
  GROUP_EXACTNESS_ISOMORPHISM_EQ_TRIVIALITY : thm
  GROUP_EXACTNESS_ISOMORPHISM_EQ_MONO_EPI : thm
  SHORT_EXACT_SEQUENCE_NORMAL_SUBGROUP : thm
  SHORT_EXACT_SEQUENCE_PROD_GROUP : thm
  SHORT_EXACT_SEQUENCE_PROD_GROUP_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupExactSequences [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms3 : Homomorphisms3) (BNormalSubgroups : NormalSubgroups) (BQuotientGroups : QuotientGroups) (BKernelsImages1 : KernelsImages1) (BKernelsImages2 : KernelsImages2) (BTrivialHomomorphisms : TrivialHomomorphisms) :
    ExceptT String IO ExactSequences := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { EXTENSION, FORALL_PAIR_THM, .. } := D.core3
  let { IMAGE_CLAUSES, IMAGE_ID, .. } := D.core4
  let { IN_CROSS, IN_ELIM_THM, IN_IMAGE, I_DEF, .. } := D.core5
  let { PAIR_EQ, .. } := D.core6
  let { UNWIND_THM1, .. } := D.core7
  let { GROUP_ID, trivial_group, .. } := BBasics
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  let { PROD_GROUP, .. } := BProdGroup
  let { group_epimorphism, group_homomorphism, group_monomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_ID, GROUP_HOMOMORPHISM_TRIVIAL,
        GROUP_MONOMORPHISM_INCLUSION, .. } := BHomomorphisms1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { GROUP_EPIMORPHISM_FST, GROUP_EPIMORPHISM_SND, GROUP_HOMOMORPHISM_PAIRED, .. } := BHomomorphisms3
  let { NORMAL_SUBGROUP_IMP_SUBGROUP, .. } := BNormalSubgroups
  let { GROUP_EPIMORPHISM_RIGHT_COSET, .. } := BQuotientGroups
  let { GROUP_EPIMORPHISM, GROUP_KERNEL_RIGHT_COSET, GROUP_MONOMORPHISM, group_image,
        group_kernel, .. } := BKernelsImages1
  let { GROUP_IMAGE_FROM_TRIVIAL_GROUP, GROUP_KERNEL_TO_TRIVIAL_GROUP, .. } := BKernelsImages2
  let { GROUP_KERNEL_IMAGE_TRIVIAL, TRIVIAL_HOMOMORPHISM_GROUP_IMAGE,
        TRIVIAL_HOMOMORPHISM_GROUP_KERNEL, .. } := BTrivialHomomorphisms
  -- @@SCOPE END

  let group_exactness ← new_definition
   r"group_exactness (G,H,K) ((f:A->B),(g:B->C)) <=>
        group_homomorphism (G,H) f /\ group_homomorphism (H,K) g /\
        group_image (G,H) f = group_kernel (H,K) g"

  let short_exact_sequence ← new_definition
   r"short_exact_sequence(A,B,C) (f:A->B,g:B->C) <=>
        group_monomorphism (A,B) f /\
        group_exactness (A,B,C) (f,g) /\
        group_epimorphism (B,C) g"

  let SHORT_EXACT_SEQUENCE ← prove
   r"!(f:A->B) (g:B->C) A B C.
        short_exact_sequence(A,B,C) (f,g) <=>
        group_monomorphism (A,B) f /\
        group_epimorphism (B,C) g /\
        group_image (A,B) f = group_kernel (B,C) g"
   (REWRITE_TAC [short_exact_sequence, group_monomorphism,
                group_exactness, group_epimorphism] THEN
    MESON_TAC [])

  let GROUP_EXACTNESS_MONOMORPHISM ← prove
   r"!f:(A->B) (g:B->C) A B C.
        trivial_group A
        ==> (group_exactness (A,B,C) (f,g) <=>
             group_homomorphism(A,B) f /\ group_monomorphism (B,C) g)"
   (SIMP_TAC [GROUP_MONOMORPHISM, group_exactness, trivial_group, group_image,
             IMAGE_CLAUSES, group_homomorphism] THEN
    MESON_TAC [])

  let GROUP_EXACTNESS_EPIMORPHISM ← prove
   r"!f:(A->B) (g:B->C) A B C.
        trivial_group C
        ==> (group_exactness (A,B,C) (f,g) <=>
             group_epimorphism(A,B) f /\ group_homomorphism (B,C) g)"
   (SIMP_TAC [GROUP_EPIMORPHISM, group_exactness, trivial_group] THEN
    SIMP_TAC [group_homomorphism, group_kernel] THEN SET_TAC [])

  let EXTREMELY_SHORT_EXACT_SEQUENCE ← prove
   r"!f:(A->B) (g:B->C) A B C.
        group_exactness (A,B,C) (f,g) /\
        trivial_group A /\ trivial_group C
        ==> trivial_group B"
   (REWRITE_TAC [group_exactness] THEN
    MESON_TAC [GROUP_KERNEL_TO_TRIVIAL_GROUP, GROUP_IMAGE_FROM_TRIVIAL_GROUP,
              trivial_group])

  let GROUP_EXACTNESS_EPIMORPHISM_EQ_TRIVIALITY ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) A B C D.
        group_exactness (A,B,C) (f,g) /\
        group_exactness (B,C,D) (g,h)
        ==> (group_epimorphism (A,B) f <=> trivial_homomorphism(B,C) g)"
   (REWRITE_TAC [group_exactness, GROUP_EPIMORPHISM] THEN
    SIMP_TAC [TRIVIAL_HOMOMORPHISM_GROUP_KERNEL])

  let GROUP_EXACTNESS_MONOMORPHISM_EQ_TRIVIALITY ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) A B C D.
        group_exactness (A,B,C) (f,g) /\
        group_exactness (B,C,D) (g,h)
        ==> (group_monomorphism (C,D) h <=>  trivial_homomorphism(B,C) g)"
   (REWRITE_TAC [group_exactness, GROUP_MONOMORPHISM] THEN
    SIMP_TAC [TRIVIAL_HOMOMORPHISM_GROUP_IMAGE])

  let VERY_SHORT_EXACT_SEQUENCE ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) A B C D.
        group_exactness (A,B,C) (f,g) /\
        group_exactness (B,C,D) (g,h) /\
        trivial_group A /\ trivial_group D
        ==> group_isomorphism (B,C) g"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [GROUP_MONOMORPHISM, GROUP_EPIMORPHISM, group_exactness] THEN
    MESON_TAC [GROUP_IMAGE_FROM_TRIVIAL_GROUP,
              GROUP_KERNEL_TO_TRIVIAL_GROUP])

  let GROUP_EXACTNESS_EQ_TRIVIALITY ← prove
   r"!f:(A->B) (g:B->C) (h:C->D) (k:D->E) A B C D E.
        group_exactness (A,B,C) (f,g) /\
        group_exactness (B,C,D) (g,h) /\
        group_exactness (C,D,E) (h,k)
        ==> (trivial_group C <=>
             group_epimorphism (A,B) f /\
             group_monomorphism (D,E) k)"
   (REWRITE_TAC [group_exactness, GROUP_EPIMORPHISM,
                GROUP_MONOMORPHISM] THEN
    ASM_MESON_TAC [trivial_group, GROUP_IMAGE_FROM_TRIVIAL_GROUP,
                  GROUP_KERNEL_IMAGE_TRIVIAL])

  let GROUP_EXACTNESS_IMP_TRIVIALITY ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) (k:D->E) A B C D E.
        group_exactness (A,B,C) (f,g) /\
        group_exactness (B,C,D) (g,h) /\
        group_exactness (C,D,E) (h,k) /\
        group_isomorphism (A,B) f /\
        group_isomorphism (D,E) k
        ==> trivial_group C"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    MESON_TAC [GROUP_EXACTNESS_EQ_TRIVIALITY])

  let GROUP_EXACTNESS_ISOMORPHISM_EQ_TRIVIALITY ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) (j:D->E) (k:E->G) A B C D E G.
        group_exactness (A,B,C) (f,g) /\
        group_exactness (B,C,D) (g,h) /\
        group_exactness (C,D,E) (h,j) /\
        group_exactness (D,E,G) (j,k)
        ==> (group_isomorphism (C,D) h <=>
             trivial_homomorphism(B,C) g /\ trivial_homomorphism(D,E) j)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN DISCH_THEN (CONJUNCTS_THEN2
     (fun th => tactic_of do pure (MP_TAC (← MATCH_MP GROUP_EXACTNESS_MONOMORPHISM_EQ_TRIVIALITY th)))
     (fun th => tactic_of do pure (MP_TAC (← MATCH_MP GROUP_EXACTNESS_EPIMORPHISM_EQ_TRIVIALITY th)))) THEN
    MESON_TAC [])

  let GROUP_EXACTNESS_ISOMORPHISM_EQ_MONO_EPI ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) (j:D->E) (k:E->G) A B C D E G.
        group_exactness (A,B,C) (f,g) /\
        group_exactness (B,C,D) (g,h) /\
        group_exactness (C,D,E) (h,j) /\
        group_exactness (D,E,G) (j,k)
        ==> (group_isomorphism (C,D) h <=>
             group_epimorphism(A,B) f /\ group_monomorphism(E,G) k)"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM,
                GROUP_EPIMORPHISM, GROUP_MONOMORPHISM] THEN
    REWRITE_TAC [group_exactness] THEN MESON_TAC [GROUP_KERNEL_IMAGE_TRIVIAL])

  let SHORT_EXACT_SEQUENCE_NORMAL_SUBGROUP ← prove
   r"!G n:A->bool.
        n normal_subgroup_of G
        ==> short_exact_sequence
             (subgroup_generated G n,G,quotient_group G n)
             ((\x. x),right_coset G n)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SHORT_EXACT_SEQUENCE, I_DEF] THEN
    REWRITE_TAC [GROUP_MONOMORPHISM_INCLUSION] THEN
    ASM_SIMP_TAC [GROUP_EPIMORPHISM_RIGHT_COSET] THEN
    ASM_SIMP_TAC [GROUP_KERNEL_RIGHT_COSET, group_image, IMAGE_ID] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                 NORMAL_SUBGROUP_IMP_SUBGROUP])

  let SHORT_EXACT_SEQUENCE_PROD_GROUP ← prove
   r"!(G:A group) (H:B group).
        short_exact_sequence(G,prod_group G H,H) ((\x. x,group_id H),SND)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [SHORT_EXACT_SEQUENCE, GROUP_EPIMORPHISM_SND] THEN
    SIMP_TAC [group_monomorphism, PAIR_EQ] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_PAIRED] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_TRIVIAL, GROUP_HOMOMORPHISM_ID] THEN
    REWRITE_TAC [group_image, group_kernel, EXTENSION, IN_ELIM_THM, IN_IMAGE] THEN
    REWRITE_TAC [FORALL_PAIR_THM, PAIR_EQ, ← GSYM CONJ_ASSOC, UNWIND_THM1] THEN
    REWRITE_TAC [PROD_GROUP, IN_CROSS] THEN MESON_TAC [GROUP_ID])

  let SHORT_EXACT_SEQUENCE_PROD_GROUP_ALT ← prove
   r"!(G:A group) (H:B group).
        short_exact_sequence(H,prod_group G H,G) ((\x. group_id G,x),FST)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [SHORT_EXACT_SEQUENCE, GROUP_EPIMORPHISM_FST] THEN
    SIMP_TAC [group_monomorphism, PAIR_EQ] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_PAIRED] THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM_TRIVIAL, GROUP_HOMOMORPHISM_ID] THEN
    REWRITE_TAC [group_image, group_kernel, EXTENSION, IN_ELIM_THM, IN_IMAGE] THEN
    REWRITE_TAC [FORALL_PAIR_THM, PAIR_EQ, ← GSYM CONJ_ASSOC, UNWIND_THM1] THEN
    REWRITE_TAC [PROD_GROUP, IN_CROSS] THEN MESON_TAC [GROUP_ID])

  -- @@RETURN BEGIN
  return { group_exactness, short_exact_sequence, SHORT_EXACT_SEQUENCE,
           GROUP_EXACTNESS_MONOMORPHISM, GROUP_EXACTNESS_EPIMORPHISM,
           EXTREMELY_SHORT_EXACT_SEQUENCE, GROUP_EXACTNESS_EPIMORPHISM_EQ_TRIVIALITY,
           GROUP_EXACTNESS_MONOMORPHISM_EQ_TRIVIALITY, VERY_SHORT_EXACT_SEQUENCE,
           GROUP_EXACTNESS_EQ_TRIVIALITY, GROUP_EXACTNESS_IMP_TRIVIALITY,
           GROUP_EXACTNESS_ISOMORPHISM_EQ_TRIVIALITY,
           GROUP_EXACTNESS_ISOMORPHISM_EQ_MONO_EPI, SHORT_EXACT_SEQUENCE_NORMAL_SUBGROUP,
           SHORT_EXACT_SEQUENCE_PROD_GROUP, SHORT_EXACT_SEQUENCE_PROD_GROUP_ALT }
  -- @@RETURN END

structure ExactSeq where
  -- @@FIELDS
  EXACT_SEQUENCE_SUM_LEMMA : thm
  SHORT_EXACT_SEQUENCE_QUOTIENT : thm
  TRIVIAL_GROUPS_IMP_SHORT_EXACT_SEQUENCE : thm
  SHORT_EXACT_SEQUENCE_TRIVIAL_GROUPS : thm
  SPLITTING_SUBLEMMA_GEN : thm
  SPLITTING_SUBLEMMA : thm
  SPLITTING_LEMMA_LEFT_GEN : thm
  SPLITTING_LEMMA_LEFT : thm
  SPLITTING_LEMMA_LEFT_PROD_GROUP : thm
  SPLITTING_LEMMA_RIGHT_GEN : thm
  SPLITTING_LEMMA_RIGHT : thm
  SPLITTING_LEMMA_RIGHT_PROD_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupExactSeq [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms3 : Homomorphisms3) (BHomomorphisms4 : Homomorphisms4) (BIso1 : Iso1) (BSetwise1 : Setwise1) (BNormalSubgroups : NormalSubgroups) (BKernelsImages1 : KernelsImages1) (BKernelsImages2 : KernelsImages2) (BGroupDisjointSum : GroupDisjointSum) (BGroupMulMorphism : GroupMulMorphism) (BGroupSumImKer : GroupSumImKer) (BExactSequences : ExactSequences) :
    ExceptT String IO ExactSeq := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, TAUT, basic_ss, .. } := D
  let { EXISTS_PAIR_THM, .. } := D.core2
  let { EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_PAIR_THM, .. } := D.core3
  let { IMAGE_SUBSET, IMP_CONJ, .. } := D.core4
  let { IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_SING, LAMBDA_PAIR, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, PAIR_EQ, .. } := D.core6
  let { SUBSET, SUBSET_REFL, SWAP_EXISTS_THM, .. } := D.core7
  let { o_DEF, o_THM, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, SINGLETON_GROUP, TRIVIAL_GROUP_SINGLETON_GROUP, .. } := BBasics
  let { GROUP_INV_ID, GROUP_LID_EQ, GROUP_RID_EQ, group_div, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_GROUP_CARRIER, .. } := BSubgroupGen1
  let { PROD_GROUP, .. } := BProdGroup
  let { GROUP_ISOMORPHISM_EQ, group_epimorphism, group_homomorphism, group_isomorphism,
        group_isomorphisms, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED,
        GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN, GROUP_ISOMORPHISM_ID, .. } := BHomomorphisms1
  let { GROUP_ISOMORPHISM, GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { GROUP_EPIMORPHISM_ISOMORPHISM_COMPOSE_REV, GROUP_HOMOMORPHISM_OF_FST,
        GROUP_HOMOMORPHISM_OF_SND, GROUP_HOMOMORPHISM_PAIRED,
        GROUP_ISOMORPHISM_PAIRED2, .. } := BHomomorphisms3
  let { ABELIAN_GROUP_HOMOMORPHISM_GROUP_MUL, .. } := BHomomorphisms4
  let { ISOMORPHIC_GROUP_PROD_GROUPS, ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRANS,
        isomorphic_group, .. } := BIso1
  let { group_setmul, .. } := BSetwise1
  let { NORMAL_SUBGROUP_IMP_SUBGROUP, normal_subgroup_of, .. } := BNormalSubgroups
  let { GROUP_EPIMORPHISM, GROUP_EPIMORPHISM_ALT, GROUP_ISOMORPHISM_ONTO_IMAGE,
        GROUP_KERNEL_FROM_SUBGROUP_GENERATED, GROUP_KERNEL_TO_SUBGROUP_GENERATED,
        GROUP_MONOMORPHISM, NORMAL_SUBGROUP_GROUP_KERNEL, SUBGROUP_GROUP_IMAGE,
        SUBGROUP_GROUP_KERNEL, group_image, group_kernel, .. } := BKernelsImages1
  let { FIRST_GROUP_ISOMORPHISM_THEOREM, .. } := BKernelsImages2
  let { GROUP_DISJOINT_SUM_ALT, .. } := BGroupDisjointSum
  let { GROUP_ISOMORPHISM_GROUP_MUL, .. } := BGroupMulMorphism
  let { GROUP_SEMIDIRECT_SUM_IM_KER, GROUP_SEMIDIRECT_SUM_KER_IM, .. } := BGroupSumImKer
  let { GROUP_EXACTNESS_EPIMORPHISM, GROUP_EXACTNESS_MONOMORPHISM, group_exactness,
        short_exact_sequence, .. } := BExactSequences
  -- @@SCOPE END

  let EXACT_SEQUENCE_SUM_LEMMA ← prove
   r"!(f:X->C) (g:X->D) (h:A->C) (i:A->X) (j:B->X) (k:B->D) A B C D X.
        abelian_group X /\
        group_isomorphism(A,C) h /\
        group_isomorphism(B,D) k /\
        group_exactness(A,X,D) (i,g) /\
        group_exactness(B,X,C) (j,f) /\
        (!x. x IN group_carrier A ==> f(i x) = h x) /\
        (!x. x IN group_carrier B ==> g(j x) = k x)
        ==> group_isomorphism (prod_group A B,X)
                              (\(x,y). group_mul X (i x) (j y)) /\
            group_isomorphism (X,prod_group C D) (\z. f z,g z)"
   (← do
    let ss2 ← ExceptT.mk (basic_ss [])
    let ss1 ← ExceptT.mk (basic_ss [])
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [group_exactness] THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"ij:A#B->X = \(x,y). group_mul X (i x) (j y)") THEN
    ABBREV_TAC (← q r"gf:X->C#D = \z. f z,g z") THEN
    MATCH_MP_TAC GROUP_EPIMORPHISM_ISOMORPHISM_COMPOSE_REV THEN
    SUBGOAL_THEN (← q r"group_homomorphism (prod_group A B,X) (ij:A#B->X)")
    ASSUME_TAC THENL
     [EXPAND_TAC "ij" THEN REWRITE_TAC [LAMBDA_PAIR] THEN
      MATCH_MP_TAC ABELIAN_GROUP_HOMOMORPHISM_GROUP_MUL THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
      ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_OF_FST, GROUP_HOMOMORPHISM_OF_SND],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"group_homomorphism (X,prod_group C D) (gf:X->C#D)")
    ASSUME_TAC THENL
     [EXPAND_TAC "gf" THEN REWRITE_TAC [GROUP_HOMOMORPHISM_PAIRED] THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [GROUP_EPIMORPHISM_ALT] THEN CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC GROUP_ISOMORPHISM_EQ THEN
      EXISTS_TAC (← q r"(\(x,y). h x,k y):A#B->C#D") THEN
      ASM_REWRITE_TAC [GROUP_ISOMORPHISM_PAIRED2] THEN
      MAP_EVERY EXPAND_TAC ["gf", "ij"] THEN
      REWRITE_TAC [PROD_GROUP, o_DEF, PAIR_EQ, IN_CROSS, FORALL_PAIR_THM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE
       [GROUP_ISOMORPHISM, group_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
      ASM_SIMP_TAC [GROUP_LID_EQ, GROUP_RID_EQ] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [group_image, group_kernel]) THEN
      ASM SET_TAC []] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:X") THEN DISCH_TAC THEN
    UNDISCH_TAC (← q r"group_image (B,X) (j:B->X) = group_kernel (X,C) (f:X->C)") THEN
    MP_TAC (← ASSUME (← q r"group_isomorphism (A,C) (h:A->C)")) THEN
    REWRITE_TAC [group_isomorphism, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h':C->A") THEN REWRITE_TAC [group_isomorphisms] THEN STRIP_TAC THEN
    REWRITE_TAC [EXTENSION] THEN DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← EQ_IMP_RULE (← SPEC (← q r"group_div X x ((i:A->X)((h':C->A)(f x)))") th)).2)) THEN
    REWRITE_TAC [group_kernel, group_image, IN_ELIM_THM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [group_homomorphism, GROUP_ISOMORPHISM, SUBSET, FORALL_IN_IMAGE]) THEN
    ANTS_TAC THENL
     [ASM (simpTac ss1 5)
       [group_div, GROUP_INV, GROUP_MUL, GROUP_MUL_RINV],
      EXPAND_TAC "ij" THEN REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"y:B") THEN SIMP_TAC [PROD_GROUP, IN_CROSS] THEN
      DISCH_THEN (CONJUNCTS_THEN2 (SUBST1_TAC o SYM) ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(h':C->A)(f(x:X))") THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM (fun th => tactic_of do pure (
          wPart (fun t => do rand t)
                (fun t => do lhand (← rand t))
                (← GEN_REWRITE_RULE I [abelian_group] th))) THEN
      ASM (simpTac ss2 5)
       [group_div, GROUP_INV, GROUP_MUL, ← GSYM GROUP_MUL_ASSOC,
        GROUP_MUL_LINV, GROUP_MUL_RID]]))

  let SHORT_EXACT_SEQUENCE_QUOTIENT ← prove
   r"!(f:A->B) (g:B->C) A B C.
        short_exact_sequence(A,B,C) (f,g)
        ==> subgroup_generated B (group_image(A,B) f) isomorphic_group A /\
            quotient_group B (group_image(A,B) f) isomorphic_group C"
   (REWRITE_TAC [short_exact_sequence] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THENL
     [ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN EXISTS_TAC (← q r"f:A->B") THEN
      ASM_REWRITE_TAC [GROUP_ISOMORPHISM_ONTO_IMAGE],
      MP_TAC (← ISPECL
       [(← q r"B:B group"), (← q r"C:C group"), (← q r"g:B->C")]
       FIRST_GROUP_ISOMORPHISM_THEOREM) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [GROUP_EPIMORPHISM, group_exactness]) THEN
      ASM_REWRITE_TAC [SUBGROUP_GENERATED_GROUP_CARRIER]])

  let TRIVIAL_GROUPS_IMP_SHORT_EXACT_SEQUENCE ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) (k:D->E) A B C D E.
        trivial_group A /\ trivial_group E /\
        group_exactness(A,B,C) (f,g) /\
        group_exactness(B,C,D) (g,h) /\
        group_exactness(C,D,E) (h,k)
        ==> short_exact_sequence(B,C,D) (g,h)"
   (SIMP_TAC [IMP_CONJ, GROUP_EXACTNESS_MONOMORPHISM, GROUP_EXACTNESS_EPIMORPHISM,
             short_exact_sequence])

  let SHORT_EXACT_SEQUENCE_TRIVIAL_GROUPS ← prove
   r"!(g:B->C) h B C D.
        short_exact_sequence(B,C,D) (g,h) <=>
        ?f:(A->B) (k:D->E) A E.
                trivial_group A /\ trivial_group E /\
                group_exactness(A,B,C) (f,g) /\
                group_exactness(B,C,D) (g,h) /\
                group_exactness(C,D,E) (h,k)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [TRIVIAL_GROUPS_IMP_SHORT_EXACT_SEQUENCE] THEN
    REWRITE_TAC [short_exact_sequence] THEN STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [(← q r"(\x. group_id B):A->B"), (← q r"(\x. ARB):D->E"),
      (← q r"singleton_group (ARB:A)"), (← q r"singleton_group (ARB:E)")] THEN
    ASM_SIMP_TAC [TRIVIAL_GROUP_SINGLETON_GROUP,
                 GROUP_EXACTNESS_MONOMORPHISM, GROUP_EXACTNESS_EPIMORPHISM] THEN
    REWRITE_TAC [group_homomorphism, SINGLETON_GROUP] THEN
    SIMP_TAC [GROUP_INV_ID, GROUP_MUL_LID, GROUP_ID, SUBSET, FORALL_IN_IMAGE,
             IN_SING])

  let SPLITTING_SUBLEMMA_GEN ← prove
   r"!(f:A->B) (g:B->C) A B C h k.
        group_exactness(A,B,C) (f,g) /\
        group_image(A,B) f = h /\ k subgroup_of B /\
        h INTER k SUBSET {group_id B} /\ group_setmul B h k = group_carrier B
        ==> group_isomorphism(subgroup_generated B k,
                              subgroup_generated C (group_image(B,C) g)) g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_exactness] THEN
    ASM_CASES_TAC (← q r"group_image(A,B) (f:A->B) = h") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"group_kernel(B,C) (g:B->C) = h") THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(h:B->bool) subgroup_of B") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBGROUP_GROUP_KERNEL], ALL_TAC] THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM, GROUP_MONOMORPHISM,
                GROUP_EPIMORPHISM_ALT] THEN
    REWRITE_TAC [(← TAUT (← q r"(p /\ q) /\ (p /\ r) <=> p /\ q /\ r"))] THEN
    REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [GROUP_HOMOMORPHISM_INTO_SUBGROUP_EQ_GEN,
                   CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                   SUBGROUP_GROUP_IMAGE,
                   GROUP_HOMOMORPHISM_FROM_SUBGROUP_GENERATED] THEN
      ASM_SIMP_TAC [group_image, SUBGROUP_OF_IMP_SUBSET, IMAGE_SUBSET],
      ASM_SIMP_TAC [GROUP_KERNEL_FROM_SUBGROUP_GENERATED,
                   GROUP_KERNEL_TO_SUBGROUP_GENERATED] THEN
      ASM_SIMP_TAC [SUBGROUP_GENERATED, ← GSYM GROUP_DISJOINT_SUM_ALT],
      ASM_SIMP_TAC [SUBSET, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                   SUBGROUP_GROUP_IMAGE] THEN
      REWRITE_TAC [group_image, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
      SUBST1_TAC (← SYM (← ASSUME
       (← q r"group_setmul B (h:B->bool) k = group_carrier B"))) THEN
      REWRITE_TAC [group_setmul, FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [(← q r"x:B"), (← q r"y:B")] THEN STRIP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [group_epimorphism, group_homomorphism,
                                  subgroup_of, SUBSET, FORALL_IN_IMAGE]) THEN
      ASM_SIMP_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"y:B") THEN
      UNDISCH_TAC (← q r"(x:B) IN h") THEN SUBST1_TAC (← SYM (← ASSUME
         (← q r"group_kernel (B,C) (g:B->C) = h"))) THEN
      SIMP_TAC [group_kernel, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [GROUP_MUL_LID]])

  let SPLITTING_SUBLEMMA ← prove
   r"!(f:A->B) (g:B->C) A B C h k.
        short_exact_sequence(A,B,C) (f,g) /\
        group_image(A,B) f = h /\ k subgroup_of B /\
        h INTER k SUBSET {group_id B} /\ group_setmul B h k = group_carrier B
        ==> group_isomorphism(A,subgroup_generated B h) f /\
            group_isomorphism(subgroup_generated B k,C) g"
   (REWRITE_TAC [short_exact_sequence] THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [GROUP_ISOMORPHISM_ONTO_IMAGE], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"C = subgroup_generated C (group_image(B,C) (g:B->C))")
    SUBST1_TAC THENL
     [ASM_MESON_TAC [group_epimorphism, group_image,
                    SUBGROUP_GENERATED_GROUP_CARRIER],
      MATCH_MP_TAC SPLITTING_SUBLEMMA_GEN THEN ASM_MESON_TAC []])

  let SPLITTING_LEMMA_LEFT_GEN ← prove
   r"!(f:A->B) f' (g:B->C) A B C.
        short_exact_sequence(A,B,C) (f,g) /\
        group_homomorphism(B,A) f' /\
        group_isomorphism(A,A) (f' o f)
        ==> ?h k. h normal_subgroup_of B /\ k normal_subgroup_of B /\
                  h INTER k SUBSET {group_id B} /\
                  group_setmul B h k = group_carrier B /\
                  group_isomorphism(A,subgroup_generated B h) f /\
                  group_isomorphism(subgroup_generated B k,C) g"
   (← do
    let a1 ← TAUT (← q r"(p /\ q) /\ (p /\ q ==> r) ==> p /\ q /\ r")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"f:A->B"), (← q r"f':B->A"), (← q r"A:A group"),
          (← q r"B:B group"), (← q r"A:A group")]
          GROUP_SEMIDIRECT_SUM_IM_KER) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [short_exact_sequence, group_exactness], ALL_TAC] THEN
    MAP_EVERY ABBREV_TAC
     [(← q r"h = group_image(A,B) (f:A->B)"), (← q r"k = group_kernel(B,A) (f':B->A)")] THEN
    STRIP_TAC THEN MAP_EVERY EXISTS_TAC [(← q r"h:B->bool"), (← q r"k:B->bool")] THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN MATCH_MP_TAC a1 THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [NORMAL_SUBGROUP_GROUP_KERNEL,
                    short_exact_sequence, group_exactness],
      REWRITE_TAC [normal_subgroup_of] THEN STRIP_TAC THEN
      MATCH_MP_TAC SPLITTING_SUBLEMMA THEN ASM_REWRITE_TAC [SUBSET_REFL]]))

  let SPLITTING_LEMMA_LEFT ← prove
   r"!(f:A->B) f' (g:B->C) A B C.
        short_exact_sequence(A,B,C) (f,g) /\
        group_homomorphism(B,A) f' /\
        (!x. x IN group_carrier A ==> f'(f x) = x)
        ==> ?h k. h normal_subgroup_of B /\ k normal_subgroup_of B /\
                  h INTER k SUBSET {group_id B} /\
                  group_setmul B h k = group_carrier B /\
                  group_isomorphism(A,subgroup_generated B h) f /\
                  group_isomorphism(subgroup_generated B k,C) g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SPLITTING_LEMMA_LEFT_GEN THEN
    EXISTS_TAC (← q r"f':B->A") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC GROUP_ISOMORPHISM_EQ THEN EXISTS_TAC (← q r"\x:A. x") THEN
    ASM_REWRITE_TAC [o_THM, GROUP_ISOMORPHISM_ID])

  let SPLITTING_LEMMA_LEFT_PROD_GROUP ← prove
   r"!(f:A->B) f' (g:B->C) A B C.
        short_exact_sequence(A,B,C) (f,g) /\
        abelian_group B /\
        group_homomorphism(B,A) f' /\
        (!x. x IN group_carrier A ==> f'(f x) = x)
        ==> B isomorphic_group prod_group A C"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"f:A->B"), (← q r"f':B->A"), (← q r"g:B->C"),
          (← q r"A:A group"), (← q r"B:B group"), (← q r"C:C group")]
          SPLITTING_LEMMA_LEFT) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [(← q r"h:B->bool"), (← q r"k:B->bool")] THEN STRIP_TAC THEN
    TRANS_TAC ISOMORPHIC_GROUP_TRANS
     (← q r"prod_group (subgroup_generated B h)
                 (subgroup_generated B (k:B->bool))") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN
      EXISTS_TAC (← q r"\(x:B,y). group_mul B x y") THEN
      ASM_SIMP_TAC [GROUP_ISOMORPHISM_GROUP_MUL, NORMAL_SUBGROUP_IMP_SUBGROUP],
      MATCH_MP_TAC ISOMORPHIC_GROUP_PROD_GROUPS THEN
      GEN_REWRITE_TAC LAND_CONV [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN ASM_MESON_TAC []])

  let SPLITTING_LEMMA_RIGHT_GEN ← prove
   r"!(f:A->B) (g:B->C) g' A B C.
        short_exact_sequence(A,B,C) (f,g) /\
        group_homomorphism(C,B) g' /\
        group_isomorphism(C,C) (g o g')
        ==> ?h k. h normal_subgroup_of B /\ k subgroup_of B /\
                  h INTER k SUBSET {group_id B} /\
                  group_setmul B h k = group_carrier B /\
                  group_isomorphism(A,subgroup_generated B h) f /\
                  group_isomorphism(subgroup_generated B k,C) g"
   (← do
    let a1 ← TAUT (← q r"(p /\ q) /\ (p /\ q ==> r) ==> p /\ q /\ r")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"g':C->B"), (← q r"g:B->C"), (← q r"C:C group"),
          (← q r"B:B group"), (← q r"C:C group")]
          GROUP_SEMIDIRECT_SUM_KER_IM) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [short_exact_sequence, group_exactness], ALL_TAC] THEN
    MAP_EVERY ABBREV_TAC
     [(← q r"k = group_image(C,B) (g':C->B)"), (← q r"h = group_kernel(B,C) (g:B->C)")] THEN
    STRIP_TAC THEN MAP_EVERY EXISTS_TAC [(← q r"h:B->bool"), (← q r"k:B->bool")] THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN MATCH_MP_TAC a1 THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [SUBGROUP_GROUP_IMAGE, NORMAL_SUBGROUP_GROUP_KERNEL,
                    short_exact_sequence, group_exactness],
      REWRITE_TAC [normal_subgroup_of] THEN STRIP_TAC THEN
      MATCH_MP_TAC SPLITTING_SUBLEMMA THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
      ASM_MESON_TAC [short_exact_sequence, group_exactness]]))

  let SPLITTING_LEMMA_RIGHT ← prove
   r"!(f:A->B) (g:B->C) g' A B C.
        short_exact_sequence(A,B,C) (f,g) /\
        group_homomorphism(C,B) g' /\
        (!z. z IN group_carrier C ==> g(g' z) = z)
        ==> ?h k. h normal_subgroup_of B /\ k subgroup_of B /\
                  h INTER k SUBSET {group_id B} /\
                  group_setmul B h k = group_carrier B /\
                  group_isomorphism(A,subgroup_generated B h) f /\
                  group_isomorphism(subgroup_generated B k,C) g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SPLITTING_LEMMA_RIGHT_GEN THEN
    EXISTS_TAC (← q r"g':C->B") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC GROUP_ISOMORPHISM_EQ THEN EXISTS_TAC (← q r"\x:C. x") THEN
    ASM_REWRITE_TAC [o_THM, GROUP_ISOMORPHISM_ID])

  let SPLITTING_LEMMA_RIGHT_PROD_GROUP ← prove
   r"!(f:A->B) (g:B->C) g' A B C.
        short_exact_sequence(A,B,C) (f,g) /\
        abelian_group B /\
        group_homomorphism(C,B) g' /\
        (!z. z IN group_carrier C ==> g(g' z) = z)
        ==> B isomorphic_group prod_group A C"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"f:A->B"), (← q r"g:B->C"), (← q r"g':C->B"),
          (← q r"A:A group"), (← q r"B:B group"), (← q r"C:C group")]
          SPLITTING_LEMMA_RIGHT) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [(← q r"h:B->bool"), (← q r"k:B->bool")] THEN STRIP_TAC THEN
    TRANS_TAC ISOMORPHIC_GROUP_TRANS
     (← q r"prod_group (subgroup_generated B h)
                 (subgroup_generated B (k:B->bool))") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN
      EXISTS_TAC (← q r"\(x:B,y). group_mul B x y") THEN
      ASM_SIMP_TAC [GROUP_ISOMORPHISM_GROUP_MUL, NORMAL_SUBGROUP_IMP_SUBGROUP],
      MATCH_MP_TAC ISOMORPHIC_GROUP_PROD_GROUPS THEN
      GEN_REWRITE_TAC LAND_CONV [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [isomorphic_group] THEN ASM_MESON_TAC []])

  -- @@RETURN BEGIN
  return { EXACT_SEQUENCE_SUM_LEMMA, SHORT_EXACT_SEQUENCE_QUOTIENT,
           TRIVIAL_GROUPS_IMP_SHORT_EXACT_SEQUENCE, SHORT_EXACT_SEQUENCE_TRIVIAL_GROUPS,
           SPLITTING_SUBLEMMA_GEN, SPLITTING_SUBLEMMA, SPLITTING_LEMMA_LEFT_GEN,
           SPLITTING_LEMMA_LEFT, SPLITTING_LEMMA_LEFT_PROD_GROUP,
           SPLITTING_LEMMA_RIGHT_GEN, SPLITTING_LEMMA_RIGHT,
           SPLITTING_LEMMA_RIGHT_PROD_GROUP }
  -- @@RETURN END

structure FiveLemma where
  -- @@FIELDS
  SPLITTING_LEMMA_FREE_ABELIAN_GROUP : thm
  FOUR_LEMMA_MONO : thm
  FOUR_LEMMA_EPI : thm
  FIVE_LEMMA : thm
  deriving Inhabited

@[nospecialize]
def setupFiveLemma [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BKernelsImages1 : KernelsImages1) (BFreeAbelianGroup : FreeAbelianGroup) (BExactSequences : ExactSequences) (BExactSeq : ExactSeq) :
    ExceptT String IO FiveLemma := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, FRAG_MODULE, SET_RULE, SET_TAC, TAUT, .. } := D
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { IN_IMAGE, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MONO_AND, .. } := D.core6
  let { SKOLEM_THM, SUBSET, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LINV, GROUP_MUL_RID,
        GROUP_MUL_RINV, .. } := BBasics
  let { group_div, .. } := BDerived
  let { group_epimorphism, group_homomorphism, group_isomorphism, group_isomorphisms,
        group_monomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_COMPOSE, GROUP_HOMOMORPHISM_DIV, .. } := BHomomorphisms1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { isomorphic_group, .. } := BIso1
  let { GROUP_EPIMORPHISM_ALT, GROUP_MONOMORPHISM_ALT, group_image, group_kernel, .. } := BKernelsImages1
  let { FRAG_OF_IN_FREE_ABELIAN_GROUP, FREE_ABELIAN_GROUP, FREE_ABELIAN_GROUP_INDUCT,
        FREE_ABELIAN_GROUP_UNIVERSAL, .. } := BFreeAbelianGroup
  let { group_exactness, short_exact_sequence, .. } := BExactSequences
  let { SPLITTING_LEMMA_RIGHT_PROD_GROUP, .. } := BExactSeq
  -- @@SCOPE END

  let SPLITTING_LEMMA_FREE_ABELIAN_GROUP ← prove
   r"!(f:A->B) (g:B->C) A B C (s:D->bool).
        short_exact_sequence (A,B,C) (f,g) /\
        abelian_group B /\ C isomorphic_group free_abelian_group s
        ==> B isomorphic_group prod_group A C"
   (← do
    let a2 ← FRAG_MODULE (← q r"frag_add x (frag_neg y) = frag_sub x y")
    let a1 ← SET_RULE (← q
     r"IMAGE f s = t ==> !y. ?x. y IN t ==> x IN s /\ f x = y")
    pure (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SPLITTING_LEMMA_RIGHT_PROD_GROUP THEN
    MAP_EVERY EXISTS_TAC [(← q r"f:A->B"), (← q r"g:B->C")] THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE I [short_exact_sequence]) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [group_epimorphism]) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP a1) THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g':C->B") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [isomorphic_group]) THEN
    REWRITE_TAC [isomorphic_group, group_isomorphism, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [(← q r"h:C->D frag"), (← q r"h':D frag->C")] THEN
    REWRITE_TAC [group_isomorphisms] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [(← q r"(g':C->B) o (h':D frag->C) o frag_of"), (← q r"s:D->bool"), (← q r"B:B group")]
          FREE_ABELIAN_GROUP_UNIVERSAL) THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, o_THM] THEN ANTS_TAC THENL
     [GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV)
       [← GSYM FRAG_OF_IN_FREE_ABELIAN_GROUP] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:D frag->B") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(k:D frag->B) o (h:C->D frag)") THEN
      CONJ_TAC THENL [ASM_MESON_TAC [GROUP_HOMOMORPHISM_COMPOSE], ALL_TAC] THEN
      X_GEN_TAC (← q r"c:C") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"c = (h':D frag->C) (h c) /\
        h c IN group_carrier(free_abelian_group s)")
      (CONJUNCTS_THEN2 SUBST1_TAC MP_TAC) THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [],
        SPEC_TAC ((← q r"(h:C->D frag) c"), (← q r"d:D frag"))] THEN
      ASM_SIMP_TAC [o_THM] THEN
      MATCH_MP_TAC FREE_ABELIAN_GROUP_INDUCT THEN
      ASM_SIMP_TAC [] THEN
      REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
        let t2 ← REWRITE_RULE [group_homomorphism, SUBSET] th
        pure (MP_TAC (← MATCH_MP GROUP_HOMOMORPHISM_DIV th) THEN
              MP_TAC t2))) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, group_div] THEN
      REWRITE_TAC [(← CONJUNCT2 FREE_ABELIAN_GROUP), a2] THEN
      REPEAT STRIP_TAC THEN ASM_SIMP_TAC [] THEN
      ASM_MESON_TAC [FRAG_OF_IN_FREE_ABELIAN_GROUP]]))

  let FOUR_LEMMA_MONO ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) (f':A'->B') (g':B'->C') (h':C'->D') a b c d
       A B C D A' B' C' D'.
        group_epimorphism(A,A') a /\
        group_monomorphism(B,B') b /\
        group_homomorphism(C,C') c /\
        group_monomorphism(D,D') d /\
        group_exactness(A,B,C) (f,g) /\ group_exactness(B,C,D) (g,h) /\
        group_exactness(A',B',C') (f',g') /\ group_exactness(B',C',D') (g',h') /\
        (!x. x IN group_carrier A ==> f'(a x) = b(f x)) /\
        (!y. y IN group_carrier B ==> g'(b y) = c(g y)) /\
        (!z. z IN group_carrier C ==> h'(c z) = d(h z))
        ==> group_monomorphism(C,C') c"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [GROUP_MONOMORPHISM_ALT] THEN
    REWRITE_TAC [group_epimorphism, group_monomorphism, group_exactness] THEN
    REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [group_image, group_kernel] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"x:C") THEN STRIP_TAC THEN
    MAP_EVERY (fun tm => tactic_of do pure (ASSUME_TAC (← C ISPEC GROUP_ID tm)))
     [(← q r"A:A group"), (← q r"B:B group"), (← q r"C:C group"), (← q r"D:D group"),
      (← q r"A':A' group"), (← q r"B':B' group"), (← q r"C':C' group"), (← q r"D':D' group")] THEN
    SUBGOAL_THEN (← q r"(h:C->D) x = group_id D")
    ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?y. y IN group_carrier B /\ (g:B->C) y = x")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?w. w IN group_carrier A' /\ (f':A'->B') w = (b:B->B') y")
    STRIP_ASSUME_TAC THEN ASM SET_TAC [])

  let FOUR_LEMMA_EPI ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) (f':A'->B') (g':B'->C') (h':C'->D') a b c d
       A B C D A' B' C' D'.
        group_epimorphism(A,A') a /\
        group_homomorphism(B,B') b /\
        group_epimorphism(C,C') c /\
        group_monomorphism(D,D') d /\
        group_exactness(A,B,C) (f,g) /\ group_exactness(B,C,D) (g,h) /\
        group_exactness(A',B',C') (f',g') /\ group_exactness(B',C',D') (g',h') /\
        (!x. x IN group_carrier A ==> f'(a x) = b(f x)) /\
        (!y. y IN group_carrier B ==> g'(b y) = c(g y)) /\
        (!z. z IN group_carrier C ==> h'(c z) = d(h z))
        ==> group_epimorphism(B,B') b"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [GROUP_EPIMORPHISM_ALT] THEN
    REWRITE_TAC [group_epimorphism, group_monomorphism, group_exactness] THEN
    REWRITE_TAC [group_homomorphism, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [group_image, group_kernel] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"x:B'") THEN DISCH_TAC THEN
    MAP_EVERY (fun tm => tactic_of do pure (ASSUME_TAC (← C ISPEC GROUP_ID tm)))
     [(← q r"A:A group"), (← q r"B:B group"), (← q r"C:C group"), (← q r"D:D group"),
      (← q r"A':A' group"), (← q r"B':B' group"), (← q r"C':C' group"), (← q r"D':D' group")] THEN
    SUBGOAL_THEN (← q r"?y. y IN group_carrier C /\ (c:C->C') y = (g':B'->C') x")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(h:C->D) y = group_id D")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?z. z IN group_carrier B /\ (g:B->C) z = y")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ABBREV_TAC (← q r"w =  group_mul B' x (group_inv B' ((b:B->B') z))") THEN
    SUBGOAL_THEN (← q r"(w:B') IN group_carrier B'")
    STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [GROUP_MUL, GROUP_INV], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(g':B'->C') w = group_id C'")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "w" THEN ASM_SIMP_TAC [GROUP_INV, GROUP_MUL_RINV],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?v. v IN group_carrier A' /\ (f':A'->B') v = w")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?u. u IN group_carrier A /\ (a:A->A') u = v")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [IN_IMAGE] THEN
    EXISTS_TAC (← q r"group_mul B ((f:A->B) u) z") THEN ASM_SIMP_TAC [GROUP_MUL] THEN
    SUBGOAL_THEN (← q r"(b:B->B') ((f:A->B) u) = w")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBST1_TAC (← SYM (← ASSUME
     (← q r"group_mul B' x (group_inv B' ((b:B->B') z)) = w"))) THEN
    ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_INV,
                 GROUP_MUL_LINV, GROUP_MUL_RID])

  let FIVE_LEMMA ← prove
   r"!(f:A->B) (g:B->C) (h:C->D) (k:D->E)
      (f':A'->B') (g':B'->C') (h':C'->D') (k':D'->E') a b c d e
       A B C D E A' B' C' D' E'.
        group_epimorphism(A,A') a /\
        group_isomorphism(B,B') b /\
        group_homomorphism(C,C') c /\
        group_isomorphism(D,D') d /\
        group_monomorphism(E,E') e /\
        group_exactness(A,B,C) (f,g) /\
        group_exactness(B,C,D) (g,h) /\
        group_exactness(C,D,E) (h,k) /\
        group_exactness(A',B',C') (f',g') /\
        group_exactness(B',C',D') (g',h') /\
        group_exactness(C',D',E') (h',k') /\
        (!x. x IN group_carrier A ==> f'(a x) = b(f x)) /\
        (!y. y IN group_carrier B ==> g'(b y) = c(g y)) /\
        (!z. z IN group_carrier C ==> h'(c z) = d(h z)) /\
        (!w. w IN group_carrier D ==> k'(d w) = e(k w))
        ==> group_isomorphism(C,C') c"
   (← do
    let a1 ← TAUT (← q
     r"a /\ (b /\ b') /\ c /\ (d /\ d') /\ e /\
      fg /\ gh /\ hk /\ fg' /\ gh' /\ hk' /\
      ca /\ cb /\ cc /\ cd
      ==> (a /\ b /\ c /\ d /\ fg /\ gh /\ fg' /\ gh' /\ ca /\ cb /\ cc) /\
          (b' /\ c /\ d' /\ e /\ gh /\ hk /\ gh' /\ hk' /\ cb /\ cc /\ cd)")
    pure (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP a1) THEN
    MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [FOUR_LEMMA_MONO, FOUR_LEMMA_EPI]))

  -- @@RETURN BEGIN
  return { SPLITTING_LEMMA_FREE_ABELIAN_GROUP, FOUR_LEMMA_MONO, FOUR_LEMMA_EPI,
           FIVE_LEMMA }
  -- @@RETURN END

structure ShortFiveLemma where
  -- @@FIELDS
  SHORT_FIVE_LEMMA_MONO : thm
  SHORT_FIVE_LEMMA_EPI : thm
  SHORT_FIVE_LEMMA : thm
  EXACT_SEQUENCE_HEXAGON_LEMMA : thm
  deriving Inhabited

@[nospecialize]
def setupShortFiveLemma [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BGroupRule : GroupRule) (BProdGroup : ProdGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms3 : Homomorphisms3) (BKernelsImages1 : KernelsImages1) (BExactSequences : ExactSequences) (BExactSeq : ExactSeq) (BFiveLemma : FiveLemma) :
    ExceptT String IO ShortFiveLemma := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { FORALL_PAIR_THM, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_CROSS, IN_IMAGE, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MONO_AND, .. } := D.core6
  let { GROUP_MUL, trivial_group, .. } := BBasics
  let { GROUP_RULE, .. } := BGroupRule
  let { PROD_GROUP, .. } := BProdGroup
  let { group_epimorphism, group_homomorphism, group_isomorphism, group_isomorphisms,
        group_monomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_TRIVIAL, .. } := BHomomorphisms1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { GROUP_EPIMORPHISM_TO_TRIVIAL_GROUP, GROUP_MONOMORPHISM_TO_TRIVIAL_GROUP, .. } := BHomomorphisms3
  let { GROUP_ISOMORPHISM_ALT, group_image, group_kernel, .. } := BKernelsImages1
  let { group_exactness, .. } := BExactSequences
  let { EXACT_SEQUENCE_SUM_LEMMA, SHORT_EXACT_SEQUENCE_TRIVIAL_GROUPS, .. } := BExactSeq
  let { FOUR_LEMMA_EPI, FOUR_LEMMA_MONO, .. } := BFiveLemma
  -- @@SCOPE END

  let SHORT_FIVE_LEMMA_MONO ← prove
   r"!(f:A->B) (g:B->C) (f':A'->B') (g':B'->C') a b c A B C A' B' C'.
        group_monomorphism(A,A') a /\
        group_homomorphism(B,B') b /\
        group_monomorphism(C,C') c /\
        short_exact_sequence(A,B,C) (f,g) /\
        short_exact_sequence(A',B',C') (f',g') /\
        (!x. x IN group_carrier A ==> f'(a x) = b(f x)) /\
        (!y. y IN group_carrier B ==> g'(b y) = c(g y))
        ==> group_monomorphism(B,B') b"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(?(w:Z->A) (z:C->Z) W Z.
          trivial_group W /\ trivial_group Z /\
          group_exactness (W,A,B) (w,f:A->B) /\
          group_exactness (A,B,C) (f,g) /\
          group_exactness (B,C,Z) (g:B->C,z)) /\
      (?(w':Z->A') (z':C'->Z) W' Z'.
          trivial_group W' /\ trivial_group Z' /\
          group_exactness (W',A',B') (w',f':A'->B') /\
          group_exactness (A',B',C') (f',g') /\
          group_exactness (B',C',Z') (g':B'->C',z'))")
    STRIP_ASSUME_TAC THENL
     [ASM_REWRITE_TAC [← GSYM SHORT_EXACT_SEQUENCE_TRIVIAL_GROUPS], ALL_TAC] THEN
    MP_TAC (← ISPECL
     [(← q r"w:Z->A"), (← q r"f:A->B"), (← q r"g:B->C"), (← q r"w':Z->A'"),
      (← q r"f':A'->B'"), (← q r"g':B'->C'"),
      (← q r"(\x. group_id W'):Z->Z"), (← q r"a:A->A'"), (← q r"b:B->B'"),
      (← q r"c:C->C'"),
      (← q r"W:Z group"), (← q r"A:A group"), (← q r"B:B group"),
      (← q r"C:C group"),
      (← q r"W':Z group"), (← q r"A':A' group"), (← q r"B':B' group"),
      (← q r"C':C' group")]
          FOUR_LEMMA_MONO) THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [GROUP_EPIMORPHISM_TO_TRIVIAL_GROUP] THEN
    ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_TRIVIAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_exactness, group_monomorphism,
      trivial_group, group_homomorphism]) THEN
    ASM SET_TAC [])

  let SHORT_FIVE_LEMMA_EPI ← prove
   r"!(f:A->B) (g:B->C) (f':A'->B') (g':B'->C') a b c A B C A' B' C'.
        group_epimorphism(A,A') a /\
        group_homomorphism(B,B') b /\
        group_epimorphism(C,C') c /\
        short_exact_sequence(A,B,C) (f,g) /\
        short_exact_sequence(A',B',C') (f',g') /\
        (!x. x IN group_carrier A ==> f'(a x) = b(f x)) /\
        (!y. y IN group_carrier B ==> g'(b y) = c(g y))
        ==> group_epimorphism(B,B') b"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(?(w:Z->A) (z:C->Z) W Z.
          trivial_group W /\ trivial_group Z /\
          group_exactness (W,A,B) (w,f:A->B) /\
          group_exactness (A,B,C) (f,g) /\
          group_exactness (B,C,Z) (g:B->C,z)) /\
      (?(w':Z->A') (z':C'->Z) W' Z'.
          trivial_group W' /\ trivial_group Z' /\
          group_exactness (W',A',B') (w',f':A'->B') /\
          group_exactness (A',B',C') (f',g') /\
          group_exactness (B',C',Z') (g':B'->C',z'))")
    STRIP_ASSUME_TAC THENL
     [ASM_REWRITE_TAC [← GSYM SHORT_EXACT_SEQUENCE_TRIVIAL_GROUPS], ALL_TAC] THEN
    MP_TAC (← ISPECL
     [(← q r"f:A->B"), (← q r"g:B->C"), (← q r"z:C->Z"), (← q r"f':A'->B'"),
      (← q r"g':B'->C'"), (← q r"z':C'->Z"),
      (← q r"a:A->A'"), (← q r"b:B->B'"), (← q r"c:C->C'"),
      (← q r"(\x. group_id Z'):Z->Z"),
      (← q r"A:A group"), (← q r"B:B group"), (← q r"C:C group"),
      (← q r"Z:Z group"),
      (← q r"A':A' group"), (← q r"B':B' group"), (← q r"C':C' group"),
      (← q r"Z':Z group")]
          FOUR_LEMMA_EPI) THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [GROUP_MONOMORPHISM_TO_TRIVIAL_GROUP] THEN
    ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_TRIVIAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [group_exactness, group_epimorphism,
      trivial_group, group_homomorphism]) THEN
    ASM SET_TAC [])

  let SHORT_FIVE_LEMMA ← prove
   r"!(f:A->B) (g:B->C) (f':A'->B') (g':B'->C') a b c A B C A' B' C'.
        group_isomorphism(A,A') a /\
        group_homomorphism(B,B') b /\
        group_isomorphism(C,C') c /\
        short_exact_sequence(A,B,C) (f,g) /\
        short_exact_sequence(A',B',C') (f',g') /\
        (!x. x IN group_carrier A ==> f'(a x) = b(f x)) /\
        (!y. y IN group_carrier B ==> g'(b y) = c(g y))
        ==> group_isomorphism(B,B') b"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← D.TAUT (← q
     r"(a /\ a') /\ b /\ (c /\ c') /\ d /\ e /\ f /\ g
      ==> (a /\ b /\ c /\ d /\ e /\ f /\ g) /\
          (a' /\ b /\ c' /\ d /\ e /\ f /\ g)"))) THEN
    MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [SHORT_FIVE_LEMMA_MONO, SHORT_FIVE_LEMMA_EPI])

  let EXACT_SEQUENCE_HEXAGON_LEMMA ← prove
   r"!(f:X->C) (g:X->D) (h:A->C) (h':C->A) (i:A->X) (j:B->X) (k:B->D) (k':D->B)
      (a:A->Y) (b:B->Y) (c:W->C) (d:W->D) (l:W->X) (m:X->Y) A B C D W X Y.
          abelian_group X /\
          group_homomorphism(A,Y) a /\
          group_homomorphism(B,Y) b /\
          group_homomorphism(W,C) c /\
          group_homomorphism(W,D) d /\
          group_isomorphisms(A,C) (h,h') /\
          group_isomorphisms(B,D) (k,k') /\
          group_exactness(A,X,D) (i,g) /\
          group_exactness(B,X,C) (j,f) /\
          group_exactness(W,X,Y) (l,m) /\
          (!x. x IN group_carrier W ==> f(l x) = c x) /\
          (!x. x IN group_carrier W ==> g(l x) = d x) /\
          (!x. x IN group_carrier A ==> f(i x) = h x) /\
          (!x. x IN group_carrier A ==> m(i x) = a x) /\
          (!x. x IN group_carrier B ==> g(j x) = k x) /\
          (!x. x IN group_carrier B ==> m(j x) = b x)
          ==> !x. x IN group_carrier W
                  ==> group_inv Y (a(h'(c x))) = b(k'(d x))"
   (← do
    let a5 ← GROUP_RULE (← q r"group_mul G x y = y <=> x = group_id G")
    let a4 ← GROUP_RULE (← q r"group_mul G x y = x <=> y = group_id G")
    let a3 ← D.SET_RULE
     (← q r"y IN s /\ y IN IMAGE l t
      ==> IMAGE l t = {x | x IN s /\ m x = z} ==> m y = z")
    let a2 ← GROUP_RULE
     (← q r"group_inv G x = y <=> group_mul G x y = group_id G")
    let a1 ← D.SET_RULE
     (← q r"IMAGE f s = t /\ P ==> !y. y IN t ==> ?x. x IN s /\ f x = y")
    pure (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(l:W->X) x IN group_carrier X") ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism, group_exactness]) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(c:W->C) x IN group_carrier C /\
      (h':C->A) (c x) IN group_carrier A /\
      (a:A->Y) (h'(c x)) IN group_carrier Y /\
      (i:A->X) (h'(c x)) IN group_carrier X /\
      (d:W->D) x IN group_carrier D /\
      (k':D->B) (d x) IN group_carrier B /\
      (b:B->Y) (k'(d x)) IN group_carrier Y /\
      (j:B->X) (k'(d x)) IN group_carrier X")
    STRIP_ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE
       [group_isomorphisms, group_homomorphism, group_exactness]) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [(← q r"f:X->C"), (← q r"g:X->D"), (← q r"h:A->C"), (← q r"i:A->X"),
      (← q r"j:B->X"), (← q r"k:B->D"),
      (← q r"A:A group"), (← q r"B:B group"), (← q r"C:C group"),
      (← q r"D:D group"), (← q r"X:X group")]
     EXACT_SEQUENCE_SUM_LEMMA) THEN
    ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [group_isomorphism], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o GEN_REWRITE_RULE I [GROUP_ISOMORPHISM_ALT] o
          CONJUNCT1) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(l:W->X) x") o MATCH_MP a1) THEN
    ASM_REWRITE_TAC [PROD_GROUP, LEFT_IMP_EXISTS_THM, FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [(← q r"u:A"), (← q r"v:B")] THEN REWRITE_TAC [IN_CROSS] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(i:A->X) u IN group_carrier X /\
      (j:B->X) v IN group_carrier X /\
      (f:X->C) (i u) IN group_carrier C /\
      (f:X->C) (j v) IN group_carrier C /\
      (g:X->D) (i u) IN group_carrier D /\
      (g:X->D) (j v) IN group_carrier D")
    STRIP_ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE
       [group_isomorphisms, group_homomorphism, group_exactness]) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [a2] THEN
    FIRST_X_ASSUM (fun th =>
      wPart (fun t => do lhand (← lhand t)) (fun t => do rand (← rand t)) th) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_X_ASSUM (fun th =>
      wPart (fun t => do rand (← lhand t)) (fun t => do rand (← rand t)) th) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    UNDISCH_TAC (← q r"group_exactness (W,X,Y) ((l:W->X),(m:X->Y))") THEN
    REWRITE_TAC [group_exactness] THEN DISCH_THEN (MP_TAC o CONJUNCT2) THEN
    REWRITE_TAC [IMP_CONJ] THEN REWRITE_TAC [group_homomorphism] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (ASM_SIMP_TAC [← GSYM (← liftExcept (el 3 (CONJUNCTS th)))])) THEN
    REWRITE_TAC [group_image, group_kernel] THEN
    MATCH_MP_TAC a3 THEN
    ASM_SIMP_TAC [GROUP_MUL, IN_IMAGE] THEN EXISTS_TAC (← q r"x:W") THEN
    ASM_REWRITE_TAC [] THEN FIRST_ASSUM (SUBST1_TAC o SYM) THEN
    BINOP_TAC THEN AP_TERM_TAC THEN
    FIRST_X_ASSUM (fun th =>
     wPart (fun t => do rand (← lhand t)) (fun t => do rand (← rand t)) th) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THENL
     [SUBGOAL_THEN
      (← q r"group_mul C ((f:X->C) ((i:A->X) u)) ((f:X->C) (((j:B->X) v))) = h u")
      MP_TAC THENL
       [ALL_TAC, RULE_ASSUM_TAC (REWRITE_RULE
         [group_isomorphisms, group_homomorphism, group_exactness]) THEN
        ASM SET_TAC []],
      SUBGOAL_THEN
      (← q r"group_mul D ((g:X->D) ((i:A->X) u)) ((g:X->D) (((j:B->X) v))) = k v")
      MP_TAC THENL
       [ALL_TAC, RULE_ASSUM_TAC (REWRITE_RULE
         [group_isomorphisms, group_homomorphism, group_exactness]) THEN
        ASM SET_TAC []]] THEN
    FIRST_X_ASSUM (fun th =>
     wPart (fun t => do rand t) (fun t => do rand (← rand t)) th) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [a4] THEN
    ASM_SIMP_TAC [a5] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
         [group_isomorphisms, group_homomorphism, group_exactness,
          group_image, group_kernel]) THEN
    ASM SET_TAC []))

  -- @@RETURN BEGIN
  return { SHORT_FIVE_LEMMA_MONO, SHORT_FIVE_LEMMA_EPI, SHORT_FIVE_LEMMA,
           EXACT_SEQUENCE_HEXAGON_LEMMA }
  -- @@RETURN END

end HolLibrary.GroupTheory
