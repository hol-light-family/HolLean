    STRIP_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:num") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:num"))) THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"(H:num->A group) p"), (← q r"p:num")] PGROUP_SING) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"(x:num->A) p")) THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [EXP_EQ_0, PRIME_0])

  -- @@RETURN BEGIN
  return { SUBGROUP_GENERATED_UNIONS_PRIME_TORSION_FULL, PGROUP_PRIME_TORSION,
           PGROUP_SUBSET_PRIME_TORSION, ABELIAN_GROUP_TORSION_ISOMORPHISM,
           ABELIAN_GROUP_TORSION_STRUCTURE, TORSION_ABELIAN_GROUP_ISOMORPHISM,
           TORSION_ABELIAN_GROUP_STRUCTURE, FINITE_ABELIAN_GROUP_STRUCTURE,
           FINITE_ABELIAN_GROUP_STRUCTURE_ALT, TORSION_ABELIAN_GROUP_AS_SUM_OF_PGROUPS }
  -- @@RETURN END

