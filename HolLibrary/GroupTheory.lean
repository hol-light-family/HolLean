    REWRITE_TAC [DIVIDES_REFL]))

  let FINITE_ABELIAN_GROUP_STRUCTURE_ALT ← prove
   r"!G:A group.
        abelian_group G /\ FINITE(group_carrier G)
        ==> G isomorphic_group
            product_group {p | prime p /\ p divides CARD(group_carrier G)}
