    let a13 ← ARITH_RULE (← q r"SUC(r - 1) = r <=> ~(r = 0)")
    let a12 ← SET_RULE (← q
     r"~(a IN group_carrier (subgroup_generated G t))
      ==> t SUBSET group_carrier (subgroup_generated G t) ==> ~(a IN t)")
    let a11 ← ARITH_RULE (← q r"r - 1 < r <=> ~(r = 0)")
    let a10 ← SET_RULE (← q r"a IN s ==> {a} UNION s = s")
    let a9 ← SET_RULE (← q r"a INSERT s = {a} UNION s")
    let a8 ← MESON
     [← GROUP_RULE (← q
       r"group_mul G a x = b <=> group_mul G b (group_inv G x) = a")] (← q
     r"group_mul G a x = b
        ==> x IN group_carrier G /\
            a IN group_carrier G /\
            b IN group_carrier G
             ==> a = group_mul G b (group_inv G x)")
    let a7 ← SET_RULE (← q
     r"a' IN u /\ s SUBSET u ==> a' INSERT (s DELETE a) SUBSET u")
    let a6 ← MESON [] (← q r"(!x y z. P x y z) <=> (!y z x. P x y z)")
    let a5 ← ARITH_RULE (← q r"~(0 < n) <=> n = 0")
    let a4 ← TAUT (← q r"~(p /\ q) <=> q ==> ~p")
    let a3 ← MESON [] (← q
     r"!R. (!s. (!m. ~R m s) ==> P s) /\ (!(m:num) s. R m s ==> P s)
        ==> !s. P s")
    let a2 ← MESON [LET_TRANS, LE_REFL] (← q
     r"(!m. m < r ==> !s. FINITE s /\ CARD s <= m ==> Q s) <=>
