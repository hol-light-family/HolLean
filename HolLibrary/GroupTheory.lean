                   GROUP_SETINV_AS_IMAGE, FORALL_IN_IMAGE, UNION_SUBSET] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNION, FUN_IN_IMAGE] THEN
      ASM_SIMP_TAC [GROUP_INV_INV, GROUP_INV] THEN
