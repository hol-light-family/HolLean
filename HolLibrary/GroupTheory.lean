      EXISTS_TAC (← q r"IMAGE (g:A->(A->bool)) t") THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_IMAGE THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL
       [wPart lhand (fun t => do lhand (← rand t)) CARD_IMAGE_LE THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] LET_TRANS) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            LET_TRANS)) THEN
        REWRITE_TAC [← GSYM IMAGE_o] THEN
        wPart lhand (fun t => do lhand (← rand t)) CARD_IMAGE_LE THEN
        ASM_SIMP_TAC [FINITE_DELETE, CARD_DELETE] THEN
        UNDISCH_TAC (← q r"~(n = 0)") THEN ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC a3 THEN CONJ_TAC THENL
       [TRANS_TAC SUBSET_TRANS
         (← q r"IMAGE (g:A->(A->bool)) (group_carrier(subgroup_generated G'' t))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC IMAGE_SUBSET THEN
          MATCH_MP_TAC SUBGROUP_GENERATED_SUBSET_CARRIER_SUBSET THEN
          ASM_REWRITE_TAC [],
          ASM_REWRITE_TAC []] THEN
        MP_TAC (← ISPECL [(← q r"G'':A group"), (← q r"G':(A->bool)group"), (← q r"g:A->(A->bool)"),
                       (← q r"IMAGE (f:(A->bool)->A) h'")]
             SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE) THEN
        ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [group_isomorphisms]) THEN
          ASM_REWRITE_TAC [] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [],
          DISCH_THEN (SUBST1_TAC o SYM)] THEN
        MATCH_MP_TAC a4 THEN
        AP_TERM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [← GSYM IMAGE_o] THEN
        MATCH_MP_TAC a5 THEN
        RULE_ASSUM_TAC (REWRITE_RULE [group_isomorphisms]) THEN
        REWRITE_TAC [o_THM] THEN ASM SET_TAC [],
        SIMP_TAC [SUBGROUP_GENERATED_IDEMPOT_GEN] THEN DISCH_TAC] THEN
        REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
        MP_TAC (← ISPECL [(← q r"G'':A group"), (← q r"G':(A->bool)group"), (← q r"g:A->(A->bool)"),
                       (← q r"t:A->bool")] SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [group_isomorphisms]) THEN ASM_MESON_TAC [],
          DISCH_THEN SUBST1_TAC] THEN
        MP_TAC (← ISPECL [(← q r"G'':A group"), (← q r"G':(A->bool)group"), (← q r"g:A->(A->bool)"),
                       (← q r"IMAGE (f:(A->bool)->A) h'")]
             SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE) THEN
        ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [group_isomorphisms]) THEN
          ASM_REWRITE_TAC [] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [group_homomorphism]) THEN ASM SET_TAC [],
          DISCH_THEN (SUBST1_TAC o SYM)] THEN
        AP_TERM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [← GSYM IMAGE_o] THEN
        MATCH_MP_TAC a6 THEN
        RULE_ASSUM_TAC (REWRITE_RULE [group_isomorphisms]) THEN
        REWRITE_TAC [o_THM] THEN ASM SET_TAC []],
      ALL_TAC] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
    SIMP_TAC [SUBGROUP_GENERATED_IDEMPOT] THEN
    REWRITE_TAC [IMP_IMP] THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
    EXPAND_TAC "h'" THEN REWRITE_TAC [FORALL_SMALL_SUBSET_IMAGE] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?b:A. b IN group_carrier G /\ b IN h /\
            group_carrier(subgroup_generated G {a}) INTER h
            SUBSET group_carrier(subgroup_generated G {b})")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL
       [(← q r"subgroup_generated G {a:A}"),
        (← q r"group_carrier(subgroup_generated G {a:A}) INTER h")]
        SUBGROUP_OF_CYCLIC_GROUP) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [CYCLIC_GROUP_GENERATED] THEN
        GEN_REWRITE_TAC RAND_CONV
         [← GSYM SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED] THEN
        MATCH_MP_TAC SUBGROUP_OF_SUBGROUP_GENERATED THEN
        REWRITE_TAC [INTER_SUBSET] THEN MATCH_MP_TAC SUBGROUP_OF_INTER THEN
        ASM_REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED],
        REWRITE_TAC [cyclic_group, SUBGROUP_GENERATED_SUPERSET] THEN
        REWRITE_TAC [← GSYM SUBGROUP_GENERATED_RESTRICT]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:A") MP_TAC) THEN
      ASM_CASES_TAC (← q r"(b:A) IN h") THENL
       [SUBGOAL_THEN (← q r"(b:A) IN group_carrier G") ASSUME_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        DISCH_THEN (fun th => tactic_of do pure (EXISTS_TAC (← q r"b:A") THEN MP_TAC (← CONJUNCT2 th))) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC a7 THEN
        CONJ_TAC THENL
         [ONCE_REWRITE_TAC [SUBGROUP_GENERATED_RESTRICT] THEN
          ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC SUBSET_CARRIER_SUBGROUP_GENERATED THEN
          REWRITE_TAC [SUBSET_REFL] THEN EXPAND_TAC "c" THEN SET_TAC [],
          MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_MONO, SUBSET_TRANS]],
        DISCH_THEN (fun th =>
          tactic_of do pure (EXISTS_TAC (← q r"group_id G:A") THEN MP_TAC (← CONJUNCT2 th))) THEN
        ASM_SIMP_TAC [IN_SUBGROUP_ID, GROUP_ID] THEN
        MATCH_MP_TAC a8 THEN
        CONJ_TAC THENL
         [ONCE_REWRITE_TAC [SUBGROUP_GENERATED_RESTRICT] THEN
          ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC SUBSET_CARRIER_SUBGROUP_GENERATED THEN
          REWRITE_TAC [SUBSET_REFL] THEN EXPAND_TAC "c" THEN SET_TAC [],
          SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, TRIVIAL_SUBGROUP_OF] THEN
          wPart lhand (fun t => do lhand (← rand t)) TRIVIAL_GROUP_SUBSET THEN
          REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED] THEN
          DISCH_THEN (SUBST1_TAC o SYM) THEN
          REWRITE_TAC [TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP a9) THEN
          TRANS_TAC SUBSET_TRANS
           (← q r"group_carrier(subgroup_generated G h):A->bool") THEN
          REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_MONO] THEN
          ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBSET_REFL]]],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"(b:A) INSERT t") THEN
    ASM_REWRITE_TAC [FINITE_INSERT] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [CARD_CLAUSES] THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"CARD(t:A->bool) < n") THEN ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUBGROUP_GENERATED_MONO THEN ASM SET_TAC [],
      MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL] THEN
    REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(x:A) IN group_carrier G") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"G':(A->bool) group"),
                   (← q r"right_coset G (c:A->bool)"),
                   (← q r"group_carrier (subgroup_generated G t):A->bool")]
      GROUP_HOMOMORPHISM_PREIMAGE_IMAGE_RIGHT) THEN
    ASM_REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:A") o MATCH_MP a10) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"G':(A->bool) group"),
                     (← q r"right_coset G (c:A->bool)"), (← q r"t:A->bool")]
        SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      EXPAND_TAC "h'" THEN
      MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"G':(A->bool) group"),
                     (← q r"right_coset G (c:A->bool)"), (← q r"h:A->bool")]
        SUBGROUP_GENERATED_BY_HOMOMORPHIC_IMAGE) THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
      MATCH_MP_TAC FUN_IN_IMAGE THEN
      MATCH_MP_TAC SUBGROUP_GENERATED_INC_GEN THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [group_setmul, IN_ELIM_THM, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [(← q r"y:A"), (← q r"z:A")] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (ASSUME_TAC o SYM)) THEN
    EXPAND_TAC "G'" THEN ASM_SIMP_TAC [GROUP_KERNEL_RIGHT_COSET] THEN
    STRIP_TAC THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_IDEMPOT, INSERT_SUBSET] THEN
    EXPAND_TAC "x" THEN MATCH_MP_TAC IN_SUBGROUP_MUL THEN
    REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"(y:A) IN group_carrier (subgroup_generated G t)") THEN
      MATCH_MP_TAC a11 THEN
      MATCH_MP_TAC SUBGROUP_GENERATED_MONO THEN SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC a12 THEN
    EXISTS_TAC (← q r"group_carrier (subgroup_generated G {b:A})") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUBGROUP_GENERATED_MONO THEN SET_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP a13) THEN
    ASM_REWRITE_TAC [IN_INTER] THEN
    SUBGOAL_THEN (← q r"z:A = group_mul G (group_inv G y) x") SUBST1_TAC THENL
     [EXPAND_TAC "x" THEN GROUP_TAC THEN
      ASM_MESON_TAC [SUBSET, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET],
      ALL_TAC] THEN
    MATCH_MP_TAC IN_SUBGROUP_MUL THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC IN_SUBGROUP_INV THEN ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"(y:A) IN group_carrier (subgroup_generated G t)") THEN
    MATCH_MP_TAC a14 THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN ASM_REWRITE_TAC []))

  -- @@RETURN BEGIN
  return { FINITELY_GENERATED_FIXED_INDEX_SUBGROUPS,
           FINITELY_GENERATED_FINITE_INDEX_SUBGROUP,
           FINITELY_GENERATED_ABELIAN_SUBGROUP_EXPLICIT }
  -- @@RETURN END

structure FinitelyGeneratedMaximal where
  -- @@FIELDS
  FINITELY_GENERATED_ABELIAN_SUBGROUP : thm
  MAXIMAL_SUBGROUP_EXISTS : thm
  MAXIMAL_NORMAL_SUBGROUP_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupFinitelyGeneratedMaximal [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen2 : SubgroupGen2) (BNormalSubgroups : NormalSubgroups) (BFinitelyGenerated : FinitelyGenerated) (BFinitelyGeneratedSubgroups : FinitelyGeneratedSubgroups) :
    ExceptT String IO FinitelyGeneratedMaximal := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { EMPTY_SUBSET, .. } := D.core2
  let { EXTENSION, FINITE_POWERSET_EQ, FINITE_SUBSET, .. } := D.core3
  let { IN_UNIONS, .. } := D.core5
  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_EXISTS_THM, NOT_IMP, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_IMP_FORALL_THM, SUBSET_REFL, SUBSET_TRANS, WF,
        WF_FINITE, ZL_SUBSETS_UNIONS_NONEMPTY, .. } := D.core7
  let { trivial_group, .. } := BBasics
  let { SUBGROUP_OF_IMP_SUBSET, SUBGROUP_OF_UNIONS, TRIVIAL_SUBGROUP_OF, subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED_MINIMAL, .. } := BSubgroupGenerated
  let { SUBGROUP_GENERATED_IDEMPOT, .. } := BSubgroupGen2
  let { NORMAL_SUBGROUP_OF_IMP_SUBSET, NORMAL_SUBGROUP_OF_UNIONS,
        TRIVIAL_NORMAL_SUBGROUP_OF, normal_subgroup_of, .. } := BNormalSubgroups
  let { FINITELY_GENERATED_GROUP, finitely_generated_group, .. } := BFinitelyGenerated
  let { FINITELY_GENERATED_ABELIAN_SUBGROUP_EXPLICIT, .. } := BFinitelyGeneratedSubgroups
  -- @@SCOPE END

  let FINITELY_GENERATED_ABELIAN_SUBGROUP ← prove
   r"!G h:A->bool.
        finitely_generated_group G /\ abelian_group G /\ h subgroup_of G
        ==> finitely_generated_group(subgroup_generated G h)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [FINITELY_GENERATED_GROUP]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"s:A->bool"), (← q r"h:A->bool")]
          FINITELY_GENERATED_ABELIAN_SUBGROUP_EXPLICIT) THEN
    ASM_REWRITE_TAC [finitely_generated_group] THEN
    MESON_TAC [SUBGROUP_GENERATED_IDEMPOT, SUBSET_REFL])

  let MAXIMAL_SUBGROUP_EXISTS ← prove
   r"!G:A group.
      finitely_generated_group G /\ ~trivial_group G
      ==> ?h. h subgroup_of G /\ ~(h = group_carrier G) /\
              !h'. h' subgroup_of G /\ h PSUBSET h'
                   ==> h' = group_carrier G"
   (← do
    let a3 ← SET_RULE (← q
     r"s SUBSET t /\ ~(s = t) ==> ~(t SUBSET s)")
    let a2 ← SET_RULE (← q
     r"~(s SUBSET t) /\ s SUBSET u
      ==> ?a. a IN s /\ a IN u /\ ~(a IN t)")
    let a1 ← TAUT (← q
     r"p ==> ~(q /\ ~r /\ s) <=> p /\ q /\ s ==> r")
    pure (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [FINITELY_GENERATED_GROUP]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"WF(\t t':A->bool. t' PSUBSET t /\ t SUBSET s)") MP_TAC THENL
     [MATCH_MP_TAC WF_FINITE THEN REWRITE_TAC [] THEN
      REPEAT (CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN GEN_TAC THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{t:A->bool | t SUBSET s}") THEN
      ASM_REWRITE_TAC [FINITE_POWERSET_EQ] THEN SET_TAC [],
      REWRITE_TAC [WF] THEN DISCH_THEN (MP_TAC o SPEC
       (← q r"\t:A->bool. t SUBSET s /\ ?h.
           h subgroup_of G /\ ~(h = group_carrier G) /\ t SUBSET h"))] THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [EXISTS_TAC (← q r"{}:A->bool") THEN REWRITE_TAC [EMPTY_SUBSET] THEN
      EXISTS_TAC (← q r"{group_id G:A}") THEN
      REWRITE_TAC [TRIVIAL_SUBGROUP_OF] THEN ASM_MESON_TAC [trivial_group],
      REWRITE_TAC [NOT_EXISTS_THM, RIGHT_IMP_FORALL_THM,
                  RIGHT_AND_EXISTS_THM, LEFT_AND_EXISTS_THM, a1] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [(← q r"t:A->bool"), (← q r"n:A->bool")] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (LABEL_TAC "*") THEN
    MP_TAC (← ISPEC
     (← q r"\h:A->bool. n SUBSET h /\
                  h subgroup_of G /\
                  ~(h = group_carrier G)")
     ZL_SUBSETS_UNIONS_NONEMPTY) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [SUBSET_REFL], ALL_TAC],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h:A->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"h':A->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"h':A->bool")) THEN ASM SET_TAC []] THEN
    X_GEN_TAC (← q r"c:(A->bool)->bool") THEN REWRITE_TAC [MEMBER_NOT_EMPTY] THEN
    STRIP_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUBGROUP_OF_UNIONS THEN ASM_MESON_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?a:A. a IN s /\ a IN group_carrier G /\ ~(a IN t)")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC a2 THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"group_carrier(subgroup_generated G (s:A->bool)) SUBSET n")
      MP_TAC THENL
       [MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN
        ASM_MESON_TAC [subgroup_of, SUBSET_TRANS],
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC a3 THEN
        ASM_MESON_TAC [SUBGROUP_OF_IMP_SUBSET]],
      DISCH_THEN (MP_TAC o SPEC (← q r"a:A") o GEN_REWRITE_RULE I [EXTENSION])] THEN
    ASM_REWRITE_TAC [IN_UNIONS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:A->bool") STRIP_ASSUME_TAC) THEN
    REMOVE_THEN "*" (MP_TAC o SPECL [(← q r"(a:A) INSERT t"), (← q r"h:A->bool")]) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN ASM SET_TAC []))

  let MAXIMAL_NORMAL_SUBGROUP_EXISTS ← prove
   r"!G:A group.
      finitely_generated_group G /\ ~trivial_group G
      ==> ?h. h normal_subgroup_of G /\ ~(h = group_carrier G) /\
              !h'. h' normal_subgroup_of G /\ h PSUBSET h'
                   ==> h' = group_carrier G"
   (← do
    let a3 ← SET_RULE (← q
     r"s SUBSET t /\ ~(s = t) ==> ~(t SUBSET s)")
    let a2 ← SET_RULE (← q
     r"~(s SUBSET t) /\ s SUBSET u
      ==> ?a. a IN s /\ a IN u /\ ~(a IN t)")
    let a1 ← TAUT (← q
     r"p ==> ~(q /\ ~r /\ s) <=> p /\ q /\ s ==> r")
    pure (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [FINITELY_GENERATED_GROUP]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"WF(\t t':A->bool. t' PSUBSET t /\ t SUBSET s)") MP_TAC THENL
     [MATCH_MP_TAC WF_FINITE THEN REWRITE_TAC [] THEN
      REPEAT (CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN GEN_TAC THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{t:A->bool | t SUBSET s}") THEN
      ASM_REWRITE_TAC [FINITE_POWERSET_EQ] THEN SET_TAC [],
      REWRITE_TAC [WF] THEN DISCH_THEN (MP_TAC o SPEC
       (← q r"\t:A->bool. t SUBSET s /\ ?h.
           h normal_subgroup_of G /\ ~(h = group_carrier G) /\ t SUBSET h"))] THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [EXISTS_TAC (← q r"{}:A->bool") THEN REWRITE_TAC [EMPTY_SUBSET] THEN
      EXISTS_TAC (← q r"{group_id G:A}") THEN
      REWRITE_TAC [TRIVIAL_NORMAL_SUBGROUP_OF] THEN ASM_MESON_TAC [trivial_group],
      REWRITE_TAC [NOT_EXISTS_THM, RIGHT_IMP_FORALL_THM,
                  RIGHT_AND_EXISTS_THM, LEFT_AND_EXISTS_THM, a1] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [(← q r"t:A->bool"), (← q r"n:A->bool")] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (LABEL_TAC "*") THEN
    MP_TAC (← ISPEC
     (← q r"\h:A->bool. n SUBSET h /\
                  h normal_subgroup_of G /\
                  ~(h = group_carrier G)")
     ZL_SUBSETS_UNIONS_NONEMPTY) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [SUBSET_REFL], ALL_TAC],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h:A->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"h':A->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"h':A->bool")) THEN ASM SET_TAC []] THEN
    X_GEN_TAC (← q r"c:(A->bool)->bool") THEN REWRITE_TAC [MEMBER_NOT_EMPTY] THEN
    STRIP_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
     [MATCH_MP_TAC NORMAL_SUBGROUP_OF_UNIONS THEN ASM_MESON_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?a:A. a IN s /\ a IN group_carrier G /\ ~(a IN t)")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC a2 THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"group_carrier(subgroup_generated G (s:A->bool)) SUBSET n")
      MP_TAC THENL
       [MATCH_MP_TAC SUBGROUP_GENERATED_MINIMAL THEN
        ASM_MESON_TAC [normal_subgroup_of, SUBSET_TRANS],
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC a3 THEN
        ASM_MESON_TAC [NORMAL_SUBGROUP_OF_IMP_SUBSET]],
      DISCH_THEN (MP_TAC o SPEC (← q r"a:A") o GEN_REWRITE_RULE I [EXTENSION])] THEN
    ASM_REWRITE_TAC [IN_UNIONS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:A->bool") STRIP_ASSUME_TAC) THEN
    REMOVE_THEN "*" (MP_TAC o SPECL [(← q r"(a:A) INSERT t"), (← q r"h:A->bool")]) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN ASM SET_TAC []))

  -- @@RETURN BEGIN
  return { FINITELY_GENERATED_ABELIAN_SUBGROUP, MAXIMAL_SUBGROUP_EXISTS,
           MAXIMAL_NORMAL_SUBGROUP_EXISTS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The additive group of integers.                                           -/
/- ------------------------------------------------------------------------- -/

structure IntegerGroup where
  -- @@FIELDS
  integer_group : thm
  INTEGER_GROUP : thm
  ABELIAN_INTEGER_GROUP : thm
  INFINITE_INTEGER_GROUP : thm
  GROUP_POW_INTEGER_GROUP : thm
  GROUP_ZPOW_INTEGER_GROUP : thm
  GROUP_ELEMENT_ORDER_INTEGER_GROUP : thm
  GROUP_ENDOMORPHISM_INTEGER_GROUP_MUL : thm
  GROUP_ENDOMORPHISM_INTEGER_GROUP_EXPLICIT : thm
  GROUP_ENDOMORPHISM_INTEGER_GROUP_EQ : thm
  GROUP_ENDOMORPHISM_INTEGER_GROUP_EQ_ALT : thm
  GROUP_HOMOMORPHISM_GROUP_ZPOW : thm
  GROUP_EPIMORPHISM_GROUP_ZPOW : thm
  GROUP_ISOMORPHISM_GROUP_ZPOW : thm
  ISOMORPHIC_GROUP_INFINITE_CYCLIC_INTEGER : thm
  ISOMORPHIC_INFINITE_CYCLIC_GROUPS : thm
  deriving Inhabited

@[nospecialize]
def setupIntegerGroup [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BSubgroupGen1 : SubgroupGen1) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BGroupElementOrder : GroupElementOrder) (BCyclicGroups1 : CyclicGroups1) (BCyclicGroups2 : CyclicGroups2) :
    ExceptT String IO IntegerGroup := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, INT_ARITH, INT_ARITH_TAC, MESON, MESON_TAC, SET_TAC,
        new_definition, .. } := D
  let { AND_FORALL_THM, .. } := D.core1
  let { CONTRAPOS_THM, ETA_AX, .. } := D.core2
  let { FORALL_INT_CASES, FORALL_IN_IMAGE, FORALL_UNWIND_THM2, FUN_EQ_THM, .. } := D.core3
  let { INT_ADD_SYM, INT_ENTIRE, INT_IMAGE, INT_MUL_RID, INT_MUL_RZERO, .. } := D.core4
  let { INT_OF_NUM_EQ, INT_OF_NUM_SUC, IN_UNIV, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, .. } := D.core6
  let { SIMPLE_IMAGE, SUBSET, SUBSET_UNIV, SWAP_FORALL_THM, int_INFINITE, .. } := D.core7
  let { group_carrier, group_id, group_inv, group_mul, group_tybij, .. } := BBasics
  let { group_pow, .. } := BDerived
  let { GROUP_NPOW, GROUP_ZPOW, GROUP_ZPOW_0, GROUP_ZPOW_ADD, GROUP_ZPOW_NEG, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED, .. } := BSubgroupGen1
  let { group_endomorphism, group_epimorphism, group_homomorphism, group_monomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_INTO_SUBGROUP, .. } := BHomomorphisms1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRANS, .. } := BIso1
  let { GROUP_ELEMENT_ORDER_EQ_0, GROUP_ELEMENT_ORDER_EQ_1, .. } := BGroupElementOrder
  let { CARRIER_SUBGROUP_GENERATED_BY_SING, cyclic_group, .. } := BCyclicGroups1
  let { INFINITE_CYCLIC_SUBGROUP_ALT, .. } := BCyclicGroups2
  -- @@SCOPE END

  let integer_group ← new_definition
   r"integer_group = group((:int),&0,(--),(+))"

  let INTEGER_GROUP ← prove
   r"group_carrier integer_group = (:int) /\
   group_id integer_group = &0 /\
   group_inv integer_group = (--) /\
   group_mul integer_group = (+)"
   (MP_TAC (← EQ_IMP_RULE
     (← ISPEC (← liftExcept (do rand (← rand (strip_forall (concl integer_group)).2)))
       (← CONJUNCT2 group_tybij))).1 THEN
    REWRITE_TAC [← GSYM integer_group] THEN REWRITE_TAC [IN_UNIV] THEN
    ANTS_TAC THENL [INT_ARITH_TAC, ALL_TAC] THEN
    SIMP_TAC [group_carrier, group_id, group_inv, group_mul])

  let ABELIAN_INTEGER_GROUP ← prove
   r"abelian_group integer_group"
   (REWRITE_TAC [abelian_group, INTEGER_GROUP, INT_ADD_SYM])

  let INFINITE_INTEGER_GROUP ← prove
   r"INFINITE(group_carrier integer_group)"
   (REWRITE_TAC [INTEGER_GROUP, int_INFINITE])

  let GROUP_POW_INTEGER_GROUP ← prove
   r"!x n. group_pow integer_group x n = &n * x"
   (GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [group_pow, INTEGER_GROUP, ← GSYM INT_OF_NUM_SUC] THEN
    INT_ARITH_TAC)

  let GROUP_ZPOW_INTEGER_GROUP ← prove
   r"!x n. group_zpow integer_group x n = n * x"
   (GEN_TAC THEN
    SIMP_TAC [FORALL_INT_CASES, GROUP_ZPOW_NEG, GROUP_NPOW,
             INTEGER_GROUP, GROUP_POW_INTEGER_GROUP, IN_UNIV] THEN
    INT_ARITH_TAC)

  let GROUP_ELEMENT_ORDER_INTEGER_GROUP ← prove
   r"!n. group_element_order integer_group n = if n = &0 then 1 else 0"
   (GEN_TAC THEN COND_CASES_TAC THEN
    SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_0, GROUP_ELEMENT_ORDER_EQ_1,
             INTEGER_GROUP, GROUP_POW_INTEGER_GROUP, IN_UNIV] THEN
    ASM_REWRITE_TAC [CONTRAPOS_THM, INT_ENTIRE] THEN
    REWRITE_TAC [INT_OF_NUM_EQ])

  let GROUP_ENDOMORPHISM_INTEGER_GROUP_MUL ← prove
   r"!c. group_endomorphism integer_group (\x. c * x)"
   (REWRITE_TAC [group_endomorphism, group_homomorphism, INTEGER_GROUP] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV] THEN INT_ARITH_TAC)

  let GROUP_ENDOMORPHISM_INTEGER_GROUP_EXPLICIT ← prove
   r"!f. group_endomorphism integer_group f ==> f = \x. f(&1) * x"
   (← do
    let a1 ← INT_ARITH (← q
     r"--x:int = y * --z <=> x = y * z")
    pure (REWRITE_TAC [group_endomorphism, group_homomorphism, INTEGER_GROUP] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC I [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:int") THEN
    REWRITE_TAC [] THEN MP_TAC (← SPEC (← q r"x:int") INT_IMAGE) THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
    SPEC_TAC ((← q r"x:int"), (← q r"x:int")) THEN GEN_REWRITE_TAC I [SWAP_FORALL_THM] THEN
    ASM_REWRITE_TAC [FORALL_UNWIND_THM2, a1] THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [INT_MUL_RZERO] THEN
    ASM_REWRITE_TAC [← GSYM INT_OF_NUM_SUC] THEN INT_ARITH_TAC))

  let (GROUP_ENDOMORPHISM_INTEGER_GROUP_EQ,
       GROUP_ENDOMORPHISM_INTEGER_GROUP_EQ_ALT) ← CONJ_PAIR (← prove
   r"(!f. group_endomorphism integer_group f <=> ?c. f = \x. c * x) /\
   (!f. group_endomorphism integer_group f <=> ?!c. f = \x. c * x)"
   (← do
    let a1 ← MESON []
     (← q r"(!c. P(m c)) /\ (!f. P f ==> ?c. f = m c) /\
      (!c d. m c = m d ==> c = d)
      ==> (P f <=> ?c. f = m c) /\ (P f <=> ?!c. f = m c)")
    pure (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC a1 THEN
    REWRITE_TAC [GROUP_ENDOMORPHISM_INTEGER_GROUP_MUL] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:int->int") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(f:int->int) (&1)") THEN
     MATCH_MP_TAC GROUP_ENDOMORPHISM_INTEGER_GROUP_EXPLICIT THEN
     ASM_REWRITE_TAC [],
     REWRITE_TAC [FUN_EQ_THM] THEN MESON_TAC [INT_MUL_RID]])))

  let GROUP_HOMOMORPHISM_GROUP_ZPOW ← prove
   r"!G x:A. x IN group_carrier G
           ==> group_homomorphism(integer_group,G) (group_zpow G x)"
   (REWRITE_TAC [group_homomorphism, INTEGER_GROUP, SUBSET, FORALL_IN_IMAGE] THEN
    SIMP_TAC [IN_UNIV, GROUP_ZPOW_ADD, GROUP_ZPOW_NEG,
             GROUP_ZPOW_0, GROUP_ZPOW])

  let GROUP_EPIMORPHISM_GROUP_ZPOW ← prove
   r"!G x:A. x IN group_carrier G
           ==> group_epimorphism (integer_group,subgroup_generated G {x})
                                 (group_zpow G x)"
   (SIMP_TAC [group_epimorphism, INTEGER_GROUP, SIMPLE_IMAGE, ETA_AX,
             CARRIER_SUBGROUP_GENERATED_BY_SING] THEN
    REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM SUBGROUP_GENERATED_BY_SUBGROUP_GENERATED] THEN
    MATCH_MP_TAC GROUP_HOMOMORPHISM_INTO_SUBGROUP THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_GROUP_ZPOW] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_BY_SING, INTEGER_GROUP] THEN
    SET_TAC [])

  let GROUP_ISOMORPHISM_GROUP_ZPOW ← prove
   r"!G x:A. INFINITE(group_carrier(subgroup_generated G {x})) /\
           x IN group_carrier G
           ==> group_isomorphism (integer_group,subgroup_generated G {x})
                                 (group_zpow G x)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_EPIMORPHISM_GROUP_ZPOW) THEN
    SIMP_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM,
             group_monomorphism, group_epimorphism] THEN
    DISCH_THEN (K ALL_TAC) THEN REWRITE_TAC [INTEGER_GROUP, IN_UNIV] THEN
    ASM_MESON_TAC [INFINITE_CYCLIC_SUBGROUP_ALT])

  let ISOMORPHIC_GROUP_INFINITE_CYCLIC_INTEGER ← prove
   r"!G:A group.
        cyclic_group G /\ INFINITE(group_carrier G)
        ==> G isomorphic_group integer_group"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [cyclic_group]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:A") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"x:A")] GROUP_ISOMORPHISM_GROUP_ZPOW) THEN
    ASM_REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC])

  let ISOMORPHIC_INFINITE_CYCLIC_GROUPS ← prove
   r"!(G:A group) (H:B group).
        cyclic_group G /\ INFINITE(group_carrier G) /\
        cyclic_group H /\ INFINITE(group_carrier H)
        ==> G isomorphic_group H"
   (REPEAT STRIP_TAC THEN TRANS_TAC ISOMORPHIC_GROUP_TRANS (← q r"integer_group") THEN
    GEN_REWRITE_TAC RAND_CONV [ISOMORPHIC_GROUP_SYM] THEN
    ASM_SIMP_TAC [ISOMORPHIC_GROUP_INFINITE_CYCLIC_INTEGER])

  -- @@RETURN BEGIN
  return { integer_group, INTEGER_GROUP, ABELIAN_INTEGER_GROUP, INFINITE_INTEGER_GROUP,
           GROUP_POW_INTEGER_GROUP, GROUP_ZPOW_INTEGER_GROUP,
           GROUP_ELEMENT_ORDER_INTEGER_GROUP, GROUP_ENDOMORPHISM_INTEGER_GROUP_MUL,
           GROUP_ENDOMORPHISM_INTEGER_GROUP_EXPLICIT,
           GROUP_ENDOMORPHISM_INTEGER_GROUP_EQ, GROUP_ENDOMORPHISM_INTEGER_GROUP_EQ_ALT,
           GROUP_HOMOMORPHISM_GROUP_ZPOW, GROUP_EPIMORPHISM_GROUP_ZPOW,
           GROUP_ISOMORPHISM_GROUP_ZPOW, ISOMORPHIC_GROUP_INFINITE_CYCLIC_INTEGER,
           ISOMORPHIC_INFINITE_CYCLIC_GROUPS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Additive group of integers modulo n (n = 0 gives just the integers).      -/
/- ------------------------------------------------------------------------- -/

structure IntegerModGroup where
  -- @@FIELDS
  integer_mod_group : thm
  INTEGER_MOD_GROUP : thm
  INTEGER_MOD_GROUP_TRIVIAL : thm
  GROUP_CARRIER_INTEGER_MOD_GROUP : thm
  GROUP_POW_INTEGER_MOD_GROUP : thm
  GROUP_ZPOW_INTEGER_MOD_GROUP : thm
  ABELIAN_INTEGER_MOD_GROUP : thm
  INTEGER_MOD_GROUP_0 : thm
  INTEGER_MOD_GROUP_1R : thm
  INTEGER_MOD_GROUP_1 : thm
  GROUP_HOMOMORPHISM_PROD_INTEGER_MOD_GROUP : thm
  TRIVIAL_INTEGER_MOD_GROUP : thm
  NON_TRIVIAL_INTEGER_GROUP : thm
  GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP_1 : thm
  GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP_1R : thm
  GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP : thm
  INTEGER_MOD_SUBGROUP_GENERATED_BY_1R : thm
  INTEGER_MOD_SUBGROUP_GENERATED_BY_1 : thm
  CYCLIC_GROUP_INTEGER_MOD_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupIntegerModGroup [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) (BHomomorphisms : Homomorphisms) (BGroupElementOrder : GroupElementOrder) (BGroupElementOrder2 : GroupElementOrder2) (BCyclicGroups1 : CyclicGroups1) (BIntegerGroup : IntegerGroup) :
    ExceptT String IO IntegerModGroup := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, INDUCT_TAC, INTEGER_RULE, INT_ARITH_TAC, INT_REDUCE_CONV,
        INT_REM_DOWN_CONV, MESON_TAC, NUMBER_RULE, NUM_REDUCE_CONV, SET_RULE,
        new_definition, .. } := D
  let { AND_FORALL_THM, ARITH, .. } := D.core1
  let { DIVIDES_ANTISYM, DIVIDES_MOD, DIV_REFL, EQ_TRANS, .. } := D.core2
  let { FORALL_AND_THM, FORALL_INT_CASES, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core3
  let { IMAGE_ID, INT_ABS_NUM, INT_ADD_ASSOC, INT_ADD_LID, INT_ADD_LINV,
        INT_ADD_RDISTRIB, INT_ADD_REM, INT_ADD_RID, INT_ADD_RINV, INT_ADD_SYM,
        INT_DIVISION, INT_LE_REFL, INT_LT_REM, INT_LT_REM_EQ, INT_MUL_LID,
        INT_MUL_LNEG, INT_MUL_LZERO, INT_MUL_RID, INT_MUL_RNEG, .. } := D.core4
  let { INT_NEG_NEG, INT_OF_NUM_EQ, INT_OF_NUM_LE, INT_OF_NUM_LT, INT_OF_NUM_MUL,
        INT_OF_NUM_REM, INT_OF_NUM_SUC, INT_REM_0, INT_REM_EQ, INT_REM_EQ_SELF,
        INT_REM_LT, INT_REM_MOD_SELF, INT_REM_POS_EQ, INT_REM_REM, INT_REM_REM_MUL,
        INT_REM_ZERO, IN_CROSS, IN_ELIM_THM, IN_GSPEC, IN_SING, IN_UNIV, .. } := D.core5
  let { LE_1, LT_REFL, MULT_CLAUSES, PAIR_EQ, .. } := D.core6
  let { SELECT_UNIQUE, SUBSET, .. } := D.core7
  let { GROUPS_EQ, GROUP_ID, TRIVIAL_GROUP_ALT, TRIVIAL_GROUP_SUBSET, group_carrier,
        group_id, group_inv, group_mul, group_tybij, .. } := BBasics
  let { group_pow, .. } := BDerived
  let { GROUP_ZPOW_POW, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { TRIVIAL_GROUP_GENERATED_BY_ANYTHING, .. } := BSubgroupGen1
  let { PROD_GROUP, .. } := BProdGroup
  let { GROUP_HOMOMORPHISM, .. } := BHomomorphisms
  let { group_element_order, .. } := BGroupElementOrder
  let { GROUP_ELEMENT_ORDER_POW_GEN, .. } := BGroupElementOrder2
  let { CARRIER_SUBGROUP_GENERATED_BY_SING, CYCLIC_GROUP_GENERATED, .. } := BCyclicGroups1
  let { GROUP_POW_INTEGER_GROUP, INTEGER_GROUP, .. } := BIntegerGroup
  -- @@SCOPE END

  let integer_mod_group ← new_definition
   r"integer_mod_group n =
     if n = 0 then integer_group else
     group({m | &0 <= m /\ m < &n},
           &0,
           (\a. --a rem &n),
           (\a b. (a + b) rem &n))"

  let INTEGER_MOD_GROUP ← prove
   r"(group_carrier(integer_mod_group 0) = (:int)) /\
   (!n. 0 < n
        ==> group_carrier(integer_mod_group n) = {m | &0 <= m /\ m < &n}) /\
   (!n. group_id(integer_mod_group n) = &0) /\
   (!n. group_inv(integer_mod_group n) = \a. --a rem &n) /\
   (!n. group_mul(integer_mod_group n) = \a b. (a + b) rem &n)"
   (REWRITE_TAC [integer_mod_group, INTEGER_GROUP] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"n:num") THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [INTEGER_GROUP, LT_REFL, INT_REM_0] THENL
     [REWRITE_TAC [FUN_EQ_THM], ASM_SIMP_TAC [LE_1]] THEN
    REWRITE_TAC [group_carrier, group_id, group_inv, group_mul] THEN
    REWRITE_TAC [← GSYM PAIR_EQ, ← GSYM (← CONJUNCT2 group_tybij)] THEN
    MP_TAC (← GEN (← q r"m:int") (← SPECL [(← q r"m:int"), (← q r"&n:int")] INT_DIVISION)) THEN
    ASM_REWRITE_TAC [INT_OF_NUM_EQ, INT_ABS_NUM, FORALL_AND_THM] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, PAIR_EQ, INT_LE_REFL] THEN
    ASM_SIMP_TAC [INT_OF_NUM_LT, LE_1, INT_ADD_LID, INT_ADD_RID] THEN
    SIMP_TAC [INT_REM_LT] THEN
    ONCE_REWRITE_TAC [← GSYM INT_ADD_REM] THEN
    REWRITE_TAC [INT_REM_REM] THEN REWRITE_TAC [INT_ADD_REM, INT_ADD_ASSOC] THEN
    REWRITE_TAC [INT_ADD_LINV, INT_ADD_RINV, INT_REM_ZERO])

  let INTEGER_MOD_GROUP_TRIVIAL ← prove
   r"integer_mod_group 0 = integer_group"
   (REWRITE_TAC [integer_mod_group])

  let GROUP_CARRIER_INTEGER_MOD_GROUP ← prove
   r"!n. group_carrier (integer_mod_group n) = IMAGE (\x. x rem &n) (:int)"
   (← do
    let a1 ← SET_RULE (← q
     r"(!x. x IN s ==> f x = x) /\ (!x. f x IN s)
      ==> s = IMAGE f UNIV")
    pure (GEN_TAC THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_SIMP_TAC [INTEGER_MOD_GROUP, INT_REM_0, IMAGE_ID, LE_1] THEN
    MATCH_MP_TAC a1 THEN
    SIMP_TAC [IN_ELIM_THM, INT_REM_LT] THEN
    REWRITE_TAC [INT_REM_POS_EQ, INT_LT_REM_EQ] THEN
    ASM_SIMP_TAC [INT_OF_NUM_EQ, INT_OF_NUM_LT, LE_1]))

  let GROUP_POW_INTEGER_MOD_GROUP ← prove
   r"!n x m. group_pow (integer_mod_group n) x m = (&m * x) rem &n"
   (GEN_TAC THEN GEN_TAC THEN ASM_CASES_TAC (← q r"n = 0") THENL
     [ASM_REWRITE_TAC [INT_REM_0, integer_mod_group, GROUP_POW_INTEGER_GROUP],
      INDUCT_TAC THEN
      ASM_REWRITE_TAC [group_pow, INTEGER_MOD_GROUP, INT_MUL_LZERO, INT_REM_ZERO,
                      ← GSYM INT_OF_NUM_SUC, INT_ADD_RDISTRIB, INT_MUL_LID] THEN
      ONCE_REWRITE_TAC [← GSYM INT_ADD_REM] THEN
      REWRITE_TAC [INT_REM_REM] THEN REWRITE_TAC [INT_ADD_SYM]])

  let GROUP_ZPOW_INTEGER_MOD_GROUP ← prove
   r"!n x m. group_zpow (integer_mod_group n) x m = (m * x) rem &n"
   (← do
    let a1 ← INTEGER_RULE (← q
     r"(--x:int == y) (mod n) <=> (x == --y) (mod n)")
    pure (REWRITE_TAC [FORALL_INT_CASES] THEN
    REWRITE_TAC [GROUP_ZPOW_POW, GROUP_POW_INTEGER_MOD_GROUP] THEN
    REWRITE_TAC [INTEGER_MOD_GROUP, INT_REM_EQ, a1] THEN
    REWRITE_TAC [INT_MUL_LNEG, INT_MUL_RNEG, INT_NEG_NEG] THEN
    REWRITE_TAC [INT_REM_MOD_SELF]))

  let ABELIAN_INTEGER_MOD_GROUP ← prove
   r"!n. abelian_group(integer_mod_group n)"
   (REWRITE_TAC [abelian_group, INTEGER_MOD_GROUP, INT_ADD_SYM])

  let INTEGER_MOD_GROUP_0 ← prove
   r"!n. &0 IN group_carrier(integer_mod_group n)"
   (MESON_TAC [INTEGER_MOD_GROUP, GROUP_ID])

  let INTEGER_MOD_GROUP_1R ← prove
   r"!n x. (x rem &n) IN group_carrier(integer_mod_group n)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_SIMP_TAC [INTEGER_MOD_GROUP, LE_1, IN_UNIV, IN_ELIM_THM] THEN
    REWRITE_TAC [INT_REM_POS_EQ, INT_LT_REM_EQ] THEN
    ASM_SIMP_TAC [INT_OF_NUM_EQ, INT_OF_NUM_LT, LE_1])

  let INTEGER_MOD_GROUP_1 ← prove
   r"!n. &1 IN group_carrier(integer_mod_group n) <=> ~(n = 1)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"n = 0") THENL
     [ASM_REWRITE_TAC [integer_mod_group, INTEGER_GROUP, IN_UNIV] THEN
      CONV_TAC NUM_REDUCE_CONV,
      ASM_SIMP_TAC [LE_1, INTEGER_MOD_GROUP, IN_ELIM_THM] THEN
      REWRITE_TAC [INT_OF_NUM_LE, INT_OF_NUM_LT] THEN ASM_ARITH_TAC])

  let GROUP_HOMOMORPHISM_PROD_INTEGER_MOD_GROUP ← prove
   r"!m n.
        group_homomorphism
         (integer_mod_group (m * n),
          prod_group (integer_mod_group m) (integer_mod_group n))
         (\a. (a rem &m),(a rem &n))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [GROUP_HOMOMORPHISM] THEN
    SIMP_TAC [PROD_GROUP, SUBSET, FORALL_IN_IMAGE, IN_CROSS, PAIR_EQ] THEN
    SIMP_TAC [INTEGER_MOD_GROUP, ← GSYM INT_OF_NUM_MUL, INT_REM_REM_MUL] THEN
    CONV_TAC INT_REM_DOWN_CONV THEN
    REWRITE_TAC [INTEGER_MOD_GROUP_1R])

  let TRIVIAL_INTEGER_MOD_GROUP ← prove
   r"!n. trivial_group(integer_mod_group n) <=> n = 1"
   (← do
    let a1 ← SET_RULE (← q
     r"!a b. (a IN s /\ b IN s /\ ~(a = b)) ==> ~(?c. s SUBSET {c})")
    pure (GEN_TAC THEN ASM_CASES_TAC (← q r"n = 1") THEN ASM_REWRITE_TAC [] THENL
     [SIMP_TAC [TRIVIAL_GROUP_SUBSET, INTEGER_MOD_GROUP, ARITH] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_SING] THEN INT_ARITH_TAC,
      REWRITE_TAC [TRIVIAL_GROUP_ALT] THEN MATCH_MP_TAC a1 THEN
      MAP_EVERY EXISTS_TAC [(← q r"&0:int"), (← q r"&1:int")] THEN
      ASM_REWRITE_TAC [INTEGER_MOD_GROUP_0, INTEGER_MOD_GROUP_1] THEN
      CONV_TAC INT_REDUCE_CONV]))

  let NON_TRIVIAL_INTEGER_GROUP ← prove
   r"~(trivial_group integer_group)"
   (MP_TAC (← SPEC (← q r"0") TRIVIAL_INTEGER_MOD_GROUP) THEN
    CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [integer_mod_group])

  let GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP_1 ← prove
   r"!n. group_element_order (integer_mod_group n) (&1) = n"
   (SIMP_TAC [group_element_order, INTEGER_MOD_GROUP] THEN
    SIMP_TAC [GROUP_POW_INTEGER_MOD_GROUP] THEN
    REWRITE_TAC [INT_OF_NUM_MUL, MULT_CLAUSES, INT_OF_NUM_REM] THEN
    REWRITE_TAC [INT_OF_NUM_EQ, ← GSYM DIVIDES_MOD] THEN
    GEN_TAC THEN MATCH_MP_TAC SELECT_UNIQUE THEN
    GEN_TAC THEN EQ_TAC THEN SIMP_TAC [] THEN
    MESON_TAC [DIVIDES_ANTISYM])

  let GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP_1R ← prove
   r"!n. group_element_order (integer_mod_group n) (&1 rem &n) = n"
   (SIMP_TAC [group_element_order, INTEGER_MOD_GROUP] THEN
    SIMP_TAC [GROUP_POW_INTEGER_MOD_GROUP] THEN
    CONV_TAC INT_REM_DOWN_CONV THEN
    REWRITE_TAC [INT_OF_NUM_MUL, MULT_CLAUSES, INT_OF_NUM_REM] THEN
    REWRITE_TAC [INT_OF_NUM_EQ, ← GSYM DIVIDES_MOD] THEN
    GEN_TAC THEN MATCH_MP_TAC SELECT_UNIQUE THEN
    GEN_TAC THEN EQ_TAC THEN SIMP_TAC [] THEN
    MESON_TAC [DIVIDES_ANTISYM])

  let GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP ← prove
   r"!n m. group_element_order (integer_mod_group n) (&m) =
         if m = 0 /\ n = 0 then 1 else n DIV gcd(n,m)"
   (← do
    let a1 ← NUMBER_RULE (← q r"gcd(n,0) = n")
    pure (REPEAT GEN_TAC THEN TRANS_TAC EQ_TRANS
     (← q r"group_element_order (integer_mod_group n) ((&m * &1 rem &n) rem &n)") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [group_element_order, GROUP_POW_INTEGER_MOD_GROUP] THEN
      CONV_TAC INT_REM_DOWN_CONV THEN REWRITE_TAC [INT_MUL_RID],
      ALL_TAC] THEN
    REWRITE_TAC [← GSYM GROUP_POW_INTEGER_MOD_GROUP] THEN
    SIMP_TAC [GROUP_ELEMENT_ORDER_POW_GEN, INTEGER_MOD_GROUP_1R] THEN
    REWRITE_TAC [GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP_1R] THEN
    ASM_CASES_TAC (← q r"m = 0") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"n = 0") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [DIV_REFL, a1]))

  let INTEGER_MOD_SUBGROUP_GENERATED_BY_1R ← prove
   r"!n. subgroup_generated (integer_mod_group n) {&1 rem &n} =
       integer_mod_group n"
   (← do
    let a1 ← SET_RULE (← q
     r"(!x. f x IN s) /\ (!x. x IN s ==> f x = x)
     ==> {f x | x IN UNIV} = s")
    pure (GEN_TAC THEN REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_BY_SING, INTEGER_MOD_GROUP_1R] THEN
      REWRITE_TAC [GROUP_ZPOW_INTEGER_MOD_GROUP] THEN
    CONV_TAC INT_REM_DOWN_CONV THEN REWRITE_TAC [INT_MUL_RID] THEN
    ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_SIMP_TAC [INTEGER_MOD_GROUP, INT_REM_0, IN_GSPEC, LE_1] THEN
    MATCH_MP_TAC a1 THEN
    ASM_SIMP_TAC [IN_ELIM_THM, INT_DIVISION, INT_OF_NUM_EQ,
                 INT_LT_REM, INT_OF_NUM_LT, LE_1, INT_REM_LT]))

  let INTEGER_MOD_SUBGROUP_GENERATED_BY_1 ← prove
   r"!n. subgroup_generated (integer_mod_group n) {&1} =
       integer_mod_group n"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"n = 1") THEN
    ASM_SIMP_TAC [TRIVIAL_GROUP_GENERATED_BY_ANYTHING,
                 TRIVIAL_INTEGER_MOD_GROUP] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM INTEGER_MOD_SUBGROUP_GENERATED_BY_1R] THEN
    AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN REWRITE_TAC [INT_REM_EQ_SELF] THEN
    REWRITE_TAC [INT_OF_NUM_EQ, INT_OF_NUM_LE, INT_OF_NUM_LT, INT_ABS_NUM] THEN
    ASM_ARITH_TAC)

  let CYCLIC_GROUP_INTEGER_MOD_GROUP ← prove
   r"!n. cyclic_group(integer_mod_group n)"
   (ONCE_REWRITE_TAC [← GSYM INTEGER_MOD_SUBGROUP_GENERATED_BY_1] THEN
    REWRITE_TAC [CYCLIC_GROUP_GENERATED])

  -- @@RETURN BEGIN
  return { integer_mod_group, INTEGER_MOD_GROUP, INTEGER_MOD_GROUP_TRIVIAL,
           GROUP_CARRIER_INTEGER_MOD_GROUP, GROUP_POW_INTEGER_MOD_GROUP,
           GROUP_ZPOW_INTEGER_MOD_GROUP, ABELIAN_INTEGER_MOD_GROUP, INTEGER_MOD_GROUP_0,
           INTEGER_MOD_GROUP_1R, INTEGER_MOD_GROUP_1,
           GROUP_HOMOMORPHISM_PROD_INTEGER_MOD_GROUP, TRIVIAL_INTEGER_MOD_GROUP,
           NON_TRIVIAL_INTEGER_GROUP, GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP_1,
           GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP_1R,
           GROUP_ELEMENT_ORDER_INTEGER_MOD_GROUP, INTEGER_MOD_SUBGROUP_GENERATED_BY_1R,
           INTEGER_MOD_SUBGROUP_GENERATED_BY_1, CYCLIC_GROUP_INTEGER_MOD_GROUP }
  -- @@RETURN END

/-- Turn a 3-element list of theorems into a tuple (cf. list3 in
    HolLibrary/Matroids.lean), so each `let [A; B; C] = ...` element becomes
    a bundle field. -/
def list3 (l : List thm) : ExceptT String IO (thm × thm × thm) :=
  match l with
  | [a, b, c] => pure (a, b, c)
  | _ => throw "Match_failure"

structure CyclicInteger where
  -- @@FIELDS
  CYCLIC_INTEGER_GROUP : thm
  FINITE_INTEGER_MOD_GROUP : thm
  GROUP_EPIMORPHISM_INTEGER_MOD_GROUP_ZPOW : thm
  GROUP_ISOMORPHISM_GROUP_ZPOW_GEN : thm
  ISOMORPHIC_GROUP_CYCLIC_INTEGER : thm
  ORDER_INTEGER_MOD_GROUP : thm
  ISOMORPHIC_FINITE_CYCLIC_INTEGER_MOD_GROUP : thm
  ISOMORPHIC_GROUP_INTEGER_MOD_GROUP : thm
  ISOMORPHIC_INTEGER_MOD_GROUPS : thm
  ISOMORPHIC_FINITE_CYCLIC_GROUPS : thm
  CYCLIC_IMP_COUNTABLE_GROUP : thm
  SUBGROUP_GENERATED_ELEMENT_ORDER : thm
  CYCLIC_GROUP_ELEMENT_ORDER : thm
  deriving Inhabited

@[nospecialize]
def setupCyclicInteger [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BPow : Pow) (BSubgroupGenerated : SubgroupGenerated) (BIso1 : Iso1) (BIso2 : Iso2) (BKernelsImages1 : KernelsImages1) (BGroupElementOrder : GroupElementOrder) (BCyclicGroups1 : CyclicGroups1) (BCyclicGroups2 : CyclicGroups2) (BIntegerGroup : IntegerGroup) (BIntegerModGroup : IntegerModGroup) :
    ExceptT String IO CyclicInteger := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INTEGER_RULE, MESON, MESON_TAC, SET_RULE,
        SET_TAC, .. } := D
  let { CARD_EQ_0, CARD_IMAGE_INJ, CARD_NUMSEG_LT, CARD_SUBSET_EQ, CONJ_ASSOC, .. } := D.core1
  let { COUNTABLE_IMAGE, DIVIDES_LE, .. } := D.core2
  let { FINITE_INT_SEG, FINITE_NUMSEG_LT, FINITE_SUBSET, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FUN_EQ_THM, HAS_SIZE, .. } := D.core3
  let { IMP_CONJ, INFINITE, INT_COUNTABLE, INT_EXISTS_POS, INT_FORALL_POS, .. } := D.core4
  let { INT_OF_NUM_EQ, INT_OF_NUM_LT, INT_POS, INT_REM_DIV, IN_ELIM_THM, IN_IMAGE, .. } := D.core5
  let { LE_1, NOT_LE, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM_EQ, UNWIND_THM1,
        int_INFINITE, .. } := D.core7
  let { num_divides, .. } := D.core8
  let { GROUP_CARRIER_NONEMPTY, .. } := BBasics
  let { GROUP_ZPOW, GROUP_ZPOW_ADD, GROUP_ZPOW_POW, .. } := BPow
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, GROUP_ZPOW_SUBGROUP_GENERATED,
        SUBGROUP_GENERATED, SUBGROUP_GENERATED_EQ, .. } := BSubgroupGenerated
  let { ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRANS, isomorphic_group, .. } := BIso1
  let { ISOMORPHIC_GROUP_FINITENESS, ISOMORPHIC_GROUP_HAS_ORDER,
        ISOMORPHIC_GROUP_ORDER, .. } := BIso2
  let { GROUP_ISOMORPHISM_ALT, .. } := BKernelsImages1
  let { GROUP_ZPOW_EQ_ALT, GROUP_ZPOW_EQ_ID, .. } := BGroupElementOrder
  let { CYCLIC_GROUP, ISOMORPHIC_GROUP_CYCLICITY, cyclic_group, .. } := BCyclicGroups1
  let { CARD_CYCLIC_SUBGROUP_ORDER, FINITE_CYCLIC_SUBGROUP_EXPLICIT,
        FINITE_CYCLIC_SUBGROUP_ORDER, .. } := BCyclicGroups2
  let { GROUP_EPIMORPHISM_GROUP_ZPOW, GROUP_ISOMORPHISM_GROUP_ZPOW, .. } := BIntegerGroup
  let { CYCLIC_GROUP_INTEGER_MOD_GROUP, INTEGER_MOD_GROUP, INTEGER_MOD_GROUP_1,
        INTEGER_MOD_SUBGROUP_GENERATED_BY_1, integer_mod_group, .. } := BIntegerModGroup
  -- @@SCOPE END

  let CYCLIC_INTEGER_GROUP ← prove
   r"cyclic_group integer_group"
   (MP_TAC (← SPEC (← q r"0") CYCLIC_GROUP_INTEGER_MOD_GROUP) THEN
    REWRITE_TAC [integer_mod_group])

  let FINITE_INTEGER_MOD_GROUP ← prove
   r"!n. FINITE(group_carrier(integer_mod_group n)) <=> ~(n = 0)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_SIMP_TAC [INTEGER_MOD_GROUP, LE_1, int_INFINITE, ← GSYM INFINITE] THEN
    REWRITE_TAC [FINITE_INT_SEG])

  let GROUP_EPIMORPHISM_INTEGER_MOD_GROUP_ZPOW ← prove
   r"!n. ~(n = 1)
         ==> group_epimorphism (integer_group,integer_mod_group n)
                               (group_zpow (integer_mod_group n) (&1))"
   (MESON_TAC [INTEGER_MOD_GROUP_1, INTEGER_MOD_SUBGROUP_GENERATED_BY_1,
              GROUP_EPIMORPHISM_GROUP_ZPOW, GROUP_ZPOW_SUBGROUP_GENERATED])

  let GROUP_ISOMORPHISM_GROUP_ZPOW_GEN ← prove
   r"!G x:A.
          x IN group_carrier G
          ==> group_isomorphism (integer_mod_group (group_element_order G x),
                                 subgroup_generated G {x})
                                (group_zpow G x)"
   (← do
    let a2 ← INTEGER_RULE (← q r"(d:int) divides (n - (n - q * d))")
    let a1 ← SET_RULE (← q
     r"y IN IMAGE f {x | P x} <=> ?x. P x /\ f x = y")
    pure (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"group_element_order G (x:A) = 0") THENL
     [ASM_REWRITE_TAC [integer_mod_group] THEN
      MATCH_MP_TAC GROUP_ISOMORPHISM_GROUP_ZPOW THEN
      ASM_SIMP_TAC [INFINITE, FINITE_CYCLIC_SUBGROUP_ORDER],
      REWRITE_TAC [GROUP_ISOMORPHISM_ALT] THEN
      ASM_SIMP_TAC [INTEGER_MOD_GROUP, LE_1, ← CONJUNCT2 SUBGROUP_GENERATED]] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [a1] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    ASM_SIMP_TAC [GROUP_ZPOW_EQ_ID, ← GSYM GROUP_ZPOW_ADD, GROUP_ZPOW_EQ_ALT] THEN
    REWRITE_TAC [← GSYM INT_FORALL_POS, ← GSYM INT_EXISTS_POS, ← GSYM CONJ_ASSOC] THEN
    ASM_SIMP_TAC [GROUP_ZPOW, INT_OF_NUM_LT] THEN
    ASM_SIMP_TAC [FINITE_CYCLIC_SUBGROUP_EXPLICIT, FINITE_CYCLIC_SUBGROUP_ORDER,
                 FORALL_IN_GSPEC, GROUP_ZPOW_POW, INT_REM_DIV] THEN
    REWRITE_TAC [a2] THEN
    REPEAT (CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN
    REWRITE_TAC [← GSYM num_divides, INT_OF_NUM_EQ] THEN
    MESON_TAC [DIVIDES_LE, NOT_LE]))

  let ISOMORPHIC_GROUP_CYCLIC_INTEGER ← prove
   r"!G:A group. cyclic_group G <=> ?n. G isomorphic_group integer_mod_group n"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [cyclic_group] THEN
      MESON_TAC [GROUP_ISOMORPHISM_GROUP_ZPOW_GEN, ISOMORPHIC_GROUP_SYM,
                isomorphic_group],
      MESON_TAC [ISOMORPHIC_GROUP_CYCLICITY, CYCLIC_GROUP_INTEGER_MOD_GROUP]])

  let ORDER_INTEGER_MOD_GROUP ← prove
   r"!n. ~(n = 0) ==> CARD(group_carrier(integer_mod_group n)) = n"
   (SIMP_TAC [INTEGER_MOD_GROUP, LE_1] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"{m:int | &0 <= m /\ m < &n} = IMAGE (&) {i | i < n}")
    SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_IMAGE] THEN
      SIMP_TAC [IN_ELIM_THM, IN_IMAGE, INT_OF_NUM_LT, INT_POS] THEN
      REWRITE_TAC [← GSYM INT_FORALL_POS, IMP_CONJ] THEN
      REWRITE_TAC [INT_OF_NUM_LT, INT_OF_NUM_EQ, UNWIND_THM1],
      SIMP_TAC [CARD_IMAGE_INJ, INT_OF_NUM_EQ, FINITE_NUMSEG_LT] THEN
      REWRITE_TAC [CARD_NUMSEG_LT]])

  let ISOMORPHIC_FINITE_CYCLIC_INTEGER_MOD_GROUP ← prove
   r"!G:A group.
          cyclic_group G /\ FINITE(group_carrier G)
          ==> G isomorphic_group integer_mod_group (CARD(group_carrier G))"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"n:num") o
     GEN_REWRITE_RULE I [ISOMORPHIC_GROUP_CYCLIC_INTEGER]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ISOMORPHIC_GROUP_ORDER)) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_FINITENESS) THEN
    ASM_SIMP_TAC [FINITE_INTEGER_MOD_GROUP, ORDER_INTEGER_MOD_GROUP])

  let ISOMORPHIC_GROUP_INTEGER_MOD_GROUP ← prove
   r"(!(G:A group) n.
          G isomorphic_group integer_mod_group n <=>
          cyclic_group G /\
          (n = 0 /\ INFINITE(group_carrier G) \/
           ~(n = 0) /\ (group_carrier G) HAS_SIZE n)) /\
     (!(G:A group) n.
          integer_mod_group n isomorphic_group G <=>
          cyclic_group G /\
          (n = 0 /\ INFINITE(group_carrier G) \/
           ~(n = 0) /\ (group_carrier G) HAS_SIZE n))"
   (← do
    let a1 ← MESON [] (← q
     r"(!m n. R m /\ R n ==> P m ==> P n) /\
      (!n. P n ==> R n)
      ==> !n. P n <=> (?m. P m) /\ R n")
    pure (GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [ISOMORPHIC_GROUP_SYM] THEN
    REWRITE_TAC [] THEN
    GEN_TAC THEN REWRITE_TAC [ISOMORPHIC_GROUP_CYCLIC_INTEGER] THEN
    MATCH_MP_TAC a1 THEN
    REWRITE_TAC [HAS_SIZE, INFINITE] THEN
    CONJ_TAC THENL [MESON_TAC [], REPEAT STRIP_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_FINITENESS) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"n:num") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ISOMORPHIC_GROUP_HAS_ORDER)) THEN
    REWRITE_TAC [FINITE_INTEGER_MOD_GROUP, HAS_SIZE] THEN
    MESON_TAC [ORDER_INTEGER_MOD_GROUP]))

  let ISOMORPHIC_INTEGER_MOD_GROUPS ← prove
   r"!m n. integer_mod_group m isomorphic_group integer_mod_group n <=>
           m = n"
   (REWRITE_TAC [ISOMORPHIC_GROUP_INTEGER_MOD_GROUP, HAS_SIZE, INFINITE,
                FINITE_INTEGER_MOD_GROUP, CYCLIC_GROUP_INTEGER_MOD_GROUP] THEN
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_SIMP_TAC [ORDER_INTEGER_MOD_GROUP] THEN ASM_ARITH_TAC)

  let ISOMORPHIC_FINITE_CYCLIC_GROUPS ← prove
   r"!(G:A group) (H:B group).
          cyclic_group G /\ cyclic_group H /\
          FINITE(group_carrier G) /\ FINITE(group_carrier H) /\
          CARD(group_carrier G) = CARD(group_carrier H)
          ==> G isomorphic_group H"
   (REPEAT STRIP_TAC THEN TRANS_TAC ISOMORPHIC_GROUP_TRANS
     (← q r"integer_mod_group(CARD(group_carrier G:A->bool))") THEN
    REWRITE_TAC [ISOMORPHIC_GROUP_INTEGER_MOD_GROUP] THEN
    ASM_SIMP_TAC [INFINITE, HAS_SIZE, CARD_EQ_0, GROUP_CARRIER_NONEMPTY])

  let CYCLIC_IMP_COUNTABLE_GROUP ← prove
   r"!G:A group. cyclic_group G ==> COUNTABLE(group_carrier G)"
   (REWRITE_TAC [CYCLIC_GROUP] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [SIMPLE_IMAGE] THEN
    SIMP_TAC [COUNTABLE_IMAGE, INT_COUNTABLE])

  let SUBGROUP_GENERATED_ELEMENT_ORDER ← prove
   r"!G a:A.
          FINITE(group_carrier G) /\ a IN group_carrier G
          ==> (subgroup_generated G {a} = G <=>
               group_element_order G a = CARD(group_carrier G))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"FINITE (group_carrier (subgroup_generated G {a:A}))")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_SUBSET, GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET],
      ALL_TAC] THEN
    EQ_TAC THENL [ASM_MESON_TAC [CARD_CYCLIC_SUBGROUP_ORDER], DISCH_TAC] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_EQ] THEN
    MATCH_MP_TAC CARD_SUBSET_EQ THEN
    ASM_REWRITE_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET] THEN
    ASM_SIMP_TAC [CARD_CYCLIC_SUBGROUP_ORDER])

  let CYCLIC_GROUP_ELEMENT_ORDER ← prove
   r"!G:A group.
          FINITE(group_carrier G)
          ==> (cyclic_group G <=>
               ?a. a IN group_carrier G /\
                   group_element_order G a = CARD(group_carrier G))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [cyclic_group] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC I [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN ASM_CASES_TAC (← q r"(a:A) IN group_carrier G") THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_ELEMENT_ORDER])

  -- @@RETURN BEGIN
  return { CYCLIC_INTEGER_GROUP, FINITE_INTEGER_MOD_GROUP,
           GROUP_EPIMORPHISM_INTEGER_MOD_GROUP_ZPOW, GROUP_ISOMORPHISM_GROUP_ZPOW_GEN,
           ISOMORPHIC_GROUP_CYCLIC_INTEGER, ORDER_INTEGER_MOD_GROUP,
           ISOMORPHIC_FINITE_CYCLIC_INTEGER_MOD_GROUP,
           ISOMORPHIC_GROUP_INTEGER_MOD_GROUP, ISOMORPHIC_INTEGER_MOD_GROUPS,
           ISOMORPHIC_FINITE_CYCLIC_GROUPS, CYCLIC_IMP_COUNTABLE_GROUP,
           SUBGROUP_GENERATED_ELEMENT_ORDER, CYCLIC_GROUP_ELEMENT_ORDER }
  -- @@RETURN END

structure CyclicProd where
  -- @@FIELDS
  CYCLIC_PROD_INTEGER_MOD_GROUP : thm
  ISOMORPHIC_PROD_INTEGER_MOD_GROUP : thm
  GROUP_ISOMORPHISM_PROD_INTEGER_MOD_GROUP : thm
  CYCLIC_PROD_GROUP : thm
  CYCLIC_PRIME_ORDER_GROUP : thm
  GROUP_ELEMENT_ORDER_PRIME : thm
  GENERATOR_INTEGER_MOD_GROUP : thm
  CYCLIC_GROUP_PRIME_ORDER_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupCyclicProd [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BProdGroup : ProdGroup) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms3 : Homomorphisms3) (BIso1 : Iso1) (BIso2 : Iso2) (BGroupElementOrder : GroupElementOrder) (BCyclicGroups1 : CyclicGroups1) (BCyclicGroups2 : CyclicGroups2) (BCyclicGroups3 : CyclicGroups3) (BIntegerModGroup : IntegerModGroup) (BCyclicInteger : CyclicInteger) :
    ExceptT String IO CyclicProd := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INTEGER_RULE, INT_ARITH_TAC, INT_REM_DOWN_CONV,
        MESON, MESON_TAC, NUMBER_RULE, SET_RULE, SET_TAC, TAUT, .. } := D
  let { AND_FORALL_THM, ARITH, ARITH_EQ, CARD_SING, CONJ_ASSOC, .. } := D.core1
  let { CONJ_SYM, CONTRAPOS_THM, EQ_IMP, EQ_SYM_EQ, EXISTS_IN_IMAGE, EXISTS_PAIR_THM, .. } := D.core2
  let { EXTENSION, FINITE_SING, FORALL_IN_IMAGE, FORALL_PAIR_THM, HAS_SIZE, .. } := D.core3
  let { IMP_CONJ, INT_LT_REM_EQ, .. } := D.core4
  let { INT_OF_NUM_EQ, INT_OF_NUM_LT, INT_OF_NUM_MUL, INT_REM_0, INT_REM_1, INT_REM_EQ,
        INT_REM_LT, INT_REM_POS_EQ, INT_REM_REM_MUL, IN_CROSS, IN_ELIM_THM, IN_SING,
        IN_UNIV, .. } := D.core5
  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, LE_1, LE_REFL, MULT_CLAUSES,
        MULT_EQ_0, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, ONE_OR_PRIME,
        ONE_OR_PRIME_DIVIDES_OR_COPRIME, PAIR_EQ, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SUBSET,
        UNWIND_THM2, .. } := D.core7
  let { num_coprime, prime, .. } := D.core8
  let { GROUPS_EQ, TRIVIAL_GROUP_SUBSET, trivial_group, .. } := BBasics
  let { GROUP_POW, GROUP_POW_1, .. } := BDerived
  let { GROUP_NPOW, GROUP_ZPOW_MUL, .. } := BPow
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGen1
  let { GROUP_ZPOW_PROD_GROUP, PROD_GROUP, .. } := BProdGroup
  let { GROUP_ISOMORPHISM_SUBSET, .. } := BHomomorphisms2
  let { GROUP_EPIMORPHISM_FST, GROUP_EPIMORPHISM_SND, .. } := BHomomorphisms3
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, ISOMORPHIC_GROUP_PROD_GROUPS,
        ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRIVIALITY, .. } := BIso1
  let { ISOMORPHIC_GROUP_FINITENESS, ISOMORPHIC_GROUP_ORDER, .. } := BIso2
  let { GROUP_ELEMENT_ORDER_EQ_1, GROUP_ELEMENT_ORDER_ID, GROUP_POW_EQ_ID,
        GROUP_ZPOW_EQ_ALT, .. } := BGroupElementOrder
  let { CARRIER_SUBGROUP_GENERATED_BY_SING, CYCLIC_GROUP,
        CYCLIC_GROUP_EPIMORPHIC_IMAGE, ISOMORPHIC_GROUP_CYCLICITY, .. } := BCyclicGroups1
  let { CARD_CYCLIC_SUBGROUP_ORDER, FINITE_CYCLIC_SUBGROUP_ORDER, .. } := BCyclicGroups2
  let { GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER, .. } := BCyclicGroups3
  let { CYCLIC_GROUP_INTEGER_MOD_GROUP, GROUP_CARRIER_INTEGER_MOD_GROUP,
        GROUP_HOMOMORPHISM_PROD_INTEGER_MOD_GROUP, GROUP_ZPOW_INTEGER_MOD_GROUP,
        INTEGER_MOD_GROUP, TRIVIAL_INTEGER_MOD_GROUP, .. } := BIntegerModGroup
  let { FINITE_INTEGER_MOD_GROUP, ISOMORPHIC_GROUP_CYCLIC_INTEGER,
        ORDER_INTEGER_MOD_GROUP, SUBGROUP_GENERATED_ELEMENT_ORDER, .. } := BCyclicInteger
  -- @@SCOPE END

  let (CYCLIC_PROD_INTEGER_MOD_GROUP,
       ISOMORPHIC_PROD_INTEGER_MOD_GROUP,
       GROUP_ISOMORPHISM_PROD_INTEGER_MOD_GROUP) ←
    list3 (CONJUNCTS (← prove
   r"(!m n. cyclic_group (prod_group (integer_mod_group m) (integer_mod_group n))
            <=> coprime(m,n)) /\
     (!m n.
          prod_group (integer_mod_group m) (integer_mod_group n) isomorphic_group
          integer_mod_group (m * n) <=>
          coprime(m,n)) /\
     (!m n.
          group_isomorphism
           (integer_mod_group (m * n),
            prod_group (integer_mod_group m) (integer_mod_group n))
           (\a. (a rem &m),(a rem &n)) <=>
          coprime(m,n))"
   (← do
    let a8 ← INTEGER_RULE (← q
     r"coprime(m:int,n)
        ==> !a b. (a == b) (mod m) /\ (a == b) (mod n)
      ==> (a == b) (mod (m * n))")
    let a7 ← INTEGER_RULE (← q
     r"coprime(m:int,n)
        ==> !a b. ?c. (c == a) (mod m) /\ (c == b) (mod n)")
    let a6 ← NUMBER_RULE (← q r"coprime(n,0) <=> n = 1")
    let a5 ← NUMBER_RULE (← q r"coprime(0,n) <=> n = 1")
    let a4 ← INTEGER_RULE (← q
     r"(x * a == &1) (mod m) /\ (x * b == &1) (mod n) /\
      (y * a == &0) (mod m) /\ (y * b == &1) (mod n)
      ==> coprime(m,n)")
    let a3 ← SET_RULE (← q r"!z. z IN s /\ ~(z IN t) ==> ~(s = t)")
    let a2 ← MESON [] (← q r"~(?x. P x /\ Q x) <=> !x. P x ==> ~Q x")
    let a1 ← TAUT (← q
     r"(r ==> q) /\ (q ==> p) /\ (p ==> c) /\ (c ==> r)
      ==> (p <=> c) /\ (q <=> c) /\ (r <=> c)")
    pure (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC a1 THEN
    REPEAT CONJ_TAC THENL
     [ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
      REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC],
      DISCH_THEN (MP_TAC o MATCH_MP ISOMORPHIC_GROUP_CYCLICITY) THEN
      REWRITE_TAC [CYCLIC_GROUP_INTEGER_MOD_GROUP],
      GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
      DISCH_TAC THEN REWRITE_TAC [CYCLIC_GROUP] THEN
      REWRITE_TAC [a2] THEN
      SIMP_TAC [FORALL_PAIR_THM, PROD_GROUP, IN_CROSS,
               GROUP_ZPOW_INTEGER_MOD_GROUP, GROUP_ZPOW_PROD_GROUP] THEN
      REWRITE_TAC [GROUP_CARRIER_INTEGER_MOD_GROUP] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE, IN_UNIV] THEN
      MAP_EVERY X_GEN_TAC [(← q r"a:int"), (← q r"b:int")] THEN
      MATCH_MP_TAC a3 THEN
      REWRITE_TAC [EXISTS_PAIR_THM, EXISTS_IN_IMAGE, RIGHT_EXISTS_AND_THM,
                  IN_CROSS, ← GSYM CONJ_ASSOC, IN_UNIV, IN_ELIM_THM] THEN
      CONV_TAC INT_REM_DOWN_CONV THEN
      ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN REWRITE_TAC [PAIR_EQ, INT_REM_EQ] THEN
      POP_ASSUM MP_TAC THEN GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [num_coprime, NOT_EXISTS_THM] THEN MESON_TAC [a4],
      REWRITE_TAC [GROUP_ISOMORPHISM_SUBSET] THEN
      REWRITE_TAC [GROUP_HOMOMORPHISM_PROD_INTEGER_MOD_GROUP] THEN
      REWRITE_TAC [PROD_GROUP, FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
      ASM_CASES_TAC (← q r"m = 0") THENL
       [ASM_SIMP_TAC [INT_REM_0, MULT_CLAUSES, INT_REM_1, a5] THEN
        SIMP_TAC [INTEGER_MOD_GROUP, ARITH, IN_UNIV, IN_ELIM_THM] THEN
        REWRITE_TAC [UNWIND_THM2] THEN INT_ARITH_TAC,
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"n = 0") THENL
       [ASM_SIMP_TAC [INT_REM_0, MULT_CLAUSES, INT_REM_1, a6] THEN
        SIMP_TAC [INTEGER_MOD_GROUP, ARITH, IN_UNIV, IN_ELIM_THM] THEN
        ONCE_REWRITE_TAC [CONJ_SYM] THEN REWRITE_TAC [UNWIND_THM2] THEN
        INT_ARITH_TAC,
        ALL_TAC] THEN
      DISCH_TAC THEN ASM_SIMP_TAC [INTEGER_MOD_GROUP, LE_1, MULT_EQ_0] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      CONJ_TAC THEN MAP_EVERY X_GEN_TAC [(← q r"a:int"), (← q r"b:int")] THENL
       [STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [num_coprime]) THEN
        DISCH_THEN (MP_TAC o SPECL [(← q r"a:int"), (← q r"b:int")] o MATCH_MP a7) THEN
        ASM_SIMP_TAC [← GSYM INT_REM_EQ, INT_REM_LT] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:int") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"c rem &(m * n)") THEN
        REWRITE_TAC [INT_REM_POS_EQ, INT_LT_REM_EQ] THEN
        ASM_SIMP_TAC [INT_OF_NUM_EQ, INT_OF_NUM_LT, MULT_EQ_0, LE_1] THEN
        ASM_REWRITE_TAC [← GSYM INT_OF_NUM_MUL, INT_REM_REM_MUL],
        STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [num_coprime]) THEN
        DISCH_THEN (MP_TAC o SPECL [(← q r"a:int"), (← q r"b:int")] o MATCH_MP a8) THEN
        ASM_REWRITE_TAC [← GSYM INT_REM_EQ] THEN
        MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN MATCH_MP_TAC INT_REM_LT THEN
        ASM_REWRITE_TAC [INT_OF_NUM_MUL]]]))))

  let CYCLIC_PROD_GROUP ← prove
   r"!(G:A group) (H:B group).
          cyclic_group (prod_group G H) <=>
          cyclic_group G /\ cyclic_group H /\
          (trivial_group G \/
           trivial_group H \/
           FINITE(group_carrier G) /\ FINITE(group_carrier H) /\
           coprime(CARD(group_carrier G),CARD(group_carrier H)))"
   (← do
    let a5 ← NUMBER_RULE (← q r"coprime(n,0) <=> n = 1")
    let a4 ← NUMBER_RULE (← q r"coprime(0,n) <=> n = 1")
    let a3 ← NUMBER_RULE (← q r"coprime(n,1)")
    let a2 ← NUMBER_RULE (← q r"coprime(1,n)")
    pure (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"cyclic_group(G:A group)") THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [] THEN POP_ASSUM MP_TAC THEN
      REWRITE_TAC [CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CYCLIC_GROUP_EPIMORPHIC_IMAGE) THEN
      EXISTS_TAC (← q r"FST:A#B->A") THEN REWRITE_TAC [GROUP_EPIMORPHISM_FST]] THEN
    ASM_CASES_TAC (← q r"cyclic_group(H:B group)") THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [] THEN POP_ASSUM MP_TAC THEN
      REWRITE_TAC [CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CYCLIC_GROUP_EPIMORPHIC_IMAGE) THEN
      EXISTS_TAC (← q r"SND:A#B->B") THEN REWRITE_TAC [GROUP_EPIMORPHISM_SND]] THEN
    ASM_REWRITE_TAC [] THEN POP_ASSUM_LIST (MP_TAC o end_itlist CONJ o HolLight.rev) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [ISOMORPHIC_GROUP_CYCLIC_INTEGER] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [(← q r"m:num"), (← q r"n:num")] THEN DISCH_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_CYCLICITY o
      MATCH_MP ISOMORPHIC_GROUP_PROD_GROUPS) THEN
    FIRST_ASSUM (CONJUNCTS_THEN
     (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_TRIVIALITY)) THEN
    FIRST_ASSUM (CONJUNCTS_THEN
     (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] ISOMORPHIC_GROUP_ORDER))) THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN
     (SUBST1_TAC o MATCH_MP ISOMORPHIC_GROUP_FINITENESS)) THEN
    SIMP_TAC [FINITE_INTEGER_MOD_GROUP, CYCLIC_PROD_INTEGER_MOD_GROUP,
             TRIVIAL_INTEGER_MOD_GROUP, ORDER_INTEGER_MOD_GROUP] THEN
    ASM_CASES_TAC (← q r"m = 1") THEN ASM_REWRITE_TAC [a2] THEN
    ASM_CASES_TAC (← q r"n = 1") THEN ASM_REWRITE_TAC [a3] THEN
    ASM_CASES_TAC (← q r"m = 0") THEN
    ASM_SIMP_TAC [a4] THEN
    ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_SIMP_TAC [a5]))

  let CYCLIC_PRIME_ORDER_GROUP ← prove
   r"!G (a:A).
          FINITE (group_carrier G) /\
          (CARD(group_carrier G) = 1 \/ prime(CARD(group_carrier G))) /\
          a IN group_carrier G /\ ~(a = group_id G)
          ==> subgroup_generated G {a} = G"
   (REWRITE_TAC [ONE_OR_PRIME] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_ELEMENT_ORDER] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"group_element_order G (a:A)")) THEN
    ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER] THEN
    ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_1])

  let GROUP_ELEMENT_ORDER_PRIME ← prove
   r"!G a:A. prime p /\ (group_carrier G) HAS_SIZE p /\ a IN group_carrier G
             ==> group_element_order G a =
                 if a = group_id G then 1 else CARD(group_carrier G)"
   (REWRITE_TAC [HAS_SIZE] THEN
    MESON_TAC [GROUP_ELEMENT_ORDER_ID, SUBGROUP_GENERATED_ELEMENT_ORDER,
              CYCLIC_PRIME_ORDER_GROUP])

  let GENERATOR_INTEGER_MOD_GROUP ← prove
   r"!n a. subgroup_generated (integer_mod_group n) {a} = integer_mod_group n <=>
           (n <= 1 \/ &0 <= a /\ a < &n) /\ coprime(&n,a)"
   (← do
    let a2 ← SET_RULE (← q
     r"{(x * a) rem &n | x IN (:int)} = IMAGE (\x. x rem &n) (:int) <=>
      !x. ?y. (y * a) rem &n = x rem &n")
    let a1 ← TAUT (← q r"q /\ (p <=> r) ==> (p <=> q /\ r)")
    pure (REPEAT STRIP_TAC THEN
    REWRITE_TAC [GROUPS_EQ, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
    ASM_CASES_TAC (← q r"a IN group_carrier(integer_mod_group n)") THENL
     [ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_BY_SING] THEN
      REWRITE_TAC [GROUP_CARRIER_INTEGER_MOD_GROUP] THEN
      REWRITE_TAC [GROUP_ZPOW_INTEGER_MOD_GROUP] THEN
      MATCH_MP_TAC a1 THEN
      CONJ_TAC THENL
       [POP_ASSUM MP_TAC THEN ASM_CASES_TAC (← q r"n = 0") THEN
        ASM_SIMP_TAC [INTEGER_MOD_GROUP, LE_1, IN_ELIM_THM, ARITH],
        REWRITE_TAC [INT_REM_EQ, a2] THEN
        EQ_TAC THENL [DISCH_THEN (MP_TAC o SPEC (← q r"&1:int")), ALL_TAC] THEN
        CONV_TAC INTEGER_RULE],
      SUBGOAL_THEN (← q r"trivial_group (subgroup_generated (integer_mod_group n) {a})")
      MP_TAC THENL
       [REWRITE_TAC [TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ] THEN ASM SET_TAC [],
        REWRITE_TAC [trivial_group] THEN DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [SUBGROUP_GENERATED] THEN
      GEN_REWRITE_TAC LAND_CONV [EQ_SYM_EQ] THEN
      REWRITE_TAC [← GSYM trivial_group, TRIVIAL_INTEGER_MOD_GROUP] THEN
      POP_ASSUM MP_TAC THEN
      ASM_CASES_TAC (← q r"n = 1") THEN ASM_REWRITE_TAC [LE_REFL] THENL
       [CONV_TAC INTEGER_RULE, ALL_TAC] THEN
      ASM_CASES_TAC (← q r"n = 0") THEN
      ASM_SIMP_TAC [INTEGER_MOD_GROUP, LE_1, IN_UNIV, IN_ELIM_THM] THEN
      ASM_ARITH_TAC]))

  let CYCLIC_GROUP_PRIME_ORDER_EQ ← prove
   r"!(G:A group).
          (!a. a IN group_carrier G /\ ~(a = group_id G)
               ==> subgroup_generated G {a} = G) <=>
          FINITE(group_carrier G) /\
          (CARD (group_carrier G) = 1 \/ prime (CARD (group_carrier G)))"
   (← do
    let a2 ← TAUT (← q r"(p ==> ~q) /\ q ==> ~p /\ q")
    let a1 ← TAUT (← q r"p /\ (p ==> r) ==> p /\ (q \/ r)")
    pure (GEN_TAC THEN EQ_TAC THEN SIMP_TAC [CYCLIC_PRIME_ORDER_GROUP] THEN
    DISCH_TAC THEN ASM_CASES_TAC (← q r"trivial_group(G:A group)") THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [trivial_group]) THEN
      ASM_REWRITE_TAC [FINITE_SING, CARD_SING],
      FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE RAND_CONV [TRIVIAL_GROUP_SUBSET])] THEN
    REWRITE_TAC [SUBSET, IN_SING, NOT_FORALL_THM, NOT_IMP] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:A") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC a1 THEN
    SUBGOAL_THEN (← q r"G = subgroup_generated G {z:A}") MP_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (fun th =>
     tactic_of do
      let loc ← TAUT (← q r"p /\ (p ==> q) <=> p /\ q")
      pure (SUBST1_TAC th THEN ASM_SIMP_TAC [CARD_CYCLIC_SUBGROUP_ORDER] THEN
       REWRITE_TAC [loc] THEN
       SUBST1_TAC th THEN ASM_SIMP_TAC [FINITE_CYCLIC_SUBGROUP_ORDER])) THEN
    ABBREV_TAC (← q r"d = group_element_order G (z:A)") THEN
    MATCH_MP_TAC a2 THEN CONJ_TAC THENL
     [DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [prime, ARITH_EQ] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"2")) THEN REWRITE_TAC [ARITH_EQ] THEN
      CONV_TAC NUMBER_RULE,
      ALL_TAC] THEN
    MP_TAC (← SPEC (← q r"d:num") ONE_OR_PRIME_DIVIDES_OR_COPRIME) THEN
    EXPAND_TAC "d" THEN ASM_SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_1] THEN
    DISCH_THEN SUBST1_TAC THEN X_GEN_TAC (← q r"n:num") THEN
    ASM_CASES_TAC (← q r"(d:num) divides n") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"group_pow G (z:A) n")) THEN
    ASM_SIMP_TAC [GROUP_POW_EQ_ID, GROUP_POW] THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"group_carrier:A group->A->bool")) THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_BY_SING, GROUP_POW] THEN
    GEN_REWRITE_TAC LAND_CONV [EXTENSION] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:A")) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"m:int") THEN
    FIRST_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
       [← SYM (← MATCH_MP GROUP_POW_1 th)])) THEN
    REWRITE_TAC [← GSYM GROUP_NPOW, num_coprime] THEN
    ASM_SIMP_TAC [← GSYM GROUP_ZPOW_MUL, GROUP_ZPOW_EQ_ALT] THEN
    CONV_TAC INTEGER_RULE))

  -- @@RETURN BEGIN
  return { CYCLIC_PROD_INTEGER_MOD_GROUP, ISOMORPHIC_PROD_INTEGER_MOD_GROUP,
           GROUP_ISOMORPHISM_PROD_INTEGER_MOD_GROUP, CYCLIC_PROD_GROUP,
           CYCLIC_PRIME_ORDER_GROUP, GROUP_ELEMENT_ORDER_PRIME,
           GENERATOR_INTEGER_MOD_GROUP, CYCLIC_GROUP_PRIME_ORDER_EQ }
  -- @@RETURN END

structure Pgroup where
  -- @@FIELDS
  pgroup : thm
  PGROUP_MONOMORPHIC_PREIMAGE : thm
  PGROUP_EPIMORPHIC_IMAGE : thm
  PGROUP_QUOTIENT_GROUP : thm
  PGROUP_SUBGROUP_GENERATED : thm
  PGROUP_PROD_GROUP : thm
  PGROUP_EMPTY : thm
  PGROUP_MONO : thm
  PGROUP_SUM_GROUP : thm
  PGROUP_SING : thm
  deriving Inhabited

@[nospecialize]
def setupPgroup [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BProdGroup : ProdGroup) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms3 : Homomorphisms3) (BHomomorphisms4 : Homomorphisms4) (BQuotientGroups : QuotientGroups) (BGroupElementOrder : GroupElementOrder) (BGroupElementOrder2 : GroupElementOrder2) (BOrderDecomp : OrderDecomp) :
    ExceptT String IO Pgroup := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { DIVIDES_ONE, DIVIDES_TRANS, .. } := D.core2
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_CROSS, IN_ELIM_THM, IN_SING, .. } := D.core5
  let { NOT_IN_EMPTY, PRIME_1, PRIME_DIVIDES_ITERATE_LCM_GEN, PRIME_DIVIDES_LCM,
        PRIME_FACTOR, PRIME_POWER_EXISTS, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.core7
  let { TRIVIAL_GROUP_SUBSET, .. } := BBasics
  let { PROD_GROUP, .. } := BProdGroup
  let { SUM_GROUP_CLAUSES, .. } := BSumGroup
  let { group_epimorphism, group_homomorphism, group_monomorphism, .. } := BHomomorphisms
  let { GROUP_MONOMORPHISM_INCLUSION, .. } := BHomomorphisms1
  let { GROUP_EPIMORPHISM_FST, GROUP_EPIMORPHISM_SND, .. } := BHomomorphisms3
  let { GROUP_EPIMORPHISM_SUM_PROJECTION, .. } := BHomomorphisms4
  let { GROUP_EPIMORPHISM_RIGHT_COSET, .. } := BQuotientGroups
  let { GROUP_ELEMENT_ORDER_EQ_1, .. } := BGroupElementOrder
  let { GROUP_ELEMENT_ORDER_HOMOMORPHIC_IMAGE, GROUP_ELEMENT_ORDER_MONOMORPHIC_IMAGE, .. } := BGroupElementOrder2
  let { GROUP_ELEMENT_ORDER_PROD_GROUP, GROUP_ELEMENT_ORDER_SUM_GROUP, .. } := BOrderDecomp
  -- @@SCOPE END

  let pgroup ← D.new_definition
   r"pgroup s (G:A group) <=>
          !p x. prime p /\
                x IN group_carrier G /\
                p divides group_element_order G x
                ==> p IN s"

  let PGROUP_MONOMORPHIC_PREIMAGE ← prove
   r"!G H (f:A->B) s. group_monomorphism (G,H) f /\ pgroup s H ==> pgroup s G"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o CONJUNCT1 o
      REWRITE_RULE [group_monomorphism, group_homomorphism]) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, pgroup] THEN
    ASM_MESON_TAC [GROUP_ELEMENT_ORDER_MONOMORPHIC_IMAGE])

  let PGROUP_EPIMORPHIC_IMAGE ← prove
   r"!G H (f:A->B) s. group_epimorphism (G,H) f /\ pgroup s G ==> pgroup s H"
   (REPEAT GEN_TAC THEN REWRITE_TAC [group_epimorphism] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [pgroup] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_IMAGE] THEN
    ASM_MESON_TAC [GROUP_ELEMENT_ORDER_HOMOMORPHIC_IMAGE, DIVIDES_TRANS])

  let PGROUP_QUOTIENT_GROUP ← prove
   r"!(G:A group) n s.
        n normal_subgroup_of G /\ pgroup s G ==> pgroup s (quotient_group G n)"
   (MESON_TAC [PGROUP_EPIMORPHIC_IMAGE, GROUP_EPIMORPHISM_RIGHT_COSET])

  let PGROUP_SUBGROUP_GENERATED ← prove
   r"!(G:A group) s h.
          pgroup s G ==> pgroup s (subgroup_generated G h)"
   (MESON_TAC [GROUP_MONOMORPHISM_INCLUSION, PGROUP_MONOMORPHIC_PREIMAGE])

  let PGROUP_PROD_GROUP ← prove
   r"!(G:A group) (H:A group) s.
          pgroup s (prod_group G H) <=> pgroup s G /\ pgroup s H"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [GROUP_EPIMORPHISM_FST,
                GROUP_EPIMORPHISM_SND, PGROUP_EPIMORPHIC_IMAGE],
      REWRITE_TAC [pgroup, PROD_GROUP, FORALL_PAIR_THM, IN_CROSS] THEN
      SIMP_TAC [GROUP_ELEMENT_ORDER_PROD_GROUP, IMP_CONJ] THEN
      MESON_TAC [PRIME_DIVIDES_LCM]])

  let PGROUP_EMPTY ← prove
   r"!G:A group. pgroup {} G <=> trivial_group G"
   (← do
    let a1 ← D.MESON [PRIME_FACTOR, DIVIDES_ONE, PRIME_1] (← q
     r"(!p x. ~(prime p /\ P x /\ p divides f x)) <=>
      (!x. P x ==> f x = 1)")
    pure (REWRITE_TAC [pgroup, NOT_IN_EMPTY, a1] THEN
     SIMP_TAC [GROUP_ELEMENT_ORDER_EQ_1, TRIVIAL_GROUP_SUBSET] THEN SET_TAC []))

  let PGROUP_MONO ← prove
   r"!(G:A group) s t. pgroup s G /\ s SUBSET t ==> pgroup t G"
   (REWRITE_TAC [pgroup] THEN SET_TAC [])

  let PGROUP_SUM_GROUP ← prove
   r"!k (G:K->A group) s.
          pgroup s (sum_group k G) <=> !i. i IN k ==> pgroup s (G i)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] PGROUP_EPIMORPHIC_IMAGE) THEN
      ASM_MESON_TAC [GROUP_EPIMORPHISM_SUM_PROJECTION],
      DISCH_TAC THEN REWRITE_TAC [pgroup, IMP_CONJ]] THEN
    MAP_EVERY X_GEN_TAC [(← q r"p:num"), (← q r"x:K->A")] THEN
    SIMP_TAC [GROUP_ELEMENT_ORDER_SUM_GROUP, PRIME_DIVIDES_ITERATE_LCM_GEN] THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, IN_CARTESIAN_PRODUCT, IN_ELIM_THM] THEN
    ASM_MESON_TAC [pgroup, DIVIDES_TRANS])

  let PGROUP_SING ← prove
   r"!(G:A group) p.
       prime p
       ==> (pgroup {p} G <=>
            !x. x IN group_carrier G ==> ?k. group_element_order G x = p EXP k)"
   (REWRITE_TAC [pgroup, IN_SING] THEN
    MESON_TAC [PRIME_POWER_EXISTS])

  -- @@RETURN BEGIN
  return { pgroup, PGROUP_MONOMORPHIC_PREIMAGE, PGROUP_EPIMORPHIC_IMAGE,
           PGROUP_QUOTIENT_GROUP, PGROUP_SUBGROUP_GENERATED, PGROUP_PROD_GROUP,
           PGROUP_EMPTY, PGROUP_MONO, PGROUP_SUM_GROUP, PGROUP_SING }
  -- @@RETURN END

structure SylowCount where
  -- @@FIELDS
  SYLOW_THEOREM_COUNT_MOD : thm
  deriving Inhabited

@[nospecialize]
def setupSylowCount [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BGroupRule : GroupRule) (BSubgroups : Subgroups) (BSubgroupGen1 : SubgroupGen1) (BSetwise1 : Setwise1) (BGroupActions : GroupActions) (BGroupOrbits : GroupOrbits) (BOrbitStabilizer : OrbitStabilizer) (BCosets : Cosets) (BCosets1 : Cosets1) (BCosets2 : Cosets2) (BCyclicGroups3 : CyclicGroups3) (BIntegerModGroup : IntegerModGroup) (BCyclicInteger : CyclicInteger) :
    ExceptT String IO SylowCount := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, NUMBER_RULE, SET_TAC, .. } := D
  let { CARD_CLAUSES, CARD_EQ_0, CARD_EQ_BIJECTION, CARD_EQ_CARD_IMP, CARD_IMAGE_INJ,
        CONG_NSUM, CONJ_ASSOC, .. } := D.core1
  let { CONJ_SYM, DIVIDES_PRIMEPOW, EQ_TRANS, ETA_AX, EXP, EXP_ADD, EXP_EQ_0, .. } := D.core2
  let { EXTENSION, FINITE_IMAGE, FINITE_RESTRICT, FINITE_RESTRICTED_SUBSETS,
        FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_UNWIND_THM2, HAS_SIZE, .. } := D.core3
  let { IMP_CONJ, INJECTIVE_ON_ALT, .. } := D.core4
  let { IN_ELIM_THM, IN_IMAGE, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, LE_LT, LT_EXISTS, MEMBER_NOT_EMPTY, MULT_ASSOC, MULT_EQ_0,
        NOT_IMP, NSUM_CONST, NSUM_RESTRICT_SET, PRIME_0, PRIME_IMP_NZ, .. } := D.core6
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET,
        SUBSET_ANTISYM, SUBSET_CARD_EQ, SUBSET_IMAGE, SWAP_EXISTS_THM, UNWIND_THM1,
        divides, .. } := D.core7
  let { o_DEF, o_THM, .. } := D.core8
  let { GROUP_CARRIER_NONEMPTY, GROUP_ID, GROUP_INV, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_RULE, .. } := BGroupRule
  let { FINITE_RESTRICTED_SUBGROUPS, SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  let { group_setmul, .. } := BSetwise1
  let { FINITE_GROUP_STABILIZER, GROUP_ACTION_FROM_SUBGROUP, GROUP_ACTION_IMAGE_SIZED,
        GROUP_ACTION_ON_SUBSET, SUBGROUP_OF_GROUP_STABILIZER, group_action,
        group_stabilizer, .. } := BGroupActions
  let { GROUP_ORBIT, GROUP_ORBIT_EQ, GROUP_ORBIT_ON_SUBSET, GROUP_ORBIT_SYM_EQ,
        NSUM_CARD_GROUP_ORBITS, group_orbit, .. } := BGroupOrbits
  let { GROUP_ACTION_GROUP_TRANSLATION, GROUP_ORBIT_COMMON_DIVISOR,
        ORBIT_STABILIZER_MUL, .. } := BOrbitStabilizer
  let { LEFT_COSET_AS_IMAGE, LEFT_COSET_EQ_SUBGROUP, LEFT_COSET_ID, right_coset, .. } := BCosets
  let { CARD_EQ_RIGHT_COSET_SUBGROUP, SUBGROUP_OF_LEFT_COSET, .. } := BCosets1
  let { GROUP_ORBIT_SUBGROUP_TRANSLATION, .. } := BCosets2
  let { COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS, .. } := BCyclicGroups3
  let { CYCLIC_GROUP_INTEGER_MOD_GROUP, .. } := BIntegerModGroup
  let { FINITE_INTEGER_MOD_GROUP, ORDER_INTEGER_MOD_GROUP, .. } := BCyclicInteger
  -- @@SCOPE END

  let SYLOW_THEOREM_COUNT_MOD ← prove
   r"!(G:A group) p k.
          FINITE(group_carrier G) /\
          prime p /\
          p EXP k divides CARD(group_carrier G)
          ==> (CARD {h | h subgroup_of G /\ CARD h = p EXP k} == 1) (mod p)"
   (← do
    let lemma ← prove
     r"!(s:A->bool) (t:B->bool) k.
            FINITE s /\ FINITE t /\ CARD s = CARD t
            ==> CARD {s' | s' SUBSET s /\ CARD s' = k} =
                CARD {t' | t' SUBSET t /\ CARD t' = k}"
     (← do
      let a2 ← D.MESON [] (← q r"(p ==> y = x) ==> (p /\ x = k <=> p /\ y = k)")
      let a1 ← D.SET_RULE (← q
       r"{t' | (?u. u SUBSET s /\ t' = f u) /\ P t'} =
        IMAGE f {u | u SUBSET s /\ P(f u)}")
      pure (REPEAT GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM
       (X_CHOOSE_THEN (← q r"f:A->B") MP_TAC o MATCH_MP CARD_EQ_BIJECTION) THEN
      REWRITE_TAC [INJECTIVE_ON_ALT] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"t = IMAGE (f:A->B) s") SUBST1_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [SUBSET_IMAGE, a1] THEN
      wPart rand (fun t => do lhand (← rand t)) CARD_IMAGE_INJ THEN
      ASM_SIMP_TAC [FINITE_RESTRICTED_SUBSETS] THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
      AP_TERM_TAC THEN GEN_REWRITE_TAC I [EXTENSION] THEN
      X_GEN_TAC (← q r"u:A->bool") THEN REWRITE_TAC [IN_ELIM_THM] THEN
      MATCH_MP_TAC a2 THEN
      DISCH_TAC THEN MATCH_MP_TAC CARD_IMAGE_INJ THEN
      CONJ_TAC THENL [ASM SET_TAC [], ASM_MESON_TAC [FINITE_SUBSET]]))
    let SYLOW_LEMMA ← prove
     r"!(G:A group) p k n.
            FINITE(group_carrier G) /\
            prime p /\
            p EXP k * n = CARD(group_carrier G)
            ==> (CARD {t | t SUBSET group_carrier G /\ CARD t = p EXP k} ==
                 CARD {h | h subgroup_of G /\ CARD h = p EXP k} * n)
                (mod (p * n))"
     (← do
      let a13 ← D.SET_RULE (← q
       r"t SUBSET u /\ (!x. x IN u ==> (P x <=> x IN t))
        ==> t SUBSET {x | x IN u /\ P x}")
      let a12 ← D.NUM_RING (← q
       r"x * y = p * n /\ ~(p * n = 0) ==> (x = n <=> y = p)")
      let a11 ← GROUP_RULE (← q
       r"group_id G = group_mul G g h <=> g = group_inv G h")
      let a10 ← D.TAUT (← q r"p /\ q <=> ~(q ==> ~p)")
      let a9 ← D.TAUT (← q r"p /\ q <=> ~(q ==> ~p)")
      let a8 ← D.TAUT (← q r"p /\ q <=> ~(p ==> ~q)")
      let a7 ← D.SET_RULE (← q
       r"!Q. s'' SUBSET {x | x IN s /\ Q x} /\
            (!x. x IN s ==> f x = f' x) /\
            (!x. x IN s ==> ?x'. x' IN s /\ Q x' /\ f x' = f x) /\
            (!x. x IN s /\ Q x ==> (P(f x) <=> x IN s''))
            ==> {y | y IN IMAGE f s /\ P y} = IMAGE f' s''")
      let a6 ← D.SET_RULE (← q
       r"{f x | x IN u} = {g x | x IN u}
        ==> !a. a IN u ==> ?b. b IN u /\ g b = f a")
      let a5 ← D.NUM_RING (← q r"a * p = p * b <=> p = 0 \/ a = b")
      let a4 ← D.NUMBER_RULE (← q r"(a:num == a) (mod n)")
      let a3 ← D.NUMBER_RULE (← q
       r"!g. (nsum s g == nsum s f) (mod n) /\ nsum s g = z
            ==> (nsum s f == z) (mod n)")
      let a2 ← D.NUMBER_RULE (← q r"m:num = n ==> n divides m")
      let a1 ← D.SET_RULE (← q r"s INTER t = t <=> t SUBSET s")
      pure (REPEAT STRIP_TAC THEN MAP_EVERY ABBREV_TAC
       [(← q r"m = {t:A->bool | t SUBSET group_carrier G /\ t HAS_SIZE p EXP k}"),
        (← q r"a = \x:A. IMAGE (group_mul G x)")] THEN
      SUBGOAL_THEN (← q r"FINITE(m:(A->bool)->bool)") ASSUME_TAC THENL
       [EXPAND_TAC "m" THEN MATCH_MP_TAC FINITE_RESTRICTED_SUBSETS THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"group_action (G:A group) (m:(A->bool)->bool) a")
      ASSUME_TAC THENL
       [MAP_EVERY EXPAND_TAC ["m", "a"] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] GROUP_ACTION_IMAGE_SIZED) THEN
        REWRITE_TAC [GROUP_ACTION_GROUP_TRANSLATION, ETA_AX],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!t. t IN m
            ==> CARD(group_stabilizer G (a:A->(A->bool)->(A->bool)) t)
                divides p EXP k")
      ASSUME_TAC THENL
       [EXPAND_TAC "m" THEN REWRITE_TAC [IN_ELIM_THM, HAS_SIZE] THEN
        X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"t:A->bool") o MATCH_MP
          (← REWRITE_RULE [IMP_CONJ] SUBGROUP_OF_GROUP_STABILIZER)) THEN
        EXPAND_TAC "m" THEN REWRITE_TAC [IN_ELIM_THM, HAS_SIZE] THEN
        ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        MP_TAC (← ISPECL
         [(← q r"subgroup_generated G
              (group_stabilizer G (a:A->(A->bool)->(A->bool)) t)"),
          (← q r"t:A->bool"),
          (← q r"group_mul(G:A group)")]
          GROUP_ORBIT_COMMON_DIVISOR) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
         [MATCH_MP_TAC GROUP_ACTION_ON_SUBSET THEN
          EXISTS_TAC (← q r"group_carrier G:A->bool") THEN
          ASM_SIMP_TAC [GROUP_ACTION_FROM_SUBGROUP,
                       CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                       GROUP_ACTION_GROUP_TRANSLATION] THEN
          EXPAND_TAC "a" THEN
          REWRITE_TAC [group_stabilizer, IN_ELIM_THM] THEN SET_TAC [],
          X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
          SUBGOAL_THEN (← q r"(x:A) IN group_carrier G") ASSUME_TAC THENL
           [ASM SET_TAC [], ALL_TAC] THEN
          MP_TAC (← ISPECL
           [(← q r"subgroup_generated G
              (group_stabilizer G (a:A->(A->bool)->(A->bool)) t)"),
            (← q r"group_carrier G:A->bool"), (← q r"t:A->bool"), (← q r"group_mul(G:A group)")]
            GROUP_ORBIT_ON_SUBSET) THEN
          ASM_SIMP_TAC [GROUP_ORBIT_SUBGROUP_TRANSLATION] THEN
          DISCH_THEN SUBST1_TAC THEN
          SUBGOAL_THEN
           (← q r"t INTER right_coset G (group_stabilizer G a t) x =
            right_coset G (group_stabilizer G (a:A->(A->bool)->(A->bool)) t) x")
          SUBST1_TAC THENL
           [REWRITE_TAC [a1] THEN
            REWRITE_TAC [right_coset, group_setmul, SUBSET, FORALL_IN_GSPEC] THEN
            REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, IN_SING] THEN
            EXPAND_TAC "a" THEN REWRITE_TAC [group_stabilizer] THEN
            REWRITE_TAC [IN_ELIM_THM, FORALL_UNWIND_THM2] THEN ASM SET_TAC [],
            MATCH_MP_TAC a2 THEN
            MATCH_MP_TAC CARD_EQ_CARD_IMP THEN
            ASM_SIMP_TAC [FINITE_GROUP_STABILIZER] THEN
            MATCH_MP_TAC CARD_EQ_RIGHT_COSET_SUBGROUP THEN ASM_MESON_TAC []]],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(!t r. t SUBSET group_carrier G /\ CARD t = r <=>
               t SUBSET group_carrier G /\ t HAS_SIZE r) /\
        (!h r. (h:A->bool) subgroup_of G /\ CARD h = r <=>
               h subgroup_of G /\ h HAS_SIZE r)")
       (fun th => REWRITE_TAC [th]) THENL
        [ASM_MESON_TAC [subgroup_of, HAS_SIZE, FINITE_SUBSET], ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        NSUM_CARD_GROUP_ORBITS)) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC a3 THEN
      EXISTS_TAC (← q r"\s:(A->bool)->bool. if CARD s = n then CARD s else 0") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONG_NSUM THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [a4] THEN
        MP_TAC (← ISPECL
         [(← q r"G:A group"), (← q r"m:(A->bool)->bool"),
          (← q r"a:A->(A->bool)->(A->bool)"), (← q r"t:A->bool")] ORBIT_STABILIZER_MUL) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:A->bool")) THEN ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [DIVIDES_PRIMEPOW] THEN REWRITE_TAC [← SYM (← ASSUME (← q
         r"p EXP k * n = CARD(group_carrier G:A->bool)"))] THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM, LE_LT, IMP_CONJ] THEN
        X_GEN_TAC (← q r"i:num") THEN
        DISCH_THEN (DISJ_CASES_THEN2 ASSUME_TAC SUBST1_TAC) THEN
        DISCH_THEN SUBST1_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LT_EXISTS]) THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"d:num") SUBST1_TAC) THEN
          REWRITE_TAC [EXP_ADD, ← GSYM MULT_ASSOC, EXP],
          ALL_TAC] THEN
        REWRITE_TAC [a5] THEN
        ASM_SIMP_TAC [EXP_EQ_0, PRIME_IMP_NZ] THEN CONV_TAC NUMBER_RULE,
        SIMP_TAC [] THEN REWRITE_TAC [← GSYM NSUM_RESTRICT_SET, SIMPLE_IMAGE] THEN
        ASM_SIMP_TAC [NSUM_CONST, ETA_AX, FINITE_IMAGE, FINITE_RESTRICT]] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      SUBGOAL_THEN
       (← q r"{x | x IN IMAGE (group_orbit G m (a:A->(A->bool)->(A->bool))) m /\
             CARD x = n} =
        IMAGE (\h. {left_coset G x h | x | x IN group_carrier G})
              {h | h subgroup_of G /\ h HAS_SIZE p EXP k}")
      SUBST1_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC CARD_IMAGE_INJ THEN
        ASM_SIMP_TAC [FINITE_RESTRICTED_SUBGROUPS] THEN
        MAP_EVERY X_GEN_TAC [(← q r"h1:A->bool"), (← q r"h2:A->bool")] THEN
        REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o ISPEC (← q r"group_id G:A") o MATCH_MP a6) THEN
        ASM_SIMP_TAC [GROUP_ID, LEFT_COSET_ID, SUBGROUP_OF_IMP_SUBSET] THEN
        ASM_MESON_TAC [SUBGROUP_OF_LEFT_COSET]] THEN
      MATCH_MP_TAC a7 THEN
      EXISTS_TAC (← q r"\t:A->bool. group_id G IN t") THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [EXPAND_TAC "m" THEN REWRITE_TAC [subgroup_of] THEN SET_TAC [],
        ASM_SIMP_TAC [GROUP_ORBIT] THEN EXPAND_TAC "a" THEN
        REWRITE_TAC [o_THM, LEFT_COSET_AS_IMAGE],
        ONCE_REWRITE_TAC [a8] THEN
        ASM_SIMP_TAC [GROUP_ORBIT_EQ] THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP GROUP_ORBIT_SYM_EQ) THEN
        DISCH_THEN (fun th => ONCE_REWRITE_TAC [th]) THEN
        SIMP_TAC [group_orbit, NOT_IMP, CONJ_ASSOC, RIGHT_AND_EXISTS_THM] THEN
        ONCE_REWRITE_TAC [CONJ_SYM] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
        REWRITE_TAC [UNWIND_THM1] THEN
        ONCE_REWRITE_TAC [a9] THEN
        FIRST_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE I [group_action]) THEN
        SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
        EXPAND_TAC "a" THEN REWRITE_TAC [IN_IMAGE] THEN
        ONCE_REWRITE_TAC [a10] THEN EXPAND_TAC "m" THEN
        SIMP_TAC [IN_ELIM_THM, SUBSET, a11] THEN
        REWRITE_TAC [NOT_IMP] THEN X_GEN_TAC (← q r"t:A->bool") THEN
        ASM_CASES_TAC (← q r"t:A->bool = {}") THENL
         [ASM_REWRITE_TAC [HAS_SIZE, CARD_CLAUSES] THEN
          ASM_MESON_TAC [EXP_EQ_0, PRIME_0],
          ASM_MESON_TAC [GROUP_INV, MEMBER_NOT_EMPTY]],
        X_GEN_TAC (← q r"t:A->bool") THEN DISCH_THEN (fun th => tactic_of do
          pure (STRIP_ASSUME_TAC th THEN MP_TAC (← CONJUNCT1 th))) THEN
        EXPAND_TAC "m" THEN
        REWRITE_TAC [IN_ELIM_THM, HAS_SIZE] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN ASM_REWRITE_TAC [← GSYM HAS_SIZE]] THEN
      TRANS_TAC EQ_TRANS
       (← q r"CARD(group_stabilizer G (a:A->(A->bool)->(A->bool)) t) = p EXP k") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC a12 THEN
        ASM_SIMP_TAC [CARD_EQ_0, GROUP_CARRIER_NONEMPTY] THEN
        ASM_SIMP_TAC [ORBIT_STABILIZER_MUL],
        SUBST1_TAC (← SYM (← ASSUME (← q r"CARD(t:A->bool) = p EXP k")))] THEN
      SUBGOAL_THEN (← q r"group_stabilizer G (a:A->(A->bool)->(A->bool)) t SUBSET t")
      ASSUME_TAC THENL
       [EXPAND_TAC "a" THEN
        REWRITE_TAC [group_stabilizer, SUBSET, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:A") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
        REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"group_id G:A") THEN
        ASM_SIMP_TAC [GROUP_MUL_RID],
        ASM_SIMP_TAC [SUBSET_CARD_EQ]] THEN
      EQ_TAC THENL [ASM_MESON_TAC [SUBGROUP_OF_GROUP_STABILIZER], DISCH_TAC] THEN
      MATCH_MP_TAC SUBSET_ANTISYM THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "a" THEN REWRITE_TAC [group_stabilizer] THEN
      MATCH_MP_TAC a13 THEN
      ASM_SIMP_TAC [← GSYM LEFT_COSET_AS_IMAGE, LEFT_COSET_EQ_SUBGROUP]))
    let b1 ← D.NUMBER_RULE (← q
     r"~(n = 0) /\ s = s' /\ t = 1
      ==> (s == t * n) (mod (p * n))
          ==> (s' == t' * n) (mod (p * n))
              ==> (t' == 1) (mod p)")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [divides]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (ASSUME_TAC o SYM)) THEN
    MP_TAC (← ISPECL
     [(← q r"G:A group"), (← q r"p:num"), (← q r"k:num"), (← q r"n:num")] SYLOW_LEMMA) THEN
    MP_TAC (← ISPECL
     [(← q r"integer_mod_group (p EXP k * n)"), (← q r"p:num"), (← q r"k:num"), (← q r"n:num")]
     SYLOW_LEMMA) THEN
    ASM_SIMP_TAC [ORDER_INTEGER_MOD_GROUP, CARD_EQ_0, GROUP_CARRIER_NONEMPTY,
                 FINITE_INTEGER_MOD_GROUP] THEN
    MATCH_MP_TAC b1 THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [MULT_EQ_0, CARD_EQ_0, GROUP_CARRIER_NONEMPTY],
      MATCH_MP_TAC lemma THEN
      ASM_SIMP_TAC [ORDER_INTEGER_MOD_GROUP, CARD_EQ_0, GROUP_CARRIER_NONEMPTY,
                 FINITE_INTEGER_MOD_GROUP],
      ASM_SIMP_TAC [ORDER_INTEGER_MOD_GROUP, FINITE_INTEGER_MOD_GROUP,
                   CYCLIC_GROUP_INTEGER_MOD_GROUP, GROUP_CARRIER_NONEMPTY,
                   CARD_EQ_0, COUNT_FINITE_CYCLIC_GROUP_SUBGROUPS]]))

  -- @@RETURN BEGIN
  return { SYLOW_THEOREM_COUNT_MOD }
  -- @@RETURN END

structure Sylow where
  -- @@FIELDS
  SYLOW_THEOREM : thm
  CAUCHY_GROUP_THEOREM : thm
  PRIME_DIVIDES_GROUP_ORDER : thm
  COPRIME_GROUP_ORDER : thm
  FINITE_PGROUP : thm
  FINITE_PGROUP_SING : thm
  FINITE_AND_PGROUP_SING : thm
  FINITE_GROUP_POW_INJECTIVE_EQ : thm
  FINITE_GROUP_ZPOW_INJECTIVE_EQ : thm
  FINITE_GROUP_POW_SURJECTIVE_EQ : thm
  FINITE_GROUP_ZPOW_SURJECTIVE_EQ : thm
  FINITE_GROUP_ZROOT_EXISTS : thm
  FINITE_GROUP_ROOT_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupSylow [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BPow : Pow) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BGroupElementOrder : GroupElementOrder) (BOrderDecomp : OrderDecomp) (BCyclicGroups3 : CyclicGroups3) (BPgroup : Pgroup) (BSylowCount : SylowCount) :
    ExceptT String IO Sylow := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, .. } := D
  let { CARD_EQ_0, CONJ_ASSOC, .. } := D.core1
  let { CONTRAPOS_THM, COPRIME_PRIME_EQ, DIVIDES_ONE, DIVIDES_PRIME_PRIME,
        DIVIDES_REFL, DIVIDES_TRANS, EXP_1, .. } := D.core2
  let { FINITE_SUBSET, FORALL_INT_CASES, FORALL_IN_IMAGE, HAS_SIZE, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, .. } := D.core4
  let { IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, PRIME_1,
        PRIME_POWER_EXISTS, .. } := D.core6
  let { SUBSET, SURJECTIVE_IFF_INJECTIVE, .. } := D.core7
  let { num_coprime, prime, .. } := D.core8
  let { GROUP_ID, TRIVIAL_GROUP_HAS_SIZE_1, TRIVIAL_GROUP_SUBSET, .. } := BBasics
  let { GROUP_INV_EQ, GROUP_POW, GROUP_POW_ID, .. } := BDerived
  let { GROUP_ZPOW, GROUP_ZPOW_POW, .. } := BPow
  let { FINITE_RESTRICTED_SUBGROUPS, SUBGROUP_OF_IMP_SUBSET, .. } := BSubgroups
  let { SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, FINITE_SUBGROUP_GENERATED, .. } := BSubgroupGen1
  let { GROUP_ELEMENT_ORDER_EQ_1, GROUP_POW_EQ_ID, .. } := BGroupElementOrder
  let { GROUP_ELEMENT_ORDER_SUBGROUP_GENERATED, .. } := BOrderDecomp
  let { GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER, GROUP_POW_CANCEL, .. } := BCyclicGroups3
  let { pgroup, .. } := BPgroup
  let { SYLOW_THEOREM_COUNT_MOD, .. } := BSylowCount
  -- @@SCOPE END

  let SYLOW_THEOREM ← prove
   r"!(G:A group) p k.
          FINITE(group_carrier G) /\
          prime p /\
          p EXP k divides CARD(group_carrier G)
          ==> ?h. h subgroup_of G /\ CARD h = p EXP k"
   (← do
    let a2 ← D.NUMBER_RULE (← q r"(0 == n) (mod p) <=> p divides n")
    let a1 ← D.SET_RULE (← q r"(?x. P x) <=> ~({x | P x} = {})")
    pure (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC I [a1] THEN
    ASM_SIMP_TAC [← GSYM CARD_EQ_0, FINITE_RESTRICTED_SUBGROUPS] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"p:num"), (← q r"k:num")] SYLOW_THEOREM_COUNT_MOD) THEN
    ASM_REWRITE_TAC [a2] THEN
    ASM_MESON_TAC [DIVIDES_ONE, prime]))

  let CAUCHY_GROUP_THEOREM ← prove
   r"!(G:A group) p.
          FINITE(group_carrier G) /\ prime p /\ p divides CARD(group_carrier G)
          ==> ?x. x IN group_carrier G /\ group_element_order G x = p"
   (← do
    let a1 ← D.SET_RULE (← q
     r"~(h SUBSET {a}) ==> ?x. x IN h /\ ~(x = a)")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"p:num"), (← q r"1")] SYLOW_THEOREM) THEN
    ASM_REWRITE_TAC [EXP_1, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:A->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~trivial_group(subgroup_generated G (h:A->bool))") MP_TAC THENL
     [ASM_SIMP_TAC [TRIVIAL_GROUP_HAS_SIZE_1, HAS_SIZE,
                   FINITE_SUBGROUP_GENERATED] THEN
      ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
      ASM_MESON_TAC [PRIME_1],
      ASM_SIMP_TAC [TRIVIAL_GROUP_SUBSET, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                   ← CONJUNCT2 SUBGROUP_GENERATED]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC o MATCH_MP a1) THEN
    SUBGOAL_THEN (← q r"(a:A) IN group_carrier G") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBGROUP_OF_IMP_SUBSET, SUBSET], ALL_TAC] THEN
    MP_TAC (← SPECL [(← q r"subgroup_generated G h:A group"), (← q r"a:A")]
          GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER) THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SUBGROUP_OF_IMP_SUBSET, FINITE_SUBSET],
      REWRITE_TAC [GROUP_ELEMENT_ORDER_SUBGROUP_GENERATED]] THEN
    ASM_MESON_TAC [prime, GROUP_ELEMENT_ORDER_EQ_1]))

  let PRIME_DIVIDES_GROUP_ORDER ← prove
   r"!(G:A group) p.
      FINITE(group_carrier G) /\ prime p
      ==> ((?x. x IN group_carrier G /\ p divides (group_element_order G x)) <=>
           p divides CARD(group_carrier G))"
   (MESON_TAC [GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER,
              CAUCHY_GROUP_THEOREM, DIVIDES_REFL, DIVIDES_TRANS])

  let COPRIME_GROUP_ORDER ← prove
   r"!(G:A group) n.
      FINITE(group_carrier G)
      ==> ((!x. x IN group_carrier G ==> coprime(group_element_order G x,n)) <=>
           coprime(CARD(group_carrier G),n))"
   (REWRITE_TAC [COPRIME_PRIME_EQ] THEN MESON_TAC [PRIME_DIVIDES_GROUP_ORDER])

  let FINITE_PGROUP ← prove
   r"!s (G:A group).
          FINITE(group_carrier G)
          ==> (pgroup s G <=>
               !p. prime p /\ p divides CARD(group_carrier G) ==> p IN s)"
   (REWRITE_TAC [pgroup] THEN
    ASM_MESON_TAC [CAUCHY_GROUP_THEOREM, GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER,
                  DIVIDES_PRIME_PRIME, DIVIDES_TRANS])

  let FINITE_PGROUP_SING ← prove
   r"!(G:A group) p.
       FINITE(group_carrier G) /\ prime p
       ==> (pgroup {p} G <=> ?k. CARD(group_carrier G) = p EXP k)"
   (SIMP_TAC [FINITE_PGROUP, IN_SING] THEN MESON_TAC [PRIME_POWER_EXISTS])

  let FINITE_AND_PGROUP_SING ← prove
   r"!(G:A group) p.
       prime p
       ==> (FINITE(group_carrier G) /\ pgroup {p} G <=>
            ?k. (group_carrier G) HAS_SIZE (p EXP k))"
   (REWRITE_TAC [HAS_SIZE] THEN MESON_TAC [FINITE_PGROUP_SING])

  let FINITE_GROUP_POW_INJECTIVE_EQ ← prove
   r"!(G:A group) n.
          FINITE(group_carrier G)
          ==> ((!x y. x IN group_carrier G /\ y IN group_carrier G /\
                      group_pow G x n = group_pow G y n
                      ==> x = y) <=>
               coprime(n,CARD(group_carrier G)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [GROUP_POW_CANCEL]] THEN
    GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [COPRIME_PRIME_EQ, LEFT_IMP_EXISTS_THM, NOT_FORALL_THM] THEN
    X_GEN_TAC (← q r"p:num") THEN STRIP_TAC THEN REWRITE_TAC [NOT_IMP] THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"p:num")] CAUCHY_GROUP_THEOREM) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN EXISTS_TAC (← q r"group_id G:A") THEN
    ASM_SIMP_TAC [GROUP_POW_ID, GROUP_ID] THEN
    ASM_SIMP_TAC [GROUP_POW_EQ_ID, ← GSYM GROUP_ELEMENT_ORDER_EQ_1] THEN
    ASM_MESON_TAC [PRIME_1])

  let FINITE_GROUP_ZPOW_INJECTIVE_EQ ← prove
   r"!(G:A group) n.
          FINITE(group_carrier G)
          ==> ((!x y. x IN group_carrier G /\ y IN group_carrier G /\
                      group_zpow G x n = group_zpow G y n
                      ==> x = y) <=>
               coprime(n,&(CARD(group_carrier G))))"
   (← do
    let a1 ← D.INTEGER_RULE (← q r"coprime(--x:int,y) <=> coprime(x,y)")
    pure (REWRITE_TAC [FORALL_INT_CASES, GROUP_ZPOW_POW, ← GSYM num_coprime,
                a1] THEN
    SIMP_TAC [IMP_CONJ, GROUP_INV_EQ, GROUP_POW] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC, FINITE_GROUP_POW_INJECTIVE_EQ]))

  let FINITE_GROUP_POW_SURJECTIVE_EQ ← prove
   r"!(G:A group) n.
          FINITE(group_carrier G)
          ==> ((!x. x IN group_carrier G
                    ==> ?y. y IN group_carrier G /\ group_pow G y n = x) <=>
               coprime(n,CARD(group_carrier G)))"
   (REPEAT STRIP_TAC THEN
    wPart lhand (fun t => do lhand (← rand t)) SURJECTIVE_IFF_INJECTIVE THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, GROUP_POW] THEN
    DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC FINITE_GROUP_POW_INJECTIVE_EQ THEN
    ASM_REWRITE_TAC [])

  let FINITE_GROUP_ZPOW_SURJECTIVE_EQ ← prove
   r"!(G:A group) n.
          FINITE(group_carrier G)
          ==> ((!x. x IN group_carrier G
                    ==> ?y. y IN group_carrier G /\ group_zpow G y n = x) <=>
               coprime(n,&(CARD(group_carrier G))))"
   (REPEAT STRIP_TAC THEN
    wPart lhand (fun t => do lhand (← rand t)) SURJECTIVE_IFF_INJECTIVE THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, GROUP_ZPOW] THEN
    DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC FINITE_GROUP_ZPOW_INJECTIVE_EQ THEN
    ASM_REWRITE_TAC [])

  let FINITE_GROUP_ZROOT_EXISTS ← prove
   r"!G n x:A.
          FINITE(group_carrier G) /\
          coprime(n,&(CARD(group_carrier G))) /\
          x IN group_carrier G
          ==> ?y. y IN group_carrier G /\ group_zpow G y n = x"
   (MESON_TAC [FINITE_GROUP_ZPOW_SURJECTIVE_EQ])

  let FINITE_GROUP_ROOT_EXISTS ← prove
   r"!G n x:A.
          FINITE(group_carrier G) /\
          coprime(n,CARD(group_carrier G)) /\
          x IN group_carrier G
          ==> ?y. y IN group_carrier G /\ group_pow G y n = x"
   (MESON_TAC [FINITE_GROUP_POW_SURJECTIVE_EQ])

  -- @@RETURN BEGIN
  return { SYLOW_THEOREM, CAUCHY_GROUP_THEOREM, PRIME_DIVIDES_GROUP_ORDER,
           COPRIME_GROUP_ORDER, FINITE_PGROUP, FINITE_PGROUP_SING,
           FINITE_AND_PGROUP_SING, FINITE_GROUP_POW_INJECTIVE_EQ,
           FINITE_GROUP_ZPOW_INJECTIVE_EQ, FINITE_GROUP_POW_SURJECTIVE_EQ,
           FINITE_GROUP_ZPOW_SURJECTIVE_EQ, FINITE_GROUP_ZROOT_EXISTS,
           FINITE_GROUP_ROOT_EXISTS }
  -- @@RETURN END

structure Powering where
  -- @@FIELDS
  ABELIAN_GROUP_MONOMORPHISM_POWERING_EQ : thm
  ABELIAN_GROUP_MONOMORPHISM_POWERING : thm
  ABELIAN_GROUP_ISOMORPHISM_POWERING_EQ : thm
  ABELIAN_GROUP_ISOMORPHISM_POWERING : thm
  ABELIAN_GROUP_EPIMORPHISM_POWERING_EQ : thm
  ABELIAN_GROUP_EPIMORPHISM_POWERING : thm
  PGROUP_ACTION_FIXPOINTS : thm
  PGROUP_ACTION_FIXPOINT : thm
  deriving Inhabited

@[nospecialize]
def setupPowering [HolBase] (D : GroupTheoryDeps) (BHomomorphisms : Homomorphisms) (BHomomorphisms2 : Homomorphisms2) (BHomomorphisms4 : Homomorphisms4) (BGroupOrbits : GroupOrbits) (BOrbitStabilizer : OrbitStabilizer) (BSylow : Sylow) :
    ExceptT String IO Powering := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, NUMBER_RULE, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARD_EQ_0, CARD_IMAGE_INJ, CONG_NSUM, .. } := D.core1
  let { DIVIDES_PRIMEPOW, DIVIDES_REFL, EXP, .. } := D.core2
  let { FINITE_IMAGE, FINITE_RESTRICT, FORALL_IN_IMAGE, HAS_SIZE, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { LEFT_IMP_EXISTS_THM, MULT_CLAUSES, NSUM_CONST, NSUM_RESTRICT_SET,
        PRIME_DIVEXP_EQ, .. } := D.core6
  let { SIMPLE_IMAGE, .. } := D.core7
  let { group_monomorphism, .. } := BHomomorphisms
  let { GROUP_ISOMORPHISM_EQ_EPIMORPHISM_FINITE,
        GROUP_ISOMORPHISM_EQ_MONOMORPHISM_FINITE, .. } := BHomomorphisms2
  let { ABELIAN_GROUP_HOMOMORPHISM_POWERING, .. } := BHomomorphisms4
  let { FINITE_GROUP_ORBIT, GROUP_ORBIT_EQ_SING_SELF, GROUP_ORBIT_HAS_SIZE_1,
        NSUM_CARD_GROUP_ORBITS, .. } := BGroupOrbits
  let { CARD_GROUP_ORBIT_DIVIDES, .. } := BOrbitStabilizer
  let { FINITE_AND_PGROUP_SING, FINITE_GROUP_POW_INJECTIVE_EQ, .. } := BSylow
  -- @@SCOPE END

  let ABELIAN_GROUP_MONOMORPHISM_POWERING_EQ ← prove
   r"!(G:A group) n.
        abelian_group G /\ FINITE(group_carrier G)
        ==> (group_monomorphism (G,G) (\x. group_pow G x n) <=>
             coprime(n,CARD(group_carrier G)))"
   (SIMP_TAC [group_monomorphism, ABELIAN_GROUP_HOMOMORPHISM_POWERING] THEN
    MESON_TAC [FINITE_GROUP_POW_INJECTIVE_EQ])

  let ABELIAN_GROUP_MONOMORPHISM_POWERING ← prove
   r"!(G:A group) n.
        abelian_group G /\ FINITE(group_carrier G) /\
        coprime(n,CARD(group_carrier G))
        ==> group_monomorphism (G,G) (\x. group_pow G x n)"
   (MESON_TAC [ABELIAN_GROUP_MONOMORPHISM_POWERING_EQ])

  let ABELIAN_GROUP_ISOMORPHISM_POWERING_EQ ← prove
   r"!(G:A group) n.
        abelian_group G /\ FINITE(group_carrier G)
        ==> (group_isomorphism (G,G) (\x. group_pow G x n) <=>
             coprime(n,CARD(group_carrier G)))"
   (ASM_SIMP_TAC [GROUP_ISOMORPHISM_EQ_MONOMORPHISM_FINITE] THEN
    REWRITE_TAC [ABELIAN_GROUP_MONOMORPHISM_POWERING_EQ])

  let ABELIAN_GROUP_ISOMORPHISM_POWERING ← prove
   r"!(G:A group) n.
        abelian_group G /\ FINITE(group_carrier G) /\
        coprime(n,CARD(group_carrier G))
        ==> group_isomorphism (G,G) (\x. group_pow G x n)"
   (MESON_TAC [ABELIAN_GROUP_ISOMORPHISM_POWERING_EQ])

  let ABELIAN_GROUP_EPIMORPHISM_POWERING_EQ ← prove
   r"!(G:A group) n.
        abelian_group G /\ FINITE(group_carrier G)
        ==> (group_epimorphism (G,G) (\x. group_pow G x n) <=>
             coprime(n,CARD(group_carrier G)))"
   (ASM_SIMP_TAC [← GSYM GROUP_ISOMORPHISM_EQ_EPIMORPHISM_FINITE] THEN
    REWRITE_TAC [ABELIAN_GROUP_ISOMORPHISM_POWERING_EQ])

  let ABELIAN_GROUP_EPIMORPHISM_POWERING ← prove
   r"!(G:A group) n.
        abelian_group G /\ FINITE(group_carrier G) /\
        coprime(n,CARD(group_carrier G))
        ==> group_epimorphism (G,G) (\x. group_pow G x n)"
   (MESON_TAC [ABELIAN_GROUP_EPIMORPHISM_POWERING_EQ])

  let PGROUP_ACTION_FIXPOINTS ← prove
   r"!G s (a:A->X->X) p.
        group_action G s a /\ FINITE s /\
        prime p /\ FINITE(group_carrier G) /\ pgroup {p} G
        ==> (CARD {x | x IN s /\ !g. g IN group_carrier G ==> a g x = x} ==
             CARD s) (mod p)"
   (← do
    let a5 ← NUMBER_RULE (← q r"(0 == n) (mod p) <=> p divides n")
    let a4 ← NUMBER_RULE (← q r"(n:num == n) (mod p)")
    let a3 ← TAUT (← q r"p /\ p /\ q <=> p /\ q")
    let a2 ← SET_RULE (← q
     r"{y | y IN IMAGE f s /\ P y} = IMAGE f {x | x IN s /\ P(f x)}")
    let a1 ← NUMBER_RULE (← q
     r"!y:num. x = y /\ (y == z) (mod n) ==> (x == z) (mod n)")
    pure (REPEAT GEN_TAC THEN
    REPLICATE_TAC 3 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_SIMP_TAC [FINITE_AND_PGROUP_SING, HAS_SIZE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM GROUP_ORBIT_HAS_SIZE_1] THEN
    MATCH_MP_TAC a1 THEN
    EXISTS_TAC
     (← q r"nsum {t | t IN {group_orbit G s (a:A->X->X) x | x | x IN s} /\
                t HAS_SIZE 1} (\i. 1)") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_RESTRICT, NSUM_CONST, FINITE_IMAGE] THEN
      REWRITE_TAC [MULT_CLAUSES, a2] THEN
      ASM_SIMP_TAC [GROUP_ORBIT_HAS_SIZE_1, a3] THEN
      CONV_TAC SYM_CONV THEN ASM_SIMP_TAC [← GSYM GROUP_ORBIT_HAS_SIZE_1] THEN
      MATCH_MP_TAC CARD_IMAGE_INJ THEN
      ASM_SIMP_TAC [GROUP_ORBIT_HAS_SIZE_1, FINITE_RESTRICT] THEN
      ASM_SIMP_TAC [← GSYM GROUP_ORBIT_EQ_SING_SELF] THEN SET_TAC [],
      REWRITE_TAC [NSUM_RESTRICT_SET]] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] NSUM_CARD_GROUP_ORBITS)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC CONG_NSUM THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:X") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [HAS_SIZE, FINITE_GROUP_ORBIT] THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"s:X->bool"), (← q r"a:A->X->X"), (← q r"x:X")]
          CARD_GROUP_ORBIT_DIVIDES) THEN
    ASM_SIMP_TAC [DIVIDES_PRIMEPOW, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [a4] THEN
    REWRITE_TAC [a5] THEN
    ASM_SIMP_TAC [PRIME_DIVEXP_EQ, DIVIDES_REFL] THEN ASM_MESON_TAC [EXP]))

  let PGROUP_ACTION_FIXPOINT ← prove
   r"!G s (a:A->X->X) p.
        group_action G s a /\
        prime p /\ FINITE(group_carrier G) /\ pgroup {p} G /\
        FINITE s /\ ~(p divides CARD s)
        ==> ?x. x IN s /\ !g. g IN group_carrier G ==> a g x = x"
   (← do
    let a1 ← NUMBER_RULE (← q
      r"(x == y) (mod p) ==> x = 0 ==> p divides y")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"s:X->bool"), (← q r"a:A->X->X"), (← q r"p:num")]
          PGROUP_ACTION_FIXPOINTS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o MATCH_MP a1) THEN
    ASM_SIMP_TAC [CARD_EQ_0, FINITE_RESTRICT] THEN SET_TAC []))

  -- @@RETURN BEGIN
  return { ABELIAN_GROUP_MONOMORPHISM_POWERING_EQ, ABELIAN_GROUP_MONOMORPHISM_POWERING,
           ABELIAN_GROUP_ISOMORPHISM_POWERING_EQ, ABELIAN_GROUP_ISOMORPHISM_POWERING,
           ABELIAN_GROUP_EPIMORPHISM_POWERING_EQ, ABELIAN_GROUP_EPIMORPHISM_POWERING,
           PGROUP_ACTION_FIXPOINTS, PGROUP_ACTION_FIXPOINT }
  -- @@RETURN END

structure Sylow2 where
  -- @@FIELDS
  SYLOW_THEOREM_CONJUGATE_GEN : thm
  SYLOW_THEOREM_CONJUGATE_SUBSET : thm
  SYLOW_THEOREM_CONJUGATE_ALT : thm
  SYLOW_THEOREM_CONJUGATE : thm
  SYLOW_THEOREM_CONJUGATE_EQ : thm
  SYLOW_THEOREM_PGROUP_SUPERSET : thm
  SYLOW_THEOREM_NORMAL_UNIQUE : thm
  SYLOW_THEOREM_COUNT_NORMALIZER : thm
  SYLOW_THEOREM_COUNT_NORMALIZER_MUL : thm
  SYLOW_THEOREM_NORMAL_UNIQUE_EQ : thm
  SYLOW_THEOREM_UNIQUE : thm
  SYLOW_THEOREM_COUNT_DIVISOR : thm
  deriving Inhabited

@[nospecialize]
def setupSylow2 [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BGroupRule : GroupRule) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGen1 : SubgroupGen1) (BHomomorphisms2 : Homomorphisms2) (BGroupActions : GroupActions) (BCosets : Cosets) (BCosets2 : Cosets2) (BNormalSubgroups : NormalSubgroups) (BConjugate : Conjugate) (BCentralizerNormalizer : CentralizerNormalizer) (BCentralizerNormalizer2 : CentralizerNormalizer2) (BSubgroupCorrespondence : SubgroupCorrespondence) (BSylow : Sylow) (BPowering : Powering) :
    ExceptT String IO Sylow2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, NUMBER_RULE, SET_RULE, TAUT, .. } := D
  let { CARD_EQ_0, CARD_EQ_CARD_IMP, CARD_EQ_SYM, CARD_IMAGE_INJ, CARD_IMAGE_LE,
        CARD_SING, CARD_SUBSET_EQ, CARD_SUBSET_LE, .. } := D.core1
  let { DE_MORGAN_THM, DIVIDES_DIVIDES_DIV, EQ_IMP, EXISTS_IN_GSPEC, EXISTS_UNIQUE,
        EXP_ADD, .. } := D.core2
  let { EXTENSION, FINITE_IMAGE, FINITE_SUBSET, FUN_EQ_THM, HAS_SIZE, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_ELIM_THM, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, MULT_CLAUSES,
        PRIMEPOW_DIVIDES_INDEX, PRIME_1, .. } := D.core6
  let { SIMPLE_IMAGE, SUBSET, .. } := D.core7
  let { o_THM, prime, .. } := D.core8
  let { GROUP_CARRIER_NONEMPTY, GROUP_INV, GROUP_MUL, .. } := BBasics
  let { GROUP_TAC, .. } := BGroupRule
  let { GROUP_CONJUGATION_EQ, IN_IMAGE_GROUP_CONJUGATION, group_conjugation, .. } := BConjugation
  let { IN_SUBGROUP_INV, SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP,
        SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ, .. } := BSubgroupGen1
  let { GROUP_HOMOMORPHISM_CONJUGATION, SUBGROUP_OF_HOMOMORPHIC_IMAGE, .. } := BHomomorphisms2
  let { GROUP_ACTION_FROM_SUBGROUP, .. } := BGroupActions
  let { LEFT_COSET_AS_IMAGE, LEFT_COSET_EQ, LEFT_COSET_LEFT_COSET, .. } := BCosets
  let { GROUP_ACTION_LEFT_COSET_MULTIPLICATION, LAGRANGE_THEOREM,
        LAGRANGE_THEOREM_LEFT, .. } := BCosets2
  let { normal_subgroup_of, .. } := BNormalSubgroups
  let { GROUP_CONJUGATE_IMP_CARD_EQ, group_conjugate, .. } := BConjugate
  let { FINITE_GROUP_NORMALIZER, GROUP_NORMALIZER_SUBSET,
        GROUP_NORMALIZER_SUBSET_CARRIER, NORMAL_SUBGROUP_NORMALIZER_EQ_CARRIER,
        SUBGROUP_GROUP_NORMALIZER, .. } := BCentralizerNormalizer
  let { CARD_CONJUGATE_SUBSETS, CARD_CONJUGATE_SUBSETS_MUL, .. } := BCentralizerNormalizer2
  let { GROUP_CONJUGATE_SUBGROUP_OF, NORMAL_SUBGROUP_CONJUGATE_EQ, .. } := BSubgroupCorrespondence
  let { FINITE_PGROUP_SING, SYLOW_THEOREM, .. } := BSylow
  let { PGROUP_ACTION_FIXPOINT, .. } := BPowering
  -- @@SCOPE END

  let SYLOW_THEOREM_CONJUGATE_GEN ← prove
   r"!(G:A group) p k h j.
        prime p /\
        h subgroup_of G /\
        FINITE {left_coset G x h | x | x IN group_carrier G} /\
        ~(p divides CARD {left_coset G x h | x | x IN group_carrier G}) /\
        j subgroup_of G /\ FINITE j /\ CARD j = p EXP k
        ==> ?a. a IN group_carrier G /\
                j SUBSET IMAGE (group_conjugation G a) h"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"a:A->(A->bool)->(A->bool) = IMAGE o group_mul G") THEN
    SUBGOAL_THEN
     (← q r"group_action (subgroup_generated G j:A group)
                   {left_coset G x h | x | x IN group_carrier G} a")
    MP_TAC THENL
     [MATCH_MP_TAC GROUP_ACTION_FROM_SUBGROUP THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "a" THEN
      MATCH_MP_TAC GROUP_ACTION_LEFT_COSET_MULTIPLICATION THEN
      ASM_SIMP_TAC [SUBGROUP_OF_IMP_SUBSET],
      DISCH_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"p:num") o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] PGROUP_ACTION_FIXPOINT)) THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, FINITE_PGROUP_SING,
                 HAS_SIZE] THEN
    ANTS_TAC THENL [MESON_TAC [], REWRITE_TAC [EXISTS_IN_GSPEC]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:A") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"group_inv G x:A")) THEN
    ASM_SIMP_TAC [IN_SUBGROUP_INV] THEN
    SUBGOAL_THEN (← q r"(x:A) IN group_carrier G") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBGROUP_OF_IMP_SUBSET, SUBSET], ALL_TAC] THEN
    EXPAND_TAC "a" THEN REWRITE_TAC [← GSYM LEFT_COSET_AS_IMAGE, o_THM] THEN
    ASM_SIMP_TAC [LEFT_COSET_LEFT_COSET, SUBGROUP_OF_IMP_SUBSET, GROUP_INV,
                 GROUP_MUL, LEFT_COSET_EQ] THEN
    ASM_SIMP_TAC [IN_IMAGE_GROUP_CONJUGATION, SUBGROUP_OF_IMP_SUBSET] THEN
    REWRITE_TAC [group_conjugation] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN GROUP_TAC)

  let SYLOW_THEOREM_CONJUGATE_SUBSET ← prove
   r"!(G:A group) p k l h j.
        FINITE(group_carrier G) /\ prime p /\
        ~(p EXP (k + 1) divides CARD(group_carrier G)) /\
        h subgroup_of G /\ CARD h = p EXP k /\
        j subgroup_of G /\ CARD j = p EXP l
        ==> ?a. a IN group_carrier G /\
                j SUBSET IMAGE (group_conjugation G a) h"
   (← do
    let a2 ← NUMBER_RULE (← q
     r"m * p EXP k = n /\ p divides m ==> p EXP k * p EXP 1 divides n")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SYLOW_THEOREM_CONJUGATE_GEN THEN
    MAP_EVERY EXISTS_TAC [(← q r"p:num"), (← q r"l:num")] THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE] THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [FINITE_SUBSET, subgroup_of]] THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"h:A->bool")] LAGRANGE_THEOREM_LEFT) THEN
    ASM_REWRITE_TAC [(← TAUT (← q r"p ==> ~q <=> ~(p /\ q)")), ← GSYM SIMPLE_IMAGE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP a2) THEN
    ASM_REWRITE_TAC [← GSYM EXP_ADD]))

  let SYLOW_THEOREM_CONJUGATE_ALT ← prove
   r"!(G:A group) p k h h'.
        FINITE(group_carrier G) /\ prime p /\
        ~(p EXP (k + 1) divides CARD(group_carrier G)) /\
        h subgroup_of G /\ CARD h = p EXP k /\
        h' subgroup_of G /\ CARD h' = p EXP k
        ==> group_conjugate G h h'"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [group_conjugate, SUBGROUP_OF_IMP_SUBSET] THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"p:num"), (← q r"k:num"), (← q r"k:num"), (← q r"h:A->bool"),
                   (← q r"h':A->bool")] SYLOW_THEOREM_CONJUGATE_SUBSET) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARD_SUBSET_LE THEN
    ASM_MESON_TAC [FINITE_IMAGE, FINITE_SUBSET, CARD_IMAGE_LE, subgroup_of])

  let SYLOW_THEOREM_CONJUGATE ← prove
   r"!(G:A group) p k h h'.
        FINITE(group_carrier G) /\ prime p /\
        index p (CARD(group_carrier G)) = k /\
        h subgroup_of G /\ CARD h = p EXP k /\
        h' subgroup_of G /\ CARD h' = p EXP k
        ==> group_conjugate G h h'"
   (← do
    let a1 ← ARITH_RULE (← q r"~(k + 1 <= k)")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SYLOW_THEOREM_CONJUGATE_ALT THEN
    MAP_EVERY EXISTS_TAC [(← q r"p:num"), (← q r"k:num")] THEN ASM_REWRITE_TAC [] THEN
    ASM_REWRITE_TAC [PRIMEPOW_DIVIDES_INDEX, DE_MORGAN_THM] THEN
    ASM_SIMP_TAC [CARD_EQ_0, GROUP_CARRIER_NONEMPTY] THEN
    REWRITE_TAC [a1] THEN ASM_MESON_TAC [PRIME_1]))

  let SYLOW_THEOREM_CONJUGATE_EQ ← prove
   r"!(G:A group) p k h h'.
      FINITE(group_carrier G) /\ prime p /\
      index p (CARD(group_carrier G)) = k /\
      h subgroup_of G /\ CARD h = p EXP k
      ==> (h' subgroup_of G /\ CARD h' = p EXP k <=> group_conjugate G h h')"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [ASM_MESON_TAC [SYLOW_THEOREM_CONJUGATE], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [GROUP_CONJUGATE_SUBGROUP_OF], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP GROUP_CONJUGATE_IMP_CARD_EQ) THEN
    ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
    ASM_MESON_TAC [CARD_EQ_CARD_IMP, FINITE_SUBSET, SUBGROUP_OF_IMP_SUBSET])

  let SYLOW_THEOREM_PGROUP_SUPERSET ← prove
   r"!G p k (h:A->bool).
        FINITE(group_carrier G) /\ prime p /\
        h subgroup_of G /\ CARD h = p EXP k
        ==> ?h'. h' subgroup_of G /\ h SUBSET h' /\
                 CARD h' = p EXP (index p (CARD(group_carrier G)))"
   (← do
    let a1 ← ARITH_RULE (← q r"~(p + 1 <= p)")
    pure (REPEAT STRIP_TAC THEN MP_TAC (← SPECL
     [(← q r"G:A group"), (← q r"p:num"), (← q r"index p (CARD(group_carrier G:A->bool))")]
     SYLOW_THEOREM) THEN
    ASM_REWRITE_TAC [PRIMEPOW_DIVIDES_INDEX, LE_REFL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"p:num"),
                   (← q r"index p (CARD(group_carrier  G:A->bool))"),
                   (← q r"k:num"), (← q r"s:A->bool"), (← q r"h:A->bool")]
          SYLOW_THEOREM_CONJUGATE_SUBSET) THEN
    ASM_REWRITE_TAC [PRIMEPOW_DIVIDES_INDEX, a1] THEN
    ASM_SIMP_TAC [CARD_EQ_0, GROUP_CARRIER_NONEMPTY] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [prime], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (group_conjugation G (a:A)) s") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SUBGROUP_OF_HOMOMORPHIC_IMAGE,
                    GROUP_HOMOMORPHISM_CONJUGATION],
      wPart lhand (fun t => do lhand (← rand t)) CARD_IMAGE_INJ THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_MESON_TAC [GROUP_CONJUGATION_EQ, SUBSET, FINITE_SUBSET, subgroup_of]]))

  let SYLOW_THEOREM_NORMAL_UNIQUE ← prove
   r"!(G:A group) p k h h'.
      FINITE(group_carrier G) /\ prime p /\
      index p (CARD(group_carrier G)) = k /\
      h normal_subgroup_of G /\ CARD h = p EXP k
      ==> (h' subgroup_of G /\ CARD h' = p EXP k <=> h' = h)"
   (MESON_TAC [SYLOW_THEOREM_CONJUGATE_EQ, normal_subgroup_of,
                  NORMAL_SUBGROUP_CONJUGATE_EQ])

  let SYLOW_THEOREM_COUNT_NORMALIZER ← prove
   r"!(G:A group) h p k.
        FINITE(group_carrier G) /\ prime p /\
        index p (CARD(group_carrier G)) = k /\
        h subgroup_of G /\ CARD h = p EXP k
        ==> CARD {h | h subgroup_of G /\ CARD h = p EXP k} =
            CARD(group_carrier G) DIV CARD(group_normalizer G h)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM CARD_CONJUGATE_SUBSETS, SUBGROUP_OF_IMP_SUBSET] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [EXTENSION] THEN GEN_TAC THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC SYLOW_THEOREM_CONJUGATE_EQ THEN
    ASM_REWRITE_TAC [])

  let SYLOW_THEOREM_COUNT_NORMALIZER_MUL ← prove
   r"!(G:A group) h p k.
        FINITE(group_carrier G) /\ prime p /\
        index p (CARD(group_carrier G)) = k /\
        h subgroup_of G /\ CARD h = p EXP k
        ==> CARD {h | h subgroup_of G /\ CARD h = p EXP k} *
            CARD(group_normalizer G h) =
            CARD(group_carrier G)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"h:A->bool")] CARD_CONJUGATE_SUBSETS_MUL) THEN
    ASM_SIMP_TAC [SUBGROUP_OF_IMP_SUBSET] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN GEN_TAC THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC SYLOW_THEOREM_CONJUGATE_EQ THEN
    ASM_REWRITE_TAC [])

  let SYLOW_THEOREM_NORMAL_UNIQUE_EQ ← prove
   r"!G p k h:A->bool.
        FINITE (group_carrier G) /\
        prime p /\
        index p (CARD (group_carrier G)) = k /\
        h subgroup_of G /\
        CARD h = p EXP k
        ==> ((!h'. h' subgroup_of G /\ CARD h' = p EXP k <=> h' = h) <=>
             h normal_subgroup_of G)"
   (← do
    let a1 ← SET_RULE (← q r"(!x. P x <=> x = a) <=> {x | P x} = {a}")
    pure (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [SYLOW_THEOREM_NORMAL_UNIQUE]] THEN
    REWRITE_TAC [a1] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"h:A->bool"), (← q r"p:num"), (← q r"k:num")]
          SYLOW_THEOREM_COUNT_NORMALIZER_MUL) THEN
    ASM_REWRITE_TAC [CARD_SING, MULT_CLAUSES] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [NORMAL_SUBGROUP_NORMALIZER_EQ_CARRIER] THEN
    MATCH_MP_TAC CARD_SUBSET_EQ THEN
    ASM_REWRITE_TAC [GROUP_NORMALIZER_SUBSET_CARRIER]))

  let SYLOW_THEOREM_UNIQUE ← prove
   r"!(G:A group) p k.
        FINITE(group_carrier G) /\
        prime p /\
        index p (CARD(group_carrier G)) = k
        ==> ((?!h. h subgroup_of G /\ CARD h = p EXP k) <=>
             (?h. h normal_subgroup_of G /\ CARD h = p EXP k))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [EXISTS_UNIQUE] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"h:A->bool") THEN
    ASM_CASES_TAC (← q r"CARD(h:A->bool) = p EXP k") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(h:A->bool) subgroup_of G") THENL
     [ALL_TAC, ASM_MESON_TAC [normal_subgroup_of]] THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"p:num"), (← q r"k:num"), (← q r"h:A->bool")]
          SYLOW_THEOREM_NORMAL_UNIQUE_EQ) THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  let SYLOW_THEOREM_COUNT_DIVISOR ← prove
   r"!(G:A group) p k.
        FINITE(group_carrier G) /\ prime p /\
        index p (CARD(group_carrier G)) = k
        ==> CARD {h | h subgroup_of G /\ CARD h = p EXP k}
            divides (CARD(group_carrier G)) DIV (p EXP k)"
   (← do
    let a1 ← NUMBER_RULE (← q r"(p:num) divides n ==> p * m divides m * n")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"p:num"), (← q r"k:num")] SYLOW_THEOREM) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, PRIMEPOW_DIVIDES_INDEX,
                 DIVIDES_DIVIDES_DIV, LE_REFL] THEN
    X_GEN_TAC (← q r"s:A->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"s:A->bool"), (← q r"p:num"), (← q r"k:num")]
          SYLOW_THEOREM_COUNT_NORMALIZER_MUL) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
     MATCH_MP_TAC a1 THEN
    MP_TAC (← ISPECL [(← q r"subgroup_generated G (group_normalizer G s):A group"),
                   (← q r"s:A->bool")] LAGRANGE_THEOREM) THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GROUP_NORMALIZER,
                 SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ] THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC [FINITE_GROUP_NORMALIZER] THEN
    ASM_SIMP_TAC [GROUP_NORMALIZER_SUBSET]))

  -- @@RETURN BEGIN
  return { SYLOW_THEOREM_CONJUGATE_GEN, SYLOW_THEOREM_CONJUGATE_SUBSET,
           SYLOW_THEOREM_CONJUGATE_ALT, SYLOW_THEOREM_CONJUGATE,
           SYLOW_THEOREM_CONJUGATE_EQ, SYLOW_THEOREM_PGROUP_SUPERSET,
           SYLOW_THEOREM_NORMAL_UNIQUE, SYLOW_THEOREM_COUNT_NORMALIZER,
           SYLOW_THEOREM_COUNT_NORMALIZER_MUL, SYLOW_THEOREM_NORMAL_UNIQUE_EQ,
           SYLOW_THEOREM_UNIQUE, SYLOW_THEOREM_COUNT_DIVISOR }
  -- @@RETURN END

structure PGroupCentre where
  -- @@FIELDS
  PGROUP_NONTRIVIAL_CENTRE_GEN : thm
  PGROUP_NONTRIVIAL_CENTRE : thm
  PGROUP_DIVIDES_NORMALIZER_QUOTIENT : thm
  deriving Inhabited

@[nospecialize]
def setupPGroupCentre [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGen1 : SubgroupGen1) (BGroupActions : GroupActions) (BOrbitStabilizer : OrbitStabilizer) (BCosets : Cosets) (BCosets2 : Cosets2) (BCosetProducts : CosetProducts) (BNormalSubgroups : NormalSubgroups) (BCentralizerNormalizer : CentralizerNormalizer) (BSylow : Sylow) (BPowering : Powering) :
    ExceptT String IO PGroupCentre := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, HAS_SIZE_CONV, MESON, MESON_TAC, NUMBER_RULE, SET_RULE, SET_TAC,
        TAUT, basic_ss, .. } := D
  let { CARD_DELETE, CARD_IMAGE_INJ, CARD_SUBSET_EQ, .. } := D.core1
  let { DIVIDES_PRIMEPOW, DIVIDES_SUB_1, EQ_TRANS, EXP, EXP_EQ_0, EXP_EQ_1, .. } := D.core2
  let { FINITE_DELETE, FINITE_IMAGE, FINITE_SUBSET, HAS_SIZE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, .. } := D.core4
  let { IN_DELETE, IN_ELIM_THM, IN_INTER, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, PRIME_1, PRIME_IMP_NZ, .. } := D.core6
  let { SIMPLE_IMAGE, SUBSET, .. } := D.core7
  let { num_INDUCTION, o_THM, .. } := D.core8
  let { GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, TRIVIAL_GROUP_HAS_SIZE_1, trivial_group, .. } := BBasics
  let { GROUP_INV_INV, GROUP_INV_MUL, .. } := BDerived
  let { GROUP_CONJUGATION_EQ, GROUP_CONJUGATION_EQ_ID, GROUP_CONJUGATION_EQ_SELF,
        IMAGE_GROUP_CONJUGATION_BY_INV, group_conjugation, .. } := BConjugation
  let { IN_SUBGROUP_INV, SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP,
        SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ, .. } := BSubgroupGen1
  let { GROUP_ACTION_FROM_SUBGROUP, GROUP_ACTION_ON_SUBSET, .. } := BGroupActions
  let { GROUP_ACTION_CONJUGATION, .. } := BOrbitStabilizer
  let { LEFT_COSET_AS_IMAGE, LEFT_COSET_EQ, LEFT_COSET_LEFT_COSET, .. } := BCosets
  let { GROUP_ACTION_LEFT_COSET_MULTIPLICATION, LAGRANGE_THEOREM,
        LAGRANGE_THEOREM_LEFT_DIV, .. } := BCosets2
  let { LEFT_COSET_SUBGROUP_GENERATED, .. } := BCosetProducts
  let { CARRIER_NORMAL_SUBGROUP_OF, NORMAL_SUBGROUP_CONJUGATION, .. } := BNormalSubgroups
  let { FINITE_GROUP_NORMALIZER, GROUP_NORMALIZER_CONJUGATION, GROUP_NORMALIZER_SUBSET,
        SUBGROUP_GROUP_CENTRALIZER, SUBGROUP_GROUP_NORMALIZER, group_centralizer, .. } := BCentralizerNormalizer
  let { FINITE_PGROUP_SING, .. } := BSylow
  let { PGROUP_ACTION_FIXPOINT, PGROUP_ACTION_FIXPOINTS, .. } := BPowering
  -- @@SCOPE END

  let PGROUP_NONTRIVIAL_CENTRE_GEN ← prove
   r"!G (n:A->bool) p.
        prime p /\ FINITE(group_carrier G) /\ pgroup {p} G /\
        n normal_subgroup_of G /\ ~(n = {group_id G})
        ==> {group_id G} PSUBSET
            (group_centralizer G (group_carrier G) INTER n)"
   (← do
    let a4 ← SET_RULE (← q
     r"z IN s /\ (!x. P x ==> x IN s DELETE z)
        ==> (?x. P x) ==> {z} PSUBSET s")
    let a3 ← MESON [PRIME_1] (← q r"prime p ==> ~(p = 1)")
    let a2 ← NUMBER_RULE (← q r"(p * q == 1) (mod p) <=> p = 1")
    let a1 ← TAUT (← q r"p /\ (p ==> q ==> r) ==> (p ==> q) ==> r")
    pure (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [(← q r"G:A group"), (← q r"n DELETE (group_id G:A)"),
      (← q r"group_conjugation (G:A group)"), (← q r"p:num")]
          PGROUP_ACTION_FIXPOINT) THEN
    ASM_SIMP_TAC [HAS_SIZE, FINITE_DELETE, CARD_DELETE, IMP_CONJ] THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id
     [NORMAL_SUBGROUP_CONJUGATION]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SUBGROUP_OF_IMP_SUBSET) THEN ANTS_TAC THENL
     [MATCH_MP_TAC GROUP_ACTION_ON_SUBSET THEN
      EXISTS_TAC (← q r"group_carrier G:A->bool") THEN
      REWRITE_TAC [GROUP_ACTION_CONJUGATION] THEN
      CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_DELETE]] THEN
      MAP_EVERY X_GEN_TAC [(← q r"a:A"), (← q r"x:A")] THEN STRIP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [GROUP_CONJUGATION_EQ_ID] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC a1 THEN
    CONJ_TAC THENL [ASM_MESON_TAC [FINITE_SUBSET], DISCH_TAC] THEN ANTS_TAC THENL
     [UNDISCH_TAC (← q r"pgroup {p} (G:A group)") THEN
      ASM_SIMP_TAC [FINITE_PGROUP_SING] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [subgroup_of]) THEN
      ASM_SIMP_TAC [DIVIDES_SUB_1] THEN DISCH_THEN (K ALL_TAC) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ_ALT] LAGRANGE_THEOREM)) THEN
      ASM_SIMP_TAC [DIVIDES_PRIMEPOW, LEFT_IMP_EXISTS_THM] THEN
      ASM_SIMP_TAC [EXP_EQ_0, PRIME_IMP_NZ] THEN MATCH_MP_TAC num_INDUCTION THEN
      SIMP_TAC [EXP, a2] THEN
      ASM_SIMP_TAC [a3] THEN
      DISCH_THEN (ASSUME_TAC o CONJUNCT2) THEN DISCH_THEN (K ALL_TAC) THEN
      SUBGOAL_THEN (← q r"(n:A->bool) HAS_SIZE 1") MP_TAC THENL
       [ASM_REWRITE_TAC [HAS_SIZE], CONV_TAC (LAND_CONV HAS_SIZE_CONV)] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of]) THEN ASM SET_TAC [],
      MATCH_MP_TAC a4 THEN
      REWRITE_TAC [IN_DELETE, IN_INTER] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [subgroup_of, SUBGROUP_GROUP_CENTRALIZER], ALL_TAC] THEN
      X_GEN_TAC (← q r"x:A") THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      REWRITE_TAC [group_centralizer, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [GROUP_CONJUGATION_EQ_SELF]]))

  let PGROUP_NONTRIVIAL_CENTRE ← prove
   r"!(G:A group) p k.
        prime p /\ ~(k = 0) /\ (group_carrier G) HAS_SIZE (p EXP k)
        ==> {group_id G} PSUBSET (group_centralizer G (group_carrier G))"
   (REWRITE_TAC [HAS_SIZE] THEN REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [(← q r"G:A group"), (← q r"group_carrier G:A->bool"), (← q r"p:num")]
     PGROUP_NONTRIVIAL_CENTRE_GEN) THEN
    ASM_SIMP_TAC [FINITE_PGROUP_SING, CARRIER_NORMAL_SUBGROUP_OF] THEN
    ASM_REWRITE_TAC [← GSYM trivial_group, TRIVIAL_GROUP_HAS_SIZE_1, HAS_SIZE] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [EXP_EQ_1, PRIME_1], ALL_TAC] THEN
    REWRITE_TAC [group_centralizer] THEN SET_TAC [])

  let PGROUP_DIVIDES_NORMALIZER_QUOTIENT ← prove
   r"!G p k h:A->bool.
        FINITE(group_carrier G) /\
        prime p /\
        h subgroup_of G /\ CARD h = p EXP k /\
        p divides CARD(group_carrier G) DIV CARD h
        ==> p divides CARD(group_normalizer G h) DIV CARD h"
   (← do
    let a4 ← SET_RULE (← q
     r"(!x. x IN s ==> f x = g x) /\
        (IMAGE g s SUBSET s ==> IMAGE g s = s)
        ==> ((!x. x IN s ==> f x IN s) <=> IMAGE g s = s)")
    let a3 ← MESON [IN_SUBGROUP_INV, subgroup_of, SUBSET, GROUP_INV_INV] (← q
     r"h subgroup_of G /\ ((!x. x IN h ==> P(group_inv G x)) <=> Q)
        ==> ((!x. x IN h ==> P x) <=> Q)")
    let a2 ← SET_RULE (← q
     r"(!x. P x /\ R(f x) <=> Q x)
        ==> {y | y IN {f x | P x} /\ R y} = {f x | Q x}")
    let a1 ← NUMBER_RULE (← q
     r"p divides y /\ x:num = z ==> (x == y) (mod p) ==> p divides z")
    let ss1 ← ExceptT.mk (basic_ss [])
    pure (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"FINITE(h:A->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [subgroup_of, FINITE_SUBSET], ALL_TAC] THEN
    ABBREV_TAC (← q r"a:A->(A->bool)->(A->bool) = IMAGE o group_mul G") THEN
    SUBGOAL_THEN
     (← q r"group_action (subgroup_generated G h:A group)
                   {left_coset G x h | x | x IN group_carrier G} a")
    MP_TAC THENL
     [MATCH_MP_TAC GROUP_ACTION_FROM_SUBGROUP THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "a" THEN
      MATCH_MP_TAC GROUP_ACTION_LEFT_COSET_MULTIPLICATION THEN
      ASM_SIMP_TAC [SUBGROUP_OF_IMP_SUBSET],
      DISCH_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"p:num") o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] PGROUP_ACTION_FIXPOINTS)) THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, FINITE_PGROUP_SING] THEN
    ASM_SIMP_TAC [LAGRANGE_THEOREM_LEFT_DIV] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE] THEN MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC a1 THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    TRANS_TAC EQ_TRANS
     (← q r"CARD { left_coset (subgroup_generated G (group_normalizer G h)) x h |x|
             (x:A) IN group_carrier
                       (subgroup_generated G (group_normalizer G h))}") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [LEFT_COSET_SUBGROUP_GENERATED] THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_OF_IMP_SUBSET,
                  SUBGROUP_GROUP_NORMALIZER, GROUP_NORMALIZER_CONJUGATION] THEN
      MATCH_MP_TAC a2 THEN
      X_GEN_TAC (← q r"x:A") THEN ASM_CASES_TAC (← q r"(x:A) IN group_carrier G") THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN EXPAND_TAC "a" THEN
      REWRITE_TAC [o_THM, ← GSYM LEFT_COSET_AS_IMAGE] THEN
      MATCH_MP_TAC a3 THEN
      SUBGOAL_THEN (← q r"!x:A. x IN h ==> x IN group_carrier G") MP_TAC THENL
       [ASM_MESON_TAC [SUBSET, subgroup_of], ALL_TAC] THEN
      ASM (simpTac ss1 4)
       [LEFT_COSET_LEFT_COSET, LEFT_COSET_EQ, GROUP_MUL, GROUP_INV, GROUP_INV_INV,
        SUBGROUP_OF_IMP_SUBSET, GROUP_INV_MUL, ← GSYM GROUP_MUL_ASSOC] THEN
      DISCH_TAC THEN
      wPart rand (fun t => do rand (← rand t))
        IMAGE_GROUP_CONJUGATION_BY_INV THEN
      ASM_SIMP_TAC [SUBGROUP_OF_IMP_SUBSET] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC a4 THEN CONJ_TAC
      THENL [ASM_SIMP_TAC [group_conjugation, GROUP_INV_INV], DISCH_TAC] THEN
      MATCH_MP_TAC CARD_SUBSET_EQ THEN
      REPEAT (CONJ_TAC THENL [FIRST_X_ASSUM ACCEPT_TAC, ALL_TAC]) THEN
      MATCH_MP_TAC CARD_IMAGE_INJ THEN
      ASM_MESON_TAC [GROUP_CONJUGATION_EQ, GROUP_INV],
      wPart lhand (fun t => do lhand (← rand t)) LAGRANGE_THEOREM_LEFT_DIV THEN
      ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP, GROUP_NORMALIZER_SUBSET,
                   SUBGROUP_GROUP_NORMALIZER, FINITE_GROUP_NORMALIZER,
                   SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ]]))

  -- @@RETURN BEGIN
  return { PGROUP_NONTRIVIAL_CENTRE_GEN, PGROUP_NONTRIVIAL_CENTRE,
           PGROUP_DIVIDES_NORMALIZER_QUOTIENT }
  -- @@RETURN END

structure PgroupNormalizer where
  -- @@FIELDS
  PGROUP_SUBGROUP_PSUBSET_NORMALIZER : thm
  PGROUP_MAXIMAL_NORMAL_SUBGROUP_OF : thm
  PGROUP_FRATTINI : thm
  PGROUP_SELF_NORMALIZER : thm
  PGROUP_NORMALIZER_NORMALIZER : thm
  deriving Inhabited

@[nospecialize]
def setupPgroupNormalizer [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BConjugation : Conjugation) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BHomomorphisms2 : Homomorphisms2) (BSetwise1 : Setwise1) (BSetwise2 : Setwise2) (BCosets2 : Cosets2) (BCosetProducts : CosetProducts) (BNormalSubgroups : NormalSubgroups) (BConjugate : Conjugate) (BCentralizerNormalizer : CentralizerNormalizer) (BSylow : Sylow) (BSylow2 : Sylow2) (BPGroupCentre : PGroupCentre) :
    ExceptT String IO PgroupNormalizer := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, NUMBER_RULE, SET_TAC, .. } := D
  let { CARD_EQ_0, CARD_IMAGE_INJ, CARD_SUBSET_EQ, .. } := D.core1
  let { DIVIDES_INDEX, DIVIDES_ONE, DIVIDES_PRIMEPOW, DIV_MULT, DIV_REFL, EXP, EXP_ADD,
        EXP_EQ_0, .. } := D.core2
  let { FINITE_SUBSET, .. } := D.core3
  let { IMAGE_SUBSET, IMP_CONJ, .. } := D.core4
  let { IN_ELIM_THM, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, LE_ANTISYM, LE_INDEX, LE_LT, LT_EXISTS, NOT_IMP, PRIME_0,
        PRIME_1, PSUBSET, .. } := D.core6
  let { SUBSET, SUBSET_ANTISYM, SUBSET_REFL, SUBSET_TRANS, .. } := D.core7
  let { GROUP_CARRIER_NONEMPTY, GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_RID,
        GROUP_MUL_RINV, .. } := BBasics
  let { FORALL_IN_GROUP_CARRIER_INV, .. } := BDerived
  let { GROUP_CONJUGATION_EQ, IMAGE_GROUP_CONJUGATION_BY_INV,
        IMAGE_GROUP_CONJUGATION_BY_MUL, IMAGE_GROUP_CONJUGATION_SUBSET, .. } := BConjugation
  let { IN_SUBGROUP_INV, SUBGROUP_OF_IMP_NONEMPTY, SUBGROUP_OF_IMP_SUBSET, subgroup_of, .. } := BSubgroups
  let { GROUP_CONJUGATION_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP,
        SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ, .. } := BSubgroupGen1
  let { GROUP_HOMOMORPHISM_CONJUGATION, SUBGROUP_OF_HOMOMORPHIC_IMAGE, .. } := BHomomorphisms2
  let { GROUP_SETMUL, GROUP_SETMUL_MONO, group_setmul, .. } := BSetwise1
  let { GROUP_SETMUL_SUBGROUP, .. } := BSetwise2
  let { LAGRANGE_THEOREM, .. } := BCosets2
  let { GROUP_SETMUL_SUBGROUP_GENERATED, .. } := BCosetProducts
  let { CARRIER_NORMAL_SUBGROUP_OF, NORMAL_SUBGROUP_CONJUGATION,
        NORMAL_SUBGROUP_IMP_SUBGROUP, NORMAL_SUBGROUP_OF_IMP_SUBSET,
        normal_subgroup_of, .. } := BNormalSubgroups
  let { group_conjugate, .. } := BConjugate
  let { GROUP_NORMALIZER_CONJUGATION, GROUP_NORMALIZER_SUBGROUP_GENERATED,
        GROUP_NORMALIZER_SUBSET, GROUP_NORMALIZER_SUBSET_CARRIER,
        NORMAL_SUBGROUP_NORMALIZER_EQ_CARRIER, NORMAL_SUBGROUP_OF_NORMALIZER,
        SUBGROUP_GROUP_NORMALIZER, .. } := BCentralizerNormalizer
  let { FINITE_PGROUP_SING, .. } := BSylow
  let { SYLOW_THEOREM_CONJUGATE, .. } := BSylow2
  let { PGROUP_DIVIDES_NORMALIZER_QUOTIENT, .. } := BPGroupCentre
  -- @@SCOPE END

  let PGROUP_SUBGROUP_PSUBSET_NORMALIZER ← prove
   r"!G p h:A->bool.
        prime p /\ FINITE(group_carrier G) /\ pgroup {p} G /\
        h subgroup_of G /\ ~(h = group_carrier G)
        ==> h PSUBSET group_normalizer G h"
   (SIMP_TAC [IMP_CONJ, FINITE_PGROUP_SING] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"h:A->bool")] LAGRANGE_THEOREM) THEN
    ASM_SIMP_TAC [DIVIDES_PRIMEPOW, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [LE_LT] THEN STRIP_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [CARD_SUBSET_EQ, subgroup_of]] THEN
    ASM_SIMP_TAC [PSUBSET, GROUP_NORMALIZER_SUBSET] THEN
    DISCH_THEN (ASSUME_TAC o SYM) THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"p:num"), (← q r"i:num"), (← q r"h:A->bool")]
          PGROUP_DIVIDES_NORMALIZER_QUOTIENT) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN
    SUBGOAL_THEN (← q r"~(p = 0) /\ ~(p = 1)") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [PRIME_0, PRIME_1], ALL_TAC] THEN
    ASM_SIMP_TAC [DIV_REFL, EXP_EQ_0, DIVIDES_ONE] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LT_EXISTS]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:num") SUBST1_TAC) THEN
    ASM_SIMP_TAC [EXP_ADD, DIV_MULT, EXP_EQ_0, EXP] THEN
    CONV_TAC NUMBER_RULE)

  let PGROUP_MAXIMAL_NORMAL_SUBGROUP_OF ← prove
   r"!G p h:A->bool.
        prime p /\ FINITE(group_carrier G) /\ pgroup {p} G /\
        h subgroup_of G /\
        (!h'. h' subgroup_of G /\ h PSUBSET h' ==> h' = group_carrier G)
        ==> h normal_subgroup_of G"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"h:A->bool = group_carrier G") THEN
    ASM_REWRITE_TAC [CARRIER_NORMAL_SUBGROUP_OF] THEN
    ASM_REWRITE_TAC [NORMAL_SUBGROUP_NORMALIZER_EQ_CARRIER] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [SUBGROUP_GROUP_NORMALIZER] THEN
    MATCH_MP_TAC PGROUP_SUBGROUP_PSUBSET_NORMALIZER THEN ASM_MESON_TAC [])

  let PGROUP_FRATTINI ← prove
   r"!(G:A group) p k h j.
        prime p /\
        FINITE j /\ j normal_subgroup_of G /\
        h SUBSET j /\ h subgroup_of G /\
        index p (CARD j) = k /\ CARD h = p EXP k
        ==> group_setmul G (group_normalizer G h) j = group_carrier G"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [GROUP_SETMUL, GROUP_NORMALIZER_SUBSET_CARRIER,
                 NORMAL_SUBGROUP_OF_IMP_SUBSET] THEN
    REWRITE_TAC [SUBSET] THEN
    GEN_REWRITE_TAC I [← GSYM FORALL_IN_GROUP_CARRIER_INV] THEN
    X_GEN_TAC (← q r"g:A") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [(← q r"subgroup_generated G (j:A->bool)"), (← q r"p:num"), (← q r"k:num"),
      (← q r"h:A->bool"), (← q r"IMAGE (group_conjugation G (g:A)) h")]
          SYLOW_THEOREM_CONJUGATE) THEN
    ASM_SIMP_TAC [group_conjugate, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                 NORMAL_SUBGROUP_IMP_SUBGROUP,
                 SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ,
                 GROUP_CONJUGATION_SUBGROUP_GENERATED] THEN
    ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [SUBGROUP_OF_HOMOMORPHIC_IMAGE,
                      GROUP_HOMOMORPHISM_CONJUGATION],
        ASM_MESON_TAC [NORMAL_SUBGROUP_CONJUGATION, IMAGE_SUBSET, SUBSET_TRANS],
        wPart lhand (fun t => do lhand (← rand t)) CARD_IMAGE_INJ THEN
        ASM_MESON_TAC [GROUP_CONJUGATION_EQ, SUBSET, subgroup_of, FINITE_SUBSET]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:A") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(x:A) IN group_carrier G") ASSUME_TAC THENL
       [ASM_MESON_TAC [SUBSET, normal_subgroup_of, subgroup_of], ALL_TAC] THEN
      REWRITE_TAC [group_setmul, IN_ELIM_THM] THEN
      MAP_EVERY EXISTS_TAC
       [(← q r"group_mul G (group_inv G g) x:A"), (← q r"group_inv G x:A")] THEN
      ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL_RINV, GROUP_MUL_RID,
                   GROUP_INV, GROUP_MUL] THEN
      CONJ_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [normal_subgroup_of, IN_SUBGROUP_INV]] THEN
      ASM_SIMP_TAC [GROUP_NORMALIZER_CONJUGATION, SUBGROUP_OF_IMP_SUBSET] THEN
      ASM_SIMP_TAC [IN_ELIM_THM, GROUP_INV, GROUP_MUL,
                  IMAGE_GROUP_CONJUGATION_BY_MUL,
                  SUBGROUP_OF_IMP_SUBSET] THEN
      ASM_SIMP_TAC [IMAGE_GROUP_CONJUGATION_BY_INV, GROUP_INV,
                   SUBGROUP_OF_IMP_SUBSET, IMAGE_GROUP_CONJUGATION_SUBSET]])

  let PGROUP_SELF_NORMALIZER ← prove
   r"!G p k s h:A->bool.
        FINITE(group_carrier G) /\
        prime p /\
        index p (CARD(group_carrier G)) = k /\
        s subgroup_of G /\ CARD s = p EXP k /\
        h subgroup_of G /\ group_normalizer G s SUBSET h
        ==> group_normalizer G h = h"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [GROUP_NORMALIZER_SUBSET] THEN
    MP_TAC (← ISPECL [(← q r"subgroup_generated G (group_normalizer G (h:A->bool))"),
                   (← q r"p:num"), (← q r"k:num"), (← q r"s:A->bool"),
                   (← q r"h:A->bool")]
          PGROUP_FRATTINI) THEN
    ASM_REWRITE_TAC [NORMAL_SUBGROUP_OF_NORMALIZER] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [FINITE_SUBSET, subgroup_of],
        ASM_MESON_TAC [GROUP_NORMALIZER_SUBSET, SUBSET_TRANS],
        ASM_SIMP_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ,
                     SUBGROUP_GROUP_NORMALIZER] THEN
        ASM_MESON_TAC [GROUP_NORMALIZER_SUBSET, SUBSET_TRANS],
        REWRITE_TAC [← GSYM LE_ANTISYM] THEN CONJ_TAC THENL
         [MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"h:A->bool")] LAGRANGE_THEOREM) THEN
          ASM_REWRITE_TAC [DIVIDES_INDEX] THEN
          ASM_SIMP_TAC [CARD_EQ_0, GROUP_CARRIER_NONEMPTY] THEN ASM_MESON_TAC [],
          MP_TAC (← ISPECL [(← q r"subgroup_generated G h:A group"), (← q r"s:A->bool")]
            LAGRANGE_THEOREM) THEN
          ASM_SIMP_TAC [SUBGROUP_OF_SUBGROUP_GENERATED_SUBGROUP_EQ,
                       CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
          ANTS_TAC THENL
           [ASM_MESON_TAC [FINITE_SUBSET, subgroup_of, GROUP_NORMALIZER_SUBSET,
                          SUBSET_TRANS],
            SIMP_TAC [LE_INDEX] THEN
            ASM_MESON_TAC [PRIME_1, CARD_EQ_0, FINITE_SUBSET, subgroup_of,
                          SUBGROUP_OF_IMP_NONEMPTY]]]],
      REWRITE_TAC [GROUP_SETMUL_SUBGROUP_GENERATED] THEN
      ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                   SUBGROUP_GROUP_NORMALIZER] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← SYM (← MATCH_MP GROUP_SETMUL_SUBGROUP th)])) THEN
      MATCH_MP_TAC GROUP_SETMUL_MONO THEN REWRITE_TAC [SUBSET_REFL] THEN
      TRANS_TAC SUBSET_TRANS (← q r"group_normalizer G s:A->bool") THEN
      ASM_REWRITE_TAC [] THEN
      wPart lhand (fun t => do lhand (← rand t)) GROUP_NORMALIZER_SUBGROUP_GENERATED THEN
      ANTS_TAC THENL [ALL_TAC, SET_TAC []] THEN
      REWRITE_TAC [SUBGROUP_GROUP_NORMALIZER] THEN
      ASM_MESON_TAC [GROUP_NORMALIZER_SUBSET, SUBSET_TRANS]])

  let PGROUP_NORMALIZER_NORMALIZER ← prove
   r"!G p k h:A->bool.
        FINITE(group_carrier G) /\
        prime p /\
        index p (CARD(group_carrier G)) = k /\
        h subgroup_of G /\ CARD h = p EXP k
        ==> group_normalizer G (group_normalizer G h) = group_normalizer G h"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PGROUP_SELF_NORMALIZER THEN
    MAP_EVERY EXISTS_TAC [(← q r"p:num"), (← q r"k:num"), (← q r"h:A->bool")] THEN
    ASM_REWRITE_TAC [SUBSET_REFL, SUBGROUP_GROUP_NORMALIZER])

  -- @@RETURN BEGIN
  return { PGROUP_SUBGROUP_PSUBSET_NORMALIZER, PGROUP_MAXIMAL_NORMAL_SUBGROUP_OF,
           PGROUP_FRATTINI, PGROUP_SELF_NORMALIZER, PGROUP_NORMALIZER_NORMALIZER }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Theorems related to "internal" direct sums.                               -/
/- ------------------------------------------------------------------------- -/

structure GroupDisjointSum where
  -- @@FIELDS
  GROUP_DISJOINT_SUM_ALT : thm
  GROUP_DISJOINT_SUM_ID : thm
  GROUP_DISJOINT_SUM_CANCEL : thm
  GROUP_SUM_COMMUTING_IMP_NORMAL : thm
  GROUP_SUM_NORMAL_IMP_COMMUTING : thm
  GROUP_SUM_NORMAL_EQ_COMMUTING : thm
  deriving Inhabited

@[nospecialize]
def setupGroupDisjointSum [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BGroupRule : GroupRule) (BSubgroups : Subgroups) (BSetwise1 : Setwise1) (BCosets : Cosets) (BNormalSubgroups : NormalSubgroups) :
    ExceptT String IO GroupDisjointSum := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { EQ_TRANS, .. } := D.core2
  let { FORALL_IN_GSPEC, FORALL_UNWIND_THM2, .. } := D.core3
  let { IMP_CONJ, IMP_IMP, .. } := D.core4
  let { IN_ELIM_THM, IN_INTER, IN_SING, .. } := D.core5
  let { NOT_INSERT_EMPTY, .. } := D.core6
  let { RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, UNWIND_THM2, .. } := D.core7
  let { GROUP_ID, GROUP_INV, GROUP_MUL_LID, .. } := BBasics
  let { GROUP_DIV, GROUP_DIV_EQ_ID, GROUP_INV_EQ_ID, GROUP_INV_INV, GROUP_LINV_EQ,
        group_div, .. } := BDerived
  let { GROUP_RULE, .. } := BGroupRule
  let { subgroup_of, .. } := BSubgroups
  let { GROUP_SETMUL, GROUP_SETMUL_ASSOC, GROUP_SETMUL_LSUBSET, GROUP_SETMUL_RSUBSET,
        GROUP_SETMUL_SING, group_setmul, .. } := BSetwise1
  let { left_coset, right_coset, .. } := BCosets
  let { NORMAL_SUBGROUP_IMP_SUBGROUP, normal_subgroup_of, .. } := BNormalSubgroups
  -- @@SCOPE END

  let GROUP_DISJOINT_SUM_ALT ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> (g INTER h SUBSET {group_id G} <=> g INTER h = {group_id G})"
   (REWRITE_TAC [subgroup_of] THEN SET_TAC [])

  let GROUP_DISJOINT_SUM_ID ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> (g INTER h SUBSET {group_id G} <=>
             !x y. x IN g /\ y IN h /\ group_mul G x y = group_id G
                   ==> x = group_id G /\ y = group_id G)"
   (REWRITE_TAC [SUBSET, IN_INTER, IN_SING, subgroup_of] THEN
    REPEAT STRIP_TAC THEN TRANS_TAC EQ_TRANS
     (← q r"!x y:A. x IN g /\ y IN h /\ group_mul G x (group_inv G y) = group_id G
              ==> x = group_id G /\ group_inv G y = group_id G") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [← GSYM group_div, GROUP_DIV_EQ_ID,
                   GROUP_INV_EQ_ID, IMP_CONJ] THEN
      MESON_TAC [],
      ASM_MESON_TAC [GROUP_INV_INV]])

  let GROUP_DISJOINT_SUM_CANCEL ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> (g INTER h SUBSET {group_id G} <=>
             !x x' y y'. x IN g /\ x' IN g /\ y IN h /\ y' IN h /\
                         group_mul G x y = group_mul G x' y'
                         ==> x = x' /\ y = y')"
   (SIMP_TAC [GROUP_DISJOINT_SUM_ID] THEN
    REWRITE_TAC [SUBSET, subgroup_of] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THEN DISCH_TAC THENL
     [MAP_EVERY X_GEN_TAC [(← q r"x:A"), (← q r"x':A"), (← q r"y:A"), (← q r"y':A")] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [(← q r"group_mul G (group_inv G x') x:A"), (← q r"group_div G y y':A")]) THEN
      ASM_SIMP_TAC [GROUP_DIV_EQ_ID, GROUP_INV_EQ_ID, GROUP_DIV] THEN
      ASM_SIMP_TAC [← GSYM GROUP_LINV_EQ, GROUP_INV, GROUP_INV_INV] THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      FIRST_X_ASSUM (MP_TAC o AP_TERM
      (← q r"\z:A. group_mul G (group_inv G x') (group_mul G z (group_inv G y'))")) THEN
      (← do
        let a1 ← GROUP_RULE (← q
         r"group_mul G (group_inv G x)
             (group_mul G (group_mul G x y) (group_inv G y)) = group_id G")
        pure (ASM_SIMP_TAC [a1] THEN
         ASM_SIMP_TAC [group_div] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
         W (fun (_asl, w) => tactic_of do
               let th ← GROUP_RULE w
               pure (ASM_SIMP_TAC [th])))),
      MAP_EVERY X_GEN_TAC [(← q r"x:A"), (← q r"y:A")] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [(← q r"x:A"), (← q r"group_id G:A"), (← q r"y:A"), (← q r"group_id G:A")]) THEN
      ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_ID]])

  let GROUP_SUM_COMMUTING_IMP_NORMAL ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G /\
        group_carrier G SUBSET group_setmul G g h /\
        (!x y. x IN g /\ y IN h ==> group_mul G x y = group_mul G y x)
        ==> g normal_subgroup_of G /\ h normal_subgroup_of G"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [normal_subgroup_of] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:A") o GEN_REWRITE_RULE I [SUBSET]) THEN
    ASM_REWRITE_TAC [group_setmul] THEN SPEC_TAC ((← q r"a:A"), (← q r"a:A")) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, left_coset, right_coset] THEN
    MAP_EVERY X_GEN_TAC [(← q r"x:A"), (← q r"y:A")] THEN STRIP_TAC THEN
    (SUBGOAL_THEN (← q r"(x:A) IN group_carrier G /\ y IN group_carrier G /\
                  g SUBSET group_carrier G /\ h SUBSET group_carrier G")
     STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [subgroup_of, SUBSET], ALL_TAC]) THEN
    REWRITE_TAC [← GSYM GROUP_SETMUL_SING] THENL
     [ASM_SIMP_TAC [GROUP_SETMUL_ASSOC, GROUP_SETMUL, SING_SUBSET] THEN
      TRANS_TAC EQ_TRANS (← q r"group_setmul G (group_setmul G {x:A} g) {y}") THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [← GSYM GROUP_SETMUL_ASSOC, GROUP_SETMUL, SING_SUBSET] THEN
        AP_TERM_TAC THEN REWRITE_TAC [group_setmul] THEN ASM SET_TAC [],
        AP_THM_TAC THEN AP_TERM_TAC THEN
        ASM_SIMP_TAC [GROUP_SETMUL_LSUBSET, GROUP_SETMUL_RSUBSET,
                     SING_SUBSET, NOT_INSERT_EMPTY]],

      ASM_SIMP_TAC [GROUP_SETMUL_ASSOC, GROUP_SETMUL, SING_SUBSET] THEN
      TRANS_TAC EQ_TRANS (← q r"group_setmul G (group_setmul G {x:A} h) {y}") THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [← GSYM GROUP_SETMUL_ASSOC, GROUP_SETMUL, SING_SUBSET] THEN
        ASM_SIMP_TAC [GROUP_SETMUL_LSUBSET, GROUP_SETMUL_RSUBSET,
                     SING_SUBSET, NOT_INSERT_EMPTY],
        AP_THM_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [group_setmul] THEN ASM SET_TAC []]])

  let GROUP_SUM_NORMAL_IMP_COMMUTING ← prove
   r"!G g h:A->bool.
        g normal_subgroup_of G /\ h normal_subgroup_of G /\
        g INTER h SUBSET {group_id G}
        ==> !x y. x IN g /\ y IN h ==> group_mul G x y = group_mul G y x"
   (← do
    let a1 ← MESON []  (← q
     r"u = v /\ s = t
      ==> (!x. x IN t ==> x IN s) /\ (!x. x IN u ==> x IN v)")
    pure (REPEAT GEN_TAC THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    wPart lhand (fun t => do lhand (← rand t)) GROUP_DISJOINT_SUM_CANCEL THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP], DISCH_THEN SUBST1_TAC] THEN
    DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [(← q r"x:A"), (← q r"y:A")] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(x:A) IN group_carrier G /\ y IN group_carrier G")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [normal_subgroup_of, subgroup_of, SUBSET], ALL_TAC] THEN
    MP_TAC (← CONJ (← ASSUME (← q r"(g:A->bool) normal_subgroup_of G"))
                (← ASSUME (← q r"(h:A->bool) normal_subgroup_of G"))) THEN
    REWRITE_TAC [normal_subgroup_of, IMP_IMP] THEN
    DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [IMP_IMP] THEN DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o SPEC (← q r"x:A")) (MP_TAC o SPEC (← q r"y:A"))) THEN
    ASM_REWRITE_TAC [IMP_IMP] THEN DISCH_THEN (MP_TAC o MATCH_MP a1) THEN
    REWRITE_TAC [right_coset, left_coset, group_setmul, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, IN_SING, FORALL_UNWIND_THM2] THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [UNWIND_THM2] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"y:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y':A") (STRIP_ASSUME_TAC o GSYM)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x':A") (STRIP_ASSUME_TAC o GSYM)) THEN
    ASM_MESON_TAC []))

  let GROUP_SUM_NORMAL_EQ_COMMUTING ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G /\
        group_carrier G SUBSET group_setmul G g h /\
        g INTER h SUBSET {group_id G}
        ==> (g normal_subgroup_of G /\ h normal_subgroup_of G <=>
             !x y. x IN g /\ y IN h ==> group_mul G x y = group_mul G y x)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [MATCH_MP_TAC GROUP_SUM_NORMAL_IMP_COMMUTING THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC GROUP_SUM_COMMUTING_IMP_NORMAL THEN
      ASM_REWRITE_TAC []])

  -- @@RETURN BEGIN
  return { GROUP_DISJOINT_SUM_ALT, GROUP_DISJOINT_SUM_ID, GROUP_DISJOINT_SUM_CANCEL,
           GROUP_SUM_COMMUTING_IMP_NORMAL, GROUP_SUM_NORMAL_IMP_COMMUTING,
           GROUP_SUM_NORMAL_EQ_COMMUTING }
  -- @@RETURN END

structure GroupMulMorphism where
  -- @@FIELDS
  GROUP_HOMOMORPHISM_GROUP_MUL_GEN : thm
  GROUP_HOMOMORPHISM_GROUP_MUL_EQ : thm
  GROUP_HOMOMORPHISM_GROUP_MUL : thm
  GROUP_EPIMORPHISM_GROUP_MUL_EQ : thm
  GROUP_MONOMORPHISM_GROUP_MUL_EQ : thm
  GROUP_ISOMORPHISM_GROUP_MUL_ALT : thm
  GROUP_ISOMORPHISM_GROUP_MUL_EQ : thm
  GROUP_ISOMORPHISM_GROUP_MUL_GEN : thm
  GROUP_ISOMORPHISM_GROUP_MUL : thm
  deriving Inhabited

@[nospecialize]
def setupGroupMulMorphism [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BAbelian : Abelian) (BGroupRule : GroupRule) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BProdGroup : ProdGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms2 : Homomorphisms2) (BSetwise1 : Setwise1) (BNormalSubgroups : NormalSubgroups) (BGroupDisjointSum : GroupDisjointSum) :
    ExceptT String IO GroupMulMorphism := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { CONJ_SYM, EXISTS_PAIR_THM, .. } := D.core2
  let { EXTENSION, FORALL_IN_IMAGE, FORALL_PAIR_THM, .. } := D.core3
  let { IN_CROSS, IN_IMAGE, .. } := D.core5
  let { PAIR_EQ, .. } := D.core6
  let { SUBSET, SUBSET_REFL, .. } := D.core7
  let { GROUP_MUL, GROUP_MUL_ASSOC, .. } := BBasics
  let { abelian_group, .. } := BAbelian
  let { GROUP_TAC, .. } := BGroupRule
  let { subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_INC_GEN, .. } := BSubgroupGen1
  let { GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ, .. } := BSubgroupGen2
  let { PROD_GROUP, .. } := BProdGroup
  let { GROUP_HOMOMORPHISM, group_epimorphism, group_monomorphism, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_INV, .. } := BHomomorphisms1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { group_setmul, .. } := BSetwise1
  let { ABELIAN_GROUP_NORMAL_SUBGROUP, NORMAL_SUBGROUP_IMP_SUBGROUP, .. } := BNormalSubgroups
  let { GROUP_DISJOINT_SUM_ALT, GROUP_DISJOINT_SUM_CANCEL,
        GROUP_SUM_NORMAL_EQ_COMMUTING, .. } := BGroupDisjointSum
  -- @@SCOPE END

  let GROUP_HOMOMORPHISM_GROUP_MUL_GEN ← prove
   r"!G g h:A->bool.
        group_homomorphism
            (prod_group (subgroup_generated G g) (subgroup_generated G h),G)
            (\(x,y). group_mul G x y) <=>
        !x y. x IN group_carrier G /\ x IN g /\
              y IN group_carrier G /\ y IN h
              ==> group_mul G x y = group_mul G y x"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN MAP_EVERY X_GEN_TAC [(← q r"x:A"), (← q r"y:A")] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"(x:A,y:A)") (← MATCH_MP GROUP_HOMOMORPHISM_INV th)))) THEN
      ASM_SIMP_TAC [PROD_GROUP, IN_CROSS, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
      ASM_SIMP_TAC [SUBGROUP_GENERATED_INC_GEN] THEN GROUP_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [← GSYM GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ] THEN
    DISCH_TAC THEN
    REWRITE_TAC [GROUP_HOMOMORPHISM, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [PROD_GROUP, FORALL_PAIR_THM, IN_CROSS] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET, GROUP_MUL],
      REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED]] THEN
    MAP_EVERY X_GEN_TAC [(← q r"x1:A"), (← q r"y1:A"), (← q r"x2:A"), (← q r"y2:A")] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(x1:A) IN group_carrier G /\
      (x2:A) IN group_carrier G /\
      (y1:A) IN group_carrier G /\
      (y2:A) IN group_carrier G")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET],
      ASM_SIMP_TAC [← GSYM GROUP_MUL_ASSOC, GROUP_MUL]] THEN
    AP_TERM_TAC THEN ASM_SIMP_TAC [GROUP_MUL_ASSOC, GROUP_MUL] THEN
    ASM_MESON_TAC [])

  let GROUP_HOMOMORPHISM_GROUP_MUL_EQ ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> (group_homomorphism
              (prod_group (subgroup_generated G g) (subgroup_generated G h),G)
              (\(x,y). group_mul G x y) <=>
              !x y. x IN g /\ y IN h ==> group_mul G x y = group_mul G y x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [GROUP_HOMOMORPHISM_GROUP_MUL_GEN] THEN
    ASM_MESON_TAC [subgroup_of, SUBSET])

  let GROUP_HOMOMORPHISM_GROUP_MUL ← prove
   r"!G g h:A->bool.
        abelian_group G
        ==> group_homomorphism
              (prod_group (subgroup_generated G g) (subgroup_generated G h),G)
              (\(x,y). group_mul G x y)"
   (SIMP_TAC [GROUP_HOMOMORPHISM_GROUP_MUL_GEN] THEN
    REWRITE_TAC [abelian_group, subgroup_of, SUBSET] THEN SET_TAC [])

  let GROUP_EPIMORPHISM_GROUP_MUL_EQ ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> (group_epimorphism
               (prod_group (subgroup_generated G g) (subgroup_generated G h),G)
               (\(x,y). group_mul G x y) <=>
             group_setmul G g h = group_carrier G /\
             !x y. x IN g /\ y IN h ==> group_mul G x y = group_mul G y x)"
   (SIMP_TAC [group_epimorphism, GROUP_HOMOMORPHISM_GROUP_MUL_EQ] THEN
    REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [CONJ_SYM] THEN
    AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PAIR_THM, group_setmul] THEN
    ASM_SIMP_TAC [PROD_GROUP, CARRIER_SUBGROUP_GENERATED_SUBGROUP, IN_CROSS] THEN
    SET_TAC [])

  let GROUP_MONOMORPHISM_GROUP_MUL_EQ ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> (group_monomorphism
               (prod_group (subgroup_generated G g) (subgroup_generated G h),G)
               (\(x,y). group_mul G x y) <=>
             g INTER h = {group_id G} /\
             !x y. x IN g /\ y IN h ==> group_mul G x y = group_mul G y x)"
   (SIMP_TAC [group_monomorphism, GROUP_HOMOMORPHISM_GROUP_MUL_EQ] THEN
    REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [CONJ_SYM] THEN
    AP_TERM_TAC THEN
    ASM_SIMP_TAC [GROUP_DISJOINT_SUM_CANCEL, ← GSYM GROUP_DISJOINT_SUM_ALT] THEN
    ASM_SIMP_TAC [PROD_GROUP, CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN MESON_TAC [])

  let GROUP_ISOMORPHISM_GROUP_MUL_ALT ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> (group_isomorphism
               (prod_group (subgroup_generated G g) (subgroup_generated G h),G)
               (\(x,y). group_mul G x y) <=>
             g INTER h = {group_id G} /\
             group_setmul G g h = group_carrier G /\
             !x y. x IN g /\ y IN h ==> group_mul G x y = group_mul G y x)"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    ASM_SIMP_TAC [GROUP_EPIMORPHISM_GROUP_MUL_EQ,
                  GROUP_MONOMORPHISM_GROUP_MUL_EQ] THEN
    CONV_TAC TAUT)

  let GROUP_ISOMORPHISM_GROUP_MUL_EQ ← prove
   r"!G g h:A->bool.
        g subgroup_of G /\ h subgroup_of G
        ==> (group_isomorphism
               (prod_group (subgroup_generated G g) (subgroup_generated G h),G)
               (\(x,y). group_mul G x y) <=>
             g normal_subgroup_of G /\ h normal_subgroup_of G /\
             g INTER h = {group_id G} /\
             group_setmul G g h = group_carrier G)"
   (← do
    let a1 ← TAUT (← q
     r"(i /\ s ==> (n /\ n' <=> c))
      ==> (i /\ s /\ c <=> n /\ n' /\ i /\ s)")
    pure (SIMP_TAC [GROUP_ISOMORPHISM_GROUP_MUL_ALT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC a1 THEN
    STRIP_TAC THEN MATCH_MP_TAC GROUP_SUM_NORMAL_EQ_COMMUTING THEN
    ASM_REWRITE_TAC [SUBSET_REFL]))

  let GROUP_ISOMORPHISM_GROUP_MUL_GEN ← prove
   r"!G g h:A->bool.
        g normal_subgroup_of G /\ h normal_subgroup_of G
        ==> (group_isomorphism
               (prod_group (subgroup_generated G g) (subgroup_generated G h),G)
               (\(x,y). group_mul G x y) <=>
             g INTER h SUBSET {group_id G} /\
             group_setmul G g h = group_carrier G)"
   (SIMP_TAC [GROUP_ISOMORPHISM_GROUP_MUL_EQ, NORMAL_SUBGROUP_IMP_SUBGROUP,
             GROUP_DISJOINT_SUM_ALT])

  let GROUP_ISOMORPHISM_GROUP_MUL ← prove
   r"!G g h:A->bool.
        abelian_group G /\ g subgroup_of G /\ h subgroup_of G
        ==> (group_isomorphism
               (prod_group (subgroup_generated G g) (subgroup_generated G h),G)
               (\(x,y). group_mul G x y) <=>
             g INTER h SUBSET {group_id G} /\
             group_setmul G g h = group_carrier G)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_ISOMORPHISM_GROUP_MUL_GEN THEN
    ASM_MESON_TAC [ABELIAN_GROUP_NORMAL_SUBGROUP])

  -- @@RETURN BEGIN
  return { GROUP_HOMOMORPHISM_GROUP_MUL_GEN, GROUP_HOMOMORPHISM_GROUP_MUL_EQ,
           GROUP_HOMOMORPHISM_GROUP_MUL, GROUP_EPIMORPHISM_GROUP_MUL_EQ,
           GROUP_MONOMORPHISM_GROUP_MUL_EQ, GROUP_ISOMORPHISM_GROUP_MUL_ALT,
           GROUP_ISOMORPHISM_GROUP_MUL_EQ, GROUP_ISOMORPHISM_GROUP_MUL_GEN,
           GROUP_ISOMORPHISM_GROUP_MUL }
  -- @@RETURN END

structure GroupSumImKer where
  -- @@FIELDS
  ISOMORPHIC_PROD_GROUP_SUBGROUP_GENERATED : thm
  GROUP_INTER_IM_KER : thm
  GROUP_SUM_IM_KER : thm
  GROUP_SUM_KER_IM : thm
  GROUP_SEMIDIRECT_SUM_IM_KER : thm
  GROUP_SEMIDIRECT_SUM_KER_IM : thm
  GROUP_ISOMORPHISM_GROUP_MUL_IM_KER : thm
  GROUP_ISOMORPHISM_GROUP_MUL_KER_IM : thm
  deriving Inhabited

@[nospecialize]
def setupGroupSumImKer [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BHomomorphisms : Homomorphisms) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BSetwise1 : Setwise1) (BCosetProducts : CosetProducts) (BNormalSubgroups : NormalSubgroups) (BNormalSubgroups2 : NormalSubgroups2) (BKernelsImages1 : KernelsImages1) (BGroupDisjointSum : GroupDisjointSum) (BGroupMulMorphism : GroupMulMorphism) :
    ExceptT String IO GroupSumImKer := do
  -- @@SCOPE BEGIN
  let { SET_RULE, SET_TAC, TAUT, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { EXISTS_IN_IMAGE, .. } := D.core2
  let { FORALL_IN_IMAGE, .. } := D.core3
  let { INTER_COMM, .. } := D.core4
  let { IN_ELIM_THM, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, .. } := D.core6
  let { RIGHT_EXISTS_AND_THM, SUBSET, SUBSET_ANTISYM, SUBSET_REFL, SWAP_EXISTS_THM, .. } := D.core7
  let { o_THM, .. } := D.core8
  let { GROUP_INV, GROUP_MUL, GROUP_MUL_ASSOC, GROUP_MUL_LID, GROUP_MUL_LINV,
        GROUP_MUL_RID, GROUP_MUL_RINV, .. } := BBasics
  let { SUBGROUP_OF_IMP_SUBSET, .. } := BSubgroups
  let { SUBGROUP_GENERATED, SUBGROUP_OF_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  let { SUBGROUP_GENERATED_IDEMPOT, .. } := BSubgroupGen2
  let { group_epimorphism, group_homomorphism, .. } := BHomomorphisms
  let { GROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, .. } := BIso1
  let { GROUP_SETMUL, GROUP_SETMUL_INC, group_setmul, .. } := BSetwise1
  let { GROUP_SETMUL_SUBGROUP_GENERATED, .. } := BCosetProducts
  let { NORMAL_SUBGROUP_IMP_SUBGROUP, .. } := BNormalSubgroups
  let { GROUP_SETMUL_NORMAL_SUBGROUP_LEFT, NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED, .. } := BNormalSubgroups2
  let { GROUP_MONOMORPHISM, SUBGROUP_GROUP_IMAGE, SUBGROUP_GROUP_KERNEL, group_image,
        group_kernel, .. } := BKernelsImages1
  let { GROUP_DISJOINT_SUM_ALT, .. } := BGroupDisjointSum
  let { GROUP_ISOMORPHISM_GROUP_MUL, GROUP_ISOMORPHISM_GROUP_MUL_EQ, .. } := BGroupMulMorphism
  -- @@SCOPE END

  let ISOMORPHIC_PROD_GROUP_SUBGROUP_GENERATED ← prove
   r"!G g h:A->bool.
        g normal_subgroup_of G /\ h normal_subgroup_of G /\
        g INTER h = {group_id G}
        ==> prod_group (subgroup_generated G g) (subgroup_generated G h)
            isomorphic_group subgroup_generated G (group_setmul G g h)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [(← q r"subgroup_generated G (group_setmul G g h:A->bool)"),
      (← q r"g:A->bool"), (← q r"h:A->bool")]
     GROUP_ISOMORPHISM_GROUP_MUL_EQ) THEN
    ASM_SIMP_TAC [GROUP_SETMUL_INC, NORMAL_SUBGROUP_IMP_SUBGROUP,
                 SUBGROUP_OF_SUBGROUP_GENERATED_EQ,
                 GROUP_SETMUL_SUBGROUP_GENERATED,
                 NORMAL_SUBGROUP_OF_SUBGROUP_GENERATED,
                 CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                 ← CONJUNCT2 SUBGROUP_GENERATED,
                 GROUP_SETMUL_NORMAL_SUBGROUP_LEFT,
                 SUBGROUP_GENERATED_IDEMPOT] THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC])

  let GROUP_INTER_IM_KER ← prove
   r"!(f:A->B) (g:B->C) G H K.
        group_homomorphism(G,H) f /\
        group_homomorphism(H,K) g /\
        group_monomorphism(G,K) (g o f)
        ==> (group_image(G,H) f) INTER (group_kernel(H,K) g) =
            {group_id H}"
   (SIMP_TAC [← GSYM GROUP_DISJOINT_SUM_ALT, SUBGROUP_GROUP_IMAGE,
             SUBGROUP_GROUP_KERNEL] THEN
    REWRITE_TAC [GROUP_MONOMORPHISM, group_image, group_kernel, o_THM] THEN
    REWRITE_TAC [group_homomorphism] THEN SET_TAC [])

  let GROUP_SUM_IM_KER ← prove
   r"!(f:A->B) (g:B->C) G H K.
        group_homomorphism(G,H) f /\
        group_homomorphism(H,K) g /\
        group_epimorphism(G,K) (g o f)
        ==> group_setmul H (group_image(G,H) f) (group_kernel(H,K) g) =
            group_carrier H"
   (← do
    let a1 ← SET_RULE (← q
     r"P /\ IMAGE f s = t ==> !y. y IN t ==> ?x. x IN s /\ f x = y")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [GROUP_SETMUL, SUBGROUP_OF_IMP_SUBSET,
                  SUBGROUP_GROUP_IMAGE, SUBGROUP_GROUP_KERNEL] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
    REWRITE_TAC [group_setmul, IN_ELIM_THM] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [group_epimorphism]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(g:B->C) y") o MATCH_MP a1) THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [group_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, o_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [group_image, group_kernel, IN_ELIM_THM, EXISTS_IN_IMAGE] THEN
    EXISTS_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"group_mul H (group_inv H ((f:A->B) x)) y") THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV, GROUP_MUL_ASSOC, GROUP_MUL_RINV,
                 GROUP_MUL_LID, GROUP_MUL_LINV]))

  let GROUP_SUM_KER_IM ← prove
   r"!(f:A->B) (g:B->C) G H K.
        group_homomorphism(G,H) f /\
        group_homomorphism(H,K) g /\
        group_epimorphism(G,K) (g o f)
        ==> group_setmul H (group_kernel(H,K) g) (group_image(G,H) f) =
            group_carrier H"
   (← do
    let a2 ← TAUT (← q r"(p /\ q) /\ r <=> q /\ p /\ r")
    let a1 ← SET_RULE (← q
     r"P /\ IMAGE f s = t ==> !y. y IN t ==> ?x. x IN s /\ f x = y")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [GROUP_SETMUL, SUBGROUP_OF_IMP_SUBSET,
                  SUBGROUP_GROUP_IMAGE, SUBGROUP_GROUP_KERNEL] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
    REWRITE_TAC [group_setmul, IN_ELIM_THM] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [group_epimorphism]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(g:B->C) y") o MATCH_MP a1) THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [group_homomorphism, SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, o_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [a2] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [group_image, group_kernel, IN_ELIM_THM, EXISTS_IN_IMAGE] THEN
    EXISTS_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"group_mul H y (group_inv H ((f:A->B) x))") THEN
    ASM_SIMP_TAC [GROUP_MUL, GROUP_INV, ← GSYM GROUP_MUL_ASSOC, GROUP_MUL_RINV,
                 GROUP_MUL_RID, GROUP_MUL_LINV]))

  let GROUP_SEMIDIRECT_SUM_IM_KER ← prove
   r"!(f:A->B) (g:B->C) G H K.
      group_homomorphism(G,H) f /\
      group_homomorphism(H,K) g /\
      group_isomorphism(G,K) (g o f)
      ==> (group_image(G,H) f) INTER (group_kernel(H,K) g) = {group_id H} /\
          group_setmul H (group_image(G,H) f) (group_kernel(H,K) g) =
          group_carrier H"
   (SIMP_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM, GROUP_INTER_IM_KER] THEN
    SIMP_TAC [GROUP_SUM_IM_KER])

  let GROUP_SEMIDIRECT_SUM_KER_IM ← prove
   r"!(f:A->B) (g:B->C) G H K.
      group_homomorphism(G,H) f /\
      group_homomorphism(H,K) g /\
      group_isomorphism(G,K) (g o f)
      ==> (group_kernel(H,K) g) INTER (group_image(G,H) f) = {group_id H} /\
           group_setmul H (group_kernel(H,K) g) (group_image(G,H) f) =
           group_carrier H"
   (ONCE_REWRITE_TAC [INTER_COMM] THEN
    SIMP_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM, GROUP_INTER_IM_KER] THEN
    SIMP_TAC [GROUP_SUM_KER_IM])

  let GROUP_ISOMORPHISM_GROUP_MUL_IM_KER ← prove
   r"!(f:A->B) (g:B->C) G H K.
        abelian_group H /\
        group_homomorphism(G,H) f /\
        group_homomorphism(H,K) g /\
        group_isomorphism(G,K) (g o f)
        ==> group_isomorphism
              (prod_group (subgroup_generated H (group_image(G,H) f))
                          (subgroup_generated H (group_kernel(H,K) g)),H)
              (\(x,y). group_mul H x y)"
   (SIMP_TAC [GROUP_ISOMORPHISM_GROUP_MUL,
             SUBGROUP_GROUP_IMAGE, SUBGROUP_GROUP_KERNEL] THEN
    SIMP_TAC [GROUP_SEMIDIRECT_SUM_IM_KER, SUBSET_REFL])

  let GROUP_ISOMORPHISM_GROUP_MUL_KER_IM ← prove
   r"!(f:A->B) (g:B->C) G H K.
        abelian_group H /\
        group_homomorphism(G,H) f /\
        group_homomorphism(H,K) g /\
        group_isomorphism(G,K) (g o f)
        ==> group_isomorphism
              (prod_group (subgroup_generated H (group_kernel(H,K) g))
                          (subgroup_generated H (group_image(G,H) f)),H)
              (\(x,y). group_mul H x y)"
   (SIMP_TAC [GROUP_ISOMORPHISM_GROUP_MUL,
             SUBGROUP_GROUP_IMAGE, SUBGROUP_GROUP_KERNEL] THEN
    SIMP_TAC [GROUP_SEMIDIRECT_SUM_KER_IM, SUBSET_REFL])

  -- @@RETURN BEGIN
  return { ISOMORPHIC_PROD_GROUP_SUBGROUP_GENERATED, GROUP_INTER_IM_KER,
           GROUP_SUM_IM_KER, GROUP_SUM_KER_IM, GROUP_SEMIDIRECT_SUM_IM_KER,
           GROUP_SEMIDIRECT_SUM_KER_IM, GROUP_ISOMORPHISM_GROUP_MUL_IM_KER,
           GROUP_ISOMORPHISM_GROUP_MUL_KER_IM }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Internal versus external direct sums over an arbitrary indexing set.      -/
/- ------------------------------------------------------------------------- -/

structure GroupSumHomomorphism where
  -- @@FIELDS
  GROUP_HOMOMORPHISM_GROUP_SUM_GEN : thm
  GROUP_HOMOMORPHISM_GROUP_SUM_EQ : thm
  GROUP_HOMOMORPHISM_GROUP_SUM : thm
  GROUP_HOMOMORPHISM_ABELIAN_GROUP_SUM : thm
  ABELIAN_GROUP_HOMOMORPHISM_GROUP_SUM : thm
  deriving Inhabited

@[nospecialize]
def setupGroupSumHomomorphism [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BGroupRule : GroupRule) (BGroupProduct : GroupProduct) (BGroupProductMul : GroupProductMul) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms1 : Homomorphisms1) (BHomomorphisms4 : Homomorphisms4) :
    ExceptT String IO GroupSumHomomorphism := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SELECT_CONV, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { EXTENSION, FINITE_EMPTY, FINITE_INSERT, FINITE_RESTRICT, FINITE_SING,
        FINITE_SUBSET, FORALL_IN_IMAGE, FORALL_UNWIND_THM2, .. } := D.core3
  let { IMP_CONJ, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_ELIM_THM, IN_INSERT, IN_SING, IN_UNIV, .. } := D.core5
  let { NOT_IN_EMPTY, PAIRWISE_IMP, RESTRICTION, .. } := D.core6
  let { RESTRICTION_IN_CARTESIAN_PRODUCT, RESTRICTION_THM, SUBSET, SUBSET_REFL, WO, .. } := D.core7
  let { o_THM, pairwise, woset, .. } := D.core8
  let { GROUP_ID, GROUP_INV, GROUP_MUL_LID, GROUP_MUL_RID, .. } := BBasics
  let { GROUP_INV_EQ_ID, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { GROUP_TAC, .. } := BGroupRule
  let { GROUP_PRODUCT_CLAUSES, GROUP_PRODUCT_SING, GROUP_SUM, GROUP_SUM_EQ,
        GROUP_SUM_SUPPORT, group_sum, .. } := BGroupProduct
  let { GROUP_SUM_MUL, .. } := BGroupProductMul
  let { subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, GROUP_ID_SUBGROUP, SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { SUBGROUP_GENERATED_GROUP_CARRIER, .. } := BSubgroupGen1
  let { GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ, .. } := BSubgroupGen2
  let { SUM_GROUP_CLAUSES, .. } := BSumGroup
  let { GROUP_HOMOMORPHISM, GROUP_HOMOMORPHISM_EQ, .. } := BHomomorphisms
  let { GROUP_HOMOMORPHISM_COMPOSE, GROUP_HOMOMORPHISM_INV, .. } := BHomomorphisms1
  let { GROUP_HOMOMORPHISM_SUM, .. } := BHomomorphisms4
  -- @@SCOPE END

  let GROUP_HOMOMORPHISM_GROUP_SUM_GEN ← prove
   r"!k l G (h:K->A->bool).
        k SUBSET l
        ==> (group_homomorphism (sum_group l (\i. subgroup_generated G (h i)),G)
                                (group_sum G k) <=>
             pairwise (\i j. !x y. x IN group_carrier G /\ x IN (h i) /\
                                   y IN group_carrier G /\ y IN (h j)
                                   ==> group_mul G x y = group_mul G y x) k)"
   (← do
    let a3 ← MESON [FINITE_SUBSET]
      (← q r"FINITE {i | i IN l /\ P i}
              ==> {i | i IN k /\ P i} SUBSET {i | i IN l /\ P i}
                  ==> FINITE {i | i IN k /\ P i}")
    let a2 ← SET_RULE (← q r"{i,j} = {j,i}")
    let a1 ← MESON []
      (← q r"group_sum G k f = group_inv G(group_sum G k g)
        ==> !k'. group_sum G k' f = group_sum G k f /\
                 group_sum G k' g = group_sum G k g
                 ==> group_sum G k' f = group_inv G (group_sum G k' g)")
    pure (REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ] THEN EQ_TAC THENL
     [DISCH_TAC THEN
      REWRITE_TAC [pairwise] THEN MAP_EVERY X_GEN_TAC [(← q r"i:K"), (← q r"j:K")] THEN
      STRIP_TAC THEN MAP_EVERY X_GEN_TAC [(← q r"x:A"), (← q r"y:A")] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN group_carrier G /\ y IN group_carrier G")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET],
        ALL_TAC] THEN
      MAP_EVERY ASM_CASES_TAC [(← q r"x:A = group_id G"), (← q r"y:A = group_id G")] THEN
      ASM_SIMP_TAC [GROUP_MUL_LID, GROUP_MUL_RID] THEN
      FIRST_ASSUM (MP_TAC o
       SPEC (← q r"RESTRICTION l
              (\l. if l = i then x else if l = j then y else group_id G):K->A") o
       MATCH_MP GROUP_HOMOMORPHISM_INV) THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
      REWRITE_TAC [IN_ELIM_THM, RESTRICTION_IN_CARTESIAN_PRODUCT] THEN
      SIMP_TAC [RESTRICTION_THM] THEN ANTS_TAC THENL
       [CONJ_TAC THENL
         [X_GEN_TAC (← q r"l:K") THEN DISCH_TAC THEN
          REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [GROUP_ID_SUBGROUP]),
          MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{i:K,j:K}") THEN
          REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY] THEN SET_TAC []],
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"{i:K,j:K}") o MATCH_MP a1) THEN
      ANTS_TAC THENL
       [ONCE_REWRITE_TAC [← GSYM GROUP_SUM_SUPPORT] THEN
        CONJ_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        GEN_REWRITE_TAC I [EXTENSION] THEN
        REWRITE_TAC [IN_INSERT, IN_ELIM_THM, NOT_IN_EMPTY] THEN
        ASM_MESON_TAC [GROUP_INV_EQ_ID, GROUP_ID],
        ALL_TAC] THEN
      REWRITE_TAC [group_sum] THEN
      ABBREV_TAC (← q r"(<<=) = @l. woset l /\ fld l = (:K)") THEN
      SUBGOAL_THEN (← q r"woset(<<=) /\ fld(<<=) = (:K)") STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "<<=" THEN CONV_TAC SELECT_CONV THEN REWRITE_TAC [WO],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(i:K) <<= j \/ j <<= i") STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [woset]) THEN
        ASM_REWRITE_TAC [IN_UNIV] THEN SIMP_TAC [],
        ALL_TAC,
        ONCE_REWRITE_TAC [a2]] THEN
      (wPart (fun t => do lhand (← lhand t)) (fun t => do lhand (← rand t))
          (← CONJUNCT2 (← SPEC_ALL GROUP_PRODUCT_CLAUSES)) THEN
       wPart (fun t => do rand (← rand (← lhand (← rand t))))
          (fun t => do lhand (← rand t))
          (← CONJUNCT2 (← SPEC_ALL GROUP_PRODUCT_CLAUSES)) THEN
       REPLICATE_TAC 2 (ANTS_TAC THENL
        [SIMP_TAC [FINITE_RESTRICT, FINITE_SING] THEN
         ASM_REWRITE_TAC [IN_SING, FORALL_UNWIND_THM2] THEN
         FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [woset]) THEN
         ASM_REWRITE_TAC [IN_UNIV] THEN ASM_MESON_TAC [],
         DISCH_THEN SUBST1_TAC])) THEN
      ASM_SIMP_TAC [GROUP_INV, IN_SING, GROUP_PRODUCT_SING] THEN GROUP_TAC,
      DISCH_TAC THEN REWRITE_TAC [GROUP_HOMOMORPHISM, SUM_GROUP_CLAUSES] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, GROUP_SUM] THEN
      MAP_EVERY X_GEN_TAC [(← q r"f:K->A"), (← q r"g:K->A")] THEN
      REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_CARTESIAN_PRODUCT] THEN STRIP_TAC THEN
      wPart rand (fun t => do rand (← rand t)) GROUP_SUM_MUL THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [GEN_REWRITE_TAC I [CONJ_ASSOC] THEN CONJ_TAC THENL
         [CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP a3) THEN
          ASM SET_TAC [],
          ALL_TAC] THEN
        CONJ_TAC THENL
         [ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
            (← REWRITE_RULE [IMP_CONJ] PAIRWISE_IMP)) THEN
          ASM SET_TAC []],
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC GROUP_SUM_EQ THEN
        ASM_SIMP_TAC [RESTRICTION]]]))

  let GROUP_HOMOMORPHISM_GROUP_SUM_EQ ← prove
   r"!k l G (h:K->A->bool).
        k SUBSET l /\
        (!i. i IN k ==> (h i) subgroup_of G)
        ==> (group_homomorphism (sum_group l (\i. subgroup_generated G (h i)),G)
                                (group_sum G k) <=>
             pairwise (\i j. !x y. x IN (h i) /\ y IN (h j)
                                   ==> group_mul G x y = group_mul G y x) k)"
   (REWRITE_TAC [subgroup_of] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_GROUP_SUM_GEN, pairwise] THEN
    ASM SET_TAC [])

  let GROUP_HOMOMORPHISM_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
          pairwise (\i j. !x y. x IN h i /\ y IN h j
                                ==> group_mul G x y = group_mul G y x) k
          ==> group_homomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                                 (group_sum G k)"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [GROUP_HOMOMORPHISM_GROUP_SUM_GEN, SUBSET_REFL] THEN
    REWRITE_TAC [pairwise] THEN MESON_TAC [])

  let GROUP_HOMOMORPHISM_ABELIAN_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
          abelian_group G
          ==> group_homomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                                 (group_sum G k)"
   (REWRITE_TAC [abelian_group] THEN REPEAT STRIP_TAC THEN
    SIMP_TAC [GROUP_HOMOMORPHISM_GROUP_SUM_GEN, SUBSET_REFL, pairwise] THEN
    ASM_SIMP_TAC [])

  let ABELIAN_GROUP_HOMOMORPHISM_GROUP_SUM ← prove
   r"!(f:K->A->B) k A B.
          abelian_group B /\
          (!i. i IN k ==> group_homomorphism (A i,B) (f i))
          ==> group_homomorphism (sum_group k A,B)
               (\x. group_sum B k (\i. (f i) (x i)))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC GROUP_HOMOMORPHISM_EQ THEN
    EXISTS_TAC
     (← q r"group_sum B k o (\x. RESTRICTION k (\i. ((f:K->A->B) i) (x i)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC GROUP_HOMOMORPHISM_COMPOSE,
      REWRITE_TAC [o_THM, RESTRICTION_THM] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC GROUP_SUM_EQ THEN SIMP_TAC []] THEN
    EXISTS_TAC (← q r"sum_group k (\i:K. (B:B group))") THEN
    ASM_REWRITE_TAC [GROUP_HOMOMORPHISM_SUM] THEN
      GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o RAND_CONV o BINDER_CONV)
     [← GSYM SUBGROUP_GENERATED_GROUP_CARRIER] THEN
    MATCH_MP_TAC GROUP_HOMOMORPHISM_ABELIAN_GROUP_SUM THEN
    ASM_REWRITE_TAC [])

  -- @@RETURN BEGIN
  return { GROUP_HOMOMORPHISM_GROUP_SUM_GEN, GROUP_HOMOMORPHISM_GROUP_SUM_EQ,
           GROUP_HOMOMORPHISM_GROUP_SUM, GROUP_HOMOMORPHISM_ABELIAN_GROUP_SUM,
           ABELIAN_GROUP_HOMOMORPHISM_GROUP_SUM }
  -- @@RETURN END

structure GroupSumEpimorphism where
  -- @@FIELDS
  SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN : thm
  SUBGROUP_EPIMORPHISM_GROUP_SUM_EQ : thm
  SUBGROUP_EPIMORPHISM_GROUP_SUM : thm
  SUBGROUP_EPIMORPHISM_ABELIAN_GROUP_SUM : thm
  GROUP_EPIMORPHISM_GROUP_SUM_GEN : thm
  GROUP_EPIMORPHISM_GROUP_SUM_EQ : thm
  GROUP_EPIMORPHISM_GROUP_SUM : thm
  GROUP_EPIMORPHISM_ABELIAN_GROUP_SUM : thm
  deriving Inhabited

@[nospecialize]
def setupGroupSumEpimorphism [HolBase] (D : GroupTheoryDeps) (BAbelian : Abelian) (BGroupProduct : GroupProduct) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms2 : Homomorphisms2) (BGroupSumHomomorphism : GroupSumHomomorphism) :
    ExceptT String IO GroupSumEpimorphism := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { COND_ID, COND_RAND, COND_RATOR, .. } := D.core1
  let { EMPTY_GSPEC, .. } := D.core2
  let { FINITE_EMPTY, FINITE_SING, FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core3
  let { IN_CARTESIAN_PRODUCT, IN_ELIM_THM, IN_IMAGE, .. } := D.core5
  let { RESTRICTION_IN_CARTESIAN_PRODUCT, RESTRICTION_THM, SING_GSPEC, SUBSET,
        SUBSET_ANTISYM, SUBSET_REFL, .. } := D.core7
  let { pairwise, .. } := D.core8
  let { abelian_group, .. } := BAbelian
  let { GROUP_SUM_CLAUSES_EXISTS, GROUP_SUM_SING, GROUP_SUM_SUPPORT, .. } := BGroupProduct
  let { CARRIER_SUBGROUP_OF, IN_SUBGROUP_SUM, subgroup_of, .. } := BSubgroups
  let { GROUP_ID_SUBGROUP, SUBGROUP_GENERATED, SUBGROUP_GENERATED_EQ,
        SUBGROUP_GENERATED_MONO, SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { SUBGROUP_GENERATED_INC_GEN, SUBGROUP_GENERATED_MINIMAL_EQ, .. } := BSubgroupGen1
  let { SUM_GROUP_CLAUSES, .. } := BSumGroup
  let { group_epimorphism, .. } := BHomomorphisms
  let { GROUP_EPIMORPHISM_INTO_SUBGROUP_EQ_GEN, SUBGROUP_OF_HOMOMORPHIC_IMAGE, .. } := BHomomorphisms2
  let { GROUP_HOMOMORPHISM_GROUP_SUM_GEN, .. } := BGroupSumHomomorphism
  -- @@SCOPE END

  let SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN ← prove
   r"!k l G (h:K->A->bool).
          k SUBSET l
          ==> (group_epimorphism (sum_group l (\i. subgroup_generated G (h i)),
                                  subgroup_generated G (UNIONS {h i | i IN k}))
                                 (group_sum G k) <=>
               pairwise (\i j. !x y. x IN group_carrier G /\ x IN (h i) /\
                                     y IN group_carrier G /\ y IN (h j)
                                     ==> group_mul G x y = group_mul G y x) k)"
   (← do
    let a6 ← SET_RULE
      (← q r"{j | ~(P j ==> j = i ==> Q)} = {j | j = i /\ P i /\ ~Q}")
    let a5 ← MESON [] (← q r"(if p then q else T) <=> p ==> q")
    let a4 ← TAUT (← q r"p /\ ~q <=> ~(p ==> q)")
    let a3 ← SET_RULE
      (← q r"(!i. i IN f ==> !x. x IN i /\ x IN u ==> x IN t)
        ==> u INTER UNIONS f SUBSET t")
    let a2 ← SET_RULE (← q r"s SUBSET t ==> a IN s ==> a IN t")
    let a1 ← TAUT (← q r"(p /\ q <=> p) <=> p ==> q")
    pure (REPEAT GEN_TAC THEN
    REWRITE_TAC [GROUP_EPIMORPHISM_INTO_SUBGROUP_EQ_GEN] THEN
    SIMP_TAC [← GSYM GROUP_HOMOMORPHISM_GROUP_SUM_GEN] THEN
    REWRITE_TAC [a1] THEN REPEAT DISCH_TAC THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"z:K->A") THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, IN_CARTESIAN_PRODUCT, IN_ELIM_THM] THEN
      STRIP_TAC THEN MATCH_MP_TAC IN_SUBGROUP_SUM THEN
      REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
      X_GEN_TAC (← q r"i:K") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC a2 THEN
      MATCH_MP_TAC SUBGROUP_GENERATED_MONO THEN ASM SET_TAC [],
      wPart pure (fun t => do lhand (← rand t)) SUBGROUP_GENERATED_MINIMAL_EQ THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [CARRIER_SUBGROUP_OF, SUBGROUP_OF_HOMOMORPHIC_IMAGE],
        DISCH_THEN SUBST1_TAC] THEN
      MATCH_MP_TAC a3 THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN REWRITE_TAC [IN_IMAGE] THEN
      EXISTS_TAC (← q r"RESTRICTION l (\l. if l = i then x else group_id G):K->A") THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, RESTRICTION_IN_CARTESIAN_PRODUCT,
                  IN_ELIM_THM, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
      ONCE_REWRITE_TAC [← GSYM GROUP_SUM_SUPPORT] THEN
      REWRITE_TAC [a4] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [RESTRICTION_THM] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      ASM_SIMP_TAC [a5] THEN
      ASM_SIMP_TAC [SUBGROUP_GENERATED_INC_GEN, GROUP_ID_SUBGROUP, COND_ID] THEN
      REWRITE_TAC [a6] THEN
      ASM_CASES_TAC (← q r"x:A = group_id G") THEN
      ASM_REWRITE_TAC [GROUP_SUM_CLAUSES_EXISTS, EMPTY_GSPEC, FINITE_EMPTY] THEN
      ASM_SIMP_TAC [SING_GSPEC, GROUP_SUM_SING, FINITE_SING]]))

  let SUBGROUP_EPIMORPHISM_GROUP_SUM_EQ ← prove
   r"!k l G (h:K->A->bool).
        k SUBSET l /\
        (!i. i IN k ==> (h i) subgroup_of G)
        ==> (group_epimorphism (sum_group l (\i. subgroup_generated G (h i)),
                                subgroup_generated G (UNIONS {h i | i IN k}))
                                (group_sum G k) <=>
             pairwise (\i j. !x y. x IN (h i) /\ y IN (h j)
                                   ==> group_mul G x y = group_mul G y x) k)"
   (REWRITE_TAC [subgroup_of] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN, pairwise] THEN
    ASM SET_TAC [])

  let SUBGROUP_EPIMORPHISM_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
          pairwise (\i j. !x y. x IN h i /\ y IN h j
                                ==> group_mul G x y = group_mul G y x) k
          ==> group_epimorphism (sum_group k (\i. subgroup_generated G (h i)),
                                 subgroup_generated G (UNIONS {h i | i IN k}))
                                 (group_sum G k)"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN, SUBSET_REFL] THEN
    REWRITE_TAC [pairwise] THEN MESON_TAC [])

  let SUBGROUP_EPIMORPHISM_ABELIAN_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
          abelian_group G
          ==> group_epimorphism (sum_group k (\i. subgroup_generated G (h i)),
                                 subgroup_generated G (UNIONS {h i | i IN k}))
                                 (group_sum G k)"
   (REWRITE_TAC [abelian_group] THEN REPEAT STRIP_TAC THEN
    SIMP_TAC [SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN, SUBSET_REFL, pairwise] THEN
    ASM_SIMP_TAC [])

  let GROUP_EPIMORPHISM_GROUP_SUM_GEN ← prove
   r"!k l G (h:K->A->bool).
          k SUBSET l
          ==> (group_epimorphism (sum_group l (\i. subgroup_generated G (h i)),G)
                                 (group_sum G k) <=>
               pairwise (\i j. !x y. x IN group_carrier G /\ x IN (h i) /\
                                     y IN group_carrier G /\ y IN (h j)
                                     ==> group_mul G x y = group_mul G y x) k /\
               subgroup_generated G (UNIONS {h i | i IN k}) = G)"
   (REWRITE_TAC [group_epimorphism] THEN
    SIMP_TAC [GROUP_HOMOMORPHISM_GROUP_SUM_GEN] THEN
    SIMP_TAC [← GSYM SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN] THEN
    REWRITE_TAC [group_epimorphism, SUBGROUP_GENERATED_EQ] THEN
    MESON_TAC [])

  let GROUP_EPIMORPHISM_GROUP_SUM_EQ ← prove
   r"!k l G (h:K->A->bool).
          k SUBSET l /\
          (!i. i IN k ==> (h i) subgroup_of G)
          ==> (group_epimorphism (sum_group l (\i. subgroup_generated G (h i)),G)
                                 (group_sum G k) <=>
               pairwise (\i j. !x y. x IN (h i) /\ y IN (h j)
                                     ==> group_mul G x y = group_mul G y x) k /\
               subgroup_generated G (UNIONS {h i | i IN k}) = G)"
   (REWRITE_TAC [subgroup_of] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [GROUP_EPIMORPHISM_GROUP_SUM_GEN, pairwise] THEN
    ASM SET_TAC [])

  let GROUP_EPIMORPHISM_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
          pairwise (\i j. !x y. x IN h i /\ y IN h j
                                ==> group_mul G x y = group_mul G y x) k /\
          subgroup_generated G (UNIONS {h i | i IN k}) = G
          ==> group_epimorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                                (group_sum G k)"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [GROUP_EPIMORPHISM_GROUP_SUM_GEN, SUBSET_REFL] THEN
    REWRITE_TAC [pairwise] THEN MESON_TAC [])

  let GROUP_EPIMORPHISM_ABELIAN_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
          abelian_group G /\
          subgroup_generated G (UNIONS {h i | i IN k}) = G
          ==> group_epimorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                                (group_sum G k)"
   (REWRITE_TAC [abelian_group] THEN REPEAT STRIP_TAC THEN
    SIMP_TAC [GROUP_EPIMORPHISM_GROUP_SUM_GEN, SUBSET_REFL, pairwise] THEN
    ASM_SIMP_TAC [])

  -- @@RETURN BEGIN
  return { SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN, SUBGROUP_EPIMORPHISM_GROUP_SUM_EQ,
           SUBGROUP_EPIMORPHISM_GROUP_SUM, SUBGROUP_EPIMORPHISM_ABELIAN_GROUP_SUM,
           GROUP_EPIMORPHISM_GROUP_SUM_GEN, GROUP_EPIMORPHISM_GROUP_SUM_EQ,
           GROUP_EPIMORPHISM_GROUP_SUM, GROUP_EPIMORPHISM_ABELIAN_GROUP_SUM }
  -- @@RETURN END

structure GroupSumMonomorphism where
  -- @@FIELDS
  GROUP_MONOMORPHISM_GROUP_SUM_GEN : thm
  GROUP_MONOMORPHISM_GROUP_SUM_EQ : thm
  GROUP_MONOMORPHISM_GROUP_SUM : thm
  GROUP_MONOMORPHISM_ABELIAN_GROUP_SUM : thm
  SUBGROUP_ISOMORPHISM_GROUP_SUM_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupGroupSumMonomorphism [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BDerived : Derived) (BAbelian : Abelian) (BGroupRule : GroupRule) (BGroupProduct : GroupProduct) (BGroupProductClauses : GroupProductClauses) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms2 : Homomorphisms2) (BKernelsImages1 : KernelsImages1) (BGroupDisjointSum : GroupDisjointSum) (BGroupSumHomomorphism : GroupSumHomomorphism) (BGroupSumEpimorphism : GroupSumEpimorphism) :
    ExceptT String IO GroupSumMonomorphism := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CONJ_ASSOC, .. } := D.core1
  let { DELETE_SUBSET, .. } := D.core2
  let { EXTENSION, FINITE_INSERT, FINITE_SUBSET, FUN_EQ_THM, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_DELETE, IN_ELIM_THM, IN_INTER, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, PAIRWISE_MONO, RESTRICTION, .. } := D.core6
  let { RESTRICTION_IN_CARTESIAN_PRODUCT, RESTRICTION_THM, RESTRICTION_UNIQUE, SUBSET,
        SUBSET_REFL, .. } := D.core7
  let { pairwise, .. } := D.core8
  let { GROUP_INV, GROUP_MUL_LINV, .. } := BBasics
  let { GROUP_COMMUTES_INV, GROUP_RINV_UNIQUE, .. } := BDerived
  let { abelian_group, .. } := BAbelian
  let { GROUP_TAC, .. } := BGroupRule
  let { GROUP_SUM, GROUP_SUM_EQ, .. } := BGroupProduct
  let { GROUP_SUM_CLAUSES_COMMUTING, .. } := BGroupProductClauses
  let { IN_SUBGROUP_INV, IN_SUBGROUP_SUM, subgroup_of, .. } := BSubgroups
  let { GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBGROUP_GENERATED,
        SUBGROUP_GENERATED_MONO, SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  let { GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ, .. } := BSubgroupGen2
  let { SUM_GROUP_CLAUSES, .. } := BSumGroup
  let { group_epimorphism, .. } := BHomomorphisms
  let { SUBGROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { GROUP_MONOMORPHISM_ALT, .. } := BKernelsImages1
  let { GROUP_DISJOINT_SUM_ALT, .. } := BGroupDisjointSum
  let { GROUP_HOMOMORPHISM_GROUP_SUM_GEN, .. } := BGroupSumHomomorphism
  let { SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN, .. } := BGroupSumEpimorphism
  -- @@SCOPE END

  let GROUP_MONOMORPHISM_GROUP_SUM_GEN ← prove
   r"!k G (h:K->A->bool).
        group_monomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                           (group_sum G k) <=>
        pairwise (\i j. !x y. x IN group_carrier G /\ x IN (h i) /\
                              y IN group_carrier G /\ y IN (h j)
                              ==> group_mul G x y = group_mul G y x) k /\
        !i. i IN k
            ==> group_carrier
                   (subgroup_generated G (h i)) INTER
                group_carrier
                   (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                {group_id G}"
   (← do
    let a8 ← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")
    let a7 ← SET_RULE (← q r"i IN k ==> i INSERT (k DELETE i) = k")
    let a6 ← MESON [GROUP_MUL_LINV]
      (← q r"x IN group_carrier G /\ x = y
        ==> group_mul G (group_inv G x) y = group_id G")
    let a5 ← SET_RULE (← q r"i IN k ==> i INSERT (k DELETE i) = k")
    let a4 ← MESON [FINITE_INSERT, FINITE_SUBSET]
      (← q r"FINITE t ==> !x. s SUBSET x INSERT t ==> FINITE s")
    let a3 ← MESON [FINITE_INSERT, FINITE_SUBSET]
      (← q r"FINITE t ==> !x. s SUBSET x INSERT t ==> FINITE s")
    let a2 ← SET_RULE
      (← q r"P /\ IMAGE f s = t ==> !y. y IN t ==> ?x. x IN s /\ f x = y")
    let a1 ← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")
    pure (REPEAT GEN_TAC THEN REWRITE_TAC [GROUP_MONOMORPHISM_ALT] THEN
    ASM_SIMP_TAC [GROUP_HOMOMORPHISM_GROUP_SUM_GEN, SUBSET_REFL] THEN
    MATCH_MP_TAC a1 THEN
    REWRITE_TAC [← GSYM GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ] THEN
    DISCH_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
      SIMP_TAC [← GSYM GROUP_DISJOINT_SUM_ALT, SUBGROUP_SUBGROUP_GENERATED] THEN
      REWRITE_TAC [SUBSET, IN_INTER, IN_SING] THEN
      X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN group_carrier G") ASSUME_TAC THENL
       [ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [(← q r"k DELETE (i:K)"), (← q r"k:K->bool"), (← q r"G:A group"),
                     (← q r"h:K->A->bool")] SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN) THEN
      ASM_REWRITE_TAC [group_epimorphism, DELETE_SUBSET] THEN
      ASM_REWRITE_TAC [← GSYM GROUP_COMMUTES_SUBGROUPS_GENERATED_EQ] THEN
      DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).2)) THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           PAIRWISE_MONO)) THEN SET_TAC [],
        DISCH_THEN (MP_TAC o SPEC (← q r"x:A") o MATCH_MP a2)] THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"z:K->A") THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_CARTESIAN_PRODUCT, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"RESTRICTION k (\j. if j = i then group_inv G x else (z:K->A) j)")) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [REWRITE_TAC [SUM_GROUP_CLAUSES, IN_ELIM_THM] THEN
          REWRITE_TAC [RESTRICTION_IN_CARTESIAN_PRODUCT] THEN CONJ_TAC THENL
           [ASM_MESON_TAC [GROUP_INV, SUBGROUP_GENERATED], ALL_TAC] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP a3) THEN
          EXISTS_TAC (← q r"i:K") THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
          SIMP_TAC [IMP_CONJ, RESTRICTION, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
          SET_TAC [],
          MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"i:K"), (← q r"k DELETE (i:K)"),
                         (← q r"\j. if j = i then group_inv G x else (z:K->A) j")]
            GROUP_SUM_CLAUSES_COMMUTING) THEN
          ANTS_TAC THENL
           [CONJ_TAC THENL
             [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP a4) THEN
              EXISTS_TAC (← q r"i:K") THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
              SIMP_TAC [IMP_CONJ, RESTRICTION, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
              SET_TAC [],
              X_GEN_TAC (← q r"j:K") THEN REWRITE_TAC [IN_DELETE] THEN
              DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
              ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
              MATCH_MP_TAC GROUP_COMMUTES_INV THEN
              FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [pairwise]) THEN
              ASM_MESON_TAC []],
            ASM_SIMP_TAC [RESTRICTION_THM, a5] THEN
            DISCH_THEN SUBST1_TAC] THEN
          ASM_SIMP_TAC [GROUP_INV, IN_DELETE] THEN
          MATCH_MP_TAC a6 THEN
          ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (fun th =>
            tactic_of do pure (GEN_REWRITE_TAC LAND_CONV [← SYM th])) THEN
          MATCH_MP_TAC GROUP_SUM_EQ THEN SIMP_TAC [IN_DELETE]],
        GEN_REWRITE_TAC LAND_CONV [FUN_EQ_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"i:K")) THEN
        ASM_REWRITE_TAC [RESTRICTION, SUM_GROUP_CLAUSES] THEN
        REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED] THEN GROUP_TAC],
      X_GEN_TAC (← q r"z:K->A") THEN
      REWRITE_TAC [SUM_GROUP_CLAUSES, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_CARTESIAN_PRODUCT, ← CONJUNCT2 SUBGROUP_GENERATED] THEN
      STRIP_TAC THEN CONV_TAC SYM_CONV THEN
      ASM_REWRITE_TAC [RESTRICTION_UNIQUE] THEN
      X_GEN_TAC (← q r"i:K") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"i:K"), (← q r"k DELETE (i:K)"), (← q r"z:K->A")]
        GROUP_SUM_CLAUSES_COMMUTING) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            FINITE_SUBSET)) THEN SET_TAC [],
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [pairwise]) THEN
          REWRITE_TAC [IN_DELETE] THEN ASM_MESON_TAC []],
        DISCH_THEN (MP_TAC o SYM)] THEN
      ASM_SIMP_TAC [RESTRICTION_THM, IN_DELETE, a7] THEN
      COND_CASES_TAC THENL
       [ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET],
        DISCH_TAC THEN CONV_TAC SYM_CONV] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K") o
        GEN_REWRITE_RULE (BINDER_CONV o RAND_CONV) [EXTENSION]) THEN
      ASM_REWRITE_TAC [IN_SING] THEN
      DISCH_THEN (SUBST1_TAC o SYM o SPEC (← q r"(z:K->A) i")) THEN
      ASM_SIMP_TAC [IN_INTER] THEN FIRST_ASSUM (MP_TAC o MATCH_MP
        (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] (← REWRITE_RULE [CONJ_ASSOC]
          GROUP_RINV_UNIQUE))) THEN
      REWRITE_TAC [GROUP_SUM] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [GROUP_CARRIER_SUBGROUP_GENERATED_SUBSET, SUBSET],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC IN_SUBGROUP_INV THEN
      REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
      MATCH_MP_TAC IN_SUBGROUP_SUM THEN
      REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
      X_GEN_TAC (← q r"j:K") THEN REWRITE_TAC [IN_DELETE] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:K")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC a8 THEN
      MATCH_MP_TAC SUBGROUP_GENERATED_MONO THEN ASM SET_TAC []]))

  let GROUP_MONOMORPHISM_GROUP_SUM_EQ ← prove
   r"!k G (h:K->A->bool).
        (!i. i IN k ==> (h i) subgroup_of G)
        ==> (group_monomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                                (group_sum G k) <=>
             pairwise (\i j. !x y. x IN (h i) /\ y IN (h j)
                                   ==> group_mul G x y = group_mul G y x) k /\
             !i. i IN k
                 ==> h i INTER
                     group_carrier
                      (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                     {group_id G})"
   (SIMP_TAC [GROUP_MONOMORPHISM_GROUP_SUM_GEN,
             CARRIER_SUBGROUP_GENERATED_SUBGROUP] THEN
    REWRITE_TAC [subgroup_of, pairwise] THEN SET_TAC [])

  let GROUP_MONOMORPHISM_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
          (!i. i IN k ==> (h i) subgroup_of G) /\
          pairwise (\i j. !x y. x IN h i /\ y IN h j
                                ==> group_mul G x y = group_mul G y x) k /\
          (!i. i IN k
                 ==> h i INTER
                     group_carrier
                      (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                     {group_id G})
          ==> group_monomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                                (group_sum G k)"
   (SIMP_TAC [GROUP_MONOMORPHISM_GROUP_SUM_EQ])

  let GROUP_MONOMORPHISM_ABELIAN_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
          abelian_group G /\
          (!i. i IN k ==> (h i) subgroup_of G) /\
          (!i. i IN k
                 ==> h i INTER
                     group_carrier
                      (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                     {group_id G})
          ==> group_monomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                                 (group_sum G k)"
   (SIMP_TAC [GROUP_MONOMORPHISM_GROUP_SUM_EQ] THEN
    REWRITE_TAC [abelian_group, subgroup_of, pairwise] THEN SET_TAC [])

  let SUBGROUP_ISOMORPHISM_GROUP_SUM_GEN ← prove
   r"!k G (h:K->A->bool).
          group_isomorphism (sum_group k (\i. subgroup_generated G (h i)),
                             subgroup_generated G (UNIONS {h i | i IN k}))
                            (group_sum G k) <=>
          pairwise (\i j. !x y. x IN group_carrier G /\ x IN (h i) /\
                                y IN group_carrier G /\ y IN (h j)
                                ==> group_mul G x y = group_mul G y x) k /\
          !i. i IN k
            ==> group_carrier
                   (subgroup_generated G (h i)) INTER
                group_carrier
                   (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                {group_id G}"
   (REWRITE_TAC [← GSYM SUBGROUP_MONOMORPHISM_EPIMORPHISM] THEN
    REWRITE_TAC [GROUP_MONOMORPHISM_GROUP_SUM_GEN] THEN
    SIMP_TAC [SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN, SUBSET_REFL] THEN
    CONV_TAC TAUT)

  -- @@RETURN BEGIN
  return { GROUP_MONOMORPHISM_GROUP_SUM_GEN, GROUP_MONOMORPHISM_GROUP_SUM_EQ,
           GROUP_MONOMORPHISM_GROUP_SUM, GROUP_MONOMORPHISM_ABELIAN_GROUP_SUM,
           SUBGROUP_ISOMORPHISM_GROUP_SUM_GEN }
  -- @@RETURN END

structure SumGroupIsomorphism where
  -- @@FIELDS
  SUBGROUP_ISOMORPHISM_GROUP_SUM_EQ : thm
  SUBGROUP_ISOMORPHISM_GROUP_SUM : thm
  SUBGROUP_ISOMORPHISM_ABELIAN_GROUP_SUM : thm
  GROUP_ISOMORPHISM_GROUP_SUM_GEN : thm
  GROUP_ISOMORPHISM_GROUP_SUM_EQ : thm
  GROUP_ISOMORPHISM_GROUP_SUM : thm
  GROUP_ISOMORPHISM_ABELIAN_GROUP_SUM : thm
  ISOMORPHIC_SUM_GROUP_GEN : thm
  ISOMORPHIC_SUM_GROUP : thm
  ISOMORPHIC_ABELIAN_SUM_GROUP : thm
  ISOMORPHIC_NORMAL_SUM_GROUP : thm
  deriving Inhabited

@[nospecialize]
def setupSumGroupIsomorphism [HolBase] (D : GroupTheoryDeps) (BAbelian : Abelian) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BNormalSubgroups : NormalSubgroups) (BGroupDisjointSum : GroupDisjointSum) (BGroupSumEpimorphism : GroupSumEpimorphism) (BGroupSumMonomorphism : GroupSumMonomorphism) :
    ExceptT String IO SumGroupIsomorphism := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { EXTENSION, .. } := D.core3
  let { SUBSET_REFL, SUBSET_TRANS, .. } := D.core7
  let { pairwise, .. } := D.core8
  let { abelian_group, .. } := BAbelian
  let { subgroup_of, .. } := BSubgroups
  let { SUBGROUP_GENERATED_MONO, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, .. } := BSubgroupGen1
  let { GROUP_MONOMORPHISM_EPIMORPHISM, SUBGROUP_MONOMORPHISM_EPIMORPHISM, .. } := BHomomorphisms2
  let { isomorphic_group, .. } := BIso1
  let { NORMAL_SUBGROUP_IMP_SUBGROUP, .. } := BNormalSubgroups
  let { GROUP_SUM_NORMAL_IMP_COMMUTING, .. } := BGroupDisjointSum
  let { GROUP_EPIMORPHISM_GROUP_SUM, GROUP_EPIMORPHISM_GROUP_SUM_EQ,
        GROUP_EPIMORPHISM_GROUP_SUM_GEN, SUBGROUP_EPIMORPHISM_GROUP_SUM,
        SUBGROUP_EPIMORPHISM_GROUP_SUM_EQ, .. } := BGroupSumEpimorphism
  let { GROUP_MONOMORPHISM_GROUP_SUM, GROUP_MONOMORPHISM_GROUP_SUM_EQ,
        GROUP_MONOMORPHISM_GROUP_SUM_GEN, .. } := BGroupSumMonomorphism
  -- @@SCOPE END

  let SUBGROUP_ISOMORPHISM_GROUP_SUM_EQ ← prove
   r"!k G (h:K->A->bool).
      (!i. i IN k ==> (h i) subgroup_of G)
      ==> (group_isomorphism (sum_group k (\i. subgroup_generated G (h i)),
                              subgroup_generated G (UNIONS {h i | i IN k}))
                             (group_sum G k) <=>
           pairwise (\i j. !x y. x IN (h i) /\ y IN (h j)
                                 ==> group_mul G x y = group_mul G y x) k /\
           !i. i IN k
               ==> h i INTER
                   group_carrier
                    (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                   {group_id G})"
   (REWRITE_TAC [← GSYM SUBGROUP_MONOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [GROUP_MONOMORPHISM_GROUP_SUM_EQ] THEN
    SIMP_TAC [SUBGROUP_EPIMORPHISM_GROUP_SUM_EQ, SUBSET_REFL] THEN
    CONV_TAC TAUT)

  let SUBGROUP_ISOMORPHISM_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
        (!i. i IN k ==> (h i) subgroup_of G) /\
        pairwise (\i j. !x y. x IN h i /\ y IN h j
                              ==> group_mul G x y = group_mul G y x) k /\
        (!i. i IN k
               ==> h i INTER
                   group_carrier
                    (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                   {group_id G})
        ==> group_isomorphism (sum_group k (\i. subgroup_generated G (h i)),
                               subgroup_generated G (UNIONS {h i | i IN k}))
                               (group_sum G k)"
   (REWRITE_TAC [← GSYM SUBGROUP_MONOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [GROUP_MONOMORPHISM_GROUP_SUM] THEN
    SIMP_TAC [SUBGROUP_EPIMORPHISM_GROUP_SUM, SUBSET_REFL] THEN
    CONV_TAC TAUT)

  let SUBGROUP_ISOMORPHISM_ABELIAN_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
        abelian_group G /\
        (!i. i IN k ==> (h i) subgroup_of G) /\
        (!i. i IN k
             ==> h i INTER
                 group_carrier
                   (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                 {group_id G})
        ==> group_isomorphism (sum_group k (\i. subgroup_generated G (h i)),
                               subgroup_generated G (UNIONS {h i | i IN k}))
                               (group_sum G k)"
   (REWRITE_TAC [abelian_group] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [SUBGROUP_ISOMORPHISM_GROUP_SUM_EQ, SUBSET_REFL, pairwise] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of]) THEN ASM SET_TAC [])

  let GROUP_ISOMORPHISM_GROUP_SUM_GEN ← prove
   r"!k G (h:K->A->bool).
        group_isomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                          (group_sum G k) <=>
        pairwise (\i j. !x y. x IN group_carrier G /\ x IN (h i) /\
                              y IN group_carrier G /\ y IN (h j)
                              ==> group_mul G x y = group_mul G y x) k /\
        subgroup_generated G (UNIONS {h i | i IN k}) = G /\
        !i. i IN k
          ==> group_carrier
                 (subgroup_generated G (h i)) INTER
              group_carrier
                 (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
              {group_id G}"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    REWRITE_TAC [GROUP_MONOMORPHISM_GROUP_SUM_GEN] THEN
    SIMP_TAC [GROUP_EPIMORPHISM_GROUP_SUM_GEN, SUBSET_REFL] THEN
    CONV_TAC TAUT)

  let GROUP_ISOMORPHISM_GROUP_SUM_EQ ← prove
   r"!k G (h:K->A->bool).
      (!i. i IN k ==> (h i) subgroup_of G)
      ==> (group_isomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                             (group_sum G k) <=>
           pairwise (\i j. !x y. x IN (h i) /\ y IN (h j)
                                 ==> group_mul G x y = group_mul G y x) k /\
           subgroup_generated G (UNIONS {h i | i IN k}) = G /\
           !i. i IN k
               ==> h i INTER
                   group_carrier
                    (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                   {group_id G})"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [GROUP_MONOMORPHISM_GROUP_SUM_EQ] THEN
    SIMP_TAC [GROUP_EPIMORPHISM_GROUP_SUM_EQ, SUBSET_REFL] THEN
    CONV_TAC TAUT)

  let GROUP_ISOMORPHISM_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
        (!i. i IN k ==> (h i) subgroup_of G) /\
        pairwise (\i j. !x y. x IN h i /\ y IN h j
                              ==> group_mul G x y = group_mul G y x) k /\
        subgroup_generated G (UNIONS {h i | i IN k}) = G /\
        (!i. i IN k
               ==> h i INTER
                   group_carrier
                    (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                   {group_id G})
        ==> group_isomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                               (group_sum G k)"
   (REWRITE_TAC [← GSYM GROUP_MONOMORPHISM_EPIMORPHISM] THEN
    SIMP_TAC [GROUP_MONOMORPHISM_GROUP_SUM] THEN
    SIMP_TAC [GROUP_EPIMORPHISM_GROUP_SUM, SUBSET_REFL] THEN
    CONV_TAC TAUT)

  let GROUP_ISOMORPHISM_ABELIAN_GROUP_SUM ← prove
   r"!k G (h:K->A->bool).
        abelian_group G /\
        (!i. i IN k ==> (h i) subgroup_of G) /\
        subgroup_generated G (UNIONS {h i | i IN k}) = G /\
        (!i. i IN k
             ==> h i INTER
                 group_carrier
                   (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                 {group_id G})
        ==> group_isomorphism (sum_group k (\i. subgroup_generated G (h i)),G)
                              (group_sum G k)"
   (REWRITE_TAC [abelian_group] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [GROUP_ISOMORPHISM_GROUP_SUM_EQ, SUBSET_REFL, pairwise] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [subgroup_of]) THEN ASM SET_TAC [])

  let ISOMORPHIC_SUM_GROUP_GEN ← prove
   r"!k G (h:K->A->bool).
        pairwise (\i j. !x y. x IN group_carrier G /\ x IN (h i) /\
                              y IN group_carrier G /\ y IN (h j)
                              ==> group_mul G x y = group_mul G y x) k /\
        subgroup_generated G (UNIONS {h i | i IN k}) = G /\
        (!i. i IN k
             ==> group_carrier
                    (subgroup_generated G (h i)) INTER
                 group_carrier
                    (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                 {group_id G})
        ==> sum_group k (\i. subgroup_generated G (h i)) isomorphic_group G"
   (REWRITE_TAC [← GSYM GROUP_ISOMORPHISM_GROUP_SUM_GEN, isomorphic_group] THEN
    MESON_TAC [])

  let ISOMORPHIC_SUM_GROUP ← prove
   r"!k G (h:K->A->bool).
        (!i. i IN k ==> (h i) subgroup_of G) /\
        pairwise (\i j. !x y. x IN h i /\ y IN h j
                              ==> group_mul G x y = group_mul G y x) k /\
        subgroup_generated G (UNIONS {h i | i IN k}) = G /\
        (!i. i IN k
               ==> h i INTER
                   group_carrier
                    (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                   {group_id G})
        ==> sum_group k (\i. subgroup_generated G (h i)) isomorphic_group G"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [isomorphic_group] THEN
    EXISTS_TAC (← q r"group_sum (G:A group) (k:K->bool)") THEN
    ASM_SIMP_TAC [GROUP_ISOMORPHISM_GROUP_SUM])

  let ISOMORPHIC_ABELIAN_SUM_GROUP ← prove
   r"!k G (h:K->A->bool).
        abelian_group G /\
        (!i. i IN k ==> (h i) subgroup_of G) /\
        subgroup_generated G (UNIONS {h i | i IN k}) = G /\
        (!i. i IN k
               ==> h i INTER
                   group_carrier
                    (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                   {group_id G})
        ==> sum_group k (\i. subgroup_generated G (h i)) isomorphic_group G"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [isomorphic_group] THEN
    EXISTS_TAC (← q r"group_sum (G:A group) (k:K->bool)") THEN
    ASM_SIMP_TAC [GROUP_ISOMORPHISM_ABELIAN_GROUP_SUM])

  let ISOMORPHIC_NORMAL_SUM_GROUP ← prove
   r"!k G (h:K->A->bool).
        (!i. i IN k ==> (h i) normal_subgroup_of G) /\
        subgroup_generated G (UNIONS {h i | i IN k}) = G /\
        (!i. i IN k
               ==> h i INTER
                   group_carrier
                    (subgroup_generated G (UNIONS {h j | j IN k DELETE i})) =
                   {group_id G})
        ==> sum_group k (\i. subgroup_generated G (h i)) isomorphic_group G"
   (← do
    let a1 ← SET_RULE (← q
     r"t SUBSET t' ==> s INTER t SUBSET s INTER t'")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC ISOMORPHIC_SUM_GROUP THEN
    ASM_SIMP_TAC [NORMAL_SUBGROUP_IMP_SUBGROUP] THEN
    REWRITE_TAC [pairwise] THEN MAP_EVERY X_GEN_TAC [(← q r"i:K"), (← q r"j:K")] THEN
    STRIP_TAC THEN MATCH_MP_TAC GROUP_SUM_NORMAL_IMP_COMMUTING THEN
    ASM_SIMP_TAC [] THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K") o
      GEN_REWRITE_RULE (BINDER_CONV o RAND_CONV) [EXTENSION]) THEN
    ASM_REWRITE_TAC [← GSYM EXTENSION] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC a1 THEN
    TRANS_TAC SUBSET_TRANS
     (← q r"group_carrier(subgroup_generated G ((h:K->A->bool) j))") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                   NORMAL_SUBGROUP_IMP_SUBGROUP, SUBSET_REFL],
      MATCH_MP_TAC SUBGROUP_GENERATED_MONO THEN ASM SET_TAC []]))

  -- @@RETURN BEGIN
  return { SUBGROUP_ISOMORPHISM_GROUP_SUM_EQ, SUBGROUP_ISOMORPHISM_GROUP_SUM,
           SUBGROUP_ISOMORPHISM_ABELIAN_GROUP_SUM, GROUP_ISOMORPHISM_GROUP_SUM_GEN,
           GROUP_ISOMORPHISM_GROUP_SUM_EQ, GROUP_ISOMORPHISM_GROUP_SUM,
           GROUP_ISOMORPHISM_ABELIAN_GROUP_SUM, ISOMORPHIC_SUM_GROUP_GEN,
           ISOMORPHIC_SUM_GROUP, ISOMORPHIC_ABELIAN_SUM_GROUP,
           ISOMORPHIC_NORMAL_SUM_GROUP }
  -- @@RETURN END

structure CarrierSubgroupGeneratedUnions where
  -- @@FIELDS
  CARRIER_SUBGROUP_GENERATED_UNIONS : thm
  CARRIER_SUBGROUP_GENERATED_UNIONS_ALT : thm
  CARRIER_SUBGROUP_GENERATED_UNIONS_FINITE : thm
  CARRIER_SUBGROUP_GENERATED_UNIONS_EXPLICIT : thm
  CARRIER_SUBGROUP_GENERATED_ALT : thm
  CARRIER_SUBGROUP_GENERATED_FINITE : thm
  CARRIER_SUBGROUP_GENERATED_EXPLICIT : thm
  deriving Inhabited

@[nospecialize]
def setupCarrierSubgroupGeneratedUnions [HolBase] (D : GroupTheoryDeps) (BDerived : Derived) (BPow : Pow) (BAbelian : Abelian) (BGroupProduct : GroupProduct) (BGroupProductMul : GroupProductMul) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BGroupSumEpimorphism : GroupSumEpimorphism) :
    ExceptT String IO CarrierSubgroupGeneratedUnions := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_REDUCE_CONV, MESON, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARTESIAN_PRODUCT_AS_RESTRICTIONS, COND_RAND, COND_RATOR, .. } := D.core1
  let { EMPTY_GSPEC, .. } := D.core2
  let { FINITE_EMPTY, FINITE_RESTRICT, FINITE_SING, FINITE_SUBSET, FINITE_UNION,
        FORALL_IN_GSPEC, .. } := D.core3
  let { IMAGE_EQ, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INT_ADD_LID, .. } := D.core4
  let { INT_NEG_EQ_0, IN_ELIM_THM, IN_GSPEC, IN_UNION, IN_UNIV, .. } := D.core5
  let { NOT_IMP, RESTRICTION, .. } := D.core6
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SUBSET, SUBSET_ANTISYM, SUBSET_REFL,
        SUBSET_RESTRICT, .. } := D.core7
  let { o_DEF, pairwise, .. } := D.core8
  let { GROUP_POW_1, group_pow, .. } := BDerived
  let { GROUP_NPOW, GROUP_ZPOW, GROUP_ZPOW_0, GROUP_ZPOW_ADD, GROUP_ZPOW_NEG, .. } := BPow
  let { abelian_group, .. } := BAbelian
  let { GROUP_SUM_EQ, GROUP_SUM_ID, GROUP_SUM_RESTRICT_SET, GROUP_SUM_SING,
        GROUP_SUM_SUPERSET, GROUP_SUM_SUPPORT, .. } := BGroupProduct
  let { ABELIAN_GROUP_SUM_INV, ABELIAN_GROUP_SUM_MUL, .. } := BGroupProductMul
  let { IN_SUBGROUP_SUM, IN_SUBGROUP_ZPOW, .. } := BSubgroups
  let { GROUP_ID_SUBGROUP, SUBGROUP_GENERATED, SUBGROUP_GENERATED_INDUCT,
        SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { SUBGROUP_GENERATED_INC, .. } := BSubgroupGen1
  let { SUM_GROUP_CLAUSES, .. } := BSumGroup
  let { group_epimorphism, .. } := BHomomorphisms
  let { SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN, .. } := BGroupSumEpimorphism
  -- @@SCOPE END

  let CARRIER_SUBGROUP_GENERATED_UNIONS ← prove
   r"!(G:A group) u.
        abelian_group G
        ==> group_carrier(subgroup_generated G (UNIONS u)) =
            IMAGE (group_sum G u)
                  (group_carrier (sum_group u (\i. subgroup_generated G i)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"u:(A->bool)->bool"), (← q r"u:(A->bool)->bool"),
                   (← q r"G:A group"), (← q r"\u:A->bool. u")]
          SUBGROUP_EPIMORPHISM_GROUP_SUM_GEN) THEN
    REWRITE_TAC [SUBSET_REFL, IN_GSPEC, pairwise, group_epimorphism] THEN
    DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).2)) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [abelian_group, SUBSET], SIMP_TAC []])

  let CARRIER_SUBGROUP_GENERATED_UNIONS_ALT ← prove
   r"!(G:A group) u.
        abelian_group G
        ==> group_carrier(subgroup_generated G (UNIONS u)) =
            { group_sum G u f | f |
              (!s. s IN u ==> f s IN group_carrier(subgroup_generated G s)) /\
              FINITE {s | s IN u /\ ~(f s = group_id G)}}"
   (← do
    let a2 ← TAUT (← q r"p /\ ~q <=> ~(p ==> q)")
    let a1 ← SET_RULE (← q
     r"{y | y IN {f x | P x} /\ Q y} = IMAGE f {x | P x /\ Q(f x)}")
    pure (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_UNIONS] THEN
    REWRITE_TAC [SUM_GROUP_CLAUSES, CARTESIAN_PRODUCT_AS_RESTRICTIONS] THEN
    REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED, a1] THEN
    ONCE_REWRITE_TAC [a2] THEN
    SIMP_TAC [RESTRICTION] THEN REWRITE_TAC [NOT_IMP, ← GSYM IMAGE_o, o_DEF] THEN
    GEN_REWRITE_TAC RAND_CONV [SIMPLE_IMAGE_GEN] THEN MATCH_MP_TAC IMAGE_EQ THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC GROUP_SUM_EQ THEN SIMP_TAC [RESTRICTION]))

  let CARRIER_SUBGROUP_GENERATED_UNIONS_FINITE ← prove
   r"!(G:A group) u.
        abelian_group G /\ FINITE u
        ==> group_carrier(subgroup_generated G (UNIONS u)) =
            { group_sum G u f | f |
              (!s. s IN u ==> f s IN group_carrier(subgroup_generated G s))}"
   (SIMP_TAC [CARRIER_SUBGROUP_GENERATED_UNIONS_ALT, FINITE_RESTRICT])

  let CARRIER_SUBGROUP_GENERATED_UNIONS_EXPLICIT ← prove
   r"!(G:A group) u.
        abelian_group G
        ==> group_carrier(subgroup_generated G (UNIONS u)) =
            { group_sum G t f | t,f |
              FINITE t /\ t SUBSET u /\
              (!s. s IN t ==> f s IN group_carrier(subgroup_generated G s))}"
   (← do
    let a1 ← SET_RULE (← q
     r"t SUBSET u ==> {x | x IN u /\ x IN t} = t")
    pure (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_UNIONS_ALT] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN ONCE_REWRITE_TAC [SUBSET] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:(A->bool)->A") THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC
       [(← q r"{s | s IN u /\ ~((f:(A->bool)->A) s = group_id G)}"),
        (← q r"f:(A->bool)->A")] THEN
      ASM_SIMP_TAC [IN_ELIM_THM, SUBSET_RESTRICT, GROUP_SUM_SUPPORT],
      MAP_EVERY X_GEN_TAC [(← q r"t:(A->bool)->bool"), (← q r"f:(A->bool)->A")] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"\s. if s IN t then (f:(A->bool)->A) s else group_id G") THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [GROUP_ID_SUBGROUP],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN SET_TAC [],
        ONCE_REWRITE_TAC [← GSYM GROUP_SUM_RESTRICT_SET] THEN
        ASM_SIMP_TAC [a1]]]))

  let CARRIER_SUBGROUP_GENERATED_ALT ← prove
   r"!G (s:A->bool).
        abelian_group G /\ s SUBSET group_carrier G
        ==> group_carrier(subgroup_generated G s) =
            { group_sum G s (\x. group_zpow G x (n x)) | n |
              FINITE {x | x IN s /\ ~(n x = &0)}}"
   (← do
    let a2 ← SET_RULE (← q
     r"x IN s ==> {y | y IN s /\ y = x} = {x}")
    let a1 ← MESON [] (← q r"(if p then F else T) <=> ~p")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"n:A->int") THEN DISCH_TAC THEN
      MATCH_MP_TAC IN_SUBGROUP_SUM THEN
      REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN
      X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
      MATCH_MP_TAC IN_SUBGROUP_ZPOW THEN
      ASM_SIMP_TAC [SUBGROUP_SUBGROUP_GENERATED, SUBGROUP_GENERATED_INC]] THEN
    REWRITE_TAC [SUBSET] THEN MATCH_MP_TAC SUBGROUP_GENERATED_INDUCT THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:A") THEN REPEAT DISCH_TAC THEN
      EXISTS_TAC (← q r"\y:A. if y = x then &1:int else &0") THEN
      REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      CONV_TAC INT_REDUCE_CONV THEN
      REWRITE_TAC [a1] THEN
      SIMP_TAC [GROUP_NPOW, group_pow, ← GSYM GROUP_SUM_RESTRICT_SET] THEN
      ASM_SIMP_TAC [a2] THEN
      ASM_SIMP_TAC [FINITE_SING, GROUP_SUM_SING, GROUP_POW_1],
      EXISTS_TAC (← q r"(\x. &0):A->int") THEN
      REWRITE_TAC [EMPTY_GSPEC, FINITE_EMPTY, GROUP_NPOW, group_pow] THEN
      REWRITE_TAC [GROUP_SUM_ID],
      X_GEN_TAC (← q r"n:A->int") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"\x. --((n:A->int) x)") THEN ASM_REWRITE_TAC [INT_NEG_EQ_0] THEN
      wPart lhand (fun t => do rand (← rand t)) ABELIAN_GROUP_SUM_INV THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, ← GSYM NOT_IMP]) THEN
      ASM_SIMP_TAC [← GSYM NOT_IMP, GROUP_ZPOW] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, NOT_IMP] THEN
        MESON_TAC [GROUP_ZPOW_0],
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC GROUP_SUM_EQ THEN
        ASM_SIMP_TAC [GROUP_ZPOW_NEG]],
      X_GEN_TAC (← q r"m:A->int") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"n:A->int") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"\x. ((m:A->int) x) + n x") THEN CONJ_TAC THENL
       [MAP_EVERY UNDISCH_TAC
         [(← q r"FINITE {x | x IN s /\ ~((n:A->int) x = &0)}"),
          (← q r"FINITE {x | x IN s /\ ~((m:A->int) x = &0)}")] THEN
        REWRITE_TAC [IMP_IMP, ← GSYM FINITE_UNION] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION] THEN
        MESON_TAC [INT_ADD_LID],
        ALL_TAC] THEN
      wPart lhand (fun t => do rand (← rand t)) ABELIAN_GROUP_SUM_MUL THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [← GSYM NOT_IMP, GROUP_ZPOW] THEN ANTS_TAC THENL
       [CONJ_TAC THENL
         [UNDISCH_TAC (← q r"FINITE {x | x IN s /\ ~((m:A->int) x = &0)}"),
          UNDISCH_TAC (← q r"FINITE {x | x IN s /\ ~((n:A->int) x = &0)}")] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        MESON_TAC [GROUP_ZPOW_0],
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC GROUP_SUM_EQ THEN
        ASM_SIMP_TAC [GROUP_ZPOW_ADD]]]))

  let CARRIER_SUBGROUP_GENERATED_FINITE ← prove
   r"!G (s:A->bool).
        abelian_group G /\ FINITE s /\ s SUBSET group_carrier G
        ==> group_carrier(subgroup_generated G s) =
            { group_sum G s (\x. group_zpow G x (n x)) | n IN (:A->int)}"
   (SIMP_TAC [CARRIER_SUBGROUP_GENERATED_ALT, IN_UNIV, FINITE_RESTRICT])

  let CARRIER_SUBGROUP_GENERATED_EXPLICIT ← prove
   r"!G (s:A->bool).
        abelian_group G /\ s SUBSET group_carrier G
        ==> group_carrier(subgroup_generated G s) =
            { group_sum G t (\x. group_zpow G x (n x)) | t,n |
              FINITE t /\ t SUBSET s}"
   (← do
    let a1 ← SET_RULE (← q
     r"t SUBSET u ==> {x | x IN u /\ x IN t} = t")
    pure (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [CARRIER_SUBGROUP_GENERATED_ALT] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN ONCE_REWRITE_TAC [SUBSET] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:A->int") THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC
       [(← q r"{x | x IN s /\ ~((f:A->int) x = &0)}"), (← q r"f:A->int")] THEN
      ASM_REWRITE_TAC [SUBSET_RESTRICT] THEN MATCH_MP_TAC GROUP_SUM_SUPERSET THEN
      SIMP_TAC [SUBSET_RESTRICT, IN_ELIM_THM, IMP_CONJ, GROUP_ZPOW_0],
      MAP_EVERY X_GEN_TAC [(← q r"t:A->bool"), (← q r"f:A->int")] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"\x. if x IN t then (f:A->int) x else &0") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        FINITE_SUBSET)) THEN SET_TAC [],
        REWRITE_TAC [COND_RAND, GROUP_ZPOW_0] THEN
        ONCE_REWRITE_TAC [← GSYM GROUP_SUM_RESTRICT_SET] THEN
        ASM_SIMP_TAC [a1]]]))

  -- @@RETURN BEGIN
  return { CARRIER_SUBGROUP_GENERATED_UNIONS, CARRIER_SUBGROUP_GENERATED_UNIONS_ALT,
           CARRIER_SUBGROUP_GENERATED_UNIONS_FINITE,
           CARRIER_SUBGROUP_GENERATED_UNIONS_EXPLICIT, CARRIER_SUBGROUP_GENERATED_ALT,
           CARRIER_SUBGROUP_GENERATED_FINITE, CARRIER_SUBGROUP_GENERATED_EXPLICIT }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Structure theorems for periodic Abelian groups in terms of p-groups.      -/
/- ------------------------------------------------------------------------- -/

structure PrimeTorsion where
  -- @@FIELDS
  SUBGROUP_GENERATED_UNIONS_PRIME_TORSION_FINITE : thm
  SUBGROUP_GENERATED_UNIONS_PRIME_TORSION : thm
  deriving Inhabited

@[nospecialize]
def setupPrimeTorsion [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSubgroupGen2 : SubgroupGen2) (BGroupElementOrder : GroupElementOrder) (BGroupElementOrder2 : GroupElementOrder2) (BOrderDecomp : OrderDecomp) :
    ExceptT String IO PrimeTorsion := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { COPRIME_LEXP, DIVIDES_0, DIVIDES_PRIME_PRIME, EXP_EQ_0, .. } := D.core2
  let { FINITE_INDUCT_STRONG, FINITE_INSERT, FINITE_SPECIAL_DIVISORS, FINITE_SUBSET,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, .. } := D.core3
  let { IMAGE_CLAUSES, IMP_CONJ, INFINITE, .. } := D.core4
  let { IN_ELIM_THM, IN_SING, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, PRIMES_INFINITE, PRIME_0, PRIME_COPRIME_EQ,
        PRIME_DIVEXP_EQ, PRIME_DIVPROD_EQ, PRIME_FACTOR, .. } := D.core6
  let { SIMPLE_IMAGE_GEN, SUBSET, SUBSET_TRANS, UNIONS_0, UNIONS_INSERT, UNIONS_SUBSET,
        UNION_SUBSET, .. } := D.core7
  let { trivial_group, .. } := BBasics
  let { IN_SUBGROUP_MUL, .. } := BSubgroups
  let { SUBGROUPS_GENERATED_EQ, SUBGROUP_GENERATED, SUBGROUP_GENERATED_MONO,
        SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { SUBGROUP_GENERATED_INC, SUBSET_CARRIER_SUBGROUP_GENERATED, .. } := BSubgroupGen1
  let { TRIVIAL_GROUP_SUBGROUP_GENERATED_EMPTY, .. } := BSubgroupGen2
  let { GROUP_ELEMENT_ORDER_EQ_1, .. } := BGroupElementOrder
  let { GROUP_ELEMENT_ORDER_MUL_EQ, .. } := BGroupElementOrder2
  let { GROUP_ELEMENT_ORDER_PRIMEPOW_DECOMP, .. } := BOrderDecomp
  -- @@SCOPE END

  let SUBGROUP_GENERATED_UNIONS_PRIME_TORSION_FINITE ← prove
   r"!(G:A group) P.
      FINITE {p | prime p /\ P p}
      ==> subgroup_generated G
           (UNIONS
            {{ x | x IN group_carrier G /\
                   ?k. group_element_order G x = p EXP k} | prime p /\ P p}) =
          subgroup_generated G
           {x | x IN group_carrier G /\
                !p. prime p /\ p divides group_element_order G x ==> P p}"
   (← do
    let a5 ← SET_RULE (← q
     r"group_carrier(subgroup_generated G t) SUBSET
       group_carrier(subgroup_generated G (s UNION t)) /\
       x IN group_carrier(subgroup_generated G t)
       ==> x IN group_carrier(subgroup_generated G (s UNION t))")
    let a4 ← SET_RULE (← q
     r"(!q. prime q ==> P q \/ Q q ==> q IN p INSERT t)
       ==> ~Q p ==> (!q. prime q /\ Q q ==> q IN t)")
    let a3 ← SET_RULE (← q
     r"~({p | prime p} SUBSET s) ==> (!p. prime p ==> p IN s) ==> Q")
    let a2 ← TAUT (← q r"~p ==> q <=> p \/ q")
    let a1 ← SET_RULE (← q
     r"!p. p IN {p | prime p /\ P p} ==> prime p")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBGROUPS_GENERATED_EQ THEN CONJ_TAC THENL
     [REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC SUBSET_CARRIER_SUBGROUP_GENERATED THEN
      SIMP_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [PRIME_DIVEXP_EQ, DIVIDES_PRIME_PRIME],
      ALL_TAC] THEN
    TRANS_TAC SUBSET_TRANS
     (← q r"{x | x IN group_carrier G /\
           !p. prime p /\ p divides group_element_order G (x:A)
               ==> p IN {p | prime p /\ P p}}") THEN
    CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [SIMPLE_IMAGE_GEN] THEN
    MP_TAC a1 THEN
    UNDISCH_TAC (← q r"FINITE {p | prime p /\ P p}") THEN
    SPEC_TAC (← q r"{p | prime p /\ P p}", ← q r"t:num->bool") THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [NOT_IN_EMPTY, IMAGE_CLAUSES, UNIONS_0] THEN CONJ_TAC THENL
     [REWRITE_TAC [← CONJUNCT2 SUBGROUP_GENERATED,
       ← REWRITE_RULE [trivial_group] TRIVIAL_GROUP_SUBGROUP_GENERATED_EMPTY] THEN
      SIMP_TAC [SUBSET, IN_ELIM_THM, IN_SING, ← GSYM GROUP_ELEMENT_ORDER_EQ_1] THEN
      MESON_TAC [PRIME_FACTOR],
      REWRITE_TAC [FORALL_IN_INSERT, UNIONS_INSERT]] THEN
    MAP_EVERY X_GEN_TAC [(← q r"p:num"), (← q r"t:num->bool")] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    DISCH_THEN (fun th => tactic_of do pure (STRIP_TAC THEN MP_TAC th)) THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"z:A") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"z:A"), (← q r"p:num")]
      GROUP_ELEMENT_ORDER_PRIMEPOW_DECOMP) THEN
    ASM_REWRITE_TAC [a2] THEN
    DISCH_THEN (DISJ_CASES_THEN2 SUBST1_TAC MP_TAC) THENL
     [ASM_REWRITE_TAC [DIVIDES_0] THEN
      MATCH_MP_TAC a3 THEN
      ASM_MESON_TAC [PRIMES_INFINITE, INFINITE, FINITE_INSERT, FINITE_SUBSET],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [(← q r"x:A"), (← q r"y:A")] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"G:A group"), (← q r"x:A"), (← q r"y:A")]
          GROUP_ELEMENT_ORDER_MUL_EQ) THEN
    ASM_REWRITE_TAC [COPRIME_LEXP] THEN DISCH_THEN SUBST1_TAC THEN
    SIMP_TAC [IMP_CONJ, PRIME_DIVPROD_EQ, PRIME_DIVEXP_EQ] THEN
    DISCH_THEN (MP_TAC o MATCH_MP a4) THEN
    ASM_SIMP_TAC [← GSYM PRIME_COPRIME_EQ] THEN DISCH_TAC THEN
    SUBST1_TAC (← SYM (← ASSUME (← q r"group_mul G x y:A = z"))) THEN
    MATCH_MP_TAC IN_SUBGROUP_MUL THEN
    REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED] THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUBGROUP_GENERATED_INC THEN
      REWRITE_TAC [UNION_SUBSET, UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC a5 THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUBGROUP_GENERATED_MONO THEN SET_TAC [],
      FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
      ASM SET_TAC []]))

  let SUBGROUP_GENERATED_UNIONS_PRIME_TORSION ← prove
   r"!(G:A group) P.
        subgroup_generated G
         (UNIONS
           {{ x | x IN group_carrier G /\
                  ?k. group_element_order G x = p EXP k} | prime p /\ P p}) =
        subgroup_generated G
         {x | x IN group_carrier G /\ ~(group_element_order G x = 0) /\
              !p. prime p /\ p divides group_element_order G x ==> P p}"
   (← do
    let a1 ← SET_RULE (← q
     r"!s. x IN s /\ s SUBSET t ==> x IN t")
    pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBGROUPS_GENERATED_EQ THEN CONJ_TAC THENL
     [REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC SUBSET_CARRIER_SUBGROUP_GENERATED THEN
      SIMP_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [EXP_EQ_0] THEN
      ASM_MESON_TAC [PRIME_DIVEXP_EQ, DIVIDES_PRIME_PRIME, PRIME_0],
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC]] THEN
    X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
    MATCH_MP_TAC a1 THEN
    EXISTS_TAC
     (← q r"group_carrier(subgroup_generated G
       (UNIONS
        {{y | y IN group_carrier G /\ ?k. group_element_order G y = q EXP k} |q|
         prime q /\ q IN {p | p divides group_element_order G (x:A)}}))") THEN
    CONJ_TAC THENL
     [ALL_TAC, MATCH_MP_TAC SUBGROUP_GENERATED_MONO THEN ASM SET_TAC []] THEN
    wPart (fun t => do rand (← rand t)) (fun t => do lhand (← rand t))
      SUBGROUP_GENERATED_UNIONS_PRIME_TORSION_FINITE THEN
    ASM_SIMP_TAC [FINITE_SPECIAL_DIVISORS, IN_ELIM_THM] THEN
    DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC SUBGROUP_GENERATED_INC THEN
    ASM SET_TAC []))

  -- @@RETURN BEGIN
  return { SUBGROUP_GENERATED_UNIONS_PRIME_TORSION_FINITE,
           SUBGROUP_GENERATED_UNIONS_PRIME_TORSION }
  -- @@RETURN END

structure TorsionStructure where
  -- @@FIELDS
  SUBGROUP_GENERATED_UNIONS_PRIME_TORSION_FULL : thm
  PGROUP_PRIME_TORSION : thm
  PGROUP_SUBSET_PRIME_TORSION : thm
  ABELIAN_GROUP_TORSION_ISOMORPHISM : thm
  ABELIAN_GROUP_TORSION_STRUCTURE : thm
  TORSION_ABELIAN_GROUP_ISOMORPHISM : thm
  TORSION_ABELIAN_GROUP_STRUCTURE : thm
  FINITE_ABELIAN_GROUP_STRUCTURE : thm
  FINITE_ABELIAN_GROUP_STRUCTURE_ALT : thm
  TORSION_ABELIAN_GROUP_AS_SUM_OF_PGROUPS : thm
  deriving Inhabited

@[nospecialize]
def setupTorsionStructure [HolBase] (D : GroupTheoryDeps) (BBasics : Basics) (BSubgroups : Subgroups) (BSubgroupGenerated : SubgroupGenerated) (BSubgroupGen1 : SubgroupGen1) (BSumGroup : SumGroup) (BHomomorphisms : Homomorphisms) (BHomomorphisms2 : Homomorphisms2) (BIso1 : Iso1) (BGroupElementOrder : GroupElementOrder) (BGroupElementOrder2 : GroupElementOrder2) (BOrderDecomp : OrderDecomp) (BTorsionSubgroups : TorsionSubgroups) (BCyclicGroups3 : CyclicGroups3) (BPgroup : Pgroup) (BGroupDisjointSum : GroupDisjointSum) (BSumGroupIsomorphism : SumGroupIsomorphism) (BPrimeTorsion : PrimeTorsion) :
    ExceptT String IO TorsionStructure := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, NUMBER_RULE, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARD_EQ_0, .. } := D.core1
  let { DIVIDES_PRIME_PRIME, DIVIDES_REFL, EQ_IMP, EXP, EXP_EQ_0, EXP_EQ_1, .. } := D.core2
  let { FINITE_SPECIAL_DIVISORS, FORALL_IN_IMAGE, .. } := D.core3
  let { IMP_CONJ, IMP_CONJ_ALT, .. } := D.core4
  let { IN_CARTESIAN_PRODUCT, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_SING,
        IN_UNION, IN_UNIV, .. } := D.core5
  let { LEFT_IMP_EXISTS_THM, PRIME_0, PRIME_DIVEXP_EQ, .. } := D.core6
  let { SUBSET, .. } := D.core7
  let { GROUP_CARRIER_NONEMPTY, .. } := BBasics
  let { SUBGROUP_OF_INTER, .. } := BSubgroups
  let { SUBGROUP_SUBGROUP_GENERATED, .. } := BSubgroupGenerated
  let { CARRIER_SUBGROUP_GENERATED_SUBGROUP, SUBGROUP_GENERATED_INC_GEN,
        SUBGROUP_GENERATED_REFL, TRIVIAL_GROUP_SUBGROUP_GENERATED_EQ, .. } := BSubgroupGen1
  let { SUM_GROUP_CLAUSES, SUM_GROUP_EQ_PRODUCT_GROUP, .. } := BSumGroup
  let { group_epimorphism, .. } := BHomomorphisms
  let { GROUP_ISOMORPHISM_IMP_EPIMORPHISM, GROUP_ISOMORPHISM_IMP_MONOMORPHISM, .. } := BHomomorphisms2
  let { GROUP_ISOMORPHISM_IMP_ISOMORPHIC, ISOMORPHIC_GROUP_SYM, ISOMORPHIC_GROUP_TRANS,
        ISOMORPHIC_SUM_GROUP_SYMDIFF, isomorphic_group, .. } := BIso1
  let { FINITE_GROUP_ELEMENT_ORDER_NONZERO, GROUP_ELEMENT_ORDER_EQ_1, .. } := BGroupElementOrder
  let { GROUP_ELEMENT_ORDER_MONOMORPHIC_IMAGE, .. } := BGroupElementOrder2
  let { GROUP_ELEMENT_ORDER_SUBGROUP_GENERATED, GROUP_ELEMENT_ORDER_SUM_GROUP_EQ_0, .. } := BOrderDecomp
  let { SUBGROUP_OF_PRIMES_TORSION, SUBGROUP_OF_PRIME_TORSION, SUBGROUP_OF_TORSION, .. } := BTorsionSubgroups
  let { GROUP_ELEMENT_ORDER_DIVIDES_GROUP_ORDER, .. } := BCyclicGroups3
  let { PGROUP_SING, .. } := BPgroup
  let { GROUP_DISJOINT_SUM_ALT, .. } := BGroupDisjointSum
  let { SUBGROUP_ISOMORPHISM_ABELIAN_GROUP_SUM, .. } := BSumGroupIsomorphism
  let { SUBGROUP_GENERATED_UNIONS_PRIME_TORSION, .. } := BPrimeTorsion
  -- @@SCOPE END

  let SUBGROUP_GENERATED_UNIONS_PRIME_TORSION_FULL ← prove
   r"!(G:A group).
        subgroup_generated G
         (UNIONS
           {{ x | x IN group_carrier G /\
                  ?k. group_element_order G x = p EXP k} | prime p}) =
        subgroup_generated G
         {x | x IN group_carrier G /\ ~(group_element_order G x = 0)}"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"prime p <=> prime p /\ p IN (:num)")] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_UNIONS_PRIME_TORSION] THEN
    REWRITE_TAC [IN_UNIV])

  let PGROUP_PRIME_TORSION ← prove
   r"!(G:A group) p.
        abelian_group G /\ prime p
        ==> pgroup {p} (subgroup_generated G
                         {x | x IN group_carrier G /\
                              ?k. group_element_order G x = p EXP k})"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [PGROUP_SING, CARRIER_SUBGROUP_GENERATED_SUBGROUP,
                 SUBGROUP_OF_PRIME_TORSION, IN_ELIM_THM,
                 GROUP_ELEMENT_ORDER_SUBGROUP_GENERATED])

  let PGROUP_SUBSET_PRIME_TORSION ← prove
   r"!(G:A group) p s.
        prime p /\
        s SUBSET group_carrier G /\
        pgroup {p} (subgroup_generated G s)
        ==> s SUBSET {x | x IN group_carrier G /\
                          ?k. group_element_order G x = p EXP k}"
   (REPEAT GEN_TAC THEN SIMP_TAC [IMP_CONJ, PGROUP_SING, SUBSET] THEN
    REWRITE_TAC [GROUP_ELEMENT_ORDER_SUBGROUP_GENERATED] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [IN_ELIM_THM] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [SUBGROUP_GENERATED_INC_GEN])

  let ABELIAN_GROUP_TORSION_ISOMORPHISM ← prove
   r"!G:A group.
        abelian_group G
        ==> group_isomorphism
             (sum_group {p | prime p}
               (\p. subgroup_generated G
                     {x | x IN group_carrier G /\
                          ?k. group_element_order G x = p EXP k}),
              subgroup_generated G
               {x | x IN group_carrier G /\ ~(group_element_order G x = 0)})
             (group_sum G {p | prime p})"
   (REPEAT STRIP_TAC THEN
    wPart (fun t => do lhand (← lhand t)) (fun t => do lhand (← lhand (← rand t)))
        SUBGROUP_ISOMORPHISM_ABELIAN_GROUP_SUM THEN
    REWRITE_TAC [SUBGROUP_GENERATED_UNIONS_PRIME_TORSION_FULL, IN_ELIM_THM] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [SUBGROUP_OF_PRIME_TORSION, IN_DELETE, IN_ELIM_THM] THEN
    REWRITE_TAC [SUBGROUP_GENERATED_UNIONS_PRIME_TORSION] THEN
    X_GEN_TAC (← q r"p:num") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [← GSYM GROUP_DISJOINT_SUM_ALT, SUBGROUP_OF_PRIME_TORSION,
                 SUBGROUP_SUBGROUP_GENERATED] THEN
    REWRITE_TAC [SUBSET, IN_INTER, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_THEN (CONJUNCTS_THEN2
     (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_TAC (← q r"k:num"))) MP_TAC) THEN
    wPart (fun t => do rand (← lhand t)) (fun t => do lhand (← rand t))
      CARRIER_SUBGROUP_GENERATED_SUBGROUP THEN
    ANTS_TAC THENL
     [ONCE_REWRITE_TAC [← SET_RULE (← q
       r"{x | P x /\ Q x /\ R x} = {x | P x /\ Q x} INTER {x | P x /\ R x}")] THEN
      MATCH_MP_TAC SUBGROUP_OF_INTER THEN
      ASM_SIMP_TAC [SUBGROUP_OF_TORSION, SUBGROUP_OF_PRIMES_TORSION],
      DISCH_THEN SUBST1_TAC] THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, EXP_EQ_0, IMP_CONJ, IN_SING] THEN
    DISCH_THEN (K ALL_TAC) THEN ASM_SIMP_TAC [← GSYM GROUP_ELEMENT_ORDER_EQ_1] THEN
    ASM_SIMP_TAC [PRIME_DIVEXP_EQ, DIVIDES_PRIME_PRIME, EXP_EQ_1] THEN
    ASM_MESON_TAC [])

  let ABELIAN_GROUP_TORSION_STRUCTURE ← prove
   r"!G:A group.
        abelian_group G
        ==> subgroup_generated G
               {x | x IN group_carrier G /\ ~(group_element_order G x = 0)}
            isomorphic_group
            sum_group {p | prime p}
              (\p. subgroup_generated G
                     {x | x IN group_carrier G /\
                          ?k. group_element_order G x = p EXP k})"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← MATCH_MP ABELIAN_GROUP_TORSION_ISOMORPHISM th))) THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC])

  let TORSION_ABELIAN_GROUP_ISOMORPHISM ← prove
   r"!G:A group.
        abelian_group G /\
        (!x. x IN group_carrier G ==> ~(group_element_order G x = 0))
        ==> group_isomorphism
             (sum_group {p | prime p}
               (\p. subgroup_generated G
                     {x | x IN group_carrier G /\
                          ?k. group_element_order G x = p EXP k}),
              G)
             (group_sum G {p | prime p})"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (fun th => tactic_of do pure (MP_TAC (← MATCH_MP ABELIAN_GROUP_TORSION_ISOMORPHISM th)))
     ASSUME_TAC) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    MATCH_MP_TAC SUBGROUP_GENERATED_REFL THEN ASM SET_TAC [])

  let TORSION_ABELIAN_GROUP_STRUCTURE ← prove
   r"!G:A group.
        abelian_group G /\
        (!x. x IN group_carrier G ==> ~(group_element_order G x = 0))
        ==> G isomorphic_group
            sum_group {p | prime p}
              (\p. subgroup_generated G
                     {x | x IN group_carrier G /\
                          ?k. group_element_order G x = p EXP k})"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [ISOMORPHIC_GROUP_SYM] THEN
    DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← MATCH_MP TORSION_ABELIAN_GROUP_ISOMORPHISM th))) THEN
    REWRITE_TAC [GROUP_ISOMORPHISM_IMP_ISOMORPHIC])

  let FINITE_ABELIAN_GROUP_STRUCTURE ← prove
   r"!G:A group.
        abelian_group G /\ FINITE(group_carrier G)
        ==> G isomorphic_group
            sum_group {p | prime p /\ p divides CARD(group_carrier G)}
              (\p. subgroup_generated G
                     {x | x IN group_carrier G /\
                          ?k. group_element_order G x = p EXP k})"
   (← do
    let a2 ← NUMBER_RULE (← q
     r"(p:num) divides pk /\ x divides g ==> x = pk ==> p divides g")
    let a1 ← TAUT (← q r"(q ==> p) ==> (~p ==> q ==> r)")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"G:A group") TORSION_ABELIAN_GROUP_STRUCTURE) THEN ANTS_TAC
    THENL [ASM_SIMP_TAC [FINITE_GROUP_ELEMENT_ORDER_NONZERO], ALL_TAC] THEN
