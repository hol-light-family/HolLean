    SUBGOAL_THEN (← q r"(c:A->bool) subgroup_of G") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBGROUP_SUBGROUP_GENERATED], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(c:A->bool) normal_subgroup_of G") ASSUME_TAC THENL
