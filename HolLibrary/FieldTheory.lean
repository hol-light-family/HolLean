    REWRITE_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC t2 THEN
    DISCH_THEN (MP_TAC o MATCH_MP g3) THEN
    REWRITE_TAC [] THEN DISCH_TAC THEN
