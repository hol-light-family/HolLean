  let SPLITTING_EXTENSION_DEGREE_DIVIDES_FACT ← (do
    -- the `let lemma = prove ... in` runs first, its rules right to left (the
    -- MESON, the second SET_RULE, the first SET_RULE); then the main proof's
    -- SET_RULE
    let lm3 ← MESON [DIVIDES_MUL2, MULT_CLAUSES]
     (← q r"a divides 1 /\ b divides c ==> (a * b) divides c")
    let ls2 ← SET_RULE (← q r"(t:B->bool) SUBSET s ==> s UNION t = s")
    let ls1 ← SET_RULE (← q r"(r:B->bool) SUBSET s ==> s UNION r = s")
    let lemma ← prove
     r"!n (k:B ring) l p.
        splitting_extension(k,l) I p /\ poly_deg k p = n
        ==> extension_degree(k,l) I divides FACT n"
     (MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q r"n:num") THEN
      DISCH_THEN (LABEL_TAC "ih") THEN
      MAP_EVERY X_GEN_TAC [← q r"k:B ring", ← q r"l:B ring", ← q r"p:(1->num)->B"] THEN
      STRIP_TAC THEN
      MP_TAC (← ASSUME (← q r"splitting_extension(k,l) (I:B->B) p")) THEN
