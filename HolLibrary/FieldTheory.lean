    MESON_TAC [SUBRING_SUBSET_SUBFIELD_GENERATED, SUBRING_GENERATED_RING_CARRIER,
              SUBSET_TRANS])

  let SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET ← prove
   r"!r s:A->bool.
