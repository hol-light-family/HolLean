    REWRITE_TAC [subfield_of, SUBRING_OF_SUBFIELD_GENERATED_EQ] THEN
    REWRITE_TAC [t1] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(h:A->bool) subring_of (subfield_generated r k)")
    ASSUME_TAC THENL
