    REWRITE_TAC [s1] THEN
    ONCE_REWRITE_TAC [← GSYM SUBRING_GENERATED_INSERT] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"b:B->bool"]
      FINITE_FINITELY_GENERATED_ALGEBRAIC_EXTENSION) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [SEPARABLE_ELEMENT_IMP_ALGEBRAIC, field_extension],
      ALL_TAC] THEN
    UNDISCH_TAC
     (← q r"separable_extension
     (k,subring_generated l (IMAGE (h:A->B) (ring_carrier k) UNION b)) h") THEN
    ABBREV_TAC
     (← q r"K = subring_generated l (IMAGE (h:A->B) (ring_carrier k) UNION b)") THEN
    REPEAT DISCH_TAC THEN
    SUBGOAL_THEN (← q r"field_extension (K,l) (I:B->B)") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN MATCH_MP_TAC FIELD_EXTENSION_FROM_SUBRING_GENERATED THEN
      ASM_MESON_TAC [FINITE_IMP_FIELD_EXTENSION, field_extension,
                     FIELD_EXTENSION_REFL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"separable_element (K,l) (I:B->B) y") ASSUME_TAC THENL
     [MATCH_MP_TAC SEPARABLE_ELEMENT_INTERMEDIATE THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN
      ASM_SIMP_TAC [I_O_ID, FINITE_IMP_FIELD_EXTENSION],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring", ← q r"y:B"]
      SEPARABLE_EXTENSION_SIMPLE) THEN
    ASM_REWRITE_TAC [IMAGE_I] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SEPARABLE_ELEMENT_IMP_ALGEBRAIC, field_extension],
      DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring",
                      ← q r"subring_generated l ((y:B) INSERT ring_carrier K)"]
      SEPARABLE_EXTENSION_TRANS) THEN
    ASM_REWRITE_TAC [I_O_ID]))

  -- @@RETURN BEGIN
  return { separable_degree, SEPARABLE_DEGREE, HAS_SIZE_SEPARABLE_DEGREE,
           SEPARABLE_DEGREE_LE_EXTENSION_DEGREE, SEPARABLE_DEGREE_TOWER,
           SEPARABLE_DEGREE_SIMPLE, SEPARABLE_DEGREE_SIMPLE_LT,
           SEPARABLE_DEGREE_EQ_EXTENSION_DEGREE, SEPARABLE_EXTENSION_SIMPLE,
           SEPARABLE_EXTENSION_TRANS, SEPARABLE_EXTENSION_TRANS_EQ,
           SEPARABLE_EXTENSION_GENERATED_BY_SEPARABLE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Separable elements under monomorphic images and p-th powers.              -/
/- (fieldtheory.ml 12604-12879)                                              -/
/- ------------------------------------------------------------------------- -/

structure SeparablePowers where
  -- @@FIELDS
  SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE : thm
  SEPARABLE_ELEMENT_POW_IN_IMAGE : thm
  SEPARABLE_ELEMENT_POW_EXISTS : thm
  MINIMAL_POLYNOMIAL_DEG_EQ_CHAR : thm
  deriving Inhabited

@[nospecialize]
def setupSeparablePowers [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BMinimalPolynomial : MinimalPolynomial) (BAlgebraicField : AlgebraicField) (BAlgebraicTrans : AlgebraicTrans) (BAlgebraicClosure : AlgebraicClosure) (BSeparableExtension : SeparableExtension) (BSeparableRoots : SeparableRoots) :
    ExceptT String IO SeparablePowers := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, .. } := D
  let { DE_MORGAN_THM, EXP, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_NONTRIVIAL, FINITE_SING, .. } := D.core2
  let { IMP_CONJ, IN_ELIM_THM, IN_IMAGE, IN_SING, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { POLY_DEG_0, .. } := D.core4
  let { POLY_EXTEND_CONST, POLY_EXTEND_EVALUATE, POLY_EXTEND_SUB, .. } := D.core5
  let { RING_DIVIDES_HOMOMORPHIC_IMAGE, RING_DIVIDES_ZERO,
        RING_HOMOMORPHISM_POLY_EXTEND, RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_POLYNOMIAL, RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_SUB,
        RING_POLYNOMIAL_VAR, RING_POW, RING_SUB_EQ_0, RING_SUB_REFL, .. } := D.core7
  let { SUBSET, num_WF, .. } := D.core8
  let { o_THM, poly_eval, .. } := D.core9
  let { CARD_SING, CARD_SUBSET, EXP_1, IRREDUCIBLE_IMP_POLY_DEG_NZ, LET_TRANS,
        LE_MULT_LCANCEL, LT_MULT_RCANCEL, MULT_EQ_0, POLY_DEG_SUB_CONST,
        POLY_DEG_VAR_POW, POLY_DERIV_EQ_0_EXPLICIT, POLY_EXTEND_VARPOW,
        POLY_SEPARABLE_EQ_DERIV_NONZERO, PRIME_GE_2, PRIME_IMP_NZ,
        RING_CHAR_MONOMORPHIC_IMAGE, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { RING_HOMOMORPHISM_POW, RING_MONOMORPHISM_FROBENIUS_ITERATE,
        RING_MONOMORPHISM_INJECTIVE_EQ, RING_POLYNOMIAL_POW, RING_POW_1, RING_POW_POW, .. } := D.core11
  let { FIELD_EXTENSION_CARRIER, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_TRANS, field_extension, .. } := BFieldExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, ALGEBRAIC_OVER_IMAGE, ALGEBRAIC_OVER_IN_CARRIER, .. } := BAlgebraicExtension
  let { MINIMAL_POLYNOMIAL, MINIMAL_POLYNOMIAL_DEG_EQ_1, MINIMAL_POLYNOMIAL_DEG_LE,
        MINIMAL_POLYNOMIAL_DIVIDES, .. } := BMinimalPolynomial
  let { ALGEBRAIC_OVER_POW, ALGEBRAIC_OVER_POW_EQ, .. } := BAlgebraicField
  let { MINIMAL_POLYNOMIAL_MONOMORPHIC_IMAGE, .. } := BAlgebraicTrans
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { SEPARABLE_ELEMENT_IMP_ALGEBRAIC, separable_element, .. } := BSeparableExtension
  let { POLY_SEPARABLE_ROOT_COUNT_EQ, .. } := BSeparableRoots
  -- @@SCOPE END

  let SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE ← prove
   r"!(f:A->B) (g:B->C) k l m x.
        x IN ring_carrier l /\
        ring_homomorphism(k,l) f /\ ring_monomorphism(l,m) g
        ==> (separable_element (k,m) (g o f) (g x) <=>
             separable_element (k,l) f x)"
   (SIMP_TAC [separable_element, MINIMAL_POLYNOMIAL_MONOMORPHIC_IMAGE])

  let SEPARABLE_ELEMENT_POW_IN_IMAGE ← prove
   r"!(h:A->B) k l x n.
        field_extension(k,l) h /\ prime(ring_char k) /\
        separable_element(k,l) h x /\
        ring_pow l x (ring_char k EXP n) IN IMAGE h (ring_carrier k)
        ==> x IN IMAGE h (ring_carrier k)"
   (← do
    -- right to left: the MESON, then the ARITH_RULE
    let m2 ← MESON [CARD_SING, CARD_SUBSET, FINITE_SING]
     (← q r"(?a:B#num. s SUBSET {a}) ==> CARD s <= 1")
    let a1 ← ARITH_RULE (← q r"~(n = 0) /\ n <= 1 ==> n = 1")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [SEPARABLE_ELEMENT_IMP_ALGEBRAIC], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_OVER_IN_CARRIER) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      MINIMAL_POLYNOMIAL_DEG_EQ_1) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    UNDISCH_TAC (← q r"separable_element(k,l) (h:A->B) x") THEN
    REWRITE_TAC [separable_element] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      MINIMAL_POLYNOMIAL) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"f = minimal_polynomial (k,l) (h:A->B) x") THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC a1 THEN
    CONJ_TAC THENL [ASM_MESON_TAC [IRREDUCIBLE_IMP_POLY_DEG_NZ], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"l:B ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:(B#num)ring", ← q r"j:B->B#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"field_extension(k,m) ((j:B->B#num) o (h:A->B))")
    ASSUME_TAC THENL [ASM_MESON_TAC [FIELD_EXTENSION_TRANS], ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"field_extension(l:B ring,m:(B#num)ring) j"
      if !(concl th == c) then throw "check"
      pure (MP_TAC th)) THEN
    REWRITE_TAC [field_extension] THEN STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"j:B->B#num"
      if !((← liftExcept (rand (concl th))) == c) then throw "check"
      pure ((ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) th)) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE I [IN_IMAGE]) THEN
    ABBREV_TAC (← q r"N = ring_char(k:A ring) EXP n") THEN
    MP_TAC (← ISPECL [← q r"(j:B->B#num) o (h:A->B)", ← q r"k:A ring", ← q r"m:(B#num)ring",
                      ← q r"f:(1->num)->A"] POLY_SEPARABLE_ROOT_COUNT_EQ) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC m2 THEN
    EXISTS_TAC (← q r"(j:B->B#num) x") THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_SING] THEN
    X_GEN_TAC (← q r"z:B#num") THEN STRIP_TAC THEN
    ABBREV_TAC
     (← q r"g = poly_sub k (poly_pow k (poly_var k one) N) (poly_const k (a:A))") THEN
    SUBGOAL_THEN (← q r"(g:(1->num)->A) IN ring_carrier(poly_ring k (:1))")
    ASSUME_TAC THENL
     [EXPAND_TAC "g" THEN REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR,
                    RING_POLYNOMIAL_CONST],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(h:A->B) a IN ring_carrier l") ASSUME_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_CARRIER], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_divides (poly_ring k (:1)) (f:(1->num)->A) g")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B", ← q r"g:(1->num)->A"]
        MINIMAL_POLYNOMIAL_DIVIDES) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN EXPAND_TAC "g" THEN
      ASM_SIMP_TAC [POLY_EXTEND_SUB, POLY_EXTEND_VARPOW, POLY_EXTEND_CONST,
                    RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR,
                    RING_POLYNOMIAL_CONST, RING_SUB_REFL],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"poly_ring (k:A ring) (:1)", ← q r"m:(B#num)ring",
                      ← q r"poly_extend (k,m) ((j:B->B#num) o (h:A->B)) (\v:1. z)",
                      ← q r"f:(1->num)->A", ← q r"g:(1->num)->A"]
      RING_DIVIDES_HOMOMORPHIC_IMAGE) THEN
    ASM_SIMP_TAC [RING_HOMOMORPHISM_POLY_EXTEND, FIELD_EXTENSION_IMP_HOMOMORPHISM,
                  POLY_EXTEND_EVALUATE, ← GSYM poly_eval, RING_DIVIDES_ZERO] THEN
    SUBGOAL_THEN
     (← q r"poly_eval m (((j:B->B#num) o (h:A->B)) o g) z =
    ring_sub m (ring_pow m z N) (j(h(a:A)))")
    SUBST1_TAC THENL
     [REWRITE_TAC [poly_eval] THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"m:(B#num)ring", ← q r"(j:B->B#num) o (h:A->B)",
                        ← q r"\v:1. (z:B#num)", ← q r"g:(1->num)->A"]
        POLY_EXTEND_EVALUATE) THEN
      ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN EXPAND_TAC "g" THEN
      ASM_SIMP_TAC [POLY_EXTEND_SUB, POLY_EXTEND_VARPOW, POLY_EXTEND_CONST,
                    RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR, o_THM,
                    FIELD_EXTENSION_IMP_HOMOMORPHISM, RING_POLYNOMIAL_CONST],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(j:B->B#num)(h(a:A)) = ring_pow m (j x) N") SUBST1_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"ring_pow l (x:B) N"
        if !((← liftExcept (lhand (concl th))) == c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"m:(B#num)ring", ← q r"j:B->B#num"]
        RING_HOMOMORPHISM_POW) THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(j:B->B#num) x IN ring_carrier m") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
    ASM_SIMP_TAC [RING_SUB_EQ_0, RING_POW] THEN
    MP_TAC (← ISPECL [← q r"m:(B#num)ring", ← q r"n:num"]
      RING_MONOMORPHISM_FROBENIUS_ITERATE) THEN
    SUBGOAL_THEN (← q r"ring_char(m:(B#num)ring) = ring_char(k:A ring)")
    SUBST1_TAC THENL
     [ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE, field_extension], ALL_TAC] THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"z:B#num", ← q r"(j:B->B#num) x"] o MATCH_MP
      (← REWRITE_RULE [IMP_CONJ] RING_MONOMORPHISM_INJECTIVE_EQ)) THEN
    ASM_SIMP_TAC []))

  let SEPARABLE_ELEMENT_POW_EXISTS ← prove
   r"!(h:A->B) k l x.
        field_extension(k,l) h /\ prime(ring_char k) /\ algebraic_over(k,l) h x
        ==> ?n. separable_element(k,l) h (ring_pow l x (ring_char k EXP n))"
   (← do
    let a1 ← ARITH_RULE (← q r"e < c * e <=> 1 * e < c * e")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    ABBREV_TAC (← q r"c = ring_char(k:A ring)") THEN
    SUBGOAL_THEN
     (← q r"!d y. algebraic_over(k,l) (h:A->B) y /\
          poly_deg k (minimal_polynomial(k,l) h y) = d
          ==> ?n. separable_element(k,l) h (ring_pow l y (c EXP n))")
     (fun th => ASM_MESON_TAC [th]) THEN
    MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q r"d:num") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"y:B") THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_OVER_IN_CARRIER) THEN
    ASM_CASES_TAC (← q r"separable_element(k,l) (h:A->B) y") THENL
     [EXISTS_TAC (← q r"0") THEN ASM_SIMP_TAC [EXP, RING_POW_1], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"y:B"]
      MINIMAL_POLYNOMIAL) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"f = minimal_polynomial (k,l) (h:A->B) y") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"poly_deriv k (f:(1->num)->A) = poly_0 k") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"f:(1->num)->A"]
        POLY_SEPARABLE_EQ_DERIV_NONZERO) THEN
      UNDISCH_TAC (← q r"~separable_element(k,l) (h:A->B) y") THEN
      ASM_REWRITE_TAC [separable_element] THEN MESON_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"f:(1->num)->A"] POLY_DERIV_EQ_0_EXPLICIT) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:(1->num)->A") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"poly_extend (k,l) (h:A->B) (\v:1. ring_pow l y c) (q:(1->num)->A) =
    ring_0 l")
    ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"h:A->B", ← q r"l:B ring", ← q r"y:B"]) THEN
      UNDISCH_TAC
       (← q r"poly_extend (k,l) (h:A->B) (\v:1. y) (f:(1->num)->A) = ring_0 l") THEN
      ASM_SIMP_TAC [POLY_EXTEND_EVALUATE, ← GSYM poly_eval],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) (ring_pow l y c)")
    ASSUME_TAC THENL [ASM_SIMP_TAC [ALGEBRAIC_OVER_POW], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"ring_pow l (y:B) c",
                      ← q r"q:(1->num)->A"] MINIMAL_POLYNOMIAL_DEG_LE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"poly_deg k (minimal_polynomial(k,l) (h:A->B) (ring_pow l y c))")) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC LET_TRANS THEN EXISTS_TAC (← q r"poly_deg k (q:(1->num)->A)") THEN
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"f:(1->num)->A"]
        IRREDUCIBLE_IMP_POLY_DEG_NZ) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP PRIME_GE_2) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [a1, LT_MULT_RCANCEL] THEN
      REWRITE_TAC [MULT_EQ_0] THEN ARITH_TAC,
      DISCH_THEN (MP_TAC o SPEC (← q r"ring_pow l (y:B) c"))] THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
    EXISTS_TAC (← q r"SUC n") THEN ASM_SIMP_TAC [EXP, ← GSYM RING_POW_POW]))

  let MINIMAL_POLYNOMIAL_DEG_EQ_CHAR ← prove
   r"!(h:A->B) k l x.
        field_extension(k,l) h /\ prime(ring_char k) /\ x IN ring_carrier l /\
        ring_pow l x (ring_char k) IN IMAGE h (ring_carrier k) /\
        ~(x IN IMAGE h (ring_carrier k))
        ==> poly_deg k (minimal_polynomial(k,l) h x) = ring_char k"
   (← do
    let a1 ← ARITH_RULE (← q r"c = c * 1")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B",
                        ← q r"ring_char(k:A ring)"] ALGEBRAIC_OVER_POW_EQ) THEN
      ASM_SIMP_TAC [PRIME_IMP_NZ] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      UNDISCH_TAC
       (← q r"ring_pow l (x:B) (ring_char(k:A ring)) IN
      IMAGE (h:A->B) (ring_carrier k)") THEN
      REWRITE_TAC [IN_IMAGE] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [ALGEBRAIC_OVER_IMAGE],
      ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"ring_pow l (x:B) (ring_char(k:A ring)) IN
                  IMAGE (h:A->B) (ring_carrier k)"
      if !(concl th == c) then throw "check"
      pure ((X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC o
             GEN_REWRITE_RULE I [IN_IMAGE]) th)) THEN
    ABBREV_TAC (← q r"c = ring_char(k:A ring)") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      MINIMAL_POLYNOMIAL) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"f = minimal_polynomial (k,l) (h:A->B) x") THEN STRIP_TAC THEN
    ABBREV_TAC
     (← q r"g = poly_sub k (poly_pow k (poly_var k one) c) (poly_const k (a:A))") THEN
    SUBGOAL_THEN
     (← q r"(g:(1->num)->A) IN ring_carrier(poly_ring k (:1)) /\ poly_deg k g = c")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "g" THEN REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR,
                    RING_POLYNOMIAL_CONST, POLY_DEG_SUB_CONST, POLY_DEG_VAR_POW,
                    FIELD_NONTRIVIAL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"poly_deg k (f:(1->num)->A) <= c") ASSUME_TAC THENL
     [FIRST_ASSUM (fun th => tactic_of do
        let c ← q r"poly_deg k (g:(1->num)->A) = c"
        if !(concl th == c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"minimal_polynomial (k,l) (h:A->B) x"
        if !((← liftExcept (lhand (concl th))) == c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      MATCH_MP_TAC MINIMAL_POLYNOMIAL_DEG_LE THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL
       [DISCH_TAC THEN UNDISCH_TAC (← q r"poly_deg k (g:(1->num)->A) = c") THEN
        ASM_REWRITE_TAC [POLY_DEG_0] THEN ASM_MESON_TAC [PRIME_IMP_NZ],
        EXPAND_TAC "g" THEN
        ASM_SIMP_TAC [POLY_EXTEND_SUB, POLY_EXTEND_VARPOW, POLY_EXTEND_CONST,
                      RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR,
                      RING_POLYNOMIAL_CONST] THEN
        MATCH_MP_TAC RING_SUB_REFL THEN ASM_MESON_TAC [FIELD_EXTENSION_CARRIER]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~poly_separable k (f:(1->num)->A)") ASSUME_TAC THENL
     [DISCH_TAC THEN
      UNDISCH_TAC (← q r"~((x:B) IN IMAGE (h:A->B) (ring_carrier k))") THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC SEPARABLE_ELEMENT_POW_IN_IMAGE THEN
      MAP_EVERY EXISTS_TAC [← q r"l:B ring", ← q r"1"] THEN
      ASM_REWRITE_TAC [separable_element, EXP_1, IN_IMAGE] THEN
      EXISTS_TAC (← q r"a:A") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"f:(1->num)->A"] POLY_DERIV_EQ_0_EXPLICIT) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"f:(1->num)->A"]
        POLY_SEPARABLE_EQ_DERIV_NONZERO) THEN
      ASM_REWRITE_TAC [],
      ASM_REWRITE_TAC []] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:(1->num)->A") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"f:(1->num)->A"] IRREDUCIBLE_IMP_POLY_DEG_NZ) THEN
    ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"poly_deg k (f:(1->num)->A) <= c") THEN
    ASM_REWRITE_TAC [MULT_EQ_0, DE_MORGAN_THM] THEN
    SUBGOAL_THEN (← q r"c <= c * poly_deg k (q:(1->num)->A) \/ poly_deg k q = 0")
    MP_TAC THENL
     [GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [a1] THEN
      REWRITE_TAC [LE_MULT_LCANCEL] THEN ARITH_TAC,
      ARITH_TAC]))

  -- @@RETURN BEGIN
  return { SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE, SEPARABLE_ELEMENT_POW_IN_IMAGE,
           SEPARABLE_ELEMENT_POW_EXISTS, MINIMAL_POLYNOMIAL_DEG_EQ_CHAR }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The separable closure.                                                    -/
/- (fieldtheory.ml 12875-13022)                                              -/
/- ------------------------------------------------------------------------- -/

structure SeparableClosure where
  -- @@FIELDS
  separable_closure : thm
  IN_SEPARABLE_CLOSURE : thm
  SUBFIELD_OF_SEPARABLE_CLOSURE : thm
  SEPARABLE_EXTENSION_SEPARABLE_CLOSURE : thm
  SEPARABLE_EXTENSION_EQ_SEPARABLE_CLOSURE : thm
  deriving Inhabited

@[nospecialize]
def setupSeparableClosure [HolBase] (D : FieldTheoryDeps) (BSubfields : Subfields) (BSubfieldGenerated : SubfieldGenerated) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BSeparableExtension : SeparableExtension) (BSeparableDegree : SeparableDegree) (BSeparablePowers : SeparablePowers) :
    ExceptT String IO SeparableClosure := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, TAUT, new_definition, .. } := D
  let { AND_FORALL_THM, EXTENSION, .. } := D.core1
  let { FINITE_EMPTY, FINITE_INSERT, FORALL_IN_IMAGE, FORALL_IN_INSERT, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, IN_UNION, I_DEF, I_O_ID, I_THM, .. } := D.core3
  let { NOT_IN_EMPTY, .. } := D.core4
  let { RING_0, RING_1, RING_CARRIER_SUBRING_GENERATED_SUBSET, .. } := D.core5
  let { RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1, RING_MONOMORPHISM_IMP_HOMOMORPHISM,
        RING_MONOMORPHISM_INCLUSION, .. } := D.core6
  let { SUBRING_GENERATED_BY_SUBRING_GENERATED, .. } := D.core7
  let { SUBRING_GENERATED_INC_GEN, SUBRING_SUBRING_GENERATED, SUBSET, .. } := D.core8
  let { subring_of, .. } := D.core9
  let { IN_SUBFIELD_ADD, IN_SUBFIELD_INV, IN_SUBFIELD_MUL, IN_SUBFIELD_NEG,
        SUBFIELD_OF_FIELD_INV, subfield_of, .. } := BSubfields
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, .. } := BSubfieldGenerated
  let { FIELD_EXTENSION_CARRIER, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_IMP_MONOMORPHISM, FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
        FIELD_EXTENSION_SUBFIELD_GENERATED, field_extension, .. } := BFieldExtension
  let { ALGEBRAIC_OVER_SUBFIELD_GENERATED, algebraic_extension, .. } := BAlgebraicExtension
  let { SEPARABLE_ELEMENT_IMAGE, SEPARABLE_ELEMENT_IMP_ALGEBRAIC,
        SEPARABLE_IMP_FIELD_EXTENSION, separable_extension, .. } := BSeparableExtension
  let { SEPARABLE_EXTENSION_GENERATED_BY_SEPARABLE, .. } := BSeparableDegree
  let { SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE, .. } := BSeparablePowers
  -- @@SCOPE END

  let separable_closure ← new_definition
   r"separable_closure (k:A ring,l:B ring) (h:A->B) =
        {x | x IN ring_carrier l /\ separable_element (k,l) h x}"

  let IN_SEPARABLE_CLOSURE ← prove
   r"!(h:A->B) k l x.
        x IN separable_closure (k,l) h <=>
        x IN ring_carrier l /\ separable_element (k,l) h x"
   (REWRITE_TAC [separable_closure, IN_ELIM_THM])

  let SUBFIELD_OF_SEPARABLE_CLOSURE ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h
        ==> separable_closure (k,l) h subfield_of l /\
            IMAGE h (ring_carrier k) SUBSET separable_closure (k,l) h"
   (← do
    let t1 ← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")
    pure (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    MATCH_MP_TAC t1 THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_SEPARABLE_CLOSURE] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [SEPARABLE_ELEMENT_IMAGE] THEN
      ASM_MESON_TAC [FIELD_EXTENSION_CARRIER],
      DISCH_TAC] THEN
    ABBREV_TAC (← q r"s = separable_closure (k,l) (h:A->B)") THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN s /\ y IN s
          ==> ring_carrier(subring_generated l
                (IMAGE (h:A->B) (ring_carrier k) UNION {x,y})) subfield_of l /\
              ring_carrier(subring_generated l
                (IMAGE (h:A->B) (ring_carrier k) UNION {x,y})) SUBSET s /\
              x IN ring_carrier(subring_generated l
                (IMAGE (h:A->B) (ring_carrier k) UNION {x,y})) /\
              y IN ring_carrier(subring_generated l
                (IMAGE (h:A->B) (ring_carrier k) UNION {x,y}))")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"y:B"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"{x:B,y}"]
        SEPARABLE_EXTENSION_GENERATED_BY_SEPARABLE) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY, FORALL_IN_INSERT,
                         NOT_IN_EMPTY] THEN
        EXPAND_TAC "s" THEN ASM_MESON_TAC [IN_SEPARABLE_CLOSURE],
        ALL_TAC] THEN
      ABBREV_TAC
       (← q r"K = subring_generated l
            (IMAGE (h:A->B) (ring_carrier k) UNION {x,y})") THEN
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"x IN ring_carrier K /\ (y:B) IN ring_carrier K")
      STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "K" THEN CONJ_TAC THEN
        MATCH_MP_TAC SUBRING_GENERATED_INC_GEN THEN
        REWRITE_TAC [IN_UNION, IN_INSERT] THEN
        EXPAND_TAC "s" THEN ASM_MESON_TAC [IN_SEPARABLE_CLOSURE],
        ASM_REWRITE_TAC []] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP SEPARABLE_IMP_FIELD_EXTENSION) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [subfield_of] THEN EXPAND_TAC "K" THEN
        REWRITE_TAC [SUBRING_SUBRING_GENERATED,
                     SUBRING_GENERATED_BY_SUBRING_GENERATED] THEN
        ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [field_extension],
        ALL_TAC] THEN
      REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"z:B") THEN DISCH_TAC THEN
      EXPAND_TAC "s" THEN REWRITE_TAC [IN_SEPARABLE_CLOSURE] THEN
      SUBGOAL_THEN (← q r"(z:B) IN ring_carrier l") ASSUME_TAC THENL
       [ASM_MESON_TAC [RING_CARRIER_SUBRING_GENERATED_SUBSET, SUBSET],
        ASM_REWRITE_TAC []] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"l:B ring",
                        ← q r"z:B"] SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE) THEN
      REWRITE_TAC [I_O_ID, I_THM] THEN ANTS_TAC THENL
       [ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM] THEN EXPAND_TAC "K" THEN
        REWRITE_TAC [← REWRITE_RULE [← GSYM I_DEF] RING_MONOMORPHISM_INCLUSION],
        DISCH_THEN SUBST1_TAC] THEN
      ASM_MESON_TAC [separable_extension],
      ALL_TAC] THEN
    MATCH_MP_TAC SUBFIELD_OF_FIELD_INV THEN ASM_REWRITE_TAC [subring_of] THEN
    REPEAT CONJ_TAC THENL
     [EXPAND_TAC "s" THEN REWRITE_TAC [SUBSET, IN_SEPARABLE_CLOSURE] THEN
      SIMP_TAC [],
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP RING_HOMOMORPHISM_0) THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"s:B->bool"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((MATCH_MP_TAC o REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) th)) THEN
      REWRITE_TAC [RING_0],
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP RING_HOMOMORPHISM_1) THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"s:B->bool"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((MATCH_MP_TAC o REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) th)) THEN
      REWRITE_TAC [RING_1],
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:B", ← q r"x:B"]) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [IN_SUBFIELD_NEG, SUBSET],
      MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"y:B"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:B", ← q r"y:B"]) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [IN_SUBFIELD_ADD, SUBSET],
      MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"y:B"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:B", ← q r"y:B"]) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [IN_SUBFIELD_MUL, SUBSET],
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:B", ← q r"x:B"]) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [IN_SUBFIELD_INV, SUBSET]]))

  let SEPARABLE_EXTENSION_SEPARABLE_CLOSURE ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h
        ==> separable_extension
              (k,subfield_generated l (separable_closure (k,l) h)) h"
   (← do
    let t1 ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")
    pure (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      SUBFIELD_OF_SEPARABLE_CLOSURE) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"s = separable_closure (k,l) (h:A->B)") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"field_extension(k,subfield_generated l s) (h:A->B)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [separable_extension, algebraic_extension] THEN
    ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, AND_FORALL_THM] THEN
    X_GEN_TAC (← q r"x:B") THEN
    REWRITE_TAC [t1] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"x IN ring_carrier l /\ separable_element(k,l) (h:A->B) x")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "s" THEN ASM_MESON_TAC [IN_SEPARABLE_CLOSURE], ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC ALGEBRAIC_OVER_SUBFIELD_GENERATED THEN
      ASM_MESON_TAC [SEPARABLE_ELEMENT_IMP_ALGEBRAIC, field_extension],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring",
                      ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring", ← q r"x:B"]
      SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE) THEN
    REWRITE_TAC [I_O_ID, I_THM] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD,
                    FIELD_EXTENSION_IMP_HOMOMORPHISM] THEN
      MATCH_MP_TAC FIELD_EXTENSION_IMP_MONOMORPHISM THEN
      ASM_MESON_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED, field_extension],
      DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_REWRITE_TAC []]))

  let SEPARABLE_EXTENSION_EQ_SEPARABLE_CLOSURE ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h
        ==> (separable_extension(k,l) h <=>
             separable_closure (k,l) h = ring_carrier l)"
   (REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [separable_extension, algebraic_extension, EXTENSION,
                     IN_SEPARABLE_CLOSURE] THEN
    ASM_MESON_TAC [SEPARABLE_ELEMENT_IMP_ALGEBRAIC, field_extension])

  -- @@RETURN BEGIN
  return { separable_closure, IN_SEPARABLE_CLOSURE, SUBFIELD_OF_SEPARABLE_CLOSURE,
           SEPARABLE_EXTENSION_SEPARABLE_CLOSURE,
           SEPARABLE_EXTENSION_EQ_SEPARABLE_CLOSURE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Purely inseparable extensions.                                            -/
/- (fieldtheory.ml 13024-13206)                                              -/
/- ------------------------------------------------------------------------- -/

structure PurelyInseparable where
  -- @@FIELDS
  purely_inseparable_extension : thm
  PURELY_INSEPARABLE_IMP_ALGEBRAIC_EXTENSION : thm
  PURELY_INSEPARABLE_IMP_FIELD_EXTENSION : thm
  PURELY_INSEPARABLE_OVER_SEPARABLE_CLOSURE : thm
  PURELY_INSEPARABLE_EXTENSION_PERFECT : thm
  PURELY_INSEPARABLE_EXTENSION_EQ_POW : thm
  PURELY_INSEPARABLE_EXTENSION_TRANS : thm
  PURELY_INSEPARABLE_OVER_FROBENIUS_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupPurelyInseparable [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated : SubfieldGenerated) (BSubfieldGenerated2 : SubfieldGenerated2) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BAlgebraicExtMisc : AlgebraicExtMisc) (BAlgebraicField : AlgebraicField) (BSeparableExtension : SeparableExtension) (BSeparableDegree : SeparableDegree) (BSeparablePowers : SeparablePowers) (BSeparableClosure : SeparableClosure) :
    ExceptT String IO PurelyInseparable := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, TAUT, new_definition, .. } := D
  let { FORALL_IN_IMAGE, IMAGE_I, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, I_DEF, I_O_ID, I_THM,
        LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { MONO_EXISTS, .. } := D.core4
  let { RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MONOMORPHISM_INCLUSION, .. } := D.core6
  let { RING_POW, .. } := D.core7
  let { SUBRING_GENERATED_INC_GEN, SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core8
  let { o_THM, .. } := D.core9
  let { EXP_1, EXP_EQ_0, PRIME_IMP_NZ, .. } := D.core10
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, SUBFIELD_GENERATED_SUBSET_CARRIER, .. } := BSubfieldGenerated
  let { RING_CHAR_SUBFIELD_GENERATED, .. } := BSubfieldGenerated2
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_IMP_SUBSET,
        FIELD_EXTENSION_SUBFIELD_GENERATED, field_extension, .. } := BFieldExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, ALGEBRAIC_OVER_IMAGE, algebraic_extension, .. } := BAlgebraicExtension
  let { ALGEBRAIC_OVER_FIELD_EXTENSION, .. } := BAlgebraicExtensionProps
  let { ALGEBRAIC_EXTENSION_TRANS, .. } := BAlgebraicExtMisc
  let { ALGEBRAIC_OVER_POW_EQ, .. } := BAlgebraicField
  let { PERFECT_FIELD_IMP_SEPARABLE_ELEMENT, SEPARABLE_ELEMENT_IMP_ALGEBRAIC,
        SEPARABLE_ELEMENT_INTERMEDIATE, SEPARABLE_IMP_FIELD_EXTENSION,
        separable_extension, .. } := BSeparableExtension
  let { SEPARABLE_EXTENSION_SIMPLE, SEPARABLE_EXTENSION_TRANS, .. } := BSeparableDegree
  let { SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE, SEPARABLE_ELEMENT_POW_EXISTS,
        SEPARABLE_ELEMENT_POW_IN_IMAGE, .. } := BSeparablePowers
  let { IN_SEPARABLE_CLOSURE, SEPARABLE_EXTENSION_SEPARABLE_CLOSURE,
        SUBFIELD_OF_SEPARABLE_CLOSURE, .. } := BSeparableClosure
  -- @@SCOPE END

  let purely_inseparable_extension ← new_definition
   r"purely_inseparable_extension (k:A ring,l:B ring) (h:A->B) <=>
        algebraic_extension (k,l) h /\
        !x. x IN separable_closure (k,l) h ==> x IN IMAGE h (ring_carrier k)"

  let PURELY_INSEPARABLE_IMP_ALGEBRAIC_EXTENSION ← prove
   r"!(h:A->B) k l.
        purely_inseparable_extension (k,l) h ==> algebraic_extension (k,l) h"
   (SIMP_TAC [purely_inseparable_extension])

  let PURELY_INSEPARABLE_IMP_FIELD_EXTENSION ← prove
   r"!(h:A->B) k l.
        purely_inseparable_extension (k,l) h ==> field_extension (k,l) h"
   (SIMP_TAC [purely_inseparable_extension, ALGEBRAIC_IMP_FIELD_EXTENSION])

  let PURELY_INSEPARABLE_OVER_SEPARABLE_CLOSURE ← prove
   r"!(h:A->B) k l.
        algebraic_extension(k,l) h
        ==> purely_inseparable_extension
              (subfield_generated l (separable_closure (k,l) h),l) I"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      SUBFIELD_OF_SEPARABLE_CLOSURE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      SEPARABLE_EXTENSION_SEPARABLE_CLOSURE) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"s = separable_closure (k,l) (h:A->B)") THEN REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"K = subfield_generated l (s:B->bool)") THEN
    SUBGOAL_THEN (← q r"ring_carrier K = (s:B->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"field_extension(k,K) (h:A->B) /\ field_extension(K,l) (I:B->B)")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL
       [ASM_MESON_TAC [SEPARABLE_IMP_FIELD_EXTENSION],
        EXPAND_TAC "K" THEN
        ASM_MESON_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED, field_extension]],
      ALL_TAC] THEN
    REWRITE_TAC [purely_inseparable_extension, algebraic_extension, IMAGE_I] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      MATCH_MP_TAC ALGEBRAIC_OVER_FIELD_EXTENSION THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN
      ASM_REWRITE_TAC [I_O_ID] THEN ASM_MESON_TAC [algebraic_extension],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:B") THEN REWRITE_TAC [IN_SEPARABLE_CLOSURE] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring", ← q r"x:B"]
      SEPARABLE_EXTENSION_SIMPLE) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SEPARABLE_ELEMENT_IMP_ALGEBRAIC THEN
      ASM_MESON_TAC [field_extension],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [IMAGE_I] THEN DISCH_TAC THEN
    ABBREV_TAC (← q r"L = subring_generated l ((x:B) INSERT s)") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"L:B ring"]
      SEPARABLE_EXTENSION_TRANS) THEN
    ASM_REWRITE_TAC [I_O_ID] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(x:B) IN ring_carrier L") ASSUME_TAC THENL
     [EXPAND_TAC "L" THEN MATCH_MP_TAC SUBRING_GENERATED_INC_GEN THEN
      ASM_REWRITE_TAC [IN_INSERT],
      ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← q r"separable_closure (k,l) (h:A->B) = s"
      if !(concl th == c) then throw "check"
      pure ((SUBST1_TAC o SYM) th)) THEN
    REWRITE_TAC [IN_SEPARABLE_CLOSURE] THEN
    CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC, ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"L:B ring", ← q r"l:B ring",
                      ← q r"x:B"] SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE) THEN
    REWRITE_TAC [I_O_ID, I_THM] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM,
                    SEPARABLE_IMP_FIELD_EXTENSION] THEN
      EXPAND_TAC "L" THEN
      REWRITE_TAC [← REWRITE_RULE [← GSYM I_DEF] RING_MONOMORPHISM_INCLUSION],
      DISCH_THEN SUBST1_TAC THEN ASM_MESON_TAC [separable_extension]])

  let PURELY_INSEPARABLE_EXTENSION_PERFECT ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h /\ perfect_field k
        ==> (purely_inseparable_extension(k,l) h <=>
             IMAGE h (ring_carrier k) = ring_carrier l)"
   (← do
    let t1 ← TAUT (← q r"p /\ q ==> p")
    pure (REPEAT STRIP_TAC THEN
    REWRITE_TAC [purely_inseparable_extension, IN_SEPARABLE_CLOSURE] THEN
    EQ_TAC THENL
     [STRIP_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
      ASM_SIMP_TAC [FIELD_EXTENSION_IMP_SUBSET] THEN REWRITE_TAC [SUBSET] THEN
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC PERFECT_FIELD_IMP_SEPARABLE_ELEMENT THEN
      ASM_MESON_TAC [algebraic_extension],
      DISCH_TAC THEN ASM_REWRITE_TAC [algebraic_extension] THEN
      REWRITE_TAC [t1] THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [ALGEBRAIC_OVER_IMAGE]]))

  let PURELY_INSEPARABLE_EXTENSION_EQ_POW ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h /\ prime(ring_char k)
        ==> (purely_inseparable_extension(k,l) h <=>
             !x. x IN ring_carrier l
                 ==> ?n. ring_pow l x (ring_char k EXP n) IN
                         IMAGE h (ring_carrier k))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [purely_inseparable_extension, IN_SEPARABLE_CLOSURE] THEN
    EQ_TAC THENL
     [STRIP_TAC THEN X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
        SEPARABLE_ELEMENT_POW_EXISTS) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [RING_POW],
      DISCH_TAC] THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [algebraic_extension] THEN
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:B")) THEN
      ASM_REWRITE_TAC [IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"a:A"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B",
                        ← q r"ring_char(k:A ring) EXP n"] ALGEBRAIC_OVER_POW_EQ) THEN
      ASM_SIMP_TAC [EXP_EQ_0, PRIME_IMP_NZ] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_SIMP_TAC [ALGEBRAIC_OVER_IMAGE],
      X_GEN_TAC (← q r"x:B") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:B")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
      MATCH_MP_TAC SEPARABLE_ELEMENT_POW_IN_IMAGE THEN
      MAP_EVERY EXISTS_TAC [← q r"l:B ring", ← q r"n:num"] THEN ASM_REWRITE_TAC []])

  let PURELY_INSEPARABLE_EXTENSION_TRANS ← prove
   r"!(f:A->B) (g:B->C) k l m.
        purely_inseparable_extension(k,l) f /\
        purely_inseparable_extension(l,m) g
        ==> purely_inseparable_extension(k,m) (g o f)"
   (REWRITE_TAC [purely_inseparable_extension, IN_SEPARABLE_CLOSURE] THEN
    REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [ALGEBRAIC_EXTENSION_TRANS], ALL_TAC] THEN
    MAP_EVERY (fun c => FIRST_ASSUM (fun th => tactic_of do
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
               MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) th)))
     [← q r"f:A->B", ← q r"g:B->C"] THEN
    SUBGOAL_THEN (← q r"x IN IMAGE (g:B->C) (ring_carrier l)") MP_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SEPARABLE_ELEMENT_INTERMEDIATE THEN
      MAP_EVERY EXISTS_TAC [← q r"f:A->B", ← q r"k:A ring"] THEN
      ASM_MESON_TAC [ALGEBRAIC_IMP_FIELD_EXTENSION],
      REWRITE_TAC [IN_IMAGE, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"y:B") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"y IN IMAGE (f:A->B) (ring_carrier k)") MP_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                        ← q r"y:B"] SEPARABLE_ELEMENT_MONOMORPHIC_IMAGE) THEN
      ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_MESON_TAC [],
      REWRITE_TAC [IN_IMAGE, o_THM] THEN ASM_MESON_TAC []])

  let PURELY_INSEPARABLE_OVER_FROBENIUS_IMAGE ← prove
   r"!l:A ring.
        field l /\ prime(ring_char l)
        ==> purely_inseparable_extension
              (subfield_generated l
                 {ring_pow l x (ring_char l) | x IN ring_carrier l},l) I"
   (← do
    let s1 ← SET_RULE (← q r"!s t. s SUBSET t /\ (x:A) IN s ==> x IN t")
    pure (REPEAT STRIP_TAC THEN
    ABBREV_TAC
     (← q r"K = subfield_generated l
          {ring_pow l x (ring_char l) | x IN ring_carrier (l:A ring)}") THEN
    SUBGOAL_THEN (← q r"field_extension(K,l) (I:A->A)") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN ASM_REWRITE_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"I:A->A", ← q r"K:A ring", ← q r"l:A ring"]
      PURELY_INSEPARABLE_EXTENSION_EQ_POW) THEN
    SUBGOAL_THEN (← q r"ring_char(K:A ring) = ring_char(l:A ring)") SUBST1_TAC THENL
     [EXPAND_TAC "K" THEN REWRITE_TAC [RING_CHAR_SUBFIELD_GENERATED], ALL_TAC] THEN
    ASM_REWRITE_TAC [IMAGE_I] THEN DISCH_THEN SUBST1_TAC THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN EXISTS_TAC (← q r"1") THEN
    REWRITE_TAC [EXP_1] THEN EXPAND_TAC "K" THEN
    MATCH_MP_TAC s1 THEN
    EXISTS_TAC (← q r"ring_carrier l INTER
              {ring_pow l x (ring_char l) | x IN ring_carrier (l:A ring)}") THEN
    REWRITE_TAC [SUBFIELD_GENERATED_SUBSET_CARRIER, IN_INTER, IN_ELIM_THM] THEN
    ASM_SIMP_TAC [RING_POW] THEN ASM_MESON_TAC []))

  -- @@RETURN BEGIN
  return { purely_inseparable_extension, PURELY_INSEPARABLE_IMP_ALGEBRAIC_EXTENSION,
           PURELY_INSEPARABLE_IMP_FIELD_EXTENSION,
           PURELY_INSEPARABLE_OVER_SEPARABLE_CLOSURE,
           PURELY_INSEPARABLE_EXTENSION_PERFECT, PURELY_INSEPARABLE_EXTENSION_EQ_POW,
           PURELY_INSEPARABLE_EXTENSION_TRANS, PURELY_INSEPARABLE_OVER_FROBENIUS_IMAGE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Degrees of purely inseparable extensions; separable degree 1.             -/
/- (fieldtheory.ml 13207-13497)                                              -/
/- ------------------------------------------------------------------------- -/

structure PurelyInseparableDegree where
  -- @@FIELDS
  PURELY_INSEPARABLE_EXTENSION_DEGREE : thm
  SEPARABLE_DEGREE_EQ_1 : thm
  SEPARABLE_DEGREE_SEPARABLE_CLOSURE : thm
  deriving Inhabited

@[nospecialize]
def setupPurelyInseparableDegree [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated : SubfieldGenerated) (BSubfieldGenerated2 : SubfieldGenerated2) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BAlgebraicExtMisc : AlgebraicExtMisc) (BMinimalPolynomial : MinimalPolynomial) (BAlgebraicClosure : AlgebraicClosure) (BPerfectField : PerfectField) (BHomExtensions : HomExtensions) (BSeparableDegree : SeparableDegree) (BSeparablePowers : SeparablePowers) (BSeparableClosure : SeparableClosure) (BPurelyInseparable : PurelyInseparable) :
    ExceptT String IO PurelyInseparableDegree := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, SET_RULE, .. } := D
  let { EQ_SYM_EQ, EXP, EXTENSION, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FINITE_SING, IMAGE_I, .. } := D.core2
  let { IMP_CONJ, INTEGRAL_DOMAIN_CHAR, IN_ELIM_THM, IN_IMAGE, I_O_ID,
        LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core4
  let { RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_POW, .. } := D.core7
  let { SUBSET_REFL, num_WF, .. } := D.core8
  let { num_WOP, .. } := D.core9
  let { CARD_SING, EXTENSIONAL_EQ, LT_MULT_RCANCEL, MULT_CLAUSES, MULT_EQ_1, MULT_SYM,
        PRIME_GE_2, RING_CHAR_MONOMORPHIC_IMAGE, RING_CHAR_SUBRING_GENERATED,
        RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { RING_HOMOMORPHISM_POW, RING_MONOMORPHISM_FROBENIUS_ITERATE,
        RING_MONOMORPHISM_INJECTIVE_EQ, RING_POW_1, RING_POW_POW, .. } := D.core11
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, .. } := BSubfieldGenerated
  let { RING_CHAR_SUBFIELD_GENERATED, .. } := BSubfieldGenerated2
  let { FIELD_EXTENSION_FROM_SUBRING_GENERATED, FIELD_EXTENSION_IMP_SUBSET_I,
        FIELD_EXTENSION_REFL, RING_ISOMORPHISM_ONTO_SUBFIELD_IMAGE, field_extension, .. } := BFieldExtension
  let { EXTENSION_DEGREE_EQ_0, EXTENSION_DEGREE_EQ_1, EXTENSION_DEGREE_EQ_IMAGE,
        EXTENSION_DEGREE_TOWER_LAW, FINITE_EXTENSION_SUBFIELD_GENERATED,
        FINITE_EXTENSION_TRANS_EQ, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { FIELD_SIMPLE_ALGEBRAIC_EXTENSION, FINITE_SIMPLE_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { ALGEBRAIC_EXTENSION_TRANS_EQ, .. } := BAlgebraicExtMisc
  let { EXTENSION_DEGREE_SIMPLE, MINIMAL_POLYNOMIAL_DEG_EQ_1, .. } := BMinimalPolynomial
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { PERFECT_FIELD_CHAR_0, .. } := BPerfectField
  let { RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY, ring_homomorphism_extensions, .. } := BHomExtensions
  let { SEPARABLE_DEGREE, SEPARABLE_DEGREE_EQ_EXTENSION_DEGREE, SEPARABLE_DEGREE_TOWER,
        SEPARABLE_EXTENSION_SIMPLE, .. } := BSeparableDegree
  let { MINIMAL_POLYNOMIAL_DEG_EQ_CHAR, .. } := BSeparablePowers
  let { IN_SEPARABLE_CLOSURE, SEPARABLE_EXTENSION_SEPARABLE_CLOSURE,
        SUBFIELD_OF_SEPARABLE_CLOSURE, .. } := BSeparableClosure
  let { PURELY_INSEPARABLE_EXTENSION_EQ_POW, PURELY_INSEPARABLE_EXTENSION_PERFECT,
        PURELY_INSEPARABLE_IMP_ALGEBRAIC_EXTENSION,
        PURELY_INSEPARABLE_OVER_SEPARABLE_CLOSURE, purely_inseparable_extension, .. } := BPurelyInseparable
  -- @@SCOPE END

  let PURELY_INSEPARABLE_EXTENSION_DEGREE ← prove
   r"!(h:A->B) k l.
        finite_extension(k,l) h /\ purely_inseparable_extension(k,l) h
        ==> ?e. extension_degree(k,l) h = ring_char k EXP e"
   (← do
    -- right to left: the second SET_RULE, the ARITH_RULE, then the first
    -- SET_RULE
    let s3 ← SET_RULE (← q r"s SUBSET t ==> (x:B) IN s ==> x IN t")
    let a2 ← ARITH_RULE (← q r"e < c * e <=> 1 * e < c * e")
    let s1 ← SET_RULE
     (← q r"s SUBSET t /\ ~(s = t) ==> ?z:B. z IN t /\ ~(z IN s)")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"field(k:A ring)"
      if !(concl th == c) then throw "check"
      pure ((DISJ_CASES_TAC o MATCH_MP INTEGRAL_DOMAIN_CHAR o
             MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) th)) THENL
     [EXISTS_TAC (← q r"0") THEN REWRITE_TAC [EXP] THEN
      ASM_SIMP_TAC [EXTENSION_DEGREE_EQ_1] THEN
      ASM_MESON_TAC [PURELY_INSEPARABLE_EXTENSION_PERFECT, PERFECT_FIELD_CHAR_0],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"c = ring_char(k:A ring)") THEN
    SUBGOAL_THEN
     (← q r"!d (K:B ring).
        finite_extension(K,l) I /\ ring_char K = c /\
        (!x. x IN ring_carrier l
             ==> ?n. ring_pow l x (c EXP n) IN ring_carrier K) /\
        extension_degree(K,l) I = d
        ==> ?e. d = c EXP e")
    MP_TAC THENL
     [ALL_TAC,
      DISCH_THEN (MP_TAC o SPECL
       [← q r"extension_degree(k,l) (h:A->B)",
        ← q r"subfield_generated l (IMAGE (h:A->B) (ring_carrier k))"]) THEN
      REWRITE_TAC [EQ_SYM_EQ] THEN DISCH_THEN MATCH_MP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
        RING_ISOMORPHISM_ONTO_SUBFIELD_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o CONJUNCT1) THEN
      DISCH_THEN (ASSUME_TAC o MATCH_MP CARRIER_SUBFIELD_GENERATED_SUBFIELD) THEN
      REPEAT CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                          ← q r"IMAGE (h:A->B) (ring_carrier k)"]
          FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
        ASM_SIMP_TAC [SUBSET_REFL],
        REWRITE_TAC [RING_CHAR_SUBFIELD_GENERATED] THEN
        EXPAND_TAC "c" THEN ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE],
        ASM_REWRITE_TAC [] THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
          PURELY_INSEPARABLE_EXTENSION_EQ_POW) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
        ASM_REWRITE_TAC [],
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC EXTENSION_DEGREE_EQ_IMAGE THEN
        ASM_REWRITE_TAC [IMAGE_I]]] THEN
    MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q r"d:num") THEN
    DISCH_THEN (LABEL_TAC "ih") THEN
    X_GEN_TAC (← q r"K:B ring") THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_SUBSET_I) THEN
    ASM_CASES_TAC (← q r"ring_carrier K:B->bool = ring_carrier l") THENL
     [EXISTS_TAC (← q r"0") THEN REWRITE_TAC [EXP] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"d:num"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      ASM_SIMP_TAC [EXTENSION_DEGREE_EQ_1, IMAGE_I],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?z:B. z IN ring_carrier l /\ ~(z IN ring_carrier K)")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC s1 THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?n. ring_pow l (z:B) (c EXP n) IN ring_carrier K") MP_TAC
    THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") (CONJUNCTS_THEN2 ASSUME_TAC
      (LABEL_TAC "min"))) THEN
    SUBGOAL_THEN (← q r"~(m = 0)") ASSUME_TAC THENL
     [DISCH_THEN SUBST_ALL_TAC THEN UNDISCH_TAC (← q r"~((z:B) IN ring_carrier K)") THEN
      UNDISCH_TAC (← q r"ring_pow l (z:B) (c EXP 0) IN ring_carrier K") THEN
      ASM_SIMP_TAC [EXP, RING_POW_1],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"x = ring_pow l (z:B) (c EXP (m - 1))") THEN
    SUBGOAL_THEN
     (← q r"(x:B) IN ring_carrier l /\ ~(x IN ring_carrier K) /\
    ring_pow l x c IN ring_carrier K")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "x" THEN REPEAT CONJ_TAC THENL
       [SIMP_TAC [RING_POW, ← ASSUME (← q r"(z:B) IN ring_carrier l")],
        REMOVE_THEN "min" MATCH_MP_TAC THEN ASM_ARITH_TAC,
        REWRITE_TAC [← MATCH_MP RING_POW_POW (← ASSUME (← q r"(z:B) IN ring_carrier l"))] THEN
        SUBGOAL_THEN (← q r"c EXP (m - 1) * c = c EXP m") SUBST1_TAC THENL
         [SUBGOAL_THEN (← q r"m = SUC(m - 1)")
           (fun th => GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [th]) THENL
           [ASM_ARITH_TAC, REWRITE_TAC [EXP, MULT_SYM]],
          FIRST_ASSUM ACCEPT_TAC]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_over(K,l) (I:B->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION, algebraic_extension],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring", ← q r"x:B"]
      MINIMAL_POLYNOMIAL_DEG_EQ_CHAR) THEN
    ASM_REWRITE_TAC [IMAGE_I] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring", ← q r"x:B"]
      EXTENSION_DEGREE_SIMPLE) THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring", ← q r"x:B"]
      FINITE_SIMPLE_ALGEBRAIC_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring", ← q r"x:B"]
      FIELD_SIMPLE_ALGEBRAIC_EXTENSION) THEN
    ASM_REWRITE_TAC [IMAGE_I] THEN
    ABBREV_TAC (← q r"K1 = subring_generated l ((x:B) INSERT ring_carrier K)") THEN
    REPEAT DISCH_TAC THEN
    SUBGOAL_THEN (← q r"field_extension(K1,l) (I:B->B)") ASSUME_TAC THENL
     [EXPAND_TAC "K1" THEN
      MATCH_MP_TAC FIELD_EXTENSION_FROM_SUBRING_GENERATED THEN
      ASM_REWRITE_TAC [FIELD_EXTENSION_REFL] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
     [← q r"I:B->B", ← q r"I:B->B", ← q r"K:B ring", ← q r"K1:B ring", ← q r"l:B ring"]
     EXTENSION_DEGREE_TOWER_LAW)) THEN
    MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
     [← q r"I:B->B", ← q r"I:B->B", ← q r"K:B ring", ← q r"K1:B ring", ← q r"l:B ring"]
     FINITE_EXTENSION_TRANS_EQ)) THEN
    ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION] THEN DISCH_TAC THEN
    DISCH_TAC THEN
    REMOVE_THEN "ih" (MP_TAC o SPEC (← q r"extension_degree(K1,l) (I:B->B)")) THEN
    ANTS_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"d:num"
        if !((← liftExcept (lhand (concl th))) == c) then throw "check"
        pure (SUBST1_TAC th)) THEN
      SUBGOAL_THEN (← q r"~(extension_degree(K1,l) (I:B->B) = 0)") MP_TAC THENL
       [ASM_MESON_TAC [EXTENSION_DEGREE_EQ_0], ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP PRIME_GE_2) THEN
      SPEC_TAC (← q r"extension_degree(K1,l) (I:B->B)", ← q r"e:num") THEN
      GEN_TAC THEN
      SUBST1_TAC a2 THEN
      REWRITE_TAC [LT_MULT_RCANCEL] THEN ARITH_TAC,
      DISCH_THEN (MP_TAC o SPEC (← q r"K1:B ring"))] THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [EXPAND_TAC "K1" THEN REWRITE_TAC [RING_CHAR_SUBRING_GENERATED] THEN
        ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE, field_extension],
        X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          let c ← q r"K:B ring"
          if !(is_forall (concl th) && free_in c (concl th)) then throw "check"
          pure ((MP_TAC o SPEC (← q r"y:B")) th)) THEN
        ANTS_TAC THENL [FIRST_ASSUM ACCEPT_TAC, ALL_TAC] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
        MATCH_MP_TAC s3 THEN
        MATCH_MP_TAC FIELD_EXTENSION_IMP_SUBSET_I THEN
        ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:num") SUBST1_TAC) THEN
      EXISTS_TAC (← q r"SUC e") THEN REWRITE_TAC [EXP]]))

  let SEPARABLE_DEGREE_EQ_1 ← prove
   r"!(h:A->B) k l.
        algebraic_extension(k,l) h
        ==> (separable_degree(k,l) h = 1 <=>
             purely_inseparable_extension(k,l) h)"
   (← do
    let s1 ← SET_RULE
     (← q r"(a:B->A#num) IN s /\ (!x y. x IN s /\ y IN s ==> x = y) ==> s = {a}")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    EQ_TAC THENL
     [DISCH_TAC THEN
      ASM_REWRITE_TAC [purely_inseparable_extension, IN_SEPARABLE_CLOSURE] THEN
      X_GEN_TAC (← q r"x:B") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
       [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
        MINIMAL_POLYNOMIAL_DEG_EQ_1) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
        EXTENSION_DEGREE_SIMPLE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
        SEPARABLE_EXTENSION_SIMPLE) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
        FINITE_SIMPLE_ALGEBRAIC_EXTENSION) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
        FIELD_SIMPLE_ALGEBRAIC_EXTENSION) THEN
      ASM_REWRITE_TAC [] THEN
      ABBREV_TAC
       (← q r"K = subring_generated l (x INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
      REPEAT DISCH_TAC THEN
      SUBGOAL_THEN (← q r"field_extension(K,l) (I:B->B)") ASSUME_TAC THENL
       [EXPAND_TAC "K" THEN
        MATCH_MP_TAC FIELD_EXTENSION_FROM_SUBRING_GENERATED THEN
        ASM_REWRITE_TAC [FIELD_EXTENSION_REFL] THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
       [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"l:B ring"]
       SEPARABLE_DEGREE_TOWER)) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION] THEN
        MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
         [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"l:B ring"]
         ALGEBRAIC_EXTENSION_TRANS_EQ)) THEN
        ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION],
        ALL_TAC] THEN
      ASM_SIMP_TAC [SEPARABLE_DEGREE_EQ_EXTENSION_DEGREE] THEN
      DISCH_THEN (MP_TAC o SYM) THEN ASM_REWRITE_TAC [MULT_EQ_1] THEN
      SUBGOAL_THEN (← q r"separable_degree(k,K) (h:A->B) = extension_degree(k,K) h")
      (fun th => REWRITE_TAC [th]) THENL
       [ASM_MESON_TAC [SEPARABLE_DEGREE_EQ_EXTENSION_DEGREE],
        SIMP_TAC [MULT_CLAUSES]],
      ALL_TAC] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"k:A ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:(A#num)ring", ← q r"g:A->A#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"g:A->A#num"
      if !((← liftExcept (rand (concl th))) == c) then throw "check"
      pure ((STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
             MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) th)) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"g:A->A#num"
      if !((← liftExcept (rand (concl th))) == c) then throw "check"
      pure ((ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) th)) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->A#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:(A#num)ring"] SEPARABLE_DEGREE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->A#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:(A#num)ring"] RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY) THEN
    ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
    ABBREV_TAC
     (← q r"E = ring_homomorphism_extensions (k,l,m) (h:A->B,g:A->A#num)") THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"s0:B->A#num")) THEN DISCH_THEN SUBST1_TAC THEN
    SUBGOAL_THEN (← q r"E = {s0:B->A#num}")
     (fun th => REWRITE_TAC [th, FINITE_SING, CARD_SING]) THEN
    MATCH_MP_TAC s1 THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:B->A#num", ← q r"t:B->A#num"] THEN
    EXPAND_TAC "E" THEN
    REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN STRIP_TAC THEN
    MATCH_MP_TAC EXTENSIONAL_EQ THEN EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"field(k:A ring)"
      if !(concl th == c) then throw "check"
      pure ((DISJ_CASES_TAC o MATCH_MP INTEGRAL_DOMAIN_CHAR o
             MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) th)) THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
        PURELY_INSEPARABLE_EXTENSION_PERFECT) THEN
      ASM_SIMP_TAC [PERFECT_FIELD_CHAR_0] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:B") o REWRITE_RULE [EXTENSION]) THEN
      ASM_REWRITE_TAC [IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC) THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      PURELY_INSEPARABLE_EXTENSION_EQ_POW) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:B")) THEN
    ASM_REWRITE_TAC [IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"a:A"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"m:(A#num)ring", ← q r"n:num"]
      RING_MONOMORPHISM_FROBENIUS_ITERATE) THEN
    SUBGOAL_THEN (← q r"ring_char(m:(A#num)ring) = ring_char(k:A ring)")
    SUBST1_TAC THENL
     [ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE], ALL_TAC] THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"(s:B->A#num) x", ← q r"(t:B->A#num) x"] o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ] RING_MONOMORPHISM_INJECTIVE_EQ)) THEN
    SUBGOAL_THEN
     (← q r"(s:B->A#num) x IN ring_carrier m /\ (t:B->A#num) x IN ring_carrier m")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"m:(A#num)ring", ← q r"s:B->A#num"]
      RING_HOMOMORPHISM_POW) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"m:(A#num)ring", ← q r"t:B->A#num"]
      RING_HOMOMORPHISM_POW) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT (DISCH_THEN (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP th
        (← ASSUME (← q r"(x:B) IN ring_carrier l")))]))) THEN
    ASM_SIMP_TAC []))

  let SEPARABLE_DEGREE_SEPARABLE_CLOSURE ← prove
   r"!(h:A->B) k l.
        finite_extension(k,l) h
        ==> separable_degree(k,l) h =
            extension_degree
             (k,subfield_generated l (separable_closure (k,l) h)) h"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_ALGEBRAIC_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      SUBFIELD_OF_SEPARABLE_CLOSURE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      SEPARABLE_EXTENSION_SEPARABLE_CLOSURE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      PURELY_INSEPARABLE_OVER_SEPARABLE_CLOSURE) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"s = separable_closure (k,l) (h:A->B)") THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
      FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"K = subfield_generated l (s:B->bool)") THEN STRIP_TAC THEN
    MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
     [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"l:B ring"]
     SEPARABLE_DEGREE_TOWER)) THEN
    ASM_SIMP_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION] THEN DISCH_THEN SUBST1_TAC THEN
    SUBGOAL_THEN (← q r"separable_degree(K,l) (I:B->B) = 1") SUBST1_TAC THENL
     [ASM_MESON_TAC [SEPARABLE_DEGREE_EQ_1,
                     PURELY_INSEPARABLE_IMP_ALGEBRAIC_EXTENSION],
      REWRITE_TAC [MULT_CLAUSES]] THEN
    ASM_MESON_TAC [SEPARABLE_DEGREE_EQ_EXTENSION_DEGREE])

  -- @@RETURN BEGIN
  return { PURELY_INSEPARABLE_EXTENSION_DEGREE, SEPARABLE_DEGREE_EQ_1,
           SEPARABLE_DEGREE_SEPARABLE_CLOSURE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The inseparable degree.                                                   -/
/- (fieldtheory.ml 13499-13595)                                              -/
/- ------------------------------------------------------------------------- -/

structure InseparableDegree where
  -- @@FIELDS
  inseparable_degree : thm
  EXTENSION_DEGREE_SEPARABLE_INSEPARABLE : thm
  INSEPARABLE_DEGREE_EQ_1 : thm
  INSEPARABLE_DEGREE_CHAR_POWER : thm
  INSEPARABLE_DEGREE_TOWER : thm
  deriving Inhabited

@[nospecialize]
def setupInseparableDegree [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated : SubfieldGenerated) (BSubfieldGenerated2 : SubfieldGenerated2) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BSeparableDegree : SeparableDegree) (BSeparableClosure : SeparableClosure) (BPurelyInseparable : PurelyInseparable) (BPurelyInseparableDegree : PurelyInseparableDegree) :
    ExceptT String IO InseparableDegree := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, TAUT, new_definition, .. } := D
  let { IMAGE_I, .. } := D.core2
  let { I_O_ID, .. } := D.core3
  let { EQ_MULT_LCANCEL, MULT_EQ_0, RING_CHAR_MONOMORPHIC_IMAGE, .. } := D.core10
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, .. } := BSubfieldGenerated
  let { RING_CHAR_SUBFIELD_GENERATED, .. } := BSubfieldGenerated2
  let { FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_EXTENSION_SUBFIELD_GENERATED,
        field_extension, .. } := BFieldExtension
  let { EXTENSION_DEGREE_EQ_0, EXTENSION_DEGREE_EQ_1, EXTENSION_DEGREE_TOWER_LAW,
        FINITE_EXTENSION_SUBFIELD_GENERATED, FINITE_EXTENSION_TRANS,
        FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { SEPARABLE_DEGREE_TOWER, .. } := BSeparableDegree
  let { SEPARABLE_EXTENSION_EQ_SEPARABLE_CLOSURE, SUBFIELD_OF_SEPARABLE_CLOSURE, .. } := BSeparableClosure
  let { PURELY_INSEPARABLE_OVER_SEPARABLE_CLOSURE, .. } := BPurelyInseparable
  let { PURELY_INSEPARABLE_EXTENSION_DEGREE, SEPARABLE_DEGREE_SEPARABLE_CLOSURE, .. } := BPurelyInseparableDegree
  -- @@SCOPE END

  let inseparable_degree ← new_definition
   r"inseparable_degree (k:A ring,l:B ring) (h:A->B) =
        extension_degree
         (subfield_generated l (separable_closure (k,l) h),l) I"

  let EXTENSION_DEGREE_SEPARABLE_INSEPARABLE ← prove
   r"!(h:A->B) k l.
        finite_extension(k,l) h
        ==> extension_degree(k,l) h =
            separable_degree(k,l) h * inseparable_degree(k,l) h"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    ASM_SIMP_TAC [SEPARABLE_DEGREE_SEPARABLE_CLOSURE, inseparable_degree] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      SUBFIELD_OF_SEPARABLE_CLOSURE) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"s = separable_closure (k,l) (h:A->B)") THEN STRIP_TAC THEN
    MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
     [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"subfield_generated l (s:B->bool)",
      ← q r"l:B ring"] EXTENSION_DEGREE_TOWER_LAW)) THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_INTO_SUBFIELD_GENERATED] THEN
    ASM_MESON_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED, field_extension])

  let INSEPARABLE_DEGREE_EQ_1 ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h
        ==> (inseparable_degree(k,l) h = 1 <=> separable_extension(k,l) h)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      SUBFIELD_OF_SEPARABLE_CLOSURE) THEN
    ASM_SIMP_TAC [inseparable_degree,
                  SEPARABLE_EXTENSION_EQ_SEPARABLE_CLOSURE] THEN
    STRIP_TAC THEN
    wPart lhand (fun t => do lhand (← rand t)) EXTENSION_DEGREE_EQ_1 THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED, field_extension],
      DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [IMAGE_I, CARRIER_SUBFIELD_GENERATED_SUBFIELD])

  let INSEPARABLE_DEGREE_CHAR_POWER ← prove
   r"!(h:A->B) k l.
        finite_extension(k,l) h
        ==> ?e. inseparable_degree(k,l) h = ring_char k EXP e"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [inseparable_degree] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      SUBFIELD_OF_SEPARABLE_CLOSURE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      PURELY_INSEPARABLE_OVER_SEPARABLE_CLOSURE) THEN
    ASM_SIMP_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION] THEN
    ABBREV_TAC (← q r"s = separable_closure (k,l) (h:A->B)") THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"subfield_generated l (s:B->bool)", ← q r"l:B ring"]
      PURELY_INSEPARABLE_EXTENSION_DEGREE) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
        FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
      ASM_SIMP_TAC [],
      REWRITE_TAC [RING_CHAR_SUBFIELD_GENERATED] THEN
      ASM_MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE, field_extension]])

  let INSEPARABLE_DEGREE_TOWER ← (do
    let la1 ← ARITH_RULE
     (← q r"(bs * bi) * (cs * ci) = (bs * cs) * (bi * ci):num")
    let lemma ← prove
     r"!i bs bi cs ci:num.
        ~((bs * cs) * i = 0) /\ (bs * cs) * i = (bs * bi) * (cs * ci)
        ==> i = bi * ci"
     (REPEAT GEN_TAC THEN
      SUBST1_TAC la1 THEN
      REWRITE_TAC [EQ_MULT_LCANCEL, MULT_EQ_0] THEN CONV_TAC (fun t => (TAUT t).run))
    prove
     r"!(f:A->B) (g:B->C) k l m.
        finite_extension(k,l) f /\ finite_extension(l,m) g
        ==> inseparable_degree(k,m) (g o f) =
            inseparable_degree(k,l) f * inseparable_degree(l,m) g"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"finite_extension(k,m) ((g:B->C) o (f:A->B))")
      ASSUME_TAC THENL [ASM_MESON_TAC [FINITE_EXTENSION_TRANS], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
        EXTENSION_DEGREE_TOWER_LAW) THEN
      MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
        SEPARABLE_DEGREE_TOWER) THEN
      ASM_SIMP_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION, FINITE_IMP_FIELD_EXTENSION,
                    EXTENSION_DEGREE_SEPARABLE_INSEPARABLE] THEN
      SUBGOAL_THEN (← q r"~(extension_degree(k,m) ((g:B->C) o (f:A->B)) = 0)") MP_TAC
      THENL
       [ASM_MESON_TAC [EXTENSION_DEGREE_EQ_0, FINITE_IMP_FIELD_EXTENSION],
        ASM_SIMP_TAC [EXTENSION_DEGREE_SEPARABLE_INSEPARABLE]] THEN
      DISCH_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN DISCH_TAC THEN
      MATCH_MP_TAC lemma THEN
      MAP_EVERY EXISTS_TAC [← q r"separable_degree(k,l) (f:A->B)",
                            ← q r"separable_degree(l,m) (g:B->C)"] THEN
      ASM_REWRITE_TAC []))

  -- @@RETURN BEGIN
  return { inseparable_degree, EXTENSION_DEGREE_SEPARABLE_INSEPARABLE,
           INSEPARABLE_DEGREE_EQ_1, INSEPARABLE_DEGREE_CHAR_POWER,
           INSEPARABLE_DEGREE_TOWER }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Norm and trace of a field extension: free bases over a field.             -/
/- (fieldtheory.ml 13596-13906)                                              -/
/- ------------------------------------------------------------------------- -/

structure FreeBasesField where
  -- @@FIELDS
  FREE_BASIS_SPANNING_EQ : thm
  FREE_BASIS_INDEPENDENT_EQ : thm
  FREE_BASIS_FIELD : thm
  FREE_BASIS_SIMPLE_EXTENSION : thm
  FREE_BASIS_EXTENSION_DEGREE : thm
  FREE_BASIS_SPANNING_DEGREE : thm
  FREE_BASIS_FROM_RING_BASIS : thm
  FREE_BASIS_EXISTS : thm
  FINITE_EXTENSION_FREE_BASIS : thm
  FREE_BASIS_IMP_FINITE_EXTENSION : thm
  FREE_BASIS_IMP_ALGEBRAIC : thm
  PROJECTIVE_BASIS_EXISTS_FIELD : thm
  PROJECTIVE_BASIS_IMP_FINITE_EXTENSION : thm
  deriving Inhabited

@[nospecialize]
def setupFreeBasesField [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BRingSpan : RingSpan) (BLinearAlgebra : LinearAlgebra) (BFinitary : Finitary) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BMinimalPolynomial : MinimalPolynomial) :
    ExceptT String IO FreeBasesField := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { CARD_IMAGE_INJ, CONTRAPOS_THM, EXTENSION, .. } := D.core1
  let { FIELD_NONTRIVIAL, FINITE_IMAGE, FINITE_NUMSEG_LT, FINITE_SUBSET,
        FORALL_IN_IMAGE, FUN_IN_IMAGE, HAS_SIZE, .. } := D.core2
  let { INJECTIVE_ON_LEFT_INVERSE, IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_SUM_EQ, .. } := D.core7
  let { SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core8
  let { ring_monomorphism, .. } := D.core9
  let { BASIS_COORDINATES_BASIS, CARD_IMAGE_EQ_INJ, CARD_IMAGE_LE, CARD_NUMSEG_LT,
        CARD_SUBSET_LE, EQ_TRANS, FREE_BASIS_PROJECTIVE, FREE_BASIS_RING_SUM_IMAGE,
        HAS_SIZE_INDEX, PROJECTIVE_BASIS_EXPAND, PROJECTIVE_BASIS_IN_CARRIER,
        RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { free_basis, .. } := D.core11
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, field_extension, .. } := BFieldExtension
  let { RING_SPAN_FINITE, RING_SPAN_INC, RING_SPAN_MUL, RING_SPAN_SUBSET,
        RING_SPAN_SUM, .. } := BRingSpan
  let { RING_SPANNING_ALT, RING_SPANNING_CONTAINS_BASIS, ring_basis, ring_independent,
        ring_spanning, .. } := BLinearAlgebra
  let { RING_INDEPENDENT_FINITE, .. } := BFinitary
  let { EXTENSION_DEGREE_EQ_CARD_BASIS, FINITE_EXTENSION_ANY, FINITE_EXTENSION_BASIS,
        FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { FINITE_SIMPLE_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { POWER_INJECTIVE_BELOW_MINPOLY_DEG, RING_SIMPLE_ALGEBRAIC_EXTENSION_BASIS, .. } := BMinimalPolynomial
  -- @@SCOPE END

  let FREE_BASIS_SPANNING_EQ ← prove
   r"!(h:A->B) k l n (g:num->B).
        ring_homomorphism(k,l) h /\
        (!i. i < n ==> g i IN ring_carrier l) /\
        (!i j. i < n /\ j < n /\ g i = g j ==> i = j)
        ==> (ring_spanning (k,l) h (IMAGE g {i | i < n}) <=>
             !x. x IN ring_carrier l
                 ==> ?c. (!i. i < n ==> c i IN ring_carrier k) /\
                         x = ring_sum l {i | i < n}
                               (\i. ring_mul l (h(c i)) (g i)))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (g:num->B) {i:num | i < n} SUBSET ring_carrier l")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM], ALL_TAC] THEN
    ASM_REWRITE_TAC [ring_spanning, ← GSYM SUBSET_ANTISYM_EQ,
                     RING_SPAN_SUBSET] THEN
    REWRITE_TAC [SUBSET] THEN AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"IMAGE (g:num->B) {i:num | i < n}"] RING_SPAN_FINITE) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT], DISCH_THEN SUBST1_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FREE_BASIS_RING_SUM_IMAGE th])) THEN
    REWRITE_TAC [IN_ELIM_THM, FORALL_IN_IMAGE] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"c:B->A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\i. (c:B->A)((g:num->B) i)") THEN ASM_REWRITE_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->A") STRIP_ASSUME_TAC)] THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"ginv:B->num") o GEN_REWRITE_RULE I
     [← REWRITE_RULE [IN_ELIM_THM] (← ISPECL [← q r"g:num->B", ← q r"{i:num | i < n}"]
        INJECTIVE_ON_LEFT_INVERSE)]) THEN
    EXISTS_TAC (← q r"\y:B. (c:num->A)(ginv y)") THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC RING_SUM_EQ THEN ASM_SIMP_TAC [IN_ELIM_THM])

  let FREE_BASIS_INDEPENDENT_EQ ← prove
   r"!(h:A->B) k l n (g:num->B).
        field k /\ ring_homomorphism(k,l) h /\
        (!i. i < n ==> g i IN ring_carrier l) /\
        (!i j. i < n /\ j < n /\ g i = g j ==> i = j)
        ==> (ring_independent (k,l) h (IMAGE g {i | i < n}) <=>
             !c. (!i. i < n ==> c i IN ring_carrier k) /\
                 ring_sum l {i | i < n} (\i. ring_mul l (h(c i)) (g i)) =
                 ring_0 l
                 ==> !i. i < n ==> c i = ring_0 k)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"IMAGE (g:num->B) {i:num | i < n}"]
      RING_INDEPENDENT_FINITE) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT], DISCH_THEN SUBST1_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FREE_BASIS_RING_SUM_IMAGE th])) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"ginv:B->num") o GEN_REWRITE_RULE I
     [← REWRITE_RULE [IN_ELIM_THM] (← ISPECL [← q r"g:num->B", ← q r"{i:num | i < n}"]
        INJECTIVE_ON_LEFT_INVERSE)]) THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"c:num->A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\y:B. (c:num->A)(ginv y)")) THEN
      SUBGOAL_THEN
       (← q r"ring_sum l {i:num | i < n}
        (\i. ring_mul l ((h:A->B)(c(ginv((g:num->B) i)))) (g i)) =
      ring_sum l {i | i < n} (\i. ring_mul l (h((c:num->A) i)) (g i))")
      MP_TAC THENL
       [MATCH_MP_TAC RING_SUM_EQ THEN ASM_SIMP_TAC [IN_ELIM_THM],
        ASM_SIMP_TAC []],
      X_GEN_TAC (← q r"c:B->A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\i. (c:B->A)((g:num->B) i)")) THEN
      ASM_REWRITE_TAC []])

  let FREE_BASIS_FIELD ← prove
   r"!(h:A->B) k l n g.
        field k /\ ring_homomorphism(k,l) h
        ==> (free_basis (k,l) h n g <=>
             ring_basis (k,l) h (IMAGE g {i | i < n}) /\
             (!i j. i < n /\ j < n /\ g i = g j ==> i = j))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"!i j. i < n /\ j < n /\ (g:num->B) i = g j ==> i = j") THEN
    ASM_REWRITE_TAC [] THENL
     [ALL_TAC,
      POP_ASSUM MP_TAC THEN REWRITE_TAC [CONTRAPOS_THM] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"n:num", ← q r"g:num->B",
                        ← q r"i:num", ← q r"i:num"] BASIS_COORDINATES_BASIS) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"n:num", ← q r"g:num->B",
                        ← q r"i:num", ← q r"j:num"] BASIS_COORDINATES_BASIS) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [FIELD_NONTRIVIAL]] THEN
    ASM_CASES_TAC (← q r"!i. i < n ==> (g:num->B) i IN ring_carrier l") THENL
     [REWRITE_TAC [ring_basis, free_basis] THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"n:num", ← q r"g:num->B"]
        FREE_BASIS_SPANNING_EQ) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"n:num", ← q r"g:num->B"]
        FREE_BASIS_INDEPENDENT_EQ) THEN
      ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN SUBST1_TAC) THEN
      CONV_TAC (fun t => (TAUT t).run),
      ASM_REWRITE_TAC [free_basis, ring_basis, ring_independent, SUBSET,
                       FORALL_IN_IMAGE, IN_ELIM_THM]])

  let FREE_BASIS_SIMPLE_EXTENSION ← prove
   r"!(k:A ring) (l:B ring) h x.
        field_extension(k,l) h /\ algebraic_over (k,l) h x
        ==> free_basis
             (k,subring_generated l (x INSERT IMAGE h (ring_carrier k))) h
             (poly_deg k (minimal_polynomial (k,l) h x)) (ring_pow l x)"
   (REPEAT STRIP_TAC THEN
    wPart (fun t => pure t) (fun t => do lhand (← rand t)) FREE_BASIS_FIELD THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [FINITE_SIMPLE_ALGEBRAIC_EXTENSION,
                     FINITE_IMP_FIELD_EXTENSION,
                     FIELD_EXTENSION_IMP_HOMOMORPHISM, field_extension],
      DISCH_THEN SUBST1_TAC] THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"IMAGE (ring_pow l (x:B))
            {i | i < poly_deg k (minimal_polynomial (k,l) (h:A->B) x)} =
      {ring_pow l x n | n | n < poly_deg k (minimal_polynomial (k,l) h x)}")
      SUBST1_TAC THENL
       [SET_TAC [], ASM_SIMP_TAC [RING_SIMPLE_ALGEBRAIC_EXTENSION_BASIS]],
      ASM_MESON_TAC [POWER_INJECTIVE_BELOW_MINPOLY_DEG]])

  let FREE_BASIS_EXTENSION_DEGREE ← prove
   r"!(h:A->B) k l n g.
        field k /\ ring_homomorphism(k,l) h /\ free_basis (k,l) h n g
        ==> n = extension_degree (k,l) h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"n:num", ← q r"g:num->B"]
      FREE_BASIS_FIELD) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"IMAGE (g:num->B) {i:num | i < n}"]
      EXTENSION_DEGREE_EQ_CARD_BASIS) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT] THEN DISCH_THEN SUBST1_TAC THEN
    TRANS_TAC EQ_TRANS (← q r"CARD {i:num | i < n}") THEN CONJ_TAC THENL
     [REWRITE_TAC [CARD_NUMSEG_LT],
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARD_IMAGE_INJ THEN
      ASM_REWRITE_TAC [FINITE_NUMSEG_LT, IN_ELIM_THM]])

  let FREE_BASIS_SPANNING_DEGREE ← prove
   r"!(h:A->B) k l n g.
        field k /\ ring_homomorphism(k,l) h /\
        extension_degree (k,l) h = n /\
        (!i. i < n ==> g i IN ring_carrier l) /\
        (!x. x IN ring_carrier l
             ==> ?c. (!i. i < n ==> c i IN ring_carrier k) /\
                     x = ring_sum l {i | i < n}
                           (\i. ring_mul l (h(c i)) (g i)))
        ==> free_basis (k,l) h n g"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"ring_spanning (k,l) (h:A->B) (IMAGE (g:num->B) {i | i < n})")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [RING_SPANNING_ALT, SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:B")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->A") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC RING_SPAN_SUM THEN
      X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
      MATCH_MP_TAC RING_SPAN_MUL THEN ASM_SIMP_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
        MATCH_MP_TAC RING_SPAN_INC THEN ASM_SIMP_TAC [] THEN
        MATCH_MP_TAC FUN_IN_IMAGE THEN ASM_REWRITE_TAC [IN_ELIM_THM]],
      ALL_TAC] THEN
    MP_TAC (← INST [(← q r"IMAGE (g:num->B) {i | i < n}", ← q r"b:B->bool")]
     (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
       RING_SPANNING_CONTAINS_BASIS)) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:B->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"FINITE(IMAGE (g:num->B) {i | i < n}) /\
    CARD(IMAGE (g:num->B) {i | i < n}) <= n")
    STRIP_ASSUME_TAC THENL
     [SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT] THEN
      MESON_TAC [CARD_IMAGE_LE, FINITE_NUMSEG_LT, CARD_NUMSEG_LT],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"c:B->bool"]
      EXTENSION_DEGREE_EQ_CARD_BASIS) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [FINITE_SUBSET], DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"c = IMAGE (g:num->B) {i | i < n}") SUBST_ALL_TAC THENL
     [MATCH_MP_TAC CARD_SUBSET_LE THEN
      REPEAT CONJ_TAC THEN TRY (FIRST_ASSUM ACCEPT_TAC) THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [FREE_BASIS_FIELD] THEN
    MP_TAC (← ISPECL [← q r"g:num->B", ← q r"{i:num | i < n}"] CARD_IMAGE_EQ_INJ) THEN
    REWRITE_TAC [FINITE_NUMSEG_LT, CARD_NUMSEG_LT, IN_ELIM_THM] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_ARITH_TAC)

  let FREE_BASIS_FROM_RING_BASIS ← prove
   r"!k:A ring l:B ring h b.
        field k /\ ring_homomorphism(k,l) h /\ ring_basis (k,l) h b /\ FINITE b
        ==> ?g. free_basis (k,l) h (CARD b) g"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"b:B->bool", ← q r"CARD(b:B->bool)"] HAS_SIZE_INDEX) THEN
    ASM_REWRITE_TAC [HAS_SIZE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->B") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"g:num->B") THEN ASM_SIMP_TAC [FREE_BASIS_FIELD] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    SUBGOAL_THEN (← q r"IMAGE (g:num->B) {i | i < CARD(b:B->bool)} = b")
     (fun th => ASM_REWRITE_TAC [th]) THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN ASM_MESON_TAC [])

  let FREE_BASIS_EXISTS ← prove
   r"!k:A ring l:B ring h s.
        field k /\ ring_homomorphism(k,l) h /\
        FINITE s /\ ring_spanning (k,l) h s
        ==> ?g. free_basis (k,l) h (extension_degree (k,l) h) g"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← INST [(← q r"s:B->bool", ← q r"b:B->bool")]
     (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
       RING_SPANNING_CONTAINS_BASIS)) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:B->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"FINITE(b:B->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_SUBSET], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"b:B->bool"]
      EXTENSION_DEGREE_EQ_CARD_BASIS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    MATCH_MP_TAC FREE_BASIS_FROM_RING_BASIS THEN ASM_REWRITE_TAC [])

  let FINITE_EXTENSION_FREE_BASIS ← prove
   r"!(h:A->B) k l.
        finite_extension(k,l) h
        ==> ?g. free_basis (k,l) h (extension_degree(k,l) h) g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FINITE_EXTENSION_BASIS] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"b:B->bool") STRIP_ASSUME_TAC)) THEN
    MATCH_MP_TAC FREE_BASIS_EXISTS THEN EXISTS_TAC (← q r"b:B->bool") THEN
    ASM_MESON_TAC [field_extension, ring_monomorphism, ring_basis])

  let FREE_BASIS_IMP_FINITE_EXTENSION ← prove
   r"!(h:A->B) k l n g.
        field_extension(k,l) h /\ free_basis (k,l) h n g
        ==> finite_extension(k,l) h"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"n:num", ← q r"g:num->B"]
      FREE_BASIS_FIELD) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"IMAGE (g:num->B) {i:num | i < n}"] FINITE_EXTENSION_ANY) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT])

  let FREE_BASIS_IMP_ALGEBRAIC ← prove
   r"!k (l:B ring) (h:A->B) n g x.
        field_extension(k,l) h /\ free_basis (k,l) h n g /\
        x IN ring_carrier l
        ==> algebraic_over (k,l) h x"
   (MESON_TAC [FREE_BASIS_IMP_FINITE_EXTENSION, FINITE_IMP_ALGEBRAIC_EXTENSION,
               algebraic_extension])

  let PROJECTIVE_BASIS_EXISTS_FIELD ← prove
   r"!(h:A->B) k l.
        field k /\ ring_homomorphism(k,l) h
        ==> ((?n e f. projective_basis (k,l) h n e f) <=>
             (?n g. free_basis (k,l) h n g))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"e:num->B", ← q r"f:num->B->A"] THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"extension_degree (k,l) (h:A->B)") THEN
      MATCH_MP_TAC FREE_BASIS_EXISTS THEN
      EXISTS_TAC (← q r"IMAGE (e:num->B) {i:num | i < n}") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT] THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP PROJECTIVE_BASIS_IN_CARRIER) THEN
      ASM_SIMP_TAC [RING_SPANNING_ALT, SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"n:num", ← q r"e:num->B",
                        ← q r"f:num->B->A", ← q r"x:B"] PROJECTIVE_BASIS_EXPAND) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC RING_SPAN_SUM THEN
      X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
      MATCH_MP_TAC RING_SPAN_MUL THEN ASM_SIMP_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
        MATCH_MP_TAC RING_SPAN_INC THEN ASM_SIMP_TAC [] THEN
        MATCH_MP_TAC FUN_IN_IMAGE THEN ASM_REWRITE_TAC [IN_ELIM_THM]],
      ASM_MESON_TAC [FREE_BASIS_PROJECTIVE]])

  let PROJECTIVE_BASIS_IMP_FINITE_EXTENSION ← prove
   r"!(h:A->B) k l n e f.
        field_extension(k,l) h /\ projective_basis (k,l) h n e f
        ==> finite_extension(k,l) h"
   (← do
    let t1 ← TAUT (← q r"p /\ (q ==> r) ==> (p <=> q) ==> r")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      PROJECTIVE_BASIS_EXISTS_FIELD) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC t1 THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [], ASM_MESON_TAC [FREE_BASIS_IMP_FINITE_EXTENSION]]))

  -- @@RETURN BEGIN
  return { FREE_BASIS_SPANNING_EQ, FREE_BASIS_INDEPENDENT_EQ, FREE_BASIS_FIELD,
           FREE_BASIS_SIMPLE_EXTENSION, FREE_BASIS_EXTENSION_DEGREE,
           FREE_BASIS_SPANNING_DEGREE, FREE_BASIS_FROM_RING_BASIS, FREE_BASIS_EXISTS,
           FINITE_EXTENSION_FREE_BASIS, FREE_BASIS_IMP_FINITE_EXTENSION,
           FREE_BASIS_IMP_ALGEBRAIC, PROJECTIVE_BASIS_EXISTS_FIELD,
           PROJECTIVE_BASIS_IMP_FINITE_EXTENSION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The trace and the norm of elements of the base field, and the norm        -/
/- vanishes only at 0.                                                       -/
/- (fieldtheory.ml 13908-13946)                                              -/
/- ------------------------------------------------------------------------- -/

structure NormTraceBase where
  -- @@FIELDS
  ALGEBRA_TRACE_NORM_BASE : thm
  ALGEBRA_NORM_EQ_0 : thm
  deriving Inhabited

@[nospecialize]
def setupNormTraceBase [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BFreeBasesField : FreeBasesField) :
    ExceptT String IO NormTraceBase := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, .. } := D
  let { RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_MUL_LZERO, .. } := D.core7
  let { ring_pow, .. } := D.core9
  let { ALGEBRA_NORM_EQ_0_FREE_BASIS, ALGEBRA_TRACE_NORM_BASE_FREE_BASIS,
        ALGEBRA_TRACE_NORM_NO_PROJECTIVE_BASIS, LT_NZ, .. } := D.core10
  let { RING_OF_NUM_0, .. } := D.core11
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, field_extension, .. } := BFieldExtension
  let { EXTENSION_DEGREE_EQ_0, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { FINITE_EXTENSION_FREE_BASIS, PROJECTIVE_BASIS_IMP_FINITE_EXTENSION, .. } := BFreeBasesField
  -- @@SCOPE END

  let ALGEBRA_TRACE_NORM_BASE ← prove
   r"!(h:A->B) k l a.
        field_extension(k,l) h /\ a IN ring_carrier k
        ==> algebra_trace(k,l) h (h a) =
            ring_mul k (ring_of_num k (extension_degree(k,l) h)) a /\
            algebra_norm(k,l) h (h a) = ring_pow k a (extension_degree(k,l) h)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM) THEN
    ASM_CASES_TAC (← q r"finite_extension(k,l) (h:A->B)") THENL
     [FIRST_ASSUM (X_CHOOSE_TAC (← q r"g:num->B") o
        MATCH_MP FINITE_EXTENSION_FREE_BASIS) THEN
      MATCH_MP_TAC ALGEBRA_TRACE_NORM_BASE_FREE_BASIS THEN
      EXISTS_TAC (← q r"g:num->B") THEN ASM_REWRITE_TAC [],
      SUBGOAL_THEN (← q r"~(?n e f. projective_basis (k,l) (h:A->B) n e f)")
      ASSUME_TAC THENL
       [ASM_MESON_TAC [PROJECTIVE_BASIS_IMP_FINITE_EXTENSION], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"extension_degree(k,l) (h:A->B) = 0") SUBST1_TAC THENL
       [ASM_MESON_TAC [EXTENSION_DEGREE_EQ_0], ALL_TAC] THEN
      ASM_SIMP_TAC [ALGEBRA_TRACE_NORM_NO_PROJECTIVE_BASIS, ring_pow,
                    RING_OF_NUM_0, RING_MUL_LZERO]])

  let ALGEBRA_NORM_EQ_0 ← prove
   r"!(h:A->B) k l x.
        finite_extension(k,l) h /\ x IN ring_carrier l
        ==> (algebra_norm(k,l) h x = ring_0 k <=> x = ring_0 l)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (X_CHOOSE_TAC (← q r"g:num->B") o
      MATCH_MP FINITE_EXTENSION_FREE_BASIS) THEN
    MATCH_MP_TAC ALGEBRA_NORM_EQ_0_FREE_BASIS THEN
    MAP_EVERY EXISTS_TAC [← q r"extension_degree(k,l) (h:A->B)", ← q r"g:num->B"] THEN
    ASM_SIMP_TAC [LT_NZ, EXTENSION_DEGREE_EQ_0] THEN
    ASM_MESON_TAC [field_extension, RING_MONOMORPHISM_IMP_HOMOMORPHISM])

  -- @@RETURN BEGIN
  return { ALGEBRA_TRACE_NORM_BASE, ALGEBRA_NORM_EQ_0 }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Elements of an intermediate field: the Kronecker product of the matrix    -/
/- of y over k with the identity of size [m:l].                              -/
/- (fieldtheory.ml 13948-14032)                                              -/
/- ------------------------------------------------------------------------- -/

structure NormTraceIntermediate where
  -- @@FIELDS
  ALGEBRA_TRACE_NORM_INTERMEDIATE : thm
  FIELD_CHARPOLY_INTERMEDIATE : thm
  deriving Inhabited

@[nospecialize]
def setupNormTraceIntermediate [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BFreeBasesField : FreeBasesField) :
    ExceptT String IO NormTraceIntermediate := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, .. } := D
  let { RING_HOMOMORPHISM_COMPOSE, .. } := D.core6
  let { RING_MUL_LZERO, RING_MUL_RZERO, .. } := D.core7
  let { ring_pow, .. } := D.core9
  let { ALGEBRA_TRACE_NORM_INTERMEDIATE_FREE_BASIS, ALGEBRA_TRACE_NORM_IN_CARRIER,
        ALGEBRA_TRACE_NORM_NO_PROJECTIVE_BASIS, FREE_BASIS_TRANS,
        MUL_MATRIX_CHARPOLY_BASIS, MUL_MATRIX_CHARPOLY_INTERMEDIATE,
        RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { RING_OF_NUM, RING_OF_NUM_0, RING_POW_ONE, .. } := D.core11
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_TRANS, .. } := BFieldExtension
  let { EXTENSION_DEGREE_EQ_0, FINITE_EXTENSION_TRANS_EQ, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { FINITE_EXTENSION_FREE_BASIS, PROJECTIVE_BASIS_IMP_FINITE_EXTENSION, .. } := BFreeBasesField
  -- @@SCOPE END

  let ALGEBRA_TRACE_NORM_INTERMEDIATE ← prove
   r"!(f:A->B) (g:B->C) k l m y.
        field_extension(k,l) f /\ field_extension(l,m) g /\
        y IN ring_carrier l
        ==> algebra_trace(k,m) (g o f) (g y) =
            ring_mul k (ring_of_num k (extension_degree(l,m) g))
                       (algebra_trace(k,l) f y) /\
            algebra_norm(k,m) (g o f) (g y) =
            ring_pow k (algebra_norm(k,l) f y) (extension_degree(l,m) g)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"ring_homomorphism(k,l) (f:A->B) /\ ring_homomorphism(l,m) (g:B->C) /\
    field_extension(k,m) (g o f)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_TRANS],
      ALL_TAC] THEN
    ASM_CASES_TAC
     (← q r"finite_extension(k,l) (f:A->B) /\ finite_extension(l,m) (g:B->C)") THENL
     [FIRST_X_ASSUM (CONJUNCTS_THEN2
       (X_CHOOSE_TAC (← q r"b:num->B") o MATCH_MP FINITE_EXTENSION_FREE_BASIS)
       (X_CHOOSE_TAC (← q r"c:num->C") o MATCH_MP FINITE_EXTENSION_FREE_BASIS)) THEN
      MATCH_MP_TAC ALGEBRA_TRACE_NORM_INTERMEDIATE_FREE_BASIS THEN
      MAP_EVERY EXISTS_TAC
       [← q r"extension_degree(k,l) (f:A->B)", ← q r"b:num->B", ← q r"c:num->C"] THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"~(?n d e. projective_basis (k,m) ((g:B->C) o (f:A->B)) n d e)")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [PROJECTIVE_BASIS_IMP_FINITE_EXTENSION,
                     FINITE_EXTENSION_TRANS_EQ],
      ASM_SIMP_TAC [ALGEBRA_TRACE_NORM_NO_PROJECTIVE_BASIS]] THEN
    ASM_CASES_TAC (← q r"finite_extension(k,l) (f:A->B)") THENL
     [SUBGOAL_THEN (← q r"extension_degree(l,m) (g:B->C) = 0") SUBST1_TAC THENL
       [ASM_MESON_TAC [EXTENSION_DEGREE_EQ_0], ALL_TAC] THEN
      SIMP_TAC [ring_pow, RING_OF_NUM_0, RING_MUL_LZERO,
                ALGEBRA_TRACE_NORM_IN_CARRIER],
      SUBGOAL_THEN (← q r"~(?n b e. projective_basis (k,l) (f:A->B) n b e)")
      ASSUME_TAC THENL
       [ASM_MESON_TAC [PROJECTIVE_BASIS_IMP_FINITE_EXTENSION], ALL_TAC] THEN
      ASM_SIMP_TAC [ALGEBRA_TRACE_NORM_NO_PROJECTIVE_BASIS, RING_MUL_RZERO,
                    RING_OF_NUM, RING_POW_ONE]])

  let FIELD_CHARPOLY_INTERMEDIATE ← prove
   r"!(f:A->B) (g:B->C) k l m p b n d y.
        finite_extension(k,l) f /\ finite_extension(l,m) g /\
        free_basis (k,l) f p b /\ free_basis (k,m) (g o f) n d /\
        y IN ring_carrier l
        ==> ring_charpoly k {i | i < n} (mul_matrix (k,m) (g o f) n d (g y)) =
            poly_pow k (ring_charpoly k {i | i < p} (mul_matrix (k,l) f p b y))
                     (extension_degree(l,m) g)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"ring_homomorphism(k,l) (f:A->B) /\ ring_homomorphism(l,m) (g:B->C)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM,
                     FINITE_IMP_FIELD_EXTENSION],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(k,m) ((g:B->C) o (f:A->B))") ASSUME_TAC THENL
     [MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"finite_extension(l,m) (g:B->C)"
      if !(concl th == c) then throw "check"
      pure ((X_CHOOSE_TAC (← q r"c:num->C") o MATCH_MP FINITE_EXTENSION_FREE_BASIS) th)) THEN
    ABBREV_TAC (← q r"q = extension_degree(l,m) (g:B->C)") THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"p:num", ← q r"q:num", ← q r"b:num->B", ← q r"c:num->C"]
      FREE_BASIS_TRANS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"(g:B->C) o (f:A->B)", ← q r"k:A ring", ← q r"m:C ring", ← q r"(p:num) * q",
                      ← q r"n:num",
                      ← q r"\t. ring_mul m ((g:B->C)(b(t MOD p))) ((c:num->C)(t DIV p))",
                      ← q r"d:num->C", ← q r"(g:B->C) y"] MUL_MATRIX_CHARPOLY_BASIS) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
      DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC MUL_MATRIX_CHARPOLY_INTERMEDIATE THEN ASM_REWRITE_TAC [])

  -- @@RETURN BEGIN
  return { ALGEBRA_TRACE_NORM_INTERMEDIATE, FIELD_CHARPOLY_INTERMEDIATE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The characteristic polynomial of the multiplication by x; the trace and   -/
/- the norm from the minimal polynomial.                                     -/
/- (fieldtheory.ml 14032-14293)                                              -/
/- ------------------------------------------------------------------------- -/

structure FieldCharpoly where
  -- @@FIELDS
  FIELD_CHARPOLY_SIMPLE : thm
  FIELD_CHARPOLY_MINIMAL_POLYNOMIAL : thm
  ALGEBRA_TRACE_NORM_SIMPLE : thm
  ALGEBRA_TRACE_NORM_MINIMAL_POLYNOMIAL : thm
  ALGEBRA_NORM_MINIMAL_POLYNOMIAL : thm
  ALGEBRA_TRACE_MINIMAL_POLYNOMIAL : thm
  deriving Inhabited

@[nospecialize]
def setupFieldCharpoly [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated : SubfieldGenerated) (BSubfieldGenerated1 : SubfieldGenerated1) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BMinimalPolynomial : MinimalPolynomial) (BFreeBasesField : FreeBasesField) (BNormTraceIntermediate : NormTraceIntermediate) :
    ExceptT String IO FieldCharpoly := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, RING_RULE, SET_TAC, .. } := D
  let { FIELD_NONTRIVIAL, FINITE_NUMSEG_LT, .. } := D.core2
  let { IN_ELIM_THM, IN_INSERT, I_O_ID, I_THM, LE_REFL, .. } := D.core3
  let { MEMBER_NOT_EMPTY, .. } := D.core4
  let { POLY_EXTEND_INTO_SUBRING_GENERATED, RING_1, .. } := D.core5
  let { RING_MUL_ASSOC, RING_MUL_LID, RING_NEG, RING_POLYNOMIAL, RING_POW, RING_SUM,
        SUBRING_GENERATED, .. } := D.core7
  let { SUBRING_GENERATED_INC_GEN, .. } := D.core8
  let { ALGEBRA_NORM_FREE_BASIS, ALGEBRA_TRACE_FREE_BASIS, CARD_NUMSEG_LT,
        COEFF_IN_CARRIER_ALT, MONIC_DIVIDES_EQ, MUL_MATRIX_CHARPOLY_ROOT,
        MUL_MATRIX_IN_CARRIER, RING_CHARPOLY, RING_CHARPOLY_COEFF_0,
        RING_CHARPOLY_COEFF_TRACE, RING_CHARPOLY_MONIC, RING_DET, .. } := D.core10
  let { RING_MUL_POW, RING_MUL_RNEG, RING_NEG_NEG, RING_OF_NUM, RING_POW_ONE, .. } := D.core11
  let { SUBRING_EQ_SUBFIELD_GENERATED, .. } := BSubfieldGenerated
  let { SUBFIELD_GENERATED_INC_GEN, .. } := BSubfieldGenerated1
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, field_extension, .. } := BFieldExtension
  let { EXTENSION_DEGREE_EQ_0, FINITE_EXTENSION_SUBFIELD_GENERATED,
        FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { ALGEBRAIC_OVER_IN_CARRIER, algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { FIELD_SIMPLE_ALGEBRAIC_EXTENSION, FINITE_SIMPLE_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { EXTENSION_DEGREE_SIMPLE, MINIMAL_POLYNOMIAL_DIVIDES,
        MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_MONIC, .. } := BMinimalPolynomial
  let { FINITE_EXTENSION_FREE_BASIS, FREE_BASIS_EXTENSION_DEGREE, .. } := BFreeBasesField
  let { ALGEBRA_TRACE_NORM_INTERMEDIATE, FIELD_CHARPOLY_INTERMEDIATE, .. } := BNormTraceIntermediate
  -- @@SCOPE END

  let FIELD_CHARPOLY_SIMPLE ← prove
   r"!(h:A->B) k l x n c.
        field_extension(k,l) h /\ algebraic_over(k,l) h x /\
        free_basis (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)))
                   h n c
        ==> ring_charpoly k {i | i < n}
              (mul_matrix
                (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)))
                h n c x) =
            minimal_polynomial(k,l) h x"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ABBREV_TAC
     (← q r"K = subfield_generated l (x INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    SUBGOAL_THEN
     (← q r"subring_generated l (x INSERT IMAGE (h:A->B) (ring_carrier k)) = K")
    ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN MATCH_MP_TAC SUBRING_EQ_SUBFIELD_GENERATED THEN
      ASM_SIMP_TAC [FIELD_SIMPLE_ALGEBRAIC_EXTENSION],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"finite_extension(k,K) (h:A->B)") ASSUME_TAC THENL
     [FIRST_ASSUM (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [FINITE_SIMPLE_ALGEBRAIC_EXTENSION],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field_extension(k,K) (h:A->B)") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_FIELD_EXTENSION], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(k,K) (h:A->B)") ASSUME_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(x:B) IN ring_carrier K") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN MATCH_MP_TAC SUBRING_GENERATED_INC_GEN THEN
      ASM_MESON_TAC [IN_INSERT, ALGEBRAIC_OVER_IN_CARRIER],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"q = ring_charpoly k {i:num | i < n} (mul_matrix (k,K) (h:A->B) n c x)") THEN
    SUBGOAL_THEN (← q r"q IN ring_carrier(poly_ring (k:A ring) (:1))") ASSUME_TAC THENL
     [EXPAND_TAC "q" THEN REWRITE_TAC [RING_CHARPOLY], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"poly_extend (k,l) (h:A->B) (\v:1. x) (q:(1->num)->A) = ring_0 l")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"n:num", ← q r"c:num->B",
                        ← q r"x:B"] MUL_MATRIX_CHARPOLY_ROOT) THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"ring_0 K = ring_0 (l:B ring)") SUBST1_TAC THENL
       [EXPAND_TAC "K" THEN REWRITE_TAC [SUBRING_GENERATED], ALL_TAC] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN CONV_TAC SYM_CONV THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring",
                        ← q r"x INSERT IMAGE (h:A->B) (ring_carrier k)", ← q r"h:A->B",
                        ← q r"(:1)", ← q r"\v:1. (x:B)", ← q r"q:(1->num)->A"]
        POLY_EXTEND_INTO_SUBRING_GENERATED) THEN
      ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"field_extension(k:A ring,l:B ring) h"
      if !(concl th == c) then throw "check"
      pure ((STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) th)) THEN
    SUBGOAL_THEN (← q r"extension_degree(k,K) (h:A->B) = n") ASSUME_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC FREE_BASIS_EXTENSION_DEGREE THEN
      EXISTS_TAC (← q r"c:num->B") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      EXTENSION_DEGREE_SIMPLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"{i:num | i < n}",
      ← q r"mul_matrix (k,K) (h:A->B) n c x"] RING_CHARPOLY_MONIC) THEN
    ASM_SIMP_TAC [FIELD_NONTRIVIAL, FINITE_NUMSEG_LT, IN_ELIM_THM,
                  MUL_MATRIX_IN_CARRIER, CARD_NUMSEG_LT] THEN
    STRIP_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC MONIC_DIVIDES_EQ THEN
    EXISTS_TAC (← q r"k:A ring") THEN
    ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_MONIC, MINIMAL_POLYNOMIAL_DIVIDES] THEN
    ASM_MESON_TAC [LE_REFL])

  let FIELD_CHARPOLY_MINIMAL_POLYNOMIAL ← prove
   r"!(h:A->B) k l n g x.
        finite_extension(k,l) h /\ free_basis (k,l) h n g /\
        x IN ring_carrier l
        ==> ring_charpoly k {i | i < n} (mul_matrix (k,l) h n g x) =
            poly_pow k (minimal_polynomial(k,l) h x)
             (extension_degree
               (subfield_generated l (x INSERT IMAGE h (ring_carrier k)),l)
               I)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION, algebraic_extension],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"K = subfield_generated l (x INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"x INSERT IMAGE (h:A->B) (ring_carrier k)"]
      FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [SET_TAC [], STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"(x:B) IN ring_carrier K") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
      ASM_REWRITE_TAC [IN_INSERT],
      ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"finite_extension(k,K) (h:A->B)"
      if !(concl th == c) then throw "check"
      pure ((X_CHOOSE_TAC (← q r"c:num->B") o MATCH_MP FINITE_EXTENSION_FREE_BASIS) th)) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"l:B ring",
                      ← q r"extension_degree(k,K) (h:A->B)", ← q r"c:num->B", ← q r"n:num",
                      ← q r"g:num->B", ← q r"x:B"]
      FIELD_CHARPOLY_INTERMEDIATE) THEN
    ASM_REWRITE_TAC [I_O_ID, I_THM] THEN DISCH_THEN SUBST1_TAC THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN EXPAND_TAC "K" THEN
    MATCH_MP_TAC FIELD_CHARPOLY_SIMPLE THEN ASM_REWRITE_TAC [])

  let ALGEBRA_TRACE_NORM_SIMPLE ← prove
   r"!(h:A->B) k l x.
        field_extension(k,l) h /\ algebraic_over(k,l) h x
        ==> algebra_trace
             (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k))) h x =
            ring_neg k (coeff (poly_deg k (minimal_polynomial(k,l) h x) - 1)
                              (minimal_polynomial(k,l) h x)) /\
            algebra_norm
             (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k))) h x =
            ring_mul k
             (ring_pow k (ring_neg k (ring_1 k))
                (poly_deg k (minimal_polynomial(k,l) h x)))
             (coeff 0 (minimal_polynomial(k,l) h x))"
   (← do
    let r1 ← RING_RULE
     (← q r"ring_mul r (ring_neg r (ring_1 r)) (ring_neg r (ring_1 r)) =
      ring_1(r:A ring)")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ABBREV_TAC
     (← q r"K = subfield_generated l (x INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    SUBGOAL_THEN (← q r"finite_extension(k,K) (h:A->B)") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN
      SUBGOAL_THEN
       (← q r"subfield_generated l (x INSERT IMAGE (h:A->B) (ring_carrier k)) =
      subring_generated l (x INSERT IMAGE h (ring_carrier k))")
      SUBST1_TAC THENL
       [CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUBRING_EQ_SUBFIELD_GENERATED THEN
        ASM_SIMP_TAC [FIELD_SIMPLE_ALGEBRAIC_EXTENSION],
        ASM_SIMP_TAC [FINITE_SIMPLE_ALGEBRAIC_EXTENSION]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field_extension(k,K) (h:A->B)") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_FIELD_EXTENSION], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(k,K) (h:A->B)") ASSUME_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM], ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"finite_extension(k,K) (h:A->B)"
      if !(concl th == c) then throw "check"
      pure ((X_CHOOSE_TAC (← q r"c:num->B") o MATCH_MP FINITE_EXTENSION_FREE_BASIS) th)) THEN
    ABBREV_TAC (← q r"n = extension_degree(k,K) (h:A->B)") THEN
    SUBGOAL_THEN (← q r"(x:B) IN ring_carrier K") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
      ASM_MESON_TAC [IN_INSERT, ALGEBRAIC_OVER_IN_CARRIER],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B", ← q r"n:num", ← q r"c:num->B"]
      FIELD_CHARPOLY_SIMPLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"n:num", ← q r"c:num->B"]
                    ALGEBRA_TRACE_FREE_BASIS,
                  ← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"n:num", ← q r"c:num->B"]
                    ALGEBRA_NORM_FREE_BASIS] THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"field_extension(k:A ring,l:B ring) h"
      if !(concl th == c) then throw "check"
      pure ((STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) th)) THEN
    SUBGOAL_THEN (← q r"~({i:num | i < n} = {})") ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN EXISTS_TAC (← q r"0") THEN
      SUBGOAL_THEN (← q r"~(n:num = 0)") MP_TAC THENL
       [EXPAND_TAC "n" THEN ASM_MESON_TAC [EXTENSION_DEGREE_EQ_0], ARITH_TAC],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"{i:num | i < n}",
      ← q r"mul_matrix (k,K) (h:A->B) n c x"] RING_CHARPOLY_MONIC) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"{i:num | i < n}",
      ← q r"mul_matrix (k,K) (h:A->B) n c x"] RING_CHARPOLY_COEFF_TRACE) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"{i:num | i < n}",
      ← q r"mul_matrix (k,K) (h:A->B) n c x"] RING_CHARPOLY_COEFF_0) THEN
    ASM_SIMP_TAC [FIELD_NONTRIVIAL, FINITE_NUMSEG_LT, IN_ELIM_THM,
                  MUL_MATRIX_IN_CARRIER, CARD_NUMSEG_LT] THEN
    REPEAT (DISCH_THEN (ASSUME_TAC o SYM o check (is_eq o concl)) ORELSE
            DISCH_TAC) THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"coeff (n - 1)
                              (minimal_polynomial (k,l) (h:A->B) x)"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      ASM_SIMP_TAC [RING_NEG_NEG, RING_SUM],
      FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"coeff 0 (minimal_polynomial (k,l) (h:A->B) x)"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((SUBST1_TAC o SYM) th)) THEN
      ASM_SIMP_TAC [RING_MUL_ASSOC, RING_POW, RING_NEG, RING_1, RING_DET,
                    ← GSYM RING_MUL_POW] THEN
      REWRITE_TAC [r1, RING_POW_ONE] THEN
      ASM_SIMP_TAC [RING_MUL_LID, RING_DET]]))

  let ALGEBRA_TRACE_NORM_MINIMAL_POLYNOMIAL ← prove
   r"!(h:A->B) k l x.
        finite_extension(k,l) h /\ x IN ring_carrier l
        ==> algebra_trace(k,l) h x =
            ring_neg k
             (ring_mul k
               (ring_of_num k
                 (extension_degree
                   (subfield_generated l (x INSERT IMAGE h (ring_carrier k)),l)
                   I))
               (coeff (poly_deg k (minimal_polynomial(k,l) h x) - 1)
                      (minimal_polynomial(k,l) h x))) /\
            algebra_norm(k,l) h x =
            ring_pow k
             (ring_mul k
               (ring_pow k (ring_neg k (ring_1 k))
                  (poly_deg k (minimal_polynomial(k,l) h x)))
               (coeff 0 (minimal_polynomial(k,l) h x)))
             (extension_degree
               (subfield_generated l (x INSERT IMAGE h (ring_carrier k)),l) I)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION, algebraic_extension],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"K = subfield_generated l (x INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"x INSERT IMAGE (h:A->B) (ring_carrier k)"]
      FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
    ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [SET_TAC [], STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"(x:B) IN ring_carrier K") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN MATCH_MP_TAC SUBFIELD_GENERATED_INC_GEN THEN
      ASM_REWRITE_TAC [IN_INSERT],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"field_extension(k,K) (h:A->B) /\ field_extension(K,l) (I:B->B)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_FIELD_EXTENSION], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"l:B ring",
                      ← q r"x:B"] ALGEBRA_TRACE_NORM_INTERMEDIATE) THEN
    ASM_REWRITE_TAC [I_O_ID, I_THM] THEN DISCH_THEN (CONJUNCTS_THEN SUBST1_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      ALGEBRA_TRACE_NORM_SIMPLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (CONJUNCTS_THEN SUBST1_TAC) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC RING_MUL_RNEG THEN
    REWRITE_TAC [RING_OF_NUM] THEN MATCH_MP_TAC COEFF_IN_CARRIER_ALT THEN
    REWRITE_TAC [RING_POLYNOMIAL] THEN
    MATCH_MP_TAC MINIMAL_POLYNOMIAL_IN_CARRIER THEN ASM_REWRITE_TAC [])

  let ALGEBRA_NORM_MINIMAL_POLYNOMIAL ← prove
   r"!(h:A->B) k l x.
        finite_extension(k,l) h /\ x IN ring_carrier l
        ==> algebra_norm(k,l) h x =
            ring_pow k
             (ring_mul k
               (ring_pow k (ring_neg k (ring_1 k))
                  (poly_deg k (minimal_polynomial(k,l) h x)))
               (coeff 0 (minimal_polynomial(k,l) h x)))
             (extension_degree
               (subfield_generated l (x INSERT IMAGE h (ring_carrier k)),l) I)"
   (SIMP_TAC [ALGEBRA_TRACE_NORM_MINIMAL_POLYNOMIAL])

  let ALGEBRA_TRACE_MINIMAL_POLYNOMIAL ← prove
   r"!(h:A->B) k l x.
        finite_extension(k,l) h /\ x IN ring_carrier l
        ==> algebra_trace(k,l) h x =
            ring_neg k
             (ring_mul k
               (ring_of_num k
                 (extension_degree
                   (subfield_generated l (x INSERT IMAGE h (ring_carrier k)),l)
                   I))
               (coeff (poly_deg k (minimal_polynomial(k,l) h x) - 1)
                      (minimal_polynomial(k,l) h x)))"
   (SIMP_TAC [ALGEBRA_TRACE_NORM_MINIMAL_POLYNOMIAL])

  -- @@RETURN BEGIN
  return { FIELD_CHARPOLY_SIMPLE, FIELD_CHARPOLY_MINIMAL_POLYNOMIAL,
           ALGEBRA_TRACE_NORM_SIMPLE, ALGEBRA_TRACE_NORM_MINIMAL_POLYNOMIAL,
           ALGEBRA_NORM_MINIMAL_POLYNOMIAL, ALGEBRA_TRACE_MINIMAL_POLYNOMIAL }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Norm and trace by embeddings: preliminaries (single roots over an         -/
/- algebraically closed field, simple algebraic subfields, extensions        -/
/- through k(x) and towers).                                                 -/
/- (fieldtheory.ml 14295-14475)                                              -/
/- ------------------------------------------------------------------------- -/

structure EmbeddingsPrelims where
  -- @@FIELDS
  ALGEBRAICALLY_CLOSED_FIELD_SINGLE_ROOT : thm
  SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC : thm
  SUBFIELD_GENERATED_SING_ALGEBRAIC : thm
  FINITE_EXTENSION_SIMPLE_EQ : thm
  RING_HOMOMORPHISM_EXTENSIONS_SIMPLE_EQ : thm
  RING_HOMOMORPHISM_EXTENSIONS_TOWER_PRODUCT : thm
  RING_HOMOMORPHISM_EXTENSIONS_TOWER_SUM : thm
  deriving Inhabited

@[nospecialize]
def setupEmbeddingsPrelims [HolBase] (D : FieldTheoryDeps) (BSubfields : Subfields) (BSubfieldGenerated : SubfieldGenerated) (BSubfieldGenerated1 : SubfieldGenerated1) (BSubfieldGenerated2 : SubfieldGenerated2) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BMinimalPolynomial : MinimalPolynomial) (BAlgebraicTrans : AlgebraicTrans) (BAcfBasic : AcfBasic) (BAcfSplit : AcfSplit) (BHomExtensions : HomExtensions) (BHomExtensionsCount : HomExtensionsCount) :
    ExceptT String IO EmbeddingsPrelims := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { CARD_NUMSEG_1, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FINITE_NUMSEG, IMAGE_I, .. } := D.core2
  let { INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, IN_ELIM_THM, IN_IMAGE, IN_INSERT,
        IN_NUMSEG, I_O_ID, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { POLY_CONST_1, POLY_DEG_X_MINUS_A, .. } := D.core4
  let { POLY_RING_CLAUSES, POLY_X_MINUS_A_IN_CARRIER, .. } := D.core5
  let { RING_MUL_RID, RING_POLYNOMIAL, RING_POLYNOMIAL_IMP_POWERSERIES,
        RING_PRODUCT_EQ, .. } := D.core7
  let { SUBRING_GENERATED_INC_GEN, .. } := D.core8
  let { COEFF_POLY_LMUL, EQ_TRANS, EXTENSIONAL_EQ, MONIC_IMP_NONZERO, MONIC_POLY_POW,
        MONIC_X_MINUS_A, MULT_CLAUSES, POLY_DEG_POW, POLY_MUL_LID, POLY_ROOTS_SPLIT, .. } := D.core10
  let { RING_POLYNOMIAL_POW, RING_POLYNOMIAL_X_MINUS_A, RING_PRODUCT_CONST,
        RING_PRODUCT_UNIONS_PAIRWISE_DISJOINT, RING_SUM_UNIONS_PAIRWISE_DISJOINT,
        monic, .. } := D.core11
  let { IN_SUBFIELD_0, .. } := BSubfields
  let { FIELD_SUBFIELD_GENERATED, SUBFIELDS_GENERATED_EQ, SUBFIELD_GENERATED_EQ,
        SUBRING_EQ_SUBFIELD_GENERATED, .. } := BSubfieldGenerated
  let { SUBFIELD_GENERATED_IDEMPOT, SUBFIELD_GENERATED_INSERT, .. } := BSubfieldGenerated1
  let { RING_HOMOMORPHISMS_EQ_FROM_SUBFIELD_GENERATED, .. } := BSubfieldGenerated2
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
        FIELD_EXTENSION_SUBFIELD_GENERATED, field_extension, .. } := BFieldExtension
  let { EXTENSION_DEGREE_EQ_TOWER, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { ALGEBRAIC_OVER_IN_CARRIER, algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { FIELD_SIMPLE_ALGEBRAIC_EXTENSION, FINITE_SIMPLE_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { EXTENSION_DEGREE_SIMPLE, .. } := BMinimalPolynomial
  let { MINIMAL_POLYNOMIAL_SUBRING_GENERATED, .. } := BAlgebraicTrans
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ALGEBRAICALLY_CLOSED_FIELD_SPLITS, .. } := BAcfSplit
  let { ring_homomorphism_extensions, .. } := BHomExtensions
  let { CARD_RING_HOMOMORPHISM_EXTENSIONS_LE, RING_HOMOMORPHISM_EXTENSIONS_TOWER, .. } := BHomExtensionsCount
  -- @@SCOPE END

  let ALGEBRAICALLY_CLOSED_FIELD_SINGLE_ROOT ← prove
   r"!(m:C ring) q b.
        algebraically_closed_field m /\ q IN ring_carrier(poly_ring m (:1)) /\
        monic m q /\ b IN ring_carrier m /\
        (!y. y IN ring_carrier m /\ poly_eval m q y = ring_0 m ==> y = b)
        ==> q = poly_pow m (poly_sub m (poly_var m one) (poly_const m b))
                  (poly_deg m q)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING) THEN
    SUBGOAL_THEN (← q r"ring_polynomial m (q:(1->num)->C)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [RING_POLYNOMIAL], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"m:C ring", ← q r"q:(1->num)->C"]
      ALGEBRAICALLY_CLOSED_FIELD_SPLITS) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [MONIC_IMP_NONZERO], ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    ABBREV_TAC (← q r"n = poly_deg m (q:(1->num)->C)") THEN
    MAP_EVERY X_GEN_TAC [← q r"c:C", ← q r"a:num->C"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!i. 1 <= i /\ i <= n ==> (a:num->C) i = b") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      MATCH_MP_TAC (← ASSUME
       (← q r"!y:C. y IN ring_carrier m /\ poly_eval m q y = ring_0 m ==> y = b")) THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"q:(1->num)->C"
        if !((← liftExcept (lhs (concl th))) == c) then throw "check"
        pure (SUBST1_TAC th)) THEN
      MP_TAC (← ISPECL [← q r"m:C ring", ← q r"c:C", ← q r"a:num->C", ← q r"n:num", ← q r"(a:num->C) i"]
        POLY_ROOTS_SPLIT) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [IN_IMAGE, IN_NUMSEG] THEN ASM_MESON_TAC [],
      UNDISCH_THEN
       (← q r"!y:C. y IN ring_carrier m /\ poly_eval m q y = ring_0 m ==> y = b")
       (K ALL_TAC : thm → tactic)] THEN
    SUBGOAL_THEN
     (← q r"ring_product (poly_ring m (:1)) (1..n)
      (\i. poly_sub m (poly_var m one) (poly_const m ((a:num->C) i))) =
    poly_pow m (poly_sub m (poly_var m one) (poly_const m b)) n")
    (fun th => SUBST_ALL_TAC th THEN ASSUME_TAC th) THENL
     [TRANS_TAC EQ_TRANS
       (← q r"ring_product (poly_ring m (:1)) (1..n)
        (\i. poly_sub m (poly_var m one) (poly_const m (b:C)))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC RING_PRODUCT_EQ THEN REWRITE_TAC [IN_NUMSEG] THEN
        REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN AP_TERM_TAC THEN
        AP_TERM_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
        MP_TAC (← ISPECL [← q r"poly_ring (m:C ring) (:1)",
                          ← q r"poly_sub m (poly_var m one) (poly_const m (b:C))",
                          ← q r"1..n"] RING_PRODUCT_CONST) THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, CARD_NUMSEG_1, POLY_X_MINUS_A_IN_CARRIER,
                      POLY_RING_CLAUSES]],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"P = poly_pow m (poly_sub m (poly_var m one) (poly_const m b))
                    n:(1->num)->C") THEN
    SUBGOAL_THEN (← q r"ring_polynomial m (P:(1->num)->C) /\ monic m P /\
                poly_deg m P = n")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "P" THEN
      SUBGOAL_THEN
       (← q r"ring_polynomial m (poly_sub m (poly_var m one) (poly_const m (b:C)))")
      ASSUME_TAC THENL [ASM_SIMP_TAC [RING_POLYNOMIAL_X_MINUS_A], ALL_TAC] THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_POW, MONIC_POLY_POW, MONIC_X_MINUS_A,
                    POLY_DEG_POW, POLY_DEG_X_MINUS_A, MULT_CLAUSES],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"c:C = ring_1 m") SUBST_ALL_TAC THENL
     [UNDISCH_TAC (← q r"monic m (q:(1->num)->C)") THEN
      ASM_REWRITE_TAC [monic] THEN
      ASM_SIMP_TAC [COEFF_POLY_LMUL, RING_POLYNOMIAL_IMP_POWERSERIES] THEN
      UNDISCH_TAC (← q r"monic m (P:(1->num)->C)") THEN ASM_REWRITE_TAC [monic] THEN
      ASM_SIMP_TAC [RING_MUL_RID],
      ASM_SIMP_TAC [POLY_CONST_1, POLY_MUL_LID,
                    RING_POLYNOMIAL_IMP_POWERSERIES]])

  let SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC ← prove
   r"!(h:A->B) k l x.
        field_extension (k,l) h /\ algebraic_over (k,l) h x
        ==> subring_generated l (x INSERT IMAGE h (ring_carrier k)) =
            subfield_generated l (x INSERT IMAGE h (ring_carrier k)) /\
            finite_extension
             (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k))) h /\
            x IN ring_carrier
             (subfield_generated l (x INSERT IMAGE h (ring_carrier k))) /\
            minimal_polynomial
             (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k))) h x =
            minimal_polynomial (k,l) h x /\
            extension_degree
             (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k))) h =
            poly_deg k (minimal_polynomial (k,l) h x)"
   (← do
    let t1 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC t1 THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SUBRING_EQ_SUBFIELD_GENERATED,
                     FIELD_SIMPLE_ALGEBRAIC_EXTENSION],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_OVER_IN_CARRIER) THEN
    ASM_SIMP_TAC [FINITE_SIMPLE_ALGEBRAIC_EXTENSION, EXTENSION_DEGREE_SIMPLE,
                  SUBRING_GENERATED_INC_GEN, IN_INSERT] THEN
    MATCH_MP_TAC MINIMAL_POLYNOMIAL_SUBRING_GENERATED THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM, IN_INSERT] THEN SET_TAC []))

  /- For z algebraic over the prime subfield, the ring generated by z and   -/
  /- the prime subfield is a field (SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC),   -/
  /- the field generated by z and 0.                                        -/
  let SUBFIELD_GENERATED_SING_ALGEBRAIC ← prove
   r"!(k:A ring) z.
        field k /\ algebraic_over (subfield_generated k {ring_0 k},k) I z
        ==> subfield_generated k {z} =
            subring_generated k
              (z INSERT
               IMAGE I (ring_carrier(subfield_generated k {ring_0 k})))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"I:A->A"), (← q r"subfield_generated k {ring_0 k:A}"), (← q r"k:A ring"),
                      (← q r"z:A")] SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC) THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED] THEN
    DISCH_THEN (SUBST1_TAC o CONJUNCT1) THEN
    REWRITE_TAC [IMAGE_I, SUBFIELD_GENERATED_INSERT] THEN
    MATCH_MP_TAC SUBFIELDS_GENERATED_EQ THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP IN_SUBFIELD_0) THEN SET_TAC [])

  /- A finite extension is generated by x exactly when the minimal          -/
  /- polynomial of x has degree [l:k].                                      -/
  let FINITE_EXTENSION_SIMPLE_EQ ← prove
   r"!(h:A->B) k l x.
        finite_extension (k,l) h /\ x IN ring_carrier l
        ==> (subring_generated l (x INSERT IMAGE h (ring_carrier k)) = l <=>
             poly_deg k (minimal_polynomial (k,l) h x) =
             extension_degree (k,l) h)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN (← q r"algebraic_over (k,l) (h:A->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION, algebraic_extension],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [(← q r"h:A->B"), (← q r"k:A ring"), (← q r"l:B ring"), (← q r"x:B")]
      EXTENSION_DEGREE_SIMPLE) THEN
    MP_TAC (← ISPECL [(← q r"h:A->B"), (← q r"I:B->B"), (← q r"k:A ring"),
       (← q r"subfield_generated l (x INSERT IMAGE (h:A->B) (ring_carrier k))"),
       (← q r"l:B ring")] EXTENSION_DEGREE_EQ_TOWER) THEN
    ASM_SIMP_TAC [SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC, SUBFIELD_GENERATED_EQ,
                  FIELD_EXTENSION_SUBFIELD_GENERATED, I_O_ID, IMAGE_I] THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [],
      MESON_TAC []])

  let RING_HOMOMORPHISM_EXTENSIONS_SIMPLE_EQ ← prove
   r"!(h:A->B) (g:A->C) k l m x s t.
        field l /\
        s IN ring_homomorphism_extensions
              (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)),m)
              (h,g) /\
        t IN ring_homomorphism_extensions
              (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)),m)
              (h,g)
        ==> (s = t <=> s x = t x)"
   (REPEAT GEN_TAC THEN
    ABBREV_TAC (← q r"X = (x:B) INSERT IMAGE (h:A->B) (ring_carrier k)") THEN
    REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN STRIP_TAC THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC EXTENSIONAL_EQ THEN
    EXISTS_TAC (← q r"ring_carrier(subfield_generated l (X:B->bool))") THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"s:B->C", ← q r"t:B->C", ← q r"subfield_generated l (X:B->bool)",
                      ← q r"m:C ring", ← q r"X:B->bool"]
      RING_HOMOMORPHISMS_EQ_FROM_SUBFIELD_GENERATED) THEN
    ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED, SUBFIELD_GENERATED_IDEMPOT] THEN
    DISCH_THEN MATCH_MP_TAC THEN EXPAND_TAC "X" THEN
    REWRITE_TAC [IN_INSERT, IN_IMAGE] THEN ASM_MESON_TAC [])

  let (RING_HOMOMORPHISM_EXTENSIONS_TOWER_PRODUCT,
       RING_HOMOMORPHISM_EXTENSIONS_TOWER_SUM) ← CONJ_PAIR (← prove
   r"(!(f:A->B) (g:B->C) (j:A->D) k l m n (r:E ring) u.
        finite_extension(k,l) f /\ finite_extension(l,m) g /\
        integral_domain n /\ ring_homomorphism(k,n) j
        ==> ring_product r (ring_homomorphism_extensions (k,m,n) (g o f,j)) u =
            ring_product r (ring_homomorphism_extensions (k,l,n) (f,j))
             (\t. ring_product r (ring_homomorphism_extensions (l,m,n) (g,t))
                    u)) /\
   (!(f:A->B) (g:B->C) (j:A->D) k l m n (r:E ring) u.
        finite_extension(k,l) f /\ finite_extension(l,m) g /\
        integral_domain n /\ ring_homomorphism(k,n) j
        ==> ring_sum r (ring_homomorphism_extensions (k,m,n) (g o f,j)) u =
            ring_sum r (ring_homomorphism_extensions (k,l,n) (f,j))
             (\t. ring_sum r (ring_homomorphism_extensions (l,m,n) (g,t))
                    u))"
   (CONJ_TAC THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"j:A->D", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:C ring", ← q r"n:D ring"]
      RING_HOMOMORPHISM_EXTENSIONS_TOWER) THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM,
                  FINITE_IMP_FIELD_EXTENSION] THEN
    DISCH_THEN (CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC) THEN
    (MATCH_MP_TAC RING_PRODUCT_UNIONS_PAIRWISE_DISJOINT ORELSE
     MATCH_MP_TAC RING_SUM_UNIONS_PAIRWISE_DISJOINT) THEN
    ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [CARD_RING_HOMOMORPHISM_EXTENSIONS_LE] THEN
    REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM ring_homomorphism_extensions] THEN
    ASM_SIMP_TAC [CARD_RING_HOMOMORPHISM_EXTENSIONS_LE]))

  -- @@RETURN BEGIN
  return { ALGEBRAICALLY_CLOSED_FIELD_SINGLE_ROOT, SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC,
           SUBFIELD_GENERATED_SING_ALGEBRAIC, FINITE_EXTENSION_SIMPLE_EQ,
           RING_HOMOMORPHISM_EXTENSIONS_SIMPLE_EQ,
           RING_HOMOMORPHISM_EXTENSIONS_TOWER_PRODUCT,
           RING_HOMOMORPHISM_EXTENSIONS_TOWER_SUM }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Each (X - t x)^[k(x):k]_i divides g o p, p the minimal polynomial of x.   -/
/- (fieldtheory.ml 14472-14667)                                              -/
/- ------------------------------------------------------------------------- -/

structure EmbeddingDivides where
  -- @@FIELDS
  MINIMAL_POLYNOMIAL_EMBEDDING_DIVIDES : thm
  deriving Inhabited

@[nospecialize]
def setupEmbeddingDivides [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated : SubfieldGenerated) (BSubfieldGenerated1 : SubfieldGenerated1) (BSubfieldGenerated2 : SubfieldGenerated2) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BMinimalPolynomial : MinimalPolynomial) (BAcfBasic : AcfBasic) (BHomExtensions : HomExtensions) (BSeparableDegree : SeparableDegree) (BSeparableClosure : SeparableClosure) (BPurelyInseparable : PurelyInseparable) (BPurelyInseparableDegree : PurelyInseparableDegree) (BInseparableDegree : InseparableDegree) (BEmbeddingsPrelims : EmbeddingsPrelims) :
    ExceptT String IO EmbeddingDivides := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { EQ_IMP, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FUN_EQ_THM, IMAGE_I, .. } := D.core2
  let { IN_ELIM_THM, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, IN_SING, I_O_ID, I_THM,
        LE_REFL, .. } := D.core3
  let { POLY_DEG_MONOMORPHIC_IMAGE, POLY_EQ_0_MONOMORPHIC_IMAGE, .. } := D.core4
  let { POLY_EXTEND_EVALUATE, POLY_RING_CLAUSES, POLY_ROOT_BOUND, .. } := D.core5
  let { RING_DIVIDES_HOMOMORPHIC_IMAGE, RING_HOMOMORPHISM_1,
        RING_HOMOMORPHISM_POLY_RINGS, .. } := D.core6
  let { RING_POLYNOMIAL, .. } := D.core7
  let { SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_TRANS, .. } := D.core8
  let { o_THM, ring_polynomial, ring_powerseries, .. } := D.core9
  let { CARD_LE_1, COEFF_COMPOSE, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { monic, .. } := D.core11
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, RING_CARRIER_SUBFIELD_GENERATED_SUBSET,
        SUBFIELD_GENERATED_EQ, SUBFIELD_GENERATED_MONO, .. } := BSubfieldGenerated
  let { SUBFIELD_GENERATED_IDEMPOT, .. } := BSubfieldGenerated1
  let { RING_HOMOMORPHISM_FROM_SUBFIELD_GENERATED, .. } := BSubfieldGenerated2
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_INTO_SUBFIELD_GENERATED,
        FIELD_EXTENSION_SUBFIELD_GENERATED, field_extension, .. } := BFieldExtension
  let { FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { EXTENSION_DEGREE_SIMPLE, MINIMAL_POLYNOMIAL, MINIMAL_POLYNOMIAL_DIVIDES,
        MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_VANISHES, .. } := BMinimalPolynomial
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { RING_HOMOMORPHISM_EXTENSIONS_ROOT, ring_homomorphism_extensions, .. } := BHomExtensions
  let { SEPARABLE_DEGREE_SIMPLE, .. } := BSeparableDegree
  let { SUBFIELD_OF_SEPARABLE_CLOSURE, .. } := BSeparableClosure
  let { PURELY_INSEPARABLE_IMP_ALGEBRAIC_EXTENSION,
        PURELY_INSEPARABLE_OVER_SEPARABLE_CLOSURE, .. } := BPurelyInseparable
  let { SEPARABLE_DEGREE_EQ_1, .. } := BPurelyInseparableDegree
  let { inseparable_degree, .. } := BInseparableDegree
  let { ALGEBRAICALLY_CLOSED_FIELD_SINGLE_ROOT, SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC, .. } := BEmbeddingsPrelims
  -- @@SCOPE END

  let MINIMAL_POLYNOMIAL_EMBEDDING_DIVIDES ← prove
   r"!(h:A->B) (g:A->C) k l m x t.
        field_extension(k,l) h /\ algebraic_over(k,l) h x /\
        algebraically_closed_field m /\
        t IN ring_homomorphism_extensions
              (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)),m)
              (h,g)
        ==> ring_divides (poly_ring m (:1))
             (poly_pow m (poly_sub m (poly_var m one) (poly_const m (t x)))
                (inseparable_degree
                  (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)))
                  h))
             (g o minimal_polynomial(k,l) h x)"
   (← do
    let t1 ← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC
     (← q r"K = subfield_generated l
          ((x:B) INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    ABBREV_TAC (← q r"p = minimal_polynomial (k,l) (h:A->B) x") THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_ALGEBRAIC_EXTENSION) THEN
    SUBGOAL_THEN (← q r"field(K:B ring) /\ algebraic_over (k,K) (h:A->B) x")
    STRIP_ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"algebraic_extension (k,K) (h:A->B)") THEN
      REWRITE_TAC [algebraic_extension, field_extension] THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    UNDISCH_TAC
     (← q r"(t:B->C) IN ring_homomorphism_extensions (k,K,m) (h:A->B,g:A->C)") THEN
    REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"K:B ring"]
      SUBFIELD_OF_SEPARABLE_CLOSURE) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    REWRITE_TAC [inseparable_degree] THEN
    ABBREV_TAC (← q r"S = subfield_generated K (separable_closure (k,K) (h:A->B))") THEN
    SUBGOAL_THEN (← q r"ring_carrier S = separable_closure (k,K) (h:A->B)")
    ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field_extension(S,K) (I:B->B) /\ field_extension(k,S) (h:A->B)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN CONJ_TAC THENL
       [ASM_REWRITE_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED],
        MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"purely_inseparable_extension(S,K) (I:B->B)") ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN
      MATCH_MP_TAC PURELY_INSEPARABLE_OVER_SEPARABLE_CLOSURE THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o
      MATCH_MP PURELY_INSEPARABLE_IMP_ALGEBRAIC_EXTENSION) THEN
    SUBGOAL_THEN (← q r"separable_degree(S,K) (I:B->B) = 1") ASSUME_TAC THENL
     [ASM_MESON_TAC [SEPARABLE_DEGREE_EQ_1], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_over(S,K) (I:B->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"subring_generated K ((x:B) INSERT IMAGE (I:B->B) (ring_carrier S)) = K")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"I:B->B", ← q r"S:B ring", ← q r"K:B ring", ← q r"x:B"]
        SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o CONJUNCT1) THEN
      REWRITE_TAC [SUBFIELD_GENERATED_EQ, ← GSYM SUBSET_ANTISYM_EQ] THEN
      REWRITE_TAC [RING_CARRIER_SUBFIELD_GENERATED_SUBSET] THEN
      TRANS_TAC SUBSET_TRANS
       (← q r"ring_carrier(subfield_generated K
        ((x:B) INSERT IMAGE (h:A->B) (ring_carrier k)))") THEN
      CONJ_TAC THENL
       [SUBST1_TAC (← SYM (← ASSUME (← q r"subfield_generated l
             ((x:B) INSERT IMAGE (h:A->B) (ring_carrier k)) = K"))) THEN
        REWRITE_TAC [SUBFIELD_GENERATED_IDEMPOT, SUBSET_REFL],
        MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN REWRITE_TAC [IMAGE_I] THEN
        ASM SET_TAC []],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"mu = minimal_polynomial(S,K) (I:B->B) x") THEN
    SUBGOAL_THEN (← q r"extension_degree(S,K) (I:B->B) = poly_deg S (mu:(1->num)->B)")
    SUBST1_TAC THENL
     [MP_TAC (← ISPECL [← q r"I:B->B", ← q r"S:B ring", ← q r"K:B ring", ← q r"x:B"]
        EXTENSION_DEGREE_SIMPLE) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(S,m) (t:B->C)") ASSUME_TAC THENL
     [EXPAND_TAC "S" THEN
      MATCH_MP_TAC RING_HOMOMORPHISM_FROM_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_monomorphism(S,m) (t:B->C)") ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_MESON_TAC [field_extension, FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"t:B->C", ← q r"S:B ring", ← q r"K:B ring", ← q r"m:C ring",
                      ← q r"x:B"] SEPARABLE_DEGREE_SIMPLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"t:B->C", ← q r"t:B->C", ← q r"S:B ring", ← q r"K:B ring",
                      ← q r"m:C ring", ← q r"x:B"] RING_HOMOMORPHISM_EXTENSIONS_ROOT) THEN
    ASM_REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM, I_THM] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"S:B ring", ← q r"K:B ring", ← q r"x:B"]
      MINIMAL_POLYNOMIAL) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"ring_polynomial S (mu:(1->num)->B)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [RING_POLYNOMIAL], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(t:B->C) x IN ring_carrier m") ASSUME_TAC THENL
     [MATCH_MP_TAC (← ISPECL [← q r"K:B ring", ← q r"m:C ring", ← q r"t:B->C"]
        RING_HOMOMORPHISM_IN_CARRIER) THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(t:B->C) o mu IN ring_carrier(poly_ring m (:1)) /\
    poly_deg m ((t:B->C) o mu) = poly_deg S (mu:(1->num)->B) /\
    ~((t:B->C) o mu = poly_0 m) /\ monic m ((t:B->C) o mu)")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"S:B ring", ← q r"m:C ring", ← q r"t:B->C", ← q r"mu:(1->num)->B"]
        POLY_DEG_MONOMORPHIC_IMAGE) THEN
      MP_TAC (← ISPECL [← q r"S:B ring", ← q r"m:C ring", ← q r"t:B->C", ← q r"mu:(1->num)->B"]
        POLY_EQ_0_MONOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
        EXISTS_TAC (← q r"S:B ring") THEN ASM_REWRITE_TAC [],
        UNDISCH_TAC (← q r"monic S (mu:(1->num)->B)") THEN
        ASM_REWRITE_TAC [monic, COEFF_COMPOSE] THEN
        DISCH_THEN SUBST1_TAC THEN
        MATCH_MP_TAC (← ISPECL [← q r"S:B ring", ← q r"m:C ring", ← q r"t:B->C"]
          RING_HOMOMORPHISM_1) THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!y. y IN ring_carrier m /\ poly_eval m ((t:B->C) o mu) y = ring_0 m
        ==> y = t x")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"m:C ring", ← q r"(t:B->C) o (mu:(1->num)->B)"]
        POLY_ROOT_BOUND) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, POLY_RING_CLAUSES] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"{b | b IN ring_carrier m /\
                       poly_eval m ((t:B->C) o (mu:(1->num)->B)) b =
                       ring_0 m}") CARD_LE_1) THEN
      ASM_REWRITE_TAC [LE_REFL] THEN
      UNDISCH_TAC (← q r"poly_eval m ((t:B->C) o mu) (t x) = ring_0 m") THEN
      UNDISCH_TAC (← q r"(t:B->C) x IN ring_carrier m") THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_SING] THEN MESON_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"m:C ring", ← q r"(t:B->C) o (mu:(1->num)->B)", ← q r"(t:B->C) x"]
      ALGEBRAICALLY_CLOSED_FIELD_SINGLE_ROOT) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ASM_REWRITE_TAC []] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    SUBGOAL_THEN (← q r"(p:(1->num)->A) IN ring_carrier(poly_ring k (:1)) /\
                (h:A->B) o p IN ring_carrier(poly_ring S (:1))")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC t1 THEN CONJ_TAC THENL
       [SUBST1_TAC (← SYM (← ASSUME (← q r"minimal_polynomial (k,l) (h:A->B) x = p"))) THEN
        MATCH_MP_TAC MINIMAL_POLYNOMIAL_IN_CARRIER THEN ASM_REWRITE_TAC [],
        DISCH_TAC THEN MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
        EXISTS_TAC (← q r"k:A ring") THEN
        ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_divides (poly_ring S (:1)) mu ((h:A->B) o (p:(1->num)->A))")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"I:B->B", ← q r"S:B ring", ← q r"K:B ring", ← q r"x:B",
                        ← q r"(h:A->B) o (p:(1->num)->A)"]
        MINIMAL_POLYNOMIAL_DIVIDES) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"x:B"]
        MINIMAL_POLYNOMIAL_VANISHES) THEN
      ASM_SIMP_TAC [POLY_EXTEND_EVALUATE, FIELD_EXTENSION_IMP_HOMOMORPHISM] THEN
      REWRITE_TAC [I_O_ID],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_divides (poly_ring m (:1))
      ((\q:(1->num)->B. (t:B->C) o q) mu)
      ((\q:(1->num)->B. (t:B->C) o q) ((h:A->B) o (p:(1->num)->A)))")
    MP_TAC THENL
     [MATCH_MP_TAC RING_DIVIDES_HOMOMORPHIC_IMAGE THEN
      EXISTS_TAC (← q r"poly_ring (S:B ring) (:1)") THEN
      ASM_SIMP_TAC [RING_HOMOMORPHISM_POLY_RINGS],
      ALL_TAC] THEN
    REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, o_THM] THEN X_GEN_TAC (← q r"i:1->num") THEN
    MATCH_MP_TAC (← ASSUME
     (← q r"!y. y IN ring_carrier k ==> (t:B->C) ((h:A->B) y) = (g:A->C) y")) THEN
    UNDISCH_TAC (← q r"(p:(1->num)->A) IN ring_carrier(poly_ring k (:1))") THEN
    REWRITE_TAC [POLY_RING_CLAUSES, IN_ELIM_THM, ring_polynomial,
                 ring_powerseries] THEN
    SIMP_TAC []))

  -- @@RETURN BEGIN
  return { MINIMAL_POLYNOMIAL_EMBEDDING_DIVIDES }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The minimal polynomial over an algebraically closed field, by the         -/
/- extensions to k(x), with multiplicity the inseparable degree.             -/
/- (fieldtheory.ml 14669-14823)                                              -/
/- ------------------------------------------------------------------------- -/

structure MinpolyEmbeddings where
  -- @@FIELDS
  MINIMAL_POLYNOMIAL_EMBEDDINGS : thm
  deriving Inhabited

@[nospecialize]
def setupMinpolyEmbeddings [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BMinimalPolynomial : MinimalPolynomial) (BAcfBasic : AcfBasic) (BHomExtensions : HomExtensions) (BSeparableDegree : SeparableDegree) (BInseparableDegree : InseparableDegree) (BEmbeddingsPrelims : EmbeddingsPrelims) (BEmbeddingDivides : EmbeddingDivides) :
    ExceptT String IO MinpolyEmbeddings := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, .. } := D
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, HAS_SIZE, .. } := D.core2
  let { INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, IN_ELIM_THM,
        IN_RING_POLYNOMIAL_CARRIER_COMPOSE, LE_REFL, .. } := D.core3
  let { PID_IMP_UFD, PID_POLY_RING, POLY_DEG_MONOMORPHIC_IMAGE, POLY_DEG_X_MINUS_A, .. } := D.core4
  let { POLY_RING_CLAUSES, POLY_X_MINUS_A_IN_CARRIER, .. } := D.core5
  let { RING_HOMOMORPHISM_1, .. } := D.core6
  let { RING_POLYNOMIAL, RING_POW, RING_PRODUCT, .. } := D.core7
  let { COEFF_COMPOSE, COEFF_POLY_CONST, COEFF_POLY_SUB, COEFF_POLY_VAR,
        MONIC_DIVIDES_EQ, MONIC_POLY_POW, MONIC_POLY_PRODUCT, MONIC_X_MINUS_A,
        MULT_CLAUSES, NSUM_CONST, POLY_DEG_POW, POLY_DEG_PRODUCT_MONIC,
        RING_COPRIME_DISTINCT_MONIC_IRREDUCIBLES, RING_COPRIME_LPOW,
        RING_COPRIME_PRODUCT_DIVIDES, RING_COPRIME_RPOW, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { ARITH, RING_IRREDUCIBLE_X_MINUS_A, RING_NEG_EQ, RING_POLYNOMIAL_POW,
        RING_POLYNOMIAL_X_MINUS_A, RING_SUB_LZERO, monic, pairwise, .. } := D.core11
  let { field_extension, .. } := BFieldExtension
  let { MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_MONIC, .. } := BMinimalPolynomial
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ring_homomorphism_extensions, .. } := BHomExtensions
  let { HAS_SIZE_SEPARABLE_DEGREE, .. } := BSeparableDegree
  let { EXTENSION_DEGREE_SEPARABLE_INSEPARABLE, .. } := BInseparableDegree
  let { RING_HOMOMORPHISM_EXTENSIONS_SIMPLE_EQ, SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC, .. } := BEmbeddingsPrelims
  let { MINIMAL_POLYNOMIAL_EMBEDDING_DIVIDES, .. } := BEmbeddingDivides
  -- @@SCOPE END

  let MINIMAL_POLYNOMIAL_EMBEDDINGS ← prove
   r"!(h:A->B) (g:A->C) k l m x.
        field_extension(k,l) h /\ algebraic_over(k,l) h x /\
        algebraically_closed_field m /\ ring_homomorphism(k,m) g
        ==> g o minimal_polynomial(k,l) h x =
            ring_product (poly_ring m (:1))
             (ring_homomorphism_extensions
               (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)),m)
               (h,g))
             (\s. poly_pow m (poly_sub m (poly_var m one) (poly_const m (s x)))
                   (inseparable_degree
                     (k,subfield_generated l
                          (x INSERT IMAGE h (ring_carrier k)))
                     h))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"x:B"] MINIMAL_POLYNOMIAL_EMBEDDING_DIVIDES) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"x:B"] RING_HOMOMORPHISM_EXTENSIONS_SIMPLE_EQ) THEN
    MP_TAC (← SPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC
     (← q r"K = subfield_generated l
          ((x:B) INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    ABBREV_TAC (← q r"p = minimal_polynomial (k,l) (h:A->B) x") THEN
    ABBREV_TAC (← q r"E = ring_homomorphism_extensions (k,K,m) (h:A->B,g:A->C)") THEN
    ABBREV_TAC (← q r"e = inseparable_degree (k,K) (h:A->B)") THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"field(l:B ring)") (fun th => REWRITE_TAC [th]) THENL
     [ASM_MESON_TAC [field_extension], DISCH_TAC THEN DISCH_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"K:B ring", ← q r"m:C ring"]
      HAS_SIZE_SEPARABLE_DEGREE) THEN
    ASM_REWRITE_TAC [HAS_SIZE] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"K:B ring"]
      EXTENSION_DEGREE_SEPARABLE_INSEPARABLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"!s:B->C. s IN E ==> s x IN ring_carrier m") ASSUME_TAC THENL
     [EXPAND_TAC "E" THEN
      REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
      ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!s:B->C. s IN E
      ==> ring_polynomial m
           (poly_pow m (poly_sub m (poly_var m one) (poly_const m (s x))) e) /\
          monic m
           (poly_pow m (poly_sub m (poly_var m one) (poly_const m (s x))) e) /\
          poly_deg m
           (poly_pow m (poly_sub m (poly_var m one) (poly_const m (s x))) e) =
          e")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"s:B->C") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(s:B->C) x IN ring_carrier m") ASSUME_TAC THENL
       [ASM_SIMP_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"ring_polynomial m
        (poly_sub m (poly_var m one) (poly_const m ((s:B->C) x)))")
      ASSUME_TAC THENL [ASM_SIMP_TAC [RING_POLYNOMIAL_X_MINUS_A], ALL_TAC] THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_POW, MONIC_POLY_POW, MONIC_X_MINUS_A,
                    POLY_DEG_POW, POLY_DEG_X_MINUS_A, MULT_CLAUSES,
                    INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_polynomial m (ring_product (poly_ring m (:1)) E
         (\s:B->C. poly_pow m (poly_sub m (poly_var m one)
                                 (poly_const m (s x))) e)) /\
    monic m (ring_product (poly_ring m (:1)) E
         (\s:B->C. poly_pow m (poly_sub m (poly_var m one)
                                 (poly_const m (s x))) e)) /\
    poly_deg m (ring_product (poly_ring m (:1)) E
         (\s:B->C. poly_pow m (poly_sub m (poly_var m one)
                                 (poly_const m (s x))) e)) =
    poly_deg k (p:(1->num)->A)")
    MP_TAC THENL
     [ASM_SIMP_TAC [MONIC_POLY_PRODUCT, POLY_DEG_PRODUCT_MONIC] THEN
      REWRITE_TAC [RING_POLYNOMIAL, RING_PRODUCT] THEN
      ASM_SIMP_TAC [NSUM_CONST] THEN ARITH_TAC,
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"P = ring_product (poly_ring m (:1)) E
         (\s:B->C. poly_pow m (poly_sub m (poly_var m one)
                                 (poly_const m (s x))) e)") THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(p:(1->num)->A) IN ring_carrier(poly_ring k (:1)) /\
                monic k p")
    STRIP_ASSUME_TAC THENL
     [SUBST1_TAC (← SYM (← ASSUME (← q r"minimal_polynomial (k,l) (h:A->B) x = p"))) THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_MONIC],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_monomorphism(k,m) (g:A->C)") ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_MESON_TAC [field_extension, FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(g:A->C) o p IN ring_carrier(poly_ring m (:1)) /\
    poly_deg m ((g:A->C) o p) = poly_deg k (p:(1->num)->A) /\
    monic m ((g:A->C) o p)")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"m:C ring", ← q r"g:A->C", ← q r"p:(1->num)->A"]
        POLY_DEG_MONOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [RING_POLYNOMIAL] THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
        EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
        UNDISCH_TAC (← q r"monic k (p:(1->num)->A)") THEN
        ASM_REWRITE_TAC [monic, COEFF_COMPOSE] THEN
        DISCH_THEN SUBST1_TAC THEN
        MATCH_MP_TAC (← ISPECL [← q r"k:A ring", ← q r"m:C ring", ← q r"g:A->C"]
          RING_HOMOMORPHISM_1) THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"UFD(poly_ring (m:C ring) (:1))") ASSUME_TAC THENL
     [ASM_SIMP_TAC [PID_IMP_UFD, PID_POLY_RING], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!s t:B->C.
      s IN E /\ t IN E /\ ~(s = t)
      ==> ring_coprime (poly_ring m (:1))
           (poly_pow m (poly_sub m (poly_var m one) (poly_const m (s x))) e,
            poly_pow m (poly_sub m (poly_var m one) (poly_const m (t x))) e)")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"s:B->C", ← q r"t:B->C"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"~((s:B->C) x = t x)") ASSUME_TAC THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(s:B->C) x IN ring_carrier m /\ (t:B->C) x IN ring_carrier m")
      STRIP_ASSUME_TAC THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"poly_pow (m:C ring) = ring_pow (poly_ring m (:1))")
      SUBST1_TAC THENL [REWRITE_TAC [POLY_RING_CLAUSES], ALL_TAC] THEN
      MATCH_MP_TAC RING_COPRIME_LPOW THEN
      ASM_SIMP_TAC [POLY_X_MINUS_A_IN_CARRIER, RING_POW] THEN
      MATCH_MP_TAC RING_COPRIME_RPOW THEN
      ASM_SIMP_TAC [POLY_X_MINUS_A_IN_CARRIER] THEN
      MATCH_MP_TAC RING_COPRIME_DISTINCT_MONIC_IRREDUCIBLES THEN
      ASM_SIMP_TAC [MONIC_X_MINUS_A, RING_IRREDUCIBLE_X_MINUS_A] THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"coeff 0:((1->num)->C)->C")) THEN
      REWRITE_TAC [COEFF_POLY_SUB, COEFF_POLY_VAR, COEFF_POLY_CONST, ARITH] THEN
      ASM_SIMP_TAC [RING_SUB_LZERO, RING_NEG_EQ],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_divides (poly_ring m (:1)) P ((g:A->C) o p)")
    ASSUME_TAC THENL
     [EXPAND_TAC "P" THEN
      wPart (fun t => pure t) (fun t => do lhand (← rand t)) RING_COPRIME_PRODUCT_DIVIDES THEN
      ANTS_TAC THENL
       [REPEAT CONJ_TAC THENL
         [DISJ1_TAC THEN FIRST_ASSUM ACCEPT_TAC,
          FIRST_ASSUM ACCEPT_TAC,
          FIRST_ASSUM ACCEPT_TAC,
          REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN ASM_SIMP_TAC [],
          REWRITE_TAC [pairwise] THEN ASM_SIMP_TAC []],
        DISCH_THEN SUBST1_TAC THEN ASM_SIMP_TAC []],
      ALL_TAC] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC MONIC_DIVIDES_EQ THEN
    EXISTS_TAC (← q r"m:C ring") THEN ASM_REWRITE_TAC [LE_REFL])

  -- @@RETURN BEGIN
  return { MINIMAL_POLYNOMIAL_EMBEDDINGS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The constant and subleading coefficients of the minimal polynomial by the -/
/- extensions to k(x).                                                       -/
/- (fieldtheory.ml 14825-14990)                                              -/
/- ------------------------------------------------------------------------- -/

structure MinpolyCoeffEmbeddings where
  -- @@FIELDS
  MINIMAL_POLYNOMIAL_COEFF_EMBEDDINGS : thm
  deriving Inhabited

@[nospecialize]
def setupMinpolyCoeffEmbeddings [HolBase] (D : FieldTheoryDeps) (BFiniteExtension : FiniteExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BMinimalPolynomial : MinimalPolynomial) (BAcfBasic : AcfBasic) (BHomExtensions : HomExtensions) (BSeparableDegree : SeparableDegree) (BInseparableDegree : InseparableDegree) (BEmbeddingsPrelims : EmbeddingsPrelims) (BMinpolyEmbeddings : MinpolyEmbeddings) :
    ExceptT String IO MinpolyCoeffEmbeddings := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, .. } := D
  let { FIELD_IMP_INTEGRAL_DOMAIN, HAS_SIZE, .. } := D.core2
  let { INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, IN_ELIM_THM, .. } := D.core3
  let { POLY_DEG_X_MINUS_A, .. } := D.core4
  let { POLY_RING_CLAUSES, POLY_X_MINUS_A_IN_CARRIER, RING_1, .. } := D.core5
  let { RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_NEG, RING_MUL, .. } := D.core6
  let { RING_NEG, RING_POLYNOMIAL, RING_POLYNOMIAL_IMP_POWERSERIES, RING_POW,
        RING_PRODUCT_EQ, RING_SUM, RING_SUM_EQ, RING_SUM_LMUL, .. } := D.core7
  let { o_THM, .. } := D.core9
  let { COEFF_COMPOSE, COEFF_IN_CARRIER, COEFF_POLY_CONST,
        COEFF_POLY_POW_X_MINUS_A_SUBLEADING, COEFF_POLY_SUB, COEFF_POLY_VAR,
        COEFF_RING_PRODUCT_MONIC_SUBLEADING, EQ_TRANS, MONIC_POLY_POW, MONIC_X_MINUS_A,
        MULT_CLAUSES, MULT_SYM, NSUM_CONST, POLY_DEG_POW,
        POLY_RING_HOMOMORPHISM_COEFF_0, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { ARITH, RING_HOMOMORPHISM_POW, RING_HOMOMORPHISM_PRODUCT, RING_NEG_NEG,
        RING_OF_NUM, RING_POLYNOMIAL_POW, RING_POLYNOMIAL_X_MINUS_A,
        RING_PRODUCT_POW_NEG, RING_SUB_LZERO, RING_SUM_NEG, .. } := D.core11
  let { EXTENSION_DEGREE_EQ_0, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { MINIMAL_POLYNOMIAL_IN_CARRIER, .. } := BMinimalPolynomial
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY, ring_homomorphism_extensions, .. } := BHomExtensions
  let { HAS_SIZE_SEPARABLE_DEGREE, .. } := BSeparableDegree
  let { EXTENSION_DEGREE_SEPARABLE_INSEPARABLE, .. } := BInseparableDegree
  let { SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC, .. } := BEmbeddingsPrelims
  let { MINIMAL_POLYNOMIAL_EMBEDDINGS, .. } := BMinpolyEmbeddings
  -- @@SCOPE END

  let MINIMAL_POLYNOMIAL_COEFF_EMBEDDINGS ← prove
   r"!(h:A->B) (g:A->C) k l m x.
        field_extension(k,l) h /\ algebraic_over(k,l) h x /\
        algebraically_closed_field m /\ ring_homomorphism(k,m) g
        ==> g(ring_mul k
               (ring_pow k (ring_neg k (ring_1 k))
                  (poly_deg k (minimal_polynomial(k,l) h x)))
               (coeff 0 (minimal_polynomial(k,l) h x))) =
            ring_pow m
             (ring_product m
               (ring_homomorphism_extensions
                 (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)),m)
                 (h,g))
               (\s. s x))
             (inseparable_degree
               (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)))
               h) /\
            g(ring_neg k
               (coeff (poly_deg k (minimal_polynomial(k,l) h x) - 1)
                      (minimal_polynomial(k,l) h x))) =
            ring_mul m
             (ring_of_num m
               (inseparable_degree
                 (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)))
                 h))
             (ring_sum m
               (ring_homomorphism_extensions
                 (k,subfield_generated l (x INSERT IMAGE h (ring_carrier k)),m)
                 (h,g))
               (\s. s x))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"x:B"] MINIMAL_POLYNOMIAL_EMBEDDINGS) THEN
    MP_TAC (← SPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC
     (← q r"K = subfield_generated l
          ((x:B) INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    ABBREV_TAC (← q r"p = minimal_polynomial (k,l) (h:A->B) x") THEN
    ABBREV_TAC (← q r"E = ring_homomorphism_extensions (k,K,m) (h:A->B,g:A->C)") THEN
    ABBREV_TAC (← q r"e = inseparable_degree (k,K) (h:A->B)") THEN
    STRIP_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"K:B ring", ← q r"m:C ring"]
      HAS_SIZE_SEPARABLE_DEGREE) THEN
    ASM_REWRITE_TAC [HAS_SIZE] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"K:B ring"]
      EXTENSION_DEGREE_SEPARABLE_INSEPARABLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(E:(B->C)->bool = {}) /\ ~(e = 0)") STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL
       [EXPAND_TAC "E" THEN
        MATCH_MP_TAC RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY THEN
        ASM_SIMP_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION],
        DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"K:B ring"]
          EXTENSION_DEGREE_EQ_0) THEN
        ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION, MULT_CLAUSES]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!s:B->C. s IN E ==> s x IN ring_carrier m") ASSUME_TAC THENL
     [EXPAND_TAC "E" THEN
      REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
      ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(p:(1->num)->A) IN ring_carrier(poly_ring k (:1))")
    ASSUME_TAC THENL
     [SUBST1_TAC (← SYM (← ASSUME (← q r"minimal_polynomial (k,l) (h:A->B) x = p"))) THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!i. coeff i (p:(1->num)->A) IN ring_carrier k")
    ASSUME_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC COEFF_IN_CARRIER THEN
      MATCH_MP_TAC RING_POLYNOMIAL_IMP_POWERSERIES THEN
      ASM_REWRITE_TAC [RING_POLYNOMIAL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!i. (g:A->C)(coeff i (p:(1->num)->A)) =
                    coeff i (ring_product (poly_ring m (:1)) E
                      (\s. poly_pow m (poly_sub m (poly_var m one)
                                         (poly_const m ((s:B->C) x))) e))")
    ASSUME_TAC THENL
     [GEN_TAC THEN
      SUBST1_TAC (← SYM (← ASSUME
       (← q r"(g:A->C) o (p:(1->num)->A) =
      ring_product (poly_ring m (:1)) E
       (\s. poly_pow m (poly_sub m (poly_var m one)
                          (poly_const m ((s:B->C) x))) e)"))) THEN
      REWRITE_TAC [COEFF_COMPOSE],
      ALL_TAC] THEN
    (← do
      let th ← ASSUME (← q r"ring_homomorphism(k,m) (g:A->C)")
      pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL th,
                          ← MATCH_MP RING_HOMOMORPHISM_POW th,
                          ← MATCH_MP RING_HOMOMORPHISM_NEG th,
                          ← MATCH_MP RING_HOMOMORPHISM_1 th,
                          RING_POW, RING_NEG, RING_1])) THEN
    SUBGOAL_THEN
     (← q r"!s:B->C. s IN E
      ==> poly_pow m (poly_sub m (poly_var m one) (poly_const m (s x))) e IN
          ring_carrier(poly_ring m (:1)) /\
          monic m
           (poly_pow m (poly_sub m (poly_var m one) (poly_const m (s x))) e) /\
          poly_deg m
           (poly_pow m (poly_sub m (poly_var m one) (poly_const m (s x))) e) =
          e")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"s:B->C") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(s:B->C) x IN ring_carrier m") ASSUME_TAC THENL
       [ASM_SIMP_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"ring_polynomial m
        (poly_sub m (poly_var m one) (poly_const m ((s:B->C) x)))")
      ASSUME_TAC THENL [ASM_SIMP_TAC [RING_POLYNOMIAL_X_MINUS_A], ALL_TAC] THEN
      ASM_SIMP_TAC [← GSYM RING_POLYNOMIAL, RING_POLYNOMIAL_POW, MONIC_POLY_POW,
                    MONIC_X_MINUS_A, POLY_DEG_POW, POLY_DEG_X_MINUS_A,
                    MULT_CLAUSES],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"separable_degree (k,K) (h:A->B) * e = e * CARD(E:(B->C)->bool)")
    SUBST1_TAC THENL [ASM_REWRITE_TAC [MULT_SYM], ALL_TAC] THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"m:C ring", ← q r"(:1)"] POLY_RING_HOMOMORPHISM_COEFF_0) THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\s:B->C. poly_pow m (poly_sub m (poly_var m one)
                                       (poly_const m (s x))) e",
        ← q r"E:(B->C)->bool"]
       (← MATCH_MP RING_HOMOMORPHISM_PRODUCT (← ASSUME
         (← q r"ring_homomorphism (poly_ring (m:C ring) (:1),m) (coeff 0)")))) THEN
      ASM_SIMP_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      TRANS_TAC EQ_TRANS
       (← q r"ring_mul m
       (ring_pow m (ring_neg m (ring_1 m)) (e * CARD(E:(B->C)->bool)))
       (ring_product m E (\s:B->C. ring_pow m (ring_neg m (s x)) e))") THEN
      CONJ_TAC THENL
       [ASM_REWRITE_TAC [] THEN AP_TERM_TAC THEN
        MATCH_MP_TAC RING_PRODUCT_EQ THEN
        X_GEN_TAC (← q r"s:B->C") THEN DISCH_TAC THEN REWRITE_TAC [o_THM] THEN
        SUBGOAL_THEN (← q r"ring_pow (poly_ring (m:C ring) (:1)) = poly_pow m")
        (SUBST1_TAC o SYM) THENL [REWRITE_TAC [POLY_RING_CLAUSES], ALL_TAC] THEN
        wPart lhand (fun t => do lhand (← rand t))
          (← MATCH_MP RING_HOMOMORPHISM_POW (← ASSUME
            (← q r"ring_homomorphism (poly_ring (m:C ring) (:1),m) (coeff 0)"))) THEN
        ASM_SIMP_TAC [POLY_X_MINUS_A_IN_CARRIER] THEN DISCH_THEN SUBST1_TAC THEN
        REWRITE_TAC [COEFF_POLY_SUB, COEFF_POLY_VAR, COEFF_POLY_CONST, ARITH] THEN
        ASM_SIMP_TAC [RING_SUB_LZERO],
        MATCH_MP_TAC RING_PRODUCT_POW_NEG THEN ASM_SIMP_TAC []],
      MP_TAC (← ISPECL [← q r"m:C ring",
                        ← q r"\s:B->C. poly_pow m (poly_sub m (poly_var m one)
                                           (poly_const m (s x))) e",
                        ← q r"E:(B->C)->bool"] COEFF_RING_PRODUCT_MONIC_SUBLEADING) THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL, NSUM_CONST] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [MULT_SYM] THEN
      DISCH_THEN SUBST1_TAC THEN
      TRANS_TAC EQ_TRANS
       (← q r"ring_neg m (ring_sum m E
        (\s:B->C. ring_neg m (ring_mul m (ring_of_num m e) (s x))))") THEN
      CONJ_TAC THENL
       [AP_TERM_TAC THEN MATCH_MP_TAC RING_SUM_EQ THEN
        ASM_SIMP_TAC [COEFF_POLY_POW_X_MINUS_A_SUBLEADING],
        MP_TAC (← ISPECL [← q r"m:C ring", ← q r"\s:B->C. ring_mul m (ring_of_num m e) (s x)",
                          ← q r"E:(B->C)->bool"] RING_SUM_NEG) THEN
        ASM_SIMP_TAC [RING_MUL, RING_OF_NUM] THEN DISCH_THEN SUBST1_TAC THEN
        ASM_SIMP_TAC [RING_NEG_NEG, RING_SUM, RING_SUM_LMUL, RING_OF_NUM]]])

  -- @@RETURN BEGIN
  return { MINIMAL_POLYNOMIAL_COEFF_EMBEDDINGS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The norm and the trace by the extensions to an algebraically closed       -/
/- field; the separable case.                                                -/
/- (fieldtheory.ml 14992-15196)                                              -/
/- ------------------------------------------------------------------------- -/

structure TraceNormEmbeddings where
  -- @@FIELDS
  ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN : thm
  ALGEBRA_TRACE_NORM_EMBEDDINGS : thm
  ALGEBRA_TRACE_NORM_EMBEDDINGS_SEPARABLE : thm
  deriving Inhabited

@[nospecialize]
def setupTraceNormEmbeddings [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BMinimalPolynomial : MinimalPolynomial) (BAcfBasic : AcfBasic) (BHomExtensions : HomExtensions) (BSeparableDegree : SeparableDegree) (BInseparableDegree : InseparableDegree) (BFieldCharpoly : FieldCharpoly) (BEmbeddingsPrelims : EmbeddingsPrelims) (BMinpolyCoeffEmbeddings : MinpolyCoeffEmbeddings) :
    ExceptT String IO TraceNormEmbeddings := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, RING_RULE, SET_RULE, .. } := D
  let { FIELD_IMP_INTEGRAL_DOMAIN, HAS_SIZE, .. } := D.core2
  let { IN_ELIM_THM, I_O_ID, I_THM, .. } := D.core3
  let { RING_1, .. } := D.core5
  let { RING_HOMOMORPHISM_COMPOSE, RING_HOMOMORPHISM_MUL, RING_MUL, .. } := D.core6
  let { RING_MUL_LID, RING_NEG, RING_POLYNOMIAL, RING_POLYNOMIAL_IMP_POWERSERIES,
        RING_POW, RING_PRODUCT, RING_PRODUCT_EQ, RING_SUM, RING_SUM_EQ, RING_SUM_LMUL, .. } := D.core7
  let { o_THM, .. } := D.core9
  let { COEFF_IN_CARRIER, EQ_TRANS, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { RING_HOMOMORPHISM_POW, RING_HOMOMORPHISM_RING_OF_NUM, RING_MUL_RNEG,
        RING_OF_NUM, RING_OF_NUM_1, RING_OF_NUM_MUL, RING_POW_1, RING_POW_POW,
        RING_PRODUCT_CONST, RING_PRODUCT_POW, RING_SUM_CONST, .. } := D.core11
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, .. } := BFieldExtension
  let { FINITE_EXTENSION_SUBFIELD_GENERATED, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { MINIMAL_POLYNOMIAL_IN_CARRIER, .. } := BMinimalPolynomial
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ring_homomorphism_extensions, .. } := BHomExtensions
  let { HAS_SIZE_SEPARABLE_DEGREE, .. } := BSeparableDegree
  let { EXTENSION_DEGREE_SEPARABLE_INSEPARABLE, INSEPARABLE_DEGREE_EQ_1,
        INSEPARABLE_DEGREE_TOWER, .. } := BInseparableDegree
  let { ALGEBRA_NORM_MINIMAL_POLYNOMIAL, ALGEBRA_TRACE_MINIMAL_POLYNOMIAL, .. } := BFieldCharpoly
  let { RING_HOMOMORPHISM_EXTENSIONS_TOWER_PRODUCT,
        RING_HOMOMORPHISM_EXTENSIONS_TOWER_SUM, SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC, .. } := BEmbeddingsPrelims
  let { MINIMAL_POLYNOMIAL_COEFF_EMBEDDINGS, .. } := BMinpolyCoeffEmbeddings
  -- @@SCOPE END

  let ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN ← prove
   r"!(h:A->B) (g:A->C) k l m x.
        finite_extension(k,l) h /\ algebraically_closed_field m /\
        ring_homomorphism(k,m) g /\ x IN ring_carrier l
        ==> g(algebra_norm(k,l) h x) =
            ring_pow m
             (ring_product m (ring_homomorphism_extensions(k,l,m) (h,g))
                (\s. s x))
             (inseparable_degree(k,l) h) /\
            g(algebra_trace(k,l) h x) =
            ring_mul m (ring_of_num m (inseparable_degree(k,l) h))
             (ring_sum m (ring_homomorphism_extensions(k,l,m) (h,g))
                (\s. s x))"
   (← do
    -- right to left: the RING_RULE, then the SET_RULE
    let r2 ← RING_RULE
     (← q r"ring_mul r (ring_mul r a b) (ring_mul r c d) =
      ring_mul r (ring_mul r c b) (ring_mul r a (d:A))")
    let s1 ← SET_RULE (← q r"s SUBSET (x:B) INSERT s")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION, algebraic_extension],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      ALGEBRA_NORM_MINIMAL_POLYNOMIAL) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      ALGEBRA_TRACE_MINIMAL_POLYNOMIAL) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"x:B"] MINIMAL_POLYNOMIAL_COEFF_EMBEDDINGS) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"(x:B) INSERT IMAGE (h:A->B) (ring_carrier k)"]
      FINITE_EXTENSION_SUBFIELD_GENERATED) THEN
    MP_TAC (← SPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      SUBFIELD_GENERATED_SIMPLE_ALGEBRAIC) THEN
    ASM_REWRITE_TAC [s1] THEN
    ABBREV_TAC
     (← q r"K = subfield_generated l
          ((x:B) INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    ABBREV_TAC (← q r"p = minimal_polynomial (k,l) (h:A->B) x") THEN
    ABBREV_TAC (← q r"E = ring_homomorphism_extensions (k,K,m) (h:A->B,g:A->C)") THEN
    ABBREV_TAC (← q r"e = inseparable_degree (k,K) (h:A->B)") THEN
    ABBREV_TAC (← q r"r = extension_degree (K,l) (I:B->B)") THEN
    ABBREV_TAC (← q r"d = poly_deg k (p:(1->num)->A)") THEN
    REPEAT DISCH_TAC THEN
    REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC o
      check (is_conj o concl))) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"K:B ring",
                      ← q r"l:B ring", ← q r"m:C ring", ← q r"m:C ring", ← q r"\s:B->C. s x"]
      RING_HOMOMORPHISM_EXTENSIONS_TOWER_PRODUCT) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"K:B ring",
                      ← q r"l:B ring", ← q r"m:C ring", ← q r"m:C ring", ← q r"\s:B->C. s x"]
      RING_HOMOMORPHISM_EXTENSIONS_TOWER_SUM) THEN
    ASM_REWRITE_TAC [I_O_ID] THEN REPEAT DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!t:B->C. t IN E
      ==> ring_product m (ring_homomorphism_extensions (K,l,m) (I,t))
                         (\s. s x) =
          ring_pow m (t x) (separable_degree (K,l) (I:B->B)) /\
          ring_sum m (ring_homomorphism_extensions (K,l,m) (I,t)) (\s. s x) =
          ring_mul m (ring_of_num m (separable_degree (K,l) (I:B->B))) (t x)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"t:B->C") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"ring_homomorphism (K,m) (t:B->C) /\ t x IN ring_carrier m")
      STRIP_ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"(t:B->C) IN E") THEN EXPAND_TAC "E" THEN
        REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← ISPECL [← q r"K:B ring", ← q r"m:C ring", ← q r"t:B->C"]
          RING_HOMOMORPHISM_IN_CARRIER) THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"t:B->C", ← q r"K:B ring", ← q r"l:B ring", ← q r"m:C ring"]
        HAS_SIZE_SEPARABLE_DEGREE) THEN
      ASM_REWRITE_TAC [HAS_SIZE] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!s:B->C. s IN ring_homomorphism_extensions (K,l,m) (I,t) ==> s x = t x")
      ASSUME_TAC THENL
       [REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM, I_THM] THEN
        ASM_SIMP_TAC [],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [TRANS_TAC EQ_TRANS
         (← q r"ring_product m (ring_homomorphism_extensions (K,l,m) (I,t))
                       (\s:B->C. (t:B->C) x)") THEN
        CONJ_TAC THENL [MATCH_MP_TAC RING_PRODUCT_EQ THEN ASM_SIMP_TAC [],
                        ALL_TAC],
        TRANS_TAC EQ_TRANS
         (← q r"ring_sum m (ring_homomorphism_extensions (K,l,m) (I,t))
                   (\s:B->C. (t:B->C) x)") THEN
        CONJ_TAC THENL [MATCH_MP_TAC RING_SUM_EQ THEN ASM_SIMP_TAC [],
                        ALL_TAC]] THEN
      ASM_SIMP_TAC [RING_PRODUCT_CONST, RING_SUM_CONST],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"K:B ring", ← q r"m:C ring"]
      HAS_SIZE_SEPARABLE_DEGREE) THEN
    ASM_REWRITE_TAC [HAS_SIZE] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!t:B->C. t IN E ==> t x IN ring_carrier m") ASSUME_TAC THENL
     [EXPAND_TAC "E" THEN
      REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
      ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"l:B ring"]
      INSEPARABLE_DEGREE_TOWER) THEN
    MP_TAC (← ISPECL [← q r"I:B->B", ← q r"K:B ring", ← q r"l:B ring"]
      EXTENSION_DEGREE_SEPARABLE_INSEPARABLE) THEN
    ASM_REWRITE_TAC [I_O_ID] THEN REPEAT DISCH_TAC THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"sl = separable_degree (K,l) (I:B->B)") THEN
    ABBREV_TAC (← q r"il = inseparable_degree (K,l) (I:B->B)") THEN
    SUBGOAL_THEN (← q r"!i. coeff i (p:(1->num)->A) IN ring_carrier k") ASSUME_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC COEFF_IN_CARRIER THEN
      MATCH_MP_TAC RING_POLYNOMIAL_IMP_POWERSERIES THEN
      REWRITE_TAC [RING_POLYNOMIAL] THEN
      SUBST1_TAC (← SYM (← ASSUME (← q r"minimal_polynomial (k,l) (h:A->B) x = p"))) THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"ring_product m E
       (\t. ring_product m (ring_homomorphism_extensions (K,l,m) (I,t))
                           (\s. s x)) =
      ring_pow m (ring_product m E (\t:B->C. t x)) sl")
      SUBST1_TAC THENL
       [TRANS_TAC EQ_TRANS (← q r"ring_product m E (\t:B->C. ring_pow m (t x) sl)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC RING_PRODUCT_EQ THEN ASM_SIMP_TAC [],
          MATCH_MP_TAC RING_PRODUCT_POW THEN ASM_SIMP_TAC []],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"ring_mul k (ring_pow k (ring_neg k (ring_1 k)) d)
                 (coeff 0 (p:(1->num)->A)) IN ring_carrier k")
      ASSUME_TAC THENL [ASM_SIMP_TAC [RING_MUL, RING_POW, RING_NEG, RING_1],
                        ALL_TAC] THEN
      ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_POW
       (← ASSUME (← q r"ring_homomorphism(k,m) (g:A->C)"))] THEN
      ASM_SIMP_TAC [RING_POW_POW, RING_PRODUCT] THEN AP_TERM_TAC THEN ARITH_TAC,
      SUBGOAL_THEN
       (← q r"ring_sum m E
        (\t. ring_sum m (ring_homomorphism_extensions (K,l,m) (I,t))
                        (\s. s x)) =
      ring_mul m (ring_of_num m sl) (ring_sum m E (\t:B->C. t x))")
      SUBST1_TAC THENL
       [TRANS_TAC EQ_TRANS
         (← q r"ring_sum m E (\t:B->C. ring_mul m (ring_of_num m sl) (t x))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC RING_SUM_EQ THEN ASM_SIMP_TAC [],
          MATCH_MP_TAC RING_SUM_LMUL THEN ASM_SIMP_TAC [RING_OF_NUM]],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"ring_neg k (ring_mul k (ring_of_num k (sl * il))
                             (coeff (d - 1) (p:(1->num)->A))) =
      ring_mul k (ring_of_num k (sl * il)) (ring_neg k (coeff (d - 1) p))")
      SUBST1_TAC THENL
       [CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_MUL_RNEG THEN
        ASM_SIMP_TAC [RING_OF_NUM],
        ALL_TAC] THEN
      (← do
        let th ← ASSUME (← q r"ring_homomorphism(k,m) (g:A->C)")
        pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL th,
                            ← MATCH_MP RING_HOMOMORPHISM_RING_OF_NUM th,
                            RING_OF_NUM, RING_NEG])) THEN
      REWRITE_TAC [RING_OF_NUM_MUL] THEN
      MATCH_MP_TAC r2 THEN
      ASM_SIMP_TAC [RING_OF_NUM, RING_SUM]]))

  let ALGEBRA_TRACE_NORM_EMBEDDINGS ← prove
   r"!(h:A->B) (j:B->C) k l m x.
        finite_extension(k,l) h /\ algebraically_closed_field m /\
        ring_homomorphism(l,m) j /\ x IN ring_carrier l
        ==> j(h(algebra_norm(k,l) h x)) =
            ring_pow m
             (ring_product m (ring_homomorphism_extensions(k,l,m) (h,j o h))
                (\s. s x))
             (inseparable_degree(k,l) h) /\
            j(h(algebra_trace(k,l) h x)) =
            ring_mul m (ring_of_num m (inseparable_degree(k,l) h))
             (ring_sum m (ring_homomorphism_extensions(k,l,m) (h,j o h))
                (\s. s x))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->C) o (h:A->B)", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:C ring", ← q r"x:B"] ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN) THEN
    ASM_REWRITE_TAC [o_THM] THEN DISCH_THEN MATCH_MP_TAC THEN
    MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"l:B ring") THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM, FINITE_IMP_FIELD_EXTENSION])

  let ALGEBRA_TRACE_NORM_EMBEDDINGS_SEPARABLE ← prove
   r"!(h:A->B) (g:A->C) k l m x.
        finite_extension(k,l) h /\ separable_extension(k,l) h /\
        algebraically_closed_field m /\ ring_homomorphism(k,m) g /\
        x IN ring_carrier l
        ==> g(algebra_norm(k,l) h x) =
            ring_product m (ring_homomorphism_extensions(k,l,m) (h,g))
              (\s. s x) /\
            g(algebra_trace(k,l) h x) =
            ring_sum m (ring_homomorphism_extensions(k,l,m) (h,g))
              (\s. s x)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"x:B"] ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] INSEPARABLE_DEGREE_EQ_1) THEN
    ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION] THEN
    SIMP_TAC [RING_POW_1, RING_PRODUCT, RING_OF_NUM_1, RING_MUL_LID, RING_SUM])

  -- @@RETURN BEGIN
  return { ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN, ALGEBRA_TRACE_NORM_EMBEDDINGS,
           ALGEBRA_TRACE_NORM_EMBEDDINGS_SEPARABLE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Norm and trace of purely inseparable extensions; the trace of a finite    -/
/- separable extension is onto.                                              -/
/- (fieldtheory.ml 15198-15349)                                              -/
/- ------------------------------------------------------------------------- -/

structure TraceNormSpecial where
  -- @@FIELDS
  ALGEBRA_TRACE_NORM_PURELY_INSEPARABLE : thm
  ALGEBRA_TRACE_SURJECTIVE : thm
  deriving Inhabited

@[nospecialize]
def setupTraceNormSpecial [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicClosure : AlgebraicClosure) (BHomomorphismsIndependent : HomomorphismsIndependent) (BHomExtensions : HomExtensions) (BHomExtensionsCount : HomExtensionsCount) (BSeparableDegree : SeparableDegree) (BPurelyInseparableDegree : PurelyInseparableDegree) (BInseparableDegree : InseparableDegree) (BTraceNormEmbeddings : TraceNormEmbeddings) :
    ExceptT String IO TraceNormSpecial := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, HAS_SIZE_CONV, MESON, SET_TAC, TAUT, .. } := D
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_MUL_LINV, FIELD_NONTRIVIAL, FORALL_IN_IMAGE,
        HAS_SIZE, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { RESTRICTION, RING_1, .. } := D.core5
  let { RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_COMPOSE, RING_HOMOMORPHISM_MUL,
        RING_INV, RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL, .. } := D.core6
  let { RING_MUL_ASSOC, RING_MUL_LID, RING_MUL_RID, RING_POW, RING_SUM_EQ,
        RING_SUM_SING, .. } := D.core7
  let { SUBSET, SUBSET_ANTISYM, .. } := D.core8
  let { o_THM, ring_monomorphism, .. } := D.core9
  let { ALGEBRA_TRACE_NORM_IN_CARRIER, EQ_TRANS, EXTENSIONAL_EQ, MULT_CLAUSES,
        RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { ALGEBRA_TRACE_SCALAR, RING_HOMOMORPHISM_POW, RING_HOMOMORPHISM_RING_OF_NUM,
        RING_OF_NUM, RING_PRODUCT_SING, .. } := D.core11
  let { field_extension, .. } := BFieldExtension
  let { FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { RING_HOMOMORPHISMS_INDEPENDENT_SET, .. } := BHomomorphismsIndependent
  let { RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS,
        RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY, ring_homomorphism_extensions, .. } := BHomExtensions
  let { HAS_SIZE_RING_HOMOMORPHISM_EXTENSIONS, .. } := BHomExtensionsCount
  let { HAS_SIZE_SEPARABLE_DEGREE, .. } := BSeparableDegree
  let { SEPARABLE_DEGREE_EQ_1, .. } := BPurelyInseparableDegree
  let { EXTENSION_DEGREE_SEPARABLE_INSEPARABLE, .. } := BInseparableDegree
  let { ALGEBRA_TRACE_NORM_EMBEDDINGS, ALGEBRA_TRACE_NORM_EMBEDDINGS_SEPARABLE, .. } := BTraceNormEmbeddings
  -- @@SCOPE END

  let ALGEBRA_TRACE_NORM_PURELY_INSEPARABLE ← prove
   r"!(h:A->B) k l x.
        finite_extension(k,l) h /\ purely_inseparable_extension(k,l) h /\
        x IN ring_carrier l
        ==> h(algebra_norm(k,l) h x) = ring_pow l x (extension_degree(k,l) h) /\
            h(algebra_trace(k,l) h x) =
            ring_mul l (ring_of_num l (extension_degree(k,l) h)) x"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    MP_TAC (← ISPEC (← q r"l:B ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:(B#num)ring", ← q r"j:B->B#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"j:B->B#num"
      if !((← liftExcept (rand (concl th))) == c) then throw "check"
      pure ((ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) th)) THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(k,n) ((j:B->B#num) o (h:A->B))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"separable_degree(k,l) (h:A->B) = 1") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] SEPARABLE_DEGREE_EQ_1) THEN
      ASM_SIMP_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_homomorphism_extensions (k,l,n) (h,(j:B->B#num) o (h:A->B)) =
    {RESTRICTION (ring_carrier l) j}")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"k:A ring",
                        ← q r"l:B ring", ← q r"n:(B#num)ring"] HAS_SIZE_SEPARABLE_DEGREE) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"j:B->B#num",
                        ← q r"k:A ring", ← q r"l:B ring", ← q r"n:(B#num)ring"]
        RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS) THEN
      ASM_REWRITE_TAC [o_THM] THEN
      CONV_TAC (ONCE_DEPTH_CONV HAS_SIZE_CONV) THEN SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->B#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"n:(B#num)ring", ← q r"x:B"] ALGEBRA_TRACE_NORM_EMBEDDINGS) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      EXTENSION_DEGREE_SEPARABLE_INSEPARABLE) THEN
    ASM_SIMP_TAC [SEPARABLE_DEGREE_EQ_1, FINITE_IMP_ALGEBRAIC_EXTENSION,
                  MULT_CLAUSES, RING_PRODUCT_SING, RING_SUM_SING,
                  RESTRICTION] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    SUBGOAL_THEN (← q r"(j:B->B#num) x IN ring_carrier n") ASSUME_TAC THENL
     [MATCH_MP_TAC (← ISPECL [← q r"l:B ring", ← q r"n:(B#num)ring", ← q r"j:B->B#num"]
        RING_HOMOMORPHISM_IN_CARRIER) THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    (← do
      let th ← ASSUME (← q r"ring_homomorphism(l,n) (j:B->B#num)")
      pure (REWRITE_TAC [← GSYM (← MATCH_MP RING_HOMOMORPHISM_RING_OF_NUM th)] THEN
            ASM_SIMP_TAC [← GSYM (← MATCH_MP RING_HOMOMORPHISM_POW th),
                          ← GSYM (← MATCH_MP RING_HOMOMORPHISM_MUL th), RING_OF_NUM])) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      ALGEBRA_TRACE_NORM_IN_CARRIER) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    STRIP_TAC THEN CONJ_TAC THEN
    MATCH_MP_TAC (← CONJUNCT2 (← REWRITE_RULE [ring_monomorphism]
     (← ASSUME (← q r"ring_monomorphism(l,n) (j:B->B#num)")))) THEN
    ASM_SIMP_TAC [RING_POW, RING_MUL, RING_OF_NUM] THEN
    MATCH_MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B"]
      RING_HOMOMORPHISM_IN_CARRIER) THEN
    ASM_REWRITE_TAC [])

  let ALGEBRA_TRACE_SURJECTIVE ← prove
   r"!(h:A->B) k l.
        finite_extension(k,l) h /\ separable_extension(k,l) h
        ==> IMAGE (algebra_trace(k,l) h) (ring_carrier l) = ring_carrier k"
   (← do
    -- right to left: the TAUT, then the MESON
    let t2 ← TAUT (← q r"p /\ ~q ==> ~(p ==> q)")
    let m1 ← MESON []
     (← q r"~(!x:B. x IN ring_carrier l ==> algebra_trace(k,l) (h:A->B) x = ring_0 k)
      ==> ?x. x IN ring_carrier l /\ ~(algebra_trace(k,l) h x = ring_0 k)")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN
     (← q r"?x:B. x IN ring_carrier l /\ ~(algebra_trace(k,l) (h:A->B) x = ring_0 k)")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"l:B ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:(B#num)ring", ← q r"j:B->B#num"] THEN STRIP_TAC THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
        MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
      FIRST_ASSUM (fun th => tactic_of do
        let c ← q r"j:B->B#num"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) th)) THEN
      SUBGOAL_THEN (← q r"ring_homomorphism(k,n) ((j:B->B#num) o (h:A->B))")
      ASSUME_TAC THENL
       [MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"l:B ring") THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"k:A ring",
                        ← q r"l:B ring", ← q r"n:(B#num)ring"]
        HAS_SIZE_RING_HOMOMORPHISM_EXTENSIONS) THEN
      ASM_REWRITE_TAC [HAS_SIZE] THEN
      ABBREV_TAC (← q r"E = ring_homomorphism_extensions (k,l,n)
                      (h:A->B,(j:B->B#num) o h)") THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"~(E:(B->B#num)->bool = {})") ASSUME_TAC THENL
       [EXPAND_TAC "E" THEN
        MATCH_MP_TAC RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY THEN
        ASM_SIMP_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(!f. f IN E ==> ring_homomorphism(l,n) (f:B->B#num)) /\
      (!f g. f IN E /\ g IN E /\ ~(f = g)
             ==> ?x. x IN ring_carrier l /\ ~((f:B->B#num) x = g x))")
      STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "E" THEN
        SIMP_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"f:B->B#num", ← q r"g:B->B#num"] THEN STRIP_TAC THEN
        ASM_MESON_TAC [EXTENSIONAL_EQ],
        ALL_TAC] THEN
      MATCH_MP_TAC m1 THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"n:(B#num)ring", ← q r"E:(B->B#num)->bool",
                        ← q r"\f:B->B#num. ring_1(n:(B#num)ring)"]
        RING_HOMOMORPHISMS_INDEPENDENT_SET) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, RING_1] THEN
      MATCH_MP_TAC t2 THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
        TRANS_TAC EQ_TRANS (← q r"ring_sum n E (\f:B->B#num. f x)") THEN CONJ_TAC THENL
         [MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"f:B->B#num") THEN DISCH_TAC THEN
          REWRITE_TAC [] THEN MATCH_MP_TAC RING_MUL_LID THEN
          ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
          MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"k:A ring",
                            ← q r"l:B ring", ← q r"n:(B#num)ring", ← q r"x:B"]
            ALGEBRA_TRACE_NORM_EMBEDDINGS_SEPARABLE) THEN
          ASM_SIMP_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM o CONJUNCT2) THEN
          MATCH_MP_TAC RING_HOMOMORPHISM_0 THEN ASM_REWRITE_TAC []],
        ASM_SIMP_TAC [FIELD_NONTRIVIAL] THEN ASM SET_TAC []],
      ALL_TAC] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      ASM_MESON_TAC [ALGEBRA_TRACE_NORM_IN_CARRIER],
      REWRITE_TAC [SUBSET, IN_IMAGE] THEN X_GEN_TAC (← q r"a:A") THEN DISCH_TAC] THEN
    ABBREV_TAC (← q r"t = algebra_trace(k,l) (h:A->B) x") THEN
    SUBGOAL_THEN (← q r"(t:A) IN ring_carrier k") ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN ASM_SIMP_TAC [ALGEBRA_TRACE_NORM_IN_CARRIER],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"ring_mul k (a:A) (ring_inv k t) IN ring_carrier k")
    ASSUME_TAC THENL [ASM_SIMP_TAC [RING_MUL, RING_INV], ALL_TAC] THEN
    EXISTS_TAC (← q r"ring_mul l ((h:A->B)(ring_mul k a (ring_inv k t))) x") THEN
    ASM_SIMP_TAC [ALGEBRA_TRACE_SCALAR] THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [← GSYM RING_MUL_ASSOC, RING_INV, FIELD_MUL_LINV, RING_MUL_RID],
      ASM_MESON_TAC [RING_MUL, RING_HOMOMORPHISM_IN_CARRIER]]))

  -- @@RETURN BEGIN
  return { ALGEBRA_TRACE_NORM_PURELY_INSEPARABLE, ALGEBRA_TRACE_SURJECTIVE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Transitivity of the norm and the trace in towers.                         -/
/- (fieldtheory.ml 15351-15511)                                              -/
/- ------------------------------------------------------------------------- -/

structure TraceNormTower where
  -- @@FIELDS
  ALGEBRA_TRACE_NORM_TOWER : thm
  deriving Inhabited

@[nospecialize]
def setupTraceNormTower [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicClosure : AlgebraicClosure) (BHomExtensions : HomExtensions) (BHomExtensionsCount : HomExtensionsCount) (BInseparableDegree : InseparableDegree) (BFreeBasesField : FreeBasesField) (BEmbeddingsPrelims : EmbeddingsPrelims) (BTraceNormEmbeddings : TraceNormEmbeddings) :
    ExceptT String IO TraceNormTower := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, .. } := D
  let { FIELD_IMP_INTEGRAL_DOMAIN, .. } := D.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { RING_MONOMORPHISM_COMPOSE, RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_MUL_ASSOC, RING_PRODUCT, RING_PRODUCT_EQ, RING_SUM, RING_SUM_EQ,
        RING_SUM_LMUL, .. } := D.core7
  let { ring_monomorphism, .. } := D.core9
  let { ALGEBRA_TRACE_NORM_IN_CARRIER, ALGEBRA_TRACE_NORM_NO_PROJECTIVE_BASIS,
        EQ_TRANS, .. } := D.core10
  let { ALGEBRA_NORM_1, ALGEBRA_TRACE_0, RING_OF_NUM, RING_OF_NUM_MUL, RING_POW_POW,
        RING_PRODUCT_POW, .. } := D.core11
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_TRANS, field_extension, .. } := BFieldExtension
  let { FINITE_EXTENSION_TRANS, FINITE_EXTENSION_TRANS_EQ, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, .. } := BAlgebraicExtension
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { ring_homomorphism_extensions, .. } := BHomExtensions
  let { CARD_RING_HOMOMORPHISM_EXTENSIONS_LE, .. } := BHomExtensionsCount
  let { INSEPARABLE_DEGREE_TOWER, .. } := BInseparableDegree
  let { PROJECTIVE_BASIS_IMP_FINITE_EXTENSION, .. } := BFreeBasesField
  let { RING_HOMOMORPHISM_EXTENSIONS_TOWER_PRODUCT,
        RING_HOMOMORPHISM_EXTENSIONS_TOWER_SUM, .. } := BEmbeddingsPrelims
  let { ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN, .. } := BTraceNormEmbeddings
  -- @@SCOPE END

  let ALGEBRA_TRACE_NORM_TOWER ← prove
   r"!(f:A->B) (g:B->C) k l m x.
        field_extension(k,l) f /\ field_extension(l,m) g /\
        x IN ring_carrier m
        ==> algebra_trace(k,m) (g o f) x =
            algebra_trace(k,l) f (algebra_trace(l,m) g x) /\
            algebra_norm(k,m) (g o f) x =
            algebra_norm(k,l) f (algebra_norm(l,m) g x)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC
     (← q r"finite_extension(k,l) (f:A->B) /\ finite_extension(l,m) (g:B->C)") THENL
     [FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC),
      SUBGOAL_THEN
       (← q r"ring_homomorphism(k,l) (f:A->B) /\ ring_homomorphism(l,m) (g:B->C) /\
      field_extension(k,m) (g o f)")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_TRANS],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"~(?n d e. projective_basis (k,m) ((g:B->C) o (f:A->B)) n d e)")
      ASSUME_TAC THENL
       [ASM_MESON_TAC [PROJECTIVE_BASIS_IMP_FINITE_EXTENSION,
                       FINITE_EXTENSION_TRANS_EQ],
        ASM_SIMP_TAC [ALGEBRA_TRACE_NORM_NO_PROJECTIVE_BASIS]] THEN
      ASM_CASES_TAC (← q r"finite_extension(l,m) (g:B->C)") THENL
       [SUBGOAL_THEN (← q r"~(?n b e. projective_basis (k,l) (f:A->B) n b e)")
        ASSUME_TAC THENL
         [ASM_MESON_TAC [PROJECTIVE_BASIS_IMP_FINITE_EXTENSION],
          ASM_SIMP_TAC [ALGEBRA_TRACE_NORM_NO_PROJECTIVE_BASIS]],
        SUBGOAL_THEN (← q r"~(?n c e. projective_basis (l,m) (g:B->C) n c e)")
        ASSUME_TAC THENL
         [ASM_MESON_TAC [PROJECTIVE_BASIS_IMP_FINITE_EXTENSION],
          ASM_SIMP_TAC [ALGEBRA_TRACE_NORM_NO_PROJECTIVE_BASIS, ALGEBRA_TRACE_0,
                        ALGEBRA_NORM_1]]]] THEN
    SUBGOAL_THEN (← q r"finite_extension(k,m) ((g:B->C) o (f:A->B))") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_EXTENSION_TRANS], ALL_TAC] THEN
    MAP_EVERY (fun c => FIRST_ASSUM (fun th => tactic_of do
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
               MATCH_MP FINITE_IMP_FIELD_EXTENSION) th)))
     [← q r"f:A->B", ← q r"g:B->C"] THEN
    MP_TAC (← ISPEC (← q r"m:C ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:(C#num)ring", ← q r"j:C->C#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    ABBREV_TAC (← q r"G = (j:C->C#num) o (g:B->C) o (f:A->B)") THEN
    SUBGOAL_THEN (← q r"ring_monomorphism(k,n) (G:A->C#num)") ASSUME_TAC THENL
     [EXPAND_TAC "G" THEN MATCH_MP_TAC RING_MONOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"m:C ring") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC RING_MONOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    MP_TAC (← ISPECL [← q r"(g:B->C) o (f:A->B)", ← q r"G:A->C#num", ← q r"k:A ring", ← q r"m:C ring",
                      ← q r"n:(C#num)ring", ← q r"x:C"] ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"g:B->C", ← q r"l:B ring", ← q r"m:C ring", ← q r"x:C"]
      ALGEBRA_TRACE_NORM_IN_CARRIER) THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"G:A->C#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"n:(C#num)ring", ← q r"algebra_norm(l,m) (g:B->C) x"]
      ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN (ASSUME_TAC o CONJUNCT1)] THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"G:A->C#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"n:(C#num)ring", ← q r"algebra_trace(l,m) (g:B->C) x"]
      ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN (ASSUME_TAC o CONJUNCT2)] THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"G:A->C#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:C ring", ← q r"n:(C#num)ring", ← q r"n:(C#num)ring",
                      ← q r"\s:C->C#num. s x"]
      RING_HOMOMORPHISM_EXTENSIONS_TOWER_PRODUCT) THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"G:A->C#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:C ring", ← q r"n:(C#num)ring", ← q r"n:(C#num)ring",
                      ← q r"\s:C->C#num. s x"]
      RING_HOMOMORPHISM_EXTENSIONS_TOWER_SUM) THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
      INSEPARABLE_DEGREE_TOWER) THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"G:A->C#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"n:(C#num)ring"] CARD_RING_HOMOMORPHISM_EXTENSIONS_LE) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
    ABBREV_TAC
     (← q r"Ekl = ring_homomorphism_extensions (k,l,n) (f:A->B,G:A->C#num)") THEN
    ABBREV_TAC (← q r"Ekm = ring_homomorphism_extensions (k,m,n)
                      ((g:B->C) o (f:A->B),G:A->C#num)") THEN
    REPEAT DISCH_TAC THEN
    UNDISCH_THEN
     (← q r"FINITE(Ekl:(B->C#num)->bool) /\ CARD Ekl <= extension_degree (k,l) (f:A->B)")
     STRIP_ASSUME_TAC THEN
    SUBGOAL_THEN
     (← q r"!t:B->C#num. t IN Ekl
      ==> t(algebra_norm(l,m) (g:B->C) x) =
          ring_pow n
           (ring_product n (ring_homomorphism_extensions(l,m,n) (g,t))
              (\s. s x))
           (inseparable_degree(l,m) g) /\
          t(algebra_trace(l,m) g x) =
          ring_mul n (ring_of_num n (inseparable_degree(l,m) g))
           (ring_sum n (ring_homomorphism_extensions(l,m,n) (g,t))
              (\s. s x))")
    (LABEL_TAC "emb") THENL
     [X_GEN_TAC (← q r"t:B->C#num") THEN EXPAND_TAC "Ekl" THEN
      DISCH_THEN (STRIP_ASSUME_TAC o
        REWRITE_RULE [ring_homomorphism_extensions, IN_ELIM_THM]) THEN
      MATCH_MP_TAC ALGEBRA_TRACE_NORM_EMBEDDINGS_GEN THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THEN
    MATCH_MP_TAC (← CONJUNCT2 (← REWRITE_RULE [ring_monomorphism]
     (← ASSUME (← q r"ring_monomorphism(k,n) (G:A->C#num)")))) THEN
    ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [ALGEBRA_TRACE_NORM_IN_CARRIER] THEN
      SUBGOAL_THEN
       (← q r"ring_sum n Ekl (\s:B->C#num. s (algebra_trace (l,m) (g:B->C) x)) =
      ring_mul n (ring_of_num n (inseparable_degree (l,m) g))
       (ring_sum n Ekl
         (\t. ring_sum n (ring_homomorphism_extensions (l,m,n) (g,t))
                (\s. s x)))")
      SUBST1_TAC THENL
       [TRANS_TAC EQ_TRANS
         (← q r"ring_sum n Ekl
         (\t:B->C#num. ring_mul n (ring_of_num n (inseparable_degree (l,m) g))
           (ring_sum n (ring_homomorphism_extensions (l,m,n) ((g:B->C),t))
              (\s. s x)))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"t:B->C#num") THEN
          DISCH_TAC THEN REWRITE_TAC [] THEN
          REMOVE_THEN "emb" (MP_TAC o SPEC (← q r"t:B->C#num")) THEN
          ASM_REWRITE_TAC [] THEN SIMP_TAC [],
          MATCH_MP_TAC RING_SUM_LMUL THEN ASM_REWRITE_TAC [RING_OF_NUM, RING_SUM]],
        ALL_TAC] THEN
      REWRITE_TAC [RING_OF_NUM_MUL] THEN
      MATCH_MP_TAC (← GSYM RING_MUL_ASSOC) THEN
      REWRITE_TAC [RING_OF_NUM, RING_SUM],
      REWRITE_TAC [ALGEBRA_TRACE_NORM_IN_CARRIER] THEN
      SUBGOAL_THEN
       (← q r"ring_product n Ekl (\s:B->C#num. s (algebra_norm (l,m) (g:B->C) x)) =
      ring_pow n
       (ring_product n Ekl
         (\t. ring_product n (ring_homomorphism_extensions (l,m,n) (g,t))
                (\s. s x)))
       (inseparable_degree (l,m) g)")
      SUBST1_TAC THENL
       [TRANS_TAC EQ_TRANS
         (← q r"ring_product n Ekl
         (\t:B->C#num. ring_pow n
           (ring_product n
              (ring_homomorphism_extensions (l,m,n) ((g:B->C),t))
              (\s. s x))
           (inseparable_degree (l,m) g))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC RING_PRODUCT_EQ THEN X_GEN_TAC (← q r"t:B->C#num") THEN
          DISCH_TAC THEN REWRITE_TAC [] THEN
          REMOVE_THEN "emb" (MP_TAC o SPEC (← q r"t:B->C#num")) THEN
          ASM_REWRITE_TAC [] THEN SIMP_TAC [],
          MATCH_MP_TAC RING_PRODUCT_POW THEN ASM_REWRITE_TAC [RING_PRODUCT]],
        ALL_TAC] THEN
      SIMP_TAC [RING_POW_POW, RING_PRODUCT] THEN AP_TERM_TAC THEN ARITH_TAC])

  -- @@RETURN BEGIN
  return { ALGEBRA_TRACE_NORM_TOWER }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The primitive element theorem: generators and separating embeddings.      -/
/- (fieldtheory.ml 15513-15624)                                              -/
/- ------------------------------------------------------------------------- -/

structure PrimitiveSeparating where
  -- @@FIELDS
  PRIMITIVE_ELEMENT_EQ_SEPARATING_EMBEDDINGS : thm
  deriving Inhabited

@[nospecialize]
def setupPrimitiveSeparating [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BMinimalPolynomial : MinimalPolynomial) (BAcfBasic : AcfBasic) (BHomExtensions : HomExtensions) (BHomExtensionsCount : HomExtensionsCount) :
    ExceptT String IO PrimitiveSeparating := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, TAUT, .. } := D
  let { CARD_EQ_SYM, CARD_FINITE_CONG, CARD_IMAGE_INJ, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FORALL_IN_IMAGE, HAS_SIZE, IMAGE_I, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, I_O_ID, .. } := D.core3
  let { SUBSET, SUBSET_REFL, .. } := D.core8
  let { CARD_EQ_CARD_IMP, CARD_SUBSET, EXTENSIONAL_EQ, LE_ANTISYM,
        RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { SUBRING_GENERATED_SUPERSET, .. } := D.core11
  let { FIELD_EXTENSION_FROM_SUBRING_GENERATED, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_REFL, field_extension, .. } := BFieldExtension
  let { EXTENSION_DEGREE_EQ_TOWER, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { FIELD_SIMPLE_ALGEBRAIC_EXTENSION, FINITE_SIMPLE_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { EXTENSION_DEGREE_SIMPLE, MINIMAL_POLYNOMIAL_DEG_LE_EXTENSION_DEGREE, .. } := BMinimalPolynomial
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { RING_HOMOMORPHISM_EXTENSIONS_ROOT, RING_HOMOMORPHISM_EXTENSIONS_SIMPLE,
        ring_homomorphism_extensions, .. } := BHomExtensions
  let { CARD_RING_HOMOMORPHISM_EXTENSIONS_LE, HAS_SIZE_RING_HOMOMORPHISM_EXTENSIONS, .. } := BHomExtensionsCount
  -- @@SCOPE END

  let PRIMITIVE_ELEMENT_EQ_SEPARATING_EMBEDDINGS ← prove
   r"!(h:A->B) (g:A->C) k l m a.
        finite_extension (k,l) h /\ separable_extension (k,l) h /\
        algebraically_closed_field m /\ ring_homomorphism (k,m) g /\
        a IN ring_carrier l
        ==> (subring_generated l (a INSERT IMAGE h (ring_carrier k)) = l <=>
             !f f'. f IN ring_homomorphism_extensions (k,l,m) (h,g) /\
                    f' IN ring_homomorphism_extensions (k,l,m) (h,g) /\
                    f a = f' a
                    ==> f = f')"
   (← do
    -- right to left: the MESON, then the TAUT
    let m2 ← MESON [CARD_FINITE_CONG, CARD_EQ_CARD_IMP, CARD_EQ_SYM]
     (← q r"!s:(B->C)->bool t:C->bool.
        s =_c t /\ FINITE s ==> FINITE t /\ CARD t = CARD s")
    let t1 ← TAUT (← q r"p /\ (q ==> r) ==> (p <=> q) ==> r")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM) THEN
    EQ_TAC THENL
     [DISCH_TAC THEN REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:B->C", ← q r"f':B->C"] THEN STRIP_TAC THEN
      MATCH_MP_TAC EXTENSIONAL_EQ THEN EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"ring_carrier l =
      ring_carrier(subring_generated l
                    ((a:B) INSERT IMAGE (h:A->B) (ring_carrier k)))")
      SUBST1_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED THEN
      EXISTS_TAC (← q r"m:C ring") THEN ASM_REWRITE_TAC [IN_INSERT, IN_IMAGE] THEN
      ASM_MESON_TAC [],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_over (k,l) (h:A->B) a") ASSUME_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o CONJUNCT2 o
        GEN_REWRITE_RULE I [algebraic_extension] o
        MATCH_MP FINITE_IMP_ALGEBRAIC_EXTENSION) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"K = subring_generated l ((a:B) INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    SUBGOAL_THEN
     (← q r"finite_extension (k,K) (h:A->B) /\ field_extension (K,l) (I:B->B)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_SIMPLE_ALGEBRAIC_EXTENSION THEN ASM_REWRITE_TAC [],
        MATCH_MP_TAC FIELD_EXTENSION_FROM_SUBRING_GENERATED THEN
        REWRITE_TAC [FIELD_EXTENSION_REFL] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [field_extension],
          MATCH_MP_TAC FIELD_SIMPLE_ALGEBRAIC_EXTENSION THEN ASM_REWRITE_TAC []]],
      ALL_TAC] THEN
    MP_TAC (← REWRITE_RULE [I_O_ID, IMAGE_I] (← ISPECL
     [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"l:B ring"]
     EXTENSION_DEGREE_EQ_TOWER)) THEN
    ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION] THEN
    MATCH_MP_TAC t1 THEN
    CONJ_TAC THENL
     [ALL_TAC,
      DISCH_TAC THEN EXPAND_TAC "K" THEN
      REWRITE_TAC [SUBRING_GENERATED_SUPERSET] THEN
      ASM_REWRITE_TAC [SUBSET_REFL]] THEN
    REWRITE_TAC [← GSYM LE_ANTISYM] THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
        EXTENSION_DEGREE_SIMPLE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC MINIMAL_POLYNOMIAL_DEG_LE_EXTENSION_DEGREE THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
      HAS_SIZE_RING_HOMOMORPHISM_EXTENSIONS) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"K:B ring", ← q r"m:C ring"]
      CARD_RING_HOMOMORPHISM_EXTENSIONS_LE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"a:B"] RING_HOMOMORPHISM_EXTENSIONS_SIMPLE) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD,
                  HAS_SIZE] THEN
    ABBREV_TAC
     (← q r"R = {b | b IN ring_carrier m /\
             poly_eval m ((g:A->C) o minimal_polynomial (k,l) (h:A->B) a) b =
             ring_0 m}") THEN
    ABBREV_TAC (← q r"E = ring_homomorphism_extensions (k,l,m) (h:A->B,g:A->C)") THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"FINITE(R:C->bool) /\
    CARD R = CARD(ring_homomorphism_extensions (k,K,m) (h:A->B,g:A->C))")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC m2 THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"CARD(IMAGE (\f:B->C. f a) E) = CARD(E:(B->C)->bool)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC CARD_IMAGE_INJ THEN ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"IMAGE (\f:B->C. f a) E SUBSET R") ASSUME_TAC THENL
     [EXPAND_TAC "R" THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"f:B->C") THEN DISCH_TAC THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"(f:B->C) IN E") THEN EXPAND_TAC "E" THEN
        REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
        STRIP_TAC THEN MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
        EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
        MATCH_MP_TAC RING_HOMOMORPHISM_EXTENSIONS_ROOT THEN
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"IMAGE (\f:B->C. f a) E", ← q r"R:C->bool"] CARD_SUBSET) THEN
    ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC))

  -- @@RETURN BEGIN
  return { PRIMITIVE_ELEMENT_EQ_SEPARATING_EMBEDDINGS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The primitive element theorem: a + c * b generates the same subfield as   -/
/- a and b for all but finitely many c.                                      -/
/- (fieldtheory.ml 15626-15802)                                              -/
/- ------------------------------------------------------------------------- -/

structure PrimitiveTwoGenerators where
  -- @@FIELDS
  PRIMITIVE_ELEMENT_TWO_GENERATORS : thm
  deriving Inhabited

@[nospecialize]
def setupPrimitiveTwoGenerators [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BAlgebraicClosure : AlgebraicClosure) (BSeparableExtension : SeparableExtension) (BHomExtensions : HomExtensions) (BHomExtensionsCount : HomExtensionsCount) (BPrimitiveSeparating : PrimitiveSeparating) :
    ExceptT String IO PrimitiveTwoGenerators := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, FIELD_TAC, MESON_TAC, SET_TAC, TAUT, .. } := D
  let { CONTRAPOS_THM, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FINITE_EMPTY, FINITE_INSERT,
        FINITE_PRODUCT_DEPENDENT, FINITE_SUBSET, FORALL_IN_INSERT, .. } := D.core2
  let { INSERT_SUBSET, IN_ELIM_THM, IN_IMAGE, IN_INSERT, I_O_ID, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { NOT_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core4
  let { RING_ADD, .. } := D.core5
  let { RING_HOMOMORPHISM_ADD, RING_HOMOMORPHISM_MUL,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL, .. } := D.core6
  let { SUBRING_GENERATED, .. } := D.core7
  let { SUBRING_GENERATED_IDEMPOT, SUBRING_GENERATED_SUBSET_CARRIER, SUBSET,
        SUBSET_REFL, .. } := D.core8
  let { ring_monomorphism, .. } := D.core9
  let { EXTENSIONAL_EQ, RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED,
        RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { FINITE_IMAGE_INJ_GENERAL, SUBRING_GENERATED_IDEMPOT_GEN, .. } := D.core11
  let { FIELD_EXTENSION_FROM_SUBRING_GENERATED, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_IMP_SUBSET, FIELD_EXTENSION_REFL, field_extension, .. } := BFieldExtension
  let { FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_FINITELY_GENERATED_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { SEPARABLE_EXTENSION_SUBFIELD, SEPARABLE_IMP_ALGEBRAIC_EXTENSION,
        SEPARABLE_IMP_FIELD_EXTENSION, .. } := BSeparableExtension
  let { ring_homomorphism_extensions, .. } := BHomExtensions
  let { CARD_RING_HOMOMORPHISM_EXTENSIONS_LE, .. } := BHomExtensionsCount
  let { PRIMITIVE_ELEMENT_EQ_SEPARATING_EMBEDDINGS, .. } := BPrimitiveSeparating
  -- @@SCOPE END

  let PRIMITIVE_ELEMENT_TWO_GENERATORS ← (do
    let lemma ← prove
     r"!f x y u v w:A.
        field f /\ x IN ring_carrier f /\ y IN ring_carrier f /\
        u IN ring_carrier f /\ v IN ring_carrier f /\ w IN ring_carrier f /\
        ring_add f x (ring_mul f w u) = ring_add f y (ring_mul f w v) /\
        ~(w = ring_div f (ring_sub f y x) (ring_sub f u v))
        ==> x = y /\ u = v"
     FIELD_TAC
    let t1 ← TAUT (← q r"p /\ (p ==> q) /\ (q ==> r) ==> p /\ q /\ r")
    prove
     r"!(h:A->B) k l a b.
        separable_extension (k,l) h /\
        a IN ring_carrier l /\ b IN ring_carrier l
        ==> FINITE {c | c IN ring_carrier k /\
                        ~(subring_generated l
                           (ring_add l a (ring_mul l (h c) b) INSERT
                            IMAGE h (ring_carrier k)) =
                          subring_generated l
                           (a INSERT b INSERT IMAGE h (ring_carrier k)))}"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP SEPARABLE_IMP_FIELD_EXTENSION) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"{a:B,b}"]
        FINITE_FINITELY_GENERATED_ALGEBRAIC_EXTENSION) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY, FORALL_IN_INSERT,
                         NOT_IN_EMPTY] THEN
        ASM_MESON_TAC [SEPARABLE_IMP_ALGEBRAIC_EXTENSION, algebraic_extension],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"IMAGE (h:A->B) (ring_carrier k) UNION {a,b} =
      a INSERT b INSERT IMAGE h (ring_carrier k)")
      SUBST1_TAC THENL [SET_TAC [], ALL_TAC] THEN
      ABBREV_TAC
       (← q r"L = subring_generated l
            ((a:B) INSERT b INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
      DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"ring_add L = ring_add (l:B ring) /\ ring_mul L = ring_mul l /\
      field_extension (L,l) (I:B->B)")
      STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "L" THEN REWRITE_TAC [SUBRING_GENERATED] THEN
        MATCH_MP_TAC FIELD_EXTENSION_FROM_SUBRING_GENERATED THEN
        REWRITE_TAC [FIELD_EXTENSION_REFL] THEN ASM_REWRITE_TAC [] THEN
        ASM_MESON_TAC [field_extension, FINITE_IMP_FIELD_EXTENSION],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(a:B) IN ring_carrier L /\ (b:B) IN ring_carrier L /\
      IMAGE (h:A->B) (ring_carrier k) SUBSET ring_carrier L /\
      subring_generated L (a INSERT b INSERT IMAGE h (ring_carrier k)) = L")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPECL [← q r"l:B ring",
                          ← q r"(a:B) INSERT b INSERT IMAGE (h:A->B) (ring_carrier k)"]
          SUBRING_GENERATED_SUBSET_CARRIER) THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
          FIELD_EXTENSION_IMP_SUBSET) THEN
        MP_TAC (← ISPECL [← q r"l:B ring",
                          ← q r"(a:B) INSERT b INSERT IMAGE (h:A->B) (ring_carrier k)",
                          ← q r"(a:B) INSERT b INSERT IMAGE (h:A->B) (ring_carrier k)"]
          SUBRING_GENERATED_IDEMPOT) THEN
        ASM_REWRITE_TAC [SUBSET_REFL] THEN REPEAT DISCH_TAC THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"separable_extension (k,L) (h:A->B)") ASSUME_TAC THENL
       [MATCH_MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B"]
          SEPARABLE_EXTENSION_SUBFIELD) THEN
        EXISTS_TAC (← q r"l:B ring") THEN
        ASM_SIMP_TAC [I_O_ID, FINITE_IMP_FIELD_EXTENSION],
        ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"k:A ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [field_extension], ALL_TAC] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"m:(A#num)ring", ← q r"g:A->A#num"] THEN STRIP_TAC THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
        MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->A#num", ← q r"k:A ring", ← q r"L:B ring",
                        ← q r"m:(A#num)ring"] CARD_RING_HOMOMORPHISM_EXTENSIONS_LE) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN STRIP_TAC THEN
      ABBREV_TAC
       (← q r"E = ring_homomorphism_extensions (k,L,m) (h:A->B,g:A->A#num)") THEN
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC
       (← q r"{c | c IN ring_carrier k /\
           (g:A->A#num) c IN
           {ring_div m (ring_sub m ((f':B->A#num) a) (f a))
                       (ring_sub m (f b) (f' b)) |
            f IN E /\ f' IN E}}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_IMAGE_INJ_GENERAL THEN CONJ_TAC THENL
         [FIRST_ASSUM (ACCEPT_TAC o CONJUNCT2 o
            GEN_REWRITE_RULE I [ring_monomorphism]),
          MATCH_MP_TAC FINITE_PRODUCT_DEPENDENT THEN ASM_REWRITE_TAC []],
        ALL_TAC] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"c:A") THEN
      ASM_CASES_TAC (← q r"(c:A) IN ring_carrier k") THEN ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_THEN (LABEL_TAC "good") THEN
      SUBGOAL_THEN
       (← q r"(h:A->B) c IN ring_carrier L /\
      ring_mul l ((h:A->B) c) b IN ring_carrier L /\
      ring_add l a (ring_mul l ((h:A->B) c) b) IN ring_carrier L")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC t1 THEN
        REPEAT CONJ_TAC THENL
         [ASM SET_TAC [],
          MP_TAC (← ISPECL [← q r"L:B ring", ← q r"(h:A->B) c", ← q r"b:B"] RING_MUL),
          MP_TAC (← ISPECL [← q r"L:B ring", ← q r"a:B", ← q r"ring_mul l ((h:A->B) c) b"]
            RING_ADD)] THEN
        ASM_SIMP_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!f:B->A#num.
        f IN E
        ==> f(ring_add l a (ring_mul l ((h:A->B) c) b)) =
            ring_add m (f a) (ring_mul m (g c) (f b)) /\
            f a IN ring_carrier m /\ f b IN ring_carrier m")
      (LABEL_TAC "eval") THENL
       [EXPAND_TAC "E" THEN
        REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"f:B->A#num") THEN STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"L:B ring", ← q r"m:(A#num)ring", ← q r"f:B->A#num"]
          RING_HOMOMORPHISM_ADD) THEN
        MP_TAC (← ISPECL [← q r"L:B ring", ← q r"m:(A#num)ring", ← q r"f:B->A#num"]
          RING_HOMOMORPHISM_MUL) THEN
        ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
        ASM_SIMP_TAC [] THEN CONJ_TAC THEN
        MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
        EXISTS_TAC (← q r"L:B ring") THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"l:B ring",
                        ← q r"ring_add l a (ring_mul l ((h:A->B) c) b) INSERT
                    IMAGE (h:A->B) (ring_carrier k)",
                        ← q r"(a:B) INSERT b INSERT IMAGE (h:A->B) (ring_carrier k)"]
        SUBRING_GENERATED_IDEMPOT_GEN) THEN
      ASM_REWRITE_TAC [INSERT_SUBSET] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->A#num", ← q r"k:A ring", ← q r"L:B ring",
                        ← q r"m:(A#num)ring", ← q r"ring_add l a (ring_mul l ((h:A->B) c) b)"]
        PRIMITIVE_ELEMENT_EQ_SEPARATING_EMBEDDINGS) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"f:B->A#num", ← q r"f':B->A#num"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"m:(A#num)ring", ← q r"(f:B->A#num) a", ← q r"(f':B->A#num) a",
                        ← q r"(f:B->A#num) b", ← q r"(f':B->A#num) b", ← q r"(g:A->A#num) c"]
        lemma) THEN
      REMOVE_THEN "good" (MP_TAC o SPECL [← q r"f:B->A#num", ← q r"f':B->A#num"]) THEN
      REMOVE_THEN "eval" (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"f':B->A#num") th) THEN
              MP_TAC (← SPEC (← q r"f:B->A#num") th))) THEN
      REWRITE_TAC [← ASSUME (← q r"(f:B->A#num) IN E"), ← ASSUME (← q r"(f':B->A#num) IN E")] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 (SUBST1_TAC o SYM) STRIP_ASSUME_TAC)) THEN
      DISCH_TAC THEN ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
        EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
        STRIP_TAC] THEN
      SUBGOAL_THEN
       (← q r"ring_homomorphism (L,m) (f:B->A#num) /\
      ring_homomorphism (L,m) (f':B->A#num) /\
      f IN EXTENSIONAL (ring_carrier L) /\
      f' IN EXTENSIONAL (ring_carrier L) /\
      (!x. x IN ring_carrier k ==> f((h:A->B) x) = (g:A->A#num) x) /\
      (!x. x IN ring_carrier k ==> f'((h:A->B) x) = (g:A->A#num) x)")
      STRIP_ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"(f:B->A#num) IN E") THEN
        UNDISCH_TAC (← q r"(f':B->A#num) IN E") THEN
        EXPAND_TAC "E" THEN
        REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
        MESON_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC EXTENSIONAL_EQ THEN EXISTS_TAC (← q r"ring_carrier L:B->bool") THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"ring_carrier L =
      ring_carrier(subring_generated L
        ((a:B) INSERT b INSERT IMAGE (h:A->B) (ring_carrier k)))")
      SUBST1_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED THEN
      EXISTS_TAC (← q r"m:(A#num)ring") THEN ASM_REWRITE_TAC [IN_INSERT, IN_IMAGE] THEN
      REPEAT STRIP_TAC THEN ASM_SIMP_TAC []))

  -- @@RETURN BEGIN
  return { PRIMITIVE_ELEMENT_TWO_GENERATORS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The primitive element theorem and its consequences.                       -/
/- (fieldtheory.ml 15804-15997)                                              -/
/- ------------------------------------------------------------------------- -/

structure PrimitiveElement where
  -- @@FIELDS
  PRIMITIVE_ELEMENT_INFINITE : thm
  PRIMITIVE_ELEMENT_GENSET : thm
  PRIMITIVE_ELEMENT_THEOREM : thm
  PRIMITIVE_ELEMENT_THEOREM_EQ : thm
  SEPARABLE_EXTENSION_BOUNDED_DEGREE : thm
  deriving Inhabited

@[nospecialize]
def setupPrimitiveElement [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BRingSpan : RingSpan) (BLinearAlgebra : LinearAlgebra) (BFinitary : Finitary) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BMinimalPolynomial : MinimalPolynomial) (BFiniteExt : FiniteExt) (BSeparableExtension : SeparableExtension) (BSeparableDegree : SeparableDegree) (BPrimitiveTwoGenerators : PrimitiveTwoGenerators) :
    ExceptT String IO PrimitiveElement := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { FINITE_INDUCT_STRONG, FORALL_IN_GSPEC, HAS_SIZE, .. } := D.core2
  let { IMP_CONJ, INFINITE, INSERT_SUBSET, IN_DIFF, IN_ELIM_THM, IN_INSERT, .. } := D.core3
  let { MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core4
  let { POLY_RING_CLAUSES, RIGHT_FORALL_IMP_THM, RING_CARRIER_SUBRING_GENERATED_SUBSET, .. } := D.core5
  let { RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_POW, .. } := D.core7
  let { SUBRING_GENERATED_SUBSET_CARRIER, SUBSET, SUBSET_TRANS, UNION_EMPTY, .. } := D.core8
  let { LE_TRANS, .. } := D.core10
  let { CHOOSE_SUBSET_STRONG, INFINITE_DIFF_FINITE, INFINITE_NONEMPTY,
        SUBRING_GENERATED_IDEMPOT_GEN, SUBRING_GENERATED_INSERT,
        SUBRING_GENERATED_INSERT_ZERO, SUBRING_GENERATED_SUPERSET, .. } := D.core11
  let { FIELD_EXTENSION_CARRIER, FIELD_EXTENSION_IMP_SUBSET, field_extension, .. } := BFieldExtension
  let { RING_SPAN_0, RING_SPAN_ADD, RING_SPAN_INC, RING_SPAN_MONO, RING_SPAN_MUL,
        RING_SPAN_SUBSET, .. } := BRingSpan
  let { RING_BASIS_EXISTS, RING_INDEPENDENT_IMP_SUBSET, RING_INDEPENDENT_MONO,
        ring_basis, .. } := BLinearAlgebra
  let { RING_INDEPENDENT_LE_SPAN, RING_SPAN_SUBSET_SUBRING_GENERATED, .. } := BFinitary
  let { EXTENSION_DEGREE_LE_INDEPENDENT_BOUND, FINITE_EXTENSION,
        FINITE_EXTENSION_BASIS, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, algebraic_extension, .. } := BAlgebraicExtension
  let { RING_SIMPLE_ALGEBRAIC_EXTENSION_SPAN, .. } := BAlgebraicOverBasics
  let { FINITE_FINITELY_GENERATED_ALGEBRAIC_EXTENSION,
        FINITE_SIMPLE_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { MINIMAL_POLYNOMIAL, MINIMAL_POLYNOMIAL_POWERS_HAS_SIZE, .. } := BMinimalPolynomial
  let { FINITE_FIELD_PRIMITIVE_ELEMENT, FINITE_FINITE_FIELD_EXTENSION, .. } := BFiniteExt
  let { SEPARABLE_ELEMENT_IMP_ALGEBRAIC, SEPARABLE_IMP_ALGEBRAIC_EXTENSION,
        SEPARABLE_IMP_FIELD_EXTENSION, separable_extension, .. } := BSeparableExtension
  let { SEPARABLE_EXTENSION_SIMPLE, .. } := BSeparableDegree
  let { PRIMITIVE_ELEMENT_TWO_GENERATORS, .. } := BPrimitiveTwoGenerators
  -- @@SCOPE END

  let PRIMITIVE_ELEMENT_INFINITE ← prove
   r"!(h:A->B) k l b.
        separable_extension (k,l) h /\ INFINITE(ring_carrier k) /\
        FINITE b /\ b SUBSET ring_carrier l
        ==> ?a. a IN ring_span (k,l) h b /\
                subring_generated l (a INSERT IMAGE h (ring_carrier k)) =
                subring_generated l (IMAGE h (ring_carrier k) UNION b)"
   (← do
    -- right to left: the SET_RULE, then the TAUT
    let s2 ← SET_RULE (← q r"!y:B t u. y IN t /\ t SUBSET u ==> y IN u")
    let t1 ← TAUT (← q r"p /\ ~(p /\ ~q) <=> p /\ q")
    pure (GEN_TAC THEN GEN_TAC THEN GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN REPEAT DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SEPARABLE_IMP_FIELD_EXTENSION) THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
     [DISCH_TAC THEN EXISTS_TAC (← q r"ring_0 l:B") THEN
      REWRITE_TAC [RING_SPAN_0, SUBRING_GENERATED_INSERT_ZERO, UNION_EMPTY],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"s:B->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [INSERT_SUBSET] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:B") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"(y:B) IN ring_carrier l") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_SPAN_SUBSET, SUBSET], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B", ← q r"y:B"]
      PRIMITIVE_ELEMENT_TWO_GENERATORS) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (fun th => tactic_of do
      pure ((MP_TAC o MATCH_MP INFINITE_NONEMPTY o MATCH_MP INFINITE_DIFF_FINITE)
        (← CONJ (← ASSUME (← q r"INFINITE(ring_carrier k:A->bool)")) th))) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_DIFF, IN_ELIM_THM, t1] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:A") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"ring_add l x (ring_mul l ((h:A->B) c) y)") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC RING_SPAN_ADD THEN CONJ_TAC THENL
       [MATCH_MP_TAC RING_SPAN_INC THEN ASM_REWRITE_TAC [IN_INSERT],
        MATCH_MP_TAC RING_SPAN_MUL THEN ASM_REWRITE_TAC []] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC FIELD_EXTENSION_CARRIER THEN EXISTS_TAC (← q r"k:A ring") THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC s2 THEN
        EXISTS_TAC (← q r"ring_span (k,l) (h:A->B) s") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC RING_SPAN_MONO THEN SET_TAC []],
      ONCE_REWRITE_TAC [← GSYM SUBRING_GENERATED_INSERT] THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [SUBRING_GENERATED_INSERT] THEN
      AP_TERM_TAC THEN SET_TAC []]))

  let PRIMITIVE_ELEMENT_GENSET ← prove
   r"!(h:A->B) k l b.
        separable_extension (k,l) h /\ FINITE b /\ b SUBSET ring_carrier l
        ==> ?a. a IN ring_carrier l /\
                subring_generated l (a INSERT IMAGE h (ring_carrier k)) =
                subring_generated l (IMAGE h (ring_carrier k) UNION b)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"FINITE(ring_carrier k:A->bool)") THENL
     [ALL_TAC,
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"b:B->bool"]
        PRIMITIVE_ELEMENT_INFINITE) THEN
      ASM_REWRITE_TAC [INFINITE] THEN MESON_TAC [RING_SPAN_SUBSET, SUBSET]] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SEPARABLE_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"b:B->bool"]
      FINITE_FINITELY_GENERATED_ALGEBRAIC_EXTENSION) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [SEPARABLE_IMP_ALGEBRAIC_EXTENSION, algebraic_extension,
                     SUBSET],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"IMAGE (h:A->B) (ring_carrier k) UNION b"]
      SUBRING_GENERATED_SUBSET_CARRIER) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
      FIELD_EXTENSION_IMP_SUBSET) THEN
    ABBREV_TAC
     (← q r"L = subring_generated l (IMAGE (h:A->B) (ring_carrier k) UNION b)") THEN
    ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"L:B ring"]
      FINITE_FIELD_PRIMITIVE_ELEMENT) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [FINITE_FINITE_FIELD_EXTENSION, field_extension],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:B") THEN STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"(a:B) INSERT IMAGE (h:A->B) (ring_carrier k)",
                      ← q r"IMAGE (h:A->B) (ring_carrier k) UNION b"]
      SUBRING_GENERATED_IDEMPOT_GEN) THEN
    ASM_REWRITE_TAC [INSERT_SUBSET] THEN ANTS_TAC THENL
     [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    ASM_MESON_TAC [RING_CARRIER_SUBRING_GENERATED_SUBSET, SUBSET])

  let PRIMITIVE_ELEMENT_THEOREM ← prove
   r"!(h:A->B) k l.
        finite_extension (k,l) h /\ separable_extension (k,l) h
        ==> ?a. a IN ring_carrier l /\
                subring_generated l (a INSERT IMAGE h (ring_carrier k)) = l"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [FINITE_EXTENSION]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:B->bool") STRIP_ASSUME_TAC o CONJUNCT2) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"b:B->bool"]
      PRIMITIVE_ELEMENT_GENSET) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:B") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC) THEN
    ASM_REWRITE_TAC [SUBRING_GENERATED_SUPERSET] THEN
    ASM_MESON_TAC [RING_SPAN_SUBSET_SUBRING_GENERATED, SUBSET_TRANS])

  let PRIMITIVE_ELEMENT_THEOREM_EQ ← prove
   r"!(h:A->B) k l.
        finite_extension (k,l) h /\ separable_extension (k,l) h <=>
        field_extension (k,l) h /\
        ?a. separable_element (k,l) h a /\
            subring_generated l (a INSERT IMAGE h (ring_carrier k)) = l"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [STRIP_TAC THEN ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
        PRIMITIVE_ELEMENT_THEOREM) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      ASM_MESON_TAC [separable_extension],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"a:B") STRIP_ASSUME_TAC)) THEN
      SUBGOAL_THEN (← q r"algebraic_over (k,l) (h:A->B) a") ASSUME_TAC THENL
       [ASM_MESON_TAC [SEPARABLE_ELEMENT_IMP_ALGEBRAIC, field_extension],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
        SEPARABLE_EXTENSION_SIMPLE) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
        FINITE_SIMPLE_ALGEBRAIC_EXTENSION) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC []])

  let SEPARABLE_EXTENSION_BOUNDED_DEGREE ← prove
   r"!(h:A->B) k l n.
        separable_extension(k,l) h /\
        (!x. x IN ring_carrier l
             ==> poly_deg k (minimal_polynomial(k,l) h x) <= n)
        ==> finite_extension(k,l) h /\ extension_degree(k,l) h <= n"
   (← do
    let a1 ← ARITH_RULE (← q r"~(n + 1 <= n)")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SEPARABLE_IMP_ALGEBRAIC_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN
     (← q r"!s. FINITE s /\ ring_independent(k,l) (h:A->B) s ==> CARD s <= n")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"s:B->bool") THEN STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_INDEPENDENT_IMP_SUBSET) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool"]
        PRIMITIVE_ELEMENT_GENSET) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:B") (CONJUNCTS_THEN2 ASSUME_TAC
        (MP_TAC o AP_TERM (← q r"ring_carrier:B ring->B->bool")))) THEN
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) a") ASSUME_TAC THENL
       [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
        MINIMAL_POLYNOMIAL) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
        MINIMAL_POLYNOMIAL_POWERS_HAS_SIZE) THEN
      ASM_REWRITE_TAC [] THEN
      UNDISCH_TAC
       (← q r"!x. x IN ring_carrier l
          ==> poly_deg k (minimal_polynomial(k,l) (h:A->B) x) <= n") THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:B")) THEN ASM_REWRITE_TAC [] THEN
      ABBREV_TAC (← q r"p = minimal_polynomial (k,l) (h:A->B) a") THEN
      REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A", ← q r"a:B"]
        RING_SIMPLE_ALGEBRAIC_EXTENSION_SPAN) THEN
      ASM_REWRITE_TAC [POLY_RING_CLAUSES] THEN DISCH_TAC THEN
      MATCH_MP_TAC LE_TRANS THEN EXISTS_TAC (← q r"poly_deg k (p:(1->num)->A)") THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [HAS_SIZE] o
                     check (is_binary "HAS_SIZE" o concl)) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
      MP_TAC (← ISPECL
       [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:B->bool",
        ← q r"{ring_pow l (a:B) i | i < poly_deg k (p:(1->num)->A)}"]
       RING_INDEPENDENT_LE_SPAN) THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN ASM_SIMP_TAC [RING_POW],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"IMAGE (h:A->B) (ring_carrier k) UNION s"]
        SUBRING_GENERATED_SUBSET_CARRIER) THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!s. ring_independent(k,l) (h:A->B) s ==> FINITE s /\ CARD s <= n")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"s:B->bool") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"FINITE(s:B->bool)") THEN ASM_SIMP_TAC [] THEN
      MP_TAC (← ISPECL [← q r"n + 1", ← q r"s:B->bool"] CHOOSE_SUBSET_STRONG) THEN
      ASM_REWRITE_TAC [HAS_SIZE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:B->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:B->bool")) THEN
      ASM_MESON_TAC [RING_INDEPENDENT_MONO, a1],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [FINITE_EXTENSION_BASIS] THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"] RING_BASIS_EXISTS) THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [ring_basis],
      MATCH_MP_TAC EXTENSION_DEGREE_LE_INDEPENDENT_BOUND THEN
      ASM_REWRITE_TAC []]))

  -- @@RETURN BEGIN
  return { PRIMITIVE_ELEMENT_INFINITE, PRIMITIVE_ELEMENT_GENSET,
           PRIMITIVE_ELEMENT_THEOREM, PRIMITIVE_ELEMENT_THEOREM_EQ,
           SEPARABLE_EXTENSION_BOUNDED_DEGREE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Existence of finite fields.                                               -/
/- (fieldtheory.ml 15998-16097)                                              -/
/- ------------------------------------------------------------------------- -/

structure FiniteFieldExistence where
  -- @@FIELDS
  ALGEBRAICALLY_CLOSED_FIELD_FINITE_SUBFIELD : thm
  FINITE_FIELD_EXISTS : thm
  FINITE_FIELD_EXISTS_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupFiniteFieldExistence [HolBase] (D : FieldTheoryDeps) (BSubfields : Subfields) (BSubfieldGenerated : SubfieldGenerated) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BAcfBasic : AcfBasic) (BAcfSplit : AcfSplit) (BAlgebraicClosure : AlgebraicClosure) :
    ExceptT String IO FiniteFieldExistence := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, NUMBER_RULE, .. } := D
  let { EXTENSION, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_NONTRIVIAL, HAS_SIZE, .. } := D.core2
  let { INTEGRAL_DOMAIN_MUL_LCANCEL, IN_ELIM_THM, IN_INSERT, ISOMORPHIC_RING_FIELDNESS,
        LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { MONO_EXISTS, .. } := D.core4
  let { RING_0, RING_1, .. } := D.core5
  let { RING_MUL_RID, RING_POW, .. } := D.core7
  let { ring_pow, .. } := D.core9
  let { DIVIDES_0, DIVIDES_REFL, EXP_EQ_0, PRIME_IMP_NZ, RING_CHAR_MONOMORPHIC_IMAGE,
        RING_ENDOMORPHISM_FROBENIUS_ITERATE, .. } := D.core10
  let { CARD_EQ_CARD, DIVIDES_ONE, DIVIDES_REXP, DIVIDES_SUB_1, FIELD_INTEGER_MOD_RING,
        HAS_SIZE_CLAUSES, INTEGER_MOD_RING_CHAR, ISOMORPHIC_COPY_OF_RING, NOT_SUC,
        PRIME_1, RING_POW_ZERO, .. } := D.core11
  let { SUBFIELD_OF_FIXPOINTS, .. } := BSubfields
  let { CARRIER_SUBFIELD_GENERATED_SUBFIELD, FIELD_SUBFIELD_GENERATED, .. } := BSubfieldGenerated
  let { field_extension, .. } := BFieldExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, .. } := BAlgebraicExtension
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ALGEBRAICALLY_CLOSED_FIELD_PRIMITIVE_ROOT_OF_UNITY, .. } := BAcfSplit
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  -- @@SCOPE END

  let ALGEBRAICALLY_CLOSED_FIELD_FINITE_SUBFIELD ← prove
   r"!(r:A ring) n.
        algebraically_closed_field r /\ prime(ring_char r) /\ ~(n = 0)
        ==> {x | x IN ring_carrier r /\ ring_pow r x (ring_char r EXP n) = x}
            subfield_of r /\
            {x | x IN ring_carrier r /\ ring_pow r x (ring_char r EXP n) = x}
            HAS_SIZE (ring_char r EXP n)"
   (← do
    -- right to left: the MESON, the ARITH_RULE, then the NUMBER_RULE
    let m3 ← MESON [HAS_SIZE_CLAUSES]
     (← q r"!s t (a:A) m. ~(a IN t) /\ s = a INSERT t
                  ==> t HAS_SIZE m ==> s HAS_SIZE SUC m")
    let a2 ← ARITH_RULE (← q r"~(m = 0) ==> m = SUC(m - 1)")
    let n1 ← NUMBER_RULE
     (← q r"!x. (x:num == 1) (mod p) /\ p divides x ==> p divides 1")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"r:A ring", ← q r"\x:A. ring_pow r x (ring_char r EXP n)"]
        SUBFIELD_OF_FIXPOINTS) THEN
      ASM_SIMP_TAC [RING_ENDOMORPHISM_FROBENIUS_ITERATE],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"r:A ring", ← q r"ring_char(r:A ring) EXP n - 1"]
      ALGEBRAICALLY_CLOSED_FIELD_PRIMITIVE_ROOT_OF_UNITY) THEN
    ABBREV_TAC (← q r"p = ring_char(r:A ring)") THEN
    SUBGOAL_THEN (← q r"~(p divides p EXP n - 1)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [DIVIDES_SUB_1, EXP_EQ_0, PRIME_IMP_NZ] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"p divides 1") MP_TAC THENL
       [MATCH_MP_TAC n1 THEN
        EXISTS_TAC (← q r"p EXP n") THEN ASM_SIMP_TAC [DIVIDES_REXP, DIVIDES_REFL],
        ASM_MESON_TAC [DIVIDES_ONE, PRIME_1]],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    SUBGOAL_THEN (← q r"p EXP n = SUC(p EXP n - 1)") MP_TAC THENL
     [MATCH_MP_TAC a2 THEN
      ASM_SIMP_TAC [EXP_EQ_0, PRIME_IMP_NZ],
      ABBREV_TAC (← q r"m = p EXP n - 1") THEN DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC m3 THEN
    EXISTS_TAC (← q r"ring_0 r:A") THEN
    REWRITE_TAC [IN_ELIM_THM, RING_POW_ZERO, EXTENSION, IN_INSERT] THEN
    CONJ_TAC THENL
     [COND_CASES_TAC THEN ASM_SIMP_TAC [FIELD_NONTRIVIAL] THEN
      ASM_MESON_TAC [DIVIDES_0],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:A") THEN
    ASM_CASES_TAC (← q r"x:A = ring_0 r") THEN
    ASM_REWRITE_TAC [RING_0, RING_POW_ZERO, NOT_SUC] THEN
    ASM_CASES_TAC (← q r"(x:A) IN ring_carrier r") THEN ASM_REWRITE_TAC [ring_pow] THEN
    EQ_TAC THEN DISCH_TAC THEN ASM_SIMP_TAC [RING_MUL_RID] THEN
    MATCH_MP_TAC (← ISPEC (← q r"r:A ring") INTEGRAL_DOMAIN_MUL_LCANCEL) THEN
    EXISTS_TAC (← q r"x:A") THEN
    ASM_SIMP_TAC [RING_POW, RING_1, RING_MUL_RID, FIELD_IMP_INTEGRAL_DOMAIN]))

  let FINITE_FIELD_EXISTS ← prove
   r"!p n. prime p /\ ~(n = 0)
         ==> ?k:(int#num)ring. field k /\ ring_carrier k HAS_SIZE (p EXP n)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"integer_mod_ring p") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [FIELD_INTEGER_MOD_RING, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"r:(int#num)ring", ← q r"f:int->int#num"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"ring_char(r:(int#num)ring) = p") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
      REWRITE_TAC [field_extension] THEN
      MESON_TAC [RING_CHAR_MONOMORPHIC_IMAGE, INTEGER_MOD_RING_CHAR],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"r:(int#num)ring", ← q r"n:num"]
      ALGEBRAICALLY_CLOSED_FIELD_FINITE_SUBFIELD) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"subfield_generated r
     {x:int#num | x IN ring_carrier r /\ ring_pow r x (p EXP n) = x}") THEN
    ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED, CARRIER_SUBFIELD_GENERATED_SUBFIELD,
                  ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD])

  let FINITE_FIELD_EXISTS_GEN ← prove
   r"!p n (s:A->bool).
        prime p /\ ~(n = 0) /\ s HAS_SIZE p EXP n
        ==> ?k. field k /\ ring_carrier k = s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"p:num", ← q r"n:num"] FINITE_FIELD_EXISTS) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:(int#num)ring") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"k:(int#num)ring", ← q r"s:A->bool"] ISOMORPHIC_COPY_OF_RING) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
    ASM_SIMP_TAC [CARD_EQ_CARD] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [ISOMORPHIC_RING_FIELDNESS])

  -- @@RETURN BEGIN
  return { ALGEBRAICALLY_CLOSED_FIELD_FINITE_SUBFIELD, FINITE_FIELD_EXISTS,
           FINITE_FIELD_EXISTS_GEN }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The polynomials X^n - X and X^n - c.                                      -/
/- (fieldtheory.ml 16099-16255)                                              -/
/- ------------------------------------------------------------------------- -/

structure VarPowSub where
  -- @@FIELDS
  POLY_VAR_POW_SUB_VAR : thm
  POLY_EVAL_VAR_POW_SUB_VAR : thm
  MONIC_VAR_POW_SUB_VAR : thm
  POLY_SEPARABLE_VAR_POW_SUB_VAR : thm
  POLY_SEPARABLE_VAR_POW_SUB_CONST : thm
  deriving Inhabited

@[nospecialize]
def setupVarPowSub [HolBase] (D : FieldTheoryDeps) :
    ExceptT String IO VarPowSub := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, RING_RULE, .. } := D
  let { FIELD_MUL_RINV, .. } := D.core2
  let { IMP_IMP, IN_ELIM_THM, .. } := D.core3
  let { PID_IMP_BEZOUT_RING, PID_POLY_RING, POLY_CLAUSES, POLY_CONST, POLY_CONST_1,
        POLY_DEG_0, .. } := D.core4
  let { POLY_EXTEND_EVALUATE, POLY_EXTEND_SUB, POLY_EXTEND_VAR, POLY_RING,
        POLY_VAR_UNIV, RING_1, .. } := D.core5
  let { RING_INV, RING_MUL, .. } := D.core6
  let { RING_NEG, RING_OF_NUM_EQ_0, RING_POLYNOMIAL, RING_POLYNOMIAL_CONST,
        RING_POLYNOMIAL_IMP_POWERSERIES, RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_VAR,
        RING_POW, RING_POWERSERIES_VAR, RING_SUB, RING_SUB_RZERO, .. } := D.core7
  let { poly_eval, ring_sub, .. } := D.core9
  let { BEZOUT_RING_COPRIME, COEFF_POLY_SUB, COEFF_POLY_VAR, COEFF_POLY_VARPOW,
        DIVIDES_0, LE_1, POLY_DEG_VAR_POW, POLY_EXTEND_VARPOW, .. } := D.core10
  let { POLY_CONST_MUL, POLY_DEG_SUB, POLY_DEG_VAR, POLY_DERIV_CONST, POLY_DERIV_SUB,
        POLY_DERIV_VAR, POLY_DERIV_VAR_POW, POLY_DERIV_VAR_POW_ZERO, POLY_POW_ALT,
        POLY_SUB, RING_COPRIME_UNIT, RING_OF_NUM, RING_POLYNOMIAL_POW,
        RING_POWERSERIES_POW, RING_POW_1, RING_POW_ADD, RING_SUB_LZERO, RING_UNIT_1,
        RING_UNIT_NEG, SUB_ADD, monic, poly_separable, .. } := D.core11
  -- @@SCOPE END

  let POLY_VAR_POW_SUB_VAR ← prove
   r"!(r:A ring) n.
        ~(ring_1 r = ring_0 r) /\ 2 <= n
        ==> poly_sub r (poly_pow r (poly_var r one) n) (poly_var r one) IN
            ring_carrier(poly_ring r (:1)) /\
            poly_deg r (poly_sub r (poly_pow r (poly_var r one) n)
                                   (poly_var r one)) = n /\
            ~(poly_sub r (poly_pow r (poly_var r one) n) (poly_var r one) =
              poly_0 r)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN
    SUBGOAL_THEN
     (← q r"poly_deg r (poly_sub r (poly_pow r (poly_var r one) n) (poly_var r one)
                :(1->num)->A) = n")
    ASSUME_TAC THENL
     [wPart lhand (fun t => do lhand (← rand t)) POLY_DEG_SUB THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR,
                    POLY_DEG_VAR_POW, POLY_DEG_VAR] THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC THEN ASM_ARITH_TAC],
      ASM_SIMP_TAC [RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_POW,
                    RING_POLYNOMIAL_VAR] THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"poly_deg (r:A ring):((1->num)->A)->num")) THEN
      ASM_REWRITE_TAC [POLY_DEG_0] THEN ASM_ARITH_TAC])

  let POLY_EVAL_VAR_POW_SUB_VAR ← prove
   r"!(h:A->B) k l n x.
        ring_homomorphism(k,l) h /\ x IN ring_carrier l
        ==> poly_eval l (h o poly_sub k (poly_pow k (poly_var k one) n)
                                        (poly_var k one)) x =
            ring_sub l (ring_pow l x n) x"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_eval] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP POLY_EXTEND_EVALUATE th)])) THEN
    ASM_SIMP_TAC [POLY_EXTEND_SUB, POLY_EXTEND_VARPOW, POLY_EXTEND_VAR,
                  RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR])

  let MONIC_VAR_POW_SUB_VAR ← prove
   r"!(r:A ring) n.
        ~(ring_1 r = ring_0 r) /\ 2 <= n
        ==> monic r (poly_sub r (poly_pow r (poly_var r one) n)
                                (poly_var r one))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [monic] THEN
    MP_TAC (← ISPECL [← q r"r:A ring", ← q r"n:num"] POLY_VAR_POW_SUB_VAR) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [COEFF_POLY_SUB, COEFF_POLY_VARPOW, COEFF_POLY_VAR] THEN
    COND_CASES_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    SIMP_TAC [RING_SUB_RZERO, RING_1])

  let POLY_SEPARABLE_VAR_POW_SUB_VAR ← prove
   r"!(r:A ring) n.
        ring_char r divides n
        ==> poly_separable r
              (poly_sub r (poly_pow r (poly_var r one) n) (poly_var r one))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [poly_separable] THEN
    SIMP_TAC [POLY_DERIV_SUB, RING_POWERSERIES_POW, RING_POWERSERIES_VAR] THEN
    ASM_SIMP_TAC [POLY_DERIV_VAR_POW_ZERO, POLY_DERIV_VAR, POLY_CONST_1] THEN
    MATCH_MP_TAC (← CONJUNCT2 RING_COPRIME_UNIT) THEN
    REWRITE_TAC [POLY_CLAUSES] THEN
    SIMP_TAC [RING_SUB_LZERO, RING_1, RING_UNIT_NEG, RING_UNIT_1] THEN
    REWRITE_TAC [← GSYM POLY_CLAUSES, ← GSYM RING_POLYNOMIAL] THEN
    SIMP_TAC [RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR])

  let POLY_SEPARABLE_VAR_POW_SUB_CONST ← prove
   r"!(r:A ring) n c.
        field r /\ ~(ring_char r divides n) /\
        c IN ring_carrier r /\ ~(c = ring_0 r)
        ==> poly_separable r
             (poly_sub r (poly_pow r (poly_var r one) n) (poly_const r c))"
   (← do
    let r1 ← RING_RULE
     (← q r"ring_mul (R:Z ring) a b = ring_1 R /\ ring_mul R m w = ring_1 R
      ==> ring_add R (ring_mul R (ring_sub R (ring_mul R y x) a)
                                  (ring_neg R b))
                     (ring_mul R (ring_mul R m y)
                                 (ring_mul R (ring_mul R b w) x)) =
          ring_1 R")
    let el (i : Nat) : ExceptT String IO thm :=
      match (CONJUNCTS POLY_RING)[i]? with
      | some c => pure c
      | none => throw "el"
    pure (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(n = 0)") ASSUME_TAC THENL
     [DISCH_THEN SUBST_ALL_TAC THEN ASM_MESON_TAC [DIVIDES_0], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(ring_of_num r n:A = ring_0 r)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [RING_OF_NUM_EQ_0], ALL_TAC] THEN
    REWRITE_TAC [poly_separable] THEN
    MP_TAC (← ISPECL [← q r"poly_ring (r:A ring) (:1)"] BEZOUT_RING_COPRIME) THEN
    ASM_SIMP_TAC [PID_POLY_RING, PID_IMP_BEZOUT_RING] THEN
    DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
    SUBGOAL_THEN
     (← q r"!p q. poly_sub (r:A ring) p q = ring_sub (poly_ring r (:1)) p q")
    ASSUME_TAC THENL
     [REWRITE_TAC [ring_sub, POLY_RING, POLY_SUB], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"poly_deriv r (poly_sub r (poly_pow r (poly_var r one) n) (poly_const r c))
    = ring_mul (poly_ring r (:1)) (poly_const r (ring_of_num r n))
               (ring_pow (poly_ring r (:1)) (poly_var r one) (n - 1)):
      (1->num)->A")
    SUBST1_TAC THENL
     [wPart lhand (fun t => do lhand (← rand t)) POLY_DERIV_SUB THEN
      ANTS_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC RING_POLYNOMIAL_IMP_POWERSERIES THENL
         [MP_TAC (← ISPECL [← q r"poly_ring (r:A ring) (:1)", ← q r"poly_var (r:A ring) one",
                            ← q r"n:num"] RING_POW) THEN
          REWRITE_TAC [POLY_VAR_UNIV, ← GSYM POLY_POW_ALT] THEN
          SIMP_TAC [POLY_RING, IN_ELIM_THM],
          ASM_REWRITE_TAC [RING_POLYNOMIAL_CONST]],
        DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [POLY_DERIV_VAR_POW, POLY_DERIV_CONST, POLY_POW_ALT] THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← SYM (← ISPECL [← q r"r:A ring", ← q r"(:1)"] (← el 5)),
                   ← SYM (← ISPECL [← q r"r:A ring", ← q r"(:1)"] (← el 1))]
      THEN MATCH_MP_TAC RING_SUB_RZERO THEN MATCH_MP_TAC RING_MUL THEN
      SIMP_TAC [RING_POW, POLY_VAR_UNIV, POLY_CONST, RING_OF_NUM],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [POLY_POW_ALT] THEN
    SUBGOAL_THEN
     (← q r"!a b:A. a IN ring_carrier r /\ b IN ring_carrier r /\
            ring_mul r a b = ring_1 r
            ==> ring_mul (poly_ring r (:1)) (poly_const r a) (poly_const r b) =
                ring_1 (poly_ring r (:1))")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      REWRITE_TAC [← ISPECL [← q r"r:A ring", ← q r"(:1)"] (← el 5),
                   ← ISPECL [← q r"r:A ring", ← q r"(:1)"] (← el 2)] THEN
      ASM_SIMP_TAC [← GSYM POLY_CONST_MUL, POLY_CONST_1],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_pow (poly_ring r (:1)) (poly_var r one) n:(1->num)->A =
    ring_mul (poly_ring r (:1))
     (ring_pow (poly_ring r (:1)) (poly_var r one) (n - 1)) (poly_var r one)")
    SUBST1_TAC THENL
     [MP_TAC (← ISPECL [← q r"poly_ring (r:A ring) (:1)", ← q r"poly_var (r:A ring) one",
                        ← q r"n - 1", ← q r"1"] RING_POW_ADD) THEN
      ASM_SIMP_TAC [SUB_ADD, LE_1, POLY_VAR_UNIV, RING_POW_1],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a:A. a IN ring_carrier r
          ==> poly_const r a IN ring_carrier(poly_ring r (:1))")
    ASSUME_TAC THENL [REWRITE_TAC [POLY_CONST], ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [RING_SUB, RING_MUL, RING_POW, POLY_VAR_UNIV],
      ASM_SIMP_TAC [RING_MUL, RING_POW, POLY_VAR_UNIV, RING_OF_NUM],
      ALL_TAC] THEN
    EXISTS_TAC
     (← q r"ring_neg (poly_ring r (:1)) (poly_const r (ring_inv r c)):(1->num)->A") THEN
    EXISTS_TAC
     (← q r"ring_mul (poly_ring r (:1))
     (ring_mul (poly_ring r (:1)) (poly_const r (ring_inv r c))
       (poly_const r (ring_inv r (ring_of_num r n)))) (poly_var r one):
    (1->num)->A") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC RING_NEG THEN FIRST_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [RING_INV],
      MATCH_MP_TAC RING_MUL THEN REWRITE_TAC [POLY_VAR_UNIV] THEN
      MATCH_MP_TAC RING_MUL THEN CONJ_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [RING_INV, RING_OF_NUM],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] (← GEN_ALL r1)) THEN
      REPEAT CONJ_TAC THEN ASM_SIMP_TAC [RING_POW, POLY_VAR_UNIV] THEN
      FIRST_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [RING_INV, RING_OF_NUM, FIELD_MUL_RINV]]))

  -- @@RETURN BEGIN
  return { POLY_VAR_POW_SUB_VAR, POLY_EVAL_VAR_POW_SUB_VAR, MONIC_VAR_POW_SUB_VAR,
           POLY_SEPARABLE_VAR_POW_SUB_VAR, POLY_SEPARABLE_VAR_POW_SUB_CONST }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Kummer roots; finite fields are splitting extensions of X^q - X, and two  -/
/- finite fields of the same size are isomorphic.                            -/
/- (fieldtheory.ml 16257-16380)                                              -/
/- ------------------------------------------------------------------------- -/

structure FiniteFieldUniqueness where
  -- @@FIELDS
  KUMMER_ROOTS_SEPARABLY_CLOSED : thm
  FINITE_FIELD_SPLITTING_EXTENSION : thm
  ISOMORPHIC_FINITE_FIELDS : thm
  deriving Inhabited

@[nospecialize]
def setupFiniteFieldUniqueness [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated : SubfieldGenerated) (BSubfieldGenerated1 : SubfieldGenerated1) (BSubfieldQuotients : SubfieldQuotients) (BFieldExtension : FieldExtension) (BFiniteExt : FiniteExt) (BFiniteFieldSubfields : FiniteFieldSubfields) (BSplittingExtension : SplittingExtension) (BSplittingUnique : SplittingUnique) (BSeparableRoots : SeparableRoots) (BVarPowSub : VarPowSub) :
    ExceptT String IO FiniteFieldUniqueness := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, .. } := D
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING, FIELD_NONTRIVIAL,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FORALL_IN_IMAGE, HAS_SIZE, .. } := D.core2
  let { I_O_ID, I_THM, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { MONO_EXISTS, .. } := D.core4
  let { RING_0, .. } := D.core5
  let { RING_HOMOMORPHISM_0, RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_POW, RING_SUB_EQ_0, RING_SUB_REFL, .. } := D.core7
  let { SUBSET, .. } := D.core8
  let { ring_monomorphism, .. } := D.core9
  let { DIVIDES_PRIME_PRIME, FINITE_INTEGRAL_DOMAIN_CHAR, PRIME_DIVEXP,
        RING_CHAR_DIVIDES_ORDER, RING_CHAR_MONOMORPHIC_IMAGE, RING_HOMOMORPHISM_I,
        RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { FINITE_FIELD_CARD_GE_2, POLY_EVAL_VAR_POW_SUB_CONST, POLY_VAR_POW_SUB_CONST,
        ROOTS_OF_UNITY_HAS_SIZE_IMP_CHAR, ROOTS_OF_UNITY_HAS_SIZE_NONZERO, .. } := D.core11
  let { FIELD_SUBFIELD_GENERATED, .. } := BSubfieldGenerated
  let { SUBFIELD_GENERATED_RING_CARRIER, .. } := BSubfieldGenerated1
  let { PRIME_SUBFIELD_HOMOMORPHISM_EXISTS, .. } := BSubfieldQuotients
  let { FIELD_EXTENSION_SUBFIELD_GENERATED, field_extension, .. } := BFieldExtension
  let { FINITE_INTEGRAL_DOMAIN_SIZE, .. } := BFiniteExt
  let { FINITE_INTEGRAL_DOMAIN_POW_CARD, .. } := BFiniteFieldSubfields
  let { splitting_extension, .. } := BSplittingExtension
  let { SPLITTING_EXTENSION_UNIQUE, .. } := BSplittingUnique
  let { POLY_SPLITS_OVER_DISTINCT_ROOTS, .. } := BSeparableRoots
  let { POLY_EVAL_VAR_POW_SUB_VAR, POLY_SEPARABLE_VAR_POW_SUB_CONST,
        POLY_VAR_POW_SUB_VAR, .. } := BVarPowSub
  -- @@SCOPE END

  let KUMMER_ROOTS_SEPARABLY_CLOSED ← prove
   r"!(h:A->B) k l n.
        field_extension(k,l) h /\
        {x | x IN ring_carrier k /\ ring_pow k x n = ring_1 k} HAS_SIZE n /\
        (!p. p IN ring_carrier(poly_ring l (:1)) /\ poly_separable l p /\
             ~(poly_deg l p = 0)
             ==> ?x. x IN ring_carrier l /\ poly_eval l p x = ring_0 l)
        ==> ~(n = 0) /\
            !a. a IN ring_carrier k /\ ~(a = ring_0 k)
                ==> ?b. b IN ring_carrier l /\ ring_pow l b n = h a"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [ring_monomorphism]) THEN
    SUBGOAL_THEN (← q r"~(n = 0)") ASSUME_TAC THENL
     [ASM_MESON_TAC [ROOTS_OF_UNITY_HAS_SIZE_NONZERO], ASM_REWRITE_TAC []] THEN
    SUBGOAL_THEN (← q r"~(ring_char(l:B ring) divides n)") ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"ring_char(l:B ring) = ring_char(k:A ring)") SUBST1_TAC THENL
       [CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_CHAR_MONOMORPHIC_IMAGE THEN
        EXISTS_TAC (← q r"h:A->B") THEN ASM_REWRITE_TAC [],
        MATCH_MP_TAC ROOTS_OF_UNITY_HAS_SIZE_IMP_CHAR THEN
        ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN]],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(h:A->B) a IN ring_carrier l /\ ~(h a = ring_0 l)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER, RING_HOMOMORPHISM_0, RING_0],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"poly_sub l (poly_pow l (poly_var l one) n) (poly_const l ((h:A->B) a))"))
    THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [POLY_SEPARABLE_VAR_POW_SUB_CONST] THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"n:num", ← q r"(h:A->B) a"]
                    POLY_VAR_POW_SUB_CONST) THEN
      ASM_SIMP_TAC [FIELD_NONTRIVIAL],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:B") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"l:B ring", ← q r"l:B ring", ← q r"n:num", ← q r"(h:A->B) a",
                        ← q r"b:B"] POLY_EVAL_VAR_POW_SUB_CONST) THEN
      ASM_REWRITE_TAC [RING_HOMOMORPHISM_I, I_O_ID, I_THM] THEN
      DISCH_THEN (MP_TAC o SYM) THEN ASM_SIMP_TAC [RING_SUB_EQ_0, RING_POW]])

  let FINITE_FIELD_SPLITTING_EXTENSION ← prove
   r"!(h:A->B) k l.
        field_extension(k,l) h /\ FINITE(ring_carrier l)
        ==> splitting_extension(k,l) h
              (poly_sub k (poly_pow k (poly_var k one) (CARD(ring_carrier l)))
                          (poly_var k one)) /\
            poly_separable k
              (poly_sub k (poly_pow k (poly_var k one) (CARD(ring_carrier l)))
                          (poly_var k one))"
   (← do
    -- right to left: the SET_RULE, then the MESON
    let s2 ← SET_RULE (← q r"(s:B->bool) SUBSET t ==> s UNION t = t")
    let m1 ← MESON [SUBFIELD_GENERATED_RING_CARRIER]
     (← q r"s = ring_carrier l ==> subfield_generated l s = l:B ring")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    ABBREV_TAC (← q r"q = CARD(ring_carrier(l:B ring))") THEN
    ABBREV_TAC
     (← q r"p = poly_sub k (poly_pow k (poly_var k one) q) (poly_var k one)
        :(1->num)->A") THEN
    SUBGOAL_THEN (← q r"2 <= q") ASSUME_TAC THENL
     [EXPAND_TAC "q" THEN ASM_SIMP_TAC [FINITE_FIELD_CARD_GE_2], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"q:num"] POLY_VAR_POW_SUB_VAR) THEN
    ASM_SIMP_TAC [FIELD_NONTRIVIAL] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A",
                      ← q r"ring_carrier l:B->bool"] POLY_SPLITS_OVER_DISTINCT_ROOTS) THEN
    ASM_REWRITE_TAC [HAS_SIZE] THEN ANTS_TAC THENL
     [EXPAND_TAC "p" THEN ASM_SIMP_TAC [POLY_EVAL_VAR_POW_SUB_VAR] THEN
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"x:B"] FINITE_INTEGRAL_DOMAIN_POW_CARD) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, RING_SUB_REFL],
      STRIP_TAC THEN ASM_REWRITE_TAC [splitting_extension]] THEN
    MATCH_MP_TAC m1 THEN
    MATCH_MP_TAC s2 THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER]))

  let ISOMORPHIC_FINITE_FIELDS ← prove
   r"!(k:A ring) (l:B ring).
        field k /\ field l /\
        FINITE(ring_carrier k) /\ FINITE(ring_carrier l) /\
        CARD(ring_carrier k) = CARD(ring_carrier l)
        ==> k isomorphic_ring l"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"ring_char(k:A ring) = ring_char(l:B ring)") ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"k:A ring") FINITE_INTEGRAL_DOMAIN_SIZE) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"p:num", ← q r"m:num"] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"ring_char(k:A ring) divides p EXP m /\
      ring_char(l:B ring) divides p EXP m")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [RING_CHAR_DIVIDES_ORDER], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"prime(ring_char(k:A ring)) /\ prime(ring_char(l:B ring))")
      STRIP_ASSUME_TAC THENL
       [ASM_SIMP_TAC [FINITE_INTEGRAL_DOMAIN_CHAR, FIELD_IMP_INTEGRAL_DOMAIN],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"ring_char(k:A ring) = p /\ ring_char(l:B ring) = p")
       (fun th => REWRITE_TAC [th]) THEN
      ASM_MESON_TAC [PRIME_DIVEXP, DIVIDES_PRIME_PRIME],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring"]
      PRIME_SUBFIELD_HOMOMORPHISM_EXISTS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"j:A->B")) THEN
    ABBREV_TAC (← q r"k0 = subfield_generated k {ring_0 k:A}") THEN
    MP_TAC (← ISPECL
     [← q r"I:A->A", ← q r"j:A->B", ← q r"k0:A ring", ← q r"k:A ring", ← q r"l:B ring",
      ← q r"poly_sub k0 (poly_pow k0 (poly_var k0 one) (CARD(ring_carrier(k:A ring))))
                 (poly_var k0 one):(1->num)->A"]
     SPLITTING_EXTENSION_UNIQUE) THEN
    DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"I:A->A", ← q r"k0:A ring", ← q r"k:A ring"]
        FINITE_FIELD_SPLITTING_EXTENSION) THEN
      EXPAND_TAC "k0" THEN ASM_SIMP_TAC [FIELD_EXTENSION_SUBFIELD_GENERATED],
      MP_TAC (← ISPECL [← q r"j:A->B", ← q r"k0:A ring", ← q r"l:B ring"]
        FINITE_FIELD_SPLITTING_EXTENSION) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      SUBGOAL_THEN (← q r"field(k0:A ring)") ASSUME_TAC THENL
       [EXPAND_TAC "k0" THEN ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED],
        ALL_TAC] THEN
      ASM_REWRITE_TAC [field_extension] THEN
      MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING]])

  -- @@RETURN BEGIN
  return { KUMMER_ROOTS_SEPARABLY_CLOSED, FINITE_FIELD_SPLITTING_EXTENSION,
           ISOMORPHIC_FINITE_FIELDS }
  -- @@RETURN END

end HolLibrary.FieldTheory
