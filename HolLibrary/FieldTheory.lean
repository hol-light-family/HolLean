       [ASM_MESON_TAC [SPLITTING_IMP_FIELD_EXTENSION], ALL_TAC] THEN
      MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
       [← q r"I:B->B", ← q r"I:B->B", ← q r"k:B ring", ← q r"K:B ring", ← q r"l:B ring"]
       EXTENSION_DEGREE_TOWER_LAW)) THEN
      MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
       [← q r"I:B->B", ← q r"I:B->B", ← q r"K:B ring", ← q r"L:B ring", ← q r"l:B ring"]
       EXTENSION_DEGREE_TOWER_LAW)) THEN
      ASM_SIMP_TAC [FINITE_IMP_FIELD_EXTENSION] THEN DISCH_THEN ((K ALL_TAC : thm → tactic)) THEN
      DISCH_THEN SUBST1_TAC THEN
      SUBGOAL_THEN (← q r"FACT n = n * FACT(n - 1)") SUBST1_TAC THENL
       [MP_TAC (← SPEC (← q r"n - 1") (← CONJUNCT2 FACT)) THEN
        SUBGOAL_THEN (← q r"SUC(n - 1) = n") (fun th => REWRITE_TAC [th]) THEN
        ASM_ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC DIVIDES_MUL2 THEN REWRITE_TAC [DIVIDES_REFL] THEN
      MATCH_MP_TAC lm3 THEN
      CONJ_TAC THENL
       [REMOVE_THEN "ih" (MP_TAC o SPEC (← q r"1")) THEN
        CONV_TAC (ONCE_DEPTH_CONV NUM_FACT_CONV) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN MATCH_MP_TAC] THEN
        EXISTS_TAC (← q r"poly_sub K (poly_var K one) (poly_const K (a:B))") THEN
        ASM_REWRITE_TAC [],
        REMOVE_THEN "ih" (MP_TAC o SPEC (← q r"n - 1")) THEN ANTS_TAC THENL
         [ASM_ARITH_TAC, DISCH_THEN MATCH_MP_TAC] THEN
        EXISTS_TAC (← q r"q:(1->num)->B") THEN ASM_REWRITE_TAC []])
    let s1 ← SET_RULE (← q r"(t:B->bool) SUBSET s ==> s UNION t = s")
    prove
     r"!(h:A->B) k l p.
        splitting_extension(k,l) h p
        ==> extension_degree(k,l) h divides FACT(poly_deg k p)"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_IMP_FIELD_EXTENSION) THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
        RING_ISOMORPHISM_ONTO_SUBFIELD_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (ASSUME_TAC o CONJUNCT1) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A",
                        ← q r"ring_carrier l:B->bool", ← q r"IMAGE (h:A->B) (ring_carrier k)"]
        SPLITTING_EXTENSION_LIFT) THEN
      ASM_REWRITE_TAC [SUBFIELD_GENERATED_RING_CARRIER, CARRIER_SUBFIELD_OF,
                       SUBSET_REFL] THEN
      SUBGOAL_THEN
       (← q r"ring_carrier l UNION IMAGE (h:A->B) (ring_carrier k) = ring_carrier l")
      SUBST1_TAC THENL
       [ASM_MESON_TAC [FIELD_EXTENSION_IMP_SUBSET, s1],
        REWRITE_TAC [SUBFIELD_GENERATED_RING_CARRIER] THEN DISCH_TAC] THEN
      MP_TAC (← ISPECL [← q r"poly_deg k (p:(1->num)->A)",
                        ← q r"subfield_generated l (IMAGE (h:A->B) (ring_carrier k))",
                        ← q r"l:B ring", ← q r"(h:A->B) o (p:(1->num)->A)"] lemma) THEN
      ASM_REWRITE_TAC [POLY_DEG_SUBFIELD_GENERATED] THEN ANTS_TAC THENL
       [MATCH_MP_TAC POLY_DEG_MONOMORPHIC_IMAGE THEN
        ASM_MESON_TAC [splitting_extension, RING_POLYNOMIAL],
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        MATCH_MP_TAC EXTENSION_DEGREE_EQ_IMAGE THEN
        ASM_SIMP_TAC [CARRIER_SUBFIELD_GENERATED_SUBFIELD, IMAGE_I]]))

  let SPLITTING_EXTENSION_EXISTS_ID ← prove
   r"!(k:A ring) p.
        field k /\ p IN ring_carrier(poly_ring k (:1)) /\ ~(p = poly_0 k) /\
        ring_carrier k <_c (:A) /\ (:num) <_c (:A)
        ==> ?l. splitting_extension(k,l) I p"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"k:A ring") ALGEBRAIC_CLOSURE_EXISTS_ID) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"om:A ring") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"field_extension(k:A ring,om) I") ASSUME_TAC THENL
     [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
    EXISTS_TAC
     (← q r"subfield_generated om
         (IMAGE (I:A->A) (ring_carrier k) UNION
          {x | x IN ring_carrier om /\
               poly_eval om ((I:A->A) o p) x = ring_0 om}):A ring") THEN
    MATCH_MP_TAC SPLITTING_EXTENSION_GENERATED_BY_ROOTS THEN
    ASM_REWRITE_TAC [poly_splits_over] THEN
    MATCH_MP_TAC ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
    EXISTS_TAC (← q r"k:A ring") THEN
    ASM_MESON_TAC [field_extension, ring_monomorphism])

  let SPLITTING_EXTENSION_EXISTS ← prove
   r"!(k:A ring) p.
        field k /\ p IN ring_carrier(poly_ring k (:1)) /\ ~(p = poly_0 k) /\
        INFINITE(:B) /\ ring_carrier k <=_c (:B)
        ==> ?(l:B ring) h. splitting_extension(k,l) h p"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPEC (← q r"k:A ring") ALGEBRAIC_CLOSURE_EXISTS) THEN
    ASM_REWRITE_TAC [algebraic_extension, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"om:B ring", ← q r"h:A->B"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"subfield_generated om
         (IMAGE (h:A->B) (ring_carrier k) UNION
          {x | x IN ring_carrier om /\ poly_eval om (h o p) x = ring_0 om})") THEN
    EXISTS_TAC (← q r"h:A->B") THEN
    MATCH_MP_TAC SPLITTING_EXTENSION_GENERATED_BY_ROOTS THEN
    ASM_REWRITE_TAC [poly_splits_over] THEN
    MATCH_MP_TAC ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS THEN
    ASM_MESON_TAC [IN_RING_POLYNOMIAL_CARRIER_COMPOSE,
                   FIELD_EXTENSION_IMP_HOMOMORPHISM])

  let SPLITTING_EXTENSION_EXISTS_BIGENOUGH ← prove
   r"!(k:A ring) p.
        field k /\ p IN ring_carrier(poly_ring k (:1)) /\ ~(p = poly_0 k)
        ==> ?l (h:A->A#num). splitting_extension(k,l) h p"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"k:A ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [algebraic_extension, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"om:(A#num)ring", ← q r"h:A->A#num"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"subfield_generated om
         (IMAGE (h:A->A#num) (ring_carrier k) UNION
          {x | x IN ring_carrier om /\ poly_eval om (h o p) x = ring_0 om})") THEN
    EXISTS_TAC (← q r"h:A->A#num") THEN
    MATCH_MP_TAC SPLITTING_EXTENSION_GENERATED_BY_ROOTS THEN
    ASM_REWRITE_TAC [poly_splits_over] THEN
    MATCH_MP_TAC ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS THEN
    ASM_MESON_TAC [IN_RING_POLYNOMIAL_CARRIER_COMPOSE,
                   FIELD_EXTENSION_IMP_HOMOMORPHISM])

  let SPLITTING_EXTENSION_IMAGE ← prove
   r"!(h:A->B) (f:B->C) k l m p.
        splitting_extension(k,l) h p /\ field_extension(l,m) f
        ==> IMAGE f (ring_carrier l) =
            ring_carrier(subfield_generated m
              (IMAGE (f o h) (ring_carrier k) UNION
               {x | x IN ring_carrier m /\
                    poly_eval m ((f o h) o p) x = ring_0 m}))"
   (REWRITE_TAC [splitting_extension, poly_splits_over, field_extension] THEN
    REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"l:B ring", ← q r"m:C ring", ← q r"f:B->C",
      ← q r"IMAGE (h:A->B) (ring_carrier k) UNION
       {x | x IN ring_carrier l /\ poly_eval l ((h:A->B) o p) x = ring_0 l}"]
     SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [UNION_SUBSET, SUBSET_RESTRICT] THEN ANTS_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [ring_monomorphism, ring_homomorphism]) THEN
      ASM_REWRITE_TAC [],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [IMAGE_UNION, IMAGE_o, ← GSYM o_ASSOC] THEN
    REPEAT AP_TERM_TAC THEN MATCH_MP_TAC POLY_ROOTS_MONOMORPHIC_IMAGE THEN
    ASM_MESON_TAC [FIELD_IMP_INTEGRAL_DOMAIN, POLY_EQ_0_MONOMORPHIC_IMAGE,
                   RING_POLYNOMIAL])

  let SPLITTING_EXTENSION_IMAGES_EQ ← prove
   r"!(h:A->B) (h':A->C) (f:B->D) (f':C->D) k l l' m p.
        splitting_extension(k,l) h p /\ splitting_extension(k,l') h' p /\
        field_extension(l,m) f /\ field_extension(l',m) f' /\
        (!x. x IN ring_carrier k ==> f(h x) = f'(h' x))
        ==> IMAGE f (ring_carrier l) = IMAGE f' (ring_carrier l')"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h':A->C", ← q r"f':C->D", ← q r"k:A ring", ← q r"l':C ring", ← q r"m:D ring",
                      ← q r"p:(1->num)->A"] SPLITTING_EXTENSION_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->D", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:D ring",
                      ← q r"p:(1->num)->A"] SPLITTING_EXTENSION_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN SUBST1_TAC) THEN
    SUBGOAL_THEN (← q r"((f:B->D) o (h:A->B)) o (p:(1->num)->A) =
                  ((f':C->D) o (h':A->C)) o p")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP SPLITTING_EXTENSION_IN_POLY_RING) THEN
      REWRITE_TAC [IN_POLY_RING_CARRIER, ring_polynomial, ring_powerseries] THEN
      ASM_SIMP_TAC [FUN_EQ_THM, o_THM],
      REPEAT AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      MATCH_MP_TAC IMAGE_EQ THEN ASM_REWRITE_TAC [o_THM]])

  -- @@RETURN BEGIN
  return { splitting_extension, SPLITTING_EXTENSION_I, SPLITTING_IMP_FIELD_EXTENSION,
           SPLITTING_EXTENSION_IN_POLY_RING, SPLITTING_EXTENSION_NONZERO,
           SPLITTING_EXTENSION_SPLITS, SPLITTING_EXTENSION_GENERATED,
           SPLITTING_IMP_FINITELY_GENERATED_EXTENSION, SPLITTING_IMP_ALGEBRAIC_EXTENSION,
           SPLITTING_IMP_FINITE_EXTENSION, SPLITTING_EXTENSION_GENERATED_BY_ROOTS,
           SPLITTING_EXTENSION_LIFT, SPLITTING_EXTENSION_FACTOR,
           SPLITTING_EXTENSION_DEGREE_DIVIDES_FACT, SPLITTING_EXTENSION_EXISTS_ID,
           SPLITTING_EXTENSION_EXISTS, SPLITTING_EXTENSION_EXISTS_BIGENOUGH,
           SPLITTING_EXTENSION_IMAGE, SPLITTING_EXTENSION_IMAGES_EQ }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Uniqueness of splitting extensions, by an isomorphism compatible with the -/
/- maps from k. Proof: extend the map from k to an embedding of the first    -/
/- extension in an algebraic closure of the second; the images of both       -/
/- coincide by SPLITTING_EXTENSION_IMAGES_EQ.  (fieldtheory.ml 9803-9886)    -/
/- ------------------------------------------------------------------------- -/

structure SplittingUnique where
  -- @@FIELDS
  SPLITTING_EXTENSION_UNIQUE_EXPLICIT : thm
  SPLITTING_EXTENSION_EXTEND_HOMOMORPHISM : thm
  SPLITTING_EXTENSION_UNIQUE : thm
  deriving Inhabited

@[nospecialize]
def setupSplittingUnique [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated2 : SubfieldGenerated2) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BAcfBasic : AcfBasic) (BClosureExtendHom : ClosureExtendHom) (BAlgebraicClosure : AlgebraicClosure) (BSplittingExtension : SplittingExtension) :
    ExceptT String IO SplittingUnique := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, .. } := D
  let { FIELD_IMP_NONTRIVIAL_RING, FIELD_RING_HOMOMORPHISM_MONOMORPHISM, .. } := D.core2
  let { I_O_ID, .. } := D.core3
  let { MONO_EXISTS, .. } := D.core4
  let { RING_HOMOMORPHISM_COMPOSE, RING_ISOMORPHISMS_ISOMORPHISM,
        RING_ISOMORPHISM_IMP_HOMOMORPHISM, RING_ISOMORPHISM_ONTO_IMAGE, .. } := D.core6
  let { isomorphic_ring, .. } := D.core8
  let { o_THM, ring_image, ring_isomorphism, .. } := D.core9
  let { RING_ISOMORPHISM_COMPOSE, .. } := D.core11
  let { RING_HOMOMORPHISM_SUBFIELD_INCLUSION, .. } := BSubfieldGenerated2
  let { FIELD_EXTENSION_CARRIER, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_IMP_MONOMORPHISM, FIELD_EXTENSION_TRANS, field_extension, .. } := BFieldExtension
  let { algebraic_extension, .. } := BAlgebraicExtension
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM, .. } := BClosureExtendHom
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { SPLITTING_EXTENSION_GENERATED_BY_ROOTS, SPLITTING_EXTENSION_IMAGES_EQ,
        SPLITTING_EXTENSION_IN_POLY_RING, SPLITTING_EXTENSION_NONZERO,
        SPLITTING_IMP_ALGEBRAIC_EXTENSION, SPLITTING_IMP_FIELD_EXTENSION, .. } := BSplittingExtension
  -- @@SCOPE END

  let SPLITTING_EXTENSION_UNIQUE_EXPLICIT ← prove
   r"!(h:A->B) (h':A->C) k l l' p.
        splitting_extension(k,l) h p /\ splitting_extension(k,l') h' p
        ==> ?j. ring_isomorphism(l,l') j /\
                !x. x IN ring_carrier k ==> j(h x) = h' x"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"algebraic_extension(k:A ring,l:B ring) h /\
                  field_extension(k:A ring,l':C ring) h' /\
                  field(l:B ring) /\ field(l':C ring)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [SPLITTING_IMP_ALGEBRAIC_EXTENSION,
                     SPLITTING_IMP_FIELD_EXTENSION, field_extension],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"l':C ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [algebraic_extension] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"om:(C#num)ring")
      (X_CHOOSE_THEN (← q r"g:C->C#num") STRIP_ASSUME_TAC)) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"om:(C#num)ring", ← q r"h:A->B",
                      ← q r"(g:C->C#num) o (h':A->C)"]
      ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM) THEN
    ASM_REWRITE_TAC [o_THM] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_TRANS, FIELD_EXTENSION_IMP_HOMOMORPHISM],
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:B->C#num") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN (← q r"field_extension(l:B ring,om:(C#num)ring) f") ASSUME_TAC THENL
     [ASM_MESON_TAC [field_extension, FIELD_RING_HOMOMORPHISM_MONOMORPHISM,
                     FIELD_IMP_NONTRIVIAL_RING,
                     ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"h':A->C", ← q r"f:B->C#num", ← q r"g:C->C#num",
                      ← q r"k:A ring", ← q r"l:B ring", ← q r"l':C ring", ← q r"om:(C#num)ring",
                      ← q r"p:(1->num)->A"] SPLITTING_EXTENSION_IMAGES_EQ) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"g:C->C#num", ← q r"l':C ring", ← q r"om:(C#num)ring"]
      RING_ISOMORPHISM_ONTO_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"f:B->C#num", ← q r"l:B ring", ← q r"om:(C#num)ring"]
      RING_ISOMORPHISM_ONTO_IMAGE) THEN
    ASM_SIMP_TAC [ring_image, FIELD_EXTENSION_IMP_MONOMORPHISM] THEN
    DISCH_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"g':C#num->C") MP_TAC o
      GEN_REWRITE_RULE I [ring_isomorphism]) THEN
    REWRITE_TAC [RING_ISOMORPHISMS_ISOMORPHISM] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(g':C#num->C) o (f:B->C#num)") THEN
    ASM_MESON_TAC [RING_ISOMORPHISM_COMPOSE, FIELD_EXTENSION_CARRIER, o_THM])

  let SPLITTING_EXTENSION_EXTEND_HOMOMORPHISM ← prove
   r"!(h:A->B) (g:A->C) k l m p.
        splitting_extension(k,l) h p /\ field_extension(k,m) g /\
        poly_splits_over(k,m) g p
        ==> ?e. ring_homomorphism(l,m) e /\
                !x. x IN ring_carrier k ==> e(h x) = g x"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_IN_POLY_RING) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_EXTENSION_NONZERO) THEN
    MP_TAC (← ISPECL [← q r"g:A->C", ← q r"k:A ring", ← q r"m:C ring", ← q r"p:(1->num)->A"]
      SPLITTING_EXTENSION_GENERATED_BY_ROOTS) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC
     (← q r"t = IMAGE (g:A->C) (ring_carrier k) UNION
          {x | x IN ring_carrier m /\ poly_eval m (g o p) x = ring_0 m}") THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"subfield_generated m (t:C->bool)", ← q r"p:(1->num)->A"]
      SPLITTING_EXTENSION_UNIQUE_EXPLICIT) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"e:B->C") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP RING_ISOMORPHISM_IMP_HOMOMORPHISM) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← CONJ th (← ISPECL [← q r"m:C ring", ← q r"t:C->bool"]
        RING_HOMOMORPHISM_SUBFIELD_INCLUSION)))) THEN
    DISCH_THEN (MP_TAC o MATCH_MP RING_HOMOMORPHISM_COMPOSE) THEN
    REWRITE_TAC [I_O_ID])

  let SPLITTING_EXTENSION_UNIQUE ← prove
   r"!(h:A->B) (h':A->C) k l l' p.
        splitting_extension(k,l) h p /\ splitting_extension(k,l') h' p
        ==> l isomorphic_ring l'"
   (REWRITE_TAC [isomorphic_ring] THEN
    MESON_TAC [SPLITTING_EXTENSION_UNIQUE_EXPLICIT])

  -- @@RETURN BEGIN
  return { SPLITTING_EXTENSION_UNIQUE_EXPLICIT, SPLITTING_EXTENSION_EXTEND_HOMOMORPHISM,
           SPLITTING_EXTENSION_UNIQUE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Normal extensions: algebraic extensions such that every irreducible       -/
/- polynomial over k with a root in l splits over l.                         -/
/- (fieldtheory.ml 9887-10014)                                               -/
/- ------------------------------------------------------------------------- -/

structure NormalExtension where
  -- @@FIELDS
  normal_extension : thm
  NORMAL_IMP_ALGEBRAIC_EXTENSION : thm
  NORMAL_IMP_FIELD_EXTENSION : thm
  NORMAL_EXTENSION_I : thm
  NORMAL_EXTENSION_ISOMORPHISM : thm
  NORMAL_EXTENSION_REFL : thm
  ALGEBRAICALLY_CLOSED_IMP_NORMAL_EXTENSION : thm
  NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT : thm
  deriving Inhabited

@[nospecialize]
def setupNormalExtension [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicExtMisc : AlgebraicExtMisc) (BMinimalPolynomial : MinimalPolynomial) (BAcfSplit : AcfSplit) (BSplitsOver : SplitsOver) :
    ExceptT String IO NormalExtension := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, new_definition, .. } := D
  let { EXISTS_IN_IMAGE, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, .. } := D.core2
  let { IN_RING_POLYNOMIAL_CARRIER_COMPOSE, I_O_ID, I_THM, .. } := D.core3
  let { POLY_DEG_MONOMORPHIC_IMAGE, POLY_EQ_0_MONOMORPHIC_IMAGE, POLY_EVAL,
        POLY_EVAL_HOMOMORPHIC_IMAGE, .. } := D.core4
  let { RING_DIVIDES_HOMOMORPHIC_IMAGE, RING_HOMOMORPHISM_POLY_RINGS,
        RING_IRREDUCIBLE_IN_CARRIER, RING_ISOMORPHISM, RING_ISOMORPHISM_I,
        RING_MONOMORPHISM_EQ_0, RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_POLYNOMIAL, .. } := D.core7
  let { IRREDUCIBLE_ROOT_IMP_DEG_EQ_1, POLY_DEG_1_IMP_SPLITS, POLY_SPLITS_DIVISOR,
        RING_HOMOMORPHISM_I, .. } := D.core10
  let { ring_associates, .. } := D.core11
  let { FIELD_EXTENSION_ISOMORPHISM, FIELD_EXTENSION_REFL, field_extension, .. } := BFieldExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, algebraic_extension, .. } := BAlgebraicExtension
  let { ALGEBRAIC_EXTENSION_ISOMORPHISM, .. } := BAlgebraicExtMisc
  let { MINIMAL_POLYNOMIAL, MINIMAL_POLYNOMIAL_ASSOCIATES_IRREDUCIBLE,
        MINIMAL_POLYNOMIAL_IRREDUCIBLE, MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE, .. } := BMinimalPolynomial
  let { ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS, .. } := BAcfSplit
  let { poly_splits_over, .. } := BSplitsOver
  -- @@SCOPE END

  let normal_extension ← new_definition
   r"normal_extension (k:A ring,l:B ring) (h:A->B) <=>
        algebraic_extension (k,l) h /\
        (!p. ring_irreducible(poly_ring k (:1)) p /\
             (?a. a IN ring_carrier l /\ poly_eval l (h o p) a = ring_0 l)
             ==> poly_splits_over (k,l) h p)"

  let NORMAL_IMP_ALGEBRAIC_EXTENSION ← prove
   r"!(h:A->B) k l.
        normal_extension (k,l) h ==> algebraic_extension (k,l) h"
   (SIMP_TAC [normal_extension])

  let NORMAL_IMP_FIELD_EXTENSION ← prove
   r"!(h:A->B) k l. normal_extension (k,l) h ==> field_extension (k,l) h"
   (SIMP_TAC [normal_extension, ALGEBRAIC_IMP_FIELD_EXTENSION])

  let NORMAL_EXTENSION_I ← prove
   r"!(k:A ring) l.
        normal_extension (k,l) I <=>
        algebraic_extension (k,l) I /\
        (!p. ring_irreducible(poly_ring k (:1)) p /\
             (?a. a IN ring_carrier l /\ poly_eval l p a = ring_0 l)
             ==> poly_splits l p)"
   (REWRITE_TAC [normal_extension, poly_splits_over, I_O_ID])

  let NORMAL_EXTENSION_ISOMORPHISM ← prove
   r"!(f:A->B) k l.
        (field k \/ field l) /\ ring_isomorphism (k,l) f
        ==> normal_extension (k,l) f"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [normal_extension, poly_splits_over,
                  ALGEBRAIC_EXTENSION_ISOMORPHISM] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FIELD_EXTENSION_ISOMORPHISM) THEN
    REWRITE_TAC [field_extension] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [RING_ISOMORPHISM] o
      CONJUNCT2) THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    X_GEN_TAC (← q r"p:(1->num)->A") THEN ASM_REWRITE_TAC [EXISTS_IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"b:A") STRIP_ASSUME_TAC)) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_IRREDUCIBLE_IN_CARRIER) THEN
    MATCH_MP_TAC POLY_DEG_1_IMP_SPLITS THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"f:A->B", ← q r"p:(1->num)->A"]
      POLY_DEG_MONOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [RING_POLYNOMIAL] THEN DISCH_THEN SUBST1_TAC THEN
    MATCH_MP_TAC (← ARITH_RULE (← q r"n = 1 ==> n <= 1")) THEN
    MATCH_MP_TAC IRREDUCIBLE_ROOT_IMP_DEG_EQ_1 THEN
    EXISTS_TAC (← q r"b:A") THEN ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"f:A->B", ← q r"poly_eval k p (b:A)"]
      RING_MONOMORPHISM_EQ_0) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"b:A", ← q r"f:A->B", ← q r"p:(1->num)->A"]
      POLY_EVAL_HOMOMORPHIC_IMAGE) THEN
    ASM_SIMP_TAC [POLY_EVAL])

  let NORMAL_EXTENSION_REFL ← prove
   r"!k:A ring. normal_extension (k,k) I <=> field k"
   (MESON_TAC [NORMAL_IMP_FIELD_EXTENSION, FIELD_EXTENSION_REFL,
               NORMAL_EXTENSION_ISOMORPHISM, RING_ISOMORPHISM_I])

  let ALGEBRAICALLY_CLOSED_IMP_NORMAL_EXTENSION ← prove
   r"!(h:A->B) k l.
        algebraic_extension(k,l) h /\ algebraically_closed_field l
        ==> normal_extension(k,l) h"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [normal_extension, poly_splits_over] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
    EXISTS_TAC (← q r"k:A ring") THEN ASM_SIMP_TAC [RING_IRREDUCIBLE_IN_CARRIER] THEN
    ASM_MESON_TAC [ALGEBRAIC_IMP_FIELD_EXTENSION, field_extension,
                   RING_MONOMORPHISM_IMP_HOMOMORPHISM])

  let NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT ← prove
   r"!(h:A->B) k l.
        normal_extension(k,l) h <=>
        algebraic_extension(k,l) h /\
        !x. x IN ring_carrier l
            ==> poly_splits_over (k,l) h (minimal_polynomial(k,l) h x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [normal_extension] THEN
    ASM_CASES_TAC (← q r"algebraic_extension(k:A ring,l:B ring) h") THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) x") ASSUME_TAC THENL
       [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IRREDUCIBLE] THEN
      EXISTS_TAC (← q r"x:B") THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"l:B ring",
                        ← q r"x:B"] MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [RING_HOMOMORPHISM_I, I_O_ID, I_THM],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"p:(1->num)->A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"a:B") STRIP_ASSUME_TAC)) THEN
    SUBGOAL_THEN (← q r"algebraic_over(k,l) (h:A->B) a") ASSUME_TAC THENL
     [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_IRREDUCIBLE_IN_CARRIER) THEN
    ABBREV_TAC (← q r"q = minimal_polynomial (k,l) (h:A->B) a") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
      MINIMAL_POLYNOMIAL) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"ring_divides (poly_ring k (:1)) (p:(1->num)->A) q")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A", ← q r"a:B"]
        MINIMAL_POLYNOMIAL_ASSOCIATES_IRREDUCIBLE) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [ring_associates],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"poly_splits l ((h:A->B) o (q:(1->num)->A))") ASSUME_TAC THENL
     [ASM_MESON_TAC [poly_splits_over], ALL_TAC] THEN
    REWRITE_TAC [poly_splits_over] THEN MATCH_MP_TAC POLY_SPLITS_DIVISOR THEN
    EXISTS_TAC (← q r"(h:A->B) o (q:(1->num)->A)") THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [POLY_EQ_0_MONOMORPHIC_IMAGE, RING_POLYNOMIAL], ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let c ← CONJ (← ISPEC (← q r"(:1)") (← MATCH_MP RING_HOMOMORPHISM_POLY_RINGS
        (← MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM
          (← ASSUME (← q r"ring_monomorphism(k:A ring,l:B ring) h"))))) th
      pure (MP_TAC (← MATCH_MP RING_DIVIDES_HOMOMORPHIC_IMAGE c))) THEN
    REWRITE_TAC [])

  -- @@RETURN BEGIN
  return { normal_extension, NORMAL_IMP_ALGEBRAIC_EXTENSION, NORMAL_IMP_FIELD_EXTENSION,
           NORMAL_EXTENSION_I, NORMAL_EXTENSION_ISOMORPHISM, NORMAL_EXTENSION_REFL,
           ALGEBRAICALLY_CLOSED_IMP_NORMAL_EXTENSION,
           NORMAL_EXTENSION_EQ_MINIMAL_POLYNOMIALS_SPLIT }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Characterization by embeddings: homomorphisms from a normal extension l   -/
/- into an integral domain that agree on k have the same image, and this     -/
/- characterizes normality when the target is algebraically closed.          -/
/- (fieldtheory.ml 10015-10164)                                              -/
/- ------------------------------------------------------------------------- -/

structure NormalEmbeddings where
  -- @@FIELDS
  NORMAL_EXTENSION_IMAGES_EQ : thm
  NORMAL_EXTENSION_EQ_EMBEDDINGS : thm
  deriving Inhabited

@[nospecialize]
def setupNormalEmbeddings [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BMinimalPolynomial : MinimalPolynomial) (BAcfBasic : AcfBasic) (BAcfSplit : AcfSplit) (BClosureExtendHom : ClosureExtendHom) (BSplitsOver : SplitsOver) (BNormalExtension : NormalExtension) :
    ExceptT String IO NormalEmbeddings := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core2
  let { INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, IN_ELIM_THM, IN_IMAGE,
        IN_POLY_RING_CARRIER, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, I_O_ID, I_THM, .. } := D.core3
  let { POLY_EQ_0_MONOMORPHIC_IMAGE, .. } := D.core4
  let { RING_DIVIDES_HOMOMORPHIC_IMAGE, RING_HOMOMORPHISM_COMPOSE,
        RING_HOMOMORPHISM_POLY_RINGS, RING_IRREDUCIBLE_IN_CARRIER,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_POLYNOMIAL, .. } := D.core7
  let { SUBSET, SUBSET_ANTISYM, .. } := D.core8
  let { o_ASSOC, o_THM, ring_polynomial, ring_powerseries, .. } := D.core9
  let { POLY_DIVIDES_X_MINUS_ROOT_EQ, POLY_ROOTS_MONOMORPHIC_IMAGE,
        POLY_SPLITS_MONOMORPHIC_PREIMAGE, RING_DIVIDES_TRANS, RING_HOMOMORPHISM_I,
        RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { ring_associates, .. } := D.core11
  let { FIELD_EXTENSION_IMP_MONOMORPHISM, field_extension, .. } := BFieldExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, algebraic_extension, .. } := BAlgebraicExtension
  let { MINIMAL_POLYNOMIAL, MINIMAL_POLYNOMIAL_ASSOCIATES_IRREDUCIBLE,
        MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE, .. } := BMinimalPolynomial
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS, .. } := BAcfSplit
  let { ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM_ROOT, .. } := BClosureExtendHom
  let { poly_splits_over, .. } := BSplitsOver
  let { NORMAL_IMP_ALGEBRAIC_EXTENSION, normal_extension, .. } := BNormalExtension
  -- @@SCOPE END

  let NORMAL_EXTENSION_IMAGES_EQ ← prove
   r"!(h:A->B) (f:B->C) f' k l m.
        normal_extension(k,l) h /\ integral_domain m /\
        ring_homomorphism(l,m) f /\ ring_homomorphism(l,m) f' /\
        (!x. x IN ring_carrier k ==> f(h x) = f'(h x))
        ==> IMAGE f (ring_carrier l) = IMAGE f' (ring_carrier l)"
   (SUBGOAL_THEN
     (← q r"!(h:A->B) (f:B->C) f' k l m.
          normal_extension(k,l) h /\ integral_domain m /\
          ring_homomorphism(l,m) f /\ ring_homomorphism(l,m) f' /\
          (!x. x IN ring_carrier k ==> f(h x) = f'(h x))
          ==> IMAGE f (ring_carrier l) SUBSET IMAGE f' (ring_carrier l)")
    (fun th => tactic_of do
      pure (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
               CONJ_TAC THEN MATCH_MP_TAC th THEN
               MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"m:C ring"] THEN
               ASM_SIMP_TAC [])) THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [normal_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"algebraic_over (k,l) (h:A->B) x") ASSUME_TAC THENL
     [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
    ABBREV_TAC (← q r"p = minimal_polynomial (k,l) (h:A->B) x") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"x:B"]
      MINIMAL_POLYNOMIAL) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"l:B ring",
                      ← q r"x:B"] MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"x:B"] MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [RING_HOMOMORPHISM_I, I_O_ID, I_THM] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"poly_eval m ((f':B->C) o (h:A->B) o p) ((f:B->C) x) = ring_0 m")
    ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"(f':B->C) o (h:A->B) o (p:(1->num)->A) = (f o h) o p")
       (fun th => ASM_REWRITE_TAC [th]) THEN
      UNDISCH_TAC (← q r"(p:(1->num)->A) IN ring_carrier(poly_ring k (:1))") THEN
      REWRITE_TAC [IN_POLY_RING_CARRIER, ring_polynomial, ring_powerseries] THEN
      ASM_SIMP_TAC [FUN_EQ_THM, o_THM],
      ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_MONOMORPHISM) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"m:C ring", ← q r"f':B->C",
                      ← q r"(h:A->B) o (p:(1->num)->A)"]
      POLY_ROOTS_MONOMORPHIC_IMAGE) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
        ASM_SIMP_TAC [INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING] THEN
        ASM_MESON_TAC [field_extension],
        ASM_MESON_TAC [POLY_EQ_0_MONOMORPHIC_IMAGE, RING_POLYNOMIAL],
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:(1->num)->A")) THEN
        ASM_REWRITE_TAC [poly_splits_over] THEN DISCH_THEN MATCH_MP_TAC THEN
        EXISTS_TAC (← q r"x:B") THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(f:B->C) x IN ring_carrier m") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(f:B->C) x")) THEN
    ASM_REWRITE_TAC [] THEN MESON_TAC [])

  let NORMAL_EXTENSION_EQ_EMBEDDINGS ← prove
   r"!(h:A->B) (j:B->C) k l m.
        algebraically_closed_field m /\ ring_homomorphism(l,m) j
        ==> (normal_extension(k,l) h <=>
             algebraic_extension(k,l) h /\
             !g. ring_homomorphism(l,m) g /\
                 (!x. x IN ring_carrier k ==> g(h x) = j(h x))
                 ==> IMAGE g (ring_carrier l) = IMAGE j (ring_carrier l))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    EQ_TAC THENL
     [DISCH_TAC THEN ASM_SIMP_TAC [NORMAL_IMP_ALGEBRAIC_EXTENSION] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC NORMAL_EXTENSION_IMAGES_EQ THEN
      MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"m:C ring"] THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN],
      STRIP_TAC] THEN
    ASM_REWRITE_TAC [normal_extension, poly_splits_over] THEN
    X_GEN_TAC (← q r"p:(1->num)->A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:B") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_IRREDUCIBLE_IN_CARRIER) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(k,m) ((j:B->C) o (h:A->B))") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_COMPOSE,
                     RING_MONOMORPHISM_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"m:C ring", ← q r"j:B->C",
                      ← q r"(h:A->B) o (p:(1->num)->A)"]
      POLY_SPLITS_MONOMORPHIC_PREIMAGE) THEN
    DISCH_THEN MATCH_MP_TAC THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      MATCH_MP_TAC ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS THEN
      ASM_REWRITE_TAC [o_ASSOC] THEN
      MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN
      ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM],
      X_GEN_TAC (← q r"b:C") THEN STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_over (k,l) (h:A->B) a") ASSUME_TAC THENL
     [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
    ABBREV_TAC (← q r"q = minimal_polynomial (k,l) (h:A->B) a") THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
      MINIMAL_POLYNOMIAL) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring", ← q r"h:A->B",
                      ← q r"(j:B->C) o (h:A->B)", ← q r"a:B", ← q r"b:C"]
      ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM_ROOT) THEN
    ASM_REWRITE_TAC [o_THM] THEN ANTS_TAC THENL
     [ALL_TAC,
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:B->C") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"g:B->C")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN ASM SET_TAC []] THEN
    SUBGOAL_THEN (← q r"ring_divides (poly_ring k (:1)) (p:(1->num)->A) q")
    MP_TAC THENL
     [MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A", ← q r"a:B"]
        MINIMAL_POLYNOMIAL_ASSOCIATES_IRREDUCIBLE) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [ring_associates],
      ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do
      let c ← CONJ (← ISPEC (← q r"(:1)") (← MATCH_MP RING_HOMOMORPHISM_POLY_RINGS
        (← ASSUME (← q r"ring_homomorphism(k,m) ((j:B->C) o (h:A->B))")))) th
      pure (MP_TAC (← MATCH_MP RING_DIVIDES_HOMOMORPHIC_IMAGE c))) THEN
    REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"((j:B->C) o (h:A->B)) o (p:(1->num)->A) IN ring_carrier(poly_ring m (:1)) /\
      ((j:B->C) o (h:A->B)) o (q:(1->num)->A) IN ring_carrier(poly_ring m (:1))")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_divides (poly_ring m (:1))
        (poly_sub m (poly_var m one) (poly_const m (b:C)))
        (((j:B->C) o (h:A->B)) o (p:(1->num)->A))")
    MP_TAC THENL
     [ASM_SIMP_TAC [POLY_DIVIDES_X_MINUS_ROOT_EQ] THEN
      ASM_REWRITE_TAC [← GSYM o_ASSOC],
      ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← MATCH_MP RING_DIVIDES_TRANS (← CONJ th (← ASSUME
       (← q r"ring_divides (poly_ring m (:1)) (((j:B->C) o (h:A->B)) o p)
                     ((j o h) o (q:(1->num)->A))")))))) THEN
    ASM_SIMP_TAC [POLY_DIVIDES_X_MINUS_ROOT_EQ])

  -- @@RETURN BEGIN
  return { NORMAL_EXTENSION_IMAGES_EQ, NORMAL_EXTENSION_EQ_EMBEDDINGS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The finite normal extensions are exactly the splitting extensions.        -/
/- (fieldtheory.ml 10165-10287)                                              -/
/- ------------------------------------------------------------------------- -/

structure FiniteNormal where
  -- @@FIELDS
  SPLITTING_EXTENSION_IMP_NORMAL : thm
  NORMAL_EXTENSION_GENERATED_BY_ROOTS : thm
  SPLITTING_EQ_FINITE_NORMAL_EXTENSION : thm
  deriving Inhabited

@[nospecialize]
def setupFiniteNormal [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated : SubfieldGenerated) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BMinimalPolynomial : MinimalPolynomial) (BAcfBasic : AcfBasic) (BAlgebraicClosure : AlgebraicClosure) (BSplitsOver : SplitsOver) (BSplittingExtension : SplittingExtension) (BNormalExtension : NormalExtension) (BNormalEmbeddings : NormalEmbeddings) :
    ExceptT String IO FiniteNormal := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FUN_EQ_THM, .. } := D.core2
  let { INTEGRAL_DOMAIN_POLY_RING, INTEGRAL_DOMAIN_PRODUCT_EQ_0, IN_ELIM_THM,
        IN_RING_POLYNOMIAL_CARRIER_COMPOSE, I_O_ID, I_THM, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { POLY_RING_CLAUSES, .. } := D.core5
  let { RING_HOMOMORPHISM_POLY_EVAL, RING_HOMOMORPHISM_POLY_RINGS,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_PRODUCT, .. } := D.core7
  let { SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core8
  let { o_THM, .. } := D.core9
  let { POLY_SPLITS_PRODUCT, RING_HOMOMORPHISM_I, .. } := D.core10
  let { RING_HOMOMORPHISM_PRODUCT, .. } := D.core11
  let { RING_CARRIER_SUBFIELD_GENERATED_SUBSET, SUBFIELD_GENERATED_EQ,
        SUBFIELD_GENERATED_MONO, .. } := BSubfieldGenerated
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, field_extension, .. } := BFieldExtension
  let { finitely_generated_extension, .. } := BFiniteExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_EQ_FINITELY_GENERATED_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_IRREDUCIBLE,
        MINIMAL_POLYNOMIAL_NONZERO, MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE, .. } := BMinimalPolynomial
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { poly_splits_over, .. } := BSplitsOver
  let { SPLITTING_EXTENSION_GENERATED_BY_ROOTS, SPLITTING_EXTENSION_IMAGES_EQ,
        SPLITTING_IMP_ALGEBRAIC_EXTENSION, SPLITTING_IMP_FIELD_EXTENSION,
        SPLITTING_IMP_FINITE_EXTENSION, splitting_extension, .. } := BSplittingExtension
  let { normal_extension, .. } := BNormalExtension
  let { NORMAL_EXTENSION_EQ_EMBEDDINGS, .. } := BNormalEmbeddings
  -- @@SCOPE END

  let SPLITTING_EXTENSION_IMP_NORMAL ← prove
   r"!(h:A->B) k l p.
        splitting_extension(k,l) h p ==> normal_extension(k,l) h"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SPLITTING_IMP_ALGEBRAIC_EXTENSION) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SPLITTING_IMP_FIELD_EXTENSION) THEN
    REWRITE_TAC [field_extension] THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"l:B ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:(B#num)ring", ← q r"j:B->B#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"j:B->B#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:(B#num)ring"] NORMAL_EXTENSION_EQ_EMBEDDINGS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    X_GEN_TAC (← q r"g:B->B#num") THEN STRIP_TAC THEN
    MATCH_MP_TAC SPLITTING_EXTENSION_IMAGES_EQ THEN
    MAP_EVERY EXISTS_TAC
     [← q r"h:A->B", ← q r"h:A->B", ← q r"k:A ring", ← q r"m:(B#num)ring", ← q r"p:(1->num)->A"] THEN
    ASM_REWRITE_TAC [field_extension] THEN
    MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
    ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING])

  let NORMAL_EXTENSION_GENERATED_BY_ROOTS ← prove
   r"!(h:A->B) k l p.
        field_extension(k,l) h /\
        p IN ring_carrier(poly_ring k (:1)) /\
        ~(p = poly_0 k) /\
        poly_splits_over (k,l) h p
        ==> normal_extension
              (k,subfield_generated l
                   (IMAGE h (ring_carrier k) UNION
                    {x | x IN ring_carrier l /\
                         poly_eval l (h o p) x = ring_0 l}))
              h"
   (MESON_TAC [SPLITTING_EXTENSION_GENERATED_BY_ROOTS,
               SPLITTING_EXTENSION_IMP_NORMAL])

  let SPLITTING_EQ_FINITE_NORMAL_EXTENSION ← prove
   r"!(h:A->B) k l.
        (?p. splitting_extension(k,l) h p) <=>
        finite_extension(k,l) h /\ normal_extension(k,l) h"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [SPLITTING_IMP_FINITE_EXTENSION, SPLITTING_EXTENSION_IMP_NORMAL],
      STRIP_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I
      [FINITE_EQ_FINITELY_GENERATED_ALGEBRAIC_EXTENSION]) THEN
    REWRITE_TAC [finitely_generated_extension] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (CONJUNCTS_THEN2 ASSUME_TAC
      (X_CHOOSE_THEN (← q r"b:B->bool") STRIP_ASSUME_TAC)) ASSUME_TAC) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"!x:B. x IN b ==> algebraic_over (k,l) (h:A->B) x")
    ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [algebraic_extension]) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"ring_product (poly_ring k (:1)) b
                  (minimal_polynomial (k,l) (h:A->B))") THEN
    SUBGOAL_THEN
     (← q r"(h:A->B) o ring_product (poly_ring k (:1)) b (minimal_polynomial (k,l) h) =
      ring_product (poly_ring l (:1)) b (\x. h o minimal_polynomial (k,l) h x)")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"minimal_polynomial (k,l) (h:A->B)", ← q r"b:B->bool"]
       (← MATCH_MP RING_HOMOMORPHISM_PRODUCT (← ISPEC (← q r"(:1)")
         (← MATCH_MP RING_HOMOMORPHISM_POLY_RINGS
           (← ASSUME (← q r"ring_homomorphism (k,l) (h:A->B)")))))) THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER] THEN
      DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM, o_THM],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x:B. x IN b
            ==> poly_eval l ((h:A->B) o minimal_polynomial (k,l) h x) x =
                ring_0 l")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"l:B ring",
                        ← q r"x:B"] MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE) THEN
      ASM_SIMP_TAC [RING_HOMOMORPHISM_I, I_O_ID, I_THM],
      ALL_TAC] THEN
    REWRITE_TAC [splitting_extension, poly_splits_over] THEN
    ASM_REWRITE_TAC [RING_PRODUCT] THEN REPEAT CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"poly_ring (k:A ring) (:1)", ← q r"b:B->bool",
                        ← q r"minimal_polynomial (k,l) (h:A->B)"]
        INTEGRAL_DOMAIN_PRODUCT_EQ_0) THEN
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_POLY_RING, FIELD_IMP_INTEGRAL_DOMAIN,
                    POLY_RING_CLAUSES] THEN
      DISCH_THEN (K ALL_TAC : thm → tactic) THEN ASM_MESON_TAC [MINIMAL_POLYNOMIAL_NONZERO],
      MATCH_MP_TAC POLY_SPLITS_PRODUCT THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [normal_extension]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"minimal_polynomial (k,l) (h:A->B) x") o
        CONJUNCT2) THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IRREDUCIBLE, poly_splits_over] THEN
      DISCH_THEN MATCH_MP_TAC THEN EXISTS_TAC (← q r"x:B") THEN ASM SET_TAC [],
      REWRITE_TAC [SUBFIELD_GENERATED_EQ, ← GSYM SUBSET_ANTISYM_EQ] THEN
      REWRITE_TAC [RING_CARRIER_SUBFIELD_GENERATED_SUBSET] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← SYM th])) THEN
      MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET t ==> (k:B->bool) UNION s SUBSET k UNION t")) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(x:B) IN ring_carrier l") ASSUME_TAC THENL
       [ASM SET_TAC [], ASM_REWRITE_TAC []] THEN
      MP_TAC (← ISPECL [← q r"\y:B. (h:A->B) o minimal_polynomial (k,l) h y",
                        ← q r"b:B->bool"]
       (← MATCH_MP RING_HOMOMORPHISM_PRODUCT (← ISPEC (← q r"(:1)")
         (← MATCH_MP RING_HOMOMORPHISM_POLY_EVAL
           (← ASSUME (← q r"(x:B) IN ring_carrier l")))))) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
        EXISTS_TAC (← q r"k:A ring") THEN ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER],
        DISCH_THEN (SUBST1_TAC o BETA_RULE)] THEN
      ASM_SIMP_TAC [INTEGRAL_DOMAIN_PRODUCT_EQ_0, FIELD_IMP_INTEGRAL_DOMAIN,
                    o_THM] THEN
      EXISTS_TAC (← q r"x:B") THEN ASM_SIMP_TAC []])

  -- @@RETURN BEGIN
  return { SPLITTING_EXTENSION_IMP_NORMAL, NORMAL_EXTENSION_GENERATED_BY_ROOTS,
           SPLITTING_EQ_FINITE_NORMAL_EXTENSION }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Invariance under isomorphism, intermediate fields and composita.          -/
/- (fieldtheory.ml 10288-10486)                                              -/
/- ------------------------------------------------------------------------- -/

structure NormalInvariance where
  -- @@FIELDS
  NORMAL_EXTENSION_ISOMORPHIC_IMAGE : thm
  NORMAL_EXTENSION_INTERMEDIATE : thm
  NORMAL_EXTENSION_COMPOSITUM : thm
  deriving Inhabited

@[nospecialize]
def setupNormalInvariance [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated : SubfieldGenerated) (BSubfieldGenerated1 : SubfieldGenerated1) (BSubfieldGenerated2 : SubfieldGenerated2) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtMisc : AlgebraicExtMisc) (BAlgebraicField : AlgebraicField) (BAcfBasic : AcfBasic) (BAlgebraicClosure : AlgebraicClosure) (BNormalExtension : NormalExtension) (BNormalEmbeddings : NormalEmbeddings) :
    ExceptT String IO NormalInvariance := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FORALL_IN_IMAGE, FORALL_IN_UNION,
        IMAGE_UNION, IMAGE_o, .. } := D.core2
  let { LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { RING_HOMOMORPHISM_COMPOSE, RING_ISOMORPHISM, RING_ISOMORPHISMS_ISOMORPHISM,
        RING_ISOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { UNION_SUBSET, .. } := D.core8
  let { o_THM, ring_isomorphism, .. } := D.core9
  let { RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { FIELD_SUBFIELD_GENERATED, .. } := BSubfieldGenerated
  let { SUBFIELD_GENERATED_IDEMPOT, SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET, .. } := BSubfieldGenerated1
  let { SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE, .. } := BSubfieldGenerated2
  let { FIELD_EXTENSION_CARRIER, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_IMP_MONOMORPHISM, FIELD_EXTENSION_IMP_SUBSET,
        FIELD_EXTENSION_INTO_SUBFIELD_GENERATED, FIELD_EXTENSION_ISOMORPHISM,
        FIELD_EXTENSION_TRANS, field_extension, .. } := BFieldExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, ALGEBRAIC_OVER_IMAGE, algebraic_extension, .. } := BAlgebraicExtension
  let { ALGEBRAIC_EXTENSION_EQ, ALGEBRAIC_OVER_EQ_EQ, .. } := BAlgebraicOverBasics
  let { ALGEBRAIC_EXTENSION_ISOMORPHISM, ALGEBRAIC_EXTENSION_TRANS,
        ALGEBRAIC_EXTENSION_TRANS_EQ, .. } := BAlgebraicExtMisc
  let { ALGEBRAIC_OVER_SUBFIELD_GENERATED_ALGEBRAIC, ALGEBRAIC_OVER_TRANS, .. } := BAlgebraicField
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { NORMAL_IMP_ALGEBRAIC_EXTENSION, NORMAL_IMP_FIELD_EXTENSION, .. } := BNormalExtension
  let { NORMAL_EXTENSION_EQ_EMBEDDINGS, NORMAL_EXTENSION_IMAGES_EQ, .. } := BNormalEmbeddings
  -- @@SCOPE END

  let NORMAL_EXTENSION_ISOMORPHIC_IMAGE ← prove
   r"!(h:A->B) (h':C->D) (f:A->C) (g:B->D) k l k' l'.
        normal_extension(k,l) h /\
        ring_isomorphism(k,k') f /\ ring_isomorphism(l,l') g /\
        (!x. x IN ring_carrier k ==> h'(f x) = g(h x))
        ==> normal_extension(k',l') h'"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f':C->A") MP_TAC o
      GEN_REWRITE_RULE I [ring_isomorphism]) THEN
    REWRITE_TAC [RING_ISOMORPHISMS_ISOMORPHISM] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP NORMAL_IMP_ALGEBRAIC_EXTENSION) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension] o
      MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"field(l':D ring)") ASSUME_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_ISOMORPHISM, field_extension], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"algebraic_extension(k',l') (h':C->D)") ASSUME_TAC THENL
     [MATCH_MP_TAC ALGEBRAIC_EXTENSION_EQ THEN
      EXISTS_TAC (← q r"((g:B->D) o (h:A->B)) o (f':C->A)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC ALGEBRAIC_EXTENSION_TRANS THEN EXISTS_TAC (← q r"k:A ring") THEN
        ASM_SIMP_TAC [ALGEBRAIC_EXTENSION_ISOMORPHISM] THEN
        MATCH_MP_TAC ALGEBRAIC_EXTENSION_TRANS THEN EXISTS_TAC (← q r"l:B ring") THEN
        ASM_SIMP_TAC [ALGEBRAIC_EXTENSION_ISOMORPHISM],
        REWRITE_TAC [o_THM] THEN
        ASM_MESON_TAC [RING_ISOMORPHISM_IMP_HOMOMORPHISM,
                       RING_HOMOMORPHISM_IN_CARRIER]],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"l':D ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:(D#num)ring", ← q r"j:D->D#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM o
      MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"h':C->D", ← q r"j:D->D#num", ← q r"k':C ring", ← q r"l':D ring",
                      ← q r"n:(D#num)ring"] NORMAL_EXTENSION_EQ_EMBEDDINGS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    X_GEN_TAC (← q r"g':D->D#num") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN ring_carrier k
          ==> (g':D->D#num) (g((h:A->B) x)) = j (g (h x))")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_ISOMORPHISM_IMP_HOMOMORPHISM,
                     RING_HOMOMORPHISM_IN_CARRIER],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"l':D ring", ← q r"g:B->D"] RING_ISOMORPHISM) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_o] THEN
    MATCH_MP_TAC NORMAL_EXTENSION_IMAGES_EQ THEN
    MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring", ← q r"n:(D#num)ring"] THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD,
                  o_THM] THEN
    ASM_MESON_TAC [RING_HOMOMORPHISM_COMPOSE])

  let NORMAL_EXTENSION_INTERMEDIATE ← prove
   r"!(f:A->B) (g:B->C) k l m.
        field_extension(k,l) f /\ field_extension(l,m) g /\
        normal_extension(k,m) (g o f)
        ==> normal_extension(l,m) g"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"field(m:C ring)") ASSUME_TAC THENL
     [ASM_MESON_TAC [field_extension], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"m:C ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:(C#num)ring", ← q r"j:C->C#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM o
      MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"g:B->C", ← q r"j:C->C#num", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"n:(C#num)ring"] NORMAL_EXTENSION_EQ_EMBEDDINGS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
        ALGEBRAIC_EXTENSION_TRANS_EQ) THEN
      ASM_MESON_TAC [NORMAL_IMP_ALGEBRAIC_EXTENSION],
      X_GEN_TAC (← q r"g':C->C#num") THEN STRIP_TAC] THEN
    MATCH_MP_TAC NORMAL_EXTENSION_IMAGES_EQ THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(g:B->C) o (f:A->B)", ← q r"k:A ring", ← q r"n:(C#num)ring"] THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD,
                  o_THM] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [FIELD_EXTENSION_CARRIER])

  let NORMAL_EXTENSION_COMPOSITUM ← prove
   r"!(h:A->B) (h':A->C) (f:B->D) (f':C->D) k l l' m.
        normal_extension(k,l) h /\ normal_extension(k,l') h' /\
        field_extension(l,m) f /\ field_extension(l',m) f' /\
        (!x. x IN ring_carrier k ==> f(h x) = f'(h' x))
        ==> normal_extension
             (k,subfield_generated m
                  (IMAGE f (ring_carrier l) UNION IMAGE f' (ring_carrier l')))
             (f o h)"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"s = IMAGE (f:B->D) (ring_carrier l) UNION
                    IMAGE (f':C->D) (ring_carrier l')") THEN
    ABBREV_TAC (← q r"c = subfield_generated m (s:D->bool)") THEN
    SUBGOAL_THEN (← q r"field(m:D ring)") ASSUME_TAC THENL
     [ASM_MESON_TAC [field_extension], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(s:D->bool) SUBSET ring_carrier m") ASSUME_TAC THENL
     [EXPAND_TAC "s" THEN REWRITE_TAC [UNION_SUBSET] THEN
      ASM_MESON_TAC [FIELD_EXTENSION_IMP_SUBSET],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"field_extension(l,c) (f:B->D) /\ field_extension(l',c) (f':C->D)")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "c" THEN CONJ_TAC THEN
      MATCH_MP_TAC FIELD_EXTENSION_INTO_SUBFIELD_GENERATED THEN
      ASM_REWRITE_TAC [] THEN EXPAND_TAC "s" THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field(c:D ring) /\ (s:D->bool) SUBSET ring_carrier c /\
                  subfield_generated c s = c")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "c" THEN
      ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED, SUBFIELD_GENERATED_IDEMPOT,
                    SUBFIELD_GENERATED_SUBSET_CARRIER_SUBSET],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field_extension(k,c) ((f:B->D) o (h:A->B))") ASSUME_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_TRANS, NORMAL_IMP_FIELD_EXTENSION],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"c:D ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:(D#num)ring", ← q r"j:D->D#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM) THEN
    MP_TAC (← ISPECL [← q r"(f:B->D) o (h:A->B)", ← q r"j:D->D#num", ← q r"k:A ring", ← q r"c:D ring",
                      ← q r"n:(D#num)ring"] NORMAL_EXTENSION_EQ_EMBEDDINGS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [algebraic_extension] THEN
      SUBGOAL_THEN
       (← q r"!x. x IN (s:D->bool) ==> algebraic_over (k,c) ((f:B->D) o (h:A->B)) x")
      ASSUME_TAC THENL
       [EXPAND_TAC "s" THEN REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_IMAGE] THEN
        CONJ_TAC THENL
         [X_GEN_TAC (← q r"y:B") THEN DISCH_TAC,
          X_GEN_TAC (← q r"y:C") THEN DISCH_TAC THEN
          MP_TAC (← ISPECL [← q r"k:A ring", ← q r"c:D ring", ← q r"(f':C->D) y",
                            ← q r"(f':C->D) o (h':A->C)", ← q r"(f:B->D) o (h:A->B)"]
            ALGEBRAIC_OVER_EQ_EQ) THEN
          ANTS_TAC THENL
           [ASM_SIMP_TAC [o_THM] THEN
            ASM_MESON_TAC [FIELD_EXTENSION_TRANS, NORMAL_IMP_FIELD_EXTENSION,
                           FIELD_EXTENSION_IMP_HOMOMORPHISM],
            DISCH_THEN (SUBST1_TAC o SYM)]] THEN
        MATCH_MP_TAC ALGEBRAIC_OVER_TRANS THENL
         [EXISTS_TAC (← q r"l:B ring"), EXISTS_TAC (← q r"l':C ring")] THEN
        ASM_SIMP_TAC [ALGEBRAIC_OVER_IMAGE, NORMAL_IMP_ALGEBRAIC_EXTENSION],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"(f:B->D) o (h:A->B)", ← q r"k:A ring", ← q r"c:D ring", ← q r"s:D->bool"]
        ALGEBRAIC_OVER_SUBFIELD_GENERATED_ALGEBRAIC) THEN
      SUBGOAL_THEN
       (← q r"IMAGE ((f:B->D) o (h:A->B)) (ring_carrier k) UNION s = s")
       (fun th => ASM_REWRITE_TAC [th]) THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring"]
        FIELD_EXTENSION_IMP_SUBSET) THEN
      ASM_SIMP_TAC [NORMAL_IMP_FIELD_EXTENSION] THEN
      EXPAND_TAC "s" THEN REWRITE_TAC [IMAGE_o] THEN SET_TAC [],
      X_GEN_TAC (← q r"g:D->D#num") THEN STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_monomorphism (c,n) (g:D->D#num) /\
      ring_monomorphism (c,n) (j:D->D#num)")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [FIELD_EXTENSION_IMP_MONOMORPHISM] THEN
      MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING,
                    ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_homomorphism(l,n) ((g:D->D#num) o (f:B->D)) /\
      ring_homomorphism(l,n) ((j:D->D#num) o f) /\
      ring_homomorphism(l',n) (g o (f':C->D)) /\
      ring_homomorphism(l',n) (j o f')")
    STRIP_ASSUME_TAC THENL
     [REPEAT CONJ_TAC THEN MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN
      EXISTS_TAC (← q r"c:D ring") THEN ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(!x. x IN ring_carrier k
           ==> ((g:D->D#num) o (f:B->D)) ((h:A->B) x) = (j o f) (h x)) /\
      (!x. x IN ring_carrier k
           ==> (g o (f':C->D)) ((h':A->C) x) = (j o f') (h' x))")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [o_THM] THEN RULE_ASSUM_TAC (REWRITE_RULE [o_THM]) THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"c:D ring", ← q r"n:(D#num)ring", ← q r"j:D->D#num", ← q r"s:D->bool"]
      SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"c:D ring", ← q r"n:(D#num)ring", ← q r"g:D->D#num", ← q r"s:D->bool"]
      SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN (SUBST1_TAC o SYM)) THEN
    REPEAT AP_TERM_TAC THEN EXPAND_TAC "s" THEN
    REWRITE_TAC [IMAGE_UNION, ← GSYM IMAGE_o] THEN BINOP_TAC THEN
    MATCH_MP_TAC NORMAL_EXTENSION_IMAGES_EQ THENL
     [EXISTS_TAC (← q r"h:A->B"), EXISTS_TAC (← q r"h':A->C")] THEN
    MAP_EVERY EXISTS_TAC [← q r"k:A ring", ← q r"n:(D#num)ring"] THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN,
                  ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD])

  -- @@RETURN BEGIN
  return { NORMAL_EXTENSION_ISOMORPHIC_IMAGE, NORMAL_EXTENSION_INTERMEDIATE,
           NORMAL_EXTENSION_COMPOSITUM }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Perfect fields: characteristic 0, or the Frobenius map is surjective.     -/
/- (fieldtheory.ml 10487-10890)                                              -/
/- ------------------------------------------------------------------------- -/

structure PerfectField where
  -- @@FIELDS
  perfect_field : thm
  PERFECT_FIELD_IMP_FIELD : thm
  PERFECT_FIELD_CHAR_0 : thm
  PERFECT_FIELD_POLY_DERIV_EQ_0 : thm
  PERFECT_FIELD_IMP_SEPARABLE : thm
  PERFECT_FIELD_SEPARABLE_EQ_SQUAREFREE : thm
  PERFECT_FIELD_EQ_FROBENIUS_AUTOMORPHISM : thm
  PERFECT_FIELD_EQ_FROBENIUS_AUTOMORPHISM_GEN : thm
  PERFECT_FIELD_EPIMORPHIC_IMAGE : thm
  PERFECT_FIELD_ISOMORPHIC_IMAGE : thm
  ISOMORPHIC_RING_PERFECT_FIELD : thm
  FINITE_FIELD_IMP_PERFECT : thm
  ALGEBRAICALLY_CLOSED_FIELD_IMP_PERFECT : thm
  PERFECT_FIELD_EQ_SEPARABLE_IRREDUCIBLES : thm
  PERFECT_FIELD_EQ_IRREDUCIBLE_DERIV_NONZERO : thm
  deriving Inhabited

@[nospecialize]
def setupPerfectField [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BAcfBasic : AcfBasic) (BPolySquarefree : PolySquarefree) (BAlgebraicClosure : AlgebraicClosure) :
    ExceptT String IO PerfectField := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC,
        RING_RULE, SET_RULE, TAUT, new_definition, .. } := D
  let { COND_RAND, EXISTS_IN_IMAGE, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING, FIELD_NONTRIVIAL,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FINITE_NUMSEG_LT, FORALL_IN_IMAGE, .. } := D.core2
  let { INTEGRAL_DOMAIN_CHAR, INTEGRAL_DOMAIN_POLY_RING,
        INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE, IN_ELIM_THM, IN_IMAGE,
        LEFT_IMP_EXISTS_THM, LE_REFL, .. } := D.core3
  let { MONO_EXISTS, NOETHERIAN_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS, NOT_EXISTS_THM,
        NOT_IMP, PID_IMP_UFD, PID_POLY_RING, POLY_CLAUSES, POLY_CONST, POLY_DEG_0,
        POLY_DEG_1_ROOT, POLY_DEG_MONOMORPHIC_IMAGE, POLY_DEG_UNIT, POLY_EVAL_CONST,
        POLY_EVAL_HOMOMORPHIC_IMAGE, .. } := D.core4
  let { POLY_EVAL_SUB, POLY_EVAL_VAR, POLY_EXTEND_CONST, POLY_EXTEND_EVALUATE,
        POLY_EXTEND_SUB, POLY_RING_CLAUSES, POLY_VAR_UNIV, .. } := D.core5
  let { RING_DIVIDES_HOMOMORPHIC_IMAGE, RING_DIVIDES_REFL, RING_DIVIDES_RMUL,
        RING_DIVIDES_ZERO, RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_POLY_CONST,
        RING_HOMOMORPHISM_POLY_EXTEND, RING_IRREDUCIBLE_IN_CARRIER,
        RING_ISOMORPHISMS_ISOMORPHISM, RING_ISOMORPHISM_IMP_EPIMORPHISM,
        RING_MONOMORPHISM_FROBENIUS, RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL, .. } := D.core6
  let { RING_MUL_RID, RING_MUL_RZERO, RING_POLYNOMIAL, RING_POLYNOMIAL_CONST,
        RING_POLYNOMIAL_IMP_POWERSERIES, RING_POLYNOMIAL_MUL, RING_POLYNOMIAL_SUB,
        RING_POLYNOMIAL_VAR, RING_POW, RING_SQUAREFREE_IMP_NONZERO,
        RING_SQUAREFREE_IN_CARRIER, RING_SUB_EQ_0, RING_SUM, RING_SUM_EQ,
        RING_SUM_EQ_0, SKOLEM_THM, .. } := D.core7
  let { SUBSET, SUBSET_ANTISYM_EQ, TRIVIAL_POLY_RING, isomorphic_ring, .. } := D.core8
  let { poly_eval, ring_automorphism, ring_divides, ring_epimorphism, ring_irreducible,
        ring_isomorphism, ring_pow, ring_prime, .. } := D.core9
  let { CARD_LE_1, COEFF_ABOVE_DEG, COEFF_IN_CARRIER_ALT, COEFF_POLY_LMUL,
        COEFF_POLY_SUM, COEFF_POLY_VARPOW, EQ_MULT_LCANCEL, EQ_TRANS, EXP_1,
        FIELD_EPIMORPHIC_IMAGE, FINITE_INTEGRAL_DOMAIN_CHAR, FROBENIUS_SUM_POWER,
        FUN_EQ_COEFF, IRREDUCIBLE_IMP_POLY_DEG_NZ, ISOMORPHIC_RING_TRIVIALITY,
        LE_MULT2, LTE_TRANS, MULT_SYM, POLY_DEG_SUB_CONST, POLY_DEG_VAR_POW,
        POLY_DERIV_EQ_0_COEFF, POLY_DERIV_IN_CARRIER, POLY_DERIV_MUL,
        POLY_DERIV_NONZERO_CHAR0, POLY_EVAL_POW, POLY_EXTEND_VARPOW,
        POLY_SEPARABLE_EQ_DERIV_NONZERO, POLY_SEPARABLE_IMP_SQUAREFREE,
        POLY_SEPARABLE_MONOMORPHIC_IMAGE, PRIME_GE_2, PRIME_IMP_NZ,
        RIGHT_IMP_EXISTS_THM, RING_AUTOMORPHISM_FROBENIUS, RING_CHAR_MONOMORPHIC_IMAGE,
        RING_CHAR_POLY_RING, RING_COPRIME_DIVPROD_RIGHT, RING_COPRIME_SYM,
        RING_DIVIDES_SUB, RING_EPIMORPHISM_IMP_HOMOMORPHISM,
        RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { RING_HOMOMORPHISM_POW, RING_MONOMORPHISM_EPIMORPHISM,
        RING_MONOMORPHISM_INJECTIVE_EQ, RING_MUL_POW, RING_POLYNOMIAL_POW,
        RING_POW_POW, RING_PRIME_IN_CARRIER, RING_SQUAREFREE_COPRIME, RING_SUM_DELTA,
        RING_UNIT_POW_EQ, UFD_COPRIME, divides, poly_separable, ring_coprime, .. } := D.core11
  let { field_extension, .. } := BFieldExtension
  let { algebraic_extension, .. } := BAlgebraicExtension
  let { algebraically_closed_field, .. } := BAcfBasic
  let { POLY_SQUAREFREE_ROOT_COUNT, .. } := BPolySquarefree
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  -- @@SCOPE END

  let perfect_field ← new_definition
   r"perfect_field (k:A ring) <=>
        field k /\
        (ring_char k = 0 \/
         (!x. x IN ring_carrier k
              ==> ?y. y IN ring_carrier k /\
                      ring_pow k y (ring_char k) = x))"

  let PERFECT_FIELD_IMP_FIELD ← prove
   r"!k:A ring. perfect_field k ==> field k"
   (SIMP_TAC [perfect_field])

  let PERFECT_FIELD_CHAR_0 ← prove
   r"!k:A ring. ring_char k = 0 ==> (perfect_field k <=> field k)"
   (SIMP_TAC [perfect_field])

  let PERFECT_FIELD_POLY_DERIV_EQ_0 ← prove
   r"!(k:A ring) p.
        perfect_field k /\ prime(ring_char k) /\
        p IN ring_carrier(poly_ring k (:1)) /\
        poly_deriv k p = poly_0 k
        ==> ?q. q IN ring_carrier(poly_ring k (:1)) /\
                p = ring_pow (poly_ring k (:1)) q (ring_char k)"
   (← do
    -- right to left: the second ARITH_RULE, then the first
    let a2 ← ARITH_RULE (← q r"2 <= c ==> 1 <= c")
    let a1 ← ARITH_RULE (← q r"m = 1 * m")
    pure (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [perfect_field]) THEN
    ASM_SIMP_TAC [PRIME_IMP_NZ] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o REWRITE_RULE [RIGHT_IMP_EXISTS_THM]) THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"rt:A->A") THEN DISCH_TAC THEN
    ABBREV_TAC (← q r"c = ring_char(k:A ring)") THEN
    ABBREV_TAC (← q r"d = poly_deg (k:A ring) (p:(1->num)->A)") THEN
    SUBGOAL_THEN (← q r"ring_polynomial k (p:(1->num)->A)") ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_POLYNOMIAL], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!j. (rt:A->A)(coeff (c * j) (p:(1->num)->A)) IN ring_carrier k /\
          ring_pow k (rt(coeff (c * j) p)) c = coeff (c * j) p")
    ASSUME_TAC THENL
     [GEN_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [COEFF_IN_CARRIER_ALT],
      ALL_TAC] THEN
    EXISTS_TAC
     (← q r"ring_sum (poly_ring (k:A ring) (:1)) {j | j < d + 1}
        (\j. ring_mul (poly_ring k (:1))
               (poly_const k (rt(coeff (c * j) (p:(1->num)->A))))
               (ring_pow (poly_ring k (:1)) (poly_var k one) j))") THEN
    REWRITE_TAC [RING_SUM] THEN
    MP_TAC (← ISPECL
     [← q r"poly_ring (k:A ring) (:1)", ← q r"1",
      ← q r"\j. ring_mul (poly_ring (k:A ring) (:1))
             (poly_const k (rt(coeff (c * j) (p:(1->num)->A))))
             (ring_pow (poly_ring k (:1)) (poly_var k one) j)",
      ← q r"d + 1"] FROBENIUS_SUM_POWER) THEN
    ASM_SIMP_TAC [RING_CHAR_POLY_RING, EXP_1, RING_MUL, POLY_CONST, RING_POW,
                  POLY_VAR_UNIV] THEN
    DISCH_THEN SUBST1_TAC THEN
    ASM_SIMP_TAC [RING_MUL_POW, POLY_CONST, RING_POW, POLY_VAR_UNIV, RING_POW_POW,
                  ← GSYM (← MATCH_MP RING_HOMOMORPHISM_POW
                    (← SPEC_ALL RING_HOMOMORPHISM_POLY_CONST))] THEN
    REWRITE_TAC [POLY_RING_CLAUSES, MULT_SYM, ← GSYM FUN_EQ_COEFF] THEN
    X_GEN_TAC (← q r"n:num") THEN
    wPart rand (fun t => do lhand (← rand t)) COEFF_POLY_SUM THEN
    REWRITE_TAC [FINITE_NUMSEG_LT] THEN ANTS_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC RING_POLYNOMIAL_MUL THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_CONST, COEFF_IN_CARRIER_ALT,
                    RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR],
      DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [COEFF_POLY_LMUL, COEFF_IN_CARRIER_ALT, COEFF_POLY_VARPOW,
                  RING_POLYNOMIAL_IMP_POWERSERIES, RING_POLYNOMIAL_POW,
                  RING_POLYNOMIAL_VAR] THEN
    REWRITE_TAC [COND_RAND] THEN
    ASM_SIMP_TAC [RING_MUL_RID, RING_MUL_RZERO, COEFF_IN_CARRIER_ALT] THEN
    ASM_CASES_TAC (← q r"(c:num) divides n") THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"m:num") SUBST1_TAC o
        REWRITE_RULE [divides]) THEN
      TRANS_TAC EQ_TRANS
       (← q r"ring_sum k {j | j < d + 1}
          (\j. if j = m then coeff (c * m) (p:(1->num)->A) else ring_0 k)") THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [RING_SUM_DELTA, IN_ELIM_THM, COEFF_IN_CARRIER_ALT] THEN
        COND_CASES_TAC THEN REWRITE_TAC [] THEN
        MATCH_MP_TAC COEFF_ABOVE_DEG THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC LTE_TRANS THEN EXISTS_TAC (← q r"m:num") THEN
        CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        GEN_REWRITE_TAC LAND_CONV [a1] THEN
        MATCH_MP_TAC LE_MULT2 THEN REWRITE_TAC [LE_REFL] THEN
        ASM_MESON_TAC [PRIME_GE_2, a2],
        MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        ASM_SIMP_TAC [EQ_MULT_LCANCEL, PRIME_IMP_NZ] THEN
        ASM_CASES_TAC (← q r"j:num = m") THEN ASM_REWRITE_TAC []],
      TRANS_TAC EQ_TRANS (← q r"ring_0 k:A") THEN CONJ_TAC THENL
       [MATCH_MP_TAC POLY_DERIV_EQ_0_COEFF THEN ASM_REWRITE_TAC [],
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC RING_SUM_EQ_0 THEN
        X_GEN_TAC (← q r"j:num") THEN REWRITE_TAC [] THEN
        COND_CASES_TAC THEN ASM_MESON_TAC [divides]]]))

  let PERFECT_FIELD_IMP_SEPARABLE ← prove
   r"!(k:A ring) p.
        perfect_field k /\ ring_irreducible (poly_ring k (:1)) p
        ==> poly_separable k p"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP PERFECT_FIELD_IMP_FIELD) THEN
    ASM_SIMP_TAC [POLY_SEPARABLE_EQ_DERIV_NONZERO] THEN DISCH_TAC THEN
    FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP INTEGRAL_DOMAIN_CHAR o
      MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) THENL
     [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"p:(1->num)->A"] POLY_DERIV_NONZERO_CHAR0) THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"p:(1->num)->A"]
        IRREDUCIBLE_IMP_POLY_DEG_NZ) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, RING_POLYNOMIAL,
                    RING_IRREDUCIBLE_IN_CARRIER] THEN ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"p:(1->num)->A"]
      PERFECT_FIELD_POLY_DERIV_EQ_0) THEN
    ASM_SIMP_TAC [RING_IRREDUCIBLE_IN_CARRIER, NOT_EXISTS_THM] THEN
    X_GEN_TAC (← q r"q:(1->num)->A") THEN STRIP_TAC THEN
    UNDISCH_TAC (← q r"ring_irreducible (poly_ring k (:1)) (p:(1->num)->A)") THEN
    ASM_REWRITE_TAC [ring_irreducible] THEN
    ASM_SIMP_TAC [RING_UNIT_POW_EQ, PRIME_IMP_NZ, RING_POW] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"q:(1->num)->A",
      ← q r"ring_pow (poly_ring (k:A ring) (:1)) q (ring_char k - 1)"]) THEN
    ASM_SIMP_TAC [RING_POW, RING_UNIT_POW_EQ, NOT_IMP] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP PRIME_GE_2) THEN
    CONJ_TAC THENL [ALL_TAC, ASM_ARITH_TAC] THEN
    SUBGOAL_THEN (← q r"ring_char(k:A ring) = SUC(ring_char k - 1)")
     (fun th => GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [th])
    THENL [ASM_ARITH_TAC, REWRITE_TAC [ring_pow]])

  let PERFECT_FIELD_SEPARABLE_EQ_SQUAREFREE ← prove
   r"!(k:A ring) p.
        perfect_field k
        ==> (poly_separable k p <=> ring_squarefree (poly_ring k (:1)) p)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [POLY_SEPARABLE_IMP_SQUAREFREE] THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP PERFECT_FIELD_IMP_FIELD) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_SQUAREFREE_IN_CARRIER) THEN
    SUBGOAL_THEN (← q r"UFD(poly_ring (k:A ring) (:1))") ASSUME_TAC THENL
     [ASM_SIMP_TAC [PID_IMP_UFD, PID_POLY_RING], ALL_TAC] THEN
    ASM_SIMP_TAC [poly_separable, UFD_COPRIME, POLY_DERIV_IN_CARRIER] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [RING_SQUAREFREE_IMP_NONZERO, TRIVIAL_POLY_RING,
                     FIELD_IMP_NONTRIVIAL_RING],
      X_GEN_TAC (← q r"q:(1->num)->A") THEN REPEAT STRIP_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_PRIME_IN_CARRIER) THEN
    UNDISCH_TAC (← q r"ring_divides (poly_ring k (:1)) q (p:(1->num)->A)") THEN
    REWRITE_TAC [ring_divides] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:(1->num)->A") STRIP_ASSUME_TAC o
      CONJUNCT2 o CONJUNCT2) THEN
    SUBGOAL_THEN (← q r"ring_coprime (poly_ring (k:A ring) (:1)) (q,s) /\
                  poly_separable k (q:(1->num)->A)")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o CONJUNCT2 o
          GEN_REWRITE_RULE I [RING_SQUAREFREE_COPRIME]) THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC PERFECT_FIELD_IMP_SEPARABLE THEN
        ASM_SIMP_TAC [INTEGRAL_DOMAIN_PRIME_IMP_IRREDUCIBLE,
                      INTEGRAL_DOMAIN_POLY_RING, FIELD_IMP_INTEGRAL_DOMAIN]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_divides (poly_ring k (:1)) q
        (ring_mul (poly_ring (k:A ring) (:1)) (poly_deriv k q) s)")
    ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"ring_mul (poly_ring (k:A ring) (:1)) (poly_deriv k q) s =
        ring_sub (poly_ring k (:1)) (poly_deriv k p)
                 (ring_mul (poly_ring k (:1)) q (poly_deriv k s))")
      SUBST1_TAC THENL
       [ASM_REWRITE_TAC [← CONJUNCT2 POLY_RING_CLAUSES] THEN
        ASM_SIMP_TAC [POLY_DERIV_MUL, RING_POLYNOMIAL_IMP_POWERSERIES,
                      RING_POLYNOMIAL] THEN
        REWRITE_TAC [POLY_CLAUSES] THEN
        MATCH_MP_TAC (← RING_RULE
         (← q r"(x:(1->num)->A) IN ring_carrier r /\ y IN ring_carrier r
          ==> x = ring_sub r (ring_add r x y) y")) THEN
        ASM_SIMP_TAC [RING_MUL, POLY_DERIV_IN_CARRIER],
        MATCH_MP_TAC RING_DIVIDES_SUB THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC RING_DIVIDES_RMUL THEN
        ASM_SIMP_TAC [RING_DIVIDES_REFL, POLY_DERIV_IN_CARRIER]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"poly_ring (k:A ring) (:1)", ← q r"poly_deriv k (q:(1->num)->A)",
                      ← q r"s:(1->num)->A", ← q r"q:(1->num)->A"]
      RING_COPRIME_DIVPROD_RIGHT) THEN
    ASM_SIMP_TAC [POLY_DERIV_IN_CARRIER, RING_COPRIME_SYM] THEN
    UNDISCH_TAC (← q r"poly_separable k (q:(1->num)->A)") THEN
    REWRITE_TAC [poly_separable, ring_coprime] THEN
    ASM_MESON_TAC [RING_DIVIDES_REFL, ring_prime])

  let PERFECT_FIELD_EQ_FROBENIUS_AUTOMORPHISM ← prove
   r"!(k:A ring).
        prime(ring_char k)
        ==> (perfect_field k <=>
             field k /\ ring_automorphism k (\x. ring_pow k x (ring_char k)))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [perfect_field] THEN
    ASM_CASES_TAC (← q r"field(k:A ring)") THEN ASM_SIMP_TAC [PRIME_IMP_NZ] THEN
    REWRITE_TAC [ring_automorphism, ← GSYM RING_MONOMORPHISM_EPIMORPHISM] THEN
    ASM_SIMP_TAC [RING_MONOMORPHISM_FROBENIUS, FIELD_IMP_INTEGRAL_DOMAIN] THEN
    REWRITE_TAC [ring_epimorphism] THEN
    ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MONOMORPHISM_FROBENIUS,
                  FIELD_IMP_INTEGRAL_DOMAIN] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_IMAGE, IN_IMAGE] THEN
    SIMP_TAC [RING_POW] THEN MESON_TAC [])

  let PERFECT_FIELD_EQ_FROBENIUS_AUTOMORPHISM_GEN ← prove
   r"!k:A ring.
        perfect_field k <=>
        field k /\
        (ring_char k = 0 \/
         ring_automorphism k (\x. ring_pow k x (ring_char k)))"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"field(k:A ring)") THEN
    ASM_REWRITE_TAC [perfect_field] THEN
    FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP INTEGRAL_DOMAIN_CHAR o
      MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) THEN
    ASM_SIMP_TAC [PRIME_IMP_NZ] THEN
    MP_TAC (← ISPEC (← q r"k:A ring") PERFECT_FIELD_EQ_FROBENIUS_AUTOMORPHISM) THEN
    ASM_SIMP_TAC [perfect_field, PRIME_IMP_NZ])

  let PERFECT_FIELD_EPIMORPHIC_IMAGE ← prove
   r"!(r:A ring) (r':B ring) f.
        ring_epimorphism (r,r') f /\ perfect_field r /\ ~trivial_ring r'
        ==> perfect_field r'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [perfect_field] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"ring_monomorphism(r:A ring,r':B ring) f") ASSUME_TAC THENL
     [ASM_MESON_TAC [FIELD_RING_HOMOMORPHISM_MONOMORPHISM,
                     RING_EPIMORPHISM_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [FIELD_EPIMORPHIC_IMAGE], ALL_TAC] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP RING_CHAR_MONOMORPHIC_IMAGE) THEN
    FIRST_X_ASSUM (DISJ_CASES_THEN2 (fun th => REWRITE_TAC [th]) ASSUME_TAC) THEN
    DISJ2_TAC THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE I [ring_epimorphism]) THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
    ASM_MESON_TAC [RING_HOMOMORPHISM_POW, RING_EPIMORPHISM_IMP_HOMOMORPHISM])

  let PERFECT_FIELD_ISOMORPHIC_IMAGE ← prove
   r"!(r:A ring) (r':B ring) f.
        ring_isomorphism (r,r') f /\ perfect_field r ==> perfect_field r'"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PERFECT_FIELD_EPIMORPHIC_IMAGE THEN
    MAP_EVERY EXISTS_TAC [← q r"r:A ring", ← q r"f:A->B"] THEN
    ASM_SIMP_TAC [RING_ISOMORPHISM_IMP_EPIMORPHISM] THEN
    ASM_MESON_TAC [ISOMORPHIC_RING_TRIVIALITY, isomorphic_ring,
                   FIELD_IMP_NONTRIVIAL_RING, PERFECT_FIELD_IMP_FIELD])

  let ISOMORPHIC_RING_PERFECT_FIELD ← prove
   r"!(r:A ring) (r':B ring).
        r isomorphic_ring r' ==> (perfect_field r <=> perfect_field r')"
   (REWRITE_TAC [isomorphic_ring] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (X_CHOOSE_TAC (← q r"g:B->A") o
      GEN_REWRITE_RULE I [ring_isomorphism]) THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE I [RING_ISOMORPHISMS_ISOMORPHISM]) THEN
    ASM_MESON_TAC [PERFECT_FIELD_ISOMORPHIC_IMAGE])

  let FINITE_FIELD_IMP_PERFECT ← prove
   r"!(k:A ring). field k /\ FINITE(ring_carrier k) ==> perfect_field k"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"prime(ring_char(k:A ring))") ASSUME_TAC THENL
     [MATCH_MP_TAC FINITE_INTEGRAL_DOMAIN_CHAR THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN], ALL_TAC] THEN
    ASM_SIMP_TAC [PERFECT_FIELD_EQ_FROBENIUS_AUTOMORPHISM] THEN
    MATCH_MP_TAC RING_AUTOMORPHISM_FROBENIUS THEN ASM_REWRITE_TAC [])

  let ALGEBRAICALLY_CLOSED_FIELD_IMP_PERFECT ← prove
   r"!k:A ring. algebraically_closed_field k ==> perfect_field k"
   (GEN_TAC THEN REWRITE_TAC [algebraically_closed_field, perfect_field] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"ring_char(k:A ring) = 0") THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"poly_sub k (poly_pow k (poly_var k one) (ring_char k)) (poly_const k a)
      :(1->num)->A")) THEN
    REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN
    ASM_SIMP_TAC [RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR,
                  RING_POLYNOMIAL_CONST, POLY_DEG_SUB_CONST, POLY_DEG_VAR_POW,
                  FIELD_NONTRIVIAL, POLY_EVAL_SUB, POLY_EVAL_CONST] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [POLY_EVAL_POW, POLY_EVAL_VAR, RING_POLYNOMIAL_VAR, RING_POW,
                  RING_SUB_EQ_0])

  let PERFECT_FIELD_EQ_SEPARABLE_IRREDUCIBLES ← prove
   r"!k:A ring.
        perfect_field k <=>
        field k /\
        !p. ring_irreducible (poly_ring k (:1)) p ==> poly_separable k p"
   (← do
    -- right to left: the SET_RULE, the MESON, the ARITH_RULE, then the TAUT
    let s4 ← SET_RULE
     (← q r"(!x y:A#num. x IN s /\ y IN s ==> x = y) ==> ?a. s SUBSET {a}")
    let m3 ← MESON [CARD_LE_1]
     (← q r"(?a:A#num. s SUBSET {a}) ==> CARD s <= 1")
    let a2 ← ARITH_RULE (← q r"~(n = 0) /\ n <= 1 ==> n = 1")
    let t1 ← TAUT (← q r"(p <=> q) ==> p ==> q")
    pure (GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [PERFECT_FIELD_IMP_FIELD, PERFECT_FIELD_IMP_SEPARABLE],
      STRIP_TAC] THEN
    ASM_REWRITE_TAC [perfect_field] THEN
    FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP INTEGRAL_DOMAIN_CHAR o
      MATCH_MP FIELD_IMP_INTEGRAL_DOMAIN) THEN
    ASM_SIMP_TAC [PRIME_IMP_NZ] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"k:A ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ASM_REWRITE_TAC [algebraic_extension, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"l:(A#num)ring", ← q r"h:A->A#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    FIRST_ASSUM (ASSUME_TAC o SYM o MATCH_MP RING_CHAR_MONOMORPHIC_IMAGE) THEN
    SUBGOAL_THEN
     (← q r"!w. w IN ring_carrier l
          ==> poly_extend (k,l) (h:A->A#num) (\v. w)
                (poly_sub k (poly_pow k (poly_var k one) (ring_char k))
                            (poly_const k a)) =
              ring_sub l (ring_pow l w (ring_char k)) (h a)")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [POLY_EXTEND_SUB, POLY_EXTEND_VARPOW, POLY_EXTEND_CONST,
                    RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR,
                    RING_POLYNOMIAL_CONST],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"f = poly_sub k (poly_pow k (poly_var k one) (ring_char k))
                     (poly_const k a):(1->num)->A") THEN
    SUBGOAL_THEN
     (← q r"f IN ring_carrier(poly_ring k (:1)) /\
      poly_deg k (f:(1->num)->A) = ring_char k")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "f" THEN REWRITE_TAC [← GSYM RING_POLYNOMIAL] THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_POW, RING_POLYNOMIAL_VAR,
                    RING_POLYNOMIAL_CONST, POLY_DEG_SUB_CONST, POLY_DEG_VAR_POW,
                    FIELD_NONTRIVIAL],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"poly_ring (k:A ring) (:1)", ← q r"f:(1->num)->A"]
      NOETHERIAN_DOMAIN_IRREDUCIBLE_FACTOR_EXISTS) THEN
    ASM_SIMP_TAC [INTEGRAL_DOMAIN_POLY_RING, FIELD_IMP_INTEGRAL_DOMAIN,
                  PID_POLY_RING, PID_IMP_UFD] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [← CONJUNCT2 POLY_RING_CLAUSES] THEN
      ASM_MESON_TAC [POLY_DEG_UNIT, POLY_DEG_0, FIELD_IMP_INTEGRAL_DOMAIN,
                     PRIME_IMP_NZ],
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:(1->num)->A") STRIP_ASSUME_TAC)] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_IRREDUCIBLE_IN_CARRIER) THEN
    SUBGOAL_THEN
     (← q r"!w. w IN ring_carrier l /\ poly_eval l ((h:A->A#num) o q) w = ring_0 l
          ==> ring_pow l w (ring_char(k:A ring)) = h a")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"w:A#num") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"poly_ring (k:A ring) (:1)", ← q r"l:(A#num)ring",
                        ← q r"poly_extend (k,l) (h:A->A#num) (\v:1. w)",
                        ← q r"q:(1->num)->A", ← q r"f:(1->num)->A"]
        RING_DIVIDES_HOMOMORPHIC_IMAGE) THEN
      ASM_SIMP_TAC [RING_HOMOMORPHISM_POLY_EXTEND] THEN
      ASM_SIMP_TAC [POLY_EXTEND_EVALUATE, ← GSYM poly_eval] THEN
      REWRITE_TAC [RING_DIVIDES_ZERO] THEN
      MATCH_MP_TAC t1 THEN
      MATCH_MP_TAC RING_SUB_EQ_0 THEN
      ASM_MESON_TAC [RING_POW, RING_HOMOMORPHISM_IN_CARRIER],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"poly_deg k (q:(1->num)->A) = 1") MP_TAC THENL
     [MATCH_MP_TAC a2 THEN
      ASM_SIMP_TAC [IRREDUCIBLE_IMP_POLY_DEG_NZ] THEN
      MP_TAC (← ISPECL [← q r"l:(A#num)ring", ← q r"(h:A->A#num) o (q:(1->num)->A)"]
        POLY_SQUAREFREE_ROOT_COUNT) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC POLY_SEPARABLE_IMP_SQUAREFREE THEN
        MATCH_MP_TAC POLY_SEPARABLE_MONOMORPHIC_IMAGE THEN
        EXISTS_TAC (← q r"k:A ring") THEN ASM_SIMP_TAC [],
        MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:(A#num)ring", ← q r"h:A->A#num",
                          ← q r"q:(1->num)->A"] POLY_DEG_MONOMORPHIC_IMAGE) THEN
        ASM_SIMP_TAC [RING_POLYNOMIAL] THEN DISCH_THEN SUBST1_TAC THEN
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC m3 THEN
      MATCH_MP_TAC s4 THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"w1:A#num", ← q r"w2:A#num"] THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"l:(A#num)ring") RING_MONOMORPHISM_FROBENIUS) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"l:(A#num)ring", ← q r"l:(A#num)ring",
                        ← q r"\x:A#num. ring_pow l x (ring_char(k:A ring))",
                        ← q r"w1:A#num", ← q r"w2:A#num"] RING_MONOMORPHISM_INJECTIVE_EQ) THEN
      ASM_SIMP_TAC [],
      DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"q:(1->num)->A"] POLY_DEG_1_ROOT) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"y:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:(A#num)ring", ← q r"h:A->A#num",
                      ← q r"ring_pow k (y:A) (ring_char k)", ← q r"a:A"]
      RING_MONOMORPHISM_INJECTIVE_EQ) THEN
    ASM_SIMP_TAC [RING_POW] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_POW th])) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    CONJ_TAC THENL [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:(A#num)ring", ← q r"y:A", ← q r"h:A->A#num",
                      ← q r"q:(1->num)->A"] POLY_EVAL_HOMOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_MESON_TAC [RING_HOMOMORPHISM_0]))

  let PERFECT_FIELD_EQ_IRREDUCIBLE_DERIV_NONZERO ← prove
   r"!k:A ring.
        perfect_field k <=>
        field k /\
        !p. ring_irreducible (poly_ring k (:1)) p
            ==> ~(poly_deriv k p = poly_0 k)"
   (GEN_TAC THEN REWRITE_TAC [PERFECT_FIELD_EQ_SEPARABLE_IRREDUCIBLES] THEN
    ASM_CASES_TAC (← q r"field(k:A ring)") THEN
    ASM_SIMP_TAC [POLY_SEPARABLE_EQ_DERIV_NONZERO])

  -- @@RETURN BEGIN
  return { perfect_field, PERFECT_FIELD_IMP_FIELD, PERFECT_FIELD_CHAR_0,
           PERFECT_FIELD_POLY_DERIV_EQ_0, PERFECT_FIELD_IMP_SEPARABLE,
           PERFECT_FIELD_SEPARABLE_EQ_SQUAREFREE,
           PERFECT_FIELD_EQ_FROBENIUS_AUTOMORPHISM,
           PERFECT_FIELD_EQ_FROBENIUS_AUTOMORPHISM_GEN, PERFECT_FIELD_EPIMORPHIC_IMAGE,
           PERFECT_FIELD_ISOMORPHIC_IMAGE, ISOMORPHIC_RING_PERFECT_FIELD,
           FINITE_FIELD_IMP_PERFECT, ALGEBRAICALLY_CLOSED_FIELD_IMP_PERFECT,
           PERFECT_FIELD_EQ_SEPARABLE_IRREDUCIBLES,
           PERFECT_FIELD_EQ_IRREDUCIBLE_DERIV_NONZERO }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Separable extensions: algebraic extensions in which every element is      -/
/- separable, i.e. its minimal polynomial is separable.                      -/
/- (fieldtheory.ml 10891-11067)                                              -/
/- ------------------------------------------------------------------------- -/

structure SeparableExtension where
  -- @@FIELDS
  separable_element : thm
  separable_extension : thm
  SEPARABLE_IMP_ALGEBRAIC_EXTENSION : thm
  SEPARABLE_IMP_FIELD_EXTENSION : thm
  SEPARABLE_ELEMENT_IMP_ALGEBRAIC : thm
  PERFECT_FIELD_IMP_SEPARABLE_ELEMENT : thm
  PERFECT_FIELD_IMP_SEPARABLE_EXTENSION : thm
  SEPARABLE_ELEMENT_CHAR0 : thm
  SEPARABLE_EXTENSION_CHAR0 : thm
  SEPARABLE_ELEMENT_IMAGE : thm
  SEPARABLE_EXTENSION_ISOMORPHISM : thm
  SEPARABLE_EXTENSION_REFL : thm
  SEPARABLE_EXTENSION_SUBFIELD : thm
  SEPARABLE_ELEMENT_INTERMEDIATE : thm
  SEPARABLE_EXTENSION_INTERMEDIATE : thm
  deriving Inhabited

@[nospecialize]
def setupSeparableExtension [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BAlgebraicExtMisc : AlgebraicExtMisc) (BMinimalPolynomial : MinimalPolynomial) (BAlgebraicTrans : AlgebraicTrans) (BPerfectField : PerfectField) :
    ExceptT String IO SeparableExtension := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, new_definition, .. } := D
  let { FIELD_IMP_NONTRIVIAL_RING, FORALL_IN_IMAGE, .. } := D.core2
  let { IN_ELIM_THM, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, .. } := D.core3
  let { POLY_CLAUSES, .. } := D.core4
  let { POLY_EXTEND_CONST, POLY_EXTEND_EVALUATE, POLY_EXTEND_SUB, POLY_EXTEND_VAR,
        POLY_RING_CLAUSES, .. } := D.core5
  let { RING_COPRIME_00, RING_ISOMORPHISM, RING_ISOMORPHISM_I,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_POLYNOMIAL_CONST, RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_VAR, RING_SUB_REFL, .. } := D.core7
  let { TRIVIAL_POLY_RING, .. } := D.core8
  let { o_ASSOC, .. } := D.core9
  let { POLY_DERIV_0, POLY_SEPARABLE_DIVISOR, POLY_SEPARABLE_MONOMORPHIC_IMAGE,
        POLY_SEPARABLE_X_MINUS_A, .. } := D.core10
  let { poly_separable, .. } := D.core11
  let { FIELD_EXTENSION_CARRIER, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_IMP_MONOMORPHISM, FIELD_EXTENSION_ISOMORPHISM,
        FIELD_EXTENSION_REFL, FIELD_EXTENSION_TRANS, field_extension, .. } := BFieldExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, ALGEBRAIC_OVER_IMAGE, algebraic_extension, .. } := BAlgebraicExtension
  let { ALGEBRAIC_OVER_FIELD_EXTENSION, .. } := BAlgebraicExtensionProps
  let { ALGEBRAIC_EXTENSION_ISOMORPHISM, ALGEBRAIC_EXTENSION_TRANS_EQ, .. } := BAlgebraicExtMisc
  let { MINIMAL_POLYNOMIAL, MINIMAL_POLYNOMIAL_DIVIDES, MINIMAL_POLYNOMIAL_IN_CARRIER,
        MINIMAL_POLYNOMIAL_IRREDUCIBLE, minimal_polynomial, .. } := BMinimalPolynomial
  let { MINIMAL_POLYNOMIAL_MONOMORPHIC_IMAGE, .. } := BAlgebraicTrans
  let { PERFECT_FIELD_CHAR_0, PERFECT_FIELD_IMP_SEPARABLE, .. } := BPerfectField
  -- @@SCOPE END

  let separable_element ← new_definition
   r"separable_element (k:A ring,l:B ring) (h:A->B) (x:B) <=>
        poly_separable k (minimal_polynomial (k,l) h x)"

  let separable_extension ← new_definition
   r"separable_extension (k:A ring,l:B ring) (h:A->B) <=>
        algebraic_extension (k,l) h /\
        !x. x IN ring_carrier l ==> separable_element (k,l) h x"

  let SEPARABLE_IMP_ALGEBRAIC_EXTENSION ← prove
   r"!(h:A->B) k l.
        separable_extension (k,l) h ==> algebraic_extension (k,l) h"
   (SIMP_TAC [separable_extension])

  let SEPARABLE_IMP_FIELD_EXTENSION ← prove
   r"!(h:A->B) k l. separable_extension (k,l) h ==> field_extension (k,l) h"
   (SIMP_TAC [separable_extension, ALGEBRAIC_IMP_FIELD_EXTENSION])

  let SEPARABLE_ELEMENT_IMP_ALGEBRAIC ← prove
   r"!(h:A->B) k l x.
        field k /\ separable_element (k,l) h x ==> algebraic_over (k,l) h x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [separable_element, minimal_polynomial] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [poly_separable, POLY_DERIV_0] THEN
    MP_TAC (← ISPEC (← q r"poly_ring (k:A ring) (:1)") RING_COPRIME_00) THEN
    REWRITE_TAC [POLY_RING_CLAUSES, TRIVIAL_POLY_RING] THEN
    MESON_TAC [FIELD_IMP_NONTRIVIAL_RING])

  let PERFECT_FIELD_IMP_SEPARABLE_ELEMENT ← prove
   r"!(h:A->B) k l x.
        perfect_field k /\ field_extension (k,l) h /\ algebraic_over (k,l) h x
        ==> separable_element (k,l) h x"
   (SIMP_TAC [separable_element, PERFECT_FIELD_IMP_SEPARABLE,
              MINIMAL_POLYNOMIAL_IRREDUCIBLE])

  let PERFECT_FIELD_IMP_SEPARABLE_EXTENSION ← prove
   r"!(h:A->B) k l.
        perfect_field k /\ algebraic_extension (k,l) h
        ==> separable_extension (k,l) h"
   (SIMP_TAC [separable_extension, algebraic_extension,
              PERFECT_FIELD_IMP_SEPARABLE_ELEMENT])

  let SEPARABLE_ELEMENT_CHAR0 ← prove
   r"!(h:A->B) k l x.
        field_extension (k,l) h /\ ring_char k = 0 /\ algebraic_over (k,l) h x
        ==> separable_element (k,l) h x"
   (MESON_TAC [PERFECT_FIELD_IMP_SEPARABLE_ELEMENT, PERFECT_FIELD_CHAR_0,
               field_extension])

  let SEPARABLE_EXTENSION_CHAR0 ← prove
   r"!(h:A->B) k l.
        algebraic_extension (k,l) h /\ ring_char k = 0
        ==> separable_extension (k,l) h"
   (MESON_TAC [PERFECT_FIELD_IMP_SEPARABLE_EXTENSION, PERFECT_FIELD_CHAR_0,
               ALGEBRAIC_IMP_FIELD_EXTENSION, field_extension])

  let SEPARABLE_ELEMENT_IMAGE ← prove
   r"!(h:A->B) k l x.
        field_extension (k,l) h /\ x IN ring_carrier k
        ==> separable_element (k,l) h (h x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [separable_element] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    SUBGOAL_THEN (← q r"(h:A->B) x IN ring_carrier l") ASSUME_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_CARRIER], ALL_TAC] THEN
    MATCH_MP_TAC POLY_SEPARABLE_DIVISOR THEN
    EXISTS_TAC (← q r"poly_sub k (poly_var k one) (poly_const k (x:A))") THEN
    SUBGOAL_THEN
     (← q r"poly_sub k (poly_var k one) (poly_const k (x:A)) IN
      ring_carrier(poly_ring k (:1))")
    ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM POLY_CLAUSES, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [RING_POLYNOMIAL_SUB, RING_POLYNOMIAL_VAR,
                    RING_POLYNOMIAL_CONST],
      ALL_TAC] THEN
    ASM_SIMP_TAC [POLY_SEPARABLE_X_MINUS_A, MINIMAL_POLYNOMIAL_IN_CARRIER,
                  MINIMAL_POLYNOMIAL_DIVIDES, ALGEBRAIC_OVER_IMAGE] THEN
    ASM_SIMP_TAC [POLY_EXTEND_SUB, POLY_EXTEND_VAR, POLY_EXTEND_CONST,
                  RING_POLYNOMIAL_VAR, RING_POLYNOMIAL_CONST, RING_SUB_REFL])

  let SEPARABLE_EXTENSION_ISOMORPHISM ← prove
   r"!(f:A->B) k l.
        (field k \/ field l) /\ ring_isomorphism (k,l) f
        ==> separable_extension (k,l) f"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [separable_extension, ALGEBRAIC_EXTENSION_ISOMORPHISM] THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE I [RING_ISOMORPHISM] o
      CONJUNCT2) THEN
    DISCH_THEN (SUBST1_TAC o SYM o CONJUNCT1) THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SEPARABLE_ELEMENT_IMAGE THEN
    ASM_SIMP_TAC [FIELD_EXTENSION_ISOMORPHISM])

  let SEPARABLE_EXTENSION_REFL ← prove
   r"!k:A ring. separable_extension (k,k) I <=> field k"
   (MESON_TAC [SEPARABLE_IMP_FIELD_EXTENSION, FIELD_EXTENSION_REFL,
               SEPARABLE_EXTENSION_ISOMORPHISM, RING_ISOMORPHISM_I])

  let SEPARABLE_EXTENSION_SUBFIELD ← prove
   r"!(f:A->B) (g:B->C) k l m.
        field_extension (k,l) f /\ field_extension (l,m) g /\
        separable_extension (k,m) (g o f)
        ==> separable_extension (k,l) f"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
      ALGEBRAIC_EXTENSION_TRANS_EQ) THEN
    ASM_REWRITE_TAC [separable_extension, separable_element] THEN
    DISCH_THEN SUBST1_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"x:B") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g:B->C) x")) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [FIELD_EXTENSION_CARRIER],
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_MONOMORPHIC_IMAGE,
                    FIELD_EXTENSION_IMP_HOMOMORPHISM,
                    FIELD_EXTENSION_IMP_MONOMORPHISM]])

  let SEPARABLE_ELEMENT_INTERMEDIATE ← prove
   r"!(f:A->B) (g:B->C) k l m x.
        field_extension (k,l) f /\ field_extension (l,m) g /\
        separable_element (k,m) (g o f) x
        ==> separable_element (l,m) g x"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"field k /\ field l /\ ring_homomorphism (k,l) (f:A->B) /\
      field_extension (k,m) ((g:B->C) o f)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [field_extension, FIELD_EXTENSION_IMP_HOMOMORPHISM,
                     FIELD_EXTENSION_TRANS],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"algebraic_over (k,m) ((g:B->C) o (f:A->B)) x /\ algebraic_over (l,m) g x")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [SEPARABLE_ELEMENT_IMP_ALGEBRAIC,
                     ALGEBRAIC_OVER_FIELD_EXTENSION],
      ALL_TAC] THEN
    UNDISCH_TAC (← q r"separable_element (k,m) ((g:B->C) o (f:A->B)) x") THEN
    REWRITE_TAC [separable_element] THEN
    ABBREV_TAC (← q r"p = minimal_polynomial (k,m) ((g:B->C) o (f:A->B)) x") THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"(g:B->C) o (f:A->B)", ← q r"k:A ring", ← q r"m:C ring", ← q r"x:C"]
      MINIMAL_POLYNOMIAL) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MATCH_MP_TAC POLY_SEPARABLE_DIVISOR THEN
    EXISTS_TAC (← q r"(f:A->B) o (p:(1->num)->A)") THEN
    SUBGOAL_THEN (← q r"(f:A->B) o (p:(1->num)->A) IN ring_carrier(poly_ring l (:1))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_DIVIDES] THEN
    CONJ_TAC THENL
     [UNDISCH_TAC
       (← q r"poly_extend (k,m) ((g:B->C) o (f:A->B)) (\v:1. x) p = ring_0 m") THEN
      ASM_SIMP_TAC [POLY_EXTEND_EVALUATE, FIELD_EXTENSION_IMP_HOMOMORPHISM,
                    o_ASSOC],
      MATCH_MP_TAC POLY_SEPARABLE_MONOMORPHIC_IMAGE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC []])

  let SEPARABLE_EXTENSION_INTERMEDIATE ← prove
   r"!(f:A->B) (g:B->C) k l m.
        field_extension (k,l) f /\ field_extension (l,m) g /\
        separable_extension (k,m) (g o f)
        ==> separable_extension (l,m) g"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
      ALGEBRAIC_EXTENSION_TRANS_EQ) THEN
    ASM_REWRITE_TAC [separable_extension] THEN
    DISCH_THEN SUBST1_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [SEPARABLE_ELEMENT_INTERMEDIATE])

  -- @@RETURN BEGIN
  return { separable_element, separable_extension, SEPARABLE_IMP_ALGEBRAIC_EXTENSION,
           SEPARABLE_IMP_FIELD_EXTENSION, SEPARABLE_ELEMENT_IMP_ALGEBRAIC,
           PERFECT_FIELD_IMP_SEPARABLE_ELEMENT, PERFECT_FIELD_IMP_SEPARABLE_EXTENSION,
           SEPARABLE_ELEMENT_CHAR0, SEPARABLE_EXTENSION_CHAR0, SEPARABLE_ELEMENT_IMAGE,
           SEPARABLE_EXTENSION_ISOMORPHISM, SEPARABLE_EXTENSION_REFL,
           SEPARABLE_EXTENSION_SUBFIELD, SEPARABLE_ELEMENT_INTERMEDIATE,
           SEPARABLE_EXTENSION_INTERMEDIATE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- A nonzero polynomial is separable iff its image has as many distinct      -/
/- roots as its degree, in an algebraically closed field or in any field     -/
/- where it splits; an inseparable one has fewer roots in every field.       -/
/- (fieldtheory.ml 11068-11274)                                              -/
/- ------------------------------------------------------------------------- -/

structure SeparableRoots where
  -- @@FIELDS
  POLY_SEPARABLE_ROOT_COUNT_EQ : thm
  POLY_INSEPARABLE_ROOTS_LT_DEG : thm
  POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT_EQ : thm
  POLY_SPLITS_OVER_DISTINCT_ROOTS : thm
  POLY_SEPARABLE_ROOT_DERIV : thm
  deriving Inhabited

@[nospecialize]
def setupSeparableRoots [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BAlgebraicExtension : AlgebraicExtension) (BPolySquarefree : PolySquarefree) (BAlgebraicClosure : AlgebraicClosure) (BSplitsOver : SplitsOver) (BPerfectField : PerfectField) :
    ExceptT String IO SeparableRoots := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, TAUT, .. } := D
  let { CARD_IMAGE_INJ, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FORALL_IN_IMAGE, HAS_SIZE, .. } := D.core2
  let { IN_ELIM_THM, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { PID_IMP_BEZOUT_RING, PID_POLY_RING, POLY_DEG_MONOMORPHIC_IMAGE,
        POLY_EQ_0_MONOMORPHIC_IMAGE, POLY_EVAL, POLY_EVAL_HOMOMORPHIC_IMAGE, .. } := D.core4
  let { POLY_EXTEND_EVALUATE, POLY_RING_CLAUSES, POLY_ROOT_BOUND, RING_0, RING_ADD,
        RING_ADD_LZERO, .. } := D.core5
  let { RING_HOMOMORPHISM_0, RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_ADD,
        RING_HOMOMORPHISM_MUL, RING_HOMOMORPHISM_POLY_EXTEND,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, RING_MUL, .. } := D.core6
  let { RING_MUL_LZERO, RING_POLYNOMIAL, .. } := D.core7
  let { SUBSET, field, .. } := D.core8
  let { o_ASSOC, poly_eval, ring_monomorphism, .. } := D.core9
  let { BEZOUT_RING_COPRIME, CARD_SUBSET, CARD_SUBSET_EQ, EQ_IMP_LE, EQ_TRANS,
        LET_TRANS, LE_TRANS, LT_REFL, POLY_DERIV_IN_CARRIER,
        POLY_ROOT_COUNT_IMP_SPLITS, POLY_SEPARABLE_FROM_MONOMORPHIC_IMAGE,
        POLY_SEPARABLE_MONOMORPHIC_IMAGE, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { poly_separable, ring_coprime, .. } := D.core11
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_TRANS, field_extension, .. } := BFieldExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, .. } := BAlgebraicExtension
  let { POLY_SQUAREFREE_ROOT_COUNT_EQ, .. } := BPolySquarefree
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { POLY_ROOT_BOUND_EXTENSION, POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT,
        poly_splits_over, .. } := BSplitsOver
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_PERFECT, PERFECT_FIELD_SEPARABLE_EQ_SQUAREFREE, .. } := BPerfectField
  -- @@SCOPE END

  let POLY_SEPARABLE_ROOT_COUNT_EQ ← prove
   r"!(h:A->B) k l p.
        field_extension (k,l) h /\ algebraically_closed_field l
        ==> (poly_separable k p <=>
             p IN ring_carrier(poly_ring k (:1)) /\ ~(p = poly_0 k) /\
             CARD {x | x IN ring_carrier l /\
                       poly_eval l (h o p) x = ring_0 l} =
             poly_deg k p)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    ASM_CASES_TAC (← q r"(p:(1->num)->A) IN ring_carrier(poly_ring k (:1))") THENL
     [ALL_TAC, ASM_MESON_TAC [poly_separable, ring_coprime]] THEN
    TRANS_TAC EQ_TRANS (← q r"poly_separable l ((h:A->B) o p)") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [POLY_SEPARABLE_MONOMORPHIC_IMAGE,
                     POLY_SEPARABLE_FROM_MONOMORPHIC_IMAGE],
      ASM_SIMP_TAC [PERFECT_FIELD_SEPARABLE_EQ_SQUAREFREE,
                    ALGEBRAICALLY_CLOSED_FIELD_IMP_PERFECT,
                    POLY_SQUAREFREE_ROOT_COUNT_EQ]] THEN
    SUBGOAL_THEN
     (← q r"(h:A->B) o (p:(1->num)->A) IN ring_carrier(poly_ring l (:1)) /\
      (h o p = poly_0 l <=> p = poly_0 k) /\ poly_deg l (h o p) = poly_deg k p")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [IN_RING_POLYNOMIAL_CARRIER_COMPOSE, RING_POLYNOMIAL,
                     POLY_EQ_0_MONOMORPHIC_IMAGE, POLY_DEG_MONOMORPHIC_IMAGE],
      ASM_REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 POLY_RING_CLAUSES)]])

  let POLY_INSEPARABLE_ROOTS_LT_DEG ← prove
   r"!(h:A->B) k l p.
        field_extension (k,l) h /\ p IN ring_carrier(poly_ring k (:1)) /\
        ~(p = poly_0 k) /\ ~poly_separable k p
        ==> CARD {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l}
            < poly_deg k p"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"l:B ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [field_extension], ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:(B#num)ring", ← q r"j:B->B#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    SUBGOAL_THEN (← q r"field_extension(k,m) ((j:B->B#num) o (h:A->B))")
    ASSUME_TAC THENL [ASM_MESON_TAC [FIELD_EXTENSION_TRANS], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"(j:B->B#num) o (h:A->B)", ← q r"k:A ring", ← q r"m:(B#num)ring",
                      ← q r"p:(1->num)->A"] POLY_SEPARABLE_ROOT_COUNT_EQ) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"ring_polynomial k (p:(1->num)->A)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [RING_POLYNOMIAL], ALL_TAC] THEN
    MAP_EVERY (fun c => FIRST_ASSUM (fun t => tactic_of do
        if !((← liftExcept (rand (concl t))) == c) then throw "check"
        pure ((STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) t)))
     [← q r"h:A->B", ← q r"j:B->B#num", ← q r"(j:B->B#num) o (h:A->B)"] THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"m:(B#num)ring", ← q r"(j:B->B#num) o (h:A->B)",
                      ← q r"p:(1->num)->A"] POLY_EQ_0_MONOMORPHIC_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"m:(B#num)ring", ← q r"(j:B->B#num) o (h:A->B)",
                      ← q r"p:(1->num)->A"] POLY_DEG_MONOMORPHIC_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"p:(1->num)->A"]
      POLY_EQ_0_MONOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"(h:A->B) o (p:(1->num)->A) IN ring_carrier(poly_ring l (:1)) /\
      ((j:B->B#num) o (h:A->B)) o p IN ring_carrier(poly_ring m (:1))")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN
      ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"m:(B#num)ring",
                      ← q r"((j:B->B#num) o (h:A->B)) o (p:(1->num)->A)"]
      POLY_ROOT_BOUND) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"(h:A->B) o (p:(1->num)->A)"] POLY_ROOT_BOUND) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN,
                  ← CONJUNCT1 (← CONJUNCT2 POLY_RING_CLAUSES)] THEN
    REPEAT STRIP_TAC THEN TRANS_TAC LET_TRANS
     (← q r"CARD {x | x IN ring_carrier m /\
               poly_eval m (((j:B->B#num) o (h:A->B)) o (p:(1->num)->A)) x =
               ring_0 m}") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_ARITH_TAC] THEN
    TRANS_TAC LE_TRANS
     (← q r"CARD(IMAGE (j:B->B#num) {x | x IN ring_carrier l /\
                               poly_eval l ((h:A->B) o (p:(1->num)->A)) x =
                               ring_0 l})") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC CARD_IMAGE_INJ THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      FIRST_ASSUM (fun th => tactic_of do
        let c ← q r"j:B->B#num"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE I [ring_monomorphism]) th)) THEN
      MESON_TAC [],
      MATCH_MP_TAC CARD_SUBSET THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:B") THEN STRIP_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        let c ← q r"j:B->B#num"
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) th)) THEN
      MP_TAC (← ISPECL [← q r"l:B ring", ← q r"m:(B#num)ring", ← q r"x:B", ← q r"j:B->B#num",
                        ← q r"(h:A->B) o (p:(1->num)->A)"]
        POLY_EVAL_HOMOMORPHIC_IMAGE) THEN
      ASM_REWRITE_TAC [← GSYM o_ASSOC] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN EXISTS_TAC (← q r"l:B ring"),
        MATCH_MP_TAC RING_HOMOMORPHISM_0] THEN
      ASM_REWRITE_TAC []])

  let POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT_EQ ← prove
   r"!(h:A->B) k l p.
        field_extension (k,l) h /\ p IN ring_carrier(poly_ring k (:1)) /\
        ~(p = poly_0 k) /\ poly_splits_over (k,l) h p
        ==> (poly_separable k p <=>
             CARD {x | x IN ring_carrier l /\
                       poly_eval l (h o p) x = ring_0 l} =
             poly_deg k p)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT],
      ASM_MESON_TAC [POLY_INSEPARABLE_ROOTS_LT_DEG, LT_REFL]])

  let POLY_SPLITS_OVER_DISTINCT_ROOTS ← prove
   r"!(h:A->B) k l p s.
        field_extension(k,l) h /\
        p IN ring_carrier(poly_ring k (:1)) /\ ~(p = poly_0 k) /\
        s HAS_SIZE poly_deg k p /\
        (!x. x IN s
             ==> x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l)
        ==> {x | x IN ring_carrier l /\ poly_eval l (h o p) x = ring_0 l} = s /\
            poly_splits_over(k,l) h p /\ poly_separable k p"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
      POLY_ROOT_BOUND_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC
     (← q r"R = {x | x IN ring_carrier l /\
               poly_eval l ((h:A->B) o (p:(1->num)->A)) x = ring_0 l}") THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [HAS_SIZE]) THEN
    SUBGOAL_THEN (← q r"(s:B->bool) SUBSET R") ASSUME_TAC THENL
     [EXPAND_TAC "R" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"R:B->bool = s") SUBST_ALL_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC CARD_SUBSET_EQ THEN
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"s:B->bool", ← q r"R:B->bool"] CARD_SUBSET) THEN
      ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
    SUBGOAL_THEN (← q r"ring_polynomial k (p:(1->num)->A)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [RING_POLYNOMIAL], ALL_TAC] THEN
    REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REWRITE_TAC [poly_splits_over] THEN
      MATCH_MP_TAC POLY_ROOT_COUNT_IMP_SPLITS THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"p:(1->num)->A"]
        POLY_EQ_0_MONOMORPHIC_IMAGE) THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"h:A->B", ← q r"p:(1->num)->A"]
        POLY_DEG_MONOMORPHIC_IMAGE) THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN REPEAT DISCH_TAC THEN
      MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN
      ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM],
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"p:(1->num)->A"]
        POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT_EQ) THEN
      ASM_REWRITE_TAC []])

  /- At a root of a separable polynomial its derivative does not vanish
     (POLY_SEPARABLE_ROOT_DERIV): evaluate a Bezout relation u p + v p' = 1
     there. -/
  let POLY_SEPARABLE_ROOT_DERIV ← prove
   r"!(h:A->B) k l p x.
        field_extension(k,l) h /\ p IN ring_carrier(poly_ring k (:1)) /\
        poly_separable k p /\ x IN ring_carrier l /\
        poly_eval l (h o p) x = ring_0 l
        ==> ~(poly_eval l (h o poly_deriv k p) x = ring_0 l)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"field(k:A ring) /\ field(l:B ring)") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [field_extension], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM) THEN
    MP_TAC (← ISPECL [← q r"poly_ring (k:A ring) (:1)", ← q r"p:(1->num)->A",
                      ← q r"poly_deriv k (p:(1->num)->A)"] BEZOUT_RING_COPRIME) THEN
    ASM_SIMP_TAC [PID_IMP_BEZOUT_RING, PID_POLY_RING] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [poly_separable]) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(1->num)->A") (X_CHOOSE_THEN (← q r"v:(1->num)->A")
      STRIP_ASSUME_TAC) o CONJUNCT2) THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"(:1)", ← q r"h:A->B", ← q r"\v:1. (x:B)"]
      RING_HOMOMORPHISM_POLY_EXTEND) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!q. poly_extend (k,l) (h:A->B) (\v:1. x) q = poly_eval l (h o q) x")
    ASSUME_TAC THENL
     [ASM_SIMP_TAC [POLY_EXTEND_EVALUATE, poly_eval], ALL_TAC] THEN
    DISCH_TAC THEN
    UNDISCH_TAC
     (← q r"ring_add (poly_ring k (:1))
        (ring_mul (poly_ring k (:1)) p (u:(1->num)->A))
        (ring_mul (poly_ring k (:1)) (poly_deriv k p) v) =
      ring_1 (poly_ring k (:1))") THEN
    DISCH_THEN (MP_TAC o AP_TERM (← q r"poly_extend (k,l) (h:A->B) (\v:1. x)")) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"ring_homomorphism (poly_ring (k:A ring) (:1),l:B ring)"
      if !((← liftExcept (rator (concl th))) == c) then throw "check"
      pure (ASM_SIMP_TAC [RING_ADD, RING_MUL,
        POLY_DERIV_IN_CARRIER, ← MATCH_MP RING_HOMOMORPHISM_ADD th,
        ← MATCH_MP RING_HOMOMORPHISM_MUL th, ← MATCH_MP RING_HOMOMORPHISM_1 th])) THEN
    ASM_SIMP_TAC [RING_MUL_LZERO, RING_ADD_LZERO, POLY_EVAL, RING_0] THEN
    MP_TAC (← ASSUME (← q r"field(l:B ring)")) THEN REWRITE_TAC [field] THEN MESON_TAC [])

  -- @@RETURN BEGIN
  return { POLY_SEPARABLE_ROOT_COUNT_EQ, POLY_INSEPARABLE_ROOTS_LT_DEG,
           POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT_EQ, POLY_SPLITS_OVER_DISTINCT_ROOTS,
           POLY_SEPARABLE_ROOT_DERIV }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Linear independence of ring homomorphisms (Dedekind and Artin): distinct  -/
/- homomorphisms into an integral domain are linearly independent over it.   -/
/- (fieldtheory.ml 11275-11409)                                              -/
/- ------------------------------------------------------------------------- -/

structure HomomorphismsIndependent where
  -- @@FIELDS
  RING_HOMOMORPHISMS_INDEPENDENT : thm
  RING_HOMOMORPHISMS_INDEPENDENT_SET : thm
  deriving Inhabited

@[nospecialize]
def setupHomomorphismsIndependent [HolBase] (D : FieldTheoryDeps) :
    ExceptT String IO HomomorphismsIndependent := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, RING_RULE, SET_TAC, .. } := D
  let { FINITE_INDUCT_STRONG, FINITE_INSERT, FORALL_IN_INSERT, .. } := D.core2
  let { INSERT_SUBSET, INTEGRAL_DOMAIN_MUL_EQ_0, IN_INSERT, .. } := D.core3
  let { NOT_IN_EMPTY, .. } := D.core4
  let { RING_0, RING_1, RING_ADD_LZERO, RING_ADD_RZERO, .. } := D.core5
  let { RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_MUL, RING_MUL, .. } := D.core6
  let { RING_MUL_LZERO, RING_MUL_RID, RING_MUL_RZERO, RING_SUB, RING_SUB_EQ_0,
        RING_SUB_REFL, RING_SUM, RING_SUM_CLAUSES, RING_SUM_EQ, RING_SUM_EQ_0,
        RING_SUM_LMUL, RING_SUM_SUB, .. } := D.core7
  let { SUBSET_REFL, .. } := D.core8
  let { EQ_TRANS, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { RING_SUM_0, .. } := D.core11
  -- @@SCOPE END

  let RING_HOMOMORPHISMS_INDEPENDENT ← (do
    let lemma ← prove
     r"!(f:K->A->B) k l s d a y.
        FINITE s /\ (!i. i IN s ==> ring_homomorphism(k,l) (f i)) /\
        (!i. i IN s ==> d i IN ring_carrier l) /\
        a IN s /\ y IN ring_carrier k /\
        (!x. x IN ring_carrier k
             ==> ring_sum l s (\i. ring_mul l (d i) (f i x)) = ring_0 l)
        ==> !x. x IN ring_carrier k
                ==> ring_sum l s
                     (\i. ring_mul l
                           (ring_mul l (d i) (ring_sub l (f i y) (f a y)))
                           (f i x)) = ring_0 l"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!i x. i IN s /\ x IN ring_carrier k
              ==> (f:K->A->B) i x IN ring_carrier l /\
                  ring_mul l (d i) (f i x) IN ring_carrier l")
      ASSUME_TAC THENL
       [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER, RING_MUL], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"ring_mul k (y:A) x IN ring_carrier k") ASSUME_TAC THENL
       [ASM_SIMP_TAC [RING_MUL], ALL_TAC] THEN
      TRANS_TAC EQ_TRANS
       (← q r"ring_sum l s
          (\i. ring_sub l (ring_mul l (d i) ((f:K->A->B) i (ring_mul k y x)))
                          (ring_mul l (f a y) (ring_mul l (d i) (f i x))))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC RING_SUM_EQ THEN X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
        REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"ring_homomorphism(k,l) ((f:K->A->B) i)") MP_TAC THENL
         [ASM_SIMP_TAC [], ALL_TAC] THEN
        DISCH_THEN (fun th => tactic_of do
          pure (ASM_SIMP_TAC [← MATCH_MP RING_HOMOMORPHISM_MUL th])) THEN
        MATCH_MP_TAC (← RING_RULE
         (← q r"!r c u v w:B.
            c IN ring_carrier r /\ u IN ring_carrier r /\
            v IN ring_carrier r /\ w IN ring_carrier r
            ==> ring_mul r (ring_mul r c (ring_sub r u v)) w =
                ring_sub r (ring_mul r c (ring_mul r u w))
                           (ring_mul r v (ring_mul r c w))")) THEN
        ASM_SIMP_TAC [],
        ASM_SIMP_TAC [RING_SUM_SUB, RING_SUM_LMUL, RING_MUL, RING_MUL_RZERO,
                      RING_SUB_REFL, RING_0]])
    prove
     r"!(f:K->A->B) k l s c.
        integral_domain l /\ FINITE s /\
        (!i. i IN s ==> ring_homomorphism(k,l) (f i)) /\
        (!i j. i IN s /\ j IN s /\ ~(i = j)
               ==> ?x. x IN ring_carrier k /\ ~(f i x = f j x)) /\
        (!i. i IN s ==> c i IN ring_carrier l) /\
        (!x. x IN ring_carrier k
             ==> ring_sum l s (\i. ring_mul l (c i) (f i x)) = ring_0 l)
        ==> !i. i IN s ==> c i = ring_0 l"
     (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"!t. FINITE t
            ==> t SUBSET (s:K->bool)
                ==> !d. (!i. i IN t ==> d i IN ring_carrier l) /\
                        (!x. x IN ring_carrier k
                             ==> ring_sum l t
                                   (\i. ring_mul l (d i) ((f:K->A->B) i x)) =
                                 ring_0 l)
                        ==> !i. i IN t ==> d i = ring_0 l")
       (fun th => tactic_of do
          pure (MP_TAC (← SPEC (← q r"s:K->bool") th) THEN
                ASM_REWRITE_TAC [SUBSET_REFL] THEN DISCH_THEN MATCH_MP_TAC THEN
                ASM_REWRITE_TAC [])) THEN
      MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
      REWRITE_TAC [NOT_IN_EMPTY, INSERT_SUBSET] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:K", ← q r"t:K->bool"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      DISCH_THEN (fun ih => tactic_of do
        pure (STRIP_TAC THEN X_GEN_TAC (← q r"d:K->B") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "sum")) THEN
        MP_TAC (← MP ih (← ASSUME (← q r"(t:K->bool) SUBSET s"))))) THEN
      SUBGOAL_THEN
       (← q r"!i. i IN a INSERT t ==> ring_homomorphism(k,l) ((f:K->A->B) i)")
      ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!i x. i IN a INSERT t /\ x IN ring_carrier k
              ==> (f:K->A->B) i x IN ring_carrier l")
      ASSUME_TAC THENL [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
      DISCH_THEN (fun ih => tactic_of do
        pure (SUBGOAL_THEN (← q r"!i. i IN t ==> (d:K->B) i = ring_0 l") ASSUME_TAC THENL
         [X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPECL [← q r"i:K", ← q r"a:K"]) THEN
          ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"y:A") STRIP_ASSUME_TAC) THEN
          MP_TAC (← SPEC
           (← q r"\j. ring_mul l (d j) (ring_sub l ((f:K->A->B) j y) (f a y))") ih) THEN
          ANTS_TAC THENL
           [ASM_SIMP_TAC [RING_MUL, RING_SUB, IN_INSERT] THEN
            X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
            MP_TAC (← ISPECL [← q r"f:K->A->B", ← q r"k:A ring", ← q r"l:B ring",
                              ← q r"(a:K) INSERT t", ← q r"d:K->B", ← q r"a:K", ← q r"y:A"] lemma) THEN
            ASM_SIMP_TAC [FINITE_INSERT, IN_INSERT] THEN
            DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN
            ASM_SIMP_TAC [RING_SUM_CLAUSES, RING_MUL, RING_SUB, RING_0, IN_INSERT,
                          RING_SUB_REFL, RING_MUL_LZERO, RING_MUL_RZERO,
                          RING_ADD_LZERO, RING_SUM],
            DISCH_THEN (MP_TAC o SPEC (← q r"i:K")) THEN
            ASM_SIMP_TAC [INTEGRAL_DOMAIN_MUL_EQ_0, RING_SUB, RING_SUB_EQ_0,
                          IN_INSERT]],
          ALL_TAC])) THEN
      ASM_REWRITE_TAC [FORALL_IN_INSERT] THEN
      SUBGOAL_THEN
       (← q r"ring_sum l t (\i. ring_mul l (d i) ((f:K->A->B) i (ring_1 k))) =
        ring_0 l")
      ASSUME_TAC THENL
       [MATCH_MP_TAC RING_SUM_EQ_0 THEN
        ASM_SIMP_TAC [RING_MUL_LZERO, RING_1, IN_INSERT],
        ALL_TAC] THEN
      REMOVE_THEN "sum" (MP_TAC o SPEC (← q r"ring_1 k:A")) THEN
      SUBGOAL_THEN (← q r"ring_homomorphism(k,l) ((f:K->A->B) a)") MP_TAC THENL
       [ASM_SIMP_TAC [IN_INSERT], ALL_TAC] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (ASM_SIMP_TAC [RING_SUM_CLAUSES, RING_MUL, RING_1,
          IN_INSERT, RING_MUL_LZERO, RING_SUM_0, RING_ADD_RZERO, RING_MUL_RID,
          ← MATCH_MP RING_HOMOMORPHISM_1 th]))))

  let RING_HOMOMORPHISMS_INDEPENDENT_SET ← prove
   r"!k:A ring l:B ring s c.
        integral_domain l /\ FINITE s /\
        (!f. f IN s ==> ring_homomorphism(k,l) f) /\
        (!f g. f IN s /\ g IN s /\ ~(f = g)
               ==> ?x. x IN ring_carrier k /\ ~(f x = g x)) /\
        (!f. f IN s ==> c f IN ring_carrier l) /\
        (!x. x IN ring_carrier k
             ==> ring_sum l s (\f. ring_mul l (c f) (f x)) = ring_0 l)
        ==> !f. f IN s ==> c f = ring_0 l"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"\f:A->B. f", ← q r"k:A ring", ← q r"l:B ring", ← q r"s:(A->B)->bool",
                      ← q r"c:(A->B)->B"] RING_HOMOMORPHISMS_INDEPENDENT) THEN
    REWRITE_TAC [])

  -- @@RETURN BEGIN
  return { RING_HOMOMORPHISMS_INDEPENDENT, RING_HOMOMORPHISMS_INDEPENDENT_SET }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The extensions of a homomorphism g from k to a ring m along h from k to   -/
/- l, as homomorphisms from l to m, normalized to be EXTENSIONAL so that     -/
/- they form a set of the right size. For a finite extension there are at    -/
/- most [l:k] of them into an integral domain, and exactly [l:k] when l is   -/
/- separable and m is algebraically closed; for an algebraic extension and   -/
/- algebraically closed m their number depends neither on m nor on g.        -/
/- (fieldtheory.ml 11410-11686)                                              -/
/- ------------------------------------------------------------------------- -/

structure HomExtensions where
  -- @@FIELDS
  ring_homomorphism_extensions : thm
  RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS : thm
  RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY : thm
  RING_HOMOMORPHISM_EXTENSIONS_ROOT : thm
  RING_HOMOMORPHISM_EXTENSIONS_SIMPLE : thm
  FINITE_EXTENSION_NORMAL_CLOSURE : thm
  deriving Inhabited

@[nospecialize]
def setupHomExtensions [HolBase] (D : FieldTheoryDeps) (BSubfieldGenerated : SubfieldGenerated) (BSubfieldGenerated2 : SubfieldGenerated2) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BMinimalPolynomial : MinimalPolynomial) (BAlgebraicTrans : AlgebraicTrans) (BAcfBasic : AcfBasic) (BAcfSplit : AcfSplit) (BSimpleExtendHom : SimpleExtendHom) (BClosureExtendHom : ClosureExtendHom) (BSplitsOver : SplitsOver) (BSplittingExtension : SplittingExtension) (BFiniteNormal : FiniteNormal) :
    ExceptT String IO HomExtensions := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { EQ_IMP, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FORALL_IN_IMAGE, FORALL_IN_INSERT,
        FUN_EQ_THM, FUN_IN_IMAGE, IMAGE_UNION, .. } := D.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, IN_UNION, .. } := D.core3
  let { MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core4
  let { POLY_MONOMIAL_IN_CARRIER, RESTRICTION, .. } := D.core5
  let { RING_HOMOMORPHISM_COMPOSE, RING_HOMOMORPHISM_EQ,
        RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_POLYNOMIAL, RING_PRODUCT, .. } := D.core7
  let { SUBRING_GENERATED_IDEMPOT, SUBRING_GENERATED_INC_GEN, SUBSET, SUBSET_REFL,
        UNION_SUBSET, .. } := D.core8
  let { o_THM, .. } := D.core9
  let { EXISTS_UNIQUE_THM, EXTENSIONAL_EQ, MONIC_IMP_NONZERO, MONIC_POLY_PRODUCT,
        POLY_EVAL_RING_PRODUCT_EQ_0, RESTRICTION_IN_EXTENSIONAL,
        RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { eq_c, .. } := D.core11
  let { FIELD_SUBFIELD_GENERATED, SUBFIELD_GENERATED_MONO, .. } := BSubfieldGenerated
  let { SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE, .. } := BSubfieldGenerated2
  let { FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_IMP_SUBSET,
        FIELD_EXTENSION_TRANS, field_extension, .. } := BFieldExtension
  let { FINITE_IMP_FIELD_EXTENSION, FINITE_IMP_FINITELY_GENERATED_EXTENSION,
        finitely_generated_extension, .. } := BFiniteExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, ALGEBRAIC_OVER_SUBRING_GENERATED,
        algebraic_extension, algebraic_over, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { FINITE_SIMPLE_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { MINIMAL_POLYNOMIAL_IN_CARRIER, MINIMAL_POLYNOMIAL_MONIC,
        MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE, .. } := BMinimalPolynomial
  let { MINIMAL_POLYNOMIAL_SUBRING_GENERATED, .. } := BAlgebraicTrans
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS, .. } := BAcfSplit
  let { SIMPLE_ALGEBRAIC_EXTEND_HOMOMORPHISM_ROOT, .. } := BSimpleExtendHom
  let { ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM,
        ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM_ROOT, .. } := BClosureExtendHom
  let { POLY_ROOT_BOUND_EXTENSION, poly_splits_over, .. } := BSplitsOver
  let { SPLITTING_EXTENSION_GENERATED_BY_ROOTS, SPLITTING_IMP_FINITE_EXTENSION, .. } := BSplittingExtension
  let { NORMAL_EXTENSION_GENERATED_BY_ROOTS, .. } := BFiniteNormal
  -- @@SCOPE END

  let ring_homomorphism_extensions ← new_definition
   r"ring_homomorphism_extensions (k:A ring,l:B ring,m:C ring) (h:A->B,g:A->C) =
        {f | f IN EXTENSIONAL (ring_carrier l) /\
             ring_homomorphism (l,m) f /\
             !x. x IN ring_carrier k ==> f(h x) = g x}"

  let RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS ← prove
   r"!(h:A->B) (g:A->C) f k l m.
        ring_homomorphism (k,l) h /\ ring_homomorphism (l,m) f /\
        (!x. x IN ring_carrier k ==> f(h x) = g x)
        ==> RESTRICTION (ring_carrier l) f IN
            ring_homomorphism_extensions (k,l,m) (h,g)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM,
                 RESTRICTION_IN_EXTENSIONAL] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC RING_HOMOMORPHISM_EQ THEN EXISTS_TAC (← q r"f:B->C") THEN
      ASM_SIMP_TAC [RESTRICTION],
      ASM_MESON_TAC [RESTRICTION, RING_HOMOMORPHISM_IN_CARRIER]])

  let RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY ← prove
   r"!(h:A->B) (g:A->C) k l m.
        algebraic_extension (k,l) h /\ algebraically_closed_field m /\
        ring_homomorphism (k,m) g
        ==> ~(ring_homomorphism_extensions (k,l,m) (h,g) = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring", ← q r"h:A->B", ← q r"g:A->C"]
      ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM) THEN
    ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:B->C") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"RESTRICTION (ring_carrier l) (f:B->C)") THEN
    MATCH_MP_TAC RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS THEN
    ASM_MESON_TAC [ALGEBRAIC_IMP_FIELD_EXTENSION,
                   FIELD_EXTENSION_IMP_HOMOMORPHISM])

  let RING_HOMOMORPHISM_EXTENSIONS_ROOT ← prove
   r"!(h:A->B) (g:A->C) f k l m x.
        field_extension (k,l) h /\ algebraic_over (k,l) h x /\
        f IN ring_homomorphism_extensions (k,l,m) (h,g)
        ==> poly_eval m (g o minimal_polynomial (k,l) h x) (f x) = ring_0 m"
   (REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"f:B->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"x:B"] MINIMAL_POLYNOMIAL_VANISHES_HOMOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, o_THM] THEN X_GEN_TAC (← q r"i:1->num") THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN MATCH_MP_TAC POLY_MONOMIAL_IN_CARRIER THEN
    EXISTS_TAC (← q r"(:1)") THEN ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_IN_CARRIER])

  let RING_HOMOMORPHISM_EXTENSIONS_SIMPLE ← prove
   r"!(h:A->B) (g:A->C) k l m a.
        field_extension (k,l) h /\ algebraic_over (k,l) h a /\
        ring_homomorphism (k,m) g
        ==> ring_homomorphism_extensions
             (k,subring_generated l (a INSERT IMAGE h (ring_carrier k)),m)
             (h,g) =_c
            {b | b IN ring_carrier m /\
                 poly_eval m (g o minimal_polynomial (k,l) h a) b = ring_0 m}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o GEN_REWRITE_RULE I [algebraic_over]) THEN
    SUBGOAL_THEN
     (← q r"IMAGE (h:A->B) (ring_carrier k) SUBSET a INSERT IMAGE h (ring_carrier k)")
    ASSUME_TAC THENL [SET_TAC [], ALL_TAC] THEN
    ABBREV_TAC
     (← q r"K = subring_generated l ((a:B) INSERT IMAGE (h:A->B) (ring_carrier k))") THEN
    SUBGOAL_THEN
     (← q r"field_extension (k,K) (h:A->B) /\ a IN ring_carrier K /\
      algebraic_over (k,K) h a /\
      minimal_polynomial (k,K) h a = minimal_polynomial (k,l) h a")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN
      ASM_SIMP_TAC [FINITE_SIMPLE_ALGEBRAIC_EXTENSION, FINITE_IMP_FIELD_EXTENSION,
                    ALGEBRAIC_OVER_SUBRING_GENERATED, SUBRING_GENERATED_INC_GEN,
                    MINIMAL_POLYNOMIAL_SUBRING_GENERATED, IN_INSERT,
                    FIELD_EXTENSION_IMP_HOMOMORPHISM],
      ALL_TAC] THEN
    REWRITE_TAC [eq_c] THEN EXISTS_TAC (← q r"\f:B->C. f a") THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"f:B->C") THEN DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o
          REWRITE_RULE [ring_homomorphism_extensions, IN_ELIM_THM]) THEN
        ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER],
        FIRST_X_ASSUM (fun th => tactic_of do
          let c ← q r"minimal_polynomial (k,K) (h:A->B) a"
          if !((← liftExcept (lhand (concl th))) == c) then throw "check"
          pure (SUBST1_TAC (← SYM th))) THEN
        MATCH_MP_TAC RING_HOMOMORPHISM_EXTENSIONS_ROOT THEN
        ASM_REWRITE_TAC []],
      X_GEN_TAC (← q r"b:C") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      REWRITE_TAC [EXISTS_UNIQUE_THM, ring_homomorphism_extensions,
                   IN_ELIM_THM] THEN
      CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring", ← q r"h:A->B", ← q r"g:A->C",
                          ← q r"a:B", ← q r"b:C"]
          SIMPLE_ALGEBRAIC_EXTEND_HOMOMORPHISM_ROOT) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:B->C") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"RESTRICTION (ring_carrier K) (f:B->C)") THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"f:B->C", ← q r"k:A ring", ← q r"K:B ring",
                          ← q r"m:C ring"]
          RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS) THEN
        ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM] THEN
        REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN
        DISCH_THEN (fun th => REWRITE_TAC [th]) THEN ASM_SIMP_TAC [RESTRICTION],
        MAP_EVERY X_GEN_TAC [← q r"f1:B->C", ← q r"f2:B->C"] THEN STRIP_TAC THEN
        MATCH_MP_TAC EXTENSIONAL_EQ THEN EXISTS_TAC (← q r"ring_carrier K:B->bool") THEN
        ASM_REWRITE_TAC [] THEN
        MP_TAC (← ISPECL [← q r"f1:B->C", ← q r"f2:B->C", ← q r"K:B ring", ← q r"m:C ring",
                          ← q r"(a:B) INSERT IMAGE (h:A->B) (ring_carrier k)"]
          RING_HOMOMORPHISMS_EQ_FROM_SUBRING_GENERATED) THEN
        EXPAND_TAC "K" THEN
        REWRITE_TAC [← MATCH_MP SUBRING_GENERATED_IDEMPOT (← ISPEC
         (← q r"(a:B) INSERT IMAGE (h:A->B) (ring_carrier k)") SUBSET_REFL)] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [FORALL_IN_INSERT, FORALL_IN_IMAGE, IN_INSERT, IN_IMAGE] THEN
        ASM_MESON_TAC []]])

  let FINITE_EXTENSION_NORMAL_CLOSURE ← prove
   r"!(h:A->B) (j:B->C) k l m.
     finite_extension(k,l) h /\
     algebraically_closed_field m /\ ring_homomorphism(l,m) j
     ==> ?s. FINITE s /\
             (!x. x IN s
                  ==> ?e. ring_homomorphism(l,m) e /\
                          (!y. y IN ring_carrier k ==> e(h y) = j(h y)) /\
                          x IN IMAGE e (ring_carrier l)) /\
             (!e. ring_homomorphism(l,m) e /\
                  (!y. y IN ring_carrier k ==> e(h y) = j(h y))
                  ==> IMAGE e (ring_carrier l) SUBSET
                      ring_carrier(subfield_generated m
                        (IMAGE (j o h) (ring_carrier k) UNION s))) /\
             finite_extension
              (k,subfield_generated m (IMAGE (j o h) (ring_carrier k) UNION s))
              (j o h) /\
             normal_extension
              (k,subfield_generated m (IMAGE (j o h) (ring_carrier k) UNION s))
              (j o h)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_ALGEBRAIC_EXTENSION) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_FIELD_EXTENSION) THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"field_extension(k:A ring,l:B ring) h"
      if !(concl th == c) then throw "check"
      pure ((STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) th)) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) THEN
    SUBGOAL_THEN (← q r"ring_homomorphism(k:A ring,m:C ring) ((j:B->C) o (h:A->B))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"field_extension(k:A ring,m:C ring) ((j:B->C) o (h:A->B))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_EXTENSION_TRANS THEN EXISTS_TAC (← q r"l:B ring") THEN
      ASM_REWRITE_TAC [field_extension] THEN
      MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FINITE_IMP_FINITELY_GENERATED_EXTENSION) THEN
    REWRITE_TAC [finitely_generated_extension] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:B->bool") (CONJUNCTS_THEN2 ASSUME_TAC
      (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "l"))) o CONJUNCT2) THEN
    SUBGOAL_THEN (← q r"!x. x IN b ==> algebraic_over(k,l) (h:A->B) x")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [algebraic_extension, SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_product (poly_ring k (:1)) b (minimal_polynomial(k,l) (h:A->B))
      IN ring_carrier(poly_ring k (:1)) /\
      ~(ring_product (poly_ring k (:1)) b (minimal_polynomial(k,l) (h:A->B)) =
        poly_0 k)")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [RING_PRODUCT] THEN MATCH_MP_TAC MONIC_IMP_NONZERO THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING, RING_POLYNOMIAL, RING_PRODUCT] THEN
      MATCH_MP_TAC MONIC_POLY_PRODUCT THEN
      ASM_SIMP_TAC [MINIMAL_POLYNOMIAL_MONIC, RING_POLYNOMIAL,
                    MINIMAL_POLYNOMIAL_IN_CARRIER],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN ring_carrier m
          ==> (poly_eval m (((j:B->C) o (h:A->B)) o
                 ring_product (poly_ring k (:1)) b (minimal_polynomial(k,l) h))
                 x = ring_0 m <=>
               ?y. y IN b /\
                   poly_eval m ((j o h) o minimal_polynomial(k,l) h y) x =
                   ring_0 m)")
    (LABEL_TAC "roots") THENL
     [REPEAT STRIP_TAC THEN
      wPart lhand (fun t => do lhand (← rand t)) POLY_EVAL_RING_PRODUCT_EQ_0 THEN
      ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, MINIMAL_POLYNOMIAL_IN_CARRIER],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"P = ring_product (poly_ring k (:1)) b
            (minimal_polynomial(k,l) (h:A->B))") THEN
    EXISTS_TAC
     (← q r"{x | x IN ring_carrier m /\
           poly_eval m (((j:B->C) o (h:A->B)) o P) x = ring_0 m}") THEN
    SUBGOAL_THEN (← q r"poly_splits_over (k,m) ((j:B->C) o (h:A->B)) P")
    ASSUME_TAC THENL
     [REWRITE_TAC [poly_splits_over] THEN
      MATCH_MP_TAC ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
      EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"(j:B->C) o (h:A->B)", ← q r"k:A ring", ← q r"m:C ring",
                        ← q r"P:(1->num)->A"] POLY_ROOT_BOUND_EXTENSION) THEN
      ASM_SIMP_TAC [],
      REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"r:C") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      USE_THEN "roots" (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP th
          (← ASSUME (← q r"(r:C) IN ring_carrier m"))])) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:B") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring", ← q r"h:A->B",
                        ← q r"(j:B->C) o (h:A->B)", ← q r"y:B", ← q r"r:C"]
        ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM_ROOT) THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [o_THM]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:B->C") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      ALL_TAC,
      MATCH_MP_TAC SPLITTING_IMP_FINITE_EXTENSION THEN
      EXISTS_TAC (← q r"P:(1->num)->A") THEN
      MATCH_MP_TAC SPLITTING_EXTENSION_GENERATED_BY_ROOTS THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC NORMAL_EXTENSION_GENERATED_BY_ROOTS THEN
      ASM_REWRITE_TAC []] THEN
    X_GEN_TAC (← q r"e:B->C") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"ring_monomorphism(l:B ring,m:C ring) e") ASSUME_TAC THENL
     [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
      ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
      ALL_TAC] THEN
    USE_THEN "l" (fun th => tactic_of do
      pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV) [← SYM th])) THEN
    MP_TAC (← ISPECL [← q r"l:B ring", ← q r"m:C ring", ← q r"e:B->C",
                      ← q r"IMAGE (h:A->B) (ring_carrier k) UNION b"]
      SUBFIELD_GENERATED_BY_MONOMORPHIC_IMAGE) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED, UNION_SUBSET] THEN
      ASM_MESON_TAC [FIELD_EXTENSION_IMP_SUBSET],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC SUBFIELD_GENERATED_MONO THEN
    REWRITE_TAC [IMAGE_UNION, UNION_SUBSET] THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNION] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN DISJ1_TAC THEN
      ASM_SIMP_TAC [] THEN
      SUBST1_TAC (← SYM (← ISPECL [← q r"j:B->C", ← q r"h:A->B", ← q r"x:A"] o_THM)) THEN
      MATCH_MP_TAC FUN_IN_IMAGE THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"(x:C) IN t ==> x IN s UNION t")) THEN
    SUBGOAL_THEN (← q r"(y:B) IN ring_carrier l") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(e:B->C) y IN ring_carrier m") ASSUME_TAC THENL
     [MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
      EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC, ALL_TAC] THEN
    USE_THEN "roots" (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP th
        (← ASSUME (← q r"(e:B->C) y IN ring_carrier m"))])) THEN
    EXISTS_TAC (← q r"y:B") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->C) o (h:A->B)",
                      ← q r"RESTRICTION (ring_carrier l) (e:B->C)",
                      ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring", ← q r"y:B"]
      RING_HOMOMORPHISM_EXTENSIONS_ROOT) THEN
    ASM_SIMP_TAC [RESTRICTION] THEN DISCH_THEN MATCH_MP_TAC THEN
    MATCH_MP_TAC RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS THEN
    ASM_SIMP_TAC [o_THM])

  -- @@RETURN BEGIN
  return { ring_homomorphism_extensions, RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS,
           RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY, RING_HOMOMORPHISM_EXTENSIONS_ROOT,
           RING_HOMOMORPHISM_EXTENSIONS_SIMPLE, FINITE_EXTENSION_NORMAL_CLOSURE }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- Extensions of homomorphisms through a tower; counting them.               -/
/- (fieldtheory.ml 11687-12090)                                              -/
/- ------------------------------------------------------------------------- -/

structure HomExtensionsCount where
  -- @@FIELDS
  RING_HOMOMORPHISM_EXTENSIONS_TOWER : thm
  CARD_RING_HOMOMORPHISM_EXTENSIONS_LE : thm
  HAS_SIZE_RING_HOMOMORPHISM_EXTENSIONS : thm
  CARD_EQ_RING_HOMOMORPHISM_EXTENSIONS : thm
  deriving Inhabited

@[nospecialize]
def setupHomExtensionsCount [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BFinitary : Finitary) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BMinimalPolynomial : MinimalPolynomial) (BAlgebraicField : AlgebraicField) (BAcfBasic : AcfBasic) (BAcfSplit : AcfSplit) (BClosureExtendHom : ClosureExtendHom) (BAlgebraicClosure : AlgebraicClosure) (BSplitsOver : SplitsOver) (BSeparableExtension : SeparableExtension) (BHomExtensions : HomExtensions) :
    ExceptT String IO HomExtensionsCount := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, TAUT, .. } := D
  let { CARD_EQ_IMAGE, CARD_EQ_SYM, CARD_EQ_TRANS, CARD_FINITE_CONG,
        CARRIER_SUBRING_GENERATED_SUBRING, CONJ_ASSOC, DISJOINT, ETA_AX, EXTENSION, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FIELD_IMP_NONTRIVIAL_RING,
        FIELD_RING_HOMOMORPHISM_MONOMORPHISM, FINITE_INDUCT_STRONG, FORALL_IN_IMAGE,
        FUN_EQ_THM, FUN_IN_IMAGE, HAS_SIZE, IMAGE_I, .. } := D.core2
  let { INSERT_SUBSET, INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING, IN_ELIM_THM, IN_IMAGE,
        IN_INTER, IN_RING_POLYNOMIAL_CARRIER_COMPOSE, IN_UNION, I_O_ID,
        LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { NOT_IN_EMPTY, POLY_DEG_MONOMORPHIC_IMAGE, POLY_EQ_0_MONOMORPHIC_IMAGE, .. } := D.core4
  let { POLY_MONOMIAL_IN_CARRIER, POLY_RING_CLAUSES, POLY_ROOT_BOUND, RESTRICTION,
        RINGS_EQ, RING_1, RING_CARRIER_SUBRING_GENERATED_SUBSET, .. } := D.core5
  let { RING_HOMOMORPHISM_1, RING_HOMOMORPHISM_COMPOSE, RING_HOMOMORPHISM_INTO_SUBRING,
        RING_ISOMORPHISM_ONTO_IMAGE, RING_MONOMORPHISM_IMP_HOMOMORPHISM, .. } := D.core6
  let { RING_POLYNOMIAL, SUBRING_GENERATED, .. } := D.core7
  let { SUBRING_GENERATED_INC_GEN, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_TRANS,
        UNIONS_GSPEC, UNION_EMPTY, .. } := D.core8
  let { o_THM, ring_image, ring_isomorphism, ring_isomorphisms, .. } := D.core9
  let { CARD_EQ_CARD_IMP, EXTENSIONAL_EQ, FINITE_CARD_LE_UNIONS, HAS_SIZE_CARD,
        HAS_SIZE_UNIONS, POLY_ROOTS_MONOMORPHIC_IMAGE, RESTRICTION_EXTENSION,
        RESTRICTION_IN_EXTENSIONAL, RING_HOMOMORPHISM_IN_CARRIER, .. } := D.core10
  let { RING_MONOMORPHISM_INJECTIVE_EQ, SUBRING_GENERATED_INSERT, SUBRING_RING_IMAGE,
        pairwise, .. } := D.core11
  let { FIELD_EXTENSION_CARRIER, FIELD_EXTENSION_FROM_SUBRING_GENERATED,
        FIELD_EXTENSION_IMP_HOMOMORPHISM, FIELD_EXTENSION_INTO_INTERMEDIATE,
        FIELD_EXTENSION_REFL, field_extension, .. } := BFieldExtension
  let { RING_SPAN_SUBSET_SUBRING_GENERATED, .. } := BFinitary
  let { EXTENSION_DEGREE_TOWER_LAW, FINITE_EXTENSION, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, algebraic_extension, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { ALGEBRAIC_OVER_FIELD_EXTENSION, FINITE_SIMPLE_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { EXTENSION_DEGREE_SIMPLE, MINIMAL_POLYNOMIAL, .. } := BMinimalPolynomial
  let { ALGEBRAIC_OVER_1, FIELD_ALGEBRAIC_EXTENSION, .. } := BAlgebraicField
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS, .. } := BAcfSplit
  let { ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM, .. } := BClosureExtendHom
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT, poly_splits_over, .. } := BSplitsOver
  let { SEPARABLE_EXTENSION_INTERMEDIATE, separable_element, separable_extension, .. } := BSeparableExtension
  let { RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS, RING_HOMOMORPHISM_EXTENSIONS_ROOT,
        RING_HOMOMORPHISM_EXTENSIONS_SIMPLE, ring_homomorphism_extensions, .. } := BHomExtensions
  -- @@SCOPE END

  let RING_HOMOMORPHISM_EXTENSIONS_TOWER ← prove
   r"!(f:A->B) (g:B->C) (j:A->D) k l m n.
        ring_homomorphism (k,l) f /\ ring_homomorphism (l,m) g
        ==> ring_homomorphism_extensions (k,m,n) (g o f,j) =
            UNIONS {ring_homomorphism_extensions (l,m,n) (g,t) | t |
                    t IN ring_homomorphism_extensions (k,l,n) (f,j)} /\
            pairwise (\t t'. DISJOINT
                               (ring_homomorphism_extensions (l,m,n) (g,t))
                               (ring_homomorphism_extensions (l,m,n) (g,t')))
                     (ring_homomorphism_extensions (k,l,n) (f,j))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [pairwise, DISJOINT, EXTENSION, IN_INTER, NOT_IN_EMPTY,
                 UNIONS_GSPEC, ring_homomorphism_extensions, IN_ELIM_THM,
                 o_THM] THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"s:C->D") THEN EQ_TAC THENL
       [STRIP_TAC THEN
        EXISTS_TAC (← q r"RESTRICTION (ring_carrier l) ((s:C->D) o (g:B->C))") THEN
        CONJ_TAC THENL [ALL_TAC, ASM_SIMP_TAC [RESTRICTION, o_THM]] THEN
        MP_TAC (← ISPECL [← q r"f:A->B", ← q r"j:A->D", ← q r"(s:C->D) o (g:B->C)",
                          ← q r"k:A ring", ← q r"l:B ring", ← q r"n:D ring"]
          RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS) THEN
        REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM, o_THM] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_MESON_TAC [RING_HOMOMORPHISM_COMPOSE],
        DISCH_THEN (X_CHOOSE_THEN (← q r"t:B->D") STRIP_ASSUME_TAC) THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(f:A->B) x IN ring_carrier l") ASSUME_TAC THENL
         [MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
          EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
          ASM_SIMP_TAC []]],
      MAP_EVERY X_GEN_TAC [← q r"t:B->D", ← q r"t':B->D"] THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"s:C->D") THEN STRIP_TAC THEN
      UNDISCH_TAC (← q r"~(t:B->D = t')") THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC EXTENSIONAL_EQ THEN EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
      ASM_MESON_TAC []])

  let (CARD_RING_HOMOMORPHISM_EXTENSIONS_LE,
       HAS_SIZE_RING_HOMOMORPHISM_EXTENSIONS) ← (do
    let lemma ← prove
     r"!(h:A->B) (g:A->C) k l m a.
        field_extension (k,l) h /\ algebraic_over (k,l) h a /\
        integral_domain m /\ ring_homomorphism (k,m) g
        ==> FINITE(ring_homomorphism_extensions
                    (k,subring_generated l (a INSERT IMAGE h (ring_carrier k)),
                     m) (h,g)) /\
            CARD(ring_homomorphism_extensions
                  (k,subring_generated l (a INSERT IMAGE h (ring_carrier k)),
                   m) (h,g)) <=
            extension_degree
             (k,subring_generated l (a INSERT IMAGE h (ring_carrier k))) h /\
            (separable_element (k,l) h a /\ algebraically_closed_field m
             ==> CARD(ring_homomorphism_extensions
                       (k,subring_generated l
                            (a INSERT IMAGE h (ring_carrier k)),m) (h,g)) =
                 extension_degree
                  (k,subring_generated l (a INSERT IMAGE h (ring_carrier k)))
                  h)"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                        ← q r"a:B"] RING_HOMOMORPHISM_EXTENSIONS_SIMPLE) THEN
      ASM_SIMP_TAC [EXTENSION_DEGREE_SIMPLE] THEN
      ABBREV_TAC (← q r"p = minimal_polynomial (k,l) (h:A->B) a") THEN
      ABBREV_TAC (← q r"R = {b | b IN ring_carrier m /\
                           poly_eval m ((g:A->C) o (p:(1->num)->A)) b =
                           ring_0 m}") THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"a:B"]
        MINIMAL_POLYNOMIAL) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"ring_monomorphism(k:A ring,m:C ring) g") ASSUME_TAC THENL
       [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
        ASM_SIMP_TAC [INTEGRAL_DOMAIN_IMP_NONTRIVIAL_RING] THEN
        ASM_MESON_TAC [field_extension],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(g:A->C) o (p:(1->num)->A) IN ring_carrier(poly_ring m (:1)) /\
        ~(g o p = poly_0 m) /\ poly_deg m (g o p) = poly_deg k p")
      STRIP_ASSUME_TAC THENL
       [REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
          EXISTS_TAC (← q r"k:A ring") THEN ASM_REWRITE_TAC [],
          ASM_MESON_TAC [POLY_EQ_0_MONOMORPHIC_IMAGE, RING_POLYNOMIAL],
          ASM_MESON_TAC [POLY_DEG_MONOMORPHIC_IMAGE, RING_POLYNOMIAL]],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"m:C ring", ← q r"(g:A->C) o (p:(1->num)->A)"]
        POLY_ROOT_BOUND) THEN
      ASM_REWRITE_TAC [← CONJUNCT1 (← CONJUNCT2 POLY_RING_CLAUSES)] THEN STRIP_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (ASSUME_TAC (← MATCH_MP CARD_EQ_CARD_IMP
          (← CONJ (← ASSUME (← q r"FINITE(R:C->bool)")) th)))) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CARD_FINITE_CONG) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN EXPAND_TAC "R" THEN
      MATCH_MP_TAC POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT THEN
      ASM_SIMP_TAC [field_extension, ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [field_extension], ALL_TAC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [separable_element]] THEN
      REWRITE_TAC [poly_splits_over] THEN
      MATCH_MP_TAC ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS THEN
      ASM_REWRITE_TAC [])
    -- right to left: the second TAUT, the first TAUT, then the SET_RULE
    let t3 ← TAUT
     (← q r"(s2 ==> s1) ==> (a /\ b /\ (s1 /\ c ==> d)) ==>
                          (a /\ b /\ (s2 /\ c ==> d))")
    let t2 ← TAUT (← q r"p /\ (p ==> r) /\ (r ==> q) ==> p /\ q /\ r")
    let s1 ← SET_RULE (← q r"(a:B) IN s ==> s = a INSERT s")
    CONJ_PAIR (← prove
     r"(!(h:A->B) (g:A->C) k l m.
          finite_extension (k,l) h /\ integral_domain m /\
          ring_homomorphism (k,m) g
          ==> FINITE(ring_homomorphism_extensions (k,l,m) (h,g)) /\
              CARD(ring_homomorphism_extensions (k,l,m) (h,g)) <=
              extension_degree (k,l) h) /\
     (!(h:A->B) (g:A->C) k l m.
          finite_extension (k,l) h /\ separable_extension (k,l) h /\
          algebraically_closed_field m /\ ring_homomorphism (k,m) g
          ==> ring_homomorphism_extensions (k,l,m) (h,g) HAS_SIZE
              extension_degree (k,l) h)"
     (SUBGOAL_THEN
       (← q r"!(h:A->B) (g:A->C) k l m.
            finite_extension (k,l) h /\ integral_domain m /\
            ring_homomorphism (k,m) g
            ==> FINITE(ring_homomorphism_extensions (k,l,m) (h,g)) /\
                CARD(ring_homomorphism_extensions (k,l,m) (h,g)) <=
                extension_degree (k,l) h /\
                (separable_extension (k,l) h /\ algebraically_closed_field m
                 ==> CARD(ring_homomorphism_extensions (k,l,m) (h,g)) =
                     extension_degree (k,l) h)")
       (fun th => tactic_of do
          pure (CONJ_TAC THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
                MP_TAC (← SPEC_ALL th) THEN
                ASM_SIMP_TAC [HAS_SIZE, FIELD_IMP_INTEGRAL_DOMAIN,
                              ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD])) THEN
      REPEAT GEN_TAC THEN STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP FINITE_IMP_ALGEBRAIC_EXTENSION) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
      SUBGOAL_THEN
       (← q r"!s. FINITE s
            ==> s SUBSET ring_carrier l
                ==> FINITE(ring_homomorphism_extensions
                     (k,subring_generated l (IMAGE (h:A->B) (ring_carrier k)
                                             UNION s),m) (h,g:A->C)) /\
                    CARD(ring_homomorphism_extensions
                     (k,subring_generated l (IMAGE h (ring_carrier k) UNION s),
                      m) (h,g)) <=
                    extension_degree
                     (k,subring_generated l (IMAGE h (ring_carrier k) UNION s))
                     h /\
                    (separable_extension (k,l) h /\ algebraically_closed_field m
                     ==> CARD(ring_homomorphism_extensions
                          (k,subring_generated l
                               (IMAGE h (ring_carrier k) UNION s),m) (h,g)) =
                         extension_degree
                          (k,subring_generated l
                               (IMAGE h (ring_carrier k) UNION s)) h)")
      MP_TAC THENL
       [ALL_TAC,
        FIRST_ASSUM (fun th => tactic_of do
          let c ← q r"finite_extension(k:A ring,l:B ring) h"
          if !(concl th == c) then throw "check"
          pure ((MP_TAC o GEN_REWRITE_RULE I [FINITE_EXTENSION]) th)) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:B->bool") STRIP_ASSUME_TAC o CONJUNCT2) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"b:B->bool")) THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN
         (← q r"subring_generated l (IMAGE (h:A->B) (ring_carrier k) UNION b) = l")
         (fun th => REWRITE_TAC [th]) THEN
        REWRITE_TAC [RINGS_EQ, ← CONJUNCT2 SUBRING_GENERATED] THEN
        REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ,
                     RING_CARRIER_SUBRING_GENERATED_SUBSET] THEN
        ASM_MESON_TAC [SUBSET_TRANS, RING_SPAN_SUBSET_SUBRING_GENERATED]] THEN
      MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
       [DISCH_TAC THEN REWRITE_TAC [UNION_EMPTY] THEN
        SUBGOAL_THEN
         (← q r"IMAGE (h:A->B) (ring_carrier k) =
          ring_1 l INSERT IMAGE h (ring_carrier k)")
        SUBST1_TAC THENL
         [MATCH_MP_TAC s1 THEN
          REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"ring_1 k:A") THEN
          ASM_MESON_TAC [RING_HOMOMORPHISM_1, RING_1,
                         FIELD_EXTENSION_IMP_HOMOMORPHISM],
          ALL_TAC] THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring",
                          ← q r"ring_1 l:B"] lemma) THEN
        ASM_SIMP_TAC [ALGEBRAIC_OVER_1] THEN
        ASM_MESON_TAC [separable_extension, RING_1],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"s:B->bool"] THEN
      REWRITE_TAC [INSERT_SUBSET] THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
      ABBREV_TAC
       (← q r"K = subring_generated l (IMAGE (h:A->B) (ring_carrier k) UNION s)") THEN
      STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"subring_generated l (IMAGE (h:A->B) (ring_carrier k) UNION x INSERT s) =
        subring_generated l (x INSERT IMAGE I (ring_carrier K))")
      SUBST1_TAC THENL
       [EXPAND_TAC "K" THEN
        REWRITE_TAC [IMAGE_I, SUBRING_GENERATED_INSERT] THEN
        AP_TERM_TAC THEN SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"field K /\ field_extension(k,K) (h:A->B) /\ field_extension(K,l) I")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC t2 THEN
        REPEAT CONJ_TAC THENL
         [EXPAND_TAC "K" THEN MATCH_MP_TAC FIELD_ALGEBRAIC_EXTENSION THEN
          ASM_MESON_TAC [algebraic_extension, SUBSET],
          DISCH_TAC THEN EXPAND_TAC "K" THEN
          MATCH_MP_TAC FIELD_EXTENSION_FROM_SUBRING_GENERATED THEN
          ASM_REWRITE_TAC [FIELD_EXTENSION_REFL] THEN
          ASM_MESON_TAC [field_extension],
          DISCH_TAC THEN MATCH_MP_TAC FIELD_EXTENSION_INTO_INTERMEDIATE THEN
          EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [] THEN
          EXPAND_TAC "K" THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBRING_GENERATED_INC_GEN THEN
          ASM_SIMP_TAC [IN_UNION, FUN_IN_IMAGE] THEN
          ASM_MESON_TAC [FIELD_EXTENSION_CARRIER]],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"algebraic_over (K,l) I (x:B)") ASSUME_TAC THENL
       [MATCH_MP_TAC ALGEBRAIC_OVER_FIELD_EXTENSION THEN
        MAP_EVERY EXISTS_TAC [← q r"h:A->B", ← q r"k:A ring"] THEN
        ASM_REWRITE_TAC [I_O_ID] THEN ASM_MESON_TAC [algebraic_extension],
        ALL_TAC] THEN
      ABBREV_TAC
       (← q r"K' = subring_generated l ((x:B) INSERT IMAGE I (ring_carrier K))") THEN
      SUBGOAL_THEN (← q r"field_extension(K,K') (I:B->B)") ASSUME_TAC THENL
       [EXPAND_TAC "K'" THEN MATCH_MP_TAC FINITE_IMP_FIELD_EXTENSION THEN
        MATCH_MP_TAC FINITE_SIMPLE_ALGEBRAIC_EXTENSION THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
       [← q r"h:A->B", ← q r"I:B->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"K:B ring", ← q r"K':B ring",
        ← q r"m:C ring"] RING_HOMOMORPHISM_EXTENSIONS_TOWER)) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [FIELD_EXTENSION_IMP_HOMOMORPHISM], ALL_TAC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC) THEN
      MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
       [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"K':B ring"]
       EXTENSION_DEGREE_TOWER_LAW)) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN SUBST1_TAC] THEN
      SUBGOAL_THEN
       (← q r"!t:B->C.
          t IN ring_homomorphism_extensions (k,K,m) (h:A->B,g:A->C)
          ==> FINITE(ring_homomorphism_extensions (K,K',m) (I,t)) /\
              CARD(ring_homomorphism_extensions (K,K',m) (I,t)) <=
              extension_degree (K,K') I /\
              (separable_extension (k,l) h /\ algebraically_closed_field m
               ==> CARD(ring_homomorphism_extensions (K,K',m) (I,t)) =
                   extension_degree (K,K') I)")
      ASSUME_TAC THENL
       [X_GEN_TAC (← q r"t:B->C") THEN
        REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"I:B->B", ← q r"t:B->C", ← q r"K:B ring", ← q r"l:B ring", ← q r"m:C ring",
                          ← q r"x:B"] lemma) THEN
        ASM_REWRITE_TAC [← GSYM ring_homomorphism_extensions] THEN
        MATCH_MP_TAC t3 THEN
        DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"I:B->B", ← q r"k:A ring", ← q r"K:B ring", ← q r"l:B ring"]
          SEPARABLE_EXTENSION_INTERMEDIATE) THEN
        ASM_REWRITE_TAC [I_O_ID] THEN REWRITE_TAC [separable_extension] THEN
        DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_CARD_LE_UNIONS THEN ASM_SIMP_TAC [],
        STRIP_TAC THEN MATCH_MP_TAC HAS_SIZE_CARD THEN
        MATCH_MP_TAC HAS_SIZE_UNIONS THEN
        ASM_SIMP_TAC [HAS_SIZE, ← GSYM pairwise, ETA_AX]])))

  let CARD_EQ_RING_HOMOMORPHISM_EXTENSIONS ← (do
    let lemma ← prove
     r"!(h:A->B) (g:A->C) (i:A->D) k l m n.
        algebraic_extension (k,l) h /\ algebraic_extension (k,n) i /\
        algebraically_closed_field n /\
        algebraically_closed_field m /\ ring_homomorphism (k,m) g
        ==> ring_homomorphism_extensions (k,l,m) (h,g) =_c
            ring_homomorphism_extensions (k,l,n) (h,i)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"k:A ring", ← q r"n:D ring", ← q r"m:C ring", ← q r"i:A->D", ← q r"g:A->C"]
        ALGEBRAIC_CLOSURE_EXTEND_HOMOMORPHISM) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:D->C") STRIP_ASSUME_TAC) THEN
      MAP_EVERY (fun c => FIRST_ASSUM (fun th => tactic_of do
          if !((← liftExcept (rand (concl th))) == c) then throw "check"
          let th' ← MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION th
          pure (ASSUME_TAC th' THEN
                (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) th')))
       [← q r"h:A->B", ← q r"i:A->D"] THEN
      FIRST_ASSUM (fun th => tactic_of do
        let c ← q r"algebraically_closed_field(m:C ring)"
        if !(concl th == c) then throw "check"
        pure ((ASSUME_TAC o MATCH_MP ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD) th)) THEN
      SUBGOAL_THEN (← q r"ring_monomorphism(n:D ring,m:C ring) f") ASSUME_TAC THENL
       [MATCH_MP_TAC FIELD_RING_HOMOMORPHISM_MONOMORPHISM THEN
        ASM_SIMP_TAC [FIELD_IMP_NONTRIVIAL_RING],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!s:B->C. s IN ring_homomorphism_extensions (k,l,m) (h:A->B,g:A->C)
                ==> IMAGE s (ring_carrier l) SUBSET
                    IMAGE (f:D->C) (ring_carrier n)")
      ASSUME_TAC THENL
       [X_GEN_TAC (← q r"s:B->C") THEN
        DISCH_THEN (fun th => ASSUME_TAC th THEN
          (STRIP_ASSUME_TAC o REWRITE_RULE [ring_homomorphism_extensions, IN_ELIM_THM]) th) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"algebraic_over (k,l) (h:A->B) y") ASSUME_TAC THENL
         [ASM_MESON_TAC [algebraic_extension], ALL_TAC] THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"s:B->C", ← q r"k:A ring", ← q r"l:B ring",
                          ← q r"m:C ring", ← q r"y:B"] RING_HOMOMORPHISM_EXTENSIONS_ROOT) THEN
        ASM_REWRITE_TAC [] THEN
        MP_TAC (← ISPECL [← q r"h:A->B", ← q r"k:A ring", ← q r"l:B ring", ← q r"y:B"]
          MINIMAL_POLYNOMIAL) THEN
        ASM_REWRITE_TAC [] THEN
        ABBREV_TAC (← q r"p = minimal_polynomial (k,l) (h:A->B) y") THEN
        STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(g:A->C) o (p:(1->num)->A) = f o (i:A->D) o p")
        SUBST1_TAC THENL
         [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN X_GEN_TAC (← q r"j:1->num") THEN
          CONV_TAC SYM_CONV THEN FIRST_ASSUM MATCH_MP_TAC THEN
          MATCH_MP_TAC POLY_MONOMIAL_IN_CARRIER THEN EXISTS_TAC (← q r"(:1)") THEN
          ASM_REWRITE_TAC [],
          DISCH_TAC] THEN
        MP_TAC (← ISPECL [← q r"n:D ring", ← q r"m:C ring", ← q r"f:D->C",
                          ← q r"(i:A->D) o (p:(1->num)->A)"]
          POLY_ROOTS_MONOMORPHIC_IMAGE) THEN
        ANTS_TAC THENL
         [ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN] THEN CONJ_TAC THENL
           [ASM_MESON_TAC [POLY_EQ_0_MONOMORPHIC_IMAGE, RING_POLYNOMIAL],
            MATCH_MP_TAC ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS THEN
            ASM_REWRITE_TAC [] THEN
            MATCH_MP_TAC IN_RING_POLYNOMIAL_CARRIER_COMPOSE THEN
            EXISTS_TAC (← q r"k:A ring") THEN
            ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM]],
          ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(s:B->C) y IN ring_carrier m") ASSUME_TAC THENL
         [MATCH_MP_TAC RING_HOMOMORPHISM_IN_CARRIER THEN
          EXISTS_TAC (← q r"l:B ring") THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"(s:B->C) y")) THEN
        ASM_REWRITE_TAC [] THEN MESON_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"ring_homomorphism_extensions (k,l,m) (h:A->B,g:A->C) =
        IMAGE (\s. RESTRICTION (ring_carrier l) ((f:D->C) o s))
              (ring_homomorphism_extensions (k,l,n) (h,i))")
      SUBST1_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC CARD_EQ_IMAGE THEN
        REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM,
                     RESTRICTION_EXTENSION, o_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"s1:B->D", ← q r"s2:B->D"] THEN STRIP_TAC THEN
        MATCH_MP_TAC EXTENSIONAL_EQ THEN EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
        ASM_REWRITE_TAC [] THEN
        ASM_MESON_TAC [RING_MONOMORPHISM_INJECTIVE_EQ,
                       RING_HOMOMORPHISM_IN_CARRIER]] THEN
      REWRITE_TAC [EXTENSION, IN_IMAGE] THEN X_GEN_TAC (← q r"s:B->C") THEN EQ_TAC THENL
       [DISCH_TAC,
        DISCH_THEN (X_CHOOSE_THEN (← q r"s0:B->D") (CONJUNCTS_THEN2 SUBST1_TAC
         (STRIP_ASSUME_TAC o
          REWRITE_RULE [ring_homomorphism_extensions, IN_ELIM_THM]))) THEN
        MATCH_MP_TAC RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS THEN
        ASM_REWRITE_TAC [o_THM] THEN
        ASM_MESON_TAC [RING_HOMOMORPHISM_COMPOSE,
                       RING_MONOMORPHISM_IMP_HOMOMORPHISM]] THEN
      UNDISCH_TAC
       (← q r"(s:B->C) IN ring_homomorphism_extensions (k,l,m) (h:A->B,g:A->C)") THEN
      DISCH_THEN (fun th => FIRST_X_ASSUM (fun a => tactic_of do
          pure (ASSUME_TAC (← MATCH_MP a th))) THEN
        (STRIP_ASSUME_TAC o REWRITE_RULE [ring_homomorphism_extensions, IN_ELIM_THM]) th) THEN
      MP_TAC (← ISPECL [← q r"f:D->C", ← q r"n:D ring", ← q r"m:C ring"]
        RING_ISOMORPHISM_ONTO_IMAGE) THEN
      ASM_REWRITE_TAC [ring_isomorphism, ring_image, ring_isomorphisms] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f':C->D") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"ring_carrier(subring_generated m (IMAGE (f:D->C) (ring_carrier n))) =
        IMAGE f (ring_carrier n)")
      ASSUME_TAC THENL
       [MATCH_MP_TAC CARRIER_SUBRING_GENERATED_SUBRING THEN
        MP_TAC (← ISPECL [← q r"n:D ring", ← q r"m:C ring", ← q r"f:D->C"] SUBRING_RING_IMAGE) THEN
        ASM_REWRITE_TAC [ring_image],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"RESTRICTION (ring_carrier l) ((f':C->D) o (s:B->C))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC EXTENSIONAL_EQ THEN EXISTS_TAC (← q r"ring_carrier l:B->bool") THEN
        ASM_REWRITE_TAC [RESTRICTION_IN_EXTENSIONAL] THEN
        ASM_SIMP_TAC [RESTRICTION, o_THM] THEN
        X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN CONV_TAC SYM_CONV THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_MESON_TAC [SUBSET, FUN_IN_IMAGE],
        MATCH_MP_TAC RESTRICTION_IN_RING_HOMOMORPHISM_EXTENSIONS THEN
        ASM_SIMP_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM, o_THM] THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN
          EXISTS_TAC (← q r"subring_generated m (IMAGE (f:D->C) (ring_carrier n))") THEN
          ASM_SIMP_TAC [RING_HOMOMORPHISM_INTO_SUBRING],
          ASM_MESON_TAC [RING_MONOMORPHISM_IMP_HOMOMORPHISM,
                         RING_HOMOMORPHISM_IN_CARRIER]]])
    prove
     r"!(h:A->B) (g:A->C) (g':A->D) k l m m'.
        algebraic_extension (k,l) h /\
        algebraically_closed_field m /\ ring_homomorphism (k,m) g /\
        algebraically_closed_field m' /\ ring_homomorphism (k,m') g'
        ==> ring_homomorphism_extensions (k,l,m) (h,g) =_c
            ring_homomorphism_extensions (k,l,m') (h,g')"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"k:A ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [ALGEBRAIC_IMP_FIELD_EXTENSION, field_extension],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:(A#num)ring", ← q r"i:A->A#num"] THEN STRIP_TAC THEN
      TRANS_TAC CARD_EQ_TRANS
       (← q r"ring_homomorphism_extensions (k,l,n) (h:A->B,i:A->A#num)") THEN
      CONJ_TAC THENL [ALL_TAC, ONCE_REWRITE_TAC [CARD_EQ_SYM]] THEN
      MATCH_MP_TAC lemma THEN ASM_REWRITE_TAC []))

  -- @@RETURN BEGIN
  return { RING_HOMOMORPHISM_EXTENSIONS_TOWER, CARD_RING_HOMOMORPHISM_EXTENSIONS_LE,
           HAS_SIZE_RING_HOMOMORPHISM_EXTENSIONS, CARD_EQ_RING_HOMOMORPHISM_EXTENSIONS }
  -- @@RETURN END

/- ------------------------------------------------------------------------- -/
/- The separable degree [l:k]_s; multiplicative in towers, at most [l:k],    -/
/- equal to it exactly for separable extensions.                             -/
/- (fieldtheory.ml 12091-12603)                                              -/
/- ------------------------------------------------------------------------- -/

structure SeparableDegree where
  -- @@FIELDS
  separable_degree : thm
  SEPARABLE_DEGREE : thm
  HAS_SIZE_SEPARABLE_DEGREE : thm
  SEPARABLE_DEGREE_LE_EXTENSION_DEGREE : thm
  SEPARABLE_DEGREE_TOWER : thm
  SEPARABLE_DEGREE_SIMPLE : thm
  SEPARABLE_DEGREE_SIMPLE_LT : thm
  SEPARABLE_DEGREE_EQ_EXTENSION_DEGREE : thm
  SEPARABLE_EXTENSION_SIMPLE : thm
  SEPARABLE_EXTENSION_TRANS : thm
  SEPARABLE_EXTENSION_TRANS_EQ : thm
  SEPARABLE_EXTENSION_GENERATED_BY_SEPARABLE : thm
  deriving Inhabited

@[nospecialize]
def setupSeparableDegree [HolBase] (D : FieldTheoryDeps) (BFieldExtension : FieldExtension) (BFiniteExtension : FiniteExtension) (BAlgebraicExtension : AlgebraicExtension) (BAlgebraicOverBasics : AlgebraicOverBasics) (BAlgebraicExtensionProps : AlgebraicExtensionProps) (BAlgebraicExtMisc : AlgebraicExtMisc) (BMinimalPolynomial : MinimalPolynomial) (BAlgebraicField : AlgebraicField) (BAlgebraicTrans : AlgebraicTrans) (BAcfBasic : AcfBasic) (BAcfSplit : AcfSplit) (BAlgebraicClosure : AlgebraicClosure) (BSplitsOver : SplitsOver) (BSeparableExtension : SeparableExtension) (BSeparableRoots : SeparableRoots) (BHomExtensions : HomExtensions) (BHomExtensionsCount : HomExtensionsCount) :
    ExceptT String IO SeparableDegree := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, TAUT,
        new_definition, .. } := D
  let { CARD_EQ_IMAGE, CARD_EQ_REFL, CARD_EQ_TRANS, CARD_FINITE_CONG, CARD_MUL_FINITE,
        CARD_MUL_FINITE_EQ, CONTRAPOS_THM, DISJOINT, .. } := D.core1
  let { FIELD_IMP_INTEGRAL_DOMAIN, FINITE_INDUCT_STRONG, FORALL_IN_IMAGE,
        FORALL_IN_INSERT, HAS_SIZE, IMAGE_I, IMAGE_o, .. } := D.core2
  let { IMP_CONJ, IN_ELIM_THM, IN_INSERT, IN_POLY_RING_SUBRING_GENERATED_FINITARY,
        IN_RING_POLYNOMIAL_CARRIER_COMPOSE, I_O_ID, LEFT_IMP_EXISTS_THM, .. } := D.core3
  let { MEMBER_NOT_EMPTY, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.core4
  let { POLY_EXTEND_FROM_SUBRING_GENERATED, RIGHT_FORALL_IMP_THM,
        RING_CARRIER_POLY_SUBRING_GENERATED_MONO, .. } := D.core5
  let { RING_HOMOMORPHISM_COMPOSE, RING_ISOMORPHISM_ONTO_IMAGE, .. } := D.core6
  let { SIMPLE_IMAGE, .. } := D.core7
  let { SUBRING_GENERATED_INC_GEN, SUBRING_GENERATED_RING_CARRIER, SUBSET, UNION_EMPTY, .. } := D.core8
  let { ring_image, .. } := D.core9
  let { CARD_EQ_CARD_IMP, CARD_EQ_DISJOINT_UNIONS, CARD_HAS_SIZE_CONG, CARD_MUL_C,
        CARD_MUL_CONG, EQ_TRANS, INTER_IDEMPOT, LET_TRANS, LE_MULT_LCANCEL,
        LT_MULT_RCANCEL, MULT_CLAUSES, POLY_SEPARABLE_DIVISOR,
        POLY_SEPARABLE_FROM_MONOMORPHIC_IMAGE, .. } := D.core10
  let { SUBRING_GENERATED_INSERT, pairwise, .. } := D.core11
  let { FIELD_EXTENSION_FROM_SUBRING_GENERATED, FIELD_EXTENSION_IMP_HOMOMORPHISM,
        FIELD_EXTENSION_IMP_SUBSET, FIELD_EXTENSION_REFL, FIELD_EXTENSION_TRANS,
        field_extension, .. } := BFieldExtension
  let { EXTENSION_DEGREE_EQ_0, EXTENSION_DEGREE_TOWER_LAW, FINITE_EXTENSION_TRANS,
        FINITE_EXTENSION_TRANS_EQ, FINITE_IMP_FIELD_EXTENSION, .. } := BFiniteExtension
  let { ALGEBRAIC_IMP_FIELD_EXTENSION, algebraic_extension, algebraic_over, .. } := BAlgebraicExtension
  let { FINITE_IMP_ALGEBRAIC_EXTENSION, .. } := BAlgebraicOverBasics
  let { ALGEBRAIC_OVER_FIELD_EXTENSION, FIELD_SIMPLE_ALGEBRAIC_EXTENSION,
        FINITE_FINITELY_GENERATED_ALGEBRAIC_EXTENSION,
        FINITE_SIMPLE_ALGEBRAIC_EXTENSION, .. } := BAlgebraicExtensionProps
  let { ALGEBRAIC_EXTENSION_TRANS, .. } := BAlgebraicExtMisc
  let { EXTENSION_DEGREE_SIMPLE, MINIMAL_POLYNOMIAL, MINIMAL_POLYNOMIAL_DIVIDES,
        MINIMAL_POLYNOMIAL_IN_CARRIER, .. } := BMinimalPolynomial
  let { FIELD_ALGEBRAIC_EXTENSION, .. } := BAlgebraicField
  let { MINIMAL_POLYNOMIAL_SUBRING_GENERATED, .. } := BAlgebraicTrans
  let { ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD, .. } := BAcfBasic
  let { ALGEBRAICALLY_CLOSED_FIELD_POLY_SPLITS, .. } := BAcfSplit
  let { ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH, .. } := BAlgebraicClosure
  let { POLY_SPLITS_OVER_SEPARABLE_ROOT_COUNT, poly_splits_over, .. } := BSplitsOver
  let { SEPARABLE_ELEMENT_IMP_ALGEBRAIC, SEPARABLE_ELEMENT_INTERMEDIATE,
        SEPARABLE_EXTENSION_INTERMEDIATE, SEPARABLE_EXTENSION_ISOMORPHISM,
        SEPARABLE_EXTENSION_SUBFIELD, SEPARABLE_IMP_ALGEBRAIC_EXTENSION,
        separable_element, separable_extension, .. } := BSeparableExtension
  let { POLY_INSEPARABLE_ROOTS_LT_DEG, .. } := BSeparableRoots
  let { RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY, RING_HOMOMORPHISM_EXTENSIONS_SIMPLE,
        ring_homomorphism_extensions, .. } := BHomExtensions
  let { CARD_EQ_RING_HOMOMORPHISM_EXTENSIONS, CARD_RING_HOMOMORPHISM_EXTENSIONS_LE,
        HAS_SIZE_RING_HOMOMORPHISM_EXTENSIONS, RING_HOMOMORPHISM_EXTENSIONS_TOWER, .. } := BHomExtensionsCount
  -- @@SCOPE END

  let separable_degree ← new_definition
   r"separable_degree (k:A ring,l:B ring) (h:A->B) =
        @n. ?m (j:B->B#num).
              algebraic_extension (l,m) j /\ algebraically_closed_field m /\
              n = if FINITE(ring_homomorphism_extensions (k,l,m) (h,j o h))
                  then CARD(ring_homomorphism_extensions (k,l,m) (h,j o h))
                  else 0"

  let SEPARABLE_DEGREE ← prove
   r"!(h:A->B) (g:A->C) k l m.
        algebraic_extension (k,l) h /\ algebraically_closed_field m /\
        ring_homomorphism (k,m) g
        ==> separable_degree (k,l) h =
            if FINITE(ring_homomorphism_extensions (k,l,m) (h,g))
            then CARD(ring_homomorphism_extensions (k,l,m) (h,g)) else 0"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [separable_degree] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(?n:num. P n) /\ (!n. P n ==> n = a) ==> (@n. P n) = a")) THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPEC (← q r"l:B ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [ALGEBRAIC_IMP_FIELD_EXTENSION, field_extension],
        MESON_TAC []],
      X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"m':(B#num)ring", ← q r"j:B->B#num"] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"h:A->B", ← q r"(j:B->B#num) o (h:A->B)", ← q r"g:A->C",
                        ← q r"k:A ring", ← q r"l:B ring", ← q r"m':(B#num)ring", ← q r"m:C ring"]
        CARD_EQ_RING_HOMOMORPHISM_EXTENSIONS) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC RING_HOMOMORPHISM_COMPOSE THEN
        EXISTS_TAC (← q r"l:B ring") THEN
        ASM_MESON_TAC [ALGEBRAIC_IMP_FIELD_EXTENSION,
                       FIELD_EXTENSION_IMP_HOMOMORPHISM],
        DISCH_TAC] THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP CARD_FINITE_CONG) THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [CARD_EQ_CARD_IMP]])

  let HAS_SIZE_SEPARABLE_DEGREE ← prove
   r"!(h:A->B) (g:A->C) k l m.
        finite_extension (k,l) h /\ algebraically_closed_field m /\
        ring_homomorphism (k,m) g
        ==> ring_homomorphism_extensions (k,l,m) (h,g) HAS_SIZE
            separable_degree (k,l) h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
      CARD_RING_HOMOMORPHISM_EXTENSIONS_LE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->C", ← q r"k:A ring", ← q r"l:B ring", ← q r"m:C ring"]
      SEPARABLE_DEGREE) THEN
    ASM_SIMP_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION, FIELD_IMP_INTEGRAL_DOMAIN,
                  ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD] THEN
    SIMP_TAC [HAS_SIZE])

  let SEPARABLE_DEGREE_LE_EXTENSION_DEGREE ← prove
   r"!(h:A->B) k l.
        finite_extension (k,l) h
        ==> separable_degree (k,l) h <= extension_degree (k,l) h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"k:A ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [FINITE_IMP_FIELD_EXTENSION, field_extension],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:(A#num)ring", ← q r"g:A->A#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM o
      MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->A#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:(A#num)ring"] CARD_RING_HOMOMORPHISM_EXTENSIONS_LE) THEN
    MP_TAC (← ISPECL [← q r"h:A->B", ← q r"g:A->A#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"m:(A#num)ring"] HAS_SIZE_SEPARABLE_DEGREE) THEN
    ASM_SIMP_TAC [FIELD_IMP_INTEGRAL_DOMAIN, ALGEBRAICALLY_CLOSED_FIELD_IMP_FIELD,
                  HAS_SIZE])

  let SEPARABLE_DEGREE_TOWER ← prove
   r"!(f:A->B) (g:B->C) k l m.
        algebraic_extension (k,l) f /\ algebraic_extension (l,m) g
        ==> separable_degree (k,m) (g o f) =
            separable_degree (k,l) f * separable_degree (l,m) g"
   (← do
    let t1 ← TAUT (← q r"p <=> ~ ~p")
    pure (REPEAT STRIP_TAC THEN
    MAP_EVERY (fun c => FIRST_ASSUM (fun th => tactic_of do
        if !((← liftExcept (rand (concl th))) == c) then throw "check"
        pure ((ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM o
               MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) th)))
     [← q r"f:A->B", ← q r"g:B->C"] THEN
    MP_TAC (← ISPEC (← q r"k:A ring") ALGEBRAIC_CLOSURE_EXISTS_BIGENOUGH) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [ALGEBRAIC_IMP_FIELD_EXTENSION, field_extension],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:(A#num)ring", ← q r"j:A->A#num"] THEN STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      let c ← q r"j:A->A#num"
      if !((← liftExcept (rand (concl th))) == c) then throw "check"
      pure ((ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_HOMOMORPHISM o
             MATCH_MP ALGEBRAIC_IMP_FIELD_EXTENSION) th)) THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"j:A->A#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"n:(A#num)ring"] RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY) THEN
    ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t0:B->A#num") (fun th => ASSUME_TAC th THEN
      (STRIP_ASSUME_TAC o REWRITE_RULE [ring_homomorphism_extensions, IN_ELIM_THM]) th)) THEN
    SUBGOAL_THEN (← q r"algebraic_extension (k,m) ((g:B->C) o (f:A->B))")
    ASSUME_TAC THENL [ASM_MESON_TAC [ALGEBRAIC_EXTENSION_TRANS], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"(g:B->C) o (f:A->B)", ← q r"j:A->A#num", ← q r"k:A ring",
                      ← q r"m:C ring", ← q r"n:(A#num)ring"] SEPARABLE_DEGREE) THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"j:A->A#num", ← q r"k:A ring", ← q r"l:B ring",
                      ← q r"n:(A#num)ring"] SEPARABLE_DEGREE) THEN
    MP_TAC (← ISPECL [← q r"g:B->C", ← q r"t0:B->A#num", ← q r"l:B ring", ← q r"m:C ring",
                      ← q r"n:(A#num)ring"] SEPARABLE_DEGREE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN SUBST1_TAC) THEN
    ABBREV_TAC (← q r"X = ring_homomorphism_extensions (k,l,n) (f:A->B,j:A->A#num)") THEN
    ABBREV_TAC (← q r"Y = ring_homomorphism_extensions (l,m,n)
                    (g:B->C,t0:B->A#num)") THEN
    SUBGOAL_THEN
     (← q r"!t:B->A#num.
        t IN X
        ==> ring_homomorphism_extensions (l,m,n) (g:B->C,t) =_c
            (Y:(C->A#num)->bool) /\
            ~(ring_homomorphism_extensions (l,m,n) (g,t) = {})")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"t:B->A#num") THEN EXPAND_TAC "X" THEN
      REWRITE_TAC [ring_homomorphism_extensions, IN_ELIM_THM] THEN STRIP_TAC THEN
      EXPAND_TAC "Y" THEN REWRITE_TAC [← GSYM ring_homomorphism_extensions] THEN
      ASM_SIMP_TAC [CARD_EQ_RING_HOMOMORPHISM_EXTENSIONS,
                    RING_HOMOMORPHISM_EXTENSIONS_NONEMPTY],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"ring_homomorphism_extensions (k,m,n) ((g:B->C) o (f:A->B),j:A->A#num) =_c
    (X:(B->A#num)->bool) *_c (Y:(C->A#num)->bool)")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"f:A->B", ← q r"g:B->C", ← q r"j:A->A#num", ← q r"k:A ring",
                        ← q r"l:B ring", ← q r"m:C ring", ← q r"n:(A#num)ring"]
        RING_HOMOMORPHISM_EXTENSIONS_TOWER) THEN
      ASM_REWRITE_TAC [SIMPLE_IMAGE, pairwise] THEN
      DISCH_THEN (CONJUNCTS_THEN2 SUBST1_TAC ASSUME_TAC) THEN
      TRANS_TAC CARD_EQ_TRANS
       (← q r"IMAGE (\t. ring_homomorphism_extensions (l,m,n) (g:B->C,t:B->A#num))
            X *_c (Y:(C->A#num)->bool)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CARD_EQ_DISJOINT_UNIONS THEN
        REWRITE_TAC [pairwise, IMP_CONJ, RIGHT_FORALL_IMP_THM,
                     FORALL_IN_IMAGE] THEN
        ASM_MESON_TAC [],
        MATCH_MP_TAC CARD_MUL_CONG THEN REWRITE_TAC [CARD_EQ_REFL] THEN
        MATCH_MP_TAC CARD_EQ_IMAGE THEN
        MAP_EVERY X_GEN_TAC [← q r"t:B->A#num", ← q r"t':B->A#num"] THEN
        REWRITE_TAC [] THEN STRIP_TAC THEN
        GEN_REWRITE_TAC I [t1] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          let ok := is_forall (concl th) &&
            (match dest_forall (concl th) with
             | .ok (_, b) => is_forall b
             | .error _ => false)
          if !ok then throw "check"
          pure ((MP_TAC o SPECL [← q r"t:B->A#num", ← q r"t':B->A#num"]) th)) THEN
        ASM_REWRITE_TAC [DISJOINT, INTER_IDEMPOT] THEN ASM_SIMP_TAC []],
