      FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [field_extension]) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_MONOMORPHISM_IMP_HOMOMORPHISM) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP FIELD_EXTENSION_IMP_SUBSET_I) THEN
      ABBREV_TAC
       (← q r"R = {x | x IN ring_carrier l /\
                 poly_eval l (p:(1->num)->B) x = ring_0 l}") THEN
      ASM_CASES_TAC (← q r"(R:B->bool) SUBSET ring_carrier k") THENL
       [SUBGOAL_THEN (← q r"extension_degree(k,l) (I:B->B) = 1")
         (fun th => REWRITE_TAC [th, DIVIDES_1]) THEN
        ASM_SIMP_TAC [EXTENSION_DEGREE_EQ_1, IMAGE_I] THEN
        MP_TAC (← ISPECL [← q r"I:B->B", ← q r"k:B ring", ← q r"l:B ring"]
          RING_ISOMORPHISM_ONTO_SUBFIELD_IMAGE) THEN
        ASM_REWRITE_TAC [IMAGE_I] THEN
        DISCH_THEN (ASSUME_TAC o MATCH_MP CARRIER_SUBFIELD_GENERATED_SUBFIELD o
          CONJUNCT1) THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          let c ← q r"l:B ring"
          if !((← liftExcept (rand (concl th))) == c) then throw "check"
          pure (GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← SYM th])) THEN
        ASM_SIMP_TAC [ls1],
        ALL_TAC] THEN
      UNDISCH_TAC (← q r"~((R:B->bool) SUBSET ring_carrier k)") THEN
      EXPAND_TAC "R" THEN
      REWRITE_TAC [SUBSET, NOT_FORALL_THM, NOT_IMP, IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:B") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"algebraic_over(k,l) (I:B->B) a") ASSUME_TAC THENL
       [ASM_MESON_TAC [FINITE_IMP_ALGEBRAIC_EXTENSION, algebraic_extension],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"k:B ring", ← q r"l:B ring", ← q r"a:B"]
        MINIMAL_POLYNOMIAL_DEG_EQ_1) THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"k:B ring", ← q r"l:B ring", ← q r"a:B", ← q r"p:(1->num)->B"]
        MINIMAL_POLYNOMIAL_DIVIDES) THEN
      MP_TAC (← ISPECL [← q r"I:B->B", ← q r"k:B ring", ← q r"l:B ring", ← q r"a:B"]
        MINIMAL_POLYNOMIAL) THEN
      ASM_REWRITE_TAC [IMAGE_I] THEN
      ABBREV_TAC (← q r"f = minimal_polynomial (k,l) (I:B->B) a") THEN
      STRIP_TAC THEN
      ASM_SIMP_TAC [POLY_EXTEND_EVALUATE, ← GSYM poly_eval, I_O_ID] THEN
      REWRITE_TAC [ring_divides] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:(1->num)->B") STRIP_ASSUME_TAC o
        CONJUNCT2 o CONJUNCT2) THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        let c ← q r"p:(1->num)->B"
        if !((← liftExcept (lhand (concl th))) == c && is_eq (concl th)) then throw "check"
        pure (ASSUME_TAC (← REWRITE_RULE [POLY_RING_CLAUSES] th))) THEN
      SUBGOAL_THEN
       (← q r"ring_polynomial k (f:(1->num)->B) /\ ring_polynomial k (g:(1->num)->B) /\
        ~(g = poly_0 k)")
      STRIP_ASSUME_TAC THENL
       [ASM_REWRITE_TAC [RING_POLYNOMIAL] THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"~(p:(1->num)->B = poly_0 k)") THEN ASM_REWRITE_TAC [] THEN
        ASM_MESON_TAC [POLY_MUL_0, RING_POLYNOMIAL],
