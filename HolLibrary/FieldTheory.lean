  /- ---------------------------------------------------------------------- -/
  /- The cyclic vector theorem. If the minimal polynomial of the k-linear   -/
  /- map t has degree d, that is t^d is a combination of 1, t, ...,         -/
  /- t^(d-1) over k and these d maps are independent over k, then some z    -/
  /- has z, t z, ..., t^(d-1) z independent over k (with d = [l:k], a       -/
  /- cyclic vector). The annihilator of l in k[X] is generated by X^d minus -/
  /- the combination, by division and the independence of the maps, and it -/
  /- is the annihilator of some z (PID_ANNIHILATOR_ATTAINED).               -/
  /- ---------------------------------------------------------------------- -/

  let CYCLIC_VECTOR_EXISTS ← prove
   r"!(h:A->B) k l t d a.
        field k /\ ring_homomorphism(k,l) h /\
        (!x. x IN ring_carrier l ==> t x IN ring_carrier l) /\
        (!x y. x IN ring_carrier l /\ y IN ring_carrier l
               ==> t(ring_add l x y) = ring_add l (t x) (t y)) /\
        (!c x. c IN ring_carrier k /\ x IN ring_carrier l
               ==> t(ring_mul l (h c) x) = ring_mul l (h c) (t x)) /\
        (!i. i < d ==> a i IN ring_carrier k) /\
        (!x. x IN ring_carrier l
             ==> ITER d t x =
                 ring_sum l {i | i < d}
                   (\i. ring_mul l (h(a i)) (ITER i t x))) /\
        (!c. (!i. i < d ==> c i IN ring_carrier k) /\
             (!x. x IN ring_carrier l
                  ==> ring_sum l {i | i < d}
                        (\i. ring_mul l (h(c i)) (ITER i t x)) = ring_0 l)
             ==> !i. i < d ==> c i = ring_0 k)
        ==> ?z. z IN ring_carrier l /\
                !c. (!i. i < d ==> c i IN ring_carrier k) /\
                    ring_sum l {i | i < d}
                      (\i. ring_mul l (h(c i)) (ITER i t z)) = ring_0 l
                    ==> !i. i < d ==> c i = ring_0 k"
   (← do
    let t4 ← TAUT (← q r"(~p ==> F) ==> p")
    let a3 ← ARITH_RULE (← q r"~(d = 0) /\ x <= d - 1 ==> x < d")
    let t2 ← TAUT (← q r"(~p ==> F) ==> p")
    let t1 ← TAUT (← q r"F ==> p")
    let r0 ← q r"ring_0 l:B"
    let p0 ← q r"p = poly_0 k:(1->num)->A"
    pure (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
     (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)))))) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_HOMOMORPHISM_0) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_HOMOMORPHISM_1) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RING_HOMOMORPHISM_NEG) THEN
    SUBGOAL_THEN
     (← q r"!c. c IN ring_carrier k ==> (h:A->B) c IN ring_carrier l")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [RING_HOMOMORPHISM_IN_CARRIER], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n x. x IN ring_carrier l ==> ITER n (t:B->B) x IN ring_carrier l")
