             POLY_DEG_MONOMORPHIC_IMAGE)) THEN
            ASM_REWRITE_TAC []],
          FIRST_X_ASSUM (fun th => tactic_of do
            let c ← q r"n:num"
            let ok ← (do
              if !((← liftExcept (rand (concl th))) == c) then pure false else
              let lh ← liftExcept (lhand (concl th))
