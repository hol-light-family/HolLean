        MP_TAC (← REWRITE_RULE [I_O_ID] (← ISPECL
         [← q r"I:B->B", ← q r"I:B->B", ← q r"k:B ring", ← q r"L:B ring", ← q r"l:B ring"]
         EXTENSION_DEGREE_TOWER_LAW)) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
        TRANS_TAC DIVIDES_TRANS
         (← q r"FACT(poly_deg k (f:(1->num)->B)) *
          FACT(poly_deg k (g:(1->num)->B))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC DIVIDES_MUL2 THEN CONJ_TAC THENL
           [REMOVE_THEN "ih" (MP_TAC o SPEC (← q r"poly_deg k (f:(1->num)->B)")) THEN
            ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN MATCH_MP_TAC] THEN
            EXISTS_TAC (← q r"f:(1->num)->B") THEN ASM_REWRITE_TAC [],
            REMOVE_THEN "ih" (MP_TAC o SPEC (← q r"poly_deg k (g:(1->num)->B)")) THEN
            ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN MATCH_MP_TAC] THEN
